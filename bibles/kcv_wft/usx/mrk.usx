<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- KETE BIBLE TRANSLATION</book>
  <para style="h">MAKU</para>
  <para style="toc1">Musahu Ulengela wu Maku</para>
  <para style="toc2">Maku</para>
  <para style="toc3">Mk</para>
  <para style="mt2">MUSAHU ULENGELA WU</para>
  <para style="mt1">MAKU</para>
  <para style="imt">MBANGULA</para>
  <para style="im">
    <char style="bk">Musahu Ulengela wu Maku </char>MBANGULA MUSAHU ULENGELA WU MAKU Musahu ulengela wu Maku udi umu wu mukakatshi mu mikanda inayi yi mu dihungila dihiadihi yambamba bu moyi wu Yesu Kilisitu. Osu wu ku yoyi ba walela ne {musahu}, biafofueshi ne{ musahu ulengela}: Bakayifunda kunyima ku lufu lu Yesu kudi Matayi, Maku, Luka, ibo Yone. Musahu ulengela wu Maku udi mutshinyi ku misahu ilengela yosu inayi. Bakanyeshi kabidi ne ka ukafundebu kubushi mu misahu ilengela hakakatshi ha mitshiyi 65 huaa yi ku mitshiyi masandi 70 kunyima ku kulediebu ku Yesu Kilisitu. Bafundi bandi balela lukanyi ne baka ufunda mu Lomu bo kahatshila kaku koleshi bena Kilisitu ba mu Lomu kuaku. Maku, mulubuka kabidi mu dina di Yone Maku, ukadu wandenda bo muposutolu Polu ibo Banaba, neku lumu luandi lukoneka hakalekelaye luendu lu kuamba ku musahu ulengela (Biesedi 13:13). Kunyumaku, Maku ukayi kabidi ku luendu bo Banaba(Biesedi 15:37-39). Maku, bakamulubuka kabidi bu mudiandi wu Petelu (1 Petelu 5:13). Nashi mukadu Maku kakadi mushadiki wu kokuakoku wu moyi wu Yesu, bafundi bakanyeshi ne Maku ukangata tshitshinyi tshilema tshi bushadiki bu Petelu, neku tshiotshiatshi ka mishu yi musahu ulengela wu Maku. Mu musahu ulengela, Maku watueyi menemen ha moyi wu bayidi bo diyishi di Yesu ha bitshietshi bikusula. MEYI A KUSULA 1. Maku wabangula mukanda bo shahita 1:1-13. 2. Kunyima, Maku wafofueshi mudimu wu Yesu hakadueyi mu Ngalela mu shahita 1:14 huaa yi kudi shahita wu 8:21. 3. Neku kabidi, wambamba luendu lu Yesu mu Yelushalema 8:22 hua yi ku 10:52). 4. Maku wamananoshi kufunda ha tshitshietshi tshi Yesu mu Yelushalema, bo ha malu a lufu bo kubika kuandi ku kubashiandi.(shapita 11:1-16 hua shapita 8).</para>
  <para style="iot">Tshishimbi diyi</para>
  <para style="io1">Kukadu musahu ulengela <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">Mudimu ukakishi Yesu mu Ngalela <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref></char></para>
  <para style="io1">Yesu watambuka mu Ngalela uyayi mu Yelushalema <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref></char></para>
  <para style="io1">Lubila lua kusula mu Yelushalema yi mala adi matshimba Yelushalema <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref></char></para>
  <para style="io1">Kubika ku Yesu <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref></char></para>
  <para style="io1">Kumueneka yi kubanda ku shashendi Yesu mubika ku bashiandi <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">Diyishi di Yone mubatishi</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matayi 3:1-12</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>; <ref loc="JHN 1:19-28">Yone 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Moona mukadu Musahu Ulengela wu Yesu Kilisitu, Muana wu Tshiambi.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Meyawu ka ena mu mifundu minga</char><char style="fq" closed="false">Muana wu Tshiambi.</char></note> <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2. </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref>.</char></note>bu mukafundebu kudi mupolofete Yeshayi.</para>
  <para style="q1" vid="MRK 1:2">“Tshiambi ukamba ne: ‘Nayatuma, Kubushi kuebi</para>
  <para style="q2" vid="MRK 1:2">katuma buku kuyongeyediela shila.’<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:3.</char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:3">Yesh 40:3</ref>. </char>
    </note>Diyi di mutu walela lubila mu mbata.</para>
  <para style="q2" vid="MRK 1:3">‘Yongeyayi malonga shila wu Shashendi;</para>
  <para style="q2" vid="MRK 1:3">tuyongeyi tushila tosu tuakala tololoki!’ ”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Kabukayi Yone ukatambuka mu mbata, ukayishi batu ne: “Kudumukayi ku malu enu mabodu, nubatishibu,” neku “Tshiambi uya nofuela muengu.”<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">Yone ukadu mu mbata wayishi bo wabatisa batu,</char><char style="ft" closed="false">; Maluawu ka ena mafunda mu mikanda minga </char><char style="fqa" closed="false">Yone ukadu wayishi batu bo ku babatisa mu mbata.</char></note> <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Batu bundi buabu bakadu bashakama mu bitshinyi bi bula bu Yudayi yi mu Yelushalema, bakayi kudi Yone mubatishi. Bakatonda malu abu mabodu hakubuka, ukaya babatisa mu mushilu wu Yadena.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:6.</char>
      <char style="xt" closed="false">
        <ref loc="2KI 1:8">2 Nkol 1:8</ref>.</char>
    </note>Yone ukadu muluata mundala muesa bo miosa yi nyama walelabu ne kabalu, yi mu tshituka tshiandi, ukadu muluate mukaba wu tshiseba, ukadu udiadi mbasu yi buitshi bu mitu. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Yone ukadu wayishi batu ne: “Uduadu kunyima kuami udi yi bushashendi butambe buami, tshiena yi ngudu iku sulula shinga iku bisabata biandi. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Mimi nanubatisa bo mayi kadi yeyi uduadu uya nubatisa bo Nyinga ulengela.”<verse eid="MRK 1:8" /></para>
  <para style="s1">Dibatisa bo ditetshibu di Yesu</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Matayi 3:13—4:11</ref>; <ref loc="LUK 3:21-22">Luka 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Ha tshitshietshiatshi, Yesu ukatambuka mu Nasaleta buloba bu Ngalela, bakamubatisa kudi Yone mu Yadena. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Hakatambuka yesu mu mayi, diwulu di kosoloka, Nyinga Ulengela uka mutulukila bu nyinyi wu kudimba. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" /><note caller="+" style="x"><char style="xo" closed="false">1:11. </char><char style="xt" closed="false"><ref loc="GEN 22:2">Gen 22:2</ref>; <ref loc="PSA 2:7">Misam 2:7</ref>; <ref loc="ISA 42:1">Yesh 42:1</ref>; <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mk 9:7</ref>; <ref loc="LUK 3:22">Lk 3:22</ref>.</char></note>Diyi dikofueka mu diwulu dikamba ne: “Wewu udi munami wu babalumi unananga, mu wewu nayangila.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Amu hahu, Nyinga Ulengela ukatuma Yesu mu mbata, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ukashala mushakama muamu tshitayi bu tshi mitshila masandi anayi, neku bakamuanga tuhetu kudi muhitshi. Mukadu nyama yi mitu, neku bayakulu bakadua mukuatshishi.<verse eid="MRK 1:13" /></para>
  <para style="s1">Yesu walela Bayidi ba kubushi diyi</para>
  <para style="r">(<ref loc="MAT 4:12-22">Matayi 4:12-22</ref>; <ref loc="LUK 4:14-15">Luka 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Hakelabu Yone mu subua lukanu, Yesu ukayi mu Ngalela, bu kuyishi Musahu Ulengela wu Tshiambi. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" /><note caller="+" style="x"><char style="xo" closed="false">1:15.</char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref>.</char></note>Ukamba ne: “Tshitshietshi tshikayongeyi Tshiambi tshimanadieshi,” “neku bushashendi bu Tshiambi buteyi hahiehi nenu! Kudumukayi ku malu mabodu enu, wataboshayi Musahu Ulengela!”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Hakadu Yesu wandenda ku mbambadi ku dishiba di Ngalela, ukamona balohi babidi, Simona bo Munabu wu babalumi Andele bakadu balela mata abo mu mayi. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesu uka bambila ne: “Duakayi, ilamatayi yanuduisha bilembi bi batu.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Amu hahu, bakaletshiela mata abu bakamulamata.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Hakashekeshi Yesu kubushi kata tshitayi, ukamona Yakobu bo Muanabu wu babalumi Yone bana ba Sebedayi bakadu mu buatu bayongeyi mata abu. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Hahu Yesu ukabela diyi. Bakashiyi tatabu Sebedayi bo bena mudimu banga bakamulamata.<verse eid="MRK 1:20" /></para>
  <para style="s1">Yesu wandondoha mutu mukuatshibu kudi nyinga mubodu mu Kapenuma</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luka 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesu bo Bayidi bandi bakayi mu Kapenuma. Ukadu mutshila wu sabatu, Yesu ukayi mu sunangonga ukabangishi kuyishi batu Musahu Ulengela wu Tshiambi. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" /><note caller="+" style="x"><char style="xo" closed="false">1:22. </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">Mat 7:28-29</ref>.</char></note> Batu bosu bakofu mayishi andi, bakakema, bualu kadu wayishi bu muyishi wu biadi, kadi yeyi ukayishi bo ngudu bundi buayi.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Mu sunangonga mukadueyi wayishi mukadu mutu mukuatshibu kudi nyinga mibodu. Ukela diyi di muengu ukamba. <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />Yesu wu mu Nasaleta “Watshieba kutuesela kaye? Uhudu bukutubutula mbe? Nalubuka ne udi wu tshishila, katuma ka Tshiambi!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesu ukabolokela nyinga mibodu, ukayelela mukandu. “Wedi holu, tambuka munda mu mutuewu!”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Nyinga mubodu uka mubukula bikola, ukela lubila lukola neku ukatambuka. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Batu bosu bakakema, bakokoshangana ne: “Bibiebi mbingenye? Diyishi dihiadihi difila yi ngudu! Wabolokela huaa yi nyinga mibodu imuafofuela!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Kabukayi musahu wandi ukaduduka manyangu mu mangandu bundi buawu a mu Ngalela.<verse eid="MRK 1:28" /></para>
  <para style="s1">Yesu wandondoha batu bandi.</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matayi 8:14-17</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Yesu ukatambuka mu sunangonga bakayi yi Yone, bo Yakobu, ku subu ku Simona bo Andele. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Mukuandi wu Simona ukadu mukuatshibu bo mubidi mudilu ukola, haka fika Yesu, bakamuambila bualu buandi. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Yesu ukayi hahiehi nandi, ukamukuata ku dikatshi ukamubishi hashi, mubidi mudilu ukatalala ukabangishi kubambuluishi.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Hakadu diba ha kudiololu, batu bakadu kudi Yesu bo bena mbabala bandi bo bakadu bakuatshibu kudi nyinga mibodu. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Batu bosu ba mu bula bakadu ku mushikuambelu wu subu ukadueyi badisangishi. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yesu ukondoha batu bandi bakadu bo nyinga mibodu mindi, kadi kataboshi bune itueyi bualu yoyi ikadu yi mualubuka.<verse eid="MRK 1:34" /></para>
  <para style="s1">Diyishi di Yesu mu Ngalela.</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luka 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Fumawu habutshi, Yesu ukabika, ukatambuka mu subu. Ukahengama ha kayandi bu kulomba Tshiambi. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simona yi bakadueyi nabu bakayi bamuatshieba, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Neku hakamumonabu, bakamuambila ne: “Batu bosu bakuatshieba.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Yesu uka bakudumuna ne: “Duakayi tuyaka mu mala adi ku mbambadi ku Kapenuma, bu kuyayishi Musahu Ulengela kuaku kabualu bunaduila.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:39.</char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">Mat 4:23</ref>; <ref loc="MAT 9:35">9:35</ref>.</char>
    </note>Neku, ukayi mu Ngalela bundi buamu, ukalongeshi musahu ulengela mu sunangonga wabu, ukahata nyinga mibodu.<verse eid="MRK 1:39" /></para>
  <para style="s1">Yesu wandondoha muena sudi</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matayi 8:1-4</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Mutshila munga mutu muena sudi ukadu kudi Yesu. Ukasa binu hashi, ukamusengola ne: “Mbe unanga udi mukuaduishi biami ulengela.”<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="fq" closed="false">Yi kusule</char><char style="ft" closed="false">. Mbabalayi ikadu yaduishi mutu mubodu</char></note><verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesu ukamofuela muengu, <note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="fq" closed="false">Muengu</char><char style="ft" closed="false">; bidi bifunda mu mikanda minga </char><char style="fqa" closed="false">Muya kulu.</char></note>ukolola dikatshi diandi uka mukoha ukamba ne: “Nananga, duaka ulengela!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Amu hahu, sudi yi mutu ikahu neku ukadu ulengela, <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Yesu ukamuambila ne yaka, uka mueseshi, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" /><note caller="+" style="x"><char style="xo" closed="false">1:44. </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lew 14:1-32</ref>.</char></note>Ukamba ne: “Kuambidi mutu bualu bu londahu luebi. Kadi yaka udiebeshi kudi muyishi wu biadi wu Tshiambi, fila mulambu ukamba Mosa bukuebeshi batu ne uhondohiebu.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Kadi mutu ukayi, neku ukabangishi kuambila batu bosu malu osu akeseka. Kabukayi Yesu kadu mukubuela mu tshitshinyi tshi bula kadi ukashala ku mbambadi ha kayandi, batu ba mangandu bundi buawu bakadu ba mualamata.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">Yesu wakoleshi mutu mulebela luseki</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matayi 9:1-8</ref>; <ref loc="LUK 5:17-26">Luka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Hakadika mitshila, Yesu ukahinga ku Kapenuma, batu bakofu ne Yesu udi mu subu. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Batu bandi bakasangila kubushi ku subu, bu bundi buabu, ka kuadu muaba mu subu nashi kushi kubushi ku tshibi. Yesu ukabayishi musahu ulengela, <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Batu bakadu kudieyi bo mutu mulebela bilemba, bamutshuale kudi batu banayi. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Bu mukadueku kakuadi mushindu wu kubuela nandi bu bundi bu batu, batu banayi bakabanda kulu ku subu bakahulula malala ku lutanda lu subu bakatubula ditundu buludi bukadu Yesu. Hakamanabu kutubula, bakahuekeshi tshihoyi tshi mutu ukadu bo mbabala mulala. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Hakamona Yesu kuataboshi kuabu, ukambila mutu ukadu bo mbabala ne: “Munami, bubodu buebi buafidibu muengu.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Bayishi ba biadi, bakadu bashakama hahu bakadu badiakokoshi mundamunda ne: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Bukayi mutuewu watueyi nekue? Watuka Tshiambi! Udi mukushimishi bubodu bu mutu nganyie? Biakaleyi ka Tshiambi kayandi!”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Amu hahu, Yesu mu ngudu yandi, ukalubuka lukanyi luabu ukamba ne: “Bukayi nualela lukanyi lu nakue? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Tshinganyi tshidi tshihuhula bukuambila mutu mulebela ne! ‘Bubodu buebi buafudibu muengu’, mbe bukumuambila ne: ‘bika wangata kalalu kebi wende’? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Bu naku, natshieba bune nulubuka ne Muana wu Mutu udi bo ngudu ikushimishi bubodu ha buloba.” Neku, ukambila mutu ukadu mulebela ne: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Nakuambila, bika, wangata tshihoyi tshiebi yaka kuebi!”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Amu hahu, mutu ukabika hashi, ukangata tshihoyi tshiandi, ukenda batu bundi buabu bakamumona, bakakema, bakatshuamika Tshiambi bakamba ne: “Katuamuenyena tshihingu tshineku!”<verse eid="MRK 2:12" /></para>
  <para style="s1">Yesu walela Lewi diyi bu kumulamata</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matayi 9:9-13</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yesu ukahinga kabidi ku mbambadi ku dishiba di Ngalela. Tshieya batu ukadu kudieyi, yeyi ukadu ubambiambila musahu ulengela wu Tshiambi. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Hakadueyi wadika ku mbambadi ku dishiba, ukamona Lewi munandi wu Alafayo mushiakama mu subu wu kulambuishi bitadi. Yesu ukamuambila ne: “Ilamata,” neku Lewi ukabika hashi ukamulamata.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Hakadu Yesu udiadi mu subu mu Lewi, <note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">hakadu Yesu mu subu mu Lewi </char><char style="fqa" closed="false">mu subu.</char></note>batu bandi bakalalambuisheyi bitadi bo batu babodu bakadu badiadi nandi ibo bayidi bandi, bualu bakamulamata bakadu bandi. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Hakadu bayishi ba biadi, bakadu bafalea, bamona ne Yesu udiadia bo balambuishi ba bitadi bo batu babodu, bakokoshi bayidi bandi ne: “Bukayi udiadi bo balambuishi ba milambu ibo batu babodue?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Hakofu Yesu malu akatueyebu, ukamba ne: “Badi bo ngudu kabena bo munganga bualu, amu badi bo kusama, tshiena muduila batu basesa malonga, kadi naduila batu babodu.”<verse eid="MRK 2:17" /></para>
  <para style="s1">Lukonku ha bualu bu bishila.</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matayi 9:14-17</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Mutshila munga, bayidi ba Yone mubatishi bo bafalesa bakadu mu tshishila, batu banga bakadu kudi Yesu baka mokoshi ne: “Bukayi bayidi ba Yone mubatishi bo bayidi ba bafalesa basesa bishila kadi bebi wewu kabashi kuesa bishile?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesu uka bakudumuna ne: “Nualela lukanyi ne bamudiandi ba watombi mukashi badi mukuesa bishila hadi watombi mukashi muakala nabu. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Kadi, tshitshietshi tshiyadu tshinatambulebu watombi mukashi mukakatshi muabu, neku tshitshietshiatshi, bayakuata tshishila.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Mutu nashi umu kashi tela tshihesa tshi mundala muhiamuhi ha mundala mukulu kulu. Kanana mundala muhiamuhia uya handa mundala mukulu kulu neku kuhandika kuyadu kulema. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Momumu, mutu kena mu kuela malufu mahia mahi mu tshilowu tshi bilendi kanana, tshilowu tshiya handika, malufu aya duduka bo tshilowu kabidi.”<verse eid="MRK 2:22" /></para>
  <para style="s1">Yesu udi shashendi wu mutshila wu Sabatu.</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matayi 12:1-8</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:23.</char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:25">Dut 23:25</ref>.</char>
    </note>Mutshila munga wu sabatu, Yesu ukadu wadika mu tshibidi tshi masangu, bayidi bandi bakabuka masangu bakadi. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Bafalasa bakambila Yesu ne: “Bukayi bayidi bebi basesa bidi tshiadi mutshila wu sabatue?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:25. </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:1-6">1 Sam 21:1-6</ref>.</char>
    </note>Yesu uka bakudumuna ne: “Kanuabala tshikesa Dafidi bo batu bandi mutshila ukaduebu bo sala bo nyinga yi bitu, <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" /><note caller="+" style="x"><char style="xo" closed="false">2:26. </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lew 24:9</ref>.</char></note>mushindu ukabueleyi mu subu wu Tshiambi, tshitshietshi tshi muyishi ulema Abiata, ukadi diampa dikahebu Tshiambi, didi mutu nashi umu kena mukudi amu bayishi ba biadi, Dafidi ukadi neku ukaha kabidi batu bandi.”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Yesu ukabambila kabidi ne: “Sabatu udi muesa bu mutu, mutu kena muesa bu sabatu bi. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Kabukayi, Muana wu Mutu udi biandi Shashendi wu mutshila wu sabatu.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">Yesu wandondoha mutu mutshila wu sabatu</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matayi 12:9-14</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Mutshila munga Yesu ukahinga mu sunangonga. Mukadu mutu muakala bo dikatshi difuba. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Batu banga baka mutshioboka holua, bu kulubuka tshinakueseyi mutshila wu sabatu bualu bakadu batshieba mushindu wu kumufunda. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Neku yesu ukambila mutu ukadu bo dikatshi difuba ne: “Bika hashi, wamana kubushi ku batu bosu.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Neku, ukabokoshi ne: “Tshinganyi tshiatataboshi tshiadi tshienu bu kuesa mutshila wu sabatue? Kuesa malonga mbe kuesa bubodue? Bu kuha batu moyi mbe kubashihe?” Kadi bobu kaba kudumuna diyi.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Yesu ukabadingila mubungama, ukadu kabidi bo ngayayi mindi bu kukoleshi kuabu ku nyinga. Ukambila mutu ukadu bo dikatshi difuba ne: “Wolola dikatshi diebi.” Ukadiolola neku dikatshi, dikololoka. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Amu hahu, bafalesa bakatambuka mu sunangonga, bakadisangishi bo bayidi ba Helode bakayi manyangu bu kuela tshifufu buku shiha Yesu.<verse eid="MRK 3:6" /></para>
  <para style="s1">Batu bandi balamata Yesu.</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesu bo bayidi bandi bakatambuka, bakayi kumbambadi ku dishiha di Ngalela, batu bandi bakamulamata. Bakadu baduadu ku Ngalela ibo ku Yudayi, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />mu Yelushalema, mu Didime mu tshitshinyi tshi bula tshikadu dishi di Yudayi ibo mu tshimenga tshi Tilo yi Sidona. Bakadu baduadu kudi Yesu bualu bakofu musahu wu malu akeseyi. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" /><note caller="+" style="x"><char style="xo" closed="false">3:9. </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mk 4:1</ref>; <ref loc="LUK 5:1-3">Lk 5:1-3</ref>.</char></note>Hakamoneyi bundi bu batu, Yesu ukalomba kudi bayidi bandi bune bamu tshuadila buatu. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Ukondoha batu bandi, kabukayi bena mbabala bandi, bakadu babondolangana bu kumukoha makatshi hambidi. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Neku, batu bakadu bakuata kudi nyinga mibodu hakamonebu Yesu, bakadiela ku makasa andi bakela diyi dikola eeii: “Yesu udi Munandi wu Tshiambi Teta menemene!”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Kadi Yesu ukabambila bikola bune kabambidi batu bualu buandi.<verse eid="MRK 3:12" /></para>
  <para style="s1">Yesu wasungula bayidi bandi disandi yi babidi</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matayi 10:1-4</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Kunyima, Yesu ukabanda ku luhongu, ukela batu bakadueyi wananga diyi, bakamulamata. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Ukasungula Tutuma disandi yi tubidi mukakatshi muabu. “Bune bakala nandi” bu kubatuma, “Bune baye kuamba musahu ulengela, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />neku ukabaha ngudu yi kuahata nayi nyinga mibodu.”<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Ukasungula disandi yi babidi, menabu; Simona (ukenyekeyi dina dinga ne Petelu), <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakobu bo munabu wu babalumi Yone, bubidi buabu bakadu bana ba Sebedayi, (bakahebu mena manga kudi Yesu. Bowenege kukudumuna “Bana ba dibanda di kuba”); <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andele, Filipoyi, Batolomayi, Matayi, Tomasa, Yakobu, Alafayi, Tadaya, Simona muena Kananayo, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />Yudasa Isakaliote ukamuelela lukanyi lubodu.<verse eid="MRK 3:19" /></para>
  <para style="s1">Yesu bo belesebule</para>
  <para style="r">(<ref loc="MAT 12:22-32">Matayi 12:22-32</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Hakahinga Yesu ku subu, batu bandi bakasangila kabidi,Yesu bo bayidi bandi kabamona mushindu wu kudi. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Hakofu bena bulungu buabu, bakadu bu kumuangata ku ngudu, bualu bakadu bambamba ne: “Washimishi lungenyi!”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:22. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char>
    </note>Bayishi ba biadi banga bakadu ku Yelushalema bakamba ne: “Udi bo Belesebula munda muandi, umuhaha ngudu ikuahata nayi nyinga mibodu.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Neku, Yesu ukabela diyi buku bambila mukundewu. “Muhitshi udi mukuahata muhitshi nandie? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Biakala bena bushashendi bumuabu buhanduluka bobu kayabu, bushashendiabu buyafu. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Biakala bena bulungu bumuabu batandangana bobu kayabu, bulunguabu buyafu. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Biakala Muhitshi udiatandanganyishi kayandi, biakaleyi muhanduluka kayandi, kanayi kubushi, kadi uyafu.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“Mutu nashi umu kena mukubuela mu subu wu muena ngudu, weba bitu biandi mbe kamukandila mioshi kubushi, amu hanamukandeyi mioshi, hahu uya kuangata bitu biandi biosu.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Nanuambiambila diyi di kokuakoku, batu bandi babalumi baya bafuila muengu bu malu mabodu abu.<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="fq" closed="false">malu mabodu adiebu mukuamba</char><char style="ft" closed="false">; nashi </char><char style="fqa" closed="false">malu mabodu adiebu mukuamba bu Tshiambi.</char></note> <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><note caller="+" style="x"><char style="xo" closed="false">3:29. </char><char style="xt" closed="false"><ref loc="LUK 12:10">Lk 12:10</ref>.</char></note>Kadi unatuka Nyinga Ulengela, kabana mofuela muengu kokoko bubodu buandi kabunahu bi.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />(Yesu ukatueyi naku bualu, bakadu ba muambamba ne: “Udi bo nyinga mubodu.”)<verse eid="MRK 3:30" /></para>
  <para style="s1">Mamandi wu Yesu bo bana babu ba babalumi</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matayi 12:46-50</ref>; <ref loc="LUK 8:19-21">Luka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Mamandi wu Yesu bo banababu bakadu. Bakatuma mutu bu kuela Yesu diyi. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Batu bandi bakadu bashakama bamu tshimbidila, bakamuambila ne: “Fudikishi, mamiebi bo bana benu ba babalumi, bakuatshieba.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yesu ukabakudumuna ne “Mamami nganyie, bana betu ba babalumi banganyie?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Kunyima ku kutshioboka batu bakadu bashakama bamutshimbidila ukamba ne: “Tshiobokayi, mamami bo bana betu ba babalumi! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Bualu yosu wasesa muananga Tshiambi, mutu yawu, ka munetu wu babalumi, munetu wu babakashi, mamami.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">Mukunda wu mumiaminyi</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matayi 13:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1. </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:1-3">Lk 5:1-3</ref>.</char>
    </note>Yesu ukabanga kabidi kuyishi batu musahu ku mbambadi ku dishiha di Ngalela. Bualu batu bakadu bandi, ukabuela mu buatu bualu batu bakadu bandi, batu bundi buabu bakadu kumbambadi ku dishiha. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Yesu uka bayishi malu mandi mu mikunda, neku ukabambila mu mayishi andi ne:<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“Ofuayi! Mumiaminyi ukatambuka bukuya miamina <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Hakadueyi wamiamina shanga, shanga minga ikamata mu shila, nyunyi ikadu ika isokola. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Shanga minga ikamata mu buloba bukadu hanandi ha mabu, ika toloka manyangu kadi bualu ka kuadu buloba bundi. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Hakakasakana munyinyi, diba dikafubidishi bisule, ikomangana bualu kayadu yi mishu mila bi. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Tshitshinyi tshinga tshi shanga tshikamata mu mieba, mioshi yi mieba yikayidinga, kayakuama bimuma bi. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Kadi shanga minga ikamata ha buloba bulengela, ikatuhuluka, ikakuama bimuma, minga masandi asatu, minga masandi asambombu, minga 100.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Kunyima Yesu ukamba ne: “Udi bo matshu a kofu ofu biandi!”<verse eid="MRK 4:9" /></para>
  <para style="s1">Yesu wambamba bukayi wayishi mu mikunda.</para>
  <para style="r">(<ref loc="MAT 13:10-17">Matayi 13:10-17</ref>; <ref loc="LUK 8:9-10">Luka 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Hakaduebu kayabu, batu banga bo Bayidi bandi baka mokoshi bune ubofueshi mukunda ukeleyi. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yesu uka bakudumuna ne: “Banusokolodiela nuenu bualu busokomi bu butshuami bu Tshiambi,” neku badi kabakadi nenu malu osu baya bayishi nawu mu mikunda, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12. </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Yesh 6:9-10</ref>.</char></note>‘Bune,</para>
  <para style="q1" vid="MRK 4:12">Hanakuakalebu ba tshioboka,</para>
  <para style="q2" vid="MRK 4:12">kabamonyi tshitu,</para>
  <para style="q1" vid="MRK 4:12">Hanakuakalebu bafudikishi,</para>
  <para style="q2" vid="MRK 4:12">ka bofu bualu,</para>
  <para style="q1" vid="MRK 4:12">Bune kaba hinganganyi kudi Tshiambi,</para>
  <para style="q2" vid="MRK 4:12">bu kubofuela muengu.’”<verse eid="MRK 4:12" /></para>
  <para style="r">(<ref loc="MAT 13:18-23">Matayi 13:18-23</ref>; <ref loc="LUK 8:11-15">Luka 8:11-15</ref>)</para>
  <para style="s1">Yesu wafofueshi mukunda wu mumiaminyi</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matayi 13:18-23</ref>; <ref loc="LUK 8:11-15">Luka 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Neku, Yesu ukatungunuka bo kubambila ne: “Kanofuela mukunda unanuele? Nuya kofu bitshi mikunda minga inana kuele? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Mumiaminyi wamiamina musahu ulengela wu Tshiambi. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Batu banga badi bu shanga ikamata mu shila, hafofuebu musahu wu Tshiambi, amu hahu, muhitshi ubatambula, musahu ulengela usheyi mukuna munda muabu. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Batu banga badi bu buloba bukadu hanandi mabu muaba ukamata shanga. Hafofuebu musahu ulengela bawatataboshi yi diyandi diosu. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Kadi, kawushi kuela mishu munda muabu, batataboshi bu tshitayi tshiatshinyi. Neku habakuata bualu bubodu nashi mutanda bu musahu, bakoma Tshiambi nyima manyangu. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Batu banga badi bu buloba bu mieba bukamata shanga. Badi batu bafofu musahu wu Tshiambi, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />kadi bu lukanyi lu malu a ha buloba, bo dinanga di madiyi ibo bitu binga biosu, biahudishi musahu neku bua kawu kuamishi bimuma. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Batu banga badi bu shanga ikamata mu buloba bulengela bukamata shanga, badi batu bafofu musahu ulengela, bawatataboshi, neku walela bimuma. Banga misangu masandi asatu, banga misangu masandi asambombu, neku banga misangu 100.”<verse eid="MRK 4:20" /></para>
  <para style="s1">Mukunda wu muendu</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luka 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:21. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="LUK 11:33">Lk 11:33</ref>.</char>
    </note>Yesu ukamba kabidi ne: “Mutu udi mukutemeshi muendu buku ubueshi mushi mu musheta anyi mushi mu bulalue? Kashi uteka kulu mulembeleshi bua wukubukishi mu subu bundi buamue? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22. </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10:26</ref>; <ref loc="LUK 12:2">Lk 12:2</ref>.</char></note>Biosu bidi bisokomeshi, biya tambuka hakubuka hanadu mutshila ulema, yi bundi buabi bidi bisokomeshi baya biteka hakubuka. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Udi bo matshu a kofu ofu biandi!” <verse eid="MRK 4:23" /><verse number="24" style="v" sid="MRK 4:24" /><note caller="+" style="x"><char style="xo" closed="false">4:24. </char><char style="xt" closed="false"><ref loc="MAT 7:2">Mat 7:2</ref>; <ref loc="LUK 6:38">Lk 6:38</ref>.</char></note>Yesu ukabambila kabidi ne:</para>
  <para style="p" vid="MRK 4:24">“Nulubuka ku biosu binuafofu!, tshihiminu tshiahimina natshi, bayakuhimina biebi natshi, baya nuesela nuenu bidika haha. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><note caller="+" style="x"><char style="xo" closed="false">4:25. </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Lk 19:26</ref>.</char></note>Bualu, mutu udi bo tshitu bayamuha tshinga tshitu, kadi udi bo buashi, baya mutambula kata kadieyi naku.”<verse eid="MRK 4:25" /></para>
  <para style="s1">Mukunda wu mitondu miditolokela</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesu uka bambila kabidi ne: “Bushashendi bu Tshiambi budi bufuanangana bo mutu ukakuna maminu mu tshibidi tshiandi. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Butuku ukalala tulu, munyinyi wabika ku tulu, mitondu ikatoloka, ikalunda kalubuki mushindu uka lundeyi. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Buloba kayabu kabukatolokeshi mitondu kubushi, kunyima yalunda neku ihudua kuama. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" /><note caller="+" style="x"><char style="xo" closed="false">4:29. </char><char style="xt" closed="false"><ref loc="JHN 3:13">Yo 3:13</ref>.</char></note>Hakafika tshitshietshi tshi kubuka bimuma, mutu yewu wabangishi kubibuka, uduadu yi musadi wandi bukukaleyi biakuama ku mutshi.<verse eid="MRK 4:29" /></para>
  <para style="s1">Mukunda wu mutondu wu mutada</para>
  <para style="r">(<ref loc="MAT 13:31-32">Matayi 13:31-32</ref>; <ref loc="LUK 13:18-19">Luka 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesu ukamba kabidi ne: “Tudi mu kufuanyikishi bu shashendi bu Tshiambi yi binyie?” “Mukunda kayi utunakuela bukufuanyikishi bushashendi bu Tshiambie? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Budi bu mutondu wu Mutada, udi, mbe bawukuna mu buloba, udi ukese ku mitondu bundi buayi yi ha buloba <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Neku hana mukunebu mu buloba, wabanda, uduadu ulema mutambe mitshi bundi buayi yi mu tshibidi, wakuama matamba male yi manene, nunyi iya kuabaka masu ayu mu butalalu buawu.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yesu ukadu wayishi batu musahu ulengela mu mikunda bu unekuewu bilondieshila bakadu bashakama bamuafofu. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Kadu wayishi kakuakadi mikunda bi, kadi hakadueyi bo bayidi bandi kayabu, ukadu ubambiambila malu bundi buawu.<verse eid="MRK 4:34" /></para>
  <para style="s1">Yesu wabatamishi Mafuala.</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matayi 8:23-27</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Hakudiololu ha mutshilawu, Yesu ukambila bayidi bandi ne: “Tuyakayi dishiyi di dishiha.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Bakatambuka mu tshieyi wu batu, bayidi bakabuela mu buatu bukadu Yesu bakasabuka disambu di mayi bakala yi matu manga. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Amu hahu, luhehele lukola lukadu ha mayi, mafuala akabuela mu buatu, hua yi hakowola mayi mu buatu. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesu ukadu mulala kusula ku buatu kunyima, muteka mutshu ha musamu, bayidi bakamubishi bakamba. “Muyishi tuatshieba kufu, kabisu kuambila bualu mbe?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Yesu ukabika, ukabolokela luhehele, uka luambila ne: “Shakama holu!” Neku ukambila mafuala ne: “Batama!” neku, luhehele lukahu, ditalala dikabuela. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Kunyima, Yesu ukambila bayidi bandi ne: “Bukayi nudi bo bowue? Hua yi lelewu kanuena bo ditabushe?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Neku bowu bundi bukabakuata, bakokoshangana. “Yewewu yi nganyie? Mafuala yi luhehele bimuafofuela!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">Yesu wandondoha mutu mukuatshibu kudi nyinga mubodu.</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matayi 8:28-34</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Kunyima, Yesu yi bayidi bandi bakafika dishiyi di dishiha di Ngalela, mu tshitshinyi tshi bula tshi Gelasa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Hakatuluka Yesu mu buatu, mutu ukatambuka mukakatshi mu ngita, bakasangila nandi. Muntuewu ukadu mukuata kudi nyinga mubodu. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Neku mutuewu ukadu mushakama anu mukakatshi mu ngita, ka kuadu mutu ukadu muku mukuata nashi kumukanda kanu. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Ku mutshila ku mutshila, bakadu bamuakanda kanu ku mikolu bo ku maboku, kadi ukatula kanu yi biamu bikaduebu bamukanda nabi ka kuadu mutu ukadu yi ngudu ikumukuata. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Meba osu, ukadu watshimba mukakatshi mu ngita, yi ku luhongu walela ndolu yi kuditaha mbuta yi mabue hambidi yeye kayandi.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Hakamoneyi Yesu uduadu; ukayi manyangu ukadiela ku makasa a Yesu ukasa binu hashi kubushi kuandi, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />ukela diyi dikola ne: “Yesu Muana wu Tshiambi muena kulu udi nami bualu kaye? Kuasengola mu dina di Tshiambi ulema washakama mu diwulu kuakengeshi!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />(Neku Yesu ukambila “Nyinga mibodu ne, tambuka munda mu mutuewu!”)<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Neku Yesu ukamokoshi ne: “Dina diebi nganyie?” Uka mukudumuna ne: “Dina diami nadi ‘Legona’ bualu tudi tshiokutshioku!” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Mutu ukasengola Yesu bune kabahatshi muabawu.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Hahiehi bo luhongu, kukadu ngunda yabila kudi. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Nyinga mibodu ikasengola Yesu ikamba ne: “Tutuma mu ngulubieyi, bune tubuela munda muayi.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesu ukataboshi, nyinga mibodu ikatambuka munda mu mutu, ikabuela munda mu ngulubi. Ngulubieyi bundi buayi ikadu nashi 2,000 ikafulangana kulu ku luhongu ikayadiela mu mayi ikafu.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Balami ba ngulubi bakayi manyangu bukuya kuambila bakadu bashala mu bula yi ku matshika. Batu bakadu bukumona tshikadikangana, <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Hakafikebu hahiehi bo Yesu, bakamona mutu ukadu mukuata kudi lengona, ukadu muhona hashi, muluata mindala hambidi bo buanyi buandi bosu, bakofu bowu. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Bakamona malu bundi buawu, bakambila batu malu osu akesekela mutu mukuatshika nyinga mibodu.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Amu hahu, bakeseshi Yesu bune utambuka mu bula buabu.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Hakadu Yesu wabuela mu buatu, mutu ukadu mukuatshibu bo nyinga mibodu uka musengola bune “Bayaka nandi!”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Neku, Yesu kamuataboshila, ukamuambila ne: “Hinga kuenu mu bulungu buenu wamba malu alema a kuesela shashendi mu muengu wandi.”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Neku, mutu ukayi, ukambila batu mu mala disandi, malu osu akamuesela Yesu. Batu bosu bakamofu, bakakema bikola.<verse eid="MRK 5:20" /></para>
  <para style="s1">Muana wu babakashi wu Yayilo bo muamukashi wu kakakoha mundala wu Yesu</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matayi 9:18-26</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Hakahinga Yesu mu buatu dishiyi dinga di dishiba di Ngalela, batu bandi bakadu hahiehi nandi bamutshimbidila bamana ku mbambadi ku dishiha di Ngalela. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Neku umu wu mu balombodi ba mu sunangonga ukadu dina diandi Yayilo, hakamoneyi Yesu, ukashakama hashi ku makasa andi <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />neku ukamusengola ukamba ne: “Munami wu babakashi watshieba kufu kuasengola duaka umuteka dikatshi diebi mumutshu uhete londahu!”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Neku Yesu ukayi nandi. Batu bandi bakamulamata, bakamuhudishi nseke bundi buayi.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Mu batuamu, mukadu muamukashi bo kusama ku mashi adika kanana mitshiyi disandi yi ibidi, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ukayi kudi ba ngangabuka ba mishindu yosu, kadi kofu malonga ukatula fualanga yandi bundi buayi kadi kaheta londahu, hamutu hakofu malonga, mbabala ikafula. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Ukofu, batu batueyi bu Yesu, ukafunduka mukakatshi muabu kunyima ku Yesu ukakoha ku lohu luandi, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Bualu ukadu udialela lukanyi ne: “Mbe nakoha ku mundala wu Yesu, yakofu malonga.”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Amu hahu, mashi akadu atambuka akakama, ukofu malonga. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Amu hahu, Yesu ukofu ngudu yandi ikahueka. Ukakudumuka mukakatshi mu batu, ukokoshi ne. “Ngenyi wakoha ku mundele wamie?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Bayidi bandi baka mukudumuna ne: “Kushimona batu bakuabondola kuku yi kukue? Bitshi udi mukokoshi ne nganyi wuhu koha ku lohu luamie?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Neku Yesu ukatungunuka bu kutshioboka kumbambadi kuandi bu kumona mutu ukesa bualuabu. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Muamukashi ukadita bowu buka mukuata bualu ukalubuka tshikamuduila. Neku ukasa binu hashi ku makasa a Yesu. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesu ukamuambila ne: “Munami wu babakashi, kuatabushi kuebi kuakondaha. Yaka kuebi holu.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Hakadu Yesu utshiatueyi, batu bakatumabu kudi ba nkolomu ba mu sunangoga, bakadu bakamuambila ne: “Munebi wu babakashi umanafu, bukayi watateshi Yesue?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Yesu ukalubuka lukanyi luabu kadi ukambila nkolomu wu mu sunangonga, <note caller="+" style="f"><char style="fr" closed="false">5:36 </char><char style="fq" closed="false">kaba mofuela</char><char style="ft" closed="false">; anyi </char><char style="fqa" closed="false">kofu.</char></note>“Kutshinyi, wataboshi, munebi uyaheta moyi.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Yesu kananga bune batu baye mufila amu Petelu, Yakobu yi munabu wu babalumi Yone. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Hakafikebu ku subu wu nkolomu wu sunangonga, Yesu ukamona batu bayumbakana, badila, yi kuela ndolu ikola. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Ukabuela mu subu ukabambila ne: “Bukayi nuayumbakane? Bukayi nuadile? Muanewu kena mufu, kadi udi mulala tulu!”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Batu bosu baka museka. Neku uka batambula bundi buabu, ukangata tatandi bo mamandi yi bayidi bandi basatu, ukabuela nabu mu subu mukaduebu baladikishi muana. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Ukakuata muana ku dikatshi ukamuambila ne: “Talita, Kumu,” Buena kuamba ne: “Songakashi, nakuambiambila, bika hashi!”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Amu hahu songakashi ukabika hashi uka bangishi kuenda, neku batu bosu bakakema bikola.(Ukadu bo bitshietshi bu disandi yi bibidi.) <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Neku Yesu ukabambila bikola ne: “Kanuambidi mutu bualu buhueseka, neku, hakayi songakashi tshitu tshi kudi.”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">Batu ba mu Nasaleta ba biabi kuatabushi Yesu.</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matayi 13:53-58</ref>; <ref loc="LUK 4:16-30">Luka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesu ukatambuka mu bulabu, ukayi mu tshitshinyi tshi bula bukamulelabu, neku bayidi bandi bakamulamata. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Hakafika mutshila wu sabatu, ukabangishi kuyishi mu sunangonga. Bakadu bamuafofu bakakema, bakamba. “Mayisha aa wa aheta kuhaye? Nganyi wamuha lukanyi luluelue?” Buanya buneku wabuheta kuheyie? “Bihingu biaseseyebi bi mushindu kaye? Biosu biaseseyebi biduadu kuhaye? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Ka yeyi muena mabayi, munandi wu babalumi wu Maliyi, yi munabu bo Yakobu, bo Yose, bo Yuda, bo Simone? Yi bana babu ba babakashi kabashi shakama mukakatshi muetuemue?” Bionsuabi bikabahanguishi muku muatabushi.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:4. </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">Yo 4:44</ref>.</char>
    </note>Neku Yesu ukabambila ne: “Mupolofete udi bo butshuami kunga, kadi kena nabu mu bula buabu, mu bulungu buabu yi mu subu muabu.”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Kabualu kayi, kadu mukuesa tshihingu nashi tshimu, amu bena mbabala bante bakatekeyi makatshi hamitshu uka bondaha. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Ukakema bikola bu kuhangu kuatabushi kuabu.</para>
  <para style="s1" vid="MRK 6:6">Yesu watuma bayidi disandi yi babidi</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Matayi 10:5-15</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Kunyima, Yesu ukendakana mu mala osu akadu matshimbe yi kuyishi musahu ulengela. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Ukela bayidi bandi disandi yi babidi diyi ukabatuma ku babidi babidi. Ukabaha ngudu kubushi ku nyinga mibodu. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" /><note caller="+" style="x"><char style="xo" closed="false">6:8. </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Lk 10:4-11</ref>.</char></note>Yesu ukabasonga malanga ne: “Kanuangatshi tshitu tshikuyadi mu shila, amu hangu, kanuangatshi bikudi bi mu shila, kanuangatshi musaka ukuela fualanga, nashi fualanga mu mukaba, <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Bueshayi makasa enu mu bisabata, kadi kanuangatshi mindala ibidi.” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Ukabambila kabidi ne: “Kosu kununayi, batu mbe banuakidila, nushakama mu subuamu hua yi hanunatambuka mu bulamu. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" /><note caller="+" style="x"><char style="xo" closed="false">6:11. </char><char style="xt" closed="false"><ref loc="ACT 13:51">Bies 13:51</ref>.</char></note>Kadi mbe bena bula babi kunuakidila yi kunofuela, nutambuka muabawu, nubakumina makasa hashi nutambula buloba; bualuabu buyakuakala kudimushi!”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Neku, bayidi bakaya yishi batu bu batambuka mu bubodu buabu. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" /><note caller="+" style="x"><char style="xo" closed="false">6:13. </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yak 5:14</ref>.</char></note>Bakahata ngudu mibodu mindi ikadu mu batu, bakadu bandondoha batu yi kubela manyi mu mitshu.<verse eid="MRK 6:13" /></para>
  <para style="s1">Lufu lu Yone Mubatishi.</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matayi 14:1-12</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:14. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">Mat 16:14</ref>; <ref loc="MRK 8:28">Mk 8:28</ref>; <ref loc="LUK 9:19">Lk 9:19</ref>.</char>
    </note>Nkolomu Helode <note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="fq" closed="false">Nkolomu Helode</char><char style="ft" closed="false">. Helode Antipas, Nkolomu wu mu Galela.</char></note> ukofu batueyi bu Yesu bualu musahu wandi ukaduduka mu mangandu osu. Banga bakadu bambamba ne yeyi udi, “Yone mubatishi wabika ku bashandi kabualu kayi wasesa bihingu.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Banga bakamba ne: “Yeyi udi Eliyi.” Banga kabidi bakamba ne: “Yeyi udi mupolofete, mufuana umu wu bapolofete ba bilendi.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Hakofu Helode bikadu batu batueyi, ukamba ne: “Mutuawu yi Yone Mubatishi, unakakadishi mutshu neku wabika, ku bashiandi!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" /><note caller="+" style="x"><char style="xo" closed="false">6:17. </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Lk 3:19-20</ref>.</char></note>Neku, yeyi kayandi Helode ukatuma diyi bune bakuata Yone, bamuela mu subu wu lukanu mukanda mioshi. Bikadu bualu bu Helodia ukatekabu kudi Helode kadi yeyi muakala mukashia munabu Filipoyi. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Bualu Yone ukambila Helode ne: “Kabiena bilengela bune wewu uteka mukashia munenu bulandi bi!”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Neku, Helodia ukatshiatshieba mushindu wu Yone ubuela mu mualu wandi bukumushihishishi kadi kamona mushindu. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Neku, Helode ukadu watshina Yone, bualu ukadu walubuka ne Yone udi mutu ukadu bo loku, yi tshishila. Kabualu kayi ukadu umuakuba. Hakadueyi wafofu Yone watueyi, malu au akadu amuanyungulukisha bongu. Biandi, ukadu wananga kumofu watueyi.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Neku, mutshila ulengela ukadu bu kumona muku shihishi Yone, ukadu mutshila wu kufuluka kulediebu ku Helode. Neku, Helode ukayongeya diyangi mu bitshinyi bilema bisatu bu batu bandi, bena budiyi, ba nkolomu ba basalayi, yi batu banga ba mu Ngalela. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Muana babakashi wu Helodia <note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="fq" closed="false">Muana wu babakashi wu Helodia</char><char style="ft" closed="false">; Bidi bifunda mu mikanda minga </char><char style="fqa" closed="false">Munandi wu babakashi wu </char></note> ukabuela mu subu mukadu nkolomu ukashi mashi akayangishi Helode yi batu bandi. Neku nkolomu ukambila muana ne: “Ilombe tshitu tshiosu tshiananga nayakuha natshi.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Nkolomu ukaditshiha ukamba ne: “Nalomba tshiosu tshinananga, nayakuha natshi nashi tshitshinyi tshi hakakatshi tshi bu nkolomu buami.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Muana babakashi ukahatuka ukayi kudi mamandi ukamokoshi ne: Ndombe tshinganye? “Mamandi ukamukudumuna ne” Lomba kudi nkolomu, “Mutshu wu Yone Mubatishi.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Muana wu babakashi ukayi manyangu ukambila nkolomu Helode ne: “Natshieba ne waha hitshiowu mutshu wu Yone Mubatishi ha dilonga!”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Nkolomu ukadikuata, kadi kadu yi mushindu munga wu kuesa bualu ukadu umana ditshiha tshieleka kubushi ku batu bandi. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Ukatuma amu hahu disalayi diandi dikadu dimualama, yi diyi se diduaka yi mutshu wu Yone muteka ha dilonga, disalayi dikayi mu buloku dikakala mutshu wu Yone. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Dikadu nawu ha dilonga dikaha muana wu babakashi. Yeyi biandi ukayi nawu kudi mamandi. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Hakofu bayidi ba Yone musahu, bakadua kuangata mushandi wandi bakayamushika.<verse eid="MRK 6:29" /></para>
  <para style="s1">Yesu wadishi batu badika ha binunu bitanu.</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matayi 14:13-21</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yone 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Hakahinga tutuma, tukaya disangishi kudi Yesu, tukamuambila malu osu akesetu yi akayishetu. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Yesu ukabambila ne: “Tuyakayi muaba wu kayetu tuye kuekishi.” Neku, Yesu ukamba naku bualu kukadu batu bandi bakadu bayaya, banga baduadu, bikabahanguishi mushindu ukudi <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Neku, bakayi mu buatu kayabu mu muaba ukadu musokomi.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Kadi batu bandi bakabamona hakayebu bakabalubuka; bakakala lubilu ku makasa mu mala osu biafikebu kubushi ku yesu yi bayidi bandi. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" /><note caller="+" style="x"><char style="xo" closed="false">6:34. </char><char style="xt" closed="false"><ref loc="NUM 27:17">Nomb 27:17</ref>; <ref loc="1KI 22:17">1 Nkol 22:17</ref>; <ref loc="2CH 18:16">2 Kulam 18:16</ref>; <ref loc="EZK 34:5">Yehes 34:5</ref>; <ref loc="MAT 9:36">Mat 9:36</ref>.</char></note>Hakatambuka Yesu mu buatu, ukamona batu bandi muengu ukamukuata, bualu bakadu bafuanangana yi hanga idi kayakadi yi mulami. Ukabangishi kubayishi malu mandi. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Hakabuela diba, bayidi bakadu kudieyi bakamba ne: “Diba diteyi ha luhongu muabewu kawena batu, <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Hingishi batu bayaka mu bula budi hahiehi bayetshieba bidi bikudi.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Yesu ukabandamuna ne: “Amu nuenu bahayi bidi bi kudi,” Kadi bobu bakamba ne: “Amu tufualanga tuebi tubidietu katuyadieshi bu kudishi batu bundi nekue?”<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="fq" closed="false">Fualanga: </char><char style="ft" closed="false">A Dikutadi dikadu di nganga ulema, dikadu diadieshi difutu di mutshiyi wu bushima(Moona Mat 20:2).</char></note><verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Neku Yesu uka bokoshi ne: “Nudi bo mampa bundi bitshie? Yakayi nuye mona, bakaya mona biamuambilebu.” Tudi bo mampa, “Atanu bo nyishi ibidi.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Neku Yesu ukabatuma biabambilayi ne shakamishayi batu mu mashinda bibombu bibombu. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Batu bakashakama mu bibombu bi batu lukama, lukama yi banga masandi atanu, atanu. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Kunyima, Yesu ukangata mampa atanu yi nyishi ibidi, ukadingila kulu, ukatshuamika Tshiambi. Kunyima ukangata mampa ukaha bayidi bandi babanyena batu. Ukabanyi kabidi nyishi ibidi kudi batu bosu. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Mutu yosu ukadi ha sala yandi. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Kunyima bayidi bakangula mampa yi nyishi ikadu mishala, bakowoshi mikalangu disandi yi ibidi. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Neku bakadi mampa bakadu batu babalumi 5,000.<verse eid="MRK 6:44" /></para>
  <para style="s1">Yesu wandenda hanandi ha mayi.</para>
  <para style="r">(<ref loc="MAT 14:22-33">Matayi 14:22-33</ref>; <ref loc="JHN 6:15-21">Yone 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Amu hahu, Yesu ukambila bayidi bandi bune babuele mu buatu bayaka dishiyi di dishiba di Ngalela badingila ku bula bu Betesayida hakadueyi yeyi walayangana bo batu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Hakamanayi kulayangana nabu, ukayi ku luhongu bu kuyalomba Tshiambi. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Hakadu hakudiololu, buatu bukadu hakakatshi mu dishiba, Yesu ukadu mushale kayandi kumbambadi ku dishiba. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Ukamona ne bayidi bandi badi mu mutanda bu kuendeshi buatu bualu luhehele lukadu lubateteshi; neku ha lukiaki ukayi kudiebu wandenda hanandi ha mayi, ukadu watshieba kudika kubushi kuabu,<note caller="+" style="f"><char style="fr" closed="false">6:48 </char><char style="fq" closed="false">Ukatshieba kutshimba kubushi</char><char style="ft" closed="false">; anyi </char><char style="fqa" closed="false">Bu kufika hakaduebu.</char></note> <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Hakamumonebu wandenda ha mayi, Bakela ndolu bikola “Bakalubuka ne mushiandi!” <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Bualu bundi buabu bakamumona, bakadu yi bowu, neku hahu Yesu ukabambila ne: “Kasakanyishayi mutshima!” Imimi, kanutshinyi!<verse eid="MRK 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51" />Kunyima, ukabanda mu buatu ukahona nabu, luhehele lukatalala. Bayidi bakakema bikola, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Bualu kabashingulula tshikeseyi diba dikafudisheyi mampa yi kudishi ku batu batamba ha 5,000;<verse eid="MRK 6:52" /></para>
  <para style="s1">Yesu wandondoha bena mbabala mu Genesaleta.</para>
  <para style="r">(<ref loc="MAT 14:34-36">Matayi 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Yesu yi bayidi bandi bakasabuka biafikebu ha buloba bomu mu bula bu Genesaleta, bakateka matu abu ku tshindunda. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Hakatambukebu mu buatu, batu bakalubuka Yesu. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Neku, batu bakayi manyangu mu mala akadu nabu hahiehi, bakadu yi bena mbabala ha bihoyi bakadu batshieba muaba osu okofuebu ne yesu udi hahu. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Miaba bundi buayi ikadikeyi, mu mangandu, mu bitshinyi bi bula hua yi mu mala a batu yi kukadu mitumba, batu bakadu baduadu yi mbabala ha miaba mibuluke banga bakadu babasengola bu babedi bakuate nashi ku dilemba di mundala. Batu bundi buabu bakamukoha, bakofu malonga.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">Diyishi di Bamukuabu</para>
  <para style="r">(<ref loc="MAT 15:1-9">Matayi 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Bafalesa yi bayishi ba biadi bakadu badu mu Yelushalema, bakadisangishi kubushi ku Yesu, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Bakamona bayidi banga ba Yesu badiadi bidi kabowi mayi ku makatshi bu mukadu bilela biabu.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />(Neku, Bafalesa bo bena Yuda bosu bakadu balamata ku bilela bi ba mukuabu; kabadu mukudi kabakadi bowu mayi ku makatshi malonga; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Mushindu umu mbe badu mu tshisalu, kabadu mu kudi tshitu kubushi <note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">Kabadu mukudi tshitu kubushi ku kowu mayi ku biasa</char><char style="ft" closed="false">; nashi </char><char style="fqa" closed="false">Mbe badu mu tshisalu, kabashiedi tshitu mbe kabowela mayi.</char></note>ku kowebu mayi ha mbidi. Kutambula biabi, banemeka bilela binga bu kukusula malonga, mulondu, bo lusala, bulalu.)<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">Bibi kabiena bifunda mu mikanda minga</char><char style="fq" closed="false">Bo malalu.</char></note>) <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />Bafalesa bo bayishi ba biadi bakokoshi Yesu. “Bukayi bayidi bebi kabashi lamata malu a bamukuetu, kadi badiadi bidi bo makatshi mbindue?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:6. </char>
      <char style="xt" closed="false">
        <ref loc="EZK 29:13">Yehes 29:13</ref>.</char>
    </note>Yesu uka bakudumuna ne: “Nudi bena mushimushi! Yeshayi ukadu musuwu hakambeyi buenu meyi a tshipolofete hakafundeyi. ‘Tshiambi wambamba ne:</para>
  <para style="q1" vid="MRK 7:6">‘Banatshuamika ku mishiku,</para>
  <para style="q2" vid="MRK 7:6">kadi nyinga yabu idi kunga.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Kutshuamika kuabu kudi kanana,</para>
  <para style="q2" vid="MRK 7:7">bualu bayishi malu a mubidi</para>
  <para style="q2" vid="MRK 7:7">buene aduadu kudi Tshiambi.’”<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />Yesu ukatungunuka bo kubambila ne: “Nualetshiela ku mbambadi biadi bi Tshiambi, bu kulamata bilela biabu.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Neku Yesu ukabambila kabidi ne: “Nudi bo bilela bienu bilengela binuananga bu kuteka kumbambadi biadi bi Tshiambi anu bu kulamata ku bilela bienu. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" /><note caller="+" style="x"><char style="xo" closed="false">7:10. </char><char style="xt" closed="false"><ref loc="EZK 20:12">Yehes 20:12</ref>; <ref loc="EZK 21:17">21:17</ref>; <ref loc="LEV 20:9">Lew 20:9</ref>; <ref loc="DEU 5:16">Dut 5:16</ref>.</char></note>Neku Mosa ukamba ne: ‘Ofuela tatebi, yi mamiebi,’ kabidi bo ‘Mutu wafinga tatandi yi mamandi, bayamushiha.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Kadi nuenu nuambiambila batu ne: ‘Biakala mutu bo tshitu tshikuha Tatandi nashi Mamandi, hitshiowu nuenu nuambamba ne tshitu tshinashe kuakala nakuha, tshidi Kolobana.’ (Biafofueshi ne mulambu ukuha Tshiambi) <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Nuatataboshi bu mutu kakuatshishi tatandi nashi mamandi. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Hanuasesa naku, nuadiwula musahu ulengela wu Tshiambi bualu bu bilela bienu bibodu binuayishi batu, neku nuasesa malu manga mabodu mandi mafuanangana bo aa.”<verse eid="MRK 7:13" /></para>
  <para style="s1">Malu aduishi mutu mubodu.</para>
  <para style="r">(<ref loc="MAT 15:10-20">Matayi 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yesu ukela kabidi batu diyi ukabambila ne: “Nafudikishayi bundi buenu, ofuayi. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Kakuena tshitu tshi kushi tshiabuela munda mu mutu bukumona, amu tshiatambuka katshimua nona.<verse eid="MRK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 7:16" />“Ofuayi malonga, mutu udi bo matshu a kofu ofu biandi”<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Fesa wu 16 udi mukumbashi mu mikanda minga. </char><char style="fqa" closed="false">Badi bo matshu a kofu bofu biabu</char><char style="ft" closed="false">(Nashi 4:23).</char></note> <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />Hakatambuka Yesu mu tshieya batu, ukabuela mu subu, bayidi bandi bakadua muahangusha diofueshi di mukunda. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yesu uka bakudumuna ne: “Nuenu bienu kanushi kofue?” “Kanushi lubuka ne tshitu tshiduadu kushi tshiabuela munda mu mutu katshishi mona anu tshiatambuka munda muandi, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Bualu katshishi buela mu nyinga wandi bi, kadi tshiyayi mu difu, kunyima tshiyatambuka mu mubidi wandi.” (Hakambeyi diyadi, Yesu ukamba ne bitu biosu bidi bilengela bu kubidi.)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Ukamba kabidi ne: “Tshiatambuka munda mu mutu katshi muaduishi mubodu. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Bualu munda mu mutshima wu mutu kamuatambuka lukanyi lubodu lumuatuma bune wendakana mu tshiendenda, buefi, kushihangana, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />kuenda masandi, budiafi, ibo mishindu yi bitu biosu bibodu; kualakana, maholu, buyela, muambu. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Bitu biosuebi bundi buabi biatambuka mu nyinga wu mutu bimuaduishi mubodu.”<verse eid="MRK 7:23" /></para>
  <para style="s1">Ditabushi di muamukashi muena Siliya Foyineke</para>
  <para style="r">(<ref loc="MAT 15:21-28">Matayi 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesu ukatambuka ukayi hahiehi bo bula bu Tulo yi Sidona. Ukabuela mu subu, kataboshi bu batu balubuka ne udimu, kadi kadu muku sokoma. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Muamukashi ukadu yi munandi mukuata kudi nyinga mubodu, ukofu batueyi bu yesu ukadu kudieyi ukadiela hashi ku makasa andi. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Muamukashiewu ukadu muena ngelika, mulela mu suliafonike, ukasengola Yesu bune wahata nyinga mubodu ukadu munda mu munandi. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Kadi Yesu ukamuambila ne: “Letshiela bana ba mu subu bamane kokota, bualu kabiena malonga bukuangata diampa di bana kudielela bana ba nyimbu.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />“Muamukashi,” uka mukudumuna ne: “Shashendi, bana ba nyimbu badi mushi mu mesa badiadi kototu yamatshishi bana hashi!”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Neku Yesu uka muambila ne: “Bualu bu diandamuna diebi, hinga kuebi, uya sangana munebi nyinga mibodu imana tambuka munda muandi!”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Ukahingangana kuandi, hakafikeyi ukasangana munandi mulala ha bulalu nyinga mubodu ukadu umana tambuka munda muandi.<verse eid="MRK 7:30" /></para>
  <para style="s1">Yesu wandondoha mutu muakala yi dikukumina</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Yesu ukatambuka mu bula bu Tulo ukadika mu Sidona, mukakatshi mu mala dikumi ukahinga ku dishiba di Ngalela. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Batu banga bakamutshuadila mutu muamulumi kadu wa fofu, ukadu kabidi bo dikukuma, baka sengola Yesu bune umuteka makatshi. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Yesu ukaya nandi ku kayandi, ukamubueshi minu mu matshu, ukatula mata kusodia minu yandi ukamukuata ku ludimi. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Kunyima Yesu ukela mesu kulu, ukahuyikana, ukambila mutu ne: “Efata” buena kuamba ne: “Wosolokayi!”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Amu hahu, matsthu a mutu akosoloka, ludimi lukomboloka, ukabanga kutueyi malonga. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesu ukambila batu bosu bikola ne kanuambidi mutu bualuebu, kadi bu mukadueyi ubakandika, bobu bakatungunuka kuambila batu. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Batu bosu bakakema bikola, bakamba ne: “Biaseseyi bundi buabi bidi malonga, wasosolola matshu a batashi kofu!” “Watueyeshi batashi tueyi!”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">Yesu wadishi batu binunu binayi</para>
  <para style="r">(<ref loc="MAT 15:32-39">Matayi 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Mu mitshilayi, batu bandi bakadisangishi kabidi, bu mukaduebu kabakadi bo tshitu tshikudi, Yesu ukela bayidi bandi diyi ukabambila ne: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Nadi bo muengu wu batu bualu mitshila yadieshi isatu idiebu hahiehi nami kabakadi bo tshitu tshikudi, <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />mbe nabahingishi kuabu bo sala, bayalewoka mu shila, bualu banga bamukakatshi muabu baduadu tshitayi tshila.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Bayidi bandi bakamukudumuna ne: “Mu mbata mutudiemu, mutu udi mu kuheta bitu kuheyi batabata bu kudisheyi batu bundi nekue?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yesu ukabokoshi ne: “Nudi bo mampa bundi bitshie?” Baka mukudumuna ne: “Tudi bo mampa muanda mutekete.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Neku, Yesu ukabambila ne shakamishayi batu hashi mu mashinda. Kunyima, ukangata mampa muanda mutekete, uka tshuamika Tshiambi uka akala bituha bituha ukaha bayidi bandi bune babanyena batu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Bakadu bashala kabidi bo tu nyishi, ukatshuamika Tshiambi, bakatuabanya kabidi. <verse eid="MRK 8:7" /><verse number="8-9" style="v" sid="MRK 8:8-9" />Mutu yosu ukadi ha sala yandi. Bayidi bandi bakangula bibese bikadu bishala mikalangu muandamutekete miowola sebi. Batu bakabidi bakadu bu 4,000 Kunyima ku kulayangana nabu <verse eid="MRK 8:8-9" /><verse number="10" style="v" sid="MRK 8:10" />Yesu ukabanda mu buatu bakayi bo bayidi bandi ku tshitshinyi tshi bula tshi Dalamanuta.<verse eid="MRK 8:10" /></para>
  <para style="s1">Bafalesa balomba Yesu tshishingu</para>
  <para style="r">(<ref loc="MAT 12:38-42">Matayi 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:11. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Lk 11:16</ref>.</char>
    </note>Bafalesa banga bakadu kudi Yesu baka mokokoshi a malu akaduebu balubuka buku muela tuhetu. Bakadu batshieba ne ubebeshi tshishingu tshiabebeshi ne uduadu mu diwulu. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" /><note caller="+" style="x"><char style="xo" closed="false">8:12. </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Lk 11:29</ref>.</char></note>Yesu uka kusumina, ukamba ne: “Bukayi batu ba tshitshietshietshi balomba tshishingu bu bobu kuataboshi ne nadi Muana wu Tshiambie? Nanuambiambila diyi di kokuakoku ne, kakuena tshishingu nashi tshimu tshi naya nuebeshi!”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Kunyima, uka bashiyi, ukabuela mu buatu ukayi kabidi dishiyi dinga di dishiba.<verse eid="MRK 8:13" /></para>
  <para style="s1">Luefene lu bena Yuda bo Helode</para>
  <para style="r">(<ref loc="MAT 16:5-12">Matayi 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Bayidi bandi bakafilamina bu kuangata mampa, bakadu bo diampa dimu mu buatu. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" /><note caller="+" style="x"><char style="xo" closed="false">8:15. </char><char style="xt" closed="false"><ref loc="LUK 12:1">Lk 12:1</ref>.</char></note>Yesu ukabambila ne: “Wakalayi bo buanyi,” “Ku luefene lu bafalesa bo lu Helode.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Bayidi bakabanga kokoshangana kayabu ne: “Wambamba neku bualu katuena bo mampa.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Haka lubuka Yesu lukanyi luabu, uka bokoshi ne: “Bukayi nuakokoshangana ne bualu kanuena bo mampe? Huaa yi hitshiowu kanofuele? Nyinga yenu itshidi mikasakane? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><note caller="+" style="x"><char style="xo" closed="false">8:18. </char><char style="xt" closed="false"><ref loc="JER 5:21">Yelem 5:21</ref>; <ref loc="EZK 12:2">Yehes 12:2</ref>; <ref loc="MRK 4:12">Mk 4:12</ref>.</char></note>Nudi bo mesu kanushi mone? Nudi bo matshu kanushi kofue? Kanushi fuluke <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />hanakabanyi mampa atanu bu batu 5,000? Mikalangu bundi bitshi ikowola bo bibese?” Bakakudumuna ne: Tukowoshi mikalangu, “Disandi yi ibidi,”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />Yesu ukabokoshi kabidi ne: “Bo hanakabanyi mampa muanda muteketa bu batu 4,000, mikalangu bundi bitshi inu kowoshi bo bihese bikashale?” Bakakudumuna ne: Tukangula mikalangu, “Muandamuteketa” bo bihese.<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Neku Yesu ukabambila ne: “Kanushi kofu kabidie?”<verse eid="MRK 8:21" /></para>
  <para style="s1">Yesu wandondoha Mutu mufofu mu Betesayida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Yesu bo bayidi bandi bakafika mu Betesayida. Muamu, batu bakamutshuadila mutu muamulumi muakala bo mesu mafu neku baka musengola bu umukohe makatshi bune ofu malonga. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesu ukakuata mufofu ku dikatshi, ukatambuka nandi mu bula. Kunyima kukumuela mata mu mesu, bo kumuteka dikatshi, ukamokoshi ne: “Wamona kaye?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Mutu uka bulula mesu ukamba ne: “ Eee, namona batu, kadi nabamona bandenda bu mitshi.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Yesu uka mushibika kabidi makatshi ha mesu, ukamona malonga, ukondahibu bualu ukamona bitu biosu hakubuka. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Neku Yesu ukamulomba bune uhingangana ku subu kuandi ukamuambila. “Kuhingi mu bula bi”<verse eid="MRK 8:26" /></para>
  <para style="s1">Petelu washadika ne yesu udi kilisitu</para>
  <para style="r">(<ref loc="MAT 16:13-20">Matayi 16:13-20</ref>; <ref loc="LUK 9:18-21">Luka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesu bo bayidi bandi bakayi kabidi mu mala a hahiehi bo Kayisaliya wu Filipoyi, hakaduebu mu shila, ukokoshi bayidi bandi ne, “Batu banambamba, ne nadi nganye?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:28. </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14-15">Mk 6:14-15</ref>; <ref loc="LUK 9:7-8">Lk 9:7-8</ref>.</char>
    </note>Baka mukudumuna ne: “Banga bambamba ne udi Yone Mubatishi,” “Banga ne udi Eliyi, banga kabidi ne udi umu wu bapolofete.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:29. </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68-69">Yo 6:68-69</ref>.</char>
    </note>Neku, ukabokoshi ne: “Buenu nuenu, nuambamba ne nadi nganye?” Petelu uka mukudumuna ne: “Wewu udi Kilisitu.”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Neku, Yesu ukabambila bikola ne: “Kanuambidi mutu bualu buami.”<verse eid="MRK 8:30" /></para>
  <para style="s1">Yesu wambamba bu kufu kuandi</para>
  <para style="r">(<ref loc="MAT 16:21-28">Matayi 16:21-28</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Kunyima, Yesu ukabangishi kuyishi bayidi bandi ne: “Muana wu Mutu uyamona mutanda mundi, baya mubi kudi bakulu, kudi bayishi balema bo bayishi ba biadi. Baya mushiha, kadi kunyima ku mitshila isatu uyabika ku bashandi.” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Ukadu ubambiambila hakubuka. Neku Petelu ukayi nandi ha kayandi ukabanga kumuha milangu. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Kadi Yesu uka kudimuka uka tshioboka bayidi bandi, ukabolokela Petelu ukamba ne: “Tambuka hinga kunyima kuami muhitshi,” bualu, “Lukanyi luebi kaluena lu Tshiambi kadi lu batu ba habuloba!”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:34. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Lk 14:27</ref>.</char>
    </note>Kunyima, Yesu ukela batu bosu diyi yi bayidi bandi kudieyi ukamba ne: “Mbe mutu unanga kualamata,” udibi yeyi kayandi, “Wangata mutshi wandi mukalanganyi walamata. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><note caller="+" style="x"><char style="xo" closed="false">8:35. </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Lk 17:33</ref>; <ref loc="JHN 12:25">Yo 12:25</ref>.</char></note>Neku, unananga kuhandishi nyingandi uya mushimishi, kadi una shimishi nyingandi buami mimi, uya mu handishi. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Tshidi malonga tshingenyi bu mutu waheta budiyi bu buloba bosu, kadi washimishi nyinga wandie? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Tshinganyi tshidi mutu mukushintakashi ku nganga wu moyi wandie? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Unanofu bundu, bo unakofu bundu bu meyi ami mukakatshi mu batu ba masandi bo malu mabodu, Muana wu Mutu uya mofu biandi bundu hana hinganganeyi mu butshuami bu Tatandi, bo bayakulu ba tshishila.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Yesu uka bambila kabidi ne: “Nanuambiambila diyi di kokuakoku bamu banga badi haha kabanafu kubushi ku kumona kudu ku bushashendi bu Tshiambi yi ngudu yabu.”<verse eid="MRK 9:1" /></para>
  <para style="s1">Kukudumuka ku Yesu</para>
  <para style="r">(<ref loc="MAT 17:1-13">Matayi 17:1-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:2. </char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17-18">2 Pet 1:17-18</ref>.</char>
    </note>Hakatamba mitshila isambombu, Yesu ukangata Petelu, Yakobu, bo Yone ukayi nabu ku luhongu lule kukadueyi nabu kayabu. Ukakudumuka mubidi kubushi kuabu bobu bamona, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />mindala yandi ikabadika kuboo, kakuena mutu naku ha buloba udi mukutokesha mundala naku. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Amu hahu, bayidi basatu bakamona Eliyi, Mosa bakadu batueyi bo Yesu. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Petelu ukambila Yesu ne. “Muyishi, bidi bilengela bune tuakala muabewu, tuasa mitumba isatu, umu webi, munga wu Mosa, neku munga wu Eliyi.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Neku, kalubuka tshikadueyi watueyi bualu bosu bakadu bo bowu.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:7. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mk 1:11</ref>; <ref loc="LUK 3:22">Lk 3:22</ref>.</char>
    </note>Ditutu dikabashibika, diyi dikatambuka muamu ne: “Yewu yi munami unananga numofuela malonga!” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Amu hahu, bayidi kabamona kabidi mutu ku luseki luandi, amu Yesu kayandi.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Hakaduebu batahulumuki luhongu, Yesu ukabambila ne: “Kanuambidi mutu malu anuamona huaa yi hanabika Muana wu Mutu ku bashandi.”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Bakataboshi muka bambileyi, kadi bakadu badiatueyela. “Kubika ku batu ku bashandi kuafofueshi tshingenye” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" /><note caller="+" style="x"><char style="xo" closed="false">9:11. </char><char style="xt" closed="false"><ref loc="MAT 11:14">Mat 11:14</ref>.</char></note>Bakokoshi Yesu ne: “Bukayi balubuka biadi bambamba ne Eliyi uyamanadu yeyie?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Ukabambila ne. “Eliyi uyamanadu buku yongeyi malonga malu bundi buawu. Ahu bukayi musahu ulengela wambamba kabidi ne Muana wu Mutu uyabuela mu mutanda, baya mutshioboka yi disu diku muelula nadie? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Buami mimi, nambamba ne Eliyi umanedu, batu bakamuesela bu mukanangebu, kamuambamba kabidi musahu ulengela bu bualu buandi.”<verse eid="MRK 9:13" /></para>
  <para style="s1">Yesu Wandondoha muana wu babalumi ukadu bo nyinga mibodu</para>
  <para style="r">(<ref loc="MAT 17:14-20">Matayi 17:14-20</ref>; <ref loc="LUK 9:37-43">Luka 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Hakafika Yesu bo bayidi bandi basatu hahiehi hakadu bayidi banga, bakabamona bela mukakatshi kudi tshieyi wu batu, bakadu balubuki ba biadi bakabanga kuelangana nabu pata. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Batu hakamonebu Yesu, baka shishimuka, bakayi manyangu bukuya muela moyi. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Yesu ukokoshi bayidi bandi ne: “Nuatueyi nabu kaye?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Mutu ukabika mukakatshi muabu ukamba ne: “Muyishi, nahudu yi munami wu babalumi bualu udi munyingulukisha bongu kudi nyinga mibodu hamua kuatayi, washala tshimiemi. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Nyinga mibodu imuakuata nashi wakala hahayi, imuakuma hashi, muana watambula lututu ku mishiku, washashishi menu, mubidi wandi bundi buawu uduadu momu. Nalomba kudi bayidi bebi bua bahate nyinga mibodu, kadi bahangu.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yesu ukamba ne: “Batu bahangu kuatabusha nuenu, yashala nenu bitshietshi bundi bitshie? Nayakuangata bulemu buenu huaa yi tshitshietshi kaye? Itshuadilayi muanawu!” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Bakadu bo muana, nyinga mibodu hakamoneyi Yesu, ika mukasakanyeshi mubidi, yi kumu ditshishi, ikakumishi hashi, ukayi mubunguluki hashi, ukahatula lututu ku milomu.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Yesu ukokoshi tetandi ne: “Kuteyi bitshietshi bundi bitshi bidi bubediebu kudi muanewue?” Yeyi ukamba ne: “Katshi utshidi muana muamutshi,”<verse eid="MRK 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 9:22" />“Ku bitshietshi ku bitshietshi, nyingeyi mibodu imuatuma mu diku di mudilu nashi mu mayi bune uyefu. Tofuela muengu duaka utuambuluishi mbe udi mu kuesa!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesu ukamba ne: “Nashi binesa bualu, kadi lubuka ne malu osu adi ahuhula kudi mutu watataboshi.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Amu hahu, tetandi wu muana ukela ndolu ne: “Natataboshi, nakuatshishi mu kuhangu kuami ku kuataboshi!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Yesu ukamona tshieya batu bandi baduadu kukaduebu, ukabolokela nyinga mubodu uka muambila. “Wewu nyinga mubodu,” Waduishi muana tshimiemi bo kashikofu, “Kuambiambila hatuka munda mu muanewu ne kuhinganganyi kabidi mu yeyi bi!”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Nyinga mubodu ukadu munda mu muana, ukela ndolu ikola, ukakumisha hashi yi nsamu ikola, ukayi. Muana ukadu bu mutu mufu, batu bandi bakamba ne: “Ufufu.!” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Kadi Yesu ukamukuata ku dikatshi, ukamubisha hashi muana ukabika.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Hakahinga Yesu ku subu, hakadu bayidi bandi bakala nandi kayandi, bakamuahangushi. “Bukayi tuetu tuahangu bu kuahata nyinga mibodu mu muane?” <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Yesu uka bakudumuna ne: “Nyinga mibodu yi neku yatambuka anu kukulomba ku Tshiambi.”<verse eid="MRK 9:29" /></para>
  <para style="s1">Yesu wambamba bu kufu yi kubika kuandi kubashiandi</para>
  <para style="r">(<ref loc="MAT 17:22-23">Matayi 17:22-23</ref>; <ref loc="LUK 9:43-45">Luka 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yesu bo bayidi bandi bakatambuka muabawu, bakayi mu Ngalela, kadi yeyi kananga bune batu balubuki kukadueyi. <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />Ukayishi bayidi bandi ukamba ne: “Muana wu Mutu baya mufila mu makatshi a batu babodu, baya mushiha, kadi hanadika mitshila isatu uyabika ku bashandi.”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Kadi bayidi bandi kabadu bafofu mukadueyi watueyi, bakadu bo bowu buku muahangushi.<verse eid="MRK 9:32" /></para>
  <para style="s1">Nganyi udi ulema mu bushashendi bu Tshiambi</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matayi 18:1-5</ref>; <ref loc="LUK 9:46-48">Luka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Yesu bo bayidi bandi bakafika mu Kapenuma, hakafikebu ku subu, yeyi uka bokoshi ne: “Nusheyi nuatueyi kaye mu shile?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:34. </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Lk 22:24</ref>.</char>
    </note>Kadi bobu bakashala holua, bualu mu shila bakadu balelangana pata ha bualu bu ne mukakatshi muetu nganyi udi ulema mudike bange? <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" /><note caller="+" style="x"><char style="xo" closed="false">9:35. </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mat 20:26-27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43-44">Mk 10:43-44</ref>; <ref loc="LUK 22:26">Lk 22:26</ref>.</char></note>Yesu ukahona hashi, ukela bayidi bandi disandi yi babidi diyi uka bambila ne: “Mutu mbe unanga kuakala ulema, uyakuakala wu kusula kudi banga uyakuakala muena mudimu wabu.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Hakatamba tshitshietshiatshi, ukangata muana muamutshi, biamutekaye mukakatshi muabu, uka mutshuala mu maboku andi ukamba ne: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" /><note caller="+" style="x"><char style="xo" closed="false">9:37. </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="LUK 10:16">Lk 10:16</ref>; <ref loc="JHN 13:20">Yo 13:20</ref>.</char></note>“Mutu yosu unakuakidila malonga muanewu muamutshi ku dinanga, uhunakidila mimi menemene, kabidi uhunakidila uhuakidila uhutuma.”<verse eid="MRK 9:37" /></para>
  <para style="s1">Udi kashi tubi udi wetu</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luka 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yone ukambila Yesu. “Muyishi, tuamona mutu wahahata nyinga mibodu mu dina diebi tua mukandika bualu kasheyi netu.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Kadi Yesu uka mukudumuna ne: “Kanumuhumbishi,” Bualu mutu kena mukuesa tshihingu mu dina diami, kunyimu utueyi bubodu buami. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><note caller="+" style="x"><char style="xo" closed="false">9:40. </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12:30</ref>; <ref loc="LUK 11:23">Lk 11:23</ref>.</char></note>Bualu mutu utashi netu matandu udi wetu, kena netu bualu bi udi buetu. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><note caller="+" style="x"><char style="xo" closed="false">9:41. </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mat 10:42</ref>.</char></note>Neku mutu yosu unanuha ngalasa umu wu mayi a kunu bualu nudi bami, nanuambiambila, uyaheta dikaha diandi.<verse eid="MRK 9:41" /></para>
  <para style="s1">Tuhetu tu balenduishi</para>
  <para style="r">(<ref loc="MAT 18:6-9">Matayi 18:6-9</ref>; <ref loc="LUK 17:1-2">Luka 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Mutu yosu una lenduishi umu wu mu bana babatshi badi banataboshi, baya mukanda dibu dilema mu shingu baya muela mu mayi. <verse eid="MRK 9:42" /><verse number="43-44" style="v" sid="MRK 9:43-44" /><note caller="+" style="x"><char style="xo" closed="false">9:43-44. </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat 5:30</ref>.</char></note>Biakala dikatshi diebi dikua lendukishi, udikala, malonga ubuela mu bushashendi bu Tshiambi bo dikatshi dimu ha mutu hakulama makatshi abidi kadi uyaka nawu mu mudilu utashi shima. Mu mudilu wawu, bikusu bidiadi mubidi kabishefu yi mudilu kawusu shima. <verse eid="MRK 9:43-44" /><verse number="45-46" style="v" sid="MRK 9:45-46" /><note caller="+" style="f"><char style="fr" closed="false">9:45-46. </char><char style="ft" closed="false">Meyi aa adi makumbashi mu Fesa wu 44. </char><char style="fqa" closed="false">There ‘Muamu, mudi bikusu bitashiefu, Bo mudilu wu biashoshi kawushi shima’ </char><char style="ft" closed="false">(moona mu Fesa 48).</char></note>Biakala dikasa diebi dikualenduishi, udikala, bidi malonga bukubuela mu moyi wu kusula bo dikasa dimu hamutu ha kuakala bo makasa abidi kadi kuya kuedibu mu tshina tshi mudilu utashi shima. Muamu, bikusu bidiadi mubidi kabishefu, yi mudilu kawusu shima. <verse eid="MRK 9:45-46" /><verse number="47" style="v" sid="MRK 9:47" /><note caller="+" style="x"><char style="xo" closed="false">9:47. </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5:29</ref>.</char></note>Neku biakala disu diebi ka dikualenduishi, ditula bidi malonga bune wewu kubuela mu bushashendi bu Tshiambi yi disu dimu hamutu ha kulama mesu abidi kadi kuya kuediebu mu mumudilu utashi shima. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" /><note caller="+" style="x"><char style="xo" closed="false">9:48. </char><char style="xt" closed="false"><ref loc="ISA 66:24">Yesh 66:24</ref>.</char></note>Muamu, ‘Bikusu bidiadi mubidi kabishefu yi mudilu kawushishima.’<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“Mu kudika mumudilu, mutu yosu uyatuila bu muatuila mutshiela.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:50. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="LUK 14:34-35">Lk 14:34-35</ref>.</char>
    </note>“Mutshiela udi tshitu tshilengela, mbe ushimishi kutshu kuawu, baya utuishi bo kaye? “Wakalayi bo mutshiela mu nuenu, nuakala kabidi holua kudi mutu yosu bo muana kuabu.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">Diyishi di Yesu ha kushiha ku bulandi.</para>
  <para style="r">(<ref loc="MAT 19:1-12">Matayi 19:1-12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesu ukatambuka muabawu ukayi mu Yudayi dishiyi di dishiba di Yadena. Batu bandi bakadisangishi hahiehi nandi, ukabayishi bu ha tshibidilu.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Bafalesa banga bakadu kudieyi bukumuteyi tuhetu, bakamokoshi ne: “Bidi biatabushibu,” mu biadi bietu bu, “Muamulumi wahata mukashiandi mbe?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yesu ukabakudumuna mu ku bokoshi ne: “Mosa ukanuha tshiadi kayie?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:4. </char>
      <char style="xt" closed="false">
        <ref loc="DEU 24:1-4">Dut 24:1-4</ref>; <ref loc="MAT 5:31">Mat 5:31</ref>.</char>
    </note>Bakamuambila ne: “Mosa ukaha muamulumi mukanda ukushiha bulandi bo kuahata mukashiandi.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Neku Yesu ukakudumuna.ne: “Mosa ukela tshiadi buenu nuenu bualu nyinga yenu idi ikola. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" /><note caller="+" style="x"><char style="xo" closed="false">10:6. </char><char style="xt" closed="false"><ref loc="GEN 1:27">Gen 1:27</ref>; <ref loc="GEN 5:2">5:2</ref>.</char></note>Mifundu yi tshisthila yabamba ne: ku mbangula, hakanga Tshiambi bitu biosu ‘ukesa tshiatshilumi yi tshiatshikashi,’ <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" /><note caller="+" style="x"><char style="xo" closed="false">10:7. </char><char style="xt" closed="false"><ref loc="GEN 2:24">Gen 2:24</ref>.</char></note>‘Kabualu kayi, muamulumi uyashiyi tatandi bo mamandi uyalamata kudi mukashiandi bubidi buabu bayadu mubidi umu.*<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Meyi aa ka ena mu mifundu minga </char><char style="fq" closed="false">Neku bayadu mubidi umu bo mukashandi</char><char style="ft" closed="false">.</char></note> <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Bubidi buabu bayadu mubidi umu,’ Naku, kabana kuakala babidi, kadi bayakuakala mubidi umu. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Neku, mutu kena mukuhandulula tshidi Tshiambi mukanda.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Hakahingebu ku subu, bayidi bakamokoshi kabidi ha malu awu. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" /><note caller="+" style="x"><char style="xo" closed="false">10:11. </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10-11">1 Koli 7:10-11</ref>.</char></note>Ukabambila ne: “Biabi muamulumi mukashiandi, bimuahateyi, bitekeyi mukashi munga, uhuenda masandi kudi ukadueyi nandi kubushi. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Bidi momumu, muamukashi bihidieyi mbayandi mbe bamuteka kudi muamulumi munga, uhuenda masandi.”<verse eid="MRK 10:12" /></para>
  <para style="s1">Yesu walela bana manyi.</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matayi 19:13-15</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Batu bakadu yi bana balebela kudi Yesu bu wubatenteke makatshi ha mitshu yabu kadi bayidi bandi baka babolokela bua kabafiki nandi hahiehi. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Hakamona Yesu naku, samu ika mukuata ukambila bayidi bandi. “Baletshielayi baduaka kunadi kanu bateteshi bualu bushashendi bu Tshiambi budi bu batu badi bafuanangana nabu. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><note caller="+" style="x"><char style="xo" closed="false">10:15. </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat 18:3</ref>.</char></note>Nanuambiambila diyi di kokuakoku, utashi kuataboshi bushashendi bu Tshiambi bu muanewu muamutshi, kanabuela kokoko.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Neku, ukangata bana mu maboku, ukabateka makatshi ukabela manyi.<verse eid="MRK 10:16" /></para>
  <para style="s1">Mutu muena budiyi.</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matayi 19:16-30</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Bu mukadu Yesu uyayi mu shila, mutu ukadu kudieyi manyangu, ukasa hashi kubushi kuandi, ukamulomba. “Muyishi ulengela, nesa kayi bu kuheta moyi wu yoyoye?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesu ukamokoshi ne: “Bukayi unalela mimi ne ulengele?” “Kakuena ulengela bi amu Tshiambi kayandi. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" /><note caller="+" style="x"><char style="xo" closed="false">10:19. </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Ek 20:12-16</ref>; <ref loc="DEU 5:16-20">Dut 5:16-20</ref>.</char></note>Walubuka tshiadi. ‘Kushihi mutu; kuangatshi mukashi wu bena; kuebi; kudimbididi mutu bualu, kuangatshi tshitu tshi mutu ku ngudu; unemeka tatebi yi mamiebi.’ ”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Mutu ukamba ne: “Muyishi,” Nakesa malu aa bundi buawu katshi ku buana buami.<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesu ukamudingila yi dinanga diosu ukamba ne: “Kudi tshitu tshimu tshikuahangu. Yaka, odoshi bitu biebi biosu bidi nabi, wangata fualanga uhaka bena mutanda; neku uyaheta budiyi mu diwulu, kunyima uduaka walamata.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Kadi hakofu mutu maluawu, mubidi ukayi muyowu yowaaa, ukayi bualu ukadu bo bitu bindi.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesu ukatshioboka batu bakadu bamutshimbe, ukamba ne: “Bidi bikola bu batu bena budiyi kubuelebu mu bushashendi bu Tshiambi!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Bayidi, bundi buabu bakakema hakofuebu meyi aa, Yesu ukabambila kabidi ne: “Bana bami bu mudiebi bikola bu kubuela mu bushashendi bu Tshiambi! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Bidi bilebela bu nyama ulema walelebu ne kamelu kudikaku mu ditondu di kashinyi, kadi bidi bikola menemene bu mutu muena budiyi kubueleyi mu bushashendi bu Tshiambi.”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Bayidi bakakema bikola, neku bakadu bakokoshangana ne: “Ahu nganyi lolu uyasungidibue?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesu ukabadingila ukamba ne: “Bu batu bidi bikola, kadi kudi Tshiambi bidi bilebela, kakuena bualu budi bukola kudi Tshiambi.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Kunyima, Petelu ukamba ne: “Ofu, tuetu tuashiyi bitu bietu biosu bukukulamata wewu.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu ukamuandamuna ne: “Nanuambiambila diyi di kokuakoku, mbe mutu ushiyi subuandi, bo bana babu ba babalumi bo baba bakashi, mamandi, tetandi, bana bandi, bo bibidi biandi, bu bualu buami mimi bo bu musahu ulengela, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />Uyaheta bindi misangu lukama mu tshitshietshi. Uyaheta subu mindi, bana ba babalumi ibo ba babakashi, ba mamandi, bana bandi, bo bibidi bo yi mutanda; neku mu bitshietshi biyadu kubushi uyaheta moyi wu yoyoyo. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><note caller="+" style="x"><char style="xo" closed="false">10:31. </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat 20:16</ref>; <ref loc="LUK 13:30">Lk 13:30</ref>.</char></note>Kadi bandi lelewu badi kubushi, baya kuakala ba kusula, kadi badi kusula baya kuakala ba kubushi.”<verse eid="MRK 10:31" /></para>
  <para style="s1">Yesu wambamba musangu muisatu bu kufu bo kubika kuandi</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matayi 20:17-19</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Yesu yi bayidi bandi bakadu mu shila bu kuyabu mu Yelushalema, Yesu ukadu nabu kadi ukayi kubushi kuabu. Bayidi bakakema bualu ukadu uyaya kudi batu babodu, bakadu babalamata bakofu bowu, Yesu ukangata kabidi bayidi bandi disandi yi babidi ukabanga kubambila malu akadu bo tshi kumuduila. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“Ukabambila ne” Fudikishayi, “Tuabanda mu Yelushalema, muyafilebu Muana wu Mutu mu makatshi a batu babodu bo bayishi ba biadi. Neku bobu, bayamufikishishi ku lufu, bayamufila mu makatshi a batu badi kabashilubuka Tshiambi, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Bobu bayamuseka, bayamutula mata hambidi, bayamukuma mioshi, bayamushiha, Kadi kunyima ku mitshila isatu, uyabika ku bashiandi.”<verse eid="MRK 10:34" /></para>
  <para style="s1">Kulomba ku Yakobu yi Yone</para>
  <para style="r">(<ref loc="MAT 20:20-28">Matayi 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Neku, Yakobu yi Yone bana ba babalumi ba Sebedayi bakayi hahiehi bo Yesu baka muambila ne: “Muyishi,” “Utuesela mosu mutunakulomba.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Yesu ukabokoshi ne: “Nuatshieba nuesela tshinganyie?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Baka mukudumuna ne: “Hanabuela mu butshuami buebi, wataboshi bune tushakama ku dikatshi diebi, munga ku dibabakashi, munga ku di babalumi.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:38. </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:50">Lk 12:50</ref>.</char>
    </note>Yesu ukabambila ne: “Kanushilubuka tshinualomba. Nuyanu lubalu lu busama lunayanuee? Mbe kuangata dibatisa dina batisabu nadie?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Baka mukudumuna ne: “Tuadieshi,” Yesu ukabambila ne: “Momu, nudi mukunu lubalu lunayanu, nudi mukuangata dibatisa dina batisebu nadi. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Kadi, kabiena mu ngudu yami bu kuteka mutu uya hona ku dikatshi diami dibabalumi nashi ku dikatshi diami di babakashi anu Tshiambi kayandi.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Hakofu bayidi banga disandi maluawu, bakofuela Yakobu bo Yone samu. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" /><note caller="+" style="x"><char style="xo" closed="false">10:42. </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Lk 22:25-26</ref>.</char></note>Neku, ukabela bosu diyi ukabambila ne: “Nualubuka ne batuamona ne badi kubushi ku banga, kudi banga badi biabu babatamba. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><note caller="+" style="x"><char style="xo" closed="false">10:43. </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23:11</ref>; <ref loc="MRK 9:35">Mk 9:35</ref>; <ref loc="LUK 22:26">Lk 22:26</ref>.</char></note>Kadi biabi kabiakadi mukakatshi muenu. Unananga kuakala ulema mukakatshi muenu, udibu tshikuakala muena mudimuenu; <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Kadi unananga kuakala ukubushi mukakatshi muenu, udi bo tshikuakala muena mudimu wu batu bosu. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Bualu Muana wu Mutu kaduila bu bamukuatshila mudimu, kadi uhudu bu kukuata mudimu bo kufila nyingandi bu mulambu bu kuha batu bandi moyi.”<verse eid="MRK 10:45" /></para>
  <para style="s1">Yesu wandondoha mufofu Batimayi</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matayi 20:29-34</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Yesu yi bayidi bandi bakafika mu Yeleku, hakatambuka Yesu bo bayidi bandi mu bula, mukadu mutu mufofu dina diandi Batimayi muana wu Timayi, ukadu mushakama kumbambadi ku shila; <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Hakofueyi ne Yesu wu mu Nasaleta wadika mu shila, ukela diyi dikola ukamba ne: “Yesu! Muana wu Dafidi! Inofuela muengu!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Batu bandi baka mubolokela bakamushakamishi holu, kadi yeyi ukakoleshi kuela diyi. “Yesu Muana wu Dafidi Inofuela muengu!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesu ukamana, uka bambila ne: “Muelayi diyi uduaka.” Neku, bakela mufofu diyi ukadu. Bakamba ne: “Wakala yi ngudu!” “Bika hashi, Yesu ukualela diyi.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Neku Batimayi, ukela kasaku hashi, ukabika manyangu ukayi kudi Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesu uka mokoshi ne: “Wananga mimi kuesela kaye?” Batimayi ukamukudumuna ne: “Muyishi,” “Natshieba mona.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesu ukamba ne: “Yaka,” “Kuataboshi kuebi kuakuha moyi.” Amu hahu ukamona, ukalamata Yesu mu shila.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">Yesu wabuela mu Yelushalema yi butshuami.</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matayi 21:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>; <ref loc="JHN 12:12-19">Yone 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Hakafika Yesu yi bayidi bandi hahiehi bo Yelushalema, mu bula bu Betefage yi Beteniya, idi ha luhongu lu Olefe. Yesu ukatuma bayidi bandi babidi <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Ukabambila ne: “Yakayi mu bula budi kubushi kuenu, hanunabuela, nuyamona kana ka nyama wu mpunda kadi mutu kabandila hanyima haku; nukasulula nuduaka naku. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Neku mutu mbe unokoshi, bukayi numuasulule? numuambila ne Shashendi udi naku bualu uyanuha naku manyangu manyangu.”<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">Muyishi</char><char style="ft" closed="false">; nashi </char><char style="fqa" closed="false">Fumuandi.</char></note> Udi nandi dishinga neku uya mutuma manyangu.”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Bayidi bakayi bakasangana kana ka nyama kakanda ku mutshi hahiehi bo tshibi tshi mushiku wu mbelu wu kubuela mu luhangu ku mbambadi ku shila. Hakaduebu bakasulula, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />batu bakadu hahu bakabokoshi ne: “ Bukayi nuasulula kana ka mpunda?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Baka mukudumuna amu mukabambila Yesu, neku batuabu baka batuma naku. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Bakadu yi mpunda kudi Yesu, baka shibika mindala hanyima handi, Yesu ukashakama ha nyima haku. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Batu bandi bakadishi mindala yabu mu shila, banga bakela bisaki bi mitshi bikakalebu mitu mu shila. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" /><note caller="+" style="x"><char style="xo" closed="false">11:9. </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">Misam 118:25-26</ref>.</char></note>Bakadu bayaya kubushi ku Yesu bo bakadu bamualamata kunyima kuandi bakadu bayayi kuamba ne: “Hosana! Diyangi diakala kudi uduadu mu dina di Tshiambi! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Diyandi diakala kudi bushashendi buduadu, bushashendi bu tatetu Dafidi, Hosana kudi Tshiambi muena kulu!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesu ukabuela mu Yelushalema, mu subu wu Tshiambi, hakamanayi kutshioboka bitu biosu bikadu bi mutshimba, ukayi mu Betaniyi bo bayidi bandi bualu tshitshietshiatshi diba dikadu dimanabuela.<verse eid="MRK 11:11" /></para>
  <para style="s1">Yesu walela mutshi wu Tshikuyi mulawu</para>
  <para style="r">(<ref loc="MAT 21:18-19">Matayi 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Fumafumawu habutshi, hakadu Yesu bo bayidi bandi batambuka mu Betaniyi, yeyi ukadu bo sala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Ukamona kule mutshi wu tshikuyi ukadu bo madu matuhuluka, ukayi bukumona mbe kudi bimuma, hakashekesheyi hahiehi, ukamona madu kayawu bualu katshiadu tshitshietshi tshi bimuma. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Neku Yesu ukambila mutshi wu tshikuyi ne: “Mutu kadiaki tshimuma tshiebi kokoko!” Bayidi bandi bakofu meyawu.<verse eid="MRK 11:14" /></para>
  <para style="s1">Yesu wahahata badodoshi bitu mu subu wu Tshiambi</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matayi 21:12-17</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yone 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Yesu yi bayidi bandi bakafika kabidi mu Yelushalema, hakabueleyi mu subu wu Tshiambi, ukabanga kuahata bakadu badodoshi bitu bo bakadu balola muamu. Ukahukula mesa a bakadu bashitula fualanga, yi miaba ikodoshi mputu nyunyi. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Ka nanga bu mutu nashi umu udika bo tshitu tshi kodueshi hahiehi bo subu wu Tshiambi. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" /><note caller="+" style="x"><char style="xo" closed="false">11:17. </char><char style="xt" closed="false"><ref loc="ISA 56:7">Yesh 56:7</ref>; <ref loc="JER 7:11">Yelem 7:11</ref>.</char></note>Kunyima Yesu ukabayishi ukamba ne: “Mifundu yi tshishila kayishikuamba ne: ‘Subu wami mimi bayamuela ne subu wu milombu bu mangandu bundi buawu.’ Kadi nuenu, nuakudumuna subu wami uhudu muaba wasangila batu babodu!”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Hakofu bayishi balema ba biadi, yi bafundi ba biadi, bakadu batshieba mushindu ukumushihishishiebu, kadi bakadu nandi bo bowu bualu batu bosu bakadu bakema bu mayishi andi.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Hakadu hakudiololu, Yesu yi bayidi bandi bakatambuka mu bulamu.<verse eid="MRK 11:19" /></para>
  <para style="s1">Diyishi di mutshi wu tshikuyi momu.</para>
  <para style="r">(<ref loc="MAT 21:20-22">Matayi 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Fumafumawu habutshi, hakadu Yesu bo bayidi bandi badika mu shila bu kuyi mu Yelushalema, bakamona mutshi wu tshikuyi momu huaa yi ku mishu. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Petelu ukafuluka tshikadikangana, ukambila Yesu ne: “Muyishi, moona, mutshi wu tshikuyi ukafingawu, uhoma bundi buawu!” <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Yesu ukambila bayidi bandi ne: “Wataboshayi Tshiambi! <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" /><note caller="+" style="x"><char style="xo" closed="false">11:23. </char><char style="xt" closed="false"><ref loc="ISA 56:7">Yesh 56:7</ref>; <ref loc="JER 7:11">Yelem 7:11</ref>.</char></note>Nanuambiambila diyi di Kokuakoku mbe mutu wambila luhongu tambuka hahu diela mu mayi, kakadi bo pata mu mutshima, kadi muataboshi ne tshinambamba tshiaseseka, tshihuambeyi tshiya kueseka. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Kabukayi nanuambiambila tshiosu tshinunalomba mu kulomba, nuataboshi ne numanatshiangata, neku bayanuha natshi. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" /><note caller="+" style="x"><char style="xo" closed="false">11:25. </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">Mat 6:14-15</ref>.</char></note>Neku hamamana batu bu kulomba Tshiambi, biakalebu bualu bo batu banga, babofuela muengu bune Tatenu udi mu diwulu ubofuela biabu muengu ku malu mabodu abu.” <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />“Kadi binuakala kanushi kofuela batu muengu, Tatenu udi mu diwulu kana nofuela bienu muengu bi.”<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Meyawu adi makumbashi mu fesa wu 26. </char><char style="fqa" closed="false">mbe kofuela banga muengu, Tatenu udi mu diwulu kana nofuela bienu muengu</char><char style="ft" closed="false">(Nashi Mat 6:15).</char></note><verse eid="MRK 11:26" /></para>
  <para style="s1">Kuduadu ngudu yasesa nayu Yesu malu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matayi 21:23-27</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Yesu yi bayidi bandi bakahinga kabidi mu Yelushalema. Hakadueyi uyayi mu subu wu Tshiambi, bayishi balema bo bayishi ba biadi, bo bakulu ba batu bakadieshangana nandi. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Bakamokoshi ne: “Ngudu kayi yasesa nayi malu ae? Ngenyi wakuha ngudu yi kuesa biasesebie?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesu ukabandamuna ne: “Nuakokoshi biami lukonku lumu; binuanandamuna, mimi biami ya nuambila kuduadu ngudu inasesa nayi malu aa. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Dibatisa di Yone dikadu mu diwulu mbe kudi batue? Nakudumunayi?”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Bakadiokoshi bobu kayabu ne tuya mukudumuna bitshie?. “Bituamba ne ‘Dikadu kulu,’ uyatokoshi ne ‘bukayi kanuataboshi Yone?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Neku bituamba ne. ‘Dikadu kudi batu.’” (Bakadu batshina batu bualu batu bosu bakadu balubuka ne Yone ukadu mupolofete) <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Neku baka kudumuna Yesu ne: “Katushi lubuka.” Neku Yesu ukabambila ne: “Mimi biami tshishinuambila kuduadu ngudu inasesa nayi malu aa.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">Mukunda wu mufutshidi mubodu.</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matayi 21:33-46</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:1. </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:1-2">Yesh 5:1-2</ref>.</char>
    </note>Neku Yesu ukabanga kuyishi ba nkolomu ba bena Yuda ne: “Mutu ukadu bo tshibidi tshiandi tshi mitshi yi tshikuyi ukawela mu luhangu, ukombola dina dikukama finyu, ukasa kasubu ka mubelemenyi bu kulama tshibidi. Ukashiyi tshibidi kudi bena mudimu buku futshila ukayi mu bula bunga. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Hakadieshi tshitshietshi tshi kubuka bimuma mu tshibidi, ukatuma muena mudimu kudi banowi bu kuheta tshiandi tshitshinyi tshi bimuma bika bukebu kudi bafutshidi. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Kadi bafutshidi, bakakuata muena mudimu uka tumebu, bakamukuma, bakamuhingishi makatshi buashi. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Neku, muena tshibidi uka tuma muena mudimu munga, bakamukuma mutshi ku mutshu bakamutuka maholu. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Muena tshibidi uka tuma kabidi mutu munga, yawu bakamushiha, uka tuma banga bandi, bakadu mutshibidi bakakuma banga, bakashiha banga kabidi. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Muena tshibidi ukadu mushala bo munandi umu kanana ukadueyi wananga. Kunyima uka mutuma kabidi ukamba ne: ‘Nalubuka ne bayanemeka munami’ <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Kadi bafutshidi hakamumonabu uduadu bakambilangana ne: ‘Monayi, uyahingangana tshibidietshi, neku tumushihayi bua buhianyi bushala kutudi!’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Neku, bakakuata muana wu muena bitu, bakamushiha bakatuhikishi kushi ku tshibidi. <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />Yesu ukabokoshi ne: “Muena tshibidi uya kuesa kaye?” Uyadu uyashiha bafutshidi bundi buabu, uyaha bafutshidi banga tshibidiatshi.<verse eid="MRK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 12:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:10. </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:22-23">Misam 118:22-23</ref>.</char>
    </note>Kanuabadiela diyiedi di mu mifundu yi tshishila yambamba ne:</para>
  <para style="q1" vid="MRK 12:10">‘Dibu dikabiebu kudi bakadu basasa subu;</para>
  <para style="q2" vid="MRK 12:10">dihudu dibu di muditumba.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Bihueseka neku bu muananga Shashendi kayandi,</para>
  <para style="q2" vid="MRK 12:11">tshidi tshihingu ku mesu kuetu!’”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Bayishi balema, bayishi ba biadi, bo bakulu ba batu, bakadu batshieba mushindu ukukuata Yesu, bualu uka belela bobu mukundewu. Kadi bu mukadu ba nkolomu ba bena Yuda batshina batu, bakabaletshiela bihuyebu.<verse eid="MRK 12:12" /></para>
  <para style="s1">Lukonku ha kulambula ku tshitadi.</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matayi 22:15-22</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Kunyimaku, bakatumina Yesu Bafalesa banga, bo batu banga ba Helode buku muteyi ku meyi aka tambuka mukanu muandi. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Hakafikebu, baka muambila ne: “Muyishi, tualubuka ne udi mutu wambamba meyi a kokuakoku. Neku, kushitshina mutu, kushi tshioboka malonga a mutu kadi wayishi anu meyi a kokuakoku bu shila wayangishi Tshiambi. Neku tuambila bidi bilengela kulambula tshitadi kudi ba nkolomu ba bena Lomu mbe bidi bibodue? Tufuta mbe katufutshi tshitadie?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Kadi bu mukadu Yesu ubalubuka ne bena mushimushi, uka bakudumuna ne: “Bukayi nunangiangila tuhetue? Duakayi bo lufualanga mona, shake nukudumuna.”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Bakamuha nadi dimuadi, Yesu ukabokoshi ne: “Hala udi ha dikutedi, bo dina didi difunda hahu bia nganyie?” Bakamukudumuna ne: “Bi Kayisa Ogisitu”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Neku Yesu uka bakudumuna ne: “Nuhaka Kayisa tshidi tshi kayisa, nuhaka Tshiambi tshi Tshiambi.” Bakakema bikola bu kukudumuna kuandi.</para>
  <para style="p" vid="MRK 12:17">Bakatamba kuelangana lukanyi bikola.<verse eid="MRK 12:17" /></para>
  <para style="s1">Lukonku ha kubika ku batu ku bashandi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matayi 22:23-33</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:18. </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">Bies 23:8</ref>.</char>
    </note>Basodoka bakadu bambamba ne kubika ku batu ku bashandi kakuenaku, bakadu kudi Yesu bu kumokoshi. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" /><note caller="+" style="x"><char style="xo" closed="false">12:19. </char><char style="xt" closed="false"><ref loc="DEU 25:5">Dut 25:5</ref>.</char></note>“Muyishi, ofu tshika fundebu mu mifundu yi Mosa. ‘Mutu biafueyi mbe ushiya mukashi kakadi mulela muana, munabu wangata mukashiawu bu kulelela munabu ukafu muana.’ <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Biabi, kukadu batu muanda muteketa, ukubushi ukateka mukashi ukafu kashiyi muana, <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ukadu mulamata ukangata mukashiawu, ukafu biandi kashiyi bana. Muisatu biandi mushindu umu, <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Bosu bakashala ku muandamutekete, kabashiyi muana. Kunyima kuabu bosu muamukashi ukafu biandi. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Neku, hanadieshi tshitshietshi tshi kubika ku batu kubashandi, muamukashiawu baya mutombi kudi nganyie? Bualu bundi buabu muanda mutekete bakadu ba bayandi.”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesu ukabakudumuna ne: “Nudiadimba kayenu, bualu kanushi lubuka diyi di Tshiambi nashi ngudu yandi. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Neku, hanabika batu ku bashandi, babalumi kabana tombi babakashi, nashi babakashi kabana batombi kudi babalumi, bayakuakala bu bayakulu mu diwulu. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" /><note caller="+" style="x"><char style="xo" closed="false">12:26. </char><char style="xt" closed="false"><ref loc="EXO 3:6">Ek 3:6</ref>.</char></note>Habualu bu kubika ku batu ku bashandi, kanuabadila mu mukanda wu biadi bi Mosa, muaba ukafundebu bu bualu bu dihuka dikatambuka mudilue? Tshiambi ukambila Mose. ‘Ndi Tshiambi wu Abalahama, Tshiambi wu Isaka, Tshiambi wu Yakobu.’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Yesu ukabambila kabidi ne: Tshiambi kena Tshiambi wu bashiandi, kadi wu badi bo moyi. Nudi mu dibuaka dilema!”<verse eid="MRK 12:27" /></para>
  <para style="s1">Tshiadi tshilema</para>
  <para style="r">(<ref loc="MAT 22:34-40">Matayi 22:34-40</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:28. </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">Lk 10:25-28</ref>.</char>
    </note>Umu uku bafundi ba biadi, ukofu hakadu Yesu watueyi bo basodoke, ukamona ne Yesu uka kudumuna malonga. Neku ukadu hahiehi bo Yesu ukamokoshi ne: “Ku biadi biosu, tshiadi kayi tshilema tshidi kubushi ku binge?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:29. </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:4-5">Dut 6:4-5</ref>.</char>
    </note>Yesu uka mukudumuna ne: “Moona tshiadi tshidi tshilema kudika binga. ‘Ofuayi bena Isalele! Shashendi Tshiambi udi Shashendi kayandi.<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="fq" closed="false">Shashendi Tshiambi wetu udi Shashendi</char><char style="ft" closed="false">; Nashi </char><char style="fqa" closed="false">Shashendi udi Tshiambi, udi Tshiambi kayandi.</char></note> <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Nanga Shashendi Tshiambi webi yi buanyi buebi bundi buabu, yi nyinga webi bundi buandi, yi lukanyi luebi losu, yi ngudu yebi yosu’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" /><note caller="+" style="x"><char style="xo" closed="false">12:31. </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lew 19:18</ref>.</char></note>Moona tshiadi tshibidi. ‘Unanga mutu nebi bu mudiananga wewu kayebi.’ Kakuena tshiadi tshinga tshidi tshidike tshitshi”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:32. </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:35">Dut 4:35</ref>.</char>
    </note>Mufundi wu biadi ukambila Yesu ne: “Malonga Muyishi! Uhuamba diyi di kokuakoku, Tshiambi udi umuawu, ne kakuena munga amu yeyi. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" /><note caller="+" style="x"><char style="xo" closed="false">12:33. </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hosh 6:6</ref>.</char></note>Mutu yosu udi bo tshiku munanga Tshiambi wandi bo. Mutshima wandi osu, bo buanyi buandi bosu bo ngudu yandi yosu, neku uyananga kabidi mutu nebi bu mudiananga wewu kayebi. Bidi bo nganga mundi kudika milambu yosu bo nyama mishihila Tshiambi.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Hakamona Yesu ne uka mukudumuna bo buanyi, ukamuambila ne: “Wewu kuena kule bo bushashendi bu Tshiambi.”</para>
  <para style="p" vid="MRK 12:34">Kunyimaku mutu nashi umu kamokoshi kabidi bualu.<verse eid="MRK 12:34" /></para>
  <para style="s1">Lukonku ha bualu bu Kilisitu</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matayi 22:41-46</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Hakadu Yesu wayishi mu subu wu Tshiambi, ukokoshi ne: “Bitshi bayishi ba biadi bambamba ne kilisitu udi muana wu Dafidie? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" /><note caller="+" style="x"><char style="xo" closed="false">12:36. </char><char style="xt" closed="false"><ref loc="PSA 110:1">Misam 110:1</ref>.</char></note>Bualu Dafidi yeyi kayandi mulombola kudi ngudu yi Tshiambi ukamba ne:</para>
  <para style="q1" vid="MRK 12:36">‘Shashendi ukambila Shashendi wami.</para>
  <para style="q2" vid="MRK 12:36">shakama ku dikatshi diami di babalumi,</para>
  <para style="q2" vid="MRK 12:36">huaa yi hananabueshi baku biabi bu tshitu tshikudiata mushi mu makasa ebi’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Biakala Dafidi yeyi kayandi ukamuela ne ‘Shashendi’; uyakuakala munandi bitshie?”</para>
  <para style="s1" vid="MRK 12:37">Yesu wadimukishi bu luefene lu bafalesa</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Matayi 23:1-36</ref>; <ref loc="LUK 20:45-47">Luka 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Batu bandi bakadu bamua hudikishi bo diyangi. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Mu diyishi diandi Yesu ukamba ne: “Wakalayi bo buanyi bualu bafundi bananga kuendakana baluata ngohu mile, babela moyi wu butshuami miaba miosoloka, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Basungula miaba yi butshuami mu subu wu Tshiambi bo miaba ilema mu miaba yi mayangi; <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Batambula kungudu bitu bi bawela, balomba Tshiambi wu tshitayi tshila bu batu babamone, buku shibika bubodu buabu. Bu malu awu, batuabu baya balumbuluishi bo dibuaka diabu diyakuakala dilema!”<verse eid="MRK 12:40" /></para>
  <para style="s1">Mulambu wu muamukashi muwela</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luka 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesu ukahona mu subu wu Tshiambi hahiehi bo tshibondu tshikaduebu balela fualanga, ukadu wamona mukadu batu balela. Batu bena budiyi bandi bakadu balela fualanga mindi; <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Muwela utashi bo tshitu, ukela biandi tukuta tubidi tukadu katuakadi bo nganga. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Neku Yesu ukela bayidi bandi diyi, ukabamba ne: “Nanuambiambila diyi di Kokuakoku, muwelewu, tshihuelayi mu tshibondu tshiatamba bihuela batu bosu; <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Bualu, bundi buabu bahuela bilondieshela bundi bu budiyi buabu, kadi muwelewu uhuela biosu bisheyeyi nabi bu kudi.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">Yesu wambamba bu kushimbuka ku subu wu Tshiambi.</para>
  <para style="r">(<ref loc="MAT 24:1-2">Matayi 24:1-2</ref>; <ref loc="LUK 21:5-6">Luka 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Hakatambuka Yesu yi bayidi bandi mu subu wu Tshiambi, umu wu kubayidi bandi ukamuambila ne: “Muyishi! moona, mabue kayi alengela neku adi masa ku subu, mabaka bilengela neku!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Yesu ukamukudumuna ne: “Wamona subu idi miasa ilemaye? Kakunashala dibu diteka hanandi ha dinga, bundi buawu baya abumbula.”<verse eid="MRK 13:2" /></para>
  <para style="s1">Dikasa dibodu bo mutanda.</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matayi 24:3-14</ref>; <ref loc="LUK 21:7-19">Luka 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Hakadu Yesu mushakama ha Luhongu lu Olefe mutshiobokangane bo subu wu Tshiambi, Petelu yi Yakobu, Yone yi Andele bakaya mona Yesu hakayabu, bakamokoshi ne: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Tuambila,” maluawu ayakueseka tshitshietshi kayie? “Tshishingu kayi tshiabebeshi ne maluawu aya kueseke?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yesu ukabambila ne: “Nulubuka, mutu kanudimbi. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Bandi bayadu mu dina diami bayanuambila ne: ‘Yi mimi Kilisitu!’ Neku bayadimba batu bandi. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Hanunakofu batueyi bu bitumba, nashi ngunungunu yi bitumba, kanofu bowu; bidi malonga bu biobiabi bieseka kadi kakuna kuakala kusula ku buloba. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Bula buyatandangana yi bula bunga, bu nkolomu buyatandangana bu nkolomu bunga; buloba buya nyunga miaba mindi, kuyakuakala lukota, bundi buabi biyakuakala bu mbangula wu lonu lu muamukashi udi bo difu.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:9. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17-20">Mat 10:17-20</ref>; <ref loc="LUK 12:11-12">Lk 12:11-12</ref>.</char>
    </note>“Nulubuka nuenu kayenu, bualu bayafikishi ku tubadi, bayanukuma yi kodi mu sunangonga, bayanulumbuluishi kubushi ku ba ngufena balema yi kubushi ku ba nkolomu bu kuheta bushadiki kubushi kuabu. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Kadi biakengela Musahu Ulengela wakala umana yishibu kudi batu ba mangandu osu. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Hanayabu nenu ku tubadi, kanudiokoshi ne tuyakuamba kayi, nuyakuamba amu meyi ananuhebu ha ludimi bu kuamba, bualu meyi awu ka anadu kunudi nuenu bi, kadi ayadu kudi Nyinga Ulengela. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Mutu uya fikishishi munabu ku lufu, tetandi wu bana uya fikishishi munandi ku lufu; bana baya tombokela baledi babu baya bashihishishi. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><note caller="+" style="x"><char style="xo" closed="false">13:13. </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat 10:22</ref>.</char></note>Batu bosu bayanubi bu bualu buami. Kadi unasuminyina huaa yi kusula, Tshiambi uya musungila.”<verse eid="MRK 13:13" /></para>
  <para style="s1">Yesu wambiambila bayidi bune bakala bakatamuka.</para>
  <para style="r">(<ref loc="MAT 24:15-28">Matayi 24:15-28</ref>; <ref loc="LUK 21:20-24">Luka 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:14. </char>
      <char style="xt" closed="false">
        <ref loc="DAN 9:27">Dany 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref>.</char>
    </note>Yesu ukabambila ne: “Mbe numona tshitu tshibodu tshiteka muaba utashi mu kuakalatshi,” (wabala mukanda wu Danyela ubaka matshu, ofu malonga tshiambambebu!) “Neku banakuakala mu Yudayi babanda manyangu ku luhongu; <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><note caller="+" style="x"><char style="xo" closed="false">13:15. </char><char style="xt" closed="false"><ref loc="LUK 17:31">Lk 17:31</ref>.</char></note>Mutu yosu unakuakala kulu ku lutanda katuluki bukuya kuangata tshitu mu subu. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Mutu bundi buandi unakuakala mu tshibidi kahingi kushi bukuya kuangata bilamba. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Dikasa dibodu kudi babakashi badi bo mafu bo banuishi bana mabela! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Lombayi Tshiambi bikola bune maluawu ka aduaki mu tshitshietshi tshi mushihu! <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" /><note caller="+" style="x"><char style="xo" closed="false">13:19. </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dany 12:1</ref>; <ref loc="REV 7:14">Kusok 7:14</ref>.</char></note>Bualu, mu tshitshietshiatshi, kuyakuakala mutanda ukola udi ne katshi Tshiambi wanga buloba kawaduile huaa yi hitshiowu neku kawunadu. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Biakala Shashendi kataboshela bu kukeheshi mitshila yi neku, mutu nashi umu kanahanduka; kadi yeyi uka akeheshi bu batu bandi bakasunguleyi.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“Neku bikuambila mutu ne: ‘Mona, Kilisitu kayewu!’ nashi ne ‘Mona Kilisitu kawu!’ Kanumuataboshi. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Bualu ba Kilisitu ba muambu yi bapolofete ba muambu bayadu, baya kuesa bihingu bo bishingu binudi kanuamuenyena badi muku hambukishi basungula ba Tshiambi. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Kadi nuenu, wakalayi bo buanyi, bualu nanuambiambila biosu kubushi ku tshitshietshi.”<verse eid="MRK 13:23" /></para>
  <para style="s1">Kudu ku Muana wu Mutu.</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matayi 24:29-31</ref>; <ref loc="LUK 21:25-28">Luka 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:24. </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:10">Yesh 13:10</ref>; <ref loc="EZK 32:7">Yehes 32:7</ref>; <ref loc="JOL 2:10">Yow 2:10</ref>; <ref loc="REV 6:12">Kusok 6:12</ref>.</char>
    </note>Yesu ukalunguluka yi kubambila ne: “Mu mitshilayi kunyima ku mutanda unekuewu, diba diya tshima hihi, ngondu kanakubukisha kabidi bu muakakalaye bi, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" /><note caller="+" style="x"><char style="xo" closed="false">13:25. </char><char style="xt" closed="false"><ref loc="ISA 34:4">Yesh 34:4</ref>; <ref loc="JOL 2:10">Yow 2:10</ref>; <ref loc="REV 6:13">Kusok 6:13</ref>.</char></note>Mitotu bundi buayi iya shanguluka hashi, ngudu yosu yi mu diwulu iya bukuka iyadu kanana. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" /><note caller="+" style="x"><char style="xo" closed="false">13:26. </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dany 7:13</ref>; <ref loc="REV 1:7">Kusok 1:7</ref>.</char></note>Hanatamba mutshilawu, bayamona Muana wu Mutu uyadu mu matutu, yi ngudu yandi yosu, yi butshuami buandi. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Neku, uyatuma bayakulu bandi bu kusangishi bakasungulayi ba mu seki inayi, ba ku mbombu ku buloba hua yi ku mbombu ku diwulu.”<verse eid="MRK 13:27" /></para>
  <para style="s1">Diyishi di mutshi wu tshikuyi</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matayi 24:32-35</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Yesu ukatungunuka yi kuyishi bayidi bandi ukamba ne: “Longayi dilesona di mukunda wu mutshi wu tshikuyi, hanakuamawu matamba, hanatuhuluka maduawu, nuyalubuka ne tshitshietshi tshi fula tshimanadu neku tshiadieshi. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Momumu, hanunamona malu aa ataseseki, nulubuka ne: Muana wu Mutu uteyi ha kudu.<note caller="+" style="f"><char style="fr" closed="false">13:29 </char><char style="fq" closed="false">tshitshietshi tshimana dieshi, Hahiehi bu kudu</char><char style="ft" closed="false">; or </char><char style="fqa" closed="false">tshiteyi hahiehi, Hahiehi bukudu.</char></note> <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Nanuambiambila diyi di kokuakoku, batu ba tshitshietshietshi kabanafu maluawu ka aduila. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Diwulu yi buloba biyashimina, kadi musahu wami kawunashimina kokoko.”<verse eid="MRK 13:31" /></para>
  <para style="s1">Tshiambi kayandi kalubuka kusula ku tshitshietshi</para>
  <para style="r">(<ref loc="MAT 24:36-44">Matayi 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:32. </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:36">Mat 24:36</ref>.</char>
    </note>Yesu ukambila bayidi bandi ne: “Habualu bu mitshila bo diba, kakuena mutu walubuka, nashi bayakulu ba mu diwulu, nashi Muana, amu Teta kayandi. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Nulubuka, katamukayi, bualu kanushilubuka tshitshietshi tshinadu maluawu. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" /><note caller="+" style="x"><char style="xo" closed="false">13:34. </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">Lk 12:36-38</ref>.</char></note>Biyakuakala bu hayayi mutu ku luendu, washiyi subu wandi yi malu bundi buawu kudi bena mudimu bandi; uhaha mutu yi mutu wandi mudimu, wambiambila mulami ne wakala mukatamuki. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Neku, katamukayi, bualu kanushilubuka tshitshietshi tshinadu muena subu. Dinga uyadu hakudiololu, dinga mundankulu, nashi hanatenda solu, nashi habutshi. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Mbe wadu manyangu kadu nusangana balala tulu bi <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />binanuambiambila nuenu bayidi bami, nabiambiambila batu bosu. wakalayi bakatamuki!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">Ba nkolomu babiabi Yesu batshieba ku mushiha</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matayi 26:1-5</ref>; <ref loc="LUK 22:1-2">Luka 22:1-2</ref>; <ref loc="JHN 11:45-53">Yone 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1. </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-27">Ek 12:1-27</ref>.</char>
    </note>Kukadu kushala mitshila ibidi bune diyangi di kudika ku Tshiambi yi di bidi kabiakadi biela luefene dikadu, bayishi balema bo bayishi ba biadi, bakadu batshieba mushindu ukukuata Yesu mushimushi bukumushiha. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Bualu bakambilangana ne: “Katueshi bualuebu mutshila wu diyangi,” Kanana batu bayakuesa “Tshikutukutu.”<verse eid="MRK 14:2" /></para>
  <para style="s1">Balela Yesu manyi mu Beteniya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matayi 26:6-13</ref>; <ref loc="JHN 12:1-8">Yone 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3. </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37-38">Lk 7:37-38</ref>.</char>
    </note>Yesu ukadu mu Beteniya mu subu mu Simona ukadu muena sudi, hakadueyi udiadi; muamukashi ukabuela bo mulangi wu mananashi a alabasata wu nganga ukola mowola sebi, muesa yi nado wu kokuakoku, ukosolola mutshu wu mulangi ukahongolola Yesu ha mutshu. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Batu banga bakadu hahu haka monebu bualuabu, samu ikola ika bakuata, bakokoshangana ne: “Bukayi bahona mananashi a nganga ukola nekue? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Ushekuakala wa odueshi ku nganga mundi bukuha batu badi kabakadi bo tshitu ku nganga wu fualanga mundi!” <note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fq" closed="false">Fualanga yi nganga ukola</char><char style="ft" closed="false">Moona 6.37.</char></note> Bundi buabu baka nyingaladiela muamukashiawu.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Kadi Yesu ukabambila ne: “Muletshielayi wakala holu, bukayi numuateteshie? Tshihuneselaye tshidi tshilengela; <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" /><note caller="+" style="x"><char style="xo" closed="false">14:7. </char><char style="xt" closed="false"><ref loc="DEU 15:11">Dut 15:11</ref>.</char></note>Bualu, nuyakuakala bo bahele mukakatshi muenu mitshila yosu, neku mitshila yosu inunananga kubesela kadi mimi kanuena nami mitshila yosu. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Mua mukashewu uhuesa tshiamoneyi ne tshiadieshi, yeyi wahongolola mananashi hambidi hami bukuayongodiela ngitami. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Nanuambiambila diyi di kokuakoku muaba wosu unakuambabu Musahu Ulengela, bayatueyi bualu bukesa muamukashewu.”<verse eid="MRK 14:9" /></para>
  <para style="s1">Yudasa walembola Yesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matayi 26:14-16</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Yudasa Isakaliyota ukadu umu wu kubayidi ba Yesu, ukayi kudi bayishi balema ba biadi ukatueyi nabu ha mushindu kayi udieyi muku balembola Yesu. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Hakofuebu meyi awu, bakayangila, bakamulayi bu kumuhabu fualanga. Katshi ha tshitayatshi, Yudasa ukadu watshieba mushindu ukubalembola Yesu.<verse eid="MRK 14:11" /></para>
  <para style="s1">Yesu wayongeyi diyangi di kudika ku Tshiambi bo bayidi bandi</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matayi 26:17-25</ref>; <ref loc="LUK 22:7-14">Luka 22:7-14</ref>; <ref loc="LUK 21:23">21:23</ref>; <ref loc="JHN 13:21-30">Yone 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Mutshila wu kubushi wu bidi bitashi biela luefene, mutshila ukaduebu balembola bana ba hanga bu kudika ku Tshiambi, bayidi bakokoshi Yesu ne: “Wananga tuye kuyongediela bidi bi diyangi di kudika ku Tshiambi kuheyie?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Neku, Yesu ukatuma bayidi bandi babidi ukabambila ne: “Yakayi mu bula nuyadieshi yi mutu mutshuala mulondu, lamatayi mutuawu, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Neku, kunabuelayaku, nuambila muena subu ne: ‘Muyishi wakokoshi, subu udi muyongeyi bu kudi bidi bi kudika ku Tshiambi yi bayidi bandi udi kuheyie?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Uya nuebeshi subu wu kulu ulema muyongeyi yi bitu bundi buabi bikuesa nabi diyangi.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Bayidi bakayi mu bula mukamba Yesu, bakasangana biosu biyongeyi bu mukabambileyi neku bakayongeyi bidi bi kudika ku Tshiambi.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Hakadu hakudiololu, Yesu ukafika yi bayidi bandi disandi yi babidi. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" /><note caller="+" style="x"><char style="xo" closed="false">14:18. </char><char style="xt" closed="false"><ref loc="PSA 41:9">Misam 41:9</ref>.</char></note>Hakaduebu ku mesa badiadi, Yesu ukabambila ne: “Nanuambiambila diyi di kokuakoku, umu wenu udiadi nami bidi, uyalembola mu makatshi a batu babodu.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Bayidi baka bunagama, bakokoshangana ku mutu ku mutu ne: “Muyishi yi mimie?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Yesu uka bakudumuna ne: “Umu wu mukakatshi muenu, unabueshi nandi dikatshi mu lubula lumu. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Muana wu Mutu uyafu bu muabamba mifundu yi tshishila; kadi dikasa dibodu diakala kudi yewu wamulembola mu makatshi a batu babodu, kabiadu bilengela bu mutuawu kulediebu!”<verse eid="MRK 14:21" /></para>
  <para style="s1">Bikudi bi Shashendi</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matayi 26:26-30</ref>; <ref loc="LUK 22:14-20">Luka 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Kolitu 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Hakaduebu badiadi, Yesu ukangata diampa, hakamaneyi kutshuamika Tshiambi, uka dikala ukaha bayidi bandi. Ukamba ne: “Wangatayi uwu yi mubidi wami.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Ukangata kabidi lubalu lu malufu, hakamaneyi kutshuamika Tshiambi, ukabaha neku bakanu bosu. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" /><note caller="+" style="x"><char style="xo" closed="false">14:24. </char><char style="xt" closed="false"><ref loc="EXO 24:8">Ek 24:8</ref>; <ref loc="JER 31:31-34">Yelem 31:31-34</ref>.</char></note>Yesu ukabambila ne: “Aa, adi mashi ami, mashi a tshilaka tshi Tshiambi akahongoloka hashi bu bualu buenu. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Nanuambiambila diyi di kokuakoku, tshinanu kabidi malufu bi huaa yi mu mutshila unananu malufu mahiamahi mu butshuami bu Tshiambi.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Hakamanabu komba musambu, bakatambuka bakayi bundi buabu batshioboka ku luhongu lu Olefe.<verse eid="MRK 14:26" /></para>
  <para style="s1">Yesu wambamba ne Petelu uya muhidia</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matayi 26:31-35</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yone 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:27. </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 13:7">Seka 13:7</ref>.</char>
    </note>Yesu ukambila bayidi bandi ne: “Bundi buenu nuyaletshiela bualu bakafunda mu mifundu yi tshishila ne: ‘Yakuma mukumbi, neku hanga iyaduduka’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" /><note caller="+" style="x"><char style="xo" closed="false">14:28. </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mat 28:16</ref>.</char></note>Kadi, kunyima ku kubika ku bashandi, duayi kubushi kuenu mu Ngalela”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Petelu ukamuambila ne: “Nashi batu bosu bakuletshiela, mimi tshina kuletshiela kokoko!”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Neku Yesu ukamukudumuna ne: “Nanuambiambila diyi di kokuakoku amu butuku bu lelewu, kubushi ku solu kutenda, wewu uyahidia tumu isatu.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Neku Petelu ukambulula yi ngudu bundi buayi ne: “Nashi biakalebi bu kufu nebi, tshina kuletshiela kokoko!”</para>
  <para style="p" vid="MRK 14:31">Neku bosu bakamba mushindu umuawu.<verse eid="MRK 14:31" /></para>
  <para style="s1">Yesu walomba Tshiambi mu Ngetesemena</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matayi 26:36-46</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Yesu yi bayidi bandi bakafika muaba ukaduebu balela ne Ngetesemena, ukabambila ne: “Shakamayi haha, nayalomba Tshiambi.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Ukayi bo, Petelu, Yakobu yi Yone. Ukabanga kofu bowu neku dibungama dika mukuata. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ukabambila ne: “Nyinga wami udi mubungama huaa yi hananafu; shalayi haha nuakala nami bakatamuki.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Kunyimaku, ukashekeshi kabidi kubushi, ukakuma hala hashi ukalomba Tshiambi ukamba ne: Mbe wataboshi tshitshietshi tshi mutanda tshitambuka kubushi kuami. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Ukamba ne: “Abba” “Teta bitu biosu bidi bihuhula kubushi kuebi; itambudila lubalu lu mutandelu. Kadi, biosu kabieseki bu munananga mimi kadi bieseka bu muananga wewu”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Yesu ukahinga kudi bayidi bandi basatu, ukabasangana balala tulu, ukambila Petelu ne: “Simona, udi mulale? Kuhetela ngudu ikutshieshi nami nashi tshitayi tshimue?” <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Ukabambila ne: “Katamokayi, nulomba Tshiambi bune kanuhoni mu tuhetu. Mutshima wananga, kadi mubidi udi muyowu.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Ukatambuka hakaduebu kabidi, ukalomba ukahishulula amu meyi amu amuawu. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Hakahingeyi kudi bayidi bandi, ukabasangana balala tulu; bualu mesu abu akadu bulemu. Kabadu bamona muku mukudumuna bi.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Hakahingeyi bu tumu muisatu, ukabambila ne: “Nutshidi balala kabidie? Kumanahu! Tshitshietshi tshimana dieshi. Hitshiowu, Muana wu mutu bayamulembola mu makatshi a batu babodu. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Bikayi hashi tuyakayi! Monayi mutu uyalembola kudi batu babodu umanadu!”<verse eid="MRK 14:42" /></para>
  <para style="s1">Bakuata Yesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matayi 26:47-56</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yone 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Hakadu Yesu utshiatueyi, Yudasa umu uku bayidi disandi yi babidi. Ukadu yi batu bandi bakadu bo bitu bindi bikutanda nabi tshitumba, ngobola, bi bongototo, bakadu babatuma kudi bayishi balema, bayishi ba biadi bo bakulu ba batu. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Yudasa, ukalembola Yesu ukadu mu baha tshishingu ne: “Unananuta, yi yeyi. Numukuata, nuyaka nandi bamulama malonga.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Hakafika Yudasa, ukashekeshi musangu umu kukadu Yesu ukamuambila ne: “Muyishi!” Kunyima ukamunuta. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Neku, banga bakolola makatshi bakamukuata bakamukanda mioshi. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Kadi umu uku bakadu hahu, ukashomona ngobola wandi ukakala muena mudimu wu Muyishi ulema ditshu. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesu ukabambila ne: “Nuhudu bo misedi, mitshi bu nualamata mutu mubodue? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><note caller="+" style="x"><char style="xo" closed="false">14:49. </char><char style="xt" closed="false"><ref loc="LUK 19:47">Lk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>.</char></note>Mitshila yosu nakadu mukakatshi muenu nayishi mu subu wu Tshiambi ne kanuadu bu kuakuata, kadi bituebi biosu bihudu bu kudiesheshi mifundu yi tshishila.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Neku, bayidi bosu bakamuletshiela, bakoshi lubilu.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Mutu muamulumi munga ukadu walamata Yesu, ukadu muluata malakanyi akubuka. Bakatshieba kumukuata, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Kadi ukashiyi mundala ukakala lubilu butaka.<verse eid="MRK 14:52" /></para>
  <para style="s1">Yesu udi kubushi ku basushi balema</para>
  <para style="r">(<ref loc="MAT 26:57-68">Matayi 26:57-68</ref>; <ref loc="LUK 22:54-55">Luka 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yone 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Batu bakakuata Yesu, bakayi nandi kudi bayishi balema kukaduebu badiasangishi, bayishi ba biadi bo bakulu ba batu. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Petelu ukadu walamata Yesu kule kule huaa yi mu luanda lu muyishi ulema, momuamu, ukashakama mukakatshi mu balami ba ku subu wu muyishi ulema, ukadu watota mudilu. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Ba nkolomu balema bundi buabu yi bakulu ba batu, bakadu batshieba mutu uku fila bushadiki ha dibuaka di Yesu bune bamona mukumushiha, kadi kabaheta mutu. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Neku batu bandi bakadu bafila bushadiki bu muambu bu Yesu, kadi, bakohakanangana bobo kayabu.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Batu banga bakabika kulu bakafila bushadiki bu muambu bakamba ne: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" /><note caller="+" style="x"><char style="xo" closed="false">14:58. </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yo 2:19</ref>.</char></note>“Tuamofu wambamba ne: ‘Nayashimbula subuewu udi muasa yi makatshi a batu, neku mu mitshila isatu nayakuasa subu munga utena kuakala kakadi muasa kudi batu.’ ” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Kadi, nashi mukatueyebu, kaba hetangana ku meyi. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />Kusula ku malu osu, bayishi balema bakabika kulu mukakatshi mu batu bakokoshi Yesu bakamba ne: “Kushi kuandamuna diyie? Wambamba bitshi bu malu osu akuabanda nawu batue?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Kadi Yesu ukedi holu kakudumuna diyi. Bayishi balema bakamokoshi kabidi ne: “Udi Kilisitue? Muana wu Tshiambi utuatshuamike?” <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" /><note caller="+" style="x"><char style="xo" closed="false">14:62. </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dany 7:13</ref>.</char></note>Yesu uka kudumuna ne: “Ee yi mimi,” “Neku nuyamona Muana wu Mutu mushakama ku dikatshi di babalumi di ngudu di Tshiambi nuya mumona kabidi uduadu mu diwulu mu kakatshi mu matutu!”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Hakofu Muyishi ulema meyi awu, ukadihanda mindela ukamba ne: “Katuena bo bualu bukuheta bushadiki bunga bu mutuewu! <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" /><note caller="+" style="x"><char style="xo" closed="false">14:64. </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lew 24:16</ref>.</char></note>Nuadiofuela kayenu muatukeyi Tshiambi. Nuamona bitshie?” Bundi buabu bakamubuakishi bakamba ne ufuaka.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Batu banga bakatula Yesu mata hambidi, banga baka mushibika mundala ha mesu, bakamukuma masoku bihuambebu. wamba! nganyi wakukuma “Balami baka mukuata, baka mukuma.”<verse eid="MRK 14:65" /></para>
  <para style="s1">Petelu wahidi Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">Matayi 26:69-75</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref>; <ref loc="JHN 18:15-18">Yone 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Hakadu Petelu mu bula bu muyishi ulema, kukadu umu uku bena mudimu muamu kashi ba muyishi ulema. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Hakamoneyi Petelu watota mudilu, uka mutshioboka ukamuambila ne: “Wewu biebi ukadu yi Yesu wu mu Nasaleta.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Kadi Petelu ukahidia ukamba ne: “Tshishi kofu tshiatshieba kuamba,” Kunyima ukatambuka mu luanda, ukayi ku tshibi.<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">Kabiena bifunda mu mikanda minga </char><char style="fq" closed="false">Amu hatshitshiethsiatshi tala Solu ukatenda</char></note><verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Kadi muena mudimu wu babakashi ukamumona kabidi ukabanga kuambila bakadu hahu. “Mutuewu udi umu wu kudiebu!” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Neku Petelu ukamufila kabidi, kunyima, bakadu hahu bakambila kabidi Petelu ne: “Momu udianu umu wu kudiebu bualu wewu biebi udi muena Ngalela.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Neku Petelu ukabangisha kufinga bo ukaditshiha. ukamba ne: “ Tshishilubuka mutuewu unu nambiambila!”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Amu hahu tala solu ukatenda tumu muibidi, neku Petelu ukafuluka tshikamuambila Yesu ne: “Kubushi ku solu katendela misangu ibidi, uyanabi tumu isatu ne kushilubuka.” Ukadu bo dibungama, neku ukadila.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">Yesu udi kubushi ku Pilatu</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matayi 27:1-2</ref>; <ref loc="MAT 11:14">11:14</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>; <ref loc="JHN 18:28-38">Yone 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Ha lukiaki, bayishi balema bakabueshi tshihangu bo bayishi ba biadi, bo bakulu ba batu, buena kuamba ne ba nkolomu bosu ba bena Yuda. Baka kanda Yesu mioshi, bakayi nandi, neku baka mufila kudi Pilatu. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilatu ukamokoshi ne: “Udi Shashendi wu bena Yude?” Yesu uka mukudumuna ne: “Amu muhuambamu.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Ba nkolomu ba bena Yuda bakadimbidila Yesu malu bo baka mufunda yi bitu bindi, <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Neku Pilatu uka mokoshi kabidi ne: “Kushi kudumuna diye? Ofu malu osu akuafundebu nawu!”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Neku Yesu kakudumuna diyi, kadi bikakemeshi Pilatu bikola.<verse eid="MRK 15:5" /></para>
  <para style="s1">Bashiha Yesu</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matayi 27:15-26</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yone 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Mu diyangi diosu di Pasaka, Pilatu ukadu bo tshilela tshikuletshiela muena buloku umu ukadu batu bosu balomba. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Neku, mu tshitshietshiatshi kukadu mutu mutomboka dina diandi Balaba ukadu mu buloku bo batomboki banga bualu ukashiha mutu bo bakatombokeyi nabu. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Batu bosu bakayi ku Pilatu, bakamulomba bu mukadu tshilele tshiabu bu kubesela bu mukadueyi uba sesela. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Pilatu ukabokoshi ne: “Nuananga ne nuletshiediela walelebu ne Shashendi wu bena Yude?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Neku Pilatu ukadu walubuka ne ba nkolomu ba bena Yuda baka mulembola Yesu anu bu tshihihi.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Kadi Bayishi balema bakasengeshi batu bune Pilatu ubaletshiela Balaba. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilatu ukambila kabidi batu ukabokoshi ne: “Nuananga nese kaye yi walelabu ne Shashendi wu bena Yude?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Bakamukudumuna yi kuela ndolu ne: “Mukuminayi misumadi ufuaka ha mutshi mukalanganyi!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Pilatu ukabokoshi kabidi ne: “Bubodu kayi buhueseyie?” Neku bobu bakasuminyina yi kuela ndolu ikola ne: “Muasayi misumadi ha mutshi mukalanganyi!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Pilatu ukadu watshieba kuyangishi batu, ukaletshiela Balaba, kunyima ukataboshi bune bakuma Yesu bo mioshi, bamufila bune bamuasa misumadi ku mutshi mukalanganyi.<verse eid="MRK 15:15" /></para>
  <para style="s1">Basalayi baseka Yesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Matayi 27:27-31</ref>; <ref loc="JHN 19:2-3">Yone 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Basalayi bakayi yi Yesu mukakatshi mu mukobu mu bula bu ngofena Pilatu neku bakela tshieyi wu basalayi bosu diyi. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Bakamuluatshishi mundala ususa, bakayongeyi tshifulu tshi mieba bakamuasa ku mutshu. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Kunyima, bakabanga kumuela moyo bakamba ne: “Moyawu Shashendi wu bena Yuda!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bakamukuakuma bo mutata mu mutshu, bakamutula mate hambidi, bakasa binu bo hala hashi kubushi kuandi. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Hakamanabu ku museka, bakamutambula mundala ususa, bakamuluatshisha mindala yandi. Bakatambuka nandi kushi bukuya muasa misumadi ku mutshi mukalanganyi.<verse eid="MRK 15:20" /></para>
  <para style="s1">Basasa Yesu misumadi ku mutshi mukalanganyi</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matayi 27:32-44</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>; <ref loc="JHN 19:7-27">Yone 19:7-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:21. </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:13">Lom 16:13</ref>.</char>
    </note>Mutu munga wu ku Kulene ukaduebu balela ne Simona tetandi wu Alesandelo yi Lufo, ukadu uduadu mu tshibidi ukadika muabawu baselayi bakamueseshi bua utshuala mutshi mukalanganyi wu Yesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Bakayi bo Yesu ku muaba ukaduebu balela ne Gologota kukudumuna ku muaku ne: “Muaba wu kabalubalu ka mutshu”. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Bakamuha malufu masangishi bo makayi, kadi yeyi ukahidi. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" /><note caller="+" style="x"><char style="xo" closed="false">15:24. </char><char style="xt" closed="false"><ref loc="PSA 22:18">Misam 22:18</ref>.</char></note>Bakamuasa misumadi, bakabanyangana mindala yandi, bakata mukala bukulubuka tshinakuangata mutu yi mutu. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Diba dikadu ha tshitema hakamuasebu misumadi mu makatshi bo ku makasa. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Ha dibayi dikaduebu bafunda dibuaka di lufu luandi, bakadu bafunda ne: “Shashendi wu bena Yuda”. <verse eid="MRK 15:26" /><verse number="27-28" style="v" sid="MRK 15:27-28" /><note caller="+" style="x"><char style="xo" closed="false">15:27-28. </char><char style="xt" closed="false"><ref loc="ISA 53:12">Yesh 53:12</ref>.</char></note>Bakamuasa misumadi bo batu banga babalumi babidi, munga ku dikatshi di babalumi, munga ku dikatshi di babakashi.<note caller="+" style="f"><char style="fr" closed="false">15:27-28 </char><char style="ft" closed="false">Mu mifundu minga badi bakumbashi Fesa wu 28. </char><char style="fqa" closed="false">Neku ka mukadieshi mufundu wambamba ne, “Baka mushiha bo batu babodu babidi” </char><char style="ft" closed="false">(Anyi Lk 22.37).</char></note></para>
  <para style="p" vid="MRK 15:27-28">Neku mifundu yi tshishila yadieshi yambamba ne: “Bakamusangishi yi batu bakakishi malu mabodu” <verse eid="MRK 15:27-28" /><verse number="29" style="v" sid="MRK 15:29" /><note caller="+" style="x"><char style="xo" closed="false">15:29. </char><char style="xt" closed="false"><ref loc="PSA 22:7">Misam 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mk 14:58</ref>; <ref loc="JHN 2:19">Yo 2:19</ref>.</char></note>Batu bakadu badika muabawu, bakadu bamuatuka bo kunyingishi mitshu, bakadu bambamba ne: “Washikamone! Wewu ukadu wambamba ne uya shimbula subu wu Tshiambi yi kumuasulula hanatamba mitshila isatu! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Dihandishi wewu kayebi, tuluka wewu kayebi ku mutshi mukalanganyi!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Bikadu kabidi mushindu umu kudi balongeshi balema bo bafundi ba biadi, bakaseka Yesu bakadu bambiambilangana kayabu ne: “Ukahandishi banga, kadi wahangu bu kudihandishi kayandi! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Kilisitu Shashendi wu bena Yuda utuluka hitshiowu ku mutshi mukalanganyi!” Bu tuetu tuataboshi, nashi batu babodu bakadueyi nabu ku mutshi mukalanganyi, bakadu biabu bamuaseka.<verse eid="MRK 15:32" /></para>
  <para style="s1">Lufu lu Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matayi 27:45-56</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yone 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Hakafika diba mukakatshi mu munyinyi, muediema ukadu ha buloba bosu, ukashala naku huaa yi ha diba isatu wu hakudiololu. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" /><note caller="+" style="x"><char style="xo" closed="false">15:34. </char><char style="xt" closed="false"><ref loc="PSA 22:1">Misam 22:1</ref>.</char></note>Hakadieshi diba isatu, Yesu ukela diyi dikola ukamba ne: “Eloyi, Eloyi, Lama sabakataniye?” “Eloyi, Eloyi, lama sabakataniya?” Biafofueshi ne: “Tshiambi wami Tshiambi wami, unaletshiediela kaye?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Batu banga bakadu hahu bakofu mukatueyeyi, bakamba.ne: “Ofuayi mualeleyi Eliyi diyi!” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" /><note caller="+" style="x"><char style="xo" closed="false">15:36. </char><char style="xt" closed="false"><ref loc="PSA 69:21">Misam 69:21</ref>.</char></note>Umu wu mukakatshi muabu ukayi manyangu, ukangata musukulampampa ukawubindika mu malufu a nganyi uka ukanda ku muteta, kunyima ukawutuma kudi Yesu bu unuaka ukamba ne: “Tukundiayi mbe Eliyi uduadu bu kudua mutulula!”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Kadi Yesu ukela diyi dikola, ukafu. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" /><note caller="+" style="x"><char style="xo" closed="false">15:38. </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Ek 26:31-33</ref>.</char></note>Mindala ikadu miela mu subu wu Tshiambi, ikahandika bihesa bibidi kubangishi kulu huaa yi hashi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Kamanda ka masalayi lukama hakamonaku mukafueyi kakamba ne:<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="fq" closed="false">Ukafu</char><char style="ft" closed="false">; Bidi bikumbashi mu mifundu minga </char><char style="fqa" closed="false">Ukela diyi neku uka kula moyi.</char></note> “ Mutuewu ukadu bulelela Muana wu Tshiambi!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:40. </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2-3">Lk 8:2-3</ref>.</char>
    </note>Kukadu babakashi banga hahu bakadu bamana tshitayi. Mukakatshi muabu, mukadu maliyi uku magadala bo Maliyi mamandi wu Yakobu songalumi, ibo wu Yose yi Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Bakadu balamata Yesu, bakadu bamuambuabuluishi hakadueyi mu Ngalela, kukadu kabidi babakashi banga bandi bakadu bayaya nandi mu Yelushalema.<verse eid="MRK 15:41" /></para>
  <para style="s1">Bashika Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matayi 27:57-61</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yone 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Tshitshietshi tshi hakudiololu, (ne bumukaduewu mutshila wabu wukudiyongeyi) <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yosefu uku alimatayu ukadu mutu wu tshibambalu tshikulu ukaduebu batshina. Ukadu mukundi yeyi biandi bu kudu ku bushashendi bu Tshiambi. Ukayi bo ngudu yosu kudi Pilatu bukuyalomba mubidi wu Yesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pilatu ukakema bikola hakofueyi ne Yesu ufufu anu hitshiowu. Neku, ukela kamanda ka masalayi diyi, ukamokoshi ne Yesu ufufu bilendi. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Hakofueyi diyi di kokuakoku kudi kamanda ka masalayi, ukambila Yosefu uku alimatayu bune wangata mubidi wu Yesu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yosefu ukola lubandu lu mundala ukubuka, ukatulula mubidi wu Yesu ku mutshi mukalanganyi, ukamushibika mundala ukamuela mu ngita ukadueyi muyongeyi mu mabu ukabungulukishi dibu dilema ukaditeka ku mushiku wu mbelu wu ngita. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Maliyi uku Magadala bo Maliyi mamandi wu Yose bakadu bamona muaba ukaduebu bateka mubidi wu Yesu.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">Kubika ku Yesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Matayi 28:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yone 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Hakatamba mutshila wu sabatu, Maliyi uku Magadala bo Maliyi mamandi wu Yakobu yi Salome bakaya kola manyi a nsunga ilengela a nganga ukola bu kuya kuela Yesu hambidi. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Dialumingu habutshi, kubushi ku diba kutambuka, bakayi ku ngita. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Bakaduebu bayayi mu shila bakokoshangana. “Nganyi uya tubunguluishila dibu didi diteka ha mushiku wu ngite?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Kadi hakabishebu hala, bakamona dibu dite dibungulukishi ku mbambadi dikadu dilema. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Neku bakabuela munda mu ngita; muamu, bakamona songalumi muhona ku dikatshi di babalumi muluata mundela ukubuka, bowu bukabakuata.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Neku songalumi ukabambila ne: “Kanofu bowu!” nuatshieba Yesu wu mu nasaleta ukasebu misumadi; kena haha, wabika ku bashandi. Wabika monayi muaba ukaduebu bamuladikishi. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" /><note caller="+" style="x"><char style="xo" closed="false">16:7. </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat 26:32</ref>; <ref loc="MRK 14:28">Mk 14:28</ref>.</char></note>Yakayi nuambile balongi bandi bo Petelu ne: ‘Umanayi kubushi kuenu mu Ngalela; kuaku, kakunuya mumona bu muka nuambileyi.’”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Neku, bakatambuka manyangu ku ngita bakakala lubilu, bualu bakadu batshina yi kudita, kabambila mutu bualu, bualu bakadu bo bowu.<note caller="+" style="f"><char style="fr" closed="false">16:9-20 Bualu bu ku mutshu</char><char style="ft" closed="false">Mifundu minga bo mikanda minga mihindula yi bilendi kayena bo musahuewu(Fesa 9-20).</char></note><verse eid="MRK 16:8" /></para>
  <para style="s1">Yesu wamuenekela Maliyi uku Magadala</para>
  <para style="r">(<ref loc="MAT 28:9-10">Matayi 28:9-10</ref>; <ref loc="JHN 20:11-18">Yone 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Hakabika Yesu ku bashandi mutshila wu lumingu, ukamueneka kubushi kudi Maliyi uku Magadala ukatambuleyi nyinga mibodu muanda mutekete munda. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Yeyi, ukaya kuambila bayidi bandi bo batu bakadueyi nabu, bakadu babila kudila. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Hakofuebu mukanu mu Maliyi uku magadala ne Yesu udi bo moyi yeyi ukamumona, bakahidi kumuataboshi.<verse eid="MRK 16:11" /></para>
  <para style="s1">Yesu wamuenyekela bayidi bandi babidi</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luka 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Kunyima Yesu ukamuenyeka mumushindu munga kudi bayidi bakadu mu shila bayayi mu tshibidi. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Bakadu bahinga, bukuduakuambila bayidi banga bakadu bashala musahu, kadi bobu kababatabushi bi.<verse eid="MRK 16:13" /></para>
  <para style="s1">Yesu udiabebeshi kudi bayidi bandi disandi yi umu</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matayi 28:16-20</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="JHN 20:19-23">Yone 20:19-23</ref>; <ref loc="ACT 1:6-8">Biesedi 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Hakahu malu bundi buawu, Yesu ukamuenekela bayidi bandi disandi yi umu hakaduebu badiadi. Ukababolokela bikola bu kuhangu kuabu ku kuatabushi meyi a bakamona mukabikeyi ku bashandi. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" /><note caller="+" style="x"><char style="xo" closed="false">16:15. </char><char style="xt" closed="false"><ref loc="ACT 1:8">Bies 1:8</ref>.</char></note>Kunyima ukabambila ne: “Yakayi mu mangandu bundi buawu, nuyishi Musahu Ulengela kudi batu bundi buabu. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Una kuataboshi Musahu Ulengela uya batishibu, neku uya sungidibu, kadi unabi kuataboshi, uyabuaka. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Monayi banakuataboshi bihingu bi hakayabi binakuesebu: Bayakuahata nyinga mibodu mu dina diami, bayatueyi miakulu mihiamihi; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Bayakuata nyoka bo makatshi, bayanu nyonga yi bululu yi lufu, kadi kayina besela bualu bubodu.”<verse eid="MRK 16:18" /></para>
  <para style="s1">Yesu wabanda mu diwulu</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luka 24:50-53</ref>; <ref loc="ACT 1:9-11">Biesedi 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:19. </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">Bies 1:9-11</ref>.</char>
    </note>Hakamana Yesu kubambila maluawu, baka mubishi mu diwulu neku ukashakama ku dikatshi di babalumi di Tshiambi. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Neku anu hahu, bayidi bakayi bukuya kuamba Musahu Ulengela mu mangandu bundi buawu. Shashendi ukadu ubaseseshi mudimu, buku shadika ne Musahu wandi mu bihungu bina kuesebu.<note caller="+" style="f"><char style="fr" closed="false">16:9-10 Bualu bu ku mutshu </char><char style="ft" closed="false">Mikanda minga mihindula yi bilendi kayena bo musahuewu (Fesa 9-20).</char></note><verse eid="MRK 16:20" /></para>
  <para style="r">(<ref loc="MRK 16:9-10">16:9-10</ref>)</para>
  <para style="p" />
  <chapter eid="MRK 16" />
</usx>