  <book code="MAT" style="id">EN_CLT cua_Tiếng⋅Co_ltr Thu Feb 13 2025 16:49:28 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Hêêl Kaxay Ma-thi-ơ</para>
  <para style="toc2">Ma-thi-ơ</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-thi-ơ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Rahlăp adrơơk ku Lôôk Wơơt Dêh Jê-xu, koot xau Đa-vik, koot xau Ap-ra-ham: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Ap-ra-ham pahleh I-sak, I-sak pahleh Ja-kôp, Ja-kôp pahleh Ju-đa ji oh ay ku kơy, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Ju-đa xok Ta-ma pahleh Phê-rêt ji Sê-rach, Phê-rêt pahleh Hêt-rôn, Hêt-rôn pahleh A-ram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />A-ram pahleh A-mi-na-đap, A-mi-na-đap pahleh Na-ach-son, Na-ach-son pahleh Sanh-môn, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Sanh-môn xok Ra-hap pahleh Bô-ô, Bô-ô xok Ru-tơ pahleh Ô-bêt, Ô-bêt pahleh Je-sê, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Je-sê pahleh vuua Đa-vik, Đa-vik xok kadrê ku U-ri pahleh Sa-lô-môn,<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-lô-môn pahleh Rô-bô-am, Rô-bô-am pahleh A-bi-ja, A-bi-ja pahleh A-sa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa pahleh Jô-sa-phat, Jô-sa-phat pahleh Jô-ram, Jô-ram pahleh Ô-xia. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ô-xia pahleh Jô-tam, Jô-tam pahleh A-cha, A-cha pahleh Ê-xê-chia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ê-xê-chia pahleh Ma-na-se, Ma-na-se pahleh A-môn, A-môn pahleh Jô-si-a, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Jô-si-a pahleh Jê-kô-nia ji oh ay ku Kơy muut katuôôy biq rôp dơơp xapok hlê Ba-bi-lôn,<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />ji atêq katuôôy biq rôp dơơp xapok hlê Ba-bi-lôn, Jê-kô-nia pahleh Sa-la-thi-ên, Sa-la-thi-ên pahleh Xô-rô-ba-bên, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Xô-rô-ba-bên pahleh A-bi-ut, A-bi-ut pahleh Ê-li-a-kim, Ê-li-a-kim pahleh A-xô, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-xô pahleh Sa-đôk, Sa-đôk pahleh A-chim, A-chim pahleh Ê-li-ut, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-ut pahleh Ê-lê-a-xa, Ê-lê-a-xa pahleh Ma-than, Ma-than pahleh Ja-kôp, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Ja-kôp pahleh Jô-sep, kanau ku Ma-ri, đơu gamưh mo, Lôôk Jê-xu, Kơy jah taayh laa Lôôk Wơơt Dêh, jah pa iir vlôh. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Đanưq, dêq hloay kaluh adrơơk xing Ap-ra-ham truh Đa-vik laa kưl poot đơơy adrơơk, xing Đa-vik truh katuôôy rôp dơơp xapok hlê Ba-bi-lôn laa kưl poot đơơy adrơơk, ji xing katuôôy rôp dơơp xapok hlê Ba-bi-lôn truh Lôôk Wơơt Dêh laa kưl poot đơơy adrơơk.<verse eid="MAT 1:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Varơuq pôôt dêh ku Lôôk Wơơt Dêh Jê-xu laa luneq: Tuôôy Ma-ri, miq Kadraq, heq jah taboot apok xarooy dii Jô-sep, bơh adroyq tuôôy baarq xa măn dii mamuuyq, mư biq jah xet e bonq xing aduq Kơy Phool Hiel. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Măn Jô-sep, kanau mư, laa manih hyioh jăk, ji vii leh ưng taboon xơuq mư, nhu đinq kadook ji ka'lăk mư. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Bơh tuôôy nhu đong biit truh kaluh varơuq nưq, yôôych dayh 'yo hơq, yaak plêêk ku Lôôk rama vlôh kung nhu đom vik apau, đnooy: “Jô-sep, koot xau Đa-vik, nhu te kamưưl xok Ma-ri dơơp kadrê, vii oh de jah e đom mư nưq laa xing aduq Kơy Phool Hiel. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Mư nưq hnoq pa iir muuyq koot kanau, ji nhu hnoq xôq anơng ka koot laa Jê-xu, vii koot nưq hnoq wơơt tamooy haay vlôh klơlh kadrôôp maroh oot.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Tôôy varơuq neq xalih vlôh xôq jah jêêk varơuq heq jah Lôôk xanoh gamưh kơy hlit, đaneq:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“Dayh 'yo hơq, khơl drê tadăp hnoq măn bonq ji pa iir muuyq koot kanau, ji khơl drơy hnoq taayh yal Kadraq laa Em-ma-nu-ên” — iq laa “Kơy Plêêk măn kung haay.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yôôch atêq tuôôy jah nhơk kah klơlh tuôôy vik, Jô-sep heq dơơp dang đaji yaak plêêk ku Lôôk heq xanoh dăt ji xok mư nưq dơơp kadrê nhu. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Bơh nhu leh xa măn dii mư nưq dong truh tuôôy mư pa iir muuyq koot kanau. Yôôch nhu taayh anơng koot nưq laa Jê-xu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Atêq tuôôy Lôôk Jê-xu heq jah pa iir vlôh aduq Bêt-lê-hem dêh Ju-đê đom đơơy vuua Hê-rôt yôôych dayh 'yo hơq, khơl hnhư thơy jarơơu xing pi hngơy vlok truh aduq Jê-ru-sa-lem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />vôôch đaneq: “Kơy heq jah pa iir vlôh laa Vuua manih Jo Thaiq măn 'leq? Vii 'wot heq hloq xalok ku Kadraq aduq pi hngơy vlok ji truh xôq akuh ayuôôt Kadraq.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Bơh atêq tuôôy tameng varơuq nưq, vuua Hê-rôt biq xôôl dôôl, ji dêq hloay theng Jê-ru-sa-lem kung đaji kơy. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Yôôch atêq tuôôy patăk anguk dêq hloay khơl thơy tơơk tưp kôt ji khơl thơy pato ganuun đom manih karôp, kơy vôôch 'yo oot: “Wơơt Lôôk jah pa iir vlôh aduq 'leq?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Oot tơơl dii vuua: “Aduq Bêt-lê-hem dêh Ju-đê, vii heq jah valơk đanưq gamưh khơl hnhư hlit,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Măn Bêt-lê-hem, vari Ju-đa,</para>
  <para style="q1" vid="MAT 2:6">xăk be aalq laa de dik đom khơl dưk xanok ku Ju-đa,</para>
  <para style="q1" vid="MAT 2:6">vii xing xăk hnoq vlôh muuyq Kơy dưk xanok</para>
  <para style="q1" vid="MAT 2:6">laa Kơy hnoq xakaq jarooy I-sơ-ra-ên, tamooy gô.’”<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Tuôôy nưq, atêq tuôôy padu kadook taayh khơl hnhư thơy jarơơu truh, Hê-rôt vôôch 'yo oot kawat rama vlôh ku xalok. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Tuôôy heq xôq oot hooy truh Bêt-lê-hem, kơy patăk: “Atêq tuôôy hooy, êêp kơy dayh vôôch 'yo dong hlolh truh oh de, yôôch tuôôy êêp kơy heq axek hloq, dayh đnooy ka gô xôq gô kung truh vanê ayuôôt Kadraq.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Atêq tuôôy heq tameng vuua, oot dưk hooy, ji dayh 'yo hơq, xalok đơu oot heq 'yo hloq pi hngơy vlok hooy adroyq oot dong truh tuôôy heq truh yôôych ni dưk hnhep ataalh aduq oh de măn. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Tuôôy heq 'yo hloq xalok, oot thier raa hlah hlaak đom xuum hlah paq ik. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Atêq tuôôy muut đom hnhư, oot hloq oh de kung Ma-ri, miq Kadraq. Yôôch tuôôy heq kul pôôt yôôych oot kuh ayuôôt Kadraq, ji tuôôy heq tơq kuah tưp ku oot vlôh, oot tơơk tưp ka Kadraq kaluh kuah lêh: vajang, jarơơu ji ka hlơu. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ji vii heq jah đnooy adroyq te wiit xuq hlê dii Hê-rôt đom muuyq vik apau, oot xuq daak oot bơơn trôôk kadrơy.<verse eid="MAT 2:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Tuôôy oot heq hooy yôôch, yôôych dayh 'yo hơq, muuyq yaak plêêk ku Lôôk rama vlôh dii Jô-sep đom muuyq vik apau, xanoh đaneq: “Atêq tuôôy kadrăch kah, dayh xagook oh de kung miq Kadraq ji vlôh du dêh Ai Kâp, yôôch dayh măn hlê đnư dong truh tuôôy leq gô dăt ay, vii Hê-rôt đinq axek oh de xôq păk kaxêêt.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yôôch atêq tuôôy kadrăch kah, kơy xagook oh de kung miq Kadraq vlôh du Ai Kâp đom ka klôôy, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ji kơy măn hlê đnư dong truh tuôôy Hê-rôt kaxêêt, nưq laa xôq jah jêêk varơuq heq jah xanoh xing Lôôk gamưh kơy hlit, đaneq: “Gô hnoq taayh koot Gô vlôh klơlh Ai Kâp.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Tuôôy nưq, Tuôôy hloq đaneq ni heq biq khơl hnhư thơy jarơơu 'yo leh ra kajoq, Hê-rôt thier tôq jaraq, atêq tuôôy pahêêr dăt hooy, kơy păk kaxêêt dêq hloay khơl oh kanau xing vaarq xanưm hooy apôôt aduq Bêt-lê-hem ji đom dêq hloay ku dêh nưq, tyauq đaji kawat đơu kơy nưq vôôch 'yo xing khơl hnhư thơy jarơơu. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Đanưq laa jah jêêk varơuq heq jah xanoh gamưh hnhư hlit Jê-rê-mi, đaneq:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Muuyq apok alo jah tameng tek đom theng Ra-ma,</para>
  <para style="q1" vid="MAT 2:18">xarooy nhim ook ji taayh alo dik miik,</para>
  <para style="q1" vid="MAT 2:18">Ra-chên nhim ka khơl koot ni,</para>
  <para style="q1" vid="MAT 2:18">ji mư leh chiuq jah hlơq hlôôp, vii oot leh măn đnoyq.”<verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Tuôôy nưq, tuôôy Hê-rôt heq kaxêêt, yôôych dayh 'yo hơq, muuyq yaak plêêk ku Lôôk rama vlôh dii Jô-sep đom muuyq vik apau aduq Ai Kâp, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />dăt đaneq: “Tuôôy heq kadrăch kah, ay dayh xagook oh de ji miq Kadraq yôôch hooy truh vari I-sơ-ra-ên, vii khơl adro axek păk kaxêêt xăk riirh ku oh de heq kaxêêt.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Yôôch tuôôy heq kadrăch kah, kơy xagook tyauq kơy oh de kung miq Kadraq, ji muut đom vari I-sơ-ra-ên. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Lunư, atêq tuôôy tameng đaneq A-chê-la-u đong dưk xanok dêh Ju-đê thay ka Hê-rôt, vaq kơy, kơy yôq hooy truh đnư. Bơh tuôôy heq jah đnooy adroyq đom vik apau, kơy wiit xuq dêh Ga-li-lê, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />ji tuôôy heq truh đnư yôôch, kơy măn hlê đom muuyq theng jah taayh laa Na-xa-ret, xôq jah jêêk varơuq heq jah xanoh gamưh khơl hnhư hlit, đaneq Kadraq hnoq jah taayh laa manih Na-xa-ret.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Đom kaluh hngơy nưq, Jăng Bap-tit truh pato dayq đom wăngq we dêh Ju-đê, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />đaneq: “Dayh wiit xuum, vii daak dêh daak plêêk heq jeq.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Vii neq laa adro heq jah đnooy truh bơyh hlit Ê-sai, đaneq:</para>
  <para style="q1" vid="MAT 3:3">“E xarooy manih taayh kôt đom wăngq we:</para>
  <para style="q1" vid="MAT 3:3">‘Dayh deep 'miêh trôôk ku Lôôk,</para>
  <para style="q1" vid="MAT 3:3">dayh dơơp manay hyioh tôôy trôôk Kadraq.’”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Jăng neq hlưp aau xing hlôôk lak đa, hnek vek katêêk bơơn kađuh rawiit katêêk, măn tuôông xa ku kơy laa lêêp ji daak hlut gôk. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Yôôch tamooy theng Jê-ru-sa-lem, dêq dêh Ju-đê ji dêq hloay dih dêh rawiit gah tavook daak Jô-đanh truh dii kơy, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />ji tuôôy đong xưng kadrôôp oot, oot jah kơy dơơp bap-tem đom tavook daak Jô-đanh. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Atêq tuôôy 'yo hloq 'ngưng manih Pha-ri-si ji Sa-đu-sê truh vii pheep bap-tem ku kơy, kơy đnooy dii oot: “Bing koot xau ku voolh đôk hơq! Kơyq heq đnooy adroyq ka êêp klôônq xadăk klơlh đơơt tôq dayh jeq truh? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Lunưq, dayh raak play taxưngq dii xuum wiit xuum. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Ji êêp kơy kung te biit đơu dăt mamuuyq: ‘Haay e mo kơy Ap-ra-ham.’ Vii gô đnooy dii êêp kơy đaneq Kơy Plêêk hnoq ik panưk tok koot xau ka Ap-ra-ham xing kaluh kuk phơu neq. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Bơh xuôôk heq jah xôq angôôk rayah ưk yôôch. Lunưq, dêq hloay kaluh ưk atoh leh vlôh play kaxay yôôych biq kơl pôôt ji qweek muut ôôlh. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Gô dơơp bap-tem truh varơuq wiit xuum ka oh ay bơơn daak. Bơh Kơy truh atêq gô e taay yaak galơh iaq gô, truh Kơy nưq yôôych gô laa adro leh taxưngq xôq ta'nhaak kaxôôp ku Kadraq. Kadraq hnoq dơơp bap-tem ka oh ay bơơn Kơy Phool Hiel ji bơơn ôôlh; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />kapưk ku Kadraq măn đom ti kadraq, yôôch Kadraq hnoq ôôp xarêh chaal pôh va Kadraq ji anguk va ku Kadraq muut pơ. Bơh Kadraq hnoq vuh jaq juch hre bơơn ôôlh be dong leq apoch ik.”<verse eid="MAT 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Tuôôy nưq, Lôôk Jê-xu hooy xing dêh Ga-li-lê truh daak Jô-đanh, aduq ku Jăng, xôq jah kơy dơơp bap-tem rơy. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Bơh Jăng akhiim axek trôôk klơl Kadraq, đaneq: “Gô đơơu e duh jah Kadraq dơơp bap-tem, anưq đơu Kadraq laay truh dii gô ih?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Bơh tuôôy tơơl hlê, Lôôk Jê-xu đnooy dii kơy: “Juneq, dayh dơơp anưq yơu, vii đanưq laa tamuut đôôyq dii haay xôq dơơp xaleep tôôy varơuq hyioh jăk.” Yôôch Kadraq xôq kơy dơơp. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Tuôôy nưq, atêq tuôôy chiuq bap-tem yôôch, Lôôk Jê-xu vơ hloay tok klơlh daak, ji 'yo hơq, kaluh taalh plêêk jah luh vlôh ka Kadraq, yôôch Kadraq 'yo hloq Kơy Phool Hiel ku Kơy Plêêk kahri pôôt dang đaji xêêp ka trơu, găp tol Kadraq, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />ji 'yo hơq, muuyq apok xanoh xing kaluh taalh plêêk đaneq: “Neq laa Koot xung xiaq ku Gô. Gô thier hlah xuum aduq Koot nưq.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Yôôch Lôôk Jê-xu jah jarooy muut wăngq we bơyh Kơy Phool Hiel xôq chiuq kamuuych adô aluut. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Atêq nưq, tuôôy heq deek xa poot kưl hngơy ji poot kưl mưng, yôôych Kadraq pangoot. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Atêq tuôôy truh jeq, adro adô aluut đnooy dii Kadraq: “Atoh kơy laa Koot Kơy Plêêk, dayh đnooy dăt xôq kaluh kuk phơu neq vlôh jêêk tôôp yơu.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Bơh tơơl hlê, Kadraq đnooy: “E apok jah valơk: ‘Koot manih hnoq riirh be aalq gamưh tôôp hloh heq, bơh laa gamưh tôôy apok đnooy vlôh xing huuy Kơy Plêêk.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Yôôch kamuuych taway Kadraq muut đom theng vah, ăm Kadraq dưk măn tol aduq yơơt dik ku hnhư hơu, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />ji đnooy dii Kadraq: “Atoh kơy laa Koot Kơy Plêêk, dayh katruyh xăk pôôt yơu, vii e apok jah valơk, đaneq: ‘Kadraq hnoq patăk dăt truh koot ka khơl yaak plêêk Kadraq,’ ji: ‘Oot hnoq tơơk koot ganưq tol ti oot, e kheoq jôôk koot hnoq ik xatôôlh muut kuk phơu.’”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Lôôk Jê-xu tơơl hlê ni: “Mot kadrơy, e apok jah valơk: ‘Koot hnoq be thưh Lôôk, laa Kơy Plêêk ku koot.’” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Muuyq yưk tra, kamuuych taway Kadraq tok muuyq ngok đoot thier yơơt ji ăm Kadraq 'yo dêq hloay kaluh daak tol dêh araak kung varơuq karoh e ku oot. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Ji ni đnooy dii Kadraq: “Gô hnoq ăm kơy dêq hloay kaluh ưng neq, atoh kơy kuh ayuôôt gô, bơơn varơuq kul xăk pôôt.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Tuôôy nưq, Lôôk Jê-xu xanoh dii ni: “Sa-tan, dayh chuh xing neen! Vii e apok jah valơk: ‘Koot hnoq ayuôôt laat Lôôk, laa Kơy Plêêk ku koot, ji koot hnoq hơu varơuq vơ muuyq dro Kadraq.’” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Yôôch kamuuych chuh klơlh Kadraq, ji 'yo hơq, khơl yaak plêêk truh ji xarôp hơu varơuq Kadraq.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Tuôôy nưq, atêq tuôôy tameng đaneq Jăng heq biq rôp, Kadraq wiit xuq dêh Ga-li-lê. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Tuôôy heq hooy klơlh Na-xa-ret, Kadraq truh riirh aduq theng Ka-bê-na-um gah tahli, đom vari dêh Sa-bu-lôn ji Nep-ta-li, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />xôq jah jêêk varơuq heq jah xanoh gamưh hnhư hlit Ê-sai, đaneq:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Vari Sa-bu-lôn ji vari Nep-ta-li,</para>
  <para style="q1" vid="MAT 4:15">trôôk hooy vlôh kơn ngưưr tahli, pi hơq tavook daak Jô-đanh,</para>
  <para style="q1" vid="MAT 4:15">nưq laa dêh Ga-li-lê ku kaluh tamooy daak kadrơy —<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />tamooy 'ngôôy đom kamơng jaluk heq 'yo hloq xaraar tađnah kôt,</para>
  <para style="q1" vid="MAT 4:16">ji dii khơl adro 'ngôôy đom dêh vari ji long lơuq varơuq kaxêêt,</para>
  <para style="q1" vid="MAT 4:16">yôôych xaraar tađnah heq ahnhe tol oot.”<verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Xing tuôôy nưq, Lôôk Jê-xu xarôp padoh pato ji xanoh: “Dayh wiit xuum, vii daak dêh daak plêêk heq truh jeq.” <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Tuôôy nưq, tuôôy đong hooy jôôk gah tahli Ga-li-lê, Kadraq 'yo hloq vaarq dro oh ay, Si-môn, jah taayh laa Phi-e-rơ, ji Anh-rê, ma oh kơy nưq, đong qwel lưyq pôôt tahli vii oot laa manih hmơt rôp kaa. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Ji Kadraq dăt oot: “Dayh hooy tyauq thơy, yôôych thơy hnoq khienq oh ay jêêk khơl ti hmơt lưyq manih.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Vơ hloay, tuôôy heq ka'lăk lưyq oot, oot tyauq Kadraq. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Atêq tuôôy xing nưq hooy đnoyq, Kadraq hloq vaarq dro oh ay kadrơy, laa Ja-kơ koot ku Xê-bê-đê, ji Jăng, ma oh kơy, đom ge kung dii Xê-bê-đê, vaq ku oot, đong kaval lưyq oot ji Kadraq tawooyh taayh oot, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />yôôch vơ hloay, tuôôy heq hooy klơlh ge ji Vaq oot, oot tyauq Kadraq.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Ji Kadraq hooy kađneng kahơ loch dêq dêh Ga-li-lê, pato dayq đom kaluh hnhư tagumq ku tamooy dêh, padoh pato Hêêl Kaxay truh daak Plêêk, kung payơh tôôy bingq tâk ji tôôy jiq jiêh đom manih karôp. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Hêêl đnooy truh Kadraq ahna vlôh dong truh loch dêq dêh Si-ri, ji khơl drơy jarooy truh ka Kadraq tôôy adro e bingq, biq tavơh 'ngưng kaluh bingq ji jiq 'nhok đêh mamuuyq, biq kamuuych nhôp, biq be drơy, taqwauq talêêt, ji Kadraq payơh dêq ka oot. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Kaluh bing manih karôp hooy tyauq Kadraq xing Ga-li-lê, Đê-ka-bô-lơ, Jê-ru-sa-lem, Ju-đê ji pi hơq tavook daak Jô-đanh.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Tuôôy nưq, atêq tuôôy hloq bing manih, Kadraq hooy tok tol đoot, ji tuôôy Kadraq heq 'ngôôy pôôt, khơl xatyauq Kadraq truh kung Kadraq. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Kadraq hah huuy pato dayq oot, đaneq:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Vanong ka khơl adro adrah pơơl đom danưng kooy, vii daak dêh daak plêêk laa ku oot.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Vanong ka khơl adro nhim alo, vii oot hnoq jah hlơq hlôôp.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Vanong ka khơl adro xuum hwêêt, vii oot hnoq nhonq jah vari.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Vanong ka khơl adro pangoot ji thaal varơuq hyioh jăk, vii oot hnoq jah phiq phơh.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Vanong ka khơl adro xet biit angơuq, vii oot hnoq jah biit angơuq.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Vanong ka khơl adro pa xarêh đom xuum klaak, vii oot hnoq 'yo hloq Kơy Plêêk.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Vanong ka khơl adro dơơp tagu hlê, vii oot hnoq jah taayh laa khơl koot ku Kơy Plêêk.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Vanong ka khơl adro biq rôp toop vii kơq varơuq hyioh jăk, vii daak dêh daak plêêk laa ku oot.<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />Oh ay e vanong tuôôy khơl drơy đnooy ra ơơh oh ay, kung rôp toop ji đnooy tôôy varơuq xơk đnooy pahnhiq tachơơl kung oh ay vii kơq thơy.<verse eid="MAT 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 5:12" />Dayh hlah hlaak ji mưng me, vii phon kadrool ku oh ay thier kôt tol daak plêêk, vii khơl drơy heq rôp toop Khơl hnhư hlit adroyq oh ay dang đanưq.<verse eid="MAT 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Oh ay laa voh ku vari. Bơh atoh voh biq hlơơp nhưưm, yôôych ni hnoq ik dơơp ăm phaak hlê bơơn kajoq? Đêh vlôh biq qweek vlôh pi gôk xôq biq joaq jalon bơyh khơl drơy, yôôych ni be e ik ka varơuq kajoq đnoyq. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Oh ay laa xaraar tađnah ku dêh araak. Muuyq theng kôt măn tol ngok đoot yôôych be ik biq kađoq hlơơp ik. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Kung leh ekơyq ataak đeen ji xôq ni pi 'laarq para, bơh laa xôq tol jôôk đeen, ji ni ahnhe tađnah ka tôôy dro đom hnhư. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Dang anưq, xaraar tađnah ku oh ay dayh ahnhe vlôh kangưưr khơl drơy, dơơp aleq ka oot hnoq ik hloq kaluh varơuq kaxay ku oh ay ji ayuôôt laat Vaq ku oh ay tol daak plêêk.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Te biit đaneq thơy heq truh xôq pahyaak ka'lăk ganuun long kaluh apok hlit. Thơy heq truh leh aalq xôq pahyaak ka'lăk, bơh laa xôq dơơp ăm xaleep. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Vii dong dik, thơy đnooy dii oh ay, dong truh tuôôy plêêk ji vari dalơh hooy, yôôych muuyq dơuq long muuyq valơk đom ganuun kajưk dik leh dalơh hooy dong truh tuôôy leq tôôy varơuq jah xaleep. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Vii anưq, long kơyq pahlơơp ka'lăk muuyq đom kaluh varơuq de dik ku kaluh ganeen neq ji pato khơl drơy đanưq yôôych hnoq biq taayh laa de dik đom daak dêh daak plêêk. Bơh adro leq dưk dơơp tyauq ji pato dayq ganeen, dro nưq hnoq jah taayh laa kôt đom daak dêh daak plêêk. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Vii thơy đnooy dii oh ay đaneq atoh varơuq hyioh jăk ku oh ay leh galơh iaq varơuq hyioh jăk ku khơl thơy pato ganuun ji manih Pha-ri-si, yôôych oh ay kajưk dik hnoq leh muut đom daak dêh daak plêêk.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Oh ay heq tameng luneq, varơuq heq jah pato ka manih hnu: ‘Leh ik păk kaxêêt manih,’ đơu ‘Adro leq păk kaxêêt manih yôôych hnoq pheq chiuq varơuq xưh xadrah.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Bơh thơy đnooy dii oh ay đaneq tôôy adro tôq jaraq dii oh ay haay hnoq chiuq varơuq xưh xadrah. Đơu adro leq taayh oh ay haay: ‘Kađô vlô!’ yôôych hnoq chiuq manih karôp xưh xadrah. Măn adro leq toah: ‘Kađô vlô apoop!’ yôôych hnoq chiuq xadrah dook aduq laluk ôôlh. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Kơq nưq, atoh oh ay đong tơơk tưp kuah lêh oh ay aduq para hơu yôôch aduq nưq, oh ay văch hlê đaneq muuyq dro oh ay ku oh ay e varơuq kajoq nưq tachơơl dii oh ay, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />yôôych dayh xôq hlê kuah lêh oh ay măn kangưưr para hơu ji chuh hooy; droyq dik dayh dơơp tagu dii adro ay oh ku oh ay nưq, ji yôôch, atêq tuôôy hooy, dayh tơơk tưp kuah lêh oh ay. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Dayh ralauq athêêk hlah xuum dii adro rôp xadrah oh ay kach dayh dayh long tuôôy leq oh ay đong măn tol trôôk kung dii adro nưq, leh kheoq adro rôp xadrah hnoq atăq oh ay ka padrok xưh xadrah, ji padrok xưh xadrah atăq ka thơy đôôyq, yôôch oh ay hnoq biq rôp muut karuk. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Dong dik, thơy đnooy dii oh ay, oh ay kajưk dik hnoq leh vlôh klơlh đnư dong truh tuôôy leq oh ay hnoq ik bla baak jêêt lôôch dik.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Oh ay heq tameng luneq, apok heq jah pato: ‘Leh ik lôp kadrôôp tuut taak.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Bơh thơy đnooy dii oh ay đaneq paq kê kơyq 'yo muuyq khơl drê dii e iq hmưch trôôch mư nưq, yôôych adro nưq heq lôp kadrôôp tuut taak dii mư nưq đom xuum oh ay yôôch. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Mot kadrơy, atoh klong mot pi akoh ku oh ay khienq oh ay lôp kadrôôp, dayh galek ni vlôh ji qweek xangưưy xing oh ay. Vii lunưq laa tolh iaq ka oh ay tuôôy muuyq phon đom kaluh xăk xamơk ku oh ay biq hư, đơu dêq hloay xăk xamơk oh ay leh huq biq qweek muut laluk ôôlh. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ji atoh ti akoh ku oh ay khienq oh ay lôp kadrôôp, dayh dool ni ji qweek xangưưy klơlh oh ay. Vii lunưq laa tolh iaq ka oh ay tuôôy muuyq phon đom kaluh xăk xamơk ku oh ay biq hư, đơu dêq hloay xăk xamơk oh ay leh hooy muut laluk ôôlh. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Măn apok heq jah pato: ‘Dro leq ka'lăk kadrê ni, yôôych dro nưq dayh ăm ka mư muuyq hla jơyq ka'lăk kadrê.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Bơh thơy đnooy dii oh ay đaneq paq kê kơyq ka'lăk kadrê ni, đơu leh e rôp xadrah truh kadrôôp apuq atrăp, yôôych dơơp ka mư chiuq kadrôôp tuut taak. Ji long kơyq pajêêk adro hmưq biq ka'lăk yôôych lôp kadrôôp tuut taak.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Oh ay laay heq tameng luneq, apok heq jah pato ka manih hnu: ‘Leh ik paleek pa ôôh, bơh dayh dưk dơơp apok paleek ku haay dii Lôôk.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Bơh thơy đnooy ka oh ay te paleek kajoq dêq, kung te pahnho plêêk đơu paleek, vii nưq laa ngaai ku Kơy Plêêk; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />kung te pahnho vari đơu paleek, vii nưq laa aduq xôq jôôk ku Kadraq; kung te pahnho theng Jê-ru-sa-lem đơu paleek, vii nưq laa theng ku Vuua kôt. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Oh ay kung te pahnho akoq oh ay đơu paleek, vii oh ay be e paraat xôq dơơp muuyq raq hlôôk vlôh ko long ju. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Bơh apok ku oh ay dayh laa ‘E, laa e,’ long ‘Leh, laa leh.’ Măn varơuq kajoq galơh iaq varơuq neq laa xing kamuuych.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Oh ay heq tameng luneq, apok heq jah pato: ‘Mot bla mot, ji kaneeng bla kaneeng.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Bơh, thơy đnooy ka oh ay te tachơơl hlê adro xơk. Tađôôy muut đnư, paq kê kơyq pađa oh ay muut tavok pi akoh, kung dayh ăm tavok măn hlê ka adro nưq. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Đôôyq dii adro xung rôp xadrah oh ay vlôh hnhư xadrah ji xok hlơơp aau 'lăp ku oh ay, dayh xôq adro nưq xok hloay aau gôk oh ay. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Ji kơyq nưq hnoq padăt oh ay hooy muuyq đoanq trôôk, yôôych dayh hooy dii adro nưq vaarq đoanq trôôk. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Dayh ăm adro vôôch oh ay, ji te wih katoor klơlh adro xung xapo xing aduq oh ay.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Oh ay heq tameng luneq, apok heq jah pato: ‘Xiaq adro gah gih haay ji 'yarơ adro tachơơl haay.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Bơh thơy đnooy ka oh ay dayh xung xiaq adro tachơơl haay ji apôôy thay ka adro rôp toop haay, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />dơơp aleq ka oh ay hnoq ik vlôh jêêk koot ku Vaq haay tol daak plêêk. Nưq laa vii Kadraq khienq mot hngơy ku Kadraq vlok tol adro xơk hloay ka manih leh huq xơk, ji Kadraq kahniq jit tol manih hyioh jăk hloay adro leh hyioh jăk. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Vii atoh oh ay xung xiaq khơl leq xung xiaq oh ay, yôôych oh ay e phon kadrool kajoq? Be aalq khơl adro xok xơu kung dơơp dang đanưq ih? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ji atoh oh ay vơ vôôch hrok khơl adro oh ay haay, yôôych oh ay dơơp galơh iaq varơuq kajoq? Be aalq kaluh tamooy daak kadrơy kung dơơp dang đanưq ih? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Anưq, oh ay hnoq pheq xaleep, dang đaji Vaq tol plêêk ku oh ay laa xaleep.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Dayh rơơt rol truh varơuq hyioh jăk ku haay dơơp aleq te dơơp kangưưr khơl drơy xôq jah oot 'yo hloq, bơh atoh leh aalq anưq, yôôych e đaneq oh ay be e phon kadrool đom varơuq e mot ku Vaq haay tol daak plêêk. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Kơq nưq, tuôôy oh ay ăm kuah ăm hloh, te klôôp taliaq kangưưr oh ay dang đaji khơl adro xuum pa ôôh lar dơơp đom kaluh hnhư tagumq ji tyauq trôôk kôt, dơơp aleq ka oot jah vado vanê xing khơl drơy. Dong dik, thơy đnooy dii oh ay, oot e đu phon kadrool ku oot. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Bơh tuôôy oh ay ăm kuah ăm hloh, te xôq ka ti akeng ku oh ay xet varơuq ti akoh haay đong dơơp, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />dơơp aleq ka varơuq ăm hloh ku oh ay hnoq ik măn đom aduq padu, ji Vaq ku oh ay, Kơy 'yo hloq đom aduq padu, hnoq kahniq kadrool ka oh ay.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Ji tuôôy oh ay apôôy, yôôych te đaji adro xuum pa ôôh lar, vii oot trôôch apôôy tuôôy heq dưk đom kaluh hnhư tagumq ji aduq kaluh muum trôôk, dơơp aleq ka oot hnoq ik jah khơl drơy 'yo hloq. Dong dik, thơy đnooy dii oh ay, oot e đu phon kadrool ku oot. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Măn oh ay, tuôôy oh ay apôôy, dayh muut đom phong đêh ku oh ay, ji tuôôy heq kađnoch 'mok phong oh ay hlê, dayh apôôy dii Vaq haay đom aduq padu nưq, ji Vaq ku oh ay, Kơy 'yo hloq đom aduq padu, hnoq kahniq kadrool ka oh ay. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Ji đong tuôôy apôôy, oh ay te đnooy hooy đnooy hlê trôôk leh yuôôr dang đaji kaluh tamooy daak kadrơy, vii oot biit đaneq gamưh varơuq 'ngưng apok ku oot, oot hnoq jah tameng. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Kơq nưq, oh ay be duh dang đaji oot, vii Vaq ku oh ay xet oh ay kơn duh kajoq adroyq tuôôy oh ay apôôy vôôch Kadraq. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Anưq, oh ay dayh apôôy luneq:</para>
  <para style="q1" vid="MAT 6:9">‘Kuh Vaq 'wot koot tol daak plêêk,</para>
  <para style="q2" vid="MAT 6:9">Apôôy Yal Kadraq jah vanê vah.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Apôôy daak dêh Kadraq dayh truh,</para>
  <para style="q2" vid="MAT 6:10">apôôy iq trôôch Kadraq jah xalih vlôh 'laarq vari kung đaji tol plêêk.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Apôôy kahniq ka 'wot koot hngơy neng tuôông xa tôôy hngơy ku 'wot koot;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />ji apôôy ka'lăk kadrôôp 'wot koot truh kaluh pơq kadrôôp ku 'wot koot,</para>
  <para style="q2" vid="MAT 6:12">đaji 'wot koot kung heq ka'lăk kadrôôp khơl adro pơq kadrôôp dii 'wot koot;<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />ji apôôy te taway 'wot koot muut adô aluut,</para>
  <para style="q2" vid="MAT 6:13">bơh wơơt 'wot koot klơlh adro xơk.’<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Vii atoh oh ay ka'lăk ka khơl drơy kaluh gưlh lôp ku oot, yôôych Vaq tol plêêk ku oh ay kung hnoq ka'lăk ka oh ay. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Măn atoh oh ay leh ka'lăk ka khơl drơy, yôôych Vaq ku oh ay kung hnoq leh ka'lăk kaluh gưlh lôp ku oh ay.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Đêh vlôh, tuôôy oh ay deek xa, te kahnoq vlôh kaveeh đaji khơl adro hlu rơu xuum pa ôôh, vii oot jaliêu mamưưt ku oot xôq oot hnoq ik kahnoq ka khơl drơy hloq laa đong deek xa. Dong dik, thơy đnooy dii oh ay, oot e đu phon kadrool ku oot. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Măn oh ay, tuôôy deek xa, dayh para jơu tol akoq oh ay ji 'nhaau mot oh ay, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />dơơp aleq ka oh ay be hnoq ik kahnoq ka khơl drơy hloq laa đong deek xa, bơh laa ka Vaq oh ay đom aduq padu; ji Vaq ku oh ay, Kơy 'yo hloq đom aduq padu, hnoq kahniq kadrool ka oh ay.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Te dơơp xôq ka kadih xăk garuh anôôp 'laarq vari, laa aduq đơu pi kamoor kung kaxaak dơơp pahư, kung laa aduq đơu adro atôk leenq muut ji xok atôk. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Bơh dayh dơơp xôq ka oh ay garuh anôôp tol plêêk, laa aduq leh e pi kamoor long kaxaak dơơp pahư, ji laa aduq đơu adro atôk leh leenq muut long xok atôk. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Vii garuh anôôp ku oh ay măn 'leq, yôôych xuum ku oh ay kung hnoq măn đnư. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Kalong mot laa đeen ku xăk xamơk. Kơq nưq, atoh mot oh ay laa tolh, yôôych dêq xăk xamơk oh ay hnoq jah viik galaay xaraar tađnah. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Bơh atoh mot oh ay laa xơk, yôôych dêq xăk xamơk oh ay hnoq biq viik galaay kamơng jaluk. Anưq, atoh xaraar tađnah đom oh ay laa kamơng jaluk, yôôych kamơng jaluk nưq kôt xet dong leq! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Leh kơyq hnoq ik hơu varơuq ka vaarq kôôch hnhư, vii adro nưq long hnoq 'yarơ kôôch neq đơu xiaq kôôch hơq, long hnoq dêq xuum dii kôôch neq đơu 'yo kôôch hơq leh raa kajoq. Oh ay leh ik hơu varơuq Kơy Plêêk aluq baak jêêt ik. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Vii kơq varơuq neq, thơy đnooy dii oh ay, te ralauq biit ka varơuq riirh ku oh ay, truh thưq kajoq haay xa long thưq kajoq haay hôôch, long ka xăk xamơk ku oh ay, truh thưq kajoq oh ay hlưp. Be aalq varơuq riirh yôôych quiq iaq tuôông xa, ji xăk xamơk quiq iaq đô hlưp long aleq? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Dayh 'yo aduq kaluh paroh xêêp plêêk, đaneq oot be pêêt, kung leh goch long dơơp xôq muut pơ va, đơu Vaq tol plêêk ku oh ay văch oot. Oh ay be e quiq jaq iaq oot long ih? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Mot kadrơy, adro leq katul oh ay tuôôy biit loo yôôych e ik athêêp muuyq takiêh muut tuuyh đơơy ku ni? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Ji aleq oh ay biit loo truh qwuân aau? Dayh 'yo dong dik hloay truh kaluh raak hwuêq manay gôk, kach leq đơu oot vlok tok. Oot be dơơp galeh, kung leh taat varaay. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Bơh thơy đnooy dii oh ay đaneq hloay ka vuua Sa-lô-môn, đom dêq hloay varơuq karoh e ku kơy, kung leh hlưp qwuân aau ka kơy dang đaji muuyq đom sôôq kaluh raak nưq. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Măn atoh Kơy Plêêk pahlưp đanưq ka reek manay gôk, laa ưng juneq măn, ji hngơy dơh bi qweek muut ôôlh, yôôych khơl adro axit xuum tuôq hơq, anưq Kadraq be dơơp ik 'ngưng iaq long aleq? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Kơq nưq, oh ay be duh biit lo đơu đnooy: ‘Haay xa kajoq?’ long laa ‘Haay hôôch kajoq?’ long laa ‘Haay hlưp kajoq?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Vii kaluh tamooy daak kadrơy axek akhiim dêq hloay kaluh ưng nưq; ji vii Vaq tol plêêk ku oh ay xet đaneq oh ay kơn duh dêq hloay kaluh varơuq nưq. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Bơh adroyq dik dayh akhiim axek daak Plêêk ji varơuq hyioh jăk ku Kadraq yôôych dêq hloay kaluh varơuq nưq hnoq jah athêêp muut ka oh ay. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Kơq nưq, oh ay be duh biit lo truh hngơy dơh, vii hngơy dơh hnoq lo kadih ka ni. E đu ka muuyq hngơy varơuq pơơl galeh ku kadih ni.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Te xadrah đnooy, xôq oh ay leh biq xưh xadrah đnooy. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Vii đom varơuq rôp xadrah đơu oh ay xadrah đnooy, oh ay hnoq chiuq xadrah đnooy, ji bơyh hlưk wolh đơu oh ay heq hlưk wolh, hlưk wolh nưq hnoq jah hlưk wolh đôôyq dii oh ay. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Đơu aleq oh ay 'yo hloq kapleh ka'nhah đom mot adro oh ay haay, bơh oh ay leh 'yo hloq talok gay đom mot oh ay? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Long bơơn kach leq đơu oh ay hnoq dăt adro oh ay haay: ‘Dayh xôq gô xok kapleh ka'nhah vlôh klơlh mot ay,’ đơu 'yo hơq, talok gay đong măn đom mot oh ay? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Adro xuum pa ôôh hơq! Droyq dik, dayh xok talok gay vlôh klơlh mot xăk, yôôych atêq nưq, oh ay hnoq hloq ro xôq xok kapleh ka'nhah vlôh klơlh mot adro oh ay haay. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Oh ay te ăm bơy xo tuôông vah, kung te qweek kalook ngok ku oh ay kangưưr bơy xuur. Leh kheoq oot hnoq joaq jek kaluh ưng nưq 'laarq jôôk oot, ji atêq tuôôy wiit hlê yôôych oot kek chieh oh ay vlôh dong apek.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Dayh vôôch, ji varơuq nưq hnoq jah kahniq ka oh ay. Dayh axek, ji oh ay hnoq tavơh. Dayh pah, ji 'mok hnoq jah luh ka oh ay. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Vii paq kê kơyq vôôch yôôych jah; kơyq axek yôôych tavơh; ji, 'mok hnoq jah luh ka kơyq pah. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Long e kơyq đom khơl oh ay, laa adro đơu koot haay vôôch tôôp — dang aleq dro nưq hnoq ăm adro koot kuk phơu? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Long adro koot kung vôôch ka — dang aleq adro nưq hnoq ăm ni volh? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Anưq, atoh oh ay, laa xơuq, xet ăm koot xau haay kaluh kadrool tolh kaxay, yôôych Vaq ku oh ay tol daak plêêk hnoq kahniq ka adro leq vôôch Kadraq 'ngưng varơuq tolh kaxay iaq xet dong leq? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Kơq nưq, đom tôôy varơuq, atoh oh ay trôôch paq kê varơuq kajoq xôq khơl drơy dơơp ka oh ay, yôôych oh ay kung dayh dơơp đanưq ka oot, vii nưq laa ganuun ji kaluh apok hlit.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Dayh hooy muut hlê 'mok de. Vii 'mok ranưh ji trôôk ranưh ranơơy jarooy truh varơuq kaxêêt hlơơp, ji e 'ngưng adro hooy muut aduq ni. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Nưq laa kơq 'mok de ji trôôk jah dơơp ăm de jarooy truh varơuq riirh, đơu e axit adro axek hloq ni.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Dayh rơơt rol truh khơl hlit pa ôôh, laa khơl adro ayil kanôôp trưưu truh dii oh ay, bơh pi 'lăp, oot laa paroh xo vari hrah xa. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Oh ay hnoq 'yo xet oot xing aduq play ku oot. Khơl drơy dang aleq e weelh nho xing pôôp jaliê, long play pok puut xing rek jaliê? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Dang anưq, tôôy ưk kaxay yôôych raak play kaxay, măn ưk xơuq yôôych raak play xơuq. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ưk kaxay leh ik vlôh play xơuq, ưk xơuq kung leh ik vlôh play kaxay. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Tôôy ưk leh vlôh play kaxay hnoq biq kơl ji qwel muut ôôlh. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Lunưq, axit dik yôôych oh ay hnoq 'yo vlôh oot xing aduq play ku oot. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Leh aalq tôôy dro đnooy dii thơy: ‘Kuh Lôôk, kuh Lôôk’, hnoq muut đom daak dêh daak plêêk, bơh laa adro dưk dơơp iq trôôch ku Vaq thơy tol daak plêêk. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Đom hngơy nưq, 'ngưng dro hnoq tơơl kung thơy: ‘Kuh Lôôk, kuh Lôôk, be aalq 'wot koot heq taayh yal Kadraq đnooy hlit, heq taayh yal Kadraq druyh kamuuych ji heq taayh yal Kadraq dơơp 'ngưng varơuq taay yaak ih?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ji tuôôy nưq, thơy hnoq đnooy hlolh dii oot đaneq: ‘Gô be hmưq xet êêp dong leq! Bing dơơp xơk hơq, dayh chuh hooy klơlh Gô!’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Kơq nưq, tôôy dro, nưq laa paq kê kơyq tameng kaluh apok neq ku thơy ji dưk dơơp tyauq apok yôôych hnoq jah 'yo đaji muuyq dro khôôt xet, laa adro xơy hnhư ni tol talaat phơu. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Jit răk pôôt, daak xako xuq, khiel klôôp ji kapuh kaxuh muut hnhư nưq, đơu ni leh hrưp vii ni heq jah xơy tol talaat phơu. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ji tôôy dro tameng kaluh apok neq ku thơy đơu leh dưk dơơp tyauq apok yôôych hnoq jah 'yo đaji muuyq dro vlô apoop, laa dro xơy hnhư ni tol choah. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Jit răk pôôt, daak xako xuq, khiel klôôp ji kapuh muut hnhư nưq, yôôych ni hrưp pôôt ji varơuq hrưp hrek ku ni laa thier kôt.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Varơuq xalih vlôh nưq laa tuôôy Lôôk Jê-xu pato dayq yôôch kaluh apok nưq, manih karôp biq akêh xing varơuq pato dayq ku Kadraq, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />vii Kadraq pato dayq oot đaji e qwuyen da uh, đơu leh dang đaji khơl thơy pato ganuun ku oot.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Tuôôy nưq, atêq tuôôy Kadraq xing tol đoot hooy pôôt, kaluh bing manih karôp hooy tyauq Kadraq. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />'Yo hơq, muuyq dro biq bingq paruh atêq tuôôy tawaak truh, heq kul kangưưr Kadraq, tơơl: “Kuh Lôôk, atoh Kadraq trôôch, Kadraq e taay yaak xôq khienq gô ik xarơyh.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yôôch tuôôy heq tơơk ti vlôh, Kadraq vêq muut ay, đnooy: “Gô trôôch. Dayh xarơyh yơu.” Vơ hloay, ay nưq jah xarơyh paruh ku ay. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Lôôk Jê-xu đnooy dii ay: “Dayh rơơt rol, ay te duh đnooy dii kơyq, bơh dayh hooy, kahnoq vlôh xăk dii thơy tơơk tưp ji tưp kuah lêh đơu Môi-se heq pato dayq, đaji muuyq apok xanưk ka oot.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Tuôôy nưq, atêq tuôôy Kadraq hooy muut đom theng Ka-bê-na-um, muuyq padrok dưk xakaq kuun heq truh kung kadraq, apôôy vôôch Kadraq <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />đaneq: “kuh Lôôk, xapok ku gô vik alêêt măn hnhư, chiuq jiq jiêh heq paq ik.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Kadraq đnooy dii kơy: “Tuôôy truh yôôch, gô hnoq payơh hlah ka ay nưq.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Tuôôy tơơl hlê, padrok dưk xakaq kuun tơơl: “Kuh Lôôk, gô yôôych be xưngq kajoq xôq Kadraq hnoq ik hooy muut 'laarq apo hnhư gô, lunư apôôy Kadraq vơ xanoh muuyq apok, yôôych xapok ku gô hnoq jah payơh hlah. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Vii gô kung laa muuyq dro jah xôq 'laarq qwuyen, e kaluh bing kuun măn 'laarq gô. Gô đnooy dii dro neq: ‘Hooy yơu,’ yôôych ay nưq hooy, dii dro kadrơy: ‘Dayh truh,’ yôôych ay nưq truh, ji dii xapok gô: ‘Dayh dơơp varơuq neq,’ yôôych ni dơơp.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Bơh atêq tuôôy tameng anưq, Lôôk Jê-xu tưng hưng ji đnooy dii khơl adro đong hooy tyauq Kadraq: “Dong dik, thơy đnooy dii oh ay, thơy leh hloq xuum tuôq kôt đanưq xing muuyq dro leq đom I-sơ-ra-ên. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Wih hlê, thơy đnooy ka oh ay đaneq 'ngưng dro hnoq truh xing hngơy vlok ji hngơy lôp, yôôch oot hnoq jah 'ngôôy xa kung dii Ap-ra-ham, I-sak ji Ja-kôp đom daak dêh daak plêêk. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Bơh khơl koot ku daak dêh hnoq biq qweek muut aduq kamơng jaluk pi gôk, laa aduq hnoq e varơuq nhim alo ji takik kaneeng.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Yôôch Lôôk Jê-xu đnooy dii padrok dưk xakaq kuun: “Dayh hooy yơu! Đaji kơy heq tuôq, varơuq nưq pheq jah dơơp jêêk ka kơy.” Ji adro xapok nưq heq jah payơh hlah đom wat nưq.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Atêq tuôôy Lôôk Jê-xu muut đom hnhư ku Phi-e-rơ, Kadraq hloq miq kadrê ku kơy vik tol chanưng ji đong biq jiq tanget. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Kadraq vêq muut ti ku mo, ji jiq tanget vlôh klơlh mo, yôôch mo 'ngôôy kah ji xarôp hơu varơuq Kadraq. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Tuôôy nưq, tuôôy heq truh rayôôp klôôy, khơl drơy taway truh ka Kadraq 'ngưng dro biq kamuuych nhôp, Kadraq druyh kaluh garu xi nưq bơơn muuyq apok xanoh ji payơh ka dêq hloay khơl leq tavơh bingq, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />dơơp aleq ka varơuq nưq jah jêêk apok heq jah đnooy gamưh hnhư hlit Ê-sai, đaneq: “Kadih Kadraq heq pơq xok kaluh jiq jiêh ku haay ji heq gengq chiuq kaluh bingq tâk ku haay.”<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Tuôôy nưq, tuôôy 'yo hloq manih karôp rawiit gah kadraq, Lôôk Jê-xu patăk dưk hooy hlê gah pi hơq. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Yôôch muuyq thơy pato ganuun, atêq tuôôy truh jeq, heq đnooy dii Kadraq: “Kuh thơy, gô hnoq tyauq thơy long thơy hooy ka'leq.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Lôôk Jê-xu đnooy kung kơy: “Ôô xaar e troop, ji xêêp plêêk e tapu, bơh Koot Manih leh e aduq đơu Kadraq hnoq ik angôôlh akoq.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Anưq yôôch, muuyq dro kadrơy đom khơl xatyauq tơơl dii Kadraq: “Kuh Lôôk, apôôy ăm pheep gô droyq dik laa wiit xuq ji up vaq gô.” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Bơh Lôôk Jê-xu đnooy dii ay: “Dayh tyauq thơy, ji dayh xôq dro kaxêêt up dro kaxêêt ku oot.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Tuôôy Lôôk Jê-xu heq tok đom ge, khơl xatyauq ku Kadraq hooy tyauq Kadraq. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />'Yo hơq, muuyq đơơt khiel thier kôt xalih vlôh tol tahli, pheq đnooy ge biq daak ranaq kapuh. Bơh Kadraq đong vik. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Yôôch tuôôy hlê jeq, oot nhơk kah Kadraq, tơơl: “Kuh Lôôk, apôôy Kadraq wơơt rơy; haay jeq kaxêêt yôôch!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Ji Kadraq đnooy dii oot: “Taleq dro axit xuum tuôq hơq, aleq oh ay yôq varaal?” Atêq nưq, tuôôy heq 'ngôôy kah, Kadraq toah khiel ji tahli, yôôych varơuq langưm hnhep xateek xalih vlôh. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Măn khơl adro nưq akêh, đnooy: “Manih neq laa đaleq, vii pheq đnooy khiel ji tahli raay tameng apok kadraq?”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yôôch tuôôy Kadraq heq hooy hlê pi gah hơq, truh dêh Ga-đa-ra, vaarq dro biq kamuuych nhôp heq truh tavơh Kadraq, atêq tuôôy hooy vlôh xing aduq kalo xanưng, oot thier raa ramêq paq ik pheq dơơp leh kơyq hôôk xôq hooy dalơh hlê tyauq trôôk nưq. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />'Yo hơq, oot alo tok, đaneq: “Kuh Koot Kơy Plêêk, 'wot dii Kadraq e varơuq kajoq? Kadraq truh đnen xôq dơơp ra ơơh 'wot adroyq tuôôy paja xôq be?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Tuôôy nưq, e muuyq bơy xuur karôp 'ngưng đong xa kaplaalh xing oot leh xangưưy. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Anưq yôôch, bing kamuuych apôôy vôôch Kadraq, đaneq: “Atoh Kadraq druyh 'wot, apôôy ăm 'wot nhôp muut bơy xuur nưq.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Kadraq patăk oot: “Hooy vlôh!” Anưq laa atêq tuôôy vlôh klơlh, bing oot nhôp muut bơy xuur; ji dayh 'yo hơq, dêq bơy charuyh paxưk pôôt tyauq trôôk ahmaat panưk jarooy vlôh tahli, yôôch oot kaxêêt 'laarq daak. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Tuôôy nưq, khơl adro xakaq xuur ka'lăk xadăk, ji atêq tuôôy xuq truh theng, oot taboon hlê tôôy varơuq, hloay ka varơuq tajinq truh taleq adro biq kamuuych nhôp. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ji dayh 'yo hơq, dêq hloay theng garuk vlôh xôq tavơh Lôôk Jê-xu. Tuôôy heq hloq Kadraq, oot apôôy vôôch dơơp aleq ka Kadraq chuh hooy aduq kadrơy klơlh vari dêh ku oot.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Tuôôy heq muut đom ge, Kadraq dalơh hlê tahli ji xuq truh theng ku kadraq. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />'Yo hơq, khơl drơy xagook truh ka Kadraq muuyq dro biq taqwauq talêêt đong vik tol xadôôk. Tuôôy Lôôk Jê-xu hloq xuum tuôq ku oot, Kadraq patăk dro biq taqwauq talêêt: “Nee koot, dayh kalh paraat tok. Kaluh kadrôôp maroh koot jah tha.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Ji 'yo hơq, muuyq sôôq đom kaluh thơy pato ganuun đnooy dii mamuuyq: “Adro neq đnooy katơơk galơh.” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Bơh heq xet kaluh xuum biit ku oot, Lôôk Jê-xu đnooy: “Êêp kơy măn biit leh kaxay đom xuum êêp xôq dơơp kajoq? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Vii varơuq leq laa klêq iaq xôq đnooy: ‘Kaluh kadrôôp maroh koot jah tha,’ long đnooy: ‘Dayh dưk tok ji tawaak hooy?’ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Bơh xôq êêp kơy hnoq ik xet đaneq Koot Manih e qwuyen măn tol vari xôq tha kadrôôp …” yôôych muut tuôôy nưq, Kadraq dăt adro biq talêêt: “Dayh dưk tok, galơuq xadôôk tok, ji hooy xuq hnhư ay.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Ji atêq tuôôy dưk tok, dro nưq hooy xuq hnhư ni. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Anưq laa, tuôôy hloq anưq, manih karôp yôq varaal ji ayuôôt laat Kơy Plêêk vii heq kahniq ka koot manih qwuyen da uh lunưq. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Tuôôy heq xing aduq nưq chuh hooy, Lôôk Jê-xu 'yo hloq muuyq dro anơng Ma-thi-ơ đong 'ngôôy aduq xok xơu, yôôch Kadraq dăt kơy: “Dayh tyauq thơy.” Ji atêq tuôôy dưk tok, kơy hooy tyauq Kadraq.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Varơuq xalih vlôh tuôôy Kadraq 'ngôôy xa đom hnhư, yôôych 'yo hơq, 'ngưng manih xơk xơu ji adro e kadrôôp hooy truh, heq 'ngôôy muut para xa kung Lôôk Jê-xu ji khơl xatyauq Kadraq. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Tuôôy tameng hloq anưq, khơl manih Pha-ri-si đnooy dii khơl xatyauq Kadraq: “Vii kơq kajoq đơu thơy ku êêp ay xa achung dii bing xok xơu ji adro e kadrôôp?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Bơh atêq tuôôy tameng hloq, Kadraq đnooy: “Manih kalh paraat leh e duh truh thơy jarơơu, đơu laa adro jiq bingq. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Măn atêq tuôôy hooy klơlh, dayh hok hlolh apok neq laa aleq: ‘Gô trôôch xuum biit angơuq, leh aalq kuah tưp.’ Vii be aalq gô truh xôq taayh manih hyioh jăk, bơh laa dro e kadrôôp.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Tuôôy nưq, khơl xatyauq ku Jăng truh tavơh Kadraq, tơơl: “Vii kơq kajoq đơu 'wot ji khơl manih Pha-ri-si 'ngưng deek xa, măn khơl xatyauq ku thơy yôôych leh deek xa?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Lôôk Jê-xu đnooy dii oot: “Dang aleq khơl 'wơyq truh jưq waal pajêêk hnoq ik hlu rơu đom kawah chưng nưq đơu ok măn kung dii oot? Bơh hnoq truh hngơy tuôôy đơu ok biq taway hooy klơlh oot, yôôych tuôôy nưq oot hnoq deek xa. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Đêh vlôh, leh kơyq kaval muuyq apek vaayh đơơu koq biq ta hnhoot muut apek aau duut, vii apek kaval hnoq dơơp tahyaak klơlh apek aau nưq, ji muuyq hlêêl tahyaak măn têq iaq tuôôy ni e. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kung leh kơyq kliik lok đơơu muut bơu kađuh duut. Bơh atoh be aalq anưq, yôôych e đaneq bơu kađuh biq mich vadah, lok biq ahngok vlôh ji bơu biq hư. Tađôôy muut đnư, khơl drơy kliik lok đơơu muut bơu kađuh đơơu, ji dêq tavaarq jah jư hlê.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Đom tuôôy Kadraq đong đnooy kaluh apok nưq dii oot, yôôych 'yo hơq, muuyq dro dưk xakaq hnhư tagumq atêq tuôôy truh jeq, heq kul pôôt kangưưr Kadraq, tơơl đaneq: “Koot kadrê gô vơ đơơu kaxêêt, anưq bơh tuôôy truh đnư, apôôy dayh xôq ti thơy tol koot kadrê, yôôych koot kadrê hnoq riirh.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Atêq tuôôy dưk kah, Lôôk Jê-xu ji khơl xatyauq Kadraq hooy tyauq kơy nưq. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Ji 'yo hơq, muuyq dro khơl drê heq raanq chiuq jiq bingq be drơy tuôôt kưl vaarq xanưm, tuôôy tawaak truh pi atêq Kadraq yôôch, yôôych heq vêq muut thơơl aau ku Kadraq, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Vii mư kadih biit: “Atoh gô vơ vêq muut aau Kadraq heq, yôôych gô hnoq jah yơh bingq.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Bơh atêq tuôôy wih hlê ji hloq mư, Lôôk Jê-xu đnooy: “Koot kadrê lơơy, dayh kalh paraat; xuum tuôq koot heq payơh koot.” Ji dro khơl drê nưq jah yơh bingq xing wat nưq. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Yôôch Lôôk Jê-xu, atêq tuôôy hooy truh hnhư adro dưk xanok hnhư tagumq nưq ji hloq taleq dro klôôp taliaq kung manih karôp tarok 'nhih, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />heq patăk: “Dayh chuh vlôh, vii koot kadrê heq leh kaxêêt, bơh laa đong vik.” Yôôch oot xagiel ra ơơh Kadraq. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Anưq laa, tuôôy manih karôp biq đuôôy vlôh pi gôk yôôch, yôôych atêq tuôôy muut 'lăp, Kadraq adrơk ti koot kadrê, ji koot kadrê nưq kadih 'ngôôy kah. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Hêêl neq jah đnooy vlôh loch dêq dêh nưq.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Đong tuôôy Lôôk Jê-xu xing aduq nưq chuh hooy, yôôych vaarq dro apul heq hooy tyauq Kadraq, taayh kôt ji tơơl: “Kuh Koot vuua Đa-vik, apôôy biit angơuq ka 'wot!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Tuôôy nưq, tuôôy muut đom hnhư yôôch, vaarq dro apul truh jeq Kadraq ji Lôôk Jê-xu đnooy dii oot: “E jơq êêp ay tuôq đaneq gô hnoq ik dưk dơơp varơuq nưq?” Oot đnooy dii Kadraq: “Jơq, kuh Lôôk.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Atêq nưq, Kadraq vêq muut mot oot, đnooy: “Varơuq nưq pheq jah xalih vlôh ka êêp ay tyauq đaji xuum tuôq ku êêp ay.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Mot oot jah luh vlôh, ji Lôôk Jê-xu đnooy dăt oot, đaneq: “Dayh rơơt rol, êêp ay te ăm kơyq xet.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Bơh atêq tuôôy vlôh pi gôk, oot taboon hlê varơuq nưq loch dêq dêh nưq.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Tuôôy nưq, đong tuôôy oot hooy vlôh, yôôych 'yo hơq, khơl drơy jarooy truh ka Kadraq muuyq dro hôp biq kamuuych nhôp. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Tuôôy kamuuych biq druyh yôôch, yôôych dro hôp đnooy ik, ji manih karôp tưng hưng, đnooy: “Muuyq varơuq lunưq koq hmưq dong leq jah kahnoq vlôh đom I-sơ-ra-ên!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Bơh khơl manih Pha-ri-si 'miêh đnooy: “Kơy nưq druyh kamuuych gamưh muut lôôk kamuuych.”<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Lôôk Jê-xu hooy hlê kađneng kahơ dêq hloay kaluh theng ji palơy pla, pato dayq đom kaluh hnhư tagumq ku manih dêh, pato dayq Hêêl Kaxay ku daak plêêk, ji payơh tưng bingq tâk kung tôôy jiq jiêh. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Tuôôy nưq, tuôôy 'yo hloq bing manih karôp, Kadraq biit angơuq ka oot, bơyh oot đong biq pơơl dal ji chiuq hyaak hlơơp, đaji trưưu leh e manih xakaq. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Atêq nưq, Kadraq đnooy dii khơl xatyauq kadraq: “Tabơh xiêk goch yôôych trungq, bơh manih goch yôôych axit. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Kơq nưq, dayh apôôy vôôch Kôôch ku xiêk goch, dơơp aleq ka Kadraq patăk dăt khơl manih goch muut đom xiêk goch ku kadraq.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Atêq tuôôy taayh kưl vaarq dro xatyauq ku kadraq truh, Kadraq heq kahniq ka oot e qwuyen tol kaluh garu xi klơơr 'yêq, xôq druyh oot ji payơh tôôy bingq tâk kung tôôy jiq jiêh. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Anơng ku kưl vaarq dro jah rơơlh laa luneq. Adroyq dik, Si-môn (kung jah taayh laa Phi-e-rơ) ji Anh-rê, ma oh kơy; Ja-kơ koot ku Xê-bê-đê ji Jăng, ma oh kơy; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-lip ji Ba-thê-lê-mi; Thô-ma ji Ma-thi-ơ, laa adro xok xơu; Ja-kơ koot ku A-phê, ji Tha-đê; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môn Xê-lôt, ji Ju-đa Ich-ka-ri-ôt, kung laa adro xalih xuum Kadraq.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Lôôk Jê-xu heq patăk kưl vaarq dro neq hooy, atêq tuôôy patăk dăt oot, đaneq: “Te hooy tol trôôk ku kaluh tamooy daak kadrơy, kung te muut đom theng ku manih Sa-ma-ri. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Bơh dayh truh dii kaluh koot trưưu hyaak hlơơp ku hnhư I-sơ-ra-ên tolh iaq. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Tuôôy nưq, tuôôy hooy trôôk, oh ay dayh pato dayq, đnooy đaneq: ‘Daak dêh daak plêêk heq truh jeq.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Dayh payơh adro jiq jiêh, khienq adro kaxêêt riirh hlê, dơơp xarêh adro paruh ji druyh kaluh kamuuych. Oh ay heq nhonq hloh, yôôych dayh ăm hloh. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Te xagook xatyauq vajang, long baak, long jêêt đông đom kaxuuy oh ay, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />leh xagook drong ka tuôôy hooy trôôk, long vaarq aau, long kaxôôp, long gay, vii dro dơơp hngơy xưngq jah phon xa ni. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Măn đom theng long palơy leq đơu oh ay hooy muut, dayh vôôch axek muuyq dro leq nưq đom aduq neq laa dro taxưngq, dayh măn aduq nưq dong truh tuôôy leq oh ay vlôh hooy. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Tuôôy nưq, tuôôy muut đom hnhư nưq, dayh apôôy hrok hrolh ka aduq nưq. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Muuyq mot, atoh hnhư nưq laa aduq taxưngq, yôôych varơuq hrok hrolh ku oh ay pheq truh tol ni, mot kadrơy, atoh ni leh aalq laa aduq taxưngq, yôôych varơuq hrok hrolh ku oh ay pheq jah wiit xuq dii oh ay. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Ji dro leq leh tiip đoonq oh ay, kung leh chiuq tameng kaluh apok ku oh ay, yôôych tuôôy hooy vlôh klơlh hnhư long theng nưq, dayh tapolh thul 'laarq jôôk oh ay. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Dong dik, thơy đnooy dii oh ay, hnoq laa klêq chiuq ka vari Sô-đôm ji Gô-mô-rơ đom hngơy xưh xadrah iaq laa theng nưq.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />'Yo neq, thơy patăk oh ay hooy đaji trưưu măn katul bơy xo vari, lunưq dayh vlôh jêêk khôôt xet đaji volh ji hwêêt xuum đaji xêêp ka trơu. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Bơh dayh rơơt rol truh khơl drơy, vii oot hnoq rôp atăq oh ay ka hnhư xưh xadrah, ji khơl drơy hnoq tiel oh ay bơơn gay talơy đom hnhư tagumq ku oot; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />yôôch ay oh pheq đnooy hnoq biq jarooy truh kangưưr khơl padrok xanưk ji khơl vuua vii kơq thơy, xôq đaji muuyq apok xanưk ka oot ji ka kaluh tamooy daak kadrơy. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Bơh tuôôy oot rôp atăq oh ay, te lo biit truh trôôk leq long varơuq kajoq oh ay duh đnooy, vii varơuq đơu oh ay duh đnooy hnoq jah kahniq ka oh ay đom wat nưq. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Vii be aalq oh ay laa manih đnooy, bơh laa Kơy Phool Hiel ku Vaq oh ay đnooy đom oh ay. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Đêh vlôh, ay hnoq noop oh muut aduq kaxêêt, ji vaq yôôych noop koot, ji koot xau hnoq dưk tok tachơơl dii miq vaq ji hnoq khienq oot pheq kaxêêt. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ji oh ay hnoq biq tôôy dro 'yarơ vii yal thơy, bơh adro leq chiuq nôôy truh lôôch dik, dro nưq hnoq jah wơơt. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Bơh tuôôy leq khơl drơy rôp toop oh ay đom theng neq, yôôych dayh charơơk hlê theng kadrơy, vii dong dik, thơy đnooy dii oh ay, kajưk dik oh ay hnoq be leq hooy dêq kaluh theng ku I-sơ-ra-ên dong truh tuôôy Koot Manih truh.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Khơl xatyauq yôôych leh galơh iaq thơy, xapok kung leh galơh iaq kôôch ni. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Đôôyq dii khơl xatyauq, dơơp aleq ka dro nưq hnoq ik đaji thơy ni, ji xapok yôôych đaji kôôch ni, laa nhăp yôôch. Atoh khơl drơy heq taayh kôôch hnhư laa Bê-ên-xê-bun, yôôych manih hnhư ku kôôch măn ra ơơh iaq truh kơh leq! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Anưq, te yôq oot, vii be e varơuq kajoq biq kadook đơu hnoq leh jah kahnoq vlôh, biq padu đơu hnoq leh jah 'yo xet. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Varơuq thơy đnooy pato ay oh đom aduq kamơng, dayh đnooy vlôh ka aduq tađnah, ji varơuq oh ay tameng aduq tôôr, dayh đnooy vlôh tol tavuk hnhư. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Te yôq varaal kangưưr khơl adro păk kaxêêt xăk xamơk đơu leh ik păk kaxêêt phool hiel. Bơh dayh yôq varaal Kơy hnoq ik păk kaxêêt hloay phool hiel hloay ka xăk xamơk đom laluk ôôlh măn iaq. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Be aalq vaarq poop xêêp rek jah tek dii jaq muuyq đông baak be aalq? Ji leh muuyq poop leq đom kaluh oot hnoq klêh pôôt vari pi gôk iq trôôch ku Vaq ay oh. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Đơu hloay kah hlôôk tol akoq ku ay oh, dêq hloay laa heq jah jauq yôôch. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Kơq nưq, te yôq; oh ay kôt dalơh iaq 'ngưng poop xêêp rek. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Anưq, tôôy dro, nưq laa paq kê kơyq hnoq xưng nhonq truh thơy kangưưr khơl drơy, yôôych thơy kung hnoq xưng nhonq truh dro nưq kangưưr Vaq thơy tol daak plêêk. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Bơh paq kê dro leq chôôyq thơy kangưưr khơl drơy, yôôych thơy kung hnoq chôôyq dro nưq kangưưr Vaq thơy tol daak plêêk.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Te biit đaneq thơy truh xôq taway hrok hrolh tol vari. Thơy leh truh xôq taway hrok hrolh, đơu laa xieh jaauq. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Vii thơy truh xôq khienq koot kanau tachơơl hlê vaq ni, koot kadrê tachơơl hlê miq ni, koot amưưy tachơơl hlê miq kanau ni; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />ji dro tachơơl ku muuyq dro laa khơl leq đom kôôch hnhư ku dro nưq. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Kơyq xiaq vaq long miq iaq thơy yôôych leh taxưngq dii thơy; kơyq xiaq koot kanau long koot kadrê iaq thơy yôôych kung leh taxưngq dii thơy. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ji dro leq leh hlôôy gay charăk kadih ni ji tyauq atêq thơy yôôych be taxưngq dii thơy. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Kơyq axek varơuq riirh ni hnoq pahlơơp ni, đơu kơyq hlơơp varơuq riirh ni vii kơq thơy hnoq axek jah ni.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Kơyq tiip đoonq oh ay laa tiip đoonq thơy, ji kơyq tiip đoonq thơy kung tiip đoonq Kơy heq patăk thơy. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Kơyq tiip đoonq muuyq hnhư hlit vii manih nưq laa hnhư hlit hnoq nhonq jah kadrool ku hnhư hlit, măn kơyq tiip đoonq muuyq dro hyioh jăk vii dro nưq laa manih hyioh jăk hnoq nhonq jah kadrool ku manih hyioh jăk. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Ji long kơyq ăm muuyq đom khơl dro de hrưưch neq hôôch muuyq xaluk daak jaleek vơ bơyh dro nưq laa khơl xatyauq, yôôych dong dik, thơy đnooy dii oh ay, dro nưq kajưk dik leh hlơơp phon kadrool ku ni.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Varơuq xalih vlôh tuôôy Lôôk Jê-xu heq padoh pato kưl vaarq dro khơl xatyauq ku kadraq yôôch, Kadraq chuh klơlh đnư xôq pato dayq ji padoh taboon đom kaluh theng ku oot. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Tuôôy nưq, Jăng, atêq tuôôy xing đom tu jah tameng taboon hlê truh kaluh varơuq dơơp ku Lôôk Wơơt Dêh, yôôych gamưh hlê khơl xatyauq kơy heq patăk hooy, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />heq tơơl dii Kadraq: “Thơy laa Kơy pheq truh, long 'wot đong takôô muuyq Kơy kadrơy?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Xôq tơơl hlê, Lôôk Jê-xu đnooy dii oot: “Atêq tuôôy chuh hooy, dayh taboon hlê ka Jăng kaluh kajoq oh ay hloq ji tameng. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Dro apul 'yo hloq, dro talêêt tawaak hooy, adro paruh jah xarêh xaraat, dro klok tameng ik, dro kaxêêt jah khienq riirh hlê ji dro adrah pơl hwơơl jah tameng Hêêl Kaxay. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ji tabơh kơyq leh biq gưlh lôp vii kơq thơy laa adro jah vanong.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Tuôôy nưq, tuôôy khơl dro nưq dưk hooy yôôch, Lôôk Jê-xu xarôp đnooy dii manih karôp truh Jăng: “Oh ay hooy vlôh aduq wăngq we xôq 'yo kajoq — ưk kadeer biq anhưh bơyh khiel ih? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Be aalq anưq yôôych oh ay hooy vlôh xôq 'yo kajoq — muuyq dro jah hlưp qwuân aau đom goh kaxay jơq be? 'Yo hơq, dro hlưp goh kaxay yôôych măn đom hnhư vuua. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Wih hlê, oh ay hooy vlôh xôq 'yo kajoq — muuyq hnhư hlit jơq be? Gô đnooy dii oh ay, jơq ji pheq đnooy măn iaq ka muuyq hnhư hlit. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Nưq laa truh kơy đơu apok neq heq jah valơk:</para>
  <para style="q1" vid="MAT 11:10">‘'Yo hơq, Gô đong patăk khơl jah patăk ku Gô hooy kangưưr koot, kơy hnoq deep trôôk ku koot kangưưr koot.’<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Dong dik, gô đnooy dii oh ay, leh muuyq dro leq jah panưk tok đom khơl dro jah khơl drê pa iir vlôh laa kôt galơh iaq Jăng Bap-tit, đơu dro de dik đom daak dêh daak plêêk yôôych kôt galơh iaq kơy. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Bơh, xing hngơy ku Jăng Bap-tit dong truh juneq, daak dêh daak plêêk chiuq tangưưr dii rôp toop, ji khơl adro xơk tauq xok gamưh paraat kalh tagoa xok ni. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Vii dêq hloay kaluh apok hlit ji ganuun heq đnooy adroyq truh đơơy Jăng; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ji atoh oh ay e xuum 'yo nhonq, yôôych kơy nưq laa Ê-li, manih pheq truh. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Kơyq e tôôr xôq tameng, dayh tameng. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Bơh gô hnoq taso adrơơk neq dii varơuq kajoq? Ni yôôych dang đaji bing oh de 'ngôôy aduq tabôôt xa, đơu oot pariau taayh mamuuyq, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />đaneq: ‘'Wot klôôp taliaq ka êêp ay, đơu êêp ay leh ayuch ayauq. 'Wot ook alo đơu êêp ay be nhim.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Vii Jăng truh, be xa kung be hôôch, yôôych oot đnooy: ‘Kơy nưq biq Kamuuych nhôp.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Koot Manih truh, xa ji hôôch, yôôych oot đnooy: ‘'Yo kơy nưq hơq, muuyq dro ha ak xa, muuyq dro vuul lok, 'wơyq ku khơl adro xok xơu ji bing dro kadrôôp maroh!’ Bơh yôôch varơuq khôôt xet jah 'yo xanưk xing khơl koot xau ku mư.”<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Atêq nưq, Kadraq xarôp toah katưưt kaluh theng đơu dêq hloay kaluh pheep akêh ku Kadraq jah dưk dơơp ka kaluh aduq nưq, vii oot heq leh rawiit xuum. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Ra ơơh ka may, theng Kô-ra-xin! Ra ơơh ka may, theng Bêt-sai-đa! Vii atoh kaluh varơuq taay yaak xalih vlôh katul êêp heq jah dơơp vlôh aduq theng Ti-rơ ji Si-đôn, yôôych laa oot heq rawiit xuum đom aau jaliê ji thul vlo xing adroyq yôôch. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Long anưq, Gô đnooy dii êêp, hnoq e varơuq klêq chiuq iaq ka Ti-rơ ji Si-đôn đom hngơy xưh xadrah iaq laa ka êêp. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Măn may, Ka-bê-na-um, dang aleq may hnoq jah tơơk tok truh tol plêêk? May hnoq hooy pôôt truh aduq âm phuh. Vii atoh kaluh varơuq taay yaak xalih vlôh aduq may heq jah dưk dơơp aduq Sô-đôm, yôôych laa theng nưq heq măn hlê truh hngơy neng. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Long anưq, Gô đnooy dii êêp, đom hngơy xưh xadrah, tôôy varơuq hnoq klêq chiuq ka vari Sô-đôm iaq laa ka êêp.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Muut tuôôy nưq, Lôôk Jê-xu lơh apok tơơl: “Kuh Vaq, laa Lôôk ku plêêk ji vari, koot ayuôôt laat Vaq, vii Vaq heq kadook padu kaluh varơuq neq khơl manih khôôt xet ji dro hlolh xet, đơu kahnoq varơuq nưq ka oh de. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Jơq, kuh Vaq, vii đanưq laa varơuq hlah xuum kangưưr Vaq. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Tôôy varơuq heq jah Vaq gô pahnăp xôq ka gô; leh kơyq xet Koot đêh vlôh Vaq, kung leh kơyq xet Vaq đêh vlôh Koot ji khơl leq đơu atoh Koot trôôch kahnoq ăm. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Dayh truh dii gô, nee dêq hloay khơl leq pơl hwơơl ji chiuq pơq parêq, ji gô hnoq ăm oh ay varơuq padơy pado. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Dayh pơq xok varaq ku gô tol oh ay ji hok xing aduq gô, vii gô e xuum hwêêt ji apôôt xăk, yôôch oh ay hnoq axek jah varơuq padơy vado ka phool hiel oh ay. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Vii varaq ku gô klêq chiuq ji gengq gô laa ahyơơl tơơp.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Đom kawah kawat nưq, Lôôk Jê-xu hooy dalơh kaluh manay va muut hngơy Sa-bat, đơu khơl xatyauq ku Kadraq pangoot anưq oot xarôp parach kaluh raak va ji xa. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Bơh atêq tuôôy hloq varơuq nưq, khơl manih Pha-ri-si đnooy dii Kadraq: “'Yo hơq, khơl xatyauq ku thơy dơơp varơuq leh ik pheep dơơp đom hngơy Sa-bat.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Lunư, Kadraq đnooy dii oot: “Êêp kơy heq leh đok hloq varơuq Đa-vik heq dơơp đom tuôôy vuua ji khơl manih hooy kung kơy biq pangoot long aleq? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Luleq vuua heq muut đom hnhư ku Kơy Plêêk ji xa tôôp tơơk tưp, đơu tôôp nưq yôôych leh ăm pheep vuua ji khơl dro hooy kung vuua xôq xa, đêh vlôh vơ deng ka thơy tơơk tưp? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Long êêp kơy heq be đok hloq đom ganuun đaneq muut hngơy Sa-bat, khơl thơy tơơk tưp đom hnhư hơu lôp kadrôôp hngơy Sa-bat đơu oot yôôych be e kadrôôp ih? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Bơh gô đnooy dii êêp kơy đaneq muuyq Kơy kôt iaq hnhư hơu đong măn đnen. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Bơh atoh êêp kơy 'miêh heq 'yo xet ka iq apok neq laa kajoq: ‘Gô trôôch xuum biit angơuq nưq lưp aalq kuah tưp,’ yôôych heq laa êêp kơy heq leh tok xadrah khơl adro be e kadrôôp. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Vii Koot Manih laa Lôôk ku hngơy Sa-bat.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Ji tuôôy heq hooy chuh klơlh đnư, Kadraq muut đom hnhư tagumq ku oot. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />'Yo hơq, muuyq dro e ti biq kavăp, ji oot vôôch 'yo Lôôk Jê-xu, đaneq: “Jơq be ik pheep payơh bingq đom hngơy Sa-bat?” xôq ka oot hnoq ik rôp kadrôôp Kadraq. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Bơh Kadraq đnooy dii oot: “E dro leq đom êêp kơy, đơu dro nưq e muuyq poop trưưu, ji atoh ni klêh pôôt raluk muut hngơy Sa-bat, yôôych dro nưq hnoq leh rôp adrơk kajưk xok ni ji duuy tok be? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ji yôôch koot manih yôôych quiq iaq ôô trưưu xet dong leq! Lunưq, e pheep dơơp varơuq kaxay đom hngơy Sa-bat.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Atêq nưq, Kadraq đnooy dii dro nưq: “Dayh tơơk hnhong ti ku ay vlôh.” Dro nưq hnhong ti vlôh ji ni jah payơh kalh paraat, dang đaji ti hơq. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Bơh atêq tuôôy hooy vlôh, khơl manih Pha-ri-si xôq vih tachơơl Kadraq dơơp aleq ka oot hnoq ik păk kaxêêt Kadraq.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Bơh vii heq xet đanưq, Lôôk Jê-xu wiit chuh klơlh aduq nưq. 'Ngưng dro heq hooy tyauq Kadraq, yôôch Kadraq payơh hlah ka dêq hloay ka oot, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ji Kadraq đnooy adroyq ka oot xôq oot te dơơp ăm kơyq xet Kadraq, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />xôq ka apok heq jah xanoh gamưh hnhư hlit Ê-sai jah jêêk, đaneq:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“'Yo nee, xapok Gô, Manih đơu Gô heq rơơlh;</para>
  <para style="q1" vid="MAT 12:18">Manih xung xiaq ku Gô, đơu aduq Xăk, phool hiel Gô xaleep hlah xuum.</para>
  <para style="q1" vid="MAT 12:18">Gô hnoq xôq Yaak Gô tol Xăk,</para>
  <para style="q1" vid="MAT 12:18">ji Xăk hnoq đnooy vlôh varơuq hyioh jăk ka kaluh tamooy daak kadrơy.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Kadraq hnoq leh tayaat long ook tarok;</para>
  <para style="q1" vid="MAT 12:19">kung be kơyq hnoq tameng apok Kadraq tol trôôk kôt.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Kadraq hnoq be gôh ưk kadeer heq biq tagôh;</para>
  <para style="q1" vid="MAT 12:20">Kadraq hnoq be kajôp jariik đen jaq jeq poch,</para>
  <para style="q1" vid="MAT 12:20">dong truh tuôôy leq Kadraq taway varơuq hyioh jăk truh jah jay,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />ji kaluh tamooy daak kadrơy hnoq takôô gamưh aduq yal Kadraq.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Atêq nưq, muuyq dro apul ji hôp biq kamuuych nhôp jah jarooy truh ka Kadraq, yôôch Kadraq payơh ka dro nưq, pheq dơơp dro hôp neq đnooy ik ji hloq ik. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Dêq manih karôp raay dơơp akêh ji đnooy: “Dang aleq dro neq laa Koot ku Đa-vik?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Măn khơl manih Pha-ri-si, atêq tuôôy tameng varơuq neq, heq đnooy: “Kơy nưq leh druyh ik kamuuych atoh be aalq laa gamưh Bê-ên-xê-bun, nưq laa lôôk kamuuych.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Bơh 'miêh heq xet iq xuum ku oot, Kadraq đnooy dii oot: “Tôôy daak dêh biq aklah vlôh tachơơl hlê kadih ni yôôych biq ralưp ralaak, ji tôôy theng long hnhư biq aklah vlôh tachơơl dii kadih ni yôôych hnoq be dưk kajưk. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Atoh Sa-tan druyh Sa-tan, yôôych ni biq aklah vlôh tachơơl hlê kadih ni, Anưq yôôych, dơơp luleq daak dêh ni hnoq dưk kajưk? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ji atoh gô gamưh Bê-ên-xê-bun druyh kaluh kamuuych, yôôych koot êêp kơy gamưh kơyq druyh oot? Vii kakơq neq, oot hnoq laa khơl adro xưh xadrah êêp kơy. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Bơh atoh gô druyh kaluh kamuuych gamưh Kơy Phool Hiel ku Kơy Plêêk, anưq yôôych daak dêh Kơy Plêêk heq truh tol êêp kơy. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Long dơơp aleq đơu dro leq nưq hnoq ik muut đom hnhư ku dro kalh paraat ji atôk đôô ku ni atoh adroyq dik dro nưq be vek adro kalh paraat nưq hlê? Yôôch atêq nưq, dro neq hnoq xok dêq kuah hnhư ay nưq. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Kơyq leh măn kung dii gô laa tachơơl hlê gô, ji kơyq leh anguk muuyq aduq dii gô yôôych hyaak hyul. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Vii kakơq neq, gô đnooy dii êêp kơy, tôôy kadrôôp maroh ji apok katơơk galơh hnoq jah tha ka khơl drơy, bơh apok lôp truh Kơy Phool Hiel yôôych hnoq leh jah tha. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Atoh kơyq đnooy apok katơơk galơh Koot Manih, yôôych dro nưq hnoq jah tha. Bơh dro leq đnooy tachơơl dii Kơy Phool Hiel, yôôych dro nưq hnoq leh jah tha, hloay đom đơơy neq long đom đơơy jeq truh. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Long laa, pêêt ưk kaxay yôôych play ni kaxay, long pêêt ưk xơuq yôôych play ni xơuq, vii ưk jah 'yo xet gamưh play ku ni. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Rong nooy volh taweek hơq, vii laa xơk, êêp kơy dơơp aleq hnoq ik đnooy varơuq kaxay? Vii huuy đnooy vlôh xing ưng kajoq galaay viik đom xuum. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Manih kaxay, dơơp vlôh xing varơuq choch xôq tamaq kaxay ku ni, dơơp vlôh varơuq kaxay, đơu dro xơk, dơơp vlôh xing varơuq choch xôq xơk tauq ku ni, dơơp vlôh varơuq xơk. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Bơh gô đnooy dii êêp kơy đaneq tôôy apok leh yuôôr đơu khơl drơy đnooy, oot hnoq đnooy vlôh apok kahnoq tauq truh ni đom hngơy xưh xadrah. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Vii xing aduq kaluh apok xarooy ku haay, êêp kơy hnoq jah xưng hyioh jăk, ji xing aduq kaluh apok xarooy ku haay, êêp kơy hnoq biq đinq kadrôôp.”<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Atêq nưq, muuyq sôôq thơy pato ganuun ji manih Pha-ri-si heq tơơl hlê kung Kadraq, đaneq: “Thơy lơơy, 'wot trôôch hloq aduq thơy muuyq dơuq akêh.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Bơh xôq tơơl hlê, Kadraq đnooy dii oot: “Muuyq adrơơk xơk tauq ji apuq atrăp axek akhiim muuyq dơuq akêh, bơh be e dơuq akêh leq hnoq jah kahniq ka ni, đêh vlôh dơuq akêh ku hnhư hlit Jô-na. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Vii Jô-na heq măn đom klaak ka kôt pe hngơy ji pe mưng luleq, yôôych Koot Manih hnoq măn pe hngơy ji pe mưng đom 'laarq vari lunưq. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Đom hngơy xưh xadrah, tamooy Ni-ni-ve hnoq dưk tok kung dii adrơơk neq ji hnoq tok xadrah ni. Vii oot heq wiit xuum adroyq apok pato dayq ku Jô-na, đơu 'yo nee, Kơy kôt lơyq iaq Jô-na măn đnen. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Đom hngơy xưh xadrah, mư vuua pi Naam hnoq dưk tok kung dii rong nooy neq ji hnoq atok xadrah ni, vii xing kaluh aduq akoq lôôch dik ku vari, mo heq truh xôq tameng varơuq khôôt xet ku Sa-lô-môn, đơu 'yo nee, Kơy kôt galơh iaq Sa-lô-môn măn đnen. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Đêh vlôh, tuôôy kamuuych 'moh heq vlôh klơlh muuyq dro, ni dalơh hlê kaluh aduq kateh katoor, axek aduq padơy đơu be hloq. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Tuôôy nưq, ni đnooy: ‘Gô hnoq wiit hlê aduq hnhư gô đơu gô heq vlôh hooy xing aduq nưq.’ Atêq tuôôy truh, ni hloq hnhư hong hlolh, heq jah rahiing deep xarơyh xaraat ji deep xôq e aduq. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Atêq nưq, ni hooy ji jarooy xuq muuyq aduq dii ni pơh garu xi kadrơy măn xơk ra ơơh iaq ni, ji tuôôy heq muut pi'lăp, ka bing riirh đom nưq. Yôôch lôôch dik ku dro nưq vlôh ra ơơh iaq katuôôy adroyq. Varơuq kung hnoq laa đanưq đôôyq dii rong nooy xơk tauq neq.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Đom tuôôy Kadraq đong măn đong đnooy dii manih karôp, 'yo hơq, miq ji khơl oh ku Kadraq 'miêh heq dưk pi gôk, axek trôôk xôq đnooy athêêk dii Kadraq. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Tuôôy nưq, muuyq dro hơq tơơl kung Kadraq: “'Yo hơq, miq thơy ji khơl oh ku thơy heq dưk pi gôk, axek trôôk xôq đnooy athêêk dii thơy.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Bơh tuôôy tơơl apok, Kadraq đnooy dii adro tơơl varơuq kung kadraq: “Kơyq laa miq gô ji kơyq laa khơl oh ku gô?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Yôôch atêq tuôôy tơơk ti kadraq wih kơn khơl xatyauq ku kadraq, Kadraq đnooy: “'Yo nee, miq gô ji khơl oh ku gô neq! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Vii long adro leq dưk dơơp iq trôôch ku Vaq gô tol daak plêêk, yôôych dro nưq laa ma oh kanau, ma oh kadrê ji miq ku gô.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Đom hngơy nưq, atêq tuôôy hooy vlôh klơlh hnhư, Lôôk Jê-xu 'ngôôy pi gah tahli. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Muuyq bing manih thier karôp heq anguk hlê rawiit gah Kadraq. Pheq đnooy, atêq tuôôy tawaak tok muuyq poop ge, Kadraq 'ngôôy pôôt, đơu dêq hloay manih karôp yôôych dưk tol gah. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Yôôch Kadraq đnooy dii oot 'ngưng varơuq bơơn apok atoh, đaneq: “'Yo nee, muuyq dro paraay adrek hooy vlôh xôq paraay. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Tuôôy paraay adrek, muuyq sôôq kalook rôh gah trôôk, yôôych xêêp plêêk truh ji xa dêq oot. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Muuyq sôôq kadrơy rôh tol vari phơu kalook, laa aduq leh e 'ngưng vari dik. Vơ hloay, kalook adrek pluh vlok, vii katuh vari leh e jaruq. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Bơh atêq tuôôy mot hngơy vlok tok, ni heq biq vuh jah ji yauq kateh vii leh e rayah. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Măn muuyq sôôq kadrơy rôh katul kaluh ưk jaliê, yôôych kaluh ưk jaliê kôt tok ji rơơk hnhuuk oot. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Đơu sôôq kadrơy đnoyq rôh tol vari kaxay ji ăm vlôh raak play, kalook yôôych muuyq hreek yưk 'ngưng iaq, kalook yôôych drơu kưl, kalook yôôych pe kưl. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Kơyq e tôôr, dayh tameng.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Yôôch khơl xatyauq, atêq tuôôy hlê jeq, heq tơơl dii Kadraq: “Vii kakơq kajoq đơu thơy laay đnooy bơơn kaluh apok atoh dii manih karôp?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Anưq laa, tuôôy tơơl apok, Kadraq heq đnooy dii oot đaneq: “Đôôyq dii oh ay yôôych heq jah kahniq xôq nhonq xet kaluh varơuq kadook truh daak dêh daak plêêk, măn đôôyq dii khơl adro nưq yôôych leh jah kahniq ăm. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Bơyh dro leq e, yôôych truh phon dro nưq hnoq jah ăm athêêp, ji dro nưq hnoq jah raah 'ngưng. Bơh dro leq leh e, yôôych hnoq biq xok klơlh ni hloay ka varơuq dro nưq đong e. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Vii kakơq neq, thơy đnooy dii oot bơơn apok atoh; vii long e 'yo, oot be 'yo xet; ji long tôôr tameng, oot leh tameng ik, kung leh hlolh ik. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Ji apok hlit ku Ê-sai yôôych jah jêêk aduq oot, đaneq:</para>
  <para style="q1" vid="MAT 13:14">‘Đôôyq dii varơuq tameng, êêp koot hnoq tameng, đơu kajưk dik êêp koot hnoq leh hlolh;</para>
  <para style="q1" vid="MAT 13:14">măn tuôôy 'yo, êêp koot hnoq 'yo, đơu kajưk dik êêp koot hnoq leh 'yo xet.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Vii xuum tamooy neq heq vlôh jêêk kamơng jaluk;</para>
  <para style="q1" vid="MAT 13:15">tôôr oot heq tameng trôôk pơl hwơơl,</para>
  <para style="q1" vid="MAT 13:15">ji oot heq kađniêp mot oot,</para>
  <para style="q1" vid="MAT 13:15">leh kheoq oot hnoq ik 'yo hloq bơơn mot,</para>
  <para style="q1" vid="MAT 13:15">tameng bơơn tôôr,</para>
  <para style="q1" vid="MAT 13:15">hlolh bơơn xuum klaak,</para>
  <para style="q1" vid="MAT 13:15">yôôch wiit xuq hlê,</para>
  <para style="q1" vid="MAT 13:15">ji Gô hnoq payơh hlah oot.’<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Bơh vanong hloay laa mot ku oh ay, vii hloq ik, ji tôôr ku oh ay, vii tameng ik. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Dong dik, thơy đnooy dii oh ay đaneq 'ngưng hnhư hlit ji manih hyioh jăk trôôch kajoq xôq hloq kaluh kajoq oh ay hloq, đơu oot heq leh hloq ik, ji xôq tameng kaluh kajoq oh ay tameng, đơu oot heq leh tameng ik. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Anưq, oh ay dayh tameng apok atoh truh dro paraay adrek. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Tôôy dro tameng đaauq ku daak plêêk đơu leh hlolh, yôôych kamuuych truh ji varoh xok kaluh kajoq heq jah paraay đom xuum dro nưq. Neq laa kalook adrek biq paraay gah trôôk. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Măn kalook adrek bi paraay muut vari phơu kalook, nưq laa adro tameng đaauq ji vơ hloay nhonq xok đaauq kung dii xuum hlah hlaak; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />đơu dro nưq leh e rayah đom ni, bơh laa măn hlê đa đơ; anưq yôôch pơl dal long rôp toop xalih truh vii kơq đaauq, yôôych dro nưq vơ biq gưlh lôp. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Măn kalook adrek biq paraay katul kaluh ưk jaliê, neq laa dro tameng đaauq, đơu varơuq tabông truh đơơy neq ji biit apau ku varơuq karoh e dơơp ka đaauq nưq rơơk hnhuuk ji ni vlôh leh raak play. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Kaluh kalook adrek jah paraay tol vari dik, nưq laa adro tameng đaauq ji hlolh, dro nưq dik raak play ji vlôh play muuyq vlôh muuyq hreek, muuyq vlôh drơu kưl, muuyq vlôh pe kưl.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Kadraq taboon kangưưr oot muuyq apok atoh kadrơy, đaneq: “Daak dêh daak plêêk jah 'yo đaji muuyq dro heq paraay adrek kaxay đom ruôngq ni. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Bơh tuôôy khơl drơy vik, dro tachơơl ku kơy nưq truh ji paraay rek lahaay aluq muut katul va away yôôch hooy klơlh. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Tuôôy ưk va kôt tok ji vlôh raak, yôôych rek lahaay kung biq looy vlôh. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Juneq, khơl xapok ku kôôch hnhư nưq, atêq tuôôy truh, heq đnooy dii kơy: ‘Kơy kôôch lơơy, be aalq kơy heq paraay kalook adrek kaxay đom ruôngq kơy ih? Anưq, rek lahaay xing leq đơu e?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Anưq laa kơy đnooy ka oot: ‘Muuyq dro tachơơl heq dơơp varơuq neq.’ Yôôch khơl xapok tơơl dii kơy: ‘Anưq, kơy e trôôch tuôôy vlôh đnư, 'wot vưyq dêq rek be?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Bơh kôôch tơơl: ‘Te, leh kheoq đong tuôôy vưyq rek lahaay, khơl ay hnoq vưyq va away achung dii rek. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Dayh xôq dêq tavaarq jah kung kôt tok dong truh tuôôy goch, ji muut katuôôy goch, gô hnoq dăt khơl thơq goch: Adroyq ik, dayh anguk rek lahaay hlê ji vek oot vlôh bo xôq vuh oot ka'lăk, bơh dayh anguk va away muut đom pơ xôq ku gô.’”<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Kadraq taboon kangưưr oot muuyq apok atoh kadrơy, đaneq: “Daak dêh daak plêêk yôôych dang đaji muuyq kalook avơy đơu atêq tuôôy xok, muuyq dro heq paraay đom ruôngq ni; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />đơu kalook adrek nưq tabơh laa de dik đom dêq hloay kaluh kalook adrek, bơh tuôôy ni kôt tok, ni kôt iaq kaluh adrek ưk đom hluôôt ji vlôh jêêk muuyq ưk gay, pheq đnooy xêêp plêêk truh ji dơơp tapu tol kaluh đook ku ni.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Kadraq taboon ka oot muuyq apok atoh kadrơy: “Daak dêh daak plêêk yôôych dang đaji tape đơu atêq tuôôy xok, dro khơl drê heq anhơơu dii pe hlưk bôôt dong truh tuôôy dêq ka bôôt vôô tok.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Lôôk Jê-xu heq đnooy tôôy varơuq nưq dii manih karôp bơơn apok atoh, ji Kadraq be đnooy varơuq kajoq dii oot đơu leh bơơn apok atoh, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />dơơp aleq ka apok heq jah xanoh gamưh hnhư hlit jah jêêk, đaneq:</para>
  <para style="q1" vid="MAT 13:35">“Gô hnoq luh huuy Gô bơơn kaluh apok atoh.</para>
  <para style="q1" vid="MAT 13:35">Gô hnoq đnooy vlôh kaluh varơuq hmưq jah kadook padu xing tuôôy panưk kahnier plêêk vari.”<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Atêq nưq, tuôôy heq chuh klơlh manih karôp, Kadraq hooy muut hnhư, Khơl xatyauq Kadraq truh jeq Kadraq, tơơl: “Xiin padoh hlolh ka 'wot apok atoh truh rek lahaay đom manay ruôngq.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Tuôôy nưq, tuôôy tơơl apok, Kadraq đnooy: “Adro paraay adrek tolh laa Koot Manih, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />đơu manay ruôngq laa dêh araak, măn kalook adrek tolh — nưq laa koot xau ku daak plêêk, Wih hlê, rek lahaay laa koot xau ku adro xơk, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />đơu adro tachơơl, laa adro heq paraay rek, laa kamuuych. Măn xiêk goch laa hngơy hlơơp dêh, đơu khơl thơq goch laa yaak plêêk. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Anưq, luleq đơu rek lahaay jah anguk hlê ji biq vuh đom ôôlh, yôôych varơuq kung hnoq xalih vlôh đanưq muut ka hngơy hlơơp dêh. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Koot Manih hnoq patăk dăt yaak plêêk ku kadraq, ji oot hnoq anguk vlôh klơlh daak dêh Kadraq dêq hloay kaluh kajoq dơơp gưlh lôp kung khơl adro dơơp varơuq xơk tauq. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Ji oot hnoq qweek oot muut loo ôôlh, laa aduq hnoq e varơuq nhim alo ji takik kaneeng. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Tuôôy nưq, khơl manih hyioh jăk hnoq xaraar tađnah đaji mot hngơy đom daak dêh ku Vaq oot. Kơyq e tôôr, dayh tameng.”<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Daak dêh daak plêêk yôôych dang đaji muuyq kho bauq jah kadook padu đom muuyq aloq ruôngq, laa ưng đơu muuyq dro heq kadook xôq atêq tuôôy axek hloq. Vlôh xing xuum hlah hlaak ku ni, dro nưq dưk hooy, tek dêq hloay tôôy kajoq ni e ji root aloq ruôngq nưq. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Athêêp đnoyq, daak dêh daak plêêk yôôych dang đaji muuyq dro, laa dro tabôôt xa axek akhiim ngok traai quiq jaq. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Anưq yôôch, tuôôy heq axek jah muuyq kalook ngok traai thier laa e jaq, yôôych atêq tuôôy chuh hooy, ay heq tek dêq hloay tôôy kajoq ni e ji root ni.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Măn đnoyq, daak dêh daak plêêk yôôych dang đaji muuyq poop lưyq jah qweek pôôt tahli ji duuy tok đu thưq ka, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />đơu tuôôy lưyq heq viik, khơl drơy duuy muut gah, ji atêq tuôôy 'ngôôy pôôt, oot tôôch xok kaluh ka tơơl muut đom vuk tađnưk, măn ưng thưq be ik xung liq, oot qweek vlôh pi gôk. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Tôôy varơuq hnoq laa đanưq muut ka hngơy hlơơp dêh: Yaak plêêk hnoq hooy vlôh, ji hnoq aklah vlôh bing xơk tauq klơlh katul khơl dro hyioh jăk, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Yôôch oot hnoq qweek bing nưq muut loo ôôlh, laa aduq hnoq e varơuq nhim alo ji takik kaneeng. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Oh ay heq hlolh dêq kaluh varơuq neq koq?” Oot tơơl kung Kadraq: “Heq hlolh.” <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Tuôôy nưq, Kadraq đnooy dii oot: “Vii kakơq neq, tôôy thơy pato ganuun heq jah pato dayq ka daak dêh daak plêêk yôôych dang đaji muuyq dro kôôch hnhư, laa adro lôôy vlô đôô duut ji đôô đơơu xing đom pơ xôq ku ni.” <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Varơuq xalih vlôh nưq laa tuôôy Lôôk Jê-xu payôôch kaluh apok atoh neq, Kadraq heq chuh hooy klơlh aduq nưq.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Atêq tuôôy hooy truh dêh katu hnhư kadraq, Kadraq heq pato dayq manih karôp đom hnhư tagumq ku oot, pheq dơơp khienq oot akêh ji đnooy: “Varơuq khôôt xet nưq kung kaluh pheep akêh xing aduq manih neq vlôh xing leq? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Be aalq manih neq laa koot kanau kơy thơq 'môôk ih? Be aalq miq kơy nưq jah taayh laa Ma-ri, ji khơl oh kanau ku kơy laa Ja-kơ, Jô-sep, Si-môn ji Ju-đa ih? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Be aalq dêq hloay khơl ma oh kadrê ku kơy nưq đong măn dii haay be aalq? Anưq, tôôy varơuq neq xing aduq kơy nưq vlôh xing leq?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Oot biq xatôôlh gưlh aduq Kadraq. Bơh Lôôk Jê-xu đnooy dii oot: “Hnhư hlit be biq 'yo leh ra kajoq, đêh vlôh aduq dêh hnhư katu ni ji đom kôôch hnhư ni.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Kadraq heq leh dơơp 'ngưng pheep akêh ka đnư vii xuum leh tuôq ku oot.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Muut kawah wat nưq, vuua dưk xanok Hê-rôt tek hêêl truh Lôôk Jê-xu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Vuua đnooy dii khơl xapok kơy: “Nưq laa Jăng Bap-tit. Kơy nưq heq khienq riirh hlê xing aduq kaxêêt, lunưq kơq nưq, kaluh varơuq taay yaak đong e đom dro neq.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Jo Hê-rôt, atêq tuôôy rôp Jăng, heq ăm kal vek kơy ji rôp karuk tu, vii kơq Hê-rô-đia, kadrê ku Phi-lip, ma oh kanau vuua. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Vii Jăng heq đnooy dii vuua: “Truh phon vuua, leh ik pheep xok mo nưq.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ji long xung păk kaxêêt kơy nưq dơyh, bơh vuua yôq manih karôp, vii oot 'yo Jăng đaji muuyq hnhư hlit. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Bơh tuôôy truh waal adoot xa hngơy pa iir ku Hê-rôt, koot kadrê ku Hê-rô-đia ayuch ayauq ka katul waal ji dơơp hlah xuum Hê-rôt, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Vii anưq, vuua heq tavek kung dii muuyq apok paleek xôq kahniq ka mư long varơuq kajoq đơu mư vôôch. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Tuôôy nưq, tuôôy heq biq patuut adroyq nưq xing miq ni, mư tơơl: “Apôôy ăm ka koot hloay aduq neq, akoq ku Jăng Bap-tit măn tol môôm.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Ji long thier hlu rơu, bơh vii kơq apok paleek ku kơy ji khơl manih mơơy kung 'ngôôy xa, vuua heq patăk dăt xôq mư jah kahniq ăm. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Atêq tuôôy patăk manih hooy, vuua ăm dool akoq Jăng đom tu. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Akoq ku kơy jah adrơk truh măn tol môôm yôôch jah palo ka mư kadrê, ji mư adrơk ăm ka miq mư. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Tuôôy truh jeq ik yôôch, khơl xatyauq ku kơy xok xaak ji up xôq ni. Ji tuôôy heq hooy truh, oot taboon hlê ka Lôôk Jê-xu.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Tuôôy nưq, tuôôy tameng yôôch, Lôôk Jê-xu hooy klơlh đnư đom muuyq poop ge hooy truh aduq wăngq we măn đêh muuyq dro. Vii tameng xet đanưq, kaluh manih karôp xing kaluh theng hooy jôôk tyauq Kadraq. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ji atêq tuôôy hooy vlôh, Kadraq hloq muuyq bing manih karôp 'ngưng, yôôych arơơk xuum biit angơuq dii khơl manih karôp ji Kadraq payơh hlah khơl dro jiq jiêh ku oot. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Tuôôy nưq, tuôôy truh rayôôp klôôy, khơl xatyauq truh dii Kadraq, tơơl: “Aduq neq yôôych wăngq vleng, ji wat neq yôôych ahnuy yôôch. Apôôy thơy ăm padơy bing manih xôq tuôôy hooy truh kaluh palơy yôôch, oot hnoq ik root tuôông xa ka oot.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Bơh Lôôk Jê-xu đnooy dii oot: “Oot leh e duh xôq chuh hooy. Oh ay dayh ăm oot xa.” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Tuôôy nưq, oot tơơl dii Kadraq: “Kađneng 'wot be e kajoq đêh vlôh dăp poop tôôp ji vaarq poop koot ka.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yôôch Kadraq đnooy: “Dayh adrơk oot truh đnen ka thơy.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Ji tuôôy patăk ka manih karôp 'ngôôy pôôt tol rek yôôch, tuôôy adrơk dăp poop tôôp ji vaarq poop ka, 'ngơơk mot tok plêêk, Kadraq kuh qwaay, ji pleelh vlôh, Kadraq palo tuôông xa ka khơl xatyauq, măn khơl xatyauq ahlook ăm ka manih karôp. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Dêq hloay manih karôp heq xa ji jah phiq phơh. Yôôch khơl drơy tôôch ưng măn raah hlê xing kaluh apek tapleh raah — jah kưl vaarq vuk atar viik. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Tuôôy nưq, sôôq dro xa laa kơh dăp ravơu khơl kanau, koq jauq khơl drê ji on oh de.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Vơ hloay, Kadraq ahluk dăt khơl xatyauq tawaak muut đom ge ji hooy adroyq Kadraq hlê gah pi hơq, đom tuôôy Kadraq dăt manih karôp xuq. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Tuôôy heq ăm manih karôp xuq, Kadraq hooy tok ma đoot xôq kadih apôôy đêh. Truh klôôy, Kadraq măn đnư muuyq dro. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Măn ge măn katul tahli yôôch yôôych biq daak kapuh kaxuh vii khiel kaxơơlh. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Tuôôy nưq, muut đom kawat poot klôôy nưq, Kadraq truh kung oot, tuôôy hooy jôôk tol tahli. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Bơh atêq tuôôy hloq Kadraq tawaak hooy tol tahli, khơl xatyauq biq varaal varih, đnooy đaneq: “Nưq laa kamuuych,” yôôch oot laa tarok tok đom tuôôy yôq varaal. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Anưq laa, Lôôk Jê-xu vơ tok apok dii oot đaneq: “Te yôq liq! Laa thơy neq. Te yôq!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Tuôôy nưq, tuôôy tơơl hlê Kadraq, Phi-e-rơ tơơl: “Kuh Lôôk, atoh laa thơy, apôôy patăk ka gô hooy tol raak daak truh dii thơy.” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Yôôch Kadraq patăk: “Dayh truh yơu.” Ji atêq tuôôy tawaak vlôh klơlh ge, Phi-e-rơ heq tawaak hooy tol daak xôq truh dii Lôôk Jê-xu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Bơh tuôôy hloq khiel kalh, kơy yôq varaal, ji tuôôy xarôp karăp pôôt, kơy laa tok đaneq: “Lôôk lơơy, wơơt rơy gô!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Vơ hloay, atêq tuôôy tơơk ti vlôh, Lôôk Jê-xu rôp xok Phi-e-rơ ji đnooy ka kơy: “Nee dro axit xuum tuôq, bơyh kơq kajoq đơu ay biit yôq?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Tuôôy oot tawaak tok tol ge yôôch, khiel hnhep klôôp. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Măn khơl dro đom ge yôôych kuh ayuôôt Kadraq, đaneq: “Dong dik, thơy laa koot Kơy Plêêk.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Tuôôy dalơh hlê pi hơq yôôch, oot truh muut gah aduq Gê-nê-xa-rêt. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Atêq tuôôy 'yo vlôh Kadraq, manih karôp măn aduq nưq dăt manih hooy pahêêr truh loch dih dêh rawiit gah nưq, ji khơl drơy jarooy truh ka Kadraq tôôy dro e bingq. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Oot vôôch Kadraq vơ xôq, oot hnoq ik vêq muut kathơơl aau ku Kadraq, ji paq kê laa kơyq vêq muut yôôych jah payơh.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Atêq nưq, khơl manih Pha-ri-si ji Thơy pato ganuun xing Jê-ru-sa-lem truh dii Lôôk Jê-xu, đnooy đaneq: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Aleq khơl xatyauq ku thơy gưlh lôp kaluh ganuun pato ku manih hnu? Vii kơq khơl oot leh 'nhaau ti tuôôy xa tôôp.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Bơh tuôôy tơơl hlê, Kadraq đnooy dii oot: “Aleq êêp kơy laay gưlh lôp ganeen ku Kơy Plêêk vii kơq kaluh pato dayq manih hnu ku êêp? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Vii Kơy Plêêk heq xanoh pato, đaneq: ‘Dayh e xuum xung ka miq vaq ku koot,’ ji ‘Dro leq karoay axaap vaq long miq, dayh păk kaxêêt dro nưq.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Bơh êêp kơy đnooy: ‘Dro leq đnooy dii vaq long miq ni: “Long varơuq kajoq xing aduq koot hnoq ik e ik ka miq vaq raay laa kuah lêh tơơk tưp Kơy Plêêk yôôch,”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />yôôych dro nưq hnoq leh duh pheq e xuum xung miq vaq ni. Đanưq, êêp kơy heq ka'lăk apok Kơy Plêêk vii kơq pato dayq manih hnu ku êêp. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Bing xuum pa ôôh hơq! Ê-sai heq đnooy hlit thier jơq truh êêp kơy, đaneq:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Tamooy neq vanê ayuôôt gô măn ka huuy kapiet,</para>
  <para style="q1" vid="MAT 15:8">bơh xuum oot yôôych xangưưy klơlh Gô.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Đơu oot ayuôôt laat Gô kach đaji hloh,</para>
  <para style="q1" vid="MAT 15:9">tuôôy pato kaluh ganeen laa kaluh ganuun ku koot manih.’”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Yôôch atêq tuôôy taayh bing karôp truh, Kadraq đnooy dii oot: “Dayh tameng ji hlolh: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Be varơuq kajoq hooy muut đom huuy dơơp klơơr 'yêq muuyq dro, bơh laa varơuq xing huuy đnooy vlôh, ưng neq dơơp klơơr 'yêq dro nưq.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Atêq nưq, tuôôy heq truh jeq, khơl xatyauq tơơl dii Kadraq: “Thơy xet đaneq khơl manih Pha-ri-si heq hloq biq đnooy ra ơơh atêq tuôôy tameng apok nưq be?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Bơh tuôôy tơơl apok, Kadraq đnooy: “Tôôy ưk đơu Vaq tol plêêk ku thơy leh pêêt hnoq biq vưyq xarơyh dêq. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Kê ka oot! Oot laa khơl jarooy trôôk apul. Đơu atoh dro apul jarooy dro apul, yôôych dêq baarq hnoq klêh pôôt raluk.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Tuôôy nưq tuôôy tơơl hlê, Phi-e-rơ tơơl dii Lôôk: “Apôôy tauq rơy ka 'wot apok atoh nưq.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Bơh Kadraq đnooy: “Pheq đnooy truh juneq, oh ay kung leh hlolh ih? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Oh ay kung koq hlolh đaneq tôôy thưq hooy muut đom huuy yôôych hooy pôôt klaak yôôch jah eh vlôh đom hnhư kaxoh long aleq? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Bơh kaluh kajoq vlôh klơlh huuy vlôh xing xuum klaak, ji ưng nưq dơơp klơơr 'yêq khơl drơy. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Vii xing xuum đnooy vlôh kaluh xuum biit xơuq 'moh, păk kaxêêt manih, tuut taak, apuq atrăp, xa atôk, xanưk lar ji kaluh apok katơơk galơh. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Nưq laa kaluh varơuq dơơp klơơr 'yêq xăk, măn xa bơơn ti koq lưp 'nhaau yôôych leh dơơp klơơr 'yêq khơl drơy.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yôôch atêq tuôôy hooy vlôh klơlh đnư, Lôôk Jê-xu wiit xuq kaluh dih dêh ku Ti-rơ ji Si-đôm. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ji 'yo hơq, muuyq khơl drê manih Ka-na-an, atêq tuôôy xing dêh nưq truh, heq alo ook, đaneq: “Kuh Lôôk, Koot vuua Đa-vik, biit angơuq gô rơy! Koot kadrê gô biq kamuuych nhôp pơl hwơơl paq ik.” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Bơh Kadraq leh tơơl hlê mư apok leq. Atêq tuôôy truh jeq Kadraq, khơl xatyauq apôôy vôôch Kadraq, đaneq: “Thơy lơơy dăt mư nưq hooy yơu, vii mư nưq kưq taayh ratuut pi atêq haay.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Măn tuôôy tơơl apok, Kadraq đnooy: “Thơy heq be jah patăk truh, atoh leh aalq ka kaluh trưưu hyaak ku hnhư I-sơ-ra-ên.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Bơh atêq tuôôy truh, mư nưq kul pôôt kangưưr Kadraq, tơơl: “Kuh Lôôk, apôôy wơơt waak gô.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Tuôôy nưq, tuôôy tơơl hlê, Kadraq đnooy: “Xok tôôp ku koot xau yôôch qwel ka xo koot laa leh duh.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Bơh mư nưq tơơl: “Kuh Lôôk, jơq anưq, vơ laa hloay ka taleq poop xo koot yôôych jah xa aduq kaluh apek raah rôh pôôt xing para kôôch ku ni.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Tuôôy nưq, xôq tơơl hlê, Lôôk Jê-xu đnooy dii mư: “Nee dro khơl drê hơq, xuum tuôq ku mư kôt dik. Varơuq pheq jah jêêk ka mư tyauq đaji mư trôôch.” Ji koot kadrê ku mư jah payơh hlah xing wat nưq.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Atêq tuôôy chuh hooy klơlh dêh nưq, Lôôk Jê-xu hooy tyauq gah tahli Ga-li-lê, ji tuôôy tok tol muuyq ngok đoot yôôch, Kadraq 'ngôôy aduq nưq. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Yôôch khơl bing manih karôp hooy tok dii Kadraq, e khơl dro tawe, dro apul, dro atul tâk, dro hôp, ji 'ngưng dro kadrơy kung dii oot. Khơl drơy xôq khơl dro nưq aduq jôôk Kadraq ji Kadraq payơh ka oot, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />pheq đnooy, bing manih karôp dơơp akêh tuôôy hloq dro hôôp đnooy ik, dro taqwauq tâk yôôych yơh hlah, dro tawe tawaak hooy ji dro apul 'yo hloq, yôôch oot ayuôôt laat Kơy Plêêk ku I-sơ-ra-ên.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Tuôôy nưq, atêq tuôôy taayh khơl xatyauq kadraq hlê, Lôôk Jê-xu đnooy: “Thơy biit angơuq dii manih karôp, vii oot heq kưq măn kung thơy pe hngơy yôôch đơu leh e kajoq xôq xa. Thơy leh trôôch ăm oot xuq klaak pangoot, leh kheoq oot hnoq phoch langoch tyauq trôôk.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Khơl xatyauq tơơl kung Kadraq: “Đom wăngq we yôôych xing leq vlôh 'ngưng tôôp đanưq xôq 'wot ăm bing manih karôp đa hơq xa phiq?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Lôôk Jê-xu đnooy dii oot: “Oh ay e taleq poop tôôp?” Yôôch oot tơơl: “Pơh poop tôôp, ji taleq poop ka de.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Ji atêq tuôôy patăk ka manih karôp 'ngôôy pôôt tol vari, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Kadraq adrơk pơh poop tôôp kung taleq poop ka, ji atêq tuôôy kuh qwaay, Kadraq pleelh vlôh ăm ka khơl xatyauq, yôôch khơl xatyauq ahlook ka manih karôp. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Manih karôp raay xa ji jah phiq phơh. Oot anguk hlê pơh vuk atar viik phon raah ku kaluh apek rah. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Tuôôy nưq, sôôq dro xa laa poot ravơu khơl kanau, leh jauq khơl drê ji oh de. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Tuôôy heq ăm manih karôp xuq, Kadraq muut đom ge ji hooy truh dêh Ma-ga-đan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Atêq tuôôy truh jeq, khơl manih Pha-ri-si ji Sa-đu-sê — atoh 'yo Kadraq — heq vôôch Kadraq kahnoq ka oot muuyq dơuq akêh xing plêêk. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Bơh tuôôy tơơl hlê, Kadraq đnooy dii oot: [“Tuôôy truh rayôôp klôôy, êêp kơy đnooy: ‘hngơy plêêk kaxay, vii plêêk dôôp.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Xaroq meel hngơy neng yôôych đnooy: ‘hngơy plêêk khiel jit, vii plêêk dôôp, u jaluk.’ Tabơh êêp kơy xet kahra ik phôôm plêêk, bơh leh e paraat xet truh kaluh dơuq hlêêl ku đơơy xanưm.”] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />“Muuyq rong nooy xơk tauq ji apuq atrăp akhiim axek dơuq akêh, bơh dơuq akêh hnoq be jah kahniq ka ni, đêh vlôh dơuq akêh ku Jô-na.” Ji tuôôy ka'lăk oot hlê yôôch, yôôych Kadraq hooy klơlh.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Măn khơl xatyauq yôôych heq tawol adrơk tyauq tôôp, atêq tuôôy hooy truh gah pi hơq. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Tuôôy nưq, Lôôk Jê-xu đnooy dii oot: “Dayh rơơt rol ji văch 'yo truh tape ku khơl manih Pha-ri-si ji Sa-đu-sê.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Anưq bơh, oot kưq tayaat tagêh dii mamuuyq đaneq: “Nưq laa vii haay heq leh adrơk tyauq tôôp.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Bơh tuôôy xet varơuq neq, Lôôk Jê-xu đnooy: “Khơl dro axit xuum tuôq hơq, aleq oh ay tayaat tagêh dii mamuuyq đaneq nưq laa kơq haay leh e tôôp? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Oh ay kung koq lưp hlolh ji kung leh văch dăp poop tôôp ka dăp ravơu dro yôôch oh ay heq tôôch anguk jah taleq vuk atar ih? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Long pơh poop tôôp ka poot ravơu dro, yôôch oh ay heq tôôch anguk jah taleq vuk atar ih? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Dơơp đaleq đơu oh ay leh hlolh ik đaneq thơy heq be đnooy dii oh ay truh tôôp? Bơh dayh văch 'yo truh tape ku khơl manih Pha-ri-si ji Sa-đu-sê.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Tuôôy nưq oot hlolh xet đaneq Kadraq leh dăt oot văch 'yo truh tape ku tôôp, bơh laa truh trôôk pato ganuun ku khơl manih Pha-ri-si ji Sa-đu-sê.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Tuôôy nưq, atêq tuôôy hooy truh dih dêh theng Sê-sa-rê Phi-lip, Lôôk Jê-xu heq vôôch khơl xatyauq kadraq, đaneq: “Khơl drơy đnooy Koot Manih laa kơyq?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Yôôch oot tơơl: “Muuyq sôôq dro đnooy laa Jăng Bap-tit; măn muuyq sôôq đnooy laa Ê-li; đơu sôôq kadrơy yôôych đnooy laa Jê-rê-mi long muuyq đom khơl hnhư hlit.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Kadraq đnooy kung oot: “Măn oh ay đnooy thơy laa kơyq?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Anưq laa, tuôôy tơơl hlê, Si-môn Phi-e-rơ tơơl: “Thơy laa Lôôk Wơơt Dêh, Koot Kơy Plêêk hloay riirh.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Tuôôy nưq, tuôôy tơơl hlê, Lôôk Jê-xu đnooy dii kơy: “Si-môn, koot Jô-na, ay e vanong dik, vii be aalq xăk ji vahaap heq kahnoq ka ay, bơh laa Vaq ku thơy tol daak plêêk. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Măn thơy kung đnooy dii ay đaneq ay laa Phi-e-rơ, ji tol talaat phơu neq, thơy hnoq xơy panưk tayuup vah ku thơy, ji kaluh 'mok ku âm phuh hnoq be tachơơl hlê ik tayuup nưq. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Thơy hnoq pahnăp ka ay kaluh gay kal ku daak dêh daak plêêk, long varơuq kajoq ay vek 'laarq vari yôôych hnoq jah vek tol daak plêêk, ji long varơuq kajoq ay luh 'laarq vari yôôych hnoq jah luh tol daak plêêk.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Atêq nưq, Kadraq leh ăm pheep khơl xatyauq xôq oot leh đnooy dii kơyq đaneq Kadraq laa Lôôk Wơơt Dêh.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Xing kawat nưq, Lôôk Wơơt Dêh Jê-xu xarôp ăm khơl xatyauq ku kadraq xet đaneq Kadraq duh pheq hooy truh Jê-ru-sa-lem, ji chiuq 'ngưng pơl dal xing aduq khơl draq, khơl thơy tơơk tưp kôt kung khơl thơy pato ganuun, yôôch biq păk kaxêêt ji jah khienq riirh hlê muut hngơy thưq pe. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Ji atêq tuôôy jarooy Kadraq vlôh muuyq panưh, Phi-e-rơ xarôp trek Kadraq, đaneq: “Lôôk lơơy, Kơy Plêêk kahnoq xuum biit angơuq dii thơy. Varơuq nưq hnoq be e leq xalih truh ka thơy.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Bơh wih katoor hlê, Kadraq đnooy dii Phi-e-rơ: “Sa-tan hơq, dayh chuh klơlh pi têq Gô! Ay laa kuk phơu dơơp xatôôlh jôôk ka thơy, vii ay leh xôq xuum truh kaluh varơuq ku Kơy Plêêk, bơh laa kaluh varơuq ku khơl drơy.” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Atêq nưq, Lôôk Jê-xu đnooy dii khơl xatyauq ku Kadraq: “Atoh kơyq trôôch hooy tyauq atêq thơy, yôôych dro nưq pheq chôôyq ka'lăk kadih xăk, kung hlôôy gay charăk ku xăk ji tyauq thơy. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Vii long kơyq trôôch wơơt xăk riirh ni yôôych hnoq hlơơp ni, măn dro leq hlơơp xăk riirh ni vii kơq thơy yôôych hnoq axek jah ni. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Vii muuyq dro hnoq jah ka ik kajoq atoh deng jah dêq dêh araak, bơh biq hlơơp varơuq riirh ni? Long muuyq dro hnoq ăm varơuq kajoq đom varơuq tađôôy hlê varơuq riirh ni? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Vii Koot Manih jeq truh đom tađnah tađnaak ku Vaq Kadraq kung dii yaak plêêk Kadraq. Ji muut tuôôy nưq, Kadraq hnoq bla ka tôôy dro 'yo tyauq varơuq dơơp ku oot. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Dong dik, thơy đnooy dii oh ay đaneq e taleq dro đong dưk neq, laa khơl dro kajưk dik hnoq leh dalơh hlê varơuq kaxêêt dong truh tuôôy dong leq oot hloq Koot Manih truh đom daak dêh Kadraq.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Drơu hngơy atêq, Lôôk Jê-xu jarooy tyauq Phi-e-rơ, kung Ja-kơ ji Jăng, ma oh kơy, yôôch Kadraq jarooy đêh oot kung mamuuyq tok truh muuyq ngok đoot yơơt. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Kaveeh pi gôk ku Kadraq jah tađôôy kangưưr oot, ji mot Kadraq xaraar tađnah đaji mot hngơy, măn aau Kadraq vlôh tađnah ploat đaji xaraar tađnah. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ji 'yo hơq, Môi-se kung Ê-li rama vlôh kangưưr oot, athêêk tajauq dii Kadraq. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Tuôôy nưq, tuôôy tơơl apok, Phi-e-rơ tơơl dii Lôôk Jê-xu: “Kuh Lôôk, dik laa tolh ka haay xôq măn aduq neq. Atoh thơy trôôch, gô hnoq panưk aduq neq pe poop rap — muuyq ka thơy, muuyq ka Môi-se ji muuyq ka Ê-li.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Đom tuôôy kơy đong măn đnooy, yôôych 'yo hơq, muuyq đum kluk tađnah klưng đơ klum oot, ji 'yo nee, muuyq apok xanoh xing aduq đum kluk, đaneq: “Neq laa Koot xung xiaq ku Gô, đơu Gô thier hlah xuum aduq Koot. Dayh tameng tyauq Koot nưq.” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Tuôôy tameng yôôch, khơl xatyauq kul kanăp mot ji thier raa yôq varaal. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yôôch Lôôk Jê-xu, atêq tuôôy hlê jeq ji vêq muut oot, heq đnooy: “Dayh dưk tok ji te yôq varaal.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Bơh tuôôy 'ngơơk mot oot tok, oot leh hloq kơyq đêh vlôh muuyq dro Lôôk Jê-xu.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Đong tuôôy oot xing tol đoot hooy pôôt, Lôôk Jê-xu patăk dăt oot, đaneq: “Te taboon hlê varơuq heq hloq dii kơyq dong truh tuôôy Koot Manih heq xing aduq kaxêêt riirh hlê.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Khơl xatyauq nưq vôôch Kadraq, đaneq: “Anưq vii aleq khơl thơy pato ganuun đnooy laa Ê-li duh pheq truh adroyq?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Tuôôy nưq, tuôôy tơơl apok, Kadraq đnooy: “Tabơh Ê-li pheq truh ji hnoq ta'meq hlê tôôy varơuq. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Bơh thơy đnooy dii oh ay đaneq Ê-li heq truh yôôch, ji oot heq be 'yo vlôh kơy. Tađôôy muut đnư, oot dơơp đuh dêq tôôy kajoq oot trôôch dii kơy. Kung muuyq đanưq, Koot Manih jeq pheq chiuq pơl xing oot.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Tuôôy nưq, khơl xatyauq hlolh đaneq Kadraq đnooy dii oot truh Jăng Bap-tit.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Tuôôy heq truh kung bing manih karôp, muuyq dro khơl kanau heq truh jeq Kadraq, kul takuul pôôt kangưưr Kadraq <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />ji tơơl: “Lôôk lơơy, biit angơuq rơy koot kanau gô, vii ni tavơh bingq adruôy ji biq pơl paq ik, vii ni 'ngưng gưlh muut ôôlh, ji 'ngưng gưlh pôôt daak. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Gô heq jarooy ni truh ka khơl xatyauq ku Kadraq, bơh oot leh e paraat payơh ik ka ni.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Tuôôy nưq, tuôôy tơơl hlê, Lôôk Jê-xu đnooy: “Rong nooy be tuôq ji xơk tauq hơq, gô hnoq măn dii êêp dong truh tuôôy leq? Gô hnoq tachiuq êêp dong truh dong leq? Dayh xagook ôn nưq truh đnen ka gô.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Lôôk Jê-xu xanoh toah ni, yôôych kamuuych hooy vlôh klơlh ôn nưq, ji ôn jah payơh xing wat nưq.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Atêq nưq, atêq tuôôy tavơh đêh dii Lôôk Jê-xu, khơl xatyauq tơơl: “Vii kakơq kajoq 'wot leh ik druyh ni vlôh ik?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Yôôch Kadraq đnooy dii oot: “Kơq xuum tuôq ravoch ku oh ay. Vii dong dik, thơy đnooy dii oh ay, atoh oh ay e xuum tuôq đaji muuyq kalook kaxeq avơy, yôôych oh ay hnoq dăt ka ngok đoot neq: ‘Dayh katơơk tok xing aduq neq vlôh aduq hơq,’ yôôych ni hnoq katơơk hooy, ji hnoq be e kajoq laa be ik đôôyq dii oh ay.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Bơh kaluh kamuuych neq be biq druyh vlôh atoh leh bơơn varơuq apôôy ji deek xa.]<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Tuôôy nưq, đom tuôôy oot anguk mamuuyq hlê aduq Ga-li-lê, Lôôk Jê-xu đnooy dii oot: “Koot Manih jeq biq atăq muut ti khơl drơy, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ji oot hnoq păk kaxêêt Kadraq hlơơp, yôôch muut hngơy thưq pe, Kadraq hnoq jah khienq riirh hlê.” Khơl xatyauq vlôh thier raa hlu rơu.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Tuôôy nưq, tuôôy oot heq hooy truh theng Ka-bê-na-um, khơl dro xok xơu hnhư hơu truh kung Phi-e-rơ ji vôôch: “Thơy ku ay leh noop xơu hnhư hơu ih?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Kơy tơơl: “E.” Ji tuôôy muut đom hnhư yôôch, Lôôk Jê-xu heq tok apok dii kơy adroyq, đaneq: “Si-môn, ay biit kajoq nưq? Khơl vuua tol vari xok phiq long xơu xing kơyq? Xing koot xau oot long xing dro kadrơy?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Atêq tuôôy tơơl: “Xing adro kadrơy”, Lôôk Jê-xu đnooy dii kơy: “Anưq koot xau yôôych jah leh huq. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Bơh xôq haay leh dơơp gưlh lôp ka oot, yôôych tuôôy hooy vlôh tahli, ay dayh qwel ahlaay ji duuy poop ka tok adroyq dik. Atêq tuôôy pahah huuy ni vlôh, ay hnoq hloq muuyq xiêk-lơ. Xok jah jêêt nưq yôôch, dayh noop ka oot tyauq dii phon ku thơy ji ay.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Muut wat nưq, khơl xatyauq truh jeq Lôôk Jê-xu, tơơl: “Atêq dik yôôych kơyq laa kôt iaq dêq đom daak dêh daak plêêk?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Yôôch atêq tuôôy taayh muuyq oh de truh dii kadraq, Kadraq xôq ôn măn katul oot <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />ji đnooy: “Dong dik, thơy đnooy dii oh ay, atoh oh ay leh jah tađôôy đơơu ji vlôh jêêk đaji khơl oh de, yôôych kajưk dik oh ay hnoq leh hooy muut đom daak dêh daak plêêk. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Anưq, paq kê kơyq apôôt xăk pôôt dang đaji oh de neq, yôôych dro nưq laa kôt iaq dêq đom daak dêh daak plêêk. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Atoh kơyq taayh yal thơy tiip muuyq oh de đaji luneq, yôôych dro nưq tiip rươk thơy. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Bơh dro leq dơơp lôp kadrôôp ka muuyq đom khơl dro de dik neq, nưq laa khơl dro tuôq aduq thơy, yôôych varơuq tơơl iaq ka dro nưq 'ngưq laa muuyq apal xay deng ka lưưa jah vek rawiit ranong ni, yôôch ni biq panheet karăp pôôt tahli jaruq.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Ra ơơh ka dêh araak vii kơq kaluh kajoq dơơp gưlh lôp! Bơyh vii ưng kajoq dơơp gưlh lôp pheq truh laa varơuq pheq xalih truh, tabơh anưq, ra ơơh hloay ka dro đơu kơq dơơp gưlh lôp truh xing ado nưq! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Mot kadrơy, atoh ti long jôôk oh ay dơơp ka oh ay lôp kadrôôp, dayh dool ka'lăk ni ji qweek xangưưy klơlh oh ay. Nưq laa varơuq kaxay ka oh ay xôq biq atul ti long atul jôôk yôôch muut đom varơuq riirh iaq laa tuôôy e vaarq ti long vaarq jôôk xôq yôôch biq qweek muut đom ôôlh đơơy đơơy. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Atoh mot oh ay dơơp ka oh ay gưlh lôp, dayh galek ni vlôh ji avih xangưưy klơlh oh ay. Nưq laa varơuq tolh ka oh ay xôq vơ măn muuyq mot yôôch muut đom varơuq riirh, iaq laa tuôôy e vaarq mot xôq yôôch biq qweek muut ôôlh karuk. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Dayh văch 'yo, oh ay be duh 'yo leh ra kajoq muuyq đom khơl dro de dik neq. Vii thơy đnooy dii oh ay đaneq yaak plêêk ku oot tol plêêk hloay hloay 'yo hloq mot Vaq thơy tol daak plêêk. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Vii Koot Manih heq truh xôq wơơt dro biq hyaak hlơơp.] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Oh ay biit aleq? Atoh muuyq dro hơq e muuyq hreek poop trưưu, đơu muuyq đom sôôq oot biq hyaak, yôôych be aalq atêq tuôôy xôq hlê xit kưl xit poop tol adroay đoot ji hooy axek, dro nưq akhiim axek poop trưưu biq hyaak be aalq? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Atoh dro nưq hnoq ik axek hloq ni, yôôych dong dik, thơy đnooy dii oh ay đaneq dro nưq hnoq hlah hlaak truh ni iaq laa truh xit kưl xit poop trưưu leh biq hyaak. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Dang anưq, iq trôôch kangưưr Vaq tol daak plêêk ku oh ay leh aalq laa xôq muuyq đom khơl dro de dik neq biq hư hlơơp.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Mot kadrơy, atoh muuyq dro oh ay ku oh ay lôp kadrôôp dii oh ay, dayh hooy, dayh hooy đnooy vlôh ka dro dii oh ay dii dro nưq đơu heq. Atoh dro nưq tameng tyauq oh ay, yôôych oh ay jah hlê dro oh ay haay. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Bơh atoh dro nưq leh tameng tyauq dayh jarooy tyauq haay muuyq long vaarq dro đnoyq xôq ka gamưh huuy ku vaarq long pe dro dơơp xanưk yôôych tôôy apok hnoq ik 'yo nhonq. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Măn atoh dro nưq leh chiuq tameng tyauq oot, dayh đnooy vlôh ka tayuup vah. Đơu atoh dro nưq kung leh chiuq tameng tyauq tayuup vah, yôôych đôôyq dii oh ay, dro nưq pheq đnooy pheq đaji laa tamooy kadrơy ji dro xok xơu. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Dong dik, thơy đnooy dii oh ay, atoh oh ay vek paq kê varơuq kajoq 'laarq vari, yôôych varơuq nưq hnoq biq vek tol plêêk; ji atoh oh ay luh paq kê varơuq kajoq măn 'laarq vari, yôôych varơuq nưq hnoq jah luh tol plêêk. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Muuyq yưk tra, dong dik, thơy đnooy dii oh ay đaneq atoh vaarq dro đom oh ay muuyq xuum dii mamuuyq 'laarq vari truh tôôy varơuq kajoq đơu long oot apôôy vôôch, yôôych varơuq nưq hnoq jah dơơp jêêk ka oot xing Vaq thơy tol daak plêêk. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Vii aduq leq e vaarq long pe dro jah anguk hlê đom yal thơy, yôôych thơy măn aduq nưq katul oot.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Atêq nưq, atêq tuôôy truh jeq, Phi-e-rơ tơơl dii Kadraq: “Kuh Lôôk, muuyq dro oh ay gô hnoq lôp kadrôôp tachơơl dii gô ji gô hnoq tha ka ay nưq taleq yưk? E jơq truh pơh yưk be?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Lôôk Jê-xu đnooy dii kơy: “Thơy leh đnooy dii ay truh pơh yưk, bơh laa truh pơh kưl yưk pơh. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Vii kakơq neq, daak dêh daak plêêk hnoq ik ta 'yo đaji muuyq dro dơơp vuua, đơu dro nưq xung 'yo jauq rahlăp jơyq dii khơl xapok kơy. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Tuôôy nưq, tuôôy vuua xarôp jauq sôôh, muuyq dro elôôkq kưl ravơu ta-lâng jah jarooy truh ka vuua. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Bơh dro nưq leh e kajoq bla, lunưq vuua heq patăk ka ay nưq pheq biq tek, kung kadrê, koot ji dêq hloay tôôy kajoq ni e, yôôch bla lôôkq. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Anưq laa atêq tuôôy gưlh riêp pôôt, dro xapok nưq kul kangưưr vuua, tơơl: ‘Kôôch lơơy, apôôy xôq axit hngơy ka gô, yôôch gô hnoq bla hlê kadraq dêq hloay.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Tuôôy nưq, bơyh xuum biit angơuq, kôôch ku adro xapok nưq heq luh tha ji ka'lăk lôôkq ka ay nưq. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Bơh tuôôy vlôh pi gôk yôôch, adro xapok nưq tavơh muuyq đom khơl dro kung xapok dii ni, laa dro elôôkq ni muuyq hreek đơ-ni-ê, ji atêq tuôôy rôp jư dro nưq, ni boop ranong, dăt: ‘May elôôkq kajoq yôôych bla yơu.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Anưq laa, atêq tuôôy kul pôôt, dro kung xapok dii ni apôôy ratuôôt ni, đaneq: ‘Apôôy xôq axit hngơy ka gô, yôôch gô hnoq bla hlê ay.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Bơh ay nưq leh chiuq. Tađôôy muut đnư, tuôôy dưk hooy, ni dăt rôp dro hơq muut tu dong truh tuôôy ay nưq bla dêq sôôq jêêt elôôkq. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Anưq, atêq tuôôy hloq varơuq heq xalih vlôh, khơl dro kung xapok ku ni thier jiq xuum. Tuôôy hooy truh yôôch, oot tơơl hlê tôôy varơuq dii kôôch oot tôôy varơuq heq xalih vlôh. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Atêq nưq, atêq tuôôy patăk ka adro xapok nưq truh, kôôch ku ni đnooy dii ni: ‘Adro xapok xơk tauq hơq, gô heq tha dêq lôôkq nưq ka ay vii ay heq apôôy vôôch gô. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Varơuq kung duh dơơp deng ka ay leh aalq laa biit angơuq dro kung xapok dii ay, kung đaji gô heq biit angơuq ay, be aalq?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Bơyh biq dơơp jaraq đanưq, kôôch ku ni heq pahnăp ni ka bing tiel dook dong truh tuôôy ni bla dêq tôôy kajoq elôôkq. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Vaq tol plêêk ku thơy kung hnoq dơơp hlê dii oh ay tyauq trôôk đanưq, atoh tôôy dro đom oh ay leh tha kadrôôp ka dro oh ay ku haay dik xing xuum klaak haay.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Varơuq xalih vlôh laa tuôôy Lôôk Jê-xu heq đnooy yôôch kaluh apok nưq, Kadraq chuh klơlh Ga-li-lê ji hooy truh dêh Ju-đê măn pi hơq tavook daak Jô-đanh. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Bing manih karôp tyauq Kadraq ji Kadraq payơh bingq ka oot aduq nưq.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Taleq dro Pha-ri-si hlê jeq Kadraq, thưh Kadraq ji tơơl: “E long leh ăm pheep muuyq dro khơl kanau ka'lăk kadrê ni vii paq kê kakơq leq?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Tuôôy tơơl apok, Kadraq đnooy: “Êêp kơy koq lưp đok đaneq Kơy panưk pajêêk xing tuôôy kapa tep heq panưk vlôh oot, muuyq khơl kanau ji muuyq khơl drê, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ji xanoh: ‘Bơyh kơq nưq, khơl kanau hnoq vlôh klơlh vaq ji miq đơu xamăn dii kadrê ni, ji dêq baarq hnoq laa muuyq hlek’ be aal? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Pheq đnooy, oot leh măn laa vaarq, bơh laa muuyq hlek. Kơq nưq, varơuq đơu Kơy Plêêk heq takhiit hlê, yôôych koot manih leh ik aklah vlôh.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Oot tơơl dii Kadraq: “Anưq, vii aleq Môi-se heq đnooy pato dăt pheq ăm hla jơyq ka'lăk kadrê yôôych ka'lăk kadrê?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Kadraq tơơl oot đaneq: “Vii varơuq găk xuum ku êêp kơy đơu Môi-se heq ăm pheep êêp kơy ka'lăk kadrê êêp, bơh xing kapa tep, varơuq nưq leh aalq laa đanưq. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Bơh gô đnooy dii êêp kơy đaneq đêh vlôh vii kadrôôp apuq atrăp, dro leq ka'lăk kadrê ni yôôch xok dro kadrơy yôôych lôp kadrôôp tuut taak; dro xok manih heq biq ka'lăk kung lôp kadrôôp tuut taak.” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Khơl xatyauq tơơl dii Kadraq: “Atoh ka varơuq ku adro khơl kanau kung dii kadrê ni laa đanưq, yôôych yơu iaq leh xok kadrê kanau.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Bơh Kadraq đnooy dii oot: “Leh aalq dêq hloay hnoq ik đoonq nhonq apok neq, bơh laa deng ka khơl leq đơu varơuq nưq jah kahniq ăm. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Vii e khơl dro thoon, laa khơl dro jah pa iir vlôh xing đom klaak miq heq anưq; e khơl dro thoon đơu biq khơl drơy dơơp ăm thoon; ji e khơl dro thoon laa khơl dro kadih dơơp thoon kadih ni vii kơq daak dêh daak plêêk. Kơyq hnoq ik đoonq nhonq apok neq, dro nưq dayh đoonq nhonq.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Atêq nưq, khơl on oh de jah jarooy truh ka Kadraq xôq Kadraq xôq ti tol oot ji apôôy, bơh khơl xatyauq toah oot. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Lunư, Lôôk Jê-xu dăt: “Dayh xôq ka khơl on oh truh dii thơy, ji te klơl jư oot, vii daak dêh daak plêêk laa ku khơl dro đanưq.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Atêq tuôôy xôq ti tol oot, Kadraq xing nưq dưk hooy.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ji 'yo hơq, muuyq dro hơq tuôôy truh jeq Kadraq, heq đnooy: “Thơy lơơy, gô pheq dơơp varơuq kaxay kajoq xôq gô e jah varơuq riirh đơơy đơơy?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Yôôch Kadraq đnooy dii ay: “Aleq ay vôôch gô truh varơuq kaxay? Vơ muuyq Kơy laa tamaq kaxay, măn atoh ay trôôch muut đom varơuq riirh, yôôych dayh jư kaluh ganeen.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Dro nưq tơơl dii Kadraq: “Kaluh ganeen leq?” Yôôch Lôôk Jê-xu dăt: “Te păk kaxêêt manih, te lôp kadrôôp apuq atrăp, te atôk, te dơơp xanưk pa ôôh, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />dayh e xuum xung miq ji vaq, ji xung xiaq manih gah gih ku ay đaji xăk xamơk ay.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Ay blaay nưq tơơl dii Kadraq: “Gô heq tameng jư dêq hloay kaluh varơuq nưq. Gô măn thiuq varơuq kajoq đnoyq?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Lôôk Jê-xu đnooy dii ay: “Atoh ay trôôch jah xaleep, dayh hooy, dayh tek kaluh kajoq ay e yôôch ăm hloh ka dro adrah, yôôych ay hnoq e kho bauq tol daak plêêk; ji dayh tyauq gô nee!” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Bơh tuôôy tameng apok nưq yôôch, ay tadăp blaay heq ka'lăk hooy vii hlu rơu, bơyh ay nưq 'miêh đong e thier 'ngưng garuh anôôp.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Tuôôy nưq, Lôôk Jê-xu đnooy dii khơl xatyauq kadraq: “Dong dik, thơy đnooy dii oh ay đaneq: manih karoh hnoq muut đom daak dêh daak plêêk muuyq trôôk thier pơl. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Đơu thơy laay đnooy kung oh ay, xôq ôô laak đa chun hlê troop jarưp laa varơuq măn klêq iaq taso dii manih karoh muut đom daak dêh ku Kơy Plêêk.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Tuôôy nưq, atêq tuôôy tameng anưq, khơl xatyauq thier akêh, tơơl: “Anưq yôôych kơyq hnoq ik jah wơơt?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Damưnq 'yo oot, Lôôk Jê-xu đnooy kung oot: “Dii koot manih, varơuq neq laa leh ik, bơh dii Kơy Plêêk, tôôy varơuq yôôych hnoq ik.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Tuôôy nưq, xôq tơơl hlê, Phi-e-rơ đnooy dii Kadraq: “Thơy 'yo hơq, 'wot heq ka'lăk dêq hloay ji tyauq thơy. Anưq yôôych hnoq e varơuq kajoq deng ka 'wot?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Yôôch Lôôk Jê-xu đnooy dii oot: “Dong dik, thơy đnooy dii oh ay, đaneq oh ay, 'ngưq laa khơl dro heq tyauq thơy, đom xanưm tađôôy đơơu, tuôôy Koot Manih 'ngôôy tol ngôôy tađnah tađnaak kadraq, yôôych oh ay kung hnoq 'ngôôy tol kưl vaarq ngaai, xưh xadrah kưl vaarq adrơơk tamooy I-sơ-ra-ên. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Tôôy dro, 'ngưq laa long kơyq heq ka'lăk hnhư wah, oh ay, ay oh, vaq, miq, kadrê, koot long vari ruôngq vii kơq yal ku thơy, hnoq nhonq gôp muuyq hreek yưk ji jah nhonq varơuq riirh đơơy đơơy. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Bơh 'ngưng dro adroyq dik hnoq vlôh atêq lôôch, ji khơl dro atêq lôôch hnoq vlôh adroyq dik.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Vii daak dêh daak plêêk yôôych dang đaji muuyq dro kôôch vari, laa dro hooy vlôh muut ka xaroq meel xôq xapo manih dơơp hngơy ka hluôôt nho kơy. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Tuôôy nưq, atêq tuôôy heq athêêk kung khơl dơơp hngơy dii muuyq đơ-ni-ê ka muuyq hngơy, kơy patăk oot muut hluôôt nho ku kơy. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Ji tuôôy hooy vlôh muut kawah wat thưq pe, kơy hloq sôôq kadrơy đong dưk măn hloh đom aduq tabôôt xa. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Kơy đnooy dii oot: ‘Khơl ay kung dayh muut đom hluôôt nho, ji jêêt hngơy taleq laa taxưngq, yôôych gô hnoq bla ka êêp ay.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Yôôch oot hooy tyauq. Atêq tuôôy laay hooy vlôh muut kawah wat thưq drơu ji thưq xit, kơy kung dơơp đanưq. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Anưq yôôch, tuôôy hooy vlôh đom kawat thưq kưl muuyq, kơy 'yo hloq sôôq kadrơy đong dưk, ji kơy đnooy dii oot: ‘Aleq êêp ay dưk măn hloh dêq hngơy ka đnen?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Oot tơơl dii kơy: ‘Vii be kơyq xapo 'wot.’ Kơy đnooy dii oot: ‘Êêp ay kung dayh hooy muut đom hluôôt nho.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Yôôch truh rayôôp klôôy, kôôch hluôôt nho dăt dro jư 'yo ku kơy: ‘Dayh taayh khơl dơơp hngơy truh ji bla jêêt hngơy dơơp ka oot, xarôp xing khơl lôôch dik dong truh khơl adroyq dik.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Atêq tuôôy tawaak truh, khơl dro jah xapo muut kawah wat thưq kưl muuyq, tôôy dro nhonq jah muuyq đơ-ni-ê. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Măn khơl dơơp hngơy adroyq dik, tuôôy tawaak truh, heq biit đaneq oot hnoq nhonq 'ngưng iaq, đơu oot kung nhonq muuyq đơ-ni-ê ka tôôy dro. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Bơh atêq tuôôy nhonq yôôch, oot ramooy truh manih kôôch vari, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />đaneq: ‘Khơl dơơp hngơy atêq lôôch nưq heq dơơp varơuq muuyq wat, đơu kôôch xôq oot muuyq ja dii 'wot, laa khơl dro heq chiuq galeh galal ratuôôt ka hngơy kung dêh tôq jaq kađuh.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Bơh tơơl hlê, dro kôôch đnooy dii muuyq dro đom bing oot: ‘Nee ay hơq, gô leh e xa dơơp têq dii êêp ay. Be aalq êêp ay heq chiuq dii gô muuyq đơ-ni-ê be aalq? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Dayh xok phon ku ay ji hooy yơu. Măn gô yôôych trôôch ăm ka khơl dro lôôch neq kung dang đaji ka ay. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Be aalq e pheep ka gô xôq dơơp varơuq gô trôôch dii kaluh kajoq ku gô? Long mot ay yôôych be chiuq vii gô e xuum kaxay?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Dang anưq, dro lôôch dik hnoq vlôh droyq dik ji dro droyq dik hnoq vlôh lôôch dik.”<verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Đong tuôôy hooy tok theng Jê-ru-sa-lem, Lôôk Jê-xu jarooy tyauq kưl vaarq khơl xatyauq đêh dii kadraq, ji tol trôôk hooy, Kadraq đnooy dii oot: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“'Yo nee, haay đong hooy tok truh Jê-ru-sa-lem, ji Koot Manih hnoq biq rôp atăq ka khơl thơy tơơk tưp kôt ji khơl thơy pato ganuun, yôôch oot hnoq rôp xadrah păk kaxêêt Kadraq <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />ji hnoq pahnăp Kadraq ka kaluh tamooy kadrơy xôq oot 'yo xagiel, hmơt tiel, ji đongq đing Kadraq tol gay charăk. Yôôch muut hngơy thưq pe, Kadraq hnoq riirh hlê.”<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Tuôôy nưq, miq ku vaarq koot kanau Xê-bê-đê kung dii khơl koot mo truh jeq Kadraq, kul kuh ji apôôy vôôch muuyq varơuq xing Kadraq. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Yôôch Kadraq đnooy dii mo: “Mư trôôch varơuq kajoq?” Mo tơơl dii Kadraq: “Apôôy patăk ăm ka vaarq dro koot kanau neq ku gô, muuyq dro hnoq ik 'ngôôy măn pi akoh, ji muuyq dro măn pi akeng thơy đom daak dêh ku thơy.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Bơh tuôôy tơơl hlê, Lôôk Jê-xu đnooy: “Pe dro be xet êêp đong apôôy vôôch varơuq kajoq 'leq. Baarq oh ay hnoq ik hôôch dooy đơu thơy xung hôôch be?” Oot tơơl dii Kadraq: “'Wot hnoq ik.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Kadraq đnooy dii oot: “Tabơh oh ay hnoq hôôch dooy ku thơy, bơh xôq 'ngôôy măn pi akoh ji măn pi akeng ku thơy leh aalq laa varơuq ku thơy đinq, bơh laa deng ka khơl dro heq jah ralauq xôq xing Vaq thơy.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Atêq tuôôy tameng varơuq neq, kưl khơl xatyauq hơq tôq jaraq dii vaarq dro oh ay. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Bơh tuôôy heq taayh oot truh dii kadraq, Lôôk Jê-xu đnooy: “Oh ay xet đaneq khơl vuua lôôk ku kaluh tamooy daak kadrơy yôôych ahnanh ahnek manih dêh, ji khơl dro dơơp kôt yôôych xok qwuyen lưk tol khơl drơy. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Đom oh ay yôôych leh đanưq. Tađôôy muut đnư, atoh kơyq trôôch vlôh kôt đom khơl oh ay, yôôych dro nưq hnoq dơơp dro hơu varơuq ku oh ay, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />ji dro leq trôôch dơơp akoq đom oh ay yôôych hnoq dơơp xapok ku oh ay, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />pheq đnooy đaji Koot Manih heq leh truh xôq jah hơu varơuq, bơh laa xôq hơu varơuq, ji xôq tưp xăk riirh kadraq đaji jaq bla xaloah ka 'ngưng manih.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yôôch tuôôy oot xing theng Jê-ri-kô hooy vlôh, muuyq bing manih karôp hooy tyauq Kadraq. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Ji 'yo hơq, vaarq dro apul đong 'ngôôy măn pi gah trôôk. Atêq tuôôy tameng đaneq Lôôk Jê-xu đong hooy dalơh hlê, oot taayh tok, đaneq: “Kuh Lôôk, koot vuua Đa-vik, apôôy biit angơuq rơy 'wot.” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Bơh manih karôp toah ka baarq, xôq oot hnhep yơu, anưq đơu oot laay taayh kôt iaq đnoyq, đaneq: “Kuh Lôôk, Koot vuua Đa-vik, biit angơuq rơy 'wot.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Tuôôy dưk hlê yôôch, Lôôk Jê-xu taayh oot truh ji đnooy: “Êêp ay trôôch gô dơơp kajoq ka êêp ay?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Oot tơơl dii Kadraq: “Kuh Lôôk, nưq laa apôôy ăm mot 'wot jah tađnah.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Tuôôy nưq, bơyh xuum biit angơuq, Lôôk Jê-xu vêq muut mot oot. Vơ hloay, oot jah tađnah mot hlê ji hooy tyauq Kadraq.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Tuôôy oot jeq truh theng Jê-ru-sa-lem, ji hooy truh Bê-pha-jê, wih xuq Đoot Ô-liu, tuôôy nưq Lôôk Jê-xu patăk vaarq khơl xatyauq, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />dăt oot: “Dayh hooy muut palơy pla kangưưr oh ay, yôôch oh ay hnoq hloq hloay muuyq ôô lưưa pi biq vek, kung muuyq ôô lưưa koot măn dii ni. Atêq tuôôy luh talơy vek, dayh duuy truh ka thơy. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Ji atoh muuyq dro leq nưq đnooy kajoq dii oh ay, yôôych oh ay hnoq đnooy đaneq: ‘Lôôk e kơn duh truh oot,’ yôôch dro nưq hnoq ăm hloay xôq oot hooy.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Mot kadrơy, varơuq neq xalih vlôh xôq ka apok heq jah xanoh gamưh hnhư hlit hnoq ik jah jêêk, đaneq:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Dayh dăt koot kadrê ku Si-ôn:</para>
  <para style="q1" vid="MAT 21:5">'Yo hơq, Vuua xăk truh kung xăk,</para>
  <para style="q1" vid="MAT 21:5">be huq ji acho lưưa</para>
  <para style="q1" vid="MAT 21:5">— nưq laa tol muuyq lưưa koot, koot ku lưưa pi.”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Tuôôy nưq, khơl xatyauq, atêq tuôôy hooy ji dưk dơơp dang đaji Lôôk Jê-xu heq pato oot, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />heq duuy lưưa pi kung lưưa koot xuq, ji hlơơk aau koot keek ku oot tol lưưa, yôôch Kadraq 'ngôôy tol nưq. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Tuôôy nưq, phon 'ngưng manih karôp hlơơk aau ku oot tol trôôk, măn muuyq sôôq kadrơy yôôych koh kaluh đook hla ji hlơơk vlôh tol trôôk. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Anưq yôôch, bing manih karôp hooy adroyq Kadraq ji tyauq atêq heq tarok tok, đaneq:</para>
  <para style="q1" vid="MAT 21:9">“Hô-sa-na Koot vuua Đa-vik!</para>
  <para style="q1" vid="MAT 21:9">Xưngq vanê ayuôôt Kơy truh đom yal Lôôk!</para>
  <para style="q1" vid="MAT 21:9">Hô-sa-na tol aduq yơơt lơyq!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Atêq tuôôy Kadraq muut đom theng Jê-ru-sa-lem, dêq ka theng biq diik miik, đnooy: “Nưq laa kơyq?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Anưq yôôych manih karôp tơơl: “Nưq laa Kơy hlit Jê-xu, xing Na-xa-ret, dêh Ga-li-lê.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Lôôk Jê-xu hooy muut đom hnhư hơu, yôôch Kadraq đuôôy dêq hloay khơl dro tabôôt tek đom hnhư hơu, ji tơơk kahlôôp para ku khơl tađôôy jêêt kung ragê ku khơl tabôôt xêêp katrơu. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Kadraq đnooy dii oot: “Apok heq jah valơk: ‘Hnhư Gô hnoq jah taayh laa hnhư apôôy,’ bơh êêp kơy heq dơơp ni jêêk aduq varoh atôk.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Yôôch khơl dro apul ji dro qwe truh jeq Kadraq đom hnhư hơu, ji Kadraq payơh ka oot. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Bơh khơl thơy tơơk tưp kôt ji khơl thơy pato ganuun, atêq tuôôy hloq kaluh varơuq akêh đơu Kadraq heq dơơp, ji hloq bing on oh vanê ayuôôt đom hnhư hơu, đaneq: “Hô-sa-na Koot vuua Đa-vik,” yôôych oot tôq jaraq. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Oot đnooy kung Kadraq: “Thơy e tameng oot đnooy kajoq be?” Bơh Lôôk Jê-xu tơơl oot: “E! Êêp kơy koq hmưq đok đaneq: ‘Lôôk heq ralauq 'miêh varơuq ayuôôt laat xing huuy ku khơl on oh ji khơl oh de măn uq,’ long aleq?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Atêq tuôôy chuh klơlh oot, Kadraq hooy vlôh klơlh theng truh Bê-tha-ni ji padơy hlê klôôy kađnư.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Truh xaroq, đong tuôôy wiit muut theng, yôôych Kadraq pangoot. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Atêq tuôôy 'yo hloq muuyq ưk pok puut gah trôôk, Kadraq hooy truh ưk nưq ji 'yo hloq be e kajoq tol nưq đêh vlôh hla ni heq. Kadraq xanoh dii ni: “Play be măn e aduq may đnoyq dong truh đơơy đơơy,” ji vơ hloay, ưk pok puut nưq yauq kateh. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Hloq đanưq yôôch, khơl xatyauq akêh, đnooy: “Dơơp đaleq đơu ưk pok puut heq vơ hloay yauq kateh?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Yôôch tuôôy tơơl apok, Lôôk Jê-xu đnooy dii oot: “Dong dik, thơy đnooy dii oh ay, atoh oh ay e xuum tuôq ji leh biit ravơq, yôôych oh ay hnoq dơơp ik leh vơ varơuq neq ka ưk pok puut, đơu pheq đnooy atoh oh ay đnooy dii đoot neq: ‘Dayh ik katơơk tok ji biq taweek pôôt tahli,’ yôôych varơuq nưq hnoq xalih vlôh. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Tôôy varơuq, paq kê kaluh varơuq leq oh ay apôôy vôôch đom apok apôôy, yôôych oh ay hnoq nhonq jah tuôôy tuôq gamưh.”<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ji tuôôy Kadraq muut đom hnhư hơu yôôch, khơl thơy tơơk tưp kôt kung khơl draq đom manih karôp heq truh tavơh Kadraq đong tuôôy Kadraq pato dayq, đnooy: “Gamưh taay yaak leq thơy dơơp kaluh varơuq neq, ji kơyq heq ăm ka thơy taay yaak nưq?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Bơh xôq tơơl apok, Lôôk Jê-xu đnooy dii oot: “Gô kung hnoq vôôch êêp kơy muuyq apok, đơu atoh êêp kơy hnoq ik tơơl apok gô, yôôych gô kung hnoq đnooy ka êêp kơy xet gô đong dơơp kaluh varơuq neq gamưh taay yaak leq. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Pheep bap-tem ku Jăng — pheep nưq laa xing leq? Xing plêêk long xing koot manih?” Anưq yôôch, oot đnooy athêêk dii mamuuyq, đaneq: “Atoh haay đnooy: ‘Xing plêêk,’ yôôych ni hnoq đnooy dii haay: ‘Anưq vii kakơq kajoq đơu êêp kơy leh tuôq jăng?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Măn atoh haay đnooy: ‘Xing koot manih,’ yôôych haay laay kamưưl manih karôp, bơyh dêq hloay oot 'yo Jăng laa muuyq hnhư hlit.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Atoh tuôôy tơơl apok Lôôk Jê-xu, oot đnooy: “'Wot leh xet.” Kadraq kung đnooy ka oot: “Gô kung leh ăm êêp kơy xet gô dơơp kaluh varơuq neq bơyh taay yaak leq. <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />Anưq bơh, êêp kơy biit aleq? Muuyq dro e vaarq koot kanau, ji atêq tuôôy truh dii dro adroyq dik, kơy đnooy: ‘Koot kanau, hngơy neng koot dayh hooy dơơp varơuq đom hluôôt nho.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Đơu tuôôy tơơl hlê, ni đnooy: ‘Koot leh trôôch,’ bơh atêq nưq, tuôôy heq tađôôy iq, yôôych ni hooy. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Măn atêq tuôôy truh tavơh dro thưq vaarq, dro vaq đnooy dang anưq. Yôôch, tuôôy tơơl apok, ni đnooy: ‘E koot, vaq lơơy,’ đơu dro nưq be hooy. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Kơyq đom vaarq koot kanau nưq heq dưk dơơp iq trôôch ku vaq baarq?” Oot tơơl: “Dro droyq dik.” Lôôk Jê-xu đnooy dii oot: “Dong dik, gô đnooy ka êêp kơy đaneq khơl dro xok xơu ji khơl drê xakwoah hooy muut đom daak dêh ku Kơy Plêêk adroyq êêp kơy. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Vii Jăng heq truh dii êêp kơy đom trôôk hooy hyioh jăk, đơu êêp kơy leh tuôq jăng. Măn khơl dro xok xơu ji khơl drê xakwoah yôôych tuôq jăng. Bơh êêp kơy, long 'yo hloq yôôch, heq be wiit xuum atêq nưq xôq tuôq kơy.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Dayh tameng muuyq apok atoh kadrơy. E muuyq dro kôôch vari, laa dro heq pêêt muuyq hluôôt nho, panưk paga rawiit hluôôt nưq, xiel troop raniaq lok đom nưq, panưk kadroak 'yo ji ăm khơl pêêt nho xapo ni, yôôch kơy hooy dêh xangưưy. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Tuôôy nưq, muut tuôôy xiêk weelh play jeq truh, kơy patăk taleq dro xapok kơy truh dii khơl pêêt nho xôq xok phon ưng lơơy ku kơy. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Đơu tuôôy rôp jư bing xapok ku kôôch yôôch, bing pêêt nho tiel dro neq, păk kaxêêt dro hơq, tiip phơu dro kadrơy. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Kơy laay patăk khơl xapok kadrơy truh, karôp iaq bing adroyq, đơu khơl pêêt nho xa dơơp oot dang đanưq. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Yôôch atêq lôôch, kơy patăk kadih koot kanau kơy truh kung oot, đaneq: ‘Oot hnoq 'yo yôq koot kanau kơy.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Bơh bing pêêt nho, atêq tuôôy hloq dro koot nưq, heq athêêk dii mamuuyq: ‘Neq laa adro dưk katôôl hlê. Nee, haay duh păk kaxêêt ni yôôch xok dêq vari hluôôt ku ni.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Tuôôy rôp jư dro koot yôôch, oot qweek vlôh khơl hluôôt nho ji păk kaxêêt. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Anưq, tuôôy dro kôôch hluôôt nho truh, kơy nưq hnoq dơơp kajoq dii bing pêêt nho nưq?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Oot tơơl dii Kadraq: “Kơy nưq hnoq dook kaxêêt bing xơk tauq hơq dong ra ơơh, yôôch hnoq ăm khơl dro pêêt nho kadrơy xapo hluôôt, laa khơl dro hnoq noop hlê ka kơy phon lơơy muut tuôôy xiêk weelh ku oot.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Lôôk Jê-xu đnooy dii oot: “Jơq be êêp kơy koq hmưq đok đom Rahlăp Vah:</para>
  <para style="q1" vid="MAT 21:42">‘Kuk phơu đơu khơl thơq xơy ka'lăk vlôh,</para>
  <para style="q1" vid="MAT 21:42">ni heq jah vlôh jêêk phơu duh dik ku gok hnhư.</para>
  <para style="q1" vid="MAT 21:42">Varơuq neq xalih truh xing Lôôk,</para>
  <para style="q1" vid="MAT 21:42">ji ni dik laa akêh đom mot haay?’<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Vii kakơq neq, gô đnooy dii êêp kơy đaneq daak dêh ku Kơy Plêêk hnoq biq xok hooy klơlh êêp kơy ji hnoq jah kahniq ka muuyq tamooy vlôh raak play ku daak dêh nưq. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Kơyq gưlh muut kuk phơu neq hnoq biq naat tapuk, măn kuk phơu rôh tol dro leq, ni hnoq kaxup naat dro nưq.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Atêq tuôôy tameng kaluh apok atoh ku Kadraq, khơl thơy tơơk tưp kôt ji khơl manih Pha-ri-si 'yo xet đaneq Kadraq đong đnooy truh oot. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Tuôôy axek trôôk rôp Kadraq, oot laay 'yo yôq manih karôp, vii manih karôp 'yo Kadraq laa muuyq kơy hlit.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Ji tơơl hlê, Lôôk Jê-xu muuyq yưk tra đnooy dii oot bơơn apok atoh, đaneq: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Daak dêh daak plêêk jah 'yo đaji muuyq dro laa vuua, đơu vuua nưq ralauq xôq waal pajêêk ka koot kanau kơy. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Vuua patăk khơl xapok ku kơy hooy xôq taayh khơl dro heq jah mơơy truh waal pajêêk, đơu oot leh trôôch truh. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Vuua laay dăt khơl xapok kadrơy, đaneq: ‘Dayh đnooy dii khơl dro heq jah mơơy: “'Yo hơq, gô heq adoot waal ku gô. Kaluh ôô bo ji ôô pôôq ku gô heq jah dơơp ôq, ji tôôy thưq heq xong dêq yôôch. Dayh truh dii waal xa.”’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Bơh oot ka'lăk hooy vii be tabông, dro neq vlôh ruôngq ni, dro hơq tabông truh varơuq tabôôt xa ku ni. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Đơu sôôq măn hlê, atêq tuôôy rôp jư khơl xapok ku vuua, yôôych heq đnooy ra ơơh ji păk kaxêêt. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Anưq yôôch, hnhư vuua biq dơơp tôq jaraq, lunưq atêq tuôôy patăk kuun kadraq hooy, kơy heq ăm păk kaxêêt bing păk kaxêêt manih nưq ji vuh theng ku oot. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Atêq nưq, vuua dăt khơl xapok ku kơy: ‘Tabơh waal pajêêk heq xong dêq, bơh khơl dro hmưq jah mơơy nưq yôôych leh taxưngq. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Anưq, dayh hooy truh kaluh trôôk kôt, yôôch atoh khơl ay tavơh paq kê taleq dro, yôôych dayh mơơy truh waal pajêêk.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Ji khơl xapok nưq, atêq tuôôy hooy vlôh aduq kaluh trôôk kôt, heq anguk dêq hloay khơl leq đơu oot tavơh, kaah khơl xơuq hloay khơl kaxay, yôôch aduq waal heq viik hach khơl dro jah taayh truh. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Bơh tuôôy muut xôq 'yo khơl manih 'ngôôy xa, vuua hloq muuyq dro hơq leh hlưp qwuân aau waal pajêêk. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Vuua đnooy dro nưq: ‘Nee 'wơyq, dơơp đaleq ay muut đnen tuôôy leh e qwuân aau waal pajêêk?’ Bơh dro nưq tangư hnhep. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Atêq nưq, vuua dăt khơl xapok: ‘Dayh vek jôôk ti ku dro neq hlê yôôch qweek ni muut aduq kamơng jaluk pi gôk hơq, aduq hnoq e varơuq nhim ook ji takik kaneeng.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Vii 'ngưng dro jah taayh, bơh axit dro jah rơơlh.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Tuôôy nưq, atêq tuôôy ka'lăk hooy, khơl manih Pha-ri-si athêêk xôq vih 'yo đaleq ka oot hnoq ik anơk xađook Kadraq đom apok đnooy. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Oot dăt khơl Xatyauq oot, kung khơl dro thuôk bing ja Hê-rôt, truh dii Kadraq, đnooy: “Kuh thơy, 'wot xet đaneq thơy laa manih dong dik ji pato dayq trôôk daak ku Kơy Plêêk bơơn varơuq dik, ji leh e varơuq 'yo nêêh măn aduq thơy truh paq kê dro leq, vii thơy leh 'yo aduq pi gôk ku khơl drơy. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Vii anưq, dayh ăm 'wot xet thơy biit đaleq? E ik noop xơu ka Sê-sa long leh?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Bơh vii heq xet xuum klaak xơuq xơk ku oot, Lôôk Jê-xu đnooy: “Khơl dro xuum pa ôôh hơq, aleq êêp kơy 'yo thưh gô? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Dayh ăm gô 'yo jêêt noop xơu.” Oot ahlê ka Kadraq jêêt muuyq đơ-ni-ê. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Kadraq đnooy dii oot: “Long lơuq ji hlêêl dơuq neq laa ku kơyq?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Oot tơơl: “Ku Sê-sa.” Tuôôy nưq, Kadraq đnooy dii oot: “Anưq, dayh bla ka Sê-sa kaluh kajoq ku Sê-sa, ji ka Kơy Plêêk kaluh kajoq ku Kơy Plêêk.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Atêq tuôôy tameng apok nưq, oot thier akêh, yôôch oot chuh hooy, ka'lăk Kadraq hlê.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Đom hngơy nưq, taleq dro Sa-đu-sê truh jeq Kadraq, vii 'ngưng đnooy laa leh e varơuq riirh hlê, lunưq oot heq 'yo vôôch Kadraq, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Đaneq: “Thơy lơơy, Môi-se đnooy: ‘Atoh muuyq dro leq nưq kaxêêt tuôôy leh e koot, yôôych ma oh kanau dro nưq hnoq pajêêk kadrê ku ay ji pa iir koot ka dro ay ku ni.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Bơh katul 'wot e pơh oh ay kanau, dro droyq dik, atêq tuôôy xok kadrê, yôôych heq kaxêêt. Ji ay xôq hlê kadrê ku ay ka dro ma oh ni, tuôôy leh e koot. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Dro thưq vaarq yôôch dro thưq pe, dong truh dro thưq pơh, kung đanưq. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Yôôch atêq dêq hloay, dro khơl drê kaxêêt hlơơp. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Anưq, đom varơuq riirh hlê, mư hnoq laa kadrê ku kơyq đom pơh dro oh ay? Vii dêq hloay oot heq xok mư.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Bơh tuôôy tơơl apok, Lôôk Jê-xu đnooy dii oot: “Êêp kơy biq hyaak bơyq yôôch, vii leh xet Rahlăp Vah hloay taay yaak ku Kơy Plêêk. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Vii đom varơuq riirh hlê, khơl drơy leh pajêêk kung leh jah gah hooy, bơh oot yôôych dang đaji yaak plêêk tol plêêk. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Măn truh varơuq riirh hlê ku dro kaxêêt, êêp kơy koq đok apok heq jah Kơy Plêêk xanoh dii êêp, đaneq: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Gô laa Kơy Plêêk ku Ap-ra-ham, Kơy Plêêk ku I-sak ji Kơy Plêêk ku Ja-kôp’? Kơy Plêêk leh aalq laa ku dro kaxêêt, bơh laa ku manih riirh.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Tuôôy tameng đanưq, manih karôp biq akêh truh apok pato ku Kadraq.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Măn khơl manih Pha-ri-si, atêq tuôôy tameng đaneq Kadraq heq khienq taleq dro Sa-đu-sê paq ik hah huuy, yôôych heq anguk hlê dii mamuuyq. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Muuyq dro đom sôôq oot, laa thơy pato ganuun, heq vôôch 'yo xôq thưh Kadraq — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Thơy lơơy, ganeen leq kôt dik đom ganuun?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yôôch Kadraq đnooy kung ay nưq: “‘Dayh xung xiaq Lôôk, laa Kơy Plêêk ku koot, bơơn dêq ka xuum klaak koot, kung dêq ka phool hiel koot ji dêq ka akoq biit koot.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Nưq laa ganeen kôt ji 'yo duh dik. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Măn ganeen thưq vaarq dang đaji varơuq nưq — ‘Dayh xung xiaq manih gah gih ku koot đaji xăk xamơk koot.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Dêq hloay ganuun ji khơl hnhư hlit jah gamưh tol vaarq ganeen neq.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Tuôôy nưq, atêq tuôôy taleq dro Pha-ri-si jah anguk hlê kung mamuuyq, Lôôk Jê-xu vôôch oot, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />đaneq: “Khơl kơy biit luleq truh Lôôk Wơơt Dêh? Kadraq laa koot ku kơyq?” Oot tơơl apok Kadraq: “Ku vuua Đa-vik.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Kadraq đnooy dii oot: “Anưq dơơp đaleq đơu Đa-vik, đom Kơy Phool Hiel, taayh Kadraq laa Lôôk, tuôôy đnooy:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Lôôk xanoh dii Lôôk gô:</para>
  <para style="q1" vid="MAT 22:44">“Dayh 'ngôôy măn pi akoh Gô,</para>
  <para style="q1" vid="MAT 22:44">dong truh tuôôy leq Gô xôq khơl dro tachơơl ku koot 'laarq jôôk koot”’?<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Anưq atoh Đa-vik taayh Kadraq laa ‘Lôôk,’ yôôych dơơp aleq Kadraq laa koot vuua nưq?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Paq e kơyq hnoq ik tơơl hlê Kadraq muuyq apok, kung be muuyq dro leq hôôk 'yo vôôch Kadraq đnoyq xing tuôôy hngơy nưq.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Atêq nưq, Lôôk Jê-xu đnooy dii bing manih karôp ji khơl xatyauq kadraq, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />đaneq: “Khơl thơy pato ganuun ji khơl manih Pha-ri-si 'ngôôy tol ragê ku Môi-se. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Kơq nưq, atoh oot pato dayq oh ay paq kê varơuq kajoq, dayh dưk dơơp ji tameng jư dêq hloay. Bơh te dơơp tyauq kaluh varơuq dơơp ku oot, vii oot đnooy đơu leh dơơp. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Oot xa'măk kaluh gengq parêq ji pơl pơq, yôôch oot choch tol vara khơl drơy, bơh kadih oot be trôôch đuk lôk ti oot muut đnư. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Oot dưk dơơp tôôy varơuq dơơp ku oot xôq jah khơl drơy 'yo hloq. Vii oot dơơp kaluh trăp xôq rahlăp ganuun ku oot dong kôt ji taat kaluh kahnier aau oot dong yơơt. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Oot trôôch kachô aduq 'ngôôy pi adroyq dik đom waal pajêêk, ji kachô aduq kôt dik đom hnhư hơu, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />kung kaluh apok vôôch hrok aduq tabôôt xa ji jah manih karôp taayh laa ‘Ra-bi.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Bơh oh ay leh duh jah taayh laa ‘Ra-bi,’ vii thơy ku oh ay vơ e muuyq, măn dêq hloay oh ay laa oh ay. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Ji oh ay te taayh paq kê kơyq tol vari laa ‘vaq’ vii oh ay vơ e muuyq Vaq tol plêêk. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kung te xôq haay jah taayh laa ‘thơy,’ vii thơy ku oh ay vơ e muuyq — nưq laa Lôôk Wơơt Dêh. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Bơh dro kôt dik đom khơl oh ay hnoq laa xapok oh ay <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Măn kơyq kadih vanê ni tok hnoq biq paklêh pôôt; ji kơyq kadih paklêh pôôt xăk hnoq jah vanê atok.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Bơh ra ơơh ka khơl kơy, khơl thơy pato ganuun ji manih Pha-ri-si, bing xuum pa ôôh hơq! Bơyh êêp kơy kađnoch daak dêh daak plêêk hlê kangưưr khơl drơy. Vii êêp kơy yôôych leh muut 'lăp, kung be xôq ka kơyq hooy muut ik tawaak muut 'lăp. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Ra ơơh ka êêp kơy, khơl thơy pato ganuun ji manih Pha-ri-si, bing xuum pa ôôh hơq! Bơyh êêp kơy xa luôôt hnhư khơl mư valơu, đơu apôôy dong xiik 'ngưng đom varơuq dơơp bôô.] Vii kakơq nưq, êêp kơy hnoq nhonq xok xadrah dook parêq iaq. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Ra ơơh ka êêp kơy, khơl thơy pato ganuun ji manih Pha-ri-si, bing xuum pa ôôh hơq! Bơyh êêp kơy dalơh hlê daak tahli hloay vari kateh xôq khienq ka muuyq dro tyauq đaauq, ji tuôôy dro nưq heq vlôh jêêk đanưq, êêp kơy ahluk khienq dro nưq vlôh dro koot ku ôôlh karuk gôp vaarq yưk êêp kơy.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Ra ơơh ka êêp kơy, khơl dro jarooy trôôk apul, nưq laa khơl dro đnooy: ‘Dro leq paleek bơyh hnhư hơu yôôych be aleq. Bơh dro leq paleek bơyh vajang ku hnhư hơu yôôych nưq laa pang waq.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Khơl dro vlô apoop ji bing apul hơq! Vii varơuq leq laa kôt iaq, vajang long hnhư hơu khienq vajang jah vah? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Laay măn: ‘Dro leq paleek bơyh para hơu yôôych be aleq. Bơh dro leq paleek bơyh kuah lêh pi ataalh para hơu yôôych nưq laa pang waq.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Khơl dro vlô apoop ji bing apul vlo hơq! Vii varơuq leq kôt iaq, kuah lêh long para hơu khienq kuah lêh jah vah? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Kơq nưq, kơyq heq paleek bơyh para hơu yôôych paleek bơyh para hơu ji bơyh tôôy thưq pi taalh nưq. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Kơyq heq paleek bơyh hnhư hơu yôôych paleek bơyh hnhư hơu ji bơyh Kơy măn đom nưq. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Ji kơyq heq paleek bơyh plêêk yôôych paleek bơyh ngôôy ku Kơy Plêêk ji bơyh Kơy măn tol nưq.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Ra ơơh ka êêp kơy, khơl thơy pato ganuun ji manih Pha-ri-si, bing xuum pa ôôh hơq! Bơyh êêp kơy noop phon kưl baak ha, thi laa ji kaxeq kâân, đơu ka'lăk tăk kaluh varơuq duh dik ku ganuun — nưq laa varơuq hyioh jăk, xuum biit angơuq ji varơuq muuyq xuum. Mot kadrơy, nưq laa varơuq kơn duh xôq dưk dơơp kaluh varơuq neq, ji leh ka'lăk kaluh varơuq hơq. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Bing jarooy trôôk apul vlo hơq, 'ngưq laa khơl dro rơơlh vlôh muuyq poop pi kajơơu tahrưưt, bơh luôôt apoop muuyq ôô lak đa!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Ra ơơh ka êêp kơy, khơl thơy pato ganuun ji manih Pha-ri-si, bing xuum pa ôôh hơq! Bơyh êêp kơy 'nhaau xarêh pi gôk ku dooy ji dơơt, bơh pi 'lăp yôôych oot viik ngăk varơuq varoh xok ji xa agưt. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Khơl dro Pha-ri-si apul vlo hơq! Adroyq dik, dayh 'nhaau xarêh pi 'lăp dooy ji dơơt, xôq pi gôk ku oot kung vlôh xarêh xaraat.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Ra ơơh ka êêp kơy, khơl thơy pato ganuun ji manih Pha-ri-si, bing xuum pa ôôh hơq! Bơyh êêp kơy dang đaji kaluh xanưng jah tôô ko, laa kaluh thưq tabơh kahnoq vlôh kaxay tamaq pi gôk, bơh pi 'lăp yôôych viik ngăk khiêk kadah manih kaxêêt ji đu thưq 'moh nhơy. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Kung dang đaji đanưq, tabơh pi gôk êêp kơy kahnoq vlôh hyioh jăk đôôyq dii khơl drơy, bơh pi 'lăp êêp kơy yôôych viik katâk pa ôôh lar ji kadrôôp maroh.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Ra ơơh ka êêp, khơl thơy pato ganuun ji manih Pha-ri-si, bing xuum pa ôôh hơq! Bơyh êêp kơy xơy dơơp xanưng ku khơl hnhư hlit ji ta'meq pagooh xanưng ku khơl manih hyioh jăk. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Êêp kơy đnooy: ‘Atoh 'wot măn đom tuôôy đơơy khơl mo kơy 'wot, yôôych laa 'wot heq leh dơơp khơl dro jưq phon dii oot aduq vahaap ku khơl hnhư hlit.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Lunưq, êêp kơy kadih dơơp xanưk truh êêp đaneq êêp laa koot xau ku khơl dro heq păk kaxêêt khơl hnhư hlit, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />ji êêp kơy dayh dơơp viik xaleep hlơk kadrôôp xơk ku mo kơy êêp! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Bing volh đôk hơq, rong nooy ku volh taweek, êêp kơy hnoq xadăk klơlh varơuq xadrah dook ku ôôlh karuk bơơn trôôk leq? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Vii kakơq neq, dayh 'yo hơq, gô patăk dăt khơl hnhư hlit, Manih khôôt xet ji thơy pato ganuun truh dii êêp kơy. Xing katul oot, êêp kơy hnoq păk kaxêêt ji đongq đing, kung xing katul oot, êêp kơy hnoq tiel dook đom kaluh hnhư tagumq êêp ji da uiq tyauq xing theng neq hlê theng kadrơy, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />dơơp aleq hnoq ik truh tol êêp kơy dêq hloay vahaap hyioh jăk heq biq ahngok vlôh tol vari, xing vahaap ku A-bên, manih hyioh jăk, dong truh vahaap Xa-cha-ri, koot kanau Ba-ra-chi, manih đơu êêp kơy heq păk kaxêêt katul hnhư hơu ji para hơu. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Dong dik, gô đnooy dii êêp kơy, tôôy varơuq nưq hnoq xalih truh tol adrơơk neq.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Jê-ru-sa-lem, Jê-ru-sa-lem, xăk heq păk kaxêêt khơl hnhư hlit ji tiip phơu khơl dro jah patăk truh dii xăk! 'Ngưng yưk gô trôôch anguk hlê koot xau ku êêp hlê, tyauq trôôk đơu ier pi anguk koot ni 'laarq panưr, đơu xăk leh chiuq! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />'Yo neq, hnhư ku êêp kơy hnoq biq ka'lăk hlê wăngq xateek ka êêp kơy. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Vii gô đnooy dii êêp kơy, êêp kơy kajưk dik hnoq leh hloq gô xing neng dong truh tuôôy leq êêp kơy đnooy: ‘Ayuôôt laat Kơy truh đom yal Lôôk!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Atêq tuôôy vlôh klơlh hnhư hơu, Lôôk Jê-xu hooy đnoyq. Yôôch khơl xatyauq Kadraq truh jeq xôq pato ka Kadraq 'yo kaluh kông trinh ku hnhư hơu. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Bơh tuôôy tơơl hlê, Kadraq đnooy dii oot: “Oh ay leh 'yo hloq tôôy thưq nưq ih? Dong dik, thơy đnooy dii oh ay, aduq neq kajưk dik hnoq leh măn hlê kuk phơu neq tol kuk phơu hơq đơu be biq pahrưp hrưp.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Tuôôy nưq, tuôôy Kadraq đong 'ngôôy tol đoot Ô-liu, khơl xatyauq truh đêh jeq Kadraq, tơơl: “Xiin ăm 'wot xet dong leq kaluh varơuq nưq hnoq xalih vlôh, ji dơuq hlêêl varơuq truh ku thơy ji ku hngơy hlơơp dêh laa kajoq?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Tuôôy tơơl apok, Lôôk Jê-xu đnooy dii oot: “Dayh rơơt rol xôq leh kơyq hnoq ik dơơp ka oh ay hyaak hyul. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Vii 'ngưng dro hnoq truh đom yal thơy, xưng: ‘Gô laa Lôôk Wơơt Dêh,’ ji hnoq dơơp ka 'ngưng dro hyaak hyul. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mot kadrơy, oh ay hnoq tameng tek truh tahmơt jăk ji kaluh hêêl đnooy truh tahmơt jăk. Oh ay dayh rơơt rol, te biq xôôl dôôl, vii varơuq nưq duh pheq xalih vlôh, bơh koq lưp aalq laa hngơy hlơơp dêh. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Vii tamooy neq hnoq dưk tok tachơơl hlê tamooy kadrơy, daak neq tachơơl hlê daak hơq. Yôôch hnoq e pangoot hrah ji ahrưng vari măn 'ngưng aduq. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Bơh dêq hloay kaluh varơuq neq vơ laa xarôp ku kaluh đơơt pơơl dal hngơy hlơơp dêh. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Tuôôy nưq, khơl drơy hnoq ahnen oh ay muut đom pơơl dal ji păk kaxêêt oh ay, ji oh ay hnoq biq tôôy tamooy 'yarơ jaraq vii kơq yal thơy. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Yôôch 'ngưng dro hnoq biq gưlh lôp, xalih xuum mamuuyq ji thu 'yarơ mamuuyq. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />'Ngưng khơl hlit pa ôôh hnoq jah dưk tok ji dơơp ka 'ngưng dro hyaak hyul. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Vii varơuq lôp kadrôôp hnoq athêêp 'ngưng, xuum xiaq ku 'ngưng dro hnoq biq ngưưt jaleek. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Bơh kơyq kajưk xuum dong truh lôôch dik, dro nưq hnoq jah wơơt. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Hêêl Kaxay neq truh daak plêêk hnoq jah padoh taboon vlôh loch tol vari dêh xôq dơơp muuyq apok xanưk ka tôôy tamooy, ji yôôch varơuq lôôch dik hnoq truh.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Kơq nưq, tuôôy oh ay 'yo hloq varơuq ramêq dik ku varơuq ralưp ralaak, laa varơuq heq jah hnhư hlit Đa-ni-ên đnooy truh, xôq đom aduq vah” (dro đok pheq hlolh), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“Tuôôy nưq, kơyq đom dêh Ju-đê dayh xadăk du truh dêh đoot, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />kơyq măn tol apo hnhư, te hooy pôôt xok vlong kajoq klơlh hnhư êêp, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />ji kơyq măn manay gôk te wiit xuq xôq xok aau khwoak êêp. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Bơh ra ơơh dik ka khơl kadrê măn bonq ji khơl leq đong ăm koot uq đom kaluh hngơy nưq! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Bơh dayh apôôy vôôch xôq varơuq xadăk naanq ku oh ay leh huq klêh muut xiêk jaleek, long klip hngơy Sa-bat. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Vii tuôôy nưq hnoq e varơuq pơơl dal kôt, koq hmưq xalih vlôh dang đanưq xing tuôôy xarôp panưk pajêêk dêh araak dong truh juneq, ji kajưk dik kung hnoq leh e. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Atoh kaluh hngơy nưq leh jah ruut lêq, yôôych laa tôôy xăk xamơk heq be jah wơơt. Bơh vii kơq khơl dro jah rơơlh, kaluh hngơy nưq hnoq jah ka'lăk đơh. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Tuôôy nưq, atoh muuyq dro leq nưq đnooy dii oh ay: ‘'Yo hơq, Lôôk Wơơt Dêh măn đnen!’ long ‘Măn hơ!’ yôôych oh ay te tuôq. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Vii khơl wơơt lôôk pa ôôh kung khơl hnhư hlit pa ôôh hnoq jah dưk tok ji kahnoq vlôh kaluh dơuq akêh kung kaluh pheep akêh kôt lơyq pheq đnooy dơơp ăm hyaak hyul, atoh hnoq ik, yôôych hloay ka khơl dro jah rơơlh. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />'Yo nee, thơy đnooy droyq ka oh ay yôôch nưq. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Anưq, atoh khơl drơy đnooy dii oh ay: ‘'Yo hơq, Kadraq đong đom wăngq we,’ yôôych oh ay be duh hooy vlôh đnư. Dayh ‘'Yo nee, aduq kaluh phong kinq,’ yôôych oh ay te duh tuôq. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Vii kablek tađnah vlôh xing hngơy vlok yôôch pareek tađnah truh pi hngơy lôp luleq, yôôych varơuq rama truh ku Koot Manih hnoq laa đanưq. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Long xaak kaxêêt măn aduq leq, xêêp aak hnoq anguk hlê aduq nưq.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Bơh atêq ka đơơt pơơl dal ku kaluh hngơy nưq, mot hngơy hnoq biq dơơp ăm kamơng jaluk, xiêk hnoq paq xaraar tađnah ku ni, kaluh xalok hnoq xing plêêk kađnih pôôt, ji kaluh qwuyen lưk ku kaluh tol plêêk hnoq biq ahrưng anhưh. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Tuôôy nưq, dơuq hlêêl truh Koot Manih hnoq jah kahnoq vlôh tol plêêk, ji yôôch dêq hloay kaluh tamooy tol vari hnoq nhim ook. Oot hnoq hloq Koot Manih truh tol kaluh kuk kluk plêêk dii qwuyen pheep ji tađnah tađnaak kôt. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Kadraq hnoq patăk yaak plêêk ku Kadraq kung dii ahlôôk keng kôt, ji oot hnoq anguk hlê khơl manih jah rơơlh ku Kadraq xing poot panưk vari, xing lôôch plêêk neq truh lôôch panưh plêêk hơq.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Mot kadrơy, dayh hok xet apok atoh neq xing ưk pok puut. Tuôôy đook ni vlôh gooy kaxeq ji vlôh hla yôôch, yôôych oh ay xet đaneq xiêk tôq jeq truh. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Kung tyauq kach nưq, tuôôy oh ay hloq tôôy varơuq neq, yôôych oh ay xet đaneq Kadraq đong măn jeq, kangưưr 'mok. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Dong dik, thơy đnooy dii oh ay, đaneq adrơơk neq kajưk dik hnoq leh dalơh hlê dong truh tuôôy leq dêq hloay kaluh varơuq nưq heq xalih vlôh. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Plêêk ji vari hnoq dalơh hlơơp, bơh kaluh apok ku thơy kajưk dik hnoq leq dalơh hlơơp. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Măn tajinq truh hngơy ji wat nưq yôôych leh kơyq xet, hloay ka yaak plêêk tol daak plêêk long Koot, đêh vlôh Vaq đơu heq. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Bơyh kađơơy Nô-ê đaji luleq, yôôych varơuq truh ku Koot Manih hnoq laa đaji lunưq. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Vii đaji đom kaluh hngơy adroyq daak ngôp dêh, khơl drơy 'miêh xa hôôch, pajêêk gah dong truh hngơy Nô-ê muut đom tau, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ji oot leh 'yo vlôh dong truh tuôôy daak ngôp truh ji akhwua oot hooy — varơuq truh ku Koot Manih kung hnoq laa đanưq. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Tuôôy nưq, vaarq dro khơl kanau đong măn manay apôh — muuyq dro hnoq jah xagook hooy, muuyq dro hnoq biq xôq hlê. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Vaarq dro khơl drê đong apeh va — muuyq dro hnoq jah xagook hooy, muuyq dro hnoq biq xôq hlê. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Vii anưq, dayh văch 'yo vii oh ay leh xet muut ka hngơy leq Lôôk haay hnoq truh. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Bơh oh ay dayh 'yo xet varơuq neq, đaneq atoh kôôch hnhư heq xet dro atôk truh muut kawat leq ka klôôy, yôôych heq laa kơy nưq heq kôô parol ji heq leh xôq ka hnhư ni biq muut atôk. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Vii kakơq neq, oh ay kung pheq ralauq xôq 'miêh, vii Koot Manih hnoq truh đom wat oh ay leh biit truh.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Lunưq, kơyq laa xapok muuyq xuum ji khôôt xet đơu kôôch pahnăp jư 'yo tol manih hnhư ku kôôch xôq ăm tuôông xa ka oot muut klip kawat? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Vanong hloay laa dro xapok nưq, laa dro đơu kôôch ku ay, atêq tuôôy truh, hnoq hloq ay đong dưk dơơp đanưq. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Dong dik thơy đnooy dii oh ay đaneq kôôch hnoq pahnăp xôq ay nưq jư 'yo tol tôôy thưq kôôch đong e. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Bơh atoh adro xapok xơk tauq nưq đnooy đom xuum ni: ‘Kôôch gô đong truh ahnuy,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />yôôch xarôp tiel tu khơl dro kung laa xapok dii ni, đơu xa hôôch dii bing vuul lok, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />yôôych dro kôôch ku adro xapok nưq hnoq truh muut hngơy đơu ni leh xanih ji đom wat đơu ni leh xet. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Kơy nưq hnoq hmơt chieh ni kach taxưngq ji hnoq pahnăp aduq ku ni muuyq aduq dii bing xuum pa ôôh; aduq nưq hnoq e varơuq nhim alo ji takik kaneeng.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Anưq, daak dêh daak plêêk hnoq jah atoh đaji kưl khơl drê blaay, laa khơl dro adrơk đeen oot hooy vlôh truh aduq đoonq tiip ok. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Bơh dăp mư đom sôôq oot laa vlô, ji dăp mư yôôych khôôt. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Vii dăp mư vlô, atêq tuôôy adrơk đeen ku oot hooy, heq leh taway dơu tyauq dii oot. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Măn khơl mư khôôt yôôych heq taway dơu tyauq đom kave kung dii đeen oot. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Tuôôy nưq, vii ok truh ahnuy, dêq hloay oot heq kung lakôôp vik yôôch vik tawol. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Bơh muut katul mưng, e apok taayh: ‘Koot ok hơq! Dayh hooy vlôh truh aduq đoonq tiip.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Tuôôy nưq, dêq hloay khơl drê blaay nưq jah nhơk kah ji ralauq 'meq đeen oot. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Tuôôy nưq, khơl mư vlô đnooy dii khơl mư khôôt: ‘Xiin ăm ka 'wot muuyq phon dơu ku êêp mư, vii đeen ku 'wot jeq poch.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Bơh tuôôy tơơl hlê, khơl mư khôôt đnooy: ‘Leh ik hnoq leh ik 'leq e đu ka 'wot ji êêp ay. Tơơl iaq, dayh hooy truh khơl dro tabôôt tek đơu root ka êêp.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Lunư, đom tuôôy oot hooy root, ok heq truh, ji khơl leq ralauq 'miêh kung dii ok yôôych muut đom waal pajêêk, yôôch 'mok jah kađnoch hlê. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Yôôch atêq nưq, khơl drê blaay hơq kung truh, tơơl: ‘Kôôch lơơy, kôôch lơơy, luh rơy 'mok ka 'wot.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Bơh tuôôy tơơl hlê, kôôch đnooy: ‘Dong dik, gô đnooy dii êêp mư, gô be xet êêp mư.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Anưq, dayh parol 'yo, bơyh oh ay leh xet hngơy long wat.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Vii dang đaji muuyq dro jeq hooy dêh xangưưy, kơy heq taayh khơl xapok ku ni hlê ji pahnăp ka oot garuh anôôp ku kơy. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Kơy ăm dro neq dăp ta-lâng, dro hơq vaarq ta-lâng, dro kadrơy đnoyq muuyq ta-lâng — đôôyq dii tôôy dro 'yo tyauq paraat đêh ra. Yôôch kơy vơ hloay dưk vlôh hooy dêh xangưưy. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Tuôôy kơy hooy yôôch, dro nhonq dăp ta-lâng heq hooy tabôôt xa sôôq jêêt nưq ji axek jah dăp ta-lâng kadrơy. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Dang anưq, dro e vaarq ta-lâng kung axek jah vaarq ta-lâng kadrơy. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Bơh dro heq nhonq muuyq ta-lâng, atêq tuôôy hooy vlôh, heq pok vari ji kadook jêêt ku kôôch ni. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Tuôôy nưq, atêq muuyq kawah xiik, kôôch ku khơl dro xapok nưq truh ji 'yo jauq varơuq dii oot. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Atêq tuôôy truh jeq, dro nhonq dăp ta-lâng heq adrơk dăp ta-lâng kadrơy, đnooy đaneq: ‘Kôôch lơơy, kơy heq pahnăp ka gô dăp ta-lâng. Bơh xiin 'yo neq, gô heq dơơp e athêêp dăp ta-lâng.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Kôôch ku ay đnooy dii ay: ‘Ik yôôch, ay xapok hyioh jăk ji muuyq xuum! Ay heq muuyq xuum đom varơuq de. Gô hnoq pahnăp xôq ay jư 'yo tol 'ngưng varơuq. Dayh muut đom hlah hlaak ku kôôch ay.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Dro e vaarq ta-lâng, atêq tuôôy truh jeq, kung heq đnooy: ‘Kôôch lơơy, kơy heq pahnăp ka gô vaarq ta-lâng, bơh xiin 'yo neq, gô heq dơơp vlôh athêêp vaarq ta-lâng.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Kôôch ku ay đnooy dii ay: ‘Ik yôôch, ay xapok hyioh jăk ji muuyq xuum! Ay heq muuyq xuum đom varơuq de. Gô hnoq pahnăp xôq ka ay jư 'yo tol 'ngưng varơuq. Dayh muut đom hlah hlaak ku kôôch ay.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Măn dro nhonq muuyq ta-lâng, kung tawaak truh, heq đnooy: ‘Kôôch lơơy, gô xet kơy, đaneq kơy laa muuyq dro thier khoq, goch ka aduq kôôch leh pêêt ji goch xok ka aduq kôôch leh paraay vlôh. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Vii yôq varaal, lunưq atêq tuôôy hooy vlôh, gô heq kadook ta-lâng ku kơy 'laarq vari. Dayh 'yo neq, kơy xok hlê phon ku kơy.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Bơh tuôôy tơơl hlê, dro kôôch ku dro nưq đnooy dii ni: ‘Adro xapok xơk tauq ji alah kamo hơq! Ay 'miêh heq xet đaneq gô goch ka aduq gô leh pêêt ji goch xok ka aduq gô leh paraay vlôh. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Anưq yôôych, yơu iaq ay kơn duh adrơk xôq jêêt ku gô măn aduq hnhư tabôôt jêêt, yôôch atêq tuôôy truh, yôôych laa gô heq nhonq hlê jôônq ku gô kung jêêt palơơy. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Anưq, dayh xok ta-lâng khơl adro neq ji ăm jêêt nưq ka dro đong e kưl ta-lâng. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Vii dii dro đong e, yôôych tôôy thưq hnoq jah kahniq ăm — pheq đnooy hnoq jah raah 'ngưng. Bơh đôôyq dii dro be e, yôôych hloay ka varơuq ni e hnoq biq xok hlơơp klơlh ni. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ji dayh qweek adro xapok be ra kajoq nưq muut aduq kamơng jaluk pi gôk, laa aduq hnoq e varơuq nhim alo ji takik kaneeng.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Măn tuôôy Koot Manih truh đom tađnah tađnaak Kadraq ji dêq hloay yaak plêêk kung dii Kadraq, yôôych tuôôy nưq, Kadraq hnoq 'ngôôy tol ngôôy tađnah tađnaak kadraq. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Dêq hloay kaluh tamooy hnoq jah anguk hlê kangưưr Kadraq, ji Kadraq hnoq aklah vlôh oot dii mamuuyq, đaji laa dro xakaq aklah trưưu vlôh klơlh vove. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Kadraq hnoq xôq trưưu măn pi akoh kadraq, măn vove măn pi akeng. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Atêq nưq, Vuua hnoq dăt khơl leq măn pi akoh kadraq: ‘Khơl dro heq jah Vaq Gô kahniq vanong, truh đnen yơu, dayh nhonq xok daak plêêk heq jah ralauq 'miêh ka êêp xing tuôôy panưk pajêêk plêêk vari. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Vii Gô pangoot, yôôych êêp koot ăm Gô xa; Gô thaal, yôôych êêp koot ăm Gô hôôch; Gô laa manih be xet, yôôych êêp koot tiip đoonq Gô; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Gô lalôk, yôôych êêp koot pahlưp ka Gô; Gô jiq jiêh, yôôych êêp koot 'yo xiap Gô; Gô măn đom tu, yôôych êêp koot truh dii Gô.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Tuôôy nưq, khơl dro hyioh jăk hnoq tơơl hlê Kadraq, đaneq: ‘Kuh Lôôk, 'wot koot heq hloq Kadraq pangoot đơu ăm xa, long laa thaal đơu ăm hôôch muut tuôôy leq? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Yôôch 'wot koot heq hloq Kadraq đaji manih be xet đơu tiip đoonq? Long lalôk đơu pahlưp ăm muut tuôôy leq? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ji 'wot koot heq hloq Kadraq jiq jiêh long măn đom tu tuôôy leq đơu truh dii Kadraq?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Tuôôy tơơl apok, Vuua hnoq đnooy dii oot: ‘Dong dik, Gô đnooy dii êêp koot, gamưh muut tôôy varơuq êêp koot heq dơơp ka muuyq đom khơl dro de dik aduq khơl oh ay neq ku Gô, yôôych êêp koot heq dơơp ka Gô.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Atêq nưq, Vuua kung hnoq dăt khơl dro măn pi akeng: ‘Dayh hooy xangưưy klơlh Gô, khơl dro biq karoay axaap hơq, hooy muut ôôlh đơơy đơơy heq xôq 'miêh ka kamuuych ji kaluh garu xi xơk ku ni. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Vii Gô pangoot đơu êêp leh ăm Gô xa; Gô thaal đơu êêp leh ăm Gô hôôch; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Gô laa manih xadaay be xet, đơu êêp leh tiip đoonq Gô; lalôk yôôych êêp be pahlưp ka Gô; jiq jiêh ji măn đom tu, yôôych êêp be 'yo xiap Gô.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Tuôôy nưq, oot kung hnoq tơơl, đaneq: ‘Kuh Lôôk, 'wot koot heq hloq Kadraq pangoot, long thaal, long đaji manih xadaay be xet, long lalôk, long jiq jiêh, long măn đom tu tuôôy leq đơu be hơu varơuq Kadraq?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Anưq yôôch, Vuua hnoq tơơl apok oot, đaneq: ‘Dong dik, Gô đnooy dii êêp, gamưh muut tôôy varơuq êêp heq leh dơơp ka muuyq đom khơl dro de dik aduq khơl dro neq, yôôych êêp heq leh dơơp ka Gô.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Khơl dro nưq hnoq hooy muut varơuq hmơt dook miet miet, măn khơl dro hyioh jăk yôôych muut varơuq riirh đơơy đơơy.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Varơuq xalih vlôh tuôôy Lôôk Jê-xu heq đnooy payôôch dêq hloay kaluh apok nưq, Kadraq dăt khơl xatyauq kadraq: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Oh ay xet đaneq vaarq hngơy tra hnoq truh Lêh Dalơh hlê, ji Koot Manih hnoq biq rôp xôq chiuq đongq đing tol gay charăk.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Tuôôy nưq, khơl Thơy tơơk tưp kôt ji khơl draq đom manih karôp heq jah anguk hlê đom hnhư ku Thơy tơơk tưp kôt, anơng laa Kai-phe. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Oot kung mamuuyq tajauq athêêk xôq oot hnoq ik bơơn xôq vih rôp jư Lôôk Jê-xu ji păk kaxêêt dơyh. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Bơh oot đnooy: “Leh aalq đom tuôôy lêh, xôq paloanq leh xalih vlôh đom khơl manih karôp.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Tuôôy nưq, tuôôy Lôôk Jê-xu heq măn aduq Bê-tha-ni, đom hnhư Si-môn, dro biq jiq paruh, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />muuyq khơl drê adrơk kave ngok tađnưk daak jơu thơơm thier mach jêêt truh jeq Kadraq, ji mư uk tol akoq Kadraq, đong tuôôy 'ngôôy xa. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Bơh atêq tuôôy hloq anưq, khơl xatyauq tôq jaraq, đnooy: “Dơơp alay đanưq xôq dơơp kajoq? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Vii jơu neq hnoq ik tek jah 'ngưng jêêt ji ăm hloh ka khơl adrah.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Bơh xet varơuq neq, Lôôk Jê-xu dăt oot: “Aleq oh ay dơơp khoq dro khơl drê neq? Vii mư heq dơơp muuyq varơuq kaxay ka thơy. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Bơyh oh ay hloay e manih adrah măn dii oh ay, bơh leh aalq oh ay hloay e thơy. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Vii tuôôy mư uk jơu neq tol xăk thơy, mư heq dơơp thay ka varơuq up xôq thơy. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Dong dik, thơy đnooy dii oh ay, long aduq leq Hêêl Kaxay neq jah padoh vlôh loch tol dêh araak, yôôych varơuq mư neq heq dơơp kung hnoq jah đnooy truh đom varơuq văch hlê truh mư.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Tuôôy nưq, muuyq đom kưl vaarq dro jah rơơlh, anơng laa Ju-đa Ich-ka-ri-ôt, atêq tuôôy hooy truh kung khơl thơy tơơk tưp kôt, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />heq đnooy: “Êêp kơy chiuq bla gô taleq, yôôch gô hnoq pahnăp dro nưq ka êêp kơy?” Anưq laa, oot duh ăm ka ni pe kưl xiêk-lơ baak. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ji xing kawat nưq, ni xarôp axek kawah xôq hnoq ik rôp noop Kadraq.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Tuôôy nưq, muut hngơy adroyq dik ku lêh Tôôp Leh Tape, khơl xatyauq truh jeq Lôôk Jê-xu, tơơl: “Thơy trôôch 'wot ralauq xôq ka thơy xa lêh Dalơh Hlê ka'leq?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Yôôch Kadraq tơơl: “Dayh hooy muut theng, truh dii muuyq dro hơq ji đnooy dii ay nưq: ‘Thơy đnooy: “Kawah ku thơy yôôych đong jeq yôôch; thơy dưk dơơp lêh Dalơh Hlê aduq hnhư ay kung dii khơl xatyauq thơy.”’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Khơl Xatyauq dơơp đaji Lôôk Jê-xu đnooy pato oot, ji oot ralauq xôq lêh Dalơh Hlê.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Tuôôy nưq, tuôôy truh klôôy, Kadraq 'ngôôy xa kung dii kưl vaarq dro jah rơơlh. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Tuôôy oot đong xa, Kadraq đnooy: “Dong dik, thơy đnooy dii oh ay đaneq muuyq dro đom oh ay hnoq tachơơl hlê thơy.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Vii hlu rơu paq ik, tôôy dro muuyq xarôp tơơl kung Kadraq: “Lôôk lơơy, leh aalq laa gô iq?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Bơh xôq tơơl apok, Kadraq đnooy: “Dro heq vêq ti ni muut đom dơơt achung dii thơy, dro nưq hnoq tachơơl thơy. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Tabơh Koot Manih hnoq vlôh hooy, tyauq đaji apok heq jah valơk truh Kadraq, bơh ra ơơh ka dro nưq, bơyh ni đơu Koot Manih biq tachơơl hlê! Atoh dro nưq 'miêh heq leh jah pa iir vlôh yôôych tolh iaq ka ni.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Bơh tuôôy tơơl hlê, Ju-đa, dro tachơơl Kadraq, đnooy: “Ra-bi, dang aleq laa gô?” Kadraq đnooy dii kơy: “Ay heq kadih đnooy yôôch.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Tuôôy nưq, tuôôy oot đong xa, tuôôy xok tôôp ji kuh qwaay yôôch, Lôôk Jê-xu heq pleelh ni vlôh. Ji atêq tuôôy palo ka khơl xatyauq, Kadraq đnooy: “Dayh nhonq xok, xa yơu. Neq laa xăk xamơk ku thơy.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Ji tuôôy xok dooy ji kuh qwaay yôôch, Kadraq heq palo ka oot, đnooy: “Dêq hloay dayh hôôch aduq dooy neq. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Vii neq laa vahaap tavek ku thơy jah ahngok vlôh đôôyq dii 'ngưng dro deng ka varơuq tha ka'lăk kadrôôp maroh. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Bơh Thơy đnooy dii oh ay 'yo xing kawah neq, thơy kajưk dik hnoq leh hôôch aduq daak nho neq dong truh hngơy nưq, laa tuôôy đơu thơy hôôch daak nho đơơu achung dii oh ay đom daak dêh ku Vaq thơy.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Atêq tuôôy haat kacheeu vah, oot vlôh hooy tok đoot Ô-liu. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Tuôôy nưq, Lôôk Jê-xu đnooy dii oot: “Đom ka klôôy neng, dêq hloay oh ay hnoq biq xatôôlh gưlh aduq thơy, vii apok heq jah valơk:</para>
  <para style="q1" vid="MAT 26:31">‘Gô hnoq hmơt dro xakaq</para>
  <para style="q1" vid="MAT 26:31">yôôch trưưu ku bơy hnoq biq hyaak hyul.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Yôôch atêq tuôôy thơy jah khienq riirh hlê, thơy hnoq hooy adroyq oh ay truh Ga-li-lê.” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Bơh tơơl hlê, Phi-e-rơ tơơl dii Kadraq: “Long dêq hloay hnoq biq xatôôlh gưlh aduq thơy, bơh gô hnoq leh 'leq biq xatôôlh gưlh.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Lôôk Jê-xu đnooy dii kơy: “Dong dik, thơy đnooy dii ay, đaneq đom ka klôôy neq, adroyq tuôôy ier rok, ay hnoq chôôyq thơy pe yưk.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Phi-e-rơ tơơl dii Kadraq: “Pheq đnooy atoh băt gô pheq kaxêêt dii thơy, gô kajưk dik hnoq leh chôôyq thơy.” Ji dêq hloay khơl xatyauq kung đnooy dang đanưq.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Atêq nưq, Lôôk Jê-xu hooy kung dii oot truh muuyq aduq jah taayh laa Gêt-sê-ma-nê, ji Kadraq dăt khơl xatyauq: “Dayh 'ngôôy đnen tuôôt katuôôy thơy truh pi hơq apôôy.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Atêq tuôôy jarooy tyauq Phi-e-rơ ji vaarq koot kanau ku Xê-bê-đê, Kadraq xarôp jiq hlu ji xôôl dôôl akoq. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Tuôôy nưq, Kadraq đnooy dii oot: “Phool hiel thơy đong hlu rơu paq ik dong truh kaxêêt. Dayh măn hlê đnen ji parol 'yo achung dii thơy.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Tuôôy heq hooy xangưưy athêêp muut xit, Kadraq kul mot kadraq pôôt, apôôy ji tơơl: “Vaq ku koot lơơy, atoh varơuq neq laa hnoq ik, apôôy ăm dooy neq dalơh klơlh koot. Long anưq, leh đaji koot trôôch, đơu laa đaji Vaq.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Yôôch Kadraq truh dii khơl xatyauq ji hloq oot đong vik, yôôych Kadraq đnooy dii Phi-e-rơ: “Anưq laa, oh ay be ik parol 'yo dii thơy ik muuyq wat ih? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Dayh parol 'yo ji apôôy xôq oh ay be huq gưlh muut adô aluut. Tabơh phool hiel yôôych trôôch, đơu xăk xamơk yôôych ravoch.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Muuyq yưk tra, tuôôy hooy klơlh muut yưk vaarq, Kadraq apôôy, đaneq: “Vaq ku koot lơơy, atoh varơuq neq be hnoq ik dalơh hooy, đơu koot hôôch dooy nưq, yôôych apôôy iq Vaq jah yuôôr.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Atêq tuôôy truh yưk tra, Kadraq hloq oot đong vik, vii mot oot heq biq kaliêu lakôôp. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Ji muuyq yưk tra, atêq tuôôy xôq oot hlê yôôch hooy, Kadraq apôôy muut yưk thưq pe, tơơl kung kaluh apok đanưq đnoyq. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Atêq nưq, Kadraq truh dii khơl xatyauq ji đnooy dii oot: “Oh ay măn đong vik ji padơy vado ih? 'Yo hơq, wat truh jeq yôôch, ji Koot Manih đong biq noop muut ti khơl dro e kadrôôp. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Dayh dưk kah, haay duh hooy yơu. 'Yo nee, dro xalih xuum thơy hooy truh yôôch.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Tuôôy Kadraq măn đong đnooy, yôôych 'yo hơq, Ju-đa, muuyq đom kưl vaarq dro jah rơơlh, truh, ji kung dii ni laa muuyq bing manih thier karôp kung xieh ji gay, xing aduq khơl thơy tơơk tưp kôt ji khơl draq đom manih karôp. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Tuôôy nưq, dro xalih xuum Kadraq heq ăm oot muut hlêêl dơuq, đaneq: “Dro leq đơu gô hiip yôôych laa dro nưq. Dayh rôp kơy nưq.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Vơ hloay, atêq tuôôy truh jeq Lôôk Jê-xu, ni đnooy: “Kuh Ra-bi!” yôôch ni hiip Kadraq. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Bơh Lôôk Jê-xu đnooy dii ni: “Nee 'wơyq, vii varơuq neq đơu ay truh đnen.” Atêq nưq, atêq tuôôy truh jeq, oot tơơk ti tol Lôôk Jê-xu ji rôp jư Kadraq. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ji 'yo hơq, muuyq đom khơl dro hooy dii Lôôk Jê-xu, tuôôy tơơk ti vlôh, heq hruut xieh ni ji dool dro xapok ku thơy tơơk tưp kôt, goch kloh tôôr ku ay nưq. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Tuôôy nưq, Lôôk Jê-xu dăt dro nưq: “Dayh viet hlê xieh ku ay xuq aduq ku ni, vii dêq hloay khơl leq adrơk xieh hnoq kaxêêt bơyh xieh. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Long ay biit đaneq thơy leh e qwuyen taayh apôôy Vaq thơy, yôôch Kadraq hnoq patăk truh hloay ka thơy 'ngưng iaq kưl vaarq đaauq kuun yaak plêêk long aleq? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Anưq yôôych, dơơp aleq kaluh apok Rahlăp Vah jah jêêk, đaneq varơuq neq pheq xalih vlôh đanưq?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Muut wat nưq, Lôôk Jê-xu đnooy dii bing karôp: “Êêp kơy hooy vlôh kung dii xieh ji gay gôk xôq rôp gô đaji tachơơl hlê muuyq dro atôk ih? Tôôy hngơy, gô 'ngôôy pato dayq đom hnhư hơu đơu êêp kơy heq be rôp gô. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Bơh kaluh varơuq neq xalih vlôh xôq kaluh valơk xôq ku khơl hnhư hlit hnoq ik jah jêêk.” Tuôôy nưq, tuôôy ka'lăk Kadraq hlê yôôch, dêq hloay khơl xatyauq heq xadăk klôônq.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Tuôôy nưq, khơl dro rôp Lôôk Jê-xu heq jarooy Kadraq truh ka khơl thơy tơơk tưp kôt Kai-phe, laa aduq đơu khơl thơy pato ganuun ji khơl draq jah anguk hlê kung mamuuyq. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Măn Phi-e-rơ hooy tyauq Kadraq xing kơn xangưưy dong truh chaal ku thơy tơơk tưp kôt. Tuôôy muut pi 'lăp yôôch, kơy 'ngôôy pôôt muuyq aduq dii bing kuun jư 'yo xôq 'yo varơuq nưq hnoq đaleq. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Tuôôy nưq, khơl thơy tơơk tưp kôt ji dêq hloay khơl Hnhư Anguk đong axek xanưk lar tachơơl hlê Lôôk Jê-xu, dơơp aleq ka oot hnoq ik rôp xadrah păk kaxêêt Kadraq. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ji oot leh axek jah kajoq, long 'ngưng dro dơơp xanưk lar heq dưk vlôh. Bơh atêq nưq vaarq dro hơq tawaak truh, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />heq đnooy: “Dro neq heq đnooy: ‘Gô hnoq ik pahyaak ka'lăk hnhư hơu ku Kơy Plêêk ji xơy panưk hlê đom pe hngơy.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Atêq tuôôy dưk tok, thơy tơơk tưp kôt dăt Kadraq: “Ay leh tơơl apok ih? Khơl dro neq đong dơơp xanưk tachơơl hlê ay varơuq kajoq đahơq?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Bơh Lôôk Jê-xu leh tơơl. Thơy tơơk tưp kôt đnooy dii Kadraq: “Bơyh Kơy Plêêk hloay riirh, gô băt ay xôq ay đnooy ka 'wot xet jơq ay e aalq laa Lôôk Wơơt Dêh, Koot Kơy Plêêk, long leh?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Lôôk Jê-xu đnooy kung kơy nưq: “Kadih kơy heq đnooy đanưq. Long anưq, gô đnooy ka êêp kơy xet, xing neng kơn atêq, êêp kơy hnoq hloq Koot Manih 'ngôôy măn pi akoh ku Kơy Taay Yaak, ji ra-ma truh tol kaluh đum kluk plêêk.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Tuôôy nưq, thơy tơơk tưp kôt heq chieh aau yơơt ni, đnooy: “Ni katơơk galơh! Aleq haay măn duh manih xanưk đnoyq? 'Yo hơq, juneq êêp kơy heq tameng apok katơơk galơh nưq yôôch. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Êêp kơy biit đaleq?” Yôôch tuôôy tơơl apok, oot đnooy: “Ni dik laa xưng Kaxêêt.” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Atêq nưq, oot kaxôh muut mot Kadraq, tiel tu Kadraq, yôôch pađa Kadraq, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />đaneq: “Nee Lôôk Wơơt Dêh, đnooy hlit ka 'wot yơu. Kơyq laa dro heq hmơt kơy?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Tuôôy nưq, Phi-e-rơ đong 'ngôôy đom chaal pi gôk, ji muuyq xapok kadrê truh jeq kơy, đnooy: “Kơy kung măn muuyq aduq dii Jê-xu, manih Ga-li-lê.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Bơh kơy chôôyq kangưưr tôôy dro, đaneq: “Gô be xet mư đong đnooy kajoq.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Yôôch atêq tuôôy hooy vlôh truh 'mok kôt, muuyq xapok kadrê kadrơy heq 'yo hloq kơy ji đnooy dii khơl dro măn đnư: “Dro neq măn muuyq aduq dii Jê-xu, manih Na-xa-ret.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Ji kơy laay chôôyq kung dii muuyq apok paleek, đaneq: “Gô be xet dro nưq!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Bơh muuyq xit tra, khơl dro hmưq dưk đnư, atêq tuôôy truh jeq, heq đnooy dii Phi-e-rơ: “Kajưk dik kơy kung măn đom sôôq bing oot, vii hloay ka trôôk đnooy ku kơy dơơp ka kơy tauq vlôh.” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Tuôôy nưq, kơy xarôp axaap, ji paleek đaneq: “Gô be xet dro nưq,” yôôch vơ hloay, ier rok. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Ji Phi-e-rơ văch hlê kaluh apok ku Lôôk Jê-xu heq đnooy, đaneq: “Adroyq tuôôy ier rok, ay hnoq chôôyq thơy pe yưk.” Yôôch tuôôy heq hooy vlôh pi gôk, kơy nhim ook kach areh xuum.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Tuôôy nưq, muut tuôôy xaroq meel, dêq hloay khơl thơy tơơk tưp kôt ji khơl draq đom manih karôp heq tajauq xôq vih dơơp đaleq tachơơl hlê Lôôk Jê-xu xôq păk kaxêêt Kadraq dơyh. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Tuôôy heq vek Kadraq hlê, oot jarooy Kadraq hooy ji noop ăm ka padrok dêh Phi-lat.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Tuôôy nưq, atêq tuôôy Ju-đa, dro xalih xuum Kadraq, hloq đaneq Kadraq heq biq rôp xadrah, yôôych vii wiit xuum, ni heq bla hlê pe kưl xiêk-lơ baak ka khơl thơy tơơk tưp kôt ji khơl draq, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />đnooy đaneq: “Gô heq lôp kadrôôp vii noop vahaap be e kadrôôp.” Bơh oot đnooy: “Tajinq kajoq truh 'wot? Ay kadih chiuq.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Ji atêq tuôôy qweek taleq xiêk-lơ baak muut đom hnhư hơu, ni wih xuq, ji tuôôy hooy xangưưy yôôch, ni hnek ranong kaxêêt kadih. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Tuôôy nưq, atêq tuôôy tôôch sôôq xiêk-lơ baak tok, khơl thơy tơơk tưp kôt đnooy: “Xôq sôôq baak neq muut kho ku hnhư hơu laa leh xaay vii nưq laa kajaq ku vahaap.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Bơh tuôôy heq athêêk tajauq yôôch, oot heq root manay hluôôt ku dro thơq hu vari bơơn sôôq baak nưq deng ka varơuq up xôq khơl xing kadrơy. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Vii anưq, manay hluôôt nưq jah taayh laa “Ruôngq Vahaap” dong truh hngơy neng. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Anưq laa, raay jah đnooy adroyq bơyh hnhư hlit Jê-rê-mi heq jah jêêk, đaneq: “Oot xok pe kưl xiêk-lơ baak, laa kajaq ku dro jah đinq, laa dro đơu heq jah jauq jaq xing aduq koot xau I-sơ-ra-ên, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ji oot heq ăm sôôq baak nưq xôq xok manay hluôôt ku thơq hu vari, dang đaji Lôôk heq đnooy pato gô.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Tuôôy nưq, Lôôk Jê-xu dưk kangưưr padrok dêh, ji kơy padrok nưq vôôch 'yo Kadraq, đaneq: “Jơq be ay laa vuua manih Jo Thaiq?” Yôôch Lôôk Jê-xu đnooy dii kơy nưq: “Kơy đong đnooy nưq.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ji đom tuôôy Kadraq biq rôp kadrôôp xing khơl thơy tơơk tưp kôt ji khơl draq, yôôych Kadraq be tơơl hlê varơuq kajoq. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Atêq nưq, Phi-lat đnooy kung Kadraq: “Ay leh tameng xet dong leq varơuq oot đong dơơp xanưk tachơơl hlê ay ih?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ji Kadraq heq leh tơơl apok kơy nưq, pheq đnooy bơơn muuyq apok kung leh, pheq dơơp padrok dêh hloq akêh dik. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Tuôôy nưq, muut katuôôy lêh, padrok dêh 'miêh e ganuun luh vlôh ka manih karôp muuyq dro lôp kadrôôp đơu oot rơơlh xok. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Mot kadrơy, đom kawat nưq, khơl drơy đong karuk muuyq dro tu kơyq kung xet jah taayh laa Ba-ra-ba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Anưq, atêq tuôôy oot jah anguk hlê, Phi-lat đnooy dii oot: “Êêp kơy trôôch gô luh kơyq ka êêp kơy? Ba-ra-ba, long Jê-xu, dro jah taayh laa Lôôk Wơơt Dêh?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Vii kơy 'miêh xet đaneq oot heq noop Kadraq ka kơy xing xuum 'yo 'yarơ. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Tuôôy nưq, đom tuôôy kơy đong 'ngôôy tol ragê xưh xadrah, kadrê ku kơy heq patăk atăq apok đnooy truh kơy, đaneq: “Apôôy be varơuq kajoq xalih truh ka ay ji ka manih hyioh jăk nưq. Vii hngơy neng, oh jiq areh paq ik bơyh muuyq vik apau truh dro neq.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Măn khơl thơy tơơk tưp kôt ji khơl draq ahluk manih karôp xôq oot đnooy dăt luh Ba-ra-ba đơu păk kaxêêt Lôôk Jê-xu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Bơh xôq tơơl hlê, padrok dêh đnooy dii oot: “Êêp kơy trôôch gô luh kơyq đom vaarq dro neq ka êêp kơy?” Yôôch oot đnooy: “Ba-ra-ba.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-lat đnooy dii oot: “Anưq, gô kơn dơơp kajoq dii Jê-xu, manih jah taayh laa Lôôk Wơơt Dêh?” Dêq hloay bing oot tơơl: “Ni pheq biq đongq đing tol gay charăk.” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Bơh kơy đnooy: “Vii varơuq xơk leq đơu ay nưq heq lôp?” Lunư, oot kơn tarok kôt iaq, đaneq: “Ni pheq biq đongq đing tol gay charăk.” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Tuôôy nưq, Phi-lat, atêq tuôôy hloq đaneq ni leh waak ik kajoq, bơh tađôôy muut đnư, muuyq đơơt paloanq đong xung vlôh, yôôych tuôôy ăm xok daak yôôch, kơy heq 'nhaau ti kơy kangưưr manih karôp, đnooy: “Gô leh e kadrôôp aduq vahaap ku dro neq. Êêp kơy kadih chiuq.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Ji tuôôy tơơl hlê, dêq hloay manih karôp đnooy: “Vahaap ku ni măn tol 'wot ji tol koot xau 'wot.” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Atêq nưq, kơy nưq luh Ba-ra-ba ka oot, yôôch tuôôy heq ăm tiel Lôôk Jê-xu, Kơy ăm jarooy Kadraq hooy xôq chiuq đongq đing tol gay charăk.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Tuôôy nưq, atêq tuôôy jarooy Lôôk Jê-xu muut đom hnhư padrok dêh, khơl bing kuun ku padrok dêh heq anguk hlê kangưưr Kadraq dêq hloay bing kuun. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Atêq tuôôy leh aau Kadraq, oot pahlưp muuyq poop aau aklum phôôm dôôp rưk tol Kadraq. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Tuôôy dơơp muuyq poop đoat bơơn jaliê yôôch, oot xôq tol akoq Kadraq, kung gay muut ti akoh Kadraq, ji atêq tuôôy kul pôôt kangưưr Kadraq, oot đnooy ra ơơh Kadraq, đaneq: “Kuh qwaay Vuua tamooy Jo Thaiq!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Yôôch atêq tuôôy kaxôh muut Kadraq, oot xok gay ji kưq tiel tol akoq Kadraq. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Tuôôy oot đnooy ra ơơh Kadraq yôôch, oot leh aau aklum vlôh ji pahlưp muut ka Kadraq aau ku Kadraq, yôôch ahwoa Kadraq hooy xôq đongq đing tol gay charăk.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Tuôôy nưq, đong tuôôy hooy vlôh, oot hloq muuyq dro xing Si-ren, anơng Si-môn, đơu oot băt dăt xôq kơy hlôôy gay charăk ku Kadraq. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Atêq tuôôy hooy truh muuyq aduq jah taayh laa Gô-gô-tha, đơu aduq nưq iq laa “Aduq Kadah,” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Oot ăm Kadraq hôôch lok jah aluq dii kamit pahlăk. Tuôôy heq nhemq yôôch, yôôych Kadraq leh chiuq hôôch. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Tuôôy nưq, tuôôy đongq đing Kadraq tol gay charăk yôôch, oot ahlook mamuuyq aau ku Kadraq bơơn varơuq bôk thăm, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />ji oot 'yo jư Kadraq, tuôôy 'ngôôy aduq nưq. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Pi ataalh akoq Kadraq, oot xôq athêêp apok rôp kadrôôp ku Kadraq, jah valơk luneq: “Neq laa Jê-xu, Vuua manih Jo Thaiq.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Tuôôy nưq, e vaarq dro varoh biq đongq đing dii Kadraq, muuyq dro măn pi akoh ji muuyq dro măn pi akeng. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Khơl dro hooy dalơh đnooy ra ơơh Kadraq, ngol ngelh akoq oot <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />ji đnooy: “Nee dro pahyaak ka'lăk hnhư hơu ji panưk hlê đom pe hngơy hơq, dayh kadih wơơt xăk yơu! Atoh may laa Koot Kơy Plêêk, yôôych dayh pôôt klơlh gay charăk!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Kung muuyq đanưq, khơl thơy tơơk tưp kôt, kung dii khơl thơy pato ganuun ji khơl draq, tuôôy đnooy ra ơơh Kadraq, heq đnooy: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Ni heq wơơt khơl dro kadrơy; ni yôôych be e paraat kadih wơơt ni. Ni laa Vuua ku I-sơ-ra-ên. Juneq, ni pheq pôôt klơlh gay charăk, yôôych haay hnoq tuôq aduq ni. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ni tuôq gamưh aduq Kơy Plêêk; Juneq yôôych dayh xôq Kadraq wơơt ni atoh Kadraq trôôch ni. Vii ni heq đnooy đaneq: ‘Gô laa Koot Kơy Plêêk.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Mot kadrơy, kadih taleq dro atôk, laa khơl dro biq đongq đing dii Kadraq, bing oot kung đnooy ra ơơh Kadraq.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Tuôôy nưq, xing wat thưq drơu, kamơng jaluk vlôh e tol loch dêq dêh dong truh wat thưq xit. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Yôôch kawah wat thưq xit, Lôôk Jê-xu taayh muuyq apok kôt, đaneq: “Ê-li, Ê-li, la-ma sa-bach-tha-ni?” iq laa “Kơy Plêêk gô lơơy, Kơy Plêêk gô lơơy, aleq Kadraq chuh ka'lăk gô?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Bơh atêq tuôôy tameng anưq, taleq dro 'miêh dưk đnư đnooy đaneq: “Ni taayh Ê-li.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Vơ hloay, muuyq dro đom sôôq oot, atêq tuôôy charơơk hooy ji xok kuk kamuh tahli, vơ hnhuuk viik daak voh đơu ta'măk tol gay kadeer, heq palo ka Kadraq hôôch. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Bơh khơl dro măn laay đnooy: “Dayh kê ka ni. Haay 'yo lưp e Ê-li e truh wơơt ni be.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Anưq yôôch, atêq tuôôy laay taayh atok muuyq apok kôt, Lôôk Jê-xu truut phool hiel. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Ji 'yo hơq, tômq vaayh ku hnhư hơu biq chieh dơơp vaarq xing taalh pôôt 'laarq, măn vari biq ahrưng, ji phơu kôt biq padah vlôh. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />'Ngưng xanưng biq luh hwong ji 'ngưng xaak ku khơl manih vah heq vik jah khienq riirh hlê. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ji tuôôy vlôh klơlh xanưng atêq varơuq riirh hlê ku Kadraq, oot heq muut đom theng vah ji rama vlôh ka 'ngưng dro. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Tuôôy nưq, atêq tuôôy hloq ahrưng vari ji kaluh varơuq xalih vlôh, padrok xanok kuun kung khơl dro đong jư 'yo Lôôk Jê-xu kung dii kơy heq biq varaal yôq paq ik, đnooy đaneq: “Dong dik, dro neq laa Koot Kơy Plêêk.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Măn e 'ngưng khơl drê aduq nưq, 'yo tavooy xing xangưưy, laa khơl dro heq hooy tyauq Lôôk Jê-xu, hơu varơuq Kadraq xing dêh Ga-li-lê. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Đom sôôq oot e Ma-ri Ma-đơ-len, Ma-ri miq Ja-kơ ji Jô-sep, kung miq ku khơl koot kanau Xê-bê-đê.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Tuôôy nưq, tuôôy heq truh rayôôp klôôy, muuyq dro karoh heq truh xing A-ri-ma-thê, anơng laa Jô-sep, đơu kadih xăk kơy kung chiuq dơơp khơl xatyauq tyauq Lôôk Jê-xu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Atêq tuôôy truh tavơh Phi-lat, kơy vôôch xaak Lôôk Jê-xu. Tuôôy nưq, Phi-lat patăk ăm xôq xaak jah pahnăp ka kơy. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Tuôôy heq xok xaak, Jô-sep ahnom xaak nưq hlê đom vaayh lanh xarêh, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />yôôch xôq xaak muut xanưng đơơu ku kadih kơy đơu kơy heq đuk đom troop phơu. Tuôôy palanh muuyq kuk phơu kôt kateep 'mok xanưng yôôch, kơy chuh hooy. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Tuôôy nưq, Ma-ri Ma-đơ-len ji muuyq Ma-ri kadrơy măn đnư, 'ngôôy tahyioh dii troop xanưng.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Yôôch hngơy atêq, nưq laa atêq hngơy Ralauq Xôq, khơl thơy tơơk tưp kôt ji khơl manih Pha-ri-si heq jah anguk tagumq hlê kangưưr Phi-lat, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />tơơl đaneq: “Kuh padrok, 'wot văch đaneq tuôôy măn riirh, adro pa ôôh lar hơq heq đnooy: ‘Atêq pe hngơy, yôôych gô jah khienq riirh hlê.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Kơq nưq, xiin ăm apok xôq xanưng jah jư kajưk dong kajưk dong truh hngơy thưq pe. Atoh leh, khơl xatyauq ku ni truh yôôch, hnoq ik atôk xaak ni, ji đnooy dii manih karôp: ‘Kadraq heq jah khienq riirh hlê xing aduq kaxêêt,’ yôôych varơuq pa ôôh aluut atêq neq hnoq măn ra ơơh iaq tuôôy droyq.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Anưq yôôch Phi-lat đnooy dii oot: “Êêp kơy e kuun jư 'yo. Hooy yơu, pheq jư kajưk dong kajưk đaji êêp kơy xet.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Yôôch atêq tuôôy hooy, dơơp dơuq tol phơu 'mok kung dii kuun jư 'yo, oot hôôk kajưk xanưng jah jư kajưk.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Tuôôy nưq, atêq hngơy Sa-bat, tuôôy xaroq meel hngơy droyq dik đom twuân đong truh, Ma-ri Ma-đơ-len ji muuyq Ma-ri kadrơy truh hlơq xanưng. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />'Yo hơq, muuyq đơơt ahrưng vari kôt heq xalih vlôh, vii muuyq yaak plêêk ku Lôôk, atêq tuôôy xing plêêk kahri pôôt ji truh jeq, heq palanh kuk phơu yôôch 'ngôôy tol nưq. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Tuôôy nưq, long lơuq ku kơy nưq yôôych dang đaji kablek, măn aau ku kơy yôôych ko đaji raak parier. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Anưq yôôch, kơq padrau vadrih vii kơy nưq, bing kuun jư 'yo biq phoch ji vlôh jêêk đaji dro kaxêêt. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Bơh tuôôy lơh apok, yaak plêêk đnooy dii khơl dro khơl drê: “Êêp ay te yôq, vii gô xet đaneq êêp ay axek Lôôk Jê-xu, Kơy heq biq đongq đing. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Kadraq leh măn đnen 'leq, vii Kadraq jah khienq riirh hlê yôôch, jơq dang đaji Kadraq heq xanoh. Truh đnen yơu, dayh 'yo aduq đơu Kadraq heq vik. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Yôôch atêq tuôôy dayh dayh dưk hooy, dayh taboon ka khơl xatyauq Kadraq đaneq: ‘Kadraq heq jah khienq riirh hlê xing aduq kaxêêt. Ji 'yo hơq, Kadraq đong hooy adroyq oh ay truh Ga-li-lê, Aduq nưq, oh ay hnoq tavơh Kadraq.’ 'Yo nee, gô heq đnooy ka êêp mư xet yôôch nưq.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Ji tuôôy dayh dayh chuh klơlh xanưng dii varơuq varaal yôq hloay hlah hlaak paq ik, oot heq charơơk hooy xôq taboon hêêl ka khơl xatyauq ku Kadraq. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />'Yo nee, Lôôk Jê-xu tavơh oot, đnooy: “Wơơy khơl mư!” Yôôch atêq tuôôy truh jeq, oot kabiin jôôk Kadraq ji kuh ayuôôt Kadraq. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Atêq nưq, Lôôk Jê-xu đnooy dii oot: “Te yôq. Dayh hooy, taboon hêêl ka khơl oh ay ku thơy xôq oot hnoq ik dưk hooy truh Ga-li-lê, ji aduq nưq, oot hnoq tavơh thơy.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Tuôôy nưq, đong tuôôy oot hooy trôôk, 'yo nee, taleq dro đom sôôq bing kuun jư 'yo, atêq tuôôy muut đom theng, heq taboon hlê ka khơl thơy tơơk tưp kôt tôôy varơuq heq xalih vlôh. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Ji tuôôy heq jah anguk hlê kung dii khơl draq, vơ hloay tajauq athêêk yôôch, oot heq ăm bing kuun muuyq sôôq jêêt dong taxưngq, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />dăt đaneq: “Dayh đnooy: ‘Atêq tuôôy truh muut ka klôôy, khơl xatyauq ku ni heq atôk xaak ni đom tuôôy 'wot đong vik.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ji atoh hêêl neq jah đnooy ka padrok xanok dêh, 'wot hnoq đnooy xok xuum kơy nưq ji dơơp ka êêp ay klơlh pơơl hwơơl.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Anưq yôôch, atêq tuôôy xok jêêt, bing nưq dơơp đaji heq jah patăk dăt. Hêêl neq jah đnooy vlôh ranưh ranơơy đom tamooy Jo Thaiq, pheq đnooy dong truh hngơy neng.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Tuôôy nưq, kưl muuyq khơl xatyauq heq hooy truh Ga-li-lê, truh ngok đoot đơu Lôôk Jê-xu heq pato đnooy ka oot. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Ji tuôôy heq tavơh Kadraq, oot kuh ayuôôt Kadraq, bơh taleq dro biit ravơq. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Atêq tuôôy tawaak truh jeq, Lôôk Jê-xu athêêk dii oot, đaneq: “Tôôy qwuyen da uh tol plêêk ji 'laarq vari heq jah pahnăp ka thơy. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Vii anưq, tuôôy hooy, oh ay dayh pato khienq dêq hloay kaluh tamooy, dơơp bap-tem ka oot đom yal Vaq, Koot ji Kơy Phool Hiel; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />pato dayq oot xôq tameng jư tôôy varơuq đơu thơy heq pato ka oh ay. Ji 'yo nee, thơy măn kung dii oh ay tôôy hngơy dong truh hngơy hlơơp dêh.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>