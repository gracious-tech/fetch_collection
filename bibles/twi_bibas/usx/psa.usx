<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Nnwom</para>
  <para style="toc1">Nnwom</para>
  <para style="toc2">Nnwom</para>
  <para style="toc3">Nnw</para>
  <para style="mt1">Nnwom</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">NKYƐMU A ƐDI KAN</para>
  <para style="mr">
    <ref loc="PSA 1-41">Nnwom 1–41</ref></para>
  <para style="cl">Dwom 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Nhyira ne onipa a</para>
  <para style="q2" vid="PSA 1:1">ɔntie amumuyɛfoɔ afotuo</para>
  <para style="q1" vid="PSA 1:1">na ɔnni nnebɔneyɛfoɔ nhwɛsoɔ akyi</para>
  <para style="q2" vid="PSA 1:1">na ɔntena fɛdifoɔ tenabea.<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>Na mmom, <char style="nd">Awurade</char> mmara sɔ nʼani,</para>
  <para style="q2" vid="PSA 1:2">na ɔdwene ho awia ne anadwo.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Ɔte sɛ dua a wɔatɛ wɔ asutene ho,</para>
  <para style="q2" vid="PSA 1:3">na ɛso nʼaba ne berɛ mu a</para>
  <para style="q1" vid="PSA 1:3">nʼahahan no nnwan.</para>
  <para style="q2" vid="PSA 1:3">Deɛ ɔyɛ biara yɛ yie.<verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Nanso nnebɔneyɛfoɔ nte saa;</para>
  <para style="q2" vid="PSA 1:4">wɔte sɛ ntɛtɛ a</para>
  <para style="q2" vid="PSA 1:4">mframa bɔ guo.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Enti amumuyɛfoɔ rentumi nnyina atemmuo no ano,</para>
  <para style="q2" vid="PSA 1:5">na nnebɔneyɛfoɔ nso rentena teneneefoɔ asafo mu.<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Ɛfiri sɛ <char style="nd">Awurade</char> kyerɛ ɔteneneeni kwan</para>
  <para style="q2" vid="PSA 1:6">nanso amumuyɛfoɔ kwan deɛ, ɛbɛyera.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">Dwom 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Adɛn enti na amanamanmufoɔ no bo afu?</para>
  <para style="q2" vid="PSA 2:1">Adɛn enti na wɔsɛe mmerɛ yɛ nhyehyɛeɛ hunu yi?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Asase so ahemfo sɔre gyina</para>
  <para style="q2" vid="PSA 2:2">na atumfoɔ bom tu agyina</para>
  <para style="q2" vid="PSA 2:2">tia <char style="nd">Awurade</char> ne Deɛ Wɔasra no no.<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>Wɔka sɛ,</para>
  <para style="q2" vid="PSA 2:3">“Momma yɛmmubu wɔn nkɔnsɔnkɔnsɔn</para>
  <para style="q2" vid="PSA 2:3">na yɛnto wɔn mpokyerɛ ngu.”<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Deɛ ɔte adwa so wɔ soro no sere;</para>
  <para style="q2" vid="PSA 2:4">
    <char style="nd">Awurade</char> di wɔn ho fɛw.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Afei ɔka wɔn anim wɔ nʼabufuo mu</para>
  <para style="q2" vid="PSA 2:5">hunahuna wɔn wɔ nʼabufuhyeɛ mu, ka sɛ,<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“Masi me Ɔhene</para>
  <para style="q2" vid="PSA 2:6">wɔ Sion, me bepɔ kronkron no so.”<verse eid="PSA 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>Mɛpae mu aka <char style="nd">Awurade</char> ahyɛdeɛ:</para>
  <para style="q1" vid="PSA 2:7">Ɔka kyerɛɛ me sɛ, “Woyɛ me Babarima;</para>
  <para style="q2" vid="PSA 2:7">ɛnnɛ mayɛ wʼAgya.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Bisa me,</para>
  <para style="q2" vid="PSA 2:8">na mede amanaman nyinaa bɛyɛ wʼagyapadeɛ,</para>
  <para style="q2" vid="PSA 2:8">asase ano nyinaa bɛyɛ wo dea.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Wode dadeɛ ahempoma bɛdi wɔn so;</para>
  <para style="q2" vid="PSA 2:9">na woabobɔ wɔn sɛ ɔnwomfoɔ ahina.”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Enti mo ahemfo, monsua nyansa;</para>
  <para style="q2" vid="PSA 2:10">monkae kɔkɔbɔ yi, mo asase sodifoɔ.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Momfa suro nsom <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 2:11">na monsɛpɛ mo ho ahopopoɔ mu.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Momfe Ɔba no ano, na ne bo amfu</para>
  <para style="q2" vid="PSA 2:12">ansɛe mo wɔ mo akwan so,</para>
  <para style="q1" vid="PSA 2:12">ɛfiri sɛ nʼabufuhyeɛ tumi sɔre ntɛm so.</para>
  <para style="q2" vid="PSA 2:12">Nhyira ne wɔn a wɔdwane toa no nyinaa.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">Dwom 3</para>
  <para style="d">Dawid dwom a ɔtoeɛ ɛberɛ a ɔredwane afiri ne babarima Absalom anim.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>Ao <char style="nd">Awurade</char>, hwɛ sɛdeɛ mʼatamfoɔ dɔɔso fa!</para>
  <para style="q2" vid="PSA 3:1">Dodoɔ no ara na wɔsɔre tia me!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Bebree no ara ka fa me ho sɛ,</para>
  <para style="q2" vid="PSA 3:2">“Onyankopɔn rennye no”.<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>Nanso, Ao <char style="nd">Awurade</char>, woyɛ akokyɛm a atwa me ho ahyia</para>
  <para style="q2" vid="PSA 3:3">wohyɛ me animuonyam na wopagya me ti.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Meteam su frɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 3:4">na ɔgye me so firi ne bepɔ kronkron no so.<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Metɔ hɔ na meda a,</para>
  <para style="q2" vid="PSA 3:5">menyane bio, ɛfiri sɛ <char style="nd">Awurade</char> kora me so.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Merensuro atamfoɔ mpem mpem a</para>
  <para style="q2" vid="PSA 3:6">wɔatwa me ho ahyia no.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Sɔre, Ao <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 3:7">Gye me, Ao me Onyankopɔn!</para>
  <para style="q1" vid="PSA 3:7">Bobɔ mʼatamfoɔ nyinaa apantan;</para>
  <para style="q2" vid="PSA 3:7">na tutu amumuyɛfoɔ se.<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>
    <char style="nd">Awurade</char> hɔ na ɔgyeɛ firi ba.</para>
  <para style="q2" vid="PSA 3:8">Ma wo nhyira mmra wo nkurɔfoɔ so.</para>
  <para style="d" vid="PSA 3:8">Wɔde ma dwomkyerɛfoɔ. Wɔto wɔ sankuhoma so.<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">Dwom 4</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>Sɛ mesu frɛ wo a, gye me so,</para>
  <para style="q2" vid="PSA 4:1">Ao, me tenenee Onyankopɔn.</para>
  <para style="q1" vid="PSA 4:1">Ma me ahomegyeɛ wɔ mʼahohia mu;</para>
  <para style="q2" vid="PSA 4:1">hunu me mmɔbɔ na tie me mpaeɛbɔ.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>Ao mmarima, ɛnkɔsi da bɛn na mo bɛdane mʼanimuonyam ahohora?</para>
  <para style="q2" vid="PSA 4:2">Ɛnkɔsi da bɛn na mobɛdɔ nneɛma hunu na moadi ahoni huhuo akyi?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Hunu sɛ <char style="nd">Awurade</char> ayi deɛ ɔwɔ nyamesu ama ne ho;</para>
  <para style="q2" vid="PSA 4:3">
    <char style="nd">Awurade</char> bɛtie, sɛ mesu mefrɛ no a.<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Mo bo fu a, monnyɛ bɔne;</para>
  <para style="q2" vid="PSA 4:4">sɛ modeda mo mpa so a,</para>
  <para style="q2" vid="PSA 4:4">monyɛ komm na monhwehwɛ mo akoma mu.<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Mommɔ afɔdeɛ a ɛfata</para>
  <para style="q2" vid="PSA 4:5">na momfa mo werɛ nhyɛ <char style="nd">Awurade</char> mu.<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Nnipa bebree bisa sɛ:</para>
  <para style="q2" vid="PSA 4:6">“Hwan na ɔbɛtumi ayɛ yɛn adɔeɛ?”</para>
  <para style="q2" vid="PSA 4:6">Ao <char style="nd">Awurade</char>, ma wʼanim hann no nhyerɛn yɛn so.<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Wode anigyeɛ mmorosoɔ ahyɛ mʼakoma ma</para>
  <para style="q2" vid="PSA 4:7">asene ɛberɛ a wɔn aburoo ne nsã foforɔ abu so no.<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Mɛtɔ hɔ, na mada asomdwoeɛ mu,</para>
  <para style="q2" vid="PSA 4:8">ɛfiri sɛ, wo nko ara, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 4:8">na woma metena asomdwoeɛ mu.</para>
  <para style="d" vid="PSA 4:8">Wɔde ma dwomkyerɛfoɔ sɛ wɔmfa atɛntɛbɛn nto.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">Dwom 5</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>Ao <char style="nd">Awurade</char>, yɛ aso ma me nsɛm</para>
  <para style="q2" vid="PSA 5:1">na dwene mʼapinisie ho.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Tie me mmoa ho sufrɛ,</para>
  <para style="q2" vid="PSA 5:2">me Ɔhene ne me Onyankopɔn,</para>
  <para style="q2" vid="PSA 5:2">ɛfiri sɛ wo na mebɔ wo mpaeɛ.<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>Ao, <char style="nd">Awurade</char>, wote me nne anɔpa;</para>
  <para style="q2" vid="PSA 5:3">anɔpa, mede mʼadesrɛ ba wʼanim</para>
  <para style="q2" vid="PSA 5:3">na mede anidasoɔ twɛn.<verse eid="PSA 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Wonyɛ Onyankopɔn a wʼani gye bɔne ho;</para>
  <para style="q2" vid="PSA 5:4">na amumuyɛfoɔ rentumi ne wo ntena.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Ahantanfoɔ rentumi nnyina wʼanim;</para>
  <para style="q2" vid="PSA 5:5">wokyiri wɔn a wɔyɛ bɔne nyinaa.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Wosɛe wɔn a wɔka atorɔsɛm;</para>
  <para style="q2" vid="PSA 5:6">
    <char style="nd">Awurade</char> kyiri</para>
  <para style="q2" vid="PSA 5:6">mogyapɛfoɔ ne asisifoɔ.<verse eid="PSA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Nanso me, wo mmɔborɔhunu bebrebe enti,</para>
  <para style="q2" vid="PSA 5:7">mɛba wo fie;</para>
  <para style="q1" vid="PSA 5:7">na anidie mu na mɛkoto</para>
  <para style="q2" vid="PSA 5:7">akyerɛ wʼasɔredan kronkron no.<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>Ao <char style="nd">Awurade</char> kyerɛ me ɛkwan</para>
  <para style="q2" vid="PSA 5:8">wɔ wo tenenee mu</para>
  <para style="q2" vid="PSA 5:8">mʼatamfoɔ enti,</para>
  <para style="q2" vid="PSA 5:8">bɔ wo kwan tee wɔ mʼanim.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Wɔn anom asɛm baako mpo nyɛ nokorɛ;</para>
  <para style="q2" vid="PSA 5:9">ɔsɛeɛ ahyɛ wɔn akoma ma.</para>
  <para style="q1" vid="PSA 5:9">Wɔn menewa yɛ damena a ɛso abue</para>
  <para style="q2" vid="PSA 5:9">wɔde wɔn tɛkrɛma ka nnaadaasɛm.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Ao, Onyankopɔn, bu wɔn fɔ!</para>
  <para style="q2" vid="PSA 5:10">Ma wɔn pɔ bɔne nyɛ wɔn ahweaseɛ.</para>
  <para style="q1" vid="PSA 5:10">Pam wɔn ɛsiane wɔn bɔne dodoɔ no enti,</para>
  <para style="q2" vid="PSA 5:10">ɛfiri sɛ wɔasɔre atia wo.<verse eid="PSA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>Nanso, ma wɔn a wɔdwane ba wo nkyɛn no ani nnye;</para>
  <para style="q2" vid="PSA 5:11">ma wɔmfa anigyeɛ nto dwom daa.</para>
  <para style="q1" vid="PSA 5:11">Trɛ wo banbɔ mu wɔ wɔn so,</para>
  <para style="q2" vid="PSA 5:11">na wɔn a wɔdɔ wo din no</para>
  <para style="q2" vid="PSA 5:11">ma wɔn ani nnye wɔ wo mu.<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>Ao <char style="nd">Awurade</char>, ampa ara, wohyira teneneefoɔ;</para>
  <para style="q2" vid="PSA 5:12">na wode wʼayamyɛ twa wɔn ho hyia te sɛ akokyɛm.</para>
  <para style="d" vid="PSA 5:12">Wɔde ma dwomkyerɛfoɔ sɛ ɔmfa sankuhoma nto wɔ Seminit ɛnne so.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">Dwom 6</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>Ao, <char style="nd">Awurade</char> nka mʼanim wɔ wʼabofuo mu,</para>
  <para style="q2" vid="PSA 6:1">na ntwe mʼaso nso wɔ wʼabufuhyeɛ mu.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Hu me mmɔbɔ, <char style="nd">Awurade</char>, ɛfiri sɛ meyɛ mmrɛ;</para>
  <para style="q2" vid="PSA 6:2">Ao <char style="nd">Awurade</char> sa me yadeɛ</para>
  <para style="q2" vid="PSA 6:2">na me nnompe wɔ ahoyera mu.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Me kra wɔ ahohia mu.</para>
  <para style="q2" vid="PSA 6:3">Ɛnkɔsi da bɛn, Ao <char style="nd">Awurade</char>, ɛnkɔsi da bɛn?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Sane bra, Ao <char style="nd">Awurade</char>, na bɛgye me nkwa;</para>
  <para style="q2" vid="PSA 6:4">gye me, wo dɔ a ɛnni hwammɔ no enti.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Obi a wawuo no renkae wo da,</para>
  <para style="q2" vid="PSA 6:5">hwan na ɔfiri damena mu kamfo woɔ?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Apinisie ama mayɛ mmerɛ.</para>
  <para style="q2" vid="PSA 6:6">Anadwo mu nyinaa mede agyaadwotwa fɔ me mpa</para>
  <para style="q2" vid="PSA 6:6">na me nisuo fɔ me sumiiɛ.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Awerɛhoɔ ama mʼani so ayɛ me kusuu.</para>
  <para style="q2" vid="PSA 6:7">Ɛredum mʼatamfoɔ nyinaa enti.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Mo nnebɔneyɛfoɔ, montwe mo ho mfiri me ho,</para>
  <para style="q2" vid="PSA 6:8">ɛfiri sɛ <char style="nd">Awurade</char> ate me sufrɛ.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>
    <char style="nd">Awurade</char> ate me mmɔborɔ su;</para>
  <para style="q2" vid="PSA 6:9">
    <char style="nd">Awurade</char> tie me sufrɛ.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Mʼatamfoɔ nyinaa anim bɛgu ase</para>
  <para style="q2" vid="PSA 6:10">na wɔn ho adwiri wɔn;</para>
  <para style="q2" vid="PSA 6:10">na wɔapatu de fɛreɛ asane wɔn akyi.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">Dwom 7</para>
  <para style="d">Dawid adesrɛ dwom a Benyaminni Kus nsɛm enti ɔto maa <char style="nd">Awurade</char>.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>Ao, <char style="nd">Awurade</char> me Onyankopɔn,</para>
  <para style="q2" vid="PSA 7:1">medwane metoa wo;</para>
  <para style="q2" vid="PSA 7:1">Gye me firi wɔn a wɔtaa me nyinaa nsam,<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>anyɛ saa a wɔbɛtete me mu sɛ gyata</para>
  <para style="q2" vid="PSA 7:2">na wɔatete me mu asinasini a</para>
  <para style="q2" vid="PSA 7:2">obiara rentumi nnye me.<verse eid="PSA 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>Ao, <char style="nd">Awurade</char> me Onyankopɔn, sɛ mayɛ yei</para>
  <para style="q2" vid="PSA 7:3">na sɛ afɔdie aba me so a,<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>sɛ mayɛ bɔne atia deɛ ɔne me te yie</para>
  <para style="q2" vid="PSA 7:4">anaasɛ mabɔ me ɔtamfoɔ korɔno kwa a,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>ɛnneɛ ma mʼatamfoɔ ntaa me na wɔmmɛto me;</para>
  <para style="q2" vid="PSA 7:5">ma wɔntiatia me so wɔ fam</para>
  <para style="q2" vid="PSA 7:5">na wɔmma me funu nna mfuturo mu.<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>Sɔre wʼabufuo mu, Ao <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 7:6">Sɔre tia mʼatamfoɔ abufuo.</para>
  <para style="q2" vid="PSA 7:6">Nyane, me Onyankopɔn; hyɛ atɛntenee mmara.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>Ma nnipadɔm mmɛtwa wo ho nhyia.</para>
  <para style="q2" vid="PSA 7:7">Firi soro hɔ di wɔn so;<verse eid="PSA 7:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8"/>ma <char style="nd">Awurade</char> mmu nnipa no atɛn.</para>
  <para style="q1" vid="PSA 7:8">Bu me atɛn, Ao <char style="nd">Awurade</char> sɛdeɛ me teneneeyɛ teɛ,</para>
  <para style="q2" vid="PSA 7:8">sɛdeɛ me nokorɛdie teɛ, Ao Ɔsorosoroni.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>Ao Onyankopɔn teneneeni,</para>
  <para style="q2" vid="PSA 7:9">wo a wohwehwɛ adwene ne akoma mu,</para>
  <para style="q1" vid="PSA 7:9">fa amumuyɛfoɔ basabasayɛ bra awieeɛ</para>
  <para style="q2" vid="PSA 7:9">na ma ateneneefoɔ nya banbɔ.<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Mʼakokyɛm ne Ɔsorosoro Onyankopɔn</para>
  <para style="q2" vid="PSA 7:10">deɛ ɔgye akoma mu teneneeni no.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Onyankopɔn yɛ ɔtemmufoɔ teneneeni,</para>
  <para style="q2" vid="PSA 7:11">Onyame a ɔda nʼabufuo adi da biara.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Sɛ wansesa nʼadwene a,</para>
  <para style="q2" vid="PSA 7:12">ɔbɛse nʼakofena ano;</para>
  <para style="q2" vid="PSA 7:12">ɔbɛkuntunu ne tadua na ɔde bɛmma ahyɛ mu.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Wasiesie ne kɔdiawuo akodeɛ;</para>
  <para style="q2" vid="PSA 7:13">ayɛ ne bɛmma a ɛrederɛ no krado.<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Deɛ ɔnyinsɛn amumuyɛ</para>
  <para style="q2" vid="PSA 7:14">na basabasayɛ ahyɛ no ma no, ɔwo nnaadaa.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Deɛ ɔtu tokuro na ɔyi mu dɔteɛ no</para>
  <para style="q2" vid="PSA 7:15">hwe tokuro a watu no mu.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Ɔhaw a ɔde ba no dane bɔ nʼankasa so;</para>
  <para style="q2" vid="PSA 7:16">ne basabasayɛ bɔ nʼankasa tiri so.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Mede aseda bɛma <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 7:17">ne tenenee enti</para>
  <para style="q1" vid="PSA 7:17">na mato ayɛyi dwom ayi <char style="nd">Awurade</char>, Ɔsorosoroni no din ayɛ.</para>
  <para style="d" vid="PSA 7:17">Wɔde ma dwomkyerɛfoɔ sɛ wɔnto no “gittit” sankuo nne so.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">Dwom 8</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>Ao <char style="nd">Awurade</char>, yɛn <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 8:1">wo din kɛseyɛ ada adi ewiase afanan nyinaa.</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">Wode wʼanimuonyam</para>
  <para style="q2" vid="PSA 8:1">atimtim ɔsoro nohoa,<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>mmɔfra ne nkɔkoaa mpo de wɔn ano</para>
  <para style="q2" vid="PSA 8:2">kamfo wo, wʼatamfoɔ nti;</para>
  <para style="q2" vid="PSA 8:2">na wode bɔ atamfoɔ ne weretɔfoɔ ano.<verse eid="PSA 8:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Sɛ mehwɛ wo soro,</para>
  <para style="q2" vid="PSA 8:3">wo nsateaa ano adwuma;</para>
  <para style="q1" vid="PSA 8:3">ɔsrane ne nsoromma a</para>
  <para style="q2" vid="PSA 8:3">wode obiara asi nʼafa a,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>onipa ne hwan a wokae no,</para>
  <para style="q2" vid="PSA 8:4">na onipa ba nso ne hwan a wʼani ku ne ho?<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Wobɔɔ no ma ɔyɛɛ akumaa kakra sene abɔfoɔ</para>
  <para style="q2" vid="PSA 8:5">na wode wʼanimuonyam ne anidie abɔ no abotire.<verse eid="PSA 8:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Woyɛɛ no sodifoɔ maa wo nsa ano adwuma</para>
  <para style="q2" vid="PSA 8:6">wode nneɛma nyinaa ahyɛ ne nan ase:<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>nnwankuo ne nantwikuo nyinaa</para>
  <para style="q2" vid="PSA 8:7">ne wiram mmoa nso,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>ewiem nnomaa</para>
  <para style="q2" vid="PSA 8:8">ne ɛpo mu mpataa,</para>
  <para style="q2" vid="PSA 8:8">deɛ ɛnenam ɛpo mu akwan so nyinaa.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>Ao, <char style="nd">Awurade</char>, yɛn <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 8:9">wo din yɛ kɛseɛ wɔ asase nyinaa so!</para>
  <para style="d" vid="PSA 8:9">Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛdeɛ wɔto “Ɔba no wuo”.<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">Dwom 9</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>Ao <char style="nd">Awurade</char>, mefiri mʼakoma nyinaa mu mekamfo wo.</para>
  <para style="q2" vid="PSA 9:1">Mɛka wʼanwanwadeɛ no nyinaa.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Mɛma mʼani agye na madi ahurisie wɔ wo mu.</para>
  <para style="q2" vid="PSA 9:2">Mɛto ayɛyie dwom ama wo din, Ao Ɔsorosoroni.<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Mʼatamfoɔ sane wɔn akyi;</para>
  <para style="q2" vid="PSA 9:3">wɔtete hwe, na wɔwuwu wɔ wʼanim.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Woadi mʼasɛm ama me, na mɛnya mʼahofadie;</para>
  <para style="q2" vid="PSA 9:4">woatena wʼahennwa so, abu atɛntenenee.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Woatwe amanaman no aso, na woasɛe amumuyɛfoɔ.</para>
  <para style="q2" vid="PSA 9:5">Woapepa wɔn din a wɔrenkae wɔn bio.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Ɔsɛeɛ a ɛnni awieeɛ ato ɔtamfoɔ no,</para>
  <para style="q2" vid="PSA 9:6">woatutu wɔn nkuropɔn;</para>
  <para style="q2" vid="PSA 9:6">na wɔnnkae wɔn bio mpo.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>
    <char style="nd">Awurade</char> di ɔhene daa daa;</para>
  <para style="q2" vid="PSA 9:7">wasi nʼatemmuo ahennwa.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Ɔde tenenee bɛbu ewiase atɛn;</para>
  <para style="q2" vid="PSA 9:8">ɔde atɛntenenee bɛdi nnipa no so.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>
    <char style="nd">Awurade</char> yɛ dwanekɔbea ma wɔn a wɔhyɛ wɔn so,</para>
  <para style="q2" vid="PSA 9:9">ɔyɛ abandenden wɔ ahohia mmrɛ mu.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Wɔn a wɔnim wo din no de wɔn ho bɛto wo so,</para>
  <para style="q2" vid="PSA 9:10">ɛfiri sɛ, wo <char style="nd">Awurade</char>, wonnyaa obiara a ɔhwehwɛ wo no mu da.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Monto ayɛyie dwom mma <char style="nd">Awurade</char> a ɔte ahennwa so wɔ Sion;</para>
  <para style="q2" vid="PSA 9:11">mompae mu nka deɛ wayɛ wɔ amanaman no mu.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Na ɔkae deɛ ɔtɔ mogya so were no;</para>
  <para style="q2" vid="PSA 9:12">ɔmmu nʼani ngu ɔbrɛfoɔ sufrɛ so.<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>Ao <char style="nd">Awurade</char>, hwɛ sɛdeɛ mʼatamfoɔ teetee me!</para>
  <para style="q2" vid="PSA 9:13">Hu me mmɔbɔ na yi me firi owuo apono ano,<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>na matumi apae mu aka wʼayɛyie</para>
  <para style="q2" vid="PSA 9:14">wɔ Ɔbabaa Sion apono ano</para>
  <para style="q2" vid="PSA 9:14">na ɛhɔ, madi ahurisie wɔ wo nkwagyeɛ no mu.<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Aman amanmufoɔ atɔ amena a wɔatu no mu;</para>
  <para style="q2" vid="PSA 9:15">afidie a wɔsum hintaaeɛ no ayi wɔn nan.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>
    <char style="nd">Awurade</char> atɛntenenee da no adi;</para>
  <para style="q2" vid="PSA 9:16">amumuyɛfoɔ nsa ano adwuma ayi wɔn.<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>Amumuyɛfoɔ sane kɔ damena mu,</para>
  <para style="q2" vid="PSA 9:17">amanaman a wɔn werɛ firi Onyankopɔn nyinaa.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Nanso ɛnyɛ daa na ne werɛ bɛfiri ohiani,</para>
  <para style="q2" vid="PSA 9:18">anaa sɛ mmɔborɔni anidasoɔ bɛyera korakora.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Sɔre! Ao <char style="nd">Awurade</char>, mma ɔdasani nni nkonim,</para>
  <para style="q2" vid="PSA 9:19">bu amanaman no atɛn wɔ wʼanim.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>Hunahuna wɔn, Ao <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 9:20">na ma wɔnhunu sɛ, wɔyɛ adasamma.<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">Dwom 10</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>Adɛn enti, Ao <char style="nd">Awurade</char>, na wogyina akyirikyiri saa?</para>
  <para style="q2" vid="PSA 10:1">Adɛn enti na wode wo ho ahinta wɔ amanehunu mmerɛ mu yi?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Ɔmumuyɛfoɔ de ahantan taataa mmɔborɔfoɔ,</para>
  <para style="q2" vid="PSA 10:2">wɔn a mfidie a wɔasunsum yi wɔn.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Ɔde deɛ nʼakoma hwehwɛ hoahoa ne ho;</para>
  <para style="q2" vid="PSA 10:3">ɔhyira ɔdifodepɛfoɔ, na ɔyi <char style="nd">Awurade</char> ahi.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Ahantan enti, omumuyɛfoɔ nhwehwɛ <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 10:4">na Onyankopɔn nni ne nsusuiɛ nyinaa mu.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Nʼakwan nyinaa mu, ɔdi yie;</para>
  <para style="q2" vid="PSA 10:5">ɔma ne ho so, na wo mmara mfa ne ho;</para>
  <para style="q2" vid="PSA 10:5">na ɔdi nʼatamfoɔ nyinaa ho fɛw.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Ɔka kyerɛ ne ho sɛ: “Biribiara mma me nhinhim;</para>
  <para style="q2" vid="PSA 10:6">mʼani bɛgye daa, na merenkɔ amanehunu mu da.”<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Nnome, atorɔ ne ahunahuna ahyɛ nʼanom ma;</para>
  <para style="q2" vid="PSA 10:7">Ɔhaw ne mmusuo hyɛ ne tɛkrɛma ase.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Ɔtɛ wɔ nkuraase;</para>
  <para style="q2" vid="PSA 10:8">ɔfiri atɛeɛ kum deɛ ɔnnim hwee,</para>
  <para style="q2" vid="PSA 10:8">na ɔhwɛ wɔn a ɔrepɛ wɔn akum wɔn.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Ɔte sɛ gyata a wahinta;</para>
  <para style="q2" vid="PSA 10:9">ɔtɛ sɛ ɔbɛkyere mmɔborɔni;</para>
  <para style="q2" vid="PSA 10:9">ɔkyere wɔn twe wɔn ase de wɔn kɔ ne bɔn mu.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Ɔdwerɛ wɔn a ɔkyere wɔn no ma wɔtɔ baha;</para>
  <para style="q2" vid="PSA 10:10">na ɔde nʼahoɔden ka wɔn hyɛ.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Ɔka kyerɛ ne ho sɛ, “Onyankopɔn werɛ afi;</para>
  <para style="q2" vid="PSA 10:11">wayi nʼani afiri so na ɔnhunu.”<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>Sɔre, <char style="nd">Awurade</char>! Ma wo nsa so, Ao Onyankopɔn.</para>
  <para style="q2" vid="PSA 10:12">Mma wo werɛ mfiri wɔn a wɔnni aboafoɔ.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Adɛn enti na omumuyɛfoɔ yi Onyankopɔn ahi?</para>
  <para style="q2" vid="PSA 10:13">Adɛn enti na ɔka kyerɛ ne ho sɛ,</para>
  <para style="q2" vid="PSA 10:13">“Ɔremfrɛ me akontabuo so?”<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Nanso wo, Ao Onyankopɔn, wohunu amanehunu ne ɔhaw;</para>
  <para style="q2" vid="PSA 10:14">na wayɛ wʼadwene sɛ wobɛhwɛ.</para>
  <para style="q1" vid="PSA 10:14">Mmɔborɔni de ne ho ma wo;</para>
  <para style="q2" vid="PSA 10:14">wo na woyɛ awisiaa ɔboafoɔ.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Bubu omumuyɛfoɔ ne ɔbɔnefoɔ aprɛ;</para>
  <para style="q2" vid="PSA 10:15">frɛ no na ɔmmɛbu nʼamumuyɛ ho nkontaa,</para>
  <para style="q2" vid="PSA 10:15">amumuyɛ a anka wɔrenhunu no.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>
    <char style="nd">Awurade</char> yɛ ɔhene daa nyinaa;</para>
  <para style="q2" vid="PSA 10:16">amanaman no bɛyera nʼasase so.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>Ao <char style="nd">Awurade</char>, wotie awiɛmfoɔ adesrɛ;</para>
  <para style="q2" vid="PSA 10:17">wohyɛ wɔn nkuran, na wotie wɔn sufrɛ,<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>na wodi ma awisiaa ne deɛ wɔhyɛ ne soɔ</para>
  <para style="q2" vid="PSA 10:18">sɛdeɛ ɛbɛyɛ a ɔdasani a ɔfiri asase so</para>
  <para style="q2" vid="PSA 10:18">renhunahuna obiara bio.</para>
  <para style="d" vid="PSA 10:18">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">Dwom 11</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>
    <char style="nd">Awurade</char> mu na mede me werɛ ahyɛ.</para>
  <para style="q2" vid="PSA 11:1">Adɛn na wotumi ka kyerɛ me sɛ,</para>
  <para style="q2" vid="PSA 11:1">“Tu te sɛ anomaa kɔ wo bepɔ so.<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Na hwɛ, amumuyɛfoɔ akuntunu wɔn tadua mu,</para>
  <para style="q2" vid="PSA 11:2">na wɔde wɔn mmɛmma asisi nhoma so</para>
  <para style="q1" vid="PSA 11:2">sɛ wɔbɛto wɔ esum mu</para>
  <para style="q2" vid="PSA 11:2">de awɔ akoma mu ahotefoɔ.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Sɛ wɔresɛe fapem no a,</para>
  <para style="q2" vid="PSA 11:3">ɛdeɛn na ɔteneneeni bɛtumi ayɛ?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>
    <char style="nd">Awurade</char> wɔ nʼasɔredan kronkron no mu;</para>
  <para style="q2" vid="PSA 11:4">
    <char style="nd">Awurade</char> te ne soro ahennwa so.</para>
  <para style="q1" vid="PSA 11:4">Ɔhwɛ nnipa mma,</para>
  <para style="q2" vid="PSA 11:4">nʼani hwehwɛ wɔn mu.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>
    <char style="nd">Awurade</char> hwehwɛ ɔteneneeni mu,</para>
  <para style="q2" vid="PSA 11:5">na amumuyɛfoɔ ne wɔn a wɔpɛ basabasayɛ deɛ,</para>
  <para style="q2" vid="PSA 11:5">ne kra kyiri wɔn.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Ɔbɛtɔ gyaframa ne sɔfe a ɛrederɛ</para>
  <para style="q2" vid="PSA 11:6">agu Amumuyɛfoɔ so;</para>
  <para style="q2" vid="PSA 11:6">na mframa a emu yɛ hyeɛ bɛyɛ wɔn kyɛfa.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>
    <char style="nd">Awurade</char> yɛ ɔteneneeni,</para>
  <para style="q2" vid="PSA 11:7">na ɔpɛ atɛntenenee;</para>
  <para style="q2" vid="PSA 11:7">wɔn a wɔtene no bɛhunu nʼanim.</para>
  <para style="d" vid="PSA 11:7">Wɔde ma dwomkyerɛfoɔ sɛ wɔnto no wɔ “Seminit” sankuo nne so.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">Dwom 12</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>Boa yɛn, <char style="nd">Awurade</char>, na nyamesurofoɔ asa;</para>
  <para style="q2" vid="PSA 12:1">nokwafoɔ ayera wɔ nnipa mu.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Obiara di atorɔ kyerɛ ne yɔnko;</para>
  <para style="q2" vid="PSA 12:2">wɔn ano a ɛdɛfɛdɛfɛ no ka nnaadaasɛm.<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Ma <char style="nd">Awurade</char> ntwa nnaadaa ano</para>
  <para style="q2" vid="PSA 12:3">ne tɛkrɛma biara a ɛhoahoa ne ho ntwene;<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>wɔn a wɔse, “Yɛde yɛn tɛkrɛma bɛdi nkonim;</para>
  <para style="q2" vid="PSA 12:4">yɛn ano yɛ yɛn dea, na hwan ne yɛn wura?”<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>“Esiane nhyɛ a wɔde hyɛ mmɔborɔni no</para>
  <para style="q2" vid="PSA 12:5">ne ohiani apenesie no enti,</para>
  <para style="q1" vid="PSA 12:5">mɛsɔre afei,” <char style="nd">Awurade</char> na ɔseɛ.</para>
  <para style="q2" vid="PSA 12:5">“Mɛbɔ wɔn ho ban afiri wɔn a wɔha wɔn ho.”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>
    <char style="nd">Awurade</char> asɛm yɛ nokorɛ</para>
  <para style="q2" vid="PSA 12:6">te sɛ dwetɛ a wɔasɔne so wɔ fononoo mu,</para>
  <para style="q2" vid="PSA 12:6">na wɔahoa ho mprɛnson.<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>Ao <char style="nd">Awurade</char>, wobɛkora yɛn</para>
  <para style="q2" vid="PSA 12:7">na woabɔ yɛn ho ban afebɔɔ afiri saa abɔnefoɔ yi ho,<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>abɔnefoɔ a wɔnenam sɛdeɛ wɔpɛ</para>
  <para style="q2" vid="PSA 12:8">ɛberɛ a adasamma de anidie ma afideɛ.</para>
  <para style="d" vid="PSA 12:8">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">Dwom 13</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>Ao, <char style="nd">Awurade</char>, ɛnkɔsi da bɛn? Wo werɛ bɛfiri me afebɔɔ anaa?</para>
  <para style="q2" vid="PSA 13:1">Ɛnkɔsi da bɛn na wode wʼanim bɛhinta me?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Ɛnkɔsi da bɛn na mene mʼadwendwene bɛdi apereapereɛ</para>
  <para style="q2" vid="PSA 13:2">na awerɛhoɔ ahyɛ mʼakoma mu daa?</para>
  <para style="q2" vid="PSA 13:2">Mʼatamfoɔ nni me so nkonim nkɔsi da bɛn?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Te wʼani hwɛ me na bua me, Ao, <char style="nd">Awurade</char>, me Onyankopɔn.</para>
  <para style="q2" vid="PSA 13:3">Ma mʼani so nyɛ hann, na manna owuo nna.<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>Me ɔtamfoɔ bɛka sɛ, “Madi ne so nkonim.”</para>
  <para style="q2" vid="PSA 13:4">Na mʼahohiahiafoɔ bɛdi ahurisie ɛberɛ a mahwe ase.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Nanso mede me ho to wo dɔ a ɛnsa da no so;</para>
  <para style="q2" vid="PSA 13:5">mʼakoma di ahurisie wɔ wo nkwagyeɛ mu.<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Mɛto dwom ama <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 13:6">ɛfiri sɛ ɔne me adi no yie.</para>
  <para style="d" vid="PSA 13:6">Wɔde ma dwomkyerɛfoɔ no.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">Dwom 14</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>Ɔkwasea ka wɔ nʼakoma mu sɛ,</para>
  <para style="q2" vid="PSA 14:1">“Onyankopɔn bi nni hɔ.”</para>
  <para style="q1" vid="PSA 14:1">Wɔaporɔ, na wɔn nneyɛɛ yɛ fi</para>
  <para style="q2" vid="PSA 14:1">na wɔn mu biara nni hɔ a ɔyɛ ade pa.<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>
    <char style="nd">Awurade</char> firi ɔsoro hwɛ</para>
  <para style="q2" vid="PSA 14:2">adasamma</para>
  <para style="q1" vid="PSA 14:2">sɛ ɔbɛhunu wɔn mu bi a wɔwɔ nteaseɛ,</para>
  <para style="q2" vid="PSA 14:2">anaa ebinom a wɔhwehwɛ Onyankopɔn.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Nanso nnipa nyinaa atwe wɔn ho afiri Onyankopɔn ho;</para>
  <para style="q2" vid="PSA 14:3">wɔn nyinaa ayɛ bɔne.</para>
  <para style="q1" vid="PSA 14:3">Obiara nni hɔ a ɔyɛ papa.</para>
  <para style="q2" vid="PSA 14:3">Ɔbaako mpo nni hɔ.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Enti nnebɔneyɛfoɔ rensua nyansa anaa?</para>
  <para style="b" vid="PSA 14:4"/>
  <para style="q1" vid="PSA 14:4">Wɔwe me nkurɔfoɔ te sɛ deɛ nnipa di aduane.</para>
  <para style="q2" vid="PSA 14:4">Wɔnnsu mfrɛ <char style="nd">Awurade</char>?<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Wɔn nie, ehu akyekyere wɔn,</para>
  <para style="q2" vid="PSA 14:5">ɛfiri sɛ Onyankopɔn te wɔn a wɔtene mu.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Mo nnebɔneyɛfoɔ sɛe ahiafoɔ nhyehyɛeɛ,</para>
  <para style="q2" vid="PSA 14:6">nanso, <char style="nd">Awurade</char> ne wɔn dwanekɔbea.<verse eid="PSA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>Ao, ma Israel nkwagyeɛ mfiri Sion mmra!</para>
  <para style="q2" vid="PSA 14:7">
    <char style="nd">Awurade</char> bɛsane de ne nkurɔfoɔ agyapadeɛ ama wɔn.</para>
  <para style="q2" vid="PSA 14:7">Na Yakob adi ahurisie, na Israel ani agye!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">Dwom 15</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>
    <char style="nd">Awurade</char>, hwan na ɔbɛsoeɛ wo kronkronbea hɔ?</para>
  <para style="q2" vid="PSA 15:1">Hwan na ɔbɛtena wo bepɔ kronkron no so?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Deɛ ne ho nni asɛm</para>
  <para style="q2" vid="PSA 15:2">na ɔyɛ deɛ ɛtene,</para>
  <para style="q1" vid="PSA 15:2">deɛ ɔka nokorɛ a ɛfiri nʼakomam<verse eid="PSA 15:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3"/>na ɔmfa ne tɛkrɛma nsɛe nnipa</para>
  <para style="q1" vid="PSA 15:3">deɛ ɔnnyɛ ne yɔnko bɔne</para>
  <para style="q2" vid="PSA 15:3">na ɔmmu ne yɔnko onipa abomfiaa,<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>deɛ ɔbu afideyɛni animtiaa</para>
  <para style="q2" vid="PSA 15:4">na ɔde anidie ma wɔn a wɔsuro <char style="nd">Awurade</char>,</para>
  <para style="q1" vid="PSA 15:4">deɛ ɔdi ne ntam so</para>
  <para style="q2" vid="PSA 15:4">ɛberɛ a ɛtia no mpo,<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>deɛ ɔde ne sika bɔ bosea a ɔnnye nsiho</para>
  <para style="q2" vid="PSA 15:5">na ɔnnye adanmudeɛ ntia deɛ ɔdi bem.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">Deɛ ɔyɛ yeinom no</para>
  <para style="q2" vid="PSA 15:5">renhinhim da.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">Dwom 16</para>
  <para style="d">Dawid mpaeɛbɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>Bɔ me ho ban, Ao Onyankopɔn,</para>
  <para style="q2" vid="PSA 16:1">na wo mu na menya hintabea.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Meka kyerɛɛ <char style="nd">Awurade</char> sɛ,</para>
  <para style="q2" vid="PSA 16:2">“MʼAwurade ne wo;</para>
  <para style="q2" vid="PSA 16:2">menni adepa biara ka wo ho.”<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Ahotefoɔ a wɔwɔ asase no so deɛ,</para>
  <para style="q2" vid="PSA 16:3">wɔne animuonyamfoɔ a</para>
  <para style="q2" vid="PSA 16:3">mʼanigyeɛ wɔ wɔn mu.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Wɔn a wɔdi anyame afoforɔ akyire no</para>
  <para style="q2" vid="PSA 16:4">wɔn awerɛhoɔ bɛdɔɔso.</para>
  <para style="q1" vid="PSA 16:4">Merenyi wɔn mogya apaeɛ no bi</para>
  <para style="q2" vid="PSA 16:4">na meremfa mʼano memmɔ wɔn din.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>
    <char style="nd">Awurade</char>, wode me kyɛfa ne me kuruwa ama me;</para>
  <para style="q2" vid="PSA 16:5">woama me kyɛfa anya banbɔ.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Mʼahyeɛ akɔdeda mmea a ɛhɔ yɛ ahomeka;</para>
  <para style="q2" vid="PSA 16:6">ampa ara mewɔ agyapadeɛ a ɛho yɛ anigye.<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Mɛkamfo <char style="nd">Awurade</char> a ɔtu me fo;</para>
  <para style="q2" vid="PSA 16:7">na anadwo mpo mʼakoma kyerɛkyerɛ me.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>Mehunu <char style="nd">Awurade</char> wɔ mʼani so daa nyinaa.</para>
  <para style="q2" vid="PSA 16:8">Esiane sɛ ɔwɔ me nsa nifa enti, merenhinhim da.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Ɛno enti, me kra ani gye, na mede me tɛkrɛma di ahurisie;</para>
  <para style="q2" vid="PSA 16:9">me onipadua nso bɛhome asomdwoeɛ mu,<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>ɛfiri sɛ, worennya me awufoɔ mu.</para>
  <para style="q2" vid="PSA 16:10">Na woremma wo Kronkronni no mporɔ.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Woakyerɛ me nkwagyeɛ kwan,</para>
  <para style="q2" vid="PSA 16:11">na wobɛma mʼani agye wɔ wʼanim,</para>
  <para style="q2" vid="PSA 16:11">na anika a ɛrensa da wɔ wo nifa so.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">Dwom 17</para>
  <para style="d">Dawid Mpaeɛbɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>Ao, <char style="nd">Awurade</char> tie me tenenee abisadeɛ;</para>
  <para style="q2" vid="PSA 17:1">tie me sufrɛ.</para>
  <para style="q1" vid="PSA 17:1">Yɛ aso ma me mpaeɛbɔ</para>
  <para style="q2" vid="PSA 17:1">deɛ ɛmfiri nnaadaa anofafa mu.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Ma me bembuo a ɛfiri wo hɔ.</para>
  <para style="q2" vid="PSA 17:2">Ma wʼani nhunu deɛ ɛyɛ pɛ.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Wopɛɛpɛɛ mʼakoma mu,</para>
  <para style="q2" vid="PSA 17:3">wohwehwɛ me mu anadwo,</para>
  <para style="q1" vid="PSA 17:3">na wosɔ me hwɛ deɛ, nanso worenhunu hwee;</para>
  <para style="q2" vid="PSA 17:3">masi madwene pi sɛ mʼano renka bɔne.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Nnipa nneyɛɛ fam no,</para>
  <para style="q2" vid="PSA 17:4">wʼanomu asɛm enti</para>
  <para style="q1" vid="PSA 17:4">matwe me ho afiri</para>
  <para style="q2" vid="PSA 17:4">basabasayɛfoɔ akwan ho.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Menam wʼakwan so daa;</para>
  <para style="q2" vid="PSA 17:5">me nan nnwatiriiɛ.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Mesu mefrɛ wo, Ao Onyankopɔn</para>
  <para style="q2" vid="PSA 17:6">na wobɛgye me so;</para>
  <para style="q2" vid="PSA 17:6">yɛ aso ma me na tie me mpaeɛbɔ.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Da wo dɔ nwanwasoɔ no adi</para>
  <para style="q2" vid="PSA 17:7">wo a wode wo nsa nifa</para>
  <para style="q1" vid="PSA 17:7">gye wɔn a wɔde wɔn ho to wo so no nkwa</para>
  <para style="q2" vid="PSA 17:7">firi wɔn atamfoɔ nsam.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Hwɛ me so sɛ obi a wodɔ no;</para>
  <para style="q2" vid="PSA 17:8">fa me sie wo ntaban nwunu no ase<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>firi amumuyɛfoɔ a wɔretaataa me nsam,</para>
  <para style="q2" vid="PSA 17:9">mʼatamfoɔ a wɔatwa me ho ahyia no.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Wɔpirim wɔn akoma,</para>
  <para style="q2" vid="PSA 17:10">na wɔkasa ahantan so.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Wɔadi me ntɛtɛ, afei wɔatwa me ho ahyia;</para>
  <para style="q2" vid="PSA 17:11">wɔn ani abere sɛ wɔbɛbɔ me ahwe fam.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Wɔte sɛ gyata a ahaboa ho kɔm de no,</para>
  <para style="q2" vid="PSA 17:12">te sɛ gyata kɛseɛ bi a wabutu wɔ atɛeɛ.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Sɔre, Ao <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 17:13">Wone wɔn mfa mmɔ ani na ka wɔn hyɛ;</para>
  <para style="q2" vid="PSA 17:13">fa wʼakofena no gye me firi amumuyɛfoɔ no nsam.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>Ao <char style="nd">Awurade</char> fa wo nsa</para>
  <para style="q2" vid="PSA 17:14">gye me firi nnipa a wɔte sei nsam</para>
  <para style="q2" vid="PSA 17:14">asase so nnipa a wɔn akatua wɔ nkwa yi mu.</para>
  <para style="q1" vid="PSA 17:14">Womma ɛkɔm nne wɔn a wʼani ku wɔn ho;</para>
  <para style="q2" vid="PSA 17:14">wɔn mmammarima wɔ bebree,</para>
  <para style="q2" vid="PSA 17:14">na wɔkora agyapadeɛ ma wɔn mma.<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Na me deɛ, me tenenee mu, mɛhunu wʼanim;</para>
  <para style="q2" vid="PSA 17:15">sɛ menyane na mehunu wo a, mʼakoma bɛtɔ ne yam.</para>
  <para style="d" vid="PSA 17:15">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">Dwom 18</para>
  <para style="d">
    <char style="nd">Awurade</char> akoa Dawid dwom. Ɔtoo saa dwom yi maa <char style="nd">Awurade</char>, ɛberɛ a ɔgyee no firii nʼatamfoɔ nyinaa ne Saulo nsam no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>Medɔ wo, Ao <char style="nd">Awurade</char>, mʼahoɔden.<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>
    <char style="nd">Awurade</char> ne me botantim;</para>
  <para style="q2" vid="PSA 18:2">mʼaban ne me gyefoɔ;</para>
  <para style="q1" vid="PSA 18:2">me Onyankopɔn ne me botan</para>
  <para style="q2" vid="PSA 18:2">Ne mu na menya me hintabea.</para>
  <para style="q2" vid="PSA 18:2">Ɔyɛ mʼakokyɛm, me nkwagyeɛ abɛn ne mʼabandenden.<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Mesu frɛ <char style="nd">Awurade</char>; ɔno na ayɛyie sɛ no,</para>
  <para style="q2" vid="PSA 18:3">ɛfiri sɛ ɔgye me firi mʼatamfoɔ nsam.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Owuo nkɔnsɔnkɔnsɔn kyekyeree me;</para>
  <para style="q2" vid="PSA 18:4">na ɔsɛeɛ asorɔkye bu faa me so.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Damena nhoma kyekyeree me;</para>
  <para style="q2" vid="PSA 18:5">owuo ankasa too me anihaa.<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Mʼahohia mu, mesu mefrɛɛ <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 18:6">Mesu mefrɛɛ me Onyankopɔn pɛɛ mmoa.</para>
  <para style="q1" vid="PSA 18:6">Ɔfiri nʼasɔrefie hɔ tee me nne;</para>
  <para style="q2" vid="PSA 18:6">me sufrɛ baa nʼanim, na ɛkɔɔ nʼasom.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Asase wosoeɛ na ɛhinhimeɛ,</para>
  <para style="q2" vid="PSA 18:7">na mmepɔ fapem wosoeɛ</para>
  <para style="q2" vid="PSA 18:7">wɔsuroeɛ ɛfiri sɛ na ne bo afu.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Wisie firii ne hwene mu;</para>
  <para style="q2" vid="PSA 18:8">ogyaframa firii nʼanom,</para>
  <para style="q2" vid="PSA 18:8">na egyasramma dɛre firii mu.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Ɔfirii ɔsoro baa fam;</para>
  <para style="q2" vid="PSA 18:9">na omununkum kabii duruu ne nan ase.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Ɔte Kerubim so tu kɔɔ soro;</para>
  <para style="q2" vid="PSA 18:10">gyaagyaa ne ho wɔ mframa ntaban so.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Ɔde sum kataa ne ho,</para>
  <para style="q2" vid="PSA 18:11">osu a amuna tumm atwa ne ho ahyia.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Hann kɛseɛ hyerɛn wɔ nʼanim,</para>
  <para style="q2" vid="PSA 18:12">na omununkum a asukɔtweaa ne anyinam wɔ mu firii ne ho hyerɛn mu baeɛ.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>
    <char style="nd">Awurade</char> bobɔɔ mu firii soro;</para>
  <para style="q2" vid="PSA 18:13">Ɔsorosoroni no nne gyegyeeɛ bio.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Ɔtoo ne bɛmma no de bɔɔ atamfoɔ no hweteeɛ,</para>
  <para style="q2" vid="PSA 18:14">ɔde anyinam a ano yɛn den pamoo wɔn.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Ɛpo mu mmɔnka ho yiyiiɛ</para>
  <para style="q2" vid="PSA 18:15">na asase nnyinasoɔ ho daa hɔ,</para>
  <para style="q1" vid="PSA 18:15">ɛsiane wʼanimka ne ahomeguo a ɛfiri wo hwene mu no enti,</para>
  <para style="q2" vid="PSA 18:15">Ao <char style="nd">Awurade</char>.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Ɔfiri ɔsoro baa ɛfam bɛsɔɔ me mu;</para>
  <para style="q2" vid="PSA 18:16">ɔtwee me firii nsuo a emu dɔ mu.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Ɔgyee me firii me ɔtamfoɔ hoɔdenfoɔ nsam,</para>
  <para style="q2" vid="PSA 18:17">wɔn a wɔn ani sa me, na wɔn ho yɛ den dodo ma me no.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Wɔbaa me so wɔ mʼamanehunu da mu,</para>
  <para style="q2" vid="PSA 18:18">nanso <char style="nd">Awurade</char> pagyaa me.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>Ɔde me baa baabi a ɛhɔ trɛ;</para>
  <para style="q2" vid="PSA 18:19">ɔgyee me, ɛfiri sɛ nʼani sɔɔ me.<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>
    <char style="nd">Awurade</char> ne me adi no sɛdeɛ me tenenee teɛ;</para>
  <para style="q2" vid="PSA 18:20">wahwɛ me nsa a ɛho teɛ so atua me ka.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Manante <char style="nd">Awurade</char> akwan so.</para>
  <para style="q2" vid="PSA 18:21">Mentwee me ho mfirii me Onyankopɔn ho nkɔyɛɛ bɔne.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Madi ne mmara nyinaa so:</para>
  <para style="q2" vid="PSA 18:22">memmuu nʼahyɛdeɛ so.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Me ho nni asɛm wɔ Onyankopɔn anim,</para>
  <para style="q2" vid="PSA 18:23">na matwe me ho afiri bɔne ho.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>
    <char style="nd">Awurade</char> agyina me teneneeyɛ</para>
  <para style="q2" vid="PSA 18:24">ne me nsa a ɛho teɛ wɔ nʼanim so atua me ka.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Woda wo ho adi sɛ ɔnokwafoɔ kyerɛ wɔn a wɔdi nokorɛ,</para>
  <para style="q1" vid="PSA 18:25">wɔn a wɔdi mu nso wo kyerɛ wɔn sɛ wodi mu.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>Woyɛ kronn ma wɔn a wɔyɛ kronn,</para>
  <para style="q2" vid="PSA 18:26">na amumuyɛfoɔ deɛ, wokyiri wɔn.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Wogye ahobrɛasefoɔ nkwa,</para>
  <para style="q2" vid="PSA 18:27">na wobrɛ ahantanfoɔ ase.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>Ao <char style="nd">Awurade</char>, woyɛ me kanea.</para>
  <para style="q2" vid="PSA 18:28">Aane, woma me sum dane hann.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Wʼahoɔden a wode ma me enti, metumi ka akodɔm gu;</para>
  <para style="q2" vid="PSA 18:29">me Onyankopɔn enti, metumi foro ɔfasuo.<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Onyankopɔn deɛ, nʼakwan yɛ pɛ;</para>
  <para style="q2" vid="PSA 18:30">
    <char style="nd">Awurade</char> bɔhyɛ nyinaa ba mu.</para>
  <para style="q1" vid="PSA 18:30">Ɔyɛ akokyɛm ma wɔn a</para>
  <para style="q2" vid="PSA 18:30">wɔhwehwɛ banbɔ wɔ ne mu.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Na hwan na ɔyɛ Onyankopɔn ka <char style="nd">Awurade</char> ho?</para>
  <para style="q1" vid="PSA 18:31">Na hwan na ɔyɛ Ɔbotan no, gye sɛ yɛn Onyankopɔn no.<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Ɛyɛ Onyankopɔn na ɔma me ahoɔden,</para>
  <para style="q2" vid="PSA 18:32">na ɔma me kwan yɛ pɛ.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Ɔma mʼanammɔn ho yɛ hare sɛ ɔforoteɛ deɛ.</para>
  <para style="q2" vid="PSA 18:33">Ɔma me gyina sorɔnsorɔmmea.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Ɔsiesie me ma ɔko,</para>
  <para style="q2" vid="PSA 18:34">na mʼabasa tumi kuntunu kɔbere mfrafraeɛ tadua.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Wode wo nkonimdie akokyɛm ma me,</para>
  <para style="q2" vid="PSA 18:35">na wo nsa nifa kura me.</para>
  <para style="q2" vid="PSA 18:35">Wobrɛ wo ho ase ma meyɛ kɛseɛ.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Woabɔ ɛkwan tɛtrɛɛ ama me nan</para>
  <para style="q2" vid="PSA 18:36">sɛdeɛ ɛrenwatiri.<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Metaa mʼatamfoɔ kɔtoo wɔn;</para>
  <para style="q2" vid="PSA 18:37">mansane mʼakyi kɔsii sɛ mesɛee wɔn.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Mɛdwerɛ wɔn, na wɔantumi ansɔre,</para>
  <para style="q2" vid="PSA 18:38">wɔhwehwee ase wɔ me nan ase.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Wode akodie ahoɔden maa me;</para>
  <para style="q2" vid="PSA 18:39">womaa mʼatamfoɔ bɔɔ wɔn mu ase wɔ me nan ase.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Womaa mʼatamfoɔ danee wɔn ho dwaneeɛ,</para>
  <para style="q2" vid="PSA 18:40">na mesɛe wɔn a wɔtan me.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Wɔsu pɛɛ mmoa, nanso obiara ammɛgye wɔn,</para>
  <para style="q2" vid="PSA 18:41">wɔfrɛɛ <char style="nd">Awurade</char>, nanso wammua.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Meyamoo wɔn sɛ mfuturo a mframa bɔ guo;</para>
  <para style="q2" vid="PSA 18:42">me hwiee wɔn guiɛ sɛ mmɔntene so atɛkyɛ.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Woagye me afiri nnipa no ntohyɛsoɔ mu,</para>
  <para style="q2" vid="PSA 18:43">woayɛ me amanaman no ti;</para>
  <para style="q2" vid="PSA 18:43">nnipa a mennim wɔn abɛyɛ mʼasomfoɔ.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Wɔte me nka pɛ a, wɔyɛ ɔsetie ma me;</para>
  <para style="q2" vid="PSA 18:44">ananafoɔ koto mʼanim.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Wɔn nyinaa botoboto;</para>
  <para style="q2" vid="PSA 18:45">wɔfiri wɔn abandenden mu ba ahopopoɔ so.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>
    <char style="nd">Awurade</char> te ase! Ayɛyi nka me Botan!</para>
  <para style="q2" vid="PSA 18:46">Wɔmma Onyankopɔn me Gyefoɔ no din so!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Ɔno ne Onyankopɔn a ɔtɔ awere ma me,</para>
  <para style="q2" vid="PSA 18:47">ɔno na ɔka amanaman hyɛ mʼase,<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>ɔno na ɔgye me firi mʼatamfoɔ nsam.</para>
  <para style="q2" vid="PSA 18:48">Wopagyaa me sii mʼatamfoɔ so,</para>
  <para style="q2" vid="PSA 18:48">wogyee me firii basabasayɛfoɔ nsam.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>Ɛno enti, mɛkamfo wo wɔ amanaman mu, Ao <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 18:49">Mɛto ayɛyie dwom ama wo din.<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>Wode nkonimdie akɛseɛ ama wo ɔhene;</para>
  <para style="q2" vid="PSA 18:50">woda ɔdɔ a ɛnsa da adi kyerɛ deɛ woasra no ngo,</para>
  <para style="q2" vid="PSA 18:50">wode kyerɛ Dawid, ne nʼasefoɔ afebɔɔ.</para>
  <para style="d" vid="PSA 18:50">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">Dwom 19</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>Ɔsoro ka Onyankopɔn animuonyam ho asɛm!</para>
  <para style="q2" vid="PSA 19:1">Ewiem pae mu ka ne nsa ano adwuma,<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Ɛda biara, wɔkasa;</para>
  <para style="q2" vid="PSA 19:2">anadwo biara, wɔkyerɛ nimdeɛ.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Ɔkasa anaa nsɛm nnim</para>
  <para style="q2" vid="PSA 19:3">na wɔnnte wɔn nne.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Nanso wɔn asɛm akɔduru asase so mmaa nyinaa,</para>
  <para style="q2" vid="PSA 19:4">wɔn nsɛm nso akɔduru asase ano.</para>
  <para style="b" vid="PSA 19:4"/>
  <para style="q1" vid="PSA 19:4">Wɔ ɔsoro hɔ, wasi ntomadan ama owia,<verse eid="PSA 19:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5"/>a ɔte sɛ ayeforɔkunu a ɔfiri ne pia mu,</para>
  <para style="q2" vid="PSA 19:5">te sɛ ɔbrane a ne ho pere no sɛ ɔbɛtu ne mmirika.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Ɛpue wɔ ɔsoro fa baabi</para>
  <para style="q2" vid="PSA 19:6">na atwa ne ho akɔsi ano;</para>
  <para style="q2" vid="PSA 19:6">biribiara nhinta ne hyeɛ.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>
    <char style="nd">Awurade</char> mmara yɛ pɛ,</para>
  <para style="q2" vid="PSA 19:7">ɛkanyane ɔkra no.</para>
  <para style="q1" vid="PSA 19:7">Ahotosoɔ wɔ <char style="nd">Awurade</char> nhyehyɛeɛ mu,</para>
  <para style="q2" vid="PSA 19:7">ɛma deɛ ɔnnim nyansa hunu nyansa.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>
    <char style="nd">Awurade</char> ahyɛdeɛ tene;</para>
  <para style="q2" vid="PSA 19:8">ɛma akoma mu anigyeɛ.</para>
  <para style="q1" vid="PSA 19:8">
    <char style="nd">Awurade</char> ɔhyɛ nsɛm mu da hɔ;</para>
  <para style="q2" vid="PSA 19:8">na ɛbue ani.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>
    <char style="nd">Awurade</char> suro yɛ kronn,</para>
  <para style="q2" vid="PSA 19:9">ɛte hɔ daa.</para>
  <para style="q1" vid="PSA 19:9">
    <char style="nd">Awurade</char> mmaransɛm yɛ nokorɛ</para>
  <para style="q2" vid="PSA 19:9">na ne nyinaa tene.<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Ɛsom bo sene sikakɔkɔɔ</para>
  <para style="q2" vid="PSA 19:10">sene sikakɔkɔɔ amapa mpo;</para>
  <para style="q1" vid="PSA 19:10">ɛyɛ dɛ sene ɛwoɔ,</para>
  <para style="q2" vid="PSA 19:10">sene ɛwoɔ a ɛfiri ɛwokyɛm mu.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Wɔnam so bɔ wo ɔsomfoɔ kɔkɔ sɛ,</para>
  <para style="q2" vid="PSA 19:11">ɛsodie so akatua yɛ bebree.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Hwan na ɔhunu nʼankasa mfomsoɔ?</para>
  <para style="q2" vid="PSA 19:12">Fa me mfomsoɔ a ahinta kyɛ me.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Bɔ wʼakoa ho ban firi ɔboayɛ bɔne ho,</para>
  <para style="q2" vid="PSA 19:13">na anhyɛ me so.</para>
  <para style="q1" vid="PSA 19:13">Ɛno na ɛbɛma madi bem,</para>
  <para style="q2" vid="PSA 19:13">a merenni fɔ wɔ bɔne akɛseɛ ho.<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Ma mʼanom nsɛm ne mʼakoma mu mpaeɛbɔ</para>
  <para style="q2" vid="PSA 19:14">nyɛ deɛ ɛsɔ wʼani, Ao <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 19:14">me Botan ne me Gyefoɔ.</para>
  <para style="d" vid="PSA 19:14">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">Dwom 20</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>
    <char style="nd">Awurade</char> ntie wo wɔ wʼahohia mu;</para>
  <para style="q2" vid="PSA 20:1">Yakob Onyankopɔn din mmɔ wo ho ban.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Ɔmfa mmoa mfiri kronkronbea hɔ mmrɛ wo</para>
  <para style="q2" vid="PSA 20:2">na ɔmfiri Sion mmɛhyɛ wo den.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Ɔnkae wʼafɔrebɔ nyinaa</para>
  <para style="q2" vid="PSA 20:3">na ɔmma wo hyeɛ afɔdeɛ nsɔ nʼani.<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Ɔmma wo deɛ wʼakoma pɛ,</para>
  <para style="q2" vid="PSA 20:4">na wo nhyehyɛeɛ nyinaa nyɛ yie.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Yɛbɛbɔ ose ɛberɛ a woadi nkonim</para>
  <para style="q2" vid="PSA 20:5">na yɛama yɛn frankaa so wɔ yɛn Onyankopɔn din mu.</para>
  <para style="b" vid="PSA 20:5"/>
  <para style="q1" vid="PSA 20:5">
    <char style="nd">Awurade</char> nyɛ wʼabisadeɛ nyinaa mma wo.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Afei mahunu sɛ <char style="nd">Awurade</char> gye deɛ wasra no no nkwa;</para>
  <para style="q2" vid="PSA 20:6">ɔgye no so wɔ ne soro kronkron hɔ</para>
  <para style="q2" vid="PSA 20:6">ɔde tumi a ɛfiri ne nsa nifa mu no ma no nkwagyeɛ.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Ebinom de wɔn ho to wɔn nteaseɛnam so</para>
  <para style="q2" vid="PSA 20:7">na afoforɔ nso, wɔn apɔnkɔ so,</para>
  <para style="q2" vid="PSA 20:7">nanso yɛn deɛ, yɛde yɛn ho to <char style="nd">Awurade</char> yɛn Onyankopɔn din so.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Saa nkurɔfoɔ no, wɔbrɛ wɔn ase ma wɔhwehwe ase,</para>
  <para style="q2" vid="PSA 20:8">na yɛn deɛ, yɛsɔre gyina pintinn.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>Ao <char style="nd">Awurade</char> gye ɔhene nkwa!</para>
  <para style="q2" vid="PSA 20:9">Na sɛ yɛfrɛ nso a, gye yɛn so.</para>
  <para style="d" vid="PSA 20:9">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">Dwom 21</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>Ao <char style="nd">Awurade</char>, ɔhene no anigye wɔ wʼahoɔden mu.</para>
  <para style="q2" vid="PSA 21:1">Nʼani gye mmorosoɔ wɔ nkonimdie a wo ma no nti!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Woama no deɛ nʼakoma pɛ;</para>
  <para style="q2" vid="PSA 21:2">woamfa nʼabisadeɛ ankame no.<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Wode nhyira a ɛdi mu hyiaa no</para>
  <para style="q2" vid="PSA 21:3">na wode sikakɔkɔɔ amapa ahenkyɛ hyɛɛ no.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Ɔbisaa wo hɔ nkwa, na wode maa no,</para>
  <para style="q2" vid="PSA 21:4">nna tentene a ɛnni awieeɛ.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Nkonimdie a woma no enti, nʼanimuonyam so;</para>
  <para style="q2" vid="PSA 21:5">wode kɛseyɛ ne anidie adom no.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Ampa ara, woama no nhyira a ɛnsa da</para>
  <para style="q2" vid="PSA 21:6">na wo nsrahwɛ ama me ho ahosɛpɛ me.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Ɔhene no de ne ho to <char style="nd">Awurade</char> so;</para>
  <para style="q2" vid="PSA 21:7">Ɔsorosoroni no nokorɛ dɔ no enti,</para>
  <para style="q2" vid="PSA 21:7">Ɔhene renhinhim.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Wo nsa bɛka wʼatamfoɔ nyinaa;</para>
  <para style="q2" vid="PSA 21:8">wo nsa nifa bɛsɔ wɔn a wɔkyiri woɔ mu.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Ɛberɛ a wobɛyi wo ho adi no</para>
  <para style="q2" vid="PSA 21:9">wobɛyɛ wɔn sɛ fononoo a emu adɔ.</para>
  <para style="q1" vid="PSA 21:9">
    <char style="nd">Awurade</char> firi nʼabufuhyeɛ mu bɛmene wɔn,</para>
  <para style="q2" vid="PSA 21:9">na ne ogya no ahye wɔn.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Wobɛtɔre wɔn ase wɔ asase so,</para>
  <para style="q2" vid="PSA 21:10">na wɔn asefoɔ afiri adasamma mu.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Ɛwom sɛ wɔbɔ pɔ tia wo</para>
  <para style="q2" vid="PSA 21:11">na wɔyɛ nhyehyɛeɛ bɔne, nanso wɔrenni nkonim;<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>ɛfiri sɛ wobɛma wɔasane wɔn akyi</para>
  <para style="q2" vid="PSA 21:12">ɛberɛ a woatwe bɛmma akyerɛ wɔn so.<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Yɛma wo so, Ao <char style="nd">Awurade</char>, wɔ wʼahoɔden mu;</para>
  <para style="q2" vid="PSA 21:13">yɛbɛto nnwom na yɛakamfo wo kɛseyɛ.</para>
  <para style="d" vid="PSA 21:13">Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛdeɛ wɔto “Adekyeeɛ foroteɛ” dwom.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">Dwom 22</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>Me Onyankopɔn, me Onyankopɔn, adɛn enti na woagya me?</para>
  <para style="q2" vid="PSA 22:1">Adɛn enti na me nkwagyeɛ ne wo ntam aware,</para>
  <para style="q2" vid="PSA 22:1">adɛn na mʼapinisie nsɛm ne wo ntam aware?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>Ao me Onyankopɔn, mesu frɛ wo awia, nanso wonnye me so,</para>
  <para style="q2" vid="PSA 22:2">mefrɛ wo anadwo, nanso mennya ɔhome.<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>Nanso, wɔasi wo ɔhene sɛ Ɔkronkronni;</para>
  <para style="q2" vid="PSA 22:3">wo na Israel kamfo woɔ.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Wo mu na yɛn agyanom de wɔn werɛ hyɛeɛ;</para>
  <para style="q2" vid="PSA 22:4">wɔgyee wo diiɛ, na wogyee wɔn.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Wɔsu frɛɛ wo na wogyee wɔn,</para>
  <para style="q2" vid="PSA 22:5">wɔde wɔn ho too wo so na woanni wɔn hwammɔ.<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Nanso meyɛ ɔsonsono, na menyɛ onipa</para>
  <para style="q2" vid="PSA 22:6">nnipa bɔ me ahohora na wɔbu me animtiaa.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Obiara a ɔhunu me di me ho fɛw;</para>
  <para style="q2" vid="PSA 22:7">wɔtwa me adapaa, woso wɔn ti ka sɛ:<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“Ɔde ne ho to <char style="nd">Awurade</char> so;</para>
  <para style="q2" vid="PSA 22:8">ma <char style="nd">Awurade</char> mmɛgye no.</para>
  <para style="q1" vid="PSA 22:8">Ma ɔmmɛboa no,</para>
  <para style="q2" vid="PSA 22:8">ɛfiri sɛ ɔwɔ ne mu anigyeɛ.”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>Wo na woyii me firii awotwaa mu baeɛ</para>
  <para style="q2" vid="PSA 22:9">na womaa mede me ho too wo so</para>
  <para style="q2" vid="PSA 22:9">ɛberɛ a metua me maame nufoɔ ano mpo.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Ɛfiri mʼawoɔ mu na wɔde me too wo soɔ;</para>
  <para style="q2" vid="PSA 22:10">ɛfiri me maame yafunu mu, woayɛ me Onyankopɔn.<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Ntwe wo ho mfiri me ho!</para>
  <para style="q2" vid="PSA 22:11">Ɛfiri sɛ amaneɛ abɛn</para>
  <para style="q2" vid="PSA 22:11">na ɔboafoɔ nni baabi.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Anantwinini bebree atwa me ho ahyia;</para>
  <para style="q2" vid="PSA 22:12">Basan anantwinini a wɔn ho yɛ den atwa me ho ahyia.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Gyata a wɔbobom na wɔtete wɔn ahaboa mu</para>
  <para style="q2" vid="PSA 22:13">abuebue wɔn anom tɛtrɛɛ de kyerɛ me.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Wɔahwie me agu sɛ nsuo,</para>
  <para style="q2" vid="PSA 22:14">na me nnompe nyinaa ahodwo.</para>
  <para style="q1" vid="PSA 22:14">Mʼakoma adane ayɛ sɛ nku;</para>
  <para style="q2" vid="PSA 22:14">anane afiri me mu.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Mʼahoɔden awe te sɛ kyɛmferɛ mu.</para>
  <para style="q2" vid="PSA 22:15">Na me tɛkrɛma atare mʼanom.</para>
  <para style="q2" vid="PSA 22:15">Wode me ato owuo mfuturo mu.<verse eid="PSA 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Nkraman atwa me ho ahyia</para>
  <para style="q2" vid="PSA 22:16">nnebɔneyɛfoɔ kuo atwa me ho ahyia,</para>
  <para style="q2" vid="PSA 22:16">wɔahwire me nsa ne me nan mu.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Mɛtumi akan me nnompe nyinaa;</para>
  <para style="q2" vid="PSA 22:17">Mʼatamfoɔ di me nhwɛhaa na wɔsere me.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Wɔkyɛ me atadeɛ mu fa,</para>
  <para style="q2" vid="PSA 22:18">na wɔbɔ me ntoma so ntonto.<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>Na wo, Ao <char style="nd">Awurade</char>, ntwe wo ho.</para>
  <para style="q2" vid="PSA 22:19">Ao mʼAhoɔden bra ntɛm bɛboa me.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Gye me kra firi akofena ano;</para>
  <para style="q2" vid="PSA 22:20">gye me nkwa a ɛsom bo no firi nkraman tumi ase.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Gye me nkwa firi gyata anom;</para>
  <para style="q2" vid="PSA 22:21">gye me firi ɛkoɔ mmɛn so.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Mɛbɔ wo din akyerɛ me nuanom;</para>
  <para style="q2" vid="PSA 22:22">mɛkamfo wo wɔ wɔn a wɔahyia hɔ no nyinaa anim.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>Monkamfo <char style="nd">Awurade</char>, mo a mosuro no no!</para>
  <para style="q2" vid="PSA 22:23">Mo a moyɛ Yakob asefoɔ, monhyɛ no animuonyam!</para>
  <para style="q2" vid="PSA 22:23">Mo Israel asefoɔ nyinaa, monni no ni!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Ɔmmuu nʼani nguu</para>
  <para style="q2" vid="PSA 22:24">ɔmanehunufoɔ ateetee so,</para>
  <para style="q1" vid="PSA 22:24">ɔmfaa nʼanim nhintaa no;</para>
  <para style="q2" vid="PSA 22:24">na mmom watie ne sufrɛ a ɔde repɛ mmoa.<verse eid="PSA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Me botaeɛ a mede yi wo ayɛ wɔ badwa mu no firi wo;</para>
  <para style="q2" vid="PSA 22:25">mɛdi me bɔhyɛ so wɔ wɔn a wɔsuro wo no anim.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Ahiafoɔ bɛdidi na wɔamee;</para>
  <para style="q2" vid="PSA 22:26">wɔn a wɔhwehwɛ <char style="nd">Awurade</char> bɛyi no ayɛ.</para>
  <para style="q2" vid="PSA 22:26">Mo akoma nnya nkwa daa.<verse eid="PSA 22:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Asase ano nyinaa</para>
  <para style="q2" vid="PSA 22:27">bɛkae akɔ <char style="nd">Awurade</char> nkyɛn,</para>
  <para style="q1" vid="PSA 22:27">na amanaman no mmusua nyinaa</para>
  <para style="q2" vid="PSA 22:27">bɛkoto nʼanim,<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>ɛfiri sɛ ahennie wɔ <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 22:28">na ɔdi amanaman so ɔhene.<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Asase so adefoɔ nyinaa bɛdidi na wɔasɔre no;</para>
  <para style="q2" vid="PSA 22:29">wɔn a wɔkɔ dɔteɛ mu nyinaa bɛbu nkotodwe nʼanim,</para>
  <para style="q2" vid="PSA 22:29">wɔn a wɔrentumi mma nkwa mu.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Nkyirimma nyinaa bɛsom no;</para>
  <para style="q2" vid="PSA 22:30">wɔbɛka Awurade ho asɛm akyerɛ awoɔ ntoatoasoɔ a ɛdidi soɔ.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Wɔbɛka ne tenenee akyerɛ</para>
  <para style="q2" vid="PSA 22:31">nnipa a wɔnnya nwoo wɔn</para>
  <para style="q2" vid="PSA 22:31">ɛfiri sɛ ɔno na wayɛ.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">Dwom 23</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>
    <char style="nd">Awurade</char> ne me hwɛfo, hwee renhia me.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>Ɔma meda wira frɔmfrɔm adidibea mu;</para>
  <para style="q1" vid="PSA 23:2">ɔgya me kɔ nsuo a ɛho dwoɔ ho,<verse eid="PSA 23:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3"/>ɔdwodwo me kra.</para>
  <para style="q1" vid="PSA 23:3">Ɔde me fa akwantenenee so,</para>
  <para style="q2" vid="PSA 23:3">ne din enti.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Sɛ menam</para>
  <para style="q2" vid="PSA 23:4">owuo sum kabii mu mpo a,</para>
  <para style="q1" vid="PSA 23:4">mensuro bɔne bi,</para>
  <para style="q2" vid="PSA 23:4">ɛfiri sɛ, wo ne me na ɛwɔ hɔ;</para>
  <para style="q1" vid="PSA 23:4">wʼabaa ne wo poma</para>
  <para style="q2" vid="PSA 23:4">na ɛkyekyere me werɛ.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Woto me ɛpono wɔ</para>
  <para style="q2" vid="PSA 23:5">mʼatamfoɔ anim.</para>
  <para style="q1" vid="PSA 23:5">Wode ngo afɔ me tirim;</para>
  <para style="q2" vid="PSA 23:5">me kuruwa ayɛ ma abu so.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Yie ne adɔeɛ nko na ɛbɛdi mʼakyi</para>
  <para style="q2" vid="PSA 23:6">me nkwa nna nyinaa;</para>
  <para style="q1" vid="PSA 23:6">na mɛtena <char style="nd">Awurade</char> fie</para>
  <para style="q2" vid="PSA 23:6">daa.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">Dwom 24</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>Asase ne deɛ ɛwɔ mu nyinaa yɛ <char style="nd">Awurade</char> dea;</para>
  <para style="q2" vid="PSA 24:1">ewiase ne wɔn a wɔte soɔ nyinaa wɔ no;<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>ɛfiri sɛ ɔno na ɔtoo ne fapem wɔ ɛpo so</para>
  <para style="q2" vid="PSA 24:2">na ɔde sii nsuo ani.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Hwan na ɔbɛtumi aforo <char style="nd">Awurade</char> bepɔ no?</para>
  <para style="q2" vid="PSA 24:3">Hwan na ɔbɛtumi agyina ne tenabea kronkron hɔ?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>Deɛ ɔyɛ ade tenenee na nʼakoma mu teɛ,</para>
  <para style="q2" vid="PSA 24:4">deɛ ne kra nni ahoni akyi</para>
  <para style="q2" vid="PSA 24:4">na ɔnnka ntanhunu.<verse eid="PSA 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Ɔbɛnya <char style="nd">Awurade</char> nsam nhyira</para>
  <para style="q2" vid="PSA 24:5">ne bembuo a ɛfiri ne Nkwagyeɛ Onyankopɔn.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Saa na awoɔ ntoatoasoɔ a wɔhwehwɛ <char style="nd">Awurade</char> no teɛ,</para>
  <para style="q2" vid="PSA 24:6">wɔn a wɔhwehwɛ wʼanim no, Ao Yakob Onyankopɔn.<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>Mo apono, mommuebue</para>
  <para style="q2" vid="PSA 24:7">mommuebue, mo tete apono,</para>
  <para style="q2" vid="PSA 24:7">na Animuonyam Ɔhene nhyɛne mu.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Hwan ne saa Animuonyam Ɔhene yi?</para>
  <para style="q2" vid="PSA 24:8">Ɔno ne <char style="nd">Awurade</char> ɔhoɔdenfoɔ ne otumfoɔ no;</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">Awurade</char> a ɔyɛ ɔko mu nkonimdifoɔ.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Mommuebue, Ao mo apono</para>
  <para style="q2" vid="PSA 24:9">mommuebue, mo tete apono,</para>
  <para style="q2" vid="PSA 24:9">na animuonyam Ɔhene no nkɔ mu.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Hwan ne saa animuonyam Ɔhene yi?</para>
  <para style="q2" vid="PSA 24:10">Asafo <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="PSA 24:10">ɔno ne animuonyam Ɔhene no.<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">Dwom 25</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>Ao <char style="nd">Awurade</char>, mema me kra so kyerɛ wo;<verse eid="PSA 25:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 25:2"/>wo so, Ao me Onyankopɔn, na mede me ho to.</para>
  <para style="q1" vid="PSA 25:2">Mma mʼanim ngu ase</para>
  <para style="q2" vid="PSA 25:2">na mma mʼatamfoɔ nso nni me so nkonim.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Wɔn a wɔde wɔn ho to wo so no mu biara</para>
  <para style="q2" vid="PSA 25:3">ani renwu da,</para>
  <para style="q1" vid="PSA 25:3">mmom, wɔn a wɔyɛ kɔntɔnkye no</para>
  <para style="q2" vid="PSA 25:3">anim bɛgu ase.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>Kyerɛ me wʼakwan, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 25:4">na me nhunu wʼatempɔn.<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>Fa wo nokorɛ no so kyerɛkyerɛ me,</para>
  <para style="q2" vid="PSA 25:5">ɛfiri sɛ woyɛ Onyankopɔn, me Gyefoɔ,</para>
  <para style="q2" vid="PSA 25:5">na mʼani da wo so daa nyinaa.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>Kae, Ao <char style="nd">Awurade</char>, wo mmɔborɔhunu ne wo dɔ kɛseɛ</para>
  <para style="q2" vid="PSA 25:6">a ɛwɔ hɔ firi tete no.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Nkae me mmabunu berɛ mu bɔne</para>
  <para style="q2" vid="PSA 25:7">ne mʼatuateɛ akwan;</para>
  <para style="q1" vid="PSA 25:7">kae me sɛdeɛ wʼadɔeɛ teɛ,</para>
  <para style="q2" vid="PSA 25:7">Ao <char style="nd">Awurade</char>, ɛfiri sɛ wo yɛ.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>
    <char style="nd">Awurade</char> yɛ, na ɔtene;</para>
  <para style="q2" vid="PSA 25:8">enti ɔkyerɛkyerɛ nnebɔneyɛfoɔ nʼakwan.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Ɔde ahobrɛasefoɔ fa ɛkwan pa so</para>
  <para style="q2" vid="PSA 25:9">na ɔkyerɛ wɔn nʼapɛdeɛ.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>
    <char style="nd">Awurade</char> akwan nyinaa yɛ ɔdɔ ne nokorɛdie</para>
  <para style="q2" vid="PSA 25:10">ma wɔn a wɔdi nʼapam mu ahyɛdeɛ soɔ.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>Ao <char style="nd">Awurade</char>, me bɔne so deɛ,</para>
  <para style="q2" vid="PSA 25:11">nanso wo din enti, fa kyɛ me.<verse eid="PSA 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Enti hwan ne onipa a ɔsuro <char style="nd">Awurade</char>?</para>
  <para style="q2" vid="PSA 25:12">Ɔbɛkyerɛ no kwan a wabɔ ama no.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Ɔbɛdi yie wɔ ne nkwa nna mu,</para>
  <para style="q2" vid="PSA 25:13">na nʼasefoɔ afa asase no sɛ wɔn agyapadeɛ.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>
    <char style="nd">Awurade</char> da nʼatirimsɛm adi kyerɛ wɔn a wɔsuro no;</para>
  <para style="q2" vid="PSA 25:14">na ɔma wɔhunu nʼapam.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Mʼani da <char style="nd">Awurade</char> so daa,</para>
  <para style="q2" vid="PSA 25:15">ɛfiri sɛ ɔno nko ara na ɔbɛyi me nan afiri afidie mu.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Dane wʼani hwɛ me, na dom me,</para>
  <para style="q2" vid="PSA 25:16">ɛfiri sɛ meyɛ ankonam na meyɛ mmɔbɔ.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Mʼakoma mu dadwene adɔɔso;</para>
  <para style="q2" vid="PSA 25:17">yi me dadwene firi me so.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Hwɛ me haw ne mʼahohiahia</para>
  <para style="q2" vid="PSA 25:18">na yi me bɔne nyinaa firi me so.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Hwɛ sɛdeɛ mʼatamfoɔ adɔɔso</para>
  <para style="q2" vid="PSA 25:19">ne ɔtan kɛseɛ a wɔde tan me!<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Bɔ me nkwa ho ban na gye me.</para>
  <para style="q2" vid="PSA 25:20">Mma mʼanim ngu ase,</para>
  <para style="q2" vid="PSA 25:20">ɛfiri sɛ me dwanekɔbea ne wo.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Ma tenenee ne nokorɛ mmɔ me ho ban,</para>
  <para style="q2" vid="PSA 25:21">ɛfiri sɛ mʼani da wo so.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>Gye Israel, Ao Onyankopɔn,</para>
  <para style="q2" vid="PSA 25:22">firi wɔn haw nyinaa mu.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">Dwom 26</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>Bu me bem, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 26:1">ɛfiri sɛ, mabɔ bra a asɛm nni ho:</para>
  <para style="q1" vid="PSA 26:1">mede me ho too <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 26:1">na manhinhim.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>Sɔ me hwɛ, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 26:2">hwehwɛ mʼakoma ne mʼadwene mu.<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>Wʼadɔeɛ wɔ mʼanim daa</para>
  <para style="q2" vid="PSA 26:3">na mɛnante wo nokorɛ mu.<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Me ne nnaadaafoɔ ntena</para>
  <para style="q2" vid="PSA 26:4">na me ne nyaatwomfoɔ nso nni hwee yɛ.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Mekyiri nnebɔneyɛfoɔ dwabɔ</para>
  <para style="q2" vid="PSA 26:5">na mempɛ sɛ me ne amumuyɛfoɔ tena.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Mehohoro me nsa wɔ bembuo mu,</para>
  <para style="q2" vid="PSA 26:6">na makɔ wʼafɔrebukyia ho ahyia, Ao <char style="nd">Awurade</char>,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>na mepae mu ka wʼayɛyie</para>
  <para style="q2" vid="PSA 26:7">na meka wʼanwanwadeɛ nyinaa.<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>Mʼani gye efie a wote mu ho, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 26:8">baabi a wʼanimuonyam wɔ no.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Mfa me kra nka nnebɔneyɛfoɔ deɛ ho nkɔ.</para>
  <para style="q2" vid="PSA 26:9">Mfa me nkwa nka mogyapɛfoɔ deɛ ho,<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>wɔn a amumuyɛ nhyehyɛeɛ wɔ wɔn nsam</para>
  <para style="q2" vid="PSA 26:10">na adanmudeɛ ayɛ wɔn nsa nifa ma.<verse eid="PSA 26:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Nanso mebɔ ɔbra a ɛho teɛ.</para>
  <para style="q2" vid="PSA 26:11">Hu me mmɔbɔ na gye me nkwa.<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Me nan sisi asase tamaa so;</para>
  <para style="q2" vid="PSA 26:12">na dwabɔ akɛseɛ ase na mɛkamfo <char style="nd">Awurade</char>.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">Dwom 27</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>
    <char style="nd">Awurade</char> ne me hann ne me nkwagyeɛ;</para>
  <para style="q2" vid="PSA 27:1">hwan na mensuro no?</para>
  <para style="q1" vid="PSA 27:1">
    <char style="nd">Awurade</char> ne me nkwa ahoɔden,</para>
  <para style="q2" vid="PSA 27:1">na hwan anim na me ho mpopoɔ?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Sɛ nnipa bɔne toa me</para>
  <para style="q2" vid="PSA 27:2">pɛ sɛ wɔkum me a,</para>
  <para style="q1" vid="PSA 27:2">sɛ mʼatamfoɔ to hyɛ me so a</para>
  <para style="q2" vid="PSA 27:2">wɔbɛsuntisunti ahwehwe ase.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Sɛ dɔm mpo twa me ho hyia a,</para>
  <para style="q2" vid="PSA 27:3">mʼakoma rentu;</para>
  <para style="q1" vid="PSA 27:3">mpo sɛ wɔtu me so sa a,</para>
  <para style="q2" vid="PSA 27:3">ɛno mu koraa na menya awerɛhyɛmu.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Adeɛ baako na mebisa <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 27:4">na ɛno na mehwehwɛ;</para>
  <para style="q1" vid="PSA 27:4">sɛ mɛtena <char style="nd">Awurade</char> fie</para>
  <para style="q2" vid="PSA 27:4">me nkwa nna nyinaa,</para>
  <para style="q1" vid="PSA 27:4">na mahwɛ <char style="nd">Awurade</char> ahoɔfɛ</para>
  <para style="q2" vid="PSA 27:4">na mahwehwɛ no wɔ nʼasɔrefie.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Wɔ hia ɛda mu no</para>
  <para style="q2" vid="PSA 27:5">ɔde me sie nʼatenaeɛ;</para>
  <para style="q1" vid="PSA 27:5">ɔkora me wɔ Ahyiaeɛ Ntomadan mu.</para>
  <para style="q2" vid="PSA 27:5">Ɔde me si ɔbotan so wɔ ɔsorosoro.<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Afei ɔbɛma me tiri so</para>
  <para style="q2" vid="PSA 27:6">wɔ atamfoɔ a wɔatwa me ho ahyia no so;</para>
  <para style="q1" vid="PSA 27:6">mede anigyeɛ bɛbɔ afɔdeɛ wɔ nʼAhyiaeɛ Ntomadan mu;</para>
  <para style="q2" vid="PSA 27:6">na mɛto dwom, ahyehyɛ nnwom ama <char style="nd">Awurade</char>.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>Ao, <char style="nd">Awurade</char>, sɛ mesu frɛ wo a, tie me!</para>
  <para style="q2" vid="PSA 27:7">Hu me mmɔbɔ na gye me so!<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Mʼakoma ka wɔ wo ho sɛ, “Hwehwɛ nʼanim!”</para>
  <para style="q2" vid="PSA 27:8">Wʼanim, Ao <char style="nd">Awurade</char> na mɛhwehwɛ.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Mfa wʼanim nhinta me,</para>
  <para style="q2" vid="PSA 27:9">mfa abufuo mpamo wo ɔsomfoɔ</para>
  <para style="q2" vid="PSA 27:9">me ɔboafoɔ ne wo.</para>
  <para style="q1" vid="PSA 27:9">Mpo me na nnya me,</para>
  <para style="q2" vid="PSA 27:9">Ao me Nkwagyeɛ Onyankopɔn.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Mʼagya ne me maame bɛgya me hɔ deɛ,</para>
  <para style="q2" vid="PSA 27:10">nanso <char style="nd">Awurade</char> bɛgye me.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>Kyerɛ me wʼakwan, Ao <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 27:11">fa me fa ɛkwan tee so,</para>
  <para style="q2" vid="PSA 27:11">me nhyɛsofoɔ enti.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Nnyaa me mma sɛdeɛ mʼatamfoɔ pɛ,</para>
  <para style="q2" vid="PSA 27:12">adansekurumfoɔ sɔre tia me</para>
  <para style="q2" vid="PSA 27:12">na wɔpu awurukasɛm.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Meda so wɔ saa anidasoɔ yi sɛ:</para>
  <para style="q2" vid="PSA 27:13">mɛhunu <char style="nd">Awurade</char> ayamyɛ</para>
  <para style="q2" vid="PSA 27:13">wɔ ateasefoɔ asase so.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Twɛn <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 27:14">Hyɛ wo ho den na ma wo bo nyɛ duru</para>
  <para style="q2" vid="PSA 27:14">na twɛn <char style="nd">Awurade</char>.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">Dwom 28</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>Wo na mesu mefrɛ wo,</para>
  <para style="q2" vid="PSA 28:1">Ao <char style="nd">Awurade</char> me Botan;</para>
  <para style="q2" vid="PSA 28:1">nsi wʼaso wɔ me enti.</para>
  <para style="q1" vid="PSA 28:1">Sɛ woyɛ komm a,</para>
  <para style="q2" vid="PSA 28:1">mɛyɛ sɛ wɔn a wɔasiane kɔ amena mu no.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Tie me mmɔborɔ su</para>
  <para style="q2" vid="PSA 28:2">ɛberɛ a mefrɛ wo pɛ mmoa</para>
  <para style="q1" vid="PSA 28:2">ɛberɛ a mema me nsa so</para>
  <para style="q2" vid="PSA 28:2">kyerɛ wo Tenabea Kronkron hɔ.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Mfa me mfra amumuyɛfoɔ mu ntwe me nkɔ</para>
  <para style="q2" vid="PSA 28:3">wɔn a wɔyɛ bɔne no.</para>
  <para style="q1" vid="PSA 28:3">Wɔne wɔn yɔnkonom kasa fɛfɛ</para>
  <para style="q2" vid="PSA 28:3">nanso wɔde ɔtan sie wɔn akoma mu.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Twe wɔn aso wɔ deɛ wɔayɛ no so;</para>
  <para style="q2" vid="PSA 28:4">wɔn adwuma bɔne no so;</para>
  <para style="q1" vid="PSA 28:4">tua deɛ wɔde wɔn nsa ayɛ so ka</para>
  <para style="q2" vid="PSA 28:4">na fa deɛ ɛfata wɔn sane bra wɔn so.<verse eid="PSA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Sɛ wɔmmu deɛ <char style="nd">Awurade</char> ayɛ</para>
  <para style="q2" vid="PSA 28:5">ne deɛ ɔde ne nsa ayɛ no enti,</para>
  <para style="q1" vid="PSA 28:5">ɔbɛbrɛ wɔn ase</para>
  <para style="q2" vid="PSA 28:5">na ɔremma wɔnnsɔre bio.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Ayɛyie nka <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 28:6">ɛfiri sɛ watie me mmɔborɔ su.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>
    <char style="nd">Awurade</char> ne mʼahoɔden ne mʼakokyɛm;</para>
  <para style="q2" vid="PSA 28:7">mʼakoma wɔ ne mu ahotosoɔ, na ɔboa me.</para>
  <para style="q1" vid="PSA 28:7">Mʼakoma di ahurisie</para>
  <para style="q2" vid="PSA 28:7">na mede dwomtoɔ bɛda no ase.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>
    <char style="nd">Awurade</char> yɛ ahoɔden ma ne nkurɔfoɔ;</para>
  <para style="q2" vid="PSA 28:8">ne nkwagyeɛ nsraban ma deɛ wɔasra no ngo.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Gye wo nkurɔfoɔ na hyira wʼagyapadeɛ;</para>
  <para style="q2" vid="PSA 28:9">yɛ wɔn hwefoɔ, na wo ne wɔn nnante afebɔɔ.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">Dwom 29</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>Momfa mma <char style="nd">Awurade</char> no, Ao ɔsoro abɔdeɛ,</para>
  <para style="q2" vid="PSA 29:1">momfa animuonyam ne tumi mma <char style="nd">Awurade</char>.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Momfa animuonyam a ɛfata <char style="nd">Awurade</char> din mma no;</para>
  <para style="q2" vid="PSA 29:2">monsɔre <char style="nd">Awurade</char> wɔ nʼanimuonyam kronkron mu.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>
    <char style="nd">Awurade</char> nne wɔ nsuo no so;</para>
  <para style="q2" vid="PSA 29:3">animuonyam Onyankopɔn bobom,</para>
  <para style="q1" vid="PSA 29:3">
    <char style="nd">Awurade</char> bobom wɔ nsuo akɛseɛ so.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>
    <char style="nd">Awurade</char> nne mu wɔ tumi;</para>
  <para style="q2" vid="PSA 29:4">
    <char style="nd">Awurade</char> nne mu wɔ animuonyam.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>
    <char style="nd">Awurade</char> nne bubu ntweneduro;</para>
  <para style="q2" vid="PSA 29:5">
    <char style="nd">Awurade</char> nne bubu Lebanon ntweneduro mu nketenkete.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Ɔma Lebanon hurihuri te sɛ nantwie ba,</para>
  <para style="q2" vid="PSA 29:6">na Sirion nso sɛ ɛkoɔ ba.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>
    <char style="nd">Awurade</char> nne pa ma anyinam ogya dɛre<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>
    <char style="nd">Awurade</char> nne woso ɛserɛ so;</para>
  <para style="q2" vid="PSA 29:8">
    <char style="nd">Awurade</char> woso Kades serɛ.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>
    <char style="nd">Awurade</char> nne kyinkyim adum</para>
  <para style="q2" vid="PSA 29:9">na ɛma kwaeɛ yɛ kwaterekwa.</para>
  <para style="q1" vid="PSA 29:9">Nʼasɔredan mufoɔ nyinaa team ka sɛ,</para>
  <para style="q2" vid="PSA 29:9">“Animuonyam nka Onyankopɔn!”<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>
    <char style="nd">Awurade</char> di ɔhene wɔ nsuyire so;</para>
  <para style="q2" vid="PSA 29:10">wɔasi <char style="nd">Awurade</char> ɔhene afebɔɔ.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>
    <char style="nd">Awurade</char> ma ne nkurɔfoɔ ahoɔden,</para>
  <para style="q2" vid="PSA 29:11">na ɔde asomdwoeɛ hyira wɔn.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">Dwom 30</para>
  <para style="d">Dwom a wɔto de buee Asɔredan no ano. Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>Mema wo so, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 30:1">ɛfiri sɛ, woayi me afiri ebunu mu</para>
  <para style="q2" vid="PSA 30:1">na woamma mʼatamfoɔ ansere me.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>Ao <char style="nd">Awurade</char> me Onyankopɔn, mesu frɛɛ wo sɛ boa me</para>
  <para style="q2" vid="PSA 30:2">na wosaa me yadeɛ.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>Ao <char style="nd">Awurade</char>, woyii me firii damena mu;</para>
  <para style="q2" vid="PSA 30:3">wode me ho kyɛɛ me na woamma mankɔ amena mu.<verse eid="PSA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Monto ayɛyie nnwom mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 30:4">mo a moyɛ nʼahotefoɔ!</para>
  <para style="q1" vid="PSA 30:4">Monkamfo ne din kronkron no.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Nʼabufuo nkyɛre,</para>
  <para style="q2" vid="PSA 30:5">na nʼadɔeɛ wɔ hɔ daa;</para>
  <para style="q1" vid="PSA 30:5">agyaadwotwa bɛwɔ hɔ anadwo,</para>
  <para style="q2" vid="PSA 30:5">nanso ahosɛpɛ bɛba anɔpa.<verse eid="PSA 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Metee nka sɛ mewɔ banbɔ no, mekaa sɛ,</para>
  <para style="q2" vid="PSA 30:6">“Merenhinhim da.”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>Ao <char style="nd">Awurade</char>, woyɛɛ me adom no</para>
  <para style="q2" vid="PSA 30:7">womaa me bepɔ gyinaa pintinn</para>
  <para style="q1" vid="PSA 30:7">na wode wʼanim hintaa me no,</para>
  <para style="q2" vid="PSA 30:7">me bo tuiɛ.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>Wo, <char style="nd">Awurade</char> na mefrɛɛ woɔ;</para>
  <para style="q2" vid="PSA 30:8">wo hɔ na mesu mesrɛɛ mmɔborɔhunu sɛ:<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Mfasoɔ bɛn na ɛwɔ me sɛeɛ ho,</para>
  <para style="q2" vid="PSA 30:9">sɛ mɛkɔ amena mu?</para>
  <para style="q1" vid="PSA 30:9">Mfuturo bɛyi wo ayɛ anaa?</para>
  <para style="q2" vid="PSA 30:9">Ɛbɛpae mu aka wo nokorɛdie anaa?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>Tie me, Ao <char style="nd">Awurade</char>, na hunu me mmɔbɔ!</para>
  <para style="q2" vid="PSA 30:10">Ao <char style="nd">Awurade</char>, yɛ me ɔboafoɔ.”<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Wodanee mʼagyaadwotwa yɛɛ no asa;</para>
  <para style="q2" vid="PSA 30:11">woyii mʼayitoma firii me ho</para>
  <para style="q2" vid="PSA 30:11">na wode anigyeɛ firaa me,<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>sɛ mʼakoma bɛto nnwom ama wo na ɛrenyɛ komm.</para>
  <para style="q2" vid="PSA 30:12">Ao <char style="nd">Awurade</char> me Onyankopɔn, mɛda wo ase daa.</para>
  <para style="d" vid="PSA 30:12">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">Dwom 31</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>Wo mu, Ao <char style="nd">Awurade</char>, na manya hintabea;</para>
  <para style="q2" vid="PSA 31:1">mma mʼanim ngu ase;</para>
  <para style="q2" vid="PSA 31:1">firi wo tenenee mu gye me.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Yɛ aso ma me,</para>
  <para style="q2" vid="PSA 31:2">bra ntɛm bɛgye me;</para>
  <para style="q1" vid="PSA 31:2">yɛ me banbɔ botan,</para>
  <para style="q2" vid="PSA 31:2">aban a mʼatamfoɔ nsa renka me.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Sɛ woyɛ me botan ne mʼaban enti,</para>
  <para style="q2" vid="PSA 31:3">wo din enti, di mʼanim na kyerɛ me ɛkwan.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Gye me firi afidie a wɔasum me no mu,</para>
  <para style="q2" vid="PSA 31:4">ɛfiri sɛ wo ne me dwanekɔbea.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Wo nsam na mede me kra hyɛ;</para>
  <para style="q2" vid="PSA 31:5">gye me bio, Ao <char style="nd">Awurade</char>, Onyankopɔn nokwafoɔ.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Mekyiri wɔn a wɔsom abosom huhuo;</para>
  <para style="q2" vid="PSA 31:6">mede me ho to <char style="nd">Awurade</char> so.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Mʼani bɛgye na madi ahurisie wɔ wo dɔ mu,</para>
  <para style="q2" vid="PSA 31:7">ɛfiri sɛ wohunu mʼamanehunu</para>
  <para style="q2" vid="PSA 31:7">na wonim me kra mu haw.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Woamfa me amma ɔtamfoɔ no</para>
  <para style="q2" vid="PSA 31:8">mmom wode me nan asisi petee mu.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Hu me mmɔbɔ, Ao <char style="nd">Awurade</char>, ɛfiri sɛ me ho yera me;</para>
  <para style="q2" vid="PSA 31:9">awerɛhoɔ ama mʼani so ayɛ kusuu</para>
  <para style="q2" vid="PSA 31:9">ɛyea ama me kra ne me honam ayɛ mmerɛ.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Ateeteeɛ rete me nkwa so</para>
  <para style="q2" vid="PSA 31:10">na abooboo te me mfeɛ so;</para>
  <para style="q1" vid="PSA 31:10">ɔhaw enti mʼahoɔden kɔ fam</para>
  <para style="q2" vid="PSA 31:10">na me nnompe nso ahodwo.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Mʼatamfoɔ nyinaa enti,</para>
  <para style="q2" vid="PSA 31:11">mayɛ ahohora wɔ me nnamfonom mu;</para>
  <para style="q1" vid="PSA 31:11">nnipa a wɔnim me suro me,</para>
  <para style="q2" vid="PSA 31:11">na wɔn a wɔhunu me mmɔntene so dwane.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Obiara werɛ afiri me te sɛ deɛ mawuo;</para>
  <para style="q2" vid="PSA 31:12">mayɛ sɛ kukuo a abɔ.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Mete dodoɔ no nsekuro.</para>
  <para style="q2" vid="PSA 31:13">Ahunahuna atwa me ho ahyia.</para>
  <para style="q1" vid="PSA 31:13">Wɔrepam me tiri so</para>
  <para style="q2" vid="PSA 31:13">na wɔbɔ pɔ sɛ wɔbɛkum me.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Nanso, mede me ho ato wo so, Ao <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 31:14">meka sɛ, “Woyɛ me Onyankopɔn.”<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Me mmerɛ wɔ wo nsam</para>
  <para style="q2" vid="PSA 31:15">gye me firi mʼatamfoɔ</para>
  <para style="q2" vid="PSA 31:15">ne wɔn a wɔtaa me no nsam.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Te wʼanim kyerɛ wo ɔsomfoɔ;</para>
  <para style="q2" vid="PSA 31:16">gye me wɔ wo dɔ a ɛnsa da no mu.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Mma mʼanim ngu ase, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 31:17">ɛfiri sɛ masu mafrɛ wo;</para>
  <para style="q1" vid="PSA 31:17">mmom, ma amumuyɛfoɔ anim ngu ase</para>
  <para style="q2" vid="PSA 31:17">na wɔnna wɔn damena mu komm.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>Mua atorofoɔ ano,</para>
  <para style="q2" vid="PSA 31:18">ɛfiri sɛ wɔde ahantan ne anintiabuo</para>
  <para style="q2" vid="PSA 31:18">kasa tia teneneefoɔ.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Wo papayɛ dɔɔso,</para>
  <para style="q2" vid="PSA 31:19">ɛno na woakora ama wɔn a wɔsuro woɔ no;</para>
  <para style="q1" vid="PSA 31:19">ɛno na wode ma wɔn a wɔdwane toa woɔ no</para>
  <para style="q2" vid="PSA 31:19">wɔ nnipa anim.<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Wode wɔn sie wʼanim banbɔ mu</para>
  <para style="q2" vid="PSA 31:20">firi nnipa nsusuiɛ bɔne ho;</para>
  <para style="q1" vid="PSA 31:20">wo tenabea hɔ na wode wɔn sie dwoodwoo</para>
  <para style="q2" vid="PSA 31:20">firi tɛkrɛma a ɛbɔ soboɔ ho.<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Ayɛyi nka <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 31:21">Sɛ wayi ne dɔ nwanwasoɔ akyerɛ me</para>
  <para style="q2" vid="PSA 31:21">ɛberɛ a na mewɔ kuropɔn a atamfoɔ atwa ho ahyia no mu.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Mebɔɔ huboa no, mekaa sɛ:</para>
  <para style="q2" vid="PSA 31:22">“Woayi wʼani me so!”</para>
  <para style="q1" vid="PSA 31:22">Nanso wotee me mmɔborɔ su</para>
  <para style="q2" vid="PSA 31:22">ɛberɛ a mekoto srɛɛ woɔ no.<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Monnɔ <char style="nd">Awurade</char>, mo a moyɛ nʼahotefoɔ nyinaa!</para>
  <para style="q2" vid="PSA 31:23">
    <char style="nd">Awurade</char> kora wɔn a wodi nokorɛ so,</para>
  <para style="q2" vid="PSA 31:23">na ahomasofoɔ deɛ ɔtua wɔn ka pɛpɛɛpɛ.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Monhyɛ den na momma mo bo ntɔ mo yam,</para>
  <para style="q2" vid="PSA 31:24">mo a mowɔ anidasoɔ wɔ <char style="nd">Awurade</char> mu nyinaa.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">Dwom 32</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>Nhyira ne wɔn a</para>
  <para style="q2" vid="PSA 32:1">wɔde wɔn amumuyɛ akyɛ wɔn,</para>
  <para style="q2" vid="PSA 32:1">na wɔakata wɔn bɔne so.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Nhyira nka onipa a</para>
  <para style="q2" vid="PSA 32:2">
    <char style="nd">Awurade</char> mmu ne bɔne ngu ne so,</para>
  <para style="q2" vid="PSA 32:2">na nnaadaa nni ne honhom mu.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Ɛberɛ a meyɛɛ komm no,</para>
  <para style="q2" vid="PSA 32:3">me nnompe yɛɛ mmrɛ</para>
  <para style="q2" vid="PSA 32:3">apinie a mesii no da mu nyinaa enti.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Awia ne anadwo</para>
  <para style="q2" vid="PSA 32:4">wo nsa yɛɛ den wɔ me so;</para>
  <para style="q1" vid="PSA 32:4">mʼahoɔden saeɛ</para>
  <para style="q2" vid="PSA 32:4">sɛdeɛ awiaberɛ mu hyeɛ ma biribi yɛ mmerɛ.<verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Afei, megyee me bɔne too mu.</para>
  <para style="q2" vid="PSA 32:5">Mankata mʼamumuyɛ so.</para>
  <para style="q1" vid="PSA 32:5">Mekaa sɛ, “Mɛka</para>
  <para style="q2" vid="PSA 32:5">me bɔne akyerɛ <char style="nd">Awurade</char>,”</para>
  <para style="q2" vid="PSA 32:5">na wode me bɔne ho afɔdie kyɛɛ me.<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Enti, ma obiara a ɔwɔ nyamesu mmɔ wo mpaeɛ</para>
  <para style="q2" vid="PSA 32:6">ɛberɛ a wɔhunu woɔ;</para>
  <para style="q1" vid="PSA 32:6">ampa ara sɛ nsuo akɛseɛ yiri a,</para>
  <para style="q2" vid="PSA 32:6">ɛrenka no.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Wone me hintabea;</para>
  <para style="q2" vid="PSA 32:7">wobɛbɔ me ho ban wɔ amanehunu mu</para>
  <para style="q2" vid="PSA 32:7">na wode nkwagyeɛ nnwom atwa me ho ahyia.<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Mɛkyerɛkyerɛ wo ɛkwan a wobɛfa soɔ</para>
  <para style="q2" vid="PSA 32:8">mɛtu wo fo na mahwɛ wo so.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Nyɛ sɛ ɔpɔnkɔ anaa afunumpɔnkɔ a</para>
  <para style="q2" vid="PSA 32:9">ɔnni nteaseɛ enti</para>
  <para style="q1" vid="PSA 32:9">wɔde nnareka ne ahoma na ɛdanedane no</para>
  <para style="q2" vid="PSA 32:9">sɛ ɛbɛyɛ a wɔbɛba wo nkyɛn.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Ɔmumuyɛfoɔ amanehunu dɔɔso,</para>
  <para style="q2" vid="PSA 32:10">nanso <char style="nd">Awurade</char> adɔeɛ a ɛnsa da no,</para>
  <para style="q2" vid="PSA 32:10">ɛtwa onipa a ɔde ne ho to no so no ho hyia.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Monni ahurisie na mo ani nnye wɔ <char style="nd">Awurade</char> mu, mo teneneefoɔ;</para>
  <para style="q2" vid="PSA 32:11">monto dwom, mo a mo akoma mu teɛ.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">Dwom 33</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Momfa ahurisie nto dwom mma <char style="nd">Awurade</char>, mo teneneefoɔ,</para>
  <para style="q2" vid="PSA 33:1">ɛfata sɛ wɔn a wɔtene no yi no ayɛ.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Momfa sankuo nkamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 33:2">monto dwom mma no wɔ sankuten so.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Monto dwom foforɔ mma no.</para>
  <para style="q2" vid="PSA 33:3">Momfa nimdeɛ mmɔ sankuo no na monteam ahurisie so!<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>
    <char style="nd">Awurade</char> asɛm tene, na ɛyɛ nokorɛ</para>
  <para style="q2" vid="PSA 33:4">ɔdi nokorɛ wɔ deɛ ɔyɛ nyinaa mu.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>
    <char style="nd">Awurade</char> dɔ teneneeyɛ ne atɛntenenee.</para>
  <para style="q2" vid="PSA 33:5">Nʼadɔeɛ a ɛnsa da no ahyɛ asase so ma.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>
    <char style="nd">Awurade</char> asɛm so na wɔnam yɛɛ ɔsorosoro,</para>
  <para style="q2" vid="PSA 33:6">nʼanom homeɛ so na wɔnam yɛɛ ɔsoro asafo.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Ɔka ɛpo nsuo boa ano kuo;</para>
  <para style="q2" vid="PSA 33:7">na ɔde ebunu siee deɛ ɛhɔ dɔ.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Momma asase sofoɔ nyinaa nsuro <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 33:8">na ewiasefoɔ nyinaa mfa anidie mma no.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Ɔno na ɔkasaeɛ na ɛbaa mu</para>
  <para style="q2" vid="PSA 33:9">na ɔhyɛeɛ na ɛgyinaa pintinn.<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>
    <char style="nd">Awurade</char> sɛe amanaman no nhyehyɛeɛ;</para>
  <para style="q2" vid="PSA 33:10">ɔma adasamma nsusuiɛ yɛ kwa.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>Nanso, <char style="nd">Awurade</char> nhyehyɛeɛ tim hɔ daa,</para>
  <para style="q2" vid="PSA 33:11">nʼakoma mu botaeɛ wɔ hɔ ma awoɔ ntoatoasoɔ.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Nhyira ne ɔman a ne Onyankopɔn ne <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 33:12">nnipa a ɔyii wɔn sɛ nʼagyapadeɛ no.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>
    <char style="nd">Awurade</char> hwɛ adasamma nyinaa firi soro.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>Ɔfiri nʼatenaeɛ hwɛ wɔn a wɔte asase so nyinaa.<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>Ɔno ne deɛ ɔbɔɔ wɔn nyinaa akoma,</para>
  <para style="q2" vid="PSA 33:15">enti ɔnim deɛ wɔyɛ nyinaa.<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Ɛnyɛ ɔhene akodɔm kɛseɛ na ɛbɛgye no;</para>
  <para style="q1" vid="PSA 33:16">ɛnyɛ ɔkofoɔ ahoɔden na ɛbɛma no afiri mu afi.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Ɔpɔnkɔ mu ahotosoɔ yɛ kwa wɔ nkwagyeɛ mu;</para>
  <para style="q2" vid="PSA 33:17">nʼahoɔden nyinaa akyi no, ɔrentumi nnye nkwa.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Nanso <char style="nd">Awurade</char> ani wɔ wɔn a wɔsuro no no so,</para>
  <para style="q2" vid="PSA 33:18">wɔn a wɔwɔ anidasoɔ wɔ ne dɔ a ɛnsa da no mu,<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>sɛ ɔbɛgye wɔn afiri owuo mu</para>
  <para style="q2" vid="PSA 33:19">na wama wɔatena nkwa mu wɔ ɛkɔm berɛ mu.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Yɛde anidasoɔ twɛn <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 33:20">ɔyɛ yɛn ɔboafoɔ ne yɛn akokyɛm.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Ne mu na yɛn akoma di ahurisie,</para>
  <para style="q2" vid="PSA 33:21">ɛfiri sɛ yɛde yɛn ho to ne din kronkron no so.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>Ma wʼadɔeɛ a ɛnsa da no ntena yɛn so, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 33:22">sɛdeɛ anidasoɔ a yɛwɔ wɔ mu no teɛ.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">Dwom 34</para>
  <para style="d">Dawid dwom a ɔtoeɛ ɛberɛ a ɔboa pa danee ɔbɔdamfoɔ wɔ Abimelek anim no na ɔpanin no gyaee no ma ɔkɔeɛ no akyi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>Mede aseda bɛma <char style="nd">Awurade</char> berɛ nyinaa;</para>
  <para style="q2" vid="PSA 34:1">nʼayɛyie wɔ mʼanom daa.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Me kra bɛhoahoa ne ho wɔ <char style="nd">Awurade</char> mu;</para>
  <para style="q2" vid="PSA 34:2">ma amanehunufoɔ nte na wɔn nni ahurisie.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Mo ne me nkamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 34:3">momma yɛmmɔ mu nkamfo ne din!<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Mefrɛɛ <char style="nd">Awurade</char> na ɔgyee me so;</para>
  <para style="q2" vid="PSA 34:4">na ɔyii me firii mʼakomatuo nyinaa mu.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Wɔn a wɔhwɛ nʼanim no hyerɛn</para>
  <para style="q2" vid="PSA 34:5">na wɔn anim rengu ase da.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Ohiani yi frɛeɛ, na <char style="nd">Awurade</char> tiee no;</para>
  <para style="q2" vid="PSA 34:6">na ɔgyee no firii nʼahohia nyinaa mu.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>
    <char style="nd">Awurade</char> ɔbɔfoɔ wɛn wɔn a wɔsuro no,</para>
  <para style="q2" vid="PSA 34:7">na ɔgye wɔn.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Monka nhwɛ na monhunu sɛ <char style="nd">Awurade</char> yɛ.</para>
  <para style="q2" vid="PSA 34:8">Nhyira ne onipa a ɔhinta wɔ ne mu.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Monsuro <char style="nd">Awurade</char>, mo a moyɛ nʼahotefoɔ,</para>
  <para style="q2" vid="PSA 34:9">na wɔn a wɔsuro noɔ no nhia hwee.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Agyata yɛ mmrɛ na ɛkɔm de wɔn,</para>
  <para style="q2" vid="PSA 34:10">nanso wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no, adepa biara remmɔ wɔn.<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Mommra, me mma, monyɛ aso mma me;</para>
  <para style="q2" vid="PSA 34:11">mɛkyerɛkyerɛ mo <char style="nd">Awurade</char> ho suro.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Mo mu hwan na ɔpɛ nkwa</para>
  <para style="q2" vid="PSA 34:12">na ɔpɛ sɛ ɔhunu nna papa bebree?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>Ɛnneɛ ɛnsɛ sɛ ɔka kasa bɔne, na ɛsɛ sɛ ɔgyae atorɔtwa.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Twe wo ho firi bɔne ho, na yɛ papa;</para>
  <para style="q2" vid="PSA 34:14">hwehwɛ asomdwoeɛ na ti no.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>
    <char style="nd">Awurade</char> ani wɔ ateneneefoɔ so</para>
  <para style="q2" vid="PSA 34:15">na ɔtie wɔn mpaeɛbɔ;<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>
    <char style="nd">Awurade</char> ani sa wɔn a wɔyɛ bɔne,</para>
  <para style="q2" vid="PSA 34:16">sɛ ɔbɛyi wɔn nkaeɛ afiri asase yi so.<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>Ateneneefoɔ team su, na <char style="nd">Awurade</char> tie wɔn;</para>
  <para style="q2" vid="PSA 34:17">ɔyi wɔn firi wɔn haw nyinaa mu.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>
    <char style="nd">Awurade</char> bɛn wɔn a wɔapa aba</para>
  <para style="q2" vid="PSA 34:18">na ɔgye wɔn a wɔadwerɛ wɔn wɔ honhom mu no nkwa.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Onipa tenenee bɛhunu amaneɛ bebree</para>
  <para style="q2" vid="PSA 34:19">nanso <char style="nd">Awurade</char> gye no firi ne nyinaa mu;<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ɔbɔ ne nnompe nyinaa ho ban,</para>
  <para style="q2" vid="PSA 34:20">sɛdeɛ emu baako mpo mmu.<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Bɔne bɛkum ɔdebɔneyɛfoɔ;</para>
  <para style="q2" vid="PSA 34:21">ɔteneneeni atamfoɔ bɛnya afɔbuo.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>
    <char style="nd">Awurade</char> gye nʼasomfoɔ nkwa;</para>
  <para style="q2" vid="PSA 34:22">wɔn a wɔdwane toa noɔ no mu biara renkɔ afɔbuo mu.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">Dwom 35</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>Ao <char style="nd">Awurade</char> wo ne wɔn a wɔne me di asie no nni asie;</para>
  <para style="q2" vid="PSA 35:1">ko tia wɔn a wɔko tia me.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Fa wʼakokyɛm ne wo nkatanimu;</para>
  <para style="q2" vid="PSA 35:2">na sɔre bra bɛboa me.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Twe pea ne abonnua</para>
  <para style="q2" vid="PSA 35:3">wɔ wɔn a wɔtaa me so</para>
  <para style="q1" vid="PSA 35:3">ka kyerɛ me kra sɛ,</para>
  <para style="q2" vid="PSA 35:3">“Mene wʼagyenkwa.”<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Wɔn a wɔpɛ sɛ wɔkum me no</para>
  <para style="q2" vid="PSA 35:4">ma wɔn anim ngu ase;</para>
  <para style="q1" vid="PSA 35:4">wɔn a wɔbɔ me sɛeɛ ho pɔ no</para>
  <para style="q2" vid="PSA 35:4">ma wɔmfa aniwuo nsane wɔn akyi.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Ma wɔnyɛ sɛ ntɛtɛ a mframa bɔ guo</para>
  <para style="q2" vid="PSA 35:5">wɔn a <char style="nd">Awurade</char> ɔbɔfoɔ repam wɔn.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>Ma wɔn akwan so nnuru sum na ɛso nyɛ toro,</para>
  <para style="q2" vid="PSA 35:6">na <char style="nd">Awurade</char> ɔbɔfoɔ ntaa wɔn so.<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Esiane sɛ wɔde atena sum me afidie kwa</para>
  <para style="q2" vid="PSA 35:7">na wɔtuu amena maa me a menyɛɛ wɔn hwee no enti<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>ma ɔsɛeɛ mmɛfu wɔn mu</para>
  <para style="q2" vid="PSA 35:8">na atena no a wɔde hintaaeɛ nyi wɔn,</para>
  <para style="q2" vid="PSA 35:8">na ma wɔnhwe amena no mu nsɛe.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Afei me kra ani bɛgye wɔ <char style="nd">Awurade</char> mu</para>
  <para style="q2" vid="PSA 35:9">na wasɛpɛ ne ho wɔ ne nkwagyeɛ mu.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Me onipadua nyinaa bɛteam aka sɛ,</para>
  <para style="q2" vid="PSA 35:10">“Hwan na ɔte sɛ wo, Ao <char style="nd">Awurade</char>?</para>
  <para style="q1" vid="PSA 35:10">Wogye ohiani firi ahoɔdenfoɔ nsam</para>
  <para style="q2" vid="PSA 35:10">ne deɛ ɔnnibie firi apoobɔfoɔ nsam.”<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Adansekurumfoɔ sɔre;</para>
  <para style="q2" vid="PSA 35:11">wɔbisa me nneɛma a mennim ho hwee ho asɛm.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Wɔde bɔne tua papa a meyɛ so ka</para>
  <para style="q2" vid="PSA 35:12">na wɔma me kra yɛ basaa.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Nanso, ɛberɛ a wɔyareeɛ no, mefiraa ayitoma</para>
  <para style="q2" vid="PSA 35:13">na mede akɔnkyene brɛɛ me ho ase.</para>
  <para style="q1" vid="PSA 35:13">Ɛberɛ a me mpaeɛbɔ ho mmuaeɛ nnya mmaeɛ no,<verse eid="PSA 35:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14"/>mekɔɔ so twaa adwo</para>
  <para style="q2" vid="PSA 35:14">sɛdeɛ meyɛ ma mʼadamfo anaa onuabarima.</para>
  <para style="q1" vid="PSA 35:14">Mede awerɛhoɔ sii me ti ase</para>
  <para style="q2" vid="PSA 35:14">te sɛ deɛ meregyam me maame.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Nanso, ɛberɛ a mesuntiiɛ no, wɔde anigyeɛ boaa wɔn ho ano;</para>
  <para style="q2" vid="PSA 35:15">ntohyɛsofoɔ twaa me ho hyiaaɛ a mennim</para>
  <para style="q2" vid="PSA 35:15">na wɔdii me ho nsekuro a wɔantwa so da.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Wɔde adwemmɔne dii me ho fɛ te sɛ nnipa a wɔnni nyamesu;</para>
  <para style="q2" vid="PSA 35:16">wɔtwɛree wɔn se guu me so.<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>Ao <char style="nd">Awurade</char>, wobɛhwɛ wɔn akɔsi da bɛn?</para>
  <para style="q2" vid="PSA 35:17">Gye me nkwa firi wɔn sɛeɛ mu,</para>
  <para style="q2" vid="PSA 35:17">gye me nkwa a ɛsom bo no firi saa agyata yi nsam.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Na mɛda wo ase wɔ dwabɔ kɛseɛ ase;</para>
  <para style="q2" vid="PSA 35:18">wɔ nnipa dodoɔ mu na mɛkamfo woɔ.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Mma mʼatamfoɔ a wɔtane me kwa no</para>
  <para style="q2" vid="PSA 35:19">nhwɛ me haa nsere.</para>
  <para style="q1" vid="PSA 35:19">Mma wɔn a menyɛɛ wɔn hwee nso wɔtane me no</para>
  <para style="q2" vid="PSA 35:19">mmfa adwene bɔne mmu me anikyeɛ.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Wɔnnkasa asomdwoeɛ so,</para>
  <para style="q2" vid="PSA 35:20">na mmom, wɔde ntwatosoɔ</para>
  <para style="q2" vid="PSA 35:20">tia nnipa a wɔmpɛ wɔn ho asɛm wɔ asase yi so.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Wɔhwɛ me haa ka sɛ, “Aane! Aane,</para>
  <para style="q2" vid="PSA 35:21">yɛde yɛn ankasa ani ahunu.”<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>Ao <char style="nd">Awurade</char>, wahunu na mmua wʼano.</para>
  <para style="q2" vid="PSA 35:22">Nte wo ho nkɔ akyiri, Ao Awurade.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>Nyane, sɔre na bɛbɔ me ho ban!</para>
  <para style="q2" vid="PSA 35:23">Ka bi ma me, me Onyankopɔn ne mʼAwurade.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>Di mʼasɛm ma me wɔ wo tenenee no mu, Ao <char style="nd">Awurade</char> me Onyankopɔn;</para>
  <para style="q2" vid="PSA 35:24">mma wɔn nhwɛ me haa nsere.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Mma wɔnnwene nka sɛ, “Aane, deɛ yɛpɛ ni!”</para>
  <para style="q2" vid="PSA 35:25">anaa wɔnnka sɛ, “Yɛanya no.”<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Ma wɔn a wɔhwɛ me haa sere me wɔ mʼahohiahia mu no</para>
  <para style="q2" vid="PSA 35:26">nyinaa anim ngu ase na wɔnyɛ basaa;</para>
  <para style="q1" vid="PSA 35:26">ma wɔn a wɔdi me so akokurokosɛm no</para>
  <para style="q2" vid="PSA 35:26">nhyɛ aniwuo ne animguaseɛ atadeɛ.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Ma wɔn a wɔdi ahurisie wɔ me bembuo ho no</para>
  <para style="q2" vid="PSA 35:27">mfa anigyeɛ ne ahosɛpɛ nteam</para>
  <para style="q1" vid="PSA 35:27">ɛberɛ nyinaa mu ma wɔnka sɛ, “Momma <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 35:27">ɔno na nʼani gye ne ɔsomfoɔ yiedie ho.”<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Me tɛkrɛma bɛka wo tenenee</para>
  <para style="q2" vid="PSA 35:28">ne wʼayɛyie da mu nyinaa.</para>
  <para style="d" vid="PSA 35:28">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">Dwom 36</para>
  <para style="d">
    <char style="nd">Awurade</char> ɔsomfoɔ Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>Nkɔmhyɛ bi da mʼakoma so</para>
  <para style="q2" vid="PSA 36:1">a ɛfa omumuyɛfoɔ mmarato ho.</para>
  <para style="q1" vid="PSA 36:1">Wɔnnsuro Onyankopɔn.<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Na ɔno ankasa ani so no, ɔdaadaa ne ho dodo</para>
  <para style="q2" vid="PSA 36:2">enti mma ɔnhunu ne bɔne nnyae yɛ.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>Nʼanom nsɛm yɛ atirimuɔden ne nnaadaa;</para>
  <para style="q2" vid="PSA 36:3">ɔnnim nyansa bio, na wayɛ papa.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Ɔda ne mpa so mpo a, ɔbɔ pɔ bɔne;</para>
  <para style="q2" vid="PSA 36:4">na ɔgyaa ne ho ma bɔne ɛkwan</para>
  <para style="q2" vid="PSA 36:4">na ɔmpo deɛ ɛnyɛ.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>
    <char style="nd">Awurade</char>, wʼadɔeɛ duru sorosoro</para>
  <para style="q2" vid="PSA 36:5">wo nokorɛdie duru ewiem tɔnn.<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Wo tenenee te sɛ mmepɔ akɛseɛ.</para>
  <para style="q2" vid="PSA 36:6">Wʼatɛntenenee mu dɔ sɛ ɛpo bunu.</para>
  <para style="q1" vid="PSA 36:6">Ao <char style="nd">Awurade</char>, wokora nnipa ne mmoa nyinaa so.<verse eid="PSA 36:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 36:7"/>Wʼadɔeɛ a ɛnsa da no som bo!</para>
  <para style="q1" vid="PSA 36:7">Nnipa mu akɛseɛ ne nketewa</para>
  <para style="q2" vid="PSA 36:7">nya hintabea wɔ wo ntaban nwunu ase.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Wɔdi deɛ abu soɔ wɔ wo fie</para>
  <para style="q2" vid="PSA 36:8">woma wɔnom firi wʼanika asutene no mu.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Wo nkyɛn na nkwa asutire wɔ;</para>
  <para style="q2" vid="PSA 36:9">wo hann mu na yɛhunu hann.<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Kɔ so dɔ wɔn a wɔnim wo,</para>
  <para style="q2" vid="PSA 36:10">ma wo tenenee ntena wɔn a wɔtene akoma mu.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Mma ɔhantanni nan ntia me</para>
  <para style="q2" vid="PSA 36:11">anaa omumuyɛfoɔ nsa nnsunsum me.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Hwɛ sɛdeɛ nnebɔneyɛfoɔ ahwehwe ase,</para>
  <para style="q2" vid="PSA 36:12">wɔdeda hɔ a wɔrentumi nsɔre bio.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">Dwom 37</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>Nha wo ho nnebɔneyɛfoɔ nti;</para>
  <para style="q2" vid="PSA 37:1">mma wʼani mmere wɔn a wɔyɛ bɔne;<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>Wɔte sɛ ɛserɛ, ɛnkyɛre na ahye,</para>
  <para style="q2" vid="PSA 37:2">wɔte sɛ dua mono, ɛnkyɛre na awu.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Fa wo ho to <char style="nd">Awurade</char> so na yɛ papa.</para>
  <para style="q2" vid="PSA 37:3">Tena asase no so na ma wʼani nka asomdwoeɛ adidibea hɔ.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Ma wʼani nka <char style="nd">Awurade</char> ho</para>
  <para style="q2" vid="PSA 37:4">na woama wo deɛ wʼakoma pɛ.<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Fa wʼakwan hyɛ <char style="nd">Awurade</char> nsam;</para>
  <para style="q2" vid="PSA 37:5">na fa wo ho to ne so, na ɔno na ɔbɛyɛ:<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>ɔbɛma wo teneneeyɛ ahyerɛn sɛ adekyeeɛ,</para>
  <para style="q2" vid="PSA 37:6">na wʼatɛntenenee ayɛ sɛ owigyinaeɛ.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Yɛ komm wɔ <char style="nd">Awurade</char> anim na to wo bo ase twɛn no,</para>
  <para style="q2" vid="PSA 37:7">nha wo ho wɔ wɔn a asi wɔn yie ho</para>
  <para style="q2" vid="PSA 37:7">ɛfiri sɛ wɔnam bɔne akwan so.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Mma wo bo mfu, na gyae abufuhyeɛ;</para>
  <para style="q2" vid="PSA 37:8">nha wo ho, ɛkɔwie bɔne nko ara.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Wɔbɛtwa nnebɔneyɛfoɔ agu,</para>
  <para style="q2" vid="PSA 37:9">nanso wɔn a wɔn ani da <char style="nd">Awurade</char> soɔ no,</para>
  <para style="q2" vid="PSA 37:9">wɔbɛnya asase no adi so.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Ɛrenkyɛre, nnebɔneyɛfoɔ bɛyera.</para>
  <para style="q2" vid="PSA 37:10">Wɔbɛhwehwɛ wɔn, nanso wɔrenhunu wɔn.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>Nanso ahobrɛasefoɔ bɛnya asase no adi so</para>
  <para style="q2" vid="PSA 37:11">na wɔanya asomdwoeɛ mmorosoɔ.<verse eid="PSA 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Amumuyɛfoɔ bɔ pɔ bɔne tia ateneneefoɔ</para>
  <para style="q2" vid="PSA 37:12">na wɔtwɛre wɔn se gu wɔn so;<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>nanso, <char style="nd">Awurade</char> sere amumuyɛfoɔ,</para>
  <para style="q2" vid="PSA 37:13">na ɔnim sɛ wɔn nna abɛn.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Amumuyɛfoɔ twe akofena</para>
  <para style="q2" vid="PSA 37:14">na wɔkuntunu wɔn tadua mu</para>
  <para style="q1" vid="PSA 37:14">sɛ wɔbɛkum ahiafoɔ ne mmɔborɔfoɔ,</para>
  <para style="q2" vid="PSA 37:14">sɛ wɔbɛkum wɔn a wɔn akwan tene.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Nanso, wɔn akofena bɛwowɔ wɔn ankasa akoma mu,</para>
  <para style="q2" vid="PSA 37:15">na wɔn tadua mu abubu.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Kakra a ateneneefoɔ wɔ no som bo</para>
  <para style="q2" vid="PSA 37:16">sene amumuyɛfoɔ bebree ahonya;<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>ɛfiri sɛ, amumuyɛfoɔ ahoɔden bɛsa</para>
  <para style="q2" vid="PSA 37:17">nanso <char style="nd">Awurade</char> bɛwowa ateneneefoɔ.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>
    <char style="nd">Awurade</char> nim wɔn a wɔn ho nni asɛm no nna,</para>
  <para style="q2" vid="PSA 37:18">na wɔn agyapadeɛ bɛtena hɔ daa.<verse eid="PSA 37:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Ahohiahia berɛ mu wɔremmrɛ.</para>
  <para style="q2" vid="PSA 37:19">Ɛkɔm berɛ mu wɔbɛnya ma abu so.<verse eid="PSA 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Nanso, amumuyɛfoɔ bɛyera.</para>
  <para style="q2" vid="PSA 37:20">
    <char style="nd">Awurade</char> atamfoɔ bɛyɛ te sɛ wiram nhwiren;</para>
  <para style="q2" vid="PSA 37:20">wɔbɛtu ayera sɛ wisie.<verse eid="PSA 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Amumuyɛfoɔ pɛ bosea, na wɔntua,</para>
  <para style="q2" vid="PSA 37:21">nanso ɔteneneeni de ahummɔborɔ ma;<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>Wɔn a <char style="nd">Awurade</char> ahyira wɔn no bɛnya asase no adi so,</para>
  <para style="q2" vid="PSA 37:22">na wɔn a ɔdome wɔn no wɔbɛtwa wɔn agu.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>Sɛ <char style="nd">Awurade</char> ani sɔ onipa akwan a,</para>
  <para style="q2" vid="PSA 37:23">ɔma nʼanammɔntuo si pi.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>Sɛ ɔsunti a ɔrenhwe ase,</para>
  <para style="q2" vid="PSA 37:24">ɛfiri sɛ <char style="nd">Awurade</char> kura no wɔ ne nsam.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Na meyɛ aberanteɛ, na seesei mabɔ akɔkoraa,</para>
  <para style="q2" vid="PSA 37:25">na menhunuu ɔteneneeni a <char style="nd">Awurade</char> apa nʼakyi</para>
  <para style="q2" vid="PSA 37:25">anaasɛ ne mma resrɛ aduane.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Ɛberɛ biara ɔyɛ adɔeɛ, na ɔde fɛm kwa;</para>
  <para style="q2" vid="PSA 37:26">na ne mma bɛnya nhyira.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Twe wo ho firi bɔne ho na yɛ papa</para>
  <para style="q2" vid="PSA 37:27">na wobɛtena asase no so afebɔɔ.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Ɛfiri sɛ, <char style="nd">Awurade</char> pɛ deɛ ɛtene,</para>
  <para style="q2" vid="PSA 37:28">na ɔrennya ne nkurɔfoɔ nokwafoɔ no.</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">Wɔbɛnya banbɔ daa nyinaa</para>
  <para style="q2" vid="PSA 37:28">Nanso, amumuyɛfoɔ asefoɔ deɛ, wɔbɛtwa wɔn agu.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Ateneneefoɔ bɛnya asase no adi so</para>
  <para style="q2" vid="PSA 37:29">na wɔatena so afebɔɔ.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Ɔteneneeni ano ka nyansasɛm,</para>
  <para style="q2" vid="PSA 37:30">na ne tɛkrɛma ka deɛ ɛtene.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Ne Onyankopɔn mmara wɔ nʼakoma mu;</para>
  <para style="q1" vid="PSA 37:31">ne nan nnwatiri.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Amumuyɛfoɔ tetɛ ateneneefoɔ</para>
  <para style="q2" vid="PSA 37:32">hwehwɛ sɛ wɔbɛkum wɔn,<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>nanso, <char style="nd">Awurade</char> nnyaa wɔn mma wɔn</para>
  <para style="q2" vid="PSA 37:33">na ɔremma wɔmmu wɔn kumfɔ wɔ asɛnniiɛ.<verse eid="PSA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Montwɛn <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 37:34">na monhwɛ nʼakwan.</para>
  <para style="q1" vid="PSA 37:34">Ɔbɛma mo so na moanya asase no adi so;</para>
  <para style="q2" vid="PSA 37:34">sɛ wɔtwitwa amumuyɛfoɔ no gu a, mobɛhunu.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Mahunu omumuyɛfoɔ a ɔyɛ basabasa</para>
  <para style="q2" vid="PSA 37:35">sɛ ɔredi yie sɛ dua mono a ɛsi asase pa soɔ,<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>nanso ankyɛre na ɛwuiɛ a wɔnhunu no bio;</para>
  <para style="q2" vid="PSA 37:36">mehwehwɛɛ no, nanso manhunu no.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Susu deɛ ɔyɛ pɛ ho, na hwɛ deɛ ɔtene;</para>
  <para style="q2" vid="PSA 37:37">na asomdwoeɛ onipa bɛnya asetena pa daakye.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Nanso wɔbɛsɛe nnebɔneyɛfoɔ nyinaa;</para>
  <para style="q2" vid="PSA 37:38">na wɔbɛtɔre wɔn asefoɔ ase.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Ateneneefoɔ nkwagyeɛ firi <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 37:39">ɔne wɔn aban wɔ amanehunu berɛ mu.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>
    <char style="nd">Awurade</char> boa wɔn na ɔgye wɔn;</para>
  <para style="q2" vid="PSA 37:40">ɔyi wɔn firi amumuyɛfoɔ nsam na ɔgye wɔn nkwa,</para>
  <para style="q2" vid="PSA 37:40">ɛfiri sɛ wɔhinta wɔ ne mu.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">Dwom 38</para>
  <para style="d">Dawid dwom. Adesrɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>Ao <char style="nd">Awurade</char>, nka mʼanim wɔ wʼabofuo mu</para>
  <para style="q2" vid="PSA 38:1">na ntwe mʼaso wɔ wʼabufuhyeɛ mu.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>Wo bɛmma ahwire me mu,</para>
  <para style="q2" vid="PSA 38:2">na wo nsa adwerɛ me.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Wʼabofuhyeɛ no enti, ahoɔden biara nni me mu;</para>
  <para style="q2" vid="PSA 38:3">me bɔne enti, me nnompe ahodwo.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Mʼafɔdie amene me</para>
  <para style="q2" vid="PSA 38:4">te sɛ adesoa a emu yɛ duru dodo.<verse eid="PSA 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Mʼakuro bɔn na aporɔ</para>
  <para style="q2" vid="PSA 38:5">ɛsiane me bɔne mu agyimisɛm enti.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Makoto na wɔabrɛ me ase;</para>
  <para style="q2" vid="PSA 38:6">da mu nyinaa menantenante twa agyaadwoɔ.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Mʼakyi dompe mu yea boro so:</para>
  <para style="q2" vid="PSA 38:7">ahoɔden biara nni me onipadua mu.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Mabrɛ na mapɛkyɛ koraa.</para>
  <para style="q2" vid="PSA 38:8">Mʼakoma mu yea ma me si apinie.<verse eid="PSA 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>Ao <char style="nd">Awurade</char>, deɛ merehwɛ anim nyinaa da wʼanim;</para>
  <para style="q2" vid="PSA 38:9">mʼapinisie nhintaa wo.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Mʼakoma bɔ paripari, na mʼahoɔden asa</para>
  <para style="q2" vid="PSA 38:10">mpo mʼaniwa aduru sum.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Mʼapirakuro enti me nnamfonom ne mʼayɔnkofoɔ mmɛn me;</para>
  <para style="q2" vid="PSA 38:11">mʼafipamfoɔ twe wɔn ho firi me ho.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Wɔn a wɔpɛ sɛ wɔkum me no sum me mfidie,</para>
  <para style="q2" vid="PSA 38:12">wɔn a wɔpɛ sɛ wɔha me no di me sɛeɛ ho nkɔmmɔ.</para>
  <para style="q2" vid="PSA 38:12">Ɛda mu nyinaa wɔdwene nnaadaasɛm ho.<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Mete sɛ ɔsotifoɔ a ɔnte asɛm,</para>
  <para style="q2" vid="PSA 38:13">mete sɛ mumu a ɔntumi nkasa.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Mayɛ sɛ obi a ɔnte asɛm,</para>
  <para style="q2" vid="PSA 38:14">deɛ nʼano ntumi mma mmuaeɛ.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>Ao <char style="nd">Awurade</char>, meretwɛn wo;</para>
  <para style="q2" vid="PSA 38:15">Ao <char style="nd">Awurade</char> me Onyankopɔn, wobɛgye me so.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Mekaa sɛ, “Mma wɔn ani nnye;</para>
  <para style="q2" vid="PSA 38:16">anaa mma wɔnhoahoa wɔn ho wɔ me nan a awatiri no enti.”<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Mereyɛ mahwe ase,</para>
  <para style="q2" vid="PSA 38:17">na me yea da so wɔ me mu.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Meka me mfomsoɔ kyerɛ;</para>
  <para style="q2" vid="PSA 38:18">me bɔne hyɛ me so.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Bebree na wɔyɛ mʼatamfoɔ;</para>
  <para style="q2" vid="PSA 38:19">wɔn a wɔtane me kwa no dɔɔso.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Wɔn a wɔde bɔne tua me papa so ka no</para>
  <para style="q2" vid="PSA 38:20">bɔ me ahohora ɛberɛ a mereyɛ papa.<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>Ao, <char style="nd">Awurade</char> nnya me.</para>
  <para style="q2" vid="PSA 38:21">Ao me Onyankopɔn, nkɔ akyiri!<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Bra ntɛm bɛboa me,</para>
  <para style="q2" vid="PSA 38:22">
    <char style="nd">Awurade</char>, mʼAgyenkwa.</para>
  <para style="d" vid="PSA 38:22">Wɔde ma ɔdwomkyerɛfoɔ no. Yedutun.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">Dwom 39</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>Mekaa sɛ, “Mɛhwɛ mʼakwan yie</para>
  <para style="q2" vid="PSA 39:1">na mamfa me tɛkrɛma anyɛ bɔne;</para>
  <para style="q1" vid="PSA 39:1">mɛto mʼano nnareka</para>
  <para style="q2" vid="PSA 39:1">ɛberɛ a amumuyɛfoɔ bɛne me yi.<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Nanso brɛ a meyɛɛ komm</para>
  <para style="q2" vid="PSA 39:2">a manka asɛm papa biara mpo no</para>
  <para style="q2" vid="PSA 39:2">mʼapinisie mu yɛɛ den.<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>Mʼakoma ho dwanee no wɔ me mu</para>
  <para style="q2" vid="PSA 39:3">na metee nka sɛ ogya redɛre wɔ me mu</para>
  <para style="q2" vid="PSA 39:3">na afei mede me tɛkrɛma kasaeɛ sɛ:<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>“Ao <char style="nd">Awurade</char>, ma menhunu me nkwa awieeɛ</para>
  <para style="q2" vid="PSA 39:4">ne me nna dodoɔ;</para>
  <para style="q1" vid="PSA 39:4">ma menhunu sɛdeɛ me nkwa twa mu ntɛm so.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Woayɛ me nna sɛ nsateakwaa baako pɛ;</para>
  <para style="q2" vid="PSA 39:5">na me mfeɛ dodoɔ nyɛ hwee wɔ wʼani so.</para>
  <para style="q2" vid="PSA 39:5">Onipa nkwa yɛ ahomeɛ bi kɛkɛ.<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Onipa redi akɔneaba nyinaa no, ɔte sɛ sunsum bi kwa;</para>
  <para style="q2" vid="PSA 39:6">ɔha ne ho, nanso ɔyɛ kwa;</para>
  <para style="q2" vid="PSA 39:6">ɔboa ahonya ano, na ɔnnim deɛ ɛbɛyɛ ne dea.<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“Afei <char style="nd">Awurade</char> ɛdeɛn na merehwehwɛ?</para>
  <para style="q2" vid="PSA 39:7">Mʼanidasoɔ wɔ wo mu.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>Gye me firi me bɔne nyinaa mu;</para>
  <para style="q2" vid="PSA 39:8">mma mennyɛ nkwaseafoɔ aseredeɛ.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Meyɛɛ komm, na mammue mʼano</para>
  <para style="q2" vid="PSA 39:9">ɛfiri sɛ, wo na woayɛ yei.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Yi wʼasotwe firi me so;</para>
  <para style="q2" vid="PSA 39:10">wo nsa ano amanehunu amene me.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Woka nnipa anim, na wotwe wɔn aso wɔ wɔn bɔne ho;</para>
  <para style="q2" vid="PSA 39:11">wosɛe wɔn ahonya te sɛ nweweboa</para>
  <para style="q2" vid="PSA 39:11">onipa biara yɛ ahomeɛ kɛkɛ.<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“Ao <char style="nd">Awurade</char>, tie me mpaeɛbɔ,</para>
  <para style="q2" vid="PSA 39:12">tie me sufrɛ;</para>
  <para style="q2" vid="PSA 39:12">nsi wʼaso wɔ me su ho</para>
  <para style="q1" vid="PSA 39:12">Me ne wo te hɔ sɛ ɔhɔhoɔ,</para>
  <para style="q2" vid="PSA 39:12">sɛdeɛ na mʼagyanom nyinaa teɛ no.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>Yi wʼani firi me so na manya anigyeɛ bio</para>
  <para style="q2" vid="PSA 39:13">ansa na mafiri ha a mente ase bio.”</para>
  <para style="d" vid="PSA 39:13">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">Dwom 40</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>Mede boasetɔ twɛnee <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 40:1">na ɔhwɛɛ me, na ɔtee me sufrɛ.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Ɔyii me firii amena a emu yɛ toro mu,</para>
  <para style="q2" vid="PSA 40:2">firii dɔteɛ ne atɛkyɛ mu;</para>
  <para style="q1" vid="PSA 40:2">ɔde me nan sii ɔbotan so</para>
  <para style="q2" vid="PSA 40:2">na ɔmaa me baabi pa gyinaeɛ.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Ɔde dwom foforɔ hyɛɛ mʼanom,</para>
  <para style="q2" vid="PSA 40:3">ayɛyi dwom a yɛde ma yɛn Onyankopɔn.</para>
  <para style="q1" vid="PSA 40:3">Bebree bɛhunu na wɔasuro</para>
  <para style="q2" vid="PSA 40:3">na wɔde wɔn werɛ ahyɛ <char style="nd">Awurade</char> mu.<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Nhyira ne onipa a</para>
  <para style="q2" vid="PSA 40:4">ɔde <char style="nd">Awurade</char> yɛ nʼahotɔsoɔ,</para>
  <para style="q1" vid="PSA 40:4">deɛ ɔmfa nʼani nto ahomasoɔ so,</para>
  <para style="q2" vid="PSA 40:4">ne wɔn a wɔmane di anyame huhuo akyi.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>Ao <char style="nd">Awurade</char> me Onyankopɔn</para>
  <para style="q2" vid="PSA 40:5">woayɛ anwanwadeɛ bebree.</para>
  <para style="q1" vid="PSA 40:5">Nneɛma a wohyehyɛ maa yɛn no</para>
  <para style="q2" vid="PSA 40:5">obiara ntumi nka ne nyinaa nkyerɛ wo;</para>
  <para style="q1" vid="PSA 40:5">sɛ meka sɛ mereka ne nyinaa ho asɛm a</para>
  <para style="q2" vid="PSA 40:5">ɛbɛdɔɔso dodo.<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>Wompɛ afɔrebɔ ne ayɛyɛdeɛ,</para>
  <para style="q2" vid="PSA 40:6">woabue mʼaso ama mahunu;</para>
  <para style="q2" vid="PSA 40:6">woampɛ ɔhyeɛ afɔdeɛ ne bɔne afɔdeɛ.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>Na mekaa sɛ “Mewɔ ha,</para>
  <para style="q2" vid="PSA 40:7">merebɛyɛ deɛ wopɛ sɛ meyɛ, sɛdeɛ wɔatwerɛ afa me ho wɔ Mmara nwoma no mu no.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Ao me Onyankopɔn, mepɛ sɛ meyɛ wʼapɛdeɛ;</para>
  <para style="q2" vid="PSA 40:8">mede wo mmara ahyɛ mʼakoma mu.”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Meka wo tenenee ho asɛm wɔ dwabɔ kɛseɛ ase;</para>
  <para style="q2" vid="PSA 40:9">meremmua mʼano,</para>
  <para style="q2" vid="PSA 40:9">Ao <char style="nd">Awurade</char>, sɛdeɛ wonim no.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Meremfa wo tenenee ho asɛm nsie mʼakoma mu;</para>
  <para style="q2" vid="PSA 40:10">meka wo nokorɛ ne wo nkwagyeɛ ho asɛm.</para>
  <para style="q1" vid="PSA 40:10">Mankata wʼadɔeɛ ne wo nokorɛ so</para>
  <para style="q2" vid="PSA 40:10">wɔ dwabɔ kɛseɛ no ase.<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>Ao <char style="nd">Awurade</char>, nyi wʼahummɔborɔ mfiri me so;</para>
  <para style="q2" vid="PSA 40:11">ma wʼadɔeɛ ne wo nokorɛ mmɔ me ho ban daa.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>Ɔhaw bebree atwa me ho ahyia;</para>
  <para style="q2" vid="PSA 40:12">mʼamumuyɛ abu afa me so enti menhunu adeɛ bio.</para>
  <para style="q1" vid="PSA 40:12">Ɛdɔɔso sene me tiri so nwi,</para>
  <para style="q2" vid="PSA 40:12">na mʼakoma aboto wɔ me mu.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>Ao <char style="nd">Awurade</char>, ma ɛnsɔ wʼani sɛ wobɛboa me;</para>
  <para style="q2" vid="PSA 40:13">Ao <char style="nd">Awurade</char>, bra ntɛm bɛboa me.<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Wɔn a wɔpɛ sɛ wɔkum me no nyinaa,</para>
  <para style="q2" vid="PSA 40:14">ma wɔn anim ngu ase na wɔnyɛ basaa;</para>
  <para style="q1" vid="PSA 40:14">ma wɔn a wɔpɛ sɛ mesɛeɛ no,</para>
  <para style="q2" vid="PSA 40:14">wɔmfa aniwuo nsane wɔn akyi.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Wɔn a wɔka “Ɔtwea! Ɔtwea!” kyerɛ me no,</para>
  <para style="q2" vid="PSA 40:15">ma wɔn ho nnwiri wɔn wɔ wɔn ankasa animguaseɛ ho.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Nanso ma wɔn a wɔhwehwɛ wo nyinaa</para>
  <para style="q2" vid="PSA 40:16">ani nnye na wɔnni ahurisie wɔ wo mu;</para>
  <para style="q1" vid="PSA 40:16">ma wɔn a wɔdɔ wo nkwagyeɛ no nka daa sɛ,</para>
  <para style="q2" vid="PSA 40:16">“Momma <char style="nd">Awurade</char> so!”<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Nanso meyɛ ohiani ne mmɔborɔni;</para>
  <para style="q2" vid="PSA 40:17">ma <char style="nd">Awurade</char> nnwene me ho.</para>
  <para style="q1" vid="PSA 40:17">Wone me ɔboafoɔ ne me gyefoɔ;</para>
  <para style="q2" vid="PSA 40:17">Ao me Onyankopɔn, bra ntɛm.</para>
  <para style="d" vid="PSA 40:17">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">Dwom 41</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>Nhyira ne onipa a mmɔborɔni asɛm ho hia no.</para>
  <para style="q2" vid="PSA 41:1">
    <char style="nd">Awurade</char> gye no wɔ amanehunu berɛ mu.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>
    <char style="nd">Awurade</char> bɛbɔ ne ho ban na wakora ne kra.</para>
  <para style="q2" vid="PSA 41:2">Ɔbɛhyira no wɔ asase no so;</para>
  <para style="q2" vid="PSA 41:2">ɔrennyaa no mma nʼatamfoɔ apɛdeɛ.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>
    <char style="nd">Awurade</char> bɛhwɛ no wɔ ne yadeɛ mpa so</para>
  <para style="q2" vid="PSA 41:3">na wagye no asi hɔ.<verse eid="PSA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Mekaa sɛ, “Ao <char style="nd">Awurade</char> hunu me mmɔbɔ;</para>
  <para style="q2" vid="PSA 41:4">sa me yadeɛ, ɛfiri sɛ mayɛ bɔne atia wo.”<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Mʼatamfoɔ de adwene bɔne ka wɔ me ho sɛ:</para>
  <para style="q2" vid="PSA 41:5">“Da bɛn na ɔbɛwu ama ne din ayera?”<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Ɛberɛ biara a obi ba me nkyɛn no,</para>
  <para style="q2" vid="PSA 41:6">ɔka atorɔsɛm, na nʼakoma hɔre dinsɛeɛ;</para>
  <para style="q2" vid="PSA 41:6">ɔfiri adi kɔ a, ɔde kɔdi nsekuro.<verse eid="PSA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Mʼatamfoɔ nyinaa keka asomusɛm fa me ho;</para>
  <para style="q2" vid="PSA 41:7">wɔsusu bɔne ma me na wɔka sɛ:<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“Yare bɔne bi abɔ no;</para>
  <para style="q2" vid="PSA 41:8">ɔrensɔre mfiri deɛ ɔda hɔ bio.”<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Mpo me yɔnko pa ara a mede me ho too ne soɔ,</para>
  <para style="q2" vid="PSA 41:9">deɛ me ne no too nsa didiiɛ no,</para>
  <para style="q2" vid="PSA 41:9">asɔre atia me.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>Nanso wo, <char style="nd">Awurade</char>, hunu me mmɔbɔ;</para>
  <para style="q2" vid="PSA 41:10">pagya me, na mentua wɔn so ka.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Menim sɛ wʼani sɔ me,</para>
  <para style="q2" vid="PSA 41:11">na me ɔtamfoɔ renni me so nkonim.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Me nokorɛdie mu, wokura me mu</para>
  <para style="q2" vid="PSA 41:12">na wode me gyina wʼanim afebɔɔ.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>Nhyira nka <char style="nd">Awurade</char>, Israel Onyankopɔn,</para>
  <para style="q2" vid="PSA 41:13">ɛnnɛ ne daa nyinaa.</para>
  <para style="qc" vid="PSA 41:13">Amen ne Amen!</para>
  <para style="d" vid="PSA 41:13">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">1 NWOMA A ƐTƆ SO MMIENU</para>
  <para style="mr">
    <ref loc="PSA 42-72">Nnwom 42–72</ref></para>
  <para style="cl">Dwom 42</para>
  <para style="d">Kora mma “maskil” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>Sɛdeɛ ɔforoteɛ pere hwehwɛ nsuwansuwa no,</para>
  <para style="q2" vid="PSA 42:1">saa ara na me kra pere hwehwɛ wo, Ao Onyankopɔn.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Onyankopɔn ho sukɔm de me kra, Onyankopɔn teasefoɔ no.</para>
  <para style="q2" vid="PSA 42:2">Da bɛn na mɛtumi akɔhyia Onyankopɔn?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Me nisuo ayɛ mʼaduane</para>
  <para style="q2" vid="PSA 42:3">awia ne anadwo,</para>
  <para style="q1" vid="PSA 42:3">na da mu nyinaa nnipa bisa me sɛ:</para>
  <para style="q2" vid="PSA 42:3">“Wo Onyankopɔn wɔ he?”<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Saa nneɛma yi na mekae</para>
  <para style="q2" vid="PSA 42:4">ɛberɛ a mereka mʼakoma mu nsɛm;</para>
  <para style="q1" vid="PSA 42:4">sɛdeɛ na medi asafokuo anim,</para>
  <para style="q2" vid="PSA 42:4">na yɛde anigyeɛ nteateam ne aseda nnwom</para>
  <para style="q1" vid="PSA 42:4">nante yuu bom kɔ Onyankopɔn fie</para>
  <para style="q2" vid="PSA 42:4">wɔ afahyɛ da.<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Adɛn enti na woaboto, Ao me kra?</para>
  <para style="q2" vid="PSA 42:5">Adɛn enti na woteetee wɔ me mu saa?</para>
  <para style="q1" vid="PSA 42:5">Fa wo ho to Onyankopɔn so,</para>
  <para style="q2" vid="PSA 42:5">na mɛkɔ so ayi no ayɛ,</para>
  <para style="q2" vid="PSA 42:5">mʼAgyenkwa ne me Onyankopɔn.<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Me kra aboto wɔ me mu</para>
  <para style="q2" vid="PSA 42:6">enti mɛkae wo</para>
  <para style="q1" vid="PSA 42:6">firi Yordan asase so,</para>
  <para style="q2" vid="PSA 42:6">Hermon mmepɔ so, firi Bepɔ Misar so.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Ebunu kɔ ebunu mu</para>
  <para style="q2" vid="PSA 42:7">wɔ wo nsuo a ɛworo guo no nnyegyeeɛ mu;</para>
  <para style="q1" vid="PSA 42:7">wʼasorɔkye nyinaa</para>
  <para style="q2" vid="PSA 42:7">abu afa me so.<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>Adekyeɛ mu <char style="nd">Awurade</char> kyerɛ nʼadɔeɛ;</para>
  <para style="q2" vid="PSA 42:8">adesaeɛ mu ne dwom ba me nkyɛn.</para>
  <para style="q2" vid="PSA 42:8">Mebɔ mpaeɛ kyerɛ Onyankopɔn a ɔma me nkwa.<verse eid="PSA 42:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Mebisa Onyankopɔn me Botan sɛ,</para>
  <para style="q2" vid="PSA 42:9">“Adɛn enti na wo werɛ afiri me?</para>
  <para style="q1" vid="PSA 42:9">Adɛn enti na ɛsɛ sɛ menantenante twa adwo,</para>
  <para style="q2" vid="PSA 42:9">mʼatamfoɔ nhyɛsoɔ nti?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Me nnompe te yea sɛ ɔdasani.</para>
  <para style="q2" vid="PSA 42:10">Mʼahohiahiafoɔ ateeteeɛ enti,</para>
  <para style="q1" vid="PSA 42:10">daa nyinaa wɔbisa me sɛ,</para>
  <para style="q2" vid="PSA 42:10">“Wo Onyankopɔn wɔ he?”<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Adɛn enti na woaboto, Ao me kra?</para>
  <para style="q2" vid="PSA 42:11">Adɛn enti na woteetee wɔ me mu saa?</para>
  <para style="q1" vid="PSA 42:11">Fa wo ho to Onyankopɔn so,</para>
  <para style="q2" vid="PSA 42:11">na mɛkɔ so ayi no ayɛ,</para>
  <para style="q2" vid="PSA 42:11">mʼAgyenkwa ne me Onyankopɔn.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">Dwom 43</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>Ao Onyankopɔn, bu me bem,</para>
  <para style="q2" vid="PSA 43:1">na ka mʼasɛm a ɛtia ɔman a wɔnnsuro wo no ma me;</para>
  <para style="q2" vid="PSA 43:1">gye me firi nnaadaafoɔ ne amumuyɛfoɔ nsam.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>Woyɛ Onyankopɔn, mʼabandenden.</para>
  <para style="q2" vid="PSA 43:2">Adɛn enti na woapo me?</para>
  <para style="q1" vid="PSA 43:2">Adɛn enti na ɛsɛ sɛ menantenante twa adwo</para>
  <para style="q2" vid="PSA 43:2">mʼatamfoɔ nhyɛsoɔ nti?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Soma wo hann ne wo nokorɛ</para>
  <para style="q2" vid="PSA 43:3">ma wɔn nkyerɛ me ɛkwan;</para>
  <para style="q1" vid="PSA 43:3">ma wɔmmfa me mmra wo Bepɔ Kronkron no so,</para>
  <para style="q2" vid="PSA 43:3">faako a woteɛ hɔ.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Afei, mɛkɔ Onyankopɔn afɔrebukyia anim</para>
  <para style="q2" vid="PSA 43:4">mʼanigyeɛ ne mʼahosɛpɛ Onyankopɔn nkyɛn.</para>
  <para style="q1" vid="PSA 43:4">Mede sankuo bɛyi wo ayɛ,</para>
  <para style="q2" vid="PSA 43:4">Ao Onyankopɔn, me Onyankopɔn.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>Adɛn enti na woaboto, Ao me kra?</para>
  <para style="q2" vid="PSA 43:5">Adɛn enti na woteetee wɔ me mu saa?</para>
  <para style="q1" vid="PSA 43:5">Fa wo ho to Onyankopɔn so,</para>
  <para style="q2" vid="PSA 43:5">na mɛkɔ so ayi no ayɛ,</para>
  <para style="q2" vid="PSA 43:5">mʼAgyenkwa ne me Onyankopɔn.</para>
  <para style="d" vid="PSA 43:5">Dwom a wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">Dwom 44</para>
  <para style="d">Kora mma “maskil” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>Ao Onyankopɔn, yɛde yɛn aso ate;</para>
  <para style="q2" vid="PSA 44:1">yɛn agyanom aka akyerɛ yɛn;</para>
  <para style="q1" vid="PSA 44:1">deɛ woyɛeɛ wɔ wɔn berɛ so,</para>
  <para style="q2" vid="PSA 44:1">wɔ tete mmerɛ no mu.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Wode wo nsa pamoo amanaman no</para>
  <para style="q2" vid="PSA 44:2">na wobɔɔ yɛn agyanom atenaseɛ;</para>
  <para style="q1" vid="PSA 44:2">wodwerɛɛ nnipa no</para>
  <para style="q2" vid="PSA 44:2">na womaa yɛn agyanom dii yie.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Ɛnyɛ wɔn akofena na wɔde nyaa asase no,</para>
  <para style="q2" vid="PSA 44:3">na ɛnyɛ wɔn nsa na ɛmaa wɔn nkonimdie;</para>
  <para style="q1" vid="PSA 44:3">ɛyɛ wo nsa nifa, wo basa,</para>
  <para style="q2" vid="PSA 44:3">ne wʼanim hann, ɛfiri sɛ na wodɔ wɔn.<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Woyɛ me Ɔhene ne me Onyankopɔn,</para>
  <para style="q2" vid="PSA 44:4">deɛ ɔhyɛ nkonimdie ma Yakob.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>Ɛnam wo so na yɛpamoo yɛn Atamfoɔ;</para>
  <para style="q2" vid="PSA 44:5">wo din mu na yɛtiatia wɔn a wɔkyiri yɛn soɔ.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Meremfa me ho nto mʼagyan so</para>
  <para style="q2" vid="PSA 44:6">mʼakofena remfa nkonimdie mmrɛ me;<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>na wo na woma yɛdi yɛn atamfoɔ so.</para>
  <para style="q2" vid="PSA 44:7">Wogu wɔn a wɔtane yɛn anim ase.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Onyankopɔn mu na yɛhoahoa yɛn ho da mu nyinaa</para>
  <para style="q2" vid="PSA 44:8">na yɛbɛkamfo wo din no daa daa.<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Nanso seesei woapo yɛn abrɛ yɛn ase;</para>
  <para style="q2" vid="PSA 44:9">wone yɛn asraafoɔ nnkɔ ɔsa bio.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Woma yɛdwane firii ɛdɔm anim</para>
  <para style="q2" vid="PSA 44:10">ma yɛn atamfoɔ fom yɛn agyapadeɛ.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Woyii yɛn maa sɛ wɔnkum yɛn sɛ nnwan</para>
  <para style="q2" vid="PSA 44:11">na woahwete yɛn wɔ amanaman no mu.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Wotɔn wo nkurɔfoɔ fofoofo,</para>
  <para style="q2" vid="PSA 44:12">na woannya mfasoɔ biara amfiri mu.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Woayɛ yɛn ahohoradeɛ ama yɛn afipamfoɔ,</para>
  <para style="q2" vid="PSA 44:13">animtiabudeɛ ne aseredeɛ ama wɔn a atwa yɛn ho ahyia.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Woayɛ yɛn akasabɛbuo wɔ aman no mu</para>
  <para style="q2" vid="PSA 44:14">na nnipa no woso wɔn ti de gu yɛn so.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Mʼanimguaseɛ di mʼanim daa,</para>
  <para style="q2" vid="PSA 44:15">na aniwuo akata mʼanim<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ɛsiane wɔn a wɔbɔ me ahohora na wɔkasa tia me de yi me ahi,</para>
  <para style="q2" vid="PSA 44:16">ɛsiane ɔtamfoɔ a nʼani abre sɛ ɔbɛtɔ were no enti.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Yeinom nyinaa too yɛn deɛ,</para>
  <para style="q2" vid="PSA 44:17">nanso yɛn werɛ mfirii wo,</para>
  <para style="q2" vid="PSA 44:17">na yɛmmuu wʼapam no nso so.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Yɛn akoma ntwe mfirii wo ho;</para>
  <para style="q2" vid="PSA 44:18">na yɛn nan nso mmane mfirii wo kwan so.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>Nanso wodwerɛɛ yɛn yɛɛ yɛn sakraman tuo</para>
  <para style="q2" vid="PSA 44:19">na wode esum kabii kataa yɛn so.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Sɛ na yɛn werɛ afiri yɛn Onyankopɔn din</para>
  <para style="q2" vid="PSA 44:20">anaa sɛ yɛatrɛ yɛn nsam akyerɛ ananafoɔ nyame a<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>anka Onyankopɔn bɛhunu,</para>
  <para style="q2" vid="PSA 44:21">ɛfiri sɛ ɔnim akoma mu ahintasɛm.<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Nanso, wo enti, wɔkum yɛn daa nyinaa;</para>
  <para style="q2" vid="PSA 44:22">wɔbu yɛn sɛ nnwan a wɔrekɔkum wɔn.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Nyane, Ao <char style="nd">Awurade</char>! Adɛn enti na wada?</para>
  <para style="q2" vid="PSA 44:23">Keka wo ho! Nnya yɛn hɔ afebɔɔ.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Adɛn enti na wode wʼanim ahinta</para>
  <para style="q2" vid="PSA 44:24">na wo werɛ firi yɛn ahohia ne nhyɛsoɔ?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Wɔabrɛ yɛn ase kɔ dɔteɛ mu</para>
  <para style="q2" vid="PSA 44:25">na yɛn onipadua aka afam dɔteɛ.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Sɔre bɛboa yɛn;</para>
  <para style="q2" vid="PSA 44:26">wʼadɔeɛ a ɛnsa da no enti, gye yɛn.</para>
  <para style="d" vid="PSA 44:26">Wɔde “Sukooko” sankuo dwomtobea na ɛtoeɛ. Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">Dwom 45</para>
  <para style="d">Kora mma dwom. Ayeforɔhyia dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>Botaeɛ bi a ɛdi mu akanyane mʼakoma</para>
  <para style="q2" vid="PSA 45:1">ɛberɛ a merebɔ ɔhene mmrane no;</para>
  <para style="q2" vid="PSA 45:1">me tɛkrɛma yɛ ɔtwerɛfoɔ kunini bi twerɛdua.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Wodi mu wɔ mmarima mu</para>
  <para style="q2" vid="PSA 45:2">na wɔde adom bi asra wʼano,</para>
  <para style="q2" vid="PSA 45:2">ɛsiane sɛ Onyankopɔn ahyira wo afebɔɔ no enti.<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Fa wʼakofena bɔ wo nkyɛn mu, Ao Otumfoɔ;</para>
  <para style="q2" vid="PSA 45:3">fa animuonyam ne kɛseyɛ fira.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Fa wo kɛseyɛ mu kɔ wʼanim nkonimdie so</para>
  <para style="q2" vid="PSA 45:4">wɔ nokorɛ, ahobrɛaseɛ ne tenenee mu;</para>
  <para style="q2" vid="PSA 45:4">ma wo nsa nifa nna wo nnwuma a ɛyɛ nwanwa no adi.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Ma wo bɛmma namnam no nhwere ɔhene atamfoɔ akoma mu;</para>
  <para style="q2" vid="PSA 45:5">na ma amanaman nhwe wo nan ase.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Ao Onyankopɔn, wʼahennwa no bɛtena hɔ daa daa;</para>
  <para style="q2" vid="PSA 45:6">tenenee ahempoma bɛyɛ wʼahennie no ahempoma.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Wodɔ tenenee na wokyiri bɔne.</para>
  <para style="q2" vid="PSA 45:7">Ɛno enti Onyankopɔn, wo Onyankopɔn de wo asi wo mfɛfoɔ so,</para>
  <para style="q2" vid="PSA 45:7">na ɔde anigyeɛ ngo asra wo.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Kurobo, pɛperɛ ne bɛwewonua hwa agye wo batakari mu nyinaa;</para>
  <para style="q2" vid="PSA 45:8">sankuo so nnwom a ɛfiri ahemfie a wɔde asonse asiesie ho mu</para>
  <para style="q2" vid="PSA 45:8">ma wʼani gye.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Ahemfo mmammaa ka wo mmaa atitire ho;</para>
  <para style="q2" vid="PSA 45:9">wo nsa nifa so na ayeforɔ dehyeɛ a ɔhyɛ Ofir sikakɔkɔɔ gyina.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>Ao ɔbabaa tie, dwene ho na yɛ ɔsetie;</para>
  <para style="q2" vid="PSA 45:10">ma wo werɛ mfiri wo nkurɔfoɔ ne wo agya fie.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Wʼahoɔfɛ asɔ ɔhene no ani;</para>
  <para style="q2" vid="PSA 45:11">di no nni, ɛfiri sɛ ɔno ne wo wura.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Tiro Babaa de ayɛyɛdeɛ bɛba;</para>
  <para style="q2" vid="PSA 45:12">mmarima adefoɔ bɛdɛfɛdɛfɛ wo.<verse eid="PSA 45:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Ɔhene babaa a ɔwɔ ne piam no yɛ onimuonyamfoɔ</para>
  <para style="q2" vid="PSA 45:13">wɔde sikakɔkɔɔ abobɔ nʼatadeɛ yuu mu.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Ɔhyɛ ntadeɛ a wɔadi mu adwinneɛ na wɔde no kɔma ɔhene;</para>
  <para style="q2" vid="PSA 45:14">ne mfɛfoɔ mmaabunu di nʼakyi</para>
  <para style="q2" vid="PSA 45:14">na wɔde wɔn nyinaa brɛ wo.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Wɔde ahosɛpɛ ne anigyeɛ kɔ mu;</para>
  <para style="q1" vid="PSA 45:15">wɔhyɛne ɔhempɔn no ahemfie.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Wo mmammarima bɛsi wʼagyanom ananmu</para>
  <para style="q2" vid="PSA 45:16">wobɛyɛ wɔn mmapɔmma wɔ asase no so nyinaa.<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Mɛma wɔakae wo wɔ awontoatoasoɔ nyinaa mu;</para>
  <para style="q2" vid="PSA 45:17">ɛno enti amanaman bɛkamfo wo daa nyinaa.</para>
  <para style="d" vid="PSA 45:17">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">Dwom 46</para>
  <para style="d">Kora mma dwom. Wɔto no “alamot” sankuo nne so.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>Onyankopɔn ne yɛn dwanekɔbea ne yɛn ahoɔden,</para>
  <para style="q2" vid="PSA 46:1">amanehunu mu ɔboafoɔ a ɔwɔ hɔ ɛberɛ biara.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Enti sɛ asase ani dane butu</para>
  <para style="q2" vid="PSA 46:2">na mmepɔ tutu kɔgu ɛpo ase a, yɛrensuro,<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>sɛ ɛpo bɔ asorɔkye na ɛhuru</para>
  <para style="q2" vid="PSA 46:3">na ɛma nkokoɔ woso mpo a, yɛrensuro.<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Asutene bi wɔ hɔ a</para>
  <para style="q2" vid="PSA 46:4">ne nsuwansuwa de anigyeɛ ba Onyankopɔn kuropɔn mu,</para>
  <para style="q2" vid="PSA 46:4">beaeɛ kronkron a Ɔsorosoroni no teɛ.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Onyankopɔn te kuropɔn no mu, na ɔrenhwe ase;</para>
  <para style="q2" vid="PSA 46:5">Onyankopɔn bɛboa no anɔpahema.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Amanaman yɛ hoo, na ahennie hwehwe ase;</para>
  <para style="q2" vid="PSA 46:6">ɔma ne nne so ma asase nane.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>Otumfoɔ <char style="nd">Awurade</char> ka yɛn ho.</para>
  <para style="q2" vid="PSA 46:7">Yakob Onyankopɔn yɛ yɛn aban.<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Bra bɛhwɛ <char style="nd">Awurade</char> nnwuma,</para>
  <para style="q2" vid="PSA 46:8">ɔsɛeɛ a ɔde aba asase no so.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Ɔma akodie gyae kɔsi asase ano.</para>
  <para style="q2" vid="PSA 46:9">Ɔbubu agyan mu na ɔsɛe pea;</para>
  <para style="q2" vid="PSA 46:9">ɔde ogya hye nkataboɔ.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>Monyɛ komm na monhunu sɛ me ne Onyankopɔn;</para>
  <para style="q2" vid="PSA 46:10">wɔbɛma me so wɔ amanaman no mu,</para>
  <para style="q2" vid="PSA 46:10">wɔbɛma me so wɔ asase so.<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>Otumfoɔ <char style="nd">Awurade</char> ka yɛn ho;</para>
  <para style="q2" vid="PSA 46:11">Yakob Onyankopɔn yɛ yɛn aban.</para>
  <para style="d" vid="PSA 46:11">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">Dwom 47</para>
  <para style="d">Kora mma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>Amanaman nyinaa, mommɔ mo nsam;</para>
  <para style="q2" vid="PSA 47:1">momfa anigyeɛ nteam mfrɛ Onyankopɔn.<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>
    <char style="nd">Awurade</char> Ɔsorosoroni no ho yɛ nwanwa,</para>
  <para style="q2" vid="PSA 47:2">Ɔyɛ Ɔhene kɛseɛ wɔ asase nyinaa so!<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Ɔde amanaman hyɛɛ yɛn ase,</para>
  <para style="q2" vid="PSA 47:3">na ɔde nnipa hyɛɛ yɛn nan ase.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Ɔyii yɛn agyapadeɛ maa yɛn,</para>
  <para style="q2" vid="PSA 47:4">deɛ ɛyɛ Yakob a ɔdɔ noɔ no ahohoahoadeɛ.<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Onyankopɔn aforo kɔ soro wɔ anigyeɛ nteateam mu.</para>
  <para style="q2" vid="PSA 47:5">
    <char style="nd">Awurade</char> wɔ totorobɛnto nnyegyeeɛ mu.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>To ayɛyie nnwom ma Onyankopɔn, to ayɛyie nnwom;</para>
  <para style="q2" vid="PSA 47:6">to ayɛyie nnwom ma yɛn Ɔhene, to ayɛyie nnwom.<verse eid="PSA 47:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Ɛfiri sɛ Onyankopɔn yɛ asase nyinaa so Ɔhene.</para>
  <para style="q2" vid="PSA 47:7">Monto ahurisie nnwom mma no.<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Onyankopɔn di ɔhene wɔ amanaman no so</para>
  <para style="q2" vid="PSA 47:8">Onyankopɔn te nʼahennwa kronkron so.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Amanaman no mu akunini boaboa wɔn ho ano</para>
  <para style="q2" vid="PSA 47:9">sɛ Abraham Onyankopɔn nkurɔfoɔ,</para>
  <para style="q1" vid="PSA 47:9">ɛfiri sɛ asase so ahemfo yɛ Onyankopɔn dea;</para>
  <para style="q2" vid="PSA 47:9">na wɔma no so yɛ no kɛseɛ.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">Dwom 48</para>
  <para style="d">Kora mma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>
    <char style="nd">Awurade</char> yɛ kɛseɛ na ɔsɛ nkamfo</para>
  <para style="q2" vid="PSA 48:1">wɔ yɛn Onyankopɔn kuropɔn mu, ne bepɔ kronkron so.<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Kuropɔn no ɔsorokɔ yɛ fɛ,</para>
  <para style="q2" vid="PSA 48:2">ɛyɛ ewiase nyinaa anigyedeɛ.</para>
  <para style="q1" vid="PSA 48:2">Bepɔ Sion te sɛ Safon sorɔnsorɔmmea,</para>
  <para style="q2" vid="PSA 48:2">Ɔhene Kɛseɛ no kuropɔn.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Onyankopɔn te nʼabankɛsewa mu.</para>
  <para style="q2" vid="PSA 48:3">Wada ne ho adi sɛ ɔyɛ nʼaban.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Ɛberɛ a ahemfo yi boaa wɔn ho ano,</para>
  <para style="q2" vid="PSA 48:4">na wɔtuu ɔsa bɔɔ mu no,<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>wɔhunuu no ma ɛyɛɛ wɔn ahodwirie,</para>
  <para style="q2" vid="PSA 48:5">na wɔde ehu dwaneeɛ.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Nketenkete kyeree wɔn wɔ hɔ,</para>
  <para style="q2" vid="PSA 48:6">ɔyea a ɛte sɛ ɔbaa a awoɔ aka no.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Wosɛee wɔn sɛ Tarsis ahyɛn a</para>
  <para style="q2" vid="PSA 48:7">apueeɛ mframa abɔ adwira wɔn.<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Sɛdeɛ yɛate no,</para>
  <para style="q2" vid="PSA 48:8">saa ara na yɛahunu</para>
  <para style="q1" vid="PSA 48:8">wɔ Otumfoɔ <char style="nd">Awurade</char> kuropɔn no mu,</para>
  <para style="q2" vid="PSA 48:8">yɛn Onyankopɔn kuropɔn mu;</para>
  <para style="q2" vid="PSA 48:8">Onyankopɔn ma ɛtim hɔ afebɔɔ.<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Wʼasɔredan no mu, Ao Onyankopɔn,</para>
  <para style="q2" vid="PSA 48:9">na yɛdwene wo dɔ a ɛnsa da no ho,<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>Ao Onyankopɔn, wʼayɛyie duru asase ano</para>
  <para style="q2" vid="PSA 48:10">te sɛ wo din;</para>
  <para style="q2" vid="PSA 48:10">tenenee ayɛ wo nsa nifa mu ma.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Sion bepɔ di ahurisie,</para>
  <para style="q2" vid="PSA 48:11">Yuda nkuraase no ani gye</para>
  <para style="q1" vid="PSA 48:11">ɛsiane wʼatemmuo no enti.<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Nante Sion na twa ho hyia,</para>
  <para style="q2" vid="PSA 48:12">kan nʼabantenten dodoɔ,<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>dwene nʼafasuo ho yie,</para>
  <para style="q2" vid="PSA 48:13">hwɛ nʼabankɛsewa no,</para>
  <para style="q2" vid="PSA 48:13">na woaka ho asɛm akyerɛ nkyirimma.<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Saa Onyankopɔn yi yɛ yɛn Onyankopɔn daa daa;</para>
  <para style="q2" vid="PSA 48:14">mpo ɔbɛyɛ yɛn kwankyerɛfoɔ akɔsi awieeɛ.</para>
  <para style="d" vid="PSA 48:14">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">Dwom 49</para>
  <para style="d">Kora mma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>Nnipa nyinaa, montie;</para>
  <para style="q2" vid="PSA 49:1">monyɛ aso, mo a mowɔ ewiase yi mu nyinaa,<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>deɛ ɔyɛ abomfiaa ne deɛ ɔdi mu,</para>
  <para style="q2" vid="PSA 49:2">adefoɔ ne ahiafoɔ nyinaa.<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Mʼano bɛka anyansasɛm;</para>
  <para style="q2" vid="PSA 49:3">nsɛm a ɛfiri mʼakomam bɛma nhunumu.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Mɛbrɛ mʼaso ase atie abɛbusɛm;</para>
  <para style="q2" vid="PSA 49:4">na menam sankubɔ so bɛte aseɛ ama makyerɛ abɛbusɛm no ase.<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Adɛn enti na ɛsɛ sɛ mesuro nna bɔne,</para>
  <para style="q2" vid="PSA 49:5">ɛberɛ a amumuyɛfoɔ adaadaafoɔ atwa me ho ahyia,<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>wɔn a wɔde wɔn ho to wɔn ahonya soɔ</para>
  <para style="q2" vid="PSA 49:6">na wɔde wɔn adedodoɔ hoahoa wɔn ho?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Onipa biara rentumi nnye nʼankasa nkwa</para>
  <para style="q2" vid="PSA 49:7">na ɔrentumi mfa mpata biara mma Onyankopɔn.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>Nkwa ho mpata boɔ yɛ den,</para>
  <para style="q2" vid="PSA 49:8">sika biara rentumi ntɔ,<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>sɛ ɛbɛma no atena ase afebɔɔ</para>
  <para style="q2" vid="PSA 49:9">a ɔrenhunu porɔeɛ.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Obiara nim pefee sɛ anyansafoɔ wu;</para>
  <para style="q2" vid="PSA 49:10">saa ara na nkwaseafoɔ ne agyimifoɔ nso wuo</para>
  <para style="q2" vid="PSA 49:10">na wɔgya wɔn ahonya hɔ ma afoforɔ.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Wɔn adamena bɛyɛ wɔn afie afebɔɔ.</para>
  <para style="q2" vid="PSA 49:11">Ɛhɔ na wɔbɛtena awoɔ ntoatoasoɔ kɔsi ɛberɛ a ɛnni awieeɛ mu,</para>
  <para style="q2" vid="PSA 49:11">wɔn din a wɔde totoo nsase so nyinaa akyi.<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Na onipa ahonya nyinaa akyi no, ɔrentena hɔ daa;</para>
  <para style="q2" vid="PSA 49:12">ɔte sɛ mmoa a wɔwuo no ara.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Yei ne deɛ ɛda hɔ ma wɔn a wɔgye wɔn ho die,</para>
  <para style="q2" vid="PSA 49:13">ne wɔn akyidifoɔ a wɔfoa wɔn nsɛm soɔ.<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Wɔte sɛ nnwan na wɔbɛkɔ damena mu,</para>
  <para style="q2" vid="PSA 49:14">na owuo de wɔn bɛyɛ nʼaduane.</para>
  <para style="q1" vid="PSA 49:14">Teneneefoɔ bɛdi wɔn so anɔpa;</para>
  <para style="q2" vid="PSA 49:14">wɔn onipadua bɛporɔ wɔ damena mu,</para>
  <para style="q2" vid="PSA 49:14">na wɔne wɔn adan akɛseɛ no ntam kwan bɛware.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Nanso, Onyankopɔn de ne tumi bɛgye me afiri damena mu;</para>
  <para style="q2" vid="PSA 49:15">ampa ara, ɔde me bɛkɔ ne nkyɛn.<verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Sɛ onipa nya ne ho a, mma ɛnha wo;</para>
  <para style="q2" vid="PSA 49:16">na sɛ ne fie anigyeɛ yɛ bebree a, mma no nha wo;<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>ɛfiri sɛ, sɛ ɔwu a, ɔremfa hwee nkɔ,</para>
  <para style="q2" vid="PSA 49:17">nʼanimuonyam ne no renkɔ amena mu.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>Mpo ɔte ase no, ɔfaa no sɛ wɔahyira no,</para>
  <para style="q2" vid="PSA 49:18">ɛfiri sɛ wɔkamfo nnipa ɛberɛ a wɔdi yie,<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>nanso ɔbɛkɔ akɔka nʼagyanom ho,</para>
  <para style="q2" vid="PSA 49:19">wɔn a wɔrenhunu nkwa hann ara da no.<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Onipa a ɔwɔ ahonya na ɔnni nhunumu no,</para>
  <para style="q2" vid="PSA 49:20">ɔte sɛ aboa a ɔwuo.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">Dwom 50</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>Tweaduampɔn, Onyankopɔn, <char style="nd">Awurade</char> no kasa,</para>
  <para style="q2" vid="PSA 50:1">na ɔfrɛ asase nyinaa</para>
  <para style="q2" vid="PSA 50:1">ɛfiri apueeɛ kɔsi atɔeɛ.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Onyankopɔn hran firi Sion</para>
  <para style="q2" vid="PSA 50:2">kuro a ne fɛ wie pɛ yɛ.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Yɛn Onyankopɔn reba nanso ɔrenyɛ komm;</para>
  <para style="q2" vid="PSA 50:3">ogya a ɛhye nneɛma di nʼanim,</para>
  <para style="q2" vid="PSA 50:3">ahum a ɛretu atwa ne ho ahyia.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Ɔfrɛ ɔsorosoro ne asase,</para>
  <para style="q2" vid="PSA 50:4">sɛ ɔrebu ne nkurɔfoɔ atɛn;<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>Ɔka sɛ, “Boaboa nnipa a wɔate wɔn ho no ano ma me,</para>
  <para style="q2" vid="PSA 50:5">wɔn a wɔnam afɔrebɔdeɛ so ne me yɛɛ apam no.”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Ɔsoro pae mu ka ne tenenee,</para>
  <para style="q2" vid="PSA 50:6">na Onyankopɔn ankasa ne ɔtemmufoɔ.<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“Montie, me nkurɔfoɔ na mɛkasa,</para>
  <para style="q2" vid="PSA 50:7">mɛdi adanseɛ atia wo, Ao Israel;</para>
  <para style="q2" vid="PSA 50:7">Mene Onyankopɔn, wo Onyankopɔn no.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Merenka mo anim wɔ mo afɔrebɔdeɛ</para>
  <para style="q2" vid="PSA 50:8">anaa mo hyeɛ afɔdeɛ a ɛwɔ mʼanim daa no ho.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Anantwinini a wɔfiri mo mfuo so</para>
  <para style="q2" vid="PSA 50:9">anaa mpapo a wɔfiri mo buo mu ho nhia me,<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>ɛfiri sɛ kwaeɛ mu aboa biara yɛ me dea,</para>
  <para style="q2" vid="PSA 50:10">anantwie a wɔwɔ nkokoɔ mpempem so nso saa ara.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Menim anomaa biara a ɔwɔ mmepɔ no so,</para>
  <para style="q2" vid="PSA 50:11">na wiram abɔdeɛ nyinaa yɛ me dea.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Sɛ ɛkɔm dee me a, anka merenka nkyerɛ mo;</para>
  <para style="q2" vid="PSA 50:12">ɛfiri sɛ, ewiase ne deɛ ɛwɔ mu nyinaa yɛ me dea.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Mewe anantwinini nam,</para>
  <para style="q2" vid="PSA 50:13">na menom mpapo mogya anaa?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>Momfa aseda afɔdeɛ mma Onyankopɔn,</para>
  <para style="q2" vid="PSA 50:14">na monni bɔhyɛ a mohyɛɛ Ɔsorosoroni no so,<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>na momfrɛ me da hiada;</para>
  <para style="q2" vid="PSA 50:15">na mɛgye mo na moahyɛ me animuonyam.”<verse eid="PSA 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>Nanso, amumuyɛfoɔ deɛ, Onyankopɔn bisa wɔn sɛ,</para>
  <para style="q1" vid="PSA 50:16">“Adɛn enti na moka me mmara ho asɛm</para>
  <para style="q2" vid="PSA 50:16">na mʼapam da mo ano?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Mokyiri me nkyerɛkyerɛ</para>
  <para style="q2" vid="PSA 50:17">na moto me nsɛm gu mo akyi.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Sɛ mohunu ɔkorɔmfoɔ a, mode mo ho bɔ no;</para>
  <para style="q2" vid="PSA 50:18">na mo ne awaresɛefoɔ nso bɔ.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Mode mo ano yɛ bɔne</para>
  <para style="q2" vid="PSA 50:19">na mode mo tɛkrɛma boaboa nnaadaa ano.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Mokasa tia mo nuabarima ɛberɛ biara</para>
  <para style="q2" vid="PSA 50:20">na mosopa mo ankasa maame ba.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Moayɛ yeinom nyinaa; nanso manka hwee,</para>
  <para style="q2" vid="PSA 50:21">enti mosusu sɛ mete sɛ mo.</para>
  <para style="q1" vid="PSA 50:21">Nanso mɛka mo anim</para>
  <para style="q2" vid="PSA 50:21">na mede mo soboɔ asi mo anim.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“Monnwene yei ho, mo a mo werɛ firi Onyankopɔn,</para>
  <para style="q2" vid="PSA 50:22">anyɛ saa a, mɛtete mo mu nketenkete a obiara mmɛgye mo;<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Deɛ ɔbɔ aseda afɔdeɛ no hyɛ me animuonyam,</para>
  <para style="q2" vid="PSA 50:23">na ɔsiesie ɛkwan</para>
  <para style="q2" vid="PSA 50:23">sɛdeɛ mɛda Onyankopɔn nkwagyeɛ adi akyerɛ no.”</para>
  <para style="d" vid="PSA 50:23">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">Dwom 51</para>
  <para style="d">Dawid dwom a ɔtoo no ɛberɛ a ɔde ne ho kaa Batseba na odiyifoɔ Natan kɔɔ ne nkyɛn no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>Ao Onyankopɔn hunu me mmɔbɔ,</para>
  <para style="q2" vid="PSA 51:1">sɛdeɛ wʼadɔeɛ a ɛnsa da no teɛ;</para>
  <para style="q1" vid="PSA 51:1">wʼahummɔborɔ kɛseɛ no enti,</para>
  <para style="q2" vid="PSA 51:1">pepa me mmarato.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Hohoro mʼamumuyɛ nyinaa</para>
  <para style="q2" vid="PSA 51:2">na te me ho firi me bɔne mu!<verse eid="PSA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Na mahunu me mmarato,</para>
  <para style="q2" vid="PSA 51:3">na mekae me bɔne daa.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Mayɛ mfomsoɔ atia wo; atia wo nko ara</para>
  <para style="q2" vid="PSA 51:4">na mayɛ deɛ ɛyɛ bɔne wɔ wʼani so,</para>
  <para style="q1" vid="PSA 51:4">enti, wodi bem wɔ wo kasa mu</para>
  <para style="q2" vid="PSA 51:4">na wotene wɔ wʼatemmuo mu.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Ampa ara wɔwoo me wɔ bɔne mu,</para>
  <para style="q2" vid="PSA 51:5">na bɔne mu na me maame nyinsɛnee me.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Ampa ara nokorɛ na wohwehwɛ wɔ me mu.</para>
  <para style="q2" vid="PSA 51:6">Wokyerɛ me nyansa a emu dɔ.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Fa hisope hohoro me ho, na me ho bɛte;</para>
  <para style="q2" vid="PSA 51:7">dware me, na mɛhoa asene sukyerɛmma.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Ma mente ahosɛpɛ ne anigyeɛ nka;</para>
  <para style="q2" vid="PSA 51:8">na ma nnompe a woabubuo no nni ahurisie.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Kata wʼani wɔ me bɔne ho</para>
  <para style="q2" vid="PSA 51:9">na pepa mʼamumuyɛ nyinaa.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Ao Onyankopɔn, bɔ akoma a emu teɛ wɔ me mu,</para>
  <para style="q2" vid="PSA 51:10">na ma me honhom foforɔ a ɛdi wo nokorɛ.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Mpamo me mfiri wʼanim</para>
  <para style="q2" vid="PSA 51:11">na ɛnyi wo Honhom Kronkron mfiri me mu.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Fa wo nkwagyeɛ mu anigyeɛ no ma me bio</para>
  <para style="q2" vid="PSA 51:12">na ma me ɔsetie honhom a ɛbɛkura me.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Afei mɛkyerɛ nnebɔneyɛfoɔ wʼakwan,</para>
  <para style="q2" vid="PSA 51:13">na amumuyɛfoɔ bɛsane aba wo nkyɛn.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Ao Onyankopɔn, gye me firi mogya ho afɔdie mu.</para>
  <para style="q2" vid="PSA 51:14">Onyame a wogye me nkwa,</para>
  <para style="q2" vid="PSA 51:14">na me tɛkrɛma bɛto wo tenenee ho dwom.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>Ao Awurade, bue mʼano fafa,</para>
  <para style="q2" vid="PSA 51:15">na mede mʼano bɛpae mu aka wʼayɛyie.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Wompɛ afɔrebɔ, anka mɛbɔ;</para>
  <para style="q2" vid="PSA 51:16">wʼani nnye ɔhyeɛ afɔdeɛ ho.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Onyankopɔn afɔdeɛ a ɔpɛ yɛ honhom a abotoɔ.</para>
  <para style="q2" vid="PSA 51:17">Ao Onyankopɔn,</para>
  <para style="q2" vid="PSA 51:17">worempo ahonu ne ahobrɛaseɛ akoma.<verse eid="PSA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Ao Onyankopɔn, ma Sion nya nkɔsoɔ wɔ wʼanigyeɛ mu;</para>
  <para style="q2" vid="PSA 51:18">na to Yerusalem afasuo.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Afei afɔrebɔ a ɛho teɛ bɛba,</para>
  <para style="q2" vid="PSA 51:19">ɔhyeɛ afɔdeɛ a ɛdi mu a ɛbɛsɔ wʼani;</para>
  <para style="q2" vid="PSA 51:19">na wɔde anantwinini bɛbɔ afɔdeɛ wʼafɔrebukyia so.</para>
  <para style="d" vid="PSA 51:19">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">Dwom 52</para>
  <para style="d">Dawid “maskil” dwom. Ɔtoeɛ ɛberɛ a Edomni Doeg bɛka kyerɛɛ Saulo sɛ, “Dawid akɔ Ahimelek fie” no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>Ɔkɛseɛ, adɛn enti na wohoahoa wo ho wɔ wo bɔne ho?</para>
  <para style="q2" vid="PSA 52:1">Adɛn enti na wohoahoa wo ho da mu nyinaa,</para>
  <para style="q2" vid="PSA 52:1">wo a woyɛ animguasedeɛ wɔ Onyankopɔn ani so?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Wo tɛkrɛma bɔ ɔsɛeɛ ho pɔ;</para>
  <para style="q2" vid="PSA 52:2">ɛte sɛ yiwan a ano yɛ tahwetahwe.</para>
  <para style="q1" vid="PSA 52:2">Wo a wotwa nkontompo nko ara.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Wʼani gye bɔne ho sene papa,</para>
  <para style="q2" vid="PSA 52:3">wopɛ atorɔ sene sɛ wobɛka nokorɛ.<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Wodɔ asɛm biara a ɛde ɔhaw ba,</para>
  <para style="q2" vid="PSA 52:4">Ao wo tɛkrɛma daadaafoɔ!<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Ampa ara, Onyankopɔn de ɔsɛeɛ a ɛnni awieeɛ bɛbrɛ wo;</para>
  <para style="q2" vid="PSA 52:5">ɔbɛtwe wo afiri wo ntomadan mu na watete wo mu;</para>
  <para style="q2" vid="PSA 52:5">Ɔbɛtɔre wʼase wɔ ateasefoɔ asase so.<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Ateneneefoɔ bɛhunu yei na wɔasuro;</para>
  <para style="q2" vid="PSA 52:6">wɔbɛsere no na wɔaka sɛ,<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Hwɛ, onipa no nie</para>
  <para style="q2" vid="PSA 52:7">deɛ wamfa Onyankopɔn anyɛ nʼabandenden</para>
  <para style="q1" vid="PSA 52:7">na mmom ɔde ne ho too nʼahonya dodoɔ so</para>
  <para style="q2" vid="PSA 52:7">na ɔnyaa ahoɔden de sɛee afoforɔ no!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Nanso, mete sɛ ngo dua a</para>
  <para style="q2" vid="PSA 52:8">ɛrenyini wɔ Onyankopɔn fie:</para>
  <para style="q1" vid="PSA 52:8">mede me ho to Onyankopɔn dɔ a ɛnsa da no so</para>
  <para style="q2" vid="PSA 52:8">daa nyinaa.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Mɛyi wo ayɛ daa wɔ deɛ woayɛ nti;</para>
  <para style="q2" vid="PSA 52:9">wo din so na mʼani bɛda, ɛfiri sɛ ɛyɛ.</para>
  <para style="q2" vid="PSA 52:9">Mɛyi wo ayɛ wɔ wʼahotefoɔ anim.</para>
  <para style="d" vid="PSA 52:9">Wɔde ma dwomkyerɛfoɔ. Wɔde “mahalat” sankuo nne na ɛto.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">Dwom 53</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>Ɔkwasea ka nʼakoma mu sɛ,</para>
  <para style="q2" vid="PSA 53:1">“Onyankopɔn bi nni hɔ.”</para>
  <para style="q1" vid="PSA 53:1">Wɔaporɔ, na wɔn akwan yɛ animguaseɛ.</para>
  <para style="q2" vid="PSA 53:1">Baako koraa nni hɔ a ɔyɛ ade pa.<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Onyankopɔn firi soro hwɛ adasamma wɔ fam</para>
  <para style="q2" vid="PSA 53:2">sɛ ɔbɛhunu wɔn mu bi a</para>
  <para style="q1" vid="PSA 53:2">wɔwɔ nteaseɛ,</para>
  <para style="q2" vid="PSA 53:2">anaa ebinom a wɔhwehwɛ Onyankopɔn.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Obiara amane;</para>
  <para style="q2" vid="PSA 53:3">wɔn nyinaa ayɛ bɔne;</para>
  <para style="q1" vid="PSA 53:3">wɔn mu bi nni hɔ a ɔyɛ papa;</para>
  <para style="q2" vid="PSA 53:3">ɔbaako mpo nni hɔ.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Enti abɔnefoɔ rensua nyansa anaa?</para>
  <para style="q2" vid="PSA 53:4">Wɔwe me nkurɔfoɔ sɛdeɛ nnipa di aduane.</para>
  <para style="q2" vid="PSA 53:4">Wɔnnsu mfrɛ Onyankopɔn.<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>Wɔn na wɔwɔ hɔ a wɔabɔ huboa!</para>
  <para style="q2" vid="PSA 53:5">Wɔn ho popo wɔ beaeɛ a ehu nni hɔ.</para>
  <para style="q1" vid="PSA 53:5">Onyankopɔn bɛhwete wʼatamfoɔ no nnompe agu;</para>
  <para style="q2" vid="PSA 53:5">wobɛgu wɔn anim ase, ɛfiri sɛ Onyankopɔn abu wɔn animtiaa.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>Ao, ma Israel nkwagyeɛ mfiri Sion mmra!</para>
  <para style="q2" vid="PSA 53:6">Onyankopɔn bɛsane de ne nkurɔfoɔ agyapadeɛ ama wɔn.</para>
  <para style="q2" vid="PSA 53:6">Na Yakob adi ahurisie, na Israel ani agye!</para>
  <para style="d" vid="PSA 53:6">Wɔde ma dwomkyerɛfoɔ. Wɔbɔ no sankuo so.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">Dwom 54</para>
  <para style="d">Dawid “maskil” dwom. Ɔtoo no ɛberɛ a Sififoɔ kɔka kyerɛɛ Saulo sɛ, “Dawid abɛhinta wɔ yɛn mu.”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>Ao Onyankopɔn, gye me wɔ wo din mu;</para>
  <para style="q2" vid="PSA 54:1">fa wo tumi di mʼasɛm ma me.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>Ao Onyankopɔn, tie me mpaeɛbɔ;</para>
  <para style="q2" vid="PSA 54:2">tie mʼanom nsɛm.<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Ahɔhoɔ reto ahyɛ me so.</para>
  <para style="q2" vid="PSA 54:3">Atirimuɔdenfoɔ repɛ me akum me;</para>
  <para style="q2" vid="PSA 54:3">nnipa a wɔmmfa Onyankopɔn nyɛ hwee.<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Ampa ara, Onyankopɔn ne me ɔboafoɔ;</para>
  <para style="q2" vid="PSA 54:4">Awurade ne me hwɛfoɔ.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Ma mmusuo nkyim mmra wɔn a wɔdi me ho nsekuro so;</para>
  <para style="q2" vid="PSA 54:5">wo nokorɛdie mu, sɛe wɔn.<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Mɛfiri me pɛ mu abɔ afɔdeɛ ama wo;</para>
  <para style="q2" vid="PSA 54:6">Ao <char style="nd">Awurade</char>, mɛyi wo din ayɛ,</para>
  <para style="q2" vid="PSA 54:6">ɛfiri sɛ ɛyɛ.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Woagye me afiri me haw nyinaa mu,</para>
  <para style="q2" vid="PSA 54:7">na mʼani ahunu nkonimdie wɔ mʼatamfoɔ so.</para>
  <para style="d" vid="PSA 54:7">Wɔde ma dwomkyerɛfoɔ. Wɔde sankuo na ɛtoeɛ.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">Dwom 55</para>
  <para style="d">Dawid “maskil” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>Ao Onyankopɔn, tie me mpaeɛbɔ,</para>
  <para style="q2" vid="PSA 55:1">mmu wʼani ngu me nkotosrɛ so,<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>tie me na gye me so.</para>
  <para style="q2" vid="PSA 55:2">Me dadwene ha me na ama mayɛ basaa,<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>wɔ deɛ mʼatamfoɔ reka</para>
  <para style="q2" vid="PSA 55:3">ne sɛdeɛ amumuyɛfoɔ hwɛ me haa nti;</para>
  <para style="q1" vid="PSA 55:3">wɔde amanehunu brɛ me;</para>
  <para style="q2" vid="PSA 55:3">na wɔde abufuo sopa me.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>Mʼakoma wɔ ahoyera mu;</para>
  <para style="q2" vid="PSA 55:4">na owuo huboa aba me so.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Ehu ne ahopopoɔ akyekyere me.</para>
  <para style="q2" vid="PSA 55:5">Ahodwirie abu afa me so.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Mekaa sɛ, “Ao, sɛ mewɔ ntaban sɛ aburuburo a,</para>
  <para style="q2" vid="PSA 55:6">anka mɛtu akɔ ama me ho atɔ me,<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>anka mɛtu akɔ akyirikyiri</para>
  <para style="q2" vid="PSA 55:7">akɔtena ɛserɛ so;<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>anka mɛyɛ ntɛm akɔ mʼahintaeɛ,</para>
  <para style="q2" vid="PSA 55:8">baabi a mframaden ne ahum mmɛn koraa.”<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Ao Awurade, ma amumuyɛfoɔ nyɛ basaa, na ma wɔn kasa ntoto,</para>
  <para style="q2" vid="PSA 55:9">ɛfiri sɛ mɛhunu basabasayɛ ne apereapereɛ wɔ kuropɔn no mu.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Awia ne anadwo wɔtetɛ nʼafasuo ho;</para>
  <para style="q2" vid="PSA 55:10">adwemmɔne ne nsisie wɔ mu.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Adesɛefoɔ dɔm reyɛ adwuma kuropɔn no mu.</para>
  <para style="q2" vid="PSA 55:11">Ahunahuna ne nnaadaa wɔ ne mmɔntene so daa.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Sɛ ɛyɛɛ ɔtamfoɔ na ɔresopa me a,</para>
  <para style="q2" vid="PSA 55:12">anka mɛtumi agyina ano;</para>
  <para style="q2" vid="PSA 55:12">sɛ ɛyɛɛ ɔtamfoɔ na ɔrema ne ho so atia me a,</para>
  <para style="q2" vid="PSA 55:12">anka mɛtumi de me ho ahinta no.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>Nanso, ɛyɛ wo, ɔdasani te sɛ me,</para>
  <para style="q1" vid="PSA 55:13">me yɔnko pa ne me mʼadamfo brɛboɔ,<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>a kane no na me ne no wɔ ayɔnkofa a emu yɛ den</para>
  <para style="q2" vid="PSA 55:14">ɛberɛ a yɛn nyinaa abɔ mu yuu rekɔ Onyankopɔn fie no.<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Ma owuo mmɛfa mʼatamfoɔ mpofirim;</para>
  <para style="q2" vid="PSA 55:15">ma wɔnkɔ damena mu anikann,</para>
  <para style="q2" vid="PSA 55:15">ɛfiri sɛ bɔne te wɔn mu.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Nanso, mesu frɛ Onyankopɔn,</para>
  <para style="q2" vid="PSA 55:16">na <char style="nd">Awurade</char> gye me nkwa.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Anwummerɛ, anɔpa ne awia,</para>
  <para style="q2" vid="PSA 55:17">mede mmɔborɔnne su frɛ no,</para>
  <para style="q2" vid="PSA 55:17">na ɔte me nne.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Ɔde ne ho bɔ afɔdeɛ ma me nya me tiri didim</para>
  <para style="q2" vid="PSA 55:18">wɔ ɔko a wɔko tiaa me no mu,</para>
  <para style="q2" vid="PSA 55:18">mpo bebree na wɔko tia me.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Onyankopɔn a wɔasi no ɔhene afebɔɔ no,</para>
  <para style="q2" vid="PSA 55:19">ɔbɛte wɔn nka na waha wɔn,</para>
  <para style="q1" vid="PSA 55:19">ɔbɛha nnipa a wɔnsesa wɔn akwan da</para>
  <para style="q2" vid="PSA 55:19">na wɔnsuro Onyankopɔn nso.<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Me yɔnko to hyɛ ne nnamfonom so;</para>
  <para style="q2" vid="PSA 55:20">na ɔbu nʼapam so.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Ɔwɔ tɛkrɛmawoɔ,</para>
  <para style="q2" vid="PSA 55:21">nanso ɔtan wɔ nʼakomam.</para>
  <para style="q1" vid="PSA 55:21">Nʼano asɛm dwodwo sene ngo,</para>
  <para style="q2" vid="PSA 55:21">nanso ɛyɛ akofena a wɔatwe.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Fa wo haw to <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 55:22">na ɔno na ɔbɛgye wo;</para>
  <para style="q2" vid="PSA 55:22">ɔremma ɔteneneeni nhwe ase.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>Nanso, wo, Ao Onyankopɔn, wobɛbrɛ amumuyɛfoɔ ase</para>
  <para style="q2" vid="PSA 55:23">ama wɔakɔ porɔeɛ amena mu;</para>
  <para style="q1" vid="PSA 55:23">mogyapɛfoɔ ne adaadaafoɔ</para>
  <para style="q2" vid="PSA 55:23">renni wɔn nkwanna mu fa.</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">Me deɛ, mede me ho to wo so.</para>
  <para style="d" vid="PSA 55:23">Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛdeɛ wɔto “Aburuburo a ɔsi Akyirikyiri Odum so.”<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">Dwom 56</para>
  <para style="d">Dawid dwom a ɔtoeɛ ɛberɛ a Filistifoɔ kyeree no wɔ Gat no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>Ao Onyankopɔn, hunu me mmɔbɔ na nnipa taa me anibereɛ so;</para>
  <para style="q2" vid="PSA 56:1">da mu nyinaa, wɔmia mmirika a wɔtu wɔtaa me no mu.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Wɔn a wɔbɔ me ahohora taa me da mu nyinaa;</para>
  <para style="q2" vid="PSA 56:2">wɔn a wɔma wɔn ho so tia me dɔɔso.<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Sɛ mebɔ hu a,</para>
  <para style="q2" vid="PSA 56:3">mede me ho bɛto wo so.<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>Onyankopɔn a mekamfo nʼasɛm no,</para>
  <para style="q2" vid="PSA 56:4">mede me ho to Onyankopɔn so, na merensuro.</para>
  <para style="q2" vid="PSA 56:4">Ɛdeɛn na onipa dasani bɛtumi ayɛ me?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Ɛda mu nyinaa wɔgye mʼano si bɔne;</para>
  <para style="q2" vid="PSA 56:5">ɛberɛ biara wɔbɔ pɔ sɛ wɔbɛteetee me.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Wɔbɔ pɔ, na wɔtetɛ,</para>
  <para style="q2" vid="PSA 56:6">wɔhwɛ mʼanammɔntuo,</para>
  <para style="q2" vid="PSA 56:6">na wɔpere sɛ wɔbɛkum me.<verse eid="PSA 56:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Ɛkwan biara so, mma wɔmfa wɔn ho nni;</para>
  <para style="q2" vid="PSA 56:7">Ao Onyankopɔn, brɛ amanaman no ase wɔ wʼabufuo mu.<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Twerɛ me kwadwom to hɔ;</para>
  <para style="q2" vid="PSA 56:8">sese me nisuo wɔ wo nwoma mmobɔeɛ no mu.</para>
  <para style="q2" vid="PSA 56:8">Ɛnni deɛ woatwerɛ ato hɔ no mu anaa?<verse eid="PSA 56:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Sɛ mepɛ mmoa firi wo hɔ a,</para>
  <para style="q2" vid="PSA 56:9">mʼatamfoɔ bɛsane wɔn akyi.</para>
  <para style="q2" vid="PSA 56:9">Yei bɛma mahunu sɛ Onyankopɔn wɔ mʼafa.<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Onyankopɔn a mekamfo nʼasɛm no,</para>
  <para style="q2" vid="PSA 56:10">
    <char style="nd">Awurade</char> a mekamfo nʼasɛm no,<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>mede me ho to Onyankopɔn so; na merensuro.</para>
  <para style="q2" vid="PSA 56:11">Ɛdeɛn na ɔdasani bɛtumi ayɛ me?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>Ao Onyankopɔn, mehyɛ ɛbɔ a mahyɛ wo no ase,</para>
  <para style="q2" vid="PSA 56:12">mede mʼaseda afɔdeɛ bɛbrɛ wo.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>Ɛfiri sɛ, woagye me afiri owuo mu,</para>
  <para style="q2" vid="PSA 56:13">woamma me nan ansunti,</para>
  <para style="q1" vid="PSA 56:13">sɛdeɛ mɛtumi anante Onyankopɔn anim</para>
  <para style="q2" vid="PSA 56:13">wɔ nkwa hann mu.</para>
  <para style="d" vid="PSA 56:13">Wɔde ma dwomkyerɛfoɔ no. Wɔto no sɛdeɛ wɔto “Mma Wɔnsɛe No.”<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">Dwom 57</para>
  <para style="d">Dawid dwom a ɔtooɛ ɛberɛ a ɔdwane firii Saulo nkyɛn kɔɔ ɔbodan no mu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>Hu me mmɔbɔ, Ao Onyankopɔn, hunu me mmɔbɔ,</para>
  <para style="q2" vid="PSA 57:1">na wo mu na me kra nya dwanekɔbea.</para>
  <para style="q1" vid="PSA 57:1">Wo ntaban nwunu ase na mɛpɛ dwanekɔbea</para>
  <para style="q2" vid="PSA 57:1">kɔsi sɛ amanehunu no bɛtwam.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Mesu frɛ Onyankopɔn, Ɔsorosoroni no;</para>
  <para style="q2" vid="PSA 57:2">Onyankopɔn a ɔma ne pɛ ba mu wɔ me ho.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Ɔsoma firi soro hɔ bɛgye me nkwa,</para>
  <para style="q2" vid="PSA 57:3">ɔka wɔn a wɔtaa me anibereɛ so no anim;</para>
  <para style="q2" vid="PSA 57:3">Onyankopɔn soma ne dɔ ne ne nokorɛ.<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Agyata atwa me ho ahyia;</para>
  <para style="q2" vid="PSA 57:4">meda mmoa a wɔwe ɛnam mono mu,</para>
  <para style="q2" vid="PSA 57:4">nnipa a wɔn se te sɛ mpea ne mmɛmma</para>
  <para style="q2" vid="PSA 57:4">na wɔn tɛkrɛma te sɛ akofena a ɛyɛ nnam.<verse eid="PSA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Ao Onyankopɔn, woyɛ kɛseɛ wɔ ɔsorosoro hɔ;</para>
  <para style="q2" vid="PSA 57:5">ma wʼanimuonyam nkata asase nyinaa so.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Wɔtrɛɛ asau mu de sum me nan afidie,</para>
  <para style="q2" vid="PSA 57:6">ahohiahia brɛɛ me ase.</para>
  <para style="q1" vid="PSA 57:6">Wɔtuu amena wɔ me kwan mu,</para>
  <para style="q2" vid="PSA 57:6">nanso wɔn ankasa akɔtotɔ mu.<verse eid="PSA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Ao Onyankopɔn, mʼakoma agyina pintinn,</para>
  <para style="q2" vid="PSA 57:7">mʼakoma nhinhim;</para>
  <para style="q2" vid="PSA 57:7">mɛto dwom na mayi wo ayɛ.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Me kra nyane!</para>
  <para style="q2" vid="PSA 57:8">Sankuo ne bɛnta, monnyane!</para>
  <para style="q2" vid="PSA 57:8">Me nso mɛnyane anɔpahema.<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>Ao <char style="nd">Awurade</char>, mɛyi wo ayɛ wɔ amanaman no mu;</para>
  <para style="q2" vid="PSA 57:9">mɛto wo ho dwom wɔ nnipa mu.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Wo dɔ yɛ kɛseɛ na ɛduru ɔsorosoro;</para>
  <para style="q2" vid="PSA 57:10">wo nokorɛ kɔka ewiem.<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Ao Onyankopɔn, woyɛ kɛseɛ wɔ ɔsorosoro hɔ;</para>
  <para style="q2" vid="PSA 57:11">ma wʼanimuonyam nkata asase nyinaa so.</para>
  <para style="d" vid="PSA 57:11">Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛdeɛ wɔto “Mma Wɔnsɛe No” sankuo nne so.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">Dwom 58</para>
  <para style="d">Dawid “miktam” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>Mo sodifoɔ, ampa ara, moka asɛm a ɛtene anaa?</para>
  <para style="q2" vid="PSA 58:1">Mobu atɛntenenee wɔ nnipa mu anaa?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Dabi! Modwene ntɛnkyea wɔ mʼakomam</para>
  <para style="q2" vid="PSA 58:2">na mo nsa de akakabensɛm ba asase so.<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Amumuyɛfoɔ fom kwan firi awoɔ mu;</para>
  <para style="q2" vid="PSA 58:3">wɔyɛ mmaratofoɔ firi awotwaa mu na wɔdi atorɔ.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Wɔn ano ɛborɔ te sɛ ɔwɔ deɛ.</para>
  <para style="q2" vid="PSA 58:4">Ɛte sɛ ɔprammire a watɛn nʼaso,<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>a ɔnte ntafowayifoɔ dwom,</para>
  <para style="q2" vid="PSA 58:5">na ne dwom dɛɛdɛ no mpo mfa ne ho.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>Ao Onyankopɔn, bubu ɛse a ɛgu wɔn anom,</para>
  <para style="q2" vid="PSA 58:6">Ao <char style="nd">Awurade</char>, tutu agyata no sebɔmmɔfoɔ no gu!<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Ma wɔntwa mu nkɔ sɛ nsunsuan;</para>
  <para style="q2" vid="PSA 58:7">sɛ wɔtwe wɔn agyan a, ma wɔn bɛmma no ano nwu.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Ma wɔnyɛ sɛ nwa pɛkyɛpɛkyɛ bi a ɔretene kɔ.</para>
  <para style="q2" vid="PSA 58:8">Ma wɔnyɛ sɛ ɔba a ɔwu wɔ awoeɛ na ɔnhunu owia.<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Ansa na mo nkukuo bɛte nkasɛɛ ano yea,</para>
  <para style="q2" vid="PSA 58:9">sɛ ɛyɛ mono anaa deɛ awo no, wɔbɛpra amumuyɛfoɔ akɔ.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Sɛ wɔtua amumuyɛfoɔ ka a, ateneneefoɔ ani bɛgye,</para>
  <para style="q2" vid="PSA 58:10">na wɔbɛhohoro wɔn nan ho wɔ amumuyɛfoɔ mogya mu.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>Afei nnipa bɛka sɛ, “Ampa ara, ateneneefoɔ kɔ so nya wɔn akatua;</para>
  <para style="q2" vid="PSA 58:11">na ampa ara Onyankopɔn bi wɔ hɔ a ɔbu ewiase atɛn.”</para>
  <para style="d" vid="PSA 58:11">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">Dwom 59</para>
  <para style="d">Wɔto no sɛdeɛ wɔto “Mma Ɛnsɛe No” sankuo nne so. Dawid “miktam” dwom. Ɔtoo no ɛberɛ a Saulo soma kɔwɛn Dawid fie sɛ wɔbɛkum no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>Ao Onyankopɔn, gye me firi mʼatamfoɔ nsam;</para>
  <para style="q2" vid="PSA 59:1">bɔ me ho ban firi wɔn a wɔtaa me so no ho.<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Gye me firi amumuyɛfoɔ nsam.</para>
  <para style="q2" vid="PSA 59:2">Gye me nkwa firi mogyapɛfoɔ nsam.<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Hwɛ sɛdeɛ wɔatɛ repɛ me akum me</para>
  <para style="q2" vid="PSA 59:3">akokobirefoɔ bɔ pɔ bɔne tia me</para>
  <para style="q2" vid="PSA 59:3">a ɛnyɛ mfomsoɔ anaa bɔne bi a mayɛ enti, Ao <char style="nd">Awurade</char>.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Menyɛɛ mfomsoɔ bi, nanso wɔayɛ krado sɛ wɔbɛto ahyɛ me so.</para>
  <para style="q2" vid="PSA 59:4">Sɔre bɛgye me; hwɛ mʼamanehunu!<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>Ao Asafo <char style="nd">Awurade</char> Onyankopɔn, Israel Onyankopɔn,</para>
  <para style="q2" vid="PSA 59:5">ma wo ho so na twe amanaman no nyinaa aso;</para>
  <para style="q2" vid="PSA 59:5">nhunu amumuyɛfoɔ nkontompofoɔ no mmɔbɔ.<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Wɔsane ba anwummerɛ,</para>
  <para style="q2" vid="PSA 59:6">wɔpɔ so sɛ nkraman,</para>
  <para style="q2" vid="PSA 59:6">na wɔkyinkyin kuropɔn no mu.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Hwɛ deɛ wɔfe firi wɔn anomu,</para>
  <para style="q2" vid="PSA 59:7">wɔfe akofena firi wɔn anomu</para>
  <para style="q2" vid="PSA 59:7">na wɔka sɛ: “Hwan na ɔteɛ”?<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>Nanso, wo <char style="nd">Awurade</char>, wosere wɔn;</para>
  <para style="q2" vid="PSA 59:8">wodi saa aman no nyinaa ho fɛw.<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>Ao mʼAhoɔden, mehwɛ wo;</para>
  <para style="q2" vid="PSA 59:9">wo, Ao Onyankopɔn ne mʼabankɛseɛ,<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>me Onyankopɔn a ɔyɛ ɔdɔ.</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">Onyankopɔn bɛdi mʼanim</para>
  <para style="q2" vid="PSA 59:10">na ɔbɛma mahwɛ wɔn a wɔbɔ me ahohora no haa.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Nanso nkum wɔn, Ao Awurade yɛn akokyɛm,</para>
  <para style="q2" vid="PSA 59:11">na me nkurɔfoɔ werɛ amfiri wɔn.</para>
  <para style="q1" vid="PSA 59:11">Wo tumi mu no ma wɔnnantenante,</para>
  <para style="q2" vid="PSA 59:11">na brɛ wɔn ase.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Bɔne a ɛfiri wɔn anomu,</para>
  <para style="q2" vid="PSA 59:12">ne wɔn ano nsɛm enti</para>
  <para style="q1" vid="PSA 59:12">ma wɔn ahomasoɔ nkyekyere wɔn.</para>
  <para style="q2" vid="PSA 59:12">Abususɛm a wɔka ne atorɔ a wɔtwa enti,<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>sɛe wɔn wɔ abufuhyeɛ mu,</para>
  <para style="q2" vid="PSA 59:13">kɔsi sɛ wɔn ase bɛtɔre.</para>
  <para style="q1" vid="PSA 59:13">Afei ɛbɛma asase so afanan nyinaa ahunu</para>
  <para style="q2" vid="PSA 59:13">sɛ Onyankopɔn di Yakob so.<verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Wɔsane ba anwummerɛ,</para>
  <para style="q2" vid="PSA 59:14">wɔpɔ so sɛ nkraman</para>
  <para style="q2" vid="PSA 59:14">na wɔkyinkyin kuropɔn no mu.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Wɔkyinkyini pɛ aduane</para>
  <para style="q2" vid="PSA 59:15">na sɛ wɔammee a, wɔsu bobom.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Nanso mɛto wʼahoɔden ho dwom,</para>
  <para style="q2" vid="PSA 59:16">mɛto wʼadɔeɛ ho dwom anɔpa;</para>
  <para style="q1" vid="PSA 59:16">ɛfiri sɛ woyɛ mʼabankɛseɛ,</para>
  <para style="q2" vid="PSA 59:16">mʼahintaeɛ wɔ ahohia mmerɛ mu.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>Ao mʼAhoɔden, mɛto ayɛyi dwom ama wo;</para>
  <para style="q2" vid="PSA 59:17">wo, Ao Onyankopɔn, ne mʼabankɛseɛ, me Onyankopɔn a ɔyɛ ɔdɔ.</para>
  <para style="d" vid="PSA 59:17">Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛdeɛ wɔto “Susan Edut.”<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">Dwom 60</para>
  <para style="d">Dawid “Miktam” dwom. Wɔde yɛ nkyerɛkyerɛ. Ɔtoo no ɛberɛ a ɔne Aram Naharanfoɔ ne Aram Sabafoɔ koeɛ na Yoab sane kɔkumm Edomfoɔ mpem dumienu wɔ Nkyene Bɔnhwa mu no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>Ao Onyankopɔn, woapo yɛn, woabɔ yɛagu;</para>
  <para style="q2" vid="PSA 60:1">wo bo afu yɛn, nanso gye yɛn bio!<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Woawoso asase no na woapae mu;</para>
  <para style="q2" vid="PSA 60:2">toatoa deɛ abubuo no, ɛfiri sɛ, ɛrehinhim.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Woama wo nkurɔfoɔ ahunu mmerɛ bɔne;</para>
  <para style="q2" vid="PSA 60:3">woama yɛn nsã a ɛma yɛtɔ ntentan.<verse eid="PSA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>Nanso wɔn a wɔsuro wo deɛ, woama wɔn frankaa so</para>
  <para style="q2" vid="PSA 60:4">sɛ wɔntu ntia kuntun no.<verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Gye yɛn nkwa na fa wo nsa nifa boa yɛn,</para>
  <para style="q2" vid="PSA 60:5">na ama wɔn a wodɔ wɔn no anya nkwa.<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Onyankopɔn akasa firi kronkronbea sɛ,</para>
  <para style="q2" vid="PSA 60:6">“Nkonim mu, mɛkyɛ Sekem mu,</para>
  <para style="q2" vid="PSA 60:6">na masusu Sukot bɔnhwa no.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Gilead wɔ me, Manase wɔ me;</para>
  <para style="q2" vid="PSA 60:7">Efraim yɛ me dadeɛ kyɛ,</para>
  <para style="q2" vid="PSA 60:7">ɛna Yuda yɛ mʼahempoma.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Moab yɛ me dwaresɛn,</para>
  <para style="q2" vid="PSA 60:8">Edom so na meto me mpaboa guo;</para>
  <para style="q2" vid="PSA 60:8">na meteam nkonimdie so gu Filistifoɔ so.”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Hwan na ɔde me bɛkɔ kuropɔn a wɔabɔ ho ban no mu?</para>
  <para style="q2" vid="PSA 60:9">Hwan na ɔbɛdi mʼanim akɔ Edom?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Ɛnyɛ wo, Ao Onyankopɔn, wo a woapo yɛn</para>
  <para style="q2" vid="PSA 60:10">na wone yɛn akodɔm ankɔ sa bio no?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Boa yɛn tia ɔtamfoɔ no,</para>
  <para style="q2" vid="PSA 60:11">na ɔdasani mmoa nka hwee.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>Onyankopɔn wɔ yɛn afa yi, yɛbɛdi nkonim,</para>
  <para style="q2" vid="PSA 60:12">na ɔbɛtiatia yɛn atamfoɔ so.</para>
  <para style="d" vid="PSA 60:12">Wɔde ma dwomkyerɛfoɔ. Wɔde sankuo na ɛtoɔ.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">Dwom 61</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>Ao Onyankopɔn, tie me sufrɛ;</para>
  <para style="q2" vid="PSA 61:1">tie me mpaeɛbɔ.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Mefiri asase ano frɛ wo,</para>
  <para style="q2" vid="PSA 61:2">mefrɛ wo ɛfiri sɛ mʼakoma atɔ baha;</para>
  <para style="q2" vid="PSA 61:2">fa me kɔ ɔbotan a ɛware sene me no so.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Woayɛ me dwanekɔbea,</para>
  <para style="q2" vid="PSA 61:3">aban a ɛyɛ den ma ɔtamfoɔ no.<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Me kɔn dɔ sɛ metena wo ntomadan no mu afebɔɔ</para>
  <para style="q2" vid="PSA 61:4">na manya hintabea wɔ wo ntaban nwunu ase.<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Woate me bɔhyɛ, Ao Onyankopɔn;</para>
  <para style="q2" vid="PSA 61:5">na wode wɔn a wɔsuro wo din no agyapadeɛ ama me.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>To ɔhene nkwa nna mu bebree;</para>
  <para style="q2" vid="PSA 61:6">na ne mfeɛ mfiri awoɔ ntoatoasoɔ nkɔduru awoɔ ntoatoasoɔ.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Ma ɔnni ɔhene wɔ Onyankopɔn anim daa.</para>
  <para style="q2" vid="PSA 61:7">Fa wʼadɔeɛ ne wo nokorɛ bɔ ne ho ban.<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Afei mɛto ayɛyie dwom ama wo din daa</para>
  <para style="q2" vid="PSA 61:8">na madi me bɔhyɛ so daa nyinaa.</para>
  <para style="d" vid="PSA 61:8">Wɔde ma dwomkyerɛfoɔ Yedutun.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">Dwom 62</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>Me ɔkra wɔ ahomegyeɛ wɔ Onyankopɔn nko ara mu;</para>
  <para style="q2" vid="PSA 62:1">me nkwagyeɛ firi ne nkyɛn.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Ɔno nko ara ne me botan ne me nkwagyeɛ;</para>
  <para style="q2" vid="PSA 62:2">ɔyɛ mʼaban, na merenhinhim da.<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Mobɛkɔ so ahyɛ onipa baako so akɔsi da bɛn?</para>
  <para style="q2" vid="PSA 62:3">Mo nyinaa mobɛsum no ahwe fam anaa?</para>
  <para style="q2" vid="PSA 62:3">Mayɛ ɔfasuo a akyea, ɛban a ɛrebuo wɔ wɔn ani so.<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Wɔayɛ adwene sɛ wɔbɛtu me</para>
  <para style="q2" vid="PSA 62:4">afiri me diberɛ a ɛkorɔn no so;</para>
  <para style="q1" vid="PSA 62:4">wɔn ani gye atorɔ die ho.</para>
  <para style="q2" vid="PSA 62:4">Wɔde wɔn ano hyira</para>
  <para style="q1" vid="PSA 62:4">na wɔn akoma mu deɛ, wɔdome.<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Ao me kra, gye wʼahome wɔ Onyankopɔn nko ara mu;</para>
  <para style="q2" vid="PSA 62:5">na ne mu na mʼanidasoɔ wɔ.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>Ɔno nko ara ne me botan ne me nkwagyeɛ;</para>
  <para style="q2" vid="PSA 62:6">ɔyɛ mʼaban, na merenhinhim.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Me nkwagyeɛ ne mʼanimuonyam gyina Onyankopɔn so;</para>
  <para style="q2" vid="PSA 62:7">ɔyɛ me botan a ɛkorɔn, ne me dwanekɔbea.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Ao me nkurɔfoɔ, momfa mo ho nto ne so daa;</para>
  <para style="q2" vid="PSA 62:8">monka mo akoma mu nsɛm nyinaa nkyerɛ no,</para>
  <para style="q2" vid="PSA 62:8">ɛfiri sɛ Onyankopɔn ne yɛn dwanekɔbea.<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Nnipa nyinaa te sɛ home;</para>
  <para style="q2" vid="PSA 62:9">akɛseɛ ne nkumaa nyinaa nka hwee;</para>
  <para style="q1" vid="PSA 62:9">sɛ wɔkari wɔn wɔ nsania so a, wɔnka hwee;</para>
  <para style="q2" vid="PSA 62:9">wɔn nyinaa bɔ mu a, wɔyɛ home mu tutuo.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Mommfa mo ho nto nsisie so</para>
  <para style="q2" vid="PSA 62:10">na monnhoahoa mo ho korɔnodeɛ ho;</para>
  <para style="q1" vid="PSA 62:10">ɛwom sɛ mo ahonya dɔɔso deɛ,</para>
  <para style="q2" vid="PSA 62:10">nanso mommfa mo akoma nto so.<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Asɛm baako na Onyankopɔn aka,</para>
  <para style="q2" vid="PSA 62:11">nsɛm mmienu na mateɛ sɛ,</para>
  <para style="q1" vid="PSA 62:11">wo, Onyankopɔn, wo na wowɔ ahoɔden,<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>na wo, Awurade, wo na woyɛ adɔeɛ.</para>
  <para style="q2" vid="PSA 62:12">Ampa ara, wobɛtua obiara ka</para>
  <para style="q2" vid="PSA 62:12">sɛdeɛ nʼadwuma teɛ.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">Dwom 63</para>
  <para style="d">Dawid dwom. Ɛberɛ a ɔwɔ Yuda Ɛserɛ so no na ɔtoeɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>Ao, Onyankopɔn, wone me Onyankopɔn</para>
  <para style="q2" vid="PSA 63:1">Mehwehwɛ wo anibereɛ so;</para>
  <para style="q1" vid="PSA 63:1">wo ho sukɔm de me kra,</para>
  <para style="q2" vid="PSA 63:1">me onipadua ani agyina wo,</para>
  <para style="q1" vid="PSA 63:1">wɔ asase a awo na ɛserɛ nni so,</para>
  <para style="q2" vid="PSA 63:1">baabi a nsuo nnie.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Mahunu wo wɔ Kronkronbea hɔ</para>
  <para style="q2" vid="PSA 63:2">mahunu wo tumi ne wʼanimuonyam.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Esiane sɛ, wʼadɔeɛ di mu sene nkwa enti</para>
  <para style="q2" vid="PSA 63:3">mʼano fafa bɛhyɛ wo animuonyam.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Sɛ mete ase yi, mɛkamfo wo,</para>
  <para style="q2" vid="PSA 63:4">na wo din mu na mɛpagya me nsa.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Me ɔkra bɛmee sɛdeɛ wadi aduane papa bi;</para>
  <para style="q2" vid="PSA 63:5">mede anofafa a ɛto dwom bɛyi wo ayɛ.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Meda me mpa so a, mekae wo.</para>
  <para style="q2" vid="PSA 63:6">Anadwo dasuo mu nyinaa, medwene wo ho.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Ɛfiri sɛ, wone ne ɔboafoɔ,</para>
  <para style="q2" vid="PSA 63:7">wo ntaban ase nwunu mu na mɛto dwom.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Me kra bata wo ho;</para>
  <para style="q2" vid="PSA 63:8">na wo nsa nifa kura me mu.<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Wɔn a wɔpɛ me akum me no bɛsɛe;</para>
  <para style="q2" vid="PSA 63:9">wɔbɛkɔ asase ase tɔnn.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Wɔbɛdane wɔn ama akofena</para>
  <para style="q2" vid="PSA 63:10">na wɔbɛyɛ aduane ama sakraman.<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>Nanso ɔhene bɛdi ahurisie wɔ Onyankopɔn mu;</para>
  <para style="q2" vid="PSA 63:11">wɔn a wɔka ntam wɔ Onyankopɔn din mu nyinaa bɛkamfo no,</para>
  <para style="q2" vid="PSA 63:11">na wɔbɛmua atorofoɔ ano.</para>
  <para style="d" vid="PSA 63:11">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">Dwom 64</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>Ao Onyankopɔn, tie me ɛberɛ a mereka me haw;</para>
  <para style="q2" vid="PSA 64:1">bɔ me ɔkra ho ban firi ɔtamfoɔ ahunahuna ho.<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Fa me sie firi amumuyɛfoɔ agyinatuo ho,</para>
  <para style="q2" vid="PSA 64:2">ne nnebɔneyɛfoɔ dodoɔ no gyegyeegyeyɛ ho.<verse eid="PSA 64:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Wɔse wɔn tɛkrɛma sɛ akofena</para>
  <para style="q2" vid="PSA 64:3">na wɔse wɔn ano sɛ mmɛmma kɔdiawuo.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Wɔfiri atɛeɛ mu, to bɔ onipa a ne ho nni asɛm;</para>
  <para style="q2" vid="PSA 64:4">wɔto bɔ no mpofirim a wɔnsuro.<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Wɔhyehyɛ wɔn ho wɔn ho nkuran wɔ wɔn amumuyɛ nneyɛeɛ ho,</para>
  <para style="q2" vid="PSA 64:5">wɔka sɛdeɛ wɔbɛsum afidie;</para>
  <para style="q2" vid="PSA 64:5">wɔka sɛ, “Hwan na ɔbɛhunu yɛn?”<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Wɔbɔ atɛnkyea ho pɔ na wɔka sɛ,</para>
  <para style="q2" vid="PSA 64:6">“Yɛayɛ nhyehyɛeɛ a ɛyɛ pɛ!”</para>
  <para style="q1" vid="PSA 64:6">Ampa ara onipa akoma ne nʼadwene yɛ anifire.<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>Nanso, Onyankopɔn bɛto bɛmma awɔ wɔn;</para>
  <para style="q2" vid="PSA 64:7">na wɔbɛhwe fam prɛko pɛ.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Ɔbɛdane wɔn ankasa tɛkrɛma atia wɔn</para>
  <para style="q2" vid="PSA 64:8">na ɔde wɔn aba ɔsɛeɛ mu;</para>
  <para style="q2" vid="PSA 64:8">na wɔn a wɔbɛhunu wɔn nyinaa bɛbɔ wɔn tiri nko wɔ animtiabuo so.<verse eid="PSA 64:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Adasamma nyinaa bɛsuro;</para>
  <para style="q2" vid="PSA 64:9">wɔbɛpae mu aka Onyankopɔn nnwuma</para>
  <para style="q2" vid="PSA 64:9">na wɔasusu deɛ wayɛ ho.<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Ma teneneefoɔ nni ahurisie wɔ Awurade mu</para>
  <para style="q2" vid="PSA 64:10">na wɔmpɛ hintabea wɔ ne mu;</para>
  <para style="q2" vid="PSA 64:10">ma wɔn a wɔn akoma mu teɛ nyinaa nyi no ayɛ!</para>
  <para style="d" vid="PSA 64:10">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">Dwom 65</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>Ao, Onyankopɔn, ayɛyie retwɛn wo wɔ Sion,</para>
  <para style="q2" vid="PSA 65:1">na yɛbɛdi yɛn bɔ a yɛahyɛ wo no so.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>Ao, wo a woyɛ mpaeɛbɔ tiefoɔ,</para>
  <para style="q2" vid="PSA 65:2">wo nkyɛn na nnipa nyinaa bɛba.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Ɛberɛ a yɛn bɔne menee yɛn no,</para>
  <para style="q2" vid="PSA 65:3">wo na wɔde yɛn mmaratoɔ kyɛɛ yɛn.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Nhyira nka wɔn a woyi wɔn</para>
  <para style="q2" vid="PSA 65:4">ma wɔbɛn wo sɛ wɔntena wʼadihɔ hɔ!</para>
  <para style="q1" vid="PSA 65:4">Nneɛma pa a ɛwɔ wo fie ahyɛ yɛn ma,</para>
  <para style="q2" vid="PSA 65:4">deɛ ɛwɔ wʼasɔredan kronkron mu no.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Wode tenenee nnwuma a ɛyɛ nwanwa ma yɛn mmuaeɛ,</para>
  <para style="q2" vid="PSA 65:5">Ao Onyankopɔn yɛn agyenkwa.</para>
  <para style="q1" vid="PSA 65:5">Woyɛ asase so afanan nyinaa anidasoɔ</para>
  <para style="q2" vid="PSA 65:5">ne ɛpo so akyirikyiri nso.<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>Wonam wo tumi so yɛɛ mmepɔ</para>
  <para style="q2" vid="PSA 65:6">de daa wʼahoɔden adi.<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>Wodwodwoo ɛpo nworosoɔ,</para>
  <para style="q2" vid="PSA 65:7">asorɔkye no a ɛbobɔ</para>
  <para style="q2" vid="PSA 65:7">ne amanaman no hooyɛ.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Wɔn a wɔte akyirikyiri no suro wʼanwanwadeɛ.</para>
  <para style="q2" vid="PSA 65:8">Ɛfiri faako a adeɛ kye kɔsi deɛ onwunu dwoɔ,</para>
  <para style="q2" vid="PSA 65:8">wofrɛ ahurisie nnwom wɔ hɔ.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Wohwɛ asase no gugu so nsuo;</para>
  <para style="q2" vid="PSA 65:9">woma no yɛ asase pa ma ɛboro so.</para>
  <para style="q1" vid="PSA 65:9">Wode nsuo hyɛ Onyankopɔn nsuwansuwa ma</para>
  <para style="q2" vid="PSA 65:9">sɛdeɛ ɛbɛma nnipa no aduane.</para>
  <para style="q2" vid="PSA 65:9">Sɛdeɛ woayɛ no nie.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Wofɔɔ deɛ woafuntum hɔ fɔkyee</para>
  <para style="q2" vid="PSA 65:10">na wokaa nkofie no sram so;</para>
  <para style="q1" vid="PSA 65:10">wode nsuo petee so maa no yɛɛ bɛtɛɛ</para>
  <para style="q2" vid="PSA 65:10">na wohyiraa ɛso afifideɛ.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Wode nnɔbaeɛ bebree wiee afe no,</para>
  <para style="q2" vid="PSA 65:11">na wo nteaseɛnam yɛɛ ma buu so.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Ɛserɛ so wira dɔɔso</para>
  <para style="q2" vid="PSA 65:12">na anigyeɛ baa nkokoɔ so.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Nnwankuo ahyɛ adidibea hɔ ma</para>
  <para style="q2" vid="PSA 65:13">na ayuo akata mmɔnhwa no so;</para>
  <para style="q2" vid="PSA 65:13">wɔbɔ ose, to ahosɛpɛ dwom.</para>
  <para style="d" vid="PSA 65:13">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">Dwom 66</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>Asase nyinaa momfa ahosɛpɛ nteam mma Onyankopɔn!<verse eid="PSA 66:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2"/>Monto ne din animuonyamhyɛ ho dwom;</para>
  <para style="q2" vid="PSA 66:2">momma nʼayɛyie nyɛ animuonyamhyɛ!<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Monse Onyankopɔn sɛ, “Wo nneyɛɛ yɛ nwanwa</para>
  <para style="q2" vid="PSA 66:3">wo tumi so</para>
  <para style="q2" vid="PSA 66:3">na wʼatamfoɔ nyinaa de suro koto wʼanim.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Asase nyinaa koto wo;</para>
  <para style="q2" vid="PSA 66:4">wɔto ayɛyi dwom ma wo,</para>
  <para style="q2" vid="PSA 66:4">wɔto dwom kamfo wo din.”<verse eid="PSA 66:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Mommra mmɛhwɛ deɛ Onyankopɔn ayɛ;</para>
  <para style="q2" vid="PSA 66:5">anwanwadeɛ a wayɛ wɔ nnipa mu.<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>Ɔmaa ɛpo yɛɛ asase kesee;</para>
  <para style="q2" vid="PSA 66:6">wɔnante twaa asuo no.</para>
  <para style="q2" vid="PSA 66:6">Mommra na yɛnni ahurisie wɔ ne mu.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Ɔde ne tumi di ɔhene daa daa,</para>
  <para style="q2" vid="PSA 66:7">na ɔde nʼani nso hwɛ aman so.</para>
  <para style="q2" vid="PSA 66:7">Mma atuatefoɔ nsɔre ntia no.<verse eid="PSA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Ao aman nyinaa, monhyira yɛn Onyankopɔn,</para>
  <para style="q2" vid="PSA 66:8">momma wɔnte mo nkamfo no nnyegyeɛ.<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>Wahwɛ yɛn nkwa so</para>
  <para style="q2" vid="PSA 66:9">na wamma yɛn nan anwatiri.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Na wo, Ao Onyankopɔn, wosɔɔ yɛn hwɛeɛ;</para>
  <para style="q2" vid="PSA 66:10">na wohoaa yɛn ho sɛ dwetɛ.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Wode yɛn kɔguu nneduadan mu</para>
  <para style="q2" vid="PSA 66:11">na wode nneɛma a ɛyɛ duru too yɛn akyi.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Womaa yɛn atamfoɔ twi faa yɛn so;</para>
  <para style="q2" vid="PSA 66:12">yɛfaa ogya ne nsuo mu,</para>
  <para style="q2" vid="PSA 66:12">nanso wode yɛn baa baabi a nnepa abu so.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Mede ɔhyeɛ afɔdeɛ bɛba wʼasɔredan mu</para>
  <para style="q2" vid="PSA 66:13">na madi ɛbɔ a mahyɛ wo no so,<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ɛbɔ a mʼano fafa hyɛeɛ na mʼano kaaeɛ</para>
  <para style="q2" vid="PSA 66:14">ɛberɛ a na mewɔ ɔhaw mu no.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Mede mmoa a wɔadɔ sradeɛ bɛbɔ afɔdeɛ ama wo</para>
  <para style="q2" vid="PSA 66:15">nnwennini ayɛyɛdeɛ;</para>
  <para style="q2" vid="PSA 66:15">mede anantwinini ne mpapo bɛbɔ afɔdeɛ.<verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Mommra mmɛtie, mo a mosuro Onyankopɔn nyinaa;</para>
  <para style="q2" vid="PSA 66:16">momma menka deɛ wayɛ ama me nkyerɛ mo.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Mede mʼano su frɛɛ no;</para>
  <para style="q2" vid="PSA 66:17">na me tɛkrɛma yii no ayɛ.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Sɛ mede bɔne hyɛɛ mʼakomam a,</para>
  <para style="q2" vid="PSA 66:18">anka Awurade antie me.<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>Nanso, nokorɛm, Onyankopɔn atie me,</para>
  <para style="q2" vid="PSA 66:19">wate me mpaeɛbɔ.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Nhyira nka Onyankopɔn,</para>
  <para style="q2" vid="PSA 66:20">a wampo me mpaeɛbɔ</para>
  <para style="q2" vid="PSA 66:20">na wanyi nʼadɔeɛ amfiri me so.</para>
  <para style="d" vid="PSA 66:20">Wɔde ma dwomkyerɛfoɔ. Wɔde sankuo na ɛtoeɛ.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">Dwom 67</para>
  <para style="d">Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>Onyankopɔn nnom yɛn na ɔnhyira yɛn</para>
  <para style="q2" vid="PSA 67:1">ɔmma nʼanim nhyerɛn wɔ yɛn so,<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>na ɔmma wɔnhunu nʼakwan wɔ asase so,</para>
  <para style="q2" vid="PSA 67:2">ne ne nkwagyeɛ wɔ amanaman no nyinaa mu.<verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>Ma adasamma nyi wo ayɛ, Ao Onyankopɔn;</para>
  <para style="q2" vid="PSA 67:3">ma nnipa nyinaa nkamfo wo.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Ma amanaman ani nnye na wɔnto ahosɛpɛ dwom,</para>
  <para style="q2" vid="PSA 67:4">ɛfiri sɛ wodi nnipa no so tenenee mu</para>
  <para style="q2" vid="PSA 67:4">na woma asase so amanaman no akwankyerɛ.<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Ma adasamma nyi wo ayɛ, Ao Onyankopɔn;</para>
  <para style="q2" vid="PSA 67:5">ma nnipa nyinaa nkamfo wo!<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Afei asase no bɛbɔ ne nnɔbaeɛ,</para>
  <para style="q2" vid="PSA 67:6">na Onyankopɔn, yɛn Onyankopɔn ahyira yɛn.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Onyankopɔn bɛhyira yɛn,</para>
  <para style="q2" vid="PSA 67:7">na wɔn a wɔte asase ano nyinaa bɛsuro no.</para>
  <para style="d" vid="PSA 67:7">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">Dwom 68</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>Ma Onyankopɔn nsɔre, na nʼatamfoɔ mmɔ mpete;</para>
  <para style="q2" vid="PSA 68:1">wɔn a wɔtane noɔ no nnwane mfiri nʼanim.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Sɛdeɛ mframa bɔ wisie gu no,</para>
  <para style="q2" vid="PSA 68:2">saa ara na bɔ wɔn gu;</para>
  <para style="q1" vid="PSA 68:2">sɛdeɛ sradeɛ nane wɔ ogya so no,</para>
  <para style="q2" vid="PSA 68:2">saa ara na amumuyɛfoɔ nyera mfiri Onyankopɔn anim.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Nanso, ma ateneneefoɔ ani nnye</para>
  <para style="q2" vid="PSA 68:3">na wɔnsɛpɛ wɔn ho wɔ Onyankopɔn anim;</para>
  <para style="q2" vid="PSA 68:3">ma wɔn ho ntɔ wɔn na wɔnni ahurisie.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>To dwom ma Onyankopɔn, to dwom yi ne din ayɛ.</para>
  <para style="q2" vid="PSA 68:4">Ma deɛ ɔnante omununkum soɔ no din so.</para>
  <para style="q1" vid="PSA 68:4">Ne din ne <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 68:4">ma wʼani nnye wɔ nʼanim.<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Nwisiaa agya ne deɛ ɔdi akunafoɔ asɛm ma wɔn</para>
  <para style="q2" vid="PSA 68:5">ne Onyankopɔn a ɔte nʼatenaeɛ kronkron hɔ.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Ɔma onnibie tena mmusua mu,</para>
  <para style="q2" vid="PSA 68:6">na ɔde nnwontoɔ yi nneduafoɔ ma wɔde wɔn ho;</para>
  <para style="q2" vid="PSA 68:6">na atuatefoɔ deɛ, wɔtena asase a awo so.<verse eid="PSA 68:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>Ao Onyankopɔn, ɛberɛ a wodii wo nkurɔfoɔ anim,</para>
  <para style="q2" vid="PSA 68:7">ɛberɛ a wode wɔn faa ɛserɛ so no,<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>asase wosoeɛ,</para>
  <para style="q2" vid="PSA 68:8">na ɔsoro tuee osuo guu fam,</para>
  <para style="q1" vid="PSA 68:8">wɔ Onyankopɔn, Sinai Onyankopɔn no,</para>
  <para style="q2" vid="PSA 68:8">Onyankopɔn, Israel Onyankopɔn no anim.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>Womaa osuo tɔɔ bebree, Ao Onyankopɔn,</para>
  <para style="q2" vid="PSA 68:9">guu wʼagyapadeɛ a abotoɔ no so ma ɛyɛɛ frɔmm.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Wo nkurɔfoɔ bɔɔ atenaseɛ wɔ so.</para>
  <para style="q2" vid="PSA 68:10">Ao Onyankopɔn, wonam wʼadɔeɛ bebree no mu hwɛɛ ahiafoɔ.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Awurade kaa asɛm no,</para>
  <para style="q2" vid="PSA 68:11">na dodoɔ no ara ne wɔn a wɔpaee mu kaeɛ;<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“Ahemfo ne wɔn asraafoɔ dwane ntɛm so;</para>
  <para style="q2" vid="PSA 68:12">na mmaa kyɛ afodeɛ no.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Mpo wɔn a wɔn daberɛ wɔ nnwankuo mu no,</para>
  <para style="q2" vid="PSA 68:13">wɔnya afodeɛ no bi.</para>
  <para style="q2" vid="PSA 68:13">Wɔnya aborɔnoma a wɔde sikakɔkɔɔ ne sika adura wɔn ntaban so.”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Ɛberɛ a Otumfoɔ bɔɔ ahene a wɔwɔ asase no so hweteeɛ no,</para>
  <para style="q2" vid="PSA 68:14">na ɛte sɛ sukyerɛmma a agu Salmon so.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Basan mmepɔ gyinagyina hɔ,</para>
  <para style="q1" vid="PSA 68:15">Basan mmepɔ so yɛ mmɔnkyi mmɔnka.<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>Ao mmepɔ mmɔnkyi mmɔnka, adɛn enti na mode ani bɔne</para>
  <para style="q2" vid="PSA 68:16">hwɛ bepɔ a Onyankopɔn ayi sɛ ɔbɛdi so ɔhene,</para>
  <para style="q2" vid="PSA 68:16">baabi a <char style="nd">Awurade</char> ankasa bɛtena afebɔɔ?<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Onyankopɔn nteaseɛnam yɛ ɔpedu mpem mpem</para>
  <para style="q2" vid="PSA 68:17">ne ɔpepem mpem mpem;</para>
  <para style="q2" vid="PSA 68:17">Awurade firi Sinai aba ne kronkronbea.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Ɛberɛ a woforo kɔɔ soro no,</para>
  <para style="q2" vid="PSA 68:18">wode nnommumfoɔ kaa wo ho;</para>
  <para style="q2" vid="PSA 68:18">wonyaa ayɛyɛdeɛ firii nnipa hɔ,</para>
  <para style="q1" vid="PSA 68:18">firii atuatefoɔ hɔ mpo,</para>
  <para style="q2" vid="PSA 68:18">sɛ ɛbɛyɛ a wobɛtena hɔ, Ao <char style="nd">Awurade</char> Onyankopɔn.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Ayɛyie nka Awurade Onyankopɔn, yɛn Agyenkwa,</para>
  <para style="q2" vid="PSA 68:19">deɛ ɔsoa yɛn nnesoa da biara no.<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Yɛn Onyankopɔn yɛ Onyankopɔn a ɔgye nkwa;</para>
  <para style="q2" vid="PSA 68:20">na <char style="nd">Awurade</char> na ɔgye yɛn firi owuo mu.<verse eid="PSA 68:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Ampa ara, Onyankopɔn bɛyam nʼatamfoɔ ti,</para>
  <para style="q2" vid="PSA 68:21">wɔn a wɔkɔ so yɛ bɔne no.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>
    <char style="nd">Awurade</char> ka sɛ, “Mede wɔn bɛfiri Basan aba;</para>
  <para style="q2" vid="PSA 68:22">mede wɔn bɛfiri ɛpo bunu mu aba,<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>na moanante wɔn a wɔkyiri moɔ no mogya mu</para>
  <para style="q2" vid="PSA 68:23">na mo nkraman tɛkrɛma anya wɔn kyɛfa.”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>Ao Onyankopɔn, yɛahunu wo santen yuu no,</para>
  <para style="q2" vid="PSA 68:24">me Onyankopɔn ne me Ɔhene santen yuu no a ɔde reba ne kronkronbea hɔ.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Nnwontofoɔ no wɔ animu, ɛnna asankubɔfoɔ no nso di so,</para>
  <para style="q2" vid="PSA 68:25">na mmabaawa a wɔrewoso akasaeɛ nso ka wɔn ho.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Monkamfo Onyankopɔn wɔ asafo kɛseɛ no mu;</para>
  <para style="q2" vid="PSA 68:26">monkamfo <char style="nd">Awurade</char> wɔ Israel nipakuo no mu.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>Abusuakuo ketewa Benyamin na ɔdi wɔn ɛkan,</para>
  <para style="q2" vid="PSA 68:27">Yuda mmapɔmma kuo kɛseɛ no di so,</para>
  <para style="q2" vid="PSA 68:27">na Sebulon ne Naftali mmapɔmma aba.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Kyerɛ wo tumi, Onyankopɔn;</para>
  <para style="q2" vid="PSA 68:28">da wʼahoɔden adi kyerɛ yɛn, sɛdeɛ woayɛ pɛn no.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Wʼasɔredan a ɛwɔ Yerusalem enti</para>
  <para style="q2" vid="PSA 68:29">ahemfo de ayɛyɛdeɛ bɛbrɛ wo.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Ka aboa a ɔhyɛ demmire mu no anim,</para>
  <para style="q2" vid="PSA 68:30">ne anantwinini kuo a wɔhyɛ amanaman no anantwie mma mu no.</para>
  <para style="q1" vid="PSA 68:30">Brɛ wɔn ase kɔsi sɛ wɔde dwetɛ mpɔ bɛba.</para>
  <para style="q2" vid="PSA 68:30">Bɔ wɔn a wɔn ani gye ɔko ho no pansam.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Ananmusifoɔ bɛfiri Misraim aba,</para>
  <para style="q2" vid="PSA 68:31">na Kus de ne ho bɛma Onyankopɔn.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Ao ewiase ahennie, monto dwom mma Onyankopɔn,</para>
  <para style="q2" vid="PSA 68:32">monto ayɛyi dwom mma <char style="nd">Awurade</char>,<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>monto mma deɛ ɔte tete soro soro so no,</para>
  <para style="q2" vid="PSA 68:33">na ɔde nne kɛseɛ bobɔ mu no.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Mompae mu nka Onyankopɔn tumi,</para>
  <para style="q2" vid="PSA 68:34">deɛ ne kɛseyɛ hata Israel so no,</para>
  <para style="q2" vid="PSA 68:34">na ne tumi wɔ soro soro no.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>Wo ho yɛ nwanwa, Onyankopɔn, wɔwo kronkronbea hɔ;</para>
  <para style="q2" vid="PSA 68:35">Israel Onyankopɔn de tumi ne ahoɔden ma ne nkurɔfoɔ.</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">Ayɛyie nka Onyankopɔn!</para>
  <para style="d" vid="PSA 68:35">Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛ “Sukooko.”<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">Dwom 69</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>Ao Onyankopɔn, gye me nkwa</para>
  <para style="q2" vid="PSA 69:1">na nsuo no abɛdeda me kɔn mu.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Meremem wɔ atɛkyɛ a emu dɔ mu,</para>
  <para style="q2" vid="PSA 69:2">wɔ baabi a me nan nnya siberɛ.</para>
  <para style="q1" vid="PSA 69:2">Maduru subunu mu</para>
  <para style="q2" vid="PSA 69:2">na nsuo abu afa me so.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Mafrɛ mabrɛ sɛ mepɛ mmoa.</para>
  <para style="q2" vid="PSA 69:3">Me mene mu awe.</para>
  <para style="q1" vid="PSA 69:3">Mʼani so ayɛ kusuu,</para>
  <para style="q1" vid="PSA 69:3">na merehwehwɛ me Onyankopɔn.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Wɔn a wɔtane me kwa no dɔɔso</para>
  <para style="q2" vid="PSA 69:4">sene me tiri so nwi;</para>
  <para style="q1" vid="PSA 69:4">wɔn a wɔtane me kwa no dɔɔso,</para>
  <para style="q2" vid="PSA 69:4">wɔn a wɔhwehwɛ sɛ wɔbɛsɛe me no.</para>
  <para style="q1" vid="PSA 69:4">Wɔhyɛ me sɛ mennane</para>
  <para style="q2" vid="PSA 69:4">deɛ menwiaaɛ no mma.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>Ao Onyankopɔn, wonim me kwasea a mayɛ;</para>
  <para style="q2" vid="PSA 69:5">mʼafɔdie nhintaa wo.<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>Mma wɔn a wɔde wɔn ho to wo so no</para>
  <para style="q2" vid="PSA 69:6">anim ngu ase ɛsiane me enti,</para>
  <para style="q2" vid="PSA 69:6">Ao Awurade, Asafo <char style="nd">Awurade</char>;</para>
  <para style="q1" vid="PSA 69:6">mma wɔn a wɔhwehwɛ wo no</para>
  <para style="q2" vid="PSA 69:6">anim ngu ase me enti,</para>
  <para style="q2" vid="PSA 69:6">Ao Israel Onyankopɔn.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Wo enti wobu me animtiaa,</para>
  <para style="q2" vid="PSA 69:7">na aniwuo akata mʼanim.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Mete sɛ ɔhɔhoɔ wɔ me nuanom mu,</para>
  <para style="q2" vid="PSA 69:8">mete sɛ ɔmamfrani wɔ me maame mmammarima mu,<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>na wo fie ho mmɔdemmɔ hyɛ me so,</para>
  <para style="q2" vid="PSA 69:9">wɔn a wɔbɔ wo ahohora no animtiabuo abɛda me so.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Sɛ metwa adwo na medi mmuada a</para>
  <para style="q2" vid="PSA 69:10">wɔbɔ me ahohora;<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>sɛ mefira ayitoma a</para>
  <para style="q2" vid="PSA 69:11">nnipa de me yɛ aseredeɛ.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Wɔn a wɔtete ɛpono no ano no sere me,</para>
  <para style="q2" vid="PSA 69:12">na akɔwensafoɔ de me din to dwom.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>Nanso mɛbɔ wo mpaeɛ, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 69:13">wɔ wʼadom berɛ mu;</para>
  <para style="q1" vid="PSA 69:13">wɔ wʼadɔeɛ kɛseɛ no enti, Ao Onyankopɔn,</para>
  <para style="q2" vid="PSA 69:13">fa wo nokorɛ nkwagyeɛ no gye me so.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Yi me firi atɛkyɛ no mu,</para>
  <para style="q2" vid="PSA 69:14">mma memmem wɔ mu;</para>
  <para style="q1" vid="PSA 69:14">gye me firi wɔn a wɔtane me no nsam,</para>
  <para style="q2" vid="PSA 69:14">ne nsu bunu mu.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Mma nsuo nnyiri mfa me</para>
  <para style="q2" vid="PSA 69:15">anaa ebunu mmene me</para>
  <para style="q2" vid="PSA 69:15">anaa amena nkata me so.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>Ao <char style="nd">Awurade</char>, gye me so firi wʼadɔeɛ a ɛyɛ no mu;</para>
  <para style="q2" vid="PSA 69:16">wʼadom enti, dane bɛhwɛ me.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>Mfa wʼanim nhinta wo ɔsomfoɔ;</para>
  <para style="q2" vid="PSA 69:17">gye me so ntɛm, na mewɔ ɔhaw mu.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Twi bɛn me na gye me;</para>
  <para style="q2" vid="PSA 69:18">gye me nkwa, mʼatamfoɔ enti.<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Wonim sɛdeɛ wɔkasa tia me, gu mʼanim ase na wɔtiatia mʼanim;</para>
  <para style="q2" vid="PSA 69:19">wʼani tua mʼatamfoɔ nyinaa.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Kasatia ahyɛ mʼakoma so</para>
  <para style="q2" vid="PSA 69:20">ama mayɛ sɛ obi a ɔnni ɔboafoɔ;</para>
  <para style="q1" vid="PSA 69:20">mepɛɛ awerɛkyekyerɛ nanso mannya bi,</para>
  <para style="q2" vid="PSA 69:20">mepɛɛ ɔwerɛkyekyefoɔ, nanso manhunu bi.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Wɔde bɔnwoma guu mʼaduane mu,</para>
  <para style="q2" vid="PSA 69:21">osukɔm dee me no, wɔmaa me nsã nwononwono.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Ma wɔn didipono a ɛsi wɔn anim nyi wɔn sɛ afidie;</para>
  <para style="q2" vid="PSA 69:22">ma ɛnyɛ akatua ne afidie mma wɔn.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Ma wɔn ani so nyɛ wɔn kusuu na wɔanhunu adeɛ,</para>
  <para style="q2" vid="PSA 69:23">na ma wɔn akyi nkuntunu afebɔɔ.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Hwie wʼabufuhyeɛ gu wɔn so;</para>
  <para style="q2" vid="PSA 69:24">na ma wʼabofuo huuhuuhu no mmra wɔn so.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Ma wɔn atenaeɛ nyɛ amamfo;</para>
  <para style="q2" vid="PSA 69:25">mma obiara ntena wɔn ntomadan mu.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Wɔtaa wɔn a wopira wɔn no,</para>
  <para style="q2" vid="PSA 69:26">wɔka wɔn a wopira wɔn no amanehunu ho asɛm.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Fa amumuyɛ mu amumuyɛ ho soboɔ bɔ wɔn;</para>
  <para style="q2" vid="PSA 69:27">mma wɔnnya wo nkwagyeɛ mu kyɛfa.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Pepa wɔn din firi nkwa nwoma no mu,</para>
  <para style="q2" vid="PSA 69:28">mfa wɔn din nka ateneneefoɔ deɛ ho.<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>Mewɔ ɔyea ne ahohiahia mu;</para>
  <para style="q2" vid="PSA 69:29">Ao Onyankopɔn, ma wo nkwagyeɛ no mmɔ me ho ban.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Mede dwomtoɔ bɛyi Onyankopɔn din ayɛ</para>
  <para style="q2" vid="PSA 69:30">na mede aseda ahyɛ no animuonyam.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Yei bɛsɔ <char style="nd">Awurade</char> ani yie asene nantwie,</para>
  <para style="q2" vid="PSA 69:31">asene nantwinini a ɔtua mmɛn na ɔwɔ tɔte.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Mmɔborɔni bɛhunu na nʼani agye,</para>
  <para style="q2" vid="PSA 69:32">mo a mohwehwɛ Onyankopɔn no akoma bɛnya nkwa.<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>
    <char style="nd">Awurade</char> tie wɔn a adeɛ ahia wɔn,</para>
  <para style="q2" vid="PSA 69:33">na ɔmmu ne nkurɔfoɔ nneduafoɔ animtiaa.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Ma ɔsoro ne asase nkamfo no,</para>
  <para style="q2" vid="PSA 69:34">ɛpo ne deɛ ɛkeka ne ho wɔ mu nyinaa,<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>ɛfiri sɛ Onyankopɔn bɛgye Sion nkwa</para>
  <para style="q2" vid="PSA 69:35">na wakyekyere Yuda nkuropɔn no bio.</para>
  <para style="q1" vid="PSA 69:35">Afei nnipa bɛtena mu na ayɛ wɔn dea;<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>Nʼasomfoɔ asefoɔ na wɔbɛfa hɔ,</para>
  <para style="q2" vid="PSA 69:36">na wɔn a wɔdɔ ne din no bɛtena hɔ.</para>
  <para style="d" vid="PSA 69:36">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">Dwom 70</para>
  <para style="d">Dawid adesrɛ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>Ao Onyankopɔn, yɛ ntɛm gye me nkwa;</para>
  <para style="q2" vid="PSA 70:1">Ao <char style="nd">Awurade</char> bra ntɛm bɛboa me.<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>Ma wɔn a wɔhwehwɛ me kra no</para>
  <para style="q2" vid="PSA 70:2">anim ngu ase na wɔnyɛ basaa;</para>
  <para style="q1" vid="PSA 70:2">ma wɔn a wɔhwehwɛ me sɛeɛ no nyinaa</para>
  <para style="q2" vid="PSA 70:2">mfa animguaseɛ nsane wɔn akyi.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Ma wɔn a wɔka, “Ɔtwea! Ɔtwea!” kyerɛ me no</para>
  <para style="q2" vid="PSA 70:3">nsane wɔn akyi ɛsiane wɔn aniwuo enti.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Nanso ma wɔn a wɔhwehwɛ wo nyinaa</para>
  <para style="q2" vid="PSA 70:4">nsɛpɛ wɔn ho na wɔn ani nnye wɔ wo mu;</para>
  <para style="q1" vid="PSA 70:4">ma wɔn a wɔdɔ wo nkwagyeɛ no nka da biara sɛ,</para>
  <para style="q2" vid="PSA 70:4">“Onyankopɔn yɛ kɛseɛ!”<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Meyɛ ohiani a menni ɔboafoɔ;</para>
  <para style="q2" vid="PSA 70:5">Ao Onyankopɔn, bra me nkyɛn ntɛm.</para>
  <para style="q1" vid="PSA 70:5">Wo ne me ɔboafoɔ ne me gyefoɔ;</para>
  <para style="q2" vid="PSA 70:5">Ao <char style="nd">Awurade</char>, ntwentwɛn wo nan ase.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">Dwom 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>Ao <char style="nd">Awurade</char>, wo mu na me dwane hinta;</para>
  <para style="q2" vid="PSA 71:1">mma mʼanim ngu ase da.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Wo tenenee no enti, yi me na gye me;</para>
  <para style="q2" vid="PSA 71:2">tie me na gye me nkwa.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Yɛ me nkwagyeɛ botan</para>
  <para style="q2" vid="PSA 71:3">faako a mɛtumi akɔ daa;</para>
  <para style="q1" vid="PSA 71:3">hyɛ ma wɔmmɛgye me nkwa,</para>
  <para style="q2" vid="PSA 71:3">na wo ne me botan ne mʼaban.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>Ao me Onyankopɔn, gye me firi amumuyɛfoɔ nsam,</para>
  <para style="q2" vid="PSA 71:4">gye me firi nnebɔneyɛfoɔ ne atirimuɔdenfoɔ nsam.<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Na woayɛ mʼanidasoɔ, Ao Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 71:5">mʼahotɔsoɔ firi mʼababunu berɛ mu.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Ɛfiri awoɔ mu, mede me ho ato wo so;</para>
  <para style="q2" vid="PSA 71:6">wo na woyii me firii me maame yafunu mu.</para>
  <para style="q2" vid="PSA 71:6">Mɛkamfo wo daa.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Mayɛ nhwɛsodeɛ ama bebree,</para>
  <para style="q2" vid="PSA 71:7">nanso wo ne me dwanekɔbea denden.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Wo nkamfo ahyɛ mʼanom ma,</para>
  <para style="q2" vid="PSA 71:8">mekamfo wʼanimuonyam da mu nyinaa.<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Nto me ntwene ɛberɛ a mabɔ akɔkoraa;</para>
  <para style="q2" vid="PSA 71:9">mʼahoɔden sa me mu a, nnya me.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Ɛfiri sɛ mʼatamfoɔ kasa tia me</para>
  <para style="q2" vid="PSA 71:10">wɔn a wɔtwɛn sɛ wɔbɛkum me no bom pam me tiri so.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Wɔka sɛ, “Onyankopɔn agya no mu;</para>
  <para style="q2" vid="PSA 71:11">momma yɛnti no na yɛnkyere no,</para>
  <para style="q2" vid="PSA 71:11">na obiara nni hɔ a ɔbɛgye no.”<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>Ao Onyankopɔn, mfiri me nkyɛn nkɔ akyiri;</para>
  <para style="q2" vid="PSA 71:12">Ao me Onyankopɔn, yɛ ntɛm bɛboa me.<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Ma wɔn a wɔbɔ me soboɔ no nsɛe animguaseɛ mu;</para>
  <para style="q2" vid="PSA 71:13">wɔn a wɔpɛ sɛ wɔpira me no</para>
  <para style="q2" vid="PSA 71:13">ma ahohora ne animguaseɛ nkata wɔn so.<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Nanso me deɛ, mɛnya anidasoɔ daa;</para>
  <para style="q2" vid="PSA 71:14">mɛkɔ so makamfo wo.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Mɛka wo tenenee ho asɛm,</para>
  <para style="q2" vid="PSA 71:15">ne wo nkwagyeɛ da mu nyinaa,</para>
  <para style="q2" vid="PSA 71:15">nanso mennim ano.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Ao Otumfoɔ <char style="nd">Awurade</char>, mɛba abɛpae mu aka wo nnwuma akɛseɛ no;</para>
  <para style="q2" vid="PSA 71:16">mɛpae mu aka wo nko ara tenenee akyerɛ.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>Ao Onyankopɔn, ɛfiri mʼababunu berɛ na wokyerɛkyerɛɛ me,</para>
  <para style="q2" vid="PSA 71:17">na ɛbɛsi ɛnnɛ yi, meka wʼanwanwadeɛ a woayɛ kyerɛ.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Mpo sɛ mebɔ akɔkoraa na mefu dwono a,</para>
  <para style="q2" vid="PSA 71:18">Ao Onyankopɔn, nnya me,</para>
  <para style="q1" vid="PSA 71:18">kɔsi sɛ mɛka wo tumi ho asɛm akyerɛ nkyirimma,</para>
  <para style="q2" vid="PSA 71:18">ne wo kɛseyɛ akyerɛ wɔn a wɔbɛba nyinaa.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>Ao Onyankopɔn, wo tenenee duru sorosoro,</para>
  <para style="q2" vid="PSA 71:19">wo a woayɛ nneɛma akɛseɛ.</para>
  <para style="q2" vid="PSA 71:19">Ao Onyankopɔn, hwan na ɔte sɛ wo?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Mmom woama mahunu ɔhaw bebree a ɛyɛ yea;</para>
  <para style="q2" vid="PSA 71:20">nanso wobɛma me nkwa bio;</para>
  <para style="q1" vid="PSA 71:20">na wobɛyi me bio</para>
  <para style="q2" vid="PSA 71:20">afiri asase ase.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Wobɛhyɛ me animuonyam bebree</para>
  <para style="q2" vid="PSA 71:21">na woakyekye me werɛ bio.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Mede sankuo bɛkamfo wo</para>
  <para style="q2" vid="PSA 71:22">Ao me Onyankopɔn, wo tenenee enti</para>
  <para style="q1" vid="PSA 71:22">mɛto wʼayɛyi dwom wɔ sankuten so</para>
  <para style="q2" vid="PSA 71:22">Ao Israel Kronkronni.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Mʼanofafa de anigyeɛ bɛteam</para>
  <para style="q2" vid="PSA 71:23">ɛberɛ a meto dwom kamfo woɔ,</para>
  <para style="q2" vid="PSA 71:23">me a woagye me no.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Me tɛkrɛma bɛka wo tenenee nnwuma</para>
  <para style="q2" vid="PSA 71:24">da mu nyinaa,</para>
  <para style="q1" vid="PSA 71:24">ɛfiri sɛ wɔn a wɔpɛ sɛ wɔha me no</para>
  <para style="q2" vid="PSA 71:24">kɔ animguaseɛ ne basabasayɛ mu.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">Dwom 72</para>
  <para style="d">Salomo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>Ao Onyankopɔn, fa wʼatɛntenenee ma ɔhene no,</para>
  <para style="q2" vid="PSA 72:1">na fa wo tenenee ma ɔhene babarima.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Ɔde tenenee bɛbu wo nkurɔfoɔ atɛn,</para>
  <para style="q2" vid="PSA 72:2">ɔbɛbu wo nkurɔfoɔ a wɔrehunu amane no atɛntenenee.<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Mmepɔ no de yiedie bɛbrɛ nnipa no,</para>
  <para style="q2" vid="PSA 72:3">nkokoɔ no de tenenee bɛba.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Ɔbɛko ama nnipa no mu amanehunufoɔ</para>
  <para style="q2" vid="PSA 72:4">na woagye wɔn a wɔnni bie mma nkwa;</para>
  <para style="q2" vid="PSA 72:4">ɔbɛdwerɛ nhyɛsofoɔ.<verse eid="PSA 72:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Owia ne ɔsrane da so wɔ hɔ yi</para>
  <para style="q2" vid="PSA 72:5">wɔbɛsuro wo awoɔ ntoatoasoɔ nyinaa mu.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Ɔbɛyɛ sɛ osuo a ɛtɔ gu asase a wɔadɔ soɔ so,</para>
  <para style="q2" vid="PSA 72:6">te sɛ obosuo a ɛgugu asase so.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Teneneefoɔ bɛnyini frɔmfrɔm wɔ ne berɛ so;</para>
  <para style="q2" vid="PSA 72:7">yiedie bɛbu so kɔsi da a ɔsrane nni hɔ bio.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Ɔbɛdi ɔhene afiri ɛpo akɔsi ɛpo</para>
  <para style="q2" vid="PSA 72:8">afiri Asubɔnten Efrata akɔsi asase ano.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Ɛserɛ so mmusua bɛkoto nʼanim</para>
  <para style="q2" vid="PSA 72:9">na nʼatamfoɔ adi mfuturo.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Tarsis ne mpoano ahemfo a wɔwɔ akyirikyiri</para>
  <para style="q2" vid="PSA 72:10">de apeatoɔ bɛbrɛ no;</para>
  <para style="q1" vid="PSA 72:10">Saba ne Seba ahemfo</para>
  <para style="q2" vid="PSA 72:10">de ayɛyɛdeɛ bɛbrɛ no.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Ahemfo nyinaa bɛkoto no</para>
  <para style="q2" vid="PSA 72:11">amanaman nyinaa bɛsom no.<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Na ɔbɛgye mmɔborɔfoɔ a wɔsu frɛ no,</para>
  <para style="q2" vid="PSA 72:12">ne amanehunufoɔ a wɔnni ɔboafoɔ.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Ɔbɛhunu wɔn a wɔayɛ mmrɛ ne ahiafoɔ mmɔbɔ</para>
  <para style="q2" vid="PSA 72:13">na wagye ahiafoɔ nkwa.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Ɔbɛgye wɔn afiri nhyɛsoɔ ne akakabensɛm mu,</para>
  <para style="q2" vid="PSA 72:14">ɛfiri sɛ wɔn mogya som bo wɔ nʼanim.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Ɔhene nkwa so!</para>
  <para style="q2" vid="PSA 72:15">Ma wɔmfa sikakɔkɔɔ mfiri Seba mmrɛ no.</para>
  <para style="q1" vid="PSA 72:15">Ma nnipa mmɔ mpaeɛ mma no</para>
  <para style="q2" vid="PSA 72:15">na wɔnhyira no da mu nyinaa.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Aburoo mmu so wɔ asase no so nyinaa;</para>
  <para style="q2" vid="PSA 72:16">nnuane mmu so wɔ nkokoɔ so,</para>
  <para style="q2" vid="PSA 72:16">ma nʼaba mmɔ sɛ Lebanon;</para>
  <para style="q1" vid="PSA 72:16">na ɛnyini sɛ mfuo so serɛ.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Ne din bɛtena hɔ daa;</para>
  <para style="q2" vid="PSA 72:17">ɛntena hɔ nkyɛre sɛ owia.</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">Wɔbɛfa ne so ahyira amanaman no,</para>
  <para style="q2" vid="PSA 72:17">na wɔbɛfrɛ no nhyira.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Nhyira nka <char style="nd">Awurade</char> Onyankopɔn, Israel Onyankopɔn!</para>
  <para style="q2" vid="PSA 72:18">Ɔno nko ara na ɔyɛ anwanwadeɛ.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Nhyira nka ne din a animuonyam ahyɛ no ma no daa daa.</para>
  <para style="q2" vid="PSA 72:19">Ma nʼanimuonyam nhyɛ ewiase nyinaa ma.</para>
  <para style="qc" vid="PSA 72:19">Amen! Amen!<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Yisai ba Dawid mpaeɛbɔ no awieeɛ nie.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">NWOMA A ƐTƆ SO MMIƐNSA</para>
  <para style="mr">
    <ref loc="PSA 73-89">Nnwom 73–89</ref></para>
  <para style="cl">Dwom 73</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>Ampa ara Onyankopɔn yɛ ma Israel,</para>
  <para style="q2" vid="PSA 73:1">ɔyɛ ma wɔn a wɔn akoma mu teɛ.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Nanso me deɛ, anka me nan reyɛ awatiri;</para>
  <para style="q2" vid="PSA 73:2">anka merehwere me nnyinasoɔ,<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>ɛfiri sɛ, mʼani beree ahantanfoɔ</para>
  <para style="q2" vid="PSA 73:3">ɛberɛ a mehunuu amumuyɛfoɔ yiedie no.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Wɔnhunuu ahokyere da;</para>
  <para style="q2" vid="PSA 73:4">na wɔwɔ ahoɔden ne apɔmuden.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Dadwene a ɛtaa ba nnipa soɔ biara nna wɔn so;</para>
  <para style="q2" vid="PSA 73:5">ɔdasani haw biara nna wɔn so.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Enti, ahantan yɛ wɔn kɔnmuadeɛ,</para>
  <para style="q2" vid="PSA 73:6">na wɔde akakabensɛm afira.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Wɔn akoma a apirim no mu na nnebɔne firie;</para>
  <para style="q2" vid="PSA 73:7">na wɔn amumuyɛ adwene nni mma ɔka.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Wɔsere afoforɔ na wɔka wɔn ho nsɛm a ɛnyɛ;</para>
  <para style="q2" vid="PSA 73:8">wɔde nhyɛsoɔ hunahuna afoforɔ wɔ ahomasoɔ mu.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Wɔn ano ka ɔsoro nsɛm,</para>
  <para style="q2" vid="PSA 73:9">na wɔn tɛkrɛma agye asase afa.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Ɛno enti wɔn nkurɔfoɔ kɔ wɔn nkyɛn</para>
  <para style="q2" vid="PSA 73:10">na wonya nsuo bebree nom.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Wɔbisa sɛ, “Ɛbɛyɛ dɛn na Onyankopɔn ahunu?</para>
  <para style="q2" vid="PSA 73:11">Na Ɔsorosoroni no wɔ nhunumu anaa?”<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Sei na amumuyɛfoɔ no teɛ,</para>
  <para style="q2" vid="PSA 73:12">hwee mfa wɔn ho, na wɔkɔ so pɛ ahonyadeɛ.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Ampa ara, mʼakoma a ɛho teɛ no, mannya hwee amfiri mu;</para>
  <para style="q2" vid="PSA 73:13">me nsa a ɛnni fɔ no ayɛ kwa.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Ɛda mu nyinaa mehunu amane;</para>
  <para style="q2" vid="PSA 73:14">anɔpa biara wɔtwe mʼaso.<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Sɛ mekaa sɛ, “Mɛkasa saa” a,</para>
  <para style="q2" vid="PSA 73:15">anka medii wo mma no hwammɔ.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Mebɔɔ mmɔden sɛ mɛte yeinom nyinaa ase,</para>
  <para style="q2" vid="PSA 73:16">nanso na ɛhyɛ me so<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>kɔsii sɛ mekɔɔ Onyankopɔn kronkronbea hɔ;</para>
  <para style="q2" vid="PSA 73:17">ɛhɔ na metee deɛ ɛbɛba wɔn so awieeɛ no ase.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Ampa ara wode wɔn gu baabi a ɛhɔ yɛ toro.</para>
  <para style="q2" vid="PSA 73:18">Wode wɔn hwe fam sɛe wɔn pasaa.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Sɛdeɛ wɔsɛe prɛko pɛ,</para>
  <para style="q2" vid="PSA 73:19">na ehu hwim wɔn kɔ no,<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>ɛte sɛ daeɛso, ɛberɛ a onipa anyaneɛ,</para>
  <para style="q2" vid="PSA 73:20">Ao <char style="nd">Awurade</char>, sɛ wokanyane wo ho a,</para>
  <para style="q2" vid="PSA 73:20">wobɛbu wʼani agu wɔn so sɛ biribi a ɛnni hɔ.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Ɛberɛ a awerɛhoɔ hyɛɛ mʼakoma mu</para>
  <para style="q2" vid="PSA 73:21">na me sunsum dii yea no,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>meyɛɛ sɛ obi a ɔnnim hwee na ɔnni adwene;</para>
  <para style="q2" vid="PSA 73:22">meyɛɛ sɛ aboa gyimifoɔ wɔ wʼanim.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Nanso, na mene wowɔ hɔ ɛberɛ biara;</para>
  <para style="q2" vid="PSA 73:23">na wode wo nsa nifa asɔ me mu.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Wode wʼafotuo kyerɛ me ɛkwan;</para>
  <para style="q2" vid="PSA 73:24">na akyire no, wode me bɛkɔ animuonyam mu.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>Hwan na mewɔ wɔ soro ka wo ho?</para>
  <para style="q2" vid="PSA 73:25">Na biribiara nni asase so a mepɛ ka wo ho.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Me honam, ne mʼakoma bɛdi me hwammɔ,</para>
  <para style="q2" vid="PSA 73:26">nanso Onyankopɔn ne mʼakoma ahoɔden</para>
  <para style="q2" vid="PSA 73:26">ne me kyɛfa daa nyinaa.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Wɔn a wɔmmɛn wo no bɛyera.</para>
  <para style="q2" vid="PSA 73:27">Wosɛe wɔn a wɔnni wo nokorɛ nyinaa.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Nanso, me deɛ, menim sɛ ɛyɛ sɛ wɔbɛbɛn Onyankopɔn.</para>
  <para style="q2" vid="PSA 73:28">Mede Otumfoɔ <char style="nd">Awurade</char> ayɛ me hintabea;</para>
  <para style="q2" vid="PSA 73:28">mɛka wo nneyɛɛ nyinaa akyerɛ.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">Dwom 74</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>Ao Onyankopɔn, adɛn enti na woapo yɛn koraa yi?</para>
  <para style="q2" vid="PSA 74:1">Adɛn enti na wʼabofuo hye wʼadidibea nnwan?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Kae nkurɔfoɔ a wotɔɔ wɔn teteete no,</para>
  <para style="q2" vid="PSA 74:2">abusua a ɛyɛ wʼagyapadeɛ a wogyee wɔn no,</para>
  <para style="q2" vid="PSA 74:2">Bepɔ Sion, baabi a woteɛ hɔ.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Dane wo ho kyerɛ mmubuiɛ a ɛda so wɔ hɔ yi so,</para>
  <para style="q2" vid="PSA 74:3">saa ɔsɛeɛ a ɔtamfoɔ no de abrɛ wo kronkronbea no.<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Wʼatamfoɔ bobɔɔ mu wɔ baabi a wohyiaa yɛn no;</para>
  <para style="q2" vid="PSA 74:4">wɔasisi wɔn mfrankaa sɛ agyiraeɛhyɛdeɛ wɔ hɔ.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Wɔyɛɛ wɔn sɛ nnipa a wɔrehwim mmonnua</para>
  <para style="q2" vid="PSA 74:5">de abubu nnua a ayɛ nkyɛkyerɛ.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Wɔde wɔn mmonnua ne nname</para>
  <para style="q2" vid="PSA 74:6">bubuu nnua a wɔasene adi ho adwinneɛ no.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Wɔhyee wo kronkronbea no dwerɛbee;</para>
  <para style="q2" vid="PSA 74:7">wɔguu baabi a wo Din teɛ no ho fi.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Wɔkaa wɔ wɔn akoma mu sɛ, “Yɛbɛtiatia wɔn so ayɛ wɔn pasaa!”</para>
  <para style="q2" vid="PSA 74:8">Wɔhyee baabiara a wɔsom Onyankopɔn wɔ asase no so.<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Yɛnhunu wo nsɛnkyerɛnneɛ a ɛyɛ nwanwa biara bio;</para>
  <para style="q2" vid="PSA 74:9">adiyifoɔ no nyinaa asa,</para>
  <para style="q2" vid="PSA 74:9">na yɛn mu biara nnim nna dodoɔ a ɛbɛdie.<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>Ao Onyankopɔn, wʼatamfoɔ bɛsere wo akɔsi da bɛn?</para>
  <para style="q2" vid="PSA 74:10">Wɔn a wɔkyiri woɔ no bɛgu wo din ho fi daa anaa?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Adɛn enti na woatwe wo nsa, wo nsa nifa no?</para>
  <para style="q2" vid="PSA 74:11">Yi firi wʼatadeɛ mmobɔeɛ no mu na sɛe wɔn.<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Nanso, Ao Onyankopɔn, woyɛ me ɔhene firi tete;</para>
  <para style="q2" vid="PSA 74:12">wode nkwagyeɛ ba asase so.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>Ɛyɛ wo na wode wo tumi paee ɛpo mu no;</para>
  <para style="q2" vid="PSA 74:13">wopɛkyɛɛ nsuo mu ɔtweaseɛ no ti.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>Wopɛkyɛɛ Lewiatan no ti</para>
  <para style="q2" vid="PSA 74:14">na wode no maa ɛserɛ so abɔdeɛ sɛ wɔn aduane.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Wo na womaa nsuwa ne nsutire tueeɛ;</para>
  <para style="q2" vid="PSA 74:15">na womaa nsubɔntene a ɛtene weweeɛ.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Adekyeeɛ wɔ wo na adesaeɛ nso yɛ wo dea;</para>
  <para style="q2" vid="PSA 74:16">wode owia ne ɔsrane sisii hɔ.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Ɛyɛ wo na wototoo asase so ahyeɛ nyinaa;</para>
  <para style="q2" vid="PSA 74:17">wobɔɔ ahuhuro ne awɔ mmerɛ.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>Ao <char style="nd">Awurade</char>, kae sɛdeɛ ɔtamfoɔ no sere woɔ,</para>
  <para style="q2" vid="PSA 74:18">sɛdeɛ nkwaseafoɔ agu wo din ho fi.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Mfa wʼaborɔnoma nkwa mma nkekaboa;</para>
  <para style="q2" vid="PSA 74:19">mma wo werɛ mfiri wo nkurɔfoɔ a wɔrehunu amane no nkwa afebɔɔ.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Ma wʼapam no ho nhia wo,</para>
  <para style="q2" vid="PSA 74:20">ɛfiri sɛ akakabensɛm ahyɛ asase no so sum ma.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Mma wɔn a wɔahyɛ wɔn soɔ no anim nngu ase;</para>
  <para style="q2" vid="PSA 74:21">ma ahiafoɔ ne mmɔborɔfoɔ nkamfo wo din.<verse eid="PSA 74:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>Ao Onyankopɔn, ma wo ho so na ka wo ara wʼasɛm;</para>
  <para style="q2" vid="PSA 74:22">kae sɛdeɛ nkwaseafoɔ sere wo da mu nyinaa.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Mmu wʼani ngu wɔn a wɔsɔre tia wo no nteateam so,</para>
  <para style="q2" vid="PSA 74:23">wʼatamfoɔ gyegyeegye a ɛkɔ soro daa no.</para>
  <para style="d" vid="PSA 74:23">Wɔde ma dwomkyerɛfoɔ no. Wɔnto no sɛdeɛ wɔto “Nsɛe No” nne so.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">Dwom 75</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>Ao Onyankopɔn, yɛda wo ase,</para>
  <para style="q2" vid="PSA 75:1">yɛda wo ase, ɛfiri sɛ wo Din abɛn;</para>
  <para style="q2" vid="PSA 75:1">nnipa ka wʼanwanwadeɛ kyerɛ.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Woka sɛ, “Me na mehyɛɛ ɛberɛ a ɛsɛ no;</para>
  <para style="q2" vid="PSA 75:2">ɛyɛ me na mebu atɛntenenee.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Sɛ asase ne ɛso nnipa nyinaa woso a,</para>
  <para style="q2" vid="PSA 75:3">me na mema nʼafadum gyina hɔ pintinn.<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Meka kyerɛ ahantanfoɔ sɛ, ‘Monnhoahoa mo ho bio,’</para>
  <para style="q2" vid="PSA 75:4">na meka kyerɛ amumuyɛfoɔ nso sɛ, ‘Mommma mo mmɛn so.<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>Mommma mo mmɛn so ntia ɔsoro;</para>
  <para style="q2" vid="PSA 75:5">mommfa animtiabuo nkasa.’ ”<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Obiara mmfiri apueeɛ anaa atɔeɛ</para>
  <para style="q2" vid="PSA 75:6">anaa ɛserɛ no so a ɔbɛtumi ama obi so.<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>Ɛyɛ Onyankopɔn na ɔbu atɛn:</para>
  <para style="q2" vid="PSA 75:7">Ɔbrɛ ɔbaako ase, na ɔma ɔfoforɔ so.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Kuruwa bi hyɛ <char style="nd">Awurade</char> nsam</para>
  <para style="q2" vid="PSA 75:8">nsã bi a ɛtwa ahuro a wɔde nnuhwam afra ahyɛ no ma;</para>
  <para style="q1" vid="PSA 75:8">ɔhwie, na asase so amumuyɛfoɔ nyinaa</para>
  <para style="q2" vid="PSA 75:8">nom ma ɛka aseɛ puo.<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Me deɛ, mɛpae mu aka yei daa daa;</para>
  <para style="q2" vid="PSA 75:9">mɛto ayɛyi dwom ama Yakob Onyankopɔn.<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>Mɛbubu amumuyɛfoɔ nyinaa mmɛn,</para>
  <para style="q2" vid="PSA 75:10">nanso mɛma ateneneefoɔ ahoɔden foforɔ.</para>
  <para style="d" vid="PSA 75:10">Wɔde ma dwomkyerɛfoɔ. Wɔde sankuo na ɛtoɔ.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">Dwom 76</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>Wɔnim Onyankopɔn wɔ Yuda;</para>
  <para style="q2" vid="PSA 76:1">ne din so wɔ Israel.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Ne ntomadan si Salem,</para>
  <para style="q2" vid="PSA 76:2">ne tenaberɛ wɔ Sion.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Ɛhɔ na ɔbubuu mmemma a ɛte ogya,</para>
  <para style="q2" vid="PSA 76:3">ɛkyɛm ne akofena, akodeɛ nyinaa mu.<verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Wo ho hann no hyerɛn,</para>
  <para style="q2" vid="PSA 76:4">na wo so sene mmepɔ a mmoadoma ahyɛ mu ma no.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Mmarima akokoɔdurufoɔ deda hɔ a wɔagye wɔn ho nneɛma,</para>
  <para style="q2" vid="PSA 76:5">wɔadeda awufoɔ nna;</para>
  <para style="q1" vid="PSA 76:5">na akofoɔ no mu baako mpo</para>
  <para style="q2" vid="PSA 76:5">ntumi mpagya ne nsa.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Ao Yakob Onyankopɔn, wokaa wɔn anim no</para>
  <para style="q2" vid="PSA 76:6">apɔnkɔ no ne nteaseɛnam no adeda dinn.<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>Wo nko ara na ɛsɛ sɛ wɔsuro woɔ.</para>
  <para style="q2" vid="PSA 76:7">Sɛ wo bo fu a, hwan na ɔbɛtumi agyina wʼanim?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Wobuu atɛn firii soro,</para>
  <para style="q2" vid="PSA 76:8">asase suroeɛ na ɛyɛɛ dinn,<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>ɛberɛ a wosɔre buu atɛn, Ao Onyankopɔn,</para>
  <para style="q2" vid="PSA 76:9">de gyee amanehunufoɔ wɔ asase no so.<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Ampa ara wʼabufuhyeɛ a ɛtia nnipa no de ayɛyie brɛ wo,</para>
  <para style="q2" vid="PSA 76:10">na wɔn a wɔtumi gyina ano no nya kɔkɔbɔ.<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>Monhyɛ <char style="nd">Awurade</char> mo Onyankopɔn no bɔ na monni so;</para>
  <para style="q2" vid="PSA 76:11">momma nsase a atwa ne ho ahyia</para>
  <para style="q2" vid="PSA 76:11">mfa ayɛyɛdeɛ mmrɛ Ɔbaako a ɛsɛ sɛ wɔsuro noɔ no.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Ɔbrɛ sodifoɔ honhom ase;</para>
  <para style="q2" vid="PSA 76:12">na asase so ahemfo suro no.</para>
  <para style="d" vid="PSA 76:12">Wɔde ma dwomkyerɛfoɔ. Wɔde ma Yedutun.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">Dwom 77</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>Mesu mefrɛɛ Onyankopɔn srɛɛ mmoa;</para>
  <para style="q2" vid="PSA 77:1">mesu mefrɛɛ no sɛ ɔntie me.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Ɛberɛ a mewɔ ahohiahia mu no, mehwehwɛɛ Awurade;</para>
  <para style="q2" vid="PSA 77:2">metrɛɛ me nsa a ɛmpa aba mu anadwo</para>
  <para style="q2" vid="PSA 77:2">na me kra ampene sɛ wɔbɛkyekye ne werɛ.<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>Ao Onyankopɔn mekaee wo, na mesii apinie;</para>
  <para style="q2" vid="PSA 77:3">medwendweneeɛ, na me honhom tɔɔ piti.<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Woamma mʼani ankum;</para>
  <para style="q2" vid="PSA 77:4">amanehunu dodoɔ enti, mantumi ankasa.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Medwenee nna a atwam no ho,</para>
  <para style="q2" vid="PSA 77:5">teteete mfeɛ no ho;<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>mekaee me nnwom a na meto no anadwo.</para>
  <para style="q2" vid="PSA 77:6">Mʼakoma dwenee ho na me honhom bisaa sɛ:<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“Enti, <char style="nd">Awurade</char> bɛpo yɛn daa?</para>
  <para style="q2" vid="PSA 77:7">Ɔrenhunu yɛn mmɔbɔ bio anaa?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Nʼadɔeɛ a ɛnsa da atu ayera koraa anaa?</para>
  <para style="q2" vid="PSA 77:8">Na ne bɔhyɛ no, amma mu koraa anaa?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Onyankopɔn werɛ afiri sɛ ɔbɛyɛ mmɔborɔhunufoɔ anaa?</para>
  <para style="q2" vid="PSA 77:9">Abufuo enti ne yam nhyehye no bio anaa?”<verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Afei, medwenee sɛ, “Onyankopɔn Ɔsorosoroni,</para>
  <para style="q2" vid="PSA 77:10">deɛ ɛhyɛ me kra so ne sɛ, wommfa wo tete nsa nifa no mmoa yɛn bio.”<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Mɛkae nneɛma a <char style="nd">Awurade</char> ayɛ;</para>
  <para style="q2" vid="PSA 77:11">aane, mɛkae wʼanwanwadeɛ a woyɛɛ tete no.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Mɛdwene wo nnwuma nyinaa ho</para>
  <para style="q2" vid="PSA 77:12">na masusu wo nneyɛɛ akɛseɛ nyinaa ho.<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Ao Onyankopɔn, wʼakwan yɛ kronn.</para>
  <para style="q2" vid="PSA 77:13">Onyame bɛn na ɔso sɛ yɛn Onyankopɔn?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Wone Onyankopɔn a woyɛ anwanwadeɛ;</para>
  <para style="q2" vid="PSA 77:14">wokyerɛ wo tumi wɔ aman mu.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Wode wo tumi nsa no gyee wo nkurɔfoɔ,</para>
  <para style="q2" vid="PSA 77:15">Yakob ne Yosef asefoɔ no.<verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>Ao Onyankopɔn, nsuo no hunuu wo,</para>
  <para style="q2" vid="PSA 77:16">nsuo no hunuu wo na wɔpopoeɛ;</para>
  <para style="q2" vid="PSA 77:16">ebunu no mpo ho wosoeɛ.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>Omununkum tɔɔ nsuo,</para>
  <para style="q2" vid="PSA 77:17">aprannaa gyegyee wɔ soro;</para>
  <para style="q2" vid="PSA 77:17">na wo bɛmma twaa ogya dii akɔneaba.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Wʼaprannaa boboom wɔ twahoframa no mu,</para>
  <para style="q2" vid="PSA 77:18">wʼanyinam hyerɛn ewiase;</para>
  <para style="q2" vid="PSA 77:18">asase popoeɛ na ɛwosoeɛ.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Wode wo kwan faa ɛpo mu,</para>
  <para style="q2" vid="PSA 77:19">wode faa nsuo kɛseɛ mu,</para>
  <para style="q2" vid="PSA 77:19">nanso wɔanhunu wʼanammɔn.<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Wonam Mose ne Aaron so</para>
  <para style="q2" vid="PSA 77:20">dii wo nkurɔfoɔ anim sɛ nnwankuo.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">Dwom 78</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>Ao me nkurɔfoɔ, montie me nkyerɛkyerɛ;</para>
  <para style="q2" vid="PSA 78:1">monyɛ aso mma mʼanomu nsɛm.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Mɛkasa wɔ abɛbuo mu,</para>
  <para style="q2" vid="PSA 78:2">mɛka ahintasɛm, teteete nneɛma no,<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>nneɛma a yɛate na yɛahunu;</para>
  <para style="q2" vid="PSA 78:3">nneɛma a yɛn agyanom aka ho asɛm akyerɛ yɛn.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Yɛremfa nkame wɔn mma;</para>
  <para style="q2" vid="PSA 78:4">yɛbɛka akyerɛ nkyirimma;</para>
  <para style="q1" vid="PSA 78:4">
    <char style="nd">Awurade</char> nneyɛɛ a ɛfata nkamfo no,</para>
  <para style="q2" vid="PSA 78:4">ne tumi ne anwanwadeɛ a wayɛ no.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Ɔyɛɛ ahyɛdeɛ maa Yakob</para>
  <para style="q2" vid="PSA 78:5">na ɔyɛɛ mmara wɔ Israel,</para>
  <para style="q1" vid="PSA 78:5">deɛ ɔhyɛɛ yɛn nananom</para>
  <para style="q2" vid="PSA 78:5">sɛ wɔnkyerɛ wɔn mma,<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>sɛdeɛ ɛbɛyɛ a, nkyirimma bɛsua</para>
  <para style="q2" vid="PSA 78:6">mpo mmɔfra a wɔnnya nwoo wɔn,</para>
  <para style="q2" vid="PSA 78:6">na wɔn nso akyerɛkyerɛ wɔn mma.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>Afei wɔde wɔn ho bɛto Onyankopɔn so,</para>
  <para style="q2" vid="PSA 78:7">na wɔn werɛ remfiri ne nneyɛɛ,</para>
  <para style="q2" vid="PSA 78:7">na wɔbɛdi nʼahyɛdeɛ so.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Wɔrenyɛ sɛ wɔn nananom,</para>
  <para style="q2" vid="PSA 78:8">a na wɔyɛ asoɔdenfoɔ ne atuatefoɔ,</para>
  <para style="q1" vid="PSA 78:8">wɔn a wɔn akoma mu wɔnni Onyankopɔn nokorɛ</para>
  <para style="q2" vid="PSA 78:8">na woyɛ honhom mu atorofoɔ ma noɔ no.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Ɛwom sɛ na Efraim mmarima kurakura agyan,</para>
  <para style="q2" vid="PSA 78:9">nanso ɔko da no, wɔdwaneeɛ;<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Wɔanni Onyankopɔn apam no so</para>
  <para style="q2" vid="PSA 78:10">wɔampɛ sɛ wɔdi ne mmara no so.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Wɔn werɛ firii deɛ wayɛ,</para>
  <para style="q2" vid="PSA 78:11">anwanwadeɛ a wayɛ akyerɛ wɔn no.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>Ɔyɛɛ anwanwadeɛ wɔ wɔn nananom anim</para>
  <para style="q2" vid="PSA 78:12">wɔ Soan mantam a ɛwɔ Misraim asase so.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Ɔkyɛɛ ɛpo mu na ɔde wɔn faa mu.</para>
  <para style="q2" vid="PSA 78:13">Ɔmaa nsuo no gyinaa sɛ afasuo.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>Ɔde omununkum dii wɔn anim awia</para>
  <para style="q2" vid="PSA 78:14">na ɔde ogyadum dii wɔn anim anadwo nyinaa.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>Ɔpaee ɔbotan mu wɔ ɛserɛ so,</para>
  <para style="q2" vid="PSA 78:15">na ɔmaa wɔn nsuo a ɛdɔɔso sɛ ɛpo;<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Ɔmaa asutire firii abotan mu</para>
  <para style="q2" vid="PSA 78:16">na ɔmaa nsuo tenee sɛ nsubɔntene.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Nanso, wɔkɔɔ so yɛɛ bɔne tiaa no,</para>
  <para style="q2" vid="PSA 78:17">wɔsɔre tiaa Ɔsorosoroni no wɔ ɛserɛ no so.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Wɔboapa sɔɔ Onyankopɔn hwɛeɛ;</para>
  <para style="q2" vid="PSA 78:18">wɔbisaa aduane a wɔpɛ.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Wɔkasa tiaa Onyankopɔn sɛ,</para>
  <para style="q2" vid="PSA 78:19">“Onyankopɔn bɛtumi ato ɛpono wɔ ɛserɛ so anaa?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Ɔde adeɛ bɔɔ ɔbotan mu no, nsuo to firi mu baeɛ,</para>
  <para style="q2" vid="PSA 78:20">na nsuwa bebree tenee hɔ.</para>
  <para style="q1" vid="PSA 78:20">Na ɔbɛtumi ama yɛn aduane nso?</para>
  <para style="q2" vid="PSA 78:20">Ɔbɛtumi ama ne nkurɔfoɔ ɛnam anaa?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Ɛberɛ a <char style="nd">Awurade</char> tee deɛ wɔreka no, ne bo fuu yie;</para>
  <para style="q2" vid="PSA 78:21">ne ogya bɛguu Yakob so,</para>
  <para style="q2" vid="PSA 78:21">na nʼabufuhyeɛ sɔre tiaa Israel,<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>ɛfiri sɛ, na wɔnni Onyankopɔn mu gyidie</para>
  <para style="q2" vid="PSA 78:22">anaasɛ ne nkwagyeɛ mu ahotosoɔ.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Nanso, ɔkasa kyerɛɛ ɔsoro ɔhyɛ so;</para>
  <para style="q2" vid="PSA 78:23">na ɔbuee ɔsorosoro apono.<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>Ɔtɔɔ mana firi soro maa nnipa no sɛ wonni,</para>
  <para style="q2" vid="PSA 78:24">ɔmaa wɔn ɔsoro aduane.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Nnipa dii abɔfoɔ aduane;</para>
  <para style="q2" vid="PSA 78:25">ɔmaa wɔn aduane a wɔbɛtumi adi nyinaa.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Ɔmaa apueeɛ mframa bɔ firii sorosoro,</para>
  <para style="q2" vid="PSA 78:26">na ɔde ne tumi bɔɔ atɔeɛ mframa.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Ɔtoo ɛnam sɛ mfuturo guu wɔn so,</para>
  <para style="q2" vid="PSA 78:27">nnomaa a wɔtu bebree sɛ mpoano anwea.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Ɔma wɔbaa fam kɔɔ wɔn atenaeɛ,</para>
  <para style="q2" vid="PSA 78:28">ne wɔn ntomadan ho nyinaa.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Wɔdidi maa aduane no boroo wɔn so</para>
  <para style="q2" vid="PSA 78:29">ɛfiri sɛ ɔmaa wɔn deɛ wɔhwehwɛ.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Nanso ansa na wɔbɛfiri aduane a wɔhwehwɛeɛ no ho,</para>
  <para style="q2" vid="PSA 78:30">ɛberɛ a ɛhyehyɛ wɔn anomu mpo no,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>Onyankopɔn abufuo sɔree wɔn so;</para>
  <para style="q2" vid="PSA 78:31">ɔkum ahoɔdenfoɔ a wɔwɔ wɔn mu</para>
  <para style="q2" vid="PSA 78:31">twitwaa Israel mmeranteɛ guiɛ.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>Yeinom nyinaa akyi, wɔkɔɔ so yɛɛ bɔne;</para>
  <para style="q2" vid="PSA 78:32">nʼanwanwadeɛ akyi no, wɔannye anni.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Enti, ɔtwaa wɔn nna so te sɛ ahuro</para>
  <para style="q2" vid="PSA 78:33">yɛɛ wɔn mfeɛ awieeɛ huhuuhu.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Ɛberɛ biara a Onyankopɔn bɛkum wɔn no, wɔhwehwɛɛ no,</para>
  <para style="q2" vid="PSA 78:34">na wɔpere wɔn ho sane baa ne nkyɛn.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Wɔkaee sɛ Onyankopɔn yɛ wɔn botan,</para>
  <para style="q2" vid="PSA 78:35">sɛ Ɔsorosoro Onyankopɔn no yɛ wɔn Gyefoɔ.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Nanso, wɔde wɔn ano bɛdaadaa no,</para>
  <para style="q2" vid="PSA 78:36">na wɔde wɔn tɛkrɛma twaa atorɔ kyerɛɛ no;<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>wɔn akoma anni no nokorɛ,</para>
  <para style="q2" vid="PSA 78:37">na wɔanni nʼapam no so.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Nanso na ɔyɛ ahummɔborɔ;</para>
  <para style="q2" vid="PSA 78:38">ɔde wɔn amumuyɛ kyɛɛ wɔn</para>
  <para style="q2" vid="PSA 78:38">a wansɛe wɔn.</para>
  <para style="q1" vid="PSA 78:38">Mpɛn bebree ɔtwentwɛnee nʼabufuo so</para>
  <para style="q2" vid="PSA 78:38">na wanhwie nʼabufuhyeɛ nyinaa.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Ɔkaee sɛ wɔyɛ ɔhonam ara kwa,</para>
  <para style="q2" vid="PSA 78:39">mframa bi a ɛbɔ twam na ɛnsane nʼakyi.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Mpɛn ahe na wɔansɔre antia no wɔ ɛserɛ no so hɔ,</para>
  <para style="q2" vid="PSA 78:40">na mpɛn ahe na wɔamma ne werɛ anho wɔ asase wesee no so?<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Wɔsɔɔ Onyankopɔn hwɛeɛ ɛberɛ biara;</para>
  <para style="q2" vid="PSA 78:41">na wɔyii Israel Ɔkronkronni no abufuo.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Wɔn werɛ firii ne tumi no,</para>
  <para style="q2" vid="PSA 78:42">ɛda a ɔgyee wɔn firii wɔn nhyɛsofoɔ nsam no,<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>ɛda a ɔyɛɛ nsɛnkyerɛnneɛ nwanwasoɔ wɔ Misraim no</para>
  <para style="q2" vid="PSA 78:43">ne nʼanwanwadeɛ wɔ Soan mantam mu no.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>Ɔmaa wɔn nsubɔntene danee mogya;</para>
  <para style="q2" vid="PSA 78:44">wɔantumi annom wɔn asutene mu nsuo.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Ɔmaa nwansenadɔm baa wɔn so bɛhaa wɔn</para>
  <para style="q2" vid="PSA 78:45">na mponkyerɛne nso bɛsɛee wɔn asase.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Ɔmaa mmɛbɛ bɛdii wɔn mfuo so aduane</para>
  <para style="q2" vid="PSA 78:46">na ɔde wɔn mfudeɛ nso maa ntutummɛ.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Ɔde asukɔtweaa sɛee wɔn bobe</para>
  <para style="q2" vid="PSA 78:47">na ɔde nsukyeneeɛ sɛee wɔn ankye nnua.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Ɔde sukyerɛmma kumm wɔn anantwie</para>
  <para style="q2" vid="PSA 78:48">ɔde anyinam kumm wɔn nyɛmmoa.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Ɔhwiee nʼabufuhyeɛ guu wɔn so,</para>
  <para style="q2" vid="PSA 78:49">abufuo, anibereɛ ne ahohia;</para>
  <para style="q2" vid="PSA 78:49">abɔfoɔ asɛefoɔ kuo no.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Ɔbɔɔ ɛkwan maa nʼabufuo;</para>
  <para style="q2" vid="PSA 78:50">na wamfa wɔn nkwa ankyɛre wɔn</para>
  <para style="q2" vid="PSA 78:50">mmom ɔde wɔn maa ɔyaredɔm.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Ɔkunkumm Misraimfoɔ mmakan nyinaa,</para>
  <para style="q2" vid="PSA 78:51">Ham ntomadan mu nnipa mu abakan.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>Nanso ɔyii ne nkurɔfoɔ firii mu sɛ nnwankuo;</para>
  <para style="q2" vid="PSA 78:52">ɔdii wɔn anim sɛ nnwan wɔ ɛserɛ no so.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>Ɔdii wɔn anim dwoodwoo, enti wɔansuro;</para>
  <para style="q2" vid="PSA 78:53">nanso wɔn atamfoɔ deɛ, ɛpo asorɔkye bu faa wɔn so.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>Sei na ɔyɛ de wɔn baa nʼasase kronkron no ahyeɛ so,</para>
  <para style="q2" vid="PSA 78:54">bepɔ asase a ɔde ne nsa nifa gyeeɛ no.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Ɔpamoo amanaman a wɔwɔ wɔn anim no</para>
  <para style="q2" vid="PSA 78:55">na ɔkyekyɛɛ wɔn nsase no mu maa wɔn sɛ wɔn agyapadeɛ;</para>
  <para style="q2" vid="PSA 78:55">ɔbɔɔ Israel mmusuakuo no atenaseɛ wɔ wɔn afie mu.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Nanso wɔsɔɔ Onyankopɔn hwɛeɛ</para>
  <para style="q2" vid="PSA 78:56">na wɔsɔre tiaa Ɔsorosoroni no;</para>
  <para style="q2" vid="PSA 78:56">na wɔanni ne mmara so.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>Wɔyɛɛ sɛ wɔn agyanom, wɔanni nokorɛ na wɔannya gyidie,</para>
  <para style="q2" vid="PSA 78:57">ahotosoɔ nni wɔn mu, na wɔte sɛ agyan a asɛe.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Wɔde wɔn sorɔnsorɔmmea hyɛɛ no abufuo</para>
  <para style="q2" vid="PSA 78:58">na wɔn ahoni maa ne ninkuntwe mu yɛɛ den.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Onyankopɔn tee wɔn nka no, ne bo fuiɛ;</para>
  <para style="q2" vid="PSA 78:59">na ɔpoo Israel korakora.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Ɔgyaa nʼatenaeɛ a ɛwɔ Silo no hɔ</para>
  <para style="q2" vid="PSA 78:60">ntomadan a wasi wɔ nnipa mu no.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Ɔde Apam Adaka a ɛyɛ ne tumi no kɔɔ nnommumfa mu,</para>
  <para style="q2" vid="PSA 78:61">nʼanimuonyam kɔɔ atamfoɔ nsam.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Ɔde ne nkurɔfoɔ maa akofena;</para>
  <para style="q2" vid="PSA 78:62">ne bo fuu nʼagyapadeɛ yie.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Egya hyee wɔn mmeranteɛ kumm wɔn,</para>
  <para style="q2" vid="PSA 78:63">na wɔn mmabaawa annya ayeforɔhyia dwom anto;<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>Wɔn asɔfoɔ wuwuu akofena ano,</para>
  <para style="q2" vid="PSA 78:64">na wɔn akunafoɔ antumi ansu.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Afei Awurade sɔree sɛdeɛ ɔfiri nna mu no,</para>
  <para style="q2" vid="PSA 78:65">sɛdeɛ ɔbarima a waboro nsã nyane firi nnahɔɔ mu no.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Ɔbobɔɔ nʼatamfoɔ ma wɔdwane kɔɔ wɔn akyi;</para>
  <para style="q2" vid="PSA 78:66">ɔhyɛɛ wɔn aniwuo afebɔɔ.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Afei ɔpoo Yosef ntomadan no,</para>
  <para style="q2" vid="PSA 78:67">na wamfa Efraim abusuakuo no nso;<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>Na mmom, ɔfaa Yuda abusuakuo no,</para>
  <para style="q2" vid="PSA 78:68">Bepɔ Sion a ɔdɔ noɔ no.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Ɔsii ne kronkronbea te sɛ sorɔnsorɔmmea,</para>
  <para style="q2" vid="PSA 78:69">te sɛ asase a ɛtim hɔ daa.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Ɔyii ne ɔsomfoɔ Dawid;</para>
  <para style="q2" vid="PSA 78:70">ɔfrɛɛ no firii nnwammuo mu<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>firii nnwan akyiridie, na ɔde no baeɛ</para>
  <para style="q2" vid="PSA 78:71">sɛ ɔmmɛyɛ odwanhwɛfoɔ mma ne nkurɔfoɔ Yakob,</para>
  <para style="q2" vid="PSA 78:71">mma Israel a wɔyɛ nʼagyapadeɛ.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Na Dawid de akoma pa hwɛɛ wɔn so</para>
  <para style="q2" vid="PSA 78:72">na ɔde ne nimdeɛ dii wɔn anim.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">Dwom 79</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>Ao Onyankopɔn, amanaman no ato ahyɛ wʼagyapadeɛ so;</para>
  <para style="q2" vid="PSA 79:1">wɔagu wʼasɔredan kronkron no ho fi,</para>
  <para style="q2" vid="PSA 79:1">wɔama Yerusalem adane mmubuiɛ.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Wɔde wʼasomfoɔ afunu ayɛ aduane</para>
  <para style="q2" vid="PSA 79:2">ama ewiem nnomaa,</para>
  <para style="q1" vid="PSA 79:2">na wɔde wʼahotefoɔ ɛnam ama asase so mmoa.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Wɔahwie mogya agu te sɛ nsuo</para>
  <para style="q2" vid="PSA 79:3">wɔ Yerusalem ho nyinaa,</para>
  <para style="q2" vid="PSA 79:3">na obiara nni hɔ a ɔbɛsie awufoɔ no.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Yɛayɛ animtiabudeɛ ama yɛn mfɛfoɔ,</para>
  <para style="q2" vid="PSA 79:4">fɛdie ne nsopa ama wɔn a atwa yɛn ho ahyia.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>Ao <char style="nd">Awurade</char>, ɛnkɔsi da bɛn? Wo bo bɛfu afebɔɔ anaa?</para>
  <para style="q2" vid="PSA 79:5">Wo ninkunu bɛdɛre sɛ ogya akɔsi da bɛn?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Hwie wʼabofuo gu amanaman</para>
  <para style="q2" vid="PSA 79:6">a wɔnni woɔ no so,</para>
  <para style="q1" vid="PSA 79:6">ahennie a</para>
  <para style="q2" vid="PSA 79:6">wɔmmɔ wo din no;<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>ɛfiri sɛ wɔakum Yakob</para>
  <para style="q2" vid="PSA 79:7">na wɔasɛe nʼatenaeɛ.<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Mfa yɛn agyanom bɔne so asotwe mma yɛn;</para>
  <para style="q2" vid="PSA 79:8">ma wo mmɔborɔhunu mmra yɛn so ntɛm,</para>
  <para style="q2" vid="PSA 79:8">na yɛwɔ ahohiahia mu.<verse eid="PSA 79:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>Ao Onyankopɔn yɛn Agyenkwa, boa yɛn,</para>
  <para style="q2" vid="PSA 79:9">wo din no animuonyam nti;</para>
  <para style="q1" vid="PSA 79:9">gye yɛn na fa yɛn bɔne kyɛ yɛn</para>
  <para style="q2" vid="PSA 79:9">wo din enti.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Adɛn enti na ɛsɛ sɛ amanaman ka sɛ,</para>
  <para style="q2" vid="PSA 79:10">“Wɔn Onyankopɔn wɔ he?”</para>
  <para style="q1" vid="PSA 79:10">Yɛn anim ha ara, ma wɔnhunu wɔ amanaman mu sɛ</para>
  <para style="q2" vid="PSA 79:10">wotɔ wʼasomfoɔ mogya a wɔahwie agu no so werɛ.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Ma nneduafoɔ no apinisie nnuru wʼanim;</para>
  <para style="q2" vid="PSA 79:11">fa wo basa ahoɔden no</para>
  <para style="q2" vid="PSA 79:11">kora wɔn a wɔabu wɔn kumfɔ no.<verse eid="PSA 79:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Ao Awurade, ahohora a yɛn mfɛfoɔ asum agu wo soɔ no,</para>
  <para style="q2" vid="PSA 79:12">tua wɔn so ka mprɛnson.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Na yɛn a yɛyɛ wo nkurɔfoɔ, wʼadidibea nnwan no,</para>
  <para style="q2" vid="PSA 79:13">bɛyi wo ayɛ daa nyinaa;</para>
  <para style="q1" vid="PSA 79:13">ɛfiri awoɔ ntoatoasoɔ kɔsi awoɔ ntoatoasoɔ</para>
  <para style="q2" vid="PSA 79:13">yɛbɛkɔ so aka wʼayɛyie akyerɛ.</para>
  <para style="d" vid="PSA 79:13">Wɔde ma dwomkyerɛfoɔ sɛ wɔnto no “Sonannim Edut” sankuo nne so.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">Dwom 80</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>Ao Israel dwanhwɛfoɔ, tie yɛn,</para>
  <para style="q2" vid="PSA 80:1">wo a wodii Yosef anim sɛdeɛ wɔdi nnwankuo anim;</para>
  <para style="q1" vid="PSA 80:1">wo a wote ahennwa so wɔ Kerubim ntam no, hyerɛn<verse eid="PSA 80:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 80:2"/>wɔ Efraim, Benyamin ne Manase anim.</para>
  <para style="q1" vid="PSA 80:2">Kanyane wo tumi;</para>
  <para style="q2" vid="PSA 80:2">bra bɛgye yɛn nkwa.<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>Ao Onyankopɔn, gye yɛn bio;</para>
  <para style="q2" vid="PSA 80:3">ma wʼanim nhyerɛn yɛn so,</para>
  <para style="q2" vid="PSA 80:3">na wɔagye yɛn nkwa.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>Ao Otumfoɔ <char style="nd">Awurade</char> Onyankopɔn,</para>
  <para style="q2" vid="PSA 80:4">wʼabofuo bɛdɛre akɔsi da bɛn</para>
  <para style="q2" vid="PSA 80:4">wʼabofuo a ɛtia wo nkurɔfoɔ mpaeɛbɔ no?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Wode nisuo yɛɛ aduane maa wɔn diiɛ;</para>
  <para style="q2" vid="PSA 80:5">wode nisuo kuruwa ma ma wɔnomeeɛ.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Woama yɛn mfɛfoɔ abu yɛn animtiaa,</para>
  <para style="q2" vid="PSA 80:6">na yɛn atamfoɔ sere yɛn.<verse eid="PSA 80:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>Ao Otumfoɔ Onyankopɔn, gye yɛn bio;</para>
  <para style="q2" vid="PSA 80:7">ma wʼanim nhyerɛn yɛn so,</para>
  <para style="q2" vid="PSA 80:7">na wɔagye yɛn nkwa.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Wode bobe firi Misraim baeɛ;</para>
  <para style="q2" vid="PSA 80:8">wopamoo amanaman no na woduaaɛ.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Wosiesiee asase no baabi maa no,</para>
  <para style="q2" vid="PSA 80:9">ɛgyee nhini na ɛtrɛɛ asase no so.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Ne nwunu kataa mmepɔ no so</para>
  <para style="q2" vid="PSA 80:10">ne mman kataa ntweneduro akɛseɛ no so.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Ɛdendanee kɔɔ Ɛpo so,</para>
  <para style="q2" vid="PSA 80:11">na ɛfefɛ kɔduruu Asubɔnten no ho.<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Adɛn enti na woabubu nʼafasuo</para>
  <para style="q2" vid="PSA 80:12">ama wɔn a wɔtwam hɔ tete ne bobe aba no?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Kɔkɔte firi wiram bɛsɛe no pasaa</para>
  <para style="q2" vid="PSA 80:13">na mmoadoma a ɛwɔ ɛserɛ so de yɛ wɔn aduane.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Ao Otumfoɔ Onyankopɔn, sane bra yɛn nkyɛn!</para>
  <para style="q2" vid="PSA 80:14">Firi soro hɔ hwɛ na wobɛhunu!</para>
  <para style="q1" vid="PSA 80:14">Hwɛ saa bobe yi so,<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>ntini a wo nsa nifa adua no,</para>
  <para style="q2" vid="PSA 80:15">ɔbabarima a woatete no ama wo ho no.<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Wɔatwa wo bobe no ato fam, ato mu ogya ama ahye;</para>
  <para style="q2" vid="PSA 80:16">wʼanimka ma wo nkurɔfoɔ ase tɔre.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Fa wo nsa kata ɔbarima a ɔwɔ wo nifa no so,</para>
  <para style="q2" vid="PSA 80:17">onipa ba a woatete no ama wo ho no.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Afei yɛrentwe yɛn ho mfiri wo nkyɛn;</para>
  <para style="q2" vid="PSA 80:18">kanyane yɛn, na yɛbɛbɔ wo din.<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>Ao Otumfoɔ <char style="nd">Awurade</char> Onyankopɔn, gye yɛn bio,</para>
  <para style="q2" vid="PSA 80:19">na ma wʼanim nhyerɛn yɛn so,</para>
  <para style="q2" vid="PSA 80:19">na wɔagye yɛn nkwa.</para>
  <para style="d" vid="PSA 80:19">Wɔde ma dwomkyerɛfoɔ sɛ wɔnto sɛ “gittit” sankuo nne so.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">Dwom 81</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>Monto ahurisie dwom mma Onyankopɔn yɛn ahoɔden;</para>
  <para style="q2" vid="PSA 81:1">mommɔ ose mma Yakob Onyankopɔn no!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Momma nnwom no so na monwoso akasaeɛ.</para>
  <para style="q1" vid="PSA 81:2">Mommɔ sankuo ne bɛnta dɛɛdɛ no.<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Monhyɛne mmɛntia ɔsrane foforɔ da no,</para>
  <para style="q2" vid="PSA 81:3">ne ɔsrane korokumatwa mu, yɛn Apontoɔ da no;<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Yei yɛ Israelfoɔ ahyɛdeɛ,</para>
  <para style="q2" vid="PSA 81:4">Yakob Onyankopɔn mmara.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Ɔtintimiiɛ sɛ nhyehyɛeɛ maa Yosef</para>
  <para style="q2" vid="PSA 81:5">ɛberɛ a ɔsɔre tiaa Misraim no,</para>
  <para style="q2" vid="PSA 81:5">faako a yɛtee kasa a yɛnte aseɛ no.<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>Ɔka sɛ, “Meyii adesoa no firii mo mmatire so,</para>
  <para style="q2" vid="PSA 81:6">ne mo nsa firii adwumaden ho.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Mo ahohiahia mu, mofrɛɛ me na megyee mo,</para>
  <para style="q2" vid="PSA 81:7">megyee mo so wɔ aprannaa mu;</para>
  <para style="q2" vid="PSA 81:7">me sɔɔ mo hwɛeɛ wɔ Meriba nsuo ho.<verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>“Ao me nkurɔfoɔ, montie me kɔkɔbɔ yi,</para>
  <para style="q2" vid="PSA 81:8">Ao Israel, sɛ mobɛtie me a!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Ɛnsɛ sɛ monya anyame foforɔ bi wɔ mo mu;</para>
  <para style="q2" vid="PSA 81:9">ɛnsɛ sɛ mokoto ananafoɔ nyame.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>Mene <char style="nd">Awurade</char>, mo Onyankopɔn a</para>
  <para style="q2" vid="PSA 81:10">meyii mo firii Misraim asase so no.</para>
  <para style="q2" vid="PSA 81:10">Mommue mo anom tɛtrɛɛ na mɛhyɛ mu ma.<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“Nanso me nkurɔfoɔ rentie me;</para>
  <para style="q2" vid="PSA 81:11">Israel remmrɛ ne ho ase mma me.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>Enti megyaa wɔn maa wɔn akomaden</para>
  <para style="q2" vid="PSA 81:12">sɛ wɔnyɛ deɛ wɔpɛ biara.<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“Sɛ me nkurɔfoɔ tie me,</para>
  <para style="q2" vid="PSA 81:13">na Israel nante mʼakwan so a,<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>anka mɛdi wɔn atamfoɔ so ama wɔn ntɛm</para>
  <para style="q2" vid="PSA 81:14">na mama me basa so atia wɔn a wɔkyiri wɔn!<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>Wɔn a wɔtane <char style="nd">Awurade</char> no de suro bɛkoto no,</para>
  <para style="q2" vid="PSA 81:15">na wɔn asotwe to rentwa da.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Nanso, wɔde atokoɔ mu atokoɔ papa bɛma mo adi;</para>
  <para style="q2" vid="PSA 81:16">mede ɔbotan mu woɔ bɛma mo amee.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">Dwom 82</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>Onyankopɔn di ɔhene wɔ ɔsoro asafo mu;</para>
  <para style="q2" vid="PSA 82:1">ɔbu atɛn wɔ “anyame” mu.<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“Wobɛbɔ wɔn a wɔnteneɛ ho ban</para>
  <para style="q2" vid="PSA 82:2">na woayɛ animhwɛ ama amumuyɛfoɔ akɔsi da bɛn?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>Monka mmɔborɔfoɔ ne nwisiaa asɛm mma wɔn;</para>
  <para style="q2" vid="PSA 82:3">mommɔ ahiafoɔ ne wɔn a wɔhyɛ wɔn so yiedie ho ban.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Monnye ɔbrɛfoɔ ne ohiani;</para>
  <para style="q2" vid="PSA 82:4">monnye wɔn mfiri amumuyɛfoɔ nsam.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“Wɔnnim hwee, na wɔnte hwee ase.</para>
  <para style="q2" vid="PSA 82:5">Wɔkyinkyini wɔ esum mu;</para>
  <para style="q2" vid="PSA 82:5">na asase fapem nyinaa woso.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“Mekaa sɛ, ‘Moyɛ “anyame”;</para>
  <para style="q2" vid="PSA 82:6">mo nyinaa yɛ Ɔsorosoroni no mma.’<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>Nanso, mobɛwuwu sɛ nnipa pɛ;</para>
  <para style="q2" vid="PSA 82:7">na moahwe ase sɛ sodifoɔ biara.”<verse eid="PSA 82:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>Ao Onyankopɔn, sɔre na bɛbu ewiase atɛn;</para>
  <para style="q2" vid="PSA 82:8">ɛfiri sɛ amanaman nyinaa yɛ wo dea.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">Dwom 83</para>
  <para style="d">Asaf Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>Ao Onyankopɔn, ntena hɔ komm;</para>
  <para style="q2" vid="PSA 83:1">mmua wʼano, Ao Onyankopɔn, keka wo ho.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Hwɛ sɛdeɛ wʼatamfoɔ keka wɔn ho fa,</para>
  <para style="q2" vid="PSA 83:2">na wɔn a wɔmpɛ wʼasɛm nso ama wɔn tiri so.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Wɔde anifire repam atia wo nkurɔfoɔ</para>
  <para style="q2" vid="PSA 83:3">wɔrepam atia wɔn a wʼakoma da wɔn so no.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Wɔka sɛ, “Mommra na yɛnsɛe wɔn sɛ ɔman,</para>
  <para style="q2" vid="PSA 83:4">sɛdeɛ wɔrenkae Israel din bio.”<verse eid="PSA 83:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Wɔde adwene korɔ bɔ pɔ;</para>
  <para style="q2" vid="PSA 83:5">na wɔpam tia wo,<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>Edom ntomadan ne Ismaelfoɔ,</para>
  <para style="q2" vid="PSA 83:6">Moabfoɔ ne Hagarfoɔ,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Gebalfoɔ ne Amonfoɔ ne Amalekfoɔ,</para>
  <para style="q2" vid="PSA 83:7">Filistifoɔ ne Tirofoɔ.<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Asiria mpo akɔka wɔn ho</para>
  <para style="q2" vid="PSA 83:8">de wɔn ahoɔden akɔhyɛ Lot asefoɔ deɛ mu kena.<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Yɛ wɔn sɛdeɛ woyɛɛ Midian</para>
  <para style="q2" vid="PSA 83:9">sɛdeɛ woyɛɛ Sisera ne Yabin wɔ asubɔnten Kison ho no,<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>wɔn a wɔsɛee wɔ En-Dor</para>
  <para style="q2" vid="PSA 83:10">na wɔdanee nwira no.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Yɛ wɔn atitire sɛ Oreb ne Seeb,</para>
  <para style="q2" vid="PSA 83:11">ne wɔn mmapɔmma nyinaa sɛ Seba ne Salmuna,<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>a wɔkaa sɛ, “Momma yɛmfa</para>
  <para style="q2" vid="PSA 83:12">Onyankopɔn adidibea nsase no.”<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>Ao me Onyankopɔn, yɛ wɔn sɛ twahoframa mu mfuturo,</para>
  <para style="q2" vid="PSA 83:13">sɛ ntɛtɛ a mframa bɔ guo.<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>Sɛdeɛ ogya hye kwaeɛ,</para>
  <para style="q2" vid="PSA 83:14">na ogyaframa sɔ nkokoɔ mu hye no no,<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>saa ara na fa wʼahum taa wɔn</para>
  <para style="q2" vid="PSA 83:15">na fa wo mframa a ano yɛ den no hunahuna wɔn.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>Ma animguaseɛ nka wɔn,</para>
  <para style="q2" vid="PSA 83:16">na ama nnipa apɛ wo din akyiri ɛkwan, Ao <char style="nd">Awurade</char>.<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Ma wɔn anim ngu ase na wɔn abasa mu ntu;</para>
  <para style="q2" vid="PSA 83:17">ma wɔnwuwu wɔ animguaseɛ mu.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Ma wɔnhunu sɛ wo a wo din de <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="PSA 83:18">wo nko ara ne Ɔsorosoroni wɔ asase so nyinaa.</para>
  <para style="d" vid="PSA 83:18">Wɔde ma dwomkyerɛfoɔ sɛ wɔnto no wɔ gittit sankuo nne so.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">Dwom 84</para>
  <para style="d">Kora mma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>Ao Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 84:1">wʼatenaeɛ hɔ yɛ ahomeka!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Me kra pere, mpo ɛtɔ piti,</para>
  <para style="q2" vid="PSA 84:2">sɛ ɔbɛkɔ <char style="nd">Awurade</char> adihɔ;</para>
  <para style="q1" vid="PSA 84:2">mʼakoma ne me honam team</para>
  <para style="q2" vid="PSA 84:2">frɛ Onyankopɔn ɔteasefoɔ.<verse eid="PSA 84:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Mpo akasanoma anya fie,</para>
  <para style="q2" vid="PSA 84:3">na asomfena nso anwono ne pirebuo,</para>
  <para style="q2" vid="PSA 84:3">baabi a ɔbɛhwane ne mma</para>
  <para style="q1" vid="PSA 84:3">wɔ beaeɛ bi a ɛbɛn wʼafɔrebukyia,</para>
  <para style="q2" vid="PSA 84:3">Ao Asafo <char style="nd">Awurade</char>, me Ɔhene ne me Onyankopɔn.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Nhyira nka wɔn a wɔte wo fie;</para>
  <para style="q2" vid="PSA 84:4">na wɔkamfo wo din daa.<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Nhyira nka wɔn a wɔwɔ wo mu ahoɔden,</para>
  <para style="q2" vid="PSA 84:5">na wɔde wɔn akoma hyɛ akwantuo ase kɔhwehwɛ wo.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Sɛ wɔfa Baka Bɔnhwa no mu a,</para>
  <para style="q2" vid="PSA 84:6">wɔma hɔ yɛ nsuwansuwa;</para>
  <para style="q2" vid="PSA 84:6">osutɔberɛ nsuo nso de nhyira pii kata asase no so.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Wɔkɔ no ahoɔden so berɛ nyinaa,</para>
  <para style="q2" vid="PSA 84:7">kɔsi sɛ wɔn mu biara bɛpue Onyankopɔn anim wɔ Sion.<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Ao Asafo <char style="nd">Awurade</char>, Onyankopɔn tie me mpaeɛbɔ;</para>
  <para style="q2" vid="PSA 84:8">Ao Yakob Onyankopɔn, yɛ aso ma me.<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>Ao Onyankopɔn, hwɛ yɛn akokyɛm;</para>
  <para style="q2" vid="PSA 84:9">fa ahummɔborɔ hwɛ deɛ woasra no ngo no.<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Wʼadihɔ hɔ da korɔ tena</para>
  <para style="q2" vid="PSA 84:10">yɛ sene nnafua apem wɔ baabi foforɔ;</para>
  <para style="q1" vid="PSA 84:10">mepɛ sɛ mɛyɛ ɔpono ano hwɛfoɔ wɔ Onyankopɔn fie</para>
  <para style="q2" vid="PSA 84:10">sene sɛ mɛtena amumuyɛfoɔ ntomadan mu.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>Ɛfiri sɛ <char style="nd">Awurade</char> Onyankopɔn yɛ owia ne ɛkyɛm;</para>
  <para style="q2" vid="PSA 84:11">
    <char style="nd">Awurade</char> hunu mmɔbɔ na ɔhyɛ animuonyam;</para>
  <para style="q1" vid="PSA 84:11">ɔremfa ade pa biara nkame</para>
  <para style="q2" vid="PSA 84:11">wɔn a wɔteneɛ.<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>Ao Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 84:12">nhyira nka onipa a ɔde ne ho to wo so.</para>
  <para style="d" vid="PSA 84:12">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">Dwom 85</para>
  <para style="d">Kora mma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>Ao <char style="nd">Awurade</char> wohunuu wʼasase mmɔbɔ;</para>
  <para style="q2" vid="PSA 85:1">wode Yakob ahonyadeɛ sane maa no.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Wode wo nkurɔfoɔ bɔne kyɛɛ wɔn</para>
  <para style="q2" vid="PSA 85:2">na wokataa wɔn nnebɔne nyinaa so.<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Wode wʼabofuo too nkyɛn</para>
  <para style="q2" vid="PSA 85:3">na wodane firii wʼabufuhyeɛ ho.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>Sane gye yɛn bio, Ao Onyankopɔn, yɛn Gyefoɔ,</para>
  <para style="q2" vid="PSA 85:4">na ma wʼani nnye yɛn ho.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Wo bo bɛfu yɛn akɔsi daa anaa?</para>
  <para style="q2" vid="PSA 85:5">Wʼabofuo bɛtoa so akɔ awoɔ ntoantoasoɔ nyinaa so anaa?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Worenhyɛ yɛn den bio,</para>
  <para style="q2" vid="PSA 85:6">na ama wo nkurɔfoɔ asɛpɛ wɔn ho wɔ wo mu anaa?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>Ao <char style="nd">Awurade</char>, kyerɛ yɛn wo dɔ a ɛnsa da no,</para>
  <para style="q2" vid="PSA 85:7">na ma yɛn wo nkwagyeɛ no.<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Mɛtie deɛ <char style="nd">Awurade</char> Onyankopɔn bɛka.</para>
  <para style="q2" vid="PSA 85:8">Ɔde asomdwoeɛ hyɛ ne nkurɔfoɔ, ahotefoɔ no bɔ,</para>
  <para style="q2" vid="PSA 85:8">enti ɛnsɛ sɛ wɔsane kɔ agyimisɛm ho.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Ampa ara, ne nkwagyeɛ bɛne wɔn a wɔsuro no,</para>
  <para style="q2" vid="PSA 85:9">na nʼanimuonyam bɛtena yɛn asase so.<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Ɔdɔ ne nokorɛdie bɛhyia,</para>
  <para style="q2" vid="PSA 85:10">na tenenee ne asomdwoeɛ bɛfe wɔn ho wɔn ho ano.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Nokorɛdie bɛpue afiri asase no so,</para>
  <para style="q2" vid="PSA 85:11">na tenenee ahwɛ afiri soro.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>
    <char style="nd">Awurade</char> bɛma yɛn deɛ ɛyɛ ampa ara</para>
  <para style="q2" vid="PSA 85:12">na yɛn asase bɛma ne nnɔbaeɛ.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Tenenee di nʼanim</para>
  <para style="q2" vid="PSA 85:13">siesie ɛkwan ma nʼanammɔntuo.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">Dwom 86</para>
  <para style="d">Dawid mpaeɛbɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>Ao <char style="nd">Awurade</char>, tie me na gye me so,</para>
  <para style="q2" vid="PSA 86:1">ɛfiri sɛ meyɛ ohiani ne mmɔborɔni.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Bɔ me nkwa ho ban, ɛfiri sɛ mede me ho ama wo.</para>
  <para style="q2" vid="PSA 86:2">Wone me Onyankopɔn, gye wʼakoa a</para>
  <para style="q2" vid="PSA 86:2">ɔde ne ho to wo so.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>Ao <char style="nd">Awurade</char>, hunu me mmɔbɔ,</para>
  <para style="q2" vid="PSA 86:3">na mesu frɛ wo daa nyinaa.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Ma wʼakoa ani nnye,</para>
  <para style="q2" vid="PSA 86:4">na wo <char style="nd">Awurade</char>, wo nkyɛn</para>
  <para style="q2" vid="PSA 86:4">na mema me kra so ba.<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>Ao <char style="nd">Awurade</char>, woyɛ, na wode bɔne kyɛ,</para>
  <para style="q2" vid="PSA 86:5">wowɔ ɔdɔ mmorosoɔ ma wɔn a wɔsu frɛ wo nyinaa.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>Ao <char style="nd">Awurade</char>, tie me mpaeɛbɔ;</para>
  <para style="q2" vid="PSA 86:6">tie me mmɔborɔ su.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Mɛfrɛ wo mʼahohia da mu,</para>
  <para style="q2" vid="PSA 86:7">na wobɛgye me so.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>Ao <char style="nd">Awurade</char>, onyame bi nni hɔ a ɔte sɛ wo;</para>
  <para style="q2" vid="PSA 86:8">na wɔn nnwuma biara nto wo deɛ.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>Ao <char style="nd">Awurade</char>, aman a woakyekyere nyinaa</para>
  <para style="q2" vid="PSA 86:9">bɛba abɛsom wo wɔ wʼanim;</para>
  <para style="q2" vid="PSA 86:9">wɔbɛba abɛhyɛ wo din animuonyam.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Woyɛ kɛseɛ, na woyɛ anwanwa nnwuma;</para>
  <para style="q2" vid="PSA 86:10">wo nko ara ne Onyankopɔn.<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>Ao <char style="nd">Awurade</char>, kyerɛ me wʼakwan,</para>
  <para style="q2" vid="PSA 86:11">na mɛnante wo nokorɛ mu;</para>
  <para style="q1" vid="PSA 86:11">ma memfa mʼakoma nyinaa mma wo</para>
  <para style="q2" vid="PSA 86:11">na masuro wo din.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Mede mʼakoma nyinaa mɛyi wo ayɛ, Ao Awurade me Onyankopɔn</para>
  <para style="q2" vid="PSA 86:12">na mahyɛ wo din animuonyam daa nyinaa.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Ɛfiri sɛ, ɔdɔ a wode dɔ me no so;</para>
  <para style="q2" vid="PSA 86:13">woayi me afiri owuo amena mu tɔnn.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>Ao Onyankopɔn, ahomasofoɔ ato ahyɛ me so;</para>
  <para style="q2" vid="PSA 86:14">basabasayɛfoɔ kuo repɛ me akum me,</para>
  <para style="q2" vid="PSA 86:14">nnipa a wɔmmfa wo nyɛ hwee no.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>Nanso wo, Ao <char style="nd">Awurade</char>, woyɛ mmɔborɔhunufoɔ ne ɔdomfoɔ Onyankopɔn,</para>
  <para style="q2" vid="PSA 86:15">wo bo kyɛre fu, na wʼadɔeɛ ne wo nokorɛ dɔɔso.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Dane wʼani hwɛ me na dom me;</para>
  <para style="q2" vid="PSA 86:16">fa wʼahoɔden ma wʼakoa</para>
  <para style="q2" vid="PSA 86:16">na gye wʼafenaa babarima nkwa.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Ma me wo papayɛ ho nsɛnkyerɛnneɛ,</para>
  <para style="q2" vid="PSA 86:17">na mʼatamfoɔ nhunu na wɔn anim ngu ase</para>
  <para style="q2" vid="PSA 86:17">na wo Ao <char style="nd">Awurade</char>, wo na woaboa me akyekye me werɛ.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">Dwom 87</para>
  <para style="d">Kora mma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>
    <char style="nd">Awurade</char> ato ne fapem wɔ bepɔ kronkron no so;<verse eid="PSA 87:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 87:2"/>
    <char style="nd">Awurade</char> dɔ Sion apono no</para>
  <para style="q2" vid="PSA 87:2">sene Yakob atenaeɛ nyinaa.<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Wɔka wo ho animuonyamsɛm</para>
  <para style="q2" vid="PSA 87:3">Ao Onyankopɔn kuropɔn:<verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“Mede Rahab ne Babilonia</para>
  <para style="q2" vid="PSA 87:4">bɛka wɔn a wɔyɛ ɔsetie ma me no ho,</para>
  <para style="q1" vid="PSA 87:4">Filistia, Tiro ne Kus nso</para>
  <para style="q2" vid="PSA 87:4">mɛka sɛ, ‘Wɔwoo yeinom wɔ Sion.’ ”<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Ampa ara wɔbɛka wɔ Sion ho sɛ,</para>
  <para style="q2" vid="PSA 87:5">“Wɔwoo yei ne ɔno wɔ ne mu,</para>
  <para style="q2" vid="PSA 87:5">na Ɔsorosoroni no ankasa de no bɛtim hɔ.”<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>
    <char style="nd">Awurade</char> bɛtwerɛ wɔ nnipa dintwerɛ nwoma no mu sɛ,</para>
  <para style="q2" vid="PSA 87:6">“Wɔwoo yei wɔ Sion.”<verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Na wɔbɛto dwom sɛ,</para>
  <para style="q2" vid="PSA 87:7">“Me nhini nyinaa wɔ wo mu.”</para>
  <para style="d" vid="PSA 87:7">Kora mma dwom a wɔde ma dwomkyerɛfoɔ sɛ wɔnto no “Mahalat Leannot” sankuo so.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">Dwom 88</para>
  <para style="d">Esrahini Heman ɔhaw ne amanehunu dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>Ao <char style="nd">Awurade</char>, me nkwagyeɛ Onyankopɔn</para>
  <para style="q2" vid="PSA 88:1">mesu wɔ wʼanim adekyeeɛ ne adesaeɛ.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Ma me mpaeɛbɔ nnuru wʼanim;</para>
  <para style="q2" vid="PSA 88:2">brɛ wʼaso ase tie me sufrɛ.<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Ɔhaw ahyɛ me kra ma</para>
  <para style="q2" vid="PSA 88:3">na me nkwa rebɛn owuo.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Wɔkan me fra wɔn a wɔrekɔ damena mu;</para>
  <para style="q2" vid="PSA 88:4">mete sɛ obi a ɔnni ahoɔden.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Wɔayi me asi nkyɛn wɔ awufoɔ mu,</para>
  <para style="q2" vid="PSA 88:5">te sɛ atɔfoɔ a wɔdeda ɛda mu,</para>
  <para style="q1" vid="PSA 88:5">wɔn a wonkae wɔn bio,</para>
  <para style="q2" vid="PSA 88:5">na wonhwɛ wɔn bio.<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Woato me atwene damena ase tɔnn,</para>
  <para style="q2" vid="PSA 88:6">wɔ esum kabii mu.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Wʼabofuhyeɛ ayɛ duru wɔ me so;</para>
  <para style="q2" vid="PSA 88:7">woama wʼasorɔkye nyinaa abu afa me so.<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Woafa me nnamfonom a wɔbɛn me afiri me nkyɛn</para>
  <para style="q2" vid="PSA 88:8">woama me ho ayɛ wɔn ahi.</para>
  <para style="q1" vid="PSA 88:8">Woaka me ahyɛ mu na mentumi nnwane;<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>awerɛhoɔ ama mʼani so ayɛ kusuu.</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">Ao <char style="nd">Awurade</char> mesu frɛ wo da biara;</para>
  <para style="q2" vid="PSA 88:9">metrɛ me nsam kyerɛ wo.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Woyɛ anwanwadeɛ kyerɛ awufoɔ anaa?</para>
  <para style="q2" vid="PSA 88:10">Wɔn a wɔawuwu no sɔre kamfo wo anaa?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Wɔka wʼadɔeɛ ho asɛm wɔ ɛda mu anaa,</para>
  <para style="q2" vid="PSA 88:11">anaasɛ wo nokorɛ ho asɛm wɔ ɔsɛeɛ kurom?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Wɔhunu wʼanwanwadeɛ wɔ beaeɛ a ɛhɔ aduru sum,</para>
  <para style="q2" vid="PSA 88:12">anaa wo tenenee nnwuma wɔ awerɛfirie asase so?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Nanso Ao <char style="nd">Awurade</char>, mesu frɛ wo sɛ boa me;</para>
  <para style="q2" vid="PSA 88:13">me mpaeɛbɔ duru wʼanim adekyeeɛ mu<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>Ao <char style="nd">Awurade</char>, adɛn nti na wopo me</para>
  <para style="q2" vid="PSA 88:14">na wode wʼanim hinta me?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Mahunu amane firi me mmɔfraase na mabɛn owuo;</para>
  <para style="q2" vid="PSA 88:15">wʼahunahuna ama mabrɛ na mapa aba.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Wʼabofuhyeɛ abu afa me so;</para>
  <para style="q2" vid="PSA 88:16">wʼahunahuna asɛe me.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Daa nyinaa wɔtwa me ho hyia sɛ nsuyire,</para>
  <para style="q2" vid="PSA 88:17">na wɔabu afa me so koraa.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Woafa mʼayɔnkofoɔ ne mʼadɔfoɔ afiri me nkyɛn kɔ;</para>
  <para style="q2" vid="PSA 88:18">na esum ayɛ mʼadamfo brɛboɔ.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">Dwom 89</para>
  <para style="d">Esrahini Etan ɔhaw ne amanehunu dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>Mɛto <char style="nd">Awurade</char> adɔeɛ ho dwom daa daa;</para>
  <para style="q2" vid="PSA 89:1">mede mʼano bɛda wo nokorɛdie adi awoɔ ntoatoasoɔ nyinaa mu.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Mɛka sɛ wʼadɔeɛ no tim hɔ daa nyinaa,</para>
  <para style="q2" vid="PSA 89:2">na watim wo nokorɛdie wɔ ɔsoro hɔ ankasa.<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Wokaa sɛ, “Me ne onipa a mayi no no ayɛ apam;</para>
  <para style="q2" vid="PSA 89:3">maka ntam akyerɛ me ɔsomfoɔ Dawid.<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘Mɛma wʼase atim hɔ daa</para>
  <para style="q2" vid="PSA 89:4">na wʼahennwa nso atim wɔ awoɔ ntoantoasoɔ nyinaa mu.’ ”<verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>Ao <char style="nd">Awurade</char>, ɔsorosorofoɔ kamfo wʼanwanwadeɛ,</para>
  <para style="q2" vid="PSA 89:5">na wo nokorɛdie nso, wɔkamfo wɔ ahotefoɔ asafo mu.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Na hwan na ɔne wo <char style="nd">Awurade</char> sɛ wɔ ɔsoro hɔ?</para>
  <para style="q2" vid="PSA 89:6">Hwan na ɔte sɛ <char style="nd">Awurade</char> wɔ ɔsoro abɔdeɛ mu?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Akronkronfoɔ agyinatufoɔ mu, wosuro Onyankopɔn;</para>
  <para style="q2" vid="PSA 89:7">wɔde suro ma no sene wɔn a wotwa ne ho hyia nyinaa.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>Ao Otumfoɔ <char style="nd">Awurade</char> Onyankopɔn, hwan na ɔte sɛ woɔ?</para>
  <para style="q2" vid="PSA 89:8">Ao <char style="nd">Awurade</char> woyɛ kɛseɛ na wo nokorɛdie atwa wo ho ahyia.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Wodi ɛpo a ɛreworo soɔ so;</para>
  <para style="q2" vid="PSA 89:9">nʼasorɔkye bobɔ kɔ ɔsoro a, wobrɛ no ase.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Wodwerɛɛ Rahab sɛ atɔfoɔ no mu baako;</para>
  <para style="q2" vid="PSA 89:10">wode wo basa denden no bɔɔ wʼatamfoɔ pansameeɛ.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Ɔsoro wɔ wo, na asase nso wɔ wo;</para>
  <para style="q2" vid="PSA 89:11">ewiase ne deɛ ɛwɔ mu nyinaa, wo na wohyɛɛ aseɛ.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Wobɔɔ atifi ne anafoɔ.</para>
  <para style="q2" vid="PSA 89:12">Tabor ne Hermon de ahosɛpɛ to dwom ma wo din.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Tumi ayɛ wo basa ma;</para>
  <para style="q2" vid="PSA 89:13">wo nsam wɔ ahoɔden, wama wo nsa nifa so.<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Wʼahennwa no fapem yɛ tenenee ne atɛntenenee;</para>
  <para style="q2" vid="PSA 89:14">adɔeɛ ne nokorɛdie di wʼanim.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Nhyira nka wɔn a wɔasua sɛdeɛ wɔbɔ wo abɔdin,</para>
  <para style="q2" vid="PSA 89:15">wɔn a wɔnante wʼanim hann no mu, Ao <char style="nd">Awurade</char>.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Wɔgye wɔn ani wɔ wo din mu da mu nyinaa;</para>
  <para style="q2" vid="PSA 89:16">wɔdi ahurisie wɔ wo tenenee mu.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Wone wɔn animuonyam ne ahoɔden,</para>
  <para style="q2" vid="PSA 89:17">na wʼadom enti yɛyɛ nkonimdifoɔ.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Ampa ara, yɛn banbɔ firi <char style="nd">Awurade</char> hɔ,</para>
  <para style="q2" vid="PSA 89:18">na Israel Kronkronni no ama yɛn Ɔhene.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Ɛda bi wokasaa wɔ anisoadehunu mu,</para>
  <para style="q2" vid="PSA 89:19">kyerɛɛ wʼahotefoɔ sɛ,</para>
  <para style="q1" vid="PSA 89:19">“Madom ɔkofoni bi ahoɔden;</para>
  <para style="q2" vid="PSA 89:19">mapagya aberanteɛ bi afiri nnipa no mu.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Mahunu Dawid, me ɔsomfoɔ;</para>
  <para style="q2" vid="PSA 89:20">mede me ngo kronkron no asra no.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Me nsa bɛwowa no;</para>
  <para style="q2" vid="PSA 89:21">ampa ara mʼabasa bɛhyɛ no den.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Ɔtamfoɔ biara renhyɛ no sɛ ɔntua toɔ;</para>
  <para style="q2" vid="PSA 89:22">omumuyɛfoɔ biara rentumi nhyɛ ne so.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Mɛdwerɛ nʼatamfoɔ wɔ nʼanim</para>
  <para style="q1" vid="PSA 89:23">na mabobɔ nʼahohiahiafoɔ ahwe fam.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Me nokorɛ adɔeɛ bɛka ne ho,</para>
  <para style="q2" vid="PSA 89:24">na me din mu, wɔbɛma nʼabɛn so.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Mɛtrɛ nʼahyeɛ mu akɔsi ɛpo so,</para>
  <para style="q2" vid="PSA 89:25">na ɔde ne nsa nifa bɛto nsubɔntene so.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Ɔbɛfrɛ me aka sɛ, ‘Wone mʼagya,</para>
  <para style="q2" vid="PSA 89:26">me Onyankopɔn, me nkwagyeɛ botan.’<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Mɛyɛ no mʼabakan,</para>
  <para style="q2" vid="PSA 89:27">asase so ahene nyinaa no mu ɔkɛseɛ.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Mɛma mʼadɔeɛ a mewɔ ma no no atena hɔ daa,</para>
  <para style="q2" vid="PSA 89:28">na apam a me ne no ayɛ nso bɛtena hɔ daa.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Mɛma nʼase atim afebɔɔ,</para>
  <para style="q2" vid="PSA 89:29">nʼahennwa nso bɛtim hɔ akɔsi sɛ ɔsoro bɛtwam.<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“Sɛ ne mmammarima po me mmara</para>
  <para style="q2" vid="PSA 89:30">na sɛ wɔanni mʼahyɛdeɛ so,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>sɛ wɔbu mʼahyɛdeɛ so</para>
  <para style="q2" vid="PSA 89:31">na sɛ wɔanni me ɔhyɛ nsɛm so a,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>ɛno deɛ, mede abaa bɛtwe wɔn aso wɔ wɔn bɔne ho</para>
  <para style="q2" vid="PSA 89:32">na wɔn amumuyɛ nso mede mmaatwa atwe wɔn aso;<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>Nanso, merennyae mʼadɔeɛ a meyɛ ma noɔ no</para>
  <para style="q2" vid="PSA 89:33">na mɛkɔ so adi no nokorɛ.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Meremmu mʼapam no so</para>
  <para style="q2" vid="PSA 89:34">na merensesa deɛ mede mʼano aka no.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Menam me din kronkron no so aka ntam prɛko,</para>
  <para style="q2" vid="PSA 89:35">na merentwa Dawid atorɔ da.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>Meremma nʼase ntɔre da</para>
  <para style="q2" vid="PSA 89:36">na nʼahennwa nso bɛtim wɔ mʼanim te sɛ owia;<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>ɛbɛtim hɔ daa te sɛ ɔsrane,</para>
  <para style="q2" vid="PSA 89:37">ɔdansefoɔ nokwafoɔ a ɔwɔ ewiem no.”<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>Nanso woapo no, woapa nʼakyi</para>
  <para style="q2" vid="PSA 89:38">wo bo afu deɛ woasra no ngo no.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Woagu apam a wo ne wo ɔsomfoɔ pameeɛ no</para>
  <para style="q2" vid="PSA 89:39">woagu nʼahenkyɛ ho fi wɔ mfuturo mu.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Woabubu nʼafasuo nyinaa</para>
  <para style="q2" vid="PSA 89:40">ama nʼabandenden adane mmubuiɛ.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Wɔn a wɔtwam wɔ hɔ nyinaa fom no fa;</para>
  <para style="q2" vid="PSA 89:41">na wayɛ aniwudeɛ ama ne mfɛfoɔ.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Woama nʼatamfoɔ nsa nifa so;</para>
  <para style="q2" vid="PSA 89:42">ama wɔn nyinaa di ahurisie.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Woama nʼakofena ayɛ ɔkwa,</para>
  <para style="q2" vid="PSA 89:43">na woannyina nʼakyi wɔ ɔko mu.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Wode nʼanimuonyam aba awieeɛ</para>
  <para style="q2" vid="PSA 89:44">na woato nʼahennwa atwene fam.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Woatwa ne mmeranteberɛ nna so</para>
  <para style="q2" vid="PSA 89:45">na wode animguaseɛ ngugusoɔ akata ne so.<verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>Ao <char style="nd">Awurade</char>, ɛnkɔsi da bɛn? Wode wo ho bɛhinta afebɔɔ anaa?</para>
  <para style="q2" vid="PSA 89:46">Wʼabofuhyeɛ bɛkɔ so adɛre akɔsi da bɛn?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Kae sɛdeɛ me nkwa nna twam ntɛm so.</para>
  <para style="q2" vid="PSA 89:47">Ɛfiri sɛ woabɔ yɛn nyinaa sɛ adeɛ a ɛtwa mu ntɛm so!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Hwan na ɔbɛtena ase a ɔrenwu da?</para>
  <para style="q2" vid="PSA 89:48">Anaasɛ hwan na ɔbɛtumi agye ne ho afiri owuo tumi nsam?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>Ao Awurade, ɛhe na wo tete adɔeɛ kɛseɛ no wɔ,</para>
  <para style="q2" vid="PSA 89:49">deɛ wofiri wo nokorɛdie mu de kaa ntam kyerɛɛ Dawid no?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Awurade kae sɛdeɛ wɔadi wo ɔsomfoɔ ho fɛ</para>
  <para style="q2" vid="PSA 89:50">ne sɛdeɛ manya akoma ama amanaman no akutiabɔ.<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>Ao <char style="nd">Awurade</char>, akutiabɔ a wʼatamfoɔ de adi fɛw,</para>
  <para style="q2" vid="PSA 89:51">de adi deɛ woasra no ngo no anammɔntuo biara ho fɛw.<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Ayɛyie nka <char style="nd">Awurade</char> daa!</para>
  <para style="qr" vid="PSA 89:52">Amen, Amen.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">NWOMA A ƐTƆ SO NNAN</para>
  <para style="mr">
    <ref loc="PSA 90-106">Nnwom 90–106</ref></para>
  <para style="cl">Dwom 90</para>
  <para style="d">Onyankopɔn onipa Mose mpaeɛbɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>Awurade, wo na woayɛ yɛn tenabea</para>
  <para style="q2" vid="PSA 90:1">awoɔ ntoatoasoɔ nyinaa mu.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Ansa na wɔrebɛbɔ mmepɔ</para>
  <para style="q2" vid="PSA 90:2">anaasɛ worebɛda asase ne ewiase adi no,</para>
  <para style="q2" vid="PSA 90:2">na woyɛ Onyankopɔn firi mmerɛsanten kɔsi mmerɛsanten.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Woma adasamma sane dane mfuturo,</para>
  <para style="q2" vid="PSA 90:3">ka sɛ, “Ao adasamma, monsane nkɔ mfuturo mu.”<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Mfirinhyia apem yɛ wʼani so sɛ</para>
  <para style="q2" vid="PSA 90:4">da koro a abɛsene seesei,</para>
  <para style="q2" vid="PSA 90:4">anaasɛ anadwo mu dɔnhwereɛ kakraa bi.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Wopra nnipa kɔ, wɔ owuo nna mu;</para>
  <para style="q2" vid="PSA 90:5">wɔte sɛ ɛserɛ a afefɛ anɔpa,<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>ɛfefɛ yɛ frɔmfrɔm anɔpa deɛ,</para>
  <para style="q2" vid="PSA 90:6">nanso anwummerɛ ɛwo na ɛtwintwam.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Yɛresa wɔ wʼabofuo ano</para>
  <para style="q2" vid="PSA 90:7">na wʼanibereɛ abɔ yɛn hu.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Wode yɛn amumuyɛ asi wʼanim,</para>
  <para style="q2" vid="PSA 90:8">na yɛn kɔkoam bɔne da wʼanim hann no mu.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Yɛn nna nyinaa twam wɔ wʼabufuhyeɛ mu;</para>
  <para style="q2" vid="PSA 90:9">na yɛde awerɛhoɔdie na ɛwie yɛn mfeɛ.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Yɛn nkwa nna si mfeɛ aduɔson,</para>
  <para style="q2" vid="PSA 90:10">anaasɛ aduɔwɔtwe, sɛ yɛwɔ ahoɔden a;</para>
  <para style="q1" vid="PSA 90:10">na emu ahohoahoadeɛ yɛ ɔhaw ne awerɛhoɔ,</para>
  <para style="q2" vid="PSA 90:10">na ɛtwam ntɛm ntɛm, na yɛtu kɔ.<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Hwan na ɔnim wʼabofuo mu tumi?</para>
  <para style="q2" vid="PSA 90:11">Wʼabofuhyeɛ yɛ kɛseɛ sɛdeɛ wo ho suro teɛ.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Ma yɛnhunu yɛn nna kan sɛdeɛ ɛteɛ,</para>
  <para style="q2" vid="PSA 90:12">na yɛanya nyansa akoma.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>Sane bra, Ao <char style="nd">Awurade</char>, ɛbɛkɔ so akɔsi da bɛn?</para>
  <para style="q2" vid="PSA 90:13">Hunu wʼasomfoɔ mmɔbɔ.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Ma wʼadɔeɛ a ɛnsa da no mmee yɛn adekyeɛ mu,</para>
  <para style="q2" vid="PSA 90:14">na yɛde anigyeɛ ato dwom adi ahurisie yɛn nna nyinaa mu.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Ma yɛn ani nnye nna bebree sɛ nna dodoɔ a wode yɛn kɔɔ amanehunu mu no,</para>
  <para style="q2" vid="PSA 90:15">sɛ mfirinhyia dodoɔ a yɛhunuu ateeteeɛ no.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Ma wʼasomfoɔ nhunu wo nneyɛɛ</para>
  <para style="q2" vid="PSA 90:16">na wɔn mma nhunu wʼanimuonyam.<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Ma Awurade yɛn Onyankopɔn adom no ntena yɛn so;</para>
  <para style="q2" vid="PSA 90:17">na yɛn nsa ano adwuma nyɛ yie mma yɛn</para>
  <para style="q2" vid="PSA 90:17">aane, yɛn nsa ano adwuma nyɛ yie.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">Dwom 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Deɛ ɔte Ɔsorosoroni no hintabea</para>
  <para style="q2" vid="PSA 91:1">bɛhome wɔ Otumfoɔ no nwunu mu.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>Mɛse <char style="nd">Awurade</char> sɛ, “Woyɛ me dwanekɔbea ne mʼabankɛseɛ,</para>
  <para style="q2" vid="PSA 91:2">me Onyankopɔn a mewɔ wo mu ahotosoɔ.”<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Ampa ara, ɔbɛgye wo afiri fidisumfoɔ afidie mu</para>
  <para style="q2" vid="PSA 91:3">ne owuyadeɛ mu.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Ɔde ne ntakra bɛkata wo so;</para>
  <para style="q2" vid="PSA 91:4">na ne ntaban ase na wobɛnya dwanekɔbea;</para>
  <para style="q2" vid="PSA 91:4">ne nokorɛ bɛyɛ wo banbɔ ne wo kyɛm.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Worensuro anadwo mu ahunahuna,</para>
  <para style="q2" vid="PSA 91:5">anaa bɛmma a ɛtu awia,<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>anaa owuyadeɛ a ɛba esum mu,</para>
  <para style="q2" vid="PSA 91:6">anaa ɔyaredɔm a ɛsɛe owigyinaeɛ.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Apem bɛtotɔ wo nkyɛn mu,</para>
  <para style="q2" vid="PSA 91:7">na ɔpedu bɛtotɔ wo nifa,</para>
  <para style="q2" vid="PSA 91:7">nanso, wo deɛ, ɛrenka wo.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Wʼani nko ara na wode bɛhwɛ</para>
  <para style="q2" vid="PSA 91:8">na woahunu nnebɔneyɛfoɔ asotwe.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Sɛ wode Ɔsorosoroni no yɛ wo tenabea,</para>
  <para style="q2" vid="PSA 91:9">mpo <char style="nd">Awurade</char> a ɔyɛ me dwanekɔbea no a,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>ɔhaw biara remma wo so,</para>
  <para style="q2" vid="PSA 91:10">na amanehunu biara remmɛn wo ntomadan.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>Ɛfiri sɛ ɔbɛhyɛ nʼabɔfoɔ a wɔhwɛ wo so no</para>
  <para style="q2" vid="PSA 91:11">abɛbɔ wo ho ban wʼakwan nyinaa mu;<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>wɔde wɔn nsa bɛpagya wo,</para>
  <para style="q2" vid="PSA 91:12">na wo nan rensunti ɔboɔ.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Wobɛtiatia agyata ne aprammire so,</para>
  <para style="q2" vid="PSA 91:13">wobɛnante gyataburuwa ne ɔtweaseɛ so.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>
    <char style="nd">Awurade</char> ka sɛ, “Esiane sɛ ɔdɔ me enti, mɛgye no;</para>
  <para style="q2" vid="PSA 91:14">mɛbɔ ne ho ban, ɛfiri sɛ ɔnim me din.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Ɔbɛfrɛ me, na mɛgye ne so;</para>
  <para style="q2" vid="PSA 91:15">mɛka ne ho wɔ amanehunu mu,</para>
  <para style="q2" vid="PSA 91:15">mɛgye no, na mahyɛ no animuonyam.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Mɛma nkwa nna a ɛware amee no</para>
  <para style="q2" vid="PSA 91:16">na makyerɛ no me nkwagyeɛ.”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">Dwom 92</para>
  <para style="d">Dwom a wɔto no Homeda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>Ɛyɛ sɛ wɔkamfo wo <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 92:1">na wɔto dwom de hyɛ wo animuonyam, Ao Ɔsorosoroni,<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>na wɔpae mu ka wʼadɔeɛ anɔpa</para>
  <para style="q2" vid="PSA 92:2">ne wo nokorɛ anadwo,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>wɔ ahoma edu sankuo so</para>
  <para style="q2" vid="PSA 92:3">ne sankuten nnwom mu.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>Ao <char style="nd">Awurade</char>, wo nneyɛɛ ma mʼani gye;</para>
  <para style="q2" vid="PSA 92:4">mede anigyeɛ bɛto dwom, wo nsa ano nnwuma enti.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>Ao <char style="nd">Awurade</char>, wo nnwuma yɛ akɛseɛ,</para>
  <para style="q2" vid="PSA 92:5">na wo nyansa mu dɔ!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Ogyimifoɔ nnim</para>
  <para style="q2" vid="PSA 92:6">na nkwaseafoɔ nte aseɛ,<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>amumuyɛfoɔ bɛnyini sɛ ɛserɛ</para>
  <para style="q2" vid="PSA 92:7">na abɔnefoɔ bɛyɛ frɔmfrɔm deɛ,</para>
  <para style="q1" vid="PSA 92:7">nanso wɔbɛsɛe wɔn pasaa.<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Na wo <char style="nd">Awurade</char>, woyɛ kɛseɛ afebɔɔ.<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>Ao <char style="nd">Awurade</char> ampa ara,</para>
  <para style="q2" vid="PSA 92:9">wʼatamfoɔ bɛyera;</para>
  <para style="q2" vid="PSA 92:9">na wobɛhwete abɔnefoɔ nyinaa.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Woama me ahoɔden te sɛ ɛkoɔ;</para>
  <para style="q2" vid="PSA 92:10">woahwie ngohwam papa agu me so.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Mahunu mʼatamfoɔ nkoguo a wɔadi,</para>
  <para style="q2" vid="PSA 92:11">mate sɛdeɛ mʼatamfoɔ atirimuɔdenfoɔ adwane afiri akono.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Ateneneefoɔ bɛyɛ frɔmm te sɛ abedua,</para>
  <para style="q2" vid="PSA 92:12">wɔbɛnyini sɛ Lebanon ntweneduro;<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>deɛ wɔadua wɔ <char style="nd">Awurade</char> fie,</para>
  <para style="q2" vid="PSA 92:13">wɔbɛnyini frɔmfrɔm wɔ yɛn Onyankopɔn adihɔ hɔ.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Wɔbɛkɔ so aso aba, onyinkyerɛ mu mpo,</para>
  <para style="q2" vid="PSA 92:14">wɔbɛyɛ frɔmm sɛ ahahammono,<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>de akyerɛ sɛ, “<char style="nd">Awurade</char> yɛ ɔteneneeni;</para>
  <para style="q2" vid="PSA 92:15">ɔyɛ me botan, na atirimuɔdensɛm biara nni ne mu.”<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">Dwom 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>
    <char style="nd">Awurade</char> di ɔhene, wɔde tumi ahentadeɛ ahyɛ no;</para>
  <para style="q2" vid="PSA 93:1">wɔde tumi ahentadeɛ ahyɛ <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 93:1">na wɔde ahoɔden ayɛ nʼakodeɛ.</para>
  <para style="q1" vid="PSA 93:1">Wɔde ewiase atim hɔ pintinn;</para>
  <para style="q2" vid="PSA 93:1">na wɔrentumi ntutu.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Wʼahennwa tim hɔ firi tete;</para>
  <para style="q2" vid="PSA 93:2">na wowɔ hɔ firi mmerɛsanten.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Ao <char style="nd">Awurade</char>, ɛpo ama wɔn ho so,</para>
  <para style="q2" vid="PSA 93:3">ɛpo ama wɔn nne so;</para>
  <para style="q2" vid="PSA 93:3">ɛpo ama wɔn asorɔkye a ɛbɔ denden no so.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Woyɛ deɛ ɔwɔ tumi sene nsuo akɛseɛ aprannaa,</para>
  <para style="q2" vid="PSA 93:4">deɛ ɔwɔ tumi sene ɛpo nworosoɔ.</para>
  <para style="q2" vid="PSA 93:4">
    <char style="nd">Awurade</char> a ɔte ɔsoro no yɛ kɛseɛ.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>Ao <char style="nd">Awurade</char>, wo nhyehyɛeɛ gyina hɔ pintinn;</para>
  <para style="q2" vid="PSA 93:5">kronkronyɛ hyɛ wo fie animuonyam</para>
  <para style="q2" vid="PSA 93:5">daa nyinaa.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">Dwom 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>
    <char style="nd">Awurade</char>, Onyankopɔn a wotɔ werɛ,</para>
  <para style="q2" vid="PSA 94:1">Onyankopɔn a wotɔ werɛ, hyerɛn.<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Sɔre, Ao wo a woyɛ asase so ɔtemmufoɔ,</para>
  <para style="q2" vid="PSA 94:2">tua ahantanfoɔ ka sɛdeɛ ɛfata wɔn.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>Ao <char style="nd">Awurade</char>, ɛnkɔsi da bɛn,</para>
  <para style="q2" vid="PSA 94:3">amumuyɛfoɔ nnye wɔn ani nkɔsi da bɛn?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Wɔkasa ahantan so;</para>
  <para style="q2" vid="PSA 94:4">ahohoahoa ahyɛ abɔnefoɔ nyinaa ma.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>Ao <char style="nd">Awurade</char>, wɔdwerɛ wo nkurɔfoɔ;</para>
  <para style="q2" vid="PSA 94:5">wɔhyɛ wʼagyapadeɛ so.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Wɔkunkumm akunafoɔ ne amanfrafoɔ;</para>
  <para style="q2" vid="PSA 94:6">na wɔdi nwisiaa awu.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Wɔka sɛ, “<char style="nd">Awurade</char> nhunu,</para>
  <para style="q2" vid="PSA 94:7">Yakob Onyankopɔn ayi nʼani.”<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Monhwɛ yie, mo agyimifoɔ a mowɔ nnipa no mu;</para>
  <para style="q2" vid="PSA 94:8">nkwaseafoɔ, da bɛn na mobɛhunu nyansa?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Deɛ ɔbɔɔ aso no, ɔrente asɛm anaa?</para>
  <para style="q2" vid="PSA 94:9">Deɛ ɔyɛɛ ani no, ɔrenhunu adeɛ anaa?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Deɛ ɔtenetene aman so no rentwe aso anaa?</para>
  <para style="q2" vid="PSA 94:10">Deɛ ɔkyerɛkyerɛ onipa no nnim nyansa anaa?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>
    <char style="nd">Awurade</char> nim onipa nsusuiɛ;</para>
  <para style="q2" vid="PSA 94:11">ɔnim sɛ ɛnkɔsi hwee.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>Ao <char style="nd">Awurade</char>, nhyira ne onipa a wotenetene ne so,</para>
  <para style="q2" vid="PSA 94:12">onipa a wokyerɛ no wo mmara no;<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>Woma wɔn ɔhome firi amanehunu nna mu,</para>
  <para style="q2" vid="PSA 94:13">kɔsi sɛ wɔbɛtu amena ama amumuyɛfoɔ.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>
    <char style="nd">Awurade</char> rempo ne nkurɔfoɔ;</para>
  <para style="q2" vid="PSA 94:14">na ɔrennya nʼagyapadeɛ hɔ da.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Atemmuo bɛgyina teneneeyɛ so bio,</para>
  <para style="q2" vid="PSA 94:15">na wɔn a wɔn akoma mu teɛ nyinaa bɛdi so.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Hwan na ɔbɛsɔre atia amumuyɛfoɔ ama me?</para>
  <para style="q2" vid="PSA 94:16">Hwan na ɔbɛsɔre atia abɔnefoɔ ama me?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Sɛ <char style="nd">Awurade</char> ammoa me a,</para>
  <para style="q2" vid="PSA 94:17">anka mekɔɔ owuo kommyɛ mu ntɛm so.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Ɛberɛ a mekaa sɛ, “Menan rewatiri” no,</para>
  <para style="q2" vid="PSA 94:18">Ao <char style="nd">Awurade</char>, wo dɔ no sɔɔ me mu.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Ɛberɛ a me dadwene dɔɔso no,</para>
  <para style="q2" vid="PSA 94:19">wʼawerɛkyekye maa me kra abotɔyam.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Ɔhene a porɔeɛ ahyɛ no ma no ne wo wɔ ayɔnkofa anaa?</para>
  <para style="q2" vid="PSA 94:20">Wʼani gye ahennie a ɛde amanehunu ba ho anaa?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Awudifoɔ bɔ mu tia ateneneefoɔ</para>
  <para style="q2" vid="PSA 94:21">na wɔn a wɔdi bem no, wɔbu wɔn kumfɔ.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>Nanso <char style="nd">Awurade</char> yɛ mʼaban;</para>
  <para style="q2" vid="PSA 94:22">na me Onyankopɔn ayɛ ɔbotan a ne mu na menya ahintaeɛ.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Ɔbɛtua wɔn nnebɔne no so ka</para>
  <para style="q2" vid="PSA 94:23">na wɔn amumuyɛ enti, wasɛe wɔn;</para>
  <para style="q2" vid="PSA 94:23">
    <char style="nd">Awurade</char> yɛn Onyankopɔn bɛsɛe wɔn.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">Dwom 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>Mommra mma yɛnto dwom wɔ anigyeɛ so mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 95:1">momma yɛmmɔ ose mma yɛn nkwagyeɛ Botan no.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Momma yɛmfa aseda mmra nʼanim,</para>
  <para style="q2" vid="PSA 95:2">na yɛmfa ahosɛpɛ nnwom mma no so.<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Ɛfiri sɛ, <char style="nd">Awurade</char> yɛ Onyankopɔn kɛseɛ,</para>
  <para style="q2" vid="PSA 95:3">ɔhenkɛseɛ wɔ anyame nyinaa so.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Ne nsam na asase mu nneɛma nyinaa wɔ,</para>
  <para style="q2" vid="PSA 95:4">na mmepɔ mpampam wɔ no.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Ɛpo wɔ no. Ɔno na ɔbɔeɛ,</para>
  <para style="q2" vid="PSA 95:5">na ne nsa na ɛnwonoo asase kesee no.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Mommra mma yɛnkoto nsom no.</para>
  <para style="q2" vid="PSA 95:6">Momma yɛmmu nkotodwe wɔ <char style="nd">Awurade</char> yɛn Yɛfoɔ no anim!<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>Ɔyɛ yɛn Onyankopɔn;</para>
  <para style="q2" vid="PSA 95:7">yɛyɛ nʼadidibea nnipa,</para>
  <para style="q2" vid="PSA 95:7">ne nnwankuo a ɔhwɛ wɔn so.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">Ɛnnɛ, sɛ mote ne nne a,<verse eid="PSA 95:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 95:8"/>mommpirim mo akoma sɛdeɛ moyɛɛ wɔ Meriba no,</para>
  <para style="q2" vid="PSA 95:8">sɛdeɛ moyɛɛ da no wɔ Masa, ɛserɛ no so no,<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>Ɛhɔ no, mo mpanimfoɔ sɔɔ me hwɛeɛ,</para>
  <para style="q2" vid="PSA 95:9">a na wɔnim deɛ meyɛ maa wɔn.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Me bo fuu saa nnipa no mfeɛ aduanan</para>
  <para style="q2" vid="PSA 95:10">na mekaa sɛ, “Wɔyɛ nnipa a wɔn akoma amane afiri me ho,</para>
  <para style="q2" vid="PSA 95:10">na wɔanhunu mʼakwan.”<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Ɛno enti mekaa ntam wɔ mʼabufuo mu sɛ,</para>
  <para style="q2" vid="PSA 95:11">“Wɔrenhyɛne mʼahomegyeɛ mu da.”<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">Dwom 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Monto dwom foforɔ mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 96:1">asase nyinaa monto dwom mma <char style="nd">Awurade</char>.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Monto dwom mma <char style="nd">Awurade</char>, na monkamfo ne din;</para>
  <para style="q2" vid="PSA 96:2">mompae mu nka ne nkwagyeɛ no daa daa.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Monka nʼanimuonyam wɔ amanaman mu,</para>
  <para style="q2" vid="PSA 96:3">monka nʼanwanwadeɛ a wayɛ wɔ nnipa mu.<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>
    <char style="nd">Awurade</char> yɛ kɛseɛ na ɔfata ayɛyie;</para>
  <para style="q2" vid="PSA 96:4">ɛsɛ sɛ wɔsuro no sene anyame nyinaa.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Anyame a wɔwɔ aman foforɔ so yɛ ahoni bi kwa,</para>
  <para style="q2" vid="PSA 96:5">nanso <char style="nd">Awurade</char> na ɔbɔɔ ɔsoro.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Animuonyam ne kɛseyɛ wɔ nʼanim;</para>
  <para style="q2" vid="PSA 96:6">ahoɔden ne animuonyam wɔ ne kronkronbea hɔ.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>Momfa mma <char style="nd">Awurade</char>, Ao amanaman mmusuakuo,</para>
  <para style="q2" vid="PSA 96:7">momfa animuonyam ne tumi mma <char style="nd">Awurade</char>.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Momfa animuonyam ne din a ɛfata mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 96:8">momfa afɔrebɔdeɛ nhyɛne nʼadihɔ hɔ.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Monsɔre <char style="nd">Awurade</char> wɔ ne kronkronyɛ fɛfɛ mu;</para>
  <para style="q2" vid="PSA 96:9">asase nyinaa momma mo ho mpopo wɔ nʼanim.<verse eid="PSA 96:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Monka nkyerɛ aman nyinaa sɛ, “<char style="nd">Awurade</char> di ɔhene.”</para>
  <para style="q2" vid="PSA 96:10">Wɔabɔ asase atim hɔ pintinn na ɛnhinhim;</para>
  <para style="q2" vid="PSA 96:10">ɔde pɛpɛyɛ bɛbu nnipa atɛn.<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Momma ɔsorosoro ani nnye, na asase nni ahurisie;</para>
  <para style="q2" vid="PSA 96:11">momma ɛpo ne emu nneɛma nyinaa nworo;<verse eid="PSA 96:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 96:12"/>momma mfuo ne so nneɛma nyinaa mmɔ ose.</para>
  <para style="q1" vid="PSA 96:12">Nnua a ɛwɔ kwaeɛm de ahosɛpɛ bɛto dwom;<verse eid="PSA 96:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 96:13"/>wɔbɛto dwom wɔ <char style="nd">Awurade</char> anim, ɛfiri sɛ ɔreba,</para>
  <para style="q2" vid="PSA 96:13">ɔreba abɛbu asase no atɛn.</para>
  <para style="q1" vid="PSA 96:13">Ɔde tenenee bɛbu ewiase atɛn</para>
  <para style="q2" vid="PSA 96:13">na woabu nnipa nso atɛn wɔ ne nokorɛ mu.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">Dwom 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>
    <char style="nd">Awurade</char> di ɔhene, ma asase ani nnye;</para>
  <para style="q2" vid="PSA 97:1">ma nsupɔ ahodoɔ nsɛpɛ wɔn ho.<verse eid="PSA 97:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Omununkum ne esum kabii atwa ne ho ahyia;</para>
  <para style="q2" vid="PSA 97:2">tenenee ne atɛntenenee yɛ nʼahennwa no fapem.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Ogya di nʼanim</para>
  <para style="q2" vid="PSA 97:3">na ɛhye nʼatamfoɔ wɔ afanan nyinaa.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Nʼanyinam hran ewiase;</para>
  <para style="q2" vid="PSA 97:4">asase ahunu, na ne ho popo.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Mmepɔ nane sɛ nku wɔ <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 97:5">
    <char style="nd">Awurade</char> a asase nyinaa wɔ no no anim.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Ɔsoro pae mu ka ne tenenee kyerɛ</para>
  <para style="q2" vid="PSA 97:6">na aman nyinaa hunu nʼanimuonyam.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Ahonisomfoɔ nyinaa anim agu ase,</para>
  <para style="q2" vid="PSA 97:7">wɔn a wɔde abosomhuhuo hoahoa wɔn ho no,</para>
  <para style="q2" vid="PSA 97:7">anyame nyinaa monsɔre no.<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Sion te, na ne ho sɛpɛ no</para>
  <para style="q2" vid="PSA 97:8">na Yuda nkuraase ani gye</para>
  <para style="q2" vid="PSA 97:8">Ao <char style="nd">Awurade</char>, ɛsiane wʼatɛntenenee enti.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Wo, Ao <char style="nd">Awurade</char> ne Ɔsorosoroni wɔ asase so nyinaa;</para>
  <para style="q2" vid="PSA 97:9">wɔama wo so pa ara wɔ anyame nyinaa mu.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>Ma wɔn a wɔdɔ <char style="nd">Awurade</char> no nkyiri bɔne,</para>
  <para style="q2" vid="PSA 97:10">ɔbɔ ne nkurɔfoɔ a wɔyɛ nokwafoɔ no ho ban</para>
  <para style="q2" vid="PSA 97:10">na ɔgye wɔn firi amumuyɛfoɔ nsam.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Hann to gu teneneefoɔ so</para>
  <para style="q2" vid="PSA 97:11">na anigyeɛ ba wɔn a wɔn akoma mu teɛ so.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Momma mo ani nnye <char style="nd">Awurade</char> mu, mo teneneefoɔ nyinaa,</para>
  <para style="q2" vid="PSA 97:12">na monkamfo ne din kronkron no.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">Dwom 98</para>
  <para style="d">Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>Monto dwom foforɔ mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 98:1">ɛfiri sɛ wayɛ anwanwadeɛ bebree;</para>
  <para style="q1" vid="PSA 98:1">ne nsa nifa ne ne basa kronkron no</para>
  <para style="q2" vid="PSA 98:1">anya nkwagyeɛ ama no.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>
    <char style="nd">Awurade</char> ama wɔahunu ne nkwagyeɛ</para>
  <para style="q2" vid="PSA 98:2">na wada ne tenenee adi akyerɛ amanaman no.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Wakae nʼadɔeɛ</para>
  <para style="q2" vid="PSA 98:3">ne ne nokorɛ a ɔdi akyerɛ Israelfoɔ;</para>
  <para style="q1" vid="PSA 98:3">asase ano nyinaa ahunu</para>
  <para style="q2" vid="PSA 98:3">yɛn Onyankopɔn nkwagyeɛ.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Asase nyinaa mommɔ ose mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 98:4">momfa nnwontoɔ nni ahurisie;<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>Momfa sankuo nto dwom mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 98:5">sankuo ne nnwontoɔ nnyegyeɛ,<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>momfa totorobɛnto ne nnwennini mmɛn,</para>
  <para style="q2" vid="PSA 98:6">nteam ahosɛpɛ so wɔ <char style="nd">Awurade</char>, yɛn ɔhene no anim.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Ɛpo ne abɔdeɛ a ɛwɔ mu nyinaa monworo so;</para>
  <para style="q2" vid="PSA 98:7">asase ne wɔn a wɔte soɔ nyinaa.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Momma nsubɔntene mmɔ wɔn nsam,</para>
  <para style="q2" vid="PSA 98:8">mmepɔ nka mmom nto ahurisie dwom;<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>ma wɔnto dwom wɔ <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 98:9">ɛfiri sɛ ɔreba abɛbu ewiase atɛn.</para>
  <para style="q1" vid="PSA 98:9">Ɔde tenenee bɛbu ewiase atɛn</para>
  <para style="q2" vid="PSA 98:9">na ɔde pɛpɛyɛ abu nnipa atɛn.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">Dwom 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>
    <char style="nd">Awurade</char> di ɔhene,</para>
  <para style="q2" vid="PSA 99:1">momma amanaman no ho mpopo;</para>
  <para style="q1" vid="PSA 99:1">ɔte nʼahennwa so wɔ Kerubim ntam,</para>
  <para style="q2" vid="PSA 99:1">ma asase nwoso.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>
    <char style="nd">Awurade</char> a ɔwɔ Sion yɛ kɛseɛ;</para>
  <para style="q2" vid="PSA 99:2">wɔama ne so wɔ amanaman nyinaa mu.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Ma wɔnkamfo wo din a ɛso na ɛyɛ nwanwa no.</para>
  <para style="q2" vid="PSA 99:3">Ɔyɛ kronkron.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Ɔhene no yɛ kɛseɛ, ɔdɔ atɛntenenee,</para>
  <para style="q2" vid="PSA 99:4">woama pɛpɛyɛ atim;</para>
  <para style="q1" vid="PSA 99:4">wayɛ deɛ ɛyɛ na ɛtene</para>
  <para style="q2" vid="PSA 99:4">wɔ Yakob mu.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Momma <char style="nd">Awurade</char>, yɛn Onyankopɔn so</para>
  <para style="q2" vid="PSA 99:5">na monsɔre no wɔ ne nan ntiasoɔ anim;</para>
  <para style="q2" vid="PSA 99:5">ɔyɛ kronkron.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Na Mose ne Aaron ka nʼasɔfoɔ no ho,</para>
  <para style="q2" vid="PSA 99:6">na Samuel ka wɔn a wɔbɔɔ ne din no ho;</para>
  <para style="q1" vid="PSA 99:6">wɔfrɛɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 99:6">na ɔgyee wɔn so.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>Ɔfiri omununkum dum mu kasa kyerɛɛ wɔn;</para>
  <para style="q2" vid="PSA 99:7">wɔdii mmara ne ahyɛdeɛ a ɔmaa wɔn no so.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>Ao <char style="nd">Awurade</char>, yɛn Onyankopɔn,</para>
  <para style="q2" vid="PSA 99:8">wogyee wɔn so;</para>
  <para style="q1" vid="PSA 99:8">woyɛɛ bɔnefakyɛ Onyankopɔn maa Israel,</para>
  <para style="q2" vid="PSA 99:8">nanso wɔtwee wɔn aso wɔ wɔn nnebɔne ho.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Momma <char style="nd">Awurade</char> yɛn Onyankopɔn so</para>
  <para style="q2" vid="PSA 99:9">na monsɔre no wɔ ne bepɔ kronkron no so,</para>
  <para style="q2" vid="PSA 99:9">na <char style="nd">Awurade</char> yɛn Onyankopɔn yɛ kronkron.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">Dwom 100</para>
  <para style="d">Ayɛyie Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>Mommɔ ose mma <char style="nd">Awurade</char>, asase nyinaa<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>Momfa ahosɛpɛ nsom <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 100:2">momfa anigyeɛ nnwom mmra nʼanim.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Monhunu sɛ <char style="nd">Awurade</char> yɛ Onyankopɔn;</para>
  <para style="q2" vid="PSA 100:3">ɔno na ɔyɛɛ yɛn, na yɛyɛ ne dea;</para>
  <para style="q2" vid="PSA 100:3">yɛyɛ ne nkurɔfoɔ ne nʼadidibea nnwan.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Momfa aseda nhyɛne nʼapono mu</para>
  <para style="q2" vid="PSA 100:4">na momfa nkamfo nkɔ nʼadihɔ;</para>
  <para style="q2" vid="PSA 100:4">momfa aseda mma no, na monkamfo ne din.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>
    <char style="nd">Awurade</char> yɛ; na nʼadɔeɛ wɔ hɔ daa;</para>
  <para style="q2" vid="PSA 100:5">ne nokorɛdie kɔduru awoɔ ntoatoasoɔ nyinaa so.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">Dwom 101</para>
  <para style="d">Dawid Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>Mɛto wo dɔ ne wo tenenee ho dwom;</para>
  <para style="q2" vid="PSA 101:1">Ao <char style="nd">Awurade</char>, mɛto ayɛyie dwom ama wo.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Mɛhwɛ yie abu ɔbra a ɛho teɛ.</para>
  <para style="q2" vid="PSA 101:2">Dabɛn na wobɛba me nkyɛn?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">Mede akoma a afɔdie nni mu</para>
  <para style="q2" vid="PSA 101:2">bɛnante me fie.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Meremfa mʼani nsi</para>
  <para style="q2" vid="PSA 101:3">adeɛ a ɛyɛ tane biara so.</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">Mekyiri nnipa a wɔnni gyidie;</para>
  <para style="q2" vid="PSA 101:3">Me ne wɔn nni hwee yɛ.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Nnipa a wɔn akoma yɛ kontonkyi remmɛn me;</para>
  <para style="q2" vid="PSA 101:4">me ne bɔne nni hwee yɛ.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Obiara a ɔdi ne yɔnko ho nsekuro wɔ kɔkoam no,</para>
  <para style="q2" vid="PSA 101:5">ɔno na mɛsɛe;</para>
  <para style="q1" vid="PSA 101:5">deɛ ɔwɔ ahantan ani ne ahomasoɔ akoma,</para>
  <para style="q2" vid="PSA 101:5">ɔno na merennyegye ne so.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Mʼani bɛkɔ anokwafoɔ a wɔwɔ asase no soɔ no so</para>
  <para style="q2" vid="PSA 101:6">na me ne wɔn atena;</para>
  <para style="q1" vid="PSA 101:6">deɛ ne nanteɛ ho nni asɛm no,</para>
  <para style="q2" vid="PSA 101:6">ɔno na ɔbɛsom me.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Deɛ ɔyɛ ɔdaadaafoɔ biara</para>
  <para style="q2" vid="PSA 101:7">rentena me fie;</para>
  <para style="q1" vid="PSA 101:7">deɛ ɔtwa nkontompo no</para>
  <para style="q2" vid="PSA 101:7">rennyina mʼanim.<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Adekyeeɛ biara,</para>
  <para style="q2" vid="PSA 101:8">mɛsɛe amumuyɛfoɔ a wɔwɔ asase yi so nyinaa;</para>
  <para style="q1" vid="PSA 101:8">na mapam ɔdebɔneyɛfoɔ biara</para>
  <para style="q2" vid="PSA 101:8">afiri <char style="nd">Awurade</char> kuropɔn mu.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">Dwom 102</para>
  <para style="d">Aberanteɛ mmɔborɔni mpaeɛbɔ. Ɛberɛ a ne home te no na ɔka nʼahometesɛm kyerɛ <char style="nd">Awurade</char>.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>Ao <char style="nd">Awurade</char> tie me mpaeɛbɔ;</para>
  <para style="q2" vid="PSA 102:1">na ma me mmoa ho sufrɛ nnuru wʼanim.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Mfa wʼanim nhinta me</para>
  <para style="q2" vid="PSA 102:2">ɛberɛ a mewɔ ahohiahia mu.</para>
  <para style="q1" vid="PSA 102:2">Brɛ wʼaso ase ma me;</para>
  <para style="q2" vid="PSA 102:2">na sɛ mesu mefrɛ wo a, gye me so ntɛm.<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Me nkwa nna reyera te sɛ wisie;</para>
  <para style="q2" vid="PSA 102:3">me nnompe hyehye te sɛ egya.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Mʼakoma aboto na akusa sɛ ɛserɛ;</para>
  <para style="q2" vid="PSA 102:4">na me kɔn nnɔ aduane.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Mʼapinisie denden enti</para>
  <para style="q2" vid="PSA 102:5">maka honam ne nnompe.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Mete sɛ ɛserɛ so patuo,</para>
  <para style="q2" vid="PSA 102:6">te sɛ ɔpatuo a ɔte mmubuiɛ mu.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Meda hɔ a, mʼani gu so; mayɛ sɛ</para>
  <para style="q2" vid="PSA 102:7">anomaa bi a ɔno nko ara si ɛdan atifi.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Ɛda mu nyinaa mʼatamfoɔ bɔ me akutia.</para>
  <para style="q2" vid="PSA 102:8">Wɔn a wɔdi me ho fɛ no bɔ me din de dome.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Mede nsõ ayɛ mʼaduane</para>
  <para style="q2" vid="PSA 102:9">na mede nisuo fra me nsuo mu<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>ɛsiane wʼabufuhyeɛ denden no enti,</para>
  <para style="q2" vid="PSA 102:10">woama me so, ayi me asi nkyɛn.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Me nkwa nna te sɛ anwummerɛ sunsum;</para>
  <para style="q2" vid="PSA 102:11">na mekusa sɛ ɛserɛ.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>Nanso, wo <char style="nd">Awurade</char>, woyɛ ɔhene daa daa;</para>
  <para style="q2" vid="PSA 102:12">na wo din a ahyeta no te hɔ daa awoɔ ntoatoasoɔ nyinaa mu.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Wobɛsɔre na woahunu Sion mmɔbɔ;</para>
  <para style="q2" vid="PSA 102:13">berɛ aduru sɛ wohunu no mmɔbɔ;</para>
  <para style="q2" vid="PSA 102:13">ɛberɛ a wohyɛeɛ no aso.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Nʼaboɔ som bo ma wʼasomfoɔ;</para>
  <para style="q2" vid="PSA 102:14">ne mfuturo hyɛ wɔn awerɛhoɔ.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Amanaman no bɛsuro <char style="nd">Awurade</char> din;</para>
  <para style="q2" vid="PSA 102:15">asase so ahemfo nyinaa bɛdi wʼanimuonyam ni.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>
    <char style="nd">Awurade</char> bɛkyekyere Sion bio,</para>
  <para style="q2" vid="PSA 102:16">na wapue wɔ nʼanimuonyam mu.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>Ɔbɛtie mmɔborɔfoɔ mpaeɛbɔ;</para>
  <para style="q2" vid="PSA 102:17">na ɔremmu nʼani ngu wɔn sufrɛ so.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Montwerɛ yei mma nkyirimma,</para>
  <para style="q2" vid="PSA 102:18">sɛdeɛ ɛbɛyɛ a wɔn a wɔnnya nwoo wɔn bɛkamfo <char style="nd">Awurade</char>;<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>“<char style="nd">Awurade</char> hwɛɛ fam firi ne kronkronbea wɔ soro hɔ;</para>
  <para style="q2" vid="PSA 102:19">ɔfiri soro hwɛɛ asase,<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>sɛdeɛ ɔbɛte nneduafoɔ apinisie</para>
  <para style="q2" vid="PSA 102:20">na wagyaa wɔn a wɔabu wɔn kumfɔ no.”<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>Enti, wɔbɛpae mu abɔ <char style="nd">Awurade</char> din wɔ Sion</para>
  <para style="q2" vid="PSA 102:21">na wɔakamfo no wɔ Yerusalem,<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>ɛberɛ a amanaman ne ahennie ahodoɔ</para>
  <para style="q2" vid="PSA 102:22">bɛhyiam na wɔasom <char style="nd">Awurade</char>.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Ɔmaa me yɛɛ mmerɛ wɔ ɛberɛ a merenyini.</para>
  <para style="q2" vid="PSA 102:23">Ɔtwaa me nkwa nna so.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>Enti mekaa sɛ,</para>
  <para style="q2" vid="PSA 102:24">“Ao me Onyankopɔn, mfa me nkɔ, wɔ me nkwa nna mfimfini;</para>
  <para style="q2" vid="PSA 102:24">wo mfeɛ wɔ hɔ daa kɔduru awoɔ ntoatoasoɔ nyinaa mu.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Ahyɛaseɛ no, wotoo asase fapem,</para>
  <para style="q2" vid="PSA 102:25">na ɔsoro yɛ wo nsa ano adwuma.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Ne nyinaa bɛtwam, na wo deɛ, wobɛtena hɔ daa;</para>
  <para style="q2" vid="PSA 102:26">wɔbɛtete te sɛ atadeɛ.</para>
  <para style="q1" vid="PSA 102:26">Wobɛsesa wɔn te sɛ ntoma</para>
  <para style="q2" vid="PSA 102:26">na wɔbɛto wɔn agu.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Nanso, wote sɛdeɛ woteɛ,</para>
  <para style="q2" vid="PSA 102:27">na wo mfeɛ to rentwa da.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Wʼasomfoɔ mma bɛtena nkwa mu wɔ wʼanim;</para>
  <para style="q2" vid="PSA 102:28">na wɔn asefoɔ ase bɛtim wɔ wʼanim.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">Dwom 103</para>
  <para style="d">Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>Ao me kra, kamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 103:1">na me mu adeɛ nyinaa nkamfo ne din kronkron no.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Ao me kra, kamfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 103:2">na mma wo werɛ mfiri ne nneyɛeɛ pa nyinaa,<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>ɔno na ɔde wo mfomsoɔ nyinaa kyɛ woɔ</para>
  <para style="q2" vid="PSA 103:3">na ɔsa wo nyarewa nyinaa,<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>ɔgye wo nkwa firi damena mu</para>
  <para style="q2" vid="PSA 103:4">na ɔde adɔeɛ ne mmɔborɔhunu bɔ wo abotire,<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>ɔde nnepa ma wo sɛ wʼapɛdeɛ</para>
  <para style="q2" vid="PSA 103:5">na wo mmeranteberɛ yɛ foforɔ sɛ ɔkɔdeɛ.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>
    <char style="nd">Awurade</char> yɛ adetenenee</para>
  <para style="q2" vid="PSA 103:6">na ɔbu wɔn a wɔhyɛ wɔn so nyinaa atɛntenenee.<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Ɔkyerɛɛ Mose nʼakwan,</para>
  <para style="q2" vid="PSA 103:7">na ɔmaa Israelfoɔ hunuu ne nneyɛɛ.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>Mmɔborɔhunufoɔ ne ɔdomfoɔ ne <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 103:8">ne bo kyɛre fu na nʼadɔeɛ dɔɔso.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Ɔrenkɔ so mmɔ soboɔ,</para>
  <para style="q2" vid="PSA 103:9">na ɔrennya yɛn ho menasepɔ nkɔsi daa;<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>Ɔrenhwɛ yɛn bɔne ne yɛn nni sɛdeɛ ɛfata</para>
  <para style="q2" vid="PSA 103:10">na ɔrentua yɛn nnebɔne so ka sɛdeɛ ɛteɛ.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Na sɛdeɛ ɔsoro ne asase ntam ware no,</para>
  <para style="q2" vid="PSA 103:11">saa ara na nʼadɔeɛ so wɔ wɔn a wɔsuro no so.<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>Sɛdeɛ apueeɛ ne atɔeɛ ntam ware no,</para>
  <para style="q2" vid="PSA 103:12">saa ara na wama yɛn ne yɛn mmarato ntam kwan aware.<verse eid="PSA 103:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Sɛdeɛ agya yam hyehye no ne mma ho no,</para>
  <para style="q2" vid="PSA 103:13">saa ara na <char style="nd">Awurade</char> yam hyehye no ma wɔn a wɔsuro no,<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>na ɔnim sɛdeɛ wɔyɛɛ yɛn,</para>
  <para style="q2" vid="PSA 103:14">ɔkae sɛ yɛyɛ mfuturo.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Ɔdasani deɛ, ne nna te sɛ ɛserɛ,</para>
  <para style="q2" vid="PSA 103:15">ɔyɛ frɔmm sɛ wiram nhwiren;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>sɛ mframa bɔ fa ne so a, na ɔnni hɔ,</para>
  <para style="q2" vid="PSA 103:16">na ne sibea nnim no bio.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Nanso ɛfiri mmerɛsanten kɔsi nnasanten</para>
  <para style="q2" vid="PSA 103:17">
    <char style="nd">Awurade</char> adɔeɛ wɔ wɔn a wɔsuro no so,</para>
  <para style="q2" vid="PSA 103:17">na ne tenenee wɔ wɔn mma mma so,<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>wɔn a wɔdi nʼapam no so</para>
  <para style="q2" vid="PSA 103:18">na wɔkae di ne mmara so.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>
    <char style="nd">Awurade</char> asi nʼahennwa wɔ soro,</para>
  <para style="q2" vid="PSA 103:19">na nʼahennie di adeɛ nyinaa so.<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Monkamfo <char style="nd">Awurade</char>, mo a moyɛ nʼabɔfoɔ,</para>
  <para style="q2" vid="PSA 103:20">mo atumfoɔ a moyɛ nʼahyɛdeɛ,</para>
  <para style="q2" vid="PSA 103:20">mo a motie nʼasɛm.<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Monkamfo <char style="nd">Awurade</char>, ɔsoro asafo nyinaa,</para>
  <para style="q2" vid="PSA 103:21">nʼasomfoɔ a moyɛ nʼapɛdeɛ.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Monkamfo <char style="nd">Awurade</char>, ne nnwuma nyinaa</para>
  <para style="q2" vid="PSA 103:22">deɛ ɛwɔ nʼaheman mu nyinaa.</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">Ao me ɔkra, kamfo <char style="nd">Awurade</char>!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">Dwom 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>Ao me ɔkra, kamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q1" vid="PSA 104:1">Ao <char style="nd">Awurade</char> me Onyankopɔn, woyɛ ɔkɛseɛ!</para>
  <para style="q2" vid="PSA 104:1">Wɔafira tumi ne animuonyam.<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Ɔde hann akata ne ho sɛ atadeɛ;</para>
  <para style="q2" vid="PSA 104:2">ɔtrɛ ɔsoro mu te sɛ ntomadan,<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>na ɔde ne mpia mpunan sisi nsuo so.</para>
  <para style="q1" vid="PSA 104:3">Ɔde omununkum yɛ ne teaseɛnam</para>
  <para style="q2" vid="PSA 104:3">na ɔde nante mframa ntaban so.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Ɔsoma nʼabɔfoɔ sɛ mframa,</para>
  <para style="q2" vid="PSA 104:4">na ɔsoma nʼasomfoɔ sɛ ogyadɛreɛ.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Ɔde asase asi ne fapem so</para>
  <para style="q2" vid="PSA 104:5">na ɛrenhinhim da.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Wode ebunu kataa so sɛ atadeɛ</para>
  <para style="q2" vid="PSA 104:6">na nsuo gyinaa mmepɔ no so.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Nanso wʼanimka maa nsuo no dwaneeɛ,</para>
  <para style="q2" vid="PSA 104:7">wʼaprannaa nnyegyeeɛ ma wɔdwaneeɛ;<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Wɔtenetenee faa mmepɔ so,</para>
  <para style="q2" vid="PSA 104:8">kɔɔ mmɔnhwa mu tɔnn,</para>
  <para style="q2" vid="PSA 104:8">kɔguu baabi a wode ama wɔn no.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Wotoo ɔhyeɛ a wɔrentumi ntra;</para>
  <para style="q2" vid="PSA 104:9">na wɔammɛkata asase so bio.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Ɔma nsuwa tene fa abɔn mu;</para>
  <para style="q2" vid="PSA 104:10">ɛtene fa mmepɔ ntam.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Ɔma wiram mmoa nyinaa nsuo nom;</para>
  <para style="q2" vid="PSA 104:11">ɔma afunumu nsuo de kum wɔn sukɔm.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Ewiem nnomaa nwene wɔn pirebuo wɔ nsuo no ho;</para>
  <para style="q2" vid="PSA 104:12">na wɔto nnwom wɔ nnua no mman so.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Ɔfiri ne soro mpia mu tɔ nsuo gugu mmepɔ so;</para>
  <para style="q2" vid="PSA 104:13">
    <char style="nd">Awurade</char> nnwuma so aba mee asase.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Ɔma ɛserɛ fifiri ma anantwie,</para>
  <para style="q2" vid="PSA 104:14">na ɔbɔɔ nnua maa onipa sɛ ɔnnua</para>
  <para style="q2" vid="PSA 104:14">na ɛmma aduane mfiri asase mu:<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>na onipa anya nsã ama nʼakoma atɔ ne yam,</para>
  <para style="q2" vid="PSA 104:15">na onipa anya ngo ama nʼanim atɔ so,</para>
  <para style="q2" vid="PSA 104:15">na aduane nso akura onipa akoma.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Wɔgugu <char style="nd">Awurade</char> nnua no so yie,</para>
  <para style="q2" vid="PSA 104:16">Lebanon ntweneduro a ɔduaeɛ no.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Ɛso na nnomaa yɛ wɔn mpirebuo</para>
  <para style="q2" vid="PSA 104:17">na asukɔnkɔn nso yɛ nʼatenaeɛ wɔ pepeaa nnua no mu.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Mmepɔ atentene no yɛ wiram mpɔnkye dea;</para>
  <para style="q2" vid="PSA 104:18">na abotan yɛ dwanekɔbea ma amoakua.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Ɔsrane kyerɛ ɛberɛ nkyekyɛmu,</para>
  <para style="q2" vid="PSA 104:19">na owia nim ɛberɛ a ɔkɔtɔ.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Wode esum ba ma ɛyɛ adesaeɛ</para>
  <para style="q2" vid="PSA 104:20">na kwaeɛ mu mmoa nyinaa kɔ ahayɔ.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Gyata bobom pɛ wɔn ahaboa</para>
  <para style="q2" vid="PSA 104:21">wɔhwehwɛ wɔn aduane firi Onyankopɔn hɔ.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Owia pue ma wɔsane wɔn akyi;</para>
  <para style="q2" vid="PSA 104:22">wɔsane kɔdeda wɔn atuo mu.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Afei, onipa kɔ nʼadwuma so</para>
  <para style="q2" vid="PSA 104:23">kɔyɛ adwuma ara kɔsi anwummerɛ.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>Ao <char style="nd">Awurade</char>, wo nnwuma dɔɔso!</para>
  <para style="q2" vid="PSA 104:24">Nyansa mu na woyɛɛ ne nyinaa;</para>
  <para style="q2" vid="PSA 104:24">wʼabɔdeɛ ahyɛ asase so ma.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Ɛpo na ɛda hɔ tɛtrɛɛ hahanaa yi,</para>
  <para style="q2" vid="PSA 104:25">a abɔdeɛ bebree a ɛnni ano,</para>
  <para style="q2" vid="PSA 104:25">akɛseɛ ne nketewa ahyɛ no ma.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Ɛso na ahyɛn di akɔneaba,</para>
  <para style="q2" vid="PSA 104:26">na dɛnkyɛmmirampɔn a woyɛɛ no di agorɔ.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Wɔn nyinaa hwɛ wo kwan</para>
  <para style="q2" vid="PSA 104:27">sɛ wobɛma wɔn wɔn aduane wɔ ɛberɛ a ɛsɛ mu.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Wodema wɔn a, wɔtase;</para>
  <para style="q2" vid="PSA 104:28">wobue wo nsam a, nnepa mee wɔn.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Wode wʼanim hinta wɔn a,</para>
  <para style="q2" vid="PSA 104:29">wɔbɔ hu;</para>
  <para style="q1" vid="PSA 104:29">sɛ wogye wɔn ahomeɛ a,</para>
  <para style="q2" vid="PSA 104:29">wɔwuwu na wɔsane kɔ mfuturo mu.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Sɛ wode wo Honhom no ma wɔn a</para>
  <para style="q2" vid="PSA 104:30">na wɔabɔ wɔn,</para>
  <para style="q2" vid="PSA 104:30">na woyɛ asase ani foforɔ.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Ma <char style="nd">Awurade</char> animuonyam ntena hɔ daa;</para>
  <para style="q2" vid="PSA 104:31">ma <char style="nd">Awurade</char> ani nnye ne nnwuma ho,<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>deɛ ɔhwɛ asase na ɛwosoɔ,</para>
  <para style="q2" vid="PSA 104:32">na ɔde ne nsa ka mmepɔ a wisie firi mu ba.<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Mɛto dwom ama <char style="nd">Awurade</char> me nkwa nna nyinaa;</para>
  <para style="q2" vid="PSA 104:33">sɛ mete ase yi, mɛto ayɛyie dwom ama me Onyankopɔn.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Ɔmma mʼakoma mu mpaeɛbɔ nsɔ nʼani</para>
  <para style="q2" vid="PSA 104:34">ɛberɛ a meregye mʼani wɔ <char style="nd">Awurade</char> mu yi.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Ma nnebɔneyɛfoɔ nyera wɔ asase so;</para>
  <para style="q2" vid="PSA 104:35">na amumuyɛfoɔ ase nhye.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Ao me ɔkra, kamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Kamfo <char style="nd">Awurade</char>.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">Dwom 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>Ɛda <char style="nd">Awurade</char> ase na da ne kɛseyɛ adi.</para>
  <para style="q2" vid="PSA 105:1">Ma ewiase nyinaa nhunu deɛ wayɛ.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Monto dwom mma no, monto ayɛyie dwom mma no;</para>
  <para style="q2" vid="PSA 105:2">monka nʼanwanwadeɛ no nyinaa.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Monhoahoa mo ho wɔ ne din kronkron mu;</para>
  <para style="q2" vid="PSA 105:3">momma wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no nnya akoma mu anigyeɛ.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Momma mo ani nna <char style="nd">Awurade</char> ne nʼahoɔden so;</para>
  <para style="q2" vid="PSA 105:4">na monhwehwɛ nʼanim ɛberɛ biara.<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Monkae anwanwadeɛ a wayɛ</para>
  <para style="q2" vid="PSA 105:5">ne nsɛnkyerɛnneɛ, ne atemmuo a ɔbuiɛ,<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>Ao Abraham mma, Onyankopɔn ɔsomfoɔ,</para>
  <para style="q2" vid="PSA 105:6">Ao Yakob mma a wapa wɔn.<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>Ɔyɛ <char style="nd">Awurade</char>, yɛn Onyankopɔn.</para>
  <para style="q2" vid="PSA 105:7">Nʼahennie da adi wɔ asase so nyinaa.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Ɔkae nʼapam daa nyinaa,</para>
  <para style="q2" vid="PSA 105:8">asɛm a ɔhyɛ maa awoɔ ntoantoasoɔ apem no,<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>apam a ɔne Abraham yɛeɛ no</para>
  <para style="q2" vid="PSA 105:9">ntam a ɔka kyerɛɛ Isak no.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Ɔhyɛɛ mu den maa Yakob sɛ mmara,</para>
  <para style="q2" vid="PSA 105:10">de maa Israel sɛ apam a ɛbɛtena hɔ afebɔɔ.<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>Ɔkaa sɛ, “Mede Kanaan asase no bɛma wo</para>
  <para style="q2" vid="PSA 105:11">sɛ kyɛfa a ɛbɛyɛ wʼagyapadeɛ.”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Ɔkaa yei ɛberɛ a na wɔnnɔɔso,</para>
  <para style="q2" vid="PSA 105:12">ahɔhokuo ketewa bi a wɔwɔ Kanaan.<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>Wɔfirii aman so kɔɔ aman so;</para>
  <para style="q2" vid="PSA 105:13">firii ahemman mu kɔɔ ahemman mu.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Wamma obi anhyɛ wɔn so;</para>
  <para style="q2" vid="PSA 105:14">wɔn enti, ɔkaa ahene anim sɛ:<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“Mommfa mo nsa nka wɔn a masra wɔn ngo;</para>
  <para style="q2" vid="PSA 105:15">na monnyɛ mʼadiyifoɔ bɔne bi.”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Ɔmaa ɛkɔm baa asase no so</para>
  <para style="q2" vid="PSA 105:16">na ɔsɛee akwan a wɔfa so nya wɔn aduane nyinaa;<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>na ɔsomaa ɔbarima bi dii wɔn anim,</para>
  <para style="q2" vid="PSA 105:17">Yosef a wɔtɔn no sɛ akoa no.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Wɔde mpokyerɛ guu ne nan,</para>
  <para style="q2" vid="PSA 105:18">na wɔde dadeɛ nkɔnsɔnkɔnsɔn hyɛɛ ne kɔn,<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>kɔsii sɛ deɛ ɔhyɛɛ ho nkɔm no baa mu,</para>
  <para style="q2" vid="PSA 105:19">kɔsii sɛ <char style="nd">Awurade</char> asɛm no daa no adi sɛ ɔyɛ nokwafoɔ.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>Afei, ɔhene no soma ma wɔkɔgyaa no;</para>
  <para style="q2" vid="PSA 105:20">aman no sodifoɔ gyaa no.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Ɔyɛɛ no ne fiefoɔ so wura,</para>
  <para style="q2" vid="PSA 105:21">deɛ ɔwɔ nyinaa sodifoɔ,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>sɛ ɔnkyerɛ ne mmapɔmma deɛ ɔpɛ</para>
  <para style="q2" vid="PSA 105:22">na ɔnkyerɛ ne mpanimfoɔ nyansa.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Afei, Israel kɔɔ Misraim;</para>
  <para style="q2" vid="PSA 105:23">Yakob kɔtenaa Ham asase so sɛ ɔnanani.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>
    <char style="nd">Awurade</char> maa ne nkurɔfoɔ ase dɔreeɛ;</para>
  <para style="q2" vid="PSA 105:24">ɔyɛɛ wɔn bebree dodo maa wɔn atamfoɔ,<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>wɔn a ɔdanee wɔn akoma sɛ wɔntane ne nkurɔfoɔ</para>
  <para style="q2" vid="PSA 105:25">na wɔmpam nʼasomfoɔ tiri so.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Ɔsomaa ne ɔsomfoɔ Mose,</para>
  <para style="q2" vid="PSA 105:26">ne Aaron a na wayi noɔ no.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Wɔyɛɛ ne nsɛnkyerɛnneɛ nwanwasoɔ wɔ wɔn mu,</para>
  <para style="q2" vid="PSA 105:27">nʼanwanwadeɛ wɔ Ham asase so.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Ɔsomaa esum, na ɔmaa asase duruu sum</para>
  <para style="q2" vid="PSA 105:28">ɛfiri sɛ na wɔate nʼasɛm no so atua.<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Ɔmaa wɔn nsuo nyinaa danee mogya,</para>
  <para style="q2" vid="PSA 105:29">nam so kumm emu mpataa.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Mpɔtorɔ bɛhyɛɛ asase no so ma,</para>
  <para style="q2" vid="PSA 105:30">na wɔhyɛnee ɔman no sodifoɔ mpia mu.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Ɔkasaeɛ, na nwansena bebree</para>
  <para style="q2" vid="PSA 105:31">ne ntontom baa ɔman no mu baabiara.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Ɔmaa wɔn osutɔ danee ampariboɔ</para>
  <para style="q2" vid="PSA 105:32">a anyinam nenam mu wɔ ɔman no nyinaa mu;<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>Ɔsɛee wɔn bobe ne borɔdɔma nnua</para>
  <para style="q2" vid="PSA 105:33">na ɔbubuu ɔman no so nnua pasaa.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>Ɔkasaeɛ, na ntutummɛ baeɛ</para>
  <para style="q2" vid="PSA 105:34">mmɛbɛ a wɔntumi nkan wɔn;<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>wɔwee nhahammono biara a ɛwɔ wɔn asase no so,</para>
  <para style="q2" vid="PSA 105:35">na wɔdii wɔn mfuo so nnuane.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Afei ɔkunkumm wɔn asase so mmakan nyinaa,</para>
  <para style="q2" vid="PSA 105:36">wɔn mmarimayɛ mu aba a ɛdi ɛkan nyinaa.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Ɔyii Israelfoɔ, a wɔso dwetɛ ne sikakɔkɔɔ,</para>
  <para style="q2" vid="PSA 105:37">firii wɔn mmusuakuo mu a obiara ho antɔ kyima.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Misraim ani gyeeɛ ɛberɛ a wɔkɔeɛ,</para>
  <para style="q2" vid="PSA 105:38">ɛfiri sɛ na Israelfoɔ ho hu atɔ wɔn so.<verse eid="PSA 105:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Ɔtrɛɛ omununkum mu kataa wɔn so,</para>
  <para style="q2" vid="PSA 105:39">na ɔde ogya maa wɔn, sɛ ɛnyɛ hann anadwo.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Wɔbisaeɛ, na ɔbrɛɛ wɔn mmoko.</para>
  <para style="q2" vid="PSA 105:40">Ɔmaa ɔsoro aduane mee wɔn.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>Ɔbuee ɔbotan mu maa nsuo firii mu baeɛ;</para>
  <para style="q2" vid="PSA 105:41">na ɛtenee wɔ ɛserɛ no so sɛ asubɔnten.<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>Ɔkaee ne bɔhyɛ kronkron bi a</para>
  <para style="q2" vid="PSA 105:42">ɔhyɛɛ ne ɔsomfoɔ Abraham no.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Ɔyii ne nkurɔfoɔ maa wɔn ani gyeeɛ.</para>
  <para style="q2" vid="PSA 105:43">Wɔn a wapa wɔn no dii ahurisie;<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>ɔde amanaman no nsase maa wɔn,</para>
  <para style="q2" vid="PSA 105:44">na deɛ ebinom abrɛ anya no bɛyɛɛ wɔn agyapadeɛ<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>na wɔahwɛ nʼahyɛdeɛ</para>
  <para style="q2" vid="PSA 105:45">adi ne mmara so.</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">Monyi <char style="nd">Awurade</char> ayɛ.<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">Dwom 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>Monkamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">Monna <char style="nd">Awurade</char> ase na ɔyɛ;</para>
  <para style="q2" vid="PSA 106:1">na nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 106:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Hwan na ɔbɛtumi aka nneɛma akɛseɛ a <char style="nd">Awurade</char> ayɛ?</para>
  <para style="q2" vid="PSA 106:2">Anaasɛ ɔbɛtumi aka ne nkamfo awie?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Nhyira nka wɔn a wɔkɔ so bu atɛntenenee,</para>
  <para style="q2" vid="PSA 106:3">na daa wɔyɛ deɛ ɛyɛ.<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>Ao <char style="nd">Awurade</char>, sɛ wohunu wo nkurɔfoɔ mmɔbɔ a kae me.</para>
  <para style="q2" vid="PSA 106:4">Sɛ wogye wɔn nkwa a, boa me,<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>na manya wɔn a wapa wɔn no yiedie mu kyɛfa,</para>
  <para style="q2" vid="PSA 106:5">na manya wo manfoɔ anigyeɛ no mu kyɛfa</para>
  <para style="q2" vid="PSA 106:5">na me ne wʼagyapadeɛ no abɔ mu de nkamfo ama wo.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Yɛayɛ bɔne sɛdeɛ yɛn nananom yɛeɛ no;</para>
  <para style="q2" vid="PSA 106:6">yɛayɛ mfomsoɔ na yɛadi atirimuɔdensɛm.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Ɛberɛ a yɛn nananom wɔ Misraim no,</para>
  <para style="q2" vid="PSA 106:7">wɔannwene wo nsɛnkyerɛnneɛ ho;</para>
  <para style="q1" vid="PSA 106:7">wɔankae wʼadɔeɛ bebrebe no,</para>
  <para style="q2" vid="PSA 106:7">na wɔtee atua wɔ Ɛpo Kɔkɔɔ no ho.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Nanso, ne din enti ɔgyee wɔn nkwa,</para>
  <para style="q2" vid="PSA 106:8">sɛdeɛ ɔbɛda ne tumi kɛseɛ no adi.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>Ɔteaa Ɛpo Kɔkɔɔ no ma ɛwee;</para>
  <para style="q2" vid="PSA 106:9">ɔde wɔn faa abunu mu te sɛ ɛserɛ so.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Ɔgyee wɔn firii ɔtamfoɔ no nsam;</para>
  <para style="q2" vid="PSA 106:10">deɛ ɔtane wɔn nsam na ɔyii wɔn firiiɛ.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Nsuo kataa wɔn atamfoɔ so;</para>
  <para style="q2" vid="PSA 106:11">na ɔbaako mpo annya nkwa.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>Afei wɔgyee ne bɔhyɛ no diiɛ</para>
  <para style="q2" vid="PSA 106:12">na wɔtoo nʼayɛyie dwom.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Nanso, ntɛm so, wɔn werɛ firii deɛ wayɛ</para>
  <para style="q2" vid="PSA 106:13">na wɔantwɛn nʼagyinatuo.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Akɔnnɔ bɛhyɛɛ wɔn mu wɔ ɛserɛ so hɔ,</para>
  <para style="q2" vid="PSA 106:14">na wɔ asase paradada no so, wɔsɔɔ Onyankopɔn hwɛeɛ,<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>enti ɔmaa wɔn deɛ wɔbisaeɛ,</para>
  <para style="q2" vid="PSA 106:15">nanso, ɔde ɔfɔn yadeɛ baa wɔn so.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Na nsraban mu hɔ wɔn ani beree Mose</para>
  <para style="q2" vid="PSA 106:16">ne Aaron a <char style="nd">Awurade</char> ate ne ho no.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Asase mu buee na ɛmenee Datan</para>
  <para style="q2" vid="PSA 106:17">na ɛsiee Abiram asafo no.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Egya tɔɔ wɔn akyidifoɔ no mu;</para>
  <para style="q2" vid="PSA 106:18">ogyaframa hyee amumuyɛfoɔ no.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Wɔyɛɛ nantwie ba wɔ Horeb</para>
  <para style="q2" vid="PSA 106:19">na wɔkotoo ohoni a wɔde fagudeɛ ayɛ.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Wɔsesaa wɔn Animuonyam.</para>
  <para style="q2" vid="PSA 106:20">Wɔde nantwinini, a ɔwe ɛserɛ nsɛsodeɛ.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Wɔn werɛ firii Onyankopɔn a ɔgyee wɔn nkwa,</para>
  <para style="q2" vid="PSA 106:21">deɛ ɔyɛɛ nneɛma akɛseɛ wɔ Misraim no,<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>nsɛnkyerɛnneɛ a ɔyɛɛ wɔ Ham asase so</para>
  <para style="q2" vid="PSA 106:22">ne nneɛma a ɛyɛ hu wɔ Ɛpo Kɔkɔɔ ho no.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Enti ɔkaa sɛ ɔbɛsɛe wɔn,</para>
  <para style="q2" vid="PSA 106:23">nanso Mose a ɔyɛ deɛ wapa noɔ no</para>
  <para style="q1" vid="PSA 106:23">sɔre gyinaa Onyankopɔn ne nnipa no ntam;</para>
  <para style="q2" vid="PSA 106:23">ɔsrɛɛ no, dwodwoo nʼabufuo no ano sɛdeɛ ɔrensɛe wɔn.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Afei, wɔn ani ansɔ asase fɛfɛ no;</para>
  <para style="q2" vid="PSA 106:24">na wɔannye ne bɔhyɛ anni.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Wɔnwiinwii wɔ wɔn ntomadan mu</para>
  <para style="q2" vid="PSA 106:25">na wɔannyɛ ɔsetie amma <char style="nd">Awurade</char>.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Enti ɔmaa ne nsa so kaa ntam kyerɛɛ wɔn sɛ</para>
  <para style="q2" vid="PSA 106:26">ɔbɛma wɔn atotɔ wɔ ɛserɛ no so,<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ɔbɛma wɔn asefoɔ atotɔ wɔ amanaman mu</para>
  <para style="q2" vid="PSA 106:27">na wabɔ wɔn ahwete nsase nyinaa so.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Wɔde wɔn ho bɔɔ Baal-peor ho</para>
  <para style="q2" vid="PSA 106:28">na wɔdii afɔrebɔdeɛ a wɔde ama anyame a wɔnni nkwa;<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>wɔde wɔn atirimuɔdensɛm hyɛɛ <char style="nd">Awurade</char> abufuo</para>
  <para style="q2" vid="PSA 106:29">na ɔyaredɔm sii wɔn mu.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Na Pinehas sɔre dii agyinamu,</para>
  <para style="q2" vid="PSA 106:30">na <char style="nd">Awurade</char> sii ɔyaredɔm no ano.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Wɔde yei yɛɛ tenenee maa Pinehas</para>
  <para style="q2" vid="PSA 106:31">wɔ awoɔ ntoatoasoɔ a ɛnni awieeɛ a ɛbɛba no mu.<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Meriba nsuo ho nso, wɔhyɛɛ <char style="nd">Awurade</char> abufuo,</para>
  <para style="q2" vid="PSA 106:32">na wɔn enti, ɔhaw baa Mose so,<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>ɛfiri sɛ wɔtee Onyankopɔn Honhom anim atua,</para>
  <para style="q2" vid="PSA 106:33">na asɛm a wannwene ho firii Mose anomu.<verse eid="PSA 106:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Wɔansɛe nnipa no</para>
  <para style="q2" vid="PSA 106:34">sɛdeɛ <char style="nd">Awurade</char> hyɛɛ wɔn no,<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>nanso wɔde wɔn ho frafraa amanaman no</para>
  <para style="q2" vid="PSA 106:35">yɛɛ nneɛma a wɔyɛ no bi.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Wɔsomm wɔn ahoni</para>
  <para style="q2" vid="PSA 106:36">na ɛbɛyɛɛ afidie maa wɔn.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Wɔde wɔn mmammarima</para>
  <para style="q2" vid="PSA 106:37">ne wɔn mmammaa bɔɔ afɔdeɛ maa abosom.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Wɔkaa mogya a ɛdi bem guiɛ;</para>
  <para style="q2" vid="PSA 106:38">wɔn mmammarima ne wɔn mmammaa mogya a</para>
  <para style="q1" vid="PSA 106:38">wɔde bɔɔ afɔdeɛ maa Kanaan ahoni no</para>
  <para style="q2" vid="PSA 106:38">maa asase no ho guu fi.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Wɔde deɛ wɔyɛeɛ no guu wɔn ankasa ho fi;</para>
  <para style="q2" vid="PSA 106:39">wɔnam deɛ wɔyɛeɛ no so bɔɔ adwaman.<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Enti, <char style="nd">Awurade</char> bo fuu ne nkurɔfoɔ;</para>
  <para style="q2" vid="PSA 106:40">na ɔkyirii nʼagyapadeɛ.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Ɔdanee wɔn maa amanaman no,</para>
  <para style="q2" vid="PSA 106:41">na wɔn atamfoɔ dii wɔn so.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Wɔn atamfoɔ hyɛɛ wɔn so</para>
  <para style="q2" vid="PSA 106:42">na wɔkaa wɔn hyɛɛ wɔn tumi ase.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Mpɛn bebree, <char style="nd">Awurade</char> gyee wɔn,</para>
  <para style="q2" vid="PSA 106:43">nanso wɔkɔɔ so tee atua</para>
  <para style="q2" vid="PSA 106:43">na wɔsɛe wɔ wɔn bɔne mu.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Nanso ɔhunuu wɔn ahohiahia</para>
  <para style="q2" vid="PSA 106:44">ɛberɛ a wɔsu frɛɛ noɔ no;<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>Wɔn enti, ɔkaee nʼapam no</para>
  <para style="q2" vid="PSA 106:45">na ɔfirii nʼadɔeɛ kɛseɛ no mu hunuu wɔn mmɔbɔ.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Ɔmaa sodifoɔ a wɔafa wɔn nnommum no</para>
  <para style="q2" vid="PSA 106:46">nyaa ahummɔborɔ maa wɔn.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>Gye yɛn, Ao <char style="nd">Awurade</char> yɛn nkwagyeɛ Onyankopɔn,</para>
  <para style="q2" vid="PSA 106:47">na boaboa yɛn ano firi amanaman so,</para>
  <para style="q1" vid="PSA 106:47">na yɛada wo din kronkron no ase,</para>
  <para style="q2" vid="PSA 106:47">na yɛde nkamfo ahyɛ wo animuonyam.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>Ayɛyie nka <char style="nd">Awurade</char>, Israel Onyankopɔn,</para>
  <para style="q2" vid="PSA 106:48">ɛmfiri mmerɛsanten nkɔsi nnasanten.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Momma nnipa no nyinaa nka sɛ, “Amen!”</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">NWOMA A ƐTƆ SO NNUM</para>
  <para style="mr">
    <ref loc="PSA 107-150">Nnwom 107–150</ref></para>
  <para style="cl">Dwom 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>Monna <char style="nd">Awurade</char> ase na ɔyɛ;</para>
  <para style="q2" vid="PSA 107:1">na nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Momma wɔn a <char style="nd">Awurade</char> agye wɔn nka saa,</para>
  <para style="q2" vid="PSA 107:2">wɔn a wagye wɔn afiri ɔtamfoɔ nsam no,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>wɔn a ɔboaboaa wɔn ano firii nsase soɔ no,</para>
  <para style="q2" vid="PSA 107:3">ɛfiri apueeɛ kɔsi atɔeɛ, atifi kɔsi anafoɔ.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Ebinom kyinkyinii wɔ nsase paradada so,</para>
  <para style="q2" vid="PSA 107:4">a wɔanhunu ɛkwan ankɔ kuropɔn no mu, baabi a wɔbɛtumi anya atenaeɛ.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Ɛkɔm ne sukɔm dee wɔn</para>
  <para style="q2" vid="PSA 107:5">na wɔtotɔɔ baha.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Afei wɔsu frɛɛ <char style="nd">Awurade</char> wɔ wɔn amanehunu mu,</para>
  <para style="q2" vid="PSA 107:6">na ɔgyee wɔn firii wɔn ahohiahia mu.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Ɔde wɔn faa ɛkwan tee so</para>
  <para style="q2" vid="PSA 107:7">baa kuropɔn a wɔtumi tena mu no mu.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔeɛ a ɛnsa da ho</para>
  <para style="q2" vid="PSA 107:8">ne nʼanwanwadeɛ a ɔyɛ ma nnipa.<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>Ɔma wɔn a sukɔm de wɔn nsuo</para>
  <para style="q2" vid="PSA 107:9">na ɔde nnepa hyɛ wɔn a ɛkɔm de wɔn ma.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Ebinom tenaa esum ne awerɛhoɔ mu,</para>
  <para style="q2" vid="PSA 107:10">nneduafoɔ a wɔde dadeɛ nkɔnsɔnkɔnsɔn agu wɔn,<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>ɛfiri sɛ, wɔtee Onyankopɔn nsɛm ho atua</para>
  <para style="q2" vid="PSA 107:11">na wɔbuu Ɔsorosoroni no agyinatuo animtiaa.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Enti ɔgyaa wɔn maa adwuma den;</para>
  <para style="q2" vid="PSA 107:12">wɔsuntisuntiiɛ na wɔannya ɔboafoɔ.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Afei, wɔsu frɛɛ <char style="nd">Awurade</char> wɔ wɔn amanehunu mu,</para>
  <para style="q2" vid="PSA 107:13">na ɔgyee wɔn firii wɔn ahohiahia mu.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Ɔyii wɔn firii esum ne awerɛhoɔ mu</para>
  <para style="q2" vid="PSA 107:14">na ɔbubuu wɔn nkɔnsɔnkɔnsɔn mu.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔeɛ a ɛnsa da ho</para>
  <para style="q2" vid="PSA 107:15">ne nʼanwanwadeɛ a ɔyɛ ma nnipa.<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>Ɔbubu kɔbere mfrafraeɛ apono</para>
  <para style="q2" vid="PSA 107:16">na ɔtwitwa nnadeban mu.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Ebinom bɛyɛɛ nkwaseafoɔ, wɔn atuateɛ enti</para>
  <para style="q2" vid="PSA 107:17">na wɔhunuu amane, wɔn nnebɔne enti.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Wɔkyirii aduane nyinaa</para>
  <para style="q2" vid="PSA 107:18">na wɔtwe bɛnee owuo ɛpono ano.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Afei, wɔsu frɛɛ <char style="nd">Awurade</char>, wɔn amanehunu mu</para>
  <para style="q2" vid="PSA 107:19">na ɔgyee wɔn firii wɔn ahohiahia mu.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>Ɔsomaa nʼasɛm na ɔsaa wɔn yadeɛ;</para>
  <para style="q2" vid="PSA 107:20">na ɔgyee wɔn firii ɛda mu.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔeɛ a ɛnsa da ho</para>
  <para style="q2" vid="PSA 107:21">ne nʼanwanwadeɛ a ɔyɛ ma nnipa.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Momma wɔmmɔ aseda afɔdeɛ</para>
  <para style="q2" vid="PSA 107:22">na wɔmfa ahurisie nnwom nka ne nnwuma ho asɛm.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Ebinom tenaa ahyɛn mu wɔ ɛpo so;</para>
  <para style="q2" vid="PSA 107:23">wɔyɛ adwadifoɔ wɔ nsuo akɛseɛ so.<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>Wɔhunuu <char style="nd">Awurade</char> nnwuma,</para>
  <para style="q2" vid="PSA 107:24">nʼanwanwadeɛ a ɛwɔ ebunu mu.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>Ɔkasaeɛ maa ahum tui</para>
  <para style="q2" vid="PSA 107:25">na ɛkukuruu asorɔkye.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Wɔpagya kɔɔ sorosoro na wɔsiane kɔɔ ebunu mu tɔnn;</para>
  <para style="q2" vid="PSA 107:26">wɔn amanehunu mu no wɔn bo tui.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Wɔkyim totɔɔ ntintan sɛ asabofoɔ;</para>
  <para style="q2" vid="PSA 107:27">na wɔnhunu deɛ wɔnnyɛ bio.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Afei, wɔsu frɛɛ <char style="nd">Awurade</char>, wɔn amanehunu mu,</para>
  <para style="q2" vid="PSA 107:28">na ɔgyee wɔn firii wɔn ahohiahia mu.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>Ɔmaa ahum no yɛɛ dinn;</para>
  <para style="q2" vid="PSA 107:29">ɛpo so asorɔkye ano brɛɛ ase.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Wɔn ani gyeeɛ ɛberɛ a ɛyɛɛ dinn no,</para>
  <para style="q2" vid="PSA 107:30">na ɔkyerɛɛ wɔn ɛkwan de wɔn kɔduruu gyinabea a wɔpɛ.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔeɛ a ɛnsa da ho</para>
  <para style="q2" vid="PSA 107:31">ne nʼanwanwadeɛ a ɔyɛ ma nnipa.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Wɔmma ne so wɔ asafo no mu</para>
  <para style="q2" vid="PSA 107:32">na wɔnkamfo no wɔ mpanimfoɔ nhyiamu ase.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Ɔdanee nsubɔntene maa no yɛɛ ɛserɛ,</para>
  <para style="q2" vid="PSA 107:33">asutene yɛɛ asase wesee,<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>na asasebereɛ danee nkyenenkyene,</para>
  <para style="q2" vid="PSA 107:34">wɔn a wɔte asase no so amumuyɛ enti.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>Ɔdanee ɛserɛ so maa no yɛɛ nsuwansuwa</para>
  <para style="q2" vid="PSA 107:35">na nkyɛkyerɛ yɛɛ sɛ asutene ananmu;<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>Ɛhɔ na ɔde wɔn a ɛkɔm de wɔn kɔsoɛe,</para>
  <para style="q2" vid="PSA 107:36">na wɔkyekyeree kuropɔn tenaa mu.<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>Wɔyɛɛ mfuo ne bobe nturo</para>
  <para style="q2" vid="PSA 107:37">na ɛmaa wɔn nnɔbaeɛ bebree.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>Ɔhyiraa wɔn na wɔn ase dɔreeɛ.</para>
  <para style="q2" vid="PSA 107:38">Wamma wɔn ayɛmmoa dodoɔ so anhwan.<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Afei wɔn dodoɔ so hwaneeɛ</para>
  <para style="q2" vid="PSA 107:39">na nhyɛsoɔ, amanehunu ne awerɛhoɔ brɛɛ wɔn ase;<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>deɛ ɔbu aberempɔn animtiaa no</para>
  <para style="q2" vid="PSA 107:40">ma wɔkyinkyinii asase bonini a ɛkwan nni hɔ so.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Nanso, ɔpagyaa ahiafoɔ firii wɔn ahohia mu</para>
  <para style="q2" vid="PSA 107:41">na ɔmaa wɔn mmusua dɔree sɛ nnwankuo.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Ateneneefoɔ bɛhunu ama wɔn ani gye,</para>
  <para style="q2" vid="PSA 107:42">nanso amumuyɛfoɔ nyinaa bɛmua wɔn ano.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Momma deɛ ɔyɛ onyansafoɔ no mmu yeinom,</para>
  <para style="q2" vid="PSA 107:43">na ɔnnwene <char style="nd">Awurade</char> adɔeɛ kɛseɛ no ho.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">Dwom 108</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>Ao Onyankopɔn, mʼakoma atɔ me yam;</para>
  <para style="q2" vid="PSA 108:1">mede me kra nyinaa bɛto wʼayɛyie dwom.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Monyane, sankuo ne bɛnta!</para>
  <para style="q2" vid="PSA 108:2">Mɛnyane anɔpahema.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>Ao <char style="nd">Awurade</char>, mɛkamfo wo wɔ aman no mu;</para>
  <para style="q2" vid="PSA 108:3">mɛto wo ho dwom wɔ nnipa no mu.<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Wʼadɔeɛ so, ɛkorɔn sene ɔsoro;</para>
  <para style="q2" vid="PSA 108:4">wo nokorɛdie duru ewiem.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>Ao Onyankopɔn, ɛsɛ sɛ wɔma wo so tra ɔsoro,</para>
  <para style="q2" vid="PSA 108:5">na ama wʼanimuonyam aba asase nyinaa so.<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>Fa wo nsa nifa gye yɛn na boa yɛn,</para>
  <para style="q2" vid="PSA 108:6">na ama wɔn a wodɔ wɔn no anya nkwa.<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Onyankopɔn akasa afiri ne kronkronbea sɛ,</para>
  <para style="q2" vid="PSA 108:7">“Nkonim mu na mɛkyɛ Sekem mu</para>
  <para style="q2" vid="PSA 108:7">na masusu Sukot Bɔnhwa.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Gilead yɛ me dea; Manase nso saa ara;</para>
  <para style="q2" vid="PSA 108:8">Efraim yɛ me dadeɛ kyɛ,</para>
  <para style="q2" vid="PSA 108:8">Yuda yɛ mʼahempoma.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Moab yɛ me dwaresɛn,</para>
  <para style="q2" vid="PSA 108:9">Edom so na meto me mpaboa guo;</para>
  <para style="q2" vid="PSA 108:9">Filistia so na mebɔ ose.”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Hwan na ɔde me bɛkɔ kuropɔn a wɔabɔ ho ban no mu?</para>
  <para style="q2" vid="PSA 108:10">Hwan na ɔbɛdi mʼanim akɔ Edom?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Ao Onyankopɔn, ɛnyɛ wo na woapo yɛn?</para>
  <para style="q2" vid="PSA 108:11">Wo ne yɛn nsraadɔm renkɔ ɔsa bio anaa?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>Boa yɛn tia ɔtamfoɔ no,</para>
  <para style="q2" vid="PSA 108:12">na ɔdasani mmoa nka hwee.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Onyankopɔn wɔ yɛn afa yi, yɛbɛdi nkonim,</para>
  <para style="q2" vid="PSA 108:13">na ɔbɛtiatia yɛn atamfoɔ so.</para>
  <para style="d" vid="PSA 108:13">Wɔde ma dwomkyerɛfoɔ no.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">Dwom 109</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>Ao Onyankopɔn a mekamfo woɔ,</para>
  <para style="q2" vid="PSA 109:1">mmua wʼano,<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>na amumuyɛfoɔ ne nkontompofoɔ</para>
  <para style="q2" vid="PSA 109:2">atu wɔn ano agu me so;</para>
  <para style="q2" vid="PSA 109:2">wɔde atorɔ tɛkrɛma akasa atia me.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Wɔde nitansɛm atwa me ho ahyia</para>
  <para style="q2" vid="PSA 109:3">na wɔto hyɛ me so a menkaa wɔn.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>Wɔka nsɛm to me so de tua me nnamfoyɛ so ka,</para>
  <para style="q2" vid="PSA 109:4">nanso meyɛ obi a ɔpɛ mpaeɛbɔ.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Wɔde bɔne tua me papayɛ so ka,</para>
  <para style="q2" vid="PSA 109:5">na wɔde ɔtan tua me nnamfoyɛ so ka.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Ma onipa bɔne bi nsɔre ntia no;</para>
  <para style="q2" vid="PSA 109:6">na Satan nnyina ne nsa nifa so.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Wɔdi nʼasɛm a, ma ɔnni fɔ,</para>
  <para style="q2" vid="PSA 109:7">na ne mpaeɛbɔ mmu no kumfɔ.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Ma ne nkwa nna nyɛ kakraa bi;</para>
  <para style="q2" vid="PSA 109:8">na ɔfoforɔ nsi nʼanan mu sɛ ɔkandifoɔ.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Ma ne mma nyɛ nwisiaa</para>
  <para style="q2" vid="PSA 109:9">na ne yere nyɛ okunafoɔ.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Ma ne mma nkyinkyini nsrɛsrɛ adeɛ;</para>
  <para style="q2" vid="PSA 109:10">ma wɔmpam wɔn mfiri wɔn afie a abubuo no mu.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Ma ɔdefirifoɔ bi mfa deɛ ɔwɔ nyinaa;</para>
  <para style="q2" vid="PSA 109:11">na amanfrafoɔ mfom nʼadwuma so aba.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Mma obiara nhunu no mmɔbɔ</para>
  <para style="q2" vid="PSA 109:12">Mma obiara nhunu ne nwisiaa nso mmɔbɔ.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Ma nʼase nhye,</para>
  <para style="q2" vid="PSA 109:13">na wɔn din nyera wɔ awoɔ ntoatoasoɔ a ɛreba no mu.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Ma wɔnkae nʼagyanom nnebɔne wɔ <char style="nd">Awurade</char> anim;</para>
  <para style="q2" vid="PSA 109:14">na ne maame bɔne no ntena hɔ daa.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Wɔn bɔne nyinaa nka <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 109:15">na wɔankae wɔn bio wɔ asase so.<verse eid="PSA 109:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>Ɛfiri sɛ wannwene da sɛ ɔbɛyɛ adɔeɛ,</para>
  <para style="q2" vid="PSA 109:16">na mmom ɔtaa ahiafoɔ</para>
  <para style="q2" vid="PSA 109:16">mmɔborɔfoɔ ne wɔn a wɔn werɛ ahoɔ de kɔɔ owuo mu.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Nʼani gyee sɛ ɔbɛdome</para>
  <para style="q2" vid="PSA 109:17">enti nnome mmra ne so;</para>
  <para style="q1" vid="PSA 109:17">wampɛ sɛ ɔbɛhyira</para>
  <para style="q2" vid="PSA 109:17">enti nhyira mmɔ no.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Ɔhyɛɛ nnome sɛ atadeɛ;</para>
  <para style="q2" vid="PSA 109:18">ɛnonom kɔɔ ne onipadua mu sɛ nsuo,</para>
  <para style="q2" vid="PSA 109:18">ne ne nnompe mu sɛ ngo.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Ma ɛnyɛ sɛ atadeɛ a ɛkyekyere ne ho,</para>
  <para style="q2" vid="PSA 109:19">ne abɔsoɔ a ɛbɔ no daa.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Ma yei nyɛ <char style="nd">Awurade</char> akatua a ɔde ma me kwaadubɔfoɔ,</para>
  <para style="q2" vid="PSA 109:20">wɔn a wɔka nsɛmmɔne fa me ho no.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Nanso, wo Ao Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 109:21">wo din enti, wo ne me nni no yie;</para>
  <para style="q2" vid="PSA 109:21">firi wʼadɔeɛ mu gye me.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>Ɛfiri sɛ meyɛ ohiani ne deɛ onnibie,</para>
  <para style="q2" vid="PSA 109:22">na mʼakoma atɔ baha wɔ me mu.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Metwam sɛ anwummerɛ sunsumma;</para>
  <para style="q2" vid="PSA 109:23">wɔwoso me kyene sɛ ntutummɛ.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Abuadadie ama me kotodwe mu agogo;</para>
  <para style="q2" vid="PSA 109:24">mafɔn na ama aka me nnompe.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Mayɛ aseredeɛ ama wɔn a wɔbɔ me soboɔ;</para>
  <para style="q2" vid="PSA 109:25">sɛ wohunu me a, wɔwoso wɔn ti.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>Boa me, Ao <char style="nd">Awurade</char> me Onyankopɔn;</para>
  <para style="q2" vid="PSA 109:26">gye me sɛdeɛ wʼadɔeɛ teɛ.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Ma wɔnhunu sɛ ɛyɛ wo nsa,</para>
  <para style="q2" vid="PSA 109:27">na wo na woayɛ, Ao <char style="nd">Awurade</char>.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Wɔbɛdome, nanso wobɛhyira;</para>
  <para style="q2" vid="PSA 109:28">sɛ wɔto hyɛ me so a, wɔn anim bɛgu ase,</para>
  <para style="q2" vid="PSA 109:28">nanso wo ɔsomfoɔ ani bɛgye.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Animguaseɛ bɛdura mʼatamfoɔ ho;</para>
  <para style="q2" vid="PSA 109:29">na akyekyere wɔn ho sɛ atadeɛ.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Mede mʼano bɛma <char style="nd">Awurade</char> so ayɛ no kɛseɛ;</para>
  <para style="q2" vid="PSA 109:30">mɛkamfo no wɔ nnipadɔm mu.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>Ɛfiri sɛ, ɔgyina onnibie nsa nifa so</para>
  <para style="q2" vid="PSA 109:31">sɛ ɔbɛgye no nkwa afiri wɔn a wɔbu no kumfɔ nsam.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">Dwom 110</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ me Wura sɛ,</para>
  <para style="q2" vid="PSA 110:1">“Tena me nifa so</para>
  <para style="q1" vid="PSA 110:1">kɔsi sɛ mede wʼatamfoɔ</para>
  <para style="q2" vid="PSA 110:1">bɛyɛ wo nan ntiasoɔ.”<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>
    <char style="nd">Awurade</char> bɛtrɛ wʼahempoma denden mu afiri Sion;</para>
  <para style="q2" vid="PSA 110:2">na wobɛdi ɔhene wɔ wʼatamfoɔ so.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Wʼakodɔm bɛyi wɔn akoma mu</para>
  <para style="q2" vid="PSA 110:3">ɛda a wobɛkɔ sa.</para>
  <para style="q1" vid="PSA 110:3">Tumi kronkron bɛyɛ wʼaduradeɛ</para>
  <para style="q2" vid="PSA 110:3">na wo mmabunu bɛba wo nkyɛn</para>
  <para style="q2" vid="PSA 110:3">sɛdeɛ bosuo gugu anɔpahema.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>
    <char style="nd">Awurade</char> aka ntam</para>
  <para style="q2" vid="PSA 110:4">na ɔrensesa nʼadwene:</para>
  <para style="q1" vid="PSA 110:4">“Woyɛ daapem ɔsɔfoɔ</para>
  <para style="q2" vid="PSA 110:4">te sɛ Melkisedek sɛso.”<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>
    <char style="nd">Awurade</char> wɔ wo nifa so;</para>
  <para style="q2" vid="PSA 110:5">ɔbɛdwerɛ ahemfo wɔ nʼabufuhyeɛ da no.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Ɔbɛbu amanaman atɛn aboaboa afunu ano;</para>
  <para style="q2" vid="PSA 110:6">na wadwerɛ sodifoɔ a wɔwɔ asase so nyinaa.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Ɔbɛnom asuwa a ɛda ɛkwan nkyɛn mu nsuo</para>
  <para style="q2" vid="PSA 110:7">enti ɔbɛdi nkonim.</para>
  <para style="q1" vid="PSA 110:7">Ɔhene no bɛnom asuwa a ɛda kwankyɛn mu nsuo,</para>
  <para style="q2" vid="PSA 110:7">na wanya ahoɔden, na wagyina nkonimdie mu.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">Dwom 111</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Monkamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">Mɛfiri mʼakoma nyinaa mu ama <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 111:1">wɔ ateneneefoɔ adwabɔ ne asafo no mu.<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>
    <char style="nd">Awurade</char> nnwuma yɛ kɛseɛ;</para>
  <para style="q2" vid="PSA 111:2">wɔn a wɔn ani gye ho nyinaa susu ho.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Ne nnwuma yɛ tumi ne animuonyam,</para>
  <para style="q2" vid="PSA 111:3">na ne tenenee wɔ hɔ daa.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Ɔma yɛkae nʼanwanwadeɛ;</para>
  <para style="q2" vid="PSA 111:4">
    <char style="nd">Awurade</char> yɛ ɔdomfoɔ ne mmɔborɔhunufoɔ.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Ɔma wɔn a wosuro no no aduane;</para>
  <para style="q2" vid="PSA 111:5">ɔkae nʼapam no daa.<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Wakyerɛ ne nkurɔfoɔ tumi a ɛwɔ ne nnwuma mu,</para>
  <para style="q2" vid="PSA 111:6">sɛ ɔde aman afoforɔ nsase ama wɔn.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Ne nsa ano nnwuma yɛ nokorɛ na ɛtene;</para>
  <para style="q2" vid="PSA 111:7">nʼahyɛdeɛ nyinaa mu wɔ ahotosoɔ.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Ɛtim hɔ daa daa,</para>
  <para style="q2" vid="PSA 111:8">nokorɛ ne tenenee mu na ɔyɛeɛ.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Ɔde ɔgyeɛ maa ne nkurɔfoɔ;</para>
  <para style="q2" vid="PSA 111:9">ɔde nʼapam sii hɔ afebɔɔ,</para>
  <para style="q2" vid="PSA 111:9">ne din yɛ kronkron na ɛyɛ hu.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>
    <char style="nd">Awurade</char> suro yɛ nyansa mfitiaseɛ;</para>
  <para style="q2" vid="PSA 111:10">wɔn a wɔdi nʼahyɛdeɛ so nyinaa wɔ nhunumu pa.</para>
  <para style="q2" vid="PSA 111:10">Ɔno na daa ayɛyie wɔ no.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">Dwom 112</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">Nhyira nka onipa a ɔsuro <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 112:1">na ɔnya nʼahyɛdeɛ mu anigyeɛ pii.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Ne mma bɛyɛ atumfoɔ wɔ asase no so;</para>
  <para style="q2" vid="PSA 112:2">teneneefoɔ awoɔ ntoatoasoɔ bɛnya nhyira.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Ahonya ne sika wɔ ne fie,</para>
  <para style="q2" vid="PSA 112:3">na ne tenenee tena hɔ daa.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Esum mu mpo hann pue ma nnipa a wɔtene,</para>
  <para style="q2" vid="PSA 112:4">ma ɔdomfoɔ, mmɔborɔhunufoɔ ne ɔnokwafoɔ.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Yiedie bɛba deɛ ne tirim yɛ mmrɛ na ɔde fɛm kwa.</para>
  <para style="q2" vid="PSA 112:5">Yiedie bɛba deɛ ɔde atɛntenenee yɛ ne nneɛma so.<verse eid="PSA 112:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Ampa ara, ɔrenhinhim da biara da;</para>
  <para style="q2" vid="PSA 112:6">wɔbɛkae onipa tenenee daa.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Ɔte asɛmmɔne a, ɛmmɔ ne hu;</para>
  <para style="q2" vid="PSA 112:7">nʼakoma atim wɔ <char style="nd">Awurade</char> mu ahotosoɔ mu.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Nʼakoma wɔ banbɔ, na ɔnsuro;</para>
  <para style="q2" vid="PSA 112:8">awieeɛ no, ɔde nkonimdie bɛhyia nʼatamfoɔ.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Ɔto nʼakyɛdeɛ pete aman so ma ahiafoɔ,</para>
  <para style="q2" vid="PSA 112:9">ne tenenee wɔ hɔ daa;</para>
  <para style="q2" vid="PSA 112:9">wɔbɛkae wɔn daa na wɔahyɛ wɔn animuonyam.<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Omumuyɛfoɔ bɛhunu ama ayɛ no yea,</para>
  <para style="q2" vid="PSA 112:10">ɔbɛtwere ne se na wafɔn;</para>
  <para style="q2" vid="PSA 112:10">omumuyɛfoɔ tirimpɔ bɛyɛ kwa.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">Dwom 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 113:1"/>
  <para style="q1" vid="PSA 113:1">Ao, mo <char style="nd">Awurade</char> asomfoɔ, monkamfo no,</para>
  <para style="q2" vid="PSA 113:1">monkamfo <char style="nd">Awurade</char> din.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Momma wɔnkamfo <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="PSA 113:2">seesei ne daa nyinaa.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Ɛfiri baabi a owia pue kɔsi faako a ɔkɔtɔ,</para>
  <para style="q2" vid="PSA 113:3">ma wɔnkamfo <char style="nd">Awurade</char> din.<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>Wɔama <char style="nd">Awurade</char> so aman nyinaa so,</para>
  <para style="q2" vid="PSA 113:4">nʼanimuonyam tra ɔsorosoro.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Hwan na ɔte sɛ <char style="nd">Awurade</char> yɛn Onyankopɔn,</para>
  <para style="q2" vid="PSA 113:5">Ɔbaako no a ɔdi ɔhene wɔ ɔsorosoro,<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>ɔno na ɔbɔ ne mu ase</para>
  <para style="q2" vid="PSA 113:6">hwɛ ɔsorosoro ne asase.<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Ɔma ahiafoɔ so firi mfuturo mu</para>
  <para style="q2" vid="PSA 113:7">na ɔpagya onnibie firi nso sie so;<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>ɔde wɔn tena mmapɔmma mu,</para>
  <para style="q2" vid="PSA 113:8">wɔn nkurɔfoɔ mmapɔmma mu.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Ɔbɔ obonini atenaseɛ wɔ ne fie</para>
  <para style="q2" vid="PSA 113:9">sɛ ɔbaatan a nʼani gyeɛ.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">Dwom 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Ɛberɛ a Israelfoɔ firii Misraim,</para>
  <para style="q2" vid="PSA 114:1">na Yakob fiefoɔ firii ananafoɔ asase so no,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Yuda bɛyɛɛ <char style="nd">Awurade</char> kronkronbea</para>
  <para style="q2" vid="PSA 114:2">na Israel bɛyɛɛ nʼahemman.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Ɛpo no huruiɛ na ɛdwaneeɛ,</para>
  <para style="q2" vid="PSA 114:3">Yordan sanee nʼakyi;<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>Mmepɔ hurihurii sɛ nnwennini</para>
  <para style="q2" vid="PSA 114:4">nkokoɔ nso hurihurii sɛ nnwammaa.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>Ɛdeɛn na ɛbaeɛ, Ao ɛpo, na wodwaneeɛ,</para>
  <para style="q2" vid="PSA 114:5">Ao Yordan, na wosanee wʼakyi,<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>mo mmepɔ, na mohurihuri sɛ nnwennini,</para>
  <para style="q2" vid="PSA 114:6">na mo nkokoɔ, mohurihuri sɛ nnwammaa?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>Asase, ma wo ho mpopo wɔ <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 114:7">wɔ Yakob Onyankopɔn anim,<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>ɔno na ɔmaa ɔbotan no danee asubura,</para>
  <para style="q2" vid="PSA 114:8">na abotan a ɛyɛ den danee nsuwa nsuwa no.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">Dwom 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Ɛnyɛ yɛn, Ao <char style="nd">Awurade</char>, ɛnyɛ yɛn</para>
  <para style="q2" vid="PSA 115:1">na wo din na animuonyam nka,</para>
  <para style="q2" vid="PSA 115:1">wʼadɔeɛ ne wo nokorɛdie enti.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Adɛn enti na aman no bisa sɛ,</para>
  <para style="q2" vid="PSA 115:2">“Wɔn Onyankopɔn wɔ he?”<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Yɛn Onyankopɔn wɔ ɔsoro;</para>
  <para style="q2" vid="PSA 115:3">deɛ ɔpɛ biara na ɔyɛ.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>Nanso wɔn ahoni yɛ dwetɛ ne sikakɔkɔɔ a</para>
  <para style="q2" vid="PSA 115:4">wɔde onipa nsa na ayɛ.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Wɔwɔ ano, nanso wɔntumi nkasa;</para>
  <para style="q2" vid="PSA 115:5">wɔwɔ ani, nanso wɔnhunu adeɛ.<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>Wɔwɔ aso, nanso wɔnte asɛm;</para>
  <para style="q2" vid="PSA 115:6">wɔwɔ hwene, nanso wɔnte hwa.<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>Wɔwɔ nsa, nanso wɔnte nka;</para>
  <para style="q2" vid="PSA 115:7">Wɔwɔ nan, nanso wɔnnante.</para>
  <para style="q1" vid="PSA 115:7">Wɔntumi mma nnyegyeeɛ bi mfiri wɔn mene mu.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,</para>
  <para style="q2" vid="PSA 115:8">saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>Ao Israelfoɔ, momfa mo ho nto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 115:9">ɔyɛ mo ɔboafoɔ ne kyɛm.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>Ao Aaron fie, momfa mo ho nto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 115:10">ɔyɛ mo ɔboafoɔ ne kyɛm.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Mo a mosuro no, momfa mo ho nto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 115:11">ɔyɛ mo ɔboafoɔ ne kyɛm.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>
    <char style="nd">Awurade</char> kae yɛn na ɔbɛhyira yɛn:</para>
  <para style="q2" vid="PSA 115:12">Ɔbɛhyira Israel fie,</para>
  <para style="q2" vid="PSA 115:12">ɔbɛhyira Aaron fie<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>Ɔbɛhyira wɔn a wɔsuro <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 115:13">nkumaa ne akɛseɛ nyinaa.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>
    <char style="nd">Awurade</char> mma wʼase nnɔre,</para>
  <para style="q2" vid="PSA 115:14">wo ne wo mma.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>
    <char style="nd">Awurade</char> nhyira wo,</para>
  <para style="q2" vid="PSA 115:15">ɔsoro ne asase Yɛfoɔ no.<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Ɔsorosoro yɛ <char style="nd">Awurade</char> dea,</para>
  <para style="q2" vid="PSA 115:16">nanso asase deɛ, ɔde ama onipa.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Ɛnyɛ awufoɔ na wɔkamfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 115:17">wɔn a wɔkɔ fam dinn no rentumi nkamfo <char style="nd">Awurade</char>.<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>Yɛn na yɛma <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 115:18">ɛnnɛ ne daa nyinaa.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">Dwom 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Medɔ <char style="nd">Awurade</char> ɛfiri sɛ, ɔtee me nne.</para>
  <para style="q2" vid="PSA 116:1">Ɔtee me mmɔborɔhunu su.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Esiane sɛ ɔbrɛɛ nʼaso maa me enti,</para>
  <para style="q2" vid="PSA 116:2">mɛfrɛ no wɔ ɛberɛ a mete ase yi.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Owuo nhoma kyekyeree me,</para>
  <para style="q2" vid="PSA 116:3">ɛda ho ahometeɛ baa me so,</para>
  <para style="q2" vid="PSA 116:3">ɔhaw ne awerɛhoɔ hyɛɛ me so.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Afei mebɔɔ <char style="nd">Awurade</char> din kaa sɛ,</para>
  <para style="q2" vid="PSA 116:4">“Ao <char style="nd">Awurade</char>, gye me nkwa!”<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>
    <char style="nd">Awurade</char> yɛ ɔdomfoɔ ne ɔteneneeni;</para>
  <para style="q2" vid="PSA 116:5">ayamhyehyeɛ ahyɛ yɛn Onyankopɔn ma.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>
    <char style="nd">Awurade</char> bɔ ɔwɛmfoɔ ho ban;</para>
  <para style="q2" vid="PSA 116:6">ɛberɛ a mewɔ ahohiahia mu no, ɔgyee me.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>Nya abotɔyam bio, Ao me kra,</para>
  <para style="q2" vid="PSA 116:7">ɛfiri sɛ <char style="nd">Awurade</char> ne wo adi no yie.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>Na wo, Ao <char style="nd">Awurade</char>, woagye me kra afiri owuo mu;</para>
  <para style="q2" vid="PSA 116:8">woamma mʼani amporo nisuo,</para>
  <para style="q2" vid="PSA 116:8">na woamma me nan ansunti,<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>sɛ mɛnante <char style="nd">Awurade</char> anim</para>
  <para style="q2" vid="PSA 116:9">wɔ ateasefoɔ asase so.<verse eid="PSA 116:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Megye diiɛ; ɛno enti mekaa sɛ,</para>
  <para style="q2" vid="PSA 116:10">“Mewɔ ahohia kɛseɛ mu.”<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Na mʼabasamtuo mu, mekaa sɛ,</para>
  <para style="q2" vid="PSA 116:11">“Nnipa nyinaa yɛ atorofoɔ.”<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Ɛdeɛn na mɛtumi de atua <char style="nd">Awurade</char> ka</para>
  <para style="q2" vid="PSA 116:12">wɔ ne papa a wayɛ ama me nyinaa?<verse eid="PSA 116:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Mɛma nkwagyeɛ kuruwa no so</para>
  <para style="q2" vid="PSA 116:13">na mabɔ <char style="nd">Awurade</char> din.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Mɛdi ɛbɔ a mahyɛ <char style="nd">Awurade</char> no nyinaa so</para>
  <para style="q2" vid="PSA 116:14">wɔ ne nkurɔfoɔ nyinaa anim.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Nʼahotefoɔ wuo</para>
  <para style="q2" vid="PSA 116:15">yɛ aboɔden wɔ <char style="nd">Awurade</char> ani so.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>Ao <char style="nd">Awurade</char>, ampa ara meyɛ wo ɔsomfoɔ;</para>
  <para style="q2" vid="PSA 116:16">meyɛ wo ɔsomfoɔ, wʼafenaa babarima;</para>
  <para style="q2" vid="PSA 116:16">wayi me afiri me mpɔkyerɛ mu.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Mɛbɔ aseda afɔdeɛ ama wo</para>
  <para style="q2" vid="PSA 116:17">na mabɔ <char style="nd">Awurade</char> din.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Mɛdi me bɔ a mahyɛ <char style="nd">Awurade</char> no so</para>
  <para style="q2" vid="PSA 116:18">wɔ ne nkurɔfoɔ nyinaa anim,<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>wɔ adihɔ a ɛwɔ <char style="nd">Awurade</char> fie</para>
  <para style="q2" vid="PSA 116:19">wɔ wo mfimfini, Ao Yerusalem.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">Dwom 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>Aman nyinaa, monkamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 117:1">mo nnipa nyinaa, momma ne din so.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Nʼadɔeɛ so wɔ yɛn so,</para>
  <para style="q2" vid="PSA 117:2">na <char style="nd">Awurade</char> nokorɛ wɔ hɔ daa.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">Dwom 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>Monna <char style="nd">Awurade</char> ase ɛfiri sɛ ɔyɛ,</para>
  <para style="q2" vid="PSA 118:1">na nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Momma Israel nka sɛ,</para>
  <para style="q2" vid="PSA 118:2">“Nʼadɔeɛ wɔ hɔ daa.”<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Momma Aaron fie nka sɛ,</para>
  <para style="q2" vid="PSA 118:3">“Nʼadɔeɛ wɔ hɔ daa.”<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Momma wɔn a wɔsuro <char style="nd">Awurade</char> nka sɛ,</para>
  <para style="q2" vid="PSA 118:4">“Nʼadɔeɛ wɔ hɔ daa.”<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Mʼahohiahia mu, mesu frɛɛ <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 118:5">ɔgyee me so, na ɔma me dee me ho.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>
    <char style="nd">Awurade</char> ne me ɔboafoɔ; enti merensuro.</para>
  <para style="q2" vid="PSA 118:6">Ɛdeɛn na onipa bɛtumi ayɛ me?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>
    <char style="nd">Awurade</char> ne me wɔ hɔ; ɔyɛ me ɔboafoɔ.</para>
  <para style="q2" vid="PSA 118:7">Mede nkonimdie bɛhwɛ mʼatamfoɔ.<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Ɛyɛ sɛ yɛbɛhinta wɔ <char style="nd">Awurade</char> mu</para>
  <para style="q2" vid="PSA 118:8">sene sɛ yɛde yɛn ho bɛto onipa soɔ.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Ɛyɛ sɛ yɛbɛhinta <char style="nd">Awurade</char> mu</para>
  <para style="q2" vid="PSA 118:9">sene sɛ yɛde yɛn ho bɛto mmapɔmma so.<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Amanaman no nyinaa twaa me ho hyiaaɛ,</para>
  <para style="q2" vid="PSA 118:10">nanso <char style="nd">Awurade</char> din mu metwitwaa wɔn guiɛ.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Wɔtwaa me ho hyiaeɛ wɔ baabiara,</para>
  <para style="q2" vid="PSA 118:11">nanso <char style="nd">Awurade</char> din mu, metwitwaa wɔn guiɛ.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Wɔkyere guu me so sɛ nwowa,</para>
  <para style="q2" vid="PSA 118:12">nanso wɔhyee ntɛm so sɛ nkasɛɛ a ogya atɔ mu;</para>
  <para style="q2" vid="PSA 118:12">
    <char style="nd">Awurade</char> din mu metwitwaa wɔn guiɛ.<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Wɔsum me kɔɔ mʼakyi a anka mereyɛ ahwe ase,</para>
  <para style="q2" vid="PSA 118:13">nanso <char style="nd">Awurade</char> boaa me.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>
    <char style="nd">Awurade</char> yɛ mʼahoɔden ne me dwom;</para>
  <para style="q2" vid="PSA 118:14">wayɛ me nkwagyeɛ.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Osebɔ ne nkonimdie</para>
  <para style="q2" vid="PSA 118:15">gyegye wɔ ateneneefoɔ ntomadan mu sɛ,</para>
  <para style="q1" vid="PSA 118:15">“<char style="nd">Awurade</char> nsa nifa ayɛ nneɛma akɛseɛ!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>Wɔapagya <char style="nd">Awurade</char> nsa nifa so;</para>
  <para style="q2" vid="PSA 118:16">
    <char style="nd">Awurade</char> nsa nifa ayɛ nneɛma akɛseɛ!”<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Merenwu, mmom mɛtena ase</para>
  <para style="q2" vid="PSA 118:17">na mapae mu aka deɛ <char style="nd">Awurade</char> ayɛ.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>
    <char style="nd">Awurade</char> atwe mʼaso denden,</para>
  <para style="q2" vid="PSA 118:18">nanso ɔnnyaa me mmaa owuo.<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Bue tenenee apono ma me;</para>
  <para style="q2" vid="PSA 118:19">na mɛhyɛne mu na mede aseda ama <char style="nd">Awurade</char>.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>
    <char style="nd">Awurade</char> ɛpono nie;</para>
  <para style="q2" vid="PSA 118:20">ɛhɔ na ateneneefoɔ bɛfa ahyɛne mu.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Mɛda wo ase ɛfiri sɛ wogyee me so;</para>
  <para style="q2" vid="PSA 118:21">na woayɛ me nkwagyeɛ.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>Ɔboɔ a adansifoɔ no poeɛ no,</para>
  <para style="q2" vid="PSA 118:22">abɛyɛ tweatiboɔ.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>
    <char style="nd">Awurade</char> na ayɛ yei,</para>
  <para style="q2" vid="PSA 118:23">na ɛyɛ nwanwa wɔ yɛn ani so.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Ɛnnɛ yɛ ɛda a <char style="nd">Awurade</char> ayɛ.</para>
  <para style="q2" vid="PSA 118:24">Momma yɛn ani nnye na yɛnni ahurisie.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>Ao <char style="nd">Awurade</char>, gye yɛn nkwa;</para>
  <para style="q2" vid="PSA 118:25">Ao <char style="nd">Awurade</char>, ma yɛn nkɔsoɔ.<verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>Nhyira ne deɛ ɔnam <char style="nd">Awurade</char> din mu reba.</para>
  <para style="q2" vid="PSA 118:26">Yɛhyira wo firi <char style="nd">Awurade</char> fie.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>
    <char style="nd">Awurade</char> yɛ Onyankopɔn,</para>
  <para style="q2" vid="PSA 118:27">na wama ne hann ahyerɛn yɛn so.</para>
  <para style="q1" vid="PSA 118:27">Momfa nnua mman nkura na yɛnto afahyɛ santen</para>
  <para style="q2" vid="PSA 118:27">nkɔ afɔrebukyia no mmɛn ho.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Woyɛ me Onyankopɔn, na meda wo ase;</para>
  <para style="q2" vid="PSA 118:28">wone me Onyankopɔn, na mɛma wo so.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Monna <char style="nd">Awurade</char> ase, ɛfiri sɛ ɔyɛ;</para>
  <para style="q2" vid="PSA 118:29">na nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">Dwom 119</para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>Nhyira nka wɔn a wɔn akwan yɛ pɛ</para>
  <para style="q2" vid="PSA 119:1">na wɔnante sɛdeɛ <char style="nd">Awurade</char> mmara kyerɛ.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Nhyira nka wɔn a wɔkora nʼahyɛdeɛ,</para>
  <para style="q2" vid="PSA 119:2">na wɔfiri wɔn akoma nyinaa mu hwehwɛ no.<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>Wɔnnyɛ mfomsoɔ biara;</para>
  <para style="q2" vid="PSA 119:3">na wɔnam nʼakwan so.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Woayɛ nkyerɛkyerɛ pa ato hɔ</para>
  <para style="q2" vid="PSA 119:4">a ɛsɛ sɛ wɔdi so pɛpɛɛpɛ.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>Ao sɛ mʼakwan bɛyɛ tee</para>
  <para style="q2" vid="PSA 119:5">sɛdeɛ wo ɔhyɛ nsɛm no teɛ.<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Sɛ mehwɛ wʼahyɛdeɛ no a</para>
  <para style="q2" vid="PSA 119:6">ɛnneɛ, anka mʼanim rengu ase.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Mede akoma a emu teɛ bɛkamfo wo</para>
  <para style="q2" vid="PSA 119:7">ɛberɛ a meresua wo mmara a ɛtene no.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Mɛdi wo ɔhyɛ nsɛm so;</para>
  <para style="q2" vid="PSA 119:8">na nnya me korakora.<verse eid="PSA 119:8"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Ho Setie</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Aberanteɛ bɛyɛ dɛn na nʼakwan ho ate?</para>
  <para style="q2" vid="PSA 119:9">Ɛsɛ sɛ ɔdi wʼasɛm so.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Mede mʼakoma nyinaa hwehwɛ wo;</para>
  <para style="q2" vid="PSA 119:10">mma me mmane mfiri wo mmaransɛm ho.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Mede wʼasɛm asie mʼakoma mu</para>
  <para style="q2" vid="PSA 119:11">sɛdeɛ merenyɛ bɔne ntia wo.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>Ao <char style="nd">Awurade</char>, nkamfo wɔ wo;</para>
  <para style="q2" vid="PSA 119:12">kyerɛkyerɛ me wo ɔhyɛ nsɛm.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Mede mʼano ka mmara</para>
  <para style="q2" vid="PSA 119:13">a ɛfiri wʼanomu nyinaa.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Mʼani gye sɛ medi wʼahyɛdeɛ so</para>
  <para style="q2" vid="PSA 119:14">te sɛdeɛ obi anigye ahonya bebree ho no.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Medwendwene wo nkyerɛkyerɛ ho</para>
  <para style="q2" vid="PSA 119:15">na mehwehwɛ wʼakwan mu.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Mʼani gye wo ɔhyɛ nsɛm ho;</para>
  <para style="q2" vid="PSA 119:16">na merentoto wʼasɛm ase.<verse eid="PSA 119:16"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Mu Ahotɔ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Yɛ wo ɔsomfoɔ yie;</para>
  <para style="q2" vid="PSA 119:17">na matena ase adi wʼasɛm so.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Bue mʼani na menhunu anwanwadeɛ a</para>
  <para style="q2" vid="PSA 119:18">ɛwɔ wo mmara no mu.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Meyɛ ɔnanani wɔ asase so;</para>
  <para style="q2" vid="PSA 119:19">mfa wo mmaransɛm no nhinta me.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Me kra tɔ baha ɛberɛ biara</para>
  <para style="q2" vid="PSA 119:20">wɔ wo mmara ho anigyina enti.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Woka ahantanfoɔ anim, wɔn a wɔadome wɔn,</para>
  <para style="q2" vid="PSA 119:21">na wɔmane firi wo mmaransɛm ho no.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Yi kasatia ne animtiabuo firi me mu,</para>
  <para style="q2" vid="PSA 119:22">ɛfiri sɛ medi wʼahyɛdeɛ so.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Ɛwom sɛ sodifoɔ hyia di me ho nsekuro,</para>
  <para style="q2" vid="PSA 119:23">nanso wo ɔsomfoɔ bɛdwendwene wo ɔhyɛ nsɛm ho.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Wʼahyɛdeɛ yɛ mʼanigyedeɛ</para>
  <para style="q2" vid="PSA 119:24">na ɛyɛ me fotufoɔ.<verse eid="PSA 119:24"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Sodie Ho Bɔhyɛ</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Woabrɛ me ase ma meda mfuturo mu.</para>
  <para style="q2" vid="PSA 119:25">Kyɛe me nkwa so sɛdeɛ wʼasɛm no teɛ.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Mesesee mʼakwan na wogyee me so;</para>
  <para style="q2" vid="PSA 119:26">kyerɛkyerɛ me wo ɔhyɛ nsɛm.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Ma mente deɛ ɛwɔ wo nkyerɛkyerɛ mu ase;</para>
  <para style="q2" vid="PSA 119:27">na mɛdwendwene wʼanwanwadeɛ ho.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Awerɛhoɔ ama me ɔkra atɔ baha;</para>
  <para style="q2" vid="PSA 119:28">hyɛ me den sɛdeɛ wʼasɛm no kyerɛ.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Yi me firi nnaadaa akwan so;</para>
  <para style="q2" vid="PSA 119:29">na fa wo mmara so dom me.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Mafa nokorɛ kwan no so;</para>
  <para style="q2" vid="PSA 119:30">mede mʼakoma adi wo mmara akyi.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Ao <char style="nd">Awurade</char>, mekura wo nkyerɛkyerɛ mu denden</para>
  <para style="q2" vid="PSA 119:31">mma mʼanim ngu ase.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Metu mmirika wɔ wo mmaransɛm kwan no so,</para>
  <para style="q2" vid="PSA 119:32">ɛfiri sɛ wama mʼakoma atɔ me yam.<verse eid="PSA 119:32"/></para>
  <para style="s1">Nteaseɛ Ho Mpaeɛbɔ</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>Kyerɛkyerɛ me, Ao <char style="nd">Awurade</char>, na menni wo ɔhyɛ nsɛm so,</para>
  <para style="q2" vid="PSA 119:33">na mɛdi so akɔsi awieeɛ.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Ma me nteaseɛ, na mɛdi wo mmara so,</para>
  <para style="q2" vid="PSA 119:34">na mede mʼakoma nyinaa bɛdi so.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Kyerɛ me wo mmaransɛm kwan no</para>
  <para style="q2" vid="PSA 119:35">na ɛhɔ na menya anigyeɛ.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Dane mʼakoma kɔ wʼahyɛdeɛ ho</para>
  <para style="q2" vid="PSA 119:36">na ɛmfiri pɛsɛmenkomenya ho.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Yi mʼani firi nneɛma hunu so;</para>
  <para style="q2" vid="PSA 119:37">na kyɛe me nkwa so sɛdeɛ wʼasɛm teɛ.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>Di ɛbɔ a woahyɛ wo ɔsomfoɔ no so,</para>
  <para style="q2" vid="PSA 119:38">na wasuro wo.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Yi animguaseɛ a ɛbɔ me hu no firi hɔ,</para>
  <para style="q2" vid="PSA 119:39">ɛfiri sɛ wo mmara yɛ papa.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Mʼani agyina wo nkyerɛkyerɛ no!</para>
  <para style="q2" vid="PSA 119:40">Kyɛe me nkwa so wɔ wo tenenee mu.<verse eid="PSA 119:40"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Ho Ahotosoɔ</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>Ao <char style="nd">Awurade</char>, ma wo dɔ a ɛnsa da no mmra me so,</para>
  <para style="q2" vid="PSA 119:41">wo nkwagyeɛ no sɛdeɛ wo bɔhyɛ no teɛ.<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>Afei, mɛbua deɛ ɔyi me ahi no,</para>
  <para style="q2" vid="PSA 119:42">ɛfiri sɛ mewɔ wʼasɛm mu ahotosoɔ.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Nyi nokwasɛm no mfiri mʼanom,</para>
  <para style="q2" vid="PSA 119:43">ɛfiri sɛ mʼanidasoɔ wɔ wo mmara mu.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Mɛdi wo mmara so ɛberɛ biara</para>
  <para style="q2" vid="PSA 119:44">akɔsi daa apem.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Mede ahofadie bɛnante</para>
  <para style="q2" vid="PSA 119:45">ɛfiri sɛ mahwehwɛ wo nkyerɛkyerɛ.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Mɛka wʼahyɛdeɛ ho asɛm wɔ ahemfo anim</para>
  <para style="q2" vid="PSA 119:46">na mʼanim rengu ase,<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>ɛfiri sɛ mʼani gye wo mmaransɛm ho</para>
  <para style="q2" vid="PSA 119:47">na medɔ no.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Mede anidie ma wo mmaransɛm a medɔ no,</para>
  <para style="q2" vid="PSA 119:48">na medwendwene wo ɔhyɛ nsɛm ho.<verse eid="PSA 119:48"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara No Mu Ahotosoɔ</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Kae asɛm a woaka akyerɛ wo ɔsomfoɔ,</para>
  <para style="q2" vid="PSA 119:49">ɛfiri sɛ woama me anidasoɔ.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Mʼawerɛkyekyerɛ wɔ mʼamanehunu mu ne sɛ:</para>
  <para style="q2" vid="PSA 119:50">Wo bɔhyɛ kyɛe me nkwa so.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Ahantanfoɔ bu me animtia bebree,</para>
  <para style="q2" vid="PSA 119:51">nanso mennane mfiri wo mmara ho.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>Ao <char style="nd">Awurade</char> mekae wo tete mmara no,</para>
  <para style="q2" vid="PSA 119:52">na menya awerɛkyekyerɛ wɔ mu.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Abufuo hyɛ me ma, ɛsiane amumuyɛfoɔ</para>
  <para style="q2" vid="PSA 119:53">a wɔapo wo mmara enti.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Wo ɔhyɛ nsɛm yɛ me dwom tiban</para>
  <para style="q2" vid="PSA 119:54">wɔ baabiara a mesoɛ.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>Ao <char style="nd">Awurade</char>, anadwo mekae wo din,</para>
  <para style="q2" vid="PSA 119:55">na mɛdi wo mmara so.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Yei ne adeɛ a meyɛ da biara,</para>
  <para style="q2" vid="PSA 119:56">medi wo nkyerɛkyerɛ so.<verse eid="PSA 119:56"/></para>
  <para style="s1">Ahofama Wɔ <char style="nd">Awurade</char> Mmara So Die Mu</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>Ao <char style="nd">Awurade</char>, wone me kyɛfa;</para>
  <para style="q2" vid="PSA 119:57">mahyɛ bɔ sɛ mɛdi wo nsɛm so.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Mede mʼakoma nyinaa ahwehwɛ wo;</para>
  <para style="q2" vid="PSA 119:58">hunu me mmɔbɔ sɛdeɛ wo bɔhyɛ no teɛ.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Madwene mʼakwan ho</para>
  <para style="q2" vid="PSA 119:59">na madane mʼanammɔntuo akyerɛ wʼahyɛdeɛ.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Mɛyɛ ntɛm, merentwentwɛn</para>
  <para style="q2" vid="PSA 119:60">sɛ mɛdi wo mmaransɛm soɔ.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Ɛwom sɛ amumuyɛfoɔ de ahoma kyekyere me</para>
  <para style="q2" vid="PSA 119:61">nanso me werɛ remfiri wo mmara.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Ɔdasuom, mesɔre de wʼaseda ma wo</para>
  <para style="q2" vid="PSA 119:62">wo mmara a ɛtene enti.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Meyɛ wɔn a wɔsuro woɔ nyinaa adamfo,</para>
  <para style="q2" vid="PSA 119:63">wɔn a wɔdi wo nkyerɛkyerɛ soɔ nyinaa.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>Ao <char style="nd">Awurade</char>, wʼadɔeɛ ahyɛ asase so ma;</para>
  <para style="q2" vid="PSA 119:64">kyerɛkyerɛ me wo ɔhyɛ nsɛm.<verse eid="PSA 119:64"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara So Die Ho Mfasoɔ</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Wo ne wo ɔsomfoɔ nni no yie</para>
  <para style="q2" vid="PSA 119:65">sɛdeɛ wʼasɛm teɛ, Ao <char style="nd">Awurade</char>.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Kyerɛkyerɛ me nimdeɛ ne atemmuo pa,</para>
  <para style="q2" vid="PSA 119:66">ɛfiri sɛ megye wo mmaransɛm no di.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Ansa na merebɛhunu amane no, mefomm ɛkwan,</para>
  <para style="q2" vid="PSA 119:67">na seesei deɛ, medi wʼasɛm so.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Woyɛ, na deɛ woyɛ nso yɛ;</para>
  <para style="q2" vid="PSA 119:68">kyerɛkyerɛ me wo ɔhyɛ nsɛm.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Ahantanfoɔ de atorɔ afɔre me ho,</para>
  <para style="q2" vid="PSA 119:69">nanso mede mʼakoma nyinaa di wo nkyerɛkyerɛ so.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Wɔn akoma yɛ den na wɔnni tema,</para>
  <para style="q2" vid="PSA 119:70">nanso mʼani gye wo mmara ho.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Ɛyɛ sɛ mehunuu amane</para>
  <para style="q2" vid="PSA 119:71">sɛdeɛ mɛsua wo ɔhyɛ nsɛm.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Mmara a ɛfiri wʼanomu no som bo ma me</para>
  <para style="q2" vid="PSA 119:72">sene dwetɛ ne sikakɔkɔɔ mpempem.<verse eid="PSA 119:72"/></para>
  <para style="s1">Nokorɛ A Ɛwɔ <char style="nd">Awurade</char> Mmara Mu</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Wo nsa na ɛbɔɔ me na ɛnwonoo me;</para>
  <para style="q2" vid="PSA 119:73">ma me nteaseɛ a mede bɛsua wo mmaransɛm.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Sɛ wɔn a wɔsuro wo no hunu me a, ma wɔn ani nnye,</para>
  <para style="q2" vid="PSA 119:74">ɛfiri sɛ mede mʼanidasoɔ ahyɛ wʼasɛm mu.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>Ao <char style="nd">Awurade</char>, menim sɛ wo mmara tene,</para>
  <para style="q2" vid="PSA 119:75">na nokorɛdie mu na woatwe mʼaso.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Ma wʼadɔeɛ a ɛnsa da nkyekyere me werɛ</para>
  <para style="q2" vid="PSA 119:76">sɛdeɛ ɛbɔ a woahyɛ wo ɔsomfoɔ no teɛ.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Ma wʼayamhyehyeɛ mmra me so, na mennya nkwa,</para>
  <para style="q2" vid="PSA 119:77">ɛfiri sɛ mʼani ka wo mmara ho.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Ma ahantanfoɔ ani nwu wɔ bɔne a wɔyɛɛ me,</para>
  <para style="q2" vid="PSA 119:78">nanso, mɛdwendwene wo nkyerɛkyerɛ ho.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Ma wɔn a wɔsuro wo no mmra me nkyɛn,</para>
  <para style="q2" vid="PSA 119:79">wɔn a wɔte wo mmara ase no.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Ma mʼakoma nnya bembuo wɔ wo ɔhyɛ nsɛm ho,</para>
  <para style="q2" vid="PSA 119:80">na mʼanim angu ase.<verse eid="PSA 119:80"/></para>
  <para style="s1">Ɔgyeɛ Mpaeɛbɔ</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Wo nkwagyeɛ ho anigyina ama me ɔkra atɔ baha,</para>
  <para style="q2" vid="PSA 119:81">nanso mede mʼanidasoɔ ahyɛ wʼasɛm mu.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Mahwɛ wo bɔhyɛ anim ama mʼani abu;</para>
  <para style="q2" vid="PSA 119:82">meka sɛ, “Da bɛn na wobɛkyekyere me werɛ?”<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Ɛwom sɛ mete sɛ nsã kotokuo a ɛsɛn wisie ano deɛ,</para>
  <para style="q2" vid="PSA 119:83">nanso me werɛ remfiri wo ɔhyɛ nsɛm.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Wo ɔsomfoɔ ntwɛn nkɔsi da bɛn?</para>
  <para style="q2" vid="PSA 119:84">Da bɛn na wobɛtwe wɔn a wɔtaa me no aso?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Ahantanfoɔ atu amena de asum me afidie,</para>
  <para style="q2" vid="PSA 119:85">a ɛne wo mmara bɔ abira.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Wo mmaransɛm nyinaa mu wɔ ahotosoɔ;</para>
  <para style="q2" vid="PSA 119:86">boa me ɛfiri sɛ nnipa teetee me kwa.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Ɛkaa kakra bi na wɔyi me firi asase so,</para>
  <para style="q2" vid="PSA 119:87">nanso mennyaa wo nkyerɛkyerɛ so die.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Kyɛe me nkwa so sɛdeɛ wʼadɔeɛ teɛ,</para>
  <para style="q2" vid="PSA 119:88">na mɛdi nkyerɛkyerɛ a ɛfiri wʼanomu no so.<verse eid="PSA 119:88"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Mu Gyidie</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>Ao <char style="nd">Awurade</char>, wʼasɛm no tim hɔ daa;</para>
  <para style="q2" vid="PSA 119:89">ɛgyina hɔ pintinn wɔ ɔsorosoro.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Wo nokorɛdie kɔ so wɔ awoɔ ntoatoasoɔ nyinaa mu;</para>
  <para style="q2" vid="PSA 119:90">wode asase sii hɔ, na ɛtim hɔ.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Wo mmara wɔ hɔ bɛsi ɛnnɛ,</para>
  <para style="q2" vid="PSA 119:91">na nneɛma nyinaa som wo.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Sɛ mʼani anka wo mmara no ho a,</para>
  <para style="q2" vid="PSA 119:92">anka mʼamanehunu akum me.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Me werɛ remfiri wo nkyerɛkyerɛ no,</para>
  <para style="q2" vid="PSA 119:93">ɛfiri sɛ ɛno so na wonam akyɛe me nkwa so.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Gye me nkwa, na meyɛ wo dea;</para>
  <para style="q2" vid="PSA 119:94">na mahwehwɛ wo nkyerɛkyerɛ no.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Amumuyɛfoɔ retwɛn sɛ wɔbɛsɛe me,</para>
  <para style="q2" vid="PSA 119:95">nanso, mɛdwendwene wʼahyɛdeɛ ho.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Mahunu sɛ pɛyɛ nyinaa wɔ deɛ ɛkɔpem;</para>
  <para style="q2" vid="PSA 119:96">nanso wo mmaransɛm no nni hyeɛ.<verse eid="PSA 119:96"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Ho Ɔdɔ</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>Ao medɔ wo mmara no!</para>
  <para style="q2" vid="PSA 119:97">Medwendwene ho ɛda mu nyinaa.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Wo mmaransɛm ma me hunu nyansa sene mʼatamfoɔ,</para>
  <para style="q2" vid="PSA 119:98">ɛfiri sɛ ɛwɔ me nkyɛn daa.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Mewɔ nhunumu sene mʼakyerɛkyerɛfoɔ nyinaa,</para>
  <para style="q2" vid="PSA 119:99">ɛfiri sɛ medwendwene wʼahyɛdeɛ ho.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Mewɔ nteaseɛ sene mpanimfoɔ,</para>
  <para style="q2" vid="PSA 119:100">ɛfiri sɛ medi wo nkyerɛkyerɛ so.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Memfaa me nan nsii ɛkwan bɔne biara so</para>
  <para style="q2" vid="PSA 119:101">sɛdeɛ mɛtumi ayɛ ɔsetie ama wʼasɛm.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Memmane memfirii wo mmara ho,</para>
  <para style="q2" vid="PSA 119:102">ɛfiri sɛ wʼankasa na woakyerɛkyerɛ me.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>Wo nsɛm yɛ me dɛ,</para>
  <para style="q2" vid="PSA 119:103">ɛyɛ dɛ sene ɛwoɔ wɔ mʼanom.<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Menya nteaseɛ firi wo nkyerɛkyerɛ mu;</para>
  <para style="q2" vid="PSA 119:104">enti mekyiri ɛkwan bɔne biara.<verse eid="PSA 119:104"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Yɛ Kanea</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Wʼasɛm yɛ me nan ase kanea</para>
  <para style="q2" vid="PSA 119:105">ne mʼakwan so hann.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Maka ntam ahyɛ mu kena sɛ</para>
  <para style="q2" vid="PSA 119:106">mɛdi wo tenenee mmara no so.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Mahunu amane bebree;</para>
  <para style="q2" vid="PSA 119:107">kyɛe me nkwa so, Ao <char style="nd">Awurade</char>, sɛdeɛ wʼasɛm teɛ.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>Ao <char style="nd">Awurade</char>, ma wʼani nsɔ mʼanom nkamfo a ɛfiri me pɛ mu,</para>
  <para style="q2" vid="PSA 119:108">na kyerɛkyerɛ me wo mmara.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Ɛwom sɛ daa metoto me nkwa ase,</para>
  <para style="q2" vid="PSA 119:109">nanso me werɛ remfiri wo mmara.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Amumuyɛfoɔ asum me afidie</para>
  <para style="q2" vid="PSA 119:110">nanso memfom memfirii wo nkyerɛkyerɛ ho.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Wʼahyɛdeɛ yɛ mʼagyapadeɛ afebɔɔ;</para>
  <para style="q2" vid="PSA 119:111">ɛma mʼakoma ani gye.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Mʼakoma ayɛ krado sɛ ɛbɛhwɛ wo ɔhyɛ nsɛm so</para>
  <para style="q2" vid="PSA 119:112">akɔsi awieeɛ.<verse eid="PSA 119:112"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Mu Banbɔ</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Mekyiri nnipa a wɔn adwene yɛ wɔn ntanta,</para>
  <para style="q2" vid="PSA 119:113">na medɔ wo mmara.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Wone me dwanekɔbea ne me kyɛm;</para>
  <para style="q2" vid="PSA 119:114">mede mʼanidasoɔ ahyɛ wʼasɛm mu.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Momfiri me so nkɔ, mo nnebɔneyɛfoɔ,</para>
  <para style="q2" vid="PSA 119:115">na menni me Onyankopɔn mmaransɛm so!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Wowa me sɛdeɛ wo bɔhyɛ no teɛ, na mɛtena nkwa mu;</para>
  <para style="q2" vid="PSA 119:116">mma mʼanidasoɔ nyɛ kwa.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Sɔ me mu, na menya nkwagyeɛ;</para>
  <para style="q2" vid="PSA 119:117">na ɛberɛ biara mɛhwɛ wo ɔhyɛ nsɛm no.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Wopo wɔn a wɔfom wo ɔhyɛ nsɛm nyinaa,</para>
  <para style="q2" vid="PSA 119:118">na wɔn nnaadaa no yɛ ɔkwa.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Woyi amumuyɛfoɔ nyinaa si nkyɛn sɛ dadeben;</para>
  <para style="q2" vid="PSA 119:119">enti medɔ wʼahyɛdeɛ.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Wo ho suro ma me ho popo;</para>
  <para style="q2" vid="PSA 119:120">wo mmara abɔ me hu.<verse eid="PSA 119:120"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara No Setie</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Mayɛ deɛ ɛtene na ɛyɛ pɛ.</para>
  <para style="q2" vid="PSA 119:121">Nnyaa me mma wɔn a wɔhyɛ me soɔ!<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Hwɛ ma wo ɔsomfoɔ nni yie;</para>
  <para style="q2" vid="PSA 119:122">mma ahantanfoɔ nhyɛ me so.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Mahwɛ wo nkwagyeɛ anim ama mʼani abu,</para>
  <para style="q2" vid="PSA 119:123">ɛrehwehwɛ wo bɔhyɛ a ɛtene no.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Wo ne wo ɔsomfoɔ nni no sɛdeɛ wʼadɔeɛ teɛ</para>
  <para style="q2" vid="PSA 119:124">na kyerɛkyerɛ me wo ɔhyɛ nsɛm.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Meyɛ wo ɔsomfoɔ; ma me nhunumu</para>
  <para style="q2" vid="PSA 119:125">na mate wʼahyɛdeɛ ase.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>Ao <char style="nd">Awurade</char>, ɛberɛ aso sɛ woyɛ biribi;</para>
  <para style="q2" vid="PSA 119:126">wɔrebu wo mmara so.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Esiane sɛ medɔ wo mmaransɛm</para>
  <para style="q2" vid="PSA 119:127">sene sikakɔkɔɔ, anaa sikakɔkɔɔ amapa,<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>na medwene sɛ wo nkyerɛkyerɛ nyinaa yɛ enti</para>
  <para style="q2" vid="PSA 119:128">mekyiri ɛkwan bɔne biara.<verse eid="PSA 119:128"/></para>
  <para style="s1">Pere Sɛ Wobɛdi <char style="nd">Awurade</char> Mmara So</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Wʼahyɛdeɛ yɛ nwanwa;</para>
  <para style="q2" vid="PSA 119:129">enti medi so.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Wo nsɛm ase teɛ ma hann;</para>
  <para style="q2" vid="PSA 119:130">na ɛma ntetekwaa nya nteaseɛ.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Mebue mʼanom na megu ahome,</para>
  <para style="q2" vid="PSA 119:131">na mʼani gyina wo mmaransɛm.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Dane wʼani hwɛ me na hunu me mmɔbɔ</para>
  <para style="q2" vid="PSA 119:132">sɛdeɛ woyɛ daa ma wɔn a wɔdɔ wo din no.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Tutu mʼanammɔn sɛdeɛ wʼasɛm no teɛ.</para>
  <para style="q2" vid="PSA 119:133">Mma bɔne biara nni me so.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Gye me firi nnipa nhyɛsoɔ mu,</para>
  <para style="q2" vid="PSA 119:134">na madi wo nkyerɛkyerɛ so.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Ma wʼanim nhyerɛn wo ɔsomfoɔ so</para>
  <para style="q2" vid="PSA 119:135">na kyerɛkyerɛ me wo ɔhyɛ nsɛm.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Nisuo adware me sɛ asutene</para>
  <para style="q2" vid="PSA 119:136">ɛfiri sɛ nnipa nni wo mmara so.<verse eid="PSA 119:136"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Yɛ Pɛ</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>Ɔteneneeni ne wo, Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 119:137">na wo mmara nso yɛ pɛ.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Ahyɛdeɛ a woayɛ no tene;</para>
  <para style="q2" vid="PSA 119:138">ɛyɛ deɛ wɔnya mu ahotosoɔ pa ara.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Abufuo ahyɛ me ma,</para>
  <para style="q2" vid="PSA 119:139">ɛfiri sɛ mʼatamfoɔ bu wɔn ani gu wo nsɛm no.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Wɔasɔ wo bɔhyɛ ahodoɔ no ahwɛ pa ara,</para>
  <para style="q2" vid="PSA 119:140">na wo ɔsomfoɔ dɔ wɔn.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Ɛwom sɛ mennka hwee na memfra deɛ,</para>
  <para style="q2" vid="PSA 119:141">nanso me werɛ mfiri wo nkyerɛkyerɛ.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Wo tenenee wɔ hɔ daa</para>
  <para style="q2" vid="PSA 119:142">na wo mmara no yɛ nokorɛ.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Ɔhaw ne ahohiahia aduru me,</para>
  <para style="q2" vid="PSA 119:143">nanso wo mmaransɛm ma me ahosɛpɛ.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Wʼahyɛdeɛ yɛ nokorɛ daa;</para>
  <para style="q2" vid="PSA 119:144">ma me nteaseɛ na manya nkwa.<verse eid="PSA 119:144"/></para>
  <para style="s1">Ɔgyeɛ Mpaeɛbɔ</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>Ao <char style="nd">Awurade</char>, mede mʼakoma nyinaa mefrɛ wo, gye me so,</para>
  <para style="q2" vid="PSA 119:145">na mɛdi wo ɔhyɛ nsɛm no so.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Mesu mefrɛ wo, gye me nkwa</para>
  <para style="q2" vid="PSA 119:146">na medi wʼahyɛdeɛ so.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Mesɔre anɔpahema, na mesu pɛ mmoa;</para>
  <para style="q2" vid="PSA 119:147">mede me werɛ ahyɛ wo nsɛm mu.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Mʼani gu so anadwo nyinaa,</para>
  <para style="q2" vid="PSA 119:148">na mɛdwendwene wo bɔhyɛ ho.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Tie me nne sɛdeɛ wʼadɔeɛ no teɛ;</para>
  <para style="q2" vid="PSA 119:149">Ao <char style="nd">Awurade</char>, kyɛe me nkwa so sɛdeɛ wo mmara teɛ.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Wɔn a wɔhyehyɛ atirimuɔdensɛm no abɛn,</para>
  <para style="q2" vid="PSA 119:150">nanso wɔne wo mmara ntam ware.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>Ao <char style="nd">Awurade</char>, wo deɛ, wobɛn me,</para>
  <para style="q2" vid="PSA 119:151">na wo mmaransɛm nyinaa yɛ nokorɛ.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Mmerɛ bi a atwam no, mesuaa wʼahyɛdeɛ</para>
  <para style="q2" vid="PSA 119:152">a wode timiiɛ hɔ sɛ ɛntena hɔ daa no.<verse eid="PSA 119:152"/></para>
  <para style="s1">Mmoa Ho Mpaeɛbɔ</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Hwɛ mʼamanehunu na gye me nkwa</para>
  <para style="q2" vid="PSA 119:153">ɛfiri sɛ me werɛ mfirii wo mmara no.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Di mʼasɛm ma me na gye me.</para>
  <para style="q2" vid="PSA 119:154">Kyɛe me nkwa so sɛdeɛ wo bɔhyɛ no teɛ.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Nkwagyeɛ ne atirimuɔdenfoɔ ntam kwan ware,</para>
  <para style="q2" vid="PSA 119:155">ɛfiri sɛ wɔnhwehwɛ wo ɔhyɛ nsɛm no.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>Ao <char style="nd">Awurade</char>, wʼayamhyehyeɛ yɛ kɛseɛ;</para>
  <para style="q2" vid="PSA 119:156">kyɛe me nkwa so sɛdeɛ wo mmara no teɛ.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Atamfoɔ a wɔteetee me dɔɔso,</para>
  <para style="q2" vid="PSA 119:157">nanso memmane memfirii wo nhyehyɛeɛ ho.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Mehwɛ wɔn a wɔnni gyidie no a, wɔn ho yɛ me nwunu,</para>
  <para style="q2" vid="PSA 119:158">ɛfiri sɛ wɔnni wʼasɛm so.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Hwɛ sɛdeɛ mʼani gye wo nkyerɛkyerɛ ho;</para>
  <para style="q2" vid="PSA 119:159">Ao <char style="nd">Awurade</char>, kyɛe me nkwa so sɛdeɛ wʼadɔeɛ teɛ.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Wo nsɛm nyinaa yɛ nokorɛ;</para>
  <para style="q2" vid="PSA 119:160">na wo mmara a ɛtene no to rentwa da.<verse eid="PSA 119:160"/></para>
  <para style="s1">Nya Ahofama Ma <char style="nd">Awurade</char> Mmara</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Sodifoɔ taataa me kwa,</para>
  <para style="q2" vid="PSA 119:161">nanso ɛyɛ wʼasɛm nko ara na mesuro.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Mʼani gye wo bɔhyɛ ho</para>
  <para style="q2" vid="PSA 119:162">te sɛ obi a wanya asadeɛ kɛseɛ.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Mekyiri nkontompo</para>
  <para style="q2" vid="PSA 119:163">na medɔ wo mmara.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Mekamfo wo mprɛnson da biara</para>
  <para style="q2" vid="PSA 119:164">wo mmara a ɛtene no enti.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Wɔn a wɔdɔ wo mmara no wɔ asomdwoeɛ mmoroso,</para>
  <para style="q2" vid="PSA 119:165">na biribiara rentumi mma wɔnsunti.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>Ao <char style="nd">Awurade</char>, metwɛn wo nkwagyeɛ,</para>
  <para style="q2" vid="PSA 119:166">na medi wo mmaransɛm so.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Medi wʼahyɛdeɛ so</para>
  <para style="q2" vid="PSA 119:167">na medɔ no yie.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Medi wo nkyerɛkyerɛ ne wʼahyɛdeɛ so,</para>
  <para style="q2" vid="PSA 119:168">na wonim mʼakwan nyinaa.<verse eid="PSA 119:168"/></para>
  <para style="s1">Mmoa Ho Mpaeɛbɔ</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>Ao <char style="nd">Awurade</char>, ma me sufrɛ nnuru wʼanim;</para>
  <para style="q2" vid="PSA 119:169">ma me nteaseɛ sɛdeɛ wʼasɛm no teɛ.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Ma me nkotosrɛ nnuru wʼanim;</para>
  <para style="q2" vid="PSA 119:170">na gye me sɛdeɛ wo bɔhyɛ no teɛ.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Ma nkamfo nhyɛ mʼanom ma;</para>
  <para style="q2" vid="PSA 119:171">ɛfiri sɛ wokyerɛkyerɛ me wo ɔhyɛ nsɛm.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Ma me tɛkrɛma nto wʼasɛm ho dwom,</para>
  <para style="q2" vid="PSA 119:172">ɛfiri sɛ wo mmaransɛm nyinaa tene.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Yɛ ahoboa bɛboa me,</para>
  <para style="q2" vid="PSA 119:173">ɛfiri sɛ masɔ wo nkyerɛkyerɛ no mu.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>Ao <char style="nd">Awurade</char>, mʼani agyina wo nkwagyeɛ,</para>
  <para style="q2" vid="PSA 119:174">na wo mmara yɛ mʼanigyedeɛ.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Ma me ntena nkwa mu na matumi akamfo wo,</para>
  <para style="q2" vid="PSA 119:175">na wo mmara nso awowa me.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Mafom ɛkwan sɛ odwan a wayera.</para>
  <para style="q2" vid="PSA 119:176">Hwehwɛ wo ɔsomfoɔ,</para>
  <para style="q2" vid="PSA 119:176">ɛfiri sɛ me werɛ mfirii wo mmaransɛm no.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">Dwom 120</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>Mesu frɛ <char style="nd">Awurade</char> wɔ mʼahohiahia mu,</para>
  <para style="q2" vid="PSA 120:1">na ɔgye me so.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>Ao <char style="nd">Awurade</char>, gye me firi atorɔ ano</para>
  <para style="q2" vid="PSA 120:2">ne nnaadaa tɛkrɛma nsam.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Ɛdeɛn na ɔbɛyɛ wo,</para>
  <para style="q2" vid="PSA 120:3">na ɛdeɛn na ɛka ho bio, Ao nnaadaa tɛkrɛma?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Ɔde asraafoɔ bɛmma a ano yɛ nnam</para>
  <para style="q2" vid="PSA 120:4">ne gyasramma bɛtwe wʼaso.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Nnome nka me sɛ mabɛsoɛ Mesek,</para>
  <para style="q2" vid="PSA 120:5">na mete Kedar ntomadan mu!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Matena ase akyɛre dodo</para>
  <para style="q2" vid="PSA 120:6">wɔ wɔn a wɔkyiri asomdwoeɛ mu.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Meyɛ asomdwoeɛ onipa;</para>
  <para style="q2" vid="PSA 120:7">nanso sɛ mekasa a, ɛyɛ ɔko ma wɔn.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">Dwom 121</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>Mema mʼani so kyerɛ mmepɔ no,</para>
  <para style="q2" vid="PSA 121:1">ɛhe na me mmoa firi bɛba?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Me mmoa firi <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 121:2">ɔsoro ne asase yɛfoɔ no.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Ɔremma wo nan nwatiri,</para>
  <para style="q2" vid="PSA 121:3">deɛ ɔhwɛ wo no, ɔrentɔ nko.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>Ampa ara deɛ ɔhwɛ Israel no</para>
  <para style="q2" vid="PSA 121:4">rentɔ nko na ɔrenna.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>
    <char style="nd">Awurade</char> hwɛ wo so;</para>
  <para style="q2" vid="PSA 121:5">
    <char style="nd">Awurade</char> ne wo nwunu wɔ wo nsa nifa so;<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>Owia renhye wo wɔ awiaberɛ mu,</para>
  <para style="q2" vid="PSA 121:6">na ɔsrane nso renha wo anadwo.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>
    <char style="nd">Awurade</char> bɛbɔ wo ho ban afiri ɔhaw nyinaa ho,</para>
  <para style="q2" vid="PSA 121:7">ɔbɛhwɛ wo nkwa so;<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>
    <char style="nd">Awurade</char> bɛhwɛ wʼadifire ne wo efieba so,</para>
  <para style="q2" vid="PSA 121:8">seesei ne daa.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">Dwom 122</para>
  <para style="d">Ɔsoroforɔ dwom. Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>Ɛberɛ a wɔsee me sɛ,</para>
  <para style="q2" vid="PSA 122:1">“Ma yɛnkɔ <char style="nd">Awurade</char> fie” no, mʼani gyeeɛ.<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Yɛgyinagyina wʼapono ano,</para>
  <para style="q2" vid="PSA 122:2">Ao Yerusalem.<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Wɔakyekyere Yerusalem yie sɛ kuropɔn.</para>
  <para style="q2" vid="PSA 122:3">Wɔahyehyɛ mu nneɛma fɛfɛ.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Ɛhɔ na mmusuakuo no korɔ,</para>
  <para style="q2" vid="PSA 122:4">
    <char style="nd">Awurade</char> mmusuakuo no.</para>
  <para style="q1" vid="PSA 122:4">Wɔkɔkamfo <char style="nd">Awurade</char> din</para>
  <para style="q2" vid="PSA 122:4">sɛdeɛ nhyehyɛeɛ a wɔde ama Israel no teɛ.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Ɛhɔ na atemmuo nhennwa no sisi,</para>
  <para style="q2" vid="PSA 122:5">Dawid fie nhennwa no.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Monsrɛ asomdwoeɛ mma Yerusalem sɛ,</para>
  <para style="q2" vid="PSA 122:6">“Ma wɔn a wɔdɔ wo no nnya banbɔ.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Ma asomdwoeɛ mmra wʼafasuo mu</para>
  <para style="q2" vid="PSA 122:7">na banbɔ mmra wʼabankɛsewa mu.”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Me nuanom ne me nnamfonom enti,</para>
  <para style="q2" vid="PSA 122:8">meka sɛ, “Asomdwoeɛ ntena wo mu.”<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>
    <char style="nd">Awurade</char> yɛn Onyankopɔn fie enti,</para>
  <para style="q2" vid="PSA 122:9">mɛhwehwɛ wo nkɔsoɔ.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">Dwom 123</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>Mema mʼani so kyerɛ wo,</para>
  <para style="q2" vid="PSA 123:1">wo a wʼahennwa si ɔsoro.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Sɛdeɛ nkoa ani hwɛ wɔn wura nsa no,</para>
  <para style="q2" vid="PSA 123:2">sɛdeɛ afenaa ani hwɛ nʼawurakwaa nsa no,</para>
  <para style="q1" vid="PSA 123:2">saa ara na yɛn ani hwɛ <char style="nd">Awurade</char>, yɛn Onyankopɔn</para>
  <para style="q2" vid="PSA 123:2">kɔsi sɛ ɔbɛhunu yɛn mmɔbɔ.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Hu yɛn mmɔbɔ, Ao <char style="nd">Awurade</char>, hunu yɛn mmɔbɔ,</para>
  <para style="q2" vid="PSA 123:3">na wɔabu yɛn animtia bebree.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Ahomasofoɔ fɛdie ama yɛabrɛ dodo;</para>
  <para style="q2" vid="PSA 123:4">ahantanfoɔ animtiabuo afono yɛn.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">Dwom 124</para>
  <para style="d">Ɔsoroforɔ dwom. Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>Sɛ anka <char style="nd">Awurade</char> nni yɛn afa a,</para>
  <para style="q2" vid="PSA 124:1">ma Israel nka.<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>Sɛ anka <char style="nd">Awurade</char> nni yɛn afa</para>
  <para style="q2" vid="PSA 124:2">ɛberɛ a nnipa to hyɛɛ yɛn so,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>ɛberɛ a wɔn abufuo sɔree tiaa yɛn a,</para>
  <para style="q2" vid="PSA 124:3">anka wɔmenee yɛn anikann;<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>anka nsuyire no bu faa yɛn so,</para>
  <para style="q2" vid="PSA 124:4">anka ɔhweam no twee yɛn kɔeɛ,<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>anka nsuo a ano yɛ den no</para>
  <para style="q2" vid="PSA 124:5">afa yɛn kɔ.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Nkamfoɔ nka <char style="nd">Awurade</char> a</para>
  <para style="q2" vid="PSA 124:6">wɔamma ho kwan amma wɔamfa wɔn se antete yɛn mu.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Yɛadwane sɛ anomaa</para>
  <para style="q2" vid="PSA 124:7">afiri afirisumfoɔ afidie mu;</para>
  <para style="q1" vid="PSA 124:7">afidie no mu abubu,</para>
  <para style="q2" vid="PSA 124:7">ama yɛanya ɛkwan adwane.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Yɛn mmoa wɔ <char style="nd">Awurade</char> din mu,</para>
  <para style="q2" vid="PSA 124:8">ɔsoro ne asase Yɛfoɔ no.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">Dwom 125</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Wɔn a wɔde wɔn ho to <char style="nd">Awurade</char> so no te sɛ Bepɔ Sion,</para>
  <para style="q2" vid="PSA 125:1">a ɛnwosoɔ na ɛtim hɔ daa.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Sɛdeɛ mmepɔ atwa Yerusalem ho ahyia no,</para>
  <para style="q2" vid="PSA 125:2">saa ara na <char style="nd">Awurade</char> atwa ne nkurɔfoɔ ho ahyia</para>
  <para style="q2" vid="PSA 125:2">seesei ne daa.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Amumuyɛfoɔ ahempoma renka asase a</para>
  <para style="q2" vid="PSA 125:3">wɔde ama teneneefoɔ so.</para>
  <para style="q1" vid="PSA 125:3">Sɛ ɛba saa a, teneneefoɔ</para>
  <para style="q2" vid="PSA 125:3">nam wɔn so bɛyɛ bɔne.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>Ao <char style="nd">Awurade</char>, wɔn a wɔyɛ papa no, yɛ wɔn papa,</para>
  <para style="q2" vid="PSA 125:4">wɔn a wɔtene wɔ akoma mu no, yɛ wɔn papa.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Na wɔn a wɔmane fa akwan kɔntɔnkye so no deɛ,</para>
  <para style="q2" vid="PSA 125:5">
    <char style="nd">Awurade</char> bɛpamo wɔn ne nnebɔneyɛfoɔ.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">Asomdwoeɛ nka Israel.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">Dwom 126</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>Ɛberɛ a <char style="nd">Awurade</char> de Sion firi nnommum sane baeɛ no,</para>
  <para style="q2" vid="PSA 126:1">yɛyɛɛ sɛ nnipa a wɔasoso adaeɛ.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Sereɛ hyɛɛ yɛn anomu ma,</para>
  <para style="q2" vid="PSA 126:2">anigyeɛ nnwom yɛɛ yɛn tɛkrɛma so ma.</para>
  <para style="q1" vid="PSA 126:2">Na wɔkaa wɔ amanaman no mu sɛ,</para>
  <para style="q2" vid="PSA 126:2">“<char style="nd">Awurade</char> ayɛ nneɛma akɛseɛ ama wɔn.”<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>
    <char style="nd">Awurade</char> ayɛ nneɛma akɛseɛ ama yɛn</para>
  <para style="q2" vid="PSA 126:3">na anigyeɛ ahyɛ yɛn ma.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>Ao <char style="nd">Awurade</char>, sane fa yɛn ahonya ma yɛn,</para>
  <para style="q2" vid="PSA 126:4">te sɛ nsuwa nsuwa a ɛwɔ Negeb no.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Wɔn a wɔdua no nisuo mu no</para>
  <para style="q2" vid="PSA 126:5">de anigyeɛ nnwom bɛtwa.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Deɛ ɔde osu firi adie</para>
  <para style="q2" vid="PSA 126:6">na ɔsoa aba kɔdua no,</para>
  <para style="q1" vid="PSA 126:6">ɔde anigyeɛ nnwom bɛsane aba</para>
  <para style="q2" vid="PSA 126:6">a ɔso nnɔbaeɛ afiafi.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">Dwom 127</para>
  <para style="d">Ɔsoroforɔ dwom. Salomo deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>Sɛ <char style="nd">Awurade</char> ansi ɛdan no a,</para>
  <para style="q2" vid="PSA 127:1">adansifoɔ no yɛ ho adwuma kwa.</para>
  <para style="q1" vid="PSA 127:1">Sɛ <char style="nd">Awurade</char> ammɔ kuropɔn no ho ban a,</para>
  <para style="q2" vid="PSA 127:1">awɛmfoɔ no wɛn kwa.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Ɔkwa ara na wosɔre anɔpahema</para>
  <para style="q2" vid="PSA 127:2">na woyɛ adwumaden brɛ kɔsi anadwo,</para>
  <para style="q1" vid="PSA 127:2">ansa na woanya wʼano aduane.</para>
  <para style="q2" vid="PSA 127:2">Ɛyɛ kwa, ɛfiri sɛ, wɔn a ɔdɔ wɔn no, ɔma wɔda.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Mmammarima yɛ agyapadeɛ a ɛfiri <char style="nd">Awurade</char> hɔ,</para>
  <para style="q2" vid="PSA 127:3">na mma yɛ akatua a ɛfiri noɔ.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Mmammarima a wɔwo wɔn mmeranteberɛ mu no</para>
  <para style="q2" vid="PSA 127:4">te sɛ agyan a ɛhyɛ ɔsraani nsam.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Nhyira ne onipa a</para>
  <para style="q2" vid="PSA 127:5">nʼagyan kotokuo ayɛ ma.</para>
  <para style="q1" vid="PSA 127:5">Wɔn anim rengu ase</para>
  <para style="q2" vid="PSA 127:5">ɛberɛ a wɔahyia wɔn atamfoɔ wɔ kuro ɛpono ano.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">Dwom 128</para>
  <para style="d">Ɔsorokorɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>Nhyira ne wɔn a wɔsuro <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 128:1">na wɔnante nʼakwan so.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Wobɛdi wʼadwuma so aba;</para>
  <para style="q2" vid="PSA 128:2">nhyira ne yiedie bɛyɛ wo dea.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Wo yere bɛyɛ sɛ bobe a ɛso aba</para>
  <para style="q2" vid="PSA 128:3">wɔ wo fie;</para>
  <para style="q1" vid="PSA 128:3">na wo mmammarima ayɛ sɛ ngo dua a afifiri</para>
  <para style="q2" vid="PSA 128:3">atwa wo ɛpono ho ahyia.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Yei ne onipa a wɔahyira noɔ,</para>
  <para style="q2" vid="PSA 128:4">deɛ ɔsuro <char style="nd">Awurade</char> no.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>
    <char style="nd">Awurade</char> nhyira wo mfiri Sion</para>
  <para style="q2" vid="PSA 128:5">wo nkwa nna nyinaa;</para>
  <para style="q2" vid="PSA 128:5">na ɔmma wo nhunu Yerusalem nkɔsoɔ,<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>na ɔmma wo ntena ase nhunu wo mma mma.</para>
  <para style="q2" vid="PSA 128:6">Asomdwoeɛ nka Israel.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">Dwom 129</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>“Wɔahyɛ me so pii firi me mmɔfraase,</para>
  <para style="q2" vid="PSA 129:1">ma Israel nka.<verse eid="PSA 129:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>“Wɔahyɛ me so pii firi me mmɔfraase,</para>
  <para style="q2" vid="PSA 129:2">nanso wɔntumi nnii me so nkonim.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Fentemfoɔ afentem mʼakyi</para>
  <para style="q2" vid="PSA 129:3">ayɛ wɔn nkofie atentene.<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>Nanso <char style="nd">Awurade</char> yɛ ɔteneneeni;</para>
  <para style="q2" vid="PSA 129:4">Watwitwa amumuyɛfoɔ nhoma afiri me ho.”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Ma wɔn a wɔtan Sion nyinaa</para>
  <para style="q2" vid="PSA 129:5">mfa animguaseɛ nsane wɔn akyi.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Ma wɔnyɛ sɛ ɛserɛ a ɛwɔ ɔdan atifi,</para>
  <para style="q1" vid="PSA 129:6">ɛnnyini na ahye;<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>Ɛremma otwafoɔ nya biribi wɔ ne nsam,</para>
  <para style="q2" vid="PSA 129:7">na deɛ ɔboaboa ano nso renya hwee nʼabasa so.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Mma wɔn a wɔtwam hɔ nnka sɛ,</para>
  <para style="q2" vid="PSA 129:8">“<char style="nd">Awurade</char> nhyira mmra mo so;</para>
  <para style="q2" vid="PSA 129:8">yɛhyira mo wɔ <char style="nd">Awurade</char> din mu.”<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">Dwom 130</para>
  <para style="d">Ɔsorokorɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>Ao <char style="nd">Awurade</char>, mefiri ebunu mu resu frɛ wo;<verse eid="PSA 130:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2"/>Ao <char style="nd">Awurade</char> tie me nne.</para>
  <para style="q1" vid="PSA 130:2">Wɛn wʼaso</para>
  <para style="q2" vid="PSA 130:2">ma me nkotosrɛ.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>Ao <char style="nd">Awurade</char>, sɛ wobu yɛn bɔne ho nkonta a,</para>
  <para style="q2" vid="PSA 130:3">anka hwan na ɔbɛtumi agyina ano?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Nanso, wowɔ bɔnefakyɛ;</para>
  <para style="q2" vid="PSA 130:4">ɛno enti wɔsuro wo.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Metwɛn <char style="nd">Awurade</char>, me kra twɛn,</para>
  <para style="q2" vid="PSA 130:5">na nʼasɛm mu na mede mʼanidasoɔ ahyɛ.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Me kra twɛne <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 130:6">sene sɛdeɛ awɛmfoɔ twɛne adekyeɛ,</para>
  <para style="q2" vid="PSA 130:6">sene sɛdeɛ awɛmfoɔ twene adekyeɛ.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>Ao Israel, ma wʼani nna <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 130:7">ɛfiri sɛ <char style="nd">Awurade</char> wɔ adɔeɛ a ɛwɔ hɔ daa</para>
  <para style="q2" vid="PSA 130:7">na ɔgyeɛ amapa wɔ ne mu.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>Ɔno ankasa bɛgye Israel</para>
  <para style="q2" vid="PSA 130:8">afiri wɔn bɔne nyinaa mu.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">Dwom 131</para>
  <para style="d">Ɔsoroforɔ dwom. Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>Ao <char style="nd">Awurade</char>, ahomasoɔ nni mʼakoma mu,</para>
  <para style="q2" vid="PSA 131:1">na mʼani ntraa ntɔn;</para>
  <para style="q1" vid="PSA 131:1">memma nsɛm akɛseɛ nha me</para>
  <para style="q2" vid="PSA 131:1">anaa nsɛm a ɛyɛ nwanwa dodo ma me.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>Na mmom, mama me kra anya abotɔyam</para>
  <para style="q2" vid="PSA 131:2">te sɛ akɔkoaa a ɔda ne maame so renum no,</para>
  <para style="q1" vid="PSA 131:2">te sɛ akɔkoaa a ɔtua nufoɔ ano no,</para>
  <para style="q2" vid="PSA 131:2">saa ara na me kra ayɛ wɔ me mu.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>Ao Israel, ma wʼani nna <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 131:3">seesei ne daa nyinaa.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">Dwom 132</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>Ao <char style="nd">Awurade</char> kae Dawid</para>
  <para style="q2" vid="PSA 132:1">ne ɔhaw ahodoɔ a ɔgyinaa ano no.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>Ɔkaa <char style="nd">Awurade</char> ntam</para>
  <para style="q2" vid="PSA 132:2">na ɔhyɛɛ Yakob Otumfoɔ no bɔ sɛ,<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“Merenhyɛne me fie</para>
  <para style="q2" vid="PSA 132:3">na merenkɔda me mpa so,<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>meremma nna mfa me</para>
  <para style="q2" vid="PSA 132:4">na meremma mʼani nkum,<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>kɔsi sɛ menya baabi ama <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 132:5">baabi a Yakob Otumfoɔ no bɛtena.”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Yɛtee wɔ Efrata,</para>
  <para style="q2" vid="PSA 132:6">yɛbɛtoo so wɔ Yaar mfuo so.<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“Momma yɛnkɔ nʼatenaeɛ;</para>
  <para style="q2" vid="PSA 132:7">momma yɛnsom wɔ ne nan ntiasoɔ hɔ.<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>‘Ao <char style="nd">Awurade</char>, sɔre bra wʼahomegyebea,</para>
  <para style="q2" vid="PSA 132:8">wo ne wo tumi Adaka no.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Ma tenenee nyɛ sɛ ntadeɛ mma wʼasɔfoɔ;</para>
  <para style="q2" vid="PSA 132:9">ma wʼahotefoɔ nto ahurisie dwom.’ ”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Wo ɔsomfoɔ Dawid enti,</para>
  <para style="q2" vid="PSA 132:10">nyi wʼani mfiri deɛ woasra no ngo no so.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>
    <char style="nd">Awurade</char> kaa ntam kyerɛɛ Dawid,</para>
  <para style="q2" vid="PSA 132:11">nokorɛ ntam a ɔrentwe nsane sɛ,</para>
  <para style="q1" vid="PSA 132:11">“Wʼasefoɔ no mu baako</para>
  <para style="q2" vid="PSA 132:11">na mede no bɛtena wʼahennwa so.<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>Sɛ wo mmammarima di mʼapam so</para>
  <para style="q2" vid="PSA 132:12">na wɔtie me nkyerɛkyerɛ a,</para>
  <para style="q1" vid="PSA 132:12">ɛnneɛ wɔn mmammarima bɛtena</para>
  <para style="q2" vid="PSA 132:12">wʼahennwa so afebɔɔ.”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>
    <char style="nd">Awurade</char> ayi Sion,</para>
  <para style="q1" vid="PSA 132:13">ɔde hɔ ayɛ nʼatenaeɛ:<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“Ɛha ne mʼahomegyebea daa nyinaa;</para>
  <para style="q2" vid="PSA 132:14">ɛha na mɛtena adi ɔhene, ɛfiri sɛ ɛha na mepɛ,<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>mede nneɛma pa bebree bɛhyira no</para>
  <para style="q2" vid="PSA 132:15">na mama nʼahiafoɔ adidi amee.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Mede nkwagyeɛ bɛfira nʼasɔfoɔ</para>
  <para style="q2" vid="PSA 132:16">na nʼahotefoɔ ato ahurisie dwom daa.<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“Mɛma ɔberempɔn bi apue wɔ Dawid ahennie mu</para>
  <para style="q2" vid="PSA 132:17">na mede kanea asi hɔ ama deɛ masra no ngo no.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Mede aniwuo bɛfira nʼatamfoɔ,</para>
  <para style="q2" vid="PSA 132:18">nanso nʼahenkyɛ bɛhyerɛn wɔ ne tiri so.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">Dwom 133</para>
  <para style="d">Ɔsoroforɔ dwom. Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Hwɛ ɛyɛ a ɛyɛ ne fɛ a ɛyɛ fɛ</para>
  <para style="q2" vid="PSA 133:1">sɛ anuanom bom tena faako!<verse eid="PSA 133:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Ɛte sɛ ngo a ɛsom bo a wɔahwie agu apampam,</para>
  <para style="q2" vid="PSA 133:2">na ɛsiane kɔgu bɔgyesɛ mu,</para>
  <para style="q1" vid="PSA 133:2">ɛsiane kɔgu Aaron bɔgyesɛ mu,</para>
  <para style="q2" vid="PSA 133:2">ma ebi kɔgu nʼatadeɛ abakɔn so.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Ɛte sɛ Hermon bosuo a</para>
  <para style="q2" vid="PSA 133:3">ɛtɔ gu Bepɔ Sion so.</para>
  <para style="q1" vid="PSA 133:3">Ɛhɔ na <char style="nd">Awurade</char> ahyɛ ne nhyira,</para>
  <para style="q2" vid="PSA 133:3">nkwa a ɛtoɔ ntwa da no.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">Dwom 134</para>
  <para style="d">Ɔsoroforɔ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>
    <char style="nd">Awurade</char> asomfoɔ nyinaa, monkamfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 134:1">mo a mosom wɔ <char style="nd">Awurade</char> fie anadwo nyinaa.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Momma mo nsa so wɔ kronkronbea hɔ</para>
  <para style="q2" vid="PSA 134:2">na monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>
    <char style="nd">Awurade</char> a ɔbɔɔ soro ne asase no,</para>
  <para style="q2" vid="PSA 134:3">mfiri Sion nhyira mo.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">Dwom 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">Monkamfo <char style="nd">Awurade</char> din;</para>
  <para style="q2" vid="PSA 135:1">monkamfo no, mo <char style="nd">Awurade</char> asomfoɔ,<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>mo a mosom wɔ <char style="nd">Awurade</char> fie,</para>
  <para style="q2" vid="PSA 135:2">wɔ adihɔ a ɛwɔ yɛn Onyankopɔn fie.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>Monkamfo <char style="nd">Awurade</char> ɛfiri sɛ ɔyɛ;</para>
  <para style="q2" vid="PSA 135:3">monto ayɛyie dwom mma ne din, na ɛno na ɛyɛ anisɔ.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>
    <char style="nd">Awurade</char> ayi Yakob sɛ ɔnyɛ ne deɛ,</para>
  <para style="q2" vid="PSA 135:4">wayi Israel sɛ nʼadeɛ a ɛsom bo.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Menim sɛ <char style="nd">Awurade</char> so;</para>
  <para style="q2" vid="PSA 135:5">Ɔso sene anyame nyinaa.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>
    <char style="nd">Awurade</char> yɛ deɛ ɔpɛ biara,</para>
  <para style="q2" vid="PSA 135:6">wɔ ɔsoro ne asase so,</para>
  <para style="q2" vid="PSA 135:6">ɛpo ne emu abunu nyinaa.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Ɔma omununkum ma ne ho so firi asase ano ba;</para>
  <para style="q2" vid="PSA 135:7">ɔsoma anyinam ka osutɔ ho</para>
  <para style="q2" vid="PSA 135:7">na ɔma ahum tu firi nʼakoradan mu.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Ɔkumm Misraim mmakan,</para>
  <para style="q2" vid="PSA 135:8">nnipa ne mmoa mmakan.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Ɔsomaa ne nsɛnkyerɛnneɛ ne nʼanwanwadeɛ baa mo mfimfini, Ao Misraim,</para>
  <para style="q2" vid="PSA 135:9">de tiaa Farao ne nʼasomfoɔ nyinaa.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Ɔsɛee amanaman pii</para>
  <para style="q2" vid="PSA 135:10">na ɔkunkumm ahemfo akɛseɛ,<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>Amorifoɔ ɔhene, Sihon</para>
  <para style="q2" vid="PSA 135:11">Basan ɔhene, Og</para>
  <para style="q2" vid="PSA 135:11">ne Kanaan ahemfo nyinaa,<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>na ɔde wɔn nsase maa sɛ agyapadeɛ;</para>
  <para style="q2" vid="PSA 135:12">ɔde maa ne nkurɔfoɔ Israelfoɔ.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>Ao <char style="nd">Awurade</char>, wo din wɔ hɔ daa.</para>
  <para style="q2" vid="PSA 135:13">Ao <char style="nd">Awurade</char> wo din ahyeta awoɔ ntoatoasoɔ nyinaa mu.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>
    <char style="nd">Awurade</char> bɛdi ama ne nkurɔfoɔ</para>
  <para style="q1" vid="PSA 135:14">na ɔbɛhunu nʼasomfoɔ mmɔbɔ.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>Amanaman no ahoni yɛ dwetɛ ne sikakɔkɔɔ</para>
  <para style="q2" vid="PSA 135:15">a wɔde onipa nsa na ayɛ.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Wɔwɔ ano, nanso wɔntumi nkasa,</para>
  <para style="q2" vid="PSA 135:16">wɔwɔ ani, nanso wɔnhunu adeɛ;<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>wɔwɔ aso, nanso wɔnte asɛm,</para>
  <para style="q2" vid="PSA 135:17">na ahomeɛ nso nni wɔn anom.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,</para>
  <para style="q2" vid="PSA 135:18">saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>Monkamfo <char style="nd">Awurade</char>, Ao Israel fiefoɔ;</para>
  <para style="q2" vid="PSA 135:19">monkamfo <char style="nd">Awurade</char>, Ao Aaron fiefoɔ;<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>monkamfo <char style="nd">Awurade</char>, Ao Lewi fiefoɔ;</para>
  <para style="q2" vid="PSA 135:20">monkamfo <char style="nd">Awurade</char>, mo a mosuro no.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Momfiri Sion nkamfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 135:21">monkamfo deɛ ɔte Yerusalem no.</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">Dwom 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>Monna <char style="nd">Awurade</char> ase na ɔyɛ.</para>
  <para style="qr" vid="PSA 136:1">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Monna anyame mu Onyankopɔn ase.</para>
  <para style="qr" vid="PSA 136:2">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Monna awuranom mu Awurade no ase.</para>
  <para style="qr" vid="PSA 136:3">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>Ɔno nko ara na ɔyɛ anwanwadeɛ akɛseɛ.</para>
  <para style="qr" vid="PSA 136:4">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>Ɔno na ɔfiri ne nteaseɛ mu bɔɔ ɔsoro.</para>
  <para style="qr" vid="PSA 136:5">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>Ɔno na ɔtrɛɛ asase mu de kataa nsuo so.</para>
  <para style="qr" vid="PSA 136:6">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>Ɔno na ɔbɔɔ nkanea akɛseɛ no.</para>
  <para style="qr" vid="PSA 136:7">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>Ɔbɔɔ owia sɛ ɛnni adekyeeɛ so.</para>
  <para style="qr" vid="PSA 136:8">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>Ɔbɔɔ ɔsrane ne nsoromma sɛ wɔnni adesaeɛ so no.</para>
  <para style="qr" vid="PSA 136:9">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>Ɔno na ɔkunkumm Misraimfoɔ mmakan,</para>
  <para style="qr" vid="PSA 136:10">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>na ɔyii Israelfoɔ firii wɔn mu no.</para>
  <para style="qr" vid="PSA 136:11">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>Ɔde nsa kɛseɛ ne basa a watene mu.</para>
  <para style="qr" vid="PSA 136:12">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>Ɔno na ɔpaee Ɛpo Kɔkɔɔ no mu no,</para>
  <para style="qr" vid="PSA 136:13">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>na ɔde Israelfoɔ faa mfimfini no.</para>
  <para style="qr" vid="PSA 136:14">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>Nanso, ɔpraa Farao ne nʼasraafoɔ guu Ɛpo Kɔkɔɔ mu no.</para>
  <para style="qr" vid="PSA 136:15">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>Ɔno na ɔdii ne nkurɔfoɔ anim wɔ ɛserɛ no so.</para>
  <para style="qr" vid="PSA 136:16">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>Ɔno na ɔkumm ahemfo akɛseɛ no,</para>
  <para style="qr" vid="PSA 136:17">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>na ɔkumm ahemfo akunini no.</para>
  <para style="qr" vid="PSA 136:18">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>Ɔkumm Amorifoɔ ɔhene, Sihon,</para>
  <para style="qr" vid="PSA 136:19">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ne Basanhene, Og.</para>
  <para style="qr" vid="PSA 136:20">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>Na ɔde wɔn nsase maa sɛ agyapadeɛ.</para>
  <para style="qr" vid="PSA 136:21">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>Ɔde maa ne ɔsomfoɔ Israel sɛ agyapadeɛ.</para>
  <para style="qr" vid="PSA 136:22">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>Ɔkaee yɛn, yɛn mmerɛyɛ mu.</para>
  <para style="qr" vid="PSA 136:23">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>Na ɔgyee yɛn firii yɛn atamfoɔ nsam.</para>
  <para style="qr" vid="PSA 136:24">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>Ɔno na ɔma abɔdeɛ biara aduane.</para>
  <para style="qr" vid="PSA 136:25">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Monna ɔsorosoro Onyankopɔn no ase.</para>
  <para style="qr" vid="PSA 136:26">Nʼadɔeɛ wɔ hɔ daa.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">Dwom 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>Babilonia nsubɔntene ho, ɛhɔ na yɛtena suiɛ</para>
  <para style="q2" vid="PSA 137:1">ɛberɛ a yɛkaee Sion no.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>Ɛhɔ nsukakye nnua so</para>
  <para style="q2" vid="PSA 137:2">na yɛde yɛn asankuo sensɛneeɛ,<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>ɛhɔ na yɛn nnommumfafoɔ bisaa yɛn nnwom,</para>
  <para style="q2" vid="PSA 137:3">yɛn ahohiahiafoɔ pɛɛ yɛn hɔ ahurisie nnwom;</para>
  <para style="q2" vid="PSA 137:3">wɔkaa sɛ, “Monto Sion nnwom baako mma yɛn!”<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Ɛbɛyɛ dɛn na yɛatumi ato <char style="nd">Awurade</char> nnwom</para>
  <para style="q2" vid="PSA 137:4">ɛberɛ a yɛwɔ ananafoɔ asase so?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>Ao Yerusalem, sɛ mewerɛ firi wo a</para>
  <para style="q2" vid="PSA 137:5">ma me nsa nifa werɛ mfiri sankubɔ.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Sɛ mankae wo sɛ mʼanigyedeɛ kɛseɛ pa ara a,</para>
  <para style="q2" vid="PSA 137:6">ma me tɛkrɛma nka mfam mʼanomu.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>Ao <char style="nd">Awurade</char>, kae deɛ Edomfoɔ yɛeɛ</para>
  <para style="q2" vid="PSA 137:7">wɔ ɛda a Yerusalem hwee ase no.</para>
  <para style="q1" vid="PSA 137:7">Wɔteam sɛ, “Monnwiri,</para>
  <para style="q2" vid="PSA 137:7">monnwiri ngu fam nkɔka nʼafapem!”<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>Ao Babilonia babaa a wɔahyɛ sɛ wɔbɛsɛe wo,</para>
  <para style="q2" vid="PSA 137:8">nhyira nka deɛ ɔtua wo ka</para>
  <para style="q2" vid="PSA 137:8">wɔ deɛ wode ayɛ yɛn so.<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>Nhyira nka deɛ ɔkyekyee wo nkokoaa</para>
  <para style="q2" vid="PSA 137:9">de wɔn bobɔɔ abotan so.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">Dwom 138</para>
  <para style="d">Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>Ao <char style="nd">Awurade</char>, mɛfiri mʼakoma nyinaa mu ayi wo ayɛ;</para>
  <para style="q2" vid="PSA 138:1">mɛto wʼayɛyie dwom wɔ anyame no anim.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Mede mʼani bɛkyerɛ wʼasɔredan kronkron no, akoto wo</para>
  <para style="q2" vid="PSA 138:2">na makamfo wo din</para>
  <para style="q2" vid="PSA 138:2">wɔ wʼadɔeɛ ne wo nokorɛdie enti</para>
  <para style="q1" vid="PSA 138:2">ɛfiri sɛ wɔapagya wo din ne wʼasɛm no</para>
  <para style="q2" vid="PSA 138:2">asene nneɛma nyinaa.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Ɛberɛ a mesu mefrɛɛ wo no, wogyee me so;</para>
  <para style="q2" vid="PSA 138:3">womaa me nyaa akokoɔduru ne nnamyɛ.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>Ao <char style="nd">Awurade</char>, sɛ ahemfo a ɛwɔ ewiase nyinaa te wʼanomu asɛm a</para>
  <para style="q2" vid="PSA 138:4">ma wɔn nkamfo wo.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Ma wɔnto <char style="nd">Awurade</char> akwan ho nnwom,</para>
  <para style="q2" vid="PSA 138:5">na <char style="nd">Awurade</char> animuonyam yɛ kɛseɛ.<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Ɛwom sɛ <char style="nd">Awurade</char> wɔ ɔsorosoro deɛ, nanso ɔhwɛ mmɔborɔfoɔ,</para>
  <para style="q2" vid="PSA 138:6">na ahantanfoɔ deɛ, ɔhunu wɔn akyirikyiri.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Ɛwom sɛ menam ɔhaw mu deɛ,</para>
  <para style="q2" vid="PSA 138:7">nanso wobɔ me nkwa ho ban;</para>
  <para style="q1" vid="PSA 138:7">wotene wo nsa wɔ mʼatamfoɔ abufuo so,</para>
  <para style="q2" vid="PSA 138:7">na wode wo nsa nifa gye me nkwa.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>
    <char style="nd">Awurade</char> bɛma deɛ wahyehyɛ ama me no aba mu;</para>
  <para style="q2" vid="PSA 138:8">Ao <char style="nd">Awurade</char>, wʼadɔeɛ wɔ hɔ daa,</para>
  <para style="q2" vid="PSA 138:8">nnyaa wo nsa ano adwuma hɔ.</para>
  <para style="d" vid="PSA 138:8">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">Dwom 139</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>Ao <char style="nd">Awurade</char>, woahwehwɛ me mu</para>
  <para style="q2" vid="PSA 139:1">na woahunu me.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Wonim mʼasetena ne me sɔreɛ;</para>
  <para style="q2" vid="PSA 139:2">wofiri akyirikyiri hunu mʼadwene mu.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Wonim mʼadifirie ne me nnaeɛ;</para>
  <para style="q2" vid="PSA 139:3">wonim mʼakwan nyinaa.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Ansa na mɛbue mʼano akasa no</para>
  <para style="q2" vid="PSA 139:4">Ao <char style="nd">Awurade</char>, na wonim ne nyinaa dada.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Woatwa me ho nyinaa ahyia</para>
  <para style="q2" vid="PSA 139:5">na wobɔ me ho ban.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Saa nimdeɛ yi boro me nteaseɛ so,</para>
  <para style="q2" vid="PSA 139:6">ɛyɛ me nwanwa dodo.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Ɛhe na mɛtumi afiri wo honhom anim akorɔ?</para>
  <para style="q2" vid="PSA 139:7">Ɛhe na mɛtumi adwane afiri wʼanim akorɔ?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Sɛ meforo soro a, wowɔ hɔ.</para>
  <para style="q2" vid="PSA 139:8">Na mekɔsɛ me kɛtɛ wɔ asaman a, wo nie.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Sɛ mede adekyeeɛ ntaban tu</para>
  <para style="q2" vid="PSA 139:9">na mekɔtena ɛpo akyi nohoa a,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>mpo ɛhɔ na wo nsa bɛgya me akɔ,</para>
  <para style="q2" vid="PSA 139:10">na wo nsa nifa bɛsɔ me mu.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Na meka sɛ, “Ampa ara esum mmɛkata me so</para>
  <para style="q2" vid="PSA 139:11">na hann nnane adesaeɛ ntwa me ho nhyia a,”<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>esum mpo nnyɛ sum mma wo;</para>
  <para style="q2" vid="PSA 139:12">na anadwo bɛhyerɛn sɛ awia;</para>
  <para style="q2" vid="PSA 139:12">esum ne hann yɛ wo pɛ.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Na wo na wobɔɔ me honhom</para>
  <para style="q2" vid="PSA 139:13">wonwonoo me wɔ me maame awotwaa mu.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Mekamfo wo, ɛfiri sɛ woyɛɛ me anwanwakwan so a ɛyɛ hu.</para>
  <para style="q2" vid="PSA 139:14">Wo nnwuma yɛ nwanwa.</para>
  <para style="q2" vid="PSA 139:14">Menim ɛno yie pa ara.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Wɔamfa me bɔberɛ anhinta wo</para>
  <para style="q2" vid="PSA 139:15">ɛberɛ a wɔyɛɛ me kɔkoam no;</para>
  <para style="q1" vid="PSA 139:15">ɛberɛ a wɔnwonoo me asase yam no,<verse eid="PSA 139:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 139:16"/>wʼani hunuu me ɛberɛ a meyɛ mogya toa no.</para>
  <para style="q1" vid="PSA 139:16">Nna dodoɔ a woatwa ama me no,</para>
  <para style="q2" vid="PSA 139:16">wɔatwerɛ ne nyinaa wɔ wo nwoma mu</para>
  <para style="q2" vid="PSA 139:16">ansa na emu baako reba mu.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>Ao Onyankopɔn, wo nsusuiɛ som bo ma me!</para>
  <para style="q2" vid="PSA 139:17">Woka ne nyinaa bɔ mu a, ɛso dodo!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Sɛ mese mɛkan a,</para>
  <para style="q2" vid="PSA 139:18">ne dodoɔ bɛboro mpoano anwea,</para>
  <para style="q1" vid="PSA 139:18">sɛ menyane a,</para>
  <para style="q2" vid="PSA 139:18">me ne wo wɔ hɔ ara.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>Ao Onyankopɔn, sɛ anka wobɛkumkum amumuyɛfoɔ a!</para>
  <para style="q1" vid="PSA 139:19">Momfiri me so, mo mogyapɛfoɔ!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Wɔde adwemmɔne ka wo ho asɛm;</para>
  <para style="q2" vid="PSA 139:20">wʼatamfoɔ mmɔ wo din pa.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>Ao <char style="nd">Awurade</char>, metane wɔn a wɔtane wo,</para>
  <para style="q2" vid="PSA 139:21">na mekyiri wɔn a wɔsɔre tia woɔ.<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Menni hwee sɛ ɔtan a mewɔ ma wɔn;</para>
  <para style="q2" vid="PSA 139:22">mefa wɔn sɛ mʼatamfoɔ.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Hwehwɛ me mu, Ao Onyankopɔn, na hunu mʼakoma;</para>
  <para style="q2" vid="PSA 139:23">sɔ me hwɛ na hunu mʼadwene.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Hwɛ sɛ bɔne bi wɔ me mu a,</para>
  <para style="q2" vid="PSA 139:24">na fa me fa ɛkwan a ɛkɔ daa nkwa so.</para>
  <para style="d" vid="PSA 139:24">Wɔde ma dwomkyerɛfoɔ.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">Dwom 140</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>Ao <char style="nd">Awurade</char> gye me firi nnipa bɔne nsam;</para>
  <para style="q2" vid="PSA 140:1">bɔ me ho ban firi basabasayɛfoɔ nsam,<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>wɔn a wɔdwene bɔne wɔ wɔn akoma mu</para>
  <para style="q2" vid="PSA 140:2">na wɔhwanyane ɔko mu da biara.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Wɔse wɔn tɛkrɛma ano te sɛ ɔtweaseɛ deɛ;</para>
  <para style="q2" vid="PSA 140:3">ananka borɔ wɔ wɔn ano.<verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>Ao <char style="nd">Awurade</char>, yi me firi amumuyɛfoɔ nsam;</para>
  <para style="q2" vid="PSA 140:4">bɔ me ho ban firi basabasayɛfoɔ a</para>
  <para style="q2" vid="PSA 140:4">wɔdwene sɛ wɔbɛtwintwan mʼanan mu.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Ahantanfoɔ asum me afidie;</para>
  <para style="q2" vid="PSA 140:5">wɔatrɛtrɛ wɔn asau nhoma mu,</para>
  <para style="q2" vid="PSA 140:5">wɔasunsum me mfidie wɔ me kwan so.<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>Ao <char style="nd">Awurade</char>, meka kyerɛ wo sɛ, “Wone me Onyankopɔn.”</para>
  <para style="q2" vid="PSA 140:6">Ao <char style="nd">Awurade</char>, tie me mmɔborɔ su.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>Ao Otumfoɔ <char style="nd">Awurade</char>, me gyefoɔ ɔhoɔdenfoɔ a</para>
  <para style="q2" vid="PSA 140:7">wobɔ me tiri ban ɔko da,<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>nyɛ amumuyɛfoɔ abisadeɛ mma wɔn, Ao <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 140:8">mma wɔn nhyehyɛeɛ nyɛ yie.<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Wɔatwa me ho ahyia,</para>
  <para style="q2" vid="PSA 140:9">nanso, ma amumuyɛsɛm a ɛfiri wɔn anomu nsɛe wɔn.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Ma nnyasrama ngu wɔn so;</para>
  <para style="q2" vid="PSA 140:10">ma wɔnto wɔn ngu ogya mu,</para>
  <para style="q2" vid="PSA 140:10">ngu atɛkyɛ amena mu a wɔrensɔre bio.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Mma dinsɛefoɔ ntim asase no so;</para>
  <para style="q2" vid="PSA 140:11">ma amanehunu ntaataa basabasayɛfoɔ.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Menim sɛ <char style="nd">Awurade</char> bu ahiafoɔ atɛntenenee</para>
  <para style="q2" vid="PSA 140:12">na ɔka onnibie asɛm ma no.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Ampa ara, teneneefoɔ bɛkamfo wo din</para>
  <para style="q2" vid="PSA 140:13">na wɔn a wɔnam tee no bɛtena nkwa mu wɔ wʼanim.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">Dwom 141</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>Ao <char style="nd">Awurade</char>, mesu mefrɛ wo, bra me nkyɛn ntɛm so.</para>
  <para style="q2" vid="PSA 141:1">Sɛ mesu mefrɛ wo a, gye me so.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Ma me mpaeɛbɔ mmra wʼanim sɛ aduhwam;</para>
  <para style="q2" vid="PSA 141:2">ma me nsa a mapagya nyɛ sɛ anwummerɛ afɔrebɔ.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>Ao <char style="nd">Awurade</char>, ma ɔwɛmfoɔ nwɛn mʼano;</para>
  <para style="q2" vid="PSA 141:3">na wɛn mʼano ɛpono.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Mma wɔnntwe mʼakoma nkɔ deɛ ɛyɛ bɔne ho,</para>
  <para style="q2" vid="PSA 141:4">na ankɔyɛ deɛ amumuyɛfoɔ yɛ no bi;</para>
  <para style="q1" vid="PSA 141:4">mma me ne abɔnefoɔ</para>
  <para style="q2" vid="PSA 141:4">nni wɔn nnɔkɔnnɔkɔwadeɛ.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Ma ɔteneneeni mmɔ me, ɛyɛ ayamyɛ;</para>
  <para style="q2" vid="PSA 141:5">ma ɔnka mʼanim, ɛyɛ me tiri so ngo.</para>
  <para style="q1" vid="PSA 141:5">Me tiri rempo.</para>
  <para style="q2" vid="PSA 141:5">Me mpaeɛbɔ da so tia abɔnefoɔ nneyɛɛ daa.<verse eid="PSA 141:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>Wɔbɛto wɔn sodifoɔ afiri abotan so abɛhwe fam;</para>
  <para style="q2" vid="PSA 141:6">na amumuyɛfoɔ bɛhunu sɛ me nsɛm no yɛ nokorɛ.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Wɔbɛka sɛ, “Sɛdeɛ obi funtum na ɔtutu asase no,</para>
  <para style="q2" vid="PSA 141:7">saa ara na wɔabɔ yɛn nnompe ahwete ɛda ano.”<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Nanso, Ao Otumfoɔ <char style="nd">Awurade</char>, wo so na mʼani da;</para>
  <para style="q2" vid="PSA 141:8">wo mu na mehinta. Nnya me mma owuo.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Bɔ me ho ban firi mfidie a wɔasunsum me no mu,</para>
  <para style="q2" vid="PSA 141:9">mfidie a abɔnefoɔ asunsum no.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Ma amumuyɛfoɔ no ankasa atena nyi wɔn,</para>
  <para style="q2" vid="PSA 141:10">na menkɔ me baabi asomdwoeɛ mu.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">Dwom 142</para>
  <para style="d">Dawid deɛ. Ɛberɛ a na ɔwɔ ɔbodan mu no. Mpaeɛbɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>Meteam mesu frɛ <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 142:1">me ma me nne so su frɛ <char style="nd">Awurade</char> sɛ ɔnhunu me mmɔbɔ.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Mehwie mʼahiasɛm megu nʼanim;</para>
  <para style="q2" vid="PSA 142:2">meka me haw kyerɛ no.<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>Sɛ me ɔkra tɔ baha wɔ me mu a,</para>
  <para style="q2" vid="PSA 142:3">ɛyɛ wo na wonim mʼakwan.</para>
  <para style="q1" vid="PSA 142:3">Ɛkwan a menam so no</para>
  <para style="q2" vid="PSA 142:3">nnipa asum me afidie wɔ so.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Hwɛ me nifa so na hunu sɛ;</para>
  <para style="q2" vid="PSA 142:4">mʼasɛm mfa obiara ho;</para>
  <para style="q1" vid="PSA 142:4">menni dwanekɔbea bi;</para>
  <para style="q2" vid="PSA 142:4">me nkwa mfa obiara ho.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>Ao <char style="nd">Awurade</char>, mesu mefrɛ wo;</para>
  <para style="q2" vid="PSA 142:5">mese, “Wone me dwanekɔbea,</para>
  <para style="q2" vid="PSA 142:5">me kyɛfa wɔ ateasefoɔ asase so.”<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>Tie me sufrɛ,</para>
  <para style="q2" vid="PSA 142:6">na mewɔ ahohia kɛseɛ mu;</para>
  <para style="q1" vid="PSA 142:6">gye me firi mʼataafoɔ nsam,</para>
  <para style="q2" vid="PSA 142:6">ɛfiri sɛ wɔn ho yɛ den sene me.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Yi me firi me nneduadan mu,</para>
  <para style="q2" vid="PSA 142:7">na makamfo wo din.</para>
  <para style="b" vid="PSA 142:7"/>
  <para style="q1" vid="PSA 142:7">Afei teneneefoɔ bɛtwa me ho ahyia</para>
  <para style="q2" vid="PSA 142:7">ɛsiane wo papa a woayɛ me enti.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">Dwom 143</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>Ao <char style="nd">Awurade</char>, tie me mpaeɛbɔ,</para>
  <para style="q2" vid="PSA 143:1">tie me nkotosrɛ;</para>
  <para style="q1" vid="PSA 143:1">wɔ wo nokorɛdie ne tenenee mu</para>
  <para style="q2" vid="PSA 143:1">bra bɛboa me.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Mfa wʼakoa nkɔ atemmuo mu,</para>
  <para style="q2" vid="PSA 143:2">na ɔteasefoɔ biara ntene wɔ wʼanim.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Ɔtamfoɔ no taa me,</para>
  <para style="q2" vid="PSA 143:3">ɔbɔ me hwe fam;</para>
  <para style="q1" vid="PSA 143:3">ɔma me tena esum mu</para>
  <para style="q2" vid="PSA 143:3">te sɛ wɔn a wɔawuwu dadaada.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Ɛno enti me honhom atɔ piti wɔ me mu;</para>
  <para style="q2" vid="PSA 143:4">na mʼakoma aba mu abu wɔ me mu.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Mekae tete nna no;</para>
  <para style="q2" vid="PSA 143:5">medwendwene wo nnwuma</para>
  <para style="q2" vid="PSA 143:5">ne deɛ wo nsa ayɛ nyinaa ho.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Mepagya me nsa kyerɛ wo;</para>
  <para style="q2" vid="PSA 143:6">wo ho sukɔm de me kra sɛ asase wesee.<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>Ao <char style="nd">Awurade</char>, gye me so ntɛm;</para>
  <para style="q2" vid="PSA 143:7">me honhom tɔ piti.</para>
  <para style="q1" vid="PSA 143:7">Mfa wʼanim nhinta me</para>
  <para style="q2" vid="PSA 143:7">anyɛ saa a, mɛyɛ sɛ wɔn a wɔkɔ amena mu no.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Ma mente wʼadɔeɛ a ɛnsa da no ho asɛm daa anɔpa,</para>
  <para style="q2" vid="PSA 143:8">na mede me ho ato wo so.</para>
  <para style="q1" vid="PSA 143:8">Kyerɛ me ɛkwan a memfa so,</para>
  <para style="q2" vid="PSA 143:8">na wo na mema me kra so kyerɛ.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>Ao <char style="nd">Awurade</char> gye me firi mʼatamfoɔ nsam,</para>
  <para style="q2" vid="PSA 143:9">na wo mu na mede me ho hinta.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Kyerɛ me na menyɛ wʼapɛdeɛ,</para>
  <para style="q2" vid="PSA 143:10">na wo ne me Onyankopɔn;</para>
  <para style="q1" vid="PSA 143:10">ma wo honhom pa no</para>
  <para style="q2" vid="PSA 143:10">nni me ɛkan wɔ asase tamaa so.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>Ao <char style="nd">Awurade</char>, wo din enti, kyɛe me nkwa so;</para>
  <para style="q2" vid="PSA 143:11">wo tenenee mu, yi me firi ɔhaw mu.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Wɔ wʼadɔeɛ a ɛnsa da no mu, yi mʼatamfoɔ hɔ;</para>
  <para style="q2" vid="PSA 143:12">na sɛe wɔn a wɔkyiri me nyinaa,</para>
  <para style="q2" vid="PSA 143:12">na meyɛ wo ɔsomfoɔ.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">Dwom 144</para>
  <para style="d">Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>Nkamfoɔ nka <char style="nd">Awurade</char>, me Botan,</para>
  <para style="q2" vid="PSA 144:1">deɛ ɔkyerɛkyerɛ me nsa akodie,</para>
  <para style="q2" vid="PSA 144:1">na ɔkyerɛkyerɛ me nsateaa akodie.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>Ɔyɛ mʼadɔeɛ Onyankopɔn ne mʼaban,</para>
  <para style="q2" vid="PSA 144:2">mʼabandenden ne me ɔgyefoɔ,</para>
  <para style="q1" vid="PSA 144:2">me kyɛm a mewɔ dwanekɔbea wɔ ne mu;</para>
  <para style="q2" vid="PSA 144:2">ɔno na ɔka nnipa hyɛ mʼase.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>Ao <char style="nd">Awurade</char>, hwan ne onipa, a wʼani ku ne ho?</para>
  <para style="q2" vid="PSA 144:3">Hwan ne onipa ba, a wodwene ne ho yi?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Onipa te sɛ ahomeɛ;</para>
  <para style="q2" vid="PSA 144:4">ne nna te sɛ sunsum a ɛretwam.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>Ao <char style="nd">Awurade</char>, firi ɔsoro hɔ na siane bra fam;</para>
  <para style="q2" vid="PSA 144:5">fa wo nsa ka mmepɔ, na ɛmfiri wisie.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Soma anyinam na bɔ atamfoɔ no hwete;</para>
  <para style="q2" vid="PSA 144:6">to wo mmemma no ma wɔn nnwane.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Tene wo nsa firi soro bra fam;</para>
  <para style="q2" vid="PSA 144:7">gye me na yi me</para>
  <para style="q1" vid="PSA 144:7">firi nsuo akɛseɛ ho,</para>
  <para style="q2" vid="PSA 144:7">firi ananafoɔ nsam,<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>wɔn a atorɔ ayɛ wɔn anomu ma,</para>
  <para style="q2" vid="PSA 144:8">na wɔn nsa nifa yɛ nnaadaa.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Ao Onyankopɔn, mɛto dwom foforɔ ama wo;</para>
  <para style="q2" vid="PSA 144:9">mɛto dwom wɔ sankuo a nhoma edu gu soɔ so ama wo,<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>ama Ɔbaako a ɔde nkonimdie ma ahemfo,</para>
  <para style="q2" vid="PSA 144:10">na ɔgye ne ɔsomfoɔ Dawid firi akofena kɔdiawuo ano.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Gye me na yi me firi</para>
  <para style="q2" vid="PSA 144:11">ananafoɔ nsam,</para>
  <para style="q1" vid="PSA 144:11">wɔn a atorɔ ayɛ wɔn anomu ma</para>
  <para style="q2" vid="PSA 144:11">na wɔn nsa nifa yɛ nnaadaa.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Afei yɛn mmammarima mmeranteberɛ</para>
  <para style="q2" vid="PSA 144:12">bɛyɛ sɛ afifideɛ a wɔahwɛ so yie,</para>
  <para style="q1" vid="PSA 144:12">na yɛn mmammaa bɛyɛ sɛ adum</para>
  <para style="q2" vid="PSA 144:12">a wɔasene de asiesie ahemfie.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Yɛn asan bɛyɛ ma.</para>
  <para style="q2" vid="PSA 144:13">Aduane ahodoɔ biara bɛba mu bi.</para>
  <para style="q1" vid="PSA 144:13">Yɛn nnwan bɛdɔɔso ayɛ mpem mpem,</para>
  <para style="q2" vid="PSA 144:13">ayɛ mpemdu du wɔ yɛn mfuo so;<verse eid="PSA 144:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14"/>yɛn anantwie bɛtwe nnuane a ɛdɔɔso na emu yɛ duru.</para>
  <para style="q1" vid="PSA 144:14">Obiara rentumi nnwiri yɛn afasuo ngu;</para>
  <para style="q2" vid="PSA 144:14">yɛrenkɔ nkoasom mu,</para>
  <para style="q2" vid="PSA 144:14">na agyaadwotwa remma yɛn mmɔntene so.<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Nhyira nka nnipa a ɛbɛba mu saa ama wɔn.</para>
  <para style="q2" vid="PSA 144:15">Nhyira nka nnipa a wɔn Onyankopɔn ne <char style="nd">Awurade</char>.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">Dwom 145</para>
  <para style="d">Ayɛyie dwom. Dawid deɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>Mɛma wo so, me Onyankopɔn, me Ɔhene;</para>
  <para style="q2" vid="PSA 145:1">mɛkamfo wo din daa daa.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Ɛda biara, mɛkamfo wo;</para>
  <para style="q2" vid="PSA 145:2">na mama wo din so daa daa.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>
    <char style="nd">Awurade</char> so, na ɔsɛ nkamfo kɛseɛ;</para>
  <para style="q2" vid="PSA 145:3">obiara rentumi nsusu ne kɛseyɛ.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Awoɔ ntoatoasoɔ baako bɛkamfo wo nnwuma akyerɛ ɔfoforɔ;</para>
  <para style="q2" vid="PSA 145:4">wɔbɛka wo nnwuma akɛseɛ ho asɛm.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Wɔbɛka wʼanimuonyam ne wo tumi a ɛhran no ho asɛm,</para>
  <para style="q2" vid="PSA 145:5">na mɛdwene wʼanwanwadwuma ho.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Wɔbɛka wo nnwuma a ɛyɛ hu no mu tumi ho asɛm;</para>
  <para style="q2" vid="PSA 145:6">na mapae mu aka wo nneyɛɛ akɛseɛ no akyerɛ.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Wɔbɛhyɛ wo papayɛ mmorosoɔ no ho fa,</para>
  <para style="q2" vid="PSA 145:7">na wɔde anigyeɛ ato wo tenenee ho dwom.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>
    <char style="nd">Awurade</char> yɛ ɔdomfoɔ ne mmɔborɔhunufoɔ;</para>
  <para style="q2" vid="PSA 145:8">ne bo kyɛre fu na nʼadɔeɛ dɔɔso.<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>
    <char style="nd">Awurade</char> yɛ ma obiara;</para>
  <para style="q2" vid="PSA 145:9">na ɔwɔ ahummɔborɔ ma nʼabɔdeɛ nyinaa.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>Ao <char style="nd">Awurade</char>, wʼabɔdeɛ nyinaa bɛkamfo wo;</para>
  <para style="q2" vid="PSA 145:10">na wʼahotefoɔ bɛma wo so.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Wɔbɛka wʼahennie no animuonyam ho asɛm</para>
  <para style="q2" vid="PSA 145:11">na wɔaka wo mmaninyɛ ho asɛm,<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>sɛ ɛbɛyɛ a nnipa bɛhunu wo nnwuma akɛseɛ</para>
  <para style="q2" vid="PSA 145:12">ne wʼahennie animuonyam a ɛhran no.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Wʼahennie yɛ daa ahennie,</para>
  <para style="q2" vid="PSA 145:13">na wo tumidie wɔ hɔ ma awoɔ ntoantoasoɔ nyinaa.</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">
    <char style="nd">Awurade</char> di ne bɔhyɛ nyinaa so,</para>
  <para style="q2" vid="PSA 145:13">na ɔwɔ ɔdɔ ma biribiara a wayɛ.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>
    <char style="nd">Awurade</char> wowa wɔn a wɔhwe ase</para>
  <para style="q2" vid="PSA 145:14">na ɔpagya wɔn a wɔn nnesoa ama wɔakom.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Ani nyinaa hwɛ wo ɛkwan,</para>
  <para style="q2" vid="PSA 145:15">na woma wɔn wɔn aduane wɔ ne berɛ mu.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Wobue wo nsam</para>
  <para style="q2" vid="PSA 145:16">na woma biribiara a ɛwɔ nkwa no nʼapɛdeɛ.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>
    <char style="nd">Awurade</char> tene wɔ nʼakwan nyinaa mu;</para>
  <para style="q2" vid="PSA 145:17">na ɔyɛ adɔeɛ ma deɛ wayɛ nyinaa.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>
    <char style="nd">Awurade</char> bɛn wɔn a wɔfrɛ no nyinaa,</para>
  <para style="q2" vid="PSA 145:18">wɔn a wɔfrɛ no nokorɛ mu nyinaa.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Ɔyɛ wɔn a wɔsuro no no apɛdeɛ ma wɔn;</para>
  <para style="q2" vid="PSA 145:19">ɔtie wɔn sufrɛ na ɔgye wɔn.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>
    <char style="nd">Awurade</char> hwɛ wɔn a wɔdɔ no nyinaa so,</para>
  <para style="q2" vid="PSA 145:20">nanso amumuyɛfoɔ deɛ, ɔbɛsɛe wɔn nyinaa.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Mʼano bɛkamfo <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 145:21">Ma abɔdeɛ nyinaa nkamfo ne din kronkron no</para>
  <para style="q2" vid="PSA 145:21">daa daa.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">Dwom 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q2" vid="PSA 146:1">Ao me ɔkra, kamfo <char style="nd">Awurade</char>!<verse eid="PSA 146:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>Mɛkamfo <char style="nd">Awurade</char> me nkwa nna nyinaa;</para>
  <para style="q2" vid="PSA 146:2">mɛto ayɛyi dwom ama me Onyankopɔn, sɛ mete ase yi.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Mommfa mo ho nto mmapɔmma so,</para>
  <para style="q2" vid="PSA 146:3">adasamma a wɔrentumi nnye nkwa.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>Sɛ wɔn honhom tu kɔ a, wɔsane kɔ dɔteɛ mu,</para>
  <para style="q2" vid="PSA 146:4">saa da no ara wɔn nsusuiɛ nyinaa yɛ kwa.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Nhyira ne deɛ ne ɔboafoɔ ne Yakob Onyankopɔn,</para>
  <para style="q2" vid="PSA 146:5">deɛ nʼanidasoɔ wɔ <char style="nd">Awurade</char>, ne Onyankopɔn mu.<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>Ɔno ne ɔsoro ne asase Yɛfoɔ,</para>
  <para style="q2" vid="PSA 146:6">ɛpo ne biribiara a ɛwɔ mu nyinaa</para>
  <para style="q2" vid="PSA 146:6">
    <char style="nd">Awurade</char> a ɔyɛ nokwafoɔ daa no.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Ɔdi ma wɔn a wɔhyɛ wɔn so,</para>
  <para style="q2" vid="PSA 146:7">na ɔma wɔn a ɛkɔm de wɔn aduane.</para>
  <para style="q2" vid="PSA 146:7">
    <char style="nd">Awurade</char> gyaa nneduafoɔ,<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>
    <char style="nd">Awurade</char> ma anifirafoɔ hunu adeɛ.</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">Awurade</char> pagya wɔn a wɔakom.</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">Awurade</char> dɔ teneneefoɔ.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>
    <char style="nd">Awurade</char> hwɛ ahɔhoɔ so</para>
  <para style="q2" vid="PSA 146:9">na ɔwowa nwisiaa ne akunafoɔ,</para>
  <para style="q2" vid="PSA 146:9">na amumuyɛfoɔ akwan deɛ, ɔdane ani.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>Sion, <char style="nd">Awurade</char> wo Onyankopɔn di ɔhene daa daa,</para>
  <para style="q2" vid="PSA 146:10">wɔ awoɔ ntoatoasoɔ nyinaa so.</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">Dwom 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">Ɛyɛ sɛ wɔto ayɛyie dwom ma yɛn Onyankopɔn,</para>
  <para style="q1" vid="PSA 147:1">ɛyɛ fɛ na ɛfata sɛ wɔkamfo no!<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>
    <char style="nd">Awurade</char> kyekyere Yerusalem;</para>
  <para style="q2" vid="PSA 147:2">Ɔboaboa Israel nnommumfoɔ ano.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Ɔsa wɔn a wɔn akoma abotoɔ yadeɛ</para>
  <para style="q2" vid="PSA 147:3">na ɔkyekyere wɔn akuro.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Ɔnim nsoromma no dodoɔ</para>
  <para style="q2" vid="PSA 147:4">na ɔde obiara din frɛ no.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Yɛn <char style="nd">Awurade</char> so, na ne tumi yɛ kɛseɛ;</para>
  <para style="q2" vid="PSA 147:5">yɛrente nʼase nwie.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>
    <char style="nd">Awurade</char> wowa ahobrɛasefoɔ</para>
  <para style="q2" vid="PSA 147:6">na ɔtoto amumuyɛfoɔ hwe fam.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Monto aseda nnwom mma <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 147:7">Momfa sankuo nto dwom mma yɛn Onyankopɔn.<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>Ɔde omununkum kata ɔsoro ani;</para>
  <para style="q2" vid="PSA 147:8">ɔde osutɔ ma asase</para>
  <para style="q2" vid="PSA 147:8">ma ɛserɛ nyini wɔ nkokoɔ so.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Ɔma anantwie aduane</para>
  <para style="q2" vid="PSA 147:9">na sɛ anene mma su a, ɔma wɔn aduane.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Ɛnyɛ ɔpɔnkɔ ahoɔden na nʼani sɔ</para>
  <para style="q2" vid="PSA 147:10">na ɛnyɛ onipa ahoɔden nso.<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>Na mmom, <char style="nd">Awurade</char> ani sɔ nnipa a wɔsuro no,</para>
  <para style="q2" vid="PSA 147:11">wɔn a wɔde wɔn ho to nʼadɔeɛ a ɛnsa da no so no.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Momma <char style="nd">Awurade</char> so, Ao Yerusalem;</para>
  <para style="q2" vid="PSA 147:12">kamfo wo Onyankopɔn, Ao Sion,<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>ɔma wʼapono akyi adaban yɛ den</para>
  <para style="q2" vid="PSA 147:13">na ɔhyira wo nkurɔfoɔ a wɔte wo mu.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Ɔma wʼahyeɛ so dwo</para>
  <para style="q1" vid="PSA 147:14">na ɔde ayuo amapa ma wo.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Ɔsoma nʼahyɛdeɛ kɔ asase so;</para>
  <para style="q2" vid="PSA 147:15">nʼasɛm tu mmirika ntɛm so.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Ɔtrɛ sukyerɛmma mu sɛ odwan ho nwi,</para>
  <para style="q2" vid="PSA 147:16">na ɔpete obosuo nsukyeneeɛ sɛ nsõ.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Ɔtoto asukɔtweaa gu fam sɛ mmosea.</para>
  <para style="q2" vid="PSA 147:17">Hwan na ɔbɛtumi agyina nʼawɔ denden no ano?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Ɔsoma nʼasɛm no ma ɛnane no;</para>
  <para style="q2" vid="PSA 147:18">ɔhwanyane ne mframa, na nsuo tene.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Wada nʼasɛm adi akyerɛ Yakob,</para>
  <para style="q2" vid="PSA 147:19">ne mmara ne ɔhyɛ nsɛm akyerɛ Israel.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Ɔnyɛɛ yei mmaa aman foforɔ biara;</para>
  <para style="q2" vid="PSA 147:20">wɔnnim ne mmara.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">Monkamfo <char style="nd">Awurade</char>!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">Dwom 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>Monkamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">Monkamfo <char style="nd">Awurade</char> mfiri ɔsorosoro,</para>
  <para style="q2" vid="PSA 148:1">monkamfo no wɔ ɔsoro sorɔnsorɔmmea.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Nʼabɔfoɔ nyinaa, monkamfo no,</para>
  <para style="q2" vid="PSA 148:2">ne ɔsoro asafo nyinaa, monkamfo no.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Owia ne ɔsrane, monkamfo no,</para>
  <para style="q2" vid="PSA 148:3">nsoromma a ɛhran nyinaa, monkamfo no.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Monkamfo no, ɔsoro mu ɔsoro</para>
  <para style="q2" vid="PSA 148:4">ne mo nsuo a mowɔ ɔsoro atifi.<verse eid="PSA 148:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Momma wɔn nyinaa nkamfo <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="PSA 148:5">ɛfiri sɛ ɔno na ɔhyɛeɛ na wɔbɔɔ wɔn.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Ɔde wɔn sisii hɔ afebɔɔ;</para>
  <para style="q2" vid="PSA 148:6">na wahyɛ nʼasɛm a ɛrentwam da.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Monkamfo <char style="nd">Awurade</char> mfiri asase so,</para>
  <para style="q2" vid="PSA 148:7">mo, ɛpo kɛseɛ mu abɔdeɛ ne ɛpo bunu nyinaa,<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>anyinam ne asukɔtweaa, sukyerɛmma ne omununkum,</para>
  <para style="q2" vid="PSA 148:8">ahum a moyɛ nʼapɛdeɛ,<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>mo, mmepɔ ne nkokoɔ nyinaa,</para>
  <para style="q2" vid="PSA 148:9">nnua a ɛso aba ne ntweneduro nyinaa,<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>wira mu mmoa ne anantwie,</para>
  <para style="q2" vid="PSA 148:10">abɔdeɛ nketewa ne nnomaa a wɔtuo,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>asase ne amanaman nyinaa so ahemfo,</para>
  <para style="q2" vid="PSA 148:11">mo, mmapɔmma ne asase sodifoɔ nyinaa,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>mmeranteɛ ne mmabaawa</para>
  <para style="q2" vid="PSA 148:12">mmasiriwa ne mmɔfra nso.<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Ma wɔnkamfo <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="PSA 148:13">na ne din so sene edin biara;</para>
  <para style="q2" vid="PSA 148:13">nʼanimuonyam korɔn wɔ asase ne ɔsoro so.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Wapagya abɛn bi ama ne nkurɔfoɔ,</para>
  <para style="q2" vid="PSA 148:14">ama nʼahotefoɔ nyinaa animuonyam,</para>
  <para style="q2" vid="PSA 148:14">Israelfoɔ, nnipa a wɔda nʼakoma so no.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">Dwom 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">Monto dwom foforɔ mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 149:1">monkamfo no wɔ ahotefoɔ asafo mu.<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Ma Israel ani nnye ne Yɛfoɔ mu.</para>
  <para style="q2" vid="PSA 149:2">Ma Sion mma ani nnye wɔn Ɔhene mu.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Ma wɔmfa asa nkamfo ne din</para>
  <para style="q2" vid="PSA 149:3">na wɔmfa sankuo ne akasaeɛ nto dwom mma no.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>Na <char style="nd">Awurade</char> ani sɔ ne nkurɔfoɔ;</para>
  <para style="q2" vid="PSA 149:4">ɔde nkwagyeɛ kyɛ hyɛ ahobrɛasefoɔ.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Momma ahotefoɔ nni ahurisie wɔ animuonyam yi mu;</para>
  <para style="q2" vid="PSA 149:5">na wɔnto ahosɛpɛ dwom wɔ wɔn mpa so.<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Onyankopɔn nkamfo nhyɛ wɔn anomu</para>
  <para style="q2" vid="PSA 149:6">na ɛnyɛ akofena anofanu wɔ wɔn nsam,<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>sɛ wɔmfa ntɔ werɛ wɔ amanaman no so</para>
  <para style="q2" vid="PSA 149:7">ne asotwe wɔ nnipa no so,<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>sɛ wɔmfa nyɛ nkɔnsɔnkɔnsɔn nkyekyere wɔn ahemfo,</para>
  <para style="q2" vid="PSA 149:8">ne dadeɛ mpɔkyerɛ ngu wɔn atitire,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>sɛ wɔmfa mmu atɛn sɛdeɛ wɔatwerɛ atia wɔn no.</para>
  <para style="q2" vid="PSA 149:9">Yei ne nʼahotefoɔ nyinaa animuonyam.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">Dwom 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">Monkamfo <char style="nd">Awurade</char> wɔ ne kronkronbea;</para>
  <para style="q2" vid="PSA 150:1">monkamfo no wɔ ɔsoro tumi mu.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Monkamfo no wɔ ne tumi mu nneyɛɛ ho;</para>
  <para style="q2" vid="PSA 150:2">monkamfo no wɔ ne kɛseyɛ a ɛboro biribiara soɔ ho.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Momfa totorobɛnto nnyegyeeɛ nkamfo no,</para>
  <para style="q2" vid="PSA 150:3">momfa asankuo ne bɛnta nkamfo no,<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>momfa akasaeɛ ne asa nkamfo no,</para>
  <para style="q2" vid="PSA 150:4">momfa sankuten ne atɛntɛbɛn nkamfo no,<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>momfa kyankyan mmobɔmu so nkamfo no,</para>
  <para style="q2" vid="PSA 150:5">momfa kyankyan nnyegyeeɛ nkamfo no.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Momma deɛ ɛhome nyinaa nkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
