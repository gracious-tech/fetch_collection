<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">1 Berɛsosɛm</para>
  <para style="toc1">Berɛsosɛm Nwoma A Ɛdi Ɛkan</para>
  <para style="toc2">1 Berɛsosɛm</para>
  <para style="toc3">1 Be</para>
  <para style="mt1">Berɛsosɛm</para>
  <para style="mt2">Nwoma A Ɛdi Ɛkan</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">Ɛfiri Adam So Kɔsi Noa Mma So</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>Adam asefoɔ yɛ Set, Enos,<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>Kenan, Mahalalel, Yared,<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>Henok, Metusela, Lamek,<verse eid="1CH 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 1:4"/>Noa mma ne, Sem, Ham, ne Yafet.<verse eid="1CH 1:4"/></para>
  <para style="s1">Yafet Asefoɔ</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>Na Yafet asefoɔ ne Gomer, Magog, Media, Yawan, Tubal, Mesek ne Tiras.<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>Na Gomer asefoɔ ne Askenas, Rifat ne Togarma.<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>Na Yawan asefoɔ ne Elisa, Tarsis, Kitim ne Rodanim.<verse eid="1CH 1:7"/></para>
  <para style="s1">Ham Asefoɔ</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>Na Ham asefoɔ ne Kus, Misraim, Put ne Kanaan.<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>Na Kus asefoɔ ne Seba, Hawila, Sabta, Raama ne Sabteka. Na Raama asefoɔ yɛ Saba ne Dedan. <verse eid="1CH 1:9"/><verse number="10" style="v" sid="1CH 1:10"/>Kus woo Nimrod. Na Nimrod bɛyɛɛ ɔkofoɔ kɛseɛ wɔ asase so.<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>Misraim yɛ tete agya ma</para>
  <para style="li2" vid="1CH 1:11">Ludfoɔ, Anamfoɔ, Lehabfoɔ, Naftuhfoɔ, <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>Patrusfoɔ, Kasluhfoɔ ne Kaftorfoɔ a wɔn ase na Filistifoɔ firi.<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>Na Kanaan abakan din de</para>
  <para style="li2" vid="1CH 1:13">Sidon a na ɔyɛ Sidonfoɔ tete agya. Na Kanaan nso yɛ Hetifoɔ, <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>Yebusifoɔ, Amorifoɔ, Girgasifoɔ, <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>Hewifoɔ, Arkifoɔ, Sinifoɔ, <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>Arwadfoɔ, Semarifoɔ ne Hamatifoɔ tete agya.<verse eid="1CH 1:16"/></para>
  <para style="s1">Sem Asefoɔ</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>Na Sem asefoɔ yɛ Elam, Asur, Arfaksad, Lud ne Aram.</para>
  <para style="li1" vid="1CH 1:17">Aram asefoɔ ne Us, Hul, Geter ne Mas.<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>Na Arfaksad woo Sela na Sela woo Eber. <verse eid="1CH 1:18"/><verse number="19" style="v" sid="1CH 1:19"/>Eber woo mmammarima baanu. Abakan no din de Peleg a asekyerɛ ne “nkyekyɛmu” ɛfiri sɛ, ne berɛ so na nnipa a wɔwɔ ewiase mu kyekyɛ kɔɔ kasa ahodoɔ mu na wɔbɔ hweteeɛ. Nʼakyiri ba no din de Yoktan.<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>Yoktan woo Almodada, Selef, Hasarmawet, Yera, <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>Hadoram, Usal, Dikla, <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>Obal, Abimael, Seba, <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>Ofir, Hawila ne Yobab. Yeinom nyinaa yɛ Yoktan asefoɔ.<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>Ɛno enti, yei ne abusuadua a ɛfiri Sem: Arfaksad, Sela, <verse eid="1CH 1:24"/><verse number="25" style="v" sid="1CH 1:25"/>Eber, Peleg, Reu, <verse eid="1CH 1:25"/><verse number="26" style="v" sid="1CH 1:26"/>Serug, Nahor, Tera, <verse eid="1CH 1:26"/><verse number="27" style="v" sid="1CH 1:27"/>ne Abram a akyire yi, wɔfrɛɛ no Abraham no.<verse eid="1CH 1:27"/></para>
  <para style="s1">Abraham Asefoɔ</para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 1:28"/>Abraham mmammarima yɛ Isak ne Ismael.<verse eid="1CH 1:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>Na Ismael mmammarima nso ne</para>
  <para style="li2" vid="1CH 1:29">Nebaiot a ɔyɛ nʼabakan, Kedar, Adbeel, Mibsam, <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>Misma, Duma, Masa, Hadad, Tema, <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>Yetur, Nafis ne Kedema.</para>
  <para style="li4" vid="1CH 1:31">Yeinom ne Ismael mmammarima.<verse eid="1CH 1:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>Na Abraham mpena Ketura mmammarima ne Simran, Yoksan, Medan, Midian, Yisbak ne Sua.</para>
  <para style="li1" vid="1CH 1:32">Na Yoksan asefoɔ yɛ Seba ne Dedan.<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>Na Midian mmammarima ne Efa, Efer, Henok, Abida ne Eldaa.</para>
  <para style="li4" vid="1CH 1:33">Yeinom nyinaa yɛ Abraham ne ne mpena Ketura mmammarima.<verse eid="1CH 1:33"/></para>
  <para style="s1">Isak Asefoɔ</para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 1:34"/>Abraham woo Isak. Isak mmammarima yɛ Esau ne Israel.<note caller="+" style="f"><char style="fr" closed="false">1.34 </char><char style="fq" closed="false">Israel: </char><char style="ft" closed="false">Yei ne edin a Onyankopɔn de too Yakob</char></note><verse eid="1CH 1:34"/></para>
  <para style="s1">Esau Asefoɔ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>Na Esau mmammarima yɛ Elifas, Reuel, Yeus, Yalam ne Kora.<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>Na Elifas mmammarima yɛ Teman, Omar, Sefi, Gatam, Kenas, Timna ne Amalek.<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>Na Reuel mmammarima yɛ Nahat, Serah, Sama ne Misa.<verse eid="1CH 1:37"/></para>
  <para style="s1">Edomfoɔ Abɔseɛ</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>Na Seir mmammarima yɛ Lotan, Sobal, Sibeon, Ana, Dison, Eser ne Disan.<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>Na Lotan mmammarima yɛ Hori ne Homam. Na Lotan nuabaa din de Timna.<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>Na Sobal mmammarima yɛ Alian, Manahat, Ebal, Sefi ne Onam.</para>
  <para style="li1" vid="1CH 1:40">Sibeon mmammarima yɛ Aya ne Ana.<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>Na Ana babarima yɛ Dison.</para>
  <para style="li1" vid="1CH 1:41">Na Dison mma yɛ Hemdan, Esban, Yitran ne Keran.<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>Na Eser mmammarima yɛ Bilhan, Saawan ne Akan.</para>
  <para style="li1" vid="1CH 1:42">Na Disan mmammarima yɛ Us ne Aran.<verse eid="1CH 1:42"/></para>
  <para style="s1">Edom Sodifoɔ</para>
  <para style="li4">
    <verse number="43" style="v" sid="1CH 1:43"/>Yeinom ne ahemfo a wɔdii Edom so ansa na Israelfoɔ renya ahemfo:</para>
  <para style="li1" vid="1CH 1:43">Beor babarima Bela, a ɔtenaa kuropɔn Dinhaba so dii ɔhene.<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>Na Bela wuiɛ no, Serah babarima Yobab a ɔfiri Bosra bɛdii nʼadeɛ sɛ ɔhene.<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>Na Yobab wuiɛ no, Husam a ɔfiri Teman asase so bɛdii nʼadeɛ sɛ ɔhene.<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>Husam owuo akyi Hadad a ɔyɛ Bedad babarima a ɔkɔdii Midian so nkonim wɔ Moab asase so no na ɔdii nʼadeɛ sɛ ɔhempɔn. Wɔtoo nʼahenkuro no edin Hawit.<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>Hadad wuiɛ no, Samla a ɔfiri Masreka kuropɔn mu bɛyɛɛ ɔhene.<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>Samla wuiɛ no, Saulo a ɔfiri Rehobot a ɛda asuo Eufrate ho no bɛdii ɔhene.<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>Na Saulo wuiɛ no, Akbor babarima Baal-Hanan bɛdii ɔhene.<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>Baal-Hanan wuiɛ no, Hadad tenaa kuropɔn Pai mu dii ɔhene. Na ne yere a wɔfrɛ no Mehetabel no yɛ Matred babaa ne Me-Sahab nso nana. <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>Na Hadad nso wuiɛ.</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="li4" vid="1CH 1:51">Na Edom mmusua no ntuanofoɔ ne</para>
  <para style="li1" vid="1CH 1:51">Timna, Alwa, Yetet, <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>Oholibama, Ela, Pinon, <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>Kenas, Teman, Mibsar, <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>Magdiel ne Iram.</para>
  <para style="li4" vid="1CH 1:54">Yeinom na na wɔyɛ Edom mmusua ntuanofoɔ.<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">Israel Awoɔ Ntoatoasoɔ</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 2:1"/>Israel mmammarima yɛ Ruben, Simeon, Lewi, Yuda, Isakar, Sebulon, <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>Dan, Yosef, Benyamin, Naftali, Gad ne Aser.<verse eid="1CH 2:2"/></para>
  <para style="s1">Yuda Asefoɔ</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>Yuda ne Kanaanni baa Bat-Sua woo mmammarima baasa.</para>
  <para style="li2" vid="1CH 2:3">Na wɔn din de Er, Onan ne Sela.</para>
  <para style="li2" vid="1CH 2:3">Nanso, na abakan Er no yɛ omumuyɛfoɔ enti, <char style="nd">Awurade</char> kumm no.<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>Akyire no, Yuda ne nʼase kunafoɔ Tamar woo ntafoɔ. Na wɔn din de Peres ne Serah.</para>
  <para style="li4" vid="1CH 2:4">Enti Yuda woo mmammarima baanum.<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>Na Peres mmammarima din de</para>
  <para style="li2" vid="1CH 2:5">Hesron ne Hamul.<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>Serah mmammarima din de</para>
  <para style="li2" vid="1CH 2:6">Simri, Etan, Heman, Kalkol ne Dara; wɔyɛ enum.<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>Akar a ɔyɛ Karmi babarima ne Serah asefoɔ no mu baako nam fa a ɔfaa asadeɛ a wɔgya maa <char style="nd">Awurade</char> no so, de amanehunu baa Israelfoɔ so.<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>Na Etan babarima ne</para>
  <para style="li2" vid="1CH 2:8">Asaria.<verse eid="1CH 2:8"/></para>
  <para style="s1">Ɛfiri Yuda Nana Barima Hesron So Kɔsi Dawid So</para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>Hesron mmammarima edin de Yerahmeel, Ram ne Kaleb.<verse eid="1CH 2:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>Ram yɛ Aminadab agya.</para>
  <para style="li1" vid="1CH 2:10">Aminadab yɛ Nahson a na ɔyɛ Yuda ntuanoni no agya.<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>Nahson yɛ Salma agya.</para>
  <para style="li1" vid="1CH 2:11">Na Salma nso yɛ Boas agya.<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>Boas yɛ Obed agya.</para>
  <para style="li1" vid="1CH 2:12">Obed yɛ Yisai agya.<verse eid="1CH 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>Yisai abakan yɛ Eliab. Deɛ ɔtɔ so mmienu yɛ Abinadab ɛnna deɛ ɔtɔ so mmiɛnsa yɛ Simea. <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>Na deɛ ɔtɔ so ɛnan yɛ Netanel ɛnna Radai tɔ so enum. <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>Ne babarima a ɔtɔ so nsia no din de Osem, na Dawid na na ɔtɔ so nson. <verse eid="1CH 2:15"/><verse number="16" style="v" sid="1CH 2:16"/>Na wɔn nuanom mmaa din de Seruia ne Abigail.</para>
  <para style="li2" vid="1CH 2:16">Na Seruia woo mmammarima baasa a wɔn din yɛ Abisai, Yoab ne Asahel.<verse eid="1CH 2:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="1CH 2:17"/>Abigail waree ɔbarima bi a ne din de Yeter a ɔyɛ Ismaelni na wɔwoo ɔbabarima a wɔtoo no edin Amasa.<verse eid="1CH 2:17"/></para>
  <para style="s1">Hesron Babarima Kaleb Asefoɔ</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>Na Hesron babarima Kaleb wɔ yerenom baanu a wɔne Asuba ne Yeriot. Na Asuba mmammarima edin de Yeser, Sobab ne Ardon.<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>Asuba owuo akyi no, Kaleb waree Efrata. Wɔwoo ɔbabarima too no edin Hur.<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>Hur woo Uri. Uri nso woo Besaleel.<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>Ɛberɛ a Hesron dii mfeɛ aduosia no, ɔwaree Gilead nuabaa a na ɔyɛ Makir babaa. Wɔwoo ɔbabarima too no edin Segub.<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>Segub woo Yair a ɔdii nkuro aduonu mmiɛnsa so wɔ Gilead asase so no.<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>(Akyire no, Gesur ne Aram gyee Yair nkuro, sane gyee Kenat ne ne nkuraa aduosia a atwa ho ahyia no nyinaa.)</para>
  <para style="li4" vid="1CH 2:23">Na yeinom nyinaa yɛ Makir a ɔyɛ Gilead agya no asefoɔ.<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>Hesron wuu wɔ kuro Kaleb-Efrata mu no, ankyɛ na ne yere Abia woo ɔbabarima a wɔtoo no edin Asur (Tekoa agya).<verse eid="1CH 2:24"/></para>
  <para style="s1">Hesron Ba Yerahmeel Asefoɔ</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>Hesron abakan Yerahmeel mmammarima a ɔwoo wɔn no edin yɛ</para>
  <para style="li2" vid="1CH 2:25">Ram (abakan), Buna, Oren, Osem ne Ahiya. <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>Yerahmeel wɔ yere a ɔtɔ so mmienu a wɔfrɛ no Atara, na ɔno na ɔwoo Onam.<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>Ram a ɔyɛ Yerahmeel abakan no mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:27">Maas, Yamin ne Eker.<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>Onam mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:28">Samai ne Yada.</para>
  <para style="li1" vid="1CH 2:28">Na Samai mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:28">Nadab ne Abisur. <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>Na Abisur ne ne yere Abihail mmammarima yɛ Ahban ne Molid.<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>Na Nadab mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:30">Seled ne Apaim. Seled wuiɛ a wanwo mma;<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>na Apaim deɛ, ɔwoo ɔbabarima a wɔfrɛ no Yisi.</para>
  <para style="li2" vid="1CH 2:31">Na Yisi woo Sesan. Na Sesan nyaa nʼaseni bi a wɔfrɛ no Ahlai.<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>Na Samai nuabarima Yada woo</para>
  <para style="li2" vid="1CH 2:32">Yeter ne Yonatan. Na Yeter wuiɛ a wanwo ba biara,<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>nanso Yonatan woo mmammarima baanu a na wɔfrɛ</para>
  <para style="li2" vid="1CH 2:33">wɔn Pelet ne Sasa.</para>
  <para style="li4" vid="1CH 2:33">Na yeinom nyinaa yɛ Yerahmeel asefoɔ.<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>Na Sesan annya mmammarima, ɔnyaa mmammaa.</para>
  <para style="li2" vid="1CH 2:34">Na ɔwɔ Misraimni ɔsomfoɔ bi a ne din de Yarha. <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>Sesan de ne mmammaa no mu baako maa Yarha awadeɛ na wɔwoo ɔbabarima too no edin Atai.<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>Atai woo Natan</para>
  <para style="li1" vid="1CH 2:36">na Natan woo Sabad.<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>Sabad woo Efial.</para>
  <para style="li1" vid="1CH 2:37">Efial woo Obed.<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>Obed woo Yehu</para>
  <para style="li1" vid="1CH 2:38">na Yehu woo Asaria.<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>Asaria woo Heles.</para>
  <para style="li1" vid="1CH 2:39">Heles woo Eleasa.<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>Eleasa woo Sisemai</para>
  <para style="li1" vid="1CH 2:40">na Sisemai woo Salum.<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>Salum woo Yekamia,</para>
  <para style="li1" vid="1CH 2:41">na Yekamia woo Elisama.<verse eid="1CH 2:41"/></para>
  <para style="s1">Hesron Babarima Kaleb Asefoɔ</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>Yerahmeel nua Kaleb</para>
  <para style="li2" vid="1CH 2:42">babarima piesie ne Mesa a ɔyɛ Sif agya.</para>
  <para style="li2" vid="1CH 2:42">Na Kaleb babarima a ɔtɔ so mmienu din de Maresa a ɔyɛ Hebron agya.<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>Na Hebron mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:43">Kora, Tapua, Rekem ne Sema.<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>Na Sema woo Raham.</para>
  <para style="li2" vid="1CH 2:44">Raham woo Yorkeam.</para>
  <para style="li1" vid="1CH 2:44">Na Rekem woo Samai.<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>Na Samai woo Maon.</para>
  <para style="li2" vid="1CH 2:45">Maon woo Bet-Sur.<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>Na Kaleb mpena Efa woo</para>
  <para style="li2" vid="1CH 2:46">Haran, Mosa ne Gases.</para>
  <para style="li2" vid="1CH 2:46">Na Haran woo Gases.<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>Na Yahdai mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:47">Regem, Yotam, Gesan, Pelet, Efa ne Saaf.<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>Kaleb mpena foforɔ bi a wɔfrɛ no Maaka woo</para>
  <para style="li2" vid="1CH 2:48">Seber ne Tirhana.<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>Ɔsane woo Saaf a na ɔyɛ Madmana agya</para>
  <para style="li2" vid="1CH 2:49">ne Sewa a na ɔyɛ Makbena ne Gibea agya.</para>
  <para style="li1" vid="1CH 2:49">Na Kaleb woo ɔbabaa a ne din de Aksa.<verse eid="1CH 2:49"/></para>
  <para style="li4">
    <verse number="50" style="v" sid="1CH 2:50"/>Yeinom nyinaa yɛ Kaleb asefoɔ.</para>
  <para style="s1" vid="1CH 2:50">Kaleb Babarima Hur Asefoɔ</para>
  <para style="li1" vid="1CH 2:50">Kaleb yere Efrata abakan Hur mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:50">Sobal a ɔyɛ Kiriat-Yearim agya <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>Salma a ɔyɛ Betlehem agya ne Haref a ɔyɛ Bet-Gader agya.<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>Sobal a ɔyɛ Kiriat-Yearim agya no mmammarima yɛ</para>
  <para style="li2" vid="1CH 2:52">Haroe a ne fa yɛ Manahatini <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>na ne fa a aka no firi Kiriat-Yearim mmusua mu. Sobal asefoɔ a wɔka ho ne Yitrifoɔ, Putifoɔ, Sumatifoɔ ne Misraimfoɔ. Wɔn mu na Sorafoɔ ne Estaolfoɔ firie.<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>Salma asefoɔ yɛ</para>
  <para style="li2" vid="1CH 2:54">Betlehem, Netofafoɔ, Atrot-Bet-Yoabfoɔ, Manahatfoɔ fa bi, Sorifoɔ, <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>ne atwerɛfoɔ mmusua a wɔte Yabes no, Tirafoɔ, Simeafoɔ ne Sukatfoɔ. Yeinom nyinaa yɛ Kenifoɔ, Hamat a ɔyɛ Rekab agya no asefoɔ.<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s1">Dawid Asefoɔ</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 3:1"/>Yeinom ne mmammarima a wɔwowoo wɔn maa Dawid wɔ Hebron.</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">Na nʼabakan din de Amnon a ne maame a na ɔfiri Yesreel no din de Ahinoam.</para>
  <para style="li1" vid="1CH 3:1">Ne ba a ɔtɔ so mmienu no, na ne din de Daniel. Na ne maame a ɔfiri Karmel no din de Abigail.<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>Ne ba a ɔtɔ so mmiɛnsa no, na wɔfrɛ no Absalom. Na ne maame din de Maaka a na ɔyɛ Gesurhene Talmai babaa.</para>
  <para style="li1" vid="1CH 3:2">Ne ba a ɔtɔ so ɛnan din de Adoniya a ne maame din de Hagit.<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>Ne ba a ɔtɔ so enum no, na wɔfrɛ no Sefatia. Na wɔfrɛ ne maame Abital.</para>
  <para style="li1" vid="1CH 3:3">Ne ba a ɔtɔ so nsia no din de Yitream a na wɔfrɛ ne maame Egla.<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 3:4"/>Wɔwowoo mmammarima baasia yi nyinaa maa Dawid wɔ Hebron. Ɔdii adeɛ wɔ hɔ mfirinhyia nson ne fa.</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="li4" vid="1CH 3:4">Dawid yii kuropɔn no kɔɔ Yerusalem, na ɔdii adeɛ mfirinhyia aduasa mmiɛnsa wɔ hɔ. <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>Mmammarima a wɔwowoo wɔn maa Dawid wɔ Yerusalem no ne:</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">Simea, Sobab, Natan ne Salomo. Amiel babaa Batseba na ɔwoo saa mmarima yi.<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>Wɔsane wowoo mmammarima baakron bi maa Dawid. Wɔne Yibhar, Elisua, Elifelet, <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>Noga, Nefeg, Yafia, <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>Elisama, Eliada ne Elifelet.<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 3:9"/>Yeinom ne Dawid mmammarima a ne mpena mma nka ho. Na Dawid wɔ ɔbabaa bi a wɔfrɛ no Tamar.<verse eid="1CH 3:9"/></para>
  <para style="s1">Salomo Asefoɔ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>Na Salomo asefoɔ yɛ</para>
  <para style="li1" vid="1CH 3:10">Rehoboam, Abia, Asa, Yehosafat,<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>Yehoram, Ahasia, Yoas,<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>Amasia, Asaria, Yotam,<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>Ahas, Hesekia, Manase,<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>Amon ne Yosia.<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>Na Yosia mmammarima ne</para>
  <para style="li2" vid="1CH 3:15">Yohanan a ɔyɛ abakan,</para>
  <para style="li2" vid="1CH 3:15">Yehoiakim a ɔtɔ so mmienu,</para>
  <para style="li2" vid="1CH 3:15">Sedekia a ɔtɔ so mmiɛnsa,</para>
  <para style="li2" vid="1CH 3:15">ɛnna Salum a ɔtɔ so ɛnan.<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>Yehoiakim babarima Yehoiakyin na ɔdii nʼadeɛ,</para>
  <para style="li2" vid="1CH 3:16">ɛnna ɔno nso ne wɔfa Sedekia bɛdii nʼadeɛ.<verse eid="1CH 3:16"/></para>
  <para style="s1">Yehoiakyin Asefoɔ</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>Yehoiakyin a Babiloniafoɔ kyeree no kɔtoo afiase no</para>
  <para style="li2" vid="1CH 3:17">mmammarima ne Sealtiel, <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>Malkiram, Pedaia, Senasar, Yekamia, Hosama ne Nedabia.<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>Na Pedaia mmammarima yɛ</para>
  <para style="li2" vid="1CH 3:19">Serubabel ne Simei.</para>
  <para style="li1" vid="1CH 3:19">Na Serubabel mmammarima yɛ</para>
  <para style="li2" vid="1CH 3:19">Mesulam ne Hanania. Na ɔwɔ ɔbabaa nso a ne din de Selomit. <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>Na ne mmammarima baanum bi nso din ne Hasuba, Ohel, Berekia, Hasadia ne Yusab-Hesed.<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>Na Hanania mmammarima din de</para>
  <para style="li2" vid="1CH 3:21">Pelatia ne Yesaia. Na Yesaia babarima din de Refaia. Na Refaia babarima din de Arnan. Na Arnan babarima din de Obadia. Na Obadia babarima din de Sekania.<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>Na Sekania asefoɔ yɛ</para>
  <para style="li2" vid="1CH 3:22">Semaia ne ne mmammarima Hatus, Igal, Baria, Nearia ne Safat. Na wɔn nyinaa yɛ baasia.<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>Na Nearia mmammarima din de</para>
  <para style="li2" vid="1CH 3:23">Elioenai, Hiskia ne Asrikam. Na wɔyɛ baasa.<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>Na Elioenai mmammarima din de</para>
  <para style="li2" vid="1CH 3:24">Hodawia, Eliasib, Pelaia, Akub, Yohanan, Delaia ne Anani. Na wɔyɛ baason.<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s1">Yuda Asefoɔ Nkaeɛ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>Yuda asefoɔ no bi edin de</para>
  <para style="li2" vid="1CH 4:1">Peres, Hesron, Karmi, Hur ne Sobal.<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>Sobal babarima Reaia na ɔwoo Yahat. Yahat woo Ahumai ne Lahad. Yeinom na na wɔyɛ Sorafoɔ mmusua.<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>Na Etam asefoɔ no ne</para>
  <para style="li2" vid="1CH 4:3">Yesreel, Yisma, Yidbas, ɛnna Haslelponi a na ɔyɛ ne babaa, <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>Penuel a na ɔyɛ Gedor agya ne Eser a na ɔyɛ Husa agya. Yeinom na na wɔyɛ Hur a na ɔyɛ Efrata abakan ne Betlehem agya no asefoɔ.<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>Na Tekoa agya a ne din de Ashur no wɔ yerenom baanu a wɔfrɛ wɔn Hela ne Naara.<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>Naara woo Ahusam, Hefer, Temeni ne Ahastari.<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>Hela woo</para>
  <para style="li2" vid="1CH 4:7">Seret, Sohar, Etnan, <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>ne Kos a nʼasefoɔ ne Anub, Hasobeba ne Harum babarima Aharhel, Harum ne ne mmusua nyinaa.<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>Na ɔbarima bi wɔ hɔ a wɔfrɛ no Yabes a ɔyɛɛ ɔkɛseɛ sene ne nuammarima nyinaa. Ne maame too no edin Yabes, ɛfiri sɛ, ɔnyaa ɔyea wɔ nʼawoɔ mu. <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>Yabes ne obi a ɔbɔɔ mpaeɛ kyerɛɛ Israel Onyankopɔn sɛ, “Ao, hyira me na trɛ mʼahyeɛ mu. Mesrɛ wo, ka me ho wɔ deɛ mɛyɛ biara mu, na yi me firi ɔhaw ne ɔyea nyinaa mu.” Na Onyankopɔn yɛɛ nʼabisadeɛ no maa no.<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>Suba nuabarima Kelub woo Mehir. Mehir woo Eston. <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>Eston woo Bet-Rafa, Paseah ne Tehina. Tehina woo Ir-Nahas. Yeinom ne Reka asefoɔ.<verse eid="1CH 4:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>Kenas mmammarima ne</para>
  <para style="li2" vid="1CH 4:13">Otniel ne Seraia.</para>
  <para style="li1" vid="1CH 4:13">Otniel mmammarima ne</para>
  <para style="li2" vid="1CH 4:13">Hatat ne Meonotai. <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>Meonotai woo Ofra.</para>
  <para style="li1" vid="1CH 4:14">Na Seraia woo Yoab</para>
  <para style="li2" vid="1CH 4:14">a ɔhyɛɛ Adwumfoɔ Bɔnhwa ase, ɛfiri sɛ, na adwumfoɔ pii tete hɔ.<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>Na Yefune babarima Kaleb mmammarima yɛ</para>
  <para style="li2" vid="1CH 4:15">Iru, Ela ne Naam.</para>
  <para style="li1" vid="1CH 4:15">Na Ela babarima yɛ</para>
  <para style="li2" vid="1CH 4:15">Kenas.<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>Yehalelel mmammarima ne</para>
  <para style="li2" vid="1CH 4:16">Sif ne Sifa, Tiria ne Asarel.<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>Ɛsra mmammarima yɛ</para>
  <para style="li2" vid="1CH 4:17">Yeter, Mered, Efer ne Yalon.</para>
  <para style="li1" vid="1CH 4:17">Mered waree Misraimni baa ma ɔwoo Miriam, Samai ne Yisba a ɔbɛyɛɛ Estemoa agya no. <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>Mered nso waree ɔbaa a ɔfiri Yuda.</para>
  <para style="li1" vid="1CH 4:18">Ɔno nso woo Yered a ɔbɛyɛɛ Gedor agya, Heber a ɔyɛ Soko agya, ne Yekutiel a ɔyɛ Sanoa agya. Na wɔfrɛ Mered yere Misraimni no Bitia a na ɔyɛ Misraimhene babaa.<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>Na Hodia yere yɛ Naham nuabaa.</para>
  <para style="li2" vid="1CH 4:19">Ne mmammarima no mu baako na ɔwoo Keila a ɔyɛ Garmini na ɔbaako nso woo Estemoa a ɔyɛ Maakatni.<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>Simon mmammarima ne</para>
  <para style="li2" vid="1CH 4:20">Amnon, Rina, Ben-Hanan ne Tilon.</para>
  <para style="li1" vid="1CH 4:20">Na Yisi asefoɔ no ne</para>
  <para style="li2" vid="1CH 4:20">Sohet ne Ben-Sohet.<verse eid="1CH 4:20"/></para>
  <para style="s1">Yuda Babarima Sela Asefoɔ</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>Na Sela yɛ Yuda mma no mu baako.</para>
  <para style="li2" vid="1CH 4:21">Na Sela asefoɔ no ne Er a ɔwoo Leka, Lada a ɔwoo Maresa a na wɔyɛ nweratam ho adwuma wɔ Bet-Asbea,<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>Yokim, Koseba mmarima, Yoas, ne Saraf a na wɔdi Moab ne Yasubi-Lehem so no. Saa edin yi nyinaa, wɔnya firii tete atwerɛ a na wɔatwerɛ agu hɔ mu. <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>Na wɔyɛ nkukuonwomfoɔ a na wɔte Netaim ne Gedera. Na wɔn nyinaa yɛ nnwuma ma ɔhene.<verse eid="1CH 4:23"/></para>
  <para style="s1">Simeon Asefoɔ</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>Na Simeon mmammarima no edin de</para>
  <para style="li2" vid="1CH 4:24">Nemuel, Yamin, Yarib, Serah ne Saulo.<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>Na Saulo asefoɔ yɛ Salum, Mibsam ne Misma.<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>Na Misma asefoɔ yɛ</para>
  <para style="li2" vid="1CH 4:26">Hamuel, Sakur ne Simei.<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>Simei woo mmammarima dunsia ne mmammaa baasia. Ne nuammarima no deɛ, na wɔn mu biara nni abusua kɛseɛ saa. Ɛno enti, Simeon abusua annɔre te sɛ Yuda abusua no. <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>Wɔtenaa Beer-Seba, Molada ne Hasar-Sual, <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>Bilha, Esem ne Tolad, <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>Betuel, Horma ne Siklag, <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>Bet-Markabot, Hasar-Susim, Bet-Biri ne Saaraim. Na saa nkuro yi nyinaa hyɛɛ wɔn ase kɔsii ɔhene Dawid berɛ so. <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>Wɔn asefoɔ nso tenaa Etam, Ain, Rimon, Token ne Asan a ɛyɛ nkurotoɔ enum yi so, <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>ne ne nkuraaseɛ a atwa ho ahyia no kɔsii Baal.</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="li4" vid="1CH 4:33">Na wɔn atenaeɛ nie, na wɔahyehyɛ saa edin yi nyinaa wɔ wɔn abusuadua nkrataa mu.<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>Wɔn a wɔka Simeon asefoɔ ho no bi nso ne Mesobab, Yamlek</para>
  <para style="li1" vid="1CH 4:34">ne Amasia babarima Yosa, <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>Yoɛl,</para>
  <para style="li1" vid="1CH 4:35">Yosibia babarima Yehu a ɔyɛ Seraia babarima, na ɔno nso yɛ Asiel babarima,<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>Elioenai, Yaakoba, Yesohaia, Asaia, Adiel, Yesimiel ne Benaia, <verse eid="1CH 4:36"/><verse number="37" style="v" sid="1CH 4:37"/>Sifi babarima Sisa a nʼagya yɛ Alon babarima, na ɔno yɛ Yedaia babarima, na ɔno nso yɛ Simri babarima a nʼagya yɛ Semaia.<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 4:38"/>Edin a yɛabobɔ yi yɛ ntuanofoɔ a wɔdeda Simeon mmusuakuo a wɔyɛ adefoɔ no ano no bi.<verse eid="1CH 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 4:39"/>Wɔkɔɔ Gedor fam a na ɛwɔ bɔnhwa no apueeɛ fam sɛ wɔrekɔpɛ asase pa ama wɔn mmoa adidi so. <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>Wɔnyaa mmoa adidibea pa wɔ hɔ. Na asase no so dwo na basabasayɛ biara nni hɔ. Na Ham asefoɔ no bi akɔtena Gedor fa mu hɔ dada.<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>Yudahene Hesekia ɛberɛ so no, Simeon ntuanofoɔ no ko dii hɔ so, sɛee Ham ne Maonfoɔ afie pasaa. Wɔkumm obiara a na ɔte hɔ, faa asase no, ɛfiri sɛ, na wɔpɛ sɛ wɔnya mmoa didibea pa no. <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>Akofoɔ no mu ahanum a wɔfiri Simeon abusuakuo mu no kɔɔ bepɔ Seir so, a na Pelatia, Nearia, Refaia ne Usiel a wɔn nyinaa yɛ Yisi mmammarima no na na wɔdi wɔn anim. <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>Amalekfoɔ kakra a wɔkaeɛ no, wɔkunkumm wɔn nyinaa, faa hɔ, na wɔtenaa hɔ.<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">Ruben Asefoɔ</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 5:1"/>Na Israel babarima panin ne Ruben. Nanso, ɛsiane sɛ wammu nʼagya, na ɔne nʼagya mpenafoɔ no mu baako kɔdaeɛ no enti, ɔde nʼabakanyɛ maa ne nua Yosef mmammarima. Esiane saa asɛm yi enti, wɔamfa Ruben din anka abusuadua no ho sɛ abakan. <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>Yuda asefoɔ na wɔyɛɛ abusuakuo a wɔwɔ tumi pa ara, ne saa enti wɔyii ɔman no sodifoɔ firi wɔn mu, nanso, mpaninnie no deɛ, na ɛyɛ Yosef dea. <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>Israel abakan Ruben no mmammarima ne:</para>
  <para style="b" vid="1CH 5:3"/>
  <para style="li2" vid="1CH 5:3">Hanok, Palu, Hesron ne Karmi.<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>Yoɛl asefoɔ ne</para>
  <para style="li2" vid="1CH 5:4">Semaia, Gog, Simei,<verse eid="1CH 5:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 5:5"/>Mika, Reaia, Baal,<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>ne Beera. Ɛberɛ a Asiriahene Tilgat-Pilneser de Rubenfoɔ kɔɔ nnommumfa mu no, Beera na na ɔdi Rubenfoɔ no anim.<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>Wɔatwerɛ Beera nkurɔfoɔ din sɛdeɛ wɔn mmusua ne abusua no teɛ: Yeiel ne wɔn ntuanoni, ɛnna Sakaria <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>ne Asas babarima Bela a ɔyɛ Sema babarima a ɔyɛ Yoɛl babarima.</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">Saa Rubenfoɔ yi tenaa beaeɛ a ɛfiri Aroer de kɔsi Nebo ne Baal-Meon. <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>Esiane sɛ na wɔwɔ anantwie bebree wɔ Gilead asase so no enti, wɔdidi kɔɔ apueeɛ fam wɔ anweatam a ɛtrɛ kɔ Asubɔnten Eufrate no ho.<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>Ɔhene Saulo pɛn so, Rubenfoɔ dii Hagarfoɔ<note caller="+" style="f"><char style="fr" closed="false">5.10 </char><char style="ft" closed="false">Hagarfoɔ. (<char style="xt"><ref loc="1CH 5:19-22">1 Be 5.19-22</ref></char>) Saa abusua a wɔyɛ Hagar a na ɔyɛ Ismael ne na (<char style="xt"><ref loc="GEN 16">1 Mose 16</ref></char>) asefoɔ no, na wɔyɛ Israelfoɔ atamfoɔ no mu baako (<char style="xt"><ref loc="PSA 83:6">Nnw 83.6</ref></char>).</char></note> so nkonim wɔ ɔko mu. Enti, wɔtu kɔɔ Hagarfoɔ atenaeɛ a ɛwɔ Gilead apueeɛ fam hɔ no.<verse eid="1CH 5:10"/></para>
  <para style="s1">Gad Asefoɔ</para>
  <para style="li4">
    <verse number="11" style="v" sid="1CH 5:11"/>Basan asase so no, na Gad asefoɔ na wɔtete asase a ɛdi Rubenfoɔ deɛ no so. Wɔtrɛ kɔɔ apueeɛ fam kɔsii Saleka.<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>Na Yoɛl na ɔtua wɔn ano wɔ Basan asase so. Na Safam, Yanai ne Safat yɛ nʼaboafoɔ.<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>Na wɔn abusuafoɔ a wɔyɛ ntuanofoɔ ma mmusua afoforɔ nson din ne:</para>
  <para style="li2" vid="1CH 5:13">Mikael, Mesulam, Seba, Yorai, Yakan, Sia ne Eber.<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>Yeinom nyinaa yɛ Huri babarima Abihail a ɔyɛ Yaroa babarima, Gilead babarima, Mikael babarima, Yesisai babarima Yahdo babarima, Bus babarima.<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>Abdiel babarima Ahi, Guni babarima no na na ɔyɛ wɔn mmusua no ntuanoni.<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>Gadfoɔ no tenaa Gilead asase a ɛwɔ Basan ne ne nkuraaseɛ ne Saron tata no nyinaa so.<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>Yudahene Yotam ne Israelhene Yeroboam ɛberɛ so na wɔtwerɛɛ yeinom nyinaa guu abusuadua nkrataa mu.<verse eid="1CH 5:17"/></para>
  <para style="s1">Yordan Apueeɛ Fam Mmusuakuo</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>Na akofoɔ akɛseɛ a wɔwɔ Ruben, Gad mmusua ne Manase abusua fa mu no ano si ɔpeduanan ɛnan ahanson ne aduosia. Wɔkurakura akokyɛm, akofena ne agyan, na wɔn nyinaa akwadare wɔ akodie mu. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>Wɔko tiaa Hagarfoɔ, Yeturfoɔ, Nafisfoɔ ne Nodabfoɔ. <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>Wɔsu frɛɛ Onyankopɔn wɔ ɔko no mu, na ɔtiee wɔn mpaeɛbɔ, ɛfiri sɛ, wɔde wɔn ho too no so. Enti, wɔdii Hagarfoɔ no ne wɔn dɔm nyinaa so nkonim. <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>Asadeɛ a wɔfa firii Hagarfoɔ no nkyɛn no yɛ nyoma ɔpeduonum, nnwan ɔpehanu aduonum, mfunumu mpenu ne nneduafoɔ ɔpeha. <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>Wɔkunkumm Hagarfoɔ no bebree ɔko no mu, ɛfiri sɛ, na Onyankopɔn reko tia wɔn. Enti, wɔtenaa wɔn asase so, kɔsii sɛ wɔtwaa wɔn asuo.<verse eid="1CH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>Manase abusua fa no trɛɛ wɔ asase no so firi Basan kɔsii Baal-Hermon, Senir ne bepɔ Hermon ho. Na wɔdɔɔso yie. <verse eid="1CH 5:23"/><verse number="24" style="v" sid="1CH 5:24"/>Yeinom ne wɔn mmusua no ntuanofoɔ: Efer, Yisi, Eliel, Asriel, Yeremia, Hodawia ne Yahdiel. Na wɔn mu biara agye edin sɛ ɔkofoɔ kɛseɛ ne ɔkandifoɔ. <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>Nanso, na wɔnni nokorɛ, na wɔbuu wɔn agyanom ne Onyankopɔn apam no so. Wɔsomm aman a Onyankopɔn sɛee wɔn no anyame. <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>Enti, Israel Onyankopɔn de hyɛɛ Asiriahene Pul (a na wɔsane frɛ no Tiglat-Pileser) akoma mu sɛ ɔnko mfa asase no, na ɔnkyekyere Rubenfoɔ, Gadfoɔ ne Manasefoɔ abusua fa sɛ nneduafoɔ. Asiariafoɔ no twaa wɔn asuo kɔɔ Halah, Habor, Hara ne Asubɔnten Gosan ho a wɔda so te hɔ bɛsi ɛnnɛ.<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">Asɔfoɔ Awoɔ Ntoatoasoɔ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>Na Lewi mmammarima yɛ:</para>
  <para style="li2" vid="1CH 6:1">Gerson, Kohat ne Merari.<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>Na Kohat asefoɔ nso yɛ:</para>
  <para style="li2" vid="1CH 6:2">Amram, Ishar, Hebron ne Usiel.<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>Na Amram mma yɛ:</para>
  <para style="li2" vid="1CH 6:3">Aaron, Mose ne Miriam.</para>
  <para style="li1" vid="1CH 6:3">Na Aaron mmammarima yɛ:</para>
  <para style="li2" vid="1CH 6:3">Nadab, Abihu, Eleasa ne Itamar.<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>Eleasa woo Pinehas.</para>
  <para style="li2" vid="1CH 6:4">Pinehas woo Abisua.<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>Abisua woo Buki,</para>
  <para style="li2" vid="1CH 6:5">na Buki woo Usi,<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>Usi woo Serahia, Serahia woo Meraiot,<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>Meraiot woo Amaria,</para>
  <para style="li2" vid="1CH 6:7">na Amaria woo Ahitub,<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>Ahitub woo Sadok,</para>
  <para style="li2" vid="1CH 6:8">na Sadok woo Ahimaas,<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>Ahimaas woo Asaria,</para>
  <para style="li2" vid="1CH 6:9">Asaria woo Yohanan,<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>Yohanan woo Asaria,</para>
  <para style="li2" vid="1CH 6:10">a ɔno na na ɔyɛ ɔsɔfopanin wɔ asɔredan a Salomo sii wɔ Yerusalem no mu.<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>Asaria woo Amaria,</para>
  <para style="li2" vid="1CH 6:11">Amaria woo Ahitub,<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>Ahitub woo Sadok,</para>
  <para style="li2" vid="1CH 6:12">Sadok woo Salum,<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>Salum woo Hilkia,</para>
  <para style="li2" vid="1CH 6:13">Hilkia woo Asaria.<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>Asaria woo Seraia,</para>
  <para style="li2" vid="1CH 6:14">Seraia woo Yehosadak.<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>Wɔtwaa Yehosadak asuo ɛberɛ a <char style="nd">Awurade</char> de Yudafoɔ ne Yerusalemfoɔ kɔɔ nnommum mu a na wɔhyɛ Nebukadnessar ase no.<verse eid="1CH 6:15"/></para>
  <para style="s1">Lewifoɔ Mmusua</para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>Na Lewi mmammarima din de:</para>
  <para style="li2" vid="1CH 6:16">Gersom, Kohat ne Merari.<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>Na Libni ne Simei ka Gerson asefoɔ ho.<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>Na Amram, Ishar, Hebron ne Usiel</para>
  <para style="li2" vid="1CH 6:18">ka Kohat asefoɔ no ho.<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>Na Mahli ne Musi</para>
  <para style="li2" vid="1CH 6:19">ka Merari asefoɔ no ho.</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="li4" vid="1CH 6:19">Yeinom ne Lewifoɔ mmusua sɛdeɛ wɔn mpanimfoɔ nnidisoɔ teɛ.<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>Na Gerson asefoɔ yɛ:</para>
  <para style="li2" vid="1CH 6:20">Libni, Yahat,</para>
  <para style="li2" vid="1CH 6:20">Sima, <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>Yoa,</para>
  <para style="li2" vid="1CH 6:21">Ido, Serah</para>
  <para style="li2" vid="1CH 6:21">ne Yeaterai.<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>Na Kohat asefoɔ ne</para>
  <para style="li2" vid="1CH 6:22">Aminadab, Kora,</para>
  <para style="li2" vid="1CH 6:22">Asir, <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>Elkana,</para>
  <para style="li2" vid="1CH 6:23">Ebiasaf, Asir,<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>Tahat, Uriel,</para>
  <para style="li2" vid="1CH 6:24">Usia ne Saulo.<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>Na Elkana asefoɔ ne:</para>
  <para style="li2" vid="1CH 6:25">Amasai, Ahimot,<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>Sofai, Nahat,<verse eid="1CH 6:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 6:27"/>Eliab,</para>
  <para style="li2" vid="1CH 6:27">Yeroham, Elkana ne Samuel.<verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>Na Samuel mmammarima din ne:</para>
  <para style="li2" vid="1CH 6:28">Yoɛl a ɔyɛ ɔpanin</para>
  <para style="li2" vid="1CH 6:28">ne Abiya a ɔtɔ so mmienu no.<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>Na Merari mma ne:</para>
  <para style="li2" vid="1CH 6:29">Mahli, Libni,</para>
  <para style="li2" vid="1CH 6:29">Simei, Usa,<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>Simea, Hagia</para>
  <para style="li2" vid="1CH 6:30">ne Asaia.<verse eid="1CH 6:30"/></para>
  <para style="s2">Asɔredan Mu Nnwom Ho Nimdefoɔ</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>Dawid maa saa nnipa a wɔn din didi soɔ yi dii <char style="nd">Awurade</char> fie nnwom anim, ɛberɛ a wɔde Apam Adaka no sii hɔ no. <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>Wɔde nnwom kaa wɔn som ho wɔ Ahyiaeɛ Ntomadan no mu hɔ, kɔsii sɛ Salomo sii <char style="nd">Awurade</char> asɔredan no wɔ Yerusalem. Afei, wɔnam mmara a wɔde maa wɔn so dii wɔn dwuma wɔ hɔ.<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="33" style="v" sid="1CH 6:33"/>Saa mmarima yi na wɔne wɔn mma somm wɔ hɔ no.</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">Heman, dwom ho nimdefoɔ no, na ɔfiri Kohat abusua mu.</para>
  <para style="li2" vid="1CH 6:33">Wɔto nʼabusuadua ana firi</para>
  <para style="li2" vid="1CH 6:33">Yoɛl, Samuel,<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>Elkana, Yeroham,</para>
  <para style="li2" vid="1CH 6:34">Eliel, Yoa,<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>Suf, Elkana,</para>
  <para style="li2" vid="1CH 6:35">Mahat, Amasai,<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>Elkana, Yoɛl,</para>
  <para style="li2" vid="1CH 6:36">Asaria, Sefania,<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>Tahat, Asir,</para>
  <para style="li2" vid="1CH 6:37">Ebiasaf, Kora,<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>Ishar, Kohat,</para>
  <para style="li2" vid="1CH 6:38">Lewi ne Israel ase;<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>Herman abadiakyire a ɔdi ɛkan no din de Asaf, a na ɔfiri Gerson abusua mu.</para>
  <para style="li2" vid="1CH 6:39">Wɔto Asaf abusuadua ana firi Berekia, Simea,<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>Mikael, Baaseia,</para>
  <para style="li2" vid="1CH 6:40">Malkia, <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>Etni,</para>
  <para style="li2" vid="1CH 6:41">Serah, Adaia,<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>Etan, Sima,</para>
  <para style="li2" vid="1CH 6:42">Simei, <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>Yahat, Gersom ne Lewi ase.<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>Herman abadiakyire a ɔtɔ so mmienu no din de Etan, a na ɔfiri Merari abusua mu.</para>
  <para style="li2" vid="1CH 6:44">Wɔto Etan abusuadua ana firi Kisi, Abdi,</para>
  <para style="li2" vid="1CH 6:44">Maluk, <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>Hasabia,</para>
  <para style="li2" vid="1CH 6:45">Amasia, Hilkia,<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>Amsi, Bani, Semer, <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>Mahli,</para>
  <para style="li2" vid="1CH 6:47">Musi, Merari ne Lewi ase.<verse eid="1CH 6:47"/></para>
  <para style="s2">Aaron Asefoɔ</para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>Na wɔn abusuafoɔ a wɔyɛ Lewifoɔ no nso, wɔmaa wɔn dwuma ahodoɔ bi dii wɔ Ahyiaeɛ Ntomadan a ɛyɛ Onyankopɔn fie no mu. <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>Aaron ne nʼasefoɔ nko na wɔsom sɛ asɔfoɔ. Na wɔde afɔrebɔdeɛ gu ɔhyeɛ afɔrebukyia ne ohwam afɔrebukyia so, na wɔdi dwuma biara a ɛfa kronkron mu kronkron hɔ ho. Wɔnam mmara a Onyankopɔn ɔsomfoɔ Mose de maa wɔn no so yɛɛ mpatadeɛ maa Israel.<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>Na Aaron asefoɔ yɛ:</para>
  <para style="li2" vid="1CH 6:50">Eleasa, Pinehas, Abisua, <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>Buki, Usi, Serahia,<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>Meraiot, Amaria, Ahitub, <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>Sadok ne Ahimaas.<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="54" style="v" sid="1CH 6:54"/>Yei ne abakɔsɛm a ɛfa nkuro ne asase a wɔnam ntontobɔ kronkron so de maa Aaron ne nʼasefoɔ a wɔfiri Kohat abusua mu no.<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>Na Hebron ne mmoa adidibea nsase a atwa ho ahyia wɔ Yuda no ka ho. <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>Nanso, kuro no ho mfuo ne ɛho nkuraa no deɛ, wɔde maa Yefune babarima Kaleb. <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>Enti, saa nkuro yi a mmoa adidibea atwa ebiara ho ahyia na wɔde maa Aaron asefoɔ: Hebron a ɛyɛ dwanekɔbea kuro, Libna, Yatir, Estemoa, <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>Hilen, Debir, <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>Asan, Yuta ne Bet-Semes. <verse eid="1CH 6:59"/><verse number="60" style="v" sid="1CH 6:60"/>Na wɔmaa wɔn Gibeon, Geba, Alemet ne Anatot firii Benyamin asase mu a mmoa adidibea ka emu biara ho.</para>
  <para style="li4" vid="1CH 6:60">Enti, nkurotoɔ dumiɛnsa na wɔde maa Aaron asefoɔ.<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>Na Kohat asefoɔ a wɔkaeɛ no nso, wɔnyaa nkurotoɔ edu a wɔnam ntontobɔ kronkron so firii Manase abusua fa no asase so.<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>Gerson asefoɔ nam ntontobɔ kronkron so nyaa nkurotoɔ dumiɛnsa firii Isakar, Aser ne Naftali nsase so. Wɔnyaa bi nso firii Basan pɔ mu a ɛyɛ Manase dea, a ɛwɔ Yordan apueeɛ fam no.<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>Merari asefoɔ nam ntontobɔ kronkron so, nyaa nkurotoɔ dumienu firii Ruben, Gad ne Sebulon nsase so.<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="64" style="v" sid="1CH 6:64"/>Enti, Israelfoɔ de saa nkuro yi ne mmoa adidibea yi nyinaa maa Lewifoɔ.<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>Wɔnam ntontobɔ kronkron so na wɔde nkuro a ɛwowɔ Yuda, Simeon ne Benyamin nsase so maeɛ sɛdeɛ wɔaka dada no.<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="66" style="v" sid="1CH 6:66"/>Saa nkurotoɔ yi ne ɛho mmoa adidibea na Kohat asefoɔ nya firii Efraim asase so:<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>Sekem a ɛyɛ dwanekɔbea kuro a ɛwɔ Efraim bepɔ asase no so, Geser, <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>Yokmeam, Bet-Horon, <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>Ayalon ne Gat-Rimon.<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>Kohat asefoɔ nkaeɛ no, wɔde saa nkurotoɔ a ɛfiri Manase abusua fa no mu na ɛmaa wɔn: Aner ne Bileam a emu biara mmoa adidibea ka ho.<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="71" style="v" sid="1CH 6:71"/>Gerson asefoɔ nyaa kuro a wɔfrɛ no Golan a ɛwɔ Basan no firii Manase abusua fa asase so a Astarot ka ho, a ne nyinaa mmoa adidibea da ho.<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>Isakar asase so nso, wɔmaa wɔn Kedes, Daberat, <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>Ramot ne Anem a wɔn mmoa adidibea ka ho.<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>Aser asase so, wɔnyaa Masal, Abdon, <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>Hukok ne Rehob a na emu biara mmoa adidibea ka ho.<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>Naftali asase so, wɔde Kedes a ɛwɔ Galilea, Hamon ne Kiriataim maa wɔn, a na mmoa adidibea ka emu biara ho.<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="77" style="v" sid="1CH 6:77"/>Merari asefoɔ nkaeɛ no nyaa Yokneam, Karta, Rimon ne Tabor nkuro firi Sebulon asase so, a na mmoa adidibea ka ebiara ho.<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>Ruben asase a ɛda Asubɔnten Yordan apueeɛ fam a ɛne Yeriko di nhwɛanim no nso, wɔnyaa Beser a ɛyɛ anweatam kuro, Yahas, <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>Kedemot ne Mefaat a mmoa adidibea ka emu biara ho.<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>Na Gad asase so nso, wɔnyaa Ramot a ɛwɔ Gilead, Mahanaim, <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>Hesbon ne Yaser a mmoa adidibea ka ebiara ho.<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">Isakar Asefoɔ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>Na Isakar mmammarima baanan no din de</para>
  <para style="li2" vid="1CH 7:1">Tola, Pua, Yasub ne Simron.<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>Tola mmammarima no ne:</para>
  <para style="li2" vid="1CH 7:2">Usi, Refaia, Yeriel, Yahmai, Yibsam ne Samuel. Na wɔn mu biara yɛ wɔn agyanom mmusua ntuanofoɔ. Ɔhene Dawid ɛberɛ so no, na mmarima dodoɔ a wɔwɔ saa mmusua yi mu a wɔyɛ asraafoɔ no dodoɔ yɛ ɔpeduonu mmienu ne ahansia (22,600).<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>Na Usi babarima din de:</para>
  <para style="li2" vid="1CH 7:3">Yisrahia.</para>
  <para style="li1" vid="1CH 7:3">Na Yisrahia mmammarima din de:</para>
  <para style="li2" vid="1CH 7:3">Mikael, Obadia, Yoɛl ne Yisia a na wɔn baanum tuatua mmusua ano. <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>Mmarima dodoɔ a na wɔwɔ hɔ a wɔyɛ asraafoɔ no dodoɔ yɛ ɔpeduasa nsia. Na wɔn baanum no nyinaa yerenom ne wɔn mmammarima yɛ bebree.<verse eid="1CH 7:4"/></para>
  <para style="li4">
    <verse number="5" style="v" sid="1CH 7:5"/>Mmarima a na wɔwɔ hɔ a wɔfiri Isakar mmusua no nyinaa mu a wɔyɛ asraafoɔ no dodoɔ yɛ ɔpeduɔwɔtwe nson (87,000). Wɔtwerɛɛ wɔn nyinaa din nnidisoɔ nnidisoɔ guu wɔn abusuadua krataa mu.<verse eid="1CH 7:5"/></para>
  <para style="s1">Benyamin Asefoɔ</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>Na Benyamin mmammarima baasa no din de:</para>
  <para style="li2" vid="1CH 7:6">Bela, Beker ne Yediael.<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>Na Bela mmammarima yɛ:</para>
  <para style="li2" vid="1CH 7:7">Esbon, Usi, Usiel, Yerimot ne Iri. Na saa akofoɔ baanum yi yɛ mmusua ntuanofoɔ. Nnipa a wɔfiri wɔn asefoɔ mu yɛɛ asraafoɔ no dodoɔ yɛ ɔpeduonu mmienu ne aduasa ɛnan (22,034). Wɔtwerɛɛ wɔn nyinaa din guu wɔn abusuadua krataa mu.<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>Na Beker mmammarima din de:</para>
  <para style="li2" vid="1CH 7:8">Semira, Yoas, Elieser, Elioenai, Omri, Yeremot, Abia, Anatot ne Alemet. <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>Sɛdeɛ na wɔn abusuadua kyerɛ no, na wɔn abusua ntuanofoɔ akyi no, wɔn asefoɔ ɔpeduonu ne ahanu (20,200) wɔ hɔ a wɔtumi dɔm sraa.<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>Na Yediael babarima ne:</para>
  <para style="li2" vid="1CH 7:10">Bilhan.</para>
  <para style="li1" vid="1CH 7:10">Na Bilhan mmammarima ne:</para>
  <para style="li2" vid="1CH 7:10">Yeus, Benyamin, Ehud, Kenaana, Setan, Tarsis ne Ahisahar. <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>Na wɔyɛ Yediael mmusua no mu ntuanofoɔ a wɔn asefoɔ a na wɔka wɔn ho a wɔtumi dɔm sraa no dodoɔ yɛ ɔpedunson ne ahanu (17,200).<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>Na Ir mmammarima ne Supim, ne Hupim. Aher na ɔwoo Husim.<verse eid="1CH 7:12"/></para>
  <para style="s1">Naftali Asefoɔ</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>Na Naftali mmammarima yɛ:</para>
  <para style="li2" vid="1CH 7:13">Yahsiel, Guni, Yeser ne Salum. Na wɔn nyinaa yɛ Yakob yere Bilha asefoɔ.<verse eid="1CH 7:13"/></para>
  <para style="s1">Manase Asefoɔ</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>Manase mmammarima a ɔne ne mpena Aramni wowoo wɔn ne Asriel ne Makir. Makir na ɔwoo Gilead. <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>Makir pɛɛ ɔyerenom maa Hupim ne Supim. Na wɔfrɛ Makir nuabaa Maaka. Na Makir asefoɔ no mu baako a wɔfrɛ no Selofehad wowoo mmammaa nko ara. <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>Makir yere Maaka woo ɔbabarima a ɔtoo no edin Peres. Na ne nuabarima din de Seres. Peres mmammarima din de Ulam ne Rekem.<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>Na Ulam babarima din de:</para>
  <para style="li2" vid="1CH 7:17">Bedan.</para>
  <para style="li1" vid="1CH 7:17">Na wɔn nyinaa yɛ Gileadfoɔ a wɔyɛ Manase babarima Makir asefoɔ.<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>Makir nuabaa Moleket woo Is-Hod, Abieser ne Mahla.<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>Na Semida mmammarima yɛ:</para>
  <para style="li2" vid="1CH 7:19">Ahian, Sekem, Likhi ne Aniam.<verse eid="1CH 7:19"/></para>
  <para style="s1">Efraim Asefoɔ</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>Efraim asefoɔ ne:</para>
  <para style="li2" vid="1CH 7:20">Sutela, Bered, Tahat, Elada,</para>
  <para style="li2" vid="1CH 7:20">Tahat, <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>Sabad ne Sutela.</para>
  <para style="li2" vid="1CH 7:21">Wɔkunkumm Efraim mmammarima Eser ne Elad wɔ Gat, ɛfiri sɛ, wɔpɛɛ sɛ wɔwia nyɛmmoa firi akuafoɔ a wɔbɛn hɔ no. <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>Wɔn agya Efraim suu wɔn kyɛree yie, na nʼabusuafoɔ bɛkyekyeree ne werɛ. <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>Ɛno akyi, Efraim kɔɔ ne yere ho, na ɔnyinsɛnee, woo ɔbabarima. Efraim too no edin Beria ɛsiane abɛbrɛsɛ a nʼabusuafoɔ faa mu no enti. <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>Efraim woo ɔbabaa too no edin Seer. Ɔno na ɔkyekyeree nkuro Bet-Horon Anafoɔ, Atifi ne Usen-Seera.<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>Efraim asefoɔ nnidisoɔ ne Refa, Resef, Tela, Tahan<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>Ladan, Amihud, Elisama, <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>Nun ne Yosua.<verse eid="1CH 7:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 7:28"/>Efraim asefoɔ no tenaa asase Bet-El ne ne nkurotoɔ a atwa afa anafoɔ fam, Naaran a ɛda apueeɛ fam, Geser ne ne nkuraaseɛ a ɛda atɔeɛ fam ne Sekem ne ne nkuraaseɛ a atwa ho ahyia, kɔfa atifi fam, de kɔsi Aya a nkuraaseɛ ka ho no so. <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>Manase hyeɛ so no, na nkuro a ɛdeda hɔ yɛ Bet-Sean, Taanak, Megido, Dor ne wɔn nkuraase a atwa ho ahyia no. Israel ba Yosef asefoɔ tenaa saa nkuro yi so.<verse eid="1CH 7:29"/></para>
  <para style="s1">Aser Asefoɔ</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>Na Aser mmammarima yɛ:</para>
  <para style="li2" vid="1CH 7:30">Yimna, Yiswa, Yiswi ne Beria. Na wɔwɔ nuabaa a ne din de Sera.<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>Na Beria mmammarima din de:</para>
  <para style="li2" vid="1CH 7:31">Heber ne Malkiel a ɔwoo Birsait no.<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>Na Heber mmammarima din de Yaflet, Somer ne Hotam. Na wɔwɔ nuabaa a ne din de Sua.<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>Na Yaflet mmammarima din de:</para>
  <para style="li2" vid="1CH 7:33">Pasak, Bimhal ne Aswat.<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>Na Semer mmammarima din de:</para>
  <para style="li2" vid="1CH 7:34">Ahi, Rohga, Hubah ne Aram.<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>Na ne nuabarima Helem mmammarima din de:</para>
  <para style="li2" vid="1CH 7:35">Sofa, Yimna, Seles ne Amal.<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>Na Sofa mmammarima din de:</para>
  <para style="li2" vid="1CH 7:36">Suah, Harnefer, Sual, Beri, Yimra, <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>Beser, Hod, Sama, Silsa, Yitran ne Beera.<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>Na Yeter mmammarima din de:</para>
  <para style="li2" vid="1CH 7:38">Yefune, Pispa ne Ara.<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>Na Ula mmammarima din de:</para>
  <para style="li2" vid="1CH 7:39">Arah, Haniel ne Risia.<verse eid="1CH 7:39"/></para>
  <para style="li4">
    <verse number="40" style="v" sid="1CH 7:40"/>Na Aser asefoɔ no mu biara yɛ wɔn agyanom abusua ɔdaanoni. Na wɔn nyinaa yɛ akofoɔ pa ne ntuanofoɔ a wɔdi mu. Na mmarima ɔpeduonu nsia (26,000) na wɔwɔ hɔ a wɔatwerɛ wɔn din agu wɔn mmusuadua nwoma mu a wɔyɛ akofoɔ a wɔagye edin.<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">Benyamin Asefoɔ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>Benyamin mmammarima na ɛdidi soɔ yi:</para>
  <para style="li2" vid="1CH 8:1">Bela (abakan), Asbel, Ahra,<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>Noha ne Rafha.<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>Bela mmammarima yɛ:</para>
  <para style="li2" vid="1CH 8:3">Adar, Gera, Abihud, <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>Abisua, Naaman, Ahoa, <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>Gera, Sefufan ne Huram.<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>Ehud mmammarima, mmusua ntuanofoɔ, a na wɔte Geba a wɔpamoo wɔn firii hɔ kɔɔ Manahat nie:<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>Naaman, Ahiya ne Gera. Gera a na ɔyɛ Usa ne Ahihud agya no na ɛberɛ a wɔretu no, ɔdii wɔn anim.<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>Saharaim gyaee ne yerenom Husim ne Baara akyi no, ɔwoo mma wɔ Moab asase so. <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>Ne yere foforɔ Hodes woo Yobab, Sibia, Mesa, Malkam, <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>Yeus, Sakia ne Mirma. Saa mmammarima yi bɛyɛɛ mmusua ntuanofoɔ. <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>Na Saharaim yere Husim awo Abitub ne Elpaal dada.<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>Elpaal mmammarima yɛ:</para>
  <para style="li2" vid="1CH 8:12">Eber, Misam ne Semed a ɔkyekyeree Ono ne Lod ne wɔn nkuraaseɛ no, <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>Beria ne Sema. Na wɔyɛ mmusua ntuanofoɔ a na wɔte Ayalon, na wɔpamoo ɔmanfoɔ a wɔte Gat no.<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>Beria mmammarima yɛ Ahio, Sasak, Yeremot, <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>Sebadia, Arad, Eder, <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>Mikael, Yispa ne Yoha.<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>Elpaal mmammarima yɛ Sebadia, Mesulam, Hiski, Heber, <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>Ismerai, Yislia ne Yobab.<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>Simei mmammarima yɛ Yakim, Sikri, Sabdi, <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>Elienai, Siletai, Eliel, <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>Adaia, Beraia ne Simrat.<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>Sasak mmammarima yɛ Yispan, Eber, Eliel, <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>Abdon, Sikri, Hanan, <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>Hanania, Elam, Antotia, <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>Yifdeia ne Penuel.<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>Yeroham mmammarima yɛ: Samserai, Seharia, Atalia, <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>Yaaresia, Elia ne Sikri.<verse eid="1CH 8:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 8:28"/>Yeinom ne agyanom mmusua ntuanofoɔ a wɔatwerɛ wɔn din wɔ wɔn mu biara abusuadua nkrataa mu. Na wɔn nyinaa tenaa Yerusalem.<verse eid="1CH 8:28"/></para>
  <para style="s1">Saulo Abusua</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>Yeiel (Gibeon agya) tenaa Gibeon. Na ne yere din de Maaka <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>a na ne babarima piesie din de Abdon. Na Yeiel mmammarima a wɔaka no din de Sur, Kis, Baal, Ner, Nadab, <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>Gedor, Ahio, Seker, <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>ne Miklot a ɔyɛ Simea agya. Na saa mmusuafoɔ yi tete bemmɛn wɔn ho wɔn ho wɔ Yerusalem.<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>Ner na ɔwoo Kis. Kis na ɔwoo Saulo, Saulo na ɔwoo Yonatan, Malki-Sua, Abinadab ne Esbaal.<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>Yonatan babarima ne:</para>
  <para style="li2" vid="1CH 8:34">Merib-Baal (anaa Mefiboset) na Merib-Baal woo Mika.<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>Mika mmammarima ne:</para>
  <para style="li2" vid="1CH 8:35">Piton, Melek, Tarea ne Ahas.<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>Ahas woo Yehoada na Yehoada woo Alemet, Asmawet ne Simri. Na Simri woo Mosa. <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>Mosa woo Binea. Binea woo Rafha. Rafha woo Elasa. Elasa woo Asel.<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>Asel woo mmammarima baasia a wɔne:</para>
  <para style="li2" vid="1CH 8:38">Asrikam, Bokeru, Ismael, Searia, Obadia ne Hanan. Na yeinom yɛ Asel mma.<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>Na Asel nuabarima Esek wɔ mmammarima baasa a wɔne</para>
  <para style="li2" vid="1CH 8:39">Ulam a ɔyɛ abakan, Yeus a ɔtɔ so mmienu ne Elifelet a ɔtɔ so mmiɛnsa. <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>Ulam mmammarima nyinaa yɛ akofoɔ a wɔakwadare wɔ akodie mu, na wɔyɛ agyantofoɔ toamfom. Na wɔwɔ mma ne mmanananom bebree a na wɔn nyinaa dodoɔ yɛ ɔha aduonum.</para>
  <para style="li1" vid="1CH 8:40">Yeinom nyinaa yɛ Benyamin asefoɔ.<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>Wɔtwerɛɛ Israel abusuadua biara mu nnipa din guu Israel ne Yuda Ahemfo nwoma mu. Esiane sɛ na Yudafoɔ no nni <char style="nd">Awurade</char> nokorɛ no enti, wɔtwaa wɔn asuo kɔɔ Babilonia.<verse eid="1CH 9:1"/></para>
  <para style="s1">Atukɔfoɔ A Wɔsane Baeɛ</para>
  <para style="li4">
    <verse number="2" style="v" sid="1CH 9:2"/>Wɔn a wɔsane baeɛ bɛfaa wɔn agyapadeɛ wɔ wɔn nkuro dada mu no yɛ Israelfoɔ bi, asɔfoɔ, Lewifoɔ ne asɔredan mu aboafoɔ.<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="1CH 9:3"/>Nnipa a wɔfiri Yuda, Benyamin, Efraim ne Manase mmusuakuo mu ba bɛtenaa Yerusalem no yɛ:<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>Amihud babarima Utai a ɔyɛ Omri babarima na ɔno nso yɛ Imri babarima na ɔno nso yɛ Bani babarima a wɔyɛ Yuda babarima Peres asefoɔ.<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>Wɔn a wɔfiri Silonfoɔ abusua mu no yɛ:</para>
  <para style="li2" vid="1CH 9:5">Asaia a ɔyɛ abakan no ne ne mmammarima.<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>Serah abusua mu no:</para>
  <para style="li2" vid="1CH 9:6">Yeuel ne nʼabusuafoɔ na wɔsane baeɛ.</para>
  <para style="li4" vid="1CH 9:6">Yuda abusuakuo no mu mmusua ahansia aduɔkron (690) na wɔsane baeɛ.<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="7" style="v" sid="1CH 9:7"/>Wɔn a wɔfiri Benyamin abusuakuo mu a wɔsane baeɛ no ne:</para>
  <para style="li1" vid="1CH 9:7">Mesulam babarima Salu, a ɔyɛ Hodawia babarima na ɔno nso yɛ Hasenua babarima;<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>Yibneia a ɔyɛ Yeroham babarima; Ela a ɔyɛ Usi babarima, Mikri babarima; Mesulam a ɔyɛ Sefatia babarima, Reuel babarima, Yibnia babarima baeɛ.<verse eid="1CH 9:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 9:9"/>Saa mmarima yi nyinaa, na wɔyɛ mmusua ntuanofoɔ, na wɔatwerɛ wɔn din wɔ wɔn mmusuakuo mmusuadua nwoma mu. Benyamin abusuakuo mu mmusua aha nkron ne aduonum nsia na wɔsane baeɛ.<verse eid="1CH 9:9"/></para>
  <para style="s1">Asɔfoɔ A Wɔsane Baeɛ</para>
  <para style="li4">
    <verse number="10" style="v" sid="1CH 9:10"/>Asɔfoɔ a wɔsane baeɛ no bi ne:</para>
  <para style="li1" vid="1CH 9:10">Yedaia, Yehoriarib, Yakin;<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>Asaria a ɔyɛ Hilkia babarima, a ɔno nso yɛ Mesulam babarima, na ɔno nso yɛ Sadok babarima, na ɔno nso yɛ Meraiot babarima, na ɔno nso yɛ Ahitub babarima. Na Asaria yɛ Onyankopɔn fie ahwɛfoɔ so panin.<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>Asɔfoɔ a wɔsane baeɛ no bi ne Adaia a ɔyɛ Yeroham babarima, a na ɔno nso yɛ Pashur babarima, na ɔno nso yɛ Malkia babarima ne Masai a ɔyɛ Adiel babarima, na ɔno nso yɛ Yahsera babarima, na ɔno nso yɛ Mesulam babarima, a ɔno nso yɛ Mesilemit babarima, na ɔno nso yɛ Imer babarima.<verse eid="1CH 9:12"/></para>
  <para style="li4">
    <verse number="13" style="v" sid="1CH 9:13"/>Asɔfoɔ a wɔsane baeɛ nyinaa dodoɔ yɛ apem ahanson aduosia. Na wɔyɛ mmusua ntuanofoɔ a wɔyɛ nsiyɛfoɔ. Na wɔn adwuma ne sɛ, wɔsom wɔ Onyankopɔn fie.<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="14" style="v" sid="1CH 9:14"/>Lewifoɔ a wɔsane baeɛ no yɛ:</para>
  <para style="li1" vid="1CH 9:14">Semaia a ɔyɛ Hasub babarima, a na ɔyɛ Asrikam babarima, a na ɔno nso yɛ Hasabia babarima, a na ɔyɛ Merari aseni;<verse eid="1CH 9:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15"/>Bakbakar; Heres; Galal; Mika babarima Matania a ɔyɛ Sikri babarima, na ɔno nso yɛ Asaf babarima,<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>Obadia a ɔyɛ Semaia babarima, a ɔyɛ Galal babarima, na ɔno nso yɛ Yedutun babarima, ne Asa a ɔyɛ Elkana babarima Berekia a wɔtenaa Netofa asase so.<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="17" style="v" sid="1CH 9:17"/>Apono anohwɛfoɔ a wɔsane baeɛ no yɛ:</para>
  <para style="li1" vid="1CH 9:17">Salum, Akub, Talmon, Ahiman ne wɔn mmusuafoɔ. Salum na na ɔyɛ ɔpono ano hwɛfoɔ panin. <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>Kane no nso, na anka wɔn na wɔhwɛ ɔhene ɛpono a ɛkyerɛ apueeɛ fam no so. Na saa mmarima no som sɛ Lewifoɔ atenaeɛ apono ano ahwɛfoɔ.<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>Na Salum yɛ Kore babarima a ɔyɛ Ebiasaf a ɔfiri Kora abusua mu aseni. Na ɔne nʼabusuafoɔ a wɔyɛ Korafoɔ no na na wɔwɛn ɛkwan a ɛkɔ kronkronbea hɔ no, sɛdeɛ na wɔn mpanimfoɔ wɛnee Ahyiaeɛ Ntomadan wɔ <char style="nd">Awurade</char> atenaeɛ hɔ no.<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>Eleasa babarima Pinehas na kane no na ɔhwɛ apono ano ahwɛfoɔ no so, na <char style="nd">Awurade</char> ka ne ho.<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>Akyire no, Meselemia babarima Sakaria na na ɔwɛn ɛkwan a ɛkɔ Ahyiaeɛ Ntomadan no mu no ano.<verse eid="1CH 9:21"/></para>
  <para style="li4">
    <verse number="22" style="v" sid="1CH 9:22"/>Ne nyinaa mu, saa ɛberɛ no, na apono ano ahwɛfoɔ no dodoɔ yɛ ahanu ne dumienu (212) a na wɔatwerɛ wɔn din wɔ wɔn mmusuadua nkrataa mu wɔ wɔn nkuraaseɛ.</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">Dawid ne Samuel a na ɔyɛ ɔdehunufoɔ no yiyii wɔn agyanom, ɛfiri sɛ na wɔyɛ nokwafoɔ. <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>Saa apono ano ahwɛfoɔ yi ne wɔn asefoɔ no, na wɔkyekyɛ wɔn mu kɔwɛn ɛkwan a ɛkɔ <char style="nd">Awurade</char> efie, a kane no na ɛyɛ ntomadan no ano. <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>Wɔde apono ano ahwɛfoɔ no gyinagyinaa afanan no nyinaa a ɛyɛ apueeɛ, atɔeɛ, atifi ne anafoɔ. <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>Ɛberɛ-ano-berɛ-ano, na wɔn abusuafoɔ a wɔwɔ nkuraaseɛ no bɛboa wɔn wɔ wɔn nnanson nnanson dwumadie mu. <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>Saa apono ano ahwɛfoɔ mpanimfoɔ baanan a na wɔyɛ Lewifoɔ no, na wɔn adwuma no yɛ deɛ ɛkura asodie kɛseɛ, ɛfiri sɛ, wɔn na na wɔhwɛ adan ne sikakoradan a ɛwɔ Onyankopɔn fie hɔ no so. <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>Wɔwɛn Onyankopɔn fie hɔ anadwo, ɛfiri sɛ, na ɛyɛ wɔn asɛdeɛ. Afei, na ɛyɛ wɔn adwuma sɛ da biara anɔpa wɔbuebue apono no.<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>Na apono ano ahwɛfoɔ no bi adwuma ne sɛ wɔhwɛ nneɛma ahodoɔ a wɔde yɛ ɔsom adwuma no so. Sɛ wɔrekɔfa, na wɔresane de akɔgu hɔ no nyinaa a, wɔhwɛ sɛ ebi nnyera. <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>Afoforɔ nso hwɛ nneɛma a wɔde asiesie hɔ, nneɛma a ɛwɔ kronkronbea hɔ, nneɛma a wɔde brɛ wɔn, sɛ ebia, asikyiresiam a wɔayam no muhumuhu, nsã, ngo, nnuhwam ne kurobo ahodoɔ so. <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>Nanso, na asɔfoɔ no na wɔdi nnuhwam no ne kurobo no ho dwuma. <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>Matitia a ɔyɛ Lewini, na ɔyɛ Korani Salum abakan no na na ɔto burodo a wɔde bɔ afɔdeɛ no. <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>Na nnipa bi a wɔfiri Kohat abusua mu nso na na wɔhwɛ, siesie burodo a wɔde to ɛpono Homeda no.<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>Nnwom ho nimdefoɔ a na wɔn nso yɛ Lewifoɔ atitire no nyinaa, na wɔtete Asɔredan no mu. Na wɔmma wɔnnyɛ adwuma foforɔ biara, ɛsiane wɔn adwuma a wɔyɛ no mmerɛ nyinaa enti.<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>Na saa nnipa yi nyinaa tete Yerusalem. Na wɔyɛ Lewifoɔ mmusua no nyinaa ntuanofoɔ a wɔatwerɛ wɔn din ahyɛ wɔn mmusuadua krataa mu.<verse eid="1CH 9:34"/></para>
  <para style="s1">Ɔhene Saulo Abusuadua</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>Yeiel (Gibeon agya) tenaa Gibeon.</para>
  <para style="li2" vid="1CH 9:35">Na ne yere din de Maaka, <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>a na ne babarima piesie din de Abdon. Na Yeiel mmammarima a wɔaka no din de Sur, Kis, Baal, Ner, Nadab, <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>Gedor, Ahio, Sakaria ne Miklot. <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>Miklot na ɔyɛ Simeam agya. Na saa mmusuafoɔ yi tete bemmɛn wɔn ho wɔn ho wɔ Yerusalem.<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>Ner na ɔwoo Kis. Kis na ɔwoo Saulo, Saulo na ɔwoo Yonatan, Malki-Sua, Abinadab ne Esbaal.<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>Yonatan babarima ne:</para>
  <para style="li2" vid="1CH 9:40">Merib-Baal (anaa Mefiboset) na Merib-Baal woo Mika.<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>Mika mmammarima ne:</para>
  <para style="li2" vid="1CH 9:41">Piton, Melek, Tarea ne Ahas.<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>Ahas woo Yara.</para>
  <para style="li2" vid="1CH 9:42">Yara woo Alemet, Asmawet ne Simri.</para>
  <para style="li2" vid="1CH 9:42">Na Simri woo Mosa. <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>Mosa woo Binea.</para>
  <para style="li1" vid="1CH 9:43">Binea woo Refaia.</para>
  <para style="li1" vid="1CH 9:43">Refaia woo Elasa.</para>
  <para style="li1" vid="1CH 9:43">Elasa woo Asel.<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>Asel woo mmammarima baasia a wɔne:</para>
  <para style="li2" vid="1CH 9:44">Asrikam, Bokeru, Ismael, Searia, Obadia ne Hanan. Na yeinom yɛ Asel mma.<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">Ɔhene Saulo Owuo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>Afei, Filistifoɔ no bɛto hyɛɛ Israel so, ma Israelfoɔ no dwaneeɛ. Wɔkunkumm wɔn mu pii wɔ bepɔ Gilboa so. <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>Filistifoɔ no kaa Saulo ne ne mmammarima hyɛeɛ. Wɔkunkumm wɔn mu baasa a wɔn ne Yonatan, Abinadab ne Malki-Sua. <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>Ɔko no ano yɛɛ den wɔ Saulo ho hyiaaɛ, ma Filistifoɔ agyantofoɔ no nyaa Saulo piraa no yie.<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>Saulo firi apenesie mu ka kyerɛɛ nʼakodeɛkurafoɔ no sɛ, “Twe wʼakofena, na fa wɔ me kum me na Filistifoɔ abosonsomfoɔ yi ammɛto me, angu mʼanim ase.”</para>
  <para style="p" vid="1CH 10:4">Nanso, na nʼakodeɛkurafoɔ no suro enti, wanyɛ saa. Enti, Saulo twee ɔno ara nʼakofena, de kumm ne ho. <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>Ɛberɛ a nʼakodeɛkurafoɔ no hunuu sɛ Saulo awuo no, ɔno nso de nʼakofena kumm ne ho. <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>Ɛno enti, Saulo ne ne mmammarima baasa no wuwuu wɔ hɔ ara, ma nʼahennie nnidisoɔ no baa awieeɛ.<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>Ɛberɛ a Israelfoɔ a wɔwɔ Yesreel bɔnhwa no mu no hunuu sɛ wɔadi wɔn akodɔm no so, na Saulo ne ne mmammarima baasa no awuwu no, wɔdwane gyaa wɔn nkuro hɔ. Ɛno enti, Filistifoɔ no kɔfaa wɔn nkuro no.<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>Adeɛ kyeeɛ a Filistifoɔ no kɔɔ sɛ wɔrekɔyiyi atɔfoɔ no ho nneɛma no, wɔhunuu sɛ Saulo ne ne mmammarima no amu gugu bepɔ Gilboa so. <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>Enti, wɔyiyii Saulo akodeɛ firii ne ho, twaa ne ti. Afei wɔbɔɔ Saulo wuo no ho dawuro, maa wɔn ahoni ne nnipa a wɔwɔ Filistia nyinaa teeɛ. <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>Wɔde nʼakodeɛ no guu wɔn anyame no abosonnan mu, na wɔkyekyeree ne ti no fam Dagon asɔredan no ɔfasuo ho.<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>Nanso, Yabes Gileadfoɔ tee deɛ Filistifoɔ ayɛ Saulo no, <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>wɔn akofoɔ kɔfaa Saulo ne ne mmammarima baasa no amu baa Yabes. Na wɔsiee wɔn amu wɔ odum dua bi a ɛwɔ Yabes ase, na wɔdii mmuada nnanson.<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>Na Saulo wuiɛ, ɛfiri sɛ, wanni Awurade nokorɛ. Wanni <char style="nd">Awurade</char> ahyɛdeɛ so, na mpo, ɔkɔɔ asamanfrɛ, <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>wɔ ɛberɛ a anka ɛsɛ sɛ ɔbisa akwankyerɛ firi <char style="nd">Awurade</char> hɔ. Ɛno enti, <char style="nd">Awurade</char> kumm no, de nʼahennie hyɛɛ Yisai babarima Dawid nsa.<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">Dawid Di Israel Nyinaa So Ɔhene</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>Na Israel nyinaa kɔɔ Dawid nkyɛn wɔ Hebron kɔka kyerɛɛ no sɛ, “Yɛn nyinaa yɛ wʼabusuafoɔ. <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>Mmerɛ tenten bi a atwam, mpo ɛberɛ a Saulo di yɛn so ɔhene no, na wone obi a nokorɛm na wodi Israel anim. Na <char style="nd">Awurade</char>, wo Onyankopɔn, aka kyerɛ wo sɛ, ‘Wobɛyɛ odwanhwɛfoɔ ama me nkurɔfoɔ Israel. Wobɛyɛ wɔn sodifoɔ.’ ”<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>Enti, Dawid ne Israel ntuanofoɔ no yɛɛ apam wɔ <char style="nd">Awurade</char> anim wɔ Hebron. Wɔsraa no ngo, sii no Israelhene sɛdeɛ <char style="nd">Awurade</char> nam Samuel so hyɛɛ ho bɔ no.<verse eid="1CH 11:3"/></para>
  <para style="s1">Dawid Ko Faa Yerusalem</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>Na Dawid ne Israel nyinaa kɔɔ Yerusalem anaa Yebus, sɛdeɛ na wɔfrɛ hɔ kane no, ɛfiri sɛ, Yebusifoɔ na wɔkɔtenaa asase no so kane kyekyereeɛ. <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>Nnipa a wɔfiri Yebus no ka kyerɛɛ Dawid sɛ, “Worentumi mma ha da biara da.” Nanso, Dawid faa aban a na ɛwɔ Sion a wɔfrɛ no Dawid Kuro no.<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>Dawid ka kyerɛɛ nʼakodɔm no sɛ, “Mo mu biara a ɔbɛdi anim na yɛakɔto ahyɛ Yebusifoɔ no so no, ɔno na ɔbɛyɛ mʼakodɔm so sahene.” Na Dawid nuabaa Seruia babarima Yoab dii ntohyɛsoɔ no anim, enti ɔbɛyɛɛ Dawid akodɔm so sahene.<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>Dawid tenaa aban no mu, na ɛno enti na wɔfrɛɛ hɔ Dawid kuro no. <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>Dawid kyekyeree kuro no, trɛɛ mu firi Milo de twaa ho hyiaeɛ, ɛberɛ a na Yoab nso rekyekyere Yerusalem nkaeɛ no. <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>Na Dawid tumi yɛɛ kɛseɛ, ɛfiri sɛ, na Asafo <char style="nd">Awurade</char> ka ne ho.<verse eid="1CH 11:9"/></para>
  <para style="s1">Dawid Nnɔmmarima</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>Yeinom ne Dawid nnɔmmarima ntuanofoɔ. Wɔne Israel nyinaa boom, sii gyinaeɛ sɛ wɔde Dawid bɛyɛ wɔn so ɔhene sɛdeɛ <char style="nd">Awurade</char> ahyɛ bɔ afa Israel ho no. <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>Dawid nnɔmmarima no ho nsɛm nie: Deɛ ɔdi ɛkan no ne Yasobeam, a ɔyɛ Hakmonini a na ɔda Baasa no ano sɛ ɔsahene—Baasa no yɛ nnɔmmarima akatakyie a na wɔwɔ Dawid asraafoɔ mu. Ɛberɛ bi, ɔde ne pea kunkumm atamfoɔ ahasa wɔ akodie baako mu.<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>Deɛ ɔtɔ so mmienu wɔ Baasa no mu no yɛ Dodo babarima Eleasa a ɔyɛ Ahoa aseni. <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>Ɛberɛ a Dawid sɔre tiaa Filistifoɔ wɔ Pas-Damim no, na ɔka ne ho. Ɔko no sii wɔ baabi a na ɛyɛ atokofuo nko, na Israel asraafoɔ no dwaneeɛ. <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>Nanso, Eleasa ne Dawid gyinaa wɔn nan so wɔ afuo no mfimfini, bɔɔ Filistifoɔ guiɛ. Na <char style="nd">Awurade</char> maa wɔdii nkonim de gyee wɔn.<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>Ɛda bi a Dawid wɔ ɔbotan bi a ɛbɛn Adulam ɔbodan ho no, na Filistifoɔ asraadɔm akyere sraban wɔ Refaim bɔnhwa mu. Baasa no a na wɔka Aduasa no a wɔagye edin wɔ Dawid akodɔm mu no siane kɔhyiaa no wɔ hɔ. <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>Saa ɛberɛ no, na Dawid te abanbɔeɛ mu hɔ a na Filistifoɔ akodɔm kuo bi akɔtena Betlehem. <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>Dawid firi akɔnnɔ mu kaeɛ sɛ, “Ao me kɔn dɔ nsu pa a ɛwɔ abura a ɛwɔ Betlehem no bi; deɛ ɛbɛn ɛpono ano no bi.” <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>Enti, Baasa no bɔ wuraa Filistifoɔ no mu, kɔsaa abura no mu nsuo no bi de brɛɛ Dawid. Nanso, Dawid annom. Mmom, ɔhwie guu <char style="nd">Awurade</char> anim <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>teaam sɛ, “Ɛmpare me sɛ mɛnom saa nsuo yi. Ɛsom bo te sɛ saa mmarima yi a wɔde wɔn ho bɔɔ afɔdeɛ kɔsa brɛɛ me no mogya.” Enti, Dawid annom. Yei yɛ Baasa no mmaninsɛm no bi nhwɛsoɔ.<verse eid="1CH 11:19"/></para>
  <para style="s1">Dawid Nnɔmmarima Aduasa No</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>Yoab nuabarima Abisai na na ɔtua Aduasa no ano. Ɔno na ɔde ne pea kunkumm atamfoɔ no mu ahasa. Saa mmaninsɛm yi enti na ɔgyee edin te sɛ Baasa no. <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>Abisai na na ne din ahyeta yie wɔ Aduasa no mu sɛ wɔn sahene, nanso na ɔnka Baasa no ho.<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>Na Yehoiada babarima Benaia a ɔfiri Kabseel no nso wɔ hɔ. Na ɔno nso di mmaninsɛm. Ɔyɛɛ bebree a emu baako ne sɛ ɔkunkumm Moab akofoɔ akɛseɛ baanu bi. Ɛberɛ foforɔ bi nso, ɔtaa gyata maa aboa no kɔtɔɔ amena mu. Na sukyerɛmma ama fam ayɛ toro, nanso, ɔkyeree gyata no kumm no. <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>Ɛda bi a na ɔkura aporibaa nko ara no, ɔkumm Misraimni ɔkofoɔ bi a na ne tenten yɛ anammɔn nson ne fa. Na ne pea no mu pipiripie te sɛ ntomanwomfoɔ nsadua. Benaia hwam pea no firii Misraimni no nsam, de kumm no. <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>Yeinom ne mmaninsɛm a ɛmaa Yehoiada babarima Benaia gyee edin te sɛ Baasa no. <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>Wɔhyɛɛ no animuonyam sene nkaeɛ a wɔka Aduasa no ho no, nanso na ɔmfra Baasa no mu. Na Dawid yɛɛ no ne ho awɛmfoɔ no so sahene.<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="26" style="v" sid="1CH 11:26"/>Nnipa a na wɔka Dawid nnɔmmarima no ho nie:</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">Yoab nuabarima Asahel;</para>
  <para style="li1" vid="1CH 11:26">Dodo babarima Elhanan a ɔfiri Betlehem;<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>Samot a ɔfiri Harori;</para>
  <para style="li1" vid="1CH 11:27">Heles a ɔfiri Pelon;<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>Ikes babarima Ira a ɔfiri Tekoa;</para>
  <para style="li1" vid="1CH 11:28">Abieser a ɔfiri Anatot;<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>Sibekai a ɔfiri Husa;</para>
  <para style="li1" vid="1CH 11:29">Salmon a ɔfiri Ahoa;<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>Maharai a ɔfiri Netofa;</para>
  <para style="li1" vid="1CH 11:30">Baana a ɔfiri Netofa babarima Heled;<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>Ribai a ɔfiri Gibea babarima Itai (wɔfiri Benyamin abusuakuo mu); Benaia a ɔfiri Piraton;<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>Hurai a ɔfiri baabi a ɛbɛn Nahale-Gaas;</para>
  <para style="li1" vid="1CH 11:32">Abiel a ɔfiri Araba.<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>Asmawet a ɔfiri Baharum;</para>
  <para style="li1" vid="1CH 11:33">Eliahba a ɔfiri Saalbon.<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>Hasem mmammarima a wɔfiri Gison;</para>
  <para style="li1" vid="1CH 11:34">Sage babarima Yonatan a ɔfiri Harar.<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>Sakar babarima Ahiam a ɔfiri Harar;</para>
  <para style="li1" vid="1CH 11:35">Ur babarima Elifar.<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>Hefer a ɔfiri Mekera;</para>
  <para style="li1" vid="1CH 11:36">Ahiya a ɔfiri Pelon.<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>Hesro a ɔfiri Karmel;</para>
  <para style="li1" vid="1CH 11:37">Esbai babarima Naarai.<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>Natan nuabarima Yoɛl;</para>
  <para style="li1" vid="1CH 11:38">Hagri babarima Mibhar.<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>Selek a ɔfiri Amon;</para>
  <para style="li1" vid="1CH 11:39">Naharai a ɔfiri Beerot (a na ɔyɛ Yoab akodeɛkurafoɔ);<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>Ira a ɔfiri Yitri;</para>
  <para style="li1" vid="1CH 11:40">Gareb a ɔfiri Yitri;<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>Hetini Uria;</para>
  <para style="li1" vid="1CH 11:41">Ahlai babarima Sabad;<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>Sisa babarima Adina a na ɔda Rubenfoɔ ano, a na mmarima aduasa ka ne ho;<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>Maaka babarima Hanan;</para>
  <para style="li1" vid="1CH 11:43">Yosafat a ɔfiri Mitna;<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>Usia a ɔfiri Astera;</para>
  <para style="li1" vid="1CH 11:44">Hotam a ɔfiri Aroer mmammarima Sama ne Yeiel;<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>Simri babarima Yediael;</para>
  <para style="li1" vid="1CH 11:45">Yoha ne nuabarima a ɔfiri Tis;<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>Eliel a ɔfiri Mahawi;</para>
  <para style="li1" vid="1CH 11:46">Elnaam mmammarima Yeribai ne Yosawia;</para>
  <para style="li1" vid="1CH 11:46">Yitma a ɔfiri Moab;<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>Eliel ne Obed;</para>
  <para style="li1" vid="1CH 11:47">Yaasiel a ɔfiri Soba.<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">Nnɔmmarima Kɔka Dawid Akodɔm Ho</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 12:1"/>Ɛberɛ a Dawid dwane firii Kis babarima Saulo anim kɔhintaa wɔ Siklag no, saa mmarima yi kɔdɔmm no. Na wɔka nnɔmmarima a wɔboa Dawid wɔ akodie mu. <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>Na wɔn nyinaa yɛ agyantofoɔ toamfomfoɔ. Na wɔtumi de wɔn nsa benkum ne nifa nyinaa to agyan ne ahwimmoɔ. Na wɔn nyinaa yɛ Saulo abusuafoɔ a wɔfiri Benyamin abusuakuo mu.<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>Na deɛ ɔtua wɔn ano yɛ Semaa a ɔfiri Gibea no babarima Ahieser. Na ne nuabarima ne Yoas a ɔyɛ nʼabadiakyire. Yeinom ne nnɔmmarima no nkaeɛ:</para>
  <para style="li1" vid="1CH 12:3">Asmawet mmammarima Yesiel ne Pelet;</para>
  <para style="li1" vid="1CH 12:3">Beraka ne Yehu a wɔfiri Anatot; <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>Ismaia a ɔfiri Gibeon, ɔkofoɔ kɛseɛ ne ntuanoni wɔ Aduasa no mu;</para>
  <para style="li1" vid="1CH 12:4">Yeremia, Yahasiel, Yohanan ne Yosabad a wɔfiri Gedera; <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>Elusai, Yerimot, Bealia, Semaria, ne Sefatia a ɔfiri Harif;<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>Elkana, Yesia, Asarel, Yoeser, Yasobeam a wɔyɛ Korafoɔ;<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>Yoela, Sebadia, Yeroham mmammarima a wɔfiri Gedor.<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>Gadfoɔ akofoɔ akokoɔdurufoɔ bi a wɔakwadare akodie mu dwane kɔɔ Dawid afa ɛberɛ a na ɔwɔ abanbɔeɛ mu wɔ ɛserɛ no so. Na wɔyɛ anintini wɔ nkataboɔ ne pea akodie mu a wɔn ho yɛ hu sɛ gyata, na wɔn ho yɛ hare te sɛ mmepɔ so atwe.<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>Eser na na ɔtua wɔn ano.</para>
  <para style="li1" vid="1CH 12:9">Obadia yɛ abadiakyire.</para>
  <para style="li1" vid="1CH 12:9">Eliab na ɔtɔ so mmiɛnsa.<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>Deɛ ɔtɔ so ɛnan ne Mismana.</para>
  <para style="li1" vid="1CH 12:10">Deɛ ɔtɔ so enum ne Yeremia.<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>Atai tɔ so nsia, Eliel tɔ so nson.<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>Yohanan tɔ so nwɔtwe, Elsabad tɔ so nkron.<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>Yeremia tɔ so edu, Makbanai tɔ so dubaako.<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>Saa nnɔmmarima a wɔfiri Gad yi yɛ asahene. Deɛ ɔnyɛ den koraa no, ɔtumi ne asraafoɔ ɔha ko, ɛnna deɛ ɔyɛ den no tumi ne asraafoɔ apem ko. <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>Afe no ahyɛaseɛ a Asubɔnten Yordan ayiri no, wɔtwa kɔpamoo nnipa a wɔtete tata so wɔ nʼapueeɛ ne nʼatɔeɛ nkonkɔn so nyinaa firii hɔ.<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>Afoforɔ a wɔfiri Benyamin ne Yuda no baa Dawid nkyɛn wɔ abanbɔeɛ hɔ. <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>Dawid kɔhyiaa wɔn kaa sɛ, “Sɛ moaba asomdwoeɛ so sɛ morebɛboa me a, yɛyɛ nnamfo. Na sɛ moaba sɛ morebɛyi me ama mʼatamfoɔ wɔ ɛberɛ a menyɛɛ bɔne bi a, yɛn agyanom Onyankopɔn nhwɛ mmu mo atɛn.”<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>Na honhom no sii Amasai a akyire no ɔbɛyɛɛ Aduasa no so panin no so, na ɔkaa sɛ,</para>
  <para style="q1" vid="1CH 12:18">“Yɛyɛ wo dea, Dawid!</para>
  <para style="q2" vid="1CH 12:18">Yɛwɔ wʼafa, Yisai ba;</para>
  <para style="q1" vid="1CH 12:18">Asomdwoeɛ ne nkɔsoɔ nyɛ wo kyɛfa</para>
  <para style="q2" vid="1CH 12:18">na wʼaboafoɔ nyinaa nnya nkɔsoɔ,</para>
  <para style="q3" vid="1CH 12:18">ɛfiri sɛ, wo Onyankopɔn ne deɛ ɔboa wo.”</para>
  <para style="p" vid="1CH 12:18">Enti, Dawid maa wɔbɛkaa ne ho, na ɔyɛɛ wɔn mpanimfoɔ wɔ nʼakodɔm mu.<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>Manase mmarima no bi tee wɔn ho kɔdɔmm Dawid wɔ ɛberɛ a na ɔne Filistifoɔ no rekɔko atia Saulo no. Nanso, asɛm no ani daneeɛ a Filistifoɔ ntuanofoɔ ampene so sɛ Dawid ne ne mmarima no bɛka wɔn ho akɔ. Wɔdwendwenee ho ara no, wɔmaa wɔsanee wɔn akyi kaa sɛ, “Sɛ Dawid dane nʼani kɔ Saulo afa de tia yɛn a, yɛn nkwa na yɛde bɛtwa so.” <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>Manase mmarima a wɔwae kɔɔ Dawid afa wɔ ɛberɛ a na ɔresane akɔ Siklag no ne Adna, Yosabad, Yediael, Mikael, Yosabad, Elihu ne Siletai. Na wɔn mu biara da akodɔm apem ano. <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>Wɔboaa Dawid maa ɔtaa afomfafoɔ no, ɛfiri sɛ, na wɔyɛ akokoɔdurufoɔ ne akofoɔ akɛseɛ a wɔbɛyɛɛ asahene wɔ nʼakodɔm mu. <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>Adekyeeɛ biara, mmarima bebree kɔdɔm Dawid kɔsii sɛ ɔnyaa asraadɔm a ɛso te sɛ Onyankopɔn deɛ.<verse eid="1CH 12:22"/></para>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 12:23"/>Yeinom ne akofoɔ akɛseɛ dodoɔ a wɔdɔm Dawid wɔ Hebron no. Na wɔn nyinaa pɛ sɛ Dawid si Saulo anan mu di ɔhene, sɛdeɛ <char style="nd">Awurade</char> ahyɛ ato hɔ no.<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>Akofoɔ akɛseɛ a wɔfiri Yuda abusuakuo mu no, na wɔn dodoɔ yɛ mpem nsia ne aha nwɔtwe a wɔkurakura nkataboɔ ne mpea.<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>Akofoɔ akɛseɛ a wɔfiri Simeon abusuakuo mu no, na wɔn dodoɔ yɛ mpem nson ne ɔha.<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>Akodɔm a na wɔfiri Lewi abusuakuo mu no, na wɔn dodoɔ yɛ mpem ɛnan ne ahansia (4,600). <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>Na Yehoiada a ɔtua Aaron abusua no ano no wɔ akodɔm mpem mmiɛnsa ne ahanson (3,700) a wɔhyɛ nʼase. <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>Saa ara nso na na Sadok, ɔbabunu ɔkofoɔ kɛseɛ ne nʼabusuafoɔ aduonu mmienu a wɔn nyinaa yɛ asraafoɔ mpanimfoɔ ka ho.<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>Akofoɔ akɛseɛ a wɔfiri Benyamin abusuakuo mu a wɔyɛ Saulo abusuafoɔ no, na wɔn dodoɔ yɛ mpem mmiɛnsa (3,000). Na Benyaminfoɔ no mu fa kɛseɛ no taa Saulo akyi ara.<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>Akofoɔ akɛseɛ a wɔfiri Efraim abusuakuo mu no, na wɔn dodoɔ yɛ mpem aduonu ne aha nwɔtwe (20,800) a wɔn mu biara agye edin wɔ nʼabusua mu.<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>Manase abusuakuo fa a na ɛwɔ Yordan atɔeɛ fam no nso, wɔtuu mmarima mpem dunwɔtwe (18,000) a wɔn botaeɛ ara ne sɛ wɔbɛboaa Dawid ma wadi ɔhene.<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>Ntuanofoɔ a wɔfiri Isakar abusuakuo mu ne wɔn abusuafoɔ dodoɔ yɛ ahanu. Na saa mmarima yi nyinaa te nsɛm a ɛrekɔ so saa ɛberɛ no ase, na wɔnim ɛkwan pa a ɛyɛ ma Israel nso.<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>Akofoɔ a wɔakwadare akodie mu a wɔfiri Sebulon abusuakuo mu no, na wɔn dodoɔ yɛ mpem aduonum (50,000). Na wɔakɔ amia mu ayɛ krado ama akodie, na na wɔtaa Dawid akyi pintinn.<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>Wɔn a wɔfiri Naftali abusuakuo mu no yɛ asraafoɔ mpanimfoɔ apem (1,000) ne akofoɔ akɛseɛ mpem aduasa nson (37,000) a wɔkurakura nkataboɔ ne mpea.<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>Akofoɔ a wɔfiri Dan abusuakuo mu no, na wɔn dodoɔ yɛ mpem aduonu nwɔtwe ne ahansia (28,600) a wɔasiesie wɔn ho ama ɔko.<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>Akofoɔ akɛseɛ a wɔatete wɔn yie a wɔfiri Aser abusuakuo mu no, na wɔn dodoɔ yɛ mpem aduanan (40,000) a wɔn nyinaa ayɛ krado ama ɔko.<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>Ruben, Gad mmusuakuo ne Manase abusuakuo fa a na wɔtete Asubɔnten Yordan apueeɛ fam no maa asraadɔm mpem ɔha ne aduonu (120,000) a wɔwɔ akodeɛ ahodoɔ nyinaa.<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 12:38"/>Saa asraafoɔ yi nyinaa kɔɔ amia mu na wɔkɔɔ Hebron a wɔn botaeɛ ara ne sɛ wɔde Dawid bɛyɛ Israelhene.</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">Nokorɛm, Israel nyinaa adwene kɔɔ bɛnkorɔ mu sɛ, ɛsɛ sɛ Dawid na ɔyɛ wɔn ɔhene. <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>Wɔne Dawid didiiɛ, nomeeɛ nnansa, ɛfiri sɛ, na wɔn abusuafoɔ no ayɛ ahoboa rehwɛ wɔn ɛkwan. <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>Nnipa bi a wɔfiri akyiri te sɛ Isakar, Sebulon, ne Naftali de nnuane tenaa wɔn mfunumu, nyoma ne anantwie so baeɛ. Wɔde asikyiresiam, ɔfam, ɛhyɛ, nsã, ngo, anantwie ne nnwan bebree baa afahyɛ no ase. Anigyeɛ a ɛnni kabea baa Israel asase so.<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">Dawid Pɛ Sɛ Ɔkɔfa Apam Adaka No</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>Dawid ne ne mpanimfoɔ a nʼasraafoɔ asahene ne mmapɔmma nyinaa ka ho, tuu agyina. <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>Na ɔkasa kyerɛɛ Israelfoɔ a wɔahyia hɔ no nyinaa sɛ, “Sɛ mopene so na sɛ ɛyɛ <char style="nd">Awurade</char> yɛn Onyankopɔn pɛ a, momma yɛnto nkra nkɔma Israelfoɔ a wɔwɔ ɔman no afanan nyinaa a asɔfoɔ ne Lewifoɔ a wɔwɔ nkuro so ne adidibea ka ho. Momma yɛnto nsa mfrɛ wɔn, na wɔmmɛka yɛn ho. <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>Ɛberɛ aduru sɛ yɛsane de yɛn Onyankopɔn Apam Adaka no ba, ɛfiri sɛ, Saulo ahennie ɛberɛ so no, yɛampɛ anhwɛ.” <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>Badwa no penee saa asɛm yi so ɛfiri sɛ, wɔhunuu sɛ, wɔyɛ saa a, ɛyɛ.<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>Enti, Dawid frɛɛ nnipa a wɔwɔ Israel nyinaa, ɛfiri ɔman no tire kɔsi tire, sɛ wɔmmɛka ne ho na wɔmfa Onyankopɔn Apam Adaka no mfiri Kiriat-Yearim mmra. <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>Afei, Dawid ne Israelfoɔ no nyinaa kɔɔ Baala a na wɔfrɛ no Kiriat-Yearim a ɛwɔ Yuda no sɛ wɔrekɔfa Onyankopɔn Apam Adaka a wɔde ahyɛ Kerubim ntam na <char style="nd">Awurade</char> din da so no aba.<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>Wɔde Onyankopɔn Apam Adaka no sii teaseɛnam foforɔ so de firii Abinadab fie a Usa ne Ahio rekyerɛ ɛkwan. <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>Dawid ne Israelfoɔ nyinaa firii wɔn ahoɔden mu too nnwom, bɔɔ mmɛn ahodoɔ a ebi yɛ asankuo, mmɛnta, mpintin, nnawuro ne ntotorobɛnto dii ahurisie wɔ Onyankopɔn anim.<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>Nanso wɔduruu Nakon ayuporobea no, anantwie no anan totoeɛ maa Usa tenee ne nsa sɛ ɔretene Apam Adaka no. <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>Ɛhɔ na <char style="nd">Awurade</char> abufuo sɔre tiaa Usa maa ɔwuiɛ ɛfiri sɛ, ɔde ne nsa aka Apam Adaka no. Enti Usa wuu wɔ Onyankopɔn anim hɔ ara.<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>Dawid bo fuiɛ, ɛfiri sɛ <char style="nd">Awurade</char> abufuo atia Usa. Ɔtoo beaeɛ hɔ edin Peres-Usa a wɔda so frɛ hɔ saa de bɛsi ɛnnɛ.<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>Afei, na Dawid suro Onyankopɔn, na ɔbisaa sɛ, “Ɛbɛyɛ dɛn na matumi de Onyankopɔn Apam Adaka yi aba abɛhwɛ so?” <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>Enti, Dawid yɛɛ nʼadwene sɛ ɔnna mfa Apam Adaka no nkɔ Dawid kuro no mu. Mmom, ɔde kɔɔ Gatni, Obed-Edom fie wɔ Gat. <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>Onyankopɔn Apam Adaka no sii Obed-Edom abusuafoɔ nkyɛn abosome mmiɛnsa. Na <char style="nd">Awurade</char> hyiraa no ne ne fiefoɔ nyinaa.<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">Dawid Ahemfie Ne Nʼabusua</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>Afei, Tirohene Huram somaa abɔfoɔ ne aboɔ adansifoɔ ne nnua dwumfoɔ kɔɔ Dawid nkyɛn sɛ, wɔnkɔsi ahemfie mma no. Afei, Huram sane de ntweneduro nnua a wɔbɛpae kɔeɛ. <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>Na Dawid hunuu sɛ <char style="nd">Awurade</char> de no asi Israel so ɔhene, na ɛsiane Israel enti, wayɛ nʼahennie kɛseɛ.<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>Afei, Dawid waree mmaa bebree wɔ Yerusalem, na ɔwowoo mmammarima ne mmammaa bebree. <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>Dawid mmammarima a wɔwoo wɔn Yerusalem no ne Samua, Sobab, Natan ne Salomo, <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>Yibhar, Elisua, ne Elifelet, <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>Noga, Nefeg ne Yafia, <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>Elisama, Beeliada ne Elifelet.<verse eid="1CH 14:7"/></para>
  <para style="s1">Dawid Di Filistifoɔ So Nkonim</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>Ɛberɛ a Filistifoɔ tee sɛ wɔasra Dawid ngo ama wadi Israel nyinaa so ɔhene no, wɔboaboaa wɔn akodɔm nyinaa ano sɛ, wɔrebɛkye no. Na wɔka kyerɛɛ Dawid sɛ wɔreba ne so, enti ɔno nso ne ne mmarima firii kuro no mu kɔhyiaa wɔn. <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>Na Filistifoɔ no abɛduru Refaim bɔnhwa mu, asɛe hɔ pasaa. <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>Enti, Dawid bisaa Onyankopɔn sɛ, “Mempue na me ne Filistifoɔ no nkɔko? Wode wɔn bɛhyɛ me nsa anaa?”</para>
  <para style="p" vid="1CH 14:10">
    <char style="nd">Awurade</char> buaa sɛ, “Aane, wo ne wɔn nkɔko, na mɛma woadi wɔn so nkonim.”<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>Enti, Dawid ne nʼakodɔm kɔɔ Baal-Perasim kɔdii Filistifoɔ no so wɔ hɔ. Dawid teaam sɛ, “Onyankopɔn ayɛ! Ɔnam me so ama mabɔ awura mʼatamfoɔ mu te sɛ nsuyire a ano yɛ den.” Enti, wɔtoo beaeɛ hɔ edin Baal-Perasim (a asekyerɛ ne sɛ “Awurade a ɔbɔ wura mu”). <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>Filistifoɔ no gyaa wɔn ahoni nyinaa hɔ enti, Dawid hyɛ maa wɔhyee ne nyinaa.<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>Nanso, ankyɛre biara, Filistifoɔ no sane baa bɔnhwa no mu bɛsɛee hɔ. <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>Dawid bisaa Onyankopɔn deɛ ɔnyɛ bio. Onyankopɔn buaa sɛ, “Nkɔ tee nkɔto nhyɛ wɔn so. Mmom, fa wɔn ho kɔsi wɔn akyi na monto nhyɛ wɔn so wɔ baabi a ɛbɛn baka nnua no. <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>Na sɛ mote nnyegyeeɛ bi te sɛ nnipa bi a wɔrebɔ nsra nan ase wɔ baka nnua no atifi a, monto nhyɛ wɔn so. Ɛno na ɛbɛyɛ nsɛnkyerɛnneɛ a ɛkyerɛ sɛ, Onyankopɔn adi mo anim rekɔka Filistifoɔ no agu.” <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>Enti, Dawid yɛɛ deɛ Onyankopɔn hyɛɛ no sɛ ɔnyɛ no, na ɔkaa Filistifoɔ akodɔm no guiɛ firi Gibeon de kɔsii Geser.<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>Na Dawid edin hyetaa baabiara, na <char style="nd">Awurade</char> maa aman no nyinaa suroo Dawid.<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">Wɔde Apam Adaka No Ba Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>Afei, Dawid sisii adan bebree wɔ Dawid kurom. Bio, ɔsiesiee baabi, sii ntomadan wɔ hɔ a ɔde Onyankopɔn Apam Adaka no bɛsi. <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>Afei, ɔhyɛɛ sɛ, “Sɛ yɛma Onyankopɔn Apam Adaka no so de rekɔ a, obiara nni ho kwan sɛ ɔsoa bi agye Lewifoɔ no nko ara. <char style="nd">Awurade</char> ayi wɔn sɛ, wɔn nko ara na ɛsɛ sɛ wɔsoa <char style="nd">Awurade</char> Apam Adaka no na wɔsom wɔ nʼanim daa daa.”<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>Afei, Dawid frɛɛ Israelfoɔ nyinaa kɔɔ Yerusalem sɛ wɔmfa <char style="nd">Awurade</char> Apam Adaka no nkɔsi baabi a wɔasiesie ama no no.<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 15:4"/>Yeinom ne asɔfoɔ ne Lewifoɔ a wɔfrɛɛ wɔn no:<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>Wɔn a wɔfiri Kohat abusua mu no, na wɔn dodoɔ yɛ ɔha aduonu a Uriel yɛ wɔn ntuanoni.<verse eid="1CH 15:5"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>Wɔn a wɔfiri Merari abusua mu no, na wɔn dodoɔ yɛ ahanu aduonu (220), a Asaia da wɔn ano.<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>Wɔn a wɔfiri Gersom abusua mu no, na wɔn dodoɔ yɛ ɔha ne aduasa (130), a Yoɛl da wɔn ano.<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>Na Elisafan asefoɔ yɛ ahanu (200) a Semaia da wɔn ano.<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>Na Hebron asefoɔ yɛ aduɔwɔtwe (80) a Eliel yɛ wɔn ntuanoni.<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>Na Usiel asefoɔ yɛ ɔha ne dumienu (112) a Aminadab yɛ wɔn ntuanoni.<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>Afei, Dawid frɛɛ asɔfoɔ Sadok ne Abiatar ne saa Lewifoɔ mpanimfoɔ yi: Uriel, Asaia, Yoɛl, Semaia, Eliel ne Aminadab. <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>Ɔka kyerɛɛ wɔn sɛ, “Mo na moyɛ Lewifoɔ mmusua mu ntuanofoɔ. Mo ne Lewifoɔ a wɔka mo ho nyinaa nnwira mo ho, sɛdeɛ ɛbɛyɛ a, mobɛtumi de <char style="nd">Awurade</char>, Israel Onyankopɔn, Apam Adaka bɛba beaeɛ a masiesie ama no no. <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>Esiane sɛ, kane no, mo Lewifoɔ ansoa Apam Adaka no enti, <char style="nd">Awurade</char>, yɛn Onyankopɔn, abufuo sɔre tiaa yɛn. Yɛammisa Onyankopɔn ɛkwan pa a ɛsɛ sɛ yɛfa so soa.” <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>Enti, asɔfoɔ no ne Lewifoɔ no dwiraa wɔn ho, sɛdeɛ ɛbɛyɛ a wɔbɛtumi de <char style="nd">Awurade</char>, Israel Onyankopɔn Apam Adaka no akɔ Yerusalem. <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>Na Lewifoɔ no soaa Onyankopɔn Apam Adaka no wɔ wɔn mmati so a, nnua a wɔde soa no hyehyɛ ho pɛpɛɛpɛ, sɛdeɛ <char style="nd">Awurade</char> hyɛɛ Mose no.<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>Dawid hyɛɛ Lewifoɔ mpanimfoɔ no nso sɛ, wɔnte Lewifoɔ nnwomtofoɔ kuo, wɔn a wɔnim nnwontoɔ, ne wɔn a wɔwɔ nnwontoɔ ho nimdeɛ na wɔmfa mmɛnta, mmɛn, asankuten ne kyankyan mmɛto anigyeɛ nnwom.<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>Na Lewifoɔ no yii Yoɛl babarima Heman, Berekia babarima Asaf ne Kusaia babarima Etan a wɔfiri Merari abusua mu, ma wɔdii nnwomtofoɔ no anim. <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>Wɔyii saa mmarima yi sɛ wɔn aboafoɔ: Sakaria, Ben, Yaasiel, Semiramot, Yehiel, Uni, Eliab, Benaia, Maaseia, Matitia, Elifelehu, Mikneia ne apono ano ahwɛfoɔ Obed-Edom ne Yeiel.<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>Wɔyii Heman, Asaf ne Etan sɛ wɔmmɔ kɔbere mfrafraeɛ kyankyan no. <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>Wɔyii Sakaria, Asiel, Semiramot, Yehiel, Uni, Eliab, Maaseia ne Benaia sɛ wɔmmɔ mmɛnta no. <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>Wɔyii Matitia, Elifelehu, Miknela, Obed-Edom, Yeiel ne Asasia sɛ wɔmmɔ asankuten no. <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>Wɔyii Kenania a ɔyɛ Lewifoɔ panin no sɛ ɔnna nnwontokuo no ano, ɛsiane ne nimdeɛ enti.<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>Wɔyii Berekia ne Elkana sɛ wɔnwɛn Apam Adaka no. <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>Sebania, Yosafat, Netanel, Amasai, Sakaria, Benaia ne Elieser a wɔn nyinaa yɛ asɔfoɔ no na wɔbɛto santen adi Onyankopɔn Apam Adaka no anim, ahyɛn ntotorobɛnto no. Wɔyii Obed-Edom ne Yehia nso sɛ wɔnwɛn Apam Adaka no.<verse eid="1CH 15:24"/></para>
  <para style="s1">Wɔsoa Apam Adaka No Kɔ Yerusalem</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>Afei, Dawid ne Israel mpanimfoɔ ne akodɔm asahene no de ahokeka a ɛso bi nni kɔɔ Obed-Edom fie sɛ wɔrekɔfa <char style="nd">Awurade</char> Apam Adaka no akɔ Yerusalem. <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>Na ɛsiane sɛ akyinnyeɛ biara nni ho sɛ <char style="nd">Awurade</char> ka Lewifoɔ a wɔso <char style="nd">Awurade</char> Apam Adaka no ho no enti, wɔde anantwinini nson ne nnwennini nson bɔɔ afɔdeɛ. <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>Wɔhyɛɛ Dawid serekye atadeɛ fɛfɛ bi. Saa ara na Lewifoɔ a wɔsoaa Apam Adaka no, nnwomtofoɔ no ne Kenania a ɔyɛ nnwomtofoɔ kwankyerɛfoɔ no nso yɛeɛ. Na Dawid hyɛ asɔfoɔ ngugusoɔ bi nso. <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>Enti, Israel nyinaa de ahokeka, osebɔ, mmɛnhyɛn ne totorobɛntohyɛn, kyankyanbɔ, mmɛnta ne asankutenbɔ de <char style="nd">Awurade</char> Apam Adaka no kɔɔ Yerusalem.<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>Na ɛberɛ a <char style="nd">Awurade</char> Apam Adaka no wuraa Dawid kuro mu no, Saulo babaa Mikal too nʼani hwɛɛ fam, firii ne mpomma mu. Ɛberɛ a ɔhunuu sɛ ɔhene Dawid resa na ɔde anigyeɛ rehurihuri no, ɔbuu no animtiaa nʼakoma mu.<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>Na wɔde Onyankopɔn Apam Adaka no kɔsii ntomadan sononko bi a Dawid asiesie mu, na wɔbɔɔ ɔhyeɛ afɔdeɛ ne asomdwoeɛ afɔdeɛ wɔ Onyankopɔn anim. <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>Dawid wieeɛ no, ɔhyiraa nnipa no wɔ <char style="nd">Awurade</char> din mu. <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>Na ɔkyɛɛ Israelfoɔ mmaa ne mmarima nyinaa aduane. Obiara nyaa burodo mua, nankum ne bobe aba ɔfam.<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>Dawid yii saa Lewifoɔ yi sɛ wɔnni nnipa no anim wɔ ɔsom mu, wɔ <char style="nd">Awurade</char> Apam Adaka no anim, na wɔmfa so nsrɛ ne nhyira, na wɔnna <char style="nd">Awurade</char>, Israel Onyankopɔn ase na wɔnkamfo no. <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>Asaf a na ɔda kuo yi ano no bɔɔ kyankyan no. Na nʼabadiakyirefoɔ yɛ Sakaria a ɔtɔ so mmienu, afei, Yeiel, Semiramot, Yehiel, Matitia, Eliab, Benaia, Obed-Edom ne Yahasiel. Wɔn na wɔbɔɔ mmɛnta ne asankuten. <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>Asɔfoɔ Benaia ne Yahasiel taa bɔ ntotorobɛnto wɔ Onyankopɔn Apam Adaka no anim.<verse eid="1CH 16:6"/></para>
  <para style="s1">Dawid Aseda Dwom</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>Saa ɛda no, Dawid de saa aseda dwom a ɔde ma <char style="nd">Awurade</char> yi maa Asaf ne ne mfɛfoɔ Lewifoɔ:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>Ɛda <char style="nd">Awurade</char> ase na da ne kɛseyɛ adi.</para>
  <para style="q2" vid="1CH 16:8">Ma ewiase nyinaa nhunu deɛ wayɛ.<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>Monto dwom mma no, monto ayɛyie dwom mma no;</para>
  <para style="q2" vid="1CH 16:9">monka nʼanwanwadeɛ no nyinaa.<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>Monhoahoa mo ho wɔ ne din kronkron mu;</para>
  <para style="q2" vid="1CH 16:10">momma wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no nnya akoma mu anigyeɛ.<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>Momma mo ani nna <char style="nd">Awurade</char> ne nʼahoɔden so;</para>
  <para style="q2" vid="1CH 16:11">na monhwehwɛ nʼanim ɛberɛ biara.<verse eid="1CH 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>Monkae anwanwadeɛ a wayɛ,</para>
  <para style="q2" vid="1CH 16:12">ne nsɛnkyerɛnneɛ ne atemmuo a ɔbuiɛ.<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>Ao Israel mma, Onyankopɔn ɔsomfoɔ,</para>
  <para style="q2" vid="1CH 16:13">Ao Yakob mma a wapa wɔn.<verse eid="1CH 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>Ɔyɛ <char style="nd">Awurade</char>, yɛn Onyankopɔn;</para>
  <para style="q2" vid="1CH 16:14">nʼahennie da adi wɔ asase so nyinaa.<verse eid="1CH 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>Ɔkae nʼapam daa nyinaa,</para>
  <para style="q2" vid="1CH 16:15">asɛm a ɔhyɛ maa awoɔ ntoantoasoɔ apem no.<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>Yei ne apam a ɔne Abraham yɛeɛ</para>
  <para style="q2" vid="1CH 16:16">ne ntam a ɔka kyerɛɛ Isak.<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>Ɔhyɛɛ mu den maa Yakob sɛ mmara,</para>
  <para style="q2" vid="1CH 16:17">de maa Israel sɛ apam a ɛbɛtena hɔ afebɔɔ;<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“Mede Kanaan asase no bɛma wo</para>
  <para style="q1" vid="1CH 16:18">sɛ kyɛfa a ɛbɛyɛ wʼagyapadeɛ.”<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>Ɔkaa yei wɔ ɛberɛ a na wɔnnɔɔso,</para>
  <para style="q2" vid="1CH 16:19">ahɔhokuo ketewa bi a wɔwɔ Kanaan.<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>Wɔfirii aman so kɔɔ aman so,</para>
  <para style="q2" vid="1CH 16:20">firii ahemman mu kɔɔ ahemman mu.<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>Nanso, wamma obi anhyɛ wɔn so;</para>
  <para style="q2" vid="1CH 16:21">wɔn enti, ɔkaa ahene anim sɛ;<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“Mommfa mo nsa nka wɔn a masra wɔn ngo,</para>
  <para style="q1" vid="1CH 16:22">na monnyɛ mʼadiyifoɔ bɔne bi.”<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>Momma asase nyinaa nto dwom mma <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="1CH 16:23">Ɛda biara mompae mu nka asɛmpa no sɛ ɔgye nkwa.<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>Mommɔ nʼanimuonyam nneyɛɛ ho dawuro wɔ amanaman mu.</para>
  <para style="q2" vid="1CH 16:24">Monka anwanwadeɛ a ɔyɛ nkyerɛ obiara.<verse eid="1CH 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>
    <char style="nd">Awurade</char> yɛ kɛseɛ! Na ɔfata ayɛyie!</para>
  <para style="q2" vid="1CH 16:25">Ɛsɛ sɛ wɔsuro no sene anyame nyinaa.<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>Anyame a wɔwɔ aman foforɔ so yɛ ahoni bi kwa,</para>
  <para style="q2" vid="1CH 16:26">nanso <char style="nd">Awurade</char> na ɔbɔɔ ɔsoro!<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>Animuonyam ne tumi atwa ne ho ahyia,</para>
  <para style="q1" vid="1CH 16:27">ahoɔden ne ahoɔfɛ wɔ nʼatenaeɛ.<verse eid="1CH 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>Momfa mma <char style="nd">Awurade</char>, Ao amanaman mmusuakuo,</para>
  <para style="q2" vid="1CH 16:28">momfa animuonyam ne tumi mma <char style="nd">Awurade</char>.<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>Momfa animuonyam a ɛfata mma <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="1CH 16:29">Momfa mo afɔrebɔdeɛ mmra mmɛsom no.</para>
  <para style="q1" vid="1CH 16:29">Monsɔre <char style="nd">Awurade</char> wɔ ne hyerɛn kronkron nyinaa mu.<verse eid="1CH 16:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30"/>Momma asase nyinaa mpopo wɔ nʼanim.</para>
  <para style="q2" vid="1CH 16:30">Wɔatim ewiase denden a ɛntumi nhinhim.<verse eid="1CH 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>Momma ɔsoro ani nnye na asase nsɛpɛ ne ho!</para>
  <para style="q2" vid="1CH 16:31">Momma aman nyinaa nte sɛ, “<char style="nd">Awurade</char> yɛ ɔhene!”<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>Momma ɛpo ne deɛ ɛwɔ mu nyinaa nteam nkamfo no.</para>
  <para style="q2" vid="1CH 16:32">Momma mfuo ne wɔn nnɔbaeɛ mfa ahosɛpɛ mpue.<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>Momma kwaeɛm nnua nnyegyeeɛ</para>
  <para style="q2" vid="1CH 16:33">nyɛ ayɛyie <char style="nd">Awurade</char> anim!</para>
  <para style="q2" vid="1CH 16:33">Ɛfiri sɛ ɔrebɛbu asase atɛn.<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>Monna <char style="nd">Awurade</char> ase, ɛfiri sɛ ɔyɛ</para>
  <para style="q2" vid="1CH 16:34">na nʼadɔeɛ wɔ hɔ daa.<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>Monteateam sɛ, “Gye yɛn, Ao yɛn nkwagyeɛ Onyankopɔn!</para>
  <para style="q2" vid="1CH 16:35">Boa yɛn ano, na gye yɛn firi amanaman nsam,</para>
  <para style="q1" vid="1CH 16:35">na yɛatumi ada wo din kronkron ase,</para>
  <para style="q2" vid="1CH 16:35">na yɛadi ahurisie akamfo wo.”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>Ayɛyie nka <char style="nd">Awurade</char>, Israel Onyankopɔn,</para>
  <para style="q2" vid="1CH 16:36">ɛmfiri mmerɛsanten nkɔsi nnasanten.</para>
  <para style="m" vid="1CH 16:36">Na nnipa no nyinaa gyee so sɛ, “Amen!” Na wɔkamfoo <char style="nd">Awurade</char>.<verse eid="1CH 16:36"/></para>
  <para style="s1">Yerusalem Ne Gibeon Ɔsom</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>Dawid hyehyɛ maa Asaf ne ne mfɛfoɔ Lewifoɔ no sɛ wɔnsom daa wɔ <char style="nd">Awurade</char> Apam Adaka no anim, na wɔnyɛ deɛ ɛhia sɛ wɔyɛ no da biara. <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>Saa ekuo yi mu nnipa ne Obed-Edom (a ɔyɛ Yedutun babarima no), Hosa ne Lewifoɔ aduosia nwɔtwe a wɔyɛ apono anohwɛfoɔ.<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>Dawid de ɔsɔfoɔ Sadok ne ne mfɛfoɔ asɔfoɔ tenaa <char style="nd">Awurade</char> Ahyiaeɛ Ntomadan a ɛwɔ bepɔ Gibeon mu no, sɛ wɔnsom <char style="nd">Awurade</char> anim wɔ hɔ. <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>Anɔpa ne anwummerɛ biara, wɔbɔ ɔhyeɛ afɔdeɛ wɔ afɔrebukyia a wɔayi asi hɔ ama saa dwumadie no so. Na wɔdii biribiara a wɔatwerɛ sɛ <char style="nd">Awurade</char> mmara a ɔde ama Israel no so. <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>Dawid sane yii Heman, Yedutun ne afoforɔ bi a wɔbobɔɔ wɔn din, yiyii wɔn no sɛ, wɔnna <char style="nd">Awurade</char> ase “Na nʼadɔeɛ no tim hɔ daa.” <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>Heman ne Yedutun bɔɔ wɔn ntotorobɛnto, kyankyan ne nnwontodeɛ ahodoɔ de gyegyee ayɛyie nnwom a wɔto maa Onyankopɔn no ho. Na wɔyii Yedutun mmammarima maa wɔyɛɛ apono anohwɛfoɔ.<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>Na nnipa no nyinaa sane kɔɔ wɔn afie mu. Dawid nso sane kɔɔ ne fie, kɔhyiraa ne fiefoɔ.<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">
    <char style="nd">Awurade</char> Apam Bɔhyɛ A Ɔde Maa Dawid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>Afei, ɛberɛ a Dawid nyaa atenaseɛ wɔ nʼahemfie hɔ no, ɔka kyerɛɛ odiyifoɔ Natan sɛ, “Me deɛ manya ahemfie a wɔde ntweneduro asi no fɛfɛ mu atena, nanso <char style="nd">Awurade</char> Apam Adaka no deɛ, ɛhyɛ ntomadan mu.”<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>Natan buaa sɛ, “Deɛ ɛwɔ wʼadwene mu a wopɛ sɛ woyɛ no, kɔ so na Onyankopɔn ka wo ho.”<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>Saa anadwo no ara, Onyankopɔn ka kyerɛɛ Natan sɛ,<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“Kɔka kyerɛ me ɔsomfoɔ Dawid sɛ, ‘Sɛdeɛ <char style="nd">Awurade</char> seɛ nie: ɛnyɛ wo na ɛsɛ sɛ wosi asɔredan ma me tena mu. <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>Ɛfiri ɛberɛ a mede Israelfoɔ firii Misraim bɛsi ɛnnɛ, mentenaa asɔredan mu da. Daa, mete ntomadan mu na wɔde di atutena. <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>Na mannwiinwii ankyerɛ Israel ntuanofoɔ no a wɔyɛ me nkurɔfoɔ nnwanhwɛfoɔ no da. Memmisaa wɔn da sɛ: “Adɛn enti na momfaa ntweneduro nsii efie mmaa me da?” ’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“Afei, kɔka kyerɛ me ɔsomfoɔ Dawid sɛ, ‘Sɛdeɛ Otumfoɔ <char style="nd">Awurade</char> seɛ nie: Meyii wo sɛ di me nkurɔfoɔ Israelfoɔ anim wɔ ɛberɛ a na woyɛ abarimaa dwanhwɛfoɔ a worehwɛ wo nnwan wɔ adidibea. <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>Baabiara a wokɔeɛ no, mekaa wo ho. Na masɛe wʼatamfoɔ nyinaa. Na mɛma wɔagye edin wɔ asase yi nyinaa so. <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>Mama me nkurɔfoɔ Israelfoɔ no baabi a wɔbɛtena afebɔɔ. Beaeɛ bi a ɛwɔ banbɔ a obiara renha wɔn. Ɛhɔ bɛyɛ wɔn ankasa asase a aman amumuyɛfoɔ renhyɛ wɔn so, sɛdeɛ wɔyɛɛ wɔ ɛberɛ bi a atwam no, <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>firi ɛberɛ a meyii atemmufoɔ sɛ wɔnni me nkurɔfoɔ so no. Na mɛka wʼatamfoɔ nyinaa ahyɛ.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Na merepae mu aka sɛ, <char style="nd">Awurade</char> bɛsi efie ama wo, ahennie nnidisoɔ. <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>Na sɛ wowu a, mɛma wo mmammarima no mu baako so, na mama nʼahennie ayɛ den. <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>Ɔno ne obi a ɔbɛsi efie a ɛyɛ asɔredan no ama me. Na mɛtim nʼahennwa ase afebɔɔ. <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>Mɛyɛ nʼagya na ɔbɛyɛ me ba. Merenyi me dɔ a ɛnsa da no mfiri ne so, sɛdeɛ meyi firii Saulo a wodii nʼadeɛ so no. <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>Mɛma nʼase atim wɔ mʼahennie nnidisoɔ ne mʼaheman mu ɛberɛ nyinaa mu, na nʼahennwa no bɛtena hɔ daa.’ ”<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>Enti, Natan sane kɔɔ Dawid nkyɛn kɔkaa saa adiyisɛm yi nyinaa kyerɛɛ no.<verse eid="1CH 17:15"/></para>
  <para style="s1">Dawid Aseda Mpaeɛbɔ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>Afei, ɔhene Dawid kɔtenaa <char style="nd">Awurade</char> anim bɔɔ mpaeɛ sɛ,</para>
  <para style="pm" vid="1CH 17:16">“Me ne hwan, Ao <char style="nd">Awurade</char> Onyankopɔn, na mʼabusua yɛ abusua bɛn a enti wode me abɛduru saa tebea yi mu? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>Na seesei, <char style="nd">Awurade</char>, yei nyinaa akyi no, woka sɛ wobɛma me ahennie nnidisoɔ afebɔɔ. Wokasa me ho te sɛ obi a meyɛ ɔkɛseɛ pa ara, Ao <char style="nd">Awurade</char> Onyankopɔn!<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“Ɛdeɛn na menka bio mfa ɛkwan a woafa so ahyɛ me animuonyam yi ho? Wonim sɛdeɛ wʼakoa teɛ ankasa. <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>Ao <char style="nd">Awurade</char>, me enti ne wo pɛ mu enti, woayɛ saa nneɛma akɛseɛ yi nyinaa, na woada no adi.<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“Ao <char style="nd">Awurade</char>, obiara nni hɔ a ɔte sɛ wo. Onyame foforɔ bi nni hɔ! Yɛntee da mpo sɛ onyame foforɔ bi wɔ hɔ te sɛ wo! <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>Ɔman foforɔ bɛn na ɛwɔ asase so a, ɛte sɛ Israel? Ɔman foforɔ bɛn, Ao Onyankopɔn, na woayi no afiri nkoasom mu de wɔn abɛyɛ wʼankasa wo nkurɔfoɔ? Ɛberɛ a wogyee wo nkurɔfoɔ firii Misraim no, wode gyee edin. Wonam nsɛnkyerɛnneɛ a ɛyɛ ahodwirie so pamoo aman a wɔayɛ akwansideɛ ama wɔn. <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>Woyii Israel sɛ wɔmmɛyɛ wo nkurɔfoɔ afebɔɔ, na wo, Ao <char style="nd">Awurade</char>, woabɛyɛ wɔn Onyankopɔn.<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“Ao <char style="nd">Awurade</char>, afei di ɛbɔ a wohyɛ faa wʼakoa ne ne mʼabusuafoɔ ho no so. Ma ɛnyɛ bɔhyɛ a ɛbɛtena hɔ daa. <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>Wo din ase ntim, na wɔnhyɛ no animuonyam afebɔɔ sɛdeɛ ɛbɛyɛ a ewiase nyinaa bɛka sɛ, ‘<char style="nd">Awurade</char> Otumfoɔ yɛ Onyankopɔn wɔ Israel!’ Na ma wo ɔsomfoɔ Dawid ahennie nnidisoɔ no ase ntim wɔ wʼanim.<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“Ao me Onyankopɔn, masi me bo abɔ saa mpaeɛ yi, ɛfiri sɛ, woada no adi sɛ wobɛsi fie ama me, mʼahennie nnidisoɔ a ɛbɛtena hɔ daa. <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>Ɛfiri sɛ, woyɛ Onyankopɔn, Ao <char style="nd">Awurade</char>. Na me, wo ɔsomfoɔ, woahyɛ me nneɛma pa yi ho bɔ. <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>Na afei, asɔ wʼani sɛ wobɛhyira me ne mʼabusuafoɔ, sɛdeɛ yɛn ahennie nnidisoɔ bɛkɔ so afebɔɔ wɔ wʼanim. Na sɛ wohyira a, Ao <char style="nd">Awurade</char>, ɛyɛ nhyira a ɛtena hɔ daa nyinaa!”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">Dawid Akodie Mu Nkonimdie</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>Yei akyiri no, Dawid ko dii Gat ne nkuro a atwa ho ahyia no so nkonim, de kaa Filistifoɔ no hyɛeɛ, brɛɛ wɔn ase. <verse eid="1CH 18:1"/><verse number="2" style="v" sid="1CH 18:2"/>Bio, Dawid dii Moab asase no so nkonim, ma Moabfoɔ no bɛyɛɛ Dawid nkoa a na wɔtua apeatoɔ ma no.<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>Afei, Dawid tɔree ɔhene Hadadeser a ɔfiri Soba akodɔm ase, de kɔsii Hamat wɔ ɛberɛ a Hadadeser bɔɔ nsra wɔ Asubɔnten Eufrate ho sɛ anka ɔrehyɛ ne tumi mu den no. <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>Dawid ko gyee nteaseɛnam apem, nteaseɛnamkafoɔ mpem nson ne nammɔntwa asraafoɔ ɔpeduonu. Afei, ɔtwitwaa nteaseɛnam apɔnkɔ no nyinaa nantin ntini, ma ɛkaa ɔha pɛ.<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>Ɛberɛ a Aramfoɔ firi Damasko baa sɛ wɔrebɛboa Hadadeser no, Dawid kunkumm wɔn mu ɔpeduonu mmienu. <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>Afei, ɔde asraafodɔm guu Damasko, Aram ahenkuro mu, ma Aramfoɔ no bɛyɛɛ Dawid nkoa a na wɔbrɛ no apeatoɔ. Baabiara a Dawid bɛkɔ no, <char style="nd">Awurade</char> ma no di nkonim. <verse eid="1CH 18:6"/><verse number="7" style="v" sid="1CH 18:7"/>Dawid faa sikakɔkɔɔ nkuruwa a na ɛyɛ Hadadeser mpanimfoɔ dea no de ne nyinaa kɔɔ Yerusalem. <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>Ɔde kɔbere mfrafraeɛ bebree a ɛfiri Hadadeser nkuro Tibhat ne Kun kaa ho baeɛ. Akyire yi, Salomo nanee kɔbere mfrafraeɛ no de yɛɛ asɔredan no ho adwuma. Ɔde yɛɛ kɔbere mfrafraeɛ Po na ɔde bi yɛɛ afadum ne kɔbere nkuku ne nkaka a wɔde di dwuma wɔ asɔredan no mu.<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>Ɛberɛ a Hamathene Toi tee sɛ Dawid atɔre Sobahene Hadadeser akodɔm ase no, <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>ɔsomaa ne babarima Hadoram ma ɔkɔɔ Dawid nkyɛn kɔmaa no amo wɔ ne nkonimdie no ho. Na Hadadeser ne Tou atane wɔn ho akyɛre, a na akokoakoko aba wɔn ntam. Yoram kɔkyɛɛ Dawid sikakɔkɔɔ, dwetɛ ne kɔbere mfrafraeɛ bebree.<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>Ɔhene Dawid hyiraa saa akyɛdeɛ yi nyinaa so maa <char style="nd">Awurade</char>, a dwetɛ ne sikakɔkɔɔ a ɔfa firii aman foforɔ a ɔkaa wɔn hyɛeɛ no so no nyinaa ka ho. Saa aman no ne Edom, Moab, Amon, Filistia ne Amalek.<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>Seruia babarima Abisai kunkumm Edomfoɔ mpem dunwɔtwe wɔ Nkyene Bɔnhwa no mu. <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>Ɔde asraafoɔ duaduaa Edom nyinaa, ma Edomfoɔ nyinaa bɛyɛɛ Dawid nkoa. Yei yɛ sɛdeɛ <char style="nd">Awurade</char> ma Dawid dii nkonim wɔ baabiara a ɔkɔeɛ no nhwɛsoɔ.<verse eid="1CH 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>Dawid dii ɔhene wɔ Israel nyinaa so, na ɔne obiara tenaa yie.<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>Seruia babarima Yoab na na ɔyɛ ɔsafohene. Ahilud babarima Yehosafat na na ɔyɛ adehyeɛ abakɔsɛmtwerɛni.<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>Ahitub babarima Sadok ne Abiatar babarima Abimelek na na wɔyɛ asɔfoɔ.</para>
  <para style="li1" vid="1CH 18:16">Sawsa na na ɔyɛ asɛnniiɛ twerɛfoɔ.<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>Yehoiada babarima Benaia na na ɔyɛ ɔhene awɛmfoɔ no so panin.</para>
  <para style="li1" vid="1CH 18:17">Dawid mmammarima somm sɛ ɔhene aboafoɔ mpanimfoɔ.<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">Dawid Di Amorifoɔ So Nkonim</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>Yeinom akyiri no, Amonhene Nahas wuiɛ, na ne babarima Hanun bɛdii adeɛ. <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>Dawid kaa sɛ, “Me ne Hanun bɛyɛ baako, ɛfiri sɛ, nʼagya Nahas ne me yɛɛ baako nokorɛm.”</para>
  <para style="p" vid="1CH 19:2">Ɛno enti, Dawid tuu abɔfoɔ maa wɔkɔɔ Hanun nkyɛn, kɔmaa no hyɛden wɔ nʼagya wuo no enti. Nanso, ɛberɛ a abɔfoɔ no duruu Amon asase so no, <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>Hanun afotufoɔ bisaa no sɛ, “Enti, wogye di ampa ara sɛ, saa mmarima yi baa sɛ wɔrebɛhyɛ wʼagya animuonyam? Dabi! Dawid asoma wɔn sɛ wɔmmɛsra asase yi, na wɔnam so ako agye.” <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>Enti, Hanun kyeree Dawid abɔfoɔ no, werɛɛ wɔn abɔgyesɛ, twitwaa wɔn ntadeɛ ano wɔ wɔn to ase, maa wɔsane de animguaseɛ kɔɔ Dawid nkyɛn.<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>Ɛberɛ a Dawid tee asɛm no, ɔtuu abɔfoɔ kɔɔ abɔfoɔ no nkyɛn kɔka kyerɛɛ wɔn sɛ, wɔntena Yeriko kɔsi sɛ wɔn abɔgyesɛ no bɛfu, ɛfiri sɛ, na wɔn ho ayɛ fɛreɛ.<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>Afei, Amonfoɔ hunuu abufutrasoɔ a wɔahyɛ Dawid no, Hanun ne Amonfoɔ soma maa wɔde dwetɛ nkariboɔ ani tɔno 38 kɔgyee nteaseɛnam ne akodɔm firii Aram-naharaim, Aram-maaka ne Soba. <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>Wɔsane pɛɛ nteaseɛnam mpem aduasa mmienu, na wɔnyaa akyigyina firii Maakahene ne nʼakodɔm nkyɛn. Saa akodɔm yi kyeree nsraban wɔ Medeba, ɛhɔ na Amon akodɔm a Hanun nya firii nʼankasa nkuro so no kɔkaa wɔn ho.<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>Ɛberɛ a Dawid tee saa asɛm yi no, ɔsomaa Yoab ne nʼakofoɔ sɛ wɔne wɔn nkɔko. <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>Amonfoɔ akodɔm no bɛgyinagyinaa kuro no ɛpono ano, na ahemfo a wɔaka no nso gyinagyinaa ɛserɛ no so.<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>Ɛberɛ a Yoab hunuu sɛ ɛsɛ dɔm no anim kyerɛ ne so wɔ nʼanim ne nʼakyi no, ɔyii nʼakodɔm no mu akofoɔ a wɔnim ako no. Ɔde wɔn hyɛɛ nʼankasa ase, dii wɔn anim kɔko tiaa Aramfoɔ no a wɔgyinagyina ɛserɛ so no. <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>Ɔgyaa akodɔm a wɔaka no maa ne nuabarima Abisai sɛ ɔnkɔto nhyɛ Amonfoɔ no so. <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>Na Yoab ka kyerɛɛ ne nuabarima no sɛ, “Sɛ Aramfoɔ no yɛ den ma me dodo a, bra na bɛboa me.” Yoab toaa so sɛ, “Sɛ Amonfoɔ no yɛ den dodo ma wo a, mɛba abɛboa wo. <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>Hyɛ wo ho den. Ma yɛmfa akokoɔduru nko nnye yɛn nkurɔfoɔ ne yɛn Onyankopɔn nkuro. <char style="nd">Awurade</char> pɛ nyɛ hɔ.”<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>Ɛberɛ a Yoab ne nʼakodɔm to hyɛɛ Aramfoɔ so no, wɔfirii aseɛ dwaneeɛ. <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>Na Amonfoɔ hunuu sɛ Aramfoɔ no redwane no, wɔdwane firi Abisai anim kɔɔ kuropɔn no mu. Afei, Yoab sane kɔɔ Yerusalem.<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>Afei, Aramfoɔ no hunuu sɛ ɛnyɛ wɔn afɛ ne Israelfoɔ enti, wɔfrɛɛ Aram akodɔm foforɔ firii Asubɔnten Eufrate ho sɛ wɔmmɛboa. Saa akodɔm a wɔhyɛ Sofak a ɔyɛ Hadadeser akodɔm nyinaa sahene ase no baeɛ.<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>Ɛberɛ a Dawid tee asɛm a asi no, ɔboaboaa Israel nyinaa ano, de wɔn twaa Asubɔnten Yordan, de nʼakodɔm no gyinagyinaa wɔn mpasua so. Afei, ɔne atamfoɔ no de ɔko hyehyɛɛ so, maa wɔko tiaa no. <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>Ɛha nso, Aramfoɔ no dwane firii Israelfoɔ no anim. Saa ɛberɛ yi, Dawid akodɔm no kunkumm nteaseɛnamkafoɔ mpem nson ne anammɔntwa asraadɔm ɔpeduanan a Sofak a ɔyɛ akodɔm no sahene no ka ho.<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>Hadadeser asomfoɔ hunuu sɛ Israel adi wɔn so nkonim no, wɔmaa wɔn nsa so, maa Dawid faa wɔn sɛ ne nkoa. Ɛno akyi, Aramfoɔ ampɛ sɛ wɔbɛboa Amonfoɔ bio.<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">Wɔko Fa Raba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>Asusɔ berɛ, afe mu ɛberɛ a ahemfo kɔ ɔko no, Yoab dii Israel akodɔm anim, kɔto hyɛɛ Amonfoɔ nkuro ne nkuraa so, dii wɔn so nkonim. Akodie no mu no, wɔtuaa Raba kuropɔn no, sɛee no. Saa ɛberɛ no, na Dawid te akyire wɔ Yerusalem. <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>Ɛberɛ a Dawid duruu Raba no, ɔtuu ɔhene no ahenkyɛ, na wɔde hyɛɛ Dawid. Sikakɔkɔɔ na wɔde yɛɛ ahenkyɛ no na wɔde aboɔdemmoɔ abobɔ mu. Na emu duru bɛyɛ kilogram aduasa ɛnan. Dawid faa asadeɛ bebree firii kuro no mu. <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>Ɔde Rabafoɔ no yɛɛ nkoa, hyɛɛ wɔn ma wɔde ɛwan, fatudadeɛ ne mmonnua yɛɛ adwuma. Saa ara na ɔhyɛɛ nnipa a wɔwɔ Amon nkuropɔn nyinaa so. Na Dawid ne nʼakodɔm sane kɔɔ Yerusalem.<verse eid="1CH 20:3"/></para>
  <para style="s1">Wɔne Filistifoɔ Ko No</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>Yei akyi, ɔko sii wɔne Filistifoɔ ntam wɔ Geser. Ɔko no mu, Sibekai a ɔfiri Husa kumm Sipai a ɔyɛ ɔbrane no aseni. Enti wɔkaa Filistifoɔ no hyɛeɛ.<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>Ɔko foforɔ bi a wɔne Filistifoɔ koeɛ mu no, Yair babarima Elhanan kumm Gatni Goliat nuabarima Lahmi. Na Lahmi pea nsa mu pipiripie te sɛ ntomanwomfoɔ nsadua.<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>Ɔko foforɔ bi nso a wɔne Filistifoɔ koo wɔ Gat no, ɔbrane bi a ɔyɛ abrane asefoɔ no bi a ɔyɛ nsansia yɛ nansia wɔ ne nsa ne ne nan biara so no <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>buu Israel animtia, twitwaa mpoa. Na Dawid nuabarima Simea babarima Yonatan kumm no.<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>Na saa Filistifoɔ yi yɛ Gat abrane no asefoɔ nanso Dawid ne nʼakofoɔ kunkumm wɔn.<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">Dawid Kan Nnipa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>Ɔbonsam sɔre tiaa Israel, ma Dawid kanee Israelfoɔ. <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>Dawid hyɛɛ Yoab ne nʼasahene sɛ, “Monkan nnipa a wɔwɔ asase yi so nyinaa firi Beer-Seba a ɛwɔ anafoɔ fam kɔsi Dan a ɛwɔ atifi fam, na momfa wɔn dodoɔ mmrɛ me, na ɛmma menhunu wɔn ano.”<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>Na Yoab kaa sɛ, “<char style="nd">Awurade</char> mmɔ ne nkurɔfoɔ no dodoɔ ho mpɛn ɔha ɔha! Na me wura, adɛn enti na wopɛ sɛ woyɛ saa? Wɔn nyinaa nyɛ wʼasomfoɔ anaa? Adɛn enti na ɛsɛ sɛ woyɛ ma Israel yɛ bɔne?”<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>Nanso, ɔhene no kaa sɛ, deɛ ɛteɛ biara ɛsɛ sɛ Yoab kan nnipa no. Enti, Yoab kyinkyinii Israel nyinaa kanee nnipa no. Na ɔsane baa Yerusalem <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>bɛkaa nnipa no dodoɔ kyerɛɛ Dawid. Na wɔn dodoɔ yɛ mmarima ɔpepem baako ne ɔpeha a wɔaso ɔsa kɔ wɔ Israel ne ɔpehanan aduɔson wɔ Yuda.<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>Nanso, Yoab amfa Lewi ne Benyamin mmusuakuo anka nnipakan no ho, ɛfiri sɛ, na deɛ ɔhene ahyɛ no sɛ ɔnyɛ no yɛ no ahomete.<verse eid="1CH 21:6"/></para>
  <para style="s1">Dawid Bɔne Ho Atemmuo</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7"/>Onyankopɔn ampɛ nnipakan no koraa enti, ɔtwee Israel aso wɔ ho. <verse eid="1CH 21:7"/><verse number="8" style="v" sid="1CH 21:8"/>Na Dawid ka kyerɛɛ Onyankopɔn sɛ, “Mayɛ bɔne kɛseɛ. Anka ɛnsɛ sɛ mekan nnipa no. Mesrɛ wo, fa me nkwaseadeɛ a mayɛ no kyɛ me.”<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>Na <char style="nd">Awurade</char> kasa kyerɛɛ Gad a ɔyɛ Dawid ɔdehunumuni no. Na nkra no nie: <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“Kɔ na kɔka kyerɛ Dawid sɛ, ‘Sɛdeɛ <char style="nd">Awurade</char> seɛ nie: Merema wo nneɛma mmiɛnsa. Yi saa asotweɛ yi mu baako na menyɛ ntia wo.’ ”<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>Enti, Gad baa Dawid nkyɛn bɛkaa sɛ, “Nneɛma mmiɛnsa a <char style="nd">Awurade</char> de ama wo no nie: <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>Wopɛ a, yi mfeɛ mmiɛnsa a ɛkɔm kɛseɛ bɛba anaa abosome mmiɛnsa a wʼatamfoɔ bɛkunkum mo anaa nnansa a ɔyaredɔm a ano yɛ den yie a, <char style="nd">Awurade</char> ɔbɔfoɔ nam so de ɔsɛeɛ bɛba Israel asase so. Dwene yei ho, na ma menhunu mmuaeɛ ko a memfa nkɔma <char style="nd">Awurade</char>.”<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>Dawid buaa Gad sɛ, “Yei yɛ ahohiahiasɛm. Ma ɛmfiri <char style="nd">Awurade</char> nsam, ɛfiri sɛ, nʼahummɔborɔ so. Mma ɛmfiri onipa nsam.”<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>Na <char style="nd">Awurade</char> maa ɔyaredɔm baa Israel so, maa nnipa ɔpeduɔson wuwuiɛ. <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>Afei, Onyankopɔn somaa ɔsoro ɔbɔfoɔ sɛ ɔnkɔsɛe Yerusalem. Na ɔsoro ɔbɔfoɔ no reyɛ ahoboa asɛe no no, <char style="nd">Awurade</char> nyaa ahummɔborɔ ka kyerɛɛ owuo soro ɔbɔfoɔ no sɛ, “Gyae! Ɛno ara dɔɔso!” Saa ɛberɛ no na ɔsoro ɔbɔfoɔ no gyina Yebusini Arauna ayuporobea hɔ.<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>Dawid pagyaa nʼani hunuu sɛ <char style="nd">Awurade</char> ɔbɔfoɔ no gyina ɔsoro ne asase ntam a, watwe nʼakofena de akyerɛ Yerusalem so. Enti, Dawid ne Israel mpanimfoɔ firaa ayitoma de kyerɛɛ wɔn ahoyera, na wɔhwehwee fam de wɔn anim butubutuu hɔ.<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>Na Dawid ka kyerɛɛ Onyankopɔn sɛ, “Me na mede nnipakan no ho asɛm baeɛ! Me ne obi a mayɛ bɔne na mafom. Saa nkurɔfoɔ yi deɛ, ɛso bi nna wɔn so. Ɛdeɛn na wɔayɛ? Ao <char style="nd">Awurade</char> me Onyankopɔn, ma wʼabufuo mmra me ne me fiefoɔ so, na nsɛe wo nkurɔfoɔ.”<verse eid="1CH 21:17"/></para>
  <para style="s1">Dawid Si Afɔrebukyia</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>Na <char style="nd">Awurade</char> ɔbɔfoɔ no ka kyerɛɛ Gad sɛ ɔnka nkyerɛ Dawid ma ɔnsi afɔrebukyia mma <char style="nd">Awurade</char> wɔ Yebusini Arauna ayuporobea hɔ. <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>Na Dawid yɛɛ deɛ <char style="nd">Awurade</char> nam Gad so ka kyerɛɛ no no. <verse eid="1CH 21:19"/><verse number="20" style="v" sid="1CH 21:20"/>Arauna a saa ɛberɛ no nʼani abere repore nʼatokoɔ so no danee ne ho hunuu ɔbɔfoɔ no wɔ hɔ. Ne mmammarima baanan a na wɔka ne ho wɔ hɔ no dwane kɔtetɛeɛ. <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>Ɛberɛ a Arauna hunuu sɛ ɔhene Dawid reba ayuporobea hɔ no, ɔfiri hɔ kɔkotoo nʼanim.<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>Na Dawid ka kyerɛɛ Arauna sɛ, “Tɔn ayuporobea yi ma me sɛdeɛ ne boɔ teɛ. Na mɛsi afɔrebukyia ama <char style="nd">Awurade</char> wɔ hɔ sɛdeɛ ɔbɛsi ɔyaredɔm no ano.”<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>Arauna ka kyerɛɛ Dawid sɛ, “Fa, me wura, na fa yɛ deɛ wopɛ. Anantwie a wode bɛbɔ afɔdeɛ nie. Wobɛtumi de ayuporobea nnua yi ayɛ anyina de asɔ ogya wɔ afɔrebukyia no so. Fa atokoɔ no nso bɔ atokoɔ afɔdeɛ. Mede ne nyinaa bɛma wo.”<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>Na ɔhene no buaa Arauna sɛ, “Dabi! Mepɛ sɛ metua deɛ ɛfata ma wo. Merentumi nnye wʼagyapadeɛ mfa mma <char style="nd">Awurade</char>. Meremmɔ ɔhyeɛ afɔdeɛ a memmɔɔ ho ka.”<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>Enti, Dawid tuaa sikakɔkɔɔ kilogram nson maa Arauna, de tɔɔ ayuporobea no. <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>Dawid sii afɔrebukyia wɔ hɔ maa <char style="nd">Awurade</char>, bɔɔ ɔhyeɛ afɔdeɛ ne asomdwoeɛ afɔdeɛ wɔ so. Na Dawid bɔɔ mpaeɛ no, <char style="nd">Awurade</char> tiee no, nam so de ogya firi soro bɛhyee afɔrebɔdeɛ a ɛwɔ afɔrebukyia no so no.<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>Afei, <char style="nd">Awurade</char> kasa kyerɛɛ ɔbɔfoɔ no maa ɔsane de nʼakofena no hyɛɛ ne bɔha mu. <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>Ɛberɛ a Dawid hunuu sɛ <char style="nd">Awurade</char> atie ne mpaeɛbɔ no, ɔbɔɔ afɔdeɛ pii wɔ Yebusini Arauna ayuporobea hɔ. <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>Saa ɛberɛ no na <char style="nd">Awurade</char> Ahyiaeɛ Ntomadan ne afɔrebukyia a Mose sii wɔ ɛserɛ so hɔ no sisi Gibeon sorɔnsorɔmmea hɔ. <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>Nanso, Dawid antumi ankɔ hɔ ankɔbisa Onyankopɔn ase, ɛfiri sɛ, akofena a <char style="nd">Awurade</char> ɔbɔfoɔ no tweeɛ no bɔɔ no hu.<verse eid="1CH 21:30"/></para>
  <para style="b"/>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>Afei, Dawid kaa sɛ, “Ɛha ne baabi a wɔbɛsi <char style="nd">Awurade</char> Onyankopɔn Asɔredan no ne afɔrebukyia a Israel bɛbɔ so ɔhyeɛ afɔdeɛ no.”<verse eid="1CH 22:1"/></para>
  <para style="s1">Asɔredan No Sie Ho Ahoboa</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>Ɛno enti, Dawid hyɛ ma wɔfrɛfrɛɛ ahɔhoɔ a wɔte Israel nyinaa boaa ano. Ɔmaa wɔtwaa aboɔ a wɔde bɛsi Onyankopɔn Asɔredan no. <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>Dawid maa nnadeɛ pii a wɔde bɛyɛ nnadewa a ɛho bɛhia ama apono ne mfɛwa. Ɔmaa kɔbere mfrafraeɛ nso bebree a na wɔntumi nkari mpo. <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>Ɔmaa ntweneduro nnua pii nso, ɛfiri sɛ na mmarima a wɔfiri Tiro ne Sidon de bebree abrɛ Dawid dada.<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>Dawid kaa sɛ, “Me babarima Salomo nnyiniiɛ, na ɔnni osuahunu bi, nanso ɛsɛ sɛ <char style="nd">Awurade</char> asɔredan yi yɛ kɛseɛ, gye edin na ɛyɛ animuonyamhyɛdeɛ wɔ ewiase afanan nyinaa. Enti, mɛfiri aseɛ ayɛ ahoboa ama ne sie ɛnnɛ yi ara.” Enti, Dawid pɛɛ adansie ho nneɛma bebree guu hɔ ansa na ɔrewu.<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>Afei, Dawid soma kɔfaa ne babarima Salomo, na ɔka kyerɛɛ no sɛ ɔnsi asɔredan mma <char style="nd">Awurade</char>, Israel Onyankopɔn. <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>Dawid ka kyerɛɛ no sɛ, “Me ba, na anka mepɛ sɛ mesi asɔredan de hyɛ <char style="nd">Awurade</char>, me Onyankopɔn, din animuonyam. <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>Nanso, <char style="nd">Awurade</char> ka kyerɛɛ me sɛ, ‘Woakunkum nnipa bebree akodie akɛseɛ a wodii no mu. Na ɛsiane sɛ woahwie mogya bebree agu wɔ mʼanim enti, ɛnyɛ wo na wobɛsi asɔredan de ahyɛ me din animuonyam. <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>Na wobɛwo ɔbabarima a ne berɛ so asomdwoeɛ ne ahotɔ bɛba. Mɛma asomdwoeɛ abɛda ɔne nʼatamfoɔ a wɔwɔ nsase a atwa ha ahyia no nyinaa ntam. Wɔbɛfrɛ no Salomo. Nʼahennie mu no, mɛma asomdwoeɛ ne ahotɔ aba Israel. <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>Ɔno ne obi a ɔbɛsi asɔredan, de ahyɛ me din animuonyam. Ɔbɛyɛ me babarima na mayɛ nʼagya. Na mɛma nʼahennie ahennwa atim wɔ Israel afebɔɔ.’<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“Afei, me ba, <char style="nd">Awurade</char> nka wo ho na ɔmma wo nkɔsoɔ wɔ ɛberɛ a wodi nʼahyɛdeɛ so, na woresi <char style="nd">Awurade</char>, wo Onyankopɔn, asɔredan yi. <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>Na <char style="nd">Awurade</char> mma wo nyansa ne nteaseɛ, na woadi <char style="nd">Awurade</char>, wo Onyankopɔn mmara so wɔ ɛberɛ a wodi Israel so ɔhene yi. <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>Sɛ wodi mmara ne ahyɛdeɛ a <char style="nd">Awurade</char> nam Mose so de maa Israel no so yie a, ɛbɛsi wo yie. Yɛ den na yɛ nnam. Nsuro na mma wʼakoma ntu.<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“Mayɛ adwumaden apɛ <char style="nd">Awurade</char> Asɔredan no sie ho nneɛma, sikakɔkɔɔ bɛyɛ tɔno 4,000, dwetɛ bɛyɛ tɔno 40,000 ne nnadeɛ ne kɔbere mfrafraeɛ pii a wɔntumi nkari mpo. Maboaboa nnua ne aboɔ a wɔde bɛyɛ afasuo no, nanso ebia ɛsɛ sɛ wopɛ bi ka ho. <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>Wowɔ aboɔ adansifoɔ, nnua adwumfoɔ ne nnwuma ahodoɔ mu adwumfoɔ bebree. <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>Wɔyɛ abenfoɔ wɔ sikakɔkɔɔ, dwetɛ adwinnie mu, kɔbere mfrafraeɛ ne nnadeɛ ho adwumayɛfoɔ. Afei hyɛ adwuma no ase, na <char style="nd">Awurade</char> nka wo ho.”<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>Na Dawid hyɛɛ Israel ntuanofoɔ nyinaa sɛ wɔmmoa Salomo wɔ saa dwumadie no mu. <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>Ɔkaa sɛ, “<char style="nd">Awurade</char>, wo Onyankopɔn ka wo ho. Wama asomdwoeɛ aba wo ne aman a atwa wo ho ahyia no ntam. Ɔde wɔn ama me, enti wɔyɛ <char style="nd">Awurade</char> ne ne nkurɔfoɔ nkoa. <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>Afei firi wʼakoma nyinaa mu hwehwɛ <char style="nd">Awurade</char>, wo Onyankopɔn. Si <char style="nd">Awurade</char> Onyankopɔn kronkronbea sɛdeɛ ɛbɛyɛ a, wobɛtumi de <char style="nd">Awurade</char> Apam Adaka no ne Onyankopɔn akronkronneɛ no nyinaa akɔ asɔredan a wɔasi de rehyɛ <char style="nd">Awurade</char> din animuonyam no mu.”<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">Lewifoɔ Nnwuma</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>Ɛberɛ a Dawid bɔɔ akɔkoraa no, ɔyii ne babarima Salomo sɛ ɔno na ɔbɛdi Israel so ɔhene.<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>Dawid frɛfrɛɛ Israel amanyɛ ntuanofoɔ nyinaa ne asɔfoɔ, a Lewifoɔ ka ho sɛ, wɔmmra ahensie afahyɛ no ase. <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>Wɔkanee Lewifoɔ a wɔadi mfirinhyia aduasa anaa deɛ ɛboro saa, na wɔn nyinaa dodoɔ yɛ mpem aduasa nwɔtwe. <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>Na Dawid kaa sɛ, “Wɔn mu mpem aduonu ɛnan bɛhwɛ <char style="nd">Awurade</char> Asɔredan no ho adwuma so. Mpem nsia bɛsom sɛ mpanimfoɔ ne atemmufoɔ. <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>Mpem ɛnan bɛyɛ apono ano ahwɛfoɔ na mpem ɛnan foforɔ de nnwontodeɛ a mayɛ no bɛkamfo <char style="nd">Awurade</char>.”<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="6" style="v" sid="1CH 23:6"/>Na Dawid kyekyɛɛ Lewifoɔ no mu akuakuo de mmusuakuo a wɔyɛ Lewi mmammarima Gerson, Kohat ne Merari asefoɔ no din totoo wɔn so.<verse eid="1CH 23:6"/></para>
  <para style="s1">Gersonfoɔ</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>Gerson mmammarima ne:</para>
  <para style="li2" vid="1CH 23:7">Libni ne Simei.<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>Libni asefoɔ no mu baasa yɛ:</para>
  <para style="li2" vid="1CH 23:8">Yehiel (a ɔyɛ abusuapanin), Setam ne Yoɛl.<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>Yeinom na na wɔyɛ Libni abusua no mpanimfoɔ.</para>
  <para style="li2" vid="1CH 23:9">Na Simei asefoɔ baasa no ne Selomot, Hasiel ne Haran.<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>Simei asefoɔ baanan a wɔaka no ne:</para>
  <para style="li2" vid="1CH 23:10">Yahat, Sisa, Yeus ne Beria.<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>Na Yahat yɛ ɔbapanin, na Sisa di Yahat akyi. Wɔfaa Yeus ne Beria sɛ abusua baako, ɛfiri sɛ, na wɔn mu biara nni mmammarima dodoɔ.<verse eid="1CH 23:11"/></para>
  <para style="s1">Kohatfoɔ</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>Na Amram, Ishar, Hebron ne Usiel ka Kohat asefoɔ no ho.<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>Amram mmammarima yɛ:</para>
  <para style="li2" vid="1CH 23:13">Aaron ne Mose.</para>
  <para style="li2" vid="1CH 23:13">Wɔyii Aaron ne nʼasefoɔ sɛ wɔnni nneɛma kronkron no ho dwuma, na wɔmmɔ afɔdeɛ wɔ <char style="nd">Awurade</char> anim, nsom <char style="nd">Awurade</char>, na wɔnhyira wɔ ne din mu daa daa. <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>Mose a ɔyɛ Onyankopɔn onipa no deɛ, wɔde ne mmammarima kaa Lewi abusuakuo ho.<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>Mose mmammarima no yɛ</para>
  <para style="li2" vid="1CH 23:15">Gersom ne Elieser.<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>Na Sebuel a ɔyɛ abusuapanin no ka Gersom asefoɔ no ho.<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>Na Elieser wɔ ɔbabarima baako a wɔfrɛ no Rehabia a na ɔyɛ abusuapanin.</para>
  <para style="li2" vid="1CH 23:17">Na Rehabia mmammarima yɛ bebree.<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>Na Selomit a ɔyɛ abusuapanin no ka Ishar asefoɔ no ho.<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>Na Yeria a ɔyɛ abusuapanin,</para>
  <para style="li2" vid="1CH 23:19">Amaria a ɔdi hɔ,</para>
  <para style="li1" vid="1CH 23:19">Yahasiel a ɔtɔ so mmiɛnsa</para>
  <para style="li2" vid="1CH 23:19">ne Yekameam a ɔtɔ so ɛnan no</para>
  <para style="li2" vid="1CH 23:19">ne Hebron mmammarima no.<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>Na Mika a ɔyɛ abusuapanin ne Yisia a ɔdi hɔ no</para>
  <para style="li2" vid="1CH 23:20">yɛ Usiel asefoɔ no.<verse eid="1CH 23:20"/></para>
  <para style="s1">Merarifoɔ</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>Na Mahli ne Musi yɛ</para>
  <para style="li2" vid="1CH 23:21">Merari mmammarima.</para>
  <para style="li1" vid="1CH 23:21">Mahli mmammarima ne:</para>
  <para style="li2" vid="1CH 23:21">Eleasa ne Kis.<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>(Eleasa wuiɛ a wanwo mmammarima biara, na mmom, mmammaa nko ara. Ne mmammaa no warewaree wɔn nuanom a wɔyɛ Kis mmammarima.)<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>Musi mmammarima baasa no din de:</para>
  <para style="li2" vid="1CH 23:23">Mahli, Eder ne Yeremot.<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="24" style="v" sid="1CH 23:24"/>Yeinom na na wɔn mmusua enti wɔyɛ Lewi asefoɔ, na wɔyɛ wɔn mmusua akuo no ntuanofoɔ a na wɔahwɛ atwerɛ wɔn din. Na ɛsɛ sɛ wɔn mu biara di mfirinhyia aduonu anaa deɛ ɛboro saa, ansa na waso <char style="nd">Awurade</char> fie som. <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>Na Dawid kaa sɛ, “<char style="nd">Awurade</char>, Israel Onyankopɔn ama yɛn asomdwoeɛ, na daa ɔbɛtena Yerusalem. <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>Afei, ɛho nhia sɛ Lewifoɔ no bɛsoa Ahyiaeɛ Ntomadan no ne ne nkuku ne ne nkaka de adi atutena.” <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>Sɛdeɛ Dawid no ara akwankyerɛ a ɛtwa toɔ no seɛ no, ɛsɛ sɛ wɔtwerɛ Lewifoɔ a wɔadi mfirinhyia aduonu ne deɛ ɛboro saa nyinaa din ma ɔsom.<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>Na Lewifoɔ no adwuma ne sɛ, wɔbɛboa asɔfoɔ no a wɔyɛ Aaron asefoɔ no wɔ ɔsom nnwuma a wɔyɛ wɔ <char style="nd">Awurade</char> fie no mu. Afei, wɔbɛhwɛ adihɔ ne adan a ɛwɔ nkyɛnkyɛn no so. Na wɔbɛboa ahodwira nnwuma mu, na wɔasom akwan ahodoɔ so wɔ Onyankopɔn efie. <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>Na wɔhwɛ burodo kronkron a wɔkora no didipono so no, asikyiresiam a wɔayam no muhumuhu a wɔde bɔ aduane afɔdeɛ, taterɛ a mmɔreka nni mu, ɔfam a wɔde ngo dua sradeɛ akye ne burodo afoforɔ a wɔde afrafra no so. Afei, na wɔn asɛdeɛ bi nso ne sɛ, wɔhwɛ nsania ne susudua nso so. <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>Na anɔpa ne anwummerɛ biara nso, wɔgyina <char style="nd">Awurade</char> anim to aseda ne nkamfo nnwom ma no. <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>Wɔboa ɔhyeɛ afɔdeɛ a wɔbɔ ma <char style="nd">Awurade</char> homeda ahodoɔ mu wɔ Ɔbosome Foforɔ Afahyɛ mu ne nnapɔnna nyinaa ho dwumadie mu. Ɛberɛ biara, na Lewifoɔ dodoɔ a ɛfata wɔ hɔ a wɔsom <char style="nd">Awurade</char> anim.<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>Ɛno enti, Lewifoɔ no a na wɔsom wɔ Ahyiaeɛ Ntomadan no mu kɔɔ so somm wɔ Asɔredan no mu. Na wɔde nokorɛdie yɛɛ wɔn som no nnwuma wɔ <char style="nd">Awurade</char> efie.<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">Asɔfoɔ No Nnwuma</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>Sɛdeɛ wɔkyekyɛɛ Aaron asefoɔ a wɔyɛ asɔfoɔ no mu akuakuo ma wɔsomeeɛ no nie: Na Aaron mmammarima no yɛ Nadab, Abihu, Eleasa ne Itamar. <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>Nanso, Nadab ne Abihu wuiɛ a wɔnni mma ansa na wɔn agya rewu. Enti, ɛkaa Eleasa ne Itamar nko ara a na ɛsɛ sɛ wɔyɛ asɔfoɔ. <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>Mmoa a Sadok a na ɔyɛ Eleasa aseni ne Ahimelek a na ɔyɛ Itamar aseni no boaa no enti, Dawid kyekyɛɛ Aaron asefoɔ mu akuakuo sɛdeɛ wɔn dwumadie teɛ. <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>Wɔkyɛɛ Itamar deɛ mu akuo nwɔtwe, ɛfiri sɛ, na Eleasa asefoɔ mu mmusua mpanimfoɔ no dɔɔso. <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>Wɔnam ntontobɔ kronkron so, kyekyɛɛ dwumadie ahodoɔ nyinaa maa akuakuo no, sɛdeɛ ɛrenyɛ nhwɛanimsɛm biara. Ɛfiri sɛ, na mpanimfoɔ bebree a wɔfata sɛ wɔsom Onyankopɔn kronkronbea hɔ a wɔyɛ Eleasa ne Itamar asefoɔ no nso wɔ hɔ.<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>Netanel babarima Semaia a na ɔyɛ Lewini no yɛɛ adwuma sɛ ɔtwerɛfoɔ. Ɔtwerɛɛ din ne nnwuma ahodoɔ wɔ ɔhene no ne ɔsɔfoɔ Sadok ne Abiatar babarima Ahimelek ne asɔfoɔ no ne Lewi mmusua no mpanimfoɔ anim. Eleasa ne Itamar asefoɔ bobɔɔ ntonto sɛdeɛ ɛdidi soɔ yi:<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>Ntonto a ɛdi ɛkan no bɔɔ Yehoiarib.</para>
  <para style="li1" vid="1CH 24:7">Ntonto a ɛtɔ so mmienu no bɔɔ Yedaia.<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>Ntonto a ɛtɔ so mmiɛnsa no bɔɔ Harim.</para>
  <para style="li1" vid="1CH 24:8">Ntonto a ɛtɔ so ɛnan no bɔɔ Seorim.<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>Ntonto a ɛtɔ so enum no bɔɔ Malkia.</para>
  <para style="li1" vid="1CH 24:9">Ntonto a ɛtɔ so nsia no bɔɔ Miyamin.<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>Ntonto a ɛtɔ so nson no bɔɔ Hakos.</para>
  <para style="li1" vid="1CH 24:10">Ntonto a ɛtɔ so nwɔtwe no bɔɔ Abia.<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>Ntonto a ɛtɔ so nkron no bɔɔ Yesua.</para>
  <para style="li1" vid="1CH 24:11">Ntonto a ɛtɔ so edu no bɔɔ Sekania.<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>Ntonto a ɛtɔ so dubaako no bɔɔ Eliasib.</para>
  <para style="li1" vid="1CH 24:12">Ntonto a ɛtɔ so dumienu no bɔɔ Yakim.<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>Ntonto a ɛtɔ so dumiɛnsa no bɔɔ Hupa.</para>
  <para style="li1" vid="1CH 24:13">Ntonto a ɛtɔ so dunan no bɔɔ Yesebeab.<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>Ntonto a ɛtɔ so dunum no bɔɔ Bilga.</para>
  <para style="li1" vid="1CH 24:14">Ntonto a ɛtɔ so dunsia no bɔɔ Imer.<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>Ntonto a ɛtɔ so dunson no bɔɔ Hesir.</para>
  <para style="li1" vid="1CH 24:15">Ntonto a ɛtɔ so dunwɔtwe no bɔɔ Hapises.<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>Ntonto a ɛtɔ so dunkron no bɔɔ Petahia.</para>
  <para style="li1" vid="1CH 24:16">Ntonto a ɛtɔ so aduonu no bɔɔ Yeheskel.<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>Ntonto a ɛtɔ so aduonu baako no bɔɔ Yakin.</para>
  <para style="li1" vid="1CH 24:17">Ntonto a ɛtɔ so aduonu mmienu no bɔɔ Gamul.<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>Ntonto a ɛtɔ so aduonu mmiɛnsa no bɔɔ Delaia.</para>
  <para style="li1" vid="1CH 24:18">Ntonto a ɛtɔ so aduonu ɛnan no bɔɔ Maasia.<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>Ekuo biara dii ne dwuma wɔ <char style="nd">Awurade</char> fie sɛdeɛ wɔn agya Aaron nam <char style="nd">Awurade</char>, Israel Onyankopɔn akwankyerɛ so hyehyɛ maa wɔn no.<verse eid="1CH 24:19"/></para>
  <para style="s1">Lewi Mmusua Mpanimfoɔ</para>
  <para style="li4">
    <verse number="20" style="v" sid="1CH 24:20"/>Yeinom ne mmusua a aka a wɔyɛ Lewi asefoɔ no mpanimfoɔ:</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">Amram asefoɔ ntuanoni ne Subael.</para>
  <para style="li2" vid="1CH 24:20">Subael asefoɔ ntuanoni ne Yehdeia.<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>Rehabia asefoɔ ntuanoni ne Yisia.<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>Yishar asefoɔ ntuanoni ne Selomot.</para>
  <para style="li2" vid="1CH 24:22">Selomot asefoɔ ntuanoni ne Yahat.<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>Hebron asefoɔ ntuanofoɔ ne:</para>
  <para style="li2" vid="1CH 24:23">Yeria; Amaria ne nʼabadiakyire, Yahasiel na ɔtɔ so mmiɛnsa na Yekameam tɔ so ɛnan.<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>Usiel asefoɔ ntuanoni ne Mika.</para>
  <para style="li2" vid="1CH 24:24">Mika asefoɔ ntuanoni ne Samir<verse eid="1CH 24:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25"/>ne Mika nuabarima Yisia.</para>
  <para style="li2" vid="1CH 24:25">Yisia asefoɔ ntuanoni ne Sakaria.<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>Merari asefoɔ ntuanofoɔ ne Mahli ne Musi.</para>
  <para style="li2" vid="1CH 24:26">Yasia asefoɔ ntuanoni ne Beno.<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>Merari asefoɔ a wɔfiri Yasia mu no, ntuanofoɔ no ne:</para>
  <para style="li2" vid="1CH 24:27">Beno, Soham, Sakur ne Ibri.<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>Mahli asefoɔ ntuanoni ne Eleasa a na ɔnni mmammarima no.<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>Kis asefoɔ ntuanoni ne Yerahmeel.<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>Musi asefoɔ ntuanofoɔ ne Mahli, Eder ne Yerimot.</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="li4" vid="1CH 24:30">Yeinom ne Lewi asefoɔ ne sɛdeɛ wɔn mmusua teɛ.<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>Wɔnam ntonto kronkron a wɔbɔɔ wɔ wɔn so na wɔde wɔn nnwuma hyɛɛ wɔn nsa te sɛ Aaron asefoɔ deɛ no, a wɔanhwɛ mfeɛ a wɔadi ne wɔn diberɛ. Wɔdii dwuma no wɔ ɔhene Dawid, Sadok, Ahimelek, asɔfoɔ ne Lewifoɔ mmusua mpanimfoɔ no anim.<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">Nnwontofoɔ No Nnwuma</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>Dawid ne asahene no yiyii mmarima firii Asaf, Heman ne Yedutun mmusua mu sɛ wɔmfa nsankuten, mmɛnta ne kyankyan mmɔ Onyankopɔn asɛm no ho dawuro. Wɔn din ne wɔn nnwuma na ɛdidi soɔ yi:<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>Na Asaf mmammarima no nie:</para>
  <para style="li2" vid="1CH 25:2">Sakur, Yosef, Netania ne Asarela. Na wɔhyɛ wɔn agya Asaf ase. Ɔno na ɔhene hyɛɛ no ma ɔbɔɔ Onyankopɔn asɛm no ho dawuro.<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>Na Yedutun wɔ mmammarima a wɔn nie:</para>
  <para style="li2" vid="1CH 25:3">Gedalia, Seri, Yesaia, Simei, Hasabia ne Matitia. Wɔyɛ baasia a wɔhyɛ wɔn agya Yedutun ase. Ɔno na ɔnam sankuten so de aseda ne nkamfo maa <char style="nd">Awurade</char> de bɔɔ Onyankopɔn asɛm no ho dawuro.<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>Na Heman mmammarima din nie:</para>
  <para style="li2" vid="1CH 25:4">Bukia, Matania, Usiel, Sebuel, Yerimot, Hanania, Hanani, Eliata, Gidalti, Romamti-Eser, Yosbekasa, Maloti, Hotir, ne Mahasiot. <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>Yeinom ne Heman a ɔyɛ ɔhene nkɔmhyɛni no mmammarima. Onyankopɔn domm no mmammarima dunan ne mmammaa baasa.<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>Na saa mmarima yi nyinaa hyɛ wɔn agyanom ase, na wɔnam so too nnwom wɔ <char style="nd">Awurade</char> fie. Wɔn nnwuma ne sɛ wɔbɔ kyankyan, mmɛnta ne nsankuten wɔ Onyankopɔn fie.</para>
  <para style="p" vid="1CH 25:6">Na Asaf, Yedutun ne Heman hyɛ ɔhene no ase. <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>Na wɔatete wɔn ne wɔn abusuafoɔ nyinaa wɔ nnwom a wɔbɔ wɔ <char style="nd">Awurade</char> anim no mu. Na wɔn nyinaa dodoɔ yɛ ahanu aduɔwɔtwe nwɔtwe (288) na wɔn mu biara wɔ nnwontoɔ ho nimdeɛ. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>Wɔnam ntontobɔ kronkron so yiyii nnwomtofoɔ tuatuaa nnwuma ahodoɔ ano a wɔanhwɛ sɛ obi yɛ abɔfra anaa ɔpanin, ɔkyerɛkyerɛfoɔ anaa osuani.<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>Ntonto a ɛdi ɛkan no bɔɔ Yosef a ɔfiri Asaf abusua mu, ɔne ne mmammarima ne nʼabusuafoɔ (12)</para>
  <para style="li1" vid="1CH 25:9">Ntonto a ɛtɔ so mmienu no bɔɔ Gedalia, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>Ntonto a ɛtɔ so mmiɛnsa no bɔɔ Sakur, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>Ntonto a ɛtɔ so ɛnan no bɔɔ Yisri, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>Ntonto a ɛtɔ so enum no bɔɔ Netania, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>Ntonto a ɛtɔ so nsia no bɔɔ Bukia, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>Ntonto a ɛtɔ so nson no bɔɔ Yesarela, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>Ntonto a ɛtɔ so nwɔtwe no bɔɔ Yesaia, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>Ntonto a ɛtɔ so nkron no bɔɔ Matania, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>Ntonto a ɛtɔ so edu no bɔɔ Simei, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>Ntonto a ɛtɔ so dubaako no bɔɔ Asarel, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>Ntonto a ɛtɔ so dumienu no bɔɔ Hasabia, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>Ntonto a ɛtɔ so dumiɛnsa no bɔɔ Subael, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>Ntonto a ɛtɔ so dunan no bɔɔ Matitia, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>Ntonto a ɛtɔ so dunum no bɔɔ Yeremot, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>Ntonto a ɛtɔ so dunsia no bɔɔ Hanania, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>Ntonto a ɛtɔ so dunson no bɔɔ Yosbekasa, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>Ntonto a ɛtɔ so dunwɔtwe no bɔɔ Hanani, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>Ntonto a ɛtɔ so dunkron no bɔɔ Maloti, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>Ntonto a ɛtɔ so aduonu no bɔɔ Eliata, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>Ntonto a ɛtɔ so aduonu baako no bɔɔ Hotir, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>Ntonto a ɛtɔ so aduonu mmienu no bɔɔ Gidalti, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>Ntonto a ɛtɔ so aduonu mmiɛnsa no bɔɔ Mahasiot, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>Ntonto a ɛtɔ so aduonu ɛnan no bɔɔ Romamti-Eser, ɔne ne mmammarima ne nʼabusuafoɔ (12)<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">Apono Ano Ahwɛfoɔ Nnwuma</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 26:1"/>Yeinom ne apono ano ahwɛfoɔ no akuakuo:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="li4" vid="1CH 26:1">Korafoɔ mu no:</para>
  <para style="li1" vid="1CH 26:1">yɛwɔ Kore babarima Meselemia a ɔfiri Asaf abusua mu. <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>Meselemia mmammarima yɛ:</para>
  <para style="li2" vid="1CH 26:2">Sakaria a ɔyɛ abakan, Yediael a ɔtɔ so mmienu,</para>
  <para style="li2" vid="1CH 26:2">Sebadia a ɔtɔ so mmiɛnsa, Yatniel a ɔtɔ so ɛnan.<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>Elam a ɔtɔ so enum, Yehohanan a ɔtɔ so nsia,</para>
  <para style="li2" vid="1CH 26:3">ne Eliehoenai a ɔtɔ so nson.<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>Na Obed-Edom mmammarima nso a wɔyɛ apono ano ahwɛfoɔ yɛ:</para>
  <para style="li2" vid="1CH 26:4">Semaia a ɔyɛ abakan, Yehosabad a ɔtɔ so mmienu,</para>
  <para style="li2" vid="1CH 26:4">Yoa a ɔtɔ so mmiɛnsa, Sakar a ɔtɔ so ɛnan,</para>
  <para style="li2" vid="1CH 26:4">Netanel a ɔtɔ so enum, <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>Amiel a ɔtɔ so nsia,</para>
  <para style="li2" vid="1CH 26:5">Isakar a ɔtɔ so nson, ne Peuletai a ɔtɔ so nwɔtwe.</para>
  <para style="li2" vid="1CH 26:5">Onyankopɔn hyiraa Obed-Edom bebree.<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>Na Obed-Edom babarima Semaia wɔ mmammarima a wɔtumi adeɛ yɛ yie enti, wɔnyaa dibea a ɛkura tumi wɔ abusua no mu. <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>Na wɔn edin ne:</para>
  <para style="li2" vid="1CH 26:7">Otni, Refael, Obed ne Elsabad;</para>
  <para style="li2" vid="1CH 26:7">na wɔn abusuafoɔ Elihu ne Semakia nso yɛ mmɔdemmɔfoɔ.<verse eid="1CH 26:7"/></para>
  <para style="li4">
    <verse number="8" style="v" sid="1CH 26:8"/>Obed-Edom asefoɔ yi nyinaa a wɔn mmammarima ne wɔn nananom a na wɔn nyinaa dodoɔ yɛ aduosia mmienu (62) no yɛ nnipa a, na wɔbɔ wɔn ho mmɔden yie na wɔfata wɔn nnwuma.<verse eid="1CH 26:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 26:9"/>Saa ara nso na na Meselemia mmammarima dunwɔtwe (18) no ne wɔn abusuafoɔ nso bɔ wɔn ho mmɔden yie.<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>Hosa a ɔfiri Merari abusua mu yii Simri a na ɔnyɛ abakan no sɛ ntuanoni, wɔ ne mmammarima mu.<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>Na ne mmammarima no bi ne:</para>
  <para style="li2" vid="1CH 26:11">Hilkia a ɔtɔ so mmienu, Tebalia a ɔtɔ so mmiɛnsa</para>
  <para style="li2" vid="1CH 26:11">ne Sakaria tɔ so ɛnan.</para>
  <para style="li4" vid="1CH 26:11">Na Hosa mmammarima ne nʼabusuafoɔ a wɔsom sɛ apono ano ahwɛfoɔ no nyinaa dodoɔ yɛ dumiɛnsa (13).<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="1CH 26:12"/>Saa apono ano ahwɛfoɔ akuo yi nam wɔn mmusua ntuanofoɔ so somm wɔ <char style="nd">Awurade</char> fie, sɛdeɛ wɔn abusuafoɔ yɛeɛ no. <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>Wɔnam ntontobɔ kronkron so, de ɔwɛn adwuma wɔ apono ahodoɔ ano hyɛɛ mmusua no nsa a wɔnhwɛ mfirinhyia a obi adi, anaa nteteeɛ a wanya soɔ.<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>Wɔde apueeɛ ɛpono ho dwumadie no hyɛɛ Selemia ne ne ekuo nsa.</para>
  <para style="li1" vid="1CH 26:14">Atifi ɛpono ho dwumadie nso, wɔde hyɛɛ ne babarima onyansafoɔ Sakaria nsa.<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>Anafoɔ ɛpono<note caller="+" style="f"><char style="fr" closed="false">26.15 </char><char style="ft" closed="false">Anafoɔ pono. Dawid ne Salomo ahemfie no na ɛwɔ asɔredan no anafoɔ fam. Saa anafoɔ pono no mu na na ɔhene no fa. Saa ɔpono yi anohwɛ dwumadie no yɛ animuonyamhyɛdeɛ ma Obed Edom. (<char style="xt"><ref loc="1CH 26:4-6">26.4-6</ref>; <ref loc="EZK 46:1-10">Hes 46.1-10</ref></char>)</char></note> no, wɔde hyɛɛ Obed-Edom nsa, na wɔmaa ne mmammarima no hwɛɛ adekoradan no so.<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>Wɔmaa Supim ne Hosa hwɛɛ atɔeɛ ɛpono no ne ɛkwan a ɛkɔ asɔredan no mu no so.</para>
  <para style="b" vid="1CH 26:16"/>
  <para style="li4" vid="1CH 26:16">Wɔkyekyɛɛ ɔwɛn nnwuma no pɛpɛɛpɛ maa wɔn.<verse eid="1CH 26:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>Ɛda biara, na wɔma Lewifoɔ baasia kɔ apueeɛ ɛpono no ho,</para>
  <para style="li1" vid="1CH 26:17">baanan kɔ atifi ɛpono no ho,</para>
  <para style="li1" vid="1CH 26:17">baanan nso akɔ anafoɔ ɛpono no ho,</para>
  <para style="li1" vid="1CH 26:17">na baanu baanu akokɔ adekoradan ahodoɔ no biara ho.<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>Ɛda biara, na wɔma baasia kɔ atɔeɛ ɛpono no ho. Baanan kɔ ɛkwan a ɛkɔ asɔredan no mu no so, na baanu nso akɔ adihɔ hɔ.<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="1CH 26:19"/>Yeinom ne apono ano ahwɛfoɔ a wɔfiri Kora ne Merari mmusua mu no nkyekyɛmu.<verse eid="1CH 26:19"/></para>
  <para style="s1">Fotosanfoɔ Ne Adwumayɛfoɔ Nkaeɛ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>Lewifoɔ a wɔaka a na Ahiya da wɔn ano no na na wɔhwɛ Onyankopɔn fie sikakorabea ne adekoradan so.<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>Libni fie a na ɛwɔ Gerson abusua mu no, na Yehieli na na ɔtua wɔn ano. <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>Yehieli mmammarima Setam ne ne nuabarima Yoɛl na na wɔhwɛ <char style="nd">Awurade</char> fie sikakorabea so.<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 26:23"/>Yeinom ne ntuanofoɔ a wɔyɛ Amram, Yishar, Hebron ne Usiel asefoɔ.<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>Amram abusua mu, Sebuel yɛ Mose babarima Gersom aseni. Ɔno na na ɔyɛ ɔpanin a ɔhwɛ sikakorabea no so. <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>Wɔn a wɔnam Elieser so yɛ nʼabusuafoɔ ne Rehabia, Yesaia, Yoram, Sikri ne Selomot.<verse eid="1CH 26:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 26:26"/>Selomot ne nʼabusuafoɔ na na wɔhwɛ sikakorabea a na wɔkora agyapadeɛ a wɔde ama <char style="nd">Awurade</char> no so. Agyapadeɛ no bi ne deɛ Dawid ne mmusua ntuanofoɔ ne asahene ne asraafoɔ mpanimfoɔ de maa <char style="nd">Awurade</char> no. <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>Na saa mmarima yi de wɔn asadeɛ a wɔnyaa no akodie mu no bi baeɛ sɛ wɔmfa nsiesie <char style="nd">Awurade</char> fie. <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>Afei, na Selomot ne nʼabusuafoɔ na wɔhwɛ nneɛma a Samuel a ɔyɛ nkɔmhyɛni, Kis babarima Saulo, Ner babarima Abner ne Seruia babarima Yoab de maa <char style="nd">Awurade</char> no so. Nneɛma nkaeɛ a wɔde maa <char style="nd">Awurade</char> no nyinaa, na ɛhyɛ wɔn nsa.<verse eid="1CH 26:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29"/>Yishar abusua mu na Kenania firi.</para>
  <para style="li2" vid="1CH 26:29">Ɔne ne mmammarima na wɔyii wɔn sɛ ɔman sohwɛfoɔ ne atemmufoɔ wɔ Israelman mu nyinaa.<verse eid="1CH 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30"/>Hebron abusua mu na Hasabia firi. Ɔne nʼabusuafoɔ a wɔyɛ mmɔdemmɔfoɔ a wɔn dodoɔ yɛ apem ahanson na wɔma wɔhwɛɛ Israel nsase a ɛdeda Asubɔnten Yordan atɔeɛ fam no so. Nsɛm a ɛfa <char style="nd">Awurade</char> ho, ne ɔhene a ɔwɔ mpasua no so som ho nyinaa yɛ wɔn asɛdeɛ. <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>Bio, Hebron abusua mu na Yeria firi. Sɛdeɛ awoɔ ntoatoasoɔ nkrataa kyerɛ no, ɔno na na ɔyɛ Hebronfoɔ no ntuanoni.</para>
  <para style="li2" vid="1CH 26:31">(Dawid dii ɔhene no, ne mfeɛ aduanan so, wɔhwehwɛɛ nkrataa mu na wɔhunuu mmarima a wɔbɔ wɔn ho mmɔden wɔ Hebron abusua no mu din wɔ kuro Yaser a ɛwɔ Gilead mu. <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>Na mmarima a wɔbɔ wɔn ho mmɔden mpem mmienu ne ahanson na na wɔwɔ Yeria abusua mu. Ɔhene Dawid ma wɔkɔɔ Asubɔnten Yordan apueeɛ fam, ma wɔkɔhwɛɛ Ruben ne Gad mmusuakuo ne Manase abusuakuo fa no so. Nsɛm a ɛfa Onyankopɔn ho, ne ɔhene som ho nyinaa yɛ wɔn asɛdeɛ.)<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">Asahene Ne Wɔn Akuo</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 27:1"/>Israelfoɔ akuo ahodoɔ no nie—mmusuapanin, asahene ne asraafoɔ mpanimfoɔ a na wɔhwɛ asraafoɔ akuo ahodoɔ so de som ɔhene, a ekuo biara kɔ adwuma bosome baako wɔ afe mu. Na ɛdɔm a wɔwɔ ekuo biara mu nso dodoɔ yɛ mpem aduonu ɛnan (24,000). Wɔn edin na ɛdidi soɔ yi:<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>Sabdiel babarima Yasobeam na na ɔyɛ ekuo a ɛdi ɛkan no sahene, a na wɔkɔ adwuma bosome a ɛdi ɛkan wɔ afe no mu. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000). <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>Na ɔyɛ Peres aseni a na ɔhwɛ asraafoɔ mpanimfoɔ no nyinaa so bosome a ɛdi ɛkan no mu.<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>Dodai a na ɔyɛ Ahoa aseni na na ɔyɛ ekuo a ɛtɔ so mmienu a na wɔkɔ adwuma bosome a ɛtɔ so mmienu mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000), a na Miklot yɛ nʼabadiakyire.<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>Ɔsɔfoɔ Yehoiada babarima Benaia na na ɔyɛ ekuo a ɛtɔ so mmiɛnsa a na wɔkɔ adwuma bosome a ɛtɔ so mmiɛnsa mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000). <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>Saa Benaia yi na na ɔhwɛ Dawid asraafoɔ akunini kuo, a na wɔfrɛ wɔn Akofoɔ Akɛseɛ Aduasa no so. Ne babarima Amisabad na na ɔyɛ nʼabadiakyire.<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>Yoab nuabarima Asahel na na ɔyɛ ekuo a ɛtɔ so ɛnan, a na wɔkɔ adwuma bosome a ɛtɔ so ɛnan mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000). Asahel babarima Sebadia na ɔdii nʼadeɛ.<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>Samhut a ɔyɛ Yisrahini na na ɔyɛ ekuo a ɛtɔ so enum, a na wɔkɔ adwuma bosome a ɛtɔ so enum mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>Ikes babarima Ira a ɔfiri Tekoa no na na ɔyɛ ekuo a ɛtɔ so nsia, a na wɔkɔ adwuma bosome a ɛtɔ so nsia mu no sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>Heles a na ɔyɛ Efraim aseni a ɔfiri Pelon no na na ɔyɛ ekuo a ɛtɔ so nson, a na wɔkɔ adwuma bosome a ɛtɔ so nson mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>Sibekai a na ɔyɛ Sera aseni a ɔfiri Husa no na na ɔyɛ ekuo a ɛtɔ so nwɔtwe, a na wɔkɔ adwuma bosome a ɛtɔ so nwɔtwe mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>Abieser a na ɔfiri Anatot a ɛda Benyamin asase so no na na ɔyɛ ekuo a ɛtɔ so nkron, a na wɔkɔ adwuma bosome a ɛtɔ so nkron mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>Maharai a ɔyɛ Serah aseni a ɔfiri Netofa no na na ɔyɛ ekuo a ɛtɔ so edu, a na wɔkɔ adwuma bosome a ɛtɔ so edu mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>Benaia a ɔfiri Piraton a ɛwɔ Efraim no na na ɔyɛ ekuo a ɛtɔ so dubaako, a na wɔkɔ adwuma bosome a ɛtɔ so dubaako mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>Heldai a ɔyɛ Otniel a ɔfiri Netofa aseni no na na ɔyɛ ekuo a ɛtɔ so dumienu, a na wɔkɔ adwuma bosome a ɛtɔ so dumienu mu no so sahene. Na ne ekuo no akodɔm dodoɔ yɛ mpem aduonu ɛnan (24,000).<verse eid="1CH 27:15"/></para>
  <para style="s1">Mmusuakuo No Ntuanofoɔ</para>
  <para style="li4">
    <verse number="16" style="v" sid="1CH 27:16"/>Mmusuakuo no ne wɔn ntuanofoɔ nie:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">Ruben abusuakuo: Sikri babarima Elieser;</para>
  <para style="li1" vid="1CH 27:16">Simeon abusuakuo: Maaka babarima Sefatia;<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>Lewi abusuakuo: Kemuel babarima Hasabia</para>
  <para style="li1" vid="1CH 27:17">Aaron (asɔfoɔ no) abusuakuo: Sadok;<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>Yuda abusuakuo: Dawid nuabarima Elihu;</para>
  <para style="li1" vid="1CH 27:18">Isakar abusuakuo: Mikael babarima Omri;<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>Sebulon abusuakuo: Obadia babarima Yismaia;</para>
  <para style="li1" vid="1CH 27:19">Naftali abusuakuo: Asriel babarima Yerimot;<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>Efraim abusuakuo: Asasia babarima Hosea;</para>
  <para style="li1" vid="1CH 27:20">Manase (atɔeɛ fam) abusuakuo: Pedaia babarima Yoɛl;<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>Manase (apueeɛ fam) abusuakuo Sakaria babarima Ido;</para>
  <para style="li1" vid="1CH 27:21">Benyamin abusuakuo: Abner babarima Yaasiel;<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>Dan abusuakuo: Yeroham babarima Asarel.</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="li4" vid="1CH 27:22">Yeinom ne Israel mmusuakuo no ne wɔn ntuanofoɔ.<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>Ɛberɛ a Dawid ma wɔkanee nnipa no, wɔankan wɔn a wɔnnii mfeɛ aduonu, ɛfiri sɛ, na <char style="nd">Awurade</char> ahyɛ bɔ sɛ ɔbɛma Israelfoɔ no adɔɔso sɛ ɔsoro nsoromma. <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>Yoab na ɔhyɛɛ nnipakan no ase, nanso wanwie, ɛfiri sɛ, Onyankopɔn bo fuu Israel. Wɔantwerɛ nnipa no nyinaa dodoɔ angu Ɔhene Dawid nkrataa mu.<verse eid="1CH 27:24"/></para>
  <para style="s1">Dawid Ahennie Mu Mpanimfoɔ</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>Adiel babarima Asmawet na na ɔhwɛ ahemfie sikakorabea so.</para>
  <para style="li1" vid="1CH 27:25">Usia babarima Yonatan no na na ɔhwɛ ɔmantam no sikakorabea a ɛwowɔ nkuro, nkuraaseɛ ne aban a ɛwɔ Israel nyinaa so.<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>Kelub babarima Esri na na ɔhwɛ apaafoɔ a na wɔdɔ ɔhene mfuo so.<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>Simei a na ɔfiri Rama na na ɔhwɛ ɔhene bobe mfuo so.</para>
  <para style="li1" vid="1CH 27:27">Sabdi a ɔfiri Sifim na na ɔhwɛ aba a wɔde yɛ nsã ne nsã a wɔayɛ so.<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>Baal-Hanan a ɔfiri Geder no na na ɔhwɛ ɔhene ngo nnua ne akyee nnua a na ɛwɔ Yuda bepɔ ase no so.</para>
  <para style="li1" vid="1CH 27:28">Yoas na na ɔhwɛ ma wɔyɛ ngo.<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>Sitrai a ɔfiri Saron na na ɔhwɛ anantwie a na wɔwɔ Saron ɛserɛ so no so.</para>
  <para style="li1" vid="1CH 27:29">Adlai babarima Safat na na ɔhwɛ anantwie a wɔwɔ bɔnhwa ahodoɔ mu no so.<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>Ismaelni Obil na na ɔhwɛ nyoma so.</para>
  <para style="li1" vid="1CH 27:30">Yehdia a ɔfiri Meronot na na ɔhwɛ mfunumu so.<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>Yasis a ɔfiri Hagar na na ɔhwɛ ɔhene nnwan so.</para>
  <para style="li4" vid="1CH 27:31">Saa mpanimfoɔ yi nyinaa na na wɔhwɛ ɔhene Dawid agyapadeɛ so.<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>Yonatan a na ɔyɛ Dawid wɔfa no yɛɛ ɔfotufoɔ nyansafoɔ maa ɔhene. Na ɔyɛ ɔtwerɛfoɔ a ɔwɔ nhunumu.</para>
  <para style="li1" vid="1CH 27:32">Na Hakmoni babarima Yehiel na na ɔkyerɛ ɔhene mmammarima adeɛ.<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>Ahitofel na na ɔyɛ ɔhene ɔfotufoɔ.</para>
  <para style="li1" vid="1CH 27:33">Na Husai a ɔfiri Arki yɛ ɔhene adamfo.<verse eid="1CH 27:33"/></para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 27:34"/>Benaia babarima Yehoiada na ɔdii Ahitofel adeɛ na Abiatar bɛtoaa adedie no so.</para>
  <para style="li1" vid="1CH 27:34">Yoab na na ɔyɛ Israel akodɔm so sahene.<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">Dawid Akwankyerɛ A Ɔde Maa Salomo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>Dawid frɛɛ ne mpanimfoɔ nyinaa kɔɔ Yerusalem. Saa mpanimfoɔ no ne mmusuakuo no ntuanofoɔ, asahene a wɔdeda akodɔm akuo dumienu no ano, asraafoɔ mpanimfoɔ a wɔaka no, wɔn a wɔhwɛ ɔhene agyapadeɛ ne ne mmoa so, ahemfie nhenkwaa, akofoɔ akɛseɛ ne akofoɔ a wɔaka wɔ ahennie no mu no.<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>Dawid sɔre gyinaa wɔn anim, kasa kyerɛɛ wɔn sɛ, “Me nuanom ne me nkurɔfoɔ, anka mepɛɛ sɛ mɛsi asɔredan a wɔde <char style="nd">Awurade</char> Apam Adaka, Onyankopɔn nan ntiasoɔ no bɛsi afebɔɔ. Meyɛɛ ho ahoboa nyinaa sɛ mede rebɛsi, <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>nanso Onyankopɔn ka kyerɛɛ me sɛ, ‘Ɛnsɛ sɛ wosi asɔredan de hyɛ me din animuonyam, ɛfiri sɛ, woyɛ ɔkofoɔ a woahwie mogya bebree aguo.’<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“Nanso, <char style="nd">Awurade</char>, Israel Onyankopɔn, ayi me wɔ mʼagya abusua mu sɛ, menni ɔhene wɔ Israel so daa. Na wayi Yuda abusuakuo sɛ wɔnni ɔhene na Yuda mmusua mu nso, ɔyii mʼagya abusua. Na mʼagya mma mu no nso, ɛyɛɛ <char style="nd">Awurade</char> fɛ sɛ ɔsii me Israel nyinaa so ɔhene. <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>Na me mmammarima pii a <char style="nd">Awurade</char> de wɔn maa me no mu nso, ɔyii Salomo sɛ ɔnni mʼadeɛ wɔ nʼahennie Israel ahennwa so. <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>Ɔka kyerɛɛ me sɛ, ‘Wo babarima Salomo na ɔbɛsi mʼasɔredan ne nʼadihɔ nyinaa, ɛfiri sɛ mayi no sɛ me babarima na mɛyɛ nʼagya. <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>Na sɛ ɔkɔ so di mʼahyɛdeɛ ne me mmara so, sɛdeɛ ɔyɛ seesei yi a, mɛma nʼahennie atim afebɔɔ.’<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“Enti, seesei a Onyankopɔn yɛ yɛn danseni yi, menam wo so de saa asodie yi ma Israel nyinaa a wɔyɛ <char style="nd">Awurade</char> manfoɔ no: Monhwɛ yie na monni <char style="nd">Awurade</char>, mo Onyankopɔn, ahyɛdeɛ nyinaa so sɛdeɛ mobɛfa saa asase pa yi, na moagya ama mo asefoɔ sɛ wɔn agyapadeɛ daa.<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“Afei, me ba Salomo, hunu wʼagyanom Onyankopɔn. Fa wʼakoma ne wʼadwene nyinaa sɔre no, na som no. Ɛfiri sɛ, Awurade hunu akoma biara mu, enti ɔhunu na ɔnim emu nhyehyɛeɛ ne nsusuiɛ biara. Sɛ wohwehwɛ no a, wobɛhunu no. Na sɛ wopo no a, ɔbɛpo wo afebɔɔ. <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>Enti, fa no asɛnhia. Awurade ayi wo sɛ si asɔredan ma no, sɛ ne kronkronbea. Yɛ den, na di dwuma no.”<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>Afei Dawid de asɔredan no ho mfoni a sikakorabea, ɔsoro adan, emu adan ne emu kronkronbea a Apam Adaka no mfofareɛm a ɛhɔ yɛ mpatabea, faako a wɔde Adaka no bɛsi maa Salomo. <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>Nhyehyɛeɛ biara a Honhom no de maa Dawid a ɛfa <char style="nd">Awurade</char> Asɔredan adihɔ ho, akyire adan, Onyankopɔn Asɔredan no mu sikakorabea ne akyɛdeɛ a wɔde ama Onyankopɔn no, ɔkyerɛɛ Salomo. <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>Saa ara na Dawid kyerɛɛ Salomo dwuma a asɔfoɔ ne Lewifoɔ nkyekyɛmu ahodoɔ no nyɛ wɔ <char style="nd">Awurade</char> Asɔredan no mu. Na ɔkyerɛkyerɛɛ nneɛma pɔtee a ɛwɔ <char style="nd">Awurade</char> Asɔredan no mu a wɔde sɔre <char style="nd">Awurade</char> ne deɛ wɔde bɔ afɔdeɛ. <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>Dawid kyerɛɛ sikakɔkɔɔ ne dwetɛ dodoɔ a wɔmfa nyɛ nneɛma a ɛho bɛhia. <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>Ɔkyerɛɛ Salomo sikakɔkɔɔ dodoɔ a ɛho bɛhia ama sikakɔkɔɔ nkaneadua no ne nkanea no, ɛnna ɔkyerɛɛ dwetɛ dodoɔ a ɛho bɛhia ama dwetɛ nkaneadua no ne nkanea no yɛ, ne ɛkwan korɔ a wɔbɛfa so de emu biara adi dwuma no so. <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>Ɔkyerɛɛ sikakɔkɔɔ dodoɔ a wɔmfa nyɛ ɛpono a wɔde Hyiadan mu Burodo no bɛto so ɛnna ɔkyerɛɛ dwetɛ dodoɔ a wɔmfa nyɛ apono a ɛka ho no. <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>Dawid sane kyerɛɛ sikakɔkɔɔ dodoɔ a wɔmfa nyɛ ɛnam darewa a wɔde bɛsosɔ afɔrebɔ ɛnam mu, atam, sukuruwa ne nyowaa ne dwetɛ dodoɔ a wɔmfa nyɛ ayowaa biara. <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>Deɛ ɔde wieeɛ ne sɛ, ɔkyerɛɛ sikakɔkɔɔ a wɔabere ho dodoɔ a wɔde bɛyɛ nnuhwam afɔrebukyia no ne sikakɔkɔɔ Kerubim a nʼataban atrɛ wɔ <char style="nd">Awurade</char> Adaka no so.<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>Dawid ka kyerɛɛ Salomo sɛ, “Saa mfoni yi nyinaa, <char style="nd">Awurade</char> nsa na ɔde twerɛ maa me.”<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>Afei, Dawid toaa so sɛ, “Yɛ den na ma wo bo nyɛ duru na yɛ adwuma no. Nsuro na mma dwumadie no kɛseyɛ ntu wo bo, ɛfiri sɛ, <char style="nd">Awurade</char> Onyankopɔn, me Onyankopɔn, ka wo ho. Ɔrenni wo hwammɔ na ɔrennya wo. Ɔbɛhwɛ sɛ dwumadie biara a ɛfa <char style="nd">Awurade</char> Asɔredan no sie ho no, wɔbɛwie no pɛpɛɛpɛ. <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>Asɔfoɔ ne Lewifoɔ akuo no bɛsom wɔ Onyankopɔn Asɔredan no mu. Wɔn a aka a wɔwɔ nimdeɛ ahodoɔ no nyinaa bɛyi wɔn yam aboa, na ntuanofoɔ ne ɔman no nyinaa nso bɛyɛ biribiara a wobɛka.”<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">Asɔredan No Sie Ho Akyɛdeɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>Afei, Ɔhene Dawid danee nʼani kyerɛɛ ɔmanfoɔ no kaa sɛ, “Me babarima Salomo a Onyankopɔn ayi no sɛ ɔnni Israel so sɛ ɔhene foforɔ no da so yɛ abɔfra a ɔnni suahunu biara. Adwuma a ɛda nʼanim no so, na Asɔredan a ɔbɛsi no nyɛ ɛdan hunu bi. Ɛyɛ <char style="nd">Awurade</char> Onyankopɔn no ankasa dea. <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>Mede deɛ metumi yɛ biara adi dwuma, maboaboa deɛ mɛtumi anya nyinaa ano ama me Onyankopɔn Asɔredan no sie. Seesei, sikakɔkɔɔ, dwetɛ, kɔbere mfrafraeɛ, nnadeɛ ne nnua ne apopobibirieboɔ ne aboɔdemmoɔ, aboɔden agudeɛ ne abopa ne abohemaa ahodoɔ nyinaa pii wɔ hɔ. <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>Na ɛsiane me ho a mede ama me Onyankopɔn Asɔredan no enti, mede mʼankasa sikakɔkɔɔ ne dwetɛ bɛboa ɛdan no sie. Yeinom bɛka adansie no ho nneɛma a maboaboa ano, ama asɔredan kronkron no ho. <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>Mama Ofir sikakɔkɔɔ a ɛboro tɔno 112 ne dwetɛ a wɔahoa ho tɔno 262 a wɔde bɛgu adan no afasuo anim, <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>ne sikakɔkɔɔ ne dwetɛ nnwuma a aka a adwumfoɔ no bɛyɛ no. Afei, hwan na ɔbɛyi ne yam de nʼayɛyɛdeɛ ama <char style="nd">Awurade</char> ɛnnɛ?”<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>Na abusua ntuanofoɔ, Israel mmusuakuo ntuanofoɔ, asahene ne asraafoɔ mpanimfoɔ ne ɔhene adwumayɛfoɔ nyinaa firii ɔpɛ pa mu maeɛ. <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>Wɔmaa sikakɔkɔɔ bɛyɛ tɔno 188, sika ankasa ɔpedu, ɛnna dwetɛ bɛyɛ tɔno 375, kɔbere mfrafraeɛ bɛyɛ tɔno 675 ne nnadeɛ bɛyɛ tɔno 3,750, de boaa Asɔredan no sie. <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>Wɔmaa aboɔdemmoɔ bebree a wɔkɔkoraa no wɔ sikakorabea a ɛwɔ <char style="nd">Awurade</char> fie maa Yehiel a ɔyɛ Gerson aseni hwɛɛ so. <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>Nnipa no ani gyee ɔma no ho, ɛfiri sɛ, wɔfiri ɔpɛ pa ne akoma pa mu na wɔyiyi maa <char style="nd">Awurade</char>, na Ɔhene Dawid ani gyee yie.<verse eid="1CH 29:9"/></para>
  <para style="s1">Dawid Kamfo <char style="nd">Awurade</char></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>Na ɔhene Dawid kamfoo <char style="nd">Awurade</char> wɔ nnipa no nyinaa anim sɛ,</para>
  <para style="q1" vid="1CH 29:10">“Ao <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="1CH 29:10">yɛn agya Israel Onyankopɔn,</para>
  <para style="q2" vid="1CH 29:10">ayɛyie nka wo daa nyinaa.<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>Kɛseyɛ, ahoɔden, animuonyam,</para>
  <para style="q2" vid="1CH 29:11">nkonimdie ne tumi yɛ wo dea Ao <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="1CH 29:11">Biribiara a ɛwɔ ɔsoro ne asase so yɛ wo dea,</para>
  <para style="q1" vid="1CH 29:11">Ao <char style="nd">Awurade</char>, na ahennie yi nso wɔ wo.</para>
  <para style="q2" vid="1CH 29:11">Yɛma wo so sɛ wone adeɛ nyinaa so otumfoɔ.<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>Ahonya ne animuonyam firi wo nko ara,</para>
  <para style="q2" vid="1CH 29:12">ɛfiri sɛ, woyɛ adeɛ nyinaa sodifoɔ.</para>
  <para style="q1" vid="1CH 29:12">Tumi ne ahoɔden nyinaa wɔ wo nsam</para>
  <para style="q2" vid="1CH 29:12">na wopɛ mu na wofiri ma nnipa yɛ kɛseɛ na wɔnya ahoɔden.<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>Ao, yɛn Onyankopɔn, yɛda wo ase,</para>
  <para style="q2" vid="1CH 29:13">na yɛkamfo wo din kronkron no.<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“Na me ne hwan na me nkurɔfoɔ ne nnipa bɛn a yɛtumi kyɛ wo biribi? Biribiara a yɛwɔ no firi wo nkyɛn, na deɛ yɛde ma wo no yɛ deɛ wode ama yɛn dada. <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>Yɛwɔ ha mmerɛ tiawa bi sɛ nsrahwɛfoɔ ne ahɔhoɔ wɔ asase a yɛn agyanom dii ɛkan wɔ so no so. Yɛn nna wɔ asase so te sɛ sunsumma a ɛtwam kɔ ntɛm so a wɔnhunu bio. <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>Ao <char style="nd">Awurade</char>, yɛn Onyankopɔn, saa nneɛma a yɛaboaboa ano de rebɛsi asɔredan de ahyɛ wo din kronkron animuonyam yi mpo firi wo nkyɛn! Ne nyinaa yɛ wo dea. <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>Me Onyankopɔn, menim sɛ wohwehwɛ yɛn akoma mu, na sɛ wohunu nokorɛdie wɔ mu a, wʼani gye. Wonim sɛ mede adwene pa na ɛyɛɛ yeinom nyinaa, na mahwɛ ahunu sɛdeɛ wo nkurɔfoɔ firi akoma pa ne anigyeɛ mu de wɔn akyɛdeɛ aba. <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>Ao, <char style="nd">Awurade</char>, yɛn agyanom Abraham, Isak ne Israel Onyankopɔn, ma wo nkurɔfoɔ nyɛ ɔsetie mma wo daa. Mma ɔdɔ a wɔde dɔ wo no nsesa. <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>Ma me babarima Salomo akoma nyinaa mu ɔpɛ pa, na ɔnni wʼahyɛdeɛ, wo mmara ne wo nkyerɛkyerɛ so, na ɔnsi saa Asɔredan yi a mayɛ ho ahoboa nyinaa yi.”<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>Afei, Dawid ka kyerɛɛ ɔmanfoɔ no nyinaa sɛ, “Monkamfo <char style="nd">Awurade</char>, mo Onyankopɔn!” Na ɔmanfoɔ no nyinaa kamfoo <char style="nd">Awurade</char>, wɔn agyanom Onyankopɔn, na wɔkoto buu nkotodwe wɔ <char style="nd">Awurade</char> ne ɔhene no anim.<verse eid="1CH 29:20"/></para>
  <para style="s1">Wɔsi Salomo Ɔhene</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>Adeɛ kyeeɛ no, wɔde anantwinini apem, nnwennini apem ne nnwanmmaa anini apem bɛbɔɔ ɔhyeɛ afɔdeɛ maa <char style="nd">Awurade</char>. Wɔsane gyinaa Israel ananmu, de ɔnom afɔrebɔdeɛ pii ne afɔrebɔdeɛ ahodoɔ baeɛ. <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>Wɔde ahosɛpɛ didi nomee da no wɔ <char style="nd">Awurade</char> anim.</para>
  <para style="p" vid="1CH 29:22">Na bio, wɔhyɛɛ Dawid babarima Salomo ahenkyɛ sɛ wɔn ɔhene foforɔ. Wɔsraa no ngo wɔ <char style="nd">Awurade</char> anim sɛ wɔn ntuanoni, na wɔsraa Sadok nso ngo sɛ wɔn ɔsɔfoɔ. <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>Na Salomo tenaa <char style="nd">Awurade</char> ahennwa no so sɛ nʼagya Dawid ɔnanmusini, na ɔkɔɔ so yie, na Israel nyinaa tiee no. <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>Adehyeɛ mpanimfoɔ nyinaa, asahene ne Dawid mmammarima nyinaa suae kyerɛɛ ɔhene Salomo.<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>Na <char style="nd">Awurade</char> pagyaa Salomo maa Israelman no maa no nidie nwanwasoɔ, na ɔmaa Salomo ahonya ne animuonyam sene nʼagya.<verse eid="1CH 29:25"/></para>
  <para style="s1">Dawid Owuo</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>Enti, Yisai babarima Dawid dii Israel nyinaa so ɔhene. <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>Ɔdii ɔhene wɔ Israel mfeɛ aduanan a ne nkyerɛmu ne sɛ, ɔtenaa Hebron mfeɛ nson dii adeɛ, na mfeɛ aduasa mmiɛnsa nso, ɔtenaa Yerusalem. <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>Ɔtenaa ase kyɛree, nyinii yie, nyaa ahodeɛ ne animuonyam ansa na ɔrewu. Na ne babarima Salomo dii nʼadeɛ sɛ ɔhene. <verse eid="1CH 29:28"/><verse number="29" style="v" sid="1CH 29:29"/>Ɛfiri Ɔhene Dawid adedie ahyɛaseɛ de kɔsi nʼawieeɛ mu nsɛm nyinaa, wɔatwerɛ agu ɔdehunufoɔ Samuel abakɔsɛm nwoma, odiyifoɔ Natan abakɔsɛm nwoma ne ɔdehunufoɔ Gad abakɔsɛm nwoma mu. <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>Nʼadedie mu akokoɔdurusɛm ne biribiara a ɛbaa ne so, Israel ne ahennie ahodoɔ a atwa ne ho ahyia nyinaa nso yɛ nsɛm a wɔatwerɛ.<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
