<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Nnwom Mu Dwom</para>
  <para style="toc1">Nnwom Mu Dwom</para>
  <para style="toc2">Nnwom Mu Dwom</para>
  <para style="toc3">Nmd</para>
  <para style="mt1">Nnwom Mu Dwom</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>Salomo nnwom mu dwom.<verse eid="SNG 1:1"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>Ma ɔmfa nʼano mfeano no mfe mʼano,</para>
  <para style="q2" vid="SNG 1:2">ɛfiri sɛ wo dɔ no yɛ ahomeka sene bobesa.<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>Wʼaduhwam yi hwa a ɛyɛ ahomeka</para>
  <para style="q2" vid="SNG 1:3">wo din te sɛ aduhwam a wɔahwie.</para>
  <para style="q2" vid="SNG 1:3">Na ɛnyɛ nwanwa sɛ mmabaawa no dɔ woɔ!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>Fa me kɔ, ma yɛnyɛ ntɛm!</para>
  <para style="q2" vid="SNG 1:4">Ma ɔhene mfa me nkɔ ne piam.</para>
  <para style="sp" vid="SNG 1:4">Nnamfonom</para>
  <para style="q1" vid="SNG 1:4">Yɛbɛdi ahurisie na yɛn ani agye wo ho.</para>
  <para style="q2" vid="SNG 1:4">Yɛbɛkamfo wo dɔ asene bobesa.</para>
  <para style="sp" vid="SNG 1:4">Ababaawa:</para>
  <para style="q1" vid="SNG 1:4">Sɛ wɔkamfo wo a, na ne kwan so ara ne no!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>Mebiri deɛ, nanso me ho yɛ fɛ,</para>
  <para style="q2" vid="SNG 1:5">Ao, Yerusalem mmammaa,</para>
  <para style="q1" vid="SNG 1:5">mobiri te sɛ Kedar ntomadan,</para>
  <para style="q2" vid="SNG 1:5">te sɛ, Salomo ntomadan mu ntwamutam!<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>Nhwɛ me haa sɛ mebirie enti,</para>
  <para style="q2" vid="SNG 1:6">ɛfiri sɛ awia na ayɛ me saa.</para>
  <para style="q1" vid="SNG 1:6">Memaa mmammarima bo fuu me</para>
  <para style="q2" vid="SNG 1:6">enti wɔmaa me kɔhwɛɛ bobe nturo so;</para>
  <para style="q2" vid="SNG 1:6">na amma manhwɛ mʼankasa me bobe turo.<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>Kyerɛ me me dɔfoɔ,</para>
  <para style="q2" vid="SNG 1:7">faako a wode wo nnwankuo kɔ adidi</para>
  <para style="q2" vid="SNG 1:7">na owigyinaeɛ nso faako a woma wo nnwan home.</para>
  <para style="q1" vid="SNG 1:7">Adɛn enti na ɛsɛ sɛ meyɛ sɛ ɔbaa a wakata nʼanim</para>
  <para style="q2" vid="SNG 1:7">wɔ wo nnamfonom nnwankuo ho?<verse eid="SNG 1:7"/></para>
  <para style="sp">Nnamfonom</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>Sɛ wonnim a, mmaa ahoɔfɛfoɔ pa ara no,</para>
  <para style="q2" vid="SNG 1:8">fa ɛkwan a nnwan fa soɔ so</para>
  <para style="q1" vid="SNG 1:8">na fa wo mpapo mma kɔ adidi</para>
  <para style="q2" vid="SNG 1:8">wɔ nnwanhwɛfoɔ no ntomadan ho.<verse eid="SNG 1:8"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>Me dɔfoɔ, mede wo toto pɔnkɔ bereɛ</para>
  <para style="q2" vid="SNG 1:9">a wɔde ahoma asa no wɔ Farao nteaseɛnam baako ho.<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>Nsomuadeɛ ama wʼafono ho ayɛ fɛ,</para>
  <para style="q2" vid="SNG 1:10">na abohemaa a woasina agu wo kɔn mu no fata wo.<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>Yɛbɛyɛ sikakɔkɔɔ nsomuadeɛ</para>
  <para style="q2" vid="SNG 1:11">a wɔde dwetɛ asisi mu ama wo.<verse eid="SNG 1:11"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>Ɛberɛ a ɔhene te nʼadidi ɛpono ho no,</para>
  <para style="q2" vid="SNG 1:12">nʼaduhwam hwa no gyee hɔ.<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>Me dɔfoɔ ayɛ me sɛ kurobo<note caller="+" style="f"><char style="fr" closed="false">1.13 </char><char style="ft" closed="false">Krobo yɛ aduhwam bi a wɔnya firi “balsam” dua a ebi wɔ Etiopia, Ntam Po ne India. Nnipa de yɛ wɔn ho ma wɔn ho yɛ hwam.</char></note> toa</para>
  <para style="q2" vid="SNG 1:13">a ɛda me nufu ntam.<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>Me dɔfoɔ ayɛ me sɛ nhwiren boa a ayɛ frɔmm</para>
  <para style="q2" vid="SNG 1:14">wɔ En-Gedi<note caller="+" style="f"><char style="fr" closed="false">1.14 </char><char style="ft" closed="false">En-Gedi yɛ kwaeɛ a ɛwɔ ɛserɛ so wɔ Nkyene Po atɔeɛ fam a afifideɛ a ɛyɛ hwam bebree wɔ.</char></note> bobe turo mu.<verse eid="SNG 1:14"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>Me dɔfoɔ, wo ho yɛ fɛ!</para>
  <para style="q2" vid="SNG 1:15">Ao, ahoɔfɛ nie</para>
  <para style="q2" vid="SNG 1:15">wʼaniwa aba te sɛ aborɔnoma.<verse eid="SNG 1:15"/></para>
  <para style="sp">Ababaawa</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>Me dɔfoɔ, wo ho yɛ fɛ!</para>
  <para style="q2" vid="SNG 1:16">Ao, ahoɔfɛ nie</para>
  <para style="q2" vid="SNG 1:16">yɛn mpa so yɛ akɔnɔakɔnɔ.<verse eid="SNG 1:16"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>Yɛn fie mpunan yɛ ntweneduro;</para>
  <para style="q2" vid="SNG 1:17">yɛn nsamsoɔ yɛ pepeaa.<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>Meyɛ Saron nhwiren<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false">Yɛhunu Saron nhwiren wɔ Karmel mpoano anafoɔ fam.</char></note></para>
  <para style="q2" vid="SNG 2:1">ne bɔnhwa mu sukooko.<verse eid="SNG 2:1"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>Sɛdeɛ sukooko a ɛwɔ nkasɛɛ mu teɛ no</para>
  <para style="q2" vid="SNG 2:2">saa ara na me dɔfoɔ te wɔ mmabaawa mu.<verse eid="SNG 2:2"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>Sɛdeɛ aprɛ teɛ wɔ kwaeɛ mu nnua mu no</para>
  <para style="q2" vid="SNG 2:3">saa ara na me dɔfoɔ teɛ wɔ mmaranteɛ mu.</para>
  <para style="q1" vid="SNG 2:3">Sɛ metena ne nwunu mu a, menya ahomeka</para>
  <para style="q2" vid="SNG 2:3">na nʼaba nso yɛ mʼanom dɛ.<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>Ɔde me akɔ apontoɔ ase,</para>
  <para style="q2" vid="SNG 2:4">na mʼahyɛnsodeɛ yɛ ɔdɔ.<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>Momma me bobe aba na menya ahoɔden,</para>
  <para style="q2" vid="SNG 2:5">momma me aprɛ na ɛnnwodwo me,</para>
  <para style="q2" vid="SNG 2:5">ɛfiri sɛ ɔdɔ ama matɔ baha.<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>Ne nsa benkum da mʼatikɔ,</para>
  <para style="q2" vid="SNG 2:6">na ne nsa nifa aka me afam ne bo.<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>Yerusalem mmammaa, mehyɛ mo sɛ,</para>
  <para style="q2" vid="SNG 2:7">Momfa wiram atwewa ne ɔforoteɛ nka ntam sɛ</para>
  <para style="q1" vid="SNG 2:7">morennyane, na morenhwanyane ɔdɔ mu</para>
  <para style="q2" vid="SNG 2:7">kɔsi ɛberɛ a ɛsɛ mu.<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>Tie! Me dɔfoɔ!</para>
  <para style="q2" vid="SNG 2:8">Hwɛ! Ɔno na ɔreba no,</para>
  <para style="q1" vid="SNG 2:8">ɔrehurihuri wɔ mmepɔ no so</para>
  <para style="q2" vid="SNG 2:8">na ɔbɔ pentenkwa wɔ nkokoɔ no so.<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>Me dɔfoɔ te sɛ ɔtwe anaa ɔforoteɛ.</para>
  <para style="q2" vid="SNG 2:9">Hwɛ! Ɔgyina yɛn ɔfasuo akyi,</para>
  <para style="q1" vid="SNG 2:9">ɔhwɛ mpomma no mu,</para>
  <para style="q2" vid="SNG 2:9">wagyene nʼani hwɛ ntokua no mu.<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>Me dɔfoɔ kasa kyerɛɛ me sɛ,</para>
  <para style="q2" vid="SNG 2:10">“Sɔre, me dɔfoɔ ne mʼahoɔfɛ</para>
  <para style="q2" vid="SNG 2:10">na bra me nkyɛn.<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>Hwɛ! Awɔberɛ atwam;</para>
  <para style="q2" vid="SNG 2:11">na osutɔ atwam kɔ.<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>Nhwiren afifiri asase ani:</para>
  <para style="q2" vid="SNG 2:12">nnwontoɔ berɛ aso.</para>
  <para style="q1" vid="SNG 2:12">Wɔte mmorɔnoma su</para>
  <para style="q2" vid="SNG 2:12">wɔ yɛn asase so.<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>Borɔdɔma agu nhyerɛnne;</para>
  <para style="q2" vid="SNG 2:13">na bobe hwa agye baabiara.</para>
  <para style="q1" vid="SNG 2:13">Sɔre bra, me dɔfoɔ;</para>
  <para style="q2" vid="SNG 2:13">mʼahoɔfɛ bra me nkyɛn.”<verse eid="SNG 2:13"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>Mʼaborɔnoma a wohyɛ abotan ntokuro mu</para>
  <para style="q2" vid="SNG 2:14">ahinta wɔ mmepɔ so,</para>
  <para style="q1" vid="SNG 2:14">ma me nhunu wʼanim;</para>
  <para style="q2" vid="SNG 2:14">ma mente wo nne;</para>
  <para style="q1" vid="SNG 2:14">wo nne yɛ dɛ,</para>
  <para style="q2" vid="SNG 2:14">na wʼanim yɛ fɛ.<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>Monkyekyere sakraman no mma yɛn,</para>
  <para style="q2" vid="SNG 2:15">sakraman nketewa no</para>
  <para style="q1" vid="SNG 2:15">a wɔsɛe bobe nturo,</para>
  <para style="q2" vid="SNG 2:15">yɛn bobe nturo a ayɛ frɔmm no.<verse eid="SNG 2:15"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>Me dɔfoɔ yɛ me dea, na mewɔ no;</para>
  <para style="q2" vid="SNG 2:16">ɔhwehwɛ sukooko no mu.<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>Ɛnkɔsi sɛ adeɛ bɛkye</para>
  <para style="q2" vid="SNG 2:17">na sunsumma bɛsene akɔ no,</para>
  <para style="q1" vid="SNG 2:17">dane wo ho me dɔfoɔ,</para>
  <para style="q2" vid="SNG 2:17">na yɛ sɛ ɔtwewa</para>
  <para style="q1" vid="SNG 2:17">anaa ɔforoteɛ a</para>
  <para style="q2" vid="SNG 2:17">ɔwɔ nkokoɔ mmɔnkyi mmɔnka no so.<verse eid="SNG 2:17"/></para>
  <para style="b"/>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>Anadwo mu nyinaa, wɔ me mpa so</para>
  <para style="q2" vid="SNG 3:1">mehwehwɛɛ deɛ mʼakoma da no so;</para>
  <para style="q2" vid="SNG 3:1">mehwehwɛɛ no, nanso manhunu no.<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>Mɛsɔre afei na makɔ kyinkyini kuropɔn no mu,</para>
  <para style="q2" vid="SNG 3:2">ne mmɔntene so ne nʼadwabirem;</para>
  <para style="q1" vid="SNG 3:2">na mahwehwɛ deɛ mʼakoma da no so.</para>
  <para style="q2" vid="SNG 3:2">Enti mehwehwɛɛ no nanso manhunu no.<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>Awɛmfoɔ no hunuu me</para>
  <para style="q2" vid="SNG 3:3">ɛberɛ a wɔrebɔ aprɔ wɔ kuropɔn no mu.</para>
  <para style="q2" vid="SNG 3:3">“Moahunu deɛ mʼakoma da no so no anaa?”<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>Mereyɛ atwa wɔn ho pɛ</para>
  <para style="q2" vid="SNG 3:4">na mehunuu deɛ mʼakoma da no so no.</para>
  <para style="q1" vid="SNG 3:4">Mesɔɔ ne nsa sɛ meremma no nkɔ</para>
  <para style="q2" vid="SNG 3:4">kɔsii sɛ mede no baa me maame fie,</para>
  <para style="q2" vid="SNG 3:4">de no kɔɔ deɛ ɔnyinsɛnee me dan mu.<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>Yerusalem mmammaa mehyɛ mo sɛ,</para>
  <para style="q2" vid="SNG 3:5">Momfa wiram atwewa ne ɔforoteɛ nsuae sɛ</para>
  <para style="q1" vid="SNG 3:5">morennyane na morenhwanyane ɔdɔ mu</para>
  <para style="q2" vid="SNG 3:5">kɔsi ɛberɛ a ɛsɛ mu.<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>Hwan na ɔfiri ɛserɛ so reba</para>
  <para style="q2" vid="SNG 3:6">te sɛ wisie kumɔnn a</para>
  <para style="q1" vid="SNG 3:6">ɛfiri kurobo, aduhwam</para>
  <para style="q2" vid="SNG 3:6">ne adwadifoɔ pɛprɛ ahodoɔ mu, atutu ne ho yi?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>Monhwɛ, ɛyɛ Salomo teaseɛnam a</para>
  <para style="q2" vid="SNG 3:7">akofoɔ aduosia bɔ no kyidɔm;</para>
  <para style="q2" vid="SNG 3:7">adeɛ a ɛwɔ animuonyam pa ara wɔ Israel,<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>Wɔn nyinaa bobɔ akofena,</para>
  <para style="q2" vid="SNG 3:8">wɔn nyinaa wɔ akodie ho nyansa.</para>
  <para style="q1" vid="SNG 3:8">Wɔn akofena bobɔ wɔn nkyɛn mu,</para>
  <para style="q2" vid="SNG 3:8">na obiara asiesie ne ho ama deɛ ɛbɛsi anadwo a ɛyɛ hu biara.<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>Ɔhene Salomo yɛɛ teaseɛnam no maa ne ho;</para>
  <para style="q2" vid="SNG 3:9">ɔde Lebanon nnua na ɛyɛeɛ.<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>Ɔde dwetɛ na ɛyɛɛ nʼadum,</para>
  <para style="q2" vid="SNG 3:10">ɔde sikakɔkɔɔ na ɛyɛɛ ne nnyinasoɔ.</para>
  <para style="q1" vid="SNG 3:10">Wɔde beredum ntoma na ɛduraa emu nkonnwa ho.</para>
  <para style="q2" vid="SNG 3:10">Emu nsiesie yɛ ahomeka</para>
  <para style="q1" vid="SNG 3:10">na Yerusalem mmammaa na wɔyɛeɛ. <verse eid="SNG 3:10"/><verse number="11" style="v" sid="SNG 3:11"/>Momfiri adi, mo Sion mmammaa,</para>
  <para style="q2" vid="SNG 3:11">mommɛhwɛ ɔhene Salomo sɛ ɔhyɛ ahenkyɛ</para>
  <para style="q1" vid="SNG 3:11">deɛ ne maame de hyɛɛ no nʼayeforɔhyia da no,</para>
  <para style="q2" vid="SNG 3:11">da a ɔdii ahurisie nʼakoma mu no.<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>Wo ho yɛ fɛ, me dɔfoɔ!</para>
  <para style="q2" vid="SNG 4:1">Ao, wo ho yɛ fɛ!</para>
  <para style="q2" vid="SNG 4:1">Wʼaniwa a ɛhyehyɛ wo nkatanimu mu no te sɛ aborɔnoma.</para>
  <para style="q1" vid="SNG 4:1">Wo nwi te sɛ mpapokuo a</para>
  <para style="q2" vid="SNG 4:1">wɔresiane Gilead Bepɔ.<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>Wo se te sɛ nnwankuo a wɔatwitwa wɔn ho nwi foforɔ,</para>
  <para style="q2" vid="SNG 4:2">a wɔfiri adwareɛ.</para>
  <para style="q1" vid="SNG 4:2">Wɔnam mmienu mmienu</para>
  <para style="q2" vid="SNG 4:2">na wɔn mu biara nyɛ ankonam.<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>Wʼanofafa te sɛ koogyan ahoma;</para>
  <para style="q2" vid="SNG 4:3">wʼano yɛ fɛ.</para>
  <para style="q1" vid="SNG 4:3">Wʼasontorɔ mu a ɛhyɛ wo nkatanimu mu</para>
  <para style="q2" vid="SNG 4:3">te sɛ ateaa aduaba fa.<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>Wo kɔn te sɛ Dawid abantenten,</para>
  <para style="q2" vid="SNG 4:4">a wɔasi no fɛɛfɛ;</para>
  <para style="q1" vid="SNG 4:4">na akokyɛm apem sensɛn ho,</para>
  <para style="q2" vid="SNG 4:4">a ne nyinaa yɛ akofoɔ kyɛm.<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>Wo nufu mmienu te sɛ atwe mma mmienu,</para>
  <para style="q2" vid="SNG 4:5">atwe mma ntafoɔ a</para>
  <para style="q2" vid="SNG 4:5">wɔdidi wɔ sukooko mu.<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>Ɛnkɔ si sɛ adeɛ bɛkye,</para>
  <para style="q2" vid="SNG 4:6">ama sunsum adwane no,</para>
  <para style="q1" vid="SNG 4:6">mɛkɔ kurobo bepɔ</para>
  <para style="q2" vid="SNG 4:6">ne aduhwam nkokoɔ no so.<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>Me dɔfoɔ, wo ho yɛ fɛ papa;</para>
  <para style="q2" vid="SNG 4:7">wo ho nni ɛdɛm biara.<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>Ma yɛn mfiri Lebanon, mʼayeforɔ,</para>
  <para style="q2" vid="SNG 4:8">wo ne me mfiri Lebanon nkɔ.</para>
  <para style="q1" vid="SNG 4:8">Siane firi Amana atifi bra,</para>
  <para style="q2" vid="SNG 4:8">firi Senir atifi, Hermon apampam hɔ,</para>
  <para style="q1" vid="SNG 4:8">firi agyata buo mu</para>
  <para style="q2" vid="SNG 4:8">ne mmepɔ a asebɔ dɛɛdɛɛ hɔ.<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>Woagye mʼakoma abɔ so, me nuabaa, mʼayeforɔ;</para>
  <para style="q2" vid="SNG 4:9">woagye mʼakoma abɔ so</para>
  <para style="q1" vid="SNG 4:9">wode wʼani a ɛbɔɔ me soɔ,</para>
  <para style="q2" vid="SNG 4:9">ne wo kɔnmuadeɛ mu ɔbohemaa baako.<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>Wo dɔ yɛ ahomeka, me nuabaa, mʼayeforɔ!</para>
  <para style="q2" vid="SNG 4:10">Hwɛ wo dɔ sɔ ani sene bobesa,</para>
  <para style="q2" vid="SNG 4:10">na wʼaduhwam yɛ hwam sene pɛperɛ biara.<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>Adɔdɔdeɛ firi wʼano sɛ ɛwokyɛm, mʼayeforɔ;</para>
  <para style="q2" vid="SNG 4:11">nufosuo ne ɛwoɔ wɔ wo tɛkrɛma ase.</para>
  <para style="q2" vid="SNG 4:11">Wo ntadeɛ mu hwa te sɛ Lebanon deɛ.<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>Wote sɛ turo a wɔato ano ɛpono mu, me nuabaa, mʼayeforɔ;</para>
  <para style="q2" vid="SNG 4:12">woyɛ asutire a wɔagye ho ban, asubura a wɔasɔ ano.<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>Wo nnua yɛ nnuabafuo so ateaa</para>
  <para style="q2" vid="SNG 4:13">a ɛso aba pa,</para>
  <para style="q2" vid="SNG 4:13">ahuahaa ne nnuannua,<verse eid="SNG 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14"/>nnuannua ne mmɛtire,</para>
  <para style="q2" vid="SNG 4:14">osiko ne sinamon,</para>
  <para style="q2" vid="SNG 4:14">a ohwamfufuo nnua hodoɔ,</para>
  <para style="q2" vid="SNG 4:14">kurobo ne dupapoɔ</para>
  <para style="q2" vid="SNG 4:14">ne pɛperɛ papa ahodoɔ nyinaa ka ho.<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>Woyɛ turo mu asubura.</para>
  <para style="q2" vid="SNG 4:15">Woyɛ ɔtadeɛ a nsuo tene firi mu</para>
  <para style="q2" vid="SNG 4:15">sane firi Lebanon.<verse eid="SNG 4:15"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>Sɔre, atifi fam mframa!</para>
  <para style="q2" vid="SNG 4:16">Bra, anafoɔ fam mframa!<note caller="+" style="f"><char style="fr" closed="false">4.16 </char><char style="ft" closed="false">Mframa a ɛbɔ firi atifi fam no mu dwo enti ɛma nnuaba yɛ foforɔ daa. Mframa a ɛbɔ firi anafoɔ fam no mu yɛ hye na ɛma nnuaba no bere. Ne mmienu ka bɔ mu a, ɛma mframa a ɛyɛ hwam fa turo no mu.</char></note></para>
  <para style="q1" vid="SNG 4:16">Bɔ fa me turo mu,</para>
  <para style="q2" vid="SNG 4:16">sɛdeɛ ɛbɛyɛ a ne hwa no bɛgyegye hɔ.</para>
  <para style="q1" vid="SNG 4:16">Ma me dɔfoɔ mmra ne turo mu</para>
  <para style="q2" vid="SNG 4:16">na ɔmmɛka ne nnuaba papa no nhwɛ.<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>Maba me turo mu, me nuabaa, mʼayeforɔ;</para>
  <para style="q2" vid="SNG 5:1">maboaboa me kurobo ne me nnuhwam ano.</para>
  <para style="q1" vid="SNG 5:1">Madi me woɔkyɛm ne ɛwoɔ;</para>
  <para style="q2" vid="SNG 5:1">manom me bobesa ne me nufosuo.</para>
  <para style="sp" vid="SNG 5:1">Nnamfonom:</para>
  <para style="q1" vid="SNG 5:1">Ao, nnamfonom, monnidi na monnom;</para>
  <para style="q2" vid="SNG 5:1">Ao, adɔfonom, monnom deɛ ɛbɛmee mo.<verse eid="SNG 5:1"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>Medaeɛ nanso mʼakoma anna.</para>
  <para style="q2" vid="SNG 5:2">Tie! Me dɔfoɔ rebɔ ɛpono no mu;</para>
  <para style="q1" vid="SNG 5:2">“Bue me, me nuabaa, me dɔ,</para>
  <para style="q2" vid="SNG 5:2">mʼaborɔnoma, a ne ho nni dɛm.</para>
  <para style="q1" vid="SNG 5:2">Obosuo afɔ me tirim,</para>
  <para style="q2" vid="SNG 5:2">anadwo mu bosuo afɔ me nwi.”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>Maworɔ mʼatadeɛ,</para>
  <para style="q2" vid="SNG 5:3">mensane mfa nhyɛ anaa?</para>
  <para style="q1" vid="SNG 5:3">Mahohoro me nan ase,</para>
  <para style="q2" vid="SNG 5:3">memma ho nyɛ fi bio anaa?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>Me dɔfoɔ yɛɛ sɛ ɔrebue ɛpono no</para>
  <para style="q2" vid="SNG 5:4">mʼakoma firi aseɛ bɔɔ kimkim wɔ me mu.<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>Mesɔree sɛ merekɔhini me dɔfoɔ,</para>
  <para style="q2" vid="SNG 5:5">na me nsa ho kurobo</para>
  <para style="q1" vid="SNG 5:5">ne me nsateaa ho aduhwam,</para>
  <para style="q2" vid="SNG 5:5">yɛɛ apratwom no ho.<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>Mebue maa me dɔfoɔ no,</para>
  <para style="q2" vid="SNG 5:6">nanso na ɔkɔ.</para>
  <para style="q2" vid="SNG 5:6">Ne korɔ no maa me ho dwirii me.</para>
  <para style="q1" vid="SNG 5:6">Mehwehwɛɛ no nanso manhunu no baabiara.</para>
  <para style="q2" vid="SNG 5:6">Mefrɛɛ no nanso wannye me so.<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>Awɛmfoɔ no hunuu me</para>
  <para style="q2" vid="SNG 5:7">ɛberɛ a wɔrebɔ aporɔ wɔ kuropɔn no mu.</para>
  <para style="q1" vid="SNG 5:7">Wɔbobɔɔ me pirapiraa me;</para>
  <para style="q2" vid="SNG 5:7">wɔyii mʼatadeɛ kɔreɛ</para>
  <para style="q2" vid="SNG 5:7">saa awɛmfoɔ a wɔwɛn afasuo no!<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>Ao, Yerusalem mmammaa, mehyɛ mo,</para>
  <para style="q2" vid="SNG 5:8">sɛ mohunu me dɔfoɔ no a,</para>
  <para style="q1" vid="SNG 5:8">asɛm bɛn na mobɛka akyerɛ no?</para>
  <para style="q2" vid="SNG 5:8">Monka nkyerɛ no sɛ ɔdɔ ama matɔ piti.<verse eid="SNG 5:8"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>Ɛdeɛn na wo dɔfoɔ de sene afoforɔ,</para>
  <para style="q2" vid="SNG 5:9">mmaa ahoɔfɛfoɔ mu ahoɔfɛ?</para>
  <para style="q1" vid="SNG 5:9">Ɛdeɛn na wo dɔfoɔ de sene afoforɔ a</para>
  <para style="q2" vid="SNG 5:9">enti wohyɛ yɛn sei?<verse eid="SNG 5:9"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>Me dɔfoɔ ho twa na ɔgyegye,</para>
  <para style="q2" vid="SNG 5:10">wɔfa mpemdu a ɔda mu fua.<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>Ne ti yɛ sikakɔkɔɔ amapa;</para>
  <para style="q2" vid="SNG 5:11">ne tiri so nwi yɛ kuhaa,</para>
  <para style="q2" vid="SNG 5:11">na ɛyɛ tuntum sɛ kwaakwaadabi.<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>Nʼaniwa aba te sɛ aborɔnoma a</para>
  <para style="q2" vid="SNG 5:12">ɔgyina asuwa bi ho;</para>
  <para style="q1" vid="SNG 5:12">ɛte sɛ deɛ wɔde nufosuo adware no,</para>
  <para style="q2" vid="SNG 5:12">na ɛsisi hɔ sɛ abohemaa.<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>Nʼafono te sɛ pɛperɛ a wɔasɛ no kɛtɛ.</para>
  <para style="q2" vid="SNG 5:13">Ɛho hwa te sɛ aduhwam.</para>
  <para style="q1" vid="SNG 5:13">Nʼanofafa te sɛ sukooko</para>
  <para style="q2" vid="SNG 5:13">a ɛsosɔ kurobo.<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>Nʼabasa te sɛ sikakɔkɔɔ abaa</para>
  <para style="q2" vid="SNG 5:14">a wɔde sikabereɛboɔ asisi mu.</para>
  <para style="q1" vid="SNG 5:14">Ne onipadua te sɛ asonse a wɔatwi ho</para>
  <para style="q2" vid="SNG 5:14">na wɔde aboɔdemmoɔ adura ho.<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>Ne nan te sɛ abohemaa afadum a</para>
  <para style="q2" vid="SNG 5:15">ɛsisi sikakɔkɔɔ amapa nnyinasoɔ so.</para>
  <para style="q1" vid="SNG 5:15">Ne bɔberɛ te sɛ Lebanon a</para>
  <para style="q2" vid="SNG 5:15">ɔyɛ sononko sɛ ne ntweneduro.<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>Nʼano te sɛ ɔdɛ ankasa;</para>
  <para style="q2" vid="SNG 5:16">ɛkwan biara so, ne ho yɛ fɛ.</para>
  <para style="q1" vid="SNG 5:16">Me dɔfoɔ nie, mʼadamfo nie,</para>
  <para style="q2" vid="SNG 5:16">Ao, Yerusalem mmammaa.<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>Ɛhe na wo dɔfoɔ no korɔ</para>
  <para style="q2" vid="SNG 6:1">mmaa ahoɔfɛfoɔ mu ahoɔfɛ?</para>
  <para style="q1" vid="SNG 6:1">Ɛhe na wo dɔfoɔ dane faeɛ,</para>
  <para style="q2" vid="SNG 6:1">na yɛne wo nkɔhwehwɛ no?<verse eid="SNG 6:1"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>Me dɔfoɔ kɔ ne turo mu,</para>
  <para style="q2" vid="SNG 6:2">faako a pɛperɛ nkofie wɔ hɔ,</para>
  <para style="q1" vid="SNG 6:2">ɔkɔkyinkyini turo no mu</para>
  <para style="q2" vid="SNG 6:2">akɔboaboa sukooko ano.<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>Me dɔfoɔ yɛ me dea, na me nso me wɔ no;</para>
  <para style="q2" vid="SNG 6:3">ɔkyinkyin sukooko no mu.<verse eid="SNG 6:3"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>Me dɔfoɔ, wo ho yɛ fɛ te sɛ Tirsa,<note caller="+" style="f"><char style="fr" closed="false">6.4 </char><char style="ft" closed="false">Tirsa yɛ Kanaan tete kuro bi a Yeroboam de yɛɛ nʼahenkuro wɔ afe 930 AWK (ansa na wɔrewo Kristo) kɔsi afe 909 AWK wɔ atifi fam ahemman mu.</char></note></para>
  <para style="q2" vid="SNG 6:4">wʼahoɔfɛ te sɛ Yerusalem,</para>
  <para style="q2" vid="SNG 6:4">wosi pi te sɛ asraafoɔ a wɔretu frankaa.<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>Ɛnhwɛ me saa;</para>
  <para style="q2" vid="SNG 6:5">wo ma me yɛ basaa.</para>
  <para style="q1" vid="SNG 6:5">Wo tirinwi te sɛ mpapokuo a</para>
  <para style="q2" vid="SNG 6:5">wɔresiane firi Gilead.<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>Wo se te sɛ nnwankuo a wɔatwitwa wɔn ho nwi foforɔ,</para>
  <para style="q2" vid="SNG 6:6">a wɔfiri adwareɛ.</para>
  <para style="q1" vid="SNG 6:6">Wɔnam mmienu mmienu</para>
  <para style="q2" vid="SNG 6:6">na wɔn mu biara nyɛ ankonam.<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>Wʼasontorɔ mu a ɛhyɛ wo nkatanimu mu</para>
  <para style="q2" vid="SNG 6:7">te sɛ ateaa aduaba fa.<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>Ebia na ɔyerenom yɛ aduosia,</para>
  <para style="q2" vid="SNG 6:8">mpenafoɔ bɛyɛ aduɔwɔtwe,</para>
  <para style="q2" vid="SNG 6:8">ne mmabaawa dodoɔ a wɔntumi nkan wɔn;<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>nanso mʼaborɔnoma a ne ho nni asɛm da mu fua;</para>
  <para style="q2" vid="SNG 6:9">ɔno nko ara ne ne maame babaa,</para>
  <para style="q2" vid="SNG 6:9">ɔno na deɛ ɔwoo no no pɛ nʼasɛm.</para>
  <para style="q1" vid="SNG 6:9">Mmabaawa hunu no no, wɔfrɛɛ no nhyira;</para>
  <para style="q2" vid="SNG 6:9">ahemaa ne mpenafoɔ kamfoo no.<verse eid="SNG 6:9"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>Hwan na wapue sɛ ahemadakye yi,</para>
  <para style="q2" vid="SNG 6:10">ɔyɛ frɔmm sɛ ɔsrane, na ɔhyerɛn sɛ owia,</para>
  <para style="q2" vid="SNG 6:10">nʼanimuonyam te sɛ nsoromma a wɔsa so.<verse eid="SNG 6:10"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>Mesiane kɔɔ nnuaba pɔ mu hɔ</para>
  <para style="q2" vid="SNG 6:11">sɛ merekɔhwehwɛ afifideɛ foforɔ a ɛwɔ bɔnhwa no mu,</para>
  <para style="q1" vid="SNG 6:11">sɛ bobe no agu nhyerɛnne</para>
  <para style="q2" vid="SNG 6:11">anaasɛ ateaa no ayɛ frɔmm.<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>Mʼani baa me ho so no</para>
  <para style="q2" vid="SNG 6:12">na mʼadwene de me abɛsi me nkurɔfoɔ adehyeɛ nteaseɛnam so.<verse eid="SNG 6:12"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>Sane wʼakyi, sane wʼakyi, Ao, Sulamit abaayewa;</para>
  <para style="q2" vid="SNG 6:13">Sane bra, sane bra ma yɛn nhwɛ wo!</para>
  <para style="sp" vid="SNG 6:13">Aberanteɛ:</para>
  <para style="q1" vid="SNG 6:13">Adɛn enti na ɛsɛ sɛ mohwɛ Sulamit abaayewa</para>
  <para style="q2" vid="SNG 6:13">sɛdeɛ mohwɛ Mahanaim asa?<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>Wo nan ne mpaboa yɛ fɛ,</para>
  <para style="q2" vid="SNG 7:1">Ao, ɔdehyeɛ babaa!</para>
  <para style="q1" vid="SNG 7:1">Wʼanantuo a wogyina so te sɛ abohemaa,</para>
  <para style="q2" vid="SNG 7:1">odwumfoɔ nsa ano adwuma.<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>Wo funuma yɛ kuruwa a ɛnni nsa</para>
  <para style="q2" vid="SNG 7:2">a nsã pa wɔ mu ɛberɛ biara.</para>
  <para style="q1" vid="SNG 7:2">Wo sisi yɛ atokoɔ a wɔaboa ano</para>
  <para style="q2" vid="SNG 7:2">na sukooko atwa ho ahyia.<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>Wo nufu te sɛ aforoteɛ mma mmienu,</para>
  <para style="q2" vid="SNG 7:3">adabɔ mma ntafoɔ.<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>Wo kɔn te sɛ asonse abantenten.</para>
  <para style="q1" vid="SNG 7:4">Wʼaniwa aba te sɛ Hesbon ntadeɛ</para>
  <para style="q2" vid="SNG 7:4">a ɛwɔ Bat Rabim ɛpono nkyɛn.</para>
  <para style="q1" vid="SNG 7:4">Wo hwene te sɛ Lebanon abantenten</para>
  <para style="q2" vid="SNG 7:4">a ɛkyerɛ Damasko no.<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>Wo tiri si so sɛ Karmel Bepɔ.</para>
  <para style="q2" vid="SNG 7:5">Wo tirinwi te sɛ adehyetoma a wɔadi mu adwinneɛ;</para>
  <para style="q2" vid="SNG 7:5">wo tirinwi tentene no dwomfa ɔhene.<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>Wo ho yɛ fɛ, Ao ɔdɔ,</para>
  <para style="q2" vid="SNG 7:6">wo ho anikadeɛ ma wo ho yɛ ahomeka.<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>Wo siberɛ te sɛ abɛ dua,</para>
  <para style="q2" vid="SNG 7:7">na wo nufu te sɛ aduaba siaka.<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>Mekaa sɛ, “Mɛforo abɛ dua no;</para>
  <para style="q2" vid="SNG 7:8">na masɔ nʼaba mu.”</para>
  <para style="q1" vid="SNG 7:8">Wo nufu nyɛ sɛ bobe siaka,</para>
  <para style="q2" vid="SNG 7:8">na wo homeɛ mu hwa nyɛ sɛ aprɛ.<verse eid="SNG 7:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9"/>Na wʼanomu hwa nyɛ sɛ bobesa papa.</para>
  <para style="sp" vid="SNG 7:9">Ababaawa:</para>
  <para style="q1" vid="SNG 7:9">Ma bobesa no nkɔ me dɔfoɔ hɔ tee,</para>
  <para style="q2" vid="SNG 7:9">ɛntene mfa nʼanofafa ne ne se no so brɛoo.<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>Meyɛ me dɔfoɔ dea,</para>
  <para style="q2" vid="SNG 7:10">na nʼapɛdeɛ ne me.<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>Bra, me dɔfoɔ; ma yɛnkɔ nkuraase,</para>
  <para style="q2" vid="SNG 7:11">ma yɛnkɔda nkuraase anadwo baako.<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>Ma yɛnkɔ bobefuo mu ntɛm</para>
  <para style="q2" vid="SNG 7:12">nkɔhwɛ sɛ bobe no agu nhyerɛnne,</para>
  <para style="q1" vid="SNG 7:12">sɛ nhyerɛnne no apaapae,</para>
  <para style="q2" vid="SNG 7:12">anaasɛ ateaa no ayɛ frɔmm.</para>
  <para style="q2" vid="SNG 7:12">Ɛhɔ na mede me dɔ bɛma wo.<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>Adasoa yi ne hwa,</para>
  <para style="q2" vid="SNG 7:13">na akɔnnɔduane nyinaa bɛgu yɛn ɛpono ano,</para>
  <para style="q1" vid="SNG 7:13">foforɔ ne dada,</para>
  <para style="q2" vid="SNG 7:13">a mede asie ama woɔ, me dɔfoɔ.<verse eid="SNG 7:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>Sɛ anka woyɛɛ me nuabarima</para>
  <para style="q2" vid="SNG 8:1">a wonum me maame nufu ano,</para>
  <para style="q1" vid="SNG 8:1">ɛna mehunuu wo wɔ abɔntene so a,</para>
  <para style="q2" vid="SNG 8:1">anka mɛfe wʼano,</para>
  <para style="q2" vid="SNG 8:1">a obiara ntumi mmu me animtiaa.<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>Anka mɛdi wʼanim</para>
  <para style="q2" vid="SNG 8:2">na mede wo aba me maame efie,</para>
  <para style="q2" vid="SNG 8:2">ɔno a woakyerɛkyerɛ me.</para>
  <para style="q1" vid="SNG 8:2">Anka mɛma wo bobesa a wɔde pɛprɛ afra mu,</para>
  <para style="q2" vid="SNG 8:2">me ateaa mu nsuo dɔkɔ dɔkɔ no bi.<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>Ne nsa benkum da mʼatikɔ</para>
  <para style="q2" vid="SNG 8:3">na ne nsa nifa aka me afam ne bo.<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>Yerusalem mmammaa, mehyɛ mo sɛ,</para>
  <para style="q2" vid="SNG 8:4">morennyane na morenhwanyane ɔdɔ mu</para>
  <para style="q2" vid="SNG 8:4">kɔsi ɛberɛ a ɛsɛ mu.<verse eid="SNG 8:4"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>Hwan na ɔfiri ɛserɛ so reba a</para>
  <para style="q2" vid="SNG 8:5">ɔtwere ne dɔfoɔ kokom yi?</para>
  <para style="sp" vid="SNG 8:5">Ababaawa:</para>
  <para style="q1" vid="SNG 8:5">Mekanyanee wo wɔ aprɛ dua no ase;</para>
  <para style="q2" vid="SNG 8:5">ɛhɔ na wo maame nyinsɛnee woɔ,</para>
  <para style="q2" vid="SNG 8:5">ɛhɔ na deɛ ɔkoo awoɔ no woo woɔ.<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>Fa me to wʼakoma so sɛ nsɔanodeɛ,</para>
  <para style="q2" vid="SNG 8:6">sɛ nsɔanodeɛ wɔ wʼabasa so,</para>
  <para style="q1" vid="SNG 8:6">ɛfiri sɛ ɔdɔ ano yɛ den sɛ owuo,</para>
  <para style="q2" vid="SNG 8:6">ne ninkunutweɛ tim hɔ sɛ damena.</para>
  <para style="q1" vid="SNG 8:6">Ɛhyehye sɛ ogyadɛreɛ,</para>
  <para style="q2" vid="SNG 8:6">sɛ ogyaframa a ano yɛ den pa ara.<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>Nsuo dodoɔ rentumi nnum ɔdɔ;</para>
  <para style="q2" vid="SNG 8:7">nsubɔntene rentumi nhohoro nkɔ.</para>
  <para style="q1" vid="SNG 8:7">Sɛ obi de ne fie ahonya nyinaa bɛsesa ɔdɔ a</para>
  <para style="q2" vid="SNG 8:7">anka wɔremmu no adeɛ a ɛsom bo.<verse eid="SNG 8:7"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>Yɛwɔ nuabaa akumaa bi a,</para>
  <para style="q2" vid="SNG 8:8">ne nufu mmobɔeɛ.</para>
  <para style="q1" vid="SNG 8:8">Ɛdeɛn na yɛbɛyɛ ama yɛn nuabaa yi</para>
  <para style="q2" vid="SNG 8:8">wɔ da a wɔbɛbisa no ase?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>Sɛ ɔyɛ ɔfasuo a,</para>
  <para style="q2" vid="SNG 8:9">yɛbɛsi dwetɛ abantenten abɔ ne ho ban.</para>
  <para style="q1" vid="SNG 8:9">Sɛ ɔyɛ ɛpono a,</para>
  <para style="q2" vid="SNG 8:9">yɛde ntweneduro bɛsi ne ɛpono no kwan.<verse eid="SNG 8:9"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>Meyɛ ɔfasuo,</para>
  <para style="q2" vid="SNG 8:10">na me nufu te sɛ abantenten.</para>
  <para style="q1" vid="SNG 8:10">Enti nʼani so no mayɛ sɛ obi a</para>
  <para style="q2" vid="SNG 8:10">ɔde deɛ ɛsɔ ani reba.<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>Na Salomo wɔ bobeturo wɔ Baal-Hamon;</para>
  <para style="q2" vid="SNG 8:11">ɔde ne bobeturo no maa apaafoɔ.</para>
  <para style="q1" vid="SNG 8:11">Na ɛsɛ sɛ wɔn mu biara tua no</para>
  <para style="q2" vid="SNG 8:11">nnwetɛbena apem.<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>Nanso me bobeturo yi yɛ me dea.</para>
  <para style="q2" vid="SNG 8:12">Me deɛ, meremfa mma;</para>
  <para style="q2" vid="SNG 8:12">Salomo de ne deɛ gye nnwetɛbena apem,</para>
  <para style="q2" vid="SNG 8:12">na ɔtua nʼapaafoɔ nnwetɛbena ahaanu ma wɔhwɛ ne nnuaba no so.<verse eid="SNG 8:12"/></para>
  <para style="sp">Aberanteɛ:</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>Wo a wote turo no mu</para>
  <para style="q2" vid="SNG 8:13">ne nnamfonom a wɔka wo ho,</para>
  <para style="q2" vid="SNG 8:13">ma mente wo nne.<verse eid="SNG 8:13"/></para>
  <para style="sp">Ababaawa:</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>Bra ma yɛnkɔ, me dɔfoɔ,</para>
  <para style="q2" vid="SNG 8:14">na yɛ wo ho sɛ ɔdabɔ ba</para>
  <para style="q1" vid="SNG 8:14">anaasɛ ɔforoteɛ ba a</para>
  <para style="q2" vid="SNG 8:14">ɔwɔ mmepɔ a nnuhwam ahyɛ so ma so.<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
