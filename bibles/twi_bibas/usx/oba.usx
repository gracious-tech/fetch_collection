<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Obadia</para>
  <para style="toc1">Odiyifoɔ Obadia Nwoma</para>
  <para style="toc2">Obadia</para>
  <para style="toc3">Oba</para>
  <para style="mt2">Odiyifoɔ</para>
  <para style="mt1">Obadia</para>
  <para style="mt2">Nwoma</para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="s1">Edom Atemmuo Ho Nkɔmhyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>Anisoadehunu a <char style="nd">Awurade</char> Onyankopɔn daa no adi faa Edom asase ho kyerɛɛ Obadia nie:</para>
  <para style="q1" vid="OBA 1:1">Yɛate asɛm a ɛfiri <char style="nd">Awurade</char> nkyɛn.</para>
  <para style="q2" vid="OBA 1:1">Wɔsomaa ɔnanmusini bi kɔɔ aman so kɔkaa sɛ,</para>
  <para style="q1" vid="OBA 1:1">“Monsɔre na momma yɛnkɔko ntia Edom.”<verse eid="OBA 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2"/>
    <char style="nd">Awurade</char> ka kyerɛ Edom sɛ:</para>
  <para style="q1" vid="OBA 1:2">“Hwɛ mɛbrɛ wo ase,</para>
  <para style="q2" vid="OBA 1:2">mɛyɛ wo akumaa wɔ aman no mu,</para>
  <para style="q2" vid="OBA 1:2">na wɔabu wo animtia.<verse eid="OBA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3"/>Wayɛ ahantan adaadaa wo ho,</para>
  <para style="q2" vid="OBA 1:3">Wo a wote abotan ntokuro mu</para>
  <para style="q1" vid="OBA 1:3">na wayɛ wʼatenaeɛ wɔ mmepɔ so,</para>
  <para style="q2" vid="OBA 1:3">na woka kyerɛ wo ho sɛ,</para>
  <para style="q2" vid="OBA 1:3">‘Hwan na ɔbɛtumi ayi me asi fam?’<verse eid="OBA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4"/>Sɛ wotu kɔ ewiem sɛ akɔdeɛ,</para>
  <para style="q1" vid="OBA 1:4">na woyɛ wo pirebuo wɔ nsoromma ntam mpo a,</para>
  <para style="q2" vid="OBA 1:4">ɛhɔ na mɛba abɛtwe wo adwera fam.”</para>
  <para style="q1" vid="OBA 1:4">Sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="OBA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5"/>“Sɛ akorɔmfoɔ ba wo so a,</para>
  <para style="q2" vid="OBA 1:5">anaa adwotwafoɔ ba wo so anadwo a,</para>
  <para style="q1" vid="OBA 1:5">atoyerɛnkyɛm bɛn na ɛrento wo?</para>
  <para style="q2" vid="OBA 1:5">Na wɔrenwia wo nneɛma dodoɔ a wɔpɛ anaa?</para>
  <para style="q1" vid="OBA 1:5">Sɛ bobe abatefoɔ ba wo so a,</para>
  <para style="q2" vid="OBA 1:5">ɛnyɛ bobe aba kakra bi pɛ na wɔbɛgya wo anaa?<verse eid="OBA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6"/>Na wo Esau deɛ wɔbɛwia wʼademudeɛ</para>
  <para style="q2" vid="OBA 1:6">a wode asie na wɔayɛ wo dosodoso.<verse eid="OBA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7"/>Wɔn a wo ne wɔn wɔ nkabom nyinaa</para>
  <para style="q2" vid="OBA 1:7">bɛdi wo hwammɔ.</para>
  <para style="q1" vid="OBA 1:7">Wɔn a wʼadwene yɛ wo sɛ</para>
  <para style="q2" vid="OBA 1:7">wo ne wɔn te asomdwoeɛ mu no</para>
  <para style="q1" vid="OBA 1:7">bɛdaadaa wo adi wo so,</para>
  <para style="q2" vid="OBA 1:7">wɔn a wɔdi wʼaduane no asum wo afidie,</para>
  <para style="q2" vid="OBA 1:7">nanso, wonhunuiɛ.<verse eid="OBA 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8"/>“Saa ɛda no,” <char style="nd">Awurade</char> na ɔseɛ,</para>
  <para style="q2" vid="OBA 1:8">“Merensɛe anyansafoɔ a ɛwɔ Edom anaa,</para>
  <para style="q1" vid="OBA 1:8">mmarima a wɔte asɛm ase</para>
  <para style="q2" vid="OBA 1:8">a wɔwɔ Esau mmepɔ so anaa?<verse eid="OBA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9"/>Ao Teman<note caller="+" style="f"><char style="fr" closed="false">1.9 </char><char style="ft" closed="false">Teman: Teman kyerɛ Edom nyinaa sɛdeɛ Yeremia ka wɔ <char style="xt"><ref loc="JER 49:7">Yer 49.7</ref>,<ref loc="JER 49:20">20</ref></char>. Teman asekyerɛ yɛ “anafoɔ”. Saa din yi tumi yɛ Edom a ɛyɛ anafoɔ asase. Ebinom nso kyerɛ Teman ase sɛ Tawilan a ɛda borɔfokwansin mmiɛnsa wɔ Petra apueeɛ fam.</char></note> wʼakofoɔ bɛbɔ hu</para>
  <para style="q1" vid="OBA 1:9">ne obiara a ɔwɔ Esau bepɔ so no,</para>
  <para style="q2" vid="OBA 1:9">wɔbɛtwitwa mo atɔre mo ase.<verse eid="OBA 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10"/>Esiane basabasayɛ a woyɛ tiaa wo nua Yakob no enti</para>
  <para style="q1" vid="OBA 1:10">aniwuo bɛka wo,</para>
  <para style="q2" vid="OBA 1:10">na wɔbɛsɛe wo koraa.<verse eid="OBA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11"/>Ɛda a wogyinaa ntentenso hwɛɛ no haa,</para>
  <para style="q1" vid="OBA 1:11">na ananafoɔ faa nʼahonyadeɛ kɔeɛ</para>
  <para style="q2" vid="OBA 1:11">na ahɔhoɔ hyɛnee ne kuro apono mu,</para>
  <para style="q1" vid="OBA 1:11">na wɔbɔɔ Yerusalem so ntonto no,</para>
  <para style="q2" vid="OBA 1:11">na wote sɛ wɔn mu baako.<verse eid="OBA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12"/>Anka ɛnsɛ sɛ wobu wo nua animtiaa</para>
  <para style="q2" vid="OBA 1:12">ɛberɛ a ɔwɔ asaneɛ mu,</para>
  <para style="q1" vid="OBA 1:12">anaa sɛ wodi ahurisie wɔ Yudafoɔ so</para>
  <para style="q2" vid="OBA 1:12">ɛberɛ a wɔwɔ ɔsɛeɛ mu,</para>
  <para style="q1" vid="OBA 1:12">na mpo wohoahoa wo ho</para>
  <para style="q2" vid="OBA 1:12">ɛberɛ a wɔwɔ ahohiahia mu no.<verse eid="OBA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13"/>Anka ɛnsɛ sɛ wode nsrabɔ</para>
  <para style="q2" vid="OBA 1:13">hyɛne me nkurɔfoɔ kuro apono no mu</para>
  <para style="q1" vid="OBA 1:13">wɔ wɔn amanehunu ɛda,</para>
  <para style="q1" vid="OBA 1:13">anka ɛnsɛ sɛ wosere wɔ ɛberɛ a</para>
  <para style="q2" vid="OBA 1:13">wɔwɔ ɔhaw mu.</para>
  <para style="q1" vid="OBA 1:13">Afei nso anka ɛnsɛ sɛ</para>
  <para style="q2" vid="OBA 1:13">wode wo nsa to wɔn ahodeɛ so gye</para>
  <para style="q2" vid="OBA 1:13">wɔ ɛberɛ a wɔwɔ amanehunu mu.<verse eid="OBA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14"/>Anka ɛnsɛ sɛ wotɛ wɔn nkwantanan soɔ</para>
  <para style="q2" vid="OBA 1:14">kunkumm nʼadwanefoɔ</para>
  <para style="q1" vid="OBA 1:14">Na woyi wɔn a aka no ma</para>
  <para style="q2" vid="OBA 1:14">wɔ wɔn amanehunu ɛda no mu.<verse eid="OBA 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15"/>“<char style="nd">Awurade</char> ɛda no abɛn</para>
  <para style="q2" vid="OBA 1:15">ama amanaman nyinaa.</para>
  <para style="q1" vid="OBA 1:15">Na hwɛ, Edom sɛdeɛ woyɛeɛ no</para>
  <para style="q2" vid="OBA 1:15">saa ara na wɔbɛyɛ woɔ.</para>
  <para style="q1" vid="OBA 1:15">Wo nneyɛeɛ bɛsane abɛgu wo tiriso.<verse eid="OBA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16"/>Sɛdeɛ mononom nsã wɔ me bepɔ kronkron so no,</para>
  <para style="q1" vid="OBA 1:16">saa ara na amanaman no nyinaa bɛkɔ so anom,</para>
  <para style="q2" vid="OBA 1:16">saa ara na ɛbɛkɔ so ɛda biara</para>
  <para style="q2" vid="OBA 1:16">na wɔbɛyɛ te sɛ deɛ wonni hɔ.<verse eid="OBA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17"/>Na ɔgyeɛ bɛba Sion bepɔ so</para>
  <para style="q2" vid="OBA 1:17">na ɛbɛyɛ kronkron beaeɛ,</para>
  <para style="q1" vid="OBA 1:17">na Yakob efie nsa</para>
  <para style="q2" vid="OBA 1:17">bɛsane aka nʼagyapadeɛ.<verse eid="OBA 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18"/>Yakob efie bɛyɛ ogya</para>
  <para style="q2" vid="OBA 1:18">na Yosef efie ayɛ ogyaframa;</para>
  <para style="q1" vid="OBA 1:18">Esau efie deɛ ɛbɛyɛ adehunu bi</para>
  <para style="q2" vid="OBA 1:18">na wɔde ogya bɛto mu ahye no a</para>
  <para style="q1" vid="OBA 1:18">obiara renka wɔ efie hɔ.”</para>
  <para style="q2" vid="OBA 1:18">Deɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="OBA 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19"/>Nkurɔfoɔ a wɔfiri Negeb no</para>
  <para style="q2" vid="OBA 1:19">bɛtena Esau mmepɔ so,</para>
  <para style="q1" vid="OBA 1:19">Na wɔn a wɔfiri nkokoɔ no ase no,</para>
  <para style="q2" vid="OBA 1:19">bɛfa Filistia asase no,</para>
  <para style="q1" vid="OBA 1:19">na wɔbɛfa Efraim ne Samaria mfuo atena so,</para>
  <para style="q2" vid="OBA 1:19">na Benyamin nso afa Gilead.<verse eid="OBA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20"/>Nipakuo a wɔyɛ Israel atukɔfoɔ</para>
  <para style="q2" vid="OBA 1:20">bɛfa Kanaan asase no akɔsi Sarefat;</para>
  <para style="q1" vid="OBA 1:20">na atukɔfoɔ a wɔfiri Yerusalem a</para>
  <para style="q2" vid="OBA 1:20">wɔte Safarad no bɛfa Negeb nkuro no adi so.<verse eid="OBA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21"/>Agyefoɔ bɛkɔ Sion bepɔ so,</para>
  <para style="q2" vid="OBA 1:21">akɔdi Edom mmepɔ so.</para>
  <para style="q2" vid="OBA 1:21">Na ahennie no bɛyɛ <char style="nd">Awurade</char> dea!<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
