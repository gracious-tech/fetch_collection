<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Mika</para>
  <para style="toc1">Odiyifoɔ Mika Nwoma</para>
  <para style="toc2">Mika</para>
  <para style="toc3">Mika</para>
  <para style="mt2">Odiyifoɔ</para>
  <para style="mt1">Mika</para>
  <para style="mt2">Nwoma</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>
    <char style="nd">Awurade</char> de saa nsɛm yi brɛɛ Moresetni Mika<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">Mika asekyerɛ ne “Hwan na ɔte sɛ Awurade.” Samaria ne Yerusalem: Saa nkuropɔn mmienu yi gyina hɔ ma Israel ne Yuda. Atemmuo a Mika hyɛɛ ho nkɔm no fa aman mmienu no ho na ɛmfa wɔn nkuropɔn no nko ho.</char></note> ɛberɛ a na Yotam, Ahas ne Hesekia di adeɛ wɔ Yuda no. Anisoadehunu a ɔhunuiɛ fa Samaria ne Yerusalem ho.<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>Monyɛ aso, mo nnipa nyinaa,</para>
  <para style="q2" vid="MIC 1:2">montie, asase ne mo a mote so nyinaa.</para>
  <para style="q1" vid="MIC 1:2">Otumfoɔ <char style="nd">Awurade</char> redi adanseɛ atia mo,</para>
  <para style="q2" vid="MIC 1:2">ɔkasa firi nʼasɔredan kronkron no mu.<verse eid="MIC 1:2"/></para>
  <para style="s1">Atemmuo A Ɛtia Samaria Ne Yerusalem</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>Monhwɛ! <char style="nd">Awurade</char> firi nʼatenaeɛ reba;</para>
  <para style="q2" vid="MIC 1:3">ɔresiane na ɔnante asase sorɔnsorɔmmea so.<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>Mmepɔ nane wɔ nʼase,</para>
  <para style="q2" vid="MIC 1:4">mmɔnhwa mu paepae</para>
  <para style="q1" vid="MIC 1:4">te sɛ ama a aka ogya,</para>
  <para style="q2" vid="MIC 1:4">te sɛ nsuo a ɛsiane ɔherɛ so firi kokoɔ so.<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>Yei nyinaa yɛ Yakob nnebɔne,</para>
  <para style="q2" vid="MIC 1:5">ne bɔne ahodoɔ a ɛwɔ Israel efie enti.</para>
  <para style="q1" vid="MIC 1:5">Yakob nnebɔne ne sɛn?</para>
  <para style="q2" vid="MIC 1:5">Ɛnyɛ Samaria anaa?</para>
  <para style="q1" vid="MIC 1:5">Na ɛhe ne Yuda sorɔnsorɔmmea?</para>
  <para style="q2" vid="MIC 1:5">Ɛnyɛ Yerusalem anaa?<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>“Enti mɛyɛ Samaria kuro no mmubuiɛ sie,</para>
  <para style="q2" vid="MIC 1:6">baabi a wɔbɛyɛ bobe turo.</para>
  <para style="q1" vid="MIC 1:6">Mehwie nʼaboɔ agu bɔnhwa mu</para>
  <para style="q2" vid="MIC 1:6">ama ne fapem ho ada hɔ.<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>Wɔbɛbubu nʼahoni nyinaa mu asinasini;</para>
  <para style="q2" vid="MIC 1:7">wɔde ogya bɛhyɛ nʼasɔredan mu ayɛyɛdeɛ nyinaa.</para>
  <para style="q2" vid="MIC 1:7">Mɛsɛe ne nsɛsodeɛ nyinaa.</para>
  <para style="q1" vid="MIC 1:7">Esiane sɛ nʼakyɛdeɛ a waboa ano no nyinaa</para>
  <para style="q2" vid="MIC 1:7">ɔnya firii adwamanfoɔ akatua mu no enti</para>
  <para style="q2" vid="MIC 1:7">wɔde bɛma adwamanfoɔ.”<verse eid="MIC 1:7"/></para>
  <para style="s1">Osu Ne Awerɛhoɔ</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>Yeinom enti mɛsu atwa agyaadwoɔ;</para>
  <para style="q2" vid="MIC 1:8">mede adagya bɛnante na mennhyɛ mpaboa.</para>
  <para style="q1" vid="MIC 1:8">Mɛpɔ so sɛ odompo</para>
  <para style="q2" vid="MIC 1:8">na masu sɛ ɔpatuo.<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>Nʼapirakuro no wuo ayɛ den;</para>
  <para style="q2" vid="MIC 1:9">abɛduru Yuda.</para>
  <para style="q1" vid="MIC 1:9">Abɛduru me nkurɔfoɔ ɛpono ano</para>
  <para style="q2" vid="MIC 1:9">mpo aduru Yerusalem ankasa.<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>Monnka no wɔ Gat</para>
  <para style="q2" vid="MIC 1:10">monnsu koraa</para>
  <para style="q1" vid="MIC 1:10">Mo a mowɔ Bet-Leafra deɛ</para>
  <para style="q2" vid="MIC 1:10">monyantam mfuturo mu.<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>Monsene nkɔ adagya ne aniwuo mu,</para>
  <para style="q2" vid="MIC 1:11">mo a mote Safir.</para>
  <para style="q1" vid="MIC 1:11">Wɔn a wɔte Saanan ntumi mpue</para>
  <para style="q2" vid="MIC 1:11">Bet-Esel wɔ awerɛhoɔ mu;</para>
  <para style="q2" vid="MIC 1:11">ɛfiri sɛ, wo hɔ na ɔnya ne banbɔ.<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>Wɔn a wɔte Marot de ɔyea nukanuka wɔ mu</para>
  <para style="q2" vid="MIC 1:12">de twɛn mmoa,</para>
  <para style="q1" vid="MIC 1:12">ɛfiri sɛ amanehunu a ɛfiri <char style="nd">Awurade</char> hɔ aba</para>
  <para style="q2" vid="MIC 1:12">abɛduru Yerusalem ɛpono ano.<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>Mo a mote Lakis,</para>
  <para style="q2" vid="MIC 1:13">monsiesie nteaseɛnam no.</para>
  <para style="q1" vid="MIC 1:13">Mo ne bɔne farebae</para>
  <para style="q2" vid="MIC 1:13">ma Ɔbabaa Sion,</para>
  <para style="q1" vid="MIC 1:13">na modii Israel anim kɔɔ bɔne mu.<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>Enti mode ntetemu akyɛdeɛ bɛma Moreset-Gat,</para>
  <para style="q2" vid="MIC 1:14">Aksib kuro bɛdaadaa Israel ahemfo.<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>Mede nkonimdifoɔ bɛtoa mo</para>
  <para style="q2" vid="MIC 1:15">mo a mote Maresa.</para>
  <para style="q1" vid="MIC 1:15">Deɛ ɔyɛ Israel onimuonyamfoɔ no</para>
  <para style="q2" vid="MIC 1:15">bɛba Adulam.<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>Monyi mo tirinwi mfa nni awerɛhoɔ,</para>
  <para style="q2" vid="MIC 1:16">wɔ mma a mo ani gye wɔn ho no ho;</para>
  <para style="q1" vid="MIC 1:16">mommɔ tikwa te sɛ ɔpete,</para>
  <para style="q2" vid="MIC 1:16">ɛfiri sɛ, wɔbɛfa wɔn afiri mo nkyɛn</para>
  <para style="q2" vid="MIC 1:16">akɔ nnommumfa mu.<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">Onipa Ne Onyankopɔn Nhyehyɛeɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>Nnome nka wɔn a wɔfa amumuyɛ ho adwene,</para>
  <para style="q2" vid="MIC 2:1">wɔn a wɔbɔ ɛpɔ bɔne wɔ wɔn mpa so!</para>
  <para style="q1" vid="MIC 2:1">Wɔsɔre anɔpa kɔdi dwuma no</para>
  <para style="q2" vid="MIC 2:1">ɛfiri sɛ wɔwɔ tumi sɛ wɔyɛ.<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>Wɔn ani bere mfuo na wɔgye.</para>
  <para style="q2" vid="MIC 2:2">Na afie nso wɔfa.</para>
  <para style="q1" vid="MIC 2:2">Wɔde nyansa korɔno gye nkurɔfoɔ afie,</para>
  <para style="q2" vid="MIC 2:2">na ayɔnkofoɔ agyapadeɛ nso wɔgye.<verse eid="MIC 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 2:3"/>Enti, sɛdeɛ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q2" vid="MIC 2:3">“Meredwene amanehunu a ɛtia saa nkurɔfoɔ yi ho</para>
  <para style="q1" vid="MIC 2:3">na worentumi nnyi wo ho mfiri mu.</para>
  <para style="q2" vid="MIC 2:3">Worentumi nnante ahantan so bio,</para>
  <para style="q2" vid="MIC 2:3">ɛfiri sɛ ɛbɛyɛ ɛberɛ bɔne.<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>Saa ɛda no, nnipa bɛsere mo.</para>
  <para style="q2" vid="MIC 2:4">Wɔde saa awerɛhoɔ dwom yi</para>
  <para style="q1" vid="MIC 2:4">bɛdi mo ho fɛ sɛ:</para>
  <para style="q2" vid="MIC 2:4">‘wɔasɛe yɛn koraa;</para>
  <para style="q1" vid="MIC 2:4">wɔakyekyɛ me nkurɔfoɔ ahodeɛ mu.</para>
  <para style="q2" vid="MIC 2:4">Ɔgye firi me nsa mu!</para>
  <para style="q2" vid="MIC 2:4">Na ɔde yɛn mfuo ma akɔnkɔnsafoɔ.’ ”<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>Enti morennya obi wɔ</para>
  <para style="q2" vid="MIC 2:5">
    <char style="nd">Awurade</char> asafo mu</para>
  <para style="q1" vid="MIC 2:5">a ɔde ntontobɔ bɛkyɛ asase no.<verse eid="MIC 2:5"/></para>
  <para style="s1">Atorɔ Adiyifoɔ</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>“Monnhyɛ nkɔm,” saa na wɔn nkɔmhyɛfoɔ no ka.</para>
  <para style="q2" vid="MIC 2:6">“Monnhyɛ saa nneɛma yi ho nkɔm;</para>
  <para style="q2" vid="MIC 2:6">animguaseɛ rento yɛn.”<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>Ao, Yakob efie, mma monnka nsɛm a ɛte saa.</para>
  <para style="q2" vid="MIC 2:7">
    <char style="nd">Awurade</char> Honhom nni boasetɔ?</para>
  <para style="q2" vid="MIC 2:7">Ɔyɛ nneɛma a ɛte sei anaa?</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">“Ne nsɛm nyɛ deɛ nʼakwan tene</para>
  <para style="q2" vid="MIC 2:7">no yie anaa?<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>Akyire no, me nkurɔfoɔ asɔre</para>
  <para style="q2" vid="MIC 2:8">te sɛ asraafoɔ.</para>
  <para style="q1" vid="MIC 2:8">Moworɔ ntadeɛ pa firi</para>
  <para style="q2" vid="MIC 2:8">wɔn a wɔretwam a wɔnni adwemmɔne biara ho,</para>
  <para style="q2" vid="MIC 2:8">ma wɔyɛ te sɛ asraafoɔ a wɔfiri akono.<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>Mopam mmaa a wɔwɔ me nkurɔfoɔ mu</para>
  <para style="q2" vid="MIC 2:9">firi wɔn afie fɛfɛ mu.</para>
  <para style="q1" vid="MIC 2:9">Mogye me nhyira</para>
  <para style="q2" vid="MIC 2:9">firi wɔn mma nsam afebɔɔ.<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>Sɔre, firi ha kɔ!</para>
  <para style="q2" vid="MIC 2:10">Ɛha nyɛ beaeɛ a wɔhome,</para>
  <para style="q1" vid="MIC 2:10">ɛfiri sɛ ɛho agu fi,</para>
  <para style="q2" vid="MIC 2:10">Wɔasɛe no, na ɛrenyɛ yie bio.<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>Sɛ ɔtorofoɔ ne ɔdaadaafoɔ ba bɛka sɛ,</para>
  <para style="q2" vid="MIC 2:11">‘Mɛhyɛ nkɔm ama moanya nsã bebree a’</para>
  <para style="q2" vid="MIC 2:11">ɔbɛyɛ odiyifoɔ a saa nkurɔfoɔ yi pɛ.<verse eid="MIC 2:11"/></para>
  <para style="s1">Ɔgyeɛ Ho Bɔhyɛ</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>“Mɛboaboa mo nyinaa ano Ao, Yakob;</para>
  <para style="q2" vid="MIC 2:12">nokorɛm mɛka Israel nkaeɛfoɔ no nyinaa abɔ mu.</para>
  <para style="q1" vid="MIC 2:12">Mɛka wɔn abɔ mu te sɛ nnwan a wɔgu nnwammuo mu,</para>
  <para style="q2" vid="MIC 2:12">te sɛ nnwankuo a wɔwɔ adidibea;</para>
  <para style="q2" vid="MIC 2:12">nnipa bɛhyɛ beaeɛ ho manyamanya.<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>Deɛ ɔbɔ ɛkwan no bɛdi wɔn anim</para>
  <para style="q2" vid="MIC 2:13">wɔbɛbu apono no na wɔafiri akɔ.</para>
  <para style="q1" vid="MIC 2:13">Wɔn ɔhene bɛsene adi wɔn anim,</para>
  <para style="q2" vid="MIC 2:13">
    <char style="nd">Awurade</char> bɛyɛ wɔn ti.”<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">Ntuanofoɔ Ne Adiyifoɔ Animka</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>Afei mekaa sɛ,</para>
  <para style="q1" vid="MIC 3:1">“Montie, mo Yakob ntuanofoɔ,</para>
  <para style="q2" vid="MIC 3:1">mo sodifoɔ a mowɔ Israel efie.</para>
  <para style="q1" vid="MIC 3:1">Ɛsɛ sɛ mohunu deɛ ɛyɛ atɛntenenee,<verse eid="MIC 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2"/>Mo a mokyiri deɛ ɛyɛ na modɔ bɔne</para>
  <para style="q1" vid="MIC 3:2">moworɔ me nkurɔfoɔ wedeɛ</para>
  <para style="q2" vid="MIC 3:2">na motete ɛnam no firi wɔn nnompe ho;<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>mowe me nkurɔfoɔ nam,</para>
  <para style="q2" vid="MIC 3:3">mowae wɔn wedeɛ,</para>
  <para style="q2" vid="MIC 3:3">bubu wɔn nnompe mu nketenkete;</para>
  <para style="q1" vid="MIC 3:3">motwitwa wɔn sɛ ɛnam a</para>
  <para style="q2" vid="MIC 3:3">mode regu kwansɛn mu.”<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>Afei wɔbɛsu afrɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 3:4">nanso ɔrennye wɔn so.</para>
  <para style="q1" vid="MIC 3:4">Saa ɛberɛ no ɔde nʼanim bɛsie wɔn,</para>
  <para style="q2" vid="MIC 3:4">bɔne a wɔayɛ enti.<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q1" vid="MIC 3:5">“Adiyifoɔ a</para>
  <para style="q2" vid="MIC 3:5">wɔdaadaa me nkurɔfoɔ no deɛ,</para>
  <para style="q1" vid="MIC 3:5">obi ma wɔn biribi di a</para>
  <para style="q2" vid="MIC 3:5">wɔpae mu ka asomdwoeɛ nsɛm,</para>
  <para style="q1" vid="MIC 3:5">na sɛ wɔamma wɔn biribi anni a,</para>
  <para style="q2" vid="MIC 3:5">adiyifoɔ no siesie wɔn ho sɛ wɔbɛtu wɔn so sa.<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>Enti adeɛ bɛsa mo a morennya anisoadehunu,</para>
  <para style="q2" vid="MIC 3:6">esum bɛduru mo a morennya ahintasɛm biara.</para>
  <para style="q1" vid="MIC 3:6">Owia bɛtɔ ama adiyifoɔ no,</para>
  <para style="q2" vid="MIC 3:6">na adekyeɛ bɛdane esum ama wɔn.<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>Adepɛmuhunufoɔ ani bɛwu</para>
  <para style="q2" vid="MIC 3:7">na wɔbɛgu nsamanfrɛfoɔ anim ase.</para>
  <para style="q1" vid="MIC 3:7">Wɔn nyinaa bɛkatakata wɔn anim,</para>
  <para style="q2" vid="MIC 3:7">ɛfiri sɛ mmuaeɛ biara mfiri Onyankopɔn hɔ mma.”<verse eid="MIC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>Nanso me deɛ tumi ahyɛ me ma,</para>
  <para style="q2" vid="MIC 3:8">
    <char style="nd">Awurade</char> Honhom ahyɛ me ma</para>
  <para style="q1" vid="MIC 3:8">tenenee ne ahoɔden</para>
  <para style="q2" vid="MIC 3:8">a mede bɛpae mu aka</para>
  <para style="q1" vid="MIC 3:8">Yakob amumuyɛ ne Israel bɔne.<verse eid="MIC 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>Montie, mo Yakob efie ntuanofoɔ,</para>
  <para style="q2" vid="MIC 3:9">mo a moyɛ Israel sodifoɔ,</para>
  <para style="q1" vid="MIC 3:9">a mokyiri atɛntenenee</para>
  <para style="q2" vid="MIC 3:9">na mokyea deɛ ɛtene nyinaa;<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>Mo a mode mogyahwiegu kyekyeree Sion</para>
  <para style="q2" vid="MIC 3:10">ne awurukasɛm kyekyeree Yerusalem.<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>Nʼadikanfoɔ no gye adanmudeɛ ansa na wabu atɛn,</para>
  <para style="q2" vid="MIC 3:11">nʼasɔfoɔ gye sika ansa na wɔakyerɛkyerɛ,</para>
  <para style="q1" vid="MIC 3:11">nʼadiyifoɔ de nkɔmhyɛ ayɛ sikapɛ.</para>
  <para style="q2" vid="MIC 3:11">Nanso wɔdan <char style="nd">Awurade</char>, na wɔka sɛ,</para>
  <para style="q1" vid="MIC 3:11">“<char style="nd">Awurade</char> nni yɛn ntam anaa?</para>
  <para style="q2" vid="MIC 3:11">Ɔhaw biara remma yɛn so.”<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>Na mo enti,</para>
  <para style="q2" vid="MIC 3:12">wɔbɛfuntum Sion te sɛ afuo,</para>
  <para style="q1" vid="MIC 3:12">Yerusalem bɛyɛ mmubuiɛ,</para>
  <para style="q2" vid="MIC 3:12">na asɔredan no kokoɔ bɛyɛ sɛ nkɔfie a nkyɛkyerɛ afu wɔ so.<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">
    <char style="nd">Awurade</char> Bepɔ No</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>Nna a ɛdi akyire no mu no,</para>
  <para style="q1" vid="MIC 4:1">
    <char style="nd">Awurade</char> asɔredan bepɔ no bɛtim</para>
  <para style="q2" vid="MIC 4:1">sɛ mmepɔ no nyinaa ti;</para>
  <para style="q1" vid="MIC 4:1">ɛbɛgye din aboro nkokoɔ nyinaa,</para>
  <para style="q2" vid="MIC 4:1">na nnipa ahodoɔ bɛbɔ yuu akɔ hɔ.<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>Aman bebree bɛba abɛka sɛ,</para>
  <para style="q1" vid="MIC 4:2">“Mommra mma yɛnkɔ <char style="nd">Awurade</char> bepɔ so,</para>
  <para style="q2" vid="MIC 4:2">Yakob Onyankopɔn efie.</para>
  <para style="q1" vid="MIC 4:2">Ɔbɛkyerɛ yɛn nʼakwan,</para>
  <para style="q2" vid="MIC 4:2">sɛdeɛ yɛbɛnante soɔ.”</para>
  <para style="q1" vid="MIC 4:2">Na mmara no bɛfiri Sion aba</para>
  <para style="q2" vid="MIC 4:2">
    <char style="nd">Awurade</char> asɛm bɛfiri Yerusalem aba.<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>
    <char style="nd">Awurade</char> bɛdi amanaman ntam nsɛm</para>
  <para style="q2" vid="MIC 4:3">Aane ɔbɛsiesie ntawantawa ama aman a wɔyɛ den wɔ mmaa nyinaa.</para>
  <para style="q1" vid="MIC 4:3">Wɔde wɔn akofena bɛbɔ funtumdadeɛ</para>
  <para style="q2" vid="MIC 4:3">wɔde wɔn mpea bɛbɔ nsɔsɔwa.</para>
  <para style="q1" vid="MIC 4:3">Ɔman bi ntwe ɔman foforɔ so akofena,</para>
  <para style="q2" vid="MIC 4:3">na wɔrenyɛ ahoboa biara mma ɔko bio.<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>Obiara bɛtena ne bobe</para>
  <para style="q2" vid="MIC 4:4">anaa ne borɔdɔma nnua ase,</para>
  <para style="q1" vid="MIC 4:4">na obiara remmɛhunahuna wɔn,</para>
  <para style="q2" vid="MIC 4:4">ɛfiri sɛ, Asafo <char style="nd">Awurade</char> akasa.<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>Amanaman no nyinaa bɛtumi anante</para>
  <para style="q2" vid="MIC 4:5">wɔn anyame din mu,</para>
  <para style="q1" vid="MIC 4:5">na yɛn deɛ, yɛbɛnante <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 4:5">yɛn Onyankopɔn Din mu daa daa.<verse eid="MIC 4:5"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Atirimpɔ</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>“Saa ɛda no,” sɛdeɛ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q2" vid="MIC 4:6">“Mɛboaboa mmubuafoɔ, atukɔfoɔ</para>
  <para style="q2" vid="MIC 4:6">ɛne wɔn a mede awerɛhoɔ aba wɔn so ano.<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>Mɛma mmubuafoɔ ayɛ me nkurɔfoɔ wɔ asase no so,</para>
  <para style="q2" vid="MIC 4:7">atukɔfoɔ no bɛyɛ ɔman kɛseɛ.</para>
  <para style="q1" vid="MIC 4:7">
    <char style="nd">Awurade</char> bɛdi wɔn so ɔhene wɔ Sion bepɔ so</para>
  <para style="q2" vid="MIC 4:7">afiri da no akɔsi daa.<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>Na wo, nnwankuo no abantenten,</para>
  <para style="q2" vid="MIC 4:8">Ao, Ɔbabaa Sion, abandenden,</para>
  <para style="q1" vid="MIC 4:8">wɔde wo tete tumidie no bɛsane abrɛ wo;</para>
  <para style="q2" vid="MIC 4:8">Ɔbabaa Yerusalem nsa bɛsane aka nʼahennie.”<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>Ɛdeɛn enti na afei woresu denden,</para>
  <para style="q2" vid="MIC 4:9">wonni ɔhene anaa?</para>
  <para style="q1" vid="MIC 4:9">Wo futufoɔ ayera, na enti,</para>
  <para style="q2" vid="MIC 4:9">ɔyea aka wo sɛ ɔbaa ɔwɔ awokoɔ mu?<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>Ɔyea enti, nukanuka wo mu, Ao Ɔbabaa Sion,</para>
  <para style="q2" vid="MIC 4:10">te sɛ ɔbaa a awoɔ aka no,</para>
  <para style="q1" vid="MIC 4:10">seesei ɛsɛ sɛ wofiri kuropɔn no mu</para>
  <para style="q2" vid="MIC 4:10">kɔtena ɛserɛ so.</para>
  <para style="q1" vid="MIC 4:10">Wobɛkɔ Babilonia;</para>
  <para style="q2" vid="MIC 4:10">na ɛhɔ na wɔbɛgye woɔ.</para>
  <para style="q1" vid="MIC 4:10">Ɛhɔ na <char style="nd">Awurade</char> bɛgye wo</para>
  <para style="q2" vid="MIC 4:10">afiri wʼatamfoɔ nsam.<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>Seesei deɛ, aman bebree</para>
  <para style="q2" vid="MIC 4:11">aka abɔ mu atia wo.</para>
  <para style="q1" vid="MIC 4:11">Wɔka sɛ, “Wɔngu Sion ho fi,</para>
  <para style="q2" vid="MIC 4:11">na yɛmfa yɛn ani nhwɛ no!”<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>Nanso, wɔnnim <char style="nd">Awurade</char> adwene.</para>
  <para style="q2" vid="MIC 4:12">Wɔnte nʼagyinatuo ase.</para>
  <para style="q1" vid="MIC 4:12">Wɔnnim sɛ ɔno na ɔboaboa wɔn ano te sɛ afiafi</para>
  <para style="q2" vid="MIC 4:12">de kɔ ayuporobea.<verse eid="MIC 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>“Sɔre, na pore, Ao Ɔbabaa Sion,</para>
  <para style="q2" vid="MIC 4:13">mɛma wo dadeɛ mmɛn;</para>
  <para style="q1" vid="MIC 4:13">mɛma wo kɔbere ntɔte</para>
  <para style="q2" vid="MIC 4:13">na wobɛbubu aman bebree mu nketenkete.”</para>
  <para style="q1" vid="MIC 4:13">Wode wɔn mfasodeɛ a wɔampɛ no ɛkwan pa so bɛbrɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 4:13">wode wɔn ahonyadeɛ bɛbrɛ asase nyinaa so wura.<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">Bɔhyɛhene Bi A Ɔfiri Betlehem</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>Mommoaboa mo akodɔm ano,</para>
  <para style="q2" vid="MIC 5:1">Ao akofoɔ kuropɔn,</para>
  <para style="q1" vid="MIC 5:1">ɛfiri sɛ, atamfoɔ atwa yɛn ho ahyia.</para>
  <para style="q2" vid="MIC 5:1">Wɔde abaa bɛbɔ Israel sodifoɔ no wɔ nʼafono so.<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>“Nanso wo, Betlehem Efrata,</para>
  <para style="q2" vid="MIC 5:2">ɛwom sɛ woyɛ ketewa wɔ Yuda mmusua mu deɛ,</para>
  <para style="q1" vid="MIC 5:2">nanso, wo mu na obi bɛfiri ama me</para>
  <para style="q2" vid="MIC 5:2">a ɔbɛyɛ Israel sodifoɔ,</para>
  <para style="q2" vid="MIC 5:2">na nʼase firi teteete.”<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>Enti wɔbɛgya Israelfoɔ mu,</para>
  <para style="q2" vid="MIC 5:3">kɔsi sɛ ɔbaa a awoɔ aka no no bɛwo</para>
  <para style="q1" vid="MIC 5:3">na ne nuanom mmarima nkaeɛ</para>
  <para style="q2" vid="MIC 5:3">bɛsane akɔka Israelfoɔ ho.<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>Ɔbɛsɔre ahwɛ ne nnwankuo</para>
  <para style="q2" vid="MIC 5:4">wɔ <char style="nd">Awurade</char> ahoɔden mu,</para>
  <para style="q2" vid="MIC 5:4">wɔ <char style="nd">Awurade</char> ne Onyankopɔn din kɛseyɛ mu.</para>
  <para style="q1" vid="MIC 5:4">Na wɔbɛtena asomdwoeɛ mu, na afei</para>
  <para style="q2" vid="MIC 5:4">ne kɛseyɛ bɛduru asase awieeɛ.<verse eid="MIC 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>Na ɔbɛyɛ wɔn asomdwoeɛ.</para>
  <para style="q1" vid="MIC 5:5">Sɛ Asiriafoɔ bɛto hyɛ yɛn so,</para>
  <para style="q2" vid="MIC 5:5">na wɔbɔ nsra fa yɛn aban mu a,</para>
  <para style="q1" vid="MIC 5:5">yɛde nnwanhwɛfoɔ nson,</para>
  <para style="q2" vid="MIC 5:5">mpo ntuanofoɔ nwɔtwe bɛhyia wɔn.<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>Wɔde akofena bɛdi Asiria asase so,</para>
  <para style="q2" vid="MIC 5:6">wɔbɛtwe akofena de adi Nimrod asase so.</para>
  <para style="q1" vid="MIC 5:6">Sɛ Asiriafoɔ to hyɛ yɛn so,</para>
  <para style="q2" vid="MIC 5:6">bɔ nsra fa yɛn ahyeɛ so a,</para>
  <para style="q2" vid="MIC 5:6">ɔbɛgye yɛn afiri ne nsam.<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>Yakob asefoɔ nkaeɛ no</para>
  <para style="q2" vid="MIC 5:7">bɛfrafra nnipa bebree mu</para>
  <para style="q1" vid="MIC 5:7">te sɛ obosuo a ɛfiri <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 5:7">te sɛ osuo a ɛpete gu ɛserɛ so</para>
  <para style="q1" vid="MIC 5:7">a ɛnntwɛn ɔdasani,</para>
  <para style="q2" vid="MIC 5:7">na ɔdasani biara rentumi nsi ho ɛkwan.<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>Wɔbɛkane Yakob asefoɔ nkaeɛ no afra aman no mu,</para>
  <para style="q2" vid="MIC 5:8">wɔbɛfrafra nnipa bebree mu</para>
  <para style="q1" vid="MIC 5:8">te sɛ gyata a ɔfra mmoa mu wɔ kwaeɛ mu,</para>
  <para style="q2" vid="MIC 5:8">te sɛ gyata ba a ɔfra nnwankuo mu</para>
  <para style="q1" vid="MIC 5:8">a ɔbobɔ wɔn tete wɔn mu</para>
  <para style="q2" vid="MIC 5:8">na obiara ntumi nnye wɔn.<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>Wɔbɛma wo nsa so sɛ woadi wʼatamfoɔ so nkonim,</para>
  <para style="q2" vid="MIC 5:9">na wɔbɛsɛe wʼatamfoɔ nyinaa.<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>“Saa ɛda no,” sɛdeɛ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q1" vid="MIC 5:10">“Mɛsɛe apɔnkɔ a wowɔ</para>
  <para style="q2" vid="MIC 5:10">na mabubu wo nteaseɛnam.<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>Mɛsɛe nkuropɔn a ɛwɔ wʼasase so</para>
  <para style="q2" vid="MIC 5:11">na madwiri wo banbɔ denden nyinaa agu.<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>Mɛsɛe wʼabayisɛm</para>
  <para style="q2" vid="MIC 5:12">na wo ntafowayie to bɛtwa.<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>Mɛsɛe nsɛsodeɛ a wode wo nsa ayɛ</para>
  <para style="q2" vid="MIC 5:13">ne aboɔ ahoni a wowɔ no,</para>
  <para style="q1" vid="MIC 5:13">na worenkoto nsɔre</para>
  <para style="q2" vid="MIC 5:13">wo nsa ano adwuma bio.<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>Mɛtutu Asera afɔrebukyia no afiri wo mu</para>
  <para style="q2" vid="MIC 5:14">na masɛe wo nkuropɔn.<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>Aman a wɔantie mʼasɛm no nyinaa,</para>
  <para style="q2" vid="MIC 5:15">mede abufuo ne abufuhyeɛ bɛtɔ wɔn so wedeɛ.”<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">
    <char style="nd">Awurade</char> Soboɔ A Ɔbɔ Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>Montie asɛm a <char style="nd">Awurade</char> reka:</para>
  <para style="q1" vid="MIC 6:1">“Monsɔre na mommɔ mo nkuro wɔ mmepɔ no anim;</para>
  <para style="q2" vid="MIC 6:1">momma nkokoɔ nte deɛ mowɔ ka.<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>“Na afei Ao, mmepɔ, montie <char style="nd">Awurade</char> soboɔ;</para>
  <para style="q2" vid="MIC 6:2">tie, asase nnyinasoɔ a ɛwɔ hɔ daa.</para>
  <para style="q1" vid="MIC 6:2">Na <char style="nd">Awurade</char> wɔ asɛm a ɛtia ne nkurɔfoɔ;</para>
  <para style="q2" vid="MIC 6:2">ɔrebɔ Israel soboɔ.<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>“Me nkurɔfoɔ, ɛdeɛn na mayɛ mo?</para>
  <para style="q2" vid="MIC 6:3">Mede adesoa bi asoa mo? Mommua me!<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>Meyii mo firii Misraim</para>
  <para style="q2" vid="MIC 6:4">megyee mo firii nkoasom asase so.</para>
  <para style="q1" vid="MIC 6:4">Mesomaa Mose bɛdii mo anim</para>
  <para style="q2" vid="MIC 6:4">Aaron ne Miriam nso.<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>Me nkurɔfoɔ, monkae</para>
  <para style="q2" vid="MIC 6:5">afotuo a Moabhene Balak, maeɛ</para>
  <para style="q2" vid="MIC 6:5">ɛne mmuaeɛ a Beor babarima Balaam maeɛ.</para>
  <para style="q1" vid="MIC 6:5">Monkae mo akwantuo a motu firii Sitim kɔɔ Gilgal,</para>
  <para style="q2" vid="MIC 6:5">na monhunu <char style="nd">Awurade</char> akwantenenee.”<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>Ɛdeɛn na memfa mmra <char style="nd">Awurade</char> anim</para>
  <para style="q2" vid="MIC 6:6">mmɛkoto ɔsorosoro Onyankopɔn no?</para>
  <para style="q1" vid="MIC 6:6">Memfa anantwie mma a wadi afe</para>
  <para style="q2" vid="MIC 6:6">mmɛbɔ ɔhyeɛ afɔdeɛ wɔ nʼanim anaa?<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>
    <char style="nd">Awurade</char> ani bɛsɔ nnwennini mpempem</para>
  <para style="q2" vid="MIC 6:7">ne ngo ɔpedu a ɛretene sɛ nsubɔntene anaa?</para>
  <para style="q1" vid="MIC 6:7">Memfa mʼabakan mmɔ me bɔne ho afɔdeɛ,</para>
  <para style="q2" vid="MIC 6:7">anaa me yafunu mu mma, me kra bɔne nti?<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>Ɔde deɛ ɛyɛ akyerɛ wo, Ao onipa.</para>
  <para style="q2" vid="MIC 6:8">Na ɛdeɛn na <char style="nd">Awurade</char> hwehwɛ afiri wo hɔ?</para>
  <para style="q1" vid="MIC 6:8">Yɛ adetenenee, hunu afoforɔ mmɔbɔ,</para>
  <para style="q2" vid="MIC 6:8">na wo ne wo Onyankopɔn nnante ahobrɛaseɛ mu.<verse eid="MIC 6:8"/></para>
  <para style="s1">Israel Afɔdie Ne Asotwe</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>Montie! <char style="nd">Awurade</char> refrɛ kuropɔn no,</para>
  <para style="q2" vid="MIC 6:9">Wo din suro yɛ nyansahu,</para>
  <para style="q2" vid="MIC 6:9">“Monsuro Abaa no ne deɛ ɔmaa no tumi no.<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>Mo amumuyɛfoɔ, menkɔ so mma me werɛ mfiri mo ahonya a monam nsisie so apɛ,</para>
  <para style="q2" vid="MIC 6:10">ne nkontompo susukora a ɛde nnome ba no anaa?<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>Mennyae onipa a ɔkura nsania a wɔamia mu,</para>
  <para style="q2" vid="MIC 6:11">ne nsisie nkariboɔ</para>
  <para style="q2" vid="MIC 6:11">na ɔmfa ne ho nni anaa?<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>Adefoɔ a wɔwɔ mo mu no di akakabensɛm;</para>
  <para style="q2" vid="MIC 6:12">mo nkurɔfoɔ no yɛ atorofoɔ</para>
  <para style="q1" vid="MIC 6:12">na wɔn tɛkrɛma ka nnaadaasɛm.<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>Ɛno enti, mafiri aseɛ resɛe mo,</para>
  <para style="q2" vid="MIC 6:13">Mo bɔne ahodoɔ enti, mɛsɛe mo.<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>Mobɛdidi, nanso moremmee;</para>
  <para style="q2" vid="MIC 6:14">ɛkɔm bɛkɔ so ade mo.</para>
  <para style="q1" vid="MIC 6:14">Mobɛboaboa ano nanso ɛrenkɔsi hwee,</para>
  <para style="q2" vid="MIC 6:14">ɛfiri sɛ mede deɛ moakora no bɛma akofena.<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>Mobɛdua nanso morentwa.</para>
  <para style="q2" vid="MIC 6:15">Mobɛkyi ngo dua mu ngo, nanso morensra bi.</para>
  <para style="q2" vid="MIC 6:15">Mobɛtiatia bobe so, nanso morennom nsã a mobɛnya afiri mu no bi.<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>Moadi Omri mmara so.</para>
  <para style="q2" vid="MIC 6:16">Moayɛ deɛ wɔyɛɛ wɔ Ahab efie.</para>
  <para style="q2" vid="MIC 6:16">Moasua wɔn nneyɛeɛ no bi,</para>
  <para style="q1" vid="MIC 6:16">ɛno enti mɛma ɔsɛeɛ aba mo so.</para>
  <para style="q2" vid="MIC 6:16">Wɔbɛsere mo nkurɔfoɔ;</para>
  <para style="q2" vid="MIC 6:16">na amanaman bɛbu mo animtia.”<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">Israel Ahohia</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>Mayɛ mmɔbɔ!</para>
  <para style="q1" vid="MIC 7:1">Mete sɛ aduaba tefoɔ a</para>
  <para style="q2" vid="MIC 7:1">otwa berɛ akyi mekɔdi mpɛpɛ wɔ bobe turo mu;</para>
  <para style="q1" vid="MIC 7:1">mennya bobe siaw na madi,</para>
  <para style="q2" vid="MIC 7:1">borɔdɔma aba a ɛdi ɛkan a me kɔn dɔ nso, saa ara.<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>Moapra Nyamefɛrefoɔ nyinaa afiri asase so.</para>
  <para style="q2" vid="MIC 7:2">Anka ɔbaako a ɔtene mpo.</para>
  <para style="q1" vid="MIC 7:2">Nnipa nyinaa tetɛ na wɔhwehwɛ sɛ wɔbɛka mogya agu;</para>
  <para style="q2" vid="MIC 7:2">wɔsunsum wɔn ho wɔn ho mfidie.<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>Nsa mmienu no nyinaa akokwa bɔneyɛ mu;</para>
  <para style="q2" vid="MIC 7:3">sodifoɔ bisa akyɛdeɛ,</para>
  <para style="q1" vid="MIC 7:3">ɔtemmufoɔ gye adanmudeɛ,</para>
  <para style="q2" vid="MIC 7:3">wɔn a tumi wɔ wɔn nsa mu no yɛ deɛ wɔpɛ,</para>
  <para style="q2" vid="MIC 7:3">wɔn nyinaa bɔ mu dwene amumuyɛ ho.<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>Deɛ ɔyɛ wɔ wɔn mu no te sɛ hwerɛmo;</para>
  <para style="q2" vid="MIC 7:4">deɛ ɔtene pa ara no, nkasɛɛ ban yɛ sene no.</para>
  <para style="q1" vid="MIC 7:4">Wʼatɛmmuda no aso,</para>
  <para style="q2" vid="MIC 7:4">ɛda a Onyankopɔn reba wo nsrahwɛ.</para>
  <para style="q2" vid="MIC 7:4">Yei ne ɛberɛ a wɔn ani so bɛyɛ wɔn totɔtotɔ.<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>Nnye obiara nni;</para>
  <para style="q2" vid="MIC 7:5">mfa wo werɛ nhyɛ adamfo mu.</para>
  <para style="q1" vid="MIC 7:5">Mpo ɔbaa a ɔda wo koko mu no</para>
  <para style="q2" vid="MIC 7:5">to wo tɛkrɛma nnareka wɔ ne ho.<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>Ɔbabarima twiri nʼagya,</para>
  <para style="q2" vid="MIC 7:6">Ɔbabaa sɔre tia ne maame,</para>
  <para style="q1" vid="MIC 7:6">asebaa nso tia nʼase</para>
  <para style="q2" vid="MIC 7:6">na onipa biara atamfoɔ bɛfiri ɔno ankasa ne fiefoɔ mu.<verse eid="MIC 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>Me deɛ, mede anidasoɔ hwɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 7:7">Metwɛn me Nkwagyeɛ Onyankopɔn;</para>
  <para style="q2" vid="MIC 7:7">na me Onyankopɔn bɛtie me.<verse eid="MIC 7:7"/></para>
  <para style="s1">Israel Bɛsɔre</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>Mma wʼani nnye, me ɔtamfoɔ!</para>
  <para style="q2" vid="MIC 7:8">Mahwe ase deɛ, nanso mɛsɔre.</para>
  <para style="q1" vid="MIC 7:8">Esum aduru me deɛ,</para>
  <para style="q2" vid="MIC 7:8">nanso <char style="nd">Awurade</char> bɛyɛ me hann.<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>Sɛ mayɛ bɔne atia no enti,</para>
  <para style="q2" vid="MIC 7:9">
    <char style="nd">Awurade</char> abufuo bɛba me so,</para>
  <para style="q1" vid="MIC 7:9">kɔsi sɛ ɔbɛka mʼasɛm ama me</para>
  <para style="q2" vid="MIC 7:9">na wada me bembuo adi.</para>
  <para style="q1" vid="MIC 7:9">Ɔde me bɛba hann no mu;</para>
  <para style="q2" vid="MIC 7:9">na mɛhunu ne tenenee.<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>Afei, mʼatamfoɔ bɛhunu</para>
  <para style="q2" vid="MIC 7:10">na wɔn ani bɛwu,</para>
  <para style="q1" vid="MIC 7:10">deɛ ɔsee me sɛ,</para>
  <para style="q2" vid="MIC 7:10">“Ɛhe na <char style="nd">Awurade</char> wo Onyankopɔn no wɔ?”</para>
  <para style="q1" vid="MIC 7:10">Mʼani bɛhunu nʼahweaseɛ;</para>
  <para style="q2" vid="MIC 7:10">mpo seesei no, wɔbɛtiatia ne so</para>
  <para style="q2" vid="MIC 7:10">te sɛ atɛkyɛ a ɛwɔ mmɔntene so.<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>Ɛda a wɔbɛto wʼafasuo no bɛba,</para>
  <para style="q2" vid="MIC 7:11">ɛda a wɔbɛtrɛ wʼahyeɛ mu.<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>Ɛda no, nnipa bɛba wo nkyɛn</para>
  <para style="q2" vid="MIC 7:12">firi Asiria ne Misraim nkuropɔn mu,</para>
  <para style="q1" vid="MIC 7:12">mpo wɔbɛfiri Misraim akɔsi Eufrate</para>
  <para style="q2" vid="MIC 7:12">afiri ɛpo akɔsi ɛpo</para>
  <para style="q2" vid="MIC 7:12">ne bepɔ so akɔsi bepɔ so.<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>Asase no bɛyɛ amanfo ɛsiane nnipa a wɔtete so</para>
  <para style="q2" vid="MIC 7:13">ne wɔn nneyɛɛ enti.<verse eid="MIC 7:13"/></para>
  <para style="s1">Mpaeɛbɔ Ne Nkamfoɔ</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>Fa wo poma di wo nkurɔfoɔ anim,</para>
  <para style="q2" vid="MIC 7:14">nnwan a wɔyɛ wʼagyapadeɛ no,</para>
  <para style="q1" vid="MIC 7:14">a wɔn nko ara tete kwaeɛ mu</para>
  <para style="q2" vid="MIC 7:14">wira frɔmfrɔm adidibea hɔ.</para>
  <para style="q1" vid="MIC 7:14">Ma wɔn nnidi wɔ Basan ne Gilead</para>
  <para style="q2" vid="MIC 7:14">sɛ tete nna no mu.<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>“Mɛyɛ anwanwadeɛ akyerɛ wo,</para>
  <para style="q2" vid="MIC 7:15">sɛdeɛ meyɛɛ nna a wofiri Misraim baeɛ mu no.”<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>Aman bɛhunu wo na wɔn ani bɛwu,</para>
  <para style="q2" vid="MIC 7:16">wɔn a tumi nyinaa afiri wɔn nsa no.</para>
  <para style="q1" vid="MIC 7:16">Wɔde wɔn nsa bɛtuatua wɔn ano</para>
  <para style="q2" vid="MIC 7:16">na wɔn aso bɛsisi.<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>Wɔbɛdi dɔteɛ sɛ awɔ,</para>
  <para style="q2" vid="MIC 7:17">ne mmoa a wɔwea fam.</para>
  <para style="q1" vid="MIC 7:17">Wɔde ahopopoɔ bɛfiri wɔn abɔn mu aba;</para>
  <para style="q2" vid="MIC 7:17">wɔde suro bɛdane wɔn ho ama <char style="nd">Awurade</char> yɛn Onyankopɔn,</para>
  <para style="q2" vid="MIC 7:17">na wɔbɛsuro wo.<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>Hwan na ɔte sɛ wo,</para>
  <para style="q2" vid="MIC 7:18">Onyankopɔn a wode bɔne kyɛ?</para>
  <para style="q1" vid="MIC 7:18">Wo a wode agyanom asefoɔ nkaeɛ amumuyɛ kyɛ wɔn.</para>
  <para style="q2" vid="MIC 7:18">Wʼabofuo nntena hɔ daa</para>
  <para style="q2" vid="MIC 7:18">na mmom wʼani gye sɛ wobɛda mmɔborɔhunu adi.<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>Wobɛhunu yɛn mmɔbɔ bio,</para>
  <para style="q2" vid="MIC 7:19">wobɛtiatia yɛn bɔne so,</para>
  <para style="q2" vid="MIC 7:19">na woato yɛn amumuyɛ agu ɛpo bunu mu.<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>Wobɛyɛ nokwafoɔ ama Yakob</para>
  <para style="q2" vid="MIC 7:20">na wahunu Abraham mmɔbɔ</para>
  <para style="q1" vid="MIC 7:20">sɛdeɛ wokaa yɛn agyanom ntam</para>
  <para style="q2" vid="MIC 7:20">teteete no.<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
