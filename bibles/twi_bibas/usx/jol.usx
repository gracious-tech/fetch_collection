<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Yoɛl</para>
  <para style="toc1">Odiyifoɔ Yoɛl Nwoma</para>
  <para style="toc2">Yoɛl</para>
  <para style="toc3">Yoɛl</para>
  <para style="mt2">Odiyifoɔ</para>
  <para style="mt1">Yoɛl</para>
  <para style="mt2">Nwoma</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>
    <char style="nd">Awurade</char> asɛm a ɛbaa Petuel babarima Yoɛl so nie.<verse eid="JOL 1:1"/></para>
  <para style="s1">Ɛda A Ntutummɛ No Bɛba</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>Montie saa asɛm yi, mo mpanimfoɔ;</para>
  <para style="q2" vid="JOL 1:2">montie, mo a mote asase no so nyinaa.</para>
  <para style="q1" vid="JOL 1:2">Asɛm bi a ɛte sɛi asi mo mmerɛ so</para>
  <para style="q2" vid="JOL 1:2">anaa mo mpanimfoɔ mmerɛ so pɛn?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>Monka nkyerɛ mo mma,</para>
  <para style="q2" vid="JOL 1:3">na mo mma nso nka nkyerɛ wɔn mma</para>
  <para style="q2" vid="JOL 1:3">na wɔn mma nso nka nkyerɛ awoɔ ntoatoasoɔ a ɛdi soɔ no.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>Deɛ ntutummɛ kuo no gyaeɛ no</para>
  <para style="q2" vid="JOL 1:4">ntutummɛ akɛseɛ no awe</para>
  <para style="q1" vid="JOL 1:4">deɛ ntutummɛ akɛseɛ no gyaeɛ no</para>
  <para style="q2" vid="JOL 1:4">ntutummɛ nkumaa no awe</para>
  <para style="q1" vid="JOL 1:4">deɛ ntutummɛ nkumaa no gyaeɛ no</para>
  <para style="q2" vid="JOL 1:4">ntutummɛ afoforɔ awe.<verse eid="JOL 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>Mo asabofoɔ, monyane, na monsu!</para>
  <para style="q2" vid="JOL 1:5">Mo a monom bobesa nyinaa, montwa adwo;</para>
  <para style="q1" vid="JOL 1:5">montwa adwo ɛfiri sɛ nsã foforɔ no</para>
  <para style="q2" vid="JOL 1:5">wɔayi afiri mo ano.<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>Ɔman bi atu mʼasase so sa</para>
  <para style="q2" vid="JOL 1:6">ɛdɔm a wɔyɛ den na wɔntumi nkane wɔn;</para>
  <para style="q1" vid="JOL 1:6">wɔn se te sɛ gyata se</para>
  <para style="q2" vid="JOL 1:6">na wɔwɔ gyatabereɛ sebɔmmɔfoɔ.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>Wɔasɛe me bobe</para>
  <para style="q2" vid="JOL 1:7">ne me borɔdɔma nnua.</para>
  <para style="q1" vid="JOL 1:7">Wawaawae nnua no ho bona,</para>
  <para style="q2" vid="JOL 1:7">ato agu</para>
  <para style="q2" vid="JOL 1:7">agya ne mman a ayɛ fitaa hɔ.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>Di awerɛhoɔ sɛ ababaawa a ɔfira ayitoma</para>
  <para style="q2" vid="JOL 1:8">na ɔresu ne kunu a ɔwaree no ne mmabaawaberɛ mu.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>Aduane ne ahwiesa afɔrebɔdeɛ,</para>
  <para style="q2" vid="JOL 1:9">wɔayi afiri <char style="nd">Awurade</char> efie.</para>
  <para style="q1" vid="JOL 1:9">Asɔfoɔ no retwa adwoɔ,</para>
  <para style="q2" vid="JOL 1:9">wɔn a wɔsom wɔ <char style="nd">Awurade</char> anim no.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>Mfuo asɛe,</para>
  <para style="q2" vid="JOL 1:10">asase no so awo wesee</para>
  <para style="q1" vid="JOL 1:10">aduane no asɛe</para>
  <para style="q2" vid="JOL 1:10">nsã foforɔ no awe</para>
  <para style="q2" vid="JOL 1:10">ngo nyinaa asa.<verse eid="JOL 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>Mo ani nwu, mo akuafoɔ,</para>
  <para style="q2" vid="JOL 1:11">mo ntwa adwo, mo a modua bobe;</para>
  <para style="q1" vid="JOL 1:11">Monsi apinie mma ayuo ne atokoɔ,</para>
  <para style="q2" vid="JOL 1:11">ɛfiri sɛ otwaberɛ no asɛe.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>Bobe no akusa</para>
  <para style="q2" vid="JOL 1:12">na borɔdɔma nnua no awuwu.</para>
  <para style="q1" vid="JOL 1:12">Ateaa nnua, mmɛdua, aperɛ ne</para>
  <para style="q2" vid="JOL 1:12">nnua a ɛwɔ mfuo no so nyinaa ahye.</para>
  <para style="q1" vid="JOL 1:12">Nokorɛm, anigyeɛ a nnipa wɔ no</para>
  <para style="q2" vid="JOL 1:12">atu ayera.<verse eid="JOL 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>Momfira ayitoma na monni awerɛhoɔ, Ao asɔfoɔ;</para>
  <para style="q2" vid="JOL 1:13">mo a mosom afɔrebukyia anim, montwa adwo.</para>
  <para style="q1" vid="JOL 1:13">Momfira ayitoma mmɛsiri pɛ</para>
  <para style="q2" vid="JOL 1:13">mo a mosom Onyankopɔn anim;</para>
  <para style="q1" vid="JOL 1:13">ɛfiri sɛ aduane ne ahwiesa afɔrebɔdeɛ no</para>
  <para style="q2" vid="JOL 1:13">ɛto atwa wɔ Onyankopɔn efie.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>Mommɔ mmuadadie kronkron ho dawuro;</para>
  <para style="q2" vid="JOL 1:14">momfrɛ nhyiamu kronkron.</para>
  <para style="q1" vid="JOL 1:14">Monfrɛ mpanimfoɔ</para>
  <para style="q2" vid="JOL 1:14">ne wɔn a wɔte asase no so nyinaa</para>
  <para style="q1" vid="JOL 1:14">mmra <char style="nd">Awurade</char> mo Onyankopɔn efie</para>
  <para style="q2" vid="JOL 1:14">na wɔmmesu mfrɛ <char style="nd">Awurade</char>.<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>Ɛda no aba!</para>
  <para style="q2" vid="JOL 1:15">
    <char style="nd">Awurade</char> ɛda no abɛn;</para>
  <para style="q2" vid="JOL 1:15">Ɛbɛba sɛ ɔsɛeɛ a ɛfiri Otumfoɔ hɔ.<verse eid="JOL 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>Yɛnnhunuu sɛ aduane ho ayɛ na,</para>
  <para style="q2" vid="JOL 1:16">sɛ anigyeɛ ne ahosɛpɛ nso to atwa</para>
  <para style="q2" vid="JOL 1:16">wɔ yɛn Onyankopɔn efie anaa?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>Aba no wu wɔ asase wesee mu,</para>
  <para style="q2" vid="JOL 1:17">adekoradan abubu,</para>
  <para style="q1" vid="JOL 1:17">aburopata nso ho nni mfasoɔ,</para>
  <para style="q2" vid="JOL 1:17">ɛfiri sɛ nnuane no ahye.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>Sɛdeɛ anantwie su!</para>
  <para style="q2" vid="JOL 1:18">Na anantwikuo kyinkyini kwa.</para>
  <para style="q1" vid="JOL 1:18">Nnwankuo mpo rebrɛ</para>
  <para style="q2" vid="JOL 1:18">ɛfiri sɛ wɔnni adidibea.<verse eid="JOL 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>
    <char style="nd">Awurade</char>, wo na mesu frɛ wo,</para>
  <para style="q2" vid="JOL 1:19">ɛfiri sɛ ogya ahye ɛserɛ so adidibea</para>
  <para style="q2" vid="JOL 1:19">na ogyaframa ahye mfuo no so nnua nyinaa.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>Wiram mmoa mpo pere hwehwɛ wo.</para>
  <para style="q2" vid="JOL 1:20">Nsuwansuwa awewe,</para>
  <para style="q2" vid="JOL 1:20">na ogya ahye ɛserɛ so adidibea.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">Ntutummɛ Dɔm</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>Hyɛn totorobɛnto no wɔ Sion;</para>
  <para style="q2" vid="JOL 2:1">hyɛn abɛn no wɔ me bepɔ kronkron no so.</para>
  <para style="q1" vid="JOL 2:1">Ma wɔn a wɔte asase no so nyinaa ho mpopo,</para>
  <para style="q2" vid="JOL 2:1">ɛfiri sɛ <char style="nd">Awurade</char> ɛda no reba,</para>
  <para style="q2" vid="JOL 2:1">na abɛn koraa.<verse eid="JOL 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2"/>Esum ne kusukuukuu ɛda.</para>
  <para style="q2" vid="JOL 2:2">Omununkum ne esum kabii ɛda.</para>
  <para style="q1" vid="JOL 2:2">Sɛdeɛ adekyeeɛ hann trɛtrɛ wɔ mmepɔ so no,</para>
  <para style="q2" vid="JOL 2:2">saa ara na asraadɔm a wɔ dɔɔso na wɔyɛ den ba no teɛ.</para>
  <para style="q1" vid="JOL 2:2">Wɔnhunuu wɔn sɛso bi da,</para>
  <para style="q2" vid="JOL 2:2">na wɔrenhunu ne sɛso nso da.<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>Egya rehye wɔ wɔn anim,</para>
  <para style="q2" vid="JOL 2:3">ogyaframa dɛre wɔ wɔn akyi,</para>
  <para style="q1" vid="JOL 2:3">asase a ɛda wɔn anim no te sɛ Eden turo,</para>
  <para style="q2" vid="JOL 2:3">deɛ ɛda wɔn akyi no te sɛ anweatam,</para>
  <para style="q2" vid="JOL 2:3">biribiara nni hɔ a ɛpa wɔn ani so.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>Wɔte sɛ apɔnkɔ.</para>
  <para style="q2" vid="JOL 2:4">Wɔhurihuri te sɛ apɔnkɔsotefoɔ asraadɔm.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>Wɔyɛ gyegyeegye te sɛ nteaseɛnam</para>
  <para style="q2" vid="JOL 2:5">na wɔtu fa mmepɔ atifi,</para>
  <para style="q1" vid="JOL 2:5">wɔte sɛ ogyaframa a ɛrehyeɛ wira dwaneeɛ,</para>
  <para style="q2" vid="JOL 2:5">wɔte sɛ asraadɔm akantinka a wɔrekɔ ɔsa.<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>Aman ani bɔ wɔn so a, ehu bɔ wɔn;</para>
  <para style="q2" vid="JOL 2:6">na wɔn anim to hoa.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>Wɔko kɔ wɔn anim te sɛ akofoɔ;</para>
  <para style="q2" vid="JOL 2:7">wɔforo afasuo te sɛ asraafoɔ</para>
  <para style="q1" vid="JOL 2:7">na wɔn nyinaa kɔ wɔn anim tee,</para>
  <para style="q2" vid="JOL 2:7">na wɔmmane benkum anaa nifa.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>Obiara ntwintwane ɔfoforɔ anan mu;</para>
  <para style="q2" vid="JOL 2:8">obiara nante kɔ nʼanim tee.</para>
  <para style="q1" vid="JOL 2:8">Wɔbu fa banbɔeɛ so,</para>
  <para style="q2" vid="JOL 2:8">na wɔpem kɔ wɔn anim ara.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>Wɔto hyɛ kuropɔn no so</para>
  <para style="q2" vid="JOL 2:9">wɔtu mmirika fa afasuo no so</para>
  <para style="q1" vid="JOL 2:9">wɔforo kɔ afie mu,</para>
  <para style="q2" vid="JOL 2:9">wɔfa mpoma mu te sɛ akorɔmfoɔ.<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>Asase woso wɔ wɔn anim,</para>
  <para style="q2" vid="JOL 2:10">na ɔsoro hinhim.</para>
  <para style="q1" vid="JOL 2:10">Owia ne ɔsrane duru sum,</para>
  <para style="q2" vid="JOL 2:10">na nsoromma nnhyerɛn bio.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>
    <char style="nd">Awurade</char> bobom</para>
  <para style="q2" vid="JOL 2:11">de di nʼasraadɔm no anim.</para>
  <para style="q1" vid="JOL 2:11">Nʼakodɔm no dɔɔso bebree,</para>
  <para style="q2" vid="JOL 2:11">ahoɔdenfoɔ ne wɔn a wɔdi nʼahyɛdeɛ so.</para>
  <para style="q1" vid="JOL 2:11">
    <char style="nd">Awurade</char> ɛda no yɛ kɛseɛ na ɛyɛ hu;</para>
  <para style="q2" vid="JOL 2:11">hwan na ɔbɛtumi agyina ano?<verse eid="JOL 2:11"/></para>
  <para style="s1">Ahonu</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“Na afei,” sɛdeɛ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q2" vid="JOL 2:12">“Sane fa wʼakoma nyinaa bra me nkyɛn,</para>
  <para style="q2" vid="JOL 2:12">wɔ akɔnkyene, esu ne awerɛhoɔ mu.”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>Sunsuane wʼakoma</para>
  <para style="q2" vid="JOL 2:13">na ɛnnyɛ wo ntadeɛ mu.</para>
  <para style="q1" vid="JOL 2:13">Sane bra <char style="nd">Awurade</char> wo Onyankopɔn nkyɛn,</para>
  <para style="q2" vid="JOL 2:13">ɛfiri sɛ, ɔyɛ ɔdomfoɔ, ne yam yɛ.</para>
  <para style="q1" vid="JOL 2:13">Ne bo kyɛre fu na ne dɔ boro so,</para>
  <para style="q2" vid="JOL 2:13">na ɛnnyɛ no anigye sɛ ɔtwe yɛn aso.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>Hwan na ɔnim? Ebia ɔbɛsesa nʼadwene na wahunu mmɔbɔ</para>
  <para style="q2" vid="JOL 2:14">na wagya nhyira,</para>
  <para style="q1" vid="JOL 2:14">a ɛyɛ aduane ne hwiesa afɔrebɔdeɛ</para>
  <para style="q2" vid="JOL 2:14">a mode ma <char style="nd">Awurade</char> mo Onyankopɔn no.<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>Hyɛn totorobɛnto wɔ Sion!</para>
  <para style="q2" vid="JOL 2:15">Mommɔ akɔnkyene kronkron ho dawuro,</para>
  <para style="q1" vid="JOL 2:15">momfrɛ nhyiamu kronkron.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>Mommoaboa nnipa no ano</para>
  <para style="q2" vid="JOL 2:16">monte nhyiamu no ho na ɛnyɛ kronkron;</para>
  <para style="q1" vid="JOL 2:16">mommoaboa mpanimfoɔ,</para>
  <para style="q2" vid="JOL 2:16">mmɔfra ne mmaa a wɔrema nufoɔ ano</para>
  <para style="q2" vid="JOL 2:16">Ma ayeforɔ ne ayeforɔkunu mfiri wɔn pia mu mmra.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>Asɔfoɔ a wɔsom wɔ <char style="nd">Awurade</char> anim no,</para>
  <para style="q2" vid="JOL 2:17">nsu wɔ afɔrebukyia no ne abrannaa no ntam;</para>
  <para style="q1" vid="JOL 2:17">na wɔn nka sɛ, “<char style="nd">Awurade</char> fa wo nkurɔfoɔ ho kyɛ wɔn.</para>
  <para style="q2" vid="JOL 2:17">Mma wʼagyapadeɛ nnyɛ ahohoradeɛ</para>
  <para style="q2" vid="JOL 2:17">anaa fɛdideɛ wɔ aman no mu.</para>
  <para style="q1" vid="JOL 2:17">Adɛn enti na ɛsɛ sɛ wobisa wɔ nnipa no mu sɛ,</para>
  <para style="q2" vid="JOL 2:17">‘Wɔn Onyame no wɔ he?’ ”<verse eid="JOL 2:17"/></para>
  <para style="s1">Awurade Mmuaeɛ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>Na <char style="nd">Awurade</char> bɛtwe ninkunu wɔ nʼasase ho</para>
  <para style="q2" vid="JOL 2:18">na ne nkurɔfoɔ ayɛ no mmɔbɔ.<verse eid="JOL 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19"/>
    <char style="nd">Awurade</char> bɛbua sɛ,</para>
  <para style="q2" vid="JOL 2:19">“Merebrɛ mo aduane, nsã foforɔ ne ngo,</para>
  <para style="q1" vid="JOL 2:19">a ɛbɛso mo ama mo amee pintinn.</para>
  <para style="q2" vid="JOL 2:19">Merenyɛ mo ahohoradeɛ</para>
  <para style="q2" vid="JOL 2:19">mma aman no bio.<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“Mɛpam atifi fam asraadɔm no afiri wo nkyɛn akɔ akyirikyiri,</para>
  <para style="q2" vid="JOL 2:20">mɛpia wɔn akɔ asase a awoɔ na ɛyɛ bonini soɔ.</para>
  <para style="q1" vid="JOL 2:20">Adonten dɔm no bɛmem wɔ apueeɛ ɛpo no mu,</para>
  <para style="q2" vid="JOL 2:20">na kyidɔm no bɛmem wɔ Mfimfini Po no mu.</para>
  <para style="q1" vid="JOL 2:20">Na afunu no bɛbɔn</para>
  <para style="q2" vid="JOL 2:20">na nka no bɛtu.”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">Nokorɛm wayɛ nneɛma akɛseɛ.<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>Monnsuro, me nkurɔfoɔ!</para>
  <para style="q2" vid="JOL 2:21">Momma mo ani nnye, na monsɛpɛ mo ho.</para>
  <para style="q1" vid="JOL 2:21">Nokorɛm <char style="nd">Awurade</char> ayɛ nneɛma akɛseɛ.<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>Monnsuro, mo wiram mmoa!</para>
  <para style="q2" vid="JOL 2:22">Ɛfiri sɛ ɛserɛ so adidibea reyɛ frɔmm.</para>
  <para style="q1" vid="JOL 2:22">Nnua no reso wɔn aba;</para>
  <para style="q2" vid="JOL 2:22">borɔdɔma ne bobe nso reso wɔn aba.<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>Momma mo ani nnye, mo Sion mma,</para>
  <para style="q2" vid="JOL 2:23">Mo nni ahurisi wɔ <char style="nd">Awurade</char> mo Onyankopɔn mu,</para>
  <para style="q1" vid="JOL 2:23">ɛfiri sɛ watɔ nsuo ama mo,</para>
  <para style="q2" vid="JOL 2:23">ne nokorɛdie enti.</para>
  <para style="q1" vid="JOL 2:23">Watɔ nsuo bebree ama mo</para>
  <para style="q2" vid="JOL 2:23">wɔ ne berɛ mu te sɛ kane no.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>Aduane bɛyɛ ayuporobea hɔ ma</para>
  <para style="q2" vid="JOL 2:24">nsã foforɔ ne ngo bɛbu so wɔ kyi amena mu.<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“Mɛhyɛ mo anan mu,</para>
  <para style="q2" vid="JOL 2:25">deɛ mohwereeɛ</para>
  <para style="q2" vid="JOL 2:25">mfeɛ dodoɔ a ntutummɛ bɛsɛee mo nneɛma,</para>
  <para style="q1" vid="JOL 2:25">ntutummɛ akɛseɛ ne nkumaa,</para>
  <para style="q2" vid="JOL 2:25">ne wɔn a aka no nyinaa,</para>
  <para style="q2" vid="JOL 2:25">me dɔm a mesomaa wɔn baa mo so no.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>Wobɛdidi amee,</para>
  <para style="q2" vid="JOL 2:26">na wobɛyi <char style="nd">Awurade</char> wo Onyankopɔn din ayɛ.</para>
  <para style="q1" vid="JOL 2:26">Ɔno na wayɛ anwanwadeɛ ama wo;</para>
  <para style="q2" vid="JOL 2:26">me nkurɔfoɔ ani renwu bio.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>Afei, wobɛhunu sɛ, mewɔ Israel,</para>
  <para style="q2" vid="JOL 2:27">wobɛhunu sɛ mene <char style="nd">Awurade</char>, wo Onyankopɔn,</para>
  <para style="q1" vid="JOL 2:27">na obiara nni hɔ sɛ me;</para>
  <para style="q2" vid="JOL 2:27">Me nkurɔfoɔ ani renwu bio da.”<verse eid="JOL 2:27"/></para>
  <para style="s1">Awurade Ɛda</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“Na akyire yi,</para>
  <para style="q2" vid="JOL 2:28">mɛhwie me honhom agu nnipa nyinaa so,</para>
  <para style="q1" vid="JOL 2:28">mo mmammarima ne mo mmammaa bɛhyɛ nkɔm,</para>
  <para style="q2" vid="JOL 2:28">mo nkɔkoraa bɛsoso adaeɛ,</para>
  <para style="q1" vid="JOL 2:28">mo mmeranteɛ bɛnya anisoadehunu.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>Saa mmerɛ no mu no,</para>
  <para style="q2" vid="JOL 2:29">mɛhwie me Honhom agu</para>
  <para style="q1" vid="JOL 2:29">mʼasomfoɔ so, mmarima ne mmaa.<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>Mɛyɛ anwanwadeɛ wɔ ɔsoro ne asase so,</para>
  <para style="q2" vid="JOL 2:30">mede mogya, ogya ne wisie kumɔnn.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>Ansa na Awurade ɛda kɛseɛ no bɛba no, owia bɛduru sum na ɔsrane nso ayɛ sɛ mogya.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>Na obiara a ɔbɔ <char style="nd">Awurade</char> din no,</para>
  <para style="q2" vid="JOL 2:32">wɔbɛgye no nkwa.</para>
  <para style="q1" vid="JOL 2:32">Ɛfiri sɛ nkwagyeɛ bɛba</para>
  <para style="q2" vid="JOL 2:32">ama wɔn a wɔanya wɔn tiri adidi mu</para>
  <para style="q2" vid="JOL 2:32">a <char style="nd">Awurade</char> afrɛ wɔn</para>
  <para style="q2" vid="JOL 2:32">wɔ Sion bepɔ so ne Yerusalem nyinaa,”</para>
  <para style="q1" vid="JOL 2:32">sɛdeɛ <char style="nd">Awurade</char> aka no.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">Aman No Atemmuo</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“Saa nna no mu,</para>
  <para style="q2" vid="JOL 3:1">mede Yuda ne Yerusalem ahonyadeɛ bɛsane aba.<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>Mɛboa aman nyinaa ano,</para>
  <para style="q2" vid="JOL 3:2">na mede wɔn aba Yehosafat bɔnhwa mu.</para>
  <para style="q1" vid="JOL 3:2">Ɛhɔ na mɛbu wɔn atɛn</para>
  <para style="q2" vid="JOL 3:2">wɔ deɛ wɔyɛɛ mʼagyapadeɛ, a ɛyɛ Israelfoɔ ho,</para>
  <para style="q1" vid="JOL 3:2">ɛfiri sɛ wɔbɔɔ me nkurɔfoɔ hwetee aman so,</para>
  <para style="q2" vid="JOL 3:2">na wɔkyekyɛɛ mʼasase mu.<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>Wɔbɔɔ me nkurɔfoɔ so ntonto,</para>
  <para style="q2" vid="JOL 3:3">Wɔtɔn mmerantewaa de emu sika bɔɔ adwaman.</para>
  <para style="q1" vid="JOL 3:3">Wɔtɔn mmaayewa nso de gyee nsã,</para>
  <para style="q2" vid="JOL 3:3">a wɔbɛnom.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“Ɛdeɛn na mowɔ tia me, Ao Tiro ne Sidon ne mo Filistia amantam nyinaa? Mopɛ sɛ motɔ me so awere anaa? Sɛ saa na ɛte deɛ a, monhwɛ yie. Mɛyɛ ntɛm, atua mo biribiara a moayɛ no so ka. <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>Mofaa me dwetɛ ne me sikakɔkɔɔ ne mʼagyapadeɛ a ɛsom bo, na mosoa kɔguu mo abosonnan mu. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>Motontɔn nnipa a wɔte Yuda ne Yerusalem maa Helafoɔ<note caller="+" style="f"><char style="fr" closed="false">3.6 </char><char style="ft" closed="false">Helafoɔ ne Foenikefoɔ dii dwa firi afe 800 A.W.A.</char></note> sɛdeɛ ɛbɛyɛ a, wɔbɛfiri wɔn asase so akɔ akyirikyiri.<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“Nanso, mɛsane de wɔn afiri baabi a mokɔtɔn wɔn no aba, na deɛ moayɛ no nyinaa, mɛtua mo so ka. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>Mɛtontɔn mo mmammarima ne mo mmammaa ama Yudafoɔ, na wɔn nso atɔn wɔn ama Arabfoɔ, ɔman a ɛwɔ akyirikyiri no.” Me, <char style="nd">Awurade</char>, na makasa.<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>Mo mpae mu nka yei wɔ aman so:</para>
  <para style="q2" vid="JOL 3:9">Monsiesie mo ho mma ɔko!</para>
  <para style="q1" vid="JOL 3:9">Monkanyane akodɔm!</para>
  <para style="q2" vid="JOL 3:9">Momma mo mmarima akofoɔ no ntwe mpini, na wɔn mmɛko.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>Momfa mo mfuntumdadeɛ no mmɔ akofena,</para>
  <para style="q2" vid="JOL 3:10">na momfa mo nsɔsɔwa mmɔ mpea.</para>
  <para style="q1" vid="JOL 3:10">Ma deɛ wɔayɛ mmerɛ nka sɛ,</para>
  <para style="q2" vid="JOL 3:10">“mewɔ ahoɔden!”<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>Monyɛ ntɛm mmra,</para>
  <para style="q2" vid="JOL 3:11">mo amanaman a moatwa ahyia,</para>
  <para style="q1" vid="JOL 3:11">mo mmɛboa mo ho ano wɔ hɔ.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">Fa wʼakofoɔ bra, Ao <char style="nd">Awurade</char>!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“Wɔnkanyane aman no;</para>
  <para style="q2" vid="JOL 3:12">wɔntu ntene nkɔ Yehosafat bɔnhwa no mu,</para>
  <para style="q1" vid="JOL 3:12">ɛfiri sɛ ɛhɔ na mɛtena</para>
  <para style="q2" vid="JOL 3:12">na mabu aman a atwa ahyia no nyinaa atɛn.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>Monhwim kantankrankyi no,</para>
  <para style="q2" vid="JOL 3:13">ɛfiri sɛ otwa berɛ no aduru so.</para>
  <para style="q1" vid="JOL 3:13">Mommra, montiatia bobe no so,</para>
  <para style="q2" vid="JOL 3:13">ɛfiri sɛ nsakyiamena no ayɛ ma</para>
  <para style="q1" vid="JOL 3:13">na ankorɛ no ayɛ ma abu so.</para>
  <para style="q2" vid="JOL 3:13">Saa ara na wɔn amumuyɛ dɔɔso!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>Nipadɔm, nipadɔm</para>
  <para style="q2" vid="JOL 3:14">wɔ gyinasie subɔnhwa no mu!</para>
  <para style="q1" vid="JOL 3:14">
    <char style="nd">Awurade</char> ɛda no abɛn</para>
  <para style="q2" vid="JOL 3:14">wɔ gyinasie subɔnhwa no mu.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>Owia ne ɔsrane bɛduru sum,</para>
  <para style="q2" vid="JOL 3:15">na nsoromma renhyerɛn bio.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>
    <char style="nd">Awurade</char> bɛbobɔ mu afiri Sion,</para>
  <para style="q2" vid="JOL 3:16">ne nne bɛgyegye afiri Yerusalem,</para>
  <para style="q2" vid="JOL 3:16">asase ne ɔsoro bɛwoso.</para>
  <para style="q1" vid="JOL 3:16">Nanso, <char style="nd">Awurade</char> bɛyɛ dwanekɔbea ama ne nkurɔfoɔ,</para>
  <para style="q2" vid="JOL 3:16">ɔbɛyɛ abandenden ama Israelfoɔ.<verse eid="JOL 3:16"/></para>
  <para style="s1">Onyankopɔn Nkurɔfoɔ Nhyira</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“Afei, wobɛhunu sɛ, me <char style="nd">Awurade</char>, wo Onyankopɔn,</para>
  <para style="q2" vid="JOL 3:17">mete Sion, me bepɔ kronkron so.</para>
  <para style="q1" vid="JOL 3:17">Yerusalem bɛyɛ kronkron;</para>
  <para style="q2" vid="JOL 3:17">na ananafoɔ rentu wɔn so sa bio.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“Saa ɛda no, nsã foforɔ bɛsɔne afiri mmepɔ no mu,</para>
  <para style="q2" vid="JOL 3:18">na nufosuo atene wɔ nkokoɔ so;</para>
  <para style="q1" vid="JOL 3:18">Nsuo bɛba Yuda nsuwansuwa mu,</para>
  <para style="q2" vid="JOL 3:18">na asutire bɛtue afiri <char style="nd">Awurade</char> efie,</para>
  <para style="q2" vid="JOL 3:18">na agugu akasia subɔnhwa no so nsuo.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>Nanso Misraim bɛdane amanfo,</para>
  <para style="q2" vid="JOL 3:19">na Edom nso bɛyɛ anweatam,</para>
  <para style="q1" vid="JOL 3:19">ɛsiane awurukasɛm a wɔyɛ de tiaa nnipa a wɔwɔ Yuda enti.</para>
  <para style="q2" vid="JOL 3:19">Ɛhɔ na wɔhwiee mogya a ɛnni fɔ guiɛ.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>Nnipa bɛtena Yuda afebɔɔ</para>
  <para style="q2" vid="JOL 3:20">na Yerusalem deɛ wɔbɛtena hɔ awoɔ ntoatoasoɔ nyinaa mu.<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>Na mogya afɔdie a memfa nkyɛeɛ no,</para>
  <para style="q2" vid="JOL 3:21">mede bɛkyɛ.</para>
  <para style="qc" vid="JOL 3:21">Na me <char style="nd">Awurade</char>, mɛtena Sion!”<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
