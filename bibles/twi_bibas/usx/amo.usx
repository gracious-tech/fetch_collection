<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Amos</para>
  <para style="toc1">Odiyifoɔ Amos Nwoma</para>
  <para style="toc2">Amos</para>
  <para style="toc3">Amos</para>
  <para style="mt2">Odiyifoɔ</para>
  <para style="mt1">Amos</para>
  <para style="mt2">Nwoma</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>Amos, Tekoa nnwanhwɛfoɔ no mu baako nsɛm nie. Ɔnyaa saa anisoadehunu yi a ɛfa Israel ho mfeɛ mmienu ansa na asase wosooɛ no, ɛberɛ a Usia di ɔhene wɔ Yuda na Yoas babarima Yeroboam nso di ɔhene wɔ Israel no.<verse eid="AMO 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>Ɔkaa sɛ:</para>
  <para style="q1" vid="AMO 1:2">“<char style="nd">Awurade</char> bobom firi Sion bepɔ so</para>
  <para style="q2" vid="AMO 1:2">na ɔde aprannaa nnyegyeeɛ nso firi Yerusalem;</para>
  <para style="q1" vid="AMO 1:2">nnwanhwɛfoɔ mmoa adidibea rehye</para>
  <para style="q2" vid="AMO 1:2">na Karmel atifi nso kusa.”<verse eid="AMO 1:2"/></para>
  <para style="s1">Atemmuo A Ɛfa Amanamanmufoɔ Ahodoɔ Ho</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q1" vid="AMO 1:3">“Damasko ayɛ bɔne bebree ama no atra so</para>
  <para style="q2" vid="AMO 1:3">ɛno enti, merennane mʼabufuo.</para>
  <para style="q1" vid="AMO 1:3">Ɛfiri sɛ, ɔde ayuporeeɛ adeɛ a ɛwɔ dadeɛ se</para>
  <para style="q2" vid="AMO 1:3">dwerɛɛ Gilead.<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>Mede ogya bɛto Hasael efie</para>
  <para style="q2" vid="AMO 1:4">na ahye Ben-Hadad aban no.<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>Mɛbubu Damasko apono,</para>
  <para style="q2" vid="AMO 1:5">na mɛsɛe ɔhene a ɔwɔ Awen bɔnhwa no mu no</para>
  <para style="q1" vid="AMO 1:5">ne deɛ ɔkura ahempoma wɔ Bet Eden no.</para>
  <para style="q2" vid="AMO 1:5">Na Aramfoɔ bɛkɔ nnommumfa mu wɔ Kir,”</para>
  <para style="q2" vid="AMO 1:5">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 1:6"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q1" vid="AMO 1:6">“Gasa ayɛ bɔne bebree ama no atra so,</para>
  <para style="q2" vid="AMO 1:6">ɛno enti, merennane mʼabufuo no.</para>
  <para style="q1" vid="AMO 1:6">Ɔfaa ɔman mu no nyinaa nnommum</para>
  <para style="q2" vid="AMO 1:6">na ɔtɔnee wɔn maa Edomfoɔ.<verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>Mede ogya bɛto Gasa afasuo mu,</para>
  <para style="q2" vid="AMO 1:7">na ahye nʼaban no.<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>Mɛsɛe Asdod ɔhene no</para>
  <para style="q2" vid="AMO 1:8">ne deɛ ɔkura ahempoma wɔ Askelon no.</para>
  <para style="q1" vid="AMO 1:8">Mɛdane me nsa atia Ekron,</para>
  <para style="q2" vid="AMO 1:8">kɔsi sɛ Filistini a ɔtwa toɔ no bɛwu,”</para>
  <para style="q1" vid="AMO 1:8">sɛdeɛ Asafo <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q1" vid="AMO 1:9">“Tiro ayɛ bɔne bebree ama no atra so,</para>
  <para style="q2" vid="AMO 1:9">ɛno enti, merennane mʼabufuo.</para>
  <para style="q1" vid="AMO 1:9">Ɔfaa ɔman mu no nnommum</para>
  <para style="q2" vid="AMO 1:9">na ɔtɔnee wɔn maa Edomfoɔ,</para>
  <para style="q2" vid="AMO 1:9">a wankae onuadɔ apam.<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>Mede ogya bɛto Tiro afasuo no mu,</para>
  <para style="q2" vid="AMO 1:10">na ahye nʼaban.”<verse eid="AMO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q2" vid="AMO 1:11">“Edom ayɛ bɔne bebree ama no atra so,</para>
  <para style="q1" vid="AMO 1:11">ɛno enti, merennane mʼabufuo.</para>
  <para style="q2" vid="AMO 1:11">Ɔde akofena taataa ne nua,</para>
  <para style="q2" vid="AMO 1:11">a wannya ayamhyehyeɛ biara.</para>
  <para style="q1" vid="AMO 1:11">Ɛfiri sɛ ne bo kɔɔ so fuiɛ</para>
  <para style="q2" vid="AMO 1:11">na obiara antumi annwodwo nʼabufuo no ano.<verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>Mede ogya bɛto Teman mu,</para>
  <para style="q2" vid="AMO 1:12">na ahye Bosra aban.”<verse eid="AMO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 1:13"/>Sɛdeɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q2" vid="AMO 1:13">“Amon ayɛ bɔne bebree ama no atra so,</para>
  <para style="q2" vid="AMO 1:13">ɛno enti, merennane mʼabufuo.</para>
  <para style="q1" vid="AMO 1:13">Ɔde akofena paepaee Gilead apemfoɔ yafunu mu</para>
  <para style="q2" vid="AMO 1:13">de trɛɛ nʼahyeɛ mu.<verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>Mede ogya bɛto Raba afasuo mu</para>
  <para style="q2" vid="AMO 1:14">na ahye nʼaban</para>
  <para style="q1" vid="AMO 1:14">wɔ ɔko da mu nteateam</para>
  <para style="q2" vid="AMO 1:14">ne ahum da ntwaho mframa mu.<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>Na ne ɔhene ne mmapɔmma</para>
  <para style="q2" vid="AMO 1:15">bɛbom akɔ nnommumfa mu,”</para>
  <para style="q1" vid="AMO 1:15">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q2" vid="AMO 2:1">“Moab ayɛ bɔne bebree ama no atra so,</para>
  <para style="q1" vid="AMO 2:1">ɛno enti, merennane mʼabufuo.</para>
  <para style="q2" vid="AMO 2:1">Ɔhyee Edomhene nnompe,</para>
  <para style="q2" vid="AMO 2:1">ma ɛdanee nsõ.<verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>Mede ogya bɛto Moab mu,</para>
  <para style="q2" vid="AMO 2:2">na ahye Keriot aban.</para>
  <para style="q1" vid="AMO 2:2">Moab bɛhwe ase wɔ hooyɛ,</para>
  <para style="q2" vid="AMO 2:2">ɔko nteateamu ne totorobɛnto nnyegyeeɛ mu.<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>Mɛsɛe ne sodifoɔ</para>
  <para style="q2" vid="AMO 2:3">na makunkum ne mmapɔmma aka ne ho,”</para>
  <para style="q2" vid="AMO 2:3">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 2:4"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q2" vid="AMO 2:4">“Yuda ayɛ bɔne bebree ama no atra so,</para>
  <para style="q1" vid="AMO 2:4">ɛno enti, merennane mʼabufuo.</para>
  <para style="q2" vid="AMO 2:4">Wɔapo <char style="nd">Awurade</char> mmara no</para>
  <para style="q1" vid="AMO 2:4">na wɔanni nʼahyɛdeɛ so</para>
  <para style="q2" vid="AMO 2:4">ɛfiri sɛ atorɔ anyame no</para>
  <para style="q1" vid="AMO 2:4">ama wɔafom ɛkwan no,</para>
  <para style="q2" vid="AMO 2:4">anyame a wɔn nananom dii akyire no.<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>Mede ogya bɛto Yuda mu</para>
  <para style="q2" vid="AMO 2:5">na ahye Yerusalem aban.”<verse eid="AMO 2:5"/></para>
  <para style="s1">Israel Atemmuo</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q1" vid="AMO 2:6">“Israel ayɛ bɔne bebree ama no atra so,</para>
  <para style="q2" vid="AMO 2:6">ɛno enti, merennane mʼabufuo.</para>
  <para style="q1" vid="AMO 2:6">Wɔtɔn ateneneefoɔ de gye dwetɛ,</para>
  <para style="q2" vid="AMO 2:6">ne ahiafoɔ de gye mpaboa.<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>Wɔtiatia ahiafoɔ so</para>
  <para style="q2" vid="AMO 2:7">te sɛ deɛ wɔyɛ fam mfuturo</para>
  <para style="q2" vid="AMO 2:7">na wɔma atɛntenenee bɔ mmɔborɔwafoɔ.</para>
  <para style="q1" vid="AMO 2:7">Agya ne ne ba ne ɔbaa baako da</para>
  <para style="q2" vid="AMO 2:7">de gu me din kronkron no ho fi.<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>Wɔdeda afɔrebukyia biara ho</para>
  <para style="q2" vid="AMO 2:8">wɔ wɔn awowa ntoma so.</para>
  <para style="q1" vid="AMO 2:8">Wɔ wɔn anyame efie no mu no</para>
  <para style="q2" vid="AMO 2:8">wɔnom nsã a wɔagye sɛ mmaratodeɛ.<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>“Mesɛee Amorifoɔ no wɔ wɔn anim,</para>
  <para style="q2" vid="AMO 2:9">ɛwom sɛ wɔware te sɛ ntweneduro.</para>
  <para style="q2" vid="AMO 2:9">Wɔn ho nso yɛ den sɛ odum.</para>
  <para style="q1" vid="AMO 2:9">Mesɛee nʼaba wɔ ne soro,</para>
  <para style="q2" vid="AMO 2:9">ne ne nhini wɔ nʼase.<verse eid="AMO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>Meyii wo firii Misraim,</para>
  <para style="q2" vid="AMO 2:10">na medii wʼanim mfirinhyia aduanan wɔ ɛserɛ so</para>
  <para style="q1" vid="AMO 2:10">sɛdeɛ mede Amorifoɔ asase bɛma wo.<verse eid="AMO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>Meyiyii mo mmammarima no bi yɛɛ wɔn adiyifoɔ,</para>
  <para style="q2" vid="AMO 2:11">ne mo mmeranteɛ binom sɛ Nasarefoɔ.</para>
  <para style="q1" vid="AMO 2:11">Na ɛnte saa anaa, Israelfoɔ?”</para>
  <para style="q2" vid="AMO 2:11">Deɛ <char style="nd">Awurade</char> bisa nie.<verse eid="AMO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12"/>“Nanso momaa Nasarefoɔ no nom nsã</para>
  <para style="q2" vid="AMO 2:12">na mohyɛɛ adiyifoɔ no sɛ wɔnnhyɛ nkɔm.<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>“Na afei, mɛdwerɛ mo</para>
  <para style="q2" vid="AMO 2:13">sɛdeɛ teaseɛnam a aduane ayɛ no ma mia asase no.<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>Ahoɔherɛfoɔ rentumi nnwane.</para>
  <para style="q2" vid="AMO 2:14">Ahoɔdenfoɔ rennya ahoɔden,</para>
  <para style="q1" vid="AMO 2:14">na akofoɔ rennya ne ho ntete.<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>Agyantofoɔ rentumi nnyina deɛ ɔgyina.</para>
  <para style="q2" vid="AMO 2:15">Asraafoɔ ahoɔherɛfoɔ rentumi nnwane,</para>
  <para style="q2" vid="AMO 2:15">na pɔnkɔsotefoɔ rentumi mpere ne nkwa.<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>Mpo akofoɔ akokoɔdurufoɔ</para>
  <para style="q2" vid="AMO 2:16">de adagya bɛdwane wɔ saa da no,”</para>
  <para style="q2" vid="AMO 2:16">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">Wɔfrɛ Adansefoɔ Tia Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>Montie saa asɛm a <char style="nd">Awurade</char> aka atia mo yi, Ao, Israelfoɔ, deɛ ɛtia abusua a meyii wɔn firii Misraim no nyinaa:<verse eid="AMO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2"/>“Mo nko ara na mayi mo</para>
  <para style="q2" vid="AMO 3:2">wɔ mmusua a ɛwɔ asase so nyinaa mu;</para>
  <para style="q2" vid="AMO 3:2">enti mɛtwe mo aso</para>
  <para style="q2" vid="AMO 3:2">wɔ mo bɔne nyinaa ho.”<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>Nnipa baanu bɛtumi abom anante,</para>
  <para style="q2" vid="AMO 3:3">wɔ ɛberɛ a wɔnyɛɛ anokorɔ anaa?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>Gyata bobom wɔ dɔtɔ ase</para>
  <para style="q2" vid="AMO 3:4">wɔ ɛberɛ a ɔnhunuu ahaboa biara anaa?</para>
  <para style="q1" vid="AMO 3:4">Ɔpɔ so wɔ ne buo mu</para>
  <para style="q2" vid="AMO 3:4">wɔ ɛberɛ a ɔnkyeree ahaboa biara anaa?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>Anomaa bɛtɔ afidie mu wɔ fam</para>
  <para style="q2" vid="AMO 3:5">wɔ baabi a wɔnnsum afidie anaa?</para>
  <para style="q1" vid="AMO 3:5">Afidie hwan wɔ</para>
  <para style="q2" vid="AMO 3:5">ɛberɛ a ɛnyii aboa anaa?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>Sɛ wɔhyɛn totorobɛnto wɔ kuropɔn mu a</para>
  <para style="q2" vid="AMO 3:6">nnipa no ho mpopo anaa?</para>
  <para style="q1" vid="AMO 3:6">Sɛ atoyerɛnkyɛm ba kuropɔn bi mu a</para>
  <para style="q2" vid="AMO 3:6">ɛnyɛ <char style="nd">Awurade</char> na ɔyɛeɛ anaa?<verse eid="AMO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>Ampa ara, Otumfoɔ <char style="nd">Awurade</char> nnyɛ biribi</para>
  <para style="q2" vid="AMO 3:7">a ɔnna ne nhyehyeɛ adi</para>
  <para style="q2" vid="AMO 3:7">nkyerɛ nʼAsomafoɔ adiyifoɔ no.<verse eid="AMO 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>Gyata no abobom,</para>
  <para style="q2" vid="AMO 3:8">hwan na ɔnnsuro?</para>
  <para style="q1" vid="AMO 3:8">Otumfoɔ <char style="nd">Awurade</char> akasa,</para>
  <para style="q2" vid="AMO 3:8">hwan na ɔrenhyɛ ho nkɔm?<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9"/>Mompae mu nka nkyerɛ Asdod aban</para>
  <para style="q2" vid="AMO 3:9">ne Misraim aban:</para>
  <para style="q1" vid="AMO 3:9">“Mommoaboa mo ho ano wɔ Samaria mmepɔ so;</para>
  <para style="q2" vid="AMO 3:9">hwɛ basabasayɛ a ɛwɔ ne so</para>
  <para style="q2" vid="AMO 3:9">ne nhyɛsoɔ a ɛwɔ ne nkurɔfoɔ mu.”<verse eid="AMO 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10"/>“Wɔnnim sɛdeɛ wɔyɛ deɛ ɛyɛ,”</para>
  <para style="q2" vid="AMO 3:10">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.</para>
  <para style="q1" vid="AMO 3:10">Wɔde nneɛma a wɔafo ne deɛ wɔawia</para>
  <para style="q2" vid="AMO 3:10">sie wɔ wɔn aban mu.<verse eid="AMO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11"/>Ɛno enti, yei ne deɛ Otumfoɔ <char style="nd">Awurade</char> seɛ,</para>
  <para style="q1" vid="AMO 3:11">“Ɔtamfoɔ bi bɛtwi afa asase no so;</para>
  <para style="q2" vid="AMO 3:11">Ɔbɛbubu wʼabanbɔeɛ agu,</para>
  <para style="q2" vid="AMO 3:11">na wafo wʼaban.”<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q2" vid="AMO 3:12">“Sɛdeɛ odwanhwɛfoɔ gye</para>
  <para style="q1" vid="AMO 3:12">nnyawa mmienu nnompe anaa aso sin</para>
  <para style="q2" vid="AMO 3:12">firi gyata anom no,</para>
  <para style="q1" vid="AMO 3:12">saa ara na wɔbɛgye Israelfoɔ nkwa,</para>
  <para style="q2" vid="AMO 3:12">wɔn a wɔtete wɔn mpa twea so wɔ Samaria,</para>
  <para style="q2" vid="AMO 3:12">ne wɔn a wɔdeda nkonwa pa mu wɔ Damasko.”<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>“Tie yei, na di adanseɛ tia Yakob efie,” sɛdeɛ <char style="nd">Awurade</char>, Asafo <char style="nd">Awurade</char> Onyankopɔn seɛ nie.<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>“Ɛda a mɛtwe Israel aso wɔ ne nnebɔne ho no,</para>
  <para style="q2" vid="AMO 3:14">mɛsɛe afɔrebukyia a ɛwɔ Bet-El;</para>
  <para style="q1" vid="AMO 3:14">wɔbɛtwitwa afɔrebukyia no mmɛn</para>
  <para style="q2" vid="AMO 3:14">na abu ahwe fam.<verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>Mɛdwiri awɔberɛ efie</para>
  <para style="q2" vid="AMO 3:15">ne ahuhuro berɛ efie agu;</para>
  <para style="q1" vid="AMO 3:15">na afie a wɔde asonse adura ho no wɔbɛsɛe no</para>
  <para style="q2" vid="AMO 3:15">na afie akɛseɛ no nso wɔbɛbubu agu,”</para>
  <para style="q2" vid="AMO 3:15">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">Israel Nsane Nkɔɔ Onyankopɔn Nkyɛn</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1"/>Montie asɛm yi, mo Basan “anantwie” a mowɔ Bepɔ Samaria so,</para>
  <para style="q2" vid="AMO 4:1">mo mmaa a mohyɛ ahiafoɔ so, na moka mmɔborɔwa hyɛ</para>
  <para style="q1" vid="AMO 4:1">na moka kyerɛ mo kununom sɛ, “Mommrɛ yɛn nsã!”<verse eid="AMO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2"/>Otumfoɔ <char style="nd">Awurade</char> de ne kronkronyɛ aka ntam sɛ,</para>
  <para style="q2" vid="AMO 4:2">“Ampa ara ɛberɛ no bɛba</para>
  <para style="q1" vid="AMO 4:2">a wɔde nkawa bɛtwe mo akɔ</para>
  <para style="q2" vid="AMO 4:2">mo mu deɛ ɔtwa toɔ no wɔde nsuomnam darewa bɛtwe no.<verse eid="AMO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3"/>Momu biara bɛpue akɔ,</para>
  <para style="q2" vid="AMO 4:3">na mobɛfa ɔfasuo mu ntokuro mu,</para>
  <para style="q1" vid="AMO 4:3">na wɔbɛto mo atwene Harmon fam,”</para>
  <para style="q2" vid="AMO 4:3">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>“Monkɔ Bet-El nkɔyɛ bɔne</para>
  <para style="q2" vid="AMO 4:4">na monkɔ Gilgal<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false">Bet-El…Gilgal: Saa nkuro mmienu yi yɛ nkuro a abakɔsɛm mu wɔde kae Awurade mmoa. Na saa nkuro yi yɛ mmeaeɛ a na wɔsom Onyankopɔn wɔ hɔ wɔ Amos berɛ so.</char></note> na mo nkɔyɛ bɔne ara.</para>
  <para style="q1" vid="AMO 4:4">Momfa mo afɔrebɔdeɛ mmra anɔpa biara,</para>
  <para style="q2" vid="AMO 4:4">na momfa mo ntotosoɔ dudu mmra mfeɛ mmiɛnsa biara.<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>Monhye mmɔreka burodo sɛ aseda afɔdeɛ;</para>
  <para style="q2" vid="AMO 4:5">Momfa ayɛyɛdeɛ a ɛfiri mo pɛ mu nhoahoa mo ho,</para>
  <para style="q1" vid="AMO 4:5">na momfa ntu mo ho, mo Israelfoɔ,</para>
  <para style="q2" vid="AMO 4:5">na yei ne deɛ mopɛ sɛ moyɛ,”</para>
  <para style="q2" vid="AMO 4:5">sɛdeɛ Otumfoɔ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6"/>“Memaa yafunu daa mpan wɔ kuropɔn biara mu</para>
  <para style="q2" vid="AMO 4:6">na aduane ho yɛɛ den wɔ nkuro so,</para>
  <para style="q1" vid="AMO 4:6">nanso monnsane mmaa me nkyɛn,”</para>
  <para style="q2" vid="AMO 4:6">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7"/>“Mesane de osutɔ kamee mo</para>
  <para style="q2" vid="AMO 4:7">ɛberɛ a aka abosome mmiɛnsa na otwa berɛ no aduru.</para>
  <para style="q1" vid="AMO 4:7">Memaa osuo tɔɔ wɔ kuro baako so</para>
  <para style="q2" vid="AMO 4:7">na mamma antɔ wɔ kuro foforɔ so.</para>
  <para style="q1" vid="AMO 4:7">Afuo baako nyaa osutɔ</para>
  <para style="q2" vid="AMO 4:7">afuo foforɔ annya bi na ɛhyeeɛ.<verse eid="AMO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8"/>Nnipa totɔɔ ntentan kyinii nkuro so pɛɛ nsuo</para>
  <para style="q2" vid="AMO 4:8">nanso wɔannya dodo a ɛbɛso wɔn nom,</para>
  <para style="q1" vid="AMO 4:8">nanso, monnsane mmaa me nkyɛn,”</para>
  <para style="q2" vid="AMO 4:8">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9"/>“Mpɛn bebree no mede nnɔbaeɛ yadeɛ</para>
  <para style="q2" vid="AMO 4:9">ba mo mfikyifuo ne mo bobefuo so.</para>
  <para style="q1" vid="AMO 4:9">Ntutummɛ sɛee mo borɔdɔma ne mo ngo nnua,</para>
  <para style="q2" vid="AMO 4:9">nanso monnsane mmaa me nkyɛn,”</para>
  <para style="q2" vid="AMO 4:9">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10"/>“Mede ɔyaredɔm baa mo so</para>
  <para style="q2" vid="AMO 4:10">sɛdeɛ mede yɛɛ Misraimfoɔ no,</para>
  <para style="q1" vid="AMO 4:10">mede akofena kunkumm mo mmeranteɛ</para>
  <para style="q2" vid="AMO 4:10">ne apɔnkɔ a mofaa wɔn nnommum.</para>
  <para style="q2" vid="AMO 4:10">Mede mo nsramu hwa a ɛbɔn hyɛnee mo hwene mu,</para>
  <para style="q1" vid="AMO 4:10">nanso, monnsane mmaa me nkyɛn,”</para>
  <para style="q2" vid="AMO 4:10">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11"/>“Metuu mo mu bi guiɛ</para>
  <para style="q2" vid="AMO 4:11">sɛdeɛ metɔree Sodom ne Gomora ase no.</para>
  <para style="q1" vid="AMO 4:11">Moyɛɛ sɛ gyentia a wɔatu afiri ogya mu.</para>
  <para style="q2" vid="AMO 4:11">Nanso, monnsane mmaa me nkyɛn,”</para>
  <para style="q2" vid="AMO 4:11">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>“Enti afei, Israel, deɛ mede bɛyɛ wo nie,</para>
  <para style="q2" vid="AMO 4:12">na ɛsiane sɛ mede yei bɛyɛ wo enti,</para>
  <para style="q1" vid="AMO 4:12">siesie wo ho, Ao Israel. Hyia wo Onyankopɔn.”<verse eid="AMO 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>Deɛ ɔyɛ mmepɔ na ɔbɔ mframa</para>
  <para style="q2" vid="AMO 4:13">na ɔda nʼadwene adi kyerɛ nnipa,</para>
  <para style="q1" vid="AMO 4:13">deɛ ɔma adekyeɛ hann dane esum</para>
  <para style="q2" vid="AMO 4:13">na ɔnante asase sorɔnsorɔmmea so no.</para>
  <para style="q2" vid="AMO 4:13">Asafo <char style="nd">Awurade</char> Onyankopɔn ne ne din.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">Ahunu Ne Adwensakyera</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>Tie asɛm yi, mo Israelfoɔ, saa mmenabɔ yi fa mo ho:<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“Ɔbabunu Israel ahwe ase</para>
  <para style="q2" vid="AMO 5:2">a ɔrensɔre bio,</para>
  <para style="q1" vid="AMO 5:2">wɔapo no ɔno ara asase so,</para>
  <para style="q2" vid="AMO 5:2">na ɔnni obi a ɔbɛpagya no.”<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>Deɛ Otumfoɔ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q1" vid="AMO 5:3">“Kuropɔn a ɔde mmarima ahoɔdenfoɔ apem ko ma Israel no,</para>
  <para style="q2" vid="AMO 5:3">emu ɔha pɛ na ɛbɛka;</para>
  <para style="q1" vid="AMO 5:3">Kuro a ɔde ahoɔdenfoɔ ɔha no,</para>
  <para style="q2" vid="AMO 5:3">emu edu pɛ na ɛbɛka.”<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>Deɛ <char style="nd">Awurade</char> ka kyerɛ Israelfoɔ nie:</para>
  <para style="q1" vid="AMO 5:4">“Monhwehwɛ me na monnya nkwa;<verse eid="AMO 5:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5"/>Monnhwehwɛ Bet-El,</para>
  <para style="q2" vid="AMO 5:5">monnkɔ Gilgal,</para>
  <para style="q1" vid="AMO 5:5">na monntu ɛkwan nkɔ Beer-Seba nso.</para>
  <para style="q2" vid="AMO 5:5">Ampa ara Gilgal bɛkɔ nnommumfa mu</para>
  <para style="q2" vid="AMO 5:5">na wɔbɛhwe Bet-El ase koraa.”<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>Monhwehwɛ <char style="nd">Awurade</char> na monnya nkwa,</para>
  <para style="q1" vid="AMO 5:6">anyɛ saa a ɔbɛpra Yosef efie te sɛ ogya;</para>
  <para style="q2" vid="AMO 5:6">ɛbɛhye,</para>
  <para style="q2" vid="AMO 5:6">na Bet-El rennya obi nnum no.<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>Mo a moma atemmuo yɛ nwono</para>
  <para style="q2" vid="AMO 5:7">na mototo tenenee ase.<verse eid="AMO 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>Deɛ ɔbɔɔ nsoromma, Akokɔbaatan ne ne mma,</para>
  <para style="q1" vid="AMO 5:8">deɛ ɔdane esum yɛ no adekyeeɛ</para>
  <para style="q2" vid="AMO 5:8">na ɔma awia dane adesaeɛ.</para>
  <para style="q1" vid="AMO 5:8">Deɛ ɔboaboa ɛpo mu nsuo ano</para>
  <para style="q2" vid="AMO 5:8">na ɔhwie gu asase so,</para>
  <para style="q2" vid="AMO 5:8">ne din ne <char style="nd">Awurade</char>.<verse eid="AMO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9"/>Ɔsɛe abandenden ntɛm so</para>
  <para style="q2" vid="AMO 5:9">na ɔbubu kuropɔn a wɔabɔ ho ban nso,<verse eid="AMO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>motane deɛ ɔtenetene wɔ asɛnniiɛ</para>
  <para style="q2" vid="AMO 5:10">na mobu deɛ ɔka nokorɛ animtiaa.<verse eid="AMO 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>Motiatia ohiani so</para>
  <para style="q2" vid="AMO 5:11">na mohyɛ no gye aduane firi ne nkyɛn.</para>
  <para style="q1" vid="AMO 5:11">Enti, ɛwom sɛ mode aboɔ a wɔatwa asisi afie akɛseɛ deɛ,</para>
  <para style="q2" vid="AMO 5:11">nanso morentena mu;</para>
  <para style="q1" vid="AMO 5:11">ɛwom sɛ moayɛ bobe nturo a ɛyɛ fɛ deɛ</para>
  <para style="q2" vid="AMO 5:11">nanso morennom emu nsã.<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>Na menim mo mmarato dodoɔ</para>
  <para style="q2" vid="AMO 5:12">ne mo bɔne akɛseɛ no.</para>
  <para style="b" vid="AMO 5:12"/>
  <para style="q1" vid="AMO 5:12">Mohyɛ teneneefoɔ so na mogye adanmudeɛ</para>
  <para style="q2" vid="AMO 5:12">mobu ahiafoɔ ntɛnkyea wɔ asɛnniiɛ.<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>Ɛno enti, ɔnyansafoɔ yɛ komm saa mmerɛ yi mu,</para>
  <para style="q2" vid="AMO 5:13">ɛfiri sɛ, ɛyɛ mmerɛ bɔne.<verse eid="AMO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14"/>Monhwehwɛ papa, na moanya nkwa</para>
  <para style="q2" vid="AMO 5:14">na ɛnyɛ bɔne.</para>
  <para style="q1" vid="AMO 5:14">Na Asafo <char style="nd">Awurade</char> Onyankopɔn bɛka wo ho,</para>
  <para style="q2" vid="AMO 5:14">sɛdeɛ moka sɛ ɔyɛ no.<verse eid="AMO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15"/>Monkyiri bɔne, na monnɔ papa;</para>
  <para style="q2" vid="AMO 5:15">Monni atɛn tenenee wɔ asɛnniiɛ.</para>
  <para style="q1" vid="AMO 5:15">Ebia, Asafo <char style="nd">Awurade</char> Onyankopɔn</para>
  <para style="q2" vid="AMO 5:15">bɛnya ahummɔborɔ ama</para>
  <para style="q2" vid="AMO 5:15">Yosef nkaeɛfoɔ.<verse eid="AMO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 5:16"/>Enti deɛ <char style="nd">Awurade</char>, Asafo <char style="nd">Awurade</char> Onyankopɔn seɛ nie:</para>
  <para style="q2" vid="AMO 5:16">“Mmenabɔ bɛba mmorɔno nyinaa so</para>
  <para style="q1" vid="AMO 5:16">na ɔyea ne apinisie bɛba mmɔntene so.</para>
  <para style="q2" vid="AMO 5:16">Wɔbɛfrɛ akuafoɔ ama wɔabɛsu</para>
  <para style="q2" vid="AMO 5:16">na agyamfoɔ abɛtwa adwo.<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>Wɔbɛbɔ mmena wɔ bobeturo nyinaa mu,</para>
  <para style="q2" vid="AMO 5:17">ɛfiri sɛ mɛnante mo mu,”</para>
  <para style="q2" vid="AMO 5:17">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 5:17"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Ɛda No</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>Nnome nka wɔn a</para>
  <para style="q2" vid="AMO 5:18">wɔpɛ sɛ <char style="nd">Awurade</char> da no ba!</para>
  <para style="q1" vid="AMO 5:18">Deɛn enti na mopɛ sɛ <char style="nd">Awurade</char> da no ba?</para>
  <para style="q2" vid="AMO 5:18">Saa ɛda no bɛyɛ esum, na ɛnnyɛ hann.<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>Ɛbɛyɛ te sɛ ɔnipa a ɔdwane firi gyata anim</para>
  <para style="q2" vid="AMO 5:19">na ɔkohyia sisire,</para>
  <para style="q1" vid="AMO 5:19">sɛ deɛ owura ne fie</para>
  <para style="q2" vid="AMO 5:19">de ne nsa to ɔfasuo so,</para>
  <para style="q2" vid="AMO 5:19">na ɔwɔ ka no.<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>Na <char style="nd">Awurade</char> da no bɛyɛ esum; ɛrenyɛ hann,</para>
  <para style="q2" vid="AMO 5:20">ɛbɛyɛ esum kabii a ɛhan nsensaneɛ biara nni mu.<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>“Mekyiri na mepo mo nyamesom mu apontoɔ;</para>
  <para style="q2" vid="AMO 5:21">mʼani nnye mo afahyɛ nhyiamu ho.<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>Ɛwom sɛ mode ɔhyeɛ afɔdeɛ ne aduane afɔdeɛ brɛ me deɛ,</para>
  <para style="q2" vid="AMO 5:22">nanso merennye.</para>
  <para style="q1" vid="AMO 5:22">Mode asomdwoeɛ afɔdeɛ brɛ me</para>
  <para style="q2" vid="AMO 5:22">nanso mʼani rensɔ.<verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>Momfa mo nnwontoɔ gyegyeegye no mfiri me so!</para>
  <para style="q2" vid="AMO 5:23">Merentie mo asankuten so nnwom.<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>Mmom, momma atɛntenenee ntene sɛ asubɔnten,</para>
  <para style="q2" vid="AMO 5:24">na tenenee nyɛ sɛ asutene a ɛrenwe da!<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>“Israelfoɔ, ɛnyɛ me na mode afɔrebɔdeɛ ne ayɛyɛdeɛ brɛɛ me</para>
  <para style="q2" vid="AMO 5:25">mfeɛ aduanan wɔ ɛserɛ so anaa?<verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>Mode mo ho nyinaa ato Molek nyame,</para>
  <para style="q1" vid="AMO 5:26">ne mo honi Rɛfan so;</para>
  <para style="q2" vid="AMO 5:26">wɔyɛ ahoni a moayɛ sɛ mobɛsom wɔn.<verse eid="AMO 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27"/>Ɛno enti, mɛtwa mo asuo akɔ Damasko nohoa,”</para>
  <para style="q2" vid="AMO 5:27">sɛdeɛ <char style="nd">Awurade</char> a ne din ne Onyankopɔn Otumfoɔ seɛ nie.<verse eid="AMO 5:27"/></para>
  <para style="b"/>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1"/>Nnome nka mo a mogye mo ho die wɔ Sion,</para>
  <para style="q2" vid="AMO 6:1">ne mo a mo asom adwo mo wɔ Samaria bepɔ so,</para>
  <para style="q1" vid="AMO 6:1">mo atitire a mowɔ ɔman dikanfoɔ mu,</para>
  <para style="q2" vid="AMO 6:1">a Israelfoɔ ba mo nkyɛn!<verse eid="AMO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2"/>Monkɔ Kalne, nkɔhwɛ hɔ.</para>
  <para style="q2" vid="AMO 6:2">Na momfiri hɔ nkɔ Hamat kɛseɛ mu,</para>
  <para style="q2" vid="AMO 6:2">monsiane nkɔ Gat a ɛwɔ Filistia.</para>
  <para style="q1" vid="AMO 6:2">Wɔyɛ sene mo ahemman mmienu no?</para>
  <para style="q2" vid="AMO 6:2">Wɔn asase no so sene mo deɛ no anaa?<verse eid="AMO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3"/>Motu ɛda bɔne hyɛ ɛda</para>
  <para style="q2" vid="AMO 6:3">na motwe Atemmuo da bɛn.<verse eid="AMO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4"/>Modeda asonse mpa so</para>
  <para style="q1" vid="AMO 6:4">mogye mo ahome wɔ mo nnaeɛ mu,</para>
  <para style="q2" vid="AMO 6:4">na mowe nnwammaa ne</para>
  <para style="q2" vid="AMO 6:4">anantwie mma a wɔadɔre sradeɛ nam.<verse eid="AMO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5"/>Mode mo sankuten to ahuhudwom,</para>
  <para style="q1" vid="AMO 6:5">na mobɔ mo tirim yɛ nnwom wɔ</para>
  <para style="q2" vid="AMO 6:5">mo nnwontodeɛ so te sɛ Dawid.<verse eid="AMO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6"/>Monom nsã nkorama mu</para>
  <para style="q2" vid="AMO 6:6">na mode sradehwam papa yɛ mo ho,</para>
  <para style="q2" vid="AMO 6:6">na monni awerɛhoɔ wɔ Yosef sɛeɛ ho.<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>Ɛno enti, mobɛka atukɔfoɔ a wɔdi ɛkan no ho;</para>
  <para style="q2" vid="AMO 6:7">na mo apontoɔ ne mo ahomegyeɛ to bɛtwa.<verse eid="AMO 6:7"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Kyiri Israel Ahomasoɔ</para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 6:8"/>Otumfoɔ <char style="nd">Awurade</char> aka ne ho ntam</para>
  <para style="q2" vid="AMO 6:8">na deɛ Asafo <char style="nd">Awurade</char> Onyankopɔn seɛ nie:</para>
  <para style="q1" vid="AMO 6:8">“Mekyiri Yakob ahomasoɔ</para>
  <para style="q1" vid="AMO 6:8">na memmpɛ nʼaban;</para>
  <para style="q2" vid="AMO 6:8">mede kuropɔn no bɛma</para>
  <para style="q2" vid="AMO 6:8">ɛne deɛ ɛwɔ mu nyinaa.”<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>Sɛ wogya nnipa edu wɔ efie baako mu a, wɔn nso bɛwuwu. <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>Na sɛ obusuani a ɔrebɛhye awufoɔ no ba sɛ ɔrebɛfa wɔn afiri efie hɔ na ɔbisa obi a wakɔtɛ sɛ, “Obi ka wo ho anaa?” Na ɔbuaa sɛ, “Dabi” a, afei ɔbɛka sɛ, “Mua wʼano!” Ɛnsɛ sɛ wɔbɔ <char style="nd">Awurade</char> din.<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>Na <char style="nd">Awurade</char> ahyɛ mmara</para>
  <para style="q2" vid="AMO 6:11">na ɔbɛbubu afie akɛseɛ no mu asinasini</para>
  <para style="q2" vid="AMO 6:11">ne afie nketewa no nso mu nketenkete.<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>Apɔnkɔ tu mmirika wɔ abotan a apaapae so anaa?</para>
  <para style="q2" vid="AMO 6:12">Na obi de nantwie funtum hɔ anaa?</para>
  <para style="q1" vid="AMO 6:12">Nanso, moadane atɛntenenee ayɛ no awuduro.</para>
  <para style="q2" vid="AMO 6:12">Na tenenee nso ayɛ nwononwono.<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>Mo a moani gye Lo-debar nkoguo ho,</para>
  <para style="q2" vid="AMO 6:13">na mobisa sɛ, “Ɛnyɛ yɛn ahoɔden na yɛde dii Karnaim so anaa?”<verse eid="AMO 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14"/>Deɛ Asafo <char style="nd">Awurade</char> Onyankopɔn seɛ nie: “Mɛhwanyan ɔman bi abɛtia mo, Ao Israelfoɔ,</para>
  <para style="q2" vid="AMO 6:14">deɛ ɔbɛhyɛ mo so firi Lebo Hamat akɔsi Araba bɔnhwa mu.”<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">Mmoadabi, Ogya Ne Kyirebennyɛ Homa</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>Deɛ Otumfoɔ <char style="nd">Awurade</char> yi kyerɛɛ me nie: na ɔreboaboa ntutummɛ bebree ano, abɛto wɔn agu asase no so. Yei yɛ ɛberɛ a wɔatwa ɔhene kyɛfa afiri mfuo no so na mfudeɛ no renyini bio. <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>Ɛberɛ a mmoadabi no awe asase no so nnɔbaeɛ nyinaa no, me teaam sɛ, “Otumfoɔ <char style="nd">Awurade</char>, mesrɛ wo, fa wo nkurɔfoɔ bɔne kyɛ wɔn! Yakob rentumi nnyina, ɛfiri sɛ, ɔyɛ ɔman ketewa bi.”<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>Ɛno enti, <char style="nd">Awurade</char> bo dwooɛ.</para>
  <para style="p" vid="AMO 7:3">Na ɔgyaee nʼatirimpɔ no. Ɔkaa sɛ, “Merenyɛ.”<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>Deɛ Otumfoɔ <char style="nd">Awurade</char> yi kyerɛɛ me nie: Otumfoɔ <char style="nd">Awurade</char> de ogya rebɛbu atɛn; ɛbɛwee ebunu kɛseɛ no na ɛsɛee asase no. <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>Na me teaam sɛ, “Ao, Otumfoɔ <char style="nd">Awurade</char>, mesrɛ wo, gyae. Yakob rentumi nnyina, ɛfiri sɛ, ɔyɛ ɔman ketewa bi.”<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>Ɛno enti, <char style="nd">Awurade</char> bo dwooɛ na ɔkaa sɛ, “Mɛgyae mʼatirimpɔ yi nso.”<verse eid="AMO 7:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>Yei ne deɛ ɔyi kyerɛɛ me: Na <char style="nd">Awurade</char> gyina ɔfasuo a wɔato no kyirebenn ho, a kyirebennyɛ ahoma kura no. <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>Na <char style="nd">Awurade</char> bisaa me sɛ, “Amos, ɛdeɛn na wohunu?”</para>
  <para style="p" vid="AMO 7:8">Mebuaa sɛ, “Kyirebennyɛ ahoma.”</para>
  <para style="p" vid="AMO 7:8">Na <char style="nd">Awurade</char> kaa sɛ, “Mede kyirebennyɛ ahoma yi reto me nkurɔfoɔ Israelfoɔ ho; meremfa wɔn ho nkyɛ wɔn bio.<verse eid="AMO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9"/>“Wɔbɛsɛe Isak sorɔnsorɔmmea</para>
  <para style="q2" vid="AMO 7:9">na Israel kronkron tenabea nso wɔbɛbubu no;</para>
  <para style="q2" vid="AMO 7:9">mede mʼakofena bɛsɔre atia Yeroboam efie.”<verse eid="AMO 7:9"/></para>
  <para style="s1">Amos Ne Amasia</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>Amasia a ɔyɛ Bet-El ɔsɔfoɔ de nkra kɔmaa Israelhene Yeroboam sɛ, “Amos rebɔ pɔ atia wo wɔ Israel ha yi ara! Nsɛm a ɔreka no nnyɛ abodwosɛm. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>Deɛ Amos reka nie:</para>
  <para style="q1" vid="AMO 7:11">“ ‘Yeroboam bɛwu wɔ akofena ano,</para>
  <para style="q2" vid="AMO 7:11">na ɛkwan biara so Israel bɛkɔ nnommumfa mu,</para>
  <para style="q2" vid="AMO 7:11">wɔ akyirikyiri asase so.’ ”<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>Na Amasia ka kyerɛɛ Amos sɛ, “Firi ha kɔ, wo ɔdehunufoɔ! Sane kɔ Yuda asase so na kɔtena hɔ hyɛ wo nkɔm. <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>Nhyɛ nkɔm bio wɔ Bet-El ha, ɛfiri sɛ ɛha yɛ ɔhene tenabea kronkron ne ahemman no asɔredan.”<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>Amos buaa Amasia sɛ, “Mennyɛ odiyifoɔ anaa odiyifoɔ bi ba, na na meyɛ odwanhwɛfoɔ, a na mehwɛ borɔdɔma nnua nso so. <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>Nanso, <char style="nd">Awurade</char> frɛɛ me firii nnwan so hwɛ so, ka kyerɛɛ me sɛ, ‘Kɔhyɛ nkɔm kyerɛ me nkurɔfoɔ Israelfoɔ.’ <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>Na afei, tie <char style="nd">Awurade</char> asɛm. Woka sɛ,</para>
  <para style="q1" vid="AMO 7:16">“ ‘Nhyɛ nkɔm ntia Israelfoɔ,</para>
  <para style="q2" vid="AMO 7:16">na gyae asɛnka a wode tia Isak fiefoɔ.’<verse eid="AMO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17"/>“Enti asɛm a <char style="nd">Awurade</char> ka nie:</para>
  <para style="q1" vid="AMO 7:17">“ ‘Wo yere bɛbɔ adwaman wɔ kuropɔn yi mu,</para>
  <para style="q2" vid="AMO 7:17">wo mmammarima ne wo mmammaa bɛwuwu wɔ akofena ano.</para>
  <para style="q1" vid="AMO 7:17">Wɔbɛsusu wʼasase na wakyekyɛ mu,</para>
  <para style="q2" vid="AMO 7:17">na wʼankasa nso, wobɛwu wɔ abosonsom ɔman mu,</para>
  <para style="q1" vid="AMO 7:17">na ɛkwan biara so Israel bɛkɔ nnommumfa mu,</para>
  <para style="q2" vid="AMO 7:17">wɔ akyirikyiri asase so.’ ”<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">Kɛntɛn A Aduaba A Abereɛ Wɔ Mu</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>Afei, deɛ Otumfoɔ <char style="nd">Awurade</char> yi kyerɛɛ me nie: kɛntɛn a aduaba a abereɛ wɔ mu. <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>Ɔbisaa sɛ, “Ɛdeɛn na wohunu, Amos?”</para>
  <para style="p" vid="AMO 8:2">Mebuaa sɛ, “Kɛntɛn a wɔde nnuaba a abereɛ ahyɛ no ma.”</para>
  <para style="p" vid="AMO 8:2">Ɛna <char style="nd">Awurade</char> ka kyerɛɛ me sɛ, “Me nkurɔfoɔ Israelfoɔ berɛ no aso; meremfa wɔn ho nnkyɛ wɔn bio.”<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>Sɛdeɛ Otumfoɔ <char style="nd">Awurade</char> seɛ nie, “Saa ɛda no, asɔrefie nnwontoɔ bɛdane menabɔ. Wɔbɛbɔ afunu bebree apete baabiara! Enti yɛ komm!”<verse eid="AMO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>Montie saa asɛm yi, mo a motiatia mmɔborɔwafoɔ so,</para>
  <para style="q2" vid="AMO 8:4">na mopam ahiafoɔ firi wɔn asase so,<verse eid="AMO 8:4"/></para>
  <para style="m">
    <verse number="5" style="v" sid="AMO 8:5"/>na moka sɛ,</para>
  <para style="q1" vid="AMO 8:5">“Ɛberɛ bɛn na ɔbosome foforɔ bɛtwam</para>
  <para style="q2" vid="AMO 8:5">ama yɛatɔn aduane,</para>
  <para style="q1" vid="AMO 8:5">na Homeda bɛba awieeɛ</para>
  <para style="q2" vid="AMO 8:5">ama yɛadi ayuo dwa?”</para>
  <para style="q1" vid="AMO 8:5">Sɛ mobɛhyɛ susukora mu</para>
  <para style="q2" vid="AMO 8:5">na moatoto ɛboɔ so</para>
  <para style="q2" vid="AMO 8:5">na mode nsania a wɔamia mu asisi atɔfoɔ,<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>na mode dwetɛ atɔ ahiafoɔ</para>
  <para style="q2" vid="AMO 8:6">na mmɔborɔwafoɔ nso moatɔn wɔn agye mpaboa,</para>
  <para style="q2" vid="AMO 8:6">na moapra ayuo ase afra ayuo mu atɔn.<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>
    <char style="nd">Awurade</char> de Yakob ahohoahoa aka ntam sɛ: “Me werɛ remfiri biribiara a wɔayɛ da.<verse eid="AMO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8"/>“Asase renwoso wɔ deɛ asie yi ho anaa,</para>
  <para style="q2" vid="AMO 8:8">na wɔn a wɔte mu nyinaa ntwa adwo anaa?</para>
  <para style="q1" vid="AMO 8:8">Asase no nyinaa bɛpagya ne ho te sɛ Nil<note caller="+" style="f"><char style="fr" closed="false">8.8 </char><char style="ft" closed="false">Yiri tɛnn te se Nil: Osu a ɛtɔ berɛ ano berɛ ano wɔ Etiopia no ma Asubɔnten Nil a ɛwɔ Misraim yiri bu fa so bɛyɛ anammɔn 25 ma ne subɔnhwa no yɛ ma. Nsuyire yi saa dɔte pa kɔgu asase no so.</char></note></para>
  <para style="q2" vid="AMO 8:8">ɛbubu afa so, na asane atwe bio</para>
  <para style="q2" vid="AMO 8:8">te sɛ Misraim asubɔnten.”<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>Sɛdeɛ Otumfoɔ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q1" vid="AMO 8:9">“Saa ɛda no, mɛma owia atɔ owigyinaeɛ,</para>
  <para style="q2" vid="AMO 8:9">na mama esum aduru asase so awia ketee.<verse eid="AMO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10"/>Mɛdane mo nyamesom apontoɔ ama ayɛ awerɛhoɔdie</para>
  <para style="q2" vid="AMO 8:10">na mo nnwontoɔ nyinaa adane osu.</para>
  <para style="q1" vid="AMO 8:10">Mɛma mo nyinaa afira ayitoma</para>
  <para style="q2" vid="AMO 8:10">na mayi mo tirinwi.</para>
  <para style="q1" vid="AMO 8:10">Mɛyɛ saa da no te sɛ ɔba korɔ ho awerɛhoɔdie da</para>
  <para style="q2" vid="AMO 8:10">na awieeɛ no ayɛ sɛ da a ɛyɛ nwono.<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11"/>“Nna no reba” sɛdeɛ Otumfoɔ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q2" vid="AMO 8:11">“Mɛma ɛkɔm aba asase no so,</para>
  <para style="q1" vid="AMO 8:11">ɛnnyɛ aduane ɛkɔm anaa nsukɔm,</para>
  <para style="q2" vid="AMO 8:11">na mmom, <char style="nd">Awurade</char> asɛm ho ɛkɔm.<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>Nnipa bɛtɔ ntentan akyinkyin firi ɛpo so akɔ ɛpo so</para>
  <para style="q2" vid="AMO 8:12">na wɔakyinkyini afiri atifi fam akɔ apueeɛ fam,</para>
  <para style="q1" vid="AMO 8:12">sɛ wɔrekɔhwehwɛ <char style="nd">Awurade</char> asɛm,</para>
  <para style="q2" vid="AMO 8:12">nanso wɔrenhunu.<verse eid="AMO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13"/>“Na saa da no</para>
  <para style="q1" vid="AMO 8:13">“mmabaawa ahoɔfɛfoɔ ne mmarimaa ahoɔdenfoɔ</para>
  <para style="q2" vid="AMO 8:13">bɛtotɔ baha ɛsiane osukɔm enti.<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>Wɔn a wɔde Samaria aniwuo abosom ka ntam,</para>
  <para style="q2" vid="AMO 8:14">anaa wɔde Dan ne Beer-Seba abosom ka ntamka no,</para>
  <para style="q2" vid="AMO 8:14">wɔbɛhwehwe ase na wɔrensɔre bio.”<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">Wɔbɛsɛe Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>Mehunuu <char style="nd">Awurade</char> sɛ ɔgyina afɔrebukyia no ho, na ɔkaa sɛ,</para>
  <para style="q1" vid="AMO 9:1">“Bɔ Asɔredan no afadum no atifi</para>
  <para style="q2" vid="AMO 9:1">na mma ne fapem no nwoso.</para>
  <para style="q1" vid="AMO 9:1">Mommubu ngu nnipa no nyinaa so;</para>
  <para style="q2" vid="AMO 9:1">wɔn a aka no mede akofena bɛkunkum wɔn.</para>
  <para style="q1" vid="AMO 9:1">Ɔbaako mpo rentumi nnwane</para>
  <para style="q2" vid="AMO 9:1">obiara remfiri mu mfi.<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>Mpo sɛ wɔtu fam kɔ awumena mu a</para>
  <para style="q2" vid="AMO 9:2">ɛhɔ na me nsa bɛtwe wɔn afiri aba.</para>
  <para style="q1" vid="AMO 9:2">Mpo sɛ wɔforo kɔ ɔsoro a</para>
  <para style="q2" vid="AMO 9:2">ɛhɔ na mɛyi wɔn afiri aba fam.<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>Mpo sɛ wɔkɔtetɛ bepɔ Karmel atifi a,</para>
  <para style="q2" vid="AMO 9:3">ɛhɔ na mɛti wɔn akɔkye wɔn aba.</para>
  <para style="q1" vid="AMO 9:3">Mpo sɛ wɔde wɔn ho sie me wɔ ɛpo ase a</para>
  <para style="q2" vid="AMO 9:3">ɛhɔ na mɛhyɛ ɔwɔ no ama wakɔkeka wɔn.<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>Mpo, sɛ wɔn atamfoɔ de wɔn kɔ nnommumfa mu a,</para>
  <para style="q2" vid="AMO 9:4">ɛhɔ na mɛhyɛ akofena akunkum wɔn.</para>
  <para style="b" vid="AMO 9:4"/>
  <para style="q1" vid="AMO 9:4">“Mɛgyene mʼani ahwɛ wɔn.</para>
  <para style="q2" vid="AMO 9:4">Mede ɔsɛeɛ bɛba wɔn so na meremmoa wɔn.”<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>
    <char style="nd">Awurade</char>, Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="AMO 9:5">Ɔno na ɔde ne nsa ka asase ma ɛnane,</para>
  <para style="q1" vid="AMO 9:5">ma wɔn a wɔte so nyinaa twa adwo.</para>
  <para style="q2" vid="AMO 9:5">Asase no nyinaa pagya te sɛ Nil</para>
  <para style="q2" vid="AMO 9:5">na ɛtwe te sɛ Misraim asubɔnten.<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>Ɔno na ɔsi nʼahemfie a ɛkrɔn wɔ ɔsoro</para>
  <para style="q2" vid="AMO 9:6">na ɔto ne fapem wɔ asase so.</para>
  <para style="q1" vid="AMO 9:6">Ɔno na ɔboaboa ɛpo mu nsuo ano</para>
  <para style="q2" vid="AMO 9:6">na ɔhwie gu asase so.</para>
  <para style="q2" vid="AMO 9:6">
    <char style="nd">Awurade</char> ne ne din!<verse eid="AMO 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7"/>“Mo Israelfoɔ,</para>
  <para style="q2" vid="AMO 9:7">mo ho hia me sene Etiopiafoɔ?”</para>
  <para style="q1" vid="AMO 9:7">Sɛdeɛ <char style="nd">Awurade</char> seɛ nie.</para>
  <para style="q2" vid="AMO 9:7">Manyi Israelfoɔ amfiri Misraim,</para>
  <para style="q1" vid="AMO 9:7">ne Filistifoɔ amfiri Kreta,</para>
  <para style="q2" vid="AMO 9:7">ɛne Aramfoɔ nso amfiri Kir anaa?<verse eid="AMO 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>“Ampa ara Otumfoɔ <char style="nd">Awurade</char> ani</para>
  <para style="q2" vid="AMO 9:8">wɔ nnebɔne ahennie no so.</para>
  <para style="q1" vid="AMO 9:8">Mɛpepa no afiri asase ani,</para>
  <para style="q2" vid="AMO 9:8">nanso, merensɛe Yakob efie korakora,”</para>
  <para style="q2" vid="AMO 9:8">sɛdeɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>“Na mɛhyɛ,</para>
  <para style="q2" vid="AMO 9:9">na mɛwoso Israel efie,</para>
  <para style="q2" vid="AMO 9:9">wɔ amanaman nyinaa mu,</para>
  <para style="q1" vid="AMO 9:9">sɛdeɛ wɔhuhu atokoɔ so wɔ huhuamoa mu</para>
  <para style="q2" vid="AMO 9:9">na aba fua mpo ntɔ fam no.<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>Nnebɔneyɛfoɔ a wɔwɔ me nkurɔfoɔ mu nyinaa</para>
  <para style="q2" vid="AMO 9:10">bɛtotɔ wɔ akofena ano,</para>
  <para style="q1" vid="AMO 9:10">wɔn a wɔka sɛ,</para>
  <para style="q2" vid="AMO 9:10">‘Amanehunu rento yɛn anaa ɛremma yɛn so da.’<verse eid="AMO 9:10"/></para>
  <para style="s1">Israel Nsiesieɛ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>“Saa ɛda no, mɛsane aba abɛsi</para>
  <para style="q1" vid="AMO 9:11">“Dawid efie a abubu no bio.</para>
  <para style="q2" vid="AMO 9:11">Mɛsiesie ne baabi a asɛeɛ no,</para>
  <para style="q2" vid="AMO 9:11">na masi no sɛdeɛ na ɛteɛ no,<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>na wɔafa Edom nkaeɛfoɔ no,</para>
  <para style="q2" vid="AMO 9:12">ne amanaman a me din da wɔn so.”</para>
  <para style="q2" vid="AMO 9:12">
    <char style="nd">Awurade</char> a waka no, ɔno na ɔbɛyɛ yeinom nyinaa.<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>“Nna no reba,” sɛdeɛ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q1" vid="AMO 9:13">“A nnɔbaeɛ no bɛba ntɛm ama ɔtwafoɔ no,</para>
  <para style="q2" vid="AMO 9:13">na bobe no abu so ama deɛ ɔtiatia nsakyiamena no so no.</para>
  <para style="q1" vid="AMO 9:13">Nsa foforɔ bɛsɔne afiri mmepɔ no so</para>
  <para style="q2" vid="AMO 9:13">na atene wɔ nkokoɔ no nyinaa so.<verse eid="AMO 9:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14"/>Mede me nkurɔfoɔ Israel nnommumfoɔ bɛsane aba.</para>
  <para style="b" vid="AMO 9:14"/>
  <para style="q1" vid="AMO 9:14">“Wɔbɛsane asiesie nkuropɔn a asɛeɛ no na wɔatena mu.</para>
  <para style="q2" vid="AMO 9:14">Wɔbɛyɛ bobe nturo na wɔanom mu nsã;</para>
  <para style="q2" vid="AMO 9:14">wɔbɛyɛ mfikyifuo na wɔadi so nnuaba.<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>Mede Israelfoɔ bɛdua wɔn ankasa asase so</para>
  <para style="q2" vid="AMO 9:15">a wɔrentu bio da</para>
  <para style="q2" vid="AMO 9:15">mfiri asase a mede ama wɔn no so,”</para>
  <para style="m" vid="AMO 9:15">sɛdeɛ <char style="nd">Awurade</char>, mo Onyankopɔn seɛ nie.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
