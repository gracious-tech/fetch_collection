<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Nahum</para>
  <para style="toc1">Odiyifoɔ Nahum Nwoma</para>
  <para style="toc2">Nahum</para>
  <para style="toc3">Nah</para>
  <para style="mt2">Odiyifoɔ</para>
  <para style="mt1">Nahum</para>
  <para style="mt2">Nwoma</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>Elkosini Nahum anisoadehunu nwoma a ɛyɛ nkɔmhyɛ a ɛfa Ninewe ho.<verse eid="NAM 1:1"/></para>
  <para style="s1">Awurade Abufuo A Ɛtia Ninewe</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>
    <char style="nd">Awurade</char> yɛ ninkunfoɔ ne aweretɔ Onyankopɔn,</para>
  <para style="q2" vid="NAM 1:2">
    <char style="nd">Awurade</char> tɔ wedeɛ na abufuo ahyɛ no ma.</para>
  <para style="q1" vid="NAM 1:2">
    <char style="nd">Awurade</char> tɔ nʼatamfoɔ so wedeɛ</para>
  <para style="q2" vid="NAM 1:2">na nʼabufuo tena wɔn so.<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>
    <char style="nd">Awurade</char> bo kyɛre fu, na ne tumi so,</para>
  <para style="q2" vid="NAM 1:3">na ɔtwe ɔfɔdifoɔ aso.</para>
  <para style="q1" vid="NAM 1:3">Ne kwan wɔ ntwahoframa ne ahum mu,</para>
  <para style="q2" vid="NAM 1:3">omununkum yɛ ne nan ase mfuturo.<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>Ɔteatea ɛpo na ɔma ɛwe;</para>
  <para style="q2" vid="NAM 1:4">ɔma nsubɔntene nyinaa wewe.</para>
  <para style="q1" vid="NAM 1:4">Basan ne Karmel twintwam</para>
  <para style="q2" vid="NAM 1:4">na Lebanon frɔmfrɔmyɛ nso kusa.<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>Mmepɔ woso biribiri nʼanim</para>
  <para style="q2" vid="NAM 1:5">na nkokoɔ nane.</para>
  <para style="q1" vid="NAM 1:5">Asase, ewiase ne wɔn a wɔwɔ mu nyinaa</para>
  <para style="q2" vid="NAM 1:5">woso nʼanim.<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>Hwan na ɔbɛtumi agyina nʼabufuo ano?</para>
  <para style="q2" vid="NAM 1:6">Hwan na ɔbɛtumi atena nʼabufuhyeɛ mu?</para>
  <para style="q1" vid="NAM 1:6">Nʼabufuo hwie te sɛ ogya;</para>
  <para style="q2" vid="NAM 1:6">abotan yam wɔ nʼanim.<verse eid="NAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>
    <char style="nd">Awurade</char> yɛ,</para>
  <para style="q2" vid="NAM 1:7">ɔyɛ ahohia mu dwanekɔbea.</para>
  <para style="q1" vid="NAM 1:7">Nʼani wɔ wɔn a wɔde wɔn ho to no so no so.<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>Nanso, ɔnam nsuyire nwanwasoɔ so</para>
  <para style="q1" vid="NAM 1:8">bɛma Ninewe aba awieeɛ.</para>
  <para style="q2" vid="NAM 1:8">Ɔbɛtaa nʼatamfoɔ akɔduru esum kabii mu.<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>Ɛpɔ biara a wɔbɛbɔ atia <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="NAM 1:9">ɔbɛsɛe no;</para>
  <para style="q2" vid="NAM 1:9">ɔhaw biara remma ne mprenu so.<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>Wɔde nkasɛɛ bɛkyekyere wɔn ho,</para>
  <para style="q2" vid="NAM 1:10">na ɛberɛ a wɔn nsa aboro wɔn no</para>
  <para style="q2" vid="NAM 1:10">wɔbɛhye wɔn sɛ wira dwaneeɛ a wɔaboa ano.<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>Ao, Ninewe, wo mu na</para>
  <para style="q2" vid="NAM 1:11">deɛ ɔbɔ ɛpɔ bɔne tia <char style="nd">Awurade</char></para>
  <para style="q1" vid="NAM 1:11">na ɔtu fo bɔne no firie.<verse eid="NAM 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12"/>Deɛ <char style="nd">Awurade</char> seɛ nie:</para>
  <para style="q2" vid="NAM 1:12">“Ɛwom sɛ wɔwɔ apamfoɔ a wɔdɔɔso deɛ,</para>
  <para style="q1" vid="NAM 1:12">nanso wɔbɛsɛe wɔn ama wɔayera.</para>
  <para style="q2" vid="NAM 1:12">Ao Yuda, ɛwom sɛ mama ɔhaw aba wo so,</para>
  <para style="q2" vid="NAM 1:12">nanso merenyɛ saa bio.<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>Afei, mɛbubu kɔnnua a ɛda wo kɔn mu</para>
  <para style="q2" vid="NAM 1:13">na matete nkɔnsɔnkɔnsɔn no mu.”<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>Ninewe, <char style="nd">Awurade</char> aka ɔhyɛ asɛm a ɛfa wo ho:</para>
  <para style="q2" vid="NAM 1:14">“Worennya asefoɔ a wo din bɛda wɔn so.</para>
  <para style="q1" vid="NAM 1:14">Mɛsɛe nsɛsodeɛ a wɔasene ne ahoni a wɔaguo</para>
  <para style="q2" vid="NAM 1:14">a ɛsisi wʼabosonnan mu no.</para>
  <para style="q1" vid="NAM 1:14">Mɛsiesie wʼadamena</para>
  <para style="q2" vid="NAM 1:14">ɛfiri sɛ wadane ayɛ atantanneɛ.”<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>Hwɛ mmepɔ no so,</para>
  <para style="q2" vid="NAM 1:15">deɛ a ɔde asɛmpa no ba no anammɔn</para>
  <para style="q2" vid="NAM 1:15">ɔno na ɔka asomdwoesɛm!</para>
  <para style="q1" vid="NAM 1:15">Ao, Yuda di wʼafahyɛ na</para>
  <para style="q2" vid="NAM 1:15">di wɔ bɔhyɛ so.</para>
  <para style="q1" vid="NAM 1:15">Nnipa bɔne rentu wo so sa bio;</para>
  <para style="q2" vid="NAM 1:15">Wɔbɛsɛe wɔn pasaa.<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">Ninewe Asehweɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>Ɔtohyɛsoɔni reba wo so, Ninewe</para>
  <para style="q2" vid="NAM 2:1">bɔ aban no ho ban,</para>
  <para style="q1" vid="NAM 2:1">wɛn ɛkwan no,</para>
  <para style="q2" vid="NAM 2:1">bɔ wo ho so</para>
  <para style="q1" vid="NAM 2:1">na boa wʼahoɔden nyinaa ano!<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>
    <char style="nd">Awurade</char> de Yakob animuonyam bɛsane ama no</para>
  <para style="q2" vid="NAM 2:2">te sɛ Israel deɛ no,</para>
  <para style="q1" vid="NAM 2:2">ɛwom sɛ, asɛefoɔ no ama ada mpan</para>
  <para style="q2" vid="NAM 2:2">na wɔasɛe ne bobe mfuo.<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>Asraafoɔ no akokyɛm yɛ kɔkɔɔ;</para>
  <para style="q2" vid="NAM 2:3">akofoɔ no hyehyɛ kɔben akotaadeɛ.</para>
  <para style="q1" vid="NAM 2:3">Nnadeɛ a wɔde yɛɛ nteaseɛnam no</para>
  <para style="q2" vid="NAM 2:3">twa nyinam nyinam sɛ da a wɔyɛeɛ no;</para>
  <para style="q2" vid="NAM 2:3">mpea a wapoma wɔ nnua so no rehim.<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>Nteaseɛnam no twi fa mmɔntene so,</para>
  <para style="q2" vid="NAM 2:4">na wɔdi akɔneaba.</para>
  <para style="q1" vid="NAM 2:4">Wɔte sɛ ogyatɛn a ɛrederɛ;</para>
  <para style="q2" vid="NAM 2:4">wɔbɔ yerɛdɛ te sɛ anyinam.<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>Ɔfrɛfrɛɛ nʼakofoɔ a wodi mu</para>
  <para style="q2" vid="NAM 2:5">nanso wɔsuntisunti wɔ ɛkwan mu.</para>
  <para style="q1" vid="NAM 2:5">Wɔde mmirika kɔ kuropɔn no afasuo ho;</para>
  <para style="q2" vid="NAM 2:5">na wɔyɛ wɔn akokyɛm krado.<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>Wɔbuebue asubɔnten apono no,</para>
  <para style="q2" vid="NAM 2:6">na ahemfie no dwiri gu fam.<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>Wɔhyɛ mmaraden sɛ</para>
  <para style="q2" vid="NAM 2:7">wɔmfa kuropɔn no nnommum</para>
  <para style="q1" vid="NAM 2:7">na wɔmfa wɔn nkɔ.</para>
  <para style="q2" vid="NAM 2:7">Ne mfenaa de wɔn nsa gu wɔn koko so</para>
  <para style="q2" vid="NAM 2:7">su te sɛ mmorɔnoma.<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>Ninewe te sɛ ɔtadeɛ a</para>
  <para style="q2" vid="NAM 2:8">emu nsuo resene korɔ.</para>
  <para style="q1" vid="NAM 2:8">Woteam sɛ, “Monnyina hɔ! Monnyina hɔ!”</para>
  <para style="q2" vid="NAM 2:8">Nanso, obiara ansane nʼakyi.<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>Momfom dwetɛ no!</para>
  <para style="q2" vid="NAM 2:9">Momfom sikakɔkɔɔ no!</para>
  <para style="q1" vid="NAM 2:9">Ahonyadeɛ a ɛwɔ akoradan mu nyinaa!</para>
  <para style="q2" vid="NAM 2:9">Na ahonyadeɛ no dɔɔso.<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>Wɔabɔ Ninewe korɔno, wɔayɛ no pasaa!</para>
  <para style="q2" vid="NAM 2:10">Akoma boto, na nkotodwe woso woso,</para>
  <para style="q2" vid="NAM 2:10">nnipa ho popo na wɔn anim to hoa.<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>Seesei ɛhe na gyatabuo no wɔ,</para>
  <para style="q2" vid="NAM 2:11">baabi a wɔma wɔn mma aduane no,</para>
  <para style="q1" vid="NAM 2:11">baabi a gyatanini ne gyatabereɛ korɔ</para>
  <para style="q2" vid="NAM 2:11">na wɔn mma nso kɔ a wɔnsuro?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>Gyata akum deɛ ɛbɛmee ne mma.</para>
  <para style="q2" vid="NAM 2:12">Wabobɔ ahaboa ama gyatabereɛ no.</para>
  <para style="q1" vid="NAM 2:12">Ɔde deɛ wakum ahyɛ ne bɔn ma</para>
  <para style="q2" vid="NAM 2:12">na ɔde ahaboa ahyɛ nʼatuo mama.<verse eid="NAM 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>“Me ne wo nnka,”</para>
  <para style="q2" vid="NAM 2:13">sɛdeɛ Asafo <char style="nd">Awurade</char> seɛ ni,</para>
  <para style="q1" vid="NAM 2:13">“Mɛhye wo nteaseɛnam na adane wisie</para>
  <para style="q2" vid="NAM 2:13">na akofena bɛkunkum wʼagyata mma.</para>
  <para style="q1" vid="NAM 2:13">Merennya wo ahaboa biara wɔ asase so.</para>
  <para style="q2" vid="NAM 2:13">Wɔrente wʼasomafoɔ no nne bio.”<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">Ninewe Nnome</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>Nnome nka mogya kuropɔn</para>
  <para style="q2" vid="NAM 3:1">a atorɔ ne korɔno ahyɛ no ma</para>
  <para style="q2" vid="NAM 3:1">na amanehunufoɔ mmpa mu da!<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>Apɔnkɔkafoɔ abaa regyegye,</para>
  <para style="q2" vid="NAM 3:2">nteaseɛnam nhankra reyɛ kirididi</para>
  <para style="q1" vid="NAM 3:2">Apɔnkɔ rehurihuri</para>
  <para style="q2" vid="NAM 3:2">ne nteaseɛnam redenkye denkye.<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>Apɔnkɔ ne wɔn sotefoɔ ko kɔ wɔn anim</para>
  <para style="q2" vid="NAM 3:3">akofena twa nyinam nyinam</para>
  <para style="q2" vid="NAM 3:3">na mpea nso pa yerɛ yerɛ.</para>
  <para style="q1" vid="NAM 3:3">Atɔfoɔ bebree,</para>
  <para style="q2" vid="NAM 3:3">awufoɔ a ebi deda ebi soɔ,</para>
  <para style="q1" vid="NAM 3:3">afunu a wɔntumi nkan wɔn dodoɔ</para>
  <para style="q2" vid="NAM 3:3">a nnipa tiatia soɔ.<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>Yei nyinaa firi odwamanfoɔ bi akɔnnɔ,</para>
  <para style="q2" vid="NAM 3:4">ntafowayifoɔ no nnaadaa dodoɔ no.</para>
  <para style="q1" vid="NAM 3:4">Ɔno na ɔde nʼadwamammɔ tɔn amanaman</para>
  <para style="q2" vid="NAM 3:4">na ɔde nʼabayisɛm tɔn nnipa.<verse eid="NAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>“Me ne wo nnka,” sɛdeɛ Asafo <char style="nd">Awurade</char> seɛ ni,</para>
  <para style="q2" vid="NAM 3:5">“Mɛpagya wʼatadeɛ akɔ soro.</para>
  <para style="q1" vid="NAM 3:5">Mɛma amanaman ahunu wʼadagya</para>
  <para style="q2" vid="NAM 3:5">na ahennie ahodoɔ nso ahunu wʼanimguaseɛ.<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>Mede efi bɛfɔre wo ho,</para>
  <para style="q2" vid="NAM 3:6">mɛbu wo animtia</para>
  <para style="q2" vid="NAM 3:6">na mama nnipa ahwɛ wo.<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>Obiara a ɔbɛhunu wo bɛdwane afiri wo ho aka sɛ,</para>
  <para style="q2" vid="NAM 3:7">‘Ninewe abɔ, na hwan na ɔbɛsu no?’</para>
  <para style="q2" vid="NAM 3:7">Ɛhe na menya obi akyekyere wo werɛ?”<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>Woyɛ sene Tebes a</para>
  <para style="q2" vid="NAM 3:8">ɛda Asubɔnten Nil ho a</para>
  <para style="q2" vid="NAM 3:8">nsuo atwa he ho ahyia anaa?</para>
  <para style="q1" vid="NAM 3:8">Asubɔnten bɔ ne ho ban</para>
  <para style="q2" vid="NAM 3:8">na nsuo yɛ ne fasuo.<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>Kus ne Misraim yɛ ne dɔm a wɔntumi nkan wɔn.</para>
  <para style="q2" vid="NAM 3:9">Put ne Libia ka nʼadomfoɔ ho.<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>Nanso wɔfaa no dommum</para>
  <para style="q2" vid="NAM 3:10">twaa no asuo.</para>
  <para style="q1" vid="NAM 3:10">Wɔtoo ne mmadoma hwehwee fam</para>
  <para style="q2" vid="NAM 3:10">ma wɔtetee wɔ mmɔntene so.</para>
  <para style="q1" vid="NAM 3:10">Wɔbɔɔ nʼaberempɔn so ntonto,</para>
  <para style="q2" vid="NAM 3:10">na nʼatitire nso wɔde nkɔnsɔnkɔnsɔn guguu wɔn.<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>Wo nso wʼani so bɛyɛ wo hagyahagya sɛ ɔsabofoɔ</para>
  <para style="q2" vid="NAM 3:11">Na wo bɛhinta wo ho</para>
  <para style="q2" vid="NAM 3:11">de akɔpɛ dwanekɔbea wɔ atamfoɔ nkyɛn.<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>Wʼaban nyinaa te sɛ borɔdɔma nnua</para>
  <para style="q2" vid="NAM 3:12">a aso aba foforɔ:</para>
  <para style="q1" vid="NAM 3:12">sɛ wɔwoso a</para>
  <para style="q2" vid="NAM 3:12">aba no tete gu ma deɛ ɔrepɛ bi adi.<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>Hwɛ wʼakofoɔ</para>
  <para style="q2" vid="NAM 3:13">wɔn nyinaa yɛ mmaa!</para>
  <para style="q1" vid="NAM 3:13">Wʼasase so apono ano deda hɔ ma wʼatamfoɔ;</para>
  <para style="q2" vid="NAM 3:13">ogya ahye wʼapono no akyiri adaban.<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>Sesa nsuo sie ma otua no.</para>
  <para style="q2" vid="NAM 3:14">Yere wo banbɔ mu!</para>
  <para style="q1" vid="NAM 3:14">Wɔ dɔteɛ no</para>
  <para style="q2" vid="NAM 3:14">na siesie ntayaa a wato no!<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>Ɛhɔ na ogya bɛhye woɔ;</para>
  <para style="q2" vid="NAM 3:15">akofena bɛtwa wo ahwe fam,</para>
  <para style="q1" vid="NAM 3:15">na ayɛ wo sɛdeɛ mmɛbɛ adi wo nam.</para>
  <para style="q2" vid="NAM 3:15">Mo nnɔre sɛ mmɛbɛ anaa ntutummɛ!<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>Wama wʼadwadifoɔ adɔɔso,</para>
  <para style="q2" vid="NAM 3:16">wɔn dodoɔ asene ɔsoro nsoromma,</para>
  <para style="q1" vid="NAM 3:16">nanso wɔte sɛ ntutummɛ a wɔbɔ asase no kwaterekwa</para>
  <para style="q2" vid="NAM 3:16">na afei wɔtu kɔ.<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>Wʼawɛmfoɔ te sɛ ntutummɛ.</para>
  <para style="q2" vid="NAM 3:17">Wʼadwumayɛfoɔ te sɛ ntutummɛ akuo</para>
  <para style="q2" vid="NAM 3:17">a wɔsensam ban ho awɔ da.</para>
  <para style="q1" vid="NAM 3:17">Adekyeɛ mu owia pue a wɔtu kɔ,</para>
  <para style="q2" vid="NAM 3:17">na obi nnim faako a wɔkɔ.<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>Ao, Asiriahene wo nnwanhwɛfoɔ retɔ nko.</para>
  <para style="q2" vid="NAM 3:18">Wʼanimuonyamfoɔ deda hɔ rehome.</para>
  <para style="q1" vid="NAM 3:18">Wo nkurɔfoɔ abɔ apete wɔ mmepɔ no so</para>
  <para style="q2" vid="NAM 3:18">a wɔnni anoboaboafoɔ.<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>Aduro biara ntumi nkum wʼapirakuro no;</para>
  <para style="q2" vid="NAM 3:19">wo pira no mu yɛ den.</para>
  <para style="q1" vid="NAM 3:19">Obiara a ɔte wo nka no</para>
  <para style="q2" vid="NAM 3:19">bɔ ne nsam wɔ wʼasehweɛ ho,</para>
  <para style="q1" vid="NAM 3:19">Na hwan koraa na wommɔɔ</para>
  <para style="q2" vid="NAM 3:19">no atirimuɔden da?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
