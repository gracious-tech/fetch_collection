<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Habakuk</para>
  <para style="toc1">Odiyifoɔ Habakuk Nwoma</para>
  <para style="toc2">Habakuk</para>
  <para style="toc3">Hab</para>
  <para style="mt2">Odiyifoɔ</para>
  <para style="mt1">Habakuk</para>
  <para style="mt2">Nwoma</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>Yei ne asɛm a odiyifoɔ Habakuk nya firii Awurade nkyɛn wɔ anisoadehunu mu.<verse eid="HAB 1:1"/></para>
  <para style="s1">Habakuk Anwiinwii</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2"/>Ao, <char style="nd">Awurade</char>, memfrɛ mmisa mmoa nkɔsi da bɛn,</para>
  <para style="q2" vid="HAB 1:2">a nso wontie me?</para>
  <para style="q1" vid="HAB 1:2">Meteam mefrɛ wo, akakabensɛm enti,</para>
  <para style="q2" vid="HAB 1:2">nanso womma mmɛgye me.<verse eid="HAB 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3"/>Adɛn na woma mehwɛ ntɛnkyea?</para>
  <para style="q2" vid="HAB 1:3">Adɛn enti na wotena bɔne ho?</para>
  <para style="q1" vid="HAB 1:3">Ɔsɛeɛ ne akakabensɛm da mʼanim,</para>
  <para style="q2" vid="HAB 1:3">basabasayɛ ne abɛbrɛsɛ atwa me ahyia.<verse eid="HAB 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4"/>Enti, mmara nyɛ adwuma</para>
  <para style="q2" vid="HAB 1:4">na atɛntenenee nni baabiara,</para>
  <para style="q1" vid="HAB 1:4">atirimuɔdenfoɔ aka ateneneefoɔ ahyɛ,</para>
  <para style="q2" vid="HAB 1:4">enti wɔkyea atemmuo.<verse eid="HAB 1:4"/></para>
  <para style="s1">Awurade Mmuaeɛ</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5"/>“Momma ɛnyɛ mo nwanwa,</para>
  <para style="q2" vid="HAB 1:5">na mo ho nnwiri mo!</para>
  <para style="q1" vid="HAB 1:5">Merebɛyɛ biribi wɔ mo berɛ so,</para>
  <para style="q2" vid="HAB 1:5">na sɛ obi ka kyerɛ mo a,</para>
  <para style="q2" vid="HAB 1:5">morennye nni.<verse eid="HAB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6"/>Mema Babiloniafoɔ asɔre,</para>
  <para style="q2" vid="HAB 1:6">ɔman a wɔyɛ atirimuɔdenfoɔ ne ntɔkwapɛfoɔ;</para>
  <para style="q1" vid="HAB 1:6">wɔbufa asase nyinaa so,</para>
  <para style="q2" vid="HAB 1:6">na wɔfa tenabea a ɛnyɛ wɔn dea.<verse eid="HAB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7"/>Wɔn ho yɛ hu na nnipa suro wɔn;</para>
  <para style="q2" vid="HAB 1:7">wɔyɛ wɔn bo so adeɛ,</para>
  <para style="q2" vid="HAB 1:7">de pɛ animuonyam ma wɔn ho.<verse eid="HAB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8"/>Wɔn apɔnkɔ ho yɛ herɛ sene asebɔ,</para>
  <para style="q2" vid="HAB 1:8">na wɔn ho yɛ hu sene pataku a ɔnam anadwo,</para>
  <para style="q1" vid="HAB 1:8">wɔn apɔnkɔsotefoɔ kɔ wɔn anim mmarima so,</para>
  <para style="q2" vid="HAB 1:8">wɔfiri akyirikyiri nsase so,</para>
  <para style="q1" vid="HAB 1:8">na wɔto hoo sɛ akroma a ɔrekɔkye aboa.<verse eid="HAB 1:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9"/>Wɔn nyinaa ba sɛ wɔrebɛyɛ basabasayɛ.</para>
  <para style="q1" vid="HAB 1:9">Wɔn dɔm pem kɔ wɔn anim te sɛ anweatam so mframa,</para>
  <para style="q2" vid="HAB 1:9">na wɔtase nneduafoɔ sɛ anwea.<verse eid="HAB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10"/>Wɔmmmu ahene,</para>
  <para style="q2" vid="HAB 1:10">wɔdi aman sodifoɔ ho fɛw,</para>
  <para style="q1" vid="HAB 1:10">na wɔtwee nkuropɔn ho banbɔ denden.</para>
  <para style="q2" vid="HAB 1:10">Wɔsisi dɔteɛ epie nam so kyekyere atamfoɔ.<verse eid="HAB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11"/>Wɔbɔ hoo te sɛ mframa kɔ wɔn anim.</para>
  <para style="q2" vid="HAB 1:11">Afɔdifoɔ a wɔn ahoɔden yɛ wɔn nyame.”<verse eid="HAB 1:11"/></para>
  <para style="s1">Habakuk Nwiinwii Bio</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12"/>Ao, <char style="nd">Awurade</char>, wonni hɔ firi tete anaa?</para>
  <para style="q2" vid="HAB 1:12">Me Onyankopɔn, me Kronkronni, wo a wote ase daa.</para>
  <para style="q1" vid="HAB 1:12">Ao, <char style="nd">Awurade</char>, woapa wɔn sɛ wɔmmu atɛn;</para>
  <para style="q2" vid="HAB 1:12">Ao Ɔbotantim, woahyɛ wɔn sɛ wɔntwe aso.<verse eid="HAB 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13"/>Wʼaniwa yɛ kronkron, a wontumi nhwɛ nnebɔne;</para>
  <para style="q2" vid="HAB 1:13">wonnyegye bɔne so.</para>
  <para style="q1" vid="HAB 1:13">Na ɛdeɛn enti na wogyegye nnipa kɔntɔnkye so,</para>
  <para style="q2" vid="HAB 1:13">na ɛdeɛn enti na wayɛ komm wɔ ɛberɛ a</para>
  <para style="q2" vid="HAB 1:13">atirimuɔdenfoɔ remene ateneneefoɔ?<verse eid="HAB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14"/>Woama nnipa ayɛ sɛ nsuomnam a ɛwɔ ɛpo mu,</para>
  <para style="q2" vid="HAB 1:14">te sɛ abɔdeɛ a ɛwɔ ɛpo mu a wonni sodifoɔ.<verse eid="HAB 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15"/>Ɔtamfoɔ tirimuɔdenfoɔ no de darewa yi wɔn,</para>
  <para style="q2" vid="HAB 1:15">ɔgu nʼasau de buma wɔn,</para>
  <para style="q2" vid="HAB 1:15">na afei ɔsɛpɛ ne ho ma nʼani gye.<verse eid="HAB 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16"/>Ne saa enti ɔbɔ afɔdeɛ ma nʼasau</para>
  <para style="q2" vid="HAB 1:16">na wahye aduhwam ama no,</para>
  <para style="q1" vid="HAB 1:16">ɛfiri sɛ asau yi so na ɔnam nya ateyie,</para>
  <para style="q2" vid="HAB 1:16">na ɔdi nʼakɔnnɔ aduane.<verse eid="HAB 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17"/>Enti ɔnkɔ so nni nʼasau mu nam,</para>
  <para style="q2" vid="HAB 1:17">na ɔmfa atirimuɔden nsɛe aman anaa?<verse eid="HAB 1:17"/></para>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1"/>Mɛgyina mʼahwɛeɛ na mawɛn.</para>
  <para style="q2" vid="HAB 2:1">Mɛbɔ nsra</para>
  <para style="q1" vid="HAB 2:1">na mahwɛ deɛ ɔbɛka akyerɛ me,</para>
  <para style="q2" vid="HAB 2:1">ne mʼanoyie a mede bɛma nkurobɔ yi.<verse eid="HAB 2:1"/></para>
  <para style="s1">Awurade Mmuaeɛ Foforɔ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>Afei, <char style="nd">Awurade</char> buaa sɛ,</para>
  <para style="q1" vid="HAB 2:2">“Twerɛ adiyie yi wɔ abopono so</para>
  <para style="q2" vid="HAB 2:2">ma emu nna hɔ pefee</para>
  <para style="q1" vid="HAB 2:2">ama ɔkenkanfoɔ ate aseɛ.<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>Adiyisɛm no retwɛn hyɛberɛ bi;</para>
  <para style="q2" vid="HAB 2:3">ɛka awieeɛ ho asɛm</para>
  <para style="q1" vid="HAB 2:3">na ɛbɛba mu.</para>
  <para style="q2" vid="HAB 2:3">Ɛwom sɛ ɛrekyɛre deɛ, nanso twɛn,</para>
  <para style="q2" vid="HAB 2:3">ɛrenkyɛre, ɛbɛba mu.<verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>“Hwɛ, wama ne ho so;</para>
  <para style="q2" vid="HAB 2:4">nʼapɛdeɛ ntene,</para>
  <para style="q2" vid="HAB 2:4">nanso ɔteneneeni firi gyidie mu bɛnya nkwa.<verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>Nokorɛm, nsã ayi no ama</para>
  <para style="q2" vid="HAB 2:5">wayɛ ahantan na ɔnni ahotɔ.</para>
  <para style="q1" vid="HAB 2:5">Esiane sɛ ɔyɛ adifudepɛ sɛ damena</para>
  <para style="q2" vid="HAB 2:5">na ɔte sɛ owuo a hwee mmee no enti</para>
  <para style="q1" vid="HAB 2:5">ɔfom aman no nyinaa</para>
  <para style="q2" vid="HAB 2:5">na ɔfa amanfoɔ no nyinaa nnommum.<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>“Nnommumfoɔ yi nyinaa bɛdi ne ho fɛ asere no aka sɛ,</para>
  <para style="q1" vid="HAB 2:6">“ ‘Nnome nka deɛ ɔboaboa korɔnodeɛ ano,</para>
  <para style="q2" vid="HAB 2:6">na ɔnam apoobɔ so nya ne ho!</para>
  <para style="q2" vid="HAB 2:6">Yei nkɔ so nkɔsi da bɛn?’<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>Wɔn a wode wɔn ka no bɛsɔre mpofirim so.</para>
  <para style="q2" vid="HAB 2:7">Wɔbɛsɔre ama wo ho apopo</para>
  <para style="q2" vid="HAB 2:7">na wɔbɛtwi afa wo so.<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>Esiane sɛ woafo aman bebree enti,</para>
  <para style="q2" vid="HAB 2:8">wɔn a wɔaka no bɛfo wo bi.</para>
  <para style="q1" vid="HAB 2:8">Ɛfiri sɛ woahwie nnipa mogya agu;</para>
  <para style="q2" vid="HAB 2:8">woasɛe nsase, nkuropɔn ne wɔn a wɔtete mu.<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>“Nnome nka deɛ ɔde korɔnodeɛ kyekyere ne ɔman,</para>
  <para style="q2" vid="HAB 2:9">a ɔyɛ ne pirebuo wɔ sorɔnsorɔmmea,</para>
  <para style="q2" vid="HAB 2:9">sɛdeɛ ɔbɛyi ne ho afiri ɔsɛeɛ mu.<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>Woatu nnipa bebree sɛeɛ ho agyina,</para>
  <para style="q2" vid="HAB 2:10">de agu wo fie anim ase, na wode wo nkwa atwa so.<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>Aboɔ a ɛhyehyɛ afie afasuo mu no bɛteam</para>
  <para style="q2" vid="HAB 2:11">na ɛbɛgyegye wɔ mpunan a wɔahyehyɛ no mu.<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>“Nnome nka deɛ ɔnam mogya hwieguo so kyekyere kuropɔn</para>
  <para style="q2" vid="HAB 2:12">na ɔnam awudie so kyekyere kuro.<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>Asafo <char style="nd">Awurade</char> ahyɛ sɛ,</para>
  <para style="q2" vid="HAB 2:13">nnipa no adwumayɛ bɛyɛ ogya a wɔhye.</para>
  <para style="q1" vid="HAB 2:13">Aman no brɛ gu kwa. <verse eid="HAB 2:13"/><verse number="14" style="v" sid="HAB 2:14"/>Na <char style="nd">Awurade</char> animuonyam ho nimdeɛ bɛhyɛ asase nyinaa ma,</para>
  <para style="q2" vid="HAB 2:14">sɛdeɛ nsuo hyɛ ɛpo ma no.<verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>“Due! Wo a woma wo mfɛfoɔ nsã,</para>
  <para style="q2" vid="HAB 2:15">Wohwie ma wɔnom kɔsi sɛ wɔbɛboro,</para>
  <para style="q2" vid="HAB 2:15">na afei woahwɛ wɔn adagya.<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>Worennya animuonyam biara. Wʼani bɛwu.</para>
  <para style="q2" vid="HAB 2:16">Afei aduru wo so. Nom na tɔ ntintan.</para>
  <para style="q1" vid="HAB 2:16">Kuruwa a ɛfiri <char style="nd">Awurade</char> nsa nifa reba wo so,</para>
  <para style="q2" vid="HAB 2:16">Aniwuo bɛkata wʼanimuonyam so<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>Awurukasɛm a wode adi Lebanon no bɛmene wo,</para>
  <para style="q2" vid="HAB 2:17">ɔsɛeɛ a wosɛee mmoa nso bɛbɔ wo hu.</para>
  <para style="q1" vid="HAB 2:17">Woaka nnipa mogya agu;</para>
  <para style="q2" vid="HAB 2:17">woasɛe nsase, nkuropɔn ne nnipa a wɔwɔ mu.<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>“Ɛdeɛn mfasodeɛ na monya firi ahoni a onipa ayɛ mu?</para>
  <para style="q2" vid="HAB 2:18">Anaa nsɛsodeɛ a ɛkyerɛkyerɛ atorɔ?</para>
  <para style="q1" vid="HAB 2:18">Deɛ ɔyɛ ohoni no de ne ho to ɔno ankasa nsa ano adwuma so;</para>
  <para style="q2" vid="HAB 2:18">na ɔyɛ anyame a wɔntumi nkasa.<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>Nnome nka deɛ ɔka kyerɛ dua sɛ, ‘Nya nkwa!’</para>
  <para style="q2" vid="HAB 2:19">Anaa ɔka kyerɛ ɛboɔ a ɛnni nkwa sɛ, ‘Nyane!’</para>
  <para style="q1" vid="HAB 2:19">Ɛbɛtumi ama akwankyerɛ?</para>
  <para style="q2" vid="HAB 2:19">Wɔde sika kɔkɔɔ ne dwetɛ adura ho;</para>
  <para style="q2" vid="HAB 2:19">nanso ahomeɛ nni mu.”<verse eid="HAB 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>Nanso <char style="nd">Awurade</char> wɔ nʼasɔrefie kronkron mu.</para>
  <para style="q2" vid="HAB 2:20">Momma asase nyinaa nyɛ komm wɔ nʼanim.<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">Habakuk Mpaeɛbɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 3:1"/>Saa mpaeɛbɔ yi, Habakuk too no sɛ dwom:<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>
    <char style="nd">Awurade</char>, mate wo ho nsɛm nyinaa,</para>
  <para style="q2" vid="HAB 3:2">na me ho adwiri me wɔ wʼanwanwannwuma a woayɛ ho,</para>
  <para style="q1" vid="HAB 3:2">Yɛ no foforɔ wɔ yɛn mmerɛ so.</para>
  <para style="q2" vid="HAB 3:2">Yɛn mmerɛ yi mu, ma wɔnhunu.</para>
  <para style="q2" vid="HAB 3:2">Wʼabofuhyeɛ mu no, kae wo mmɔborɔhunu.<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>Onyankopɔn firi Teman baeɛ,</para>
  <para style="q2" vid="HAB 3:3">Ɔkronkronni a ɔfiri Bepɔ Paran so,</para>
  <para style="q1" vid="HAB 3:3">Nʼanimuonyam kata ɔsoro,</para>
  <para style="q2" vid="HAB 3:3">na nʼayɛyie hyɛ asase so ma.<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>Ɔhyerɛn sɛ anɔpawia.</para>
  <para style="q2" vid="HAB 3:4">Ɛhan no twa ogya firi ne nsam,</para>
  <para style="q2" vid="HAB 3:4">Ɛhɔ na ne tumi ahinta.<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>Ɔyaredɔm di nʼanim kɔ;</para>
  <para style="q2" vid="HAB 3:5">Na nsaneyadeɛ di nʼakyi pɛɛ.<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>Sɛ ɔgyina a, asase woso.</para>
  <para style="q2" vid="HAB 3:6">Sɛ ɔhwɛ a, ɔma aman woso.</para>
  <para style="q1" vid="HAB 3:6">Tete mmepɔ dwiri,</para>
  <para style="q2" vid="HAB 3:6">na nkokoɔ a ɛfiri tete no ka sram so.</para>
  <para style="q2" vid="HAB 3:6">Nʼakwan nntwa mu da.<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>Mehunuu Kusanfoɔ ntomadan a ateteɛ</para>
  <para style="q2" vid="HAB 3:7">ne Midianfoɔ<note caller="+" style="f"><char style="fr" closed="false">3.7 </char><char style="ft" closed="false">Kusan…Midian—Wɔyɛ Arabia mmusuakuo. Awerɛhoɔ…ahoyera—Ɛberɛ a wɔyii Israelfoɔ firii Misraim nkoasom mu no, nnipa a wɔbemmɛn wɔn no bɔɔ hu. (<char style="xt"><ref loc="EXO 15:14-16">2 Mose 15.14-16</ref>; <ref loc="JOS 2:9-10">Yos 2.9-10</ref></char>).</char></note> atenaeɛ a agyigya.<verse eid="HAB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>
    <char style="nd">Awurade</char>, wo bo fuu nsubɔntene no?</para>
  <para style="q2" vid="HAB 3:8">Wʼabofuo no tiaa nsuwansuwa no?</para>
  <para style="q1" vid="HAB 3:8">Wosɔre tiaa ɛpo,</para>
  <para style="q2" vid="HAB 3:8">ɛberɛ a wo ne wʼapɔnkɔ</para>
  <para style="q2" vid="HAB 3:8">ne nkonimdie nteaseɛnam nam.<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>Woyii wo tadua,</para>
  <para style="q2" vid="HAB 3:9">Wobisaa sɛ wɔmmrɛ wo agyan bebree.</para>
  <para style="q2" vid="HAB 3:9">Wode nsubɔntene paapae asase mu.<verse eid="HAB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10"/>Mmepɔ hunuu wo, na wɔwosoeɛ</para>
  <para style="q2" vid="HAB 3:10">Nsuohwiam bɛsene kɔeɛ.</para>
  <para style="q1" vid="HAB 3:10">Ebunu no woro so,</para>
  <para style="q2" vid="HAB 3:10">na ɛhuru baa soro.<verse eid="HAB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>Owia ne ɔsrane gyinagyinaa sorosoro hɔ,</para>
  <para style="q2" vid="HAB 3:11">ɛberɛ a wohunuu wʼagyan a ɛnenam ewiem no hann no</para>
  <para style="q2" vid="HAB 3:11">ne wo pea a ɛpa nyinam nyinam no.<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>Wʼabufuhyeɛ mu no, wonante twaa asase so</para>
  <para style="q2" vid="HAB 3:12">na wode abufuo tiatiaa aman no so.<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>Wobaeɛ sɛ worebɛgye wo nkurɔfoɔ,</para>
  <para style="q2" vid="HAB 3:13">na woagye deɛ wɔasra no no nkwa.</para>
  <para style="q1" vid="HAB 3:13">Wopɛkyɛɛ atirimuɔdenfoɔ ɔman no kandifoɔ,</para>
  <para style="q2" vid="HAB 3:13">wopaa ne ho ntoma firi ne tiri so kɔsii ne nan ase.<verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>Wode ɔno ankasa pea hweree ne tiri mu,</para>
  <para style="q2" vid="HAB 3:14">ɛberɛ a nʼakofoɔ bɔɔ yerɛdɛ sɛ wɔrebɛhwete yɛn mu.</para>
  <para style="q1" vid="HAB 3:14">Wɔpɛɛ sɛ wɔbɛtɔre</para>
  <para style="q2" vid="HAB 3:14">mmɔborɔfoɔ a wɔakɔ atɛ no ase koraa.<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>Wode wʼapɔnkɔ tiatiaa ɛpo no mu,</para>
  <para style="q2" vid="HAB 3:15">ma nsuo kɛseɛ no huruiɛ.<verse eid="HAB 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>Meteeɛ no, mʼakoma tuuɛ,</para>
  <para style="q2" vid="HAB 3:16">nnyegyeeɛ no maa mʼano poo biribiri;</para>
  <para style="q1" vid="HAB 3:16">aporɔ hyɛnee me nnompe mu,</para>
  <para style="q2" vid="HAB 3:16">na me nan wosoeɛ.</para>
  <para style="q1" vid="HAB 3:16">Nanso mɛto me bo ase atwɛn akɔsi sɛ</para>
  <para style="q2" vid="HAB 3:16">amanehunu da bɛduru ɔman a wɔto hyɛɛ yɛn so no.<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>Ɛwom, borɔdɔma nnua no nguu nhwiren,</para>
  <para style="q2" vid="HAB 3:17">na aba nso nni bobe no so;</para>
  <para style="q1" vid="HAB 3:17">ɛwom, ngo dua no adi hwammɔ</para>
  <para style="q2" vid="HAB 3:17">na mfuo no mmɔ aduane.</para>
  <para style="q1" vid="HAB 3:17">Ɛwom, nnwan biara nni buo no mu,</para>
  <para style="q2" vid="HAB 3:17">na anantwie nso nni ban no mu.<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>Nanso, mʼani bɛgye <char style="nd">Awurade</char> mu;</para>
  <para style="q2" vid="HAB 3:18">me ho bɛsɛpɛ me wɔ Onyankopɔn a</para>
  <para style="q2" vid="HAB 3:18">ɔyɛ mʼagyenkwa no mu.<verse eid="HAB 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>Otumfoɔ <char style="nd">Awurade</char> yɛ mʼahoɔden.</para>
  <para style="q2" vid="HAB 3:19">Ɔma me nan yɛ sɛ ɔforoteɛ deɛ,</para>
  <para style="q2" vid="HAB 3:19">ɔma me nante sorɔnsorɔmmea.</para>
  <para style="q1" vid="HAB 3:19">Wɔmfa mpaeɛ yi mma nnwomtofoɔ ntuanoni no. Na wɔnto no wɔ me nhoma nnwontodeɛ no so.<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
