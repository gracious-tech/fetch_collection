<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Mmɛbusɛm</para>
  <para style="toc1">Mmɛbusɛm</para>
  <para style="toc2">Mmɛbusɛm</para>
  <para style="toc3">Mmb</para>
  <para style="mt1">Mmɛbusɛm</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s1">Botaeɛ Ne Nsɛmpɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>Dawid babarima Salomo, Israelhene, mmɛbusɛm nie:<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>Ne botaeɛ ne sɛ ɛbɛkyerɛ nnipa nyansa ne ahohyɛsoɔ;</para>
  <para style="q2" vid="PRO 1:2">ne sɛ ɛbɛboa ma wɔate nsɛm a emu dɔ ase;<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>sɛ wɔbɛnya ahohyɛsoɔ na wɔabɔ ɔbra pa,</para>
  <para style="q2" vid="PRO 1:3">a ɛbɛma wɔayɛ ade pa, deɛ ɛtene na ɛho nni asɛm;<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>sɛ ɛbɛma deɛ nʼadwene mu nnɔ anya nyansa</para>
  <para style="q2" vid="PRO 1:4">na mmabunu anya nimdeɛ ne adwene.<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>Anyansafoɔ ntie na wɔmfa nka deɛ wɔnim ho,</para>
  <para style="q2" vid="PRO 1:5">na deɛ ɔwɔ nhunumu nya akwankyerɛ a<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>ɛbɛma woate mmɛ ne akasabɛbuo,</para>
  <para style="q2" vid="PRO 1:6">anyansafoɔ nsɛnka ne aborɔme ase.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>
    <char style="nd">Awurade</char> suro yɛ nimdeɛ ahyɛaseɛ,</para>
  <para style="q2" vid="PRO 1:7">na nkwaseafoɔ bu nyansa ne ahohyɛsoɔ animtiaa.<verse eid="PRO 1:7"/></para>
  <para style="ms1">Nyansa Pɛ Ho Afutusɛm</para>
  <para style="s1">Nnaadaa Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Me ba, tie wʼagya akwankyerɛ</para>
  <para style="q2" vid="PRO 1:8">na mpo wo maame nkyerɛkyerɛ.<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>Ɛbɛyɛ wo tiri animuonyam abotire</para>
  <para style="q2" vid="PRO 1:9">ne wo kɔn mu ntweaban.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Me ba, sɛ nnebɔneyɛfoɔ daadaa wo a,</para>
  <para style="q2" vid="PRO 1:10">mma wɔn ho ɛkwan.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Sɛ wɔka sɛ, “Bra ma yɛnkɔ;</para>
  <para style="q2" vid="PRO 1:11">ma yɛnkɔtetɛ na yɛnkum obi,</para>
  <para style="q2" vid="PRO 1:11">ma yɛnkɔtɛ ntwɛn mmɔborɔni bi;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ma yɛmmemmene wɔn anikann sɛ ɛda,</para>
  <para style="q2" vid="PRO 1:12">yɛmmene wɔn sɛ wɔn a wɔkɔ damena mu;<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>yɛbɛnya nneɛma a ɛsom bo ahodoɔ</para>
  <para style="q2" vid="PRO 1:13">na yɛde afodeɛ ahyɛ yɛn afie ma;<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>enti, fa wo ho bɛhyɛ mu,</para>
  <para style="q2" vid="PRO 1:14">na wobɛnya wo kyɛfa wɔ ahonyadeɛ no mu” a,<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>Me ba, wo ne wɔn nnante,</para>
  <para style="q2" vid="PRO 1:15">mfa wo nan nsi wɔn akwan so;<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>Wɔn nan de ntɛmpɛ kɔ bɔne mu,</para>
  <para style="q2" vid="PRO 1:16">na wɔde ahoɔherɛ ka mogya gu.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>Ɛho nni mfasoɔ sɛ obi bɛsum nnomaafidie</para>
  <para style="q2" vid="PRO 1:17">wɔ ɛberɛ a nnomaa nyinaa hwɛ!<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>Saa nnipa yi tetɛ pɛ wɔn ankasa mogya;</para>
  <para style="q2" vid="PRO 1:18">wɔtetɛ wɔn ankasa wɔn ho!<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Saa na wɔn a wɔdi korɔnodeɛ akyi no awieeɛ teɛ;</para>
  <para style="q2" vid="PRO 1:19">ɛma wɔhwere wɔn nkwa!<verse eid="PRO 1:19"/></para>
  <para style="s1">Nyansa A Wɔpo Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>Nyansa team wɔ mmɔntene so,</para>
  <para style="q2" vid="PRO 1:20">ɔma ne nne so wɔ adwaberem,<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>ɔteaam wɔ afasuo no atifi,</para>
  <para style="q2" vid="PRO 1:21">ɔkasa wɔ kuropɔn no apono ano sɛ,<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“Mo adwenemherɛfoɔ, mobɛyɛ adwenemherɛ akɔsi da bɛn?</para>
  <para style="q2" vid="PRO 1:22">Fɛdifoɔ bɛdi fɛ akɔsi da bɛn?</para>
  <para style="q2" vid="PRO 1:22">Nkwaseafoɔ bɛkyiri nimdeɛ akɔsi da bɛn?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Sɛ motiee mʼaninka a,</para>
  <para style="q2" vid="PRO 1:23">anka mekaa mʼakoma mu nsɛm nyinaa kyerɛɛ mo</para>
  <para style="q2" vid="PRO 1:23">maa mo hunuu me nsusuiɛ.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>Nanso, sɛ moyii mo aso ɛberɛ a mefrɛɛ mo</para>
  <para style="q2" vid="PRO 1:24">na amfa obiara ho ɛberɛ a metenee me nsa mu,<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>sɛ mopoo mʼafotuo,</para>
  <para style="q2" vid="PRO 1:25">na moampɛ mʼanimka enti,<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>me nso mɛsere mo wɔ mo amanehunu mu;</para>
  <para style="q2" vid="PRO 1:26">sɛ abɛbrɛsɛ bi bu fa mo so a, medi mo ho fɛw,<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>sɛ abɛbrɛsɛ bi bu fa mo so te sɛ ahum,</para>
  <para style="q2" vid="PRO 1:27">na amanehunu bi bɔ fa mo so sɛ twahoframa,</para>
  <para style="q2" vid="PRO 1:27">na awerɛhoɔ ne ɔhaw mene mo a,<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>“Afei mobɛfrɛ me, nanso meremmua mo;</para>
  <para style="q2" vid="PRO 1:28">mobɛhwehwɛ me, nanso morenhunu me.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>Esiane sɛ wɔkyirii nimdeɛ</para>
  <para style="q2" vid="PRO 1:29">na wɔampɛ sɛ wobɛsuro <char style="nd">Awurade</char>.<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>Esiane sɛ w ɔpoo mʼafotuo,</para>
  <para style="q1" vid="PRO 1:30">na wɔbuu me ntenesoɔ animtiaa enti,<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>wɔbɛdi wɔn akwan so aba</para>
  <para style="q2" vid="PRO 1:31">na wɔn nhyehyɛeɛ mu aduane bɛmee wɔn.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Na ntetekwaafoɔ asoɔden bɛkum wɔn,</para>
  <para style="q2" vid="PRO 1:32">na nkwaseafoɔ tirimudɛ bɛsɛe wɔn;<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>Nanso, obiara a ɔbɛtie me no, ɔbɛtena ase asomdwoeɛ mu</para>
  <para style="q1" vid="PRO 1:33">na ne ho bɛtɔ no a ɔrensuro ɔhaw biara.”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Nyansa Ho Mfasoɔ Wɔ Abrabɔ Mu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Me ba, sɛ wotie me nsɛm,</para>
  <para style="q2" vid="PRO 2:1">na woma me nkyerɛkyerɛ tena wo mu a,<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>sɛ wowɛn wʼaso ma nyansa</para>
  <para style="q2" vid="PRO 2:2">na wode wʼakoma ma nteaseɛ,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>na woma wo nne so frɛ nhunumu</para>
  <para style="q2" vid="PRO 2:3">na wosu frɛ nteaseɛ,<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>na sɛ wohwehwɛ no te sɛ deɛ wohwehwɛ dwetɛ</para>
  <para style="q2" vid="PRO 2:4">na wo hwehwɛ no sɛdeɛ worepɛ ademudeɛ a ahinta a,<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>ɛno na wobɛte <char style="nd">Awurade</char> suro ase</para>
  <para style="q2" vid="PRO 2:5">na woahunu Onyankopɔn ho nimdeɛ.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>
    <char style="nd">Awurade</char> ma nimdeɛ,</para>
  <para style="q2" vid="PRO 2:6">na nʼanom na nyansa ne nteaseɛ firi ba.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>Ɔkora nkonimdie ma wɔn a wɔteneɛ,</para>
  <para style="q2" vid="PRO 2:7">ɔyɛ kyɛm ma wɔn a wɔn akwan yɛ pɛ,<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>ɔwɛn deɛ ɔtene akwan,</para>
  <para style="q2" vid="PRO 2:8">na ɔbɔ wɔn a wɔdi no nokorɛ no akwan ho ban.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Ɛno na wobɛte deɛ ɛyɛ ne deɛ ɛyɛ pɛ</para>
  <para style="q2" vid="PRO 2:9">ne deɛ ɛfata, ɛkwan biara a ɛyɛ ase.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Afei nyansa bɛwura wʼakoma mu,</para>
  <para style="q2" vid="PRO 2:10">na nimdeɛ ayɛ ahomeka ama wo kra.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>Adwene bɛbɔ wo ho ban</para>
  <para style="q2" vid="PRO 2:11">na nteaseɛ ahwɛ wo so.<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>Nyansa bɛyi wo afiri amumuyɛfoɔ akwan mu,</para>
  <para style="q2" vid="PRO 2:12">ɛbɛyi wo afiri nnipa a wɔn nsɛm yɛ basabasa nsam,<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>na wɔmane firi akwan pa so</para>
  <para style="q2" vid="PRO 2:13">kɔnante esum akwan so,<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>wɔn a wɔn ani gye bɔneyɛ ho,</para>
  <para style="q2" vid="PRO 2:14">na wɔdi ahurisie wɔ bɔne mu basabasayɛ ho,<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>wɔn a wɔn akwan yɛ kɔntɔnkye</para>
  <para style="q2" vid="PRO 2:15">na wɔyɛ abonsamfoɔ wɔ wɔn akwan mu.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Nimdeɛ bɛgye wo afiri ɔbaa waresɛefoɔ no nsam,</para>
  <para style="q2" vid="PRO 2:16">afiri ɔbaa warefoɔ sansani a ɔka nnaadaasɛm ho,<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>deɛ wagyaa ne mmabaawaberɛ mu kunu</para>
  <para style="q2" vid="PRO 2:17">na wapo apam a ɔyɛɛ wɔ Onyankopɔn anim no.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>Ne fie yɛ ɛkwan a ɛkɔ owuo mu</para>
  <para style="q2" vid="PRO 2:18">na nʼakwan kɔ awufoɔ honhom nkyɛn.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Obiara a ɔkɔ ne nkyɛn no nsane mma</para>
  <para style="q2" vid="PRO 2:19">anaasɛ ɔrensi nkwa akwan so.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>Enti wobɛdi nnipa pa anammɔn akyi</para>
  <para style="q2" vid="PRO 2:20">na woanante ateneneefoɔ akwan so.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Ɛfiri sɛ wɔn a wɔtene bɛtena asase no so,</para>
  <para style="q2" vid="PRO 2:21">na wɔn a asɛm nni wɔn ho no na wɔbɛka hɔ;<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>na wɔbɛtwa amumuyɛfoɔ afiri asase no so,</para>
  <para style="q1" vid="PRO 2:22">na wɔatɔre atorofoɔ ase.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Nyansa Ho Mfasoɔ Nkekaho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Me ba, mma wo werɛ mfiri me nkyerɛkyerɛ,</para>
  <para style="q2" vid="PRO 3:1">kora me mmara yi wɔ wʼakoma mu,<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>na ɛbɛma wo nkwa aware, mfeɛ bebree</para>
  <para style="q2" vid="PRO 3:2">na ɛde yiedie abrɛ wo.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Mma adɔeɛ ne nokorɛ mfiri wo nkyɛn</para>
  <para style="q2" vid="PRO 3:3">fa yane wo kɔn mu</para>
  <para style="q2" vid="PRO 3:3">twerɛ gu wʼakoma ɛpono so.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Na wobɛnya adom ne din pa</para>
  <para style="q2" vid="PRO 3:4">wɔ Onyankopɔn ne nnipa anim.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>Fa wʼakoma nyinaa to <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PRO 3:5">na mmfa wo ho nto wʼankasa nteaseɛ so;<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>hunu no wʼakwan nyinaa mu,</para>
  <para style="q2" vid="PRO 3:6">na ɔbɛtene wʼakwan.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>Nnye wo ho nni sɛ woyɛ onyansafoɔ</para>
  <para style="q2" vid="PRO 3:7">suro <char style="nd">Awurade</char> na kyiri bɔne.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Ɛde ahoɔden bɛbrɛ wo onipadua</para>
  <para style="q2" vid="PRO 3:8">na ayɛ aduane ama wo nnompe.<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>Fa wʼahonya hyɛ <char style="nd">Awurade</char> animuonyam,</para>
  <para style="q2" vid="PRO 3:9">ne wo nnɔbaeɛ a ɛdi ɛkan nyinaa;<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>na ɛno na ɛbɛma wo pata ayɛ ma abu so,</para>
  <para style="q2" vid="PRO 3:10">na nsã foforɔ abu afa wʼankorɛ so<verse eid="PRO 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>Me ba, sɛ <char style="nd">Awurade</char> tene wo so a, tie no yie,</para>
  <para style="q2" vid="PRO 3:11">na sɛ ɔka wʼanim a, mpa aba,<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>Ɛfiri sɛ, obiara a <char style="nd">Awurade</char> pɛ nʼasɛm no, ɔtwe nʼaso,</para>
  <para style="q2" vid="PRO 3:12">sɛdeɛ agya tene ɔba a ɔdɔ no so no.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>Nhyira nka onipa a ɔhunu nyansa,</para>
  <para style="q2" vid="PRO 3:13">onipa a ɔnya nteaseɛ,<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>ɛfiri sɛ, nimdeɛ ho mfasoɔ sene dwetɛ,</para>
  <para style="q2" vid="PRO 3:14">na deɛ ɛfiri mu ba sene sikakɔkɔɔ.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Ne boɔ yɛ dene sene bota;</para>
  <para style="q2" vid="PRO 3:15">na worentumi mfa wʼapɛdeɛ biara ntoto ho.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Nkwa tenten wɔ ne nsa nifa mu;</para>
  <para style="q2" vid="PRO 3:16">ahonyadeɛ ne animuonyam wɔ ne nsa benkum mu.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Nʼakwan yɛ ahomeka,</para>
  <para style="q2" vid="PRO 3:17">na nʼasa nyinaa yɛ asomdwoeɛ.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>Ɔyɛ nkwa dua ma wɔn a wɔsɔ ne mu;</para>
  <para style="q2" vid="PRO 3:18">wɔn a wɔkura ne mu no bɛnya nhyira.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>Nyansa mu na <char style="nd">Awurade</char> yɛɛ asase fapem,</para>
  <para style="q2" vid="PRO 3:19">na nteaseɛ mu na ɔde ɔsoro timii hɔ.<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>Ɛfiri ne nimdeɛ mu na ɔkyekyɛɛ ebunu mu,</para>
  <para style="q2" vid="PRO 3:20">na omununkum nso tɔɔ bosuo.<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>Me ba, fa atemmuo pa ne nhunumu sie,</para>
  <para style="q2" vid="PRO 3:21">na mma ɛmfiri wʼani so;<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>ɛbɛyɛ nkwa ama wo,</para>
  <para style="q2" vid="PRO 3:22">ahyehyɛdeɛ a ɛma wɔ kɔn nya animuonyam.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Afei wo kwan so bɛyɛ wo dwoodwoo,</para>
  <para style="q2" vid="PRO 3:23">na wo nan rensunti;<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>sɛ woda a worensuro;</para>
  <para style="q2" vid="PRO 3:24">sɛ woda a wʼani bɛkum.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Nsuro mpofirim amanehunu</para>
  <para style="q2" vid="PRO 3:25">anaa ɔsɛeɛ a ɛba amumuyɛfoɔ so,<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>Ɛfiri sɛ, <char style="nd">Awurade</char> bɛyɛ wʼawerɛhyɛm</para>
  <para style="q2" vid="PRO 3:26">na ɔbɛkora wo nan afiri afidie mu.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>Mfa ade pa nkame wɔn a wɔfata,</para>
  <para style="q2" vid="PRO 3:27">ɛberɛ a tumi wɔ wo nsam.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Nka nkyerɛ wo yɔnko sɛ:</para>
  <para style="q2" vid="PRO 3:28">“Kɔ na bra; mede bɛma wo ɔkyena”</para>
  <para style="q2" vid="PRO 3:28">wɔ ɛberɛ a wowɔ no saa ɛberɛ no.<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>Mpam ɔhaw mma wo yɔnko</para>
  <para style="q2" vid="PRO 3:29">ɛberɛ a ɔne wo te yie.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Mfa ɛso nto obi so kwa</para>
  <para style="q2" vid="PRO 3:30">ɛberɛ a ɔnyɛɛ wo bɔne biara.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>Mma wʼani mmere basabasayɛfoɔ,</para>
  <para style="q2" vid="PRO 3:31">na mfa nʼakwan no mu biara,<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>ɛfiri sɛ <char style="nd">Awurade</char> kyiri basabasayɛfoɔ</para>
  <para style="q2" vid="PRO 3:32">na ɔde ne werɛ hyɛ ɔteneneeni mu.<verse eid="PRO 3:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>
    <char style="nd">Awurade</char> nnome wɔ omumuyɛfoɔ efie so,</para>
  <para style="q2" vid="PRO 3:33">na ɔhyira ɔteneneeni fie.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>Ɔdi fɛdifoɔ a wɔyɛ ahantan ho fɛ</para>
  <para style="q2" vid="PRO 3:34">na ɔdom ahobrɛasefoɔ.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>Anyansafoɔ bɛnya animuonyam adi,</para>
  <para style="q1" vid="PRO 3:35">nanso nkwaseafoɔ deɛ, ɔma wɔn anim gu ase.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Nyansa Boro Biribiara So</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Me mma, montie me, montie agya nkyerɛkyerɛ;</para>
  <para style="q2" vid="PRO 4:1">monyɛ aso na moanya nteaseɛ.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Mema mo adenim a ɛkɔ anim,</para>
  <para style="q2" vid="PRO 4:2">enti monnyaa me nkyerɛkyerɛ mu.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Meyɛ ɔbabanin wɔ mʼagya fie,</para>
  <para style="q2" vid="PRO 4:3">meda so yɛ abadomaa na me maame di me bakorɔ no,<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>ɔkyerɛkyerɛɛ me sɛ,</para>
  <para style="q2" vid="PRO 4:4">“Ma me nsɛm nni wʼakoma mu dɛm</para>
  <para style="q2" vid="PRO 4:4">di me nkyerɛkyerɛ so na wobɛnya nkwa.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Nya nyansa, nya nteaseɛ;</para>
  <para style="q2" vid="PRO 4:5">mma wo werɛ mfiri me nsɛm anaa ntwe wo ho mfiri ho.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Nnya nyansa hɔ, na ɛbɛbɔ wo ho ban;</para>
  <para style="q2" vid="PRO 4:6">dɔ no, na ɛbɛhwɛ wo so.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Nyansa boro biribiara so; enti hwehwɛ nyansa.</para>
  <para style="q2" vid="PRO 4:7">Ɛwom sɛ ne boɔ te sɛ wʼahodeɛ nyinaa deɛ nanso nya nteaseɛ.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>Di no nni na ɛbɛpagya wo;</para>
  <para style="q2" vid="PRO 4:8">yɛ no atuu, na ɛbɛhyɛ wo animuonyam.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Ɔde nkonimdie nhwiren hankra bɛgu wo tiri so</para>
  <para style="q2" vid="PRO 4:9">na wama wo ahenkyɛ a ɛyɛ fɛ.”<verse eid="PRO 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Me ba, tie na fa deɛ meka no,</para>
  <para style="q2" vid="PRO 4:10">na wo nkwanna bɛyɛ bebree.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Mɛkyerɛ wo nyansakwan</para>
  <para style="q2" vid="PRO 4:11">na mede wo afa akwan a ɛtene so.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Sɛ wonante a, wʼanammɔntuo bɛkɔ yɛɛ</para>
  <para style="q2" vid="PRO 4:12">na sɛ wotu mmirika a, worensunti.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>Di nkyerɛkyerɛ so; na nnyaa mu</para>
  <para style="q2" vid="PRO 4:13">bɔ ho ban yie, ɛfiri sɛ ɛyɛ wo nkwa.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>Ntu wo nan nsi amumuyɛfoɔ kwan so</para>
  <para style="q2" vid="PRO 4:14">na nnante abɔnefoɔ kwan so.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Kwati no, ntu kwan mfa so;</para>
  <para style="q2" vid="PRO 4:15">dane firi so na kɔ wo baabi.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Ɛfiri sɛ wɔntumi nna kɔsi sɛ wɔbɛyɛ bɔne;</para>
  <para style="q2" vid="PRO 4:16">na wɔntɔ nko kɔsi sɛ wɔbɛma obi ahwe ase.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Amumuyɛsɛm yɛ wɔn aduane,</para>
  <para style="q2" vid="PRO 4:17">na basabasayɛ yɛ wɔn nsa.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Teneneefoɔ kwan te sɛ adekyeɛ hann a ɛdi ɛkan,</para>
  <para style="q2" vid="PRO 4:18">ɛkɔ so hyerɛn yie kɔduru awia ketee.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>Nanso, amumuyɛfoɔ kwan te sɛ esum kabii;</para>
  <para style="q2" vid="PRO 4:19">wɔnnim deɛ ɛma wɔsunti.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Me ba, yɛ aso ma deɛ meka;</para>
  <para style="q2" vid="PRO 4:20">tie me nsɛm no yie.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>Mma ɛmfiri wʼani so,</para>
  <para style="q2" vid="PRO 4:21">fa sie wʼakoma mu;<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>ɛfiri sɛ, ɛyɛ nkwa ma wɔn a wɔhunu</para>
  <para style="q2" vid="PRO 4:22">ne akwahosan ma onipadua no nyinaa.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>Ne nyinaa akyi, bɔ wʼakoma ho ban,</para>
  <para style="q2" vid="PRO 4:23">ɛfiri sɛ, ɛno ne wo nkwa asutire.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Mma akontonkyesɛm mfiri wʼano;</para>
  <para style="q2" vid="PRO 4:24">mma nkontomposɛm mmɛn wʼano koraa.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Hwɛ wʼanim tee,</para>
  <para style="q2" vid="PRO 4:25">na ma wʼani nkɔ deɛ ɛwɔ wʼanim no so.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>Bɔ ɛkwan tamaa ma wo nan</para>
  <para style="q2" vid="PRO 4:26">na fa akwan a atim so.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>Mmane mfa nifa anaa benkum;</para>
  <para style="q2" vid="PRO 4:27">twe wo nan firi bɔne ho.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Adwamammɔ Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Me ba, yɛ aso ma me nyansa;</para>
  <para style="q2" vid="PRO 5:1">tie me nhunumu nsɛm no yie,<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>sɛdeɛ ɛbɛma woahwɛ yie,</para>
  <para style="q2" vid="PRO 5:2">na wʼano akora nimdeɛ.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Ɛfiri sɛ ɔbaa dwamanfoɔ ano sosɔ ɛwoɔ,</para>
  <para style="q2" vid="PRO 5:3">na ne kasa kɔ yɛɛ sene ngo;<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>nanso, awieeɛ no ɛyɛ nwono sene bɔnwoma,</para>
  <para style="q2" vid="PRO 5:4">ɛyɛ nam sɛ akofena anofanu.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Ne nan kɔ owuo mu;</para>
  <para style="q2" vid="PRO 5:5">nʼanammɔntutuo kɔ ɛda mu tee.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Ɔnnwene ɛkwan a ɛkɔ nkwa mu ho;</para>
  <para style="q2" vid="PRO 5:6">nʼakwan yɛ kɔntɔnkye, nanso ɔnnim.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Enti, afei, me mma, montie me;</para>
  <para style="q2" vid="PRO 5:7">Monntwe mo ho mfiri deɛ meka ho.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Ɛkwan a ɛmmɛn noɔ no na momfa so</para>
  <para style="q2" vid="PRO 5:8">mommmɛn ne fie ɛpono ano,<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>anyɛ saa a, mode mo ahoɔden bɛma afoforɔ</para>
  <para style="q2" vid="PRO 5:9">na mode mo mfeɛ ama otirimuɔdenfoɔ,<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>anyɛ saa a, ahɔhoɔ bɛfom mo ahonyadeɛ</para>
  <para style="q2" vid="PRO 5:10">na mobrɛ de ahonya akɔ afoforɔ fie.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>Mo nkwanna akyi, mobɛsi apinie</para>
  <para style="q2" vid="PRO 5:11">ɛberɛ a mo honam ne mo onipadua asa no.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>Na moaka sɛ, “Na mekyiri ahohyɛsoɔ!</para>
  <para style="q2" vid="PRO 5:12">Mʼakoma ampɛ ntenesoɔ!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>Manyɛ ɔsetie amma mʼakyerɛkyerɛfoɔ</para>
  <para style="q2" vid="PRO 5:13">na mantie mʼakwankyerɛfoɔ asɛm.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Maduru ɔsɛeɛ ntɛntɛnoa</para>
  <para style="q2" vid="PRO 5:14">wɔ asafo no nyinaa mu.”<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Nom nsuo firi wʼankasa ankorɛ mu,</para>
  <para style="q2" vid="PRO 5:15">nsuo a ɛtene firi wʼankasa abura mu.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>Ɛsɛ sɛ wo nsutire yiri fa mmɔntene so</para>
  <para style="q2" vid="PRO 5:16">na wo nsuwa kokɔ ɔman adwaberem anaa?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Ma ɛnyɛ wo nko ara dea,</para>
  <para style="q2" vid="PRO 5:17">a wone ahɔhoɔ nnkyɛ da.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Nhyira nka wʼasubura</para>
  <para style="q2" vid="PRO 5:18">na wʼani nka wʼababunuberɛ mu yere ho.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Ɔte sɛ ɔtwe bereɛ dɔfoɔ, ɔwansane animuonyamfoɔ.</para>
  <para style="q2" vid="PRO 5:19">Ma ne nufoɔ nsɔ wʼani daa</para>
  <para style="q2" vid="PRO 5:19">na ne dɔ nkyekyere wo.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Me ba, adɛn enti na woma ɔbaa dwamanfoɔ kyekyere wo?</para>
  <para style="q2" vid="PRO 5:20">Adɛn enti na woda ɔbarima foforɔ bi yere kokom?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>
    <char style="nd">Awurade</char> hunu onipa akwan nyinaa,</para>
  <para style="q2" vid="PRO 5:21">na ɔhwehwɛ ne nyinaa mu.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>Omumuyɛfoɔ nnebɔne sum no afidie;</para>
  <para style="q2" vid="PRO 5:22">na ne bɔne nhoma kyekyere no papee.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Ɔbɛwu ɛsiane ahohyɛsoɔ a ɔnni enti,</para>
  <para style="q2" vid="PRO 5:23">na wayera ɛsiane nʼagyegyentwisɛm enti.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Agyimisɛm Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Me ba, sɛ woadi akagyinamu ama ɔyɔnko bi,</para>
  <para style="q2" vid="PRO 6:1">sɛ wode wo biribi asi awowa ama obi,<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>sɛ deɛ wokaeɛ ayi ka ama wo</para>
  <para style="q2" vid="PRO 6:2">na sɛ wʼano asɛm afidie ayi wo a,<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>ɛnneɛ yɛ yei, me ba, na fa tete wo ho,</para>
  <para style="q2" vid="PRO 6:3">sɛ ɔyɔnko nsa aka woɔ no nti:</para>
  <para style="q1" vid="PRO 6:3">fa ahobrɛaseɛ kɔ nʼanim;</para>
  <para style="q2" vid="PRO 6:3">na kɔ so pa wo yɔnko no kyɛw!<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Mma wʼani nkum</para>
  <para style="q2" vid="PRO 6:4">na nntɔ nko.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>Gye wo ho, sɛdeɛ ɔforoteɛ dwane firi ɔbɔmmɔfoɔ nsam</para>
  <para style="q2" vid="PRO 6:5">anaa sɛdeɛ anomaa dwane firi fidisumfoɔ afidie mu.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>Ɔkwadwofoɔ, kɔ atɛtea nkyɛn;</para>
  <para style="q2" vid="PRO 6:6">hwɛ nʼakwan, na hunu nyansa!<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Ɔnni ɔsahene,</para>
  <para style="q2" vid="PRO 6:7">ɔnni ɔhwɛfoɔ anaa sodifoɔ bi,<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>nanso, ɔde aduane sie wɔ ahuhuro ɛberɛ mu</para>
  <para style="q2" vid="PRO 6:8">ɔboaboa nnuane ano wɔ twaberɛ.<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>Wo, ɔkwadwofoɔ, wobɛda akɔsi da bɛn?</para>
  <para style="q2" vid="PRO 6:9">Wɔbɛnyane ɛberɛ bɛn?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>Nna kakra, nkotɔ kakra,</para>
  <para style="q2" vid="PRO 6:10">nsa a woabobɔ de rehome kakra,<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>ɛbɛma ohia aba wo so sɛ ɔkwanmukafoɔ</para>
  <para style="q2" vid="PRO 6:11">na ahokyere ato ahyɛ wo so sɛ deɛ ɔkura tuo.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Onipa teta ne ohuhuni a</para>
  <para style="q2" vid="PRO 6:12">ɔde atorɔ kyini,<verse eid="PRO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13"/>deɛ ɔbu nʼani,</para>
  <para style="q2" vid="PRO 6:13">na ɔde ne nan yɛ nsɛnkyerɛnneɛ</para>
  <para style="q2" vid="PRO 6:13">na ɔde ne nsateaa kyerɛkyerɛ adeɛ,<verse eid="PRO 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14"/>deɛ ɔde nʼakoma mu nnaadaa bɔ ɛpɔ bɔne,</para>
  <para style="q2" vid="PRO 6:14">na ɔde mpaapaemu ba ɛberɛ biara.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Ɛno enti amanehunu bɛba ne so prɛko pɛ;</para>
  <para style="q2" vid="PRO 6:15">wɔbɛsɛe no mpofirim, a wɔrenya ano aduro.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16"/>Nneɛma nsia na <char style="nd">Awurade</char> mpɛ,</para>
  <para style="li2" vid="PRO 6:16">nneɛma nson na ɛyɛ nʼakyiwadeɛ:<verse eid="PRO 6:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17"/>ani a ɛtra ntɔn,</para>
  <para style="li3" vid="PRO 6:17">atorɔ tɛkrɛma,</para>
  <para style="li3" vid="PRO 6:17">nsa a ɛka mogya a ɛdi bem guo,<verse eid="PRO 6:17"/></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18"/>akoma a ɛdwene amumuyɛ ho,</para>
  <para style="li3" vid="PRO 6:18">nan a ɛtutu mmirika kɔyɛ bɔne,<verse eid="PRO 6:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19"/>Ɔdansekurumni a ɔdi atorɔ</para>
  <para style="li3" vid="PRO 6:19">ne onipa a ɔde mpaapaemu ba anuanom mu.<verse eid="PRO 6:19"/></para>
  <para style="s1">Awaresɛeɛ Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>Me ba, tie wʼagya ahyɛdeɛ</para>
  <para style="q2" vid="PRO 6:20">na nnyaa wo maame nkyerɛkyerɛ mu.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>Fa kyekyere wʼakoma ho daa;</para>
  <para style="q2" vid="PRO 6:21">na fa kyekyere wɔ kɔn mu.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Wonante a, ɛbɛkyerɛ wo ɛkwan;</para>
  <para style="q2" vid="PRO 6:22">sɛ woda a, ɛbɛwɛn wo;</para>
  <para style="q2" vid="PRO 6:22">sɛ wonyane a, ɛbɛkasa akyerɛ wo.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Na saa ahyɛdeɛ yi yɛ kanea;</para>
  <para style="q2" vid="PRO 6:23">saa nkyerɛkyerɛ yi yɛ hann,</para>
  <para style="q1" vid="PRO 6:23">na ahohyɛsoɔ ntenesoɔ yi</para>
  <para style="q2" vid="PRO 6:23">yɛ nkwa kwan,<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>ɛtwe wo firi ɔbaa a ɔnni suban pa no ho,</para>
  <para style="q2" vid="PRO 6:24">firi ɔbaawarefoɔ sansani tɛkrɛmadɛ ho.<verse eid="PRO 6:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>Mma wo kɔn nnɔ nʼahoɔfɛ</para>
  <para style="q2" vid="PRO 6:25">mma nʼani akyideda no ntwetwe wo,<verse eid="PRO 6:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>ɛfiri sɛ, odwamanfoɔ de animguaseɛ bɛbrɛ wo,</para>
  <para style="q2" vid="PRO 6:26">na obi yere gyegye wo kɔ owuo mu.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Obi bɛtumi asɔ ogya agu ne srɛ so a</para>
  <para style="q2" vid="PRO 6:27">ɛnhye nʼatadeɛ anaa?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Obi bɛtumi anante gyasramma so a</para>
  <para style="q2" vid="PRO 6:28">mpumpunnya mmobɔ ne nan ho anaa?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Saa na ɔbarima a ɔne ɔbarima foforɔ yere da no teɛ</para>
  <para style="q2" vid="PRO 6:29">obiara a ɔde ne nsa bɛka noɔ no remfa ne ho nni da.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Nnipa mmu ɔkorɔmfoɔ a wakɔwia adeɛ animtiaa</para>
  <para style="q2" vid="PRO 6:30">sɛ ɛkɔm de no na ɔde rekɔdwodwo ano enti.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>Mmom sɛ wɔkyere no a, ɛsɛ sɛ ɔtua ka mmɔho nson;</para>
  <para style="q2" vid="PRO 6:31">sɛ ɛhia sɛ wɔtɔn ne fie agyapadeɛ nyinaa mpo a, ɛsɛ sɛ wɔtɔn.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>Ɔbarima a ɔsɛe awadeɛ no nni adwene;</para>
  <para style="q2" vid="PRO 6:32">obiara a ɔyɛ saa no sɛe ne ho.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>Ɔboro ne animguaseɛ na ɔbɛnya,</para>
  <para style="q2" vid="PRO 6:33">na nʼahohora rempepa da.<verse eid="PRO 6:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>Ninkunutweɛ hwanyane okunu abufuo</para>
  <para style="q2" vid="PRO 6:34">na sɛ ɔtɔ were a, ahummɔborɔ biara nni mu.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Ɔrennye mpata biara;</para>
  <para style="q2" vid="PRO 6:35">na ɔbɛpo adanmudeɛ, sɛ ɛso sɛ ɛdeɛn mpo a.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">Ɔbaawaresɛefoɔ Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Me ba, fa me nsɛm sie</para>
  <para style="q2" vid="PRO 7:1">na kora mʼahyɛdeɛ wɔ wo mu.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Di mʼahyɛdeɛ so na wobɛnya nkwa;</para>
  <para style="q2" vid="PRO 7:2">bɔ me nkyerɛkyerɛ ho ban sɛ deɛ wodɔ noɔ.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>Kyekyere bɔ wo nsateaa ho;</para>
  <para style="q2" vid="PRO 7:3">twerɛ no yie gu wʼakoma ɛpono so.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Ka kyerɛ nyansa sɛ, “Wo yɛ me nuabaa,”</para>
  <para style="q2" vid="PRO 7:4">na frɛ nteaseɛ wo busuani;<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>Wɔbɛtwe wo afiri ɔbaawaresɛefoɔ ho,</para>
  <para style="q2" vid="PRO 7:5">afiri ɔbaawarefoɔ sansani nsɛmmɔdɛ ho.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Me fie mpomma ano</para>
  <para style="q2" vid="PRO 7:6">mede mʼani faa ntokua mu.<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>Mehunuu wɔ ntetekwaafoɔ mu,</para>
  <para style="q2" vid="PRO 7:7">mehyɛɛ mmeranteɛ no mu baako nso,</para>
  <para style="q2" vid="PRO 7:7">ɔbabunu a ɔnni adwene.<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>Na ɔnam borɔno a ɛbɛn ɔbaa no fie so</para>
  <para style="q2" vid="PRO 7:8">a nʼani kyerɛ ɔbaa no fie<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>ɛberɛ a ɔnwunu redwoɔ,</para>
  <para style="q2" vid="PRO 7:9">na animu rebiribiri no.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Afei ɔbaa bi firi bɛhyiaa no a</para>
  <para style="q2" vid="PRO 7:10">wasiesie ne ho sɛ odwamanfoɔ a nnaadaa wɔ nʼakomam.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>(Ɔyɛ hyirenn na hwee mfa ne ho,</para>
  <para style="q2" vid="PRO 7:11">ɔntena efie koraa;<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>ɛnnɛ wɔhunu no mmɔntene so, ɔkyena na ɔte adwaberem,</para>
  <para style="q2" vid="PRO 7:12">ɔtetɛ wɔ mmantwea mmantwea.)<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>Ɔsɔɔ ne mu fee nʼano</para>
  <para style="q2" vid="PRO 7:13">wamfɛre, na ɔkaa sɛ,<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“Mewɔ ayɔnkofa ayɛyɛdeɛ wɔ efie;</para>
  <para style="q2" vid="PRO 7:14">ɛnnɛ madi me bɔhyɛ so.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Enti mebaeɛ sɛ merebɛhyia wo;</para>
  <para style="q2" vid="PRO 7:15">mehwehwɛɛ wo na mahunu wo!<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Mato me mpa</para>
  <para style="q2" vid="PRO 7:16">mede nwera a wɔahyɛ no aduro a ɛfiri Misraim.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Mede nnuhwam apete me mpa so:</para>
  <para style="q2" vid="PRO 7:17">kurobo, pɛperɛ ne sinamon.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Bra, ma yɛmfa ɔdɔ mmɔ ɔdɔ mu nkɔsi anɔpa;<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Me kunu nni efie;</para>
  <para style="q2" vid="PRO 7:19">watu kwan na ɔbɛkyɛre.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Ɔde sika a ɛdɔɔso hyɛɛ ne sikabɔtɔ ma</para>
  <para style="q2" vid="PRO 7:20">na ɔremma kɔsi ɔsrane no korokumatwa berɛ mu.”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Ɔde akorɔkorɔ bɔɔ no asɔn;</para>
  <para style="q2" vid="PRO 7:21">ɔde nnaadaa nyaa no ne no daeɛ.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>Ɔdii nʼakyi prɛko pɛ</para>
  <para style="q2" vid="PRO 7:22">te sɛ nantwie a ɔrekɔ akumiiɛ,</para>
  <para style="q1" vid="PRO 7:22">anaa ɔwansane a ɔde ne tiri rekɔhyɛ hankrafidie mu<verse eid="PRO 7:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23"/>kɔsi sɛ bɛmma bɛhwire ne brɛboɔ mu,</para>
  <para style="q1" vid="PRO 7:23">te sɛ anomaa a ɔrekɔtɔ anomaa afidie mu</para>
  <para style="q2" vid="PRO 7:23">na ɔnnim sɛ ɔbɛhwere ne nkwa.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>Na afei, me mma, montie me;</para>
  <para style="q2" vid="PRO 7:24">monyɛ aso mma deɛ meka.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Mommma mo akoma mpatere nkɔ ne so</para>
  <para style="q2" vid="PRO 7:25">na mommane mfa nʼakwan so.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Bebree na wɔnam ne so ahwehwe ase;</para>
  <para style="q2" vid="PRO 7:26">wɔn a wakum wɔn dɔɔso pa ara.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>Ne fie yɛ ɛda kwantempɔn a</para>
  <para style="q2" vid="PRO 7:27">ɛkɔ owuo mpia mu.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Nyansa Frɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Tie: Nyansa refrɛ.</para>
  <para style="q2" vid="PRO 8:1">Nteaseɛ ma ne nne so.<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Ɛkwan no so, sorɔnsorɔmmea hɔ,</para>
  <para style="q2" vid="PRO 8:2">nkwantanan no so, ɛhɔ na ɛgyina,<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>apono a ɛkɔ kuropɔn no mu ho,</para>
  <para style="q2" vid="PRO 8:3">ɛteam wɔ aboboano hɔ sɛ,<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>“Ao, mo mmarimma na meteam mefrɛ;</para>
  <para style="q2" vid="PRO 8:4">meteam frɛ adasamma nyinaa.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>Mo a moyɛ ntetekwaa, mo mma mo ani nte;</para>
  <para style="q2" vid="PRO 8:5">mo a moyɛ nkwaseafoɔ, monnya nteaseɛ.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Montie, na mewɔ nsɛm pa bi ka kyerɛ mo;</para>
  <para style="q2" vid="PRO 8:6">mebue mʼano ka deɛ ɛyɛ.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Mʼano ka deɛ ɛyɛ nokorɛ,</para>
  <para style="q2" vid="PRO 8:7">ɛfiri sɛ mʼanofafa kyiri amumuyɛsɛm.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Mʼano mu nsɛm nyinaa yɛ pɛ;</para>
  <para style="q2" vid="PRO 8:8">ebiara nni mu a ɛyɛ nkontompo anaa nnaadaasɛm.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Ne nyinaa mu da hɔ ma deɛ ɔwɔ nhunumu;</para>
  <para style="q2" vid="PRO 8:9">ɛho nni asɛm ma wɔn a wɔwɔ nimdeɛ.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Mompo dwetɛ na momfa mʼakwankyerɛ,</para>
  <para style="q2" vid="PRO 8:10">momfa nimdeɛ na mompo sikakɔkɔɔ amapa.<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>Ɛfiri sɛ nimdeɛ som bo sene mmota,</para>
  <para style="q2" vid="PRO 8:11">na wɔrentumi mfa deɛ wopɛ biara ntoto ho.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>“Me, nyansa, mene aniteɛ na ɛteɛ;</para>
  <para style="q2" vid="PRO 8:12">nimdeɛ ne nhunumu wɔ me.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>Sɛ wɔsuro <char style="nd">Awurade</char> ɛne sɛ wɔkyiri bɔne;</para>
  <para style="q2" vid="PRO 8:13">mekyiri ahantan ne ahomasoɔ,</para>
  <para style="q2" vid="PRO 8:13">ɔbra bɔne ne nnaadaasɛm.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>Afotuo ne atemmuo pa wɔ me;</para>
  <para style="q2" vid="PRO 8:14">mewɔ nteaseɛ ne tumi.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>Me so na ahemfo nam di adeɛ</para>
  <para style="q2" vid="PRO 8:15">na sodifoɔ nam me so hyehyɛ mmara a ɛyɛ pɛ;<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>Mmapɔmma de me bu ɔman</para>
  <para style="q2" vid="PRO 8:16">ne atitire nyinaa a wɔdi asase so ɔhene.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Medɔ wɔn a wɔdɔ me,</para>
  <para style="q2" vid="PRO 8:17">na wɔn a wɔhwehwɛ me no hunu me.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>Ahonyadeɛ ne animuonyam wɔ me nkyɛn,</para>
  <para style="q2" vid="PRO 8:18">ahodeɛ a ɛkyɛre ne yiedie nso saa ara.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Mʼaba yɛ sene sikakɔkɔɔ amapa;</para>
  <para style="q2" vid="PRO 8:19">deɛ ɛfiri me mu boro dwetɛ a wɔasɔne so so.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Tenenee akwan so na menam</para>
  <para style="q2" vid="PRO 8:20">atɛntenenee akwan so,<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>mede ahodeɛ ma wɔn a wɔdɔ me</para>
  <para style="q2" vid="PRO 8:21">na mehyɛ wɔn adekoradan ma ma.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>“<char style="nd">Awurade</char> bɔɔ me sɛ nʼabɔdeɛ mu abakan</para>
  <para style="q2" vid="PRO 8:22">dii ne tete nneyɛɛ anim;<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>ɔyii me sii hɔ firi tete,</para>
  <para style="q2" vid="PRO 8:23">ansa na ewiase rehyɛ aseɛ.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Wɔwoo me ansa na wɔrebɔ ɛpo kakraka no</para>
  <para style="q2" vid="PRO 8:24">ansa na wɔreyɛ nsutire a nsuo ahyɛ no ma no;<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ansa na wɔde mmepɔ resisi hɔ,</para>
  <para style="q2" vid="PRO 8:25">wɔwoo me ansa na nkokoɔ reba,<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>ansa na ɔbɔɔ asase ne ne mfuo</para>
  <para style="q2" vid="PRO 8:26">anaa dɔteɛ biara a ɛwɔ asase soɔ.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Mewɔ hɔ ansa na wɔbɔɔ soro,</para>
  <para style="q2" vid="PRO 8:27">ɛberɛ a ɔtwaa hyeɛ too ebunu no ani no,<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>ɛberɛ a ɔbɔɔ omununkum wɔ soro</para>
  <para style="q2" vid="PRO 8:28">na ɔde ebunu mu nsutire tintim hɔ denden no,<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>ɛberɛ a ɔtwaa hyeɛ maa ɛpo</para>
  <para style="q2" vid="PRO 8:29">sɛdeɛ nsuo no rentra ne hyeɛ,</para>
  <para style="q1" vid="PRO 8:29">ne ɛberɛ a ɔtwaa asase fapem no,<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>na meyɛ odwumfoɔ a mete ne nkyɛn.</para>
  <para style="q1" vid="PRO 8:30">Anigyeɛ hyɛɛ me ma daa</para>
  <para style="q2" vid="PRO 8:30">na medii ahurisie wɔ nʼanim ɛberɛ biara,<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>na mʼani gye wɔ ne ewiase nyinaa mu</para>
  <para style="q2" vid="PRO 8:31">na mʼani ka wɔ adasamma mu.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“Enti me mma, montie me;</para>
  <para style="q2" vid="PRO 8:32">nhyira ne wɔn a wɔnante mʼakwan so.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>Montie mʼakwankyerɛ na monhunu nyansa;</para>
  <para style="q2" vid="PRO 8:33">mommu mo ani nngu so.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>Nhyira ne onipa a ɔtie me,</para>
  <para style="q2" vid="PRO 8:34">ɔwɛn mʼaboboano daa,</para>
  <para style="q2" vid="PRO 8:34">na ɔtwɛn wɔ hɔ.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Na obiara a ɔhunu me no nya nkwa</para>
  <para style="q2" vid="PRO 8:35">na ɔnya anisɔ firi <char style="nd">Awurade</char> nkyɛn.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>Na deɛ woanhwehwɛ me no ha ne ho</para>
  <para style="q2" vid="PRO 8:36">na wɔn a wɔtane me no dɔ owuo.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Nyansa Ne Nkwaseasɛm Frɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>Nyansa asi ne fie;</para>
  <para style="q2" vid="PRO 9:1">watwa nʼafadum nson ho.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Wasiesie nʼaduane afra ne nsã</para>
  <para style="q2" vid="PRO 9:2">wato ne ɛpono.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Wasoma ne mmaawa, na ɔfrɛ</para>
  <para style="q2" vid="PRO 9:3">firi kuropɔn no sorɔnsorɔmmea hɔ sɛ,<verse eid="PRO 9:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4"/>“Momma ntetekwaafoɔ nyinaa mmra ha!”</para>
  <para style="q1" vid="PRO 9:4">Ɔka kyerɛ wɔn a wɔnni atemmuo sɛ,<verse eid="PRO 9:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5"/>“Mommra mmɛdi mʼaduane</para>
  <para style="q2" vid="PRO 9:5">na monnom nsã a mafra no.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Monnya mo ntetekwaasɛm no na mobɛnya nkwa;</para>
  <para style="q2" vid="PRO 9:6">monnante nteaseɛ akwan so.”<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>Deɛ ɔtenetene ɔfɛdifoɔ no frɛ ahohorabɔ;</para>
  <para style="q2" vid="PRO 9:7">na deɛ ɔka amumuyɛfoɔ anim no nya ɔyea.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Ɛno enti, nnka ɔfɛdifoɔ anim na ɔmmɛtane wo;</para>
  <para style="q2" vid="PRO 9:8">ka onyansafoɔ anim na ɔbɛdɔ wo.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Ma onyansafoɔ akwankyerɛ na ɔbɛkɔ so ahunu nyansa;</para>
  <para style="q2" vid="PRO 9:9">kyerɛkyerɛ ɔteneneeni na ɔde bɛka nʼadesua ho.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>
    <char style="nd">Awurade</char> suro yɛ nyansa ahyɛaseɛ</para>
  <para style="q2" vid="PRO 9:10">Ɔkronkronni no ho nimdeɛ yɛ nteaseɛ.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Me mu na wo nna bɛdɔɔso,</para>
  <para style="q2" vid="PRO 9:11">na wɔde mfeɛ bɛka wo nkwa ho.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Sɛ woyɛ onyansafoɔ a, wobɛnya wo nyansa ho mfasoɔ;</para>
  <para style="q2" vid="PRO 9:12">sɛ woyɛ ɔfɛdifoɔ a, wo nko ara na ɛbɛhunu amane.<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>Ɔbaa ɔkwasea yɛ ɔkasafoɔ;</para>
  <para style="q2" vid="PRO 9:13">ɔnni ahohyɛsoɔ na ɔnni nimdeɛ.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Ɔte ne fie ɛpono ano,</para>
  <para style="q2" vid="PRO 9:14">na ɔte akonnwa a ɛsi kuropɔn no sorɔnsorɔmmea,<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>na ɔfrɛfrɛ wɔn a wɔtwam hɔ,</para>
  <para style="q2" vid="PRO 9:15">wɔn a wɔnam wɔn kwan so tee sɛ,<verse eid="PRO 9:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16"/>“Momma ntetekwaafoɔ nyinaa mmra ha”</para>
  <para style="q1" vid="PRO 9:16">ɔka kyerɛ wɔn a wɔnni atemmuo sɛ,<verse eid="PRO 9:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17"/>“Nsuo a wɔwia no yɛ fremfrem</para>
  <para style="q2" vid="PRO 9:17">na aduane a wɔdi no ahintaeɛ no yɛ dɛ!”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>Nanso wɔnnim koraa sɛ awufoɔ wɔ hɔ</para>
  <para style="q2" vid="PRO 9:18">sɛ nʼahɔhoɔ wɔ ɛda no ase tɔnn.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">Salomo Mmɛbusɛm</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>Salomo mmɛbusɛm:</para>
  <para style="q1" vid="PRO 10:1">Ɔba nyansafoɔ ma nʼagya ani gye,</para>
  <para style="q2" vid="PRO 10:1">na ɔba kwasea brɛ ne maame awerɛhoɔ.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>Ɛkwan bɔne so ahonya nni boɔ,</para>
  <para style="q2" vid="PRO 10:2">nanso tenenee gye onipa firi owuo mu.<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>
    <char style="nd">Awurade</char> remma ɛkɔm nne ɔteneneeni</para>
  <para style="q2" vid="PRO 10:3">na omumuyɛfoɔ deɛ ɔka nʼadepa gu.<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Nsa a ɛnyɛ adwuma ma onipa di hia,</para>
  <para style="q2" vid="PRO 10:4">nanso nsiyɛfoɔ nsa de ahonya ba.<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Deɛ ɔboaboa nnɔbaeɛ ano wɔ ahuhuro berɛ no yɛ ɔba nyansafoɔ</para>
  <para style="q2" vid="PRO 10:5">na deɛ ɔda wɔ twaberɛ mu no yɛ ɔba nimguaseni.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>Teneneefoɔ hyɛ nhyira kyɛ</para>
  <para style="q2" vid="PRO 10:6">na akakabensɛm ayɛ omumuyɛfoɔ anom ma.<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Ɔteneneeni nkaeɛ yɛ nhyira,</para>
  <para style="q2" vid="PRO 10:7">na omumuyɛfoɔ din bɛporɔ.<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>Akoma mu nyansafoɔ tie ɔhyɛ nsɛm,</para>
  <para style="q2" vid="PRO 10:8">na ɔkwasea kasafoɔ hwe ase.<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Ɔnokwafoɔ nante dwoodwoo,</para>
  <para style="q2" vid="PRO 10:9">na deɛ ɔfa akwan kɔntɔnkye so no ho bɛda adi.<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Deɛ ɔde nitan bu nʼani no de ɔhaw ba,</para>
  <para style="q2" vid="PRO 10:10">na ɔkwasea kasafoɔ hwe ase.<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>Ɔteneneeni anom yɛ nkwa asutire,</para>
  <para style="q2" vid="PRO 10:11">na akakabensɛm ayɛ omumuyɛfoɔ anom ma.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Ɔtan hwanyan mpaapaemu,</para>
  <para style="q2" vid="PRO 10:12">nanso ɔdɔ kata mfomsoɔ nyinaa so.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Wohunu nyansa wɔ nhunumufoɔ anom,</para>
  <para style="q2" vid="PRO 10:13">na abaa fata deɛ ɔnni atemmuo akyi.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>Anyansafoɔ kora nimdeɛ,</para>
  <para style="q2" vid="PRO 10:14">nanso ɔkwasea ano frɛfrɛ ɔsɛeɛ.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Adefoɔ ahonya yɛ wɔn kuropɔn a wɔabɔ ho ban,</para>
  <para style="q2" vid="PRO 10:15">nanso ahiafoɔ hia yɛ wɔn asehweɛ.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>Ateneneefoɔ akatua de nkwa brɛ wɔn,</para>
  <para style="q2" vid="PRO 10:16">na deɛ amumuyɛfoɔ nya no de asotwe brɛ wɔn.<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Deɛ ɔtie nteteeɛ pa no kyerɛ nkwa kwan,</para>
  <para style="q2" vid="PRO 10:17">na deɛ ɔpo ntenesoɔ no di afoforɔ anim yera ɛkwan.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Deɛ ɔkata nitan soɔ no yɛ ɔtorofoɔ,</para>
  <para style="q2" vid="PRO 10:18">na deɛ ɔdi nsekuro no yɛ ɔkwasea.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Mfomsoɔ mpa ɔkasa bebree mu,</para>
  <para style="q2" vid="PRO 10:19">na deɛ ɔkora ne tɛkrɛma no yɛ onyansafoɔ.<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Ɔteneneeni tɛkrɛma yɛ dwetɛ amapa</para>
  <para style="q2" vid="PRO 10:20">nanso omumuyɛfoɔ akoma nni boɔ.<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>Teneneefoɔ ano ho mfasoɔ ma bebree aduane,</para>
  <para style="q2" vid="PRO 10:21">na atemmuo a nkwaseafoɔ nni enti wɔwuwu.<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>
    <char style="nd">Awurade</char> nhyira de ahonya ba,</para>
  <para style="q2" vid="PRO 10:22">na ɔmmfa ɔhaw biara nka ho.<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Bɔneyɛ yɛ anigyedeɛ ma ɔkwasea,</para>
  <para style="q2" vid="PRO 10:23">nanso deɛ ɔwɔ nimdeɛ anigyeɛ wɔ nyansa mu.<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Deɛ amumuyɛfoɔ suro no bɛba wɔn so;</para>
  <para style="q2" vid="PRO 10:24">na deɛ teneneefoɔ pɛ no, wɔde bɛma wɔn.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Sɛ ahum no bɛtwam a, amumuyɛfoɔ yera,</para>
  <para style="q2" vid="PRO 10:25">nanso teneneefoɔ gyina hɔ pintinn afebɔɔ.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Sɛdeɛ nsã kekakeka ka ɛse, na wisie kɔ ani no,</para>
  <para style="q2" vid="PRO 10:26">saa ara na ɔkwadwofoɔ yɛ ma wɔn a wɔsoma noɔ.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>
    <char style="nd">Awurade</char> suro ma nkwa tenten,</para>
  <para style="q2" vid="PRO 10:27">nanso wɔtwa amumuyɛfoɔ nkwa so.<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Teneneefoɔ anidasoɔ de ahotɔ ba,</para>
  <para style="q2" vid="PRO 10:28">nanso amumuyɛfoɔ anidasoɔ nkɔsi hwee.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>
    <char style="nd">Awurade</char> ɛkwan yɛ dwanekɔbea ma ɔteneneeni,</para>
  <para style="q2" vid="PRO 10:29">nanso ɛyɛ ɔsɛeɛ ma wɔn a wɔyɛ bɔne.<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Wɔrentɔre teneneefoɔ ase da,</para>
  <para style="q2" vid="PRO 10:30">nanso amumuyɛfoɔ renka asase no so.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>Nyansa firi teneneeni anom ba</para>
  <para style="q2" vid="PRO 10:31">nanso tɛkrɛma a ɛdaadaa no wɔbɛtwa atwene.<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Teneneefoɔ ano nim adeɛ a ɛfata</para>
  <para style="q2" vid="PRO 10:32">na omumuyɛfoɔ ano nim deɛ ɛyɛ nnaadaasɛm nko ara.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>
    <char style="nd">Awurade</char> kyiri asisie nsania,</para>
  <para style="q2" vid="PRO 11:1">na nʼani gye nokorɛ nkariboɔ ho.<verse eid="PRO 11:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Ahantan ba a, animguaseɛ na ɛdi soɔ</para>
  <para style="q2" vid="PRO 11:2">nanso ahobrɛaseɛ de nyansa ba.<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Teefoɔ nokorɛdie kyerɛ wɔn ɛkwan;</para>
  <para style="q2" vid="PRO 11:3">nanso nkontompofoɔ ano ntanta sɛe wɔn.<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Ahonya nnka hwee abufuhyeɛ da no,</para>
  <para style="q2" vid="PRO 11:4">nanso tenenee gye nkwa firi owuo mu.<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Wɔn a wɔnnyɛ bɔne teneneeyɛ bɔ ɛkwan tee ma wɔn,</para>
  <para style="q2" vid="PRO 11:5">nanso amumuyɛfoɔ amumuyɛsɛm brɛ wɔn ase.<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Pɛyɛfoɔ teneneeyɛ gye wɔn,</para>
  <para style="q2" vid="PRO 11:6">nanso akɔnnɔ bɔne afidie yi nkontompofoɔ.<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Sɛ omumuyɛfoɔ wu a, nʼanidasoɔ yera;</para>
  <para style="q2" vid="PRO 11:7">deɛ ɔsusuu sɛ ɔbɛnya afiri ne tumi mu nyinaa no yɛ kwa.<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Wɔgye ɔteneneeni firi amaneɛ mu,</para>
  <para style="q2" vid="PRO 11:8">na ɛba omumuyɛfoɔ so mmom.<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Deɛ ɔnsuro Onyame de nʼano sɛe ne yɔnko,</para>
  <para style="q2" vid="PRO 11:9">nanso ɔteneneeni nam nimdeɛ so firi mu.<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Sɛ teneneefoɔ di yie a, kuropɔn no di ahurisie;</para>
  <para style="q2" vid="PRO 11:10">nanso amumuyɛfoɔ wu a, wɔbɔ ose.<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Pɛyɛfoɔ nhyira ma kuropɔn no kɔ so,</para>
  <para style="q2" vid="PRO 11:11">nanso amumuyɛfoɔ ano bɔ no.<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Onipa a ɔnni adwene no bu ne yɔnko animtiaa,</para>
  <para style="q2" vid="PRO 11:12">nanso deɛ ɔwɔ nhunumu no to ne tɛkrɛma nnareka.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Osekuni da kɔkoamsɛm adi,</para>
  <para style="q2" vid="PRO 11:13">nanso deɛ yɛnya ne mu ahotosoɔ no kora kasasie so.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Ɔman a ɛnni akwankyerɛ no bɔ,</para>
  <para style="q2" vid="PRO 11:14">nanso afotufoɔ dodoɔ ma nkonimdie ba.<verse eid="PRO 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Deɛ ɔdi agyinamu ma ɔfoforɔ no bɛhunu amane,</para>
  <para style="q2" vid="PRO 11:15">na deɛ ɔmmfa ne nsa nhyɛ awowasie ase no aso mu dwo no.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Ɔbaa a ne yam yɛ no wɔde obuo ma no,</para>
  <para style="q2" vid="PRO 11:16">nanso mmarima basabasayɛfoɔ nya ahodeɛ nko ara.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Ɔyamyɛfoɔ yɛ ma ne ho,</para>
  <para style="q2" vid="PRO 11:17">na otirimuɔdenfoɔ de ɔhaw ba nʼankasa so.<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Omumuyɛfoɔ nya akatua a ɛnnyina,</para>
  <para style="q2" vid="PRO 11:18">nanso deɛ ɔgu tenenee aba no twa akatua a ɛdi mu.<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Deɛ ɔyɛ nokorɛ teneneeni no nya nkwa,</para>
  <para style="q2" vid="PRO 11:19">nanso deɛ ɔkɔ so yɛ bɔne no kɔ owuo mu.<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>
    <char style="nd">Awurade</char> kyiri nnipa a wɔn akoma akyinsa,</para>
  <para style="q2" vid="PRO 11:20">na nʼani gye wɔn a wɔn akwan ho nni asɛm ho.<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Gye to mu sɛ, amumuyɛfoɔ bɛnya wɔn akatua,</para>
  <para style="q2" vid="PRO 11:21">na teneneefoɔ bɛnya wɔn tiri adi mu.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Ɔbaa hoɔfɛfoɔ a ɔntumi nsi gyinaeɛ no</para>
  <para style="q2" vid="PRO 11:22">te sɛ sika kawa a ɛhyɛ prako hwene mu.<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Teneneefoɔ apɛdeɛ wie yie,</para>
  <para style="q2" vid="PRO 11:23">nanso amumuyɛfoɔ anidasoɔ wie abufuhyeɛ.<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Obi yɛ adɔeɛ, na ɔnya ne ho bebree;</para>
  <para style="q2" vid="PRO 11:24">obi nso yɛ adɔna, nanso ɛhia no.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Ɔyamyɛfoɔ bɛkɔ so anya ne ho;</para>
  <para style="q2" vid="PRO 11:25">na deɛ ɔma ebinom mee no nso bɛmee.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Nnipa dome deɛ ɔde atokoɔ sie,</para>
  <para style="q2" vid="PRO 11:26">na nhyira ba deɛ ɔtɔn ne deɛ so.<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Deɛ ɔhwehwɛ papa akyiri ɛkwan no nya anisɔ,</para>
  <para style="q2" vid="PRO 11:27">na deɛ ɔhwehwɛ bɔne no, bɔne ba ne so.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Deɛ ɔde ne ho to nʼahonyadeɛ soɔ no bɛhwe ase,</para>
  <para style="q2" vid="PRO 11:28">na ɔteneneeni bɛyɛ frɔmm sɛ ahahan mono.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Deɛ ɔde ɔhaw bɛto nʼabusua so no bɛdi mframa adeɛ,</para>
  <para style="q2" vid="PRO 11:29">na ɔkwasea bɛyɛ onyansafoɔ ɔsomfoɔ.<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Ɔteneneeni aba yɛ nkwa dua,</para>
  <para style="q2" vid="PRO 11:30">na deɛ ɔgye akra no yɛ onyansafoɔ.<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Sɛ teneneefoɔ nya wɔn akatua wɔ asase so a</para>
  <para style="q2" vid="PRO 11:31">ɛnneɛ na wɔn a wɔnnim Onyame ne abɔnefoɔ nso ɛ!<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Obiara a ɔpɛ ahohyɛsoɔ no pɛ nimdeɛ,</para>
  <para style="q2" vid="PRO 12:1">na deɛ ɔkyiri ntenesoɔ no yɛ ogyimifoɔ.<verse eid="PRO 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Onipa pa nya <char style="nd">Awurade</char> nkyɛn adom,</para>
  <para style="q2" vid="PRO 12:2">na <char style="nd">Awurade</char> bu onifirani fɔ.<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Amumuyɛsɛm rentumi mma onipa ase ntim,</para>
  <para style="q2" vid="PRO 12:3">na wɔrentumi nntu ɔteneneeni ase.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Ɔyere a ɔwɔ suban pa yɛ ne kunu ahenkyɛ,</para>
  <para style="q2" vid="PRO 12:4">nanso ɔyere animguasefoɔ te sɛ porɔeɛ wɔ ne kunu nnompe mu.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Teneneefoɔ nhyehyɛeɛ yɛ pɛ,</para>
  <para style="q2" vid="PRO 12:5">na amumuyɛfoɔ afotuo yɛ nnaadaa.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Amumuyɛfoɔ nsɛm da hɔ twɛn mogya,</para>
  <para style="q2" vid="PRO 12:6">na ɔteneneeni kasa yi wɔn firi mu.<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Wɔtu amumuyɛfoɔ gu na wɔyera,</para>
  <para style="q2" vid="PRO 12:7">nanso teneneefoɔ fie gyina pintinn.<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Wɔkamfo onipa sɛdeɛ ne nyansa teɛ</para>
  <para style="q2" vid="PRO 12:8">na nnipa a wɔn adwene yɛ kɔntɔnkye deɛ, wɔbu wɔn animtiaa.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Ɛyɛ sɛ wobɛyɛ wo ho sɛ ɔteta a nso wowɔ ɔsomfoɔ,</para>
  <para style="q2" vid="PRO 12:9">sene sɛ wobɛyɛ wo ho sɛ obi, nanso wonni aduane.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Ɔteneneeni ma nʼayɛmmoa deɛ wɔpɛ,</para>
  <para style="q2" vid="PRO 12:10">na amumuyɛfoɔ nneyɛɛ a ɛyɛ pa ara yɛ atirimuɔden.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Deɛ ɔyɛ nʼasase so adwuma no bɛnya aduane bebree,</para>
  <para style="q2" vid="PRO 12:11">na deɛ ɔdi nsɛm huhuo akyi no nni adwene.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Amumuyɛfoɔ pɛ abɔnefoɔ afodeɛ,</para>
  <para style="q2" vid="PRO 12:12">nanso ɔteneneeni ase dɔre.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Ɔbɔnefoɔ anosɛm yi no sɛ afidie,</para>
  <para style="q2" vid="PRO 12:13">nanso ɔteneneeni nya ne ho tete wɔ ahohiahia mu.<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Nneɛma pa firi onipa anomu aba mu hyɛ no ma</para>
  <para style="q2" vid="PRO 12:14">sɛdeɛ ne nsa ano adwuma ma no akatua no.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Ɔkwasea akwan tene wɔ nʼani so,</para>
  <para style="q2" vid="PRO 12:15">na ɔnyansafoɔ tie afotuo.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Ɔkwasea bo nkyɛre fu,</para>
  <para style="q2" vid="PRO 12:16">nanso ɔbadwemma bu nʼani gu atɛnnidie so.<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Ɔdanseni nokwafoɔ di adanseɛ turodoo,</para>
  <para style="q2" vid="PRO 12:17">na deɛ ɔdi adansekurumu no twa nkontompo.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Nsɛm hunu keka wowɔ te sɛ akofena</para>
  <para style="q2" vid="PRO 12:18">nanso onyansafoɔ tɛkrɛma ma abodwoeɛ.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Ano a ɛka nokorɛ no tim hɔ daa,</para>
  <para style="q2" vid="PRO 12:19">na atorɔ tɛkrɛma ɛnkyɛre koraa.<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Nnaadaa hyɛ wɔn a wɔdwene bɔne ho akoma mu,</para>
  <para style="q2" vid="PRO 12:20">na wɔn a wɔpɛ asomdwoeɛ nya ahosɛpɛ.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>Ɔhaw biara rento ɔteneneeni,</para>
  <para style="q2" vid="PRO 12:21">nanso amanehunu mee amumuyɛfoɔ.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>
    <char style="nd">Awurade</char> kyiri ano a ɛtwa atorɔ,</para>
  <para style="q2" vid="PRO 12:22">na nʼani gye nnipa a wɔdi nokorɛ ho.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Ɔnifirafoɔ mmɔ ne nimdeɛ ho dawuro</para>
  <para style="q2" vid="PRO 12:23">na nkwaseafoɔ akoma da agyimisɛm adi.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>Nsa a ɛyɛ adwuma no bɛdi tumi,</para>
  <para style="q2" vid="PRO 12:24">nanso akwadworɔ wie nkoasom mu.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Akoma a ɛpere adeɛ ho ma onipa boto,</para>
  <para style="q2" vid="PRO 12:25">nanso nkuranhyɛsɛm bi hyɛ no den.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Ɔteneneeni wɔ ntoboaseɛ wɔ ayɔnkofa mu,</para>
  <para style="q2" vid="PRO 12:26">nanso amumuyɛfoɔ kwan ma wɔfom.<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Onihafoɔ ntoto ne hanam,</para>
  <para style="q2" vid="PRO 12:27">nanso nsiyɛfoɔ ahonyadeɛ som bo ma wɔn.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>Tenenee kwan mu wɔ nkwa;</para>
  <para style="q2" vid="PRO 12:28">na owuo nni saa ɛkwan no so.<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Ɔba nyansafoɔ tie nʼagya nkyerɛkyerɛ;</para>
  <para style="q2" vid="PRO 13:1">na ɔfɛdifoɔ ntie animka.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Nneɛma pa a ɛfiri onipa anom no ma no anigyeɛ,</para>
  <para style="q2" vid="PRO 13:2">na wɔn a wɔnni nokorɛ no kɔn dɔ basabasayɛ.<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Deɛ ɔkora nʼano no kora ne nkwa so,</para>
  <para style="q2" vid="PRO 13:3">nanso deɛ ɔkasa a ɔnsusu ho no bɛba ɔsɛeɛ mu.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Onihafoɔ pere hwehwɛ nanso ɔnnya hwee,</para>
  <para style="q2" vid="PRO 13:4">na deɛ ɔyɛ adwuma no nya deɛ ɔpɛ biara.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Teneneefoɔ kyiri deɛ ɛnyɛ nokorɛ,</para>
  <para style="q2" vid="PRO 13:5">nanso amumuyɛfoɔ de aniwuo ne ahohora ba.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Tenenee bɔ ɔnokwafoɔ ho ban,</para>
  <para style="q2" vid="PRO 13:6">na amumuyɛsɛm tu ɔbɔnefoɔ gu.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Obi yɛ ne ho sɛ ɔdefoɔ, a nso ɔnni hwee,</para>
  <para style="q2" vid="PRO 13:7">ɔfoforɔ yɛ ne ho sɛ ohiani, a nso ɔwɔ ahonya bebree.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Obi ahonya bɛtumi agye no nkwa,</para>
  <para style="q2" vid="PRO 13:8">nanso ohiani nte ahunahuna biara.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>Teneneefoɔ kanea hyerɛn pa ara,</para>
  <para style="q2" vid="PRO 13:9">nanso wɔdum amumuyɛfoɔ kanea.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Ahantan de ntɔkwa nko ara na ɛba,</para>
  <para style="q2" vid="PRO 13:10">na wɔhunu nyansa wɔ wɔn a wɔtie afutuo mu.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Ahonya a ɛnam kwammɔne soɔ no hwere ntɛm so,</para>
  <para style="q2" vid="PRO 13:11">na deɛ ɔboa sika ano nkakrankakra no ma ɛdɔɔso.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Anidasoɔ a wɔtu hyɛ da no bɔ akoma yadeɛ,</para>
  <para style="q2" vid="PRO 13:12">nanso anigyinadeɛ a nsa aka no yɛ nkwa dua.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Deɛ ɔtwiri ahyɛdeɛ no bɛtua so ka,</para>
  <para style="q2" vid="PRO 13:13">nanso deɛ ɔde obuo ma mmara no, wɔma no akatua.<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Onyansafoɔ nkyerɛkyerɛ te sɛ nkwa asutire,</para>
  <para style="q2" vid="PRO 13:14">ɛyi onipa firi owuo afidie mu.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>Nhunumu pa de adom ba,</para>
  <para style="q2" vid="PRO 13:15">nanso atorofoɔ ɛkwan so yɛ den.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Ɔbadwemma biara yɛ nʼadeɛ wɔ nimdeɛ mu,</para>
  <para style="q2" vid="PRO 13:16">nanso ɔkwasea da nʼagyimisɛm adi.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Ɔsomafoɔ mumuyɛfoɔ tɔ amaneɛ mu,</para>
  <para style="q2" vid="PRO 13:17">nanso ɔnanmusini nokwafoɔ de abodwoɔ ba.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>Deɛ ɔpo ntenesoɔ no kɔ ohia ne animguaseɛ mu,</para>
  <para style="q2" vid="PRO 13:18">na deɛ ɔtie ntenesoɔ no, wɔhyɛ no animuonyam.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Akɔnnɔdeɛ a nsa aka ma ɔkra ani gye,</para>
  <para style="q2" vid="PRO 13:19">nanso nkwaseafoɔ kyiri sɛ wɔtwe wɔn ho firi bɔne ho.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>Deɛ ɔne onyansafoɔ nante no hunu nyansa,</para>
  <para style="q2" vid="PRO 13:20">na deɛ ɔne nkwaseafoɔ bɔ no hunu amane.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Ɔhaw di ɔbɔnefoɔ akyi,</para>
  <para style="q2" vid="PRO 13:21">na nkɔsoɔ yɛ teneneeni akatua.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>Onipa pa de agyapadeɛ gya ne nananom,</para>
  <para style="q2" vid="PRO 13:22">na wɔkora ɔbɔnefoɔ ahonyadeɛ so ma ɔteneneeni.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Ohiani afuom nnɔbaeɛ tumi ba pii,</para>
  <para style="q2" vid="PRO 13:23">nanso ntɛnkyea pra kɔ.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Deɛ ɔkyɛe nʼabaa so no tane ne ba,</para>
  <para style="q2" vid="PRO 13:24">na deɛ ɔdɔ no no hwɛ sɛ ɔbɛtene no.<verse eid="PRO 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Teneneefoɔ didi ma wɔn akoma mee</para>
  <para style="q2" vid="PRO 13:25">nanso, ɛkɔm de amumuyɛfoɔ.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>Ɔbaa nyansafoɔ si ne dan,</para>
  <para style="q2" vid="PRO 14:1">nanso ɔbaa kwasea de nʼankasa ne nsa dwiri ne deɛ gu fam.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Deɛ ne nanteɛ tene no suro <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PRO 14:2">na deɛ nʼakwan kyea no bu no animtiaa.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Ɔkwasea kasa ma wɔbɔ nʼakyi abaa,</para>
  <para style="q2" vid="PRO 14:3">nanso anyansafoɔ ano bɔ wɔn ho ban.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Baabi a anantwie nni no, adididaka no mu da mpan,</para>
  <para style="q2" vid="PRO 14:4">na ɔnantwie ahoɔden mu na nnɔbaeɛ pii firi ba.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Ɔdanseni nokwafoɔ rennaadaa,</para>
  <para style="q2" vid="PRO 14:5">ɔdansekurumni hwie atorɔ gu hɔ.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Ɔfɛdifoɔ hwehwɛ nyansa nanso ɔnnya,</para>
  <para style="q2" vid="PRO 14:6">nanso wɔn a wɔwɔ nhunumu nya nimdeɛ ntɛm.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Twe wo ho firi ɔkwasea ho,</para>
  <para style="q2" vid="PRO 14:7">ɛfiri sɛ, worennya nimdeɛ mfiri nʼano.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Anitefoɔ nyansa ne sɛ wɔbɛdwene wɔn akwan ho,</para>
  <para style="q2" vid="PRO 14:8">na nkwaseafoɔ agyimisɛm yɛ nnaadaa.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Nkwaseafoɔ de bɔne ho adwensakyera di fɛ,</para>
  <para style="q2" vid="PRO 14:9">na wɔn a wɔtene mu na anisɔ wɔ.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Akoma biara nim ɔyea ɛwɔ ne mu,</para>
  <para style="q2" vid="PRO 14:10">na obi foforɔ rentumi ne no nkyɛ nʼanigyeɛ.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>Wɔbɛsɛe mumuyɛfoɔ efie,</para>
  <para style="q2" vid="PRO 14:11">nanso teefoɔ ntomadan bɛyɛ frɔmm.<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Ɛkwan bi wɔ hɔ a ɛyɛ wɔ onipa ani so,</para>
  <para style="q2" vid="PRO 14:12">nanso ɛkɔwie owuo mu.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>Ɔsereɛ mu mpo, akoma tumi di yea,</para>
  <para style="q2" vid="PRO 14:13">na anigyeɛ tumi wie awerɛhoɔ.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Akyirisanfoɔ bɛnya akatua sɛdeɛ wɔn akwan teɛ,</para>
  <para style="q2" vid="PRO 14:14">na onipa pa nso bɛnya ne deɛ.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Atetekwaa gye biribiara di,</para>
  <para style="q2" vid="PRO 14:15">nanso ɔnitefoɔ dwene nʼanammɔntuo ho.<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Onyansafoɔ suro <char style="nd">Awurade</char> na ɔdwane bɔne,</para>
  <para style="q2" vid="PRO 14:16">nanso ɔkwasea yɛ asowuiɛ ne basabasa.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Onipa a ne bo nkyɛre fuo no yɛ nkwaseadeɛ,</para>
  <para style="q2" vid="PRO 14:17">na deɛ ɔpam apammɔne no, wɔtane no.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Ntetekwaafoɔ agyapadeɛ ne gyimie,</para>
  <para style="q2" vid="PRO 14:18">na wɔde nimdeɛ bɔ anitefoɔ abotire.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>Nnipa bɔnefoɔ bɛkoto nnipa pa anim,</para>
  <para style="q2" vid="PRO 14:19">na amumuyɛfoɔ akoto ateneneefoɔ apono ano.<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>Ahiafoɔ deɛ, wɔn ayɔnkofoɔ mpo mpɛ wɔn anim ahwɛ,</para>
  <para style="q2" vid="PRO 14:20">nanso adefoɔ wɔ nnamfonom bebree.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Deɛ ɔbu ne yɔnko animtiaa yɛ bɔne,</para>
  <para style="q2" vid="PRO 14:21">na nhyira nka deɛ ne yam yɛ ma onnibie.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>Wɔn a wɔbɔ pɔ bɔne nyera ɛkwan anaa?</para>
  <para style="q2" vid="PRO 14:22">Nanso wɔn a wɔhyehyɛ deɛ ɛyɛ no nya adɔeɛ ne nokorɛ.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Adwumadenyɛ nyinaa de mfasoɔ ba,</para>
  <para style="q2" vid="PRO 14:23">na kasa hunu deɛ, ɛkɔ ohia mu.<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>Anyansafoɔ ahonya ne wɔn abotire,</para>
  <para style="q2" vid="PRO 14:24">na nkwaseafoɔ agyimisɛm so gyimie aba.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Ɔdanseni nokwafoɔ gye nkwa,</para>
  <para style="q2" vid="PRO 14:25">nanso ɔdansekurumni yɛ ɔdaadaafoɔ.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Deɛ ɔsuro <char style="nd">Awurade</char> no wɔ banbɔ a emu yɛ den,</para>
  <para style="q2" vid="PRO 14:26">na ɛbɛyɛ dwanekɔbea ama ne mma.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>
    <char style="nd">Awurade</char> suro yɛ nkwa asutire,</para>
  <para style="q2" vid="PRO 14:27">ɛyi onipa firi owuo afidie mu.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Ɔman mu nnipa dodoɔ yɛ ɔhene animuonyam,</para>
  <para style="q2" vid="PRO 14:28">nanso sɛ asomfoɔ nni hɔ a mmapɔmma no sɛe.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Onipa a ɔwɔ abodwokyerɛ wɔ nteaseɛ a emu dɔ,</para>
  <para style="q2" vid="PRO 14:29">na deɛ ne bo fu ntɛm no da agyimisɛm adi.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Akoma mu asomdwoeɛ ma onipadua nkwa,</para>
  <para style="q2" vid="PRO 14:30">na anibereɛ ma nnompe porɔ.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Deɛ ɔhyɛ ahiafoɔ soɔ no bu wɔn Yɛfoɔ animtiaa,</para>
  <para style="q2" vid="PRO 14:31">nanso deɛ ɔhunu ohiani mmɔbɔ no hyɛ Onyankopɔn animuonyam.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Sɛ amanehunu ba a amumuyɛfoɔ hwe ase,</para>
  <para style="q2" vid="PRO 14:32">nanso owuo mu mpo teneneefoɔ wɔ dwanekɔbea.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Nyansa te nteaseɛ akoma mu,</para>
  <para style="q2" vid="PRO 14:33">na nkwaseafoɔ mu mpo, ɔyi ne ho adi.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Tenenee pagya ɔman</para>
  <para style="q2" vid="PRO 14:34">na bɔne yɛ animguaseɛ ma nnipa biara.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Ɔhene ani sɔ ɔsomfoɔ nyansani,</para>
  <para style="q2" vid="PRO 14:35">na ɔsomfoɔ nimguaseni hyɛ no abufuo.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Mmuaeɛ pa dwodwo abufuo,</para>
  <para style="q2" vid="PRO 15:1">nanso asɛm a ano yɛ den hwanyane abufuo mu.<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>Onyansafoɔ tɛkrɛma yi nimdeɛ ayɛ,</para>
  <para style="q2" vid="PRO 15:2">nanso ɔkwasea ano woro agyimisɛm.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>
    <char style="nd">Awurade</char> ani hunu baabiara,</para>
  <para style="q2" vid="PRO 15:3">na ɛhwɛ amumuyɛfoɔ ne apapafoɔ.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Tɛkrɛma a ɛde abodwoɔ ba yɛ nkwa dua,</para>
  <para style="q2" vid="PRO 15:4">nanso nnaadaa tɛkrɛma dwerɛ honhom.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Ɔkwasea mmfa nʼagya ntenesoɔ nyɛ hwee,</para>
  <para style="q2" vid="PRO 15:5">na deɛ ɔtie ntenesoɔ no kyerɛ sɛ ɔyɛ ɔnitefoɔ.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Ahonya bebree wɔ ɔteneneeni fie,</para>
  <para style="q2" vid="PRO 15:6">nanso amumuyɛfoɔ adenya de ɔhaw brɛ wɔn.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Anyansafoɔ ano trɛtrɛ nimdeɛ mu;</para>
  <para style="q2" vid="PRO 15:7">nanso ɛnyɛ saa na nkwaseafoɔ akoma teɛ.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>
    <char style="nd">Awurade</char> kyiri amumuyɛfoɔ afɔrebɔ,</para>
  <para style="q2" vid="PRO 15:8">nanso teefoɔ mpaeɛbɔ sɔ nʼani.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>
    <char style="nd">Awurade</char> kyiri amumuyɛfoɔ akwan,</para>
  <para style="q2" vid="PRO 15:9">nanso ɔdɔ wɔn a wɔti tenenee.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Asotwe denden wɔ hɔ ma dea ɔmane firi ɛkwan no so,</para>
  <para style="q2" vid="PRO 15:10">deɛ ɔtane ntenesoɔ no bɛwu.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Owuo ne Ɔsɛeɛ da <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PRO 15:11">na nnipa akoma mu deɛ, ɔnim ma ɛboro so.<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>Ɔfɛdifoɔ mpɛ ntenesoɔ;</para>
  <para style="q2" vid="PRO 15:12">ɔnnkɔbisa anyansafoɔ hwee.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Anigyeɛ akoma ma anim yɛ seresere,</para>
  <para style="q2" vid="PRO 15:13">na akoma a abotoɔ dwerɛ honhom.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>Nhunumufoɔ akoma hwehwɛ nimdeɛ,</para>
  <para style="q2" vid="PRO 15:14">nanso ɔkwasea ano ka agyimisɛm.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Wɔn a wɔhyɛ wɔn so nna nyinaa yɛ mmɔbɔmmɔbɔ,</para>
  <para style="q2" vid="PRO 15:15">nanso anigyeɛ akoma wɔ daa ahosɛpɛ mu.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Ketewa bi a yɛnya a <char style="nd">Awurade</char> suro ka ho no yɛ</para>
  <para style="q2" vid="PRO 15:16">sene ahonyadeɛ bebree a ɔhaw bata ho.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Nhahamma aduane a ɔdɔ wɔ mu no yɛ</para>
  <para style="q2" vid="PRO 15:17">sene nantwie sradenam a ɔtan bata ho.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Deɛ ne bo fu ntɛm de mpaapaemu ba,</para>
  <para style="q2" vid="PRO 15:18">nanso deɛ ɔwɔ ntoboaseɛ pata ntɔkwa.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Nkasɛɛ ama onihafoɔ kwan asi,</para>
  <para style="q2" vid="PRO 15:19">nanso teneneefoɔ kwan yɛ tempɔn.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Ɔba nyansafoɔ ma nʼagya ani gye</para>
  <para style="q2" vid="PRO 15:20">nanso ɔba kwasea bu ne maame animtiaa.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Agyimisɛm ma deɛ ɔnni adwene ani gye,</para>
  <para style="q2" vid="PRO 15:21">nanso deɛ ɔwɔ nteaseɛ no fa ɛkwan a ɛtene so.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>Nhyehyɛeɛ a ɛnni afotuo no sɛe,</para>
  <para style="q2" vid="PRO 15:22">nanso afotufoɔ bebree ma ɛyɛ yie.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Onipa a ɔma mmuaeɛ a ɛfata no ani gye,</para>
  <para style="q2" vid="PRO 15:23">asɛm a ɛba berɛ pa mu no nso yɛ.<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Onyansafoɔ asetena mu kwan ma no nkɔsoɔ</para>
  <para style="q2" vid="PRO 15:24">ɛsi ne da mu korɔ ho ɛkwan.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>
    <char style="nd">Awurade</char> sɛe ɔhantanni fie</para>
  <para style="q2" vid="PRO 15:25">na ɔma akunafoɔ ahyeɛ yɛ pɛpɛɛpɛ.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>
    <char style="nd">Awurade</char> kyiri amumuyɛfoɔ nsusuiɛ,</para>
  <para style="q2" vid="PRO 15:26">nanso nʼani sɔ wɔn a wɔyɛ kronn no deɛ.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Ɔdufudepɛfoɔ de ɔhaw brɛ nʼabusua,</para>
  <para style="q2" vid="PRO 15:27">nanso deɛ ɔkyiri kɛtɛasehyɛ no bɛnya nkwa.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Ɔteneneeni akoma kari ne mmuaeɛ,</para>
  <para style="q2" vid="PRO 15:28">nanso omumuyɛfoɔ ano woro bɔne.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>
    <char style="nd">Awurade</char> mmɛn amumuyɛfoɔ koraa</para>
  <para style="q2" vid="PRO 15:29">nanso ɔte ɔteneneeni mpaeɛbɔ.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Animu a ɛteɛ ma akoma nya ahomeka,</para>
  <para style="q2" vid="PRO 15:30">na asɛm pa ma nnompe ahoɔden.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Deɛ ɔtie animka a ɛma nkwa no</para>
  <para style="q2" vid="PRO 15:31">ne anyansafoɔ bɛbɔ mu atena ase.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Deɛ ɔmfa ahohyɛsoɔ no bu ne ho animtiaa,</para>
  <para style="q2" vid="PRO 15:32">na deɛ ɔtie ntenesoɔ no nya nhunumu.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>
    <char style="nd">Awurade</char> suro kyerɛ onipa nyansa,</para>
  <para style="q2" vid="PRO 15:33">ahobrɛaseɛ di animuonyam anim.<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>Akoma mu nhyehyɛeɛ yɛ onipa dea,</para>
  <para style="q2" vid="PRO 16:1">na tɛkrɛma mmuaeɛ firi <char style="nd">Awurade</char>.<verse eid="PRO 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Ɛyɛ onipa sɛ nʼakwan nyinaa yɛ kronn</para>
  <para style="q2" vid="PRO 16:2">nanso <char style="nd">Awurade</char> na ɔpɛɛpɛɛ adwene mu.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>Fa deɛ woyɛ nyinaa hyɛ <char style="nd">Awurade</char> nsam,</para>
  <para style="q2" vid="PRO 16:3">na wo nhyehyɛeɛ bɛsi yie.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>
    <char style="nd">Awurade</char> yɛ biribiara ma nʼankasa botaeɛ,</para>
  <para style="q2" vid="PRO 16:4">mpo, ɔhwɛ omumuyɛfoɔ kɔsi amanehunu da.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>
    <char style="nd">Awurade</char> kyiri akoma mu ahantanfoɔ nyinaa.</para>
  <para style="q2" vid="PRO 16:5">Nya saa nteaseɛ yi sɛ, wɔremfa wɔn ho nni.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Wɔnam ɔdɔ ne nokorɛ so pata bɔne;</para>
  <para style="q2" vid="PRO 16:6">onipa nam <char style="nd">Awurade</char> suro so yi bɔne akwa.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Sɛ onipa akwan sɔ <char style="nd">Awurade</char> ani a,</para>
  <para style="q2" vid="PRO 16:7">ɔma nʼatamfoɔ mpo ne no tena asomdwoeɛ mu.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Kakraa bi a wɔnam tenenee kwan so nya no yɛ</para>
  <para style="q2" vid="PRO 16:8">sene mfasoɔ pii a wɔnam ntɛnkyea so nya.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>Onipa yɛ ne nhyehyɛeɛ wɔ nʼakoma mu,</para>
  <para style="q2" vid="PRO 16:9">nanso <char style="nd">Awurade</char> na ɔhwɛ nʼanammɔntuo.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Ɔhene anomu kasa te sɛ nkɔmhyɛ,</para>
  <para style="q2" vid="PRO 16:10">enti ɛnsɛ sɛ nʼano ka deɛ ɛnyɛ atɛntenenee.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Nsania ne abrammoɔ a nsisie nni mu firi <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PRO 16:11">nkariboɔ a ɛwɔ kotokuo mu no, ɔno na ɔyɛeɛ.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Ahemfo kyiri bɔneyɛ,</para>
  <para style="q2" vid="PRO 16:12">ɛfiri sɛ ahennwa si tenenee so.<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Ahemfo ani sɔ ano a ɛka nokorɛ;</para>
  <para style="q2" vid="PRO 16:13">na wɔbu onipa a ɔka nokorɛ.<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Ɔhene abufuhyeɛ yɛ owuo somafoɔ,</para>
  <para style="q2" vid="PRO 16:14">nanso onyansafoɔ bɛdwodwo ano.<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Sɛ ɔhene anim te a, ɛyɛ nkwa,</para>
  <para style="q2" vid="PRO 16:15">nʼadom te sɛ osutɔberɛ mu osumuna.<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>Ɛyɛ sɛ wobɛnya nyansa sene sɛ wobɛnya sikakɔkɔɔ,</para>
  <para style="q2" vid="PRO 16:16">sɛ wobɛnya nhunumu sene sɛ wobɛnya dwetɛ!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>Ɔteneneeni kwantempɔn kwati bɔne;</para>
  <para style="q2" vid="PRO 16:17">deɛ ɔhwɛ nʼakwan yie no bɔ ne nkwa ho ban.<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Ahantan di ɔsɛeɛ anim,</para>
  <para style="q2" vid="PRO 16:18">na ahomasoɔ honhom nso di ahweaseɛ anim.<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Ɛyɛ sɛ wobɛyɛ honhom mu hiani wɔ wɔn a wɔhyɛ wɔn so mu</para>
  <para style="q2" vid="PRO 16:19">sene sɛ wo ne ahantanfoɔ bɛkyɛ afodeɛ.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Deɛ ɔyɛ ɔsetie ma nkyerɛkyerɛ no nya nkɔsoɔ;</para>
  <para style="q2" vid="PRO 16:20">nhyira nka deɛ ɔde ne ho to <char style="nd">Awurade</char> so.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>Wɔfrɛ akoma mu anyansafoɔ sɛ nhunumufoɔ,</para>
  <para style="q2" vid="PRO 16:21">na kasa pa ma nkyerɛkyerɛ kɔ so.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Nteaseɛ yɛ nkwa nsutire ma wɔn a wɔwɔ bi,</para>
  <para style="q2" vid="PRO 16:22">nanso agyimisɛm de asotweɛ brɛ nkwaseafoɔ.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>Onyansafoɔ akoma kyerɛ nʼano kwan,</para>
  <para style="q2" vid="PRO 16:23">na nʼanofafa ma nkyerɛkyerɛ kɔ so.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>Abodwosɛm te sɛ ɛwokyɛm</para>
  <para style="q2" vid="PRO 16:24">ɛyɛ ɔkra dɛ, na ɛsa nnompe yadeɛ.<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>Ɛkwan bi wɔ hɔ a ɛyɛ wɔ onipa ani so,</para>
  <para style="q2" vid="PRO 16:25">nanso ɛkɔwie owuo mu.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>Odwumayɛfoɔ akɔnnɔ ma no yɛ adwuma den;</para>
  <para style="q2" vid="PRO 16:26">ɛfiri sɛ ɔpɛ sɛ ɔkum ne kɔm.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Ohuhuni bɔ pɔ bɔne,</para>
  <para style="q2" vid="PRO 16:27">ne kasa te sɛ egyadɛreɛ a ɛhye adeɛ.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Onipa kɔntɔnkye de mpaapaemu ba,</para>
  <para style="q2" vid="PRO 16:28">na osekuni tete nnamfonom ntam.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Basabasayɛni daadaa ne yɔnko</para>
  <para style="q2" vid="PRO 16:29">na ɔde no fa ɛkwammɔne so.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Deɛ ɔbu nʼani no redwene bɔneyɛ ho;</para>
  <para style="q2" vid="PRO 16:30">na deɛ ɔmua nʼano no ani wɔ bɔne so.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Ɛdwono yɛ animuonyam abotire;</para>
  <para style="q2" vid="PRO 16:31">tenenee mu asetena na ɛde ba.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Deɛ ɔwɔ abodwokyerɛ no yɛ sene ɔkofoɔ,</para>
  <para style="q2" vid="PRO 16:32">na deɛ ɔmfa abufuo yɛ sene deɛ ɔko fa kuropɔn.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Wɔtwe ntonto de hwehwɛ deɛ <char style="nd">Awurade</char> pɛ,</para>
  <para style="q2" vid="PRO 16:33">nanso ne gyinasie biara firi <char style="nd">Awurade</char>.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Aduane mmɔwe a asomdwoeɛ wɔ ho</para>
  <para style="q2" vid="PRO 17:1">yɛ sene efie a apontoɔ ahyɛ no ma a nso basabasayɛ wɔ mu.<verse eid="PRO 17:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Ɔsomfoɔ nyansafoɔ bɛdi ɔba nimguasefoɔ so,</para>
  <para style="q2" vid="PRO 17:2">na ɔbɛnya ne kyɛfa wɔ agyapadeɛ no mu sɛ anuanom no mu baako.<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Kyɛmferɛ wɔ hɔ ma dwetɛ na fononoo wɔ hɔ ma sikakɔkɔɔ</para>
  <para style="q2" vid="PRO 17:3">nanso <char style="nd">Awurade</char> na ɔsɔ akoma hwɛ.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Omumuyɛfoɔ tie nsusuiɛ bɔne;</para>
  <para style="q2" vid="PRO 17:4">ɔtorofoɔ yɛ aso ma adwen bɔne tɛkrɛma.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Deɛ ɔdi ahiafoɔ ho fɛ no bu wɔn Yɛfoɔ animtiaa;</para>
  <para style="q2" vid="PRO 17:5">na deɛ ɔfoa amanehunu soɔ no bɛnya asotwe.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Mmanananom yɛ mmasiriwa animuonyam,</para>
  <para style="q2" vid="PRO 17:6">na awofoɔ yɛ wɔn mma ahohoahoa.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Anokrokro nyɛ mma ɔkwasea,</para>
  <para style="q2" vid="PRO 17:7">saa ara na ano a ɛdi torɔ mfata ɔhene.<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Kɛtɛasehyɛ daadaa deɛ ɔma;</para>
  <para style="q2" vid="PRO 17:8">ɔgye sɛ ɛbɛma no nkonim.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Deɛ ɔbu nʼani gu mfomsoɔ so no ma ɔdɔ ɛkwan,</para>
  <para style="q2" vid="PRO 17:9">na deɛ ɔbɔ soɔ no tete nnamfonom ntam.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Nkaanim sɔ onipa a ɔwɔ nhunumu ani</para>
  <para style="q2" vid="PRO 17:10">sene mmaa ɔha a wɔbɔ ɔkwasea.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Onipa bɔnefoɔ ani wɔ atuateɛ nko ara so</para>
  <para style="q2" vid="PRO 17:11">na wɔbɛsoma odwumayɛfoɔ tirimuɔdenfoɔ akɔ ne so.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Ɛyɛ sɛ wobɛhyia sisire a wɔawia ne mma</para>
  <para style="q2" vid="PRO 17:12">sene ɔkwasea a ɔregyimie.<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Sɛ obi de bɔne tua papa so ka a,</para>
  <para style="q2" vid="PRO 17:13">bɔne rempa ne fie da.<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Ntɔkwa ahyɛaseɛ te sɛ deɛ wɔretue suka;</para>
  <para style="q2" vid="PRO 17:14">enti gyae ma ɛnka na ankɔfa ɔham amma.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>Sɛ wɔbɛgyaa deɛ ɔdi fɔ ne sɛ wɔbɛbu deɛ ɔdi bem kumfɔ no,</para>
  <para style="q2" vid="PRO 17:15">
    <char style="nd">Awurade</char> kyiri ne mmienu.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Sika a ɛwɔ ɔkwasea nsam ho nni mfasoɔ,</para>
  <para style="q2" vid="PRO 17:16">ɛfiri sɛ ɔnni botaeɛ biara sɛ ɔbɛhunu nyansa.<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Adamfo kyerɛ ɔdɔ ɛberɛ nyinaa mu,</para>
  <para style="q2" vid="PRO 17:17">wɔwo onua barima ma ahokyere berɛ.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Obi a ɔnni adwene no na ɔde ne nsa hyɛ krataa ase di akagyinamu</para>
  <para style="q2" vid="PRO 17:18">nam so de si awowa ma ne yɔnko.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Deɛ ɔpɛ ntɔkwa no dɔ bɔne;</para>
  <para style="q2" vid="PRO 17:19">deɛ ɔsi ɛpono tentene no frɛfrɛ ɔsɛeɛ.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Onipa a ɔwɔ akoma kontonkyi no nnya nkɔsoɔ;</para>
  <para style="q2" vid="PRO 17:20">deɛ ne tɛkrɛma daadaa no tɔ amaneɛ mu.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Deɛ ɔwo ɔba kwasea no di awerɛhoɔ;</para>
  <para style="q2" vid="PRO 17:21">ɔba kwasea agya nni anigyeɛ.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Akoma mu anigyeɛ yɛ aduro ɛsa yadeɛ,</para>
  <para style="q2" vid="PRO 17:22">nanso honhom a apɛkyɛ no wewe nnompe.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Omumuyɛfoɔ gye adanmudeɛ wɔ esum ase</para>
  <para style="q2" vid="PRO 17:23">de kyea atɛntenenee.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Onipa a ɔwɔ nhunumu no ani kɔ nyansa so,</para>
  <para style="q2" vid="PRO 17:24">na ɔkwasea toto nʼani kɔsi asase ano.<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Ɔba kwasea hyɛ nʼagya awerɛhoɔ,</para>
  <para style="q2" vid="PRO 17:25">na ɔma deɛ ɔnyinsɛnee no no di yea.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Ɛnyɛ sɛ wɔtwe deɛ ɔdi bem aso,</para>
  <para style="q2" vid="PRO 17:26">anaasɛ wɔtwa adwumayɛfoɔ mmaa wɔ wɔn nokorɛdie enti.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Ɔnimdefoɔ dwene nʼanom kasa ho,</para>
  <para style="q2" vid="PRO 17:27">na deɛ ɔwɔ nhunumu no wɔ abodwoɔ.<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>Mpo sɛ ɔkwasea yɛ dinn a wɔbu no sɛ ɔnyansafoɔ,</para>
  <para style="q2" vid="PRO 17:28">na sɛ ɔmua nʼano a wɔbu no sɛ ɔwɔ nhunumu.<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Ɔhonankani yɛ pɛsɛmenkomenya;</para>
  <para style="q2" vid="PRO 18:1">na ɔmfa atɛntenenee nyɛ hwee.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Ɔkwasea nni nhunumu ho anigyeɛ</para>
  <para style="q2" vid="PRO 18:2">na mmom deɛ ɔpɛ ara ne sɛ ɔde nʼadwene bɛto dwa.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Sɛ amumuyɛsɛm ba a animtiabuo di so,</para>
  <para style="q2" vid="PRO 18:3">na aniwuo nso di animguaseɛ akyi.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Onipa anom nsɛm yɛ nsuo a emu dɔ,</para>
  <para style="q2" vid="PRO 18:4">na nyansa asutire yɛ asuwa a ɛrepu ahuro.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Ɛnyɛ sɛ wɔdi ma omumuyɛfoɔ</para>
  <para style="q2" vid="PRO 18:5">anaasɛ wɔbu deɛ ɔdi bem atɛnkyea.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Ɔkwasea ano de akasakasa ba</para>
  <para style="q2" vid="PRO 18:6">na nʼano frɛfrɛ ɔhweɛ.<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Ɔkwasea ano yɛ ɔno ara sɛeɛ</para>
  <para style="q2" vid="PRO 18:7">na nʼanofafa yɛ ne kra afidie.<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Osekuni anom asɛm te sɛ mfremfremadeɛ;</para>
  <para style="q2" vid="PRO 18:8">ɛwurawura kɔ onipa akwaa mu nyinaa.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Deɛ ɔtoto nʼadwuma ase no</para>
  <para style="q2" vid="PRO 18:9">nuabarima ne deɛ ɔyɛ ɔsɛefoɔ.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>
    <char style="nd">Awurade</char> din yɛ abantenten a ɛyɛ den;</para>
  <para style="q2" vid="PRO 18:10">ahotefoɔ dwane kɔtoa na wɔnya banbɔ.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Adefoɔ ahonyadeɛ ne wɔn kuropɔn a wɔabɔ ho ban</para>
  <para style="q2" vid="PRO 18:11">wɔfa no sɛ ɔfasuo tenten a wɔntumi mforo.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>Ansa na onipa bɛhwe ase no ɔnya ahomasoɔ akoma,</para>
  <para style="q2" vid="PRO 18:12">na ahobrɛaseɛ di animuonyam anim.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Deɛ ɔntie asɛm ansa na wama mmuaeɛ no,</para>
  <para style="q2" vid="PRO 18:13">ɛno ne ne gyimie ne nʼanimguaseɛ.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Onipa sunsum na ɛhyɛ no den wɔ yadeɛ mu</para>
  <para style="q2" vid="PRO 18:14">na honhom a apɛkyɛ deɛ, hwan na ɔpɛ?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>Nhunumu akoma nya nimdeɛ;</para>
  <para style="q2" vid="PRO 18:15">na anyansafoɔ aso nso hwehwɛ.<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>Akyɛdeɛ bue ɛkwan ma deɛ ɔde ma</para>
  <para style="q2" vid="PRO 18:16">na ɛde no ba atitire anim.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Ɛyɛ deɛ ɔbɔ ne nkuro kane no sɛ nʼasɛm yɛ dɛ,</para>
  <para style="q2" vid="PRO 18:17">kɔsi sɛ ɔfoforɔ bɛba abɛbisa no nsɛm no mu.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>Ntontobɔ twa akyinnyegyeɛ so,</para>
  <para style="q2" vid="PRO 18:18">na ɛpata atamfoɔ.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Onua a wɔafom noɔ no asɛm yɛ dene sene kuropɔn a ɛwɔ banbɔ,</para>
  <para style="q2" vid="PRO 18:19">akyinnyegyeɛ te sɛ abankɛsewa apono a wɔabram akyire.<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Onipa anom asɛm so aba ma ɔyafunu mee,</para>
  <para style="q2" vid="PRO 18:20">nnɔbaeɛ a nʼanofafa twa no mee no.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>Tɛkrɛma kura nkwa ne owuo tumi,</para>
  <para style="q2" vid="PRO 18:21">na wɔn a wɔdɔ no no bɛdi nʼaba.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Deɛ wanya yere no anya adepa</para>
  <para style="q2" vid="PRO 18:22">na ɔnya adom firi <char style="nd">Awurade</char> hɔ.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>Ohiani srɛ ahummɔborɔ,</para>
  <para style="q2" vid="PRO 18:23">nanso ɔdefoɔ de kasaden bua no.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Ɔbarima a ne nnamfonom dɔɔso bɛtumi ahwe ase,</para>
  <para style="q2" vid="PRO 18:24">nanso adamfo bi wɔ hɔ a ɔbɛfam ne ho asene onua.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>Ohiani a ne nanteɛ ho nni asɛm no</para>
  <para style="q2" vid="PRO 19:1">yɛ sene ɔkwasea a nʼasɛm mfa ɛkwan mu.<verse eid="PRO 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Mmɔdemmɔ a nimdeɛ nka ho no nyɛ,</para>
  <para style="q2" vid="PRO 19:2">saa ara na ntɛmpɛ a ɛma obi yera ɛkwan nso nyɛ.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Onipa agyimisɛm sɛe nʼabrabɔ,</para>
  <para style="q2" vid="PRO 19:3">nanso nʼakoma huru tia <char style="nd">Awurade</char>.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>Ahonya frɛfrɛ nnamfonom bebree;</para>
  <para style="q2" vid="PRO 19:4">nanso ohiani adamfo gya no hɔ.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Adansekurumni bɛnya nʼakatua,</para>
  <para style="q2" vid="PRO 19:5">na deɛ ɔtwa nkontompo remfa ne ho nni.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>Nnipa pii pɛ adom firi sodifoɔ nkyɛn,</para>
  <para style="q2" vid="PRO 19:6">na deɛ ɔkyɛ adeɛ yɛ obiara adamfo.<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Ohiani abusuafoɔ nyinaa po no,</para>
  <para style="q2" vid="PRO 19:7">na saa ara na ne nnamfonom po no!</para>
  <para style="q1" vid="PRO 19:7">Mpo ɔhwehwɛ wɔn pɛ sɛ ɔpa wɔn kyɛw,</para>
  <para style="q2" vid="PRO 19:7">nanso ɔnhunu wɔn baabiara.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Deɛ ɔnya nyansa no dɔ ne kra;</para>
  <para style="q2" vid="PRO 19:8">deɛ ɔpɛ nhunumu no nya nkɔsoɔ.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Adansekurumni bɛnya asotwe,</para>
  <para style="q1" vid="PRO 19:9">na deɛ ɔtwa nkontompo no bɛyera.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Akɛsesɛm mfata ɔkwasea,</para>
  <para style="q2" vid="PRO 19:10">anaasɛ akoa bɛdi mmapɔmma so!<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Onipa nyansa ma no ntoboaseɛ;</para>
  <para style="q2" vid="PRO 19:11">sɛ ɔbu nʼani gu mfomsoɔ bi so a ɛhyɛ no animuonyam.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>Ɔhene abufuo te sɛ gyata mmobom,</para>
  <para style="q2" vid="PRO 19:12">na nʼadom te sɛ ɛserɛ so bosuo.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Ɔba kwasea yɛ nʼagya ɔsɛeɛ,</para>
  <para style="q2" vid="PRO 19:13">ɔyere ntɔkwapɛfoɔ te sɛ nsusosɔ a ɛntwa da.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Afie ne ahonyadeɛ yɛ agyapadeɛ a ɛfiri awofoɔ,</para>
  <para style="q2" vid="PRO 19:14">na ɔyere nimdefoɔ firi <char style="nd">Awurade</char>.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>Akwadworɔ de nnahɔɔ ba,</para>
  <para style="q2" vid="PRO 19:15">na ɛkɔm de ɔkwadwofoɔ.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Deɛ ɔdi nkyerɛkyerɛ so no bɔ ne nkwa ho ban,</para>
  <para style="q2" vid="PRO 19:16">na deɛ ɔgyaagyaa ne ho no bɛwu.<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Deɛ ɔyɛ adɔeɛ ma ohiani no yɛ de fɛm <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PRO 19:17">na ɔbɛtua no deɛ ɔyɛ no so ka.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>Tene wo ba, na ɛno mu na anidasoɔ wɔ,</para>
  <para style="q2" vid="PRO 19:18">na ɛnyɛ wɔn a wɔde no kɔ owuo mu no mu baako.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Ɛsɛ sɛ onipa a nʼakoma ha no no tua so ka;</para>
  <para style="q2" vid="PRO 19:19">sɛ woka ma no a wobɛyɛ bio.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Tie afotuo na gye nkyerɛkyerɛ to mu,</para>
  <para style="q2" vid="PRO 19:20">na awieeɛ no, wobɛhunu nyansa.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Nhyehyɛeɛ bebree wɔ onipa akoma mu,</para>
  <para style="q2" vid="PRO 19:21">nanso deɛ <char style="nd">Awurade</char> pɛ no na ɛba mu.<verse eid="PRO 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Deɛ onipa pɛ ne nokorɛ dɔ;</para>
  <para style="q2" vid="PRO 19:22">ɛyɛ sɛ wobɛyɛ ohiani sene sɛ wobɛyɛ ɔtorofoɔ.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>
    <char style="nd">Awurade</char> suro kɔ nkwa mu;</para>
  <para style="q2" vid="PRO 19:23">na onipa de abotɔyam home a ɔhaw bi nni mu.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Ɔkwadwofoɔ nsa ka ayowaa mu</para>
  <para style="q2" vid="PRO 19:24">na ɔremma so mpo nkɔ nʼano!<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Twa ɔfɛdifoɔ mmaa, na atetekwaa bɛfa adwene;</para>
  <para style="q2" vid="PRO 19:25">ka deɛ ɔwɔ nhunumu anim, na ɔbɛnya nimdeɛ.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Deɛ ɔbɔ nʼagya korɔno na ɔpamo ne maame no</para>
  <para style="q2" vid="PRO 19:26">yɛ ɔba a ɔde aniwuo ne animguaseɛ ba.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Me ba, sɛ wogyae nkyerɛkyerɛ tie a,</para>
  <para style="q2" vid="PRO 19:27">wobɛmane afiri nimdeɛ nsɛm ho.<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Adansekurumni di atɛntenenee ho fɛw;</para>
  <para style="q2" vid="PRO 19:28">na omumuyɛfoɔ ano mene bɔne.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Wɔasiesie asotwe ama fɛdifoɔ,</para>
  <para style="q2" vid="PRO 19:29">ne mmaabɔ ama nkwaseafoɔ akyi.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Nsa yɛ ɔfɛdifoɔ na nsaden yɛ ntɔkwapɛfoɔ;</para>
  <para style="q2" vid="PRO 20:1">na obiara a nsã bɛma wafom ɛkwan no nnyɛ onyansafoɔ.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Ɔhene abufuhyeɛ te sɛ gyata mmobom;</para>
  <para style="q2" vid="PRO 20:2">na deɛ ɔhyɛ no abufuo no de nkwa twa so.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>Ɛyɛ onipa animuonyam sɛ ɔbɛkwati akasakasa,</para>
  <para style="q2" vid="PRO 20:3">nanso ogyimifoɔ biara pɛ ntɔkwa.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Onihafoɔ mfuntum nʼasase wɔ ne berɛ mu;</para>
  <para style="q2" vid="PRO 20:4">enti ɛduru twaberɛ a ɔnnya hwee.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Onipa akoma apɛdeɛ yɛ subunu mu,</para>
  <para style="q2" vid="PRO 20:5">nanso onipa a ɔwɔ nhunumu no twetwe.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Nnipa dodoɔ no ara ka sɛ wɔwɔ ɔdɔ a ɛnsa da,</para>
  <para style="q2" vid="PRO 20:6">na hwan na ɔbɛtumi ahunu ɔnokwafoɔ?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Ɔteneneeni bu ɔbra kronkron;</para>
  <para style="q2" vid="PRO 20:7">nhyira ne ne mma a wɔba nʼakyi.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>Sɛ ɔhene tena nʼahennwa so bu atɛn a,</para>
  <para style="q2" vid="PRO 20:8">ɔde nʼani huhu bɔne nyinaa so gu.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>Hwan na ɔbɛtumi aka sɛ, “Mapra mʼakoma mu;</para>
  <para style="q2" vid="PRO 20:9">meyɛ kronn na menni bɔne”?<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>Nkariboɔ ne susudua a ɛnyɛ papa no</para>
  <para style="q2" vid="PRO 20:10">
    <char style="nd">Awurade</char> kyiri ne mmienu.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>Mpo wɔnam abɔfra nneyɛɛ so hunu no,</para>
  <para style="q2" vid="PRO 20:11">sɛ ne suban yɛ kronn ne papa.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>Aso a wɔde te asɛm ne ani a wɔde hunu adeɛ,</para>
  <para style="q2" vid="PRO 20:12">
    <char style="nd">Awurade</char> na wayɛ ne mmienu.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>Mma nna nyɛ wo dɛ, na woanni hia;</para>
  <para style="q2" vid="PRO 20:13">ɛnna, na wobɛnya aduane ama abu so.<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>Ɔtɔfoɔ ka sɛ, “Ɛnyɛ, ɛnyɛ!”</para>
  <para style="q2" vid="PRO 20:14">nanso sɛ ɔkɔ a, ɔde deɛ watɔ no hoahoa ne ho.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Sika kɔkɔɔ wɔ hɔ, na nhwenepa nso abu so,</para>
  <para style="q2" vid="PRO 20:15">na ano a ɛka nimdeɛ nsɛm yɛ ɔbohemaa a ɛho yɛ nna.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Fa obi a ɔdi ɔhɔhoɔ akagyinamu atadeɛ;</para>
  <para style="q2" vid="PRO 20:16">sɛ ɔregyina ɔbaa huhufoɔ akyi a, fa si awowa.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>Aduane a wɔnya no ɛkwan bɔne so no yɛ onipa anomu dɛ,</para>
  <para style="q2" vid="PRO 20:17">nanso akyire no ɛdane mmosea wɔ nʼanom.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Pɛ afotuo yɛ wo nhyehyɛeɛ;</para>
  <para style="q2" vid="PRO 20:18">sɛ wotu ɔsa a, nya ho akwankyerɛ.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Osekuni da kokoamsɛm adi;</para>
  <para style="q2" vid="PRO 20:19">enti twe wo ho firi onipa a ɔkasa bebree ho.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Sɛ obi dome nʼagya anaasɛ ne maame a,</para>
  <para style="q2" vid="PRO 20:20">wɔbɛdum ne kanea wɔ esum kabii mu.<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Agyapadeɛ a wɔpere ho nya no ahyɛaseɛ no</para>
  <para style="q2" vid="PRO 20:21">renyɛ nhyira akyire no.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>Nka sɛ, “Mɛtua wo saa bɔne yi so ka!”</para>
  <para style="q2" vid="PRO 20:22">Twɛn <char style="nd">Awurade</char>, na ɔbɛgye wo.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>
    <char style="nd">Awurade</char> kyiri nkariboɔ a ɛnyɛ papa,</para>
  <para style="q2" vid="PRO 20:23">na nsisie nsania nso nsɔ nʼani.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>
    <char style="nd">Awurade</char> na ɔkyerɛ onipa anammɔntuo.</para>
  <para style="q2" vid="PRO 20:24">Na ɛbɛyɛ dɛn na obi bɛte nʼankasa akwan ase?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>Obi pɛ ntɛm hyɛ bɔ, ansa na wadwene ho a,</para>
  <para style="q2" vid="PRO 20:25">ɔsum ne ho afidie.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Ɔhene nyansafoɔ hunu amumuyɛfoɔ;</para>
  <para style="q2" vid="PRO 20:26">na ɔde ayuyamfidie hankra fa wɔn so.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>
    <char style="nd">Awurade</char> kanea hwehwɛ onipa honhom mu,</para>
  <para style="q2" vid="PRO 20:27">ɛhwehwɛ ne mu baabiara.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Ɔdɔ ne nokorɛdie bɔ ɔhene ho ban;</para>
  <para style="q2" vid="PRO 20:28">nʼadɔeɛ ma nʼahennwa tim.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Mmeranteɛ animuonyam ne wɔn ahoɔden,</para>
  <para style="q2" vid="PRO 20:29">tidwono nso ne mmasiriwa animuonyam.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>Ɔhweɛ ne apirakuro hohoro amumuyɛ</para>
  <para style="q2" vid="PRO 20:30">mmaaka te akoma mu.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Ɔhene akoma da <char style="nd">Awurade</char> nsam;</para>
  <para style="q2" vid="PRO 21:1">ɔkyerɛ no ɛkwan te sɛ asutene ma ɔkɔ baabiara a ɔpɛ.<verse eid="PRO 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Onipa akwan nyinaa tene wɔ nʼani so,</para>
  <para style="q2" vid="PRO 21:2">nanso <char style="nd">Awurade</char> na ɔkari akoma.<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>Sɛ woyɛ adepa ne adeɛ a ɛtene a</para>
  <para style="q2" vid="PRO 21:3">ɛsɔ <char style="nd">Awurade</char> ani sene afɔrebɔ.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Ani a ɛtra ntɔn ne ahomasoɔ akoma,</para>
  <para style="q2" vid="PRO 21:4">ne amumuyɛfoɔ asetena nyinaa yɛ bɔne!<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Nsiyɛfoɔ nhyehyɛeɛ de mfasoɔ ba</para>
  <para style="q2" vid="PRO 21:5">sɛdeɛ ntɛmpɛ kɔwie ohia no.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Ahonya a nkontompo tɛkrɛma de ba no</para>
  <para style="q2" vid="PRO 21:6">yɛ huhuro ne owuo afidie.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Amumuyɛfoɔ basabasayɛ bɛtwe wɔn akɔ,</para>
  <para style="q2" vid="PRO 21:7">ɛfiri sɛ wɔmpɛ sɛ wɔyɛ deɛ ɛtene.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Onipa a ɔdi fɔ no akwan yɛ kɔntɔnkye,</para>
  <para style="q2" vid="PRO 21:8">na deɛ ne ho nni asɛm no adeyɛ tene.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Suhyɛ twɛtwɛwa ase baabi tena</para>
  <para style="q2" vid="PRO 21:9">yɛ sene sɛ wo ne ɔyere ntɔkwapɛfoɔ bɛtena efie.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Omumuyɛfoɔ kɔn dɔ bɔne;</para>
  <para style="q2" vid="PRO 21:10">ɔnni ahummɔborɔ mma ne yɔnko.<verse eid="PRO 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Sɛ wɔtwe fɛdifoɔ aso a, ntetekwaafoɔ hunu nyansa,</para>
  <para style="q2" vid="PRO 21:11">sɛ wɔkyerɛkyerɛ onyansafoɔ a, ɔnya nimdeɛ.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Ɔteneneeni no nim deɛ ɛrekɔso wɔ omumuyɛfoɔ fie</para>
  <para style="q2" vid="PRO 21:12">na ɔde omumuyɛfoɔ no kɔ ɔsɛeɛ mu.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Sɛ onipa sisi nʼaso wɔ mmɔborɔni su ho a</para>
  <para style="q2" vid="PRO 21:13">ɔno nso bɛsu afrɛ, na wɔrennye no so.<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Kokoam adekyɛ dwodwo akoma,</para>
  <para style="q2" vid="PRO 21:14">kɛtɛasehyɛ nso pata abufuhyeɛ.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Sɛ wobu atɛntenenee a, teneneefoɔ anigye</para>
  <para style="q2" vid="PRO 21:15">nanso ɛyɛ ahunahuna ma abɔnefoɔ.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Onipa a ɔmane firi nhunumu kwan soɔ no</para>
  <para style="q2" vid="PRO 21:16">bɛhome wɔ awufoɔ fekuo mu.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Deɛ ɔdi ahosɛpɛ akyi no bɛyɛ ohiani;</para>
  <para style="q2" vid="PRO 21:17">deɛ ɔpɛ nsã ne ngo no rennya ne ho da.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Amumuyɛfoɔ de wɔn nkwa to hɔ ma teneneefoɔ,</para>
  <para style="q2" vid="PRO 21:18">na atorofoɔ yɛ saa ma wɔn a wɔyɛ pɛ.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>Ɛyɛ sɛ wobɛtena ɛserɛ so,</para>
  <para style="q2" vid="PRO 21:19">sene sɛ wo ne ɔyere ntɔkwapɛfoɔ a nʼakoma ha no bɛtena.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Nnuane pa ne ngo ayɛ onyansafoɔ fie ma,</para>
  <para style="q2" vid="PRO 21:20">nanso ɔkwasea di deɛ ɔwɔ nyinaa.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Deɛ ɔti tenenee ne ɔdɔ no</para>
  <para style="q2" vid="PRO 21:21">ɔnya nkwa, yiedie ne animuonyam.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Onyansafoɔ to hyɛ ahoɔdenfoɔ kuropɔn so</para>
  <para style="q2" vid="PRO 21:22">na ɔdwiri abandenden a wɔn werɛ hyɛ mu gu fam.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Deɛ ɔkora nʼano ne ne tɛkrɛma no</para>
  <para style="q2" vid="PRO 21:23">ɔtwe ne ho firi amanenya ho.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>Ɔhantanni a ɔma ne ho so no, ne din ne “Ɔfɛdifoɔ”</para>
  <para style="q2" vid="PRO 21:24">ɔde ahantan ntrasoɔ yɛ adeɛ.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Deɛ ɔkwadwofoɔ kɔn dɔ no bɛyɛ owuo ama no,</para>
  <para style="q2" vid="PRO 21:25">ɛfiri sɛ ne nsa mpɛ adwumayɛ.<verse eid="PRO 21:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Ɛda mu nyinaa ɔpere sɛ ɔbɛnya bebree,</para>
  <para style="q2" vid="PRO 21:26">nanso ɔteneneeni deɛ, ɔma a ɔnnodo ho.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Omumuyɛfoɔ afɔrebɔ yɛ akyiwadeɛ,</para>
  <para style="q2" vid="PRO 21:27">ne titire ne sɛ ɔde adwemmɔne bata ho.<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Adansekurumdini bɛyera,</para>
  <para style="q2" vid="PRO 21:28">na obiara a ɔtie noɔ no nso wɔbɛsɛe no.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Amumuyɛfoɔ di akakabensɛm</para>
  <para style="q2" vid="PRO 21:29">na ɔteneneeni deɛ, ɔdwene nʼakwan ho.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>Nyansa, nhunumu ne nhyehyɛeɛ biara nni hɔ a</para>
  <para style="q2" vid="PRO 21:30">ɛbɛtumi ayɛ yie atia <char style="nd">Awurade</char>.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Wɔsiesie apɔnkɔ ma ɔko da,</para>
  <para style="q2" vid="PRO 21:31">nanso nkonimdie yɛ <char style="nd">Awurade</char> dea.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Edin pa yɛ sene ahonya bebrebe;</para>
  <para style="q2" vid="PRO 22:1">sɛ wɔbɛdi wo ni yɛ sene dwetɛ anaa sikakɔkɔɔ.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Ɔdefoɔ ne ohiani wɔ adeɛ baako,</para>
  <para style="q2" vid="PRO 22:2">
    <char style="nd">Awurade</char> ne wɔn nyinaa Yɛfoɔ.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Onitefoɔ hunu amanehunu a ɛreba na ɔhinta ne ho,</para>
  <para style="q2" vid="PRO 22:3">nanso atetekwaa kɔ nʼanim kɔnya amane.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Ahobrɛaseɛ ne <char style="nd">Awurade</char> suro</para>
  <para style="q2" vid="PRO 22:4">ma ahonya ne animuonyam ne nkwa.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>Nkasɛɛ ne mfidie wɔ amumuyɛfoɔ akwan so,</para>
  <para style="q2" vid="PRO 22:5">nanso deɛ ɔbɔ ne kra ho ban no mmɛn ho.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Kyerɛ abɔfra ɛkwan a ɔmfa so,</para>
  <para style="q2" vid="PRO 22:6">na sɛ ɔnyini a ɔremfiri so.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>Adefoɔ di ahiafoɔ so,</para>
  <para style="q2" vid="PRO 22:7">na boseagyeni yɛ deɛ ɔde fɛm ɔsomfoɔ.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Deɛ ɔdua amumuyɛsɛm no twa ɔhaw</para>
  <para style="q2" vid="PRO 22:8">na wɔbɛsɛe nʼabufuhyeɛ abaa.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Ɔyamyɛfoɔ bɛnya nhyira</para>
  <para style="q2" vid="PRO 22:9">ɛfiri sɛ ɔne ahiafoɔ kyɛ nʼaduane.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>Pam ɔfɛdifoɔ na basabasayɛ nso bɛkɔ;</para>
  <para style="q2" vid="PRO 22:10">ntɔkwa ne atɛnnidie to atwa.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Obi a ɔdɔ akoma a emu teɛ na ne kasa ho yɛ nyam</para>
  <para style="q2" vid="PRO 22:11">bɛnya ɔhene afa no adamfo.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>
    <char style="nd">Awurade</char> ani wɛn nimdeɛ,</para>
  <para style="q2" vid="PRO 22:12">na ɔsɛe ɔtorofoɔ nsɛm.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>Ɔkwadwofoɔ ka sɛ, “Gyata bi wɔ mfikyire hɔ!”</para>
  <para style="q2" vid="PRO 22:13">anaasɛ, “Wɔbɛkum me wɔ mmɔntene so.”<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Ɔbaa waresɛefoɔ anomu yɛ amena donkudonku;</para>
  <para style="q2" vid="PRO 22:14">deɛ ɔhyɛ <char style="nd">Awurade</char> abufuo ase no bɛtɔ mu.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Agyimisɛm kyekyere abɔfra akoma ho,</para>
  <para style="q2" vid="PRO 22:15">nanso ntenesoɔ abaa bɛpamo akɔ akyiri.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Obi bɛsisi ohiani de apɛ ahonya</para>
  <para style="q2" vid="PRO 22:16">anaa ɔbɛkyɛ ɔdefoɔ adeɛ, ne nyinaa de no kɔ ohia mu.<verse eid="PRO 22:16"/></para>
  <para style="s1">Anyansasɛm</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>Yɛ aso na tie anyansasɛm yi;</para>
  <para style="q2" vid="PRO 22:17">fa wʼakoma di me nkyerɛkyerɛ akyi,<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>ɛfiri sɛ ɛyɛ sɛ wokora saa nsɛm yi wɔ wʼakoma mu,</para>
  <para style="q2" vid="PRO 22:18">na ne nyinaa ada wʼano.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Sɛdeɛ wode wo ho bɛto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PRO 22:19">merekyerɛkyerɛ wo ɛnnɛ, aane wo.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>Mentwerɛɛ mmɛ aduasa mmaa wo,</para>
  <para style="q2" vid="PRO 22:20">deɛ ɛyɛ afotusɛm ne nimdeɛ,<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>a ɛkyerɛkyerɛ wo nokorɛ ne deɛ akyinnyeɛ nni ho,</para>
  <para style="q2" vid="PRO 22:21">sɛdeɛ wobɛnya mmuaeɛ pa ama deɛ ɔsomaa woɔ no anaa?<verse eid="PRO 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Mmɔ ahiafoɔ korɔno, sɛ wɔyɛ ahiafoɔ enti,</para>
  <para style="q2" vid="PRO 22:22">na nnsisi wɔn a wɔnni bie wɔ asɛnniiɛ,<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>ɛfiri sɛ <char style="nd">Awurade</char> bɛdi wɔn asɛm ama wɔn</para>
  <para style="q2" vid="PRO 22:23">na wafom afa wɔn a wɔfom ahiafoɔ fa.<verse eid="PRO 22:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Mfa obi a ne bo ha no adamfo,</para>
  <para style="q2" vid="PRO 22:24">na mmfa wo ho mmɔ deɛ ne bo nkyɛre fu,<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>anyɛ saa a, wobɛsua nʼakwan</para>
  <para style="q2" vid="PRO 22:25">na woakɔtɔ afidie mu.<verse eid="PRO 22:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Ɛnyɛ deɛ ɔde ne nsa hyɛ krataa ase di agyinamu,</para>
  <para style="q2" vid="PRO 22:26">anaasɛ deɛ ɔdi akagyinamu;<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>na sɛ wonni deɛ wɔde tua a</para>
  <para style="q2" vid="PRO 22:27">wɔbɛhwan wo mpa mpo afiri wʼase.<verse eid="PRO 22:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>Ntutu tete aboɔ a wɔde ato hyeɛ;</para>
  <para style="q2" vid="PRO 22:28">deɛ wo nananom de sisii hɔ no.<verse eid="PRO 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Wohunu odwumayɛfoɔ a ne nsa akokwa nʼadwuma ho anaa?</para>
  <para style="q2" vid="PRO 22:29">Ahemfo anim na ɔbɛsom,</para>
  <para style="q2" vid="PRO 22:29">na ɔrensom wɔ mpapahwekwaa anim.<verse eid="PRO 22:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Sɛ wo ne ɔhene bi to nsa didi a,</para>
  <para style="q2" vid="PRO 23:1">hwɛ deɛ ɛsi wʼanim no yie,<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>Sɛ woyɛ adidibrada a,</para>
  <para style="q2" vid="PRO 23:2">hyɛ wo ho so.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Nni nʼaduane akɔnnɔ akɔnnɔ no akyi,</para>
  <para style="q2" vid="PRO 23:3">ɛfiri sɛ saa aduane no daadaa nnipa.<verse eid="PRO 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Mmiri wo mogya ani mpɛ sika;</para>
  <para style="q2" vid="PRO 23:4">hunu nyansa na to wo bo ase.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Wʼani bɔɔ sika so ara pɛ, na atu ayera,</para>
  <para style="q2" vid="PRO 23:5">ampa ara ɛbɛfu ntaban</para>
  <para style="q2" vid="PRO 23:5">na atu akɔ ewiem sɛ ɔkɔdeɛ.<verse eid="PRO 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Nni obi a ɔyɛ pɛpɛɛ aduane</para>
  <para style="q2" vid="PRO 23:6">nni nʼakɔnnɔ aduane akyi;<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>ɛfiri sɛ ɔyɛ obi a</para>
  <para style="q2" vid="PRO 23:7">ɛberɛ biara ɔdwene sika ho.</para>
  <para style="q1" vid="PRO 23:7">Ɔka sɛ, “Didi na nom,”</para>
  <para style="q2" vid="PRO 23:7">nanso ɛnyɛ nʼakoma mu.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Kakra a woadi no wobɛfe</para>
  <para style="q2" vid="PRO 23:8">na ɛno enti wo nkamfo ho remma mfasoɔ.<verse eid="PRO 23:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>Nkasa nkyerɛ ɔkwasea,</para>
  <para style="q2" vid="PRO 23:9">ɛfiri sɛ ɔremfa nyansa a ɛwɔ wo kasa mu no.<verse eid="PRO 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Ntutu tete aboɔ a wɔde ato hyeɛ ngu,</para>
  <para style="q2" vid="PRO 23:10">na ntra hyeɛ nkɔ nwisiaa mfuo mu,<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>ɛfiri sɛ, wɔn Gyefoɔ yɛ den,</para>
  <para style="q2" vid="PRO 23:11">na ɔbɛdi wɔn asɛm ama wɔn.<verse eid="PRO 23:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Ma wʼakoma mmra nkyerɛkyerɛ so</para>
  <para style="q2" vid="PRO 23:12">na wɛn wʼaso tie nimdeɛ.<verse eid="PRO 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>Ntwentwɛne abɔfra ntenesoɔ so;</para>
  <para style="q2" vid="PRO 23:13">sɛ wode abaa tene no a, ɔrenwu.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Fa abaa twe nʼaso</para>
  <para style="q2" vid="PRO 23:14">na gye ne kra firi owuo mu.<verse eid="PRO 23:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Me ba, sɛ wʼakoma hunu nyansa a,</para>
  <para style="q2" vid="PRO 23:15">ɛnneɛ mʼakoma ani bɛgye;<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>sɛ wʼano ka deɛ ɛtene a</para>
  <para style="q2" vid="PRO 23:16">me mu adeɛ nyinaa ani bɛgye.<verse eid="PRO 23:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>Mma wʼani mmerɛ abɔnefoɔ,</para>
  <para style="q2" vid="PRO 23:17">mmom bɔ <char style="nd">Awurade</char> suro ho mmɔden ɛberɛ biara.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Ampa ara anidasoɔ wɔ hɔ ma wo daakye,</para>
  <para style="q2" vid="PRO 23:18">na wʼanidasoɔ renyɛ ɔkwa.<verse eid="PRO 23:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Me ba, tie, na hunu nyansa,</para>
  <para style="q2" vid="PRO 23:19">ma wʼakoma mfa ɛkwan tenenee so.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Mfa wo ho mmɔ akɔwensafoɔ</para>
  <para style="q2" vid="PRO 23:20">anaasɛ wɔn a wɔpɛ ɛnam mmorosoɔ,<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>ɛfiri sɛ, akɔwensafoɔ ne adidibradafoɔ bɛyɛ ahiafoɔ,</para>
  <para style="q2" vid="PRO 23:21">na anikum fira wɔn ntomago.<verse eid="PRO 23:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>Tie wʼagya a ɔwoo woɔ no,</para>
  <para style="q2" vid="PRO 23:22">na sɛ wo maame bɔ aberewa a, mmu no animtia.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>Tɔ nokorɛ na ntɔn da;</para>
  <para style="q2" vid="PRO 23:23">nya nyansa, ahohyɛsoɔ ne nhunumu.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Ɔteneneeni agya wɔ anigyeɛ bebree;</para>
  <para style="q2" vid="PRO 23:24">deɛ ɔwɔ ɔba nyansafoɔ no anigye ne ho.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Ma wʼagya ne wo maame ani nnye;</para>
  <para style="q2" vid="PRO 23:25">ma ɔbaa a ɔwoo woɔ no nnya ahosɛpɛ.<verse eid="PRO 23:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Me ba, fa wʼakoma ma me</para>
  <para style="q2" vid="PRO 23:26">na ma wʼani nkɔ mʼakwan ho,<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>na odwamanfoɔ yɛ amena donkudonku</para>
  <para style="q2" vid="PRO 23:27">ɔyere sansani yɛ ɔdaadaafoɔ.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Ɔtɛ, twɛn, te sɛ ɔkwanmukafoɔ</para>
  <para style="q2" vid="PRO 23:28">na ɔma mmarima mu atorofoɔ dɔɔso.<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>Hwan na wɔadome no? Hwan na ɔdi awerɛhoɔ?</para>
  <para style="q2" vid="PRO 23:29">Hwan na ɔdi apereapereɛ? Hwan na ɔnwiinwii?</para>
  <para style="q2" vid="PRO 23:29">Hwan na wapirapira hunaa? Hwan na mogya ada nʼani so?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Wɔn a wɔkyɛre nsã ho,</para>
  <para style="q2" vid="PRO 23:30">na wɔka nsã a wɔafrafra hwɛ.<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Nhwɛ nsã ani kɔkɔɔ no haa,</para>
  <para style="q2" vid="PRO 23:31">ɛberɛ a ɛretwa yerɛ yerɛ wɔ kuruwa mu,</para>
  <para style="q2" vid="PRO 23:31">na ɛkɔ yɔɔ no.<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>Awieeɛ no ɛka te sɛ ɔwɔ</para>
  <para style="q2" vid="PRO 23:32">na ɛwɔ borɔ te sɛ ahurutoa.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Wʼani bɛhunu nneɛma a wonhunuu da,</para>
  <para style="q2" vid="PRO 23:33">na woadwene nneɛma basabasa ho.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Wobɛtɔ ntintan te sɛ hyɛn mu dwumayɛni a,</para>
  <para style="q2" vid="PRO 23:34">ɔkura ɛhyɛn dua a, ɛrehinhim mu den, na ɛdenkye denkye wɔ ɛpo so.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>Na wobɛka sɛ, “Wɔbɔ me, nanso mempira.</para>
  <para style="q2" vid="PRO 23:35">Wɔboro me, nanso mente ɔyea biara.</para>
  <para style="q1" vid="PRO 23:35">Ɛberɛ bɛn na menyane</para>
  <para style="q2" vid="PRO 23:35">akɔpɛ nsã anom bio?”<verse eid="PRO 23:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Mma wʼani mmerɛ amumuyɛfoɔ,</para>
  <para style="q2" vid="PRO 24:1">mfa wo ho mmɔ wɔn;<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>Ɛfiri sɛ, wɔn akoma dwene atirimuɔdensɛm ho,</para>
  <para style="q2" vid="PRO 24:2">na wɔn ano ka deɛ ɛde basabasayɛ ba ho asɛm.<verse eid="PRO 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>Wɔde nyansa na ɛsi efie,</para>
  <para style="q2" vid="PRO 24:3">na nhunumu mu na wɔma ɛtim;<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>ɛnam nimdeɛ so na wɔnya ademudeɛ a ɛho yɛ na</para>
  <para style="q2" vid="PRO 24:4">na ɛyɛ fɛ hyehyɛ nʼadan mu.<verse eid="PRO 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Onyansafoɔ wɔ tumi a ɛso,</para>
  <para style="q2" vid="PRO 24:5">na onimdefoɔ nyini ahoɔden mu;<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>deɛ ɔretu sa hia akwankyerɛ,</para>
  <para style="q2" vid="PRO 24:6">deɛ ɔrepɛ nkonimdie no hia afotufoɔ pii.<verse eid="PRO 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Nyansa wɔ akyiri dodo ma ɔkwasea;</para>
  <para style="q2" vid="PRO 24:7">wɔ apono ano dwabɔ mu no ɔnni hwee ka.<verse eid="PRO 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Onipa ɔbɔ pɔ bɔne no</para>
  <para style="q2" vid="PRO 24:8">wɔbɛfrɛ no ɔkɔtwebrɛfoɔ.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Ogyimifoɔ nhyehyɛeɛ yɛ bɔne,</para>
  <para style="q2" vid="PRO 24:9">nnipa kyiri ɔfɛdifoɔ.<verse eid="PRO 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Sɛ wʼabamu go wɔ ɔhaw mu a,</para>
  <para style="q2" vid="PRO 24:10">na wʼahoɔden sua!<verse eid="PRO 24:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>Gye wɔn a wɔde wɔn rekɔ akɔkum wɔn no nkwa;</para>
  <para style="q2" vid="PRO 24:11">na sianka wɔn a wɔtɔ ntintan kɔ akumiiɛ.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Sɛ woka sɛ, “Na yɛnnim yei ho hwee a,”</para>
  <para style="q2" vid="PRO 24:12">deɛ ɔkari akoma hwɛ no nhunu anaa?</para>
  <para style="q1" vid="PRO 24:12">Deɛ ɔbɔ wo nkwa ho ban no nnim anaa?</para>
  <para style="q2" vid="PRO 24:12">Ɔrentua deɛ obiara ayɛ so ka anaa?<verse eid="PRO 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Me ba, di ɛwoɔ, ɛfiri sɛ ɛyɛ;</para>
  <para style="q2" vid="PRO 24:13">ɛwokyɛm mu woɔ yɛ wʼanomu dɛ.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Hunu nso sɛ nyansa yɛ wo kra dɛ;</para>
  <para style="q2" vid="PRO 24:14">sɛ wonya a, wowɔ anidasoɔ ma daakye,</para>
  <para style="q2" vid="PRO 24:14">na wʼanidasoɔ renyɛ kwa.<verse eid="PRO 24:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>Nkɔtɛ ɔteneneeni fie sɛ ɔkwanmukafoɔ,</para>
  <para style="q2" vid="PRO 24:15">na ɛnkɔto nhyɛ nʼatenaeɛ so,<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>Ɛwom sɛ ɔteneneeni hwe ase mpɛn nson deɛ, nanso ɔsɔre bio,</para>
  <para style="q2" vid="PRO 24:16">na amumuyɛfoɔ deɛ, amanehunu baako ma wɔhwe ase.<verse eid="PRO 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>Sɛ wo ɔtamfoɔ hwe ase a mma ɛnyɛ wo dɛ;</para>
  <para style="q2" vid="PRO 24:17">na sɛ ɔsunti a mma wʼakoma nni ahurisie,<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>ɛfiri sɛ <char style="nd">Awurade</char> bɛhunu wʼadwene na ɔrempɛ</para>
  <para style="q2" vid="PRO 24:18">na ɔbɛyi nʼabufuhyeɛ afiri ne so.<verse eid="PRO 24:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>Ɛnha wo ho wɔ abɔnefoɔ enti</para>
  <para style="q2" vid="PRO 24:19">na ɛmma wʼani mmere amumuyɛfoɔ nso,<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>ɛfiri sɛ, ɔbɔnefoɔ nni anidasoɔ biara daakye,</para>
  <para style="q2" vid="PRO 24:20">na wɔbɛdum amumuyɛfoɔ kanea.<verse eid="PRO 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Me ba, suro <char style="nd">Awurade</char> ne ɔhene,</para>
  <para style="q2" vid="PRO 24:21">na mfa wo ho mmɔ adɔnyɛfoɔ ho,<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>ɛfiri sɛ saa baanu yi de ɔsɛeɛ bɛba wɔn so mpofirim,</para>
  <para style="q2" vid="PRO 24:22">na hwan na ɔnim amanehunu ko a wɔbɛtumi de aba?<verse eid="PRO 24:22"/></para>
  <para style="s1">Anyansafoɔ Nsɛnka A Ɛkeka Ho</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>Yeinom nso yɛ anyansafoɔ Nsɛnka:</para>
  <para style="q1" vid="PRO 24:23">Atemmuo a animhwɛ wɔ mu no nyɛ:<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Obiara a ɔbɛka akyerɛ deɛ ɔdi fɔ sɛ, “Wo ho nni asɛm” no</para>
  <para style="q2" vid="PRO 24:24">nnipa bɛdome no na amanaman remmɔ no din pa.<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>Na wɔn a wɔbu afɔdifoɔ fɔ no ɛbɛsi wɔn yie,</para>
  <para style="q2" vid="PRO 24:25">na nhyira bɛba wɔn so.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Mmuaeɛ pa</para>
  <para style="q2" vid="PRO 24:26">te sɛ mfeano.<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Wie wo mfikyidwuma</para>
  <para style="q2" vid="PRO 24:27">na siesie wo mfuo;</para>
  <para style="q2" vid="PRO 24:27">ɛno akyi, si wo fie.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Nni adanseɛ ntia ɔyɔnko a ɔnyɛɛ wo hwee,</para>
  <para style="q2" vid="PRO 24:28">na mfa wʼano nnaadaa.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>Nka sɛ, “Deɛ wayɛ me no me nso mɛyɛ no bi;</para>
  <para style="q2" vid="PRO 24:29">deɛ ɔyɛeɛ no metua ne so ka.”<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Menante faa onihafoɔ afuo ho</para>
  <para style="q2" vid="PRO 24:30">twaa mu wɔ deɛ ɔnni adwene bobefuo nso ho;<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>nkasɛɛ afu wɔ baabiara,</para>
  <para style="q2" vid="PRO 24:31">wira afu akata asase no so,</para>
  <para style="q2" vid="PRO 24:31">na aboɔ afasuo no nso abubu.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Mede mʼadwene kɔɔ deɛ mehunuiɛ no so</para>
  <para style="q2" vid="PRO 24:32">na mesuaa biribi firii mu:<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>nna kakra, nkotɔ kakra,</para>
  <para style="q2" vid="PRO 24:33">nsa a woabobɔ de rehome kakra,<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>bɛma ohia aba wo so sɛ ɔkwanmukafoɔ</para>
  <para style="q2" vid="PRO 24:34">na nneɛma ho nna bɛba wo so sɛ obi a ɔkura akodeɛ. Na ohia bɛto akyere wo sɛ ɔkwanmukafoɔ; ahokyere bɛtoa wo sɛ ɔkorɔmfoɔ.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">Salomo Mmɛbusɛm Nkekaho</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>Yeinom yɛ Salomo mmɛbusɛm nkekaho a Yudahene Hesekia afotufoɔ twerɛeɛ:<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Ɛyɛ Onyankopɔn animuonyamhyɛ sɛ wɔde asɛm sie;</para>
  <para style="q2" vid="PRO 25:2">sɛ wɔpɛɛpɛɛ asɛm mu nso hyɛ ahemfo animuonyam.<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>Sɛdeɛ ɔsoro korɔn na asase mu dɔ no,</para>
  <para style="q2" vid="PRO 25:3">saa ara na wɔrentumi nhwehwɛ ahemfo akoma mu.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Sɛ wɔyi dwetɛ ho a,</para>
  <para style="q2" vid="PRO 25:4">dwetɛdwumfoɔ tumi de yɛ adeɛ a ɛho wɔ mfasoɔ;<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>Yi amumuyɛfoɔ firi ɔhene anim,</para>
  <para style="q2" vid="PRO 25:5">na tenenee bɛma nʼahennwa atim.<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Mma wo ho so wɔ ɔhene anim,</para>
  <para style="q2" vid="PRO 25:6">na mpere diberɛ wɔ atitire mu;<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>Ɛyɛ ma no sɛ ɔbɛka akyerɛ wo sɛ, “Bra soro ha,”</para>
  <para style="q2" vid="PRO 25:7">sene sɛ ɔbɛbrɛ wo ase wɔ otitire bi anim.</para>
  <para style="b" vid="PRO 25:7"/>
  <para style="q1" vid="PRO 25:7">Deɛ wode wʼani ahunu no<verse eid="PRO 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8"/>mpɛ ntɛm mfa nkɔ asɛnniiɛ,</para>
  <para style="q1" vid="PRO 25:8">na sɛ awieeɛ no wo yɔnko gu wʼanim ase a</para>
  <para style="q2" vid="PRO 25:8">ɛdeɛn na wobɛyɛ?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>Sɛ wo ne wo yɔnko di asɛm a</para>
  <para style="q2" vid="PRO 25:9">nna obi foforɔ ahintasɛm adi,<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>anyɛ saa a, deɛ ɔbɛte no bɛgu wʼanim ase</para>
  <para style="q2" vid="PRO 25:10">na edin bɔne a wobɛnya no rempepa da.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Asɛm a wɔka no sɛdeɛ ɛfata no</para>
  <para style="q2" vid="PRO 25:11">te sɛ sika kɔkɔɔ a wɔabɔ sɛ aprɛ</para>
  <para style="q2" vid="PRO 25:11">de atuatua dwetɛ nsiesieɛ mu.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Sikakɔkɔɔ asomuadeɛ anaa sikakɔkɔɔ amapa ahyehyɛdeɛ</para>
  <para style="q2" vid="PRO 25:12">te sɛ onyansafoɔ animka a ɔde ma deɛ ɔyɛ aso ma no.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Sɛdeɛ sukyerɛmma ma ewiem dwoɔ wɔ otwa berɛ mu no</para>
  <para style="q2" vid="PRO 25:13">saa ara na ɔsomafoɔ nokwafoɔ teɛ ma wɔn a wɔsoma no;</para>
  <para style="q2" vid="PRO 25:13">na ɔma ne wuranom akomatɔyam.<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>Omununkum ne mframa a ɛmfa osutɔ mma no</para>
  <para style="q2" vid="PRO 25:14">te sɛ onipa a ɔde akyɛdeɛ a ɔmmfa mma hoahoa ne ho.<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Ntoboaseɛ ma sodifoɔ ti da,</para>
  <para style="q2" vid="PRO 25:15">na tɛkrɛmabereɛ tumi bu dompe mu.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Sɛ wonya ɛwoɔ a, enni ntra so,</para>
  <para style="q2" vid="PRO 25:16">ne bebrebe bɛma woafe.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Ntaa nkɔ wo yɔnko fie,</para>
  <para style="q2" vid="PRO 25:17">wo ho fono no a, ɔbɛtan wo.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Onipa a ɔdi adansekurumu tia ne yɔnko no</para>
  <para style="q2" vid="PRO 25:18">te sɛ aporibaa, afena anaa bɛmma a ano yɛ nnam.<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Ɛse a ɛyare kaka anaa ɛnan a ɛyɛ apakye</para>
  <para style="q2" vid="PRO 25:19">te sɛ deɛ wode wo ho to ɔtorofoɔ so hiada mu.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Deɛ ɔto dwom kyere ɔwerɛhoni no</para>
  <para style="q2" vid="PRO 25:20">te sɛ deɛ ɔpa ntoma gu awɔberɛ mu</para>
  <para style="q2" vid="PRO 25:20">anaa te sɛ nsã nyinyanyinya a wɔhwie gu afransa soɔ.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Sɛ ɛkɔm de wo ɔtamfoɔ a, ma no aduane nni;</para>
  <para style="q2" vid="PRO 25:21">sɛ osukɔm de no a, ma no nsuo nnom.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Sɛ woyɛ saa a, wobɛsoso gyasramma agu nʼatifi,</para>
  <para style="q2" vid="PRO 25:22">na <char style="nd">Awurade</char> bɛma wo akatua.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>Sɛdeɛ atifi fam mframa de osutɔ ba no,</para>
  <para style="q2" vid="PRO 25:23">saa ara na tɛkrɛma a ɛdi nsekuro de omuna ba.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Ɛyɛ sɛ wobɛtena suhyɛ ase mantweaa bi,</para>
  <para style="q2" vid="PRO 25:24">sene sɛ wo ne ɔyere ntɔkwapɛfoɔ bɛtena efie.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>Nsuonwunu a ɔkra a ato baha nya no</para>
  <para style="q2" vid="PRO 25:25">te sɛ asɛmmɔdɛ a ɛfiri akyirikyiri.<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>Asutire a ahono anaa abura a ayɛ pɔtɔɔ,</para>
  <para style="q2" vid="PRO 25:26">te sɛ ɔteneneeni a ɔgyaa ne ho ma amumuyɛfoɔ.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Ɛnyɛ sɛ wɔdi ɛwoɔ ntrasoɔ,</para>
  <para style="q2" vid="PRO 25:27">na ɛnyɛ fɛ nso sɛ obi pɛ animuonyam ma ne ho.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Onipa a ɔnni ahohyɛsoɔ no</para>
  <para style="q2" vid="PRO 25:28">te sɛ kuropɔn a nʼafasuo abubu agu fam.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>Sɛdeɛ sukyerɛmma te ahuhuro berɛ anaasɛ osutɔ te wɔ otwa berɛ no</para>
  <para style="q2" vid="PRO 26:1">saa ara na animuonyam mfata ɔkwasea.<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Sɛdeɛ apatuprɛ tuo anaasɛ asomfena tu danedane ne ho no,</para>
  <para style="q2" vid="PRO 26:2">saa ara na nnuabɔ hunu nsi hwee.<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Ɔkafoɔ abaa wɔ hɔ ma ɔpɔnkɔ, nnareka wɔ hɔ ma afunumu,</para>
  <para style="q2" vid="PRO 26:3">na abaa wɔ hɔ ma nkwaseafoɔ akyi.<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>Nhwɛ ɔkwasea agyimisɛm so mma no mmuaeɛ,</para>
  <para style="q2" vid="PRO 26:4">anyɛ saa a wo nso bɛyɛ sɛ ɔno.<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>Gyina ɔkwasea agyimisɛm so ma no mmuaeɛ</para>
  <para style="q2" vid="PRO 26:5">anyɛ saa a ɛbɛyɛ no sɛ ɔnim nyansa.<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Sɛ wode nkra bi soma ɔkwasea a,</para>
  <para style="q2" vid="PRO 26:6">ɛte sɛ woatwa wʼankasa nan anaasɛ woafrɛ basabasayɛ.<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>Apakye nan a awu na ɛsensɛn hɔ no,</para>
  <para style="q2" vid="PRO 26:7">yɛ abɛbusɛm a ɛda ɔkwasea ano.<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Ɛboɔ a wɔakyekyere afam ahwimmoɔ so,</para>
  <para style="q2" vid="PRO 26:8">te sɛ animuonyam a wɔde ama ɔkwasea.<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Nkasɛɛ dua a ɛkura ɔkɔwensani no</para>
  <para style="q2" vid="PRO 26:9">te sɛ abɛbusɛm a ɛda ɔkwasea ano.<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Deɛ ɔbɔ ɔkwasea anaa obi hunu paa no</para>
  <para style="q2" vid="PRO 26:10">te sɛ agyantoni a ɔpira nnipa kwa.<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Sɛdeɛ ɔkraman sane kɔ ne feɛ ho no,</para>
  <para style="q2" vid="PRO 26:11">saa ara na ɔkwasea ti nʼagyimisɛm mu.<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Woahunu obi a ɔyɛ onyansafoɔ wɔ nʼankasa ani so?</para>
  <para style="q2" vid="PRO 26:12">Anidasoɔ pii wɔ ɔkwasea mu sene no.<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>Ɔkwadwofoɔ ka sɛ, “Gyata wɔ ɛkwan no mu,</para>
  <para style="q2" vid="PRO 26:13">gyata nenam mmɔntene no so!”<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Sɛdeɛ ɛpono di akɔneaba wɔ ne mponterɛ so no,</para>
  <para style="q2" vid="PRO 26:14">saa ara na ɔkwadwofoɔ twa ne ho wɔ ne mpa so.<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>Ɔkwadwofoɔ de ne nsa si aduane mu,</para>
  <para style="q2" vid="PRO 26:15">na ɛyɛ no aniha sɛ ɔbɛyi akɔ nʼano.<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Ɔkwadwofoɔ yɛ onyansafoɔ wɔ ɔno ankasa ani so</para>
  <para style="q2" vid="PRO 26:16">sene nnipa baason a wɔdwene asɛm ho na wɔabua.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Obi a ɔsɔ ɔkraman aso twe noɔ no</para>
  <para style="q2" vid="PRO 26:17">te sɛ obi a ɔretwam na ɔde ne ho kɔfra ntɔkwa a ɛmfa ne ho mu.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Ɔbɔdamfoɔ a ɔtoto atuo</para>
  <para style="q2" vid="PRO 26:18">anaa agyan kɔdiawuo no<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>te sɛ obi a, ɔdaadaa ne yɔnko</para>
  <para style="q2" vid="PRO 26:19">na ɔka sɛ, “Na mede redi agorɔ!”<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Yensin hi a, ogya dum;</para>
  <para style="q2" vid="PRO 26:20">nsekuro nni hɔ a ntɔkwa toɔ twa.<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Sɛdeɛ gyabidie dane gyasramma na anyina dane ogya no,</para>
  <para style="q2" vid="PRO 26:21">saa ara na ntɔkwapɛfoɔ hyɛ ntɔkwa mu kutupa.<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>Osekuni anom asɛm te sɛ mfremfremadeɛ;</para>
  <para style="q2" vid="PRO 26:22">ɛwurawura kɔ onipa akwaa mu nyinaa.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Sɛdeɛ wɔde dwetɛ fi adura asankago ho no</para>
  <para style="q2" vid="PRO 26:23">saa ara na anoɔdɛ kata amumuyɛ akoma so.<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Onipa bɔne kasa te sɛ deɛ ɔyɛ,</para>
  <para style="q2" vid="PRO 26:24">nanso nnaadaa ahyɛ nʼakoma ma.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>Ɛwom sɛ ne kasa yɛ dɛ deɛ, nanso ɛnnye no nni,</para>
  <para style="q2" vid="PRO 26:25">ɛfiri sɛ akyiwadeɛ nson ahyɛ nʼakoma ma.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Ebia nnaadaa bɛkata nʼadwemmɔne so,</para>
  <para style="q2" vid="PRO 26:26">nanso nʼamumuyɛsɛm bɛda adi wɔ badwa mu.<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Sɛ onipa tu amena a, ɔbɛto mu;</para>
  <para style="q2" vid="PRO 26:27">sɛ onipa pire ɔboɔ a, ɛbɛsane aba ne so.<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Atorɔ tɛkrɛma kyiri wɔn a ɔgu wɔn ho fi,</para>
  <para style="q2" vid="PRO 26:28">na nnaadaa ano de ɔsɛeɛ ba.<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Mfa ɔkyena nhoahoa wo ho,</para>
  <para style="q2" vid="PRO 27:1">na wonnim deɛ ɛda bi de bɛba.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>Ma ɔfoforɔ nkamfo wo; na ɛnyɛ wʼankasa;</para>
  <para style="q2" vid="PRO 27:2">ma ɛmfiri ɔfoforɔ anomu na ɛnyɛ wo.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Ɛboɔ mu yɛ duru, na anwea yɛ adesoa,</para>
  <para style="q2" vid="PRO 27:3">nanso ɔkwasea abufuhyeɛ yɛ duru sene emu biara.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Abufuo tirim yɛ den, na abufuhyeɛ sɛe adeɛ,</para>
  <para style="q2" vid="PRO 27:4">na hwan na ɔbɛtumi agyina ninkuntwe ano?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Animka a ɛda edwa</para>
  <para style="q2" vid="PRO 27:5">yɛ sene ɔdɔ a asuma.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Apirakuro a ɛfiri adamfo nkyɛn no yɛ</para>
  <para style="q2" vid="PRO 27:6">sene ɔtamfoɔ mfeano bebrebe.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Ɛwoɔ nyɛ deɛ wameeɛ akɔnnɔ,</para>
  <para style="q2" vid="PRO 27:7">nanso deɛ ɛkɔm de noɔ no, deɛ ɛyɛ nwono yɛ nʼanom dɛ.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Onipa a wayera ne fie ɛkwan,</para>
  <para style="q2" vid="PRO 27:8">te sɛ anomaa a wafiri ne pirebuo mu rekyinkyini.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>Ngo ne aduhwam ma akoma ani gye,</para>
  <para style="q2" vid="PRO 27:9">adamfo ho anigyeɛ firi nʼafotu pa a ɔma.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Nnyaa wʼadamfo ne wʼagya adamfo mu,</para>
  <para style="q2" vid="PRO 27:10">nkɔ wo nuabarima fie ɛberɛ a ɔhaw ato woɔ,</para>
  <para style="q2" vid="PRO 27:10">na ɔyɔnko a ɔbɛn woɔ no yɛ sene onuabarima a ɔwɔ akyirikyiri.<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>Me ba, hunu nyansa na ma mʼakoma ani nnye;</para>
  <para style="q2" vid="PRO 27:11">ɛno na ɛbɛma manya mmuaeɛ ama obiara a ɔbu me animtiaa.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Mmadwemma hunu asiane na wɔhinta,</para>
  <para style="q2" vid="PRO 27:12">nanso ntetekwaafoɔ kɔ wɔn anim kɔtɔ mu.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Fa atadeɛ a ɛhyɛ obi a ɔdi ɔhɔhoɔ akagyinamu;</para>
  <para style="q2" vid="PRO 27:13">sɛ ɔregyina ɔbaa huhufoɔ akyi a, fa si awowa.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Sɛ obi team hyira ne yɔnko anɔpahema a,</para>
  <para style="q2" vid="PRO 27:14">wɔbɛfa no sɛ ɛyɛ nnome.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>Ɔyere ntɔkwapɛfoɔ te sɛ</para>
  <para style="q2" vid="PRO 27:15">osutɔ da nsusosɔ a ɛnnyae da;<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>sɛ wopata no a, ɛte sɛ deɛ wopata mframa</para>
  <para style="q2" vid="PRO 27:16">anaa wode wo nsa bɛsɔ ngo mu.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>Dadeɛ se dadeɛ,</para>
  <para style="q2" vid="PRO 27:17">saa ara na onipa se ɔfoforɔ.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Deɛ ɔhwɛ borɔdɔma dua so no bɛdi ɛso aba,</para>
  <para style="q2" vid="PRO 27:18">na deɛ ɔsom ne wura no, wɔbɛhyɛ no animuonyam.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>Sɛdeɛ nsuo yi animdua kyerɛ no,</para>
  <para style="q2" vid="PRO 27:19">saa ara na onipa akoma da onipa no adi.<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>Sɛdeɛ Owuo ne Ɔsɛeɛ bo ntɔ da no,</para>
  <para style="q2" vid="PRO 27:20">saa ara, na onipa ani nso bo ntɔ da.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Kyɛmferɛ wɔ hɔ ma dwetɛ na fononoo wɔ hɔ ma sikakɔkɔɔ,</para>
  <para style="q2" vid="PRO 27:21">nanso wɔnam nkamfo a onipa nya so na ɛso no hwɛ.<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>Sɛ wowɔ ɔkwasea wɔ ɔwaduro mu,</para>
  <para style="q2" vid="PRO 27:22">sɛ wode ɔwɔma wɔ no te sɛ deɛ wosi aburoo a,</para>
  <para style="q2" vid="PRO 27:22">worentumi nnyi agyimisɛm mfiri ne ho.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>Ma ɛnyɛ wo asɛnhia sɛ wobɛhunu wo nnwankuo tebea,</para>
  <para style="q2" vid="PRO 27:23">na ma wʼani nkɔ wʼanantwikuo so;<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>ɛfiri sɛ, ahonya ntena hɔ daa,</para>
  <para style="q2" vid="PRO 27:24">na ahenkyɛ ntena hɔ mma awoɔ ntoantoasoɔ nyinaa.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Sɛ wotwa ɛserɛ no na foforɔ fifiri</para>
  <para style="q2" vid="PRO 27:25">na wɔboaboa nkokoɔ so ɛserɛ no ano a,<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>ɛnneɛ nnwammaa no bɛma wo ntoma,</para>
  <para style="q2" vid="PRO 27:26">na mpɔnkye ama sika a ɛtɔ mfuo.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Wobɛnya mmirekyie nufosuo bebree</para>
  <para style="q2" vid="PRO 27:27">ama wo ne wʼabusuafoɔ adi</para>
  <para style="q2" vid="PRO 27:27">ne aduane ama wo mmaawa.<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Omumuyɛfoɔ dwane ɛberɛ a obiara ntaa no,</para>
  <para style="q2" vid="PRO 28:1">nanso teneneefoɔ koko yɛ duru sɛ agyata.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Atuateɛ ɔman nya sodifoɔ pii,</para>
  <para style="q2" vid="PRO 28:2">nanso onipa a ɔwɔ nhunumu ne nimdeɛ ma mmara yɛ adwuma.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Sodifoɔ a ɔhyɛ ahiafoɔ so no</para>
  <para style="q2" vid="PRO 28:3">te sɛ brampɔnsuo a ɛsɛe mfudeɛ.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Wɔn a wɔpo mmara no kamfo amumuyɛfoɔ,</para>
  <para style="q2" vid="PRO 28:4">na wɔn a wɔdi mmara so no si wɔn kwan.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Abɔnefoɔ nte atɛntenenee ase,</para>
  <para style="q2" vid="PRO 28:5">nanso wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no, te aseɛ yie.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>Ohiani a ne nanteɛ ho nni asɛm</para>
  <para style="q2" vid="PRO 28:6">yɛ sene ɔdefoɔ a nʼakwan yɛ kɔntɔnkye.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Deɛ ɔdi mmara so yɛ ɔba a ɔwɔ nhunumu,</para>
  <para style="q2" vid="PRO 28:7">nanso deɛ ɔne adidibradafoɔ bɔ no gu nʼagya anim ase.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Deɛ ɔgye mfɛntom mmorosoɔ de nya ne ho no</para>
  <para style="q2" vid="PRO 28:8">ɔboaboa ano ma deɛ ɔbɛyɛ ahiafoɔ adɔeɛ.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Sɛ obi nni mmara so a,</para>
  <para style="q2" vid="PRO 28:9">ne mpaeɛbɔ mpo yɛ akyiwadeɛ.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Deɛ ɔdi teneneefoɔ anim de wɔn fa ɛkwan bɔne so no</para>
  <para style="q2" vid="PRO 28:10">bɛhwe ɔno ankasa afidie mu,</para>
  <para style="q2" vid="PRO 28:10">nanso wɔn a wɔn ho nni asɛm no bɛnya agyapadeɛ a ɛyɛ.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Ɔdefoɔ tumi yɛ onyansafoɔ wɔ nʼankasa ani so,</para>
  <para style="q2" vid="PRO 28:11">nanso ohiani a ɔwɔ nhunumu no hunu sɛdeɛ ɔteɛ.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Sɛ teneneefoɔ di nkonim a, nnipa di ahurisie pii;</para>
  <para style="q2" vid="PRO 28:12">nanso sɛ amumuyɛfoɔ nya tumi a nnipa kɔhinta.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Onipa a ɔkata ne bɔne soɔ no nnya nkɔsoɔ,</para>
  <para style="q2" vid="PRO 28:13">na deɛ ɔka ne bɔne na ɔgyae yɛ no nya ahummɔborɔ.<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>Nhyira nka deɛ ɔsuro <char style="nd">Awurade</char> ɛberɛ nyinaa,</para>
  <para style="q2" vid="PRO 28:14">nanso deɛ ɔpirim nʼakoma no tɔ amaneɛ mu.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Omumuyɛfoɔ a ɔdi nnipa a wɔnni mmoa so no</para>
  <para style="q2" vid="PRO 28:15">te sɛ gyata a ɔbobɔm anaa sisire a nʼani abereɛ.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Sodifoɔ tirimuɔdenfoɔ nni adwene,</para>
  <para style="q2" vid="PRO 28:16">na deɛ ɔkyiri mfasoɔ a wɔnam ɛkwan bɔne so nya no bɛnya nkwa tenten.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Deɛ awudie ma ne tiboa bu no fɔ no,</para>
  <para style="q2" vid="PRO 28:17">ɔbɛyɛ ɔkobɔfoɔ akɔsi ne wu da;</para>
  <para style="q2" vid="PRO 28:17">mma obiara mmɔ ne ho ban.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Deɛ ne nanteɛ ho nni asɛm no, wɔgye no firi ɔhaw mu,</para>
  <para style="q2" vid="PRO 28:18">nanso deɛ nʼakwan yɛ kɔntɔnkye no bɛhwe ase mpofirim.<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>Deɛ ɔyɛ nʼasase so adwuma no bɛnya aduane pii,</para>
  <para style="q2" vid="PRO 28:19">nanso deɛ ɔdwene nneɛma hunu ho no bɛnya ne so ne ne hia.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Wɔbɛhyira onipa nokwafoɔ pii,</para>
  <para style="q2" vid="PRO 28:20">na deɛ ɔpere pɛ ahonyadeɛ no remfa ne ho nni.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Animhwɛ nyɛ,</para>
  <para style="q2" vid="PRO 28:21">nanso aduane kakra enti nnipa yɛ bɔne.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Deɛ ɔyɛ pɛpɛɛ pere sɛ ɔbɛyɛ ɔdefoɔ</para>
  <para style="q2" vid="PRO 28:22">na ɔnnim sɛ ohia retwɛn no.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Deɛ ɔka obi anim no bɛsɔ nnipa ani akyire</para>
  <para style="q2" vid="PRO 28:23">asene deɛ ɔwɔ tɛkrɛmadɛ.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Deɛ ɔbɔ nʼagya anaa ne maame korɔno</para>
  <para style="q2" vid="PRO 28:24">na ɔka sɛ, “Ɛnyɛ bɔne” no,</para>
  <para style="q2" vid="PRO 28:24">ɔne ɔsɛefoɔ na ɛbɔ.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Ɔdifodepɛfoɔ de mpaapaemu ba</para>
  <para style="q2" vid="PRO 28:25">na deɛ ɔde ne ho to <char style="nd">Awurade</char> so no bɛnya nkɔsoɔ.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Deɛ ɔgye ne ho die no yɛ ɔkwasea,</para>
  <para style="q2" vid="PRO 28:26">na deɛ ɔnante nyansa mu no wɔbɛgye no.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Deɛ ɔma ahiafoɔ no, hwee renhia no,</para>
  <para style="q2" vid="PRO 28:27">nanso deɛ ɔbu nʼani gu wɔn so no nya nnome pii.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Sɛ amumuyɛfoɔ nya tumi a, nnipa kɔhinta;</para>
  <para style="q2" vid="PRO 28:28">na sɛ amumuyɛfoɔ ase tɔre a, teneneefoɔ ase dɔre.<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Obi a ɔkɔ so yɛ tufoanteɛ wɔ animka pii akyi no</para>
  <para style="q2" vid="PRO 29:1">wɔbɛsɛe no mpofirim a wɔrentumi nsi ano.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Sɛ teneneefoɔ di yie a, nnipa no di ahurisie;</para>
  <para style="q2" vid="PRO 29:2">sɛ amumuyɛfoɔ di nnipa so a, wosi apinie.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Onipa a ɔdɔ nyansa no ma nʼagya anigye,</para>
  <para style="q2" vid="PRO 29:3">nanso nnwamanfoɔ yɔnko sɛe nʼahonya.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>Ɔhene nam atɛntenenee so ma ɔman no asomdwoeɛ,</para>
  <para style="q2" vid="PRO 29:4">nanso deɛ ɔde adifudepɛ gye adanmudeɛ no bɔ ɔman no.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Obiara a ɔdaadaa ne yɔnko no</para>
  <para style="q2" vid="PRO 29:5">sum ne nan afidie.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Ɔdebɔneyɛfoɔ bɔne sum no afidie,</para>
  <para style="q2" vid="PRO 29:6">nanso ɔteneneeni bɛtumi ato dwom ama nʼani agye.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Ahiafoɔ atɛnteneebuo ho hia teneneefoɔ,</para>
  <para style="q2" vid="PRO 29:7">nanso amumuyɛfoɔ nni saa tema no.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Fɛdifoɔ de basabasayɛ ba kuropɔn mu,</para>
  <para style="q2" vid="PRO 29:8">nanso anyansafoɔ dwodwo abufuo ano.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Sɛ onyansafoɔ de ɔkwasea kɔ asɛnniiɛ a,</para>
  <para style="q2" vid="PRO 29:9">ɔkwasea no bobom kasa di fɛ, na asomdwoeɛ mma.<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Mogyapɛfoɔ kyiri ɔnokwafoɔ,</para>
  <para style="q2" vid="PRO 29:10">na wɔhwehwɛ sɛ wɔbɛkum deɛ ɔtene.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Ɔkwasea da abufuo nyinaa adi,</para>
  <para style="q2" vid="PRO 29:11">nanso onyansafoɔ hyɛ ne ho so.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Sɛ sodifoɔ tie nkontomposɛm a,</para>
  <para style="q2" vid="PRO 29:12">nʼadwumayɛfoɔ nyinaa bɛyɛ amumuyɛfoɔ.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Ohiani ne ɔhyɛsofoɔ nyinaa wɔ saa adeɛ baako yi:</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">Awurade</char> ma wɔn baanu nyinaa ani a wɔde hunu adeɛ.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Sɛ ɔhene di ahiafoɔ asɛm yie a,</para>
  <para style="q2" vid="PRO 29:14">nʼahennwa bɛtim hɔ daa.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>Ntenesoɔ abaa ma nyansa,</para>
  <para style="q2" vid="PRO 29:15">na abɔfra a wɔde ne pɛ ma noɔ no, gu ne na anim ase.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Sɛ amumuyɛfoɔ di yie a, bɔne nso kɔ so,</para>
  <para style="q2" vid="PRO 29:16">na teneneefoɔ bɛhunu wɔn asehweɛ.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Tene wo ba so, na ɔbɛma wo asomdwoeɛ;</para>
  <para style="q2" vid="PRO 29:17">ɔbɛma wo ɔkra ani agye.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Sɛ anisoadehunu nni hɔ a, nnipa no yɛ basaa;</para>
  <para style="q2" vid="PRO 29:18">na nhyira nka deɛ ɔdi mmara so.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Wɔmmfa anomu nsɛm nko ara ntene ɔsomfoɔ so,</para>
  <para style="q2" vid="PRO 29:19">ɔte aseɛ deɛ, nanso ɔremfa.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Wohunu obi a ɔpere ne nsɛm ho anaa?</para>
  <para style="q2" vid="PRO 29:20">Ɔkwasea mu wɔ anidasoɔ sene no.<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Sɛ obi korɔkorɔ ne ɔsomfoɔ firi ne mmɔfraase a,</para>
  <para style="q2" vid="PRO 29:21">awieeɛ no ɔde awerɛhoɔ na ɛbɛba.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Onipa a ne bo afuo de mpaapaemu ba,</para>
  <para style="q2" vid="PRO 29:22">na deɛ ne bo nkyɛre fu no yɛ bɔne pii.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Onipa ahomasoɔ brɛ no ase,</para>
  <para style="q2" vid="PRO 29:23">nanso deɛ ɔwɔ ahobrɛaseɛ no nya animuonyam.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Deɛ ɔboa ɔkorɔmfoɔ no ha ɔno ankasa ho.</para>
  <para style="q2" vid="PRO 29:24">Wɔama waka ntam enti ɔsuro sɛ ɔbɛdi adanseɛ.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Onipa ho suro bɛtumi ayɛ afidie ama wo,</para>
  <para style="q2" vid="PRO 29:25">na deɛ ɔde ne ho to <char style="nd">Awurade</char> so no, wɔbɛgye no.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Bebree hwehwɛ sɛ wɔbɛnya ɔhene ne no akasa,</para>
  <para style="q2" vid="PRO 29:26">nanso onipa nya atɛntenenee firi <char style="nd">Awurade</char> nkyɛn.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Teneneefoɔ kyiri atorofoɔ;</para>
  <para style="q2" vid="PRO 29:27">na amumuyɛfoɔ kyiri wɔn a wɔn akwan tene.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">Agur Nsɛm A Ɔkaeɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Yake babarima Agur nsɛm a ɔkaeɛ a ɛyɛ nkɔmhyɛ:</para>
  <para style="q1" vid="PRO 30:1">Saa ɔbarima yi ka kyerɛɛ Itiel ne Ukal sɛ:<verse eid="PRO 30:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>“Me na mennim hwee koraa wɔ nnipa mu,</para>
  <para style="q2" vid="PRO 30:2">menni onipa nteaseɛ.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>Mensuaa nyansa,</para>
  <para style="q2" vid="PRO 30:3">na menni Ɔkronkronni no ho nimdeɛ nso.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>Hwan na waforo akɔ soro na wasiane aba fam?</para>
  <para style="q2" vid="PRO 30:4">Hwan na wabɔ mframa boa wɔ ne nsa mu?</para>
  <para style="q1" vid="PRO 30:4">Hwan na ɔde nʼatadeɛ abɔ nsuo boa?</para>
  <para style="q2" vid="PRO 30:4">Hwan na ɔbɔɔ asase hahanaa yi?</para>
  <para style="q1" vid="PRO 30:4">Ne din de sɛn, na ne ba barima nso din de sɛn?</para>
  <para style="q2" vid="PRO 30:4">Sɛ wonim a ka kyerɛ me!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“Onyankopɔn asɛm biara yɛ nokorɛ;</para>
  <para style="q2" vid="PRO 30:5">ɔyɛ kyɛm ma wɔn a wɔdwane toa no.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>Mfa biribi nka nʼasɛm ho,</para>
  <para style="q2" vid="PRO 30:6">anyɛ saa a ɔbɛka wʼanim ama woayɛ ɔtorofoɔ.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“Ao <char style="nd">Awurade</char>, nneɛma mmienu na mehwehwɛ firi wo nkyɛn;</para>
  <para style="q2" vid="PRO 30:7">mfa nkame me ansa na mawu:<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>Yi atorɔ ne ahohwisɛm firi me mu;</para>
  <para style="q2" vid="PRO 30:8">mma mennyɛ ohiani anaa ɔdefoɔ;</para>
  <para style="q2" vid="PRO 30:8">nanso ma me deɛ medi daa.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>Anyɛ saa a, ebia menya me ho pii ama mapa wo</para>
  <para style="q2" vid="PRO 30:9">na maka sɛ, ‘Hwan ne <char style="nd">Awurade</char>?’</para>
  <para style="q1" vid="PRO 30:9">Anaa mɛyɛ ohiani na mabɔ korɔno,</para>
  <para style="q2" vid="PRO 30:9">na ama magu me Onyankopɔn din ho fi.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“Nsɛe ɔsomfoɔ din nkyerɛ ne wura;</para>
  <para style="q2" vid="PRO 30:10">sɛ woyɛ saa a, ɔbɛdome wo na wobɛtua so ka.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>“Nnipa bi dome wɔn agyanom,</para>
  <para style="q2" vid="PRO 30:11">na wɔnnhyira wɔn maamenom nso;<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>Wɔn a wɔtene wɔ wɔn ankasa ani so</para>
  <para style="q2" vid="PRO 30:12">a ɛnso wɔnhohoroo wɔn ho fi;<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>wɔn a wɔn ani tra ntɔn,</para>
  <para style="q2" vid="PRO 30:13">na wɔbu animtiaa;<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>wɔn a wɔn se yɛ akofena</para>
  <para style="q2" vid="PRO 30:14">na sekammoa hyehyɛ wɔn apantan</para>
  <para style="q1" vid="PRO 30:14">wɔn na wɔbɛtɔre ahiafoɔ ase afiri asase so,</para>
  <para style="q2" vid="PRO 30:14">na woayi onibie afiri adasamma mu.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“Amemem wɔ mmammaa mmienu</para>
  <para style="q2" vid="PRO 30:15">a wɔteam sɛ, ‘Fa ma me! Fa ma me.’</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="li1" vid="PRO 30:15">“Nneɛma mmiɛnsa na ɛmmee da.</para>
  <para style="li2" vid="PRO 30:15">Dabi, nneɛma ɛnan wɔ hɔ a ɛnka da sɛ, ‘Ɛyɛ!’<verse eid="PRO 30:15"/></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16"/>Damena,</para>
  <para style="li3" vid="PRO 30:16">obonini awotwaa,</para>
  <para style="li3" vid="PRO 30:16">asase a ɛyɛ wesee daa,</para>
  <para style="li3" vid="PRO 30:16">ne ogya a ɛnka da sɛ, ‘Ɛyɛ!’<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“Ani a ɛyi agya ahi,</para>
  <para style="q2" vid="PRO 30:17">na ɛbu ɛna animtia no,</para>
  <para style="q1" vid="PRO 30:17">bɔnhwa ho anene bɛtutu,</para>
  <para style="q2" vid="PRO 30:17">na apete abɛdi.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18"/>“Nneɛma mmiɛnsa na ɛyɛ me nwanwa,</para>
  <para style="li2" vid="PRO 30:18">ɛnan na mente aseɛ:<verse eid="PRO 30:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19"/>Ɛkwan a ɔkɔdeɛ nam so wɔ ewiem,</para>
  <para style="li3" vid="PRO 30:19">sɛdeɛ ɔwɔ nante ɔbotan so,</para>
  <para style="li3" vid="PRO 30:19">ɛkwan a ɛhyɛn nam so wɔ ɛpo hahanaa so,</para>
  <para style="li3" vid="PRO 30:19">ne sɛdeɛ ɔbarima dɔ ababaawa.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“Ɔbaa waresɛefoɔ ɛkwan nie:</para>
  <para style="q2" vid="PRO 30:20">Ɔdidi, ɔpepa nʼano</para>
  <para style="q2" vid="PRO 30:20">na ɔka sɛ, ‘Menyɛɛ mfomsoɔ biara.’<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21"/>“Nneɛma mmiɛnsa na ɛma asase woso,</para>
  <para style="li2" vid="PRO 30:21">ɛnan na asase ɛntumi nnyina ano:<verse eid="PRO 30:21"/></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22"/>akoa a wabɛyɛ ɔhene,</para>
  <para style="li3" vid="PRO 30:22">ɔkwasea a wadidi amee,<verse eid="PRO 30:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23"/>ɔbaa a wɔmmpɛ no na wawareɛ,</para>
  <para style="li3" vid="PRO 30:23">afenaa a ɔtu nʼawurakwaa tena nʼanan mu.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24"/>“Nneɛma nketenkete ɛnan na ɛwɔ asase so,</para>
  <para style="li2" vid="PRO 30:24">nanso wɔyɛ anyansafoɔ ankasa:<verse eid="PRO 30:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25"/>Ntɛtea yɛ abɔdeɛ nketewa a wɔnni ahoɔden,</para>
  <para style="li3" vid="PRO 30:25">nanso wɔboaboa wɔn aduane ano ahuhuro berɛ mu;<verse eid="PRO 30:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26"/>Nkukuban<note caller="+" style="f"><char style="fr" closed="false">30.26 </char><char style="ft" closed="false">Nkukuban yɛ nnanko mu ahodoɔ bi a, wɔtena akuakuo wɔ mmepɔ mu.</char></note>—yɛ abɔdeɛ a wɔnni ahoɔden,</para>
  <para style="li3" vid="PRO 30:26">nanso wɔyɛ wɔn afie wɔ abotan mu,<verse eid="PRO 30:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27"/>ntutummɛ nni ɔhene,</para>
  <para style="li3" vid="PRO 30:27">nanso wɔsa so akuakuo, kɔ wɔn anim;<verse eid="PRO 30:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28"/>wɔtumi de nsa kyere ɔkoterɛ,</para>
  <para style="li3" vid="PRO 30:28">nanso wɔhunu no aberempɔn ahemfie.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29"/>“Nneɛma mmiɛnsa na wɔwɔ aberempɔn nanteɛ,</para>
  <para style="li2" vid="PRO 30:29">ɛnan na wɔkeka wɔn ho te sɛ aberempɔn:<verse eid="PRO 30:29"/></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30"/>gyata, mmoadoma ɔhene a, biribiara mmɔ no hu;<verse eid="PRO 30:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31"/>akokɔnini a ɔretutu taataa,</para>
  <para style="li3" vid="PRO 30:31">ɔpapo,</para>
  <para style="li3" vid="PRO 30:31">ne ɔhene a nʼasraafoɔ atwa ne ho ahyia.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“Sɛ woayɛ ɔkwasea ama wo ho so,</para>
  <para style="q2" vid="PRO 30:32">anaa woadwene bɔne a,</para>
  <para style="q2" vid="PRO 30:32">ma wʼani nwu na mua wʼano!<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Sɛdeɛ wɔka nufosuo nu mu a sradeɛ firi mu ba</para>
  <para style="q2" vid="PRO 30:33">na wɔkyinkyim hwene a ɛtu mogya no,</para>
  <para style="q2" vid="PRO 30:33">saa ara na abufuo de akasakasa ba.”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">Ɔhene Lemuel Nsɛm</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Ɔhene Lemuel nsɛm a ɛyɛ nkɔmhyɛ a ne maame kyerɛɛ no:<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>Ao me babarima, me yafunu ba,</para>
  <para style="q2" vid="PRO 31:2">Ao mebɔhyɛ ba,<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>nsɛe wʼahoɔden wɔ mmaa<note caller="+" style="f"><char style="fr" closed="false">31.3 </char><char style="ft" closed="false">Saa mmaa yi yɛ mmaa adwamanfoɔ a wɔwɔ ahemfie a wɔbɛtumi atwe ɔhene adwene afiri nʼadwuma so.</char></note> ho,</para>
  <para style="q2" vid="PRO 31:3">wɔn a wɔgu ahemfo asu no.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>Lemuel, nsã nyɛ mma ahemfo;</para>
  <para style="q2" vid="PRO 31:4">asanom nyɛ mma ahemfo,</para>
  <para style="q2" vid="PRO 31:4">ɛnsɛ sɛ sodifoɔ pere nsaden ho;<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>sɛ wɔnom nsã a, wɔn werɛ bɛfiri deɛ mmara no ka,</para>
  <para style="q2" vid="PRO 31:5">na wɔn a wɔdi wɔn nya no rennya deɛ wɔwɔ ho ɛkwan.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Fa nsaden ma wɔn a wɔresɛe,</para>
  <para style="q2" vid="PRO 31:6">na fa nsã ma wɔn a wɔwɔ amanehunu mu;<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>Momma wɔnnom, na wɔn werɛ mfiri wɔn hia</para>
  <para style="q2" vid="PRO 31:7">na wɔnnkae wɔn awerɛhoɔ bio.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>Kasa ma wɔn a wɔntumi nkasa mma wɔn ho,</para>
  <para style="q2" vid="PRO 31:8">kasa ma mmɔborɔfoɔ yiedie.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Kasa na bu atɛntenenee;</para>
  <para style="q2" vid="PRO 31:9">kasa ma ahiafoɔ ne onnibie yiedie.<verse eid="PRO 31:9"/></para>
  <para style="s1">Awieeɛ: Ɔyere A Ɔsom Bo</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Ɔyere pa, hwan na ɔbɛnya?</para>
  <para style="q2" vid="PRO 31:10">Ɔsom bo pa ara sene nhwene pa.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Ne kunu wɔ ne mu ahotosoɔ pa ara</para>
  <para style="q2" vid="PRO 31:11">na biribiara a ɛwɔ boɔ nhia no.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Ɔde deɛ ɛyɛ brɛ no, na ɛnyɛ ɔhaw,</para>
  <para style="q2" vid="PRO 31:12">ne nkwa nna nyinaa mu.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Ɔhwehwɛ odwannwi ne asaawa</para>
  <para style="q2" vid="PRO 31:13">na ɔde ne nsa nwono wɔ fɛ so.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Ɔte sɛ adwadifoɔ ahyɛn,</para>
  <para style="q2" vid="PRO 31:14">ɔde ne nnuane firi akyirikyiri ba.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Adeɛ nnya nkyeeɛ no na wasɔre;</para>
  <para style="q2" vid="PRO 31:15">ɔsiesie aduane ma nʼabusuafoɔ</para>
  <para style="q2" vid="PRO 31:15">na ɔkyekyɛ nnwuma ma ne mmaawa.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Ɔdwene afuo ho, na ɔtɔ;</para>
  <para style="q2" vid="PRO 31:16">ɔfiri deɛ ɔnya mu yɛ bobefuo.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Ɔde nsi yɛ nʼadwuma;</para>
  <para style="q2" vid="PRO 31:17">nʼabasa mu wɔ ahoɔden ma nʼadwuma.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Ɔhwɛ sɛ nʼadwadie ho wɔ mfasoɔ,</para>
  <para style="q2" vid="PRO 31:18">na ne kanea ɛnnum anadwo.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Daa, na ne nsa kura tadua mu</para>
  <para style="q2" vid="PRO 31:19">a ne nsateaa nso retoatoa asaawa.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Ɔgo ne nsam ma ahiafoɔ</para>
  <para style="q2" vid="PRO 31:20">na ne nsa so onibie so.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Sɛ sukyerɛmma tɔ a ne yam nhyehye no wɔ ne fiefoɔ ho;</para>
  <para style="q2" vid="PRO 31:21">ɛfiri sɛ wɔn nyinaa wɔ aduradeɛ a wɔde ko awɔ.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Ɔyɛ ne mpasotam;</para>
  <para style="q2" vid="PRO 31:22">na ɔfira nwera ne serekye ntoma.<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Ne kunu wɔ animuonyam wɔ kuropɔn ɛpono ano,</para>
  <para style="q2" vid="PRO 31:23">baabi a ɔne asase no so mpanimfoɔ tena.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Ɔpempam nwera ntadeɛ tontɔn,</para>
  <para style="q2" vid="PRO 31:24">na ɔtu abɔwomu ma adwadifoɔ.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Ɔwɔ ahoɔden ne animuonyam;</para>
  <para style="q2" vid="PRO 31:25">na ɔnsuro nna a ɛwɔ nʼanim.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Ɔkasa nyansa mu,</para>
  <para style="q2" vid="PRO 31:26">na nokorɛ nkyerɛkyerɛ wɔ ne tɛkrɛma so.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Ɔhwɛ ne fidua mu nnwuma so</para>
  <para style="q2" vid="PRO 31:27">na ɔnnyegye aniha so.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Ne mma sɔre a wɔfrɛ no nhyira;</para>
  <para style="q2" vid="PRO 31:28">ne kunu nso saa ara, na ɔkamfo no sɛ,<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“Mmaa pii yɛ nneɛma a ɛwɔ edin,</para>
  <para style="q2" vid="PRO 31:29">na wo deɛ, wosene wɔn nyinaa.”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Ɔbaa kɔnɔfoɔ yɛ nnaadaa, na ahoɔfɛ twam ntɛm so;</para>
  <para style="q2" vid="PRO 31:30">nanso ɔbaa a ɔsuro <char style="nd">Awurade</char> no fata nkamfoɔ.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Fa abasobɔdeɛ a wanya no ma no,</para>
  <para style="q2" vid="PRO 31:31">na wɔnkamfo ne nnwuma wɔ kuropɔn ɛpono ano.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
