<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Asante Twi Contemporary Bible 2020</book>
  <para style="h">Sefania</para>
  <para style="toc1">Odiyifoɔ Sefania Nwoma</para>
  <para style="toc2">Sefania</para>
  <para style="toc3">Sef</para>
  <para style="mt2">Odiyifoɔ</para>
  <para style="mt1">Sefania</para>
  <para style="mt2">Nwoma</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>
    <char style="nd">Awurade</char> asɛm a ɛbaa Sefania a ɔyɛ Kusi ba, Gedalia ba, Amaria ba, Hesekia ba nkyɛn nie. Ɛbaa Yudahene Yosia a ɔyɛ Amon ba berɛ so.<verse eid="ZEP 1:1"/></para>
  <para style="s1">Atemmuo A Ɛtia Yuda</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2"/>“Mɛpra biribiara afiri asase so”</para>
  <para style="q2" vid="ZEP 1:2">deɛ <char style="nd">Awurade</char> seɛ nie,<verse eid="ZEP 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3"/>“Mɛpra nnipa ne mmoa nyinaa;</para>
  <para style="q2" vid="ZEP 1:3">mɛpra nnomaa a wɔwɔ ewiem</para>
  <para style="q1" vid="ZEP 1:3">ne mpataa a wɔwɔ ɛpo mu nyinaa.</para>
  <para style="q2" vid="ZEP 1:3">Atirimuɔdenfoɔ bɛnya wira a ɛsum hɔ nko ara</para>
  <para style="q1" vid="ZEP 1:3">sɛ mesɛe adasamma a wɔwɔ asase yi so a,”</para>
  <para style="q2" vid="ZEP 1:3">deɛ <char style="nd">Awurade</char> seɛ nie.<verse eid="ZEP 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4"/>“Mɛtene me nsa wɔ Yuda</para>
  <para style="q2" vid="ZEP 1:4">ne wɔn a wɔte Yerusalem nyinaa so;</para>
  <para style="q1" vid="ZEP 1:4">na mɛsɛe Baal ho biribiara a aka wɔ ha,</para>
  <para style="q2" vid="ZEP 1:4">na masɛe abosonsomfoɔ ne abosomfoɔ asɔfoɔ no din<verse eid="ZEP 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5"/>wɔn a wɔkoto sɔre wɔn adan atifi,</para>
  <para style="q2" vid="ZEP 1:5">de sɔre abɔdeɛ a ɛwɔ ewiem,</para>
  <para style="q1" vid="ZEP 1:5">wɔn a wɔkoto de <char style="nd">Awurade</char> ka ntam</para>
  <para style="q2" vid="ZEP 1:5">na wɔde Molek nso ka ntam,<verse eid="ZEP 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6"/>wɔn nso a wɔgyae <char style="nd">Awurade</char> akyiridie</para>
  <para style="q2" vid="ZEP 1:6">na wɔnhwehwɛ <char style="nd">Awurade</char> anaa wɔmmisa nʼase.”<verse eid="ZEP 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7"/>Monyɛ komm wɔ Asafo <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="ZEP 1:7">ɛfiri sɛ, <char style="nd">Awurade</char> ɛda no abɛn.</para>
  <para style="q1" vid="ZEP 1:7">
    <char style="nd">Awurade</char> asiesie afɔrebɔdeɛ;</para>
  <para style="q2" vid="ZEP 1:7">wadwira wɔn a wato nsa afrɛ wɔn no ho.<verse eid="ZEP 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8"/>“<char style="nd">Awurade</char> afɔrebɔ ɛda no,</para>
  <para style="q2" vid="ZEP 1:8">mɛtwe mmapɔmma</para>
  <para style="q2" vid="ZEP 1:8">ne ahenemma</para>
  <para style="q1" vid="ZEP 1:8">ne wɔn a wɔhyehyɛ</para>
  <para style="q2" vid="ZEP 1:8">ananafoɔ ntadeɛ nyinaa aso.<verse eid="ZEP 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9"/>Saa ɛda no mɛtwe wɔn</para>
  <para style="q2" vid="ZEP 1:9">a wɔkwati aponnwa no nyinaa aso.</para>
  <para style="q1" vid="ZEP 1:9">Wɔn a wɔde akakabensɛm</para>
  <para style="q2" vid="ZEP 1:9">ne nsisie hyehyɛ wɔn abosomfie ma no.<verse eid="ZEP 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10"/>“Saa ɛda no,”</para>
  <para style="q2" vid="ZEP 1:10">sɛdeɛ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q1" vid="ZEP 1:10">“Esu bɛfiri Mpataa Ɛpono ano,</para>
  <para style="q2" vid="ZEP 1:10">agyaadwotwa bɛfiri Atenaeɛ Foforɔ</para>
  <para style="q2" vid="ZEP 1:10">na nnyegyeeɛ a ano yɛ den afiri nkokoɔ no so aba.<verse eid="ZEP 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11"/>Montwa adwo, mo a mote adetɔnbea hɔ no</para>
  <para style="q2" vid="ZEP 1:11">wɔbɛtɔre wɔn a mo ne wɔn di dwa ase,</para>
  <para style="q2" vid="ZEP 1:11">dwetɛ adwadifoɔ nyinaa nso wɔbɛsɛe wɔn.<verse eid="ZEP 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12"/>Mede nkanea bɛkyini ahwehwɛ Yerusalem mu</para>
  <para style="q2" vid="ZEP 1:12">na matwe wɔn a wɔgyaagyaa wɔn ho aso,</para>
  <para style="q2" vid="ZEP 1:12">wɔn a wɔte sɛ bobesa puo no,</para>
  <para style="q1" vid="ZEP 1:12">a wɔdwene sɛ, ‘<char style="nd">Awurade</char> nnyɛ wɔn hwee</para>
  <para style="q2" vid="ZEP 1:12">sɛ ɛyɛ papa anaa bɔne.’<verse eid="ZEP 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13"/>Wɔbɛfom wɔn ahonyadeɛ,</para>
  <para style="q2" vid="ZEP 1:13">na wɔabubu wɔn afie agu.</para>
  <para style="q1" vid="ZEP 1:13">Wɔbɛsisi afie, nanso wɔrentena mu</para>
  <para style="q2" vid="ZEP 1:13">wɔbɛyɛ bobe mfuo</para>
  <para style="q2" vid="ZEP 1:13">nanso wɔrennom emu nsã.”<verse eid="ZEP 1:13"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Ɛda Kɛseɛ No</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>
    <char style="nd">Awurade</char> ɛda kɛseɛ no abɛn,</para>
  <para style="q2" vid="ZEP 1:14">abɛn na ɛreba ntɛm so.</para>
  <para style="q1" vid="ZEP 1:14">Tie! Osu a wɔbɛsu <char style="nd">Awurade</char> ɛda no bɛyɛ ya,</para>
  <para style="q2" vid="ZEP 1:14">ɔkofoɔ a ɔwɔ hɔ nso nteamu bɛyɛ saa ara.<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>Saa ɛda no bɛyɛ abufuo ɛda,</para>
  <para style="q2" vid="ZEP 1:15">ɛyɛ ahoyera ne ɔyea ɛda;</para>
  <para style="q3" vid="ZEP 1:15">ɛyɛ amanehunu ne ɔsɛeɛ ɛda,</para>
  <para style="q2" vid="ZEP 1:15">ɛyɛ esum ne kusukuukuu ɛda</para>
  <para style="q3" vid="ZEP 1:15">ɛyɛ omununkum ne kusuuyɛ ɛda,<verse eid="ZEP 1:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16"/>ɛyɛ totorobɛnto hyɛn ne ɔko nteam</para>
  <para style="q1" vid="ZEP 1:16">a ɛtia nkuropɔn a ɛwɔ banbɔ</para>
  <para style="q2" vid="ZEP 1:16">ne ntwɛtwɛaso abantenten ɛda.<verse eid="ZEP 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>“Mede awerɛhoɔ bɛba nnipa no so</para>
  <para style="q2" vid="ZEP 1:17">na wɔbɛnante sɛ anifirafoɔ,</para>
  <para style="q2" vid="ZEP 1:17">ɛfiri sɛ wɔayɛ bɔne atia <char style="nd">Awurade</char>.</para>
  <para style="q1" vid="ZEP 1:17">Wɔbɛhwie wɔn mogya agu sɛ mfuturo,</para>
  <para style="q2" vid="ZEP 1:17">na wɔn ayamdeɛ nso sɛ atantanneɛ.<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>Wɔn dwetɛ anaa sikakɔkɔɔ</para>
  <para style="q2" vid="ZEP 1:18">rentumi nnye wɔn nkwa</para>
  <para style="q1" vid="ZEP 1:18">wɔ <char style="nd">Awurade</char> abufuo ɛda no.”</para>
  <para style="b" vid="ZEP 1:18"/>
  <para style="q2" vid="ZEP 1:18">Ne ninkuntwe mu ogya no</para>
  <para style="q1" vid="ZEP 1:18">bɛhye ɔman no nyinaa,</para>
  <para style="q2" vid="ZEP 1:18">na ɔbɛma asase no so tefoɔ nyinaa nkwa</para>
  <para style="q2" vid="ZEP 1:18">aba awieeɛ mpofirim.<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1"/>Mommoaboa mo ho ano, mommoaboa mo ho ano,</para>
  <para style="q2" vid="ZEP 2:1">Ao, animguaseɛ ɔman,<verse eid="ZEP 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2"/>ansa na ɛberɛ a wɔahyɛ no aduru,</para>
  <para style="q2" vid="ZEP 2:2">na ɛda no resene te sɛ ntɛtɛ,</para>
  <para style="q1" vid="ZEP 2:2">ansa na <char style="nd">Awurade</char> abufuhyeɛ no</para>
  <para style="q2" vid="ZEP 2:2">aba mo so,</para>
  <para style="q1" vid="ZEP 2:2">ansa na <char style="nd">Awurade</char> abufuo ɛda no</para>
  <para style="q2" vid="ZEP 2:2">aba mo so.<verse eid="ZEP 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3"/>Monhwehwɛ <char style="nd">Awurade</char>, ahobrɛasefoɔ a mowɔ asase so,</para>
  <para style="q2" vid="ZEP 2:3">mo a moyɛ nʼahyɛdeɛ.</para>
  <para style="q1" vid="ZEP 2:3">Monhwehwɛ tenenee, monhwehwɛ ahobrɛaseɛ;</para>
  <para style="q2" vid="ZEP 2:3">ebia ɔbɛkora mo</para>
  <para style="q2" vid="ZEP 2:3">
    <char style="nd">Awurade</char> abufuo ɛda no.<verse eid="ZEP 2:3"/></para>
  <para style="s1">Atemmuo A Ɛtia Filistia</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4"/>Wɔbɛgya Gasa</para>
  <para style="q2" vid="ZEP 2:4">na wɔagya Askelon sɛ kurofo.</para>
  <para style="q1" vid="ZEP 2:4">Owigyinaeɛ na ɔbɛma Asdod ada mpam</para>
  <para style="q2" vid="ZEP 2:4">na wɔatutu Ekron ase.<verse eid="ZEP 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5"/>Monnue mo a mote mpoano,</para>
  <para style="q2" vid="ZEP 2:5">Ao, mo Keretifoɔ;</para>
  <para style="q1" vid="ZEP 2:5">
    <char style="nd">Awurade</char> asɛm tia mo.</para>
  <para style="q2" vid="ZEP 2:5">Ao, Kanaan, Filistifoɔ asase.</para>
  <para style="q1" vid="ZEP 2:5">Mɛtɔre mo ase,</para>
  <para style="q2" vid="ZEP 2:5">na obiara renka.<verse eid="ZEP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6"/>Asase a ɛda mpoano, baabi a Keretifoɔ teɛ</para>
  <para style="q2" vid="ZEP 2:6">bɛyɛ atenaeɛ ama nnwanhwɛfoɔ</para>
  <para style="q2" vid="ZEP 2:6">ne wɔn nnwammuo.<verse eid="ZEP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7"/>Saa asase no bɛyɛ Yudafie nkaeɛfoɔ no dea;</para>
  <para style="q2" vid="ZEP 2:7">ɛhɔ na wɔbɛnya mmoa adidibea.</para>
  <para style="q1" vid="ZEP 2:7">Anwummerɛ wɔbɛdeda wɔ</para>
  <para style="q2" vid="ZEP 2:7">Askelon afie mu.</para>
  <para style="q1" vid="ZEP 2:7">Na <char style="nd">Awurade</char>, wɔn Onyankopɔn bɛhwɛ wɔn,</para>
  <para style="q2" vid="ZEP 2:7">na ɔde wɔn ahonyadeɛ nyinaa bɛsane ama wɔn.<verse eid="ZEP 2:7"/></para>
  <para style="s1">Atemmuo A Ɛtia Moab Ne Amon</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8"/>“Mate Moab nsopa ne</para>
  <para style="q2" vid="ZEP 2:8">Amonfoɔ atweetweɛ;</para>
  <para style="q1" vid="ZEP 2:8">wɔn a wɔsopaa me nkurɔfoɔ</para>
  <para style="q2" vid="ZEP 2:8">na wɔhunahunaa wɔn wɔ wɔn asase ho.<verse eid="ZEP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9"/>Enti, sɛ mete ase yi,”</para>
  <para style="q2" vid="ZEP 2:9">sɛdeɛ Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ZEP 2:9">Israel Onyankopɔn, seɛ nie,</para>
  <para style="q1" vid="ZEP 2:9">“Ampa ara Moab bɛyɛ sɛ Sodom,</para>
  <para style="q2" vid="ZEP 2:9">na Amonfoɔ ayɛ sɛ Gomora,</para>
  <para style="q1" vid="ZEP 2:9">baabi a ewira ne nkyɛn amena wɔ,</para>
  <para style="q2" vid="ZEP 2:9">asase a ɛda mpan afebɔɔ.</para>
  <para style="q1" vid="ZEP 2:9">Me ɔman nkaeɛ bɛfom wɔn afa;</para>
  <para style="q2" vid="ZEP 2:9">me manfoɔ a wɔbɛnya wɔn ti adidim bɛfa wɔn asase.”<verse eid="ZEP 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10"/>Wɔn ahantan so akatua a wɔbɛnya nie,</para>
  <para style="q2" vid="ZEP 2:10">sɛ wɔsopa na wɔtwetwe Asafo <char style="nd">Awurade</char> nkurɔfoɔ enti.<verse eid="ZEP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11"/>
    <char style="nd">Awurade</char> ho suro bɛba wɔn so</para>
  <para style="q2" vid="ZEP 2:11">ɛberɛ a ɔbɛsɛe asase no so anyame nyinaa.</para>
  <para style="q1" vid="ZEP 2:11">Mpoano aman nyinaa bɛsɔre no,</para>
  <para style="q2" vid="ZEP 2:11">wɔ wɔn ankasa wɔn asase so.<verse eid="ZEP 2:11"/></para>
  <para style="s1">Atemmuo A Ɛtia Kus</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12"/>“Mo Etiopiafoɔ nso,</para>
  <para style="q2" vid="ZEP 2:12">mʼakofena ano na wɔbɛkunkum mo.”<verse eid="ZEP 2:12"/></para>
  <para style="s1">Atemmuo A Ɛtia Asiria</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13"/>
    <char style="nd">Awurade</char> bɛtene ne nsa wɔ atifi aman so</para>
  <para style="q2" vid="ZEP 2:13">na wasɛe Asiria,</para>
  <para style="q1" vid="ZEP 2:13">na wama Ninewe ada mpan koraa</para>
  <para style="q2" vid="ZEP 2:13">na ɛso awo wesee sɛ anwea pradada so.<verse eid="ZEP 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14"/>Nnwankuo ne anantwie bɛdeda hɔ,</para>
  <para style="q2" vid="ZEP 2:14">mmoadoma nyinaa.</para>
  <para style="q1" vid="ZEP 2:14">Ɛserɛ so patuo ne ɔbonsam anoma</para>
  <para style="q2" vid="ZEP 2:14">bɛtena nʼadum no so.</para>
  <para style="q2" vid="ZEP 2:14">Wɔn su bɛgyegye mpomma mu,</para>
  <para style="q1" vid="ZEP 2:14">mmubuiɛ bɛsisi apono ano akwan,</para>
  <para style="q2" vid="ZEP 2:14">mpunan a wɔde ntweneduro ayɛ no ho bɛdeda hɔ.<verse eid="ZEP 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15"/>Yei ne kuropɔn a ɛdi ahurisie</para>
  <para style="q2" vid="ZEP 2:15">na ɛte asomdwoeɛ mu.</para>
  <para style="q1" vid="ZEP 2:15">Ɔhoahoa ne ho sɛ,</para>
  <para style="q2" vid="ZEP 2:15">“Me ne no, obiara nte sɛ me.”</para>
  <para style="q1" vid="ZEP 2:15">Hwɛ sɛ deɛ atete apansam,</para>
  <para style="q2" vid="ZEP 2:15">na ayɛ nkeka mmoa atenaeɛ!</para>
  <para style="q1" vid="ZEP 2:15">Obiara a ɔtwam hɔ no sere no,</para>
  <para style="q2" vid="ZEP 2:15">hugya ne nsa fɛdie so.<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s1">Yerusalem Daakye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1"/>Nnome nka nhyɛsofoɔ kuropɔn</para>
  <para style="q2" vid="ZEP 3:1">atuateɛ kuropɔn a ɛho agu fi!<verse eid="ZEP 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2"/>Ɔnnyɛ ɔsetie mma obiara</para>
  <para style="q2" vid="ZEP 3:2">ɔnnye nteɛsoɔ biara nto mu.</para>
  <para style="q1" vid="ZEP 3:2">Ɔmfa ne ho nto <char style="nd">Awurade</char> so.</para>
  <para style="q2" vid="ZEP 3:2">Ɔntwi mmɛn ne Onyankopɔn.<verse eid="ZEP 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3"/>Nʼakandifoɔ yɛ agyata a wɔbobɔ mu,</para>
  <para style="q2" vid="ZEP 3:3">ne sodifoɔ yɛ mpataku a wɔnam anadwo,</para>
  <para style="q1" vid="ZEP 3:3">a wɔnnya biribiara mma adekyeɛ.<verse eid="ZEP 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4"/>Ne nkɔmhyɛfoɔ yɛ ahantan;</para>
  <para style="q2" vid="ZEP 3:4">wɔyɛ afatwafoɔ.</para>
  <para style="q1" vid="ZEP 3:4">Nʼasɔfoɔ gu kronkronbea ho fi.</para>
  <para style="q2" vid="ZEP 3:4">Wɔnam mmara no so di nsɛmmɔne.<verse eid="ZEP 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5"/>
    <char style="nd">Awurade</char> a ɔte ne mu no yɛ ɔteneneeni;</para>
  <para style="q2" vid="ZEP 3:5">ɔnnyɛ mfomsoɔ biara.</para>
  <para style="q1" vid="ZEP 3:5">Adekyeeɛ biara ɔda ne tenenee adi,</para>
  <para style="q2" vid="ZEP 3:5">na ɔnni hwammɔ da,</para>
  <para style="q2" vid="ZEP 3:5">nanso amumuyɛfoɔ deɛ wonnim aniwuo.<verse eid="ZEP 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6"/>“Masɛe amanaman;</para>
  <para style="q2" vid="ZEP 3:6">madwiri wɔn abandenden agu.</para>
  <para style="q1" vid="ZEP 3:6">Wɔn mmorɔno so adeda mpan,</para>
  <para style="q2" vid="ZEP 3:6">a obiara ntwa mu hɔ.</para>
  <para style="q1" vid="ZEP 3:6">Wɔaseɛ wɔn nkuropɔn;</para>
  <para style="q2" vid="ZEP 3:6">a obi biara renka.<verse eid="ZEP 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7"/>Meka kyerɛɛ kuropɔn no sɛ,</para>
  <para style="q2" vid="ZEP 3:7">‘ampa ara wobɛsuro me</para>
  <para style="q1" vid="ZEP 3:7">na woagye nteɛsoɔ ato mu!’</para>
  <para style="q1" vid="ZEP 3:7">Na afei ne tenaberɛ rensɛe,</para>
  <para style="q2" vid="ZEP 3:7">na mʼasotwe biara nso remma ne so.</para>
  <para style="q1" vid="ZEP 3:7">Nanso, wɔn ho peree wɔn</para>
  <para style="q2" vid="ZEP 3:7">sɛ wɔbɛkɔso ayɛ bɔne wɔn nneyɛeɛ nyinaa mu.<verse eid="ZEP 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8"/>Enti, twɛn me,” sɛdeɛ <char style="nd">Awurade</char> seɛ nie,</para>
  <para style="q2" vid="ZEP 3:8">“na ɛda no mɛsɔre adi adanseɛ.</para>
  <para style="q1" vid="ZEP 3:8">Mayɛ mʼadwene sɛ mɛboaboa amanaman</para>
  <para style="q2" vid="ZEP 3:8">ne ahennie ano</para>
  <para style="q1" vid="ZEP 3:8">na mahwie mʼabufuo agu wɔn so</para>
  <para style="q2" vid="ZEP 3:8">mʼabufuhyeɛ nyinaa.</para>
  <para style="q1" vid="ZEP 3:8">Me ninkuntwe abufuo ogya mu no,</para>
  <para style="q2" vid="ZEP 3:8">asase nyinaa bɛhye.<verse eid="ZEP 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9"/>“Afei mɛdwira nnipa no ano,</para>
  <para style="q2" vid="ZEP 3:9">na wɔn nyinaa abɔ <char style="nd">Awurade</char> din</para>
  <para style="q2" vid="ZEP 3:9">na wɔaka abɔ mu asom no.<verse eid="ZEP 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10"/>Mʼasomfoɔ, me nkurɔfoɔ a wɔabɔ ahwete no</para>
  <para style="q2" vid="ZEP 3:10">bɛfiri nsubɔntene a ɛwɔ Kus nohoa</para>
  <para style="q2" vid="ZEP 3:10">de wɔn afɔrebɔdeɛ abrɛ me.<verse eid="ZEP 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11"/>Saa ɛda no, wo Yerusalem, wɔrengu wʼanim ase</para>
  <para style="q2" vid="ZEP 3:11">wɔ nneyɛeɛ bɔne a woayɛ atia me ho,</para>
  <para style="q1" vid="ZEP 3:11">ɛfiri sɛ mɛyi afiri saa kuropɔn yi mu,</para>
  <para style="q2" vid="ZEP 3:11">wɔn a wodi ahantan mu ahurisie</para>
  <para style="q1" vid="ZEP 3:11">na worenyɛ ahantan bio</para>
  <para style="q2" vid="ZEP 3:11">wɔ me bepɔ kronkron no so.<verse eid="ZEP 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12"/>Nanso mɛgya wɔ wo mu</para>
  <para style="q2" vid="ZEP 3:12">wɔn a wɔdwo na wɔbrɛ wɔn ho ase,</para>
  <para style="q2" vid="ZEP 3:12">na wɔde wɔn ho to <char style="nd">Awurade</char> so.<verse eid="ZEP 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13"/>Israel nkaeɛfoɔ renyɛ bɔne</para>
  <para style="q2" vid="ZEP 3:13">Wɔrenka nkontonpo nsɛm,</para>
  <para style="q1" vid="ZEP 3:13">na wɔn ano renka nnaadaa nsɛm</para>
  <para style="q2" vid="ZEP 3:13">wɔbɛdidi na wɔada</para>
  <para style="q2" vid="ZEP 3:13">na obiara renyi wɔn hu.”<verse eid="ZEP 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>To dwom Ao, Ɔbabaa Sion;</para>
  <para style="q2" vid="ZEP 3:14">team denden Ao, Israel!</para>
  <para style="q1" vid="ZEP 3:14">Ma wʼani nnye, na di ahurisie wɔ wʼakoma nyinaa mu,</para>
  <para style="q2" vid="ZEP 3:14">Ao, Ɔbabaa Yerusalem!<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>Ɛfiri sɛ, <char style="nd">Awurade</char> ayi wʼasotweɛ afiri wo so,</para>
  <para style="q2" vid="ZEP 3:15">wama wo ɔtamfoɔ asane nʼakyi.</para>
  <para style="q1" vid="ZEP 3:15">
    <char style="nd">Awurade</char> Israelhene ka wo ho;</para>
  <para style="q2" vid="ZEP 3:15">worensuro ɔhaw biara bio.<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>Saa ɛda no, wɔbɛka akyerɛ Yerusalem sɛ,</para>
  <para style="q2" vid="ZEP 3:16">“Mma nsuro, Ao Sion!</para>
  <para style="q2" vid="ZEP 3:16">Mma wo nsa mu nhodwo.<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>
    <char style="nd">Awurade</char> wo Onyankopɔn ne wo wɔ hɔ,</para>
  <para style="q2" vid="ZEP 3:17">Ɔyɛ ɔgyefoɔ ɔhoɔdenfoɔ.</para>
  <para style="q1" vid="ZEP 3:17">Nʼani bɛgye wo ho</para>
  <para style="q2" vid="ZEP 3:17">ɔfiri ne dɔ mu bɛdwodwo wo,</para>
  <para style="q2" vid="ZEP 3:17">ɔde nnwontoɔ bɛma nʼani agye wo ho.<verse eid="ZEP 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>“Mo awerɛhoɔ to bɛtwa</para>
  <para style="q2" vid="ZEP 3:18">ɛfiri sɛ mobɛnya ɛkwan adi mo afahyɛ no;</para>
  <para style="q2" vid="ZEP 3:18">mo anim rengu ase bio.<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>Saa ɛberɛ no me ne wɔn</para>
  <para style="q2" vid="ZEP 3:19">a wɔhyɛɛ wo so nyinaa bɛdi;</para>
  <para style="q1" vid="ZEP 3:19">Mɛgye mmerɛyɛfoɔ</para>
  <para style="q2" vid="ZEP 3:19">na mɛboaboa wɔn a wɔabɔ wɔn ahwete no ano.</para>
  <para style="q1" vid="ZEP 3:19">Mɛkamfo wɔn ahyɛ wɔn animuonyam</para>
  <para style="q2" vid="ZEP 3:19">asase biara a wɔguu wɔn anim ase wɔ so no so.<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>Saa ɛda no, mɛboaboa wo ano,</para>
  <para style="q2" vid="ZEP 3:20">na mede wo aba fie.</para>
  <para style="q1" vid="ZEP 3:20">Mɛhyɛ wo animuonyam na makamfo wo</para>
  <para style="q2" vid="ZEP 3:20">wɔ asase so nnipa nyinaa mu</para>
  <para style="q1" vid="ZEP 3:20">na mede wʼahonyadeɛ bɛsane ama wo</para>
  <para style="q2" vid="ZEP 3:20">na wode wʼani bɛhunu,”</para>
  <para style="q2" vid="ZEP 3:20">sɛdeɛ <char style="nd">Awurade</char> ka nie.<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
