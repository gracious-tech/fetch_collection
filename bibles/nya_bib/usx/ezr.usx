      <cell style="tcr2" align="end">775</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:5"/><verse number="6" style="v" sid="EZR 2:6"/>zidzukulu za Pahati-Mowabu (zochokera kwa Yesuwa ndi Yowabu) </cell>
      <cell style="tcr2" align="end">2,812</cell>
    </row>
