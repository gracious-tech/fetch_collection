      <cell style="tcr2" align="end">454</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:15"/><verse number="16" style="v" sid="EZR 2:16"/>zidzukulu za Ateri (kudzera mwa Hezekiya) </cell>
      <cell style="tcr2" align="end">98</cell>
    </row>
    <row style="tr">
