    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:18"/><verse number="19" style="v" sid="EZR 2:19"/>zidzukulu za Hasumu </cell>
      <cell style="tcr2" align="end">223</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:19"/><verse number="20" style="v" sid="EZR 2:20"/>zidzukulu za Gibari </cell>
      <cell style="tcr2" align="end">95.</cell>
    </row>
  </table>
  <para style="b" vid="EZR 2:20">
    <verse eid="EZR 2:20"/>
  </para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse number="21" style="v" sid="EZR 2:21"/>Anthu a ku Betelehemu </cell>
      <cell style="tcr2" align="end">123</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:21"/><verse number="22" style="v" sid="EZR 2:22"/>Anthu aamuna a ku Netofa </cell>
      <cell style="tcr2" align="end">56</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:22"/><verse number="23" style="v" sid="EZR 2:23"/>Anthu aamuna a ku Anatoti </cell>
      <cell style="tcr2" align="end">128</cell>
    </row>
