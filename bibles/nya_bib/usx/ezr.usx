      <cell style="tcr2" align="end">1,222</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:12"/><verse number="13" style="v" sid="EZR 2:13"/>zidzukulu za Adonikamu </cell>
      <cell style="tcr2" align="end">666</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:13"/><verse number="14" style="v" sid="EZR 2:14"/>zidzukulu za Bigivai </cell>
