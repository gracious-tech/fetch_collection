      <cell style="tc1" align="start">   <verse eid="EZR 2:23"/><verse number="24" style="v" sid="EZR 2:24"/>Anthu aamuna a ku Azimaveti </cell>
      <cell style="tcr2" align="end">42</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">   <verse eid="EZR 2:24"/><verse number="25" style="v" sid="EZR 2:25"/>Anthu aamuna a ku Kiriati Yearimu, Kefira ndi Beeroti </cell>
