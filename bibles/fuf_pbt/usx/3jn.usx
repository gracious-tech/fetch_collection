<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.5">
  <book code="3JN" style="id">Bible in Fouta-Jalon Pular</book>
  <para style="ide">© Pioneer Bible Translators - Republic of Guinea, West Africa -- April 2009</para>
