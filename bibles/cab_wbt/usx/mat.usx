<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="MAT" style="id">- Garifuna NT -Honduras 2012 (DBL -2013)</book>
  <para style="h">SAN MATEO</para>
  <para style="toc1">Ugánu Buíti le Labǘrüjabei Matéo luágu Jesúsu</para>
  <para style="toc2">San Mateo</para>
  <para style="toc3">Mt</para>
  <para style="mt">UGÁNU BUÍTI LE LABǗRÜJABEI MATÉO LUÁGU JESÚSU</para>
  <chapter number="1" style="c" />
  <para style="s">Linébaanfaangu Jesúsu</para>
  <para style="r">(<ref loc="LUK 3:23-38">Lc 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Niján jíri linébaanfaangu Jesucrístu le jádaangiñebei meja ladǘgawagun Davíd lúma Abrahám.</para>
  <para style="p">
    <verse number="2" style="v" />Abrahám lúguchibei Isáac, Isáac lúguchi Jacób, Jacób lúguchi Judá jáu lamúlenu, <verse number="3" style="v" />Judá lúguchi Fáres lúma Zára, Támar tugúya jáguchu, Fáres lúguchi Esróm, Esróm lúguchi Arám, <verse number="4" style="v" />Arám lúguchi Aminadáb, Aminadáb lúguchi Naasón, Naasón lúguchi Salmón, <verse number="5" style="v" />Salmón lúguchi Booz, Raháb lúguchu, Booz lúguchi Óbed, Rut lúguchu, Óbed lúguchi Isaí, <verse number="6" style="v" />Isaí lúguchi urúei Davíd, urúei Davíd túma tó meja lúmari Urías, jagía lagǘbürigubaña Salomón.</para>
  <para style="p">
    <verse number="7" style="v" />Salomón lúguchibei Roboám, Roboám lúguchi Abías, Abías lúguchi Ása, <verse number="8" style="v" />Ása lúguchi Josafát, Josafát lúguchi Jorám, Jorám lúguchi Uzías, <verse number="9" style="v" />Uzías lúguchi Jótam, Jótam lúguchi Ácaz, Ácaz lúguchi Ezequías, <verse number="10" style="v" />Ezequías lúguchi Manasés, Manasés lúguchi Amón, Amón lúguchi Josías, <verse number="11" style="v" />Josías lúguchi Jeconías jáu lamúlenu lídan dan le janáanwagunbei Israelítagu adáürawagua Babilónia.</para>
  <para style="p">
    <verse number="12" style="v" />Lárigiñe le, Jeconías lúguchibei Salatiél, Salatiél lúguchi Zorobabél, <verse number="13" style="v" />Zorobabél lúguchi Abiúd, Abiúd lúguchi Eliaquím, Eliaquím lúguchi Azór, <verse number="14" style="v" />Azór lúguchi Sadóc, Sadóc lúguchi Aquím, Aquím lúguchi Eliúd, <verse number="15" style="v" />Eliúd lúguchi Eleázar, Eleázar lúguchi Matán, Matán lúguchi Jacób, <verse number="16" style="v" />Jacób lúguchi José le túmari María, tugúyati lúguchuboun Jesúsu le gíribei Crístu.</para>
  <para style="p">
    <verse number="17" style="v" />Catoúrusuñanu lubeíti linébaanfaangu Jesúsu lúmagiñe Abrahám lúmoun Davíd, catoúrusu lúmagiñe Davíd lúmoun janáanwagúniwa Israelítagu Babilónioun, catoúrusu lúmagiñe dan ligía lúmoun lagǘriajoún Crístu.</para>
  <para style="s">Lagǘriajoún Crístu</para>
  <para style="r">(<ref loc="LUK 2:1-7">Lc 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Ítara líña ligáburi lagǘriajoún Jesucrístu. María to lúguchu, gadáraduñoun lúma José lun tamárieidun lúma, lubáragiñeti jaganoún jámagua, lubáragiñe lasúbudirunun quei wǘri, ába tadáriragun túngua láu dagáñu tíña lan láu lubáfu Sífiri Sándu. <verse number="19" style="v" />Quei ában lubeí wügǘri buídu tigáburi José le tadári, májati lasúbudirúniwa le asúseredubei tun María, busénrügüti lígirunun, míchugunga tidúnrun. <verse number="20" style="v" />Dan le niján lubeí arítagua luágu cátei le, ligía larúfudagun ában láni Wabúreme Búngiu ánjeli lúngua lun lídan luwénedi, ába laríñagun lun.</para>
  <para style="p">—José, ladǘgawagun Davíd, manúfudebá lun berésibirunun María queísi búmari, ladǘga irájü le lúnbei tagáraüduni, lúmagiñe Sífiri Sándu liábin. <verse number="21" style="v" />Tagáraüduba ában irájü, ábame bíchuguni líri Jesúsu. Ítara lúba líri ladǘga lasálbarubaña lan lumútuniña lídaangiñe jafígoun.</para>
  <para style="p">
    <verse number="22" style="v" />Lasúseredunbei sun cátei le lun lagúnfulirun dimúrei le laríñagubei Wabúreme Búngiu liyúmulugugiñe proféta.</para>
  <para style="q1">
    <verse number="23" style="v" />Tadágeinaduba ában irájü, ábame tagáraüdun ában irájü, Emanuél, ligíaba líri,</para>
  <para style="m">líla íri ligía, “Búngiu wáma”.</para>
  <para style="p">
    <verse number="24" style="v" />Dan le lagágudunbei José lídaangiñe uwénedi ligía, ába ladǘgüni le lubeíbei ánjeli ligía lun, ába lerésibirunun María queísi lúmari, <verse number="25" style="v" />masúbudirúngaloún queísi wǘri darí tagǘriajani furúmiñeti tiraǘ, ába líchuguni líri Jesúsu.</para>
  <chapter number="2" style="c" />
  <para style="s">Jachǘlürün chu táu aríjei Jesúsu</para>
  <para style="p">
    <verse number="1" style="v" />Lídan fulásu le gíribei Belén, lumúanrugu Judéa, ñi lagǘriajoúa Jesúsu dán meja le Heródes lan urúeibei lídan jageíra juríu. Ábati jachǘlürün fiú wügǘriña chu táu ubúrugun Jerusalén lueígiñe oúbaü le ñígiñe lubeí laboúcha wéyu. <verse number="2" style="v" />Ába jálügüdajan.</para>
  <para style="p">—¿Jageísan jarúeite juríu le agǘriajoúbei? Aríja wamáaru luwáruguman le ñígiñe lubeí láfuara wéyu, wayábiñati lun wájuduragun lun.</para>
  <para style="p">
    <verse number="3" style="v" />Dan le lagáambuni urúei Heródes cátei le, ába medéraguagüdünjaali lan, jáu sun Jerusalénna. <verse number="4" style="v" />Ábati lagúarun joun sun jábutigu fádirigu lídan jafíñen juríu, jáma ja arúfudajabalin lilúrudun Moisés joun gürígia, ába lálügüdaguniña jalíabei lan libíti fulásu lagǘriajoúa Crístu. <verse number="5" style="v" />Ába jaríñagun lun.</para>
  <para style="p">—Belén, le lumúanrugubei Judéa, ladǘga ítara líña labǘrüdüni proféta.</para>
  <para style="q1">
    <verse number="6" style="v" />Amǘrü Belén, lumúanruguna Judéa,</para>
  <para style="q1">amǘrü ában lídaangiñe ubúrugu weírigutimaati lídan múa le, láu sun biñǘraü,</para>
  <para style="q1">ladǘga láfuriduba ában ábuti bídaangiñe</para>
  <para style="q1">le lúnbei loúnigiruniña numútuniña ja Israelítagu.</para>
  <para style="p">
    <verse number="7" style="v" />Ábati lagúarun Heródes joun chu táu arámudaguarügü, ába lálügüdüniña luágutima dan le tarúfudaguagüle warúguma túngua joun. <verse number="8" style="v" />Ábati loúnajaniña Belén, laríñaga joun.</para>
  <para style="p">—Jeíba, ábame jáluajani irájü le buídu, dánme le darí jumaali, jawísaraname, ñǘdün námuga gíñe ájuduragua lun.</para>
  <para style="p">
    <verse number="9" style="v" />Lárigiñe jagáambuni chu táu lerérun urúei, ába joúdin. Warúguma bugáti to jaríjuboun le ñígiñe lubeí láfuara wéyu, ába tídin jabá jabá, darí taráramun loúgiñe fulásu le ñí lubei irájü le. <verse number="10" style="v" />Dan le jaríjinun chu táu ja warúguma, ába jagúndaaragun sarágu. <verse number="11" style="v" />Dánti le jebélurun tídoun múna, ába jaríjini irájü le túma lúguchu to María. Ábati jájuduragun, ába jabúluchagun lun. Ába jánjunrenchunun jagáfun, ába jedéweejan gólu lúma cupáli jémeti lun, lúma ában luwúyeri árani gífiti. <verse number="12" style="v" />Lárigiñe, ába jawísarúniwa lídan jawénedi lun magíribudun jamá ñígiñe lubeí Heródes, ába jagíribudun jageíroun lídaangiñe ámu ǘma.</para>
  <para style="s">Anúrajani lun Ejíptoun</para>
  <para style="p">
    <verse number="13" style="v" />Lárigiñe joúdin chu táu jagía, ába larúfudagun ába láni Búngiu ánjeli lúngua lun José lídan luwénedi, ába laríñagun lun.</para>
  <para style="p">—Sarába, barǘbei irájü le táu sun lúguchu, anúrabá Ejíptoun, ábame beréderun ñi daríme nawísarunibu, ladǘga láluajaali Heródes irájü le lun láfaruni jilágubei.</para>
  <para style="p">
    <verse number="14" style="v" />Ábati lásaarun José, ába lanǘgüni irájü táu sun lúguchu áriebu ligía, ába lídin jáu Ejíptoun. <verse number="15" style="v" />Ába jeréderun ñi darí loúnwen Heródes. Lasúseredunbei sun le lun lagúnfulirun le laríñagubei Búngiu liyúmulugugiñe proféta. “Sagá numuti Niraǘ Ejíptogiñe.”</para>
  <para style="s">Láfaraguágüdüniña Heródes irájüñü</para>
  <para style="p">
    <verse number="16" style="v" />Dan le ladáriragun Heródes lúngua luágu yéegua jamá lan chu táu, ába lagáñidun, ába loúnajan áfaraguaña sun irájüñü ja biáma tíña irúmu jáu lun ǘnabun, ja aganoúbaña Belén lúma sun fulásu geyégua láu, según dan le jaríñagubei chu táu luágu lagǘriajoúniwa irájü ligía. <verse number="17" style="v" />Ítara líña lagúnfulirun le labǘrüjabei proféta Jeremías.</para>
  <para style="q1">
    <verse number="18" style="v" />Agaambúati lagúarajan ában umálali Ramá láu oúnwenbun igárigu,</para>
  <para style="q1">umálali ligía tumálali Raquél, to ayájuboun járigi tirájüñü,</para>
  <para style="q1">mabúseeruntu lun támalijoún ladǘga jilágua jamá.</para>
  <para style="p">
    <verse number="19" style="v" />Lárigiñe loúnwen Heródes, ába liábin ába láni Búngiu ánjeli lun José lídan luwénedi yágüta Ejípto, ába laríñagun lun.</para>
  <para style="p">
    <verse number="20" style="v" />—Sarába, barǘbei irájü le táu sun lúguchu, giríbu jumá jageíroun Israelítagu ladǘga jilágua ja abúseerubaña meja jáfaruni irájü le.</para>
  <para style="p">
    <verse number="21" style="v" />Ába lásaarun José, ába lanǘgüni irájü táu sun lúguchu jageíroun Israelítagu. <verse number="22" style="v" />Dan le lasúbudiruni José luágu Arqueláo lan agúmadijabei Judéa lewéñegua Heródes le lúguchi, ába lanúfudedun lídin ñíjin, ába laríñawagúniwa lun lídan uwénedi lun lídin Galiléoun. <verse number="23" style="v" />Lachǘlürün ñi, ába lídin agánawa lídan fulásu le gíribei Nazarét, le lumúanrugubei Galiléa. Lasúseredunbei sun cátei le lun lagúnfulirun le jaríñagubei profétagu luágu Nazarétna lan Jesúsu.</para>
  <chapter number="3" style="c" />
  <para style="s">Lapúrichijan Juan le abásteragüdajabei lídan fulásu mageírawati</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mr 1.1-8</ref>; Lc 3.1-9, 15-17; <ref loc="JHN 1:19-28">Jn 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Lídoun dan ligía, ába liábin Juan le abásteragüdajabei apúrichija lídan fulásu mageírawati, Judéa, <verse number="2" style="v" />ába laríñagun lídan lapúrichijan.</para>
  <para style="p">—Sáansi jumeí joúserun, ladǘga yaráfaali larúeijan Búngiu.</para>
  <para style="p">
    <verse number="3" style="v" />Juan le, ligía le uágubei meja labǘrüja proféta Isaías ítara.</para>
  <para style="q1">Agaambúati lumálali ában gürígia agúaraja lídan fulásu mageírawati ítara.</para>
  <para style="q1">“Aráanse jumoún janígi lubá liábin Wabúreme,</para>
  <para style="q1">queísi ladárarúniwa ǘma surúti.”</para>
  <para style="p">
    <verse number="4" style="v" />Lanáangun Juan, láutu lúra caméyu, liábin lagǘrüga liránaagua, guéru, chigángaru leígubaña lúma síruudu le áraabuna. <verse number="5" style="v" />Ábaja jayábin ubúrugugiñe Jerusalén, lúma Judéagiñe, lúma lubádugiñe dúna Jordán agáambei lapúrichijan, <verse number="6" style="v" />dántija le jagúfeseruni jafígoun, ába labásteragüdüniña lídan dúna le gíribei Jordán.</para>
  <para style="p">
    <verse number="7" style="v" />Dan le laríjin Juan luágu sarágu jáña lan gürígia lídaangiñetiña jadámurin fariséogu jáma saduséogu ñǘbintiña lun jabásterun, ába laríñagun joun.</para>
  <para style="p">—¡Jarásan jéwe jugúya le! ¿Ca awísarubadün lun janúrajan lueí lanárime afáyeiragülei luágu figoú le lúnbei liábin? <verse number="8" style="v" />Oúsera jumá buídu, arijúa lámuga furáangu luágu sáansigua lan ligáburi joúserun. <verse number="9" style="v" />Mapántajan jugúyame, aríñaga jídaangua. “Linébaanfaangu Abrahám wagía”, ladǘga naríñajare jun luágu gayára lan ladǘgün Búngiu linébaanfaangu Abrahám lídaangiñe dǘbü le. <verse number="10" style="v" />Madíseeli lagúnfulirun le laríñagubei Búngiu, luágu yaráfaali lan lidáani abeichúni luágu figoú, aráanseeru jaráwa lun lánchuajoún wéwe, áni sun wéwe le mabuídunti lin, chaǘnwati, ába lagudún. <verse number="11" style="v" />Áu, láu dúna nabásteragüdaün, arúfudei luágu sáansi jumáali lan ligáburi joúserun, ánjeinti le lúnbei liábin nárigi, labásteragüdübadün láu Sífiri Sándu, áni lafáyeiragüdübadün luágu figoú queísi láu wátu geméti. Gabáfuti nueí darí lun madǘna nan ni lun narágachunun ligeídin. <verse number="12" style="v" />Nújeinjaru lichóbulin lújaburugu, larúmadagüdübei türígu, ábame lanúadiruni lídaangiñe sagádi mábeijali. Ábame lareíduni türígu, ábame láguduni sagádi le mábeijali lídan wátu geméti le méñeguchadibei.</para>
  <para style="s">Labásterun Jesúsu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mr 1.9-11</ref>; <ref loc="LUK 3:21-22">Lc 3.21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Dan le liábin Jesúsu Galiléagiñe, ába lachǘlürün luágun dúna le gíribei Jordán le ñí lubei Juan lun labásteragüdüni. <verse number="14" style="v" />Májati yebéti Juan labásteragüdüni, ába laríñagun lun Jesúsu.</para>
  <para style="p">—Nugúya lúnbei babásteragüdünina, ¿amǘrü lubeí ñǘbin nun lun nabásteragüdünibu?</para>
  <para style="p">
    <verse number="15" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Ítara lúba guetó, ladǘga lúnti wadǘgüni le lubeíbei Búngiu.</para>
  <para style="p">Ába labásteragüdüni Juan Jesúsu, <verse number="16" style="v" />lárigiñe labásterun Jesúsu, ába láfuridun dúnarugugiñe. Sódini ába lánjunrenchagun siélu, ába laríjini Jesúsu Sífiri Sándu larárirun camá ában únjun liábin luágun. <verse number="17" style="v" />Ába lagaambún ába umálali siélugiñe le aríñagubei.</para>
  <para style="p">—Niraǘ le jínsiñebei nun le, le áubei oúnwenbun lan nugúndan.</para>
  <chapter number="4" style="c" />
  <para style="s">Loúchaguni Máfia Jesúsu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mr 1.12-13</ref>; <ref loc="LUK 4:1-13">Lc 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ába lanǘgüni Sífiri Sándu Jesúsu lídoun fulásu mageírawati lun loúchaguni Máfia.</para>
  <para style="p">
    <verse number="2" style="v" />Lárigiñe leréderun Jesúsu bián-wein wéyu lúma bián-wein áriebu meíginga, ába lalámachun. <verse number="3" style="v" />Ábati liábin Máfia lubádun, ába laríñagun lun lun loúchaguni.</para>
  <para style="p">—Ánjein liraǘ bubei Búngiu, salíguagüdabeí dǘbü le feínme.</para>
  <para style="p">
    <verse number="4" style="v" />Ába loúnabun Jesúsu.</para>
  <para style="p">—Taríñajare Lerérun Búngiu. “Mámarügübei táu fein labágarida gürígia, labágariduba gíñe láu sun dimúrei le laríñagubei Búngiu.”</para>
  <para style="p">
    <verse number="5" style="v" />Ábati lanǘgüni Máfia Jesúsu Jerusaléoun, ubúrugu le sándubei joun juríu, ába laweínragüdüni tábulugun témpulu, <verse number="6" style="v" />ába laríñagun lun.</para>
  <para style="p">—Ánjein liraǘ bubei Búngiu, chubába yágiñe lun ǘnabun, ladǘga taríñajare Lerérun Búngiu.</para>
  <para style="q1">Laríñaguba Búngiu joun láni ánjeligu lun joúnigirunibu.</para>
  <para style="q1">Janǘgübadibu jájaburugu lun machúgeragun lan bugúdi luágu dǘbü.</para>
  <para style="p">
    <verse number="7" style="v" />Ába loúnabuni Jesúsu.</para>
  <para style="p">—Aríñagatu gíñe Lerérun Búngiu. “Moúchaguabeí Babúreme Búngiu.”</para>
  <para style="p">
    <verse number="8" style="v" />Ába lanǘgüni Máfia Jesúsu luágun ában wǘbü íñuti, ába larúfuduni sun arúeijani le uboúagubei lun, lúma buri luweírigun, <verse number="9" style="v" />ába laríñagun lun.</para>
  <para style="p">—Níchugubei sun le bun ánjabu ájuduragua nun.</para>
  <para style="p">
    <verse number="10" style="v" />Ábati laríñagun Jesúsu lun.</para>
  <para style="p">—¡Beíba nueí, Máfia! ladǘga taríñajare Lerérun Búngiu. “Lúnrügüba Babúreme Búngiu bájuduragua, lúnrügüba gíñe besériwida.”</para>
  <para style="p">
    <verse number="11" style="v" />Ábati ladísedun Máfia lueí, ába jayábin ánjeligu esériwidei.</para>
  <para style="s">Lagúmeseruni Jesúsu luwádigimari, Galiléa</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mr 1.14-15</ref>; <ref loc="LUK 4:14-15">Lc 4.14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Dan le lagáambunbei Jesúsu luágu níjein lan Juan furísunrugu, ába lídin lárigoún Galiléoun. <verse number="13" style="v" />Merédeti Nazarét, ába lídin agánawa Capernaúm, ában fulásu le lárubei dúna lídan jageíra rása le Zabulón lúma Neftalí. <verse number="14" style="v" />Lasúseredunbei sun le lun lagúnfulirun le labǘrüjabeí meja Isaías, lé meja proféta.</para>
  <para style="q1">
    <verse number="15" style="v" />Lageíra Zabulón lúma Neftalí,</para>
  <para style="q1">lídan ǘma lubádu barána, lueígiñe oúbaü le ñígiñe lubeí láfuara wéyu libíti Jordán,</para>
  <para style="q1">Galiléa le ñí lubei jagánawa ja mámabaña juríu.</para>
  <para style="q1">
    <verse number="16" style="v" />Jugúya lé meja lídaanbei lubúriga aríjaadün ában oúnwenbun larúgounga,</para>
  <para style="q1">jugúya lé meja lídaanbei lamúñounga le lánina oúweni,</para>
  <para style="q1">jarúgoungagüdawaali jáu.</para>
  <para style="p">
    <verse number="17" style="v" />Lúmagiñe dan ligía, ába lagúmeserun Jesúsu apúrichija ñi ítara.</para>
  <para style="p">—Sáansi jumeí jigáburi, ladǘga yaráfaali larúeijan Búngiu.</para>
  <para style="s">Lagúarun Jesúsu joun gádürü esénijatiña lun lánime disípulugu</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mr 1.16-20</ref>; <ref loc="LUK 5:1-11">Lc 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Eíbugeina líña Jesúsu láru láru dúna Galiléa, ligía laríjin bián gamúlenuguátiña, ában jádaangiñe, Simón le méme gíribei Pédro, le ában, Andrés. Esénijani jabágaribei, jáguruñati. <verse number="19" style="v" />Ábati laríñagun Jesúsu joun.</para>
  <para style="p">—Falá jumana, ábame mesénijanjadün lan úduraü, anáajarügaadünme gürígia nun lun nánigume.</para>
  <para style="p">
    <verse number="20" style="v" />Furése furése ába jígirunun jasénin, ába joúdin lúma.</para>
  <para style="p">
    <verse number="21" style="v" />Lubáruaguoun mémeraü Jesúsu, ábaya laríjin bián gamúlenuguátiña, Jacóbo lúma Juan, lirájüñü Zebedéo. Tídaañanu ában ugúnein lúma jáguchi arámadajoun jasénin. Ába lagúarun Jesúsu joun lun lánime disípulugu, <verse number="22" style="v" />lídan óra ligía ába jígirunun ugúnein, ígira jáguchi, ába joúdin lúma Jesúsu.</para>
  <para style="s">Larúfudajan Jesúsu joun sarágu gürígia</para>
  <para style="r">(<ref loc="LUK 6:17-19">Lc 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" />Ábajei leíbuguni Jesúsu sun Galiléa arúfudajeina tídan buri jalígilisin juríu to lídaanboun ságü fulásu. Ábaja lapúrichijani ugánu buíti luágu larúeijan Búngiu, areídaguagüda ligía sun luwúyeri sándi le jawáguti gürígia. <verse number="24" style="v" />Ába lagaambúniwa luágu Jesúsu lídan sun Síria, ába janǘgüniña sun ja asúfurirubaña láu ámuñegueinarügü sándi, igárigu, ja gawágubaña lagǘbüri espíritu, ja goúwejadibaña, jáma ja derégüdaaña úgubu, ába lareídaguagüdüniña. <verse number="25" style="v" />Sarágu jáña gürígia afálaruti Galiléagiñe, lídaangiñé buri fulásu Decápolisna, Jerusaléngiñe, loúbawagugiñe Judéa, lúma lueígiñe oúbaü le ñígiñe lubeí laboúcha wéyu libíti Jordán.</para>
  <chapter number="5" style="c" />
  <para style="s">Lapúrichijan Jesúsu wǘbüwaügügiñe</para>
  <para style="p">
    <verse number="1" style="v" />Dan le laríjinbaliña Jesúsu sun gürígia jagía, ába laweínrun luágun ában wǘbü, ába lañúurun ñi. Ábati joúndaragun láni disípulugu geyégua láu, <verse number="2" style="v" />ába lagúmeserun arúfudaja joun ítara.</para>
  <para style="p">
    <verse number="3" style="v" />—Fuleíseiwatün jugúya le asúbudirubalin luágu mégei jumáni lídejan Búngiu lun jadǘgüni le labúseerubei, ladǘga méreengunbei jun lun jebélurun lídoun larúeijan Búngiu siélu.</para>
  <para style="p">
    <verse number="4" style="v" />‘Fuleíseiwatün jugúya le jírubei, ladǘga líchuguba Búngiu gurásu jun.</para>
  <para style="p">
    <verse number="5" style="v" />‘Fuleíseiwatün jugúya le ǘnabugubei, ladǘga jerésibirubei le uágubei laríñaga Búngiu luágu líchugubei lan jun.</para>
  <para style="p">
    <verse number="6" style="v" />‘Fuleíseiwatün jugúya le weíribei jabúseerun lúaradagun jabágaridun, ladǘga líderagubadün Búngiu lun jadǘgüni.</para>
  <para style="p">
    <verse number="7" style="v" />‘Fuleíseiwatün jugúya le gudémejabubei, ladǘga gudémebadün gíñe lun Búngiu.</para>
  <para style="p">
    <verse number="8" style="v" />‘Fuleíseiwatün jugúya le jarúmabei anígi, ladǘga jaríjubei Búngiu.</para>
  <para style="p">
    <verse number="9" style="v" />‘Fuleíseiwatün jugúya le áfaagubei lun jámalijan sun cátei, ladǘga lagúarubadün Búngiu queísi lirájüñü.</para>
  <para style="p">
    <verse number="10" style="v" />‘Fuleíseiwatün jugúya le asúfurirubei eíbaajoúni luágu lúaragun jibágari, ladǘga jebéluruba lídoun larúeijan Búngiu siélu.</para>
  <para style="p">
    <verse number="11" style="v" />‘Fuleíseiwatün dan le janábagunün gürígia, eíbaaja jamaǘn, aríñaga jagía sun luwúyeri iyéeni juágu, nueígiñe. <verse number="12" style="v" />Gúndaañu jumá, ladǘga jerésibiruba ában oúnwenbun fáyeiti siélu, ítara liñá meja gíñe jeíbaajoúniwa profétagu ja ñǘbinbaña jubáragiñe.</para>
  <para style="s">Ítara jíña queísi sálu lúma lámpu lun uboú</para>
  <para style="r">(<ref loc="MRK 9:50">Mr 9.50</ref>; <ref loc="LUK 14:34-35">Lc 14.34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Ába lasígirun Jesúsu aríñaga.</para>
  <para style="p">—Ítara jíña quei sálu joun lílana uboú le lun jeréderuniña lueí jagádeirun, ánjein leféridira sálu lubásuan, ¿cábagi un ju lan? Úaalime ju lan ni ca un lueídügüya lun lágurúniwa, ábame jadǘgüraguni gürígia.</para>
  <para style="p">
    <verse number="14" style="v" />‘Ítara jíña quei lámpu joun lílana uboú le. Ában ubúrugu le luáguti ában wǘbü siñáti larámudagun, furáanguti larijoúniwa. <verse number="15" style="v" />Mebedúnti gíñe ában lámpu lun líchugúniwa tábugiñe ában gáfu, luágu dábula líchugúa lun larúgoungadágüdün jáu sun ja múnadabaña. <verse number="16" style="v" />Ítara jumá gíñe, durúnguagüda jumeí jilámpun jádan gürígia, lun dánme lan jaríjini buíti le jadǘgübei, ábame gíñe jadímurejan buíti luágu Wáguchi Búngiu le siélubei.</para>
  <para style="s">Larúfudajan Jesúsu luágu lilúrudun Moisés</para>
  <para style="p">
    <verse number="17" style="v" />‘Marítagua jumátia luágu niábiña lan agídarei lilúrudun Moisés, ni le jarúfudajabei profétagu, máma niábiña agídarei, niábiña arúfudei líla le tímatimaati. <verse number="18" style="v" />Ninárün lubeíti jáu luágu níjeingua rügáali ligía lan siélu lúma uboú, magídarúnwabei ni ában púntu, ni ában létüra lídaangiñe lilúrudun Moisés daríme suséreeli le lúnbei lasúseredun. <verse number="19" style="v" />Ligía, le lubeí íchuguti mebéreseni luágu furúmierügü gumádi lídaangiñe lúrudu, íbini le lan ñǘraütimaabei lídaangiñe, arúfudaja ligía joun gürígia lun jadǘgüni líbe le ladǘgübei, ñǘraüraübei lanügǘniwa yágüta siélu lídan larúeijan Búngiu. Ánjeinti le ñǘdünbei láu sún buri gumádi lídan lúaragun, ítara gíñe larúfudajan, weíribei lanügǘniwa yágüta siélu. <verse number="20" style="v" />Naríñajare jun luágu ánjein lan mabuídun ligáburi joúserun sarágu weíyaasu jaweí arúfudajatiña lilúrudun Moisés, jáma fariséogu, mebélubadün lídoun larúeijan Búngiu siélu.</para>
  <para style="s">Larúfudajan Jesúsu luágu igáñi</para>
  <para style="r">(<ref loc="LUK 12:57-59">Lc 12.57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />‘Agáamba jumáali luágu aríñawagúa lán meja joun binádu jagǘbürigu lun máfarajan jamá, ladǘga furúmieguarügü lan le áfarajati, lagúseragüdǘwaba. <verse number="22" style="v" />Wel, naríñajare jun luágu furúmieguarügü lan le agáñiduti lúma gürígia líledi lagúseragüdǘwaba. Le anábuti gürígia líledi lagúseragüdǘbei luweírin-ágei lúrudu, le aríñaguti lun gürígia líledi, “ibídiougua táu”, luáguñein ǘma lun máfiougatin. <verse number="23" style="v" />Ítara líña lubeíti, ánjein banǘga bedéweejan luágun láni Búngiu latárü, báu ñi ába barítaguni luágu níjein lan cátei lídan furúmieguarügü gürígia bubá, <verse number="24" style="v" />ígirabeí le lúnbei bedéweejani ñi ligíbugiñe latárü, ábame bídin aráandara lúma gürígia ligía. Lárigiñemeti, gayáraajalíme bagíribudun luágun latárü íchigei bedéweejan.</para>
  <para style="p">
    <verse number="25" style="v" />‘Ánjein abúseera ában gürígia lanǘgünibu ligíbugiñoun lúrudu, belúba lídoun úarani lúma luágu jeíbuguniwagu lueí ledéregerunibu lun agúseragüdüti, ledéregerabume agúseragüdüti lun polisía, ábame badaürǘn. <verse number="26" style="v" />Ninárün báu, máfuridunbadibu ñígiñe darí bafáyeiruni lagúmujoún gáwanün.</para>
  <para style="s">Larúfudajan Jesúsu luágu adultériu</para>
  <para style="p">
    <verse number="27" style="v" />‘Agáambaadün luágu aríñawagúa lán meja. “Magámarida jumá jámari ámu, adultériu líra.” <verse number="28" style="v" />Áu naríñajare jun luágu furúmieguarügü lan le awámadirutu ában wǘri, adǘgaali adultériu túma tídan lanígi.</para>
  <para style="p">
    <verse number="29" style="v" />‘Ánjabu lubeíti lafígoungüda bágu le lueígiñebei boúnwenren, sagábei, fíbei díse, buítimaati lun beféridirun ában lídaangiñe umégeguni le buágubei sügǘ láu bídin láu sun búgubu máfiougatin. <verse number="30" style="v" />Ánjein bújabu lubeí le boúnwenren afígoungüdübadibu, dürǘbei, fíbei díse, buítimaati lun leféridirún ában lídaangiñe umégeguni le buágubei sügǘ láu bídin láu sun búgubu máfiougatin.</para>
  <para style="s">Larúfudajan Jesúsu luágu ígiraguni</para>
  <para style="r">(<ref loc="MAT 19:9">Mt 19.9</ref>; <ref loc="MRK 10:11-12">Mr 10.11-12</ref>; <ref loc="LUK 16:18">Lc 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />‘Aríñawagúati meja gíñe luágu furúmieguarügü lan le ígirutu lúmari lúnti líchugun gárada lánina ígiraguni tun. <verse number="32" style="v" />Áu naríñajare jun luágu furúmieguarügü lan wügǘri ígirutu lúmari, ánjein máma lubeí ladǘga tagámaridun ligíbuagun, ába taganoún lúma ámu wügǘri, adǘgagüda lumútu furúmiñeti wügǘri adultériu. Le gíñe agámaridutu wǘri ígiraguaaru ladǘgüña gíñe adultériu.</para>
  <para style="s">Larúfudajan Jesúsu luágu áfiñuruni</para>
  <para style="p">
    <verse number="33" style="v" />‘Agáambaadün gíñe luágu aríñawagúa lán meja joun binádu agǘbürigu lun jagúnfulirun láu le jaríñagubei láu áfiñuruni ligíbugiñe Búngiu. <verse number="34" style="v" />Áu naríñajare jun luágu moún lumuti lan jáfiñurun ni ca uágu—ni luágu siélu ladǘga ñi lan lañúura Búngiu, <verse number="35" style="v" />ni luágu múa ladǘga ñi lan líchigei Búngiu lugúdi, ni luágu Jerusalén ladǘga ligía lubúrugutebei Warúeite Búngiu le weírigubei, <verse number="36" style="v" />ni luágu jichǘgü ladǘga siñáti ni jájarudagüdün ni jáuridagüdün ában ídiburi. <verse number="37" style="v" />Aríñagarügü jumá “ánja” o “uá”, máfiñurunga ni ca uágu, ámu cátei lueí líra lúmagiñeti Máfia.</para>
  <para style="s">Larúfudajan Jesúsu luágu láguyugüdüniwa wuríbani</para>
  <para style="r">(<ref loc="LUK 6:29-30">Lc 6.29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" />‘Agáambaadün luágu aríñawagúa lán meja. “Águu luágu águu, ári luágu ári.” <verse number="39" style="v" />Áu naríñajare jun lun máguyugüdün jumá wuríbani luágu wuríbani, lubáragiñe líra, ánjein íchiga mútu agúfudein luágu ában loúba jigíbu, rúya jumeí le ában oúbaü lun. <verse number="40" style="v" />Le áluguti lanǘgünün ligíbugiñoun lúrudu tueígiñe jisímisin, ígira jumeí lun gíñe lanǘgünun jabíte. <verse number="41" style="v" />Ánjaün lafósura ában gürígia lun janǘgün ában anǘgüni ában máili, barǘjumei bián máili. <verse number="42" style="v" />Furúmieguarügü le amúriajati ában cátei júma, rújumei lun, míchiga jumeí gíñe janágan luágun le afúredeijati júma.</para>
  <para style="s">Ísiñejabuni joun áganiñu</para>
  <para style="r">(Lc 6.27-28, 32-36)</para>
  <para style="p">
    <verse number="43" style="v" />‘Agáambaadün gíñe luágu aríñawagúa lán meja. “Jínsiñelá bumáda bun, liyéreegudame bágani bun.” <verse number="44" style="v" />Áu naríñajare jun. Jínsiñe jamá jáganiñu jun, buídulá jayúmajan jabá ja wuríbabei jayúmajan jubá, adǘga jumá buíti joun ja iyéreejabúbaña jun, ayúmuragua jumá lun Búngiu jawágu ja anábagubadün, ja wuríbabei oúserunün. <verse number="45" style="v" />Ítara lúba jagáburiduña lan queísi lirájüñü Júguchi Búngiu le siélubei, ligía oúnaja lumúti wéyu joun buítiña jáma wuríbatiña, oúnajaleí júya dándu joun múaraantiña queísi joun úaratiña. <verse number="46" style="v" />Ánjein já rügǘbaña lubeí jínsiñejabúbaña jun ínsiñeda jun, ¿cábagi fáyeiti jerésibira luágu líra? Adǘga jamúti gíñe ja agúburajabalin liseínsuna gumádi ítara. <verse number="47" style="v" />Ánjein joún rügǘñein lubeí jumádagu jayoúragua, ¿ca buíti jadǘgübei láu líra? Íbini ja ibídiñejabubaña lun Búngiu adǘga jamúti líra. <verse number="48" style="v" />Úaragua jumá le gumúti queísi úaragua lan Júguchi Búngiu le siélubei.</para>
  <chapter number="6" style="c" />
  <para style="s">Larúfudajan Jesúsu luágu ladügǘn cátei buíti</para>
  <para style="p">
    <verse number="1" style="v" />Ába lasígirun Jesúsu arúfudaja joun gürígia wǘbüwaügügiñe, laríñaga.</para>
  <para style="p">—Toúnigi jumá lueí jadǘgün cátei buíti jagíbugiñe gürígia lúnrügü jaríjinün. Ánjein jadǘga ítara, míchubei Júguchi Búngiu le siélubei fáyeiti buíti jun. <verse number="2" style="v" />Ligía, dánme lubeí jíderagun ában gudémeti, masúbudiragüda jumeí lun sun uboú quei jadǘga ja biánguabaña igíbu ligílisirugu lúma ǘmadarugu. Jagía, jadǘgüni líra lúnrügü jadímurejan gürígia buídu jawágu. Ninárün jáu luágu láu lan jadǘgüni líra, ibíja jamáali jafáyeiruája. <verse number="3" style="v" />Dan le jíchugun ában cátei lun gudémeti, masúbudiraleí ni lubuídun-ágei jumáda, <verse number="4" style="v" />adǘga jumeí lábugiñe libídiñewa. Júguchi Búngiu le aríjubalin le jadǘgübei lábugiñe libídiñewa, líchuguba jafáyeiruája.</para>
  <para style="s">Larúfudajan Jesúsu luágu ligáburi ayúmuraguni lun Búngiu</para>
  <para style="r">(<ref loc="LUK 11:2-4">Lc 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />‘Dan gíñe le jayúmuragun lun Búngiu, mítaran jumá quei ja biánguabaña igíbu ja jínsiñebei joun lun jayúmuragun rára tídan jalígilisin juríu lúma lídan legéyedun ǘma lun jaríjiniña gürígia. Ninárün jáu luágu láu lan jadǘgüni líra ibíja jamáali jafáyeiruája. <verse number="6" style="v" />Dan le jayúmuragun lun Búngiu, belújuma jirúmurugun, darú jumeíme jubéneri, ábame jayúmuragun lun Júguchi Búngiu le lábuguabei júma ñi. Júguchimeti Búngiu, le aríjubalin le jadǘgübei lídan límanin, líchuguba jafáyeiruája. <verse number="7" style="v" />Lídan le jayúmuragun, máguyuguagüda jumá luágu dimúrei le málati quei jadǘga ja ibídiñejabubaña lun Búngiu, jarítaguatiñati luágu lagáambubaña lan Búngiu ladǘga líbe jadímurejan. <verse number="8" style="v" />Mítaran jumá lubeíti quei jagía, ladǘga lubáragiñe jayúmuragun lun Búngiu subúdi láali ca lan jabúseerubei. <verse number="9" style="v" />Ítara lúba lubeíti jayúmuragun.</para>
  <para style="q1">Wáguchi Búngiu le siélubei,</para>
  <para style="q1">inébewalá bíri.</para>
  <para style="q1">
    <verse number="10" style="v" />Nǘbinlá bidáani lun barúeijan ya uboúagu,</para>
  <para style="q1">adügǘwalá bugúndan uboúagu quei ladügǘniwa bugúndan siélu.</para>
  <para style="q1">
    <verse number="11" style="v" />Rúba fein buídurügütu woun lun wéyu le ugúñebei,</para>
  <para style="q1">
    <verse number="12" style="v" />ferúdunabeí wuríbati le adǘga wamáalibei quei ferúduna wamániña ja adǘgübaña wuríbati woun.</para>
  <para style="q1">
    <verse number="13" style="v" />Mígira báwa lun wáburujan lídoun wuríbani,</para>
  <para style="q1">dísegüdarügü báwa lueí,</para>
  <para style="q1">ladǘga amǘrü le arúeijabei, amǘrü le Súntibei Gabáfu, amǘrü le weírigubei lun sun dan. Ítaralá.</para>
  <para style="p">
    <verse number="14" style="v" />‘Ítara líña lubeíti, ánjaña ferúduna jumá ámu luágu wuríbati le adǘga jamáalibei jun, ferúduna lubádün gíñe Júguchi Búngiu le siélubei, <verse number="15" style="v" />ánjein úa ferúduna jumá ámu, úabei gíñe ferúduna láani Júguchi Búngiu jifígoun.</para>
  <para style="s">Larúfudajan Jesúsu luágu ayúnaruni</para>
  <para style="p">
    <verse number="16" style="v" />Ába laríñagun Jesúsu.</para>
  <para style="p">—Jugúya, dánme le jayúnarun, marúfuda jumá lírun igíbu quei jadǘga biángua tigíbu, jagía jadǘgünbalin ítara lun jaríjini gürígia luágu jayúnaruña lan. Ninárün jáu luágu láu lan jadǘgüni líra ibíja jamáali jafáyeiruája. <verse number="17" style="v" />Ánjein jugúya, dan le jayúnarun, amúriga jumeí jídiburi, chibá jumeíme jigíbu, <verse number="18" style="v" />meféen jamámuga gürígia luágu jayúnaruña lan. Júguchirügǘba Búngiu le júmabei ñi geféen luágu jayúnaruña lan, ábameti líchugun jafáyeiruája.</para>
  <para style="s">Irísini siélu</para>
  <para style="r">(<ref loc="LUK 12:33-34">Lc 12.33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" />‘Moúndaragua jumá irísini ya uboúagu le ñí lubei gayára lan jájüchün jamútiri áni gayára ligía lagájüdün ámu luwúyeri irísini, le gíñe ñíjin lubeí gayára lan jebélurun jíwerutiña lun jíwerujan. <verse number="20" style="v" />Oúndaragua jumá irísini siélu, le ñí lubei siñá lan jájüchün jamútiri, magájüdadi ni cáta, mebélu jagía jíwerutiña íweruja ñi. <verse number="21" style="v" />Le ñí lumuti jirísin, ñíñoun gíñe janígi.</para>
  <para style="s">Lilámpun úgubu</para>
  <para style="r">(<ref loc="LUK 11:34-36">Lc 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />‘Ítara líña bágu quei ában lámpu lun búgubu, ánjein lubeíti buídu lubeí bágu, aríja ligía luágun irísini siélu, camá jamuga jarúgoungabei gíñe láu sun búgubu, áni buídubei gíñe sun bigáburi. <verse number="23" style="v" />Ánjein sándi lubeí bágu, aríja ligía luágun irísini ya uboúagu, camá jamuga lídaanbei lubúriga sun búgubu, áni wuríbabei gíñe bigáburi. Ánjein ñǘbin larúgounga le bídaanbei lun lubúrigame, ¡luweírin méfuna líwurin lubúriga ligía!</para>
  <para style="s">Búngiu lúma seínsu</para>
  <para style="r">(<ref loc="LUK 16:13">Lc 16.13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" />‘Úati ni ában gayáraati lesériwidun joun biáma iyúbudirigu, ladǘga lísiñeduba ában jádaangiñe lun, liyéreegudáme le ában lun, úaraguabei lúma ában jádaangiñe, líchigame mebéreseni luágu le ában. Siñáti lesériwidúniwa lun Búngiu lúma lun seínsu.</para>
  <para style="s">Toúnigi lumútiña Búngiu lirájüñü</para>
  <para style="r">(<ref loc="LUK 12:22-31">Lc 12.22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" />‘Naríñajare lubeíti jun, madíjeri jumá luágu cába lan jeíga o cába lan játa lun jabágaridun, ni tuágu anáanguni to lúnboun jadáürunun. ¿Máfunagi gebégitimaati ibágari sügǘ láu eígini, gebégi úgubu sügǘ táu anáanguni? <verse number="26" style="v" />Aríja jumá joun dunúru ja ájamajabaña garábalirugu. mábunagun jáña, malúbajan, mareídun jameí alúbajani lídan lágei, láu sun líra, rúti Júguchi le siélubei eígini joun. ¡Sarágu gebégitima jumá sügǘ jáu dunúru! <verse number="27" style="v" />¿Cáteigi jídaangiñe gayáraabei líchugun bián ugúdi lánwoun lúgubu, ca lan lanárimebei láfaagun luágu?</para>
  <para style="p">
    <verse number="28" style="v" />‘¿Ca uágu jadíjerida tuágu anáanguni? Aríja jumá ída líña lan laweínamudun fulúri. láu sun mawádigimari lan, madǘgün ligía gamísa, <verse number="29" style="v" />ni méja urúei Salomón láu sun luwéndegun, mawéndentí meja ladáüragun quei fulúri. <verse number="30" style="v" />Ánjeinti daǘguagüda lubálin Búngiu jíduru ítara le ugúñebei lájücha, jarúgabei yebe lagudúña, ¿gúbumésan líderaguajün loúgua tafíñen jugúya le? <verse number="31" style="v" />Madíjerida jumá lubeíti aríñaga. “¿Cába weíga?” o “¿Cába wáta?” o “¿Cába wadáüra?” <verse number="32" style="v" />Gürígia ja lánigu uboú le, luágu rügüñeín buri cátei le jarítagua, ánjein jugúya, níjein júguchi Búngiu siélu le subúdijabúbei cátei lan jemégeirubei. <verse number="33" style="v" />Seríwi jumá lun Búngiu furúmiñe, áluaja jumeí ibágari surúti le áubei lagúndaara, ábame líchuguni sun le jemégeirubei jun. <verse number="34" style="v" />Madíjerida jumá lubeíti luágu jarúga, ladǘga barǘ lumuti gíñe jarúga lidíjeridüna lúmagua. Ságü ában wéyu gíbeti cátei lun.</para>
  <chapter number="7" style="c" />
  <para style="s">Míchiga jumá jadúnrun ámu</para>
  <para style="r">(Lc 6.37-38, 41-42)</para>
  <para style="p">
    <verse number="1" style="v" />Ába lasígirun Jesúsu aríñaga joun gürígia wǘbüwaügügiñe.</para>
  <para style="p">—Míchiga jumá jadúnrun ámu, míchugun lámuga gíñe Búngiu jidúnrun, <verse number="2" style="v" />ladǘga quei ligáburi jíchugun jadúnrun ámu, ítara lúba gíñe líchugun Búngiu jidúnrun, le áubei jamísuraja, láuba gíñe lamísurajaün Búngiu. <verse number="3" style="v" />¿Ída lubásan gayára lan jaríjini liraǘraü ífei le lídaanbei lágu jamúlen áni masándi jumúti durúsu le lídaanbei jágu? <verse number="4" style="v" />¿O ída lúba gayára lan jaríñagun lun jamúlen. “Sagánei liraǘraü ífei le lídaanbei bágu,” áni níjein ában durúsu lídan jágu? <verse number="5" style="v" />¡Biángua tigíbu jugúya le! Sagájumei durúsu le lídaanbei jágu furúmiñe, ítara lúba gayára lan jaríjin buídu lun jaságaruni liraǘraü ífei le lídaanbei lágu jamúlen.</para>
  <para style="p">
    <verse number="6" style="v" />‘Míchiga jumeí arúfudajani luáguti asálbaruni joun gürígia ja gáñitiña, garábagua jáñein juágun quei oúnli lun jágürünün. Míchiga jumeí gíñe arúfudajani ligía le gebégibei sarágu joun gürígia ja büírujuduátiña, dügǘgua jañálin.</para>
  <para style="s">Agáamba lumúti Búngiu wamúriajan lúma</para>
  <para style="r">(<ref loc="LUK 11:9-13">Lc 11.9-13</ref>, <ref loc="LUK 6:31">6.31</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />‘Jamúriaja lúma Búngiu, ábame líchugun jun, jáluaja, ábame jadárirun, daǘnjuma luágu béna, ábame lánjunrenchún jun. <verse number="8" style="v" />Ladǘga le amúriajati, abíjati, le áluguti, daríti, le adaǘnjati luágu béna, jurénwati lun.</para>
  <para style="p">
    <verse number="9" style="v" />‘¿Níjein funági ában jídaangiñe gayáraati líchugun ában dǘbü lun lisáani dan le lamúriajan fein lúma? <verse number="10" style="v" />¿o líchugun lan ában jéwe lun dan le lamúriajan úduraü lúma? <verse number="11" style="v" />Ánjein lubeíti láu lubeí sun wuríba jumá, gíchigaditün cátei buíti joun jisáanigu, ¡gúbuméti líchiga Júguchi Búngiu le siélubei cátei buíti joun ja amúriajatiña lúma!</para>
  <para style="p">
    <verse number="12" style="v" />‘Súnwandanlá lubeíti jadǘgün joun ámu quei le jabúseerubei lun jadǘgüni jun, ladǘga ligía laríñagubei lilúrudun Moisés túma jalíburun profétagu.</para>
  <para style="s">Bürǘraüti lubéneri siélu</para>
  <para style="r">(<ref loc="LUK 13:24">Lc 13.24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />‘Belújuma lídaangiñe béna le bürǘraübei. Béna lúma ǘma le anǘgübei gürígia lídoun féridi, tuléburi líña, gabáranouga ñi, áni sarágu jáña ebélurutiña lídaangiñe. <verse number="14" style="v" />Ánjeinti béna lúma ǘma le anǘgübei gürígia lídoun ibágari le magúmuchaditi, bürǘraü líña, murúgua, míbetiñati adáriruti.</para>
  <para style="s">Luágu cátei le wadǘgübei lasúbudirúa cátawa lan</para>
  <para style="r">(<ref loc="LUK 6:43-44">Lc 6.43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />‘Toúnigi jumá jaweí yéetiña ja aríñagubaña luágu lerérun lan Búngiu jadímureja. Jayábin jun quei mudún boúgudigiñe jabíti, ánjein múnadagiñe, ítara jáña quei anímaalu gáñitiña. <verse number="16" style="v" />Jugúya, gayáraabei jasúbudiruniña luágu le jadǘgübei, malúbajoúntu beíbei lídaangiñe jíyu, ni ígo lídaangiñe guríbiyuwa. <verse number="17" style="v" />Sun lubeíti wéwe le buíti, buíti lin, wéwe le wuríbati, wuríbati lin. <verse number="18" style="v" />Wéwe le buíti, siñáti wuríba lan lin, wéwe le wuríbati, siñáti gíñe buídu lan lin. <verse number="19" style="v" />Sun wéwe le mabuídunti lin, chaǘnwati, ába lágudúniwa. <verse number="20" style="v" />Jasúbudirubaña lubeíti yéetiña jagía luágu le jadǘgübei.</para>
  <para style="s">Másubaña ebélura lídoun arúeijani le siélubei</para>
  <para style="r">(<ref loc="LUK 13:25-27">Lc 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />‘Máma sun ja aríñagutiña nun. “Nabúreme, Nabúreme,” jebéluruba lídoun arúeijani le siélubei,’ líña Jesúsu. ‘Ja rügǘbaña adǘgübalin lugúndan Núguchi Búngiu le siélubei ebélura. <verse number="22" style="v" />Dánme lachǘlürün wéyu lánina agúseragüdüni, sarágubaña aríñagutiña nun. “Wabúreme, Wabúreme, apúrichijatiwa mejátia luágu bíri, sagá wagía espíritugu wuríbatiña lídan bíri, adǘga wagía sarágu miláguru lídan bíri.” <verse number="23" style="v" />Ábameti naríñagun joun. “Ibídiñegubeiñadün nun, díse jumá nueí, jugúya le adǘga jumáalibei le wuríbabei.”</para>
  <para style="s">Jawúyeri gürígia ja agáambubalin lerérun Búngiu</para>
  <para style="r">(<ref loc="LUK 6:47-49">Lc 6.47-49</ref>; <ref loc="MRK 1:22">Mr 1.22</ref>)</para>
  <para style="p">
    <verse number="24" style="v" />‘Le agáambutina, adǘgaleí le nubeíbei, ítara líña quei ában wügǘri gunfaráandati le adǘgübei lúban ligíbuagu dǘbü. <verse number="25" style="v" />Ába liábingua júya, ába liñúrun dúna, fúgua garábali tuágun múna tugúya, meíguaduntu ladǘga luáguñein lan dǘbü tuágaburi. <verse number="26" style="v" />Ánjeinti le agáambutina, madǘgün lumúti le nubeíbei, ában wügǘri ibídiougua táu ligía, le ábunagubei ligíbuagu ságoun. <verse number="27" style="v" />Ába liábingua júya, iñúra dúna, fúgua garábali tuágun múna tugúya, ¡ma lanárime táburujan!</para>
  <para style="p">
    <verse number="28" style="v" />Dan lásurun ladímurejan Jesúsu, ¡ma luweírin janígi gürígia láu le larúfudajabei! <verse number="29" style="v" />ladǘga láu lan ubáfu larúfudaja, máma quei arúfudajatiña lilúrudun Moisés.</para>
  <chapter number="8" style="c" />
  <para style="s">Lareídaguagüdün Jesúsu ában gawáguti gumeín le mareídaguadibei</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mr 1.40-45</ref>; <ref loc="LUK 5:12-16">Lc 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Dan le larárirunbei Jesúsu lueígiñe wǘbü, sarágu jáña gürígia afálaruti. <verse number="2" style="v" />Ába liábin ában wügǘri gawáguti gumeín le mareídaguadibei, ába lájuduragun ligíbugiñe Jesúsu, ába laríñagun lun.</para>
  <para style="p">—Nabúreme, ánjabu busén, gayáraati bareídaguágüdünina.</para>
  <para style="p">
    <verse number="3" style="v" />Ábati lagúurun Jesúsu luágu láu lújabu, aríñageina ligía.</para>
  <para style="p">—Buséntina, areídaguagüda numútibu.</para>
  <para style="p">Quei laríñagun ítara, ába lareídagun sánditi ligía. <verse number="4" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Maríñaga beítia ni ca un, ñǘdünrügübá arúfudagua búngua lun fádiri, rúbeíme edéweejani le uágubei laríñaga Moisés, lun jaríjini gürígia luágu areídaguaadibu lan.</para>
  <para style="s">Lareídaguagüdüni Jesúsu lumúsun ában gumándan Rómana</para>
  <para style="r">(<ref loc="LUK 7:1-10">Lc 7.1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />Dan le lebélurun Jesúsu lídoun fulásu le gíribei Capernaúm, ába liábin ában gumándan Rómana lubároun, <verse number="6" style="v" />ába layúmuragun lun ítara.</para>
  <para style="p">—Nabúreme, níjein numúsun roun láu sándi le derégüdaü, lúma sarágu gáriti luágu.</para>
  <para style="p">
    <verse number="7" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Neíbuga agáranija lun.</para>
  <para style="p">
    <verse number="8" style="v" />Ába loúnabun gumándan.</para>
  <para style="p">—Nabúreme, madǘnatina lun bebélurun núbiñoun, aríñagarügübeí dimúrei, ábame lareídagun numúsun. <verse number="9" style="v" />Naríñagubaalin líra ladǘga nugúya lábugiñeñadina gíñe gumádi le íñutimaati, áni añájein gíñe súdaara lábugiñe nagúmadijan. Dan le naríñagun lun ában jádaangiñe lun lídin, ñǘdünti, dan le naríñagun lun ában lun liábin, ñǘbinti, dan le naríñagun lun numúsun lun ladǘgün furúmieguarügü cátei, adǘga lumúti. Ítara lúba, luágu berérun mósu lídin sándi lueí numúsun.</para>
  <para style="p">
    <verse number="10" style="v" />Dan le lagáambunbalin Jesúsu le laríñagubei gumándan ligía ába laweíridun lanígi, ába laríñagun joun ja afálarubalin.</para>
  <para style="p">—Ninárün jáu luágu madárigidina lan wügǘri weíri tafíñen ni jádan numútuniña Israelítagu quei wügǘri le. <verse number="11" style="v" />Naríñajare jun luágu sarágujaba lan já meja ibídiñejabubaña lun Búngiu ñǘbintiña lueígiñe oúbaü le ñígiñe lubeí laboúcha wéyu, jáma le ñígiñe lubeí lálüda, ábame jañúurun eíga lúma Abrahám, Isáac lúma Jacób lídan arúeijani le lánina siélu. <verse number="12" style="v" />Ánjeinti já yebe lúnbaña lídan jamá arúeijani ligía jaságarúba bougudín, ábame jádarúniwa lídoun luweírin-ágei lubúriga, ábame jayájuajan, ábame lacǘnrinjan jári le luweírin jagárigu.</para>
  <para style="p">
    <verse number="13" style="v" />Ába laríñagun Jesúsu lun gumándan ligía.</para>
  <para style="p">—Beíba búbiñoun, le uágubei bafíñera, ladügǘba bun.</para>
  <para style="p">Ába lareídagun músu ligía lídan óra ligía.</para>
  <para style="s">Lareídaguagüdünun Jesúsu límenidi Pédro</para>
  <para style="r">(<ref loc="MRK 1:29-31">Mr 1.29-31</ref>; <ref loc="LUK 4:38-39">Lc 4.38-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Ába lídin Jesúsu lúbiñe Pédro, ába ladárirunun límenidi Pédro roun láu abíruaü. <verse number="15" style="v" />Ába lagúurun luágu tújabu, ába lagídarun abíruaü tueí, ába tásaarun, ába tagúmeserun esériwidaña.</para>
  <para style="s">Lareídaguagüdün Jesúsu sarágu sánditiña</para>
  <para style="r">(<ref loc="MRK 1:32-34">Mr 1.32-34</ref>; <ref loc="LUK 4:40-41">Lc 4.40-41</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />Dan le lagúñedunbei, ába janǘgün sarágu gürígia ja gawágutiña espíritugu wuríbatiña lun Jesúsu, ába laságajaniña espíritugu wuríbatiña jagía jaweí láurügü ában dimúrei, areídaguagüda láña sun ja sándibaña. <verse number="17" style="v" />Lasúseredunbei sun le lun lagúnfulirun lé meja uágubei ladímureja proféta Isaías dan le laríñagunbei luágu Jesúsu. “Barǘ lumuti wadébilin, gidálei wasándigu.”</para>
  <para style="s">Já yebe abúseerubaña jafálaruni Jesúsu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Lc 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Dan le laríjin Jesúsu luágu sarágu jáña lan gürígia geyégu láu, ába líchugun dimúrei lun jájiñuragun ligía jáma láni disípulugu loubáfurugun dúna. <verse number="19" style="v" />Ába layárafadun ában arúfudajati lilúrudun Moisés lun Jesúsu, ába laríñagun lun.</para>
  <para style="p">—Maésturu, buséntina nafálarunibu le ñíjin lumúti bídin.</para>
  <para style="p">
    <verse number="20" style="v" />Ába loúnabuni Jesúsu.</para>
  <para style="p">—Darítiña gasígamu júyu lun jaganoún ñi, gádibutiña gíñe dunúru, ánjeinti áu le Wügǘri Garaǘwarügüti, madáritina ni jalíaba lan nabálachagüdei nichǘgü.</para>
  <para style="p">
    <verse number="21" style="v" />Laríñaga ában jádaangiñe láni disípulugu lun.</para>
  <para style="p">—Nabúreme, buséntina nafálarunibu, lárigiñeme loúnwen núguchi, buná neíme, ábame nafálarunibu.</para>
  <para style="p">
    <verse number="22" style="v" />Ába loúnabuni Jesúsu.</para>
  <para style="p">—Falábana guetó, ígira báña ja jiláñubaña lun cátei le lánina larúeijan Búngiu lun jábununiña jegéburi.</para>
  <para style="s">Lagálumaruni Jesúsu garábali lúma lugúdi barána</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mr 4.35-41</ref>; <ref loc="LUK 8:22-25">Lc 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" />Ába ládinun Jesúsu tídoun ugúnein, ába joúdin láni disípulugu lúma. <verse number="24" style="v" />Sódini ába láfuragun ában garábali jéreti, ába lebélujan lugúdi barána tídoun ugúnein. Larúmuguñati Jesúsu. <verse number="25" style="v" />Ába jagágudajani láni disípulugu, ába jaríñagun lun.</para>
  <para style="p">—¡Wabúreme, séfu báwa! ¡Wadíbiragua!</para>
  <para style="p">
    <verse number="26" style="v" />Ába loúnabuniña.</para>
  <para style="p">—¿Cásan uágu janúfudeda? ¡Loúgua tafíñen jugúya le!</para>
  <para style="p">Ába lásaarun, ába ladeínjan lun garábali lúma barána, ába lagálumadun. <verse number="27" style="v" />Ába laweíridun janígi, ába jaríñagun.</para>
  <para style="p">—¿Cáteisan wügǘri le, agáamba lubálin garábali lúma barána?</para>
  <para style="s">Laságarun Jesúsu espíritugu wuríbatiña jádaangiñe bián wügǘriña Gadárana</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mr 5.1-20</ref>; <ref loc="LUK 8:26-39">Lc 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" />Dan le lachǘlürün Jesúsu loubáfurugu dúna, jageíroun Gadárana, ába jáfuridun bián wügǘriña lídaangiñe buri umúajaü achigíti luágu dǘbü, ába jayábin luágun. Biángubei jagía, jáuñanu espíritugu wuríbatiña áni janárimetiti jagáñi darí lun siñá lan jásügürün gürígia lídaangiñe ǘma ligía. <verse number="29" style="v" />Ábati jagúarajan ítara.</para>
  <para style="p">—¿Cásan uágu bemétera wámoun, Jesúsu Liraǘ Búngiu? ¿Biábiña asúfuriragüdawa lubáragiñe dan le lánina asúfuriruni?</para>
  <para style="p">
    <verse number="30" style="v" />Ñíñanu sarágu büíruju eíga madíse ñígiñe, <verse number="31" style="v" />ába jayúmuragun espíritugu wuríbatiña ja lun Jesúsu, jaríñaga lun.</para>
  <para style="p">—Ánjawa baságara, ígirabá lun webélurun jádoun büíruju ja.</para>
  <para style="p">
    <verse number="32" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—¡Jeíbati jádoun!</para>
  <para style="p">Ába jáfuridun espíritugu wuríbatiña jagía jádaangiñe wügǘriña jagía, ába jebélurun jádoun büíruju, ába jáguragun büíruju jagía joúngua lueígiñe ában gudúungu, ába jáburujan dúnarugun, ába jañáradagun.</para>
  <para style="p">
    <verse number="33" style="v" />Ába janúfudedagun ja oúnigirubaliña büíruju, ába jeíbaagun, jachǘlün aǘdübü, ába jabájüdaguni le asúseredubei joun büíruju lúma joun wügǘriña já buga jáubaña espíritugu wuríbatiña. <verse number="34" style="v" />Ábati jayábin sun lílana fulásu ligía lúmoun Jesúsu, ába jayúmuragun lun lun láfuridun jageíragiñe.</para>
  <chapter number="9" style="c" />
  <para style="s">Lareídaguagüdün Jesúsu ában wügǘri derégüdaali</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mr 2.1-12</ref>; <ref loc="LUK 5:17-26">Lc 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ábati ládinun Jesúsu tídoun ugúnein tugúya, ába lánjiñuragun loubáfurugun dúna, ába lachǘlürün lageíroun. <verse number="2" style="v" />Ába janǘgün ában wügǘri derégüdaali lun, roun tídan lubárari. Dan le laríjinbalin Jesúsu luweírin jafíñen, ába laríñagun lun sánditi ligía.</para>
  <para style="p">—Ragǘba gurásu, niraǘ, ferúdunawati bifígoun.</para>
  <para style="p">
    <verse number="3" style="v" />Ñíñanuti jádaangiñe arúfudajatiña lilúrudun Moisés, aríñagutiña joúnguarügü. “Lanábaguñeigan wügǘri le Búngiu láu dimúrei le laríñagubei.” <verse number="4" style="v" />Queíti subúdi lubálin Jesúsu le uágubei jasáminara, ába laríñagun joun.</para>
  <para style="p">—¿Cásan uágu luríbanbei jisáminan ítara? <verse number="5" style="v" />¿Cátimasan ménreengúnbei laríñawagúniwa. “Ferúdunawati bifígoun”, ódi “Sarába, beíbuga”? <verse number="6" style="v" />Narúfudaaliti jun luágu gabáfu nan, áu le Wügǘri Garaǘwarügüti, lun ferúduna nan figoú.</para>
  <para style="p">Ába laríñagun lun sánditi ligía.</para>
  <para style="p">—Sarába, budáboun bubárari, beíba búbiñoun.</para>
  <para style="p">
    <verse number="7" style="v" />Ába lásaarun sánditi ligía, ába lídin lúbiñoun. <verse number="8" style="v" />Dan le jaríjinbaalin gürígia cátei le, ába laweíridun janígi, ába jadímurejan buíti luágu Búngiu luágu líchuguni ubáfu le joun wügǘriña.</para>
  <para style="s">Lagúarun Jesúsu lun Matéo lun lánime disípulu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mr 2.13-17</ref>; <ref loc="LUK 5:27-32">Lc 5.27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />Ába lídin Jesúsu ñígiñe, ába laríjinina, áu le gíribei Matéo, le abǘrüjabarun líburu to. Agúburajatina meja liseínsuna gumádi, ñun níña lídan nubára lánina agúburajani wéyu ligía dán le lásügürünbei Jesúsu ñígiñe. Ába laríñagun nun.</para>
  <para style="p">—Falábana, queímoun núma queísi náni disípulu.</para>
  <para style="p">Ába násaarun, ába nafálaruni.</para>
  <para style="p">
    <verse number="10" style="v" />Lárigiñe, ñun líña Jesúsu eíga, sarágu jáña giñéti ja agúburajabalin liseínsuna gumádi jáma ámu gafígountiña eíga lúma úara jáma láni disípulugu. <verse number="11" style="v" />Dánti le jaríjini fariséogu cátei le, ába jaríñagun joun láni Jesúsu disípulugu.</para>
  <para style="p">—¿Ída liñásan leíginbei jumáesturun jáma agúburajatiña liseínsuna gumádi lúma jáma ámu gafígountiña?</para>
  <para style="p">
    <verse number="12" style="v" />Ába lagáambuni Jesúsu, ába laríñagun joun.</para>
  <para style="p">—Ja magádiebaña mabúseeruntiña surúsia, ja sándibaña, jagía busénbaña surúsia. <verse number="13" style="v" />Furéndei jumeí ca lan laníchigubei le uágubei laríñaga Búngiu tídan Lerérun. “Buséntina lun gudémejabu jumá, máma lun jadágaragüdün anímaalu nun.” Máma niábiña áluajaña ja magádiebaña ligíbugiñe Búngiu, niábiña áluajaña gafígountiña lun jasáansiruni ligáburi joúserun.</para>
  <para style="s">Jálügüdüni Jesúsu libǘgürü ayúnaruni</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mr 2.18-22</ref>; <ref loc="LUK 5:33-39">Lc 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Ábati jayábin ja láni Juan le abásteragüdajabei disípulugu, ába jaríñagun lun Jesúsu.</para>
  <para style="p">—¿Ánsan wagía jáma fariséogu ayúnara wabeí sarágu, ánjaña báni disípulugu mayúnaruntiña?</para>
  <para style="p">
    <verse number="15" style="v" />Ába líchuguni Jesúsu jémpulu le joun luágu iséri larúfudajan lúma binádu, laríñaga.</para>
  <para style="p">—¿Gayáraati funági jíruñu jamá ja amísurajoúbaña lídoun ában maríei dan le niján lan adári jáma ñi? Lachǘlürüba wéyu lun lúadun adári jáma, ligíaalime jayúnarun.</para>
  <para style="p">
    <verse number="16" style="v" />‘Siñáti táfadajoún gamísa ñulújaru táu murúsun to derégiru ladǘga dánme le tacháwaragun to derégiruboun ábame tajeíridagun to ñulújaruboun, ábatimámeti laweíridun jeíriti. <verse number="17" style="v" />Siñáti gíñe léserúniwa bínu le isérigili lídoun guéru le binádujali, ánjein adügǘwa ítara, ábame lafaǘnchün guéru dánme le liñúrun bínu, féridiwa ligíameti gúeru, féridiwa bínu. Ligía lúnti lubeí léserúniwa bínu iséri lídoun guéru iséri, ítara lúba lesériwidun biángubei.</para>
  <para style="s">Liraǘ Jáiro túma wǘri to agúurubarun lanáangun Jesúsu</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mr 5.21-43</ref>; <ref loc="LUK 8:40-56">Lc 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Dan ñíñein lan Jesúsu arúfudajei sún buri cátei le, ligía liábin ában ábuti jádaangiñe juríu, ába lájuduragun ligíbugiñe, ába laríñagun lun.</para>
  <para style="p">—Sun líña toúnwen nisáani, ánjabu ñǘdün lun bíchuguni bújabu tuágu, táguyuguba.</para>
  <para style="p">
    <verse number="19" style="v" />Ába lásaarun Jesúsu, ába lídin lúma ñi jáma láni disípulugu. <verse number="20" style="v" />Ñíñounti ában wǘri ǘmada sánditu, dúusu irúmu táu láu lésejan jítaü tídaangiñe, ába tayárafadun lun Jesúsu lanágangiñe, ába tagúurun luágu táru lanáangun, <verse number="21" style="v" />taríñaga túnguarügü. “Láurügü nagúurun tuágu lanáangun nareídaguba.” <verse number="22" style="v" />Ába lagáraragun Jesúsu, ába laríjinun, ába laríñagun tun.</para>
  <para style="p">—Ragǘba gurásu niraǘ, areídaguaadibu ladǘga bafíñen.</para>
  <para style="p">Lúmagiñe óra ligía ába tareídagun.</para>
  <para style="p">
    <verse number="23" style="v" />Dan le lachǘlürün Jesúsu lúbiñoun buga ábuti ligía, dan le laríjiniña íñaajatiña aráanseña lun ábunajani, añája gürígia areíncha, <verse number="24" style="v" />ába laríñagun joun.</para>
  <para style="p">—Furíjuma yágiñe, moúnwengiru irájü to, tarúmuguña.</para>
  <para style="p">Ába jéjerajan láu. <verse number="25" style="v" />Dan le furígüda láaña sun gürígia, ába lebélurun, ába lárügüdüni tújabu irájü tugúya, ába tásaarun. <verse number="26" style="v" />Ába labúruchagun luágu le asúseredubei lídan sun fulásu ligía.</para>
  <para style="s">Lareídaguagüdün Jesúsu bián maríjintiña</para>
  <para style="p">
    <verse number="27" style="v" />Dan láfuridun Jesúsu ñígiñe, ába joúdin bián wügǘriña maríjintiña lárigi, agúarajeina ítara.</para>
  <para style="p">—¡Gudéme wamá bun, amǘrü le ladǘgawagun Davíd!</para>
  <para style="p">
    <verse number="28" style="v" />Dan lebélurun Jesúsu múnadoun, ába jachǘlürün maríjintiña jagía lúmoun, ába laríñagun joun.</para>
  <para style="p">—¿Afíñetün luágu gayára lan nareídaguagüdünün?</para>
  <para style="p">Ába jaríñagun.</para>
  <para style="p">—Ánja, afíñetiwa, Wabúreme.</para>
  <para style="p">
    <verse number="29" style="v" />Ába lagúuruni Jesúsu jágu, ába laríñagun joun.</para>
  <para style="p">—Ítaralá quei ligáburi jafíñen.</para>
  <para style="p">
    <verse number="30" style="v" />Ába léfegechun jágu, ába léredun Jesúsu jawágu lun joúchun lun masúbudirúniwa lan luágu ligía lan agáranijabei joun.</para>
  <para style="p">
    <verse number="31" style="v" />Quei jáfuridun ñígiñe, ába jabájüdaguni le ladǘgübei Jesúsu lídan sun fulásu geyégua láu.</para>
  <para style="s">Lareídaguagüdün Jesúsu ában meréngaditi</para>
  <para style="p">
    <verse number="32" style="v" />Dan le áfurideina jamá, ligía jayábin fiú gürígia láu ában wügǘri meréngaditi, gawáguti ában espíritu wuríbati, ába jayábin láu lun Jesúsu. <verse number="33" style="v" />Lárigiñe laságaruni Jesúsu espíritu wuríbati ligía lueí meréngaditi ligía, ába lagúmeserun adímureja. Ába laweíridun janígi gürígia, ába jaríñagun.</para>
  <para style="p">—Maríjiñajágidiwa líbe le jageíra Israelítagu.</para>
  <para style="p">
    <verse number="34" style="v" />Jaríñagaídan sun fulásu geyégua ti fariséogu luágu láu lan lubáfu Máfia le jábuti espíritugu wuríbatiña laságaja Jesúsu espíritugu wuríbatiña.</para>
  <para style="s">Lugúdemejabu Jesúsu joun gürígia</para>
  <para style="p">
    <verse number="35" style="v" />Eíbuga lumúti meja Jesúsu sun fulásu arúfudajeina tídan jalígilisin juríu, apúrichijei ugánu buíti luáguti arúeijani le lánina siélu, areídaguagüdeina sun luwúyeri sándi lúma gáriti. <verse number="36" style="v" />Dan laríjiniña gürígia, ába jagúdemedagun lun, ladǘga nidíjeri jamá, magúraasun jagía, camá mudún ja moúniritiña. <verse number="37" style="v" />Ába laríñagun joun láni disípulugu jabǘgürü gürígia jagía.</para>
  <para style="p">—Sarágu jáña gürígia buséntiña jagáambuni ugánu luáguti asálbaruni, ítara jáña quei nádü lun lalúbajoún, áni loúguatiña ñadágimeintiña. <verse number="38" style="v" />Lúnti lubeíti jamúriajan lúma Labúreme nádü lun loúnajan ñadágimeintiña lun japúrichijan joun.</para>
  <chapter number="10" style="c" />
  <para style="s">Láni Jesúsu dúusu disípulugu</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mr 3.13-19</ref>; <ref loc="LUK 6:12-16">Lc 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ába lagúarun Jesúsu joun dúusu láni disípulugu, ába líchugun ubáfu joun lun gayára lan jaságajan espíritugu wuríbatiña jaweí gürígia lúma lun jareídaguagüdün sun luwúyeri sándi lúma gáriti. <verse number="2" style="v" />Niján jíri dúusu láni Jesúsu disípulugu jagía. Furúmiñeti, Simón le méme gíribei Pédro, lúma Andrés le lamúlen, Jacóbo lúma Juan le lamúlen—lirájüñü Zebedéo, <verse number="3" style="v" />Felípe, Bartolomé, Tomás, núma, áu Matéo le agúburajabeí meja liseínsuna gumádi, Jacóbo le liraǘ Álfeo, Lébeo, le méme gíribei Tadéo, <verse number="4" style="v" />Simón—ában meja wügǘri áfaaguti lun jawáanserun juríu, lúma Júdas Iscarióte, le alúgurubalin Jesúsu.</para>
  <para style="s">Loúnajaniña Jesúsu disípulugu apúrichija</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mr 6.7-13</ref>; <ref loc="LUK 9:1-6">Lc 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />Dan loúnajabaliña Jesúsu dúusu ja apúrichija, ába laríñagun joun ítara.</para>
  <para style="p">—Mídin jumá le ñí jamuti ja mámabaña juríu, mebélu jugúyame lídoun buri fulásu le láni Samária, <verse number="6" style="v" />jabǘgürülá gürígia féridijaña ja Israelítagu jídin. <verse number="7" style="v" />Jeíba, apúrichijeina luágu yaráfaali lan larúeijan Búngiu. <verse number="8" style="v" />Areídaguagüda jumáña ja gawágutiña gumeín luágu jára, jáma ja gawágutiña ámu luwúyeri sándi, sarágüda jumá jiláaña, sagá jumaña espíritugu wuríbatiña. Mafáyeijántün lun jibíjini ubáfu le, magúburaja jumá gíñe luágu.</para>
  <para style="p">
    <verse number="9" style="v" />‘Manǘga jumá seínsu, <verse number="10" style="v" />manǘgün jugúyame lágei ni cáta. Ábanrügütá simísi janǘga, manǘgün jugúyame sabádu ni bádun, ladǘga le ñadágimeinbei garíchati lun leígin lídaangiñe luwádigimari.</para>
  <para style="p">
    <verse number="11" style="v" />‘Dánme le jachǘlürün lídoun ában ubúrugu o ában lan liraǘraü fulásu, ábame jálugun gürígia ja ánjatiña lun jerésibirunün ñi, ábame jeréderun jáma jábiñe darí jídin. <verse number="12" style="v" />Dánme jebélurun tídoun ában múna, ábame jabúsurun, ayúmuragueina magádiei jawágu tílana múna tugúya. <verse number="13" style="v" />Ánjaün jerésibira tílana múna tugúya, ígira jumeí jabúsurun jáma, ánjaün merésibirun jamá, giríbugüda jumeí busúguaü ligía lun úa lan magádiei joun. <verse number="14" style="v" />Ánjaünti merésibirun jamá, mája jagía jagáambunün, ábame jáfuridun tídaangiñe múna tugúya o lídaangiñe lan fulásu ligía, ábame jáfuruduni calíqui lueígiñe jugúdi lun jarúfuduni luágu mabuídun lan jagáburi gürígia jagía, ígira jumáña quei jadáriragun joúngua. <verse number="15" style="v" />Ninárün jáu luágu dánme lan le lachǘlürün wéyu lánina agúseruni, weíritimaabei jasúfurirun lílana fulásu ligía sügǘ láu jasúfurirun lílana Sodóma lúma Gomórra.</para>
  <para style="s">Eíbaajoúni le lúnbei jasúfuriruni láni Jesúsu disípulugu</para>
  <para style="p">
    <verse number="16" style="v" />‘Noúnajaadüntia quei mudún jagánaguoún anímaalu gáñitiña. Aráanseñu jumá lubeíti ítara quei jéwe, áni ítara jumá quei únjun madǘgünga wuríbani. <verse number="17" style="v" />Toúnigi jumá ladǘga j juríu. <verse number="18" style="v" />Janügǘwaba jagíbugiñoun gumádimatiña lúma jagíbugiñoun urúeigu lueígiñe jesériwidun nun, ítara lúba gayára lan jadímurejan nuágu jagíbugiñe, lúma jagíbugiñe ja mámabaña juríu. <verse number="19" style="v" />Dánme le jedéregerúniwa joun lúrudugu, májüchüra jumá luágu cába lan jaríñaga o ída lúba lan jaríñaguni, ladǘga dánme lachǘlürün óra lun jadímurejan, líchugubei Búngiu le lúnbei jaríñaguni jun. <verse number="20" style="v" />Mámaba jugúya adímureja, láni Júguchi Búngiu Espíritu, ligíaba adímureja jídaangiñe.</para>
  <para style="p">
    <verse number="21" style="v" />‘Jalúgurubaña wügǘriña jabíriña guánarü lun jafarún jilágubei, alúgura jamáñame agǘbürigu jasáanigu, garábagua jagíame isáanigu jawágun jagǘbürigu lun jáfaragüdüniña. <verse number="22" style="v" />Jeyéreegudúba lun sun uboú nueígiñe, áni le derégüdaguati darí lúmoun lagúmuchun libágari, lebéluruba siélun. <verse number="23" style="v" />Dánme le jeíbaajoún lídan ában fulásu, ábame janúrajan lídoun ámu, ninárün jáu, niábinyaba, áu le Wügǘri Garaǘwarügüti, lubáragiñe jeíbuguni sún buri jabúrugute Israelítagu.</para>
  <para style="p">
    <verse number="24" style="v" />‘Úati disípulu íñuguti lueí lumáesturun ni músu lueí liyúbudiri, ánjana asúfurira, lúnti gíñe jasúfurirun. <verse number="25" style="v" />Lúnti gúndan lan disípulu láu lachǘlürün ítarada quei lumáesturun, lúma músu quei liyúbudiri. Ánjein aríñawagúa lubeí nuágu luágu jábutiná máfianu, gúbume janábawagua ja afálarubalina.</para>
  <para style="s">Cába lan ueí lanúfudedúa</para>
  <para style="r">(<ref loc="LUK 12:2-9">Lc 12.2-9</ref>)</para>
  <para style="p">
    <verse number="26" style="v" />‘Ligía manúfudeda jumá lubeí jaweí gürígia,’ líña Jesúsu joun láni disípulugu lubáragiñe loúnajaniña apúrichija. ‘Úati cátei darúguati láu lun machǘlaagunbei lan, úa ni cáta le arámudagúati lun masúbudirúnwabei lan. <verse number="27" style="v" />Le naríñagubei jun lídan lubúriga aríñaga jumeí lídan larúgounga, le naríñagubei jun ibídiñoun joun ámu, wágua jumeí íñugiñe tibíti múna. <verse number="28" style="v" />Manúfudeda jumá jaweí ja gayáraabei jáfaruni úgubu jilágubei áni siñáti jáfarunun uwáni, Búngiu le gayáraabei lasúfuriragüdüni úgubu túma uwáni máfiougati lun sun dan, ligía lúnbei janúfudedun lueí.</para>
  <para style="p">
    <verse number="29" style="v" />‘¿Malúgurúntiña funági bián jarájüñü dunúru luágu ában liraǘraü seínsu? Áni máburujantu ni ában jádaangiñe múarugun ánjein mabúseerun lubeí Júguchi Búngiu. <verse number="30" style="v" />Ásta ídiburi le jábulugubei, abájüdǘwati ában ában. <verse number="31" style="v" />Manúfude jumá lubeíti, gebégitün sügǘ jáu dunúru.</para>
  <para style="s">Ja mayéedagúnbaña láu Jesúsu jagíbugiñe gürígia</para>
  <para style="r">(<ref loc="LUK 12:8-9">Lc 12.8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" />‘Sun ja arúfudagutiña joúngua jagíbugiñe gürígia luágu númagiñeñánu lan, naríñaguba gíñe ligíbugiñe Núguchi Búngiu le siélubei luágu nánigu jamá. <verse number="33" style="v" />Ja ayéedagutiña náu jagíbugiñe gürígia, nayéedaguba gíñe jáu ligíbugiñe Núguchi Búngiu le siélubei.</para>
  <para style="s">Le busénbei lun lafálaruni Jesúsu</para>
  <para style="r">(<ref loc="LUK 12:51-53">Lc 12.51-53</ref>, <ref loc="LUK 14:26-27">14.26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" />‘Marítagua jumátia luágu niábiña lan lúnrügü níchugun gáluma uboúagu, máma niábiña íchiga gáluma, niábiña íchiga wuríbu. <verse number="35" style="v" />Láu niábin, jafánreinraguba ja mafíñebaña nuágu jáma ja afíñebaña nuágu, lawúribujaba wügǘri lúma lúguchi, isáani túma túguchu, ídiñu túma tágürü, <verse number="36" style="v" />lagáganiraguba cáda ában jáma lidújeñu.</para>
  <para style="p">
    <verse number="37" style="v" />‘Le jínsiñejabuti lun lúguchi o lúguchu sügǘ láu nísiñe lun, madǘna lumúti nánigu lan, le jínsiñejabuti joun lirájüñü sügǘ láu nísiñe lun, madǘna lumúti gíñe nánigu lan. <verse number="38" style="v" />Le mawándunti asúfuriruni líbe lasúfurirúniwa luágu gurúwa lun lafálarunina, madǘna lumúti nánigu lan. <verse number="39" style="v" />Le busénbei leséfuragun lúngua ya uboúagu leféridirubei ibágari le magúmuchadibei siélu, ánjein le ánjabei leféridiragun lúngua ya uboúagu nueígiñe, libíjubei ibágari magúmuchaditi siélu.</para>
  <para style="s">Ja lúnbaña jerésibiruni jafáyeiruaja lúmagiñe Búngiu</para>
  <para style="r">(<ref loc="MRK 9:41">Mr 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" />‘Le erésibirutün resíbi lumútina, le erésibirutina resíbi lumúti le oúnajabalina. <verse number="41" style="v" />Le erésibiruti ában proféta ladǘga liábin láu líri Búngiu, lerésibirubei afáyeiruajaü le libíjubei ában proféta, le erésibiruti ában wügǘri buíti ladǘga lubuídun, lerésibirubei afáyeiruajaü le lerésibirubei ában wügǘri buíti. <verse number="42" style="v" />Furúmieguarügü le íchuguti ában wéru dúna dilíti lun ában jádaangiñe ǘnabugutiña ja ladǘga nánigu jamá, libíjuba lafáyeiruaja lúmagiñe Búngiu.</para>
  <chapter number="11" style="c" />
  <para style="s">Ja loúnajabaña Juan le abásteragüdajabei adímureja lúma Jesúsu</para>
  <para style="r">(<ref loc="LUK 7:18-35">Lc 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Dan le lásurunbei laríñaguni Jesúsu le lúnbei jadǘgüni láni disípulugu, ába lídin ñígiñe lun larúfudajan, apúrichija ligíame lídan buri fulásu geyégua láu ubúrugu le Capernaúm.</para>
  <para style="p">
    <verse number="2" style="v" />Dan ligía, furísunruguñein Juan, ába lagáambun luágu sun le ladǘgübei Crístu. <verse number="3" style="v" />Ába loúnajan biáma jádaangiñe láni disípulugu aríjei Jesúsu lun jálügüdüni ítara.</para>
  <para style="p">—¿Amǘrü Crístubei le lúnbei liábin ódi lúnti wagúrabajan ámu?</para>
  <para style="p">
    <verse number="4" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Jeíba jaríñageime le jaríjubei lúma le jagáambubei lun Juan. <verse number="5" style="v" />Jabájüdaguáme lun luágu aríjaaña lan já meja maríjinbaña, eíbuga já meja meíbugunbaña, areídagua jagía já meja gawágubaña gumeín luágu jára, agáamba já meja magáambubaña, sará jagía jiláaña, apúrichijoúa luágu ugánu buíti le lánina asálbaruni joun gudémetiña. <verse number="6" style="v" />Áni fuleíseiwati le meféridirunbalin lafíñen nuágu.</para>
  <para style="p">
    <verse number="7" style="v" />Dan le joúdin, ába lagúmeserun Jesúsu adímureja joun gürígia luágu Juan, ába laríñagun.</para>
  <para style="p">—¿Cásan jídinbei meja aríja lídan fulásu le mageírawati? ¿Ában wügǘri le medéraaguagüdünti larítagun queísi ában mabúru le lánjingichun garábali? <verse number="8" style="v" />Ánjein máma lubeí líña, ¿cáti jídinbei aríja? ¿Ában wügǘri wéndeti ladáüragun? Subúsiti jun luágu ja lan wéndebaña adáüragun, tídaañanu lan jában urúeigu. <verse number="9" style="v" />¿Cáteiti jídinbei aríja? ¿Ában proféta? Ánja, ligía, áni ában wügǘri weíriguti sügǘ láu ában proféta Juan. <verse number="10" style="v" />Ligía le uágubei taríñaga Lerérun Búngiu.</para>
  <para style="q1">Noúnajañein noúnagüle bubáragiñe,</para>
  <para style="q1">lun laráansejani ǘma bubá.</para>
  <para style="m">
    <verse number="11" style="v" />Ninárün jáu, jádan sun gürígia, úagili ni ában weíriguti lueí Juan le abásteragüdajabei, láu sun líra, le ǘnabutimaabei lídan arúeijani le siélubei weíritimaati lueí le anǘgarügübalin ugánu luágu arúeijani ligía.</para>
  <para style="p">
    <verse number="12" style="v" />‘Lúmagiñe dan le liábinbei Juan le abásteragüdajabei darí lúmoun dan le, murúgu jáña gürígia áluga jebélurun lídoun larúeijan Búngiu. Ja ebélurubaña, ragǘ jamuti jabára ñi queísi ában cátei le gebégiti sarágu. <verse number="13" style="v" />Lilúrudun Moisés jáma sun profétagu, adímurejatiñá meja luágu larúeijan Búngiu, láu liábin Juan, ába lagúmeserun jerérun profétagu jagía luágu larúeijan Búngiu agúnfulira. <verse number="14" style="v" />Ánjeinti busén jubeí jafíñerun, Juan ligía proféta Elías lé meja lúnbei liábin lubáragiñe liábin arúeijani ligía. <verse number="15" style="v" />Ja garígeirugubaña lun jagáambun, agáamba jamá.</para>
  <para style="p">
    <verse number="16" style="v" />‘¿Cábasan úma núaradaguágüdaña gürígia ja lánina dan le? Magúndaatiña ni ca áu, ítara jáña quei irájüñü ja añúurubaña adíbirija mágidirugu, ába jagúarajan joun jíbirigu ítara. <verse number="17" style="v" />“Íñaajatiwa fídu jun, mabínajantün, erémuja wagía urému jírutu jun, mayájuntün.” <verse number="18" style="v" />Ladǘga liábin Juan meígin líña buídu quei leígin furúmieguarügü, mátun, ába jaríñagun luágu níjein lan espíritu wuríbati lídan. <verse number="19" style="v" />Lárigiñe, ába niábin, áu le Wügǘri Garaǘwarügüti, jou áu quei leígin furúmieguarügü, gurá, ába jaríñagun luágu geígadi nan, gátadi, jamáda áu gafígountiña jáma agúburajatiña liseínsuna gumádi. Wel, ja chúbaña áu, subúdi jamúti luágu buídu lan le ladǘgübei Búngiu láu lichú láu.</para>
  <para style="s">Lílana buri fulásu ja magáambadibaña</para>
  <para style="r">(<ref loc="LUK 10:13-15">Lc 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Ábati lagúmeserun Jesúsu adeínja joun gürígia lídan fulásu buri le ñi lubeí meja ladǘgei líbe-ágei láni miláguru, ladǘga masáansirun jamágili lan joúserun. Ába laríñagun.</para>
  <para style="p">
    <verse number="21" style="v" />—¡Fugiábu jugúya Corazínna! ¡Fugiábu jugúya Betsáidana! Lun jamúga lídan lan ubúrugu le gíribei Tíro lúma Sidón ladügǘwa miláguru buri le adügǘbei jagánagua, binárü jamúga lasáansiragua jagáburi lílana, ába jamúga jarúfuduni láu jadáüragun lúdu lúma balígi. <verse number="22" style="v" />Naríñajare jun luágu dánme lan lachǘlürün wéyu lánina agúseraguni, weíritimaabei jabeichún sügǘ jáu ja Tírobaña jáma ja Sidónbaña. <verse number="23" style="v" />Amǘrüti ubúrugu le Capernaúm, ¿jarítaguatibu luágu weírigubadibu lan queísi siélu? Maweírigúnbadibu ítara quei maweírigun lan máfiougati. Ladǘga lun jamúga lídan lan ubúrugu Sodóma ladügǘwa miláguru le adügǘbei bídan, níjeingua jamúga fulásu ligía lúmoun dan le. <verse number="24" style="v" />Naríñajare jun luágu lídan lánme wéyu lánina agúseraguni, weíritimaabei jabeichún sügǘ jáu Sodómana.</para>
  <para style="s">Jigoúgu lun Jesúsu, eméraagua jumámuga</para>
  <para style="r">(<ref loc="LUK 10:21-22">Lc 10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" />Lídan dan ligía, ába laríñagun Jesúsu lun Búngiu.</para>
  <para style="p">—Adímurejatina buíti buágu, Núguchi le Labúremebei siélu lúma uboú, ladǘga barámuduni buri cátei le jaweí chu táu jáma gunfaráandatiña, ába barúfuduni joun ja mafúnrendeirungiñábaña queísi irájüñü. <verse number="26" style="v" />Ánja, Núguchi, ladǘga ítara líña lan babúseeruni.</para>
  <para style="p">
    <verse number="27" style="v" />‘Derége láali Núguchi sun cátei nun. Ibídiñeti Búngiu Irájü ni ca un buídu buídu lueídügüya lun Búngiu Úguchili, ibídiñeti gíñe Búngiu Úguchili ni ca un buídu buídu lueídügüya lun Búngiu Irájü jáma ja únbaña labúseera Búngiu Irájü lasúbudiragüdüni. <verse number="28" style="v" />Jigoúgu númoun, sun jugúya ja bucháañabaña uágu lárigi juwádigimari lúma lijǘrü janǘgün, eméraaguagüda námugaün. <verse number="29" style="v" />Resíbi jumeí narúfudajan, furéndei jugúyame númagiñe, láu gagúraasun nan, ñulú tugúya nanígi, ábame jadárirun eméraaguni tun juwáni. <verse number="30" style="v" />Ménreengunti lun jesériwidun nun, juáliti gíñe anǘgüni le níchugubei jun lun janǘgüni.</para>
  <chapter number="12" style="c" />
  <para style="s">Játünjan disípulugu türígu lídan wéyu le eméraaguagülei</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mr 2.23-28</ref>; <ref loc="LUK 6:1-5">Lc 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Luágu ában wéyu le eméraaguagülei eíbugeina líña Jesúsu jáma láni disípulugu labádinagua nádü. Ába jalámachun láni disípulugu, ába játünjan lílewe türígu, ába jeígini líla. <verse number="2" style="v" />Dan le jaríjini fariséogu cátei le, ába jaríñagun lun Jesúsu.</para>
  <para style="p">—Añájatia báni disípulugu adǘga wadágimanu le moún lumuti ladügǘn lídan wéyu le eméraaguagülei.</para>
  <para style="p">
    <verse number="3" style="v" />Ába laríñagun joun.</para>
  <para style="p">—¿Malíijangidün luágu lé meja ladǘgübei Davíd luágu ában dan, dan le lalámachunbei, ligía jáma ja úarabaña lúma? <verse number="4" style="v" />Ába lebélurun tídoun lúban Búngiu, ába leígin tídaangiñe fein to sagráuboun to moun luboún yebe leíginun, ni ligía ni ja úarabaña lúma, fádirigu rügǘñanu lun jeíginun fein tugúya según lilúrudun Moisés, áni mámati figoú le ladǘgübei Davíd ligíbugiñe Búngiu. <verse number="5" style="v" />¿Ódi malíijangidün lídan lilúrudun Moisés luágu ñadágimein jamá fádirigu tídan lúban Búngiu lídan wéyu le eméraaguagülei áni máma figoú? <verse number="6" style="v" />Naríñajare jun luágu níjein lan ában weíriguti sügǘ táu lúban Búngiu ya, áu. <verse number="7" style="v" />Jugúya, úagili gunfaráanda jumáni le laríñagubei Búngiu tídan Lerérun. “Jímein numúti lun gudémejabu jumá sügǘ láu jadágaragüdün anímaalu nun.” Lun jamúga gunfaráanda jumáni, madímurejaantün jamúga wuríbati jawágu gürígia ja madǘgünbaña ni cáta wuríbati. <verse number="8" style="v" />Gabáfutina gíñe, áu le Wügǘri Garaǘwarügüti, lun naríñagun cába lan gayára ladügǘniwa lídan wéyu le eméraaguagülei.</para>
  <para style="s">Wügǘri le jiláalibei ában lújabu</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mr 3.1-6</ref>; <ref loc="LUK 6:6-11">Lc 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />Ába lídin Jesúsu ñígiñe, ába lebélurun tídoun jalígilisin juríu. <verse number="10" style="v" />Ñíñein ában wügǘri jiláali ában lújabu, queíti busén jamá fariséogu jáma arúfudajatiña lilúrudun Moisés jadárirun lichára Jesúsu, ába jaríñagun lun.</para>
  <para style="p">—¿Gayáraatísan lagáranijoún lun ában sánditi lídan wéyu le eméraaguagülei?</para>
  <para style="p">
    <verse number="11" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—¿Ca jídaangiñe, ánjein galǘgün lubeí ában mudún, ába teíguadun lídoun ában wélu wéyu le eméraaguagülei, lun mídinbei lan aságaroun? <verse number="12" style="v" />¡Ma gebégitimaati ában wügǘri sügǘ táu ában mudún! Gayáraati lubeíti ladügǘn buíti lídan wéyu le eméraaguagülei.</para>
  <para style="p">
    <verse number="13" style="v" />Ába laríñagun lun wügǘri ligía.</para>
  <para style="p">—Tulébei bújabu.</para>
  <para style="p">Dan le látuleruni, ába lareídagun quei le ában. <verse number="14" style="v" />Ába jáfuridunga fariséogu, ába jagúmeserun áluaja ída lúba lan jáfaruni Jesúsu jilágubei.</para>
  <para style="s">Lé meja laríñagubei Isaías luágu Jesúsu</para>
  <para style="p">
    <verse number="15" style="v" />Dan lasúbudirunbalin Jesúsu cátei le, ába lídin ñígiñe, ába jafálaruni sarágu gürígia, ába lareídaguagüdüniña sun sánditiña. <verse number="16" style="v" />Ábaja laríñagun joun lun maríñagun jamáni cáteiñein lan. <verse number="17" style="v" />Lasúseredunbei líra lun lagúnfulirun lé meja laríñagubei proféta Isaías.</para>
  <para style="q1">
    <verse number="18" style="v" />Niján numútun le nanúadirubei lun lesériwidun nun, le jínsiñebei nun, le áubei nagúndaara, líña Búngiu.</para>
  <para style="q1">Níchugubei náni Espíritu luágu,</para>
  <para style="q1">ábame larúfudajani joun ja mámabaña juríu ída lúba lan gayára lan júaradun nigíbugiñe.</para>
  <para style="q1">
    <verse number="19" style="v" />Mageíndagunbei, magúaragun,</para>
  <para style="q1">mareínjabei ǘmada.</para>
  <para style="q1">
    <verse number="20" style="v" />Gudémejabubei joun gürígia ja gudémebaña queísi ában mabúru le barúguaali, lúma joun ja débilibaña lídan jafíñen queísi ában lámpu le ñegúmemeeli.</para>
  <para style="q1">Ítara méme lúba daríme adǘga láali larúeijan le úaraguabei.</para>
  <para style="q1">
    <verse number="21" style="v" />Ábame jíchuguni ja mámabaña juríu jeménigi luágu.</para>
  <para style="s">Laríñawagún luágu lubáfu lan Máfia lúmabei Jesúsu</para>
  <para style="r">(<ref loc="MRK 3:19-30">Mr 3.19-30</ref>; <ref loc="LUK 11:14-23">Lc 11.14-23</ref>, <ref loc="LUK 12:10">12.10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />Ábati lanügǘniwa ában wügǘri lun Jesúsu, maríjin líña, madímurejan, láuñein ában espíritu wuríbati. Ába laságaruni Jesúsu espíritu wuríbati lídaangiñe, ába laríjin, adímureja ligía. <verse number="23" style="v" />Ába laweíridun janígi sun ja ñíbaña, ába jaríñagun.</para>
  <para style="p">—¿Niján funásan ladǘgawagunbei Davíd?</para>
  <para style="p">
    <verse number="24" style="v" />Dan le jagáambunbalin fariséogu cátei le, ába jaríñagun.</para>
  <para style="p">—Wügǘri le, láu lubáfu Beelzebú, le Máfia, le jábuti espíritugu wuríbatiña laságajaña.</para>
  <para style="p">
    <verse number="25" style="v" />Quei subúdi láani Jesúsu le jarítagubei, ába laríñagun joun.</para>
  <para style="p">—Furúmieguarügü arúeijani le afánreinraguti lun jageíndagun jámagua, lagǘnrinchaguba, ánjaña gíñe afáreinragua lílana ában ubúrugu o ában lan família ladǘga wuríbu, siñábei jadúrarun. <verse number="26" style="v" />Ítara líña giñéti, ánjein laságara Máfia máfia guánarügü, ligía guánarügü afánreinragubei, áni ¿ída lubáti ladúrarun lubáfu ítara? <verse number="27" style="v" />Jugúya, aríñagatün luágu láu lan lubáfu Beelzebú, o Máfia, naságaja espíritugu wuríbatiña, ánjein ítara líña lubeí, ¿cáti íchugubei ubáfu joun ja jánigu jugúya lun jaságajaniña, Máfia ódi Búngiu? Jagía guánarügü arúfuda jamúti luágu bulíeigua jumá. <verse number="28" style="v" />Áu, láu lubáfu láni Búngiu Espíritu naságaja espíritugu wuríbatiña. Arúfuda lumúti líra luágu chülǘjali lan larúeijan Búngiu jídoun.</para>
  <para style="p">
    <verse number="29" style="v" />‘¿Ída lubági gayára lan lebélurun ában gürígia lúbiñoun ában wügǘri jéreti lun lanǘgüni lílagu ánjein magǘragun lan furúmiñe? Ítara rügǘñein lun gayára lan lanǘgüni lílagu.</para>
  <para style="p">
    <verse number="30" style="v" />‘Le mámabei númagiñe, náganiñein, le míderagun lumútina, güríngua lumúti le nadǘgübei.</para>
  <para style="p">
    <verse number="31" style="v" />‘Jugúya aríñagatün luágu láu lan lubáfu Máfia naságaja espíritugu wuríbatiña, áni láu lubáfu Sífiri Sándu naságajaña. Ligía naríñagunbei jun luágu gayára lan ferúdunawa lan sun figoú lúma sun wuríbati le jaríñagubei gürígia, ánjein lun jadímurejan wuríbati luágu Sífiri Sándu, siñábei ferúdunawa lan figoú líra. <verse number="32" style="v" />Furúmieguarügü gíñe le aríñaguti furúmieguarügü cátei wuríbati nuágu, áu le Wügǘri Garaǘwarügüti, gayáraati ferúdunawa lan, ánjeinti le adímurejati wuríbati luágu lubáfu Sífiri Sándu le nídaanbei, úabei ferúdunawa lan ni lídan uboú le, ni lídan le ában.</para>
  <para style="s">Luágu lin ídibu lasúbudirúa ca lan luwúyeribei</para>
  <para style="r">(<ref loc="LUK 6:43-45">Lc 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" />‘Ánjein buídu lubeí ídibu, buídubei gíñe lin, ánjein mabuídun lubeí ídibu, mabuídunbei gíñe lin. Luágu lin ídibu lasúbudirúa ca lan luwúyeribei. <verse number="34" style="v" />¡Jarásan jéwe jugúya le! Siñáti jadímurejan cátei buíti, wuríbatüngan. Cátei le buínbei tídan anígi, ligía laríñagubei iyúmaü. <verse number="35" style="v" />Wügǘri le buídubei, cátei buíti laríñagubei ladǘga tídaañein lan lanígi ubuíduni, wügǘri le wuríbabei, cátei wuríbati laríñagubei ladǘga tídaañein lanígi wuríbani. <verse number="36" style="v" />Naríñajare jun luágu dánme lan lachǘlürün luwéyuri agúseruni, sun gürígia geféenbaña luágu sun dimúrei málati le jaríñagubei, <verse number="37" style="v" />ladǘga luáguba le baríñagubei bagúseragüdǘwa, ligíaba arúfudei ánjein gadúnrun bubeí lúmoun madúnrun ban.</para>
  <para style="s">Jamúriajan gürígia wuríbatiña seíni láuti miláguru</para>
  <para style="r">(<ref loc="MRK 8:12">Mr 8.12</ref>; <ref loc="LUK 11:29-32">Lc 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" />Ába jaríñagun jádaangiñe fariséogu jáma arúfudajatiña lilúrudun Moisés lun Jesúsu.</para>
  <para style="p">—Maésturu, buséntiwa waríjin badǘgün ában seíni le láuti miláguru luágu lúmagiñe lan Búngiu biábin.</para>
  <para style="p">
    <verse number="39" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Gürígia wuríbatiña áni magúnfuliruntiña amúriajatiña seíni láuti miláguru, míchugúnbei ámu seíni joun lueí le asúseredubei lun proféta Jonás. <verse number="40" style="v" />Ladǘga queí leréderun Jonás ǘrüwa wéyu ǘrüwa áriebu lurágeirugu údu, ítara lúba gíñe neréderun, áu le Wügǘri Garaǘwarügüti, lídan numúaja ǘrüwa wéyu, ǘrüwa áriebu, según ligáburi jabájüdüni juríu dan. <verse number="41" style="v" />Já meja aganoúbaña Nínive jásaaruba lídan luwéyuri agúseruni dánme jagúseragüdǘniwa gürígia ja lánina dan le, ábame jíchugun jadúnrun ladǘga sáansiguati jagáburi Nínivena dan le lapúrichijanbalin Jonás lugánute Búngiu joun, áni anája áu, ában weíriguti sügǘ láu Jonás, áni májatün jagáambunina. <verse number="42" style="v" />Tásaaruba gíñe lurúeitena Súru lídan luwéyuri agúseruni dánme le jagúseragüdǘniwa gürígia ja lánina dan le, ábame tíchugun jadúnrun, ladǘga ñǘbintu lídaangiñe lidíse-ágei uboú lun tagáambuni lichú láu Salomón, áni anája áu, ában weíriguti sügǘ láu Salomón, áni májatün jagáambunina.</para>
  <para style="s">Espíritu wuríbati le agíribuduti</para>
  <para style="r">(<ref loc="LUK 11:24-26">Lc 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" />‘Dan le láfuridun ában espíritu wuríbati lídaangiñe ában gürígia, ába eíbugañaja lan lídan fulásu mábeiti áluaja leméraagun, dan madári láani, ába laríñagun lúnguarügü. <verse number="44" style="v" />“Nagíribuda tídoun núban to ñígiñe lubeí náfurida.” Dan le lagíribudun, ába ladáriruni gürígia buga ligía queísi ában múna to málatu, abuídajoúaaru, aráanserúa. <verse number="45" style="v" />Ábati lídin, ába liábin jáu sédü espíritugu wuríbatimaatiña sügǘ láu, ába jebélurun sun jagía agánawa lídan gürígia ligía, wuríbatimájaliti le gádaanbalin sügǘ láu meja furúmiñe. Ítara lúba giñéti lasúseredun joun gürígia wuríbatiña ja lánina dan le.</para>
  <para style="s">Lúguchu Jesúsu jáma lamúlen</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mr 3.31-35</ref>; <ref loc="LUK 8:19-21">Lc 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" />Ñígili Jesúsu adímureja joun gürígia, ligía tiábin lúguchu jáu lamúlenu. Ába jeréderun boúgudi, buséntiña yébe jadímurejan lúma. <verse number="47" style="v" />Ába laríñawagún lun Jesúsu.</para>
  <para style="p">—Nuján búguchu jáma bamúlenu ya boúgudi, buséntiña jadímurejan búma.</para>
  <para style="p">
    <verse number="48" style="v" />Ába laríñagun Jesúsu lun le awísarubalin.</para>
  <para style="p">—¿Ca núguchuboun, ca namúlenubaña?</para>
  <para style="p">
    <verse number="49" style="v" />Ába larúfudun jawágun láni disípulugu, ába laríñagun.</para>
  <para style="p">—Añája núguchubaña, jagía gíñe namúlenubaña, <verse number="50" style="v" />ladǘga furúmieguarügü le adǘgüti lugúndan Núguchi le siélubei, ligía namúlenbei, nítu, núguchu.</para>
  <chapter number="13" style="c" />
  <para style="s">Jémpulu luáguti ábunaguti</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mr 4.1-9</ref>; <ref loc="LUK 8:4-8">Lc 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Wéyu ligía, ába láfuridun Jesúsu múnadagiñe, ába lañúurun láru dúna. <verse number="2" style="v" />Quei jagíbedagun gürígia le ñí lubei, ába ládinun tídoun ában ugúnein, ába lañúurun, ába jeréderun sun gürígia láru dúna. <verse number="3" style="v" />Ába larúfudajan sarágu cátei joun láu jémpulu, ába laríñagun.</para>
  <para style="p">—Ñíñein ában ábunaguti, ába láfuridun ábunagua. <verse number="4" style="v" />Lídan afúrujeina láani líla nádü, ába láburujan lídaangiñe luágun ǘma, ába jayábin dunúru, ába jeígini. <verse number="5" style="v" />Líbiri, ába láburujan labádinaguoún dǘbü le ñí lumuti úa lan sarágu múa, ába laboúchun furése ladǘga majúlilin lan múa. <verse number="6" style="v" />Dan le lásüdün wéyu, ába lásaürün queíti málagüle lan, ába loúnwen. <verse number="7" style="v" />Líbiri ílaü, ába láburujan labádinaguoún jíyu, ába laweínamudun jíyu úara lúma, ába láfaruni. <verse number="8" style="v" />Ñíñein lídaangiñe, áburujati lídoun múa buíti, alúbajoúati buídu, níjein lídaangiñe, íchuguti san águu luágu cáda ában águu, líbiri rúti ǘrüwa-wein, líbiri darándi. <verse number="9" style="v" />Jugúya le garígeirugubei lun jagáambun, agáamba jumána.</para>
  <para style="s">Ca lan laníchigubei jémpulu le</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mr 4.10-12</ref>; <ref loc="LUK 8:9-10">Lc 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" />Ábati jayábin disípulugu, ába jaríñagun lun Jesúsu.</para>
  <para style="p">—¿Cásan uágu badímureja joun gürígia láu jémpulu?</para>
  <para style="p">
    <verse number="11" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Jugúya, subúdigüda láali Búngiu sun cátei arámudaguati le lánina larúeijan jun, ánjein jagía, siñáti jasúbudiruni. <verse number="12" style="v" />Le agúnfuliruti lúma inárüni le lagáambubei, líchugúba lánwoun lun, ánjein le maténirunti lun, gidáwarügübei murúsun larúgounga le lúmabei lueí. <verse number="13" style="v" />Ligía nadímurejanbei joun láu jémpulu ladǘga aríja jamáni le nadǘgübei, ába jeréderun camá maríjintiña, agáamba jameí le naríñagubei, ába jeréderun úaga gunfaráanda jamá camá jamuga magáambuntiña. <verse number="14" style="v" />Jawágu lagúnfulira lé meja laríñagubei proféta Isaías dan laríñagunbei.</para>
  <para style="q1">Jugúya, jagáambuba, úabei gunfaráanda jumá,</para>
  <para style="q1">jaríjuba, ibídiñebei jun ca lan lílabei le jaríjubei,</para>
  <para style="q1">
    <verse number="15" style="v" />ladǘga deréeru janígi,</para>
  <para style="q1">wuríbaaliti jagáambun,</para>
  <para style="q1">murúñu líña jágu,</para>
  <para style="q1">lun maríjin jumá láu,</para>
  <para style="q1">magáambun láu jarígeirugu,</para>
  <para style="q1">úa gunfaráanda jumá táu janígi,</para>
  <para style="q1">magáraragun jugúyame nun lun nareídaguagüdünün.</para>
  <para style="p">
    <verse number="16" style="v" />‘Ánjeinti jugúya le nánigubei, fuleíseiwatün ladǘga aríjatün láu jágu, agáamba jugúya láu jarígeirugu. <verse number="17" style="v" />Ninárün jáu, sarágu jañá meja profétagu jáma ámu gürígia gúnfulitiña lúma Búngiu abúseerutiña jamúga jaríjinina quei jaríjinina jugúya guetó, maríjin jamútina, buséntiña jamúga meja jagáambuni le jagáambubei jugúya, magáambun jamúti.</para>
  <para style="s">Lafúnraanguagüdüni Jesúsu jémpulu luáguti ábunaguti</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mr 4.13-20</ref>; <ref loc="LUK 8:11-15">Lc 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />‘Agáamba jumeíti le lílabei jémpulu luáguti ábunaguti. <verse number="19" style="v" />Ja agáambubalin ugánu luáguti arúeijani le lánina siélu áni úati gunfaráanda jamáni, ítara jáña quei ǘma le ídounbei láburuja lídaangiñe líla nádü, ába liábin Máfia, ába laságaruni ugánu buíti le ábunúbei tídaangiñe janígi. <verse number="20" style="v" />Dǘbü le ñíjin lubeí láburuja ílaü, ítara líña quei gürígia ja agáambubalin ugánu, ába jerésibiruni láu ugúndani, <verse number="21" style="v" />quei márügüdün lubeí buídu tídan janígi, madúrati jádan. Dánti le lachǘlürün dan lun joúchawagún lúma jeíbaajoún lueígiñe ugánu ligía, ába leíguadun jarǘna. <verse number="22" style="v" />Jíyu le ñíjin lubeí láburuja ílaü, ítara líña quei gürígia ja agáambubalin ugánu, weíritimaati jafúudun luágu cátei le lánina ibágari le, ába leyéeduniña irísini. Sun le, ába láfaruni ugánu tídaangiñe janígi, mígiruntiti lun lalúbajoún jádan gürígia jagía. <verse number="23" style="v" />Múa buíti le ñíjin lubeí láburuja ílaü, ítara líña quei gürígia ja agáambubalin ugánu, ába gunfaráanda jamáni, ába jíchugun ában alúbajoúni buíti. Añájein, ítara jáña quei ílaü le íchugubei san águu luágu ában, jíbiri quei le íchugubei ǘrüwa-wein, jíbiri quei le íchugubei darándi.</para>
  <para style="s">Jémpulu luáguti jíduru wuríbati labádinagua türígu</para>
  <para style="p">
    <verse number="24" style="v" />Ábaya líchuguni Jesúsu jémpulu le joun.</para>
  <para style="p">—Arúeijani le lánina siélu, ítara líña quei ában wügǘri le ábunagubei ílaü buíti lídan lufúlasun, <verse number="25" style="v" />dan añája lan sun ja ñíbaña arúmuga, ába lebélurun ában lágani labúreme fulásu ligía, ába lábunun jíduru wuríbati labádinagua türígu, ába lídin. <verse number="26" style="v" />Dan le laweínamudun türígu ába legélewejan, ába gíñe lachǘlaagun jíduru wuríbati. <verse number="27" style="v" />Ába joúdin músu, ába jaríñagun lun jayúbudiri. “Wayúbudiri, ánjein buídu lubeí ílaü le bábunagubei bumúanrugu, ¿jalíagiñésan lasálira jíduru wuríbati le?” <verse number="28" style="v" />Ába laríñagun iyúbudiri joun. “Ladǘga ában ágani le.” Ábati jaríñagun músu lun. “¿Buséntibu lun wájulajani jíduru wuríbati le?” <verse number="29" style="v" />Ába laríñagun joun. “Uá, ladǘga dánme jájulajani jíduru wuríbati, julá jíñein lin gíñe türígu úara lúma. <verse number="30" style="v" />Ígiragubei jumeí lun laweínamudun úara daríme lidáani alúbajani, ábame naríñagun joun ñadágimeintiña lun jájulajani jíduru wuríbati furúmiñe, ábame jagǘraguni lun lágudúniwa, lárigiñeme, ábame jareíduni türígu tídan lágei.”</para>
  <para style="s">Jémpulu luáguti tíla mostása</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mr 4.30-32</ref>; <ref loc="LUK 13:18-19">Lc 13.18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Rúlumuti gíñe Jesúsu jémpulu le joun.</para>
  <para style="p">—Ítara líña arúeijani lánina siélu quei ában tíla mostása le lábunubei ában wügǘri lufúlasunrugu. <verse number="32" style="v" />Tíla mostása, ligía ílaü ñǘraütimaabei lídaangiñe sun ílaü, áni dan laboúchun, ligía weíritimaabei lídaangiñe sun nádü, ába liábin lun ábanbei lan wéwe weíriti darí lun jayábin dunúru adǘga jádibu luágu lilímun.</para>
  <para style="s">Jémpulu luáguti ísi</para>
  <para style="r">(<ref loc="LUK 13:20-21">Lc 13.20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" />Rúlumuti gíñe jémpulu le joun.</para>
  <para style="p">—Ítara líña arúeijani le lánina siélu quei ísi le tagúbudubei ában wǘri tídan ǘrüwa líburu fulúwaaru, ába terésirun sun fulúwaaru tugúya.</para>
  <para style="s">Ca lan lébunabei líchuguni Jesúsu jémpulu buri le</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mr 4.33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" />Láu jémpulu laríñagei Jesúsu sun cátei le joun gürígia, maríñagunti ni cáta joun mayúsurunga jémpulu. <verse number="35" style="v" />Sun cátei le, lun lagúnfulirun le laríñagubeí meja Búngiu liyúmulugugiñe proféta.</para>
  <para style="q1">Nadímurejaba láu jémpulu jun,</para>
  <para style="q1">nafúnraanguagüdübei cátei lé buri meja arámudaguabei jun lúmagiñe nadǘgüni uboú.</para>
  <para style="s">Lafúnraanguagüdüni Jesúsu jémpulu le luáguti jíduru wuríbati labádinagua türígu</para>
  <para style="p">
    <verse number="36" style="v" />Ába loúnajaniña Jesúsu gürígia jábiñoun, ába lebélurun múnadoun, ába jayábin láni disípulugu, ába jaríñagun lun.</para>
  <para style="p">—Furáanguagüdabeí jémpulu le luáguti jíduru wuríbati woun.</para>
  <para style="p">
    <verse number="37" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Áu le Wügǘri Garaǘwarügüti, áu le ábunagubalin ílaü buíti, <verse number="38" style="v" />múa, ligía uboúbei, ílaü buíti, jagía gürígia ja lílana larúeijan Búngiu, jíduru wuríbati, jagía gürígia ja lánigu Máfia, <verse number="39" style="v" />áganiti le ábunubalin jíduru wuríbati, Máfia méme, alúbajani, ligía lagúmuchunbei uboú, ja alúbajabaña, ánjeligu. <verse number="40" style="v" />Ítara quei labúdajoúniwa jíduru wuríbati ába lágurún wáturugun lun lágudun, ítara lúba gíñe lasúseredun dánme lagúmuchun uboú, <verse number="41" style="v" />áu le Wügǘri Garaǘwarügüti, noúnajabaña náni ánjeligu aságaraña sun ja afígoungüdübaña ámu, jáma ja adǘgübaña wuríbati, lídaangiñe narúeijan, <verse number="42" style="v" />ábame jácharaguniña lídoun wátu geméti lánina máfiougati. Ábame jayájuajan ñi, ábame lacǘnrinjan jári. <verse number="43" style="v" />Jámeti adǘgübalin le lubeíbei Búngiu, ábame jámiridun quei wéyu lídan larúeijan Wáguchi Búngiu. Agáamba jumána, jugúya le garígeirugubei lun jagáambun.</para>
  <para style="s">Jémpulu luáguti irísini le arámudúañubei</para>
  <para style="p">
    <verse number="44" style="v" />‘Ítara líña arúeijani le lánina siélu quei irísini le arámudúañubei lábugiñe múa. Ladárirei ában wügǘri irísini ligía, ábaya larámuduni ñi méme, le luweírin lugúndan, ába lídin, ába lalúguruni sun le lúmabei, ába lagáñijani fulásu ligía.</para>
  <para style="s">Jémpulu luáguti pérla le weíribei ebégi</para>
  <para style="p">
    <verse number="45" style="v" />‘Ítara líña gíñe arúeijani le lánina siélu quei ában alúgurajati le eíbugañajabei áluaja pérla fínuti, <verse number="46" style="v" />dánti ladárirun ában le weíriti lebégi, ába lídin, ába lalúguruni sun le lúmabei, ába lagáñijani pérla ligía.</para>
  <para style="s">Jémpulu tuáguti séni</para>
  <para style="p">
    <verse number="47" style="v" />‘Ítara líña gíñe arúeijani le lánina siélu quei ában séni to agurúboun baránaja, ába tañúgun sun jawúyeri úduraü. <verse number="48" style="v" />Dan tabuínchun, ába jacháwarunun esénijatiña lárun béya, ába jañúurun ñi anúadajaña úduraü, ába jareíduniña ja buídubaña, ába jachágaruniña ja wuríbabaña. <verse number="49" style="v" />Ítara lúba dánme lagúmuchun uboú, jayábiba ánjeligu lun jafánreinruniña ja buídubaña jádaangiñe ja wuríbabaña. <verse number="50" style="v" />Ábame jádaruniña ja wuríbabaña lídoun wátu geméti lánina máfiougati, ñíba lubeí jayájuaja, acǘnrijame jári.</para>
  <para style="s">Irísini buri iséri lúma binádu</para>
  <para style="p">
    <verse number="51" style="v" />Ábati lálügüdüniña Jesúsu, laríñaga joun.</para>
  <para style="p">—¿Gunfaráanda jumútisan sun cátei le?</para>
  <para style="p">Ába jaríñagun.</para>
  <para style="p">—Ánja, Wabúreme.</para>
  <para style="p">
    <verse number="52" style="v" />Ábati laríñagun joun.</para>
  <para style="p">—Dan le liábin ában arúfudajati lilúrudun Moisés lun gunfaráanda láni luáguti arúeijani le lánina siélu, ába ítara lan quei ában iyúbudiri le gaságaraditi cátei iséri buri lúma cátei binádu buri lídaangiñe lirísin lun líchuguni joun tílana lúban dan le jemégeiruni, queígubeirügü, gayáraati larúfudajan joun gürígia luágu lilúrudun Moisés lúma gíñe luágu cátei le narúfudajabei, áu le Jesúsu.</para>
  <para style="s">Jesúsu lídan fulásu le gíribei Nazarét</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mr 6.1-6</ref>; <ref loc="LUK 4:16-30">Lc 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" />Dan lagúmuchunbei líchuguni Jesúsu jémpulu buri le, ába lídin ñígiñe, <verse number="54" style="v" />ába lachǘlürün lageíroun. Ába lagúmeserun arúfudaja tídan jalígilisin juríu to lídaanboun fulásu ligía, ába laweíridun janígi gürígia, ába jaríñagun.</para>
  <para style="p">—¿Jalíasan lafúnrendeirei wügǘri le sun lichú áu le? ¿Ída liñásan gayára láani miláguru buri le adǘga? <verse number="55" style="v" />Liraǘga saráfangei le, María lúguchuboun, líbugaña Jacóbo, José, Simón lúma Júdas, <verse number="56" style="v" />ya gíñe jagánawa lamúlenu jáma lítunu wádan. ¿Jalíagiñeti lasúbudirei sun le?</para>
  <para style="p">
    <verse number="57" style="v" />Ába jamájarun lun jerésibiruni. Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Sun gürígia jínsiñeti ában proféta joun, mámarügaali ligía lídaangiñeti fulásu le ñí jabeí o tílana lan jában.</para>
  <para style="p">
    <verse number="58" style="v" />Madǘgüntiti sarágu miláguru ñi ladǘga mafíñen jamá luágu.</para>
  <para style="s">Loúnwen Juan le abásteragüdajabei</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mr 6.14-29</ref>; <ref loc="LUK 9:7-9">Lc 9.7-9</ref>)</para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />Lídan dan ligía, ába lagáambun Heródes, le gumándan lídan fulásu le gíribei Galiléa, luágu Jesúsu, <verse number="2" style="v" />ába laríñagun joun ja lúmabaña.</para>
  <para style="p">—Juan le abásteragüdajabei le, sará jádaangiñe jiláaña, ligía gabáfu lubeí lun ladáagun miláguru.</para>
  <para style="p">
    <verse number="3" style="v" />Lé meja suséreelibei, daǘlumuti meja Heródes Juan, ába lagǘraguágüdüni láu güríngüri tueígiñe Heródias tó meja lúmari Felípe, le lamúlen. <verse number="4" style="v" />Aríñagaalí meja Juan lun Heródes luágu moun láni lagámaridunun lúmari lamúlen, madǘgünti Heródes gásu láu.</para>
  <para style="p">
    <verse number="5" style="v" />Busénti yebéti Heródes láfaruni Juan jilágubei, ladǘga lanúfude jaweí gürígia, madǘgun lumúti ladǘga sun lan gürígia afíñetiña luágu proféta lan Juan. <verse number="6" style="v" />Dánti le efédujani luágu lagúnfulirun Heródes irúmu, ába tiábin tiraǘ Heródias, ába tabínajan jagíbugiñe amísurajoútiña, léti línsiñe tabínajan lun Heródes, <verse number="7" style="v" />ába laríñagun tun láu fiñún luágu líchugubei lan furúmieguarügü cátei le tamúriajan lúma tun. <verse number="8" style="v" />Ábati taríñagun túguchu tun lun tamúriajani lábulugu Juan le abáste jilágubei, ladǘga, lun jíchuguni tun lídan ában asíedu, ába tamúriajani lúma ítara.</para>
  <para style="p">
    <verse number="9" style="v" />Ába lírudagun Heródes lueígiñe cátei le, quei aríñaga láali lan láu fiñún, agáamba jameí amísurajoútiña, ába laríñagun lun líchugúniwa tun. <verse number="10" style="v" />Ábati laríñagun lun ladǘrürǘniwa lábulugu Juan furísunrugu, <verse number="11" style="v" />ába janǘgüni lídan ában asíedu, ába líchugúniwa tun irájü tugúya, ába tíchuguni tun túguchu.</para>
  <para style="p">
    <verse number="12" style="v" />Ábati jayábin l-íñagun tun láu fiñún luágu lanigu Juan, ába janǘgüni lúgubu, ába jábununi, lárigiñe, ába joúdin awísarei Jesúsu.</para>
  <para style="s">Líchugun Jesúsu eígini joun seíngü mílu wügǘriña</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mr 6.30-44</ref>; <ref loc="LUK 9:10-17">Lc 9.10-17</ref>; <ref loc="JHN 6:1-14">Jn 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Dan lagáambuni Jesúsu cátei le, ába lídin ñígiñe jáurügü láni disípulugu tídan ában ugúnein lídoun ában fulásu mageírawati. Ába jasúbudiruni gürígia, ába jáfuridun lídaangiñé buri aǘdü, ába joúdin lárigi, eíbu. <verse number="14" style="v" />Dan larárirun Jesúsu tídaangiñe ugúnein, ába laríjin luágu sarágu jaña lan gürígia jagía, ába jagúdemedagun lun, ába lareídaguagüdüniña ja sándibaña jádan. <verse number="15" style="v" />Queíti agúñedeinaali lubeí, ába jaríñagun láni Jesúsu disípulugu lun.</para>
  <para style="p">—Dárüjalitia áni úatiña gürígia aganoútiña lídan fulásu le. Oúnaja báña gürígia ja, ñǘdün jamámuga lídoun buri lirájüñü fulásu yaráfa agáñija eígini lun jeígin.</para>
  <para style="p">
    <verse number="16" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Mídinbaña, rújuma eígini joun.</para>
  <para style="p">
    <verse number="17" style="v" />Ába jaríñagun lun.</para>
  <para style="p">—Seíngü rügǘñoun fein wáma ya, jáma bián úduraü.</para>
  <para style="p">
    <verse number="18" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Barǘjumoun nun ñájoun.</para>
  <para style="p">
    <verse number="19" style="v" />Ába laríñagun joun gürígia lun jañúurun luágu jíduru. Ába lanǘgünun seíngü fein jáma bián úduraü jagía lújaburugu, ába laríjin siélun, ába leteíngiruni Búngiu tuágu. Ábati lagúbachagunun fein, ába líchugunun joun láni irun Jesúsu tídaangiñe ugúneidisípulugu, ába jafánreinjanun jádan gürígia. <verse number="20" style="v" />Sun jagía joútiña quimúle, lárigiñe, ába jabuínchagüdün dúusu faníñe táu to ígiragutu. <verse number="21" style="v" />Seíngüñanu mílu wügǘriña eígitiña, mabájüdünga würíña jáma irájüñü.</para>
  <para style="s">Leíbugun Jesúsu ligíbuagu dúna</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mr 6.45-52</ref>; <ref loc="JHN 6:16-21">Jn 6.16-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />Ába loúnajaniña Jesúsu láni disípulugu lubá tídan ugúnein tugúya lun jánjiñuragun loubáfurugun sun niján lan oúnajaña gürígia águyu. <verse number="23" style="v" />Lásun loúnajaniña, ába laweínrun lábugua luágun wǘbü ayúmuragua lun Búngiu. Dan le lagúñedunbei, ñíñein Jesúsu lábugua, <verse number="24" style="v" />sun núnguran tan ugúnein lamídan dúna. Ába láfarajan lugúdi barána tuágu ugúnein ladǘga tubárouñein lan garábali. <verse number="25" style="v" />Ába liábin Jesúsu jawágun lubá larúgan, eíbugeina ligíbuagu dúna. <verse number="26" style="v" />Dan jaríjini láni disípulugu eíbugeina ligíbuagu dúna, ába janúfudedagun, ába jagúaragun láu anúfudei.</para>
  <para style="p">—¡Úfiaü!</para>
  <para style="p">
    <verse number="27" style="v" />Ába ladímurejan Jesúsu joun, ába laríñagun joun.</para>
  <para style="p">—¡Ragǘjuma anígi, áu le, manúfudeda jumá!</para>
  <para style="p">
    <verse number="28" style="v" />Ába laríñagun Pédro lun.</para>
  <para style="p">—Nabúreme, ánjein amǘrü lubeí, eíbugagüda bána gíñe ligíbuagu dúna chülǘ le ñí bubei.</para>
  <para style="p">
    <verse number="29" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Jigábuti.</para>
  <para style="p">Ába larárirun Pédro tídaangiñe ugúnein, ába lagúmeserun eíbuga le ñíjin lubeí Jesúsu ligíbuagu dúna. <verse number="30" style="v" />Dan le lasándiruni lére garábali ába lanúfudedagun, ába lagúmeserun abúlucha, ába lagúaragun.</para>
  <para style="p">—¡Séfu bána Nabúreme!</para>
  <para style="p">
    <verse number="31" style="v" />Ába lárügüdüni Jesúsu lújabu, ába laríñagun lun.</para>
  <para style="p">—¡Loúguati gíñe bafíñen! ¿Ca uágu laloúguada bafíñen?</para>
  <para style="p">
    <verse number="32" style="v" />Dan jádinun tídoun ugúnein, ába lagálumadun garábali. <verse number="33" style="v" />Játi buga tídaanbaña ugúnein, ába jájuduragun ligíbugiñe Jesúsu, ába jaríñagun.</para>
  <para style="p">—Inárüni luágu Liraǘ ban Búngiu.</para>
  <para style="s">Lareídaguagüdüniña Jesúsu sánditiña Genésaret</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mr 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" />Ába jánjiñuraguni dúna, ába jachǘlürün Genésaret. <verse number="35" style="v" />Dan le jíchugunbei lílana fulásu fe luágu Jesúsu lan, ába jabúruchaguagüdüni lídan sun fulásu ligía, ába janǘgüniña sun sánditiña le ñíjin lubeí. <verse number="36" style="v" />Ába jayúmuragun lun lun lígirun lúnrügü jagúuruni táru lanáangun, sun ja agúurubarun, areídaguátiña.</para>
  <chapter number="15" style="c" />
  <para style="s">Cátei le marúmadagüdünbaliña gürígia ligíbugiñe Búngiu</para>
  <para style="r">(<ref loc="MRK 7:1-23">Mr 7.1-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ába jayábin fiú fariséogu jáma arúfudajatiña lilúrudun Moisés, ñǘbintiña ubúrugugiñe Jerusalén lúmoun Jesúsu, ába jaríñagun lun.</para>
  <para style="p">
    <verse number="2" style="v" />—¿Ánsan jájalachagunbalin báni disípulugu binádu jagáburi weíyaaña mútu? Magúnfuliruntiña láu lachibúniwa újabu lubá eígini, según wagáburi.</para>
  <para style="p">
    <verse number="3" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—¿Ánti gíñe jájalachagunbalin lerérun Búngiu lun jafálaruni binádu jigáburi? <verse number="4" style="v" />Laríñajare Búngiu. “Inébe jamá bagǘbürigu bun, le anábagubaliña lagǘbürigu, jilála.” <verse number="5" style="v" />Ánjeinti jugúya, aríñagatün luágu gayára lan laríñagun ában gürígia lun lúguchi o tun lúguchu. “Siñáti níderagunibu ladǘga sun le númabei, aríñagaadina luágu lun lan níchuguni lun Búngiu”, <verse number="6" style="v" />luágu furúmieguarügü lan le aríñaguti ítara, mámaali lan lúnti líderaguniña lagǘbürigu. Láu líra mebégigüda jumáali lagúmadijan Búngiu lun jafálaruni binádu jigáburi. <verse number="7" style="v" />¡Biángua tigíbu jugúya le! Linárün proféta Isaías laríñagunbei juágu ítara.</para>
  <para style="q1">
    <verse number="8" style="v" />Jayumárurügü gürígia ja jíchiga inébesei nun, líña Búngiu,</para>
  <para style="q1">ánjein tídan janígi, mebéresentiña náu.</para>
  <para style="q1">
    <verse number="9" style="v" />Málati jájuduragun nun,</para>
  <para style="q1">ladǘga le rügǘñein jagúmadijan wügǘriña jarúfudaja.</para>
  <para style="p">
    <verse number="10" style="v" />Ábati lagúarun joun gürígia, ába laríñagun joun.</para>
  <para style="p">—Agáamba jumá, gunfaráanda jugúyame. <verse number="11" style="v" />Máma eígini le leígubei gürígia adǘgübalin lun marúman lan ligíbugiñe Búngiu, dimúrei wuríbati le laríñagubei wügǘri, ligía adǘgübalin lun marúman lan.</para>
  <para style="p">
    <verse number="12" style="v" />Ábati jayábin disípulugu lúmoun Jesúsu, ába jaríñagun lun.</para>
  <para style="p">—¿Subúditisan bun luángiu lun jafálaruni binádu jiggu wuríba lan láburujan dimúrei le baríñagubei joun fariséogu?</para>
  <para style="p">
    <verse number="13" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Furúmieguarügü nádü to máma lábunun Núguchi Búngiu le siélubei, lájulúba láu sun lílagüle. <verse number="14" style="v" />Ígira jumáña, maríjintiña ja adúndejatiña maríjintiña jáledi jagía. Áni ánjein adúndeja ában maríjinti ában maríjinti líledi, jeíguaduba biángubei jagía lídoun ában júyu.</para>
  <para style="p">
    <verse number="15" style="v" />Ábati laríñagun Pédro lun Jesúsu.</para>
  <para style="p">—Furáangugüdabeí jémpulu le woun.</para>
  <para style="p">
    <verse number="16" style="v" />Ába laríñagun Jesúsu.</para>
  <para style="p">—¿Úati gíñe gunfaráanda jumá? <verse number="17" style="v" />¿Úati gunfaráanda jumá luágu sun lan le ebélurubei lídoun iyúmaü, ába lídin lídoun urágei, lárigiñe ába láfuridun lídaangiñe úgubu? <verse number="18" style="v" />Ánjein dimúrei le áfuridubei lídaangiñe iyúmaü, tídaangiñe anígi liábin, ligíati ádügübalin wügǘri lun marúman lan ligíbugiñe Búngiu, <verse number="19" style="v" />ladǘga tídaangiñe anígi láfurida samínaü wuríbati, áfarajani, adultériu, salúfuri, íweru, iyéeni, marásualugu. <verse number="20" style="v" />Ligía buri cátei le adǘgübalin wügǘri lun marúman lan, ánjeinti leigíniwa machibúnga újabu según jagáburi juríu marúmadagüdün lumúti ligíbugiñe Búngiu.</para>
  <para style="s">Ában wǘri teréncha to afíñeruboun luágu Jesúsu</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mr 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Ába láfuridun Jesúsu ñígiñe, ába lídin lídoun buri fulásu geyégua láu fulásu le Tíro lúma Sidón. <verse number="22" style="v" />Ñíñoun ában wǘri jádaangiñetu Cananítagu aganoúti lídan fulásu ligía, ába tiábin luágun Jesúsu agúarajeina.</para>
  <para style="p">—¡Nabúreme, ladǘgawagun Davíd, gudémená bun! Níjein ában espíritu wuríbati tuágu nisáani, weíriti tasúfurirun lurúma.</para>
  <para style="p">
    <verse number="23" style="v" />Moúnabun lumútu Jesúsu. Ábati jayábin disípulugu, ába jayúmuragun lun, ába jaríñagun.</para>
  <para style="p">—Adǘgabeí le tamúriajabei búma, ladǘga nuteíntia agúarajeina wárigi.</para>
  <para style="p">
    <verse number="24" style="v" />Ába laríñagun Jesúsu.</para>
  <para style="p">—Joún rügǘñein gürígia féridijaña ja Israelítagu loúnajana Búngiu lun níderaguniña.</para>
  <para style="p">
    <verse number="25" style="v" />Ába tiábin wǘri tugúya, ába tájuduragun ligíbugiñe, ába taríñagun.</para>
  <para style="p">—¡Nabúreme, íderagua bána!</para>
  <para style="p">
    <verse number="26" style="v" />Ába laríñagun Jesúsu tun.</para>
  <para style="p">—Lúnti níderaguniña numútuniña ja juríu furúmiñe, mabuídunti lun tagídarúniwa fein jaweí isáanigu lun tíchugúniwa joun oúnli.</para>
  <para style="p">
    <verse number="27" style="v" />Ába taríñagun.</para>
  <para style="p">—Ánja, Nabúreme, láu sun líra, gayáraati jeígini oúnli ífei le áburujati lueígiñe jadábulan jabúriña.</para>
  <para style="p">
    <verse number="28" style="v" />Ábati laríñagun Jesúsu tun.</para>
  <para style="p">—Wǘri, ¡weíriti gíñe bafíñen! Susérelá le babúseerubei.</para>
  <para style="p">Lúmagiñe óra ligía, ába tareídagun tisáani.</para>
  <para style="s">Lareídaguagüdün Jesúsu sarágu sánditiña</para>
  <para style="p">
    <verse number="29" style="v" />Ába láfuridun Jesúsu ñígiñe, ába lachǘlürün lárun dúna Galiléa, lárigiñe, ába laweínrun luágun ában wǘbü, ába lañúurun ñi. <verse number="30" style="v" />Ába jayábin sarágu gürígia le ñíjin lubeí barüína jagía meíbuguntiña, maríjintiña, maríñaguntiña, danímaati jarǘna, jáma sarágu jawúyeri sánditiña. Ába jíchuguniña lubádu lugúdi Jesúsu, ába lareídaguagüdüniña. <verse number="31" style="v" />Ába laweíridun janígi gürígia láu jaríjin adímurejaña jamá já meja maríñagadibaña, areídagua ja danímaabaña arǘna, eíbuga ja meíbuguñajabaña, aríja ja maríjiñajabaña. Ába jagúmeserun adímureja weírigu luágu Jabúngiute Israelítagu.</para>
  <para style="s">Líchugun Jesúsu eígini joun gádürü mílu wügǘriña</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mr 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" />Ábati lagúarun Jesúsu joun láni disípulugu, ába laríñagun joun.</para>
  <para style="p">—Gudémetiña gürígia ja nun ladǘga ǘrüwaali wéyu jáu núma ya áni úaali ni cáta jáma lun jeígin. Mabúseeruntina noúnajaniña jábiñoun meíginga, dagá líñein falálaü jawágu ǘmada.</para>
  <para style="p">
    <verse number="33" style="v" />Ábati jaríñagun láni disípulugu lun.</para>
  <para style="p">—¿Ída lubáti wadárirun eígini joun sarágu gürígia ya lídan fulásu le ñí lumuti úa jamá aganoútiña?</para>
  <para style="p">
    <verse number="34" style="v" />Ába lálügüdüniña Jesúsu.</para>
  <para style="p">—¿Átiriñoun fein júma?</para>
  <para style="p">Ába jaríñagun.</para>
  <para style="p">—Sédü, jáma biánraü úduraü.</para>
  <para style="p">
    <verse number="35" style="v" />Ába laríñagun joun gürígia lun jañúurun múarugu, <verse number="36" style="v" />ába lanǘgünun sédü fein jáma úduraü jagía lújaburugu, ába leteíngiruni Búngiu. Ába lagúbachagunun fein, ába líchugunun joun láni disípulugu jáu sun úduraü, ába jafánreinjanun joun gürígia. <verse number="37" style="v" />Joútiña súngubei quimúle, buíngüda gíñe sédü faníñe táu to ígiraguboun. <verse number="38" style="v" />¡Gádürüñanu mílu wügǘriña eígitiña, mabájüdünga würíña jáma irájüñü! <verse number="39" style="v" />Lárigiñe, ába loúnajaniña Jesúsu gürígia águyu, ába ládinun tídoun ugúnein, ába lídin loúbawagun Mágdala.</para>
  <chapter number="16" style="c" />
  <para style="s">Jamúriajan fariséogu jáma saduséogu ában seíni le láuti miláguru</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mr 8.11-13</ref>; <ref loc="LUK 12:54-56">Lc 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ába joúdin fariséogu jáma saduséogu aríjei Jesúsu. Lun jáburugüdüni tídoun sádara, ába jaríñagun lun lun larúfudun ában seíni láuti miláguru le siélugiñeti joun, afíñe jamámuga luágu lúmagiñe lan Búngiu liábin. <verse number="2" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Rábounwéyu, ába jaríñagun. “Buídubei dan ladǘga funáti siélu.” <verse number="3" style="v" />Bináafin, ába jaríñagun. “Wuríbabei dan ugúñe ladǘga funáñu líña siélu áni jamúñounga.” ¡Biángua tigíbu jugúya le! Subúditi luáguti ligáburi dan jun, áni ibídiñeti jun luágu chülǘjali lan lidáani asálbaruni. <verse number="4" style="v" />Gürígia wuríbatiña, múaraantiña ja, amúriajatiña seíni láuti miláguru lun jafíñerun luágu áu lan anǘgübei asálbaruni joun gürígia. Wel, marúfudúnbei ámu seíni joun lueí liseíni Jonás.</para>
  <para style="p">Ába lígiruniña, ába lídin.</para>
  <para style="s">Ítara líña jarúfudajan fariséogu quei ísi</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mr 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />Dan le jájiñuragunbei disípulugu lúma Jesúsu loubáfurugun dúna, bulíei jamúti janǘgün fein. <verse number="6" style="v" />Ábati laríñagun Jesúsu joun.</para>
  <para style="p">—Toúnigigua jumátia júngua lueí jísite fariséogu jáma saduséogu.</para>
  <para style="p">
    <verse number="7" style="v" />Ába jagúmeserun disípulugu aríñaga jámagua.</para>
  <para style="p">—Ladǘgatia manǘgün wamá fein laríñagunbei ítara.</para>
  <para style="p">
    <verse number="8" style="v" />Ába lasúbudiruni Jesúsu, ába laríñagun joun.</para>
  <para style="p">—¿Ca uágu jadíjerida luágu úa tan fein júma? ¡Loúguati gíñe jafíñen! <verse number="9" style="v" />¿Úagili gunfaráanda jumá, marítagun jugúya tuágu seíngü fein to nafánreinjaboun jádan seíngü mílu wügǘriña lúma átiriñein lan faníñe táu ígiragutu? <verse number="10" style="v" />¿Bulíeiguatün funásan tuágu sédü fein to nafánreinjaboun jádan gádürü mílu wügǘriña lúma átiriñein lan faníñe táu ígiragutu? <verse number="11" style="v" />¿Ída liñági meféen jubeí luágu máma lan tuágu fein nadímureja dan le naríñagunbei jun lun joúnigiragun júngua lueí jísite fariséogu jáma saduséogu?</para>
  <para style="p">
    <verse number="12" style="v" />Ába gunfaráanda jamáni luágu máma lan luágu tísitena fein laríñaga joun, lueí lan arúfudajaní le jáni fariséogu jáma saduséogu lawéridiraña.</para>
  <para style="s">Laríñaguni Pédro luágu Jesúsu lan Crístubei</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mr 8.27-30</ref>; <ref loc="LUK 9:18-21">Lc 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Dan le lachǘlürün Jesúsu ubúrugu Cesaréa le Filípo ába lálügüdüniña láni disípulugu.</para>
  <para style="p">—¿Cátanasan lídan jarítagun gürígia, áu le Wügǘri Garaǘwarügüti?</para>
  <para style="p">
    <verse number="14" style="v" />Ába jaríñagun.</para>
  <para style="p">—Añájein aríñagutiña luágu Juan lan lé meja abásteragüdajabei amǘrü, jíbiri aríñaga luágu Elías ban, añájeingua aríñagutiña luágu Jeremías ban o ámu lan proféta.</para>
  <para style="p">
    <verse number="15" style="v" />Ábati laríñagun joun.</para>
  <para style="p">—Ánti jugúya, ¿cátanati lídan jarítagun?</para>
  <para style="p">
    <verse number="16" style="v" />Ába laríñagun Simón Pédro lun.</para>
  <para style="p">—Crístu le Liraǘ Búngiu le wínwanbei amǘrü, le ñǘbinbei asálbaraña gürígia uboúagu.</para>
  <para style="p">
    <verse number="17" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Fuleíseiwatibu Simón, liraǘ Jonás, ladǘga máma lasúbudirágüdün ni ába gürígia cátei le bun, lasúbudiragüdün Núguchi Búngiu le siélubei bun. <verse number="18" style="v" />Naríñajare bun luágu Pédro lan amǘrü, líla íri ligía, “dǘbü”, luáguba ébuu le nábunaguoun nilígilisin, áni ni íbini oúweni mabáfubei tuágu. <verse number="19" style="v" />Níchugubei ligélen arúeijani le lánina siélu bun, le cátei le uáguti baríñaga luágu moun lan jadǘgüni afíñetiña, ligía gíñe uágubei laríñaga Búngiu luágu siñá lan ladügǘniwa, le cátei le uáguti baríñaga luágu gayára lan ladügǘniwa, ligía gíñe le uágubei laríñaga Búngiu luágu gayára lan ladügǘniwa.</para>
  <para style="p">
    <verse number="20" style="v" />Ábati laríñagun Jesúsu joun láni disípulugu lun maríñagun jamá ni ca un luágu ligía lan Crístubei.</para>
  <para style="s">Ladímurejan Jesúsu luágu loúnwen</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mr 8.31–9.1</ref>; <ref loc="LUK 9:22-27">Lc 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Lúmagiñe dan ligía, ába lagúmeserun Jesúsu aríñaga joun láni disípulugu furáangu luágu lúnti lan lídin Jerusalén, luágu gíñe jasúfuriragüdübei lan wügǘriña weírigutiña lídan jafíñen juríu, jáma jábutigu jafádirigun juríu, jáma arúfudajatiña lilúrudun Moisés. Aríñagati joun luágu láfarúba lan jilágubei, áni lásaaruba lan luágu lǘrüwan wéyu. <verse number="22" style="v" />Ába ladíñurun Pédro láu Jesúsu ñígiñe murúsun, ába laríñagun lun táu sun lanígi.</para>
  <para style="p">—¡Mabúseeraleí Búngiu líra, Nabúreme! ¡Siñáti lasúseredun cátei le bun!</para>
  <para style="p">
    <verse number="23" style="v" />Ába lagáraragun Jesúsu, ába laríñagun lun Pédro.</para>
  <para style="p">—¡Dísebá nueí, Máfia! Babúseerúña beréderuni ladügǘniwa lugúndan Búngiu. Masáminaruntibu quei Búngiu, basáminarun quei wügǘri.</para>
  <para style="p">
    <verse number="24" style="v" />Ábati laríñagun Jesúsu joun láni disípulugu.</para>
  <para style="p">—Le busénti lafálarunina, bulíeileí cáteiñein lan, awándaleí sun luwúyeri asúfuriruni le lúnbei liábin lun nueígiñe queísi lanǘgüni ában wügǘri lugúruwan, falálana. <verse number="25" style="v" />Ladǘga le abúseeruti leséfuragun lúngua ya uboúagu leféridirubei ibágari le magúmuchaditi, ánjein le ánjabei leféridiruni libágari ya uboúagu nueígiñe, libíjubei ibágari le magúmuchaditi siélu. <verse number="26" style="v" />¿Cági ju lan lun gürígia lagáñeiruni sun le lánina uboú le, leféridireime lubára siélu? Úati ni cáta lánina uboú le áuti gayára lan lagáñijan gürígia ubáraü siélu. <verse number="27" style="v" />Nagíribuduba, áu le Wügǘri Garaǘwarügüti, úara jáma náni ánjeligu, niábinba láu uweíriguni le meme láni Núguchi. Ábameti nafáyeiruniña gürígia quei ligáburi le adǘga jamáalibei. <verse number="28" style="v" />Ninárün jáu luágu añájein lan jádaangiñe ja yábaña guetó, moúnwenbaña daríme jaríjini liábin narúeijan, áu le Wügǘri Garaǘwarügüti.</para>
  <chapter number="17" style="c" />
  <para style="s">Lámuñedagun larijín Jesúsu</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mr 9.2-13</ref>; <ref loc="LUK 9:28-36">Lc 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Sísi wéyu lárigiñe, ába lanǘgüniña Jesúsu Pédro, Jacóbo, lúma Juan le lamúlen Jacóbo, ába lídin jáu luágu ában wǘbü íñuti, jagía rügǘñanu ñi. <verse number="2" style="v" />Ába lámuñedagun larijín Jesúsu ñi jagíbugiñe, ába lámiridun ligíbu quei wéyu, ába tájarudun lanáangun quei larúgounga. <verse number="3" style="v" />Sódini ába jaríjini Moisés lúma Elías (já meja abágaridubaña lídan dan le sügǘjalibei) ayánuja lúma Jesúsu. <verse number="4" style="v" />Ába laríñagun Pédro lun Jesúsu.</para>
  <para style="p">—Nabúreme, ¡lídan dan awánja lan ya! Ánjabu busén, adǘga wagíame ǘrüwa dibásein ya, ában bun, ában lun Moisés, ában lun Elías.</para>
  <para style="p">
    <verse number="5" style="v" />Dan niján lan Pédro adímureja, ába liábin ában juánriñu miríti, ába loúburaguniña, ába lagaambúniwa ában umálali lídaangiñe juánriñu ligía le aríñagubei.</para>
  <para style="p">—Niján niraǘ le jínsiñebei nun, le aúbei oúnwenbun lan nugúndan, adǘga jumeí le lubeíbei.</para>
  <para style="p">
    <verse number="6" style="v" />Dan jagáambuni disípulugu, ába jabúluchagun láu jagíbu múarugu le luweírin janúfude. <verse number="7" style="v" />Ába liábin Jesúsu jawágun, ába lagúrurun jawágu, ába laríñagun joun.</para>
  <para style="p">—Sarájuma, manúfudeda jumá.</para>
  <para style="p">
    <verse number="8" style="v" />Dan le jaríjinbei, maríjinjaña ámu lueídügü Jesúsu.</para>
  <para style="p">
    <verse number="9" style="v" />Dan le arárireina jamáni wǘbü, ába laríñagun Jesúsu joun.</para>
  <para style="p">—Mabájudagua jumeítia cátei le aríja jumáalibei lun ni ában daríme saráadina, áu le Wügǘri Garaǘwarügüti, lídaangiñe oúweni lúnya nabágaridun.</para>
  <para style="p">
    <verse number="10" style="v" />Ábati jaríñagun disípulugu lun Jesúsu.</para>
  <para style="p">—Guetó subúdi wamáali luágu amǘrü lan Crístubei. Quei ítara líña lubeí, ¿cáti uágu jaríñaga arúfudajatiña lilúrudun Moisés luágu lúnti lan liábin Elías lubáragiñe liábin Crístu?</para>
  <para style="p">
    <verse number="11" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Inárüni luágu liábinba lan Elías, ábame líchugun sun cátei lídoun lubúdubu, <verse number="12" style="v" />áni naríñajare jun luágu ñǘbinjali lan Elías, masúbudirun jamúti gürígia, adǘgarügü jamúti sun le jabúseerubei láu. Ítara lúba gíñe jasúfuriragüdünina, áu le Wügǘri Garaǘwarügüti.</para>
  <para style="p">
    <verse number="13" style="v" />Ábati jasúbudiruni disípulugu luágu Juan lan lé meja abásteragüdajabei, ligía lan Elíasbei le uágubei ladímureja Jesúsu.</para>
  <para style="s">Lareídaguagüdün Jesúsu ában irájü goúwejaditi</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mr 9.14-29</ref>; <ref loc="LUK 9:37-43">Lc 9.37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Dan le jachǘlürünbei le ñíjin jabeí gürígia, ába liábin ában wügǘri lúmoun Jesúsu, ába lájuduragun ligíbugiñe, ába laríñagun lun.</para>
  <para style="p">
    <verse number="15" style="v" />—Nabúreme, gudémelá nisáani bun, goúwejaditi, weírititi lasúfurirun, níjein dan jeíguati wáturugun, níjein dan dúnarugun. <verse number="16" style="v" />Barǘ numuti ñájoun joun báni disípulugu, siñá jamuti areídaguagüda.</para>
  <para style="p">
    <verse number="17" style="v" />Ába loúnabun Jesúsu.</para>
  <para style="p">—¡Gürígia mafíñeraditiña, gürígia wuríbatiña! ¿Átiribeísan dan lun neréderuni júma lubá gayára lan jafíñerun nuágu? ¿Ídame lagúmucha mafíñeni le jídaanbei? Barǘjumei irájü ligía ñájoun.</para>
  <para style="p">
    <verse number="18" style="v" />Ábati ladeínjan Jesúsu lun espíritu wuríbati ligía, ába láfuridagüdüni lídaangiñe lúmagiñe óra ligía, ába lareídagun irájü le.</para>
  <para style="p">
    <verse number="19" style="v" />Lárigiñe, ába jadímurejan disípulugu lúma Jesúsu jábugua, ába jálügüdüni.</para>
  <para style="p">—¿Cásan uágu siñá wabalin espíritu wuríbati ligía aságara?</para>
  <para style="p">
    <verse number="20" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Ladǘga liloúguan jafíñen. Ninárün jáu luágu ánjein lan ibíja jubeí fe íbini ñǘraüraü lan quei ában tágu mostása, jaríñaguba lun wǘbü le. “Gidába yágiñe, beíba lídoun ámu fulásu”, ábame lagídarun wǘbü ligía. Úabei ni cáta jásiñerun ánjein ibíja jubeí fe le tímatimaati. <verse number="21" style="v" />Ánjeinti jíbe espíritugu ja, láu rügǘñein ayúmuraguni lun Búngiu lúma ayúnaruni gayára lan jaságarúniwa.</para>
  <para style="s">Ladímurejaanya Jesúsu luágu loúnwen</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mr 9.30-32</ref>; <ref loc="LUK 9:43-45">Lc 9.43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />Dan le eíbugeina jamá úara loúbawagu Galiléa, ába laríñagun Jesúsu joun luágu ledéregerúaba lan, ligía le Wügǘri Garaǘwarügüti, jájaburugun wügǘriña wuríbatiña, <verse number="23" style="v" />ábame jáfaruni jilágubei, áni lásaaruba lan lídaangiñe oúweni luágu lǘrüwan wéyu. Ába jírudagun sarágu dan le jagáambuni cátei le.</para>
  <para style="s">Lafáyeirúniwa tiseínsuna témpulu</para>
  <para style="p">
    <verse number="24" style="v" />Dan lachǘlürün Jesúsu jáma láni disípulugu Capernaúm, ába joúdin ja agúburajabalin tiseínsuna témpulu to Jerusalénboun lúmoun Pédro, ába jaríñagun lun.</para>
  <para style="p">—¿Mafáyeijantisan jumáesturun tiseínsuna témpulu?</para>
  <para style="p">
    <verse number="25" style="v" />Ába loúnabun Pédro, ába laríñagun lun.</para>
  <para style="p">—Afáyeijati.</para>
  <para style="p">Dánti lebélurun Pédro múnadoun, ába lálügüdüni Jesúsu Pédro lubáragiñe gayára lan ladímurejan.</para>
  <para style="p">—¿Ída líña baríjin lun líra, Simón? ¿Cátaña jagúburajabaña urúeigu ja lánina uboú le, jásan lílana fulásu ódi ja teréncha?</para>
  <para style="p">
    <verse number="26" style="v" />Ába laríñagun Pédro lun.</para>
  <para style="p">—Ja teréncha.</para>
  <para style="p">Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Játi lílana fulásu jáledi moún lumuti lubeíti jafáyeijan, áu le Liraǘ Búngiu, moún lumuti nafáyeijan tiseínsuna lúban Núguchi. <verse number="27" style="v" />Lun magáñidagüdün wamá ni ában, beíba, ábame bachǘrunun bürǘnjüre dúnarugun, ábame badígini furúmiñeti úduraü le eígiti bun. Badáriruba ában seínsu liyúmulugu úduraü ligía, buídurügübei lun bafáyeijan wawoúgua láu, ábame bafáyeiruni.</para>
  <chapter number="18" style="c" />
  <para style="s">¿Cáteisan weírigutimaabei lídan larúeijan Búngiu?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mr 9.33-37</ref>; <ref loc="LUK 9:46-48">Lc 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Lídan dan ligía, ába jayábin disípulugu lúmoun Jesúsu, ába jálügüdüni.</para>
  <para style="p">—¿Cáteisan weírigutimaabei lídan larúeijan Búngiu?</para>
  <para style="p">
    <verse number="2" style="v" />Ába lanǘgün Jesúsu ában irájü, ába líchuguni jamídan jámagua, <verse number="3" style="v" />ába laríñagun.</para>
  <para style="p">—Ninárün jáu luágu ánjaün lan mayábin lun jítaradun quei irájüñü, mebélubadün lídoun larúeijan Búngiu. <verse number="4" style="v" />Ítara líña lubeíti, le ñǘraüti lanáangun lúngua, ñǘbin ligía lun ítarabei lan quei ában irájü, ligía weírigutimaabei lídan arúeijani le lánina siélu. <verse number="5" style="v" />Gürígia gíñe le erésibiruti ában irájü lídan níri resíbi lumútina gíñe.</para>
  <para style="s">Luríban lafígoungüdǘniwa ában gürígia</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mr 9.42-48</ref>; <ref loc="LUK 17:1-2">Lc 17.1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" />‘Furúmieguarügü le afígoungüdüti ában jádaangiñe ja isérigiñabaña lídan jafíñen nuágu, buítimaati jamúga lun lun lagurúniwa baránajoún láu ában oúnwenbun dǘbü le amúligülei güráñu luágu ligíina sügǘ láu ladǘgüni cátei líra. <verse number="7" style="v" />¡Wuríbati lun uboú, níjein lán buri cátei le afígoungüdübaliña gürígia! Súnwandan ñíbei lan, áni ¡fugiábu le wügǘri le lébunabei!</para>
  <para style="p">
    <verse number="8" style="v" />‘Ligía ánjein lubeí lafígoungüdǘbadibu lubeí bújabu o bugúdi lan, dürǘbei, fíbei díse buáriua, buítimaati lun bebélurun siélun májabuga o magúdiga, sügǘ láu badarún láu biángubei bújabu lúma biángubei bugúdi máfiougatin le ñí lubei wátu le méñeguchadibei. <verse number="9" style="v" />Ánjein bágu lubeí afígoungüdǘbadibu, sagábei, fíbei díse buáriua, buítimaati lun bebélurun siélun máguga sügǘ láu badarún láu biángubei bágu máfiougatin.</para>
  <para style="s">Jémpulu tuáguti mudún to eféridiruboun</para>
  <para style="r">(<ref loc="LUK 15:3-7">Lc 15.3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" />‘Manǘga jumá ni ában jádaangiñe ja ǘnabugububaña ja quei ni cáta. Naríñajare jun luágu ligíbugiñeñanu lan Núguchi Búngiu le siélubei ánjeligu ja aríjubaña jáu afíñetiña ja súnwandan. <verse number="11" style="v" />Ladǘga asálbarei le féridijalibei yebe niábin, áu le Wügǘri Garaǘwarügüti.</para>
  <para style="p">
    <verse number="12" style="v" />‘¿Ída líña jaríjin lun? Ánjein añájein lubeí san mudún lúma ában wügǘri, teféridira ában jádaangiñe, ¿ma lígirubaña jíbiri luágu wǘbü, ábame lídin áluajoun to ayúridaguboun? <verse number="13" style="v" />Ánjounti ladárira, choúruti luágu gúndaabei lan táu sügǘ jáu ja mayúridagunbaña. <verse number="14" style="v" />Ítara líña giñéti, mabúseerunti Júguchi Búngiu le siélubei lun leféridirun ni ában jádaangiñe ǘnabugutiña ja.</para>
  <para style="s">Ligáburi ferúdunawa jamá idújeñu lueígiñe Jesucrístu</para>
  <para style="r">(<ref loc="LUK 17:3">Lc 17.3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />‘Ánjein adǘga bidúje ában wuríbani bun, badímureja lúma jábuguarügü, ábame basúbudiragüdüni lidúnrun lun. Ánjein adǘga gásu báu, gamádaguayáadün. <verse number="16" style="v" />Ánjein madǘgün gásu báu, ábame banǘgün ában o bián gürígia jánwoun lun sun lan le aríñawagúti, añájein jamámuga ámu geféentiña luágu. <verse number="17" style="v" />Ánjein madǘgün gásu jáu, ábame baríñaguni lun jadámurin afíñetiña, ánjein madǘgün gásu láu adámurini, ábame banǘgüni quei ában mafíñeti luágu Búngiu o quei lan ában agúburajati liseínsuna gumádi, gayára lámuga lasáansiruni luríban ligáburi.</para>
  <para style="p">
    <verse number="18" style="v" />‘Ninárün jáu luágu le lan cátei le uáguti jaríñaga jugúya disípulugu luágu moun lan jadǘgüni afíñetiña, ligía gíñe uágubei laríñaga Búngiu luágu siñá lan ladügǘniwa, le cátei le uágubei jaríñaga luágu gayára lan ladügǘniwa, ligía gíñe le uágubei laríñaga Búngiu luágu gayára lan ladügǘniwa.</para>
  <para style="p">
    <verse number="19" style="v" />‘Naríñajare gíñe jun luágu ánjaña lan úarada biáma jídaangiñe ya uboúagu lun jamúriajan ában cátei lúma Búngiu le siélubei, líchugubei jun, <verse number="20" style="v" />ladǘga le ñí jamuti biáma o ǘrüwa oúndaragu lídan níri, anájein ñi jamídaangua.</para>
  <para style="p">
    <verse number="21" style="v" />Ába layárafadun Pédro lun Jesúsu, ába laríñagun lun.</para>
  <para style="p">—Nabúreme, ¿átiribeísan weíyaasu ladǘgün nibíri ában wuríbani nun lun ferúduna méme náani? Darí sédü weíyaasu?</para>
  <para style="p">
    <verse number="22" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Maríñaguntina bun luágu darí lan sédü weíyaasu lúnti ferúduna báani, darí ǘrüwa-wein-díisi weíyaasu sédü.</para>
  <para style="s">Jémpulu luáguti músu le májabei ferúduna lan</para>
  <para style="p">
    <verse number="23" style="v" />‘Ligía ítara líña lubeí arúeijani le lánina siélu quei ában urúei le ñǘbinbei lun laráansejan luágu seínsu jáma lumúsuniña. <verse number="24" style="v" />Lagúmesera adǘgei, ába janǘgün ában le adúweirubalin sarágu míñun fiádürü, <verse number="25" style="v" />quei maseínsun lan lun lafáyeijan, ába laríñagun urúei lun lalúgurúniwa idámunime táu sun lúmari, lirájüñü, lúma sun le lúmabei lun lafáyeiruni ladúweijan. <verse number="26" style="v" />Ába lájuduragun músu ligía ligíbugiñe urúei, ába layúmuragun lun ítara. “Nabúreme, gagúraasunbá nubá, nafáyeirubei sun le nadúweirubei bun.” <verse number="27" style="v" />Ába lagúdemedagun lun urúei, ába ferúduna láani ladúweiruni, ába lígiragüdüni. <verse number="28" style="v" />Quei láfuridun músu ligía ñígiñe, ítara ladúnragun lúma ában músu líledi le adúweirubalin átiri fiádürü. Ába lárügüdüni lueígiñe ligíina, ába lagúmeserun achócurei, ába laríñagun lun. “Fáyeibeí le badúweirubalina.” <verse number="29" style="v" />Ábati lájuduragun ligíbugiñe, ába layúmuragun lun ítara. “Gagúraasunbá nubá, nafáyeirubadibu.” <verse number="30" style="v" />Májati le ában, ñǘdünrügü ligía ába ládaruni furísunrugun darí lafáyeiruni ladúweijan. <verse number="31" style="v" />Dan le jaríjinbaalin ja jíbiri músu cátei le, ába lagáridun joun sarágu, ába joúdin, ába jabájüdaguni lun urúei. <verse number="32" style="v" />Ába loúnajan urúei oúgei, ába laríñagun lun. “¡Músu wuríbati! Ferúduna numúti sun badúweijan ladǘga bayúmuragun nun. <verse number="33" style="v" />Lúnti yebe gíñe gudéme lan boúba bun quei bagúdemedun nun.” <verse number="34" style="v" />Ába lagáñidun urúei sarágu, ába líchugun dimúrei lun jasúfuriragüdüni daríme lafáyeiruni sun ladúweijan.</para>
  <para style="p">
    <verse number="35" style="v" />Ába lásurun Jesúsu aríñageina.</para>
  <para style="p">—Ítara lúba gíñe ladǘga Núguchi Búngiu le siélubei jun ánjaün úa ferúduna láani cáda ában jídaangiñe libíri tídaangiñe lanígi.</para>
  <chapter number="19" style="c" />
  <para style="s">Larúfudajan Jesúsu libǘgürü ígiraguni</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mr 10.1-12</ref>; <ref loc="LUK 16:18">Lc 16.18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Lárigiñe laríñaguni Jesúsu sun cátei le, ába lídin Galiléagiñe lun loúbawagun Judéa le lueígiñebei oúbaü le ñígiñe lubeí laboúcha wéyu libíti Jordán. <verse number="2" style="v" />Sarágu jáña gürígia afálaruti, ába lareídaguagüdüniña sánditiña ñi.</para>
  <para style="p">
    <verse number="3" style="v" />Ábati jayábin fiú fariséogu lúmoun Jesúsu áluga jáburugüdüni tídoun sádara, ába jálügüdüni.</para>
  <para style="p">—¿Según barítagun, gayáraatísan lígirunun gürígia lúmari lueígiñe furúmieguarügü cátei?</para>
  <para style="p">
    <verse number="4" style="v" />Ába loúnabun Jesúsu.</para>
  <para style="p">—¿Malíijangidün tídan Lerérun Búngiu luágu lúmagiñe lan furúmiñeti dan, dan le ladǘgünbaliña Búngiu gürígia, adǘga lumúti wügǘri, adǘga wǘri? <verse number="5" style="v" />Aríñagati gíñe. “Ligía lígirubei lubeí wügǘri lúguchi túma lúguchu lun laganoúniwa túma lúmari, ábame jeréderun quei ábanrügü.” <verse number="6" style="v" />Mámaaña lubeíti biáma, ábanrügaaña. Ligía moún lubei lafánreinraguni wügǘri le ladúnraguagüdübei Búngiu.</para>
  <para style="p">
    <verse number="7" style="v" />Ábati jálügüdüni.</para>
  <para style="p">—¿Cáti uágu laríñaga lilúrudun Moisés lun lan tíchugúniwa gárada lánina ígiraguni tun wǘri lun tigirún?</para>
  <para style="p">
    <verse number="8" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Ladǘga tidére janígi lánjarunbei Búngiu lun jígiragun jáma júmarigu, máma líña meja furúmiñe. <verse number="9" style="v" />Naríñajare jun luágu furúmieguarügü lan le ígirutu lúmari ába lagámaridun ámu, ladǘgüña adultériu, mámarügaali ligía ladǘga tagámaridun ligíbuagun, le gíñe agámariduti wǘri to ígiraguaaru, ladǘgüña gíñe adultériu.</para>
  <para style="p">
    <verse number="10" style="v" />Ábati jaríñagun láni disípulugu lun.</para>
  <para style="p">—Ánjein ítara líña lubeí luáguti wügǘri túma lúmari, buítimaati lubeí lun magámaridun jamá gürígia.</para>
  <para style="p">
    <verse number="11" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Másutiña gayára jabágaridun mámariga, ja rügǘñanu únbaña rújali lan Búngiu ubáfu. <verse number="12" style="v" />Ámuñegueinarügüti lébuna magámaridun jamá wügǘriña, añájein, ítaragubeíñanu lúmagiñe jagǘriajoún, jíbiri, adügǘwarügüti joun, jíbiri, reídeitiña magámaridunga lun jedéregeragun joúngua le gumúti lun jesériwidun lun Búngiu. Le gabáfubei lun magámaridun lan, magámaridalá.</para>
  <para style="s">Labíniruniña Jesúsu irájüñü</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mr 10.13-16</ref>; <ref loc="LUK 18:15-17">Lc 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Ába janügǘniwa irájüñü lun Jesúsu lun líchuguni lújabu jawágu lúma lun layúmuragun lun Búngiu jawágu, ába jagúmeserun disípulugu adeínja joun ja anáajabaliña. <verse number="14" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Ígira jumá lun jayábin irájüñü nun, mamájara jumá, ladǘga ja jarúmabaña afíñe quei irájüñü, jagía lílana arúeijani le lánina siélu.</para>
  <para style="p">
    <verse number="15" style="v" />Ába líchuguni lújabu jawágu irájüñü jagía, lárigiñe, ába lídin lídaangiñe fulásu ligía.</para>
  <para style="s">Ladímurejan ában wügǘri ñǘraügili lúma Jesúsu</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mr 10.17-31</ref>; <ref loc="LUK 18:18-30">Lc 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />Ába lídin ában wügǘri ñǘraügili aríjei Jesúsu, ába laríñagun lun.</para>
  <para style="p">—Maésturu buíti, ¿cásan cátei buíti lúnbei nadǘgüni lun nibíjini ibágari le magúmuchaditi?</para>
  <para style="p">
    <verse number="17" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—¿Ca uágu baríñaga nun “buíti”? Ában rügǘñein buíti, Búngiu. Ánjein busén bubei bibíjini ibágari magúmuchaditi, gúnfulibá lúma gumádi.</para>
  <para style="p">
    <verse number="18" style="v" />Ába laríñagun wügǘri ligía lun.</para>
  <para style="p">—¿Cáteigi buri?</para>
  <para style="p">Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Máfarajabá, magámaridabá wǘri gámaritu, míwerujabá, madímurejabá iyéeni luágu ni ában, <verse number="19" style="v" />inébe jamá bagǘbürigu bun, jínsiñe jagíame gürígia bíledigu bun quei bínsiñegua búngua.</para>
  <para style="p">
    <verse number="20" style="v" />Ába laríñagun lun.</para>
  <para style="p">—Gúnfuli numúti sun le lúmagiñe ñǘraügidina, ¿cági ámu nemégeirubei?</para>
  <para style="p">
    <verse number="21" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Ánjein busén bubei buídu ban le gumúti, alúgurabeí sun le búmabei, ábame bíchuguni lebégi joun gudémetiña, ábame bibíjin irísini siélu, ábameti biábin, ábame bafálarunina.</para>
  <para style="p">
    <verse number="22" style="v" />Dan lagáambunbalin wügǘri ligía cátei le, májati, ladǘga weíribalin Jesúsu cába lan ladǘgti lirísin, ába lídin láu íruni.</para>
  <para style="p">
    <verse number="23" style="v" />Ábati laríñagun Jesúsu joun láni disípulugu.</para>
  <para style="p">—Ninárün jáu luágu jénreengu lan lun lebélurun ában rísiti lídoun arúeijani le lánina siélu. <verse number="24" style="v" />Aríñagaya numúti jun luágu ménreenguntima lan lásügürün ában caméyu lídaangiñe lujúyun ában agúsa, sügǘ láu lebélurun ában rísiti lídoun arúeijani le lánina siélu.</para>
  <para style="p">
    <verse number="25" style="v" />Dan jagáambuni disípulugu cátei le, ába laweíridun jan-balin Jesúsu cába lan ladǘgigi sarágu, ába jálügüdagun jámagua.</para>
  <para style="p">—¿Cáteiti gayáraabei lasálbarun?</para>
  <para style="p">
    <verse number="26" style="v" />Ába laríaguniña Jesúsu, ába laríñagun joun.</para>
  <para style="p">—Siñáti jasálbaragun gürígia joúngua, ánjein Búngiu, gayára lumúti sun cátei adǘga.</para>
  <para style="p">
    <verse number="27" style="v" />Ábati laríñagun Pédro lun.</para>
  <para style="p">—Nabúreme, wagía, ígira wamáali sun lé meja wámabei lun wafálarunibu. ¿Cábasanti wabíja?</para>
  <para style="p">
    <verse number="28" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Ninárün jáu luágu lídan lánme dan ligía dánme iséri lan sun cátei, dánme le nañúurun, áu le Wügǘri Garaǘwarügüti luágu nála yágüta siélu lun narúeijan láu sun nuweírigun, jugúya le afálarubalina jañúuruba gíñe luágu dúusu jalaǘ lun jagúseragüdüniña dúusugubei láni Israél türíbu. <verse number="29" style="v" />Súnti ja ígiraañábaña jában, o jamúlenu, o játunu, o jagǘbürigu, o jasáanigu, o jamúan, nuágu, jerésibiruba san weíyaasu lánwoun, resíbi jameíme ibágari magúmuchaditi. <verse number="30" style="v" />Áni sarágu jáña ja furúmiñetiñábaña guetó, jagíaba agúmujoúni, sarágu ja agúmujoúnibaña guetó, jagíaba furúmiñe.</para>
  <chapter number="20" style="c" />
  <para style="s">Jémpulu jawáguti ñadágimeintiña</para>
  <para style="p">
    <verse number="1" style="v" />Ába laríñagun Jesúsu.</para>
  <para style="p">—Ítara líña arúeijani le lánina siélu quei ában labúreme ichári le áfuridubei bináafingua áluaja ñadágimeintiña lun talúbajoún linádirigu. <verse number="2" style="v" />Ába ladǘgün darádu jáma ñadágimeintiña lun líchugun fiádürü joun luágu wéyu, ába loúnajaniña ñadágimein lichárirugu. <verse number="3" style="v" />Lárigiñe, ábaya láfuridun queí buri ladaǘnrün néfu bináafin, ábaya ladárirun ámu wügǘriña mafísiutetiña, mágidirugu. <verse number="4" style="v" />Ába laríñagun joun. “Jeíba gíñe ñadágimein nichárirugu, ábame nafáyeiruni lebégi juwádigimari jun.” Ába joúdin. <verse number="5" style="v" />Ábaya láfuridun amídirugu, furí ligía ladaǘnrün ǘrüwa rábounwéyu, ligía méme ladǘga. <verse number="6" style="v" />Queí buri ladaǘnrün seíngü rábounwéyu, ábaya lídin mágidirugu, ábaya ladárirun wügǘriña mafísiutetiña ñi, ába laríñagun joun. “¿Cásan uágu yá jubei sun wéyu mawádigimariga?” <verse number="7" style="v" />Ába jaríñagun lun. “Úagili ni ában álugutiwa.” Ába laríñagun joun. “Jeíba gíñe ñadágimein nichárirugu, ábame nafáyeiruni lebégi juwádigimari jun.” <verse number="8" style="v" />Dan le lagúñedunbei, ába laríñagun labúreme ichári lun jábuti ñadágimeintiña. “Wába joun ñadágimeintiña, fáyei bámugaña, bagúmeserame jámagiñe ja atátirubaña agúmujoúni, bagúmuchame jáma ja atátirubaña furúmiñe.” <verse number="9" style="v" />Ábati jayábin ja atátirubaña ñadágimein queí buri ladaǘnrün seíngü rábounwéyu, ába jibíjin fiádürü cáda ában. <verse number="10" style="v" />Lárigiñe, dan le lachǘlürün jadáani ja atátirubaña furúmiñe, ába jarítagun luágu gíbetimaabei lan jabíjin. Ába gíñe jabíjin fiádürü cáda ában. <verse number="11" style="v" />Dan le jerésibiruni jaseínsun, ába magúndan jamá lúma labúreme ichári, <verse number="12" style="v" />ába jaríñagun. “Ja ñǘbinbaña agúmujoúni, ában rügǘñein óra jawádigimari, ában lábu bafáyeiruniña quei wagía, wagía le awándubalin wadágimanu lúma lísüga sun wéyu.” <verse number="13" style="v" />Ába loúnabun labúreme ichári, ába laríñagun lun ában jádaangiñe. “Numáda, máma nadǘgüña ni murúsun maríchaü jun. ¿Ma funági luágu ában fiádürü jadǘga darádu núma? <verse number="14" style="v" />Barǘjumei jiseínsun, jeíba. Nafáyeiruñanu ja atátirubaña agúmujoúni quei nafáyeirunün ladǘga ítara líña lan nabúseerun. <verse number="15" style="v" />¿Maríchatina funági lun nadǘgüni le nabúseerun láu niseínsun? ¿Ódi gimúgatün ladǘga nubuídun?” <verse number="16" style="v" />Ítara líña lubeíti, sarágu jáña ja agúmujoúnibaña guetó, jagíaba furúmiñetiña, sarágu jáña gíñe ja furúmiñetiñábaña guetó, jagíaba agúmujoúni. Ladǘga sarágu jáña agúarútiña áni míbetiña anúadirútiña.</para>
  <para style="s">Ladímurejaanya Jesúsu luágu loúnwen</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mr 10.32-34</ref>; <ref loc="LUK 18:31-34">Lc 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" />Dan le niján lan Jesúsu luágu ǘma lun Jerusaléoun, ába ladíñurun jáu láni dúusu disípulugu jaweí ja jíbiri gürígia ja luágubaña ǘma úara jáma, ába laríñagun joun.</para>
  <para style="p">
    <verse number="18" style="v" />—Quei lubeí jaríjini, aweínreina wáña Jerusaléoun le ñíba lubeí nedéregerúa, áu le Wügǘri Garaǘwarügüti, joun jábutigu jafádirigun juríu lúma joun arúfudajatiña lilúrudun Moisés, ja lúnbaña jasíadirunína lun noúnwen. <verse number="19" style="v" />Ábame jedéregerunina joun ja mámabaña juríu lun jéjerajan náu, áfara jamáname, ábame jádaragunina luágu gurúwa, áni násaaruba lídaangiñe oúweni luágu lǘrüwan wéyu.</para>
  <para style="s">Le tamúriajabei jáguchu Jacóbo láu Juan lúma Jesúsu</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mr 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Ábati tiábin jáguchu Jacóbo láu Juan, ja lisáanigu Zebedéo, lúmoun Jesúsu jáu tisáanigu, ába tájuduragun lun tamúriajan ában fuleísei lúma. <verse number="21" style="v" />Ába laríñagun tun.</para>
  <para style="p">—¿Ca babúseerubei?</para>
  <para style="p">Ába taríñagun lun.</para>
  <para style="p">—Aríñagabá lun jañúurun bián nisáanigu ja, ában lueígiñe boúnwenren, ában lueígiñe bubaǘna yágüta lídan barúeijan.</para>
  <para style="p">
    <verse number="22" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Ibídiñeti jun ca lan jamúriajabei. ¿Gayáraati jawánduni luweírin igárigu le lúnbei nawánduni, gayára ligíame júaradun núma lídan nasúfurirun?</para>
  <para style="p">Ába jaríñagun.</para>
  <para style="p">—Gayára wabeí.</para>
  <para style="p">
    <verse number="23" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Inárüni, lúnti jawánduni igárigu le lúnbei nawánduni, úara jugúyame núma lídan nasúfurirun, ánjeinti lun jañúurun lueígiñe noúnwenren lúma lueígiñe nubaǘna, máma áu lúnbei níchuguni, líchugúaba joun ja ubáabaña laráanserei Búngiu.</para>
  <para style="p">
    <verse number="24" style="v" />Dan le jagáambunbalin jíbiri díisi disípulugu cátei le, ába jagáñidun jáma bián amúlenugu jagía. <verse number="25" style="v" />Ába lagúarun Jesúsu joun, ába laríñagun joun.</para>
  <para style="p">—Queísi jasúbudiruni, ja agúmadijabaña jádan ja mámabaña juríu arúfudaguatiña joúngua camá jamuga jabúriña lílana fulásu ligía, játi weínamubaña jádan, arúfuda jamúti jabáfu. <verse number="26" style="v" />Ánjein jídan, máma lúba, le abúseeruti lun weíri lan jídan, lúnti lesériwiduniña jíbiri. <verse number="27" style="v" />Furúmieguarügü jídaangiñe le abúseeruti lun ligíaba lan furúmiñeti, lúnti idámuni lan joun jíbiri <verse number="28" style="v" />ítara quei máma lan niábiña, áu le Wügǘri Garaǘwarügüti, lun nesériwidúniwa, niábiña lun nesériwidun lúma lun níchuguni nibágari lebégime jasálbarun sarágu.</para>
  <para style="s">Lareídaguagüdün Jesúsu bián maríjintiña</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mr 10.46-52</ref>; <ref loc="LUK 18:35-43">Lc 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" />Dan le áfurideina jabeí Jesúsu jáma láni disípulugu Jericógiñe, sarágu jáña gürígia afálaruti Jesúsu. <verse number="30" style="v" />Ñíñanu bián maríjintiña ñun láru ǘma, dan le jagáambun luágu Jesúsu lan le ásügürübei, ába jagúaragun.</para>
  <para style="p">—¡Wabúreme, ladǘgawagun Davíd, gudéme wamá bun!</para>
  <para style="p">
    <verse number="31" style="v" />Ába jadeínjan gürígia joun lun jámanichun, ligíatima jagúaragun.</para>
  <para style="p">—¡Wabúreme, ladǘgawagun Davíd, gudéme wamá bun!</para>
  <para style="p">
    <verse number="32" style="v" />Ába leréderagun Jesúsu, ába lagúarun joun, ába laríñagun joun.</para>
  <para style="p">—¿Ca jabúseerubei nadǘgün jun?</para>
  <para style="p">
    <verse number="33" style="v" />Ába jaríñagun lun.</para>
  <para style="p">—Wabúreme, buséntiwa waríjin.</para>
  <para style="p">
    <verse number="34" style="v" />Ába jagúdemedagun lun Jesúsu, ába lagúurun luágu jágu. Lúmagiñe óra ligía ába jaríjin, ába jafálaruni.</para>
  <chapter number="21" style="c" />
  <para style="s">Lebélurun Jesúsu Jerusaléoun</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mr 11.1-11</ref>; <ref loc="LUK 19:28-40">Lc 19.28-40</ref>; <ref loc="JHN 12:12-19">Jn 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Dan le yaráfaaña lubeí lun Jerusalén, ába jachǘlürün ligíbugiñe fulásu le gíribei Betfajé, le ǘnabubei libíti wǘbü le Olívos, <verse number="2" style="v" />ába laríñagun Jesúsu joun biáma jádaangiñe láni disípulugu.</para>
  <para style="p">—Jeíba lídan liraǘraü fulásu le wagíbugiñebei, jadáriruba ában burígü güráñu ñi láu ában liraǘraü burígü túma, ábame jafáragaduniña, ábame janǘgüniña nun. <verse number="3" style="v" />Ánjein ñi adímurejati jun lueígiñe jadǘgüni, ábame jaríñagun lun luágu busén lániña Jesúsu, luágu láguyugüdübaña lan.</para>
  <para style="p">
    <verse number="4" style="v" />Lasúseredunbei líra lun lagúnfulirun lé meja laríñagubei proféta dan le labǘrüjanbei ítara.</para>
  <para style="q1">
    <verse number="5" style="v" />Aríñaga jumá lun ubúrugu Sión.</para>
  <para style="q1">“Niteín Burúeite bun láu ǘnabuni,</para>
  <para style="q1">waríñu lanágawagu ában burígü,</para>
  <para style="q1">waríñu luágu ában liraǘraü burígü, anímaalu anáajati ílaü.”</para>
  <para style="p">
    <verse number="6" style="v" />Ába joúdin disípulugu, ába jadǘgüni quei laríñaguni Jesúsu joun. <verse number="7" style="v" />Ába janǘgünun burígü tugúya láu sun tiraǘ, ába jíchugunun janáangun jawágu, ába lawárirun Jesúsu. <verse number="8" style="v" />Sarágu jañáti gürígia, ába jábudunun janáangun luágu ǘma, jíbiri, ába jáchuajan tilímun wéwe, ába jíchaajani luágu ǘma. <verse number="9" style="v" />Dándu gürígia ja ubáraübaña quei ja árigibaña, ába jagúmeserun agúaraja.</para>
  <para style="p">—¡Uweíriguni lun ladǘgawagun urúei Davíd! ¡Biníwati wügǘri le ñǘbinbei lídan líri Wabúreme Búngiu! ¡Uweíriguni lun Búngiu!</para>
  <para style="p">
    <verse number="10" style="v" />Dan lebélurun Jesúsu ubúrugun Jerusalén, ába jafúudun sun ja ñíbaña, ába jaríñagun sarágu.</para>
  <para style="p">—¿Cáteisan gürígia le?</para>
  <para style="p">
    <verse number="11" style="v" />Ába jaríñagun gürígia.</para>
  <para style="p">—Jesúsu le, le Nazarétna, fulásu le lídaanbei Galiléa. Ligía ában proféta.</para>
  <para style="s">Larúmadagüdünun Jesúsu témpulu</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mr 11.15-19</ref>; <ref loc="LUK 19:45-48">Lc 19.45-48</ref>; <ref loc="JHN 2:13-22">Jn 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Lárigiñe, ába lebélurun Jesúsu tídoun láni Búngiu témpulu, ába labúgaguniña sun alúgurajatiña jáma agáñijatiña ja ñíbaña. Ába lagárabaguni dábula buri le jadábulan asáansijabaña seínsu ñi joun gürígia, lúma jála ja alúgurajabaña únjun.</para>
  <para style="p">
    <verse number="13" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Laríñajare Búngiu tídan Lerérun. “Núban fulásu le ñí lubei gayára lan jayúmuragun gürígia nun”, ánjein jugúya, barǘ jumaaru quei jában jíwerutiña.</para>
  <para style="p">
    <verse number="14" style="v" />Ába jayábin fiú maríjintiña jáma danímaatiña lúmoun Jesúsu ñi témpulurugu, ába lareídaguagüdüniña. <verse number="15" style="v" />Dan le jaríjinbaalin jábutigu fádirigu jáma arúfudajatiña lilúrudun Moisés miláguru buri le ladáagubei, lúma dan le jagáambuni jagúarajan irájüñü témpulurugu. “¡Uweíriguni lun ladǘgawagun urúei Davíd!”, ába jagáñidun. <verse number="16" style="v" />Ába jaríñagun lun Jesúsu.</para>
  <para style="p">—¿Agáamba bumútisan le jaríñagubei ja?</para>
  <para style="p">Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Ánja, agáamba numúti. ¿Malíijan jumágili tídan Lerérun Búngiu le ñí lubei laríñawagúa lun Búngiu.</para>
  <para style="q1">Adǘgaadibu lun jerémujan ñǘbürigiña jáma irájüñü ja machǘlaagiña,</para>
  <para style="q1">cátei buíti buágu?</para>
  <para style="p">
    <verse number="17" style="v" />Ába lígiruniña, ába lídin ubúrugugiñe lun Betánioun, ába lásügürüni áriebu ñi.</para>
  <para style="s">Líñaragunun Jesúsu tídibu ígo to míinboun</para>
  <para style="r">(Mr 11.12-14, 20-26)</para>
  <para style="p">
    <verse number="18" style="v" />Larúgan bináafin, dan le lagíribudun Jesúsu ubúrugun, ába lalámachun. <verse number="19" style="v" />Ába laríjin ában tídibu ígo láru ǘma, ába lídin tuágun, madáriti ni cáta tuágu lueídügüya ubánaü. Ába laríñagun tun tídibu ígo tugúya.</para>
  <para style="p">—¡Magíindadügüyabá!</para>
  <para style="p">Lídan óra ligía ába tásaürün. <verse number="20" style="v" />Dan jaríjini disípulugu cátei le, ába laweíridun janígi, ába jaríñagun lun Jesúsu.</para>
  <para style="p">—¿Ída liñásan tásaürübei tídibu ígo to ítara oúfun?</para>
  <para style="p">
    <verse number="21" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Ninárün jáu, ánjaün afíñe le gumúti, mámarügübei líbe le nadǘgübei tun tídibu ígo to gayára jumá adǘga, gayáraabei jaríñagun lun wǘbü le. “Gidába yágiñe, dabúba baránajoun”, ábame lasúseredun. <verse number="22" style="v" />Súnme gíñe cátei le jamúriajan lúma Búngiu, ánjein afíñe jubeí, jibíjubei.</para>
  <para style="s">Lubáfu Jesúsu</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mr 11.27-33</ref>; <ref loc="LUK 20:1-8">Lc 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" />Ábati lebélurun Jesúsu témpulurugun, dan niján lan arúfudaja ñi, ába jayábin jábutigu fádirigu jáma wügǘriña ábutigu lídan jafíñen juríu, ába jaríñagun lun.</para>
  <para style="p">—¿Aríñagabeí woun ca lan biríchabei lun badǘgüni cátei le? ¿Ca íchugubalin ubáfu le bun?</para>
  <para style="p">
    <verse number="24" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Nálügüdaadün gíñe ában cátei, ánjein joúnaba nun, ábame naríñaguni jun ca lan áu ubáfu nadǘgei buri cátei le. <verse number="25" style="v" />¿Ca oúnajabalin Juan abásteragüdaja? ¿Búngiu, ódi wügǘriña?</para>
  <para style="p">Ába jagúmeserun adímureja jámagua, ába jaríñagun.</para>
  <para style="p">—Ánjawa aríñaga luágu Búngiu lan oúnajabalin, laríñaguba woun ca lan uágu mafíñerun wabeí lun. <verse number="26" style="v" />Ánjawa aríñaga luágu joúnajan lan wügǘriña, joúserubadiwa gürígia wuríba ladǘga súngubei afíñetiña luágu proféta lán.</para>
  <para style="p">
    <verse number="27" style="v" />Ábati jaríñagun lun Jesúsu.</para>
  <para style="p">—Ibídiñeti woun.</para>
  <para style="p">Ába giñeti laríñagun joun.</para>
  <para style="p">—Maríñagun nubeí giñéti jun ca lan áu ubáfu nadǘgei buri cátei le.</para>
  <para style="s">Jémpulu jawáguti bián isáanigu</para>
  <para style="p">
    <verse number="28" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Nabájüdaguá ában cátei jun, jaríñageime nun ída líña lan jaríjin lun. Ñíñein ában wügǘri, biámañanu lisáanigu. Ába laríñagun lun ában jádaangiñe. “Niraǘ, beíba ñadágimein ugúñe lídan talúbajoún ninádirigu.” <verse number="29" style="v" />Ába laríñagun lisáani lun. “Mabúseeruntina nídin.” Lárigiñe, ába lasáansiragun larítagun, ába lídin ñadágimein. <verse number="30" style="v" />Lárigiñe, ába lídin úguchili aríjei le ában, aríñageinaleí le méme laríñagubeí buga lun le furúmiñeti lun. Ába loúnabun le. “Ánja, nídiba.” Mídinti. <verse number="31" style="v" />Aríñaga jumeí nun, ¿cági jádaangiñe biángubei adǘgübalin le labúseerubei úguchili?</para>
  <para style="p">Ába jaríñagun.</para>
  <para style="p">—Le furúmiñebei.</para>
  <para style="p">Ábati laríñagun Jesúsu joun.</para>
  <para style="p">—Ninárün jáu luágu choúrutima lan jebélurun agúburajatiña liseínsuna gumádi jáma jórugu lídoun larúeijan Búngiu sügǘ jáu, <verse number="32" style="v" />ladǘga ñǘbinti Juan le abásteragüdajabei arúfudaja jun ída lúba lan ligáburi jabágaridun, mafíñeruntün lun, ánjañati ja agúburajabaña liseínsuna gumádi jáma jórugu, afíñeratiña lun. Jugúya, láu sun aríja jumáni sun líra, masáansiragunti jigáburi lun jafíñerun lun.</para>
  <para style="s">Jémpulu jawáguti ñadágimeintiña ja wuríbabaña</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mr 12.1-12</ref>; <ref loc="LUK 20:9-19">Lc 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" />‘Agáamba jumeí ábaya jémpulu le. Luáguti ában wügǘri labúreme ában ichári, ában lábunagun tídibu beíbei lichárirugu, ába ladǘgün baríeru láu, adǘga ligía ában ágei lun laríbichawagún tíra beíbei lídoun lúma ában wáyelesi lun gayára lan loúnigiruni sun cátei.</para>
  <para style="p">‘Ába lájayajani ichári joun ñadágimeintiña, ába lídin adǘga weíyaasu. <verse number="34" style="v" />Dan le lachǘlürün dan lun alúbajani, ába loúnajan jádaangiñe lumúsuniña amúriajei lufánran jámagiñe ñadágimeintiña. <verse number="35" style="v" />Ábarüga járügüdüniña ñadágimeintiña músu jagía, buleísei jameí ában, áfara jameí ában jilágubei, rúgua jagía dǘbü luágu le ában. <verse number="36" style="v" />Ábaya loúnajan labúreme ichári gíbetimaajaña sügǘ jáu ja loúnajabaña furúmiñe, ligía méme jadǘga ñadágimeintiña joun.</para>
  <para style="p">
    <verse number="37" style="v" />‘Agúmujoúni, ába loúnajani liraǘ, ába laríñagun lúnguarügü. “Inébebei niraǘ joun.” <verse number="38" style="v" />Dan le jaríjinbaalin ñadágimeintiña liraǘ, ába jaríñagun jámagua. “Nijánba le erésibirei alágan, wáfaraali jilágubei, reídei wamámuga láu alágan.” <verse number="39" style="v" />Ábati járügüdüni, ába jaságaruni lídaangiñe ichári, ába jáfaruni jilágubei.</para>
  <para style="p">
    <verse number="40" style="v" />Ába lálügüdajan Jesúsu.</para>
  <para style="p">—Dánmeti liábin labúreme ichári, ¿cábagi ladǘga jáu ñadágimeintiña ja?</para>
  <para style="p">
    <verse number="41" style="v" />Ába jaríñagun lun.</para>
  <para style="p">—Láfaragubaña wuríbatiña jagía jilágubei, magúdemedagúnbaña lun, ábame lájayajani ichári joun ámu ñadágimeintiña ja lúntiña jedéregeruni lufánran lun lídaangiñe alúbajani lídan dan.</para>
  <para style="p">
    <verse number="42" style="v" />Ábati laríñagun Jesúsu joun.</para>
  <para style="p">—¿Malíijañaja jumágiru Lerérun Búngiu? Taríñajare nuágu.</para>
  <para style="q1">Le meja dǘbü le mabúseerun jabeí ábunagutiña,</para>
  <para style="q1">ligíaali furúmiñeti.</para>
  <para style="q1">Wabúreme Búngiu adǘgübalin lun furúmiñebei lan,</para>
  <para style="q1">áni aríja wamúti quei ában cátei weíriguti.</para>
  <para style="m">
    <verse number="43" style="v" />Ligía naríñagunbei jun luágu lagídarúaba lan larúeijan Búngiu jueí, jugúya le weírigubei lídan jafíñen juríu, ábame líchugúniwa joun gürígia ja edéregeruti alúbajani le láni larúeijan Búngiu. <verse number="44" style="v" />Ánjeinti áu, le dǘbü ligía, furúmieguarügü le eíguaduti nuágun lañaǘrudagúba, léti uáguti leíguada nigáñi, lagúmuchaguagüdübei. Ligíaba asúsereda joun gürígia ja májabaña nun.</para>
  <para style="p">
    <verse number="45" style="v" />Dan le jagáambunbalin jábutigu fádirigu jáma fariséogu jémpulu buri le líchugubei Jesúsu, ába jasúbudiruni luágu jawágu lan ladímureja. <verse number="46" style="v" />Ábati jabúseerún yebe járügüdüni, madǘgün jamúti ladǘga janúfude jaweí gürígia, ladǘga afíñe jamá gürígia luágu proféta lan.</para>
  <chapter number="22" style="c" />
  <para style="s">Jémpulu luáguti maríei</para>
  <para style="p">
    <verse number="1" style="v" />Ábaya lagúmeserun Jesúsu adímureja joun láu jémpulu, ába laríñagun joun.</para>
  <para style="p">
    <verse number="2" style="v" />—Nijánya ában jémpulu luáguti arúeijani le lánina siélu. Ñíñein ában urúei adǘgüti ában fédu lubá lamárieidun lisáani. <verse number="3" style="v" />Ába loúnajaniña lumúsuniña oúgaña amísurajoútiña, májatiña amísurajoútiña jayábin. <verse number="4" style="v" />Ábaya loúnajan ámu músu, ába laríñagun joun. “Aríñaga jumá joun amísurajoútiña luágu aráanseeli lan eígini. Áfaragüda náaña bágasu jáma nilǘgüniña anímaalugu dibúnetiña, aráanseeli sun cátei, lun jayábin maríeirugu.” <verse number="5" style="v" />Madǘgüntiña amísurajoútiña gásu. Ába lídin ában jádaangiñe lichárigu, ñǘdün ában adǘga ámu wadágimanu, <verse number="6" style="v" />ja jíbiri, ába járügüdüniña lumúsuniña urúei, ába joúseruniña wuríba, ába jáfaraguniña jilágubei. <verse number="7" style="v" />Ábati lagáñidun urúei sarágu, ába loúnajaniña lisúdaaranigu áfaraguaña gáfarajatiña jagía jilágubei lúma águdei jageíra. <verse number="8" style="v" />Ába laríñagun joun lumúsuniña. “Aráanseeli sun cátei lun maríei, áni amísurajoútiña jagǘra madǘnamatiña lun jamísurajoúniwa. <verse number="9" style="v" />Jeíba lubeíti luágu buri larígei ǘma, ábame jamísurajaniña sun ja úmatiña jadúnragua.” <verse number="10" style="v" />Ába joúdin músu luágu buri ǘma, ába joúndaruniña sun ja úmabaña jadúnragua, buítiña jáma wuríbatiña, ába tabuínchun múna jáu gürígia.</para>
  <para style="p">
    <verse number="11" style="v" />‘Ábati lebélurun urúei aríjaña amísurajoútiña, ába laríjin ában wügǘri le madáüragunti quei lun ában maríei ñi. <verse number="12" style="v" />Ába laríñagun lun. “Numáda, ¿ída liñági bebélurunbei ñájoun madáüragunga quei lun ában maríei?” Maní ligía. <verse number="13" style="v" />Ába laríñagun urúei joun ja eténirubaña lún buri dábula. “Gürágua jumeí lugúdi lúma lújabu, fíjumei lídoun lubúriga le boúgudibei, le ñíba lubeí layájuaja, acǘnrijame lári.” <verse number="14" style="v" />Ába laríñagun Jesúsu joun ja agáambubalin.</para>
  <para style="p">—Gíbetiña agúarútiña lun jebélurun lídoun larúeijan Búngiu, míbetiña anúadiruña.</para>
  <para style="s">Luáguti lafáyeirun liseínsuna gumádi</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mr 12.13-17</ref>; <ref loc="LUK 20:20-26">Lc 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Ába joúdin fariséogu, ába júaradun aríja cába lan gayára lan jadǘgün lun jaríñagagüdüni Jesúsu cátei le uáguti gayára lan jadárirun lidúnrun. <verse number="16" style="v" />Ábati joúnajan jádaangiñe jánigu úara jáma jádaangiñe lánigu Heródes, aríñaga lun Jesúsu.</para>
  <para style="p">—Maésturu, subúdi wamúti luágu inárüni lan baríñagubei, luágu gíñe arúfuda báani lémeri Búngiu láu inárüni, manúfudeiga lueí ni ában, ladǘga ni cáta lan luweírigun gürígia bun. <verse number="17" style="v" />Rúbei lubeíti barítagun woun. ¿Buítisan lun lafáyeirúniwa seínsu lun urúei Rómana ódi mabuídunti?</para>
  <para style="p">
    <verse number="18" style="v" />Aríagu líña Jesúsu lun luríba jayúmajan, ába laríñagun joun.</para>
  <para style="p">—¡Biángua tigíbu jugúya le! ¿Ca uágu jíchaaja sádara nubá? <verse number="19" style="v" />Arúfuda jumeí seínsu le áubei lafáyeijoúa liseínsuna gumádi nun.</para>
  <para style="p">Ába janǘgün ában seínsu le denáriu lun. <verse number="20" style="v" />Dan laríjini, ába lálügüdüniña.</para>
  <para style="p">—¿Ca iyáwa le luágubei seínsu le, lúma íri le bürǘwañubei luágu?</para>
  <para style="p">
    <verse number="21" style="v" />Ába jaríñagun lun.</para>
  <para style="p">—Láni urúei Rómana.</para>
  <para style="p">Ábati laríñagun Jesúsu joun.</para>
  <para style="p">—Rújumeiti láni urúei lun urúei, rújumeime láni Búngiu lun Búngiu.</para>
  <para style="p">
    <verse number="22" style="v" />Dan jagáambunbalin le, ába laweíridun janígi, ába jígiruni, ába joúdin.</para>
  <para style="s">Álügüdajani libǘgürü ásaaruni lídaangiñe oúweni</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mr 12.18-27</ref>; <ref loc="LUK 20:27-40">Lc 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" />Wéyu méme ligía, ába joúdin fiú saduséogu aríjei Jesúsu. Jaríñajare saduséogu luágu úa lan ásaaruni lídaangiñe oúweni. Ábati jaríñagun lun Jesúsu.</para>
  <para style="p">
    <verse number="24" style="v" />—Maésturu, aríñagatí meja Moisés luágu ánjein lan oúwe ában wügǘri le maríeiti masáaniguga táu lúmari, lúnti lan lamárieidun lamúlen túma wǘri to ueíboun loúwe, lun gasáanigu lan táu lun líbugaña le oúwebei. <verse number="25" style="v" />Wel, ñíñanu méjati sédü gamúlenuguátiña ya wádan, ába lamárieidun le furúmiñeti, ába loúnwen. Quei masáanigu lubeí táu lúmari, ába lígirunun lun lamúlen. <verse number="26" style="v" />Ligía méme suséreti lun jabíaman, lárigiñe lun jǘrüwan darí lúmoun jasédün. <verse number="27" style="v" />Lárigiñe, ába gíñe toúnwen wǘri. <verse number="28" style="v" />Dánmeti jásaarun lídaangiñe oúweni, ¿cábati úmari wǘri tugúya jádaangiñe sédü gamúlenuguátiña ja, lárigiñe maríei jamá sun jagía túma?</para>
  <para style="p">
    <verse number="29" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Bulíeiguatün ladǘga libídiñe tuáguti Lerérun Búngiu jun, ni luáguti lubáfu Búngiu. <verse number="30" style="v" />Dánme le jásaarun jiláaña lúnya jabágaridun, ámujalime jabágari, magámaridun jába, míchugun jamáñame jasáanigu lun maríei, queísi magámaridun jamá ánjeligu siélu. <verse number="31" style="v" />Ánjeinti luágu sará jamá jiláaña lúnya jabágaridun, ¿malíijan jumágili le laríñagubei Búngiu gúanarü jun? ítara líña laríñagun. <verse number="32" style="v" />“Áu Lubúngiutebei Abrahám, Lubúngiute Isáac, Lubúngiute Jacób.” Ítara líña lubeíti, ánjein jamúga jiláañu jáña lubeí wügǘriña jagía lun sun dan, maríñagunti jamúgati Búngiu luágu Jabúngiute lan, ladǘga máma Jabúngiute jiláguaaña Búngiu, Jabúngiute wínwangiña.</para>
  <para style="p">
    <verse number="33" style="v" />Dan jagáambunbalin gürígia cátei le, ába laweíridun janígi láu le larúfudajabei.</para>
  <para style="s">Gumádi le weírigutimaabei</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mr 12.28-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" />Dan le jasúbudirunbalin fariséogu luágu manígüda láaña lan Jesúsu saduséogu, ába joúndaragun, <verse number="35" style="v" />ñíñein ában jádaangiñe le arúfudajati lilúrudun Moisés, abúseeruti laríjin lábun Jesúsu, ába laríñagun lun.</para>
  <para style="p">
    <verse number="36" style="v" />—Maésturu, ¿cásan gumádi weírigutimaabei lídan lilúrudun Búngiu?</para>
  <para style="p">
    <verse number="37" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—“Jínsiñelá Babúreme Búngiu bun táu sun banígi, táu sun buwáni, láu sun bisáminan.” <verse number="38" style="v" />Niján gumádi weírigutimaabei, furúmiñeti gíñe lídaangiñe sun lugúmadin Búngiu. <verse number="39" style="v" />Áni le libíaman lídan uweíriguni lenége le, ítara líña. “Jínsiñe jamá bíbirigu bun quei bínsiñegua búngua.” <verse number="40" style="v" />Bián gumádi le, ligía ébuubei lun sun lilúrudun Moisés lúma jarúfudajan profétagu.</para>
  <para style="s">¿Ca adǘgawagun Crístu?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mr 12.35-37</ref>; <ref loc="LUK 20:41-44">Lc 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" />Sun añája lan fariséogu oúndaragu, <verse number="42" style="v" />ába laríñagun Jesúsu joun.</para>
  <para style="p">—¿Cásan jarítagubei libǘgürü Crístu le lanúadirubei Búngiu lun lasálbaruniña gürígia? ¿Cásan adǘgawagun?</para>
  <para style="p">Ába jaríñagun lun.</para>
  <para style="p">—Ladǘgawagun Davíd.</para>
  <para style="p">
    <verse number="43" style="v" />Ábati laríñagun Jesúsu joun.</para>
  <para style="p">—¿Ída liñáti lagúarunbalin Davíd quei Abúremein, láu lubáfu Sífiri Sándu? Aríñagatiga Davíd.</para>
  <para style="q1">
    <verse number="44" style="v" />Laríñajare Búngiu lun Nabúreme.</para>
  <para style="q1">“Ñurúba núma lueígiñe noúnwenren</para>
  <para style="q1">daríme níchuguniña báganiñu bújaburugun.”</para>
  <para style="m">
    <verse number="45" style="v" />¿Ída lubáti ladǘgawagun lan Davíd Crístu ánjein wá lubali Davíd guánarü Crístu Nabúreme?</para>
  <para style="p">
    <verse number="46" style="v" />Úati ni ában gayáraati loúnabun ni ában dimúrei, lúmagiñeti wéyu ligía, manígiti ni ában lun liábin álügüdaguei.</para>
  <chapter number="23" style="c" />
  <para style="s">Líchugun Jesúsu jadúnrun fariséogu jáma arúfudajatiña lilúrudun Moisés</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mr 12.38-40</ref>; <ref loc="LUK 11:37-54">Lc 11.37-54</ref>, <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ábati laríñagun Jesúsu joun láni disípulugu jáma jíbiri gürÍgia ja ñíbaña.</para>
  <para style="p">
    <verse number="2" style="v" />—Gabáfutiña arúfudajatiña lilúrudun Moisés jáma fariséogu lun jafúnraanguagüdüni líla lilúrudun Moisés. <verse number="3" style="v" />Agáamba jumáña lubeíti, adǘga jumeíme sun le jaríñagunbei jun, le jadǘgübei, mafálara jumeí ladǘga aríñagatiña ában cátei, jadǘga ámu. <verse number="4" style="v" />Rújamuti gumádi joun gürígia queísi anǘgüni jǘrüti le siñábei lanügǘniwa, ánjein jagía, madǘgüntiña ni cáta lun jíderaguniña gürígia luágu buri anǘgüni lánina lúrudu le jíchugubei jawágu. <verse number="5" style="v" />Jadǘgüni sun cátei lun jaríjiña gürígia. Jínsiñeti joun lun jíchugun tirájüñü gáfu táu Lerérun Búngiu jeréberugu lúma luágu buri jarǘna, lúma lun jadáüragun anáanguni to durúrutu. <verse number="6" style="v" />Buséntiña járügüdüni lubuídun-ágei ubáraü lídan eígini lúma jalaǘ le jála weírigutiña tídan jalígilisin. <verse number="7" style="v" />Buséntiña lun jabúsurun gürígia joun láu sarágu inébesei ǘmada, lun gíñe lagúarúniwa joun, “maésturugu”.</para>
  <para style="p">
    <verse number="8" style="v" />‘Ánjein jugúya, mígira jumá lun laríñawagúniwa jun, “maésturugu”, ladǘga sun jugúya ában jáu, áni ában rügǘñein gíñe Jumaésturun, áu le Crístubei. <verse number="9" style="v" />Maríñaga jumá gíñe “núguchi” lun ni ában wügǘri uboúagu lídan ligáburi jagúaruni Búngiu le siélubei “Núguchi”. <verse number="10" style="v" />Mígirun jugúyame lun laríñawagúniwa jun “ábutigu” ladǘga Crístu rügǘñein Jábuti. <verse number="11" style="v" />Le esériwidubei joun jíbiri, ligía weírigutimaabei jídan, <verse number="12" style="v" />ladǘga le anáanguti lúngua weíri, lǘnabudagüdǘwaba, ánjein le anáanguti lúngua ǘnabu, laweíridagüdǘwaba.</para>
  <para style="p">
    <verse number="13" style="v" />‘¡Fugiábugu jugúya arúfudajatiña lilúrudun Moisés jáma fariséogu! ¡Biángua tigíbu!, ladǘga darú jumuti lubéneri arúeijani le lánina siélu lueí jebélurun ámu, mebélu jugúyati, mígirun lun jebélurun ja busénbaña jebélurun.</para>
  <para style="p">
    <verse number="14" style="v" />‘¡Fugiábugu jugúya, arúfudajatiña lilúrudun Moisés jáma fariséogu! ¡Biángua tigíbu! Gidá jumutu jában würíña ja jiláaña úmari jaweí, lúnti ibídiñewa lan, ába jadáagun ayúmuraguni lun Búngiu le migínaguti. Ligía weíritimaabei lubeí jasúfurirun lueígiñe.</para>
  <para style="p">
    <verse number="15" style="v" />‘¡Fugiábugu jugúya arúfudajatiña lilúrudun Moisés jáma fariséogu! ¡Biángua tigíbu! Eíbuga jumúti múa, áfayaja jumeí barána áluaja gürígia lun jánigume, dánti le ibíja jumáali le jabúseerubei, ába jadǘgüniña gürígia jagía bián weíyaasu lúntima joúdin máfiougati sügǘ jáu.</para>
  <para style="p">
    <verse number="16" style="v" />‘¡Fugiábugu jugúya, adúndejatiña maríjintiña! Aríñagatün luágu le lan gürígia íchuguti dimúrei, ánjein áfiñura tuágu témpulu mála lan líra, áni ánjein lan áfiñura luágu tigóluna témpulu, aná lan líra, lúnti lan lagúnfulirun. <verse number="17" style="v" />¡Ibídiougua líña jáu, maríjin! ¿Cági weírigutimaabei, gólu ódi témpulu to adǘgüboun lun sagráubei lan gólu? <verse number="18" style="v" />Aríñagatün gíñe luágu ánjein lan íchiga gürígia dimúrei lun láfiñurun luágu latárü, mála lan líra, áni ánjein lan áfiñura luágu cátei le adágaragüdǘwabei luágu latárü, aná lan líra, lúnti lan lagúnfulirun. <verse number="19" style="v" />¡Ibídiougua líña jáu, maríjin! ¿Cági weírigutimaabei, cátei le luágubei latárü ódi latárü le adǘgübalin cátei ligía lun sagráubei lan? <verse number="20" style="v" />Le áfiñurubei luágu latárü, máma rügǘñein luágu latárü láfiñurun, láfiñuruña gíñe luágu sun le ligíbuagubei latárü. <verse number="21" style="v" />Le gíñe áfiñurubei tuágu témpulu, máma rügǘñein gíñe tuágu témpulu láfiñura, láfiñuruña gíñe luágu Búngiu le aganoúbei tídan. <verse number="22" style="v" />Le gíñe áfiñurubei luágu siélu, láfiñuruña gíñe luágu lála Búngiu, lúma gíñe luágu Búngiu le añúurubei luágu jalaǘ ligía.</para>
  <para style="p">
    <verse number="23" style="v" />‘¡Fugiábugu jugúya arúfudajatiña lilúrudun Moisés jáma fariséogu! ¡Biángua tigíbu! Adǘgatün díisi fáreinti láu jíduru le ménta, anísi, lúma comíno lun jíchugun ában fáreinti lun Búngiu, áni mebéresentün láu arúfudajani le weírigutimaabei lídan lilúrudun Búngiu, queí buri lun jadǘgüni sun cátei láu úaraguni, lúma lun jagúdemedun gürígia jun, lúma lun jagúnfulirun lúma Búngiu. Ligía buri cátei le lúnbei jadǘgüni, mígirunga jumeíme jadǘgüni le líbiri. <verse number="24" style="v" />¡Jugúya, adúndejatiña maríjintiña jugúya le, áseija jumúti ában minímini áni julútün ában caméyu!</para>
  <para style="p">
    <verse number="25" style="v" />‘¡Fugiábugu jugúya arúfudajatiña lilúrudun Moisés jáma fariséogu! ¡Biángua tigíbu! Adǘgatün lun jarítagun gürígia luágu buídu lan jigáburi. Ítara jíña quei wéru lúma asíedu le jachíbubei boúgudigiñe libíti, ánjein múnadagiñe jibíti, buin jíña láu buri luweínamu-águu lúma íweruni. <verse number="26" style="v" />Fariséogu maríjintiña. jarúmagüda jumeí wéru lúma asíedu lurágeirugugiñe furúmiñe, ábame gíñe larúmadun boúgudigiñe libíti.</para>
  <para style="p">
    <verse number="27" style="v" />‘¡Fugiábugu jugúya arúfudajatiña lilúrudun Moisés jáma fariséogu! ¡Biángua tigíbu! Ítara jíña quei umúajaü le afeíndijoúti láu jarúti boúgudigiñe libíti, buídumeraüti larijín, ánjein lurágeirugugiñe, buín líña láu jábu jiláaña lúma sun luwúyeri iwíyei. <verse number="28" style="v" />Ítara jíña, boúgudigiñe jibíti, ma lubuídun jarijíniwa jagíbugiñe gürígia, ánjein múnadagiñe, buín jíña láu iyéerejabuni lúma wuríbani.</para>
  <para style="p">
    <verse number="29" style="v" />‘¡Fugiábugu jugúya arúfudajatiña lilúrudun Moisés jáma fariséogu! ¡Biángua tigíbu! Rújumuti dǘbü arítaguagüleime luágu jamúaja profétagu, wéndegüda jumeí umúajaü le jáni gürígia já meja buídubaña. <verse number="30" style="v" />Ábati jaríñagun. “Lun jamúga meja awánjeinjadiwa lan le jadáani binádu wagǘbürigu, míderagun wamútiña jamúga áfaraguaña profétagu.” <verse number="31" style="v" />Láu líra, subúdiguatün júngua luágu jádaangiñetün lan ja áfaragubaliña profétagu jagía. <verse number="32" style="v" />¡Gumújumeiti jadǘgüni lé meja jagúmeserubei binádu jagǘbürigu adǘga!</para>
  <para style="p">
    <verse number="33" style="v" />‘¡Jéwegu! ¡Jarásan jéwegu! ¿Ída lubásan jeséfurun lueí asúfuriruni le lánina máfiougati? <verse number="34" style="v" />Ligía noúnajaba lubeí profétagu, jáma ja chúbaña áu, jáma arúfudajatiña, jun. Áni jugúya, jáfaragubaña jádaangiñe, dágua jumáñame jíbiri luágu gurúwa, bei jumáñame jíbiri tídan jalígilisin juríu, eíbaaja jumáñame lídan sun fulásu. <verse number="35" style="v" />Ítara lúba láburujan dúru juágun luágu sun jítaü le áwiyurubei jádaangiñe sun wügǘriña buítiña ja jáfarawagúbaña, lúmagiñé meja Abél le richáguabei darí lúmoun Zacarías, liraǘ Berequías lé meja jáfarubei tabádinagua témpulu lúma latárü. <verse number="36" style="v" />Ninárün jáu luágu láburujaba lan dúru jawágun gürígia ja lánina dan le luágu buri sun cátei le.</para>
  <para style="s">Layájun Jesúsu jawágu lílana Jerusalén</para>
  <para style="r">(<ref loc="LUK 13:34-35">Lc 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" />‘¡O jugúya Jerusalénna! ¡Áfaragua jumáaña profétagu, chǘgua jugúya dǘbü jawágun ja loúnajabaña Búngiu láu ugánu buíti jun! ¡Sarágu weíyaasu nálugun natoúnigirunün quei tatoúnigiruniña gáyu tirájüñü lábugiñe tarǘna, májatün! <verse number="38" style="v" />Ígira láadün Búngiu, <verse number="39" style="v" />áni naríñajare jun luágu maríjindügüya jumáadina lan queísi jasálbaragüle daríme lachǘlürün dan lun jaríñagun. “Biníwati le ñǘbinbei lídan líri Wabúreme Búngiu.”</para>
  <chapter number="24" style="c" />
  <para style="s">Laríñagun Jesúsu luágu tagǘnrinchawagúba lan témpulu</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mr 13.1-2</ref>; <ref loc="LUK 21:5-6">Lc 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Dan le láfuridun Jesúsu témpulurugugiñe, leíbuga yebe, ligía jayábin láni disípulugu lúmoun, ába jarúfudun tuágun témpulu lun. <verse number="2" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—¿Aríja jumútu sun to? Ninárün jáu luágu merédebei lan ni ában dǘbü ligíbuagu dǘbü, tagǘnrichawagúba sun to.</para>
  <para style="s">Seíni buri lubáragiñe lagúmuchun uboú</para>
  <para style="r">(<ref loc="MRK 13:3-23">Mr 13.3-23</ref>; <ref loc="LUK 21:7-24">Lc 21.7-24</ref>, <ref loc="LUK 17:22-24">17.22-24</ref>)</para>
  <para style="p">
    <verse number="3" style="v" />Ábati joúdin luágu wǘbü Olívos, dánti ñun lan Jesúsu ñi, ába joúdin láni disípulugu agǘlülüja lúma, ába jaríñagun lun.</para>
  <para style="p">—Buséntiwa lun baríñaguni woun ídaba lan tagǘnrinchawagúa témpulu. ¿Cába liseíni bagíribudun uboúagun, lúma lagúmuchagüle?</para>
  <para style="p">
    <verse number="4" style="v" />Ába laríñagun Jesúsu joun.</para>
  <para style="p">—Toúnigi jumá lun úa lan ayéedutün, <verse number="5" style="v" />ladǘga sarágujaba ñǘbintiña aríñageina. “Áu Crístubei”, áni sarágujaba jayéedun. <verse number="6" style="v" />Jugúya jagáambuba lamúri wuríbu yaráfa jun lúma ugánu luágutí buri wuríbu díseti jueí, manúfudedagua jumá. Lúnti ítara lan, mámagilíme lagúmuchagüle uboú líra. <verse number="7" style="v" />Lageíndaguba ában ageíraü lúma ában, lawúribujaba ában fulásu lúma ában, ñíbei ilámaü, sándi, járabaganáli lídan sarágu fulásu. <verse number="8" style="v" />Sun líra lagúmesejarügügili le lúnbei lasúfurirúniwa.</para>
  <para style="p">
    <verse number="9" style="v" />‘Jugúyati, jedéregerúaba lun lúrudu lun jasúfurirawagüdǘn, lun gíñe jáfarawagúniwa jilágubei, jiyéreegudúba lun sun uboú nueígiñe. <verse number="10" style="v" />Lídaanme dan ligía, sarágujaba eféridiruti jafíñen nuágu, ábame jeyéreegudún joúniwagua, ábame jalúguragun joúniwagua. <verse number="11" style="v" />Jachǘlaaguba sarágu yéetiña aríñaga luágu profétagu jamá áni sarágujaba gürígia jayéedun. <verse number="12" style="v" />Ñíbei sarágu wuríbani daríme lun jeféridiruni sarágu jádaangiñe lánigu Búngiu ínsiñejabuni jádaangua. <verse number="13" style="v" />Le asígiruti derégüdagu darí lúmoun lagúmujoún, lasálbarúba. <verse number="14" style="v" />Lapúrichijoúba ugánu buíti le luáguti larúeijan Búngiu lídan sun uboú lun lasúbudirúniwa lídan sun fulásu, ligíaalímeti lagúmuchun uboú.</para>
  <para style="p">
    <verse number="15" style="v" />‘Abǘrüjatí meja proféta Daniél luágu cátei iyéreeguti le gagǘnrinchaguagüdadibei, dánme le jaríjin chülǘjali lan cátei le lídoun fulásu le sánduti—le alíijabei, gunfaráandalá—, <verse number="16" style="v" />jámeti Judéabaña, lúntime janúrajan luágun buri wǘbü. <verse number="17" style="v" />Léme tábulugubei lúban wéyu ligía, maráriralá aságara ni cáta múnadagiñe, <verse number="18" style="v" />le áraabubei, magíribudalá ni abúdoun lanáangun. <verse number="19" style="v" />¡Fugiábugume würíña ja dageínatiña o ja lan gasáanigutiña ja gurágiña lídounme wéyu ligía! <verse number="20" style="v" />Amúriaja jumá lúma Búngiu lun máma lan lídan lidíliga ni lídan luwéyuri eméraaguni janúraja. <verse number="21" style="v" />Ladǘga ñíbei sarágu súfuri le úagili líbe lúmagiñe lagúmeserun uboú, úabei gíñe lárigiñe. <verse number="22" style="v" />Lun jamúga madǘraagun lubeí lan Búngiu dan ligía, úati jamúga ni ában asálbaruti, ladǘraagubei jawágurügü ja lanúadirubaña lun lánigu jamá.</para>
  <para style="p">
    <verse number="23" style="v" />‘Ánjein lubeíti aríñawagua jun. “Niján Crístu” o “Ningitán lan”, mafíñera jumá, <verse number="24" style="v" />ladǘga jayábinba ayéejatiña lun jarúfudagun joúngua camá Crístu, camá buri profétagu, áni jadáaguba oúnwenbun buri seíni lúma miláguru lun jeyéedaguniña ja anúadira láañabaña Búngiu ánjaña gayára. <verse number="25" style="v" />Aríñaga náali le jun lubáragiñe lasúseredun, <verse number="26" style="v" />ligía lubeíti, ánjein aríñawagua jun. “Níjein Crístu yára lídan fulásu le mageírawati”, mídin jumá ñi, ánjaña aríñaga jun. “Niján ya rúmurugu”, mafíñera jumá. <verse number="27" style="v" />Quei larijíniwa labírichagun lueígiñe ában oúbaü libíti siélu lun luágun le ában, ítara lúba dánme le niábin, aú le Wügǘri Garaǘwarügüti. <verse number="28" style="v" />Ábame láburujan ligáñi Búngiu jawágun gafígountiña quei wadúbi luágun úgubu jiláali.</para>
  <para style="s">Seíni buri lubáragiñe lagíribudun Crístu uboúagun</para>
  <para style="r">(<ref loc="MRK 13:24-37">Mr 13.24-37</ref>; <ref loc="LUK 21:25-33">Lc 21.25-33</ref>, 17.26-30, 34-36)</para>
  <para style="p">
    <verse number="29" style="v" />‘Lárigiñerügüme lásügürün wéyu buri lánina súfuri ligía, ábame labúrigadun wéyu, marúnijalime játi, ábame jeíguadúnga warúguma ja siélubaña, ábame ladádagarun sun siélu. <verse number="30" style="v" />Ábameti jaríjini niseíni siélu, súnme gürígia wuríbatiña uboúagu, jayájuajaba láu jaríjini niábinya, áu le Wügǘri Garaǘwarügüti, lídan juánriñu siélugiñe láu oúnwenbun ubáfu lúma uweíriguni. <verse number="31" style="v" />Dánme línwirúniwa fídu rein, ábame noúnajaniña náni ánjeligu ja siélubaña lun joúndaruniña nánigu ja anúadira náañabaña lídaangiñe gádürü larígei uboú.</para>
  <para style="p">
    <verse number="32" style="v" />‘Furéndei jumeí jémpulu le tuáguti tídibu ígo. Dan le ñulúgili tilímun, ába laboúchun tubána, subúdi jumúti luágu yaráfaali lan lubáchouga. <verse number="33" style="v" />Ítara méme, dánme gíñe jaríjini sún buri cátei le, subúdi jumeí luágu yaráfaali lan niábin. <verse number="34" style="v" />Ninárün jáu, luágu lagǘnrinchawagúba lan sun ubúrugu le Jerusalén lubáragiñe joúwegun gürígia ja lánina dan le. <verse number="35" style="v" />Lagúmuchaguba siélu lúma uboú, ánjein nerérun, merédebei magúnfulirúnga.</para>
  <para style="p">
    <verse number="36" style="v" />‘Ánjeinti luágu wéyu lúma óra le lúnbei nagíribudun uboúagun, ibídiñeti ni ca un, ni joun ánjeligu ja siélubaña, ni nun, áu le Liraǘ Búngiu, Búngiu rügǘñein Úguchili asúbudirei.</para>
  <para style="p">
    <verse number="37" style="v" />‘Ítara queí meja lasúseredun lídan meja lidáani Noé, ítara lúba gíñe dánme le niábin, áu le Wügǘri Garaǘwarügüti. <verse number="38" style="v" />Lídan meja dan ligía, lubáragiñe ladíbirun uboú, jerédera meja gürígia eíga, áta, amárieidagua, íchaajaña jasáanigu lun maríei, darí wéyu le lebélurunbei Noé tídoun ugúnein. <verse number="39" style="v" />Meféentiña, darí ladíbirun uboú, ába jañáradagun súngubei. Ítara lúba gíñe dánme niábinya, áu le Wügǘri Garaǘwarügüti uboúagun. <verse number="40" style="v" />Lídaanme dan ligía, ñíbaña bián wügǘriña áraabu, lanügǘba ában, igirúame le ában según jafíñen nuágu. <verse number="41" style="v" />Ñíbaña bián würíña amúlija, tanügǘba ában, igirúame to ában.</para>
  <para style="p">
    <verse number="42" style="v" />‘Agágudúañu jumá, ladǘga ibídiñeti jun cába lan óra niábin, áu le Jabúreme. <verse number="43" style="v" />Subúdi jumeí le, luágu ánjein lan jamúga lasúbudira tabúreme ában múna cába lan óra liábin jíweruti áriebu, leréderuña jamúga marúmugunga, mígirunti jamúga lun lebélurúniwa íweruja lúbiñe. <verse number="44" style="v" />Ligía aráanseñu jumá lubeí, ladǘga léme óra magáradajan jumá, ligíame niábin, áu le Wügǘri Garaǘwarügüti.</para>
  <para style="s">Músu le úaraguabei, lúma le múaragúnbei</para>
  <para style="r">(<ref loc="LUK 12:41-48">Lc 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" />‘Ítara jumá queísi músu úaraguati, gunfaráanda ligía, le lígirubei liyúbudiri lun laríjin jáu ja lúbiñebaña lun líchugun eígini joun lídan dan. <verse number="46" style="v" />Gúndaabei músu le dánme le liábin liyúbudiri ánjein ladárira agúnfulira lúma lifísiute. <verse number="47" style="v" />Ninárün jáu luágu líchugubei lan liyúbudiri lun laríjin láu sun lumégen. <verse number="48" style="v" />Ánjein ában lubeí wügǘri wuríbati músu ligía, ábame larítagun luágu lǘgili lan liábin liyúbudiri, <verse number="49" style="v" />ábame lagúmeserun oúseraña jíbiri músu wuríba, reídei ligíame eíga lúma áta jáma bacháruatiña, <verse number="50" style="v" />ábameti liábin liyúbudiri lídan wéyu le magúrabun láani, lídan óra le ibídiñeti lun. <verse number="51" style="v" />Ábame líchuguni luweírin-ágei abeichúni luágu, lasíadireime lun máfiougatin úara jáma biángua tigíbu, ábame layájun, acǘnrijame lári.</para>
  <chapter number="25" style="c" />
  <para style="s">Jémpulu jawáguti díisi würíña irájüñü</para>
  <para style="p">
    <verse number="1" style="v" />Ába laríñagun Jesúsu.</para>
  <para style="p">—Ítara lubáti arúeijani le lánina siélu quei díisi würíña irájüñü ja anǘgübaña jalámpun le gálati gási, ába jáfuridun lun jadúnragun lúma adári, ñǘdün jamámuga úara lúma maríeirugun. <verse number="2" style="v" />Seíngü jádaangiñe, maráanseruntiña, seíngü aráansetiña. <verse number="3" style="v" />Ja maráanserunbaña, dan le janǘgünbalin jalámpun, manǘgüntiña ámu gási lueí le lídaanbei jalámpun, <verse number="4" style="v" />ánjañati ja aráansebaña, barǘtiña jabúdein láu gási boúgudin lueí le lídaanbei jalámpun. <verse number="5" style="v" />Queísiti ladárasarun adári, ába ladábudunga jágu súngubei, ába jarúmugun. <verse number="6" style="v" />Queí buri luágu amídi áriebu, ligía lagaambúniwa agúaraguni. “Niteín adári, furíjuma adúnraguei.” <verse number="7" style="v" />Sun würíña irájüñü jagía, ába jásaarunga, ába jagúmeserun aráansejei jalámpun. <verse number="8" style="v" />Ába jaríñagun ja maráanserunbaña joun ja aráansebaña. “Rújuma murúsun lídaangiñe jigásin woun, ladǘga léñeguchuña walámpun.” <verse number="9" style="v" />Ába jaríñagun ja aráansebaña joun. “Siñáti, ladǘga loúguabei woun, loúguame jun. Jeíbagubei le ñí lubei lalúgurajoúa agáñija jumámuga júngua.” <verse number="10" style="v" />Léti añángüra lan ja maráanserunbaña agáñija gási, ligía liábin adári. Játi aráansebaña, ába jebélurun lúma maríeirugun, ába ladaurúniwa béna. <verse number="11" style="v" />Lárigiñe, ligía jachǘlürün jíbiri würíña irájüñü jagía, ába jaríñagun. “¡Wabúreme, wabúreme, darábei béna wabá! <verse number="12" style="v" />Ába laríñagun joun. “Ninárün jáu, ibídiñetün nun.”</para>
  <para style="p">
    <verse number="13" style="v" />Ábati laríñagun Jesúsu joun.</para>
  <para style="p">—Agágudúañu jumá, ladǘga ibídiñeti jun cába lan wéyu, ni cába lan óra nagíribudun, áu le Wügǘri Garaǘwarügüti, uboúagun.</para>
  <para style="s">Jémpulu luáguti seínsu</para>
  <para style="p">
    <verse number="14" style="v" />‘Ítara líña arúeijani le lánina siélu quei ában wügǘri le dan lébei laráansejan lun ladǘgün weíyaasu lídoun ámu fulásu, ába lagúarun joun lumúsuniña, ába líchuguni liseínsun lábugiñoun jaríaajan.</para>
  <para style="p">
    <verse number="15" style="v" />‘Lun ában jádaangiñe, rúti queí buri seíngü-mílu fiádürü, queí buri bián-mílu lun ában, queí buri mílu lun ában. Lafánreinjani joun quei jabáfu lun jawádigimariduni. Ábati lídin luágu luweíyasun. <verse number="16" style="v" />Le músu le erésibirubei seíngü-mílu fiádürü, ába luwádigimariduni, ába lagáñeirun seíngü-mílu fiádürü ligíbuagun. <verse number="17" style="v" />Ítara méme le erésibirubei bián-mílu, gáñeiti bián-mílu lánwoun. <verse number="18" style="v" />Ánjeinti le erésibirubei mílu, ába lídin, ába lachígin ában júyu, ába larámuduni liseínsun liyúbudiri ñi.</para>
  <para style="p">
    <verse number="19" style="v" />‘Sarágu dan lárigiñe, ába lagíribudun iyúbudiri, ába lagúmeserun aráanseja jáma luágu seínsu. <verse number="20" style="v" />Furúmiñe, ába liábin le erésibirubei seíngü-mílu fiádürü, ába ledéregeruni lun liyúbudiri láu seíngü-mílu le lagáñeirubei ligíbuagun, ába laríñagun lun. “Niyúbudiri, seíngüñein-mílu fiádürü bíchugun nun, niján seíngü-mílu nagáñeirun ligíbuagun.” <verse number="21" style="v" />Ába laríñagun iyúbudiri lun. “Buíti, ában músu buíti amǘrü, úaragua, quei úaragua bubeí lídan le murúsunrügüti, níchiga gíbetimaati lábugiñe baríaajan. Queímoun, gúnda amǘrüme úara núma.” <verse number="22" style="v" />Lárigiñe, ába liábin le erésibirubei bián-mílu fiádürü, ába laríñagun. “Niyúbudiri, biámañein-mílu fiádürü bíchugun nun, niján bián-mílu nagáñeirun ligíbuagun.” <verse number="23" style="v" />Ába laríñagun liyúbudiri lun. “Buíti, ában músu buíti amǘrü, úaragua, quei úaragua bubeí lídan le murúsunrügüti, níchiga gíbeti lábugiñe baríaajan. Queímoun, gúnda amǘrüme úara núma.” <verse number="24" style="v" />Ligía liábin le erésibirubei mílu fiádürü, ába laríñagun lun liyúbudiri. “Niyúbudiri, subúdigubei numúti luágu wügǘri ban jéreguti, alúbaja ban le ñí lumuti mábunagun ban, abúdaja amǘrü le ñí lumuti machágarun ban ni cáta. <verse number="25" style="v" />Ligía nanúfudedunbei, ába nídin arámudei biseínsun lábugiñe múa. Niján le báni.” <verse number="26" style="v" />Ába laríñagun iyúbudiri lun. “Músu wuríbati, moúnti. Subúdigubei bíñein luágu alúbaja nan le ñí lubei mábunagun nan, abúdaja áu le ñí lubei machágajan nan ni cáta. <verse number="27" style="v" />Ligía lúnti lubeí jamúga bíchuguni niseínsun báncürugun lun dan lan jamúga nagíribudun, nerésibiruni le náni láu agáñeiruni.” <verse number="28" style="v" />Ába laríñagun joun ja ñíbaña. “Gidájumei seínsu le lúmabei lueí, rújumei lun le láubei díisi-mílu, <verse number="29" style="v" />ladǘga le adǘgübei buíti láu le lúmabei, líchugúba lánwoun lun, ábanme lígiragun lun, ánjein le madǘgübei buíti láu murúsun le lúmabei, lagídarúaba lueí. <verse number="30" style="v" />Músuti moúnti le, fíjumei lídoun lubúriga le boúgudibei, le ñíba lubeí layájuaja, acǘnrijame lári.”</para>
  <para style="s">Jagúseragüdǘniwa sun gürígia</para>
  <para style="p">
    <verse number="31" style="v" />‘Dánme nagíribudun, áu le Wügǘri Garaǘwarügüti, uboúagun, niábinba quei urúei geyégu ánjeligu náu, ábame nañúurun luágu nála láu uweíriguni lun nagúseragüdüniña sun gürígia. <verse number="32" style="v" />Ábame joúndaragun gürígia ja lílana sun fulásu nigíbugiñe, ábame nafánreinraguniña jawáriuagua quei lafánreinraguniña joúniri mudún, mudún jádaangiñe gábara. <verse number="33" style="v" />Ja richáguabaña ligíbugiñe Búngiu, ábame níchuguniña lueígiñe noúnwenren, ja wuríbabaña ligíbugiñe Búngiu, lueígiñebaña nubaǘna. <verse number="34" style="v" />Naríñagame joun ja lueígiñebaña noúnwenren. “Jigoúgu, jugúya le biní laalíbei Núguchi, resíbi jumeí arúeijani le aráanserúbei jubá lúmagiñe ladǘgüni Búngiu uboú. <verse number="35" style="v" />Ladǘga dan le nalámachunbei, rútün eígini nun, dan le namágürabudunbei, rútün dúna nun, dan le eíbugañaja nubeí quei chülǘdügüti, rútün múna nun. <verse number="36" style="v" />Dagáti manáanguni nuágu, rútün anáanguni nun, dan le nasándirunbei, ñǘdüntün aríjana, dan le nadaürǘnbei, ñüdǘntün aríjana.” <verse number="37" style="v" />Ábameti jaríñagun richáguatiña jagía nun. “Wabúreme, ¿ída bugagí waríjabu láu ilámaü, ába wíchugun eígini bun? ¿ída bugagí waríjabu láu mágürabu, ába wíchugun dúna bun? <verse number="38" style="v" />¿Ída bugagí waríjabu quei chülǘdügüti, ába wíchugun múna bun? ¿o manáangunga, ába wíchugun anáanguni bun? <verse number="39" style="v" />¿Ída bugagí waríjabu láu sándi o furísunrugu, ába woúdin aríjabu?” <verse number="40" style="v" />Ábame naríñagun joun. “Ninárün jáu, furúmieguarügü cátei le jadǘgübei lun ában jádaangiñe namúlenu, ca lan lǘnabunbei, nun méme jadǘgei.”</para>
  <para style="p">
    <verse number="41" style="v" />‘Naríñagameti joun ja lueígiñebaña nubaǘna. “Díse jumá nueí, jugúya le lúnbei jasúfurirun lun sun dan, jeíba lídoun wátu geméti le méñeguchadibei, le aráanserúbei lubá Máfia jáu lánigu. <verse number="42" style="v" />Ladǘga dan le nalámachunbei, míchutün eígini nun, dan le namágürabudunbei, míchutün dúna nun. <verse number="43" style="v" />Eíbugatina quei chülǘdügüti, míchutün múna nun, mégeitina anáanguni, míchutün nun, sánditina, daǘwa áu, mídintün aríjana.” <verse number="44" style="v" />Ábame jaríñagun wuríbatiña jagía nun. “Wabúreme, ¿ída bugagí waríjabu láu ilámaü o mágürabu, o quei chülǘdügüti, o manáangunga, o láu sándi, o furísunrugu, míderagun wamútibu?” <verse number="45" style="v" />Naríñagame joun. “Ninárün jáu, luágu furúmieguarügü lan cátei le madǘgün jubeí joun gürígia, ca lan lǘnabunbei, madǘgün jumúti gíñe nun.” <verse number="46" style="v" />Ábameti joúdin ja máfiougatin lun jasúfurirun ñi lun sun dan, jámeti richáguabaña ligíbugiñe Búngiu, ábame joúdin siélun lun jagúndaarun ñi lun sun dan.</para>
  <chapter number="26" style="c" />
  <para style="s">Aráansejani lun lárügüdǘniwa Jesúsu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mr 14.1-2</ref>; <ref loc="LUK 22:1-2">Lc 22.1-2</ref>; <ref loc="JHN 11:45-53">Jn 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Dan aríñaga láali Jesúsu sun cátei le, ába laríñagun joun láni disípulugu.</para>
  <para style="p">
    <verse number="2" style="v" />—Quei jasúbudiruni, bián wéyu lárigiñe le, ligíame fédu le páscua, áni nedéregerúaba, áu le Wügǘri Garaǘwarügüti, lun nádarawagún luágu gurúwa.</para>
  <para style="p">
    <verse number="3" style="v" />Ába joúndaragun jábutigu fádirigu, arúfudajatiña lilúrudun Moisés, jáma wügǘriña weírigutiña lídan jafíñen juríu tigíbugiñe lúban Gáifasi, fádiri le íñutimaabei. <verse number="4" style="v" />Ñi jaráanseja luágu Jesúsu lun járügüdüni láu yéguaü, lun jáfaruni jilágubei. <verse number="5" style="v" />Jaríñagati.</para>
  <para style="p">—Máma látia fédurugu lueí jachágaragun gürígia.</para>
  <para style="s">Tájuduraguni ában wǘri lábulugu Jesúsu</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mr 14.3-9</ref>; <ref loc="JHN 12:1-8">Jn 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" />Betániañein Jesúsu, lúbiñe Simón lé meja gawágubei gumeín luágu sun lúra, <verse number="7" style="v" />ába tiábin ában wǘri luágun, gámeina tugúya ában lágei ibíñei le weíriti lisérun. Dan luáguñein lan dábula Jesúsu, ába téseruni ibíñei ligía lábulugun. <verse number="8" style="v" />Dan jaríjinbaalin disípulugu cátei le, ába jamágundarun, ába jaríñagun.</para>
  <para style="p">—¿Cámesan leféridirúa le ítara? <verse number="9" style="v" />Gayáraati jamúgagu lalúgurúniwa le luágu sarágu seínsu lun jíderawagún gudémetiña.</para>
  <para style="p">
    <verse number="10" style="v" />Ába lagáambuni Jesúsu le jaríñagubei, ába laríñagun joun.</para>
  <para style="p">—¿Ca uágu jañáwurija tun wǘri to? Cátei buíti le tadǘgübei. <verse number="11" style="v" />Súnwandan yábaña lan gudémetiña júma, ánjein áu, mámaba súnwandan júma nan. <verse number="12" style="v" />Le tadǘgübei wǘri to láu téseruni ibíñei le nuágun, taráanseruñádina lubá nábunúniwa. <verse number="13" style="v" />Ninárün jáu luágu le lan ñí lumuti lapúrichijoúa ugánu luáguti asálbaruni lídan sun uboú, labájüdawagúaba gíñe le tadǘgübei wǘri to, lun larítawagún tuágu.</para>
  <para style="s">Lalúguruni Júdas Jesúsu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mr 14.10-11</ref>; <ref loc="LUK 22:3-6">Lc 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Ába lídin ában jádaangiñe dúusu disípulugu, le gíribei Júdas Iscarióte, adímureja jáma jábutigu fádirigu. <verse number="15" style="v" />Ába laríñagun joun.</para>
  <para style="p">—¿Atiribei jíchugun nun ánjein nedéregera Jesúsu jun?</para>
  <para style="p">Ába jíchugun darándi murúsun pláta lun. <verse number="16" style="v" />Lúmagiñeti óra ligía, ába láluajan Júdas ída lúba lan luwúyeri ledéregeruni Jesúsu joun.</para>
  <para style="s">Lagúmujoún leígin Jesúsu jáma lánigu</para>
  <para style="r">(<ref loc="MRK 14:12-25">Mr 14.12-25</ref>; <ref loc="LUK 22:7-23">Lc 22.7-23</ref>; <ref loc="JHN 13:21-30">Jn 13.21-30</ref>; <ref loc="1CO 11:23-26">1 Co 11.23-26</ref>)</para>
  <para style="p">
    <verse number="17" style="v" />Le furúmiñeti wéyu lídan fédu le ñí lubei teigúa fein magánatu ísi, ába jayábin disípulugu lúmoun Jesúsu, ába jaríñagun lun.</para>
  <para style="p">—¿Jalía babúseera waráanserun lun ñíba lan wadǘgei eígini le lánina páscua?</para>
  <para style="p">
    <verse number="18" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Jeíba ubúrugu, lúbiñe ítaga wügǘri, ábame jaríñagun lun. “Ítara líña laríñagun Maésturu. Yaráfaali nórate, búbiñeba nefédujei páscua jáma náni disípulugu.”</para>
  <para style="p">
    <verse number="19" style="v" />Ába jadǘgüni disípulugu quei laríñaguni Jesúsu joun, ába jaráanseruni eígini le lánina páscua.</para>
  <para style="p">
    <verse number="20" style="v" />Dan le lagúñedunbei, ába lañúurun Jesúsu luágu dábula jáma láni dúusu disípulugu, <verse number="21" style="v" />súnti añája lan eíga, ába laríñagun joun.</para>
  <para style="p">—Ninárün jáu luágu lalúgurubadina lan ában jídaangiñe.</para>
  <para style="p">
    <verse number="22" style="v" />Ábati jajírudagun, ába jagúmeserun álügüdei ában ában.</para>
  <para style="p">—Nabúreme, ¿nugúya funásan?</para>
  <para style="p">
    <verse number="23" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Le éderutu leígan fein núma lídan asíedu, ligiába alúgurana. <verse number="24" style="v" />Nídiña, áu le Wügǘri Garaǘwarügüti, luágu ǘma le uágubei taríñaga Lerérun Búngiu, áni ¡fugíabutia wügǘri le alúgurutina! Buítimaati jamúga lun magǘriajoúagubei lan.</para>
  <para style="p">
    <verse number="25" style="v" />Ábati ladímurejan Júdas, ába lálügüdajan.</para>
  <para style="p">—Maésturu, ¿nugúya funásan?</para>
  <para style="p">Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Ánja, bugúya.</para>
  <para style="p">
    <verse number="26" style="v" />Dan añája lan eíga, ába lanǘgünun Jesúsu fein lújaburugu, ába leteíngiruni Búngiu tuágu, lásun lagúbachagunun, ába líchugunun joun láni disípulugu, aríñageina.</para>
  <para style="p">—Joújuma, núgubu le.</para>
  <para style="p">
    <verse number="27" style="v" />Lárigiñe, ába lárügüdün ában wéru buin táu diweín lújaburugu, ába leteíngiruni Búngiu tuágu, ába lásügüragüdüni joun, aríñageina.</para>
  <para style="p">—Gurájuma lídaangiñe le, sun jugúya. <verse number="28" style="v" />Níta le, le añúuragüdübalin iséri darádu, le gíñe áwiyurubei joun sarágu gürígia lun ferúdunawa lan jafígoun. <verse number="29" style="v" />Naríñajare jun luágu mátundügüyaadina lan diweín daríme wéyu le lúnbei nátunun iséri tuwúyeri diweín júma lídan larúeijan Núguchi Búngiu yágüta siélu.</para>
  <para style="s">Laríñaguni Jesúsu luágu leyéedaguba lan Pédro láu</para>
  <para style="r">(<ref loc="MRK 14:26-31">Mr 14.26-31</ref>; <ref loc="LUK 22:31-34">Lc 22.31-34</ref>; <ref loc="JHN 13:36-38">Jn 13.36-38</ref>)</para>
  <para style="p">
    <verse number="30" style="v" />Lárigiñe jerémujani urému luágu Búngiu, ába joúdin luágu wǘbü Olívos. <verse number="31" style="v" />Ába laríñagun Jesúsu joun láni disípulugu.</para>
  <para style="p">—Sun jugúya, jasándiraguba júngua láu magúraasuni nuágu áriebu le, ladǘga laríñajare tídan Lerérun Búngiu. “Náfarubei joúniri mudún jilágubei, ábame jeréderun mudún chagágu.” <verse number="32" style="v" />Lárigiñeme násaarun lídaangiñe oúweni lúnya nabágaridun, nídiba Galiléa jubáragiñe.</para>
  <para style="p">
    <verse number="33" style="v" />Ába laríñagun Pédro lun.</para>
  <para style="p">—Gayáraati járügüdün súngubei magúraasuni buágu, nugúya no.</para>
  <para style="p">
    <verse number="34" style="v" />Ábati laríñagun Jesúsu lun.</para>
  <para style="p">—Ninárün báu luágu áriebu méme lan le, lubáragiñe layúgurujan gáyu, beyéedaguba náu ǘrüwa weíyaasu.</para>
  <para style="p">
    <verse number="35" style="v" />Ába laríñagun Pédro lun.</para>
  <para style="p">—Gayáraati noúnwen búma, meyéedagunbadina báu.</para>
  <para style="p">Ligía méme gíñe jaríñaga sun disípulugu.</para>
  <para style="s">Layúmuragun Jesúsu lun Búngiu, Getsemaní</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mr 14.32-42</ref>; <ref loc="LUK 22:39-46">Lc 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" />Ábati lachǘlürün Jesúsu jáu láni disípulugu lídoun ában fulásu gíriti Getsemaní, ába laríñagun joun.</para>
  <para style="p">—ñurújuma ya, neíbuga ayúmuragua lun Búngiu yára.</para>
  <para style="p">
    <verse number="37" style="v" />Ába lanǘgüni Pédro jáma bián lirájüñü Zebedéo lúmagua, ába jagúmeserun asándira íruni lúma tigári anígi. <verse number="38" style="v" />Ábati laríñagun joun.</para>
  <para style="p">—Sandítina ában íruni le lánina oúweni tídan nuwáni. Reídei jumá ya, agágudúañu jugúyame núma.</para>
  <para style="p">
    <verse number="39" style="v" />Ábati lídin Jesúsu lubáruaguoún mémeraü, ába lájuduragun láu ligíbu múarugun, ába layúmuragun lun Búngiu ítara.</para>
  <para style="p">—Núguchi, ánjein gayára lubeí, adǘgabá lun masúfurirun náani cátei le lúnbei nasúfuriruni, mámalá quei nabúseerun, queílá babúseerun.</para>
  <para style="p">
    <verse number="40" style="v" />Ábati lagíribudun le ñíjin jabeí láni disípulugu, ába ladáriruniña arúmuga, ába laríñagun lun Pédro.</para>
  <para style="p">—¿Siñátisán buga jeréderun agágudúañu núma ni ában óra? <verse number="41" style="v" />Agágudúañu jumá, ayúmuragua jugúyame, máburujan jumámuga lídoun ínchajoúni lun jeféridiruni jafíñen nuágu. Inárüni luágu ánja tan juwáni lun cátei le buídubei, ánjeinti júgubu, débiliti.</para>
  <para style="p">
    <verse number="42" style="v" />Ábaya lídin luágu libíaman weíyaasu, ába layúmuragun ítara.</para>
  <para style="p">—Núguchi, ánjein siñá lubei masúfurirun náani le lúnbei nasúfuriruni, adügǘwalá bugúndan.</para>
  <para style="p">
    <verse number="43" style="v" />Ábaya lagíribudun, ábaya ladáriruniña láni disípulugu arúmuga ladǘga weírijali lidábu jágu. <verse number="44" style="v" />Ába lígiruniña, ábaya lídin ayúmuragua luágu lǘrüwan weíyaasu, aríñageina méme dimúrei ligía. <verse number="45" style="v" />Ábati lídin le ñíjin jabeí láni disípulugu, ába laríñagun joun.</para>
  <para style="p">—¿Jarúmuguña mémesan, eméraagua jugúya? Chülǘjali óra lun nedéregeruníwa, áu le Wügǘri Garaǘwarügüti, jájaburugun gafígountiña. <verse number="46" style="v" />Sarájuma, queímoun lubároun le lúnbei lalúgurunina, níteeli.</para>
  <para style="s">Janǘgüni Jesúsu adáüra</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mr 14.43-50</ref>; <ref loc="LUK 22:47-53">Lc 22.47-53</ref>; <ref loc="JHN 18:2-11">Jn 18.2-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" />Ñígili Jesúsu adímureja, ligía liábin Júdas, le ábanbei jádaangiñe dúusu disípulugu, jáu sarágu gürígia táu efeín lúma wéwe. Jayábin lueígiñe joúbadina jábutigu fádirigu jáma wügǘriña weírigutiña lídan jafíñen juríu. <verse number="48" style="v" />Aríñagaaliti buga Júdas joun.</para>
  <para style="p">—Le nachúurun, ligía, járügüdeime.</para>
  <para style="p">
    <verse number="49" style="v" />Ábati layárafadun lun Jesúsu, ába laríñagun.</para>
  <para style="p">—¡Buíti gúñoun, maésturu!</para>
  <para style="p">Ába lachúuruni. <verse number="50" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Numáda, ¿ca bálugubei?</para>
  <para style="p">Ábati jayábin, ába járügüdüni Jesúsu, ába janǘgüni adáüra.</para>
  <para style="p">
    <verse number="51" style="v" />Ábati laságarunun ában jádaangiñe láni Jesúsu disípulugu lefeínte, ába láchuguni ában larígei lumúsun fádiri le íñutimaabei. <verse number="52" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Areídaboún befeínte, ladǘga sun ja áfarajatiña táu efeín, táuba gíñe efeín jáfarúa. <verse number="53" style="v" />¿Ibídiñeti bun luágu ánjana lan jamúga busén, gayára lan namúriajan ǘrüwa-wein-díisi-mílu jádaangiñe láni Núguchi ánjeligu, áni loúnajañanu lan jamúga? <verse number="54" style="v" />Lun jamúga nadǘgüni ítara, ¿ída lubági lagúnfulirun le tídaanbei Lerérun Búngiu to aríñaguboun luágu lúnti lan lasúseredun le ítara?</para>
  <para style="p">
    <verse number="55" style="v" />Ábati laríñagun Jesúsu joun mútu jagía.</para>
  <para style="p">—¿Jiábin táu efeín lúma wéwe lun járügüdünina camá jamuga jíwerutina? Ságüñaja wéyu nañúurun témpulurugu jagánagua arúfudaja, madaǘ jumútina. <verse number="56" style="v" />Wel, lasúseredunbei sun le lun lagúnfulirun le jaríñagubei profétagu tídan Lerérun Búngiu.</para>
  <para style="p">Ábati jígiruni sun disípulugu Jesúsu lábugua, ába janúrajan.</para>
  <para style="s">Jesúsu ligíbugiñe líñun-ágei lúrudu</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mr 14.53-65</ref>; Lc 22.54-55, 63-71; Jn 18.12-14, 19-24)</para>
  <para style="p">
    <verse number="57" style="v" />Ja adáürübalin Jesúsu, ába janǘgüni ligíbugiñoun Gáifasi, fádiri le íñutimaabei, le ñí lubei adámurigu jamá arúfudajatiña lilúrudun Moisés jáma wügǘriña weírigutiña lídan jafíñen juríu. <verse number="58" style="v" />Ánjeinti Pédro, falá lumuti dísegiñe darí tübǘrürürugun lúban fádiri le íñutimaabei le ñíjin lubeí lebélura, ába leréderun ñun jáma oúnigirutiña témpulu lun laríjin jalíaba lan lébeda cátei le.</para>
  <para style="p">
    <verse number="59" style="v" />Jáluajati jábutigu fádirigu, jáma sun jíbiri líñun-ágei lúrudu lidúnrun Jesúsu láu iyéeni lun gayáraabei lan jasíadiruni lun loúnwen, <verse number="60" style="v" />madáritiña, láu sun sarágu jáña lan gürígia ñǘdüntiña aríñaga iyéeni luágu. Agúmujoúni, ligía jayábin biáma yéetiña íchiga fe luágu, <verse number="61" style="v" />ába jaríñagun.</para>
  <para style="p">—Aríñagati wügǘri le luágu gayára lan lagǘnrichagunun láni Búngiu témpulu, ábaya lánme laráramagüdǘnun lídan ǘrüwa wéyu.</para>
  <para style="p">
    <verse number="62" style="v" />Ábati laráramun fádiri le íñutimaabei, ába laríñagun lun Jesúsu.</para>
  <para style="p">—¿Moúnabuntíbusan ni cáta? ¿Cáteigi le, le aríñawagúbei buágu?</para>
  <para style="p">
    <verse number="63" style="v" />Reídeiti Jesúsu maníñu. Ábati laríñagun fádiri le íñutimaabei lun.</para>
  <para style="p">—Luágu líri Búngiu le wínwanbei báfiñura lun baríñaguni inárüni. Aríñagabeí woun ánjein amǘrü lubeí Crístubei le Liraǘ Búngiu, le lanúadirubei Búngiu lun lasálbaruniña gürígia uboúagu.</para>
  <para style="p">
    <verse number="64" style="v" />Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Ánja, áu, quei baríñaguni. Aríñagatina gíñe jun luágu jaríjubadina lan, áu le Wügǘri Garaǘwarügüti, ñun lueígiñe loúnwenren Búngiu le Súnti Gabáfu, jaríjubei gíñe niábin lídan juánriñu siélugiñe.</para>
  <para style="p">
    <verse number="65" style="v" />Ábati lajeíridagunun fádiri le íñutimaabei lanáangun, le ligáñi, ába laríñagun.</para>
  <para style="p">—¡Anába láali wügǘri le Búngiu láu lerérun! Mabúseerunjadiwa ámu lun líchugun fe luágu, agáamba jumáali anábuni le laríñagubei, <verse number="66" style="v" />¿ída líña jaríjin lun?</para>
  <para style="p">Ába jaríñagun.</para>
  <para style="p">—Gadúnrunti, lúnti loúnwen.</para>
  <para style="p">
    <verse number="67" style="v" />Ábati jásueraguni ligíbu, buleísei jameí, jíbiri, ába jagáyuajan ligíbuagun, <verse number="68" style="v" />ába jaríñagun lun.</para>
  <para style="p">—Quei amǘrü lan Crístubei, ¡aríñaga beígia ca lan agáyuajabei buágu!</para>
  <para style="p">Jaríñagunbei lun ítara ladǘga gürágu líña lan lágu.</para>
  <para style="s">Laríñagun Pédro luágu ibídiñe lan Jesúsu lun</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mr 14.66-72</ref>; <ref loc="LUK 22:56-62">Lc 22.56-62</ref>; Jn 18.15-18, 25-27)</para>
  <para style="p">
    <verse number="69" style="v" />Súnti lasúseredun sun cátei le, ñun líña Pédro boúgudi tübǘrürürugu lúban fádiri le íñutimaabei, ába tiábin ában esériwijatu luágun, ába taríñagun lun.</para>
  <para style="p">—Bugúya, lúmañadibútia giñéñaja Jesúsu le Galiléana.</para>
  <para style="p">
    <verse number="70" style="v" />Ába leyéedagun Pédro jagíbugiñe súngubei, ába laríñagun.</para>
  <para style="p">—Ibídiñeti nun ca lan uágu badímureja.</para>
  <para style="p">
    <verse number="71" style="v" />Leíbuga yebe Pédro luágun béna, ligía taríjini ábanya, ába taríñagun joun ja ñíbaña.</para>
  <para style="p">—Eyéri le, lúmañajañein gíñe Jesúsu le Nazarétna.</para>
  <para style="p">
    <verse number="72" style="v" />Ábaya leyéedagun Pédro láu fiñún, ába laríñagun.</para>
  <para style="p">—Ibídiñeti wügǘri ligía nun.</para>
  <para style="p">
    <verse number="73" style="v" />Murúsun lueígiñe, ába jayábin ja ñíbaña lúmoun Pédro, ába jaríñagun lun.</para>
  <para style="p">—Inárüni luágu ában lan jádaangiñe amǘrü, arijúati luágu ligáburi badímurejan.</para>
  <para style="p">
    <verse number="74" style="v" />Ába lagúmeserun íñaragua lúngua aríñaga láu fiñún.</para>
  <para style="p">—¡Ibídiñeti gürígia ligía nun!</para>
  <para style="p">Lídan méme óra ligía, ába layúgurujan ában gáyu. <verse number="75" style="v" />Ábati larítagun Pédro luágu le laríñagubei Jesúsu lun. “Beyéedaguba náu ǘrüwa weíyaasu lubáragiñe layúgurujan gáyu.” Ába láfuridun Pédro ñígiñe, ába layájuajan láu igárigu.</para>
  <chapter number="27" style="c" />
  <para style="s">Ledéregerúniwa Jesúsu lun Piláto</para>
  <para style="r">(<ref loc="MRK 15:1">Mr 15.1</ref>; <ref loc="LUK 23:1-2">Lc 23.1-2</ref>; <ref loc="JHN 18:28-32">Jn 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Dan larúgadunbei, ába jadámuridagun sun jábutigu fádirigu jáma wügǘriña weírigutiña lídan jafíñen juríu aríja cába lan jadǘga lun lasíadirúniwa Jesúsu. <verse number="2" style="v" />Ába janǘgüni gürágu, ába jedéregeruni lun Póncio Piláto le gumádimati.</para>
  <para style="s">Loúnwen Júdas</para>
  <para style="p">
    <verse number="3" style="v" />Dan le laríjinbei Júdas, le alúgurubalin Jesúsu, luágu siádi jamáali lan Jesúsu lun loúnwen, ába laságürijan, ába láguyugüdüni darándi murúsun pláta ligía joun jábutigu fádirigu lúma joun wügǘriña weírigutiña, <verse number="4" style="v" />ába laríñagun joun.</para>
  <para style="p">—Afígounjaadina láu nedéregerun ában wügǘri madúnrunti lun loúnwen.</para>
  <para style="p">Ába jaríñagun lun.</para>
  <para style="p">—¿Cámegi le warúma? ¡Bugúya lun baríjini líra!</para>
  <para style="p">
    <verse number="5" style="v" />Ába lachágaruni Júdas seínsu ñi témpulurugu, ába lídin átigiragua lúngua.</para>
  <para style="p">
    <verse number="6" style="v" />Ába jabúduni jábutigu fádirigu seínsu ligía, ába jaríñagun.</para>
  <para style="p">—Siñáti wíchuguni seínsu le tídoun gáfu to lágei liseínsuna Búngiu ladǘga lebégi oúweni.</para>
  <para style="p">
    <verse number="7" style="v" />Ába júaradun lun lagáñijoún lufúlasun ában wügǘri le adáagubei barámbi láu seínsu ligía lun jábunajoún teréncha ñi. <verse number="8" style="v" />Ligía Lufúlasun Jítaü lubeí líribei fulásu ligía chülǘ lúmoun dan le. <verse number="9" style="v" />Ítara líña lagúnfulirun lé meja laríñagubei proféta Jeremías. “Barǘ jamuti darándi murúsun pláta ligía, ebégi le jíchugubei Israelítagu luágu wügǘri ligía, <verse number="10" style="v" />ába jagáñijani lufúlasun ában wügǘri le adáagubei barámbi láu, quei laríñaguni Nabúreme nun.”</para>
  <para style="s">Jesúsu ligíbugiñe Piláto</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mr 15.2-5</ref>; <ref loc="LUK 23:3-5">Lc 23.3-5</ref>; <ref loc="JHN 18:33-38">Jn 18.33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" />Barǘwati Jesúsu ligíbugiñoun gumádimati, le gíribei Piláto, le álügüdübalin.</para>
  <para style="p">—¿Amǘrüsan Jarúeitebei Juríu?</para>
  <para style="p">Ába laríñagun Jesúsu lun.</para>
  <para style="p">—Ánja, áu quei baríñaguni.</para>
  <para style="p">
    <verse number="12" style="v" />Dán buriti jíchugun jábutigu fádirigu jáma wügǘriña weírigutiña lidúnrun, moúnabuntija Jesúsu ni cáta. <verse number="13" style="v" />Ábati laríñagun Piláto lun.</para>
  <para style="p">—¿Magáambun bumútisan le jaríñagubei buágu?</para>
  <para style="p">
    <verse number="14" style="v" />Moúnabunti Jesúsu ni cáta, ábati laweíridun lanígi gumádimati.</para>
  <para style="s">Lasiádirún Jesúsu lun loúnwen</para>
  <para style="r">(<ref loc="MRK 15:6-20">Mr 15.6-20</ref>; <ref loc="LUK 23:13-25">Lc 23.13-25</ref>; <ref loc="JHN 18:38-19:16">Jn 18.38–19.16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Gagáburi lumúti mejáti gumádimati lígiragüdǘn ában adaürǘti joun gürígia lídan fédu, furúmieguarügü adaürǘti le jamúriajan lúma. <verse number="16" style="v" />Ñíñeinti ában adaürǘti, díseti leíbaajan líri, gíriti Barabási, <verse number="17" style="v" />dánti le adámuriñujaña lan sun gürígia, ába lálügüdüniña Piláto.</para>
  <para style="p">—¿Ca jabúseerubei nígiragüdün jun, Barabási, ódi Jesúsu le únbei laríñawagua Crístu?</para>
  <para style="p">
    <verse number="18" style="v" />Líridubalin gíñe Jesúsu ladǘga subúdi láali lan luágu ladǘga lan jagímugan lun jedéregerei.</para>
  <para style="p">
    <verse number="19" style="v" />Sun ñun lan Piláto luágu lála le lánina agúseruni, ába toúnajan lúmari aríñaga lun. “Madǘgabá ni cáta láu gürígia úaraguati le, ladǘga gewéneditina buga ában uwénedi wuríbati áriebu buga ladǘga gürígia le.”</para>
  <para style="p">
    <verse number="20" style="v" />Ába jádaruni jábutigu fádirigu jáma wügǘriña weírigutiña jádoun gürígia lun jamúriajan lun láfuridun Barabási, lun lafarún Jesúsu. <verse number="21" style="v" />Ábaya ladímurejan gumádimati joun sun gürígia jagía, ába laríñagun joun.</para>
  <para style="p">—¿Ca jádaangiñe biángubei jabúseerubei lun nígiragüdüni jun?</para>
  <para style="p">Ába jaríñagun.</para>
  <para style="p">—Barabási.</para>
  <para style="p">
    <verse number="22" style="v" />Ába laríñagun Piláto joun.</para>
  <para style="p">—¿Cábati nadǘga láu Jesúsu le únbei laríñawagúa Crístu?</para>
  <para style="p">Ába joúnabun súngubei.</para>
  <para style="p">—¡Dáguabeí luágu gurúwa!</para>
  <para style="p">
    <verse number="23" style="v" />Ába laríñagun Piláto joun.</para>
  <para style="p">—¿Cáti wuríbati ladǘgübei?</para>
  <para style="p">Ábatima jagúaragun.</para>
  <para style="p">—¡Dáguabeí luágu gurúwa!</para>
  <para style="p">
    <verse number="24" style="v" />Dan le laríjinbalin Piláto luágu siñá lan ladǘgün ni cáta lueídügüya chagáguaü, ába lamúriajan dúna, ába lachíbuni lújabu jagíbugiñe gürígia, aríñageina.</para>
  <para style="p">—Máma áu lúnbei naríjin láu loúnwen wügǘri madúnrunti le, jugúya lun jaríjini ñi.</para>
  <para style="p">
    <verse number="25" style="v" />Ába jaríñagun sun gürígia.</para>
  <para style="p">—¡Wagía jáma warájüñü, wanǘgüba furúmieguarügü dúru wawoúguoun luágu loúnwen!</para>
  <para style="p">
    <verse number="26" style="v" />Ábati lígiragüdüni Piláto Barabási, ába loúnajan abeíchei Jesúsu, ába ledéregeruni lun ládarawagún luágu gurúwa.</para>
  <para style="p">
    <verse number="27" style="v" />Lárigiñe, ába janǘgüni lisúdaaranigu gumádimati Jesúsu tídoun lúban Piláto, ába joúndaraguagüdüniña sun súdaara geyégua láu. <verse number="28" style="v" />Ába jarágachunun lanáangun, ába jíchugun ában anáanguni funátu luágu, <verse number="29" style="v" />ába jíchugun ában rídi láuti jíyu lábulugu, lúma ában mabúru lújaburugu le loúnwenren. Ábati jájuduragun ligíbugiñe, ába jéjerajan láu, ába jaríñagun lun.</para>
  <para style="p">—¡Gabágarilá Jarúeite Juríu!</para>
  <para style="p">
    <verse number="30" style="v" />Ába gíñe jásueraguni, janǘgeija mabúru ligía, jíchaaguei lábulugu. <verse number="31" style="v" />Lárigiñe jéjerajan láu ítara, ába jagídarunun anáanguni funátu lueí, ába jadáürünun lanáangun luágu. Ába janǘgüni lun ládarawagún luágu gurúwa.</para>
  <para style="s">Ládarawagún Jesúsu luágu gurúwa</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mr 15.21-32</ref>; <ref loc="LUK 23:26-43">Lc 23.26-43</ref>; <ref loc="JHN 19:17-27">Jn 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" />Dan le áfurideina jáña lan, ába jadúnragun lúma ában wügǘri Cirénena, gíriti Simón, ába jafósuruni lun lanǘgüni lugúruwan Jesúsu.</para>
  <para style="p">
    <verse number="33" style="v" />Ítara líña jachǘlürün lídoun ában fulásu gíriti Gólgota, líla líra, Lufúlasun Lábu Ichǘgü. <verse number="34" style="v" />Ñi jíchiga diweín láu árani tídan lun Jesúsu lun látunun, joúcharügü lumútu, mátun lumútu.</para>
  <para style="p">
    <verse number="35" style="v" />Dan le dágua jamáali luágu gurúwa, ába jájurerun súdaara ubúnuruni lun jafánreinjanun lanáangun Jesúsu jádaangua. Ítara líña lagúnfulirun lé meja labǘrüjabei proféta. “Ájureratiña ubúnuruni lun jaríjin cába lan jádaangiñe erédera táu nanáangun.” <verse number="36" style="v" />Ába jañúurun ñi lun joúnigiruni. <verse number="37" style="v" />Ába jíchugun ában abǘrüjoúni loúgiñe lichǘgü le ñí lubei laríñaga ca lan lidúnrunbei. Abǘrüjoúni ligía ítara líña. “Jesúsu le, le jarúeitebei juríu.”</para>
  <para style="p">
    <verse number="38" style="v" />Dáwaguatiña gíñe bián jíwerutiña luágu gurúwa lúma, ában lueígiñe loúnwenren, ában lueígiñe lubaǘna. <verse number="39" style="v" />Já buriti ásügürübaña ñígiñe, ába janábuni, ába jánjingichuni jachǘgü, <verse number="40" style="v" />aríñageina.</para>
  <para style="p">—Bugúya le gayáraabei bágurunun témpulu ábaya baráramagüdünun lídan ǘrüwa wéyu, sálbaguabá búngua. Ánjein Liraǘ bubei Búngiu, raríba lueígiñe gurúwa.</para>
  <para style="p">
    <verse number="41" style="v" />Ítara líña gíñe jéjerajan jábutigu fádirigu jáma arúfudajatiña lilúrudun Moisés, fariséogu, jáma wügǘriña weírigutiña, láu, ábaja jaríñagun jámagua.</para>
  <para style="p">
    <verse number="42" style="v" />—Sálbati ámu, ánjein lúngua, siñáti lasálbaragun. Ánjein ligía lubeí Jarúeitebei Israelítagu, raríla lueígiñe gurúwa, afíñe wamámuga luágu. <verse number="43" style="v" />Rúlaali lafíñen luágu Búngiu, sálbaleíti Búngiu guetó ánjein inárüni lubeí luágu jínsiñe lan lun, quei aríñagaali lan woun luágu Liraǘ lan Búngiu.</para>
  <para style="p">
    <verse number="44" style="v" />Anába jamúti gíñe jíwerutiña ja dáwaguñubaña luágu jagúruwan úara lúma.</para>
  <para style="s">Loúnwen Jesúsu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mr 15.33-41</ref>; <ref loc="LUK 23:44-49">Lc 23.44-49</ref>; <ref loc="JHN 19:28-30">Jn 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" />Ábati labúrigadun sun fulásu lúmagiñe amídirugu darí ladaǘnrün ǘrüwa rábounwéyu. <verse number="46" style="v" />Queí buri óra méme ligía, ába lagúaragun Jesúsu jére.</para>
  <para style="p">—Elí, Elí, ¿láma sabáctani? —líla líra. Nubúngiute, Nubúngiute, ¿cásan uágu bígirana?</para>
  <para style="p">
    <verse number="47" style="v" />Ñíñanu agáambuti jádaangiñe ja ñíbaña, ába jaríñagun.</para>
  <para style="p">—Lagúajaña wügǘri le lun proféta Elías.</para>
  <para style="p">
    <verse number="48" style="v" />Ába lídin ában jádaangiñe eíbaagueina anǘga ában mudúsi, lárigiñe ladǘdüragüdüni táu diweín garǘjütu ába líchuguni luágu ában wéwe, ába línchunun lun lun lachúrunun. Ába lachúrunun. <verse number="49" style="v" />Ába jaríñagun ja jíbiri.</para>
  <para style="p">—Ígirabeí, waríja ánjein ñǘbin Elías asálbarei.</para>
  <para style="p">
    <verse number="50" style="v" />Ábaya ladǘgün Jesúsu ában agúaraguni jéreti, ábati loúnwen. <verse number="51" style="v" />Lídan óra ligía, ába tajeíridagun tubélun témpulu lídan bián murúsun, íñugiñe lun ǘnabun. Ába ladágarun ában járabaganáli, ába láwarajan dǘbü. <verse number="52" style="v" />Ába lánjunrenchúnga umúajaü, águyuguatiña sarágu jádaangiñe afíñetiña luágu Búngiu já meja jiláguaañábaña. <verse number="53" style="v" />Ába jáfuridunga lídaangiñe jamúaja lárigiñe lásaarun Jesúsu lídaangiñe oúweni. Ába jebélurun lídoun ubúrugu Jerusalén le biníwabei, le ñí lubei jaríjaña sarágu gürígia.</para>
  <para style="p">
    <verse number="54" style="v" />Léti jábuti súdaara jáma súdaara ja oúnigirubalin Jesúsu, dan jasándirunbalin járabaganáli lúma dan jaríjinbaalin líbiri buri cátei le asúseredubei, ába janúfudedagun sarágu, ába jaríñagun.</para>
  <para style="p">—Inárüni, Liraǘ Búngiu wügǘri le.</para>
  <para style="p">
    <verse number="55" style="v" />Ñíñanu sarágu würÍña aríagua dísegiñe, ja afálarubalin Jesúsu lúmagiñe Galiléagiñe íderagua jameí. <verse number="56" style="v" />Ñíñoun María Magdaléna jádan, María to lúguchu Jacóbo lúma José, túma jáguchu lirájüñü Zebedéo.</para>
  <para style="s">Labunúniwa Jesúsu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mr 15.42-47</ref>; <ref loc="LUK 23:50-56">Lc 23.50-56</ref>; <ref loc="JHN 19:38-42">Jn 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" />Dan le agúñedeina líña lubeí, ába liábin ában wügǘri rísiti gíriti José, lídaangiñeti fulásu le gíribei Arimatéa, jádaangiñeti gíñe ja afálarubalin Jesúsu. <verse number="58" style="v" />Ábati lídin aríjei Piláto, ába lamúriajani lúgubu Jesúsu lúma. Ábati laríñagun Piláto lun líchugúniwa lun, <verse number="59" style="v" />ába lanǘgüni José, ába loúburaguni tídan ában gamísa jarúmatu. <verse number="60" style="v" />Ába líchuguni lídoun lumúaja iséri lé yebe lachígagüdübei lubárua luágu dǘbü. Lárigiñe ladáuruni umúajaü láu ában dǘbü weíriti luágu lubéneri, ába lídin. <verse number="61" style="v" />Ñíñounti María Magdaléna túma to ában María ñun ligíbugiñe umúajaü.</para>
  <para style="s">Oúnigirutiña ligíbugiñe lumúaja Jesúsu</para>
  <para style="p">
    <verse number="62" style="v" />Larúgan, lárigiñe aráansejani lubá luwéyuri eméraaguni, ába joúdin jábutigu fádirigu jáma fariséogu aríjei Piláto, <verse number="63" style="v" />ába jaríñagun lun.</para>
  <para style="p">—Wábuti, jarítagua wamúti luágu aríñaga lán meja yéeti ligíra dán meja moúnwengili luágu lásaaruba lan luágu lǘrüwan wéyu lárigiñe loúnwen. <verse number="64" style="v" />Oúnajagubeibá achoúrurei umúajaü daríme lǘrüwan wéyu, mayábin jamámuga láni disípulugu áriebu íwerujei lúgubu, ábame jaríñagun joun gürígia luágu saráali lan. Weíritimaajalímeti lagúmujoún iyéeni le sügǘ láu le furúmiñeti.</para>
  <para style="p">
    <verse number="65" style="v" />Ába laríñagun Piláto joun.</para>
  <para style="p">—Barǘjuma fiú súdaara, jeíba choúru jumeí umúajaü le lubuídun-ágei juáraati.</para>
  <para style="p">
    <verse number="66" style="v" />Ábati joúdin, ába jachoúruruni dǘbü le luágubei umúajaü, ába jígiruniña súdaara lun joúnigiruni.</para>
  <chapter number="28" style="c" />
  <para style="s">Lásaarun Jesúsu lídaangiñe oúweni</para>
  <para style="r">(<ref loc="MRK 16:1-8">Mr 16.1-8</ref>; <ref loc="LUK 24:1-12">Lc 24.1-12</ref>; <ref loc="JHN 20:1-10">Jn 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Dan le lásügürünbei luwéyuri eméraaguni áni arúgadeina líña dimáasu, ába joúdin María Magdaléna túma to ában María aríjei umúajaü. <verse number="2" style="v" />Sódini, ába ladágarun ában járabaganáli jéreti óra ligía láu larárirun ában láni Wabúreme ánjeli siélugiñe, ába liábin luágun umúajaü, ába lagídaruni dǘbü le áubei ladaurúa, ába lañúurun luágu. <verse number="3" style="v" />Miríti ánjeli ligía quei ában labírijanoúga, tiábin lanáangun, jarú jarú. <verse number="4" style="v" />Dan le jaríjinbalin súdaara, ába jadádagarun láu anúfudei, ába jeréderun camá jiláguaaña. <verse number="5" style="v" />Ábati laríñagun ánjeli ligía joun würíña jagía.</para>
  <para style="p">—Manúfude jumá. Subúsiti nun luágu jáluajañein lan Jesúsu le ádarawagúbei luágu gurúwa. <verse number="6" style="v" />Úati ya, saráali quei laríñaguni. Jigoúgu jaríjei fulásu le ñíjin lubeí líchugúa, <verse number="7" style="v" />ábame jídin furése, ábame jaríñagun joun láni disípulugu luágu saráali lan, luágu níngiran lan jubá jubá Galiléoun, ñíba jaríjei. Niján ugánu lé buga lúnbei naríñaguni jun.</para>
  <para style="p">
    <verse number="8" style="v" />Ába joúdin würíña jagía oúfudagueina, láu anúfudei lúma sarágu ugúndani, ába joúdin eíbaagueina aríñagei joun disípulugu. <verse number="9" style="v" />Súnti añája lan luágu ǘma, ligía larúfudagun Jesúsu lúngua joun, ába labúsurun joun. Ábati jayárafadun lun, ába jájuduragun lun, ába joúburuni lugúdi. <verse number="10" style="v" />Ába laríñagun joun.</para>
  <para style="p">—Manúfude jumá. Jeíba awísaraña nánigu lun joúdin Galiléoun, luágu ñíba lan jaríjana.</para>
  <para style="s">Cátei le jabájüdagubei súdaara</para>
  <para style="p">
    <verse number="11" style="v" />Dan le joúdiña lubeí würíña, ligía joúdin jádaangiñe súdaara ja oúnigirubaña, ába joúdin ubúrugu, ába jabájüdaguni le asúseredubei joun jábutigu fádirigu. <verse number="12" style="v" />Ába joúdin ábutigu ja adímureja jáma wügǘriña weírigutiña lídan jafíñen juríu lun jebélurun jáma lídoun ában úarani, ába jíchugun sarágu seínsu joun súdaara, <verse number="13" style="v" />ába jaríñagun joun.</para>
  <para style="p">—Jaríñagame luágu dan lan le anjǘnja lan arúmuga áriebu, ába lan jayábin láni Jesúsu disípulugu, ába jíwerujani lúgubu. <verse number="14" style="v" />Ánjein lasúbudira gumádimati cátei le, wadímurejaba luágu jáni fuleísei lúma lun madügǘn lan ni cáta jáu.</para>
  <para style="p">
    <verse number="15" style="v" />Ábati jerésibiruni súdaara jagía seínsu, ába joúdin adǘgei le uágubei laríñawagúa joun. Ítara liñáti jaríñaguni juríu chülǘ lúmoun dan le.</para>
  <para style="s">Líchugun Jesúsu jadásin disípulugu</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mr 16.14-18</ref>; <ref loc="LUK 24:36-49">Lc 24.36-49</ref>; <ref loc="JHN 20:19-23">Jn 20.19-23</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />Ába lubeíti joúdin únsu disípulugu Galiléoun luágu wǘbü lé meja uágubei laríñaga Jesúsu joun lun joúdin. <verse number="17" style="v" />Dánti le jaríjinbalin Jesúsu, ába jájuduragun lun, láu sun añájein lan jádaangiñe, loúguati jafíñen luágu ligía lan. <verse number="18" style="v" />Ába liábin Jesúsu jawágun, ába laríñagun joun.</para>
  <para style="p">—Rúaali sun ubáfu nun siélu lúma uboúagu. <verse number="19" style="v" />Jeíbati jabǘgürü gürígia ja lílana sun fulásu, adǘga jumáña nánime disípulugu, badíseigüda jumáña lídan líri Búngiu Úguchili, Búngiu Irájü, lúma líri Sífiri Sándu. <verse number="20" style="v" />Arúfudaja jugúyame joun lun gagáambadi jamá lun sun le uágubei naríñaga jun. Subúdi jumeí luágu anájein lan júma ságü wéyu daríme lagúmuchun uboú. Ítaralá.</para>
</usx>