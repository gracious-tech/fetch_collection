<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Margi Tiwi Ənga Tǝm [mfm]</book>
  <para style="h">LUKA</para>
  <para style="toc3">Luk</para>
  <para style="toc2">Luka</para>
  <para style="toc1">Ndǝshigu Sara Wu Tsa Luka</para>
  <para style="mt2">Ndǝshigu Sara Wu Tsa</para>
  <para style="mt1">Luka</para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="s1">Sǝra Mǝliya Luka Tsǝfǝri Najaka Sau</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>Nji gangǝ ɗa aga nda tsǝfǝri, sǝra ndǝ nggari ɗarkǝr wu pama ˈya. <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>Ndǝ tsǝfǝri sǝra ˈyi nggari sara ara njira sǝ kǝ ɗa wu liya nda tsu kaɗǝu, ǝnga ndǝ tǝtǝlna ndǝr Hyal tsu. <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>Tiyafulusu<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Sǝra thlǝmǝ kǝ cabiya ca ngǝ “Ndǝr yiwu Hyal.” </char><char style="ft" closed="false">Tsamiya wu: </char><char style="xt"><ref loc="ACT 1:1">TCama 1:1</ref></char>.</note> ndǝ dǝgal, ǝnggǝra yi tsambiya sǝˈyar kǝ patǝu ǝnga hangǝkal, ca ngǝ ɗa yi lari a ɗar tsaˈa, ya tsǝfǝri ngǝ ǝnggǝra sǝˈyar kǝ ɓau, <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>aga ga sǝnbiya jirkura sǝˈyar kǝ ǝnggǝra nji highiɓǝri ngau.<verse eid="LUK 1:4"/></para>
  <para style="s1">Nji Nana Ənggǝra Nju Nda Ya <optbreak/> Yahwana Ndǝr Mǝl Baɓǝtizǝma</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>Wu pǝci kǝra Hirudusu a vǝr sǝm tǝlkur nǝr ˈyiˈyir Yahudi, vanyi pubu aˈyi kǝra nja ngga ǝnga Zakariya. Naja pubu nǝ miya umbwa nǝ Abijanu. Thlǝmǝr mala nyi ca ngǝ Alisabatu, ǝnga ji biya sara wu culi gǝ Haruna. <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>Nanda gyapǝu, ndǝ nggya mǝnahǝu wu mwar Hyal, ndǝ ɓǝlari patǝkura sǝra Hyal na nja mǝl. <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>Ama nandǝ uya ya mai, ara Alisabatu ciri nga ja, ǝnga ǝtsu nji hahal nga nda gyapǝu.<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>Vanyi pǝci, Zakariya vǝr mǝl thlǝr nyi nǝ pubu a gwu ki Hyal, ǝnggǝra pǝcir nǝ miya umbwar nda shili. <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>Wu pǝci kau, ǝnggǝra sǝr ciji nǝ pubu cabiya, Zakariya nga nji caɗǝbiya, aga ja gu ki Hyal aga gwa nggyi sǝ kisǝu. <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>Kabangǝkǝ nji dadaɓau kǝra a biya, nda vǝr ndǝr anǝ Hyal wu pǝci kǝ ja vǝr nggyi sǝ kisǝ kau.<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>Kukuthlǝu kǝ waladi Thlagǝ canǝ nyi kǝr, ji taˈyi lagu mazǝma vir nggyi sǝ kisǝ kau. <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>Ənggǝra Zakariya lari waladi kau, kǝ hivǝr mbari nyi gagaɗau. <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>Ama kǝ waladi kǝ na anǝ nyi, “Zakariya, a sara ga hivǝr mai! Hyal, a nggari kǝdi ngau, kabangǝkau, mala ngǝ Alisabatu wu nda yabiya ngǝ zǝr sal. Gu nda nǝ nyi thlǝmǝ Yahwana. <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>Ma nji yabiya nyi, gu nda ɗa ǝnga ɗǝfu cicau ǝnga huɗǝ pipida gagaɗau, abangau ngǝ alenyi nji gangǝ tsu. <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>Zǝr kǝ ju nda ɗa ndǝ dǝgal wu mwar Hyal. Naji wu nda sa ˈyimir wur inabi mai.<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Njir Yahudiya wu mǝl najaka sau sara wu wur inabi aga sa, ama ma nji piyari ji ɓǝliya sar ba ja mwalnakǝr ǝnggǝr padlau.</char></note> Nju nda nyana nyi ǝnga Mambǝl Cicau tsu ja wu ta mǝnyi. <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>Naja ngu nda shabiya njir Izirayila gangǝu a shili ara Hyal Thlagǝri nda. <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>Ju tǝrabiya a dumwar Thlagǝu, ju mǝl thlǝr nyi wu mambǝl ǝnga dǝnama ǝnggǝr nabi Iliya. Ju shili ǝnga nggya jamǝ wu pama tadaˈyar ǝnga wazhar nda. Ju nda shabiya njira kǝra ɓǝlari sǝra tsaˈa, aga nda ɗa nji hangǝkal, lagu kǝ nga ju nda mǝliya nda tsaˈa anǝ Thlagǝr nda.”<verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>Kǝ Zakariya na anǝ waladi, “Abari nga ya nda sǝni abǝr sǝ kǝ gǝ na kǝ wu nda ɗa? Kǝja nayi ndǝ hahal nga yau, mala ɗa tsu abangǝ nga ja.”<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>Waladi na, “Nayi ngǝ Jibrayilu, ya vǝr taˈyi wu mwar Hyal. Hyal ngǝ sǝwa ɗa aga ya sa nar ngǝ ndǝr kǝ mǝsahǝ gagaɗǝ kau. <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>Ama kǝja ga nggǝl ri ara hǝnggǝri ǝnga ndǝr kau, kǝra wu nda ɗa jiri ma pǝci ka ɗari. Agabangau, tsu gu ndǝr mai kǝl ma sǝ kǝ a nyabiyar dzau.”<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>Nji kǝra a biya nda vǝr sǝkǝ biyar Zakariya, nda vǝr ɗǝnga mi ngǝ ɗa ji ɓǝliya sar a gwu ki Hyal abanga? <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>Pǝci kǝra ji nda biya tsu ju sǝni ndǝr mai, ǝnggau, ba ndǝ sǝni abǝr a lari ja sǝ dǝdǝgur a gwu ki Hyal kau. Kǝ ji dumwa ǝnga ndǝr anǝ nda ǝnga tsi, ama naja sǝni ndǝr ǝnga miya ja mai.<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>Ənggǝra pǝcir thlǝr nyi kuɗau, ba ji sha a ndu ki. <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>Aˈyi ɓǝliya sar mai, kǝ mala nyi Alisabatu hǝri huɗǝu, kǝ ji mbunakǝr nǝ hya tǝfu wu ki naji biya mai. <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>Alisabatu dzǝgwa na, “Thlagǝ a mǝliya ɗar sǝ dǝgal wu yukuɗu, ǝnga ji tǝhuɗǝ ǝgya yau, ji hǝna sǝ sǝsǝli kǝra ar kǝra yau wu pama nji.”<verse eid="LUK 1:25"/></para>
  <para style="s1">Waladi Nana Ndǝshigu Nǝ Ya Yesu</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>Ənggǝra Alisabatu mǝliya hya kwa ǝnga huɗǝu, kǝ Hyal sǝwa waladi Jibrayilu a ndu vanyi mǝlmǝ wu Galili nja ngga ǝnga Nazǝratu. <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>Ji sǝwa nyi ǝnga ndǝshigu mǝsahǝu a ndara kwapǝliyagǝ kǝra alkawal mbamba nǝ hǝ dzǝ aˈyi wu pama nda ǝnga vanyi ndǝ kǝra nja ngga ǝnga Yusufu, sara wu culi gǝ tǝl Dawuda. Thlǝmǝr kwapǝliyagǝ kǝ ca ngǝ Maryamu. <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>Ənggǝra waladi kǝ shili ǝgya ja, kǝ ji na, “Nja vǝr usa ngau! Thlagǝ aˈyi ja ǝnga gau, naja tsu a fǝnggǝr ngǝr ja barka.”<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>Ənggǝra Maryamu nggari usa dzǝ kau, kǝ sǝ kǝ ɓwanǝ nyi kǝr ba fuwa nyi wu ɗǝnga sǝ gagaɗau, ja vǝr ɗǝnga wa thlǝmǝ najaka usa dza. <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>Kǝ waladi kǝ na anǝ nyi, “Maryamu, a sara ga hivǝr mai, arya nagǝ a uyar gǝ mayiwakur ara Hyal.<verse eid="LUK 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 1:31"/>“Kǝja gu nda hǝri huɗǝu,</para>
  <para style="q2" vid="LUK 1:31">gu yabiya zǝr sal,</para>
  <para style="q2" vid="LUK 1:31">gu nda nǝ nyi thlǝmǝ Yesu.<verse eid="LUK 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 1:32"/>Ju nda ɗa ndǝ dǝgalǝu,</para>
  <para style="q2" vid="LUK 1:32">ǝtsu nju nda ngga nyi ǝnga</para>
  <para style="q2" vid="LUK 1:32">Zǝr Hyal dǝgal gagaɗau.</para>
  <para style="q1" vid="LUK 1:32">Hyal Thlagǝ wu nda nǝ nyi</para>
  <para style="q2" vid="LUK 1:32">vir nggya nǝr tǝlkur</para>
  <para style="q2" vid="LUK 1:32">nǝ ǝji nyi Dawuda.<verse eid="LUK 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 1:33"/>Ju nda sǝm tǝlkur nyi</para>
  <para style="q2" vid="LUK 1:33">ar kǝra ki Yakubu baˈanuwa,</para>
  <para style="q1" vid="LUK 1:33">tǝlkur nyi tsu aˈyi wu nda kuɗǝ mai!”<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>Kǝ Maryamu na anǝ waladi, “Abari ngǝ sǝka sǝn ɗa, kǝja nayi saya sǝni ndǝ sal maya?”<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>Kǝ waladi shaɗǝwa nyi, ji na,</para>
  <para style="q1" vid="LUK 1:35">“Mambǝl Cicau</para>
  <para style="q2" vid="LUK 1:35">wu nda gyar kǝra gau,</para>
  <para style="q1" vid="LUK 1:35">dǝnama nǝ Hyal Kǝra Di</para>
  <para style="q2" vid="LUK 1:35">wu nda mbuya ngǝ tsu.</para>
  <para style="q1" vid="LUK 1:35">Agabangǝ zǝr kǝ gu</para>
  <para style="q2" vid="LUK 1:35">nda ya kau,</para>
  <para style="q1" vid="LUK 1:35">nju nda na anǝ nyi</para>
  <para style="q2" vid="LUK 1:35">ndǝ cicau, naja ngǝ Zǝr Hyal.<verse eid="LUK 1:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="LUK 1:36"/>“Kǝja Alisabatu kwamǝ ngau, kǝra nji na, naji wu ya mai, kabangǝkǝ huɗǝ hya kwa ngǝ ara ja, wu hahalkur nyi kau, <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ara sǝr kari nyi kǝr anǝ Hyal aˈyi mai.”<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>Əngwar Maryamu, “Nayau, mafa Hyal ngau, bǝgǝ ja ɗa anǝ ɗa ǝnggǝra gǝ na kau.” Ənggau, kǝ waladi kǝ maˈyi sǝ nyi.<verse eid="LUK 1:38"/></para>
  <para style="s1">Maryamu Maˈyi A Nda Usa Alisabatu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>Ayukuɗa pǝci kushu, kǝ Maryamu pabǝri kǝrnyi, kǝ ji maˈyi ǝnga kusa, a ndu vanyi mǝlmǝ nǝr ˈyiˈyir Yahudi kǝra wu pama mau. <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>Ənggǝra ji shili wu mǝlmǝ kau, kǝ ji vu ki Zakariya, ji vuwa usar Alisabatu. <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>Ənggǝra Alisabatu nggari usa dzǝ kau, kǝ zǝr kǝra gwu ta Maryamu ɗa mumuɗǝu, ǝnggau, kǝ Alisabatu nyau ǝnga Mambǝl Cicau. <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>Kǝ ji hyaˈana ɗahǝu ǝnga dǝnama ji na, “Nagǝ ǝnga barka wu pama mathlǝkǝˈyi, Zǝr kǝra gu nda ya kǝ tsu ǝnga barka nga ja! <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>Abari ngǝ mayiwakur kǝ sǝni shili anǝ ɗa, patǝ ǝkkǝˈyi miya Thlagǝ ɗa, a shili ǝgya ya? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>Ənggǝra yi nggari usa dzǝ ngau, ngǝ zǝr kǝra gwu ta yi ɗa mumuɗǝu ara huɗǝ pipida. <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>Ndǝr barka nga gau ara gǝ hǝnggǝri abǝr sǝ kǝ Thlagǝ nana kǝ wu ɗa ǝnga jiri.”<verse eid="LUK 1:45"/></para>
  <para style="s1">Na Fal Hyal Nǝ Maryamu</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>Maryamu na,</para>
  <para style="q1" vid="LUK 1:46">“Ɗǝfuwa yau a vǝr fal Thlagǝu.<verse eid="LUK 1:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47"/>Piya yi tsu a vǝr caguli</para>
  <para style="q2" vid="LUK 1:47">ara Hyal ngǝ Ndǝr Mbǝɗa ɗa,<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>ara ji ɗǝngari ǝnga yau,</para>
  <para style="q2" vid="LUK 1:48">nayi kǝra mafa nyi</para>
  <para style="q2" vid="LUK 1:48">kǝra aˈyi vanyi sǝ mai!</para>
  <para style="q1" vid="LUK 1:48">Mbari kabangǝkau, patǝr nji</para>
  <para style="q2" vid="LUK 1:48">wu nda ngga ɗa</para>
  <para style="q2" vid="LUK 1:48">ǝnga ndǝr barka,<verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>arya sǝ dǝdǝgalˈyar kǝ kǝra</para>
  <para style="q2" vid="LUK 1:49">Hyal ndǝ dǝnama mǝliya ɗa.</para>
  <para style="q1" vid="LUK 1:49">Thlǝmǝ nyi ndǝ cici ngau!<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>Ciji baˈanǝ ciji</para>
  <para style="q2" vid="LUK 1:50">ju nda tǝhuɗǝ ǝgya</para>
  <para style="q2" vid="LUK 1:50">njira wu nǝ nyi dǝgalkur.<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>Ənga tsi nǝ dǝnama nga</para>
  <para style="q2" vid="LUK 1:51">ji mǝliya sǝ dǝdǝgalˈyar!</para>
  <para style="q1" vid="LUK 1:51">Ji tǝtǝlna njir fǝkǝr nda</para>
  <para style="q2" vid="LUK 1:51">ǝnga sǝra ndu fǝr kǝr ǝni</para>
  <para style="q2" vid="LUK 1:51">wu ɗǝfuwa nda.<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>A hǝyari ja tǝltǝlˈyar</para>
  <para style="q2" vid="LUK 1:52">sara wu tǝlkur nda,</para>
  <para style="q2" vid="LUK 1:52">ǝnga ji hyaˈana nji didiɗi.<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>Ji nǝ nyi sǝr sǝm mǝsahǝu</para>
  <para style="q2" vid="LUK 1:53">anǝ njir wuɓau,</para>
  <para style="q1" vid="LUK 1:53">kǝ ji mǝliya njir gǝnna</para>
  <para style="q2" vid="LUK 1:53">ndǝ maˈyi ǝnga tsi kurthlǝu.<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>Ji dlǝwari mafa nyiˈyar</para>
  <para style="q2" vid="LUK 1:54">njir Izirayila ǝnga</para>
  <para style="q1" vid="LUK 1:54">ji ɗǝngari ji cabiya tǝhuɗǝ</para>
  <para style="q2" vid="LUK 1:54">anǝ nji nyi,<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>ǝnggǝra ji mǝliya alkawal</para>
  <para style="q2" vid="LUK 1:55">anǝ ǝjir mǝn Ibrahimu</para>
  <para style="q2" vid="LUK 1:55">ǝnga culi nyi baˈanuwa!”<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>Maryamu nggya ǝnga Alisabatu ǝnggǝr hya makǝru, kadivira ji dzǝgwa sha a ndu ki gǝ nda.<verse eid="LUK 1:56"/></para>
  <para style="s1">Nji Yabiya Yahwana Ndǝr <optbreak/> Mǝl Baɓǝtizǝma</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>Ənggǝra pǝcir ya nyi ɗa, kǝ Alisabatu yabiya zǝr nyi. <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>Tǝwul nyi ǝkkǝˈyi nji gǝ nda ndǝ nggari ǝnggǝra Thlagǝ canǝ nyi tǝhuɗǝ dǝdǝgal anǝ nyi, kǝ ndǝ daɓǝr dzǝ ndu caguli ǝnga ja.<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>Ənggǝra zǝr kǝ tǝkǝri pida cisu, kǝ ndǝ shili aga nda sa thlana nyi pǝlzha, ndu yiwu nda fiya nyi thlǝmǝr dǝnyi, Zakariya. <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>Ama kǝ miya zǝr na, “Awau! Nja nda ngga nyi ǝnga Yahwana.”<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>Əngwar nda anǝ nyi, “Wu culir hyi wa ngǝ ǝnga culi thlǝmǝ ka?” <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>Kǝ ndǝ yiwa dǝya zǝr ǝnga tsi, thlǝmǝ kǝra ja yiwu nja ngga zǝr kǝ ǝni.<verse eid="LUK 1:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63"/>Kǝ ji yiwa, nja nǝ nyi lǝkakaɗau, kǝ ji tsǝfǝri, “Thlǝmǝ nyi Yahwana ngau.” Kǝ sǝ kǝ ɗa sǝ dǝdǝgur anǝ njira a ndǝna! <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>Ənggǝ ngǝ miya Zakariya pahǝnakǝr, kǝ ji dzǝguya ndǝr ǝnga fal Hyal. <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>Kǝ sǝ kǝ nǝ nyi hivǝr anǝ tǝwulǝr nda patǝu. Njir ˈyiˈyir Yahudi njir nggya wu pama mau tǝtǝlna sǝ kǝ ɗa kǝ baˈamani. <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>Kalar ndǝra nggari sǝ kau, ba nǝ nyi ɗǝnga, ju na, “Mi ngǝ zǝr kǝ wu nda ɗa?” Ara a tsamǝr nji abǝr tsa Hyal aˈyi ǝnga ja.<verse eid="LUK 1:66"/></para>
  <para style="s1">Zakariya Fal Hyal</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>Ənggǝra Mambǝl Cicau shida ar kǝra Zakariya dǝya Yahwana, kǝ ji dzǝguya ndǝr kǝra Hyal nǝ nyi, ji na,<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>“Barka anǝ Thlagǝu,</para>
  <para style="q2" vid="LUK 1:68">Hyal nǝr Izirayila!</para>
  <para style="q1" vid="LUK 1:68">Ji shili aga sa dlǝwa nji gǝ nda,</para>
  <para style="q2" vid="LUK 1:68">ja kǝtiya nda.<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>Ji nǝ mǝn ndǝr Mbǝɗa nji</para>
  <para style="q2" vid="LUK 1:69">ǝnga dǝnama</para>
  <para style="q2" vid="LUK 1:69">sara wu ki mafa nyi Dawuda.<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>Ənggǝr kǝra ji mǝliya alkawal</para>
  <para style="q2" vid="LUK 1:70">tsu kaɗǝu lagu miya</para>
  <para style="q2" vid="LUK 1:70">nabi nyiˈyar nǝ cicau.<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>Ju sa hǝbiya mǝn</para>
  <para style="q2" vid="LUK 1:71">sara wu tsa njira vǝr ca</para>
  <para style="q1" vid="LUK 1:71">dawakur anǝ mǝn,</para>
  <para style="q2" vid="LUK 1:71">ǝnga patǝr njira gǝra yiwu</para>
  <para style="q2" vid="LUK 1:71">nda lari mǝna cakau.<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>Ji mǝl abangǝ aga ja cabiya</para>
  <para style="q2" vid="LUK 1:72">tǝhuɗǝ nyi anǝ ǝjir mǝnˈyar,</para>
  <para style="q1" vid="LUK 1:72">ǝnga ji ɗǝngari</para>
  <para style="q2" vid="LUK 1:72">alkawal nyi nǝ cicau,<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>kǝra ji mǝliya daɓǝ ǝnga</para>
  <para style="q2" vid="LUK 1:73">sǝm fǝla anǝ ǝjir mǝn Ibrahimu.<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>Ju nda hǝbiya mǝn</para>
  <para style="q2" vid="LUK 1:74">sara ara dawar mǝnˈyar,</para>
  <para style="q1" vid="LUK 1:74">aga mǝna dzǝgwa nu nyi</para>
  <para style="q2" vid="LUK 1:74">ǝnga jirkur gǝra ǝnga hivǝr<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>wu cicikur</para>
  <para style="q2" vid="LUK 1:75">ǝnga mǝnahǝkur</para>
  <para style="q1" vid="LUK 1:75">wu mwar Hyal</para>
  <para style="q2" vid="LUK 1:75">patǝr nggyabiyar mǝn.<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>Nagǝ tsu zǝr kau,</para>
  <para style="q2" vid="LUK 1:76">nju nda ngga ngǝ</para>
  <para style="q1" vid="LUK 1:76">ǝnga nabi nǝ Hyal kǝra ndiya</para>
  <para style="q2" vid="LUK 1:76">ǝnga dǝgalǝu.</para>
  <para style="q1" vid="LUK 1:76">Gu nda tǝrabiya</para>
  <para style="q2" vid="LUK 1:76">a dumwar Thlagǝu,</para>
  <para style="q1" vid="LUK 1:76">aga ga mǝliya</para>
  <para style="q2" vid="LUK 1:76">lagu nyi kakalǝu.<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>Aga ga nǝ nyi anǝ nji gǝ nda sǝnbiya sǝ ar kǝra mbǝɗǝ</para>
  <para style="q2" vid="LUK 1:77">lagur tǝfǝbiya nda bikǝr nda,<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>ara gangǝkura tǝhuɗǝ dzǝ nǝ Hyalǝr mǝn, ca</para>
  <para style="q2" vid="LUK 1:78">ngǝ mbǝmbǝl nǝ mbǝɗau sara a dǝmǝlmau wu nda shida,</para>
  <para style="q2" vid="LUK 1:78">aga ja sa mbǝl ar kǝra mǝn,<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>ja mbǝl a gyar kǝra njira vǝr nggya wu kuthlǝu,</para>
  <para style="q2" vid="LUK 1:79">ǝnga njira ǝgya kiɗa shangguɗi nǝ tau,</para>
  <para style="q2" vid="LUK 1:79">aga ca lagur nggya jamǝ anǝ mǝn.”<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>Kǝ Yahwana hau, ji cakǝri dzǝ wu mambǝl. Ji nggya a gwa tagǝ kǝl ta pǝcir biya nyi ar babal anǝ njir Izirayila ɗa.<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">Yar Yesu</para>
  <para style="r">(<ref loc="MAT 1:18-25">Matiwu 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>Wu pǝci ta, tǝl Kayisaru Agustusu nǝr Roma hyabiya cama abǝr nja tsǝfǝri thlǝmǝr nji patǝ wu kiɗa tǝlkur nyi. <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>Kǝ ngǝ jiga nji nǝ tanggǝrma kǝra nji mǝl pǝci kǝra Kiriniyusu a vǝr sǝm Tǝlkur nyi wu ˈyiˈyir Sǝriya. <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>Nji patǝ maˈyi a ndu mǝlmǝr nda aga nja nda jigabiya nda.<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>Yusufu tsu ji piyari Nazǝratu wu ˈyiˈyir Galili ji maˈyi a du Bayitalahami wu ˈyiˈyir Yahudi, mǝlmǝ kǝra nji ya tǝl Dawuda a gwa, ara naja culi zǝmǝ ǝnga Dawuda. <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>Ji maˈyi ǝnga Maryamu kǝra alkawal mbamba nǝ hǝ dzǝ aˈyi wu pama nda, aga nja nda jigabiya nda. Wu pǝci ta, Maryamu ǝnga huɗǝ nga ja. <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>Ma tsu nda wu Bayitalahami, kǝ pǝcir ya mbari nyi. <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>Kǝ ji yabiya zǝr nyi nǝ tanggǝrma, ji pǝɗǝwa nyi wu gumbwara, ji dzǝgwa pina nyi wu nggaɓa, ara nandǝ uya umbwa wu ki dlǝwu mǝthlǝpi mai.<verse eid="LUK 2:7"/></para>
  <para style="s1">Njir Ɓǝla Sǝ Shishi Ənga Waladiˈyar</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>A biyar ya mǝlmǝ kau, njir ɓǝla aˈyi, kǝra a vǝr pida a biyar babal uvuˈyi, nda vǝr tsamǝ tǝmahǝr nda. <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>Kǝ waladi Thlagǝ canǝ nda kǝr, ǝnga kadakadarkur nǝ Thlagǝ mbǝl a gyar kǝra nda, kǝra nǝ nda hivǝr gagaɗau. <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>Əngwar waladi anǝ nda, “Hya sara hivǝr mai! Arya nayi ngǝ shili ǝnga ndǝshigu mǝnahǝ gagaɗau anǝ hyi, kǝra wu nda mǝliya patǝr nji ndu nda ɗa ǝnga huɗǝ pipida. <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>Əshina kau, wu mǝlmǝ gǝ Dawuda, a yabiya hyir nji ndǝr mbǝɗa hyi, naja ngǝ Kǝrsiti Thlagǝu! <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>Kǝja sǝra wu nda canǝ hyi nyi, hyu nda thlǝwa zǝr mamanji nji pǝɗǝwa wu gumbwara, nji pina nyi wu nggaɓa.”<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>Aˈyi nda ǝnga sǝni mai kǝ waladiˈyar gangǝu ǝnga waladi ta, sara a dǝmǝlmau shida nda vǝr fal Hyal nda vǝr na,<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>“Kadakadarkur anǝ Hyal</para>
  <para style="q2" vid="LUK 2:14">kǝra a dǝmǝlmau!</para>
  <para style="q1" vid="LUK 2:14">Wu duniya bǝgǝ huɗǝ pǝrtǝu</para>
  <para style="q2" vid="LUK 2:14">a ɗa ara njira Hyal</para>
  <para style="q2" vid="LUK 2:14">a vǝr nggar mǝsahǝkur nda!”<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>Ənggǝra waladiˈyar piyari nda ndǝ maˈyi a dǝmǝlmau, ca ngǝ njir ɓǝla na anǝ kuvwar nda, abǝr, “Mǝn na maˈyi a vu Bayitalahami mǝn na vuwa tsamiya sǝ kǝ ɗa kau, kǝra Thlagǝ nar mǝn ar kǝri kau.”<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>Ca nga ndǝ maˈyi ǝnga kusa, kǝ ndǝ vuwa thlǝwa Maryamu ǝnga Yusufu, ǝnga zǝr mamanji, kǝra nji pina wu nggaɓa. <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>Ənggǝra ndǝ lari nyi ba ndǝ tǝtǝlna ɗahǝu sǝra waladi nar nda ar kǝra zǝr kau. <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>Patǝkura njira nggari ndǝr kau, ba ɗa sǝ dǝdǝgur anǝ nda sǝ kǝ njir ɓǝla nar nda kau. <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>Ama kǝ Maryamu sǝɓiya sǝˈyar kǝ patǝu, ju dzǝgwa ɗǝnga nda wu ɗǝfuwa ja. <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>Njir ɓǝla dzǝgwa sha, nda vǝr thlǝna nǝr fal Hyal ǝnga dlǝvǝ nyi, ara sǝra ndǝ nggari, ǝnga ndǝ lari. Ara patǝr sǝ ɗa ǝnggǝra waladi ta nar nda.<verse eid="LUK 2:20"/></para>
  <para style="s1">Nji Fiya Nyi Thlǝmǝ Anǝ Yesu</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>Ənggǝra zǝra nyi mǝliya pida cisu, ba nji thlana nyi pǝlzha, ba nji fiya nyi thlǝmǝ Yesu, thlǝmǝ kǝra waladi nǝ nyi kadivira nji dzǝgwa hǝ huɗǝ nyi.<verse eid="LUK 2:21"/></para>
  <para style="s1">Nji Hǝri Yesu A Vu Ki Hyal <optbreak/> Aga Nja Lǝr Nyi Anǝ Hyal</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22"/>Kǝ pǝci shili kǝra Maryamu ǝnga Yusufu wu mǝl sǝra dlaɗǝ nǝ Musa nar nda nja mǝl aga nǝ nyi cicikur, ba ndǝ hǝri Yesu a vu Urshalima aga nda vuwa lǝr nyi anǝ Thlagǝu. <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>Abangǝ nga nyi tsǝtsǝfau wu dlaɗǝ nǝ Thlagǝu, abǝr, “Kalar zǝr sal kǝra nji ya nǝ tanggǝrma, nju fiya nyi ja ɗa nǝ cicau nǝ Thlagǝu.” <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>Nanda tsu ndu thla sau, ǝnggǝra dlaɗǝ nǝ Thlagǝ cabiya, ǝnga mbǝthla mǝthlǝ ǝnga wazha mbǝthla masar mǝthlǝu.<verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>Wu pǝci kau, vanyi ndǝ aˈyi a vǝr nggya wu Urshalima kǝra nju ngga ǝnga Simiyanu. Naja ndǝ tsapǝu, ndǝr gǝnggǝr nyi sǝli anǝ Hyal, naja vǝr sǝkǝ pǝci kǝra nju sa hǝbiya njir Izirayila wu ɓwaɓwatǝu. Mambǝl Cici tsu a vǝr nggya ǝnga ja. <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>Mambǝl Cici cabiya nyi abǝr naji wu tǝ mai kǝl ji lari Kǝrsiti kǝra Thlagǝ mǝliya nyi alkawal. <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>Ənggǝra Mambǝl lǝbiya nyi ba ji gwu vir pathla nǝ ki Hyal, ar pǝci kǝra njir ya Yesu hǝri nyi a shili wu ki Hyal aga nda mǝliya sǝra dlaɗǝ cabiya nja mǝl, <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>kǝ Simiyanu dlǝwuri zǝr kǝ wu tsa ja, kǝ ji usa Hyal ji na, abǝr,<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>“Kabangǝkǝ Thlagǝu,</para>
  <para style="q2" vid="LUK 2:29">lǝbiya mafa ngǝ ja maˈyi ǝnga huɗǝ pǝrtǝu,</para>
  <para style="q1" vid="LUK 2:29">ǝnggǝra gǝ mǝliya alkawal,<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>arya liya yau</para>
  <para style="q2" vid="LUK 2:30">a lari mbǝɗǝ ngau,<verse eid="LUK 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 2:31"/>mbǝɗǝ kǝra gǝ mǝliya</para>
  <para style="q2" vid="LUK 2:31">a dumwar nji patǝu.<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>Mbǝmbǝl kǝra sa cabiya ngau</para>
  <para style="q2" vid="LUK 2:32">anǝ njira aˈyi njir Yahudiya mai,</para>
  <para style="q1" vid="LUK 2:32">kǝra tsu a sa cabiya</para>
  <para style="q2" vid="LUK 2:32">kadakadarkur ngau</para>
  <para style="q1" vid="LUK 2:32">anǝ nji ngau, njir Izirayila.”<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>Dǝya zǝr ǝnga mǝnyi nda vǝr tsamǝ sǝ dǝdǝgur sǝra Simiyanu a vǝr na ar kǝra ja. <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>Simiyanu fǝnggǝr nda barka, ji na anǝ Maryamu miya zǝr, “Hyal a caɗǝbiyari zǝr kau, aga ja ɗa sǝr thlǝ hi anǝ nji ǝnga sǝr hyaˈana alenyi nji gangǝu wu Izirayila. Ja sa ɗa ǝnggǝr sǝra nja tsamǝ sǝ ari sara ara Hyal kǝra nji gangǝu a nda yiwu mai. <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>Agabangǝ sǝra ɗǝɗǝwa wu ɗǝfuwa nji a nda ɗa ar babal. Najaka sau, a sa ɗa kwakwaɗǝ anǝ ngau, ǝnggǝr hǝnggya nga nji tsaviya ɗǝfuwa gǝ ǝni.”<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>Vanyi madedegǝu aˈyi nabi mala thlǝmǝ nyi Hanatu kwar Fanuwalu nǝr culi Ashiru. Ji nggya ǝnga sal nyi nǝ fa mǝɗǝfǝ wacu ǝnggǝra ndǝ hǝri dzau. <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>Ba sal nyi kǝ tau. Kabangǝkau, fa nyi cisu kumunyi apǝ foɗǝ nga nyi. Naji sayi piyari ki Hyal mai, ja vǝr dlǝkǝr anǝ Hyal vuˈyi ǝnga puci, ja vǝr ndǝr ǝnga Hyal ǝnga hǝ zǝmǝtsini. <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>Kakalǝ wu pǝci kau, kǝ mala kǝ gwa ja vǝr usa Hyal, naja tsu ji ndǝr ar kǝra zǝr kǝ anǝ nji patǝu, njira vǝr sǝkǝ Hyal ja sa nǝ nyi nggya jamǝ anǝ Urshalima.<verse eid="LUK 2:38"/></para>
  <para style="s1">Yusufu Ənga Maryamu Sha <optbreak/> A Vu Kir Nda Wu Nazǝratu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>Wu pǝci kǝra Yusufu ǝnga Maryamu kuɗǝna sǝˈyar kǝ patǝu, sǝra dlaɗǝ nǝ Thlagǝ na nja mǝl, ba ndǝ sha a vu mǝlmǝr nda Nazǝratu wu Galili. <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>Zǝr kǝ hau, ǝnga dǝnama, nyinyau ǝnga tsǝtsǝlkur. Tǝhuɗǝ Hyal tsu aˈyi ǝnga ja.<verse eid="LUK 2:40"/></para>
  <para style="s1">Yesu Wu Zǝrkur Nyi, <optbreak/> Wu Ki Hyal</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>Kalar fa njir ya Yesu ndu vu Urshalima aga lardur nǝr vǝlna nǝ njir Izirayila.<note caller="+" style="f"><char style="fr" closed="false">2:41 </char><char style="ft" closed="false">Lardur kǝ nǝ ɗǝnga ǝnggǝra Hyal mǝl thlǝr ǝnga Musa ji hǝbiya njir Izirayila sara wu tsa njir Masaru. Fa ǝnga fa nga ndu mǝl abangau.</char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>Ənggǝra Yesu tǝkǝri fa kumo apǝ mǝthlǝu ǝnga ya, ba ndǝ mai a ndu lardura nyi ǝnggǝra ndǝ tsǝliya. <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>Ayukuɗa lardur kuɗau, ba ndǝ mbari lagu nda vǝr sha a ndu ki, ama ba ji taˈyi wu yukuɗǝ wu Urshalima, gǝra ǝnga sǝni njir ya nyi. <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>Nanda tsu ndu nggani wu pama nji nga ja, agabangǝ kǝ ndǝ dumwa ǝnga ɓau nǝ pǝkǝ pathlǝu. Ənggau, kǝ ndǝ dzǝguya gal nyi a ndu pama njir nda ǝnga bazhir nda ˈyar. <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>Ama nandǝ lari nyi mai. Agabangǝ kǝ ndǝ ɓǝra sha a vu Urshalima aga nda vuwa gal nyi a vuna. <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>Pǝci nǝ pida makǝrkura nyi ba ndǝ thlǝwa nyi a vǝr nggya a gwu vir pathla nǝ ki Hyal wu pama malǝmˈyar. Ja vǝr sǝ himi nda, ǝnga ja vǝr yiwa nda sǝ pamǝpamǝu. <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>Patǝkura njira nggari nyi ndǝ sǝɓiya miya nda, ǝnggǝra sǝnbiya sǝ nyi ǝnga shaɗǝwa nyi ɗa sǝ dǝdǝgur anǝ nda. <verse eid="LUK 2:47"/><verse number="48" style="v" sid="LUK 2:48"/>Njir ya nyi ba ɗa sǝ dǝdǝgur anǝ nda ǝnggǝra ndǝ lari nyi ǝnggau, kǝ mǝnyi na anǝ nyi, “Zǝr ɗa ara mi nga gǝ mǝl anǝ ˈya abanga? Nayi ǝnga dǝngau anǝ ˈyar ɗǝnga sau ara naˈyi lari ngǝ mai.”<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>Ji shaɗǝwa nda, ji na, “Mi ngǝ ɗa hyu gal ɗa ɗǝma? Nahyi aˈyi sǝni abǝr a ɗar tsaˈa ya nggya wu ki dǝɗa wa?” <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>Ama nandǝ sǝni sǝra ndǝr kǝ aga nyi mai.<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>Ba ji hyaˈari ji nu nda, ndǝ sha vu Nazǝratu ǝnga ja, ja vǝr dumwa ǝnga mǝl sǝra njir ya nyi a vǝr na anǝ nyi. Mǝnyi tsu ji sǝɓiya sǝˈyar kǝ patǝu, wu ɗǝfuwa ja. <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>Yesu hau wu tsǝtsǝlkur ǝnga wu nǝ kumǝr dzau, ba ǝnga mayiwakur sara ara Hyal ǝnga nji.<verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">Ndǝr Hyal Kǝra Yahwana <optbreak/> Ndǝr Baɓǝtizǝma Tǝtǝlna</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matiwu 3:1-12</ref>; <ref loc="MRK 1:1-8">Markusu 1:1-8</ref>; <ref loc="JHN 1:19-28">Yahwana 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>Wu fa nǝ kumo apǝ tǝfu wu tǝlkur nǝ Kayisaru Tiberiyasu, Buntusu Bilatusu ca ngǝ gwamna nǝr Yahudi, Hirudusu tsu ca ngǝ tǝl nǝr Galili, Fǝlipǝu zamǝ nyi ca ngǝ tǝl nǝr ˈyiˈyir Ituriya ǝnga Tarakunitusu, Lisaniyasu tsu tǝl Abilinisu. <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>Anasu ǝnga Kayafasu nanda ngǝ pubu dǝdǝgalˈyar. Wu pǝci ta tsu ngǝ ndǝr Hyal shili anǝ Yahwana zǝr Zakariya a gwar tagǝ mashi. <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>Kǝ Yahwana zǝwuya patǝkura ˈyiˈyi kǝra ar dza dǝl Urdǝnu. Ja vǝr tǝtǝlna ndǝr Hyal nǝ tubi anǝ nji, ja vǝr na, “Sha mau a shili wu lagu Hyal aga hya uya baɓǝtizǝma, Hyal tsu ju sa tǝfǝbiya hyi bikǝr hyi.” <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>Ənggǝra nabi Əshaya tsǝfǝri wu lǝkakaɗǝ nǝ Hyal abǝr,</para>
  <para style="q1" vid="LUK 3:4">ji na, “Ɗahǝ a vǝr ngga a gwar tagǝu, ja vǝr na,</para>
  <para style="q1" vid="LUK 3:4">‘Hya pabǝri nyi lagu anǝ Thlagǝu,</para>
  <para style="q2" vid="LUK 3:4">hya mǝliya lagu tataˈyi pir wu mwa nyi.<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>Nja sa nyanyana kalar dagǝu,</para>
  <para style="q2" vid="LUK 3:5">kalar mǝ ǝnga gar nja hǝya a gya.</para>
  <para style="q1" vid="LUK 3:5">Nju taˈyibiya lagu mbambalˈyar,</para>
  <para style="q2" vid="LUK 3:5">lagu didiɗiˈyar tsu nju mǝliya mǝnahǝu.<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>Ənga patǝr ndapi wu nda lari mbǝɗǝ nǝ Hyal.’”<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>Kǝ dlamir nji maˈyi a ndǝra Yahwana aga nda uya baɓǝtizǝma ara ja. Kǝ Yahwana nar nda, “Nahyi wazha mǝtsapa! Wa ngǝ kughiya hyi, aga hya hwi sara ara numa nǝ huɗǝ ndzǝndzǝ Hyal kǝra a vǝr shili ka? <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>Hya mǝl thlǝr kǝra mǝnahǝu wu nggyabiyar hyi kǝra wu cabiya abǝr a tubir hyi. A sara hya fiya wu ɗǝfuwa hyi tsu, abǝr, ‘Ibrahimu ngǝ dǝrˈya.’ Yu na anǝ hyi, abǝr Hyal aˈyi ja ǝnga dǝnama nǝ shabiya tsǝkaˈyar kau, aga wazha anǝ Ibrahimu. <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>A fiyar nji hira kǝm ar nggyilanga wu. Kalar wu kǝra gǝra pǝ wazha mǝnahǝu, nju nda gǝmna nyi, ba nja vakuwa a gwu uˈu.”<verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>Kǝ nji kǝ yiwa nyi, “Mi nga ˈya kyaga mǝla?”<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>Yahwana shaɗǝwa nda, ji na, “Abǝr kalar ndǝra ǝnga lǝgutǝ mǝthlǝu, ja nǝ nyi pathlǝu anǝ ndǝra gǝra ǝni, kalar ndǝra ǝnga sǝr sǝm tsu ja mǝliya abangau.”<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>Njir tsǝm budǝ tsu ndǝ shili aga ja mǝliya nda baɓǝtizǝma, ndǝ yiwa nyi, ndǝ na, “Malǝmǝ, mi nga ˈya mǝla?”<verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>Əngwar ja anǝ nda, “A sara hya dlǝwu a ndiya sǝra nji na hya tsǝm mai.”<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>Abangǝ tsu ngǝ alenyi sojaˈyar yiwa nyi, “Kar naˈya tsu, mi nga ˈya mǝla?” Kǝ ji na anǝ nda, “A sara hya canggǝr nyi anǝ nji aga nda nǝ hyi gǝnna ǝnga dǝnama mai, a sara hya thla fati ar kǝra nji mai, hya mbiya ɗǝfu ǝnga sǝra nji kina hyi ǝni.”<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>Nji patǝ a vǝr sǝkǝ shilir Kǝrsiti, ndǝ lari Yahwana kǝ ndǝ dzǝguya ɗǝnga wu ɗǝfuwa nda tara Yahwana ngǝ Kǝrsiti kau. <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>Kǝ Yahwana shaɗǝwa nda patǝu, “Nayau, ya vǝr mǝl baɓǝtizǝma anǝ hyi ǝnga ˈyimi. Ama vanyi ndǝra ndiya ɗa ǝnga dǝnama a vǝr shili, kǝra alaga sǝr mba ɓiɓi<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Wu nggyabiya njir Yahudiya ma mǝthlǝpi shili wu ki, mafa alaga ndǝra ndiya ǝnga didiɗi wu ki kǝ ja zǝɗǝna ɓiɓi nyi ja dzǝgwa cina nyi hya ja.</char></note> nyi nayi aˈyi ɗa tsa aga ya pǝlna mai. Ju sa mǝliya hyi baɓǝtizǝma ǝnga Mambǝl Cicau ba ǝnga uˈu. <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>Cala pi nyi wu tsa ja nga nyi, ju pina uhi ba ja batǝna lar nyi ba ja dzǝgwa faˈana uhi a su tsam. Kofu ǝnga cacangǝ ba ja nggyina nda ǝnga uˈu kǝra gǝra tau.”<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>Ənga ɗahǝ pamǝpamǝ gangǝu ngǝ Yahwana tǝtǝlna ndǝshigu mǝsahǝ anǝ nji. <verse eid="LUK 3:18"/><verse number="19" style="v" sid="LUK 3:19"/>Ama ǝnggǝra Yahwana kughiya kughi anǝ gwamna Hirudusu kǝra hǝri Hirudiyasu mala zamǝ nyi Fǝlipǝu ǝnga patǝkura alenyi sǝ ɗǝmwaˈyi kǝra ji mǝliya. <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>Kǝ Hirudusu ɓǝra cakǝri ɗǝmwaˈyikur nyi ba ji fuwa Yahwana wu fursǝna.<verse eid="LUK 3:20"/></para>
  <para style="s1">Nji Mǝliya Nyi Baɓǝtizǝma Anǝ Yesu</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matiwu 3:13-17</ref>; <ref loc="MRK 1:9-11">Markusu 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>Ayukuɗa ji kuɗǝna mǝl baɓǝtizǝma anǝ nji patǝu, ba ji mǝliya nyi anǝ Yesu tsu, ǝnggǝra Yesu a vǝr ndǝr ǝnga Hyal ba dǝmǝlmǝ pahau, <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>kǝ Mambǝl Cici shida ar kǝra ja a papa mbǝthla. Kǝ ɗahǝ sara a dǝmǝlmǝ na, “Nagǝ ngǝ zǝr ɗa, yu yiwu ngau, huɗa yi pipida ǝnga gau.”<verse eid="LUK 3:22"/></para>
  <para style="s1">Culi Kǝra Yesu Biya Sara Gwa</para>
  <para style="r">(<ref loc="MAT 1:1-17">Matiwu 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>Ar pǝcira Yesu dzǝguya thlǝr nyi nǝ highiɓau, a tǝkǝr ja fa makǝr kumunyi wu duniya.</para>
  <para style="li1" vid="LUK 3:23">Nji hǝri nyi abǝr naja zǝr</para>
  <para style="li1" vid="LUK 3:23">Yusufu kǝra zǝr Hali.<verse eid="LUK 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="LUK 3:24"/>Hali zǝr Matata,</para>
  <para style="li1" vid="LUK 3:24">Matata zǝr Lawi,</para>
  <para style="li1" vid="LUK 3:24">Lawi zǝr Melci,</para>
  <para style="li1" vid="LUK 3:24">Melci zǝr Yonna,</para>
  <para style="li1" vid="LUK 3:24">Yonna zǝr Yusufu,<verse eid="LUK 3:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="LUK 3:25"/>Yusufu zǝr Matatiyasu</para>
  <para style="li1" vid="LUK 3:25">Matatiyasu zǝr Amosu,</para>
  <para style="li1" vid="LUK 3:25">Amosu zǝr Nahumu,</para>
  <para style="li1" vid="LUK 3:25">Nahumu zǝr Azaliya,</para>
  <para style="li1" vid="LUK 3:25">Azaliya zǝr Nagayi,<verse eid="LUK 3:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="LUK 3:26"/>Nagayi zǝr Maata,</para>
  <para style="li1" vid="LUK 3:26">Maata zǝr Matatiyasu</para>
  <para style="li1" vid="LUK 3:26">Matatiyasu zǝr Saminu,</para>
  <para style="li1" vid="LUK 3:26">Saminu zǝr Joseku,</para>
  <para style="li1" vid="LUK 3:26">Joseku zǝr Yahuda,<verse eid="LUK 3:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="LUK 3:27"/>Yahuda zǝr Yuwana,</para>
  <para style="li1" vid="LUK 3:27">Yuwana zǝr Resa,</para>
  <para style="li1" vid="LUK 3:27">Resa zǝr Zarubabelu,</para>
  <para style="li1" vid="LUK 3:27">Zarubabelu zǝr Shaltiyalu,</para>
  <para style="li1" vid="LUK 3:27">Shaltiyalu zǝr Neri,<verse eid="LUK 3:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="LUK 3:28"/>Neri zǝr Melci,</para>
  <para style="li1" vid="LUK 3:28">Melci zǝr Adi,</para>
  <para style="li1" vid="LUK 3:28">Adi zǝr Kusam,</para>
  <para style="li1" vid="LUK 3:28">Kusam zǝr Elmoda,</para>
  <para style="li1" vid="LUK 3:28">Elmoda zǝr Eri,<verse eid="LUK 3:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="LUK 3:29"/>Eri zǝr Jashuwa,</para>
  <para style="li1" vid="LUK 3:29">Jashuwa zǝr Elezar,</para>
  <para style="li1" vid="LUK 3:29">Elezar zǝr Jarimu,</para>
  <para style="li1" vid="LUK 3:29">Jarimu zǝr Matata,</para>
  <para style="li1" vid="LUK 3:29">Matata zǝr Lawi,<verse eid="LUK 3:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="LUK 3:30"/>Lawi zǝr Simiyanu,</para>
  <para style="li1" vid="LUK 3:30">Simiyanu zǝr Yahuda,</para>
  <para style="li1" vid="LUK 3:30">Yahuda zǝr Yusufu,</para>
  <para style="li1" vid="LUK 3:30">Yusufu zǝr, Janamu,</para>
  <para style="li1" vid="LUK 3:30">Janamu zǝr Eliyakimu,<verse eid="LUK 3:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="LUK 3:31"/>Eliyakimu zǝr Meliya,</para>
  <para style="li1" vid="LUK 3:31">Meliya zǝr Meyinna,</para>
  <para style="li1" vid="LUK 3:31">Meyinna zǝr Matathla,</para>
  <para style="li1" vid="LUK 3:31">Matathla zǝr Nathlanu,</para>
  <para style="li1" vid="LUK 3:31">Nathlanu zǝr Dawuda,<verse eid="LUK 3:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="LUK 3:32"/>Dawuda zǝr Jesi,</para>
  <para style="li1" vid="LUK 3:32">Jesi zǝr Obida,</para>
  <para style="li1" vid="LUK 3:32">Obida zǝr Buˈaza,</para>
  <para style="li1" vid="LUK 3:32">Buˈaza zǝr Salmonu,</para>
  <para style="li1" vid="LUK 3:32">Salmonu zǝr Nashanu,<verse eid="LUK 3:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="LUK 3:33"/>Nashanu zǝr Aminadaɓǝu,</para>
  <para style="li1" vid="LUK 3:33">Aminadaɓǝu zǝr Aramu,</para>
  <para style="li1" vid="LUK 3:33">Aramu zǝr Hesaruna,</para>
  <para style="li1" vid="LUK 3:33">Hesaruna zǝr Parisu,</para>
  <para style="li1" vid="LUK 3:33">Parisu zǝr Yahuda,<verse eid="LUK 3:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="LUK 3:34"/>Yahuda zǝr Yakubu,</para>
  <para style="li1" vid="LUK 3:34">Yakubu zǝr Ishaku,</para>
  <para style="li1" vid="LUK 3:34">Ishaku zǝr Ibrahimu,</para>
  <para style="li1" vid="LUK 3:34">Ibrahimu zǝr Tera,</para>
  <para style="li1" vid="LUK 3:34">Tera zǝr Nahoru,<verse eid="LUK 3:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="LUK 3:35"/>Nahoru zǝr Seragu,</para>
  <para style="li1" vid="LUK 3:35">Seragu zǝr Riyu,</para>
  <para style="li1" vid="LUK 3:35">Riyu zǝr Pelegǝ,</para>
  <para style="li1" vid="LUK 3:35">Pelegǝ zǝr Eberu,</para>
  <para style="li1" vid="LUK 3:35">Eberu zǝr Shila,<verse eid="LUK 3:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="LUK 3:36"/>Shila zǝr Kayinanu,</para>
  <para style="li1" vid="LUK 3:36">Kayinanu zǝr Arfashadu,</para>
  <para style="li1" vid="LUK 3:36">Arfashadu zǝr Shemu,</para>
  <para style="li1" vid="LUK 3:36">Shemu zǝr Nǝhu,</para>
  <para style="li1" vid="LUK 3:36">Nǝhu zǝr Lameku,<verse eid="LUK 3:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="LUK 3:37"/>Lameku zǝr Metusǝla,</para>
  <para style="li1" vid="LUK 3:37">Metusǝla zǝr Enoku,</para>
  <para style="li1" vid="LUK 3:37">Enoku zǝr Jaredu,</para>
  <para style="li1" vid="LUK 3:37">Jaredu zǝr Mahalalelu,</para>
  <para style="li1" vid="LUK 3:37">Mahalalelu zǝr Kenanu,<verse eid="LUK 3:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="LUK 3:38"/>Kenanu zǝr Enoshu,</para>
  <para style="li1" vid="LUK 3:38">Enoshu zǝr Shitu,</para>
  <para style="li1" vid="LUK 3:38">Shitu zǝr Adamu,</para>
  <para style="li1" vid="LUK 3:38">Adamu zǝr Hyal.<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">Shatan Dzǝbiya Yesu</para>
  <para style="r">(<ref loc="MAT 4:1-11">Matiwu 4:1-11</ref>; <ref loc="MRK 1:12-13">Markusu 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>Yesu piyari dǝl Urdǝnu nyinyau ǝnga Mambǝl Cicau, Kǝ Mambǝl Cici lǝbiya Yesu a gwar tagǝu, aga shatan a gwa dzǝbiya nyi. <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>Ayukuɗa Yesu hǝr zǝmǝtsini nǝ pida foɗǝ kumunyi vuˈyi ǝnga pǝci, kǝ wuɓǝ mbari nyi.<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>Kǝ Shatan na anǝ nyi, “Ma nagǝ ngǝ zǝr Hyal, ga nar nyi anǝ tsǝka kau, aga ja sha aga macikǝl.”<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>Kǝ Yesu shaɗǝwa, ji na, “Tsǝtsǝfǝ nga nyi wu ndǝr Hyal abǝr,</para>
  <para style="q1" vid="LUK 4:4">“ ‘Aˈyi ǝnga sǝr sǝm wacu ngǝ ndǝ</para>
  <para style="q2" vid="LUK 4:4">wu nggya ǝnga pi mai.’ ”<verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>Kǝ Shatan hǝr nyi a dar vi kǝra dzǝgamǝ gagaɗau, ka canǝ nyi patǝkura tǝlkur nǝ duniya, ǝnga sǝra a gwa patǝ nǝ pǝci kushu. <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>Kǝ ji na anǝ nyi, “Yi wu nǝ ngǝ dǝnama tǝlkur ǝnga kadakadarkur sǝˈyar kǝ patǝu, arya anǝ ɗar nji, yu sǝni nǝ nyi anǝ kalar ndǝra yu yiwu tsu. <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>Ma gǝ nǝ ɗa dǝgalkur, sǝˈyar kǝ patǝ wu ɗa nǝngau.”<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>Yesu na anǝ nyi, “Tsǝtsǝfǝ nga nyi abǝr,</para>
  <para style="q1" vid="LUK 4:8">“ ‘Ga dlǝvǝ Hyal Thlagǝ ngau,</para>
  <para style="q2" vid="LUK 4:8">ba tsu naja zhizhi nyi wacu</para>
  <para style="q1" vid="LUK 4:8">nga ga mǝl sǝra</para>
  <para style="q2" vid="LUK 4:8">ja yiwu.’ ”<verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>Shatan ɓǝra hǝr nyi a vu Urshalima, ba ji hǝri nyi a dar kǝra ki Hyal a dar vira ndiya ǝnga dzǝgamǝu. Kǝ ji na anǝ nyi, “Ma nagǝ ngǝ zǝr Hyal, ga vǝl a gyiwu ˈyi sara ǝnggau, <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>arya tsǝtsǝfǝ nga nyi wu ndǝr Hyal, abǝr,</para>
  <para style="q1" vid="LUK 4:10">“ ‘Ju sǝwa waladi nyiˈyar</para>
  <para style="q2" vid="LUK 4:10">aga nda ɓǝlar ngau.<verse eid="LUK 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11"/>Ndu sǝɓiya ngu tsa nda</para>
  <para style="q2" vid="LUK 4:11">ara ga sara dǝgǝri hiya gǝ ar tsǝka.’ ”<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>Ama Yesu na nǝ nyi, “Tsǝtsǝfǝ nga nyi abǝr,</para>
  <para style="q1" vid="LUK 4:12">“ ‘Ga sara dzǝ</para>
  <para style="q2" vid="LUK 4:12">Hyal Thlagǝ ngǝ mai.’ ”<verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>Ənggǝra Shatan kuɗǝna dzǝ nyi wu lagu pamǝpamǝ patǝu, ba ji piyari nyi nǝ pǝci kushu ju sǝkǝ vanyi pǝci ǝnga ja.<verse eid="LUK 4:13"/></para>
  <para style="s1">Nji Piyari Shishir Dza Yesu A Vu Nazǝratu</para>
  <para style="r">(<ref loc="MAT 4:12-17">Matiwu 4:12-17</ref>; <ref loc="MRK 1:14-15">Markusu 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>Yesu sha a vu Galili, ǝnga dǝnama nǝr Mambǝl nga ja, ndǝr ar kǝra ja a tǝtǝlnar kǝr a ndu mǝlmǝ pamǝpamǝ patǝu, <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>ja vǝr highiɓau wu umbwa daɓǝ dzǝ njir Yahudi, nji patǝ a vǝr fal nyi.<verse eid="LUK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>Ənggau, kǝ ji maˈyi a vu Nazǝratu, mǝlmǝ kǝra ji hau a gwa. Pǝcir Ɓǝlsar, ba ji maˈyi a gwu umbwa daɓǝ dzǝ njir Yahudi, ǝnggǝra ji tsǝliya. Ji hyaˈari aga jiga ndǝr Hyal. <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>Kǝ nji nǝ nyi lǝkakaɗǝ nǝ Hyal nǝ tsǝfǝ Nabi Əshaya. Kǝ ji pahǝna ba ji uya vi kǝra nji tsǝfǝya abǝr,<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>“Mambǝl Thlagǝ</para>
  <para style="q2" vid="LUK 4:18">aˈyi ar kǝra yau,</para>
  <para style="q1" vid="LUK 4:18">kǝra caɗǝbiya ɗa</para>
  <para style="q2" vid="LUK 4:18">aga ya tǝtǝlna ndǝr mǝsahǝu</para>
  <para style="q1" vid="LUK 4:18">anǝ njira ǝnga dǝnama tǝtǝwa.</para>
  <para style="q1" vid="LUK 4:18">Ji sǝwa ɗa aga ya nar nyi</para>
  <para style="q2" vid="LUK 4:18">anǝ njira wu fursǝna</para>
  <para style="q1" vid="LUK 4:18">pǝcir pǝl nda a ɗari,</para>
  <para style="q2" vid="LUK 4:18">nji lǝfau nda sa lar sau,</para>
  <para style="q1" vid="LUK 4:18">ba tsu ya pǝlna</para>
  <para style="q2" vid="LUK 4:18">nji mbamba.<verse eid="LUK 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19"/>Ji sǝwa ɗa aga ya nar nyi</para>
  <para style="q2" vid="LUK 4:19">anǝ kalar ndau, abǝr,</para>
  <para style="q1" vid="LUK 4:19">pǝci kǝra Thlagǝ nana</para>
  <para style="q2" vid="LUK 4:19">ja sa canǝ nyi</para>
  <para style="q2" vid="LUK 4:19">mǝnahǝkur nyi</para>
  <para style="q1" vid="LUK 4:19">anǝ nji patǝ a shiliri.”<verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>Ayukuɗa ji jigana, ba ji pǝɗiya lǝkakaɗa nyi ba ji dzǝgwa nǝ nyi anǝ ndǝr mǝl thlǝr wu umbwa daɓǝ dzǝ njir Yahudi, ba ji nggya gya. Patǝkura njira a gwu umbwa daɓǝ dzǝ njir Yahudi kau, ba ndǝ pǝnggǝri nyi li. <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>Kǝ ji na anǝ nda, “Ndǝr Hyal kǝ tsǝtsǝfǝ kau, a nyabiyar dzǝ wu himiya hyi ǝshina.”<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>Patǝr njira ar vi ta nana ndǝr kǝra mǝnahǝu ar kǝra ja, ba ɓǝra ɗa sǝ dǝdǝgur anǝ nda ǝnga sǝra wu biya sara wu miya ja, ndǝ dzǝgwa yiwa, “Kar ndangǝ ya, aˈyi zǝr Yusufu ta ngǝ wa?”<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>Kǝ Yesu na, “Anǝ nda a sǝni yau, hyu yiwu hya nar ɗa karapǝ kau, abǝr ‘Ligǝta, mbǝɗana kǝrngau.’ Mǝliya sǝ kǝra ˈyi nggari gǝ mǝliya wu Kafarnahumu, ǝnggau, wu mǝlmǝ ngǝ kǝ ɗǝm.” <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>Ji ɓǝra na anǝ nda, “Jirkura nyi, ca ngǝ nabi naja aˈyi ndǝra nji dlǝwuri wu mǝlmǝ nyi mai.”<verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25"/>“Ya nar hyi jiri, wu pǝcir nabi Iliya mathlǝkǝˈyi tǝsal aˈyi gangǝu wu ˈyiˈyir Izirayila, ǝnggǝra Hyal haɗiya mǝlmau, par aˈyi mai nǝ fa makǝru ǝnga hya kwa, wuɓau aˈyi wu ˈyiˈyi ta gagaɗau. <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>Ama Hyal aˈyi sǝwa Iliya a ndǝra zǝma nda mai, ama a ndu mǝlmǝ Zarafatu wu ˈyiˈyir Sidonu, a ndǝra mala tǝsal kǝra wu mǝlmǝ ta. <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>Wu pǝcir nabi Elisha tsu, njir pibi aˈyi gangǝu wu ˈyiˈyir Izirayila, Zǝma nda aˈyi uya cicikur mai kǝl Naˈamanu ndǝr Suriya wacu.”<verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>Ta njira wu umbwa daɓǝ dzǝ njir Yahudi kǝ nggari ndǝr kau, ba ndzana huɗa nda gagaɗau.<note caller="+" style="f"><char style="fr" closed="false">4:28 </char><char style="ft" closed="false">Sǝra ndzana ɗǝfuwa nda ca ngau ndǝ sǝnbiya abǝr Yesu aˈyi wu nda mǝl sǝ dǝdǝgur wu mǝlmǝr nda mai.</char></note> <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>Ndǝ hyaˈari ndǝ tǝɗǝbiya nyi a biyar ya mǝlmau, ndǝ maˈyi ǝnga ja a dar kǝra mau kǝra ndǝ hǝriya mǝlmǝr nda a dari, aga nda vakana nyi a gyiwu ˈyi. <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>Kǝ Yesu biya wu pama nda, ba ji mbari lagu nyi ba ji mai sǝ nyi.<verse eid="LUK 4:30"/></para>
  <para style="s1">Yesu Kǝdlǝbiya Mambǝl Ɗǝmwaˈyu Sara Wu Dza Ndau</para>
  <para style="r">(<ref loc="MRK 1:21-28">Markusu 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>Abangǝ tsu, kǝ Yesu sha shili wu Kafarnahumu, mǝlmǝ kǝra wu ˈyiˈyir Galili, ar Pǝcir Ɓǝlsar, kǝ ji dumwa ǝnga highiɓau, anǝ nji. <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>Kǝ highiɓǝ kǝ ɗa sǝ dǝdǝgur anǝ nji patǝ ara ǝnggǝra ndǝr nyi wu biya ǝnga dǝnama. <verse eid="LUK 4:32"/><verse number="33" style="v" sid="LUK 4:33"/>Wu umbwa daɓǝ dzǝ njir Yahudi kau, vanyi ndǝ aˈyi ǝnga mambǝl ɗǝmwaˈyu, ba ji hyaˈana ɗahǝu ǝnga dǝnama ji na, <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>“Wa yau! Yesu ndǝr Nazǝratu, mi dzǝ ngǝ ǝnga ˈya? Kari gǝ shili aga ga sa kuɗǝna ˈya ya? A sǝni ngǝ yau, nagǝ ngǝ ndǝ cici nǝ Hyal!”<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>Əngwar Yesu anǝ nyi ǝnga dǝnama, “Haɗiya miya gau! Biya wu dza ja!” Kǝ mambǝl ɗǝmwaˈyi kǝ mbilna ndǝ kau, a gyiwu ˈyi wu dzǝri nda patǝu, kǝ ji biya sara wu dza ja gǝra ɓǝra uya nyi ǝnga shilǝgǝu.<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>Kǝ ɗa sǝ dǝdǝgur anǝ nji patǝu, ndǝ na wu pama nda, “Abari dur gǝ highiɓǝ ka? Ənga dǝgalkur, ǝnga dǝnama nga ja vǝr ndǝr anǝ mambǝl ɗǝmwaˈyiˈyar, ba nda biya!” <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>Ənggǝ ngǝ ndǝr ar kǝra Yesu tǝtǝlnakǝr a ndu mǝlmǝ patǝ wu ˈyiˈyi kau.<verse eid="LUK 4:37"/></para>
  <para style="s1">Yesu Dlǝwari Nji Gangǝu</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matiwu 8:14-17</ref>; <ref loc="MRK 1:29-34">Markusu 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>Yesu biya sara wu umbwa daɓǝ dzǝ njir Yahudi, ji maˈyi a vu ki Simanu. Sǝlkuya Simanu aˈyi ngga mai, gyangǝ nga vǝr tǝ nyi dǝdǝgalǝu. Kǝ ndǝ yiwa Yesu aga ja dlǝwari nyi. <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>Yesu taˈyi ar kǝra ja, ji kughi anǝ gyangǝ kau, kǝ gyanga nyi biya ka piyari nyi. Fina dzǝ aˈyi mai kǝ ji hyaˈari ba ji mǝliya nda sǝr sǝm.<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>Ənggǝra pǝci wu gya tǝɗau, kalar ndǝ kǝra ndǝ gǝra ngga ara ja, ndǝ shili ǝni anǝ Yesu, ba ji fǝri nda tsi patǝu, ba ndǝ ɗa jamǝu. <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>Patǝr njira ǝnga mambǝl ɗǝmwaˈyi wu dza nda ndu biya ndu wau anǝ nyi, ndu na, “Na gǝ ngǝ zǝr Hyal!” Kǝ Yesu kughi anǝ nda, ji kari nda ara ndǝr, ara ndu sǝni naja ngǝ Kǝrsiti.<verse eid="LUK 4:41"/></para>
  <para style="s1">Yesu Tǝtǝlna Ndǝshigu <optbreak/> Wu Umbwa Daɓǝ Dzau Nǝ Njir Yahudi</para>
  <para style="r">(<ref loc="MRK 1:35-39">Markusu 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>Əmudlǝkura nyi, kǝ Yesu hyaˈari ji maˈyi a biyar ya mǝlmau, a biyar vi kǝra nji aˈyi mai. Nji biya ga gal nyi ba ndǝ thlǝwa nyi, ndǝ ɗa aga nda kari nyi ara piyari mǝlmǝr nda. <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>Ama Yesu na anǝ nda, “A ɗar thlǝr ɗa ya maˈyi a ndu alenyi mǝlmǝ aga ya nda tǝtǝlna ndǝshigu mǝsahǝu nǝ tǝlkur Hyal anǝ alenyi nji tsu. Agabangau, nga nji sǝwa ɗa a shili wu duniya.”<verse eid="LUK 4:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44"/>Ənggau, Yesu ɓǝbiya ɓau wu patǝr ˈyiˈyir Yahudi, ja vǝr highiɓǝ wu umbwa daɓǝ dzǝˈyar, ja vǝr tǝtǝlna ndǝshigu ar kǝra tǝlkur Hyal. Ba ǝnga ja vǝr shilǝgǝbiya kalar shilǝgǝu ǝnga njira gǝra ngga.<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">Yesu Ngga Zǝmbǝlma Nyiˈyar <optbreak/> Nǝ Tanggǝrma</para>
  <para style="r">(<ref loc="MAT 4:18-22">Matiwu 4:18-22</ref>; <ref loc="MRK 1:16-20">Markusu 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>Vanyi pǝci aˈyi Yesu taˈyi ar dza dǝl nǝr Janisaratu,<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Vanyi thlǝmǝ nǝr dǝl Galili ngau.</char></note> nji gangǝu ndǝ ciɗǝ nyi ndu yiwu nda nggari ndǝr Hyal. <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>Kǝ ji lari kwambwal mǝthlǝ a biyar dza dǝl kǝra njir tǝm fiya ndǝ maˈyi a nda ci litagǝr nda. <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>Kǝ ji maˈyi a gwu kwambwal pathlǝu kǝra nǝ Biturusu ngau, ji dzǝgwa kǝdi nyi aga ja ɓari nyi kushu sara miya dǝl. Kǝ ji nggya a gwa ja vǝr highiɓǝ anǝ nji.<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>Ənggǝra ji kuɗǝna ndǝr, kǝ ji na anǝ Biturusu, “Ga ɓǝra ɓari kwambwal kau a gwar vi kǝra dzǝgamǝu, ba hya sǝya litagǝr hyiˈyar, aga hya tǝɗǝbiya kalfi.”<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>Əngwar Biturusu, “Thlagǝr ki, a pidari ˈya ghǝmǝ a vǝr tǝm ama naˈya aˈyi mbari sǝ mai. Ama ˈyu sǝya litagǝr ˈya a gya, ma nagǝ ngǝ na.” <verse eid="LUK 5:5"/><verse number="6" style="v" sid="LUK 5:6"/>Ənggǝra ndǝ sǝya litagǝr nda a gya, ba ndǝ mbari kalfi gangǝu, kǝl ta litagǝr nda mbar thlǝthlau. <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>Ta ndǝ lari abangau, ba ndǝ ngga bazhi tǝmǝr nda sara wu vanyi kwambwal ta aga nda sa dlǝwari nda. Ba ndǝ shili ndǝ sa nyanyana kwambwalˈyar gyapǝ ǝnga kalfi. Ba kwambwalǝr nda mbar gya cau ara tǝdǝɓǝu. <verse eid="LUK 5:7"/><verse number="8" style="v" sid="LUK 5:8"/>Ənggǝra Biturusu lari sǝ kau, kǝ ji ɓǝliya undi a dumwar Yesu, ji na, “Tǝkǝ ǝnga yau, Thlagǝu! Nayi ndǝr bikǝ ngau!”<verse eid="LUK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9"/>Ba sǝ kǝ ɗa sǝ dǝdǝgur anǝ nyi ǝnga bazhi nyiˈyar patǝu, ara gangǝkura kalfi kǝra ndǝ mbari, <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>abangǝ tsu ngǝ Yakubu ǝnga Yahwana, wazha Zabadi, bazhi mǝl thlǝr Biturusu ˈyar. Əngwar Yesu anǝ Biturusu, “Ga sara hivǝr mai, mbari ǝshina, gu ɗa ndǝr tǝm nji ama aˈyi kalfi mai.”<verse eid="LUK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11"/>Kǝ ndǝ tǝɗǝbiya kwambwalǝr nda a biyar miya dǝl, ba ndǝ piyari litagǝr nda, ba ndǝ nu nyi.<verse eid="LUK 5:11"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Ndǝr Pibi</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matiwu 8:1-4</ref>; <ref loc="MRK 1:40-45">Markusu 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>Ar pǝci kǝra Yesu wu vanyi mǝlmau, kǝ vanyi ndǝ kǝra pibi sǝmku dǝnama nyi shili ara ja. Ənggǝra ji lari Yesu, kǝ ji dla ǝnga bama ja a gyiwu ˈyi ja vǝr kǝdi nyi, ji na, “Thlagǝu, ma gu yiwu, gu sǝni cina ɗa aga ya ɗa jamǝu.”<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>Kǝ Yesu har tsi ka tsǝkwar nyi, ji na anǝ nyi, “A hǝnggǝr yau, ɗa cicau.” Ənggǝrna, ba pibiya nyi piyari nyi. <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>Kǝ Yesu nar nyi ǝnga ɗahǝu, “Ga hangǝkal ga sara na sǝ kǝ anǝ ndǝ mai. Ama ga maˈyi a ndǝgya pubu ga nda canǝ nyi kǝrngau, ga dzǝgwa kǝbǝna sau ǝnggǝra dlaɗǝ Musa nana nja mǝl aga ci dzau. Ga mǝliya abangǝ aga ga cabiya nyi anǝ nji abǝr a ɗar gǝ jamǝu.”<verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>Ama alaga abangau, kǝl dumwa ǝnga cakau, ngǝ ndǝr ar kǝra Yesu wu cakau. Nji gangǝ tsu a vǝr shili ǝgya ja aga nda nggari highiɓǝ nyi ba ji shilǝgǝbiya nda sara ara shilǝgǝr nda pamǝpamǝu. <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>Ama Yesu, ju maˈyi a biyar ya mǝlmǝ a biyar vi kǝra nji aˈyi mai aga ja ndǝr ǝnga Hyal.<verse eid="LUK 5:16"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Ndǝ Tǝsǝkǝnu</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matiwu 9:1-8</ref>; <ref loc="MRK 2:1-12">Markusu 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>Vanyi pǝci ǝnggǝra ja vǝr dumwa ǝnga highiɓau, njir Farisi ǝnga malǝmǝ dlaɗǝ sara wu mǝlmǝ pamǝpamǝ nǝr ˈyiˈyir Galili, ǝnga ˈyiˈyir Yahudi ǝnga ˈyiˈyir Urshalima, a vǝr nggya ǝna. Dǝnama nǝ Thlagǝ aˈyi ǝnga ja, aga shilǝgǝbiya nji kǝra gǝra ngga. <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>Kǝ alenyi nji shili ǝnga ndǝ tǝsǝkǝnu, nda vǝr hǝ ar sǝr pida. Ndu yiwu nda hǝri nyi a vu ki, aga nda vuwa pina nyi wu mwar Yesu. <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>Ənggǝra ndǝ gal lagu katini ara gangǝkura nji, ba ndǝ maˈyi a dar kǝra umbwa ndǝ da pahǝna ba ndǝ dzǝgwa fuwa nyi a gya lagu kǝra umbwa a gyiwu hada dlami, kakalǝ wu mwar Yesu. <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/>Ənggǝra Yesu lari mbǝrsar nda, kǝ ji na, “Bazhi, a tǝfǝbiya ngǝr nji bikǝ ngau.”<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>Njir Farisi ǝnga malǝmǝ dlaɗǝˈyar nda vǝr ɗǝnga wu pama nda, “Wa ngǝ ndǝ kǝ wu ndǝr ɗǝmwaˈyi ar kǝra Hyal ka? Wa ngu sǝni tǝfǝbiya bika, aˈyi kǝl Hyal zhizhi nyi wa?”<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>Ənggǝra Yesu wu sǝnbiya sǝra ndu ɗǝnga, kǝ ji na anǝ nda, “Mi ngǝ ɗa hyu ɗǝnga sǝˈyar kǝ wu ɗǝfuwa hya? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>Mani nga ndiya ǝnga ɓatsa? Nja na, ‘A tǝfǝbiya ngǝr nji bikǝ ngau,’ ǝndǝga, ‘Hyaˈari ga ɓǝ ya’? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>Ama yu yiwu hya sǝni, abǝr Zǝr Ndǝ aˈyi ja ǝnga dǝnama nǝr tǝfǝbiya bikau wu duniya.” Kǝ ji na anǝ ndǝr tǝsǝkǝnu, “Yu na anǝ ngau, hyaˈari, ga hǝr sǝr pida ngau ga maˈyi a ndu ki.”<verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>Ənggau, kǝ ji hyaˈari ǝnga kusa wu mwar nji patǝu, kǝ ji hǝri sǝra ja vǝr pida ar ta, ba ji maˈyi a vu ki ja vǝr fal Hyal. <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>Ba sǝ ɗa sǝ dǝdǝgur anǝ nda patǝu. Ba ndǝ dzǝgwa nǝ nyi dlǝvǝ anǝ Hyal. Kǝ hivǝr mbari nda gagaɗau, ndu na, “A lari ˈya sǝ dǝdǝgur ǝshina.”<verse eid="LUK 5:26"/></para>
  <para style="s1">Yesu Ngga Lawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matiwu 9:9-13</ref>; <ref loc="MRK 2:13-17">Markusu 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>Ayukuɗa kau, Yesu maˈyi a biya, kǝ ji lari ndǝr tsǝm budau kǝra nja ngga ǝnga Lawi a vǝr nggya ar vi tsǝm budǝ nyi. Əngwar Yesu anǝ nyi, “Nu ɗa.” <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>Kǝ Lawi hyaˈari, ji piyari sǝra ja vǝr mǝl patǝu, ba ji nu nyi.<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>Ayukuɗa nyi, kǝ Lawi mǝliya sǝr sǝm nǝr mini wu ki nyi, kǝ ji nggari Yesu ar viya mǝthlǝpi dǝgal, njir tsǝm budǝ gangǝu ǝnga alenyi mǝthlǝpiˈyar nda vǝr sǝm sǝr sǝm ar vi zǝmǝu. <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>Kǝ njir Farisi ǝnga malǝmǝ dlaɗǝˈyar kǝra mbǝrsar nda zǝmǝ ndǝ dzǝguya jiga miya anǝ zǝmbǝlma nyiˈyar, “Mi ngǝ ɗa hyu sǝm hyu sa ǝnga njir tsǝm budǝ ǝnga njir bika?”<verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>Əngwar Yesu anǝ nda, “Aˈyi nji jamǝ ngu yiwu ligǝta mai, ama nji kǝra gǝra ngga. <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>Nayi aˈyi dla aga sa ngga nji cici mai ama njir bikau, aga nda tubi nda bǝlari nggyar nda.”<verse eid="LUK 5:32"/></para>
  <para style="s1">Yiwa Sau Ar Kǝra Hǝ Zǝmǝtsini</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matiwu 9:14-17</ref>; <ref loc="MRK 2:18-22">Markusu 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>Ndǝ na anǝ nyi, “Zǝmbǝlma nǝ Yahwana ndu hǝ zǝmǝtsini ar kǝr ar kǝr ǝnga ndu ndǝr ǝnga Hyal, abangǝ tsu ngǝ zǝmbǝlma nǝ njir Farisi, ama nǝngau ndu sǝm ǝnga sa parangǝu.” <verse eid="LUK 5:33"/><verse number="34" style="v" sid="LUK 5:34"/>Kǝ Yesu na anǝ nda, “Abǝr a sǝni kari nji bazhiya salkwanjili sǝr sǝm ma tsu nda ǝnga ja ya? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>Ama pǝci wu shili kǝra nju sa hǝna salkwanjili kǝ ara nda. Ar pǝci ta ndu nda hǝ zǝmǝtsini.”<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>Kǝ ji nar nda najaka karapau, ji na, “Ndǝr tar zhaɓi thlaɓǝu ar mafǝliyangǝ nga nyi, aga ja dzǝgwa ndaɓǝya ndǝɓǝ ǝni ar hahala nyi mai. Ma ji mǝl abangau, a ndzanar ja zhaɓi mafǝliyangǝ kau, ǝnga tsu ndǝɓǝ kau, wu ɗa didiɗi. <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>Ətsu ndǝr puwa ˈyimir inabi mafǝliyangǝ a gu pǝla hahal aˈyi mai. Ma ji mǝl abangau, ba ˈyimir inabi mafǝliyangǝ kau, a thlǝnakǝr, ba ja pǝthlǝna nyi, ba ˈyimir inabi kau, a pǝnakǝr ba pǝla ka ndzau. <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>ˈYimir inabi mafǝliyangǝ a gu pǝla mafǝliyangǝ nga nja pau. <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>Ətsu ndǝr nda yiwu sa ˈyimir inabi mafǝliyangǝ aˈyi ayukuɗa ji tuwari hahala nyi mai. Ju nda na, ‘Hahala nyi nga ndiya ǝnga mǝsahǝu.’ ”<note caller="+" style="f"><char style="fr" closed="false">5:39 </char><char style="ft" closed="false">Yesu nar nda karapǝˈyar kǝ patǝ aga ja cabiya abǝr highiɓǝ nǝr mafǝliyangǝ a daɓǝr kǝr ǝnga nǝ hahal mai.</char></note><verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">Yiwa Sau Ar Kǝra Ɓǝla Pǝcir Ɓǝlsar</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matiwu 12:1-8</ref>; <ref loc="MRK 2:23-28">Markusu 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>Vanyi pǝcir Ɓǝlsar nǝ Yahudiya, Yesu ǝnga zǝmbǝlma nyiˈyar nda vǝr tǝrabiya wu fa uhi. Nda vǝr ɓau, kǝ zǝmbǝlma nyiˈyar kuratsiya kǝra uhi. <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>Ənggǝra njir Farisi lari abangau, kǝ ndǝ na anǝ nyi, “Lari gǝyi, ara mi nga hyu mǝl sǝra dlaɗǝ kari nja mǝl pǝcir ɓǝlsar ra?”<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>Yesu shaɗǝwa nda, “Aˈyi hyi saya jigana sǝra Dawuda ǝnga njir ɓǝ nyi mǝliya ar pǝci kǝra wuɓǝ mbar nda ta wa? <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>Ənggǝra Dawuda gwu ki Hyal, naja ǝnga njir ɓǝ nyiˈyar, ǝnga ǝnggǝra ndǝ gwa sǝmku macikǝl cicau kǝra nandu kyaga sǝm mai, kǝl pubuˈyar wacu.”<verse eid="LUK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5"/>Kǝ Yesu na anǝ nda, “Zǝr Ndau Thlagǝ nga ja ar kǝra pǝcir Ɓǝlsar.”<verse eid="LUK 6:5"/></para>
  <para style="s1">Ndǝ Ənga Tsi Ndzǝndzau</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matiwu 12:9-14</ref>; <ref loc="MRK 3:1-6">Markusu 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>Ar vanyi pǝcir Ɓǝlsar nǝ njir Yahudiya tsu, kǝ Yesu maˈyi a gwu umbwa daɓǝ dzǝ njir Yahudiya ja vǝr highiɓau. Wu umbwa ta vanyi ndǝ aˈyi kǝra ǝnga tsi mazǝma ja ndzǝndzau. <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>Njir Farisi ǝnga malǝmǝ dlaɗǝˈyar a vǝr gal lagu kǝra nda sǝni vazǝya Yesu, ndǝ pǝnggǝri nyi li, nda vǝr tsamǝ tara ju mǝliya ndǝ kǝ jamǝ ar pǝcir Ɓǝlsar. <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>Ama Yesu wu sǝni sǝra ndu ɗǝnga, kǝ ji na anǝ ndǝ kǝ ǝnga tsi ndzǝndzǝ kau, “Hyaˈari ga taˈyi wu mwar nji patǝu.” Kǝ ji hyaˈari, kǝ ji taˈyi ǝna. <verse eid="LUK 6:8"/><verse number="9" style="v" sid="LUK 6:9"/>Ənggau, kǝ Yesu na anǝ nda, “Yi wu yiwa hyi, mi ngǝ tsaˈa nja mǝl pǝcir Ɓǝlsar ra? Sǝ mǝnahǝu, ǝndǝga sǝ ɗǝmwaˈyu? Nja mbǝɗana, ǝndǝga nja tsǝya?” <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>Ji tsamǝ a ndu pama nda patǝu, kǝ ji dzǝgwa na anǝ ndǝ kau, “Ndiɗǝbiya tsa gǝ a dumwa ngau.” Aga zǝmǝ kǝ ji ndiɗǝbiya tsa ja a dumwa nyi, ba tsa ja ɗa jamǝ ǝnggǝr vanyi zǝma nyi ta.<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>Ama kǝ huɗa nda ndzǝ gagaɗau, kǝ ndǝ dzǝgwa na anǝ kǝrnda, “Mi nga mǝna sǝni mǝl ǝnga Yesa?”<verse eid="LUK 6:11"/></para>
  <para style="s1">Yesu Caɗǝbiya Zǝmbǝlma Nyiˈyar <optbreak/> Kumou Apǝ Mǝthlǝu</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matiwu 10:1-4</ref>; <ref loc="MRK 3:13-19">Markusu 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>Vanyi pǝci, Yesu hyaˈari ba ji maˈyi a du mau, aga ja da ndǝr ǝnga Hyal a dǝna. Ji da pida ghǝmǝ ja vǝr ndǝr ǝnga Hyal. <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>Ənggǝra vi sa kuɗau, kǝ ji nggari zǝmbǝlma nyiˈyar a shili wu dzǝ nyi, kǝ ji dzǝgwa ɗǝmbiya kumo apǝ mǝthlǝ sara wu pama nda, kǝra ji ngga ǝnga cama sǝsǝˈyar. Kǝja thlǝmǝr nda,<verse eid="LUK 6:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="LUK 6:14"/>Simanu kǝra ji nǝ nyi thlǝmǝ Biturusu,</para>
  <para style="li1" vid="LUK 6:14">ǝnga zamǝ nyi Andǝrawusu,</para>
  <para style="li1" vid="LUK 6:14">ǝnga Yakubu,</para>
  <para style="li1" vid="LUK 6:14">ǝnga Yahwana,</para>
  <para style="li1" vid="LUK 6:14">ǝnga Fǝlipǝu,</para>
  <para style="li1" vid="LUK 6:14">ǝnga Bathlalomiyu, <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ǝnga Matiwu,</para>
  <para style="li1" vid="LUK 6:15">ǝnga Toma,</para>
  <para style="li1" vid="LUK 6:15">ǝnga Yakubu zǝr Alfawusu,</para>
  <para style="li1" vid="LUK 6:15">ǝnga Simanu ndǝra nju na ndǝ mǝlmǝ nyi,<verse eid="LUK 6:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="LUK 6:16"/>ǝnga Yahuda zǝr Yakubu,</para>
  <para style="li1" vid="LUK 6:16">ǝnga tsu Yahuda Isikarayoti ndǝra ɗǝlna Yesu anǝ dawa nyiˈyar.<verse eid="LUK 6:16"/></para>
  <para style="s1">Yesu Highiɓau Anǝ Nji <optbreak/> Ənga Tsu Ji Shilǝgǝbiya Nda</para>
  <para style="r">(<ref loc="MAT 4:23-25">Matiwu 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>Ji maˈyi ǝnga zǝmbǝlma nyiˈyar a gyiwu ˈyi, kǝ ndǝ thlǝwa babalǝr vi, ba ndǝ taˈyi ǝna ǝnga zǝmbǝlma nyiˈyar gangǝu, ǝnga nji gangǝ gagaɗau sara wu Yahudi, ǝnga Urshalima, ǝnga ˈyiˈyir Taya ǝnga Sidonu njira ǝnga kir nda a miya dǝl dǝgalǝu, <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>njira shili aga nda nggar highiɓǝ nyi ǝnga nja shilǝgǝbiya nda sara ara shilǝgǝr nda pamǝpamǝu. Njira ǝnga mambǝl ɗǝmwaˈyiˈyar wu lǝ ɓwaɓwatǝ anǝ nda, nanda tsu ndǝ uya jamǝkur, <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ǝnga nji gangǝu a vǝr mǝl lagu kǝra nda sǝni tsǝkwar nyi, ara dǝnama kǝra wu biya sara wu dza ja vǝr shilǝgǝbiya nda patǝu.<verse eid="LUK 6:19"/></para>
  <para style="s1">Barka Ənga Tǝhuɗǝu</para>
  <para style="r">(<ref loc="MAT 5:1-12">Matiwu 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>Ja vǝr tsamǝ zǝmbǝlma nyiˈyar, kǝ ji na,</para>
  <para style="q1" vid="LUK 6:20">“Barka anǝ hyi nahyi</para>
  <para style="q2" vid="LUK 6:20">nji kǝra gǝra sau,</para>
  <para style="q1" vid="LUK 6:20">tǝlkur Hyal a ɗar nǝr hyi.<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>Barka anǝ hyi</para>
  <para style="q2" vid="LUK 6:21">njira ǝnga wuɓau kabangǝkau,</para>
  <para style="q1" vid="LUK 6:21">nju nda nyana hyi.</para>
  <para style="q2" vid="LUK 6:21">Barka anǝ hyi</para>
  <para style="q1" vid="LUK 6:21">njira vǝr tiwi kabangǝkau,</para>
  <para style="q2" vid="LUK 6:21">hyu nda nggushi.<verse eid="LUK 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22"/>Barka anǝ hyi</para>
  <para style="q2" vid="LUK 6:22">ma nji gǝra yiwu hyi,</para>
  <para style="q1" vid="LUK 6:22">nda hǝbiya hyi a biya,</para>
  <para style="q2" vid="LUK 6:22">ǝnga nda nggǝl hyi,</para>
  <para style="q1" vid="LUK 6:22">ba ǝnga nda ndzana thlǝmǝr hyi,</para>
  <para style="q2" vid="LUK 6:22">arya Zǝr Ndau.”<verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>“Abangǝ ngǝ ǝjir nda mǝl anǝ nabiˈyar kǝra tǝrabiya. Ga caguli ǝnga ga nggya ǝnga huɗǝ pǝrtǝu, ara gu nda uya akkǝri gangǝ a dǝmǝlmau.”<verse eid="LUK 6:23"/></para>
  <para style="s1">Ɓwaɓwatǝˈyar Pamǝpamǝu</para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>“Ama kawa anǝ hyi</para>
  <para style="q2" vid="LUK 6:24">nahyi bǝrba,</para>
  <para style="q1" vid="LUK 6:24">arya a dlǝwuri hyi</para>
  <para style="q2" vid="LUK 6:24">nǝr hyi mǝsahǝkur kabangǝkau.<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>Kawa anǝ hyi,</para>
  <para style="q2" vid="LUK 6:25">nahyi kǝra nyinyau kabangǝkau,</para>
  <para style="q1" vid="LUK 6:25">hyu nda</para>
  <para style="q2" vid="LUK 6:25">nggya ǝnga wuɓau.</para>
  <para style="q1" vid="LUK 6:25">Kawa anǝ hyi</para>
  <para style="q2" vid="LUK 6:25">nahyi kǝra a vǝr nggushi kabangǝkau,</para>
  <para style="q1" vid="LUK 6:25">hyu nda ɗa ǝnga</para>
  <para style="q2" vid="LUK 6:25">huɗǝ ndzǝndzau hya ɓǝra tiwi.<verse eid="LUK 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26"/>Kawa anǝ hyi</para>
  <para style="q2" vid="LUK 6:26">ma nji patǝ a vǝr fal hyi,</para>
  <para style="q1" vid="LUK 6:26">abangau nga ndǝ mǝl</para>
  <para style="q2" vid="LUK 6:26">anǝ nabi fatiˈyar.”<verse eid="LUK 6:26"/></para>
  <para style="s1">Hya Canǝ Nyi Yiwukur <optbreak/> Anǝ Dawar Hyi</para>
  <para style="r">(<ref loc="MAT 5:38-48">Matiwu 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>“Ama ya nar hyi, nahyi kǝra wu nggari ndǝr ɗa, hya canǝ nyi yiwukur anǝ dawar hyi, hya mǝl mǝnahǝkur anǝ njira gǝra yiwu hyi. <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>Fǝnggǝr nyi barka anǝ njira wu shiˈwa hyi, hya ndǝr anǝ Hyal arya njira wu lǝ ɓwaɓwatǝ anǝ hyi. <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>Ma ndǝ nǝ ngǝ dǝgau ari balma gau, shabiya nyi vanyi balma tsu. Ma ndǝ mbǝliya nggamndǝ ngau, ga sara ka lǝgutǝ ha kǝra vuwa gwa anǝ nyi mai.<note caller="+" style="f"><char style="fr" closed="false">6:29 </char><char style="ft" closed="false">Nggamndǝ wu pama njir Yahudiya sǝr mbudzǝ uvuˈyi ngau. Ma gǝ dlǝwuri mǝl ara ndau gu sǝni nǝ nyi nggamndǝ ngau ǝpuci ama uvuˈyi ba ja shabiya ngǝ sǝ ngau. Ama wu highiɓǝ Yesu gu sǝni piyari alaga sǝra nǝ ngau aga ja.</char></note> <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>Nǝ nyi anǝ kalar ndǝra kǝdi ara gau, ma tsu ndǝ mbǝliya sǝ ngau ga sara yiwa ja shabiya ngǝ a shili mai. <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>Sǝra hyu yiwu nja mǝl anǝ hyi, nahyi tsu ca nga hya mǝl anǝ nda.<verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>“Ma njira vǝr yiwu hyi nga hyu yiwu wacu, wathlǝmǝ culi akkǝri kǝra hyu nda uya? Alaga njir dlǝwu budǝ ma tsu, ndu mǝl abangau. <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>Ma gu ca mǝnahǝkur anǝ njira wu ca mǝnahǝkur anǝ ngau, mi nga ju cakǝri nga? Əkkǝˈyi njir bikǝ ma ndu mǝl abangau. <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>Ma gǝ nǝ nyi mǝl anǝ njira gu sǝni ndu nda kina ngau, mi nga ju cakǝri nga? Alaga njir bikǝ ndu lǝ mǝl anǝ njir bikǝ kuvwar nda ǝnga sǝni ndu nda kina patǝu. <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>Ama ga ca yiwukur anǝ dawa ngau, ga mǝl mǝnahǝkur anǝ nda, ga nǝ nda mǝl ǝnga sǝni abǝr nandǝ wu nda kina ngǝ mai. Mǝl abangǝ wu mǝliya hyu uya nubwa gangǝu, ǝnga hyu sa ɗa ǝnggǝr wazha Hyal kǝra a dǝmǝlmau, arya naja ǝnga tǝhuɗǝu, anǝ nji kǝra sǝni na usi ǝnga nji ɗǝmwaˈyu. <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>Ga nggya ǝnga tǝhuɗǝ ǝnggǝr kǝra dǝngau kǝra a dǝmǝlmau ǝnga tǝhuɗǝu.”<verse eid="LUK 6:36"/></para>
  <para style="s1">Hya Sara Vazǝ Ndǝ Mai</para>
  <para style="r">(<ref loc="MAT 7:1-5">Matiwu 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>“A sara hya thla numa ar kǝra nji mai, nji tsu aˈyi ndu thla numa ar kǝra hyi mai. A sara hya lǝ vazǝ anǝ ndǝ mai, nji tsu ndu nda lǝ vazǝ anǝ hyi mai. Tǝfǝbiya mǝ nji, Hyal tsu ju nda tǝfǝbiya hyi. <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>Hya lǝ sau, nahyi ma ba nja nǝ hyi sau, cala tǝkǝ sǝ nyinyi tsuyu, nja cicina a gya, nja ɓǝra favǝɗiya, ja dzǝgwa pǝpau a gyar dza nyi, nja dzǝgwa puwa ngau a gyar dza gau, arya a ɗar cala tǝkǝ sǝ kǝra hyi tǝkǝ sǝ ǝni anǝ nji, ca nga nju nda tǝkǝ sǝ ǝni anǝ hyi.”<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>Kǝ ji ɓǝra nar nda najaka karapau, “Ndǝ lǝfau a sǝni lǝbiya ndǝ lǝfǝ ya? Ma ndǝ mǝl abangau, nanda gyapǝu, aˈyi ndu nda tǝɗau a gyiwu kaˈu wa? <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>Ndǝra nju highiɓǝ anǝ nyi, aˈyi ju ndiya malǝmǝ nyi mai, ama kalar ndǝra nji highiɓǝri nyi mǝnahǝu, ju sǝni ɗa ǝnggǝr malǝmǝ nyi.<verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>“Ara mi nga gu lari zǝr sar kǝra wu liya zamǝ ngau, ama na ga sǝn tsamiya gwalang kǝra ar liya gǝ kǝ maya? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>Abari nga ga sǝn na anǝ zamǝ ngau, abǝr, zamǝ ɗa, ‘Taˈyau, ya hǝbiya ngǝ zǝr sar kǝra wu liya gau,’ ya, kǝja gwalang ngǝ ar liya ga? Nagǝ ndǝr ngguta vi, ga hǝbiya gwalang kǝra ar liya gǝ kwatahǝu, aga ga daɓaga lari mǝnahǝu, ba ga sǝn hǝbiya zǝr sar kǝra wu liya zamǝ ngǝ kau.<verse eid="LUK 6:42"/></para>
  <para style="s1">Nji Wu Tsamǝr Wu Ar yaya Nyi</para>
  <para style="r">(<ref loc="MAT 7:16-20">Matiwu 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>“Abangǝ tsu, kalar wu mǝnahǝu, ju ya wazha mǝnahǝu, wu kǝra gǝra mǝnahǝ tsu, ju ya wazha kǝra gǝra mǝnahǝu. Wu kǝra mǝnahǝu, a sǝn yabiya wazha kǝra gǝra mǝnahǝ mai, abangǝ tsu, wu kǝra gǝra mǝnahǝu, a sǝn yabiya wazha mǝnahǝ mai. <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>Ar yaya nyi nga nju tsamǝ ri wu. Nja sǝni ɗǝm bǝla ar wur shikǝɗi mai, alaga ndǝrma ar hudi mai. <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>Ndǝ mǝnahǝu, ju biya ǝnga ndǝr mǝnahǝu sara ar vira ji ɗǝwana ari, ǝnga ndǝ ɗǝmwaˈyu, ju biya ǝnga ndǝr ɗǝmwaˈyu sara ar vira ji ɗǝwana nda ari.”<verse eid="LUK 6:45"/></para>
  <para style="s1">Njir Hǝri Ki Pamǝpamǝu Mǝthlǝu</para>
  <para style="r">(<ref loc="MAT 7:24-27">Matiwu 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>“Ara mi nga hyu ngga ɗa, ‘Thlagǝu, Thlagǝu,’ ama kǝ hyi nggǝl ara mǝl sǝra yu na anǝ hya? <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>Kalar ndǝra shili ara yau, ba ji sǝya himi anǝ sǝra yu na, ǝnga ju mǝl thlǝr ǝni, yu nda nar hyi sǝra ju pa. <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>Naja ǝnggǝr ndǝr hǝr ki, kǝra labiya kaˈu dzǝgamǝ a gyiwu ˈyi, kǝ ji dzǝguya hǝr ǝnga fǝhi hǝr ar pathlara mau. Ənggǝra dǝl nyau, kǝ ˈyimi tsaɓǝri ki ta, ama naja aˈyi sǝni kǝnggǝɗǝr nyi mai arya nji fǝr hiya nyi ar pathlara mau. <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>Ama ndǝra wu nggari ndǝr ɗa, ama naja aˈyi wu mǝl thlǝr ǝni mai, kakalǝ nga ja ǝnga ndǝr hǝr ki ar vi kǝra nji gǝra labiya kaˈu nǝ fǝ hiya hǝra nyi. Ənggǝra dǝl nyau, kǝ ˈyimi tsaɓǝri ki kau, kǝ ki kǝ dla, dla nyi tsu ɗǝmwaˈyi gagaɗau.”<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">Yesu Mbǝɗana Mafa <optbreak/> Nǝ Dǝgalǝr Soja Roma</para>
  <para style="r">(<ref loc="MAT 8:5-13">Matiwu 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>Ənggǝra Yesu kuɗǝna na sǝˈyar kǝ patǝ anǝ nji, ba ji maˈyi a vu Kafarnahumu. <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>A vuna, kǝ ja vanyi dǝgalǝri soja nǝ Roma kǝra mafa nyi aˈyi gǝra ngga gagaɗau, kǝra a vǝr gal lagur tau. Soja dǝgal nǝ Roma kau, ja vǝr yiwu mafa nyi kǝ gagaɗau. <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>Ənggǝra ji nggar ndǝr ar kǝra Yesu, ba ji sǝwa alenyi nji nggunggurǝm nǝ Yahudiya aga nda kǝdi nyi ja shili, ja sa mbǝɗana mafa nyi kau. <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>Nji nggunggurǝmˈyar kǝ maˈyi a ndǝra Yesu ndǝ nda kǝdi nyi gagaɗau, nda vǝr na, “Ndǝ kau, ndǝ mǝnahǝu ngau, kakalǝ nga nyi ga dlǝwari nyi. <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>Nda nyi a yiwu ja njir ˈya, ba ǝnga ji hǝriya ˈya umbwa daɓǝ dzau.” <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/>Ba Yesu maˈyi ǝnga nda.</para>
  <para style="p" vid="LUK 7:6">Ənggǝra ji shili lǝhǝu wu dzǝri ki nyi, kǝ dǝgalǝri soja nǝ Roma hyabiya bazhi nyiˈyar aga nda nar nyi anǝ Yesu, “Thlagǝu, ga sara hǝɗana kǝrngau aga yi mai, arya nayi aˈyi ɗa tsaˈa ga shili wu ki ɗa mai. <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>Ca ngǝ mǝliya nayi aˈyi sǝni shili ǝgya gǝ mai, ama ga nana ndǝr sǝ nyi, ba zǝr ɗa uya jamǝkur. <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>Arya nayi ǝnga kǝrɗa ma ǝgya ndǝ dǝgal nga yau, ǝnga tsu sojaˈyar aˈyi kǝra ǝgya kiɗa yau, yu na anǝ ndǝ kau, ‘Maˈyi,’ ba ja maˈyi, anǝ vanyi ndǝ tsu yu na ‘Shili,’ ba ja shili. Ma yi na anǝ mafa ɗa, ‘Mǝliya abangau,’ ba ja mǝliya.”<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>Ənggǝra Yesu nggar ndǝr kau, ba ɗa sǝ dǝdǝgur anǝ nyi, ji shabiya dzau, ji na, anǝ nji kǝra a vǝr nu nyi, “Ya nar hyi, wu Izirayila nayi sayi uya ndǝra ǝnga mbǝrsa ǝnga dǝnama ǝnggǝr ndǝ kǝ mai.” <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>Ənggǝra njira ji sǝwa kǝ sha shili wu ki, ba ndǝ thlǝwa mafa nǝ dǝgalǝr soja Roma ta a ɗari jamǝu.<verse eid="LUK 7:10"/></para>
  <para style="s1">Yesu Hyaˈana Vanyi Zǝr Mala Tǝsal</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>Wu yukuɗa pǝci kushu, kǝ Yesu maˈyi a vu mǝlmǝ kǝra nja ngga ǝnga Nayin, zǝmbǝlma nyiˈyar ǝkkǝˈyi nji gangǝu maˈyi ǝnga ja. <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>Ənggǝra ndǝ shili lǝhǝu wu dzǝri miyar gwa nǝ mǝlma nyi, kǝja alenyi nja vǝr sǝbiya ǝnga zǝr tǝtau kǝra naja ngǝ zǝmǝ ara mǝnyi kǝra mǝnyi ya, sal nyi tsu a tǝri. Nji gangǝu, sara wu mǝlmǝ ta, nda vǝr lǝ nyi. <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>Ənggǝra Thlagǝ lari mala kau, ba ji tǝhuɗǝ ǝgya ja, ba ji na anǝ nyi, “Ga sara tiwi mai.”<verse eid="LUK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14"/>Kǝ ji maˈyi ji nda tsǝkwar lǝkagau ndǝ tǝtǝ kau, ba njira vǝr hǝ nyi kǝ taˈyau. Kǝ Yesu na, “Zǝr baduwari, Yu na anǝ ngau hyaˈari!” <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>Kǝ ndǝ tǝtǝ kǝ hyaˈari, ba ji nggya gya ji dzǝgwa ndǝr. Ba Yesu dzǝgwa lǝr nyi anǝ mǝnyi.<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>Kǝ hivǝr mbari nda patǝu, ba ndǝ fal Hyal, nda vǝr na, “Jiri vanyi nabi dǝgal a shiliri wu pama mǝn, Hyal a shiliri aga ja sa dlǝwari nji gǝ nda.” <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>Sǝ kǝ Yesu mǝliya kǝ tǝtǝlnakǝr wu Yahudi ǝnga ˈyiˈyi kǝra zǝwar nyi.<verse eid="LUK 7:17"/></para>
  <para style="s1">Njira Nji Sǝwa Sara Ara<optbreak/> Yahwana Ndǝr Baɓǝtizǝma</para>
  <para style="r">(<ref loc="MAT 11:2-19">Matiwu 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>Ənggǝra zǝmbǝlmaˈyar nǝ Yahwana ndǝr mǝl Baɓǝtizǝma nar nyi sǝˈyar kǝ patǝu, ba ji nggari mǝthlǝ wu pama nda, <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>ji sǝwa nda a ndǝgya Thlagǝu, aga nda nda yiwar nyi abǝr, “Nagǝ nga vǝr shili kǝ ya, ǝndǝga ˈya fiya li aga vanyi ndǝ ya?”<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>Ənggǝra njira nji sǝwa shili ǝgya Yesu, kǝ ndǝ na nǝ nyi, “Yahwana ndǝr mǝl Baɓǝtizǝma ngǝ sǝwa ˈya aga ˈya yiwar ngau, ‘Nagǝ nga vǝr shili kǝ ǝndǝga ˈya fiya li aga vanyi ndǝ ya?’ ”<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>Kakalǝ ar pǝci ta, ngǝ Yesu mbǝɗana nji gangǝu kǝra gǝra ngga ǝnga shilǝgǝ pamǝpamǝu, ǝnga njira ǝnga mambǝl ɗǝmwaˈyiˈyar. Yesu mǝliya nji lǝfǝˈyar tsu ndǝ lari sau. <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>Kǝ Yesu shaɗǝwa nda, ji na, “Sha mau hya nda nar nyi anǝ Yahwana sǝra hyi lari ǝnga hyi nggari. Nji lǝfǝ wu lar sau, nji kukurɓǝ wu ɓau, njir pibi wu uya jamǝkur, kulangǝˈyar tsu ndu nggar sau, nju hyaˈana nji tǝtau ǝnga nju tǝtǝlna ndǝshigu mǝsahǝ anǝ nji ɗaɗali. <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>Barka anǝ ndǝra gǝra tǝkǝkǝr ǝnga mbǝrsa nyi ar kǝra yau.”<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>Ayukuɗa njira Yahwana sǝwa maˈyi, kǝ Yesu dzǝguya ndǝr anǝ nji ar kǝra Yahwana, ji na, “Mi nga hyi gwa tsamǝ a gwar tagǝ ta? Hyi maˈyi a gwa tsamǝ sar dzǝdzǝgamǝu, kǝra yambaɗǝ a vǝr kǝnggǝɗǝ ya? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>Ya, mi nga hyi maˈyi a gwa tsama? Ndǝra har kar mǝnahǝ ya? Awau, njir ha kar mǝmǝnahǝu, wu ki tǝl nga nda. <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>Kar ɗǝm ya, mi nga hyi maˈyi a nda tsama? Nabi ya? Pakatu, yu nar hyi, ndǝra ndiya nabi. <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>Ar kǝra Yahwana ngǝ ndǝr Hyal kǝra tsǝtsǝfǝ na,</para>
  <para style="q1" vid="LUK 7:27">“ ‘Kǝja yu sǝwa cama ɗa</para>
  <para style="q2" vid="LUK 7:27">wu mwa ngau,</para>
  <para style="q1" vid="LUK 7:27">ju nda fuwa sǝ wu lagu</para>
  <para style="q2" vid="LUK 7:27">kadivira ga shili.’<verse eid="LUK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28"/>“Ya nar hyi, wu pama njira mathlǝkǝˈyi ngǝ ya patǝu, ndǝra ndiya Yahwana ǝnga dǝgal aˈyi mai. Ama alaga abangau, ndǝra ndiya ǝnga kushu wu tǝlkur Hyal a ndiya nyi ǝnga dǝgalǝu.”<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>Patǝr njira nggari ndǝr kau, ǝkkǝˈyi njir tsǝm budau, dlǝwunggǝri abǝr lagu Hyal ca ngǝ lagu kǝra kakalǝu, arya Yahwana ngǝ mǝliya nda baɓǝtizǝma. <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>Ama njir Farisi ǝnga malǝmǝ sǝnbiya dlaɗǝ Musa ˈyar nggǝl ara dlǝwu sǝra Hyal wu yiwu ǝnga nda, ǝnga ndǝ nggǝl ara Yahwana sara mǝliya nda baɓǝtizǝma.<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>Yesu dumwa ǝnga ndǝr ji na, “Ya, ǝnga mi nga nja gǝla nji kabangǝka? Abari nga nda? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>Nanda ǝnggǝr wazha kǝra a vǝr nggya ar sugu, nda vǝr ngga kuvwar nda, ndu na:</para>
  <para style="q1" vid="LUK 7:32">“ ‘ˈYa vǝr mbiɗǝ mbǝlau anǝ hyi,</para>
  <para style="q2" vid="LUK 7:32">kǝ hyi nggǝl ara fǝl,</para>
  <para style="q1" vid="LUK 7:32">ˈyi thlǝ na nǝ tiwi</para>
  <para style="q2" vid="LUK 7:32">ba hyi nggǝl ara dlǝwu.’<verse eid="LUK 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 7:33"/>“Yahwana ndǝr mǝl Baɓǝtizǝma shili ja vǝr sǝm sǝr sǝm mai, naja tsu aˈyi a vǝr sa ˈyimi nǝr wur inabi ǝnggǝra nji tsǝliya mai, ‘Ama ǝngwar hyi naja ǝnga mambǝl ɗǝmwaˈyu!’ <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>Zǝr Ndǝ shili ju sǝm, ǝnga ju sa, ǝngwar hyi, ‘Ndǝr suna nga ja, bazhiya njir tsǝm budau ǝnga njir bikau!’ <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>Alaga abangau, patǝr njira hǝnggǝri ǝnga hahangǝkur nǝ Hyal, nda vǝr cabiya abǝr ǝnga jiri nga nyi.”<verse eid="LUK 7:35"/></para>
  <para style="s1">Yesu Wu Ki Simanu Ndǝr Farisi</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>Vanyi ndǝr Farisi nggari Yesu a nda sǝm sǝr sǝm a ndu ki nyi, ba Yesu nda, ji nda nggya aga sǝm sǝr sǝm. <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>Wu mǝlmǝ kau, vanyi mala aˈyi ja vǝr mǝl zawarkur, kǝ ji nggari abǝr Yesu a vǝr sǝm sǝr sǝm wu ki ndǝr Farisi kau, kǝ ji shili ǝnga vanyi bǝlari kushu kǝra ǝnga mal kǝra wu shuni kisǝu, kǝra nju ɗǝl ǝnga kwaɓa gangǝu. <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>Ji shili kǝ ji sa taˈyi wu yukuɗa Yesu, ar dza hiya ja, ja vǝr tiwi. Ta sǝlǝm nyi pau a gyar hiya ja, ba ji dzǝgwa kǝkǝɗǝna hiya ja ǝnga shishir kǝra ja, kǝ ji dzǝgwa dumwa ǝnga bǝrpǝ nyi nǝ yiwukur, ba ji ɓǝsiya nda ǝnga mal shuni mǝsahǝu kau.<verse eid="LUK 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39"/>Ənggǝra ndǝr Farisi kǝ wu tsamǝ sǝra mala ka a vǝr mǝl kau, kǝ ji na wu ɗǝfuwa ja, “Maja abǝr ndǝ kǝ nabi ngau, a kyaga sǝni ja tara wa ngǝ mala ka a vǝr tsukwa nyi kau. Ja kyaga sǝni abǝr mala kǝ ndǝr bikǝ ngau.”<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>Yesu na anǝ ndǝr Farisi kau, “Simanu, aˈyi yi ǝnga sǝr na anǝ ngau.”</para>
  <para style="p" vid="LUK 7:40">Kǝ Simanu na, “Nar ɗa, malǝmǝ.”<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>Yesu na, “Vanyi ndu nu nji mǝthlǝ mǝl, ndǝ pathlǝu, gǝnna kǝra nja kyaga ki ndǝr mǝl thlǝr ǝni wu pǝkau, nǝ fa pathlǝ ǝnga reta, ndǝ mǝthlǝkura nyi tsu, gǝnna nǝ pǝkǝ nǝ ndǝr mǝl thlǝr kǝra ja kyaga uya wu pida tǝfu kumunyi. <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>Ənggǝra ndǝ tini kina, ba ji yafǝna nda gyapǝu. Ya, wu tsamǝ ngau, wa nga kyaga ndiya ǝnga yiwu nyi wu pama nda?”<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>Simanu na anǝ nyi, “Wu lari ɗa, ndǝ kǝ nji yafǝna nyi gǝnna gangǝ kau.”</para>
  <para style="p" vid="LUK 7:43">Ba Yesu na anǝ nyi, “Ənghǝng, a nabiyar gǝ kakalǝu.”<verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>Kǝ ji shabiya dzǝ ji tsamǝ mala ta, ba ji na anǝ Simanu, “A lari gǝ mala kǝ ya? Yi shili wu ki ngau, nagǝ aˈyi nǝ ɗa ˈyimi aga ya cina hiya yi ǝni mai, ama kǝ ji cina hiya yi ǝnga sǝlǝm nyi, ji kǝkǝɗǝna ǝnga shishir kǝra ja. <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>Nagǝ dlǝwuri ɗa ǝnga bǝrpǝ dzǝ mai, ama ǝnggǝra ji shili wu ki kau, naja aˈyi taˈyi ǝnga bǝrpǝ hiya yi ǝnga miya ja mai. <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>Nagǝ aˈyi ɓǝsiya mal ar kǝra yi mai, ama kǝ ji ɓǝsiya mal shuni kisǝ kau, ar hiya yau. <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>Agabangau, ya nar ngau, bikǝ nyi kǝra gangǝ kau, a tǝfǝbiya nyir nji arya ji cabiya yiwukur gangǝ gagaɗau. Ama ndǝra nji tǝfǝbiya nyi bikǝ kushu, yiwukur nyi kushu nga nyi tsu.”<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>Əngwar Yesu anǝ mala kau, “A tǝfǝbiya ǝnggǝr nji bikǝ ngau.”<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>Njira a vǝr sǝm sǝr sǝm ǝnga ja ar vi kau, dzǝgwa na anǝ kuvwar nda, “Wa ngǝ ndǝ kǝ a sǝni tǝfǝbiya bikǝ ka?”<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>Əngwar Yesu anǝ mala ta, “Mbǝrsa ngau, a mbǝɗana ngǝ ri, maˈyi sǝ ǝnga huɗǝ pǝrtǝu.”<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">Alenyi Mathlǝkǝˈyi Ndǝ Maˈyi Ənga Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>A sǝkari kushu, Yesu a vǝr ɓau a ndu mǝlmǝ dǝdǝgal ǝnga mǝlmǝ kukushu ja vǝr tǝtǝlna ndǝr mǝsahǝ nǝ tǝlkur Hyal. Zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝ aˈyi nda ǝnga ja, <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ǝnga alenyi mathlǝkǝˈyi kǝra nji kǝdlǝbiya mambǝl ɗǝmwaˈyi sara wu dza nda ǝnga njira ji shilǝgǝbiya nda. Wu pama nda mala aˈyi kǝra nja ngga ǝnga Maryamu Magǝdaliya kǝra mambǝl ɗǝmwaˈyi pamǝpamǝ mǝɗǝfǝ biya sara wu dza ja, <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ǝnga Yuwana mala Kuza, ndǝ dǝgal wu ki Hirudusu ǝnga Suzana, ǝnga alenyi mathlǝkǝˈyi gangǝu kǝra a vǝr mǝl thlǝr anǝ nda ǝnga gǝnnar nda.<verse eid="LUK 8:3"/></para>
  <para style="s1">Karapau Ar Kǝra Ndǝr Thlǝka</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matiwu 13:1-9</ref>; <ref loc="MRK 4:1-9">Markusu 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>Ənggǝra nji gangǝ sara wu mǝlmǝ pamǝpamǝ tsǝmiya dzau, aga nda nggari Yesu, kǝ ji nar nda najaka karapau.<verse eid="LUK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5"/>“Ndǝr zǝwa aˈyi kǝra maˈyi a gwa thlǝka culi a gwar fa nyi. Ja vǝr uci culi kǝ alenyi tǝɗau ar lagu, kǝ nji cicina nda ǝnga hyi, ba ˈyagǝˈyar tsu sǝmku nda. <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>Alenyi culi tǝɗau a gyar vi kǝra mǝmau, ǝnggǝra ndǝ tsau, ba ndǝ ul ara lǝsǝ aˈyi ar vi ta mai. <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>Kǝ alenyi tǝɗau, a gyiwu pama shikǝɗi, ndǝ hǝ ǝnga nda, ba shikǝɗi kar nda ara pǝli. <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>Alenyi culi tsu tǝɗau, a gyiwu ˈyi kǝra mǝnahǝu, ndǝ hau, ba ndǝ puwa li gangǝ gagaɗau.”</para>
  <para style="p" vid="LUK 8:8">Ənggǝra Yesu kuɗǝna ndǝr kau, ba ji hyaˈana ɗahǝu, ji na abǝr, “Ndǝra ǝnga himi ngga sau, bǝgǝ ja nggari.”<verse eid="LUK 8:8"/></para>
  <para style="s1">Sǝra Karapau Nǝ Thlǝka Kǝ Aga Nyi</para>
  <para style="r">(<ref loc="MAT 13:10-17">Matiwu 13:10-17</ref>; <ref loc="MRK 4:10-12">Markusu 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>Zǝmbǝlma nyiˈyar yiwa nyi tara mi ngǝ najaka karapǝ cabiya. <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>Ji na, “A yiwur nji hya sǝnbiya sǝra ɗǝɗǝwa nǝ tǝlkur Hyal, ama anǝ alenyi nji, yu ndǝr ǝnga karapǝ anǝ nda, aga,</para>
  <para style="q1" vid="LUK 8:10">“ ‘Alaga ndu tsamǝ</para>
  <para style="q2" vid="LUK 8:10">ama nanda wu lari mai,</para>
  <para style="q1" vid="LUK 8:10">alaga ndu ngga</para>
  <para style="q2" vid="LUK 8:10">ama nanda wu nggabiya mai.’ ”<verse eid="LUK 8:10"/></para>
  <para style="s1">Yesu Nar Nda Sǝra Karapau <optbreak/> Nǝ Thlǝka Kǝ Cabiya</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matiwu 13:18-23</ref>; <ref loc="MRK 4:13-20">Markusu 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>“Kǝja sǝra karapǝ kǝ cabiya. Culi ca ngǝ ndǝr Hyal. <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>Kǝra tǝɗau ar lagu ca ngǝ cabiya nji kǝra wu nggar ndǝr Hyal, ama ba Shatan a shili ja sa hǝbiya ndǝr kǝ sara wu ɗǝfuwa nda ara nda sara mbǝrsa nda uya mbǝɗau. <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>Culi kǝra tǝɗau a gyar vir mǝmau, nanda ǝnggǝr njira wu nggar ndǝr kau, ndu dlǝwuri ǝnga huɗǝ pǝrtǝu ama nanda aˈyi ǝnga nggilang mai, ndǝ mbǝrsa nǝ pǝci kushu, ǝnggǝra ɓwaɓwatǝ shili, ba ndǝ piyari nu. <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>Culi kǝra tǝɗau a gyiwu shikǝɗi, ca ngǝ cabiya njira nggari, ama ǝnggǝra ndǝ dumwa ǝnga nu, kǝ ɗǝnga nǝr sǝr duniya, ǝnga gal gǝnna, ǝnga yiwu mǝsahǝkur kar nda ara pǝli. <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>Culi kǝra tǝɗau, a gyar ˈyiˈyi mǝnahǝu ca ngǝ njira nggari ndǝr kau, ndǝ dlǝwuri ǝnga huɗǝ zǝmǝ ndǝ sǝɓiya ndǝ sǝsǝˈwuri kǝl ta ndǝ piya wazha.”<verse eid="LUK 8:15"/></para>
  <para style="s1">Karapau Ar Kǝra Pitǝlla</para>
  <para style="r">(<ref loc="MAT 4:21-25">Matiwu 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>“Nja sǝn mbǝbiya pitǝlla ba nja mbuya ǝgya kiɗa tǝm ǝnga tǝmbǝl mai. Ama nja kyaga fiya a dar madzigam, ba ja dzǝgwa mbǝl anǝ kalar ndǝ kǝra a vu ki kau.<verse eid="LUK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17"/>“Arya kalar sǝ aˈyi kǝra ndu mǝl ɗǝɗǝwa kǝra gǝra nda biyar babal mai, ǝtsu sǝ aˈyi ɗǝɗǝwa kǝra nji gǝra nda sǝn mai.<verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>“Hya nggya ǝnga hangǝkal ǝnga sǝra hyu ngga, ara ndǝra ǝnga sau, nju nda sa cakǝri nyi, ama ndǝra gǝra ǝnga sau, sǝra ji nggani aˈyi ara ja kau, nju sa dlǝwuri.”<verse eid="LUK 8:18"/></para>
  <para style="s1">Miya Yesu Ənga Zamǝ Nyiˈyar</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matiwu 12:46-50</ref>; <ref loc="MRK 3:31-35">Markusu 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>Ənggau, miya Yesu ǝnga zamǝ nyiˈyar maˈyi a ndǝgya ja, ama nandǝ uya ndǝ thlǝwa nyi mai, ara gangǝkura nji. <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>Kǝ vanyi ndǝ nar nyi anǝ Yesu, abǝr, “Kǝja mǝngau ǝnga zamǝ ngǝˈyar a biya ndu yiwu nda ndǝr ǝnga gau.”<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>Əngwar Yesu anǝ njira a ndǝ patǝu, “Njira wu nggar ndǝr Hyal, ba ndǝ mǝl thlǝr ǝni, nanda ngǝ maɗa ǝnga zamǝɗaˈyar.”<verse eid="LUK 8:21"/></para>
  <para style="s1">Yesu Kughi Anǝ Majigwal</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matiwu 8:23-27</ref>; <ref loc="MRK 4:35-41">Markusu 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>Vanyi pǝci Yesu ǝnga zǝmbǝlma nyiˈyar gwu kwambwal, ba ji na anǝ nda, “Mǝna maˈyi a biyar ya dǝl.” Kǝ ndǝ mbar lagu ndu maˈyi. <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>Ənggǝra nda vǝr maˈyi ba ji ghanyi. Kukuthlǝu, kǝ majigwal shili ǝnga dǝnama ja vǝr sǝ a shili ar ˈyimi, ǝnggau, ba ndǝ ɗa tǝtǝwulu ara ǝnggǝra ˈyimi gwu kwambwalǝr nda. <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>Zǝmbǝlma nyiˈyar, hyabiya Yesu wu ghanyi, ndǝ na, “Thlagǝr ki! Thlagǝr ki! Kǝja mǝna sa!” Yesu hyaˈari kǝ ji kughiya majigwal ǝnga ˈyimi kǝra a vǝr thlǝkau, ba ndǝ bǝgǝ zǝmǝu. <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>Kǝ ji na anǝ zǝmbǝlma nyiˈyar, “Əmani ngǝ mbǝrsar hya?”</para>
  <para style="p" vid="LUK 8:25">Kǝ hivǝr mbar nda gagaɗau, ndǝ na wu pama nda, “Wathlǝmǝ culi najaka nda? Patǝ ǝkkǝˈyi majigwal ǝnga dǝl wu gǝnggǝr nyi sǝli ka?”<verse eid="LUK 8:25"/></para>
  <para style="s1">Yesu Mbǝɗana Ndǝra <optbreak/> Ənga Mambǝl Ɗǝmwaˈyu</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matiwu 8:28-34</ref>; <ref loc="MRK 5:1-20">Markusu 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>Yesu ǝnga zǝmbǝlma nyiˈyar nda vǝr maˈyi wu kwambwal ar ˈyimi, ba ndǝ dla wu ˈyiˈyi nǝ Garasina, kǝra a biyar ya dǝl Galili. <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>Ənggǝra Yesu a vǝr gya sara du kwambwal, kǝ ji thlǝwa ndǝr mǝlmǝ kǝ kǝra ǝnga mambǝl ɗǝmwaˈyu. Ndǝ kǝ a ɓǝliyar ja sar ja vǝr ɓǝ turusu, ǝnga naji wu nggya wu ki mai, kǝl wu hulili nga ju nggya cumu. <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>Ənggǝra ji lari Yesu, ba ji hyaˈana ɗahǝ ǝnga dǝnama, ba ji dla wu mwa nyi ju wau ju na, “Yesu zǝr Hyal Kǝra Di, mi dzau ngǝ ǝnga ˈya? Ya vǝr kǝdi ngau, ga sara nǝ ɗa ɓwaɓwatǝ mai!” <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>Ji na abangau, ara Yesu a kughi ri anǝ mambǝl kau, aga nda biya sara wu ja. Arya pǝci gangǝ mambǝl ɗǝmwaˈyi kǝ wu mbilna nyi a gyiwu ˈyi. Vanyi pǝci nju mbar nyi ar gangǝ ama ba ja thlǝthlǝna ganga nyi, ǝkkǝˈyi ja sǝwa nyi a gwa tagǝu.<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>Yesu yiwar nyi, “Wa thlǝmǝ nga?” Kǝ ji na, “Dlami,” ara mambǝl ɗǝmwaˈyi kǝ gangǝ nga nda wu ja. <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>Kǝ ndǝ kǝdi nyi ar kǝr ar kǝr a sara ja kǝdlǝbiya nda a gyiwu kaˈu gǝra kuɗǝ mai.<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>Lǝhǝ a dzǝr vi ta, ɓǝla fǝshiu aˈyi gangǝu kǝra a vǝr ɓǝla ar dza mau. Mambǝl ɗǝmwaˈyiˈyar kǝ kǝdi Yesu, “Sǝwa ˈya a ndu fǝshiˈyar kau, piyar ˈya aga ˈya gwu nda.” Ji piyari nda, kǝ mambǝl ɗǝmwaˈyiˈyar kǝ biya ndǝ gwu fǝshiu. <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>Ɓǝla fǝshiu kǝ a kar nda dubu mǝthlǝu, ndǝ hyaˈari ǝnga hwi a gwar dǝl a guna kǝ ˈyimi kuɗǝna nda patǝu.<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>Ənggǝra njir ɓǝla fǝshiˈyar lari sǝra ɗarkǝr, ba ndǝ maˈyi ǝnga hwi a vu mǝlmǝ dǝdǝgal ǝnga kukusha nyi aga nda vuwa nar nyi anǝ nji. <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>Kǝ nji kǝ biya aga nda biya lari sǝ kǝ ɗa kau. Ənggǝra ndǝ thlǝwa vi kǝra Yesu ari, ba ndǝ lari ndǝ ta mambǝl ɗǝmwaˈyi biya sara wu dza ja vǝr nggya lǝhǝ wu dzǝr Yesu, ǝnga lǝgutǝ ar dza ja wu hangǝkal nyi. Kǝ hivǝr mbari nda papatǝu. <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>Njira aˈyi ar vi ta pǝci kǝra sǝ kǝ ɗa wu liya nda, dumwa ǝnga na anǝ nji ǝnggǝra ndǝ kǝ uya jamǝkur. <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>Ənggau, patǝr njira wu ˈyiˈyir Garasina kǝdi Yesu aga ja piyari mǝlmǝr nda ara hivǝr a mbar ndari gagaɗau. Kǝ Yesu gwu kwambwala nyi, ba ji maˈyi sǝ nyi.<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>Kǝ ndǝ kǝ nji kǝdlǝbiya mambǝl ɗǝmwaˈyu, sara wu dza ja kǝ kǝdi Yesu, ji na, “Usi piyari ɗa ma maˈyi ǝnga gau, aga ya ɗa ndǝr nu ngau.” Ama kǝ Yesu nggǝl, ji na anǝ nyi, <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>“Sha a ndu ki, ga nda nar nda sǝ kǝ Hyal mǝliya ngǝ kau.” Kǝ ndǝ kǝ maˈyi a vu huɗa mǝlmau, ja vǝr na anǝ nji sǝra Yesu mǝliya nyi.<verse eid="LUK 8:39"/></para>
  <para style="s1">Yesu Mbǝɗana Nji <optbreak/> Arya Hǝnggǝr Jirir Nda</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matiwu 9:18-26</ref>; <ref loc="MRK 5:21-43">Markusu 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>Ənggǝra Yesu sha shili sara ndǝna, kǝ nji gangǝ shili ndǝ dlǝwuri nyi, ara nda vǝr sǝkǝ shili nyi. <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>Kǝja vanyi ndǝ thlǝmǝ nyi Yayirusu, naja ndǝ dǝgal wu umbwa daɓǝ dzǝ njir Yahudiya, ji shili ji sa ɓǝliya undi wu mwar Yesu, ja vǝr kǝdi nyi aga ja shili wu ki nyi, <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>arya kwa nyi kǝra zǝmǝu, zǝr fa kumo apǝ mǝthlǝu, a lagur tau.</para>
  <para style="p" vid="LUK 8:42">Ənggǝra Yesu mbar lagu, nji gangǝ a vǝr nu nyi ndu ciɗǝ nyi lagu mazǝm ǝnga lagu matsal. <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>Vanyi mala aˈyi a ndǝna kǝra mǝliya fa kumo apǝ mǝthlǝu, ja vǝr ndzǝndzǝ mashi. Mala kǝ a lari ɓwaɓwatǝ ǝnga jirkur wu tsa njir kundzǝgǝ pamǝpamǝ gangǝu, ama kǝra aˈyi dlǝwari nyi mai. <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>Ji shili wu pama nju yukuɗa Yesu, kǝ ji sa tsǝkwar miya lǝgutǝ nyi, ǝnggau, ba ndzǝndzǝ mashi kǝ taˈyau. <verse eid="LUK 8:44"/><verse number="45" style="v" sid="LUK 8:45"/>Əngwar Yesu, “Wa ngǝ tsǝkwar ɗa ka?” Kalar ndu na, “Nayi ngǝ mai.” Kǝ Biturusu na, “Malǝmǝ dǝgal, nji gangǝ ngǝ zǝwar ngǝ nda vǝr jajahǝ ngau.”<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>Ama kǝ Yesu na anǝ nyi, “Vanyi ndǝ a tsǝkwar ɗa ri, arya dǝnama a biyari sara wu dza yau.” <verse eid="LUK 8:46"/><verse number="47" style="v" sid="LUK 8:47"/>Ənggǝra mala kǝ lari naja sǝn ɗǝwanakǝr mai, kǝ ji sha shili ja vǝr tsǝdzau, ji ɓǝliya undi a gyiwu mwar Yesu. Kǝ ji nar nyi wu mwar nji patǝu, sǝra ɗa ji tsǝkwar nyi, ǝnga ǝnggǝra ji uya jamǝkur aga zǝmǝu. <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>Kǝ ji na anǝ nyi, “Kwa ɗa, mbǝrsa ngau, a mǝliya ngǝ ri jamǝu, maˈyi wu jamǝkur.”<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>Tsu ja gǝra kuɗǝna ndǝr, kǝja cama sara wu ki Yayirusu ndǝr ɓǝla umbwa daɓǝ dzǝ njir Yahudiya, a shiliri, ja vǝr na anǝ Yayirusu, abǝr, “A sara ga ɓǝra nǝ nyi ɓwaɓwatǝ anǝ malǝmǝ mai, arya kwa ngǝ a tǝri.”<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>Ənggǝra Yesu nggari ndǝr kau, kǝ ji na anǝ Yayirusu, “Ga sara hivǝr mai, ga mbǝrsa wacu ju hyaˈari.”<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>Ənggǝra ndǝ shili wu ki nyi, naja aˈyi piyari nja vu ki ǝnga ja mai, kǝl Biturusu ǝnga Yahwana ǝnga Yakubu ba dǝya kwa ǝnga mǝnyi. <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>Patǝkura njira a vu ki kau, kǝl tiwi nga nda vǝr tiwi, nda vǝr wau wu dǝrbǝ kwa nyi. Kǝ Yesu na anǝ nda, “Hya sara tiwi mai, kwa kǝ naji tǝ mai, ghanyi nga ja a gwa!”<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>Kǝ ndǝ nggushi nǝ diɗa ndau, ara ndu sǝni abǝr kwa nyi a tǝri. <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>Yesu mbari tsa ja ji hyaˈana ɗahǝu, ji na, “Zǝr kwa, hyaˈari!” <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>Kǝ piya ja ɓǝra sha shili wu ja, kǝ ji hyaˈari jamǝu, kǝ Yesu nar nda, nǝ nya mǝ sǝr sǝm. <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>Kǝ njir ya nyi mbari miya nda, nda vǝr tsamǝ sǝ dǝdǝgur, ama kǝ Yesu tǝɗar himiya nda abǝr nda sara na sǝ kǝ ɗa kǝ anǝ nji mai.<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">Yesu Sǝwa Zǝmbǝlma Nyiˈyar</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matiwu 10:5-15</ref>; <ref loc="MRK 6:7-13">Markusu 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>Ayukuɗa Yesu nggar zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝ a shili ar vi zǝmǝu, kǝ ji nǝ nda dǝnama nǝr kǝdlǝ mambǝl ɗǝmwaˈyiˈyar ǝnga tsu nda shilǝgǝbiya njira gǝra ngga, <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>ǝnga ji hyabiya nda, aga nda maˈyi nda nda tǝtǝlna ndǝr mǝsahǝu ar kǝra tǝlkur Hyal ǝnga shilǝgǝbiya nji gǝra ngga. <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>Ji na anǝ nda, “Hya sara hǝ sǝ aga ɓǝ kǝ mai, hya sara sǝɓǝ alaga zǝwa mai, alaga mbǝl, alaga sǝr sǝm, alaga kwaɓa mai. Ətsu hya sara hǝ alaga lǝgutǝ a ndiya kǝra ar dza hyi mai. <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>Wu kalar ki kǝra nji dlǝwuri hyi a gwa, hya nggya ǝna baˈanǝ pǝci kǝra hyu nda piyari mǝlmǝ kau. <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>Kalar vi kǝra nji nggǝl ara dlǝwu hyi, ma hyu biya hyu maˈyi, hya dlǝɗǝna bǝbǝr kǝra ar hya hyi, aga ja ɗa sǝr sakida ar kǝra nda.”<verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>Kǝ ndǝ hyaˈari ndǝ maˈyi a ndu mǝlmǝ pamǝpamǝ nda vǝr tǝtǝlna ndǝr mǝsahǝu, nda vǝr shilǝgǝbiya njira ǝnga shilǝgǝ pamǝpamǝˈyar ar kalar vi.<verse eid="LUK 9:6"/></para>
  <para style="s1">Hirudusu Gwu Ɗǝnga Sau</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matiwu 14:1-12</ref>; <ref loc="MRK 6:14-29">Markusu 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>Ənggǝra Hirudusu ndǝr sǝm tǝlkur ar kǝra Galili nggari sǝra a vǝr ɗa, kǝ ji gwu ɗǝnga sǝ gagaɗau, ara alenyi nji na, abǝr, Yahwana ndǝr mǝl Baɓǝtizǝma ngǝ hyaˈari sara vir tau. <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>Alenyi nja vǝr na, abǝr, nabi Iliya ngǝ ɓǝra sha shili. Alenyi nji tsu a vǝr na, abǝr, zǝma nabi nǝ ɗǝɗǝmǝ ngǝ ɓǝra hyaˈari. <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>Kǝ Hirudusu na, “Yahwana, nǝ nyi, a sǝwa ri yi nja thlana kǝra ja, kar wa ngǝ ndǝ kǝ yu nggari sǝ pamǝpamǝ ar kǝra ja ka?” Kǝ ji dzǝgwa mǝl ǝnggǝra ja sǝni lari nyi.<verse eid="LUK 9:9"/></para>
  <para style="s1">Yesu Sǝmǝna Nji A Ndiya Dubu Tǝfu <optbreak/> Ənga Sǝr Sǝm</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matiwu 14:13-21</ref>; <ref loc="MRK 6:30-44">Markusu 6:30-44</ref>; <ref loc="JHN 6:1-14">Yahwana 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>Ənggǝra cama sǝsǝ nyiˈyar kǝ sha shili, kǝ ndǝ nar nyi anǝ Yesu sǝra ndǝ mǝliya patǝu. Kǝ Yesu hǝr nda, nanda zhizhir nda ndǝ maˈyi a ndu vanyi mǝlmǝ nja ngga ǝnga Bethlesaida. <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>Ənggǝra nji nggari abǝr a ndǝna nga ja, kǝ ndǝ nu nyi a ndǝna. Ji dlǝwuri nda ǝnga huɗǝ zǝmǝu, ji dzǝgwa ndǝr anǝ nda ar kǝra tǝlkur Hyal, kǝ ji shilǝgǝbiya njira gǝra ngga.<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>Ma lǝhǝ pǝci wu gya tǝɗau, kǝ nanda kumo apǝ mǝthlǝ kǝ shili ara ja ndǝ na, “Ara nji aˈyi ar vi kǝ mai, nar nda, nda maˈyi a ndu mǝlmǝ pamǝpamǝ aga nda uya sǝr sǝm ǝnga vir pida.”<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>Ama, kǝ Yesu na anǝ nda, “Nahyi, nǝr nda mǝ sǝra nda sǝmku.” Kǝ ndǝ na anǝ nyi, “Patǝr sǝra aˈyi a ndiya lugu ɗǝfǝ tǝfu ǝnga kalfi mǝthlǝ mai. Kǝl naˈya nga maˈyi ˈya nda ɗǝlbiya sǝr sǝm anǝ nji kǝ patǝu.” <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>Arya shili zhizhir nda ma a kar nda dubu tǝfu.</para>
  <para style="p" vid="LUK 9:14">Yesu na anǝ zǝmbǝlma nyiˈyar, “Nar nyi anǝ nji kǝ nda nggya gya wu bwata tǝfu kumunyi tǝfu kumunyi.”<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>Kǝ zǝmbǝlma nyiˈyar mǝliya ǝnggǝra ji na, ndǝ mǝliya nji kǝ nggya gya. <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>Ənggau, kǝ Yesu hǝri lugu ɗǝfǝ tǝfu ǝnga kalfi mǝthlǝ ta, kǝ ji hyaˈanakǝr a dǝmǝlmau, ji usar Hyal, ji dzǝgwa kakadlǝwa nda, kǝ ji nǝ nyi anǝ zǝmbǝlma nyiˈyar, aga nda tǝtǝkǝna anǝ nji patǝu. <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>Patǝkura nda sǝm ndǝ nyau. Kǝ zǝmbǝlma nyiˈyar tsǝmiya tsǝla kumo apǝ mǝthlǝ ǝnga sǝra hiyau sara wu miya nda.<verse eid="LUK 9:17"/></para>
  <para style="s1">Biturusu Nana Abǝr Yesu <optbreak/> Naja Ngǝ Kǝrsiti</para>
  <para style="r">(<ref loc="MAT 16:13-19">Matiwu 16:13-19</ref>; <ref loc="MRK 8:27-29">Markusu 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>Vanyi pǝci Yesu ja vǝr ndǝr ǝnga Hyal zhizhi nyi, kǝ zǝmbǝlma nyiˈyar shili ǝgya ja. Kǝ ji yiwa nda ji na, “Wa nga nju na ǝnga ya?”<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>Kǝ zǝmbǝlma nyiˈyar na, “Alenyi nju na abǝr, nagǝ ngǝ Yahwana ndǝr mǝl Baɓǝtizǝma, ǝngwar alenyi nji nagǝ ngǝ nabi Iliya. Abangǝ tsu, alenyi nja vǝr na, abǝr, pathlǝu, wu pama nabi ɗǝɗǝmˈyar ta ngǝ ɓǝra sha shili ǝnga pi.”<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>Kǝ Yesu na anǝ nda, “Ama anǝ hyi tsu, wa nga ya?” Kǝ Biturusu na, “Nagǝ ngǝ Kǝrsiti nǝ Hyal.”<verse eid="LUK 9:20"/></para>
  <para style="s1">Yesu Cabiya Ənggǝra Ji Wu Nda Tau</para>
  <para style="r">(<ref loc="MAT 16:20-28">Matiwu 16:20-28</ref>; <ref loc="MRK 8:31">Markusu 8:31</ref>; <ref loc="MRK 9:1">9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>Ənggau, kǝ Yesu tǝɗar himiya nda abǝr nda sara na sǝ kǝ anǝ kalar ndǝ mai. <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>Kǝ ji ɓǝra nar nda, abǝr, “A ɗar tsaˈa zǝr nda lar ɓwaɓwatǝ pamǝpamǝu. Nji nggunggurǝm nǝ mǝlmau, ǝnga pubu dǝdǝgalˈyar, ǝnga malǝmǝ dlaɗǝˈyar wu nda piyari nyi, ba nda tsǝya nyi, ama ayukuɗa pida makǝru, ba ji hyaˈari sara vir tau.”<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>Kǝ ji dzǝgwa nar nda patǝu, “Kalar ndǝra wu yiwu ja nu ɗa, kǝl ja piyari yiwu kǝrnyi, ba ja hǝri wu dladlakǝ nyi kalar pǝci, ba ja nu ɗa. <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>Kalar ndǝra wu yiwu piya ja, ju nda tini. Ndǝra gǝra yiwu piya ja arya yau, ju nda uya. <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>Mi ngǝ nubwa kǝra ndu uya, ma ji uya duniya patǝ ama kǝ ji tini piya ja? Sǝ aˈyi mai! <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>Ma ndǝra sǝli ɗa sakida ɗa ǝnga ndǝr ɗa, Zǝr Ndu nda sa sǝli ara ja, ar pǝci kǝra ju shili wu kadakadarkur nyi, ǝnga dǝgalkur nǝ dǝnyi, ǝnga nǝ waladiˈyar kǝra cicau. <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>Yu nar hyi jirkura nyi, alenyi nji aˈyi ǝnggau tataˈyu, nandu nda tǝ mai, kǝl ndǝ lari tǝlkur Hyal.”<verse eid="LUK 9:27"/></para>
  <para style="s1">Bǝlabiya Dzǝ Nǝ Yesu</para>
  <para style="r">(<ref loc="MAT 17:1-8">Matiwu 17:1-8</ref>; <ref loc="MRK 9:2-8">Markusu 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>Ayukuɗa pida cisu, ǝnggǝra Yesu nana ndǝr kau, kǝ ji nggari Biturusu, ǝnga Yahwana, ǝnga Yakubu, ba ndǝ maˈyi a dar kǝra mau aga da ndǝr ǝnga Hyal. <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>Ənggǝra ja vǝr ndǝr ǝnga Hyal, kǝ nggyar bama ja bǝlar dzau, ǝnga lǝgutǝ ha nyi ɗa pǝrtǝ pwahǝu ja sǝm ndu li. <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>Kukuthlǝu, kǝja nji mǝthlǝu, a vǝr ndǝr ǝnga ja. Nji mǝthlǝ kǝ nanda ngǝ nabi Musa ǝnga nabi Iliya. <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>Ndǝ dla wu kadakadarkur, nda vǝr ndǝr ǝnga Yesu ǝnggǝra ju nda nyabiya sǝra Hyal na ar kǝra tǝ nyi a vu Urshalima. <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>Biturusu ǝnga bazhi ɓǝ nyiˈyar wu ghanyi nga nda. Ənggǝra ndǝ hyaˈari wu ghanyi kǝ ndǝ lar kadakadarkur nǝ Yesu ǝnga nji mǝthlǝ kǝra ǝnga ja kau. <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>Ənggǝra nji mǝthlǝ kǝ wu piyari Yesu, Biturusu na anǝ Yesu, “Tarki, shilir mǝn ǝnggǝ kau, a ɗar mǝnahǝu. Ma gu yiwu, ya sǝn mǝliya kwapatǝ makǝr ǝnggau, pathlǝ anǝ ngau, pathlǝ anǝ Musa ǝnga pathlǝ anǝ Iliya.” Ara ju sǝni sǝra ja vǝr na mai.<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>Tsu ja gǝra haɗiya miya ja, kǝ dlama haɗiya nda. Ənggǝra dlama haɗiya nda, kǝ hivǝr mbari zǝmbǝlma nyiˈyar. <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>Ənggau, kǝ ɗahǝ hyaˈari sara du dlama ja vǝr na, “Najakǝ Zǝr ɗa ngau, nayi ngǝ caɗǝbiya nyi. Hya sǝya nyi himi.”<verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>Ənggǝra ɗahǝ kǝ bǝgau, ba nji lari Yesu zhizhi nyi. Zǝmbǝlma nyiˈyar dzǝgwa haɗiya miya nda zǝmǝu. Wu pidaˈyar kau, nandǝ nar nyi anǝ nji sǝ kǝ ndǝ lari kǝ mai.<verse eid="LUK 9:36"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Zǝr <optbreak/> Kǝra Ənga Mambǝl Ɗǝmwaˈyu</para>
  <para style="r">(<ref loc="MAT 17:14-18">Matiwu 17:14-18</ref>; <ref loc="MRK 9:14-27">Markusu 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>Ənggǝra vi sa kuɗau, Yesu ǝnga zǝmbǝlma nyiˈyar makǝr kǝ shida sara dar mǝ ta. Ənggau, kǝ daɓǝr dlamir nji gangǝ thlǝwa nda. <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>Kǝ ndǝ pathlǝu, wu daɓǝ dlamir nji kǝ ngga ǝnga ɗahǝ dǝgal, ji na, “Malǝmǝ! Yu kǝdi ngau, dlǝwar zǝr ɗa kau, naja ngǝ zǝr zǝmǝ ara yi wacu! <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>Kǝja, mambǝl ɗǝmwaˈyi nga vǝr ɓwanǝ nyi kǝr, ju sǝni mǝliya nyi ja wau dǝdǝgal gǝra vanyi sǝ uya nyi. Mambǝl kǝ a sǝni mbilna nyi a gyiwu ˈyi ja tsǝdzau ja dzǝgwa pǝ mubo wu miya ja. Naja aˈyi wu piyari nyi mai, kǝl ji uya nyi ǝnga shilǝgǝ gagaɗau. <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>Yi kǝdi zǝmbǝlma ngǝˈyar aga nda kǝdlǝbiya nyi a biya, ama nandǝ sǝni mbari mai.”<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>Kǝ Yesu shaɗǝwa nda, ji na, “Nahyi nji kabangǝkau, nji gǝra mbǝrsa, nji ɗǝmwaˈyu, baˈanuwa nga ya nggya ǝnga hya? Baˈanuwa nga ya sǝsu hya? Shila mau ǝnga zǝra nyi anǝ ɗa.”<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>Ənggǝra zǝr kǝ a vǝr shili, kǝ mambǝl kǝ mbilna nyi a gyiwu ˈyi, ja vǝr tsǝdzau ǝnga dǝnama. Kǝ Yesu kughiya mambǝl kau, ba ji mǝliya zǝra nyi jamǝu, ba ji dzǝgwa nǝ nyi zǝra nyi anǝ dǝnyi. <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>Patǝkura njira ar vi ta mbari miya nda, nda vǝr tsamǝ sǝ dǝdǝgur nǝ Hyal.</para>
  <para style="s1" vid="LUK 9:43">Yesu Ɓǝra Ndǝr Anǝ Nda <optbreak/> Ar Kǝra Tǝ Nyi</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Matiwu 17:22-23</ref>; <ref loc="MRK 9:30-32">Markusu 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Tsu nja vǝr tsamǝ sǝ dǝdǝgur kǝra Yesu a vǝr mǝl kau, kǝ ji na anǝ zǝmbǝlma nyiˈyar, <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>“Hya sǝya himi hya nggar sǝra yu nda na anǝ hyi kau. Nju nda lǝr Zǝr Ndau, anǝ dawa nyiˈyar.”<verse eid="LUK 9:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 9:45"/>Ama zǝmbǝlma nyiˈyar aˈyi nggabiya sǝra ju ndǝr ar kǝri kǝ mai, nji ɗǝwana ara nda, nda sara sǝnbiya. Nanda tsu kǝ hivǝr kari nda ara yiwa nyi.<verse eid="LUK 9:45"/></para>
  <para style="s1">Wa Ngu Ndiya Ənga Dǝgal <optbreak/> Wu Tǝlkur Hyala?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matiwu 18:1-5</ref>; <ref loc="MRK 9:33-37">Markusu 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>Kǝ kǝpal hyaˈari wu pama zǝmbǝlma nyiˈyar abǝr tara wa nga ndiya ǝnga dǝgal wu pama nda. <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>Yesu a sǝni biyari sǝra ndu ɗǝnga, kǝ ji hǝri zǝr kushu, kǝ ji taˈyina nyi a dzǝr nyi, <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>kǝ ji na anǝ nda, “Kalar ndǝra dlǝwuri zǝr kǝ arya thlǝmǝ ɗa, a dlǝwuri ɗar ja, ǝtsu ma ndǝra dlǝwur ɗa ri a dlǝwuri ja ndǝra sǝwa ɗa. Agabangau, ndǝra nji diɗana wu pama hyi, naja nga ndiya ǝnga dǝgalkur.”<verse eid="LUK 9:48"/></para>
  <para style="s1">Ndǝra Aˈyi Dawar Hyi Mai, <optbreak/> Nǝr Hyi Ngau</para>
  <para style="r">(<ref loc="MRK 9:38-40">Markusu 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>Kǝ Yahwana na, “Ndǝ dǝgal, ˈyi lari vanyi ndǝ a vǝr kǝdlǝ mambǝl ɗǝmwaˈyi wu thlǝmǝ ngau, kǝ ˈyi kari nyi ara naja aˈyi ǝnga ˈya mai.”<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>Yesu shaɗǝwa, ji na, “Hya sara ka nyi mai, ma ndǝ aˈyi cabiya hyi dawakur mai, nǝr hyi nga ja.”<verse eid="LUK 9:50"/></para>
  <para style="s1">Njir Samariya Wu Vanyi Mǝlmau <optbreak/> Nggǝl Ara Dlǝwu Yesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>Ənggǝra pǝci ɗa lǝhǝ anǝ Yesu aga ja sha a dǝmǝlmau, kǝ ji fuwa kǝr ja vǝr maˈyi a vu Urshalima. <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>Kǝ ji sǝwa njira ju sau, aga nda maˈyi wu mwa nyi, nanda tsu, kǝ ndǝ vu vanyi mǝlmǝ nǝ Samariya, aga nda vuwa fuwa alenyi sǝ wu lagu. <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>Ama kǝ njir mǝlmǝ kǝ nggǝl ara dlǝwu nyi, ara vu Urshalima nga ja vǝr maˈyi. <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>Ənggǝra zǝmbǝlma nyiˈyar Yakubu ǝnga Yahwana lari abangau, ba ndǝ na anǝ nyi, “Thlagǝu, gu yiwu ˈya ngga uˈu sara a dǝmǝlmǝ aga ja nggyina nda ya?”<verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>Ama kǝ Yesu shabiya dzau, ba ji kughi anǝ nda! <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>Kǝ ndǝ dzǝgwa maˈyi a ndu vanyi mǝlmau.<verse eid="LUK 9:56"/></para>
  <para style="s1">Njira Na Ndǝ Wu Nu Yesu</para>
  <para style="r">(<ref loc="MAT 8:19-22">Matiwu 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>Ma tsu nda wu lagu, kǝ vanyi ndǝ na anǝ Yesu, “Thlagǝu, yu nu ngau kalar vi kǝra gu maˈyi a ndari.”<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>Kǝ Yesu shabiya nyi ji na, “Thlahu ǝnga kaˈu nga nda, ˈyagǝˈyar tsu kir nda aˈyi, ama zǝr ndau, vira ja fiya kǝra ja ari aˈyi mai.”<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>Anǝ vanyi ndǝ tsu kǝ ji na, “Nu ɗa.” Ama kǝ ndǝ kǝ na, “Thlagǝu, piyari ɗa ya maˈyi ya nda haɗǝna dǝɗa kwatahǝu.”<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>Yesu shaɗǝwa nyi, ji na, “Bǝgǝ nji tǝtǝ nda haɗǝna ndǝ tǝtǝr nda. Ama nagau, ga maˈyi ga nda tǝtǝlna ndǝr tǝlkur Hyal.”<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>Vanyi ndǝ tsu ji na, “Thlagǝu, yu nu ngau, ama ga piyari ɗa kwatahǝu, ya maˈyi ya nda nar nyi anǝ nji gǝ ˈya abǝr maˈyi nga yau.”<verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>Yesu shaɗǝwa nyi, “Kalar ndǝra fǝri tsa ja ar kul zǝwa thla, ba ji ɓǝra tsamǝ gyiwu yukuɗu, naji ɗa tsaˈa aga gwu tǝlkur Hyal mai.”<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">Yesu Sǝwa Zǝmbǝlma Nyi <optbreak/> Mǝɗǝfǝ Kumunyi Apǝ Mǝthlǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>Wu yukuɗa kau, Thlagǝ ɓǝra ɗǝmbiya alenyi zǝmbǝlma nyi mǝɗǝfǝkumunyi apǝ mǝthlǝu, ji sǝwa nda mǝmǝthlǝu, aga nda maˈyi a dumwa nyi a ndu patǝr mǝlmǝ pamǝpamǝ ǝnga alenyi viˈyar kǝra naja ǝnga kǝrnyi ju nda vuwa gwa. <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>Kǝ ji na anǝ zǝmbǝlma nyiˈyar, “Sǝr faˈa a su ki gangǝ nyi, ama njir mǝl thlǝr kushu nga nda. Agabangau, hya kǝdi thlagǝr fa, ja sǝwa njir mǝl thlǝr aga nda sa faˈa sǝ a su ki.” <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>Maˈya mau, kǝja ya vǝr sǝ hyi a biya ǝnggǝr tǝmahǝ wu pama ufwar vwaˈyar. <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>A sara hya hǝ pǝrki mai alaga mbǝl alaga ɓiɓi, a sara hya usa nji ar lagu ma hya vǝr maˈyi mai.<verse eid="LUK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5"/>“Kalar ki kǝra hyi vuwa gwa, hya dzǝguya na, abǝr, ‘Jamǝkur anǝ hyu ki kau!’ <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>Ma ndǝ jamǝ aˈyi a vu ki kau, bǝgǝ usa dzǝr hyi nǝ jamǝkur kau, ja nggya ǝnga ja, ma tsu aˈyi mai, bǝgǝ usa dzǝr hyi nǝ jamǝkur kau, ja sha shili anǝ hyi. <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>Hya nggya wu ki ta, kalar sǝra nji nǝ hyi hya sǝm hya sa, arya a ɗar tsaˈa nja kina ndǝr mǝl thlǝr gǝnna thlǝr nyi. A sara hya ɓǝ sara wu ki a ndu vanyi ki mai.<verse eid="LUK 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8"/>“Kalar mǝlmǝ kǝra hyi vuwa gwa, ma nja dlǝwuri hyiri, kalar sǝra nji hǝr hyi a shili hya sǝm. <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>Hya shilǝgǝbiya njira gǝra ngga kǝra wu mǝlmǝ ta, hya ɓǝra na anǝ nja nyi, abǝr, ‘Tǝlkur Hyal a shiliri lǝhǝ wu dzǝr hyi.’ <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>Ama kalar mǝlmǝ kǝra hyi vuwa gwa, nji aˈyi dlǝwuri hyi mai, hya maˈyi a ndar lagu dǝdǝgalǝu, hya dzǝgwa na, <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‘Alaga bǝbǝr mǝlmǝr hyi kǝra mbari hya ˈya kau, ˈyi wu dlǝɗǝna hyi sǝr hyi aga ja ɗa sǝr sakida ar kǝra hyi. Ama hya sǝni ja, abǝr Tǝlkur Hyal a shiliri lǝhǝu!’ <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>Ya vǝr na anǝ hyi pǝcir kuɗiya nǝ duniya, Hyal a nda tǝhuɗǝ ǝgya Sodomu a mwa ara mǝlmǝ kau.<verse eid="LUK 10:12"/></para>
  <para style="s1">Mǝlmǝˈyar Kǝra Nggǝl <optbreak/> Ara Gal Yafa Dzau</para>
  <para style="r">(<ref loc="MAT 11:20-24">Matiwu 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>“Sǝr tǝhuɗǝ anǝ ngau, Korazinu! Sǝr tǝhuɗǝ anǝ ngau, Bethlesaida! Maja abǝr sǝ dǝdǝgur kǝra nji mǝliya wu gau, nji mǝliya wu Taya ǝnga Sidonu, a tubir nda tsu kaɗǝ lagur hari lǝgutǝ sǝˈyinggu ǝnga tǝwa bǝbǝr wu kǝra nda. <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>Wu pǝcir numa Hyal wu sa tǝhuɗǝ ǝgya njir Taya ǝnga njir Sidonu a ndiya hyi. <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>Nahyi tsu njir Kafarnahumu! Hya vǝr nggani abǝr nja nda faˈar hyi a dǝmǝlmǝ ya? Awau! Nahyi ma a gyiwu kaˈu ɗǝmwaˈyi nga nju nda puwa hyi.<verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>“Kalar ndǝra sǝya hyi himi, nayi nga ji nggari, kalar ndǝra piyari hyi tsu nayi nga ji piyari. Ama ndǝra piyari ɗa tsu a piyari ja ndǝra sǝwa ɗa.”<verse eid="LUK 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>Zǝmbǝlma nyiˈyar mǝɗǝfǝkumunyi apǝ mǝthlǝ kǝ sha shili ǝnga caguli, nda vǝr na, “Thlagǝu, patǝ ǝkkǝˈyi mambǝl ɗǝmwaˈyiˈyar nda vǝr mǝl thlǝr ǝnga sǝra ˈyi wu na wu thlǝmǝ ngau.”<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>Ca ngǝ Yesu shaɗǝwa nda, ji na, “A lari yi shatan tǝɗǝ sǝra dǝmǝlmǝ ǝnggǝr sǝm nǝ par. <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>Nggara mau! Anǝ hyir yi dǝnama hya ɓǝ ar kǝra pabǝˈyar ǝkkǝˈyi ǝdiˈyar, nahyi tsu hya sǝm tǝlkur ar kǝra patǝr dǝnama nǝ dawar hyi, sǝr uya hyi aˈyi tsu mai. <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>Agabangǝ, hya sara caguli arya mambǝl ɗǝmwaˈyiˈyar sǝya hyi himi mai, ama hya caguli arya thlǝmǝr hyi aˈyi tsǝtsǝfǝ a dǝmǝlmau.”<verse eid="LUK 10:20"/></para>
  <para style="s1">Yesu Caguli</para>
  <para style="r">(<ref loc="MAT 11:25-27">Matiwu 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>Ar pǝci kau, Yesu nyinyau ǝnga huɗǝ pǝrtǝ sara ara Mambǝl Cicau, ji na,</para>
  <para style="pi" vid="LUK 10:21">“Dǝɗa, Thlagǝ kǝra a dǝmǝlmǝ ǝnga a gyiwu ˈyi, a usa ngǝr yau, arya gǝ ɗǝwana sǝˈyar kǝ anǝ nji hahangǝ ǝnga njir sǝn sau, ba gǝ dzǝgwa cabiya nyi anǝ njira ǝnggǝr wazha yiɗǝɗǝu. Abangǝ nga nyi, Tada arya naja kǝ ca ngǝ ɗa mǝnahǝu anǝ ngau.”<verse eid="LUK 10:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>“Dǝɗa anǝ ɗar sǝ patǝu, ndǝr sǝn sǝnbiya tara wa ngǝ zǝra nyi aˈyi mai, kǝl Dǝnyi wacu, abangǝ tsu ndǝr sǝn sǝnbiya tara wa ngǝ Tada nyi aˈyi mai, kǝl zǝr nyi ǝnga njira ju yiwu ja cabiya nda.”<verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>Ba ji shabiya dzǝ a ndǝra zǝmbǝlma nyiˈyar, ji na anǝ nda zhizhir nda, “Barka anǝ hyi ara hyi lari sǝˈyar kǝ hyu lari kau. <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>Ya nar hyi nabiˈyar gangǝu, ǝnga tǝltǝlˈyar a yiwur nda, nda lari sǝˈyar kǝ hyu lar kau, ama nandǝ lari mai. A yiwur nda, nda nggari sǝˈyar kǝ hya vǝr nggar kau, ama nandǝ nggari mai.”<verse eid="LUK 10:24"/></para>
  <para style="s1">Karapǝr Ndǝr Samariya <optbreak/> Kǝra Cabiya Yiwukur</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>Vanyi pǝci, kǝ malǝmǝ sǝnbiya dlaɗau, hyaˈari, ju yiwu ja dzǝbiya Yesu. Kǝ ji yiwa nyi, ji na, “Mi nga ya mǝl aga ya uya pi gǝra kuɗa?”<verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>Ca ngǝ Yesu na anǝ nyi, “Mi nga nji tsǝfǝri wu dlaɗǝ nǝ Musa? Lagu mani nga gu jiga?”<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>Əngwar ja, “ ‘Ga yiwu Hyal Thlagǝ ngau ǝnga ɗǝfuwa gǝ papatǝu, ǝnga piya gǝ papatǝu, ba ǝnga ɗǝnga ngǝ papatǝu.’ Mǝthlǝkura nyi, ga yiwu tǝwul ngau, ǝnggǝr kǝra gu yiwu kǝrngau.”<verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>Əngwar Yesu anǝ nyi, “A nabiyar gǝ kakalǝu, ma gǝ mǝl abangau, ba ga uya pi.”<verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>Ndǝ kau, ju yiwu ja cabiya abǝr naja, ju sǝni sau. Əngwar ja, “Kar ndangǝ, wa ngǝ tǝwul ɗa ka?”<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>Ca ngǝ Yesu shaɗǝwa nyi, ji na, “Vanyi ndǝ, hyaˈari wu Urshalima ja vǝr maˈyi a gyiwu Yariko, kǝ ji tǝɗǝ wu tsa njir ɗa lagu. Kǝ ndǝ zǝɗǝna zhaɓi nyi, ba ndǝ dǝgǝ nyi, ndǝ piyari nyi lǝha dzǝr tau. <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>Wu lagu ta, pubu a vǝr tǝrabiya, ǝnggǝra ji lari ndǝ kau, ba ji sha, ji tǝrabiya sǝ nyi ar dza lagu. <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>Ɓǝliya sar kushu, ba ndǝr Lawi dla ar lagu ta tsu, kǝ ji taˈyau, ji tsamiya nyi, ba ji mbar lagu ji maˈyi sǝ nyi. <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>Ɓǝra ɓǝliya sar kushu, kǝja ndǝr Samariya (njira njir Izirayila diɗana) a vǝr ɓǝ nyi, ta ji lar ndǝ kau, ba ji taˈyau....... Kǝ ji lǝnguɗiya lǝhǝ ja tau, kǝ ji tǝhuɗǝ ǝgya ja. <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>.Kǝ ji puwa a gu mbǝlgǝ nyi ˈyimi..r wur inabi, ǝnga mal, ba ji pǝɗiya mbǝlga nyi ǝnga takulagǝu, ji dzǝgwa fǝri nyi a dar ya kwara nyi, kǝ ji hǝri nyi a shili wu vanyi ki dlǝwu mǝthlǝpi, ji sa shilǝgǝ nyi. <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>Ayukuɗa pida pathlǝu, ǝngwar ja anǝ thlagǝr .ki nǝ dlǝwu mǝthlǝpi kau, ‘Kǝja kwaɓa tsaˈa ga ki ndǝr mǝl thlǝr nǝ pǝkǝ mǝthlǝu, ga dumwa ǝnga tsamǝ nyi,<note caller="+" style="f"><char style="fr" closed="false">10:35 </char><char style="ft" closed="false">Kwaɓa wu pǝci kǝ sǝra nju ki ndǝ ǝni ngau ma ji pǝkau a vǝr mǝl thlǝr.</char></note> yu maˈyi, ma sǝra gǝ tsǝya adabanga kau, ma yi ɓǝra sha shili, ba ya sa kina ngau.’ ”<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>Kǝ Yesu ɓǝra yiwa nyi, ji na, “Wu pama nji makǝr kau, wa ngǝ cabiya abǝr naja ngǝ tǝwul ndǝ ka?”<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>Əngwar ja, “Ndǝ kǝ cabiya nyi yiwukur kau.”</para>
  <para style="p" vid="LUK 10:37">Kǝ Yesu na anǝ nyi, “Maˈyi ga nda mǝl abangǝ tsu.”<verse eid="LUK 10:37"/></para>
  <para style="s1">Yesu Ɗa Mǝthlǝpi <optbreak/> Anǝ Marthla Ənga Maryamu</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>Ənggǝra Yesu ǝnga zǝmbǝlma nyiˈyar, a vǝr dumwa ǝnga ɓau, ba ndǝ vu vanyi mǝlmǝ kǝra vanyi mala nja ngga ǝnga Marthla dlǝwuri nyi a vu ki nyi. <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>Mala kau, kwamǝ nyi aˈyi kǝra nja ngga ǝnga Maryamu, naja ji nggya a gyiwu ˈyi lǝha dzǝr Thlagǝu, ja vǝr sǝ himi sǝra ju na. <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>Ama Marthla nǝ nyi, mǝl thlǝr sǝr sǝm ngǝ hǝna ɗǝnga nyi. Kǝ ji maˈyi a ndǝra Yesu ji nda na anǝ nyi, “Thlagǝu, aˈyi ga lari ǝnggǝra kwamǝ ɗa piyari ɗa, ya vǝr mǝl thlǝr kǝ patǝ zhizhi ɗa wa? Usi nar nyi ja shili, aga ja sa dlǝwari ɗa.”<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>Ama kǝ Thlagǝ shaɗǝwa nyi, “Marthla, Marthla, hangǝkala ga, a hyaˈari, kǝ ji hǝna ɗǝnga ngau, a dar sǝ gangǝu, <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>ama sǝ zǝmǝ wacu ca ngǝ mǝnahǝu, Maryamu nǝ nyi a caɗǝbiyari ja, agabangau, ndǝr sǝni mbǝliya ara ja aˈyi mai.”<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">Highiɓǝ Nǝ Yesu <optbreak/> Ar Kǝra Kǝdi Hyal</para>
  <para style="r">(<ref loc="MAT 6:9-13">Matiwu 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>Vanyi pǝci Yesu a vǝr kǝdi Hyal ar vanyi vi. Ənggǝra ji kuɗǝna, kǝ pathlǝ wu pama zǝmbǝlma nyiˈyar na anǝ nyi, “Thlagǝu, highiɓǝri ˈya ǝnggǝra ˈya kǝdi Hyal, ǝnggǝr kǝra Yahwana highiɓǝri nyi anǝ zǝmbǝlma nyiˈyar kǝ tsu.”<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>Ba ji na anǝ nda, “Ma hyu kǝdi Hyal, hya na,</para>
  <para style="q1" vid="LUK 11:2">“ ‘Dǝrˈya,</para>
  <para style="q2" vid="LUK 11:2">thlǝmǝ ngǝ</para>
  <para style="q1" vid="LUK 11:2">ja nggya cicau,</para>
  <para style="q2" vid="LUK 11:2">tǝlkur ngau ja shili.<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>Ɗar ˈya sǝr sǝm nǝ ǝshina,</para>
  <para style="q2" vid="LUK 11:3">ǝnga nǝ kalar pǝci.<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>Tǝfǝbiya ˈya bikǝr ˈya,</para>
  <para style="q2" vid="LUK 11:4">ǝnggǝr kǝra ˈyi tǝfǝbiya njira mǝliya ˈya bikau.</para>
  <para style="q1" vid="LUK 11:4">Tǝfǝbiya nyi anǝ kalar</para>
  <para style="q2" vid="LUK 11:4">ndǝra mǝliya ˈya bikau.</para>
  <para style="q1" vid="LUK 11:4">A sara ga hǝr ˈya</para>
  <para style="q2" vid="LUK 11:4">a ndar vir dzǝ mai.’ ”<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>Yesu ɓǝra na anǝ zǝmbǝlma nyiˈyar, “Ma ɗa abǝr pathla hyi ǝnga bazhi, ji shili ǝgya ja hathlǝr vuˈyi, ji na anǝ nyi, ‘Bazhi ɗa, ndzǝbiya ɗa sǝr sǝm. <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>Kǝja vanyi bazhi ɗa kǝra hyaˈari sarar vi naɗǝ shili ǝgya yi kabangǝkau. Nayi tsu, sǝr sǝm kǝra ya sǝni nǝ nyi aˈyi mai.’ <verse eid="LUK 11:6"/><verse number="7" style="v" sid="LUK 11:7"/>Ma ɗa bazhi kǝra ji nda gal ndzǝ ara ja kǝ shaɗǝwa sara gu mbwa ji na, ‘A sara ga ɓwanǝ ɗa kǝr mai. Kabangǝkau, a haɗiyar ˈya miya ɗǝvau, nayi ǝnga wazha ɗa patǝ a yi pida nga ˈya. Na ya ɓǝra sǝni hyaˈari aga ya nǝ ngǝ vanyi sǝ mai.’ <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>Ya nar hyi, alaga naja gǝra hyaˈari ji nǝ nyi sau, arya nanda bazhi, ju hyaˈari ja nǝ nyi kalar sǝra ju yiwu arya bazhi nyi kǝ aˈyi sǝli ǝnga kǝdi kǝra ji mǝl mai.<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>“Ya vǝr na anǝ hyi, hya dumwa ǝnga kǝdiyau, nju nǝ hyi. Hya dumwa ǝnga gal, hyu uya. Hya dumwa ǝnga tsatsa tsu, nju pahǝna hyi. <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>Ara kalar ndǝra kǝdiyau, nju nǝ nyi, kalar ndǝra gal, ju uya, ndǝra tsa umbwa tsu, nju pahǝna nyi. <verse eid="LUK 11:10"/><verse number="11" style="v" sid="LUK 11:11"/>Ndǝ aˈyi wu pama hyi kǝra ar viya tada, ma zǝr nyi kǝdi kalfi, ba ja nǝ nyi pabǝ ya? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>Əndǝga ma ji yiwa hihi, ba nja nǝ nyi ǝdi ya? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>Ma nahyi, nji ɗǝɗǝmwaˈyi wu sǝni nǝ nyi anǝ wazhar hyi sǝ mǝmǝnahǝu, abari ngǝ Dǝrhyi kǝra a dǝmǝlma? Ju sa nǝ nyi Mambǝl Cicau anǝ njira wu kǝdi ara ja.”<verse eid="LUK 11:13"/></para>
  <para style="s1">Yesu Cabiya Abǝr Naja Aˈyi A Vǝr Mǝl Thlǝr <optbreak/> Ənga Dǝnama Nǝ Shatan Mai</para>
  <para style="r">(<ref loc="MAT 12:22-30">Matiwu 12:22-30</ref>; <ref loc="MRK 3:20-27">Markusu 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>Vanyi pǝci Yesu kǝdlǝbiya mambǝl ɗǝmwaˈyi sara wu dza ndǝ mǝga. Ənggǝra mambǝl kǝ biya, ba nda nyi mbar ndǝr, sǝ kǝ ɗa sǝ dǝdǝgur anǝ daɓǝr nji. <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>Ama alenyi nji na, “Ənghǝng! Ndǝ kau, Bilzabulu ngǝ nǝ nyi dǝnama kǝdlǝ mambǝl ɗǝmwaˈyiˈyar kau, a biya.”<verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>Alenyi nji dzǝbiya Yesu, ndǝ na anǝ nyi, “Mǝliya sǝ dǝdǝgur kǝra cabiya abǝr Hyal ngǝ sǝwa ngau.” <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>Ama Yesu wu sǝn ɗǝngar nda, kǝ ji na anǝ nda, “Kalar tǝlkur kǝra tǝkǝbiya dzǝ mǝthlǝ wu taˈyi mai, ǝnga kalar mǝlmǝ ǝnga ki kǝra aˈyi hǝnggǝr ǝnga kuvwa nyi mai, nanda aˈyi wu sǝn taˈyi mai. <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>Ma tsu shatan tǝkǝbiya dzǝ pamǝpamǝ mǝthlǝu, abar ngǝ tǝlkur nyi wu sǝn taˈya? Ya na abangau ara ǝnggǝra hyi hǝri abǝr ǝnga dǝnama nǝr Bilzabulu nga ya vǝr kǝdlǝ mambǝl ɗǝmwaˈyiˈyar. <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>Kabangǝkau, Ma ǝnga dǝnama nǝ Bilzabulu nga yu kǝdlǝ mambǝl ɗǝmwaˈyiˈyar, kar zǝmbǝlmar hyiˈyar tsu? Ənga mi nga ndu kǝdla? Agabangau, nanda ngu nda mǝl numa anǝ hyi ar kǝra sǝˈyar kau. <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>Ama maɗa ǝnga dǝnama nǝ Hyal nga ya vǝr kǝdlǝ mambǝl ɗǝmwaˈyiˈyar kau, a ɗari abǝr tǝlkur Hyal a shiliri anǝ hyi.”<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>“Ma ndǝra ǝnga dǝnama pabǝri kǝrnyi ǝnga kar pa, ja vǝr ɓǝla ki nyi, kar ki nyi wu nggya jamǝkur. <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>Ama ma ndǝra ndiya nyi ǝnga dǝnama hǝri nyi pa a shili, ba ji sa ndiya dǝnama nyi, ju sǝn faˈari kalar sǝr pa kǝra ju fǝr kǝr ǝni, ba ja dzǝgwa tǝtǝkǝna kar nyi kau, ǝkkǝˈyi kari ki nyi kǝra ji mbǝliya kau.<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>“Ndǝra gǝra ǝnga yau, dawa ɗa ngau, ǝnga ndǝra gǝra vǝr kaɓǝ ǝnga yau, tǝtǝlna nga ja vǝr tǝtǝlna.<verse eid="LUK 11:23"/></para>
  <para style="s1">Sha Shilir Mambǝl Ɗǝmwaˈyu <optbreak/> A Vu Dza Ndau</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>“Ma nji kǝdlǝbiya mambǝl ɗǝmwaˈyi a biya sara wu dza ndau, ma ji gal vir sǝ hǝɗa katini, ju sǝn na, ‘Ya ɓǝra sha a ndu dza ndǝra yi biya sara a gwa.’ <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>Ma ji ɓǝra sha shili, ba ji sa thlǝwa dzǝ kau, nji tsǝkǝbiya camǝu, ǝnga kalar sǝ wu lagu, <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ba ja ɓǝra sha, ja nda faˈari mambǝlˈyar pamǝpamǝ mǝɗǝfǝ kǝra ndiya nyi ǝnga shishikur, ba nda maˈyi a vu ja nda vuwa nggya. Ba nggyabiya ndǝ kǝ nǝ yukuɗǝu, a ndiya nǝ tanggǝrma ǝnga ɗǝmwaˈyu.”<verse eid="LUK 11:26"/></para>
  <para style="s1">Barka Nǝ Jiri</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>Ənggǝra Yesu a vǝr na sǝˈyar kau, vanyi mala wu pama nji, hyaˈana ɗahǝu, ji na, “Hyal ja fǝnggǝr nyi barka anǝ mala kǝra yabiya ngau, ǝnga ji hǝr ngau.” <verse eid="LUK 11:27"/><verse number="28" style="v" sid="LUK 11:28"/>Kǝ Yesu shaɗǝwa, ji na, “Barka a ndiya anǝ njira vǝr nggar ndǝr Hyal, ndǝ ɓǝlari.”<verse eid="LUK 11:28"/></para>
  <para style="s1">Ndǝ Gal Mǝtsamǝ Sǝ Dǝdǝgur</para>
  <para style="r">(<ref loc="MAT 12:38-42">Matiwu 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>Ənggǝra njira vǝr shili ǝgya Yesu cakau, kǝ ji na, “Nji kabangǝkau, nji ɗǝmwaˈyi ngau. Ndu gal aga ya cabiya nda mǝtsamǝ dǝdǝgur, ama vanyi mǝtsamǝ dǝdǝgur kǝra ya ca anǝ nda aˈyi mai, kǝl nǝ Yunana, <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>ǝnggǝra Yunana ɗa sǝ dǝdǝgur anǝ njir Niniva, abangǝ tsu ngǝ Zǝr Ndu nda ɗa anǝ nji kabangǝkau. <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>Ar pǝcir numa, Kwatam Shiba wu nda sa hyaˈari ǝnga nji kabangǝkau, ba ja cabiya nda abǝr nanda aˈyi mǝliya kakalǝ mai, arya ji hyaˈari sarar kuɗiyar duniya aga ja sa sǝhimi highiɓǝ nǝ tsǝtsǝlkur nǝ Solomanu. Kǝja ndǝra ndiya Solomanu aˈyi ǝnggau. <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>Ara ar pǝcir numa, njir Niniva wu nda hyaˈari ǝnga njir zaman kau, ba nda canǝ nda abǝr nanda aˈyi mǝliya sǝra kakalǝ mai, arya nanda njir Niniva tubi ar pǝcira Yunana tǝtǝlna nda ndǝr Hyal. Ya, kǝja ndǝra ndiya Yunana aˈyi ǝnggau.<verse eid="LUK 11:32"/></para>
  <para style="s1">Mbǝmbǝl Pitǝlla Nǝ Dzau</para>
  <para style="r">(<ref loc="MAT 5:15">Matiwu 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>“Nja sǝn mbǝbiya pitǝlla ba nja mbuya ǝgya kiɗa tǝm mai. Ama nja kyaga fiya a dar madzigam, ar vi kǝra ja sǝn mbǝl anǝ kalar ndǝ kǝra a vu ki kau. <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>Li ca ngǝ mbǝmbǝl nǝ dzau. Ma liya gǝ mǝnahǝu, dza gǝ patǝ wu nyabiya dzǝ ǝnga mbǝmbǝl. Ama ma liya gau aˈyi jamǝ mai, patǝr dza gǝ tsu wu nda nyabiya dzǝ ǝnga kuthlǝu. <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>Ga tsamǝ ga lari abǝr mbǝmbǝl kǝra wu gau aˈyi kuthlǝu mai. <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>Ma patǝr dza gǝ aˈyi nyinyau ǝnga mbǝmbǝl, vi aˈyi kǝra ǝnga kuthlǝ mai, ba ja cabiya mbǝmbǝlkur patǝu, ǝnggǝr mbǝmbǝl nǝ pitǝlla a vǝr ca mbǝmbǝlkur nyi.”<verse eid="LUK 11:36"/></para>
  <para style="s1">Yesu Kughiya Njir Farisi <optbreak/> Ənga Malǝmǝ Dlaɗǝˈyar</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matiwu 23:1-36</ref>; <ref loc="MRK 12:38-40">Markusu 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>Ənggǝra Yesu kuɗǝna ndǝr, ba vanyi ndǝr Farisi nggar nyi a ndu ki nyi, aga nda nda sǝm sǝr sǝm. Kǝ ji maˈyi, ji nggya ar vi sǝm sǝr sǝm. <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>Ama ǝnggǝra ndǝr Farisi lari Yesu aˈyi cina tsi, ji dzǝgwa sǝm sǝr sǝm mai, ba ɗa sǝ dǝdǝgur anǝ nyi. <verse eid="LUK 11:38"/><verse number="39" style="v" sid="LUK 11:39"/>Kǝ Thlagǝ na anǝ nyi, “Nahyi njir Farisi, hyu sǝn cina ya cala miya ha ǝnga cala, ama ɗǝfuwa hyi nyinyi nga nyi ǝnga dlǝrbǝ ba ɗǝmwaˈyikur. <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>Nahyi nji dza, aˈyi Hyal ngǝ mǝliya sǝra ar babal ǝnga sǝra gwu huɗa nyi wa? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>Maja abǝr hyu lǝri sǝra ara hyu cala anǝ nji tǝtǝ dǝnama kalar sǝ wu ɗa cici anǝ hyi.”<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>“Sǝr tǝhuɗǝ anǝ hyi njir Farisi arya hyu hǝbiya pathlǝ wu sǝ kumo anǝ Hyal alaga wu sǝ kukushu kǝra hyu uya patǝ ǝnggǝr sukwar hyali ǝnga sǝ kisǝu. Ama kǝ hyi dzǝgwa piyari nu sǝra tsaˈa hya mǝl ǝnga yiwu Hyal. Sǝˈyar kǝ nga hya kyaga mǝl aˈyi hya piyari alenyi sǝ mai.”<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>“Kawa mau, njir Farisi arya hya vǝr yiwu nja nǝ hyi vir gya tsapǝu wu umbwa daɓǝ dzǝ njir Yahudiya, ǝnga tsu nja usa hyi ar sugu. <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/>Kawa anǝ hyi njir Farisi arya a ɗar hyi ǝnggǝr hu kǝra ɗǝɗǝwa nja vǝr ɓǝ a dar ara gǝra ǝnga sǝnkur.”<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>Kǝ pathlǝ wu pama malǝmǝ highiɓǝ nǝ dlaɗǝ Musa na anǝ Yesu, “Malǝmǝ ma gu na sǝˈyar kǝ abangau, naˈya ma a nggǝliya ˈyar gau.”<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>Yesu shaɗǝwa, ji na, “Kawa anǝ hyi, nahyi malǝmǝ highiɓǝ nǝ dlaɗǝ nǝ Musa, arya nahyi fǝnggǝr nyi anǝ nji sǝ tǝdǝɓǝu kǝra ɗa dzadzau nda hau, ama nahyi ǝnga kǝrhyi a sǝn hǝri alaga zǝr tsa hyi zǝmǝ aga dlǝwa nda ǝni mai.<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>Sǝr tǝhuɗǝ anǝ hyi, arya hyi hǝriya hu mǝnahǝ nǝ nabiˈyar kǝra ǝjir hyi ˈyar ngǝ tsǝya nda. <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>Agabangau, a cabiyari abǝr a hǝnggǝr hyi ǝnga sǝra ǝjir ˈyar mǝliya abǝr kakalǝ nga nyi. Nanda ngǝ tsǝya nabiˈyar ba hyi hǝrna hur nda. <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>Ara kǝ ngǝ Hyal wu tsǝtsǝlkur nyi nana, abǝr, ‘Yi wu nda sǝwa nda nabiˈyar ǝnga cama sǝsǝˈyar. Ndu nda tsǝya alenyi nju pama nda ǝnga nji ndu nda nǝ ɓwaɓwatǝ gagaɗau.’ <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>Agabangau, nju nda mǝliya nyi numa anǝ njir zaman kau, arya culi nabiˈyar kǝra ndǝ dlǝna mbar dzǝgwar duniya baˈanǝ kabangǝkau, <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>mbari ar mashir Habila, ba shili ar nǝ Zakariya ndǝra nji tsǝya wu pama vir thla sǝ ǝnga vi cici nǝ ki Hyal. Yu na anǝ hyi, nju nda mǝlna nyi numa anǝ nji zaman kau, arya sǝˈyar kǝ patǝu.<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>“Sǝr tǝhuɗǝ, anǝ hyi malǝmǝ highiɓǝ nǝ dlaɗǝ Musa arya hyi dana lagu kǝra nja sǝni Hyal ari, nahyi ǝnga kǝrhyi, nahyi gwa mai, ǝnga nahyi piyari njir yiwu gwa nda gwa tsu mai.”<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>Ənggǝra Yesu piyari viya nyi, kǝ malǝmǝ dlaɗǝˈyar ǝkkǝˈyi njir Farisi dzǝgwa dumwa ǝnga ciɗǝ nyi ndu tsǝtsǝbwar ǝnga yiwa sǝ pamǝpamǝ gangǝu. <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>Ndu gal lagu kǝra nda uya nda vazǝya nyi lagur sǝra ju na.<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">Kughi Ar Kǝra Nggya <optbreak/> Ənga Njir Ngguta Nji</para>
  <para style="r">(<ref loc="MAT 10:26-27">Matiwu 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>Ar pǝci ta nji gangǝ kaɓau, kǝl ta gangǝkura nda cakǝ ndǝ dzǝgwa jajahǝ Kǝrnda aga nda lari Yesu. Kǝ Yesu dzǝguya na anǝ zǝmbǝlma nyiˈyar tanggǝrma, abǝr, “Hya hangǝkal ǝnga thlǝlam nǝ njir Farisi, kǝra cabiya ǝnggǝra ndu ngguta nji. <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>Kalar sǝ aˈyi kǝra ndu mǝl ɗǝɗǝwa kǝra gǝra nda biyar babal mai, ǝtsu sǝ aˈyi ɗǝɗǝwa kǝra nji gǝra nda sǝn mai. <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>Agabangau, kalar sǝra hyi nana ɗǝɗǝwa, nju nda nggari ar babal. Ətsu, sǝra hyi nana a vu himiya ndǝ zǝmǝ a gu ndǝlmbwa kǝra hahaɗau, nju nda hǝˈuna sara dar kǝra umbwa.”<verse eid="LUK 12:3"/></para>
  <para style="s1">Ndǝra Nja Kyaga Hivǝr Nyi</para>
  <para style="r">(<ref loc="MAT 10:28-31">Matiwu 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>“Nahyi bazhi ɗaˈyar, yu na anǝ hyi, hya sara hivǝr njira wu sǝn tsǝya kumǝr dzau, ama ayukuɗa nyi, sǝ aˈyi ndu ɓǝra sǝn mǝliya tsu mai. <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>Ama yu nar hyi ndǝra hya hivǝr nyi. Hya hivǝr Hyal, ndǝra ayukuɗa ji tsǝya ngau, ju ɓǝra sǝn vakuwa ngǝ a gwu uˈur kǝtsa. Jiri nga yu na anǝ hyi, naja nga hya kyaga hivǝr nyi!<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>“Aˈyi nju ɗǝlna wazha ˈyagǝ mǝthlǝ ar kǝra peni pathlǝ wa? Alaga abangau, Hyal aˈyi faˈari ǝnga zǝma nda mai. <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>Ənga jiri, shishir kǝra hyi ma jijiga nga nda. Agabangau, a sara hya hivǝr mai. A ndiyar hyi wazha ˈyagǝ ǝnga mǝnahǝ gagaɗau.<verse eid="LUK 12:7"/></para>
  <para style="s1">Cabiya Hǝnggǝr Ngau <optbreak/> Wu Yesu Wu Mwar Nji</para>
  <para style="r">(<ref loc="MAT 10:32-33">Matiwu 10:32-33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19-20">10:19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>“Yi wu na anǝ hyi ǝtsu, kalar ndǝra hǝnggǝr abǝr naja nǝɗa nga ja a dumwar nji, nayi tsu, yu nda hǝnggǝr abǝr nǝɗa nga ja a dumwar waladiˈyar nǝ Hyal. <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>Ama ndǝra piyari ɗa wu mwar nji, nayi tsu wu nda piyari nyi wu mwar waladiˈyar nǝ Hyal.<verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>“Kalar ndǝra ndǝr nǝ diɗa Zǝr Ndau, nju nda tǝfǝbiya nyi, ama kalar ndǝra ndǝr nǝ diɗa Mambǝl Cicau, nju nda tǝfǝbiya nyi mai.<verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>“Ma nji hǝri hyi a ndumwar njir umbwa daɓǝ dzau, ǝnga a ndumwar njir pathla, ǝnga tsu njira nggurǝm nǝ mǝlmau, hya sara ɗǝnga ǝnggǝra hyu nda hǝbiya kǝrhyi mai, ǝnga sǝra hyu nda na mai, <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>arya Mambǝl Cici wu nda highiɓǝr hyi sǝra hyu nda na ar pǝci ta.”<verse eid="LUK 12:12"/></para>
  <para style="s1">Karapau Ar Kǝra Ndǝr Gǝnna Kǝra Dza</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>Kǝ vanyi ndǝ sara wu pama nji na anǝ Yesu, “Malǝmǝ, nar nyi anǝ zamǝ ɗa ja nǝ ɗa sǝr faˈa ki ɗa kǝra dǝrˈya tǝ ji piyari ˈya.”<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>Yesu shaɗǝwa nyi, ji na, “Nagau! Wa ngǝ mǝliya ɗa ndǝr numa, ǝnga ndǝr tǝkǝ sǝra dǝr hyi tǝ ji piyari hya?” <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>Kǝ ji dumwa ǝnga ndǝr anǝ nji, ji na, “Hya tsǝrpǝr kǝrhyi, hya nggya ǝnga hangǝkal ara suna sǝr duniya a sara mbar hyi, arya gangǝkura sǝr duniya aˈyi ca ngǝ uya pi mai.”<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>Kǝ ji nar nda vanyi karapau, abǝr, “Vanyi ndǝr gǝnna saya ɗa, kǝra uya barka sǝ zǝzǝwa gangǝ gagaɗau. <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>Kǝ ji mbar ɗǝnga wu ɗǝfuwa ja, ji na, ‘Kǝja vir fiya sǝ zǝzǝwa ɗa aˈyi mai. Mi nga ya mǝl kabangǝka?’<verse eid="LUK 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18"/>“Kǝ ji na anǝ kǝrnyi, ‘Ənghǝng! A sǝni yi sǝra ya mǝl. Ya tǝtǝlna tsamˈyar kau, ba ya dzǝgwa hǝriya nggunggurǝma nyi, kǝra sǝni hǝri sǝ zǝzǝwa ɗa ǝnga alenyi kar ɗa. <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>Ya dzǝgwa nar nyi anǝ kǝrɗa, “Nagau!” Kǝja gǝ ǝnga sǝ zǝzǝwa gangǝu, kǝra ga sǝn mǝl thlǝr ǝni nǝ fa gangǝu. Ga ɓǝliya sar, ga sǝm, ga sa, ga dzǝgwa caguli.’ ” <verse eid="LUK 12:19"/><verse number="20" style="v" sid="LUK 12:20"/>Ama kǝ Hyal na anǝ nyi, “Nagǝ ndǝ dza! Əshina vuˈyi kau, nga yu dlǝwuri piya gau. Ya dzǝgwa lari tara wa ngu nda sǝm sǝˈyar kǝ gǝ tsǝmiya anǝ kǝr ngǝ kau.”<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>Yesu kuɗǝna ndǝr kau, ǝnga na, “Abangǝ nga nyi wu nda ɗa anǝ kalar ndǝra tsǝmiya sǝr duniya anǝ kǝrnyi, ama wu mwar Hyal naja aˈyi ndǝr gǝnna mai.”<verse eid="LUK 12:21"/></para>
  <para style="s1">A Sara Hya Ɓwanǝ Nyi Kǝr <optbreak/> Anǝ Kǝrhyi Mai</para>
  <para style="r">(<ref loc="MAT 6:25-34">Matiwu 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>Kǝ Yesu na anǝ zǝmbǝlma nyiˈyar, “Agabangau, yu na anǝ hyi, a sara hya ghǝɗǝr kǝrhyi arya nggyabiyar ǝnga sǝra hyu sǝm ǝnga sǝra hyu sa mai, alaga ar kǝra kar dza hyi tsu mai. Arya piya ndau, aˈyi a ndiya sǝr sǝm wa, ǝnga dza ndǝ aˈyi a ndiya sǝr ha wa? <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>Arya pi a ndiya sǝr sǝm, dzǝ tsu a ndiya sǝr ha. <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>Tsama mǝ ˈyagǝˈyar gǝyi, nandǝ wu thlǝka mai ǝnga nandǝ wu gǝm mai ǝnga tsu nandǝ wu pǝ sǝ wu val mai, alaga abangau, dǝr hyi kǝra a dǝmǝlmǝ nga vǝr sǝmǝna nda. Ya, aˈyi hyu ndiya nda ǝnga dudurkur wa? <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>Wa ngu pama hyi ara ɓwakǝr nyi, ba ja sǝn cakǝri saka pathlǝu a dar kǝra piya ja? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>Ma nahyi aˈyi a sǝn mǝliya sǝ kushu ǝnggǝr kǝ mai, mi ngǝ ɗa hyu ɓwakǝr ǝnga alenyi sa?<verse eid="LUK 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27"/>Tsama mǝ jigwal wu gǝyi, ǝnggǝra ndu hau. Nandǝ wu mǝl thlǝr alaga shi paˈwa mai. Agabangau, yu nar hyi, alaga tǝl Solomanu ǝnga kadakadarkur nyi aˈyi saya har kari ǝnggǝr nǝr nda mai. <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>Ma abangǝ ngǝ Hyal wu har nyi kar anǝ jigwal wu a gwar tagǝu, kǝra aˈyi nda ǝshina ama ǝzǝgǝu a fuwar nji a gu uˈu, aˈyi ju nda har hyi kar a ndiya nda wa? Nahyi njira ǝnga mbǝrsa kukushu.<verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>“Hya sara ghǝɗǝr kǝrhyi, hyu na, ‘Mi nga ˈya wu nda sǝma ǝnga mi nga ˈya wu nda sa,’ alaga ‘Mi nga ˈya wu nda ha mai.’ <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>Arya njir duniya njira gǝra sǝn Hyal ngu gal sǝˈyar kau. Dǝrhyi kǝra a dǝmǝlmau wu sǝni abǝr hyu yiwu sǝˈyar kau. <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>Ama sǝ tanggǝrma, ca ngǝ hya gal tǝlkur Hyal ǝnga tsapǝkur nyi ba ja nǝ hyi sǝˈyar kǝ patǝ tsu.<verse eid="LUK 12:31"/></para>
  <para style="s1">Ɗǝwa Gǝnna A Dǝmǝlmau</para>
  <para style="r">(<ref loc="MAT 6:19-21">Matiwu 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>“Nahyi kǝra kukushu njir nu ɗa ǝnga jiri, a sara hya hivǝr mai, arya dǝr hyu yiwu ja nǝ hyi tǝlkur nyi. <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>Hya ɗǝlna sǝra aˈyi ara hyi patǝu, hya nǝ nyi gǝnna nyi anǝ nji tǝtǝ dǝnama. Aga hya uya anǝ kǝrhyi gǝnna a dǝmǝlmau, vira kǝthla ǝnga vuyavuya a sǝn ndzana mai, vira tsu njir hǝl wu sǝn pǝthlǝna nda vuwa faˈari mai <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>Arya vira gǝnna ngǝ ari, ǝna ngǝ ɗǝfuwa gǝ tsu.<verse eid="LUK 12:34"/></para>
  <para style="s1">Mafaˈyar Kǝra Tsǝrpǝri Kǝr Nda</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>“Hya tsǝrpǝr kǝrhyi, hya nggya ǝnga fǝr kǝr, ǝnga pitǝllar hyi mbǝmbau. <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>Hya ɗa ǝnggǝr mafaˈyar kǝra a vǝr sǝkǝ shilir thlagǝr kir nda sara wu mini nǝ hǝ dzau, aga ma ji shili, ji sa tsa miya ɗǝvau, ba nda nggari nda pahǝna nyi ǝnga kusa. <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>Wu nda ɗa sǝr caguli anǝ mafaˈyar kǝ ma thlagǝr kir nda shili ji thlǝwa nda liliˈu. Jiri nga yu na anǝ hyi, ju nda zǝɗǝna lǝgutǝ dǝgal kǝra ar dza ja, ja dzǝgwa hǝri nyi sǝr sǝm a nda nǝ mafaˈyar kau, ba ja dzǝgwa na anǝ nda nggya mau, hya sǝm sǝr sǝm. <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>Barka anǝ mafaˈyar kǝ kǝra thlagǝr kir nda thlǝwa nda liliˈu ar kalar pǝci kǝra ji shili tara hathlǝr vuˈyi ǝnga tara mudlǝ kaɗǝu, nda vǝr sǝ nyi. <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>Nggabiya mau, ma ja abǝr thlagǝr ki wu sǝni pǝci kǝra ndǝr hǝl wu shili wu ki nyi, ju nggya liliˈu, naji wu piyari ndǝr hǝl a sa pǝthlǝ ki nyi mai. <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>Agabangau, kǝl hya nggya papabau, arya nahyi wu sǝni tara ǝnuwa ngǝ Zǝr Ndau wu nda shili ari mai.”<verse eid="LUK 12:40"/></para>
  <para style="s1">Mafa Tsapǝu Ənga <optbreak/> Kǝra Gǝra Tsapǝu</para>
  <para style="r">(<ref loc="MAT 24:45-51">Matiwu 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>Kǝ Biturusu na, “Thlagǝu, karapǝ kau, ar kǝra ˈya nga nyi, ǝndǝga ar kǝra patǝr nji ya?”<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>Kǝ Thlagǝ shaɗǝwa nyi, ji na, “Wa ngǝ ndǝr mǝl thlǝr kǝra nji fǝr kǝr ǝnga ja ǝnga ndǝ hahanga? Naja ngǝ ndǝ kǝra tarki nyi fiya nyi dǝgal ar kǝra njir mǝl thlǝr nyiˈyar, aga ja nǝ nda sǝr sǝm ar pǝci kǝra tsatsaˈa? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>Mafa kǝra thlagǝr ki nyi shili ji sa thlǝwa nyi ja vǝr mǝl thlǝr nyi kakalǝu, ju ɗa ǝnga caguli. <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>Yu nar hyi jiri, tarki nyi wu nda fiya nyi dǝgal ar kǝra sǝ nyi patǝu. <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>Ama ma ji ɗa, ndǝr mǝl thlǝr kǝra ɗǝmwaˈyi ngau, ju nda na anǝ kǝrnyi, ‘Kǝja tarki ɗa a nggyari ara shili kaɗǝu.’ Ba ji nggya aga dǝgǝ njir mǝl thlǝr kuvwa nyiˈyar ǝnga ju sǝm ǝnga sa sǝ sasa ǝnga njir sa sǝ sasa. <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>Ma ji mǝl abangau, tarki nyi wu nda shili kukuthlǝu ar pǝci kǝra ji gǝra nggani ju shili. Tarki wu sa takasiya nyi ba ja sǝwa nja vakuwa nyi a vu pama njir ngguta vi, vira ndu vuwa nggya ndu tiwi ǝnga sǝlǝm ba ǝnga ɗǝ hir.”<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>“Mafa kǝra wu sǝni sǝra wu huɗa thlagǝr ki nyi, ama kǝ ji nggǝl ara tsǝrpǝri kǝrnyi ǝnga naja aˈyi mǝl sǝra ju yiwu mai, nju nda sa dǝgǝ nyi gagaɗau. <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>Ama mafa kǝra gǝra sǝni sǝra thlagǝr ki nyi wu yiwu ja mǝl, ba ji mǝliya sǝra tsaˈa nja dǝgǝ nyi, nju nda dǝgǝ nyi kushu. Kalar ndǝra nji nǝ nyi sǝ gangǝu, nju nda gal sǝ gangǝ ara ja. Ma ndǝra tsu nji nǝ nyi sǝ gangǝ gagaɗau, nju nda gal sǝ gangǝ gagaɗǝ sara ara ja.<verse eid="LUK 12:48"/></para>
  <para style="s1">Yesu Shili Ənga Tǝtǝkǝ Dzau</para>
  <para style="r">(<ref loc="MAT 10:34-36">Matiwu 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>“Uˈu nga yi dla ǝni wu duniya. Cimǝ ɗa kabangǝkau, a mbǝbiyar nji uˈuwa nyi! <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>Aˈyi yi ǝnga baɓǝtizǝma nǝ ɓwaɓwatǝ kǝra nja mǝl anǝ ɗa, hangǝkal ɗa a hyaˈari kǝl ma nji mǝliya ɗa. <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>Hyu nggani abǝr nggya jamǝ nga yi shili ǝni anǝ duniya ya? Əman de! Yu nar hyi, tǝkǝ dzǝ nga yi shili ǝni. <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>Mbar kabangǝkau, wu ki zǝmǝu, nji tǝfu wu nda tǝkǝbiya dzǝ pamǝpamǝ mǝthlǝu, nji makǝr ar kǝra nji mǝthlǝu, nji mǝthlǝ tsu ar kǝra nji makǝru. <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>Tada aˈyi ǝnga zǝr mai, zǝr tsu aˈyi ǝnga dǝnyi mai. Ama aˈyi ǝnga kwa nyi mai, kwa tsu aˈyi ǝnga mǝnyi mai. Miya sal aˈyi ǝnga kwanjili nyi mai, kwanjili tsu aˈyi ǝnga miya sal nyi mai.”<verse eid="LUK 12:53"/></para>
  <para style="s1">Sǝnbiya Pǝci</para>
  <para style="r">(<ref loc="MAT 16:2-3">Matiwu 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>Yesu ɓǝra na anǝ nji, “Ma hyi lari dlama hyaˈari sara gyiwu Gwa Tǝɗǝ Pǝci, ba hya na, ‘Nda tǝɗǝ par nga nji,’ ba par a tǝɗau. <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>Ma tsu hyi nggari yambaɗǝ a vǝr sǝ sara wu lagu Dǝ Fwahǝu, ba hya na, ‘Wu nda ɗa kwakwaɗǝu,’ ba ja ɗa abangau. <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>Njir ngguta vi! Hyu sǝni tsamǝr sǝra wu duniya ǝnga a dǝmǝlmau, ama nahyi a sǝn tsamǝ ri sǝra nggyabiya kabangǝkǝ ar kǝri mai.”<verse eid="LUK 12:56"/></para>
  <para style="s1">Ɓasǝwa dzau Ənga Ndǝr Hǝ Ngau <optbreak/> A Ndǝ Wu Mwar Pathla</para>
  <para style="r">(<ref loc="MAT 5:25-26">Matiwu 5:25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>“Mi ngǝ ɗa nahyi ǝnga kǝrhyi a sǝni tsamiya sǝra mǝnahǝu hya mǝl maya? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>Ma ndǝ wulana ngau a mwar pathla, hya ɓasǝwa ǝnga ja tsu hyar lagu, aˈyi abangǝ mai, ba ja fuwa ngau a gu tsa ndǝr pathla ba ndǝr pathla tsu a fuwa ngau a gu tsa dǝgala ndǝr fursǝna, ndǝr fursǝna tsu ba ja fuwa ngau a gu fursǝna. <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>Ya nar ngǝ jiri, nagǝ wu biya mai, kǝl gǝ kina patǝr sǝra nju nu ngau.”<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">Sha Mau A Shili Əgya Hyal</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>Kakalǝ ar pǝci kau, alenyi nji aˈyi kǝra ǝna, ndǝ nar nyi anǝ Yesu ar kǝra njir Galili kǝra Bilatusu na nja dlǝna nda ar pǝcir ngguɗǝ sǝ anǝ Hyal nda, kǝl ta mashir nda daɓǝr dzǝ ǝnga mashi sǝra nda vir thla anǝ Hyalǝr nda. <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>Yesu shaɗǝwa nda, ji na, “Kǝ hyi nggani njir Galili kǝ nji tsǝya kǝ nga ndiya patǝr njir Galili ǝnga bikǝ ya? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>Ya nar hyi, Awau! Ma nahyi aˈyi tubi sara ara bikǝr hyi mai, patǝkura hyi, hyu nda kuɗǝna ǝnggǝr nanda. <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>Əndǝga, hyu nggani nji kumo apǝ cisu kǝ umbwa dzǝgamǝ dla a gyar kǝra nda wu Sǝliwamu, ba ndǝ tǝ kau, nanda nga ndiya patǝr njir Urshalima ǝnga bikǝ ya? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>Ya nar hyi, Awau! Ma nahyi tsu aˈyi tubi mai, nahyi ma hyu nda sanakǝr ǝnggǝr nanda.”<verse eid="LUK 13:5"/></para>
  <para style="s1">Karapau Ar Kǝra Ɓǝla Kǝra <optbreak/> Gǝra Pǝ Wazha</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>Kǝ Yesu nar nda karapǝ kau, “Vanyi ndǝ aˈyi ǝnga wur ɓǝla wu fa nyi. Kǝ ji shili aga ja sa uya yaya nyi, ama naji uya alaga zǝmǝ mai. <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>Kǝ ji nar nyi anǝ ndǝr sǝkǝ fa kau, ‘Tsamiya gǝyi, fa makǝr ǝshina nga ya vǝr shili aga ya sa uya wazha ar wur ɓǝla kau, ama nayi saya uya mai. Gǝmna nyi! Ara mi nga nja piyari nyi ja nyana vi kurthla?’<verse eid="LUK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8"/>“Ama kǝ ndǝr sǝkǝ fa na anǝ nyi, ‘Ndǝ dǝgal, cakǝri nyi nji fa pathlǝu, yu nda labiya dza nyi, ya pǝr nyi gwaɓa. <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>Ma ji sǝni pǝ wazha wu fa kau, jamǝu! Ma naja aˈyi sǝn pǝ wazha tsu mai ba ga dzǝgwa gǝmna nyi.’ ”<verse eid="LUK 13:9"/></para>
  <para style="s1">Yesu Mbǝɗana Vanyi Mala <optbreak/> Pǝcir Ɓǝlsar</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>Vanyi pǝci, Yesu ja vǝr highiɓǝ wu vanyi umbwa daɓǝ dzǝ njir Yahudiya pǝcir Ɓǝlsar, <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>kǝja vanyi mala kǝra mambǝl ɗǝmwaˈyi nǝ nyi shilǝgǝ nǝ fa kumo apǝ cisu, ji nggǝya nyi naja sǝn taˈyi pir mai. <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>Ənggǝra Yesu lari nyi kǝ ji ngga nyi ji na, “Mala, a mbǝɗana ngǝ ri nji ara shilǝgǝ ngau.” <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>Ba ji fǝri tsa ja ar ja, ǝnggau, ba ji taˈyi pir, kǝ ji fal Hyal.<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>Kǝ huɗa ndǝ dǝgal nǝ umbwa daɓǝ dzǝ njir Yahudiya ndzǝ ǝnga Yesu ara ji mǝliya mala kǝ jamǝ pǝcir Ɓǝlsar. Kǝ ji na anǝ njira ǝna, “Pǝci kwa aˈyi nǝ mǝl thlǝr, hya shili wu pǝciˈyar kǝ nja sa mbǝɗana hyi, ama aˈyi pǝcir Ɓǝlsar mai.”<verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>Ama kǝ Thlagǝ na anǝ nyi, “Nahyi njir ngguta nji! Aˈyi hyu pǝlna thlar hyi alaga kwarar hyi, hya maˈyi ǝnga nda a ndar vir sa ˈyimi ar pǝcir Ɓǝlsar wa? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>Mala kau, kwar Ibrahimu, kǝra shatan mbiya nyi nǝ fa kumo apǝ cisu, aˈyi ɗa tsaˈa nja mbǝɗana nyi wu pǝcir Ɓǝlsar wa?” <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>Kǝ sǝli mbari patǝr dawa nyiˈyar, ara ndǝr kau. Ama caguli ǝnga huɗǝ pipida nga ara alenyi nji ara sǝ dǝdǝgur kǝra ja vǝr mǝl kau.<verse eid="LUK 13:17"/></para>
  <para style="s1">Karapau Ar Kǝra Culi Bǝla</para>
  <para style="r">(<ref loc="MAT 13:31-32">Matiwu 13:31-32</ref>; <ref loc="MRK 4:30-32">Markusu 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>Əngwar Yesu, “Abari ngǝ tǝlkur Hyala? Ənga mi nga nja kyaga kakalǝ nya? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>Naja ǝnggǝr culi bǝla nga nyi, kǝra vanyi ndǝ hǝri ji thlǝkana wu masǝmǝ nyi. Ji hau, ba ji ɗa wu kǝra ˈyagǝˈyar liya kir nda a dagwa.”<verse eid="LUK 13:19"/></para>
  <para style="s1">Karapau Ar Kǝra Thlǝlam</para>
  <para style="r">(<ref loc="MAT 13:33">Matiwu 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>Kǝ Yesu ɓǝra yiwa, “Ənga mi nga ya sǝn gǝla tǝlkur Hyala? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>Tǝlkur Hyal ǝnggǝr thlǝlamǝ nga nyi, kǝra mala hǝri ji gwaɗǝbiya ǝpou tasaˈwu tǝkǝ sǝ makǝr ǝni, ba ja dzǝgwa thlǝthlǝ gagaɗau.”<verse eid="LUK 13:21"/></para>
  <para style="s1">Miyar Gwa Kǝra Ciciɗǝu</para>
  <para style="r">(<ref loc="MAT 7:13-14">Matiwu 7:13-14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>Ənggǝra Yesu mbar lagu ja vǝr maˈyi a vu Urshalima, ba ji vu alenyi mǝlmǝ nggunggurǝm ǝnga mǝlmǝ kukushu pamǝpamǝu, ja vǝr highiɓǝ anǝ nji. <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>Kǝ vanyi ndǝ yiwa nyi, ji na, “Thlagǝu, nji kushu wacu ngu nda uya mbǝɗǝ ya?”</para>
  <para style="p" vid="LUK 13:23">Yesu na anǝ nda, <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>“Hya nǝrdzau aga hya gwa lagu miyar gwa kǝra ciciɗǝ nǝ tǝlkur Hyal, arya nji gangǝ wu nda yiwu nda gwa, ama nanda sǝn gwa mai. <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>Ma thlagǝr ki hyaˈari ji haɗiya miya ki nyi, hyu nda taˈyi a biya, hyu tsa hyu kǝdiyau, hyu na, ‘Thlagǝr ki, pahǝna ˈya miya ki.’</para>
  <para style="p" vid="LUK 13:25">Ama ju nda shaɗǝwa nda, ‘Nayi wu sǝni hyi mai ǝnga vi kǝra hyi dla sara ndari.’<verse eid="LUK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26"/>Hya dzǝgwa na ja, ‘Namǝn ngǝ sǝm ǝnga sa ǝkkǝˈyi gǝ ta, ǝnga tsu a highiɓǝr gu mǝlmǝr ˈya.’<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>Ama ju ɓǝra na ja, ‘Nayi wu sǝni vi kǝra hyi dla sara ndar mai. Kwaya mǝ wu dzǝ ɗa, nahyi nji ɗǝmwaˈyi hangǝkal!’<verse eid="LUK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28"/>Ar pǝci kǝra hyu nda lari Ibrahimu, ǝnga Ishaku, ǝnga Yakubu, ǝnga patǝr nabiˈyar wu tǝlkur Hyal, ama nahyi nǝr hyi a kǝdlǝna hyir nji, ǝnggau, nga hyu nda tiwi ǝnga hyu ɗǝ hira hyi. <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>Nju nda shili sara wu lagu Sǝbiyar pǝci, ǝnga Gwa tǝɗǝ pǝci, ǝnga Gya vuya, ǝnga Dǝ Fwahǝu, ndu sa nggya nǝ sǝm sǝr sǝm nǝ mini wu tǝlkur Hyal. <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>Ar pǝci ta, alenyi njira wu yukuɗǝ ndu nda sha a dumwa, nji nǝ tanggǝrma wu nda ɗa njir yukuɗu, ǝnga njir yukuɗǝ tsu ndu nda ɗa nji tanggǝrma.”<verse eid="LUK 13:30"/></para>
  <para style="s1">Ənggǝra Nggyar Urshalima <optbreak/> Ɓwanǝ Nyi Kǝr Anǝ Yesu</para>
  <para style="r">(<ref loc="MAT 23:37-39">Matiwu 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>Ar pǝci kǝ ngǝ alenyi njir Farisi shili ǝgya Yesu ndǝ na anǝ nyi, “Hyaˈari ga kwaya ǝnggau, arya Hirudusu ju yiwu ja tsǝya ngau.”<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>Kǝ ji na anǝ nda, “Hya nar nyi anǝ hya tagǝ kǝ abǝr, ǝshina yu kǝdlǝ mambǝl ɗǝmwaˈyu, ya ɓǝra shilǝgǝbiya nji, ǝzǝgǝ ma abangau, caɓcikǝ zǝgǝu, nga yu sa kuɗǝna thlǝr ɗa. <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>Ama yu dumwa ǝnga ɓǝ ǝshina, ǝzǝgǝu, ǝnga caɓcikǝ zǝgǝu, arya aˈyi ɗa tsaˈa anǝ nabi ja tǝ a biyar ya Urshalima mai.<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>“Urshalima, Urshalima! Ndǝr tsa nabiˈyar, ǝnga ndǝr vavaka njira Hyal sǝwa ngǝ a shili ǝnga tsǝka kǝl ta gǝ dlǝna nda! Aga yiɗau nga yu yiwu ya fǝri tsa yi ar dza nji ngǝ pata, ǝnggǝr kǝra miya tǝka wu tsǝm wazha nyi ǝgya ja, ama nahyi piyari ɗa mai! <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>Kǝ ja nju nda piyari hyi kir hyi dzafu! Yu na anǝ hyi tsu, nahyi tsu ɓǝra lar ɗa mai, kǝl pǝci kǝra hyu nda na, ‘Ndǝr barka ngǝ ndǝra dla wu thlǝmǝr Thlagǝu!’ ”<verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">Yesu Mbǝɗana Ndǝ Gǝra Ngga <optbreak/> Ar Pǝcir Ɓǝlsar</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>Vanyi pǝcir Ɓǝlsar, ǝnggǝra Yesu maˈyi a nda sǝm sǝr sǝm wu ki ndǝ dǝgal nǝr Farisi, nji gangǝu pǝnggǝri nyi li. <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>Kǝ vanyi ndǝ kǝra ǝnga hyi ǝnga tsi fifi shili ǝgya Yesu. <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>Kǝ Yesu yiwa malǝmǝ dlaɗǝˈyar ǝnga njir Farisi, ji na, “A ɗar tsaˈa nja shilǝgǝbiya ndǝ ar pǝcir Ɓǝlsar, ǝndǝga awau?”<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>Ama kǝ ndǝ nggya zǝmǝu. Ənggau, kǝ Yesu fǝr tsa ja ar ndǝ kau, kǝ ji shilǝgǝbiya nyi, ji dzǝgwa na anǝ nyi ja maˈyi sǝ nyi. <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>Ənggǝ ngǝ Yesu dzǝgwa yiwa nda, ji na, “Mi nga hyu mǝl ma kwara ǝndǝga thlar hyi tǝɗǝ a gu mǝla pǝcir Ɓǝlsar, aˈyi hyu hǝbiya nyi a biya ǝnga kusa wa?” <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>Kǝ ndǝ tini sǝra nda na ar kǝra yiwa sǝ kau.<verse eid="LUK 14:6"/></para>
  <para style="s1">Ga Hǝr Kǝrngau Ənggǝr Nagau <optbreak/> Aˈyi Vanyi Sǝ Mai</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>Ənggǝra Yesu lari wu pama alenyi nji kǝra nji ngga aga sǝm sǝr sǝm a vǝr gal vir nggya nji dǝdǝgal anǝ Kǝrnda, kǝ Yesu nar nda najaka karapau, <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>“Ma nji ngga ngau a ndar vir hǝ dzau, a sara ga nda hǝ vir nggya nji dǝdǝgal tanggǝrma mai, ara ma vanyi a nggar nji ndǝra ndiya ngǝ ǝnga dǝgalǝu. <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>Naja ndǝra ngga hyi gyapǝu, ju sǝn na anǝ ngau, ‘Hyaˈari, ga nǝ nyi vir nggya anǝ ndǝ kau.’ Ənggau, sǝli wu mbari ngau, ara gu sha a gyar vir nggya kǝra a gya banga ta. <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>Ama ma nji ngga ngau a ndar vir mini, ma gǝ shili, ga gal vi kǝra a biyar ya nji kǝra gǝra nji nǝ nyi dǝgalkur ba ga nggya ǝna, aga ma ndǝ kǝ ngga ngǝ kǝ shili, ju sǝni na anǝ ngau, ‘A ndau ǝnggau, bazhi ɗa, ga nggya ar vi kǝra nji fiya nyi anǝ nji dǝdǝgal kau.’ Kǝ ngu nda mǝliya alenyi nji kǝra nji ngga hyi ǝkkǝˈyi nda, nda nǝ ngǝ dǝgalkur. <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>Arya ndǝra hǝri kǝrnyi ar viya sǝ tsapǝu ba nja tina nyi a gya, ama ndǝra tina kǝrnyi a gya, ba nja hǝri nyi adabanga nji.”<verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>Kǝ Yesu na anǝ ndǝ kǝ ngga nyi kau, “Ma gǝ ngga nji aga sa sǝm sǝr sǝm, ǝnga shili wu mini, ga sara ngga bazhi ngǝˈyar, ǝnga zamǝ ngǝˈyar, ǝnga nji gǝ hyi, ǝnga tǝwul ngǝˈyar njira ǝnga gǝnna waci mai, aga vanyi pǝci nanda ma nda ngga ngǝ tsu. Agabangǝ ndu sǝn kina ngǝ sǝra gǝ mǝliya nda. <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>Ama ma gu ngga nji aga mini, ngga nji tǝtǝ dǝnama, ǝnga nji kukurɓǝu, ǝnga nji tǝsǝkǝnu ǝnga lǝfǝˈyar. <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>Lagu kǝ nga gu uya barka, ara nandǝ wu sǝn kina ngǝ sǝra gǝ mǝliya nda mai. Hyal ǝnga kǝrnyi ngu nda kina ngau, ar pǝci kǝra njir mǝl thlǝr mǝnahǝu, ǝnga jirkur wu nda hyaˈari sarar vir tau.”<verse eid="LUK 14:14"/></para>
  <para style="s1">Karapau Ar Kǝra Caguli Nǝ Mini Dǝgal</para>
  <para style="r">(<ref loc="MAT 22:1-10">Matiwu 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>Ənggǝra ndǝ nggari sǝ kau, kǝ pathlǝ wu pama njira vir nggya ǝnga Yesu ar vir sǝm sǝr sǝm na anǝ nyi, “Ndǝr barka ngǝ ndǝra wu nda sǝm sǝr sǝm nǝr mini nǝr tǝlkur Hyal.”<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>Kǝ Yesu na anǝ nyi, “Vanyi ndǝ saya ɗa kǝra wu yiwu ja tsǝmiya nji aga sǝm sǝr sǝm nǝr mini dǝgalǝu, kǝ ji nggari nji gangǝu. <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>Ənggǝra pǝcir mini kǝ ɗa, kǝ ji sǝwa mafa nyi aga ja maˈyi ja nda nar nyi anǝ nji kǝra ji ngga, ‘Anda mau, arya a fuwar nji kalar sau wu lagu!’ <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>Ama kǝ patǝkura nda dzǝgwa na sǝra ɗa nanda aˈyi sǝni shili mai. Ndǝ tanggǝrma na, ‘Dzǝgwa ɗǝlbiya fa nga yau, a ɗar tsaˈa ya mai ya nda lari. Usi mǝliya ɗa mba ɗǝfu.’ <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>Kǝ vanyi ndǝ na, ‘Dzǝgwa ɗǝlbiya nga yi thla zǝwa pamǝpamǝ tǝfu, ar lagu nga yi kabangǝkǝ aga ya nda dzǝguya thlǝr nga nda, yu kǝdi ngau, nǝ ɗa lagu.’ <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>Kǝ vanyi ndǝ ɓǝra na, ‘Dzǝgwa hǝ mala nga yau, agabangǝ na ya sǝni uya lagu shili mai.’<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>“Kǝ mafa kǝ sha shili ji sa nar nyi anǝ thlagǝri ki nyi sǝˈyar kǝ ndǝ na kau. Kǝ hu ɗa thlagǝri ki nyi ndzǝ gagaɗau, ji dzǝgwa na anǝ mafa nyi, ‘Maˈyi a ndu mǝlmǝˈyar kau kukusa, ga nu lagu dǝgal ǝnga lagu kushu ga nggari ɗa nji tǝtǝ dǝnama, ǝnga nji kukurɓǝu, ǝnga lǝfǝˈyar, ǝnga nji tǝtǝ dzau, ga shili ǝnga nda ǝnggau.’ <verse eid="LUK 14:21"/><verse number="22" style="v" sid="LUK 14:22"/>Ənggǝrna, mafa nyi a shiliri ji na, ‘Thlagǝu, sǝra gǝ na patǝ a mǝliya ri nji, ama tsu vi gangǝu kǝra gǝra nyau.’ <verse eid="LUK 14:22"/><verse number="23" style="v" sid="LUK 14:23"/>Kǝ thlagǝri ki ɓǝra nar nyi anǝ mafa nyi, ‘Ɓǝra maˈyi a biyar ya mǝlmǝ a ndar lagu dǝgalˈyar ǝnga kusha nyi ga nggari kalar ndǝra gǝ lari aga ki ɗa sa nyau. <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>Ya nar hyi, alaga zǝma njira nji ngga tanggǝrma ta a nda uya nda ɗar sǝ kǝ nji mǝliya aga mini kǝ mai.’ ”<verse eid="LUK 14:24"/></para>
  <para style="s1">Ɓwaɓwatǝ Kǝra Nu Yesu <optbreak/> Wu Shili Ni</para>
  <para style="r">(<ref loc="MAT 10:37-38">Matiwu 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>Vanyi pǝci nji gangǝu a vǝr nu Yesu, kǝ ji shabiya dzǝ ji na anǝ nda, <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>“Kalar ndǝra shili aga ja nu ɗa, ma naja aˈyi cabiya ɗa yiwukur a ndiya anǝ dǝnyi, ǝnga mǝnyi, ǝnga mala nyi, ǝnga wazha nyi, ǝnga zamǝ nyiˈyar ǝnga kwamǝ nyiˈyar, ǝkkǝˈyi piya ja ǝnga kǝrnyi mai, naja sǝni ɗa zǝmbǝlma ɗa mai. <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>Kalar ndǝra gǝra hǝri wu dladlakǝ nyi, ja dzǝgwa nu ɗa, aˈyi ja kyaga ɗa nǝɗa mai.<note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false">Wu dladlakǝ cabiya ɓwaɓwatǝ kǝra ndu sa a vǝr nu Yesu.</char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>“Kǝja karapǝ, ma zǝma hyu yiwu ja hǝriya umbwa dzǝgamǝ a dǝmǝlmau, aˈyi ju nggya kwatahǝu, ja tsambiya sǝra hǝri kǝ wu mbari, aga ja tsamiya tara sǝra ara ja a sǝni kuɗǝna hǝra nyi wa? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>Ma naja aˈyi mǝl abangǝ mai, ma hǝri kǝ taˈyi wu lagura ghar gǝnna, patǝr njira wu nda tǝrabiya wu lagu ta ndu nda nggushi nyi, <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>nda dzǝgwa na, ‘Lari ndǝ kǝ ji dzǝguya hǝri ama naji sǝni kuɗǝna mai.’<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>“Abangǝ tsu ma tǝl kǝra ǝnga njir pa nyi dubu kumou, ju yiwu ja hǝ pa a nda nǝ tǝl kǝra ǝnga njir pa nyi dubu mǝthlǝ kumunyi, aˈyi ju nggya kwatahǝu, ja tsamiya tara dǝnama nǝ pana nji kǝ aˈyi ara ja wa? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>Ma ji lari abǝr naja sǝni mbari mai, tsu nda naɗǝ ju sǝwa njir sǝ nyiˈyar aga nda ɓasǝwa nda nggya jamǝu. <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>Abangau nga nyi tsu ma ndǝra aˈyi piyari sǝra ara ja patǝ mai, naja sǝni ɗa zǝmbǝlma ɗa mai.”<verse eid="LUK 14:33"/></para>
  <para style="s1">Karapau Ar Kǝra Unau</para>
  <para style="r">(<ref loc="MAT 5:13">Matiwu 5:13</ref>; <ref loc="MRK 9:50">Markusu 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>“Unau sǝ mǝsahǝu ngau, Ama ma unǝ caɓǝnakǝr, abar nga ju sǝn shabiya kǝrnyi a shila? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>Tsu ja sǝn ɗa mǝnahǝ mai, alaga aga gwaɓa, kǝl ba nja pǝna wacu. Ndǝra ǝnga himi ngga, ja nggari.”<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">Karapau Ar Kǝra Tǝmahǝ Sasa</para>
  <para style="r">(<ref loc="MAT 18:12-14">Matiwu 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>Ənggǝra njir tsǝm budau ǝnga alenyi “njir bikau” A vǝr shili aga nda ngga highiɓǝ nǝ Yesu, <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>kǝ njir Farisi ǝnga malǝmǝ dlaɗǝˈyar dzǝguya jiga miya nda vǝr na, “Lari gǝyi! Ndǝ kǝ a shabiya ri ja kǝrnyi bazhiya njir bikau, ǝkkǝˈyi sǝr sǝm nga ju sǝm ǝnga nda.”<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>Kǝ Yesu nar nda najaka karapau: <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/>“Nja na zǝma hyi ǝnga tǝmahǝu gharu, kǝ zǝma nyi sanakǝr, aˈyi ju piyari ǝdlǝkumunyi apǝ ǝdlau ar vir ɓǝlari nda, ja maˈyi a nda gal kǝra sa kǝ wa? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>Maja nǝr nyi ri, hu ɗa ja wu pida, ja dzǝgwa fǝri nyi ar papadla ja, <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ja hǝri nyi a ndu ki, ja dzǝgwa ngga bazhi nyiˈyar ǝnga njira ju nggya ǝnga nda, ju na anǝ nda, ‘Dlǝwa ɗa mau ǝnga caguli ara a nǝr yau tǝmahǝu ɗa ta sa ta!’ <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>Ya vǝr na anǝ hyi, abangau nga nju caguli a dǝmǝlmau ma ndǝ zǝmǝ tubi, a ndiya nji cicau ǝdlǝkumunyi apǝ ǝdlau, kǝra gǝra ɓǝra yiwu tubi.”<verse eid="LUK 15:7"/></para>
  <para style="s1">Karapau Ar Kǝra Kwaɓa Kǝra Sa</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>“Nja na tsu, mala ǝnga kwaɓa nyi kumou, kǝ zǝma nyi sa, mi nga hyu nggani ju nda mǝla? Aˈyi ju mbǝbiya uˈu wu pitǝlla ja dzǝgwa tsǝkǝbiya ki kǝ ǝnga hangǝkal kǝl ji nǝr wa? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>Maja nǝr kwaɓa kau, ju ngga bazhi nyiˈyar ǝnga tǝwul nyiˈyar, ju na, ‘Dlǝwa ɗa mau ǝnga caguli, ara a nǝr yau kwaɓa ɗa kǝra sa ta.’ <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>Abangǝ tsu yu nar hyi, sǝr caguli ngau anǝ waladiˈyar nǝ Hyal ma ndǝ zǝmǝ ndǝr bikau tubi.”<verse eid="LUK 15:10"/></para>
  <para style="s1">Karapau Ar Kǝra Tada <optbreak/> Kǝra Cabiya Yiwukur</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>Kǝ Yesu dumwa ǝnga ndǝr ji na, “Vanyi ndǝ aˈyi ɗǝɗǝmǝu kǝra ǝnga wazha mǝthlǝu. <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>Zǝr kǝra kushu wu pama nda na anǝ dǝrnda, ‘Tada, nǝ ɗa nji kabangǝkǝ sǝra wu ɗa nǝ ɗa ma ga tǝri.’ Kǝ dǝnyi tǝkǝya nda sǝr fa ki.<verse eid="LUK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13"/>Ayukuɗa pida kushu, kǝ zǝr kǝ faˈari sǝra ɗar nǝ nyi patǝu, ba ji piyari ki. Kǝ ji maˈyi a ndu vanyi mǝlmǝ kǝra a biyar ya ˈyiˈyir nda. A ndǝna kǝ ji tsǝya sǝra ara ja patǝ a ndu nggya nǝ pǝpǝltǝkur. <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>Ayukuɗa a tsiyari ja sǝra ara ja patǝu, kǝ wuɓau ɗǝmwaˈyi gagaɗau shili wu mǝlmǝ kau, naja tsu a gwar ja wu ɓwaɓwatǝ ara tsu sǝ nyi aˈyi mai. <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>Kǝ ji maˈyi a nda gal sǝr mǝl ara ndǝr mǝlmǝ kau, kǝ ndǝ kǝ sǝwa nyi a nda ɓǝla fǝshiu nyi. <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>Ju gal sǝr sǝm fǝshiu kǝ aga ja sǝmku, ama ndǝr nǝ nyi aˈyi mai.<verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>Ənggǝra ji shili wu hangǝkal nyi, kǝ ji na, ‘Kǝja njir mǝl thlǝr anǝ dǝɗa a vǝr tǝtǝl ǝnga sǝr sǝm, nayau ǝtsu a vir tau ǝnga wuɓau ǝnggau! <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>Yu hyaˈari yu sha a ndara dǝɗa ya nda nar nyi, “Tada, a mǝliya ri yau bikau anǝ Hyal, ǝnga anǝ ngau. <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>Nayi ɓǝra ɗa tsaˈa nja ɓǝra ngga ɗa ǝnga zǝr ngǝ mai. Fiya ɗa ya ɗa ǝnggǝr pathlǝu wu pama njir mǝl thlǝr ngau.” ’ <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>Kǝ ji hyaˈari ji maˈyi a ndara dǝnyi.</para>
  <para style="p" vid="LUK 15:20">“Ma tsu ja naɗǝu, kǝ dǝnyi tsamǝ ri nyi. Kǝ dǝnyi tǝhuɗǝ ǝgya ja, ji dzǝgwa hyaˈari ǝnga hwi, ji nda mbari zǝr nyi, ji dzǝgwa mbunggǝr nyi dzau.<verse eid="LUK 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21"/>Kǝ zǝr nyi na, ‘Tada, a mǝliya ri yi bikau anǝ Hyal ǝnga anǝ ngau. Nayi ɓǝra ɗa tsaˈa nja ɓǝra ngga ɗa ǝnga zǝr ngǝ mai.’<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>Ama kǝ dǝnyi nggari mafa nyiˈyar, ji na, ‘Ənga kusa! Shila mau ǝnga lǝgutǝ mǝnahǝu, hya har nyi. Har nya mau shishiˈwu ǝnga ɓiɓi, <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>nja ɓǝra dla ǝnga thla nggǝnggǝthlǝ ta aga nja tsǝya, aga mǝna sǝm, mǝna caguli. <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>Arya zǝr ɗa kǝ ɗǝɗǝmǝ tǝtǝ nga ja ama kabangǝkǝ a ɗar ja aˈyi ǝnga pi. Ɗǝɗǝmǝ sasa nga ja, ama kabangǝkǝ a nǝr nyir nji.’ Kǝ ndǝ gu caguli gagaɗau.<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>“Wu pǝci kabangǝkau, zǝr dǝgal nyi kǝra maˈyi a gwa tagǝu, a vǝr si nga ja. Ənggǝra ji ɗa lǝhǝu, ba ji nggari nja vǝr tsa kangga, ǝnga nja vǝr fǝl. <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>Kǝ ji nggari mafa ki kau, ji yiwa nyi sǝra a vǝr ɗa.”<verse eid="LUK 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 15:27"/>“Kǝ mafa kǝ na, ‘Mǝshikǝr ngǝ ta ngǝ shili, ca ngǝ dǝr hyi mǝliya nji tsǝya thla nggǝnggǝthlǝ ta ara zamǝ ngau sha shili wu ki jamǝu.’ ”<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>“Ama kǝ hu ɗa zamǝ nyi kǝ ndzǝ gagaɗau, kǝ ji nggǝl ara vu ki. Kǝ dǝrnda biya ji biya sǝsǝkuya nyi kǝr aga ja vu ki. <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>Ama kǝ ji shaɗǝwa nyi anǝ dǝnyi ji na, ‘Lari gǝyi, wu patǝr faˈyar kau, ya vǝr mǝl thlǝr ǝnggǝr mafa, nayi saya nggǝl ara mǝl sǝra gǝ na mai, alaga abangau, nagǝ saya mbari alaga zǝr ku aga ya ngga bazhir ˈwa ɗaˈyar aga ˈya tsǝya ˈya sǝm mai! <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>Ama ǝnggǝra zǝr ngǝ kǝ sha shili, ndǝra maˈyi ka nda tsǝya gǝnna ngau wu sǝsukur, kǝ gǝ dzǝgwa tsǝya nyi thla ta kǝra ndiya ǝnga nggǝnggǝthlau.’ <verse eid="LUK 15:30"/><verse number="31" style="v" sid="LUK 15:31"/>Kǝ dǝnyi na anǝ nyi, ‘Zǝr ɗa, alaga nuwa nga gǝ ǝnga yau, patǝr sǝra ara yau, nǝ ngǝ ngau. <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>A ɗar tsaˈa mǝna caguli ǝnga huɗǝ pipida, ara zamǝ ngǝ kǝ a tǝri, kǝ ji ɓǝra sha shili ǝnga pi, ndǝ sasa nga ja, ama kabangǝkǝ a nǝr nyir nji.’ ”<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">Karapau Ar Kǝra Ndǝr Dlǝwa Dzǝ <optbreak/> Kǝra Gǝra Ənga Jirkur</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>Yesu na anǝ zǝmbǝlma nyiˈyar, “Nji sayi mǝliya vanyi ndǝr bǝrba kǝra nǝ nyi kari nyi anǝ ndǝr dlǝwa nyi aga ja tsamǝ anǝ nyi. Wu yukuɗa nyi, kǝ nji shili ǝnga ɗahǝu anǝ nyi ǝnggǝra ndǝr dlǝwa nyi a vǝr ndza kari nyi. <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>Kǝ thlagǝri ki kǝ ngga ndǝr dlǝwa nyi, ji na anǝ nyi, ‘Mi nga ya vǝr nggari ar kǝra gǝ ka? Shili ga nar ɗa ar kǝra sǝra gǝ mǝlna, ara tsu gu nda nggya ndǝr dlǝwa ɗa mai.’ <verse eid="LUK 16:2"/><verse number="3" style="v" sid="LUK 16:3"/>Kǝ ndǝr dlǝwa nyi kǝ na wu ɗǝfuwa ja, ‘Thlagǝri ki ɗa wu nda kǝdlǝ na ɗa wu thlǝr, mi ya dzǝgwa mǝla? Kǝja na ya sǝni zǝwa mai, sǝli tsu wu tǝ ɗa ara kǝdiyau. <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>Ənghǝng! A sǝni yi sǝra ya mǝl, aga nja nda dlǝwuri ɗa a vu kir nda, ma ji kǝdlǝ na ɗa wu thlǝr ɗa.’<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>“Kǝ ji ngga patǝr njira thlagǝri ki nyi a vǝr nu nda mǝl. Ji yiwa ndǝ tanggǝrma ji na, ‘Yiɗau ngǝ thlagǝri ki ɗa a vǝr nu nga?’ <verse eid="LUK 16:5"/><verse number="6" style="v" sid="LUK 16:6"/>Ji na, ‘Tǝm nǝr mal gharu.’</para>
  <para style="p" vid="LUK 16:6">“Kǝ ndǝr dlǝwa nyi kǝ na, ‘Hǝri lǝkakaɗǝ ngau, ǝnga kusa, ga tsǝfǝri tǝm tǝfu kumunyi.’ <verse eid="LUK 16:6"/><verse number="7" style="v" sid="LUK 16:7"/>Kǝ ji nar nyi anǝ vanyi ndau, ‘Kari nagǝ tsu, yiɗau nga nju nu nga?’ Naja tsu kǝ ji na, ‘Kayiwa uhi gharu ngau.’ Ndǝr dlǝwa nyi kǝ na, ‘Hǝri lǝkakaɗǝ ngau, ga mǝliya ja ɗa buhu cisu kumunyi.’<verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>“Kǝ thlagǝri ki ndǝr dlǝwa kǝra gǝra jirkur kǝ faliya nyi ara ji cabiya tsǝtsǝlkur. Arya njir najaka pǝci, a sǝni mǝl thlǝr ǝnga tsǝtsǝlkur nda a ndiya njir lagu mbǝmbǝl.”<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>Yesu dumwa ji na, “Ya vǝr na anǝ hyi, hya mǝl thlǝr ǝnga gǝnnar hyi aga hya uya bazhi anǝ kǝrhyi. Lagu kǝ ngǝ ma thlǝr gǝnnar hyi a taˈyi ri, nju sa dlǝwuri hyi a vu ki nǝ kǝra gǝra kuɗau. <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>Ma ndǝra nju sǝn fiyafǝ ǝnga ja wu sǝ kushu, nju sǝn fiyafǝ ǝnga ja wu sǝ dǝgal tsu. Ma ndǝ kǝra nji gǝra sǝn fiyafǝ ǝnga ja wu sǝ kushu, nju sǝn fiyafǝ ǝnga ja wu sǝ dǝgal tsu mai. <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>Ma nahyi aˈyi mǝl thlǝr kǝra tsaˈa miya ɗǝfu ǝnga gǝnna nǝ duniya mai, wa ngǝ nda fǝr kǝr ǝnga hyi ja nǝ hyi gǝnna nǝ jirkura? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>Ma tsu nahyi aˈyi mǝl thlǝr tsaˈa miya ɗǝfu ǝnga gǝnna ndǝ mai, wa nga nda nǝ hyi nǝr hya gǝnna?”<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>“Ndǝr sǝn mafakur anǝ thlagǝr ki pamǝpamǝ mǝthlǝ aˈyi mai, ara ju nda yiwu vanyi ba ja piyari vanyi ǝnga ju nda hǝya kǝr anǝ vanyi ba ja diɗana vanyi. Nahya sǝn daɓǝri nu Hyal ǝnga gal gǝnna mai.”<verse eid="LUK 16:13"/></para>
  <para style="s1">Alenyi Highiɓǝ Nǝ Musa</para>
  <para style="r">(<ref loc="MAT 11:12-13">Matiwu 11:12-13</ref>; <ref loc="MAT 5:31-32">5:31-32</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>Njir Farisi njir yiwu gǝnna ngau, ǝnggǝra ndǝ nggari sǝra Yesu na ba ndǝ tsǝrauna nyi. <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>Ama kǝ Yesu na anǝ nda, “Nahyi ngǝ njir yiwu hya canǝ nyi anǝ nji abǝr nji cici nga hyi. Ama Hyal ju sǝni ɗǝfuwa hyi. Sǝra nju lǝ dǝgalkur anǝ nda, nanda ngǝ didiɗi wu mwar Hyal.”<verse eid="LUK 16:15"/></para>
  <para style="s1">Cakau Ar Kǝra Highiɓau</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>“Kǝl ta Yahwana ndǝr mǝl Baɓǝtizǝma shili, highiɓǝ nǝ dlaɗǝ nǝ lagu Musa ǝnga nǝ nabiˈyar ca ngǝ ǝnga nju mǝl thlǝr ǝni. Ama dzǝguya ǝnga Yahwana ndǝr mǝl Baɓǝtizǝma, ǝnggǝra nji tǝtǝlna ndǝshigu mǝsahǝu nǝ tǝlkur Hyal, kalar ndau a vǝr gal lagu aga ja ɗa a gwa. <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>Dǝmǝlmau ǝnga gyuˈyi a sǝni sanakǝr, a ndiya sǝ ǝnggǝr camwaɗi wu ndǝr zǝmǝ sara wu dlaɗǝ nǝ lagu Musa a tǝɗau a gyuˈyi. <verse eid="LUK 16:17"/><verse number="18" style="v" sid="LUK 16:18"/>Ndǝra kǝdlǝna mala nyi, kǝ ji hǝr vanyi mala, ndǝr dlǝnga mala ngau. Ənga tsu sal kǝra hǝri mala kǝra sal nyi kǝdlǝna ndǝr dlǝnga mala nga ja.”<verse eid="LUK 16:18"/></para>
  <para style="s1">Ndǝr Gǝnna Ənga Liyazaru</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>“Vanyi ndǝr gǝnna aˈyi kǝra wu ha kari nǝ gǝnna gangǝu pamǝpamǝu, ǝnga ju sǝm sǝr sǝm mǝsahǝu kalar pǝci. <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>A biya miya ki nyi, vanyi ndǝr kǝdi aˈyi kǝra nja ngga ǝnga Liyazaru, ǝnga dza ja patǝ ǝnga mbǝlgǝu. Nju shili ǝnga ja, nja sa pina nyi ǝna kalar pǝci. <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>Naja tsu ǝnga huɗǝ pipida ma ji sǝni uya alaga sǝra tǝɗau sara dar vir sǝm sǝr sǝm nǝ ndǝr gǝnna kau, patǝ ǝkkǝˈyi hya wu sa naɗǝ mbǝlgǝ nyi kau.”<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>“Pǝci shili ba ndǝr kǝdi kǝ tau, kǝ waladiˈyar hǝri nyi ka nda fiya nyi ar vir nggya mǝnahǝu ǝnga Ibrahimu. Ətsu ba ndǝr gǝnna kǝ tau ba nji haɗǝna nyi. <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>Ji thlǝwa kǝrnyi wu uˈur kǝtsa, ja vǝr sa ɓwaɓwatǝu. Ənggǝra ji hyaˈanakǝr a dǝmǝlmau, kǝ ji lari Ibrahimu naɗǝ nanda ǝnga Liyazaru. <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>Kǝ ji ngga nyi, ji na, ‘Tada Ibrahimu, tǝhuɗǝ ǝgya yau, ga sǝwa Liyazaru aga ja fuwa zǝr tsa ja a gwu ˈyimi aga ja fǝri ar kyara yau ya nggari shishiˈwu, arya ya vir lari ɓwaɓwatǝ wu uˈu kau!’<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>“Ama kǝ Ibrahimu na, ‘Zǝr ɗa, ga ɗǝngari ja, pǝci kǝra gu duniya, nagǝ ǝnga sǝ mǝnahǝu papatǝu, ama Liyazaru nǝ nyi a lari ja ɓwaɓwatǝu. Ama kabangǝkǝ pǝcir nggari mǝsahǝkur nyi ngau, ama nagau wu ɓwaɓwatǝ nga ngau. <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>Kǝ ma mai, wu pama ˈya ǝkkǝˈyi hyi kaˈu dǝgal ǝnga dzǝgamǝ aˈyi, kǝra nji mǝliya ara nja sara vǝlna sara ndara hyi a shili ngau, alaga sara ngau a ndara hyi.’ <verse eid="LUK 16:26"/><verse number="27" style="v" sid="LUK 16:27"/>Kǝ ndǝr gǝnna kǝ na, ‘Tada, ma abangǝ ja, yu kǝdi ngau, sǝwa nyi a ndu ki dǝɗa, <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>arya zamǝɗaˈyar aˈyi tǝfu, ja maˈyi ja nda kughiya nda, a sara nda ɓǝra shili ngǝ ǝtsu, a shili wu ɓwaɓwatǝu.’<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>“Ibrahimu shaɗǝwa nyi, ‘Zamǝ ngǝˈyar aˈyi nda ǝnga highiɓǝ nǝ Musa ǝnga tsǝfǝ nǝ nabiˈyar, nda sǝ himi sǝra ndu na.’ <verse eid="LUK 16:29"/><verse number="30" style="v" sid="LUK 16:30"/>Kǝ ndǝr gǝnna shaɗǝwa nyi, ji na, ‘Awau, tada Ibrahimu, ma ndǝ hyaˈari sara vir tau ji sha ndara nda, ndu tubi.’ <verse eid="LUK 16:30"/><verse number="31" style="v" sid="LUK 16:31"/>Ama kǝ Ibrahimu na, ‘Ma tsu nanda aˈyi nggari highiɓǝ Musa ǝnga tsǝfǝ nabiˈyar kǝ mai, alaga vanyi ndǝ hyaˈari sara vir tau, nanda sa sǝ himi anǝ nyi mai.’ ”<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">Bikau, Mbǝrsa <optbreak/> Daɓǝ Ənga Thlǝr</para>
  <para style="r">(<ref loc="MAT 18:6-7">Matiwu 18:6-7</ref>,<ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">Markusu 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>Yesu na anǝ zǝmbǝlma nyiˈyar, “Sǝra wu daɓaga mǝliya nji nda mǝliya bikau aˈyi cumu. Ama sǝr tǝhuɗǝ anǝ ndǝra ju shili lagu nyi. <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>Kuji anǝ nyi, nja mbiya bǝra ar fǝlanga ja, ba nja vakuwa nyi a gwar dǝl dǝgal a ndiya ja mǝliya zǝmǝ wu wazha yiɗiɗǝˈyar kǝ njir nu ɗa mǝliya bikau. <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>Hya tsamǝ sǝra hya mǝl ja.</para>
  <para style="p" vid="LUK 17:3">“Ma zamǝ ngau mǝliya ngǝ bikau, ga kughiya nyi, ma ji na a tubir yau, tǝfǝbiya nyi. <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>Ma ji mǝliya ngǝ bikau pamǝpamǝ mǝɗǝfǝ wu pǝkǝ pathlǝu, kǝ ji ɓǝra sha shili ja vǝr na, ‘A mǝliya ngǝ ri yi bikau yafa ɗa,’ ba ga tǝfǝbiya nyi.”<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>Kǝ cama sǝsǝˈyar kǝ na anǝ Thlagǝu, “Cakǝri mbǝrsar ˈya ja ɗa ǝnga dǝnama!”<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>Kǝ Thlagǝ shaɗǝwa nda, ji na, “Ma mbǝrsa hyi aˈyi ǝnggǝr culi bǝla, gu sǝni na anǝ wu dǝgal kau, ‘Kucina kǝr ǝnggau ga ciya kǝr a gu tsadau,’ ju nda mǝl sǝra gǝ na.”<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>“Ma mafa ngǝ si sara a gwar vi zǝwa ǝnga sara vir ɓǝla, gu nda na anǝ nyi, ‘Usi ǝnga si! A ndau ga nggya, ga sǝm sǝr sǝm ya?’ <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>Awau, ngu nda na anǝ nyi, ‘Mǝliya ɗa sǝr sǝm nǝ wagǝu kwatahǝu, ga dzǝgwa tsǝrpǝri kǝrngau ba ga hǝri ɗa a shili ya sǝm ya sa, kadivira ga dzǝgwa sǝm ga sa nǝ ngau’ <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>Gu nda na usi anǝ mafa ngau ara ji mǝliya sǝra tsaˈa ja mǝl ya? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>Abangǝ nga hyi tsu, ma hya mǝliya ri sǝra thlagǝr kir hyi nar hyi hya mǝl, hyu nda na, ‘Naˈya mafa ngǝ wacu. A mǝliya ri ˈya sǝra nju yiwu ˈya mǝl.’ ”<verse eid="LUK 17:10"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Njir Pibi Kumou</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>Ənggǝra Yesu mbari lagu ja vǝr maˈyi a vu Urshalima, ndǝ dzǝgwa ɓau wu kǝl kǝra wu pama Samariya ǝnga Galili. <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>Ənggǝra ja vǝr vu mǝlmau, kǝ njir pibi kumo thlǝwa nyi. Ndǝ taˈyi tuwara tsalǝu, <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>ndǝ dzǝgwa ngga ǝnga ɗahǝu dǝgalǝu, “Yesu ndǝ dǝgalǝu! Ga tǝhuɗǝ ǝgya ˈya!”<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>Ənggǝra Yesu lari nda, kǝ ji na anǝ nda, “Ma ˈya mau hya nda canǝ nyi kǝrhyi anǝ pubu.” Kǝ ndǝ maˈyi, ar lagu ba ndǝ ɗa jamǝu.<verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>Pathlǝ wu pama nda, lari abǝr a ɗar ja jamǝu, kǝ ji sha shili, ja vǝr fal Hyal ǝnga ɗahǝu dǝnama gagaɗau. <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>Ji ɓǝliya undi a dumwar Yesu, ja vǝr usa nyi. Naja tsu ndǝr Samariya ngau ndǝra nji diɗana. <verse eid="LUK 17:16"/><verse number="17" style="v" sid="LUK 17:17"/>Kǝ Yesu yiwa, “Aˈyi nji kumo nga nji mǝliya jamǝ wa? Əmani ngǝ alenyi nji ǝdlǝ ka? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>Mi ngǝ ɗa kǝl mǝthlǝpi kǝ ngǝ sha shili ja sa cabiya usaku nyi anǝ Hyala?” <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>Yesu dzǝgwa na anǝ nyi, “Hyaˈari ga maˈyi sǝ ngau, mbǝrsa ngau a mǝliya ngǝr jamǝu.”<verse eid="LUK 17:19"/></para>
  <para style="s1">Shilǝr Tǝlkur Hyal</para>
  <para style="r">(<ref loc="MAT 24:23-28">Matiwu 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>Alenyi njir Farisi yiwa Yesu pǝci kǝra tǝlkur Hyal wu nda shili, kǝ ji na anǝ nda, “Shiliri tǝlkur Hyal aˈyi ǝnga li ǝnga nju nda tsamiya mai, <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>ndǝr nda na tsu, ‘Kǝja ja,’ ǝnga ‘Wa ta ja,’ aˈyi mai, arya tǝlkur Hyal wu pama hyi nga ja.”<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>Kǝ Yesu dzǝgwa na anǝ zǝmbǝlma nyiˈyar, “Pǝci a vǝr shili kǝra gu nda yiwu ga lari zǝma pǝci nǝ Zǝr Ndau, ama na ga nda lari mai. <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>Nju nda na anǝ hyi, ‘Wa ta ja a ndǝna,’ ǝnga tsu ‘Kǝja ja ǝnggau.’ Ama hya sara maˈyi hya nda tsamǝ nyi mai. <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>Ənggǝr sǝm nǝ par kǝra wu cabiya mbǝl nyi ar kuɗiyar mǝlmǝ baˈanǝ vanyi kuɗiyar mǝlmǝ kǝra kalar ndau wu lari, abangǝ shiliri Zǝr Ndau wu nda ɗa. <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>Ama tanggǝrma kǝl ji lari ɓwaɓwatǝ gagaɗau kwatahǝu ǝnga tsu nji kabangǝkǝ nda piyari nyi. <verse eid="LUK 17:25"/><verse number="26" style="v" sid="LUK 17:26"/>Ənggǝra ji ɗa ar pǝcir Nǝhu, abangǝ nga nyi wu nda ɗa ar pǝcir shilǝr Zǝr Ndau. <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>Nji nggya kǝl sǝm sǝr sǝm ǝnga sa sǝ sasa, ndu faˈa mathlǝkǝˈyi ǝnga ndu lǝ kuˈyi anǝ shili, baˈanǝ shili ar pǝci kǝra Nǝhu gwu kwambwal dǝgal ta ari. Kǝl ta dǝl shida ba ji kuɗǝna nji patǝu.<verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>“Abangǝ nga nyi ɗa tsu ar pǝcir Lotu. Nji kǝl sǝm, ǝnga sa, ndu ɗǝl ǝnga ɗǝlna, alenyi nji kǝl thlǝka sǝ pamǝpamǝ ǝnga hǝr ki. <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>Ama pǝci kǝra Lotu piyari Sodomu, kǝ uˈu ǝnga hakil uˈu shida sara dǝmǝlmau ba ji dlǝna nda patǝu.<verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>“Tangǝ ǝnggǝr ta nga nyi wu nda ɗa ar pǝcir shilǝr Zǝr Ndau. <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/>Ar pǝci ta, ndǝra a dar kǝra umbwa, ja sara gya ja vu ki aga vuwa hǝ sǝ mai, ara ja sara sana pǝci.” “Ndǝra a gwa tagǝ tsu, ja sara sha a su ki aga sa hǝ kar ha nyi mai. <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>Hya ɗǝngari sǝra ɗa ǝnga mala Lotu! <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>Kalar ndǝra wu yiwu piya ja, ju nda tini. Ndǝra gǝra yiwu piya ja arya yau, ju nda uya. <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>Yu nar hyi ja, pǝci kǝra sǝ kǝ wu nda ɗa, nji mǝthlǝ a vǝr pida ar sǝr pida zǝmǝ ba nja hǝri zǝmǝ ba nja piyari vanyi. <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>Mathlǝkǝˈyi mǝthlǝ a vǝr au ar ɓǝra, ba nja hǝri zǝmǝ ba nja piyari vanyi.”<note caller="+" style="f"><char style="fr" closed="false">17:35 </char><char style="ft" closed="false">Alenyi tsǝfǝ nǝ ɗǝɗǝmǝ cabiya abǝr kǝja sǝra vir jiga </char><char style="fv">36</char>na: <char style="fqa" closed="false">“Shili mǝthlǝu a gwa tagǝu, ba nja hǝri zǝmǝ ba nja piyari vanyi.”</char></note> <verse eid="LUK 17:35"/><verse number="37" style="v" sid="LUK 17:37"/>Kǝ zǝmbǝlma nyiˈyar yiwa nyi, ndǝ na, “Thlagǝu, ǝman na?” Kǝ ji shaɗǝwa nda, ji na, “Ma vi kǝra sǝ tǝtǝ ari ǝna ngǝ kwadǝgǝu wu daɓau.”<note caller="+" style="f"><char style="fr" closed="false">17:37 </char><char style="ft" closed="false">Najaka ndǝr ngǝ cabiya shili nǝ Yesu. </char></note><verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">Karapau Ar Kǝra Ndǝr Pathla <optbreak/> Ənga Malatǝsal</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>Yesu nar nyi najaka karapǝ anǝ zǝmbǝlma nyiˈyar aga ja highiɓǝri nda aga nda dumwa ǝnga ndǝr anǝ Hyal parangǝ, a sara nda hǝɗa mai. <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>Ji na, “Wu vanyi mǝlmǝ vanyi ndǝr pathla aˈyi kǝra gǝra hivǝr Hyal ǝnga kǝra gǝra tal nji. <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>Wu mǝlmǝ kǝ vanyi malatǝsal aˈyi kǝra a vǝr shili parangǝ ǝgya ndǝr pathla ja vǝr kǝdi nyi ju na, ‘Dlǝwari ɗa ga nǝ ɗa sǝra tsaˈa aga nǝ ɗa a dumwar dawa ɗa.’ <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>Tanggǝrma ba ji nggǝl, ama wu yukuɗǝ kǝ ji na wu ɗǝfuwa ja, ‘Alaga kǝ aˈyi yu hivǝr Hyal mai, nayi tsu wu tal nji mai, <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>ama ara ǝnggǝra mala kǝ ɓwanǝ ɗa kǝr ǝnga shili ar kǝr ar kǝr, yu nǝ nyi sǝra ju yiwu kau, a sara gangǝkura shili nyi kǝ a nda nǝ ɗa hǝɗa!’ ”<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>Kǝ Thlagǝ na, “Nggara mǝ ja sǝra ndǝr pathla kǝra gǝra jirkur kǝ na! <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>Kǝ hyi nggani, Hyal a yiwu nda nǝ nyi sǝra tsaˈa anǝ nji nyi kǝra ji ɗǝmbiya kǝra wu tiwi anǝ nyi vuˈyi ǝnga puci sǝra ndu kǝdi wa? Naja ˈyi wu nda dlǝwari nda ǝnga kusa wa? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>Yu na anǝ hyi, ju nda nǝ nda sǝ tsaˈa kǝra ndu kǝdi kukusa. Ama ma Zǝr Ndau wu nda sha shili, wu sa thlǝwa ja njir mbǝrsa wu duniya kǝ ya?”<verse eid="LUK 18:8"/></para>
  <para style="s1">Karapau Ar Kǝra Ndǝr Farisi <optbreak/> Ənga Ndǝr Tsǝm Budau</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>Yesu na najaka karapǝ anǝ njira hǝri Kǝrnda abǝr nji tsapǝu nga nda, nda dzǝgwa diɗana alenyi nji. <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>Ji na, “Nji sayi mǝliya nji mǝthlǝ kǝra maˈyi a gwu ki Hyal aga nda gwa ndǝr ǝnga Hyal. Pathlǝ wu pama nda ndǝr Farisi, ǝnga vanyi ndǝ kǝ ndǝr tsǝm budau.<verse eid="LUK 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 18:11"/>“Kǝ ndǝr Farisi hyaˈari ji taˈyau, ji dzǝguya ndǝr anǝ Hyal ja vǝr na, ‘Hyal, a usa ngǝ ri yau ara nayau aˈyi ǝnggǝr alenyi nji mai, njir hǝl, njir dlǝrbau, nji sǝsu. Nayi tsu aˈyi ǝnggǝr ndǝr dlǝwu budǝ kǝ mai. <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>Yu hǝ zǝmǝtsini mǝthlǝ wu sugu, yu hǝbiya pathlǝu wu sǝ kumo patǝ kǝra yi uya.’<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>“Ama kǝ ndǝr dlǝwu budǝ kǝ taˈyu naɗǝu, naja aˈyi ɗa tsaˈa ja hyaˈana liya ja a dǝmǝlmǝ mai, kǝ ji cabiya tǝtǝwakur nyi, ja vǝr na, ‘Hyal, tǝhuɗǝ ǝgya yau, nayi ndǝr bikau!’ ” <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>Yesu na, “Yi wu na nǝ hyi, ndǝr tsǝm budau, ji sha a ndu ki nyi gǝra bikau wu mwar Hyal, aˈyi ǝnggǝr ndǝr Farisi mai. Arya kalar ndǝra hǝri kǝrnyi, nju nda hǝya nyi. Ama ndǝra hǝya kǝrnyi, nju nda hyaˈana nyi.”<verse eid="LUK 18:14"/></para>
  <para style="s1">Yesu Fǝr Nyi Barka Anǝ Wazha</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matiwu 19:13-15</ref>; <ref loc="MRK 10:13-16">Markusu 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>Alenyi nji shili ǝnga wazha aga Yesu a fǝnggǝr nda barka. Ənggǝra zǝmbǝlma nyiˈyar lari abangau, ba ndǝ tsa ar kǝra nda. <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>Ama kǝ Yesu ngga wazha, ji na, “Piyara mau wazha yiɗǝɗǝ nda shili ǝgya yau. Hya sara ka nda mai. Arya, tǝlkur Hyal anǝ nji ǝnggǝr nanda nga nyi. <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>Ənga jiri yu na anǝ hyi, kǝmir ndǝra gǝra dlǝwuri tǝlkur Hyal ǝnggǝra zǝr kushu wu dlǝwu, naji wu sǝn vwagwa mai.”<verse eid="LUK 18:17"/></para>
  <para style="s1">Ndǝ Bǝrba Kǝra Wu Tǝɗǝmwa</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>Vanyi ndǝr tǝɗǝmwa nǝ Yahudiya yiwa Yesu ji na, “Malǝmǝ, ndǝ mǝnahǝu, mi nga ya mǝl ya uya pi gǝra kuɗa?”<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>Kǝ Yesu na anǝ nyi, “Ara mi gu ngga ɗa ndǝ mǝnaha? Ndǝ mǝnahǝ aˈyi mai kǝl Hyal wacu. <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>A sǝni gau sǝra dlaɗau cabiya, ‘Ga sara tsa ndǝ mai. Ga sara mǝl sǝsukur mai. Ga sara hǝl mai. Ga sara thla fati ar kǝra ndǝ mai. Ga sara dlǝrbǝ ndǝ mai. Ga gǝnggǝr nyi sǝli anǝ dǝngǝ ǝnga mǝngau.’ ”<verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>Kǝ zǝr baduwari ta na anǝ nyi, “A ɓǝlar yi sǝˈyar kǝ patǝ tsu yi zǝr kushu. Mi ngǝ sǝra hya?”<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>Yesu nar nyi, “Sǝ zǝm wacu ngǝ hyau anǝ ngau, ma gu yiwu ga ɗa ndǝ tsapǝu, ga maˈyi ga nda ɗǝlna patǝr sǝra ara gau, ba ga tǝkǝna gǝnna nyi anǝ nji ɗaɗali, gu uya akkǝri a dǝmǝlmau. Ba ga dzǝgwa shili aga ga sa nu ɗa.” <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>Ənggǝra ji nggari abangau kǝ zǝr baduwari kǝ ndalǝr bama, kǝ ji maˈyi ǝnga huɗǝ ndzǝndzau, ara naja ndǝr bǝrba gagaɗau.<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>Ənggǝra Yesu lari ɗǝfuwa ja a ndzǝ ri, kǝ ji na, “Wu nda ɗa dzadzau gagaɗau anǝ njir gǝnna nda gwu tǝlkur Hyal! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>Arya wu nda ɗa ɓatsǝ anǝ dlǝgwam ja tǝrabiya wu liya libǝra, a ndiya ndǝr gǝnna ja vu tǝlkur Hyal.”<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>Njira nggari ndǝr kǝ ndǝ yiwa nyi, ndǝ na, “Ma abangǝ nga nyi, wa ngu sǝn uya mbǝɗa?”<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>Yesu na, “Sǝra gǝra sǝn ɗa ngau, anǝ ndau, ama anǝ Hyal ɓatsu.”<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>Kǝ Biturusu shaɗǝwa, ji na, “Kǝja ˈya piyari sǝ patǝ ˈyi nu ngau.”<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>Yesu shaɗǝwa nyi, ji na, “Wu sǝn yau abangǝ, yu nar hyi jirkura nyi tsu, kalar ndǝra piyari ki ǝnga zamǝˈyar, ǝnga kwamǝˈyar, ǝnga tada ǝnga ama ba ǝkkǝˈyi wazha ǝnga fa arya tǝlkur Hyal <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ju nda uya gangǝu a adabanga sǝˈyar kǝ ji piyari ǝnggau wu duniya kau, wu duniya kǝra wu shili kǝ tsu pi kǝra kuɗau.”<verse eid="LUK 18:30"/></para>
  <para style="s1">Yesu Ɓǝra Ndǝr Ar Kǝra <optbreak/> Culi Tǝ Kǝra Ji Wu Nda Tau</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matiwu 20:17-19</ref>; <ref loc="MRK 10:32-34">Markusu 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>Kǝ Yesu hǝri zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝ a ndar batiti, ji na anǝ nda, “Kǝja, mǝn wu mai a vu Urshalima, vi kǝra sǝra nabiˈyar tsǝfǝri ar kǝra Zǝr Ndau wu nda nyabiya dzau. <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>Nju nda lǝri nyi anǝ njira aˈyi njir Yahudiya mai, aga nda diɗana nyi, nda nǝ nyi ɓwaɓwatǝu, nda dzǝgwa tǝfǝri nyi tuli. <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>Ndu nda dǝgǝ nyi ǝnga wuɗa, nda tsǝya nyi, ama pida makǝrkura nyi ba ja hyaˈari sara vir tau.”<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>Ama zǝmbǝlma nyiˈyar nggabiya sǝ kǝ Yesu na kǝ mai. Ɗǝɗǝwa ngǝ sǝra ndǝr kǝ cabiya anǝ nda, ca ngǝ ɗa nandǝ sǝni nggabiya mai.<verse eid="LUK 18:34"/></para>
  <para style="s1">Yesu Mbǝɗana Ndǝr Kǝdiyau <optbreak/> Kǝra Lǝfau</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matiwu 20:29-34</ref>; <ref loc="MRK 10:46-52">Markusu 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>Ənggǝra Yesu dla lǝhǝu wu dzǝri Yariko, kǝ ja ndǝ lǝfau a vǝr nggya ar thlǝr pa lagu, ja kǝdiyau. <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>Ənggǝra ji nggari nji gangǝu a vǝr tǝrabiya, kǝ ji yiwa sau ji na, “Mi nga vǝr ɗa?” <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>Kǝ ndǝ na anǝ nyi, abǝr, “Yesu ndǝr Nazǝratu nga vǝr tǝrabiya.”<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>Kǝ ji hyaˈana ɗahǝu ji na, “Yesu! Zǝr Dawuda!<note caller="+" style="f"><char style="fr" closed="false">18:38 </char><char style="ft" closed="false">Najakǝ ngǝ thlǝmǝ kǝra nji nǝ nyi anǝ Yesu ndǝr mbǝɗa nji. Aˈyi cabiya abǝr Dawuda ngǝ tada yaya nyi mai, ama sara wu culi nyi ǝnggǝra nabi ɗǝɗǝmˈyar nana. Tsamiya </char><char style="xt"><ref loc="LUK 1:32">Luk 1:32</ref>; <ref loc="LUK 4:31">4:31</ref></char>.</note> Tǝhuɗǝ ǝgya yau!”<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>Njira a dumwa ndǝ kughi anǝ nyi aga ja haɗiya miya ja. Ama kǝ ji ɓǝra hyaˈana ɗahǝu gagaɗau ja vǝr na, “Na gǝ, Zǝr Dawuda, tǝhuɗǝ ǝgya yau!”<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>Kǝ Yesu taˈyau, ji na, “Shila mau ǝnga ja ǝnggau.” Ənggǝra ji shili lǝhǝu, Yesu yiwa nyi, <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>“Mi nga gu yiwu ya mǝliya nga?” Kǝ lǝfǝ kǝ shaɗǝwa, ji na, “Thlagǝu, ya yiwu ya lari sau.”<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>Yesu na anǝ nyi, “Lari sau! Mbǝrsa ngau a pahǝnari liya gau.”<verse eid="LUK 18:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43"/>Aga zǝmǝ kǝ liya ja lari sau, kǝ ji nu Yesu, ja vǝr dlǝvǝ Hyal. Ənggǝra nji lari sǝ kǝ ɗa kau, kǝ ndǝ patǝ fal Hyal.<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">Yesu Ənga Zakka</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>Yesu vu Yariko, ja vǝr tǝrabiya wu hu ɗa mǝlma nyi, <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>kǝ ja vanyi ndǝ dǝgal nǝ njir tsǝm budau, kǝra nja ngga ǝnga Zakka. Naja tsu ndǝr gǝnna, <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>ji ɗa aga ja lari tara wa ngǝ Yesu, ama naji sǝni lari nyi mai ara naja ndǝ tashu, ǝnga tsu nji gangǝ gagaɗau. <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>Agabangǝ kǝ ji maˈyi a dumwa ǝnga hwi, kǝ ji thlǝwa wu bǝla kǝ ji dagwa, aga ja lari nyi, arya Yesu wu nda tǝrabiya lagu ta. <verse eid="LUK 19:4"/><verse number="5" style="v" sid="LUK 19:5"/>Ənggǝra Yesu thlǝwa vi ta, kǝ ji hyaˈanakǝr a dǝmǝlmau ji na, “Zakka, kusa ga shida! Əshina yu ɗa mǝthlǝpi wu ki ngau.” <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>Zakka gya ǝnga kusa, ji dlǝwuri nyi ǝnga huɗǝ pipida. <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>Ənggǝra nji lari abangau, kǝ ndǝ mbari ngwungwuni, nda vǝr na, “Kǝja! Wu ki ndǝr bikǝ nga ji ɗa mǝthlǝpi.”<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>Kǝ Zakka hyaˈari aˈyi taˈyau, ji na anǝ Thlagǝu, “Nggari, ndǝ dǝgal, yu tǝkǝya sǝra ara yau bwata mǝthlǝu, ba ya tǝkǝna pathla nyi anǝ nji tǝtǝ dǝnama. Patǝkura njira nyi dlǝrbǝri, yu nda shabiya nda sǝr nda aga foɗǝu.”<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>Kǝ Yesu na anǝ nyi, “Əshina ma, mbǝɗau a shiliri wu ki kau, naja ma culi Ibrahimu ngau. <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>Arya Zǝr Ndau ji shili aga sa gal nji sasa, ǝnga ja sa canǝ nda lagur mbǝɗau.”<verse eid="LUK 19:10"/></para>
  <para style="s1">Karapau Nǝ Pam Kumou</para>
  <para style="r">(<ref loc="MAT 25:14-30">Matiwu 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>Tsu nda vǝr sǝ himi sǝˈyar kau, kǝ Yesu dumwa ǝnga na vanyi karapǝ anǝ nda, ara a ɗar lǝhǝu wu dzǝri Urshalima, ǝnga nja vǝr ɗǝnga abǝr tǝlkur Hyal wu cabiya dzǝ aga zǝmǝu. <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>Kǝ ji na anǝ nda, “Nji sayi mǝliya vanyi ndǝ dǝgal kǝra maˈyi a ndu vanyi mǝlmǝ naɗǝ aga nja fiya nyi tǝl ja dzǝgwa sha shili. <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>Kadivira ja mai, ji ngga kumo wu pama mafa nyiˈyar, ji nǝ nda pam papathlǝ ji dzǝgwa na anǝ nda, ‘Shafǝli mau ǝni kǝl yi sha shili.’ <verse eid="LUK 19:13"/><verse number="14" style="v" sid="LUK 19:14"/>Njir mǝlmǝ nyi wu yiwu nyi mai. Agabangau, kǝ ndǝ sǝwa cama ayukuɗa ji mai a ndu mǝlmǝ ta abǝr, ‘Naˈyu yiwu ndǝ kǝ ja ɗa tǝl ar kǝra ˈya mai.’<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>“Kǝ nji fiya ndǝ kǝ tǝl, ji dzǝgwa sha shili wu ki. Ənggǝra ji shili kǝ ji sǝwa nja nggari nyi mafa nyiˈyar ta, aga ja sǝni nubwa kǝra ndǝ uya ar kǝra sǝra ji nǝ nda. <verse eid="LUK 19:15"/><verse number="16" style="v" sid="LUK 19:16"/>Ndǝ tanggǝrma shili ji na, ‘Thlagǝu, a uyari yau nubwa pam kumo a dar kǝra pam pathlǝu ta gǝ nǝ ɗa ta.’ <verse eid="LUK 19:16"/><verse number="17" style="v" sid="LUK 19:17"/>Kǝ thlagǝri ki kǝ na anǝ nyi, ‘Usi mafa tsapǝu ndǝr mǝl thlǝr tsaˈa miya ɗǝfu! Gǝ mǝl thlǝr ngau, tsaˈa miya ɗǝfu ǝnga sǝ kushu kǝra nji nǝ ngau, yu mǝliya ga sǝm tǝlkur ar kǝra mǝlmǝ pamǝpamǝ kumou.’ <verse eid="LUK 19:17"/><verse number="18" style="v" sid="LUK 19:18"/>Mafa nǝ mǝthlǝkura nyi shili ji na, ‘Thlagǝu, a uyari yau nubwa pamǝ tǝfu a dar kǝra pamǝ zǝmǝ ta gǝ nǝ ɗa ta.’ <verse eid="LUK 19:18"/><verse number="19" style="v" sid="LUK 19:19"/>Thlagǝr ki nyi shaɗǝwa anǝ ndǝ kau, ‘Gǝ wu sǝm tǝlkur ar kǝra mǝlmǝ pamǝpamǝ tǝfu.’<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>“Kǝ vanyi mafa shili ji na, ‘Thlagǝu, kǝ ja pamǝ zǝmǝ ngau. Yi pǝɗiya wu kukuzhal, yi ɗǝwana. <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>Ara yu hivǝr ngau, arya na gǝ ndǝ dzadzau ngau. Kǝja ga fa sǝra kǝra nǝ gau, gu gǝm tsu sǝra gǝ kǝra thlǝka na.’ <verse eid="LUK 19:21"/><verse number="22" style="v" sid="LUK 19:22"/>Kǝ ji na anǝ nyi, ‘Nagǝ mafa ɗǝmwaˈyi hangǝkal, yu mǝliya ngǝ numa ǝnga sǝra biya sara wu miya gau! Əngwar gau nayi ndǝra nji kǝra sǝni hangǝkal nyi, ndǝr fa sǝ nji kurthlǝu ǝnga yiwu gǝm ar vi kǝra yi kǝra thlǝka na. <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>Tsaˈa nga nyi, ama mi ngǝ ɗa nagǝ fiya gǝnna ɗa ar vi fǝ gǝnna maya, aga maˈyi shili ya uya akkǝri ar kǝri mai ya?’<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>“Kǝ ji na anǝ nji ta taˈyi ǝkkǝˈyi ja, ‘Dlǝwura mau gǝnna dubu pathlǝu kǝra ara ja kau, ba hya nǝ nyi anǝ ndǝra ǝnga dubu kumou.’ <verse eid="LUK 19:24"/><verse number="25" style="v" sid="LUK 19:25"/>Ama kǝ ndǝ shaɗǝwa nyi, ndǝ na, ‘Thlagǝu, pamǝ kumo nga ara ja.’ <verse eid="LUK 19:25"/><verse number="26" style="v" sid="LUK 19:26"/>Ji shaɗǝwa, ji na, ‘Yi wu nar hyi, ndǝra aˈyi ǝnga sau nju nda cakǝri nyi. Ndǝra kǝra aˈyi ǝnga sau, alaga sǝ kushu kǝra aˈyi ara ja nju nda dlǝwuri. <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>Njira dawa ɗa kau, nji kǝra gǝra yiwu ya ɗa tǝl ar kǝra nda kau, faˈari nda mau a shili nja tsǝya nda wu mwa ɗa.’ ”<verse eid="LUK 19:27"/></para>
  <para style="s1">Yesu Vu Urshalima</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matiwu 21:1-11</ref>; <ref loc="MRK 11:1-11">Markusu 11:1-11</ref>; <ref loc="JHN 12:12-19">Yahwana 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>Ənggǝra ji nana abangau, kǝ ji dumwa a vu Urshalima. <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>Ənggǝra Yesu ǝnga zǝmbǝlma nyiˈyar vu mǝlmǝ Bethfaji ǝnga Bethlani, mǝlmǝ kǝra lǝhǝu wu dzǝr Urshalima, kǝra a dar kǝra mǝ zaitunu. Kǝ Yesu sǝwa zǝmbǝlma nyiˈyar mǝthlǝu, <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>Ji na anǝ nda, “Maˈya mau a vu zǝr mǝlmǝ kǝ a ndumwar hyi kau, ǝnggǝra hyi vwau, hyu vuwa thlǝwa zǝr kwara mbamba ar sǝˈyi, kǝra nji gǝra saya dari, hya pǝlna nyi hya hǝr ɗa a shili. <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>Ma nji yiwa hyi, ‘Mi ngǝ ɗa hyu mǝl abanga?’ Kǝl ba hya na, ‘Thlagǝ ngu yiwu ja mǝl thlǝr ǝni.’ ”<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>Njira nji sǝwa, ndǝ maˈyi, kǝ ndǝ thlǝwa kalar sau ǝnggǝra Yesu nar nda ta. <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>Nda vǝr pǝl nyi ja, kǝ thlagǝri kwara nyi na anǝ nda, “Aga mi nga hyu pǝl nya?”<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>Kǝ ndǝ na, “Thlagǝ ngu yiwu ja mǝl thlǝr ǝni.” <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>Kǝ ndǝ hǝri nyi a shila nǝ Yesu. Ənggǝra ndǝ fǝr lǝgutǝr nda a dar kwara nyi, kǝ ndǝ dlǝwari Yesu ndǝ fǝri nyi a dar ya kwara nyi. <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>Ənggǝra ja vǝr ɓau, kǝ nji dzǝgwa sǝya lǝgutǝr nda a gyar lagu.<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>Ənggǝra ji shili lǝhǝu wu dzǝri Urshalima, mǝ tsa ga vi kǝra lagu sa gya ar dza gar nǝ wur Zaitunu, kǝ daɓǝr zǝmbǝlma nyiˈyar gangǝu daɓau nda vǝr usa Hyal, nda vǝr fal nyi tsu ǝnga ɗahǝu ǝnga dǝnama arya sǝ dǝdǝgur pamǝpamǝ kǝra ndǝ lari. <verse eid="LUK 19:37"/><verse number="38" style="v" sid="LUK 19:38"/>Nda vǝr na!</para>
  <para style="q1" vid="LUK 19:38">“Barka a nggyar anǝ tǝl</para>
  <para style="q2" vid="LUK 19:38">kǝra wu dla wu thlǝmǝr Thlagǝu!</para>
  <para style="q1" vid="LUK 19:38">Jamǝkur a nggyari a dǝmǝlmau,</para>
  <para style="q2" vid="LUK 19:38">ǝnga kadakadarkur anǝ Hyal!”<verse eid="LUK 19:38"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>Kǝ alenyi njir Farisi kǝra wu pama nda na anǝ nyi, “Malǝmǝ, ga kughi anǝ zǝmbǝlma ngǝˈyar nda nggya zǝmǝu!”<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>Ji shaɗǝwa nda, ji na, “Ya nar hyi,” “alaga ndǝ bǝgau, tsǝka ˈyar kǝ ǝnga kǝr nda ndu wau.”<verse eid="LUK 19:40"/></para>
  <para style="s1">Yesu Tiwi Arya Urshalima</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>Ənggǝra ji shili lǝhǝu gagaɗau, ji tsamiya vu Urshalima, kǝ ji tiwi anǝ nyi. <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>Ji na, “Kara nggǝrau, ma ja hyi nda sǝni sǝra wu nǝ hyi nggya jamǝu! Ama kǝ ja a ɗar ɗǝɗǝwa ara hyi. <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>Pǝci a vǝr shili kǝra dawar hyu nda zǝwar hyu masǝmǝ nda dzǝgwa pa ǝnga hyi. Sojar nda ngu nda zǝwar hyi. <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>Ndu nda hǝradlǝna ngau ǝnga nja dlǝna njira a gwa patǝu. Nandǝ wu nda piyari tsǝka zǝmǝ ar kǝra kuvwa nyi mai. Sǝˈyar kǝ wu nda ɗa ǝnga hyi ara nahyi aˈyi sǝnbiya abǝr Hyal shili aga mbǝɗa hyi mai.”<verse eid="LUK 19:44"/></para>
  <para style="s1">Yesu A Gwu Ki Hyal</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matiwu 21:12-17</ref>; <ref loc="MRK 11:15-19">Markusu 11:15-19</ref>; <ref loc="JHN 2:13-22">Yahwana 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>Kǝ Yesu vu ki Hyal ji vuwa kǝdlǝbiya njira vǝr ɗǝl ǝnga ɗǝlna sǝ a vuna patǝu, <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>ji na anǝ nda, “Tsǝtsǝfǝ nga nyi,</para>
  <para style="q1" vid="LUK 19:46">“ ‘Nju ngga ki ɗa</para>
  <para style="q2" vid="LUK 19:46">ǝnga vir kǝdi Hyal,’</para>
  <para style="q1" vid="LUK 19:46">ama kǝja hya shabiyari</para>
  <para style="q2" vid="LUK 19:46">ji ɗa vir ɗǝwa</para>
  <para style="q2" vid="LUK 19:46">njir ɗalagu.”<verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>Parangǝ ja vǝr highiɓau wu ki Hyal. Ama pubu dǝdǝgalˈyar, ǝnga malǝmǝ dlaɗǝˈyar, ǝnga nji dǝdǝgal nǝ mǝlmǝ ndu gal lagu kǝra nda daɓaga tsǝya nyi ari. <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>Ama nandǝ uya lagu kǝra nda sǝni tsǝya nyi mai, ara ndǝr nyi a uyari vi wu ɗǝfuwa nji, ǝnga nandǝ wu yiwu ndǝr zǝmǝ a tǝɗau a gyiwu ˈyi mai.<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">Yiwa Sau Ar Kǝra Dǝnama Nǝ Tǝlkur<optbreak/> Nǝ Yesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matiwu 21:23-27</ref>; <ref loc="MRK 11:27-33">Markusu 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>Vanyi pǝci Yesu gwu ki Hyal ja vǝr highiɓau, ja vǝr tǝtǝlna ndǝshigu mǝsahǝu anǝ nji, kǝ pubu dǝdǝgalˈyar, malǝmǝ dlaɗǝˈyar ǝnga njira nggurǝm shili ara ja. Ndǝ sa yiwa nyi, <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>“Ənga dǝnama wa nga gu mǝl sǝˈyar ka? Wa ngǝ nǝ ngǝ dǝnama nǝ mǝl sǝˈyar ka?”<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>Yesu shaɗǝwa nda, ji na, “Nayi ma yu yiwari hyi. Nar ɗa mau, <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>dǝnama kǝra Yahwana mǝl baɓǝtizǝma ǝni, Hyal ngǝ nǝ nyi ǝndǝga ndau?”<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>Kǝ ndǝ ndǝr wu pama nda, ndǝ na, “Ma mǝn na, ‘Sara ara Hyal nga nyi dla,’ ju nda na, ‘Mi ngǝ ɗa nahyi hǝnggǝri ǝnga ja mai ya?’ <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>Ma tsu mǝn na, ‘Sara ara nji,’ gangǝkura nji kǝ ndu nda vavaka mǝn ǝnga tsǝka, arya patǝkura nda a hǝnggǝri abǝr Yahwana nabi nga ja.” <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>Agabangǝ kǝ ndǝ na anǝ nyi, “Naˈya sǝni vi kǝra dǝnama nyi dla sara ri mai.”<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>Kǝ Yesu na anǝ nda, “Nayi ma, nayi wu na anǝ hyi, tara ǝnga dǝnama wa nga yu mǝl sǝˈyar kǝ mai.”<verse eid="LUK 20:8"/></para>
  <para style="s1">Karapau Ar Kǝra Njir Hǝ Fa Nǝ Inabi</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matiwu 21:33-46</ref>; <ref loc="MRK 12:1-12">Markusu 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>Kǝ Yesu nar nyi najaka karapǝ anǝ nji, ji na, “Nggara mau vanyi karapau, Vanyi thlagǝr fa aˈyi kǝra thlǝkana fa wur inabi. Ji zǝwari fa kǝ wu masǝmǝ, ǝnga ji labiya kaˈu nǝ ɓǝci ˈyimir wur inabi. Kǝ ji liya dzaˈwu nǝ ɓǝla fa. Kǝ ji tǝtǝkǝna fa anǝ njir zǝwa, ba ji maˈyi a nda gǝ ndau. <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>Ənggǝra pǝcir fwahǝu ɗa, kǝ ji sǝwa mafa nyi a nda nǝ njira hǝ fa, aga ja dlǝwuri nyi akkǝri nyi nǝ inabi sara wu fa wur inabi nyi. Ama kǝ njira hǝri fa kǝ dǝgǝna mafa kau, ka dzǝgwa sǝwa nyi ǝnga tsi kurthlǝu. <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>Kǝ ji ɓǝra sǝwa vanyi mafa nyi, ama kǝ ndǝ ɓǝra dǝgǝna nyi ka hǝna sǝli nyi, ndǝ dzǝgwa shabiya nyi ǝnga tsi kurthlǝu. <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>Kǝ ji ɓǝra sǝwa mafa nǝ makǝrkura nyi, kǝ ndǝ uya nyi ǝnga mbǝlgǝu, ndǝ vakana nyi a biya.<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>“Kabangǝkau, ndǝ kǝ thlagǝri fa inabi kǝ na, ‘Mi nga ya mǝla? Yu sǝwa zǝr ɗa kǝ zǝmǝ kǝ yu yiwu kau, tara ba nda gǝnggǝr nyi sǝli.’<verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>“Ama ǝnggǝra njir hǝ fa kǝ lari nyi, kǝ ndǝ na wu pama nda, ǝnghǝng! ‘Kǝja ndǝr faˈa ki nyi. Mǝna tsǝya nyi, ba sǝr faˈa ki nyi kǝ patǝ a ɗa nǝr mǝn.’ <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>Kǝ ndǝ tsǝya nyi ka vakana nyi a biyar ya kǝr ki.</para>
  <para style="p" vid="LUK 20:15">“Kabangǝkau, mi nga hyu nggani thlagǝri fa kǝ wu nda mǝl ǝnga njir hǝ fa ka? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>Ju nda shili ja sa dlǝna patǝr njir hǝ fa kau, ba ja dzǝgwa nǝ nyi fa anǝ nji pamǝ tsu.”</para>
  <para style="p" vid="LUK 20:16">Ənggǝra nji kǝ nggari abangau kǝ ndǝ na, “Hyal ja tsana!”<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>Ama kǝ Yesu tsamǝ nda kǝ ji yiwa, “Mi ngǝ sǝ kǝ cabiya wu ndǝr Hyal kǝra tsǝtsǝfa?</para>
  <para style="q1" vid="LUK 20:17">“ ‘Tsǝka kǝra njir hǝr diɗana</para>
  <para style="q2" vid="LUK 20:17">ca ngǝ ɗa tsǝka ɓǝlkǝr.’<verse eid="LUK 20:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18"/>Kalar ndǝra tǝɗau a gyar tsǝka kau, ju ɓǝɓǝl, ama ndǝra tsǝka kǝ tǝɗǝ a gyar ja, ju ǝya dzǝ huhutǝu.”<verse eid="LUK 20:18"/></para>
  <para style="s1">Yiwa Sau Ar Kǝra Ki Budau <optbreak/> Anǝ Tǝl Kayisaru</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matiwu 22:15-22</ref>; <ref loc="MRK 12:13-17">Markusu 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>Ənggau ngǝ malǝmǝ dlaɗǝˈyar ǝnga pubu dǝdǝgalˈyar ndu yiwu nda mbari Yesu, arya ndǝ sǝnbiya abǝr karapǝ kǝ ji lǝ kǝ ar kǝra nda nga nyi, ama kǝ hivǝr mbar nda ara dlamir nji.<verse eid="LUK 20:19"/></para>
  <para style="s1">Ki Budau Anǝ Kaisaru</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20"/>Kǝ ndǝ dzǝgwa gal lagu, ndǝ kina alenyi nji aga nda ɗa ǝnggǝr nji tsapǝu, nji jiri. Ndǝ dzǝgwa sǝwa nda a ndǝgya Yesu aga nda ngǝ ya nyi lǝbam ǝnga sǝra ndu yiwa nyi, aga nda uya nda nǝ nyi Yesu anǝ ndǝr pathla kǝra ǝnga dǝnama nǝr ˈyiˈyir Roma. <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>Nji kǝ nji sǝwa kǝ na anǝ Yesu, “Malǝmǝ, ˈyi wu sǝni abǝr ndǝr ngau ǝnga highiɓǝ ngau jiri nga nyi, ˈyi wu sǝni tsu na gu ca pamǝpamǝkur mai, ama gu highiɓǝ sǝra jiri nǝ lagu Hyal anǝ nji patǝu. <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>Wu ɗǝnga ngau, a ɗar tsaˈa ˈya ki budau anǝ tǝl Kayisaru ǝndǝga awau?”<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">Ənggau lǝbam nga ndǝ ngga anǝ Yesu. Njir Roma nga vǝr sǝm tǝlkur ar kǝra njir Izirayila ǝnga dǝnama. Kǝ ji ndiya nda ǝnga sǝni sau.</char></note><verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>Ama Yesu a sǝnbiya tsǝtsǝlkur nda, kǝ ji na anǝ nda, <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>“Canǝ ɗa mau kwaɓa. Bama wa ǝnga thlǝmǝr wa nga ri ka?”<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>Ndǝ shaɗǝwa nyi, “Nǝ Tǝl Kayisaru ngau.” Kǝ ji nar nda, “Ma abangau, hya nǝ nyi anǝ tǝl Kayisaru sǝra nǝ nyi, ba hya nǝ nyi anǝ Hyal sǝra nǝ Hyal.”<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>Ənggau kǝ ndǝ tini mbari nyi ǝnga ndǝr wu mwar nji. Kǝ ndǝ nggya zǝmǝu, ara shaɗǝwa nyi ɗa sǝ dǝdǝgur anǝ nda.<verse eid="LUK 20:26"/></para>
  <para style="s1">Hyaˈari Sara Vir Tau Ənga Hǝdzau</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matiwu 22:23-33</ref>; <ref loc="MRK 12:18-27">Markusu 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>Kǝja alenyi njir Sadusi, njira na abǝr hyaˈari sara vir tau aˈyi mai, ndǝ dla ǝgya Yesu, ndǝ na, <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>“Malǝmǝ, Musa tsǝfǝri ˈya najaka dlaɗau abǝr, ‘Ma ndǝ tau ji piyari mala nyi kǝra gǝra wazha, a kyau zamǝ nyi a hǝri mala kǝ aga ja uya wazha anǝ zamǝ nyi.’ <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>Nji sayi mǝliya alenyi nji nanda mǝɗǝfau, nanda patǝ zamǝ nga nda. Kǝ dǝgala nda hǝri mala ba ji tau kǝra yabiya zǝr. <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>Kǝ nǝ mǝthlǝkura nyi hǝri mala kau. <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>Nǝ makǝrkura nyi abangau. Kǝ ɗa patǝkura nda mǝɗǝfǝ hǝri mala kau, ama ba ndǝ tǝ patǝ gǝra ya ǝnga mala kau. <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>Wu yukuɗa nyi, mala kǝ ma ba ji tau. <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>Kabangǝkǝ ya, pǝcir hyaˈari sara vir tau, mala wa nga ju nda ɗa? Arya patǝkura nda a hǝri nyi ri nda aga mala.”<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>Yesu na anǝ nda, “Nji kabangǝkǝ kǝl hǝ dzǝ nga ndu hau wu pamǝu, <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>ama njira wu nda ɗa tsaˈa aga hyaˈari sara vir tau nga ndu vu tǝlkur Hyal wu pǝci ta, nandǝ wu hǝ dzǝ mai. <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>Ndu nda ɗa ǝnggǝr waladiˈyar, nandǝ wu ɓǝra tǝ mai. Ndu nda ɗa wazha Hyal ara a hyaˈari nda sara vir tau. <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>Musa ǝnga kǝrnyi a cabiyari ar babal abǝr njira tau ndu nda hyaˈari ǝnga pi. Wu ndǝr ar kǝra kǝdlǝl kǝra mbari uˈu, ji ndǝr ar kǝra Thlagǝ abǝr naja ngǝ, ‘Hyal nǝ Ibrahimu ǝnga Ishaku ǝnga nǝ Yakubu.’ <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>Naja aˈyi Hyal nǝ nji tǝtǝ mai ama nǝ njira ǝnga pi. Anǝ nyi kalar ndau ǝnga pi nga ja.”<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>Kǝ alenyi malǝmǝ dlaɗǝˈyar ndǝ ndǝr ndǝ na, “Malǝmǝ, a nabiyar gǝ kakalǝu!” <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>Ənggau nandǝ ɓǝra uya dǝnama nǝ yiwa nyi vanyi sǝ mai.<verse eid="LUK 20:40"/></para>
  <para style="s1">Yiwa Sau Ar Kǝra Kǝrsiti</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matiwu 22:41-46</ref>; <ref loc="MRK 12:35-37">Markusu 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>Yesu yiwa nda ji na, “Abari nga nju sǝni na abǝr Kǝrsiti zǝr Dawuda? <verse eid="LUK 20:41"/><verse number="42" style="v" sid="LUK 20:42"/>Dawuda ǝnga kǝrnyi na wu lǝkakaɗǝ nǝ Zabura:</para>
  <para style="q1" vid="LUK 20:42">“ ‘Thlagǝ na anǝ Thlagǝ ɗa,</para>
  <para style="q2" vid="LUK 20:42">Nggya lagu mazǝma yau,<verse eid="LUK 20:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43"/>kǝl yi fiya dawa ngau ǝgya kiɗa hiya gau.” ’<verse eid="LUK 20:43"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44"/>Dawuda ji na anǝ Kǝrsiti ‘Thlagǝu.’ Ya abari nga ja sǝni na anǝ nyi zǝr nya?”<verse eid="LUK 20:44"/></para>
  <para style="s1">Yesu Cabiya Sǝra <optbreak/> Malǝmǝ Dlaɗǝˈyar Aga Nyi</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matiwu 23:1-36</ref>; <ref loc="MRK 12:38-40">Markusu 12:38-40</ref>; <ref loc="LUK 11:37-54">Luka 11:37-54</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>Ənggǝra nji patǝ a vǝr sǝ himi nyi, kǝ ji nar nyi anǝ zǝmbǝlma nyiˈyar abǝr, <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>“Hya hangǝkal ǝnga malǝmǝ dlaɗǝˈyar. Ndu yiwu nda ɓau wu pama nji wu kar ha nggunggurǝm ǝnga nja dzǝgwa usa nda ar sugu. Ndu yiwu tsu nja nǝ nda vir nggya tsapǝ wu umbwa daɓǝ dzǝ njir Yahudiya, ǝnga vir nggya nǝ kadakadarkur ar vir mini. <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>Nanda ngǝ njir sǝm kari nǝ mathlǝkǝˈyi tǝsal, nda dzǝgwa ndǝr ǝnga Hyal tugu aga nja lari abǝr aˈyi nda. Jiri, nanda ngu nda lari ɓwaɓwatǝ gagaɗau a ndiya nji patǝu.”<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">Lǝ Sǝ Malatǝsal Anǝ Hyal</para>
  <para style="r">(<ref loc="MRK 12:41-44">Markusu 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>Yesu hyaˈanakǝr kǝ ji lari alenyi njir gǝnna a vǝr fǝ gǝnnar nda a gwu cala tsǝm sau a gwu ki Hyal. <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>Kǝ ji lari vanyi malatǝsal kǝra sǝ nyi aˈyi mai ji shili ǝnga kwaɓa nyi mǝthlǝ kǝ ji puwa a gwu cala. <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>Kǝ Yesu na, “Jiri, nga yu na anǝ hyi,” “sǝra mala tǝtǝ dǝnama kǝ fuwa, a ndiya nǝ nji kǝ patǝu. <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>Arya patǝkura nda ndǝ fuwa sara wu gangǝkura nda ǝni, ama naja ǝnga tukur kǝra ja ǝni, kǝ ji fuwa sǝra ju nggya aga nyi patǝu.”<verse eid="LUK 21:4"/></para>
  <para style="s1">Yesu Ndǝr Ar Kǝra Dla Kǝra Ki Hyal <optbreak/> Wu Nda Dla</para>
  <para style="r">(<ref loc="MAT 24:1-2">Matiwu 24:1-2</ref>; <ref loc="MRK 13:1-2">Markusu 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>Alenyi zǝmbǝlma nyiˈyar dzǝguya ndǝr ar kǝra ki Hyal, ǝnga culi tsǝka mǝnahǝu kǝra nji hǝri ǝni, ǝnga sǝr ɓathlǝ umbwa mǝmǝnahǝ kǝra nji nǝ nyi anǝ Hyal. Ama kǝ Yesu na, <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>“Ma aga sǝˈyar kǝ hyu tsamǝ kau, pǝci wu shili nahyi wu nda thlǝwa tsǝka zǝmǝ ar kǝra kuvwa nyi mai, kalar zǝma nyi nju nda vakana a gyiwu ˈyi.”<verse eid="LUK 21:6"/></para>
  <para style="s1">Ɓwaɓwatǝ Nǝ Tanggǝrma</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matiwu 24:3-14</ref>; <ref loc="MRK 13:3-13">Markusu 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>Ndǝ yiwa nyi, “Malǝmǝ,” nar ˈya, “ǝnuwa ngǝ pǝci kǝra sǝˈyar kǝ wu nda ɗar kǝra, ǝnga mi ngu nda ɗa mǝtsamǝ nǝ shili nga, ǝnga kuɗiyar najaka duniya?”<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>Kǝ ji shaɗǝwa nda, “Hya nggya hya tsamǝ ǝnga hangǝkal nja sara nggutana hyi. Arya nji gangǝu wu nda shili wu thlǝmǝ ɗa, ndu na ǝnga kǝrnda, ‘Nayi ngǝ Kǝrsiti,’ ǝnga, ‘Pǝci a ɗar lǝhǝu.’ Hya sara nu nda mai. <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>Hya sara hivǝr mai, ma hyi nggari ar kǝra papa ǝnga ndǝr ǝngwa ǝngwa ar kǝra papa, hangǝkalǝr hyi ja sara hyaˈari mai. Kǝl ma sǝˈyar kǝ nyabiya dzau, ama tsu kuɗǝr duniya naɗǝu. ”<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>Ji dumwa ǝnga na, “ˈYiˈyi wu dlǝɗǝ ˈyiˈyi, ǝnga tǝlkur wu nda par tǝlkur. <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>Wuɓau ǝnga kǝnggǝɗǝr ˈyiˈyi wu nda ɗarkǝr ar vi pamǝpamǝ gangǝu, ǝnga shilǝgǝˈyar pamǝpamǝ ar kalar vi pamǝpamǝu. Nju nda lari sǝr lǝ hivǝr ǝnga sǝr dǝdǝgurˈyar sara dǝmǝlmau.<verse eid="LUK 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12"/>“Ama kadivira sǝˈyar kǝ ɗa, nju nda mbari hyi nja nǝ hyi ɓwaɓwatǝu. Nju hǝri hyi a ndu umbwa daɓǝ dzǝ njir Yahudiya aga nja thlana hyi numa, nja ɓǝra fuwa hyu fursǝna. Nju hǝri hyi a dumwar tǝlˈyar ǝnga nji dǝdǝgal nǝ mǝlmǝ arya thlǝmǝ ɗa aga nda ɓǝra thlana hyi numa. <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>Sǝˈyar kǝ ngu nda nǝ hyi lagu nǝ tǝtǝlna ndǝshigu mǝsahǝu ar kǝra yau. <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>Agabangǝ hya fǝr kǝr ǝni tsu kaɗǝu abǝr nahyi wu nda ɓwakǝr ǝnggǝra hyu nda hǝbiya kǝrhyi mai. <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>Arya yu nda nǝ hyi sǝr na ǝnga sǝnbiya aga alaga zǝma dawar hyi a sǝni nda shabiya ndǝr hyi ǝnga kǝpalna sǝra hyu na mai. <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>Əkkǝˈyi dǝr hyi, ǝnga zamǝri hyi, ǝnga nji gǝ hyi, ǝnga bazhir hiˈyar wu nda lǝri hyi anǝ nji, ǝnga nju nda tsǝya alenyi nju pama hyi. <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>Patǝkura nju nda yiwu shishir dza hyi mai arya thlǝmǝ ɗa. <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>Ama shishir kǝra hyi zǝmǝ wu nda sa mai. <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>Ma hyu sǝni cinapi hyu uya mbǝɗau.<verse eid="LUK 21:19"/></para>
  <para style="s1">Yesu Nana Ənggǝra Urshalima <optbreak/> Wu Nda Dla</para>
  <para style="r">(<ref loc="MAT 24:15-28">Matiwu 24:15-28</ref>; <ref loc="MRK 13:14-23">Markusu 13:14-23</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>“Ma hyi lari sojaˈyar zǝwar Urshalima, hya sǝni abǝr pǝcir kuɗǝ nyi a ɗar lǝhǝu. <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>Kǝ njira wu ˈyiˈyir Yahudi, nda hwi a du mau. Njira wu hu ɗa mǝlmǝ nda biya, njira a biyar ya mǝlmǝ nda sara vu hu ɗa mǝlmǝ mai. <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>Arya pǝci kǝ pǝcir pathla ngau, a ɗar tsaˈa nja nyabiya sǝra tsǝtsǝfau wu ndǝr Hyal. <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>Sǝr tǝhuɗǝ anǝ mathlǝkǝˈyi kǝra ǝnga huɗǝu ǝnga kǝra a vǝr lǝ uˈwa ar pǝci ta! Ara ɓwaɓwatǝ ɗǝmwaˈyi wu nda vu ˈyiˈyi kau, ǝtsu huɗǝ ndzǝndzǝ nǝ Hyal wu nda gya ar kǝra nji kau. <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>Nju nda tsǝya alenyi nja vǝr pa, nju nda mbari alenyi nji nja maˈyi ǝnga nda a ndu mafakur a ndu alenyi ˈyiˈyi. Njira aˈyi njir Yahudiya mai ndu nda sǝmku Urshalima, kǝl pǝcir nda nyabiya dzau.”<verse eid="LUK 21:24"/></para>
  <para style="s1">Shilǝr Zǝr Ndau</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matiwu 24:29-31</ref>; <ref loc="MRK 13:24-27">Markusu 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>“Nji wu nda lari sǝ pamǝpamǝ nǝ lǝ hivǝr ar pǝci, ǝnga hya, ǝnga shashilga. Wu duniya tsu nju nda gwu ɓwaɓwatǝ ǝnga hivǝr ara par ˈyimi ar tsadau. <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>Nju nda shavǝr ara hivǝr ǝnggǝra nda vǝr ɗǝnga ar kǝra sǝra a vǝr shili wu duniya, arya pǝci, hya ǝnga shashilgaˈyar nju nda kǝnggǝɗǝr nda. <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>Wu pǝci ta nju lari Zǝr Ndau ju shili wu dlama ǝnga dǝnama ǝnga kadakadarkur. <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>Ma sǝˈyar kǝ a dzǝguyar ɗa, hya hyaˈari hya taˈyau ǝnga jirkur hyi ara pǝcir mbǝɗǝr hyi a ɗar lǝhǝu.”<verse eid="LUK 21:28"/></para>
  <para style="s1">Highiɓau Ar Kǝra Wur Kanda</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matiwu 24:32-35</ref>; <ref loc="MRK 13:28-31">Markusu 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>Kǝ ji nar nda najaka karapau, “Tsamiya mau wur ɓǝla ǝnga alenyi wuˈyar. <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>Ma ndǝ dzǝguya thlǝ hyali, nahyi ǝnga kǝrhyi, hya sǝni abǝr biyargwa a shiliri. <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>Abangǝ tsu, ma hya lar sǝˈyar kǝ a ɗari, hya nggya ǝnga sǝni abǝr tǝlkur Hyal a ɗar lǝhǝu.”<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>“Yu nar hyi jirkura nyi, najaka zamanǝu, aˈyi wu tǝrabiya mai, kǝl sǝˈyar kǝ patǝ nyabiya dzau. <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>Dǝmǝlmau ǝnga gyiwu ˈyi wu nda tǝrabiya, ama ndǝr ɗa nǝ nyi wu tǝɗau a gyiwu ˈyi mai.”<verse eid="LUK 21:33"/></para>
  <para style="s1">Kughi Ar Kǝra Nggya Ənga Fǝrkǝr</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>“Hya hangǝkal ǝnga kǝrhyi. Hya sara piyari sǝm ǝnga sa sǝ sasa, ǝnga ɓwaɓwatǝ nǝ nggya biya duniya ja sara hǝna hangǝkalǝr hyi mai. A sara pǝci kǝ a shili ar kǝra hyi ǝnga kǝra sǝnkur hyi <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>ǝnggǝr lǝbam. Ara wu nda shili ar kǝra nji patǝ kǝra wu duniya pǝci ta. <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>Hya nggya ǝnga fǝr kǝr, hya ndǝr ǝnga Hyal parangǝ aga hya uya dǝnama nǝ tǝrabiya wu sǝˈyar kǝ nda ɗa kǝ aga ja daɓaga ɗa hya taˈyau wu mwar Zǝr Ndau.”<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>Kalar pǝci, Yesu a vǝr dumwa ǝnga highiɓau wu ki Hyal, ama ma wagǝu ɗa ba ja maˈyi a ndar vi kǝra nja ngga ǝnga Gar mǝ Zaitunu ba ja pida a dǝna. <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>Kaɗǝ kalar mudlǝ nji patǝ tsu ndu shili ǝgya ja nda sa sǝ himi nyi wu ki Hyal.<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">Ndǝ Mbiya Miya Aga Tsa Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matiwu 26:1-5</ref>; <ref loc="MRK 14:1-2">Markusu 14:1-2</ref>; <ref loc="JHN 11:45-53">Yahwana 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>Pǝcir mǝl lardur nǝr njir Yahudiya ǝnga macikǝl kǝra gǝra thlǝlam, kǝra nja ngga ǝnga lardur vǝlna a ɗar lǝhǝu, <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>kabangǝkǝ pubu dǝdǝgalˈyar ǝnga malǝmǝ dlaɗǝˈyar nda vǝr gal lagu ǝnga dabar kǝra nda daɓaga tsǝya Yesu, ama hivǝr a vǝr tǝ nda ara nji.<verse eid="LUK 22:2"/></para>
  <para style="s1">Yahuda Isikarayoti A Hǝnggǝri Ja <optbreak/> Ji Wu Nǝ Nda Yesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matiwu 26:14-16</ref>; <ref loc="MRK 14:10-11">Markusu 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>Kǝ Shatan gwu ɗǝfuwa Yahuda, kǝra nja ngga ǝnga Isikarayoti pathlǝu wu pama zǝmbǝlma nyi kumo apǝ mǝthlǝu. <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>Kǝ Yahuda maˈyi a ndǝgya pubu dǝdǝgalˈyar ǝnga dǝgal njir ɓǝla ki Hyal aga ja nda nar nda ǝnggǝra ju sǝni pǝlna nyi pǝzhi anǝ Yesu. <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>Kǝ ɗa sǝr caguli anǝ nda, ndǝ hǝnggǝri ndu nǝ nyi gǝnna. <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>Yahuda tsu a hǝnggǝri ja ǝnga sǝra ndǝ na, ja vǝr gal lagu mǝnahǝu kǝra ja sǝni pǝlna nyi pǝzhi anǝ Yesu kǝra ja gǝra sǝni.<verse eid="LUK 22:6"/></para>
  <para style="s1">Yesu Sǝm Sǝr Sǝm Nǝr Vǝlna <optbreak/> Ənga Zǝmbǝlma Nyiˈyar</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matiwu 26:17-25</ref>; <ref loc="MRK 14:12-21">Markusu 14:12-21</ref>; <ref loc="JHN 13:21-30">Yahwana 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>Kǝ pǝcir lardur nǝr macikǝl kǝra gǝra thlǝlam shili, kǝra ɗa ca ngǝ pǝcir thla gamǝ nǝr lardur nǝr vǝlna. <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>Yesu sǝwa Biturusu ǝnga Yahwana, ja vǝr na, “Maˈyi mau hya nda mǝliya mǝn vir sǝm sǝr sǝm nǝ vǝlna aga mǝna sǝm.”<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>Kǝ ndǝ yiwa nyi ndǝ na, “Əmani nga gu yiwu ˈya pabǝra?”<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>Ji na anǝ nda, “Ənggǝra hyu vu hu ɗa mǝlmau, ndǝ sal a vǝr hǝ tǝm ǝnga ˈyimi wu thlǝwa hyi. Nu nya mau a ndu ki kǝra ju nda vuwa gwa. <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>Hya nar nyi anǝ thlagǝr ki kau, ‘Malǝmǝr ˈya ngǝ sǝwa ˈya aga ˈya nar ngau, “Əmani ngǝ umbwa dlǝwu mǝthlǝpi kǝra nayi ǝnga zǝmbǝlma ɗaˈyar wu nda sǝm sǝr sǝm nǝr vǝlbiya a gwa?” ’ <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>Ju nda canǝ hyi umbwa kǝra a dar kǝra umbwa kǝra dǝgal kǝra nja mǝliya ri. Ənggau hya mǝliya kalar sau, aga sǝm sǝr sǝm.”<verse eid="LUK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13"/>Kǝ ndǝ maˈyi ndǝ nda thlǝwa kalar sau ǝnggǝra Yesu nar nda ta, kǝ ndǝ dzǝgwa mǝliya vir sǝm sǝr sǝm nǝr lardur nǝ vǝlna.<verse eid="LUK 22:13"/></para>
  <para style="s1">Sǝm Sǝr Sǝm Yiwukur Nǝ Thlagǝu</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matiwu 26:26-30</ref>; <ref loc="MRK 14:22-26">Markusu 14:22-26</ref>; <ref loc="1CO 11:23-25">1 Kwaranthli 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>Ənggǝra pǝci ɗa, kǝ Yesu ǝnga cama sǝsǝ nyiˈyar nggya aga nda sǝm sǝr sǝm. <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>Kǝ ji na anǝ nda, “A yiwur yau gagaɗau aga ya sǝm lardur nǝr vǝlbiya kǝ ǝnga hyi kadivira ya dzǝgwa lar ɓwaɓwatǝu! <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>Arya yu nar hyi, nayi tsu ɓǝra sǝm sǝ kǝ ǝnga hyi mai kǝl ma jirkura nyi nyabiya dzǝ wu tǝlkur Hyal.” <verse eid="LUK 22:16"/><verse number="17" style="v" sid="LUK 22:17"/>Kǝ ji hǝri kyakiwa, kǝ ji usari Hyal ji na, “Hǝra mau hya tǝkǝya wu pama hyi. <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>Ya vǝr na anǝ hyi abǝr, tsu yu ɓǝra sa ˈyimir yayar wur inabi mai, kǝl ma tǝlkur Hyal shili.”<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>Abangau, kǝ ji hǝri macikǝl, kǝ ji lǝr usaku anǝ Hyal, ba ji ɓǝɓǝlǝwa, kǝ ji nǝ nyi anǝ zǝmbǝlma nyiˈyar, ju na, “Dlǝwura mau hya sǝm, naja kǝ kumǝr dza yi ngau, hya mǝl abangau aga ɗǝngari ǝnga yau.” <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>Abangǝ tsu, ayukuɗa sǝr sǝm nǝ wagǝu, kǝ ji hǝri kyakiwa ta, ji na, “Kyakiwa kǝ ca ngǝ alkawal mbamba mafǝliyangǝ kǝra Hyal mǝliya ǝnga mashi ɗa kǝra nju nda pǝna arya hyi. <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/>Ama kǝja tsa ndǝra wu nda thlǝna hiyau wu cala ǝnga yau! <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>Zǝr Ndau wu nda tau ǝnggǝra Hyal nana, ama sǝr tǝhuɗǝ anǝ ndǝ kǝ pǝlna nyi pǝzhi kau!” <verse eid="LUK 22:22"/><verse number="23" style="v" sid="LUK 22:23"/>Kǝ zǝmbǝlma nyiˈyar dzǝguya yiwa wu pama nda, tara wa ngu nda mǝl sǝ kau.<verse eid="LUK 22:23"/></para>
  <para style="s1">Kǝpal Ar Kǝra Dǝgalkur</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>Abangau kǝ kǝpal hyaˈari wu pama zǝmbǝlma nyiˈyar abǝr tara wa ngu dǝgal wu pama nda. <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>Yesu na anǝ nda, “Tǝlˈyar nǝr duniya vǝr cina njira ǝgya kiɗa nda, ǝnga tsu njira wu sǝm dǝgalkur wu na abǝr nanda ngǝ, ‘Njir dlǝwa nji.’ <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>Ama ja sara ɗa abangau wu pama hyi mai. Ndǝra dǝgal wu pama hyi ja ɗa ǝnggǝr ndǝra ndiya ǝnga kushu, ndǝr sǝm tǝlkur tsu ja ɗa ǝnggǝr ndǝr mǝl thlǝr. <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>Wa nga ndiya ǝnga dǝgala, ndǝra nggya vǝr sǝm sǝr sǝm ǝndǝga ndǝra hǝri sǝr sǝm a shili? Aˈyi ndǝra vǝr sǝm wa? Ama nayau wu pama hyi ǝnggǝr ndǝr mǝl thlǝr anǝ hyi.<verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>“Nahyi ngǝ njira nggya ǝnga yau wu patǝr ɓwaɓwatǝ kǝra yi lari. <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>Ənggǝra dǝɗa caɗǝbiya ɗa aga ya sǝm tǝlkur, abangǝ nga ya vǝr nǝ hyi tsu, <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>abangǝ nga hyu nda sǝm, hya sa ǝnga yu tǝlkur ɗa. Ətsu hyu nda nggya ar vir sǝm tǝlkur, hya dzǝgwa sǝm tǝlkur ar kǝra culi kumo apǝ mǝthlǝ nǝ Izirayila.<verse eid="LUK 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>“Simanu, Simanu, Shatan a dlǝwuri ja dǝnama aga ja dzǝbiya hyi patǝu, ja tǝkǝbiya hyi ǝnga yau ǝnggǝra ndǝr zǝwa wu tǝkǝ uhi ǝnga cacangǝ. <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>Ama a kǝdi ri yi Hyal anǝ ngau, Simanu, a sara mbǝrsa ngau a tǝwa mai. Ayukuɗa ma ga sha ara shili ǝgya yau, ga sa cakǝri nyi dǝnama anǝ zamǝ ngǝˈyar.”<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>Simanu shaɗǝwa, ji na, “Thlagǝu, a pabǝri yi kǝrɗa aga ya maˈyi a vu fursǝna nga gau, alaga tǝ ma.”<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>Yesu shaɗǝwa, “Biturusu, yu nar ngau, kadivira vǝgǝm nda wau ǝshina ǝvuˈyi, gu nda na, na ga sǝni ɗa mai ar kǝr ar kǝr makǝru!”<verse eid="LUK 22:34"/></para>
  <para style="s1">Pǝrki, Mbala Ənga Katsakǝr</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>Kǝ Yesu yiwa nda, “Ənggǝra yi sǝwa hyi gǝra pǝrki, gǝra mbala ǝnga ɓiɓi, a tini ri hyi sǝ ya?” Əngwar nda, “Awau.” <verse eid="LUK 22:35"/><verse number="36" style="v" sid="LUK 22:36"/>Kǝ ji dzǝgwa na anǝ nda, “Ama kabangǝkau, ma gǝ ǝnga pǝrki, ga hǝri, ǝnga mbǝl ɓǝ tsu, ma tsu katsakǝr aˈyi ara ngǝ mai, ɗǝlna lǝgutǝ ha ngau ga ɗǝlbiya zǝmǝ ǝni. <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>Yu nar hyi abǝr sǝ kǝ tsǝtsǝfǝ kǝ abǝr, ‘Nji jigabiya nyi wu pama njir bikau,’ ya nar hyi a ɗar kakalǝ sǝˈyar kǝ nda nyabiya dzǝ ar kǝra yau. Jiri, patǝr sǝra tsǝtsǝfau ar kǝra yau a vǝr nyabiya dzǝ samǝu.”<verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>Zǝmbǝlma nyiˈyar na, “Thlagǝu, tsamiya, kǝ ja katsakǝr mǝthlǝu.” Yesu na, “Tsaˈa abangau.”<verse eid="LUK 22:38"/></para>
  <para style="s1">Yesu Kǝdi Hyal A Dar Kǝra <optbreak/> Mǝ Zaitunu</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matiwu 26:36-46</ref>; <ref loc="MRK 14:32-42">Markusu 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>Yesu piyari vi ta ji maˈyi a ndu mǝ zaitunu ǝnggǝra ji tsǝliya, kǝ zǝmbǝlma nyiˈyar nu nyi. <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>Ənggǝra ndǝ thlǝwa vi ta, kǝ ji na anǝ nda, “Hya kǝdi Hyal hya sara tǝɗau a gu dzau.” <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>Kǝ ji ɓana dzǝ tsalǝu sara wu dzǝri nda, ji ɓǝliya undi ju kǝdi Hyal, <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>“Tada, ma gu yiwu, hǝna ɗa ɓwaɓwatǝ kau, ama aˈyi sǝra yu yiwu mai, ama sǝra gu yiwu bǝgǝ ja ɗa.” <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>Kǝ waladi sara dǝmǝlmau shida ǝgya ja, ja vǝr fǝ ɗǝfu anǝ nyi. <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>Ənggǝra Yesu wu ɓwaɓwatǝ gagaɗau, kǝ ji dumwa ǝnga kǝdi Hyal ǝnga jirkur, ka dzǝgwa ɗa vitǝku kǝra a vǝr biya sara wu dza ja ǝnggǝr mashi nga vǝr tǝɗau a gyiwu ˈyi.<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>Yesu hyaˈari sara a vǝr kǝdi Hyal, ji sha a ndǝra zǝmbǝlma nyiˈyar, ba ji thlǝwa nda wu ghanyi, ara hǝhǝɗakura nda ǝnga huɗǝ ndzǝndzau. <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>Ji yiwa nda, “Mi ngǝ ɗa hyu ghanya? Hyara mau, hya kǝdi Hyal, hya sara tǝɗau a gu dzau.”<verse eid="LUK 22:46"/></para>
  <para style="s1">Nji Mbari Yesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matiwu 26:47-56</ref>; <ref loc="MRK 14:43-50">Markusu 14:43-50</ref>; <ref loc="JHN 18:2-11">Yahwana 18:2-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>Tsu ja vǝr ndǝr kǝ dlamir nji shili, Yahuda, pathlǝu wu pama kumo apǝ mǝthlǝu, naja ngǝ dumwa anǝ nda. Ji shili ǝgya Yesu aga ja bǝrpǝ nyi, <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>ama kǝ Yesu yiwa nyi, “Yahuda, ǝnga bǝrpǝ dzǝ nga ga pǝl pǝzhi anǝ Zǝr Ndǝ ya?” <verse eid="LUK 22:48"/><verse number="49" style="v" sid="LUK 22:49"/>Ənggǝra njir nu Yesu lari sǝkǝ a vǝr yiwu ja ɗa kau, kǝ ndǝ na, “Thlagǝu, ˈya mǝl thlǝr ǝnga katsakǝr ˈya ya?” <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>Pathlǝ wu pama zǝmbǝlma nyiˈyar thlana himi nǝ mazǝma nǝ mafa nǝ pubu kǝra ndiya ǝnga dǝgal ǝnga katsakǝr.<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>Ama kǝ Yesu shaɗǝwa, “Tsaˈa abangau!” Kǝ ji tsǝkwari himiya ndǝ kǝ ba ji mǝliya nyi jamǝu.<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>Yesu ndǝr anǝ pubu dǝdǝgalˈyar, ǝnga dǝgal nǝ ɓǝla ki Hyal ǝnga nji dǝdǝgal nǝ mǝlmau, njira dla aga mba nyi. Ji na, “Nayi ngǝ ndǝr tǝɗǝmwa anǝ njir gwaɗǝvi ya, ǝnga hyi sǝbiya katsakǝr ǝnga zǝwa aga hya sa mba ɗa ya? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>Parangǝu ya vǝr nggya ǝkkǝˈyi hyu Ki Hyal ya vǝr highiɓau, ama nahyi sayi mbar ɗa mai. Sǝˈyar kǝ ɗa patǝ aga sǝra nabiˈyar tsǝfǝri a nyabiya dzau.”<verse eid="LUK 22:53"/></para>
  <para style="s1">Biturusu Na, Na Ja Sǝni Yesu Mai</para>
  <para style="r">(<ref loc="MAT 26:57-58">Matiwu 26:57-58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53-54">Markusu 14:53-54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Yahwana 18:12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>Ndǝ mbari Yesu ndǝ maˈyi ǝnga ja a vu ki pubu kǝra ndiya ǝnga dǝgalǝu. Biturusu nu nyi ama naɗǝ wu yukuɗǝ nyi. <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>Alenyi nji mbǝbiya uˈu ar hada vir thla sau, nda vǝr ɗaha uˈu, kǝ Biturusu shili ji sa nggya wu pama nda. <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>Kǝ mafa zǝr kwa lari nyi a vǝr nggya wu pama nda a miya uˈu. Kǝ ji tsamǝ du liya ja, kǝ ji na, “Ndǝ kǝ tsu ǝnga Yesu nga ja.”<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>Ama kǝ ji kǝpalna. Əngwar ja, “Mala, nayi wu sǝni nyi mai.”<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>Ɓǝliya sar kushu kǝ vanyi ndǝ lari nyi ji na, “Na ngǝ ma pathlǝu wu pama nda.” Kǝ Biturusu shaɗǝwa, ji na, “Ndau, nayi ǝkkǝˈyi ja mai.”<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>Ayukuɗa ǝnggǝr saka pathlǝu kǝ vanyi ndǝ hyaˈana ɗahǝ ji na, “Gǝra kǝpal a gwa ndǝ kǝ ma nanda ngau, arya naja ndǝr Galili.”<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>Biturusu shaɗǝwa nyi, “Ndau, nayi wu sǝni sǝra gu ndǝr ar kǝri kǝ mai!” Ənggǝra ja tsu a vǝr ndǝr, kǝ vǝgǝm wau. <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>Kǝ Thlagǝ shabiya dzǝ ja vǝr tsamǝ Biturusu gǝra hǝna li. Ənggau kǝ Biturusu ɗǝngari ndǝr kǝra Yesu nar nyi, abǝr, “Divira vǝgǝmǝ a wau, gu kǝpalna sǝn ɗa ar kǝr ar kǝr makǝru.” Kǝ ji hwi a biya, ji biya tiwi ǝnga sǝlǝm gagaɗau. <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>Kǝ ji maˈyi a biya ji biya tiwi gagaɗau.<verse eid="LUK 22:62"/></para>
  <para style="s1">Nji Diɗana Yesu Ənga Nji Dǝgǝ Nyi</para>
  <para style="r">(<ref loc="MAT 26:67-68">Matiwu 26:67-68</ref>; <ref loc="MRK 14:65">Markusu 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>Njira nji fiya aga ɓǝla Yesu ndǝ dzǝgwa nggushi nǝ diɗa nyi ǝnga ndǝ dǝgǝ nyi. <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>Ndǝ mbiya liya ja nda dzǝgwa yiwa nyi, “Nar ˈya, tara wa ngu dǝgǝ ngǝ kau?” <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>Ndǝ ɓǝra nar nyi alenyi ndǝr pamǝpamǝ nǝ diɗa nyi.<verse eid="LUK 22:65"/></para>
  <para style="s1">Nji Hǝri Yesu A Shili Wu Mwar <optbreak/> Bilatusu Ənga Hirudusu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Matiwu 26:59-66</ref>; <ref loc="MRK 14:55-64">Markusu 14:55-64</ref>; <ref loc="JHN 18:19-24">Yahwana 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>Ənggǝra vi kuɗau, nji dǝdǝgal nǝ mǝlmau, ǝnga pubu dǝdǝgalˈyar ǝnga malǝmǝ dlaɗǝˈyar ndǝ kaɓau, nji dzǝgwa hǝri Yesu a shili wu mwar nda. <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>Ndǝ na anǝ nyi, “Ma nagǝ ngǝ Kǝrsiti, nar ˈya.”</para>
  <para style="p" vid="LUK 22:67">Yesu shaɗǝwa nda, “Ma yi nar hyi, nahyi wu nda hǝnggǝri ɗa mai, <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>ma tsu yi nda yiwari hyi, nahyi wu nda shaɗǝwa ɗa mai. <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>Ama mbari kabangǝkau, Zǝr Ndau wu nda nggya ar tsi mazǝm nǝ Hyal kǝra ǝnga dǝnama.” <verse eid="LUK 22:69"/><verse number="70" style="v" sid="LUK 22:70"/>Patǝu nda ndǝ yiwa nyi, “Abǝr nagǝ ngǝ zǝr Hyal ya?”</para>
  <para style="p" vid="LUK 22:70">Ji shaɗǝwa, ji na, “A nabiyar hyi kakalǝu, nayi ngau.” <verse eid="LUK 22:70"/><verse number="71" style="v" sid="LUK 22:71"/>Kǝ ndǝ dzǝgwa naja, “Sakida mani nga mǝn ɓǝra gala? A nggari mǝn sara wu miya ja ǝnga kǝrnyi.”<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">Nji Hǝri Yesu A Shili <optbreak/> Wu Mwar Bilatusu</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matiwu 27:1-2</ref>; <ref loc="MAT 11:14">11:14</ref>; <ref loc="MRK 15:1-5">Markusu 15:1-5</ref>; <ref loc="JHN 18:28-38">Yahwana 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>Patǝkura nji dǝdǝgal nǝ mǝlmǝ Yahudiya lǝbiya Yesu a ndǝgya Bilatusu. <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>Kǝ ndǝ dzǝgwa gǝm nyi nda vǝr na, “Naˈyi thlǝwa ndǝ kǝ ja vǝr yiwu ja sana njir ˈya, ǝnga ja vǝr na anǝ nda nda sara ki budau anǝ Kayisaru mai. Əngwar ja naja ngǝ Kǝrsiti, kǝra tǝl.”<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>Kǝ Bilatusu yiwa nyi, ji na, “Nagǝ ngǝ tǝl nǝ njir Yahudiya ya?”</para>
  <para style="p" vid="LUK 23:3">Yesu na anǝ nyi, “Ənggǝra gǝ na kau.” <verse eid="LUK 23:3"/><verse number="4" style="v" sid="LUK 23:4"/>Kǝ Bilatusu nar nyi anǝ pubu dǝdǝgalˈyar ǝnga dlamir nji abǝr, “Nayi nǝ ɗa, nayi thlǝwa ndǝ kǝ mǝliya sǝ ɗǝmwaˈyi mai.”<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>Ndǝ ciɗǝ nyi ǝnga ndǝr nda vǝr na abǝr, “Ənga highiɓǝ nyi nga ji hyaˈana hangǝkala nju ˈyiˈyir Yahudi. Ji dzǝguya sǝ kǝ wu Galili, kǝ ja tsu a shiliri ja ǝnggau.”<verse eid="LUK 23:5"/></para>
  <para style="s1">Nji Hǝri Yesu A Shili Anǝ Hirudusu</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>Ənggǝra Bilatusu nggari abangau, kǝ ji yiwa nda, ji na, “Naja ndǝr Galili ya?” <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>Ənggǝra ji nggari abǝr Yesu sara wu vi kǝra Hirudusu a vǝr sǝm tǝlkur ar kǝri nga ji dla, kǝ ji sǝwa nyi a ndara Hirudusu, arya wu pǝci ta naja Hirudusu ma wu Urshalima nga ja.<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>Ənggǝra Hirudusu lari Yesu kǝ hu ɗa ja pida, arya a sǝkari ja vǝr gal lagu kǝra ja lari Yesu, ara a nggari ja sǝ ar kǝra Yesu, ju cim Yesu a mǝliya nyi sǝ dǝdǝgur. <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>Hirudusu yiwa nyi yiwa sau pamǝpamǝ gangǝu, ama Yesu shaɗǝwa nyi mai. <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>Kǝ pubu dǝdǝgalˈyar ǝnga malǝmǝ dlaɗǝˈyar shili a dumwa nda vǝr fa hya ja ǝnga ndǝr ɗǝmwaˈyu. <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>Hirudusu ǝnga soja nyiˈyar ndǝ diɗana Yesu, ndǝ nggǝl nyi, kǝ ndǝ har nyi nggamndǝ dǝgalǝu, ndǝ dzǝgwa ɓǝra shabiya nyi a ndara Bilatusu. <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>Ar pǝci kǝ ngǝ Hirudusu ǝnga Bilatusu dzǝgwa ɗa bazhi, ara ɗǝɗǝmǝu dawa nga nda.<verse eid="LUK 23:12"/></para>
  <para style="s1">Nji Mǝliya Nyi Numa Tau Anǝ Yesu</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matiwu 27:15-26</ref>; <ref loc="MRK 15:6-15">Markusu 15:6-15</ref>; <ref loc="JHN 18:39">Yahwana 18:39</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>Bilatusu nggari pubu dǝdǝgalˈyar ǝnga nji dǝdǝgal nǝ mǝlmǝ ǝnga nji patǝu, <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>ba ji na anǝ nda, “Hi hǝri ɗa ndǝ kǝ a shili, abǝr ja vǝr hya hangǝkala nji. Kabangǝkǝ a yubiya nyir yau wu dzǝri hyi patǝu, ama nayi thlǝwa sǝ kǝ hyu vazǝ nyi ǝni kǝ mai. <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>Abangǝ tsu ngǝ Hirudusu. Ca ngǝ ɗa ji ɓǝra shabiya nyi a shila nǝ mǝn. A cabiyari sǝ aˈyi ndǝ kǝ mǝliya kǝra ɗa tsaˈa nja tsǝya nyi mai. <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>Agabangǝ yu nda nǝ nyi wuɗa ba ya sǝya nyi.” <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>Kabangǝkau, wu lardur nǝ vǝlbiya kau, a ɗar tsaˈa anǝ Bilatusu, ja sǝya nda ndǝr fursǝna pathlǝ kǝra ndu yiwu.<verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>Ama patǝkura nda hyaˈana ɗahǝ aga zǝmǝ ndǝ na, “Maˈya mau, ǝnga ja, hya sǝya ˈya Barabasu!” <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>(Nji mbiya Barabasu wu fursǝna ara hya hangǝkala nji ǝnga tsa ndau.)<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>Bilatusu ɓǝra ndǝr anǝ nda, arya ju yiwu ja sǝya Yesu. <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>Ama kǝ ndǝ nggya kǝl hya ɗahǝu, “Dlakǝya nyi nji! Dlakǝya nyi nji!”<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>Bilatusu ɓǝra ndǝr anǝ nda nǝ makǝrkura nyi, “Ara mi ya? Wa thlǝmǝ sǝ ɗǝmwaˈyi kǝra ndǝ kǝ mǝliya? Nayi nǝ ɗa, nayi thlǝwa nyi ǝnga bikau kǝra ɗa tsaˈa nja tsǝya nyi mai. Yu sǝwa nja nǝ nyi wuɗa, ba nja sǝya nyi.”<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>Ama kǝ ndǝ taˈyi nǝr nda abǝr kǝl nji dlakǝya nyi. Wu yukuɗu ba ndǝ ndiya dǝnama nyi. <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>Kǝ Bilatusu mǝliya ǝnggǝra ndu yiwu. <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>Kǝ ji sǝya nda ndǝ kǝ ndu yiwu kau, ndǝra nji fuwa wu fursǝna ara hya hangǝkala nji ǝnga tsa ndau. Kǝ ji nǝ nda Yesu aga nda mǝl sǝra ndu yiwu ǝnga ja.<verse eid="LUK 23:25"/></para>
  <para style="s1">Nji Dlakǝya Yesu</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matiwu 27:32-44</ref>; <ref loc="MRK 15:21-32">Markusu 15:21-32</ref>; <ref loc="JHN 19:17-27">Yahwana 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>Ənggǝra sojaˈyar a vǝr maˈyi ǝnga Yesu, Kǝ ndǝ ɓau ǝnga vanyi ndau nja ngga ǝnga Simanu, ndǝr Sayirini, ja vǝr si sara wu miya tagǝu. Ndǝ taˈyina nyi, ndǝ fǝri nyi wu dladlakau ar kǝra ja, ji dzǝgwa nu Yesu ǝni wu yukuɗu.<verse eid="LUK 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27"/>Nji gangǝ gagaɗau a vǝr nu nyi, wu pama nda alenyi mathlǝkǝˈyi aˈyi kǝra a vǝr tiwi, nda vǝr wau ar kǝra ja. <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>Kǝ Yesu shabiya dzǝ a nda kǝra nda, ji na, “Mathlǝkǝˈyi nǝ Urshalima! A sara hya tiwi ar kǝra yi mai, ama hya tiwi ar kǝra kǝrhyi ǝnga wazhar hyi. <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>Arya pǝci a vǝr shili kǝra nju sa na, ‘Sǝr caguli ngau anǝ mathlǝkǝˈyi ciri, njira gǝra vǝr ya, ǝnga njira gǝra sayi mbiya wazha Kǝrnda wu yi.’ <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>A sa ɗa wu pǝci kau,</para>
  <para style="q1" vid="LUK 23:30">“ ‘Nji wu nda na anǝ mau,</para>
  <para style="q2" vid="LUK 23:30">“Dla mau a gyar kǝra ˈya!”</para>
  <para style="q1" vid="LUK 23:30">Ənga anǝ garˈyar,</para>
  <para style="q2" vid="LUK 23:30">“Mbuya ˈya!” ’<verse eid="LUK 23:30"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31"/>“Ma nji mǝl abangau anǝ wu nyanyaɓǝu, abari nga nyi wu nda ɗa anǝ wu uˈula?”<note caller="+" style="f"><char style="fr" closed="false">23:31 </char><char style="ft" closed="false">Ndǝr kǝ karapǝ ngau kǝra cabiya abǝr, “Ma nji sǝni mǝliya sǝ kǝ anǝ ndǝra gǝra ndzana sau, abari nga nyi wu nda ɗa ǝnga ndǝr ndza sa?”</char></note><verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>Nji ɗǝmwaˈyi mǝthlǝ nji lǝbiya nda tsu aga nja tsǝya nda ǝnga Yesu. <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>Ənggǝra ndǝ shili ar vi kǝra nja ngga ǝnga “papangǝkǝr,” kǝ nji dlakǝya nyi a ndǝna, ǝnga nji ɗǝmwaˈyi mǝthlǝ ta, pathlǝu lagu mazǝma ja ǝnga pathlǝu lagu matsala ja. <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>Kǝ Yesu na, “Tada, tǝfǝbiya nda, arya nanda sǝni sǝra nda vǝr mǝl mai.” Kǝ ndǝ dzǝgwa tǝtǝkǝna kar ha nyi wu lagur tǝɗǝ shiˈwu. <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>Nji gangǝu taˈyi nda vǝr tsamǝ ǝnggǝra nji dǝdǝgal a vǝr diɗa nyi, nda vǝr na, “Ji mbǝɗana alenyi nji, kabangǝkǝ ja mbǝɗana kǝrnyi, ma naja ngǝ Kǝrsiti kǝra Hyal caɗǝbiya.”<verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>Sojaˈyar tsu ndǝ diɗana nyi lagur nǝ nyi ˈyimir wur inabi kǝra ɗar mwamwalu. <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>Nda vǝr na anǝ nyi, “Ma nagǝ ngǝ tǝl nǝ Yahudiya, ga mbǝɗana kǝrngau!”<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>Adabanga ja ndǝ tsǝfǝri vanyi tsǝfǝ kǝra na, “NDƏ KƏ NGƏ TƏL NƏ NJIR YAHUDIYA.”<verse eid="LUK 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>Pathlǝ wu pama nji ɗǝmwaˈyi kǝra nji dlakǝya ǝnga ja na ndǝr didiɗi anǝ nyi, “Aˈyi nagǝ ngǝ Kǝrsiti ndangǝ wa? Mbǝɗana kǝrngau ǝnga ˈya!”<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>Ama kǝ nǝ mǝthlǝkura nyi kughi anǝ kuvwa nyi ji na, “Aˈyi gu hivǝr Hyal wa? Na ngǝ kǝra nji thlana hyi numa zǝmǝ ǝnga ja. <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>Nama nǝr ma, tsaˈa ngǝ sǝra nja vǝr mǝl anǝ ma ara sǝra mǝ mǝliya. Ama ndǝ kǝ nǝ nyi, mi ngǝ bikǝ nya?” <verse eid="LUK 23:41"/><verse number="42" style="v" sid="LUK 23:42"/>Kǝ ji na, “Yesu, ga ɗǝngari ɗa ma gǝ vu tǝlkur ngau!”<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>Yesu shaɗǝwa nyi, ji na, “Ya nar ngau jirkura nyi, ǝshina gu nda nggya ǝnga yau a du zarna.”<verse eid="LUK 23:43"/></para>
  <para style="s1">Tǝr Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matiwu 27:45-56</ref>; <ref loc="MRK 15:33-41">Markusu 15:33-41</ref>; <ref loc="JHN 19:28-30">Yahwana 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>Ma pǝci taˈyikǝr, kǝ kuthlǝu haɗiya patǝkura ˈyiˈyi, baˈa ndu saka makǝr nǝ wagǝu, <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>ara ǝnggǝra pǝci nggǝl ara mbǝl. Kadǝmbul kǝra a gwu ki Hyal tǝwa kǝr pamǝpamǝ mǝthlǝu.<note caller="+" style="f"><char style="fr" closed="false">23:45 </char><char style="ft" closed="false">Kadǝmbul kǝ ngǝ tǝkǝbiya pama vi cicau ǝnga vi kǝra ndiya ǝnga cicau. Kǝl pubu dǝgal gagaɗau nga sǝni tǝrabiya a vuwa banga nyi zǝmǝ wu fa. Kǝra cabiya lagur ndǝra Hyal a pahǝri anǝ kalar ndau.</char></note> <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>Yesu hyaˈana ɗahǝu ǝnga dǝnama ji na, “Tada, a vu pǝla gǝ nga yi fiya piya yau.” Ənggǝra ji nana abangau, ba ji sǝna pi nǝ tau.<verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>Ənggǝra soja dǝgal kǝra a ndǝna wu pǝci kǝ lari sǝ kǝ ɗa kau, kǝ ji fal Hyal ja vǝr na, “Pakatǝu, ndǝ kǝ ndǝ gǝra bikǝ ngau.” <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>Ənggǝra njira daɓau aga tsamǝ sǝ tsatsamǝ, lari sǝ kǝ ɗarkǝr kau, kǝ ndǝ sha a ndu ki nda vǝr thlǝ nggǝrau ara huɗǝ ndzǝndzau. <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>Patǝkura njira sǝni Yesu, ǝnga mathlǝkǝˈyi kǝra nu nyi sara wu ˈyiˈyi Galili, ndǝ taˈyi tsalǝu nda vǝr tsamǝ nyi.<verse eid="LUK 23:49"/></para>
  <para style="s1">Haɗǝ Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matiwu 27:57-61</ref>; <ref loc="MRK 15:42-47">Markusu 15:42-47</ref>; <ref loc="JHN 19:38-42">Yahwana 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>Kabangǝkau, vanyi ndau aˈyi kǝra nja ngga ǝnga Yusufu, naja pathlǝu wu pama nji dǝdǝgal nǝ njir Yahudiya, naja ndǝ mǝnahǝu ǝnga ndǝ jiri, <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>naja tsu aˈyi hǝnggǝri ǝnga sǝra nji mbiya ǝnga sǝra nji mǝl mai. Ji shili sara wu mǝlmǝ Arimatiya wu ˈyiˈyir Yahudiya. Naja tsu ja vǝr sǝkǝ shilir tǝlkur Hyal. <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>Kǝ ji maˈyi a ndara Bilatusu aga ja nda kǝdi nja nǝ nyi dza Yesu. <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>Kǝ ji hǝya dza ja nyi sara dar wu, ji pǝɗiya wu paˈwa, ji dzǝgwa fuwa nyi a gu hu kǝra nji labiya a vu mau, hu kǝ nji sayi haɗǝna ndau a gwa mai. <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>Pǝcir fǝ sau wu lagu ngau, a hyiri kushu nja vu pǝcir Ɓǝlsar.<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>Mathlǝkǝˈyi kǝra nu Yesu sara wu Galili maˈyi ǝnga Yusufu aga nda lari hu kau, ǝnga ǝnggǝra nju nda fǝ dza Yesu. <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>Ndǝ dzǝgwa sha a ndu ki, ndǝ nda uya sǝ kisǝu ǝnga mal ɓǝsau. Kǝ ndǝ sǝbiya hǝɗa pǝcir Ɓǝlsar, ǝnggǝra dlaɗǝ nǝ lagu Musa nar nda.<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">Yesu A Hyaˈari Sara Vir Tau</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matiwu 28:1-10</ref>; <ref loc="MRK 16:1-8">Markusu 16:1-8</ref>; <ref loc="JHN 20:1-10">Yahwana 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>Umudlǝ kaɗǝu pǝci tanggǝrma nǝ sugu mathlǝkǝˈyi ya nyi hyaˈari ndǝ hǝri sǝ kisǝu kǝra ndǝ mǝliya, ndǝ maˈyi ǝni a ndar hu. <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>Kǝ ndǝ thlǝwa a jahǝnari nji tsǝka kǝra a miya huwa nyi. <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>Ndǝ gu hu kau, ama nandǝ lari dza Thlagǝ Yesu mai. <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>Ma tsu nda vǝr ɗǝnga sǝkǝ ɗa kau, kukuthlǝ kǝ ja nji mǝthlǝ tataˈyu lǝhǝu wu dzǝri nda, wu kari pǝr tǝ pwahǝu a vǝr mbǝl. <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>Nyinyau ǝnga hivǝr, kǝ mathlǝkǝˈyi kǝ uzhau ǝnga kǝra nda a gyiwu ˈyi. Kǝ nja nyi na anǝ nda, “Ara mi nga hya gal ndǝra ǝnga pi wu pama nji tǝta? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/>Aˈyi ja ngǝ mai, a hyaˈari ja. Hya ɗǝngari sǝra ji na anǝ hyi tsu ja ǝnga hyu Galili. <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>Ji na, ‘Pakatǝ nǝ nyi nju nǝ nyi Zǝr Ndau a ndu tsa njir bikau, ndu dlakǝya nyi, pǝcir pida makǝrkura nyi ju hyaˈari ǝnga pi.’ ” <verse eid="LUK 24:7"/><verse number="8" style="v" sid="LUK 24:8"/>Ənggau kǝ ndǝ ɗǝngari sǝra ji na.<verse eid="LUK 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9"/>Ənggǝra ndǝ sha shili sara ndǝr huwa nyi, kǝ ndǝ nar nyi anǝ zǝmbǝlma nyiˈyar kumo a sǝrtangǝ ta ǝnga alenyi nji sǝˈyar kǝ ɗa kǝ patǝu. <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>Mathlǝkǝˈyi kǝra na sǝˈyar kǝ anǝ cama sǝsǝˈyar kau, nanda ngǝ, Maryamu Magǝdaliya ǝnga Yuwana, ǝnga Maryamu miya Yakubu, ǝnga alenyi mathlǝkǝˈyi kǝra nda ǝni. <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>Ama nandǝ hǝnggǝri sǝra mathlǝkǝˈyi kǝ na mai, ara ma ndu nggani jiri aˈyi wu ndǝr kǝ mai. <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>Ama kǝ Biturusu, hyaˈari maɗu ǝnga hwi a ndar huwa nyi, ji nda uzhau, ji tsambiya hu ɗa huwa nyi, kǝl paˈwa kǝra nji pǝɗiya nyi a gwa ca ngǝ baˈa ar dza huwa nyi. Kǝ ji sha a ndu ki ja vǝr ɗǝnga sǝ dǝdǝgur kǝ ɗa kau.<verse eid="LUK 24:12"/></para>
  <para style="s1">Ar Lagur Vu Imawusu</para>
  <para style="r">(<ref loc="MRK 16:12-13">Markusu 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>Pǝci ta tsu njir nu Yesu aˈyi mǝthlǝ kǝra a vǝr maˈyi a ndu mǝlmǝ kǝra nja ngga ǝnga Imawusu, kǝra naɗǝkura nyi wu ɗa miyal mǝɗǝfǝ sara wu Urshalima. <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>Nda vǝr ndǝr wu pama nda ar kǝra sǝˈyar kǝ ɗarkǝr kau. <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>Ənggǝra nda vǝr ndǝr wu pamǝ nda nda vǝr thla sǝmana, kǝ Yesu ǝnga kǝrnyi lǝhǝn nda, ja vǝr ɓǝ ǝnga nda, <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>a lari nyir nda, ama nandǝ tsamǝ ri nyi mai. <verse eid="LUK 24:16"/><verse number="17" style="v" sid="LUK 24:17"/>Kǝ ji na anǝ nda, “Wa thlǝmǝ najaka sǝmana hya vǝr thla wu pama hya, hya vǝr ɓa?” Kǝ ndǝ taˈyi zǝmǝu, ǝnga huɗǝ ndzǝndzau. <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>Pathlǝ wu pama nda, kǝra nja ngga ǝnga Kǝliyopasu, yiwa nyi, ji na, “Na gǝ mǝthlǝpi wu Urshalima, kǝra na ngǝ sǝnbiya sǝra ɗarkǝr wu pidaˈyar kǝ mai ya?”<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>Kǝ ji na anǝ nda, “Sǝr mi ˈyar ara?”</para>
  <para style="p" vid="LUK 24:19">Kǝ ndǝ na anǝ nyi, “Sǝra ɗa ǝnga Yesu ndǝr Nazǝratu. Naja nabi, kǝra ǝnga dǝnama wu sǝra ju na ǝnga mǝl wu mwar Hyal ǝnga nji patǝu, <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>kǝ pubu dǝdǝgalˈyar ǝnga nji dǝdǝgal nǝr mǝn lǝri nyi aga nja tsǝya nyi, kǝ ndǝ dzǝgwa dlakǝya nyi ar wu dladlakau. <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>Ɗǝɗǝmǝ ˈyi wu nggani abǝr naja ngu sa mbǝɗana njir Izirayila! Ama kǝ ja ǝshina ngǝ pida makǝrkura nyi ǝnggǝra sǝ kǝ ɗarkǝr. <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>Kǝl kǝ zhizhi nyi mai, alenyi mathlǝkǝˈyi kǝra wu pama ˈya nar ˈya sǝ dǝdǝgur. Ara ndǝ maˈyi a ndar huwa nyi ǝmudlǝ kaɗǝu, <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ama nandǝ thlǝwa dza ja wu hu mai, kǝ ndǝ sha shili, ndǝ nar ˈya, abǝr ndǝ lari waladi kǝra na anǝ ˈya abǝr ǝnga pi nga ja. <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>Alenyi nju pama ˈya ndǝ maˈyi a ndar hu ndǝ nda lari abangǝ nga nyi ǝnggǝra mathlǝkǝˈyi ta na, ama nanda ǝnga Kǝrnda nandǝ lari nyi mai.”<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>Kǝ Yesu na anǝ nda, “Əm, nahyi nji kǝra gǝra ǝnga ɗǝnga, aˈyi ɓatsǝ anǝ hyi hya hǝnggǝri ǝnga sǝra nabiˈyar nana mai! <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>A mbari anǝ Kǝrsiti ja sa ɓwaɓwatǝˈyar kau, ja dzǝgwa gu kadakadarkur nyi, aˈyi abangǝ wa?” <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>Kǝ ji cabiya nda sǝra tsǝtsǝfǝ nǝ ndǝr Hyal na ar kǝra ja, mbari ar highiɓǝ Musa baˈanǝ tsǝfǝri nabiˈyar patǝu.<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>Ənggǝra ndǝ dla lǝhǝu wu dzǝri mǝlmǝ kǝra nda vǝr maˈyi a vuwa gwa, kǝ Yesu mǝl ǝnggǝr tǝrabiya a ndumwar nda, <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>ama kǝ ndǝ ciɗǝ nyi nda vǝr na, “Nggya ǝnga ˈya, ara wagǝu a ɗari, kǝ ja pǝci a gya tǝɗǝri.” Kǝ ji nu nda ji nda nggya ǝnga nda. <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>Ənggǝra ndǝ nggya aga sǝm sǝr sǝm, kǝ ji hǝri macikǝl ba ji fǝnggǝr barka, kǝ ji ɓǝɓǝlǝwa ba ji tǝkǝna nda. <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>Ənggau kǝ liya nda pahau, ndǝ tsamǝ ri nyi. Ama kǝ ji sanakǝr wu liya nda. <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>Ndǝ na anǝ kuvwar nda, “Ɗǝm ya, hu ɗa mǝn aˈyi nyinyau ǝnga caguli ar pǝci kǝra ja vǝr ndǝr anǝ mǝn ar lagu wa, ǝnggǝra ja vǝr cabiya mǝn sǝra tsǝtsǝfau wu ndǝr Hyal wa?”<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>Kǝ ndǝ hyaˈari ǝnga kusa ndǝ sha a vu Urshalima. Ndǝ thlǝwa nanda kumo a sǝrtangǝ ta ǝkkǝˈyi alenyi nji a vu na, <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>kǝ ndǝ nar nda, kadzangǝ, “Thlagǝ a hyaˈari! A canǝ nyi ja kǝrnyi anǝ Biturusu!”<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>Ənga tsu nanda mǝthlǝ kǝ nar nda sǝra ɗa ǝnga nda wu lagu ǝnga ǝnggǝra ndǝ tsamǝ ri Yesu ayukuɗa ji ɓǝɓǝlǝwa nda macikǝl.<verse eid="LUK 24:35"/></para>
  <para style="s1">Thlǝr Kǝra Yesu Nǝ Nyi <optbreak/> Anǝ Zǝmbǝlma Nyiˈyar</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matiwu 28:16-20</ref>; <ref loc="MRK 16:14-18">Markusu 16:14-18</ref>; <ref loc="JHN 20:19-23">Yahwana 20:19-23</ref>; <ref loc="ACT 1:6-8">Thlǝr Camaˈyar 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>Tsu nda vǝr ndǝr ar kǝra sǝ kau, kukuthlǝ kǝja Yesu taˈyu wu pama nda, kǝ ji na anǝ nda, “Jamǝkur ja nggya ǝnga hyi.”<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>Ama kǝ ndǝ gǝrahǝ nda vǝr tsǝdzau, ma ndǝ nggani dǝgur ngǝ canǝ nda kǝr. <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>Kǝ ji na anǝ nda, “Mi ngǝ ɗa hyi gǝrahǝ abanga, ǝnga hyu nggya ǝnga tǝkǝkǝr wu ɗǝfuwa hya? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>Tsamiya mau tsa yau ǝnga hya yau aga hya lari, nayi ǝnga kǝrɗa ngau. Tsǝkwar ɗa mau, aga hya sǝni abǝr dǝgur aˈyi ǝnga kum ǝnga ɗǝhi, ǝnggǝr kǝ hya vǝr lari ɗa kǝ mai.”<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>Ayukuɗa ji nana abangau, kǝ ji canǝ nda tsa ja ǝnga hya ja. <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>Tsu nda vǝr caguli ara sǝ dǝdǝgur kǝ ɗa kau, ama tsu nda ǝnga tǝkǝkǝr wu ɗǝfuwa nda, kǝ ji na anǝ nda, “Sǝr sǝm aˈyi ara hyi nga nyi ya?” <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>Kǝ ndǝ nǝ nyi kalfi kukubwa. <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>Kǝ ji dlǝwuri ji sǝmku, nanda kǝl tsamǝ nyi.<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>Ji na anǝ nda, “Sǝˈyar kǝ ngǝ sǝra yi ndǝr anǝ hyi ar kǝri pǝci kǝra yi tsu ǝnga hyi, abǝr a mbari nja nyabiya sǝra nji tsǝfǝri ar kǝra yau wu dlaɗǝ nǝ lagu Musa, ǝnga tsǝfǝ nǝ nabiˈyar ǝnga Zabura tsu.”<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>Kǝ ji mǝliya ndǝ sǝnbiya sǝra tsǝtsǝfau wu ndǝr Hyal, <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>Ji nar nda, “Abangǝ nga nyi tsǝtsǝfau, abǝr a ɗar tsaˈa anǝ Kǝrsiti ja lari ɓwaɓwatǝu, pǝci makǝrkura nyi ba ja hyaˈari sara vir tau. <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>Ətsu wu thlǝmǝ nyi nga nju nda tǝtǝlna ndǝr Hyal anǝ njir duniya patǝ aga nda tubi nda uya tǝfǝbiya bikǝr nda. Nju nda dzǝguya sǝ kǝ wu Urshalima. <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>Nahyi ngǝ sakida sǝˈyar kau. <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>Kǝja, yu nda sǝwa hyi sǝra dǝɗa mǝliya hyi alkawal abǝr ju sǝwa. Ama hya sǝkǝ wu mǝlmǝ kwatahǝu, kǝl nji nǝ hyi dǝnama sara dǝmǝlmau.”<verse eid="LUK 24:49"/></para>
  <para style="s1">Nji Hǝr Yesu A Dǝmǝlmau</para>
  <para style="r">(<ref loc="MAT 16:19-20">Matiwu 16:19-20</ref>; <ref loc="ACT 1:9-11">Thlǝr Camaˈyar 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>Kǝ ji hǝbiya nda a biyar ya mǝlmau, ndǝ maˈyi ba a vu Bethlani. A ndǝna, ji hyaˈana tsa ja dǝmǝlmau kǝ ji fǝnggǝr nda barka. <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>Ənggǝra ja vǝr fǝ barka anǝ nda, kǝ ji tǝkǝbiya dzǝ ǝnga nda, ji maˈyi a dǝmǝlmau. <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>Nanda tsu ndǝ dzǝgwa dlǝvǝ nyi, ndǝ sha a vu Urshalima, nyinyau ǝnga huɗǝ pǝrtǝu gagaɗau. <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>Ndu shili parangǝ tsu wu ki Hyal nda vǝr fal Hyal.<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
