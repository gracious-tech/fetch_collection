<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Margi Tiwi Ənga Tǝm [mfm]</book>
  <para style="h">Tasalonika Nǝ Tanggǝrma</para>
  <para style="toc3">Tas Tan</para>
  <para style="toc2">Tasalonika Nǝ Tanggǝrma</para>
  <para style="toc1">Tsǝfǝ Nǝ Bulusu Anǝ Njir Tasalonika</para>
  <para style="mt2">Cama Tsǝtsǝfǝ Nǝ Bulusu Nǝ Tanggǝrma Anǝ</para>
  <para style="mt1">Njir Tasalonika</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s">Usa Dzau</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>Cama tsǝtsǝfǝ kǝ sara ara Bulusu, ǝnga Silasu, ba ǝnga Timathlawusu.</para>
  <para style="p" vid="1TH 1:1">A nda nǝ daɓǝ dzǝ njir nu wu mǝlmǝ Tasalonika, kǝra nǝ Hyal Tada ǝnga Thlagǝr mǝn Yesu Kǝrsiti.</para>
  <para style="p" vid="1TH 1:1">Mayiwakur ǝnga huɗǝ pǝrtǝu anǝ hyi.<verse eid="1TH 1:1"/></para>
  <para style="s">Bulusu Lǝr Usaku Arya Mbǝrsa Nǝ <optbreak/>Daɓǝ Dzǝ Njir Nu Nǝ Tasalonika</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>Cumu nga ˈyu lǝ usaku anǝ Hyal arya hyi patǝu, ǝnga ˈyu ngga thlǝmǝr hyi wu kǝdi Hyalǝr ˈya. <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>ˈYu dumwa ǝnga ɗǝnga ar kǝra hyi wu mwar Hyalǝr mǝn ǝnga Dǝrmǝn, ar kǝra thlǝrǝr hyi nǝ mbǝrsa, ǝnga thlǝr yiwukur kǝra hyu mǝl wu dzau, ǝnga cinapir hyi wu fǝrkǝrǝr hyi wu Thlagǝr mǝn Yesu Kǝrsiti.<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>Wazha ama kǝra Hyal wu yiwu, a sǝn ˈya abǝr Hyal ngǝ caɗǝbiya hyi, <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>arya ndǝshigur ˈya aˈyi shili anǝ hyi ǝnga ɗahǝ waci mai, ama tsu ǝnga dǝnama, ǝnga Mambǝl Cicau, ǝnga jiri tataˈyi pir. Arya wu sǝn hyi ǝnggǝra ˈyi nggya wu pama hyi aga dlǝwa dzǝr hyi. <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>Hyi ɗa njir faˈabiya hiya ˈya ǝnga njira faˈabiya hiya Thlagǝu. Alaga wu ɓwaɓwatǝ gagaɗau, kǝ hyi dlǝwuri cama sara ara ˈya ǝnga huɗǝ pipida lagur Mambǝl Cicau. <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>Lagu kǝ nga hyi ɗa njira nju fǝ li ari anǝ patǝr njir nu wu ˈyiˈyir Masidoniya ǝnga Akaya. <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>Arya sara ara hyi ngǝ cama Thlagǝ tǝtǝlnakǝr, aˈyi wu ˈyiˈyir Masidoniya ǝnga Akaya waci mai, ama anǝ kalar njira sǝnbiya sǝ ar kǝra mbǝrsar hyi wu Hyal baˈamani. Agabangau, sǝ aˈyi ˈya ɓǝra sǝn na ar kǝri mai. <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>Arya nja nyi ǝnga kǝrnda nga vǝr lǝ sakida ǝnggǝra hyi dlǝwur ˈya. Nja nyi nar ˈya ǝnggǝra hyi tǝkǝbiya dzǝ ǝnga katǝr hyi ˈyar, ba hyi sha shili ǝgya Hyal, Hyal jijiri kǝra ǝnga pi.<verse eid="1TH 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 1:10"/>Ndǝ nana tsu, ǝnggǝra hyi nggya aga sǝkǝ shidar Zǝr nyi sara dǝmǝlmau, ndǝra Hyal hyaˈana nyi sara vir tau, ca ngǝ Yesu, ndǝra kǝtiya mǝn ara numa nǝ huɗǝ ndzǝndzǝ Hyal kǝra wu shili.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s1">Thlǝr Bulusu Wu Tasalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>Nahyi ǝnga kǝrhyi wazha ama, hyu sǝni abǝr ndar ˈya a ndǝgya hyi aˈyi ɗa sǝ kurthlǝ mai. <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>Ama alaga kǝ a lar ˈya ɓwaɓwatǝu ǝnga diɗa wu mǝlmǝ Fǝlipi, ǝnggǝr kǝra hyu sǝni, ama ǝnga tsǝtsǝku ɗǝfu nǝ Hyalǝr mǝn, a nǝ hyir ˈya ndǝshigu, wu patǝkura ɓwaɓwatǝr ˈya wu tsa dawa. <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>Arya ndǝr Hyal kǝra ˈyu mǝl kau, aˈyi shili sara wu mbǝrza ǝnga dadam ɗǝfu mai, alaga ˈyi nǝrdzau aga ˈya nggutana hyi mai. <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>Ama ˈyu ndǝr ǝnggǝr njira Hyal dlunggǝri ǝnga nda, kǝ ji fuwa ndǝshigu wu tsa nda. Aˈyi ˈya njira wu yiwu nda pina huɗa nji mai, ama Hyal ndǝra wu dzǝbiya ɗǝnga ɗǝfwa nji. <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>Ənggǝra hyu sǝni, ndǝr ˈya aˈyi ndǝr mǝsahǝ ar miya mai, ǝtsu aˈyi ˈya ǝnga ngushi ar kǝra bama nǝ ɗǝwa sunakur mai. Hyal ngǝ sakidar ˈya. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>Naˈya aˈyi gal fal ara nji mai, alaga sara ara hyi ǝnga sara ara alenyi nji mai.</para>
  <para style="p" vid="1TH 2:6">Ar viya cama sǝsǝ nǝ Kǝrsiti, tsaˈa nga nyi, ˈya sǝn na hya sǝmǝna ˈya. <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>Ama ˈyi nu hyi ǝnga hangǝkal ǝnggǝr kǝra ama a vǝr lǝ hangǝkal anǝ zǝr mamanji. <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>Arya ˈyu yiwu hyi gagaɗau, ca ngǝ ɗa ǝnga caguli nga ˈyi nǝ hyi ndǝshigu patǝ ǝkkǝˈyi kǝrˈya. Aˈyi tǝtǝlna ndǝr Hyal kǝ waci mai, ama ǝnga caguli ˈyi lǝr kǝrˈya ara njir ɗǝfwa ˈya nga hyi.<verse eid="1TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9"/>Pakatǝ wazha ama, hyu ɗǝngari ǝnga thlǝr dzadzau kǝra ˈyi mǝl vuˈyi ǝnga pǝci ara ˈya sara fǝnggǝr hyi ɓwaɓwatǝu arya ndǝshigu anǝ kalar ndaliya hyi.<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>Nahyi ngǝ sakida, nahyi njir mbǝrsa, ǝnga Hyal ngǝ sakida tsu, ar kǝra culi nggyabiya kǝra ˈyi cabiya hyi, nggyabiya nǝ cicikur, ǝnga nǝ tsapǝkur, ba ǝnga nggyabiya gǝra vazau. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>Ənggǝr kǝra hyu sǝni, abǝr ˈya vǝr nu kalar ndaliya hyi ǝnggǝr kǝra tada a vǝr nu ǝnga wazha nyi. <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>ˈYi tsǝtsǝkuya hyi, ǝnga ˈyi sǝsǝkuya hyi, ba ǝnga ˈyi kǝdi hyi aga hya nggya nggya tsatsaˈa aga tǝlkur Hyal, ndǝra ngga hyi a vu tǝlkur nyi ǝnga kadakadarkur nyi.<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>Arya abangau, ˈyu usaku anǝ Hyal cumu, arya ar pǝcira hyi dlǝwuri ndǝr Hyal kǝra hyi nggari sara ara ˈya, hyi dlǝwuri ǝnggǝr ndǝr Hyal ama aˈyi ǝnggǝr ndǝr ndǝ mai. Pakatu ndǝr Hyal ngau, kǝra a vǝr mǝl thlǝr nyi wu ɗǝfwa hyi, nahyi njira mbǝrsa. <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>Nahyi ja, wazha ama, hya faˈabiya hiya daɓǝ dzǝ njir nu Hyal pamǝpamǝ kǝra wu Yahudi, njira wu Kǝrsiti Yesu. Ənggǝr kǝra hyi lar ɓwaɓwatǝ wu tsa njir mǝlmǝr hyi, tangǝ ǝnggǝr ta ngǝ daɓǝ dzǝ njir nu ˈyar lar wu pǝla njir Yahudiya. <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>Njir Yahudiya ngǝ tsǝya Thlagǝ Yesu ǝnga nabiˈyar tsu, ǝnga tsu ndǝ kǝdlǝna ˈya, kǝ sǝ ndzana huɗa Hyal, ba ndǝ ɗa dawa ǝnga nji patǝu! <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>Ndu nǝrdzau aga ka ˈya ara tǝtǝlna ndǝr Hyal anǝ njira aˈyi njir Yahudiya mai, a sara nda uya mbǝɗau. Lagu kǝ nga ndǝ cakǝri kyakiwa bikǝr nda. Ama kǝja huɗǝ ndzǝndzǝ Hyal a shidari ar kǝra nda.<verse eid="1TH 2:16"/></para>
  <para style="s1">Cimǝr Bulusu Ja Ɓǝra Lar Njir Tasalonika</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>Ama, wazha ama, ar pǝcira nji tǝkǝbiya mǝn ǝkkǝˈyi hyi nǝ pǝci kushu, tǝkǝ nǝ kumǝr dzǝ ngau, aˈyi nǝ ɗǝfu mai. A vǝr cim nga ˈya, ǝnga ˈyu nǝrdzau aga ˈya lar hyi bama ǝnga bama. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>A ciwar ˈya wu kǝr aga ˈya shili ǝgya hyi, nayi Bulusu, yi nǝrdzau aga ya shili, nǝrdzǝ ɗa aˈyi aga zǝmǝ mai, aˈyi aga mǝthlǝ tsu mai, ama ba shatan kar ˈya. <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>Mi ngǝ sǝr fǝr kǝrǝr ˈya, ǝnga sǝr cagulir ˈya, ǝnga tsu dara tǝlkur nǝ kadakadarkur ˈya wu mwar Thlagǝr mǝn Yesu ar pǝcir shida nya? Aˈyi nahyi ngǝ wa? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>Jijiri, nahyi ngǝ kadakadarkurǝr ˈya ǝnga cagulir ˈya.<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>Agabangau, ta ɗa naˈyu sǝn mbiya ɗǝfu mai, ba ˈyi lari a ɗari tsaˈa nja piyar ˈya wu Athlinu naˈya zhizhir ˈya. <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>ˈYi sǝwa hyi Timathlawusu zamǝr mǝn, ǝnga zamǝ mǝl thlǝr Hyal, ndǝr tǝtǝlna ndǝshigu nǝ Kǝrsiti aga ja cakǝr hyi dǝnama ǝnga tsǝtsǝkur hyi wu mbǝrsar hyi. <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>Ji mǝl abangau, a sara vanyi nda sara kǝnggǝɗǝr dzau ara culi najaka ɓwaɓwatǝ kǝra hyi a gwa. Arya hyu sǝni tsu kaɗǝ nga nji nana abǝr kǝl mǝn tǝrabiya a gwa. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>Pakatǝu, ar pǝcira aˈyi ˈya ǝkkǝˈyi hyi, a nar hyir ˈya abǝr nju nda ɗa ˈya. Abangǝ tsu nga nyi ɗarkǝr ǝnggǝr kǝra hyi sǝni. <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>Arya kau, ta ɗa nayi sǝn mbiya ɗǝfu mai, ba yi sǝwa aga ya yiwabiya ar kǝra mbǝrsar hyi. Yu hivǝr ara ndǝr dzǝ kau, ja sara dzǝbiya hyi ba hǝɗar ˈya a ɗa sǝ kurthlǝu.<verse eid="1TH 3:5"/></para>
  <para style="s1">Ndǝr Fǝ Ɗǝfu Kǝra Shili Ara Timathlawusu</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>Ama kǝja Timathlawusu a shiliri kabangǝkau sara ara hyi, ji sa nar ˈya sǝ mǝnahǝ ar kǝra mbǝrsar hyi ǝnga yiwukur kǝra hyu ca. Ji ɓǝra nar ˈya ǝnggǝra aˈyi hyi ǝnga ɗǝnga cacaguli ar kǝra ˈya ǝnga ǝnggǝra hyu cim nǝ lar ˈya ǝnggǝr kǝra ˈyu cim nǝ lar hyi. <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>Agabangau, wazha ama, wu patǝr ɓwaɓwatǝ ǝnga ɗa pamǝpamǝ kǝra ˈyi sa, a uyar ˈya sǝsǝku ɗǝfu arya mbǝrsar hyi. <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>Kabangǝkǝ ja, a ɗar ˈya nji mbǝmbǝɗau, ta ɗa a taˈyir hyi jijiri wu Thlagǝu. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>Wa thlǝmǝ culi usaku, kǝra ˈya sǝn nǝ nyi anǝ Hyal, arya madiya caguli kǝra ˈyi uya wu mwar Hyal arya hya? <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>Vuˈyi ǝnga pǝci nga ˈya vǝr nǝrdzau wu kǝdi Hyal aga ˈya lar hyi li ǝnga li aga ˈya nyabiya vira hyi tǝwa wu mbǝrsa.<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>Bǝgǝ Hyalǝr mǝn ǝnga Dǝrmǝn ǝnga kǝrnyi, ba ǝnga Thlagǝr mǝn Yesu ja pahǝna ˈya lagu aga ˈya shili ǝgya hyi. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>Bǝgǝ Thlagǝ a mǝliya yiwukurǝr hyi a cakau, a dumwa dumwa anǝ kuvwar hyi ǝnga kalar ndau ǝnggǝr kǝra ˈya vǝr yiwu hyi. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>Bǝgǝ ja tsǝtsǝkur ɗǝfuwa hyi aga hya ɗa nji gǝra vazau, ǝnga hya ɗa nji cicau wu mwar Hyalǝr mǝn ǝnga Dǝrmǝn wu pǝcir shidar Thlagǝr mǝn Yesu daɓǝ ǝnga nji cici nyi patǝu.<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s1">Nggyabiya Nǝ Pina Huɗa Hyal</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>Ayukuɗa sǝ patǝ wazha ama, ˈyu kǝdi hyi ǝnga ˈyu tsǝtsǝku hyi aga hya nggya nǝ pina huɗa Hyal ǝnggǝr kǝra hya vǝr nggya kabangǝkau. ˈYu cakǝr kǝdiyau aga hya ɓǝra cakǝr dumwa ǝnga mǝl abangǝ wu Thlagǝ Yesu. <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>Arya hyu sǝni tǝɗǝ himiya hyi kǝra ˈyi mǝl kǝ wu dǝnama tǝlkur nǝr Thlagǝ Yesu ngau.<verse eid="1TH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3"/>Yiwu huɗa Hyal ngau, hya nggya cicau ǝnga hya hwi ara sǝsukur. <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>Kalar ndǝ wu pama hyi ja sǝni ǝnggǝra ja nggya ǝnga kǝrnyi, ja nggya cicau ǝnga ja sǝɓiya ndǝkur nyi, <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>aˈyi wu lagur suna sǝsukur ǝnggǝr kǝra njira gǝra sǝn Hyal wu mǝl mai. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>Wu najaka sau, a sara ndǝ a ndza sǝ alaga ɗiya zamǝ nyi mai, arya Thlagǝu wu nda nǝ nyi anǝ kalar ndǝ ɓwaɓwatǝ nǝ kalar bikǝ nyi ǝnggǝr kǝra ˈyi nar hyi, ǝnga ˈyi kughiya hyi tsu kaɗǝ ta. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>Aˈyi aga nggya dedeɓǝ ngǝ Hyal ngga mǝn mai, ama aga mǝna nggya cicau. <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>Agabangau, kalar ndǝra nggǝl ara dlǝwu ndǝr kau, aˈyi ndǝr ndǝ nga ji piyari mai, ama ndǝr Hyal nga ji piyari, Hyal ndǝra nǝ hyi Mambǝl Cici nyi.<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>Ar kǝra yiwu dzǝ wazha ama tsu, aˈyi kǝl yi ɓǝra tsǝfǝr hyi ar kǝri mai, arya ndǝr Hyal a highiɓǝrǝr hyi ri hya yiwu kuvwar hyi. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>Pakatǝu, hya vǝr ca yiwukur anǝ wazha ama wu ˈyiˈyir Masidoniya, ama cimǝr ˈya wazha ama, ca ngǝ hya dumwa ǝnga yiwudzau ar cakau ar cakau.<verse eid="1TH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 4:11"/>Hya nǝrdzau aga hya nggya jamǝu, ǝnga hya sara fǝ miya hyi a vu ndǝr nji mai, ǝnga hya mǝl thlǝr ǝnga dǝnamar hyi ǝnggǝr kǝra ˈyi highiɓǝr hyi. <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>Hya mǝl abangǝ aga hya ɗa njira nju gǝnggǝr nda sǝli wu mwar njira gǝra njir nu, ǝnga hya sara ɗa njir nggya aga ndǝ mai.<verse eid="1TH 4:12"/></para>
  <para style="s1">Shidar Thlagǝu</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>Wazha ama, naˈyu yiwu hya nggya ǝnga gǝra sǝn sǝ ar kǝra njira tau wu Kǝrsiti mai, ǝnga hya nggya wu huɗǝ kyakyaru ǝnggǝr njira gǝra ǝnga fǝr kǝr mai. <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>Mara a hǝnggǝr mǝn abǝr Yesu a tǝri, kǝ ji hyaˈari, abangǝ tsu a hǝnggǝr mǝn abǝr Hyal wu nda shabiya njira tǝ wu Yesu a shida ǝkkǝˈyi ja. <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/>ˈYu ndǝr kau anǝ hyi ǝnggǝr kǝra ndǝr Thlagǝ nana abǝr, namǝn kǝra aˈyi ǝnga pi kabangǝkau, ar pǝcir shidar Thlagǝr mǝn, aˈyi mǝn wu nda hyaˈari tanggǝrma a mwara njira tǝ mai. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>Arya Thlagǝ ǝnga kǝrnyi wu nda shida sara dǝmǝlmau ǝnga ngga dǝdǝgalǝu, ǝnga ɗaha dǝdǝgal nǝ madiya waladi, ǝnga mbǝɗǝ tǝlǝmǝ nǝ Hyal. Ənggau, njira tǝ wu Kǝrsiti, nanda ngu dzǝgwa hyaˈari tanggǝrma. <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>Ayukuɗa ndǝ hyaˈari, namǝn kǝra ǝnga pi mǝn wu dzǝgwa hyaˈari. Nja dzǝgwa hǝr mǝn a dǝmǝlmau a du dlama, aga mǝna da ɓǝ ǝkkǝˈyi Thlagǝr mǝn a dǝmǝlmau. A ndǝna, mǝna dzǝgwa dumwa ǝnga nggya ǝnga Thlagǝu baˈanuwa. <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>Agabangǝ ja, hya fiya nyi ɗǝfu anǝ kǝrhyi ǝnga najaka ndǝr.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>Wazha ama, ar kǝra pǝci ǝnga saka nǝ shilǝr Thlagǝu, aˈyi mbari ˈya tsǝfǝri hyi sǝ ar kǝri mai, <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>arya nahyi ǝnga kǝrhyi hyu sǝni abǝr pǝcir Thlagǝr mǝn wu nda ɗa ǝnggǝr shilǝr ndǝr hǝl ǝvuˈyi. <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>Ar pǝcira nja vǝr na, “Nggya jamǝu ǝnga huɗǝ pǝrtǝ a shiliri,” kukuthlǝ ba ɓwaɓwatǝ nǝ sa a shili ar kǝra nda, ǝnggǝr kǝra ya shili anǝ mala huɗu ma pǝcir ya nyi a shiliri. Lagur mbǝɗǝbiya dzǝ aˈyi mai.<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>Ama nahyi wazha ama aˈyi hyi wu kuthlǝ mai, ǝnga pǝci kǝ aˈyi a sǝn shili ar kǝra hyi kukuthlǝ ǝnggǝr ndǝr hǝl mai. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>Nahyi patǝu, wazha nǝ mbǝmbǝl ngau, ǝnga wazha nǝ pǝci tsu. Namǝn aˈyi njir vuˈyi alaga njir kuthlǝ mai. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>Agabangau, a sara mǝna ɗa njir gu ghanyi mai, ǝnggǝr kǝra alenyi nja vǝr mǝl mai. Bǝgǝ mǝna nggya liliˈu aga mǝna tsamǝ ǝnga mǝna nggya ɓaɓathlǝ dzau. <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>Arya njira wu gu ghanyi, ǝvuˈyi nga ndu gwa. Njira wu sa sǝ sasa tsu, ǝvuˈyi nga ndu sa, ba ja thlǝkǝna nda. <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>Ta ɗa nǝ puci nga mǝn, taˈyi mǝna tsamǝ ǝnga mǝna nggya ɓaɓathlǝ dzau. Bǝgǝ mbǝrsa ǝnga yiwudzau nda ɗa lǝgutǝ liyangǝ har mǝn, ǝnga fǝr kǝr nǝ mbǝɗǝ tsu ja ɗa dara liyangǝ har mǝn. <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>Arya Hyal aˈyi jigǝwa mǝn wu njir huɗǝ ndzǝndzǝ nyi mai, ama aga mǝna uya mbǝɗau lagur Thlagǝr mǝn Yesu Kǝrsiti. <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>Kǝrsiti ndǝra tau arya mǝn, aga mǝna ɗa ǝnga pi ǝnga ja, alaga liliˈu mǝn alaga mǝn wu ghanyi. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>Agabangǝ hya fiya nyi ɗǝfu anǝ kǝrhyi, ǝnga hya dumwa ǝnga dlǝwa kuvwar hyi ǝnggǝr kǝra hya vǝr mǝl kau.<verse eid="1TH 5:11"/></para>
  <para style="s1">Usa Dzau Ənga Tǝɗǝ Himi</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>Kabangǝkau, ˈyu kǝdi hyi wazha ama, hya gǝnggǝr nyi sǝli anǝ njir mǝl thlǝr ǝnga jirkur wu pama hyi, ca ngǝ njir tǝɗǝmwar hyi wu Thlagǝu, njir lǝ sawara anǝ hyi. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>Hya sǝbiya nda lagur hakǝra nda gagaɗau wu yiwukur arya thlǝrǝr nda. Hya nggya jamǝ wu pam ǝnga kalar ndau. <verse eid="1TH 5:13"/><verse number="14" style="v" sid="1TH 5:14"/>ˈYu tǝɗǝ himiya hyi wazha ama, hya kughiya ndǝr nggya haɗǝwa, ǝnga hya fiya nyi ɗǝfu anǝ njir hivǝr, ǝnga hya dlǝwar nji tutuwa dǝnama, ba ǝnga hya mba ɗǝfu ǝnga kalar ndau. <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>Hya hangǝkal hya sara ki ɗǝmwaˈyikur ǝnga ɗǝmwaˈyikur mai, ama hya dumwa ǝnga mǝnahǝkur cumu anǝ kuvwar hyi ǝnga kalar ndau.<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>Hya nggya ǝnga caguli cumu. <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>Kǝdiya mǝ Hyal gǝra tsǝwa. <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>Hya lǝ usaku anǝ Hyal wu kalar sau, arya ca ngǝ sǝr yiwu huɗa Hyal anǝ hyi wu Kǝrsiti Yesu.<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>Hya sara kakana ndǝr nǝ Mambǝl mai. <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>Hya sara diɗa ndǝrhaha mai. <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>Dzǝgabiya mǝ kalar sau, hya sǝbiya ɓaɓalu sǝra mǝnahǝu. <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>Kwaya mǝ naɗu ara mǝl sǝ ɗǝmwaˈyu.<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>Bǝgǝ Hyal ǝnga kǝrnyi, ndǝr lǝr huɗǝ pǝrtǝu, ja thlǝna hyi cici patǝu. Bǝgǝ mambǝlǝr hyi, ǝnga ɗǝfuwa hyi ǝnga kumǝr dza hyi a nggya gǝra ǝnga vazau baˈanǝ shilar pǝcir shilǝr Thlagǝr mǝn Yesu Kǝrsiti. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>Ndǝra ngga hyi kau, ndǝ tsaˈa miya ɗǝfu ngau, ju nda nyabiya sǝra ji nana.<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>Wazha ama, kǝdiya mǝ Hyal anǝ ˈya. <verse eid="1TH 5:25"/><verse number="26" style="v" sid="1TH 5:26"/>Usara mǝ wazha ama patǝ ǝnga bǝrpǝ dzǝ kǝra cicau. <verse eid="1TH 5:26"/><verse number="27" style="v" sid="1TH 5:27"/>Yu kǝdi hyi ǝnga thlǝmǝr Thlagǝu, hya jigana cama tsǝtsǝfǝ kau anǝ patǝr wazha ama.<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>Bǝgǝ mayiwakur Thlagǝr mǝn Yesu Kǝrsiti ja nggya ǝnga hyi. Amina.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
