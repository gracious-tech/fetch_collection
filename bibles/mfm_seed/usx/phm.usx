<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Margi Tiwi Ənga Tǝm [mfm]</book>
  <para style="h">Fǝlimonu</para>
  <para style="toc3">Fǝl</para>
  <para style="toc2">Fǝlimonu</para>
  <para style="toc1">Tsǝfǝ Nǝ Bulusu Anǝ Fǝlimonu</para>
  <para style="mt2">Cama Tsǝtsǝfǝ Nǝ Bulusu Anǝ</para>
  <para style="mt1">Fǝlimonu</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s">Usa Dzau</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Cama tsǝtsǝfǝ kǝ sara ara Bulusu ndǝra wu fursǝna arya Kǝrsiti Yesu, ǝnga Timathlawusu zamǝr mǝn,</para>
  <para style="b" vid="PHM 1:1"/>
  <para style="p" vid="PHM 1:1">A nda nǝ Fǝlimonu bazhi huɗa mǝn ǝnga ndǝr mǝl thlǝrǝr mǝn, <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ǝnga anǝ kwamǝr mǝn Afiya, ǝnga Archipusu bazhi wu ɓwaɓwatǝr mǝn, ǝnga anǝ daɓǝ dzǝ njir nu kǝra a vǝr kaɓǝ wu ki ngau.<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Bǝgǝ mayiwakur ǝnga huɗǝ pǝrtǝu sara ara Hyal Dǝrmǝn ǝnga Thlagǝr mǝn Yesu Kǝrsiti ja nggya ǝnga hyi.<verse eid="PHM 1:3"/></para>
  <para style="s">Kǝdi Hyal ǝnga Lǝ Usaku</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>Ya vǝr usaku anǝ Hyal cumu kalar pǝcira ya vǝr kǝdi Hyal anǝ ngau, <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>arya a nggar yi ar kǝra mbǝrsa ngau wu Thlagǝ Yesu ǝnga yiwukur ngau anǝ patǝr nji cici gǝ Hyal. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>Ya vǝr kǝdi Hyal aga hya ɗa nǝnǝ wu nggya wu cir zǝmǝr hyi wu mbǝrsa, aga hya nǝbiya dzǝ wu sǝnbiya sǝ wu kalar sǝ mǝnahǝ kǝra mǝn ǝni wu Kǝrsiti. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Yiwukur ngau a nǝ ɗa ri huɗǝ pipida ǝnga tsǝtsǝku ɗǝfu, arya nagau, zamǝ ɗa, a tsǝtsǝkur gǝ ɗǝfuwa nji cici gǝ Hyal.<verse eid="PHM 1:7"/></para>
  <para style="s">Kǝdi Bulusu Arya Onisimusu</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Agabangau, arya kau, a sǝn taˈyi yau wu Kǝrsiti aga ya cuwa ngǝ ga mǝl sǝra kakal ga kyaga mǝl, <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>alaga abangau, ya vǝr kǝdi ngau wu yiwukur. Nayi Bulusu, ndǝra dǝgal hahal ǝnga kabangǝkau ndǝr fursǝna arya Kǝrsiti Yesu, <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ya vǝr kǝdi ngau arya zǝr ɗa Onisimusu, ndǝra ɗa zǝr ɗa ar pǝcira yi wu fursǝna. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>Ɗǝɗǝmǝu, aˈyi ja ndǝr kǝtiya ndǝ mai, ama kabangǝkau, a ɗar ja ndǝr kǝtǝ ma gyapǝ ma.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>Ya vǝr sǝ nyi a ndǝra gau, naja ndǝra wu ɗǝfuwa yau. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>A yiwur yau aga ya sǝɓiya nyi ǝgya yau, aga ja mǝl thlǝr ar viya gau anǝ ɗa, ar pǝcira yi wu fursǝna arya tǝtǝlna ndǝshigu. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>Ama nayu yiwu ya mǝl kalar sǝ ǝnga gǝra hǝnggǝri ngǝ mai, aga kalar mǝnahǝkur kǝra gǝ mǝl ja ɗa sǝ yiwu huɗa gau, aˈyi sǝ caca mai.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>Ma vanyi sǝra ɗa hyi tǝkǝbiya dzǝ ǝnga ja nǝ pǝci kushi kau, aga ga ɓǝra sǝn dlǝwur nyi, hya nggya nǝ baˈanuwa ngau. <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>Ga dlǝwur nyi, aˈyi ar viya mafa mai, ama ar viya sǝra ndiya mafa, ar viya zamǝ kǝra gu yiwu. A yiwu nyir yi gagaɗau, anǝ ngǝ tsu, ga yiwu nyi a ndiya kǝra ya vǝr yiwu nyi, gyapǝ wu ndǝndǝkur ǝnga zamǝ wu Thlagǝu.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Ma gǝ hǝr ɗa ar viya bazhi daɓǝ kǝr, dlǝwur nyi ǝnggǝr kǝra ga dlǝwur ɗa. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>Ma ji mǝliya ngǝ sǝra ɗǝmwaˈyu, alaga ga vǝr nu nyi mǝl nǝ kalar sau, ba ga fǝri a dar kǝra yau. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Nayi Bulusu, nayi nga vǝr tsǝfǝ najaka sau ǝnga tsa yau, yu nda kina ngau, a sara nja na ya vǝr nu ngǝ mǝl nǝ pi nǝ Hyal kǝra gǝ uya lagu ɗa mai. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>Zam ɗa, ya vǝr cim aga ya uya akkǝri ara gau lagu Thlagǝu. Ba ga dzǝgwa pina huɗa yau wu Kǝrsiti. <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>Aˈyi yi ǝnga papakur kǝr ǝnga ɓǝlar sǝ ngau, ca ngǝ ɗa yi tsǝfǝ najaka sau anǝ ngau, ara a sǝnǝr yau, gu nda mǝliya a ndiya kǝra yi nar ngau.<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>Sǝ zǝm kǝra ya vǝr na, ca ngǝ ga fiya ɗa vir pida, ara ya vǝr ɗǝnga abǝr nju shabiya ɗa a shili ara hyi arya kǝdi Hyalǝr hyi.<verse eid="PHM 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>Ipafǝrasu, bazhi fursǝna ɗa arya Kǝrsiti Yesu, ja vǝr usa ngau. <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>Abangǝ tsu Markusu, ǝnga Aristakusu, ǝnga Dimasu, ǝnga Luka bazhi mǝl thlǝr ɗa, nda vǝr usa ngau.<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>Bǝgǝ mayiwakur nǝ Thlagǝ Yesu Kǝrsiti ja nggya ǝnga mambǝlǝr hyi . Amina.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
