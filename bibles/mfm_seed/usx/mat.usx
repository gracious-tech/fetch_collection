<usx version="3.0">
  <book code="MAT" style="id">- Margi Tiwi Ənga Tǝm [mfm]</book>
  <para style="h">Matiwu</para>
  <para style="toc3">Mat</para>
  <para style="toc2">Matiwu</para>
  <para style="toc1">Ndǝshigu Sara Wu Tsa Matiwu</para>
  <para style="mt2">Ndǝshigu Sara Wu Tsa</para>
  <para style="mt1">Matiwu</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">Culi Kǝra Yesu Biya Sara Gwa</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Lǝkakaɗǝ tsǝtsǝfǝ ar kǝra Yesu Kǝrsiti zǝr Dawuda, kǝra tsu zǝr Ibrahimu ngau.<verse eid="MAT 1:1"/></para>
  <para style="p"/>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2"/>Ibrahimu ngǝ yabiya Ishaku,</para>
  <para style="li2" vid="MAT 1:2">kǝ Ishaku yabiya Yakubu,</para>
  <para style="li2" vid="MAT 1:2">kǝ Yakubu yabiya Yahuda ǝnga zamǝ nyiˈyar.<verse eid="MAT 1:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="MAT 1:3"/>Yahuda tsu ngǝ yabiya Parisu ǝnga Zara, kǝra mǝr nda ngǝ Tamaru.</para>
  <para style="li2" vid="MAT 1:3">Parisu ngǝ yabiya Hesaruna,</para>
  <para style="li2" vid="MAT 1:3">kǝ Hesaruna yabiya Aramu,<verse eid="MAT 1:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="MAT 1:4"/>kǝ Aramu yabiya Aminadaɓǝu,</para>
  <para style="li2" vid="MAT 1:4">kǝ Aminadaɓǝu yabiya Nashanu,</para>
  <para style="li2" vid="MAT 1:4">kǝ Nashanu yabiya Salmonu.<verse eid="MAT 1:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="MAT 1:5"/>Salmonu ngǝ yabiya Buˈaza, kǝra mǝnyi ngǝ Rahapǝu.</para>
  <para style="li2" vid="MAT 1:5">Buˈaza ngǝ yabiya Obida, kǝra mǝnyi ngǝ Ruthlu.</para>
  <para style="li2" vid="MAT 1:5">Obida ngǝ yabiya Jesi,<verse eid="MAT 1:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="MAT 1:6"/>ǝnga Jesi ngǝ yabiya tǝl Dawuda.</para>
  <para style="li1" vid="MAT 1:6">Dawuda ngǝ yabiya Solomanu, kǝra mǝnyi ɗǝɗǝmǝ mala Yuraya ngau.<verse eid="MAT 1:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="MAT 1:7"/>Solomanu ngǝ yabiya Rahubwamu,</para>
  <para style="li2" vid="MAT 1:7">kǝ Rahubwamu yabiya Abijanu,</para>
  <para style="li2" vid="MAT 1:7">kǝ Abijanu yabiya Asa,<verse eid="MAT 1:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="MAT 1:8"/>kǝ Asa yabiya Jahwashafatu,</para>
  <para style="li2" vid="MAT 1:8">kǝ Jahwashafatu yabiya Jahwaramu,</para>
  <para style="li2" vid="MAT 1:8">kǝ Jahwaramu yabiya Uziya.<verse eid="MAT 1:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="MAT 1:9"/>Uziya ngǝ yabiya Jothlamu,</para>
  <para style="li2" vid="MAT 1:9">kǝ Jothlamu yabiya Ahazu,</para>
  <para style="li2" vid="MAT 1:9">kǝ Ahazu yabiya Hezikaya,<verse eid="MAT 1:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="MAT 1:10"/>kǝ Hezikaya yabiya Manasa,</para>
  <para style="li2" vid="MAT 1:10">kǝ Manasa yabiya Amonu,</para>
  <para style="li2" vid="MAT 1:10">kǝ Amonu yabiya Josaya,<verse eid="MAT 1:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="MAT 1:11"/>ǝnga Josaya ngǝ yabiya Jakoniya ǝnga zamǝ nyiˈyar. Ar pǝci kǝra nji faˈar nda a vu mafakur a vu ˈyiˈyir Babilanu.<verse eid="MAT 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12"/>Ayukuɗa nji faˈar nda a vu Babilanu,</para>
  <para style="li2" vid="MAT 1:12">kǝ Jakoniya yabiya Shaltiyalu,</para>
  <para style="li2" vid="MAT 1:12">kǝ Shaltiyalu yabiya Zarubabelu,<verse eid="MAT 1:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="MAT 1:13"/>kǝ Zarubabelu yabiya Abiyadu,</para>
  <para style="li2" vid="MAT 1:13">kǝ Abiyadu yabiya Eliyakimu,</para>
  <para style="li2" vid="MAT 1:13">kǝ Eliyakimu yabiya Azoru.<verse eid="MAT 1:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="MAT 1:14"/>Azoru ngǝ yabiya Zadoku,</para>
  <para style="li2" vid="MAT 1:14">kǝ Zadoku yabiya Akimu,</para>
  <para style="li2" vid="MAT 1:14">kǝ Akimu yabiya Eludu,<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>kǝ Eludu yabiya Eliyaza,</para>
  <para style="li2" vid="MAT 1:15">kǝ Eliyaza yabiya Matanu,</para>
  <para style="li2" vid="MAT 1:15">kǝ Matanu yabiya Yakubu,<verse eid="MAT 1:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="MAT 1:16"/>ǝnga Yakubu ngǝ yabiya Yusufu, saliya Maryamu, mala kǝra yabiya Yesu, ndǝra nju ngga ǝnga Kǝrsiti.<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Abangǝ ngǝ patǝkura zamana nyiˈyar, dzǝgwar Ibrahimu baˈanǝ Dawuda zaman kumo apǝ foɗǝu, dzǝgwar Dawuda baˈanǝ mafakur wu ˈyiˈyir Babilanu zaman kumo apǝ foɗǝu, dzǝgwar mafakur wu ˈyiˈyir Babilanu baˈanǝ shilǝr Kǝrsiti zaman kumo apǝ foɗǝu.<verse eid="MAT 1:17"/></para>
  <para style="s1">Yar Yesu Kǝrsiti</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luka 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Kǝja ǝnggǝra nji ya Yesu Kǝrsiti. Mǝnyi kǝra nju ngga ǝnga Maryamu a mbiyari alkawal nǝ hǝdzǝ ǝnga Yusufu. Ama kadivira nda hǝrdzau, ba nji thlǝwa nyi ǝnga huɗǝ sara ara Mambǝl Cicau. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Ara sal mǝmba nyi Yusufu ndǝ tsapǝ ngau ǝnga ǝtsu naju yiwu ja hǝna sǝli nyi wu pama nji mai, kǝ ji gwu ɗǝnga lagu kǝra ja sǝn sǝya nyi ɗǝɗǝwa.<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>Ama tsu ju ɗǝnga sǝ kau, kǝ waladi Thlagǝ cabiya nyi kǝr wu shuni. Ji na anǝ nyi, “Yusufu zǝr Dawuda, a sara ga hivǝr hǝ Maryamu aga ja ɗa mala ngǝ mai, ara huɗǝ kǝra ara ja sara ara Mambǝl Cici nga nyi. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Ju nda yabiya zǝr sal, ba ga fiya nyi thlǝmǝ Yesu, arya ju nda mbǝɗana nji gǝ nda sara ara bikǝr nda.”<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Patǝkura sǝˈyar kǝ ɗarkǝr aga ja nyabiya sǝra Thlagǝ nana lagu miya nabi abǝr, <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>“Kwapǝliyagǝ kǝra gǝra sǝn ndǝ sal, wu nda hǝr huɗǝu, ju nda yabiya zǝsal, nju nda fiya nyi thlǝmǝ Emanuwelu,” kǝra ca ngǝ, “Hyal ǝnga mǝn.”<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Ənggǝra Yusufu hyaˈari sara wu ghanyi, kǝ ji mǝliya sǝra waladi Thlagǝ nar nyi ja mǝl, ca ngǝ, ba ji hǝri Maryamu aga mala nyi. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Ama nandǝ nggya ndǝ sal ǝnga mala mai, kǝl ayukuɗa ji yabiya zǝr nyi. Ba Yusufu fiya nyi thlǝmǝ Yesu.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Njir Sǝn Sau Sara Wu Sǝbiyar Pǝci <optbreak/> Sa Tula Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Ayukuɗa nji yabiya Yesu wu mǝlmǝ Bayitalahami wu ˈyiˈyir Yahudi, ar pǝcir tǝlkur nǝ Hirudusu, kǝ alenyi njir sǝn sau ar kǝra shashilga sara wu Sǝbiyar Pǝci shili wu Urshalima, ndǝ sa yiwa, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“Əmani ngǝ tǝl mafǝliyangǝ nǝ njir Yahudiya kǝra nji yabiya ka? Arya ˈyi lari shashilga nyi wu Sǝbiyar Pǝci, ca nga, ˈyi shili aga ˈya sa dlǝvǝ nyi.” <verse eid="MAT 2:2"/><verse number="3" style="v" sid="MAT 2:3"/>Ənggǝra tǝl Hirudusu nggari sǝ kau, kǝ hangǝkal nyi hyaˈari, abangǝ tsu ngǝ patǝkura njir Urshalima. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Kǝ ji nggari patǝr pubu dǝdǝgalˈyar ǝnga malǝmǝ dlaɗǝˈyar, ji yiwa nda vira nju nda ya Kǝrsiti ari. <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>Ndǝ na anǝ nyi, “Wu mǝlmǝ Bayitalahami ngau, wu ˈyiˈyir Yahudi, ara abangǝ ngǝ sǝra nabi tsǝfǝri:<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>“ ‘Nagǝ Bayitalahami wu ˈyiˈyir Yahudi,</para>
  <para style="q2" vid="MAT 2:6">aˈyi nagǝ nga ndiya ǝnga kushu</para>
  <para style="q2" vid="MAT 2:6">wu pama njir sǝm tǝlkur nǝ Yahudi mai.</para>
  <para style="q1" vid="MAT 2:6">Ara sara wu gǝ ngǝ vanyi ndǝr</para>
  <para style="q2" vid="MAT 2:6">sǝm tǝlkur wu sǝbiya,</para>
  <para style="q1" vid="MAT 2:6">ndǝra wu nda tǝɗǝmwa</para>
  <para style="q2" vid="MAT 2:6">anǝ nji ɗa njir Izirayila.’ ”<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Kǝ Hirudusu nggar njir sǝn sǝ kǝ ɗǝɗǝwa aga ja sǝnbiya kakalǝ pǝci kǝra ndǝ lari shashilga nyi. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Kǝ ji sǝwa nda a vu Bayitalahami, ji na, “Maˈya mau hya vuwa zhigǝɗǝbiya ɗa ar kǝra zǝr kǝ ǝnga hangǝkal. Ma hya nǝr nyi ri, hya sha shili hya sa nar ɗa, aga nayi tsu, ya sa maˈyi ya vuwa dlǝvǝ nyi.”<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Ayukuɗa ndǝ nggari sǝra tǝl nana, ba ndǝ gwu lagu ndu maˈyi. Shashilga kǝra ndǝ lari wu Sǝbiyar Pǝci ta, ɓǝ wu mwar nda ǝnga ndu nu nyi kǝl ta ji sa taˈyi ar vira zǝra nyi ari. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Ar pǝci kǝra ndǝ lari shashilga kau ba ndǝ nyau ǝnga huɗǝ pipida gagaɗau. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Ənggǝra ndǝ vu kiya nyi ba ndǝ vuwa lar zǝr kau ǝnga mǝnyi Maryamu. Ndǝ vuwa ɓǝliya undi wu mwa nyi, ndǝ dlǝvǝ nyi. Ənggau kǝ ndǝ pahǝna mbǝlǝr nda, ba ndǝ nǝ nyi ǝndzau ǝnga ɓurdi dǝdǝgǝ kǝra nju ɗǝzau ba ǝnga ɓurdi dza wu. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Ndǝ sha a ndu ˈyiˈyir nda vanyi lagu pamǝu, ara Hyal kughiya nda wu shuni a sara nda sha a ndǝgya Hirudusu mai.<verse eid="MAT 2:12"/></para>
  <para style="s1">Yusufu Ənga Maryamu Hwi Ənga Zǝr Nyi<optbreak/> A Vu ˈYiˈyir Masaru</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Ayukuɗa ndǝ maˈyi, kǝ waladi Thlagǝ canǝ nyi kǝr anǝ Yusufu wu shuni, ji na, “Hyaˈari, ga hǝr zǝr kau ǝnga mǝnyi hya nggwaɗǝnakǝr ǝnga ja a vu ˈyiˈyir Masaru. Hya vuwa nggya a vuna, kǝl yi nda nar hyi hya sha shili, ara Hirudusu a vǝr gal zǝra nyi, ju yiwu ja tsǝya nyi.” <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>Kǝ Yusufu hyaˈari, ji hǝri zǝra nyi ǝnga mǝnyi ǝvuˈyi, ba ndǝ maˈyi a vu ˈyiˈyir Masaru. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Ji vuwa nggya a vuna kǝl ta Hirudusu tau. Najakǝ tsu ɗarkǝr aga nyabiya sǝra Thlagǝ nana lagu miya nabi abǝr, “Sara wu Masaru nga yi nggar zǝr ɗa.” <verse eid="MAT 2:15"/><verse number="16" style="v" sid="MAT 2:16"/>Ənggǝra Hirudusu nggari abǝr njir sǝn sǝ ka shanggǝr nyi ri kǝr, ba ɗǝfuwa ja ndzǝ gagaɗau. Ba ji sǝwa aga nja dlǝdlǝna patǝr wazha shili kǝra wu Bayitalahami ǝnga ˈyiˈyi kǝra zǝwar nyi, mbari wazha fa mǝthlǝ baˈanǝ kǝra a gya banga nda, kakalǝ ǝnga pǝci kǝra njir sǝn sǝ ta na anǝ nyi ar kǝra yar zǝr ta. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Ar pǝci kǝ nga nji nyabiya sǝra nabi Irimiya nana, abǝr,<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>“Nji nggar ɗahǝ wu Rama,</para>
  <para style="q2" vid="MAT 2:18">a vǝr tiwi ǝnga huɗǝ ndzǝndzǝ gagaɗau,</para>
  <para style="q1" vid="MAT 2:18">Rahila nga vǝr tiwi arya wazha nyi,</para>
  <para style="q2" vid="MAT 2:18">ji tini mbiya ɗǝfu ara ǝnggǝra</para>
  <para style="q2" vid="MAT 2:18">nji dlǝna wazha nyi.”<verse eid="MAT 2:18"/></para>
  <para style="s1">Sha Sara Wu Masaru A Vu Nazǝratu</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Ayukuɗa tǝr Hirudusu, kǝ waladi Thlagǝ canǝ nyi kǝr anǝ Yusufu wu shuni wu Masaru, ji na, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“Ga hyaˈari, ga hǝri zǝr kau ǝnga mǝnyi ga sha ǝnga nda a vu ˈyiˈyir Izirayila, ara njira vǝr gal aga nda tsǝya zǝr kau, a kuɗǝr nda.” <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>Kǝ ji hyaˈari, ji hǝri zǝra nyi daɓǝ ǝnga mǝnyi ba ndǝ maˈyi a vu ˈyiˈyir Izirayila.<verse eid="MAT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22"/>Ama ǝnggǝra ji nggari abǝr Arkilayusu nga vǝr sǝm tǝlkur wu ˈyiˈyir Yahudi ar viya dǝnyi Hirudusu ba hivǝr mbari nyi ara vwau. Ənggǝra nji kughiya nyi wu shuni, kǝ ji sha a vu ˈyiˈyir Galili. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Kǝ ji maˈyi ji vuwa nggya wu vanyi mǝlmǝ kǝra nju ngga ǝnga Nazǝratu, aga nja nyabiya sǝra nabiˈyar nana, abǝr, “Nju nda ngga nyi ndǝr Nazǝratu.”<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Tǝtǝlna Ndǝr Hyal Nǝ Yahwana <optbreak/> Ndǝr Mǝl Baɓǝtizǝma</para>
  <para style="r">(<ref loc="MRK 1:1-8">Markusu 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>; <ref loc="JHN 1:9-28">Yahwana 1:9-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Ayukuɗa fa gangǝ tǝrabiya, ngǝ Yahwana ndǝr mǝl Baɓǝtizǝma shili, ja vǝr tǝtǝlna ndǝr Hyal ar tagǝ nǝ ˈyiˈyir Yahudi, <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>ju na, “Hya tubi, ara tǝlkur Hyal a ɗari lǝhǝu.” <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Naja ngǝ ndǝra nabi Əshaya ndǝr ar kǝri, ji na,</para>
  <para style="q1" vid="MAT 3:3">“Ɗahǝ a vǝr ngga a gwar tagǝu,</para>
  <para style="q2" vid="MAT 3:3">ja vǝr na,</para>
  <para style="q1" vid="MAT 3:3">‘Hya pabǝri nyi lagu anǝ Thlagǝu,</para>
  <para style="q2" vid="MAT 3:3">hya mǝliya lagu tataˈyi pir</para>
  <para style="q2" vid="MAT 3:3">wu mwa nyi.’ ”<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Lǝgutǝ ha nǝ Yahwana ǝnga shisha dlǝgwam nga nji mǝliya. Sǝr mba sar nyi ca ngǝ takulagǝ ci. Sǝr sǝm nyi tsu ca ngǝ ndzǝkwa ǝnga ˈyimir ciɗi tagǝu. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Njira maˈyi a ndǝgya ja nji sara wu Urshalima ngau ǝnga patǝr ˈyiˈyir Yahudi ǝnga patǝkura ˈyiˈyir dǝl Urdǝnu. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Ndu nana bikǝr nda, kǝ ji mǝliya nda baɓǝtizǝma wu dǝl Urdǝnu.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Ama ǝnggǝra Yahwana lari njir Farisi ǝnga njir Sadusi gangǝu, a vǝr shili aga ja sa mǝliya nda baɓǝtizǝma, kǝ ji na anǝ nda, “Nahyi wazha mǝtsapa! Wa ngǝ kughiya hyi, aga hya hwi sara ara numa nǝ huɗǝ ndzǝndzǝ Hyal kǝra a vǝr shili ka? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Hya mǝl thlǝr kǝra mǝnahǝu wu nggyabiyar hyi kǝra wu cabiya abǝr a tubir hyi. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>A sara hya fiya wu ɗǝfuwa hyi tsu, abǝr, ‘Ibrahimu ngǝ dǝrˈya.’ Yu na anǝ hyi, abǝr Hyal aˈyi ja ǝnga dǝnama nǝ shabiya tsǝkaˈyar kau, aga wazha anǝ Ibrahimu. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>A fiyar nji hira kǝm ar nggyilanga wu. Kalar wu kǝra gǝra pǝ wazha mǝnahǝu, nju nda gǝmna nyi ba nja vakuwa nyi a gwu uˈu.<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“Nayau, ya vǝr mǝl baɓǝtizǝma anǝ hyi ǝnga ˈyimi kǝra wu cabiya abǝr a tubir hyi. Ama ndǝra wu ndiya ɗa ǝnga dǝgalǝu, wu shili wu yukuɗǝ ɗa, ndǝra alaga ɓiɓi nyi nayi aˈyi yi ɗa tsaˈa aga ya hǝ mai. Ju sa mǝliya hyi baɓǝtizǝma ǝnga Mambǝl Cicau ba ǝnga uˈu. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Cala pi nyi wu tsa ja nga nyi, ju pina uhi ba ja tsǝkǝna lara nyi ba ja dzǝgwa faˈana uhi a su tsam. Ama kufu ǝnga cacangǝ ba ja nggyina nda ǝnga uˈu kǝra gǝra tau.”<verse eid="MAT 3:12"/></para>
  <para style="s1">Yahwana Hǝr Nyi Baɓǝtizǝma Anǝ Yesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Markusu 1:9-11</ref>; <ref loc="LUK 3:21-22">Luka 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Ar pǝci kǝ ngǝ Yesu shili sara wu Galili, ji maˈyi a gwu dǝl Urdǝnu aga Yahwana a gwa hǝr nyi baɓǝtizǝma. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Ama Yahwana wu yiwu ja kari nyi, ju na, “Nayi kǝra lari a ɗari tsaˈa ga hǝr ɗa baɓǝtizǝma, abari nga gu sǝn shili ara ya?”<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Ama kǝ Yesu shaɗǝwa nyi, ji na, “Bǝgǝ ja ɗa abangǝ kabangǝkau, kakalǝ nga nyi anǝ mǝn mǝna mǝl abangau, aga mǝna nyabiya sǝra tsaˈa.” Ənggau, kǝ Yahwana hǝnggǝri, ba ji hǝr nyi baɓǝtizǝma.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Ənggǝra Yahwana hǝr nyi baɓǝtizǝma anǝ Yesu, kǝ ji biya sara wu ˈyimiya nyi. Ar pǝci ta, kǝ dǝmǝlmǝ pahau, ba ji lari Mambǝl Hyal a vǝr shida a papa mbǝthla, ka sa ndzafau ar ja. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Kǝ ɗahǝ sara dǝmǝlmǝ na, “Najakǝ zǝr ɗa ngau, yu yiwu nyi, huɗa yi pipida ǝnga ja.”<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">Shatan Dzǝbiya Yesu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Markusu 1:12-13</ref>; <ref loc="LUK 4:1-13">Luka 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Kǝ Mambǝl Cici lǝbiya Yesu a gwar tagǝu, aga shatan a gwa dzǝbiya nyi. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Ayukuɗa Yesu hǝr zǝmǝtsini nǝ pida foɗǝ kumunyi vuˈyi ǝnga pǝci, kǝ wuɓǝ mbari nyi. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Kǝ shatan shili ji sa na anǝ nyi, “Ma nagǝ ngǝ zǝr Hyal, ga nar nyi anǝ tsǝkaˈyar kau, aga nda sha aga macikǝl.”<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Kǝ Yesu shaɗǝwa, ji na, “Tsǝtsǝfǝ nga nyi wu ndǝr Hyal abǝr,</para>
  <para style="q1" vid="MAT 4:4">‘Aˈyi ǝnga sǝr sǝm wacu ngǝ ndǝ</para>
  <para style="q2" vid="MAT 4:4">wu nggya ǝnga pi mai,</para>
  <para style="q1" vid="MAT 4:4">ama ǝnga kalar ndǝr kǝra wu biya</para>
  <para style="q2" vid="MAT 4:4">sara wu miya Hyal.’ ”<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Kǝ shatan hǝri nyi a vu Urshalima mǝlmǝ cicau ba ji hǝri nyi a dar kǝra ki Hyal a dar vira ndiya ǝnga dzǝgamǝu. <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>Kǝ ji na anǝ nyi, “Ma nagǝ ngǝ zǝr Hyal, ga vǝl a gyiwu ˈyi sara ǝnggau, arya tsǝtsǝfǝ nga nyi:</para>
  <para style="q1" vid="MAT 4:6">“ ‘Ju sǝwa waladi nyiˈyar</para>
  <para style="q2" vid="MAT 4:6">aga nda ɓǝlar ngau.</para>
  <para style="q1" vid="MAT 4:6">Ndu sǝɓiya ngǝ wu tsa nda</para>
  <para style="q2" vid="MAT 4:6">ara ga sara dǝgǝri hiya gǝ ar tsǝka.’ ”<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Kǝ Yesu na anǝ nyi, “Tsǝtsǝfǝ nga nyi tsu, abǝr, ‘Ga sara dzǝ Hyal Thlagǝ ngǝ mai!’ ”<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Kǝ shatan ɓǝra hǝri nyi a dar kǝra vanyi mǝ kǝra dzǝgamǝ gagaɗau, kǝ ji canǝ nyi patǝkura tǝlkur nǝ duniya ǝnga kadakadarkur nda. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>Kǝ ji na anǝ nyi, “Patǝkura sǝˈyar kǝ yu nǝ ngau, ma gǝ ɓǝliya ɗa undi ba ga dlǝvǝ ɗa.”<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Kǝ Yesu na anǝ nyi, “Kwaya wu dzǝr ɗa shatan! Arya tsǝtsǝfǝ nga nyi:</para>
  <para style="q1" vid="MAT 4:10">‘Ga dlǝvǝ Hyal Thlagǝ ngau,</para>
  <para style="q2" vid="MAT 4:10">ǝnga anǝ nyi zhizhi nyi nga ga mǝl thlǝr wacu.’ ”<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Ənggau, kǝ shatan piyari nyi, ba waladiˈyar shili ndǝ sa dlǝwar nyi.<verse eid="MAT 4:11"/></para>
  <para style="s1">Yesu Dzǝguya Tǝtǝlna Ndǝr Hyal</para>
  <para style="r">(<ref loc="MRK 1:14-15">Markusu 1:14-15</ref>; <ref loc="LUK 4:14-15">Luka 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Ənggǝra Yesu nggari abǝr a fuwar nji Yahwana wu fursǝna, ba ji sha a vu Galili. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Ji piyari Nazǝratu ba ji maˈyi a vuwa nggya wu mǝlmǝ Kafarnahumu, kǝra a miya dǝl, kǝra wu kǝla ˈyiˈyir Zabulanu ǝnga Nafǝtali, <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>aga ja nyabiya sǝra nabi Əshaya nana:<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“ˈYiˈyir Zabulanu ǝnga ˈyiˈyir Nafǝtali,</para>
  <para style="q2" vid="MAT 4:15">lagur gwu dǝl,</para>
  <para style="q1" vid="MAT 4:15">a biyar ya dǝl Urdǝnu,</para>
  <para style="q2" vid="MAT 4:15">ǝnga Galili nǝ nji kǝra aˈyi</para>
  <para style="q2" vid="MAT 4:15">njir Yahudiya mai,<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>njira vǝr nggya wu kuthlǝu</para>
  <para style="q2" vid="MAT 4:16">a lar nda mbǝmbǝl kǝra dǝgal gagaɗau.</para>
  <para style="q1" vid="MAT 4:16">Njira a vǝr nggya ar ˈyiˈyi nǝ</para>
  <para style="q2" vid="MAT 4:16">shangguɗa tǝ tsu</para>
  <para style="q1" vid="MAT 4:16">mbǝmbǝl a shiliri anǝ nda.”<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Mbari ar pǝci ta, ngǝ Yesu dzǝguya tǝtǝlna ndǝr Hyal, ju na, “Hya tubi ara tǝlkur Hyal a ɗari lǝhǝu.”<verse eid="MAT 4:17"/></para>
  <para style="s1">Yesu Ngga Zǝmbǝlma Nyiˈyar <optbreak/> Nǝ Tanggǝrma</para>
  <para style="r">(<ref loc="MRK 1:16-20">Markusu 1:16-20</ref>; <ref loc="LUK 5:1-11">Luka 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Ənggǝra Yesu a vǝr tǝrabiya ar thlǝrpa dǝl Galili, ba ji lari ndǝ ǝnga zamǝ nyi, Simanu kǝra nju ngga ǝnga Biturusu ǝnga zamǝ nyi Andǝrawusu. Nda vǝr sǝ litagǝr nda a gwar dǝl, ara nanda njir tǝm ngau. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Əngwar Yesu anǝ nda, “Anda mau, hya nu ɗa, aga ya shabiya hyi hya ɗa njir tǝm nji.” <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Ənggǝrna, kǝ ndǝ piyari litagǝr nda ba ndǝ nu nyi.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Ənggǝra ji ɓar dzǝ a dumwa kushu, kǝ ji ɓǝra lar vanyi ndǝ ǝnga zamǝ nyi tsu, nanda ngǝ Yakubu zǝr Zabadi ǝnga Yahwana zamǝ nyi. Wu kwambwal nga nda ǝkkǝˈyi dǝrnda Zabadi, nda vǝr ɓathlǝ litagǝr nda. Kǝ Yesu ngga nda. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Ənggǝrna, kǝ ndǝ piyari kwambwalǝr nda ba dǝrnda, ba ndǝ nu nyi.<verse eid="MAT 4:22"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Nji</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luka 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Yesu ɓǝbiya ɓau wu patǝr ˈyiˈyir Galili, ja vǝr highiɓǝ wu umbwa daɓǝ dzǝˈyar, ja vǝr tǝtǝlna ndǝshigu ar kǝra tǝlkur Hyal. Ba ǝnga ja vǝr shilǝgǝbiya shilǝgǝu pampamǝu, ǝnga gǝra ngga pampamǝu. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Ndǝr ar kǝra ja tǝtǝlnakǝr a ndu ˈyiˈyir Sǝriya patǝu. Nji hǝri nyi a shili patǝr njira ǝnga shilǝgǝ pamǝpamǝu ǝnga njira wu ɓwaɓwatǝ gagaɗau ǝnga njira shatan fǝnggǝr nda ɓwaɓwatǝu ǝnga njira sǝ tsatsa wu tǝ nda ǝnga njir tǝsǝkǝnǝu, ba ji shilǝgǝbiya nda. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Dlamir nji gangǝ sara wu ˈyiˈyi Galili ǝnga tsu nji sara wu ˈyiˈyi Dikapulusu ǝnga sara wu Urshalima ǝnga ˈyiˈyir Yahudi, tsaˈa a biya banga dǝl nǝ Urdǝnu nu nyi.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Tǝtǝlna Ndǝr Hyal A Dar Kǝra Mau</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Ənggǝra Yesu lari dlamir nji, kǝ ji maˈyi a dar kǝra mau, kǝ ji nda nggya gya. Ba zǝmbǝlma nyiˈyar shili ǝgya ja.<verse eid="MAT 5:1"/></para>
  <para style="s1">Barka</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luka 6:20-23</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 5:2"/>Kǝ ji dzǝguya highiɓau, ju na,<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>“Barka anǝ njira</para>
  <para style="q2" vid="MAT 5:3">tǝtǝwa wu mambǝl,</para>
  <para style="q2" vid="MAT 5:3">ara tǝlkur Hyal nǝr nda ngau.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Barka anǝ njira</para>
  <para style="q2" vid="MAT 5:4">wu sǝˈyinggu,</para>
  <para style="q1" vid="MAT 5:4">ara nju nda pǝli anǝ nda.<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Barka anǝ njira tina kǝr,</para>
  <para style="q2" vid="MAT 5:5">ara ndu nda</para>
  <para style="q1" vid="MAT 5:5">faˈabiya ki ǝnga duniya.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Barka anǝ njira</para>
  <para style="q2" vid="MAT 5:6">ǝnga wuɓau ǝnga hilir nggya tsapǝu,</para>
  <para style="q1" vid="MAT 5:6">ara nju nda nyabiya nda.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Barka anǝ njira</para>
  <para style="q2" vid="MAT 5:7">ǝnga tǝhuɗǝu,</para>
  <para style="q1" vid="MAT 5:7">arya nanda nju</para>
  <para style="q2" vid="MAT 5:7">nda tǝhuɗǝ ǝgya nda.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Barka anǝ njira</para>
  <para style="q2" vid="MAT 5:8">ɗǝfuwa nda cicau,</para>
  <para style="q1" vid="MAT 5:8">arya ndu nda lari Hyal.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Barka anǝ njira</para>
  <para style="q2" vid="MAT 5:9">mǝl thlǝr aga nggya jamǝu,</para>
  <para style="q1" vid="MAT 5:9">arya nju nda ngga nda</para>
  <para style="q2" vid="MAT 5:9">ǝnga wazha Hyal.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Barka anǝ njira</para>
  <para style="q2" vid="MAT 5:10">nju ɗa nda</para>
  <para style="q1" vid="MAT 5:10">arya mǝl sǝra tsapǝu,</para>
  <para style="q2" vid="MAT 5:10">ara tǝlkur Hyal nǝr nda ngau.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>“Barka anǝ hyi ma nji nggǝl hyi, nji ɗa hyi ǝnga thla fati nǝ kurthlǝu ǝnga na patǝr sǝ ɗǝmwaˈyi ar kǝra hyi arya yau. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Hya caguli ǝnga hya nggya ǝnga huɗǝ pǝrtǝ ara hyu nda uya akkǝri gangǝ a dǝmǝlmau, arya abangǝ nga nji ɗa nabiˈyar kǝra tǝrabiya tsu.<verse eid="MAT 5:12"/></para>
  <para style="s1">Unau Ənga Mbǝmbǝl</para>
  <para style="r">(<ref loc="MRK 9:50">Markusu 9:50</ref>; <ref loc="LUK 14:34-35">Luka 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>“Nahyi ngǝ unau nǝ duniya. Ama ma unǝ caɓǝnakǝr, abar nga ju sǝn shabiya kǝrnyi a shila? Tsu ja sǝn ɗa mǝnahǝ mai, kǝl ba nja vakana nyi a biya ba nja biya cicina nyi.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>“Nahyi mbǝmbǝl nǝ duniya ngau. Mǝlmǝ kǝra a dar madzigam a sǝn ɗǝwanakǝr mai. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Nja sǝn mbǝbiya pitǝlla ba nja mbuya ǝgya kiɗa tǝm mai. Ama nja kyaga fiya a dar madzigam, ba ja dzǝgwa mbǝl anǝ kalar ndǝ kǝra a vu ki kau. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Abangǝ tsu, bǝgǝ mbǝmbǝlǝr hyi a mbǝl a dumwar nji, aga nda lari mǝnahǝkura thlǝrǝr hyi ba nda dzǝgwa dlǝvǝ dǝr hyi kǝra a dǝmǝlmau.<verse eid="MAT 5:16"/></para>
  <para style="s1">Highiɓau Ar Kǝra Dlaɗau</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>“A sara hya ɗǝnga abǝr yi shili aga ya sa dazhina highiɓǝ nǝ dlaɗǝ Musa ǝnga highiɓǝ nǝ nabiˈyar mai. Nayi shili aga ya sa dazhina nda mai ama aga ya sa nyabiya nda. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Ya nar hyi jiri, divira dǝmǝlmau ǝnga gyuˈyi a sanakǝr, alaga sǝ ǝnggǝr camwaɗi ba alaga sǝ kushu ǝnggǝr tsǝfǝ tafǝu, aˈyi wu nda sa wu dlaɗǝ nǝ Musa mai, kǝl kalar sǝ nyabiya dzau. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Kalar ndǝ kǝra gǝra ɓǝlari pathlǝ wu kusha dlaɗǝˈyar kau ǝnga ji highiɓǝ anǝ alenyi nji aga nda mǝl abangǝ ngau, nju nda ngga nda njira kushu wu tǝlkur Hyal. Abangǝ tsu, kalar ndǝra wu mǝl thlǝr ǝnga dlaɗǝˈyar kau ǝnga ju highiɓǝ anǝ nji, ju nda ɗa dǝgal wu tǝlkur Hyal. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Ya nar hyi jiri, ma tsapǝkur hyi aˈyi ndiya nǝ njir Farisi ǝnga nǝ malǝmǝ dlaɗǝˈyar mai, nahyi wu sǝn gwu tǝlkur Hyal mai.<verse eid="MAT 5:20"/></para>
  <para style="s1">Highiɓau Ar Kǝra Ndzǝ Ɗǝfu Ənga Ndau</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luka 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>“A nggari hyi ǝnggǝra nji na anǝ nji ɗǝɗǝmǝ, abǝr, ‘A sara hya tsa ndǝ mai ǝnga kalar ndǝra tsǝya ndau, nju nda mǝl numa anǝ nyi.’ <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Ama yu na anǝ hyi, abǝr kalar ndǝra ɗǝfu ǝnga zamǝ nyi, nju nda mǝl numa anǝ nyi. Ətsu, kalar ndǝr na anǝ zamǝ nyi, ‘Sǝ nga gǝ mai,’ ba nja hǝri nyi a dumwar njir pathla. Ama kalar ndǝra na anǝ zamǝ nyi ‘Nagǝ dza,’ a ɗar ja tsaˈa aga gwu uˈur kǝtsa.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>“Agabangau, ma ga vǝr lǝ sǝ a dumwar Hyal ba gǝ ɗǝngari abǝr huɗa zamǝ ngǝ ndzǝndzǝ nga nyi ǝnga gau, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ba ga fiya sǝr lǝ ngau, a dumwar Hyal kwatahǝu. Ba ga maˈyi, ga nda ɓasǝwa ǝnga zamǝ ngau, ǝnggau, ba ga dzǝgwa shili ga sa lǝri sǝr lǝ ngau.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>“Ma ndǝ wulana ngǝ a ndumwar pathla, hya ɓasǝwa ǝnga ja tsu hyar lagu, aˈyi abangǝ mai, ba ja fuwa ngau a gu tsa ndǝr pathla, ba ndǝr pathla tsu a fuwa ngau a gu tsa dǝgala ndǝr fursǝna, ndǝr fursǝna tsu ba ja fuwa ngau a gu fursǝna. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Ya nar ngǝ jiri, nagǝ wu biya mai, kǝl gǝ kina patǝr sǝra nju nu ngau.<verse eid="MAT 5:26"/></para>
  <para style="s1">Highiɓau Ar Kǝra Sǝsukur</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>“A nggari hyi ǝnggǝra nji na anǝ nda, abǝr, ‘A sara hya mǝl sǝsukur mai.’ <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Ama sǝra yu na anǝ hyi, ca ngǝ, ma ndǝ tsamǝ mala ǝnga ɗǝfu nǝ cim mǝl sǝsukur ǝnga ja, ja sǝni abǝr, a pidar ja ǝnga ja wu ɗǝfuwa ja. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Ma liya gǝ nǝ mazǝm, wu sǝwa ngǝ aga ga mǝl bikau, ga tǝkuɗǝbiya nyi, ba ga sǝna nyi. Kuji ga tini pathlǝ wu pama dza gau, a ndiya dza gǝ patǝ a gwu uˈur kǝtsa. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Ma pǝla gǝ nǝ mazǝm, wu sǝwa ngǝ aga ga mǝl bikau, gǝmna ba ga vakana nyi. Kuji ga tini pathlǝ wu pama gashal dza gau, a ndiya dza gǝ patǝ a gu uˈur kǝtsa.<verse eid="MAT 5:30"/></para>
  <para style="s1">Highiɓau Ar Kǝra Kǝdlǝ Mala</para>
  <para style="r">(<ref loc="MAT 19:9">Matiwu 19:9</ref>; <ref loc="MRK 10:11-12">Markusu 10:11-12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>“A nar ndar nji tsu kaɗǝu, abǝr, ‘Kalar ndǝra kǝdlǝna mala nyi, a ɗar tsaˈa sal ja nǝ nyi lǝkakaɗǝ nǝ sakida kǝdlau.’ <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Ama yu na anǝ hyi, kalar ndǝra kǝdlǝna mala nyi, ma aˈyi ara nji mbar nyi a vǝr dlǝnga sal mai, a sǝwa nyir ja aga ja mǝl sǝsukur. Ətsu, kalar ndǝra hǝri mala kǝra nji kǝdlǝna, a ɗar ja ndǝ sǝsu.<verse eid="MAT 5:32"/></para>
  <para style="s1">Highiɓau Ar Kǝra Sǝm Fǝla</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>“Ətsu, a nggari hyi nji na anǝ nji ɗǝɗǝmǝu, abǝr, ‘A sara hya sǝm fǝla ar kǝra fati mai, ama hya nyabiya alkawal kǝra hyi mǝliya nyi anǝ Thlagǝu.’ <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Ama yu na anǝ hyi, A sara hya sǝm fǝla mai, alaga ǝnga dǝmǝlmau ara vir nggya Hyal ngau, <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>alaga ǝnga duniya, ara vir fǝ hiya ja ngau, alaga ǝnga Urshalima, ara mǝlmǝ Tǝl dǝgal ngau. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Ənga tsu a sara ga sǝm fǝla ǝnga kǝra gǝ mai, ara naga sǝn shabiya zǝma shisha gau, ja sha aga pǝrtǝu ǝnga alaga kiyakiyar mai. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Sǝra hya kyaga na, ca ngǝ, ‘Angǝ’ ja ɗa ‘Angǝ’ ǝnga ‘Awau’ ja ɗa ‘Awau.’ Kalar sǝra a biya banga kau, sara ara shatan nga nyi shili.<verse eid="MAT 5:37"/></para>
  <para style="s1">Highiɓau Ar Kǝra Kiyi Sau</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luka 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>“A nggari hyi ǝnggǝra nji na anǝ nda ɗǝɗǝmǝu, ‘Li ar viya li, hir tsu ar viya hir.’ <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Ama sǝra yu na anǝ hyi, ca ngǝ, a sara hya ka ndǝ ja sara ɗiya hyi mai. Ma ndǝ nǝ ngǝ tsǝbalma ar balma mazǝma gau, ba ga shabiya nyi zǝma nyi tsu. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Ma vanyi ndǝ wu yiwu aga ja wulana ngau ǝnga ja hǝri lǝgutǝ ngau, bǝgǝ ja hǝri patǝ ǝkkǝˈyi sǝr bakǝ ngau. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Ma ndǝ ciwa ngǝ aga hya ɓǝ nǝ miyalu pathlǝu, maˈya mau nǝ miyalu mǝthlǝ ǝnga ja. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Nǝ nyi anǝ ndǝra kǝdiyau ara gau, ndǝra shili tsu, ji sa yiwa mǝl ara gau, a sara ga ka anǝ nyi mai.<verse eid="MAT 5:42"/></para>
  <para style="s1">Ga Yiwu Dawa Ngau</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luka 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>“A nggari hyi nji na anǝ nda, abǝr, ‘Ga yiwu zamǝ ngau, ba ga piyari dawa ngau.’ <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Ama yu na anǝ hyi, hya yiwu dawar hyi ba hya kǝdi Hyal anǝ nda. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Mǝl abangǝ nga hyu nda ɗa wazha dǝr hyi kǝra a dǝmǝlmau, ndǝra vǝr sǝwa pǝci ja mbǝl ar kǝra nji tsapǝu ǝnga nji batal ǝnga tsu ja tǝɗǝya par sara a dǝmǝlmǝ a gyar kǝra nji tsapǝu ǝnga nji ɗǝmwaˈyu. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Ma njira vǝr yiwu hyi nga hyu yiwu wacu, wathlǝmǝ culi akkǝri kǝra hyu nda uya? Alaga njir dlǝwu budǝ ma tsu, ndu mǝl abangau. <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Ma tsu, zamǝr hyi nga hyu usa wacu, ya, mi ngǝ sǝra hyi mǝliya pamǝ a mwara alenyi nja? Mǝna sǝni alaga njira aˈyi njir Yahudiya mai, ndu mǝl abangau. <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Hya nggya nyinyi cipǝu, ǝnggǝr kǝra Dǝr hyi kǝra a dǝmǝlmǝ nyinyi cipǝu.<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Lau Anǝ Ndǝr Gha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>“Hya hangǝkal ara mǝl ‘thlǝrǝr hyi nǝ tsapǝkur,’ ja sara ɗa sǝra nja lari ǝnga li wacu. Ara ma hyi mǝl abangau, nahyi wu nda uya akkǝri ara Dǝr hyi kǝra a dǝmǝlmǝ mai.<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>“Agabangau, ma gu lǝ sǝ anǝ ndǝr gha, a sara ga hǝˈuna mai, ǝnggǝra kǝra njir ngguta vi wu mǝl wu umbwa daɓǝ dzǝˈyar ǝnga ar laguˈyar aga nja faliya nda. Ənga jiri nga yu na anǝ hyi, a uyar nda akkǝri nda cipǝu. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Ama ma gu lǝ sau, a sara ga piyari pǝla gǝ nǝ matsal ja sǝnbiya sǝra pǝla gǝ nǝ mazǝm a vǝr mǝl mai, <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>aga lǝ sǝ ngau ja ɗa ar ɗǝɗǝwa. Ba dǝngǝ tsu, kǝra wu lari kalar sǝra nju mǝl ɗǝɗǝwa patǝu, ba ja sa nǝ ngǝ akkǝri.<verse eid="MAT 6:4"/></para>
  <para style="s1">Highiɓau Ar Kǝra Kǝdi Hyal</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>“Ənga tsu, ma hyu ndǝr ǝnga Hyal, a sara hya ɗa ǝnggǝr njir ngguta vi mai, njira wu yiwu kǝdi Hyal aˈyi taˈyi wu umbwa daɓǝ dzǝˈyar ǝnga ar laguˈyar aga nja daɓaga lar nda. Ənga jiri nga yu na anǝ hyi, a uyar nda akkǝri nda cipǝu. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Ama ma hyu kǝdi Hyal, hya maˈyi a gwu umbwa hya gwa haɗiya miya nyi, ba hya dzǝgwa ndǝr ǝnga dǝr hyi, ndǝra nji gǝra lari. Ba dǝr hyi, kǝra wu lari sǝra nja mǝl ɗǝɗǝwa, wu nda nǝ hyi akkǝri. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>Ma hyu kǝdi Hyal, a sara hya ndǝr gangǝ ǝnggǝr njira gǝra sǝn Hyal mai, njira wu nggani abǝr ndǝr gangǝ ca ngǝ Hyal wu nggari. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>A sara hya ɗa ǝnggǝr nanda mai, ara Dǝr hyu sǝn sǝra hyu ghari divira hya dzǝgwa kǝdi nyi.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>“Kǝja, ǝnggǝra hya ndǝr ǝnga Hyal:</para>
  <para style="q1" vid="MAT 6:9">“ ‘Dǝrˈya kǝra a dǝmǝlmau,</para>
  <para style="q2" vid="MAT 6:9">thlǝmǝ ngǝ ja nggya cicau,<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>tǝlkur ngau ja shili,</para>
  <para style="q2" vid="MAT 6:10">sǝra gu yiwu taˈyi ja ɗa wu duniya,</para>
  <para style="q1" vid="MAT 6:10">ǝnggǝr kǝra nja vǝr mǝl a dǝmǝlmau.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Ɗar ˈya sǝr sǝm nǝ ǝshina.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Tǝfǝbiya ˈya bikǝr ˈya,</para>
  <para style="q2" vid="MAT 6:12">ǝnggǝr kǝra ˈyi tǝfǝbiya</para>
  <para style="q1" vid="MAT 6:12">njira mǝliya ˈya bikau.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>A sara ga hǝr ˈya</para>
  <para style="q2" vid="MAT 6:13">a ndar vir dzǝ mai,</para>
  <para style="q1" vid="MAT 6:13">ama ga kǝtiya ˈya</para>
  <para style="q2" vid="MAT 6:13">ara shatan.</para>
  <para style="q1" vid="MAT 6:13">Ara tǝlkur ǝnga</para>
  <para style="q2" vid="MAT 6:13">dǝnama ǝnga kadakadarkur,</para>
  <para style="q1" vid="MAT 6:13">nǝngau baˈanuwa. Amina.’<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>Ara ma hyi tǝfǝbiya njira mǝliya hyi bikau, Dǝr hyi kǝra a dǝmǝlmǝ tsu wu sa tǝfǝbiya hyi. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Ama ma nahyi aˈyi tǝfǝbiya njira mǝliya hyi bikǝ mai, abangǝ tsu, Dǝr hyi kǝra a dǝmǝlmǝ wu nda tǝfǝbiya hyi bikǝr hyi mai.<verse eid="MAT 6:15"/></para>
  <para style="s1">Highiɓau Ar Kǝra Zǝmǝtsini</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>“Ma hyu hǝ zǝmǝtsini a sara hya hashi bama hyi ǝnggǝr kǝra njir ngguta vi wu mǝl kǝ mai, ara ndu hashi bama nda aga ca anǝ nji abǝr wu zǝmǝtsini nga nda. Ənga jiri ya nar hyi a uyar nda akkǝrir nda cipǝu. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Ama ma gu hǝ zǝmǝtsini ga cina bama gau ǝnga ga ɓǝsiya mal, <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ara nja sara sǝni abǝr ga vǝr hǝ zǝmǝtsini. Dǝngǝ kǝra aˈyi ǝnga gau, ndǝra tsu wu lari sǝra nju mǝl ɗǝɗǝwa wu nda nǝ ngǝ akkǝri.<verse eid="MAT 6:18"/></para>
  <para style="s1">Highiɓau Ar Kǝra Fǝ Gǝnna <optbreak/> A Dǝmǝlmau</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luka 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>“A sara hya tsǝm gǝnna anǝ kǝrhyi wu duniya mai, vira kǝthla ǝnga vuyavuya wu sǝn ndzana, vira tsu njir hǝl wu sǝn pǝthlǝna ba nda vuwa faˈari. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Ama hya tsǝmiya anǝ kǝrhyi gǝnnar hyi a dǝmǝlmau, vira kǝthla ǝnga vuyavuya a sǝn ndzana mai, vira tsu njir hǝl wu sǝn pǝthlǝna nda vuwa faˈari mai. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Arya vira gǝnna ngǝ ari, ǝna ngǝ ɗǝfuwa gǝ tsu.<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>“Li ca ngǝ mbǝmbǝl nǝ dzau. Ma liya gǝ mǝnahǝu, dza gǝ patǝ wu nyabiya dzǝ ǝnga mbǝmbǝl. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Ama ma liya gǝ aˈyi jamǝ mai, patǝkura dza gu tini mbǝmbǝlkur. Ma mbǝmbǝlǝr dza gu kuthlǝ nga nyi, kadzangǝ abar ngǝ kiyakiyarkura kuthlǝ ka!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>“Ndǝr sǝn mafakur anǝ thlagǝr ki pamǝpamǝ mǝthlǝ aˈyi mai, ara ju nda yiwu vanyi ba ja piyari vanyi ǝnga ju nda hǝya kǝr anǝ vanyi ba ja diɗana vanyi. Nahya sǝn daɓǝri nu Hyal ǝnga gal gǝnna mai.<verse eid="MAT 6:24"/></para>
  <para style="s1">A Sara Ga Ɓwa Kǝra Kǝr Ngǝ Mai</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luka 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>“Agabangau, yu na anǝ hyi, a sara hya ghǝɗǝr kǝrhyi arya nggyabiyar ǝnga sǝra hyu sǝm ǝnga sǝra hyu sa mai, alaga ar kǝra kar dza hyi tsu mai. Arya piya ndau, aˈyi a ndiya sǝr sǝm wa, ǝnga dza ndǝ aˈyi a ndiya sǝr ha wa? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Tsama mǝ ˈyagǝˈyar gǝyi, nandǝ wu thlǝka mai ǝnga nandǝ wu gǝm mai ǝnga tsu nandǝ wu pǝ sǝ wu val mai, alaga abangau, dǝr hyi kǝra a dǝmǝlmǝ nga vǝr sǝmǝna nda. Ya, aˈyi hyu ndiya nda ǝnga dudurkur wa? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Wa ngu pama hyi ara ɓwakǝr nyi, ba ja sǝn cakǝri saka pathlǝu a dar kǝra piya ja?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>“Ətsu mi ngǝ ɗa hyu ghǝɗǝr kǝrhyi ar kǝra sǝr ha? Tsama mǝ jigwal wu gǝyi, ǝnggǝra ndu hau. Nandǝ wu mǝl thlǝr alaga shi paˈwa mai. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Agabangau, yu nar hyi, alaga tǝl Solomanu ǝnga kadakadarkur nyi aˈyi saya har kari ǝnggǝr nǝr nda mai. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Ma abangǝ ngǝ Hyal wu har nyi kar anǝ jigwal wu a gwar tagǝu, kǝra aˈyi nda ǝshina ama ǝzǝgǝu a fuwar nji a gu uˈu, aˈyi ju nda har hyi kar a ndiya nda wa? Nahyi njira ǝnga mbǝrsa kukushu. <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Agabangau, hya sara ghǝɗǝr kǝrhyi, hyu na, ‘Mi nga ˈya wu nda sǝma’ ǝndǝga ‘Mi nga ˈya wu nda sa,’ alaga ‘Mi nga ˈya wu nda ha?’ <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Arya njir duniya ngu gal sǝˈyar kau. Dǝrhyi kǝra a dǝmǝlmau, wu sǝni abǝr hyu yiwu sǝˈyar kau. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Ama sǝ tanggǝrma, ca ngǝ hya gal tǝlkur Hyal ǝnga tsapǝkur nyi ba ja nǝ hyi sǝˈyar kǝ patǝ tsu. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Agabangau, hya sara ɓukǝr hyi arya sǝra ǝzǝgǝ mai, ara ǝzǝgǝ wu shili ǝnga ɓwaɓwatǝ nǝ kǝrnyi. Ɓwaɓwatǝ nǝ kalar pǝci tsaˈa aga pǝci ta nga nyi.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">A Sara Hya Thla Numa Ar Kǝra Nji Mai</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luka 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>“A sara hya thla numa ar kǝra nji mai, nji tsu aˈyi ndu thla numa ar kǝra hyi mai. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Arya culi thla numa kǝra hyi mǝl anǝ nji, ca nga nju nda thla numa ǝni anǝ hyi. Cala tǝkǝ sǝ kǝra hyi tǝkǝ sǝ ǝni anǝ nji, ca nga nju nda tǝkǝ sǝ ǝni anǝ hyi.<verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>“Ara mi nga gu lari zǝr sar kǝra wu liya zamǝ ngau, ama na ga sǝn tsamiya gwalang kǝra ar liya gǝ kǝ maya? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Əndǝga, abari nga ga sǝn na anǝ zamǝ ngau, abǝr, ‘Taˈyau, ya hǝbiya ngǝ zǝr sar kǝra wu liya gau,’ ya, kǝja gwalang ngǝ ar liya ga? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Nagǝ ndǝr ngguta vi, ga hǝbiya gwalang kǝra wu liya gǝ kwatahǝu, aga ga daɓaga lari mǝnahǝu, ba ga sǝn hǝbiya zǝr sar kǝra wu liya zamǝ ngǝ kau.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>“A sara hya nǝ nyi anǝ hya sǝra cici mai ǝnga a sara hya vakar nyi anǝ fǝshiu tsǝka nǝ gǝnna gangǝ mai, ca ngǝ tsǝka wilwilu. Ara fǝshiu wu nda cicina nda ba nda shabiya dzǝ nda uya hyi ǝnga shilǝgǝu.<verse eid="MAT 7:6"/></para>
  <para style="s1">Hya Kǝdiyau, Hya Gal Ənga Hya Tsatsari</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>“Hya dumwa ǝnga kǝdiyau, nju nǝ hyi. Hya dumwa ǝnga gal, hyu uya. Hya dumwa ǝnga tsatsa tsu, nju pahǝna hyi. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Ara kalar ndǝra kǝdiyau, nju nǝ nyi, kalar ndǝra gal, ju uya, ndǝra tsa umbwa tsu, nju pahǝna nyi.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>“Ndǝ aˈyi wu pama hyi kǝra ar viya tada, ma zǝr nyi kǝdi ɗǝfau ba ja nǝ nyi tsǝka ya? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Əndǝga ma zǝr nyi kǝdi kalfi, ba ja nǝ nyi pabǝ ya? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Ma nahyi, nji ɗǝɗǝmwaˈyi wu sǝni nǝ nyi anǝ wazhar hyi sǝ mǝmǝnahǝu, abari ngǝ Dǝrhyi kǝra a dǝmǝlma? Ju sa nǝ nyi sǝ mǝmǝnahǝ anǝ njira wu kǝdi sǝ ara ja, a ndiya nǝ dǝrhyi. <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Kalar sǝra hyu yiwu nja mǝl anǝ hyi, nahyi tsu ca nga hya mǝl anǝ nda, arya kǝ ca ngǝ sǝra highiɓǝ nǝ dlaɗau ǝnga nabiˈyar aga nyi.<verse eid="MAT 7:12"/></para>
  <para style="s1">Miyar Gwa Ki Kǝra Ciciɗǝu <optbreak/> Ənga Balangǝu</para>
  <para style="r">(<ref loc="LUK 13:24">Luka 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>“Hya gwu ki lagur miyar gwa kǝra ciciɗǝu, arya miyar gwa ndar vir sa balangǝ nga ja ǝnga lagur ndari tsu ɓatsǝ nga nyi, njir nu laguwa nyi tsu, gangǝ nga nda. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Ama miyar gwa nǝ uya pi, ciciɗǝ nga nyi. Ənga lagur gwa gwa tsu dzadzau nga nyi. Njir nu laguwa nyi aˈyi nda gangǝ mai.<verse eid="MAT 7:14"/></para>
  <para style="s1">A Sǝn Tsamǝr Nji Wu Ar Yaya Nyi</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luka 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>“Hya hangǝkal ǝnga nabi fatiˈyar, kǝra a vǝr shili ǝgya hyi a papa tǝmahǝu, ama jirkura nyi ufwar vuwa nga nda. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Hyu nda sǝnbiya nda lagur sǝr mǝla nda. A sǝn uya nji yayar wur inabi sara ar dza wur shikǝɗi ya? Əndǝga a sǝn uya nji yayar kanda sara ar dza wu shishikǝɗi ya? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Abangǝ tsu, kalar wu mǝnahǝu, ju ya wazha mǝnahǝu, wu kǝra gǝra mǝnahǝ tsu, ju ya wazha kǝra gǝra mǝnahǝu. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Wu kǝra mǝnahǝu, a sǝn yabiya wazha kǝra gǝra mǝnahǝ mai, abangǝ tsu, wu kǝra gǝra mǝnahǝu, a sǝn yabiya wazha mǝnahǝ mai. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Kalar wu kǝra gǝra sǝn yabiya wazha mǝnahǝu, ba nja gǝmna nyi ba nja vakuwa nyi a gwu uˈu. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Agabangau, hyu nda sǝnbiya nda lagur sǝr mǝla nda.<verse eid="MAT 7:20"/></para>
  <para style="s1">Nayi Saya Sǝni Hyi Mai</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luka 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>“Aˈyi kalar ndǝra wu na anǝ ɗa, ‘Thlagǝu, Thlagǝu,’ ngu nda gwu tǝlkur Hyal mai, ama kǝl ndǝra wu mǝl sǝra Dǝɗa kǝra a dǝmǝlmǝ wu yiwu. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Ar pǝci ta, nji gangǝ nda na anǝ ɗa, ‘Thlagǝu, Thlagǝu! Naˈya aˈyi tǝtǝlna ndǝr Hyal wu thlǝmǝ ngǝ wa? Aˈyi ˈyi kǝdlǝbiya shatan wu thlǝmǝ ngǝ wa? Ənga aˈyi ˈyi mǝlna sǝ dǝdǝgurˈyar gangǝ wu thlǝmǝ ngǝ wa?’ <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Abangau, ama yu nda shaɗǝwa nda, ‘Nayi wu sǝni hyi mai. Hya tǝkǝ ǝnga yau, nahyi njir mǝl ɗǝmwaˈyikur!’<verse eid="MAT 7:23"/></para>
  <para style="s1">Njir Hǝr Mǝthlǝu</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>“Agabangau, kalar ndǝra nggari ndǝr ɗa kau, ba ji mǝl thlǝr ǝni, ja nda ɗa ǝnggǝr ndǝ tsǝtsǝl ndǝra hǝriya ki nyi ar pathlara mau. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Ənggǝra par tǝɗau, dlǝlǝmǝ nyau, yambaɗǝ sau, ba ji tsaɓǝr ki kau, ama naji dla mai, ara nji hǝriya nyi ar vi mǝmau. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Kalar ndǝra nggari ndǝr ɗa kǝ tsu ba ji nggǝl ara mǝl thlǝr ǝni, ju nda ɗa ǝnggǝr ndǝ dza kǝra hǝriya ki nyi ar vi mǝshiˈwa. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Ənggǝra par tǝɗau, dlǝlǝmǝ nyau, yambaɗǝ shili ka sa tsar ki kau, ba kiya nyi dla, dla nyi ma, dla didiɗi.”<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Ənggǝra Yesu kuɗǝna nana sǝˈyar kau ba highiɓǝ nyi kǝ ɗa sǝ dǝdǝgur anǝ dlamir nji. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>Ara ji highiɓǝ anǝ nda ǝnga dǝnama, aˈyi ǝnggǝr nǝ malǝmǝ dlaɗǝr ndaˈyar mai.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Yesu Shilǝgǝbiya Ndǝr Pibi</para>
  <para style="r">(<ref loc="MRK 1:40-45">Markusu 1:40-45</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Ta Yesu shida sara dar ma nyi, ba nji gangǝ nu nyi. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Kǝ ndǝr pibi shili, ji sa ɓǝliya undi a dumwa nyi, ji na, “Thlagǝu, ma gu yiwu, gu sǝn mǝliya ɗa jamǝu.” <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>Kǝ Yesu har tsi ka tsǝkwar nyi, ji na, “A hǝnggǝr yau,” “Ga ɗa cicau!” Ənggǝrna, ba pibiya nyi piyari nyi. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Kǝ Yesu na anǝ nyi, “Ga hangǝkal ga sara na sǝ kǝ anǝ ndǝ mai. Ama ga maˈyi a ndǝgya pubu ga nda canǝ nyi kǝrngau, ga dzǝgwa kǝbǝna sau ǝnggǝra dlaɗǝ Musa nana nja mǝl aga ci dzau. Ga mǝliya abangǝ aga ga cabiya nyi anǝ nji abǝr a ɗar gǝ jamǝu.”<verse eid="MAT 8:4"/></para>
  <para style="s1">Mbǝrsa Nǝ Soja Dǝgal Nǝ Roma</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Ənggǝra Yesu vu Kafarnahumu, kǝ vanyi dǝgalǝr soja nǝ Roma shili ǝgya ja, ju kǝdi dlǝwa dzǝ ara ja. <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“Thlagǝu,” ji na, “Ndǝr mǝl thlǝr anǝ ɗa a yi pida nga ja a ndu ki, naja sǝn shabiya dzǝ mai, ɓwaɓwatǝ nga ja gwa gagaɗau.”<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>Kǝ Yesu na anǝ nyi, “Yi wu maˈyi, aga ya nda shilǝgǝbiya nyi.”<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Kǝ dǝgalǝr soja nǝ Roma shaɗǝwa, ji na, “Thlagǝu, nayi ɗa tsaˈa aga ga shili wu ki ɗa mai, ama ga nana ndǝr wacu, ba ndǝr mǝl thlǝr anǝ ɗa kǝ a ɗa jamǝu. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Arya nayi ǝnga kǝrɗa ma ǝgya ndǝ dǝgal nga yau, ǝnga tsu sojaˈyar aˈyi kǝra ǝgya kiɗa yau, yu na anǝ ndǝ kau, ‘Maˈyi,’ ba ja maˈyi, anǝ vanyi ndǝ tsu yu na ‘Shili,’ ba ja shili. Ma yi na anǝ mafa ɗa, ‘Mǝliya abangau,’ ba ja mǝliya.”<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Ənggǝra Yesu nggar ndǝr kau, ba ɗa sǝ dǝdǝgur anǝ nyi, ji shabiya dzau, ba ji na anǝ nji kǝra a vǝr nu nyi, “Ya nar hyi, wu Izirayila nayi sayi uya ndǝra ǝnga mbǝrsa ǝnga dǝnama ǝnggǝr ndǝ kǝ mai. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Yu na anǝ hyi, abǝr gangǝ njir mbǝrsa wu nda shili sara wu sǝbiyar pǝci ǝnga gwa tǝɗǝ pǝci ndu sa nggya ndu sǝm sǝr sǝm nǝ caguli ǝnga Ibrahimu ǝnga Ishaku ba Yakubu wu tǝlkur Hyal. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Ama nju sa vakuwa a gwu kuthlǝ nǝ kyakyaru njira a kyau nda ɗa nji Hyal, ama ba ndǝ nggǝl, vira hyu nda tiwi ǝnga hyu ɗǝ hira hyi ari.” <verse eid="MAT 8:12"/><verse number="13" style="v" sid="MAT 8:13"/>Kǝ Yesu na anǝ dǝgalǝr soja nǝ Roma, “Maˈyi, wu ɗa anǝ ngau, kakalǝ ǝnggǝra gǝ mbǝrsa.” Ənggǝrna, kǝ ndǝr mǝl thlǝr nyi ta ɗa jamǝu.<verse eid="MAT 8:13"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Miya Mala Biturusu</para>
  <para style="r">(<ref loc="MRK 1:29-31">Markusu 1:29-31</ref>; <ref loc="LUK 4:38-39">Luka 4:38-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Ənggǝra Yesu vu ki Biturusu, kǝ ji thlǝwa miya mala Biturusu gǝvǝu a yi pida, gyangǝ a vǝr tǝ nyi. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Kǝ ji tsǝkwari pǝla ja, kǝ gyanga nyi piyari nyi ba ji hyaˈari ji mǝliya nda sǝr sǝm.<verse eid="MAT 8:15"/></para>
  <para style="s1">Yesu Mbǝɗana Nji Gangǝu</para>
  <para style="r">(<ref loc="MRK 1:32-34">Markusu 1:32-34</ref>; <ref loc="LUK 4:40-41">Luka 4:40-41</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>Ta wagǝ ɗa, nji gangǝ njira ǝnga mambǝl ɗǝmwaˈyi wu dza nda nji shili ǝnga nda anǝ Yesu, kǝ ji kǝdlǝbiya mambǝla nyiˈyar ǝnga ndǝr nyi. Abangǝ tsu kǝ ji shilǝgǝbiya patǝr njira gǝra ngga. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Ji mǝl abangau, aga nyabiya sǝra nabi Əshaya nana, abǝr, “Ji hǝri sǝra wu tǝ mǝn ǝnga ji faˈari shilǝgǝr mǝn.”<verse eid="MAT 8:17"/></para>
  <para style="s1">Dzaukura Nu Yesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Ta Yesu lari dlamir nji gangǝ zǝwar nyi, kǝ ji sǝwa nja tǝrabiya ǝnga ja a biyar ya dǝl. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Kǝ vanyi malǝmǝ nǝ dlaɗǝ shili, ji sa nar nyi, “Malǝmǝ, yu nu ngau, kalar vira gu maˈyi a ndari.”<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Kǝ Yesu shabiya nyi ji na, “Thlahu ǝnga kaˈu nga nda, ˈyagǝˈyar tsu kir nda aˈyi, ama zǝr ndau, vira ja fiya kǝra ja ari aˈyi mai.”<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Vanyi zǝmbǝlma na anǝ nyi, “Thlagǝu, taˈyi ya maˈyi ya nda haɗǝna dǝɗa kwatahǝu.”<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Ama Yesu na anǝ nyi, “Nu ɗa, piyari nji tǝtǝ nda haɗǝna nji tǝtǝr nda.”<verse eid="MAT 8:22"/></para>
  <para style="s1">Yesu Kughiya Majigwal</para>
  <para style="r">(<ref loc="MRK 4:35-41">Markusu 4:35-41</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Ənggǝra ji gwu kwambwal, kǝ zǝmbǝlma nyiˈyar nu nyi. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Fǝɗǝngǝkǝr nda, kǝ majigwal ǝnga dǝnama shili ar dǝla nyi, ji sa kǝnggǝɗǝr ˈyimiya nyi, kǝl ta ˈyimiya nyi gwu kwambwala nyi, ama Yesu nǝ nyi wu ghanyi nga ja. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Kǝ ndǝ hyaˈari ndǝ nda hyaˈana nyi, ndu na anǝ nyi, “Thlagǝu, kǝtiya mǝn, kǝja mǝnu sa!”<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>Ji shaɗǝwa, “Nahyi njira ǝnga mbǝrsa kushu, ara mi nga hyu hivǝra?” Kǝ ji hyaˈari ji kughiya majigwala nyi daɓǝ ǝnga kǝnggǝɗǝr dǝla nyi, kǝ patǝkura vi bǝgǝ zǝmǝu.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Ba sǝ kǝ ɗa sǝ dǝdǝgur anǝ nji kau, ndǝ yiwa, “Wathlǝmǝ culi najaka nda? Patǝ ǝkkǝˈyi majigwal ǝnga dǝl wu gǝnggǝr nyi sǝli ka?”<verse eid="MAT 8:27"/></para>
  <para style="s1">Yesu Mbǝɗana Nji Mǝthlǝu <optbreak/> Kǝra Ənga Mambǝl Ɗǝmwaˈyu</para>
  <para style="r">(<ref loc="MRK 5:1-20">Markusu 5:1-20</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Ənggǝra ji shili arya dǝl nǝ ˈyiˈyir nǝ Gadarasanu. Kǝ nji mǝthlǝ ǝnga mambǝl ɗǝmwaˈyi shili sara wu hulili ndǝ sa thlǝwa nyi. Arya sǝr mǝla nda, ndǝ ɗa sǝra nja hivǝr gagaɗau, ka ɗa ma tsu ndǝr yiwu nu lagu ta aˈyi mai. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Ənggǝrna, kǝ nji kǝ gwu wau, ndu na, “Mi ngǝ dzau ngau ǝnga ˈya, nagǝ Zǝr Hyala? Əndǝga gǝ shili aga ga sa nǝ ˈya ɓwaɓwatǝ tsu pǝcir ˈya gǝra ɗa ya?”<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Lǝhǝ a dzǝr vi ta, ɓǝla fǝshiu aˈyi gangǝu kǝra a vǝr ɓǝla ar dza mau. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Mambǝl ɗǝmwaˈyiˈyar kǝ kǝdi Yesu, “Ma gu kǝdlǝ ˈya a biya, sǝwa ˈya a ndu fǝshiˈyar kau.”<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>Kǝ ji na anǝ nda, “Yau, maˈya mau.” Kǝ ndǝ biya, kǝ ndǝ gwu fǝsha nyi, kǝ fǝgǝ fǝsha nyi patǝ aga zǝmǝ hyaˈari ndǝ maˈyi, kǝ ndǝ gwa pau a gwar dǝl, ba ndǝ kuɗǝ ar ˈyimiya nyi. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Njir ɓǝla fǝsha nyiˈyar hwinakǝr, ta ndǝ vu huɗa mǝlmau, ba ndǝ vuwa nar nyi anǝ nji sǝra ɗa patǝu ǝnga sǝra ɗa ǝnga njira ǝnga mambǝl ɗǝmwaˈyi kau. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Kǝ patǝkura njir mǝlmǝ biya aga nda ɓǝ ǝnga Yesu. Ta ndǝ lari nyi, kǝ ndǝ kǝdi nyi aga ja piyari nda ˈyiˈyir nda.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">Yesu Shilǝgǝbiya Ndǝ Tǝsǝkǝnǝu</para>
  <para style="r">(<ref loc="MRK 2:1-12">Markusu 2:1-12</ref>; <ref loc="LUK 5:17-26">Luka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Kǝ Yesu gwu kwambwal, kǝ ji tǝrabiya a biyar ya dǝl, ba ji maˈyi a ndu mǝlmǝ kǝra ji hǝ a gwa. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Kǝ nji hǝr nyi vanyi ndǝ a shili a yi pida ar caɗǝu. Ənggǝra Yesu lari mbǝrsar nda, kǝ ji na anǝ ndǝ tǝsǝkǝnǝ kau, “A sara ga tal mai, zǝr ɗa, a tǝfǝbiya ngǝr yi bikǝ ngau.” <verse eid="MAT 9:2"/><verse number="3" style="v" sid="MAT 9:3"/>Ənggǝra njir sǝn dlaɗǝ nggar abangau, kǝ ndǝ na anǝ kǝrnda, “Ndǝ kau, ju diɗa thlǝmǝr Hyal!”<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Arya Yesu wu sǝni sǝra nda vǝr ɗǝnga, kǝ ji na anǝ nda, “Ara mi nga hyu ɗǝnga ɗǝmwaˈyi wu ɗǝfuwa hyi abanga? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Mani nga ndiya ǝnga ɓatsa? Nja na, ‘A tǝfǝbiya ngǝr nji bikǝ ngau,’ ǝndǝga, ‘Hyaˈari ga ɓǝ ya?’ <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Ama yu yiwu hya sǝni, abǝr Zǝr Ndǝ aˈyi ja ǝnga dǝnama nǝ tǝfǝbiya bikǝ wu duniya.” Kǝ ji na anǝ ndǝr tǝsǝkǝnǝ kau, “Hyaˈari, ga hǝri caɗǝ ngau, ba ga maˈyi a ndu ki.”<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>Ba nda nyi hyaˈari tsu, ba ji maˈyi a ndu ki nyi. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Ta dlamir nji lari abangau, kǝ hivǝr mbari nda, kǝ ndǝ dlǝvǝ Hyal kǝra lǝri culi najaka dǝnama anǝ nji.<verse eid="MAT 9:8"/></para>
  <para style="s1">Yesu Ngga Matiwu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Markusu 2:13-17</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Ənggǝra Yesu dumwa ǝnga ɓau, kǝ ji lari vanyi ndǝ kǝra nju ngga ǝnga Matiwu, ja vǝr nggya ar vir tsǝm budau. Kǝ Yesu na anǝ nyi, “Nu ɗa.” Kǝ ji hyaˈari ba ji nu nyi.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Ənggǝra Yesu a vǝr sǝm sǝr sǝm wu ki Matiwu, kǝ njir tsǝm budǝ gangǝu ǝnga “njir bikǝ” shili ndǝ sa sǝm sǝr sǝm ǝnga ja ba ǝnga zǝmbǝlma nyiˈyar. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Ənggǝra njir Farisi lari sǝ kau, ba ndǝ yiwa miya zǝmbǝlma nyiˈyar, “Ara mi ngǝ malǝmǝr hyu sǝm sau ǝnga njir tsǝm budau ba ǝnga ‘njir bikǝ ka’?”<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Ənggǝra Yesu nggari sǝ kau, kǝ ji na, “Nji jamǝ wu yiwu ligǝta mai, kǝl njira gǝra ngga. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Ama maˈya mau hya nda ɗǝnga tara mi ngǝ ndǝr kǝ a gǝri, ‘Tǝhuɗǝ nga ya yiwu, aˈyi saɗaka mai.’ Ara nayi shili aga sa ngga nji tsapǝ mai, ama aga sa ngga njir bikau.”<verse eid="MAT 9:13"/></para>
  <para style="s1">Yiwa Sau Ar Kǝra Zǝmǝtsini</para>
  <para style="r">(<ref loc="MRK 2:18-22">Markusu 2:18-22</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Kǝ zǝmbǝlma Yahwana ˈyar shili ara Yesu, ndǝ sa yiwa nyi, “Mi ngǝ ɗa zǝmbǝlma Yahwana ǝnga nǝ Farisi wu hǝ zǝmǝtsini ama nǝngau, nandǝ wu hǝ maya?”<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Kǝ Yesu shaɗǝwa nda, ji na, “Bazhiya salkwanjili a sǝn hǝ zǝmǝtsini ma tsu nda ǝkkǝˈyi ja ya? Nanda sǝn hǝ mai, ma tsu nda ǝkkǝˈyi ja. Pǝci wu shili nja sa hǝna salkwanjili ara nda. Wu pǝci ta nga nda dzǝgwa hǝ zǝmǝtsini.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>“Ndǝr ndǝɓǝ zhaɓi hahal ǝnga mafǝliyangǝ aˈyi mai. Ma ji mǝl abangau, ba mafǝliyangǝ nga nyi a tana hahala nyi, ta nyi a dzǝgwa ndiya nǝ ɗǝɗǝmǝ ǝnga ɗǝmwaˈyu. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Ətsu ndǝr puwa ˈyimi inabi mafǝliyangǝ a gwu pǝla hahal aˈyi mai. Ma ji mǝl abangau, ba ˈyimir inabi mafǝliyangǝ kǝ a thlǝnakǝr ba ja pǝthlǝna nyi, ba ˈyimir inabi kǝ a pǝnakǝr ba pǝla ka ndzau. ˈYimir inabi mafǝliyangǝ kǝl pǝla mafǝliyangǝu.”<verse eid="MAT 9:17"/></para>
  <para style="s1">Kwar Yariyusu Ənga Mala Ndzǝndzǝ Mashi</para>
  <para style="r">(<ref loc="MRK 5:21-43">Markusu 5:21-43</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Ənggǝra Yesu a vǝr na sǝˈyar kau, kǝ ndǝ dǝgal nǝ umbwa daɓǝ dzǝ njir Yahudiya shili, kǝ ji sa ɓǝliya undi a dumwa nyi, kǝ ji na, “Kajangǝkau, kwaɗa a tǝri, ama shili ga sa fǝr tsi ar ja, ba ja mbǝɗau.”<verse eid="MAT 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19"/>Kǝ Yesu hyaˈari ǝnga zǝmbǝlma nyiˈyar, ba ndǝ nu nyi.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Kǝ vanyi mala kǝra mǝliya fa kumo apǝ mǝthlǝ a vǝr ndzǝndzǝ mashi, shili lagu ya ja, kǝ ji sa tsǝkwari miya cira lǝgutǝ Yesu. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Arya ja vǝr na wu ɗǝfuwa ja, “Ma yi sǝn tsǝkwar alaga miya cira lǝgutǝ nyi, yu ɗa jamǝu.”<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Ənggǝra Yesu shabiya dzau, ba ji lari nyi, kǝ ji na, “A sara ga tal kwaɗa mai, mbǝrsa ngau, a mǝliya ngǝr yi jamǝu.” Ənggǝrna, ba ji ɗa jamǝu.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Ta Yesu shili wu ki ndǝ dǝgala nyi, kǝ ji lari njir mbǝɗi mbǝlau ǝnga nji tǝzǝwuɗǝwuɗǝu. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>Kǝr kǝ ji na, “Kwaya mau ǝnggau! Kwa kǝ tǝ mai, wu ghanyi nga ja.” Kǝ ndǝ nggushina nyi nggushi nǝ diɗa. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Ama ǝnggǝra ji kǝdlǝbiya nda a biya, kǝ ji gwa ji gwa mbar tsa kwa nyi, kǝ ji hyaˈari aˈyi nggya. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Ndǝr kǝ tǝtǝlna dzǝ wu ˈyiˈya nyi patǝu.<verse eid="MAT 9:26"/></para>
  <para style="s1">Yesu Mbǝɗana Nji Lǝfau <optbreak/> Ənga Ndǝ Mǝga</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Ənggǝra Yesu a vǝr piyari vi ta, kǝ nji lǝfǝ mǝthlǝ ndu nu nyi, ndu ngga ǝnga dǝnama, “Tǝhuɗǝ ǝgya ˈya, zǝr Dawuda!”<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Ənggǝra Yesu vu vanyi ki, kǝ lǝfa nyiˈyar shili ǝgya ja, kǝ ji yiwa nda, “A mbǝrsar hyi abǝr yu sǝn mbǝɗana hyi ya?” Ndǝ shaɗǝwa, “Angǝ, Thlagǝu.”<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Ənggau kǝ ji tsǝkwar liya nda, ji na, “Bǝgǝ ja ɗa anǝ hyi ǝnggǝra hyi mbǝrsa.” <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Kǝ liya nda pahau. Ənggǝ tsu, kǝ Yesu tǝɗar himiya nda, ji na, “A sara hya na sǝ kǝ anǝ nji mai.”<verse eid="MAT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31"/>Ama ndǝ biya ndǝ tǝtǝlna ndǝra nyi baˈamani wu ˈyiˈya nyi.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Ənggǝra nda vǝr maˈyi a biya, kǝ nji shili anǝ Yesu ǝnga vanyi ndǝra mambǝl ɗǝmwaˈyi kar nyi ara ndǝr. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Ənggǝra ji kǝdlǝbiya mambǝl ɗǝmwaˈya nyi a biya, ba ndǝ mǝga nyi mbar ndǝr. Kǝ sǝ kǝ ɗa sǝ dǝdǝgur anǝ daɓǝr dlami, ndǝ na, “Sǝ aˈyi ǝnggǝr kǝ saya ɗa wu Izirayila nji lar mai.”<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Ama njir Farisi nǝr nda, ndǝ na, “Ənga dǝnama nǝ tǝl shatan nga ju kǝdlǝ wazha shatan kau.”<verse eid="MAT 9:34"/></para>
  <para style="s1">Yesu Tǝhuɗǝu Əgya Nji</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Ənggau, Yesu ɓǝbiya ɓau wu patǝr ˈyiˈyir Galili, ja vǝr highiɓǝ wu umbwa daɓǝ dzǝˈyar, ja vǝr tǝtǝlna ndǝshigu ar kǝra tǝlkur Hyal. Ba ǝnga ja vǝr shilǝgǝbiya kalar shilǝgǝu ǝnga njira gǝra ngga. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Ta ji lari nji gangǝ daɓau, kǝ ji tǝhuɗǝ ǝgya nda, ara nda vǝr lari ɓwaɓwatǝu, ba tsu dlǝwa dzǝ aˈyi mai, ǝnggǝr tǝmahǝ kǝra gǝra ǝnga ndǝr ɓǝla. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Kǝ ji na anǝ zǝmbǝlma nyiˈyar, “Sǝr faˈa a su ki gangǝ nyi, ama njir mǝl thlǝr kushu nga nda. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Agabangau, hya kǝdi thlagǝr fa, ja sǝwa njir mǝl thlǝr aga nda sa faˈa sǝ a su ki.”<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">Yesu Ngga Zǝmbǝlma Nyiˈyar</para>
  <para style="r">(<ref loc="MRK 3:13-19">Markusu 3:13-19</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Kǝ Yesu nggar zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝu. Kǝ ji nǝ nda dǝnama aga nda kǝdlǝbiya mambǝl ɗǝmwaˈyu ǝnga nda shilǝgǝbiya kalar culi shilǝgǝu ǝnga nji gǝra ngga. <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>Kǝja thlǝmǝr cama sǝsǝ kumo apǝ mǝthlǝ ˈyar kau. Tanggǝrma Simanu ndǝra nju ngga ǝnga Biturusu ǝnga zamǝ nyi Andǝrawusu ǝnga Yakubu zǝr Zabadi ǝnga zamǝ nyi Yahwana <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>ǝnga Fǝlipǝu ǝnga Bathlalomiyu ǝnga Toma ǝnga Matiwu ndǝr tsǝm budau ǝnga Yakubu zǝr Alfawusu ǝnga Tidiyawusu <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ǝnga Simanu ndǝr Kanaˈana ba ǝnga Yahuda Isikarayoti ndǝra thlǝna hiya Yesu.<verse eid="MAT 10:4"/></para>
  <para style="s1">Yesu Sǝwa Cama Sǝsǝ <optbreak/> Kumou Apǝ Mǝthlǝu</para>
  <para style="r">(<ref loc="MRK 6:7-13">Markusu 6:7-13</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Yesu sǝwa cama sǝsǝ kumo apǝ mǝthlǝu, ji na anǝ nda, “A sara hya ndǝgya njira aˈyi njir Yahudiya mai ǝnga ǝtsu a sara hya vu mǝlmǝ njir Samariya mai. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Ama kǝl hya maˈyi a ndǝgya njir Izirayila kǝra ǝnggǝr tǝmahǝ sasa. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Hya maˈyi hya nda tǝtǝlna nda ndǝr Hyal abǝr, ‘Tǝlkur Hyal a ɗar lǝhǝu.’ <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Hya shilǝgǝbiya njira gǝra ngga ǝnga hya hyaˈana nji tǝtau ǝnga hya shilǝgǝbiya njir pibi aga nda ɗa cicau, ǝtsu hya kǝdlǝbiya mambǝl ɗǝmwaˈyi wu dza nji. Kurthlǝ nga hyi dlǝwuri ǝnga hya lǝri kurthlǝ tsu. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Ma hyu maˈyi, a sara hya sǝɓǝ gǝnna mai. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>A sara hya sǝɓǝ mbǝl mai, alaga zaɓǝkwa lǝgutǝu ǝnga ɓiɓi ǝnga zǝwa mai, ara ndǝr mǝl thlǝr a kyaga uya akkǝri nǝ thlǝr nyi.<verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>“Kalar mǝlmǝ dǝdǝgalǝu, alaga mǝlmǝ kukushu kǝra hyu nda gwa, hya galǝri ndǝ ɗǝfu camǝu aga hya nggya ǝnga ja baˈanǝ pǝci kǝra hyu nda piyari viya nyi. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Ma hyu vu ki kau, hya usar nda. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Ma ki nji ɗǝfu camǝ ngau, hya kǝdi Hyal ja nǝ nda jamǝkur, ama ma kiya nyi aˈyi ki nji mǝnahǝ mai, bǝgǝ jamǝkur Hyal a sha shili ara hyi. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Kalar ndǝra gǝra dlǝwur hyi ǝnga gǝra sǝya hyi himi, hya dlǝɗǝna bǝbǝr kǝra ar hiya hyi ma hyu biya sara wu kiya nyi ǝnga mǝlma nyi. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Ənga jiri, yu na anǝ hyi, Hyal wu nda tǝhuɗǝ ǝgya njir Sodomu ǝnga njir Gwamwara a ndiya njir mǝlmǝ kau, ar pǝcir numa. <verse eid="MAT 10:15"/><verse number="16" style="v" sid="MAT 10:16"/>Kǝja yu sǝ hyi a biya ǝnggǝr tǝmahǝ kǝra wu pama ufwar vuwa ˈyar. Agabangǝ hya nggya hahangǝu ǝnga tsu hya nggya ǝnga kiˈwakur.<verse eid="MAT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17"/>“Hya hangǝkal ǝnga nji, ara ndu nda wulana hyi anǝ njir pathla ǝnga ndu nda dǝgǝ hyi ǝnga wuɗa wu umbwa daɓǝ dzǝˈyar. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Arya yi tsu, ndu nda hǝr hyi a ndumwar nji nggunggurǝm ǝnga tǝltǝlˈyar, aga hya nar nda ndǝshigu mǝsahǝu ǝnga anǝ njira aˈyi njir Yahudiya mai. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Ar pǝci kǝra ndǝ mbari hyi, a sara hya tal sǝra hyu nda na mai ǝnga ǝnggǝra hyu nda na, ara Hyal wu nda nǝ hyi sǝra hyu nda na ar pǝci ta. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Arya aˈyi nahyi ngu nda ndǝr mai. Ama Mambǝl Dǝr hyi ngu nda ndǝr lagur hyi.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>“Zamǝ wu nda lǝri zamǝ nyi aga nja tsǝya nyi. Tada tsu wu nda lǝri zǝr nyi. Abangǝ tsu wazha ndu nda hyaˈana hangǝkala njir yar nda, ba ja tǝkǝri nja tsǝya nda. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Nji patǝ wu nda piyari shishir dza hyi arya yau. Ama ndǝra cinapi baˈanǝ kuɗiya, ju uya mbǝɗau. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Kalar pǝci kǝra nji lǝr ɓwaɓwatǝ anǝ hyi wu vanyi mǝlmǝ, hya hwi a ndu mǝlmǝ kǝra a ndumwar hyi. Ənga jiri yu nar hyi, abǝr divira hyi ɓǝbiya ɓǝ patǝ wu mǝlmǝ Izirayila, Zǝr Ndu ɓǝra shida.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>“Zǝmbǝlma aˈyi a sǝn ndiya malǝmǝ nyi mai ǝnga tsu mafa aˈyi a sǝn ndiya thlagǝr ki nyi mai. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>A ɗar tsaˈa anǝ zǝmbǝlma ja ɗa ǝnggǝr malǝmǝ nyi, mafa tsu ja ɗa ǝnggǝr thlagǝr ki nyi. Ma ndǝ ngga thlagǝr ki ǝnga Bilzabulu, abari nga ndu nda na ar kǝra njir ki ka?<verse eid="MAT 10:25"/></para>
  <para style="s1">Ndǝra Nja Kyaga Hivǝr</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luka 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>“Agabangau, a sara hya hivǝr nda mai, arya sǝ aˈyi kǝra ndu mǝl ɗǝɗǝwa kǝra gǝra nda biyar babal mai, ǝtsu sǝ aˈyi ɗǝɗǝwa kǝra nji gǝra nda sǝn mai. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Sǝra yu na anǝ hyi ɗǝɗǝwa, hyu nda hǝˈuna ar babal. Sǝra yi cici a gwu himiya hyi, hyu nda hǝˈuna a dar dzaˈwu. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>A sara hya hivǝr ndǝra wu sǝn tsǝya kumǝr dza hyi mai, ama naji wu sǝn tsǝya mambǝlǝr hyi mai. Kǝl hya hivǝr ndǝra wu sǝn tsǝya kumǝr dza hyi ǝnga mambǝlǝr hyu uˈur kǝtsa. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Aˈyi nju ɗǝlna wazha ˈyagǝ mǝthlǝ ar kǝra peni pathlǝ wa? Ya, zǝma nda aˈyi sǝn tǝɗǝ a gyiwu ˈyi gǝra ǝnga sǝni Dǝr hyi mai. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Shishir kǝra hyi ma jijiga nga nda. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Agabangau, a sara hya hivǝr mai. A ndiyar hyi wazha ˈyagǝ ǝnga mǝnahǝ gagaɗau.<verse eid="MAT 10:31"/></para>
  <para style="s1">Cabiya Hǝnggǝri Ənga Kǝrsiti <optbreak/> Wu Mwar Nji</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luka 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>“Kalar ndǝra hǝnggǝr abǝr naja nǝɗa nga ja a dumwar nji, nayi tsu, yu nda hǝnggǝr abǝr nǝɗa nga ja a dumwar Dǝɗa kǝra a dǝmǝlmau. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Ama kalar ndǝra kǝpalna sǝn ɗa a dumwar nji, nayi tsu yu nda kǝpalna sǝni nyi a dumwar Dǝɗa kǝra a dǝmǝlmau.<verse eid="MAT 10:33"/></para>
  <para style="s1">Nayi Shili Ənga Nggya Jamǝ Mai <optbreak/> Ama Kǝl Ənga Pa</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>“A sara hya nggani abǝr yi shili ǝnga nggya jamǝ wu duniya mai. Aˈyi aga nggya jamǝ nga yi shili mai, ama aga sa pa. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>A shilir yi aga sa daɓǝ</para>
  <para style="q1" vid="MAT 10:35">“ ‘tada ǝnga zǝr nyi ar pa,</para>
  <para style="q2" vid="MAT 10:35">zǝr kwa tsu ǝnga mǝnyi,</para>
  <para style="q1" vid="MAT 10:35">mala tsu ǝnga miya sal nyi.<verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>Njir huɗa ki nyi tsu ngu nda ɗa dawa nyi.’<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>“Kalar ndǝra wu yiwu mǝnyi alaga dǝnyi a ndiya ɗa, aˈyi ja kyaga ɗa nǝɗa mai. Ətsu kalar ndǝra wu yiwu zǝr nyi alaga kwa nyi a ndiya ɗa, aˈyi ja kyaga ɗa nǝɗa mai. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Kalar ndǝra gǝra hǝri wu dladlakǝ nyi, ja dzǝgwa nu ɗa, aˈyi ja kyaga ɗa nǝɗa mai. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Kalar ndǝra wu yiwu piya ja, ju nda tini. Ndǝra gǝra yiwu piya ja arya yau, ju nda uya.<verse eid="MAT 10:39"/></para>
  <para style="s1">Thlǝr Kǝra Wu Shili Ənga Akkǝri</para>
  <para style="r">(<ref loc="MRK 9:41">Markusu 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>“Kalar ndǝra dlǝwuri hyi, a dlǝwuri ɗar ja, kalar ndǝra dlǝwuri ɗa tsu, a dlǝwuri ja ndǝra sǝwa ɗa. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Kalar ndǝra dlǝwuri nabi ara naja nabi, ju nda uya akkǝri nǝ nabi. Ətsu kalar ndǝra dlǝwuri ndǝ tsapǝu ara naja ndǝ tsapǝu, ju nda uya akkǝri nǝ ndǝ tsapǝu. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Kalar ndǝra lǝri anǝ pathlǝu wu pama wazha yiɗǝɗǝ kau, ˈyimi shishiˈwu kikiwa pathlǝu, arya naja ndǝr nu ɗa, ǝnga jiri yu nar hyi, aˈyi ju nda tini akkǝri nyi mai.”<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">Yesu Ndǝr Ar Kǝra Yahwana <optbreak/> Ndǝr Mǝl Baɓǝtizǝma</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Ayukuɗa Yesu kuɗǝna highiɓǝ anǝ zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝu, kǝ ji hyaˈari sara ndǝna, kǝ ji maˈyi ja vǝr highiɓau ǝnga tǝtǝlna ndǝr Hyal wu mǝlmǝ njir Yahudiya.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Ar pǝci kǝra Yahwana tsu ja wu fursǝna, kǝ ji nggari sǝra Kǝrsiti a vǝr mǝl, kǝ ji sǝwa zǝmbǝlma nyiˈyar a ndǝgya ja <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>ndǝ nda yiwa, “Nagǝ ngǝ ndǝra wu shili ta ya, ǝndǝga ˈya sǝkǝ vanyi ndǝ pamǝ ya?”<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Kǝ Yesu shaɗǝwa nda, ji na, “Sha mau hya nda nar nyi anǝ Yahwana sǝra hyi lari ǝnga hyi nggari. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Nji lǝfǝ wu lar sau, nji kukurɓǝ wu ɓau, njir pibi wu uya jamǝkur, kulangǝˈyar tsu ndu nggar sau, nju hyaˈana nji tǝtau ǝnga nju tǝtǝlna ndǝshigu mǝsahǝ anǝ nji ɗaɗali. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Barka anǝ ndǝra gǝra tǝkǝkǝr ǝnga mbǝrsa nyi ar kǝra yau.”<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Ayukuɗa njira Yahwana sǝwa maˈyi, kǝ Yesu dzǝguya ndǝr anǝ nji ar kǝra Yahwana, ji na, “Mi nga hyi gwa tsamǝ a gwar tagǝ ta? Hyi maˈyi a gwa tsamǝ sar dzǝdzǝgamǝu, kǝra yambaɗǝ a vǝr kǝnggǝɗǝ ya? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Ya, mi nga hyi maˈyi a gwa tsama? Ndǝra har kar mǝnahǝ ya? Awau, njir ha kar mǝmǝnahǝu, wu ki tǝl nga nda. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Kar ɗǝm ya, mi nga hyi maˈyi a nda tsama? Nabi ya? Pakatu, yu nar hyi, ndǝra ndiya nabi. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Naja ngǝ ndǝra nji tsǝfǝri ar kǝri abǝr,</para>
  <para style="q1" vid="MAT 11:10">“ ‘Kǝja yu sǝwa</para>
  <para style="q2" vid="MAT 11:10">cama ɗa wu mwa ngau,</para>
  <para style="q1" vid="MAT 11:10">ju nda fuwa sǝ wu lagu</para>
  <para style="q2" vid="MAT 11:10">kadivira ga shili.’<verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>Jiri nga yu na anǝ hyi, wu pama njira mathlǝkǝˈyi ngǝ ya patǝu, ndǝra ndiya Yahwana ǝnga dǝgal aˈyi mai. Ama alaga abangau, ndǝra ndiya ǝnga kushu wu tǝlkur Hyal a ndiya nyi ǝnga dǝgalǝu. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Mbari ar pǝcir Yahwana ndǝr mǝl Baɓǝtizǝma baˈanǝ kabangǝkau, tǝlkur Hyal a vǝr lar ɓwaɓwatǝ ara nji, njir lǝ ɓwaɓwatǝ kǝ ngu yiwu nda dlǝwuri ǝnga dǝnama. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Arya patǝr ndǝr nabiˈyar ǝnga dlaɗǝ Musa a ndǝr nda ar kǝra sǝˈyar kau, kadivira Yahwana dzǝgwa shili. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Ənga tsu, ma hyu hǝnggǝr ǝnga sǝra ndǝ na, naja ngǝ Iliya kǝra ndǝ na wu nda shili. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Ndǝra ǝnga himi nggar sau, bǝgǝ ja nggari.<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>“Ya, ǝnga mi nga nja gǝla nji kabangǝka? Abari nga nda? Nanda ǝnggǝr wazha kǝra a vǝr nggya ar sugu, nda vǝr ngga kuvwar nda, ndu na:<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>“ ‘ˈYi mbiɗiya hyi mbǝlau,</para>
  <para style="q2" vid="MAT 11:17">kǝ hyi nggǝl ara fǝl.</para>
  <para style="q1" vid="MAT 11:17">ˈYi thlǝ na nǝ tiwi,</para>
  <para style="q2" vid="MAT 11:17">ba hyi nggǝl ara dlǝwu.’<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>Ta Yahwana shili, naji wu sǝm sǝr sǝm cumu mai ǝnga naji wu sa sǝ sasa mai, ǝngwar nda, ‘Naja ǝnga mambǝl ɗǝmwaˈyu.’ <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Zǝr Ndǝ shili ju sǝm, ǝnga ju sa, ǝngwar hyi, ‘Ndǝr suna nga ja, bazhiya njir tsǝm budau ǝnga “njir bikau.” ’ Alaga abangau, patǝr njira hǝnggǝri ǝnga hahangǝkur nǝ Hyal, nda vǝr cabiya abǝr ǝnga jiri nga nyi.”<verse eid="MAT 11:19"/></para>
  <para style="s1">Mǝlmǝˈyar Kǝra Nggǝl Ara Tubi</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Kǝ Yesu kughiya kughi anǝ mǝlmǝ pamǝpamǝ kǝra ji mǝlna badǝgala sǝ dǝdǝgurˈyar a gwa, ara njir mǝlma nyiˈyar aˈyi ndǝ tubi mai. <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“Sǝr tǝhuɗǝ anǝ ngau, Korazinu! Sǝr tǝhuɗǝ anǝ ngau, Bethlesaida! Maja abǝr sǝ dǝdǝgur kǝra nji mǝliya wu gau, nji mǝliya wu Taya ǝnga Sidonu, a tubir nda tsu kaɗǝ lagur hari lǝgutǝ sǝˈyinggu ǝnga tǝwa bǝbǝr wu kǝra nda. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Ama yu na anǝ ngau, ar pǝcir numa nǝ Hyal ju nda tǝhuɗǝ ǝgya Taya ǝnga Sidonu a ndiya ngau. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Nahyi tsu njir Kafarnahumu! Hya vǝr nggani abǝr nja nda faˈar hyi a dǝmǝlmǝ ya? Awau! Nahyi ma a gyiwu kaˈu ɗǝmwaˈyi nga nju nda puwa hyi. Maja abǝr sǝ dǝdǝgur kǝra nji mǝliya wu hyi, nji mǝliya wu Sodomu, tsu nda aˈyi baˈanǝ kabangǝkau. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Ama yu na anǝ hyi, ar pǝcir numa nǝ Hyal ju nda tǝhuɗǝ ǝgya Sodomu a ndiya hyi.”<verse eid="MAT 11:24"/></para>
  <para style="s1">Shila Mau Ya Sa Nǝ Hyi Ɓǝlsar</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luka 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Ar pǝci kǝ ngǝ Yesu na, “Dǝɗa, Thlagǝ kǝra a dǝmǝlmǝ ǝnga a gyiwu ˈyi, a usa ngǝr yau, arya gǝ ɗǝwana sǝˈyar kǝ anǝ nji hahangǝ ǝnga njir sǝn sau, ba gǝ dzǝgwa cabiya nyi anǝ njira ǝnggǝr wazha yiɗǝɗǝu. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Abangǝ nga nyi Tada, arya najakǝ ca ngǝ ɗa mǝnahǝu anǝ ngau.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>“Dǝɗa a nǝ ɗar sǝ patǝu, ndǝr sǝn sǝnbiya tara wa ngǝ zǝra nyi aˈyi mai, kǝl Dǝnyi wacu, abangǝ tsu ndǝr sǝn sǝnbiya tara wa ngǝ Tada nyi aˈyi mai, kǝl zǝr nyi ǝnga njira ju yiwu ja cabiya nda.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>“Shila mau ǝgya yau, patǝ hyi njira ǝnga kar tǝdǝɓǝu, nji hǝhǝɗa, ba ya nǝ hyi ɓǝlsar. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Dlǝwura mau danggal ɗa wu gyiwuliya hyi ǝnga hya highiɓǝri ara yau, ara nayi ndǝ hangǝkal ǝnga ndǝra wu hǝya kǝrngau, ba hya sa uya ɓǝlsar anǝ ɗǝfuwa hyi. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Ara danggal ɗa kakafǝ nga nyi, kar ɗa tsu aˈyi tǝdǝɓǝ mai.”<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Yiwa Sau Ar Kǝra Ɓǝlar Pǝcir Ɓǝlsar</para>
  <para style="r">(<ref loc="MRK 2:23-28">Markusu 2:23-28</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Ar pǝci ta, vanyi pǝcir Ɓǝlsar nǝ Yahudiya Yesu ǝnga zǝmbǝlma nyiˈyar nda vǝr tǝrabiya wu fa uhi. Nda vǝr ɓau kǝ zǝmbǝlma nyiˈyar kuratsiya kǝra uhi. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Ənggǝra njir Farisi lari abangau, kǝ ndǝ na anǝ nyi, “Lari gǝyi, zǝmbǝlma ngǝˈyar nda vǝr mǝl sǝra dlaɗǝ kari nja mǝl pǝcir ɓǝlsar.”<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Kǝ ji shaɗǝwa nda, “Aˈyi hyi saya jigana sǝra Dawuda ǝnga njir ɓǝ nyi mǝliya ar pǝci kǝra wuɓǝ mbar nda ta wa? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Ənggǝra ji gwu ki Hyal, naja ǝnga njir ɓǝ nyiˈyar, ǝnga ǝnggǝra ndǝ gwa sǝmku macikǝl cicau kǝra nandu kyaga sǝm mai, kǝl pubuˈyar wacu. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Əndǝga aˈyi hyi saya jigana wu dlaɗǝ Musa, ǝnggǝra ar pǝcir ɓǝlsar pubuˈyar ɓǝlna sǝra dlaɗǝ na nja ɓǝlari wu ki Hyal, lagur thla sǝ anǝ Hyal wa, ama aˈyi ɗa bikǝ anǝ nda mai wa? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Yu na anǝ hyi ja, kǝja ndǝra wu ndiya ki Hyal ǝnga dǝgal ǝnggau. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>Ama, maja abǝr hyu sǝni sǝra ndǝr kǝ cabiya, ‘Tǝhuɗǝ nga ya yiwu, aˈyi saɗaka mai,’ nahyi aˈyi wu nǝ nyi bikǝ anǝ ndǝra gǝra ǝnga bikǝ mai. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Ara Zǝr Ndau Thlagǝ nga ja ar kǝra pǝcir ɓǝlsar.”<verse eid="MAT 12:8"/></para>
  <para style="s1">Ndǝ Ənga Tsi Ndzǝndzau</para>
  <para style="r">(<ref loc="MRK 3:1-6">Markusu 3:1-6</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Kǝ Yesu piyari viya nyi, ba ji maˈyi a gwu umbwa daɓǝ dzǝ njir Yahudiya. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>A vuna vanyi ndǝ aˈyi ǝnga tsi ndzǝndzau. Ndu yiwu nda vazǝya Yesu, ba ndǝ yiwa nyi, “A ɗar tsaˈa nja shilǝgǝbiya ndǝ pǝcir ɓǝlsar ya?”<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>Kǝ ji na anǝ nda, “Ma ɗa ndǝ aˈyi wu pama hyi kǝra ǝnga tǝmahǝ pathlǝu, ba ji tǝɗau a gu kaˈu pǝcir ɓǝlsar, thlagǝr tǝmahǝ kǝ aˈyi ju hǝbiya nyi a biya wa? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Ya, kǝja ndǝ a ndiya tǝmahǝ ǝnga mǝnahǝ gagaɗau. Agabangau, a ɗar tsaˈa nja mǝl sǝra mǝnahǝ ar pǝcir ɓǝlsar.”<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Kǝ ji na anǝ nda nyi, “Ndiɗǝbiya tsa gǝ a dumwa ngau.” Aga zǝmǝ kǝ ji ndiɗǝbiya tsa ja a dumwa nyi, ba tsa ja ɗa jamǝ ǝnggǝr vanyi zǝma nyi ta. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Ama ba njir Farisi maˈyi a biya ndǝ biya mbiya miya lagu kǝra nda sǝn tsǝya Yesu.<verse eid="MAT 12:14"/></para>
  <para style="s1">Mafa Cacaɗau Nǝ Hyal</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Ənggǝra Yesu sǝnbiya abangau, ba ji piyari viya nyi. Kǝ nji gangǝ nu nyi, ba ji shilǝgǝbiya nda patǝu. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Ji tǝɗǝr himiya nda ara nda sara na anǝ nji tara wa nga ja. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Ji mǝl sǝˈyar kǝ aga nyabiya sǝra nabi Əshaya nana ngau, abǝr:<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“Kǝja mafa ɗa kǝra nayi</para>
  <para style="q2" vid="MAT 12:18">ngǝ caɗǝbiya nyi,</para>
  <para style="q1" vid="MAT 12:18">yu yiwu nyi</para>
  <para style="q2" vid="MAT 12:18">ara ji pina huɗa yau,</para>
  <para style="q1" vid="MAT 12:18">yu nda nyana nyi</para>
  <para style="q2" vid="MAT 12:18">ǝnga Mambǝl ɗa,</para>
  <para style="q1" vid="MAT 12:18">ǝnga ju nda hǝˈuna</para>
  <para style="q2" vid="MAT 12:18">abǝr yu nda</para>
  <para style="q1" vid="MAT 12:18">numa nǝ jirkur anǝ nji patǝu.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>Naja aˈyi wu nda pa ǝnga</para>
  <para style="q2" vid="MAT 12:19">hyaˈa ɗahǝ mai,</para>
  <para style="q1" vid="MAT 12:19">ǝnga ndǝr nda nggar ɗaha ja</para>
  <para style="q2" vid="MAT 12:19">wu huɗa giwa aˈyi mai.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Naji wu nda ɓǝlna sǝra lǝhǝ ja ɓǝl mai,</para>
  <para style="q2" vid="MAT 12:20">ǝnga pitǝlla kǝra a ɗar lǝhǝ ja tau,</para>
  <para style="q1" vid="MAT 12:20">naji wu nda tsǝya mai,</para>
  <para style="q2" vid="MAT 12:20">kǝl ji lari abǝr jirkur a sǝmkuri tǝlkur.<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>Njir duniya wu nda fiya fǝrkǝr nda</para>
  <para style="q2" vid="MAT 12:21">wu thlǝmǝ nyi.”<verse eid="MAT 12:21"/></para>
  <para style="s1">Yesu Ənga Tǝl Shatan</para>
  <para style="r">(<ref loc="MRK 3:20-30">Markusu 3:20-30</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Kǝ ndǝ shili ǝnga vanyi ndǝr mǝga lǝfǝ kǝra nyinyau ǝnga mambǝl ɗǝmwaˈyu. Kǝ Yesu shilǝgǝbiya nyi, kǝl ta ju sǝn ndǝr ǝnga ju lar sau. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Ba ɗa sǝ dǝdǝgur anǝ nji patǝu, kǝ ndǝ na, “Aˈyi zǝr Dawuda ta ngǝ kǝ wa?”<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Ama ǝnggǝra njir Farisi nggari abangau, ba ndǝ na, “Ənga dǝnama nǝ Bilzabulu tǝlǝr shatan ngǝ ndǝ kǝ wu kǝdlǝ mambǝl ɗǝmwaˈyi a biya.”<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>Ta ɗa, Yesu wu sǝni sǝra ndu ɗǝnga, kǝ ji na anǝ nda, “Kalar tǝlkur kǝra tǝkǝbiya dzǝ mǝthlǝ wu taˈyi mai, ǝnga kalar mǝlmǝ ǝnga ki kǝra aˈyi hǝnggǝr ǝnga kuvwa nyi mai, nanda aˈyi wu sǝn taˈyi mai. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Ma Shatan ngu kǝdlǝ Shatan, ya, a tǝkǝbiyar ja dzau. Ya, abari ngǝ tǝlkur nyi a sǝn taˈya? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Ma ǝnga dǝnama nǝ Bilzabulu nga yu kǝdlǝ mambǝl ɗǝmwaˈyiˈyar, kar zǝmbǝlmar hyiˈyar tsu? Ənga mi nga ndu kǝdla? Agabangau, nanda ngu nda mǝl numa anǝ hyi ar kǝra sǝˈyar kau. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Ama ma ɗa ǝnga dǝnama nǝ Hyal nga ya vǝr kǝdlǝ mambǝl ɗǝmwaˈyiˈyar kau, a ɗari abǝr tǝlkur Hyal a shiliri anǝ hyi.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>“Ənga jiri, ndǝr sǝn vu ki ndǝr dǝnama ja vuwa faˈana kar nyi aˈyi mai, kǝl tanggǝrma ji mbiya ndǝr dǝnama kau. Ja dzǝgwa sǝn faˈar kar nyi.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>“Ndǝra gǝra ǝnga yau, dawa ɗa ngau, ǝnga ndǝra gǝra a vǝr kaɓǝ ǝnga yau, tǝtǝlna nga ja vǝr tǝtǝlna. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Agabangau, yu na anǝ hyi, kalar bikau ǝnga ndǝr diɗa Hyal ju nda tǝfǝbiya nyi anǝ nji. Ama ndǝra ndǝr diɗa ar kǝra Mambǝl Cicau, naji wu uya tǝfǝbiya dzǝ mai. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Ma ndǝra ndǝr diɗa ar kǝra Zǝr Ndau, nju nda tǝfǝbiya nyi. Ama ndǝra ndǝr nǝ diɗa ar kǝra Mambǝl Cicau, naji wu uya nja tǝfǝbiya nyi mai, alaga kabangǝkau ǝnga zaman kǝra a vǝr shili.<verse eid="MAT 12:32"/></para>
  <para style="s1">Wu Ənga Yayar Wu</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>“Mǝliya wu mǝnahǝu ba yayar wa nyi a ɗa mǝnahǝu. Ga mǝliya wu ɗǝmwaˈyi tsu ba yayar wa nyi a ɗa ɗǝmwaˈyu, ara ar yayar wu nga nju tsamǝr wu. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Nahyi daɓǝ mǝtsapaˈyar, lagu mani nga hyi, nahyi njira ɗǝmwaˈyi a sǝn nana sǝra mǝnaha? Ara sǝra wu ɗǝfu ca ngǝ miya wu nana. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Ndǝ mǝnahǝu, ju biya ǝnga ndǝr mǝnahǝu sara ar vira ji ɗǝwana ari, ǝnga ndǝ ɗǝmwaˈyu, ju biya ǝnga ndǝr ɗǝmwaˈyu sara ar vira ji ɗǝwana nda ari. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Ama yu na anǝ hyi, ar pǝcir numa kalar ndu nda lǝri sakida ar kǝra kalar ndǝr didiɗi kǝra biya sara wu miya ja. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Ara arya ndǝr kǝra biya sara wu miya gau, nga nju nda mǝl numa anǝ ngau, tara nǝ pǝlna ngau ǝnga nǝ mbiya ngau.”<verse eid="MAT 12:37"/></para>
  <para style="s1">Malǝmǝ Dlaɗǝˈyar Ənga Njir Farisi <optbreak/> Wu Gal Mǝtsamǝ</para>
  <para style="r">(<ref loc="MRK 8:11-12">Markusu 8:11-12</ref>; <ref loc="LUK 11:29-32">Luka 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Kǝ alenyi malǝmǝ dlaɗǝˈyar ǝnga njir Farisi na anǝ nyi, “Malǝmǝ, ˈyi wu yiwu ga mǝliya ˈya sǝ dǝdǝgur kǝra wu ɗa mǝtsamǝ sara ara gau.”<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Kǝ ji shaɗǝwa nda, ji na, “Nji nǝ zaman kau, nji ɗǝmwaˈyu, nji gǝra hivǝr Hyal. Ndu yiwu nda lari mǝtsamǝ nǝ sǝ dǝdǝgur. Ama mǝtsamǝ nǝ sǝ dǝdǝgur aˈyi kǝra yu ca anǝ nda mai, kǝl mǝtsamǝ ar kǝra nabi Yunana. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Ara ǝnggǝra Yunana mǝliya pida makǝr vuˈyi ǝnga puci wu ta kalfi dǝgalǝu, abangǝ ngǝ Zǝr Ndu nda mǝliya a gyiwu huɗa ˈyiˈyi. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Ara ar pǝcir numa, njir Niniva wu nda hyaˈari ǝnga njir zaman kau, ba nda canǝ nda abǝr nanda aˈyi mǝliya sǝra kakalǝ mai, arya nanda njir Niniva tubi ar pǝcira Yunana tǝtǝlna nda ndǝr Hyal. Ya, kǝja ndǝra ndiya Yunana aˈyi ǝnggau. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Ar pǝcir numa, kwatam Shiba wu nda hyaˈari ǝnga njir zaman kau, ja cabiya nda abǝr nanda aˈyi mǝliya sǝra kakalǝ mai, ara ji hyaˈari sara ar kuɗiyar duniya vira naɗǝu aga ja sa nggar ndǝr tsǝtsǝlkur nǝ Tǝl Solomanu. Ya, kǝja ndǝra ndiya Solomanu aˈyi ǝnggau.<verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>“Ma nji kǝdlǝbiya mambǝl ɗǝmwaˈyi a biya sara wu dza ndau, ma ji gal vir sǝ hǝɗa katini, <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>ju sǝn na, ‘Ya ɓǝra sha a ndu dza ndǝra yi biya sara a gwa.’ Ma ji ɓǝra sha shili, ba ji sa thlǝwa dzǝ kau, nji tsǝkǝbiya camǝu, ǝnga kalar sǝ wu lagu, <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Ba ja ɓǝra sha, ja nda faˈari mambǝlˈyar pamǝpamǝ mǝɗǝfǝ kǝra ndiya nyi ǝnga shishikur, ba nda maˈyi a vu ja nda vuwa nggya. Ba nggyabiya ndǝ kǝ nǝ yukuɗǝu, a ndiya nǝ tanggǝrma ǝnga ɗǝmwaˈyu. Abangǝ nga nyi wu nda ɗa anǝ nji zaman kau.”<verse eid="MAT 12:45"/></para>
  <para style="s1">Miya Yesu Ənga Zamǝ Nyiˈyar</para>
  <para style="r">(<ref loc="MRK 3:31-35">Markusu 3:31-35</ref>; <ref loc="LUK 8:19-21">Luka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Tsu ja vǝr ndǝr ǝkkǝˈyi dlamir nji, kǝja mǝnyi ǝnga zamǝ nyiˈyar shili a biya ndu yiwu nda ndǝr anǝ nyi. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Kǝ vanyi ndǝ na anǝ nyi, “Kǝja mǝngau ǝnga zamǝ ngǝˈyar a biya ndu yiwu nda ndǝr ǝnga gau.”<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Kǝ ji shaɗǝwa nyi anǝ ndǝ kau, ji na, “Wa ngǝ maɗa, ǝnga wa ngǝ zamǝɗaˈyara?” <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Kǝ ji ca zǝmbǝlma nyiˈyar ǝnga tsa ja, ji na, “Kǝja maɗa ǝnga zamǝɗaˈyar. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Ara kalar ndǝra wu mǝl thlǝr ǝnga sǝra dǝɗa kǝra a dǝmǝlmǝ wu yiwu, naja ngǝ zamǝ ɗa ǝnga kwamǝ ɗa ba maɗa.”<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Karapau Ar Kǝra Ndǝr Sǝ Culi</para>
  <para style="r">(<ref loc="MRK 4:1-9">Markusu 4:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Ar pǝci ta Yesu biya sara wu ki, ji biya nggya ar miya dǝl. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Dlamir nji gangǝ kaɓau ba ndǝ zǝwari nyi, kǝl ta ji nda gwu kwambwal ji gwa nggya gya, ba dlamir nji nggya nǝr nda a miya dǝl. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Kǝ ji nar nda sǝ pamǝpamǝ lagu karapau, ji na, “Vanyi ndǝr zǝwa maˈyi a gwar fa nyi, a gwa sǝ culi. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Ənggǝra ja vǝr sǝ culi, kǝ alenyi pǝnakǝr ar lagu. Kǝ ˈyagǝˈyar shili ba ndǝ sa sǝmku nda. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Kǝ alenyi pǝnakǝr ar vi cacathlǝu, vira ˈyiˈyi aˈyi gangǝ mai. Ba ndǝ tsau aga zǝmǝu, ara ˈyiˈyi kǝra ar kǝra nyi aˈyi tǝdǝɓǝ mai. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Ama ǝnggǝra pǝci ɗa kwakwaɗǝ gagaɗau, ba ndǝ titiˈwa ba ndǝ ul ara nggyilangǝ aˈyi ara nda gagaɗǝ mai. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Kǝ alenyi tǝɗǝ a gyiwu pama shikǝɗi, ndǝ hǝ ǝnga nda, ba shikǝɗi kar nda ara pǝli. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Alenyi culi tsu tǝɗǝ a gyiwu ˈyi kǝra mǝnahǝu, ndǝ hau, ba ndǝ puwa li gangǝ gagaɗau, alenyi gharu gharu, ǝnga alenyi kwakumunyi kwakumunyi ǝnga alenyi tsu makǝrkumunyi makǝrkumunyi. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Ndǝra ǝnga himi nggar sau, bǝgǝ ja nggari.”<verse eid="MAT 13:9"/></para>
  <para style="s1">Sǝra Karapau Nǝ Sǝ Culi Kǝ Cabiya</para>
  <para style="r">(<ref loc="MRK 4:10-12">Markusu 4:10-12</ref>; <ref loc="LUK 8:9-10">Luka 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Kǝ zǝmbǝlma nǝ Yesu ˈyar shili ndǝ sa yiwa nyi, “Mi ngǝ ɗa gu ndǝr anǝ nda ǝnga karapǝˈyar ka?”<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Kǝ ji shaɗǝwa nda, ji na, “Sǝnbiya sǝ kǝra ɗǝɗǝwa nǝ tǝlkur Hyal a nǝ hyir nji, ama aˈyi anǝ nda mai. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Ndǝra ǝnga sau nju cakǝri nyi, aga ja uya gangǝu. Ama ndǝra gǝra ǝnga sau, alaga kǝra aˈyi ara ja kushu nju ɓǝra dlǝwuri. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Sǝra ɗa yu ndǝr anǝ nda ǝnga karapau.</para>
  <para style="q1" vid="MAT 13:13">“Aga ndu tsamǝ ama nandǝ</para>
  <para style="q2" vid="MAT 13:13">wu tsambiya mai,</para>
  <para style="q1" vid="MAT 13:13">ndu sǝhimi ama nandǝ</para>
  <para style="q2" vid="MAT 13:13">wu nggari mai ǝnga nandǝ</para>
  <para style="q1" vid="MAT 13:13">wu nggabiya mai.<verse eid="MAT 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14"/>Lagu kǝ ngǝ ndǝr nabi Əshaya nyabiya dzǝ ar kǝra nda abǝr,</para>
  <para style="q1" vid="MAT 13:14">“ ‘Hyu nda dumwa</para>
  <para style="q2" vid="MAT 13:14">ǝnga ngga ama nahyi</para>
  <para style="q1" vid="MAT 13:14">wu nggabiya mai,</para>
  <para style="q2" vid="MAT 13:14">hyu nda tsamǝ ama nahyi</para>
  <para style="q2" vid="MAT 13:14">wu tsambiya mai.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Ara ɗǝfuwa nji kǝ a ɗar ɓaɓalu,</para>
  <para style="q2" vid="MAT 13:15">himiya nda tsu wu nggar sǝ mai,</para>
  <para style="q1" vid="MAT 13:15">ǝnga ndǝ haɗiya liya nda,</para>
  <para style="q2" vid="MAT 13:15">ara nda sara lar sǝ ǝnga liya nda,</para>
  <para style="q1" vid="MAT 13:15">nda nggari ǝnga himiya nda,</para>
  <para style="q2" vid="MAT 13:15">ǝnga nda nggabiya ǝnga ɗǝfuwa nda,</para>
  <para style="q1" vid="MAT 13:15">nda sha shili ǝgya yau,</para>
  <para style="q2" vid="MAT 13:15">ya mbǝɗana nda.’<verse eid="MAT 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16"/>Nahyi nǝr hyi, barka anǝ liya hyi ara ndu lar sau, ǝnga himiya hyi ara ndu nggar sau. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Yu nar hyi jiri, nabiˈyar gangǝu ǝnga nji cicau, a yiwur nda, nda lari sǝˈyar kǝ hyu lar kau, ama nandǝ lari mai. A yiwur nda, nda nggari sǝˈyar kǝ hya vǝr nggar kau, ama nandǝ nggari mai.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>“Kǝja sǝra karapǝ ar kǝra ndǝr sǝ culi kǝ cabiya: <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Ma ndǝ nggar ndǝr nǝ tǝlkur Hyal ama naji nggabiya mai, ba Shatan a shili ja faˈabiya sǝra ji nggari kǝ sara wu ɗǝfuwa ja. Naja kǝ ngǝ cabiya culi kǝra pǝnakǝr ar lagu. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Kǝra pǝnakǝr ar vi cacathlǝ ǝtsu, naja ngǝ nju gǝla ǝnga ndǝra nggari ndǝr Hyal, ba ji dlǝwuri aga zǝmǝ ǝnga huɗǝ pǝrtǝu. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Ama ara naja aˈyi ǝnga nggyilangǝ mai, ba ji sǝkar nǝ pǝci kushu. Ənggǝra ɓwaɓwatǝ shili anǝ nyi arya ndǝr Hyal, ba ji sha a gyiwu yukuɗǝ ǝnga kusa. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Culi kǝra nji sǝna wu pama shikǝɗi kǝ tsu, naja ngǝ nju gǝla ǝnga ndǝra nggari ndǝr Hyal, ama kǝ nggyabiya duniya ǝnga gal gǝnna kari ndǝra nyi ara hau, kǝl ta ji ɗa gǝra ǝnga akkǝri. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Culi kǝra nji sǝna ar ˈyiˈyi mǝnahǝ kǝ tsu, naja nga nju gǝla ǝnga ndǝra nggari ndǝr Hyal ba ji nggabiya. Ju ɗa ǝnga akkǝri, ju puwali, alenyi gharu gharu, ǝnga alenyi kwakumunyi kwakumunyi ǝnga alenyi tsu makǝrkumunyi makǝrkumunyi.”<verse eid="MAT 13:23"/></para>
  <para style="s1">Karapau Ar Kǝra Hyanggili</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Yesu ɓǝra nar nda vanyi karapau, ji na, “Kǝja sǝra nja sǝn gǝlabiya tǝlkur Hyal ǝni, ǝnggǝr vanyi ndǝ kǝra thlǝkana culi mǝnahǝu wu fa nyi. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Ama pǝci kǝra nju ghanyi, ba dawa nyi shili ka sa thlǝkana hyanggili wu fa nyi a ndu pama uhi, ba ji maˈyi sǝ nyi. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Ar pǝci kǝra uhi kǝra nji thlǝkana kǝ hau, ndǝ mǝliya kǝr, ba hyanggili hyaˈari tsu.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>“Mafa nyiˈyar shili ndǝ sa na anǝ nyi, ‘Thlagǝr ki, aˈyi culi mǝnahǝ nga gǝ thlǝkana wu fa ngǝ wa? Ya, lagu mani ngǝ hyanggiliˈyar kǝ tsǝ ari ka?’<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>“Kǝ ji na anǝ nda, ‘Dawa ngǝ mǝliya abangau.’ Kǝ mafaˈyar kǝ yiwa nyi, ‘Ya, gu yiwu ˈya maˈyi ˈya gwa kukucina nda ya?’<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>“Ama kǝ ji shaɗǝwa nda, ‘Awau, ara a vǝr kuci hyanggila nyi, ba hya kucina daɓǝ ǝnga uhi. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Piyar nda mau nda hǝ gyapǝu kǝl pǝcir fwahǝu. Ar pǝci ta yu nar nyi anǝ njir mǝl thlǝr. Tanggǝrma, nda dzǝguya ǝnga hyanggila nyiˈyar, nja kaɓiya nja nggyina nda. Ba nja dzǝgwa gǝmna uhi ba nja faˈana a su tsamǝ.’ ”<verse eid="MAT 13:30"/></para>
  <para style="s1">Karapau Ar Kǝra Culi Bǝla</para>
  <para style="r">(<ref loc="MRK 4:30-32">Markusu 4:30-32</ref>; <ref loc="LUK 13:18-19">Luka 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Yesu ɓǝra nar nda vanyi karapau, “Tǝlkur Hyal ǝnggǝr culi bǝla nga nyi, kǝra vanyi ndǝ hǝri ji thlǝkana wu fa nyi. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Naja nga ndiya patǝr culi ǝnga kushu, ama ma ji hau, ba ja ndiya patǝkura wu kǝra wu masǝmǝ ǝnga dǝgalǝu, ba ˈyagǝˈyar a liya kir nda ar tsa nyi.”<verse eid="MAT 13:32"/></para>
  <para style="s1">Karapau Ar Kǝra Thlǝlamǝ</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luka 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Yesu ɓǝra nar nda vanyi karapau, ji na, “Tǝlkur Hyal ǝnggǝr thlǝlamǝ nga nyi, kǝra mala hǝri ji gwaɗǝbiya ǝpou tasaˈwu tǝkǝ sǝ makǝr ǝni, ba ja dzǝgwa thlǝthlǝ gagaɗau.”<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Yesu nar nyi najaka ndǝr patǝ anǝ daɓǝr dlami lagu karapau. Sǝ aˈyi ji nar nda zǝmǝ gǝra ǝnga karapǝ mai. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Lagu kǝ nga ji nyabiya sǝra nabi Əshaya nana abǝr,</para>
  <para style="q1" vid="MAT 13:35">“Yu nda pahǝna miya,</para>
  <para style="q2" vid="MAT 13:35">yu ndǝr ǝnga karapau,</para>
  <para style="q1" vid="MAT 13:35">Yu nda cabiya nyi</para>
  <para style="q2" vid="MAT 13:35">anǝ nji sǝra ɗǝɗǝwa</para>
  <para style="q1" vid="MAT 13:35">mbar dzǝgwar duniya</para>
  <para style="q2" vid="MAT 13:35">aga nda sǝnbiya.”<verse eid="MAT 13:35"/></para>
  <para style="s1">Yesu Nar Nda Sǝra Hyanggili <optbreak/> Wu Fa Uhi Aga Nyi</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Kǝ Yesu piyari dlamir nji, ji maˈyi a vu huɗa ki. Zǝmbǝlma nyiˈyar shili ǝgya ja ndǝ sa na anǝ nyi, “Nar ˈya sǝra hyanggili wu fa uhi kǝ aga nyi.”<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>Kǝ ji shaɗǝwa nda, ji na, “Ndǝra thlǝkana culi mǝnahǝ naja ngǝ Zǝr Ndau. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Fa uhi kǝ ca ngǝ duniya, culi mǝnahǝ ca ngǝ wazha nǝ tǝlkur Hyal. Hyanggili kau, ca ngǝ wazha Shatan. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Dawa kǝra thlǝkana hyanggili kau, naja ngǝ Shatan ǝnga kǝrnyi. Pǝcir fwahǝu ca ngǝ kuɗiyar duniya. Njir gǝm uhi nanda ngǝ waladiˈyar.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>“Ənggǝr kǝra nju tsǝmiya jigwal nja nggyina, abangǝ nga nyi wu nda ɗa pǝcir kuɗiyar duniya. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Zǝr Ndu nda sǝwa waladi nyiˈyar aga nda faˈabiya kalar sǝra wu dla ǝnga bikau ǝnga njir mǝl sǝ ɗǝmwaˈyi sara wu tǝlkur nyi. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>Nda dzǝgwa vakuwa nda a gwu uˈur kǝtsa, a guna nda dzǝgwa wau ǝnga ɗǝ hira nda. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Ar pǝci ta ngǝ njir mǝl thlǝr kǝra tsapǝ wu nda mbǝl ǝnggǝr pǝci wu tǝlkur dǝrnda. Njira ǝnga himi nǝ nggar sau, taˈyi nda nggari.<verse eid="MAT 13:43"/></para>
  <para style="s1">Bǝrba Kǝra Ɗǝɗǝwa</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>“Tǝlkur Hyal ǝnggǝr bǝrba nga nyi kǝra nji ɗǝwana wu huɗa fa. Ta vanyi ndǝ nǝri, ba ji ɓǝra ɗǝwana wayu. Ara ǝnggǝra huɗa ji pida, ba ji maˈyi ji nda ɗǝlna patǝr sǝra ara ja, ba ji dzǝgwa ɗǝlbiya fa nyi.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>“Ətsu, tǝlkur Hyal ǝnggǝr ndǝr ɗǝlna sǝ nga nyi kǝra a vǝr gal handzǝlkwa. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Ta ji thlǝwa kǝra nju ɗǝl ǝnga gǝnna gangǝu, ba ji maˈyi ji nda ɗǝlna patǝr sǝra ara ja, ba ji sa ɗǝlbiya.<verse eid="MAT 13:46"/></para>
  <para style="s1">Karapau Ar Kǝra Litagǝu</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>“Ətsu wayu, tǝlkur Hyal ǝnggǝr litagǝ kǝra nji fuwa a gwu dǝl nga nyi kǝra mbari culi kalfi pamǝpamǝ gangǝu. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Ənggǝra ji nyau ǝnga kalfi, kǝ njir tǝm hǝbiya a biya miya dǝl. Kǝ ndǝ dzǝgwa nggya gya ndǝ ɗǝmbiya kalfi kǝra mǝnahǝu ndǝ puwa a gu bǝngǝ, ba ndǝ dzǝgwa pǝna ɗǝmwaˈya nyi. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Abangǝ nga nyi wu nda ɗa ar pǝcir kuɗiyar duniya. Waladiˈyar wu nda shili nda sa tǝkǝbiya nji ɗǝmwaˈyi ǝnga nji tsapǝu. <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>Ba nja dzǝgwa vakuwa nda a gwu uˈur kǝtsa, a guna nda dzǝgwa wau ǝnga ɗǝ hira nda.<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>“A nggabiyar hyi sǝˈyar kǝ patǝ ya?” Yesu yiwar nda.</para>
  <para style="p" vid="MAT 13:51">“Angǝ,” ǝngwar nda.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Kǝ ji na anǝ nda, “Agabangǝ kalar malǝmǝ dlaɗǝ kǝra nji highiɓǝr nyi sǝ ar kǝra tǝlkur Hyal, ǝnggǝr thlagǝr ki nga ja kǝra gwu umbwa nyi, ji gwa faˈabiya bǝrba mafǝliyangǝ ǝnga bǝrba hahal a biya.”<verse eid="MAT 13:52"/></para>
  <para style="s1">Nji Nggǝl Ara Dlǝwu Yesu Wu Nazǝratu</para>
  <para style="r">(<ref loc="MRK 6:1-6">Markusu 6:1-6</ref>; <ref loc="LUK 4:16-30">Luka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Ənggǝra Yesu kuɗǝna na karapǝˈyar kau, ba ji piyari vi ta. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Shilir Yesu wu mǝlmǝ nyi, ba ji dzǝguya highiɓǝ anǝ nji wu umbwa daɓǝ dzǝ njir yahudiya. Ba ɗa sǝ dǝdǝgur anǝ nda, ndǝ na, “Əmani ngǝ ndǝ kǝ uya sǝnbiya sǝ ka, ǝnga dǝnama nǝ mǝl sǝ dǝdǝgurˈyar ka?” <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>“Aˈyi zǝr ndǝr ta wu ta ngǝ wa? Aˈyi mǝnyi nga nju ngga ǝnga Maryamu ta wa? Aˈyi zamǝ nyiˈyar ngǝ Yakubu ǝnga Yusufu ǝnga Simanu ba ǝnga Yahuda wa? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Kwamǝ nyiˈyar aˈyi nda ǝkkǝˈyi mǝn ǝnggǝ wa? Ya, sara mani nga ji uya patǝkura sǝˈyar ka?” <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Ba huɗa nda ndzǝ ǝnga ja. Ama kǝ Yesu na anǝ nda, “Kǝl wu mǝlmǝ nyi, ǝnga wu pama nji nyi, ba wu ki nyi nga nji gǝra ha kǝra nabi.”<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>Naji ɓǝra mǝl sǝ dǝdǝgurˈyar gangǝ wu pama nda mai, ara ghar mbǝrsar nda.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Nji Thlana Kǝra Yahwana <optbreak/> Ndǝr Mǝl Baɓǝtizǝma</para>
  <para style="r">(<ref loc="MRK 6:14-29">Markusu 6:14-29</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Ar pǝci kǝ ngǝ tǝl Hirudusu nggari ndǝr ar kǝra Yesu. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Kǝ ji na anǝ njir mǝl thlǝr nyi, “Ndǝ kau, Yahwana ndǝr mǝl Baɓǝtizǝma ngau, a hyaˈari ja sara vir tau, ca ngǝ sǝra ɗa ji uya dǝnama nǝ mǝl sǝ dǝdǝgurˈyar kau.”<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>Arya ɗǝɗǝmǝu Hirudusu mbari Yahwana, ba ji mbiya nyi, kǝ ji fuwa nyi wu fursǝna arya Hirudiyasu, mala zamǝ nyi Fǝlipǝu. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Ara ɗǝɗǝmǝu Yahwana wu na anǝ Hirudusu abǝr a ɓǝlnar ja dlaɗau ara ji hǝri Hirudiyasu aga mala nyi.” <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Hirudusu wu yiwu ja tsǝya Yahwana, ama ju hivǝr ara nji, ara ndǝ hǝr Yahwana ar viya nabi.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>Ar pǝcir mini nǝ ɗǝngari pǝcir ya nǝ Hirudusu, ngǝ kwar Hirudiyasu fǝl anǝ nji, ba fǝl kǝ pina huɗa Hirudusu gagaɗau. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Arya kau, kǝ ji hǝr alkawal daɓǝ ǝnga sǝm fǝla, abǝr, ju nǝ nyi kalar sǝra ji yiwa ara ja. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Kǝ mǝnyi nar nyi sǝra ja yiwa, kǝ ji na, “Nǝ ɗa nji kǝra Yahwana ndǝr mǝl Baɓǝtizǝma ar pǝli.” <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Kǝ sǝ kǝ ɓwanǝ nyi kǝr gagaɗau, ama arya alkawal ǝnga sǝm fǝla kǝra ji hǝri, ǝnga mǝthlǝpi nyiˈyar kǝra aˈyi ǝnga ja, naji wu yiwu ja kar nyi mai. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Kǝ ji sǝwa a vu fursǝna aga nja vuwa thlana kǝra Yahwana. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Ji shili ǝni ar pǝli, ji sa nǝ nyi anǝ zǝr kwa nyi, kǝ ji nǝ nyi anǝ mǝnyi. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Kǝ zǝmbǝlma Yahwana ˈyar shili ndǝ sa hǝri dza ja. Ba ndǝ nda haɗǝna. Kǝ ndǝ maˈyi ndǝ nda nar nyi anǝ Yesu.<verse eid="MAT 14:12"/></para>
  <para style="s1">Yesu Sǝmǝna Nji Dubu Tǝfu</para>
  <para style="r">(<ref loc="MRK 6:30-44">Markusu 6:30-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yahwana 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Ənggǝra Yesu nggari abangau, ba ji hyaˈari ji gwu kwambwal. Kǝ ji tǝrabiya a ndar vira nji aˈyi ari mai aga ja nda nggya zhizhi nyi. Ama ǝnggǝra dlamir nji nggari abangau, ba ndǝ hyaˈari sara wu mǝlmǝ pamǝpamǝ ndǝ nu nyi ǝnga hi. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Ənggǝra Yesu biya sara wu kwambwal, ba ji lari dlamir nji gangǝu. Ənggau, ba ji tǝhuɗǝ ǝgya nda, ba ji shilǝgǝbiya njira gǝra ngga wu pama nda.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Ənggǝra wagǝ ɗa, kǝ zǝmbǝlma nyiˈyar shili ara ja, ndǝ na, “Vi kǝ nji aˈyi a gwa mai, ǝnga tsu vi a ɗar dlǝru. Tǝtǝlna nji kau, tara ba nda maˈyi a ndu huɗa giwa kǝra zǝwar vi kǝ nda ɗǝlbiya sǝr sǝm anǝ kǝrnda, aga nda sǝmku.”<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Kǝ Yesu na anǝ nda, “Aˈyi mbari kǝl nda maˈyi mai, nǝ nda mǝ sǝ kǝra nda daɓaga sǝn sǝm.”<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>Kǝ ndǝ shaɗǝwa nyi, ndǝ na, “Sǝ aˈyi kǝra tsaˈa ˈya nǝ nda mai, kǝl lǝgu ɗǝfǝ tǝfu ǝnga kalfi mǝthlǝ ngǝ aˈyi wacu.”<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>Kǝ ji na, “Shila mǝ ǝni.” <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Kǝ ji nar nyi anǝ nja nyi nda nggya gya ar sar. Ji hǝri lǝgu ɗǝfǝ tǝfu ǝnga kalfi mǝthla nyi, ba ji hyaˈanakǝr a dǝmǝlmau, kǝ ji usaku anǝ Hyal, ba ji ɓǝɓǝlǝwa nda. Kǝ ji dzǝgwa nǝ nyi anǝ zǝmbǝlma nyiˈyar, nanda tsu, kǝ ndǝ tǝkǝna nyi anǝ dlamir nji. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Patǝkura nda sǝm ndǝ nyau. Kǝ zǝmbǝlma nyiˈyar tsǝmiya tsǝla kumo apǝ mǝthlǝ ǝnga sǝra hiyau sara wu miya nda. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Njira sǝm sǝ kau, shili zhizhir nda nji dubu tǝfu ngau. Ama nji jiga mathlǝkǝˈyi ǝnga wazha mai.<verse eid="MAT 14:21"/></para>
  <para style="s1">Yesu Ɓau A Dar Kǝra ˈYimi</para>
  <para style="r">(<ref loc="MRK 6:45-52">Markusu 6:45-52</ref>; <ref loc="JHN 6:15-21">Yahwana 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Ənggǝrna, kǝ Yesu fuwa zǝmbǝlma nyiˈyar a gwu kwambwal aga nda tǝrabiya wu mwa nyi a biyar ya dǝl. Naja nǝ nyi, kǝ ji taˈyi wu yukuɗǝ aga ja sǝwa dlamir nju lagu. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Ayukuɗa ji sǝwa dlamir nji ndǝ maˈyi, ba ji maˈyi sǝ nyi a dar kǝra mau aga da ndǝr ǝnga Hyal. Ənggǝra wagǝ ɗa, tsu ja a dar kǝra mǝ zhizhi nyi.<verse eid="MAT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24"/>Ar pǝci kau, kwambwal a gwar hada dǝl nga nyi, kǝja dlǝgwamǝr ˈyimi wu tsatsa nyi ǝnga yambaɗǝ wu ka nyi ara ɓau.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>Ənggǝr saka makǝr nǝ vuˈyi, kǝja Yesu a vǝr ɓau, a ndǝgya nda a dar kǝra ˈyimi. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Ənggǝra zǝmbǝlma nyiˈyar lari nyi a vǝr ɓǝ a dar kǝra ˈyimi, ba hivǝr mbar nda gagaɗau. “Dǝgur ngǝ canǝ mǝn kǝr,” ǝngwar nda, ba ndǝ mbar wau ara hivǝr.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Ama ǝnggǝrna kǝ Yesu nar nda, “Hya sara ɓukǝr anǝ kǝrhyi mai! Nayi ngau. Hya sara hivǝr mai.”<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Əngwar Biturusu anǝ nyi, “Thlagǝu, ma nagǝ ngau, nar ɗa ya ndara gau, a dar kǝra ˈyimi kau.”<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>“A ndau,” ǝngwar Yesu. Kǝ Biturusu biya sara wu kwambwal, ji mbar ɓǝ a ndǝgya Yesu. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Ama ta ji lari yambaɗǝ a vǝr sǝ ǝnga dǝnama, ba hivǝr mbari nyi, ba ji mbar gya cau. Kǝ ji wau, ju na, “Thlagǝu, mbǝɗana ɗa!”<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Aga zǝmǝ kǝ Yesu hari nyi tsi, ba ji mbari nyi. Əngwar ja, “Nagǝ ndǝ tǝtǝwa mbǝrsa, mi ngǝ ɗa gǝ tǝkǝ kǝra?”<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Ənggǝra ndǝ gwu kwambwala nyi, kǝ yambaɗǝ kǝ taˈyau. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Kǝ njira gwu kwambwal dlǝvǝ Yesu, ndu na, “Ənga jiri nagǝ Zǝr Hyal ngau.”<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Ayukuɗa ndǝ tǝrabiya a biyar ya dǝl, ba ndǝ gya wu mǝlmǝ Janisaratu. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Ta njir mǝlma nyi tsamǝri abǝr Yesu ngau, ba ndǝ sǝwa nja nar nyi anǝ njir ˈyiˈya nyi patǝu, aga nda shili ǝnga njira gǝra ngga anǝ nyi. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Ndǝ sa kǝdi nyi aga nji gǝra ngga nda tsǝkwari alaga miya cira lǝgutǝ nyi. Patǝkura njira tsǝkwar nyi, ba ndǝ ɗa jamǝu.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Kǝbǝkwatǝu Nǝ Njira Nggurǝm</para>
  <para style="r">(<ref loc="MRK 7:1-13">Markusu 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Kǝ alenyi njir Farisi ǝnga malǝmˈyar nǝ dlaɗau, shili ǝgya Yesu sara wu Urshalima ndǝ sa yiwa nyi, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“Mi ngǝ ɗa zǝmbǝlma ngǝˈyar wu ɓǝla kǝbǝkwatǝu nǝ njira nggurǝm nǝ mǝlmǝ maya? Nandǝ wu ci tsi divira nda sǝm sǝr sǝm mai.”<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Kǝ Yesu shaɗǝwa nda, ji na, “Mi ngǝ ɗa hyu ɓǝlna sǝra Hyal na nja ɓǝlari, aga hya ɓǝlari sǝra ǝjir hyu na? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Ara Hyal nana wu ndǝr nyi, ‘Ga gǝnggǝr nyi sǝli anǝ dǝngau ǝnga mǝngau.’ Ənga tsu, ‘Ma ndǝra nggǝliya dǝnyi ǝnga mǝnyi kǝl nja tsǝya nyi.’ <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Ama hyu highiɓau, abǝr, ndu sǝn na anǝ dǝnyi ǝnga mǝnyi, ‘Kalar dlǝwa dzǝ kǝra hya kyaga uya ara yau, a nǝ nyir yau anǝ Hyal,’ <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>naja aˈyi a sǝn ‘gǝnggǝr nyi sǝli anǝ dǝnyi’ ǝtsu mai. Agabangau, ba hyi mǝliya ndǝr Hyal ɗa sǝ kurthlǝu lagur sǝr cijir hyi. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Nahyi nji batal! Jiri nga nyi ǝnggǝra nabi Əshaya nana ndǝr ar kǝra hyi abǝr,<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>“ ‘Nji kǝ ndu gǝnggǝr ɗa sǝli</para>
  <para style="q2" vid="MAT 15:8">ǝnga miya nda wacu,</para>
  <para style="q1" vid="MAT 15:8">ama ɗǝfuwa nda</para>
  <para style="q2" vid="MAT 15:8">a maˈyiri naɗǝ ara yau.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>Ndu dlǝvǝ ɗa ar cicir miya nda,</para>
  <para style="q2" vid="MAT 15:9">ndu highiɓǝ lagu dlaɗǝ</para>
  <para style="q2" vid="MAT 15:9">kǝra ndǝ ngǝ mǝliya, abǝr ca ngǝ ndǝr Hyal.’ ”<verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Kǝ Yesu ngga dlamir nji a shili wu dzǝ nyi, ji na anǝ nda, “Siya ɗa mǝ himi patǝ hyi, aga hya nggabiya sǝ kau. <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Sǝr sǝm kǝra ndu fuwa a gwu miya ja a sǝn mǝliya ndǝ ‘dedeɓǝ’ wu mwar Hyal mai, ama sǝra biya sara wu ndǝ ngu mǝliya ndǝ ‘dedeɓǝ’ wu mwar Hyal.”<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Kǝ zǝmbǝlmaˈyar shili ara ja ndǝ sa yiwa nyi, “A sǝni gǝ abǝr huɗa njir Farisi ndzǝndzǝ nga nyi ǝnga gau, ǝnggǝra ndǝ nggar ndǝr kǝ ya?”<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Kǝ Yesu shaɗǝwa, ji na, “Kalar sǝ thlǝthlǝka kǝra aˈyi dǝɗa kǝra a dǝmǝlmǝ ngǝ thlǝkana mai, ba nja kucina. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Piyari nda mau. Nanda ǝnggǝr nji lǝfǝ ngau a vǝr tǝɗǝmwa anǝ alenyi nji lǝfau. Patǝkura nda, ndu pǝpau a gu kaˈu.”<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>Kǝ Biturusu na anǝ nyi, “Nar ˈya sǝra karapǝ kǝ cabiya.”<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>Kǝ Yesu na, “Kar ya, tsu hyi dza ya?” <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>“Aˈyi hyu sǝni abǝr sǝra gwu miya ndau wu tǝrabiya a gyiwu ta ja, ba ja dzǝgwa tǝrabiya a biya wa? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Ama sǝra biya wu miya ndau, sara wu ɗǝfuwa ja nga nyi wu biya. Ca ngu mǝliya ndǝ ‘dedeɓǝu.’ <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Ara sara wu ɗǝfuwa ndǝ ngǝ ɗǝnga ɗǝmwaˈyi wu shili, sǝ ǝnggǝr tsa ndau ǝnga sǝsukur ǝnga hǝl ǝnga sakida nǝ fati ǝnga ndza thlǝmǝr ndau. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Sǝˈyar kǝ ngu mǝliya ndǝ ja ɗa ‘gǝra cicau,’ ama sǝm sǝr sǝm gǝra ǝnga tsi cicau a sǝn mǝliya ndǝ ja ɗa ‘gǝra cici’ mai.”<verse eid="MAT 15:20"/></para>
  <para style="s1">Mbǝrsa Nǝ Vanyi Mala</para>
  <para style="r">(<ref loc="MRK 7:24-30">Markusu 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Kǝ Yesu piyari vi ta, ba ji maˈyi a vu ˈyiˈyir Taya ǝnga Sidonu. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>A vuna kǝ mala kǝra aˈyi mala njir Yahudiya mai shili ara ja, ji na, “Thlagǝu, Zǝr Dawuda, tǝhuɗǝ ǝgya yau. Kǝja mambǝl ɗǝmwaˈyi a vǝr lǝ ɓwaɓwatǝ gagaɗǝ anǝ kwa ɗa.”<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Ama sǝ aˈyi kǝra Yesu shaɗǝwa nyi mai. Kǝ zǝmbǝlma nyiˈyar shili ara ja ndǝ kǝdi nyi, ndǝ na, “Kǝdlǝna nyi ja maˈyi, ara kǝ ju nu mǝn ju ɓwanǝ mǝn kǝr kau.”<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Kǝ ji shaɗǝwa, ji na, “Hyal sǝwa ɗa a shili anǝ njir Izirayila kǝra ǝnggǝr tǝmahǝ sasa wacu.”<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Ama kǝ mala kǝ shili, ji sa ɓǝliya undi wu mwa nyi, ji na, “Thlagǝu, dlǝwar ɗa.”<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>Kǝ ji shaɗǝwa, ji na, “Aˈyi ɗa tsaˈa nja hǝri sǝr sǝm wazha nja vakana nyi anǝ hyaˈyar mai.”<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Kǝ ji na, “Jiri nga nyi Thlagǝu, ama alaga abangau, hyaˈyar ndu sǝm sǝra pǝpǝnakǝr sara wu miya wazha ma nda vǝr sǝm sau.”<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Kǝ Yesu shaɗǝwa, ji na, “Mala, dǝgal gagaɗǝ ngǝ mbǝrsa ngau. Bǝgǝ sǝra gu yiwu, ja ɗa.” Abangau, kǝ kwa ta ɗa jamǝ ar pǝci ta.<verse eid="MAT 15:28"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Nji Gangǝu</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Sarar vi ta, kǝ Yesu maˈyi lagu dǝl Galili. Kǝ ji maˈyi a dar kǝra mau, kǝ ji da nggya gya. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Dlamir nji gangǝ shili ǝgya ja, ndu shili ǝnga nji pamǝpamǝ gangǝ kǝra gǝra ngga. Nanda ngǝ, nji tǝsǝkǝnǝu, ǝnga nji lǝfau, ǝnga nji kukurɓǝu, ǝnga njir mǝga, ǝnga njir shilǝgǝ pamǝpamǝ gangǝu, ba ndǝ sa pina nda ǝgya hiya Yesu. Kǝ Yesu shilǝgǝbiya nda. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Kǝ sǝ kǝ ɗa sǝ dǝdǝgur anǝ nji, ǝnggǝra ndǝ nggar njir mǝga a vǝr ndǝr ǝnga ndǝ lari nji kukurɓǝ ɗa jamǝ ǝnga nji tǝsǝkǝnǝ a vǝr ɓau ba nji lǝfau wu lar sau. Kǝ patǝkura nda dlǝvǝ Hyal nǝ njir Izirayila.<verse eid="MAT 15:31"/></para>
  <para style="s1">Yesu Sǝmǝna Nji Dubu Foɗǝu</para>
  <para style="r">(<ref loc="MRK 8:1-10">Markusu 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Kǝ Yesu nggari zǝmbǝlma nyiˈyar a shili ara ja, kǝ ji na anǝ nda, “Yi wu tǝhuɗǝ ǝgya nji kau, ara ǝshina pida makǝr nga nda ǝnga yau, nandǝ sǝm sǝ mai. Nayi wu yiwu ya sǝwa nda, nda maˈyi ǝnga wuɓǝ mai, nda sara nda shavǝr ar lagu.”<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Kǝ zǝmbǝlma nyiˈyar shaɗǝwa, ndǝ na, “Əmani nga mǝn wu nda uya sǝr sǝmǝna dlami kǝ ar tagǝ ka?”<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>“Lǝgu ɗǝfǝ yiɗawa nga ara hya?” Yesu yiwa nda. Kǝ ndǝ shaɗǝwa nyi, “Lǝgu ɗǝfǝ mǝɗǝfǝ ǝnga kalfi yiɗǝɗǝ yiɗawu.”<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>Kǝ ji nar nyi anǝ dlamir nji, nda nggya a gyiwu ˈyi. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Kǝ ji hǝri lǝgu ɗǝfǝ mǝɗǝfǝ ǝnga kalfiya nyi. Ayukuɗa ji usaku Hyal, kǝ ji ɓǝɓǝlǝwa, ba ji nǝ nyi anǝ zǝmbǝlma nyiˈyar. Nanda tsu, ba ndǝ tǝtǝkǝna nyi anǝ nji. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Patǝ nda ngǝ sǝm, ndǝ nyau. Ayukuɗa nyi zǝmbǝlma nyiˈyar tsǝmiya tsǝla nyinyi mǝɗǝfau ǝnga sǝra hiyau sara wu miya nda. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Njira nji sǝmǝna ca ngǝ shili zhizhir nda nji dubu foɗǝu, nji jiga mathlǝkǝˈyi ǝnga wazha mai. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Ayukuɗa Yesu sǝwa dlamir nji nda maˈyi, kǝ ji gwu kwambwal, ba ji maˈyi a vu ˈyiˈyir Magadanu.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">Gal Mǝtsamǝ</para>
  <para style="r">(<ref loc="MRK 8:11-13">Markusu 8:11-13</ref>; <ref loc="LUK 12:54-56">Luka 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Kǝ njir Farisi ǝnga njir Sadusi shili ǝgya Yesu, aga nda sa dzǝbiya nyi. Kǝ ndǝ na anǝ nyi, aga ja canǝ nda mǝtsamǝ sǝ dǝdǝgur sara dǝmǝlmau, kǝra wu cabiya abǝr sara ara Hyal nga ja.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Kǝ ji shaɗǝwa nda, ji na, “Ma wagǝ ɗa, ba hyi lari ndǝla mǝlmǝ a ɗar dǝzǝu, ba hya na, ‘Vi wu sa ɗa jamǝ ǝzǝgǝu.’ <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Ma mudlǝ tsu, ma hyi lari ndǝla mǝlmǝ dǝzǝu ǝnga zǝgutu, ba hya na, ‘Əshina nǝ nyi nju nda tǝɗǝ par.’ Nahyi, hyu sǝn tǝkǝbiya pamǝpamǝkura dlama, ama nahyi wu sǝn tǝkǝbiya pamǝpamǝkura sǝ dǝdǝgur kǝra wu ɗarkǝr kabangǝkǝ mai. <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Njir nggyabiya kabangǝkǝ nji ɗǝmwaˈyu, njira gǝra nu Hyal wu yiwu nda lari sǝ dǝdǝgur. Ama sǝ dǝdǝgur aˈyi nju nda ca anǝ nda mai, kǝl nǝ nabi Yunana.” Kǝ Yesu piyari nda ba ji maˈyi.<verse eid="MAT 16:4"/></para>
  <para style="s1">Thlǝlamǝ Nǝ Njir Farisi <optbreak/> Ənga Njir Sadusi</para>
  <para style="r">(<ref loc="MRK 8:14-21">Markusu 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Ənggǝra zǝmbǝlma nyiˈyar tǝrabiya a biyar ya dǝl, ba ndǝ ɗǝngari nandǝ hǝri macikǝl mai. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Kǝ Yesu na anǝ nda, “Hya hangǝkal, ǝnga hya tsamǝ ar kǝra thlǝlamǝ nǝ njir Farisi ǝnga njir Sadusi.”<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>Kǝ ndǝ thla wu pama nda, ndǝ na, “Ji na abangau, ara kǝ mǝn gǝra hǝri macikǝl kǝ ngau.”<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Ta Yesu sǝnbiya sǝra ndu thla, kǝ ji na anǝ nda, “Nahyi njira ǝnga mbǝrsa kukushu, mi ngǝ ɗa hyu ndǝr wu pama hyi abǝr ara kǝ hyi gǝra hǝri macikǝl kǝ nga? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Baˈanǝ kabangǝkǝ nahyi nggabiya mai ya? A far hyi ǝnggǝra yi sǝmǝna nji dubu tǝfu ǝnga lǝgu ɗǝfǝ tǝfu ta ya? Ətsu a far hyi tara tsǝla yiɗau nga hyi nyana ǝnga sǝra hiyau wu miya nji ta ya? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Əndǝga a far hyi ǝnggǝra yi sǝmǝna nji dubu foɗǝ ǝnga lǝgu ɗǝfǝ mǝɗǝfǝ ǝnga tara tsǝla yiɗau nga hyi nyana ǝnga sǝra hiyau wu miya nji ta ya? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Mi ngǝ ɗa nahyi nggabiya abǝr aˈyi ar kǝra macikǝl nga ya vǝr ndǝr maya? Ama yi na anǝ hyi aga hya hangǝkal ǝnga thlǝlamǝ nǝ njir Farisi ǝnga njir Sadusi.” <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Kǝ ndǝ nggabiya abǝr naja aˈyi a vǝr ndǝr anǝ nda, aga nda hangǝkal ǝnga thlǝlamǝ nǝ ta macikǝl mai, ama ar kǝra highiɓǝ nǝ njir Farisi ǝnga njir Sadusi.<verse eid="MAT 16:12"/></para>
  <para style="s1">Biturusu Nana Abǝr Yesu Ngǝ Kǝrsiti</para>
  <para style="r">(<ref loc="MRK 8:27-30">Markusu 8:27-30</ref>; <ref loc="LUK 9:18-21">Luka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Ar pǝci kǝra Yesu shili wu ˈyiˈyir Kayisariya Fǝlipi, kǝ ji yiwa zǝmbǝlma nyiˈyar, ji na, “Wa nga nju na ǝnga ya, nayi Zǝr Nda?”<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Kǝ ndǝ shaɗǝwa nyi, “Alenyi nju na Yahwana ndǝr mǝl Baɓǝtizǝma, ǝnga alenyi nji Iliya, ǝnga alenyi nji tsu Irimiya ǝnga zǝmǝ wu pama nabiˈyar.”<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>“Ama kar nahyi tsu, wa nga hyu na nga ya?” ji yiwa nda.<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Kǝ Simanu Biturusu shaɗǝwa, ji na, “Nagǝ ngǝ Kǝrsiti, Zǝr Hyal kǝra ǝnga pi.”<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Kǝ Yesu na anǝ nyi, “Ndǝr barka nga gau, Simanu zǝr Yunana, arya aˈyi ndǝ ngǝ cabiya ngǝ sǝ kǝ mai, ama Dǝɗa kǝra a dǝmǝlmau. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Yu na anǝ ngau, nagǝ Biturusu tsǝka ngau, ar kǝra tsǝka kǝ nga yu hǝr daɓǝ dzǝ njir nu ɗa, daɓǝ njira sǝra ǝnga dǝnama nǝ tau, aˈyi a sǝn sǝm tǝlkur ar kǝra nda mai. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Yu nǝ ngǝ sǝr pahǝ miya ki nǝ tǝlkur Hyal. Ətsu kalar sǝra gǝ mbiya wu duniya mbamba nga nyi a dǝmǝlmau, ǝnga kalar sǝra gǝ pǝlna wu duniya pǝpǝl nga nyi a dǝmǝlmǝ ǝtsu.” <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Kǝ Yesu tǝɗar himiya zǝmbǝlma nyiˈyar abǝr nda sara na sǝ kǝ anǝ kalar ndǝ abǝr naja ngǝ Kǝrsiti mai.<verse eid="MAT 16:20"/></para>
  <para style="s1">Yesu Nana Ənggǝra Ji Wu Nda Tau</para>
  <para style="r">(<ref loc="MRK 8:31">Markusu 8:31</ref>; <ref loc="MRK 9:1">9:1</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Mbari ar pǝci kǝ ngǝ Yesu dzǝguya na anǝ zǝmbǝlma nyiˈyar, abǝr kǝl ji maˈyi a vu Urshalima. A vuna ju vuwa lar ɓwaɓwatǝ pamǝpamǝu. Nji nggunggurǝm nǝ mǝlmau, ǝnga pubu dǝdǝgalˈyar, ǝnga malǝmǝ dlaɗǝˈyar wu nda piyari nyi, ba nda tsǝya nyi, ama ayukuɗa pida makǝru, ba ja hyaˈari ǝnga pi.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Kǝ Biturusu hǝr nyi a ndar batiti, ji nda kughiya nyi, ji na, “Wu ɗa mai Thlagǝu, Hyal a tsana sǝ ǝnggǝr kǝ a ɗa ǝnga gau.”<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Ama kǝ Yesu shabiya dzau, ji na anǝ Biturusu, “Tǝkǝ ǝnga yau, Shatan! A ɗar gǝ sǝr thlǝ hi anǝ ɗa, ara ɗǝnga ngau ǝnggǝr nǝ nji nga nyi, aˈyi nǝ Hyal mai.”<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Kǝ Yesu nar nyi anǝ zǝmbǝlma nyiˈyar, “Kalar ndǝra wu yiwu ja nu ɗa, kǝl ja piyari yiwu kǝrnyi, ba ja hǝri wu dladlakǝ nyi, ba ja nu ɗa. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Ara kalar ndǝra wu yiwu piya ja, ju nda tini. Ndǝra gǝra yiwu piya ja arya yau, ju nda uya. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Mi ngǝ akkǝri kǝra ndu uya ma nji nǝ nyi duniya patǝu, ba ja tini piya ja? Əndǝga mi ngǝ ndǝ a sǝn lǝri ar viya piya ja? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Arya nayi Zǝr Ndau, wu nda shili wu kadakadarkur nǝ Dǝɗa ǝnga waladi ɗaˈyar. Yu sa mǝliya nyi numa anǝ patǝr njir duniya ar lagu kǝra ndǝ mǝl thlǝrǝr nda ari. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Yu nar hyi jirkura nyi, alenyi nji aˈyi ǝnggau tataˈyu, nandu nda tǝ mai, kǝl ndǝ lar Zǝr Ndau wu shili wu tǝlkur nyi.”<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Bǝla Dzǝ Nǝ Yesu</para>
  <para style="r">(<ref loc="MRK 9:2-13">Markusu 9:2-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Ayukuɗa pida kwa, kǝ Yesu hǝri Biturusu ǝnga Yakubu ǝnga Yahwana zamǝya Yakubu ba ji hǝr nda a ndar kǝra vanyi mau kǝra dzǝgamǝu, nanda zhizhir nda. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>A ndǝna, kǝ dza ja bǝlana dzǝ wu mwar nda. Bama ja wu mbǝl ǝnggǝr pǝci ǝnga lǝgutǝ nyi ɗa pǝrtǝ pwahǝu. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Kukuthlǝ kǝ nabi Iliya ǝnga nabi Musa shili nda vǝr ndǝr ǝnga Yesu.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Biturusu na anǝ Yesu, “Thlagǝu, shilir mǝn ǝnggǝ kau, a ɗar mǝnahǝu. Ma gu yiwu, ya sǝn mǝliya kwapatǝ makǝr ǝnggau, pathlǝ anǝ ngau, pathlǝ anǝ Musa ǝnga pathlǝ anǝ Iliya.”<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Ma tsu ja vǝr ndǝr, kǝ mbǝmbǝl sara du dlama sa haɗiya nda, kǝ nji nggari ɗahǝu sara du dlama wu na, “Naja kau, Zǝr Ɗa ngau, yu yiwu nyi; huɗa yi pipida ǝnga ja gagaɗau. Hya sǝya nyi himi!”<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Ənggǝra zǝmbǝlma nyiˈyar nggari abangau, ba hivǝr mbar nda, kǝ ndǝ uzhiya bama nda a gyiwu ˈyi. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>Ama kǝ Yesu shili ji sa tsǝkwar nda, ji na “Hyaˈara mau. A sara hya hivǝr mai.” <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Ənggǝra ndǝ hyaˈanakǝr, nandǝ ɓǝra lar ndǝ mai kǝl Yesu zhizhi nyi.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Ənggǝra nda vǝr shida sara dar ma nyi, Yesu kughiya nda, ji na, “A sara hya na anǝ kalar ndǝ sǝ kǝ hyi lar kǝ mai, kǝl ma Zǝr Ndǝ hyaˈari sara vir tau.”<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>Kǝ zǝmbǝlma nyiˈyar yiwa nyi, ndǝ na, “Ya ara mi ngǝ malǝmǝ dlaɗǝˈyar na abǝr kǝl Iliya ɓǝra shili tanggǝrma ka?”<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Yesu shaɗǝwa, ji na, “Pakatǝ Iliya wu shili, ju sa fuwa sǝ patǝ wu lagu. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Ama, yu nar hyi, abǝr, Iliya a shiliri tsu kaɗǝu, ama nandǝ tsamǝ ri nyi mai, kǝl ta ndǝ mǝliya nyi sǝra ndu yiwu. Abangǝ tsu ngǝ Zǝr Ndau, wu nda lari ɓwaɓwatǝ wu tsa nda.”<verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>Kǝ zǝmbǝlma nyiˈyar nggabiya abǝr ja vǝr ndǝr anǝ nda ar kǝra Yahwana ndǝr mǝl Baɓǝtizǝma.<verse eid="MAT 17:13"/></para>
  <para style="s1">Yesu Shilǝgǝbiya Zǝr Kǝra <optbreak/> Ənga Mambǝl Ɗǝmwaˈyu</para>
  <para style="r">(<ref loc="MRK 9:14-29">Markusu 9:14-29</ref>; <ref loc="LUK 9:37-43a">Luka 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Ənggǝra ndǝ shili ǝgya daɓǝr dlami, ba vanyi ndǝ shili ara Yesu, kǝ ji sa uzhau wu mwa nyi, ji na, <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“Thlagǝu, tǝhuɗǝ ǝgya zǝr ɗa kau. Sǝ tsatsa ngǝ wu tsa nyi, ǝnga tsu ju lar ɓwaɓwatǝ gagaɗau. Aga gangǝ nga ju tǝɗǝ a gwu uˈu, ǝnga tsu a gwu ˈyimi. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Yi shili ǝnga ja anǝ zǝmbǝlma ngǝˈyar, ama nandǝ sǝn shilǝgǝbiya nyi mai.”<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Yesu shaɗǝwa nda, ji na, “Nahyi nji kabangǝkau, nji gǝra mbǝrsa, nji ɗǝmwaˈyu, baˈanuwa nga ya nggya ǝnga hya? Baˈanuwa nga ya sǝsu hya? Shila mau ǝnga zǝra nyi anǝ ɗa.” <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Kǝ Yesu kughiya mambǝl ɗǝmwaˈya nyi, ba ji biya sara wu dza zǝra nyi. Ənggǝrna ba zǝra nyi ɗa jamǝu.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Kǝ zǝmbǝlma nǝ Yesu ˈyar shila anǝ nyi ar ɗǝwa ndǝ sa yiwa nyi, “Mi ngǝ ɗa ˈyi tǝwa ara kǝdlǝbiya mambǝl ɗǝmwaˈyi ka?”<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>Kǝ Yesu shaɗǝwa nda, “Arya mbǝrsar hyi kushu nga nyi. Ənga jiri yu na anǝ hyi, ma mbǝrsar hyi aˈyi ǝnggǝr culi bǝla, culi kǝra ndiya ǝnga kushu wu culi patǝu, hyu sǝn na anǝ mǝ kau, ‘Hyaˈari ǝnggau ga maˈyi a ndǝna,’ ǝtsu ba ja hyaˈari, ba ja maˈyi. Agabangau, sǝr kar hyi kǝr aˈyi mai.” <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>[Culi sǝˈyar kǝ aˈyi wu biya abangǝ mai, kǝl ǝnga kǝdi Hyal ba ǝnga hǝ zǝmǝtsini.]<verse eid="MAT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Ənggǝra zǝmbǝlma nyiˈyar shili ar vi zǝmǝ wu ˈyiˈyir Galili, kǝ ji na anǝ nda, “Nji wu nda lǝr Zǝr Ndau a gwu tsa dawa nyiˈyar, <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ba nda tsǝya nyi. Ar pǝci makǝrkura nyi ba ja hyaˈari ǝnga pi.” Ba sǝ kǝ fuwa zǝmbǝlma nyiˈyar wu ɗǝnga sǝ gagaɗau.<verse eid="MAT 17:23"/></para>
  <para style="s1">Ki Budǝ Nǝ Ki Hyal</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Ənggǝra Yesu ǝnga zǝmbǝlma nyiˈyar shili wu mǝlmǝ Kafarnahumu, njir tsǝm budǝ nǝ umbwa Hyal thlǝwa Biturusu, kǝ ndǝ na anǝ nyi, “Malǝmǝr hyi aˈyi ju ki budǝ nǝ umbwa Hyal wa?”<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>“Angǝ, wu ki ja,” ǝngwar ja.</para>
  <para style="p" vid="MAT 17:25">Ənggǝra Biturusu shili wu ki, Yesu ngǝ dzǝguya ndǝr anǝ nyi tanggǝrma, ji na. “Simanu, mi nga gwu ɗǝnga? Sara ara wa ngǝ tǝlˈyar nǝ duniya wu dlǝwu buda, sara ara wazhar nda ǝndǝga sara ara alenyi nji ya?”<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>“Sara ara alenyi nji,” ǝngwar Biturusu. “Ma abangau, wazhar nda wu ki mai,” Yesu shaɗǝwa nyi. <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>“Ama a sara mǝna ndzana ɗǝfuwa nda, maˈyi a gwu dǝl ga gwa sǝ dlir, ba ga pahǝna miya kalfi kǝra gǝ mbar tanggǝrma, gu uya gǝnna kǝra daɓaga kina budǝ ngau ǝnga nǝɗa.”<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Wa Nga Ndiya Ənga Dǝgala?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Markusu 9:33-37</ref>; <ref loc="LUK 9:46-48">Luka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Ar pǝci ta ngǝ zǝmbǝlma nyiˈyar shili ǝgya ja ndǝ sa yiwa nyi, “Wa nga ndiya ǝnga dǝgal wu tǝlkur Hyala?” <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>Kǝ Yesu nggar vanyi zǝr kushu, kǝ ji sa taˈyina nyi wu mwar nji patǝu. <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>Kǝ ji na anǝ nda, “Yu nar hyi jirkura nyi, kǝl hyi shabiya ɗǝfuwa hyi, hya ɗa ǝnggǝr wazha yiɗǝɗǝu, nahyi wu sǝn uya gwu tǝlkur Hyal mai. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Ama kalar ndǝra hǝya kǝra ja, ji shabiya kǝrnyi ǝnggǝr zǝr kushu kau, naja nga ndiya ǝnga dǝgal wu tǝlkur Hyal.<verse eid="MAT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5"/>“Kalar ndǝra dlǝwuri zǝr kushu ǝnggǝr kǝ wu thlǝmǝ ɗa, nayi nga ji dlǝwuri. <verse eid="MAT 18:5"/><verse number="6" style="v" sid="MAT 18:6"/>Ama tsu, kalar ndǝra mǝliya pathlǝu wu pama wazha yiɗǝɗǝ kau, kǝra hǝnggǝri ǝnga yau ja thlǝr hi, wu ndiya anǝ ndǝ kǝ nja mbiya bǝra ar fǝlanga ja, ba nja vakuwa nyi a gwar dǝl dǝgal kǝra dzǝgamǝu aga ja gya cau.<verse eid="MAT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>“Sǝr tǝhuɗǝ anǝ duniya ara ju mǝliya nja thlǝ hi! Sǝr thlǝ hiˈyar kǝ a ɗari kǝl nda shili, ama sǝr tǝhuɗǝ anǝ njira sǝˈyar kǝ wu shili lagur nda. <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Ma tsa gau ǝndǝga hiya gǝ ngu fuwa ngǝ ga mǝliya bikau, kuji ga thlana ba ga vakana nyi naɗǝu. Wu ndiya anǝ ngǝ ga uya pi gǝra kuɗau ǝnga hi ǝndǝga tsi papathlǝu a mwara nja vakuwa ngǝ a gwu uˈur kǝtsa gǝra kuɗau ǝnga tsi ba hiya gǝ gyapǝu. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Ma tsu liya gu fuwa ngu bikau, tǝkuɗǝbiya ga vakana. A ndiya ǝnga mǝnahǝu anǝ ngau ga uya pi gǝra kuɗau ǝnga li zǝmǝu, a ndiya nja vakuwa ngau a gwu uˈur kǝtsa ǝnga li mǝthlǝu.<verse eid="MAT 18:9"/></para>
  <para style="s1">Karapau Ar Kǝra Tǝmahǝu Sasa</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>“Hya hangǝkal hya sara diɗa alaga pathlǝu wu pama wazha yiɗǝɗǝ kau. Ara yu nar hyi abǝr waladir nda ˈyar wu nggya cumu wu mwar Dǝɗa kǝra a dǝmǝlmau. <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>[Arya Zǝr Ndǝ shili aga sa mbǝɗa nji sasa.]<verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>“Mi ngǝ ɗǝngar hyi ar kǝra ndǝr ka? Ma ndǝ ǝnga tǝmahǝ gharu, kǝ zǝma nyi sanakǝr, aˈyi ju piyari ǝdlǝkumunyi apǝ ǝdlǝ kau, a gwar tagǝu, ba ja maˈyi a nda gal pathlǝ kǝra sa kǝ wa? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Maja nǝr nyi ri, jiri nga yu na anǝ hyi, ju nyabiya dzǝ ǝnga caguli arya pathla tǝmahǝ kǝra ji nǝr kǝ a ndiya ǝdlǝkumunyi apǝ ǝdlǝ ta gǝra sa ta. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Abangǝ nga nyi tsu, dǝr hyi kǝra a dǝmǝlmau aˈyi wu yiwu pathlǝ wu pama wazha yiɗǝɗǝ kǝ a sanakǝr mai.<verse eid="MAT 18:14"/></para>
  <para style="s1">Zamǝ Kǝra Mǝliya Ngǝ Bikau</para>
  <para style="r">(<ref loc="LUK 17:3">Luka 17:3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>“Ma zamǝ ngǝ mǝliya ngǝ bikau, maˈyi ga nda thlǝwa nyi zhizhi nyi ba ga nar nyi bikǝ kǝra ji mǝliya wu pama hyi mǝthlǝ hyi. Ma ji sǝya ngǝ himi, a shabiya nyir gau. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Ama ma naji sǝya ngǝ himi mai, nggari ndǝ pathlǝ alaga nji mǝthlǝ ba hya ɓǝra nda thlǝwa nyi. Aga sǝra gu na, nji mǝthlǝ alaga nji makǝru wu hǝnggǝri ǝni. <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Ma ji nggǝl ara sǝhimi nda tsu, ba hya hǝr nyi a ndǝgya daɓǝ dzǝ njir nu. Ma naja aˈyi sǝhimi nda tsu mai, ba hya hǝri nyi ar viya ndǝra gǝra sǝni Hyal alaga ndǝr bikǝ ndǝra gǝra tubi.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>“Jiri nga yu na anǝ hyi, kalar sǝra hyi mbiya wu duniya mbamba nga nyi a dǝmǝlmau. Kalar sǝra gǝ mbiya wu duniya mbamba nga nyi a dǝmǝlmau, ǝnga kalar sǝra gǝ pǝlna wu duniya pǝpǝl nga nyi a dǝmǝlmǝ ǝtsu.<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>“Yu ɓǝra na anǝ hyi, kalar sǝra nji mǝthlǝ alaga nji makǝr hǝnggǝri ndu kǝdiyau wu duniya, dǝɗa kǝra a dǝmǝlmau wu nda mǝliya nda. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Ənga hya sǝni abǝr kalar vira nji mǝthlǝ alaga makǝr kaɓǝ ari wu thlǝmǝ ɗa, aˈyi yu pama nda.”<verse eid="MAT 18:20"/></para>
  <para style="s1">Karapau Ar Kǝra Mafa Kǝra <optbreak/> Gǝra Ənga Tǝhuɗǝu</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Kǝ Biturusu shili ji sa yiwa Yesu, “Thlagǝu, aga yiɗawu nga ya kyaga tǝfǝbiya zamǝ ɗa ma ji ndzana ɗa huɗa ya? A ɗa aga mǝɗǝfǝ ya?”<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Əngwar Yesu, “Awau, aˈyi aga mǝɗǝfǝ mai, ama mǝɗǝfǝ mǝɗǝfau, ar vi mǝɗǝfǝkumunyi.<verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>“Agabangau, nju gǝlabiya tǝlkur Hyal ǝnga vanyi tǝl kǝra ngga mafa nyiˈyar kǝra ǝnga gǝnna nyi patǝ wu tsa nda aga nda nar nyi sǝra wu tsa nda patǝu. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Ənggǝra nja vǝr lǝ anǝ nyi sǝra ɓau, kǝ nji shili ǝnga vanyi ndǝ kǝra ǝnga mǝl gangǝ kǝra ji gǝra sǝn kina wu nggyabiya nyi. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Ta ji tǝwa ara kina gǝnna nyi, kǝ tǝl kǝ sǝwa aga nja ɗǝlna sǝ nyi patǝu, ǝkkǝˈyi mala nyi ba wazha nyi aga ja kina mǝla nyi ǝni.<verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>“Kǝ mafa kǝ uzhau wu mwar tǝl kau, ju kǝdi nyi, ‘Usi Alvari, tǝhuɗǝ ǝgya yau, yu kina ngǝ patǝu.’ <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Kǝ tǝl kǝ tǝhuɗǝ ǝgya ja, ba ji tǝfǝbiya nyi mǝl kǝra ju nu nyi patǝ ba ji maˈyi.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>“Ta ji biya sara wu mwar tǝl ta, ba ji thlǝwa kuvwa nyi mafa kǝra ju nu nyi mǝl nǝ gǝnna kushu. Ji mbar nyi ǝgya fǝlangǝ nga ja, ji na, ‘Kina ɗa mǝl ɗa kabangǝkau.’<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>“Kǝ kuvwa nyi mafa kǝ ɓǝliya undi ju kǝdi nyi, ‘Tǝhuɗǝ ǝgya yau, yu kina ngǝ mǝl ngǝ patǝu.’<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>“Ama kǝ ndǝ kǝ nggǝl ara nggar kǝdi nyi, kǝl ta ji fuwa nyi wu fursǝna kǝl ma ji kina nyi mǝl nyi patǝu. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Ta alenyi mafaˈyar nggari abangau, ba huɗa nda ndzǝ gagaɗau. Kǝ ndǝ maˈyi ka nda nar nyi anǝ tǝl ta, sǝra ɗarkǝr patǝu.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>“Kǝ tǝl kǝ nggar mafa nyi, ji na ‘Nagǝ mafa shishi,’ ‘Yi tǝfǝbiya ngǝ mǝl kǝra wu dza gǝ patǝu, arya gǝ kǝdi ɗa aga ya tǝfǝbiya ngau. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Aˈyi ɗa tsaˈa ga tǝhuɗǝ ǝgya mafa kuvwa ngǝ wa, ǝnggǝr kǝra yi tǝhuɗǝ ǝgya gǝ ta wa?’ <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Kǝ sǝ kǝ ndzana huɗa tǝl kǝ gagaɗau, kǝ ji sǝwa nja fuwa nyi a gwu fursǝna aga nja nǝ nyi ɓwaɓwatǝu, kǝl ma ji kina gǝnna kǝra ju nu nyi patǝu.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>“Abangǝ tsu ngǝ dǝɗa kǝra a dǝmǝlmau wu nda mǝl anǝ kalar ndǝra wu pama hyi ma hyi gǝra tǝfǝbiya zamǝr hyi ǝnga kwamǝr hyi sara wu ɗǝfuwa hyi.”<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Yiwa Sau Ar Kǝra Tǝkǝ Mala <optbreak/> Ənga Sal</para>
  <para style="r">(<ref loc="MRK 10:1-12">Markusu 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Yesu kuɗǝna ndǝr kau, kǝ ji piyari Galili, ba ji maˈyi a ndu ˈyiˈyi Yahudi kǝra a biyar ya dǝl Urdǝnu. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Dlamir nji gangǝ nu nyi, ba ji shilǝgǝbiya njira ǝnga shilgǝ a ndǝna. <verse eid="MAT 19:2"/><verse number="3" style="v" sid="MAT 19:3"/>Ənggau, kǝ alenyi njir Farisi shili aga nda sa dzǝbiya Yesu, ndǝ yiwa nyi, ndǝ na, “Dlaɗǝ Musa na, abǝr a ɗar tsaˈa anǝ ndǝ ja tǝkǝbiya dzǝ ǝnga mala nyi ya?”<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>Kǝ Yesu shaɗǝwa nda, ji na, “Aˈyi hyi saya jigana wa, abǝr tanggǝrma Hyal kǝra mǝliya nda, ‘Ji mǝliya nda sal ǝnga mala’ wa? <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>Kǝ ji ɓǝra na, abǝr ‘Arya abangau, ndǝ sal wu piyari dǝnyi ǝnga mǝnyi, nda ɗa sǝ zǝmǝ ǝnga mala nyi, nanda mǝthlǝ ndu ɗa ar viya ndǝ zǝmǝu.’ <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Tsu nda aˈyi nji pamǝpamǝ mǝthlǝ mai, ama kumǝr dzǝ zǝmǝu. Agabangǝ sǝra Hyal mbiya ndǝ a sara pǝlna mai.”<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>Kǝ ndǝ na anǝ nyi, “Mi ngǝ ɗa Musa nana a gu lǝkakaɗǝ nyi, abǝr, a ɗar tsaˈa sal ja nǝ nyi lǝkakaɗǝ nǝ sakida kǝdlau anǝ mala ˈya?”<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>Kǝ Yesu shaɗǝwa nda, “Ara ɓaɓalkura ɗǝfuwa hyi ngǝ Musa sǝya hyi lagu, ama aˈyi abangǝ ngǝ Hyal mǝliya tanggǝrma mai. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Yu na anǝ hyi, kalar ndǝra kǝdlǝna mala nyi, ma aˈyi ji mbari nyi a vǝr dlǝnga sal mai, kǝ ji ɓǝra hǝri vanyi mala, a ɗar ja ndǝ sǝsu.”<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Kǝ zǝmbǝlma nyiˈyar na, anǝ nyi, “Ma abangǝ nga nyi wu pama sal ǝnga mala Thlagǝu, kuji kǝ ndǝ a nggya gǝra hǝ mala.”<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Kǝ Yesu shaɗǝwa nda, ji na, “Aˈyi patǝr nji ngu sǝn hǝnggǝri ǝnga culi ndǝr kǝ mai, kǝl njira Hyal dlǝwar nda. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Arya alenyi nji ɗa mǝciˈu sal ara nji yabiya nda abangau. Ama alenyi nji tsu, nji ngǝ mǝliya nda ndǝ ɗa mǝciˈu sal. Ənga alenyi nji tsu ngǝ mǝliya kǝrnda mǝciˈu sal arya ndu yiwu tǝlkur Hyal kǝra wu ɗǝfuwa nda. Kalar ndǝra wu sǝn mbar najaka highiɓau, bǝgǝ ja dlǝwuri.”<verse eid="MAT 19:12"/></para>
  <para style="s1">Yesu Fǝnggǝr Nyi Barka Anǝ Wazha</para>
  <para style="r">(<ref loc="MRK 10:13-16">Markusu 10:13-16</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Kǝ nji shili ǝnga wazha yiɗǝɗǝ anǝ Yesu aga ja sa fǝr tsa ja ar nda ǝnga ja kǝdi Hyal anǝ nda. Ama kǝ zǝmbǝlma nyiˈyar kughiya njira dla ǝnga wazha kau.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>Ama kǝ Yesu nar nda, “Hya piyari wazha yiɗǝɗǝ nda shili ǝgya yau, hya sara ka nda mai, ara tǝlkur Hyal nǝ culi nji kǝra ǝnggǝr nanda ngau.” <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Kǝ ji fǝr tsi nǝ barka ar nda, ba ji maˈyi.<verse eid="MAT 19:15"/></para>
  <para style="s1">Zǝr Baduwari Ndǝr Gǝnna</para>
  <para style="r">(<ref loc="MRK 10:17-31">Markusu 10:17-31</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Kǝ vanyi ndǝ shili ara Yesu, ji sa yiwa nyi, “Malǝmǝ, mi ngǝ sǝ mǝnahǝu kǝra ya kyaga mǝl aga ya uya pi gǝra kuɗa?”<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>“Kǝ Yesu na anǝ nyi, “Ara mi ngu yiwa ɗa ar kǝra sǝ mǝnaha? Ndǝ mǝnahǝ aˈyi mai kǝl Hyal wacu. Ma gu yiwu ga uya pi kǝra gǝra kuɗau, kǝl ga ɓǝlari dlaɗǝˈyar kau.”<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Əngwar ja anǝ Yesu, “Dlaɗǝ mana wu liyanya?” Kǝ Yesu na anǝ nyi, “ ‘Ga sara tsa ndǝ mai. Ga sara mǝl sǝsukur mai. Ga sara hǝl mai. Ga sara thla fati ar kǝra ndǝ mai. <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>Ga gǝnggǝr nyi sǝli anǝ dǝngau ǝnga mǝngau. Ga dzǝgwa yiwu kuvwa ngau ǝnggǝr kǝrngau.’ ”<verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Kǝ zǝr baduwari ta na anǝ nyi, “A ɓǝlar yi sǝˈyar kǝ patǝ tsu yi zǝr kushu. Mi ngǝ sǝra hya?”<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>Yesu nar nyi, “Ma gu yiwu ga ɗa ndǝ tsapǝu, ga maˈyi ga nda ɗǝlna patǝr sǝra ara gau, ba ga tǝkǝna gǝnna nyi anǝ nji ɗaɗali, gu uya akkǝri a dǝmǝlmau. Ba ga dzǝgwa shili aga ga sa nu ɗa.”<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Ənggǝra ji nggari abangau kǝ zǝr baduwari kǝ ndalǝr bama, kǝ ji maˈyi ǝnga huɗǝ kyakyaru, ara naja ndǝr bǝrba gagaɗau.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Kǝ Yesu nar nyi anǝ zǝmbǝlma nyiˈyar, “Yi wu nar hyi jiri, dzadzau nga nyi anǝ ndǝr gǝnna ja gwu tǝlkur Hyal. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Ətsu yu nar hyi abǝr a ndiya ǝnga ɓatsu anǝ dlǝgwam ja tǝrabiya wu liya libǝra a mwara ndǝr gǝnna ja uya gwu tǝlkur Hyal.”<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Ta zǝmbǝlma nyiˈyar nggari abangau, kǝ ɗa sǝ dǝdǝgur anǝ nda, kǝ ndǝ na, “Ya, ma abangau, wa ngu sǝn uya mbǝɗa?”<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Kǝ Yesu tsamǝ nda, ji na, “Anǝ ndau, sǝra gǝra sǝn ɗa ngau, ama anǝ Hyal ɓatsu. Ara kalar sau, sǝr ɗa ngau, anǝ Hyal.”<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Kǝ Biturusu shaɗǝwa, ji na, “Kǝja ˈya piyari sǝ patǝ ˈyi nu ngau, mi ngǝ sǝra ˈyi wu nda uya?”<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>Yesu shaɗǝwa nda, ji na, “Yi wu nar hyi jirkura nyi, ar pǝcir nggyabiya kǝra wu nda shili, pǝci kǝra zǝr ndu sa nggya ar tsǝkafǝ nǝ kadakadarkur nyi, nahyi njira wu nu ɗa patǝu, nahyi ngu nda nggya ar tsǝkafǝ nǝ tǝlkur kǝra kumo apǝ mǝthlǝu, hyu mǝl numa anǝ miya umbwa njir Izirayila kumo apǝ mǝthlǝu. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Ənga tsu kalar ndǝra piyari ki ǝnga zamǝˈyar, ǝnga kwamǝˈyar, ǝnga tada ǝnga ama ba ǝkkǝˈyi wazha ǝnga fa arya yau, ju nda uya a ndiya kau, gharu gharu ǝnga pi kǝra gǝra kuɗau. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Ama nji gangǝu kǝra tanggǝrma wu nda ɗa njir yukuɗu, ǝnga njir yukuɗǝ tsu ndu nda ɗa nji tanggǝrma.<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Karapau Ar Kǝra Njir Mǝl Thlǝr <optbreak/> Wu Fa Wur Inabi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“Tǝlkur Hyal ǝnggǝr ndǝra ǝnga fa wu ngau. Vanyi pǝci ji biya kaɗǝ mudlau, ji maˈyi a nda gal njir mǝl thlǝr anǝ nyi wu fa nyi. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Ta ndǝ dlǝwunggǝri aga ja kina nda gǝnna pǝkǝ nǝ ndǝ papathlǝu, ba ji sǝwa nda a gwar fa wa nyi.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>“Ənggǝr saka ǝdlau nǝ mudlau, ba ji ɓǝra biya, kǝ ji lari alenyi nji tataˈyi ar hada sugu sǝ aˈyi ndu mǝl mai. <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>Kǝ ji na anǝ nda, ‘Hya maˈyi tsu hya gwa mǝl thlǝr a gwar fa ɗa, ba ya nda sa kina hyi sǝra tsaˈa.’ Ba ndǝ maˈyi.<verse eid="MAT 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 20:5"/>“Kǝ ji ɓǝra biya ar pǝci taˈyikǝr ǝnga saka makǝr nǝ wagǝu, kǝ ji ɓǝra faˈari njir mǝl thlǝr. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Ənggǝr saka tǝfu nǝ wagǝu, kǝ ji ɓǝra biya, ba ji thlǝwa alenyi nji tataˈyi kurthlǝ gǝra a vǝr mǝl thlǝr. Kǝ ji yiwa nda, ji na, ‘Mi ngǝ ɗa hyi pǝkǝ tataˈyi kurthlǝ gǝra mǝl sa?’<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>“ Kǝ ndǝ shaɗǝwa nyi, ndǝ na, ‘Arya ndǝ aˈyi kǝra hǝr ˈya aga mǝl thlǝr anǝ nyi ǝshina mai.’</para>
  <para style="p" vid="MAT 20:7">“Kǝ ji nar nda, ‘Nahyi tsu maˈya mau a gwar fa ɗa.’<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>“Ta wagǝ ɗa, kǝ thlagǝr fa nar nyi anǝ ndǝr tsamǝ fa, ‘Nggar njir mǝl thlǝr kau, ga sa kina nda gǝnna mǝl thlǝrǝr nda, ga dzǝguya ar njira shili ǝwagǝu baˈanǝ njira shili ǝmudlau.’<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>“Njira gwa saka tǝfu nǝ wagǝ shili, ba nji kina nda gǝnna nǝ pǝkǝ papathlǝu. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Ta njira nji ngga tanggǝrma shili aga nja sa kina nda, ndu nggani abǝr nju nda kina nda a ndiya gǝnna nǝ pǝkau. Ama kǝ nji sa kina nda gǝnna pǝkau, kakalǝ ǝnga njira nji ngga ǝwagǝ ta. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Ta ndǝ dlǝwuri gǝnna nyi, ba ndǝ mbar jiga miya ar kǝra thlagǝr fa, <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>ndu na, ‘Njira nji ngga ǝwagǝu, njira mǝl thlǝr nǝ saka pathlǝ wacu, nga gǝ mǝliya ˈya kakalǝu, naˈya kǝra pǝkau dlǝm pǝci ar pǝci kwakwaɗǝ a vǝr mǝl thlǝr.’<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>“Ama kǝ ji nar nyi anǝ zǝma nda, ‘Bazhi, nayi ɗiya ngǝ mai, aˈyi yi kina ngǝ sǝra mǝ thlana wa? Gǝnna nǝ pǝkǝ ndǝ pathlǝ wa? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Dlǝwuri sǝra nji kina ngau, ba ga maˈyi. Nayi ngǝ yiwu ya kina njira dla ǝwagǝu kakalǝ ǝnga hyi njira shili ǝmudlau. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Aˈyi ɗa tsaˈa ya mǝl sǝra yu yiwu ya mǝl ǝnga gǝnna ɗa wa? Əndǝga shishikur ngu tǝ ngau, arya nayi ǝnga tsi papahǝ ya?’<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>“Abangau, ngǝ nji nǝ tanggǝrma wu nda ɗa njir yukuɗu, ǝnga njir yukuɗǝ tsu ndu nda ɗa nji tanggǝrma.”<verse eid="MAT 20:16"/></para>
  <para style="s1">Yesu Ɓǝra Nana Ənggǝra Ji Wu Nda Tau</para>
  <para style="r">(<ref loc="MRK 10:32-34">Markusu 10:32-34</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Ənggǝra Yesu a vǝr maˈyi a du Urshalima ǝnga zǝmbǝlma nyiˈyar, ba ji nggari nanda kumo apǝ mǝthlǝ a ndar batiti, ba ji na anǝ nda, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“Kǝja maˈyi nga mǝna du Urshalima. A vuna nju vuwa nǝ nyi Zǝr Ndau a vu tsa malǝmǝ dlaɗǝˈyar, ba ǝnga pubu dǝdǝgalˈyar. Ndu vuwa thlana nyi numa nǝ tǝ a vuna. <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>A vuna ndu vuwa nǝ nyi nyi anǝ njira aˈyi njir Yahudiya mai, ba nda dzǝgwa diɗana nyi, ǝnga nda dǝgǝ nyi ǝnga wuɗa, ǝtsu ba nda dzǝgwa dlakǝya nyi ar wu dladlakau. Ayukuɗa pida makǝru ba ja hyaˈari ǝnga pi!”<verse eid="MAT 20:19"/></para>
  <para style="s1">Sǝr Kǝdi Nǝ Miya Yakubu Ənga Yahwana</para>
  <para style="r">(<ref loc="MRK 10:35-45">Markusu 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Kǝ miya wazha Zabadi shili ara Yesu ǝnga wazha nyi, ji sa ɓǝliya undi wu mwa nyi, ju kǝdi mayiwakur anǝ nda.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>Kǝ ji na anǝ nyi, “Mi nga gu yiwa?”</para>
  <para style="p" vid="MAT 20:21">Kǝ ji nar nyi, “Ga mǝliya wazha ɗaˈyar kau, pathlǝu ja nggya ar tsi mazǝma gau ǝnga vanyi ar tsi matsala gau wu tǝlkur ngau.”<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>“Nahyi wu sǝn sǝra hyu yiwa mai,” Yesu nar nda. “A sǝn nda tǝwari hyi culi ɓwaɓwatǝ kǝra yu nda sa kǝ ya?”</para>
  <para style="p" vid="MAT 20:22">“ˈYu nda tǝwari,” ǝngwar nda.<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Ji na anǝ nda, “Ənga jiri hyu nda tǝwari ɓwaɓwatǝ kǝra yu nda sa, ama nǝ nggya ar tsi mazǝma yau ǝnga tsi matsala yau, aˈyi nayi ngu nda lǝ anǝ nji mai. Najaka vi ngǝ dǝɗa pabǝri anǝ njira ji caɗǝbiya tsu ǝmudlau.” <verse eid="MAT 20:23"/><verse number="24" style="v" sid="MAT 20:24"/>Ənggǝra alenyi zǝmbǝlma nyiˈyar kumo nggari sǝ kau, ba huɗa nda ndzǝ ǝnga nji kǝ ǝnga zamǝ nyi. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Ama kǝ Yesu nggar nda shili ar vi zǝmǝu, ji na, “Hyu sǝni njira nggurǝm njira aˈyi njir Yahudiya mai, wu sǝm tǝlkur ar kǝra njir nda ǝnga njira nggurǝmǝr nda wu ca dǝgalkur anǝ njir nda tsu. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Ama aˈyi abangǝ nga hyi mai. Kalar ndǝra wu yiwu ja ɗa dǝgal wu pama hyi, kǝl ji ɗa ndǝr mǝl thlǝr anǝ hyi patǝu. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Ətsu, kalar ndǝra wu yiwu ja ɗa ndǝr tǝɗǝmwa anǝ hyi kǝl ji ɗa mafar hyi. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Abangǝ tsu ngǝ Zǝr Ndǝ shili, aˈyi aga nja sa mǝl thlǝr anǝ nyi mai, ama aga ja sa mǝl thlǝr anǝ nji, ba aga ja lǝr piya ja aga ja bǝliya nji gangǝu.”<verse eid="MAT 20:28"/></para>
  <para style="s1">Nji Lǝfǝ Mǝthlǝu Uya Lari Sau</para>
  <para style="r">(<ref loc="MRK 10:46-52">Markusu 10:46-52</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Ar pǝci kǝra Yesu ǝkkǝˈyi zǝmbǝlma nyiˈyar piyari Yariko, kǝ dlamir nji gangǝ nu nyi. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Kǝja nji lǝfǝ mǝthlǝ a vǝr nggya a miya lagu, ta ndǝ nggari abǝr Yesu nga vǝr tǝrabiya, kǝ ndǝ sǝya wau, ndu na, “Thlagǝu, Zǝr Dawuda, tǝhuɗǝ ǝgya ˈya!”<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Kǝ dlamir nji kughiya nda, ndǝ na anǝ nda aga nda bǝgau. Ama kǝ ndǝ ɓǝra sǝya mala wau, ndǝ na, “Thlagǝu, Zǝr Dawuda, tǝhuɗǝ ǝgya ˈya!”<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Kǝ Yesu taˈyau, ji ngga nda, ji na, “Mi nga hyu yiwu ya mǝliya hya?”<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>Kǝ ndǝ shaɗǝwa, ndǝ na, “Thlagǝu,” “ˈyi wu yiwu ˈya lar sau.”<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>Yesu tǝhuɗǝ ǝgya nda, ba ji tsǝkwar liya nda. Ənggǝrna, ba liya nda pahau, ba ndǝ lar sau ba ndǝ nu nyi.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Yesu Vu Urshalima Ənggǝr Tǝl</para>
  <para style="r">(<ref loc="MRK 11:1-11">Markusu 11:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>; <ref loc="JHN 12:12-19">Yahwana 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Ənggǝra Yesu ǝnga zǝmbǝlma nyiˈyar vu mǝlmǝ Bethfaji, mǝlmǝ kǝra lǝhǝu wu dzǝr Urshalima, kǝra a dar kǝra mǝ zaitunu. Kǝ Yesu sǝwa zǝmbǝlma nyiˈyar mǝthlǝu, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>kǝ ji na anǝ nda, “Maˈya mau a vu zǝr mǝlmǝ kǝ a ndumwar hyi kau. Ənggǝra hyi vwau, hyu vuwa thlǝwa vanyi kwara mbamba ar sǝˈyi, ǝnga zǝr nyi. Hya pǝlna nda hya hǝr ɗa nda a shili. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Ma vanyi ndǝ yiwa hyi, mi nga hyu mǝla, ba hya na abǝr, ‘Thlagǝ ngu yiwu ja mǝl thlǝr ǝnga nda,’ ba ja piyari hyi, hya hǝr nda ǝnga kusa.”<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Sǝ kǝ ɗarkǝr aga nyabiya sǝra nabi nana, abǝr,<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“Nar nya mau anǝ kwar Sǝhiyona,</para>
  <para style="q2" vid="MAT 21:5">‘Lara mau,</para>
  <para style="q2" vid="MAT 21:5">tǝlǝr hyu shili ara hyi.</para>
  <para style="q1" vid="MAT 21:5">Naja ndǝra ǝnga hǝkǝr,</para>
  <para style="q2" vid="MAT 21:5">Kǝja tǝlǝr hyi a vǝr shili, aˈyi nggya a dar ya zǝr kwara.’ ”<verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Kǝ zǝmbǝlma nyiˈyar maˈyi, ndǝ nda mǝlna ǝnggǝr kǝra Yesu nar nda nda mǝl. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Kǝ ndǝ hǝr kwara nyi a shili ǝnga zǝr nyi, ndǝ fǝr lǝgutǝr nda a dar nda aga Yesu a nggya a dari. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Dlamir nji gangǝu sǝya lǝgutǝr nda ar lagu aga ja ɓǝ ari. Alenyi nji tsu ɓǝlǝr hyali ndǝ sǝya a gyar lagu. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Dlamir nji kǝra a dumwa nyi ǝnga kǝra a gyiwu yukuɗǝ nyi mbar wau, ndu na,</para>
  <para style="q1" vid="MAT 21:9">“Fal anǝ Zǝr Dawuda!”</para>
  <para style="q2" vid="MAT 21:9">“Barka anǝ</para>
  <para style="q1" vid="MAT 21:9">ndǝra shili wu thlǝmǝr Thlagǝu!”</para>
  <para style="q2" vid="MAT 21:9">“Fal anǝ ndǝra a dǝmǝlmau</para>
  <para style="q2" vid="MAT 21:9">vira ndiya ǝnga dzǝgamǝu!”<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Ta Yesu vu Urshalima, kǝ hangǝkala mǝlmǝ patǝ hyaˈari, ndu dzǝgwa yiwa, “Wa ngǝ ndǝ ka?”<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>Kǝ dlami shaɗǝwa, “Yesu ngau, nabi sara wu Nazǝratu wu ˈyiˈyir Galili.”<verse eid="MAT 21:11"/></para>
  <para style="s1">Yesu Tsǝkǝbiya Ki Hyal</para>
  <para style="r">(<ref loc="MRK 11:15-19">Markusu 11:15-19</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yahwana 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Kǝ Yesu vu ki Hyal ji vuwa kǝdlǝbiya njira vǝr ɗǝl ǝnga ɗǝlna sǝ a vuna patǝu. Kǝ ji shashabiya tǝmbǝl kǝra ndu bǝbǝla gǝnnar nda ari ǝnga nggǝliyanggama nǝ njir ɗǝlna mbǝthla masar. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Ji na anǝ nda, abǝr, “Tsǝtsǝfǝ nga nyi,</para>
  <para style="q1" vid="MAT 21:13">“ ‘Nju ngga ki ɗa</para>
  <para style="q2" vid="MAT 21:13">ǝnga vir kǝdi Hyal,’</para>
  <para style="q1" vid="MAT 21:13">ama kǝja hya shabiyari</para>
  <para style="q2" vid="MAT 21:13">ji ɗa vir ɗǝwa</para>
  <para style="q2" vid="MAT 21:13">njir ɗalagu.”<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Kǝ nji lǝfau ǝnga nji kadal shili ara ja wu ki Hyal, kǝ ji shilǝgǝbiya nda. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Ama ta pubu dǝdǝgalˈyar ǝnga malǝmǝ dlaɗǝˈyar lari sǝ dǝdǝgur kǝra ji mǝliya, ǝnga wazha a vǝr wau wu ki Hyal, ndu na, “Fal anǝ Zǝr Dawuda,” ba ndzana huɗa nda.<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>Ndǝ yiwa nyi, “Gǝ wu nggar sǝ kǝ wazha ka a vǝr na kǝ ya?”</para>
  <para style="p" vid="MAT 21:16">Əngwar Yesu anǝ nda, “Aˈyi hyi saya jigana wa,</para>
  <para style="q1" vid="MAT 21:16">‘Nagǝ ngǝ hwathliya wazha</para>
  <para style="q2" vid="MAT 21:16">ǝnga wazha mamanji</para>
  <para style="q1" vid="MAT 21:16">aga nda fal ngǝ’ wa?”<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Kǝ ji piyari nda, ji maˈyi a biyar ya mǝlmǝ a biyu Bethlani, vira ji thlalǝbiya vuˈyi ari.<verse eid="MAT 21:17"/></para>
  <para style="s1">Yesu Shiˈwuna Wur Kanda</para>
  <para style="r">(<ref loc="MRK 11:12-14">Markusu 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Əmudlǝ kaɗǝu, ǝnggǝra Yesu ǝnga zǝmbǝlma nyiˈyar a vǝr sha a vu Urshalima, kǝ wuɓǝ mbar nyi. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Ta ji lari vanyi wur kanda a miya lagu, ba ji maˈyi a ndǝgya wa nyi, ma ji nggani ju nda uya yaya a dari, ama sǝ aˈyi mai, kǝl hyali wacu. Kǝ ji shiˈwuna wu kau, ji na, “Tsu nju ɓǝra uya wazha a dar gǝ mai.” Ənggǝrna, kǝ wu ta ulǝnakǝr.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Ta zǝmbǝlma nyiˈyar lari abangau, ba ɗa sǝ dǝdǝgur anǝ nda. Kǝ ndǝ yiwa, “Abari ngǝ wur kanda kǝ ul kukusa ka?”<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Əngwar Yesu anǝ nda, “Yu nar hyi jiri, ma hyi mbǝrsa ǝnga gǝra tǝkǝkǝr wu ɗǝfuwa hyi, aˈyi hyu mǝliya sǝra ɗa ǝnga wur kanda kǝ wacu mai, ama hyu sǝn na anǝ mǝ kau, ‘Tǝsǝnakǝr ga tǝɗau a gwar dǝl dǝgalǝu,’ ba ja ɗa ǝnggǝr ta. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Ma hyi mbǝrsa, kalar sǝra hyu kǝdi Hyal, hyu uya.”<verse eid="MAT 21:22"/></para>
  <para style="s1">Tǝkǝ Kǝr Ənga Dǝnama Nǝ Yesu</para>
  <para style="r">(<ref loc="MRK 11:27-33">Markusu 11:27-33</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Yesu gwu huɗa ki Hyal, ma ja vǝr highiɓau, kǝ pubu dǝdǝgalˈyar ǝnga njira nggurǝm shili ara ja. Ndǝ sa yiwa nyi, “Ənga dǝnama wa nga gu mǝl sǝˈyar ka? Wa ngǝ nǝ ngǝ dǝnama nǝ mǝl sǝˈyar ka?”<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Kǝ Yesu shaɗǝwa, “Yi wu yiwa hyi sǝ pathlǝu tsu. Ma hyi shaɗǝwa ɗa, yu nar hyi tara ǝnga dǝnama wa nga yu mǝl sǝˈyar kau. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>Baɓǝtizǝma nǝ Yahwana, sara mani nga nyi shila? Sara ara Hyal, ǝndǝga sara ara ndau?”</para>
  <para style="p" vid="MAT 21:25">Kǝ ndǝ thla su pama nda, ndǝ na, “Ma mǝn na abǝr, ‘Sara ara Hyal,’ ba ja yiwa, ‘Mi ngǝ ɗa nahyi hǝnggǝri ǝnga ja maya?’ <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Ama ma mǝn na, ‘Sara ara nji,’ hivǝr a gwa, arya kalar ndǝ a hǝnggǝr ri abǝr Yahwana nabi nga ja.”<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Kǝ ndǝ shaɗǝwa nyi anǝ Yesu, “ˈYu sǝnbiya mai.”</para>
  <para style="p" vid="MAT 21:27">Kǝ ji shaɗǝwa nda, ji na, “Yi wu na anǝ hyi tsu mai, tara ǝnga dǝnama wa nga yu mǝl sǝˈyar kǝ mai.”<verse eid="MAT 21:27"/></para>
  <para style="s1">Karapau Ar Kǝra Wazha Shili Mǝthlǝu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>“Mi ngǝ ɗǝngar hyi ar kǝra ndǝr ka? Vanyi ndǝ aˈyi ǝnga wazha shili mǝthlǝu. Ji ngga zǝr tanggǝrma, ji na, ‘Zǝɗa, maˈyi a gwar fa ǝshina.’<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>“Kǝ ji shaɗǝwa anǝ dǝnyi, ‘Nayi wu gwa mai.’ A sǝkari kushu, ba ji ɗǝnga sa gwa, ba ji maˈyi.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>“Kǝ dǝrnda ngga vanyi zǝr kau, ba ji nar nyi sǝra ji na anǝ zǝr tanggǝrma ta. Kǝ ji shaɗǝwa nyi, ‘Yi wu maˈyi tada,’ ama naji maˈyi mai.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>“Wu pama wazha kǝ ya, wa ngǝ ndǝra mǝliya sǝra dǝrnda wu yiwu wa?”</para>
  <para style="p" vid="MAT 21:31">“Zǝr tanggǝrma kau,” ndǝ shaɗǝwa.</para>
  <para style="p" vid="MAT 21:31">Kǝ Yesu na anǝ nda, “Ənga jiri nga yu na anǝ hyi, njir tsǝm budau ǝnga zawarˈyar wu nda gwu tǝlkur Hyal a mwara hyi. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Arya Yahwana shili aga ja sa canǝ hyi lagu tsapǝ nǝ Hyal, ama nahyi hǝnggǝri ǝnga ja mai, ama njir tsǝm budau ǝnga zawarˈyar hǝnggǝri ǝnga ja. Ayukuɗa hyi lari sǝˈyar kǝ patǝu, kǝ hyi nggǝl ara tubi ǝnga mbǝrsa ǝnga ja.”<verse eid="MAT 21:32"/></para>
  <para style="s1">Karapau Ar Kǝra Lǝ Fa Zǝwa Anǝ Nji</para>
  <para style="r">(<ref loc="MRK 12:1-12">Markusu 12:1-12</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>“Nggara mau vanyi karapau. Vanyi thlagǝr fa aˈyi kǝra thlǝkana fa wur inabi. Ji zǝwari fa kǝ wu masǝmǝ, ǝnga ji labiya kaˈu nǝ ɓǝci ˈyimir wur inabi. Kǝ ji liya dzaˈwu nǝ ɓǝla fa. Kǝ ji tǝtǝkǝna fa anǝ njir zǝwa, ba ji maˈyi a nda gǝ ndau. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Ta pǝcir faˈa sǝ sara a gwa tagǝ ɗa, kǝ ji sǝwa mafa nyiˈyar aga nda dlǝwuri nyi yayar wur inabi kǝra njir dlǝwu fa tsǝmiya nyi.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>“Ta njir dlǝwu fa kǝ kathlǝri mafaˈyar kau, kǝ ndǝ dǝgǝ vanyi, ndǝ tsǝya vanyi, nǝ makǝrkura nyi tsu, ba ndǝ tsǝya nyi ǝnga tsǝka vavaka. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Kǝ ji ɓǝra sǝwa alenyi mafaˈyar a ndiya nǝ tanggǝrma ta, ama kǝ njir dlǝwu fa mǝliya nda tangǝ ǝnggǝr ta. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Ayukuɗa kǝ patǝu, kǝ ji na, ‘Kabangǝkau, taˈyi ya sǝwa zǝr ɗa, tara ba nda gǝnggǝr nyi sǝli.’<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>“Ama ta ndǝ lari zǝra nyi, kǝ ndǝ na wu pama nda, ‘Kǝja ndǝr faˈa ki nyi. Mǝna tsǝya nyi, ba sǝr faˈa ki nyi kǝ patǝ a ɗa nǝr mǝn.’ <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Kǝ ndǝ hǝr nyi, ndǝ vakana nyi a biyar ya masǝmǝ, ba ndǝ tsǝya nyi.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>“Ya, ma thlagǝr fa kǝ shili, mi nga hyu nggani thlagǝr fa kau, wu sa mǝl ǝnga njir dlǝwu fa ka?”<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>Kǝ ndǝ shaɗǝwa nyi, “Ju nda sana nji ɗǝmwaˈyi hangǝkal kau, ba ja dzǝgwa nǝ nyi fa kǝ anǝ alenyi njir ndzǝ fa pamǝu, njira wu nda nǝ nyi bamiyar nǝ nyi sǝra ndu uya wu fa kǝ patǝ ayukuɗa nji far sǝ a su ki.”<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>Kǝ Yesu yiwa nda, “Aˈyi hyi saya jigana wu ndǝr Hyal wa?</para>
  <para style="q1" vid="MAT 21:42">“ ‘Tsǝka kǝra njir hǝr diɗana</para>
  <para style="q2" vid="MAT 21:42">ca ngǝ ɗa tsǝka ɓǝlkǝr.</para>
  <para style="q1" vid="MAT 21:42">Hyal ngǝ mǝliya abangau,</para>
  <para style="q2" vid="MAT 21:42">ǝnga ja ɗa sǝ dǝdǝgur</para>
  <para style="q1" vid="MAT 21:42">wu liya mǝn.’ ”<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>“Agabangau, yu nar hyi, abǝr, tǝlkur Hyal nju sa hǝna ara hyi, ba nja nǝ nyi anǝ njira wu nda mǝl sǝra Hyal wu yiwu. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>[Ndǝra tǝɗau a gyar tsǝka kau, ju ɓǝɓǝl, ama ndǝra tsǝka kǝ tǝɗǝ a gyar ja, ju ǝya dzǝ huhutǝu.]”<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Ta pubu dǝdǝgalˈyar ǝnga njir Farisi nggari karapǝˈyar kau, kǝ ndǝ sǝni, abǝr, ar kǝra nda ngǝ Yesu wu ndǝr kau. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Ndu gal lagu kǝra nda sǝn mbari nyi ari, ama kǝ hivǝr mbar nda ara dlamir nji, ara a hǝnggǝr nda, abǝr, Yesu nabi ngau.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Karapau Ar Kǝra Mini Nǝ Hǝdzau</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Yesu ɓǝra ndǝr anǝ nda ǝnga karapǝˈyar, ji na, <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“Tǝlkur Hyal ǝnggǝr vanyi tǝl kǝra pabǝri nyi mini nǝ hǝ mala anǝ zǝr nyi nga nyi. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Ji sǝwa mafa nyiˈyar aga nda nda nggari njira nji nggǝya a shili wu mini kau, ama ba ndǝ nggǝl ara shili.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>“Kǝ ji ɓǝra sǝwa alenyi njir mǝl thlǝr nyiˈyar a nda nǝ njira ji nggǝya, ji na, ‘Nar nda mau, abǝr, sǝ aˈyi kǝra shiwangǝ mai, a fuwar yi sǝ patǝ wu lagu. A tsiyar yi gyaliˈyar ǝnga thla pamǝpamǝ nggǝnggǝthlau, sǝr sǝm tsu a tari. Shila mau, patǝ a shili wu mini kau.’<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>“Ama nandǝ sǝya nyi himi mai. Kǝ kalar ndǝ maˈyi sǝ nyi a nda mǝl sǝr kǝrnyi. Vanyi ndǝ maˈyi a gwar fa nyi, ǝnga vanyi ndǝ tsu, a ndar sugu. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Kǝ alenyi nji mbar mafa nyiˈyar, ba ndǝ dǝgǝ nda, kǝl ta ndǝ tsǝya nda. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Kǝ huɗa tǝl kǝ ndzǝ gagaɗau. Kǝ ji sǝwa soja nyiˈyar aga nda nda sana njir tsa mafa nyiˈyar kau, ǝnga nda nggyina mǝlmǝr nda.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>“Kǝ ji nar nyi anǝ mafa nyiˈyar, ‘Kǝja pǝcir mini a shiliri, kǝja njira yi nggǝya a nggǝlǝr nda ara shili. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Maˈya mau a ndu huɗa giwa, kalar ndǝra hyi thlǝwa hya nggar nyi a shili wu mini kau.’ <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Kǝ mafa nyiˈyar biya ndǝ maˈyi a ndu huɗa giwa, ndǝ nda nggǝya kalar ndǝra ndǝ thlǝwa, nji ɗǝmwaˈyi ǝnga nji mǝnahǝu a shili ar vir mini kau. Kǝ vi kǝ nyi caɓǝu ǝnga mǝthlǝpi kǝra nji nggǝya.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>“Ar pǝci kǝra tǝl shila tsamǝ mǝthlǝpi kǝra nji nggǝya, kǝ ji thlǝwa vanyi ndǝ kǝra gǝra ǝnga kar nǝ mini ar dza ja. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>Kǝ ji na anǝ nyi, ‘Bazhi, lagu mani nga gǝ shili ǝngga gǝra ǝnga lǝgutǝ nǝ mini ar dza ga?’ Ama sǝ aˈyi kǝra nda nyi wu sǝn na mai.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>“Kǝ tǝl nar nyi anǝ njir mǝl thlǝr nyi, ‘Mbiya nya mau tsi daɓǝ ǝnga hi, ba hya vakana nyi a biya a biyu kuthlǝu, vira nju vuwa tiwi ǝnga sǝlǝm ba ǝnga ɗǝ hir!’<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>“Arya njira nji ngga gangǝu, ama nji ɗǝɗǝmǝ yiɗawu.”<verse eid="MAT 22:14"/></para>
  <para style="s1">Yiwa Sau Ar Kǝra Ki Budau <optbreak/> Anǝ Kayisaru</para>
  <para style="r">(<ref loc="MRK 12:13-17">Markusu 12:13-17</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Kǝ njir Farisi biya mbiya miya lagu kǝra nda sǝn mbari Yesu lagur sǝra ju na. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Kǝ ndǝ sǝwa zǝmbǝlmar nda ˈyar ǝnga njira nju ngga nda njir nu Hirudusu. “Malǝmǝ,” ǝngwar nda, “ˈYu sǝni nagǝ ndǝ jijiri ngau, ǝnga gu highiɓǝ lagu Hyal kǝra jiri. Nagǝ wu tazhira mai, arya patǝr nji kakalǝ nga nda wu mwa ngau. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Nar ˈya ja, a ɗar tsaˈa ˈya ki budau anǝ Kayisaru ǝndǝga awau?”<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Ama ara Yesu wu sǝn ɗǝnga ɗǝmwaˈyir nda, kǝ ji na, “Nahyi njir ngguta vi, ara mi nga hyu ngga lǝbam anǝ ɗa? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Canǝ ɗa mǝ gǝnna kǝra nju ki budǝ ǝni.” Kǝ ndǝ hǝbiya nyi kwaɓa, <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>kǝ ji yiwa nda, “Bama wa ǝnga thlǝmǝr wa nga ar kwaɓa ka?”<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>“Bama ǝnga thlǝmǝr Kayisaru,” ǝngwar nda.</para>
  <para style="p" vid="MAT 22:21">“Ma abangǝ ja,” ǝngwar ja, “Hya nǝ nyi anǝ Kayisaru sǝra nǝ Kayisaru, anǝ Hyal tsu sǝra nǝ Hyal.”<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Ta ndǝ nggari abangau, ba ɗa sǝ dǝdǝgur anǝ nda. Agabangau, ba ndǝ piyari nyi ba ndǝ maˈyi sǝr nda.<verse eid="MAT 22:22"/></para>
  <para style="s1">Yiwa Sau Ar Kǝra Hyaˈari <optbreak/> Sara Vir Tau</para>
  <para style="r">(<ref loc="MRK 12:18-27">Markusu 12:18-27</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Tsu ar pǝci ta, njir Sadusi, njira na abǝr hyaˈari sara vir tau aˈyi mai shili ara Yesu, ndǝ sa yiwa nyi. <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“Malǝmǝ,” ǝngwar nda, “Musa nar ˈya abǝr ma sal tau gǝra ya ǝnga mala nyi, ba zamǝ nyi a hǝri mala nyi kǝ aga ja yabiya nyi wazha a gwa. <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Kabangǝkǝ wu pama ˈya, zamǝˈyar aˈyi mǝɗǝfau. Nda dǝgala nda hǝr mala, ba ji tǝ gǝra ya zǝr. Kǝ ji piyari mala kǝ anǝ zamǝ nyi. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Abangǝ nga nyi ɗa ǝnga zamǝ nyi nǝ mǝthlǝkura nyi, ǝnga nǝ makǝrkura nyi, baˈanǝ nǝ mǝɗǝfǝkura nyi kau. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Ayukuɗa nyi patǝu, kǝ mala nyi tǝ tsu. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Ma nji hyaˈari sara vir tau, mala wa nga ju nda ɗa wu pama nda? Arya patǝkura nda a hǝri nyi ri nda aga mala.”<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Yesu shaɗǝwa nda, ji na, “Ɗǝngar hyi aˈyi tsatsaˈa mai ara nahyi wu sǝn sǝra tsǝtsǝfǝ wu ndǝr Hyal mai ǝnga nahyi wu sǝn dǝnama nǝ Hyal. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Ar pǝcir hyaˈara vir tau, shili wu hǝ mala mai, mathlǝkǝˈyi tsu nju lǝ anǝ shili mai, ama ndu nda ɗa ǝnggǝr waladiˈyar a dǝmǝlmau. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Ar kǝra hyaˈari sara vir tau aˈyi hyi jigana sǝra Hyal nana anǝ hyi wa? Ənggǝra nji tsǝfǝri abǝr, <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>‘Nayi ngǝ Hyal nǝ Ibrahimu, ǝnga Hyal nǝ Ishaku ba ǝnga Hyal nǝ Yakubu.’ Aˈyi ja Hyal nǝ nji tǝtǝ mai ama Hyal nǝ njira ǝnga pi.”<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Ənggǝra dlamir nji nggari abangau, ba highiɓa nyi ɗa sǝ dǝdǝgur anǝ nda.<verse eid="MAT 22:33"/></para>
  <para style="s1">Dlaɗǝ Kǝra Ndiya Ənga Dǝgalǝu</para>
  <para style="r">(<ref loc="MRK 12:28-34">Markusu 12:28-34</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Ta njir Farisi nggari abǝr Yesu a haɗiyari miya njir Sadusi, ba njir Farisi kaɓiya dzǝ ba ndǝ shili ǝgya Yesu. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Pathlǝu wu pama nda, ndǝra wu sǝn sǝ gagaɗau ar kǝra dlaɗau, sa dzǝ Yesu ǝnga najaka yiwa sau.<verse eid="MAT 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36"/>“Malǝmǝ, dlaɗǝ mani nga ndiya patǝr dlaɗǝ ǝnga dǝgala?” <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>Yesu shaɗǝwa nyi, ji na, “ ‘Ga yiwu Hyal Thlagǝ ngau ǝnga ɗǝfuwa gǝ papatǝu, ǝnga piya gǝ papatǝu, ba ǝnga ɗǝnga ngǝ papatǝu.’ <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Najakǝ ngǝ dlaɗǝ nǝ tanggǝrma, naja nga ndiya ǝnga dǝgalǝu. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Minu nyi ǝnggǝr naja nga nyi, ‘Ga yiwu tǝwul ngau ǝnggǝr kǝrngau.’ <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Patǝr dlaɗau ǝnga highiɓǝ nǝ Nabiˈyar ar dlaɗǝˈyar kǝ mǝthlǝ kǝ nga ndǝ taˈyau.”<verse eid="MAT 22:40"/></para>
  <para style="s1">Yiwa Sau Ar Kǝra Kǝrsiti</para>
  <para style="r">(<ref loc="MRK 12:35-37">Markusu 12:35-37</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Ar pǝci kǝra njir Farisi daɓǝya dzǝ ar vi zǝmǝu, kǝ Yesu yiwa nda, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>“Mi ngǝ ɗǝngar hyi ar kǝra Kǝrsiti ya? Zǝr wa nga ja?”</para>
  <para style="p" vid="MAT 22:42">“Zǝr Dawuda,” ǝngwar nda.<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>Kǝ Yesu na anǝ nda, “Ya lagu mani ngǝ Dawuda wu ndǝr lagu Mambǝl, ju ngga nyi ǝnga ‘Thlaga’? Arya ji na,<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>“ ‘Thlagǝ na anǝ Thlagǝ ɗa,</para>
  <para style="q2" vid="MAT 22:44">“Nggya lagu mazǝma yau, kǝl yi fiya dawa ngau ǝgya kiɗa hiya gau.” ’<verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Ma Dawuda ngga nyi ǝnga ‘Thlagǝu,’ lagu mani nga ji ɓǝra ɗa zǝr nya?” <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Ndǝ aˈyi kǝra uya sǝr shaɗǝwa mai, mbari ar pǝci ta ndǝ aˈyi ǝnga ɗǝfu yiwa nyi sǝ mai.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Yesu Kughiya Malǝmǝ Dlaɗǝˈyar <optbreak/> Ənga Njir Farisi</para>
  <para style="r">(<ref loc="MRK 12:38-39">Markusu 12:38-39</ref>; <ref loc="LUK 11:43">Luka 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Kǝ Yesu nar nyi anǝ dlamir nji ǝnga zǝmbǝlma nyiˈyar, <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>“Malǝmǝ dlaɗǝˈyar ǝnga njir Farisi nanda ngǝ ǝnga dǝnama nǝ highiɓǝ dlaɗǝ nǝ Musa. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Agabangǝ hya nggya njir ɓǝla kalar sǝra ndu na. Ama hya sara mǝl sǝra ndu mǝl mai, arya nandǝ wu ɓǝlari sǝra ndu highiɓǝ mai. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Ndu mbiya kar tǝdǝɓǝu kǝra dzadzau ara hau ba nda fǝr nyi ar papadla nji, ama nanda ǝnga kǝrnda nandǝ wu fǝ alaga zǝr tsa nda aga dlǝwa nda mai.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>“Ndǝ wu mǝl sǝr mǝla nda patǝ aga nja na. Ndu mbǝ pǝrki nǝ fǝ ndǝr Hyal dlaɓǝ ǝnga takulagǝu ba ǝnga nggusǝri nǝ ha ǝgya fǝlangǝ dzǝgamǝu.<verse eid="MAT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 23:6"/>“Ndu yiwu nja nǝ nda vir nggya kadakadarkur wu mini, ǝnga sǝr nggya kǝra ndiya ǝnga mǝnahǝu wu umbwa daɓǝ dzǝˈyar. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Ndu yiwu nja usa nda ar sugu, ǝnga ndu yiwu tsu nja ngga nda ǝnga ‘Malǝmǝ.’<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>“Ama nja kyaga ngga hyi ǝnga ‘Malǝmǝ’ mai, arya Malǝmǝ zǝmǝ nga ja ara hyi wacu, ǝnga zamǝ nga hyi patǝu. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Hya sara ngga ndǝr duniya ǝnga ‘Tada’ mai, arya Tada zǝmǝ nga ja ara hyi, naja ngǝ ndǝra a dǝmǝlmau. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Ətsu, nju kyaga ngga hyi ǝnga ‘Tarki’ mai, arya Tarki zǝmǝ nga ja ara hyi, naja ngǝ Kǝrsiti. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Gau wur hyi, ja ɗa ǝnggǝr ndǝr mǝl thlǝr anǝ hyi. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Kalar ndǝra wu fǝ kǝrnyi nju nda tina nyi, ama ndǝra tina kǝrnyi tsu nju nda hana nyi.<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>“Sǝr tǝhuɗǝ anǝ hyi malǝmǝ dlaɗǝ Musa ˈyar ǝnga njir Farisi, njir ngguta vi! Hyi dari nyi lagur vu tǝlkur Hyal anǝ nji. Nahyi ǝnga kǝrhyi nahyi vu mai, ǝnga nahyi piyari nyi lagu tsu anǝ njira vǝr yiwu nda vu mai. <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/>[Sǝr tǝhuɗǝ anǝ hyi malǝmǝ dlaɗǝˈyar ǝnga njir Farisi, nahyi njir ngguta vi! Hyu mbǝtǝbiya kar mathlǝkǝˈyi tǝsal ǝnga hya dzǝgwa mǝliya kǝdi Hyal tugu aga nja na. Agabangau, Hyal wu nda nǝ hyi ɓwaɓwatǝ gagaɗau.]<verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>“Sǝr tǝhuɗǝ anǝ hyi malǝmǝ dlaɗǝˈyar ǝnga njir Farisi, njir ngguta vi! Hyu maˈyi baˈa a biyar ya mǝlmǝ ǝnga a biyar ya dǝl, aga hya kǝzǝya alaga zǝmbǝlma pathlǝu kǝra wu nu hyi. Ama tsu ndǝra hyi uya, ba hya mǝliya nyi fǝrkafǝrka a ndiya hyi, nahyi wazha uˈur kǝtsa.<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>“Sǝr tǝhuɗǝ anǝ hyi, nji lǝfǝ nǝ tǝɗǝmwa. Kǝ hyu na, ‘Ma ndǝra sǝm fǝla ǝnga ki Hyal, naji ndzana sǝ mai, ama ndǝra sǝm fǝla ǝnga ǝndzau nǝ ki Hyal, sǝm fǝla nyi a mbar nyi ri.’ <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Nji thlǝkǝlǝmǝu, nji lǝfau! Mani nga ndiya ǝnga dǝgala, ǝndzau ǝndǝga Ki Hyal kǝra mǝliya ǝndzǝ kǝ cica? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Hya vǝr na tsu, ‘Ma ndǝra sǝm fǝla ǝnga bagadi nǝ nggyi sau, naji ndzana sǝ mai, ama ndǝra sǝm fǝla ǝnga sǝra nji lǝri, sǝm fǝla nyi a mbari nyi ri.’ <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Nji lǝfau! Mani nga ndiya? Sǝra nji lǝri ǝndǝga bagadi kǝra mǝliya sǝra nji lǝri kǝ cica? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Nggara mǝ ja, kalar ndǝra sǝm fǝla ǝnga bagadi nǝ Hyal, a sǝmkur ja fǝla ǝni ba sǝra a dari patǝu. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Kalar ndǝra sǝm fǝla ǝnga Ki Hyal tsu, a sǝmkur ja fǝla ǝni ǝnga ndǝra vǝr nggya a gwa. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Kalar ndǝra sǝm fǝla ǝnga dǝmǝlmau, a sǝmkur ja fǝla ǝnga tsǝkafǝ Hyal ǝnga ndǝra vǝr nggya a dari.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>“Sǝr tǝhuɗǝ anǝ hyi, malǝmǝ dlaɗǝˈyar ǝnga njir Farisi, njir ngguta vi! Hyu hǝbiya nyi anǝ Hyal pathlǝu wu sǝ kumo nǝ kwanjaɗi, ǝnga nggajiji, ba culi kanggǝranggahyiu. Ama kǝ hyi piyari dlaɗǝ kǝra ndiya ǝnga mǝnahǝu, ca ngǝ mǝl sǝra tsaˈa, ba tǝhuɗǝu, ba taˈyi ar jirkur. Hyu kyaga mǝl thlǝr ǝnga sǝˈyar kau, aˈyi kǝl hya piyari alenyi sǝ mai. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Nahyi njir tǝɗǝmwa lǝfau, hyu tsǝbiya favǝ wu ˈyimi a sara hya tasiya, ama kǝja hya dzǝgwa tasiya ri dlǝgwamǝu.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>“Sǝr tǝhuɗǝ anǝ hyi, malǝmǝ dlaɗǝˈyar ǝnga njir Farisi, njir ngguta vi! Hyi cina dagǝrya cala ǝnga cala wu, ama huɗa nyi nyinyi ǝnga dlǝrbau ǝnga kasali. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Nahyi Farisi nji lǝfau! Hya kyaga cina huɗa cala ǝnga cala wu kwatahǝu, kadivira ya nyi a ɗa camǝ tsu.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>“Sǝr tǝhuɗǝ anǝ hyi, malǝmǝ dlaɗǝˈyar ǝnga njir Farisi, njir ngguta vi! Ənggǝr hu kǝra nji pabǝri ya nyi pǝrtǝ nga hyi, sara biya nju lari nyi gumaguma, ama a vu huɗa nyi, nyinyi nga nyi ǝnga ɗǝhi nji ɗiɗiya ǝnga kalar sǝ diyadiyaɓǝu. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Lagu zǝmǝ nga hyi, nju lari a biya ǝnggǝr nji tsapǝu, ama a vu huɗa hyi njir ngguta vi ǝnga njira gǝra ɓǝla ndǝr Hyal nga hyi.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>“Sǝr tǝhuɗǝ anǝ hyi, malǝmǝ dlaɗǝˈyar ǝnga njir Farisi, nahyi njir ngguta vi! Hyi hǝriya nyi hu anǝ nabiˈyar ǝnga hyi ɓathlǝya dza hu nji tsapǝu. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>Ənga hyu na, ‘Maja abǝr aˈyi ˈya ar pǝcir ǝjir ˈya, ˈyi wu nda fuwa tsi wu pǝ mashi nǝ nabiˈyar mai.’ <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Lagu kǝ nga hyi cabiya abǝr nahyi ngǝ culi njira tsǝya nabiˈyar. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Hya nyabiya tsǝla bikǝ nǝ ǝjir hyi kǝja!<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>“Nahyi pabǝˈyar! Wazha mǝtsapa! Lagu mani nga hyu nda kǝtiya kǝrhyi ara numa nǝ uˈur kǝtsa? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Agabangau, yu sǝwa hyi nabiˈyar ǝnga njir sǝn sau ba malǝmˈyar. Wu pama nda hyu nda tsǝya, ǝnga hyu dlakǝya alenyi njir nda ar wu dladlakau. Alenyi nji tsu hyu nda dǝgǝ nda ǝnga wuɗa wu umbwa daɓǝ dzǝˈyar, ǝnga hyu nǝ nda ɓwaɓwatǝ ǝnga hya kǝdlǝbiya nda sara wu mǝlmǝ pamǝpamǝu. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Agabangau, a dar kǝra hyi ngǝ mashi nji tsapǝu patǝ kǝra nji tsǝya wu duniya, mbari ar mashi Habila ndǝ tsapǝu baˈa shili ar mashi Zakariya zǝr Berikiya, ndǝra hyi tsǝya wu pama vi cici wu Ki Hyal ǝnga bagadi. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Yu nar hyi ǝnga jiri, numa nǝ sǝˈyar kǝ patǝu wu ɗa ǝnga njir zaman ǝshina kau.”<verse eid="MAT 23:36"/></para>
  <para style="s1">Yesu Uya Huɗathla Ar Kǝra Urshalima</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>“Əm, Urshalima, Urshalima! Ndǝr tsa nabiˈyar, ǝnga ndǝr vavaka njira Hyal sǝwa ngǝ a shili ǝnga tsǝka kǝl ta gǝ dlǝna nda! Aga yiɗau nga yu yiwu ya fǝri tsa yi ar dza nji ngǝ pata, ǝnggǝr kǝra miya tǝka wu tsǝm wazha nyi ǝgya ja, ama nahyi piyari ɗa mai! <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Lara mǝ gǝyi, kǝja kir hyi a nggyari huɗǝfi. <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Yu na anǝ hyi, tsu hyu ɓǝra lari ɗa mai, kǝl hyi nda na, ‘Barka anǝ ndǝra wu shili wu thlǝmǝr Thlagǝu.’ ”<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Mǝtsamǝ Sǝra Cabiya Kuɗiyar Duniya</para>
  <para style="r">(<ref loc="MRK 13:1-2">Markusu 13:1-2</ref>; <ref loc="LUK 21:5-6">Luka 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Kǝ Yesu piyari huɗa ki Hyal ja vǝr maˈyi, kǝ zǝmbǝlma nyiˈyar shili ǝgya ja ndu caca anǝ nyi hǝhǝrˈyar nǝ ki Hyal. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>“Hyu lari sǝˈyar kǝ patǝ ya?” ji shaɗǝwa nda. “Yi wu nar hyi jirkura nyi, tsǝka hǝr kiˈyar kau, aˈyi ǝnggau kǝra gǝra dlana mai, nju nda dlana nda papatǝu, nju piyari tsǝka zǝmǝ ar kǝra kuvwa nyi mai.”<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Ma Yesu a vǝr nggya a dar mǝ zaitunu, kǝ zǝmbǝlma nyiˈyar thlǝwa nyi zhizhir nda. Əngwar nda, “Nar ˈya, ǝnuwa ngǝ pǝci kǝra sǝˈyar kǝ wu nda ɗar kǝra, ǝnga mi ngu nda ɗa mǝtsamǝ nǝ shili nga, ǝnga kuɗiyar najaka duniya?”<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>Yesu shaɗǝwa nda, ji na, “Hya nggya hya tsamǝ ǝnga hangǝkal nja sara nggutana hyi.” <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Arya nji gangǝu wu nda shili wu thlǝmǝ ɗa, ndu na ǝnga kǝrnda, “Nayi ngǝ Kǝrsiti,” ba nda nggutana nji gangǝu. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Hyu nda nggari ar kǝra papa ǝnga ndǝr ǝngwa ǝngwa ar kǝra papa, hangǝkalǝr hyi ja sara hyaˈari mai. Kǝl ma sǝˈyar kǝ nyabiya dzau, ama tsu kuɗǝr duniya naɗǝu. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>ˈYiˈyi wu dlǝɗǝ ˈyiˈyi, ǝnga tǝlkur wu nda par tǝlkur. Wuɓau ǝnga kǝnggǝɗǝr ˈyiˈyi wu nda ɗarkǝr ar vi pamǝpamǝ gangǝu. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Sǝˈyar kǝ patǝ dzǝgwar ɓwaɓwatǝ ngǝ wacu.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>“Nji wu nda lǝr hyi aga nja nǝ hyi ɓwaɓwatǝ ǝnga tsu nja tsǝtsǝya hyi. Nji patǝ wu nda piyari shishir dza hyi arya yau. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Ar pǝci ta nji gangǝu wu nda piyari mbǝrsar nda, ǝnga ndu nda thlǝna hiya kuvwar nda, ba tsu nda piyari shishir dza kuvwar nda. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Nabi fatiˈyar tsu wu nda shili, ba nda sa nggutana nji gangǝu. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Arya ɗǝmwaˈyikur wu nda cakau, yiwukur nǝ badǝgala nju nda ɗa shishiˈwu. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Ama ndǝra cinapi baˈanǝ kuɗiya, ju uya mbǝɗau. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Ətsu ndǝshigu nǝ tǝlkur Hyal nju nda tǝtǝlna baˈamani wu duniya, aga ja ɗa sakida anǝ njir duniya patǝu, kadivira kuɗiyar duniya wu shili.<verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>“Ma hyi lari sǝ zhizhigǝr wu ki Hyal kǝra cicau, ǝnggǝr kǝra nabi Daniyalu nana ta, bǝgǝ ndǝr jiga ja nggabiya. <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>Bǝgǝ njira vǝr nggya wu Yahudi nda hwi a du mau. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Ndǝra a dar kǝra umbwa, ja sara gya ja vu ki aga vuwa hǝ sǝ mai, ara ja sara sana pǝci. <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Ndǝra a gwa tagǝ tsu, ja sara sha a su ki aga sa hǝ kar ha nyi mai. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Pǝci ta wu nda ɗa sǝr tǝhuɗǝ anǝ mathlǝkǝˈyi kǝra ǝnga huɗǝu ǝnga kǝra a vǝr lǝ uˈwa ar pǝci ta! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Hya kǝdi Hyal sǝ ka sara ɗa pǝcir fwahǝu ǝnga alaga ar pǝcir ɓǝlsar. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Ar pǝci ta ɓwaɓwatǝ wu nda ɗa gagaɗau kǝra nji gǝra saya ɗahari mbari ar dzǝgwar duniya, ǝnga tsu culiya nyi wu ɓǝra nda ɗarkǝr mai. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Maja aˈyi Thlagǝ gǝnna dzǝgamǝkura pǝci kǝ mai, ndǝr uya mbǝɗau aˈyi mai. Ama arya nji cacaɗǝ nǝ Hyal, a gǝnnar ja dzǝgamǝkura pǝci kau. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>Ar pǝci ta, ma nji nar hyi abǝr, ‘Kǝja Kǝrsiti ǝnggau!’ alaga, ‘Wata ja a ndǝna!’ hya sara hǝnggǝri ǝnga nda mai. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Arya Kǝrsiti nǝ fati ǝnga nabiˈyar nǝ fati wu nda shili ndu sa mǝl sǝ dǝdǝgur nǝ ngguta nji alaga nji cacaɗǝ nǝ Hyal ma, ma sǝn ɗa nju nda nggutana nda. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Nggara mau ja, a nar hyir yi sǝˈyar kǝ tsu kaɗǝu.<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>“Agabangau, ma vanyi ndǝ nar hyi, ‘Wata ja a gwar tagǝu,’ hya sara biya sǝhimi nyi mai; alaga ji na anǝ hyi, ‘Kǝja ja ǝnggau ar vir mbwau,’ hya sara hǝnggǝri ǝni mai. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Arya shilǝr Zǝr Ndau, nju nda lari patǝ ǝnggǝr kǝra par wu sǝm sara wu sǝbiyar pǝci ba nju lari patǝ wu gwa tǝɗǝ pǝci. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Ma vira sǝ tǝtau ari ǝna ngǝ kwadǝgǝu wu kaɓau.<verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>“Ayukuɗa pǝcir ɓwaɓwatǝ kǝ tǝrabiya shiˈuɗǝu,</para>
  <para style="q1" vid="MAT 24:29">“ ‘Pǝci wu nda vu kuthlǝu,</para>
  <para style="q2" vid="MAT 24:29">ba hya wu nda nggǝl ara mbǝl</para>
  <para style="q1" vid="MAT 24:29">shashilga wu nda</para>
  <para style="q2" vid="MAT 24:29">tǝɗau sara dǝmǝlmau,</para>
  <para style="q1" vid="MAT 24:29">ǝnga tsu dǝnamaˈyar</para>
  <para style="q2" vid="MAT 24:29">nǝ sǝɓǝ dǝmǝlmau,</para>
  <para style="q1" vid="MAT 24:29">wu nda kǝnggǝɗǝr dzau.’ ”<verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>“Ar pǝci ta mǝtsamǝ nǝ Zǝr Ndau wu nda cabiya dzǝ a dǝmǝlmau. Njir duniya papatǝu wu nda gwu sǝˈyinggu. Ndu nda lari Zǝr Ndau wu shida sara dǝmǝlmau wu dlama ǝnga dǝnama ba ǝnga kadakadarkur nyi gagaɗau. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Ju nda sǝwa waladi nyiˈyar ǝnga nja mbǝɗiya madiya tǝlǝmǝ ǝnga ɗahǝ ngga, ba nda dzǝgwa kaɓiya nji cacaɗǝ nyi sara wu ndǝla mǝlmǝ baˈa ndar vanyi.<verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>“Highiɓǝra mau sǝ sara ara wur kanda. Ma tsa nyiˈyar dzǝguya dlǝɗau ǝnga hyali wu thlau, hya sǝni abǝr biyargwa a shiliri. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Abangǝ tsu, ma hya lar sǝˈyar kǝ a ɗari, hya nggya ǝnga sǝni abǝr pǝci a ɗar lǝhǝu, lǝhǝ ar yir hiya hyi. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Yu nar hyi jirkura nyi, najaka zamanǝu, aˈyi wu tǝrabiya mai, kǝl sǝˈyar kǝ patǝ nyabiya dzau. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Dǝmǝlmau ǝnga gyiwu ˈyi wu nda tǝrabiya, ama ndǝr ɗa nǝ nyi wu tǝɗau a gyiwu ˈyi mai.”<verse eid="MAT 24:35"/></para>
  <para style="s1">Pǝcir Shilǝr Yesu Ndǝr Sǝni Aˈyi Mai</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>“Ndǝr sǝni pǝci ǝnga saka kǝra sǝˈyar kǝ wu ɗarkǝr aˈyi mai, alaga waladiˈyar kǝra a dǝmǝlmau, ǝnga alaga Zǝra nyi, ama kǝl Tada zhizhi nyi. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Ənggǝr kǝra ɗarkǝr wu pǝcir Nǝhu, abangǝ nga nyi wu nda ɗa ar pǝcir shilǝr Zǝr Ndau. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Kadivira pǝlimba sana duniya, nji kǝl sǝm sǝr sǝm ǝnga sa sǝ sasa, ndu faˈa mathlǝkǝˈyi ǝnga ndu lǝ kuˈyi anǝ shili, baˈanǝ shili ar pǝci kǝra Nǝhu gwu kwambwal dǝgal ta ari. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Fǝɗǝngǝkǝr nda abǝr sǝ ǝnggǝr kǝ wu ɗa, ya, kǝja pǝlimba a shiliri ka sa kwafǝna nda. Tangǝ ǝnggǝr ta nga nyi wu nda ɗa ar pǝcir shilǝr Zǝr Ndau. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Ar pǝci ta, shili mǝthlǝ a vǝr mǝl thlǝr ar fa, ba nja hǝr ndǝ pathlǝu ba nja piyari pathlǝu. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Ar pǝci ta, mathlǝkǝˈyi mǝthlǝ a vǝr awau ar bǝra, ba nja hǝr ndǝ pathlǝu ba nja piyari pathlǝu.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>“Agabangau, hya tsamǝ ǝnga hangǝkal arya nahyi wu sǝnbiya tara pǝci mani ngǝ Thlagǝ wu nda shili mai. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Nggabiya mau, maja abǝr thlagǝr ki wu sǝni pǝci kǝra ndǝr hǝl wu shili wu ki nyi, ju nggya liliˈu, naji wu piyari ndǝr hǝl a sa pǝthlǝ ki nyi mai. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Agabangau, kǝl hya nggya papabau, arya nahyi wu sǝni tara ǝnuwa ngǝ Zǝr Ndau wu nda shili ari mai.<verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>“Wa ngǝ mafa kǝra tsaˈa miya ɗǝfuwa ǝnga ndǝr mǝl thlǝr kǝra hahanga? Naja ngǝ ndǝ kǝra tarki nyi wu fiya nyi dǝgal ar kǝra njir mǝl thlǝr nyiˈyar, aga ja nǝ nda sǝr sǝm ar pǝci kǝra tsatsaˈa. <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Mafa kǝra thlagǝr ki nyi shili ji sa thlǝwa nyi ja vǝr mǝl thlǝr nyi kakalǝu, ju ɗa ǝnga caguli. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Yu nar hyi jiri, tarki nyi wu nda fiya nyi dǝgal ar kǝra sǝ nyi patǝu. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Ama ma ji ɗa, mafa kǝra ɗǝmwaˈyi ngau, ju nda na anǝ kǝrnyi, ‘Kǝja tarki ɗa a nggyari ara shili kaɗǝu.’ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>Ba ji nggya aga dǝgǝ njir mǝl thlǝr kuvwa nyiˈyar, ǝnga ju sǝm ǝnga sa sǝ sasa ǝnga njir sa sǝ sasa. <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>Ma ji mǝl abangau, tarki nyi wu nda shili kukuthlǝu ar pǝci kǝra ji gǝra nggani ju shili. <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>Tarki wu sa takasiya nyi ba ja sǝwa nja vakuwa nyi a vu pama njir ngguta vi, vira ndu vuwa nggya ndu tiwi ǝnga sǝlǝm ba ǝnga ɗǝ hir.”<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Karapau Ar Kǝra Kuˈyi Kumou</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>Kǝ Yesu dumwa ǝnga ndǝr, ji na, “Ar pǝci ta, nju nda gǝla tǝlkur Hyal ǝnga kuˈyi kumo kǝra gǝra sǝn ndǝ sal kǝra hǝri pitǝllar nda, aga nda nda sǝkǝ shilǝr salkwanjili. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Tǝfu wu pama nda dza nga nda, ǝnga tǝfu wu pama nda tsu hahangǝ nga nda. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Dza nyiˈyar kǝ hǝri pitǝllar nda gǝra ǝnga mal zaɓǝkwa wu pǝla. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Hahanga nyiˈyar hǝri pitǝllar nda ǝnga mal zaɓǝkwa wu pǝla. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Salkwanjila nyi aˈyi shili kaɗǝ mai, kǝ ndǝ gwu ghanyi, kǝ ghanyi hǝna nda patǝu.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>“Hathlǝr vuˈyi, kǝ nji siya mala wau, abǝr, ‘Kǝja salkwanjili a shiliri! Sǝbiya mau hya sa dlǝwuri nyi.’<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>“Kǝ kuˈya nyiˈyar patǝ hyaˈari sara wu ghanyi, kǝ ndǝ mbǝmbǝwa uˈu wu pitǝllar nda. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Kǝ dza nyiˈyar kǝ na anǝ kuˈyi hahangǝ kau, ‘Ɗar ˈya mau, malǝr hyi kǝ kukushu, kǝja pitǝllar ˈya a gwari wu tau.’<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>“Əngwar kuˈyi hahangǝ kǝ anǝ nda, ‘Awau, wu ɗa tsaˈa anǝ mǝn patǝ mai, sǝra hya mǝl ca ngǝ hya maˈyi a biya ara njir ɗǝlna mal aga hya biya ɗǝlbiya nǝr hyi.’<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>“Ama ma tsu nda ar lagu a vǝr maˈyi a nda ɗǝl mala nyi, ba salkwanjili shili. Kuˈyi kǝra pabǝri kǝrnda maˈyi ǝkkǝˈyi ja a vwar vir mini nǝ hǝ dzau, kǝ nji haɗiya miya kiya nyi.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>“Ayukuɗa ɓǝliya sar kushu kǝ alenyi kuˈyi ta shili, ndu na, ‘Tarki! Tarki! Pahǝna ˈya miya ki!’<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>“Ama ju nda shaɗǝwa nda, ‘Nayi wu sǝni hyi mai.’<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>“Agabangau, hya nggya ǝnga hangǝkal arya nahyi wu sǝni pǝci ǝnga saka nǝ shili ɗa mai.”<verse eid="MAT 25:13"/></para>
  <para style="s1">Karapau Ar Kǝra Mafa Jijiri</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luka 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>“Tǝlkur Hyal wu nda ɗa ǝnggǝr ndǝra wu nda maˈyi a nda gǝ ndǝ naɗǝu, kǝ ji ngga mafa mǝl thlǝr nyiˈyar, ba ji tǝkǝya nda gǝnna nyi. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Ji nǝ nyi gǝnna dubu tǝfu anǝ vanyi ndau, anǝ vanyi ndau gǝnna dubu mǝthlǝ ǝnga gǝnna dubu pathlǝu tsu anǝ vanyi ndau. Anǝ kalar ndau, ba ji nǝ nyi sǝra tsaˈa aga dǝnama nyi. Kǝ ji dzǝgwa maˈyi a nda gǝ ndau. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Ndǝra nji nǝ nyi dubu tǝfu maˈyi ǝnga kusa ji nda shafǝli ǝnga sǝra nji nǝ nyi, ba ji uya akkǝri dubu tǝfu a dar kǝri. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Abangǝ tsu ndǝra nji nǝ nyi dubu mǝthlǝ uya akkǝri dubu mǝthlǝ a dar kǝra nǝ nyi.<verse eid="MAT 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 25:18"/>“Ama ndǝra nji nǝ nyi dubu pathlǝu maˈyi, ji nda labiya kaˈu a gyiwu ˈyi, ba ji ɗǝwana gǝnna thlagǝr ki nyi a gwa.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>“Ayukuɗa pida gangǝu, kǝ thlagǝr ki mafaˈyar kǝ sha shili, ji sa yiwa aga nda nar nyi ǝnggǝra ndǝ ɗa ǝnga gǝnna kǝra ji nǝ nda. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Ndǝra dlǝwuri dubu tǝfu shili ǝnga dubu tǝfu a dar kǝra nyi, ji sa na, ‘Thlagǝr ki, gǝ nǝ ɗa dubu tǝfu, kǝja a ɓǝra uyari yi dubu tǝfu a dar kǝri.’<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>“Thlagǝr ki nyi shaɗǝwa, ‘Usi mafa tsapǝu ndǝr mǝl thlǝr tsaˈa miya ɗǝfu! Gǝ mǝl thlǝr ngǝ tsaˈa miya ɗǝfu ǝnga sǝ kushu kǝra nji nǝ ngau, agabangau, yu nda fiya ngau, ar kǝra sǝ gangǝu. Shili ga nyabiya dzǝ ǝnga caguli ǝnga yau!’<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>“Ndǝra dlǝwuri dubu mǝthlǝ tsu shili, ji sa na, ‘Thlagǝr ki, gǝ nǝ ɗa dubu mǝthlǝu, ya, kǝja ya ɓǝra uyari akkǝri dubu mǝthlǝ a dar kǝri.’<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>“Thlagǝr ki nyi shaɗǝwa, ‘Usi mafa tsapǝu ndǝr mǝl thlǝr tsaˈa miya ɗǝfu! Gǝ mǝl thlǝr ngǝ tsaˈa miya ɗǝfu ǝnga sǝ kushu kǝra nji nǝ ngau, agabangau, yu nda fiya ngau, ar kǝra sǝ gangǝu. Shili ga nyabiya dzǝ ǝnga caguli ǝnga yau!’<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>“Kǝ ndǝra dlǝwuri dubu pathlǝu tsu shili, ji sa na, ‘Thlagǝr ki, a sǝni yau abǝr nagǝ ndǝ dzadzau ngau, gu faˈa sau ar vira gǝ gǝra thlǝkana, kǝja nagau ndǝr yiwu sǝ kurthlǝ ngau. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Ca ngǝ mǝliya hivǝr mbar ɗa ara mǝl thlǝr ǝnga gǝnna ngau, ba yi labiya kaˈu a gyiwu ˈyi, ba yi ɗǝwana a gwa. Kǝja sǝ ngau tsu tsǝkaˈa.’<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>“Kǝ thlagǝr ki nyi shaɗǝwa, ‘Nagǝ mafa ɗǝmwaˈyi hangǝkal ndǝ kukufǝu! Əm, a sǝni gǝ abǝr yu sǝn faˈa sau ar vira yi gǝra thlǝkana ǝnga nayi ndǝr yiwu sǝ kurthlǝ ngǝ ya? <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Ma abangǝ ja, gu kyaga nda hǝri gǝnna ɗa a dar vir fǝ gǝnna aga ma yi shili ǝnggǝr kau, yu sa uya akkǝri a dar kǝri.<verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>“ ‘Dlǝwura mau gǝnna dubu pathlǝu kǝra ara ja kau, ba hya nǝ nyi anǝ ndǝra ǝnga dubu kumou. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Arya ndǝra ǝnga sau, nju cakǝr nyi aga ja uya gangǝu. Ndǝra gǝra ǝnga sǝ tsu, alaga sǝra aˈyi ara ja kushu kau, ba nja ɓǝra dlǝwuri ara ja. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Ba nja dzǝgwa vakana mafa didiɗi kǝ a biya, a vu kuthlǝu vira ju nda tiwi ǝnga sǝlǝm ba ja ɗǝ hira ja gagaɗau.’<verse eid="MAT 25:30"/></para>
  <para style="s1">Numa Nǝ Jamuya</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>“Ar pǝci kǝra Zǝr Ndau wu nda shida wu kadakadarkur nyi, ǝnga waladiˈyar patǝ ǝkkǝˈyi ja, ju nda sa nggya ar tsǝkafǝ nǝ kadakadarkur. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Nju nda sa kaɓiya patǝr njir duniya wu mwa nyi, ba ja dzǝgwa tǝkǝbiya nji patǝ bwata mǝthlǝ ǝnggǝr kǝra ndǝr ɓǝla wu tǝkǝbiya pama tǝmahǝˈyar ǝnga kuˈyar. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Ba ja nda piya tǝmahǝˈyar lagu tsi mazǝma ja ǝnga kuˈyar lagu tsi matsala ja.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>“Ba tǝl a dzǝgwa na anǝ njira ar mazǝma ja, ‘Shila mau nahyi njira Dǝɗa fǝnggǝr hyi barka; hya dlǝwuri sǝr faˈa kir hyi, ca ngǝ tǝlkur Hyal kǝra nji pabǝr hyi tsu kaɗǝ mudlau. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Arya ɗǝɗǝmǝu wuɓau a vǝr tǝ ɗa, ba hyi nǝ ɗa sǝr sǝm. Hili a vǝr tǝ ɗa, ba hyi nǝ ɗa sǝr sa, ǝnga tsu mǝthlǝpi yau, ba hyi hǝr ɗa a vu kir hyi. <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>Turusu yau, ba hyi har ɗa kar, kǝ yi ɗa gǝra ngga, ba hyi shilǝgǝbiya ɗa. Nji fuwa ɗa wu fursǝna, ba hyi sa tular ɗa.’<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>“Ba nji tsapǝ ka na anǝ nyi, ‘Thlagǝu, a nuwa nga ˈyi lar ngǝ ǝnga wuɓau, ba ˈyi nǝ ngǝ sǝr sǝma, ǝnga ˈyi lar ngǝ ǝnga hili, ba ˈyi nǝ ngǝ sǝra ga sa ka? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Ba a nuwa nga ˈyi lar ngǝ mǝthlǝpi, ba ˈyi nggar ngau a vu kir ˈya, ǝndǝga turusu, ba ˈyi nǝ ngǝ sǝra ga har ara? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Ənga ǝtsu a nuwa nga ˈyi lar ngǝ gǝra ngga ǝnga wu fursǝna, ba ˈyi sa tular nga?’<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>“Ba tǝl ka dzǝgwa shaɗǝwa nda, ja na, ‘Jiri nga yu na anǝ hyi, kalar sǝra hyi mǝliya nyi anǝ kusha zamǝɗaˈyar kau, anǝ ɗa nga hyi mǝliya.’<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>“Ba tǝl ka dzǝgwa na anǝ njira ar matsala ja, ‘Kwaya mau a dzǝr ɗa, nahyi nji shishiˈwau, maˈya mau a ndu uˈur kǝtsa kǝra nji pabǝri nyi anǝ Shatan ǝnga waladi nyiˈyar. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Arya wuɓau a vǝr tǝ ɗa, nahyi nǝ ɗa sǝr sǝm mai. Hili tsu a vǝr tǝ ɗa, nahyi nǝ ɗa sǝr sa mai. <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>Kǝ yi ɗa mǝthlǝpi anǝ hyi, nahyi nggar ɗa a vu kir hyi mai. Turusu yau, nahyi nǝ ɗa kar ha mai. Ənga gǝra ngga yau, ǝnga wu fursǝna, nahyi sa tulari ɗa mai.’<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>“Nanda tsu, ndǝ shaɗǝwa nyi, ‘Thlagǝu, a nuwa nga ˈyi lar ngǝ ǝnga wuɓau ǝnga hili a vǝr tǝ ngau, ǝnga mǝthlǝpi gau, ǝnga wu fursǝna, ǝnga gǝra ngga ba turusu, ama naˈyi dlǝwari ngǝ maya?’<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>“Ba ja dzǝgwa shaɗǝwa nda, ‘Yi wu nar hyi jirkura nyi, kalar sǝra hyi gǝra mǝliya nyi anǝ kusha zamǝɗaˈyar kau, anǝ ɗa nga hyi nggǝl ara mǝl.’<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>“Ba nda maˈyi a gwu ɓwaɓwatǝ gǝra kuɗau, ama nji tsapǝu nǝr nda a gwu pi gǝra kuɗau.”<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">Mba Miya Aga Tsa Yesu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Markusu 14:1-2</ref>; <ref loc="LUK 22:1-2">Luka 22:1-2</ref>; <ref loc="JHN 11:45-53">Yahwana 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Ənggǝra Yesu kuɗǝna na patǝ sǝˈyar kau, kǝ ji na anǝ zǝmbǝlma nyiˈyar, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“Hyu sǝni abǝr, lardur nǝ vǝlna a hyiri pida mǝthlǝ ǝnga tsu nju nda sa lǝri Zǝr Ndau aga nja dlakǝya nyi.”<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Kǝ pubu dǝdǝgalˈyar ǝnga njira nggurǝm nǝ mǝlmǝ kaɓiya dzǝ patǝ ar pathla nǝ pubu kǝra ndiya ǝnga dǝgalǝu, ndǝra nju ngga ǝnga Kayafasu. <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>Ndǝ mba miya lagu kǝra nda sǝn uya nda mbar Yesu ari ɗǝɗǝwa aga nda tsǝya nyi. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>Ama kǝ ndǝ na, “Aˈyi pǝcir mini kǝ mai, ara ja sara hyaˈana hangǝkala nji.”<verse eid="MAT 26:5"/></para>
  <para style="s1">Nji Ɓǝsiya Yesu Ənga Mal Kisǝu <optbreak/> Wu Bethlani</para>
  <para style="r">(<ref loc="MRK 14:3-9">Markusu 14:3-9</ref>; <ref loc="LUK 7:37-38">Luka 7:37-38</ref>; <ref loc="JHN 12:1-8">Yahwana 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Ma tsu Yesu wu Bethlani, wu ki Simanu ndǝra ɗǝɗǝmǝu ndǝr pibi, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>kǝ vanyi mala shili ǝnga pǝla mal kisǝu kǝra nju ɗǝl ǝnga gǝnna gangǝ gagaɗau. Mala kǝ shili ji sa pǝnggǝr nyi mala nyi a gyar kǝra ja ar pǝci kǝra nda vǝr sǝm sǝr sǝm.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Ta zǝmbǝlma nyiˈyar lari abangau, kǝ huɗa nda ndzau, ndu na anǝ kǝrnda, “Wathlǝmǝ culi najaka wira sa? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Mal kau, nju sǝn ɗǝlna ǝnga gǝnna gangǝu, ba nja dlǝwari nji tǝtǝ dǝnama ǝnga gǝnna nyi.”<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Arya Yesu wu sǝnbiya sǝra ndu na, kǝ ji na anǝ nda, “Aga mi nga hyu ɓwanǝ nyi kǝr anǝ mala ka? A mǝliya ɗar ja sǝra mǝnahǝu. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Nji tǝtǝ dǝnama aˈyi nda ǝkkǝˈyi hyi parangǝu, ama nayau aˈyi yi ǝkkǝˈyi hyi parangǝ mai. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Mal kisǝ kǝ ji pǝnggǝr ɗa kau, nǝ pabǝ dzǝ nǝ haɗǝ ɗa ngau. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Yu nar hyi jirkura nyi, kalar vira nju nda tǝtǝlna ndǝshigu kǝ ari wu duniya patǝu, nju nda ndǝr ar kǝra sǝ kǝ ji mǝliya kau, aga ɗǝngari ǝnga ja.”<verse eid="MAT 26:13"/></para>
  <para style="s1">Yahuda Dlǝwunggǝri Aga <optbreak/> Ja Thlǝna Hiya Yesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Markusu 14:10-11</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Kǝ pathlǝu wu pama zǝmbǝlma nyi kumo apǝ mǝthlǝu, kǝra nju ngga ǝnga Yahuda Isikarayoti maˈyi a ndǝgya pubu dǝdǝgalˈyar, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>ji nda yiwa nda, “Yiɗawu nga hyu kina ɗa ma yi sǝn lǝr hyi nya?” Kǝ ndǝ jigabiya gǝnna sulayi makǝrkumunyi <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Mbari ar pǝci kau, ngǝ Yahuda wu gal lagu kǝra ja sǝn lǝri Yesu ari.<verse eid="MAT 26:16"/></para>
  <para style="s1">Yesu Sǝm Lardur Vǝlna <optbreak/> Ənga Zǝmbǝlma Nyiˈyar</para>
  <para style="r">(<ref loc="MRK 14:12-21">Markusu 14:12-21</ref>; <ref loc="LUK 22:7-13">Luka 22:7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yahwana 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Ar pǝci nǝ tanggǝrma nǝ lardur nǝ macikǝl gǝra thlǝlamǝ, kǝ zǝmbǝlma nyiˈyar shili ndǝ sa yiwa nyi, “Əmani nga gu yiwu ˈya pabǝri ngǝ vir sǝm lardur nǝ vǝlna ka?”<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>Kǝ ji shaɗǝwa, ji na, “Maˈya mau a vu huɗa mǝlmau, hyu vuwa thlǝwa vanyi ndǝ a vuna, ba hya nar nyi, ‘Malǝmǝ ngǝ na, abǝr, pǝci nyi a ɗar lǝhǝu. Ju sa sǝm lardur nǝ vǝlna ǝkkǝˈyi zǝmbǝlma nyiˈyar wu ki ngau.’ ” <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>Kǝ zǝmbǝlma nyiˈyar mǝliya ǝnggǝra ji nar nda ta, ba ndǝ pabǝri vir sǝm lardur nǝ vǝlna nyi.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Ənggǝra wagǝ ɗa, Yesu nggya aga ja sǝm sǝr sǝm ǝkkǝˈyi zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝu. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Ma tsu nda vǝr sǝm sǝr sǝm, kǝ Yesu na anǝ nda, “Jiri nga yu na anǝ hyi, pathlǝu wu pama hyu nda thlǝna hiya yau.”<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Kǝ ɗǝfuwa nda ndzǝ gagaɗau, kalar ndu dzǝgwa na anǝ nyi wu pama nda, “Ənga jiri, nayi ngǝ ya, Thlagǝu?”<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Kǝ Yesu shaɗǝwa, “Ndǝ ka a vǝr fǝ tsi wu cala ǝnga yi kau, ngu nda thlǝna hiya yau. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Zǝr Ndau, wu tǝ ǝnggǝra nji tsǝfǝri ar kǝra ja, ama sǝr tǝhuɗǝ anǝ ndǝra wu nda thlǝna hiya Zǝr Ndau. Wu ndiya anǝ ndǝ kau, kuji nji gǝra ya nyi.”<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Kǝ Yahuda ndǝra wu nda thlǝna hiya ja na, “Malǝmǝ, ǝnga jiri nayi ngǝ ya?”</para>
  <para style="p" vid="MAT 26:25">Yesu shaɗǝwa, ji na, “Angǝ, nagǝ ǝnga kǝrngǝ ma, a nabiyar gau.”<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Tsu nda vǝr sǝm sǝr sǝm, kǝ Yesu hǝri macikǝl, kǝ ji lǝr usaku anǝ Hyal, ba ji ɓǝɓǝlǝwa, kǝ ji nǝ nyi anǝ zǝmbǝlma nyiˈyar, ju na, “Dlǝwura mau hya sǝm, naja kǝ kumǝr dza yi ngau.”<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Kǝ ji hǝri kyakiwa nǝ ˈyimir wur inabi, kǝ ji lǝr usaku anǝ Hyal, kǝ ji nǝr nda, ju na, “Patǝkura hyi, hya sa. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Najakǝ mashi ɗa ngau nǝ nyabiya alkawal mafǝliyangǝ, kǝra nju nda pǝna aga tǝfǝbiya bikǝ nǝ nji patǝu. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Yu nar hyi, tsu yu ɓǝra sa ˈyimir yayar wur inabi mai, kǝl pǝci kǝra yu nda sa mafǝliyangǝ ǝnga hyi wu tǝlkur nǝ Dǝɗa.”<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Ayukuɗa ndǝ kuɗǝna thlǝ na, kǝ ndǝ maˈyi a dar Mǝ nǝ wur Zaitunu.<verse eid="MAT 26:30"/></para>
  <para style="s1">Yesu Nana Ənggǝra Biturusu <optbreak/> Wu Nda Kǝpalna Sǝni Nyi</para>
  <para style="r">(<ref loc="MRK 14:27-31">Markusu 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yahwana 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Kǝ Yesu na anǝ nda, “Vuˈyi ǝshina kau, patǝ hyi, hyu nda tǝtǝlnakǝr arya sǝra wu nda ɗa ǝnga yau. Ara tsǝtsǝfǝ nga nyi wu lǝkakaɗǝ nǝ Hyal, abǝr,</para>
  <para style="q1" vid="MAT 26:31">“ ‘Yi wu nda tsar</para>
  <para style="q2" vid="MAT 26:31">kǝra ndǝr ɓǝla,</para>
  <para style="q1" vid="MAT 26:31">ba ɓǝla nǝ tǝmahǝu</para>
  <para style="q2" vid="MAT 26:31">a tǝtǝlnakǝr.’<verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>Ama ayukuɗa yi hyaˈari sara vir tau, yu tǝrabiya wu mwar hyi a vu Galili.”<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Əngwar Biturusu anǝ nyi, “Alaga nji patǝ hwinakǝr ndǝ piyari ngau, nayi wu, piyari ngǝ nǝ ɗa mai.”<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Yu nar ngǝ jirkura nyi Biturusu, ǝshina vuˈyi kau, kadivira vǝgǝmǝ wu nda wau, gu kǝpalna sǝn ɗa ar kǝr ar kǝr makǝru.”<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Kǝ Biturusu ɓǝra na, “Alaga nji tsǝya ɗa daɓǝ ǝnga gau, nayi wu kǝpal sǝni ngǝ mai.” Kǝ patǝkura alenyi zǝmbǝlma nyiˈyar nana abangǝ tsu.<verse eid="MAT 26:35"/></para>
  <para style="s1">Yesu Kǝdi Hyal Wu Gyatsimani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Markusu 14:32-42</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Kǝ Yesu ǝkkǝˈyi zǝmbǝlma nyiˈyar maˈyi a ndar vanyi vi kǝra nju ngga ǝnga Gyatsimani, kǝ ji nda na anǝ nda, “Nggya mǝ nǝr hyi ǝnggau, yu maˈyi a ndu mwa ya nda kǝdi Hyal.” <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Kǝ ji hǝri Biturusu ǝnga wazha Zabadi mǝthlǝ ǝnga ja, nanda ngǝ Yakubu ǝnga Yahwana, naja ǝnga huɗǝ kiyakiyar gagaɗau ǝnga ɓwaɓwatǝ ara sǝra ja a gwa. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Kǝ ji na anǝ nda, “Huɗǝ ndzǝndzǝ kǝra ya gwa a sǝn tsǝya ɗa. Nahyi hya nggya liliˈu hya ɓǝla ǝnga yau.”<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Ji ɓar dzǝ kushu, ba ji dla lagu bama a gyiwu ˈyi, ja vǝr ndǝr ǝnga Hyal, ju na, “Tada, ma ja abǝr yiwu ca ngǝ uya, bǝgǝ ga hǝna najaka ɓwaɓwatǝ ar kǝra yau. Alaga abangau, aˈyi sǝra yu yiwu mai, ama sǝra gu yiwu.”<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Ba ji sha shili ara zǝmbǝlma nyiˈyar, ba ji sa thlǝwa nda wu ghanyi. “Mi nga ma? Aˈyi hyu sǝn nggya nǝ ɓǝla ǝnga yi alaga nǝ saka pathlǝ wa?” Ji yiwa Biturusu. <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>“Hya nggya ǝnga ɓǝla ǝnga hya kǝdi Hyal ara hya sara tǝɗau a gu dzau. Mambǝl wu yiwu nǝ nyi, ama kumǝr dzǝ a tǝwari.”<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Kǝ ji ɓǝra maˈyi nǝ mǝthlǝkura nyi, ji nda ndǝr ǝnga Hyal, ji na, “Tada, Ma aˈyi ɗa tsaˈa aga ɓwaɓwatǝ ka hǝna kǝr mai, ama kǝl yi tǝwari, taˈyi sǝra gu yiwu patǝ ja ɗarkǝr.”<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Ənggǝra ji sha shili, kǝ ji ɓǝra thlǝwa nda wu ghanyi, ara ghanyi tǝdǝɓǝu ar liya nda. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Kǝ ji piyari nda, ba ji maˈyi sǝ nyi nǝ makǝrkura nyi, kǝ ji nda ndǝr ǝnga Hyal, ji ɓǝra nana sǝˈyar ta.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>Ji ɓǝra sha shili ǝgya zǝmbǝlma nyiˈyar, ba ji thlǝwa nda wu ghanyi, kǝ ji na anǝ nda, “Tsu hyu ghanyi ya, hyu ɓǝlsar ya? Tsaˈa abangǝ ja! Pǝci a ɗari nju nǝ nyi Zǝr Ndau a gwu tsa njir bikau. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Hyaˈara mau, mǝna maˈyi! Kǝja ndǝr thlǝ hiya yi ta a shiliri!”<verse eid="MAT 26:46"/></para>
  <para style="s1">Nji Mbar Yesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Markusu 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yahwana 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Tsu Yesu a vǝr ndǝr, kǝja Yahuda, pathlǝu wu pama zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝu, shili ǝnga nji gangǝu ǝnga katsakǝr ba zǝwa wu tsa nda. Njira pubu dǝdǝgalˈyar ǝnga njira nggurum nǝ mǝlmǝ sǝwa. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Ndǝr thlǝ hiya ja kau, a dǝgar ndar ja mǝtsamǝ, “Ma ndǝra yi bǝrpiya nyi, naja ngau, mbari nya mau.” <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Ənggǝra ji dla, ba ji maˈyi tǝwar a ndǝra Yesu, kǝ Yahuda usar nyi, ji na, “Usi Malǝmǝ,” kǝ ji bǝrpiya nyi.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Əngwar Yesu anǝ nyi, “Bazhi ɗa, mǝliya sǝra hǝ nga shili.”</para>
  <para style="p" vid="MAT 26:50">Kǝ nja nyi shili ndǝ sa mbari Yesu, kǝ ndǝ sǝɓiya nyi ɓaɓalu. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Ənggǝra ndǝ lari abangau, kǝ pathlǝ wu pama njir ɓǝ Yesu tǝsǝbiya katsakǝr nyi, ba ji thlana himiya mafa pubu kǝra ndiya ǝnga dǝgal ǝni.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>Əngwar Yesu anǝ nyi, “Shabiya katsakǝr ngau a vu ki nyi, arya kalar ndǝra tsǝbiya katsakǝr, katsakǝr ngu nda tsa nyi. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Hyu nggani abǝr aˈyi yu sǝn ngga Dǝɗa, ba ja sǝwa ɗa alaga bwata waladiˈyar kumo apǝ mǝthlǝ wa? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Ama lagu mani ngǝ sǝra tsǝtsǝfau wu lǝkakaɗǝ nǝ Hyal wu nyabiya dza, abǝr aˈyi ji ɗa lagu kǝ maya?”<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Ar pǝci ta, Yesu na anǝ dlamir nji, “Nayi ngǝ ndǝr tǝɗǝmwa anǝ njir gwaɗǝvi ya, ǝnga hyi sǝbiya katsakǝr ǝnga zǝwa aga hya sa mba ɗa ya? Parangǝu ya vǝr nggya ǝkkǝˈyi hyi wu ki Hyal ya vǝr highiɓau, ama nahyi sayi mbar ɗa mai. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Sǝˈyar kǝ ɗa patǝ aga sǝra nabiˈyar tsǝfǝri a nyabiya dzau.” Kǝ patǝ zǝmbǝlma nyiˈyar tǝtǝlna dzau ba ndǝ piyari nyi wu tsa nda.<verse eid="MAT 26:56"/></para>
  <para style="s1">Yesu Wu Mwar Pathla <optbreak/> Nǝ Njir Yahudiya</para>
  <para style="r">(<ref loc="MRK 14:53-65">Markusu 14:53-65</ref>; <ref loc="LUK 22:54-55">Luka 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yahwana 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Njira mbari Yesu hǝri nyi a ndǝra Kayafasu dǝgala Pubu, vira malǝmǝ dlaɗǝˈyar ǝnga njira nggurǝm kaɓǝ ari. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Kǝ Biturusu nu nyi wu ndǝl wu ndǝl tsatsalǝu, tsaˈa vwar huɗa ki dǝgala Pubu. Ji vuwa nggya ǝkkǝˈyi njir sǝkǝ ki aga ja lari ǝnggǝra nju ɗa ǝnga ja.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Pubu dǝdǝgalˈyar ǝnga patǝr njir zǝwa a vǝr gal lagu kǝra nda sǝn vazǝya Yesu aga nda tsǝya nyi. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Ama sǝ aˈyi ndǝ uya mai, alaga kǝ nji gangǝu shili ndu thla sakida nǝ fati ar kǝra Yesu.</para>
  <para style="p" vid="MAT 26:60">Ayukuɗa nyi patǝu, kǝ alenyi nji mǝthlǝ biyar babal, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>ndǝ na, “Sal kǝ na, abǝr, ‘Yu sǝn dlana ki Hyal kau, ba ya ɓǝra hǝriya nyi wu pida makǝru.’ ”<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Pubu kǝra ndiya ǝnga dǝgal hyaˈari aˈyi taˈyau, ji na anǝ Yesu, “Mi ngǝ sǝ kǝ nja vǝr na a miya ndǝla gǝ ka? Sǝ aˈyi gu na a gǝri wa?”<verse eid="MAT 26:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63"/>Ama kǝ Yesu nggya sǝ nyi ɗiyu.</para>
  <para style="p" vid="MAT 26:63">Kǝ pubu kǝra ndiya ǝnga dǝgal na anǝ nyi, “Yi wu daɓǝr ngǝ ǝnga thlǝmǝr Hyal kǝra a dǝmǝlmau, nar ˈya ma nagǝ ngǝ Kǝrsiti, Zǝr Hyal.”<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>Yesu shaɗǝwa, “Angǝ, abangǝ nga nyi ǝnggǝr kǝra gǝ na kau. Ama taˈyi ya nar hyi patǝ hyi, mbar kabangǝkau, hyu sa lari Zǝr Ndau a vǝr nggya ar tsi mazǝma ndǝ dǝgal dǝnama, a vǝr shida wu dlama sara dǝmǝlmau.”<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Kǝ pubu kǝra ndiya ǝnga dǝgal tana lǝgutǝ kǝrnyi ǝnga huɗǝ ndzǝndzau, ju na, “A nanar ja ndǝr nǝ deɓa Hyal! Sakida mi mǝnu ɓǝra gala? Kǝja hya nggari ndǝr diɗa vi nyi ǝnga kǝrhyi. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Mi nga hyu nggana?”</para>
  <para style="p" vid="MAT 26:66">“A ɗar tsaˈa nja tsǝya nyi,” ndǝ shaɗǝwa.<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Kǝ ndǝ tǝfuwa nyi tuli a vu bama ja, ǝnga alenyi nji tsu dǝdǝguwa nyi tsi. Alenyi nji nǝ nyi tsi balma <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>ndu dzǝgwa na, “Ma nagǝ ngǝ nabi, nana ˈya, Kǝrsiti, tara wa ngǝ dǝgǝr ngǝ ka?”<verse eid="MAT 26:68"/></para>
  <para style="s1">Biturusu Kǝpalna Sǝni Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Markusu 14:66-72</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref>; <ref loc="JHN 18:15">Yahwana 18:15</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Ar pǝci kǝra Biturusu a vǝr nggya a biyar huɗǝ ki, kǝ kwar ki kǝ shili ǝgya ja, ji sa na anǝ nyi, “Nagǝ ma, nahyi ngǝ shili ǝkkǝˈyi Yesu ndǝr Galili.”<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Ji kǝpalna nyi wu mwar nda patǝu, ji na, “Nayi wu sǝni sǝra gu na kǝ mai.”<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Ta ji maˈyi a biya miya kiya nyi, ba ji biya ɓǝ ǝnga vanyi kwar ki, kǝ kwa kǝ lar nyi, kǝ ji na anǝ njira tataˈyi a ndǝna, “Ndǝ kǝ ma, nanda ngǝ ǝkkǝˈyi Yesu ndǝr Nazǝratu.”<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Ji ɓǝra kǝpalna nyi daɓǝ ǝnga sǝm fǝla, “Yi wu sǝn ndǝ kǝ mai!”<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Ɓǝliya sar kushu, njira tataˈyi a ndǝna ndǝ maˈyi a ndǝgya Biturusu, ndǝ nda nar nyi, “Ənga jiri, pathlǝ gu pama nda, arya kiyara gau a nanar ndǝla gau.”<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Kǝ ji mbari shiˈwa kǝrnyi, ǝnga ji ɓǝra sǝm fǝla anǝ nda, abǝr, “Yi wu sǝn ndǝ kǝ mai!”</para>
  <para style="p" vid="MAT 26:74">Ənggǝrna kǝ vǝgǝmǝ wau. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>Ənggau kǝ Biturusu ɗǝngari ndǝr kǝra Yesu nar nyi, abǝr, “Divira vǝgǝmǝ a wau, gu kǝpalna sǝn ɗa ar kǝr ar kǝr makǝru.” Kǝ ji hwi a biya, ji biya tiwi ǝnga sǝlǝm gagaɗau.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">Yesu Wu Mwar Gwamna Bilatusu</para>
  <para style="r">(<ref loc="MRK 15:1">Markusu 15:1</ref>; <ref loc="LUK 23:1-2">Luka 23:1-2</ref>; <ref loc="JHN 18:28-32">Yahwana 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Əmudlǝ kaɗǝu, kǝ pubu dǝdǝgalˈyar ǝnga njira nggurǝm mǝlmǝ patǝ mbiya miya tsu aga nda tsǝya Yesu. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Ndǝ dzǝɓiya nyi, ba ndǝ maˈyi ǝnga ja, ndǝ nda lǝr nyi a ndu tsa gwamna Bilatusu.<verse eid="MAT 27:2"/></para>
  <para style="s1">Yahuda Tsǝya Kǝrnyi</para>
  <para style="r">(<ref loc="ACT 1:18-19">Thlǝr Camaˈyar 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Ta Yahuda, ndǝra thlǝna hiya Yesu, lari abǝr a thlana nyir nji numa nǝ tǝ anǝ Yesu, ba ji tiwi ǝnga kǝrnyi, ba ji shabiya nda gǝnnar nda, a nda nǝ pubu dǝdǝgalˈyar ǝnga njira nggurǝm. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>Ji na, “A mǝliyar yi bikau, arya yi thlǝna hiya ndǝra gǝra ndzana sau.”</para>
  <para style="p" vid="MAT 27:4">Ndǝ shaɗǝwa nyi, “Mi dzawur ˈya ǝnga ka? A nǝngǝ ngǝ dzaˈwu.”<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Kǝ Yahuda vakǝ nggǝr nda gǝnna nyi a gwu huɗa Ki Hyal, kǝ ji maˈyi, ji nda hakǝya kǝrnyi.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Pubu dǝdǝgalˈyar ɗǝmǝri gǝnna nyi, ndǝ na, “Aˈyi ɗa tsaˈa nja ɓǝra shabiya gǝnna kǝ a gu mbǝl mai, arya gǝnna mashi ngau.” <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Kǝ ndǝ mbiya miya aga nda ɗǝlbiya babal, ar vira nju ngga ǝnga Babal nǝ ndǝr Hǝr Tǝm. Aga ja ɗa hulili anǝ nji shishili. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Ca ngǝ sǝra ɗa nju ngga vi kǝ ǝnga ˈYiˈyi Mashi baˈanǝ ǝshina. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Lagu kǝ ngǝ sǝra Nabi Irimiya nana nyabiya dzau, “Kǝ ndǝ faˈari kwaɓa thladla makǝrkumunyi, gǝnna kǝra njir Izirayila thlana. <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>Kǝ ndǝ ɗǝlbiya babal nǝ ndǝr hǝr tǝm ǝni, ǝnggǝra Thlagǝ nar ɗa.”<verse eid="MAT 27:10"/></para>
  <para style="s1">Nji Hǝr Yesu A Dumwar Bilatusu</para>
  <para style="r">(<ref loc="MRK 15:3-5">Markusu 15:3-5</ref>; <ref loc="LUK 23:3-5">Luka 23:3-5</ref>; <ref loc="JHN 18:33-38">Yahwana 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Kǝja Yesu taˈyi wu mwar gwamna, kǝ gwamna yiwa nyi, “Nagǝ ngǝ tǝl njir Yahudiya ya?”</para>
  <para style="p" vid="MAT 27:11">Kǝ Yesu shaɗǝwa nyi, “Nagǝ ngǝ na abangau.”<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Ar pǝci kǝra pubu dǝdǝgalˈyar ǝnga njira nggurǝm a vǝr nana ndǝr ar kǝra ja, naji shaɗǝwa anǝ nda mai. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Kǝ Bilatusu yiwa nyi, “Aˈyi gu nggari sakida kǝra nda vǝr na a miya ndǝla gǝ kǝ wa?” <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Ama kǝ Yesu bǝgǝ sǝ nyi ɗiyu, sǝ aˈyi ji na alaga kushu ar kǝra sǝ kǝ mai, ba sǝ kǝ nǝ nyi ɗǝnga anǝ gwamna.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Ar pǝcir mini nǝ lardur nǝ vǝlna, gwamna a tsǝliyari parangǝu, ju sǝya ndǝr fursǝna pathlǝu anǝ dlamir nji, ndǝra ndu yiwu. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Ar pǝci ta vanyi ndǝr fursǝna aˈyi kǝra nju sǝni nyi patǝ nju ngga nyi ǝnga Barabasu. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Ta dlami kaɓau, kǝ Bilatusu yiwa nda, “Wa nga hyu yiwu ya sǝya hya? Barabasu ǝndǝga Yesu kǝra nju ngga ǝnga Kǝrsiti ya?” <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Arya ju sǝni abǝr arya shishikura nda nga ndǝ mbari Yesu ndǝ lǝr nyi anǝ nyi.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Ma tsu Bilatusu a vǝr nggya ar tsǝkafǝ nyi, kǝ mala nyi sǝwa nyi cama, “Hǝbiya tsa gau wu ndǝr ndǝ gǝra ǝnga vazǝ kau, arya yi lar ɓwaɓwatǝ pamǝpamǝ arya ja ǝshina wu shuni.”<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Ama kǝ pubu dǝdǝgalˈyar ǝnga njira nggurǝm tsǝtsǝkuri dlamir nji aga nda na nja sǝya nda Barabasu, ba nja tsǝya Yesu. <verse eid="MAT 27:20"/><verse number="21" style="v" sid="MAT 27:21"/>Gwamna ɓǝra yiwa nda, “Wa nga hyu yiwu ya sǝya hyu pama nji mǝthlǝ ka?”</para>
  <para style="p" vid="MAT 27:21">Əngwar nda, “Barabasu!”<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>Kǝ Bilatusu ɓǝra yiwa nda, “Mi nga ya dzǝgwa mǝl ǝnga Yesu kǝra nju ngga ǝnga Kǝrsiti ka?”</para>
  <para style="p" vid="MAT 27:22">Əngwar nda, “Dlakǝya nyi nji!”<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>Kǝ Bilatusu na anǝ nda, “Arya mi ya? Mi ngǝ bikǝ nya?”</para>
  <para style="p" vid="MAT 27:23">Kǝ ndǝ ɓǝra hyaˈana ɗahǝ tsu, ndǝ na, “Dlakǝya nya mau.” <verse eid="MAT 27:23"/><verse number="24" style="v" sid="MAT 27:24"/>Ta Bilatusu lari abǝr sǝ aˈyi ju sǝn kari mai, kǝl cakǝ ngǝ gwaɗǝ vi wu cakau, kǝ ji gǝr ˈyimi, ji cina tsa ja ǝni wu mwar nji, ji na, “Kǝja tsa yau, kǝja tsa yau, bikǝ ɗa aˈyi wu mashi ndǝ kǝ mai, bikǝr hyi ngau!”<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Kǝ patǝkura nda shaɗǝwa, ndǝ na, “Taˈyi mashi nyi a nggya ar kǝra ˈya ǝnga wazhar ˈya patǝu.”<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Kǝ ji sǝya nda Barabasu. Ayukuɗa ji sǝwa, nji nǝ nyi wuɗa anǝ Yesu, kǝ ji nǝ nda nyi aga nda dlakǝya nyi.<verse eid="MAT 27:26"/></para>
  <para style="s1">Sojaˈyar Ndǝr Nǝ Diɗa Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Markusu 15:16-20</ref>; <ref loc="JHN 19:2-3">Yahwana 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Sara ǝnggau, kǝ sojaˈyar nǝ gwamna hǝr Yesu a vwar vira soja nggunggurǝmˈyar a nggya ari, ba ndǝ kaɓiya bwata sojaˈyar patǝ ndǝ zǝwar nyi. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Ndǝ zǝɗǝna nyi turusu ba ndǝ dzǝgwa hari nyi kar dǝzǝu culi nǝ tǝlkur. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Kǝ ndǝ tsagu nyi dara shikǝɗi nǝ tǝlkur, kǝ ndǝ hǝwa nyi a du kǝra ja. Ndǝ fuwa zǝwa tǝlkur wu tsa ja, ba ndǝ dzǝgwa ɓǝliya undi nǝ diɗa nyi, ndu na, “Alvari tǝl, tǝl nǝ njir Yahudiya!” <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Ndǝ tǝfǝnggǝr nyi tuli, ba ndǝ dlǝwuri zǝwa nǝ tǝlkur ta, ndǝ dzǝgwa pǝpǝthlǝwa nyi zǝwa nyi wu kǝra ja. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Ayukuɗa ndǝ kuɗǝna diɗa nyi abangau, kǝ ndǝ zǝɗǝna lǝgutǝ tǝlkur ta, ndǝ ɓǝra har nyi nǝ nyi. Ndǝ dzǝgwa maˈyi ǝnga ja a biya aga nda biya dlakǝya nyi.<verse eid="MAT 27:31"/></para>
  <para style="s1">Nji Dlakǝya Yesu</para>
  <para style="r">(<ref loc="MRK 15:21-32">Markusu 15:21-32</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>; <ref loc="JHN 19:17-27">Yahwana 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Ənggǝra nda vǝr biya, ba ndǝ thlǝwa vanyi ndǝr Sayirini kǝra nju ngga ǝnga Simanu, kǝ ndǝ ciwa nyi aga ja hǝ wu dladlakǝ nǝ Yesu. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>Kǝ ndǝ shili ar vanyi vi kǝra nju ngga ǝnga Gwalgwathla, ca ngǝ vir papangǝkǝr. <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>A ndǝna kǝ ndǝ nǝ nyi ˈyimir wur inabi kǝra nji gwaɗǝbiya ǝnga maɗǝwatǝu aga ja sa, ama ta ji ɗahari, kǝ ji piyari sa. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Ta ndǝ dlakǝya nyi, ba ndǝ dzǝgwa tǝtǝkǝwa kar ha nyi lagur tǝɗǝ shiˈwu. <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>Ayukuɗa kau, ba ndǝ nggya nggashiu ndu ɓǝla nyi a ndǝna. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Adabanga kǝra ja ndǝ tsǝfǝya sǝra wu cabiya sǝra ji ndzana: <char style="sc">NDƏ KƏ NGƏ YESU, TƏLƏR NJIR YAHUDIYA</char>. <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Nji dlakǝya nyi ǝnga njir ɗa lagu mǝthlǝu, pathlǝu ar tsi mazǝma ja ǝnga pathlǝu tsu ar matsala ja. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Njira a vǝr tǝrabiya ndu ndǝr nǝ diɗa nyi, ndu kǝnggǝɗǝ kǝra nda ndu nggushi, ǝnga <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>ndu na, “Nagǝ ndǝra na gu sǝn dlana ki Hyal, ba ga ɓǝra hǝriya wu pǝci makǝru, ga mbǝɗana kǝrngau! Ga shida sara dar wu kau, ma nagǝ Zǝr Hyal ngau!”<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Abangǝ tsu ngǝ pubu dǝdǝgalˈyar ǝnga malǝmǝ dlaɗǝˈyar ǝnga njira nggurǝm wu ndǝr nǝ diɗa nyi. <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>Əngwar nda, “Ji mbǝɗana nji, ama naji wu sǝn mbǝɗana kǝrnyi mai! Naja ngǝ Tǝl nǝ njir Izirayila! Bǝgǝ ja gya sara dar wu kǝ aga mǝna lari, ba mǝna hǝnggǝri ǝnga ja. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Ji hǝnggǝri ǝnga Hyal, bǝgǝ Hyala nyi a kǝtiya nyi kabangǝkau, ma Hyala nyi wu yiwu, arya ju na, ‘Nayi Zǝr Hyal ngau.’ ” <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Tangǝ ǝnggǝr ta, njir ɗa lagu kǝra nji dlakǝya ǝnga ja ta nyabiya nyi ǝnga nggǝl.<verse eid="MAT 27:44"/></para>
  <para style="s1">Tǝr Yesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Markusu 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yahwana 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Mbari ar pǝci taˈyikǝr baˈanǝ saka makǝr nǝ wagǝ ngǝ kuthlǝu shida haɗiya ˈyiˈya nyi patǝu. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>A ndu wagǝu ǝnggǝr saka makǝru, Yesu hyaˈana ɗahǝu ǝnga dǝnama, ji na, “ˈYiloyi, ˈYiloyi, lama sabakǝtani?” Kǝra cabiya, “Hyal ɗa, Hyal ɗa, mi ngǝ ɗa gǝ shabiya ɗa ya?”<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Ta njira tataˈyi a ndǝna nggari abangau, kǝ ndǝ na, “Ja vǝr ngga Iliya.”<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Ənggǝrna pathlǝu wu pama nda hwi ka nda hǝri sasaˈwa. Ji ciwa a gu ˈyimir wur inabi kǝra mwamwalu, ji ciri a dar zǝwa ba ji nǝ nyi aga ja sa. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Alenyi nji wu pama nda wu na, “Piyari nya mau, bǝgǝ mǝna lari tara Iliya wu sa mbǝɗana nyi.”<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Kǝ Yesu ɓǝra hyaˈana ɗahǝ ǝnga dǝnama, kǝ piya ja biya.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>Ar pǝci kǝ ngǝ kadǝmbul nǝ huɗa ki Hyal tǝwa dzǝ bwata mǝthlǝu, mbari a du kǝr ba a gyiwu ndǝla nyi. Kǝ ˈyiˈyi kǝnggǝɗǝr dzǝ ba mǝ ndǝliya dzau. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Huˈyar papahǝnakǝr, kǝ nji cicau kǝra tau, hyaˈari ǝnga pi. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>Ayukuɗa Yesu hyaˈari sara vir tau, kǝ ndǝ maˈyi a vu huɗa mǝlmǝ cicau, ba ndǝ vuwa canǝ nyi kǝr anǝ nji pamǝpamǝ gangǝu.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>Ənggǝra soja kǝra ndiya ǝnga dǝgal ǝnga alenyi njir ɓǝla hu Yesu lari ǝnggǝra ˈyiˈyi kǝnggǝɗǝr dzǝ ǝnga patǝkura sǝra ɗarkǝr, ba hivǝr mbari nda gagaɗau, ndu na ǝnga ɗahǝu, “Pakatǝu, ndǝ kau, Zǝr Hyal ngau!”<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Mathlǝkǝˈyi gangǝu sara wu Galili nu Yesu, ndu mǝl thlǝr anǝ nyi. Ndǝ taˈyi tsalǝu ndu tsamǝ sǝra wu ɗa. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Wu pama nda Maryamu Magǝdaliya aˈyi ǝnga Maryamu mǝya Yakubu ǝnga Yusufu ba mǝya wazha Zabadi.<verse eid="MAT 27:56"/></para>
  <para style="s1">Ənggǝra Nji Haɗǝ Yesu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Markusu 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yahwana 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Ma lǝhǝ waga ɗa, kǝja vanyi ndǝr gǝnna a shiliri, thlǝmǝ nyi Yusufu ndǝr Arimatiya, ndǝra naja ǝnga kǝrnyi ma ndǝr nu Yesu ngau. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Ji maˈyi a ndǝra Bilatusu aga ja nda yiwari dza Yesu aga ja nda haɗǝna. Kǝ Bilatusu sǝwa aga nja nǝ nyi nyi. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Kǝ Yusufu hǝri dza Yesu, ba ji pǝɗǝwa wu sǝr haɗǝ ndǝ cici camǝu. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Kǝ ji nda fuwa nyi wu hu nyi kǝra mafǝliyangǝ kǝra ji gǝmbiya wu mau. Kǝ ji uya madiya tsǝka ba ji haɗiya miya huwa nyi ǝni ba ji maˈyi sǝ nyi. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Kǝ Maryamu Magǝdaliya ǝnga vanyi Maryamu ta nggya bama ǝnga bama ǝnga huwa nyi.<verse eid="MAT 27:61"/></para>
  <para style="s1">Njir Ɓǝla Huwa Nyi</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Əzǝgǝkura nyi, pida pathlǝu ayukuɗa Pǝcir Pabǝ Dzau, kǝ pubu dǝdǝgalˈyar ǝnga njir Farisi maˈyi a ndǝra Bilatusu. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>Ndǝ na, “Malǝmǝ, ˈyu ɗǝngari sǝra ndǝr ngguta vi kǝ sara a vǝr na tsu ja ǝnga pi, abǝr, ‘Ayukuɗa pida makǝr, yu ɓǝra hyaˈari ǝnga pi.’ <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Agabangau, ga sǝwa njir ɓǝla hu aga nda ɓǝla hu kǝ mǝnahǝu, kǝl ayukuɗa pida makǝru. Ma aˈyi abangǝ mai, zǝmbǝlma nyiˈyar wu sǝn sa hǝlǝr dza ja ǝvuˈyi ba nda dzǝgwa nar nyi anǝ nji abǝr a hyaˈari ja sara vir tau. Najaka ngguta vi wu nda ndiya nǝ tanggǝrma ǝnga didiɗi.”<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>Əngwar Bilatusu anǝ nda, “Suwa mǝ njir ɓǝla, aga nda nda ɓǝlar miya huwa nyi mǝnahǝu ǝnggǝr kǝra hyu sǝn mbari.” <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Kǝ ndǝ maˈyi ndǝ nda ɓǝlari huwa nyi mǝnahǝu, ndǝ fǝri mǝtsamǝ nǝ tǝlkur ar tsǝka nyi ǝnga tsu ndǝ fiya sojaˈyar aga ɓǝla viya nyi.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Hyaˈarir Yesu Sara Vir Tau</para>
  <para style="r">(<ref loc="MRK 16:1-8">Markusu 16:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yahwana 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Ayukuɗa Pǝcir Ɓǝlsar nǝ (njir Yahudiya) tǝrabiya, ǝmudlǝ kaɗǝu pǝci nǝ tanggǝrma nǝ sugu, kǝ Maryamu Magǝdaliya nanda ǝnga vanyi Maryamu maˈyi a nda tsamǝ huwa nyi.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Sǝni aˈyi mai kǝ mǝlmǝ kǝnggǝɗau, ara vanyi waladi nǝ Thlagǝ shida sara dǝmǝlmau, ji sa maˈyi a dar huwa nyi, ji nda jahǝna tsǝka kǝra nji haɗiya miya huwa nyi ǝni, ba ji nggya ari. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Dza ja wu mbǝl wilwilu ǝnga lǝgutǝ ha nyi pǝrtǝ pwahǝu ǝnggǝr ǝpur paˈwa. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Ənggǝra njir ɓǝla huwa nyi lari nyi, ba hivǝr mbari nda gagaɗau, ǝnga dza nda wu tsǝdzau, kǝra mǝliya ndǝ ɗa ǝnggǝr nji tǝtau.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Ama kǝ waladiya nyi na anǝ mathlǝkǝˈya nyi, “Hya sara hivǝr mai, arya yu sǝni abǝr Yesu nga hya vǝr gal, ndǝra nji dlakǝya ta. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Aˈyi ja ǝnggǝ mai, a hyaˈari ja ǝnggǝr kǝra ji saya nana. Anda mau hya sa lari vira nji saya pina nyi ari ta. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Maˈya mau ǝnga kusa aga hya nda nar nyi anǝ zǝmbǝlma nyiˈyar, ‘A hyaˈari ja sara vir tau, ju maˈyi wu mwar hyi a vu Galili. A vuna hyu vuwa lari nyi.’ Sǝra yi shili aga ya sa nar hyi ngau.”<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Kǝ mathlǝkǝˈya nyi hyaˈari ǝnga kusa, nyinyau ǝnga hivǝr ba huɗǝ pǝrtǝ gagaɗau, ndǝ hwi a ndǝra zǝmbǝlma nyiˈyar aga nda nda nar nda sǝra ɗarkǝr. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Kukuthlǝ kǝ Yesu thlǝwa nda, ba ji nar nda, “Usa mau.” Ndǝ shili ǝgya ja, ndǝ mbari hiya ja ba ndǝ gǝnggǝr nyi sǝli. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>Kǝ Yesu nar nda, “Hya sara hivǝr mai, maˈya mau hya vuwa nar nyi anǝ zamǝɗaˈyar nda maˈyi a vu Galili, a vuna nga ndu vuwa lar ɗa.”<verse eid="MAT 28:10"/></para>
  <para style="s1">Shaɗǝwa Nǝ Njir Ɓǝla Hu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Ma tsu mathlǝkǝˈyi ta ar lagu, kǝ alenyi njir ɓǝla hu maˈyi a ndu huɗa mǝlmǝ ndǝ nda nar nyi anǝ pubu dǝdǝgalˈyar sǝra ɗarkǝr patǝu. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Ənggǝra pubu dǝdǝgalˈyar ɓǝ ǝkkǝˈyi njira nggurǝm ba ndǝ nggya ndǝ mbiya sǝra ndu mǝl, ba ndǝ nǝ nyi madiya gǝnna anǝ njir ɓǝla huwa nyi, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>ndu na anǝ nda, “Hya nar nyi anǝ nji, abǝr, ‘Zǝmbǝlma nyiˈyar ngǝ shili ǝvuˈyi ba ndǝ sa hǝlǝr dza ja ma tsu ˈya wu ghanyi.’ <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Ma ndǝr kǝ gwu himiya gwamna, ˈyu nar nyi ndǝr kǝra wu pina huɗa ja, ba ˈya hǝbiya hyi wu ɓwaɓwatǝu.” <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Kǝ sojaˈyar ta dlǝwuri gǝnna nyi, ba ndǝ mǝliya ǝnggǝra nji dǝgar nda. Kǝ najaka ndǝr tǝtǝlna dzǝ wu pama njir Yahudiya patǝ baˈanǝ ǝshina.<verse eid="MAT 28:15"/></para>
  <para style="s1">Madiya Thlǝr Kǝra Yesu Piyari Nyi<optbreak/> Anǝ Zǝmbǝlma Nyiˈyar</para>
  <para style="r">(<ref loc="MRK 16:14-18">Markusu 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="JHN 20:19-23">Yahwana 20:19-23</ref>; <ref loc="ACT 1:6-8">Thlǝr Camaˈyar 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Zǝmbǝlma nyiˈyar kumo a sǝr tangǝ maˈyi a dar mǝ nǝ Galili vira Yesu nar nda, aga nda maˈyi a dari. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Ta ndǝ lari nyi, kǝ ndǝ dlǝvǝ nyi, ama alenyi nji wu pama nda wu tǝkǝkǝr ǝnga ja. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>Kǝ Yesu shili ǝgya nda, ji sa na, “Dǝnama a dǝmǝlmau ǝnga kǝra a gyiwu ˈyi a nǝ ɗar nji. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Agabangau, maˈya mau, hya nda mǝliya njir duniya patǝ aga nda ɗa zǝmbǝlma ɗa, hya hǝr nda baɓǝtizǝma wu thlǝmǝr Tada ǝnga Zǝr ba ǝnga Mambǝl Cicau. <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Hya highiɓǝr nda ǝnggǝra ndu ɓǝla sǝr ɓǝla kǝra yi nar hyi. Pakatǝ aˈyi yi ǝnga hyi cumu baˈanǝ kuɗiyar duniya.”<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
