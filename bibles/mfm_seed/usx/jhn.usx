<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Margi Tiwi Ənga Tǝm [mfm]</book>
  <para style="h">Yahwana</para>
  <para style="toc3">Yah</para>
  <para style="toc2">Yahwana</para>
  <para style="toc1">Ndǝshigu Sara Wu Tsa Yahwana</para>
  <para style="mt2">Ndǝshigu Sara Wu Tsa</para>
  <para style="mt1">Yahwana</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">Ndǝr Sha Aga Ndapi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>Kadivira Hyal dzǝguya duniya ndǝr aˈyi, ndǝr kǝ ǝnga Hyal nga ja, ǝnga tsu ndǝr kǝ Hyal ngau. <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>Aˈyi ja ǝnga Hyal kadivira ja dzǝguya duniya. <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>Lagu nyi ngǝ Hyal mǝliya sǝ patǝu, ma aˈyi ǝnga ja mai, sǝ aˈyi kǝra Hyal mǝliya wu sǝra ji mǝlna mai. <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>Wu ja ngǝ pi, najaka pi tsu ca ngǝ mbǝmbǝl nǝ nji. <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>Mbǝmbǝla nyi a vǝr mbǝl wu kuthlǝu, ama kuthla nyi aˈyi a sǝn ciya mbǝmbǝla nyi mai.<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>Vanyi ndǝ aˈyi kǝra Hyal sǝwa, thlǝmǝ nyi ca ngǝ Yahwana. <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>Ji shili ar viya sakida ar kǝra mbǝmbǝl kau, aga patǝr nju nda mbǝrsa ǝnga ja lagu nyi. <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>Naja ǝnga kǝrnyi ngǝ mbǝmbǝl kǝ mai, ama ji shili ar viya sakida ar kǝra mbǝmbǝla nyi. <verse eid="JHN 1:8"/><verse number="9" style="v" sid="JHN 1:9"/>Mbǝmbǝl kǝra jiri, kǝra wu nǝ nyi mbǝmbǝlkur anǝ kalar ndǝ a vǝr shili wu duniya.<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>Ji shili wu duniya kǝra naja ngǝ mǝliya ǝnga kǝrnyi, ama alaga abangau, njir duniya aˈyi sǝnbiya nyi mai. <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>Ji shili aga ˈyiˈyi kǝra nǝ nyi, ama nji nyi aˈyi dlǝwuri nyi mai. <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>Ama anǝ patǝr njira dlǝwuri nyi, njira mbǝrsa ǝnga thlǝmǝ nyi, anǝ ndar ja dǝnama nǝ ɗa wazha Hyal. <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>Aˈyi wazha yaya wu ndǝkur mai, alaga lagur cim nǝ ndǝkur mai, ǝnga alaga lagur ɗǝnga nǝ salkur mai, ama yaya sara ara Hyal.<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>Ndǝr kau, ba ji ɗa ndapi, ba ji nggya wu pama mǝn. Naˈya tsu lari kadakadarkur nyi, kadakadarkur nǝ Zǝr Zǝmǝ pathlǝ sara ara Tada, kǝra nyinyau ǝnga mayiwakur ba ǝnga jirkur.<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>Yahwana ngǝ lǝr sakida ar kǝra ja, ji hyaˈana ɗahǝu, ji na, “Naja kǝ ngǝ ndǝra yi ndǝr ar kǝra ja ar pǝci kǝra yi na, ‘Ndǝra wu shili wu yukuɗǝ ɗa, naja ndiya ɗa, ara aˈyi ja kadivira nji ya ɗa.’ ” <verse eid="JHN 1:15"/><verse number="16" style="v" sid="JHN 1:16"/>Sara wu nyinyikur nǝ mayiwakur nyi nga mǝn uya barka, ju lǝ mayiwakur nyi ar kǝr ar kǝr. <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>Arya dlaɗǝ shili lagu tsa Musa, ama mayiwakur ǝnga jirkur shili lagu Yesu Kǝrsiti. <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>Ndǝ aˈyi kǝra saya fǝr li ar Hyal mai, ama kǝl Zǝr Hyal Zǝmǝ pathlǝu, kǝra a vǝr nggya ǝnga Tada, a cabiya mǝnǝr ja Hyal.<verse eid="JHN 1:18"/></para>
  <para style="s1">Sakida Nǝ Yahwana<optbreak/> Ndǝr Mǝl Baɓǝtizǝma</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matiwu 3:1-12</ref>; <ref loc="MRK 1:1-8">Markusu 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>Kǝja sakida kǝra Yahwana lǝri ar pǝci kǝra njira nggurǝm nǝ Yahudiya sara wu Urshalima sǝwa pubuˈyar ǝnga njir Lawi aga nda yiwabiya tara wa nga ja. <verse eid="JHN 1:19"/><verse number="20" style="v" sid="JHN 1:20"/>Naji nggǝl ara nar nda jiri mai, ama ji nana ar babal abǝr, “Nayi ngǝ Kǝrsiti mai.”<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>Kǝ ndǝ yiwa nyi ndǝ na, “Ya, wa nga ga? Nagǝ ngǝ Iliya ya?”</para>
  <para style="p" vid="JHN 1:21">Kǝ ji shaɗǝwa nda, ji na, “Awau, nayi ngǝ mai.”</para>
  <para style="p" vid="JHN 1:21">Əngwar nda, “Ya, nagǝ ngǝ nabiya nyi ya?”</para>
  <para style="p" vid="JHN 1:21">Kǝ ji shaɗǝwa, “Awau.”<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>Ayukuɗa nyi patǝu, kǝ ndǝ na, “Wa nga ga? Nar ˈya sǝra ˈya sha ˈya nda nar nyi anǝ njira sǝwa ˈya. Mi nga gu na ar kǝra kǝr nga?”<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>Kǝ Yahwana shaɗǝwa nda lagu ndǝr nabi Əshaya, ji na, “Nayi ngǝ ɗahǝ a vǝr ngga a gwar tagǝu, ja vǝr na, ‘Hya pabǝri nyi lagu anǝ Thlagǝu, hya mǝliya lagu tataˈyi pir wu mwa nyi.’ ”<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>Kǝ alenyi njir Farisi, njira nji sǝwa <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>yiwa nyi, “Ma nagǝ aˈyi Kǝrsiti mai, ǝnga nagǝ aˈyi Iliya mai, ba nagǝ tsu aˈyi nabiya nyi mai, mi ngǝ ɗa gu mǝl baɓǝtizǝma?”<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>Əngwar Yahwana, “Nayau, ya vǝr mǝl baɓǝtizǝma anǝ hyi ǝnga ˈyimi. Ama vanyi ndǝra ndiya ɗa ǝnga dǝnama a vǝr shili, kǝra alaga sǝr mba ɓiɓi nyi nayi aˈyi ɗa tsa aga ya pǝlna mai. <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>Ju sa mǝliya hyi baɓǝtizǝma ǝnga Mambǝl Cicau ba ǝnga uˈu.”<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>Sǝˈyar kǝ patǝ ɗarkǝr wu Bethlani, a biyar ya dǝl Urdǝnu, vira Yahwana a vǝr mǝl baɓǝtizǝma ari.<verse eid="JHN 1:28"/></para>
  <para style="s1">Yesu Zǝr Gamǝ Nǝ Hyal</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>Əzǝgǝkura nyi ba Yahwana lari Yesu a vǝr shili lagu nyi, kǝ ji na, “Kǝja, Zǝr Gamǝ nǝ Hyal, kǝra hǝna bikǝ nǝ njir duniya! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>Ndǝ kǝ nga ya vǝr ndǝr ar kǝri ta, ta yi na, abǝr ‘Ndǝ aˈyi a vǝr shili ayukuɗǝ ɗa, ama naja dǝgal a ndiya ɗa ara tsu ɗǝɗǝmǝ aˈyi ja kadivira nja ya ɗa.’ <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>Nayi ǝnga kǝrɗa sayi sǝni nyi mai, ama yi shili, yi sa mǝl baɓǝtizǝma ǝnga ˈyimi anǝ nji aga ya cabiya nyi anǝ njir Izirayila.”<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>Kǝ Yahwana lǝri najaka sakida abǝr, “Yi lari Mambǝl a vǝr shida sara dǝmǝlmau, a papa mbǝthla, ji sa ndzafau a dar kǝra ja. <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>Nayi ǝnga kǝrɗa yu sǝni nyi mai, ama kǝl ta ndǝra sǝwa ɗa aga sa mǝl baɓǝtizǝma ǝnga ˈyimi nar ɗa abǝr, ‘Ndǝra gǝ lari Mambǝl ndzafau ar ja, naja ngu nda mǝl baɓǝtizǝma anǝ nji ǝnga Mambǝl Cicau.’ <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>Nayi tsu a lar yi sǝkǝ nyabiya dzǝ ar kǝra ja, ca ngǝ ɗa yi lǝri sakida abǝr ndǝ kau, Zǝr Hyal ngau.”<verse eid="JHN 1:34"/></para>
  <para style="s1">Zǝmbǝlmaˈyar Nǝ Yesu Nǝ Tanggǝrma</para>
  <para style="r">(<ref loc="MAT 4:18-22">Matiwu 4:18-22</ref>; <ref loc="MRK 1:16-20">Markusu 1:16-20</ref>; <ref loc="LUK 5:2-11">Luka 5:2-11</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>Əzǝgǝkura nyi Yahwana ǝnga nji mǝthlǝ sara wu pama zǝmbǝlma nyiˈyar ar vi ta wayu. <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>Kǝ Yahwana lari Yesu ja vǝr tǝrabiya, kǝ ji na, “Lara mau, Zǝr Gamǝ nǝ Hyal!”<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>Ənggǝra zǝmbǝlmaˈyar kǝ mǝthlǝ nggari sǝra Yahwana na, kǝ ndǝ nu Yesu. <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>Ta Yesu shabiya dzau, ba ji lari nda nda a vǝr nu nyi, kǝ ji yiwa nda, “Mi nga hyu gala?”</para>
  <para style="p" vid="JHN 1:38">Əngwar nda, “Rabi” kǝra cabiya Malǝmǝ ngau, “Əmani nga gu nggya?”<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>Kǝ Yesu shaɗǝwa nda, ji na, “Anda mau hya sa lari.”</para>
  <para style="p" vid="JHN 1:39">A ndu saka foɗǝ nǝ wagǝu, kǝ ndǝ maˈyi ndǝ nda lari viya nyi, ba ndǝ hǝna pǝkǝ ǝnga ja.<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>Andǝrawusu, zamǝya Simanu Biturusu, aˈyi ja pathlǝ wu pama nji mǝthlǝ kǝra nu Yesu ayukuɗa Yahwana nana ndǝr ar kǝra Yesu. <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>Sǝ tanggǝrma kǝra Andǝrawusu mǝliya ca ngǝ, ji maˈyi ji nda thlǝwa zamǝ nyi Simanu, ba ji nar nyi, “A nǝr ˈya Ndǝ Cacaɗau” ndǝra nju ngga ǝnga Kǝrsiti. <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>Kǝ ji shili ǝnga Simanu a shili ara Yesu.</para>
  <para style="p" vid="JHN 1:42">Yesu tsamǝ nyi, ba ji na, “Nagǝ ngǝ Simanu zǝr Yahwana. Nju nda ngga ngau ǝnga Kefasu,” kǝra ma nji shabiya ca ngǝ Biturusu.<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">Sǝra Biturusu aga nyi ca ngǝ tsǝka.</char></note><verse eid="JHN 1:42"/></para>
  <para style="s1">Yesu Ngga Fǝlipǝu Ənga Nathlaniyalu</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>Əzǝgǝkura nyi tsu kǝ Yesu biya ju maˈyi a vu Galili. Kǝ ji thlǝwa Fǝlipǝu, kǝ ji na anǝ nyi, “Nu ɗa.”<verse eid="JHN 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44"/>Fǝlipǝu sara wu Bethlesaida nga ja, mǝlmǝr Andǝrawusu ǝnga Biturusu. <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>Fǝlipǝu maˈyi ji nda thlǝwa Nathlaniyalu, kǝ ji na anǝ nyi, “A nǝr ˈya ndǝra Musa tsǝfǝri sǝ ar kǝri wu lǝkakaɗǝ nǝ dlaɗau ǝnga nabiˈyar tsu tsǝfǝri, naja ngǝ Yesu ndǝr Nazǝratu, zǝr Yusufu.”<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>Kǝ Nathlaniyalu yiwa ji na, “Sǝ tsapǝu a sǝn biya sara wu Nazǝratu ya?”</para>
  <para style="p" vid="JHN 1:46">“A ndǝ ga sa lari ǝnga kǝrngau,” ǝngwar Fǝlipǝu.<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>Ta Yesu lari Nathlaniyalu a vǝr shili ara ja, kǝ ji na ar kǝra ja, “Lara mau ndǝr Izirayila nǝ jijiri, ndǝra gǝra ǝnga nggyabiya fafati.”<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>Kǝ Nathlaniyalu yiwa ji na anǝ Yesu, “Lagu mani nga gǝ sǝn ɗa?”</para>
  <para style="p" vid="JHN 1:48">Əngwar Yesu, “Ar pǝci kǝra gǝ ǝgya kiɗa wur martǝndǝm ta nga yi lar ngau, kadivira Fǝlipǝu dzǝgwa ngga ngau.”<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>Kǝ Nathlaniyalu na, “Malǝmǝ, nagǝ ngǝ Zǝr Hyal; nagǝ ngǝ Tǝl nǝ njir Izirayila!”<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>Yesu nar nyi anǝ Nathlaniyalu, “Gǝ mbǝrsa ara yi nar ngǝ abǝr yi lar ngǝ ar pǝci kǝra gǝ ǝgya kiɗa wur martǝndǝm ta ya? Jiri, gu nda lari sǝra a ndiya kau.” <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>Kǝ Yesu ɓǝra nar nyi, “Ənga jiri nga yu na anǝ hyi, hyu nda lari dǝmǝlmǝ a pahǝri, waladiˈyar nǝ Hyal a vǝr di ǝnga gya ar kǝra Zǝr Ndau.”<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">Mini Hǝ Dzau Wu Kana Nǝ Mǝlmǝ Galili</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>Ar pǝci nǝ makǝrkura nyi, mini nǝ hǝ dzǝ aˈyi wu mǝlmǝ Kana nǝ ˈyiˈyir Galili. Miya Yesu aˈyi ja a ndǝna. <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>Yesu ǝkkǝˈyi zǝmbǝlma nyiˈyar ma nji nggǝya nda a shili ar vir mini kau. <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>Ənggǝra ˈyimir wur inabi kuɗau, kǝ miya Yesu na anǝ nyi, “ˈYimir wur inabir nda a kuɗǝri.”<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>Yesu shaɗǝwa nyi, ji na, “Ama, mi ngǝ nǝr mǝn wu sǝ ka? Pǝci ɗa ma aˈyi ɗa kwatahǝ mai.” <verse eid="JHN 2:4"/><verse number="5" style="v" sid="JHN 2:5"/>Kǝ miya Yesu nar nyi anǝ njir tǝkǝ sǝr sǝm, “Nahya mau, kalar sǝra ji na anǝ hyi, ca nga hya mǝl.”<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>Lǝha dzǝr viya nyi ha tsǝka aˈyi kwa, kǝra njir Yahudiya wu kǝbǝ kwatǝ ci dzǝ ǝni, ǝnggǝr kǝra mbǝrsar nda cabiya. Kalar ha nyi wu sǝn hǝri ǝgwa kwa kwa ǝnga ˈyimi. <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>Kǝ Yesu nar nyi anǝ njir tǝkǝ sǝr sǝm, “Nyanyana mǝ haˈyar kǝ patǝ ǝnga ˈyimi.” Ba ndǝ nyanyana nda ba ar miya. <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>Kǝ ji na anǝ nda, “Kabangǝkau, gǝri nya mau a nda nǝ tsahwaˈa.” Kǝ ndǝ gǝri ndǝ hǝr nyi a nda. <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>Ta tsahwaˈa ɗahari ˈyimi hyalagǝ kǝra sha aga ˈyimir wur inabi, naji sǝnbiya vira nji uya nyi sara ar mai, ama njir tǝkǝ sǝr sǝm wu sǝni. Kǝ tsahwaˈa nggar salkwanjili a ndumwar sau, <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>kǝ ji na anǝ nyi, “Kalar ndu shili ǝnga ˈyimir wur inabi kǝra ndiya ǝnga mǝsahǝu tsu kaɗǝu, ayukuɗa ndǝ sa, ndǝ nyau, ba nja shili ǝnga kǝra cacaɓǝu, ama, nǝ ngǝ kau, pamǝ nga nyi ara nji, gǝ piyari kǝra mǝsahǝu kǝl kabangǝkau!”<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>Najakǝ ngǝ sǝ dǝdǝgur nǝ tanggǝrma kǝra Yesu mǝliya, ji mǝliya sǝ kǝ wu mǝlmǝ Kana nǝ Galili. Najakǝ ngǝ cabiya kadakadarkur nyi, ǝnga ji mǝliya zǝmbǝlma nyiˈyar mbǝrsa ǝnga ja.<verse eid="JHN 2:11"/></para>
  <para style="s1">Yesu Kǝdlǝbiya Njir Shafǝli <optbreak/> Wu Ki Hyal Aga Ja Ɗa Cicau</para>
  <para style="r">(<ref loc="MAT 21:12-13">Matiwu 21:12-13</ref>; <ref loc="MRK 11:15-17">Markusu 11:15-17</ref>; <ref loc="LUK 19:45-46">Luka 19:45-46</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>Ayukuɗa kǝ ngǝ Yesu ǝnga mǝnyi ǝnga zamǝ nyiˈyar ba ǝnga zǝmbǝlma nyiˈyar maˈyi a gyiwu Kafarnahumu. A gyina, ndǝ sǝkari nǝ pida ɗiyawu.<verse eid="JHN 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>Ta pǝcir lardur vǝlna nǝ njir Yahudiya ɗa lǝhǝu, kǝ Yesu maˈyi a du Urshalima. <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>Wu huɗa ki Hyal, ba ji thlǝwa nja vǝr ɗǝlna thla, ǝnga tǝmahǝu ǝnga mbǝthlaˈyar aga saɗaka, ba ji thlǝwa alenyi nji tsu nda vǝr bǝla bǝla gǝnnar nda. <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>Kǝ Yesu lǝmiya kurpǝ sara wu ǝpa, ba ji kǝdlǝbiya nda patǝ sara wu Ki Hyal. Ji kǝdlǝbiya tǝmahǝ ǝkkǝˈyi thla, ba ji shashabiya tǝmbǝl bǝla bǝla gǝnnar nda a dǝmǝlmau, ǝnga ji tǝtǝlna gǝnnar nda. <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>Kǝ Yesu nar nyi anǝ njira vǝr ɗǝlna mbǝthlaˈyar kau, “Faˈabiya mau sǝˈyar kǝ ǝnggau! Hya sara shabiya ki dǝɗa aga sugu mai.” <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>Ənggǝra sǝ kǝ ɗarkǝr, kǝ zǝmbǝlma nyiˈyar ɗǝngari sǝra tsǝtsǝfau, wu lǝkakaɗǝ nǝ Hyal abǝr, “Huɗǝ hamǝ nǝ ki Hyal a vǝr mbǝ ɗa ǝnggǝr uˈu.”<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>Kǝ njira nggurǝm nǝ Yahudiya yiwa Yesu, ndǝ na, “Ya, mi ngǝ sǝ dǝdǝgur kǝra gu sǝn mǝliya, kǝra wu cabiya ˈya abǝr aˈyi gǝ ǝnga dǝnama nǝ mǝliya sǝˈyar ka?”<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>Kǝ Yesu shaɗǝwa nda, ji na, “Hya dlana ki Hyal kau, ba ya sa hyaˈana wu pida makǝru.”<verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>Kǝ ndǝ shaɗǝwa nyi, ndǝ na, “Nji hǝri fa foɗǝ kumunyi apǝ kwa a vǝr hǝr ki Hyal kau, ya, abari nga gu sǝn hyaˈana nyi wu pida makǝr ka?”<verse eid="JHN 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21"/>Ama ki Hyal kǝra Yesu wu ndǝr ar kǝri kau, dza ja ngau. <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>Ayukuɗa Yesu hyaˈari sara vir tau, kǝ zǝmbǝlma nyiˈyar ɗǝngari sǝ kǝ Yesu nar nda kau. Kǝ ndǝ dzǝgwa mbǝrsa ǝnga sǝra tsǝtsǝfau wu lǝkakaɗǝ nǝ Hyal ǝnga sǝra Yesu nana.<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>Ar pǝci kǝra Yesu wu lardur nǝ vǝlna wu Urshalima, nji gangǝu mbǝrsa ǝnga ja arya sǝ dǝdǝgur kǝra ndu lari ji mǝl. <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>Ama Yesu aˈyi fiyafǝ ǝnga nda mai, ara ju sǝnbiya nji patǝu. <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>Naja aˈyi wu yiwu nja lǝr sakida ar kǝra nji anǝ nyi mai, arya ju sǝn sǝra wu ɗǝfuwa ndapi.<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">Nikodimosu Ənga Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>Saya ɗa vanyi ndǝr Farisi aˈyi kǝra nja ngga ǝnga Nikodimosu, naja pathlǝ wu pama njira nggurǝm nǝ Yahudiya. <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>Ji shili ǝgya Yesu uvuˈyi, ji sa na, “Malǝmǝ, ˈyi wu sǝni abǝr nagǝ malǝmǝ ngau, sara ara Hyal, arya ndǝr sǝn mǝliya sǝˈyar kǝ ga vǝr mǝl kǝ aˈyi mai, kǝl ndǝra Hyal ǝnga ja.”<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Yi wu nar ngau jirkura nyi, ndǝr sǝn gwu tǝlkur Hyal aˈyi mai kǝl ma nji ɓǝra yabiya nyi nǝ mǝthlǝkura nyi.”<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>Kǝ Nikodimosu yiwa nyi, ji na, “Lagu mani nga nja ɓǝra sǝn yabiya ndǝra a halǝr ka? Ja ɓǝra sǝn sha a vu huɗa mǝnyi aga nja ɓǝra yabiya nyi nǝ mǝthlǝkura nyi ya?”<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>Yesu shaɗǝwa nyi, ji na, “Jiri nga yu na anǝ ngau, ndǝr sǝn gwu tǝlkur Hyal aˈyi mai, kǝl nji ɓǝra yabiya nyi nǝ ˈyimi ǝnga nǝ Mambǝl. <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>Sǝra ndapi yabiya ndǝ ngau, ama sǝra Mambǝl yabiya tsu mambǝl ngau. <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>Ja sara ɗa sǝ dǝdǝgur anǝ ngǝ mai, ara yi na, abǝr, ‘Kǝl nji ɓǝra yabiya ngǝ nǝ mǝthlǝkura nyi.’ <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>Yambaɗǝ wu sǝ a ndar vira ju yiwu. Gu nggari ǝnggǝra ju sau, ama nagǝ wu sǝn nana vira ji hyaˈari sara ari ǝnga vira ju maˈyi a ndar tsu mai. Abangǝ nga nyi tsu ǝnga ndǝra nji yabiya nyi wu Mambǝl.”<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>Kǝ Nikodimosu yiwa Yesu, ji na, “Abari ngǝ sǝkǝ wu sǝn ɗa?”<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Ya, nagǝ malǝmǝ dǝgal ngau wu Izirayila, ama nagǝ wu nggabiya sǝˈyar kǝ mai ya? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>Jiri nga yu na anǝ ngau, ˈyi wu ndǝr ar kǝra sǝra ˈyi wu sǝni, ǝnga ˈyi wu lǝr sakida ar kǝra sǝra ˈyi lari, ama alaga abangau nahyi aˈyi dlǝwuri sakidar ˈya kǝ mai. <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>Ma yu ndǝr anǝ hyi ar kǝra sǝra wu duniya, nahyi mbǝrsa ǝni mai, abari nga hyu sǝn nda mbǝrsa ma yi ndǝr anǝ hyi ar kǝra sǝra a dǝmǝlma? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>Ndǝ aˈyi kǝra saya maˈyi a dǝmǝlmǝ mai, kǝl naja Zǝr Ndǝ kǝra shida sara dǝna. <verse eid="JHN 3:13"/><verse number="14" style="v" sid="JHN 3:14"/>Ənggǝr kǝra Musa har pabau a dar wu tagǝ mashi ta, abangǝ tsu kǝl nji hyaˈana Zǝr Ndau a dar wu, <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>aga kalar ndǝra mbǝrsa ǝnga ja wu uya pi gǝra kuɗau.”<verse eid="JHN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>“Arya Hyal ca yiwukur anǝ njir duniya gagaɗau, ca ngǝ ɗa ji lǝri Zǝr nyi zǝmǝ pir, aga kalar ndǝra hǝnggǝri ǝnga ja, naji wu tǝ mai, ama ju uya pi gǝra kuɗau. <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>Arya Hyal aˈyi sǝwa Zǝr nyi a shida wu duniya aga ja sa mǝlna nyi numa anǝ duniya mai, ama aga njir duniya a uya mbǝɗau lagu nyi. <verse eid="JHN 3:17"/><verse number="18" style="v" sid="JHN 3:18"/>Kalar ndǝra mbǝrsa ǝnga Zǝr Hyal, numa aˈyi wu sǝm nyi mai. Ama kalar ndǝra aˈyi mbǝrsa ǝnga ja mai, numa a sǝmku nyi ri tsu kaɗǝ ara naji mbǝrsa ǝnga thlǝmǝr Zǝr Hyal kǝra zǝmǝ pir mai. <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>Kǝja sǝra ju nda mǝl numa ar kǝri, mbǝmbǝl shili wu duniya, ama njir duniya wu yiwu kuthlǝu a ndiya mbǝmbǝl ara sǝr mǝla nda ɗǝmwaˈyu. <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>Kalar njira wu mǝl sǝ ɗǝmwaˈyu, shishir dza nda wu yiwu mbǝmbǝl mai, ara hivǝr sǝr mǝla nda a biyar babal. <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>Ama njir mǝl sǝra tsaˈa ndu shili ar vi mbǝmbǝl, aga nja lari ar babal abǝr sǝra ndu mǝl sǝra Hyal wu yiwu ngau.”<verse eid="JHN 3:21"/></para>
  <para style="s1">Yahwana Ndǝr Mǝl Baɓǝtizǝma <optbreak/> Ɓǝra Lǝr Sakida Ar Kǝra Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>Ayukuɗa kau, kǝ Yesu ǝnga zǝmbǝlma nyiˈyar maˈyi a ndar ˈyiˈyir Yahudiya. A ndǝna ji nda ɓǝliya sar kushu, ju mǝl baɓǝtizǝma anǝ nji. <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>Yahwana nǝ nyi tsu ja vǝr mǝl baɓǝtizǝma anǝ nju mǝlmǝ Ayinanu kǝra lǝhǝu wu dzǝr mǝlmǝ Salimu, ara ˈyimi aˈyi gangǝu a ndǝna. Nji kǝl shili nga ndu shili ju mǝl baɓǝtizǝma anǝ nda. <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>(Sǝkǝ ɗarkǝr kadivira nji fuwa Yahwana wu fursǝna.)<verse eid="JHN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25"/>Kǝ zǝmbǝlmaˈyar nǝ Yahwana gu kǝpal ǝnga vanyi ndǝr Yahudiya ar kǝra ci dzǝ kǝra dlaɗǝ nana nja mǝl. <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>Ndǝ shili ǝgya Yahwana, ndǝ sa na anǝ nyi, “Malǝmǝ, ndǝ ta ǝnga gǝ a biyar ya dǝl Urdǝnu ta, ndǝ ta gǝ lǝri sakida ar kǝr ta, kǝja ja vǝr mǝl baɓǝtizǝma anǝ nji ǝnga patǝr nja vǝr sha shili ara ja.”<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>Kǝ Yahwana shaɗǝwa nda, ji na, “Ndǝr sǝn dlǝwuri sǝ aˈyi mai, kǝl sǝra Hyal nǝ nyi. <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>Nahyi ǝnga kǝrhyi ngǝ sakida ɗa arya yi na anǝ hyi, ‘Nayi ngǝ Kǝrsiti mai, ama Hyal sǝwa ɗa wu mwa nyi.’ <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>Ar pǝcir hǝ dzau, kwanjili nǝ sal kwanjili ngau. Bazhiya sal kwanjili kǝra shili ar vir hǝ dzǝ kau, kǝl sǝkǝ nga ja, aga ja nggari ɗaha sal kwanjili. Ju nyi ǝnga huɗǝ pipida ma ji nggari sal kwanjili a vǝr ndǝr. Lagu kǝ tsu ngǝ huɗǝ pipida ɗa a nyabiyar dzau. <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>A ɗari tsaˈa ja cakau, nayi tsu ya gǝnna dzau.<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>“Ndǝra shida sara a dǝmǝlmau, naja nga adabanga nji patǝu. Patǝr njira wu duniya nǝ duniya ngau, ǝnga ndu ndǝr ar kǝra sǝr duniya. Ndǝra shida sara a dǝmǝlmau, naja nga adabanga nji patǝu. <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>Ju lǝri sakida sǝra ji lari ǝnga ji nggari, alaga abangau, ndǝ aˈyi kǝra mbǝrsa ǝnga sakida nyi mai. <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>Ama kalar ndǝra dlǝwuri sakida nyi a cabiyari abǝr Hyal ndǝ jijiri ngau. <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>Ara ndǝra Hyal sǝwa, ndǝr Hyal nga ju na, arya Hyal nǝ nyi Mambǝl nyi nyinyau. <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>Tada wu yiwu Zǝr nyi, ba ji fuwa patǝr sǝ wu tsa ja. <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>Kalar ndǝra mbǝrsa ǝnga Zǝra nyi aˈyi ja ǝnga pi gǝra kuɗau. Ndǝra gǝra ɓǝla sǝra Zǝra nyi nana, naji wu uya pi mai, ama Hyal wu ɗǝfu ǝnga ja.”<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">Yesu Ndǝr Ənga Mala Sara Samariya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>Njir Farisi nggari abǝr Yesu a vǝr dumwa ǝnga uya nji, ǝnga mǝl baɓǝtizǝma anǝ zǝmbǝlma gangǝu a ndiya Yahwana. <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>Kwalaga kǝ aˈyi Yesu ǝnga kǝrnyi nga vǝr mǝl baɓǝtizǝma kǝ mai, ama zǝmbǝlma nyiˈyar ngau. <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>Ənggǝra Yesu nggari abangau, kǝ ji piyari ˈyiˈyir Yahudi ba ji ɓǝra sha a vu ˈyiˈyir Galili.<verse eid="JHN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4"/>Kabangǝkǝ a mbari kǝl Yesu ja tǝrabiya wu Samariya. <verse eid="JHN 4:4"/><verse number="5" style="v" sid="JHN 4:5"/>Kǝ ji dla wu vanyi mǝlmǝ wu ˈyiˈyir Samariya kǝra nja ngga ǝnga Sayika. Vi kau, lǝhǝ nga nyi a dzǝr vira Yakubu nǝ nyi anǝ zǝr nyi Yusufu. <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>Ar vi kau, mǝla nǝ Yakubu aˈyi. Ar pǝci kǝra Yesu hǝɗa ǝnga ɓau, ba ji ɓǝliya sar a miya mǝla nyi. Sǝkǝ ɗarkǝr ǝnggǝr saka kumo apǝ mǝthlǝ nǝ puci.<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>Kǝ vanyi mala nǝ Samariya shila gwa mǝla. Kǝ Yesu na anǝ nyi, “Usi, gǝr ɗa ˈyimi ya tǝwari.” <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>(Zǝmbǝlma nyiˈyar tsu a maˈyir nda a vu huɗa mǝlmǝ aga nda vuwa ɗǝl sǝr sǝm.)<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>Kǝ mala Samariya kǝ na anǝ Yesu, “Abari nagǝ ndǝr Yahudiya a sǝn yiwa ˈyimi ara ya, nayi mala Samariya?” (Ara sǝ aˈyi kǝra wu daɓǝri ndǝr Yahudiya ǝnga ndǝr Samariya mai.)<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Kwalaga cala miya ha nǝ njir Samariya njir Yahudiya wu mǝl thlǝr ǝni mai. </char></note><verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>Əngwar Yesu, “Maja abǝr gu sǝni sǝ kurthlǝ nǝ Hyal kǝra ju lau, ǝnga ndǝra na anǝ ngau, ‘Gǝr ɗa ˈyimi ya tǝwari,’ gu sǝn yiwa nyi, ba ja nǝ ngǝ ˈyimi nǝr lǝ pi.”<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>Kǝ mala kǝ na, “Malǝmǝ, kǝja sǝr gǝ ˈyimi aˈyi ara gǝ mai, ya, kǝja mǝla kǝ dzǝgamǝ nga nyi, lagu mani nga gu sǝn gǝr ɗa ˈyimi lǝ pi ka? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>Ɗǝm ya, naga ndiya dǝrˈya Yakubu, ndǝra labiya ˈya mǝla kǝ ya? Naja ǝnga kǝrnyi ma, ji sa ˈyimi sara a gwa, ǝnga wazha nyi ba maˈwi nyiˈyar.”<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>Yesu na, “Kalar ndǝra sa ˈyimi kau, hili wu ɓǝra nda tǝ nyi wayu. <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>Ama ndǝra sa ˈyimi kǝra yu lǝ kau, naji wu ɓǝra nggar hili mai baˈanuwa. ˈYimi kǝra yu lǝ kau, wu nda ɗa wu ja ǝnggǝr mandǝli ˈyimi kǝra wu huhwi sara wu dza ja kǝra wu nǝ nyi pi gǝra kuɗau.”<verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>Əngwar mala kau, “Malǝmǝ, nǝ ɗa ˈyimi kau, ara ya sara ɓǝra nggari hili, ǝnga ya ɓǝra shili ǝnggau ya sa gǝ ˈyimi.”<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>Kǝ Yesu na, “Maˈyi ga nda shili ǝnga sal ngau.”<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>Əngwar ja, “Sal aˈyi ara yi mai.”</para>
  <para style="p" vid="JHN 4:17">Əngwar Yesu anǝ nyi, “A nabiyar gǝ jiri ǝnggǝra gǝ na abǝr, ‘Sal aˈyi ara yi mai.’ <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>Arya jirkura nyi ca ngǝ a hǝr gǝ shili pamǝpamǝ tǝfu, ǝnga ndǝ kǝ gǝ ǝni kabangǝkǝ kǝ sal ngǝ mai, a nabiyar gǝ jiri.”<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>Əngwar ja, “Ndǝ dǝgalǝu, maya nggani nagǝ nabi ngau. <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>Əjir ˈya dlǝvǝ Hyal ar mǝ kau. Ama ǝngwar hyi njir Yahudiya wu Urshalima ngǝ vira nja kyaga dlǝvǝ Hyal.”<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>Kǝ Yesu na, “Mala, mbǝrsa ǝnga sǝra yu na kau, arya pǝci a vǝr shili kǝra nji tsu wu nda dlǝvǝ Tada ar mǝ kǝ mai, alaga wu Urshalima mai. <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>Nahyi njir Samariya nahyi wu sǝni ndǝra hyu dlǝvǝ mai, naˈya ˈyi wu sǝni ndǝra ˈyi wu dlǝvau, ara mbǝɗau shili sara ara njir Yahudiya. <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>Ama pǝci a vǝr shili, pǝca nyi ma a shiliri, kǝra njir dlǝvǝ Tada ǝnga jiri wu nda dlǝvǝ nyi wu mambǝl ba ǝnga jirkur, ara Tada wu gal culi nji kǝ nga dlǝvǝ nyi. <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>Hyal Mambǝl ngau, njir dlǝvǝ nyi kǝl nda dlǝvǝ nyi wu mambǝl ba ǝnga wu jirkur tsu.”<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>Mala kǝ na, “A sǝn yi abǝr Ndǝ Cacaɗau a vǝr shili ndǝra nju ngga nyi ǝnga Kǝrsiti. Ma ji shili ju sa cabiya ˈya patǝr sau.”<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>Yesu na, “Nayi ndǝra vǝr ndǝr anǝ ngau nayi ngau.”<verse eid="JHN 4:26"/></para>
  <para style="s1">Zǝmbǝlma ˈyar Ɓǝra Sha Shilara Yesu</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>Ar pǝci kǝ ngǝ zǝmbǝlma nyiˈyar sha shili, ba ɗa sǝ dǝdǝgur anǝ nda ǝnggǝra ndǝ thlǝwa nyi ja vǝr ndǝr ǝnga mala. Ama ndǝr sǝn yiwa, “Mi nga ga gal ǝnga mala ka?” Ənga ndǝr sǝn na anǝ nyi, “Mi ngǝ ɗa gu ndǝr ǝnga ja?” aˈyi tsu mai.<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>Kǝ mala kǝ piyari tǝm gwa mǝla nyi, ba ji maˈyi a vu huɗa mǝlmau, ji vuwa nar nyi anǝ nji, <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“Shila mau, hya sa lari ndǝra nar ɗa sǝra yi saya mǝlna patǝu. Abǝr naja ngǝ Kǝrsiti ya?” <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>Kǝ nji bibiya sara wu huɗa mǝlmau, kǝ ndǝ shili ǝgya Yesu.<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>Ar pǝci kǝ ngǝ zǝmbǝlma nyiˈyar a vǝr kǝdi Yesu, “Malǝmǝ, sǝm sau.”<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>Ama kǝ Yesu shaɗǝwa nda, ji na, “Sǝr sǝm aˈyi ara yi kǝra yu sǝn sǝm ama nahyi wu sǝn mai.” <verse eid="JHN 4:32"/><verse number="33" style="v" sid="JHN 4:33"/>Kǝ zǝmbǝlma nyiˈyar yiwa kǝrnda, ndǝ na, “Abǝr vanyi ndǝ daɓaga shili ǝnga sǝr sǝm anǝ nyi ya?”<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>Ama kǝ Yesu shaɗǝwa nda, ji na, “Sǝr sǝm ɗa ca ngǝ ya mǝl sǝra ndǝra sǝwa ɗa wu yiwu ǝnga ya nyabiya thlǝr nyi cipǝu. <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>Hyu na abǝr, ‘A hyiri hya foɗǝ aga fwaha ɗa.’ Ama yu na anǝ hyi, hya pahǝna liya hyi mǝnahǝu aga hya tsamǝ vu huɗa fa, ara a nǝr nda patǝ tsaˈa aga gǝm kabangǝkau. <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>Ndǝr gǝm fa wu uya akkǝri nyi, ǝnga ju kaɓiya sǝ zǝzǝwa nyi, ca ngǝ cabiya njira ju kaɓiya aga nda uya pi gǝra kuɗau. Lagu kǝ ngǝ njir thlǝka ǝnga njir gǝm sǝr fa ndu nyabiya dzǝ ǝnga huɗǝ pipida aga zǝmǝu. <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>Ənggǝ ngǝ karapǝ kǝ nyabiya dzǝ ǝnga jirkur, ‘Vanyi ndǝ thlǝr nyi ca ngǝ thlǝka, vanyi ndǝ tsu thlǝr nyi ca ngǝ gǝm.’ <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>Yi sǝwa hyi aga hya gǝm sǝra hyi gǝra lari ɓwaɓwatǝ a vǝr thlǝka. Alenyi nji a lar nda ɓwaɓwatǝu, nahyi tsu a uyar hyi akkǝri nǝ thlǝr ɓwaɓwatǝr nda.”<verse eid="JHN 4:38"/></para>
  <para style="s1">Njir Samariya Gangǝu Hǝnggǝri</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>Njir Samariya gangǝu sara wu mǝlmǝ kǝ mbǝrsa ǝnga Yesu arya ndǝr mala kǝ kǝra ji na, “Ji nar ɗa patǝr sǝra yi saya mǝliya.” <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>Ənggǝra njir Samariya shili ǝgya Yesu, kǝ ndǝ sa kǝdi nyi ja nggya ǝkkǝˈyi nda, ba ji nggya ǝkkǝˈyi nda nǝ pida mǝthlǝu.<verse eid="JHN 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41"/>Nji gangǝ tsu ɓǝra mbǝrsa ǝnga Yesu arya sǝra ji nar nda. <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>Kǝ njir Samariya dzǝgwa na anǝ mala kau, “Kabangǝkau, a hǝnggǝr ˈya jiri, aˈyi ara sǝra gǝ na waci mai, ama ara naˈya ma a nggar ˈya sǝra ji na ǝnga kǝrˈya, ǝnga a dlǝwunggǝri ˈya ndǝ kǝ naja ngǝ ndǝr mbǝɗa duniya.”<verse eid="JHN 4:42"/></para>
  <para style="s1">Yesu Mbǝɗana Zǝr Ndǝ Dǝgalǝu</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>Ayukuɗa pida mǝthlǝu, kǝ Yesu piyari ˈyiˈyir Samariya ji maˈyi a vu ˈyiˈyir Galili. <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>(Arya Yesu ǝnga kǝrnyi a nanari abǝr, “Nabi aˈyi wu uya hakǝr wu mǝlmǝ nyi mai.”) <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>Ar pǝci kǝra ji vu Galili, kǝ njir Galili dlǝwuri nyi ǝnga huɗǝ zǝmǝ ara nanda ǝnga kǝrnda a lari nda sǝra Yesu mǝlna a vu Urshalima ar pǝcir lardur nǝ vǝlna kǝra nanda ma a vur nda.<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>Kǝ Yesu ɓǝra sha a vu Kana wu Galili, vira ji shabiya ˈyimi a ndu ˈyimir wur inabi. A ndǝna vanyi ndǝ dǝgal nǝ ki tǝl aˈyi kǝra zǝr nyi gǝra ngga a vu Kafarnahumu. <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>Ənggǝra ndǝ kǝ nggari abǝr Yesu a dlari wu Galili sara wu Yahudi, kǝ ji maˈyi a ndǝgya ja, ji nda kǝdi nyi aga ja shili wu ki nyi, ja sa mbǝɗana zǝr nyi kǝra citǝu a miya tau. <verse eid="JHN 4:47"/><verse number="48" style="v" sid="JHN 4:48"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Kǝl ta hyi lari mǝtsamǝ ǝnga sǝ dǝdǝgur ara yau, ca ngǝ ɗa hyi mbǝrsa.”<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>Kǝ ndǝ dǝgal nǝ ki tǝl ta na anǝ Yesu, “Ndǝ dǝgalǝu, shili ma maˈyi a ndu ki ɗa ara zǝr ɗa ka sara tau.”<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>Kǝ Yesu na anǝ nyi, “Maˈyi sǝ ngau, zǝr ngǝ kǝ wu tǝ mai.” Ndǝ kǝ tsu, ba ji mbǝrsa ǝnga sǝra Yesu na anǝ nyi, ba ji maˈyi sǝ nyi. <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>Tsu ja ar lagu ja vǝr maˈyi a ndu ki, ba ji ɓǝ ǝnga njir mǝl thlǝr nyi ar lagu, kǝ ndǝ na anǝ nyi, “Zǝr ngǝ ta a ɗari jamǝu.”<verse eid="JHN 4:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52"/>Kǝ ji yiwa nda pǝci kǝra sǝ kǝ ɗarkǝr. Əngwar nda anǝ nyi, “Na, ǝnggǝr saka pathlǝ nǝ puci ngǝ gyangǝ kǝ siya nyi.” <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>Kǝ dǝya zǝr kǝ tsamǝ ri abǝr ar pǝci kǝ ngǝ Yesu na anǝ nyi, “Maˈyi sǝ ngau, zǝr ngǝ kǝ wu tǝ mai.” Kǝ ndǝ kǝ ǝnga njir ki nyi mbǝrsa ǝnga Yesu.<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>Najakǝ ngǝ sǝ dǝdǝgur nǝ mǝthlǝkura nyi kǝra Yesu mǝliya ayukuɗa ji piyari Yahudi ji shili wu Galili.<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">Yesu Mbǝɗana Ndau A Miya Dǝl Faˈa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>Ayukuɗa kau, kǝ Yesu maˈyi a du Urshalima aga mini nǝ njir Yahudiya. <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>A du Urshalima tsu, vanyi dǝl faˈa aˈyi kǝra nji zǝwuya ǝnga sǝ ǝnggǝr dzaˈwu pamǝpamǝ tǝfu. Nju ngga faˈa kǝ ǝnga miya njir Yahudiya, Bethlesaida. Dǝl faˈa kǝ lǝhǝ nga nyi a dzǝr miya ki kǝra nju ngga ǝnga Miya Ki Tǝmahǝu. <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>Əgya kiɗa dzaˈwuˈyar kǝ ngǝ nji gǝra ngga, ǝnga nji lǝfau, ǝnga nji kadal ba ǝnga nji tǝsǝkǝnu gangǝu wu pida. <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>[Ndǝ wu sǝ kau aga nja gwazhiri ˈyimiya nyi. Arya ga pǝci ga pǝci ngǝ waladi nǝ Thlagǝ wu shida ja sa gwazhiri ˈyimi kau. Ndǝra a gwa tanggǝrma, ba ja uya jamǝkur sara ara shilǝgǝ nyi.] <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>Ənggǝ tsu vanyi ndǝ aˈyi kǝra mǝliya fa makǝrkumunyi apǝ cisu ǝnga tǝsǝkǝnu. <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>Ta Yesu lari nyi aˈyi pida, ǝnga tsu ju sǝni abǝr ndǝ kǝ a ɓǝliyar sar ǝnga tǝsǝkǝnu kau, kǝ Yesu na anǝ nyi, “Gu yiwu ga ɗa jamǝ ya?”<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>Kǝ ndǝ tǝsǝkǝnu kǝ na, “Ndǝ dǝgalǝu, nayi aˈyi ǝnga ndǝr dlǝwa ɗa ma nji gwazhiri ˈyimiya nyi mai. Ma yi mǝl abǝr aga ya sǝn gwa ba vanyi nda gwa a mwa ara yau.”<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>Kǝ Yesu na anǝ nyi, “Hyaˈari ga hǝri buci ngau, ba ga ɓǝ ga maˈyi.” <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>Aga zǝmǝ ba nda nyi ɗa jamǝu, kǝ ji hǝri buci nyi ba ji ɓau.</para>
  <para style="p" vid="JHN 5:9">Sǝ kǝ ɗarkǝr ar pǝcir ɓǝlsar nǝ njir Yahudiya. <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>Agabangau, kǝ njira nggurǝm nǝ Yahudiya nar nyi anǝ ndǝ kǝra nji mǝliya jamǝ kau, “Əshina pǝcir ɓǝlsar ngau, naga kyaga mǝl thlǝr mai, dlaɗǝr mǝna kar ngǝ ri ara hǝ buci ngau.”<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>Kǝ ndǝ kǝ shaɗǝwa nda, ji na, “Ndǝra mǝliya ɗa jamǝ ngǝ na anǝ ɗa, ‘Hǝri buci ngau ga ɓau.’ ”<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>Kǝ ndǝ yiwa nyi, ndǝ na, “Wa ngǝ ndǝ kǝ na anǝ ngau, ga hǝr buci ngau, ga ɓǝ ka?”<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>Ndǝ kǝ nji shilǝgǝbiya kǝ wu sǝni tara wa ngǝ mǝliya nyi jamǝ kǝ mai, arya Yesu a maˈyiri a vu pama dlamir nji kǝra a ndǝna.<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>Ayukuɗa pǝci kushu, ba Yesu thlǝwa nyi wu ki Hyal, ba ji na anǝ nyi, “Lari, a ɗar gǝ jamǝu. Ga piyari mǝl bikau ara sǝ ɗǝmwaˈyi a ndiya kǝ a sara ɗa ǝnga gau.” <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>Kǝ ndǝ kǝ maˈyi ji nda nar nyi anǝ njira nggurǝm nǝ Yahudiya abǝr Yesu ngǝ mǝliya nyi jamǝu.<verse eid="JHN 5:15"/></para>
  <para style="s1">Pi Lagu Zǝra Nyi</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>Ara abangau, ba ndǝ dzǝguya ndǝr papatagǝ anǝ Yesu, ara ju mǝl sǝˈyar kǝ Pǝcir Ɓǝlsar. <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>Kǝ Yesu na anǝ nda, “Dǝɗa a vǝr mǝl thlǝr nyi baˈanǝ kabangǝkau, nayi tsu ya vǝr mǝl thlǝr.” <verse eid="JHN 5:17"/><verse number="18" style="v" sid="JHN 5:18"/>Arya ndǝr kau, ngǝ njir Yahudiya wu gal lagu kǝra nda tsǝya nyi ari. Əngwar nda, “Aˈyi wacu ara ji ɓǝlna sǝra dlaɗǝ na ar kǝra Pǝcir Ɓǝlsar mai, ama ara ju ngga Hyal ar viya dǝnyi, lagu ta nga ju gǝla kǝrnyi kakalǝ ǝnga Hyal.”<verse eid="JHN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>Kǝ Yesu shaɗǝwa nda, ji na, “Ənga jiri nga yu na anǝ hyi, sǝ aˈyi kǝra Zǝr wu sǝn mǝliya ǝnga kǝrnyi mai, sǝra ji lari Dǝnyi a vǝr mǝl, ca nga ju mǝl. Ara kalar sǝra Dǝnyi a vǝr mǝl, ca ngǝ Zǝr wu mǝl tsu. <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>Ara Tada wu yiwu Zǝra nyi, ca nga ju canǝ nyi kalar sǝra ju mǝl ǝnga kǝrnyi. Ba tsu ju canǝ nyi sǝra ndiya sǝ ǝnggǝr kǝ aga ja ɗa sǝ dǝdǝgur anǝ hyi. <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>Ənggǝr kǝra Tada sǝn hyaˈana nji tǝtǝ ja nǝ nda pi, abangǝ tsu Zǝr wu sǝn nǝ nyi pi anǝ kalar ndǝra ju yiwu. <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>Tada wu mǝl numa anǝ nji mai, ara a nǝ nyir ja dǝnama nǝ mǝl numa anǝ Zǝr nyi, <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>aga patǝr nji nda nǝ nyi dǝgalkur anǝ Zǝra nyi, ǝnggǝra ndu lǝ dǝgalkur anǝ Tada. Kalar ndǝra gǝra nǝ nyi dǝgalkur anǝ Zǝra nyi, naja aˈyi nǝ nyi dǝgalkur anǝ Dǝnyi kǝra sǝwa nyi mai.<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>“Ənga jiri nga yu na anǝ hyi, kalar ndǝra wu nggar ndǝr ɗa, kǝ ji mbǝrsa ǝnga ndǝra sǝwa ɗa, aˈyi ja ǝnga pi gǝra kuɗau. Nju nda mǝl numa anǝ nyi mai, ama a tǝrabiyar ja sara wu tau, a ndu pi. <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>Ənga jiri nga yu na anǝ hyi, pǝci a vǝr shili, pǝca nyi ma a shiliri, kǝra nji tǝtǝ wu nda nggar ɗaha Zǝr Hyal, njira nggari ndu nda ɗa aˈyi ǝnga pi. <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>Ənggǝr kǝra Tada ɗa thlagǝr pi, abangǝ tsu nga ji nǝ nyi dǝnama anǝ Zǝra nyi aga ja ɗa thlagǝr pi. <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>Ənga tsu ji nǝ nyi dǝnama nǝ mǝl numa anǝ kalar ndau ara naja Zǝr Ndau.<verse eid="JHN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28"/>Ndǝr kǝ a sara ɗa sǝ dǝdǝgur anǝ hyi mai, ara pǝca vǝr shili kǝra patǝr njira a gu hu wu nda nggar ɗaha ja, <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>ba nda biya. Njira mǝliya sǝ mǝnahǝu ndu hyaˈari ǝnga pi gǝra kuɗau, ama njira mǝliya sǝ ɗǝmwaˈyi ndu hyaˈari ba nja mǝliya nda numa. <verse eid="JHN 5:29"/><verse number="30" style="v" sid="JHN 5:30"/>Sǝ aˈyi kǝra yu sǝn mǝliya ar kǝrɗa mai. Yu thla numa ǝnggǝr kǝra Hyal wu na anǝ ɗa. Agabangau, numa ɗa kakalǝ nga nyi, arya aˈyi sǝra yu yiwu nga yu mǝl mai, ama sǝra ndǝra sǝwa ɗa wu yiwu.<verse eid="JHN 5:30"/></para>
  <para style="s1">Sakida Ar Kǝra Yesu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>“Ma yi lǝri sakida ar kǝra kǝrɗa, sakida kǝ aˈyi dlǝdlǝwu mai. <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>Ama vanyi ndǝ pamǝu aˈyi kǝra wu lǝ sakida ar kǝra yau, a sǝn yi abǝr sakida nyi jijiri nga nyi.<verse eid="JHN 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33"/>“Hyi sǝwa nyi nji anǝ Yahwana, naja, ba ji lǝr hyi sakida kǝra jiri. <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>Alaga abangau, aˈyi yu nggya aga sakida nǝ ndapi mai. Ama yi nar hyi abangau aga hya uya mbǝɗau. <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>Yahwana ǝnggǝr pitǝlla mbǝmbǝl nga ja kǝra lǝri mbǝmbǝl nyi, nahyi tsu, kǝ hyi caguli nǝ mbǝmbǝl nyi nǝ pǝci kushu.<verse eid="JHN 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36"/>“Ama aˈyi yau ǝnga sakida kǝra ndiya kǝra Yahwana lǝri ar kǝra yau. Sǝ kǝra ya vǝr mǝl kau, sǝ ngau kǝra dǝɗa nǝ ɗa aga ya mǝl ǝnga ja vǝr lǝ sakida ar kǝra yau, abǝr dǝɗa ngǝ sǝwa ɗa. <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/>Dǝɗa tsu, ndǝra sǝwa ɗa, nga vǝr lǝ sakida ar kǝra yau. Nahyi saya nggar ɗaha ja mai, ǝnga tsu nahyi saya lari nyi ǝnga li tara wa nga ja mai. <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>Ndǝr nyi tsu wu nggya wu ɗǝfuwa hyi mai, arya nahyi mbǝrsa ǝnga ndǝra ji sǝwa mai. <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/>Nahyi kǝl dumwa ǝnga jiga sǝra tsǝtsǝfau wu lǝkakaɗǝ Hyal, ara hyu nggani a gwa nga hyu uya pi gǝra kuɗau. Najaka sǝ kǝra nji tsǝfǝri wu lǝkakaɗǝ Hyal kau, nanda ngu lǝr sakida ar kǝra yau. <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>Ama alaga abangau, kǝ hyi nggǝl ara shili ǝgya yi aga hya sa uya pi.<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>“Nayi wu gal fal sara ara nji mai, <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>ama yu sǝni hyi. Aˈyi hyi ǝnga yiwu Hyal a vu ɗǝfuwa hyi mai. <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>Nayau, yi shili wu thlǝmǝr dǝɗa, ama nahyi dlǝwur ɗa mai, ama ma vanyi ndǝ shili wu thlǝmǝr kǝrnyi ba hya sa dlǝwuri nyi. <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>Abari nga hyu sǝn mbǝrsa ma hyu dlǝwu fal ara kuvwar hya, ama nahyi wu gal lagur dlǝwu fal sara ara Hyal zǝmǝ pir maya?<verse eid="JHN 5:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45"/>A sara hya ɗǝnga abǝr yu nda wula hyi ara Tada mai. Ndǝr wula hyi aˈyi, naja ngǝ Musa, ndǝra hyu fǝ ɗǝfu ju nda dlǝwar hyi. <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>Maja abǝr hyi mbǝrsa ǝnga Musa, a hǝnggǝr hyi jiri ǝnga yau, arya Musa tsǝfǝri ar kǝra yau. <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>Ama ma nahyi aˈyi mbǝrsa ǝnga sǝra ji tsǝfǝri mai, abari nga hyu sǝn mbǝrsa ǝnga sǝra yu na?”<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">Yesu Sǝmǝna Nji Dubu Tǝfu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matiwu 14:13-21</ref>; <ref loc="MRK 6:30-44">Markusu 6:30-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>Ayukuɗa pǝci kushu, kǝ Yesu tǝrabiya naɗǝ a biyar ya dǝl Galili (najakǝ ngǝ dǝl Tiberiyasu). <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>Ənggau, dlamir nji gangǝu wu nu nyi arya sǝ dǝdǝgur kǝra ndǝ lari ji mǝliya anǝ nji gǝra ngga, ǝnggǝra ji shilǝgǝbiya nda. <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>Kǝ Yesu maˈyi a dar kǝra mau, a ndǝna ji da nggya ǝkkǝˈyi zǝmbǝlma nyiˈyar. <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>Ar pǝci kǝ lardur nǝ vǝlna nǝ njir Yahudiya a ɗari lǝhǝu. <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/>Ənggǝra Yesu hyaˈanakǝr ba ji lari dlamir nji gangǝu a vǝr shili ǝgya ja, kǝ ji nar nyi anǝ Fǝlipǝu, “Əmani nga mǝna sǝn ɗǝlbiya sǝr sǝm kǝra wu sǝn sǝmǝna nji ka?” <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>Yesu yiwa sǝ kǝ ara Fǝlipǝu, aga ja dzǝbiya nyi, arya naja ǝnga kǝrnyi ju sǝn sǝra ju nda mǝl.<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>Kǝ Fǝlipǝu shaɗǝwa nyi, ji na, “Alaga gǝnna nǝ ki ndǝr mǝl thlǝr nǝ zada fa<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">Ar viya dinari gharu mǝthlǝu.</char></note> a sǝn ɗǝlbiya sǝra nji ka sǝn fuwa wu miya nda mai!”<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>Kǝ pathlǝ wu pama zǝmbǝlma Yesu kǝra nju ngga ǝnga Andǝrawusu, zamǝya Simanu Biturusu, na anǝ Yesu, <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>“Kǝja vanyi zǝr kushu ǝnggau ǝnga macikǝl lugu ɗǝfǝ tǝfu ǝnga kalfi mǝthlǝu. Ama mi ngǝ sǝra ju sǝn mǝliya anǝ nji gangǝ ka?”<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>Kǝ Yesu na anǝ zǝmbǝlma nyiˈyar, “Nar nya mau anǝ nji nda nggya gya.” Ar vi kǝ sar aˈyi gangǝu. Kǝ nji patǝ nggya gya, gangǝkura shili zhizhir nda a kari dubu tǝfu. <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>Kǝ Yesu hǝri macikǝla nyi, kǝ ji usaku Hyal, ba ji tǝtǝkǝya nyi anǝ njira aˈyi nggya gya patǝr sǝra ndu yiwu. Abangǝ tsu nga ji mǝliya ǝnga kalfiya nyi. <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>Ayukuɗa ndǝ sǝm ndǝ nyau, kǝ ji nar nyi anǝ zǝmbǝlma nyiˈyar, “Tsǝmiya mau kalar sǝra hiyau ara sǝ a sara wir.” <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>Kǝ zǝmbǝlma nyiˈyar tsǝtsǝmiya kalar sǝra hiyau wu miya nda, ba ndǝ nyanyana tsǝla kumo apǝ mǝthlǝu sara wu macikǝl lugu tǝfu ta.<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>Ənggǝra dlamir nji lari sǝ dǝdǝgur kǝra Yesu mǝliya, kǝ ndǝ na, “Gǝra ǝnga kǝpal, ndǝ ngǝ nabi kǝra duniya wu sǝkǝ shili nyi ta.” <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>Ta Yesu lari ndu sha lagu fǝ nyi aga tǝlǝr nda, ba ji gwaɗǝna nda, ba ji maˈyi sǝ nyi a du mau.<verse eid="JHN 6:15"/></para>
  <para style="s1">Yesu Ɓau A Dar Kǝra ˈYimi</para>
  <para style="r">(<ref loc="MAT 14:22-33">Matiwu 14:22-33</ref>; <ref loc="MRK 6:45-52">Markusu 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>Ənggǝra wagǝ ɗa, kǝ zǝmbǝlma Yesu ˈyar maˈyi a gwu dǝl. <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>Kǝ ndǝ gwa gwu kwambwal aga nda tǝrabiya a vu Kafarnahumu. Ar pǝci kǝra nda a vir maˈyi, kǝ vi ɗa zǝgutu, ama tsu Yesu gǝra shili ǝgya nda. <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>Kǝ dǝl dzǝguya kǝnggǝɗǝ gagaɗau ara culi yambaɗǝ kǝra a vǝr sau ǝnga dǝnama. <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>Ayukuɗa ndǝ ɓar ɓau a ɗa nǝ miyal makǝru, kukuthlǝ ba ndǝ lari Yesu a vǝr shili ǝgya kwambwalǝr nda, ja vǝr ɓau ar kǝra ˈyimi, ba sǝkǝ gǝrahǝya nda gagaɗau. <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>Ama kǝ Yesu na anǝ nda, “Nayi ngau, hya sara hivǝr mai.” <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>Ənggau kǝ ndǝ hǝnggǝri aga nda dlǝwuri nyi a gwu kwambwalǝr nda. Ənggǝrna kǝ kwambwalǝr nda thlǝwa miya dǝl vira nda a vǝr nu a ndari.<verse eid="JHN 6:21"/></para>
  <para style="s1">Nji Biya Aga Gal Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>Ənggǝra vi sa kuɗau, kǝ dlamir nji kǝra hiyau a biyar ya dǝl tsamǝ ri abǝr kwambwal zǝmǝ kǝra hiyau ca ngǝ zǝmbǝlma Yesu ˈyar maˈyi a gwa, ama kǝ ndǝ tsamǝ ri abǝr Yesu aˈyi maˈyi ǝkkǝˈyi nda mai. <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>Kǝ alenyi kwambwalˈyar shili sara wu Tiberiyasu, ndǝ sa taˈyi lǝhǝu ar vira Thlagǝ sǝmǝna nji ǝnga macikǝl kǝra ji fǝnggǝri nyi barka. <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>Ta nji lari abǝr Yesu ǝnga zǝmbǝlma nyiˈyar aˈyi ar vi ta mai, ba ndǝ gu kwambwalˈyar, ndǝ maˈyi a vu Kafarnahumu aga vuwa gal Yesu a vuna.<verse eid="JHN 6:24"/></para>
  <para style="s1">Yesu Ngǝ Macikǝl Nǝ Pi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>Ənggǝra ndǝ biya thlǝwa nyi a biyar ya dǝl, kǝ ndǝ na anǝ nyi, “Malǝmǝ, ǝnuwa nga gǝ shili ǝnga?”<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>Kǝ Yesu shaɗǝwa nda, ji na, “Ənga jiri nga yu na anǝ hyi, hyu gal ɗa aˈyi ara sǝ dǝdǝgur kǝra hyi lari yi mǝliya mai, ama arya macikǝl ta hyi sǝm hyi nyi ǝni ta. <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>Hya sara hǝɗa a vǝr gal sǝr sǝm kǝra wu sǝn dzǝ mai, ama hya mǝl thlǝr nǝ gal sǝr sǝm kǝra gǝra sǝn dzau, ǝnga tsu ju lǝri pi kǝra gǝra kuɗau. Naja kǝ ngǝ sǝr sǝm kǝra Zǝr Ndau, wu sǝn nǝr hyi. Arya naja Zǝr Ndau ngǝ Hyal Tada nǝ nyi dǝnama nǝ mǝl abangau.”<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>Kǝ ndǝ yiwa nyi, ndǝ na, “Mi ngǝ sǝra Hyal wu yiwu ˈya mǝla?”<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>Kǝ Yesu shaɗǝwa nda, ji na, “Kǝja sǝra Hyal wu yiwu hya mǝl, hya mbǝrsa ǝnga ndǝra ji sǝwa.”<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>Kǝ ndǝ yiwa nyi, “Mi ngǝ sǝ dǝdǝgur mǝtsamǝ kǝra gu sǝn mǝliya aga ˈya daɓaga lari ba ˈya hǝnggǝri ǝnga ga? Mi nga gu sǝn mǝliya? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>Əjir ˈya sǝm sǝra nju ngga ǝnga mana a gwa tagǝu, ǝnggǝr kǝra tsǝtsǝfau abǝr, ‘Ji nǝ nda sǝr sǝm sara dǝmǝlmǝ aga nda sǝm.’ ”<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>Kǝ Yesu shaɗǝwa nda, ji na, “Ənga jiri nga yu na anǝ hyi, aˈyi Musa ngǝ nǝ hyi sǝr sǝm sara dǝmǝlmǝ mai, ama dǝɗa ngǝ nǝr hyi sǝr sǝm nǝ jijiri sara dǝmǝlmau. <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>Arya sǝr sǝm nǝ jiri nǝ Hyal ca ngǝ ndǝra shida sara dǝmǝlmǝ ju lǝ pi anǝ duniya.”<verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>Əngwar nda anǝ nyi, “Malǝmǝ, mbar kabangǝkǝ ga dumwa ǝnga lǝ culi najaka sǝr sǝm anǝ ˈya.”<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>Kǝ Yesu nar nda, “Nayi ngǝ macikǝl nǝ pi. Kalar ndǝra shili ǝgya yau, naja tsu ɓǝra nggari wuɓu mai, ǝnga kalar ndǝra hǝnggǝri ǝnga yau, naji wu ɓǝra nggari hili mai. <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>Ama ǝnggǝra yi nar hyi ta, a lar ɗar hyi, ama alaga abangau nahyi hǝnggǝri ǝnga yi mai. <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>Patǝr njira Tada nǝ ɗa, ndu shili ara yau, ǝnga kalar ndǝra shili ara yau, nayi wu kǝdlǝ nyi mai. <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>Arya yi shida sara dǝmǝlmau, aˈyi aga ya sa mǝl sǝra yu yiwu mai, ama sǝra ndǝra sǝwa ɗa wu yiwu. <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>Sǝra ndǝra sǝwa ɗa wu yiwu, ca ngǝ alaga ndǝ zǝmǝ a sara sa wu tsa yau, wu njira ji nǝ ɗa mai, ama aga ya hyaˈana nda sara vir tau, ar pǝcir kuɗiya duniya. <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>Arya sǝra Dǝɗa wu yiwu ngau, ca ngǝ kalar ndǝra fǝr li ar Zǝr, ǝnga ji hǝnggǝri ǝnga Zǝra nyi, ju uya pi gǝra kuɗau, ǝnga tsu yu nda hyaˈana nyi sara vir tau, ar pǝcir kuɗiya duniya.”<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>Kǝ njir Yahudiya dzǝguya ngwungwuni wu pamǝ ar kǝra Yesu ara ji na, “Nayi ngǝ macikǝl kǝra shida sara dǝmǝlmau.” <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>Kǝ ndǝ na, “Aˈyi Yesu ngǝ wa? Zǝr Yusufu, ndǝra ˈyi wu sǝni dǝnyi ǝnga mǝnyi ta wa? Ya, abari nga ju na abǝr, ‘Yi shida sara dǝmǝlma’?”<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>Kǝ Yesu shaɗǝwa nda, ji na, “Piyara mau ngwungwuni wu pama hyi. <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>Ndǝr sǝn shili ǝgya yi aˈyi mai, kǝl ma Tada kǝra sǝwa ɗa tǝɗǝr nyi a shili, nayi tsu yu nda hyaˈana nyi sara vir tau, ar pǝcir kuɗiya duniya. <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>Nji tsǝfǝri wu lǝkakaɗǝ nǝ nabiˈyar abǝr, ‘Patǝkura nda Hyal ngu nda highiɓǝ anǝ nda.’ Kalar ndǝra sǝya nyi himi anǝ Tada ǝnga ji highiɓǝr sǝ ara ja, ju shili ǝgya yau. <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>Ndǝ aˈyi kǝra saya lari Tada mai, kǝl ndǝra hyaˈari sara ara Hyal, naja ngǝ ndǝra saya lar Tada. <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/>Jiri nga yu na anǝ hyi, kalar ndǝra mbǝrsa aˈyi ja ǝnga pi gǝra kuɗau. <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>Nayi ngǝ macikǝl nǝ pi. <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>Əjiya ǝjir hyi sǝm sǝra nju ngga ǝnga mana wu tagǝu, ama ba ndǝ ɓǝra tau. <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>Ama kǝja macikǝl kǝra shida sara dǝmǝlmau, kalar ndǝra sǝmku naji wu tǝ mai. <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>Nayi ngǝ macikǝl nǝ pi kǝra shida sara dǝmǝlmau. Kalar ndǝra sǝm najaka macikǝl, ju nggya ǝnga pi nǝ baˈanuwa. Najaka macikǝl kumǝr dza yi ngau, kǝra yu lǝri aga duniya a uya pi.”<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>Kǝ njir Yahudiya gu kǝpal gagaɗau wu pama nda, ndu na, “Abari ngǝ ndǝ ka sǝn nǝ mǝn kumǝr dza ja aga mǝna sǝma?”<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>Əngwar Yesu anǝ nda, “Ənga jiri nga yu na anǝ hyi, kǝl ma hyi sǝm kumǝr dza Zǝr Ndau ǝnga hyi tǝwari mashi nyi, nahyi aˈyi ǝnga pi wu hyi mai. <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>Kalar ndǝra sǝmku kumǝr dza yau ǝnga ji tǝwari mashi ɗa, aˈyi ja ǝnga pi gǝra kuɗau, ǝnga yu nda hyaˈana nyi sara vir tau, ar pǝcir kuɗiya duniya. <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>Kumǝr dza yi ɗǝfǝ jijiri ngau, ǝnga mashi ɗa sǝr sa jijiri ngau. <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>Kalar ndǝra sǝmku kumǝr dza yau ǝnga ju sa mashi ɗa, ju nggya wu yau ǝnga nayi tsu wu ja. <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>Ənggǝr kǝra Tada mbǝmbǝɗau sǝwa ɗa, arya ja nga yi tsu ǝnga pi, agabangǝ kalar ndǝra fiya ɗa aga sǝr sǝm nyi, ju nda ɗa aˈyi ǝnga pi baˈanuwa arya yau. <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>Najakǝ ngǝ macikǝl kǝra shida sara dǝmǝlmǝ aˈyi ǝnggǝr kǝra ǝjiya ǝjir hyiˈyar sǝm mai. Əjiya ǝjir hyi ndǝ sǝm sǝra nju ngga ǝnga mana ba ndǝ tau, ama kalar ndǝra wu sǝm najaka macikǝl, aˈyi ja ǝnga pi gǝra kuɗau.”<verse eid="JHN 6:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59"/>Yesu nana sǝˈyar kǝ patǝ ar pǝci kǝra ja vǝr highiɓau wu umbwa daɓǝ dzǝ njir Yahudiya wu Kafarnahumu.<verse eid="JHN 6:59"/></para>
  <para style="s1">Zǝmbǝlma Yesu ˈYar Gangǝ <optbreak/> Piyari Nu Nyi</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>Ənggǝra ndǝ nggari abangau, kǝ gangǝu wu pama zǝmbǝlma nyiˈyar na, “Dzadzau ngǝ highiɓǝ kau, wa ngu sǝn dlǝwuri najaka sa?”<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>Yesu ara ju sǝni wu ɗǝfuwa ja abǝr zǝmbǝlma nyiˈyar a vǝr ngwungwuni ar kǝra highiɓǝ kau, kǝ ji na anǝ nda, “Highiɓǝ kǝ ndzana huɗa hyi ya? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>Ya, abari nga hyu nda nggari wu ɗǝfuwa hyi ma hyi lari Zǝr Ndau a vǝr sha a dar vira ja ɗǝɗǝma? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>Mambǝl ngu lǝ pi, sǝ aˈyi kǝra kumǝr dzǝ aga nyi mai. Ndǝr kǝra yi nar hyi kau, nǝ Mambǝl ngau, ba ǝnga nǝ pi tsu. <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>Ama alaga abangau, nji aˈyi kǝra gǝra hǝnggǝri.” Ara tsu kaɗǝu, Yesu wu sǝni wu pama nda njira gǝra hǝnggǝri ǝnga ndǝra wu nda thlǝna hya ja. <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>Kǝ Yesu dumwa ji na anǝ nda, “Ca ngǝ sǝra ɗa yi na anǝ hyi abǝr ndǝr sǝn shili ǝgya yau, aˈyi mai, kǝl ma Dǝɗa nǝ nda lagu.”<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>Ayukuɗa highiɓǝ kau, kǝ zǝmbǝlma nyiˈyar gangǝu sha ara ɓǝra nu nyi.<verse eid="JHN 6:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67"/>Kǝ Yesu yiwa zǝmbǝlma nyiˈyar kumo apǝ mǝthlǝ kau, “Nahyi ma hyu yiwu hya sha ara nu ɗa ya?”<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>Kǝ Simanu Biturusu shaɗǝwa nyi, ji na, “Thlagǝu, a ndǝra wa nga ˈya sǝn maˈya? Nagǝ ngǝ ndǝra ǝnga ndǝr nǝ lǝ pi gǝra kuɗau. <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>A hǝnggǝri ˈya ǝnga a sǝn ˈya abǝr nagǝ ngǝ ndǝ Cici nǝ Hyal.”<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Aˈyi yi caɗǝbiya hyi kumo apǝ mǝthlǝ wa? Ama pathlǝ wu pama hyi shatan ngau.” <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>Ju ndǝr kǝ ar kǝra Yahuda zǝr Simanu Isikarayoti, ara naja ngu nda thlǝna hya ja, kwalaga kǝ, pathlǝ ja wu pama nanda kǝ kumo apǝ mǝthlǝ kau.<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">Zamǝya Yesu ˈYar Aˈyi Hǝnggǝri <optbreak/> Ənga Ja Mai</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>Ayukuɗa kau, ngǝ Yesu ɓǝra ɓǝbiya ɓau wu ˈyiˈyir Galili, ara naji wu yiwu ja maˈyi a vu Yahudi mai, ara njir Yahudiya kǝra a vuna wu gal lagur tsa nyi. <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>Ama ar pǝci kǝra mini nǝ nggya wu kwapatǝ nǝ njir Yahudiya ɗar lǝhǝu, <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>kǝ zamǝya Yesu ˈyar na anǝ nyi, “A ɗar tsaˈa ga piyari vi kǝ ga maˈyi a vu Yahudi, aga zǝmbǝlma ngǝˈyar kǝra a vuna nda lari sǝ dǝdǝgurˈyar kǝra gu mǝl. <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>Ndǝ aˈyi kǝra wu yiwu nja sǝnbiya nyi, ba ja nggya ar ɗǝwa mai. Ta ɗa gu mǝl sǝ dǝdǝgurˈyar kau, ga cabiya kǝrngau anǝ njir duniya.” <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>Arya alaga zamǝ nyiˈyar ǝnga kǝrnda aˈyi hǝnggǝri ǝnga ja mai.<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>Kǝ Yesu shaɗǝwa nda, ji na, “Pǝcir vu ɗa aˈyi ɗa kwatahǝ mai, ama anǝ hyi kalar pǝci a sǝn vu hyi. <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>Njir duniya wu piyari shishir dza hyi mai, ama nayi nga ndǝ piyari shishir dza yau, ara yu nar nda sǝr mǝla nda ɗǝmwaˈyi nga nyi. <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>Nahyi, maˈya mau a ndar vir mini kau. Nayi nǝɗa nayi wu maˈyi kwatahǝ mai, ara pǝci ɗa aˈyi nyabiya dzǝ mai.” <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>Ayukuɗa Yesu nar nda abangau, ba ji ɓǝra sǝkari wu ˈyiˈyir Galili.<verse eid="JHN 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>Ama ayukuɗa zamǝ nyiˈyar maˈyi a ndar vir mini, kǝ Yesu maˈyi tsu ama ar ɗǝwa aˈyi ar babal mai. <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>Njir Yahudiya kǝl gal nyi ar vir miniya nyi, ndu yiwa, ndu na, “Əmani nga ja?”<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>Ar vir mini kau, nji kǝl ndǝr wu pamǝ ar kǝra Yesu ar ɗǝwa. Əngwar alenyi nji, “Ndǝ mǝnahǝ nga ja.”</para>
  <para style="p" vid="JHN 7:12">Əngwar alenyi nji tsu, “Ndǝr ngguta vi nga ja.” <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>Ama ndǝr sǝn ndǝr ar kǝra Yesu ar babal aˈyi mai, ara ndu hivǝr njira nggurǝm nǝ njir Yahudiya.<verse eid="JHN 7:13"/></para>
  <para style="s1">Yesu Highiɓau Ar Vir Mini</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>Ta nja vuri wu hathla mini, kǝ Yesu maˈyi a gwu Ki Hyal, ji gwa mbar highiɓau. <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>Kǝ sǝ kǝ ɗa sǝ dǝdǝgur anǝ njir Yahudiya, ba ndǝ yiwa, “Lagu mani ngǝ ndǝ kǝ highiɓǝr sǝˈyar ka, ya, kǝja naji uya highiɓǝ maya?”<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>Kǝ Yesu shaɗǝwa nda, ji na, “Sǝˈyar kǝ ya vǝr highiɓǝ kau, aˈyi nǝ kǝrɗa ngǝ mai, ama nǝ ndǝra sǝwa ɗa ngau. <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>Kalar ndǝra wu yiwu ja mǝl sǝra Hyal wu yiwu, ju nda sǝnbiya abǝr highiɓǝ ɗa sara ara Hyal nga nyi shili, ama aˈyi nǝ kǝrɗa mai. <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>Njira wu ndǝr aga kǝrnda, thlǝmǝ nga ndu gal anǝ kǝrnda. Ama kalar ndǝra wu ndǝr aga shili ǝnga dlǝvau anǝ ndǝra sǝwa nyi, ndǝ jiri nga ja. Sǝ fati aˈyi wu ja mai. <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>Aˈyi Musa ngǝ nǝ hyi dlaɗǝ wa? Ama alaga ndǝ zǝmǝ aˈyi wu pama hyi kǝra a vǝr ɓǝlari mai. Mi ngǝ ɗa hyu gal tsa ɗa?”<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>Əngwar nja nyi anǝ nyi, “Mambǝl ɗǝmwaˈyi pahǝna liya gǝ ya? Wa ngu gal tsa nga?”<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>Kǝ Yesu shaɗǝwa nda, ji na, “Nayau, yi mǝliya hyi sǝ dǝdǝgur zǝmǝ wacu, ya kǝja hangǝkala hyi a hyaˈari. <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>Musa nǝ hyi dlaɗau ar kǝra thla pǝlzha (alaga kǝ aˈyi naja ngǝ dzǝguya mai, ama ǝjir hyi ˈyar ngau). Kwalaga abangau kǝja hya ɓǝlnar dlaɗa nyi lagur thla pǝlzha anǝ zǝr Pǝcir Ɓǝlsar. <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>Kabangǝkau, a lar hyi abǝr a ɗar tsaˈa nja thlana nyi pǝlzha anǝ zǝr pǝcir Ɓǝlsar aga nja nyabiya dlaɗǝ Musa ar kǝra thla pǝlzha. Ya, ara mi ngǝ ɗa hyu ɗǝfu ǝnga yi ara yi shilǝgǝbiya ndǝ valam pǝcir Ɓǝlsar ara? <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>Hya piyari mǝl numa ga li ga li, ama hya mǝl numa kǝra kakalǝu.”<verse eid="JHN 7:24"/></para>
  <para style="s1">Yesu Ngǝ Kǝrsiti Ya?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>Ar pǝci kǝ ngǝ njir Urshalima wu yiwa kǝrnda, “Aˈyi ndǝ kǝ nga nju gal aga tsa ta wa, ǝndǝga? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>Ya kǝja ja ǝnggau ju ndǝr ar babal, ya nandǝ wu na sǝ anǝ nyi mai. Njira nggurǝmǝr nda ya, ǝndǝga, a hǝnggǝri nda abǝr naja ngǝ Kǝrsiti ya? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>Ama naja nǝ nyi mǝn wu sǝni vira ji shili sara ari, ama ar pǝci kǝra Kǝrsiti nǝ jiri wu nggura shili, ndǝr sǝni vira ju hyaˈari sara ari aˈyi mai.”<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>Yesu tsu ja vǝr highiɓǝ wu ki Hyal, kǝ ji hyaˈana ɗahǝu, ji na, “Jijiri, hyu sǝn ɗa ǝnga vira yi hyaˈari sara ari ya? Nayi shili ar kǝrɗa mai, ama ndǝra sǝwa ɗa, ndǝ jijiri ngau, ama nahyi wu sǝni nyi mai. <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>Ama nayi yiwu sǝni nyi ara nayi sara ara ja nga yau ǝnga naja ngǝ sǝwa ɗa.”<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>Ənggǝra Yesu nana ndǝr kau, kǝ ndǝ gal lagu kǝra nda sǝn mbar nyi. Ama ndǝ aˈyi kǝra tsǝkwari nyi mai, ara pǝci nyi aˈyi ɗa kwatahǝ mai. <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>Alaga abangau, nji gangǝu wu pama nda hǝnggǝri ǝnga ja. Əngwar alenyi nju pama nda, “Ma Kǝrsiti shili ya, ju sǝn sa mǝliya sǝ dǝdǝgur a ndiya kǝra ndǝ kǝ a vǝr mǝl kǝ ya?”<verse eid="JHN 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>Ta njir Farisi nggari nja vǝr ndǝr tsǝtsǝkaˈa ar kǝra Yesu, ba pubu dǝdǝgalˈyar ǝnga njir Farisi sǝwa gaga nǝ Ki Hyal aga nda nda mbar Yesu.<verse eid="JHN 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33"/>Kǝ Yesu nar nda, abǝr, “Pǝcira ya daɓaga nggya ǝkkǝˈyi hyi a hyiri kushu, ba ya dzǝgwa sha a ndǝgya ndǝra sǝwa ɗa a shili. <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>Hyu nda gal ɗa, ama nahyi wu sǝn nǝr ɗa mai, ǝnga vira yu maˈyi a ndari nahyi wu sǝn maˈyi a ndǝna mai.”<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>Kǝ njir Yahudiya na wu pama nda, “Nǝma ngǝ ndǝ kǝ wu yiwu ja maˈya, kǝra mǝn gǝra nda lari nyi ka? Ju yiwu ja maˈyi a ndar ˈyiˈyi njir Gǝrikǝu vira njir Yahudiya tǝtǝlnakǝr a ndar ya? Aga tara ba ja nda highiɓǝ anǝ nda ya? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>Mi ngǝ ɗǝnga nyi ǝnga ndǝr ka, ‘Hyu nda gal ɗa, ama nahyi wu nǝr ɗa mai,’ ǝnga ‘Vira yu nda maˈyi a ndari, nahyi wu sǝn shili ari maya’?”<verse eid="JHN 7:36"/></para>
  <para style="s1">Yesu Ngǝ Mandǝli Nǝ Lǝ Pi</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>Ar jomǝr ndǝla pǝcir mini, kǝra naja ngǝ pǝci kǝra ndiya ǝnga dǝgalǝu, Yesu hyaˈari ji hyaˈana ɗahǝu, ji na, “Ma ndǝra wu nggari hili, bǝgǝ ja shili ja sa tǝwari ˈyimi ara yau. <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>Kalar ndǝra hǝnggǝri ǝnga yau, ǝnggǝr kǝra nji tsǝfǝri wu lǝkakaɗǝ Hyal, abǝr sara wu ta ja ngǝ mandǝli ˈyimir pi wu nda ndǝla.” <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>Ar pǝci kǝra ja vǝr ndǝr ar kǝra mandǝli nǝ lǝ pi kau, Mambǝl Cici nga ja vǝr ndǝr ar kǝri, Mambǝl Cici kǝra njira mbǝrsa wu nda dlǝwuri. Ar pǝci kǝ Mambǝl Cici aˈyi shili kwatahǝ mai ara tsu kadakadarkur Yesu gǝra cabiya dzau.<verse eid="JHN 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>Ənggǝra nji nggari ndǝr Yesu, ba alenyi nji na, “Jijiri ndǝ kǝ naja ngǝ nabi ta mǝna vir sǝkǝ ta.”<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>Alenyi nji tsu wu na, “Ndǝ kǝ naja ngǝ Kǝrsiti.” Əngwar alenyi nji tsu, “Lagu mani ngǝ Kǝrsiti a sǝn shili sara wu Galili ya? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>Lǝkakaɗǝ Hyal kǝra tsǝtsǝfǝ aˈyi nar mǝn abǝr Kǝrsiti wu nda biya sara wu culi gǝ Dawuda wa? Ənga aˈyi ji nar mǝn abǝr sara wu mǝlmǝ Bayitalahami nga ju biya, mǝlmǝ kǝra Dawuda nggya a gwa gwa wa?” <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>Kǝ miya nja nyi tǝkǝbiya dzǝ arya Yesu. <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>Alenyi nji ma ndu yiwu nda mbar nyi, ama ndǝ aˈyi fǝr tsi ar dza ja mai.<verse eid="JHN 7:44"/></para>
  <para style="s1">Ghar Hǝnggǝri Nǝ Njir Yahudiya</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>Ayukuɗa nyi, kǝ njir ɓǝla ki Hyal sha a ndǝgya pubu dǝdǝgalˈyar ǝnga njir Farisi, njira sǝwa nda, ka yiwa nda, ndǝ na, “Mi ngǝ ɗa nahyi shili ǝnga ja maya?”<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>Kǝ njir ɓǝla ki Hyal shaɗǝwa nda, ndǝ na, “Ndǝ aˈyi kǝra saya ndǝrbiya ndǝr ǝnggǝr ndǝ kǝ mai!”<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>Kǝ njir Farisi nar nyi anǝ njir ɓǝla ki Hyal, “Patǝ ǝkkǝˈyi nahyi tsu nga ji nggutana kǝ ya? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>A lar hyi njira nggurǝm ǝnga njir Farisi kǝra hǝnggǝri ǝnga ja ya? Awau! <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>Ama daɓǝr nji kǝra gǝra sǝn sǝ ar kǝra dlaɗǝ Musa, Hyal a shiˈwuna ndar ja.”<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>Nikodimosu, ndǝra shili ǝgya Yesu tsu kaɗǝu ǝnga tsu pathlǝ ja wu pama nda, yiwa, <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>“Mi ngǝ dlaɗǝr mǝn na, aˈyi kǝl nji nggari wu miya ndǝra nju vazau, sǝra ji mǝliya divira nja dzǝgwa mǝlna nyi numa wa?”<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>Əngwar nda anǝ nyi, “Nagǝ ma ndǝr Galili ya? Tsambiya a vu lǝkakaɗǝ nǝ Hyal, ba ga lari abǝr nabi aˈyi kǝra dla sara wu Galili mai.” <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>Kǝ kalar ndǝ maˈyi a ndu ki nyi.<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>Yesu maˈyi a dar mǝ nǝ wur Zayitunu. <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>Kaɗǝ ǝmudlau kǝ Yesu ɓǝra maˈyi a gwu ki Hyal. Nji gangǝ kaɓau a shili ara ja. A guna ba ji gwa uya vir nggya, ji dzǝgwa highiɓǝ anǝ nji. <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>Kǝ malǝmǝ dlaɗǝˈyar ǝnga njir Farisi shili ǝnga mala kǝra nji mbari nyi a vǝr mǝl sǝsukur. Ndǝ sa taˈyina nyi wu hada nda. <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>Kǝ ndǝ na anǝ Yesu, “Malǝmǝ, mala kau, ˈyi mbar nyi a vǝr mǝl sǝsukur. <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>Wu dlaɗau, Musa nar ˈya, abǝr ˈya tsǝya culi mala kǝ ǝnga tsǝka vavaka. Mi nga gǝ na nǝ nga?” <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>Ndu mǝl thlǝr ǝnga najaka yiwa sǝ aga nda nggǝya nyi lǝbam. Ndu yiwu aga nda uya lagu kǝra nda sǝn vazǝya nyi ari.</para>
  <para style="p" vid="JHN 8:6">Ama kǝ Yesu uzha gya, ba ji mbari tsǝfǝ sǝ ǝnga tsa ja a gyiwu ˈyi. <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>Ənggǝra ndǝ dumwa ǝnga yiwa Yesu, ba ji hyaˈari ji na anǝ nda, “Ma ndǝ aˈyi kǝra gǝra ǝnga bikau wu pama hyi, bǝgǝ ja dzǝguya vaka nyi ǝnga tsǝka.” <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>Kǝ Yesu ɓǝra uzha gya, ba ji ɓǝra dumwa ǝnga tsǝfǝ sǝ a gyiwu ˈyi.<verse eid="JHN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9"/>Ənggǝra ndǝ nggari abangau, ba ndǝ dzǝguya maˈyi zǝmǝ zǝmǝu, mbari ar njira nggurǝm baˈanǝ nji kukushu. Ənggau, ba ndǝ piyari Yesu zhizhi nyi ǝnga mala kǝ taˈyu wu mwa nyi a ndǝna. <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>Kǝ Yesu hyaˈari aˈyi taˈyau, kǝ ji yiwa nyi, ji na, “Mala, ǝmani nga nda? Ndǝ aˈyi kǝra mǝliya ngǝ numa wa?”<verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>Kǝ ji shaɗǝwa nyi, ji na, “Malǝmǝ ndǝ aˈyi mai.”</para>
  <para style="p" vid="JHN 8:11">Kǝ Yesu na anǝ nyi, “Alaga nayi ma sǝ aˈyi yu na anǝ ngǝ mai. Maˈyi sǝ ngau, ama ga sara dumwa ǝnga mǝl bikǝ mai.”<verse eid="JHN 8:11"/></para>
  <para style="s1">Yesu Ngǝ Mbǝmbǝl Nǝ Duniya</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>Ar pǝci kǝra Yesu ɓǝra ndǝr anǝ nja nyi, kǝ ji na, “Nayi ngǝ mbǝmbǝl nǝ duniya. Kalar ndǝra wu nu ɗa, naji wu ɓǝ wu kuthlǝ mai, ama ju uya mbǝmbǝl nǝ pi.”<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>Kǝ njir Farisi nar nyi anǝ Yesu, “Gǝ wu lǝ sakida ar kǝra kǝrngau, sakida ngau a sǝn ɗa ǝnga jiri mai.”<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>Kǝ Yesu shaɗǝwa nda, ji na, “Alaga yi lǝr sakida ar kǝra kǝrɗa, sakida ɗa jiri nga nyi, ara yu sǝni vira yi hyaˈari sara ndari ǝnga vira yu maˈyi a ndari. Ama nahyi wu sǝni vira yi shili sara ndari ǝnga vira yu maˈyi a ndari mai. <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>Numar hyi nǝ ndǝndǝkur, ama nǝ ɗa aˈyi abangǝ mai. <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>Ama alaga yu mǝl numa, numa ɗa jiri nga nyi, ara nayi aˈyi zhizhi ɗa mai, ama ndǝra sǝwa ɗa aˈyi ja ǝnga yau. <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>Əngwar dlaɗǝr hyi, ma nji mǝthlǝ lǝr sakida ar kǝra sau, sa nyi a ɗari jiri. <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>Yu lǝ sakida ar kǝra kǝrɗa. Dǝɗa kǝra sǝwa ɗa tsu naja ngǝ nǝ mǝthlǝkura nyi.”<verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>Kǝ ndǝ yiwa nyi, ndǝ na, “Əmani ngǝ dǝnga?”</para>
  <para style="p" vid="JHN 8:19">Əngwar Yesu anǝ nda, “Nahyu sǝn ɗa ǝnga Dǝɗa mai, maja abǝr hyu sǝn ɗa, a sǝnǝr hyi Dǝɗa tsu.” <verse eid="JHN 8:19"/><verse number="20" style="v" sid="JHN 8:20"/>Yesu nana ndǝr kǝ ar pǝci kǝra ja vǝr highiɓau a vu ki Hyal lǝhǝu ar vir ɗǝwa gǝnna kǝra nji tsǝmiya ari. Ndǝ aˈyi kǝra mbari nyi tsu mai ara pǝci nyi aˈyi ɗa kwatahǝ mai.<verse eid="JHN 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>Kǝ Yesu ɓǝra na anǝ nda, “Kǝja yu maˈyi sǝ ɗa, ǝnga hyu nda gal ɗa, ba hya tǝ wu bikǝr hyi. Vira yu maˈyi a ndari, nahyi wu sǝn ndari mai.”<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>Ba sǝ kǝ mǝliya njira nggurǝm nǝ Yahudiya wu yiwa kǝrnda, “Ju nda tsǝya kǝrnyi ya? Ca ngǝ mǝliya ju na, ‘Vira yu maˈyi a ndari nahyi wu sǝn nda mai kǝ ya’?”<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>Ama kǝ Yesu ɓǝra dumwa, ji na, “Nahyi sara gyiwu ˈyi ngau, nayi tsu sara a dǝmǝlmau. Nahyi nǝ duniya ngau, ama nayi aˈyi nǝ duniya mai. <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>Ca ngǝ sǝra ɗa yi na anǝ hyi, hyu nda tǝ wu bikǝr hyi. Ara ma nahyi aˈyi hǝnggǝri ǝnga sǝra yi na ar kǝra kǝrɗa kǝ mai, ǝnga jiri hyu nda tǝ wu bikǝr hyi.”<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>Kǝ ndǝ yiwa nyi, “Wa nga ga?”</para>
  <para style="p" vid="JHN 8:25">Əngwar Yesu anǝ nda, “Kakalǝ ǝnggǝr kǝra yi nar hyi tsu kaɗǝ ta.” <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>Sǝ aˈyi gangǝu kǝra yu sǝn na ar kǝra hyi nǝ mǝl numa. Yu nar nyi anǝ nji sǝra ndǝra sǝwa ɗa wu na anǝ ɗa zhizhi nyi, ǝnga tsu sǝra ju na jiri nga nyi.<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>Nandǝ nggabiya abǝr ar kǝra Dǝnyi nga ju ndǝr anǝ nda mai. <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>Ca ngǝ sǝra mǝliya Yesu nar nda, abǝr, “Ar pǝci kǝra hyu nda hari Zǝr Ndau a di, ar pǝci ta nga hyu nda nggabiya abǝr nayi ndǝra yu na, nayi ngau. Nayi tsu yu mǝl sǝ kǝrɗa mai, ama yu highiɓǝ sǝra Dǝɗa highiɓǝr ɗa. <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>Ndǝra sǝwa ɗa aˈyi ja ǝnga yau, naji piyari ɗa zhizhi ɗa mai, ara cumu yu mǝl sǝra wu pina huɗa ja.” <verse eid="JHN 8:29"/><verse number="30" style="v" sid="JHN 8:30"/>Ar pǝci kǝra Yesu nana sǝˈyar kau, nji gangǝu hǝnggǝri ǝnga ja.<verse eid="JHN 8:30"/></para>
  <para style="s1">Jirkur Kǝra Wu Mǝliya Ndǝ Kambau</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>Kǝ Yesu nar nyi anǝ njir Yahudiya kǝra hǝnggǝri ǝnga ja, “Ma hyi dumwa ǝnga sǝɓǝ highiɓǝ ɗa ǝnga jiri, nahyi ngǝ zǝmbǝlma ɗaˈyar nǝ jijiri. <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>Hyu nda sǝnbiya jiri, jira nyi tsu wu nda pǝlna hyi.”<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>Kǝ ndǝ shaɗǝwa nyi, ndǝ na, “Naˈya culi gǝ Ibrahimu ngau, naˈya sara vǝr ɗa mafa ndǝ mai. Ya, mi ngǝ ɗa gu na, ba nja pǝlna ˈya?”<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>Kǝ Yesu shaɗǝwa nda, ji na, “Jijiri nga yu na anǝ hyi, kalar ndǝr mǝl bikau, mafa bikǝ nga ja. <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>Mafa aˈyi wu sǝn ɗa zǝr ki parangǝ mai, ama zǝr kǝra nji ya wu ki, zǝr kiya nyi nga ja baˈanuwa. <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>Ma sǝn ɗa ba Zǝra nyi pǝlna hyi, a ɗar hyi pǝpǝl ǝnga jiri. <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>Wu sǝn yi abǝr nahyi culi gǝ Ibrahimu ngau, ama kǝja hyu gal lagur tsa ɗa, ara vir fiya ndǝr ɗa aˈyi wu ɗǝfuwa hyi mai. <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>Yu na anǝ hyi sǝra yi lari ara Dǝɗa, ama nahyi, hyu mǝl sǝra hyi nggari ara dǝrhyi.”<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>Kǝ ndǝ shaɗǝwa nyi, ndǝ na, “Ibrahimu ngǝ dǝrˈya.”</para>
  <para style="p" vid="JHN 8:39">Kǝ Yesu shaɗǝwa nda, ji na, “Maja abǝr wazha Ibrahimu nga hyi, a mǝlǝr hyi sǝra Ibrahimu mǝlna. <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>Nayi ndǝ ngau, ndǝr na sǝra jiri kǝra yu nggari sara ara Hyal, ama kǝja hyu yiwu hya tsǝya ɗa. Ya, kǝja Ibrahimu aˈyi mǝl culi sǝ ǝnggǝr kǝ mai. <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>Sǝra dǝrhyi mǝlna ca nga hya vǝr mǝl.”</para>
  <para style="p" vid="JHN 8:41">Ama kǝ njir Yahudiya na, “Naˈya aˈyi wazha mandzagwa mai, tada kǝra ara ˈya Hyal nga kǝrnyi wacu.”<verse eid="JHN 8:41"/></para>
  <para style="s1">Wazha Shatan</para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>Əngwar Yesu anǝ nda, “Maja abǝr Hyal ngǝ dǝrhyi, hyu cabiya ɗa yiwukur, ara yi shili sara ara Hyal. Ya kǝja yi ǝnggau, nayi shili ar kǝrɗa mai, ama naja ngǝ sǝwa ɗa. <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>Ara mi nga hyi gǝra nggabiya ndǝr ɗa? Ara nahyi aˈyi wu nggari sǝra yu na mai. <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>Nahyi nǝ dǝrhyi shatan ngau, ǝnga hyu yiwu hya mǝl sǝra dǝrhyi wu yiwu. Tsu mudlau naja ndǝr tsa ndǝ nga ja, ǝnga naji wu sǝɓǝ jiri mai, arya jiri aˈyi wu ja mai. Ar pǝci kǝra ji thlar fati, miya gǝ nda nga ji nana, ara naja ndǝr thla fati ngau, ǝnga dǝya fati. <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>Ama ara ma yi nar hyi jiri, nahyi wu hǝnggǝri ǝnga yi mai! <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>Wu pama hyi ya, wa ndǝra wu sǝn vazǝya ɗa ǝnga bika? Ma yi nar hyi jiri, mi ngu ɗa nahyi wu hǝnggǝri ǝnga yi maya? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>Kalar ndǝra nǝ Hyal ngau, ju sǝhimi sǝra Hyal wu na. Sǝra ɗa nahyi wu sǝhimi nyi mai, ara nahyi aˈyi nǝ Hyal mai.”<verse eid="JHN 8:47"/></para>
  <para style="s1">Yesu Dǝgal A Mwara Ibrahimu</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>Njir Yahudiya shaɗǝwa nyi, ndǝ na, “Aˈyi jiri ǝnga ˈya, ǝnggǝra ˈyi na abǝr nagǝ ndǝr Samariya kǝra nyinyau ǝnga mambǝl ɗǝmwaˈyi wa?”<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>Əngwar Yesu anǝ nda, “Nayi aˈyi yi ǝnga mambǝl ɗǝmwaˈyi mai. Yu ha kǝra Dǝɗa, ama nahyi wu ha kǝra yi mai. <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>Nayi ngu gal fal anǝ kǝrɗa mai, ama ndǝ aˈyi kǝra wu gal anǝ ɗa, naja ngǝ ndǝr mǝl numa. <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>Jijiri ǝnga yu na anǝ hyi, ma ndǝra sǝɓiya ndǝr ɗa, naji wu tǝ mai.”<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>Ar kǝra ndǝr kau, ǝngwar njir Yahudiya anǝ nyi, “Kabangǝkǝ ja, a sǝn ˈya abǝr nagǝ aˈyi gǝ ǝnga mambǝl ɗǝmwaˈyu! Ibrahimu ǝnga kǝrnyi a tǝri ja ba nabiˈyar pamǝpamǝ tsu, ama ǝngwar gau, ‘Kalar ndǝra wu hǝnggǝri ǝnga ndǝr ɗa naji wu tǝ mai.’ <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>Naga ndiya dǝrˈya Ibrahimu ya? Naja ma a tǝr ja ǝnga tsu abangau ngǝ nabiˈyar. Ma gǝ nggani wa nga ga?”<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>Əngwar Yesu, “Ma yu lǝ kadakadarkur anǝ kǝrɗa, kadakadarkur ɗa aˈyi ar viya vanyi sǝ mai. Dǝɗa, kǝra hyu na abǝr Hyalǝr hyi ngau, naja ngu lǝ kadakadarkur anǝ ɗa. <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>Kwalaga kǝ nahyi wu sǝn nyi mai kau, nayau, yu sǝn nyi. Ma yi na, nayi wu sǝn nyi mai, a ɗar yi ndǝr thla fati ǝnggǝr nahyi. Ama nayau, yu sǝn nyi ǝnga yu ɓǝlar ndǝr nyi. <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>Dǝrhyi Ibrahimu a cagulir ja gagaɗau aga ja lari pǝci ɗa, a lar ja ǝnga huɗǝ pipida gagaɗau.”<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>Əngwar njir Yahudiya anǝ nyi, “Nagǝ ndǝra gǝra kar fa tǝfukumunyi, gu na abǝr a lar gǝ Ibrahimu ya?”<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>Əngwar Yesu, “Jijiri nga yu na anǝ hyi, kadivira nja ya Ibrahimu aˈyi yau.” <verse eid="JHN 8:58"/><verse number="59" style="v" sid="JHN 8:59"/>Ənggǝra ndǝ nggar ndǝr kau, ba ndǝ ɗǝɗǝmǝri tsǝka ndu yiwu nda vavakǝya nyi, ama kǝ Yesu gwaɗǝnakǝr. Ba ji biya sara wu ki Hyal.<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">Yesu Pahǝna Liya Ndǝra Nji <optbreak/> Yabiya Lǝfau</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>Ənggǝra Yesu a vǝr tǝrabiya, kǝ ji lari vanyi ndǝ kǝra nji yabiya nyi lǝfau. <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>Kǝ zǝmbǝlma nyiˈyar yiwa nyi, “Malǝmǝ, bikǝ wa ngǝ mǝliya nji yabiya ndǝ kǝ lǝfa? Bikǝ nyi ǝndǝga nǝ njir ya nyi ya?”<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>Kǝ Yesu shaɗǝwa nda, “Aˈyi bikǝ nyi mai ǝnga aˈyi bikǝ njir ya nyi tsu mai, ama sǝ kǝ ɗarkǝr aga dǝnama nǝ Hyal a cabiya kǝr wu nggyabiya nyi. <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>A ɗari tsaˈa mǝna dumwa ǝnga mǝl thlǝr nǝ ndǝra sǝwa ɗa, ma tsu puci, ara vuˈyi wu shili, kǝra ndǝ aˈyi kǝra sǝn mǝl thlǝr mai. <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>Ma tsu yi aˈyi wu duniya, nayi ngǝ mbǝmbǝl nǝ duniya.”<verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>Ayukuɗa ji nana abangau, kǝ ji tǝfǝr tuli a gyiwu ˈyi, ba ji dzǝguri ˈyiˈya nyi, ba ji tǝɓǝri, ji ɓǝsiya ar liya nda nyi. <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>Əngwar ja anǝ nda nyi, “Maˈyi ga gwa cina bama gau a gu faˈa Sǝliwamu.” (Ca ngǝ Sǝsau). Kǝ ndǝ kǝ maˈyi ji gwa cina bama ja, kǝ ji sha shili ju lar sau.<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>Kǝ tǝwul nyiˈyar ǝnga njira tsǝliya lari nyi a vǝr kǝdi ɗǝɗǝmǝu, na, “Aˈyi ndǝ kǝ ngu nggya ǝnggau, ju kǝdi ta wa?” <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>Əngwar alenyi nji, “Naja ngau.”</para>
  <para style="p" vid="JHN 9:9">Əngwar alenyi nji tsu, “Awau, ndǝr pa nyi ngau.”</para>
  <para style="p" vid="JHN 9:9">Ama, naja ǝnga kǝrnyi dumwa ǝnga na, “Nayi ngau pakatǝu!”<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>Kǝ ndǝ yiwa nyi, ndǝ na, “Ya, lagu mani ngǝ liya gǝ kǝ paha?”<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>Əngwar ja, “Ndǝ kǝ nju ngga ǝnga Yesu kau, ngǝ dzǝgur ˈyiˈyi ǝnga tuli, kǝ ji ɓǝsiya ar liya yau. Kǝ ji na anǝ ɗa, ‘Maˈyi a gu faˈa Sǝliwamu ga gwa cina bama gau.’ Ba yi maˈyi, yi gwa cina bama, ba yi lar sau.”<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>Əngwar nda anǝ nyi, “Əmani ngǝ ndǝ ka?”</para>
  <para style="p" vid="JHN 9:12">Əngwar ja, “Nayi wu sǝni mai.”<verse eid="JHN 9:12"/></para>
  <para style="s1">Njir Farisi Yiwabiya <optbreak/> Lagu Kǝra Ndǝ Kǝ Uya Lar Sau</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>Kǝ ndǝ hǝri ndǝra nji yabiya lǝfǝ ta a ndǝra njir Farisi. <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>Arya pǝcir Ɓǝlsar ngǝ Yesu tǝfǝr tuli kǝra ji dzǝgur ˈyiˈyi ǝni, kǝ ji pahǝna liya ndǝ kau. <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>Agabangau, kǝ njir Farisi tsu yiwa nyi, lagu kǝra ji uya, ju lar sau. Əngwar ja anǝ nda, “Ji ɓǝsiya tsǝkwaɓǝ kǝra ji dzǝguri ar liya yau. Yi maˈyi yi gwa cina bama yau, ba yi lar sau.”<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>Əngwar alenyi njir Farisi, “Ndǝ kǝ aˈyi sara ara Hyal mai, arya naji wu ɓǝla pǝcir Ɓǝlsar mai.”</para>
  <para style="p" vid="JHN 9:16">Ama alenyi nju na, “Abari ngǝ ndǝr bikau a sǝn mǝliya najaka sǝ dǝdǝgura?” Kǝ ndǝ tǝkǝbiya dzau.<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>Kǝ ndǝ ɓǝra shabiya dzǝ a ndǝgya ndǝ lǝfǝ ta, ndǝ na, “Mi sǝra gu na ar kǝra ndǝ ka, kǝja liya gǝ nga ji pahǝna?”</para>
  <para style="p" vid="JHN 9:17">Əngwar nda nyi, “Naja nabi ngau.”<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>Njira nggurǝm nǝ Yahudiya, aˈyi hǝnggǝri abǝr ndǝ kǝ ɗǝɗǝmǝ lǝfǝ nga ja mai, kǝl ta ndǝ sǝwa nja nggar nda njir ya nyi. <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>Ndǝ sa yiwa nda, “Zǝr hyi ngǝ ndǝ kǝ ya? Naja nga hyi na nji ya nyi lǝfǝ ta ya? Ya, lagu mani nga ju lar sǝ kabangǝkǝ ka?”<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>Əngwar njir ya nyi anǝ nda, “ˈYi wu sǝni abǝr zǝr ˈya ngau, lǝfǝ nga nji ya nyi. <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>Ama ǝnggǝra ju lar sǝ kabangǝkau, ǝnga tara wa ngǝ pahǝna liya ja, naˈyu sǝni mai. Yiwa nya mau, fa nyi a kari aga ja ndǝr ǝnga kǝrnyi.” <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>Njir ya nyi ndǝr abangau ara hivǝr njira nggurǝm nǝ Yahudiya, ara ndǝ mbiya miya abǝr kalar ndǝra hǝnggǝri abǝr Yesu ngǝ Kǝrsiti, ba nja kǝdlǝbiya nyi sara wu vir daɓǝ dzǝ njir Yahudiya. <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>Ca ngǝ sǝra ɗa njir ya nyi na, “Fa nyi a kari, hya yiwa nyi.”<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>Kǝ ndǝ ɓǝra ngga ndǝra nji yabiya lǝfau nǝ mǝthlǝkura nyi, ndǝ na anǝ nyi, “Nana sǝra jiri wu mwar Hyal. Naˈya ˈyi wu sǝni abǝr ndǝ kau, ndǝr bikǝ ngau.” <verse eid="JHN 9:24"/><verse number="25" style="v" sid="JHN 9:25"/>Kǝ ji shaɗǝwa, ji na, “Tara ndǝr bikǝ nga ja ǝnga ndǝr bikǝ nga ja mai, nayi wu sǝni mai. Sǝra yu sǝni ca ngǝ ɗǝɗǝmǝ lǝfǝ nga yau, ama kabangǝkǝ yu lar sau.”<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>Kǝ ndǝ ɓǝra yiwa nyi, ndǝ na, “Mi nga ji mǝliya nga? Lagu mani nga ji pahǝna liya ga?”<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>Kǝ ji shaɗǝwa nda, ji na, “A nar hyir yi tsu kaɗǝu, ama nahyi sǝhimi mai. Mi ngǝ ɗa hyu ɓǝra yiwa ɗa? Hyu yiwu hya ɗa zǝmbǝlma nyiˈyar ǝtsu ya?”<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>Kǝ ndǝ nggǝnggǝlna nyi, ndǝ na, “Nagǝ ngǝ zǝmbǝlma nyi sǝ ngau, ama naˈya zǝmbǝlma Musa nga ˈya. <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>Wu sǝn ˈya abǝr Hyal ndǝr ǝnga Musa, ama ndǝ kau, naˈyu sǝni vira ji shili sara ndari mai.”<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>Kǝ ji shaɗǝwa nda, ji na, “Kǝja mǝ sǝ dǝdǝgur ja! Nahyi sǝni vira ji shili sara ndari mai, ama kǝja ja pahǝnar liya yau! <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>Namǝn wu sǝni abǝr Hyal aˈyi wu nggari kǝdi nǝ njir bikǝ mai. Ama ju sǝhimi kǝdi nǝ njira wu dlǝvǝ nyi ǝnga ndu mǝl sǝra ju yiwu nda mǝl. <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>Mbar dzǝgwar duniya, ndǝ aˈyi kǝra saya nggari abǝr nji pahǝna liya ndǝra nji ya nyi lǝfǝ mai. <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>Ma ndǝ kǝ aˈyi sara ara Hyal mai, sǝ aˈyi ju sǝn mǝliya mai.”<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>Kǝ ndǝ shaɗǝwa nyi, ndǝ na, “Nagǝ ndǝra nji yabiya wu bikau, gu yiwu ga highiɓau anǝ ˈya?” Ba ndǝ kǝdlǝbiya nyi a biya sara wu umbwa daɓǝ dzǝ njir Yahudiya.<verse eid="JHN 9:34"/></para>
  <para style="s1">Lǝfǝkur Nǝ Mambǝl</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>Yesu nggari abǝr ndǝ kǝdlǝbiya nda nyi a biya. Ba ji thlǝwa nyi, ji yiwa nyi, “A hǝnggǝr gǝ ǝnga Zǝr Ndǝ ya?”<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>Əngwar nda nyi anǝ nyi, “Wa nga ja, Malǝmǝ? Nar ɗa aga ya hǝnggǝr ǝnga ja.”<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>Kǝ Yesu shaɗǝwa nyi, “A lar nyir gau, naja nga vǝr ndǝr ǝnga gǝ kau.”<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>Kǝ ndǝ kǝ na, “Thlagǝu, a hǝnggǝr yau,” ba ji dlǝvǝ nyi.<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>Əngwar Yesu anǝ nyi, “Aga numa nga yi shili wu duniya, aga njira lǝfau nda lar sau ǝnga njira wu nggani ndu lar sǝ tsu nda ɗa lǝfau.”<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>Ənggǝra alenyi njir Farisi kǝra ǝnga ja nggari abangau, kǝ ndǝ na anǝ nyi, “Mi? Gu yiwu ga na abǝr naˈya ma, nji lǝfǝ ya?”<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>Əngwar Yesu anǝ nda, “Maja abǝr lǝfǝ nga hyi wacu, nahyi aˈyi ǝnga bikǝ mai. Ama ta hyi na abǝr hyu lar sau, ca ngǝ ɗa bikǝr hyi a nggyari ǝnga hyi.<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">Karapau Ar Kǝra Ndǝr Ɓǝla <optbreak/> Ənga Dlǝma Tǝmahǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>“Jiri nga yu na anǝ hyi, kalar ndǝra aˈyi vu dlǝma lagu miyar gwa nyi mai, ama ji vu lagu ya dlǝma, naja ndǝr hǝl ngau ǝnga ndǝr ɗa lagu. <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>Ndǝra vu lagu miyar gwa nǝ dlǝma, naja ngǝ ndǝr ɓǝla tǝmahǝu. <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>Ndǝr ɓǝla dlǝma wu pahǝna nyi miyar gwa nǝ dlǝma, ba ja vwau. Tǝmahǝ tsu ndu sǝya nyi himi. Ju ngga tǝmahǝ nyi ǝnga thlǝmǝr nda, ba ja lǝbiya nda a biya. <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>Ayukuɗa ji faˈabiya tǝmahǝ nyi a biya patǝu, ba ja maˈyi a dumwar nda, ba tǝmahǝ nyi a nu nyi ara ndu sǝn ɗaha ja. <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>Ama nandǝ wu nu mǝthlǝpi mai, kǝl ma, nda hwi ara ja, ara nandǝ wu sǝn ɗaha mǝthlǝpi mai.” <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/>Yesu nar nda najaka karapau, ama nandǝ nggabiya sǝra ju na anǝ nda mai.<verse eid="JHN 10:6"/></para>
  <para style="s1">Yesu Ndǝr Ɓǝla Mǝnahǝu</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>Agabangau, kǝ Yesu ɓǝra na anǝ nda, “Yi wu nar hyi jirkura nyi, nayi ngǝ miya lagu vu dlǝma tǝmahǝu. <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>Patǝr njira dla divira yi shili, njir hǝl ǝnga njir ɗa lagu ngau, ama tǝmahǝ aˈyi sǝya nda himi mai. <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>Nayi ngǝ miya lagu vu dlǝma, kalar ndǝra vu lagu ɗa ju uya mbǝɗau. Ju vwau ǝnga ju biya, ba ja biya uya vir sǝm sǝr sǝm. <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>Ndǝr hǝl wu shili wacu aga sa hǝl ǝnga sa tsa ba aga sa ndza sau. Ama nayi yi shili aga nda uya pi, pi kǝra nyinyi gagaɗau.<verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>“Nayi ngǝ ndǝr ɓǝla kǝra mǝnahǝu. Ndǝr ɓǝla kǝra mǝnahǝu wu lǝr piya ja arya tǝmahǝ nyi. <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>Ndǝra nji hǝri aga ɓǝla, naja aˈyi thlagǝr tǝmahǝ mai. Ma ji lari ufwar vuwa a vǝr shili, ba ja hwinakǝr ja piyari nda. Ba ufwar vuwa kakathlǝr tǝmahǝu ba ja tǝtǝlna kǝra nda. <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>Ndǝra nji hǝr kau, ju hwinakǝr ara tǝmahǝ aˈyi nǝ nyi mai, ǝnga tsu dzaˈwu nyi aˈyi ǝnga nda mai.<verse eid="JHN 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14"/>“Nayi ngǝ ndǝr ɓǝla kǝra mǝnahǝu, yu sǝn tǝmahǝ ɗa ǝnga tǝmahǝ ɗa wu sǝn ɗa tsu. <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>Kakalǝ ǝnggǝr kǝra Dǝɗa wu sǝn ɗa, nayi tsu yu sǝn Dǝɗa. Nayi tsu yu lǝri piya yau, arya tǝmahǝ ɗa. <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/>Aˈyi yi ǝnga alenyi tǝmahǝ kǝra aˈyi nda wu dlǝma kǝ mai. Kǝl ya shili ǝnga nda tsu. Nanda ma ndu nda sǝhimi sǝra yu na, ǝnga ndu ɗa tsǝkǝˈyi zǝmǝu ǝnga ndǝr ɓǝla zǝmǝ pir. <verse eid="JHN 10:16"/><verse number="17" style="v" sid="JHN 10:17"/>Sǝra ɗa Dǝɗa wu yiwu ɗa ngau, ara yu lǝr piya yau, aga ya ɓǝra shabiya nyi a shili wayu. <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>Ndǝr sǝn hǝbiya piya yi aˈyi mai, kǝl nayi nga sǝn lǝr sǝ ɗa. Dǝnama nǝ lǝri ǝnga shabiya nyi a shili aˈyi ara yau. Dlaɗǝ kǝra Dǝɗa lǝri anǝ ɗa ngau.”<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>Arya ndǝr kǝ ngǝ njir Yahudiya ɓǝra tǝkǝbiya dzǝ wayu. <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>Nji gangǝu wu pama nda wu na, abǝr, “Naja ǝnga mambǝl ɗǝmwaˈyu, ǝnga ju thlǝkau. Mi ngǝ ɗa hyu sǝya nyi himiya?”<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>Ama ǝngwar alenyi nji, “Ndǝr kǝ aˈyi ndǝr nǝ ndǝra ǝnga mambǝl ɗǝmwaˈyi ngǝ mai. Ndǝra ǝnga mambǝl ɗǝmwaˈyi a sǝn pahǝna liya ndǝ lǝfǝ ya?”<verse eid="JHN 10:21"/></para>
  <para style="s1">Njir Yahudiya Nggǝl Ara Hǝnggǝri <optbreak/> Ənga Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>Kǝ pǝcir mini nǝ fǝ barka ar kǝra Ki Hyal shili, a vu Urshalima. Ar pǝcir fwahǝu ngǝ sǝkǝ ɗarkǝr. <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>A gwu Ki Hyal kau, Yesu a vǝr ɓǝɓau ar vira nju ngga ǝnga dalaɓagǝu nǝ Solomanu. <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>Kǝ njir Yahudiya kǝra zǝwari nyi na, “Baˈanuwa nga gu piyari ˈya wu kuthla? Ma nagǝ ngǝ Kǝrsiti nar ˈya ar babal.”<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>Kǝ Yesu shaɗǝwa nda, ji na, “A nar hyir yau, ama nahyi hǝnggǝr nǝ mai. Sǝ dǝdǝgur kǝra ya vǝr mǝl wu thlǝmǝr Dǝɗa nga vǝr ndǝr ar kǝra yau. <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>Ama nahyi hǝnggǝr ǝni mai ara nahyi aˈyi hyi tǝmahǝ ɗa mai. <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>Tǝmahǝ ɗa ndu sǝhimi ɗaha yau. Yu sǝn nda ǝnga ndu nu ɗa. <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>Yu nǝ nda pi gǝra kuɗau, ǝnga nandǝ wu sa mai. Ndǝr sǝn mbǝliya nda sara wu tsa yi aˈyi tsu mai. <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>Dǝɗa kǝra nǝ ɗa nda a ndiyar kalar ndǝ ǝnga dǝgalǝu. Ndǝr sǝn mbǝliya nda sara wu tsa ja aˈyi mai. <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>Nayi ǝnga Dǝɗa nji zǝmǝ nga ˈya.”<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>Kǝ njir Yahudiya ɓǝra faˈari tsǝka aga nda tsǝya nyi ǝnga tsǝka vavaka. <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>Kǝ Yesu na anǝ nda, “A canǝ hyir yi sǝ dǝdǝgur gangǝ gagaɗau sara ara Dǝɗa, arya mani wu pama nda nga hyu gal tsa ɗa ǝnga tsǝka vavaka ka?”<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>Əngwar njir Yahudiya anǝ nyi, “Naˈyu gal tsa ngau ǝnga tsǝka vavaka arya sǝ mǝnahǝu kǝra gǝ mǝlna kǝ mai, ama arya ndǝr nǝ diɗa Hyal kǝra gu na. Nagǝ ndǝ ngǝ wacu, ama gu yiwu ga kakalǝr kǝrngau ǝnga Hyal.”<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>Yesu shaɗǝwa nda, ji na, “Aˈyi tsǝtsǝfǝ nga nyi wu dlaɗǝr hyi, abǝr Hyal na, ‘Nayi na, nahyi hyalˈyar ngǝ’ wa? <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>Wu sǝn mǝn abǝr ndǝr tsǝtsǝfǝ nǝ Hyal wu thla fati mai. Ma Thlagǝ na abǝr njira dlǝwuri ndǝr nyi ‘hyalˈyar nga nda,’ <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>ara mi nga hyu ɗa ɗa abǝr yi ndǝr nǝ diɗa Hyal, arya yi na, ‘Zǝr Hyal nga ya’? Nayi ndǝra Tada caɗǝbiya, aga ja sǝwa ɗa a shili wu duniya. <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>Ma aˈyi sǝra Dǝɗa wu mǝl nga yu mǝl mai, hya sara hǝnggǝri ǝnga yi mai. <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>Ama ma sǝra Dǝɗa wu mǝl nga yu mǝl, alaga nahyi gǝra hǝnggǝri ǝnga yau, hya hǝnggǝri ǝnga sǝ dǝdǝgur kǝra yu mǝl. Lagu kau, nga hyu sǝni ǝnga nggabiya abǝr Dǝɗa wu yau ǝnga nayi wu Dǝɗa.”<verse eid="JHN 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39"/>Kǝ ndǝ ɓǝra nǝrdzau aga nda mbar Yesu, ama kǝ ji mbǝliya dzǝ sara wu tsa nda.<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>Kǝ Yesu ɓǝra sha a biyar ya dǝl Urdǝnu, a biyar vira Yahwana dzǝguya mǝl baɓǝtizǝma ari. A ndǝna nga ji nda nggya. <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>Kǝ nji gangǝu nu nyi a shili. Kǝ ndǝ dumwa ǝnga na, “Alaga kǝ Yahwana aˈyi saya mǝliya sǝ dǝdǝgur kǝ mai kau, ama kalar sǝra ji nana ar kǝra ndǝ kǝ jiri nga nyi patǝu.” <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>Ar vi kǝ tsu ngǝ nji gangǝ hǝnggǝri ǝnga Yesu.<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">Tǝr Liyazaru</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>Vanyi ndǝ aˈyi kǝra nja ngga ǝnga Liyazaru kǝra ɗa gǝra ngga. Naja sara wu mǝlmǝ Bethlani, mǝlmǝ gǝ Maryamu ǝnga kwamǝ nyi Marthla. <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>Maryamu kau, kǝra zamǝ nyi Liyazaru gǝra ngga kau, naja ngǝ saya pǝnggǝr nyi mal kisǝ anǝ Thlagǝ ǝnga ji ɓǝsiya hya ja ǝnga shishir kǝra ja. <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>Kǝ kwamǝ nyiˈyar sǝwa nyi cama anǝ Yesu, ndǝ na, “Thlagǝu, ndǝ ta gu yiwu ta aˈyi ngga mai.”<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>Ənggǝra Yesu nggari abangau, ba ji na, “Shilǝgǝ kǝ wu tsǝya nyi mai, ama aga ja shili ǝnga kadakadarkur anǝ Hyal ǝnga anǝ Zǝr nyi.” <verse eid="JHN 11:4"/><verse number="5" style="v" sid="JHN 11:5"/>Ara yiwu dzǝ aˈyi ara Yesu anǝ Maryamu ǝnga Marthla ba zamǝr nda Liyazaru. <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>Ama alaga abangau ta ji nggari abǝr Liyazaru aˈyi ngga mai, kǝ ji ɓǝra nggya nǝ pida mǝthlǝ ar vi ta.<verse eid="JHN 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 11:7"/>Kǝ ji dzǝgwa na anǝ zǝmbǝlma nyiˈyar, “Bǝgǝ mǝna ɓǝra sha a vu ˈyiˈyir Yahudi.”<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>Kǝ zǝmbǝlma nyiˈyar na anǝ nyi, “Malǝmǝ, aˈyi ɓǝliya sar mai ngǝ njir Yahudiya wu gal nda tsi ngau ǝnga tsǝka vavaka, ya, ga ɓǝra yiwu ga sha a vuna tsu ya?”<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>Kǝ Yesu shaɗǝwa nda, “Aˈyi saka kumo apǝ mǝthlǝ ngu pǝkǝ wa? Ndǝ a sǝn thlǝr hi ǝpuci ma ju ɓǝ mai, ara ju lar sǝ camǝ ara mbǝmbǝl nǝ pǝci. <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>Kǝl ma ji ɓǝ ǝvuˈyi nga ju thlǝr hi, ara mbǝmbǝl aˈyi mai.”<verse eid="JHN 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11"/>Ayukuɗa Yesu nana ndǝrˈyar kau, ba ji dumwa ji na, “Bazhir mǝn Liyazaru a gwari wu ghanyi, ama maˈyi nga yi aga ya nda hyabiya nyi sara wu ghanyi.”<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>Əngwar zǝmbǝlma nyiˈyar anǝ nyi, “Thlagǝu, ma ju ghanyi, ju nda ɗa jamǝu.” <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/>Sǝra Yesu wu na abǝr Liyazaru a tǝri, ama ma zǝmbǝlma nyiˈyar wu nggani ghanyi nǝ ɓǝlsar nga ja a gwa.<verse eid="JHN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14"/>Kǝ ji dzǝgwa nar nda ar babal, abǝr, “Liyazaru a tǝri. <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>Nyinyi nga yi ǝnga huɗǝ pipida arya aˈyi yi a ndǝna mai, aga hya mbǝrsa. Ama bǝgǝ mǝna maˈyi a ndǝgya ja.”<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>Kǝ Toma, ndǝra nju ngga ǝnga ɓili, nar nyi anǝ alenyi zǝmbǝlmaˈyar, “Bǝgǝ mǝna maˈyi mǝna vuwa tǝ ǝnga ja.”<verse eid="JHN 11:16"/></para>
  <para style="s1">Yesu Fiya Nyi Ɗǝfu Anǝ Maryamu <optbreak/> Ənga Marthla</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>Ənggǝra Yesu shili, ba ji sa nggari abǝr Liyazaru a pidar ja foɗǝ wu hu. <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>Bethlani lǝhǝ nga ja wu dzǝr Urshalima, aˈyi kari miyal mǝthlǝ mai. <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>Njir Yahudiya gangǝu ngǝ shili aga nda sa pǝlna pǝli anǝ Marthla ǝnga kwamǝ nyi Maryamu arya tǝr zamǝr nda Liyazaru.<verse eid="JHN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20"/>Ənggǝra Marthla nggari abǝr Yesu a vǝr shili, ba ji maˈyi, ji biya dlǝwuri nyi, ama Maryamu nǝ nyi, ba ji nggya wu ki. <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>Kǝ Marthla nar nyi anǝ Yesu, “Thlagǝu, ma ja abǝr gǝ nda ɗa aˈyi ǝnggau, zamǝ ɗa aˈyi tǝ mai. <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>Alaga kabangǝkau, yu sǝni, abǝr, Hyal wu sǝn nǝ ngau sǝra gu kǝdi ara ja.”<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>Əngwar Yesu anǝ nyi, “Zamǝ ngau wu ɓǝra hyaˈari.”<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>“Angǝ,” kǝ Marthla shaɗǝwa nyi, “A sǝn yi ju nda hyaˈari ma nji tǝtau, wu nda hyaˈari ar kuɗiyar duniya.”<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>Əngwar Yesu anǝ nyi, “Nayi ngǝ hyaˈari sara vir tau ǝnga nayi ngǝ pi. Kalar ndǝra hǝnggǝri ǝnga yau, ju ɓǝra ɗa aˈyi ǝnga pi alaga ji tau. <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>Ndǝra aˈyi ǝnga pi wu yau, ǝnga ji hǝnggǝri ǝnga yau, naji wu tǝ mai. Marthla, a hǝnggǝri gǝ abangǝ ya?”<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>Marthla shaɗǝwa nyi, ji na, “Angǝ, Thlagǝu, a hǝnggǝri yi abǝr nagǝ ngǝ Kǝrsiti, Zǝr Hyal kǝra a vǝr shili wu duniya.”<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>Ayukuɗa ji nana abangau, ba ji maˈyi a vu ki, ji vuwa nggar kwamǝ nyi Maryamu, ji na anǝ nyi ar ɗǝwa, “Kǝja Malǝmǝ a biya ja vǝr yiwa ngau.” <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>Ənggǝra Maryamu nggari abangau, ba ji hyaˈari ǝnga kusa, ji maˈyi a ndǝra ja. <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>Ar pǝci kau, tsu Yesu gǝra vu huɗa mǝlmau, tsu ja ar vira Marthla thlǝwa nyi ar ta. <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>Ənggǝra njir Yahudiya kǝra a vu ki ǝnga Maryamu ndu fǝ ɗǝfu anǝ nyi lari ǝnggǝra ji biya ǝnga kusa, ba ndǝ nu nyi a biya ma ndu nggani ndar hu nga ja aga nda tiwi a ndǝna.<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>Ənggǝra Maryamu biya thlǝwa vira Yesu ari, ba ji dla wu mwa nyi, ji na, “Thlagǝu, ma ja abǝr gǝ nda ɗa aˈyi ǝnggau, zamǝ ɗa aˈyi tǝ mai.” <verse eid="JHN 11:32"/><verse number="33" style="v" sid="JHN 11:33"/>Ənggǝra Yesu lari nyi a vǝr tiwi ǝnga njir Yahudiya kǝra shili ǝnga ja vǝr tiwi tsu, kǝ sǝ kǝ tǝ Yesu wu ɗǝfuwa ja gagaɗau. <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>Əngwar ja, “Əmani, nga hyi haɗǝna nya?”</para>
  <para style="p" vid="JHN 11:34">Əngwar nda anǝ nyi, “Thlagǝu, a ndǝ ga sa lari.”<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>Kǝ Yesu pǝna sǝlǝm.<verse eid="JHN 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36"/>Agabangau, kǝ njir Yahudiya na, “Lara mau ǝnggǝra ju yiwu nyi!”<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>Ama kǝ alenyi nju pama nda na, “Naja ndǝra pahǝna liya ndǝ lǝfǝ ta, aˈyi ja ǝnga dǝnama nǝ kar nyi ara tǝ wa?”<verse eid="JHN 11:37"/></para>
  <para style="s1">Yesu Hyaˈana Liyazaru Sara Vir Tau</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>Kǝ sǝ kǝ ɗa tǝdǝɓǝ anǝ Yesu wu ɗǝfuwa ja, kǝ ji ɓar dzǝ a ndar huwa nyi. Hu kau, thlǝl ngau a vu mau, kǝra nji haɗiya miya nyi ǝnga tsǝka dǝgalǝu. <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>Əngwar Yesu, “Hǝna mǝ tsǝka kau.”</para>
  <para style="p" vid="JHN 11:39">Əngwar Marthla kwamiya ndǝ tǝtǝ anǝ nyi, “Ama Thlagǝu, kabangǝkǝ ju shuni kǝrakǝramǝu ara a mǝliyar ja pida foɗǝ wu hu kau.”<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>Kǝ Yesu na anǝ nyi, “Aˈyi yi nar ngau abǝr ma gǝ mbǝrsa, gu lari kadakadarkur nǝ Hyal wa?”<verse eid="JHN 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41"/>Kǝ ndǝ hǝna tsǝka nyi. Kǝ Yesu tsamǝ dǝmǝlmau, kǝ ji na, “Tada, yu usaku ngau ara a nggar ɗar gau. <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>Wu sǝn yi abǝr gu nggar ɗa cumu, ama yi na abangau aga nji kǝ tataˈyi wu dzǝ ɗa kau, nda hǝnggǝri abǝr nagǝ ngǝ sǝwa ɗa.”<verse eid="JHN 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43"/>Ənggǝra ji nana abangau, kǝ Yesu hyaˈana ɗahǝu, ji ngga, “Liyazaru, ɓa sǝbiya!” <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>Kǝ ndǝ tǝta nyi sǝbiya, tsa ja ǝnga hya ja mbamba ǝnga paˈwa haɗǝ ndau, ba paˈwa kǝra zǝwar bama ja.</para>
  <para style="p" vid="JHN 11:44">Kǝ Yesu na anǝ nda, “Pǝlna nya mau, ja maˈyi sǝ nyi.”<verse eid="JHN 11:44"/></para>
  <para style="s1">Mba Miya Aga Tsa Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>Arya sǝ kǝ ɗa kau, njir Yahudiya gangǝu kǝra shili ǝgya Maryamu lari sǝ kǝ Yesu mǝlna kau, ba ndǝ fuwa mbǝrsar nda wu ja. <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>Ama kǝ alenyi nju pama nda maˈyi a ndǝgya njir Farisi, ndǝ nda nar nda sǝra Yesu mǝliya. <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>Agabangau, kǝ pubu dǝdǝgalˈyar ǝnga njir Farisi nggǝya daɓǝ nǝ njir pathla.</para>
  <para style="p" vid="JHN 11:47">Əngwar nda, “Mi nga mǝna vǝr mǝla? Kǝja ndǝ kau, kǝl dumwa nga mǝl sǝ dǝdǝgur pamǝpamǝ gangǝu. <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>Ma mǝn piyari nyi ji dumwa abangau, kalar ndau, wu nda hǝnggǝri ǝnga ja. Njir Roma a dzǝgwa shili nda sa mbǝliya ki Hyalǝr mǝn ǝnga ˈyiˈyir mǝn.”<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>Ama kǝ pathlǝ wu pama nda, ndǝra nja ngga ǝnga Kayafasu, ndǝra naja ngǝ pubu kǝra ndiya ǝnga dǝgal wu fa ta, ndǝr, ji na, “Nahyu sǝn sǝra hyu ndǝr ar kǝri mai. <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>A ɗari tsaˈa vanyi nda tǝ arya nji patǝu, ara nji patǝ a sara sanakǝr, aˈyi hyi nggabiya abangǝ wa?”<verse eid="JHN 11:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51"/>Ndǝr kau, Kayafasu aˈyi nana ǝnga yiwu kǝrnyi mai, ama ar viya pubu kǝra ndiya ǝnga dǝgal wu fa ta nga ji nana sǝra mambǝl cabiya nyi abǝr Yesu wu nda tǝ arya njir Yahudiya, <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>ǝnga aˈyi arya njir Yahudiya wacu mai, ama aga ja kaɓiya wazha Hyal kǝra tǝtǝlnakǝr a ndu duniya, aga nda ɗa nji zǝmǝu. <verse eid="JHN 11:52"/><verse number="53" style="v" sid="JHN 11:53"/>Mbar ar pǝci ta nga ndu gal lagu kǝra nda sǝn tsǝya Yesu.<verse eid="JHN 11:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54"/>Agabangau, tsu Yesu wu ɓau ar babal wu pama njir Yahudiya mai. Ba ji biya ji maˈyi a ndar vira lǝhǝu wu dzǝr tagǝ mashi, a ndu vanyi zǝr mǝlmǝ kǝra nju ngga ǝnga Ifrayimu, a ndǝna ndǝ nggya ǝkkǝˈyi zǝmbǝlma nyiˈyar.<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>Ənggǝra mini nǝ lardur nǝ vǝlbiya a ɗari lǝhǝu, kǝ nji gangǝu hyaˈari sara wu mǝlmǝ yiɗǝɗǝ a du Urshalima aga nda vuwa cina dzǝ ǝnggǝra dlaɗǝ nana kadivira lardur vǝlna. <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>A vuna, ndǝ dumwa ǝnga gal Yesu, tataˈyi nda a vu ki Hyal, ndu yiyiwa kǝrnda, ndu na, “Mi nga hyu nggana? Ju shili wu mini kǝ ya?” <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>Kabangǝkau, pubu dǝdǝgalˈyar ǝnga njir Farisi a fiyar nda ndǝr anǝ nji abǝr kalar ndǝra lari Yesu, nja nar nda ǝnga kusa aga nda mbar nyi.<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">Nji Pǝr Nyi Mal Anǝ Yesu Wu Bethlani</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matiwu 26:6-13</ref>; <ref loc="MRK 14:3-9">Markusu 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>Mini nǝ lardur vǝlbiya a hyiri pida kwa, ngǝ Yesu shili wu Bethlani, mǝlmǝ kǝra Liyazaru a gwa, ndǝra Yesu hyaˈana sara vir tǝ ta. <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>Ənggau, nji mǝliya nyi sǝr sǝm nǝ wagǝu. Marthla ngǝ tǝkǝ sǝr sǝm kau, Liyazaru pathlǝ ja wu pama njira vǝr sǝm ǝnga ja. <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>Kǝ Maryamu hǝri pǝla nǝ mal kisǝ kǝra nji mǝl sara wu nardu, kǝra nju ɗǝl ǝnga gǝnna gangǝu. Ji sa pǝr nyi ar hya Yesu, kǝ ji ɓǝsiya nyi ǝnga shishir kǝra ja. Kǝ ki kǝra nda a gwa nyi ǝnga shuni ɓurdi kau.<verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>Ama kǝ pathlǝ sara wu pama zǝmbǝlma nyiˈyar kǝra nju ngga ǝnga Yahuda Isikarayoti, ndǝra wu nda sa thlǝna hya ja, na, <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>“Mi ngǝ ɗa nji aˈyi ɗǝlna ɓurdi kǝ ǝnga gǝnna gangǝ (gǝnna nǝ pǝkǝ nǝ nji gharu makǝru) nja nǝ nyi gǝnna nyi anǝ nji ɗaɗali maya?” <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>Yahuda na najaka ndǝr aˈyi ara ju yiwu nji ɗaɗali mai, ama ara naja ndǝr hǝl ngau. Naja ngǝ ndǝr sǝɓǝ pǝrki nǝ gǝnna, ǝnga ju dlǝwar kǝrnyi ǝnga sǝra a gwa.<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>Kǝ Yesu na, “Piyari nya mau, ji fiya ɓurdi kǝ aga pǝcir haɗǝ ɗa. <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>Aˈyi hyi ǝkkǝˈyi nji ɗaɗali cumu, ama aˈyi hyi ǝnga yi cumu mai.”<verse eid="JHN 12:8"/></para>
  <para style="s1">Mba Miya Aga Tsa Liyazaru</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>Aˈyi ɓǝliya sar mai, kǝ dlamir njir Yahudiya nǝri abǝr Yesu a ndǝna, ba ndǝ shili. Shilir nda aˈyi aga nda lar Yesu wacu mai, ama aga nda lari Liyazaru, ndǝra ji hyaˈana sara vir tǝ ta. <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>Kǝ pubu dǝdǝgalˈyar gal lagu kǝra nda sǝn tsǝya Liyazaru ǝtsu. <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>Ara arya sǝra ɗa ǝnga Liyazaru ngǝ njir Yahudiya gangǝu shabiya nda yi, ba ndǝ hǝnggǝri ǝnga Yesu.<verse eid="JHN 12:11"/></para>
  <para style="s1">Yesu Vu Urshalima</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>Əzǝgǝkura nyi kǝ dlamir nji gangǝu kǝra dla wu mini kǝ nggari abǝr Yesu a mbar lagu a vu Urshalima. <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>Ənggau, kǝ ndǝ ɓǝlǝr hyali hyifa ndǝ maˈyi a biya dlǝwu nyi, ndu wau ndu na,</para>
  <para style="q1" vid="JHN 12:13">“Fal a ɗari anǝ Hyal!”</para>
  <para style="q2" vid="JHN 12:13">“Barka anǝ ndǝra dla</para>
  <para style="q1" vid="JHN 12:13">wu thlǝmǝr Thlagǝu!”</para>
  <para style="q2" vid="JHN 12:13">“Barka anǝ tǝlǝr njir Izirayila!”<verse eid="JHN 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14"/>Ta Yesu uya zǝr kwara, ba ji dari, ǝnggǝra nji tsǝfǝri abǝr,<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>“Ga sara hivǝr mai,</para>
  <para style="q2" vid="JHN 12:15">nagǝ culi Sǝhiyona.</para>
  <para style="q1" vid="JHN 12:15">Kǝja tǝlǝr hyi a vǝr shili,</para>
  <para style="q2" vid="JHN 12:15">aˈyi nggya a dar ya zǝr kwara.”<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>Tanggǝrma zǝmbǝlma nyiˈyar aˈyi nggabiya sǝˈyar kǝ kwatahǝ mai. Ama ayukuɗa kadakadarkur nǝ Yesu nyabiya dzǝ nga ndǝ ɗǝngari abǝr tsǝtsǝfǝ ngǝ sǝˈyar kǝ ar kǝra ja, ǝnga kalar sǝra nji mǝl anǝ nyi aga nyabiya sǝra tsǝtsǝfǝ nga nyi.<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>Njira aˈyi ǝnga ja, ar pǝci kǝra ji ngga Liyazaru sara wu hu ta, ǝnga ji hyaˈana nyi sara a vir tǝ ta, kǝ ndǝ dumwa ǝnga tǝtǝlna sǝra Yesu mǝliya. <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>Ca ngǝ sǝra ɗa, nji gangǝu, ndǝ biya ndǝ biya thlǝwa nyi ara ndǝ nggari sǝ dǝdǝgur kǝra Yesu mǝlna. <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>Kǝ njir Farisi na anǝ kuvwar nda, “Lara mau, namǝn sǝmku tǝlkur mai, alaga kushu, kǝja patǝr duniya a shari ndu nu nyi!”<verse eid="JHN 12:19"/></para>
  <para style="s1">Yesu Nana Tǝ Nyi</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>Wu pama njira shili aga mini kau, alenyi nji aˈyi kǝra njir Gǝrikǝ ngau. <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>Ndǝ shili ara Fǝlipǝu, ndǝr Bethlesaida wu Galili, ndǝ sa yiwa nyi, “Malǝmǝ, ˈyi wu yiwu ˈya lar Yesu.” <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>Kǝ Fǝlipǝu maˈyi ji nda nar nyi anǝ Andǝrawusu, nanda mǝthlǝ kǝ ndǝ maˈyi ndǝ nda nar nyi anǝ Yesu.<verse eid="JHN 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23"/>Kǝ Yesu shaɗǝwa nda, ji na, “Pǝci a ɗari kǝra nja kyaga lǝri kadakadarkur anǝ Zǝr Ndau. <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>Ənga jiri nga yu na anǝ hyi, ma culi uhi aˈyi tǝɗǝ a gyiwu ˈyi ji ɗiya mai, ju nggya kǝl naja. Ama ma ji ɗiya, ju puwa li, ba ja hǝ kǝr dǝgalǝu. <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>Kalar ndǝra wu yiwu piya ja, ju nda tini. Ndǝra gǝra yiwu piya ja wu duniya kau arya yau, ju nda uya pi gǝra kuɗau. <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>Kalar ndǝra wu mǝl thlǝr anǝ ɗa, kǝl ja nu ɗa ǝnga jirkur. Vira ya ri a ndǝna ngǝ ndǝr mǝl thlǝr anǝ ɗa tsu. Dǝɗa wu nda nǝ nyi dǝgalkur anǝ ndǝra wu mǝl thlǝr anǝ ɗa.<verse eid="JHN 12:26"/></para>
  <para style="s1">Yesu Ndǝr Ar Kǝra Tǝ Nyi</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>“Kabangǝkau, kǝja tǝdǝɓǝ ngǝ ɗǝfuwa yau. Ya, mi nga ya sǝn na? Ya na, ‘Tada, kǝtiya ɗa ara pǝci kǝ ya?’ Awau, aga culi pǝci kǝ nga yi shili ar pǝci kau. <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>Tada, nǝ nyi kadakadarkur anǝ thlǝmǝ ngau.”</para>
  <para style="p" vid="JHN 12:28">Kǝ ɗahǝu shida sara dǝmǝlmau, “A nǝ nyir yi kadakadarkur anǝ thlǝmǝ ɗa, ǝnga yu ɓǝra nǝ nyi kadakadarkur wayu.” <verse eid="JHN 12:28"/><verse number="29" style="v" sid="JHN 12:29"/>Ənggǝra njira tataˈyi a ndǝna nggar ɗahǝ kau, kǝ ndǝ na, “Dlǝɗǝ ngau.” Əngwar alenyi nji, “Waladi ngau, ngǝ ndǝr anǝ nyi.”<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>Kǝ Yesu na anǝ nda, “Ɗahǝ kǝ shili aga hyi nga nyi, ama aˈyi aga yi mai. <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>Kabangǝkǝ ngǝ pǝcir numa anǝ duniya, kabangǝkǝ nga nju kǝdlǝbiya ndǝr sǝm tǝlkur ar kǝra duniya a biya. <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>Ama nayau, ayukuɗa nji hǝr ɗa sara gyiwu ˈyi a dǝmǝlmau, yu nda nggar nji a shili ara kǝrɗa.” <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>Yesu nana abangau aga ja cabiya culi tǝ kǝra ju nda tau.<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>Kǝ dlamir nji nar nyi anǝ Yesu, “ˈYi nggabiya wu dlaɗǝ abǝr Kǝrsiti wu ɗa ǝnga pi baˈanuwa. Ya, mi ngǝ ɗa gu na, ‘Kǝl nji hǝr Zǝr Ndau a diya?’ Wa ngǝ Zǝr Ndǝ ka?”<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>Kǝ Yesu shaɗǝwa nda, “Mbǝmbǝl kǝ wu nda nggya ǝnga hyi nǝ pǝci kushu wacu. Ɓa mau ǝnga mbǝmbǝl kǝra aˈyi ara hyi, kadivira kuthla shili. Kalar ndǝra wu ɓau wu kuthlǝu naji wu sǝn vira ju maˈyi a ndari mai. <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>Ma mbǝmbǝl kǝ aˈyi tsu ǝnga hyi, hya fuwa mbǝrsar hyu mbǝmbǝla nyi, aga hya ɗa wazha mbǝmbǝl.”</para>
  <para style="p" vid="JHN 12:36">Ayukuɗa ji kuɗǝna ndǝr kau, ba ji maˈyi, ji nda mbunakǝr ara nda.<verse eid="JHN 12:36"/></para>
  <para style="s1">Gǝra Mbǝrsa Nǝ Njir Yahudiya</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>Alaga ayukuɗa sǝ dǝdǝgur pamǝpamǝ kǝra Yesu mǝlna wu mwar nda, nandǝ mbǝrsa ǝnga ja mai. <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>Najakǝ ɗarkǝr aga ja nyabiya sǝra nabi Əshaya nana,</para>
  <para style="q1" vid="JHN 12:38">“Thlagǝu, wa ngǝ hǝnggǝri</para>
  <para style="q2" vid="JHN 12:38">ǝnga sǝra mǝn nana,</para>
  <para style="q1" vid="JHN 12:38">ǝnga anǝ wa,</para>
  <para style="q2" vid="JHN 12:38">ngǝ dǝnama nǝ Thlagǝ cabiya dza?”<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>Ca ngǝ mǝliya nandǝ sǝn mbǝrsa mai, ǝnggǝr kǝra nabi Əshaya nana ar vanyi vi, abǝr, <verse eid="JHN 12:39"/><verse number="40" style="v" sid="JHN 12:40"/>“Ji mǝliya nda ndǝ ɗa lǝfau,</para>
  <para style="q1" vid="JHN 12:40">“Ji mǝliya ɗǝfuwa nda</para>
  <para style="q2" vid="JHN 12:40">ɗa ɓaɓalu,</para>
  <para style="q1" vid="JHN 12:40">Ara nda sara lari</para>
  <para style="q2" vid="JHN 12:40">sǝ ǝnga liya nda,</para>
  <para style="q1" vid="JHN 12:40">ǝnga nda nggabiya</para>
  <para style="q2" vid="JHN 12:40">ǝnga ɗǝfuwa nda,</para>
  <para style="q1" vid="JHN 12:40">kǝra wu sǝn shabiya nda</para>
  <para style="q2" vid="JHN 12:40">a shili ara yau,</para>
  <para style="q2" vid="JHN 12:40">aga ya shilǝgǝbiya nda.”<verse eid="JHN 12:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41"/>Nabi Əshaya nana abangau, ara ji lari kadakadarkur nǝ Yesu kǝra wu nda cabiya dzau, ǝnga ji ndǝr ar kǝra ja.<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>Alaga abangǝ ma, nji gangǝu mbǝrsa ǝnga Yesu, patǝ ǝkkǝˈyi alenyi njira nggurǝm nǝ Yahudiya. Ama nandǝ sǝn biyar babal mai, ara hivǝr njir Farisi nda sara kǝdlǝbiya nda sara wu umbwa daɓǝ dzǝ njir Yahudiya. <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>Ara ndu yiwu fal sara wu miya nji a ndiya sara wu miya Hyal.<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>Kǝ Yesu hyaˈana ɗahǝu ji na, “Kalar ndǝra mbǝrsa ǝnga yau, ǝnga yi nga ji mbǝrsa waci mai, ama ǝnga ndǝra sǝwa ɗa. <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>Kalar ndǝra wu lar ɗa, ju lari ndǝra sǝwa ɗa. <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>Yi shili wu duniya ǝnggǝr mbǝmbǝl, aga kalar ndǝra hǝnggǝri ǝnga yau, tsu ju nggya wu kuthlǝu mai.<verse eid="JHN 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47"/>“Kalar ndǝra nggari highiɓǝ ɗa, ama naji ɓǝlari mai, aˈyi nayi ngu nda mǝl numa anǝ nyi mai. Ara nayi aˈyi shili aga sa mǝl numa anǝ duniya mai, ama aga duniya uya mbǝɗau lagu ɗa. <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>Ndǝra piyari ɗa, ji nggǝl ara dlǝwu ndǝr ɗa, aˈyi ja ǝnga ndǝra wu nda mǝl numa anǝ nyi. Ndǝr ɗa, kǝra yi nana, naja ngu nda mǝl numa anǝ nyi ar pǝcir kuɗiyar duniya. <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>Sǝra yu na aˈyi sǝ kǝrɗa mai, ama Dǝɗa ndǝra sǝwa ɗa, naja ngǝ nar ɗa sǝra ya na ǝnga ndǝr kǝra yu ndǝr. <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>Yu sǝni abǝr ndǝr nyi ngu shili ǝnga pi gǝra kuɗau. Agabangǝ sǝra yu na, sǝra Dǝɗa nar ɗa ya na ngau.”<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s1">Yesu Cina Hiya Zǝmbǝlma Nyiˈyar</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>Pǝcir mini nǝ lardur nǝ Vǝlna a shiliri lǝhǝu ǝnga Yesu ǝnga kǝrnyi a sǝnbiyari abǝr pǝci nyi a ɗari lǝhǝu aga ja sha a dara dǝnyi. Yesu a cabiyar ja yiwukur nyi anǝ nji nyi wu duniya, kǝl ta ji cabiya nda yiwukur nyi baˈanǝ kuɗiyar piya ja.<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>Ar pǝci kǝra Yesu ǝkkǝˈyi zǝmbǝlma nyiˈyar a vǝr sǝm sǝr sǝm nǝ wagǝu, shatan a fuwari wu ɗǝfuwa Yahuda Isikarayoti zǝr Simanu aga ja thlǝna hya Yesu. <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>Yesu wu sǝni abǝr Tada a fuwari kalar sǝ wu tsa ja, ǝnga ju sǝni abǝr sara dǝgya Hyal nga ja, ǝnga tsu a dǝgya Hyal nga ju ɓǝra nda sha. <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>Ar pǝci kǝra nda vǝr sǝm sǝr sǝm, kǝ Yesu hyaˈari ji zǝɗǝna lǝgutǝ nyi, ba ji hǝri sǝr bakǝ nyi, ba ji mbiya ar sara ja. <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>Ayukuɗa kau, kǝ ji puwa ˈyimi a gwu cala ba ji dzǝguya ci hiya zǝmbǝlma nyiˈyar ǝni. Ju ɗa ɗa hiya nda ǝnga sǝr bakǝ kǝra ji mbiya wu sara ja. <verse eid="JHN 13:5"/><verse number="6" style="v" sid="JHN 13:6"/>Kǝ Yesu shili ǝgya Simanu Biturusu, kǝ Biturusu na anǝ nyi, “Thlagǝu, nagǝ ngu ci hiya yi ya?”<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>Əngwar Yesu anǝ nyi, “Nagǝu nggabiya sǝra yu mǝl kabangǝkǝ mai, ama gu nda nggabiya a ndu mwa.”<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>Əngwar Biturusu anǝ nyi, “Awau, nagǝ wu ci hi anǝ ɗa ndangǝ mai.”</para>
  <para style="p" vid="JHN 13:8">Kǝ Yesu shaɗǝwa nyi, “Ma nayi aˈyi cina hya gǝ mai, nagǝ aˈyi nǝ ɗa mai.”<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>Əngwar Biturusu anǝ nyi, “Thlagǝu, ma abangǝ ja, aˈyi hiya yi nga ga ci waci mai, ama ga daɓǝri ǝnga tsa yau ba kǝra yau!”<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>Əngwar Yesu anǝ nyi, “Ndǝra a pǝrnar pǝr, a ɗar ja cicau, kǝl ci hi nga ju yiwu wacu ara dza ja patǝ cici nga nyi. Nahyi cici nga hyi, ama aˈyi patǝkura hyi mai.” <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>Ara ju sǝni ndǝra wu nda thlǝna hiya ja. Ca ngǝ ɗa, ji na, “Aˈyi papatǝkura hyi ngǝ cici mai.”<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>Ayukuɗa ji cina hiya nda patǝu, kǝ ji har lǝgutǝ nyi, ba ji ɓǝra sha a ndar vir nggya nyi. Kǝ ji yiwa nda, ji na, “A nggabiyar hyi sǝra yi mǝliya hyi kǝ ya?” <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>Hyu ngga ɗa Malǝmǝ ǝnga Thlagǝu, kakalǝ nga nyi, ara ca ngǝ sǝra ya ga nyi. <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>Ma nayi kǝra Malǝmǝr hyi ǝnga Thlagǝr hyi cina hiya hyi, a kyau nahyi ma hya kyaga cina hiya kuvwar hyi. <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>A cabiya hyir yi sǝra hya kyaga mǝl, nahyi tsu hya nu hiya yau. <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>Jiri nga yu na anǝ hyi, mafa aˈyi a sǝn ndiya tarki nyi mai, ǝnga ndǝra nji sau ǝnga cama aˈyi a sǝn ndiya ndǝra sǝ nyi mai. <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>Ma hya sǝnbiyar najaka jiri, abari ngǝ cacagulikura hyu nda ɗa ma hyi mǝl thlǝr ǝni ya!<verse eid="JHN 13:17"/></para>
  <para style="s1">Yesu Nana Ənggǝra Nji Wu <optbreak/> Nda Thlǝna Hiya Ja</para>
  <para style="r">(<ref loc="MAT 26:20-25">Matiwu 26:20-25</ref>; <ref loc="MRK 14:17-21">Markusu 14:17-21</ref>; <ref loc="LUK 22:21-23">Luka 22:21-23</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>“Ar kǝra hyi patǝ nga yu ndǝr mai. Wu sǝn yi njira yi caɗǝbiya. Ama yi caɗǝbiya hyi aga ndǝr Hyal kǝra tsǝtsǝfau a nyabiya dzau, kǝra na, ‘Ndǝra vǝr sǝm sǝr sǝm ɗa ngu gal lagur thlǝ hiya yau.’ <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>Nayi ngu na sǝˈyar kǝ kadivira ji ɗarkǝr, aga ma ji nda ɗarkǝr hya sǝni abǝr nayi ngǝ Kǝrsiti. <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>Jiri nga yu na anǝ hyi, kalar ndǝra dlǝwuri ndǝra yi sǝwa, nayi nga ji dlǝwuri. Kalar ndǝra dlǝwuri ɗa tsu, ndǝra sǝwa ɗa nga ji dlǝwuri.”<verse eid="JHN 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>Ayukuɗa Yesu nana ndǝr kau, kǝ sǝ kǝ ɓwanǝ nyi kǝr wu ɗǝfuwa ja gagaɗau. Kǝ ji cabiya nda ar babal abǝr, “Ənga jiri pathlǝ wu pama hyu nda thlǝna hiya yau.”<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>Kǝ zǝmbǝlma nyiˈyar mbar tsatsamǝ kǝrnda, ara nandǝ wu sǝni tara wa nga ju ndǝr ar kǝri kǝ mai. <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>Pathlǝ wu pama zǝmbǝlma kǝra Yesu wu yiwu gagaɗau, nggashi ja ar thlǝrpa ja. <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>Kǝ Simanu Biturusu guthlar nyi aga ja yiwabiya nda Yesu, “Wa nga ju ndǝr ar kǝri ka?”<verse eid="JHN 13:24"/></para>
  <para style="pi">
    <verse number="25" style="v" sid="JHN 13:25"/>Naja kǝra lǝha ar dzǝr nyi uzhiya kǝr ju yiwa Yesu, “Thlagǝu, wa nga ja?”<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>Kǝ Yesu shaɗǝwa, “Ndǝra yi kadlǝr macikǝl, yi fuwa a gwu cala, ba yi nǝ nyi, naja ngau.” Kǝ Yesu kadlǝri macikǝl ba ji fuwa a gwu cala ba ji nǝ nyi anǝ Yahuda zǝr Simanu Isikarayoti. <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>Ənggǝra Yahuda dlǝwuri macikǝla nyi, ba shatan gu ja.</para>
  <para style="p" vid="JHN 13:27">Kǝ Yesu na anǝ nyi, “Sǝra gu yiwu ga mǝl, mǝl ǝnga kusa.” <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>Ama wu pama nanda patǝ kǝra a vǝr sǝm sǝr sǝm, ndǝ aˈyi kǝra sǝnbiya sǝra ɗa Yesu na ndǝr kǝ anǝ nyi mai. <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>Ta ndu sǝni abǝr naja ngǝ ǝnga mbǝl gǝnnar nda, ma ndu nggani abǝr sǝra Yesu na anǝ nyi, ca ngǝ, ja maˈyi ja nda ɗǝlbiya nda sǝra ndu yiwu aga mini. Ma aˈyi abangǝ tsu mai, ja nǝ nyi anǝ nji ɗaɗali sǝra aˈyi. <verse eid="JHN 13:29"/><verse number="30" style="v" sid="JHN 13:30"/>Yahuda tsu, ǝnggǝra ji dlǝwuri macikǝla nyi, ba ji biya maˈyi. Ar pǝci kau, vuˈyi a ɗari.<verse eid="JHN 13:30"/></para>
  <para style="s1">Dlaɗǝ Mafǝliyangǝu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>Ayukuɗa Yahuda maˈyi a biya, kǝ Yesu na, “Kabangǝkau, nga nju nda nǝ nyi kadakadarkur anǝ Zǝr Ndau, ǝnga Hyal ǝnga kǝrnyi wu nda uya kadakadarkur arya ja. <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>Ma Hyal uya kadakadarkur lagu Zǝr nyi, Hyal ǝnga kǝrnyi ngu nda nǝ nyi kadakadarkur tsu anǝ Zǝr nyi ǝnga kusa.”<verse eid="JHN 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33"/>Əngwar ja anǝ nda, “Wazha ɗa, nǝ pǝci kushu nga yi ǝkkǝˈyi hyi wacu. Hyu nda gal ɗa, ama ǝnggǝra yi nar nyi anǝ njira nggurǝm nǝ Yahudiya, abangǝ nga yu na anǝ hyi kabangǝkau, abǝr, ‘Vira yu maˈyi a ndari, nahyi wu sǝn ndǝna mai.’<verse eid="JHN 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34"/>“Dlaɗǝ mafǝliyangǝ nga yu lǝ anǝ hyi, ca ngǝ, hya yiwu kǝrhyi. Ənggǝr kǝra yi yiwu hyi, abangǝ nga hya yiwu kuvwar hyi. <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>Lagu kau, ngǝ nji patǝ wu nda sǝni abǝr nahyi zǝmbǝlma ɗa nga hyi, ma hyu yiwu kuvwar hyi.”<verse eid="JHN 13:35"/></para>
  <para style="s1">Biturusu Wu Nda Kǝpalna Sǝni Yesu</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matiwu 26:31-35</ref>; <ref loc="MRK 14:27-31">Markusu 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>Simanu Biturusu yiwa nyi, “Thlagǝu, nǝma nga ga?”</para>
  <para style="p" vid="JHN 13:36">Yesu shaɗǝwa nyi, “Vira yu maˈyi a ndari, nagǝ wu sǝn nu ɗa kabangǝkǝ mai, ama gu nda nu ɗa a sǝkar kushu.”<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>Əngwar Biturusu anǝ nyi, “Thlagǝu, mi ngǝ ɗa nayi wu sǝn nu ngǝ kabangǝkǝ maya? Yu sǝn lǝri piya yau, arya gau.”<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>Kǝ Yesu shaɗǝwa, ji na, “Gǝ wu sǝn lǝri piya gau arya ya? Yu nar ngǝ jirkura nyi, kadivira vǝgǝmǝ a wau ǝshina, gu nda kǝpalna sǝn ɗa, ar kǝr ar kǝr makǝru.”<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s1">Yesu Ngǝ Lagur Ndara Tada</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>“A sara huɗa hya ndzǝ mai. Hya hǝnggǝri ǝnga Hyal, ba hya hǝnggǝri ǝnga yi tsu. <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>Wu ki dǝɗa vir nggya aˈyi gangǝu. Ma aˈyi nda ɗa abangǝ mai, yu nda nar hyi. Maˈyi nga ya a ndǝna aga ya da pabǝr hyi vi. <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>Ma ya maˈyiri yi da pabǝr hyi vi, yu sha shida aga ya sa faˈari hyi a ndǝgya yau, aga vira ya ri, ǝna nga hyu nggya. <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>Vira yu maˈyi a ndari, hyu sǝn lagur ndǝna.”<verse eid="JHN 14:4"/></para>
  <para style="s1">Yesu Ngǝ Lagu Dǝra Tada</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>Kǝ Toma na anǝ Yesu, “Thlagǝu, naˈyu sǝn vira gu maˈyi a ndar kǝ mai, ya abari nga ˈyi wu sǝni laguwa nya?”<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>Yesu shaɗǝwa nyi, ji na, “Nayi ngǝ lagu, nayi ngǝ jiri ǝnga nayi pi. Ndǝr sǝn shili ǝgya Tada aˈyi mai, kǝl lagu ɗa. <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>Maja abǝr hyu sǝn ɗa, hyu sǝn Dǝɗa tsu. Ama mbar kabangǝkǝ hyu nda sǝni nyi ǝnga hyu nda lari nyi.”<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>Kǝ Fǝlipǝu na, “Thlagǝu, canǝ ˈya Tada, ba huɗa ˈya pida.”<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>Yesu shaɗǝwa nyi, “Fǝlipǝu, pǝci kǝ yi hǝri ǝnga hyi kau, baˈanǝ kabangǝkǝ nagǝ wu sǝn ɗa mai ya? Kalar ndǝra lar ɗa a lar ja Tada. Abar nga gu sǝn na, ‘Canǝ ˈya Tada ka’? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>Nahyi aˈyi hǝnggǝri abǝr nayi wu Tada, ǝnga Tada wu yi wa? Ndǝr kǝra yu na anǝ hyi, nǝ kǝrɗa ngǝ mai. Ama Tada kǝra a vǝr nggya wu yi nga vǝr mǝl thlǝr nyi. <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>Hya hǝnggǝri ǝnga yau, abǝr nayi wu Tada ǝnga Tada wu yau, aˈyi abangǝ mai hya hǝnggǝri ǝnga yi arya sǝ dǝdǝgur pamǝpamǝ gangǝ kǝra yi mǝlna. <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/>Jiri nga yu na anǝ hyi, kalar ndǝra hǝnggǝri ǝnga yau, ju mǝliya thlǝr kǝra yu mǝl tsu. Ju nda mǝliya thlǝr kǝra ndiya kǝra yi mǝl, ara yu maˈyi a dǝgya Tada. <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>Ənga yu nda mǝliya kalar sǝra hyu kǝdiyau wu thlǝmǝ ɗa, aga ja dla ǝnga kadakadarkur anǝ Tada lagu Zǝr. <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>Kalar sǝra hyu kǝdi wu thlǝmǝ ɗa, yu mǝliya hyi.<verse eid="JHN 14:14"/></para>
  <para style="s1">Alkawal Shilǝr Mambǝl Cicau</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>“Maja hyu yiwu ɗa, hyu ɓǝlari dlaɗǝ ɗa. <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>Ba ya dzǝgwa kǝdi Tada, aga ja sǝwa hyi vanyi ndǝr dlǝwa dzǝ kǝra wu nggya ǝnga hyi baˈanuwa. <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>Naja ngǝ Mambǝl nǝ jiri, kǝra a vǝr cabiya jirkur ar kǝra Hyal. Duniya wu sǝn dlǝwuri nyi mai, ara nandǝ wu lari nyi mai ǝnga nandǝ wu sǝnbiya nyi mai. Ama nahyi nǝr hyi, hyu sǝnbiya nyi, ara aˈyi ja ǝnga hyi ba ǝnga wu ɗǝfuwa hyi. <verse eid="JHN 14:17"/><verse number="18" style="v" sid="JHN 14:18"/>Nayi wu piyari hyi ǝnggǝr mǝsǝtǝ mai, yu sha shili ǝgya hyi. <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>Ayukuɗa pǝci kushu, njir duniya wu ɓǝra nda lar ɗa mai, ama nahyi, hyu nda lar ɗa. Ara aˈyi yi ǝnga pi, nahyi ma, hyu ɗa ǝnga pi. <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>Ar pǝci ta nga hyu nda sǝnbiya abǝr nayi wu Dǝɗa, nahyi wu yau ǝnga nayi wu hyi. <verse eid="JHN 14:20"/><verse number="21" style="v" sid="JHN 14:21"/>Kalar ndǝra dlǝwuri dlaɗǝ ɗa, ba ji ɓǝlari, naja ngǝ ndǝra wu yiwu ɗa. Ndǝra wu yiwu ɗa tsu, Dǝɗa wu nda cabiya nyi yiwukur, nayi tsu yiwu nda yiwu nyi ǝnga yu cabiya kǝrɗa anǝ nyi.”<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>Kǝ Yahuda (aˈyi Isikarayoti mai) na anǝ nyi, “Ama Thlagǝu, abar nga ga sǝn canǝ ˈya kǝr, ama aˈyi anǝ njir duniya patǝ maya?”<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Kalar ndǝra wu yiwu ɗa, ju ɓǝlari highiɓǝ ɗa. Dǝɗa tsu ju nda yiwu nyi, ba ˈya shili ˈya sa nggya wu ja. <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>Kalar ndǝra gǝra yiwu ɗa, naji wu ɓǝlari highiɓǝ ɗa mai. Ndǝr kǝra hyu nggari yu na, nǝ ɗa ngǝ mai, ama nǝ Dǝɗa ndǝra sǝwa ɗa ngau.<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>“Patǝ sǝˈyar kau, yi nar hyi tsu yi ǝnga hyi. <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>Ama ndǝr dlǝwa dzau, Mambǝl Cicau, kǝra Dǝɗa wu nda sǝwa wu thlǝmǝ ɗa, ju nda highiɓǝr hyi patǝr sau, ǝnga ju nda ɗǝngar hyi patǝr sǝra yi saya na anǝ hyi.<verse eid="JHN 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27"/>“Yu piyari hyi ǝnga huɗǝ pǝrtǝu. Huɗǝ pǝrtǝ ɗa nga yu nǝ hyi. Aˈyi ǝnggǝr kǝra njir duniya wu lǝ nga yu lǝ mai. A sara hya hivǝr mai, ǝnga hya sara piyari huɗa hyi a ndzǝ ǝnga hangǝkala hyi a hyaˈari mai.<verse eid="JHN 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28"/>“A nggar hyi ǝnggǝra yi na, abǝr, ‘Maˈyi nga yau, yu ɓǝra sha shili.’ Ma jiri nga hyu yiwu ɗa, hya caguli, ara yu maˈyi a dara Tada, arya Tada a ndiya ɗa ǝnga dǝgalǝu. <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>Yi nar hyi abangau tsu ji gǝra ɗa, aga ma ji ɗarkǝr hya daɓaga hǝnggǝri. <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/>Tsu yu ɓǝra nda ndǝr anǝ hyi gangǝ mai, ara ndǝra vǝr sǝm tǝlkur ar kǝra duniya wu shili. Naja aˈyi ǝnga dǝnama ar kǝra yi mai. <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>Ya vǝr mǝl patǝr sǝra Tada na ya mǝl, aga njir duniya a sǝni abǝr yu yiwu Tada. Shili a mau, mǝna piyari vi kau.”<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">Yesu Ngǝ Wur Ndǝrma Nǝ Jijiri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>“Nayi ngǝ wur ndǝrma nǝ jijiri, Dǝɗa ngǝ thlagǝr fa. <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>Kalar tsa wu kǝra gǝra pǝ wazha ba dǝɗa thlana nyi. Ama kalar tsa wu kǝra wu pǝ wazha, ba dǝɗa tsatsaˈwuna nyi aga ja ɓǝra pǝ wazha gangǝu. <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>Kabangǝkǝ cici nga hyi, arya ndǝr ɗa kǝra yi nar hyi. <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>Hya nggya wu yau, nayi tsu wu hyi. Tsa wu aˈyi a sǝn pǝ wazha ar kǝrnyi mai, kǝl ma ji nggya ar mamar wu. Abangǝ tsu nahya ma aˈyi hya sǝn pǝ wazha ar kǝrhyi mai, kǝl ma hyi nggya wu yau.<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>“Nayi ngǝ wur ndǝrma, nahyi ngǝ tsa nyiˈyar. Kalar ndǝra nggya wu yau ǝnga nayi wu ja, ju pǝ wazha gangǝu. Ma aˈyi wu yi nga hyi mai, sǝ aˈyi hyu sǝn mǝliya mai. <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>Kalar ndǝra aˈyi wu nggya wu yi mai, kakalǝ nga ja ǝnga tsa wu kǝra nji thlana, ba ji ulǝnakǝr. Nju sǝn tsǝmiya nda, ba nja puwa a gwu uˈu, ba nja nggyina nda. <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>Ma hyi nggya wu yau, ǝnga ndǝr ɗa nggya wu hyi tsu, hyu sǝn yiwa ɗa kalar sǝra hyu cim ba Hyal a nǝ hyi. <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>Sǝra wu shili ǝnga kadakadarkur anǝ Dǝɗa, ca ngǝ hya pǝ wazha gangǝu. Lagu kǝ nga hyu cabiya abǝr nahyi zǝmbǝlma ɗa ngau.<verse eid="JHN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9"/>“Ənggǝr kǝra Dǝɗa cabiya ɗa yiwukur, abangǝ nga yi cabiya hyi yiwukur tsu. Nahyi tsu hya nggya wu yiwukur ɗa. <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>Ma hyi ɓǝlar dlaɗǝ ɗa, hyu nggya wu yiwukur ɗa, ǝnggǝr kǝra yi ɓǝlar dlaɗǝ Dǝɗa, ba yi nggya wu yiwukur nyi tsu. <verse eid="JHN 15:10"/><verse number="11" style="v" sid="JHN 15:11"/>Yi na anǝ hyi abangau aga caguli ɗa a nggya wu hyi, ǝnga aga cagulir hyi a nyabiya dzau. <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>Dlaɗǝ ɗa ca ngǝ, hya yiwu kǝrhyi, ǝnggǝr kǝra yi cabiya hyi yiwukur. <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>Yiwukur kǝra a ndiya patǝu, ca ngǝ nda lǝr piya ja arya bazhi nyiˈyar. <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>Nahyi bazhi ɗa ngǝˈyar, ma hyi ɓǝlar dlaɗǝ ɗa. <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>Tsu yu ɓǝra ngga hyi ǝnga mafa mai, ara mafa aˈyi wu sǝn sǝra tarki nyi wu mǝl mai. Ama yu ngga hyi ǝnga bazhi, ara yi canǝ hyi patǝr sǝra yi nggari ara Dǝɗa. <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>Nahyi ngǝ caɗǝbiya ɗa mai, ama nayi ngǝ caɗǝbiya hyi, ǝnga yi sǝwa hyi aga hya nda pǝ wazha kǝra wu nggya baˈanuwa. Ba Dǝɗa dzǝgwa nǝ hyi kalar sǝra hyu kǝdiyau wu thlǝmǝ ɗa. <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>Kǝja, dlaɗǝ kǝra yi nǝ hyi, hya yiwu kuvwar hyi.<verse eid="JHN 15:17"/></para>
  <para style="s1">Njir Duniya Piyari <optbreak/> Shishir Dza Njir Nu</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>“Ma njir duniya piyari shishir dza hyi, hya sǝni abǝr nayi nga ndǝ piyari shishir dza nyi tanggǝrma. <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>Maja abǝr nǝ njir duniya nga hyi, njir duniya a cabiya hyiri yiwukur. Ama ara kǝ nahyi aˈyi nǝ duniya mai, ǝnga nayi ngǝ caɗǝbiya hyi sara wu duniya, ca ngǝ mǝliya njir duniya piyari shishir dza hyi. <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>Hya ɗǝngari ndǝr kǝra yi saya na anǝ hyi, abǝr, ‘Mafa a sǝn ndiya tarki nyi mai.’ Ma ndǝ nǝ ɗa ɓwaɓwatǝu, ndu nda nǝ hyi ɓwaɓwatǝ tsu. Ma ndǝ mǝl thlǝr ǝnga highiɓǝ ɗa, ndu nda mǝl thlǝr ǝnga nǝr hyi tsu. <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>Ndu nda mǝl sǝˈyar patǝ anǝ hyi abangau, arya thlǝmǝ ɗa, ara nandǝ wu sǝni ndǝra sǝwa ɗa mai. <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>Ma abǝr aˈyi yi shili, yi sa ndǝr anǝ nda mai, nanda aˈyi njir bikǝ mai. Ama kabangǝkǝ, sǝ aˈyi ndu uya nda na arya bikǝr nda mai. <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>Kalar ndǝra piyari shishir dza yau, a piyari ja nǝ Dǝɗa tsu. <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>Maja abǝr aˈyi yi mǝliya wu pama nda sǝra ndǝ aˈyi saya mǝliya mai, nandǝ wu ɗa njir bikǝ mai. Ama kabangǝkau, a lar nda sǝ dǝdǝgur kǝra yi mǝlna, ama alaga abangau, kǝ ndǝ piyari shishir dza yau ǝnga nǝ Dǝɗa tsu. <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>Ama sǝ kǝ ɗarkǝr aga ja nyabiya sǝra tsǝtsǝfǝ wu dlaɗǝr nda, abǝr, ‘Ndǝ piyari shishir dza yi gǝra ǝnga sǝra yi ndzana.’<verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>“Yi wu nda sǝwa hyi ndǝr dlǝwa dzǝ sara dara Tada. Naja ngǝ Mambǝl jiri kǝra shida sara dara Tada, ju nda sa lǝr sakida ar kǝra yau. <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>Nahyi ma, hyu nda lǝr sakida ar kǝra yau, ara tsu tanggǝrma ǝnga yi nga hyi.<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>“Yi nar hyi sǝˈyar kǝ patǝu, ara hya sara pǝna mbǝrsar hyi. <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>Ndu nda kǝdlǝbiya hyi sara wu umbwa daɓǝ dzǝ njir Yahudiya. Pǝca vǝr shili ma, kǝra ma ndǝ tsǝya hyi, ba nda nggani abǝr thlǝr Hyal nga nda vǝr mǝl. <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>Ndu nda mǝl culi sǝˈyar kau, ara nandǝ wu sǝn Tada mai ǝnga nandǝ wu sǝn ɗa mai. <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>Ama yi nar hyi sǝˈyar kau, aga ma ndǝ ɗarkǝr, hya daɓaga ɗǝngari abǝr a nar hyir yau.</para>
  <para style="p" vid="JHN 16:4">“Nayi nar hyi sǝˈyar kǝ tsu kaɗǝ mai, ara tsu yi ǝkkǝˈyi hyi.”<verse eid="JHN 16:4"/></para>
  <para style="s1">Thlǝr Nǝ Mambǝl Cicau</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>“Kabangǝkau, maˈyi nga yi a dǝgya ndǝra sǝwa ɗa, ama wu pama hyi ndǝ aˈyi yiwar ɗa, ‘Nǝma nga gu maˈya?’ <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>Arya yi nar hyi sǝˈyar kau, kǝja hya nyabiyar dzǝ ǝnga huɗǝ ndzǝndzau. <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>Ama ya nar hyi jirkura nyi, nahyi ngu ɗahar mǝsahǝkura maˈyi ɗa kau. Ma nayi aˈyi maˈyi mai, ndǝr dlǝwa dzǝ kau, wu shili mai. Ama ma yi maˈyi, yu nda sǝwa hyi nyi a shili ara hyi. <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>Ar pǝci kǝra ndǝr dlǝwa dzǝ kǝ shili, ju sa cabiya nyi anǝ njir duniya abǝr ɗǝngar nda ar kǝra bikau, ǝnga tsapǝkur ǝnga numa aˈyi kakalǝ mai. <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>Ɗǝngar nda ar kǝra bikau, aˈyi kakalǝ mai ara nandǝ hǝnggǝri ǝnga yi mai. <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>Ɗǝngar nda ar kǝra tsapǝkur, aˈyi kakalǝ mai ara maˈyi nga yi a dǝgya Dǝɗa, vira tsu hyu ɓǝra nda lar ɗa mai. <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>Ɗǝngar nda ar kǝra numa, aˈyi kakalǝ mai ara a mǝlnar nji numa anǝ ndǝr sǝm tǝlkur ar kǝra duniya.<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>“Aˈyi yi ǝnga sǝr na gangǝ kǝra hiyau ya kyaga nar hyi kabangǝkau, ama nahya sǝn sǝsǝˈwuri nda kwatahǝ mai. <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>Ama ar pǝci kǝra Mambǝl nǝ jiri shili, ju sa lǝbiya hyi a ndu sǝra jiri patǝu. Naji wu ndǝr wu dǝnamar kǝrnyi mai, sǝra ji nggari nga ju na, ǝnga ju nda nar hyi ar kǝra sǝra a vǝr shili. <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>Ju nda shili ǝnga kadakadarkur anǝ ɗa, lagur nar hyi patǝr sǝra ji nggari ara yau. <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>Patǝr sǝra nǝ Dǝɗa, nǝ ɗa ngau. Ca ngǝ sǝra ɗa yi na, abǝr Mambǝl wu nda dlǝwuri sǝra ara yau, ba ja nǝ hyi.<verse eid="JHN 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>“Ayukuɗa pida kushu nahyi wu ɓǝra lar ɗa mai, ayukuɗa pida kushu wayu ba hya ɓǝra lar ɗa.”<verse eid="JHN 16:16"/></para>
  <para style="s1">Huɗǝ Ndzǝndzǝ Zǝmbǝlma ˈyar <optbreak/> Wu Nda Sha Aga Huɗǝ Pipida</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>Əngwar alenyi zǝmbǝlma nyiˈyar anǝ kuvwar nda, “Mi nga ju ɗǝnga ǝnga ndǝr ka, ‘Ayukuɗa pida kushu nahyi wu ɓǝra lar ɗa mai, ǝnga ayukuɗa pida kushu ba hya ɓǝra lar ɗa wayu ka’? Ənga tsu mi ngǝ ɗǝnga nyi ǝnga ji na, ‘Ara maˈyi nga yi a dǝgya Dǝɗa ka’?” <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>Ndǝ dumwa ǝnga yiwa kǝrnda, “Mi ngǝ ɗǝnga nyi ǝnga ‘ayukuɗa pida kushu ka?’ Namǝn aˈyi nggabiya sǝ kǝ ju na kǝ mai.”<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>Yesu tsambiya abǝr zǝmbǝlma nyiˈyar ndu yiwu nda yiwa nyi ar kǝra sǝ kau, kǝ ji na anǝ nda, “Hyu yiwa kǝrhyi ar kǝra sǝra yi na, abǝr, ‘Ayukuɗa pida kushu tsu hyu lar ɗa mai, ǝnga ayukuɗa pida kushu ba hya ɓǝra lar ɗa wayu kǝ’ ya? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>Jiri nga yu na anǝ hyi, hyu nda tiwi, hya pǝ sǝlǝm, ama njir duniya kǝl caguli nga ndu caguli. Hyu nda ndzǝ huɗǝ gagaɗau, ama ndzǝ huɗǝr hyu nda sha aga huɗǝ pipida. <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>Ma mala ar tsǝkar ya, ɓwaɓwatǝ nga ja a gwa ara pǝci nyi a ɗari. Ama ma zǝr a biyari, ba ja faˈari ǝnga ɓwaɓwatǝ kǝra ji a gwa, ara huɗǝ pipida nǝ zǝr kǝra shili wu duniya. <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>Abangǝ ngǝ nga nyi ǝnga hyi. Kabangǝkau, pǝcir ndzǝ huɗǝr hyi ngau, ama yu ɓǝra nda lar hyi wayu, ba huɗa hyi a dzǝgwa pida. Huɗǝ pipidar hyi tsu, ndǝr sǝn dlǝwuri ara hyi aˈyi mai. <verse eid="JHN 16:22"/><verse number="23" style="v" sid="JHN 16:23"/>Ar pǝci ta, tsu hyu yiwa sǝ ara yi mai. Yu nar hyi jiri, Dǝɗa wu nda nǝ hyi kalar sǝra hyi yiwa wu thlǝmǝ ɗa. <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>Baˈanǝ kabangǝkau, sǝ aˈyi kǝra hyi yiwa wu thlǝmǝ ɗa mai. Yiwa mau, ba nja nǝ hyi, aga huɗǝ pipidar hyi a nyabiya dzau.<verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>“Yi ndǝr anǝ hyi ǝnga karapǝ aga ya nar hyi sǝˈyar kau, ama pǝci wu shili tsu yu nda ndǝr ǝnga karapǝ mai ama yu ndǝr ar kǝra Dǝɗa ar babal. <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>Wu pǝci ta, hyu nda kǝdi sǝ wu thlǝmǝ ɗa. Nahyi ngu nda kǝdi Dǝɗa ǝnga kǝrhyi aˈyi nayi nga kǝdi anǝ hyi mai. <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>Ara Dǝɗa ǝnga kǝrnyi wu yiwu hyi ara hyi cabiya ɗa yiwu dzǝ ǝnga hyi hǝnggǝri naja ngǝ sǝwa ɗa a shili. <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>Yi shili wu duniya sara ara Tada, kabangǝkǝ piyari nga yi duniya, ya ɓǝra sha a dǝgya Tada.”<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>Kǝ zǝmbǝlma nyiˈyar na anǝ nyi, “Ənghǝng! Kabangǝkau, nga gu ndǝr ar babal gǝra ǝnga karapau. <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>Kabangǝkau, nga ˈyi wu sǝni abǝr sǝ aˈyi ɗǝɗǝwa anǝ ngǝ mai. Gu sǝn nar nyi anǝ ndau, sǝra ju yiwu ja yiwa ngau. Kau, a mǝliya ri ˈyi hǝnggǝri, ǝnga jiri sara ara Hyal nga gau.”<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>Kǝ Yesu shaɗǝwa nda, ji na, “Kabangǝkau, a hǝnggǝri hyi ǝnga nyi ya?” <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>Pǝca vǝr shili, kǝja a ɗari, kǝra kalar ndu nda tǝtǝlnakǝr, ba kalar ndǝ a hwinakǝr a vu ki nyi, ba hya piyari ɗa zhizhi ɗa. Ama alaga abangau, aˈyi yi zhizhi ɗa jijiri mai, ara Tada aˈyi ja ǝnga yau.<verse eid="JHN 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33"/>“Yi wu na sǝˈyar kǝ anǝ hyi ara wu yi nga hyu uya huɗǝ pǝrtǝu. Wu duniya kǝ hyu nda lar ɓwaɓwatǝu, ama hya sǝsǝˈwuri ara a sǝmkur yi tǝlkur ar kǝra duniya.”<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">Yesu Kǝdi Hyal Aga Kǝrnyi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>Ayukuɗa Yesu nana ndǝrˈyar kau, kǝ ji hyaˈanakǝr a dǝmǝlmǝ ji kǝdi Hyal, ji na, “Tada, pǝci a ɗari. Ga nǝ nyi kadakadarkur anǝ Zǝr ngau, aga naja tsu ja shili ǝnga kadakadarkur anǝ ngau. <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>Ara gǝ nǝ nyi dǝnama anǝ Zǝr ngau ar kǝra nji patǝu, aga ja lǝr pi gǝra kuɗau anǝ patǝr njira gǝ nǝ nyi. <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>Pi gǝra kuɗau, ca ngǝ nja sǝn ngau, nagǝ kǝra Hyal nǝ jijiri wacu, ǝnga Yesu Kǝrsiti, ndǝra gǝ sǝwa a shili. <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>Yi dla ǝnga kadakadarkur anǝ ngau wu duniya lagur mǝlna thlǝr kǝra gǝ nǝ ɗa aga ya mǝl. <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>Kabangǝkau, Tada, nǝ ɗa kadakadarkur kabangǝkǝ wu mwa ngau, culi kadakadarkur kǝra aˈyi yi ǝni ǝnga gǝ ta kadivira duniya ɗarkǝr.<verse eid="JHN 17:5"/></para>
  <para style="s1">Yesu Kǝdi Hyal Anǝ Zǝmbǝlma Nyiˈyar</para>
  <para style="pm">
    <verse number="6" style="v" sid="JHN 17:6"/>“A cabiya ngǝr yi abǝr wa nga ga anǝ njira gǝ nǝ ɗa wu duniya. Njira ɗǝɗǝmǝ nǝ ngǝ nga nda, ama ba gǝ nǝ ɗa nda, nanda tsu a ɓǝlar nda ndǝr ngau. <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>Kabangǝkau, wu sǝn nda abǝr kalar sǝra aˈyi ara yau, sara ara gǝ nga nyi. <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>Ara kalar ndǝr kǝra gǝ nar ɗa, a nar ndar yau, ba ndǝ dlǝwuri. Ənga jiri ndu sǝni abǝr sara ara gǝ nga yau, ǝnga a hǝnggǝr nda abǝr nagǝ ngǝ sǝwa ɗa. <verse eid="JHN 17:8"/><verse number="9" style="v" sid="JHN 17:9"/>Ya vǝr kǝdiyau, arya nda. Nayau, aˈyi a vǝr kǝdiyau, arya duniya patǝ mai, ama arya njira gǝ nǝ ɗa, ara nǝ ngǝ nga nda. <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>Patǝr njira ara yau, nǝ ngǝ ngau, ǝnga tsu patǝr njira ara gau nǝ ɗa ngau. A uyar yi kadakadarkur lagur nda. <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/>Kabangǝkau, ya vǝr sha a da ara gau, ara pǝcir nggya ɗa wu duniya a kuɗǝri, ama nanda, tsu nda wu duniya. Tada, Ndǝ Cicau, ga kǝtiya nda ǝnga dǝnamar thlǝmǝ ngau, thlǝmǝ ngau kǝra gǝ nǝ ɗa, aga nda ɗa zǝmǝ ǝnggǝr kǝra ma ǝnga gau. <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>Ar pǝci kǝra yi tsu ǝnga nda, yi kǝtiya lagur dǝnamar thlǝmǝ ngau, thlǝmǝ ngau kǝra gǝ nǝ ɗa. A ɓǝlar ndar yau, ndǝ aˈyi kǝra sa wu pama nda mai, kǝl ndǝ sasa ta aga ndǝr Hyal a nyabiya dzau.<verse eid="JHN 17:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="JHN 17:13"/>“Kabangǝkau, kǝja ya vǝr sha a da ara gau, ama yu na sǝˈyar kǝ tsu yu duniya aga njir nu ɗa nda nyabiya dzǝ ǝnga caguli wu ɗǝfuwa nda. <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>A nǝ ndar yi cama ngau, ba njir duniya piyari shishir dza nda, ara nanda aˈyi nǝ duniya mai, ǝnggǝr kǝ nayau, aˈyi yi nǝ duniya mai. <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>Nayi kǝdiyau, aga ga faˈabiya nda sara wu duniya mai, ama aga ga kǝtiya nda ara ndǝ ɗǝmwaˈyi kau. <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>Nanda aˈyi nǝ duniya mai, ǝnggǝr kǝ nayi aˈyi yi nǝ duniya mai kau. <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>Ga cina nda lagur jiri, ndǝr ngau jiri ngau. <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>Ənggǝr kǝra gǝ sǝwa ɗa a shili wu duniya, abangǝ nga yi sǝwa nda a ndu duniya tsu. <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>Arya nda nga yi lǝr kǝrɗa, aga thlǝr cici kau, aga nanda tsu nda ɗa cicau lagu jirkur.<verse eid="JHN 17:19"/></para>
  <para style="s1">Yesu kǝdi Hyal Ar Kǝra Patǝr Njir Nu</para>
  <para style="pm">
    <verse number="20" style="v" sid="JHN 17:20"/>“Kǝdi ɗa aˈyi anǝ nda waci mai, ama anǝ kalar njira wu nda hǝnggǝri ǝnga yi lagur camar nda. <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>Tada, kǝdi ɗa, bǝgǝ nda ɗa zǝmǝu, ǝnggǝr kǝra ma ǝnga gau. Bǝgǝ nda ɗa zǝmǝ wu ma, aga njir duniya a sǝni abǝr nagǝ ngǝ sǝwa ɗa. <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>A nǝ ndar yi kadakadarkur kǝra gǝ nǝ ɗa, aga nda ɗa zǝmǝ ǝnggǝr kǝra ma zǝmǝu. <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>Yu nda nggya wu nda, ǝnga nagǝ tsu wu yau, aga nda ɗa zǝmǝ ǝnga jiri. Lagu kǝ ngǝ njir duniya wu nda sǝni abǝr nagǝ ngǝ sǝwa ɗa, ǝnga nda sǝni gu yiwu nda ǝnggǝr kǝra gu yiwu ɗa.<verse eid="JHN 17:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="JHN 17:24"/>“Tada, cim ɗa, ca ngǝ njira gǝ nǝ ɗa, nda nggya ǝnga yi ar vira ya ri. Yu cim nda lari kadakadarkur ɗa, kadakadarkur kǝra gǝ nǝ ɗa arya gu yiwu ɗa kadivira gǝ mǝliya duniya.<verse eid="JHN 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="JHN 17:25"/>Tada, ndǝ tsapǝu, njir duniya wu sǝni ngǝ mai, ama nayau, yu sǝn ngau ǝnga nanda nǝr nda, ndu sǝni abǝr nagǝ ngǝ sǝwa ɗa. <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>A cabiya ngǝr yi anǝ nda ǝnga yu nda dumwa ǝnga ca ngau anǝ nda. Lagu kǝ ngǝ yiwu kǝra gu yiwu ɗa wu nda nggya wu nda ar babal, ǝnga nayi ǝnga kǝrɗa wu nda nggya wu nda.”<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">Nji Ɗǝlna Yesu Ba Nji Mbar Nyi</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matiwu 26:47-56</ref>; <ref loc="MRK 14:43-50">Markusu 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>Ayukuɗa Yesu kuɗǝna kǝdi Hyal, ba ji tǝrabiya ǝkkǝˈyi zǝmbǝlma nyiˈyar a biyar ya dagǝ Kiduronu. A biyar ya dagǝ kau, vanyi masǝmǝ aˈyi, ba Yesu ǝkkǝˈyi zǝmbǝlma nyiˈyar maˈyi a vuwa gwa. <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>Yahuda, zǝmbǝlma Yesu kǝra thlǝna hiya ja wu sǝn vi kau, ara Yesu ǝkkǝˈyi zǝmbǝlma nyiˈyar wu yiɗaga daɓǝ dzǝ a gwa. <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>Kǝ Yahuda shili wu masǝmǝ kau, ji dumwa ji ca lagu anǝ bwata sojaˈyar, ǝnga njir ɓǝla ki Hyal kǝra pubu dǝdǝgalˈyar ǝnga njir Farisi sǝwa. Ndǝ shili ǝnga uˈur tǝsǝ ba pitǝlla ǝnga kar pa. <verse eid="JHN 18:3"/><verse number="4" style="v" sid="JHN 18:4"/>Yesu, ara ju sǝni sǝra wu nda ɗa ǝnga ja, ba ji biya, ji biya yiwa nda, “Wa nga hyu gala?”<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>Kǝ ndǝ shaɗǝwa nyi, ndǝ na, “Yesu ndǝ sara wu Nazǝratu.” Əngwar Yesu anǝ nda, “Nayi ngau.” Yahuda ndǝra thlǝna hiya Yesu aˈyi ja tataˈyi ǝkkǝˈyi nda. <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>Ənggǝra Yesu na, “Nayi ngau,” ba ndǝ sha dǝ ndǝl dǝ ndǝl, ba ndǝ dlanakǝr a gyiwu ˈyi. <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>Kǝ Yesu ɓǝra yiwa nda, ji na, “Wa nga hyu gala?” Əngwar nda, “Yesu ndǝr Nazǝratu.”<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>Əngwar Yesu anǝ nda, “A nar hyir yi abǝr nayi ngau. Ma nayi nga hyu gal, hya piyari nji kau, nda maˈyi.” <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>Sǝkǝ ɗarkǝr aga ja nyabiya ndǝr kǝra ji nana, “Nayi aˈyi tini alaga ndǝ zǝmǝ wu njira gǝ nǝ ɗa mai.”<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>Simanu Biturusu ndǝra aˈyi ǝnga katsakǝr ara ja, ba ji tsǝbiya katsakǝr nyi, ba ji thlana himi mazǝma mafa nǝ pubu kǝra ndiya ǝnga dǝgalǝu. Thlǝmǝr mafa kǝ ca ngǝ Malkusu. <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/>Kǝ Yesu nar nyi anǝ Biturusu, “Shabiya katsakǝr ngau a gwu ki nyi. Aˈyi kyau ya tǝwari sara wu kyakiwa nǝ ɓwaɓwatǝ kǝra dǝɗa nǝ ɗa kǝ wa?”<verse eid="JHN 18:11"/></para>
  <para style="s1">Yesu Shili Wu Mwar Anasu</para>
  <para style="r">(<ref loc="MAT 26:57-58">Matiwu 26:57-58</ref>; <ref loc="MRK 14:53-54">Markusu 14:53-54</ref>; <ref loc="LUK 22:54-57">Luka 22:54-57</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>Kǝ bwata sojaˈyar ta ǝnga dǝgalǝr nda, daɓǝ ǝnga njir ɓǝla ki Hyal mbar Yesu, ba ndǝ mbiya nyi. <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>Tanggǝrma, ba ndǝ hǝr nyi a ndǝgya Anasu, ara naja sǝlku sal nǝ Kayafasu. Wu fa ta, Kayafasu ngǝ pubu kǝra ndiya ǝnga dǝgalǝu. <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>Kayafasu ngǝ lǝr sawara anǝ njira nggurǝm nǝ Yahudiya abǝr a ɗari tsaˈa ndǝ zǝmǝ a tǝ arya nji.<verse eid="JHN 18:14"/></para>
  <para style="s1">Biturusu Kǝpalna Sǝni Yesu</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>Kǝ Simanu Biturusu ǝnga pathlǝ wu pama zǝmbǝlma nǝ Yesu ndu nu Yesu wu ndǝl wu ndǝl. Ara pubu kǝra ndiya ǝnga dǝgal wu sǝni najaka zǝmbǝlma nǝ Yesu, ba ji piyari nyi aga ja vu huɗǝ ki nǝ pubu kǝra ndiya ǝnga dǝgal ǝnga Yesu. <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>Ama Biturusu nǝ nyi ba ji taˈyi a biya miya ki, a biya. Kǝ zǝmbǝlma kǝra pubu kǝra ndiya ǝnga dǝgal kǝ wu sǝni kau, biya ji biya ndǝr anǝ kwa kǝra a vǝr ɓǝla miya ki, ba ji vu ǝnga Biturusu.<verse eid="JHN 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17"/>Kǝ kwa ɓǝla miya kiya nyi, na anǝ Biturusu, “Nagǝ ma, pathlǝ gau wu pama zǝmbǝlma nyi, ǝndǝga?”</para>
  <para style="p" vid="JHN 18:17">Kǝ ji shaɗǝwa, ji na, “Awau, nayi a gwa mai.”<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>Ara shishiˈwu kǝra vi, agabangǝ kǝ mafaˈyar ǝkkǝˈyi njir ɓǝla ki Hyal mbǝbiya uˈu tataˈyi nda, ndu ɗaha. Biturusu tsu aˈyi ja wu pama nda taˈyu ju ɗaha uˈu.<verse eid="JHN 18:18"/></para>
  <para style="s1">Pubu Kǝra Ndiya Ənga Dǝgalǝu <optbreak/> Yiwa Miya Yesu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Matiwu 26:59-66</ref>; <ref loc="MRK 14:55-64">Markusu 14:55-64</ref>; <ref loc="LUK 22:66-71">Luka 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>Kǝ pubu kǝra ndiya ǝnga dǝgal yiwa miya Yesu ar kǝra zǝmbǝlma nyiˈyar ǝnga highiɓǝ nyi. <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Ndǝr ɗa, ar babal nga yi na anǝ nji patǝu, yi highiɓǝ wu umbwa daɓǝ dzǝ njir Yahudiya ǝnga wu ki Hyal vira daɓǝ nǝ njir Yahudiya ari ar babal. Sǝ aˈyi kǝra yi na ɗǝɗǝwa mai. <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>Mi ngǝ ɗa gu yiwa miya ya? Yiwa miya njira nggar sǝra yi na. A nggabiyar nda sǝra yi nana.”<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>Ənggǝra Yesu nana abangau, kǝ vanyi ndǝr ɓǝla ki Hyal kǝra lǝha dzǝr nyi nǝ nyi tsǝbalma, ǝngwar ja anǝ nyi, “Abangǝ nga nju ndǝr anǝ pubu kǝra ndiya ǝnga dǝgal ya?” <verse eid="JHN 18:22"/><verse number="23" style="v" sid="JHN 18:23"/>Yesu shaɗǝwa nyi, ji na, “Ma yi nana sǝra aˈyi tsaˈa mai ba ga cabiya ɗa, ama ma yi nana sǝra tsaˈa, mi ngǝ ɗa gǝ dǝgǝ ɗa?” <verse eid="JHN 18:23"/><verse number="24" style="v" sid="JHN 18:24"/>Kǝ Anasu sǝwa nyi mbamba a ndǝgya Kayafasu ndǝra naja ngǝ pubu kǝra ndiya ǝnga dǝgalǝu.<verse eid="JHN 18:24"/></para>
  <para style="s1">Biturusu Ɓǝra Kǝpalna Sǝni Yesu</para>
  <para style="r">(<ref loc="MAT 26:71-75">Matiwu 26:71-75</ref>; <ref loc="MRK 14:69-72">Markusu 14:69-72</ref>; <ref loc="LUK 22:58-62">Luka 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>Ma tsu Simanu Biturusu taˈyi ar vi ta, ja vǝr ɗaha uˈu, kǝ nji yiwa nyi, “Nagǝ ma pathlǝ gu pama zǝmbǝlma nyi ya, ǝndǝga?”</para>
  <para style="p" vid="JHN 18:25">Kǝ ji kǝpalna, ji na, “Nayi a gwa mai.”<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>Pathlǝ wu pama mafa nǝ pubu kǝra ndiya ǝnga dǝgalǝu, kǝra zamǝya ndǝ ta Biturusu thlana himiya ja ta, ka na anǝ nyi, “Mi nga gu na ka? Aˈyi gǝ pathlǝ wu pama njira yi lari nyi ǝnga ja wu masǝmǝ ta wa?” <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/>Kǝ Biturusu ɓǝra kǝpalna, ǝnggǝrna kǝ vǝgǝmǝ wau.<verse eid="JHN 18:27"/></para>
  <para style="s1">Yesu Wu Mwar Bilatusu</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matiwu 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Markusu 15:1-5</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>Əmudlǝ kaɗǝ kǝ njira nggurǝm nǝ Yahudiya lǝbiya Yesu sara wu ki Kayafasu a ndar pathla nǝ gwamna nǝ Roma. Kǝ ndǝ nggǝl ara vu pathla nyi ara nda sara ɗa diyadiyaɓǝu ba ja kar nda ara sǝm lardur nǝ vǝlna. <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>Agabangau, kǝ Bilatusu biya thlǝwa nda a biya, ba ji yiwa, “Mi ngǝ vazǝ kǝra hyi shili ǝni a miya ndǝla ndǝ ka?”<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>Kǝ ndǝ shaɗǝwa nyi, ndǝ na, “Maja abǝr ndǝ kau, aˈyi ndǝ vavazǝ mai, naˈyu shili ǝnga ja ǝnggǝ mai.” <verse eid="JHN 18:30"/><verse number="31" style="v" sid="JHN 18:31"/>Əngwar Bilatusu anǝ nda, “Hǝr nya mau hya nda mǝliya nyi numa ar kǝrhyi ǝnggǝra dlaɗǝr hyi nana.” Əngwar njir Yahudiya anǝ nyi, “Nji aˈyi nǝ ˈya dǝnama nǝ thla numa nǝ tǝ anǝ ndǝ mai.” <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>Sǝkǝ ɗarkǝr aga ja nyabiya sǝra Yesu nana ar kǝra culi tǝ kǝra ju nda tau.<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>Kǝ Bilatusu sha a vu pathla, kǝ ji ngga Yesu, ji yiwa nyi, “Ɗǝm ya, nagǝ ngǝ tǝl nǝ njir Yahudiya ya?” <verse eid="JHN 18:33"/><verse number="34" style="v" sid="JHN 18:34"/>Yesu shaɗǝwa nyi, ji na, “Sara ara gau ngǝ ndǝr kǝ hyaˈari ya, ǝndǝga nji ngǝ ndǝr anǝ ngau ar kǝra yi ya?”<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>Əngwar Bilatusu anǝ nyi, “Ndǝr Yahudiya yi ya? Aˈyi nji gǝ hyi ǝnga pubu dǝdǝgalˈyar ngǝ shili ǝnga gǝ ǝnggǝ wa? Mi gǝ mǝliya?” <verse eid="JHN 18:35"/><verse number="36" style="v" sid="JHN 18:36"/>Yesu shaɗǝwa nyi, “Tǝlkur ɗa, aˈyi ǝnggǝr nǝ duniya mai. Maja abǝr tǝlkur ɗa ǝnggǝr nǝ duniya, njir mǝl thlǝr ɗa ndu pa ba nda kar njir Yahudiya ara mbar ɗa. Ama pakatǝu, tǝlkur ɗa sara ar vi pamǝ nga nyi.” <verse eid="JHN 18:36"/><verse number="37" style="v" sid="JHN 18:37"/>Əngwar Bilatusu anǝ nyi, “Ɗǝm ya, tǝl nga gǝ ya?” Kǝ Yesu shaɗǝwa, ji na, “Kakalǝ nga nyi, ǝnggǝr kǝra gǝ na, tǝl nga yau. Sǝra ɗa nji yabiya ɗa, ǝnga sǝra yi shili wu duniya aga nyi, aga ya nana sǝra jiri. Kalar ndǝra wu yiwu jiri, ju sǝ himi sǝra yu na.”<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>Bilatusu yiwa miya Yesu, ji na, “Mi ngǝ jira nya?” Kǝ Bilatusu ɓǝra biya a biya ǝgya njir Yahudiya, ji biya na anǝ nda, “Nayi thlǝwa nyi ǝnga vazǝ mai. <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>Ama a ɗari sǝr cijir hyi aga ya sǝya hyi ndǝr fursǝna pathlǝ wu lardur vǝlna kau. Hyu yiwu ya sǝya hyi ‘Tǝlǝr njir Yahudiya’ ya?”<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>Kǝ ndǝ ɓǝra shaɗǝwa nyi, ndu wau ndu na, “Awau, naja mai. Sǝya ˈya Barabasu.” (Ama ja hya sǝni, Barabasu ndǝr ɗalagu ngau.)<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="s1">Nji Thlana Nyi Numa Nǝ Tau Anǝ Yesu</para>
  <para style="r">(<ref loc="MAT 27:15-31">Matiwu 27:15-31</ref>; <ref loc="MRK 15:6-20">Markusu 15:6-20</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>Kǝ Bilatusu sǝwa nji nǝ nyi wuɗa anǝ Yesu. <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>Kǝ sojaˈyar mǝliya dara shikǝɗi nǝ tǝlkur ba ndǝ har nyi anǝ Yesu. Kǝ ndǝ har nyi lǝgutǝ tuwara dǝzǝu kǝra ǝnggǝr nǝ tǝlkur. <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>Ndǝ shili ǝgya ja, ar kǝr ar kǝr ndu na anǝ nyi, “Ənga barka ngau, ciwar, tǝlǝr njir Yahudiya!” Ba ndǝ nǝ nyi tsǝbalma.<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>Kǝ Bilatusu ɓǝra biya a biya ǝgya njir Yahudiya, ji biya na anǝ nda, “Kǝja yu biya ǝnga ja, ara yu yiwu hya sǝni abǝr nayi thlǝwa nyi ǝnga vazǝ mai.” <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>Ənggǝra Yesu biya ǝnga dara tǝlkur nǝ shikǝɗi a dar kǝra ja ǝnga lǝgutǝ tuwara dǝzǝu, kǝ Bilatusu na anǝ nda, “Kǝja nda nyi!”<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>Ta pubu dǝdǝgalˈyar ǝnga njir ɓǝla ki Hyal lari nyi, ba ndǝ hyaˈana ɗahǝu, ndu na, “Dlakǝya nyi! Dlakǝya nyi!” Ama kǝ Bilatusu shaɗǝwa nda, ji na, “Hǝr nya mau hya nda dlakǝya nyi sǝr hyi, arya nayi lari bikǝ nyi mai.” <verse eid="JHN 19:6"/><verse number="7" style="v" sid="JHN 19:7"/>Əngwar njir Yahudiya anǝ nyi, “Dlaɗǝr ˈya aˈyi, kǝra na a ɗar tsaˈa nja dlakǝya ndǝ kau, ja tau, ara ji hǝr kǝrnyi ar viya Zǝr Hyal.”<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>Ənggǝra Bilatusu nggar ndǝr kau, ba hivǝr nyi cakau. <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>Ba ji ɓǝra sha a vu huɗa pathla, ji vuwa yiwa Yesu, ji na, “Sara mani nga gǝ shila?” Ama Yesu aˈyi shaɗǝwa nyi mai. <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>Agabangau, ǝngwar Bilatusu anǝ nyi, “Gǝ nggǝl ara ndǝr anǝ ɗa ya? Aˈyi gu sǝni abǝr aˈyi yi ǝnga dǝnama nǝ sǝya ngau, ǝnga nǝ dlakǝya ngǝ wa?”<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>Kǝ Yesu shaɗǝwa nyi, ji na, “Dǝnama kǝra aˈyi ara gǝ ar kǝra yau, dǝnama kǝra Hyal nǝngǝ ngǝ wacu. Agabangau, ndǝra fuwa ɗa wu tsa gǝ nga ndiya ngǝ ǝnga bikau.”<verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>Ar kǝra ndǝr kǝ ngǝ Bilatusu wu yiwu ja sǝya Yesu, ama kǝ njir Yahudiya hyaˈana ɗahǝu ndu na, “Ma gǝ sǝya nyi ji maˈyi, nagǝ aˈyi bazhiya Kayisaru mai. Kalar ndǝra wu yiwu ja mǝliya kǝrnyi ar viya tǝl, dawa Kayisaru nga ja.”<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>Ənggǝra Bilatusu nggari ndǝr kau, ba ji hǝbiya Yesu a biya, ji biya nggya ar sǝr nggya nǝ pathla ar vira nji pǝdlǝya ǝnga tsǝka. Kǝra nju ngga ǝnga miya njir Yahudiya Gabathla. <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>Pǝci kau, pǝci taˈyi kǝr, pǝci kǝra nju fǝ sǝ wu lagu nju vu sugu nǝ lardur nǝ vǝlbiya. Əngwar Bilatusu anǝ njir Yahudiya, “Kǝja mǝ tǝlǝr hyi!”<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>Ama kǝ ndǝ hyaˈana ɗahǝu ndu na, “Tsǝya nyi! Tsǝya nyi! Dlakǝya nyi!”</para>
  <para style="p" vid="JHN 19:15">Kǝ Bilatusu yiwa nda, ji na, “Ya dlakǝya hyi tǝlǝr hyi ya?”</para>
  <para style="p" vid="JHN 19:15">Kǝ pubu dǝdǝgalˈyar shaɗǝwa, ndǝ na, “Vanyi tǝl aˈyi ara ˈya mai, kǝl tǝl Kayisaru.” <verse eid="JHN 19:15"/><verse number="16" style="v" sid="JHN 19:16"/>Agabangau, kǝ Bilatusu hǝri Yesu ji nǝr nyi anǝ njir Yahudiya aga nda dlakǝya nyi.</para>
  <para style="s1" vid="JHN 19:16">Nji Dlakǝya Yesu</para>
  <para style="p" vid="JHN 19:16">Kǝ sojaˈyar maˈyi ǝnga Yesu. <verse eid="JHN 19:16"/><verse number="17" style="v" sid="JHN 19:17"/>Yesu biya sara wu huɗa mǝlmǝ ja vǝr hǝ wu dladlakǝ nyi a ndar vira nja ngga ǝnga vir papangǝkǝr. Ənga miya njir Yahudiya nju ngga viya nyi ǝnga Gwalgwathla. <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>Ar vi kǝ nga nji dlakǝya Yesu, ǝnga nji mǝthlǝu, pathlǝ lagu mazǝma ja, ǝnga vanyi ndǝ lagu matsala ja. <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>Bilatusu tsǝfǝr sau, ba ji pathlǝri ar wu dladlakau. Kǝja sǝra ji tsǝfǝri, “Yesu ndǝr Nazǝratu, Tǝlǝr njir Yahudiya.” <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>Ara ji dlakǝya Yesu lǝhǝu wu dzǝr mǝlmau, ba mǝliya njir Yahudiya gangǝu jigana sǝra nji tsǝfǝri kau. Sǝra ji tsǝfǝri, ji tsǝfǝri wu miya njir Yahudiya, ǝnga miya njir Roma ba ǝnga miya njir Gǝrikǝu. <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>Kǝ pubu dǝdǝgalˈyar nǝ njir Yahudiya nar nyi anǝ Bilatusu, “Ga sara tsǝfǝ Tǝlǝr Njir Yahudiya mai, ama ga na, ǝngwar ndǝ kau, naja ǝngwa ngǝ Tǝlǝr njir Yahudiya.” <verse eid="JHN 19:21"/><verse number="22" style="v" sid="JHN 19:22"/>Əngwar Bilatusu anǝ nda, “Sǝra yi tsǝfǝri a tsǝfǝr yau.”<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>Ayukuɗa sojaˈyar kǝ dlakǝya Yesu, ba ndǝ faˈari kar ha nyi, ndǝ tǝkǝya bwata foɗǝu, kǝ kalar soja hǝri bwata pathlǝu. Ndǝ ɓǝra hǝri lǝgutǝ dzǝgamǝ nyi kǝra aˈyi nji mbǝ mai, ama tsa nga nji tsa mbari a du kǝr baˈa a gyiwu ndǝl. <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>Kǝ ndǝ na wu pama nda, “Mǝna sara ta lǝgutǝ kǝ mai, ama mǝna tǝɗǝ shiˈwu a miya ndǝla nyi mǝna lari ndǝra wu sǝmku.” Sǝˈyar kǝ ɗarkǝr aga ja nyabiya sǝra tsǝtsǝfau wu lǝkakaɗǝ nǝ Hyal kǝra na abǝr,</para>
  <para style="q1" vid="JHN 19:24">“Ndǝ tǝkǝya kar ha ɗa</para>
  <para style="q2" vid="JHN 19:24">wu pama nda,</para>
  <para style="q1" vid="JHN 19:24">ndǝ tǝɗǝ shiˈwu</para>
  <para style="q2" vid="JHN 19:24">ar kǝra lǝgutǝ ha ɗa.”</para>
  <para style="p" vid="JHN 19:24">Ya kǝja sǝra sojaˈyar kǝ mǝliya ngau. <verse eid="JHN 19:24"/><verse number="25" style="v" sid="JHN 19:25"/>Tataˈyi lǝha dzǝr wu dladlakǝ nǝ Yesu, ca ngǝ mǝnyi ǝnga kwamǝ nyi ǝnga Maryamu mala Kǝliyopasu ba Maryamu Magǝdaliya. <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>Ənggǝra Yesu lari mǝnyi a ndǝna ǝnga zǝmbǝlma kǝra ju yiwu ta tataˈyi lǝha dzǝr nyi, kǝ ji na anǝ mǝnyi, “Ama, kǝja zǝr ngau.” <verse eid="JHN 19:26"/><verse number="27" style="v" sid="JHN 19:27"/>Əngwar ja anǝ zǝmbǝlma kau, “Kǝja mǝ ngau.” Ənggǝ ngǝ zǝmbǝlma kǝ hǝr nyi a ndu ki nyi.<verse eid="JHN 19:27"/></para>
  <para style="s1">Tǝr Yesu</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>Yesu, ayukuɗa ji sǝnbiya abǝr kalar sǝ a kuɗǝri, aga sǝra tsǝtsǝfau a nyabiya dzau, kǝ ji na, “Hili wu tǝ ɗa.” <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>Ar pǝci kau, bǝlari aˈyi ǝna kǝra nyinyau ǝnga ˈyimi mwamwalu. Kǝ ndǝ ciwa sasaˈu a gwu ˈyimi mwamwala nyi, ba ndǝ ciri ar zǝwa ba ndǝ fuwa a du miya Yesu. <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>Ənggǝra ji tǝwari, ǝngwar Yesu “A kuɗǝri.” Ayukuɗa kǝ ba ji uzhiya kǝr, ba ji tau.<verse eid="JHN 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>Pǝci kau, pǝcir fǝ sǝ wu lagu nǝ pǝcir Ɓǝlsar ngau, ǝnga ǝzǝgǝkura nyi tsu pǝcir Ɓǝlsar kǝra pamǝ ara alenyi ngau. Agabangau, njir Yahudiya aˈyi wu yiwu nda piyari dza nda a dar wu dladlakǝ ar pǝci ta mai. Ba ndǝ yiwa Bilatusu aga ja piyari nda, nda ɓǝɓǝlna hiya nda aga kusar tǝr nda, ba nda hǝya dza nda sara dar wu dladlakǝr nda, ba ji nǝ nda lagu. <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>Kǝ sojaˈyar shili ndǝ sa ɓǝɓǝlna hiya ndǝ tanggǝrma kǝra nji dlakǝya ǝnga Yesu, ba ndǝ mǝliya nyi anǝ ndǝ nǝ mǝthlǝkura nyi tsu. <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>Ama ǝnggǝra ndǝ shili ǝgya Yesu, nandǝ ɓǝɓǝlna hiya ja mai, ara divira nda shili a tǝr ja. <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>Kǝ pathlǝu, wu pama sojaˈyar kǝ tsaviya Yesu ar thlǝrpa ja ǝnga katsakǝr, ba mashi daɓǝ ǝnga ˈyimi ndzǝndzǝ sara a gwa. <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>Ndǝra sǝkǝ ɗa wu liya ja, ngǝ lǝr sakida kau, sakida nyi jiri nga nyi. Naja ǝnga kǝrnyi wu sǝni abǝr sǝra ju na, jiri nga nyi, ǝnga ji lǝri sakida kau, aga nahyi tsu hya hǝnggǝri. <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>Sǝˈyar kǝ ɗarkǝr aga nyabiya sǝra tsǝtsǝfau wu lǝkakaɗǝ Hyal, “Alaga ɗǝhiya ja zǝmǝu, nju ɓǝlna mai.” <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>Vanyi ndǝr Hyal kǝra tsǝtsǝfǝ na, “Ndǝ wu nda tsamǝ ndǝra ndǝ tsaviya.”<verse eid="JHN 19:37"/></para>
  <para style="s1">Haɗǝ Dza Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matiwu 27:57-61</ref>; <ref loc="MRK 15:42-47">Markusu 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>A yukuɗu, kǝ Yusufu ndǝr Arimatiya naja ma zǝmbǝlma Yesu ngau, ama ar ɗǝwa, ara hivǝr njira nggurǝm nǝ Yahudiya. Ji sa yiwa Bilatusu aga ja nǝ nyi dza Yesu, kǝ ji nǝ nyi. <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>Yusufu maˈyi ǝnga Nikodimosu, ndǝra sǝ aˈyi shili ǝgya Yesu uvuˈyi ta. Nikodimosu maˈyi ǝnga muru gwagwaɗau ǝnga alosu kǝra sǝ kisǝ ar viya tsǝla pathlǝu. <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>Kǝ nanda kǝ mǝthlǝ kau, maˈyi ka nda hǝri, kǝ ndǝ pǝɗiya dza Yesu wu sǝr haɗǝ ndau, daɓǝ ǝnga sǝ kisǝ kau, ǝnggǝra njir Yahudiya wu haɗǝ ndau. <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>Lǝha dzǝr vira nji dlakǝya nyi ar kau, vanyi fa wu aˈyi. Wu fa wu kau, hu mafǝliyangǝ aˈyi kǝra nji gǝra sǝ aˈyi haɗǝna ndǝ a gwa. <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>Ta ɗa pǝcir fǝ sǝ wu lagu nǝ njir Yahudiya ngau, ba tsu huwa nyi lǝhǝ nga nyi, ba ndǝ haɗǝna dza Yesu wu huwa nyi.<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">Yesu Hyaˈari Sara Vir Tau</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matiwu 28:1-10</ref>; <ref loc="MRK 16:1-8">Markusu 16:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>Kaɗǝ ǝmudlau, ma tsu vi dlǝdlǝrǝu, ar pǝci nǝ tanggǝrma nǝ sugu, kǝ Maryamu Magǝdaliya maˈyi a nda tsamǝ huwa nyi. Ma ji nda ba ji lari kǝja nja jahǝnar tsǝka haɗǝ miya huwa nyi. <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>Kǝ ji sha ǝnga hwi a ndǝgya Simanu Biturusu ǝnga vanyi zǝmbǝlma kǝra Yesu wu yiwu ta. Kǝ ji na anǝ nda, “A hǝr nji dza Thlagǝ sara wu huwa nyi, kǝja naˈya sǝni vira nji fiya nyi ari mai.”<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>Kǝ Biturusu ǝnga vanyi zǝmbǝlma ta biya ndǝ mbar lagu ndar huwa nyi. <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>Gyapǝ nda mbar hwi, ama kǝ vanyi zǝmbǝlma ta ndiya Biturusu ǝnga hwi a ndar huwa nyi. <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>Ji nda uzhiya dzau, ju tsamǝ gwu huɗa huwa nyi, ba ji lari kar haɗǝ ndau a gwu huwa nyi, ama naji gwu huwa nyi mai. <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>Kǝ Simanu Biturusu ndǝra a gyiwu yukuɗǝ nyi shili a miya huwa nyi, ba ji tǝrabiya a gwu huwa nyi, ba ji gwa lari kar haɗǝ ndau a guna. <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>Kǝ ji ɓǝra lari zhaɓi kǝra nji mbuya bama Yesu ǝni a gwu huwa nyi pǝpǝɗau lagu batiti. <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>Kǝ zǝmbǝlma ta shili a miya huwa nyi a ndiya Biturusu ta maˈyi a gwu huwa nyi tsu. Ənggǝra ji gwa lari ba ji hǝnggǝri abǝr jiri nga nyi. <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>Baˈanǝ kabangǝkǝ nanda aˈyi nggabiya sǝra tsǝtsǝfau wu lǝkakaɗǝ abǝr kǝl Yesu hyaˈari sara vir tǝ mai.<verse eid="JHN 20:9"/></para>
  <para style="s1">Yesu Canǝ Nyi Kǝrnyi Anǝ Maryamu</para>
  <para style="r">(<ref loc="MAT 28:9-10">Matiwu 28:9-10</ref>; <ref loc="MRK 16:9-10">Markusu 16:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10"/>Kǝ zǝmbǝlmaˈyar kǝ sha a ndu ki. <verse eid="JHN 20:10"/><verse number="11" style="v" sid="JHN 20:11"/>Maryamu nǝ nyi taˈyi a miya huwa nyi ja vǝr tiwi. Tsu ja vǝr tiwi, ba ji uzhau, ju tsamǝ gwu huɗa huwa nyi. <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>Maja vǝr tsamǝ, ba ji lari waladiˈyar mǝthlǝ wu kar pǝrtǝ ngganggashiu ar vira nji pina dza Yesu ar ta. Waladi pathlǝ a vǝr nggya a dar vir kǝra ja ǝnga vanyi tsu a gyar vir hiya ja.<verse eid="JHN 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13"/>Kǝ waladiya nyiˈyar yiwa nyi ndǝ na, “Mala, mi ngǝ ɗa gwu tiwi ya?”</para>
  <para style="p" vid="JHN 20:13">Əngwar ja, “A hǝnar nda Thlagǝ ɗa sara ǝnggau, ya, nayi wu sǝni vira ndǝ hǝna nyi a ndar mai.” <verse eid="JHN 20:13"/><verse number="14" style="v" sid="JHN 20:14"/>Ənggǝra ji kuɗǝna na abangau, ba ji shabiya dzau, ba ji lari Yesu taˈyi a ndǝna, ama naji tsamǝ ri abǝr Yesu ngǝ mai.<verse eid="JHN 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15"/>Kǝ Yesu yiwa nyi, ji na, “Mala, mi ngǝ ɗa gwu tiwi ya? Wa nga gu gala?”</para>
  <para style="p" vid="JHN 20:15">Ma ju nggani abǝr ndǝr mǝl thlǝr wu fa wu ta ngau, ǝngwar ja anǝ nyi, “Malǝmǝ, ma nagǝ ngǝ hǝr nyi sara ǝnggau, nar ɗa vira gǝ fiya nyi ari, aga ya nda hǝr nyi.”<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>Kǝ Yesu ngga nyi, ji na, “Maryamu.” Ji shabiya dzǝ a ndara ja, ji na ǝnga miya njir Yahudiya, “Rabwani!” (Kǝra ca ngǝ Malǝmǝ.)<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>Əngwar Yesu anǝ nyi, “Ga sara mba ɗa mai, ara tsu yi gǝra sha a da ara Tada kwatahǝu. Ama ga maˈyi a ndara zamǝɗaˈyar ga nda nar nda, sha nga yi a dara Dǝɗa ǝnga Dǝrhyi, ba a dǝgya Hyal ɗa ǝnga Hyalǝr hyi.”<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>Kǝ Maryamu Magǝdaliya maˈyi, ji nda nar nyi anǝ zǝmbǝlma nyiˈyar, “A lar yi Thlagǝu!” Kǝ ji nar nda sǝra Yesu nar nyi.<verse eid="JHN 20:18"/></para>
  <para style="s1">Yesu Canǝ Nyi Kǝrnyi <optbreak/> Anǝ Zǝmbǝlma Nyiˈyar</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matiwu 28:16-20</ref>; <ref loc="MRK 16:14-18">Markusu 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>Əwagǝu pǝci tanggǝrma nǝ sugu, ar pǝci kǝra zǝmbǝlmaˈyar nǝ Yesu kaɓau ar vi zǝmǝu. Ndǝ haɗiya miya ki ara hivǝr njira nggurǝm nǝ Yahudiya. Ma tsu nda a vuna, kǝja Yesu taˈyu wu hada nda, ji na, “Jamǝkur ja nggya ǝnga hyi.” <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>Ayukuɗa ji nana ndǝr kau, kǝ ji canǝ nda tsa ja ǝnga thlǝrpa ja. Kǝ zǝmbǝlma nyiˈyar nyabiya dzǝ ǝnga huɗǝ pipida ara ndǝ lari Thlagǝu.<verse eid="JHN 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21"/>Kǝ Yesu ɓǝra na anǝ nda, “Jamǝkur ja nggya ǝnga hyi! Ənggǝr kǝra Tada sǝwa ɗa, abangau ǝnga yu sǝ hyi.” <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>Ənggǝra ji nana abangau, ba ji sǝna pi a nda gǝra nda, ji na, “Dlǝwara mau Mambǝl Cicau. <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>Kalar ndǝra hyi tǝfǝbiya nyi bikǝ nyi a tǝfǝbiya nyir nji bikǝ nyi, abangǝ tsu, kalar ndǝra hyi nggǝl ara tǝfǝbiya nyi bikǝ nyi a nggyari abangau.”<verse eid="JHN 20:23"/></para>
  <para style="s1">Yesu Canǝ Nyi Kǝrnyi Anǝ Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>Toma (ndǝra nju ngga ǝnga ɓili), pathlǝ wu pama nda kumo apǝ mǝthlǝu, aˈyi ja ma Yesu shili ara zǝmbǝlma nyiˈyar mai. <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>Kǝ alenyi zǝmbǝlmaˈyar kǝ na anǝ nyi, “A lar ˈya Thlagǝu!”</para>
  <para style="p" vid="JHN 20:25">Ama ǝngwar Toma anǝ nda, “Ma nayi aˈyi lari mǝcavǝɗi nǝ kusa ar tsa ja mai, ǝnga yi fuwa tsa yi a vu vira kusa ar ta mai, ǝnga yi fuwa tsa yi a vu thlǝrpa ja mai, nayi wu hǝnggǝri ǝni mai.”<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>Ayukuɗa sugu pathlǝ ǝtsu, zǝmbǝlma nyiˈyar ɓǝra tsǝmiya dzǝ wu ki, ar pǝci kǝ Toma aˈyi ja ǝkkǝˈyi nda. Miya ki dǝdǝl nga nyi, ama kǝ Yesu shili ji sa taˈyi wu pama nda ji na, “Jamǝkur ja nggya ǝnga hyi.” <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>Kǝ ji na anǝ Toma, “Fǝr kuˈyir tsa gǝ ǝnggau, ga tsamiya tsa yau. Hǝr tsa gau ga fiya a vu thlǝrpa yau. Piyari tǝkǝkǝr ga ɗa ndǝra ǝnga mbǝrsa.”<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>Əngwar Toma anǝ nyi, “Thlagǝ ɗa ǝnga Hyal ɗa!”<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>Yesu shaɗǝwa nyi, “Ara gǝ lar ɗa nga gǝ hǝnggǝri ya? Njir barka ngǝ njira gǝra lar ɗa ama kǝ ndǝ hǝnggǝri ǝnga yau.”<verse eid="JHN 20:29"/></para>
  <para style="s1">Sǝra Ɗa Yahwana Tsǝfǝri Tsǝfǝ Kau</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>Yesu mǝliya sǝ dǝdǝgurˈyar pamǝpamǝ gangǝu wu liya zǝmbǝlma nyiˈyar, kǝra nji aˈyi tsǝfǝri wu lǝkakaɗǝ kǝ mai. <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>Ama nji tsǝfǝri najakau, aga hya hǝnggǝri abǝr Yesu ngǝ Kǝrsiti, Zǝr Hyal, ǝnga tsu aga ja ɗa lagur mbǝrsa ba hya uya pi lagur thlǝmǝ nyi.<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">Yesu Canǝ Nyi Kǝrnyi <optbreak/> Anǝ Zǝmbǝlma Nyiˈyar Mǝɗǝfau</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>Ayukuɗa sǝˈyar kau, kǝ Yesu ɓǝra canǝ nyi kǝr anǝ zǝmbǝlma nyiˈyar ar miya dǝl Tiberiyasu. Kǝja ǝnggǝra ji ɗarkǝr. <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>Simanu Biturusu ǝnga Toma (ndǝra nju ngga ǝnga ɓili) ǝnga Nathlaniyalu sara wu mǝlmǝ Kana wu Galili ǝnga wazha Zabadi ǝnga alenyi zǝmbǝlma mǝthlǝ ngǝ a ndǝna. <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>Əngwar Biturusu anǝ nda, “Maˈyi nga ya nda tǝm.” Əngwar alenyi nji kau, “Naˈya ma ˈyi wu maˈyi ǝnga gau.” Kǝ ndǝ biya ndǝ biya gwu kwambwal ba ndǝ maˈyi. Ama pǝci ta vuˈyi sǝ aˈyi ndǝ mbar mai.<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>Kaɗǝ mudlǝ ǝnggǝra vi kuɗau, kǝja Yesu taˈyi a miya dǝl, ama zǝmbǝlma nyiˈyar tsamǝ ri abǝr naja ngǝ mai. <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>Kǝ Yesu na anǝ nda, “Bazhi ɗaˈyar, aˈyi hyi ǝnga kalfi wa?” Əngwar nda anǝ nyi, “Awau.”<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>Kǝ Yesu na anǝ nda, “Vakuwa mǝ litagǝr hyi a ndar lagu mazǝma kwambwal kau, ba hya uya nda.” Ta ndǝ mǝliya ǝnggǝra ji na, ba ndǝ mbar kalfi gangǝ gagaɗau, kǝra ɗa dzadzau anǝ nda, nda tǝɗǝbiya a du kwambwala nyi.<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>Kǝ zǝmbǝlma ta Yesu wu yiwu ta na anǝ Biturusu, “Thlagǝ ngau!” Ənggǝra Simanu Biturusu nggari ndǝr kau, abǝr, “Thlagǝ ngau,” kǝ ji hǝri lǝgutǝ nyi ji hari ara ɗǝɗǝmǝu tursǝ nga ja. Kǝ ji dzǝgwa vǝl a gwu ˈyimiya nyi. <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>Alenyi zǝmbǝlma nyiˈyar maˈyi a ndar dza dǝl a gwu kwambwalǝr nda, nda a vǝr tǝtǝɗǝ litagǝr nda nyinyau ǝnga kalfi. Ar pǝci ta nanda aˈyi naɗǝ sara miya dǝl mai. Pama nda wu ɗa ǝnggǝr hyi gharu makǝru.<verse eid="JHN 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 21:9"/>Ənggǝra ndǝ biya a miya dǝl, ba ndǝ thlǝwa ǝvunyi mbǝmbǝ ǝnga uˈu ǝnga kalfi a dari ba ǝnga macikǝl tsu. <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/>Əngwar Yesu anǝ nda, “Gǝri a mau kalfi kǝra hyi mbari a shili ǝnggau.” <verse eid="JHN 21:10"/><verse number="11" style="v" sid="JHN 21:11"/>Kǝ Simanu Biturusu maˈyi a dar kwambwal, ju tǝɗǝ litagǝu a biya miya dǝl. Litagǝ kǝ nyinyi nga nyi ǝnga kalfi nggunggurǝm gharu ǝnga tǝfu kumunyi apǝ makǝru. Ama alaga kǝ litaga nyi nyinyi ǝnga kalfi, aˈyi tanakǝr mai. <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>Kǝ Yesu na anǝ nda, “Shili a mau hya sa sǝm sǝr sǝm nǝ mudlau.” Wu pama zǝmbǝlma nyiˈyar ndǝ aˈyi kǝra cinapi ji yiwa nyi, ji na, abǝr, “Wa nga ga” mai, ara ndu sǝni abǝr Thlagǝ ngau. <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>Ba Yesu hyaˈari ji hǝri macikǝla nyi, ba ji nǝ nda ǝnga kalfiya nyi tsu. <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>Najakǝ ngǝ nǝ makǝrkura nyi, ǝnggǝra Yesu canǝ kǝr anǝ zǝmbǝlma nyiˈyar ayukuɗa ji hyaˈari sara vir tau.<verse eid="JHN 21:14"/></para>
  <para style="s1">Yesu Shabiya Biturusu A Shili</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>Ənggǝra ndǝ kuɗǝna sǝm sǝr sǝm nǝ mudlau, kǝ Yesu nar nyi anǝ Simanu Biturusu, “Simanu zǝr Yahwana, ǝnga jiri nga gu yiwu ɗa a ndiya sǝˈyar kǝ ya?”</para>
  <para style="p" vid="JHN 21:15">Kǝ Biturusu shaɗǝwa nyi, ji na, “Angǝ, Thlagǝu, gu sǝni yu yiwu ngau.”</para>
  <para style="p" vid="JHN 21:15">Əngwar Yesu anǝ nyi, “Sǝmǝna wazha tǝmahǝ ɗaˈyar kau.”<verse eid="JHN 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16"/>Kǝ Yesu ɓǝra na anǝ nyi, “Simanu zǝr Yahwana, ǝnga jiri nga gu yiwu ɗa ya?”</para>
  <para style="p" vid="JHN 21:16">Kǝ ji shaɗǝwa, ji na, “Angǝ, Thlagǝu, gu sǝni abǝr yu yiwu ngau.”</para>
  <para style="p" vid="JHN 21:16">Əngwar Yesu anǝ nyi, “Ɓǝla tǝmahǝ ɗaˈyar.”<verse eid="JHN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17"/>Yesu ɓǝra na anǝ nyi nǝ makǝrkura nyi, “Simanu zǝr Yahwana, gu yiwu ɗa ya?”</para>
  <para style="p" vid="JHN 21:17">Ba sǝ kǝ ndzana huɗa Biturusu arya Yesu yiwa nyi ar kǝr ar kǝr makǝru, “Ənga jiri gu yiwu ɗa ya?”</para>
  <para style="p" vid="JHN 21:17">Əngwar ja anǝ nyi, “Thlagǝu, gu sǝn sǝ patǝu. Gu sǝni abǝr yu yiwu ngau.”</para>
  <para style="p" vid="JHN 21:17">Əngwar Yesu anǝ nyi, “Sǝmǝna tǝmahǝ ɗaˈyar. <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>Jiri nga yu na anǝ ngau, pǝci kǝra gǝ tsu zǝr, nagǝ ngu ha kar anǝ kǝrngau, ba ga maˈyi a ndar vira gu yiwu. Ama ma gǝ nda hal, gu nda ha tsi anǝ nji aga nda har ngǝ kar ba nda dzǝgwa hǝr ngau a ndar vira gǝ gǝra yiwu.” <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>Yesu nana abangau aga cabiya culi tǝ kǝra Biturusu wu nda tau, kǝra wu dla ǝnga kadakadarkur anǝ Hyal. Kǝ ji na anǝ nyi, “Nu ɗa.”<verse eid="JHN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>Biturusu shabiya dzǝ ji tsamǝ gyiwu yukuɗu, ba ji lari zǝmbǝlma ta Yesu wu yiwu ta a vǝr nu nda. Najakǝ ngǝ zǝmbǝlma ta tǝghǝr dzǝ ar dza Yesu pǝci kǝra nda a vǝr sǝm sǝr sǝm nǝ lardur nǝ vǝlna ǝnga ji na anǝ Yesu, “Thlagǝu, wa ngu nda thlǝna hiya ga?” <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>Ənggǝra Biturusu lari nyi, kǝ ji yiwa Yesu, ji na, “Thlagǝu, kar ndǝ kǝ tsu, mi ngǝ nǝ nya?” <verse eid="JHN 21:21"/><verse number="22" style="v" sid="JHN 21:22"/>Kǝ Yesu shaɗǝwa nyi, “Ma yu yiwu ja ɗa aˈyi ǝnga pi kǝl yi sha shili, mi ngǝ dzau nga? Nagǝ, kǝl ga nu ɗa?” <verse eid="JHN 21:22"/><verse number="23" style="v" sid="JHN 21:23"/>Agabangau, kǝ ndǝr kǝ tǝtǝlnakǝr wu pama njir nu Yesu, abǝr zǝmbǝlma kǝ wu tǝ mai. Ama Yesu aˈyi na abangǝ mai. Sǝra ji na ca ngǝ, “Ma yu yiwu ja nggya ǝnga pi kǝl yi shili, mi ngǝ dzau nga?”<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>Najakǝ ngǝ zǝmbǝlma kǝra lǝri sakida ar kǝra sǝˈyar kǝ patǝu, ǝnga ji tsǝfǝr nda. Mǝn wu sǝni abǝr sakida nyi jiri nga nyi.<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>Ama alenyi sǝ pamǝpamǝ gangǝ aˈyi kǝra Yesu mǝlna. Maja abǝr nji tsǝfǝri patǝr sǝra ji mǝlna, duniya ǝnga kǝrnyi a sǝn hǝri lǝkakaɗa nyi mai.<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
