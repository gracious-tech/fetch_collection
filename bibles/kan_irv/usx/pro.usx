  <para style="h">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="toc1">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="toc2">ಜ್ಞಾನೋ</para>
  <para style="toc3">ಜ್ಞಾನೋ</para>
  <para style="mt">ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಅರಸನಾದ ಸೊಲೊಮೋನನು ಜ್ಞಾನೋಕ್ತಿಗಳ ಪ್ರಧಾನ ಗ್ರಂಥಕರ್ತನು. ಸೊಲೊಮೋನನ ಹೆಸರು 1:1, 10:1, ಮತ್ತು 25:1 ರಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ. “ಜ್ಞಾನಿಗಳು” ಎಂದು ಕರೆಯಲ್ಪಡುವ ಪುರುಷರ ಗುಂಪು, ಆಗೂರನು ಮತ್ತು ಅರಸನಾದ ಲೆಮೂವೇಲನಂತಹ ಇತರ ಲೇಖನದಾತರು ಇದರಲ್ಲಿ ಒಳಗೊಂಡಿದ್ದಾರೆ. ಸತ್ಯವೇದದ ಉಳಿದ ಭಾಗದಂತೆಯೇ, ಜ್ಞಾನೋಕ್ತಿಗಳು ದೇವರ ರಕ್ಷಣೆಯ ಯೋಜನೆಯನ್ನು ಸೂಚಿಸುತ್ತದೆ, ಆದರೆ ಇದು ಬಹುಶಃ ಹೆಚ್ಚು ಸೂಕ್ಷ್ಮವಾಗಿ ಸೂಚಿಸುತ್ತದೆ. ಈ ಪುಸ್ತಕವು ಇಸ್ರಾಯೇಲ್ಯರಿಗೆ ಜೀವಿಸಲು ಸರಿಯಾದ ಮಾರ್ಗವಾದ ದೇವರ ಮಾರ್ಗವನ್ನು ತೋರಿಸಿತು. ತನ್ನ ಜೀವಿತಾವಧಿಯಲ್ಲಿ ಅವನು ಪ್ರಭಾವಕ್ಕೆ ಒಳಗಾಗಿರುವ ಜ್ಞಾನದ ನುಡಿಗಳ ಆಧಾರದ ಮೇಲೆ ಈ ಭಾಗವನ್ನು ಉಲ್ಲೇಖಿಸಲು ದೇವರು ಸೊಲೊಮೋನನನ್ನು ಪ್ರೇರೇಪಿಸಿರುವ ಸಾಧ್ಯತೆಯಿದೆ.</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿಪೂ. 971-686 ರ ನಡುವಿನ ಸಮಯ.</para>
  <para style="ip">ಜ್ಞಾನೋಕ್ತಿಗಳು ಸೊಲೊಮೋನನ ಆಳ್ವಿಕೆಯ ಕಾಲದಲ್ಲಿ, ಸಾವಿರಾರು ವರ್ಷಗಳ ಹಿಂದೆ ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಬರೆಯಲ್ಪಟ್ಟವು, ಇದರ ಜ್ಞಾನವು ಪ್ರತಿಯೊಂದು ಸ್ಥಳದಲ್ಲಿ, ಪ್ರತಿಯೊಂದು ಸಂಸ್ಕೃತಿಗೂ ಅನ್ವಯಿಸಲ್ಪಡುತ್ತದೆ.</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಜ್ಞಾನೋಕ್ತಿಗಳಿಗೆ ಹಲವಾರು ಪ್ರೇಕ್ಷಕರು ಇರುತ್ತಾರೆ. ಇದು ತಮ್ಮ ಮಕ್ಕಳಿಗೆ ಉಪದೇಶಿಸುವಂತೆ ಪೋಷಕರಿಗೆ ಸಂಬೋಧಿಸಲಾಗಿದೆ. ಜ್ಞಾನವನ್ನು ಅನ್ವೇಷಿಸುತ್ತಿರುವ ಯುವಕರಿಗೂ ಮತ್ತು ಯುವತಿಯರಿಗೂ ಈ ಪುಸ್ತಕವು ಅನ್ವಯಿಸಲ್ಪಡುತ್ತದೆ ಮತ್ತು ಇದು ಅಂತಿಮವಾಗಿ, ಭಕ್ತಿಪೂರ್ವಕವಾದ ಜೀವನವನ್ನು ಪಡೆಯಲು ಇಚ್ಛಿಸುವ ಇಂದಿನ ಸತ್ಯವೇದದ ಓದುಗಾರರಿಗೆ ಪ್ರಾಯೋಗಿಕವಾದ ಸಲಹೆ ನೀಡುತ್ತದೆ.</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ಜ್ಞಾನೋಕ್ತಿಗಳ ಪುಸ್ತಕದಲ್ಲಿ, ಸೊಲೊಮೋನನು ದೇವರ ಮನಸ್ಸನ್ನು ಉನ್ನತ ಮತ್ತು ಉದಾತ್ತವಾದ ಮತ್ತು ಹುದುವಾದ, ಸಾಧಾರಣವಾದ ವಿಷಯಗಳಲ್ಲಿ, ದಿನನಿತ್ಯದ ಸನ್ನಿವೇಶಗಳಲ್ಲಿಯೂ ಕೂಡಾ ತಿಳಿಸಿಕೊಡುತ್ತಾನೆ. ಅರಸನಾದ ಸೊಲೊಮೋನನ ಗಮನದಿಂದ ಯಾವ ವಿಚಾರವು ತಪ್ಪಿಹೋಗಿಲ್ಲ ಎಂದು ಕಂಡುಬರುತ್ತದೆ. ವೈಯುಕ್ತಿಕ ನಡವಳಿಕೆ, ಲೈಂಗಿಕ ಸಂಬಂಧಗಳು, ವ್ಯಾಪಾರ, ಸಂಪತ್ತು, ದಾನ, ಮಹತ್ವಾಕಾಂಕ್ಷೆ, ಶಿಸ್ತು, ಸಾಲ, ಮಗು-ಪಾಲನೆ, ಸ್ವಭಾವ, ಮದ್ಯಪಾನ, ರಾಜಕೀಯ, ಪ್ರತಿಕಾರ ಮತ್ತು ದೈವಭಕ್ತಿಗೆ ಸಂಬಂಧಿಸಿದ ವಿಷಯಗಳು ಜ್ಞಾನೋಕ್ತಿಗಳೆನ್ನುವ ಈ ಉತ್ತಮ ಸಂಕಲನದಲ್ಲಿ ಅನೇಕ ವಿಚಾರಗಳು ಒಳಗೊಂಡಿರುತ್ತವೆ.</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ಜ್ಞಾನ</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ಜ್ಞಾನದ ಸದ್ಗುಣಗಳು — 1:1-9:18</para>
  <para style="io1">2. ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು — 10:1-22:16</para>
  <para style="io1">3. ಜ್ಞಾನಿಗಳ ನುಡಿಗಳು — 22:17-29:37</para>
  <para style="io1">4. ಆಗೂರನ ಮಾತುಗಳು — 30:1-33</para>
  <para style="io1">5. ಲೆಮೂವೇಲನ ಮಾತುಗಳು — 31:1-31</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s">ಪೀಠಿಕೆ: ಜ್ಞಾನೋಕ್ತಿಗಳ ಉದ್ದೇಶ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>ಇಸ್ರಾಯೇಲರ ಅರಸನಾಗಿದ್ದ ದಾವೀದನ ಮಗನಾದ ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು.<verse eid="PRO 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2"/>ಇವುಗಳಿಂದ ಜನರು ಜ್ಞಾನವನ್ನು ಮತ್ತು ಶಿಕ್ಷಣವನ್ನು ಪಡೆದು,</para>
  <para style="q2" vid="PRO 1:2">ಬುದ್ಧಿವಾದಗಳನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವರು.<verse eid="PRO 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3"/>ಅವರು ವಿವೇಕಮಾರ್ಗದಲ್ಲಿ ಅಂದರೆ ನೀತಿ,</para>
  <para style="q2" vid="PRO 1:3">ನ್ಯಾಯ ಮತ್ತು ಧರ್ಮಮಾರ್ಗಗಳಲ್ಲಿ ಶಿಕ್ಷಿತರಾಗುವರು.<verse eid="PRO 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4"/>ಈ ನುಡಿಗಳು ಮೂಢರಿಗೆ ಜಾಣತನವನ್ನೂ,</para>
  <para style="q2" vid="PRO 1:4">ಯೌವನಸ್ಥರಿಗೆ ತಿಳಿವಳಿಕೆಯನ್ನು ಮತ್ತು ಬುದ್ಧಿಯನ್ನು ಉಂಟುಮಾಡುವವು.<verse eid="PRO 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5"/>ಜ್ಞಾನಿಯು ಇವುಗಳನ್ನು ಕೇಳಿ ಹೆಚ್ಚಾದ ಪಾಡಿಂತ್ಯವನ್ನು ಹೊಂದುವನು,</para>
  <para style="q2" vid="PRO 1:5">ವಿವೇಕಿಯು ಮತ್ತಷ್ಟು ಉಚಿತಾಲೋಚನೆಯನ್ನು ಹೊಂದುವನು.<verse eid="PRO 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6"/>ಇವು ಗಾದೆ, ಸಾಮ್ಯ, ಜ್ಞಾನಿಗಳ ನುಡಿ ಮತ್ತು ಒಗಟುಗಳನ್ನು ತಿಳಿಯಲು ಸಾಧನವಾಗಿವೆ.<verse eid="PRO 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7"/>ಯೆಹೋವನ ಭಯವೇ ತಿಳಿವಳಿಕೆಗೆ ಮೂಲವು,</para>
  <para style="q2" vid="PRO 1:7">ಮೂರ್ಖರಾದರೋ ಜ್ಞಾನವನ್ನು ಮತ್ತು ಶಿಕ್ಷಣವನ್ನು ತಿರಸ್ಕರಿಸುವರು.<verse eid="PRO 1:7"/></para>
  <para style="s">ಪಾಪಿಗಳ ಕುರಿತು ಎಚ್ಚರಿಕೆಗಳು</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8"/>ಮಗನೇ, ನಿನ್ನ ತಂದೆಯ ಉಪದೇಶವನ್ನು ಕೇಳು,</para>
  <para style="q2" vid="PRO 1:8">ನಿನ್ನ ತಾಯಿಯ ಬೋಧನೆಯನ್ನು ತೊರೆಯಬೇಡ.<verse eid="PRO 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9"/>ಅವು ನಿನ್ನ ತಲೆಗೆ ಸುಂದರವಾದ ಪುಷ್ಪಕಿರೀಟ,</para>
  <para style="q2" vid="PRO 1:9">ಕೊರಳಿಗೆ ಹಾರದಂತಿರುವುದು.<verse eid="PRO 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10"/>ಮಗನೇ, ಪಾಪಿಗಳು ದುಷ್ಪ್ರೇರಣೆಯನ್ನು ಮಾಡಿದರೆ ನೀನು ಒಪ್ಪಲೇ ಬೇಡ.<verse eid="PRO 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11"/>ಅವರು, “ನಮ್ಮೊಂದಿಗೆ ಬಾ, ರಕ್ತಕ್ಕಾಗಿ ಹೊಂಚುಹಾಕೋಣ,</para>
  <para style="q2" vid="PRO 1:11">ನಿರಪರಾಧಿಯನ್ನು ಕಾರಣವಿಲ್ಲದೆಯೇ ಹಿಡಿಯುವುದಕ್ಕೆ ಕಾದಿರೋಣ.<verse eid="PRO 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12"/>ಪಾತಾಳವು ತನ್ನೊಳಗೆ ಇಳಿಯುವವರನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನುಂಗುವಂತೆ,</para>
  <para style="q2" vid="PRO 1:12">ನಾವೂ ಇವರನ್ನು ಜೀವದೊಡನೆ ನುಂಗಿಬಿಡೋಣ.<verse eid="PRO 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13"/>ಸಕಲವಿಧವಾದ ಅಮೂಲ್ಯ ಸಂಪತ್ತನ್ನು ಕಂಡುಹಿಡಿದು,</para>
  <para style="q2" vid="PRO 1:13">ಕೊಳ್ಳೆಮಾಡಿ ನಮ್ಮ ಮನೆಗಳಲ್ಲಿ ತುಂಬಿಕೊಳ್ಳೋಣ.<verse eid="PRO 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14"/>ನಮ್ಮ ಸಂಗಡ ಚೀಟು ಹಾಕು;</para>
  <para style="q2" vid="PRO 1:14">ನಮ್ಮೆಲ್ಲರ ಹಣದ ಚೀಲ ಒಂದೇ ಆಗಿರಲಿ” ಎಂದು ಹೇಳಿದರೆ,<verse eid="PRO 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15"/>ಮಗನೇ, ಅವರೊಡನೆ ದಾರಿಯಲ್ಲಿ ನಡೆಯಬಾರದು,</para>
  <para style="q2" vid="PRO 1:15">ಅವರ ಮಾರ್ಗದಲ್ಲಿ ನೀನು ಹೆಜ್ಜೆಯಿಡಬೇಡ.<verse eid="PRO 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16"/>ಅವರ ಕಾಲುಗಳು ಕೇಡನ್ನು ಹಿಂಬಾಲಿಸಿ ಓಡುವವು,</para>
  <para style="q2" vid="PRO 1:16">ಅವರು ರಕ್ತವನ್ನು ಸುರಿಸಲು ಆತುರಪಡುವರು.<verse eid="PRO 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17"/>ಪಕ್ಷಿಗಳ ಕಣ್ಣೆದುರಿಗೆ ಬಲೆಯನ್ನೊಡ್ಡುವುದು ವ್ಯರ್ಥ.<verse eid="PRO 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18"/>ಇವರಾದರೋ ಸ್ವರಕ್ತವನ್ನು ಸುರಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ಹೊಂಚುಹಾಕುತ್ತಾರೆ,</para>
  <para style="q2" vid="PRO 1:18">ಸ್ವಜೀವವನ್ನು ತೆಗೆದುಕೊಳ್ಳುವುದಕ್ಕೆ ಕಾದಿರುತ್ತಾರೆ.<verse eid="PRO 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19"/>ಸೂರೆಮಾಡುವವರೆಲ್ಲರ ದಾರಿಯು ಹೀಗೆಯೇ ಸರಿ;</para>
  <para style="q2" vid="PRO 1:19">ಕೊಳ್ಳೆಯು ಕೊಳ್ಳೆಗಾರರ ಜೀವವನ್ನೇ ಕೊಳ್ಳೆಮಾಡುವುದು.<verse eid="PRO 1:19"/></para>
  <para style="s">ಜ್ಞಾನವನ್ನು ತಿರಸ್ಕರಿಸಿದರೆ ಎಚ್ಚರ</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20"/>ಜ್ಞಾನವೆಂಬಾಕೆಯು ಬೀದಿಗಳಲ್ಲಿ ಕೂಗುತ್ತಾಳೆ,</para>
  <para style="q2" vid="PRO 1:20">ಚೌಕಗಳಲ್ಲಿ ಧ್ವನಿಮಾಡುತ್ತಾಳೆ.<verse eid="PRO 1:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21"/>ಪೇಟೆಯ ಮುಖ್ಯಸ್ಥಾನದಲ್ಲಿ ಆಕೆ ಕೂಗುತ್ತಾಳೆ,</para>
  <para style="q2" vid="PRO 1:21">ಊರ ಬಾಗಿಲಿನಲ್ಲಿ ಆಕೆಯು ನುಡಿಯುವುದೇನೆಂದರೆ,<verse eid="PRO 1:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22"/>“ಮೂಢರೇ, ಮೂಢತನವನ್ನು ಎಂದಿನ ತನಕ ಪ್ರೀತಿಸುವಿರಿ?</para>
  <para style="q2" vid="PRO 1:22">ಧರ್ಮನಿಂದಕರು ನಿಂದಿಸುವುದಕ್ಕೆ ಎಷ್ಟುಕಾಲ ಇಷ್ಟಪಡುವರು?</para>
  <para style="q2" vid="PRO 1:22">ಜ್ಞಾನಹೀನರು ತಿಳಿವಳಿಕೆಯನ್ನು ಎಷ್ಟರವರೆಗೆ ಹಗೆಮಾಡುವರು?<verse eid="PRO 1:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23"/>ನನ್ನ ಗದರಿಕೆಗೆ ಲಕ್ಷ್ಯಕೊಡಿರಿ;</para>
  <para style="q2" vid="PRO 1:23">ಇಗೋ, ನಿಮ್ಮ ಮೇಲೆ ನನ್ನ ಆತ್ಮವನ್ನು ಸುರಿಸಿ,</para>
  <para style="q2" vid="PRO 1:23">ನನ್ನ ಮಾತುಗಳನ್ನು ನಿಮಗೆ ತಿಳಿಯಪಡಿಸುವೆನು.<verse eid="PRO 1:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24"/>ನಾನು ಕರೆದಾಗ ನೀವು ತಿರಸ್ಕರಿಸಿದಿರಿ.</para>
  <para style="q2" vid="PRO 1:24">ಕೈ ಚಾಚಿದರೂ ಯಾರೂ ನನ್ನನ್ನು ಗಮನಿಸಲಿಲ್ಲ;<verse eid="PRO 1:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25"/>ನನ್ನ ಬುದ್ಧಿವಾದವನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಾರದೆ, ನನ್ನ ತಿದ್ದುಪಾಟನ್ನು ಬೇಡವೆಂದು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದೀರಿ.<verse eid="PRO 1:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26"/>ಆದಕಾರಣ ಬಿರುಗಾಳಿಯಂತೆ ಅಪಾಯವೂ,</para>
  <para style="q2" vid="PRO 1:26">ತುಫಾನಿನಂತೆ ಆಪತ್ತೂ ಬಂದು, ನಿಮಗೆ ಶ್ರಮಸಂಕಟಗಳು ಸಂಭವಿಸುವಾಗ<verse eid="PRO 1:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27"/>ನಿಮ್ಮ ಅಪಾಯದಲ್ಲಿ ನಾನೂ ನಗುವೆನು;</para>
  <para style="q2" vid="PRO 1:27">ನಿಮ್ಮ ಆಪತ್ತಿನಲ್ಲಿ ಪರಿಹಾಸ್ಯ ಮಾಡುವೆನು.<verse eid="PRO 1:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28"/>ಆಗ ಅವರು ನನಗೆ ಮೊರೆಯಿಟ್ಟರೂ ನಾನು ಉತ್ತರಕೊಡೆನು,</para>
  <para style="q2" vid="PRO 1:28">ನನ್ನನ್ನು ಆತುರದಿಂದ ಹುಡುಕಿದರೂ ನಾನು ಕಾಣಿಸೆನು.<verse eid="PRO 1:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29"/>ಯಾಕೆಂದರೆ ಅವರು ಯೆಹೋವನ ಭಯಭಕ್ತಿಗೆ ಮನಸ್ಸು ಕೊಡದೆ</para>
  <para style="q2" vid="PRO 1:29">ತಿಳಿವಳಿಕೆಯನ್ನು ಹಗೆಮಾಡಿದರು.<verse eid="PRO 1:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30"/>ನನ್ನ ಬೋಧನೆಯನ್ನು ಕೇಳಲೊಲ್ಲದೆ,</para>
  <para style="q2" vid="PRO 1:30">ನನ್ನ ಗದರಿಕೆಯನ್ನೆಲ್ಲಾ ತಾತ್ಸಾರಮಾಡಿದರು.<verse eid="PRO 1:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31"/>ಆದುದರಿಂದ ಅವರು ತಮ್ಮ ನಡತೆಯ ಫಲವನ್ನು ಅನುಭವಿಸಿ,</para>
  <para style="q2" vid="PRO 1:31">ಸ್ವಂತ ಕುಯುಕ್ತಿಗಳನ್ನೇ ಹೊಟ್ಟೆತುಂಬಾ ಉಣ್ಣಬೇಕಾಗುವುದು.<verse eid="PRO 1:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32"/>ಮೂಢರು ತಮ್ಮ ಉದಾಸೀನತೆಯಿಂದಲೇ ಹತರಾಗುವರು,</para>
  <para style="q2" vid="PRO 1:32">ಜ್ಞಾನಹೀನರು ತಮ್ಮ ನಿಶ್ಚಿಂತೆಯಿಂದಲೇ ನಾಶವಾಗುವರು.<verse eid="PRO 1:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33"/>ನನ್ನ ಮಾತಿಗೆ ಕಿವಿಗೊಡುವವನಾದರೋ ಸುರಕ್ಷಿತನಾಗಿದ್ದು,</para>
  <para style="q2" vid="PRO 1:33">ಯಾವ ಕೇಡಿಗೂ ಭಯಪಡದೆ ನೆಮ್ಮದಿಯಾಗಿ ಬಾಳುವನು” ಎಂಬುದೇ.<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s">ಜ್ಞಾನದ ಫಲ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1"/>ಕಂದಾ, ನನ್ನ ಮಾತುಗಳನ್ನು ಅಂಗೀಕರಿಸಿ,</para>
  <para style="q2" vid="PRO 2:1">ನನ್ನ ವಿಧಿಗಳನ್ನು ನಿಧಿಯಂತೆ ಕಾಪಾಡಿಕೋ,<verse eid="PRO 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2"/>ನಿನ್ನ ಕಿವಿಯನ್ನು ಜ್ಞಾನದ ಕಡೆಗೂ,</para>
  <para style="q2" vid="PRO 2:2">ಹೃದಯವನ್ನು ವಿವೇಕದ ಕಡೆಗೂ ತಿರುಗಿಸು;<verse eid="PRO 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3"/>ಬುದ್ಧಿಗಾಗಿ ಮೊರೆಯಿಟ್ಟು, ವಿವೇಕಕ್ಕಾಗಿ ಕೂಗಿಕೋ.<verse eid="PRO 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4"/>ಅದನ್ನು ಬೆಳ್ಳಿಯಂತೆಯು ಮತ್ತು ನಿಕ್ಷೇಪದಂತೆಯು ಹುಡುಕು;<verse eid="PRO 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5"/>ಆಗ ನೀನು ಯೆಹೋವನ ಭಯವನ್ನು ಅರಿತು,</para>
  <para style="q2" vid="PRO 2:5">ದೈವಜ್ಞಾನವನ್ನು ಪಡೆದುಕೊಳ್ಳುವಿ.<verse eid="PRO 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6"/>ಯೆಹೋವನೇ ಜ್ಞಾನವನ್ನು ಕೊಡುವಾತನು,</para>
  <para style="q2" vid="PRO 2:6">ಆತನ ಬಾಯಿಂದಲೇ ತಿಳಿವಳಿಕೆಯೂ, ವಿವೇಕವೂ ಹೊರಟು ಬರುತ್ತವೆ.<verse eid="PRO 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7"/>ಆತನು ಯಥಾರ್ಥಚಿತ್ತರಿಗಾಗಿ ಸುಜ್ಞಾನವನ್ನು ಕೂಡಿಸಿಡುವನು.</para>
  <para style="q2" vid="PRO 2:7">ದೋಷವಿಲ್ಲದೆ ನಡೆಯುವವರಿಗೆ ಗುರಾಣಿಯಾಗಿದ್ದು,<verse eid="PRO 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8"/>ನ್ಯಾಯಮಾರ್ಗವನ್ನು ರಕ್ಷಿಸುತ್ತಾ,</para>
  <para style="q2" vid="PRO 2:8">ತನ್ನ ಭಕ್ತರ ದಾರಿಯನ್ನು ನೋಡಿಕೊಳ್ಳುವನು.<verse eid="PRO 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9"/>ಹೀಗಿರಲು ನೀನು ನೀತಿ, ನ್ಯಾಯ, ಧರ್ಮವನ್ನೂ ಅಂದರೆ</para>
  <para style="q2" vid="PRO 2:9">ಸಕಲ ಸನ್ಮಾರ್ಗಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಿ.<verse eid="PRO 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10"/>ಜ್ಞಾನವು ನಿನ್ನ ಹೃದಯದೊಳಗೆ ಪ್ರವೇಶಿಸುವುದು,</para>
  <para style="q2" vid="PRO 2:10">ತಿಳಿವಳಿಕೆಯು ನಿನ್ನ ಆತ್ಮಕ್ಕೆ ಹಿತಕರವಾಗಿರುವುದು.<verse eid="PRO 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11"/>ಬುದ್ಧಿಯು ನಿನಗೆ ಕಾವಲಾಗಿರುವುದು,</para>
  <para style="q2" vid="PRO 2:11">ವಿವೇಕವು ನಿನ್ನನ್ನು ಕಾಪಾಡುವುದು.<verse eid="PRO 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12"/>ಇದರಿಂದ ನೀನು ದುರ್ಮಾರ್ಗದಿಂದಲೂ,</para>
  <para style="q2" vid="PRO 2:12">ಕೆಟ್ಟ ಮಾತನಾಡುವವರಿಂದಲೂ ತಪ್ಪಿಸಿಕೊಳ್ಳುವಿ.<verse eid="PRO 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13"/>ಅವರಾದರೋ ಕತ್ತಲೆಯ ಮಾರ್ಗಗಳನ್ನು ಹಿಡಿಯಬೇಕೆಂದು,</para>
  <para style="q2" vid="PRO 2:13">ಧರ್ಮಮಾರ್ಗಗಳನ್ನು ತೊರೆದುಬಿಡುವರು.<verse eid="PRO 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14"/>ಅವರು ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಸಂತೋಷಿಸಿ,</para>
  <para style="q2" vid="PRO 2:14">ಕೆಟ್ಟವರ ದುಷ್ಟತನದಲ್ಲಿ ಆನಂದಿಸುವರು.<verse eid="PRO 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15"/>ಅವರ ಮಾರ್ಗಗಳು ವಕ್ರವಾಗಿವೆ.</para>
  <para style="q2" vid="PRO 2:15">ಅವರ ನಡತೆಗಳು ದುರ್ನಡತೆಗಳೇ.<verse eid="PRO 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16"/>ವಿವೇಕವು ನಿನ್ನನ್ನು ಜಾರಳಿಂದ ಅಂದರೆ</para>
  <para style="q2" vid="PRO 2:16">ಸವಿಮಾತನಾಡುವ ಪರಸ್ತ್ರೀಯಿಂದ ತಪ್ಪಿಸುವುದು.<verse eid="PRO 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17"/>ಅವಳು ತನ್ನ ಯೌವನಕಾಲದ ಕಾಂತನನ್ನು ತ್ಯಜಿಸಿ,</para>
  <para style="q2" vid="PRO 2:17">ತನ್ನ ದೇವರ ಮುಂದೆ ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದಾಳೆ.<verse eid="PRO 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18"/>ಅವಳ ಮನೆಯು ಪಾತಾಳಕ್ಕೆ ಇಳಿಯುವ ದಾರಿ,</para>
  <para style="q2" vid="PRO 2:18">ಅವಳ ಮಾರ್ಗಗಳು ಪ್ರೇತಲೋಕಕ್ಕೆ ಹೋಗುತ್ತವೆ.<verse eid="PRO 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19"/>ಅವಳ ಬಳಿಗೆ ಹೋಗುವವರು ಯಾರೂ ಹಿಂದಿರುಗುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 2:19">ಅವರಿಗೆ ಜೀವದ ಮಾರ್ಗವು ದೊರೆಯುವುದೇ ಇಲ್ಲ.<verse eid="PRO 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20"/>ಒಳ್ಳೆಯವರ ನಡತೆಯನ್ನು ಅನುಸರಿಸುವಂತೆ</para>
  <para style="q2" vid="PRO 2:20">ವಿವೇಕವು ನಿನ್ನನ್ನು ಪ್ರೇರೇಪಿಸಿ,</para>
  <para style="q2" vid="PRO 2:20">ನೀತಿವಂತರ ದಾರಿಗಳನ್ನು ಹಿಡಿಯುವ ಹಾಗೆ ಮಾಡುವುದು.<verse eid="PRO 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21"/>ಯಥಾರ್ಥವಂತರು ದೇಶದಲ್ಲಿ ಸ್ವತಂತ್ರರಾಗಿರುವರು,</para>
  <para style="q2" vid="PRO 2:21">ನಿರ್ದೋಷಿಗಳು ಅದರಲ್ಲಿ ನೆಲೆಯಾಗಿರುವರು.<verse eid="PRO 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22"/>ದುಷ್ಟರಾದರೋ ದೇಶದೊಳಗಿಂದ ತೆಗೆದುಹಾಕಲ್ಪಡುವರು,</para>
  <para style="q2" vid="PRO 2:22">ದ್ರೋಹಿಗಳು ನಿರ್ಮೂಲರಾಗುವರು.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s">ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡು</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1"/>ಕಂದಾ, ನನ್ನ ಉಪದೇಶವನ್ನು ಮರೆಯಬೇಡ,</para>
  <para style="q2" vid="PRO 3:1">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಕೈಗೊಳ್ಳು.<verse eid="PRO 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2"/>ಅವು ನಿನ್ನ ದಿನಗಳನ್ನು ಹೆಚ್ಚಿಸಿ, ನಿನ್ನ ಆಯುಷ್ಯವನ್ನು ವೃದ್ಧಿಗೊಳಿಸಿ,</para>
  <para style="q2" vid="PRO 3:2">ನಿನಗೆ ಸುಕ್ಷೇಮವನ್ನು ಉಂಟುಮಾಡುವವು.<verse eid="PRO 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3"/>ಪ್ರೀತಿ, ಸತ್ಯತೆಗಳು ನಿನ್ನನ್ನು ಬಿಡದಿರಲಿ, ಅವುಗಳನ್ನು ನಿನ್ನ ಕೊರಳಿಗೆ ಕಟ್ಟು,</para>
  <para style="q2" vid="PRO 3:3">ನಿನ್ನ ಹೃದಯದ ಹಲಗೆಯ ಮೇಲೆ ಅವುಗಳನ್ನು ಬರೆ.<verse eid="PRO 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4"/>ಇದರಿಂದ ನೀನು ದೇವರ ಮತ್ತು ಮನುಷ್ಯರ ದಯೆಯನ್ನೂ,</para>
  <para style="q2" vid="PRO 3:4">ಸಮ್ಮತಿಯನ್ನೂ ಪಡೆದುಕೊಳ್ಳುವಿ.<verse eid="PRO 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5"/>ಸ್ವಬುದ್ಧಿಯನ್ನೇ ಆಧಾರಮಾಡಿಕೊಳ್ಳದೆ</para>
  <para style="q2" vid="PRO 3:5">ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡು.<verse eid="PRO 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6"/>ನಿನ್ನ ಎಲ್ಲಾ ನಡವಳಿಕೆಯಲ್ಲಿ ಆತನ ಚಿತ್ತಕ್ಕೆ ವಿಧೇಯನಾಗಿರು;</para>
  <para style="q2" vid="PRO 3:6">ಆತನೇ ನಿನ್ನ ಮಾರ್ಗಗಳನ್ನು ಸರಾಗಮಾಡುವನು.<verse eid="PRO 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7"/>ನೀನೇ ಬುದ್ಧಿವಂತನು ಎಂದೆಣಿಸದೆ,</para>
  <para style="q2" vid="PRO 3:7">ಯೆಹೋವನಿಗೆ ಭಯಪಟ್ಟು ಕೆಟ್ಟದ್ದನ್ನು ತೊರೆದುಬಿಡು.<verse eid="PRO 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8"/>ಇದರಿಂದ ನಿನ್ನ ದೇಹಕ್ಕೆ ಆರೋಗ್ಯವೂ,</para>
  <para style="q2" vid="PRO 3:8">ಎಲುಬುಗಳಿಗೆ ಸಾರವೂ ಉಂಟಾಗುವವು.<verse eid="PRO 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9"/>ನಿನ್ನ ಆದಾಯದಿಂದಲೂ, ಬೆಳೆಯ ಪ್ರಥಮಫಲದಿಂದಲೂ</para>
  <para style="q2" vid="PRO 3:9">ಯೆಹೋವನನ್ನು ಸನ್ಮಾನಿಸು.<verse eid="PRO 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10"/>ಹೀಗೆ ಮಾಡಿದರೆ ನಿನ್ನ ಕಣಜಗಳು ಸಮೃದ್ಧಿಯಿಂದ ತುಂಬುವವು,</para>
  <para style="q2" vid="PRO 3:10">ತೊಟ್ಟಿಗಳಲ್ಲಿ ದ್ರಾಕ್ಷಾರಸವು ತುಂಬಿ ತುಳುಕುವುದು.<verse eid="PRO 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11"/>ಮಗನೇ, ಯೆಹೋವನ ಶಿಕ್ಷೆಯನ್ನು ತಾತ್ಸಾರ ಮಾಡಬೇಡ.</para>
  <para style="q2" vid="PRO 3:11">ಆತನು ನಿನ್ನನ್ನು ಗದರಿಸುವಾಗ ಬೇಸರಗೊಳ್ಳಬೇಡ.<verse eid="PRO 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12"/>ತಂದೆಯು ತನ್ನ ಮುದ್ದುಮಗನನ್ನು ಗದರಿಸುವಂತೆ</para>
  <para style="q2" vid="PRO 3:12">ಯೆಹೋವನು ತಾನು ಪ್ರೀತಿಸುವವನನ್ನೇ ಗದರಿಸುತ್ತಾನೆ.<verse eid="PRO 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13"/>ಜ್ಞಾನವನ್ನು ಪಡೆಯುವವನು ಧನ್ಯನು,</para>
  <para style="q2" vid="PRO 3:13">ವಿವೇಕವನ್ನು ಸಂಪಾದಿಸುವವನು ಭಾಗ್ಯವಂತನು.<verse eid="PRO 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14"/>ಅದರ ಲಾಭವು ಬೆಳ್ಳಿಯ ಲಾಭಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 3:14">ಅದರಿಂದಾಗುವ ಆದಾಯವು ಬಂಗಾರಕ್ಕಿಂತಲೂ ಅಮೂಲ್ಯವೇ ಸರಿ.<verse eid="PRO 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15"/>ಅದರ ಬೆಲೆಯು ಹವಳಕ್ಕಿಂತಲೂ ಹೆಚ್ಚು,</para>
  <para style="q2" vid="PRO 3:15">ನಿನ್ನ ಇಷ್ಟವಸ್ತುಗಳೆಲ್ಲವೂ ಅದಕ್ಕೆ ಸಮವಲ್ಲ.<verse eid="PRO 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16"/>ಜ್ಞಾನವೆಂಬಾಕೆಯ ಬಲಗೈಯಲ್ಲಿ ದೀರ್ಘಾಯುಷ್ಯವೂ,</para>
  <para style="q2" vid="PRO 3:16">ಎಡಗೈಯಲ್ಲಿ ಧನವೂ, ಘನತೆಯೂ ಉಂಟು.<verse eid="PRO 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17"/>ಆಕೆಯ ದಾರಿಗಳು ಸುಖಕರವಾಗಿವೆ,</para>
  <para style="q2" vid="PRO 3:17">ಆಕೆಯ ಮಾರ್ಗಗಳೆಲ್ಲಾ ಸಮಾಧಾನವೇ.<verse eid="PRO 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18"/>ಜ್ಞಾನವು ತನ್ನನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವವರಿಗೆ ಜೀವವೃಕ್ಷವಾಗಿದೆ.</para>
  <para style="q2" vid="PRO 3:18">ಅದನ್ನು ಅವಲಂಬಿಸುವ ಪ್ರತಿಯೊಬ್ಬನೂ ಧನ್ಯನು.<verse eid="PRO 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19"/>ಯೆಹೋವನು ಜ್ಞಾನದ ಮೂಲಕ ಭೂಮಿಯನ್ನು ಸ್ಥಾಪಿಸಿ,</para>
  <para style="q2" vid="PRO 3:19">ವಿವೇಕದ ಮುಖಾಂತರ ಆಕಾಶಮಂಡಲವನ್ನು ಸ್ಥಿರಪಡಿಸಿದನು.<verse eid="PRO 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20"/>ಭೂಮಿಯ ಕೆಳಗಿನ ಸಾಗರವು ಒಡೆದದ್ದಕ್ಕೂ,</para>
  <para style="q2" vid="PRO 3:20">ಆಕಾಶವು ಇಬ್ಬನಿಯನ್ನು ಸುರಿಸುವುದಕ್ಕೂ ಆತನ ತಿಳಿವಳಿಕೆಯೇ ಸಾಧನ.<verse eid="PRO 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21"/>ನನ್ನ ಮಗನೇ, ಸುಜ್ಞಾನವನ್ನೂ ಮತ್ತು ಬುದ್ಧಿಯನ್ನೂ ಭದ್ರವಾಗಿಟ್ಟುಕೋ,</para>
  <para style="q2" vid="PRO 3:21">ನಿನ್ನ ದೃಷ್ಟಿಯು ಅವುಗಳ ಮೇಲೆ ತಪ್ಪದೇ ಇರಲಿ.<verse eid="PRO 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22"/>ಅವು ನಿನಗೆ ಜೀವವೂ, ನಿನ್ನ ಕೊರಳಿಗೆ ಭೂಷಣವೂ ಆಗಿರುವವು.<verse eid="PRO 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23"/>ಆಗ ನೀನು ಎಡವದೆ ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ನಿರ್ಭಯವಾಗಿ ನಡೆಯುವಿ.<verse eid="PRO 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24"/>ನೀನು ಮಲಗುವಾಗ ಹೆದರಿಕೆ ಇರುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 3:24">ಮಲಗಿದ ಮೇಲೆ ಸುಖವಾಗಿ ನಿದ್ರೆಮಾಡುವಿ.<verse eid="PRO 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25"/>ಪಕ್ಕನೆ ಬರುವ ಅಪಾಯಕ್ಕಾಗಲಿ ಅಥವಾ</para>
  <para style="q2" vid="PRO 3:25">ದುಷ್ಟರಿಗೆ ಸಂಭವಿಸುವ ನಾಶನಕ್ಕಾಗಲಿ ನೀನು ಅಂಜುವುದೇ ಇಲ್ಲ.<verse eid="PRO 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26"/>ಯೆಹೋವನು ನಿನ್ನ ಭರವಸಕ್ಕೆ ಆಧಾರನಾಗಿದ್ದು,</para>
  <para style="q2" vid="PRO 3:26">ನಿನ್ನ ಕಾಲು ಮೋಸದ ಬಲೆಗೆ ಸಿಕ್ಕದಂತೆ ನಿನ್ನನ್ನು ಕಾಪಾಡುವನು.<verse eid="PRO 3:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27"/>ಉಪಕಾರಮಾಡುವುದಕ್ಕೆ ನಿನ್ನಿಂದ ಸಾಧ್ಯವಾಗುವಾಗ</para>
  <para style="q2" vid="PRO 3:27">ಹೊಂದತಕ್ಕವರಿಗೆ ಅದನ್ನು ತಪ್ಪಿಸಬೇಡ.<verse eid="PRO 3:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28"/>ಕೊಡತಕ್ಕದ್ದು ನಿನ್ನಲ್ಲಿದ್ದರೆ ನೆರೆಯವನಿಗೆ, “ಹೋಗಿ ಬಾ,</para>
  <para style="q2" vid="PRO 3:28">ನಾಳೆ ಕೊಡುತ್ತೇನೆ” ಎಂದು ಹೇಳಬೇಡ.<verse eid="PRO 3:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29"/>ನೆರೆಯವನಿಗೆ ಕೇಡನ್ನು ಕಲ್ಪಿಸಬಾರದು,</para>
  <para style="q2" vid="PRO 3:29">ಅವನು ನಿನ್ನ ಪಕ್ಕದಲ್ಲಿ ನಂಬಿಕೆಯಿಂದ ವಾಸಮಾಡುತ್ತಾನಲ್ಲವೇ?<verse eid="PRO 3:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30"/>ನಿನಗೆ ಅಪಕಾರ ಮಾಡದವನ ಸಂಗಡ</para>
  <para style="q2" vid="PRO 3:30">ಸುಮ್ಮನೆ ಜಗಳವಾಡಬೇಡ.<verse eid="PRO 3:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31"/>ಬಲಾತ್ಕಾರಿಯನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡದಿರು,</para>
  <para style="q2" vid="PRO 3:31">ಅವನ ನಡತೆಯನ್ನು ಎಷ್ಟು ಮಾತ್ರಕ್ಕೂ ಅನುಸರಿಸಬೇಡ.<verse eid="PRO 3:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32"/>ವಕ್ರಬುದ್ಧಿಯವನು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯನು,</para>
  <para style="q2" vid="PRO 3:32">ಯಥಾರ್ಥರಿಗೆ ಆತನ ಸ್ನೇಹವು ದೊರೆಯುವುದು.<verse eid="PRO 3:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33"/>ಯೆಹೋವನು ದುಷ್ಟನ ಮನೆಯನ್ನು ಶಪಿಸುವನು,</para>
  <para style="q2" vid="PRO 3:33">ನೀತಿವಂತರ ನಿವಾಸವನ್ನೋ ಆಶೀರ್ವದಿಸುವನು.<verse eid="PRO 3:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34"/>ಯಾರು ಧರ್ಮವನ್ನು ತಿರಸ್ಕರಿಸುವರೋ ಅವರನ್ನು ಆತನು ತಿರಸ್ಕರಿಸುವನು.</para>
  <para style="q2" vid="PRO 3:34">ದೀನರಿಗಾದರೋ ತನ್ನ ಕೃಪೆಯನ್ನು ಅನುಗ್ರಹಿಸುವನು.<verse eid="PRO 3:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35"/>ಜ್ಞಾನವಂತರು ಸನ್ಮಾನಕ್ಕೆ ಬಾಧ್ಯರಾಗುವರು,</para>
  <para style="q2" vid="PRO 3:35">ಜ್ಞಾನಹೀನರಿಗಾಗುವ ಬಹುಮಾನವು ಅವಮಾನವೇ.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s">ಜ್ಞಾನವು ಪರಮೋನ್ನತವಾದದ್ದು</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1"/>ಮಕ್ಕಳೇ, ತಂದೆಯ ಉಪದೇಶವನ್ನು ಕೇಳಿರಿ,</para>
  <para style="q2" vid="PRO 4:1">ವಿವೇಕವನ್ನು ಗ್ರಹಿಸುವಂತೆ ಕಿವಿಗೊಡಿರಿ.<verse eid="PRO 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2"/>ನಾನು ನಿಮಗೆ ಸುಬೋಧೆಯನ್ನು ಮಾಡುವೆನು,</para>
  <para style="q2" vid="PRO 4:2">ನನ್ನ ಉಪದೇಶವನ್ನು ಬಿಡಬೇಡಿರಿ.<verse eid="PRO 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3"/>ನಾನೂ ನನ್ನ ತಂದೆಗೆ ಅಧೀನನಾದ ಮಗನೂ,</para>
  <para style="q2" vid="PRO 4:3">ತಾಯಿಯ ದೃಷ್ಟಿಗೆ ಕೋಮಲನಾದ ಏಕಪುತ್ರನೂ ಆಗಿದ್ದೆನು.<verse eid="PRO 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4"/>ಆಗ ತಂದೆಯು ನನಗೆ ಬೋಧಕನಾಗಿ ಹೀಗೆಂದನು,</para>
  <para style="q2" vid="PRO 4:4">“ನಿನ್ನ ಮನಸ್ಸು ನನ್ನ ಮಾತುಗಳನ್ನು ಹಿಡಿದುಕೊಳ್ಳಲಿ,</para>
  <para style="q2" vid="PRO 4:4">ನನ್ನ ಆಜ್ಞೆಯನ್ನು ಕೈಕೊಂಡು ಸುಖವಾಗಿ ಬಾಳು.<verse eid="PRO 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5"/>ಜ್ಞಾನವನ್ನು ಪಡೆ, ವಿವೇಕವನ್ನು ಸಂಪಾದಿಸು, ಮರೆಯಬೇಡ,</para>
  <para style="q2" vid="PRO 4:5">ನನ್ನ ಮಾತುಗಳಿಗೆ ಅಸಡ್ಡೆ ತೋರಿಸಬೇಡ.<verse eid="PRO 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6"/>ಜ್ಞಾನವನ್ನು ಬಿಡದಿದ್ದರೆ ಅದು ನಿನ್ನನ್ನು ಕಾಪಾಡುವುದು,</para>
  <para style="q2" vid="PRO 4:6">ಪ್ರೀತಿಸಿದರೆ, ಅದು ನಿನ್ನನ್ನು ಕಾಯುವುದು.<verse eid="PRO 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7"/>ಜ್ಞಾನವನ್ನು ಪಡೆಯಬೇಕೆಂಬುದೇ ಜ್ಞಾನಬೋಧೆಯ ಪ್ರಥಮಪಾಠ,</para>
  <para style="q2" vid="PRO 4:7">ನಿನ್ನ ಎಲ್ಲಾ ಸಂಪತ್ತಿನಿಂದಲೂ ವಿವೇಕವನ್ನು ಪಡೆ.<verse eid="PRO 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8"/>ಜ್ಞಾನವೆಂಬಾಕೆಯು ಶ್ರೇಷ್ಠಳು ಎಂದು ನೀನು ಭಾವಿಸಿದರೆ ಆಕೆಯು ನಿನ್ನನ್ನು ಉನ್ನತಿಗೆ ತರುವಳು,</para>
  <para style="q2" vid="PRO 4:8">ಆಕೆಯನ್ನು ಅಪ್ಪಿಕೊಂಡರೆ ನಿನ್ನನ್ನು ಘನಪಡಿಸುವಳು.<verse eid="PRO 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9"/>ಆಕೆಯು ನಿನ್ನ ತಲೆಗೆ ಅಂದದ ಪುಷ್ಪಮಾಲೆಯನ್ನು ಇಟ್ಟು,</para>
  <para style="q2" vid="PRO 4:9">ಸುಂದರ ಕಿರೀಟವನ್ನು ನಿನಗೆ ಒಪ್ಪಿಸುವಳು.”<verse eid="PRO 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10"/>ಕಂದಾ, ಗಮನಿಸಿ ನನ್ನ ಮಾತುಗಳನ್ನು ಕೇಳು,</para>
  <para style="q2" vid="PRO 4:10">ಕೇಳಿದರೆ, ನಿನ್ನ ಜೀವಮಾನದ ವರ್ಷಗಳು ಹೆಚ್ಚುವವು.<verse eid="PRO 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11"/>ನಾನು ಜ್ಞಾನಮಾರ್ಗವನ್ನು ಉಪದೇಶಿಸಿ,</para>
  <para style="q2" vid="PRO 4:11">ಧರ್ಮಮಾರ್ಗದಲ್ಲಿ ನಿನ್ನನ್ನು ನಡೆಸುವೆನು.<verse eid="PRO 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12"/>ನೀನು ನಡೆಯುವಾಗ ನಿನ್ನ ಹೆಜ್ಜೆಗೆ ಅಡ್ಡಿಯಾಗುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 4:12">ಓಡಿದರೆ ಮುಗ್ಗರಿಸುವುದಿಲ್ಲ.<verse eid="PRO 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13"/>ಸದುಪದೇಶವನ್ನು ಗ್ರಹಿಸಿಕೋ, ಸಡಿಲಬಿಡಬೇಡ,</para>
  <para style="q2" vid="PRO 4:13">ಅದನ್ನು ಕಾಪಾಡಿಕೋ, ಅದೇ ನಿನ್ನ ಜೀವವು.<verse eid="PRO 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14"/>ದುಷ್ಟರ ಮಾರ್ಗದಲ್ಲಿ ಸೇರಬೇಡ,</para>
  <para style="q2" vid="PRO 4:14">ಕೆಟ್ಟವರ ದಾರಿಯಲ್ಲಿ ನಡೆಯಬೇಡ.<verse eid="PRO 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15"/>ಅದಕ್ಕೆ ದೂರವಾಗಿರು, ಅದರಲ್ಲಿ ನಡೆಯಬೇಡ,</para>
  <para style="q2" vid="PRO 4:15">ಅದರಿಂದ ಹಿಂತಿರುಗಿ ಮುಂದೆ ನಡೆ.<verse eid="PRO 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16"/>ಕೇಡುಮಾಡದಿದ್ದರೆ ಅವರಿಗೆ ನಿದ್ರೆಬಾರದು;</para>
  <para style="q2" vid="PRO 4:16">ಯಾರನ್ನಾದರೂ ಎಡವಿಬೀಳಿಸದಿದ್ದರೆ ಅವರ ನಿದ್ರೆಗೆ ಭಂಗವಾಗುವುದು.<verse eid="PRO 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17"/>ದುಷ್ಟತನವೇ ಅವರ ಆಹಾರ; ಬಲಾತ್ಕಾರವೇ ಅವರ ದ್ರಾಕ್ಷಾರಸ ಪಾನ.<verse eid="PRO 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18"/>ನೀತಿವಂತರ ಮಾರ್ಗವು ಮಧ್ಯಾಹ್ನದ ವರೆಗೂ</para>
  <para style="q2" vid="PRO 4:18">ಹೆಚ್ಚುತ್ತಾ ಬರುವ ಬೆಳಗಿನ ಬೆಳಕಿನಂತಿದೆ.<verse eid="PRO 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19"/>ದುಷ್ಟರ ಮಾರ್ಗವೋ ಕತ್ತಲಿನಂತಿದೆ;</para>
  <para style="q2" vid="PRO 4:19">ತಾವು ಯಾವುದಕ್ಕೆ ಎಡವಿಬಿದ್ದೆವೆಂದು ಅವರಿಗೆ ಗೊತ್ತಾಗದು.<verse eid="PRO 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20"/>ಕಂದಾ, ನನ್ನ ಮಾತುಗಳನ್ನು ಆಲಿಸು,</para>
  <para style="q2" vid="PRO 4:20">ನನ್ನ ನುಡಿಗಳಿಗೆ ಕಿವಿಗೊಡು.<verse eid="PRO 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21"/>ನಿನ್ನ ದೃಷ್ಟಿಯು ಅವುಗಳ ಮೇಲೆ ತಪ್ಪದಿರಲಿ,</para>
  <para style="q2" vid="PRO 4:21">ಅವುಗಳನ್ನು ನಿನ್ನ ಹೃದಯದೊಳಗೆ ಇಟ್ಟುಕೋ.<verse eid="PRO 4:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22"/>ಅವುಗಳನ್ನು ಹೊಂದುವವರಿಗೆ ಅವು ಜೀವವು,</para>
  <para style="q2" vid="PRO 4:22">ದೇಹಕ್ಕೆಲ್ಲಾ ಅವೇ ಆರೋಗ್ಯವು.<verse eid="PRO 4:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23"/>ನಿನ್ನ ಹೃದಯವನ್ನು ಬಹು ಜಾಗರೂಕತೆಯಿಂದ ಕಾಪಾಡಿಕೋ,</para>
  <para style="q2" vid="PRO 4:23">ಅದರೊಳಗಿಂದ ಜೀವಬುಗ್ಗೆಗಳು ಹೊರಡುವವು.<verse eid="PRO 4:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24"/>ಸೊಟ್ಟಮಾತುಗಳನ್ನು ನಿನ್ನಿಂದ ತೊಲಗಿಸಿಬಿಡು,</para>
  <para style="q2" vid="PRO 4:24">ಕೆಟ್ಟ ನುಡಿಗಳನ್ನು ಬಾಯಿಂದ ದೂರಮಾಡು.<verse eid="PRO 4:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25"/>ನೆಟ್ಟಗೆ ದೃಷ್ಟಿಸು,</para>
  <para style="q2" vid="PRO 4:25">ನಿನ್ನ ಕಣ್ಣುಗಳು ನಿನ್ನ ಮುಂದೆಯೇ ಇರಲಿ.<verse eid="PRO 4:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26"/>ನೀನು ನಡೆಯುವ ದಾರಿಯನ್ನು ಸಮಮಾಡು,</para>
  <para style="q2" vid="PRO 4:26">ಆಗ ನಿನ್ನ ಮಾರ್ಗಗಳೆಲ್ಲಾ ದೃಢವಾಗಿರುವವು.<verse eid="PRO 4:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27"/>ಎಡಕ್ಕಾಗಲಿ ಅಥವಾ ಬಲಕ್ಕಾಗಲಿ ತಿರುಗಬೇಡ,</para>
  <para style="q2" vid="PRO 4:27">ನಿನ್ನ ಕಾಲನ್ನು ಕೇಡಿಗೆ ದೂರಮಾಡು.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s">ವ್ಯಭಿಚಾರದಿಂದ ದೂರವಿರಲು ಎಚ್ಚರಿಕೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1"/>ಕಂದಾ, ನನ್ನ ಜ್ಞಾನೋಪದೇಶವನ್ನು ಆಲಿಸು,</para>
  <para style="q2" vid="PRO 5:1">ವಿವೇಕದಿಂದ ಕೂಡಿದ ನನ್ನ ಬೋಧನೆಗೆ ಕಿವಿಗೊಡು.<verse eid="PRO 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2"/>ಹೀಗಾದರೆ ನೀನು ವಿವೇಚನೆಯನ್ನು ಹೊಂದಿಕೊಳ್ಳುವಿ,</para>
  <para style="q2" vid="PRO 5:2">ನಿನ್ನ ತುಟಿಗಳು ತಿಳಿವಳಿಕೆಯನ್ನು ಕಾಪಾಡುವವು.<verse eid="PRO 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3"/>ವೇಶ್ಯಸ್ತ್ರೀಯ ತುಟಿಗಳಲ್ಲಾದರೋ ಜೇನುಗರೆಯುವುದು,</para>
  <para style="q2" vid="PRO 5:3">ಅವಳ ಮಾತು ಎಣ್ಣೆಗಿಂತಲೂ ನಯವಾಗಿದೆ.<verse eid="PRO 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4"/>ಅವಳು ಕಡೆಯಲ್ಲಿ ವಿಷದಂತೆ ಕಹಿಯೂ,</para>
  <para style="q2" vid="PRO 5:4">ಇಬ್ಬಾಯಿಕತ್ತಿಯಂತೆ ತೀಕ್ಷ್ಣವೂ ಆಗುವಳು.<verse eid="PRO 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5"/>ಅವಳು ಮರಣದ ಕಡೆಗೆ ನಡೆಯುತ್ತಾ ಇಳಿದು ಹೋಗುವಳು,</para>
  <para style="q2" vid="PRO 5:5">ಅವಳ ಹೆಜ್ಜೆಗಳು ಪಾತಾಳದ ದಾರಿಯನ್ನು ಹಿಡಿಯುವವು.<verse eid="PRO 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6"/>ಅವಳ ನಡತೆಯು ಚಂಚಲವಾಗಿರುವುದರಿಂದ ಅವಳು ಜೀವದ ಮಾರ್ಗವನ್ನು ವಿವೇಚಿಸಲಾರಳು,</para>
  <para style="q2" vid="PRO 5:6">ಅದು ಅವಳಿಗೆ ತಿಳಿದೇ ಇಲ್ಲ.<verse eid="PRO 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7"/>ಹೀಗಿರಲು ಮಗನೇ, ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡು,</para>
  <para style="q2" vid="PRO 5:7">ನನ್ನ ಮಾತುಗಳಿಂದ ದೂರವಾಗಿರಬೇಡ.<verse eid="PRO 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8"/>ನಿನ್ನ ಮಾರ್ಗವು ಅವಳಿಗೆ ದೂರವಾಗಿರಲಿ</para>
  <para style="q2" vid="PRO 5:8">ಅವಳ ಮನೆಬಾಗಿಲ ಹತ್ತಿರ ಹೋದೆಯಾ, ಎಚ್ಚರಿಕೆ!<verse eid="PRO 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9"/>ಎಚ್ಚರವಹಿಸಿಕೋ, ನಿನ್ನ ಪುರುಷತ್ವವು ಪರಾಧೀನವಾಗುವುದು,</para>
  <para style="q2" vid="PRO 5:9">ನಿನ್ನ ಆಯುಷ್ಯವು ಕ್ರೂರರ ವಶವಾಗುವುದು.<verse eid="PRO 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10"/>ನಿನ್ನ ಸಂಪತ್ತನ್ನು ಪರರು ತುಂಬಿಕೊಳ್ಳುವರು,</para>
  <para style="q2" vid="PRO 5:10">ನೀನು ಅನ್ಯನ ಮನೆಯಲ್ಲಿ ದುಡಿಯುವಿ.<verse eid="PRO 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11"/>ಕಟ್ಟಕಡೆಗೆ ನಿನ್ನ ದೇಹವೆಲ್ಲಾ ಕ್ಷೀಣವಾಗಿ ನೀನು ಅಂಗಲಾಚಿಕೊಂಡು,<verse eid="PRO 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12"/>“ಅಯ್ಯೋ, ನಾನು ಸದುಪದೇಶವನ್ನು ಎಷ್ಟು ದ್ವೇಷಿಸಿದೆ,</para>
  <para style="q2" vid="PRO 5:12">ನನ್ನ ಹೃದಯವು ಬುದ್ಧಿವಾದವನ್ನು ಎಷ್ಟು ತಾತ್ಸಾರ ಮಾಡಿತು,<verse eid="PRO 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13"/>ನನ್ನ ಬೋಧಕರ ಮಾತನ್ನು ಕೇಳದೆ ಹೋದೆನಲ್ಲಾ,</para>
  <para style="q2" vid="PRO 5:13">ನನ್ನ ಉಪದೇಶಕರ ಕಡೆಗೆ ಕಿವಿಗೊಡಲಿಲ್ಲವಲ್ಲಾ!<verse eid="PRO 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14"/>ನಾನು ದೇವಜನರ ಸಭೆಯ ನಡುವೆ</para>
  <para style="q2" vid="PRO 5:14">ಎಲ್ಲಾ ಕೇಡಿಗೂ ಸಿಕ್ಕಿಕೊಳ್ಳುವ ಹಾಗೆ ಆದೆನು” ಎಂದು ಅಂದುಕೊಳ್ಳುವಿ.<verse eid="PRO 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15"/>ಸ್ವಂತ ಕೊಳದ ನೀರನ್ನು,</para>
  <para style="q2" vid="PRO 5:15">ಸ್ವಂತ ಬಾವಿಯಲ್ಲಿ ಉಕ್ಕುವ ಜಲವನ್ನು ಮಾತ್ರ ಕುಡಿ.<verse eid="PRO 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16"/>ನಿನ್ನ ಒರತೆಗಳು ಬಯಲಿನಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PRO 5:16">ನಿನ್ನ ಕಾಲುವೆಗಳು ಬೀದಿಗಳಲ್ಲಿಯೂ ಹರಡಿ ಹರಿಯುವುದು ಹಿತವೇ?<verse eid="PRO 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17"/>ಅವು ನಿನಗೊಬ್ಬನಿಗೇ ಹರಿಯಲಿ,</para>
  <para style="q2" vid="PRO 5:17">ಪರರು ನಿನ್ನೊಂದಿಗೆ ಸೇರಿ ಕುಡಿಯಬಾರದು.<verse eid="PRO 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18"/>ನಿನ್ನ ಬುಗ್ಗೆಯು ದೇವರ ಆಶೀರ್ವಾದವನ್ನು ಹೊಂದಲಿ,</para>
  <para style="q2" vid="PRO 5:18">
    <note caller="+" style="f">
      <char style="fr" closed="false">5:18 </char>
      <char style="ft" closed="false">ಅಥವಾ ನೀನು ಯೌವನಪ್ರಾಯದಲ್ಲಿ ಮದುವೆಯಾದ ಪತ್ನಿ.</char>
    </note>ನಿನ್ನ ಯೌವನಕಾಲದ ಪತ್ನಿಯಲ್ಲಿ ಆನಂದಿಸು.<verse eid="PRO 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19"/>ಆಕೆ ಮನೋಹರವಾದ ಜಿಂಕೆಯಂತೆಯೂ, ಅಂದವಾದ ದುಪ್ಪಿಯ ಹಾಗೂ ಇರುವಳಲ್ಲಾ,</para>
  <para style="q2" vid="PRO 5:19">ಆಕೆಯ ಸ್ತನಗಳು ನಿನ್ನನ್ನು ಸರ್ವದಾ ತೃಪ್ತಿಪಡಿಸಲಿ, ಆಕೆಯ ಪ್ರೀತಿಯಲ್ಲೇ ನಿರಂತರವಾಗಿ ಲೀನವಾಗಿರು.<verse eid="PRO 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20"/>ಮಗನೇ, ಏಕೆ ಪರಸ್ತ್ರೀಯಲ್ಲಿ ಭ್ರಮೆಗೊಳ್ಳುವಿ,</para>
  <para style="q2" vid="PRO 5:20">ಅನ್ಯಳ ಎದೆಯನ್ನು ತಬ್ಬಿಕೊಳ್ಳುವುದೇಕೆ?<verse eid="PRO 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21"/>ಮನುಷ್ಯನ ಮಾರ್ಗಗಳು ಯೆಹೋವನಿಗೆ ಕಾಣುತ್ತಲೇ ಇವೆ,</para>
  <para style="q2" vid="PRO 5:21">ಆತನು ಮನುಷ್ಯನ ನಡತೆಯನ್ನೆಲ್ಲಾ ಪರೀಕ್ಷಿಸುವವನಾಗಿದ್ದಾನೆ.<verse eid="PRO 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22"/>ದುಷ್ಟನ ದುಷ್ಕೃತ್ಯಗಳೇ ಅವನನ್ನು ಆಕ್ರಮಿಸುವವು,</para>
  <para style="q2" vid="PRO 5:22">ಅವನ ಪಾಪಪಾಶಗಳೇ ಅವನನ್ನು ಬಂಧಿಸುವವು.<verse eid="PRO 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23"/>ಸದುಪದೇಶದ ಕೊರತೆಯಿಂದಲೇ ನಾಶವಾಗುವನು,</para>
  <para style="q2" vid="PRO 5:23">ತನ್ನ ಅತಿಮೂರ್ಖತನದಿಂದ ಭ್ರಾಂತನಾಗುವನು.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s">ಮಾತುಕೊಡುವುದರಲ್ಲಿ ಎಚ್ಚರಿಕೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1"/>ಮಗನೇ, ನೀನು ನೆರೆಯವನ ಸಾಲಕ್ಕೆ ಹೊಣೆಯಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 6:1">ಪರನೊಂದಿಗೆ ಪ್ರಮಾಣ ಮಾಡಿಕೊಂಡಿದ್ದರೆ,<verse eid="PRO 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2"/>ನೀನು ಮಾತುಕೊಟ್ಟು ಪಾಶಕ್ಕೆ ಸಿಕ್ಕಿಕೊಂಡಿದ್ದೀ,</para>
  <para style="q2" vid="PRO 6:2">ನಿನ್ನ ವಾಗ್ದಾನವು ನಿನ್ನನ್ನು ಹಿಡಿದಿದೆ.<verse eid="PRO 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3"/>ಹೀಗಿರಲು, ಮಗನೇ, ನೀನು ನೆರೆಯವನ ಕೈಗೆ ಸಿಕ್ಕಿಕೊಂಡದ್ದರಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವ ಒಂದು ಕೆಲಸ ಮಾಡು,</para>
  <para style="q2" vid="PRO 6:3">ನಡೆ, ತ್ವರೆಪಡು, ಆ ನೆರೆಯವನನ್ನು ಅಂಗಲಾಚಿ ಬೇಡಿಕೋ,<verse eid="PRO 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4"/>ನಿನ್ನ ಕಣ್ಣುಗಳಿಗೆ ನಿದ್ರೆಕೊಡಬೇಡ,</para>
  <para style="q" vid="PRO 6:4">ನಿನ್ನ ರೆಪ್ಪೆಗಳನ್ನು ಮುಚ್ಚಬೇಡ;<verse eid="PRO 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5"/>ಬೇಟೆಗಾರನ ಕೈಯಿಂದ ಜಿಂಕೆಯು ಓಡುವಂತೆಯೂ,</para>
  <para style="q2" vid="PRO 6:5">ಪಕ್ಷಿಯು ಹಾರಿ ಹೋಗುವ ಹಾಗೂ ತಪ್ಪಿಸಿಕೋ.<verse eid="PRO 6:5"/></para>
  <para style="s">ಸೋಮಾರಿಯಾಗಿರಬೇಡ</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6"/>ಸೋಮಾರಿಯೇ, ಇರುವೆಯ ಹತ್ತಿರ ಹೋಗಿ,</para>
  <para style="q2" vid="PRO 6:6">ಅದರ ನಡವಳಿಕೆಯನ್ನು ನೋಡಿ ಜ್ಞಾನವನ್ನು ಪಡೆದುಕೋ.<verse eid="PRO 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7"/>ಅದಕ್ಕೆ ನಾಯಕ, ಅಧಿಕಾರಿ ಹಾಗೂ ಪ್ರಭುಗಳಿಲ್ಲದಿದ್ದರೂ,<verse eid="PRO 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8"/>ಬೇಸಿಗೆಯಲ್ಲಿ ತನ್ನ ತೀನಿಯನ್ನು ಸಿದ್ಧಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 6:8">ಸುಗ್ಗಿಯ ಕಾಲದಲ್ಲಿ ತನಗೆ ಬೇಕಾದಷ್ಟು ಆಹಾರವನ್ನು ಸಂಗ್ರಹಿಸಿಟ್ಟುಕೊಳ್ಳುವುದು.<verse eid="PRO 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9"/>ಸೋಮಾರಿಯೇ, ಎಷ್ಟು ಹೊತ್ತು ನಿದ್ರೆ?</para>
  <para style="q2" vid="PRO 6:9">ನಿದ್ರೆಯಿಂದ ಯಾವಾಗ ಎಚ್ಚರಗೊಳ್ಳುವಿ?<verse eid="PRO 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10"/>“ಇನ್ನು ಸ್ವಲ್ಪ ನಿದ್ದೆ, ಇನ್ನು ಸ್ವಲ್ಪ ತೂಕಡಿಕೆ,</para>
  <para style="q2" vid="PRO 6:10">ಇನ್ನೂ ಕೊಂಚ ನಿದ್ದೆಗಾಗಿ ಕೈಮುದುರಿಕೊಳ್ಳುವೆ” ಅಂದುಕೊಳ್ಳುವಿಯಾ?<verse eid="PRO 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11"/>ಬಡತನವು ದಾರಿಗಳ್ಳನ ಹಾಗೂ</para>
  <para style="q2" vid="PRO 6:11">ಕೊರತೆಯು ಪಂಜುಗಳ್ಳನಂತೆಯೂ ನಿನ್ನ ಮೇಲೆ ಬೀಳುವವು.<verse eid="PRO 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12"/>ನೀಚನೂ, ದುಷ್ಟನೂ ಆಗಿರುವ ಮನುಷ್ಯನ ನಡತೆಯನ್ನು ನೋಡು,</para>
  <para style="q2" vid="PRO 6:12">ಅವನು ವಕ್ರ ಮಾತಿನವನಾಗಿದ್ದಾನೆ,<verse eid="PRO 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13"/>ಕಣ್ಣನ್ನು ಮಿಟಕಿಸುತ್ತಾನೆ, ಕಾಲಿನಿಂದ ಕೆರೆಯುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 6:13">ಬೆರಳ ಸನ್ನೆಮಾಡುತ್ತಾನೆ.<verse eid="PRO 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14"/>ಅವನ ಮನಸ್ಸಿನಲ್ಲಿರುವುದು ದ್ರೋಹವೇ;</para>
  <para style="q2" vid="PRO 6:14">ಯಾವಾಗಲೂ ಕೇಡನ್ನು ಕಲ್ಪಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 6:14">ಜಗಳದ ಬೀಜವನ್ನು ಬಿತ್ತುತ್ತಾನೆ.<verse eid="PRO 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15"/>ಆದಕಾರಣ ಅವನಿಗೆ ತಟ್ಟನೆ ವಿಪತ್ತು ಸಂಭವಿಸುವುದು,</para>
  <para style="q2" vid="PRO 6:15">ಏಳದ ಹಾಗೆ ಫಕ್ಕನೆ ಮುರಿಯಲ್ಪಡುವನು.<verse eid="PRO 6:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16"/>ಯೆಹೋವನು ಹಗೆಮಾಡುವ ವಿಷಯಗಳು ಆರು ಇವೆ,</para>
  <para style="q2" vid="PRO 6:16">ಹೌದು, ಏಳು ಸಂಗತಿಗಳು ಆತನಿಗೆ ಅಸಹ್ಯವಾಗಿ ತೋರುತ್ತವೆ.<verse eid="PRO 6:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17"/>ಅವು ಯಾವುವೆಂದರೆ, ಹೆಮ್ಮೆಯ ಕಣ್ಣು, ಸುಳ್ಳಿನ ನಾಲಿಗೆ,</para>
  <para style="q2" vid="PRO 6:17">ನಿರ್ದೋಷಿಗಳ ರಕ್ತವನ್ನು ಸುರಿಸುವ ಕೈ,<verse eid="PRO 6:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18"/>ದುರಾಲೋಚನೆಗಳನ್ನು ಕಲ್ಪಿಸುವ ಹೃದಯ,</para>
  <para style="q2" vid="PRO 6:18">ಕೇಡುಮಾಡಲು ತ್ವರೆಪಡುವ ಕಾಲು,<verse eid="PRO 6:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19"/>ಅಸತ್ಯವಾಡುವ ಸುಳ್ಳುಸಾಕ್ಷಿ ಮತ್ತು</para>
  <para style="q2" vid="PRO 6:19">ಒಡಹುಟ್ಟಿದವರಲ್ಲಿ ಜಗಳಗಳನ್ನು ಬಿತ್ತುವವನು ಇವುಗಳೇ.<verse eid="PRO 6:19"/></para>
  <para style="s">ಪರಸ್ತ್ರೀಯರ ಸಹವಾಸದ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆ</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20"/>ಕಂದಾ, ತಂದೆಯ ಆಜ್ಞೆಯನ್ನು ಕೈಕೊಳ್ಳು,</para>
  <para style="q2" vid="PRO 6:20">ತಾಯಿಯ ಉಪದೇಶವನ್ನು ಬಿಡಬೇಡ.<verse eid="PRO 6:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21"/>ಅವುಗಳನ್ನು ಸದಾ ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟುಕೋ,</para>
  <para style="q2" vid="PRO 6:21">ನಿನ್ನ ಕೊರಳಿಗೆ ಅವುಗಳನ್ನು ಧರಿಸಿಕೋ.<verse eid="PRO 6:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22"/>ನೀನು ನಡೆಯುವಾಗ ಆ ಉಪದೇಶವು ನಿನ್ನನ್ನು ಮುನ್ನಡೆಸುವುದು,</para>
  <para style="q2" vid="PRO 6:22">ಮಲಗಿಕೊಂಡಾಗ ಅದು ನಿನ್ನನ್ನು ಕಾಯುವುದು,</para>
  <para style="q2" vid="PRO 6:22">ಎಚ್ಚರಗೊಂಡಾಗ ನಿನ್ನೊಂದಿಗೆ ಮಾತನಾಡುವುದು.<verse eid="PRO 6:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23"/>ಆಜ್ಞೆಯೇ ದೀಪ, ಉಪದೇಶವೇ ಬೆಳಕು,</para>
  <para style="q2" vid="PRO 6:23">ಶಿಕ್ಷಣಪೂರ್ವಕವಾದ ಬೋಧನೆಯೇ ಜೀವದ ಮಾರ್ಗ.<verse eid="PRO 6:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24"/>ಅದು ಕೆಟ್ಟ ಸ್ತ್ರೀಯಿಂದಲೂ,</para>
  <para style="q2" vid="PRO 6:24">ವೇಶ್ಯೆಯ ಸಿಹಿನುಡಿಯಿಂದಲೂ ನಿನ್ನನ್ನು ರಕ್ಷಿಸತಕ್ಕದ್ದಾಗಿದೆ.<verse eid="PRO 6:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25"/>ನಿನ್ನ ಹೃದಯವು ಅವಳ ಸೌಂದರ್ಯವನ್ನು ಮೋಹಿಸದಿರಲಿ,</para>
  <para style="q2" vid="PRO 6:25">ಅವಳು ತನ್ನ ಕಣ್ಣುರೆಪ್ಪೆಗಳಿಂದ ನಿನ್ನನ್ನು ವಶಮಾಡಿಕೊಂಡಾಳು, ನೋಡಿಕೋ.<verse eid="PRO 6:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26"/>ವೇಶ್ಯೆಯಿಂದ ಯಾವನಿಗಾದರೂ ಒಂದು ರೊಟ್ಟಿ ಮಾತ್ರ ಗತಿಯಾಗುವುದು,</para>
  <para style="q2" vid="PRO 6:26">ಪರಸ್ತ್ರೀಯೋ ಅಮೂಲ್ಯವಾದ ಜೀವವನ್ನು ಬೇಟೆಯಾಡುವಳು.<verse eid="PRO 6:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27"/>ಮಡಿಲಲ್ಲಿ ಬೆಂಕಿಯನ್ನು ಇಟ್ಟುಕೊಂಡರೆ</para>
  <para style="q2" vid="PRO 6:27">ಬಟ್ಟೆ ಸುಡುವುದಿಲ್ಲವೋ?<verse eid="PRO 6:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28"/>ಧಗಧಗಿಸುವ ಕೆಂಡದ ಮೇಲೆ ನಡೆದರೆ</para>
  <para style="q2" vid="PRO 6:28">ಕಾಲು ಬೇಯುವುದಿಲ್ಲವೋ?<verse eid="PRO 6:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29"/>ನೆರೆಯವನ ಹೆಂಡತಿಯ ಹತ್ತಿರ ಹೋಗುವವನಿಗೆ ಹೀಗೆಯೇ ಆಗುವುದು,</para>
  <para style="q2" vid="PRO 6:29">ಯಾರು ಅವಳನ್ನು ಮುಟ್ಟುವನೋ ಅವನು ದಂಡನೆಯನ್ನು ಹೊಂದದೇ ಇರನು.<verse eid="PRO 6:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30"/>ಕಳ್ಳನು ಹೊಟ್ಟೆಗಿಲ್ಲದೆ ಹಸಿವೆಯನ್ನು ನೀಗಿಸಲು ಕಳವು ಮಾಡಿದರೆ</para>
  <para style="q2" vid="PRO 6:30">ಜನರು ಅಷ್ಟೇನೂ ಹೀಯಾಳಿಸರು.<verse eid="PRO 6:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31"/>ಅವನ ತಪ್ಪು ಬಯಲಾದರೆ ಅವನು ಏಳರಷ್ಟು ಕೊಡಬೇಕಾಗುವುದು,</para>
  <para style="q2" vid="PRO 6:31">ಅಥವಾ ತನ್ನ ಮನೆಯ ಆಸ್ತಿಯನ್ನೆಲ್ಲಾ ಕೊಟ್ಟು ತೀರಿಸಲೇಬೇಕು.<verse eid="PRO 6:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32"/>ವ್ಯಭಿಚಾರಿಯೋ ಕೇವಲ ಬುದ್ಧಿಹೀನನು,</para>
  <para style="q2" vid="PRO 6:32">ಇಂಥಾ ಕಾರ್ಯವನ್ನು ಮಾಡುವವನು ತನ್ನನ್ನೇ ನಾಶಪಡಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 6:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33"/>ಅವನಿಗೆ ಗಾಯವೂ, ಅವಮಾನವೂ ಆಗುವವು,</para>
  <para style="q2" vid="PRO 6:33">ಅವನ ಕೆಟ್ಟ ಹೆಸರು ಎಂದಿಗೂ ಅಳಿಸಲ್ಪಡದು.<verse eid="PRO 6:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34"/>ಏಕೆಂದರೆ ಮತ್ಸರವು ಪತಿಗೆ ಕ್ರೋಧವನ್ನು ಉಂಟುಮಾಡುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 6:34">ಅವನು ಮುಯ್ಯಿತೀರಿಸತಕ್ಕ ದಿನದಲ್ಲಿ ವ್ಯಭಿಚಾರಿಯನ್ನು ಉಳಿಸನು.<verse eid="PRO 6:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35"/>ಅವನು ಯಾವ ಈಡನ್ನೂ ಮುಟ್ಟನು; ಎಷ್ಟು ಲಂಚಕೊಟ್ಟರೂ ಒಪ್ಪನು.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s">ಜಾರಸ್ತ್ರೀಯ ವಿಷಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1"/>ಕಂದಾ, ನನ್ನ ಮಾತುಗಳನ್ನು ಮನಸ್ಸಿನಲ್ಲಿಟ್ಟುಕೋ,</para>
  <para style="q2" vid="PRO 7:1">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನಿಧಿಯಂತೆ ಕಾಪಾಡಿಕೋ.<verse eid="PRO 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2"/>ನನ್ನ ಉಪದೇಶವನ್ನು ಕಣ್ಣುಗುಡ್ಡೆಯಂತೆ ಪಾಲಿಸು,</para>
  <para style="q2" vid="PRO 7:2">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಕೊಂಡು ಬಾಳು.<verse eid="PRO 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3"/>ಅವುಗಳನ್ನು ನಿನ್ನ ಬೆರಳುಗಳಿಗೆ ಉಂಗುರವಾಗಿ ಧರಿಸಿಕೋ,</para>
  <para style="q2" vid="PRO 7:3">ಹೃದಯದ ಹಲಗೆಯಲ್ಲಿ ಅವುಗಳನ್ನು ಬರೆದುಕೋ.<verse eid="PRO 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4"/>ಜ್ಞಾನವನ್ನು, “ನೀನು ನನ್ನ ಅಕ್ಕಾ” ಎಂದು ಹೇಳು,</para>
  <para style="q2" vid="PRO 7:4">ವಿವೇಕವನ್ನು, “ಪ್ರಿಯೇ” ಎಂದು ಕರೆ.<verse eid="PRO 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5"/>ಅವು ಜಾರಳಿಂದ ಮತ್ತು ಸವಿಮಾತನಾಡುವ</para>
  <para style="q2" vid="PRO 7:5">ಪರಸ್ತ್ರೀಯಿಂದ ನಿನ್ನನ್ನು ರಕ್ಷಿಸುವವು.<verse eid="PRO 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6"/>ನಾನು ನನ್ನ ಮನೆಯ ಕಿಟಕಿಯ</para>
  <para style="q2" vid="PRO 7:6">ಜಾಲರಿಯಿಂದ ಇಣಿಕಿ ನೋಡಲು<verse eid="PRO 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7"/>ಅಲ್ಪಬುದ್ಧಿಯುಳ್ಳ ಅನೇಕ ಯುವಕರು ಕಾಣಿಸಿದರು.</para>
  <para style="q2" vid="PRO 7:7">ಅವರಲ್ಲಿ ಜ್ಞಾನಹೀನನಾದ ಒಬ್ಬ ಯೌವನಸ್ಥನನ್ನು ಕಂಡೆನು.<verse eid="PRO 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8"/>ಅವನು ಸಂಜೆಯ ಮೊಬ್ಬಿನಲ್ಲಿ, ಮಧ್ಯರಾತ್ರಿಯ ಅಂಧಕಾರದಲ್ಲಿ,<verse eid="PRO 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9"/>ಅವಳ ಮನೆಯ ಹತ್ತಿರ ಬೀದಿಯಲ್ಲಿ ಹಾದುಹೋಗುತ್ತಾ,</para>
  <para style="q2" vid="PRO 7:9">ಅವಳ ಮನೆಯ ಕಡೆಗೆ ತಿರುಗಿದ್ದನ್ನು ಕಂಡೆನು.<verse eid="PRO 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10"/>ಇಗೋ ವೇಶ್ಯಾರೂಪವನ್ನು ಧರಿಸಿಕೊಂಡಿದ್ದ</para>
  <para style="q2" vid="PRO 7:10">ಒಬ್ಬ ಕಪಟ ಸ್ತ್ರೀಯು ಅವನನ್ನು ಎದುರುಗೊಂಡಳು.<verse eid="PRO 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11"/>ಇವಳು ಕೂಗಾಟದವಳು, ಹಟಮಾರಿ,</para>
  <para style="q2" vid="PRO 7:11">ಮನೆಯಲ್ಲಿ ನಿಲ್ಲತಕ್ಕವಳೇ ಅಲ್ಲ;<verse eid="PRO 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12"/>ಒಂದು ವೇಳೆ ಬೀದಿಗಳಲ್ಲಿರುವಳು, ಮತ್ತೊಂದು ವೇಳೆ ಚೌಕಗಳಲ್ಲಿರುವಳು,</para>
  <para style="q2" vid="PRO 7:12">ಅಂತು ಪ್ರತಿಯೊಂದು ಮೂಲೆಯಲ್ಲಿಯೂ ಹೊಂಚು ಹಾಕುವಳು.<verse eid="PRO 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13"/>ಅವನನ್ನು ಹಿಡಿದು, ಮುದ್ದಾಡಿ ನಾಚಿಕೆಗೆಟ್ಟವಳಾಗಿ,<verse eid="PRO 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14"/>“ಎಲೈ, ಈ ದಿನ ನನ್ನ ಹರಕೆಗಳನ್ನು ಸಲ್ಲಿಸಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PRO 7:14">ಸಮಾಧಾನ ಯಜ್ಞಶೇಷವು ನನ್ನಲ್ಲಿದೆ,<verse eid="PRO 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15"/>ಆದಕಾರಣ ನಿನ್ನನ್ನು ಎದುರುಗೊಳ್ಳಲು ಬಂದೆನು,</para>
  <para style="q2" vid="PRO 7:15">ನಿನ್ನನ್ನು ಆತುರದಿಂದ ಹುಡುಕಿ ಕಂಡುಕೊಂಡೆನು.<verse eid="PRO 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16"/>ನನ್ನ ಮಂಚದಲ್ಲಿ ಸುಪ್ಪತ್ತಿಯನ್ನೂ,</para>
  <para style="q2" vid="PRO 7:16">ಐಗುಪ್ತದೇಶದ ನೂಲಿನ ವಿಚಿತ್ರ ವಸ್ತ್ರಗಳನ್ನೂ ಹಾಸಿದ್ದೇನೆ.<verse eid="PRO 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17"/>ಹಾಸಿಗೆಯ ಮೇಲೆ ರಕ್ತಬೋಳ, ಅಗುರು,</para>
  <para style="q2" vid="PRO 7:17">ಲವಂಗ, ಚಕ್ಕೆ ಇವುಗಳ ಚೂರ್ಣಗಳಿಂದ ಸುವಾಸನೆಗೊಳಿಸಿದ್ದೇನೆ.<verse eid="PRO 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18"/>ಬಾ, ಬೆಳಗಿನ ತನಕ ಬೇಕಾದಷ್ಟು ರಮಿಸುವ,</para>
  <para style="q2" vid="PRO 7:18">ಕಾಮವಿಲಾಸಗಳಿಂದ ಸಂತೋಷಿಸುವ.<verse eid="PRO 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19"/>ಯಜಮಾನನು ಮನೆಯಲ್ಲಿಲ್ಲ, ದೂರ ಪ್ರಯಾಣದಲ್ಲಿದ್ದಾನೆ.<verse eid="PRO 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20"/>ಹಣದ ಗಂಟನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಿದ್ದಾನೆ,</para>
  <para style="q2" vid="PRO 7:20">ಹುಣ್ಣಿಮೆಗೆ ಮನೆಗೆ ಬರುವನು” ಎಂದು ಹೇಳುವಳು.<verse eid="PRO 7:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21"/>ಅವಳು ಅವನನ್ನು ತನ್ನ ಸವಿಮಾತುಗಳಿಂದ ಮನವೊಲಿಸಿ,</para>
  <para style="q2" vid="PRO 7:21">ಬಹಳವಾಗಿ ಪ್ರೇರೇಪಿಸಿ ಸಮ್ಮತಿಪಡಿಸುತ್ತಾಳೆ.<verse eid="PRO 7:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22"/>ಹೋರಿಯು ವಧ್ಯಸ್ಥಾನಕ್ಕೆ ಹೋಗುವ ಹಾಗೂ,</para>
  <para style="q2" vid="PRO 7:22">ಬೇಡಿಬಿದ್ದಿರುವ ಮೂರ್ಖನು ದಂಡನೆಗೆ ನಡೆಯುವಂತೆಯೂ,<verse eid="PRO 7:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23"/>ಪಕ್ಷಿಯು ಬಲೆಯ ಕಡೆಗೆ ಓಡುವಂತೆಯೂ,</para>
  <para style="q2" vid="PRO 7:23">ಅವನು ತನ್ನ ಪ್ರಾಣಾಪಾಯವನ್ನು ತಿಳಿಯದೆ,</para>
  <para style="q2" vid="PRO 7:23">ಬಾಣವು ತನ್ನ ಕಾಳಿಜವನ್ನು ತಿವಿಯುವ ಮೇರೆಗೂ,</para>
  <para style="q2" vid="PRO 7:23">ಅವನು ತಟ್ಟನೆ ಅವಳ ಹಿಂದೆ ಹೋಗುತ್ತಾನೆ.<verse eid="PRO 7:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24"/>ಈಗ, ಮಕ್ಕಳೇ, ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡಿರಿ,</para>
  <para style="q2" vid="PRO 7:24">ನನ್ನ ಮಾತುಗಳನ್ನು ಆಲಿಸಿರಿ.<verse eid="PRO 7:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25"/>ನಿನ್ನ ಹೃದಯವು ಅವಳ ನಡತೆಯ ಕಡೆಗೆ ತಿರುಗದಿರಲಿ,</para>
  <para style="q2" vid="PRO 7:25">ತಪ್ಪಿಹೋಗಿಯೂ ಅವಳ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯಬೇಡ.<verse eid="PRO 7:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26"/>ಅವಳಿಂದ ಗಾಯಪಟ್ಟು ಬಿದ್ದವರು ಬಹು ಜನರು,</para>
  <para style="q2" vid="PRO 7:26">ಹತರಾದವರೋ ಲೆಕ್ಕವೇ ಇಲ್ಲ.<verse eid="PRO 7:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27"/>ಅವಳ ಮನೆಯು ಪಾತಾಳದ ದಾರಿ,</para>
  <para style="q2" vid="PRO 7:27">ಅದು ಮೃತ್ಯುವಿನ ಅಂತಃಪುರಕ್ಕೆ ಇಳಿದುಹೋಗುತ್ತದೆ.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s">ಜ್ಞಾನವೆಂಬಾಕೆ ನೀಡುವ ಕರೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1"/>ಜ್ಞಾನವೆಂಬಾಕೆಯು ಕರೆಯುತ್ತಾಳಲ್ಲವೇ?</para>
  <para style="q2" vid="PRO 8:1">ವಿವೇಕವೆಂಬ ಆಕೆಯು ಧ್ವನಿಗೈಯುತ್ತಾಳಲ್ಲವೇ?<verse eid="PRO 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2"/>ಆಕೆಯು ರಾಜಮಾರ್ಗಗಳ ಮುಖ್ಯಸ್ಥಾನದಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 8:2">ದಾರಿಯ ಪಕ್ಕದಲ್ಲಿ, ನಡುಬೀದಿಯಲ್ಲಿ ನಿಂತುಕೊಳ್ಳುತ್ತಾಳೆ.<verse eid="PRO 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3"/>ಆಕೆ ಪಟ್ಟಣದ ಪ್ರವೇಶ ದ್ವಾರದಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 8:3">ಬಾಗಿಲುಗಳೊಳಗೆ ಜನಸೇರುವ ಸ್ಥಳದಲ್ಲಿ ಹೀಗೆ ಕೂಗುತ್ತಾಳೆ,<verse eid="PRO 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4"/>“ಜನರೇ, ನಿಮ್ಮನ್ನೇ ಕರೆಯುತ್ತೇನೆ,</para>
  <para style="q2" vid="PRO 8:4">ಮಾನವರಿಗಾಗಿಯೇ ಧ್ವನಿಗೈಯುತ್ತೇನೆ.<verse eid="PRO 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5"/>ಮೂಢರೇ, ಜಾಣತನವನ್ನು ಕಲಿತುಕೊಳ್ಳಿರಿ,</para>
  <para style="q2" vid="PRO 8:5">ಜ್ಞಾನಹೀನರೇ, ಬುದ್ಧಿಯನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳಿರಿ.<verse eid="PRO 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6"/>ಕೇಳಿರಿ, ನಾನು ಶ್ರೇಷ್ಠವಾದ ಸಂಗತಿಗಳನ್ನು ಹೇಳುವೆನು,</para>
  <para style="q2" vid="PRO 8:6">ಯಥಾರ್ಥಕ್ಕಾಗಿಯೇ ತುಟಿಗಳನ್ನು ತೆರೆಯುವೆನು,<verse eid="PRO 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7"/>ನನ್ನ ಬಾಯಿ ಸತ್ಯವನ್ನೇ ಆಡುವುದು,</para>
  <para style="q2" vid="PRO 8:7">ದುಷ್ಟತನವು ನನ್ನ ತುಟಿಗಳಿಗೆ ಅಸಹ್ಯವಾಗಿದೆ.<verse eid="PRO 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8"/>ನನ್ನ ಮಾತುಗಳೆಲ್ಲಾ ನೀತಿಭರಿತವಾಗಿವೆ,</para>
  <para style="q2" vid="PRO 8:8">ಅವುಗಳಲ್ಲಿ ಕಪಟವೂ, ವಕ್ರತೆಯೂ ಇಲ್ಲ.<verse eid="PRO 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9"/>ಅವೆಲ್ಲಾ ಗ್ರಹಿಕೆಯುಳ್ಳವನಿಗೆ ನ್ಯಾಯವಾಗಿಯೂ,</para>
  <para style="q2" vid="PRO 8:9">ತಿಳಿವಳಿಕೆಯನ್ನು ಪಡೆದವರಿಗೆ ಯಥಾರ್ಥವಾಗಿಯೂ ತೋರುವವು.<verse eid="PRO 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10"/>ನನ್ನ ಬೋಧನೆಯನ್ನು ಬೆಳ್ಳಿಗಿಂತಲೂ ಮತ್ತು</para>
  <para style="q2" vid="PRO 8:10">ಜ್ಞಾನೋಪದೇಶವನ್ನು ಅಪರಂಜಿಗಿಂತಲೂ ಉತ್ತಮವೆಂದು ಹೊಂದಿಕೊಳ್ಳಿರಿ.<verse eid="PRO 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11"/>ಜ್ಞಾನವು ಹವಳಕ್ಕಿಂತಲೂ ಶ್ರೇಷ್ಠ,</para>
  <para style="q2" vid="PRO 8:11">ಇಷ್ಟವಸ್ತುಗಳೆಲ್ಲವೂ ಅದಕ್ಕೆ ಸಮವಲ್ಲ.<verse eid="PRO 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12"/>ಜ್ಞಾನವೆಂಬ ನನಗೆ ಜಾಣ್ಮೆಯೇ ನಿವಾಸ,</para>
  <para style="q2" vid="PRO 8:12">ಯುಕ್ತಿಗಳ ತಿಳಿವಳಿಕೆಯನ್ನು ಹೊಂದಿದ್ದೇನೆ.<verse eid="PRO 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13"/>ಯೆಹೋವನ ಭಯವು ಪಾಪದ್ವೇಷವನ್ನು ಹುಟ್ಟಿಸುತ್ತದೆ;</para>
  <para style="q2" vid="PRO 8:13">ಗರ್ವ, ಅಹಂಭಾವ, ದುರ್ಮಾರ್ಗತನ,</para>
  <para style="q2" vid="PRO 8:13">ಕುಟಿಲ ಭಾಷಣ ಇವುಗಳನ್ನು ಹಗೆಮಾಡುತ್ತೇನೆ.<verse eid="PRO 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14"/>ಸದ್ಯೋಚನೆಯೂ, ಸುಜ್ಞಾನವೂ, ಸಾಮರ್ಥ್ಯವೂ ನನ್ನಲ್ಲಿವೆ,</para>
  <para style="q2" vid="PRO 8:14">ವಿವೇಕವೂ ನಾನೇ.<verse eid="PRO 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15"/>ನನ್ನ ಸಹಾಯದಿಂದ ರಾಜರು ಆಳುವರು,</para>
  <para style="q2" vid="PRO 8:15">ಅಧಿಪತಿಗಳು ಸಹ ನ್ಯಾಯತೀರಿಸುವರು.<verse eid="PRO 8:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16"/>ನನ್ನ ಮೂಲಕ ಪ್ರಭುಗಳು, ನಾಯಕರು</para>
  <para style="q2" vid="PRO 8:16">ಅಂತು ಭೂಪತಿಗಳೆಲ್ಲರೂ ದೊರೆತನ ಮಾಡುವರು.<verse eid="PRO 8:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17"/>ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರನ್ನು ನಾನು ಪ್ರೀತಿಸುತ್ತೇನೆ,</para>
  <para style="q2" vid="PRO 8:17">ಆತುರದಿಂದ ಹುಡುಕುವವರು ನನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳುವರು.<verse eid="PRO 8:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18"/>ನನ್ನಲ್ಲಿ ಧನ, ಘನತೆ, ಶ್ರೇಷ್ಠಸಂಪತ್ತೂ,</para>
  <para style="q2" vid="PRO 8:18">ನೀತಿಯೂ ಇರುತ್ತವೆ.<verse eid="PRO 8:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19"/>ನನ್ನಿಂದಾಗುವ ಫಲವು ಬಂಗಾರಕ್ಕಿಂತಲೂ</para>
  <para style="q2" vid="PRO 8:19">ಹೌದು ಅಪರಂಜಿಗಿಂತಲೂ ಉತ್ತಮ.</para>
  <para style="q2" vid="PRO 8:19">ನನ್ನ ಮೂಲಕವಾದ ಆದಾಯವು</para>
  <para style="q2" vid="PRO 8:19">ಚೊಕ್ಕ ಬೆಳ್ಳಿಗಿಂತಲೂ ಅಮೂಲ್ಯವಾಗಿದೆ.<verse eid="PRO 8:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:20 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಾನು ಸತ್ಯವನ್ನು ನೀತಿ ಮತ್ತು ನ್ಯಾಯ ಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆಯುವಂತೆ ಮಾಡುತ್ತೇನೆ.</char>
    </note>ನಾನು ಹಿಡಿದಿರುವ ದಾರಿಯು ನೀತಿಯೇ,</para>
  <para style="q2" vid="PRO 8:20">ನ್ಯಾಯಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆಯುತ್ತೇನೆ.<verse eid="PRO 8:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21"/>ಹೀಗಿರಲು ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ಧನದ ಬಾಧ್ಯತೆಯನ್ನು ಅನುಗ್ರಹಿಸಿ,</para>
  <para style="q2" vid="PRO 8:21">ಅವರ ಬೊಕ್ಕಸಗಳನ್ನು ತುಂಬಿಸುವೆನು.<verse eid="PRO 8:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22"/>ಯೆಹೋವನು ತನ್ನ ಸೃಷ್ಟಿಕ್ರಮದಲ್ಲಿ ಮೊದಲು ನನ್ನನ್ನು ನಿರ್ಮಿಸಿದನು;</para>
  <para style="q2" vid="PRO 8:22">ಆತನ ಪುರಾತನಕಾರ್ಯಗಳಲ್ಲಿ ನಾನೇ ಪ್ರಥಮ.<verse eid="PRO 8:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23"/>ಪ್ರಾರಂಭದಲ್ಲಿ, ಭೂಮಿಯು ಹುಟ್ಟುವುದಕ್ಕಿಂತ ಮುಂಚೆ,</para>
  <para style="q2" vid="PRO 8:23">ಅನಾದಿಕಾಲದಲ್ಲಿ ಸ್ಥಾಪಿಸಲ್ಪಟ್ಟೆನು.<verse eid="PRO 8:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24"/>ಜಲನಿಧಿಗಳಾಗಲಿ, ನೀರು ತುಂಬಿದ ಬುಗ್ಗೆಗಳಾಗಲಿ</para>
  <para style="q2" vid="PRO 8:24">ಇಲ್ಲದಿರುವಾಗ ನಾನು ಹುಟ್ಟಿದೆನು.<verse eid="PRO 8:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25"/>ಬೆಟ್ಟಗುಡ್ಡಗಳು ಬೇರೂರಿ ನಿಲ್ಲುವುದಕ್ಕೆ ಮುಂಚೆ</para>
  <para style="q2" vid="PRO 8:25">ಆತನು ಭೂಲೋಕವನ್ನಾಗಲಿ, ಬಯಲನ್ನಾಗಲಿ,<verse eid="PRO 8:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26"/>ಭೂಮಿಯ ಮೊದಲನೆಯ ಅಣುರೇಣನ್ನಾಗಲಿ</para>
  <para style="q2" vid="PRO 8:26">ನಿರ್ಮಿಸದೆ ಇರುವಾಗ ನಾನು ಹುಟ್ಟಿದೆನು.<verse eid="PRO 8:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27"/>ಆತನು ಸಾಗರದ ಮೇಲೆ ಚಕ್ರಾಕಾರವಾದ ಗೆರೆಯನ್ನು ಎಳೆದು,</para>
  <para style="q2" vid="PRO 8:27">ಆಕಾಶಮಂಡಲವನ್ನು ಸ್ಥಾಪಿಸುವಾಗ ಅಲ್ಲಿದ್ದೆನು.<verse eid="PRO 8:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28"/>ಆತನು ಗಗನವನ್ನು ಮೇಲೆ ಸ್ಥಿರಪಡಿಸಿ,</para>
  <para style="q2" vid="PRO 8:28">ಸಾಗರದ ಬುಗ್ಗೆಗಳನ್ನು ನೆಲೆಗೊಳಿಸಿದನು.<verse eid="PRO 8:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29"/>ಪ್ರವಾಹಗಳು ತನ್ನ ಅಪ್ಪಣೆಯನ್ನು ಮೀರದ ಹಾಗೆ</para>
  <para style="q2" vid="PRO 8:29">ಆತನು ಸಮುದ್ರಕ್ಕೆ ಮೇರೆಯನ್ನು ನೇಮಿಸಿ,</para>
  <para style="q2" vid="PRO 8:29">ಭೂಮಿಯ ಅಸ್ತಿವಾರಗಳನ್ನು ಗೊತ್ತುಮಾಡುವಾಗ,<verse eid="PRO 8:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30"/>ನಾನು ಆತನ ಹತ್ತಿರ <note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">ಅಥವಾ ಪ್ರಿಯ ಮಗನು.</char></note>ಶಿಲ್ಪಿಯಾಗಿದ್ದುಕೊಂಡು</para>
  <para style="q2" vid="PRO 8:30">ಪ್ರತಿದಿನವೂ ಆನಂದಿಸುತ್ತಾ,</para>
  <para style="q2" vid="PRO 8:30">ಯಾವಾಗಲೂ ಆತನ ಮುಂದೆ ವಿನೋದಿಸುತ್ತಾ,<verse eid="PRO 8:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31"/>ಆತನ ಭೂಲೋಕದಲ್ಲಿ ಉಲ್ಲಾಸಿಸುತ್ತಾ,</para>
  <para style="q2" vid="PRO 8:31">ಮಾನವಸಂತಾನದಲ್ಲಿ ಹರ್ಷಿಸುತ್ತಾ ಇದ್ದೆನು.<verse eid="PRO 8:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32"/>ಮಕ್ಕಳೇ, ಈಗ ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡಿರಿ,</para>
  <para style="q2" vid="PRO 8:32">ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಅನುಸರಿಸುವವರು ಧನ್ಯರೇ ಸರಿ.<verse eid="PRO 8:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33"/>ನನ್ನ ಉಪದೇಶವನ್ನು ಕೇಳಿರಿ,</para>
  <para style="q2" vid="PRO 8:33">ಅದನ್ನು ಬಿಡದೆ ಜ್ಞಾನವಂತರಾಗಿರಿ.<verse eid="PRO 8:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34"/>ನನ್ನ ದ್ವಾರಗಳ ಬಳಿಯಲ್ಲಿ ಪ್ರತಿದಿನವೂ ಕಾಯುತ್ತಾ</para>
  <para style="q2" vid="PRO 8:34">ಬಾಗಿಲಿನ ನಿಲವುಗಳ ಹತ್ತಿರವಿದ್ದು,</para>
  <para style="q2" vid="PRO 8:34">ಜಾಗರೂಕನಾಗಿ ನನ್ನ ಮಾತುಗಳನ್ನು ಕೇಳುವವನು ಭಾಗ್ಯವಂತನು.<verse eid="PRO 8:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35"/>ಯಾವನು ನನ್ನನ್ನು ಹೊಂದುತ್ತಾನೋ</para>
  <para style="q2" vid="PRO 8:35">ಅವನು ಜೀವವನ್ನು ಹೊಂದುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 8:35">ಅವನು ಯೆಹೋವನ ದಯೆಗೆ ಗುರಿಯಾಗುವನು.<verse eid="PRO 8:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36"/>ಯಾವನು ನನಗೆ ತಪ್ಪುಮಾಡುತ್ತಾನೋ</para>
  <para style="q2" vid="PRO 8:36">ಅವನು ತನ್ನ ಆತ್ಮಕ್ಕೆ ಕೇಡುಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q2" vid="PRO 8:36">ನನ್ನನ್ನು ಹಗೆಮಾಡುವವರೆಲ್ಲರೂ ಮರಣವನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s">ಜ್ಞಾನ ಮತ್ತು ಅಜ್ಞಾನಗಳ ಆಮಂತ್ರಣ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1"/>ಜ್ಞಾನವೆಂಬಾಕೆಯು ಏಳು ಕಂಬಗಳನ್ನು ಕಡಿದು,</para>
  <para style="q2" vid="PRO 9:1">ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿಕೊಂಡಿದ್ದಾಳೆ.<verse eid="PRO 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2"/>ಆಕೆ ಪಶುಗಳನ್ನು ಕೊಯಿಸಿ ಪಾನದ್ರವ್ಯಗಳೊಡನೆ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಬೆರಸಿ,</para>
  <para style="q2" vid="PRO 9:2">ಔತಣವನ್ನು ಸಿದ್ಧಪಡಿಸಿದ್ದಾಳೆ.<verse eid="PRO 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3"/>ಆಕೆಯು ತನ್ನ ದಾಸಿಯರನ್ನು ಕಳುಹಿಸಿ,</para>
  <para style="q2" vid="PRO 9:3">ಪಟ್ಟಣದ ರಾಜಮಾರ್ಗಗಳ ಮುಖ್ಯಸ್ಥಾನಗಳಲ್ಲಿ ಪ್ರಕಟಿಸುತ್ತಾಳೆ.<verse eid="PRO 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4"/>ಆಕೆಯು ಬುದ್ಧಿಹೀನರಿಗೆ,</para>
  <para style="q2" vid="PRO 9:4">“ಮೂಢನಾಗಿರುವವನು ಈ ಕಡೆಗೆ ತಿರುಗಲಿ,<verse eid="PRO 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5"/>ಬನ್ನಿರಿ, ನಾನು ಬಡಿಸುವ ಆಹಾರವನ್ನು ಉಣ್ಣಿರಿ,</para>
  <para style="q2" vid="PRO 9:5">ನಾನು ಬೆರೆಸಿರುವ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯಿರಿ.<verse eid="PRO 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6"/>ಮೂಢರೇ ಮೂಢತ್ವವನ್ನು ಬಿಟ್ಟು ಬಾಳಿರಿ,</para>
  <para style="q2" vid="PRO 9:6">ವಿವೇಕಮಾರ್ಗದಲ್ಲಿ ನೆಟ್ಟಗೆ ನಡೆಯಿರಿ” ಎಂದು ಪ್ರಬೋಧಿಸುತ್ತಾಳೆ.<verse eid="PRO 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7"/>ಧರ್ಮನಿಂದಕನನ್ನು ಶಿಕ್ಷಿಸುವವನು ತನ್ನನ್ನು ಅವಮಾನಕ್ಕೆ ಗುರಿಮಾಡಿಕೊಳ್ಳುವನು,</para>
  <para style="q2" vid="PRO 9:7">ಕೆಟ್ಟವನನ್ನು ಗದರಿಸುವವನಿಗೇ ಕಳಂಕವಾಗುವುದು.<verse eid="PRO 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8"/>ಧರ್ಮನಿಂದಕನನ್ನು ಗದರಿಸಬೇಡ,</para>
  <para style="q2" vid="PRO 9:8">ನಿನ್ನನ್ನು ಹಗೆಮಾಡುವನು.</para>
  <para style="q2" vid="PRO 9:8">ಜ್ಞಾನವಂತನನ್ನು ಗದರಿಸಿದರೆ ನಿನ್ನನ್ನು ಪ್ರೀತಿಸುವನು.<verse eid="PRO 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9"/>ಜ್ಞಾನಿಗೆ ಉಪದೇಶಿಸಿದರೆ ಹೆಚ್ಚು ಜ್ಞಾನವನ್ನು ಹೊಂದುವನು,</para>
  <para style="q2" vid="PRO 9:9">ನೀತಿವಂತನಿಗೆ ಬೋಧಿಸಿದರೆ ಹೆಚ್ಚು ತಿಳಿವಳಿಕೆಯನ್ನು ಪಡೆಯುವನು.<verse eid="PRO 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10"/>ಯೆಹೋವನ ಭಯವೇ ಜ್ಞಾನಕ್ಕೆ ಮೂಲವು,</para>
  <para style="q2" vid="PRO 9:10">ಪರಿಶುದ್ಧ ದೇವರ ತಿಳಿವಳಿಕೆಯೇ ವಿವೇಕವು.<verse eid="PRO 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11"/>ನನ್ನಿಂದ ನಿನ್ನ ದಿನಗಳು ಹೆಚ್ಚುವವು,</para>
  <para style="q2" vid="PRO 9:11">ನಿನ್ನ ಆಯುಷ್ಯದ ವರ್ಷಗಳು ವೃದ್ಧಿಯಾಗುವವು.<verse eid="PRO 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12"/>ನೀನು ಜ್ಞಾನವಂತನಾದರೆ ನಿನ್ನ ಜ್ಞಾನವು ನಿನಗೇ ಲಾಭಕರ,</para>
  <para style="q2" vid="PRO 9:12">ಧರ್ಮನಿಂದಕನಾದರೆ ನೀನೇ ಅದರ ಫಲವನ್ನು ಅನುಭವಿಸುವಿ.<verse eid="PRO 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13"/>ಅಜ್ಞಾನವೆಂಬವಳಾದರೋ ಕೂಗಾಟದವಳು,</para>
  <para style="q2" vid="PRO 9:13">ಮೂಢಳು, ಏನೂ ತಿಳಿಯದವಳು.<verse eid="PRO 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14"/>ಅವಳು ತನ್ನ ಮನೆಯ ಬಾಗಿಲಿನಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 9:14">ಪಟ್ಟಣದ ರಾಜಮಾರ್ಗಗಳಲ್ಲಿ ಪೀಠದ ಮೇಲೆ ಕುಳಿತುಕೊಂಡವಳಾಗಿ,<verse eid="PRO 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15"/>ತಮ್ಮ ಮಾರ್ಗವನ್ನು ಹಿಡಿದು,</para>
  <para style="q2" vid="PRO 9:15">ಹೋಗಿ ಬರುವವರನ್ನು ನೋಡಿ,<verse eid="PRO 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16"/>“ಮೂಢನಾಗಿರುವವನು ಈ ಕಡೆಗೆ ತಿರುಗಲಿ” ಎಂದು ಕೂಗಿ,<verse eid="PRO 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17"/>“ಕದ್ದ ನೀರು ಸಿಹಿಯಾಗಿದೆ, ಗುಟ್ಟಾಗಿ ತಿನ್ನುವ ತಿಂಡಿಯು ರುಚಿಯಾಗಿದೆ”</para>
  <para style="q2" vid="PRO 9:17">ಎಂದು ಬುದ್ಧಿಹೀನನಿಗೆ ಹೇಳುತ್ತಾಳೆ.<verse eid="PRO 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18"/>ಆ ಮನೆಯು ಪ್ರೇತ ನಿವಾಸವೆಂದೂ</para>
  <para style="q2" vid="PRO 9:18">ಅವಳ ಅತಿಥಿಗಳು ಅಗಾಧಪಾತಾಳದಲ್ಲಿ ಬಿದ್ದಿರುವರೆಂದೂ ಅವನಿಗೆ ತಿಳಿಯದು.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s">ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 10:1"/>ಜ್ಞಾನಿಯಾದ ಮಗನಿಂದ ತಂದೆಗೆ ಆನಂದ,</para>
  <para style="q2" vid="PRO 10:1">ಅಜ್ಞಾನಿಯಾದ ಮಗನಿಂದ ತಾಯಿಗೆ ದುಃಖ.<verse eid="PRO 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2"/>ಅನ್ಯಾಯದ ಸಂಪತ್ತು ವ್ಯರ್ಥ,</para>
  <para style="q2" vid="PRO 10:2">ಧರ್ಮವು ಮೃತ್ಯುವಿನಿಂದ ರಕ್ಷಿಸುವಂತದ್ದು.<verse eid="PRO 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3"/>ಯೆಹೋವನು ನೀತಿವಂತರನ್ನು ಹಸಿವೆಗೊಳಿಸನು,</para>
  <para style="q2" vid="PRO 10:3">ದುಷ್ಟನ ಆಶೆಯನ್ನು ಭಂಗಪಡಿಸುತ್ತಾನೆ.<verse eid="PRO 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4"/>ಜೋಲುಗೈ ದಾರಿದ್ರ್ಯ,</para>
  <para style="q2" vid="PRO 10:4">ಚುರುಕು ಕೈ ತರುವುದು ಐಶ್ವರ್ಯ.<verse eid="PRO 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5"/>ಸುಗ್ಗಿಯಲ್ಲಿ ಕೂಡಿಸುವವನು ಬುದ್ಧಿವಂತನು,</para>
  <para style="q2" vid="PRO 10:5">ಕೊಯ್ಲಿನಲ್ಲಿ ತೂಕಡಿಸುವವನು ನಾಚಿಕೆಗೆಟ್ಟವನು.<verse eid="PRO 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6"/>ಶಿಷ್ಟನ ತಲೆ ಆಶೀರ್ವಾದದ ನೆಲೆ,</para>
  <para style="q2" vid="PRO 10:6">ದುಷ್ಟನ ಬಾಯಿಗೆ ಬಲಾತ್ಕಾರವೇ ಮುಚ್ಚಳ.<verse eid="PRO 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7"/>ಶಿಷ್ಟರ ಸ್ಮರಣೆಯು ಆಶೀರ್ವಾದಕ್ಕಾಸ್ಪದ,</para>
  <para style="q2" vid="PRO 10:7">ದುಷ್ಟರ ನಾಮವು ನಿರ್ನಾಮಕಾಸ್ಪದ.<verse eid="PRO 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8"/>ಜ್ಞಾನಹೃದಯನು ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸುವನು,</para>
  <para style="q2" vid="PRO 10:8">ಹರಟೆಯ ಮೂರ್ಖನು ಕೆಡವಲ್ಪಡುವನು.<verse eid="PRO 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9"/>ನಿರ್ದೋಷದ ನಡತೆಯವನು ನಿರ್ಭಯವಾಗಿ ನಡೆಯುವನು,</para>
  <para style="q2" vid="PRO 10:9">ವಕ್ರಮಾರ್ಗಿಯು ಬೈಲಿಗೆ ಬೀಳುವನು.<verse eid="PRO 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10"/>ಕಣ್ಣು ಮಿಟಕಿಸುವವನು ಕಷ್ಟಕ್ಕೆ ಕಾರಣನು,</para>
  <para style="q2" vid="PRO 10:10">
    <note caller="+" style="f">
      <char style="fr" closed="false">10:10 </char>
      <char style="ft" closed="false">ಅಥವಾ ಹರಟೆಯ ಮೂರ್ಖನು ಕೆಡವಲ್ಪಡುವನು. </char>
    </note>ಧೈರ್ಯದಿಂದ ಗದರಿಸುವವನು ಸಮಾಧಾನಕರನು.<verse eid="PRO 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11"/>ಶಿಷ್ಟನ ಬಾಯಿ ಜೀವದ ಬುಗ್ಗೆ,</para>
  <para style="q2" vid="PRO 10:11">ದುಷ್ಟನ ಬಾಯಲ್ಲಿ ಬಲಾತ್ಕಾರವು ತುಂಬಿ ತುಳುಕುತ್ತದೆ.<verse eid="PRO 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12"/>ದ್ವೇಷವು ಜಗಳಗಳನ್ನೆಬ್ಬಿಸುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 10:12">ಪ್ರೀತಿಯು ಪಾಪಗಳನ್ನೆಲ್ಲಾ ಮುಚ್ಚುತ್ತದೆ.<verse eid="PRO 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13"/>ವಿವೇಕಿಯ ತುಟಿಗಳಿಂದ ಜ್ಞಾನ,</para>
  <para style="q2" vid="PRO 10:13">ಬುದ್ಧಿಹೀನನ ಬೆನ್ನಿಗೆ ಬೆತ್ತ.<verse eid="PRO 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14"/>ಜ್ಞಾನಿಗಳು ತಿಳಿದ ಸಂಗತಿಯನ್ನು ಹೊರಪಡಿಸುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 10:14">ಮೂರ್ಖನ ಭಾಷಣ ನಾಶನಕ್ಕೆ ಸಮೀಪ.<verse eid="PRO 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15"/>ಐಶ್ವರ್ಯವಂತನಿಗೆ ಐಶ್ವರ್ಯವು ಬಲವಾದ ಕೋಟೆ,</para>
  <para style="q2" vid="PRO 10:15">ಬಡವನಿಗೆ ಅವನ ಬಡತನವೇ ನಾಶನ.<verse eid="PRO 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16"/>ಶಿಷ್ಟನ ದುಡಿತ ಜೀವಾಸ್ಪದ,</para>
  <para style="q2" vid="PRO 10:16">ದುಷ್ಟನ ಆದಾಯ ಪಾಪಾಸ್ಪದ.<verse eid="PRO 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17"/>ಶಿಕ್ಷೆಯನ್ನು ಕೈಕೊಳ್ಳುವವನು ಜೀವದ ಮಾರ್ಗವನ್ನು ತೋರಿಸುವನು,</para>
  <para style="q2" vid="PRO 10:17">ಗದರಿಕೆಯನ್ನು ಕೈಕೊಳ್ಳದವನು ಸನ್ಮಾರ್ಗದಿಂದ ತಪ್ಪಿಸುವನು.<verse eid="PRO 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18"/>ಹೊಟ್ಟೆಯಲ್ಲಿ ಹಗೆಯನ್ನಿಟ್ಟುಕೊಂಡವನು ಸುಳ್ಳುಗಾರ,</para>
  <para style="q2" vid="PRO 10:18">ಚಾಡಿಗಾರನು ಜ್ಞಾನಹೀನ.<verse eid="PRO 10:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19"/>ಮಾತಾಳಿಗೆ ಪಾಪ ತಪ್ಪದು,</para>
  <para style="q2" vid="PRO 10:19">ಮೌನಿಯು ವಿವೇಕಿ.<verse eid="PRO 10:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20"/>ಶಿಷ್ಟರ ನಾಲಿಗೆ ಚೊಕ್ಕ ಬೆಳ್ಳಿ,</para>
  <para style="q2" vid="PRO 10:20">ದುಷ್ಟನ ಹೃದಯ ಮೌಲ್ಯವಿಲ್ಲದ್ದು.<verse eid="PRO 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21"/>ಶಿಷ್ಟರ ಭಾಷಣ ಬಹುಜನ ಪೋಷಣ,</para>
  <para style="q2" vid="PRO 10:21">ಬುದ್ಧಿಯ ಕೊರತೆ ಮೂರ್ಖರ ನಾಶನ.<verse eid="PRO 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22"/>ಯೆಹೋವನ ಆಶೀರ್ವಾದವು ಭಾಗ್ಯದಾಯಕವು,</para>
  <para style="q2" vid="PRO 10:22">ಅದು ವ್ಯಸನವನ್ನು ಸೇರಿಸದು.<verse eid="PRO 10:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23"/>ಅವಿವೇಕಿಗೆ ಕುಯುಕ್ತಿ ವಿನೋದ</para>
  <para style="q2" vid="PRO 10:23">ವಿವೇಕಿಗೆ ಜ್ಞಾನ ವಿನೋದ.<verse eid="PRO 10:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24"/>ದುಷ್ಟನಿಗೆ ಶಂಕಿಸಿದ್ದೇ ಸಂಭವಿಸುವುದು,</para>
  <para style="q2" vid="PRO 10:24">ಶಿಷ್ಟನಿಗೆ ಇಷ್ಟವು ಲಭಿಸುವುದು.<verse eid="PRO 10:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25"/>ಬಿರುಗಾಳಿ ಬೀಸಿದರೆ ದುಷ್ಟನು ಎಲ್ಲೋ!</para>
  <para style="q2" vid="PRO 10:25">ಶಿಷ್ಟನು ಶಾಶ್ವತವಾದ ಕಟ್ಟಡ.<verse eid="PRO 10:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26"/>ಹಲ್ಲುಗಳಿಗೆ ಹುಳಿಯೂ, ಕಣ್ಣುಗಳಿಗೆ ಹೊಗೆಯೂ ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 10:26">ಯಜಮಾನನಿಗೆ ಸೋಮಾರಿಯು ಹಾಗೆ.<verse eid="PRO 10:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27"/>ಯೆಹೋವನಿಗೆ ಭಯಪಡುವವರ ದಿನಗಳಿಗೆ ವೃದ್ಧಿ,</para>
  <para style="q2" vid="PRO 10:27">ದುಷ್ಟರ ವರ್ಷಗಳು ಅಲ್ಪ.<verse eid="PRO 10:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28"/>ಶಿಷ್ಟನ ನಂಬಿಕೆಗೆ ಆನಂದವು ಫಲ,</para>
  <para style="q2" vid="PRO 10:28">ದುಷ್ಟನ ನಿರೀಕ್ಷೆ ನಿಷ್ಫಲ.<verse eid="PRO 10:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29"/>ಯೆಹೋವನು ಸನ್ಮಾರ್ಗಿಗೆ ಆಶ್ರಯ,</para>
  <para style="q2" vid="PRO 10:29">ಕೆಡುಕನಿಗೆ ನಾಶನ.<verse eid="PRO 10:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30"/>ಶಿಷ್ಟರು ಎಂದಿಗೂ ಕದಲರು,</para>
  <para style="q2" vid="PRO 10:30">ದುಷ್ಟರು ದೇಶದಲ್ಲಿ ನಿಲ್ಲರು.<verse eid="PRO 10:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31"/>ಶಿಷ್ಟನ ಬಾಯಲ್ಲಿ ಜ್ಞಾನವು ಮೊಳೆಯುವುದು,</para>
  <para style="q2" vid="PRO 10:31">ನೀಚನ ನಾಲಿಗೆ ಕತ್ತರಿಸಲ್ಪಡುವುದು.<verse eid="PRO 10:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32"/>ಶಿಷ್ಟನ ತುಟಿಯಲ್ಲಿ ಹಿತವಚನ,</para>
  <para style="q2" vid="PRO 10:32">ದುಷ್ಟನ ಬಾಯಲ್ಲಿ ನೀಚವಚನ.<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="s">ದೋಷಿ ಮತ್ತು ನಿರ್ದೋಷಿ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1"/>ಮೋಸದ ತಕ್ಕಡಿ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 11:1">ನ್ಯಾಯದ ತೂಕ ಆತನಿಗೆ ಸಂತೋಷ.<verse eid="PRO 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2"/>ಎಲ್ಲಿ ಹೆಮ್ಮೆಯೋ ಅಲ್ಲಿ ನಾಚಿಕೆ,</para>
  <para style="q2" vid="PRO 11:2">ದೀನತೆಯಲ್ಲಿ ಸುಜ್ಞಾನ.<verse eid="PRO 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3"/>ಯಥಾರ್ಥವಂತರಿಗೆ ಸರಳತೆಯು ಮಾರ್ಗದರ್ಶಕ,</para>
  <para style="q2" vid="PRO 11:3">ವಂಚಕರಿಗೆ ವಕ್ರತೆಯು ನಾಶನ.<verse eid="PRO 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4"/>ಧನವು ಕೋಪದ ದಿನದಲ್ಲಿ ವ್ಯರ್ಥ,</para>
  <para style="q2" vid="PRO 11:4">ಧರ್ಮವು ಮರಣವಿಮೋಚಕ.<verse eid="PRO 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5"/>ನಿರ್ದೋಷಿಯ ಧರ್ಮವು ಅವನ ಮಾರ್ಗವನ್ನು ಸರಾಗಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 11:5">ದುಷ್ಟನು ತನ್ನ ದೋಷದಿಂದಲೇ ಬಿದ್ದುಹೋಗುವನು.<verse eid="PRO 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6"/>ಧರ್ಮವು ಯಥಾರ್ಥವಂತರನ್ನು ಉದ್ಧರಿಸುವುದು,</para>
  <para style="q2" vid="PRO 11:6">ವಂಚಕರು ತಮ್ಮ ಆಶಾಪಾಶಕ್ಕೆ ಸಿಕ್ಕಿಬೀಳುವರು.<verse eid="PRO 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7"/>ದುಷ್ಟನು ಸಾಯುವಾಗ ಅವನ ನಿರೀಕ್ಷೆಯು ಹಾಳಾಗುವುದು,</para>
  <para style="q2" vid="PRO 11:7">ಬಲದ ಮೇಲಣ ನಂಬಿಕೆಯು ಬಿದ್ದುಹೋಗುವುದು.<verse eid="PRO 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8"/>ಶಿಷ್ಟನು ಇಕ್ಕಟ್ಟಿನಿಂದ ಪಾರಾಗುವನು,</para>
  <para style="q2" vid="PRO 11:8">ದುಷ್ಟನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅದರಲ್ಲಿ ಬೀಳುವನು.<verse eid="PRO 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9"/>ಧರ್ಮಭ್ರಷ್ಟನು ಬಾಯಿಂದ ನೆರೆಯವನನ್ನು ಹಾಳು ಮಾಡುವನು,</para>
  <para style="q2" vid="PRO 11:9">ಶಿಷ್ಟನು ತಿಳಿವಳಿಕೆಯಿಂದ ಉದ್ಧಾರವಾಗುವನು.<verse eid="PRO 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10"/>ಸಜ್ಜನರು ಸುಖಿಗಳಾದರೆ ಪಟ್ಟಣಕ್ಕೆ ಉಲ್ಲಾಸ,</para>
  <para style="q2" vid="PRO 11:10">ದುರ್ಜನರು ಹಾಳಾದರೆ ಜಯಘೋಷ.<verse eid="PRO 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11"/>ಯಥಾರ್ಥವಂತರ ಆಶೀರ್ವಾದದಿಂದ ಪಟ್ಟಣವು ಉನ್ನತಿಗೆ ಬರುವುದು,</para>
  <para style="q2" vid="PRO 11:11">ಕೆಟ್ಟವರ ಬಾಯಿಂದ ಕೆಡವಲ್ಪಡುವುದು.<verse eid="PRO 11:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12"/>ನೆರೆಯವನನ್ನು ಹೀನೈಸುವವನು ಬುದ್ಧಿಹೀನನು,</para>
  <para style="q2" vid="PRO 11:12">ವಿವೇಕಿಯು ಮೌನವಾಗಿರುವನು.<verse eid="PRO 11:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13"/>ಚಾಡಿಕೋರನು ಗುಟ್ಟನ್ನು ರಟ್ಟು ಮಾಡುವನು,</para>
  <para style="q2" vid="PRO 11:13">ನಂಬಿಗಸ್ತನು ಸಂಗತಿಗಳನ್ನು ಗುಪ್ತವಾಗಿಡುವನು.<verse eid="PRO 11:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14"/>ಉಚಿತಾಲೋಚನೆಯಿಲ್ಲದ ಕಡೆ ಪ್ರಜೆಯು ಬಿದ್ದು ಹೋಗುವುದು,</para>
  <para style="q2" vid="PRO 11:14">ಬಹು ಮಂದಿ ಸಮಾಲೋಚಕರು ಇರುವಲ್ಲಿ <note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="ft" closed="false">ಅಥವಾ ಜಯ.</char></note>ಸಂರಕ್ಷಣೆ ಇರುವುದು.<verse eid="PRO 11:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15"/>ಅನ್ಯನ ಸಾಲಕ್ಕೆ ಹೊಣೆಯಾದರೆ ಹಾನಿ,</para>
  <para style="q2" vid="PRO 11:15">ಅಪರಿಚಿತನ ಹೊಣೆಗೆ ದೂರವಾದರೆ ನಿರ್ಭಯ.<verse eid="PRO 11:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16"/>ದಯಾಳುವಾದ ಹೆಂಗಸು ಗೌರವವನ್ನು ಪಡೆಯುವಳು,</para>
  <para style="q2" vid="PRO 11:16">ಬಲಾತ್ಕಾರಿಗಳು ಧನವನ್ನು ಮಾತ್ರ ಕೂಡಿಸಿಕೊಳ್ಳುವರು.<verse eid="PRO 11:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17"/>ದಯಾಪರನಿಗೆ ಉಪಕಾರವಾಗುವುದು,</para>
  <para style="q2" vid="PRO 11:17">ಕ್ರೂರನು ತನ್ನ ಶರೀರವನ್ನು ಹಿಂಸಿಸುವನು.<verse eid="PRO 11:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18"/>ಅಧರ್ಮಿಯ ಸಂಬಳವು ಮೋಸ,</para>
  <para style="q2" vid="PRO 11:18">ನೀತಿಯನ್ನು ಬಿತ್ತುವವನು ಲಾಭವನ್ನು ಪಡೆಯುವನು.<verse eid="PRO 11:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19"/>ಧರ್ಮನಿರತನಿಗೆ ಜೀವ,</para>
  <para style="q2" vid="PRO 11:19">ಅಧರ್ಮಾಸಕ್ತನಿಗೆ ಮರಣ.<verse eid="PRO 11:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20"/>ವಕ್ರಹೃದಯರು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯರು,</para>
  <para style="q2" vid="PRO 11:20">ಸನ್ಮಾರ್ಗಿಗಳು ಆತನ ದಯೆಗೆ ಪಾತ್ರರು.<verse eid="PRO 11:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21"/>ದುಷ್ಟನಿಗೆ ದಂಡನೆ ಖಂಡಿತ,</para>
  <para style="q2" vid="PRO 11:21">ಶಿಷ್ಟವಂಶಕ್ಕೆ ರಕ್ಷಣೆ.<verse eid="PRO 11:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22"/>ಹಂದಿಯ ಮೂಗಿಗೆ ಚಿನ್ನದ ಮೂಗುತಿಯು ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 11:22">ಅವಿವೇಕಳಿಗೆ ಸೌಂದರ್ಯವು ಹಾಗೆ.<verse eid="PRO 11:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23"/>ಸಜ್ಜನರ ಆಶೆಯು ಮಂಗಳಾಸ್ಪದ,</para>
  <para style="q2" vid="PRO 11:23">ದುರ್ಜನರ ನಿರೀಕ್ಷೆಯು ರೋಷಾಸ್ಪದ.<verse eid="PRO 11:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24"/>ಒಬ್ಬನು ತನ್ನ ಧನವನ್ನು ಚೆಲ್ಲಿದರೂ ಅವನಿಗೆ ವೃದ್ಧಿ,</para>
  <para style="q2" vid="PRO 11:24">ಮತ್ತೊಬ್ಬನು ನ್ಯಾಯವಾದದ್ದನ್ನು ಬಿಗಿಹಿಡಿದರೂ ಅವನಿಗೆ ಬಡತನ.<verse eid="PRO 11:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25"/>ಉದಾರಿಯು ಪುಷ್ಟನಾಗುವನು,</para>
  <para style="q2" vid="PRO 11:25">ನೀರು ಹಾಯಿಸುವವನಿಗೆ ನೀರು ಸಿಕ್ಕುವುದು.<verse eid="PRO 11:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26"/>ಧಾನ್ಯವನ್ನು ಬಿಗಿಹಿಡಿಯುವವನ ಮೇಲೆ ಜನರ ಶಾಪ,</para>
  <para style="q2" vid="PRO 11:26">ಮಾರುವವನ ತಲೆಯ ಮೇಲೆ ಆಶೀರ್ವಾದ.<verse eid="PRO 11:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27"/>ಧರ್ಮಕ್ಕೆ ಆತುರಪಡುವವನಿಗೆ ದಯೆ,</para>
  <para style="q2" vid="PRO 11:27">ಕೇಡನ್ನು ಹುಡುಕುವವನಿಗೆ ಕೇಡೇ.<verse eid="PRO 11:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28"/>ಧನವನ್ನೇ ನಂಬಿದವನು ಬಿದ್ದುಹೋಗುವನು,</para>
  <para style="q2" vid="PRO 11:28">ಸದ್ಧರ್ಮಿಯು ಕುಡಿಯ ಹಾಗೆ ಚಿಗುರುವನು.<verse eid="PRO 11:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29"/>ತನ್ನ ಕುಟುಂಬವನ್ನು ಬಾಧಿಸುವವನಿಗೆ ಗಾಳಿಯೇ ಗಂಟು,</para>
  <para style="q2" vid="PRO 11:29">ಮೂರ್ಖನು ಜ್ಞಾನವಂತನ ಅಧೀನದಲ್ಲಿ ಬಿದ್ದಿರುವನು;<verse eid="PRO 11:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30"/>ಧರ್ಮಾತ್ಮನ ಫಲ ಜೀವವೃಕ್ಷ,</para>
  <para style="q2" vid="PRO 11:30">ಜ್ಞಾನಿಯು ಆತ್ಮಗಳನ್ನು ಆಕರ್ಷಿಸುವನು.<verse eid="PRO 11:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31"/>ಶಿಷ್ಟನು ಭೂಮಿಯಲ್ಲಿ ತನ್ನ ಕ್ರಿಯಾಫಲವನ್ನು ಅನುಭವಿಸುವಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 11:31">ದುಷ್ಟನೂ, ಪಾಪಿಯೂ ದಂಡನೆಯನ್ನು ಅನುಭವಿಸುವರು ಎಂದು ಹೇಳಬೇಕಾಗಿಲ್ಲ.<verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1"/>ತಿಳಿವಳಿಕೆಯನ್ನು ಪ್ರೀತಿಸುವವನು ಶಿಕ್ಷಣವನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 12:1">ಮೂರ್ಖನು ಗದರಿಕೆಯನ್ನು ದ್ವೇಷಿಸುತ್ತಾನೆ.<verse eid="PRO 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2"/>ಯೆಹೋವನು ಒಳ್ಳೆಯವನಿಗೆ ದಯೆತೋರಿಸುವನು,</para>
  <para style="q2" vid="PRO 12:2">ಕುಯುಕ್ತಿಯುಳ್ಳವನನ್ನು ಕೆಟ್ಟವನೆಂದು ನಿರ್ಣಯಿಸುವನು.<verse eid="PRO 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3"/>ಯಾರೂ ದುಷ್ಟತನದಿಂದ ಸ್ಥಿರನಾಗನು,</para>
  <para style="q2" vid="PRO 12:3">ಶಿಷ್ಟನು ಯಾವಾಗಲೂ ದೃಢಮೂಲನೇ.<verse eid="PRO 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4"/>ಗುಣವತಿಯಾದ ಸ್ತ್ರೀಯು ಪತಿಯ ತಲೆಗೆ ಕಿರೀಟ,</para>
  <para style="q2" vid="PRO 12:4">ಮಾನ ಕಳೆಯುವವಳು ಪತಿಯ ಎಲುಬಿಗೆ ಕ್ಷಯ.<verse eid="PRO 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5"/>ಶಿಷ್ಟರ ಉದ್ದೇಶ ನ್ಯಾಯ,</para>
  <para style="q2" vid="PRO 12:5">ದುಷ್ಟರ ಆಲೋಚನೆ ಮೋಸ.<verse eid="PRO 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6"/>ಕೆಟ್ಟವರ ಮಾತು ರಕ್ತಕ್ಕೆ ಹೊಂಚು,</para>
  <para style="q2" vid="PRO 12:6">ಯಥಾರ್ಥವಂತರ ನುಡಿ ಪ್ರಾಣರಕ್ಷಣೆ.<verse eid="PRO 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7"/>ದುರ್ಜನರು ಕೆಡವಲ್ಪಟ್ಟು ನಿರ್ಮೂಲರಾಗುವರು,</para>
  <para style="q2" vid="PRO 12:7">ಸಜ್ಜನರ ಮನೆಯು ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲುವುದು.<verse eid="PRO 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8"/>ಬುದ್ಧಿವಂತನನ್ನು ಅವನ ಬುದ್ಧಿಗೆ ತಕ್ಕಂತೆ ಹೊಗಳುವರು,</para>
  <para style="q2" vid="PRO 12:8">ವಕ್ರಬುದ್ಧಿಯುಳ್ಳವನನ್ನು ತಿರಸ್ಕರಿಸುವರು.<verse eid="PRO 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9"/>ಹೊಟ್ಟೆಗಿಲ್ಲದ ಡಾಂಭಿಕನಿಗಿಂತಲೂ</para>
  <para style="q2" vid="PRO 12:9">ಸೇವಕನುಳ್ಳ ಸಾಧಾರಣ ಮನುಷ್ಯನ ಸ್ಥಿತಿಯೇ ಲೇಸು.<verse eid="PRO 12:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10"/>ಶಿಷ್ಟನು ತನ್ನ ಪಶುಗಳ ಕ್ಷೇಮವನ್ನು ಲಕ್ಷಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 12:10">ದುಷ್ಟನ ವಾತ್ಸಲ್ಯವೋ ಕ್ರೂರತನವೇ.<verse eid="PRO 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11"/>ದುಡಿದು ಹೊಲಗೇಯುವವನು ಹೊಟ್ಟೆತುಂಬಾ ಉಣ್ಣುವನು,</para>
  <para style="q2" vid="PRO 12:11">ವ್ಯರ್ಥಕಾರ್ಯಾಸಕ್ತನು ಬುದ್ಧಿಹೀನನೇ.<verse eid="PRO 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12"/>ಕೆಡುಕರ ಕೊಳ್ಳೆಯು ದುಷ್ಟರಿಗೆ ಇಷ್ಟ,</para>
  <para style="q2" vid="PRO 12:12">ಆದರೆ ಶಿಷ್ಟರ ಬುಡ ಫಲದಾಯಕ.<verse eid="PRO 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13"/>ದುಷ್ಟನು ತನ್ನ ತುಟಿಗಳ ದೋಷದಿಂದ ಬೋನಿಗೆ ಬೀಳುವನು,</para>
  <para style="q2" vid="PRO 12:13">ಶಿಷ್ಟನು ಇಕ್ಕಟ್ಟಿನಿಂದ ಪಾರಾಗುವನು.<verse eid="PRO 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14"/>ಬಾಯಿಯ ಫಲವಾಗಿ ಮನುಷ್ಯನು ಬೇಕಾದಷ್ಟು ಸುಖವನ್ನು ಅನುಭವಿಸುವನು,</para>
  <para style="q2" vid="PRO 12:14">ಅವನ ಕೈಕೆಲಸದ ಫಲವು ಅವನಿಗೆ ಪ್ರಾಪ್ತವಾಗುವುದು.<verse eid="PRO 12:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15"/>ಮೂರ್ಖನ ನಡತೆ ಅವನ ದೃಷ್ಟಿಗೆ ಸರಿ,</para>
  <para style="q2" vid="PRO 12:15">ಜ್ಞಾನಿಯು ಉಚಿತಾಲೋಚನೆಯನ್ನು ಗಮನಿಸುವನು.<verse eid="PRO 12:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16"/>ಮೂರ್ಖನ ಸಿಟ್ಟು ತಟ್ಟನೆ ರಟ್ಟಾಗುವುದು,</para>
  <para style="q2" vid="PRO 12:16">ಜಾಣನು ಅವಮಾನವನ್ನು ಮರೆಮಾಡುವನು.<verse eid="PRO 12:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17"/>ಸತ್ಯವನ್ನಾಡುವವನು ನ್ಯಾಯವನ್ನು ತೋರ್ಪಡಿಸುವನು,</para>
  <para style="q2" vid="PRO 12:17">ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಅಸತ್ಯವನ್ನು ನುಡಿಯುವನು.<verse eid="PRO 12:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18"/>ಕತ್ತಿ ತಿವಿದ ಹಾಗೆ ದುಡುಕಿ ಮಾತನಾಡುವವರುಂಟು,</para>
  <para style="q2" vid="PRO 12:18">ಜ್ಞಾನವಂತರ ಮಾತು ಸ್ವಸ್ಥತೆಯನ್ನು ತರುವುದು.<verse eid="PRO 12:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19"/>ಸತ್ಯದ ತುಟಿ ಶಾಶ್ವತ,</para>
  <para style="q2" vid="PRO 12:19">ಸುಳ್ಳಿನ ನಾಲಿಗೆ ಕ್ಷಣಿಕ.<verse eid="PRO 12:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20"/>ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವರ ಹೃದಯದಲ್ಲಿ ಮೋಸ,</para>
  <para style="q2" vid="PRO 12:20">ಹಿತೋಪದೇಶಕರ ಮನಸ್ಸಿನಲ್ಲಿ ಉಲ್ಲಾಸ.<verse eid="PRO 12:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21"/>ಸಜ್ಜನರಿಗೆ ಯಾವ ಹಾನಿಯೂ ಸಂಭವಿಸದು,</para>
  <para style="q2" vid="PRO 12:21">ದುರ್ಜನರಿಗೆ ಕೇಡು ತುಂಬಿ ತುಳುಕುವುದು.<verse eid="PRO 12:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22"/>ಸುಳ್ಳುತುಟಿ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯವಾಗಿವೆ.</para>
  <para style="q2" vid="PRO 12:22">ಸತ್ಯವಂತರು ಆತನಿಗೆ ಆನಂದ ತರುತ್ತಾರೆ.<verse eid="PRO 12:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23"/>ಜಾಣನು ತನ್ನ ಜ್ಞಾನವನ್ನು ಗುಪ್ತಪಡಿಸುವನು,</para>
  <para style="q2" vid="PRO 12:23">ಮೂಢರ ಮನಸ್ಸು ಮೂರ್ಖತನವನ್ನು ಪ್ರಕಟಿಸುವುದು.<verse eid="PRO 12:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24"/>ಚುರುಕುಗೈಯವನಿಗೆ ರಾಜ್ಯಾಧಿಕಾರ,</para>
  <para style="q2" vid="PRO 12:24">ಮೈಗಳ್ಳನಿಗೆ ದಾಸತ್ವದ ಬದುಕು.<verse eid="PRO 12:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25"/>ಕಳವಳವು ಮನಸ್ಸನ್ನು ಕುಗ್ಗಿಸುವುದು,</para>
  <para style="q2" vid="PRO 12:25">ಕನಿಕರದ ಮಾತು ಅದನ್ನು ಹಿಗ್ಗಿಸುವುದು.<verse eid="PRO 12:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26"/>ಸನ್ಮಾರ್ಗಿಯು ನೆರೆಯವನಿಗೆ ಮಾರ್ಗತೋರಿಸುವನು,</para>
  <para style="q2" vid="PRO 12:26">ದುರ್ಮಾರ್ಗಿಯು ಮಾರ್ಗತಪ್ಪಿಸುವನು.<verse eid="PRO 12:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27"/>ಮೈಗಳ್ಳನು ಹಿಡಿದ ಬೇಟೆಯನ್ನೂ ಅನುಭವಿಸಲಾರನು,</para>
  <para style="q2" vid="PRO 12:27">ಸನ್ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುವವನಿಗೆ ಅಮೂಲ್ಯ ಸಂಪತ್ತು ದೊರಕುವುದು.<verse eid="PRO 12:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28"/>ಧರ್ಮಮಾರ್ಗದಿಂದ ಜೀವಲಾಭವು,</para>
  <para style="q2" vid="PRO 12:28">ಆ ಮಾರ್ಗದಲ್ಲಿ ಮರಣವಿಲ್ಲ.<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1"/>ಜ್ಞಾನಿಯಾದ ಮಗನು ತಂದೆಯ ನೀತಿ ಶಿಕ್ಷಣವನ್ನು ಕೇಳುವನು,</para>
  <para style="q2" vid="PRO 13:1">ಧರ್ಮನಿಂದಕನೋ ಗದರಿಕೆಯನ್ನು ಕೇಳನು.<verse eid="PRO 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2"/>ಬಾಯಿಯ ಫಲವಾಗಿ ಮನುಷ್ಯನು ಸುಖವನ್ನು ಅನುಭವಿಸುವನು,</para>
  <para style="q2" vid="PRO 13:2">ಬಲಾತ್ಕಾರವೇ ದ್ರೋಹಿಗಳ ಕೋರಿಕೆ.<verse eid="PRO 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3"/>ಬಾಯನ್ನು ಕಾಯುವವನು ಜೀವವನ್ನು ಕಾಯುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 13:3">ತುಟಿಗಳನ್ನು ತೆರೆದುಬಿಡುವವನು ನಾಶವಾಗುವನು.<verse eid="PRO 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4"/>ಸೋಮಾರಿಯ ಆಶೆಯು ವ್ಯರ್ಥ,</para>
  <para style="q2" vid="PRO 13:4">ಉದ್ಯೋಗಿಯ ಆತ್ಮಕ್ಕೆ ಪುಷ್ಟಿ.<verse eid="PRO 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5"/>ಶಿಷ್ಟನು ಮೋಸಕ್ಕೆ ಅಸಹ್ಯಪಟ್ಟು ಅದನ್ನು ಮಾಡಲಾರನು,</para>
  <para style="q2" vid="PRO 13:5">ದುಷ್ಟನ ನಡತೆಯು ಹೇಸಿಕೆಗೂ, ನಾಚಿಕೆಗೂ ಆಸ್ಪದ.<verse eid="PRO 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6"/>ಧರ್ಮವು ನಿರ್ದೋಷಿಯನ್ನು ಕಾಯುವುದು,</para>
  <para style="q2" vid="PRO 13:6">ಅಧರ್ಮವು ದೋಷಿಯನ್ನು ಕೆಡವಿಬಿಡುವುದು.<verse eid="PRO 13:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7"/>ಒಬ್ಬನು ಧನವನ್ನು ಸಂಗ್ರಹಿಸಿದರೂ, ಏನೂ ಇಲ್ಲದ ದರಿದ್ರನ ಹಾಗೆ ವರ್ತಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 13:7">ಮತ್ತೊಬ್ಬನು ಧನವನ್ನೆಲ್ಲಾ ವೆಚ್ಚಮಾಡಿ ಬಡವನಾದರೂ, ಬಹು ಐಶ್ವರ್ಯವಂತನ ಹಾಗೆ ವರ್ತಿಸುತ್ತಾನೆ.<verse eid="PRO 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8"/>ಧನವಂತನ ಪ್ರಾಣರಕ್ಷಣೆಗೆ ಅವನ ಧನವೇ ಕ್ರಯ,</para>
  <para style="q2" vid="PRO 13:8">ಬಡವನಿಗೆ ಯಾವ ಬೆದರಿಕೆಯೂ ಇಲ್ಲ.<verse eid="PRO 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9"/>ಶಿಷ್ಟರ ಬೆಳಕು ಬೆಳಗುವುದು,</para>
  <para style="q2" vid="PRO 13:9">ದುಷ್ಟರ ದೀಪವು ಆರುವುದು.<verse eid="PRO 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10"/>ಹೆಮ್ಮೆಯ ಫಲವು ಕಲಹವೇ,</para>
  <para style="q2" vid="PRO 13:10">ಬುದ್ಧಿವಾದಕ್ಕೆ ಕಿವಿಗೊಡುವವರಲ್ಲಿ ಜ್ಞಾನ.<verse eid="PRO 13:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11"/>ಸುಮ್ಮನೆ ಸಿಕ್ಕಿದ ಸಂಪತ್ತು ಕ್ಷಯಿಸುವುದು,</para>
  <para style="q2" vid="PRO 13:11">ದುಡಿದು ಕೂಡಿಸಿಕೊಂಡವನಿಗೆ ಅಭಿವೃದ್ಧಿಯಾಗುವುದು.<verse eid="PRO 13:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12"/>ಕೋರಿದ್ದಕ್ಕೆ ತಡವಾದರೆ ಮನಸ್ಸು ಬಳಲುವುದು,</para>
  <para style="q2" vid="PRO 13:12">ಕೈಗೂಡಿದ ಇಷ್ಟಾರ್ಥವು ಜೀವವೃಕ್ಷವು.<verse eid="PRO 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13"/>ದೇವರ ವಾಕ್ಯವನ್ನು ಉಲ್ಲಂಘಿಸುವವನು ನಾಶವಾಗುವನು,</para>
  <para style="q2" vid="PRO 13:13">ಆಜ್ಞೆಯನ್ನು ಭಯಭಕ್ತಿಯಿಂದ ಕೈಕೊಳ್ಳುವವನು ಸಫಲವನ್ನು ಹೊಂದುವನು.<verse eid="PRO 13:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14"/>ಜ್ಞಾನಿಯ ಬೋಧನೆ ಜೀವದ ಬುಗ್ಗೆ,</para>
  <para style="q2" vid="PRO 13:14">ಅದನ್ನಾಲಿಸುವವನು ಮೃತ್ಯುಪಾಶದಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15"/>ಸುಬುದ್ಧಿಯು ದಯಾಸ್ಪದವು,</para>
  <para style="q2" vid="PRO 13:15">ದ್ರೋಹಿಯ ಮಾರ್ಗವು ನಾಶಕರ.<verse eid="PRO 13:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16"/>ಪ್ರತಿಯೊಬ್ಬ ಜಾಣನು ತನ್ನ ಕೆಲಸವನ್ನು ತಿಳಿವಳಿಕೆಯಿಂದ ನಡೆಸುವನು,</para>
  <para style="q2" vid="PRO 13:16">ಮೂಢನು ತನ್ನ ಮೂರ್ಖತನವನ್ನು ತೋರ್ಪಡಿಸುವನು.<verse eid="PRO 13:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17"/>ಕೆಟ್ಟ ದೂತನು ಕೇಡಿಗೆ ಬೀಳುವನು,</para>
  <para style="q2" vid="PRO 13:17">ನಂಬಿಗಸ್ತನಾದ ರಾಯಭಾರಿಯು ಕ್ಷೇಮದಾಯಕನು.<verse eid="PRO 13:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18"/>ಶಿಕ್ಷೆಯನ್ನು ತ್ಯಜಿಸುವವನಿಗೆ ಬಡತನ ಮತ್ತು ಅವಮಾನ,</para>
  <para style="q2" vid="PRO 13:18">ಗದರಿಕೆಯನ್ನು ಗಮನಿಸುವವನಿಗೆ ಮಾನ.<verse eid="PRO 13:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19"/>ಇಷ್ಟಸಿದ್ಧಿ ಮನಸ್ಸಿಗೆ ಸಿಹಿ,</para>
  <para style="q2" vid="PRO 13:19">ಕೆಟ್ಟದ್ದನ್ನು ಬಿಡುವುದು ಮೂಢರಿಗೆ ಕಹಿ.<verse eid="PRO 13:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20"/>ಜ್ಞಾನಿಗಳ ಸಹವಾಸಿ ಜ್ಞಾನಿಯಾಗುವನು,</para>
  <para style="q2" vid="PRO 13:20">ಜ್ಞಾನಹೀನರ ಒಡನಾಡಿ ಸಂಕಟಪಡುವನು.<verse eid="PRO 13:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21"/>ಅಮಂಗಳವು ಪಾಪಿಗಳನ್ನು ಹಿಂಬಾಲಿಸುವುದು,</para>
  <para style="q2" vid="PRO 13:21">ಮಂಗಳವು ಸಜ್ಜನರಿಗೆ ಪ್ರತಿಫಲವಾಗುವುದು.<verse eid="PRO 13:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22"/>ಒಳ್ಳೆಯವನ ಆಸ್ತಿ ಸಂತತಿಯವರಿಗೆ ಬಾಧ್ಯ,</para>
  <para style="q2" vid="PRO 13:22">ಪಾಪಿಯ ಸೊತ್ತು ಸಜ್ಜನರಿಗೆ ಗಂಟು.<verse eid="PRO 13:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23"/>ಬಡವರಿಗೆ ಬಂಜರು ಭೂಮಿಯೂ ಬಹು ಬೆಳೆಯನ್ನೀಯುವುದು,</para>
  <para style="q2" vid="PRO 13:23">ಅನ್ಯಾಯದಿಂದ ಹಾಳಾದ ಸುದ್ದಿಯು ಉಂಟು.<verse eid="PRO 13:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24"/>ಬೆತ್ತ ಹಿಡಿಯದ ತಂದೆ ಮಗನಿಗೆ ಶತ್ರು,</para>
  <para style="q2" vid="PRO 13:24">ಸುಶಿಕ್ಷಣವನ್ನು ನೀಡುವ ತಂದೆ ಮಗನಿಗೆ ಮಿತ್ರ.<verse eid="PRO 13:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25"/>ಶಿಷ್ಟನು ಹೊಟ್ಟೆತುಂಬಾ ಉಣ್ಣುವನು,</para>
  <para style="q2" vid="PRO 13:25">ದುಷ್ಟನ ಹೊಟ್ಟೆ ಹಸಿದಿರುವುದು.<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1"/>ಜ್ಞಾನವಂತೆಯು ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿಕೊಳ್ಳುವಳು,</para>
  <para style="q2" vid="PRO 14:1">ಜ್ಞಾನಹೀನಳು ಅದನ್ನು ಸ್ವಂತ ಕೈಯಿಂದ ನಾಶಮಾಡುವಳು.<verse eid="PRO 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2"/>ಸರಳಮಾರ್ಗಿಯು ಯೆಹೋವನಿಗೆ ಭಯಪಡುವನು,</para>
  <para style="q2" vid="PRO 14:2">ವಕ್ರಮಾರ್ಗಿಯು ಆತನನ್ನು ಅಸಡ್ಡೆಮಾಡುವನು.<verse eid="PRO 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:3 </char>
      <char style="ft" closed="false">ಅಥವಾ ಮೂರ್ಖನ ಬಾಯಲ್ಲಿ ಗರ್ವವು ಅಂಕುರಿಸುವದು, </char>
    </note>ಮೂರ್ಖನ ಮಾತುಗಳು ಅವನ ಬೆನ್ನಿಗೆ ಬೆತ್ತ,</para>
  <para style="q2" vid="PRO 14:3">ಜ್ಞಾನಿಗಳ ತುಟಿಗಳು ಅವರನ್ನು ಕಾಯುವವು.<verse eid="PRO 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4"/>ಎತ್ತುಗಳಿಲ್ಲದಿರುವಾಗ ಗೋದಲಿಯು ಶುದ್ಧ,</para>
  <para style="q2" vid="PRO 14:4">ಆದರೆ ಎತ್ತಿನ ಶಕ್ತಿಯಿಂದಲೇ ಬೆಳೆಯ ವೃದ್ಧಿಯಾಗುವುದು.<verse eid="PRO 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5"/>ಸತ್ಯಸಾಕ್ಷಿಯು ಸುಳ್ಳಾಡನು,</para>
  <para style="q2" vid="PRO 14:5">ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಅಸತ್ಯವನ್ನೇ ಆಡುವನು.<verse eid="PRO 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6"/>ಧರ್ಮನಿಂದಕನಲ್ಲಿ ಹುಡುಕಿದರೂ ಜ್ಞಾನವು ಸಿಕ್ಕದು,</para>
  <para style="q2" vid="PRO 14:6">ವಿವೇಕಿಗೆ ತಿಳಿವಳಿಕೆಯು ಸುಲಭವಾಗಿ ದೊರೆಯುವುದು.<verse eid="PRO 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7"/>ನೀನು ಜ್ಞಾನಹೀನನ ಬಳಿಗೆ ಹೋದರೆ ಅವನ ತುಟಿಗಳಲ್ಲಿ ಯಾವ ತಿಳಿವಳಿಕೆಯನ್ನೂ ಕಾಣಲಾರೆ.<verse eid="PRO 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8"/>ಸನ್ಮಾರ್ಗವನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವುದೇ ಜಾಣನ ಜ್ಞಾನ,</para>
  <para style="q2" vid="PRO 14:8">ಮೂಢರ ಮೂರ್ಖತನ ಮೋಸಕರ.<verse eid="PRO 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9"/>ಮೂರ್ಖರನ್ನು ಅವರ ದೋಷವೇ ಹಾಸ್ಯಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 14:9">ಯಥಾರ್ಥವಂತರಲ್ಲಿ (ದೇವರ) ದಯೆಯಿರುವುದು.<verse eid="PRO 14:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10"/>ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಹೃದಯದ ವ್ಯಾಕುಲವನ್ನು ತಾನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವನು,</para>
  <para style="q2" vid="PRO 14:10">ಅವನ ಆನಂದದಲ್ಲಿಯೂ ಬೇರೆಯವರು ಪಾಲುಗಾರರಾಗುವುದಿಲ್ಲ.<verse eid="PRO 14:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11"/>ದುಷ್ಟರ ಮನೆಗೆ ನಾಶನ,</para>
  <para style="q2" vid="PRO 14:11">ಶಿಷ್ಟರ ಗುಡಾರಕ್ಕೆ ಏಳಿಗೆ.<verse eid="PRO 14:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12"/>ಮನುಷ್ಯನ ದೃಷ್ಟಿಗೆ ಸರಳವಾಗಿ ತೋರುವ ಒಂದು ದಾರಿಯುಂಟು.</para>
  <para style="q2" vid="PRO 14:12">ಅದು ಕಟ್ಟಕಡೆಗೆ ಮರಣಮಾರ್ಗವೇ.<verse eid="PRO 14:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13"/>ನಗುವವನಿಗೂ ಮನೋವ್ಯಥೆಯುಂಟು,</para>
  <para style="q2" vid="PRO 14:13">ಉಲ್ಲಾಸದ ಅಂತ್ಯವು ವ್ಯಾಕುಲವೇ.<verse eid="PRO 14:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14"/>ಭ್ರಷ್ಟನು ಕರ್ಮಫಲವನ್ನು ತಿಂದು ತಿಂದು ದಣಿಯುವನು,</para>
  <para style="q2" vid="PRO 14:14">ಶಿಷ್ಟನು ತನ್ನಲ್ಲಿ ತಾನೇ ತೃಪ್ತನಾಗುವನು.<verse eid="PRO 14:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15"/>ಮೂಢನು ಯಾವ ಮಾತನ್ನಾದರೂ ನಂಬುವನು,</para>
  <para style="q2" vid="PRO 14:15">ಜಾಣನು ತನ್ನ ನಡತೆಯನ್ನು ಚೆನ್ನಾಗಿ ಗಮನಿಸುವನು.<verse eid="PRO 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:16 </char>
      <char style="ft" closed="false">ಅಥವಾ ಜ್ಞಾನಿಯು ಯೆಹೋವನಿಗೆ ಭಯಪಡುತ್ತಾನೆ</char>
    </note>ಜ್ಞಾನಿಯು ಕೇಡಿಗೆ ಭಯಪಟ್ಟು ಓರೆಯಾಗುವನು,</para>
  <para style="q2" vid="PRO 14:16">ಜ್ಞಾನಹೀನನು ಸೊಕ್ಕಿನಿಂದ ಭಯವನ್ನು ಲಕ್ಷಿಸನು.<verse eid="PRO 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17"/>ಮುಂಗೋಪಿಯು ಬುದ್ಧಿಹೀನನಾಗಿ ವರ್ತಿಸುವನು,</para>
  <para style="q2" vid="PRO 14:17">
    <note caller="+" style="f">
      <char style="fr" closed="false">14:17 </char>
      <char style="ft" closed="false">ಅಥವಾ ಜ್ಞಾನಿಗಳು ಮೌನವಾಗಿರುತ್ತಾರೆ.</char>
    </note>ಕುಯುಕ್ತಿಯುಳ್ಳವನು ದ್ವೇಷಕ್ಕೆ ಪಾತ್ರನು.<verse eid="PRO 14:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18"/>ಮೂರ್ಖರಿಗೆ ಮೂರ್ಖತನವೇ ಸ್ವತ್ತು,</para>
  <para style="q2" vid="PRO 14:18">ಜಾಣರಿಗೆ ಜ್ಞಾನವೇ ಕಿರೀಟ.<verse eid="PRO 14:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19"/>ಕೆಟ್ಟವರು ಒಳ್ಳೆಯವರಿಗೆ ಬಾಗುವರು,</para>
  <para style="q2" vid="PRO 14:19">ದುಷ್ಟರು ಶಿಷ್ಟರ ಬಾಗಿಲಲ್ಲಿ ಅಡ್ಡಬೀಳುವರು.<verse eid="PRO 14:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20"/>ಬಡವನು ನೆರೆಯವನಿಗೂ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 14:20">ಧನವಂತನಿಗೆ ಬಹು ಜನ ಮಿತ್ರರು.<verse eid="PRO 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21"/>ನೆರೆಯವನನ್ನು ತಿರಸ್ಕರಿಸುವವನು ದೋಷಿ,</para>
  <para style="q2" vid="PRO 14:21">ದರಿದ್ರನನ್ನು ಕನಿಕರಿಸುವವನು ಧನ್ಯನು.<verse eid="PRO 14:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22"/>ಕುಯುಕ್ತಿಯುಳ್ಳವರು ದಾರಿತಪ್ಪಿದವರೇ ಸರಿ,</para>
  <para style="q2" vid="PRO 14:22">ಒಳ್ಳೆಯದನ್ನು ಕಲ್ಪಿಸುವವರು ಪ್ರೀತಿಸತ್ಯತೆಗಳಿಗೆ ಪಾತ್ರರು.<verse eid="PRO 14:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23"/>ಶ್ರಮೆಯಿಂದ ಸಮೃದ್ಧಿ,</para>
  <para style="q2" vid="PRO 14:23">ಹರಟೆಯಿಂದ ಕೊರತೆ.<verse eid="PRO 14:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24"/>ಜ್ಞಾನಿಗಳ ಜ್ಞಾನಕಿರೀಟವೇ ಅವರ ಶ್ರೇಷ್ಠ ಸಂಪತ್ತು,</para>
  <para style="q2" vid="PRO 14:24">ಜ್ಞಾನಹೀನರ ಮೂರ್ಖತನವು ಬರೀ ಮೂರ್ಖತನವೇ.<verse eid="PRO 14:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25"/>ಸತ್ಯಸಾಕ್ಷಿಯು ಪ್ರಾಣರಕ್ಷಕ,</para>
  <para style="q2" vid="PRO 14:25">ಸುಳ್ಳುಸಾಕ್ಷಿಯು ವಂಚಕ.<verse eid="PRO 14:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26"/>ಯೆಹೋವನಿಗೆ ಭಯಪಡುವುದರಿಂದ ಕೇವಲ ನಿರ್ಭಯ,</para>
  <para style="q2" vid="PRO 14:26">ಆತನ ಮಕ್ಕಳಿಗೆ ಆಶ್ರಯವಿದ್ದೇ ಇರುವುದು.<verse eid="PRO 14:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27"/>ಯೆಹೋವನ ಭಯ ಜೀವದ ಬುಗ್ಗೆ,</para>
  <para style="q2" vid="PRO 14:27">ಮೃತ್ಯುಪಾಶದಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ಅದು ಸಾಧನವಾಗಿದೆ.<verse eid="PRO 14:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28"/>ಪ್ರಜೆಗಳ ವೃದ್ಧಿ ರಾಜನ ಮಹಿಮೆ,</para>
  <para style="q2" vid="PRO 14:28">ಪ್ರಜೆಗಳ ನಾಶ ಪ್ರಭುವಿಗೆ ಭಯ.<verse eid="PRO 14:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29"/>ದೀರ್ಘಶಾಂತನು ಕೇವಲ ಬುದ್ಧಿವಂತನು,</para>
  <para style="q2" vid="PRO 14:29">ಮುಂಗೋಪಿಯು ಮೂರ್ಖತನವನ್ನು ಧ್ವಜವಾಗಿ ಎತ್ತುವನು.<verse eid="PRO 14:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30"/>ಶಾಂತಗುಣವು ದೇಹಕ್ಕೆ ಜೀವಾಧಾರವು,</para>
  <para style="q2" vid="PRO 14:30">ಕ್ರೋಧವು ಎಲುಬಿಗೆ ಕ್ಷಯವು.<verse eid="PRO 14:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31"/>ಬಡವರನ್ನು ಹಿಂಸಿಸುವವನು ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಹೀನೈಸುವನು,</para>
  <para style="q2" vid="PRO 14:31">ಗತಿಯಿಲ್ಲದವರನ್ನು ಕರುಣಿಸುವವನು ಆತನನ್ನು ಘನಪಡಿಸುವನು.<verse eid="PRO 14:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32"/>ದುಷ್ಟನು ವಿಪತ್ತಿಗೊಳಗಾಗಿ ಹಾಳಾಗುವನು,</para>
  <para style="q2" vid="PRO 14:32">ಶಿಷ್ಟನು <note caller="+" style="f"><char style="fr" closed="false">14:32 </char><char style="ft" closed="false">ಅಥವಾ ತನ್ನ ಸತ್ಯದಲ್ಲಿ.</char></note>ಮರಣಕಾಲದಲ್ಲಿಯೂ ಆಶ್ರಯಹೊಂದುವನು.<verse eid="PRO 14:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33"/>ವಿವೇಕಿಯ ಹೃದಯ ಜ್ಞಾನಾಶ್ರಯ,</para>
  <para style="q2" vid="PRO 14:33">ಜ್ಞಾನಹೀನನ ಹೃದಯದಲ್ಲಿ ಅದು ಕಾಣದು.<verse eid="PRO 14:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34"/>ಪ್ರಜೆಗೆ ಧರ್ಮವು ಉನ್ನತಿ,</para>
  <para style="q2" vid="PRO 14:34">ಅಧರ್ಮವು ಅವಮಾನ.<verse eid="PRO 14:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35"/>ಜಾಣನಾದ ಸೇವಕನಿಗೆ ರಾಜನ ಕೃಪೆ,</para>
  <para style="q2" vid="PRO 14:35">ಮಾನಗೇಡಿಗೆ ರಾಜನ ರೌದ್ರ.<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1"/>ಮೃದುವಾದ ಪ್ರತ್ಯುತ್ತರವು ಸಿಟ್ಟನ್ನಾರಿಸುವುದು,</para>
  <para style="q2" vid="PRO 15:1">ಬಿರುನುಡಿಯು ಸಿಟ್ಟನ್ನೇರಿಸುವುದು.<verse eid="PRO 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2"/>ಜ್ಞಾನಿಗಳ ನಾಲಿಗೆಯು ತಿಳಿವಳಿಕೆಯನ್ನು ಸಾರ್ಥಕ ಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 15:2">ಜ್ಞಾನಹೀನರ ಬಾಯಿಯು ಮೂರ್ಖತನವನ್ನು ಕಾರುವುದು.<verse eid="PRO 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3"/>ಯೆಹೋವನ ದೃಷ್ಟಿಯು ಎಲ್ಲೆಲ್ಲಿಯೂ ಇರುವುದು,</para>
  <para style="q2" vid="PRO 15:3">ಆತನು ಕೆಟ್ಟವರನ್ನು ಮತ್ತು ಒಳ್ಳೆಯವರನ್ನು ನೋಡುತ್ತಲೇ ಇರುವನು.<verse eid="PRO 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4"/>ಸಂತೈಸುವ ನಾಲಿಗೆ ಜೀವವೃಕ್ಷವು,</para>
  <para style="q2" vid="PRO 15:4">ಬಲತ್ಕರಿಸುವ ನಾಲಿಗೆ ಮನಮುರಿಯುವುದು.<verse eid="PRO 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5"/>ಮೂರ್ಖನು ತಂದೆಯ ಶಿಕ್ಷೆಯನ್ನು ತಿರಸ್ಕರಿಸುವನು,</para>
  <para style="q2" vid="PRO 15:5">ಗದರಿಕೆಯನ್ನು ಗಮನಿಸುವವನು ಜಾಣನು.<verse eid="PRO 15:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6"/>ಶಿಷ್ಟನ ಮನೆಯಲ್ಲಿ ದೊಡ್ಡ ನಿಧಿ,</para>
  <para style="q2" vid="PRO 15:6">ದುಷ್ಟನ ಆದಾಯವು ನಷ್ಟಕ್ಕೆ ದಾರಿ.<verse eid="PRO 15:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7"/>ಜ್ಞಾನಿಗಳ ತುಟಿಗಳು ತಿಳಿವಳಿಕೆಯನ್ನು ಬಿತ್ತುವವು.</para>
  <para style="q2" vid="PRO 15:7">ಜ್ಞಾನಹೀನರ ಹೃದಯವು ಅದನ್ನು ಬಿತ್ತುವುದೇ ಇಲ್ಲ.<verse eid="PRO 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8"/>ದುಷ್ಟರ ಯಜ್ಞ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 15:8">ಶಿಷ್ಟರ ಬಿನ್ನಹ ಆತನಿಗೆ ಇಷ್ಟ.<verse eid="PRO 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9"/>ದುಷ್ಟನ ನಡತೆಯು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 15:9">ಧರ್ಮಾಸಕ್ತನು ಆತನಿಗೆ ಪ್ರಿಯ.<verse eid="PRO 15:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10"/>ಧರ್ಮಮಾರ್ಗವನ್ನು ಬಿಟ್ಟವನಿಗೆ ತೀಕ್ಷ್ಣ ಶಿಕ್ಷಣ,</para>
  <para style="q2" vid="PRO 15:10">ಗದರಿಕೆಯನ್ನು ಕೇಳದವನಿಗೆ ಸಾವು.<verse eid="PRO 15:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11"/>ಪಾತಾಳವೂ, ನಾಶಲೋಕವೂ ಯೆಹೋವನಿಗೆ ಗೋಚರವಾಗಿರುವಲ್ಲಿ</para>
  <para style="q2" vid="PRO 15:11">ನರವಂಶದವರ ಹೃದಯಗಳು ಆತನಿಗೆ ಮತ್ತೂ ಸ್ಪಷ್ಟ.<verse eid="PRO 15:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12"/>ಧರ್ಮನಿಂದಕನು ಗದರಿಕೆಯನ್ನು ಕೇಳನು,</para>
  <para style="q2" vid="PRO 15:12">ಜ್ಞಾನಿಗಳ ಸಂಗಡ ಸೇರನು.<verse eid="PRO 15:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13"/>ಹರ್ಷ ಹೃದಯದಿಂದ ಹಸನ್ಮುಖ,</para>
  <para style="q2" vid="PRO 15:13">ಮನೋವ್ಯಥೆಯಿಂದ ಆತ್ಮಭಂಗ.<verse eid="PRO 15:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14"/>ವಿವೇಕಿಯ ಹೃದಯ ತಿಳಿವಳಿಕೆಯನ್ನು ಹುಡುಕುವುದು,</para>
  <para style="q2" vid="PRO 15:14">ಮೂಢರ ಬಾಯಿ ಮೂರ್ಖತನವನ್ನು ಮುಕ್ಕುವುದು.<verse eid="PRO 15:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15"/>ದೀನನ ದಿನಗಳೆಲ್ಲಾ ದುಃಖಭರಿತ,</para>
  <para style="q2" vid="PRO 15:15">ಹರ್ಷಹೃದಯನಿಗೆ ನಿತ್ಯವೂ ಔತಣ.<verse eid="PRO 15:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16"/>ಕಳವಳದಿಂದ ಕೂಡಿದ ಬಹುಧನಕ್ಕಿಂತಲೂ</para>
  <para style="q2" vid="PRO 15:16">ಯೆಹೋವನ ಭಯದಿಂದ ಕೂಡಿದ ಅಲ್ಪ ಧನವೇ ಲೇಸು.<verse eid="PRO 15:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17"/>ದ್ವೇಷವಿರುವಲ್ಲಿ ಮೃಷ್ಟಾನ್ನಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 15:17">ಪ್ರೇಮವಿರುವಲ್ಲಿ ಸೊಪ್ಪಿನ ಊಟವೇ ಉತ್ತಮ.<verse eid="PRO 15:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18"/>ಕೋಪಿಷ್ಠನು ವ್ಯಾಜ್ಯವನ್ನೆಬ್ಬಿಸುವನು,</para>
  <para style="q2" vid="PRO 15:18">ದೀರ್ಘಶಾಂತನು ಜಗಳವನ್ನು ಶಮನಪಡಿಸುವನು.<verse eid="PRO 15:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19"/>ಸೋಮಾರಿಯ ಮಾರ್ಗ ಮುಳ್ಳುಬೇಲಿ,</para>
  <para style="q2" vid="PRO 15:19">ಯಥಾರ್ಥವಂತನ ಮಾರ್ಗ ರಾಜಮಾರ್ಗ.<verse eid="PRO 15:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20"/>ಜ್ಞಾನವಂತನಾದ ಮಗನು ತಂದೆಯನ್ನು ಉಲ್ಲಾಸಗೊಳಿಸುವನು,</para>
  <para style="q2" vid="PRO 15:20">ಜ್ಞಾನಹೀನನು ತಾಯಿಯನ್ನು ತಿರಸ್ಕರಿಸುವನು.<verse eid="PRO 15:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21"/>ಬುದ್ಧಿಹೀನನು ಮೂರ್ಖತನದಲ್ಲಿ ಆನಂದಿಸುವನು,</para>
  <para style="q2" vid="PRO 15:21">ಬುದ್ಧಿವಂತನು ತನ್ನ ಮಾರ್ಗವನ್ನು ಸರಳಮಾಡಿಕೊಳ್ಳುವನು.<verse eid="PRO 15:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22"/>ಆಲೋಚನೆ ಹೇಳುವವರಿಲ್ಲದೆ ಉದ್ದೇಶಗಳು ನೆರವೇರವು,</para>
  <para style="q2" vid="PRO 15:22">ಬಹು ಮಂದಿ ಆಲೋಚನಾಪರರು ಇರುವಲ್ಲಿ ಅವು ನೆರವೇರುವವು.<verse eid="PRO 15:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23"/>ತಕ್ಕ ಉತ್ತರಕೊಡುವವನಿಗೆ ಎಷ್ಟೋ ಸಂತೋಷ!</para>
  <para style="q2" vid="PRO 15:23">ಸಮಯೋಚಿತವಾದ ನುಡಿಯಲ್ಲಿ ಎಷ್ಟೋ ಸ್ವಾರಸ್ಯ!<verse eid="PRO 15:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24"/>ಜೀವದ ಮಾರ್ಗವು ವಿವೇಕಿಯನ್ನು ಮೇಲಕ್ಕೆತ್ತುವುದು;</para>
  <para style="q2" vid="PRO 15:24">ಅದು ಅವನನ್ನು ಪಾತಾಳದಿಂದ ತಪ್ಪಿಸುವುದು.<verse eid="PRO 15:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25"/>ಯೆಹೋವನು ಗರ್ವಿಷ್ಠನ ಮನೆಯನ್ನು ಕೆಡವಿಬಿಡುವನು;</para>
  <para style="q2" vid="PRO 15:25">ವಿಧವೆಯ ಮೇರೆಯನ್ನು ನೆಲೆಗೊಳಿಸುವನು.<verse eid="PRO 15:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26"/>ಕುಯುಕ್ತಿಯು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 15:26">ನಯನುಡಿಯು ಆತನಿಗೆ ಪ್ರಿಯ.<verse eid="PRO 15:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27"/>ಸೂರೆಮಾಡುವವನು ಸ್ವಂತ ಮನೆಯನ್ನು ಬಾಧಿಸುವನು.</para>
  <para style="q2" vid="PRO 15:27">ಲಂಚವನ್ನೊಪ್ಪದವನು ಸುಖವಾಗಿ ಬಾಳುವನು.<verse eid="PRO 15:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28"/>ಶಿಷ್ಟನ ಹೃದಯ ವಿವೇಚಿಸಿ ಉತ್ತರಕೊಡುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 15:28">ದುಷ್ಟನ ಬಾಯಿ ಕೆಟ್ಟದ್ದನ್ನು ಕಾರುತ್ತದೆ.<verse eid="PRO 15:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29"/>ಯೆಹೋವನು ದುಷ್ಟರಿಗೆ ದೂರ,</para>
  <para style="q2" vid="PRO 15:29">ಶಿಷ್ಟರ ಬಿನ್ನಹಕ್ಕೆ ಹತ್ತಿರ.<verse eid="PRO 15:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">15:30 </char>
      <char style="ft" closed="false">ಮೂಲತಃ ಕಣ್ಣಿನ ಬೆಳಕು.</char>
    </note>ಹಸನ್ಮುಖ ಹೃದಯಕ್ಕೆ ಆನಂದ,</para>
  <para style="q2" vid="PRO 15:30">
    <note caller="+" style="f">
      <char style="fr" closed="false">15:30 </char>
      <char style="ft" closed="false">ಮೂಲತಃ ಕಿವಿಗೆ ಬಿದ್ದ ಒಳ್ಳೆಯ ಸುದ್ದಿ ಎಲುಬಿಗೆ ಪುಷ್ಟಿ.</char>
    </note>ಶುಭಸಮಾಚಾರ ದೇಹಕ್ಕೆ ಆರೋಗ್ಯ.<verse eid="PRO 15:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31"/>ಜೀವಪ್ರದವಾದ ಗದರಿಕೆಗೆ ಕಿವಿಗೊಡುವವನು,</para>
  <para style="q2" vid="PRO 15:31">ಜ್ಞಾನಿಗಳ ನಡುವೆ ನೆಲೆಗೊಳ್ಳುವನು.<verse eid="PRO 15:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32"/>ಶಿಕ್ಷೆಯನ್ನು ತಿರಸ್ಕರಿಸುವವನು ತನ್ನನ್ನೇ ನಿರಾಕರಿಸಿಕೊಳ್ಳುವನು,</para>
  <para style="q2" vid="PRO 15:32">ಗದರಿಕೆಯನ್ನು ಕೇಳುವವನು ಬುದ್ಧಿಯನ್ನು ಪಡೆಯುವನು.<verse eid="PRO 15:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33"/>ಯೆಹೋವನ ಭಯವೇ ಜ್ಞಾನೋಪದೇಶ,</para>
  <para style="q2" vid="PRO 15:33">ಗೌರವಕ್ಕೆ ಮೊದಲು ವಿನಯ.<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1"/>ಹೃದಯದ ಸಂಕಲ್ಪವು ಮನುಷ್ಯನ ವಶವು,</para>
  <para style="q2" vid="PRO 16:1">ತಕ್ಕ ಉತ್ತರಕೊಡುವ ಶಕ್ತಿಯು ಯೆಹೋವನಿಂದಾಗುವುದು.<verse eid="PRO 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2"/>ಮನುಷ್ಯನ ನಡತೆಯೆಲ್ಲಾ ಸ್ವಂತ ದೃಷ್ಟಿಗೆ ಶುದ್ಧವಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 16:2">ಯೆಹೋವನು ಅಂತರಂಗವನ್ನೇ ಪರೀಕ್ಷಿಸುವನು.<verse eid="PRO 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3"/>ನಿನ್ನ ಕಾರ್ಯಭಾರವನ್ನು ಯೆಹೋವನಿಗೆ ವಹಿಸಿದರೆ,</para>
  <para style="q2" vid="PRO 16:3">ನಿನ್ನ ಉದ್ದೇಶಗಳು ಸಫಲವಾಗುವವು.<verse eid="PRO 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4"/>ಯೆಹೋವನು ಒಂದೊಂದನ್ನೂ ತಕ್ಕ ಗುರಿಯಿಂದ ಸೃಷ್ಟಿಸಿದ್ದಾನೆ,</para>
  <para style="q2" vid="PRO 16:4">ಹೌದು, ಕೇಡಿನ ದಿನಕ್ಕಾಗಿ ಕೆಡುಕರನ್ನು ಉಂಟುಮಾಡಿದ್ದಾನೆ.<verse eid="PRO 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5"/>ಅಹಂಕಾರಿಗಳೆಲ್ಲಾ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 16:5">ಅವರಿಗೆ ದಂಡನೆ ಖಂಡಿತ.<verse eid="PRO 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6"/>ಕೃಪಾಸತ್ಯತೆಗಳಿಂದ ಪಾಪನಿವಾರಣೆ,</para>
  <para style="q2" vid="PRO 16:6">ಯೆಹೋವನ ಭಯಭಕ್ತಿಯಿಂದ ಹಾನಿನಿವಾರಣೆ.<verse eid="PRO 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7"/>ಯೆಹೋವನು ಒಬ್ಬನ ನಡತೆಗೆ ಮೆಚ್ಚಿದರೆ,</para>
  <para style="q2" vid="PRO 16:7">ಅವನ ಶತ್ರುಗಳನ್ನೂ ಮಿತ್ರರನ್ನಾಗಿ ಮಾಡುವನು.<verse eid="PRO 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8"/>ಅನ್ಯಾಯದಿಂದ ಗಳಿಸಿದ ಬಹು ಧನಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 16:8">ನ್ಯಾಯದಿಂದ ಕೂಡಿಸಿದ ಅಲ್ಪ ಧನವೇ ಲೇಸು.<verse eid="PRO 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9"/>ಮನುಷ್ಯನು ತನ್ನ ಮನದಂತೆ ದಾರಿಯನ್ನು ಆರಿಸಿಕೊಂಡರೂ,</para>
  <para style="q2" vid="PRO 16:9">ಯೆಹೋವನೇ ಅವನಿಗೆ ಗತಿಯನ್ನು ಏರ್ಪಡಿಸುವನು.<verse eid="PRO 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10"/>ರಾಜನ ತುಟಿಗಳಲ್ಲಿ ದೈವೋಕ್ತಿ,</para>
  <para style="q2" vid="PRO 16:10">ನ್ಯಾಯತೀರಿಸುವುದರಲ್ಲಿ ಅವನ ಬಾಯಿ ತಪ್ಪಿಹೋಗದು.<verse eid="PRO 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11"/>ನ್ಯಾಯದ ಅಳತೆ ಮತ್ತು ತಕ್ಕಡಿಗಳು ಯೆಹೋವನ ಏರ್ಪಾಡು,</para>
  <para style="q2" vid="PRO 16:11">ಚೀಲದಲ್ಲಿನ ತೂಕದಕಲ್ಲುಗಳೆಲ್ಲಾ ಆತನ ಕೈಕೆಲಸವೇ.<verse eid="PRO 16:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12"/>ರಾಜರು ಸಿಂಹಾಸನಕ್ಕೆ ಧರ್ಮವೇ ಆಧಾರವೆಂದು ತಿಳಿದು,</para>
  <para style="q2" vid="PRO 16:12">ಅಧರ್ಮವನ್ನಾಚರಿಸಲು ಅಸಹ್ಯಪಡುವರು.<verse eid="PRO 16:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13"/>ರಾಜರು ಸತ್ಯದ ತುಟಿಗಳನ್ನು ಮೆಚ್ಚುವರು,</para>
  <para style="q2" vid="PRO 16:13">ಯಥಾರ್ಥವಾದಿಯನ್ನು ಪ್ರೀತಿಸುವರು.<verse eid="PRO 16:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14"/>ರಾಜನ ಕೋಪ ಮೃತ್ಯುವಿನ ದೂತ,</para>
  <para style="q2" vid="PRO 16:14">ಜಾಣನು ಅದನ್ನು ಶಮನಪಡಿಸುವನು.<verse eid="PRO 16:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15"/>ಪ್ರಭುವಿನ ಮುಖಪ್ರಸನ್ನತೆ ಜೀವ,</para>
  <para style="q2" vid="PRO 16:15">ಆತನ ದಯೆ ಮುಂಗಾರುಮುಗಿಲು.<verse eid="PRO 16:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16"/>ಬಂಗಾರಕ್ಕಿಂತಲೂ ಜ್ಞಾನವನ್ನು ಪಡೆಯುವುದು ಎಷ್ಟೋ ಮೇಲು,</para>
  <para style="q2" vid="PRO 16:16">ಬೆಳ್ಳಿಗಿಂತಲೂ ವಿವೇಕವನ್ನು ಹೊಂದುವುದು ಲೇಸು.<verse eid="PRO 16:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17"/>ಸತ್ಯವಂತನ ರಾಜಮಾರ್ಗ ಹಾನಿಗೆ ದೂರ,</para>
  <para style="q2" vid="PRO 16:17">ತನ್ನ ನಡತೆಯನ್ನು ಗಮನಿಸುವವನು ತನ್ನ ಆತ್ಮವನ್ನು ಕಾಯುವನು.<verse eid="PRO 16:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18"/>ಗರ್ವದಿಂದ ಭಂಗ,</para>
  <para style="q2" vid="PRO 16:18">ಉಬ್ಬಿನಿಂದ ದೊಬ್ಬು.<verse eid="PRO 16:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19"/>ಸೊಕ್ಕಿನವರ ಸಂಗಡ ಸೂರೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 16:19">ದೀನರ ಸಂಗಡ ದೈನ್ಯದಿಂದಿರುವುದು ವಾಸಿ.<verse eid="PRO 16:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20"/>ದೇವರ ವಾಕ್ಯವನ್ನು ಸ್ಮರಿಸುವವನು ಸುಕ್ಷೇಮವನ್ನು ಪಡೆಯುವನು,</para>
  <para style="q2" vid="PRO 16:20">ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡುವವನು ಭಾಗ್ಯವಂತನು.<verse eid="PRO 16:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21"/>ಜ್ಞಾನಹೃದಯರಿಗೆ ಜಾಣರೆಂಬ ಬಿರುದು ಬರುವುದು,</para>
  <para style="q2" vid="PRO 16:21">ಸವಿತುಟಿಯಿಂದ ಉಪದೇಶ ಶಕ್ತಿಯು ಹೆಚ್ಚುವುದು.<verse eid="PRO 16:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22"/>ವಿವೇಕಿಗೆ ವಿವೇಕವೇ ಜೀವದ ಬುಗ್ಗೆ,</para>
  <para style="q2" vid="PRO 16:22">ಮೂರ್ಖನಿಗೆ ಮೂರ್ಖತನವೇ ದಂಡನೆ.<verse eid="PRO 16:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23"/>ಜ್ಞಾನಿಯ ಹೃದಯವು ಅವನ ಬಾಯಿಗೆ ಜಾಣತನವನ್ನೂ,</para>
  <para style="q2" vid="PRO 16:23">ಅವನ ತುಟಿಗಳಿಗೆ ಉಪದೇಶ ಶಕ್ತಿಯನ್ನೂ ಹೆಚ್ಚಿಸುವುದು.<verse eid="PRO 16:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24"/>ಸವಿನುಡಿಯು ಜೇನುಕೊಡ,</para>
  <para style="q2" vid="PRO 16:24">ಅದು ಆತ್ಮಕ್ಕೆ ಸಿಹಿ, ಎಲುಬಿಗೆ ಕ್ಷೇಮ.<verse eid="PRO 16:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25"/>ಮನುಷ್ಯನ ದೃಷ್ಟಿಗೆ ಸರಳವಾಗಿ ತೋರುವ ಒಂದು ದಾರಿಯುಂಟು,</para>
  <para style="q2" vid="PRO 16:25">ಕಟ್ಟಕಡೆಗೆ ಅದು ಮರಣಮಾರ್ಗವೇ.<verse eid="PRO 16:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26"/>ದುಡಿಯುವವನಿಗೆ ಅವನ ಹೊಟ್ಟೆಯೇ ದುಡಿಯುವಂತೆ ಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 16:26">ದುಡಿಯಲಿಕ್ಕೆ ಅವನ ಬಾಯೇ ಅವನನ್ನು ಒತ್ತಾಯ ಮಾಡುವುದು.<verse eid="PRO 16:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27"/>ನೀಚನು ಕೇಡೆಂಬ ಕುಣಿಯನ್ನು ತೋಡುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 16:27">ಅವನ ಮಾತುಗಳು ಬೆಂಕಿಯ ಉರಿಯಂತಿದೆ.<verse eid="PRO 16:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28"/>ತುಂಟನು ಜಗಳ ಬಿತ್ತುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 16:28">ಚಾಡಿಕೋರನು ಮಿತ್ರರನ್ನು ಅಗಲಿಸುತ್ತಾನೆ.<verse eid="PRO 16:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29"/>ಬಲಾತ್ಕಾರಿಯು ನೆರೆಯವನನ್ನು ಮರುಳುಗೊಳಿಸಿ,</para>
  <para style="q2" vid="PRO 16:29">ದುರ್ಮಾರ್ಗಕ್ಕೆ ಎಳೆಯುವನು.<verse eid="PRO 16:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30"/>ಕಣ್ಣನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವವನು ಕುಯುಕ್ತಿಯನ್ನು ಕಲ್ಪಿಸುವನು,</para>
  <para style="q2" vid="PRO 16:30">ತುಟಿಯನ್ನು ಕಚ್ಚುವವನು ಕೇಡನ್ನು ಸಾಧಿಸುವನು.<verse eid="PRO 16:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31"/>ನರೆಗೂದಲೇ ಸುಂದರ ಕಿರೀಟವು,</para>
  <para style="q2" vid="PRO 16:31">ಅದು ಧರ್ಮಮಾರ್ಗದಲ್ಲಿ ದೊರಕುವುದು.<verse eid="PRO 16:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32"/>ದೀರ್ಘಶಾಂತನು ಶೂರನಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠ,</para>
  <para style="q2" vid="PRO 16:32">ತನ್ನನ್ನು ಆಳುವವನು ಪಟ್ಟಣವನ್ನು ಗೆದ್ದವನಿಗಿಂತಲೂ ಬಲಿಷ್ಠ.<verse eid="PRO 16:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33"/>ಮಡಲಿನಲ್ಲಿ ಚೀಟು ಹಾಕಬಹುದು,</para>
  <para style="q2" vid="PRO 16:33">ಅದರ ತೀರ್ಪು ಯೆಹೋವನದೇ.<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1"/>ವ್ಯಾಜ್ಯದ ಮನೆಯಲ್ಲಿ ತುಂಬಿದ ಔತಣಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 17:1">ಸಮಾಧಾನದ ಒಣತುತ್ತೇ ಮೇಲು.<verse eid="PRO 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2"/>ಜಾಣನಾದ ಆಳು ಮಾನಕಳೆದ ಮನೆಮಗನ ಮೇಲೆ ಅಧಿಕಾರಮಾಡುವನು,</para>
  <para style="q2" vid="PRO 17:2">ಮನೆಮಕ್ಕಳೊಂದಿಗೆ ಬಾಧ್ಯತೆಯನ್ನು ಹೊಂದುವನು.<verse eid="PRO 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3"/>ಬೆಳ್ಳಿಬಂಗಾರಗಳನ್ನು ಪುಟಕುಲಿಮೆಗಳು ಶೋಧಿಸುವವು,</para>
  <para style="q2" vid="PRO 17:3">ಹೃದಯಗಳನ್ನು ಶೋಧಿಸುವವನು ಯೆಹೋವನೇ.<verse eid="PRO 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4"/>ಕೆಡುಕನು ಕೆಟ್ಟ ತುಟಿಗಳನ್ನು ಗಮನಿಸುವನು,</para>
  <para style="q2" vid="PRO 17:4">ಸುಳ್ಳುಗಾರನು ನಾಶನದ ನಾಲಿಗೆಗೆ ಕಿವಿಗೊಡುವನು.<verse eid="PRO 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5"/>ಬಡವರನ್ನು ಹಾಸ್ಯಮಾಡುವವನು ಸೃಷ್ಟಿಕರ್ತನನ್ನೇ ಹೀನೈಸುವನು,</para>
  <para style="q2" vid="PRO 17:5">ಪರರ ವಿಪತ್ತಿಗೆ ಹಿಗ್ಗುವವನು ದಂಡನೆಯನ್ನು ಹೊಂದದಿರನು.<verse eid="PRO 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6"/>ಮಕ್ಕಳ ಸಂತತಿಯವರು ವೃದ್ಧರಿಗೆ ಕಿರೀಟ,</para>
  <para style="q2" vid="PRO 17:6">ತಂದೆತಾಯಿಗಳು ಮಕ್ಕಳಿಗೆ ಭೂಷಣ.<verse eid="PRO 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7"/>ಉತ್ತಮವಾದ ಮಾತು ಮೂರ್ಖನಿಗೆ ಅಯುಕ್ತ,</para>
  <para style="q2" vid="PRO 17:7">ಸುಳ್ಳುಮಾತು ಉತ್ತಮನಿಗೆ ಮತ್ತೂ ಅಯುಕ್ತ.<verse eid="PRO 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8"/>ಕೊಡುವವನ ದೃಷ್ಟಿಗೆ ಲಂಚವು ಚಿಂತಾಮಣಿಯಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 17:8">ಎಲ್ಲಿ ಹೋದರೂ ಅವನಿಗೆ ಅನುಕೂಲವೇ.<verse eid="PRO 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9"/>ದೋಷವನ್ನು ಮುಚ್ಚಿಡುವವನು ಪ್ರೇಮವನ್ನು ಸೆಳೆಯುವನು,</para>
  <para style="q2" vid="PRO 17:9">ಎತ್ತಿ ಆಡುತ್ತಿರುವವನು ಸ್ನೇಹವನ್ನು ಕಳೆದುಕೊಳ್ಳುವನು.<verse eid="PRO 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10"/>ಮಂದಮತಿಗೆ ನೂರು ಪೆಟ್ಟು ಹೊಡೆಯುವುದಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 17:10">ಗದರಿಕೆಯೇ ವಿವೇಕಿಗೆ ಹೆಚ್ಚಾದ ಶಿಕ್ಷೆ.<verse eid="PRO 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11"/>ದುರಾತ್ಮನಿಗೆ ದಂಗೆಯ ಮೇಲೆಯೇ ಮನಸ್ಸು,</para>
  <para style="q2" vid="PRO 17:11">ಕ್ರೂರದೂತನು ಅವನನ್ನು ಆಕ್ರಮಿಸುವನು.<verse eid="PRO 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12"/>ಮೂರ್ಖತನದಲ್ಲಿ ಮುಳುಗಿರುವ ಮೂಢನನ್ನು ಎದುರಾಗುವುದಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 17:12">ಮರಿಗಳನ್ನು ಕಳೆದುಕೊಂಡ ಕರಡಿಯನ್ನು ಎದುರಾಗುವುದು ಲೇಸು.<verse eid="PRO 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13"/>ಉಪಕಾರಕ್ಕೆ ಅಪಕಾರಮಾಡುವವನ ಮನೆಗೆ ಕೇಡು ತಪ್ಪದು.<verse eid="PRO 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14"/>ವ್ಯಾಜ್ಯದ ಆರಂಭವು ಏರಿಗೆ ಬಿಲಬಿದ್ದಂತೆ,</para>
  <para style="q2" vid="PRO 17:14">ಸಿಟ್ಟೇರುವುದಕ್ಕೆ ಮುಂಚೆ ಜಗಳವನ್ನು ಬಿಟ್ಟುಬಿಡು.<verse eid="PRO 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15"/>ದುಷ್ಟನನ್ನು ಶಿಷ್ಟನೆಂದು, ಶಿಷ್ಟನನ್ನು ದುಷ್ಟನೆಂದು</para>
  <para style="q2" vid="PRO 17:15">ನಿರ್ಣಯಿಸುವವರಿಬ್ಬರೂ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯರು.<verse eid="PRO 17:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16"/>ಜ್ಞಾನವನ್ನು ಕೊಳ್ಳಲು ಮೂಢನ ಕೈಯಲ್ಲಿ ಹಣವೇಕೆ?</para>
  <para style="q2" vid="PRO 17:16">ಅವನಿಗೆ ಬುದ್ಧಿಯೇ ಇಲ್ಲವಲ್ಲಾ.<verse eid="PRO 17:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17"/>ಮಿತ್ರನ ಪ್ರೀತಿಯು ನಿರಂತರ,</para>
  <para style="q2" vid="PRO 17:17">ಸಹೋದರನ ಜನ್ಮವು ಆಪತ್ತಿನಲ್ಲಿ ಸಾರ್ಥಕ.<verse eid="PRO 17:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18"/>ನೆರೆಯವನಿಗಾಗಿ ಪ್ರಮಾಣಮಾಡಿ ಹೊಣೆಯಾದವನು</para>
  <para style="q2" vid="PRO 17:18">ಬುದ್ಧಿಹೀನನೇ ಸರಿ.<verse eid="PRO 17:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19"/>ಪಾಪಪ್ರಿಯನು ಕಲಹಪ್ರಿಯ,</para>
  <para style="q2" vid="PRO 17:19">ಸೊಕ್ಕಿನಿಂದ ಮಾತನಾಡುವವನು ಕೇಡು ಬರಮಾಡಿಕೊಳ್ಳುವನು.<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fq" closed="false">ಸೊಕ್ಕಿನಿಂದ ಮಾತನಾಡುವವನು ಕೇಡು ಬರಮಾಡಿಕೊಳ್ಳುವನು. </char><char style="ft" closed="false">ಅಥವಾ ತನ್ನ ಬಾಗಿಲನ್ನು ಎತ್ತರಿಸುವವನು ಹಾಳಾಗುವನು.</char></note><verse eid="PRO 17:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20"/>ವಕ್ರ ಹೃದಯನು ಶುಭವನ್ನು ಪಡೆಯನು,</para>
  <para style="q2" vid="PRO 17:20">ಕೆಟ್ಟ ನಾಲಿಗೆಯವನು ವಿಪತ್ತಿಗೆ ಸಿಕ್ಕಿಬೀಳುವನು.<verse eid="PRO 17:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21"/>ಮೂರ್ಖನನ್ನು ಹೆತ್ತವರಿಗೆ ವ್ಯಥೆ,</para>
  <para style="q2" vid="PRO 17:21">ಮೂರ್ಖನ ತಂದೆಗೆ ವ್ಯಸನ.<verse eid="PRO 17:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22"/>ಹರ್ಷಹೃದಯವು ಒಳ್ಳೆಯ ಔಷಧ,</para>
  <para style="q2" vid="PRO 17:22">ಕುಗ್ಗಿದ ಮನದಿಂದ ಅನಾರೋಗ್ಯ.<verse eid="PRO 17:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23"/>ದುಷ್ಟನು ಲಂಚವನ್ನು ಗುಪ್ತವಾಗಿ ತೆಗೆದುಕೊಂಡು,</para>
  <para style="q2" vid="PRO 17:23">ನ್ಯಾಯವನ್ನು ತಪ್ಪಿಸುವನು.<verse eid="PRO 17:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24"/>ವಿವೇಕಿಗೆ ಜ್ಞಾನವೇ ಗುರಿಯಾಗಿರುವುದು,</para>
  <para style="q2" vid="PRO 17:24">ಮೂಢನ ದೃಷ್ಟಿಯು ದಿಗಂತಗಳಲ್ಲಿಯೂ ಅಲೆಯುವುದು.<verse eid="PRO 17:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25"/>ಜ್ಞಾನಹೀನನಾದ ಮಗನು ತಂದೆಗೆ ಕಿರಿಕಿರಿ,</para>
  <para style="q2" vid="PRO 17:25">ತಾಯಿಗೆ ಕರಕರೆ.<verse eid="PRO 17:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26"/>ಶಿಷ್ಟನಿಗೆ ದಂಡನೆ ಯುಕ್ತವಲ್ಲ,</para>
  <para style="q2" vid="PRO 17:26">ಧರ್ಮಿಷ್ಠನಿಗೆ ಪೆಟ್ಟು ಅಧರ್ಮ.<verse eid="PRO 17:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27"/>ಮಿತವಾಗಿ ಮಾತನಾಡುವವನು ಜ್ಞಾನಿ,</para>
  <para style="q2" vid="PRO 17:27">ಶಾಂತಾತ್ಮನು ವಿವೇಕಿ.<verse eid="PRO 17:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28"/>ಮೂಢನು ಕೂಡ ಸುಮ್ಮನಿದ್ದರೆ ಜ್ಞಾನಿಯೆಂತಲೂ,</para>
  <para style="q2" vid="PRO 17:28">ತುಟಿಗಳನ್ನು ಬಿಗಿಹಿಡಿದರೆ ವಿವೇಕಿಯೆಂತಲೂ ಅನ್ನಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1"/>ಜನರಲ್ಲಿ ಸೇರದವನು ಸ್ವೇಚ್ಛಾನುಸಾರ ನಡೆಯುತ್ತಾ,</para>
  <para style="q2" vid="PRO 18:1">ಸಮಸ್ತ ಸುಜ್ಞಾನಕ್ಕೂ ರೇಗುವನು.<verse eid="PRO 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2"/>ಮೂಢನಿಗೆ ವಿವೇಕವು ಅನಿಷ್ಟ;</para>
  <para style="q2" vid="PRO 18:2">ಸ್ವಭಾವವನ್ನು ಹೊರಪಡಿಸಿಕೊಳ್ಳುವುದೇ ಅವನಿಗಿಷ್ಟ.<verse eid="PRO 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3"/>ದುರಾಚಾರವಿದ್ದಲ್ಲಿ ತಾತ್ಸಾರ;</para>
  <para style="q2" vid="PRO 18:3">ಅವಮಾನವಿದ್ದಲ್ಲಿ ಧಿಕ್ಕಾರ.<verse eid="PRO 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4"/>ಸತ್ಪುರುಷನ ನುಡಿಯು ಆಳವಾದ ನೀರು,</para>
  <para style="q2" vid="PRO 18:4">ಜ್ಞಾನದ ಬುಗ್ಗೆ, ಹರಿಯುವ ತೊರೆ.<verse eid="PRO 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5"/>ದುಷ್ಟನಿಗೆ ಪ್ರಸನ್ನನಾಗಿ</para>
  <para style="q2" vid="PRO 18:5">ಶಿಷ್ಟನಿಗೆ ನ್ಯಾಯತಪ್ಪಿಸುವುದು ಅಧರ್ಮ.<verse eid="PRO 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6"/>ಜ್ಞಾನಹೀನನ ತುಟಿಗಳು ಜಗಳವನ್ನು ಉಂಟುಮಾಡುತ್ತವೆ,</para>
  <para style="q2" vid="PRO 18:6">ಅವನ ಬಾಯಿ ಪೆಟ್ಟುತಿನ್ನುವುದಕ್ಕೆ ಕೂಗಿಕೊಳ್ಳುತ್ತದೆ.<verse eid="PRO 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7"/>ಜ್ಞಾನಹೀನನಿಗೆ ಬಾಯಿ ನಾಶ,</para>
  <para style="q2" vid="PRO 18:7">ತುಟಿಗಳು ಪಾಶ.<verse eid="PRO 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8"/>ಚಾಡಿಕೋರನ ಮಾತುಗಳು ರುಚಿಯಾದ ತುತ್ತುಗಳು,</para>
  <para style="q2" vid="PRO 18:8">ಹೊಟ್ಟೆಯೊಳಕ್ಕೇ ಇಳಿಯುವವು.<verse eid="PRO 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9"/>ಕೆಲಸಗಳ್ಳನು ಕೆಡುಕನಿಗೆ ತಮ್ಮ.<verse eid="PRO 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10"/>ಯೆಹೋವನ ನಾಮವು ಬಲವಾದ ಬುರುಜು,</para>
  <para style="q2" vid="PRO 18:10">ಶಿಷ್ಟನು ಅದರೊಳಕ್ಕೆ ಓಡಿಹೋಗಿ ಭದ್ರವಾಗಿರುವನು.<verse eid="PRO 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11"/>ಧನವಂತನು ತನ್ನ ಐಶ್ವರ್ಯವನ್ನು ಬಲವಾದ ಕೋಟೆಯೆಂದು,</para>
  <para style="q2" vid="PRO 18:11">ಎತ್ತರವಾದ ಗೋಡೆಯೆಂದು ಭಾವಿಸಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12"/>ಭಂಗಕ್ಕೆ ಮೊದಲು ಗರ್ವದ ಹೃದಯ,</para>
  <para style="q2" vid="PRO 18:12">ಮಾನಕ್ಕೆ ಮುಂಚೆ ದೀನತೆ.<verse eid="PRO 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13"/>ಗಮನಿಸದೆ ಉತ್ತರಕೊಡುವವನು,</para>
  <para style="q2" vid="PRO 18:13">ಮೂರ್ಖನೆಂಬ ಅವಮಾನಕ್ಕೆ ಗುರಿಯಾಗುವನು.<verse eid="PRO 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14"/>ಆತ್ಮವು ವ್ಯಾಧಿಯನ್ನು ಸಹಿಸಬಲ್ಲದು,</para>
  <para style="q2" vid="PRO 18:14">ಆತ್ಮವೇ ನೊಂದರೆ ಸಹಿಸುವವರು ಯಾರು?<verse eid="PRO 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15"/>ವಿವೇಕಿಯ ಹೃದಯವು ತಿಳಿವಳಿಕೆಯನ್ನು ಸಂಪಾದಿಸುವುದು,</para>
  <para style="q2" vid="PRO 18:15">ಜ್ಞಾನಿಯ ಕಿವಿಯು ತಿಳಿವಳಿಕೆಯನ್ನು ಹುಡುಕುವುದು.<verse eid="PRO 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16"/>ಕಾಣಿಕೆಯು ಅನುಕೂಲತೆಗೂ,</para>
  <para style="q2" vid="PRO 18:16">ಶ್ರೀಮಂತರ ಸಾನ್ನಿಧ್ಯ ಪ್ರವೇಶಕ್ಕೂ ಸಾಧನ.<verse eid="PRO 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17"/>ಮೊದಲು ವಾದಿಸುವವನು ನ್ಯಾಯವಾದಿ ಎಂದು ತೋರುವನು,</para>
  <para style="q2" vid="PRO 18:17">ಪ್ರತಿವಾದಿ ಎದ್ದ ಮೇಲೆ ಅವನ ಪರೀಕ್ಷೆ ಆಗುವುದು.<verse eid="PRO 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18"/>ಚೀಟು ಹಾಕುವುದರಿಂದ ವ್ಯಾಜ್ಯಶಮನವೂ,</para>
  <para style="q2" vid="PRO 18:18">ಬಲಿಷ್ಠರ ನ್ಯಾಯಾನ್ಯಾಯಗಳ ವಿವೇಚನೆಯೂ ಆಗುವುದು.<verse eid="PRO 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19"/>ಬಲವಾದ ಪಟ್ಟಣವನ್ನು ಗೆಲ್ಲುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="PRO 18:19">ಅನ್ಯಾಯಹೊಂದಿದ ಸಹೋದರನನ್ನು ಗೆಲ್ಲುವುದು ಅಸಾಧ್ಯ,</para>
  <para style="q2" vid="PRO 18:19">ಕೋಟೆಯ ಅಗುಳಿಗಳಂತೆ ಜಗಳಗಳು ಜನರನ್ನು ಅಗಲಿಸುತ್ತವೆ.<verse eid="PRO 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20"/>ಮನುಷ್ಯನು ತನ್ನ ಬಾಯಿಯ ಬೆಳೆಯನ್ನು ಹೊಟ್ಟೆ ತುಂಬಾ ಉಣ್ಣುವನು,</para>
  <para style="q2" vid="PRO 18:20">ತನ್ನ ತುಟಿಗಳ ಫಲವನ್ನು ಸಾಕಷ್ಟು ತಿನ್ನುವನು.<verse eid="PRO 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21"/>ಜೀವ ಮತ್ತು ಮರಣಗಳು ನಾಲಿಗೆಯ ವಶ,</para>
  <para style="q2" vid="PRO 18:21">ವಚನಪ್ರಿಯರು ಅದರ ಫಲವನ್ನು ಅನುಭವಿಸುವರು,<verse eid="PRO 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22"/>ಪತ್ನಿಲಾಭವು ರತ್ನಲಾಭ,</para>
  <para style="q2" vid="PRO 18:22">ಅದು ಯೆಹೋವನ ಅನುಗ್ರಹವೇ.<verse eid="PRO 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23"/>ಬಡವನು ಬಿನ್ನೈಸುವನು,</para>
  <para style="q2" vid="PRO 18:23">ಬಲ್ಲಿದನು ಉತ್ತರವನ್ನು ಉಗ್ರವಾಗಿ ಕೊಡುವನು.<verse eid="PRO 18:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24"/>ಬಹಳ ಗೆಳೆಯರನ್ನು ಸೇರಿಸಿಕೊಂಡವನಿಗೆ ನಾಶನ,</para>
  <para style="q2" vid="PRO 18:24">ಸಹೋದರನಿಗಿಂತಲೂ ಹತ್ತಿರ ಹೊಂದಿಕೊಳ್ಳುವ ಮಿತ್ರನುಂಟು.<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1"/>ಕಪಟವಾಗಿ ಮಾತನಾಡುವ ಮೂಢನಿಗಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 19:1">ನಿರ್ದೋಷಿಯಾಗಿ ನಡೆಯುವ ದರಿದ್ರನೇ ಶ್ರೇಷ್ಠ.<verse eid="PRO 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2"/>ತಿಳಿವಳಿಕೆಯಿಲ್ಲದೆ ಕೋರುವುದು ಯುಕ್ತವಲ್ಲ,</para>
  <para style="q2" vid="PRO 19:2">ದುಡುಕುವ ಕಾಲು ದಾರಿತಪ್ಪುವುದು.<verse eid="PRO 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3"/>ಮನುಷ್ಯನು ಮೂರ್ಖತನದಿಂದ ತನ್ನ ಗತಿಯನ್ನು ಕೆಡಿಸಿಕೊಂಡು,</para>
  <para style="q2" vid="PRO 19:3">ಯೆಹೋವನ ಮೇಲೆ ಕುದಿಯುವನು.<verse eid="PRO 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4"/>ಭಾಗ್ಯವಂತನಿಗೆ ಬಹು ಮಂದಿ ಸ್ನೇಹಿತರು,</para>
  <para style="q2" vid="PRO 19:4">ಬಡವನಿಗೆ ಇದ್ದ ಸ್ನೇಹಿತನೂ ದೂರವಾಗುವನು.<verse eid="PRO 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5"/>ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಶಿಕ್ಷಿಸಲ್ಪಡದೆ ಇರುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 19:5">ಸುಳ್ಳಾಡುವವನು ತಪ್ಪಿಸಿಕೊಳ್ಳನು.<verse eid="PRO 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6"/>ಉದಾರಿಯ ಕಟಾಕ್ಷವನ್ನು ಅನೇಕರು ಕೋರುವರು,</para>
  <para style="q2" vid="PRO 19:6">ದಾನಶೂರನಿಗೆ ಪ್ರತಿಯೊಬ್ಬನೂ ಸ್ನೇಹಿತನಲ್ಲವೇ.<verse eid="PRO 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7"/>ಬಡವನನ್ನು ಬಂಧುಗಳೆಲ್ಲಾ ಹಗೆಮಾಡುವರು,</para>
  <para style="q2" vid="PRO 19:7">ಹೌದು, ಮಿತ್ರರೂ ಅವನಿಗೆ ದೂರವಾಗುವರು.</para>
  <para style="q2" vid="PRO 19:7">ಅವರ ಬರೀ ಮಾತುಗಳನ್ನು ನಂಬಿ ಹಿಂಬಾಲಿಸಿದರೆ ಏನೂ ಸಿಕ್ಕದು.<verse eid="PRO 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8"/>ಬುದ್ಧಿಯನ್ನು ಸಂಪಾದಿಸುವವನು ತನಗೆ ತಾನೇ ಮಿತ್ರನು,</para>
  <para style="q2" vid="PRO 19:8">ವಿವೇಕವನ್ನು ಕಾಪಾಡುವವನು ಮೇಲನ್ನು ಪಡೆಯುವನು.<verse eid="PRO 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9"/>ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಶಿಕ್ಷಿಸಲ್ಪಡದೆ ಇರುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 19:9">ಸುಳ್ಳಾಡುವವನು ಹಾಳಾಗುವನು.<verse eid="PRO 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10"/>ಮೂಢನಿಗೆ ಸುಖಭೋಗ ಜೀವನ ಯುಕ್ತವಲ್ಲ,</para>
  <para style="q2" vid="PRO 19:10">ದಾಸನಿಗೆ ದೊರೆಗಳ ಮೇಲಣ ದೊರೆತನ ಯುಕ್ತವಲ್ಲ.<verse eid="PRO 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11"/>ಮನುಷ್ಯನ ವಿವೇಕವು ಅವನ ಸಿಟ್ಟಿಗೆ ಅಡ್ಡಿ,</para>
  <para style="q2" vid="PRO 19:11">ಪರರ ದೋಷವನ್ನು ಲಕ್ಷಿಸದಿರುವುದು ಅವನಿಗೆ ಭೂಷಣ.<verse eid="PRO 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12"/>ರಾಜನ ರೋಷವು ಸಿಂಹದ ಗರ್ಜನೆ,</para>
  <para style="q2" vid="PRO 19:12">ಅವನ ದಯೆಯು ಪೈರಿನ ಇಬ್ಬನಿ.<verse eid="PRO 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13"/>ಜ್ಞಾನಹೀನನಾದ ಮಗನು ತಂದೆಗೆ ಹಾನಿ,</para>
  <para style="q2" vid="PRO 19:13">ಜಗಳವಾಡುವ ಹೆಂಡತಿಯು ತಟತಟನೆ ತೊಟ್ಟಿಕ್ಕುವ ಹನಿ.<verse eid="PRO 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14"/>ಮನೆಮಾರು, ಆಸ್ತಿಪಾಸ್ತಿಯು ಪೂರ್ವಿಕರಿಂದ ದೊರಕುವವು,</para>
  <para style="q2" vid="PRO 19:14">ವಿವೇಕಿನಿಯಾದ ಹೆಂಡತಿಯು ಯೆಹೋವನ ಅನುಗ್ರಹವೇ.<verse eid="PRO 19:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15"/>ಮೈಗಳ್ಳತನವು ಗಾಢನಿದ್ರೆಯಲ್ಲಿ ಮುಳುಗಿಸುವುದು,</para>
  <para style="q2" vid="PRO 19:15">ಸೋಮಾರಿಯು ಹಸಿವೆಗೊಳ್ಳುವನು.<verse eid="PRO 19:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16"/>ಆಜ್ಞೆಯನ್ನು ಪಾಲಿಸುವವನು ಆತ್ಮವನ್ನು ಪಾಲಿಸುವನು,</para>
  <para style="q2" vid="PRO 19:16">ನಡತೆಯನ್ನು ಲಕ್ಷಿಸದವನು ಸಾಯುವನು.<verse eid="PRO 19:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17"/>ಬಡವರಿಗೆ ದಯೆತೋರಿಸುವವನು ಯೆಹೋವನಿಗೆ ಸಾಲಕೊಡುವವನು,</para>
  <para style="q2" vid="PRO 19:17">ಆ ಉಪಕಾರಕ್ಕೆ ಯೆಹೋವನೇ ಪ್ರತ್ಯುಪಕಾರ ಮಾಡುವನು.<verse eid="PRO 19:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18"/>ಬುದ್ಧಿ ಬರುವುದೆಂಬ ನಿರೀಕ್ಷೆಯಿಂದ ಮಗನನ್ನು ಶಿಕ್ಷಿಸು,</para>
  <para style="q2" vid="PRO 19:18">ಹಾಳುಮಾಡಲು ಮನಸ್ಸು ಮಾಡಬೇಡ,<verse eid="PRO 19:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19"/>ಕೋಪಿಷ್ಠನು ತನಗಾಗುವ ದಂಡನೆಯನ್ನು ಅನುಭವಿಸಲಿ,</para>
  <para style="q2" vid="PRO 19:19">ಬಿಡಿಸಿದರೆ ಪ್ರತಿಬಾರಿಯೂ ಬಿಡಿಸಬೇಕಾಗುವುದು.<verse eid="PRO 19:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20"/>ಬುದ್ಧಿವಾದವನ್ನು ಕೇಳು, ಉಪದೇಶವನ್ನಾಲಿಸು,</para>
  <para style="q2" vid="PRO 19:20">ಮುಂದೆ ಜ್ಞಾನಿಯಾಗುವಿ.<verse eid="PRO 19:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21"/>ಮನುಷ್ಯನ ಮನಸ್ಸಿನಲ್ಲಿ ಅನೇಕ ಸಂಕಲ್ಪಗಳಿವೆ,</para>
  <para style="q2" vid="PRO 19:21">ಯೆಹೋವನ ಸಂಕಲ್ಪವೇ ಈಡೇರುವುದು.<verse eid="PRO 19:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">19:22 </char>
      <char style="ft" closed="false">ಅಥವಾ ಇಷ್ಟವು ಔದಾರ್ಯದ ಪ್ರಮಾಣ, ಇದ್ದರೂ ಇಲ್ಲವೆಂದು ಸುಳ್ಳಾಡುವವನಿಗಿಂತಲೂ, ಏನೂ ಇಲ್ಲದವನೇ ಲೇಸು. </char>
    </note>ಮನುಷ್ಯನು ತನ್ನ ಹೃದಯದಲ್ಲಿ ಬಯಸುವಂಥದ್ದು ನಿಷ್ಠೆಯಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 19:22">ಬಡವನಾಗಿರುವುದು ಉತ್ತಮ.<verse eid="PRO 19:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23"/>ಯೆಹೋವನ ಭಯವು ಜೀವದಾಯಕವು,</para>
  <para style="q2" vid="PRO 19:23">ಭಯಭಕ್ತಿಯುಳ್ಳವನು ತೃಪ್ತನಾಗಿ ನೆಲೆಗೊಳ್ಳುವನು,</para>
  <para style="q2" vid="PRO 19:23">ಅವನಿಗೆ ಕೇಡು ಸಂಭವಿಸದು.<verse eid="PRO 19:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24"/>ಮೈಗಳ್ಳನು ಪಾತ್ರೆಯೊಳಗೆ ಕೈ ಮುಳುಗಿಸಿದ ಮೇಲೆ,</para>
  <para style="q2" vid="PRO 19:24">ತಿರುಗಿ ಬಾಯಿಯ ಹತ್ತಿರಕ್ಕೆ ತರಲಾರನು.<verse eid="PRO 19:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25"/>ಧರ್ಮನಿಂದಕನಿಗೆ ಪೆಟ್ಟುಹೊಡೆ, ನೋಡಿದ ಅವಿವೇಕಿ ಜಾಣನಾಗುವನು,</para>
  <para style="q2" vid="PRO 19:25">ವಿವೇಕಿಯನ್ನು ಗದರಿಸು, ತಾನೇ ತಿಳಿವಳಿಕೆಯನ್ನು ಗ್ರಹಿಸುವನು.<verse eid="PRO 19:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26"/>ತಂದೆಯನ್ನು ಹೊಡೆದು, ತಾಯಿಯನ್ನು ಓಡಿಸುವ ಮಗನು,</para>
  <para style="q2" vid="PRO 19:26">ನಾಚಿಕೆಯನ್ನು ಮತ್ತು ಅವಮಾನವನ್ನು ಉಂಟುಮಾಡುವನು.<verse eid="PRO 19:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27"/>ಮಗನೇ, ಬುದ್ಧಿವಾದಗಳನ್ನು ಅನುಸರಿಸಲಿಕ್ಕೆ ಮನಸ್ಸಿಲ್ಲದಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 19:27">ಉಪದೇಶ ಕೇಳುವುದನ್ನೇ ಬಿಟ್ಟುಬಿಡು.<verse eid="PRO 19:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28"/>ನೀಚ ಸಾಕ್ಷಿಯು ನ್ಯಾಯವನ್ನು ಗೇಲಿಮಾಡುವನು,</para>
  <para style="q2" vid="PRO 19:28">ದುಷ್ಟರ ಬಾಯಿ ದ್ರೋಹವನ್ನು ಆತುರದಿಂದ ನುಂಗುವುದು.<verse eid="PRO 19:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29"/>ಧರ್ಮನಿಂದಕರಿಗೆ ದಂಡನೆಯ ತೀರ್ಪು ಸಿದ್ಧ,</para>
  <para style="q2" vid="PRO 19:29">ಮೂಢರ ಬೆನ್ನಿಗೆ ಪೆಟ್ಟು ಖಂಡಿತ.<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1"/>ದ್ರಾಕ್ಷಾರಸವು ಪರಿಹಾಸ್ಯ, ಮದ್ಯವು ಕೂಗಾಟ,</para>
  <para style="q2" vid="PRO 20:1">ಇವುಗಳಿಂದ ದಾರಿತಪ್ಪಿ ಹೋಗುವವನು ಜ್ಞಾನಿಯಲ್ಲ.<verse eid="PRO 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2"/>ರಾಜನು ಗರ್ಜಿಸುವ ಸಿಂಹದಂತೆ ಭಯಂಕರನು,</para>
  <para style="q2" vid="PRO 20:2">ಅವನನ್ನು ಕೆಣಕುವವನು ತನಗೇ ಕೆಡುಕುಮಾಡಿಕೊಳ್ಳುವನು.<verse eid="PRO 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3"/>ವ್ಯಾಜ್ಯಕ್ಕೆ ದೂರವಿರುವವನು ಮಾನಕ್ಕೆ ಯೋಗ್ಯನು,</para>
  <para style="q2" vid="PRO 20:3">ಜಗಳವು ಪ್ರತಿಯೊಬ್ಬ ಮೂರ್ಖನಿಗೂ ಸಹಜ.<verse eid="PRO 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4"/>ಮೈಗಳ್ಳನು ಮಳೆಗಾಲದಲ್ಲಿ ಉಳುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 20:4">ಸುಗ್ಗೀಕಾಲದಲ್ಲಿ ಅಪೇಕ್ಷಿಸಲು ಏನು ಸಿಕ್ಕೀತು?<verse eid="PRO 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5"/>ಮನುಷ್ಯನ ಹೃದಯಸಂಕಲ್ಪವು ಆಳವಾದ ಬಾವಿಯ ನೀರು.</para>
  <para style="q2" vid="PRO 20:5">ಆದರೆ ವಿವೇಕಿಯು ಅದನ್ನು ಸೇದಬಲ್ಲನು.<verse eid="PRO 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6"/>ಸ್ನೇಹಿತರೆಂದು ಹೇಳಿಕೊಳ್ಳುವವರು ಬಹಳ ಜನರು,</para>
  <para style="q2" vid="PRO 20:6">ನಂಬಿಗಸ್ತನಾದ ಸ್ನೇಹಿತನು ಎಲ್ಲಿ ಸಿಕ್ಕುವನು?<verse eid="PRO 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7"/>ಸದ್ಧರ್ಮಿಯು ನಿರ್ದೋಷವಾಗಿ ನಡೆಯುವನು,</para>
  <para style="q2" vid="PRO 20:7">ಅವನು ಗತಿಸಿದ ಮೇಲೆಯೂ ಅವನ ಮಕ್ಕಳು ಭಾಗ್ಯವಂತರು.<verse eid="PRO 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8"/>ರಾಜನು ನ್ಯಾಯಾಸನಾರೂಢನಾಗಿ,</para>
  <para style="q2" vid="PRO 20:8">ತನ್ನ ದೃಷ್ಟಿಯಿಂದ ಸಕಲ ಕೆಟ್ಟತನವನ್ನು ತೂರುವನು.<verse eid="PRO 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9"/>“ನನ್ನ ಹೃದಯವನ್ನು ಶುದ್ಧಿಮಾಡಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PRO 20:9">ನನ್ನ ಪಾಪವನ್ನು ತೊಳೆದುಕೊಂಡು ನಿರ್ಮಲನಾಗಿದ್ದೇನೆ” ಎಂದು ಯಾರು ಹೇಳಬಲ್ಲರು?<verse eid="PRO 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10"/>ತೂಕದ ಕಲ್ಲನ್ನೂ, ಅಳತೆಯ ಪಾತ್ರೆಯನ್ನೂ ಹೆಚ್ಚಿಸುವುದು,</para>
  <para style="q2" vid="PRO 20:10">ತಗ್ಗಿಸುವುದು ಇವೆರಡೂ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ.<verse eid="PRO 20:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11"/>ಒಬ್ಬ ಹುಡುಗನಾದರೂ ಶುದ್ಧವೂ, ಸತ್ಯವೂ ಆದ ನಡತೆಯಿಂದಲೇ,</para>
  <para style="q2" vid="PRO 20:11">ತನ್ನ ಗುಣವನ್ನು ತೋರ್ಪಡಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 20:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12"/>ಕೇಳುವ ಕಿವಿ, ನೋಡುವ ಕಣ್ಣು,</para>
  <para style="q2" vid="PRO 20:12">ಇವೆರಡನ್ನೂ ಯೆಹೋವನು ನಿರ್ಮಿಸಿದ್ದಾನೆ.<verse eid="PRO 20:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13"/>ನಿದ್ರಾನಿರತನಾಗಿರಬೇಡ! ಬಡವನಾದೀಯೆ,</para>
  <para style="q2" vid="PRO 20:13">ಕಣ್ಣು ತೆರೆ! ಆಹಾರದಿಂದ ತೃಪ್ತಿಗೊಳ್ಳುವಿ.<verse eid="PRO 20:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14"/>ಕೊಳ್ಳುವವನು, “ಚೆನ್ನಾಗಿಲ್ಲ, ಚೆನ್ನಾಗಿಲ್ಲ” ಎಂದು ಹೇಳುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 20:14">ಕೊಂಡುಕೊಂಡು ಹೋಗಿ ಹೆಚ್ಚಳಪಡುತ್ತಾನೆ.<verse eid="PRO 20:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15"/>ಹೊನ್ನು ಉಂಟು, ಹವಳದ ರಾಶಿ ಉಂಟು,</para>
  <para style="q2" vid="PRO 20:15">ಆದರೆ ಜ್ಞಾನದ ತುಟಿಗಳೇ ಅಮೂಲ್ಯವಾದ ಆಭರಣ.<verse eid="PRO 20:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16"/>ಮತ್ತೊಬ್ಬನಿಗೆ ಹೊಣೆಯಾದವನ ಬಟ್ಟೆಯನ್ನು ಕಿತ್ತುಕೋ,</para>
  <para style="q2" vid="PRO 20:16">ಮತ್ತೊಬ್ಬಳಿಗೆ ಹೊಣೆಯಾದವನನ್ನೇ ಒತ್ತೆ ಮಾಡಿಕೋ.<verse eid="PRO 20:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17"/>ಮೋಸದಿಂದ ಸಿಕ್ಕಿದ ಆಹಾರವು ಮನುಷ್ಯನಿಗೆ ರುಚಿ,</para>
  <para style="q2" vid="PRO 20:17">ಆ ಮೇಲೆ ಅವನ ಬಾಯಿ ಮರಳಿನಿಂದ ತುಂಬುವುದು.<verse eid="PRO 20:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18"/>ಉದ್ದೇಶಗಳು ಮಂತ್ರಾಲೋಚನೆಯಿಂದ ನೆರವೇರುವವು,</para>
  <para style="q2" vid="PRO 20:18">ಮಂತ್ರಾಲೋಚನೆಯಿಂದಲೇ ಯುದ್ಧವನ್ನು ನಡಿಸು.<verse eid="PRO 20:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19"/>ಚಾಡಿಕೋರನು ಗುಟ್ಟನ್ನು ರಟ್ಟು ಮಾಡುವನು,</para>
  <para style="q2" vid="PRO 20:19">ಆದುದರಿಂದ ತುಟಿ ಬಿಗಿಹಿಡಿಯದವನ ಗೊಡವೆಗೆ ಹೋಗಬೇಡ.<verse eid="PRO 20:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20"/>ತಂದೆಯನ್ನಾಗಲಿ ಅಥವಾ ತಾಯಿಯನ್ನಾಗಲಿ ಶಪಿಸುವವನ ದೀಪವು,</para>
  <para style="q2" vid="PRO 20:20">ಮಧ್ಯರಾತ್ರಿಯ ಅಂಧಕಾರದಲ್ಲಿ ಆರಿಹೋಗುವುದು.<verse eid="PRO 20:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21"/>ಮೊದಲು ಬೇಗನೆ ಬಾಚಿಕೊಂಡ ಸ್ವತ್ತು,</para>
  <para style="q2" vid="PRO 20:21">ಕೊನೆಯಲ್ಲಿ ಕಳೆದು ಹೋಗುವುದು.<verse eid="PRO 20:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22"/>ಕೇಡಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು ಅನ್ನಬೇಡ,</para>
  <para style="q2" vid="PRO 20:22">ಯೆಹೋವನನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿರು, ಆತನೇ ನಿನ್ನನ್ನು ಉದ್ಧರಿಸುವನು.<verse eid="PRO 20:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23"/>ತೂಕದ ಕಲ್ಲನ್ನು ಹೆಚ್ಚಿಸುವುದು, ತಗ್ಗಿಸುವುದು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 20:23">ಮೋಸದ ತಕ್ಕಡಿ ಒಳ್ಳೆಯದಲ್ಲ.<verse eid="PRO 20:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24"/>ಮನುಷ್ಯನಿಗೆ ಗತಿಯನ್ನು ಏರ್ಪಡಿಸುವವನು ಯೆಹೋವನೇ ಆಗಿರುವಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 20:24">ಮನುಷ್ಯನು ತನ್ನ ಮಾರ್ಗವನ್ನು ಹೇಗೆ ತಿಳಿದುಕೊಂಡಾನು?<verse eid="PRO 20:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25"/>“ಇದು ದೇವರಿಗಾಗಿ” ಎಂದು ದುಡುಕಿ ಹರಕೆಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 20:25">ಹರಕೆಯನ್ನು ಹೊತ್ತಮೇಲೆ ವಿಚಾರಮಾಡುವುದು ಮನುಷ್ಯನಿಗೆ ಉರುಲು.<verse eid="PRO 20:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26"/>ಜ್ಞಾನಿಯಾದ ಅರಸನು ದುಷ್ಟರ ಮೇಲೆ ಕಣದ ಗುಂಡನ್ನು ಉರುಳಿಸಿ,</para>
  <para style="q2" vid="PRO 20:26">ಅವರನ್ನು ತೂರಿಬಿಡುವನು.<verse eid="PRO 20:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27"/>ಮನುಷ್ಯನ ಆತ್ಮವು ಯೆಹೋವನ ದೀಪವಾಗಿದೆ,</para>
  <para style="q2" vid="PRO 20:27">ಅದು ಅಂತರಂಗವನ್ನೆಲ್ಲಾ ಶೋಧಿಸುತ್ತದೆ.<verse eid="PRO 20:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28"/>ರಾಜನ ಕೃಪಾಸತ್ಯತೆಗಳು ಅವನನ್ನು ಕಾಯುವವು,</para>
  <para style="q2" vid="PRO 20:28">ಅವನ ಕರುಣೆಯೇ ಅವನ ಸಿಂಹಾಸನಕ್ಕೆ ಆಧಾರ.<verse eid="PRO 20:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29"/>ಯುವಕರಿಗೆ ಬಲವು ಭೂಷಣ,</para>
  <para style="q2" vid="PRO 20:29">ಮುದುಕರಿಗೆ ನರೆಯು ಒಡವೆ.<verse eid="PRO 20:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30"/>ಗಾಯಮಾಡುವ ಪೆಟ್ಟುಗಳು ಕೆಟ್ಟದ್ದನ್ನು ತೊಳೆದುಬಿಡುವುದು,</para>
  <para style="q2" vid="PRO 20:30">ಏಟುಗಳು ಅಂತರಂಗವನ್ನು ಶುದ್ಧಿಮಾಡುವುದು.<verse eid="PRO 20:30"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1"/>ರಾಜನ ಸಂಕಲ್ಪಗಳು ಯೆಹೋವನ ಕೈಯಲ್ಲಿ ಇರುವ ನೀರಿನ ಕಾಲುವೆಗಳಂತೆ ಇವೆ,</para>
  <para style="q2" vid="PRO 21:1">ಆತನು ತನಗೆ ಬೇಕಾದ ಕಡೆಗೆ ಅದನ್ನು ತಿರುಗಿಸುತ್ತಾನೆ.<verse eid="PRO 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2"/>ನರನ ನಡತೆಯು ಸ್ವಂತ ದೃಷ್ಟಿಗೆ ಸರಿಯಾಗಿ ಕಾಣುತ್ತವೆ,</para>
  <para style="q2" vid="PRO 21:2">ಯೆಹೋವನು ಹೃದಯಗಳನ್ನೇ ಪರೀಕ್ಷಿಸುವನು.<verse eid="PRO 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3"/>ಯಜ್ಞಕ್ಕಿಂತಲೂ ನೀತಿನ್ಯಾಯಗಳು ಯೆಹೋವನಿಗೆ ಇಷ್ಟ.<verse eid="PRO 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4"/>ಗರ್ವದ ದೃಷ್ಟಿ, ಕೊಬ್ಬಿದ ಹೃದಯ, ದುಷ್ಟರ ಭಾಗ್ಯ,</para>
  <para style="q2" vid="PRO 21:4">ಇವು ಧರ್ಮವಿರುದ್ಧ.<verse eid="PRO 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5"/>ಶ್ರಮಶೀಲರಿಗೆ ತಮ್ಮ ಯತ್ನಗಳಿಂದ ಸಮೃದ್ಧಿ,</para>
  <para style="q2" vid="PRO 21:5">ಆತುರಪಡುವವರಿಗೆಲ್ಲಾ ಕೊರತೆಯೇ.<verse eid="PRO 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6"/>ಸುಳ್ಳಿನಿಂದ ಸಿಕ್ಕಿದ ಸಂಪತ್ತು ಹಬೆಯಂತೆ ಅಸ್ಥಿರ,</para>
  <para style="q2" vid="PRO 21:6">ಮೃತ್ಯುಪಾಶದಂತೆ ನಾಶಕರ.<verse eid="PRO 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7"/>ದುಷ್ಟರು ನ್ಯಾಯವನ್ನು ನಿರಾಕರಿಸುವ ಕಾರಣ,</para>
  <para style="q2" vid="PRO 21:7">ಅವರ ಬಲಾತ್ಕಾರವು ಅವರನ್ನೇ ಎಳೆದುಕೊಂಡು ಹೋಗುವುದು.<verse eid="PRO 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8"/>ದೋಷಿಯ ದಾರಿ ಡೊಂಕು;</para>
  <para style="q2" vid="PRO 21:8">ಶುದ್ಧನ ನಡತೆ ಸರಳ.<verse eid="PRO 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9"/>ಮನೆಯಲ್ಲಿ ಜಗಳಗಂಟಿಯ ಜೊತೆಯಲ್ಲಿರುವುದಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 21:9">ಮಾಳಿಗೆಯ ಒಂದು ಮೂಲೆಯಲ್ಲಿ ವಾಸಿಸುವುದೇ ಲೇಸು.<verse eid="PRO 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10"/>ದುರಾತ್ಮನು ಕೇಡಿನ ಮೇಲೇ ಮನಸ್ಸಿಡುವನು</para>
  <para style="q2" vid="PRO 21:10">ನೆರೆಯವನಿಗೂ ದಯೆತೋರಿಸನು.<verse eid="PRO 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11"/>ಧರ್ಮನಿಂದಕನಿಗೆ ದಂಡನೆಯಾದರೆ ನೋಡಿದ ಮೂಢನೂ ಜ್ಞಾನವನ್ನು ಪಡೆಯುವನು,</para>
  <para style="q2" vid="PRO 21:11">ಜ್ಞಾನಿಗೆ ಶಿಕ್ಷೆಯಾದರೆ ತಾನೇ ತಿಳಿವಳಿಕೆಯನ್ನು ಹೊಂದುವನು.<verse eid="PRO 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12"/>ನೀತಿಸ್ವರೂಪನು ಅಧರ್ಮಿಯ ಮನೆಯನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದು,</para>
  <para style="q2" vid="PRO 21:12">ಅಧರ್ಮಿಗಳನ್ನು ಕೆಡವಿ ಅವರನ್ನು ಕೇಡಿಗೆ ತಳ್ಳುವನು.<verse eid="PRO 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13"/>ಬಡವನ ಕೂಗಿಗೆ ಕಿವಿಮುಚ್ಚಿಕೊಳ್ಳುವವನು,</para>
  <para style="q2" vid="PRO 21:13">ತಾನೇ ಮೊರೆಯಿಡುವಾಗ ಯಾರೂ ಉತ್ತರಕೊಡರು.<verse eid="PRO 21:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14"/>ಗುಪ್ತ ಬಹುಮಾನವು ಕೋಪವನ್ನಾರಿಸುವುದು,</para>
  <para style="q2" vid="PRO 21:14">ಮಡಲಲ್ಲಿಟ್ಟ ಲಂಚವು ಕ್ರೋಧವನ್ನು ಅಣಗಿಸುವುದು.<verse eid="PRO 21:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15"/>ನ್ಯಾಯಮಾರ್ಗವು ಶಿಷ್ಟರಿಗೆ ಸಂತೋಷ,</para>
  <para style="q2" vid="PRO 21:15">ಕೆಡುಕರಿಗೆ ಕೇಡು.<verse eid="PRO 21:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16"/>ಜ್ಞಾನಮಾರ್ಗದಿಂದ ತಪ್ಪಿದವನಿಗೆ,</para>
  <para style="q2" vid="PRO 21:16">ಪ್ರೇತಸಮೂಹವೇ ವಿಶ್ರಾಂತಿಸ್ಥಾನ.<verse eid="PRO 21:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17"/>ಭೋಗಾಸಕ್ತನು ಕೊರತೆಪಡುವನು,</para>
  <para style="q2" vid="PRO 21:17">ದ್ರಾಕ್ಷಾರಸವನ್ನು ಮತ್ತು ಸುಗಂಧ ತೈಲವನ್ನು ಆಶಿಸುವವನು ನಿರ್ಭಾಗ್ಯನಾಗುವನು.<verse eid="PRO 21:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18"/>ಶಿಷ್ಟನಿಗೆ ಪ್ರತಿಯಾಗಿ ದುಷ್ಟನೂ,</para>
  <para style="q2" vid="PRO 21:18">ಸತ್ಯವಂತರಿಗೆ ಬದಲಾಗಿ ದ್ರೋಹಿಯೂ ದಂಡನೆಗೆ ಈಡಾಗುವರು.<verse eid="PRO 21:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19"/>ಕಾಡುವ ಜಗಳಗಂಟಿಯ ಸಹವಾಸಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 21:19">ಕಾಡಿನ ವಾಸವೇ ಲೇಸು.<verse eid="PRO 21:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20"/>ಜ್ಞಾನಿಯ ನಿವಾಸದಲ್ಲಿ ಎಣ್ಣೆಯು ಮತ್ತು ಶ್ರೇಷ್ಠ ಸಂಪತ್ತು ಇರುವವು,</para>
  <para style="q2" vid="PRO 21:20">ಜ್ಞಾನಹೀನನು ಇದ್ದದ್ದನ್ನೆಲ್ಲಾ ನುಂಗಿಬಿಡುವನು.<verse eid="PRO 21:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21"/>ನೀತಿ ಮತ್ತು ಕೃಪೆಗಳನ್ನು ಹುಡುಕುವವನು</para>
  <para style="q2" vid="PRO 21:21">ಜೀವ ಮತ್ತು ಕೀರ್ತಿಗಳನ್ನು ಪಡೆಯುವನು.<verse eid="PRO 21:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22"/>ಜ್ಞಾನಿಯು ಬಲಿಷ್ಠರ ಪಟ್ಟಣವನ್ನು ಮುತ್ತಿಗೆ ಹಾಕಿ,</para>
  <para style="q2" vid="PRO 21:22">ಅವರು ನಂಬಿದ್ದ ಬಲವಾದ ಕೋಟೆಯನ್ನು ಕೆಡವಿ ಹಾಕುವನು.<verse eid="PRO 21:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23"/>ತನ್ನ ಬಾಯನ್ನೂ, ನಾಲಿಗೆಯನ್ನೂ ಕಾಯುವವನು</para>
  <para style="q2" vid="PRO 21:23">ತೊಂದರೆಗಳಿಂದ ರಕ್ಷಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 21:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24"/>“ಧರ್ಮನಿಂದಕ” ಎನ್ನಿಸಿಕೊಳ್ಳುವವನು ಸೊಕ್ಕೇರಿದ ಅಹಂಕಾರಿಯಾಗಿ,</para>
  <para style="q2" vid="PRO 21:24">ಗರ್ವ ಮತ್ತು ಮದದಿಂದ ಪ್ರವರ್ತಿಸುವನು.<verse eid="PRO 21:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25"/>ಸೋಮಾರಿಯ ಆಶೆಯು ಅವನನ್ನು ಕೊಲ್ಲುವುದು,</para>
  <para style="q2" vid="PRO 21:25">ಅವನ ಕೈಗಳು ದುಡಿಯಲಾರವು.<verse eid="PRO 21:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26"/>ಧರ್ಮಿಯು ಹಿಂತೆಗೆಯದೆ ಕೊಡುವನು,</para>
  <para style="q2" vid="PRO 21:26">ಲೋಭಿಯು ದಿನವೆಲ್ಲಾ ಆಶಿಸುತ್ತಲೇ ಇರುವನು.<verse eid="PRO 21:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27"/>ದುಷ್ಟರ ಯಜ್ಞವೇ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 21:27">ಅದನ್ನು ದುರ್ಬುದ್ಧಿಯಿಂದ ಅರ್ಪಿಸುವುದು ಮತ್ತೂ ಅಸಹ್ಯ.<verse eid="PRO 21:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28"/>ಸುಳ್ಳು ಸಾಕ್ಷಿಯು ಅಳಿದುಹೋಗುವುದು,</para>
  <para style="q2" vid="PRO 21:28">ಕೇಳಿದ್ದನ್ನೇ ಹೇಳುವವನ ಸಾಕ್ಷಿಯು ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="PRO 21:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29"/>ದುಷ್ಟನ ಮುಖದಲ್ಲಿ ಲಜ್ಜೆಯಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 21:29">ಸತ್ಯವಂತನು ತನ್ನ ನಡತೆಯನ್ನು ಸರಿಪಡಿಸಿಕೊಳ್ಳುತ್ತಿರುವನು.<verse eid="PRO 21:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30"/>ಯಾವ ಜ್ಞಾನವೂ, ಯಾವ ವಿವೇಕವೂ,</para>
  <para style="q2" vid="PRO 21:30">ಯಾವ ಆಲೋಚನೆಯೂ ಯೆಹೋವನೆದುರಿಗೆ ನಿಲ್ಲುವುದಿಲ್ಲ.<verse eid="PRO 21:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31"/>ಅಶ್ವಬಲವು ಯುದ್ಧದಿನಕ್ಕಾಗಿ ಸನ್ನದ್ಧವಾಗಿದ್ದರೂ</para>
  <para style="q2" vid="PRO 21:31">ಜಯವು ಯೆಹೋವನಿಂದಲೇ.<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1"/>ಬಹುಧನಕ್ಕಿಂತಲೂ ಒಳ್ಳೆಯ ಹೆಸರು ಉತ್ತಮ,</para>
  <para style="q2" vid="PRO 22:1">ಬೆಳ್ಳಿ, ಬಂಗಾರಕ್ಕಿಂತಲೂ ಸತ್ಕೀರ್ತಿಯು ಅಮೂಲ್ಯ.<verse eid="PRO 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2"/>ಬಡವರು ಮತ್ತು ಸಿರಿವಂತರು ಸ್ಥಿತಿಯಲ್ಲಿ ಎದುರುಬದುರಾಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PRO 22:2">ಯೆಹೋವನೇ ಅವರನ್ನೆಲ್ಲಾ ಸೃಷ್ಟಿಸಿದನು.<verse eid="PRO 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3"/>ಜಾಣನು ಕೇಡನ್ನು ಕಂಡು ಅಡಗಿಕೊಳ್ಳುವನು,</para>
  <para style="q2" vid="PRO 22:3">ಬುದ್ಧಿಹೀನನು ಮುಂದೆ ಹೋಗಿ ನಷ್ಟಪಡುವನು.<verse eid="PRO 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4"/>ಧನ, ಮಾನ ಮತ್ತು ಜೀವಗಳು</para>
  <para style="q2" vid="PRO 22:4">ದೀನಭಾವಕ್ಕೂ, ಯೆಹೋವನ ಭಯಕ್ಕೂ ಫಲ.<verse eid="PRO 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5"/>ವಕ್ರಬುದ್ಧಿಯುಳ್ಳವನ ಮಾರ್ಗದಲ್ಲಿ ಮುಳ್ಳುಗಳೂ, ಉರುಲುಗಳೂ ತುಂಬಿವೆ,</para>
  <para style="q2" vid="PRO 22:5">ತನ್ನನ್ನು ರಕ್ಷಿಸಿಕೊಳ್ಳುವವನು ಅವುಗಳಿಗೆ ದೂರವಾಗಿರುವನು.<verse eid="PRO 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6"/>ನಡೆಯಬೇಕಾದ ಮಾರ್ಗಕ್ಕೆ ತಕ್ಕಂತೆ ಮಕ್ಕಳನ್ನು ಶಿಕ್ಷಿಸು,</para>
  <para style="q2" vid="PRO 22:6">ಮುಪ್ಪಿನಲ್ಲಿಯೂ ಓರೆಯಾಗರು.<verse eid="PRO 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7"/>ಬಲ್ಲಿದನು ಬಡವನಿಗೆ ಒಡೆಯ,</para>
  <para style="q2" vid="PRO 22:7">ಸಾಲಗಾರನು ಸಾಲಕೊಟ್ಟವನಿಗೆ ಸೇವಕ.<verse eid="PRO 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8"/>ಕೆಟ್ಟತನವನ್ನು ಬಿತ್ತುವವನು ಕೇಡನ್ನೇ ಕೊಯ್ಯುವನು,</para>
  <para style="q2" vid="PRO 22:8">ಹೆಮ್ಮೆಯಿಂದ ಹಿಡಿದ ದಂಡವು ಅವನ ಕೈಯಿಂದ ಬಿದ್ದುಹೋಗುವುದು.<verse eid="PRO 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9"/>ದಯಾದೃಷ್ಟಿಯವನು ಆಶೀರ್ವಾದವನ್ನು ಪಡೆಯುವನು,</para>
  <para style="q2" vid="PRO 22:9">ತನ್ನ ಆಹಾರವನ್ನು ಬಡವರಿಗೆ ಕೊಡುತ್ತಾನಲ್ಲವೆ.<verse eid="PRO 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10"/>ಧರ್ಮನಿಂದಕನನ್ನು ಓಡಿಸಿಬಿಟ್ಟರೆ ಜಗಳವು ತೊಲಗುವುದು,</para>
  <para style="q2" vid="PRO 22:10">ಹೌದು, ವ್ಯಾಜ್ಯವು ತೀರಿ ಅವಮಾನವು ಇಲ್ಲವಾಗುವುದು.<verse eid="PRO 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11"/>ಹೃದಯಶುದ್ಧಿಯನ್ನು ಅಪೇಕ್ಷಿಸುವ ಮತ್ತು ಸವಿಮಾತನಾಡುವ ಮನುಷ್ಯನಿಗೆ</para>
  <para style="q2" vid="PRO 22:11">ರಾಜನ ಸ್ನೇಹವು ದೊರೆಯುವುದು.<verse eid="PRO 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12"/>ಯೆಹೋವನ ಕಣ್ಣು ತಿಳಿವಳಿಕೆಗೆ ಕಾವಲು,</para>
  <para style="q2" vid="PRO 22:12">ಆತನು ವಂಚಕನ ಮಾತುಗಳನ್ನು ಕೆಡವಿಬಿಡುವನು.<verse eid="PRO 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13"/>“ಹೊರಗೆ ಸಿಂಹವಿದೆ, ನನ್ನನ್ನು ಬೀದಿಯಲ್ಲಿ ಕೊಂದ್ದಿತು”</para>
  <para style="q2" vid="PRO 22:13">ಎಂಬುದು ಸೋಮಾರಿಯ ನೆವ.<verse eid="PRO 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14"/>ಜಾರಸ್ತ್ರೀಯ ಬಾಯಿ ಆಳವಾದ ಹಳ್ಳ,</para>
  <para style="q2" vid="PRO 22:14">ಯೆಹೋವನಿಗೆ ಸಿಟ್ಟನ್ನೆಬ್ಬಿಸಿದವನು ಅದರಲ್ಲಿ ಬೀಳುವನು.<verse eid="PRO 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15"/>ಮೂರ್ಖತನವು ಮಕ್ಕಳ ಮನಸ್ಸಿಗೆ ಸಹಜ,</para>
  <para style="q2" vid="PRO 22:15">ಆದರೆ ಶಿಕ್ಷಕನ ಬೆತ್ತವು ಅದನ್ನು ತೊಲಗಿಸುವುದು.<verse eid="PRO 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16"/>ಸ್ವಂತ ಲಾಭಕ್ಕಾಗಿ ಬಡವರನ್ನು ಹಿಂಸಿಸುವವನಿಗೂ,</para>
  <para style="q2" vid="PRO 22:16">ಸಿರಿವಂತರಿಗೆ ಲಂಚಕೊಡುವವನಿಗೂ ಕೊರತೆಯೇ ಗತಿ.<verse eid="PRO 22:16"/></para>
  <para style="s">ಜ್ಞಾನಿಗಳ ಮಾತುಗಳು</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17"/>ಕಿವಿಗೊಟ್ಟು ಜ್ಞಾನಿಗಳ ಮಾತುಗಳನ್ನು ಕೇಳು,</para>
  <para style="q2" vid="PRO 22:17">ನನ್ನ ಜ್ಞಾನಬೋಧೆಗೆ ಮನಸ್ಸು ಕೊಡು.<verse eid="PRO 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18"/>ನೀನು ಆ ಮಾತುಗಳನ್ನು ಅಂತರಂಗದಲ್ಲಿ ಕಾಪಾಡುತ್ತಾ,</para>
  <para style="q2" vid="PRO 22:18">ತುಟಿಗಳಲ್ಲಿ ಸಿದ್ಧಪಡಿಸಿಕೊಂಡಿದ್ದರೆ ಎಷ್ಟೋ ರಮ್ಯ.<verse eid="PRO 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19"/>ನೀನು ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡಬೇಕೆಂದು,</para>
  <para style="q2" vid="PRO 22:19">ಅವುಗಳನ್ನು ಈ ದಿನ ನಿನಗೇ ತಿಳಿಯಪಡಿಸಿದ್ದೇನೆ.<verse eid="PRO 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20"/>ಸತ್ಯವಚನಗಳು ಎಷ್ಟೋ ಯಥಾರ್ಥವೆಂದು ನೀನು ತಿಳಿದುಕೊಂಡು,</para>
  <para style="q2" vid="PRO 22:20">ನಿನ್ನನ್ನು ಕಳುಹಿಸಿದವರಿಗೆ ಸತ್ಯವಚನಗಳನ್ನೇ ಅರಿಕೆ ಮಾಡುವಂತೆ,<verse eid="PRO 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21"/>ಸತ್ಯ, ತಿಳಿವಳಿಕೆಯ ವಿಷಯವಾಗಿ</para>
  <para style="q2" vid="PRO 22:21">ಇದಕ್ಕೆ ಮೊದಲೇ ನಿನಗಾಗಿ ಬರೆದಿರುವೆನಲ್ಲಾ.<verse eid="PRO 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22"/>ಬಡವರಿಗೆ ದಿಕ್ಕಿಲ್ಲವೆಂದು ತಿಳಿದು ಅವರನ್ನು ಸೂರೆ ಮಾಡಬೇಡ,</para>
  <para style="q2" vid="PRO 22:22">ನ್ಯಾಯಸ್ಥಾನದಲ್ಲಿ ದರಿದ್ರರನ್ನು ತುಳಿಯಬೇಡ.<verse eid="PRO 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23"/>ಯೆಹೋವನೇ ಅವರ ವ್ಯಾಜ್ಯವನ್ನು ನಡೆಸಿ,</para>
  <para style="q2" vid="PRO 22:23">ಹಾಳುಮಾಡಿದವರ ಜೀವವನ್ನು ಹಾಳುಮಾಡುವನು.<verse eid="PRO 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24"/>ಕೋಪಿಷ್ಠನ ಸಂಗಡ ಸ್ನೇಹ ಬೆಳಸಬೇಡ,</para>
  <para style="q2" vid="PRO 22:24">ಸಿಟ್ಟುಗಾರನ ಸಹವಾಸ ಮಾಡಬೇಡ.<verse eid="PRO 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25"/>ಮಾಡಿದರೆ ಅವನ ದುರ್ನಡತೆಯನ್ನು ಅನುಸರಿಸಿ,</para>
  <para style="q2" vid="PRO 22:25">ನಿನ್ನ ಆತ್ಮವನ್ನು ಉರುಲಿಗೆ ಸಿಕ್ಕಿಸಿಕೊಳ್ಳುವಿ ನೋಡಿಕೋ.<verse eid="PRO 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26"/>ಮಾತುಕೊಟ್ಟು ಸಾಲಕ್ಕೆ ಹೊಣೆಯಾಗುವವರಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 22:26">ನೀನೂ ಒಬ್ಬನಾಗಬೇಡ,<verse eid="PRO 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27"/>ಆ ಸಾಲವನ್ನು ತೀರಿಸುವುದಕ್ಕೆ ನಿನ್ನಿಂದಾಗದಿರಲು,</para>
  <para style="q2" vid="PRO 22:27">ಸಾಲಕೊಟ್ಟವನು ನಿನ್ನ ಕೆಳಗಿನ ಹಾಸಿಗೆಯನ್ನು ಕಿತ್ತುಹಾಕುವುದು ಬೇಕೇ?<verse eid="PRO 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28"/>ನಿನ್ನ ಪೂರ್ವಿಕರು ಹಾಕಿದ ಪೂರ್ವಕಾಲದ ಮೇರೆಯನ್ನು ದಾಟಬೇಡ.<verse eid="PRO 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29"/>ತನ್ನ ಕೆಲಸದಲ್ಲಿ ಚಾತುರ್ಯವುಳ್ಳವನನ್ನು ನೋಡು,</para>
  <para style="q2" vid="PRO 22:29">ಇಂಥವನು ರಾಜನ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಿಲ್ಲುವನೇ ಹೊರತು,</para>
  <para style="q2" vid="PRO 22:29">ಸಾಮಾನ್ಯ ಜನರ ಮುಂದೆ ಅಲ್ಲ.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1"/>ನೀನು ಅಧಿಪತಿಯ ಸಂಗಡ ಊಟಕ್ಕೆ ಕುಳಿತುಕೊಂಡಿರುವಾಗ,</para>
  <para style="q2" vid="PRO 23:1">ನಿನ್ನ ಮುಂದಿಟ್ಟಿರುವುದರ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆಯಾಗಿರು.<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="fq" closed="false">ನಿನ್ನ ಮುಂದಿಟ್ಟಿರುವುದರ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆಯಾಗಿರು. </char><char style="ft" closed="false">ಅಥವಾ ಯಾರ ಸನ್ನಿಧಾನದಲ್ಲಿ ಇದ್ದೀ ಎಂಬುದನ್ನು ಮರೆಯದಿರು ಅಥವಾ ಯಾರ ಮುಂದಿರುವೆ ಎಂಬುದನ್ನು ಮರೆಯದಿರು. </char></note><verse eid="PRO 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2"/>ನೀನು ಹೊಟ್ಟೆಬಾಕನಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 23:2">ನಿನ್ನ ಗಂಟಲಿಗೆ ಕತ್ತಿಹಾಕಿಕೋ.<verse eid="PRO 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3"/>ಅವನ ರುಚಿಪದಾರ್ಥಗಳನ್ನು ಬಯಸಬೇಡ,</para>
  <para style="q2" vid="PRO 23:3">ಅದು ಮೋಸದ ಆಹಾರವೇ ಸರಿ.<verse eid="PRO 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4"/>ದುಡ್ಡಿನಾಶೆಯಿಂದ ದುಡಿಯಬೇಡ,</para>
  <para style="q2" vid="PRO 23:4">ಸ್ವಬುದ್ಧಿಯನ್ನೇ ಆಶ್ರಯಿಸಬೇಡ.<verse eid="PRO 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5"/>ನಿನ್ನ ದೃಷ್ಟಿಯು ಐಶ್ವರ್ಯದ ಮೇಲೆ ಎರಗುತ್ತದೋ?</para>
  <para style="q2" vid="PRO 23:5">ಐಶ್ವರ್ಯವು ಅಷ್ಟರೊಳಗೆ ಮಾಯವಾಗುವುದು,</para>
  <para style="q" vid="PRO 23:5">ಆಕಾಶದ ಕಡೆಗೆ ಹಾರುವ ಹದ್ದಿನಂತೆ,</para>
  <para style="q2" vid="PRO 23:5">ಅದು ರೆಕ್ಕೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡಿದೆ.<verse eid="PRO 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6"/>ಲೋಭಿಯ ಅನ್ನವನ್ನು ಉಣ್ಣದಿರು,</para>
  <para style="q2" vid="PRO 23:6">ಅವನ ರುಚಿಪದಾರ್ಥಗಳನ್ನು ಬಯಸಬೇಡ.<verse eid="PRO 23:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7"/>ಅವನು ತನ್ನ ಒಳಗಿನ ಯೋಚನೆಯಂತೆಯೇ ಇದ್ದಾನೆ,</para>
  <para style="q2" vid="PRO 23:7">ಉಣ್ಣು, ಕುಡಿ ಎಂದು ಹೇಳಿದರೂ ನಿನ್ನಲ್ಲಿ ಅವನಿಗೆ ಪ್ರೀತಿಯಿಲ್ಲ.<verse eid="PRO 23:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8"/>ನೀನು ತಿಂದ ತುತ್ತನ್ನು ಕಕ್ಕಿಬಿಡುವಿ,</para>
  <para style="q2" vid="PRO 23:8">ನಿನ್ನ ಸವಿಮಾತುಗಳು ವ್ಯರ್ಥ.<verse eid="PRO 23:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9"/>ಮೂಢನ ಸಂಗಡ ಮಾತನಾಡಬೇಡ,</para>
  <para style="q2" vid="PRO 23:9">ನಿನ್ನ ಮಾತುಗಳ ವಿವೇಕವನ್ನು ತಿರಸ್ಕರಿಸುವನು.<verse eid="PRO 23:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10"/>ಪೂರ್ವಕಾಲದ ಮೇರೆಯನ್ನು ತೆಗೆದುಹಾಕಬೇಡ,</para>
  <para style="q2" vid="PRO 23:10">ಅನಾಥರ ಹೊಲಗಳಲ್ಲಿ ನುಗ್ಗಬೇಡ.<verse eid="PRO 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11"/>ಅವರ ರಕ್ಷಕನು ಬಲಶಾಲಿಯಾಗಿದ್ದಾನೆ,</para>
  <para style="q2" vid="PRO 23:11">ಅವರಿಗಾಗಿ ನಿನ್ನ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡುವನು.<verse eid="PRO 23:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12"/>ಉಪದೇಶವನ್ನು ಮನಸ್ಸಿಗೆ ತೆಗೆದುಕೋ,</para>
  <para style="q2" vid="PRO 23:12">ತಿಳಿವಳಿಕೆಯ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡು.<verse eid="PRO 23:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13"/>ಹುಡುಗನ ಶಿಕ್ಷೆಗೆ ಹಿಂತೆಗೆಯಬೇಡ,</para>
  <para style="q2" vid="PRO 23:13">ಅವನು ಬೆತ್ತದ ಏಟಿಗೆ ಸಾಯನು.<verse eid="PRO 23:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14"/>ಬೆತ್ತದಿಂದ ಹೊಡೆ,</para>
  <para style="q2" vid="PRO 23:14">ಅವನ ಆತ್ಮವನ್ನು ಪಾತಾಳಕ್ಕೆ ಬೀಳದಂತೆ ಕಾಪಾಡು.<verse eid="PRO 23:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15"/>ಕಂದಾ, ನಿನ್ನ ಮನಸ್ಸಿಗೆ ಜ್ಞಾನವುಂಟಾದರೆ</para>
  <para style="q2" vid="PRO 23:15">ನನ್ನ ಮನಸ್ಸಿಗೂ ಉಲ್ಲಾಸವಾಗುವುದು.<verse eid="PRO 23:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16"/>ಹೌದು, ನಿನ್ನ ತುಟಿಗಳು ನೀತಿಯ ನುಡಿಗಳನ್ನಾಡಿದರೆ</para>
  <para style="q2" vid="PRO 23:16">ನನ್ನ ಅಂತರಾತ್ಮವು ಹಿಗ್ಗುವುದು.<verse eid="PRO 23:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17"/>ಪಾಪಿಗಳನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ,</para>
  <para style="q2" vid="PRO 23:17">ಯೆಹೋವನಲ್ಲಿ ನಿರಂತರವಾಗಿ ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿರು.<verse eid="PRO 23:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18"/>ಒಂದು ಕಾಲ ಉಂಟು,</para>
  <para style="q2" vid="PRO 23:18">ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗದು.<verse eid="PRO 23:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19"/>ಕಂದಾ, ಕೇಳು, ಜ್ಞಾನವಂತನಾಗಿರು,</para>
  <para style="q2" vid="PRO 23:19">ನಿನ್ನ ಮನಸ್ಸನ್ನು ಜ್ಞಾನದ ಮಾರ್ಗದಲ್ಲಿ ಮುಂದೆ ನಡೆಯಿಸು.<verse eid="PRO 23:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20"/>ಕುಡುಕರಲ್ಲಿಯೂ,</para>
  <para style="q2" vid="PRO 23:20">ಅತಿಮಾಂಸಭಕ್ಷಕರಲ್ಲಿಯೂ ಸೇರದಿರು.<verse eid="PRO 23:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21"/>ಕುಡುಕರು, ಹೊಟ್ಟೆಬಾಕರು ದುರ್ಗತಿಗೆ ಬರುವರು,</para>
  <para style="q2" vid="PRO 23:21">ನಿದ್ರಾಸಕ್ತಿಯು ಹರಕು ಬಟ್ಟೆಗಳನ್ನು ಹೊದಿಸುವುದು.<verse eid="PRO 23:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22"/>ಹೆತ್ತ ತಂದೆಯ ಮಾತಿಗೆ ಕಿವಿಗೊಡು,</para>
  <para style="q2" vid="PRO 23:22">ಮುಪ್ಪಿನಲ್ಲಿಯೂ ತಾಯಿಯನ್ನು ಅಸಡ್ಡೆಮಾಡಬೇಡ.<verse eid="PRO 23:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23"/>ಸತ್ಯವನ್ನು ಎಂದರೆ ಜ್ಞಾನ, ಸುಶಿಕ್ಷೆ, ವಿವೇಕಗಳನ್ನು ಕೊಂಡುಕೋ,</para>
  <para style="q2" vid="PRO 23:23">ಮಾರಿ ಬಿಡಬೇಡ.<verse eid="PRO 23:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24"/>ಧರ್ಮಿಯ ತಂದೆಯು ಅತಿ ಸಂತೋಷಪಡುವನು,</para>
  <para style="q2" vid="PRO 23:24">ಜ್ಞಾನಿಯನ್ನು ಹೆತ್ತವನು ಅವನಲ್ಲಿ ಆನಂದಿಸುವನು.<verse eid="PRO 23:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25"/>ನಿನ್ನ ತಂದೆತಾಯಿಗಳು ಉಲ್ಲಾಸಗೊಳ್ಳಲಿ,</para>
  <para style="q2" vid="PRO 23:25">ನಿನ್ನನ್ನು ಹೆತ್ತವಳು ಆನಂದಪಡಲಿ.<verse eid="PRO 23:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26"/>ಕಂದಾ, ನಿನ್ನ ಹೃದಯವನ್ನು ನನಗೆ ಕೊಡು,</para>
  <para style="q2" vid="PRO 23:26">ನಿನ್ನ ಕಣ್ಣುಗಳು ನನ್ನ ಮಾರ್ಗಗಳಲ್ಲಿ ಆನಂದಿಸಲಿ.<verse eid="PRO 23:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27"/>ಸೂಳೆಯು ಆಳವಾದ ಹಳ್ಳ,</para>
  <para style="q2" vid="PRO 23:27">ಜಾರಸ್ತ್ರೀಯು ಇಕ್ಕಟ್ಟಾದ ಗುಂಡಿ.<verse eid="PRO 23:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28"/>ಹೌದು, ಕಳ್ಳನಂತೆ ಹೊಂಚುಹಾಕುತ್ತಾಳೆ,</para>
  <para style="q2" vid="PRO 23:28">ಜನರಲ್ಲಿ ದ್ರೋಹಿಗಳನ್ನು ಹೆಚ್ಚಿಸುತ್ತಾಳೆ.<verse eid="PRO 23:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29"/>ಅಯ್ಯಯ್ಯೋ ಅನ್ನುವವರು ಯಾರು?</para>
  <para style="q2" vid="PRO 23:29">ಅಕಟಾ ಎಂದು ಕೂಗಿಕೊಳ್ಳುವವರು ಯಾರು?</para>
  <para style="q" vid="PRO 23:29">ಯಾರು ಜಗಳವಾಡುತ್ತಾರೆ? ಯಾರು ಗೋಳಾಡುತ್ತಾರೆ?</para>
  <para style="q2" vid="PRO 23:29">ಯಾರು ಸುಮ್ಮಸುಮ್ಮನೆ ಗಾಯಪಡುತ್ತಾರೆ?</para>
  <para style="q" vid="PRO 23:29">ಕೆಂಪೇರಿದ ಕಣ್ಣುಳ್ಳವರು ಯಾರು?<verse eid="PRO 23:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30"/>ಅವರು ಮಿಶ್ರಮದ್ಯಪಾನಾಸಕ್ತರಾಗಿ,</para>
  <para style="q2" vid="PRO 23:30">ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುತ್ತಾ, ಕಾಲಹರಣಮಾಡುವವರೇ.<verse eid="PRO 23:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31"/>ಪಾತ್ರೆಯಲ್ಲಿ ಕೆಂಪಗೆ ಥಳಥಳಿಸುವ</para>
  <para style="q2" vid="PRO 23:31">ದ್ರಾಕ್ಷಾರಸದ ಮೇಲೆ ಕಣ್ಣಿಡಬೇಡ.</para>
  <para style="q2" vid="PRO 23:31">ಅದು ಗಂಟಲಿನೊಳಗೆ ಮೆಲ್ಲಗೆ ಇಳಿದುಹೋಗಿ<verse eid="PRO 23:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32"/>ಆಮೇಲೆ ಹಾವಿನಂತೆ ಕಚ್ಚುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 23:32">ಹೌದು, ನಾಗರ ಹಾವಿನ ಹಾಗೆ ಕಡಿಯುತ್ತದೆ.<verse eid="PRO 23:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33"/>ನಿನ್ನ ಕಣ್ಣು ಇಲ್ಲದ್ದನ್ನೇ ಕಾಣುವುದು,</para>
  <para style="q2" vid="PRO 23:33">ಮನಸ್ಸು ವಿಪರೀತಗಳನ್ನು ಹೊರಪಡಿಸುವುದು.<verse eid="PRO 23:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34"/>ನೀನು ಸಮುದ್ರದ ನಡುವೆಯಾಗಲಿ,</para>
  <para style="q2" vid="PRO 23:34">ಹಡಗಿನ ಕಂಬದ ತುದಿಯಲ್ಲಿಯಾಗಲಿ ಮಲಗಿರುವವನಂತೆ ಇರುವಿ.<verse eid="PRO 23:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35"/>ಜನರು ನನ್ನನ್ನು ಹೊಡೆದರೂ ನೋವಾಗಲಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 23:35">ಬಡಿದರೂ ತಿಳಿಯಲಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 23:35">ಯಾವಾಗ ಎಚ್ಚೆತ್ತೇನು? ಪುನಃ ಅದನ್ನೇ ಹುಡುಕೇನು ಎಂದುಕೊಳ್ಳುವಿ.<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1"/>ಕೆಟ್ಟವರನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ,</para>
  <para style="q2" vid="PRO 24:1">ಅವರ ಸಹವಾಸವನ್ನು ಬಯಸಬೇಡ.<verse eid="PRO 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2"/>ಅವರ ಮನಸ್ಸು ಹಿಂಸೆಯನ್ನು ಯೋಚಿಸುತ್ತಿರುವುದು,</para>
  <para style="q2" vid="PRO 24:2">ಅವರ ತುಟಿಯು ಹಾನಿಯನ್ನು ಪ್ರಸ್ತಾಪಿಸುತ್ತಿರುವುದು.<verse eid="PRO 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3"/>ಮನೆಯನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ ಜ್ಞಾನವೇ ಸಾಧನ,</para>
  <para style="q2" vid="PRO 24:3">ಅದನ್ನು ಸ್ಥಿರಪಡಿಸುವುದಕ್ಕೆ ವಿವೇಕವೇ ಆಧಾರ,<verse eid="PRO 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4"/>ಅದರ ಕೋಣೆಗಳನ್ನು ಅಮೂಲ್ಯವಾದ ಎಲ್ಲಾ,</para>
  <para style="q2" vid="PRO 24:4">ಇಷ್ಟ ಸಂಪತ್ತಿನಿಂದ ತುಂಬಿಸುವುದಕ್ಕೆ,</para>
  <para style="q2" vid="PRO 24:4">ತಿಳಿವಳಿಕೆಯೇ ಉಪಕರಣ.<verse eid="PRO 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5"/>ಜ್ಞಾನಿಗೆ ತ್ರಾಣ,</para>
  <para style="q2" vid="PRO 24:5">ಬಲ್ಲವನಿಗೆ ಬಹು ಬಲ.<verse eid="PRO 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6"/>ಮಂತ್ರಾಲೋಚನೆಯಿಂದ ಯುದ್ಧವನ್ನು ನಡೆಸು,</para>
  <para style="q2" vid="PRO 24:6">ಬಹು ಸುಮಂತ್ರಿಗಳು ಇರುವಲ್ಲಿ ಸುರಕ್ಷಣೆಯಿರುವುದು.<verse eid="PRO 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7"/>ಜ್ಞಾನವು ಮೂರ್ಖನಿಗೆ ನಿಲುಕದು,</para>
  <para style="q2" vid="PRO 24:7">ಅವನು ನ್ಯಾಯಸ್ಥಾನದಲ್ಲಿ ಬಾಯಿಬಿಡಲಾರನು.<verse eid="PRO 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8"/>ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವನು,</para>
  <para style="q2" vid="PRO 24:8">ಕುಯುಕ್ತಿಯುಳ್ಳವನು ಎನಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9"/>ಮೂರ್ಖನ ಸಂಕಲ್ಪವು ಪಾಪವೇ,</para>
  <para style="q2" vid="PRO 24:9">ಧರ್ಮನಿಂದಕನು ಮನುಷ್ಯರಿಗೆ ಅಸಹ್ಯ.<verse eid="PRO 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10"/>ಇಕ್ಕಟ್ಟಿನ ದಿನದಲ್ಲಿ ನೀನು ಬಳಲಿಹೋದರೆ,</para>
  <para style="q2" vid="PRO 24:10">ನಿನ್ನ ಬಲವೂ ಇಕ್ಕಟ್ಟೇ.<verse eid="PRO 24:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11"/>ಕೊಲೆಗೆ ಸೆಳೆಯಲ್ಪಟ್ಟವರನ್ನು ರಕ್ಷಿಸು,</para>
  <para style="q2" vid="PRO 24:11">ಸಂಹಾರಕ್ಕೆ ಗುರಿಯಾದವರನ್ನು ತಪ್ಪಿಸು.<verse eid="PRO 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12"/>“ಇದು ನನಗೆ ಗೊತ್ತಿರಲಿಲ್ಲ” ಎಂದು ನೀನು ನೆವ ಹೇಳಿದರೆ,</para>
  <para style="q2" vid="PRO 24:12">ಹೃದಯಶೋಧಕನು ಗ್ರಹಿಸುವುದಿಲ್ಲವೋ?</para>
  <para style="q" vid="PRO 24:12">ನಿನ್ನ ಆತ್ಮವನ್ನು ಕಾಯುವಾತನು ತಿಳಿಯುವುದಿಲ್ಲವೋ?</para>
  <para style="q2" vid="PRO 24:12">ಪ್ರತಿಯೊಬ್ಬನ ಕರ್ಮಕ್ಕೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡದೆ ಬಿಟ್ಟಾನೇ?<verse eid="PRO 24:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13"/>ಕಂದಾ, ಜೇನು ಚೆನ್ನಾಗಿದೆಯಲ್ಲವೆ,</para>
  <para style="q2" vid="PRO 24:13">ಜೇನುತುಪ್ಪವು ನಿನ್ನ ಬಾಯಿಗೆ ಸಿಹಿಯಷ್ಟೆ, ಅದನ್ನು ತಿನ್ನು.<verse eid="PRO 24:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14"/>ಜ್ಞಾನವು ನಿನ್ನ ಆತ್ಮಕ್ಕೆ ಹೀಗೆಯೇ ಇರುವುದೆಂದು ತಿಳಿದುಕೋ,</para>
  <para style="q2" vid="PRO 24:14">ಅದನ್ನು ಪಡೆದುಕೊಂಡರೆ ಮುಂದೆ ಫಲಕಾಲ ಬರುವುದು,</para>
  <para style="q2" vid="PRO 24:14">ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗದು.<verse eid="PRO 24:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15"/>ದುಷ್ಟನೇ, ಶಿಷ್ಟನ ಮನೆಗೆ ಹೊಂಚುಹಾಕಬೇಡ,</para>
  <para style="q2" vid="PRO 24:15">ಅವನ ನಿವಾಸವನ್ನು ಸೂರೆಮಾಡಬೇಡ.<verse eid="PRO 24:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16"/>ಶಿಷ್ಟನು ಏಳು ಸಾರಿ ಬಿದ್ದರೂ ಮತ್ತೆ ಏಳುವನು,</para>
  <para style="q2" vid="PRO 24:16">ದುಷ್ಟನು ಕೇಡಿನಿಂದ ಬಿದ್ದೇಹೋಗುವನು.<verse eid="PRO 24:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17"/>ನಿನ್ನ ಶತ್ರು ಬಿದ್ದರೆ ಹಿಗ್ಗಬೇಡ,</para>
  <para style="q2" vid="PRO 24:17">ಎಡವಿದರೆ ನಿನ್ನ ಹೃದಯವು ಹರ್ಷಿಸದಿರಲಿ.<verse eid="PRO 24:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18"/>ಯೆಹೋವನು ನಿನ್ನ ಹರ್ಷವನ್ನು ಕಂಡು ಬೇಸರಗೊಂಡು,</para>
  <para style="q2" vid="PRO 24:18">ತನ್ನ ಕೋಪವನ್ನು ಅವನ ಕಡೆಯಿಂದ ತಿರುಗಿಸಾನು.<verse eid="PRO 24:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19"/>ಕೆಡುಕರ ಮೇಲೆ ಉರಿಗೊಳ್ಳದಿರು,</para>
  <para style="q2" vid="PRO 24:19">ದುಷ್ಟರನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡದಿರು.<verse eid="PRO 24:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20"/>ಕೆಟ್ಟವನಿಗೆ ಶುಭಕಾಲವು ಬಾರದು,</para>
  <para style="q2" vid="PRO 24:20">ದುಷ್ಟರ ದೀಪವು ಆರಿಯೇ ಹೋಗುವುದು.<verse eid="PRO 24:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21"/>ಮಗನೇ, ಯೆಹೋವನಿಗೂ ಮತ್ತು ರಾಜನಿಗೂ ಭಯಪಡು,</para>
  <para style="q2" vid="PRO 24:21">ತಿರುಗಿಬೀಳುವವರ ಗೊಡವೆಗೆ ಹೋಗಬೇಡ.<verse eid="PRO 24:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22"/>ಅವರಿಬ್ಬರು ವಿಧಿಸುವ ವಿಪತ್ತು ಫಕ್ಕನೆ ಸಂಭವಿಸುವುದು,</para>
  <para style="q2" vid="PRO 24:22">ಅವರಿಂದಾಗುವ ನಾಶವು ಯಾರಿಗೆ ತಿಳಿದೀತು?<verse eid="PRO 24:22"/></para>
  <para style="s">ಬೇರೆ ಕೆಲವು ಹೇಳಿಕೆಗಳು</para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23"/>ಇವು ಕೂಡ ಜ್ಞಾನಿಗಳ ಮಾತುಗಳು:</para>
  <para style="q2" vid="PRO 24:23">ನ್ಯಾಯವಿಚಾರಣೆಯಲ್ಲಿ ಪಕ್ಷಪಾತವು ಧರ್ಮವಲ್ಲ.<verse eid="PRO 24:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24"/>ಯಾವನು ಅಧರ್ಮಿಗೆ, “ನೀನು ಧರ್ಮಾತ್ಮನು” ಎಂದು ಹೇಳುತ್ತಾನೋ,</para>
  <para style="q2" vid="PRO 24:24">ಅವನನ್ನು ಜನರು ಶಪಿಸುವರು, ಪ್ರಜೆಗಳು ದೂಷಿಸುವರು.<verse eid="PRO 24:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25"/>ದುಷ್ಟನನ್ನು ಗದರಿಸುವವರಿಗಾದರೋ ಶುಭವಾಗುವುದು,</para>
  <para style="q2" vid="PRO 24:25">ಸುಖಕರವಾದ ಆಶೀರ್ವಾದವೂ ಲಭಿಸುವುದು.<verse eid="PRO 24:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26"/>ಯಥಾರ್ಥವಾದ ಉತ್ತರವು,</para>
  <para style="q2" vid="PRO 24:26">ತುಟಿಗೆ ಮುದ್ದು.<verse eid="PRO 24:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27"/>ನಿನ್ನ ಕೆಲಸದ ಸಾಮಾನುಗಳನ್ನು ಸಿದ್ಧಮಾಡು,</para>
  <para style="q2" vid="PRO 24:27">ನಂತರ ಹೊಲಗದ್ದೆಗಳ ಕೆಲಸವನ್ನು ಮುಗಿಸು,</para>
  <para style="q2" vid="PRO 24:27">ಆಮೇಲೆ ನಿನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟು.<verse eid="PRO 24:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28"/>ಕಾರಣವಿಲ್ಲದೆ ನೆರೆಯವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿ ಹೇಳಬೇಡ,</para>
  <para style="q2" vid="PRO 24:28">ಮಾತಿನಿಂದ ಮೋಸಮಾಡಬೇಡ.<verse eid="PRO 24:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29"/>“ಅವನು ನನಗೆ ಮಾಡಿದಂತೆ ನಾನೂ ಅವನಿಗೆ ಮಾಡುವೆನು,</para>
  <para style="q2" vid="PRO 24:29">ಅವನು ಮಾಡಿದ್ದಕ್ಕೆ ಸರಿಯಾಗಿ ಮುಯ್ಯಿತೀರಿಸುವೆನು” ಅಂದುಕೊಳ್ಳಬೇಡ.<verse eid="PRO 24:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30"/>ಸೋಮಾರಿಯ ಹೊಲದ ಮೇಲೆಯೂ,</para>
  <para style="q2" vid="PRO 24:30">ಬುದ್ಧಿಹೀನನ ದ್ರಾಕ್ಷಿಯ ತೋಟದ ಮೇಲೆಯೂ ಹಾದು ಹೋದೆನು.<verse eid="PRO 24:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31"/>ಆಹಾ, ಮುಳ್ಳುಗಿಡಗಳು ಅದರಲ್ಲಿ ಹರಡಿಕೊಂಡಿದ್ದವು,</para>
  <para style="q2" vid="PRO 24:31">ಕಳೆಗಳು ಅದನ್ನು ಮುಚ್ಚಿದ್ದವು,</para>
  <para style="q2" vid="PRO 24:31">ಅದರ ಕಲ್ಲಿನ ಗೋಡೆಯು ಹಾಳಾಗಿತ್ತು.<verse eid="PRO 24:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32"/>ಆಗ ನಾನು ನೋಡಿ ಆಲೋಚಿಸಿದೆನು,</para>
  <para style="q2" vid="PRO 24:32">ದೃಷ್ಟಿಸಿ ಶಿಕ್ಷಿತನಾದೆನು.<verse eid="PRO 24:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33"/>ಇನ್ನು ಸ್ವಲ್ಪ ನಿದ್ದೆ, ಇನ್ನು ತುಸ ತೂಕಡಿಕೆ,</para>
  <para style="q2" vid="PRO 24:33">ಇನ್ನೂ ಕೊಂಚ ನಿದ್ದೆಗಾಗಿ ಕೈಮುದುರಿಕೊಳ್ಳುವೆ ಅಂದುಕೊಳ್ಳುವಿಯಾ?<verse eid="PRO 24:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34"/>ಬಡತನವು ದಾರಿಗಳ್ಳನ ಹಾಗೂ,</para>
  <para style="q2" vid="PRO 24:34">ಕೊರತೆಯು ಪಂಜುಗಳ್ಳನಂತೆಯೂ ನಿನ್ನ ಮೇಲೆ ಬೀಳುವವು.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s">ಸೊಲೊಮೋನನ ಇನ್ನೂ ಕೆಲವು ಜ್ಞಾನೋಕ್ತಿಗಳು</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 25:1"/>ಇವು ಕೂಡ ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು, ಯೆಹೂದದ ಅರಸನಾದ ಹಿಜ್ಕೀಯನ ಲೇಖಕರು ಇವುಗಳನ್ನು ಸಂಗ್ರಹಿಸಿ ಬರೆದರು.<verse eid="PRO 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2"/>ವಿಷಯವನ್ನು ರಹಸ್ಯವಾಗಿಡುವುದು ದೇವರ ಮಹಿಮೆ,</para>
  <para style="q2" vid="PRO 25:2">ವಿಷಯವನ್ನು ವಿಮರ್ಶೆಮಾಡುವುದು ರಾಜರ ಹಿರಿಮೆ.<verse eid="PRO 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3"/>ಆಕಾಶವು ಉನ್ನತ, ಭೂಮಿಯು ಅಗಾಧ,</para>
  <para style="q2" vid="PRO 25:3">ರಾಜರ ಹೃದಯವು ಅಗೋಚರ.<verse eid="PRO 25:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4"/>ಬೆಳ್ಳಿಯಿಂದ ಕಲ್ಮಷವನ್ನು ತೆಗೆದುಹಾಕಿದರೆ,</para>
  <para style="q2" vid="PRO 25:4">ಅಕ್ಕಸಾಲಿಗನಿಗೆ ಬೇಕಾದ ಪಾತ್ರೆಯಾಗುವುದು.<verse eid="PRO 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5"/>ರಾಜನ ಸಮ್ಮುಖದಿಂದ ದುಷ್ಟರನ್ನು ತೆಗೆದುಹಾಕಿದರೆ,</para>
  <para style="q2" vid="PRO 25:5">ಅವನ ಸಿಂಹಾಸನವು ಧರ್ಮದಿಂದ ಸ್ಥಿರವಾಗುವುದು.<verse eid="PRO 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6"/>ರಾಜನ ಸನ್ನಿಧಾನದಲ್ಲಿ ನಿನ್ನನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳಬೇಡ,</para>
  <para style="q2" vid="PRO 25:6">ಶ್ರೀಮಂತರಿಗೆ ಏರ್ಪಡಿಸಿರುವ ಸ್ಥಾನದಲ್ಲಿ ನಿಂತುಕೊಳ್ಳಬೇಡ.<verse eid="PRO 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7"/>ನೀನು ಪ್ರಭುವನ್ನು ದರ್ಶನಮಾಡುತ್ತಿರಲು ಅವನ ಸಮಕ್ಷಮದಲ್ಲಿ ಕೆಳಗಣಸ್ಥಾನಕ್ಕೆ ನೂಕಿಸಿಕೊಳ್ಳುವುದಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 25:7">“ಇನ್ನೂ ಮೇಲಕ್ಕೆ ಬಾ” ಎಂದು ಕರೆಯಿಸಿಕೊಳ್ಳುವುದು ಲೇಸು.<verse eid="PRO 25:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8"/>ದುಡುಕಿ ನೆರೆಯವನ ಮೇಲೆ ವ್ಯಾಜ್ಯಕ್ಕೆ ಹೋಗಬೇಡ,</para>
  <para style="q2" vid="PRO 25:8">ಅವನು ನಿನ್ನ ಮಾನ ಕಳೆದ ಮೇಲೆ ಕಡೆಯಲ್ಲಿ ಏನು ಮಾಡಬಲ್ಲೆ, ನೋಡಿಕೋ.<verse eid="PRO 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9"/>ವ್ಯಾಜ್ಯವಾಡಿದವನ ಸಂಗಡಲೇ ಅದನ್ನು ಚರ್ಚಿಸು,</para>
  <para style="q2" vid="PRO 25:9">ಒಬ್ಬನ ಗುಟ್ಟನ್ನೂ ಬಯಲುಮಾಡಬೇಡ.<verse eid="PRO 25:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10"/>ಅದನ್ನು ಕೇಳುವವನು ನಿನ್ನನ್ನು ದೂಷಿಸಾನು,</para>
  <para style="q2" vid="PRO 25:10">ನಿನಗೆ ಬಂದ ಅಪಕೀರ್ತಿಯು ಹೋಗದು.<verse eid="PRO 25:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11"/>ಸಮಯೋಚಿತವಾದ ಮಾತುಗಳು ಬೆಳ್ಳಿಯ ಕಟ್ಟಿನಲ್ಲಿ</para>
  <para style="q2" vid="PRO 25:11">ಖಚಿತವಾದ ಬಂಗಾರದ ಹಣ್ಣುಗಳಿಗೆ ಸಮಾನ.<verse eid="PRO 25:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12"/>ಕೇಳುವ ಕಿವಿಗೆ ಮುಟ್ಟುವ ಬುದ್ಧಿವಾದವು</para>
  <para style="q2" vid="PRO 25:12">ಹೊನ್ನಿನ ಮುರುವಿಗೂ, ಅಪರಂಜಿಯ ಆಭರಣಕ್ಕೂ ಸಮಾನ.<verse eid="PRO 25:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13"/>ಸುಗ್ಗೀಕಾಲದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">25:13 </char><char style="fq" closed="false">ಸುಗ್ಗೀಕಾಲದಲ್ಲಿ </char><char style="ft" closed="false">ಅಥವಾ ಬೇಸಿಗೆಕಾಲದಲ್ಲಿ.</char></note> ಹಿಮದ ಶೀತವು ಹೇಗೋ</para>
  <para style="q2" vid="PRO 25:13">ಕಳುಹಿಸಿದ ಒಡೆಯರಿಗೆ ಆಪ್ತದೂತನು ಹಾಗೆಯೇ ಹಿತ.<verse eid="PRO 25:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14"/>ಬರೀ ಗಾಳಿಯ ಮೋಡಗಳು ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 25:14">ದಾನಕೊಡುತ್ತೇನೆಂದು ಸುಳ್ಳಾಡಿ ಜಂಬಮಾಡುವವನೂ ಹಾಗೆಯೇ.<verse eid="PRO 25:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15"/>ದೀರ್ಘಶಾಂತಿಯಿಂದ ಪ್ರಭುವನ್ನೂ ಸಮ್ಮತಿಪಡಿಸಬಹುದು,</para>
  <para style="q2" vid="PRO 25:15">ಮೃದುವಚನವು ಎಲುಬನ್ನು ಮುರಿಯುವುದು.<verse eid="PRO 25:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16"/>ಜೇನು ಸಿಕ್ಕಿತೋ? ಮಿತವಾಗಿ ತಿನ್ನು,</para>
  <para style="q2" vid="PRO 25:16">ಹೊಟ್ಟೆತುಂಬಾ ತಿಂದರೆ ಕಾರಿಬಿಟ್ಟೀಯೇ.<verse eid="PRO 25:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17"/>ನೆರೆಯವನು ಬೇಸರಗೊಂಡು ಹಗೆಮಾಡದ ಹಾಗೆ,</para>
  <para style="q2" vid="PRO 25:17">ಅವನ ಮನೆಯಲ್ಲಿ ಅಪರೂಪವಾಗಿ ಹೆಜ್ಜೆಯಿಡು.<verse eid="PRO 25:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18"/>ನೆರೆಯವನ ಮೇಲೆ ಸುಳ್ಳುಸಾಕ್ಷಿಹೇಳುವವನು,</para>
  <para style="q2" vid="PRO 25:18">ಚಮಟಿಕೆ, ಕತ್ತಿ, ಚೂಪಾದ ಬಾಣ ಇವುಗಳೇ.<verse eid="PRO 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19"/>ಕಷ್ಟಕಾಲದಲ್ಲಿ ದ್ರೋಹಿಯಲ್ಲಿಡುವ ನಂಬಿಕೆಯು,</para>
  <para style="q2" vid="PRO 25:19">ಮುರುಕಹಲ್ಲು ಮತ್ತು ಜಾರುವ ಕಾಲು.<verse eid="PRO 25:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20"/>ಮನಗುಂದಿದವನಿಗೆ ಸಂಗೀತಹಾಡುವುದು</para>
  <para style="q2" vid="PRO 25:20">ಚಳಿದಿನದಲ್ಲಿ ಬಟ್ಟೆ ತೆಗೆದಂತೆ,</para>
  <para style="q2" vid="PRO 25:20">ಗಾಯಕ್ಕೆ<note caller="+" style="f"><char style="fr" closed="false">25:20 </char><char style="fq" closed="false">ಗಾಯಕ್ಕೆ </char><char style="ft" closed="false">ಅಥವಾ ಸೋಡಉಪ್ಪಿಗೆ.</char></note> ಹುಳಿಹೊಯ್ದಂತೆ.<verse eid="PRO 25:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21"/>ನಿನ್ನ ವೈರಿ ಹಸಿದಿದ್ದರೆ ಅನ್ನವಿಡು,</para>
  <para style="q2" vid="PRO 25:21">ಬಾಯಾರಿದ್ದರೆ ನೀರುಕೊಡು,<verse eid="PRO 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22"/>ಹೀಗೆ ಅವನ ತಲೆಯ ಮೇಲೆ ಕೆಂಡ ಸುರಿದಂತಾಗುವುದು.<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="fq" closed="false">ಹೀಗೆ ಅವನ ತಲೆಯ ಮೇಲೆ ಕೆಂಡ ಸುರಿದಂತಾಗುವುದು. </char><char style="ft" closed="false">ಅಥವಾ ಹೀಗೆ ಮಾಡುವುದ್ದರಿಂದ ನೀನು ಅವನನ್ನು ಅವಮಾನಗೊಳಿಸುವಿ.</char></note></para>
  <para style="q2" vid="PRO 25:22">ಯೆಹೋವನೇ ನಿನಗೆ ಪ್ರತಿಫಲಕೊಡುವನು.<verse eid="PRO 25:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23"/>ಉತ್ತರದ ಗಾಳಿ ಮಳೆ ಬರಮಾಡುವುದು,</para>
  <para style="q2" vid="PRO 25:23">ಚಾಡಿಯ ನಾಲಿಗೆ ಕೋಪದ ಮುಖ ಮಾಡುವುದು.<verse eid="PRO 25:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24"/>ಮನೆಯಲ್ಲಿ ಜಗಳಗಂಟಿಯ ಜೊತೆಯಲ್ಲಿರುವುದಕ್ಕಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 25:24">ಮಾಳಿಗೆಯ ಒಂದು ಮೂಲೆಯಲ್ಲಿ ವಾಸಿಸುವುದೇ ಲೇಸು.<verse eid="PRO 25:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25"/>ಬಳಲಿ ಬಾಯಾರಿದವನಿಗೆ ತಣ್ಣೀರು ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 25:25">ದೇಶಾಂತರದಿಂದ ಬಂದ ಒಳ್ಳೆಯ ಸಮಾಚಾರವು ಹಾಗೆಯೇ.<verse eid="PRO 25:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26"/>ದುಷ್ಟರಿಂದ ಸೋತ ಶಿಷ್ಟನು,</para>
  <para style="q2" vid="PRO 25:26">ಹಾಳು ಬಾವಿ ಮತ್ತು ತುಳಿದಾಡಿದ ಒರತೆ.<verse eid="PRO 25:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27"/>ಜೇನನ್ನು ಹೆಚ್ಚಾಗಿ ತಿನ್ನುವುದು ಹಿತವಲ್ಲ,</para>
  <para style="q2" vid="PRO 25:27">ಸ್ವಂತಮಾನವನ್ನು ಹೆಚ್ಚಾಗಿ ಯೋಚಿಸುವುದು ಮಾನವಲ್ಲ.<verse eid="PRO 25:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28"/>ಆತ್ಮವನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳದವನು</para>
  <para style="q2" vid="PRO 25:28">ಗೋಡೆ ಬಿದ್ದ ಹಾಳೂರಿಗೆ ಸಮಾನ.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1"/>ಬೇಸಿಗೆಯಲ್ಲಿ ಹಿಮ, ಸುಗ್ಗಿಯಲ್ಲಿ ಮಳೆ ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 26:1">ಮೂಢನಿಗೆ ಮಾನವು ಹಾಗೆ ಸರಿಯಲ್ಲ.<verse eid="PRO 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2"/>ಕುಪ್ಪಳಿಸುತ್ತಿರುವ ಗುಬ್ಬಿಯಂತೆ, ಹಾರಾಡುವ ಬಾನಕ್ಕಿಯ ಹಾಗೆ,</para>
  <para style="q2" vid="PRO 26:2">ಕಾರಣವಿಲ್ಲದೆ ಕೊಟ್ಟ ಶಾಪವು ಎರಗಿ ನಿಲ್ಲದು.<verse eid="PRO 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3"/>ಕುದುರೆಗೆ ಚಬುಕು, ಕತ್ತೆಗೆ ಕಡಿವಾಣ,</para>
  <para style="q2" vid="PRO 26:3">ಮೂಢನ ಬೆನ್ನಿಗೆ ಬೆತ್ತ.<verse eid="PRO 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4"/>ಮೂಢನ ಮೂರ್ಖತನಕ್ಕೆ ಸರಿಯಾಗಿ ಉತ್ತರ ಕೊಡಬೇಡ,</para>
  <para style="q2" vid="PRO 26:4">ನೀನೂ ಅವನಿಗೆ ಸಮಾನನಾದೀಯೆ.<verse eid="PRO 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5"/>ಮೂಢನ ಮೂರ್ಖತನಕ್ಕೆ ಸರಿಯಾಗಿ ಉತ್ತರ ಕೊಡು,</para>
  <para style="q2" vid="PRO 26:5">ತನ್ನನ್ನು ಜ್ಞಾನಿಯೆಂದು ಎಣಿಸಿಕೊಂಡಾನು.<verse eid="PRO 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6"/>ಮೂಢನ ಮೂಲಕ ಮಾತನ್ನು ಹೇಳಿಕಳುಹಿಸುವವನು,</para>
  <para style="q2" vid="PRO 26:6">ತನ್ನ ಕಾಲುಗಳನ್ನು ತಾನೇ ಕಡಿದುಕೊಂಡು ಕೇಡನ್ನು ಕುಡಿಯುವನು.<verse eid="PRO 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7"/>ಮೂಢನ ಬಾಯಿಯ ಜ್ಞಾನೋಕ್ತಿಯು,</para>
  <para style="q2" vid="PRO 26:7">ಜೋಲಾಡುವ ಕುಂಟಕಾಲು.<verse eid="PRO 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8"/>ಮೂಢನಿಗೆ ಕೊಡುವ ಮಾನವು,</para>
  <para style="q2" vid="PRO 26:8">ಕವಣೆಯಲ್ಲಿಟ್ಟ ಕಲ್ಲಿನ ಹಾಗೆ.<verse eid="PRO 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9"/>ಮೂಢನ ಬಾಯಿಗೆ ಸಿಕ್ಕಿದ ಜ್ಞಾನೋಕ್ತಿಯು,</para>
  <para style="q2" vid="PRO 26:9">ಕುಡುಕನ ಕೈಗೆ ಸಿಕ್ಕಿದ ಮುಳ್ಳುಗೋಲಿನ ಹಾಗೆ.<verse eid="PRO 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10"/>ಮೂಢರನ್ನೂ, ತಿರುಗಾಡುವವರನ್ನೂ<note caller="+" style="f"><char style="fr" closed="false">26:10 </char><char style="fq" closed="false">ತಿರುಗಾಡುವವರನ್ನೂ </char><char style="ft" closed="false">ಅಥವಾ ಕುಡುಕರನ್ನು</char></note> ಕೂಲಿಗೆ ಕರೆಯುವವನು,</para>
  <para style="q2" vid="PRO 26:10">ಯಾರಿಗೋ ತಗಲಲಿ ಎಂದು ಬಾಣವನ್ನು ಎಸೆಯುವವನಂತೆ. <note caller="+" style="f"><char style="fr" closed="false">26:10 </char><char style="fq" closed="false">ಯಾರಿಗೋ ತಗಲಲಿ ಎಂದು ಬಾಣವನ್ನು ಎಸೆಯುವವನಂತೆ. </char><char style="ft" closed="false">ಅಥವಾ ಹಾದುಹೋಗುವವರೆಲ್ಲರನ್ನು ಗಾಯಪಡಿಸುವವನಂತೆ.</char></note><verse eid="PRO 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11"/>ನಾಯಿ ತಾನು ಕಕ್ಕಿದ್ದನ್ನು ನೆಕ್ಕುವುದಕ್ಕೆ ತಿರುಗಿಕೊಳ್ಳುವ ಹಾಗೆ,</para>
  <para style="q2" vid="PRO 26:11">ಮೂಢನು ತಾನು ಮಾಡಿದ ಮೂರ್ಖತನವನ್ನೇ ಪುನಃ ಮಾಡುವನು.<verse eid="PRO 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12"/>ತಾನೇ ಜ್ಞಾನಿಯೆಂದು ಎಣಿಸಿಕೊಳ್ಳುವವನನ್ನು ನೋಡು,</para>
  <para style="q2" vid="PRO 26:12">ಅಂಥವನಿಗಿಂತಲೂ ಮೂಢನ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚು ನಿರೀಕ್ಷೆಯನ್ನಿಡಬಹುದು.<verse eid="PRO 26:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13"/>“ದಾರಿಯಲ್ಲಿ ಸಿಂಹವಿದೆ,</para>
  <para style="q2" vid="PRO 26:13">ಬೀದಿಗಳಲ್ಲಿ ತಿರುಗಾಡುತ್ತಿದೆ” ಎಂಬುದು ಸೋಮಾರಿಯ ನೆವ.<verse eid="PRO 26:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14"/>ಕದವು ತಿರುಗುಣಿಯಲ್ಲಿ ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 26:14">ಹಾಗೆ ಸೋಮಾರಿಯು ಹಾಸಿಗೆಯಲ್ಲಿ ಹೊರಳಾಡುತ್ತಿರುವನು.<verse eid="PRO 26:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15"/>ಸೋಮಾರಿಯು ಪಾತ್ರೆಯೊಳಗೆ ಕೈ ಮುಳುಗಿಸಿದ ಮೇಲೆ,</para>
  <para style="q2" vid="PRO 26:15">ತಿರುಗಿ ಬಾಯಿಯ ಹತ್ತಿರ ತರಲಾರದಷ್ಟು ಆಯಾಸಗೊಳ್ಳುತ್ತಾನೆ.<verse eid="PRO 26:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16"/>ವಿವೇಕದಿಂದ ಉತ್ತರಕೊಡಬಲ್ಲ ಏಳು ಜನರಿಗಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 26:16">ತಾನೇ ಜ್ಞಾನಿಯೆಂದು ಸೋಮಾರಿಯು ಎಣಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 26:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17"/>ಒಬ್ಬನು ದಾರಿಯಲ್ಲಿ ಹೋಗುತ್ತಾ ಪರರ ವ್ಯಾಜ್ಯಕ್ಕೆ ಸೇರಿ ರೇಗಿಕೊಳ್ಳುವುದು,</para>
  <para style="q2" vid="PRO 26:17">ನಾಯಿಯ ಕಿವಿಹಿಡಿದ ಹಾಗೆ.<verse eid="PRO 26:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18"/>ನೆರೆಯವನನ್ನು ಮೋಸಗೊಳಿಸಿ, “ತಮಾಷೆಗೋಸ್ಕರ,</para>
  <para style="q2" vid="PRO 26:18">ಮಾಡಿದೆನಲ್ಲಾ” ಎನ್ನುವವನು,<verse eid="PRO 26:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19"/>ಕೊಳ್ಳಿಗಳನ್ನೂ, ಅಂಬುಗಳನ್ನೂ, ಸಾವನ್ನೂ ಬೀರುವ,</para>
  <para style="q2" vid="PRO 26:19">ದೊಡ್ಡ ಹುಚ್ಚನ ಹಾಗೆ.<verse eid="PRO 26:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20"/>ಕಟ್ಟಿಗೆಯಿಲ್ಲದಿದ್ದರೆ ಬೆಂಕಿ ಆರುವುದು,</para>
  <para style="q2" vid="PRO 26:20">ಚಾಡಿಕೋರನು ಇಲ್ಲದಿದ್ದರೆ ಜಗಳ ಶಮನವಾಗುವುದು.<verse eid="PRO 26:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21"/>ಕೆಂಡಕ್ಕೆ ಇದ್ದಲು, ಉರಿಗೆ ಕಟ್ಟಿಗೆ,</para>
  <para style="q2" vid="PRO 26:21">ವ್ಯಾಜ್ಯದ ಕಿಚ್ಚನ್ನೆಬ್ಬಿಸುವುದಕ್ಕೆ ಜಗಳಗಂಟಿಗ.<verse eid="PRO 26:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22"/>ಚಾಡಿಕೋರನ ಮಾತುಗಳು ರುಚಿಯಾದ ತುತ್ತುಗಳು,</para>
  <para style="q2" vid="PRO 26:22">ಇವು ಹೊಟ್ಟೆಯೊಳಕ್ಕೇ ಇಳಿಯುವವು.<verse eid="PRO 26:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23"/>ಕೆಟ್ಟ ಹೃದಯದಿಂದ ಪ್ರೀತಿಯನ್ನಾಡುವ ತುಟಿಯು,</para>
  <para style="q2" vid="PRO 26:23">ಬೆಳ್ಳಿ ಲೇಪನ ಮಾಡಿದ ಮಣ್ಣಿನ ಮಡಿಕೆಯ ಹಾಗೆ.<verse eid="PRO 26:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24"/>ಶತ್ರುವು ಸ್ನೇಹಭಾವದಿಂದ ನಟಿಸುತ್ತಾನೆ,</para>
  <para style="q2" vid="PRO 26:24">ಅಂತರಂಗದಲ್ಲಿ ಬರೀ ಮೋಸವನ್ನು ಇಟ್ಟುಕೊಂಡಿದ್ದಾನೆ.<verse eid="PRO 26:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25"/>ಸವಿಮಾತನಾಡಿದರೂ ಅವನನ್ನು ನಂಬಬೇಡ,</para>
  <para style="q2" vid="PRO 26:25">ಅವನ ಹೃದಯದಲ್ಲಿ ಎಷ್ಟೋ ಹೇಯ ಕೃತ್ಯಗಳು.<verse eid="PRO 26:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26"/>ತನ್ನ ಹಗೆಯನ್ನು ವಂಚನೆಯಿಂದ ಮರೆಮಾಚಿಕೊಂಡಿದ್ದರೂ,</para>
  <para style="q2" vid="PRO 26:26">ಅವನ ಕೆಟ್ಟತನವು ಸಭೆಯಲ್ಲಿ ಬೈಲಾಗುವುದು.<verse eid="PRO 26:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27"/>ಗುಂಡಿಯನ್ನು ತೋಡುವವನು ತಾನೇ ಅದರಲ್ಲಿ ಬೀಳುವನು,</para>
  <para style="q2" vid="PRO 26:27">ಹೊರಳಿಸುವವನ ಮೇಲೆಯೇ ಕಲ್ಲು ಹೊರಳುವುದು.<verse eid="PRO 26:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28"/>ಸುಳ್ಳು ನಾಲಿಗೆಯವನು ತಾನು ಬಾಧಿಸಿದವರನ್ನೇ ದ್ವೇಷಿಸುವನು,</para>
  <para style="q2" vid="PRO 26:28">ಕಪಟದ ಬಾಯಿ ನಾಶಕರ.<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1"/>ನಾಳೆ ಎಂದು ಕೊಚ್ಚಿಕೊಳ್ಳಬೇಡ,</para>
  <para style="q2" vid="PRO 27:1">ಒಂದು ದಿನದೊಳಗೆ ಏನಾಗುವುದೋ ನಿನಗೆ ತಿಳಿಯದು.<verse eid="PRO 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2"/>ನಿನ್ನನ್ನು ನೀನೇ ಹೊಗಳಿಕೊಳ್ಳಬೇಡ,</para>
  <para style="q2" vid="PRO 27:2">ಮತ್ತೊಬ್ಬನು ಹೊಗಳಿದರೆ ಹೊಗಳಲಿ,</para>
  <para style="q2" vid="PRO 27:2">ಆತ್ಮಸ್ತುತಿ ಬೇಡ,</para>
  <para style="q2" vid="PRO 27:2">ಪರನು ನಿನ್ನನ್ನು ಸ್ತುತಿಸಿದರೆ ಸ್ತುತಿಸಲಿ.<verse eid="PRO 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3"/>ಕಲ್ಲು ಭಾರ, ಮರಳು ಭಾರ,</para>
  <para style="q2" vid="PRO 27:3">ಎರಡಕ್ಕಿಂತಲೂ ಮೂಢನ ಕೋಪವು ಬಲು ಭಾರ.<verse eid="PRO 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4"/>ಕೋಪವು ಕ್ರೂರ, ಕ್ರೋಧವು ಪ್ರವಾಹ,</para>
  <para style="q2" vid="PRO 27:4">ಮತ್ಸರಕ್ಕೆ ಎದುರಾಗಿ ಯಾರು ನಿಂತಾರು?<verse eid="PRO 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5"/>ಕಾರ್ಯದಿಂದ ಹೊರಪಡದ ಪ್ರೀತಿಗಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 27:5">ಬಹಿರಂಗವಾದ ಗದರಿಕೆಯು ಲೇಸು.<verse eid="PRO 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6"/>ಮಿತ್ರನು ಮಾಡುವ ಗಾಯಗಳು ಮೇಲಿಗಾಗಿಯೇ,</para>
  <para style="q2" vid="PRO 27:6">ಶತ್ರುವಿನ ಮುದ್ದುಗಳು ಹೇರಳವಾಗಿವೆ.<verse eid="PRO 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7"/>ಹೊಟ್ಟೆತುಂಬಿದವನಿಗೆ ಜೇನುತುಪ್ಪವೂ ಅಸಹ್ಯ,</para>
  <para style="q2" vid="PRO 27:7">ಹೊಟ್ಟೆ ಹಸಿದವನಿಗೆ ಕಹಿಯೆಲ್ಲಾ ಸಿಹಿ.<verse eid="PRO 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8"/>ಸ್ಥಳವನ್ನು ಬಿಟ್ಟು ಅಲೆಯುವ ಮನುಷ್ಯನು,</para>
  <para style="q2" vid="PRO 27:8">ಗೂಡನ್ನು ಬಿಟ್ಟು ಅಲೆಯುವ ಹಕ್ಕಿಯ ಹಾಗೆ.<verse eid="PRO 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9"/>ತೈಲವೂ, ಸುಗಂಧದ್ರವ್ಯಗಳೂ ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 27:9">ಮಿತ್ರನ ಸಂಭಾಷಣೆಯಿಂದ ಅನುಭವಕ್ಕೆ ಬರುವ ಸ್ನೇಹರಸವು ಹಾಗೆ ಮನೋಹರ.<verse eid="PRO 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10"/>ನಿನಗೂ, ನಿನ್ನ ತಂದೆಗೂ ಮಿತ್ರನಾದವನನ್ನು ಬಿಡಬೇಡ,</para>
  <para style="q2" vid="PRO 27:10">ನಿನ್ನ ಇಕ್ಕಟ್ಟಿನ ದಿನದಲ್ಲಿ ಅಣ್ಣನ ಮನೆಯನ್ನು ಆಶ್ರಯಿಸದಿರು,</para>
  <para style="q2" vid="PRO 27:10">ದೂರವಾಗಿರುವ ಅಣ್ಣನಿಗಿಂತ ಹತ್ತಿರವಾಗಿರುವ ನೆರೆಯವನು ಲೇಸು.<verse eid="PRO 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11"/>ಮಗನೇ, ಜ್ಞಾನವನ್ನು ಪಡೆದುಕೊಂಡು ನನ್ನ ಹೃದಯವನ್ನು ಸಂತೋಷಪಡಿಸು,</para>
  <para style="q2" vid="PRO 27:11">ಹಾಗಾದರೆ, ನನ್ನನ್ನು ದೂರುವವನಿಗೆ ನಾನು ಉತ್ತರ ಕೊಡಲಾಗುವುದು.<verse eid="PRO 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12"/>ಜಾಣನು ಕೇಡನ್ನು ಕಂಡು ಅಡಗಿಕೊಳ್ಳುವನು,</para>
  <para style="q2" vid="PRO 27:12">ಬುದ್ಧಿಹೀನನು ಮುಂದೆ ಹೋಗಿ ನಷ್ಟಪಡುವನು.<verse eid="PRO 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13"/>ಮತ್ತೊಬ್ಬನಿಗೆ ಹೊಣೆಯಾದವನ ಬಟ್ಟೆಯನ್ನು ಕಿತ್ತುಕೋ,</para>
  <para style="q2" vid="PRO 27:13">ಮತ್ತೊಬ್ಬಳಿಗೆ ಹೊಣೆಯಾದವನನ್ನೇ ಒತ್ತೆಮಾಡಿಕೋ.<verse eid="PRO 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14"/>ಮುಂಜಾನೆ ಎದ್ದು ತನ್ನ ಸ್ನೇಹಿತನನ್ನು ದೊಡ್ಡ ಕೂಗಿನಿಂದ ಆಶೀರ್ವದಿಸುವವನು,</para>
  <para style="q2" vid="PRO 27:14">ಶಪಿಸುವವನೆನಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 27:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15"/>ದೊಡ್ಡ ಮಳೆಯ ದಿನದಲ್ಲಿ ತಟತಟನೆ ತೊಟ್ಟಿಕ್ಕುವ ಹನಿ,</para>
  <para style="q2" vid="PRO 27:15">ತಂಟೆಮಾಡುವ ಹೆಂಡತಿ, ಎರಡೂ ಒಂದೇ.<verse eid="PRO 27:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16"/>ಅವಳನ್ನು ಅಡಗಿಸುವವನು ಗಾಳಿಯನ್ನು ಅಡಗಿಸುವನು,</para>
  <para style="q2" vid="PRO 27:16">ಅವಳನ್ನು ಹಿಡಿಯುವ ಬಲಗೈ ಜಿಡ್ಡಿನ ವಸ್ತುವನ್ನು ಹಿಡಿಯುವುದು.<verse eid="PRO 27:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17"/>ಕಬ್ಬಿಣವು ಕಬ್ಬಿಣವನ್ನು ಹೇಗೆ ಹರಿತಮಾಡುವುದೋ,</para>
  <para style="q2" vid="PRO 27:17">ಮಿತ್ರನು ಮಿತ್ರನ ಬುದ್ಧಿಯನ್ನು ಹಾಗೆಯೇ ಹರಿತಮಾಡುವನು.<verse eid="PRO 27:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18"/>ಅಂಜೂರದ ಮರವನ್ನು ಕಾಯುವವನು ಅದರ ಫಲವನ್ನು ತಿನ್ನುವನು,</para>
  <para style="q2" vid="PRO 27:18">ಯಜಮಾನನ ಮಾತಿನಂತೆ ನಡೆಯುವವನು ಸನ್ಮಾನವನ್ನು ಅನುಭವಿಸುವನು.<verse eid="PRO 27:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19"/>ನೀರು ಮುಖಕ್ಕೆ ಮುಖವನ್ನು ಹೇಗೆ ಪ್ರತಿಬಿಂಬಿಸುತ್ತದೋ,</para>
  <para style="q2" vid="PRO 27:19">ಹಾಗೆಯೇ ಮನುಷ್ಯನಿಗೆ ಮನುಷ್ಯನ ಹೃದಯವು ತೋರ್ಪಡಿಸುತ್ತದೆ.<verse eid="PRO 27:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20"/>ಪಾತಾಳಕ್ಕೂ, ನಾಶಲೋಕಕ್ಕೂ ಹೇಗೆ ತೃಪ್ತಿಯಿಲ್ಲವೋ,</para>
  <para style="q2" vid="PRO 27:20">ಹಾಗೆಯೇ ಮನುಷ್ಯನ ಕಣ್ಣುಗಳಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">27:20 </char><char style="fq" closed="false">ಕಣ್ಣುಗಳಿಗೆ </char><char style="ft" closed="false">ಅಥವಾ ಆಸೆಗೆ.</char></note> ತೃಪ್ತಿಯಿಲ್ಲ.<verse eid="PRO 27:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21"/>ಪುಟಕುಲುಮೆಗಳಿಂದ ಬೆಳ್ಳಿಬಂಗಾರಗಳಿಗೆ ಶೋಧನೆಯು ಹೇಗೋ,</para>
  <para style="q2" vid="PRO 27:21">ಹೊಗಳಿಕೆಯಿಂದ ಮನುಷ್ಯನಿಗೆ ಶೋಧನೆಯು ಹಾಗೆಯೇ.<verse eid="PRO 27:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22"/>ಗೋದಿರವೆಯ ಸಂಗಡ ಮೂರ್ಖನನ್ನು ಒರಳಿನಲ್ಲಿ ಒನಕೆಯಿಂದ ಕುಟ್ಟಿದರೂ,</para>
  <para style="q2" vid="PRO 27:22">ಮೂರ್ಖತನವು ಅವನಿಂದ ತೊಲಗದು.<verse eid="PRO 27:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23"/>ನಿನ್ನ ಹಿಂಡುಗಳ ಸ್ಥಿತಿಯನ್ನು ಚೆನ್ನಾಗಿ ತಿಳಿದುಕೊಂಡಿರು,</para>
  <para style="q2" vid="PRO 27:23">ನಿನ್ನ ಮಂದೆಗಳ ಮೇಲೆ ಮನಸ್ಸಿಡು.<verse eid="PRO 27:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24"/>ಸಂಪತ್ತು ಶಾಶ್ವತವಾಗಿರುವುದಿಲ್ಲವಷ್ಟೆ,</para>
  <para style="q2" vid="PRO 27:24">ಕಿರೀಟವು ತಲತಲಾಂತರಗಳ ವರೆಗೆ ನಿಂತೀತೋ?<verse eid="PRO 27:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25"/>ಹುಲ್ಲನ್ನು ಕೊಯ್ದು ಹೊತ್ತುಕೊಂಡು ಬಂದ ಮೇಲೆ</para>
  <para style="q2" vid="PRO 27:25">ಹಸಿಹುಲ್ಲು ತಲೆದೋರುವುದು,</para>
  <para style="q2" vid="PRO 27:25">ಬೆಟ್ಟಗಳ ಸೊಪ್ಪನ್ನೂ ಕೂಡಿಸಿಡುವರು.<verse eid="PRO 27:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26"/>ಕುರಿಗಳಿಂದ ನಿನಗೆ ಉಡುಪಾಗುವುದು,</para>
  <para style="q2" vid="PRO 27:26">ಆಡುಗಳಿಂದ ಹೊಲದ ಕ್ರಯ ಹೆಚ್ಚುವುದು.<verse eid="PRO 27:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27"/>ನಿನ್ನ ಊಟಕ್ಕೂ, ಮನೆಯವರ ಆಹಾರಕ್ಕೂ ಮೇಕೆಯ ಹಾಲು ಬೇಕಾದಷ್ಟಾಗುವುದು,</para>
  <para style="q2" vid="PRO 27:27">ಅದು ನಿನ್ನ ದಾಸಿಯರಿಗೆ ಜೀವನವಾಗುವುದು.<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1"/>ಹಿಂದಟ್ಟದಿದ್ದರೂ ದುಷ್ಟನು ಹೆದರಿ ಓಡುವನು,</para>
  <para style="q2" vid="PRO 28:1">ಶಿಷ್ಟನು ಸಿಂಹದಂತೆ ಧೈರ್ಯದಿಂದಿರುವನು.<verse eid="PRO 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2"/>ಅಧರ್ಮದಿಂದ ದೇಶದಲ್ಲಿ ಬಹು ನಾಯಕರಿರುವರು,</para>
  <para style="q2" vid="PRO 28:2">ಜ್ಞಾನಿಗಳೂ, ವಿವೇಕಿಗಳೂ ಆದವರಿಂದ ಧರ್ಮವು ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="PRO 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3"/>ಬಡವರನ್ನು ಹಿಂಸಿಸುವ ದರಿದ್ರನು<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="fq" closed="false">ದರಿದ್ರನು </char><char style="ft" closed="false">ಅಥವಾ ಅಧಿಕಾರಿ.</char></note>,</para>
  <para style="q2" vid="PRO 28:3">ಒಂದು ಕಾಳೂ ಉಳಿಯದಂತೆ ಪೈರನ್ನು ಬಡಿಯುವ ಮಳೆಯ ಹಾಗೆ.<verse eid="PRO 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4"/>ಧರ್ಮೋಪದೇಶವನ್ನು ಕೈಕೊಳ್ಳದವರು ದುಷ್ಟರನ್ನು ಹೊಗಳುವರು,</para>
  <para style="q2" vid="PRO 28:4">ಕೈಕೊಳ್ಳುವವರು ಅವರನ್ನು ಎದುರಿಸುವರು.<verse eid="PRO 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5"/>ಕೆಟ್ಟವರು ನ್ಯಾಯವನ್ನು ಗ್ರಹಿಸರು,</para>
  <para style="q2" vid="PRO 28:5">ಯೆಹೋವನ ಭಕ್ತರು ಸಮಸ್ತವನ್ನು ಗ್ರಹಿಸುವರು.<verse eid="PRO 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6"/>ವಕ್ರಮಾರ್ಗಿಯಾದ ಐಶ್ವರ್ಯವಂತನಿಗಿಂತ,</para>
  <para style="q2" vid="PRO 28:6">ನಿರ್ದೋಷವಾಗಿ ನಡೆಯುವ ದರಿದ್ರನು ಶ್ರೇಷ್ಠನು.<verse eid="PRO 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7"/>ಧರ್ಮೋಪದೇಶವನ್ನು ಕೈಕೊಳ್ಳುವವನು ವಿವೇಕಿಯಾದ ಮಗನು,</para>
  <para style="q2" vid="PRO 28:7">ಹೊಟ್ಟೆಬಾಕರ ಗೆಳೆಯನು ತಂದೆಯ ಮಾನವನ್ನು ಕಳೆಯುವನು.<verse eid="PRO 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8"/>ಬಡ್ಡಿ ಮತ್ತು ಅನ್ಯಾಯ ಲಾಭದಿಂದ ವೃದ್ಧಿಯಾದ ಆಸ್ತಿಯು</para>
  <para style="q2" vid="PRO 28:8">ಬಡವರಲ್ಲಿ ಕನಿಕರಪಡುವವನ ಪಾಲಾಗುವುದು.<verse eid="PRO 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9"/>ಧರ್ಮೋಪದೇಶಕ್ಕೆ ಕಿವಿಗೊಡದವನು</para>
  <para style="q2" vid="PRO 28:9">ಮಾಡುವ ದೇವಪ್ರಾರ್ಥನೆಯೂ ಅಸಹ್ಯ.<verse eid="PRO 28:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10"/>ಯಥಾರ್ಥವಂತರನ್ನು ದುರ್ಮಾರ್ಗಕ್ಕೆ ಎಳೆಯುವವನು,</para>
  <para style="q2" vid="PRO 28:10">ತಾನು ತೋಡಿದ ಗುಂಡಿಯಲ್ಲಿ ತಾನೇ ಬೀಳುವನು,</para>
  <para style="q2" vid="PRO 28:10">ನಿರ್ದೋಷಿಗಳಿಗೋ ಸುಖವು ಸೊತ್ತಾಗುವುದು.<verse eid="PRO 28:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11"/>ಐಶ್ವರ್ಯವಂತನು ತಾನು ಜ್ಞಾನಿಯೆಂದೆಣಿಸಿಕೊಳ್ಳುವನು,</para>
  <para style="q2" vid="PRO 28:11">ವಿವೇಕಿಯಾದ ಬಡವನು ಅವನನ್ನು ಇಂಥವನೆಂದು ಗೊತ್ತುಮಾಡುವನು.<verse eid="PRO 28:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12"/>ಶಿಷ್ಟರಿಗೆ ಉಲ್ಲಾಸವಾದರೆ ದೊಡ್ಡ ಸಂಭ್ರಮವಾಗುವುದು,</para>
  <para style="q2" vid="PRO 28:12">ದುಷ್ಟರಿಗೆ ಏಳಿಗೆಯಾದರೆ ಜನರು ಅಡಗಿಕೊಳ್ಳುವರು.<verse eid="PRO 28:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13"/>ದೋಷಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವವನಿಗೆ ಶುಭವಾಗದು,</para>
  <para style="q2" vid="PRO 28:13">ಅವುಗಳನ್ನು ಒಪ್ಪಿಕೊಂಡು ಬಿಟ್ಟುಬಿಡುವವನಿಗೆ ಕರುಣೆ ದೊರೆಯುವುದು.<verse eid="PRO 28:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14"/>ಕೆಟ್ಟದನ್ನು ಮಾಡುವುದಕ್ಕೆ ಯಾವಾಗಲೂ ಭಯಪಡುವವನು<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="fq" closed="false">ಯಾವಾಗಲೂ ಭಯಪಡುವವನು </char><char style="ft" closed="false">ಅಥವಾ ಯೆಹೋವನಿಗೆ ಭಯಪಡುವವನು.</char></note> ಧನ್ಯನು,</para>
  <para style="q2" vid="PRO 28:14">ಕಠಿಣಹೃದಯನು ಕೇಡಿಗೆ ಸಿಕ್ಕಿಬೀಳುವನು.<verse eid="PRO 28:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15"/>ಬಡವರಾದ ಪ್ರಜೆಗಳನ್ನು ಆಳುವ ದುಷ್ಟರಾಜನು,</para>
  <para style="q2" vid="PRO 28:15">ಗರ್ಜಿಸುವ ಸಿಂಹ ಮತ್ತು ಹುಡುಕಾಡುವ ಕರಡಿಯಂತೆ.<verse eid="PRO 28:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16"/>ವಿವೇಕಶೂನ್ಯನಾದ ಒಡೆಯನು ಮಹಾ ಹಿಂಸಕನು,</para>
  <para style="q2" vid="PRO 28:16">ದೋಚಿಕೊಳ್ಳದವನು ದೀರ್ಘಾಯುಷ್ಯನು.<verse eid="PRO 28:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17"/>ನರಪ್ರಾಣ ತೆಗೆದ ದೋಷವನ್ನು ಕಟ್ಟಿಕೊಂಡವನು ಸಮಾಧಿಯ ಕಡೆಗೆ ಓಡುವನು,</para>
  <para style="q2" vid="PRO 28:17">ಅವನನ್ನು ಯಾರೂ ತಡೆಯಬಾರದು.<verse eid="PRO 28:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18"/>ಸನ್ಮಾರ್ಗಿಗೆ ಉದ್ಧಾರ,</para>
  <para style="q2" vid="PRO 28:18">ವಕ್ರಮಾರ್ಗಿಗೆ ತಟ್ಟನೆ ಸೋಲು.<verse eid="PRO 28:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19"/>ದುಡಿದು ಹೊಲಗೇಯುವವನಿಗೆ ಹೊಟ್ಟೆ ತುಂಬಾ ಅನ್ನ,</para>
  <para style="q2" vid="PRO 28:19">ವ್ಯರ್ಥ ಕಾರ್ಯಾಸಕ್ತನಿಗೆ ಹೊಟ್ಟೆತುಂಬಾ ಬಡತನ.<verse eid="PRO 28:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20"/>ನಂಬಿಗಸ್ತನು ಆಶೀರ್ವಾದಪೂರ್ಣನಾಗುವನು,</para>
  <para style="q2" vid="PRO 28:20">ಧನವಂತನಾಗಲು ಆತುರಪಡುವವನು ದಂಡನೆಯನ್ನು ಹೊಂದದೆ ಇರನು.<verse eid="PRO 28:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21"/>ಪಕ್ಷಪಾತವು ಅಧರ್ಮ,</para>
  <para style="q2" vid="PRO 28:21">ತುತ್ತು ಅನ್ನಕ್ಕಾಗಿಯೂ ಜನರು ದ್ರೋಹಮಾಡುವುದುಂಟು.<verse eid="PRO 28:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22"/>ಲೋಭಿಯು ಆಸ್ತಿಯನ್ನು ಗಳಿಸಲು ಆತುರಪಡುವನು,</para>
  <para style="q2" vid="PRO 28:22">ತನಗೆ ಕೊರತೆಯಾಗುವುದೆಂದು ಅರಿಯನು.<verse eid="PRO 28:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23"/>ಮುಖಸ್ತುತಿ ಮಾಡುವವನಿಗಿಂತಲೂ,</para>
  <para style="q2" vid="PRO 28:23">ಗದರಿಸುವವನು ಬಳಿಕ ಹೆಚ್ಚು ದಯಾಪಾತ್ರನಾಗುವನು.<verse eid="PRO 28:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24"/>ದೋಷವಲ್ಲವೆಂದು ತಾಯಿತಂದೆಗಳ ಧನವನ್ನು ಕದಿಯುವವನು,</para>
  <para style="q2" vid="PRO 28:24">ಕೆಡುಕನಿಗೆ ಜೊತೆಗಾರನು.<verse eid="PRO 28:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25"/>ದುರಾಶೆಯುಳ್ಳವನು ಜಗಳವನ್ನೆಬ್ಬಿಸುವನು,</para>
  <para style="q2" vid="PRO 28:25">ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡುವವನು ಪುಷ್ಟನಾಗುವನು.<verse eid="PRO 28:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26"/>ತನ್ನಲ್ಲೇ ಭರವಸವಿಡುವವನು ಮೂಢನು,</para>
  <para style="q2" vid="PRO 28:26">ಜ್ಞಾನದಿಂದ ನಡೆಯುವವನು ಉದ್ಧಾರ ಹೊಂದುವನು.<verse eid="PRO 28:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27"/>ಬಡವರಿಗೆ ದಾನಮಾಡುವವನು ಕೊರತೆಪಡನು,</para>
  <para style="q2" vid="PRO 28:27">ಅವರನ್ನು ಕಂಡು ಕಾಣದಂತೆ ಇರುವವನು<note caller="+" style="f"><char style="fr" closed="false">28:27 </char><char style="fq" closed="false">ಅವರನ್ನು ಕಂಡು ಕಾಣದಂತೆ ಇರುವವನು </char><char style="ft" closed="false">ಮೂಲತಃ ಅವರಿಗೆ ಕಣ್ಣು ಮುಚ್ಚಿಕೊಳ್ಳುವವನು. ಅದರರ್ಥ ಅವರಿಗೆ ಸಹಾಯ ಮಾಡುವುದಕ್ಕೆ ನಿರಾಕರಿಸುವವನು.</char></note> ಬಹುಶಾಪಕ್ಕೆ ಒಳಗಾಗುವನು.<verse eid="PRO 28:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28"/>ದುಷ್ಟರು ಎದ್ದರೆ ಜನರು ಅಡಗಿಕೊಳ್ಳುವರು,</para>
  <para style="q2" vid="PRO 28:28">ನಾಶನವಾದರೆ ಶಿಷ್ಟರು ವೃದ್ಧಿಯಾಗುವರು.<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1"/>ಬಹಳವಾಗಿ ಗದರಿಸಿದರೂ ತಗ್ಗದವನು,</para>
  <para style="q2" vid="PRO 29:1">ಏಳದ ಹಾಗೆ ಫಕ್ಕನೆ ಮುರಿದು ಬೀಳುವನು.<verse eid="PRO 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2"/>ಶಿಷ್ಟರ ವೃದ್ಧಿ ಜನರಿಗೆ ಉಲ್ಲಾಸ,</para>
  <para style="q2" vid="PRO 29:2">ದುಷ್ಟನ ಆಳ್ವಿಕೆ ಜನರಿಗೆ ನರಳಾಟ.<verse eid="PRO 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3"/>ಜ್ಞಾನವನ್ನು ಪ್ರೀತಿಸುವವನು ತಂದೆಯನ್ನು ಹರ್ಷಗೊಳಿಸುವನು,</para>
  <para style="q2" vid="PRO 29:3">ವೇಶ್ಯೆಯ ಸಂಗಡಿಗನು ಆಸ್ತಿಯನ್ನು ಹಾಳುಮಾಡಿಕೊಳ್ಳುವನು.<verse eid="PRO 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4"/>ನ್ಯಾಯಪಾಲಕನಾದ ರಾಜನು ದೇಶವನ್ನು ವೃದ್ಧಿಗೆ ತರುವನು,</para>
  <para style="q2" vid="PRO 29:4">ಅನ್ಯಾಯವಾಗಿ ತೆರಿಗೆಯನ್ನು ಕಸಕೊಳ್ಳುವವನು ದೇಶವನ್ನು ನಾಶಮಾಡುವನು.<verse eid="PRO 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5"/>ನೆರೆಯವನೊಂದಿಗೆ ವಂಚನೆಯ ಸವಿನುಡಿಗಳನ್ನು ಆಡುವವನು,</para>
  <para style="q2" vid="PRO 29:5">ಅವನ ಹೆಜ್ಜೆಗೆ ಬಲೆಯನ್ನೊಡ್ಡುವನು.<verse eid="PRO 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6"/>ಕೆಟ್ಟವನ ದುರ್ಮಾರ್ಗದಲ್ಲಿ ಉರುಲುಂಟು,</para>
  <para style="q2" vid="PRO 29:6">ಒಳ್ಳೆಯವನು ಉಲ್ಲಾಸಗೊಂಡು ಹರ್ಷಧ್ವನಿಗೈಯುವನು.<verse eid="PRO 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7"/>ಶಿಷ್ಟನು ಬಡವರ ನ್ಯಾಯವನ್ನು ತಿಳಿದಿರುವನು,</para>
  <para style="q2" vid="PRO 29:7">ದುಷ್ಟನಿಗೆ ಅದನ್ನು ಗ್ರಹಿಸುವಷ್ಟು ವಿವೇಕವಿಲ್ಲ.<verse eid="PRO 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8"/>ಧರ್ಮನಿಂದಕರು ಪಟ್ಟಣಕ್ಕೆ ಬೆಂಕಿಯನ್ನು ಹತ್ತಿಸುವರು,</para>
  <para style="q2" vid="PRO 29:8">ಜ್ಞಾನಿಗಳೋ ರೋಷಾಗ್ನಿಯನ್ನು ಆರಿಸುವರು.<verse eid="PRO 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9"/>ಮೂರ್ಖನ ಸಂಗಡ ಜ್ಞಾನಿಯು ವ್ಯಾಜ್ಯವಾಡುವಾಗ,</para>
  <para style="q2" vid="PRO 29:9">ರೇಗಿದರೂ, ನಕ್ಕರೂ ಜಗಳವು ತೀರುವುದಿಲ್ಲ.<verse eid="PRO 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10"/>ಕೊಲೆಪಾತಕರು ನಿರ್ದೋಷಿಯನ್ನು ದ್ವೇಷಿಸುವರು,</para>
  <para style="q2" vid="PRO 29:10">ಯಥಾರ್ಥವಂತನ ಪ್ರಾಣಕ್ಕೂ ಹೊಂಚುಹಾಕುವರು.<verse eid="PRO 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11"/>ಮೂಢನು ತನ್ನ ಕೋಪವನ್ನೆಲ್ಲಾ ತೋರಿಸುವನು,</para>
  <para style="q2" vid="PRO 29:11">ಜ್ಞಾನಿಯು ತನ್ನ ಕೋಪವನ್ನು ತಡೆದು ಶಮನಪಡಿಸಿಕೊಳ್ಳುವನು.<verse eid="PRO 29:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12"/>ಸುಳ್ಳಿಗೆ ಕಿವಿಗೊಡುವ ಅಧಿಪತಿಯ ಸೇವಕರೆಲ್ಲಾ ದುಷ್ಟರೇ.<verse eid="PRO 29:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13"/>ತಗ್ಗುವವನು, ತಗ್ಗಿಸುವವನು ಸ್ಥಿತಿಯಲ್ಲಿ ಎದುರುಬದುರಾಗಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PRO 29:13">ಯೆಹೋವನೇ ಅವರಿಬ್ಬರ ಕಣ್ಣುಗಳಿಗೆ ಕಳೆಕೊಟ್ಟವನು.<verse eid="PRO 29:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14"/>ಬಡವರನ್ನು ನ್ಯಾಯವಾಗಿ ಆಳ್ವಿಕೆ ಮಾಡುವ</para>
  <para style="q2" vid="PRO 29:14">ರಾಜನ ಸಿಂಹಾಸನವು ಶಾಶ್ವತವು.<verse eid="PRO 29:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15"/>ಬೆತ್ತ ಮತ್ತು ಬೆದರಿಕೆಗಳಿಂದ ಜ್ಞಾನವುಂಟಾಗುವುದು,</para>
  <para style="q2" vid="PRO 29:15">ಶಿಕ್ಷಿಸದೆ ಬಿಟ್ಟ ಹುಡುಗನು ತಾಯಿಯ ಮಾನವನ್ನು ಕಳೆಯುವನು.<verse eid="PRO 29:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16"/>ದುಷ್ಟರ ವೃದ್ಧಿ ಪಾಪವೃದ್ಧಿ,</para>
  <para style="q2" vid="PRO 29:16">ಶಿಷ್ಟರೋ ಅವರ ಬೀಳುವಿಕೆಯನ್ನು ಕಣ್ಣಾರೆ ನೋಡುವರು.<verse eid="PRO 29:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17"/>ಮಗನನ್ನು ಶಿಕ್ಷಿಸು, ಅವನು ನಿನ್ನನ್ನು ಸಂತೋಷಪಡಿಸುವನು,</para>
  <para style="q2" vid="PRO 29:17">ಅವನೇ ನಿನ್ನ ಆತ್ಮಕ್ಕೆ ಮೃಷ್ಟಾನ್ನವಾಗುವನು.<verse eid="PRO 29:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18"/>ದೇವದರ್ಶನ ಇಲ್ಲದಿರುವಲ್ಲಿ ಜನರು ನಾಶವಾಗುವರು,</para>
  <para style="q2" vid="PRO 29:18">ಧರ್ಮೋಪದೇಶವನ್ನು ಕೈಕೊಳ್ಳುವವನೋ ಧನ್ಯನಾಗುವನು.<verse eid="PRO 29:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19"/>ಆಳು ಮಾತಿನಿಂದ ಮಾತ್ರ ಶಿಕ್ಷಿತನಾಗಲಾರನು,</para>
  <para style="q2" vid="PRO 29:19">ಅವನು ತಿಳಿದುಕೊಂಡರೂ ಗಮನಿಸನು.<verse eid="PRO 29:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20"/>ದುಡುಕಿ ಮಾತನಾಡುವವನನ್ನು ನೋಡು,</para>
  <para style="q2" vid="PRO 29:20">ಅಂಥವನಿಗಿಂತಲೂ ಮೂಢನ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚು ನಿರೀಕ್ಷೆಯನ್ನು ಇಡಬಹುದು.<verse eid="PRO 29:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21"/>ಆಳನ್ನು ಬಾಲ್ಯದಿಂದ ಕೋಮಲವಾಗಿ ಸಾಕಿದರೆ,</para>
  <para style="q2" vid="PRO 29:21">ತರುವಾಯ ಅವನು ಎದುರುಬೀಳುವನು.<verse eid="PRO 29:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22"/>ಕೋಪಿಷ್ಠನು ಜಗಳವನ್ನೆಬ್ಬಿಸುವನು,</para>
  <para style="q2" vid="PRO 29:22">ಕ್ರೋಧಶೀಲನು ದೋಷಭರಿತನು.<verse eid="PRO 29:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23"/>ಗರ್ವವು ಮನುಷ್ಯನನ್ನು ದೀನಸ್ಥಿತಿಗೆ ತರುವುದು,</para>
  <para style="q2" vid="PRO 29:23">ದೀನಮನಸ್ಸುಳ್ಳವನು ಮಾನವನ್ನು ಪಡೆಯುವನು.<verse eid="PRO 29:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24"/>ಕಳ್ಳನೊಂದಿಗೆ ಪಾಲುಗಾರನಾದವನು ತನಗೆ ತಾನೇ ಶತ್ರು,</para>
  <para style="q2" vid="PRO 29:24">ಆಣೆಯಿಡುವುದನ್ನು ಕೇಳಿದರೂ ಸುಮ್ಮನಿರುವನು.<verse eid="PRO 29:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25"/>ಮನುಷ್ಯನ ಭಯ ಉರುಲು,</para>
  <para style="q2" vid="PRO 29:25">ಯೆಹೋವನ ಭರವಸ ಉದ್ಧಾರ.<verse eid="PRO 29:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26"/>ಅನೇಕರು ನ್ಯಾಯಾಧಿಪತಿಯ ಕಟಾಕ್ಷವನ್ನು ಕೋರುವರು,</para>
  <para style="q2" vid="PRO 29:26">ನ್ಯಾಯತೀರ್ಪು ಯೆಹೋವನಿಂದಲೇ ಆಗುವುದು.<verse eid="PRO 29:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27"/>ಶಿಷ್ಟರಿಗೆ ದುರ್ಮಾರ್ಗಿಯು ಅಸಹ್ಯನು,</para>
  <para style="q2" vid="PRO 29:27">ದುಷ್ಟರಿಗೆ ಸರಳಮಾರ್ಗಿಯು ಅಸಹ್ಯನು.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s">ಆಗೂರನ ಮಾತುಗಳು</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>ದೈವೋಕ್ತಿ. ಯಾಕೆ<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="fq" closed="false">ಯಾಕೆ </char><char style="ft" closed="false">ಜಾಕೆ</char></note> ಎಂಬುವವನ ಮಗನಾದ ಆಗೂರನ ಮಾತುಗಳು. ಇವನು ಇಥಿಯೇಲನಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="fq" closed="false">ಇಥಿಯೇಲ </char><char style="ft" closed="false">ಅಂದರೆ ಓ ದೇವರೇ ನಾನು ದಣಿದಿದ್ದೇನೆ. </char></note>, ಇಥಿಯೇಲನಿಗೂ ಉಕ್ಕಾಲನಿಗೂ<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="fq" closed="false">ಉಕ್ಕಾಲ </char><char style="ft" closed="false">ಅಂದರೆ ನಾನು ಸಂಪೂರ್ಣವಾಗಿ ದಣಿದಿದ್ದೇನೆ.</char></note> ಹೀಗೆ ಹೇಳಿದನು.<verse eid="PRO 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2"/>ಮನುಷ್ಯರಲ್ಲಿ ನನ್ನಂಥ ಪಶುಪ್ರಾಯನು ಇಲ್ಲವಷ್ಟೆ,</para>
  <para style="q2" vid="PRO 30:2">ಮಾನುಷ ವಿವೇಕವು ನನಗಿಲ್ಲ.<verse eid="PRO 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3"/>ನಾನು ಜ್ಞಾನವನ್ನು ಪಡೆದುಕೊಂಡಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 30:3">ಪರಿಶುದ್ಧನ ವಿಷಯವಾದ ತಿಳಿವಳಿಕೆಯನ್ನು ಹೊಂದಿಲ್ಲ.<verse eid="PRO 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4"/>ಆಕಾಶಕ್ಕೆ ಏರಿ ಇಳಿದಿರುವವನಾರು?</para>
  <para style="q2" vid="PRO 30:4">ಮುಷ್ಠಿಯಲ್ಲಿ ಗಾಳಿಯನ್ನು ಕೂಡಿಸಿರುವವರು ಯಾರು?</para>
  <para style="q2" vid="PRO 30:4">ತನ್ನ ಬಟ್ಟೆಯಲ್ಲಿ ನೀರನ್ನು ಮೂಟೆಕಟ್ಟಿರುವವರು ಯಾರು?</para>
  <para style="q2" vid="PRO 30:4">ಭೂಮಿಯ ಎಲ್ಲೆಗಳನ್ನೆಲ್ಲಾ ಸ್ಥಾಪಿಸಿರುವವರು ಯಾರು?</para>
  <para style="q2" vid="PRO 30:4">ಅವನ ಹೆಸರೇನು? ಅವನ ಮಗನ ಹೆಸರೇನು? ನೀನೇ ಬಲ್ಲವನು.<verse eid="PRO 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5"/>ದೇವರ ಪ್ರತಿಯೊಂದು ಮಾತು ಶುದ್ಧವಾದದ್ದು,</para>
  <para style="q2" vid="PRO 30:5">ಆತನು ಶರಣಾಗತರಿಗೆ ಗುರಾಣಿಯಾಗಿದ್ದಾನೆ.<verse eid="PRO 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6"/>ಆತನ ಮಾತುಗಳಿಗೆ ಯಾವುದನ್ನೂ ಸೇರಿಸಬೇಡ,</para>
  <para style="q2" vid="PRO 30:6">ಆತನು ನಿನ್ನನ್ನು ಖಂಡಿಸುವಾಗ ನೀನು ಸುಳ್ಳುಗಾರನೆಂದು ತೋರಿಬಂದೀಯೆ.<verse eid="PRO 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7"/>ನಿನ್ನಿಂದ ಎರಡು ವರಗಳನ್ನು ಬೇಡಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q2" vid="PRO 30:7">ಅನುಗ್ರಹಿಸದಿರಬೇಡ, ನಾನು ಸಾಯುವುದರೊಳಗಾಗಿ ಅವುಗಳನ್ನು ಕೈಗೂಡಿಸು.<verse eid="PRO 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8"/>ನನ್ನಿಂದ ಕಪಟವನ್ನೂ, ಸುಳ್ಳುಮಾತನ್ನೂ ತೊಲಗಿಸು,</para>
  <para style="q2" vid="PRO 30:8">ಬಡತನವನ್ನಾಗಲಿ, ಐಶ್ವರ್ಯವನ್ನಾಗಲಿ ಕೊಡದೆ ನನಗೆ ತಕ್ಕಷ್ಟು ಆಹಾರವನ್ನು ಭೋಜನಮಾಡಿಸು.<verse eid="PRO 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9"/>ಹಾಗಾಗದೆ ಹೊಟ್ಟೆತುಂಬಿದವನಾದರೆ, “ಯೆಹೋವನು ಯಾರೋ?” ಎಂದು ನಿನ್ನನ್ನು ತಿರಸ್ಕರಿಸೇನು,</para>
  <para style="q2" vid="PRO 30:9">ಬಡವನಾದರೆ ಕಳ್ಳತನಮಾಡಿ ನನ್ನ ದೇವರಾದ ನಿನ್ನ ಹೆಸರನ್ನು ಅಯೋಗ್ಯವಾಗಿ ಎತ್ತೆನು.<verse eid="PRO 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10"/>ಆಳಿನ ಮೇಲೆ ದಣಿಗೆ ದೂರನ್ನು ಹೇಳಬೇಡ,</para>
  <para style="q2" vid="PRO 30:10">ಅವನು ಶಪಿಸಾನು, ನಿನ್ನಲ್ಲೇ ದೋಷವು ಕಂಡು ಬಂದೀತು.<verse eid="PRO 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11"/>ತಾಯಿಗೆ ಶುಭವನ್ನು ಕೋರದೆ,</para>
  <para style="q2" vid="PRO 30:11">ತಂದೆಯನ್ನು ಶಪಿಸುವ ಒಂದು ತರದವರು ಉಂಟು.<verse eid="PRO 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12"/>ತಮ್ಮ ಕೊಳೆಯನ್ನು ತೊಳಕೊಳ್ಳದೆ ತಾವೇ ಶುದ್ಧರೆಂದು,</para>
  <para style="q2" vid="PRO 30:12">ಎಣಿಸಿಕೊಳ್ಳುವ ಬೇರೊಂದು ತರದವರು ಉಂಟು.<verse eid="PRO 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13"/>ಕಣ್ಣುರೆಪ್ಪೆಗಳನ್ನೆತ್ತಿಕೊಂಡು, ಎಷ್ಟೋ ಮೇಲೆ</para>
  <para style="q2" vid="PRO 30:13">ಎಷ್ಟೋ ಮೇಲೆ ಮೇಲೆಯೇ ನೋಡುತ್ತಿರುವ ಇನ್ನೊಂದು ತರದವರು ಉಂಟು.<verse eid="PRO 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14"/>ಖಡ್ಗದಂತಿರುವ ಹಲ್ಲುಗಳೂ ಕತ್ತಿಯಂತಿರುವ ಕೋರೆಗಳೂ ಉಳ್ಳವರಾಗಿ</para>
  <para style="q2" vid="PRO 30:14">ಭೂಮಿಯೊಳಗಿಂದ ಬಡವರನ್ನೂ, ಮನುಷ್ಯರ ಮಧ್ಯದೊಳಗಿಂದ ದಿಕ್ಕಿಲ್ಲದವರನ್ನೂ,</para>
  <para style="q2" vid="PRO 30:14">ಅಗೆದು ನುಂಗಿಬಿಡುವ ಮತ್ತೊಂದು ತರದವರು ಉಂಟು.<verse eid="PRO 30:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15"/>ಕೊಡು, ಕೊಡು ಅನ್ನುವ ಎರಡು ಹೆಣ್ಣು ಮಕ್ಕಳು ಜಿಗಣೆಗೆ ಉಂಟು.</para>
  <para style="q2" vid="PRO 30:15">ತೃಪ್ತಿಪಡದವುಗಳು ಮೂರು ಉಂಟು,</para>
  <para style="q2" vid="PRO 30:15">ಹೌದು, ಸಾಕೆನ್ನದವುಗಳು ನಾಲ್ಕು ಉಂಟು.<verse eid="PRO 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16"/>ಯಾವುವೆಂದರೆ, ಪಾತಾಳ, ಹೆರದ ಗರ್ಭ,</para>
  <para style="q2" vid="PRO 30:16">ನೀರಿನಿಂದ ತೃಪ್ತಿಪಡದ ಭೂಮಿ,</para>
  <para style="q2" vid="PRO 30:16">ಸಾಕಾಯಿತೆಂದು ಹೇಳದ ಬೆಂಕಿ, ಇವೇ.<verse eid="PRO 30:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17"/>ತಂದೆಯನ್ನು ಹಾಸ್ಯಮಾಡಿ ತಾಯಿಯ ಅಪ್ಪಣೆಯನ್ನು,</para>
  <para style="q2" vid="PRO 30:17">ಧಿಕ್ಕರಿಸುವವನ ಕಣ್ಣನ್ನು,</para>
  <para style="q2" vid="PRO 30:17">ಹಳ್ಳಕೊಳ್ಳದ ಕಾಗೆಗಳು ಕುಕ್ಕುವವು, ರಣಹದ್ದುಗಳು ತಿಂದುಬಿಡುವವು.<verse eid="PRO 30:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18"/>ಮೂರು ವಿಷಯಗಳು ನನ್ನ ಬುದ್ಧಿಯನ್ನು ಮೀರಿವೆ,</para>
  <para style="q2" vid="PRO 30:18">ಹೌದು, ನಾಲ್ಕನ್ನು ಗ್ರಹಿಸಲಾರೆನು;<verse eid="PRO 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19"/>ಯಾವುವೆಂದರೆ, ಆಕಾಶದಲ್ಲಿ ಹದ್ದಿನ ಹಾದಿ,</para>
  <para style="q2" vid="PRO 30:19">ಬಂಡೆಯ ಮೇಲೆ ಸರ್ಪದ ಸರಣಿ,</para>
  <para style="q2" vid="PRO 30:19">ಸಾಗರದ ನಡುವೆ ಹಡಗಿನ ಮಾರ್ಗ,</para>
  <para style="q2" vid="PRO 30:19">ಸ್ತ್ರೀಯಲ್ಲಿ ಪುರುಷನ ಪದ್ಧತಿ, ಇವೇ.<verse eid="PRO 30:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20"/>ಜಾರಳ ನಡತೆಯು ಹೀಗೆಯೇ ಸರಿ,</para>
  <para style="q2" vid="PRO 30:20">ಅವಳು ತಿಂದು ಬಾಯಿ ಒರೆಸಿಕೊಂಡು,</para>
  <para style="q2" vid="PRO 30:20">“ನಾನು ತಪ್ಪುಮಾಡಲಿಲ್ಲವಲ್ಲವೆ” ಅಂದುಕೊಳ್ಳುವಳು.<verse eid="PRO 30:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21"/>ಮೂರರ ಭಾರದಿಂದ ಭೂಮಿಯು ಕಂಪಿಸುತ್ತದೆ,</para>
  <para style="q2" vid="PRO 30:21">ಹೌದು, ನಾಲ್ಕರ ಹೊರೆಯನ್ನು ತಾಳಲಾರದು.<verse eid="PRO 30:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22"/>ಯಾವುವೆಂದರೆ, ಪಟ್ಟಕ್ಕೆ ಬಂದ ದಾಸನು,</para>
  <para style="q2" vid="PRO 30:22">ಹೊಟ್ಟೆತುಂಬಿದ ನೀಚನು,<verse eid="PRO 30:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23"/>ಮದುವೆಯಾದ ಚಂಡಿಯು,</para>
  <para style="q2" vid="PRO 30:23">ಸವತಿಯಾದ ತೊತ್ತು, ಇವೇ.<verse eid="PRO 30:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24"/>ಭೂಮಿಯ ಮೇಲೆ ಅಧಿಕ ಜ್ಞಾನವುಳ್ಳ ನಾಲ್ಕು ಸಣ್ಣ ಜಂತುಗಳುಂಟು.<verse eid="PRO 30:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25"/>ಇರುವೆಗಳು ದುರ್ಬಲಜಾತಿಯಾವಾದರೂ,</para>
  <para style="q2" vid="PRO 30:25">ಸುಗ್ಗಿಯಲ್ಲಿ ತಮ್ಮ ಆಹಾರವನ್ನು ಸಿದ್ಧಮಾಡಿಕೊಳ್ಳುವವು.<verse eid="PRO 30:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26"/>ಬೆಟ್ಟದ ಮೊಲಗಳು ದೊಡ್ಡ ಜಾತಿಯಲ್ಲದಿದ್ದರೂ,</para>
  <para style="q2" vid="PRO 30:26">ಬಂಡೆಗಳಲ್ಲಿ ತಮ್ಮ ಮನೆಗಳನ್ನು ಮಾಡಿಕೊಳ್ಳುವವು.<verse eid="PRO 30:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27"/>ಮಿಡತೆಗಳಿಗೆ ಅರಸನಿಲ್ಲ,</para>
  <para style="q2" vid="PRO 30:27">ಆದರೂ ಅವೆಲ್ಲಾ ದಂಡುದಂಡಾಗಿ ಹೊರಡುವವು.<verse eid="PRO 30:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28"/>ಹಲ್ಲಿಯನ್ನು<note caller="+" style="f"><char style="fr" closed="false">30:28 </char><char style="fq" closed="false">ಹಲ್ಲಿಯನ್ನು</char><char style="ft" closed="false">ಅಥವಾ ಜೇಡರಹುಳವು ಬಲೆಯನ್ನು ತನ್ನ ಕೈಯಿಂದ ಹೆಣೆಯುತ್ತದೆ.</char></note> ಅಂಗೈಯಿಂದ ಹಿಡಿಯಬಹುದಾದರೂ,</para>
  <para style="q2" vid="PRO 30:28">ಅದು ಅರಮನೆಗಳಲ್ಲಿ ವಾಸಮಾಡುವುದು.<verse eid="PRO 30:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29"/>ಗಂಭೀರಾಗಮನದ ಮೂರು ಪ್ರಾಣಿಗಳುಂಟು,</para>
  <para style="q2" vid="PRO 30:29">ಹೌದು, ಗಂಭೀರಗತಿಯ ನಾಲ್ಕುಂಟು.<verse eid="PRO 30:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30"/>ಯಾವುದಕ್ಕೂ ಹೆದರಿ ಓರೆಯಾಗದ,</para>
  <para style="q2" vid="PRO 30:30">ಮೃಗರಾಜನಾದ ಸಿಂಹ,<verse eid="PRO 30:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31"/>ಹೆಮ್ಮೆಯಿಂದ ನಡೆಯುವ ಹುಂಜ,<note caller="+" style="f"><char style="fr" closed="false">30:31 </char><char style="fq" closed="false">ಹೆಮ್ಮೆಯಿಂದ ನಡೆಯುವ ಹುಂಜ, </char><char style="ft" closed="false">ಅಥವಾ ಬೇಟೆನಾಯಿ ಅಥವಾ ಯುದ್ಧ-ಕುದುರೆ.</char></note> ಹೋತವು ಸಹ,</para>
  <para style="q2" vid="PRO 30:31">ಸೈನ್ಯಸಮೇತನಾದ ರಾಜ.<verse eid="PRO 30:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32"/>ನೀನು ಉಬ್ಬಿಕೊಂಡು ಮೂರ್ಖನಾಗಿ ನಡೆದಿದ್ದರೆ,</para>
  <para style="q2" vid="PRO 30:32">ಅಥವಾ ದುರಾಲೋಚನೆಮಾಡಿದ್ದರೆ ಬಾಯಿಯ ಮೇಲೆ ಕೈಯಿಟ್ಟುಕೋ.<verse eid="PRO 30:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33"/>ಹಾಲು ಕಡೆಯುವುದರಿಂದ ಬೆಣ್ಣೆ,</para>
  <para style="q2" vid="PRO 30:33">ಮೂಗು ಹಿಂಡುವುದರಿಂದ ರಕ್ತ,</para>
  <para style="q2" vid="PRO 30:33">ಕೋಪಕಲಕುವುದರಿಂದ ಜಗಳ.<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s">ಅರಸನಾದ ಲೆಮೂವೇಲನ ಮಾತುಗಳು</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 31:1"/>ಅರಸನಾದ ಲೆಮೂವೇಲನ ಮಾತುಗಳು, ಅಂದರೆ ಅವನ ತಾಯಿಯು ಅವನಿಗೆ ಉಪದೇಶಿಸಿದ ದೈವೋಕ್ತಿಯು,<verse eid="PRO 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2"/>ಏನು, ಕಂದಾ? ನನ್ನ ಗರ್ಭಪುತ್ರನೇ,</para>
  <para style="q2" vid="PRO 31:2">ಏನು, ನನ್ನ ಹರಕೆಯ ಮಗುವೇ, ನಾನು ಏನು ಹೇಳಲಿ?<verse eid="PRO 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3"/>ನಿನ್ನ ತ್ರಾಣವನ್ನು ಸ್ತ್ರೀಯರಿಗೆ ಒಪ್ಪಿಸಬೇಡ,</para>
  <para style="q2" vid="PRO 31:3">ರಾಜರಿಗೆ ವಿನಾಶಕರವಾದ ದಾರಿಗೆ ತಿರುಗಬೇಡ.<verse eid="PRO 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4"/>ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುವುದು ರಾಜರಿಗೆ ಯೋಗ್ಯವಲ್ಲ,</para>
  <para style="q2" vid="PRO 31:4">ಲೆಮೂವೇಲನೇ, ಅದು ರಾಜರಿಗೆ ಯೋಗ್ಯವಲ್ಲ,</para>
  <para style="q2" vid="PRO 31:4">“ಮದ್ಯವೆಲ್ಲಿ?” ಎನ್ನುವುದು ಪ್ರಭುಗಳಿಗೆ ವಿಹಿತವಲ್ಲ.<verse eid="PRO 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5"/>ಕುಡಿದರೆ ಅವರು ಧರ್ಮನಿಯಮಗಳನ್ನು ಮರೆತುಬಿಟ್ಟು,</para>
  <para style="q2" vid="PRO 31:5">ಬಾಧೆಪಡುವವರೆಲ್ಲರ ನ್ಯಾಯವನ್ನು ವ್ಯತ್ಯಾಸಮಾಡುವರು.<verse eid="PRO 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6"/>ಮದ್ಯವನ್ನು ಗತಿಯಿಲ್ಲದವನಿಗೂ,</para>
  <para style="q2" vid="PRO 31:6">ದ್ರಾಕ್ಷಾರಸವನ್ನು ಮನೋವ್ಯಥೆಪಡುವವನಿಗೂ ಕೊಟ್ಟರೆ ಕೊಡು.<verse eid="PRO 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7"/>ಕುಡಿದು ಬಡತನವನ್ನು ಮರೆತುಬಿಡಲಿ,</para>
  <para style="q2" vid="PRO 31:7">ಶ್ರಮೆಯನ್ನು ಇನ್ನೂ ಜ್ಞಾಪಕಕ್ಕೆ ತಾರದಿರಲಿ.<verse eid="PRO 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8"/>ಬಾಯಿಲ್ಲದವರಿಗೂ, ಹಾಳಾಗಿ ಹೋಗುತ್ತಿರುವವರೆಲ್ಲರಿಗೂ,</para>
  <para style="q2" vid="PRO 31:8">ನ್ಯಾಯವಾಗುವಂತೆ ಬಾಯಿ ತೆರೆ.<verse eid="PRO 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9"/>ಬಾಯನ್ನು ತೆರೆದು ನ್ಯಾಯವನ್ನು ತೀರಿಸು,</para>
  <para style="q2" vid="PRO 31:9">ದೀನದರಿದ್ರರ ವ್ಯಾಜ್ಯ ಮಾಡು.<verse eid="PRO 31:9"/></para>
  <para style="s">ಗುಣವತಿಯಾದ ಸತಿ</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10"/>ಗುಣವತಿಯಾದ ಸತಿಯು ಎಲ್ಲಿ ಸಿಕ್ಕುವಳು?</para>
  <para style="q2" vid="PRO 31:10">ಆಕೆಯು ಹವಳಕ್ಕಿಂತಲೂ ಬಹೂ ಅಮೂಲ್ಯಳು.<verse eid="PRO 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11"/>ಪತಿಯ ಹೃದಯವು ಆಕೆಯಲ್ಲಿ ಭರವಸವಿಡುವುದು,</para>
  <para style="q2" vid="PRO 31:11">ಅವನು ಕೊಳ್ಳೆ ಕೊಳ್ಳೆಯಾಗಿ ಸಂಪಾದಿಸುವನು.<verse eid="PRO 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12"/>ಆಕೆಯು ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಅವನಿಗೆ ಅಹಿತವನ್ನು ಮಾಡದೆ,</para>
  <para style="q2" vid="PRO 31:12">ಹಿತವನ್ನೇ ಮಾಡುತ್ತಿರುವಳು.<verse eid="PRO 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13"/>ಉಣ್ಣೆಯನ್ನೂ, ಸೆಣಬನ್ನೂ ಹುಡುಕಿ ತಂದು,</para>
  <para style="q2" vid="PRO 31:13">ಕೈಕೆಲಸವನ್ನು ಆಸಕ್ತಿಯಿಂದ ಮಾಡುವಳು.<verse eid="PRO 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14"/>ವ್ಯಾಪಾರದ ಹಡಗುಗಳಂತೆ,</para>
  <para style="q2" vid="PRO 31:14">ದೂರದಿಂದ ಬೇಕಾದ ಆಹಾರವನ್ನು ತರುವಳು.<verse eid="PRO 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15"/>ಇನ್ನೂ ಕತ್ತಲಿರುವಾಗಲೇ ಎದ್ದು,</para>
  <para style="q2" vid="PRO 31:15">ಮನೆಯವರಿಗೆ ಆಹಾರವನ್ನು, ನೀಡುವಳು</para>
  <para style="q2" vid="PRO 31:15">ದಾಸಿಯರಿಗೆ ದಿನದ ಕೆಲಸಗಳನ್ನು ಹಂಚುವಳು.<verse eid="PRO 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16"/>ಹೊಲವನ್ನು ನೋಡಿ ಯೋಚಿಸಿ ಕೊಂಡುಕೊಳ್ಳುವಳು,</para>
  <para style="q2" vid="PRO 31:16">ತನ್ನ ಕೈಗೆಲಸದ ಲಾಭದಿಂದ ದ್ರಾಕ್ಷಿತೋಟವನ್ನು ಮಾಡಿಸುವಳು.<verse eid="PRO 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17"/>ನಡುವಿನ ಬಲವೆಂಬ ಪಟ್ಟಿಯನ್ನು ಕಟ್ಟಿಕೊಂಡು,</para>
  <para style="q2" vid="PRO 31:17">ತೋಳುಗಳನ್ನು ಶಕ್ತಿಗೊಳಿಸುವಳು.<verse eid="PRO 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18"/>ವಿವೇಚಿಸಿ ಬಹುಲಾಭವಾಯಿತೆಂದು ತಿಳುಕೊಳ್ಳುವಳು,</para>
  <para style="q2" vid="PRO 31:18">ಆಕೆಯ ದೀಪವು ರಾತ್ರಿಯಲ್ಲೆಲ್ಲಾ ಆರದು.<verse eid="PRO 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19"/>ರಾಟೆಯ ಮೇಲೆ ಕೈ ಹಾಕಿ,</para>
  <para style="q2" vid="PRO 31:19">ಕದರನ್ನು ಹಿಡಿಯುವಳು.<verse eid="PRO 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20"/>ಬಡವರಿಗಾಗಿ ಕೈ ಬಿಚ್ಚಿ,</para>
  <para style="q2" vid="PRO 31:20">ದಿಕ್ಕಿಲ್ಲದವರಿಗೆ ಕೈ ನೀಡುವಳು.<verse eid="PRO 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21"/>ಮನೆಯವರೆಲ್ಲರಿಗೂ ಸಕಲಾತಿಯನ್ನು ಹೊದಿಸಿರುವುದರಿಂದ,</para>
  <para style="q2" vid="PRO 31:21">ಅವರ ವಿಷಯವಾಗಿ ಆಕೆಗೆ ಹಿಮದ ಭಯವಿಲ್ಲ.<verse eid="PRO 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22"/>ತನಗಾಗಿ ರತ್ನಗಂಬಳಿಗಳನ್ನು ಮಾಡುವಳು,</para>
  <para style="q2" vid="PRO 31:22">ಆಕೆಯ ಉಡುಪು ನಾರುಮಡಿ, ರಕ್ತಾಂಬರ.<verse eid="PRO 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23"/>ಆಕೆಯ ಪತಿಯು ನ್ಯಾಯಸ್ಥಾನದಲ್ಲಿ,</para>
  <para style="q2" vid="PRO 31:23">ದೇಶದ ಹಿರಿಯರ ಮಧ್ಯದಲ್ಲಿ ಕುಳಿತಿರುವಾಗ ಪ್ರಸಿದ್ಧನಾಗಿ ಕಾಣುವನು.<verse eid="PRO 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24"/>ಹಚ್ಚಡಗಳನ್ನು ನೆಯ್ದು ಮಾರಾಟಮಾಡುವಳು,</para>
  <para style="q2" vid="PRO 31:24">ನಡುಕಟ್ಟುಗಳನ್ನು ವರ್ತಕನಿಗೆ ಒದಗಿಸುವಳು.<verse eid="PRO 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25"/>ಬಲವನ್ನು, ತೇಜಸ್ಸನ್ನು ಹೊದ್ದುಕೊಂಡಿರುವಳು,</para>
  <para style="q2" vid="PRO 31:25">ಭವಿಷ್ಯತ್ತಿನ ಭಯವಿಲ್ಲದೆ ನಗುತ್ತಿರುವಳು.<verse eid="PRO 31:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26"/>ಬಾಯಿದೆರೆದು ಜ್ಞಾನವನ್ನು ತೋರ್ಪಡಿಸುವಳು.</para>
  <para style="q2" vid="PRO 31:26">ಆಕೆಯ ನಾಲಿಗೆಯು ಬುದ್ಧಿಯನ್ನು ಪ್ರೀತಿಪೂರ್ವಕವಾಗಿ ಹೇಳುವುದು.<verse eid="PRO 31:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27"/>ಸೋಮಾರಿತನದ ಅನ್ನವನ್ನು ತಿನ್ನದೆ,</para>
  <para style="q2" vid="PRO 31:27">ಗೃಹಕೃತ್ಯಗಳನ್ನೆಲ್ಲಾ ನೋಡಿಕೊಳ್ಳುವಳು.<verse eid="PRO 31:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28"/>ಮಕ್ಕಳು ಎದ್ದುನಿಂತು ಆಕೆಯನ್ನು “ಧನ್ಯಳು” ಎಂದು ಹೇಳುವರು.<verse eid="PRO 31:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29"/>ಪತಿಯು ಸಹ, “ಬಹುಮಂದಿ ಸ್ತ್ರೀಯರು ಗುಣವತಿಯರಾಗಿ ನಡೆದಿದ್ದಾರೆ,</para>
  <para style="q2" vid="PRO 31:29">ಅವರೆಲ್ಲರಿಗಿಂತಲೂ ನೀನೇ ಶ್ರೇಷ್ಠಳು” ಎಂದು ಆಕೆಯನ್ನು ಕೊಂಡಾಡುವನು.<verse eid="PRO 31:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30"/>ಸೌಂದರ್ಯವು ನೆಚ್ಚತಕ್ಕದ್ದಲ್ಲ, ಲಾವಣ್ಯವು ನೆಲೆಯಲ್ಲ,</para>
  <para style="q2" vid="PRO 31:30">ಯೆಹೋವನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವಳೇ ಸ್ತೋತ್ರಪಾತ್ರಳು.<verse eid="PRO 31:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31"/>ಆಕೆಯ ಕೈಕೆಲಸಕ್ಕೆ ಪ್ರತಿಫಲವನ್ನು ಸಲ್ಲಿಸಿರಿ,</para>
  <para style="q2" vid="PRO 31:31">ಆಕೆಯ ಕಾರ್ಯಗಳೇ ಪುರದ್ವಾರಗಳಲ್ಲಿ ಆಕೆಯನ್ನು ಪ್ರಶಂಸಿಸಲಿ.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
