<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright © 2017 Bridge Connectivity Solutions. This translation is made available to you under the terms of the Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">ಯೋವೇಲನು</para>
  <para style="toc1">ಯೋವೇಲನು</para>
  <para style="toc2">ಯೋವೇ</para>
  <para style="toc3">ಯೋವೇ</para>
  <para style="mt">ಯೋವೇಲನು</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಪ್ರವಾದಿಯಾದ ಯೋವೇಲನು ಇದರ ಗ್ರಂಥಕರ್ತನೆಂದು (ಯೋವೇಲ 1:1) ಎಂದು ಈ ಪುಸ್ತಕವು ಹೇಳುತ್ತದೆ. ಪುಸ್ತಕದಲ್ಲಿರುವ ಕೆಲವು ವೈಯಕ್ತಿಕ ವಿವರಗಳಲ್ಲದೆ ಪ್ರವಾದಿಯಾದ ಯೋವೇಲನ ಕುರಿತಾಗಿ ಹೆಚ್ಚೇನೂ ನಮಗೆ ತಿಳಿದಿಲ್ಲ. ಅವನು ತನ್ನನ್ನು ತಾನು ಪೆತೂವೇಲನ ಮಗನೆಂದು ಗುರುತಿಸಿಕೊಂಡನು, ಯೆಹೂದದ ಜನರಿಗೆ ಬೋಧಿಸಿದನು ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಕುರಿತು ಹೆಚ್ಚಿನ ಆಸಕ್ತಿಯನ್ನು ವ್ಯಕ್ತಪಡಿಸಿದನು. ಯೋವೇಲನು ಯಾಜಕರ ಮತ್ತು ದೇವಾಲಯದ ಬಗ್ಗೆ ಅನೇಕ ವಿವರಣೆಗಳನ್ನು ನೀಡಿದ್ದಾನೆ, ಇದು ಯೆಹೂದದ ಆರಾಧನ ಕೇಂದ್ರದ ಕುರಿತಾದ ಸುಪರಿಚಯವನ್ನು ಸೂಚಿಸುತ್ತದೆ (ಯೋವೇಲ 1:13-14; 2:14,17).</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿ.ಪೂ. 835-600 ರ ನಡುವಿನ ಕಾಲದಲ್ಲಿ ಬರೆದಿರಬಹುದು.</para>
  <para style="ip">ಬಹುಶಃ ಯೋವೇಲನು ಹಳೆಯ ಒಡಂಬಡಿಕೆಯ ಇತಿಹಾಸದ ಪರ್ಷಿಯನ್ ಕಾಲಾವಧಿಯಲ್ಲಿ ಜೀವಿಸಿದ್ದಿರಬಹುದು. ಆ ಸಮಯದಲ್ಲಿ, ಪರ್ಷಿಯಾದವರು ಯೆಹೂದ್ಯರಲ್ಲಿ ಕೆಲವರಿಗೆ ಯೆರೂಸಲೇಮಿಗೆ ಹಿಂದಿರುಗಿ ಹೋಗಲು ಅನುಮತಿ ನೀಡಿದರು ಮತ್ತು ಅಂತಿಮವಾಗಿ ದೇವಾಲಯವನ್ನು ಮರುನಿರ್ಮಾಣ ಮಾಡಲಾಯಿತು. ಯೋವೇಲನಿಗೆ ದೇವಾಲಯದ ಬಗ್ಗೆ ಚೆನ್ನಾಗಿ ತಿಳಿದಿತ್ತು, ಆದ್ದರಿಂದ ಅವನು ಅದರ ಪುನಃಸ್ಥಾಪನೆಯ ನಂತರದ ಕಾಲಾವಧಿಗೆ ಸೇರಿದವನಾಗಿದ್ದಾನೆಂದು ನಿರ್ಣಯಿಸಬಹುದು.</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಇಸ್ರಾಯೇಲ್ ಜನರು ಮತ್ತು ನಂತರದ ಸತ್ಯವೇದದ ಓದುಗಾರರೆಲ್ಲರು.</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ದೇವರು ಪಶ್ಚಾತ್ತಾಪ ಪಡುವವರಿಗೆ ಕ್ಷಮಾಪಣೆಯನ್ನು ನೀಡುವಂಥ ಕರುಣಾಮಯಿಯಾಗಿದ್ದಾನೆ. ಪುಸ್ತಕವು ಎರಡು ಪ್ರಮುಖ ಘಟನೆಗಳಿಂದ ವೈಶಿಷ್ಟ್ಯವಾದುದು ಆಗಿದೆ. ಒಂದು ಮಿಡತೆಗಳ ಆಕ್ರಮಣ ಮತ್ತೊಂದು ಆತ್ಮನ ಸುರಿಸುವಿಕೆ. ಇದರ ಆರಂಭಿಕ ನೆರವೇರಿಕೆಯು ಪಂಚಾಶತ್ತಮ ದಿನದಲ್ಲಿ ನಡೆದ್ದುದರ ಬಗ್ಗೆ ಅ.ಕೃ. 2 ರಲ್ಲಿ ಪೇತ್ರನಿಂದ ಉಲ್ಲೇಖಿಸಲ್ಪಟ್ಟಿದೆ.</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ಕರ್ತನ ದಿನ</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ಇಸ್ರಾಯೇಲಿನ ಮೇಲೆ ಮಿಡತೆಗಳ ಆಕ್ರಮಣ — 1:1-20</para>
  <para style="io1">2. ದೇವರ ಶಿಕ್ಷೆ — 2:1-17</para>
  <para style="io1">3. ಇಸ್ರಾಯೇಲಿನ ಪುನಃಸ್ಥಾಪನೆ — 2:18-32</para>
  <para style="io1">4. ಜನಾಂಗಗಳ ಕುರಿತು ದೇವರ ನ್ಯಾಯತೀರ್ಪು ನಂತರ ತನ್ನ ಜನರ ಮಧ್ಯೆ ವಾಸಿಸುವುದು — 3:1-21</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>ಪೆತೂವೇಲನ ಮಗನಾದ ಯೋವೇಲನಿಗೆ ಯೆಹೋವನು ದಯಪಾಲಿಸಿದ ವಾಕ್ಯವು.<verse eid="JOL 1:1"/></para>
  <para style="s">ಮಿಡತೆಗಳಿಂದಾದ ಹಾನಿ</para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2"/>ವೃದ್ಧರೇ, ಇದನ್ನು ಕೇಳಿರಿ,</para>
  <para style="q" vid="JOL 1:2">ದೇಶದ ನಿವಾಸಿಗಳೇ, ನೀವೆಲ್ಲರೂ ಕಿವಿಗೊಡಿರಿ.</para>
  <para style="q" vid="JOL 1:2">ಇಂಥ ಬಾಧೆಯು ನಿಮ್ಮ ಕಾಲದಲ್ಲಾಗಲಿ</para>
  <para style="q" vid="JOL 1:2">ನಿಮ್ಮ ಪೂರ್ವಿಕರ ಕಾಲದಲ್ಲಿಯಾಗಲಿ ಸಂಭವಿಸಿತ್ತೋ?<verse eid="JOL 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3"/>ಇದನ್ನು ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ ತಿಳಿಸಿರಿ,</para>
  <para style="q" vid="JOL 1:3">ಅವರು ತಮ್ಮ ಮಕ್ಕಳಿಗೆ ತಿಳಿಸಲಿ</para>
  <para style="q" vid="JOL 1:3">ಮತ್ತು ಅವರು ಮುಂದಿನ ತಲೆಮಾರಿನವರಿಗೆ ತಿಳಿಸಲಿ.<verse eid="JOL 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4"/>ಚೂರಿಮಿಡತೆ ತಿಂದು ಉಳಿದಿದ್ದ ಬೆಳೆಯನ್ನು ಗುಂಪು ಮಿಡತೆ ತಿಂದು ಬಿಟ್ಟಿತು;</para>
  <para style="q" vid="JOL 1:4">ಗುಂಪು ಮಿಡತೆ ತಿಂದು ಉಳಿದದ್ದನ್ನು ಕುದರೆ ಮಿಡತೆ ತಿಂದು ಬಿಟ್ಟಿತು;</para>
  <para style="q" vid="JOL 1:4">ಕುದರೆ ಮಿಡತೆ ತಿಂದು ಉಳಿದದ್ದನ್ನು ಕಂಬಳಿ ಮಿಡತೆ ತಿಂದುಬಿಟ್ಟಿತು.<verse eid="JOL 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5"/>ಅಮಲೇರಿದವರೇ, ಎಚ್ಚರಗೊಳ್ಳಿರಿ ಮತ್ತು ಅಳಿರಿ!</para>
  <para style="q" vid="JOL 1:5">ದ್ರಾಕ್ಷಾರಸ ಕುಡಿಯುವವರೇ, ಗೋಳಾಡಿರಿ,</para>
  <para style="q" vid="JOL 1:5">ಏಕೆಂದರೆ ದ್ರಾಕ್ಷಾರಸದ ಸಿಹಿಯು ನಿಮ್ಮ ಬಾಯಿಗೆ ಸಿಕ್ಕುವುದಿಲ್ಲ.<verse eid="JOL 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6"/>ನನ್ನ ದೇಶದ ಮೇಲೆ ಬಲಿಷ್ಠವಾದ</para>
  <para style="q" vid="JOL 1:6">ಹಾಗೂ ಅಸಂಖ್ಯಾತವಾದ ಒಂದು ಜನಾಂಗವು<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">ಜನಾಂಗವು </char><char style="ft" closed="false">ಮಿಡತೆಗಳ ಸೈನ್ಯವು.</char></note> ಏರಿ ಬಂದಿದೆ;</para>
  <para style="q" vid="JOL 1:6">ಅದರ ಹಲ್ಲುಗಳು ಸಿಂಹದ ಹಲ್ಲುಗಳೇ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">ಸಿಂಹದ ಹಲ್ಲುಗಳೇ </char><char style="ft" closed="false">ಪ್ರಕ 9:7-10 ನೋಡಿರಿ.</char></note>;</para>
  <para style="q" vid="JOL 1:6">ಅದರ ಕೋರೆ ಹಲ್ಲುಗಳು ಮೃಗರಾಜನ ಕೋರೆಗಳೇ.<verse eid="JOL 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7"/>ಅದು ನನ್ನ ದ್ರಾಕ್ಷಾತೋಟವನ್ನು ಹಾಳುಮಾಡಿ,</para>
  <para style="q" vid="JOL 1:7">ನನ್ನ ಅಂಜೂರದ ಗಿಡವನ್ನು ಮುರಿದುಹಾಕಿದೆ.</para>
  <para style="q" vid="JOL 1:7">ಅವುಗಳನ್ನು ಹಾಳುಮಾಡಿ ದೂರ ಬಿಸಾಡಿಬಿಟ್ಟಿದೆ;</para>
  <para style="q" vid="JOL 1:7">ಅದರ ಕೊಂಬೆಗಳು ಬಿಳುಪಾದವು.<verse eid="JOL 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8"/>ಯೌವನದ ಪತಿಗಾಗಿ ದುಃಖದಿಂದ ಗೋಣಿತಟ್ಟನ್ನು ಧರಿಸಿಕೊಂಡು ಗೋಳಾಡುವ ಕನ್ಯೆಯಂತೆ ಗೋಳಾಡಿರಿ.<verse eid="JOL 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9"/>ಧಾನ್ಯನೈವೇದ್ಯಗಳು ಮತ್ತು ಪಾನದ್ರವ್ಯಗಳು ಯೆಹೋವನ ಆಲಯದಿಂದ ತೆಗೆಯಲ್ಪಟ್ಟಿದೆ.</para>
  <para style="q" vid="JOL 1:9">ಯೆಹೋವನ ಸೇವಕರಾದ ಯಾಜಕರು ಗೋಳಾಡುತ್ತಾರೆ.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>ಬೆಳೆ ಬೆಳೆಯುವ ಹೊಲವು ಹಾಳಾಗಿದೆ,</para>
  <para style="q" vid="JOL 1:10">ನೆಲವು<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">ನೆಲವು </char><char style="ft" closed="false">ದೇಶವು </char></note> ದುಃಖದಲ್ಲಿ ಮುಳುಗಿದೆ.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">ದುಃಖದಲ್ಲಿ ಮುಳುಗಿದೆ. </char><char style="ft" closed="false">ಬರುಡಾಗಿದೆ.</char></note></para>
  <para style="q" vid="JOL 1:10">ಏಕೆಂದರೆ ಧಾನ್ಯವು ನಾಶವಾಗಿದೆ,</para>
  <para style="q" vid="JOL 1:10">ಹೊಸ ದ್ರಾಕ್ಷಾರಸವು ಒಣಗಿದೆ,</para>
  <para style="q" vid="JOL 1:10">ಎಣ್ಣೆಯು ಕೆಟ್ಟುಹೋಗಿದೆ.<verse eid="JOL 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11"/>ರೈತರೇ, ರೋದಿಸಿರಿ,</para>
  <para style="q" vid="JOL 1:11">ತೋಟಗಾರರೇ ಗೋಳಾಡಿರಿ,</para>
  <para style="q" vid="JOL 1:11">ಗೋದಿಯೂ ಮತ್ತು ಜವೆಗೋದಿಯೂ ಹಾಳಾಗಿವೆ.</para>
  <para style="q" vid="JOL 1:11">ಹೊಲದ ಬೆಳೆಯು ನಾಶವಾಗಿದೆ.<verse eid="JOL 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12"/>ದ್ರಾಕ್ಷಾಲತೆಯು ಒಣಗಿದೆ ಮತ್ತು ಅಂಜೂರದ ಗಿಡವು ಬಾಡಿಹೋಗಿದೆ;</para>
  <para style="q" vid="JOL 1:12">ದಾಳಿಂಬೆ, ಖರ್ಜೂರ ಮತ್ತು ಸೇಬು ಮರಗಳು</para>
  <para style="q" vid="JOL 1:12">ಹಾಗು ಹೊಲದ ಸಕಲ ವನವೃಕ್ಷಗಳು ಒಣಗಿ ಹೋಗಿವೆ.</para>
  <para style="q" vid="JOL 1:12">ಮನುಷ್ಯರು ಸೊರಗಿ ಸಂತೋಷವಿಲ್ಲದೆ ಕಳೆಗುಂದಿದ್ದಾರೆ.<verse eid="JOL 1:12"/></para>
  <para style="s">ಜನರನ್ನು ಎಚ್ಚರಿಸಿ ಪ್ರಾರ್ಥನೆಗೆ ಆಹ್ವಾನಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="13" style="v" sid="JOL 1:13"/>ಯಾಜಕರೇ, ಗೋಣಿತಟ್ಟನ್ನು ಉಟ್ಟುಕೊಂಡು ಗೋಳಾಡಿರಿ!</para>
  <para style="q" vid="JOL 1:13">ಯಜ್ಞವೇದಿಯ ಸೇವಕರೇ, ಗೋಳಾಡಿರಿ.</para>
  <para style="q" vid="JOL 1:13">ನನ್ನ ದೇವರ ಸೇವಕರೇ, ಬಂದು ಗೋಣಿತಟ್ಟನ್ನು ಸುತ್ತಿಕೊಂಡು ರಾತ್ರಿಯೆಲ್ಲಾ ಬಿದ್ದುಕೊಂಡಿರಿ.</para>
  <para style="q" vid="JOL 1:13">ಏಕೆಂದರೆ ಧಾನ್ಯನೈವೇದ್ಯಗಳು ಮತ್ತು ಪಾನದ್ರವ್ಯಗಳು ನಿಮ್ಮ ದೇವರ ಆಲಯಕ್ಕೆ ಬಾರದೆ ನಿಂತುಹೋಗಿದೆ.<verse eid="JOL 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14"/>ಉಪವಾಸ ಪ್ರಾರ್ಥನೆಯ ದಿನವನ್ನು ಏರ್ಪಡಿಸಿರಿ,</para>
  <para style="q" vid="JOL 1:14">ಪವಿತ್ರ ಸಭೆಯನ್ನು ಸೇರಿಸಿರಿ.</para>
  <para style="q" vid="JOL 1:14">ಹಿರಿಯರನ್ನೂ ಮತ್ತು ಸಮಸ್ತ ದೇಶದ ನಿವಾಸಿಗಳನ್ನೂ</para>
  <para style="q" vid="JOL 1:14">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವನ ಆಲಯಕ್ಕೆ ಬರಮಾಡಿ,</para>
  <para style="q" vid="JOL 1:14">ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡಿರಿ.<verse eid="JOL 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15"/>ಯೆಹೋವನು ಬರುವ ದಿನವು ಸಮೀಪಿಸಿತು.</para>
  <para style="q" vid="JOL 1:15">ಅದು ಸರ್ವಶಕ್ತನಾದ ಯೆಹೋವನಿಂದ ನಾಶವಾಗುವ ದಿನ.<verse eid="JOL 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16"/>ನಮ್ಮ ಆಹಾರವು ನಮ್ಮ ಕಣ್ಣೆದುರಿಗೆ ಹಾಳಾಯಿತಲ್ಲಾ,</para>
  <para style="q" vid="JOL 1:16">ಸಂತೋಷವೂ ಹಾಗೂ ಉಲ್ಲಾಸವೂ ನಮ್ಮ ದೇವರ ಆಲಯವನ್ನು ಬಿಟ್ಟುಹೋಯಿತ್ತಲ್ಲಾ!<verse eid="JOL 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17"/>ಬೀಜಗಳು, ಹೆಂಟೆಗಳ ಕೆಳಗೆ ಕೆಟ್ಟುಹೋಗಿವೆ.</para>
  <para style="q" vid="JOL 1:17">ಉಗ್ರಾಣಗಳು ಬರಿದಾಗಿವೆ.</para>
  <para style="q" vid="JOL 1:17">ಕಣಜಗಳು ಕೆಡವಲ್ಪಟ್ಟಿವೆ,</para>
  <para style="q" vid="JOL 1:17">ಏಕೆಂದರೆ ಧಾನ್ಯವು ಒಣಗಿದೆ.<verse eid="JOL 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18"/>ಅಯ್ಯೋ, ಪಶುಗಳು ಎಷ್ಟೋ ನರಳುತ್ತವೆ!</para>
  <para style="q" vid="JOL 1:18">ಮೇವಿಲ್ಲದ ಕಾರಣ ದನದ ಮಂದೆಗಳು ಕಳವಳಗೊಂಡಿವೆ.</para>
  <para style="q" vid="JOL 1:18">ಏಕೆಂದರೆ ಅವುಗಳಿಗೆ ಮೇವು ಇಲ್ಲ.</para>
  <para style="q" vid="JOL 1:18">ಕುರಿಹಿಂಡುಗಳು ಕಷ್ಟಪಡುತ್ತವೆ.<verse eid="JOL 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19"/>ಯೆಹೋವನೇ, ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ;</para>
  <para style="q" vid="JOL 1:19">ಕಾಡಿನ ಹುಲ್ಲುಗಾವಲನ್ನು ಬೆಂಕಿಯು ನುಂಗಿಬಿಟ್ಟಿದೆ, ವನವೃಕ್ಷಗಳನ್ನೆಲ್ಲಾ ಜ್ವಾಲೆಯು ಸುಟ್ಟುಬಿಟ್ಟಿದೆ.<verse eid="JOL 1:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20"/>ಅಡವಿಯ ಮೃಗಗಳು ಸಹ ನಿನ್ನ ಕಡೆಗೆ ತಲೆಯೆತ್ತಿವೆ.</para>
  <para style="q" vid="JOL 1:20">ನೀರಿನ ಹೊಳೆಗಳು ಬತ್ತಿಹೋಗಿವೆ.</para>
  <para style="q" vid="JOL 1:20">ಕಾಡಿನ ಹುಲ್ಲುಗಾವಲನ್ನು ಬೆಂಕಿಯು ದಹಿಸಿಬಿಟ್ಟಿದೆ.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s">ಮಿಡತೆ ದಂಡಿನ ವರ್ಣನೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1"/>ಚೀಯೋನಿನಲ್ಲಿ ಕೊಂಬೂದಿರಿ,</para>
  <para style="q" vid="JOL 2:1">ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯ ದಿನ ಮೊಳಗಲಿ.</para>
  <para style="q" vid="JOL 2:1">ಸಮಸ್ತ ದೇಶದ ನಿವಾಸಿಗಳು ನಡುಗಲಿ,</para>
  <para style="q" vid="JOL 2:1">ಏಕೆಂದರೆ ಯೆಹೋವನ ದಿನವು ಬರುತ್ತದೆ;</para>
  <para style="q" vid="JOL 2:1">ಅದು ಸಮೀಪವಾಗಿದೆ.<verse eid="JOL 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2"/>ಅದು ಕತ್ತಲೆಯ ಮತ್ತು ಮೊಬ್ಬಿನ ದಿನವೂ,</para>
  <para style="q" vid="JOL 2:2">ಕಾರ್ಮುಗಿಲಿನ ಕಗ್ಗತ್ತಲ ದಿನವೂ ಆಗಿದೆ.</para>
  <para style="q" vid="JOL 2:2">ಉದಯವು ಬೆಟ್ಟಗಳ ಮೇಲೆ ಹರಡಿಕೊಳ್ಳುವ ಹಾಗೆ,</para>
  <para style="q" vid="JOL 2:2">ಪ್ರಬಲವಾದ ದೊಡ್ಡ ಸೈನ್ಯವು ಬರುತ್ತದೆ.</para>
  <para style="q" vid="JOL 2:2">ಅದರ ಹಾಗೆ ಹಿಂದೆಂದೂ ಬಂದಿಲ್ಲ,</para>
  <para style="q" vid="JOL 2:2">ಇನ್ನು ಮುಂದೆಯೂ ಬರುವುದಿಲ್ಲ,</para>
  <para style="q" vid="JOL 2:2">ತಲತಲಾಂತರಗಳ ವರ್ಷಗಳವರೆಗೂ ಬರುವುದಿಲ್ಲ.<verse eid="JOL 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3"/>ಅವುಗಳ ಮುಂದೆ ಬೆಂಕಿಯು ದಹಿಸುತ್ತದೆ,</para>
  <para style="q" vid="JOL 2:3">ಹಿಂದೆ ಜ್ವಾಲೆಯು ಧಗಧಗಿಸುತ್ತದೆ.</para>
  <para style="q" vid="JOL 2:3">ಅವು ಬರುವುದಕ್ಕೆ ಮೊದಲು ದೇಶವು ಏದೆನ್ ಉದ್ಯಾನದಂತೆ ಇತ್ತು,</para>
  <para style="q" vid="JOL 2:3">ಅವು ದಾಟಿಹೋದ ಮೇಲೆ ಬೆಗ್ಗಾಡಾಯಿತು.</para>
  <para style="q" vid="JOL 2:3">ಹೌದು, ಅವುಗಳಿಂದ ಯಾವುದೂ ತಪ್ಪಿಸಿಕೊಳ್ಳಲಾರದು.<verse eid="JOL 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4"/>ಆ ಸೈನ್ಯಗಳ ಆಕಾರವು ಕುದುರೆಗಳ ಆಕಾರದ ಹಾಗೆ ಕಾಣಿಸುತ್ತದೆ;</para>
  <para style="q" vid="JOL 2:4">ಅವು ಸವಾರರಂತೆ ಓಡುತ್ತವೆ.<verse eid="JOL 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5"/>ಬೆಟ್ಟಗಳ ತುದಿಯಲ್ಲಿ ಅವು ಹಾರಾಡುತ್ತ ರಥಗಳಂತೆ ಚೀತ್ಕಾರ ಮಾಡುತ್ತವೆ;</para>
  <para style="q" vid="JOL 2:5">ಕೂಳೆಯನ್ನು ದಹಿಸುವ ಬೆಂಕಿಯ ಜ್ವಾಲೆಯ ಶಬ್ದದ ಹಾಗೆಯೂ,</para>
  <para style="q" vid="JOL 2:5">ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧವಾದ ಬಲವುಳ್ಳ ಸೈನ್ಯದ ಹಾಗೆಯೂ ಇವೆ.<verse eid="JOL 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6"/>ಅವುಗಳ ದೆಸೆಯಿಂದ ರಾಷ್ಟ್ರಗಳಿಗೆ ಪ್ರಾಣ ಸಂಕಟ;</para>
  <para style="q" vid="JOL 2:6">ಎಲ್ಲರ ಮುಖಗಳು ಕಳೆಗುಂದುತ್ತವೆ.<verse eid="JOL 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7"/>ಅವು ಶೂರರಂತೆ ಓಡಾಡುತ್ತವೆ;</para>
  <para style="q" vid="JOL 2:7">ಯೋಧರ ಹಾಗೆ ಗೋಡೆ ಏರುತ್ತವೆ;<verse eid="JOL 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8"/>ನೂಕುನುಗ್ಗಲ್ಲಿಲ್ಲದೆ ತಮ್ಮ ತಮ್ಮ ಸಾಲುಗಳಲ್ಲಿಯೇ ನಡೆಯುತ್ತವೆ;</para>
  <para style="q" vid="JOL 2:8">ಆಯುಧಗಳ ನಡುವೆ ನುಗ್ಗುತ್ತವೆ.<verse eid="JOL 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9"/>ಪಟ್ಟಣದಲ್ಲೆಲ್ಲಾ ತ್ವರೆಪಡುತ್ತವೆ,</para>
  <para style="q" vid="JOL 2:9">ಗೋಡೆಯ ಮೇಲೆ ಓಡಾಡುತ್ತವೆ,</para>
  <para style="q" vid="JOL 2:9">ಮನೆಗಳನ್ನು ಹತ್ತುತ್ತವೆ,</para>
  <para style="q" vid="JOL 2:9">ಕಿಟಕಿಗಳಿಂದ ಕಳ್ಳರಂತೆ ಪ್ರವೇಶಿಸುತ್ತವೆ.<verse eid="JOL 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10"/>ಅವುಗಳ ಆಗಮನದಿಂದ ಭೂಮಿಯು ಕಂಪಿಸುತ್ತದೆ,</para>
  <para style="q" vid="JOL 2:10">ಆಕಾಶಮಂಡಲವು ನಡಗುತ್ತದೆ,</para>
  <para style="q" vid="JOL 2:10">ಸೂರ್ಯ ಮತ್ತು ಚಂದ್ರರು ಮಂಕಾಗುತ್ತಾರೆ,</para>
  <para style="q" vid="JOL 2:10">ಮತ್ತು ನಕ್ಷತ್ರಗಳು ಕಾಂತಿಗುಂದುತ್ತವೆ.<verse eid="JOL 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11"/>ಯೆಹೋವನು ತನ್ನ ಸೈನ್ಯದ ಮುಂದೆ ಗುಡುಗಿನಂತೆ ಧ್ವನಿಗೈಯುತ್ತಾನೆ,</para>
  <para style="q" vid="JOL 2:11">ಆತನ ಸೈನ್ಯ ಬಹಳ ದೊಡ್ಡದಾಗಿದೆ;</para>
  <para style="q" vid="JOL 2:11">ಆತನ ಆಜ್ಞೆಯನ್ನು ಪಾಲಿಸುವವನು ಬಲಿಷ್ಠನಾಗಿದ್ದಾನೆ.</para>
  <para style="q" vid="JOL 2:11">ಯೆಹೋವನ ದಿನವು ಮಹತ್ತರವೂ ಮತ್ತು ಅತಿಭಯಂಕರವೂ ಆಗಿದೆ.</para>
  <para style="q" vid="JOL 2:11">ಅದನ್ನು ಸಹಿಸಿಕೊಳ್ಳುವವರು ಯಾರು?<verse eid="JOL 2:11"/></para>
  <para style="s">ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ಕರೆ</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12"/>ಯೆಹೋವನು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ, “ಈಗಲಾದರೂ,</para>
  <para style="q" vid="JOL 2:12">ನೀವು ಪೂರ್ಣಹೃದಯದಿಂದ ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q" vid="JOL 2:12">ಉಪವಾಸಮಾಡಿರಿ, ಅಳಿರಿ, ಗೋಳಾಡಿರಿ.”<verse eid="JOL 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13"/>ನಿಮ್ಮ ಉಡುಪುಗಳನ್ನಲ್ಲ, ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಹರಿದುಕೊಳ್ಳಿರಿ.</para>
  <para style="q" vid="JOL 2:13">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ.</para>
  <para style="q" vid="JOL 2:13">ಆತನು ದಯೆಯೂ, ಕನಿಕರವೂ,</para>
  <para style="q" vid="JOL 2:13">ದೀರ್ಘಶಾಂತಿಯೂ, ಮಹಾಪ್ರೀತಿಯೂ ಉಳ್ಳವನಾಗಿ</para>
  <para style="q" vid="JOL 2:13">ತಾನು ವಿಧಿಸುವ ಕೇಡಿಗೆ ಮನಮರುಗುವಂಥವನು.<verse eid="JOL 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14"/>ಆತನು ಒಂದು ವೇಳೆ ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸಿ,</para>
  <para style="q" vid="JOL 2:14">ನಿಮ್ಮ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಬಹುದು;</para>
  <para style="q" vid="JOL 2:14">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವನಿಗೆ ನೀವು ಅರ್ಪಿಸುವ ನೈವೇದ್ಯವನ್ನು ಸ್ವೀಕರಿಸಿ ಸುವರಗಳನ್ನು ದಯಪಾಲಿಸಬಹುದು.<verse eid="JOL 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15"/>ಚೀಯೋನ್ ಪರ್ವತದ ಮೇಲೆ ನಿಂತು ಕೊಂಬೂದಿರಿ,</para>
  <para style="q" vid="JOL 2:15">ಉಪವಾಸ ದಿನವನ್ನು ಗೊತ್ತುಮಾಡಿರಿ,</para>
  <para style="q" vid="JOL 2:15">ಪವಿತ್ರ ಸಭೆಯನ್ನು ಕರೆಯಿರಿ.<verse eid="JOL 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16"/>ಜನರನ್ನು ಒಟ್ಟುಗೂಡಿಸಿರಿ,</para>
  <para style="q" vid="JOL 2:16">ಪವಿತ್ರ ಸಭೆಯನ್ನು ಏರ್ಪಡಿಸಿರಿ.</para>
  <para style="q" vid="JOL 2:16">ಹಿರಿಯರನ್ನು ಕೂಡಿಸಿರಿ,</para>
  <para style="q" vid="JOL 2:16">ಮಕ್ಕಳನ್ನು ಸೇರಿಸಿರಿ,</para>
  <para style="q" vid="JOL 2:16">ಮೊಲೆಕೂಸುಗಳನ್ನು ಸೇರಿಸಿರಿ.</para>
  <para style="q" vid="JOL 2:16">ಮದುಮಗನು ತನ್ನ ಕೊಠಡಿಯಿಂದ ಹೊರಟುಬರಲಿ,</para>
  <para style="q" vid="JOL 2:16">ವಧುವು ತನ್ನ ಕಲ್ಯಾಣಗೃಹದಿಂದ ಹೊರಟುಬರಲಿ.<verse eid="JOL 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17"/>ಯೆಹೋವನ ಸೇವಕರಾದ ಯಾಜಕರು,</para>
  <para style="q" vid="JOL 2:17">ದ್ವಾರಮಂಟಪಕ್ಕೂ, ಯಜ್ಞವೇದಿಯ ನಡುವೆ ಅಳುತ್ತಾ</para>
  <para style="q" vid="JOL 2:17">ಹೀಗೆ ಹೇಳಲಿ, “ಯೆಹೋವನೇ, ನಿನ್ನ ಜನರನ್ನು ಕರುಣಿಸು,</para>
  <para style="q" vid="JOL 2:17">ಅನ್ಯಜನಾಂಗಗಳು ನಿಂದಿಸುವುದಕ್ಕೆ</para>
  <para style="q" vid="JOL 2:17">ನಿನ್ನ ಬಾಧ್ಯತೆಯನ್ನು ದೂಷಣೆಗೆ ಗುರಿಮಾಡಬೇಡ.</para>
  <para style="q" vid="JOL 2:17">‘ಅವರ ದೇವರು ಎಲ್ಲಿ?’ ಎಂದು</para>
  <para style="q" vid="JOL 2:17">ಅವರು ಏಕೆ ನಿಂದಿಸಬೇಕು.”<verse eid="JOL 2:17"/></para>
  <para style="s">ಯೆಹೋವನ ವಾಗ್ದಾನ</para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18"/>ಆಗ ಯೆಹೋವನು ತನ್ನ ದೇಶಕ್ಕೆ ಅಪಕೀರ್ತಿ ಬರಬಾರದೆಂದು</para>
  <para style="q" vid="JOL 2:18">ತನ್ನ ಜನರನ್ನು ಕರುಣಿಸಿ,<verse eid="JOL 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19"/>ಅವರ ಬಿನ್ನಹವನ್ನು ಯೆಹೋವನು ಲಾಲಿಸಿ ಅವರಿಗೆ ಹೀಗೆ ಹೇಳಿದನು:</para>
  <para style="q" vid="JOL 2:19">“ಇಗೋ, ನಾನು ಧಾನ್ಯ, ದ್ರಾಕ್ಷಾರಸ, ತೈಲಗಳನ್ನು ನಿಮಗೆ ಕಳುಹಿಸುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q" vid="JOL 2:19">ಅವುಗಳಿಂದ ನಿಮಗೆ ತೃಪ್ತಿಯಾಗುವುದು.</para>
  <para style="q" vid="JOL 2:19">ನಿಮ್ಮನ್ನು ಅನ್ಯಜನಾಂಗಗಳ ನಿಂದೆಗೆ ಇನ್ನು ಗುರಿಮಾಡುವುದಿಲ್ಲ.<verse eid="JOL 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20"/>ನಾನು ಉತ್ತರ ದಿಕ್ಕಿನ ಸೈನ್ಯವನ್ನು ನಿಮ್ಮ ಕಡೆಯಿಂದ ದೂರಮಾಡುವೆನು,</para>
  <para style="q" vid="JOL 2:20">ಅದನ್ನು ಹಾಳುಬಿದ್ದ ಬಂಜರು ಭೂಮಿಗೂ ಓಡಿಸುವೆನು.</para>
  <para style="q" vid="JOL 2:20">ಅದರ ಮುಂಭಾಗವನ್ನು ಪೂರ್ವದ ಸಮುದ್ರಕ್ಕೂ,</para>
  <para style="q" vid="JOL 2:20">ಅದರ ಹಿಂಭಾಗವನ್ನು ಪಶ್ಚಿಮ ಸಮುದ್ರಕ್ಕೂ ತಳ್ಳಿಬಿಡುವೆನು.</para>
  <para style="q" vid="JOL 2:20">ಅದರ ದುರ್ವಾಸನೆಯು ಏರುವುದು.</para>
  <para style="q" vid="JOL 2:20">ಏಕೆಂದರೆ ಆತನು ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡುತ್ತಾನೆ.<verse eid="JOL 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21"/>ಭೂಮಿಯೇ, ಹೆದರಬೇಡ, ಹರ್ಷಿಸು, ಉಲ್ಲಾಸಿಸು,</para>
  <para style="q" vid="JOL 2:21">ಯೆಹೋವನು ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ್ದಾನೆ.<verse eid="JOL 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22"/>ಕಾಡುಮೃಗಗಳೇ ಅಂಜಬೇಡಿರಿ,</para>
  <para style="q" vid="JOL 2:22">ಕಾಡುಗಾವಲಲ್ಲಿ ಹುಲ್ಲು ಮೊಳೆಯುವುದು,</para>
  <para style="q" vid="JOL 2:22">ಮರವು ಹಣ್ಣು ಬಿಡುವುದು.</para>
  <para style="q" vid="JOL 2:22">ಅಂಜೂರದ ಗಿಡವೂ ದ್ರಾಕ್ಷಾಲತೆಯೂ ಸಾರವತ್ತಾಗಿ ಫಲಿಸುವವು.<verse eid="JOL 2:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23"/>ಚೀಯೋನಿನ ಜನರೇ ಹರ್ಷಿಸಿರಿ,</para>
  <para style="q" vid="JOL 2:23">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವನಲ್ಲಿ ಉಲ್ಲಾಸಿಸಿರಿ.</para>
  <para style="q" vid="JOL 2:23">ಆತನು ತನ್ನ ನೀತಿಯಿಂದ<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="fq" closed="false">ನೀತಿಯಿಂದ </char><char style="ft" closed="false">ನೀತಿಯ ಬೋಧಕರಿಂದ.</char></note> ಮುಂಗಾರು ಮಳೆಯನ್ನು ನಿಮಗೆ ಕೊಡುವನು.</para>
  <para style="q" vid="JOL 2:23">ಮುಂಗಾರು, ಹಿಂಗಾರು ಮಳೆಗಳನ್ನು</para>
  <para style="q" vid="JOL 2:23">ಮೊದಲಿನಂತೆ ನಿಮಗಾಗಿ ಸುರಿಸುವನು.<verse eid="JOL 2:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24"/>ಕಣಜಗಳಲ್ಲಿ ಗೋದಿಯು ರಾಶಿರಾಶಿಯಾಗಿರುವುದು,</para>
  <para style="q" vid="JOL 2:24">ತೊಟ್ಟಿಗಳಲ್ಲಿ ದ್ರಾಕ್ಷಾರಸವೂ ಎಣ್ಣೆಯೂ ತುಂಬಿತುಳುಕುವವು.<verse eid="JOL 2:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25"/>ಗುಂಪು ಮಿಡತೆಗಳು, ಸಣ್ಣ ಮಿಡತೆಗಳು, ದೊಡ್ಡ ಮಿಡತೆಗಳು, ಚೂರಿ ಮಿಡತೆಗಳು,</para>
  <para style="q" vid="JOL 2:25">ನಾನು ಕಳುಹಿಸಿದ ಈ ಮಿಡತೆಗಳ ಸೈನ್ಯಗಳು ತಿಂದು ನಷ್ಟಮಾಡಿದ</para>
  <para style="q" vid="JOL 2:25">ವರ್ಷಗಳನ್ನು ನಾನು ನಿಮಗೆ ತಿರುಗಿಕೊಡುವೆನು.<verse eid="JOL 2:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26"/>ನೀವು ಹೊಟ್ಟೆ ತುಂಬಾ ಊಟಮಾಡಿ ತೃಪ್ತಿಗೊಂಡು,</para>
  <para style="q" vid="JOL 2:26">ನಿಮಗಾಗಿ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ</para>
  <para style="q" vid="JOL 2:26">ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವನ ನಾಮವನ್ನು ಕೊಂಡಾಡುವಿರಿ.</para>
  <para style="q" vid="JOL 2:26">ನನ್ನ ಜನರಿಗೆ ಎಂದಿಗೂ ಆಶಾಭಂಗವಾಗದು.<verse eid="JOL 2:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27"/>ನಾನು ಇಸ್ರಾಯೇಲಿನ ಮಧ್ಯದಲ್ಲಿ ನೆಲೆಯಾಗಿ ಇರುವವನು,</para>
  <para style="q" vid="JOL 2:27">ನಾನೇ ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವನು,</para>
  <para style="q" vid="JOL 2:27">ನಾನಲ್ಲದೆ ಬೇರೆ ದೇವರು ನಿಮಗಿಲ್ಲ.</para>
  <para style="q" vid="JOL 2:27">ನನ್ನ ಜನರಿಗೆ ಎಂದಿಗೂ ಆಶಾಭಂಗವಾಗದು.<verse eid="JOL 2:27"/></para>
  <para style="s">ಯೆಹೋವನ ದಿನ</para>
  <para style="q">
    <verse number="28" style="v" sid="JOL 2:28"/>ತರುವಾಯ ನಾನು</para>
  <para style="q" vid="JOL 2:28">ಎಲ್ಲಾ ಮನುಷ್ಯರ ಮೇಲೆ ನನ್ನ ಆತ್ಮವನ್ನು ಸುರಿಸುವೆನು.</para>
  <para style="q" vid="JOL 2:28">ನಿಮ್ಮ ಪುತ್ರಪುತ್ರಿಯರು ಪ್ರವಾದಿಸುವರು.</para>
  <para style="q" vid="JOL 2:28">ನಿಮ್ಮ ಹಿರಿಯರಿಗೆ ಕನಸುಗಳು ಬೀಳುವವು.</para>
  <para style="q" vid="JOL 2:28">ನಿಮ್ಮ ಯೌವನಸ್ಥರಿಗೆ ದಿವ್ಯದರ್ಶನಗಳಾಗುವವು.<verse eid="JOL 2:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29"/>ಇದಲ್ಲದೆ ಆ ದಿನಗಳಲ್ಲಿ ದಾಸದಾಸಿಯರ ಮೇಲೆಯೂ</para>
  <para style="q" vid="JOL 2:29">ನನ್ನ ಆತ್ಮವನ್ನು ಸುರಿಸುವೆನು.<verse eid="JOL 2:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30"/>ಆಕಾಶಗಳಲ್ಲಿ ಮತ್ತು ಭೂಮಿಯಲ್ಲಿ ಅದ್ಭುತಗಳನ್ನು ಮಾಡುವೆನು.</para>
  <para style="q" vid="JOL 2:30">ರಕ್ತ, ಬೆಂಕಿ, ಧೂಮಸ್ತಂಭ ಈ ಉತ್ಪಾತಗಳನ್ನು ಉಂಟುಮಾಡುವೆನು.<verse eid="JOL 2:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31"/>ಯೆಹೋವನ ಮಹಾ ಭಯಂಕರವಾದ ದಿನವು ಬರುವುದಕ್ಕಿಂತ ಮೊದಲು,</para>
  <para style="q" vid="JOL 2:31">ಸೂರ್ಯನು ಕತ್ತಲಾಗುವನು,</para>
  <para style="q" vid="JOL 2:31">ಚಂದ್ರನು ರಕ್ತವಾಗುವನು.<verse eid="JOL 2:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32"/>ಆದರೂ ಯೆಹೋವನ ನಾಮವನ್ನು ಹೇಳಿಕೊಳ್ಳುವವರೆಲ್ಲರಿಗೆ ರಕ್ಷಣೆಯಾಗುವುದು.</para>
  <para style="q" vid="JOL 2:32">ಯೆಹೋವನು ತಿಳಿಸಿದಂತೆ ಚೀಯೋನಿನ ಪರ್ವತದಲ್ಲಿಯೂ, ಯೆರೂಸಲೇಮಿನಲ್ಲಿಯೂ</para>
  <para style="q" vid="JOL 2:32">ಅನೇಕರು ಉಳಿಯುವರು.</para>
  <para style="q" vid="JOL 2:32">ಯೆಹೋವನು ಹೇಳಿದಂತೆಯೇ,</para>
  <para style="q" vid="JOL 2:32">ಉಳಿದವರಲ್ಲಿ ಯೆಹೋವನಿಂದ ಕರೆಯಲ್ಪಟ್ಟವರು ಬದುಕುವರು.”<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s">ಯೆಹೋವನು ಜನಾಂಗಳಿಗೆ ನೀಡುವ ತೀರ್ಪು</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1"/>ಇಗೋ ಆ ದಿನಗಳಲ್ಲಿಯೂ ಆ ಸಮಯದಲ್ಲಿಯೂ,</para>
  <para style="q" vid="JOL 3:1">ನಾನು ಯೆಹೂದದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಸಂಪತ್ತನ್ನು ಪುನಃಸ್ಥಾಪಿಸುವಾಗ,<verse eid="JOL 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2"/>ನಾನು ಸಕಲ ಜನಾಂಗಗಳನ್ನು ಕೂಡಿಸುವೆನು,</para>
  <para style="q" vid="JOL 3:2">ಮತ್ತು ಯೆಹೋಷಾಫಾಟನ ನ್ಯಾಯತೀರ್ಪಿನ ತಗ್ಗಿಗೆ ಬರಮಾಡುವೆನು.</para>
  <para style="q" vid="JOL 3:2">ಅಲ್ಲಿ ನನ್ನ ಜನರಿಗೆ ನ್ಯಾಯತೀರ್ಪನ್ನು ಕೊಡುವೆನು.</para>
  <para style="q" vid="JOL 3:2">ಏಕೆಂದರೆ ನನ್ನ ಜನರು ನನ್ನ ಬಾಧ್ಯತೆಯೂ ಆಗಿರುವ</para>
  <para style="q" vid="JOL 3:2">ಇಸ್ರಾಯೇಲಿನ ವಿಷಯ ಅವರೊಂದಿಗೆ ವ್ಯಾಜ್ಯ ಮಾಡುವೆನು.</para>
  <para style="q" vid="JOL 3:2">ಅವರು ನನ್ನ ಜನರನ್ನು ದೇಶದೇಶಗಳಿಗೆ ಚದುರಿಸಿ ನನ್ನ ದೇಶವನ್ನು ಹಂಚಿಕೊಂಡರು.<verse eid="JOL 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3"/>ಹೌದು ನನ್ನ ಜನರಿಗಾಗಿ ಚೀಟುಹಾಕಿ,</para>
  <para style="q" vid="JOL 3:3">ವೇಶ್ಯ ವೃತ್ತಿಗೆ ತಮ್ಮ ಗಂಡು ಮಕ್ಕಳನ್ನು ಮಾರಾಟ ಮಾಡಿ,</para>
  <para style="q" vid="JOL 3:3">ಬಾಲಕಿಯರನ್ನು ಕುಡಿಯುವ</para>
  <para style="q" vid="JOL 3:3">ದ್ರಾಕ್ಷಾರಸಕ್ಕೆ ಬದಲು ಮಾಡಿದ್ದಾರೆ.<verse eid="JOL 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 3:4"/>ತೂರ್, ಚೀದೋನ್, ಫಿಲಿಷ್ಟಿಯರ ಎಲ್ಲಾ ಪ್ರಾಂತ್ಯಗಳೇ,</para>
  <para style="q" vid="JOL 3:4">ನನ್ನ ವಿರುದ್ಧ ನಿಮಗೆ ಕೋಪವೇಕೆ?</para>
  <para style="q" vid="JOL 3:4">ನನಗೆ ಪ್ರತಿಕಾರ ಮಾಡುವಿರೋ?</para>
  <para style="q" vid="JOL 3:4">ನೀವು ನನಗೆ ಪ್ರತಿಕಾರ ಮಾಡಿದರೆ,</para>
  <para style="q" vid="JOL 3:4">ನೀವು ಮಾಡುವ ಕೇಡನ್ನು ತ್ವರೆಯಾಗಿ ನಿಮ್ಮ ತಲೆಗೆ ಬರುವಂತೆ ಮಾಡುವೆನು.<verse eid="JOL 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 3:5"/>ನನ್ನ ಬೆಳ್ಳಿ ಬಂಗಾರಗಳನ್ನು ದೋಚಿಕೊಂಡು,</para>
  <para style="q" vid="JOL 3:5">ನನ್ನ ಅಮೂಲ್ಯವಾದ ವಸ್ತ್ರಗಳನ್ನು ನಿಮ್ಮ ದೇವಾಲಯಗಳಿಗೆ ಕೊಂಡೊಯ್ದಿದ್ದೀರಿ.<verse eid="JOL 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 3:6"/>ಯೆಹೂದದ ಮತ್ತು ಯೆರೂಸಲೇಮಿನ ಜನರನ್ನು ಗ್ರೀಕರಿಗೆ ಮಾರಿಬಿಟ್ಟಿದ್ದೀರಿ.</para>
  <para style="q" vid="JOL 3:6">ಅವರನ್ನು ಸ್ವಂತ ನಾಡಿನಿಂದ ದೂರಮಾಡಿದ್ದೀರಿ.<verse eid="JOL 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 3:7"/>ಹೀಗಿರಲು ಇಗೋ, ನೀವು ಅವರನ್ನು ಮಾರಿದ ಸ್ಥಳದೊಳಗಿಂದ ಹೊರಟು ಬರುವಂತೆ ನಾನು ಅವರನ್ನು ಹುರಿದುಂಬಿಸಿ,</para>
  <para style="q" vid="JOL 3:7">ನೀವು ಮಾಡಿದ ಕೇಡನ್ನು ನಿಮ್ಮ ತಲೆಗೇ ತರುವೆನು.<verse eid="JOL 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 3:8"/>ನಿಮ್ಮ ಗಂಡು ಮತ್ತು ಹೆಣ್ಣು ಮಕ್ಕಳನ್ನು,</para>
  <para style="q" vid="JOL 3:8">ಯೆಹೂದ್ಯರಿಗೆ ಮಾರುವೆನು.</para>
  <para style="q" vid="JOL 3:8">ಅವರು ಆ ಮಕ್ಕಳನ್ನು ದೂರದ ಜನಾಂಗವಾದ,</para>
  <para style="q" vid="JOL 3:8">ಶೆಬದವರಿಗೆ ಮಾರಿಬಿಡುವರು.</para>
  <para style="q" vid="JOL 3:8">ಯೆಹೋವನೇ ಇದನ್ನು ನುಡಿದಿದ್ದಾನೆ.<verse eid="JOL 3:8"/></para>
  <para style="s">ಜನಾಂಗಗಳ ಅಪಜಯ</para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 3:9"/>ಎಲ್ಲಾ ಜನರಿಗೆ ಹೀಗೆ ಪ್ರಕಟಿಸಿರಿ:</para>
  <para style="q" vid="JOL 3:9">ಜನಾಂಗಗಳೇ ಯುದ್ಧಸನ್ನದ್ಧರಾಗಿರಿ,</para>
  <para style="q" vid="JOL 3:9">ಶೂರರನ್ನು ಎಚ್ಚರಪಡಿಸಿರಿ,</para>
  <para style="q" vid="JOL 3:9">ಶೂರರು ಒಟ್ಟುಗೂಡಲಿ,</para>
  <para style="q" vid="JOL 3:9">ಶೂರರೆಲ್ಲರೂ ಯುದ್ಧಕ್ಕೆ ಹೊರಡಲಿ.<verse eid="JOL 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10"/>ನಿಮ್ಮ ನೇಗಿಲುಗಳನ್ನು ಕುಲುಮೆಗೆ ಹಾಕಿ,</para>
  <para style="q" vid="JOL 3:10">ಕತ್ತಿಗಳನ್ನಾಗಿ ಮಾಡಿರಿ.</para>
  <para style="q" vid="JOL 3:10">ಕುಡುಗೋಲುಗಳನ್ನು ಭರ್ಜಿಗಳನ್ನಾಗಿ ಮಾರ್ಪಡಿಸಿರಿ.</para>
  <para style="q" vid="JOL 3:10">ಬಲಹೀನನು, “ನಾನು ಶೂರನು” ಎಂದು ಹೇಳಲಿ.<verse eid="JOL 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11"/>ಸುತ್ತಮುತ್ತಲಿನ ಜನಾಂಗಗಳೇ,</para>
  <para style="q" vid="JOL 3:11">ತ್ವರೆಯಾಗಿ ಕೂಡಿಬನ್ನಿರಿ,</para>
  <para style="q" vid="JOL 3:11">ನೀವೆಲ್ಲರೂ ಒಟ್ಟಾಗಿ ಕೂಡಿಬನ್ನಿರಿ.</para>
  <para style="q" vid="JOL 3:11">ಯೆಹೋವನೇ,</para>
  <para style="q" vid="JOL 3:11">ನಿನ್ನ ಶೂರರನ್ನು ರಣರಂಗಕ್ಕೆ ಇಳಿಸು.<verse eid="JOL 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12"/>ಜನಾಂಗಗಳು ಎಚ್ಚೆತ್ತುಕೊಂಡು,</para>
  <para style="q" vid="JOL 3:12">ಯೆಹೋಷಾಫಾಟನ ನ್ಯಾಯತೀರ್ಪಿನ ತಗ್ಗಿಗೆ ಬರಲಿ.</para>
  <para style="q" vid="JOL 3:12">ಅಲ್ಲಿ ನಾನು ಸುತ್ತಣ ಜನಾಂಗಗಳಿಗೆಲ್ಲಾ,</para>
  <para style="q" vid="JOL 3:12">ನ್ಯಾಯತೀರಿಸಲು ಆಸೀನನಾಗುವೆನು.<verse eid="JOL 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13"/>ಯೆಹೋವನ ಸೈನ್ಯದವರೇ, ಕುಡುಗೋಲನ್ನು ಹಾಕಿರಿ,</para>
  <para style="q" vid="JOL 3:13">ಫಲವು ಪಕ್ವವಾಗಿದೆ.</para>
  <para style="q" vid="JOL 3:13">ಬನ್ನಿರಿ, ದ್ರಾಕ್ಷಿಯನ್ನು ತುಳಿಯಿರಿ,</para>
  <para style="q" vid="JOL 3:13">ದ್ರಾಕ್ಷಿಯ ಅಲೆಯು ತುಂಬಿದೆ.</para>
  <para style="q" vid="JOL 3:13">ತೊಟ್ಟಿಗಳು ತುಂಬಿ ತುಳುಕುತ್ತಿವೆ.</para>
  <para style="q" vid="JOL 3:13">ಜನಾಂಗಗಳ ದುಷ್ಟತನವು ವಿಪರೀತವಾಗಿದೆ.<verse eid="JOL 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14"/>ಆಹಾ ತೀರ್ಪಿನ ತಗ್ಗಿನಲ್ಲಿ ಗುಂಪುಗುಂಪುಗಳಾಗಿ ಜನರಿದ್ದಾರೆ.</para>
  <para style="q" vid="JOL 3:14">ಏಕೆಂದರೆ ಯೆಹೋವನ ನ್ಯಾಯತೀರ್ಪಿನ ದಿನವು ಸಮೀಪಿಸಿದೆ.<verse eid="JOL 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15"/>ಸೂರ್ಯ ಮತ್ತು ಚಂದ್ರರು ಮಂಕಾಗುತ್ತಾರೆ,</para>
  <para style="q" vid="JOL 3:15">ನಕ್ಷತ್ರಗಳು ಕಾಂತಿಗುಂದುತ್ತವೆ.<verse eid="JOL 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16"/>ಯೆಹೋವನು ಚೀಯೋನಿನಿಂದ ಗರ್ಜಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="JOL 3:16">ಯೆರೂಸಲೇಮಿನಿಂದ ಧ್ವನಿಗೈಯುತ್ತಾನೆ.</para>
  <para style="q" vid="JOL 3:16">ಭೂಮಿ ಹಾಗು ಆಕಾಶಗಳು ನಡುಗುತ್ತವೆ,</para>
  <para style="q" vid="JOL 3:16">ಆದರೆ ಯೆಹೋವನು ತನ್ನ ಜನರಿಗೆ ಆಶ್ರಯವೂ,</para>
  <para style="q" vid="JOL 3:16">ಮತ್ತು ಇಸ್ರಾಯೇಲರಿಗೆ ರಕ್ಷಣದುರ್ಗವೂ ಆಗಿರುವನು.<verse eid="JOL 3:16"/></para>
  <para style="s">ದೇವಜನರ ಸೌಭಾಗ್ಯ</para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17"/>ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವನು ನಾನೇ ಎಂದು ನಿಮಗೆ ಮನದಟ್ಟಾಗುವುದು.</para>
  <para style="q" vid="JOL 3:17">ಆಗ ನಾನು ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತವಾದ ಚೀಯೋನಿನಲ್ಲಿ ನೆಲೆಸುವುದರಿಂದ,</para>
  <para style="q" vid="JOL 3:17">ಯೆರೂಸಲೇಮ್ ಪವಿತ್ರವಾಗಿರುವುದು.</para>
  <para style="q" vid="JOL 3:17">ಅನ್ಯರು ಇನ್ನು ಅದರಲ್ಲಿ ಹಾದುಹೋಗುವುದಿಲ್ಲ.<verse eid="JOL 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18"/>ಆ ದಿನದಲ್ಲಿ,</para>
  <para style="q" vid="JOL 3:18">ಬೆಟ್ಟಗಳಿಂದ ದ್ರಾಕ್ಷಾರಸವು ಸುರಿಯುವುದು,</para>
  <para style="q" vid="JOL 3:18">ಗುಡ್ಡಗಳಿಂದ ಹಾಲು ಹರಿಯುವುದು,</para>
  <para style="q" vid="JOL 3:18">ಯೆಹೂದದ ಹಳ್ಳಗಳಲ್ಲೆಲ್ಲಾ ನೀರು ತುಂಬಿರುವುದು,</para>
  <para style="q" vid="JOL 3:18">ಯೆಹೋವನ ಆಲಯದೊಳಗೆ ಬುಗ್ಗೆಯು ಉಕ್ಕಿ ಬಂದು,</para>
  <para style="q" vid="JOL 3:18">ಶಿಟ್ಟೀಮಿನ ಹಳ್ಳವನ್ನು ತಂಪುಮಾಡುವುದು.<verse eid="JOL 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19"/>ಐಗುಪ್ತ್ಯವು ಹಾಳಾಗುವುದು,</para>
  <para style="q" vid="JOL 3:19">ಎದೋಮ್, ಹಾಳಾದ ಬೆಂಗಾಡಾಗುವುದು,</para>
  <para style="q" vid="JOL 3:19">ಏಕೆಂದರೆ ಅವರು ಯೆಹೂದ್ಯರನ್ನು ಹಿಂಸಿಸಿ,</para>
  <para style="q" vid="JOL 3:19">ಅವರ ದೇಶದಲ್ಲಿ ನಿರ್ದೋಷಿಗಳ ರಕ್ತವನ್ನು ಸುರಿಸಿದ್ದಾರೆ.<verse eid="JOL 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 3:20"/>ಆದರೆ ಯೆಹೂದವು ಸದಾ ಜನಭರಿತವಾಗಿರುವುದು,</para>
  <para style="q" vid="JOL 3:20">ಯೆರೂಸಲೇಮ್ ತಲತಲಾಂತರಕ್ಕೂ ನಿವಾಸಸ್ಥಾನವಾಗಿರುವುದು.<verse eid="JOL 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 3:21"/>ನಾನು ಶಿಕ್ಷಿಸದೆ ಇದ್ದ ಅವರ ರಕ್ತಾಪರಾಧವನ್ನು ಶಿಕ್ಷಿಸದೇ ಬಿಡುವುದಿಲ್ಲ.<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="fq" closed="false">ನಾನು ಶಿಕ್ಷಿಸದೆ ಇದ್ದ ಅವರ ರಕ್ತಾಪರಾಧವನ್ನು ಶಿಕ್ಷಿಸದೇ ಬಿಡುವುದಿಲ್ಲ. </char><char style="ft" closed="false">ಅಥವಾ ನಾನು ಕ್ಷಮಿಸದೆ ಇದ್ದ ಅವರ ರಕ್ತಾಪರಾಧವನ್ನು ಕ್ಷಮಿಸುವೆನು.</char></note></para>
  <para style="q" vid="JOL 3:21">ಯೆಹೋವನು ಚೀಯೋನಿನಲ್ಲಿ ವಾಸವಾಗಿರುತ್ತಾನೆ.<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
