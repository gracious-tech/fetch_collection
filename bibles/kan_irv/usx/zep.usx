<usx version="3.0">
  <book code="ZEP" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright © 2017 Bridge Connectivity Solutions. This translation is made available to you under the terms of the Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">ಚೆಫನ್ಯನು</para>
  <para style="toc1">ಚೆಫನ್ಯನು</para>
  <para style="toc2">ಚೆಫ</para>
  <para style="toc3">ಚೆಫ</para>
  <para style="mt">ಚೆಫನ್ಯನು</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಚೆಫನ್ಯ 1:1 ರಲ್ಲಿ, ಗ್ರಂಥಕರ್ತನು ತನ್ನನ್ನು ತಾನು “ಕೂಷಿಯನ ಮಗನೂ, ಗೆದಲ್ಯನ ಮೊಮ್ಮಗನೂ, ಹಿಜ್ಕೀಯನಿಗೆ ಹುಟ್ಟಿದ ಅಮರ್ಯನ ಮರಿಮಗನೂ ಆದ ಚೆಫನ್ಯನು” ಎಂದು ಪರಿಚಯಿಸಿಕೊಳ್ಳುತ್ತಾನೆ. ಚೆಫನ್ಯ ಎಂಬ ಹೆಸರಿಗೆ “ದೇವರಿಂದ ಕಾಪಾಡಲ್ಪಟ್ಟವನು” ಎಂಬರ್ಥವಿದೆ, ಯೆರೆಮೀಯ ಪುಸ್ತಕದಲ್ಲಿ ಪ್ರಖ್ಯಾತನಾದ ಯಾಜಕನಿದ್ದಾನೆ (21:1; 29:25, 29; 37:3; 52:24), ಆದರೆ ಚೆಫನ್ಯನಿಗೆ ಮೇಲಣ ಬರಹದಲ್ಲಿರುವ ಹೆಸರಿನೊಂದಿಗೆ ಯಾವುದೇ ಸಂಬಂಧವಿಲ್ಲ. ಚೆಫನ್ಯನಿಗೆ ಅವನ ಪೂರ್ವಜರ ಆಧಾರದ ಮೇಲೆ ರಾಜಮನೆತನದ ಹಿನ್ನಲೆಯುಳ್ಳವನಾಗಿದ್ದಾನೆ ಎಂದು ಸಾಮಾನ್ಯವಾಗಿ ಹೇಳಲಾಗುತ್ತದೆ. ಯೆಶಾಯ ಮತ್ತು ಮೀಕನ ಸಮಯದಿಂದ ಯೆಹೂದದ ವಿರುದ್ಧವಾಗಿ ಪ್ರವಾದಿಸಿ ಬರೆದಂಥ ಪ್ರವಾದಿಗಳಲ್ಲಿ ಚೆಫನ್ಯನು ಮೊದಲನೆಯವನು.</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿ.ಪೂ. 640-607 ರ ನಡುವಿನ ಕಾಲದಲ್ಲಿ ಬರೆದಿರಬಹುದು.</para>
  <para style="ip">ಯೆಹೂದದ ಅರಸನಾದ ಯೋಷೀಯನ ಆಳ್ವಿಕೆಯಲ್ಲಿ ಚೆಫನ್ಯನು ಪ್ರವಾದಿಸಿದನೆಂದು ಈ ಪುಸ್ತಕವು ನಮಗೆ ಹೇಳುತ್ತದೆ (ಚೆಫನ್ಯ 1:1).</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಯೆಹೂದದ ಜನರು (ದಕ್ಷಿಣ ರಾಜ್ಯ) ಮತ್ತು ಎಲ್ಲೆಡೆಯಿರುವ ದೇವರ ಜನರಿಗಿರುವ ಸಾಮಾನ್ಯ ಪತ್ರ.</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ಚೆಫನ್ಯನ ನ್ಯಾಯತೀರ್ಪಿನ ಮತ್ತು ಪ್ರೋತ್ಸಾಹದ ಸಂದೇಶವು ಮೂರು ಪ್ರಮುಖ ಸಿದ್ಧಾಂತಗಳನ್ನೊಳಗೊಂಡಿವೆ, ದೇವರು ಎಲ್ಲಾ ರಾಷ್ಟ್ರಗಳ ಮೇಲೆ ಸಾರ್ವಭೌಮತ್ವವನ್ನು ಹೊಂದಿದ್ದಾನೆ, ನ್ಯಾಯದ ತೀರ್ಪಿನ ದಿನದಂದು ದುಷ್ಟರು ಶಿಕ್ಷಿಸಲ್ಪಡುತ್ತಾರೆ ಮತ್ತು ನೀತಿವಂತರು ವಿಮೋಚಿಸಲ್ಪಡುತ್ತಾರೆ, ದೇವರು ಪಶ್ಚಾತ್ತಾಪಪಡುವವರನ್ನು ಮತ್ತು ತನ್ನಲ್ಲಿ ಭರವಸೆಯನ್ನಿಡುವವರನ್ನು ಆಶೀರ್ವದಿಸುತ್ತಾನೆ.</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ಕರ್ತನ ಮಹಾ ದಿನ</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ಬರಲಿರುವ ಕರ್ತನ ದಿನದ ವಿನಾಶ — 1:1-18</para>
  <para style="io1">2. ನಿರೀಕ್ಷೆಯ ವಿರಾಮ — 2:1-3</para>
  <para style="io1">3. ದೇಶಗಳ ವಿನಾಶ — 2:4-15</para>
  <para style="io1">4. ಯೆರೂಸಲೇಮಿನ ವಿನಾಶ — 3:1-7</para>
  <para style="io1">5. ಹಿಂತಿರುಗುವಿಕೆಯ ನಿರೀಕ್ಷೆ — 3:8-20</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>ಆಮೋನನ ಮಗನೂ, ಯೆಹೂದದ ಅರಸನಾದ ಯೋಷೀಯನ ಕಾಲದಲ್ಲಿ ಕೂಷಿಯನ ಮಗನೂ, ಗೆದಲ್ಯನ ಮೊಮ್ಮಗನೂ, ಹಿಜ್ಕೀಯನಿಗೆ ಹುಟ್ಟಿದ ಅಮರ್ಯನ ಮರಿಮಗನೂ ಆದ ಚೆಫನ್ಯನಿಗೆ ಯೆಹೋವನು ದಯಪಾಲಿಸಿದ ವಾಕ್ಯ.<verse eid="ZEP 1:1"/></para>
  <para style="s">ಮುಂಬರಲಿರುವ ನಾಶನ</para>
  <para style="p">
    <verse number="2" style="v" sid="ZEP 1:2"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ, “ನಾನು ಭೂಮಂಡಲದಿಂದ ಸಮಸ್ತವನ್ನು ಅಳಿಸಿಬಿಡುವೆನು.<verse eid="ZEP 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 1:3"/>ಮನುಷ್ಯರನ್ನೂ, ಪಶುಗಳನ್ನೂ, ಮತ್ತು ಆಕಾಶದ ಪಕ್ಷಿಗಳನ್ನೂ, ಸಮುದ್ರದ ಮೀನುಗಳನ್ನೂ ನಾಶಪಡಿಸುವೆನು; ವಿಗ್ರಹಗಳೆಂಬ ವಿಘ್ನಗಳನ್ನೂ,</para>
  <para style="q" vid="ZEP 1:3">ಅವುಗಳಿಗೆ ಅಡ್ಡಬೀಳುವ ದುಷ್ಟರನ್ನೂ ಸಂಹರಿಸುವೆನು; ಭೂಮಿಯ ಮೇಲಿಂದ ದುಷ್ಟರ ಸಂತಾನವನ್ನೂ ಕಿತ್ತುಹಾಕುವೆನು” ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="ZEP 1:3"/></para>
  <para style="s">ಯೆಹೂದಕ್ಕೆ ದೇವರ ದಂಡನೆ ತಪ್ಪದು</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 1:4"/>“ನಾನು ಯೆಹೂದದ ಮೇಲೂ ಮತ್ತು ಯೆರೂಸಲೇಮಿನವರೆಲ್ಲರ ಮೇಲೂ ಕೈಯೆತ್ತಿ,</para>
  <para style="q" vid="ZEP 1:4">ಈ ಸ್ಥಳದಿಂದ ಬಾಳನ ಪೂಜೆಯನ್ನು ನಿಶ್ಶೇಷಗೊಳಿಸಿ, ಕೆಮಾರ್ಯ ಮೊದಲಾದ ಪೂಜಾರಿಗಳನ್ನು ನಿರ್ನಾಮ ಮಾಡುವೆನು,<verse eid="ZEP 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 1:5"/>ಮಾಳಿಗೆಗಳ ಮೇಲೆ ಆಕಾಶದ ನಕ್ಷತ್ರಗಣವನ್ನು ಪೂಜಿಸುವವರನ್ನೂ,</para>
  <para style="q" vid="ZEP 1:5">ಯೆಹೋವನ ಭಕ್ತರೆಂದು ಪ್ರತಿಜ್ಞೆ ಮಾಡಿಕೊಂಡು ಆರಾಧಿಸಿ ಮಲ್ಕಾಮನ<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">ಮಲ್ಕಾಮನ </char><char style="ft" closed="false">ಇದು ವಿಗ್ರಹ, ಆಮೋನ್ಯರ ದೇವತೆ.</char></note> ಮೇಲೆ ಆಣೆಯಿಡುವವರನ್ನೂ,<verse eid="ZEP 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 1:6"/>ಯೆಹೋವನನ್ನು ಆಶ್ರಯಿಸದೆ, ಯೆಹೋವನ ದರ್ಶನವನ್ನು ಬಯಸದೇ, ಯೆಹೋವನ ಮಾರ್ಗ ಬಿಟ್ಟವರನ್ನೂ ಧ್ವಂಸ ಮಾಡುವೆನು.”<verse eid="ZEP 1:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ZEP 1:7"/>ಕರ್ತನಾದ ಯೆಹೋವನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಮೌನವಾಗಿರಿ, ಯೆಹೋವನ ನ್ಯಾಯತೀರ್ಪಿನ ದಿನವು ಸಮೀಪಿಸಿತು;</para>
  <para style="q2" vid="ZEP 1:7">ಯೆಹೋವನು ಯಜ್ಞದ ಔತಣವನ್ನು ಸಿದ್ಧಪಡಿಸಿದ್ದಾನೆ, ಕರೆದವರನ್ನು ಪ್ರತಿಷ್ಠಿಸಿದ್ದಾನೆ.<verse eid="ZEP 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 1:8"/>“ಯೆಹೋವನ ಆ ಯಜ್ಞದಿನದಲ್ಲಿ ನಾನು ದೇಶಾಧಿಪತಿಗಳನ್ನೂ,</para>
  <para style="q" vid="ZEP 1:8">ರಾಜವಂಶದವರನ್ನೂ, ವಿದೇಶ ವಸ್ತ್ರದಾರಿಗಳೆಲ್ಲರನ್ನೂ ದಂಡಿಸುವೆನು.<verse eid="ZEP 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 1:9"/>ಹೊಸ್ತಿಲನ್ನು ದಾಟಿ ಮೋಸ ಹಿಂಸೆಗಳಿಂದ ದೋಚಿದ್ದನ್ನು,</para>
  <para style="q" vid="ZEP 1:9">ತಮ್ಮ ಒಡೆಯನ ಮನೆಯೊಳಗೆ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">ಒಡೆಯನ ಮನೆಯೊಳಗೆ </char><char style="ft" closed="false">ಅಥವಾ ತಮ್ಮ ದೇವಸ್ಥಾನದೊಳಗೆ.</char></note> ತುಂಬಿಸುವವರೆಲ್ಲರನ್ನು ಆ ದಿನದಲ್ಲಿ ದಂಡಿಸುವೆನು.<verse eid="ZEP 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 1:10"/>ಅದೇ ದಿನದಲ್ಲಿ ಮೀನುಬಾಗಿಲಿನಿಂದ ಕೂಗಾಟ,</para>
  <para style="q" vid="ZEP 1:10">ಎರಡನೆಯ ಕೇರಿಯಿಂದ ಗೋಳಾಟ, ಗುಡ್ಡಗಳ ಮೇಲಿನಿಂದ ಭೀಕರ ಶಬ್ದವನ್ನು ಕೇಳುವಿರಿ,</para>
  <para style="q" vid="ZEP 1:10">ಅಂತು ದೊಡ್ಡ ಗದ್ದಲವಾಗುವುದು” ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="ZEP 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 1:11"/>ಯೆರುಸಲೇಮ್ ಜಿಲ್ಲೆಯ ಮಾರುಕಟ್ಟೆಯಲ್ಲಿ ವಾಸಿಸುವವರೇ, ಕೂಗಿರಿ,</para>
  <para style="q" vid="ZEP 1:11">ಏಕೆಂದರೆ ಎಲ್ಲಾ ವರ್ತಕರ ಜನರೆಲ್ಲಾ ಹಾಳಾದರು, ಬೆಳ್ಳಿಯ ವ್ಯಾಪಾರಿಗಳೆಲ್ಲರೂ ನಾಶವಾದರು.<verse eid="ZEP 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 1:12"/>ಆ ಕಾಲದಲ್ಲಿ ನಾನು ದೀಪಗಳನ್ನು ಹಿಡಿದು,</para>
  <para style="q" vid="ZEP 1:12">ಯೆರೂಸಲೇಮನ್ನೆಲ್ಲಾ ಹುಡುಕಿಬಿಡುವೆನು;</para>
  <para style="q" vid="ZEP 1:12">ಯೆಹೋವನು ಮೇಲನ್ನಾಗಲಿ, ಕೇಡನ್ನಾಗಲಿ ಮಾಡನು ಎಂದು ಮನಸ್ಸಿನೊಳಗೆ ಅಂದುಕೊಳ್ಳುವವರಾಗಿ,</para>
  <para style="q" vid="ZEP 1:12">ಮಡ್ಡಿಯಂತೆ ಮಂದವಾಗಿರುವ ದ್ರಾಕ್ಷಾರಸಕ್ಕೆ ಸಮಾನರಾದ ಜನರನ್ನು ದಂಡಿಸುವೆನು.<verse eid="ZEP 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 1:13"/>ಅವರ ಆಸ್ತಿಯು ಸೂರೆಯಾಗುವುದು, ಅವರ ಮನೆಗಳು ಹಾಳಾಗುವವು;</para>
  <para style="q" vid="ZEP 1:13">ಅವರು ಮನೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡರೂ ಅವುಗಳಲ್ಲಿ ವಾಸಿಸರು, ದ್ರಾಕ್ಷಾತೋಟಗಳನ್ನು ಮಾಡಿಕೊಂಡರೂ ಅವುಗಳ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯರು.<verse eid="ZEP 1:13"/></para>
  <para style="s">ಯೆಹೋವನ ದಿನದ ವಿವರಣೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="ZEP 1:14"/>ಯೆಹೋವನ ಮಹಾದಿನವು ಸಮೀಪಿಸಿತು, ಬಹು ತ್ವರೆಯಾಗಿ ಬರುತ್ತಿದೆ;</para>
  <para style="q" vid="ZEP 1:14">ಆಹಾ, ಕಿವಿಗೊಡಿರಿ, ಯೆಹೋವನ ದಿನವೇ ಬಂದಿತು; ಇಗೋ, ಅಲ್ಲಿ ಒಬ್ಬ ಶೂರನು ಘೋರವಾಗಿ ಗೋಳಾಡುತ್ತಿದ್ದಾನೆ!<verse eid="ZEP 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 1:15"/>ಆ ದಿನದ ಸುದ್ದಿ ಕಹಿಯಾದುದು, ಅದು ರೌದ್ರದ ದಿನ, ಶ್ರಮಸಂಕಟಗಳ ದಿನ,</para>
  <para style="q" vid="ZEP 1:15">ಹಾಳುಪಾಳುಮಾಡುವ ದಿನ, ಕತ್ತಲಿನ ಮೊಬ್ಬಿನ ದಿನ,</para>
  <para style="q" vid="ZEP 1:15">ಕಾರ್ಮುಗಿಲ ಕಗ್ಗತ್ತಲ ದಿನ!<verse eid="ZEP 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 1:16"/>ಕೋಟೆಗಳನ್ನೂ, ದೊಡ್ಡ ಕೊತ್ತಲುಗಳನ್ನೂ ಹಿಡಿಯಲು,</para>
  <para style="q" vid="ZEP 1:16">ಆರ್ಭಟಿಸಿ ಕೊಂಬೂದುವ ದಿನ.<verse eid="ZEP 1:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ZEP 1:17"/>ಯೆಹೋವನಾದ ನನಗೆ ಜನರು ಪಾಪಮಾಡಿದ ಕಾರಣ</para>
  <para style="q2" vid="ZEP 1:17">ಕುರುಡರಂತೆ ನಡೆಯುವ ಹಾಗೆ ಅವರನ್ನು ಸಂಕಟಪಡಿಸುವೆನು;</para>
  <para style="q2" vid="ZEP 1:17">ಅವರ ರಕ್ತವು ಧೂಳಿನಂತೆ ಚೆಲ್ಲಿ ಹೋಗುವುದು, ಅವರ ಮಾಂಸವು ಮಲದ ಹಾಗೆ ಬಿದ್ದಿರುವುದು!<verse eid="ZEP 1:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ZEP 1:18"/>ಯೆಹೋವನ ರೌದ್ರದ ದಿನದಲ್ಲಿ ಅವರ ಬೆಳ್ಳಿ, ಬಂಗಾರಗಳೂ ಕೂಡಾ ಅವರನ್ನು ರಕ್ಷಿಸಲಾರವು;</para>
  <para style="q2" vid="ZEP 1:18">ಆತನ ರೋಷಾಗ್ನಿಯು ದೇಶವನ್ನೆಲ್ಲಾ ನುಂಗಿಬಿಡುವುದು;</para>
  <para style="q2" vid="ZEP 1:18">ಆತನು ದೇಶನಿವಾಸಿಗಳೆಲ್ಲರನ್ನೂ ಕೊನೆಗಾಣಿಸುವನು, ಹೌದು, ಘೋರವಾಗಿ ನಿರ್ಮೂಲಮಾಡುವನು!<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="s">ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ಕರೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 2:1"/>ನಾಚಿಕೆಗೇಡಿ ಜನಾಂಗದವರೇ, ತೀರ್ಪು ಫಲಿಸುವುದರೊಳಗೆ,</para>
  <para style="q" vid="ZEP 2:1">ಯೆಹೋವನ ಉಗ್ರಕೋಪವು ನಿಮ್ಮ ಮೇಲೆ ಬರುವುದಕ್ಕೆ ಮೊದಲೇ</para>
  <para style="q" vid="ZEP 2:1">ಯೆಹೋವನ ಸಿಟ್ಟಿನ ದಿನವೂ ಉರಿದು ನಿಮ್ಮ ಮೇಲೆ ಬರುವುದಕ್ಕಿಂತ ಮೊದಲೇ,</para>
  <para style="q" vid="ZEP 2:1">ನೀವೆಲ್ಲರೂ ಸೇರಿ ಬನ್ನಿರಿ, ಒಟ್ಟಾಗಿ ಕೂಡಿರಿ.<verse eid="ZEP 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 2:2"/>ಆ ಕಾಲವು ಹೊಟ್ಟಿನಂತೆ ಹಾರಿಹೋಗುತ್ತದಲ್ಲಾ.<verse eid="ZEP 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 2:3"/>ಯೆಹೋವನ ನಿಯಮವನ್ನು ಕೈಕೊಂಡು ನಡೆಯುವ ಲೋಕದ ದೀನರೇ,</para>
  <para style="q" vid="ZEP 2:3">ನೀವೆಲ್ಲರೂ ಯೆಹೋವನ ನೀತಿಯನ್ನು ಅನುಸರಿಸಿರಿ, ಧರ್ಮವನ್ನು ಅಭ್ಯಾಸಿಸಿರಿ, ನಮ್ರತೆಯನ್ನು ಹೊಂದಿಕೊಳ್ಳಿರಿ;</para>
  <para style="q" vid="ZEP 2:3">ಬಹುಶಃ ಯೆಹೋವನ ಸಿಟ್ಟಿನ ದಿನದಲ್ಲಿ ನೀವು ಮರೆಯಾಗುವಿರಿ.<verse eid="ZEP 2:3"/></para>
  <para style="s">ಫಿಲಿಷ್ಟಿಯರ ದುರ್ಗತಿ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 2:4"/>ಗಾಜ ಪಟ್ಟಣ ನಿರ್ಜನವಾಗುವುದು, ಅಷ್ಕೆಲೋನ್ ಹಾಳಾಗುವುದು,</para>
  <para style="q" vid="ZEP 2:4">ಅಷ್ಡೋದ್ ನಿವಾಸಿಗಳನ್ನು ನಡು ಮಧ್ಯಾಹ್ನದಲ್ಲಿ ಆಕ್ರಮಿಸಿ ಓಡಿಸಿಬಿಡುವರು, ಎಕ್ರೋನ್ ನಗರ ನಿರ್ಮೂಲವಾಗುವುದು.<verse eid="ZEP 2:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ZEP 2:5"/>ಅಯ್ಯೋ, ಕರಾವಳಿಯಲ್ಲಿ ವಾಸಿಸುವ ಕೆರೇತ್ಯ ಜನಾಂಗವೇ, ನಿನ್ನ ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ!</para>
  <para style="q2" vid="ZEP 2:5">ಕಾನಾನೇ, ಫಿಲಿಷ್ಟಿಯ ದೇಶವೇ, ಯೆಹೋವನ ನುಡಿಯು ನಿನಗೆ ವಿರುದ್ಧವಾಗಿದೆ; ನಿನ್ನಲ್ಲಿ ವಾಸಿಸುವ ಜನರೇ ನಿಲ್ಲದಂತೆ ನಿನ್ನನ್ನು ನಾಶಮಾಡುವೆನು.<verse eid="ZEP 2:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ZEP 2:6"/>ಸಮುದ್ರ ತೀರದ ಆ ಪ್ರಾಂತ್ಯವು ಹುಲ್ಲುಗಾವಲಾಗಿ, ಕುರುಬರ ಗುಡಿಸಲಾಗಿ, ಹಿಂಡುಗಳ ದೊಡ್ಡಿಗಳು ಇವೇ ಅಲ್ಲಿರುವವು.<verse eid="ZEP 2:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ZEP 2:7"/>ಆ ಕರಾವಳಿಯು ಉಳಿದ ಯೆಹೂದ್ಯರ ಪಾಲಾಗುವುದು;</para>
  <para style="q2" vid="ZEP 2:7">ದನಕುರಿಗಳನ್ನು ಅಲ್ಲೇ ಮೇಯಿಸುವರು; ಸಂಜೆಗೆ ಅಷ್ಕೆಲೋನಿನ ಮನೆಗಳಲ್ಲಿ ಮಲಗಿಕೊಳ್ಳುವರು;</para>
  <para style="q2" vid="ZEP 2:7">ಅವರ ದೇವರಾದ ಯೆಹೋವನು ಅವರನ್ನು ಪರಾಂಬರಿಸಿ ಅವರ ದುರವಸ್ಥೆಯನ್ನು ತಪ್ಪಿಸುವನು.<verse eid="ZEP 2:7"/></para>
  <para style="s">ಮೋವಾಬ್ಯರ ಮತ್ತು ಅಮ್ಮೋನಿಯರ ದುರ್ಗತಿ</para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 2:8"/>ಮೋವಾಬ್ಯರೂ, ಅಮ್ಮೋನ್ಯರೂ ಅಹಂಕಾರದಿಂದ ನನ್ನ ಜನರ ಮೇರೆಯನ್ನು ಮೀರಿ,</para>
  <para style="q" vid="ZEP 2:8">ಅವರನ್ನು ನಿಂದಿಸಿ, ಅವರ ಮೇಲೆ ಹೊರಿಸಿರುವ ದೂರುದೂಷಣೆಗಳು ನನ್ನ ಕಿವಿಗೆ ಬಿದ್ದಿವೆ.<verse eid="ZEP 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 2:9"/>ಇಸ್ರಾಯೇಲರ ದೇವರಾದ ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="ZEP 2:9">“ನನ್ನ ಜೀವದಾಣೆ, ಸೊದೋಮಿನ ಗತಿಯೇ ಮೋವಾಬಿಗೂ ಆಗುವುದು. ಗೊಮೋರದ ದುರ್ದಶೆಯೇ ಅಮ್ಮೋನ್ಯರಿಗೆ ಸಂಭವಿಸುವುದು;</para>
  <para style="q" vid="ZEP 2:9">ಆ ಪ್ರಾಂತ್ಯಗಳು ಮುಳ್ಳುಗಿಡಗಳಿಂದಲೂ, ಸೌಳುಗುಂಡಿಗಳಿಂದಲೂ ತುಂಬಿಕೊಂಡು ನಿತ್ಯ ನಾಶನಕ್ಕೆ ಈಡಾಗುವವು;</para>
  <para style="q" vid="ZEP 2:9">ನನ್ನ ಜನರಲ್ಲಿ ಉಳಿದವರು ಅವುಗಳನ್ನು ಸೂರೆಮಾಡುವರು.</para>
  <para style="q" vid="ZEP 2:9">ಅಳಿದುಳಿದ ನನ್ನ ಜನರಿಗೆ ಅವು ಸ್ವಾಸ್ತ್ಯವಾಗುವವು<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">ಆದಿ 19:23-29 ನೋಡಿರಿ.</char></note>.”<verse eid="ZEP 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 2:10"/>ಆ ಪ್ರಾಂತ್ಯಗಳವರು ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನ ಜನರನ್ನು ದೂಷಿಸಿ, ಅವರ ಮೇಲೆ ಉಬ್ಬಿಕೊಂಡು ಬಂದುದ್ದರಿಂದ ಅವರ ಅಹಂಕಾರದ ನಿಮಿತ್ತವೇ ಅವರಿಗೆ ಈ ಗತಿಯಾಗುವುದು! <verse eid="ZEP 2:10"/><verse number="11" style="v" sid="ZEP 2:11"/>ಯೆಹೋವನು ಅವರಿಗೆ ಭಯಂಕರನಾಗುವನು; ಲೋಕದ ದೇವರುಗಳನ್ನೆಲ್ಲಾ ನಾಶಮಾಡುವನು; ಸಮಸ್ತ ಜನರು, ಪ್ರತಿಯೊಂದು ಪ್ರಾಂತ್ಯದ ನಿವಾಸಿಗಳು ಸಕಲ ಜನಾಂಗಗಳವರು ತಮ್ಮ ತಮ್ಮ ಸ್ಥಳಗಳಲ್ಲೇ ಆತನನ್ನು ಆರಾಧಿಸುವರು.<verse eid="ZEP 2:11"/></para>
  <para style="s">ಕೂಷಿನ ದುರ್ಗತಿ</para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 2:12"/>ಕೂಷಿನವರೇ, ನೀವು ಸಹ ನನ್ನ ಖಡ್ಗದಿಂದ ಹತರಾಗುವಿರಿ.<verse eid="ZEP 2:12"/></para>
  <para style="s">ಅಶ್ಶೂರ್ಯರ ದುರ್ಗತಿ</para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 2:13"/>ಯೆಹೋವನು ಉತ್ತರಕ್ಕೆ ಕೈಚಾಚಿ ಅಶ್ಶೂರವನ್ನು ಧ್ವಂಸ ಮಾಡುವನು;</para>
  <para style="q" vid="ZEP 2:13">ನಿನವೆಯನ್ನು ಹಾಳುಮಾಡಿ ನೀರಿಲ್ಲದ ಮರುಭೂಮಿಯಂತೆ ಒಣಗಿಸಿಬಿಡುವನು.<verse eid="ZEP 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 2:14"/>ಜನಾಂಗಗಳ ಪಶುಗಳೆಲ್ಲಾ ಮಂದೆಮಂದೆಯಾಗಿ ಅದರ ಮಧ್ಯದಲ್ಲಿ ಮಲಗಿಕೊಳ್ಳುವವು;</para>
  <para style="q" vid="ZEP 2:14">ಕೊಕ್ಕರೆಯೂ, ಮುಳ್ಳುಹಂದಿಯೂ ಹಟ್ಟಿಗಳಲ್ಲಿ ವಾಸಮಾಡಿಕೊಳ್ಳುವವು.</para>
  <para style="q" vid="ZEP 2:14">ಗೂಬೆಯು ಕಿಟಕಿಗಳಲ್ಲಿ ಮನೆಕಂಬಗಳ ಮೇಲೆ ಚಿಲಿಪಿಲಿ ಗಾನವು ತಂಗುವವು; ಕಾಗೆಗಳ ಕೂಗು ಹೊಸ್ತಿಲುಗಳಲ್ಲಿ ಕೇಳುವುದು; ದೇವದಾರು ಹಲಿಗೆಯ ಹೊದಿಕೆಯು ಕೀಳಲ್ಪಡುವುದು.<verse eid="ZEP 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 2:15"/>ಈ ನಿನವೆಯು ಮೊದಲು ಉಲ್ಲಾಸದ ನಗರಿಯಾಗಿ ನೆಮ್ಮದಿಯಿಂದ ನೆಲೆಗೊಂಡಿದ್ದು</para>
  <para style="q" vid="ZEP 2:15">ತನ್ನ ಹೃದಯದೊಳಗೆ, “ನಾನೇ ಇರುವವಳು, ನನ್ನ ಹೊರತು ಇನ್ನು ಯಾರೂ ಇಲ್ಲ” ಅಂದುಕೊಳ್ಳುತ್ತಿತ್ತು;</para>
  <para style="q" vid="ZEP 2:15">ಅಯ್ಯೋ, ಎಷ್ಟೋ ಹಾಳಾಗಿ ಹೋಗಿ ಮೃಗಗಳು ತಂಗುವ ಕೊಟ್ಟಿಗೆಯ ಬೀಡಾಗಿದೆ!</para>
  <para style="q" vid="ZEP 2:15">ಅದರ ಮುಂದೆ ಹಾದುಹೋಗುವವರೆಲ್ಲರು ಸಿಳ್ಳು ಹಾಕಿ ಅಪಹಾಸ್ಯ ಮಾಡುತ್ತಾರೆ.<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s">ಯೆರೂಸಲೇಮಿನ ಪಾಪ ಮತ್ತು ಬಿಡುಗಡೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 3:1"/>ಅಯ್ಯೋ, ಅವಿಧೇಯತೆ ಮಲಿನವೂ ಆದ ದಬ್ಬಾಳಿಕೆ ನಡೆಸುವ ನಗರದ<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">ನಗರದ </char><char style="ft" closed="false">ಯೆರೂಸಲೇಮ್.</char></note> ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ!<verse eid="ZEP 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 3:2"/>ಅದು ದೇವರ ವಾಕ್ಯಕ್ಕಾಗಲೀ ಆತನ ತಿದ್ದುಪಾಟಿಗಾಗಲಿ ಕಿವಿಗೊಡಲಿಲ್ಲ, ಶಿಕ್ಷಣಕ್ಕೆ ಒಳಪಡಲೇ ಇಲ್ಲ,</para>
  <para style="q" vid="ZEP 3:2">ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡಲಿಲ್ಲ, ತನ್ನ ದೇವರ ಸನ್ನಿಧಿಗೆ ಸಮೀಪಿಸಲಿಲ್ಲ.<verse eid="ZEP 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 3:3"/>ಅವರೊಳಗಿನ ಮುಖ್ಯಾಧಿಕಾರಿಗಳು ಗರ್ಜಿಸುವ ಸಿಂಹಗಳು;</para>
  <para style="q" vid="ZEP 3:3">ಅದರ ನ್ಯಾಯಾಧಿಪತಿಗಳು ಸಂಜೆಯ ತೋಳಗಳು; ಮರುದಿನ ಬೆಳಗ್ಗೆ ಕಡಿಯುವುದಕ್ಕೆ ಎಲುಬು ಸಹಾ ಬಿಡದ ಕ್ರೂರರು.<verse eid="ZEP 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 3:4"/>ಅಲ್ಲಿರುವ ಪ್ರವಾದಿಗಳು ಬಡಾಯಿ ಕೊಚ್ಚಿಕೊಳ್ಳುವವರು, ವಿಶ್ವಾಸ ದ್ರೋಹಿಗಳು;</para>
  <para style="q" vid="ZEP 3:4">ಅದರ ಯಾಜಕರು ಪವಿತ್ರಾಲಯವನ್ನು ಹೊಲೆಗೆಡಿಸಿದ್ದಾರೆ, ಧರ್ಮವಿಧಿಗಳನ್ನು ಭಂಗಮಾಡಿದ್ದಾರೆ.<verse eid="ZEP 3:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ZEP 3:5"/>ಅದರ ಮಧ್ಯ ನೆಲೆಗೊಂಡಿರುವ ಯೆಹೋವನು ನೀತಿಸ್ವರೂಪನು; ಎಂದಿಗೂ ಅನ್ಯಾಯವನ್ನು ಮಾಡನು;</para>
  <para style="q2" vid="ZEP 3:5">ಪ್ರತಿ ಬೆಳಿಗ್ಗೆ ತನ್ನ ನ್ಯಾಯವನ್ನು ತಪ್ಪದೆ ಪ್ರಕಾಶಗೊಳಿಸುವನು; ಅನ್ಯಾಯಗಾರನೋ ನಾಚಿಕೆಪಡುವುದಿಲ್ಲ.<verse eid="ZEP 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 3:6"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ, “ನಾನು ಜನಾಂಗಗಳನ್ನು ಧ್ವಂಸಪಡಿಸಿದ್ದೇನೆ, ಅವುಗಳ ಕೋಟೆ ಕೊತ್ತಲುಗಳು ಪಾಳು ಬಿದ್ದವು;</para>
  <para style="q" vid="ZEP 3:6">ಅವುಗಳ ಬೀದಿಗಳನ್ನು ಹಾಳುಮಾಡಿದ್ದೇನೆ; ಯಾರೂ ಹಾದುಹೋಗರು;</para>
  <para style="q" vid="ZEP 3:6">ಅವುಗಳ ಪಟ್ಟಣಗಳು ನಾಶವಾದವು, ಜನರೇ ಇಲ್ಲ, ನಿರ್ನಾಮವಾಗಿವೆ.<verse eid="ZEP 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 3:7"/>ಇದರಿಂದ ಯೆರೂಸಲೇಮೇ, ನೀನು ನನಗೆ ನಿಶ್ಚಯವಾಗಿ ಭಯಪಡುವಿ, ಶಿಕ್ಷಣಕ್ಕೆ ಒಳಪಡುವಿ,</para>
  <para style="q" vid="ZEP 3:7">ನಿನ್ನ ನಿವಾಸವು ನಾಶವಾಗದು, ನಾನು ನಿನಗೆ ವಿಧಿಸಿದ್ದೊಂದೂ ತಗಲದು” ಎಂದು ಅಂದುಕೊಂಡೆನು;</para>
  <para style="q" vid="ZEP 3:7">ಅವರಾದರೋ ಆತುರಗೊಂಡು ತಮ್ಮ ನಡತೆಯನ್ನೆಲ್ಲಾ ಕೆಡಿಸಿಕೊಂಡರು.<verse eid="ZEP 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 3:8"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ, “ಹೀಗಿರಲು ನನಗಾಗಿ ಕಾದುಕೊಂಡಿರಿ, ನಾನು ಬೇಟೆಹಿಡಿಯಲಿಕ್ಕೆ ಏಳುವ ದಿನವನ್ನು ಎದುರುನೋಡಿರಿ;</para>
  <para style="q" vid="ZEP 3:8">ಜನಾಂಗರಾಜ್ಯಗಳ ಮೇಲೆ ನನ್ನ ರೌದ್ರವನ್ನು, ಹೌದು, ನನ್ನ ಉಗ್ರಕೋಪವನ್ನೆಲ್ಲಾ ಹೊಯ್ದು ಬಿಡುವುದಕ್ಕಾಗಿ</para>
  <para style="q" vid="ZEP 3:8">ಆ ಜನಾಂಗಗಳನ್ನು ಸೇರಿಸಿ ಆ ರಾಜ್ಯಗಳನ್ನು ಕೂಡಿಸಬೇಕೆಂದು ತೀರ್ಮಾನಿಸಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="ZEP 3:8">ಲೋಕವೆಲ್ಲಾ ನನ್ನ ರೋಷಾಗ್ನಿಗೆ ತುತ್ತಾಗುವುದಷ್ಟೇ.<verse eid="ZEP 3:8"/></para>
  <para style="s">ಯೆಹೋವನ ಸರ್ವಾಧಿಪತ್ಯ</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEP 3:9"/>“ಆಗ ಎಲ್ಲರೂ ಒಂದೇ ಮನಸ್ಸಿನಿಂದ ಯೆಹೋವನನ್ನು ಸೇವಿಸಿ ಆತನ ಹೆಸರನ್ನೆತ್ತಿ ಪ್ರಾರ್ಥಿಸುವಂತೆ</para>
  <para style="q" vid="ZEP 3:9">ಜನಾಂಗಗಳವರ ತುಟಿಗಳನ್ನು ಮಾರ್ಪಡಿಸಿ ಶುದ್ಧಿಮಾಡುವೆನು.<verse eid="ZEP 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 3:10"/>ಚದರಿಹೋಗಿರುವ ನನ್ನ ಜನರು, ನನ್ನ ಭಕ್ತರು, ಕೂಷಿನ ನದಿಗಳ ಆಚೆಯಿಂದಲೂ ನನಗೆ ಕಾಣಿಕೆಯನ್ನು ತಂದು ಸಮರ್ಪಿಸುವರು.<verse eid="ZEP 3:10"/></para>
  <para style="s">ದೇವಜನರ ದೈನ್ಯಭಕ್ತಿ</para>
  <para style="p">
    <verse number="11" style="v" sid="ZEP 3:11"/>“ನೀನು ನನಗೆ ಮಾಡಿದ ನಾನಾ ದುಷ್ಕೃತ್ಯಗಳು ಮುಂದಿನ ಆ ಕಾಲದಲ್ಲಿ ನಿನಗೆ ನಾಚಿಕೆಗೆ ಈಡಾಗುವವು;</para>
  <para style="q" vid="ZEP 3:11">ಆಗ ತಮ್ಮ<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fq" closed="false">ತಮ್ಮ </char><char style="ft" closed="false">ಅಥವಾ ನಿಮ್ಮ.</char></note> ಅತಿಗರ್ವದಿಂದ ಮೆರೆಯುವವರನ್ನು ನಿನ್ನೊಳಗಿಂದ ತೊಲಗಿಸಿಬಿಡುವೆನು;</para>
  <para style="q" vid="ZEP 3:11">ಅಂದಿನಿಂದ ನನ್ನ ಪವಿತ್ರಪರ್ವತದಲ್ಲಿ ಗರ್ವಪಡದೆ ಇರುವಿ.<verse eid="ZEP 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 3:12"/>ದೀನದರಿದ್ರ ಜನರನ್ನು ನಿನ್ನಲ್ಲಿ ಉಳಿಸುವೆನು;</para>
  <para style="q" vid="ZEP 3:12">ಅವರು ಯೆಹೋವನ ನಾಮವನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವರು,<verse eid="ZEP 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 3:13"/>ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಉಳಿದವರು ಅನ್ಯಾಯವನ್ನು ಮಾಡರು, ಸುಳ್ಳಾಡರು;</para>
  <para style="q" vid="ZEP 3:13">ಅವರ ಬಾಯಲ್ಲಿ ಮೋಸದ ನಾಲಿಗೆಯು ಇರದು;</para>
  <para style="q" vid="ZEP 3:13">ಕುರಿ ಮಂದೆಯಂತೆ ಮೇದು ಮಲಗಿಕೊಳ್ಳುವರು, ಅವರನ್ನು ಯಾರೂ ಹೆದರಿಸರು.”<verse eid="ZEP 3:13"/></para>
  <para style="s">ಯೆಹೋವನ ಪ್ರಸನ್ನತೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="ZEP 3:14"/>ಚೀಯೋನ್ ಕುವರಿಯೇ<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">ಚೀಯೋನ್ ಕುವರಿಯೇ</char><char style="ft" closed="false">ಇಸ್ರಾಯೇಲ್ ಜನರೇ.</char></note>, ಹರ್ಷಧ್ವನಿಗೈ! ಇಸ್ರಾಯೇಲೇ, ಜಯಘೋಷಮಾಡು!</para>
  <para style="q" vid="ZEP 3:14">ಯೆರೂಸಲೇಮ್ ಕುವರಿಯೇ<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">ಯೆರೂಸಲೇಮ್ ಕುವರಿಯೇ</char><char style="ft" closed="false">ಯೆರೂಸಲೇಮ್ ಜನರೇ.</char></note>, ಹೃದಯಪೂರ್ವಕವಾಗಿ ಆನಂದಿಸು, ಉಲ್ಲಾಸಿಸು!<verse eid="ZEP 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 3:15"/>ನಿನಗೆ ವಿಧಿಸಿದ ದಂಡನೆಯನ್ನು ಯೆಹೋವನು ತಪ್ಪಿಸಿದ್ದಾನೆ, ನಿನ್ನ ಶತ್ರುವನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದಾನೆ;</para>
  <para style="q" vid="ZEP 3:15">ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೆಹೋವನು ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿದ್ದಾನೆ; ಇನ್ನು ಕೇಡಿಗೆ ಅಂಜದಿರುವಿ.<verse eid="ZEP 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 3:16"/>ಆ ದಿನದಲ್ಲಿ ಯೆರೂಸಲೇಮಿಗೆ, “ಚೀಯೋನೇ,</para>
  <para style="q" vid="ZEP 3:16">ಭಯಪಡಬೇಡ, ನಿನ್ನ ಕೈಗಳು ಜೋಲುಬೀಳದಿರಲಿ;<verse eid="ZEP 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 3:17"/>ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವನು ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ ಶೂರನಾಗಿದ್ದಾನೆ, ನಿನ್ನನ್ನು ರಕ್ಷಿಸುವನು;</para>
  <para style="q" vid="ZEP 3:17">ನಿನ್ನಲ್ಲಿ ಉಲ್ಲಾಸಿಸೇ ಉಲ್ಲಾಸಿಸುವನು;</para>
  <para style="q" vid="ZEP 3:17">ತನ್ನ ಪ್ರೀತಿಯಲ್ಲಿ ನಿನ್ನ ಜೀವನವನ್ನು ನೂತನಗೊಳಿಸುವನು<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fq" closed="false">ನಿನ್ನ ಜೀವನವನ್ನು ನೂತನಗೊಳಿಸುವನು </char><char style="ft" closed="false">ನಿನ್ನನ್ನು ಶಾಂತಗೊಳಿಸುವನು ಅಥವಾ ನಿನ್ನನ್ನು ಪುನಃ ಚೇತನಗೊಳಿಸುವನು.</char></note>;</para>
  <para style="q" vid="ZEP 3:17">ನಿನ್ನಲ್ಲಿ ಆನಂದಿಸಿ ಹರ್ಷಧ್ವನಿಗೈಯುವನು.<verse eid="ZEP 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 3:18"/>ಅವಮಾನವು ನಮ್ಮ ಪಟ್ಟಣದ ಮೇಲೆ ಹೊರೆಯಾಗಿ ಕಾಡುತ್ತಿದೆ ಎಂದು ತಿಳಿದು ಹಬ್ಬ ಉತ್ಸವಗಳಿಗೆ ದೂರವಾಗಿ ಶೋಕಿಸುತ್ತಿರುವ ನಿನ್ನವರನ್ನು ಒಟ್ಟಿಗೆ ಬರಮಾಡುವೆನು.<verse eid="ZEP 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEP 3:19"/>ಆಹಾ, ಆ ಕಾಲದಲ್ಲಿ ನಿನ್ನನ್ನು ಬಾಧಿಸುವವರಿಗೆ ತಕ್ಕದ್ದನ್ನು ಮಾಡುವೆನು;</para>
  <para style="q" vid="ZEP 3:19">ನಿನ್ನಲ್ಲಿ ಕುಂಟುವವರನ್ನು ರಕ್ಷಿಸುವೆನು, ಚದರಿ ಹೋದವರನ್ನು ಕೂಡಿಸುವೆನು;</para>
  <para style="q" vid="ZEP 3:19">ಅಂತು ಲೋಕದಲ್ಲೆಲ್ಲಾ ಅವಮಾನಪಟ್ಟವರಿಗೆ ಸ್ತೋತ್ರ ಕೀರ್ತನೆಗಳನ್ನು ಉಂಟುಮಾಡುವೆನು.<verse eid="ZEP 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ZEP 3:20"/>ಆ ಕಾಲದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕರೆದು ತರುವೆನು, ಹೌದು, ಆ ಕಾಲದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಒಟ್ಟುಗೂಡಿಸುವೆನು.</para>
  <para style="q" vid="ZEP 3:20">ನಾನು ನಿಮ್ಮ ದುರವಸ್ಥೆಯನ್ನು ನಿಮ್ಮ ಕಣ್ಣೆದುರಿಗೇ ತಪ್ಪಿಸುವಾಗ</para>
  <para style="q" vid="ZEP 3:20">ನಿಮ್ಮನ್ನು ಲೋಕದ ಸಕಲ ಜನಾಂಗಗಳಲ್ಲಿ ಕೀರ್ತಿ ಸ್ತೋತ್ರಗಳಿಗೆ ಗುರಿಮಾಡುವೆನು” ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
