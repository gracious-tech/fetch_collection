<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright © 2017 Bridge Connectivity Solutions. This translation is made available to you under the terms of the Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">ಹಬಕ್ಕೂಕನು</para>
  <para style="toc1">ಹಬಕ್ಕೂಕನು</para>
  <para style="toc2">ಹಬ</para>
  <para style="toc3">ಹಬ</para>
  <para style="mt">ಹಬಕ್ಕೂಕನು</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಹಬಕ್ಕೂಕನ ಪುಸ್ತಕವು ಪ್ರವಾದಿಯಾದ ಹಬಕ್ಕೂಕನಿಂದ ನುಡಿಯಲ್ಪಟ್ಟ ದೈವೋಕ್ತಿ ಎಂದು ಹಬ 1:1 ಗುರುತಿಸುತ್ತದೆ. ಅವನ ಹೆಸರಿಗೆ ಅತೀತವಾಗಿ ನಾವು ಮೂಲತಃ ಹಬಕ್ಕೂಕನ ಬಗ್ಗೆ ನಮಗೇನು ಗೊತ್ತಿಲ್ಲ. ಅವನು “ಪ್ರವಾದಿಯಾದ ಹಬಕ್ಕೂಕನು” ಎಂದು ಕರೆಯಲ್ಪಡುವ ಸಂಗತಿಯು ಅವನು ಪ್ರಸಿದ್ಧನಾದವನು ಮತ್ತು ಹೆಚ್ಚಿನ ಪರಿಚಯದ ಅಗತ್ಯವಿಲ್ಲ ಎಂದು ಸೂಚಿಸುತ್ತದೆ.</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿ.ಪೂ. 612-605 ರ ನಡುವಿನ ಕಾಲದಲ್ಲಿ ನಡೆದಿರಬಹುದು.</para>
  <para style="ip">ಹಬಕ್ಕೂಕನು ಈ ಪುಸ್ತಕವನ್ನು ಯೆಹೂದದ ಪತನಕ್ಕಿಂತ ಮುಂಚೆ ದಕ್ಷಿಣ ರಾಜ್ಯದಲ್ಲಿ ಬರೆದಿದ್ದಾನೆ.</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಯೆಹೂದದ ಜನರು (ದಕ್ಷಿಣ ರಾಜ್ಯ) ಮತ್ತು ಎಲ್ಲೆಡೆಯಿರುವ ದೇವರ ಜನರಿಗಿರುವ ಸಾಮಾನ್ಯ ಪತ್ರ.</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ದೇವರು ತಾನು ಆದುಕೊಂಡ ಜನರನ್ನು ಅವರ ವೈರಿಗಳ ಕೈಯಲ್ಲಿ ಪ್ರಸಕ್ತ ಸಂಕಟದ ಮೂಲಕ ಹಾದುಹೋಗಲು ಏಕೆ ಅನುಮತಿಸುತ್ತಾನೆಂದು ಹಬಕ್ಕೂಕನು ಆಶ್ಚರ್ಯಪಡುತ್ತಿದ್ದನು. ದೇವರು ಉತ್ತರಿಸಿದನು ಮತ್ತು ಹಬಕ್ಕೂಕನ ನಂಬಿಕೆಯು ಪುನಃಸ್ಥಾಪನೆಯಾಯಿತು, ಯೆಹೋವನು ತನ್ನ ಜನರ ಸಂರಕ್ಷಕನಾಗಿ, ತನ್ನ ಮೇಲೆ ಭರವಸೆಯಿಡುವವರನ್ನು ಕಾಪಾಡುತ್ತಾನೆ ಎಂದು ಘೋಷಿಸುವುದು, ಯೆಹೋವನು ಯೆಹೂದದ ಸಾರ್ವಭೌಮ ಶೂರನಾಗಿ, ಒಂದು ದಿನ ಅನ್ಯಾಯಸ್ಥರಾದ ಬಾಬಿಲೋನಿಯದವರಿಗೆ ನ್ಯಾಯತೀರಿಸುತ್ತಾನೆಂದು ಘೋಷಿಸುವುದು ಈ ಪುಸ್ತಕದ ಉದ್ದೇಶವಾಗಿದೆ. ಹಬಕ್ಕೂಕನ ಪುಸ್ತಕವು ಆಹಂಕಾರಿಗಳು ತಗ್ಗಿಸಲ್ಪಡುತ್ತಾರೆ ಮತ್ತು ನೀತಿವಂತರು ದೇವರಲ್ಲಿನ ನಂಬಿಕೆಯಿಂದ ಜೀವಿಸುತ್ತಾರೆ ಎಂಬ ಚಿತ್ರಣವನ್ನು ನಮಗೆ ನೀಡುತ್ತದೆ (2:4).</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ಸಾರ್ವಭೌಮನಾದ ದೇವರನ್ನು ನಂಬುವುದು</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ಹಬಕ್ಕೂಕನ ದೂರುಗಳು — 1:1-2:20</para>
  <para style="io1">2. ಹಬಕ್ಕೂಕನ ಪ್ರಾರ್ಥನೆ — 3:1-19</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="s">ಹಬಕ್ಕೂಕನ ದೂರು</para>
  <para style="q">
    <verse number="1" style="v" sid="HAB 1:1"/>ಪ್ರವಾದಿಯಾದ ಹಬಕ್ಕೂಕನಿಗೆ ಕಂಡುಬಂದ ದೈವೋಕ್ತಿ.<verse eid="HAB 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 1:2"/>ಯೆಹೋವನೇ, ನಾನು ಎಷ್ಟು ಕಾಲ ನಿನಗೆ ಸಹಾಯಕ್ಕಾಗಿ ಮೊರೆಯಿಡುತ್ತಿರಬೇಕು? ನೀನು ಎಷ್ಟು ಕಾಲ ಕೇಳದೇ ಇರುವಿ?</para>
  <para style="q" vid="HAB 1:2">ಹಿಂಸೆ, ಹಿಂಸೆ ಎಂದು ನಿನ್ನನ್ನು ಕೂಗಿಕೊಂಡರೂ ರಕ್ಷಿಸದೇ ಇರುವಿ.<verse eid="HAB 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 1:3"/>ಕೇಡನ್ನೇ ನನ್ನ ಕಣ್ಣಿಗೆ ಏಕೆ ಕಾಣಿಸುವಂತೆ ಮಾಡಿದ್ದಿ? ಕಷ್ಟವನ್ನೇಕೆ ಅನುಭವಿಸುವಂತೆ ಮಾಡಿರುವೆ?</para>
  <para style="q" vid="HAB 1:3">ಹಿಂಸೆಬಾಧೆಗಳು ನನ್ನ ಕಣ್ಣೆದುರಿಗೆ ಇದ್ದೇ ಇವೆ; ಜಗಳವಾಗುತ್ತಿದೆ ವ್ಯಾಜ್ಯವೇಳುತ್ತಿದೆ.<verse eid="HAB 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 1:4"/>ಹೀಗಿರಲು ಧರ್ಮೋಪದೇಶವು ಜಡವಾಗಿದೆ, ನ್ಯಾಯವು ಎಂದಿಗೂ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ;</para>
  <para style="q" vid="HAB 1:4">ದುಷ್ಟರು ಶಿಷ್ಟರನ್ನು ಆಕ್ರಮಿಸಿರುವುದರಿಂದ ದೊರೆಯುವ ನ್ಯಾಯವೂ ವಕ್ರವಾಗಿಯೇ ಇರುತ್ತದೆ.<verse eid="HAB 1:4"/></para>
  <para style="s">ದೇವರ ಉತ್ತರ</para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 1:5"/>ಜನಾಂಗಗಳ ಮಧ್ಯೆ ನಡೆಯುವುದನ್ನು ದೃಷ್ಟಿಸಿ ನೋಡಿ. ಅದರಿಂದ ನೀವು ಬೆರಗಾಗಿ ಹೋಗುವಿರಿ;</para>
  <para style="q" vid="HAB 1:5">ನಿಮ್ಮ ಕಾಲದಲ್ಲೇ ನಾನು ಒಂದು ಕಾರ್ಯವನ್ನು ಮಾಡುವೆನು. ನಾನು ಆ ಕಾರ್ಯದ ಬಗ್ಗೆ ನಿಮಗೆ ಎಷ್ಟು ತಿಳಿಹೇಳಿದರೂ ನೀವು ನಂಬುವುದಿಲ್ಲ.<verse eid="HAB 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 1:6"/>ಇಗೋ, ನಾನು ಶಕ್ತಿಶಾಲಿಗಳೂ, ತೀಕ್ಷ್ಣಬುದ್ಧಿಯುಳ್ಳವರೂ ಆಗಿರುವ ಕಸ್ದೀಯ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">ಕಸ್ದೀಯ </char><char style="ft" closed="false">ಅಥವಾ ಬಾಬೆಲ್.</char></note> ಜನಾಂಗದವರನ್ನು ನಿಮ್ಮ ವಿರುದ್ಧ ಹುರಿದುಂಬಿಸಿ ಎಬ್ಬಿಸುತ್ತೇನೆ;</para>
  <para style="q" vid="HAB 1:6">ಆ ಜನರು ಭಯಂಕರರೂ, ಉಗ್ರರೂ ಆಗಿ ತಮ್ಮದಲ್ಲದ ಸಂಸ್ಥಾನವನ್ನು ವಶಮಾಡಿಕೊಳ್ಳುವರು ಮತ್ತು ಲೋಕದಲ್ಲೆಲ್ಲಾ ಸಂಚರಿಸುವರು.<verse eid="HAB 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 1:7"/>ಅವರ ಅಧಿಕಾರವನ್ನೂ ತಮ್ಮದೇ ಆದ ನ್ಯಾಯ ನೀತಿಯನ್ನೂ ರೂಪಿಸಿಕೊಂಡು; ಅವರ ಸ್ವ ಸಾಮರ್ಥ್ಯ, ಸ್ವ ಗೌರವಕ್ಕೆ ಪ್ರಾಮುಖ್ಯತೆ ನೀಡುವರು.<verse eid="HAB 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 1:8"/>ಅವರ ಕುದುರೆಗಳು ಚಿರತೆಗಳಿಗಿಂತ ವೇಗವಾಗಿ ಓಡಬಲ್ಲವು, ಸಂಜೆಯ ತೋಳಗಳಿಗಿಂತ ಚುರುಕಾಗಿವೆ;</para>
  <para style="q" vid="HAB 1:8">ಅದರ ಸವಾರರು ರಭಸದಿಂದ ಹಾರಿಬರುವರು, ಬೇಟೆಯನ್ನು ಕಬಳಿಸಲು ಹಾರಿ ಬರುವ ರಣಹದ್ದಿನಂತೆ ದೂರದಿಂದ ಹಾರಿಬರುವರು.<verse eid="HAB 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 1:9"/>ಹಿಂಸೆ, ಬಾಧೆಯನ್ನು ಗುರಿಯಾಗಿಟ್ಟುಕೊಂಡೆ ಮುನ್ನುಗ್ಗಿ ಬರುವರು.</para>
  <para style="q" vid="HAB 1:9">ಜನರನ್ನು ಮರಳಿನಂತೆ ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಸೆರೆಹಿಡಿದು ಗುಂಪು ಕೂಡಿಸುವರು.<verse eid="HAB 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 1:10"/>ಅವರು ಅರಸರನ್ನು ಧಿಕ್ಕರಿಸಿ ಅಪಹಾಸ್ಯ ಮಾಡುವರು. ಸರದಾರರು ಅಧಿಪತಿಗಳು ಅವರ ಪರಿಹಾಸ್ಯಕ್ಕೆ ಗುರಿಯಾಗುವರು.</para>
  <para style="q" vid="HAB 1:10">ಒಂದೊಂದು ಕೋಟೆಯನ್ನೂ ಆಕ್ರಮಿಸಿ ಧೂಳಿಪಟ ಮಾಡುವರು.<verse eid="HAB 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 1:11"/>ಬಿರುಗಾಳಿಯಂತೆ ಬಂದು ಮಾಯವಾಗುವರು. ತಮ್ಮ ಸ್ವಂತ ಬಲವೇ ದೇವರು ಎಂದು ಭಾವಿಸಿ ಅಹಂಕಾರದಿಂದ ದೇವರನ್ನು ತಾತ್ಸಾರಮಾಡಿ ಅಪರಾಧಿಗಳಾಗಿ ದೈವಕೋಪಕ್ಕೆ ಗುರಿಯಾಗುವರು.<verse eid="HAB 1:11"/></para>
  <para style="s">ಪ್ರವಾದಿಯ ಮತ್ತೊಂದು ಆಕ್ಷೇಪಣೆ</para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 1:12"/>ನನ್ನ ದೇವರಾದ ಯೆಹೋವನೇ, ನನ್ನ ಸದಮಲಸ್ವಾಮಿಯೇ, ನೀನು ಅನಾದಿಯಿಂದಿದ್ದೀಯಲ್ಲಾ, ನಾವು ಖಂಡಿತ ಸಾಯುವುದಿಲ್ಲ.</para>
  <para style="q" vid="HAB 1:12">ಯೆಹೋವನೇ ನಮ್ಮ ನ್ಯಾಯತೀರ್ಪಿಗಾಗಿ ಅವರನ್ನು ನೇಮಿಸಿರುವೆ; ಶರಣನೇ, ನಮ್ಮನ್ನು ಶಿಕ್ಷಿಸುವುದಕ್ಕಾಗಿ ಅವರನ್ನು ನಮ್ಮ ಮುಂದೆ ನಿಲ್ಲಿಸಿರುವೆ.<verse eid="HAB 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 1:13"/>ನೀನು ಕೇಡನ್ನು ಬಯಸುವಂತಹ ದೇವರಲ್ಲ, ಪವಿತ್ರ ದೃಷ್ಟಿಯಿಂದ ನೋಡುವ ನಿನ್ನ ಕಣ್ಣಿನ ರಕ್ಷಣೆ ನಮ್ಮೊಂದಿಗಿದೆ.</para>
  <para style="q" vid="HAB 1:13">ಆದರೆ ನಮಗಾಗುತ್ತಿರುವ ಕೇಡನ್ನು ನೋಡಿಯೂ ಏಕೆ ಸುಮ್ಮನಿರುವೆ?</para>
  <para style="q" vid="HAB 1:13">ದುಷ್ಟರು ತಮಗಿಂತ ಯೋಗ್ಯನನ್ನು ಕಬಳಿಸುತ್ತಿರುವುದನ್ನು ನೋಡಿ ಏಕೆ ಸುಮ್ಮನಿರುವೇ?<verse eid="HAB 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 1:14"/>ಮನುಷ್ಯರನ್ನು ಸಮುದ್ರದ ಮೀನುಗಳ ಸ್ಥಿತಿಗೆ ಏಕೆ ತಂದಿದ್ದೀ, ಆಳುವವನಿಲ್ಲದ ಕ್ರಿಮಿಕೀಟಗಳ ಗತಿಗೆ ಏಕೆ ಬರಮಾಡಿದ್ದೀ?<verse eid="HAB 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 1:15"/>ನಲಿದಾಡುತ್ತಾ ಶತ್ರುಗಳು ನಮ್ಮನ್ನು ಗಾಳಗಳಿಂದ ಹಿಡಿದು ತಮ್ಮ ಬಲೆಗಳಲ್ಲಿ ರಾಶಿ ರಾಶಿಯಾಗಿ ಬಾಚಿಕೊಂಡು ಹೋಗಬೇಕೋ?<verse eid="HAB 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 1:16"/>ತಮ್ಮ ಬಲೆಗಳಿಗೆ ಆರಾಧನೆ ಮಾಡುತ್ತಾ ಬಲಿ ಕೊಡುತ್ತಾರೆ, ತಮ್ಮ ಜಾಲಗಳ ಎದುರು ಧೂಪಹಾಕುತ್ತಾರೆ;</para>
  <para style="q" vid="HAB 1:16">ಅವುಗಳ ಮೂಲಕವೇ ಅವರ ಭೋಜನವು ಪುಷ್ಟಿಯಾಯಿತು, ಅವರ ಆಹಾರವು ರುಚಿ ಎಂದು ಹೇಳುತ್ತಾರೆ.<verse eid="HAB 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 1:17"/>ಹೀಗಿರಲು, ತಮ್ಮ ಬಲೆಗೆ ಸಿಕ್ಕಿದ್ದನ್ನು ಅವರು ನಿತ್ಯವೂ ಸುರಿಯುತ್ತಿರಲೋ, ಜನಾಂಗಗಳನ್ನು ಕರುಣಿಸದೆ ಸದಾ ಸಂಹರಿಸುತ್ತಿರಬೇಕೋ?<verse eid="HAB 1:17"/></para>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="s">ದೇವರ ಉತ್ತರ</para>
  <para style="q">
    <verse number="1" style="v" sid="HAB 2:1"/>ನನ್ನ ಕೋವರದಲ್ಲಿ ನಿಂತುಕೊಳ್ಳುವೆನು. ಬುರುಜಿನ ಮೇಲೆ ನೆಲೆಯಾಗಿರುವೆನು.</para>
  <para style="q" vid="HAB 2:1">ಯೆಹೋವನು ನನಗೆ ಏನು ಹೇಳುವನೋ ನನ್ನ ಆಕ್ಷೇಪಣೆಯನ್ನು ನಿವಾರಿಸಿಕೊಳ್ಳಲು</para>
  <para style="q" vid="HAB 2:1">ಯಾವ ಉತ್ತರ ಕೊಡಬೇಕೋ ಎಂದು ಎದುರುನೋಡುವೆನು ಅಂದುಕೊಂಡನು.<verse eid="HAB 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 2:2"/>ಆಗ ಯೆಹೋವನು ನನಗೆ ಈ ಉತ್ತರವನ್ನು ದಯಪಾಲಿಸಿದನು,</para>
  <para style="q" vid="HAB 2:2">“ನಿನಗಾದ ದರ್ಶನವನ್ನು ಬರೆದಿಡು; ಓದುವವರು ಸುಲಭವಾಗಿ ಶೀಘ್ರವಾಗಿ ಓದಲು ಅನುಕೂಲವಾಗುವಂತೆ ಹಲಿಗೆಗಳ ಮೇಲೆ ಅದನ್ನು ಕೆತ್ತಿಡು!<verse eid="HAB 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 2:3"/>ಸೂಕ್ತ ಹಾಗು ನಿಯಮಿತ ಕಾಲದಲ್ಲಿ ಆ ದರ್ಶನದಲ್ಲಿ ಕಂಡದ್ದು ನೆರವೇರುವುದು, ಅದರ ಅಂತಿಮ ಪರಿಣಾಮ ಶೀಘ್ರದಲ್ಲೇ ಗೊತ್ತಾಗುವುದು.</para>
  <para style="q" vid="HAB 2:3">ತಡವಾದರೂ ಅದಕ್ಕೆ ಕಾದಿರು; ಅದು ಖಂಡಿತವಾಗಿ ಕೈಗೂಡುವುದು.<verse eid="HAB 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 2:4"/>ಇಗೋ, ದುಷ್ಟನ ಅಂತರಾತ್ಮವು ತನ್ನ ಕ್ರಿಯೆಗಳಿಂದ ಉಬ್ಬಿಹೋಗಿದೆ, ಆದರೆ, ನೀತಿವಂತನು ತನ್ನ ನಂಬಿಕೆಯಿಂದಲೇ ಬದುಕುವನು.<verse eid="HAB 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 2:5"/>ಅಲ್ಲದೆ ಮದ್ಯಪಾನವು<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="fq" closed="false">ಮದ್ಯಪಾನವು </char><char style="ft" closed="false">ದ್ರಾಕ್ಷಾರಸವು ಅಥವಾ ಐಶ್ವರ್ಯ.</char></note> ಮೋಸಕರವಾದ ಕಾರಣ ದುಷ್ಟನನ್ನು ಮದವೇರಿಸುವುದು,</para>
  <para style="q" vid="HAB 2:5">ಸ್ವಸ್ಥಳದಲ್ಲಿ ನಿಲ್ಲಲು ಬಿಡುವುದಿಲ್ಲ; ಪಾತಾಳದಷ್ಟು ಅತಿ ಆಶೆಗೆ ಪ್ರೆರೇಪಿಸಿ ಮೃತ್ಯುವಿನಂತೆ ಅತೃಪ್ತನಾಗಿ ಜೀವಿಸುವನು.</para>
  <para style="q" vid="HAB 2:5">ಯೆಹೋವನ ಒಡಂಬಡಿಕೆಯ ವಿರುದ್ಧ ಜೀವಿಸುವವರನ್ನು ತನ್ನ ಕಡೆಗೆ ಆಕರ್ಷಿಸುವನು.<verse eid="HAB 2:5"/></para>
  <para style="s">ಕಸ್ದೀಯರ ಅಪರಾಧಗಳ ಖಂಡನೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>“ಆದರೆ ಹೀಗೆ ಅವನ ದುರಾಶೆಯ ಪಾಶಕ್ಕೆ ಗುರಿಯಾದವರು ಅವನ ಬಗ್ಗೆ ತಿಳಿದು ಗೇಲಿ, ಅಪಹಾಸ್ಯದ ಲಾವಣಿ ಗೀತೆಗಳನ್ನು ರಚಿಸಿ ಹಾಡುವರು.</para>
  <para style="q" vid="HAB 2:6">‘ಅನ್ಯರ ವಸ್ತುಗಳನ್ನು ಅಡವಿಟ್ಟುಕೊಂಡು ಐಶ್ವರ್ಯ ಸಂಪಾದಿಸುವವನ ಗತಿಯನ್ನು ಏನೆಂದು ಹೇಳುವುದು, ಅವನು ಎಷ್ಟು ಕಾಲ ಹೀಗೆ ಮಾಡುವನು!’<verse eid="HAB 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 2:7"/>ನಿನ್ನ ಬಳಿ ಸಾಲಪಡೆದವರೇ ನಿನಗೆ ಎದುರಾಗಿ ನಿಲ್ಲುವರು, ನಿನಗೆ ಬಾಕಿ ಕೊಡಬೇಕಾದವರು ನಿನಗೆ ಬೆದರಿಕೆ ಹಾಕಿ ನಿನ್ನನ್ನು ಕೊಳ್ಳೆ ಹೊಡೆದು ಲೂಟಿಮಾಡುವರು.<verse eid="HAB 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 2:8"/>ನೀನು ಬಹು ಜನರನ್ನು ಕೊಳ್ಳೆಹೊಡೆದು, ಮನುಷ್ಯರ ರಕ್ತವನ್ನು ಸುರಿಸಿ ದೇಶವನ್ನೂ,</para>
  <para style="q" vid="HAB 2:8">ಪಟ್ಟಣವನ್ನೂ, ಅವುಗಳ ನಿವಾಸಿಗಳೆಲ್ಲರನ್ನೂ ಹಿಂಸಿಸಿರುವೆ. ಈ ಕಾರಣದಿಂದ, ಜನಾಂಗಗಳಲ್ಲಿ ಉಳಿದವರೆಲ್ಲರೂ ನಿನ್ನನ್ನು ಕೊಳ್ಳೆ ಹೊಡೆಯುವರು.<verse eid="HAB 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 2:9"/>‘ಕೇಡಿನಿಂದ, ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ತನ್ನ ಗೂಡನ್ನು ಎತ್ತರದಲ್ಲಿ ಕಟ್ಟಿ ತಪ್ಪಿಸಿಕೊಳ್ಳಬೇಕೆಂದು,</para>
  <para style="q2" vid="HAB 2:9">ತನ್ನ ಕುಟುಂಬಕ್ಕೆ ಆಸ್ತಿಯನ್ನು ಅನ್ಯಾಯವಾಗಿ ಮೋಸದಿಂದ ದೋಚಿಕೊಳ್ಳುವವನ ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ;<verse eid="HAB 2:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 2:10"/>ನೀನು ಬಹು ಜನರನ್ನು ನಿರ್ಮೂಲ ಮಾಡಿದ್ದು ನಿನ್ನ ಕುಂಟುಂಬಕ್ಕೆ ಅವಮಾನವನ್ನೇ ತಂದಂತಾಯಿತು, ನಿನಗೇ ನೀನೇ ಕೆಡುಕು ಮಾಡಿಕೊಂಡಿದ್ದೀ.<verse eid="HAB 2:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="HAB 2:11"/>ಗೋಡೆಯೊಳಗಿಂದ ಕಲ್ಲುಗಳು ನಿನ್ನ ಮೇಲೆ ತಪ್ಪುಹೊರಿಸಿ ಕೂಗುವವು; ಚಾವಣಿಯ ತೊಲೆಗಳು ಸಹ ಅದಕ್ಕೆ ಮಾರ್ದನಿ ಕೊಡುತ್ತವೆ.’<verse eid="HAB 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 2:12"/>‘ಅಯ್ಯೋ, ಪಟ್ಟಣವನ್ನು ನರಹತ್ಯದಿಂದ ಕಟ್ಟುವವನೂ, ಊರನ್ನು ಅನ್ಯಾಯದಿಂದ ಸ್ಥಾಪಿಸುವವರ ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ!<verse eid="HAB 2:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="HAB 2:13"/>ಜನರು ದುಡಿದದ್ದು ಬೆಂಕಿಗೆ ತುತ್ತಾಗುವುದು, ಈ ರೀತಿಯಾಗಿ ಜನರು ಪಟ್ಟ ಪರಿಶ್ರಮವು ವ್ಯರ್ಥವಾಗುವುದು ಎಂದು ಯೆಹೋವನು ನುಡಿದ್ದರಿಂದಲೇ ಅಲ್ಲವೇ; ಇದೆಲ್ಲ ಸೇನಾಧೀಶ್ವರನ ಚಿತ್ತವಷ್ಟೇ.<verse eid="HAB 2:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="HAB 2:14"/>ಸಮುದ್ರದಲ್ಲಿ ನೀರು ಹೇಗೋ ಹಾಗೆಯೇ ಭೂಮಿಯಲ್ಲಿ ಯೆಹೋವನ ಮಹಿಮೆಯ ಜ್ಞಾನವು ತುಂಬಿಕೊಂಡಿರುವುದು.’<verse eid="HAB 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 2:15"/>‘ನಿನ್ನ ರೋಷವನ್ನು ಪಾನಕಕ್ಕೆ ಬೆರಸಿ ನಿನ್ನ ನೆರೆಯವನಿಗೆ ಕುಡಿಸಿ,</para>
  <para style="q2" vid="HAB 2:15">ಅವನ ಬೆತ್ತಲೆತನವನ್ನು ನೋಡಬೇಕೆಂದು ಅವರನ್ನು ಅಮಲೇರಿಸಿದವನೇ, ನಿನ್ನ ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ!<verse eid="HAB 2:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="HAB 2:16"/>ನೀನು ಮಾನವಂತನಲ್ಲ, ನಿನಗೆ ಸನ್ಮಾನವಲ್ಲಾ ಅವಮಾನ ಕಟ್ಟಿಟ್ಟ ಬುತ್ತಿ. ನೀನು ಕುಡಿ ಕುಡಿದು ನಗ್ನನಾಗು,</para>
  <para style="q2" vid="HAB 2:16">ಯೆಹೋವನ ಬಲಗೈಯಲ್ಲಿರುವ ನಿನ್ನ ಪಾಪದ ಕೊಡ ತುಂಬಿ ಅವಮಾನವೇ ನಿನಗೆ ಸಲ್ಲುವುದು.<verse eid="HAB 2:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="HAB 2:17"/>ಲೆಬನೋನಿಗೆ ಆದಂಥ ಹಿಂಸೆಯ ಬಾರವು ನಿನ್ನನ್ನು ಕಾಡುವುದು, ಮೃಗಪಶುಗಳ ನಾಶನವು ನಿನ್ನನ್ನು ಹೆದರಿಸುವುದು;</para>
  <para style="q2" vid="HAB 2:17">ನೀನು ಮನುಷ್ಯರ ರಕ್ತವನ್ನು ಸುರಿಸಿ ದೇಶವನ್ನೂ, ಪಟ್ಟಣವನ್ನೂ, ಅವುಗಳ ನಿವಾಸಿಗಳೆಲ್ಲರನ್ನೂ ಹಿಂಸಿಸಿರುವೆ.</para>
  <para style="q2" vid="HAB 2:17">ಹಿಂಸಿಸಿದ ಕಾರಣ ಅದು ನಿನ್ನನ್ನು ಕಾಡುವುದು.<verse eid="HAB 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 2:18"/>ವಿಗ್ರಹ ಕೆತ್ತುವವನ ವಿಗ್ರಹವಾಗಲಿ ಅಥವಾ ಎರಕದಿಂದ ಮಾಡಿದ ಗೊಂಬೆಗಳಿಂದಾಗಲಿ ಲಾಭವೇನು? ಹಾಗೆ ದೇವರುಗಳನ್ನು ರೂಪಿಸುವವರು ಸುಳ್ಳನ್ನು ಬಿತ್ತುವವರು;</para>
  <para style="q" vid="HAB 2:18">ಏಕೆಂದರೆ, ಆ ನಿರ್ಜೀವ ವಿಗ್ರಹವನ್ನು ನಿರ್ಮಿಸಿದವನು ತನ್ನ ಕೈಕೆಲಸದ ಮೇಲೆಯೇ ಭರವಸೆ ಇಟ್ಟಿದ್ದಾನೆ.’<verse eid="HAB 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 2:19"/>‘ಮರದ ವಿಗ್ರಹಗಳಿಗೆ ಎಚ್ಚೆತ್ತುಕೋ,’ ಜಡವಾದ ಕಲ್ಲಿನ ವಿಗ್ರಹಗಳಿಗೆ, ‘ಎದ್ದೇಳು’ ಎಂದು ಅಪ್ಪಣೆಕೊಡುವವನು ಬುದ್ಧಿಹೀನನು. ಇಂಥ ಬೊಂಬೆಯು ಬೋಧಿಸೀತೇ?</para>
  <para style="q" vid="HAB 2:19">ಇಗೋ, ಆ ವಿಗ್ರಹಗಳಿಗೆ ಬೆಳ್ಳಿಬಂಗಾರವನ್ನು ಹೊದಿಸಿದ್ದಾರೆ ಆದರೂ ಅದರೊಳಗೆ ಜೀವವೇ ಇಲ್ಲ.<verse eid="HAB 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="HAB 2:20"/>ಆದರೆ, ಯೆಹೋವನು ತನ್ನ ಪರಿಶುದ್ಧ ಮಂದಿರದಲ್ಲಿದ್ದಾನೆ; ಭೂಲೋಕವೆಲ್ಲಾ ಆತನ ಮುಂದೆ ಮೌನವಾಗಿರಲಿ.”<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s">ಹಬಕ್ಕೂಕನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1"/>ಶಿಗ್ಯೋನೋತ್ ಸ್ವರದ ಮೇಲೆ ಪ್ರವಾದಿಯಾದ ಹಬಕ್ಕೂಕನ ಪ್ರಾರ್ಥನೆ.<verse eid="HAB 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2"/>ಯೆಹೋವನೇ, ನಾನು ನಿನ್ನ ಸುದ್ದಿಯನ್ನು ಕೇಳಿ ಹೆದರಿದ್ದೇನೆ;</para>
  <para style="q" vid="HAB 3:2">ಯೆಹೋವನೇ, ಯುಗದ ಮಧ್ಯದಲ್ಲಿ ನಿನ್ನ ರಕ್ಷಣಾಕಾರ್ಯವನ್ನು ಪುನಃ ಮಾಡು, ಯುಗದ ಮಧ್ಯದಲ್ಲಿ ಅದನ್ನು ಪ್ರಸಿದ್ಧಿಪಡಿಸು;</para>
  <para style="q" vid="HAB 3:2">ನೀನು ರೋಷಗೊಂಡಿದ್ದರೂ ಕರುಣೆಯನ್ನು ಚಿತ್ತಕ್ಕೆ ತಂದುಕೋ.<verse eid="HAB 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3"/>ತೇಮಾನಿನಿಂದ<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">ತೇಮಾನಿನಿಂದ </char><char style="ft" closed="false">ತೇಮಾನ್ ಎದೋಮ್ ದೇಶದ ಜಿಲ್ಲೆಯಾಗಿದ್ದು, ಯೆಹೂದದ ದಕ್ಷಿಣ ಭಾಗದ ಕಡೆಯಲ್ಲಿತ್ತು.</char></note> ಕರುಣಾಸಾಗರನಾದ ದೇವರು ಬರುತ್ತಿದ್ದಾನೆ, ಸದಮಲಸ್ವಾಮಿಯು ಪಾರಾನ್ ಪರ್ವತದಿಂದ<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">ಪಾರಾನ್ ಪರ್ವತದಿಂದ </char><char style="ft" closed="false">ಪಾರಾನ್ ಪರ್ವತವು ಬಂಜರು/ಬರಡು ಸ್ಥಳವಾಗಿತ್ತು, ಅದು ಸೀನಾಯಿ ಗಡಿಪ್ರದೇಶ/ಭೂಪ್ರದೇಶದಲ್ಲಿ ಇತ್ತು.</char></note> ಬರುತ್ತಾನೆ; <char style="qs">ಸೆಲಾ.</char></para>
  <para style="q" vid="HAB 3:3">ಆತನ ಪ್ರಭಾವವು ಆಕಾಶಮಂಡಲವನ್ನೆಲ್ಲಾ ಆವರಿಸಿಕೊಂಡಿದೆ,</para>
  <para style="q" vid="HAB 3:3">ಆತನ ಮಹಿಮೆಯು ಭೂಮಂಡಲವನ್ನು ತುಂಬುತ್ತಿದೆ;<verse eid="HAB 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4"/>ಆತನ ತೇಜಸ್ಸು ಸೂರ್ಯನಂತಿದೆ, ಆತನ ಕೈಗಳಿಂದ ಕಿರಣಗಳು ಹೊರಹೊಮ್ಮುತ್ತಿವೆ, ಆತನು ಶಕ್ತಿ ಸಾಮರ್ಥ್ಯಗಳ ನಿಧಿ.<verse eid="HAB 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5"/>ರೋಗಗಳು ಆತನಿಂದ ದೂರ ಓಡಿ ಹೋಗಿವೆ, ವ್ಯಾಧಿಯು ಆತನ ಹಿಂದೆ ಅಡಗಿಕೊಂಡಿದೆ.<verse eid="HAB 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6"/>ಆತನು ನಿಂತುಕೊಳ್ಳಲು ಭೂಮಿಯು ಅಳೆದನು.<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="fq" closed="false">ಅಳೆದನು. </char><char style="ft" closed="false">ಕಂಪಿಸುವಂತೆ ಮಾಡಿದನು ಅಥವಾ ಅಲುಗಾಡಿಸಿದನು.</char></note> ಆತನು ದೃಷ್ಟಿಸಲು ಜನಾಂಗಗಳು ಬೆದರುತ್ತವೆ;</para>
  <para style="q" vid="HAB 3:6">ಪುರಾತನ ಪರ್ವತಗಳು ಸೀಳಿಹೋಗುತ್ತವೆ; ಸನಾತನ ಗಿರಿಶಿಖರಗಳು ಕುಸಿದು ಬೀಳುತ್ತವೆ; ಆತನ ಆಗಮನವು ಅನಾದಿಯಿಂದ ಹೀಗೆಯೇ ಇರುವುದು.<verse eid="HAB 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7"/>ಇಗೋ, ಕೂಷಾನಿನ ಗುಡಾರಗಳು ತಳಮಳಗೊಂಡಿವೆ, ಮಿದ್ಯಾನ್ ದೇಶದ ಡೇರೆಗಳು ನಡುಗುತ್ತಿವೆ.<verse eid="HAB 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8"/>ಯೆಹೋವನೇ, ನಿನಗೆ ನದಿಗಳ ಮೇಲೆ ರೌದ್ರವೋ? ಹೊಳೆಗಳ ಮೇಲೆ ಸಿಟ್ಟುಗೊಂಡಿದ್ದಿಯಾ? ಸಮುದ್ರದ ಮೇಲೆ ಕೋಪವನ್ನು ಪ್ರದರ್ಶಿಸುತ್ತೀಯೋ?</para>
  <para style="q" vid="HAB 3:8">ಇಲ್ಲಾ, ನೀನು ಜಯರಥಗಳಲ್ಲಿ ಆಸೀನನಾಗಿ ಮೋಡಗಳ ಮೇಲೆ ರಕ್ಷಣೆಯನ್ನು ಕಳುಹಿಸಿದಾತನು!<verse eid="HAB 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9"/>ನಿನ್ನ ಬಿಲ್ಲು ಈಚೆಗೆ ತೆಗೆಯಲ್ಪಟ್ಟಿದೆ. ಆಹಾ, ನಿನ್ನ ತೋಳ್ಬಲದಿಂದ ಪ್ರಯೋಗಿಸಿದ ಬಾಣಗಳ ಬಲವು ಜೀವಬುಗ್ಗೆಯನ್ನು ಭೂಮಿಯೊಳಗಿನಿಂದ ಹರಿದು ಬರುವಂತೆ ಮಾಡಿತು. <char style="qs">ಸೆಲಾ.</char><verse eid="HAB 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10"/>ಬೆಟ್ಟಗಳು ನಿನ್ನನ್ನು ನೋಡಿ ತಳಮಳಗೊಳ್ಳುತ್ತಿವೆ;</para>
  <para style="q" vid="HAB 3:10">ಪ್ರವಾಹದೋಪಾದಿಯಲ್ಲಿ ಆಕಾಶವು ಮಳೆಗರೆಯುತ್ತಿದೆ;</para>
  <para style="q" vid="HAB 3:10">ಸಾಗರವು ಆರ್ಭಟಿಸಿ ಅಲೆಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="fq" closed="false">ಅಲೆಗಳನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಕೈಗಳನ್ನು.</char></note> ಮೇಲಕ್ಕೆ ಎತ್ತುತ್ತದೆ.<verse eid="HAB 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11"/>ಹಾರಿ ಬರುವ ನಿನ್ನ ಬಾಣಗಳ ಬೆಳಕಿಗೆ,</para>
  <para style="q" vid="HAB 3:11">ಮಿಂಚುವ ನಿನ್ನ ಈಟಿಯ ಹೊಳಪಿಗೆ, ಸೂರ್ಯಚಂದ್ರರು ಹೆದರಿ ತಮ್ಮ ಗೂಡಿನಲ್ಲಿ ಅಡಗಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="HAB 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12"/>ನೀನು ಕೋಪ ತಿರಸ್ಕಾರದಿಂದ ಲೋಕವನ್ನು ತುಳಿದುಕೊಂಡು ಹೋಗುತ್ತೀ. ಕೋಪದಿಂದ ಜನಾಂಗಗಳನ್ನು ಇಲ್ಲದಂತೆ ಮಾಡುತ್ತಿ.<verse eid="HAB 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13"/>ನಿನ್ನ ಅಭಿಷಿಕ್ತನಿಗಾಗಿಯೂ ಮತ್ತು ನಿನ್ನ ಪ್ರಜೆಯ ರಕ್ಷಣೆಗಾಗಿಯೂ ನೀನು ಯಾವಾಗಲೂ ಮುಂದಾಗಿರುತ್ತಿ;</para>
  <para style="q" vid="HAB 3:13">ದುಷ್ಟರ ಮನೆಯ ಮುಖ್ಯಸ್ಥರನ್ನು ಸದೆಬಡೆದು ಅವರ ಕುಟುಂಬಗಳನ್ನು ಬುಡಸಮೇತವಾಗಿ ಜನರ ಮುಂದೆ ಬೆತ್ತಲೆಯಾಗಿ ಮಾಡುವಿ. <char style="qs">ಸೆಲಾ.</char><verse eid="HAB 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14"/>ದಿಕ್ಕಿಲ್ಲದವರನ್ನು ಮರೆಯಲ್ಲಿ ನುಂಗಲು ಹೆಚ್ಚಳಪಡುವವರಾಗಿ ನನ್ನನ್ನು ಚದುರಿಸಬೇಕೆಂದು</para>
  <para style="q" vid="HAB 3:14">ನನ್ನ ಮೇಲೆ ಬಿರುಗಾಳಿಯಂತೆ ನುಗ್ಗಿದ ಅವನ ಭಟರ ತಲೆಯನ್ನು<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">ತಲೆಯನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಸೇನಾಧಿಪತಿಯನ್ನು.</char></note> ಅವನ ದೊಣ್ಣೆಗಳಿಂದಲೇ ಒಡೆದಿದ್ದೀ<verse eid="HAB 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15"/>ನಿನ್ನ ಅಶ್ವಗಳನ್ನು ಏರಿದವನಾಗಿ ಸಮುದ್ರವನ್ನು ತುಳಿಯುತ್ತಾ, ಮಹಾಜಲರಾಶಿಗಳನ್ನು ಹಾದುಹೋಗಿದ್ದೀ.<verse eid="HAB 3:15"/></para>
  <para style="s">ಪ್ರವಾದಿಯ ಭಯವೂ ಭರವಸವೂ</para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16"/>ಅದು ನನಗೆ ಕೇಳಿಸಲು ನನ್ನ ಒಡಲು ನಡುಗಿತು, ಆ ಶಬ್ದಕ್ಕೆ ನನ್ನ ತುಟಿಗಳು ಅದರಿದವು. ಕ್ಷಯವು ನನ್ನ ಎಲುಬುಗಳಲ್ಲಿ ಸೇರಿತು. ನಾನು ನಿಂತ ಹಾಗೆಯೇ ನಡುಗಿದೆನು.</para>
  <para style="q" vid="HAB 3:16">ವಿಪತ್ಕಾಲವು ನಮ್ಮನ್ನು ಹಿಂಸಿಸುವ ಜನರನ್ನು ಎದುರಾಯಿಸಿ ಅವರ ಮೇಲೆ ಬೀಳುವವರೆಗೂ ನಾನು ಅದಕ್ಕಾಗಿ ತಾಳ್ಮೆಯಿಂದ ಎದುರುನೋಡುವೆನು.<verse eid="HAB 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 3:17"/>ಆಹಾ, ಅಂಜೂರವು ಚಿಗುರದಿದ್ದರೂ, ದ್ರಾಕ್ಷಾಲತೆಗಳಲ್ಲಿ ಹಣ್ಣು ಸಿಕ್ಕದಿದ್ದರೂ,</para>
  <para style="q" vid="HAB 3:17">ಎಣ್ಣೆ ಮರಗಳ ಉತ್ಪತ್ತಿಯು ಶೂನ್ಯವಾದರೂ, ಹೊಲಗದ್ದೆಗಳು ಆಹಾರ ಧಾನ್ಯಗಳನ್ನು ಉತ್ಪತ್ತಿಮಾಡದಿದ್ದರೂ,</para>
  <para style="q2" vid="HAB 3:17">ಕುರಿಹಟ್ಟಿಗಳು ಬರಿದಾಗಿ ಹೋದರೂ, ಕೊಟ್ಟಿಗೆಗಳಲ್ಲಿ ದನಕರುಗಳು ಇಲ್ಲವಾದರೂ,<verse eid="HAB 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 3:18"/>ನಾನು ಯೆಹೋವನಲ್ಲಿ ಉಲ್ಲಾಸಿಸುವೆನು, ನನ್ನ ರಕ್ಷಕನಾದ ದೇವರಲ್ಲಿ ಆನಂದಿಸುವೆನು.<verse eid="HAB 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19"/>ನನ್ನ ಕರ್ತನಾದ ಯೆಹೋವನೇ ನನ್ನ ಬಲ; ಆತನು ನನ್ನ ಕಾಲನ್ನು ಜಿಂಕೆಯಂತೆ ಚುರುಕುಗೊಳಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="HAB 3:19">ನಾನು ಬೆಟ್ಟ ಗುಡ್ಡಗಳಲ್ಲಿ ಓಡಾಡುವಂತೆ ಮಾಡುತ್ತಾನೆ.</para>
  <para style="p" vid="HAB 3:19">ಪ್ರಧಾನ ಗಾಯಕನ ಕೀರ್ತನಸಂಗ್ರಹದಿಂದ ತೆಗೆದದ್ದು;</para>
  <para style="q3" vid="HAB 3:19">ನನ್ನ ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು.<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
