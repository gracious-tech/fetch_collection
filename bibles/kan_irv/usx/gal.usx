<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright © 2017 Bridge Connectivity Solutions. This translation is made available to you under the terms of the Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">ಗಲಾತ್ಯದವರಿಗೆ</para>
  <para style="toc1">ಗಲಾತ್ಯದವರಿಗೆ</para>
  <para style="toc2">ಗಲಾ</para>
  <para style="toc3">ಗಲಾ</para>
  <para style="mt">ಗಲಾತ್ಯದವರಿಗೆ</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಅಪೊಸ್ತಲನಾದ ಪೌಲನು ಈ ಪತ್ರಿಕೆಯ ಗ್ರಂಥಕರ್ತನಾಗಿದ್ದಾನೆ, ಇದು ಆದಿ ಸಭೆಯ ಒಮ್ಮತದ ಅಭಿಮತವಾಗಿದೆ. ಪೌಲನು ಆಸ್ಯ ಸೀಮೆಗೆ ಹೋದ ತನ್ನ ಮೊದಲನೆಯ ಮಿಷನರಿ ಪ್ರಯಾಣದಲ್ಲಿ ಅವರಲ್ಲಿ ಸಭೆಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿದ ನಂತರ ದಕ್ಷಿಣ ಗಲಾತ್ಯ ಸಭೆಗಳಿಗೆ ಇದನ್ನು ಬರೆದನು. ಗಲಾತ್ಯವು ರೋಮಾಪುರ ಅಥವಾ ಕೊರಿಂಥದಂತೆ ಒಂದು ಪಟ್ಟಣವಲ್ಲ, ಆದರೆ ಅನೇಕ ಪಟ್ಟಣಗಳು ಮತ್ತು ಹಲವಾರು ಸಭೆಗಳು ಇರುವ ರೋಮನ್ ಪ್ರಾಂತ್ಯವಾಗಿದೆ. ಪತ್ರಿಕೆಯಲ್ಲಿ ಗಲಾತ್ಯದವರು ಎಂದು ಸಂಬೋಧಿಸಿ ಹೇಳಿರುವಂಥವರು ಪೌಲನಿಂದ ರಕ್ಷಣೆಗೆ ಬಂದಂಥವರಾಗಿದ್ದಾರೆ.</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿ.ಶ. 48 ರಲ್ಲಿ ಬರೆಯಲ್ಪಟ್ಟಿದೆ.</para>
  <para style="ip">ಬಹುಶಃ ಪೌಲನು ಅಂತಿಯೋಕ್ಯದಿಂದ ಗಲಾತ್ಯದವರಿಗೆ ಈ ಪತ್ರಿಕೆಯನ್ನು ಬರೆದಿರಬಹುದು, ಏಕೆಂದರೆ ಇದು ಅವನ ನೆಲೆಬೀಡಾಗಿತ್ತು.</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಗಲಾತ್ಯದವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆಯನ್ನು ಗಲಾತ್ಯದಲ್ಲಿರುವ ಸಭೆಗಳ ಸದಸ್ಯರಿಗೆ ಬರೆಯಲಾಗಿತ್ತು (ಗಲಾ. 1:1-2).</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ಯೆಹೂದ್ಯರ ಸುಳ್ಳು ಸುವಾರ್ತೆಯನ್ನು ಅಂದರೆ ಯೆಹೂದ್ಯ ಕ್ರೈಸ್ತರು ರಕ್ಷಣೆಗಾಗಿ ಸುನ್ನತಿಯು ಅಗತ್ಯವಿದೆ ಎಂದು ಹೇಳುತ್ತಿದ್ದ ಸುವಾರ್ತೆಯನ್ನು ಖಂಡಿಸುವುದು ಮತ್ತು ಅವರ ರಕ್ಷಣೆಗೆ ಬೇಕಾದ ನಿಜವಾದ ಆಧಾರವನ್ನು ಗಲಾತ್ಯದವರಿಗೆ ನೆನಪಿಸುವುದು ಈ ಪತ್ರಿಕೆಯ ಉದ್ದೇಶವಾಗಿತ್ತು. ಪೌಲನು ತನ್ನ ಅಪೊಸ್ತಲ ಅಧಿಕಾರವನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ಸ್ಥಾಪಿಸಿ ಪ್ರತಿಕ್ರಿಯಿಸಿದನು ಮತ್ತು ಅದರಿಂದ ಅವನು ಸಾರಿದ ಸುವಾರ್ತೆಯನ್ನು ಪುಷ್ಟೀಕರಿಸಿದನು. ನಂಬಿಕೆಯ ಮೂಲಕ ಕೃಪೆಯಿಂದ ಮಾತ್ರವೇ ಜನರು ನೀತಿಕರಿಸಲ್ಪಟ್ಟಿದ್ದಾರೆ ಮತ್ತು ಅವರು ತಮ್ಮ ಹೊಸ ಜೀವನವನ್ನು ಆತ್ಮನ ಸ್ವಾತಂತ್ರ್ಯದಲ್ಲಿ ನಂಬಿಕೆಯಿಂದ ಮಾತ್ರವೇ ಜೀವಿಸಬೇಕು.</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ಕ್ರಿಸ್ತನಲ್ಲಿರುವ ಸ್ವಾತಂತ್ರ್ಯ</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ಪೀಠಿಕೆ — 1:1-10</para>
  <para style="io1">2. ಸುವಾರ್ತೆಯ ದೃಢೀಕರಣ — 1:11-2:21</para>
  <para style="io1">3. ನಂಬಿಕೆಯಿಂದ ನೀತಿಕರಣ — 3:1-4:31</para>
  <para style="io1">4. ನಂಬಿಕೆಯ ಮತ್ತು ಸ್ವಾತಂತ್ರ್ಯ ಜೀವನದ ಅಭ್ಯಾಸ — 5:1-6:18</para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="s">ವಂದನೆಯೂ ದೇವರ ಸ್ತೋತ್ರವೂ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:1 </char>
      <char style="ft" closed="false">ಗಲಾ. 1:11,12</char>
    </note>ಮನುಷ್ಯರಿಂದಾಗಲಿ ಮನುಷ್ಯರ ಮುಖಾಂತರದಿಂದಾಗಲಿ ಅಪೊಸ್ತಲನಾಗಿರದೆ <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">ಅ. ಕೃ. 9:6; 20:24; 22:10,15,21; 26:16; 1 ತಿಮೊ. 1:1</char></note>ಯೇಸು ಕ್ರಿಸ್ತನ ಮುಖಾಂತರವೂ ಮತ್ತು <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">ಅ. ಕೃ. 2:24</char></note>ಆತನನ್ನು ಸತ್ತವರೊಳಗಿಂದ ಎಬ್ಬಿಸಿದ ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ಅಪೊಸ್ತಲೋದ್ಯೋಗವನ್ನು ಹೊಂದಿದ ಪೌಲನೆಂಬ ನಾನು ಹಾಗೂ <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>ನನ್ನ ಜೊತೆಯಲ್ಲಿರುವ ಎಲ್ಲಾ ಸಹೋದರರೂ <note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">ಅ. ಕೃ. 14:21; 16:6; 1 ಕೊರಿ 16:1</char></note>ಗಲಾತ್ಯದಲ್ಲಿರುವ ಸಭೆಗಳಿಗೆ ಬರೆಯುವುದೇನೆಂದರೆ, <verse eid="GAL 1:2"/><verse number="3" style="v" sid="GAL 1:3"/><note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">1 ತಿಮೊ. 1:2</char></note>ತಂದೆಯಾದ ದೇವರಿಂದಲೂ ನಮ್ಮ ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನಿಂದಲೂ <note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">ರೋಮಾ. 1:7; ಕೊರಿ 1:3</char></note>ನಿಮಗೆ ಕೃಪೆಯೂ ಶಾಂತಿಯೂ ಆಗಲಿ.<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>ಆತನು ನಮ್ಮನ್ನು <note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ಎಫೆ 2:2; 1 ಯೋಹಾ 5:19</char></note>ಈಗಿನ ದುಷ್ಟ ಯುಗದಿಂದ ಬಿಡಿಸಬೇಕೆಂದು ನಮ್ಮ ತಂದೆಯಾದ ದೇವರ ಚಿತ್ತಕ್ಕನುಸಾರವಾಗಿ, <note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ಮತ್ತಾ 20:28; ರೋಮಾ. 4:25; 1 ಕೊರಿ 15:3</char></note>ನಮ್ಮ ಪಾಪಗಳ ದೆಸೆಯಿಂದ ತನ್ನನ್ನು ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟನು. <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ದೇವರಿಗೆ ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಮಹಿಮೆಯಾಗಲಿ. ಆಮೆನ್.<verse eid="GAL 1:5"/></para>
  <para style="s">ಏಕೈಕ ಸುವಾರ್ತೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ಕ್ರಿಸ್ತನ ಕೃಪೆಯಿಂದ ನಿಮ್ಮನ್ನು ಕರೆದಾತನನ್ನು ಬಿಟ್ಟು, ಇಷ್ಟು ಬೇಗನೆ <note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">2 ಕೊರಿ 11:4; 1 ತಿಮೊ. 1:3</char></note>ಬೇರೆ ಸುವಾರ್ತೆಯ ಕಡೆಗೆ ನೀವು ತಿರುಗಿದಿರೆಂದು ನಾನು ಆಶ್ಚರ್ಯಪಡುತ್ತೇನೆ. <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/><note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">ಅ. ಕೃ. 4:12; 1 ಕೊರಿ 3:11</char></note>ವಾಸ್ತವವಾಗಿ ಬೇರೊಂದು ಸುವಾರ್ತೆ ಇಲ್ಲ, ಆದರೆ ಕೆಲವರು <note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">ಗಲಾ. 5:10</char></note>ನಿಮ್ಮಲ್ಲಿ ಬೇಧವನ್ನು ಹುಟ್ಟಿಸುತ್ತಾ ಕ್ರಿಸ್ತನ ಸುವಾರ್ತೆಯನ್ನು ಮಾರ್ಪಡಿಸುವುದಕ್ಕೆ ಪ್ರಯತ್ನಿಸುತ್ತಿದ್ದಾರೆ. <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>ಆದರೂ ನಾವು ನಿಮಗೆ ಸಾರಿದ ಸುವಾರ್ತೆಗೆ ವಿರುದ್ಧವಾದದ್ದನ್ನು, ನಾವೇ ಆಗಲಿ ಅಥವಾ <note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">2 ಕೊರಿ 11:14</char></note>ಪರಲೋಕದಿಂದ ಬಂದ ದೇವದೂತನೇ ಆಗಲಿ, ನಿಮಗೆ ಸಾರಿದರೆ ಅವನು <note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">ರೋಮಾ. 9:3</char></note>ಶಾಪಗ್ರಸ್ತನಾಗಲಿ. <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>ನಾವು ಮೊದಲು ಹೇಳಿದಂತೆಯೇ ಈಗಲೂ ನಾನು ತಿರುಗಿ ಹೇಳುತ್ತೇನೆ. ನೀವು ಸ್ವೀಕರಿಸಿದ ಸುವಾರ್ತೆಗೆ ವಿರುದ್ಧವಾದದ್ದನ್ನು ಯಾವನಾದರೂ ನಿಮಗೆ ಸಾರಿದರೆ <note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">ರೋಮಾ. 9:3 </char></note>ಅವನು ಶಾಪಗ್ರಸ್ತನಾಗುವನು.<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>ನಾನೀಗ ಯಾರನ್ನು ಒಲಿಸಿಕೊಳ್ಳುತ್ತಾ ಇದ್ದೇನೆ? <note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">1 ಥೆಸ. 2:4</char></note>ಮನುಷ್ಯರನ್ನೋ? ದೇವರನ್ನೋ? ನಾನು ಮನುಷ್ಯರನ್ನು ಮೆಚ್ಚಿಸುವುದಕ್ಕೆ ಪ್ರಯತ್ನಿಸುತ್ತಾ ಇದ್ದೇನೋ? ಇನ್ನೂ ಮನುಷ್ಯರನ್ನು ಮೆಚ್ಚಿಸುವವನಾಗಿದ್ದರೆ ನಾನು ಕ್ರಿಸ್ತನ ಸೇವಕನಲ್ಲ.<verse eid="GAL 1:10"/></para>
  <para style="s">ಪೌಲನು ಅಪೊಸ್ತಲನಾದ್ದದು ಹೇಗೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>ಸಹೋದರರೇ, <note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">1 ಕೊರಿ 15:1-3</char></note>ನಾನು ಸಾರಿದ ಸುವಾರ್ತೆಯಂತೂ ಕೇವಲ ಮನುಷ್ಯನಿಂದ ಬಂದದ್ದಲ್ಲವೆಂದು ನೀವು ತಿಳಿದುಕೊಳ್ಳಬೇಕೆಂದು ನಾನು ಬಯಸುತ್ತೇನೆ. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/><note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">ಗಲಾ. 1:1; 1 ಕೊರಿ 11:3; 15:3</char></note>ನಾನು ಅದನ್ನು ಮನುಷ್ಯನಿಂದ ಹೊಂದಲಿಲ್ಲ, ನನಗೆ ಯಾರೂ ಉಪದೇಶಿಸಲಿಲ್ಲ, ಬದಲಾಗಿ <note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">ಗಲಾ. 1:16; 1 ಕೊರಿ 2:10; 2 ಕೊರಿ 12:1</char></note>ಯೇಸು ಕ್ರಿಸ್ತನೇ ಅದನ್ನು ನನಗೆ ಪ್ರಕಟಪಡಿಸಿದನು. <verse eid="GAL 1:12"/><verse number="13" style="v" sid="GAL 1:13"/>ಹಿಂದೆ ನಾನು ಯೆಹೂದ್ಯ ಮತದಲ್ಲಿದ್ದಾಗ <note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">ಅ. ಕೃ. 26:4</char></note>ನನ್ನ ನಡತೆ ಎಂಥದ್ದೆಂದು ನೀವು ಕೇಳಿದ್ದೀರಿ. <note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">ಅ. ಕೃ. 8:3</char></note>ನಾನು ದೇವರ ಸಭೆಯನ್ನು ಬಹಳವಾಗಿ ಹಿಂಸೆಪಡಿಸಿ ಹಾಳುಮಾಡುತ್ತಿದ್ದೆನು. <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>ಇದಲ್ಲದೆ ನಾನು ನನ್ನ ಪೂರ್ವಿಕರಿಂದ ಬಂದ ಸಂಪ್ರದಾಯಗಳ ಬಗ್ಗೆ ಬಹು ಅಭಿಮಾನವುಳ್ಳವನಾಗಿ, ನನ್ನ ಜನರೊಳಗೆ ಸಮಪ್ರಾಯದವರಾದ <note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">ಫಿಲಿ. 3:6</char></note>ಅನೇಕರಿಗಿಂತ ಯೆಹೂದ್ಯ ಮತಾಚಾರದಲ್ಲಿ ಆಸಕ್ತನಾಗಿದ್ದೆನು.<verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">ಯೆಶಾ 49:1,; ಯೆರೆ 1:5</char></note>ನಾನು ನನ್ನ ತಾಯಿಯ ಗರ್ಭದಲ್ಲಿದ್ದಾಗಲೇ <note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">ಅ. ಕೃ. 13:2; ಮಾರ್ಕ 6:3; ರೋಮಾ. 1:1</char></note>ನನ್ನನ್ನು ಪ್ರತ್ಯೇಕಿಸಿ, ತನ್ನ ಕೃಪೆಯಿಂದ ಕರೆದ ದೇವರು, <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>ತನ್ನ ಮಗನನ್ನು ನನ್ನೊಳಗೆ ಪ್ರಕಟಪಡಿಸುವುದಕ್ಕೆ ಮತ್ತು <note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">ಗಲಾ. 2:9; ಅ. ಕೃ. 9:15</char></note>ಅನ್ಯಜನರಲ್ಲಿ ಆತನನ್ನು ನಾನು ಪ್ರಸಿದ್ಧಿಪಡಿಸುವವನಾಗಬೇಕೆಂದು ಇಚ್ಛಿಸಿದನು. ನಾನು ಕೂಡಲೇ ಮನುಷ್ಯರ ಆಲೋಚನೆಯನ್ನು ಕೇಳದೆ, <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ಯೆರೂಸಲೇಮಿಗೆ ನನಗಿಂತ ಮೊದಲು ಅಪೊಸ್ತಲರಾಗಿದ್ದವರ ಬಳಿಗೂ ಹೋಗದೆ ಅರಬಸ್ಥಾನಕ್ಕೆ ಹೋಗಿ ತಿರುಗಿ ದಮಸ್ಕಕ್ಕೆ ಬಂದೆನು.<verse eid="GAL 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:18 </char>
      <char style="ft" closed="false">ಅ. ಕೃ. 9:22-27; 22:17</char>
    </note>ಮೂರು ವರ್ಷಗಳ ತರುವಾಯ ಕೇಫನ ಪರಿಚಯವನ್ನು ಮಾಡಿಕೊಳ್ಳಬೇಕೆಂದು ಯೆರೂಸಲೇಮಿಗೆ ಹೋಗಿ ಅವನ ಬಳಿಯಲ್ಲಿ ಹದಿನೈದು ದಿನಗಳು ಇದ್ದೆನು. <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">ಮತ್ತಾ 12:46; ಮಾರ್ಕ 6:3; ಅ. ಕೃ. 12:17</char></note>ಕರ್ತನ ಸಹೋದರನಾದ ಯಾಕೋಬನಲ್ಲದೆ ಅಪೊಸ್ತಲರಲ್ಲಿ ಬೇರೆ ಯಾರನ್ನೂ ನಾನು ಕಾಣಲಿಲ್ಲ. <verse eid="GAL 1:19"/><verse number="20" style="v" sid="GAL 1:20"/>ನಾನು ನಿಮಗೆ ಬರೆಯುವ ಸಂಗತಿಗಳು ಸುಳ್ಳಲ್ಲವೆಂಬುದಕ್ಕೆ ಇಗೋ, ದೇವರೇ ಸಾಕ್ಷೀ.<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:21 </char>
      <char style="ft" closed="false">ಅ. ಕೃ. 9:30; 11:25, 26; 13:1</char>
    </note>ಆ ಮೇಲೆ ಸಿರಿಯ ಮತ್ತು ಕಿಲಿಕ್ಯ ಪ್ರಾಂತ್ಯಗಳಿಗೆ ಹೋದೆನು. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ಆದರೆ ಕ್ರಿಸ್ತನಲ್ಲಿರುವ <note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">1 ಥೆಸ. 2:14</char></note>ಯೂದಾಯದ ಸಭೆಗಳಿಗೆ ನನ್ನ ಪರಿಚಯವಿರಲಿಲ್ಲ. <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>“ಪೂರ್ವದಲ್ಲಿ ನಮ್ಮನ್ನು ಹಿಂಸೆಪಡಿಸಿದವನು, ತಾನು ಹಾಳು ಮಾಡುತ್ತಿದ್ದ ನಂಬಿಕೆಯನ್ನು ಈಗ ಸಾರುತ್ತಿದ್ದಾನೆ” ಎಂಬ ಸುದ್ದಿಯನ್ನು ಅವರು ಕೇಳಿ, <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ನನ್ನ ಕುರಿತಾಗಿ ದೇವರನ್ನು ಕೊಂಡಾಡಿದರು.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">ಪೌಲನನ್ನು ಇತರ ಅಪೊಸ್ತಲರು ಅಂಗೀಕರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:1 </char>
      <char style="ft" closed="false">ಅ. ಕೃ. 15:2</char>
    </note>ಹದಿನಾಲ್ಕು ವರ್ಷಗಳ ನಂತರ ನಾನು ಬಾರ್ನಬನ ಜೊತೆಯಲ್ಲಿ ತೀತನನ್ನು ಸಹ ಕರೆದುಕೊಂಡು, ಮತ್ತೊಮ್ಮೆ ಯೆರೂಸಲೇಮಿಗೆ ಹೋದೆನು. <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>ದೈವಪ್ರೇರಣೆಗೆ ಅನುಸಾರವಾಗಿ ಹೋಗಿ, <note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">1 ತಿಮೊ. 3:16</char></note>ಅನ್ಯಜನರಲ್ಲಿ ನಾನು ಸಾರುವ ಸುವಾರ್ತೆಯು ಏನೆಂಬುದನ್ನು ಅಲ್ಲಿದ್ದ <note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">ಗಲಾ. 2:6-9</char></note>ಗಣ್ಯರಿಗೆ ಪ್ರತ್ಯೇಕವಾಗಿ ತಿಳಿಸಿದೆನು. ಏಕೆಂದರೆ ನಾನು <note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">ಮೂಲ: ಓಡುತ್ತಿರುವುದು ಅಥವಾ ಓಡಿದ್ದು. </char></note>ಸುವಾರ್ತೆಗಾಗಿ ಪಟ್ಟ ಶ್ರಮವಾಗಲಿ, ಈಗ ಪಡುತ್ತಿರುವ ಶ್ರಮವಾಗಲಿ ನಿಷ್ಫಲವಾಗಬಾರದೆಂದು ತಿಳಿಸಿದೆನು. <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>ನನ್ನ ಜೊತೆಯಲ್ಲಿದ್ದ ತೀತನು ಗ್ರೀಕನಾಗಿದ್ದರೂ <note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">ಅ. ಕೃ. 16:3 ಹೋಲಿಸಿ</char></note>ಅವನಿಗೆ ಸುನ್ನತಿಯಾಗಬೇಕೆಂದು ಯಾರೂ ಒತ್ತಾಯಮಾಡಲಿಲ್ಲ. <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/><note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">ಅ. ಕೃ. 15:24, 2 ಕೊರಿ 11:26</char></note>ಆದರೆ ರಹಸ್ಯವಾಗಿ ಒಳಗೆ ಬಂದಿದ್ದ ಸುಳ್ಳು ಸಹೋದರರು ನಮ್ಮನ್ನು ಧರ್ಮಶಾಸ್ತ್ರದ <note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">ಗಲಾ. 4:3,9; 9:24-25, 2 ಕೊರಿ 11:20, ರೋಮಾ. 8:15</char></note>ದಾಸತ್ವದಲ್ಲಿ ಸಿಕ್ಕಿಸಬೇಕೆಂದು, ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವ <note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">ಗಲಾ. 5:1</char></note>ನಮ್ಮ ಸ್ವಾತಂತ್ರ್ಯವನ್ನು ಗೂಢವಾಗಿ ವಿಚಾರಿಸಲು ಬಂದಿದ್ದರು. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>ಸುವಾರ್ತೆಯ ಸತ್ಯಾರ್ಥವು ನಿಮ್ಮಲ್ಲಿ ಸ್ಥಿರವಾಗಿರಬೇಕೆಂದು ನಾವು ಅವರ ಅಧೀನಕ್ಕೆ ಒಂದು ಗಳಿಗೆಯೂ ಒಳಪಡಲಿಲ್ಲ.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">ವ. 29 ನೋಡಿರಿ</char></note>ಗಣ್ಯವ್ಯಕ್ತಿಗಳಾಗಿದ್ದವರಿಂದ ನನಗೇನೂ ದೊರೆಯಲಿಲ್ಲ. ಅವರು ಹಿಂದಿನ ಕಾಲದಲ್ಲಿ ಎಂಥವರಾಗಿದ್ದರೋ ನನಗೆ ಲಕ್ಷ್ಯವಿಲ್ಲ. <note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">ಧರ್ಮೋ 10:17, ರೋಮಾ. 2:11</char></note>ದೇವರಿಗೆ ಮನುಷ್ಯರನ್ನು ಮೆಚ್ಚಿಸಬೇಕಾಗಿಲ್ಲ. ಗಣ್ಯವ್ಯಕ್ತಿಗಳೆಂದು ಎನಿಸಿಕೊಂಡವರು <note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">2 ಕೊರಿ 11:5, 12:11</char></note>ನನಗೇನನ್ನೂ ತಿಳಿಸಿಕೊಡಲಿಲ್ಲ. <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>ಆದರೆ ಸುನ್ನತಿಯಾದವರಿಗೆ ಸುವಾರ್ತೆಯನ್ನು ಸಾರುವ ಕೆಲಸವು ಹೇಗೆ ಪೇತ್ರನಿಗೆ ಕೊಡಲ್ಪಟ್ಟಿತೋ, <note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">ಗಲಾ. 1:16, ಅ. ಕೃ. 9:15, ಥೆಸ. 2:4, 1 ತಿಮೊ. 1:11</char></note>ಹಾಗೆಯೇ ಅನ್ಯಜನರಿಗೆ ಅದನ್ನು ಸಾರುವ ಕಾರ್ಯವನ್ನು ನನಗೆ ಕೊಡಲ್ಪಟ್ಟಿತು. <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>ಸುನ್ನತಿಯಾದವರಲ್ಲಿ ಅಪೊಸ್ತಲತನವನ್ನು ನಡೆಸುವುದಕ್ಕೋಸ್ಕರ ಪೇತ್ರನಿಗೆ ವಹಿಸಿಕೊಟ್ಟಂಥ ದೇವರು, ಸುನ್ನತಿಯಿಲ್ಲದವರಲ್ಲಿ ಅದನ್ನು ನಡೆಸುವುದಕ್ಕಾಗಿ ನನಗೆ ವಹಿಸಿದ್ದನು. <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/><note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">ಯೆರೆ 1:18, ಪ್ರಕ 3:12</char></note>ಸಭೆಯ ಸ್ತಂಭಗಳೆಂದು ಕರೆಸಿಕೊಂಡಿರುವ ಯಾಕೋಬ, ಕೇಫ, ಯೋಹಾನರು ದೇವರು ನನಗೆ ದಯಪಾಲಿಸಿರುವ ವರವನ್ನು ತಿಳಿದುಕೊಂಡು, <note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">2 ಪೇತ್ರ. 3:15</char></note>ಅನ್ಯೋನ್ಯತೆಯನ್ನು ತೋರಿಸುವುದಕ್ಕಾಗಿ ನನಗೂ ಬಾರ್ನಬನಿಗೂ ಸಹಕಾರ ನೀಡಿ ಬಲಗೈ ಕೊಟ್ಟು, ನೀವು ಅನ್ಯಜನಗಳ ಬಳಿಗೆ ಹೋಗಿರಿ, ನಾವು ಸುನ್ನತಿಯವರ ಬಳಿಗೆ ಹೋಗುತ್ತೇವೆ ಅಂದರು. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>ಆದರೆ ನೀವು ನಮ್ಮಲ್ಲಿರುವ ಬಡವರನ್ನು ಮರೆಯಬಾರದೆಂಬ ಒಂದೇ ಸಂಗತಿಯನ್ನು ಬೇಡಿಕೊಂಡರು, <note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">ಅ. ಕೃ. 24:17</char></note>ಹಾಗೆ ಮಾಡುವುದರಲ್ಲಿ ನಾನೂ ಆಸಕ್ತನಾಗಿದ್ದೆನು.<verse eid="GAL 2:10"/></para>
  <para style="s">ಪೌಲನು ಅಂತಿಯೋಕ್ಯದಲ್ಲಿ ಪೇತ್ರನನ್ನು ಖಂಡಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:11 </char>
      <char style="ft" closed="false">ಅ. ಕೃ. 15:1,35</char>
    </note>ಕೇಫನು ಅಂತಿಯೋಕ್ಯಕ್ಕೆ ಬಂದಾಗ ಅವನಲ್ಲಿ ತಪ್ಪು ಕಾಣಿಸಿಕೊಂಡದ್ದರಿಂದ ನಾನು ಅವನನ್ನು ಮುಖಾಮುಖಿಯಾಗಿ ಖಂಡಿಸಿದೆನು. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>ಏಕೆಂದರೆ ಯಾಕೋಬನ ಕಡೆಯಿಂದ ಕೆಲವರು ಬರುವುದಕ್ಕೆ ಮೊದಲು <note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">ಅ. ಕೃ. 11:3, ಲೂಕ 15:2</char></note>ಅವನು ಅನ್ಯಜನರೊಂದಿಗೆ ಊಟ ಮಾಡುತ್ತಿದ್ದನು. ಅವರು ಬಂದ ಮೇಲೆ <note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">ಅ. ಕೃ. 11:2</char></note>ಸುನ್ನತಿಯವರಾದ ಅವರಿಗೆ ಅವನು ಭಯಪಟ್ಟು, ಅನ್ಯಜನರನ್ನು ಬಿಟ್ಟು ತನ್ನನ್ನು ಪ್ರತ್ಯೇಕಿಸಿಕೊಂಡನು. <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ಇದಲ್ಲದೆ ಉಳಿದ ಯೆಹೂದ್ಯರೂ ಅವನೊಂದಿಗೆ ಸೇರಿ ಹಾಗೆಯೇ ಕಪಟತನದಿಂದ ವರ್ತಿಸಿದರು. ಹೀಗೆ ಬಾರ್ನಬನೂ ಅವರ ಕಪಟದ ಸೆಳವಿಗೆ ಬಿದ್ದನು. <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>ಅವರು ಸುವಾರ್ತೆಯ ಸತ್ಯಾರ್ಥದ ಪ್ರಕಾರ ಸರಿಯಾಗಿ ನಡೆಯುತ್ತಿಲ್ಲವೆಂಬುದನ್ನು ನಾನು ಕಂಡಾಗ ಎಲ್ಲರ ಮುಂದೆ ಕೇಫನಿಗೆ ಹೇಳಿದ್ದೇನಂದರೆ, “ನೀನು ಯೆಹೂದ್ಯನಾಗಿದ್ದು <note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">ವ. 12 ನೋಡಿರಿ</char></note>ಯೆಹೂದ್ಯರಂತೆ ನಡೆಯದೆ ಅನ್ಯಜನರಂತೆ ಬದುಕಿ, ಅನ್ಯಜನರಿಗೆ, ನೀವು ಯೆಹೂದ್ಯರಂತೆ ನಡೆದುಕೊಳ್ಳಬೇಕೆಂದು ಒತ್ತಾಯಪಡಿಸಿ ಹೇಳುವುದಾದರೂ ಹೇಗೆ?”<verse eid="GAL 2:14"/></para>
  <para style="s">ಯೆಹೂದ್ಯರಂತೆ ಅನ್ಯಜನರು ಸಹ ನಂಬಿಕೆಯಿಂದ ರಕ್ಷಣೆಹೊಂದಿದ್ದಾರೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>ನಾವಂತೂ ಜನ್ಮತ ಯೆಹೂದ್ಯರು “ಪಾಪಿಗಳೆನಿಸಿಕೊಂಡ ಅನ್ಯಜನರಲ್ಲ.” <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>ಯಾವನಾದರೂ <note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">ರೋಮಾ. 9:30</char></note>ಯೇಸು ಕ್ರಿಸ್ತನ ಮೇಲೆ ನಂಬಿಕೆ ಇಡುವುದರಿಂದಲೇ ಹೊರತು ಧರ್ಮಶಾಸ್ತ್ರದ <note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">ಗಲಾ. 3:11, ಅ. ಕೃ. 13:39</char></note>ನೇಮನಿಷ್ಠೆಗಳನ್ನು ಅನುಸರಿಸುವುದರಿಂದ ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯಿಸಲ್ಪಡುವುದಿಲ್ಲವೆಂಬುದು ನಮಗೆ ತಿಳಿದಿರುವುದರಿಂದ ನಾವು ಸಹ ಧರ್ಮಶಾಸ್ತ್ರದ ನೇಮನಿಷ್ಠೆಗಳನ್ನು ಬಿಟ್ಟು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಂಬಿಕೆಯಿಟ್ಟೆವು. ಏಕೆಂದರೆ <note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">ಕೀರ್ತ 143:2, ರೋಮಾ. 3:20</char></note>ಯಾರೂ ಧರ್ಮಶಾಸ್ತ್ರದ ನೇಮನಿಷ್ಠೆಗಳನ್ನನುಸರಿಸಿ ನೀತಿವಂತನೆಂದು ನಿರ್ಣಯಿಸಲ್ಪಡುವುದಿಲ್ಲ. <verse eid="GAL 2:16"/><verse number="17" style="v" sid="GAL 2:17"/>ಆದರೆ ನಾವು ಕ್ರಿಸ್ತನ ಮೂಲಕ ನೀತಿವಂತರೆಂಬ ನಿರ್ಣಯ ಹೊಂದುವುದಕ್ಕೆ ಪ್ರಯತ್ನಿಸುತ್ತಿರುವಾಗ, ನಾವೂ ಪಾಪಿಗಳಾಗಿ ತೋರಿಬಂದರೆ ಕ್ರಿಸ್ತನು ಪಾಪಕ್ಕೆ ಸಹಾಯಕನಾಗಿರುವನೋ? ಎಂದಿಗೂ ಇಲ್ಲ. <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>ನಾನು ಕೆಡವಿದ್ದನ್ನೇ ತಿರುಗಿ ಕಟ್ಟಿದರೆ ನನ್ನನ್ನು ನಾನೇ ಅಪರಾಧಿ ಎಂದು ತೋರಿಸಿಕೊಳ್ಳುತ್ತೇನಲ್ಲಾ. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ನಾನಂತೂ ದೇವರಿಗಾಗಿ ಜೀವಿಸುವುದಕ್ಕೋಸ್ಕರ ಧರ್ಮಶಾಸ್ತ್ರದ ಮೂಲಕವಾಗಿ ಧರ್ಮಶಾಸ್ತ್ರದ ಪಾಲಿಗೆ ಸತ್ತವನಾಗಿದ್ದೇನೆ. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>ನಾನು ಸಹ <note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">ಗಲಾ. 5:24, 6:14, ರೋಮಾ. 6:6</char></note>ಕ್ರಿಸ್ತನೊಂದಿಗೆ ಶಿಲುಬೆಗೆ ಹಾಕಿಸಿಕೊಂಡವನಾಗಿದ್ದೇನೆ, ಇನ್ನು ಜೀವಿಸುವವನು ನಾನಲ್ಲ, <note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">ಯೋಹಾ 17:23</char></note>ಕ್ರಿಸ್ತನು ನನ್ನಲ್ಲಿ ಜೀವಿಸುತ್ತಾನೆ. ಈಗ ಶರೀರದಲ್ಲಿರುವ ನಾನು ಜೀವಿಸುವುದು ಹೇಗೆಂದರೆ ದೇವಕುಮಾರನ ಮೇಲಣ ನಂಬಿಕೆಯಿಂದಲೇ. <note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">ರೋಮಾ. 8:37</char></note>ಆತನು ನನ್ನನ್ನು ಪ್ರೀತಿಸಿ ನನಗಾಗಿ ತನ್ನನ್ನು ಒಪ್ಪಿಸಿಕೊಟ್ಟನು. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ನಾನು ದೇವರ ಕೃಪೆಯನ್ನು ತಿರಸ್ಕರಿಸುವುದಿಲ್ಲ. <note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="ft" closed="false">ಗಲಾ. 3:21, ಇಬ್ರಿ. 7:11</char></note>ಧರ್ಮಶಾಸ್ತ್ರದ ಮೂಲಕ ನೀತಿವಂತರಾಗಬಹುದಾದರೆ ಕ್ರಿಸ್ತನು ಮರಣಕ್ಕೀಡಾದುದು ನಿರರ್ಥಕವೇ ಸರಿ.<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">ಧರ್ಮಶಾಸ್ತ್ರವೋ ಅಥವಾ ನಂಬಿಕೆಯೋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>ಎಲೈ ಬುದ್ಧಿಹೀನರಾದ ಗಲಾತ್ಯದವರೇ! ನಿಮ್ಮನ್ನು ಮರುಳುಗೊಳಿಸಿದವರು ಯಾರು? ಯೇಸು ಕ್ರಿಸ್ತನು <note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">1 ಕೊರಿ 1:23; ಅರಣ್ಯ 21:9</char></note>ಶಿಲುಬೆಗೆ ಹಾಕಿಸಿಕೊಂಡವನಾಗಿ ನಿಮ್ಮ ಕಣ್ಣೆದುರಿನಲ್ಲಿಯೇ ವರ್ಣಿಸಲ್ಪಟ್ಟನಲ್ಲವೇ? <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>ಒಂದು ಸಂಗತಿಯನ್ನು ಮಾತ್ರ ನಿಮ್ಮಿಂದ ತಿಳಿದುಕೊಳ್ಳಬೇಕೆಂದಿದ್ದೇನೆ. <note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ಗಲಾ. 3:14; ಎಫೆ 1:13; ಇಬ್ರಿ. 6:4; ಅ. ಕೃ. 15:8</char></note>ನೀವು ದೇವರಾತ್ಮನನ್ನು ಹೊಂದಿದ್ದು ಧರ್ಮಶಾಸ್ತ್ರದ ನೇಮನಿಷ್ಠೆಗಳನ್ನು ಅನುಸರಿಸಿದ್ದರಿಂದಲೋ ಅಥವಾ <note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ರೋಮಾ. 10:17</char></note>ನಂಬಿಕೆಯ ಸುವಾರ್ತೆಯನ್ನು ಕೇಳಿದ್ದರಿಂದಲೋ? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>ನೀವು ಇಷ್ಟು ಬುದ್ಧಿಯಿಲ್ಲದವರೋ? <note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">ಫಿಲಿ. 1:6; ಗಲಾ. 4:9</char></note>ದೇವರಾತ್ಮಾನುಸಾರವಾಗಿ ಪ್ರಾರಂಭಿಸಿ ಈಗ ಶಾರೀರಿಕ ಸಂಬಂಧವಾಗಿ ಕೊನೆಗೊಳಿಸುವಿರೋ?<verse eid="GAL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 3:4"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:4 </char>
      <char style="ft" closed="false">ಇಬ್ರಿ. 10:35; 2 ಯೋಹಾ 8</char>
    </note>ನೀವು ಇವೆಲ್ಲವುಗಳನ್ನು ಅನುಭವಿಸಿದ್ದು ವ್ಯರ್ಥವೋ? ವ್ಯರ್ಥವೇ ಎಂದು ಹೇಳಬೇಕೇನು? <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>ದೇವರು ತನ್ನ ಆತ್ಮನನ್ನು ನಿಮಗೆ ಹೇರಳವಾಗಿ ಕೊಟ್ಟು ನಿಮ್ಮಲ್ಲಿ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡಿಸುತ್ತಾ ಬಂದದ್ದು, <note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">ವ. 12</char></note>ನೀವು ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಅನುಸರಿಸಿದ್ದರಿಂದಲೋ ಅಥವಾ ಸುವಾರ್ತೆಯನ್ನು ಕೇಳಿ ನಂಬಿದ್ದರಿಂದಲೋ?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:6 </char>
      <char style="ft" closed="false">ಆದಿ 12:3; 18:18</char>
    </note>ಅಬ್ರಹಾಮನು “ದೇವರನ್ನು ನಂಬಿದನು, ಆ ನಂಬಿಕೆಯು ಅವನ ಪಾಲಿಗೆ ನೀತಿಯೆಂದು ಎಣಿಸಲ್ಪಟ್ಟಿತು” ಎಂಬುದಾಗಿ ಬರೆದಿದೆಯಲ್ಲಾ. <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ಆದ್ದರಿಂದ <note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">ವ. 9</char></note>ನಂಬುವವರೇ ಅಬ್ರಹಾಮನ ಮಕ್ಕಳೆಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ.<verse eid="GAL 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 3:8"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:8 </char>
      <char style="ft" closed="false">ರೋಮಾ. 3:30</char>
    </note>ದೇವರು ಅನ್ಯಜನರನ್ನು ನಂಬಿಕೆಯ ನಿಮಿತ್ತವಾಗಿಯೇ ನೀತಿವಂತರೆಂದು ನಿರ್ಣಯಿಸುವನೆಂಬುದಾಗಿರುವ ವೇದವಾಕ್ಯವನ್ನು ಮೊದಲೇ ಕಂಡು ಅಬ್ರಹಾಮನಿಗೆ, <note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">ಆದಿ 12:3; 18:18</char></note>“ನಿನ್ನ ಮೂಲಕ ಎಲ್ಲಾ ಜನಾಂಗಗಳವರಿಗೆ ಆಶೀರ್ವಾದವುಂಟಾಗುವುದೆಂಬ” ಸುವಾರ್ತೆಯನ್ನು ಮುಂಚಿತವಾಗಿಯೇ ತಿಳಿಸಿತು. <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>ಹೀಗಿರಲಾಗಿ ಯೇಸು ಕ್ರಿಸ್ತನಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವವರು, ನಂಬಿಕೆಯಿಟ್ಟ ಅಬ್ರಹಾಮನೊಂದಿಗೆ ಆಶೀರ್ವಾದವನ್ನು ಹೊಂದುವರು.<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:10 </char>
      <char style="ft" closed="false">ಗಲಾ. 5:4; ರೋಮಾ. 1:17; ಇಬ್ರಿ. 10:38</char>
    </note>ಮೋಶೆಯ ಧರ್ಮಶಾಸ್ತ್ರದ ನೇಮನಿಷ್ಠೆಗಳನ್ನು ಆಧಾರಮಾಡಿಕೊಂಡಿರುವವರೆಲ್ಲರೂ ಶಾಪಾಗ್ರಸ್ತರಾಗಿದಾರೆ. ಹೇಗೆಂದರೆ, <note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">ಧರ್ಮೋ 27:26; ಯೆರೆ 11:3</char></note>“ಧರ್ಮಶಾಸ್ತ್ರದಲ್ಲಿ ಬರೆದಿರುವವುಗಳೆಲ್ಲವನ್ನೂ ಪ್ರತಿನಿತ್ಯವೂ ಪಾಲಿಸದಿರುವ ಪ್ರತಿಯೊಬ್ಬನು ಶಾಪಗ್ರಸ್ತನೇ” ಎಂದು ಧರ್ಮಶಾಸ್ತ್ರದಲ್ಲಿ ಬರೆದಿದೆ. <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>ಇದಲ್ಲದೆ <note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">ಗಲಾ. 2:16</char></note>ಧರ್ಮಶಾಸ್ತ್ರದಿಂದ ಯಾರೂ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ನೀತಿವಂತರಾಗಲು ಸಾಧ್ಯವಿಲ್ಲವೆಂದು ಸ್ಪಷ್ಟವಾಗಿದೆ, ಏಕೆಂದರೆ <note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">ಹಬ 2:4; ರೋಮಾ. 1:17; ಇಬ್ರಿ. 10:38</char></note>“ನೀತಿವಂತನು ನಂಬಿಕೆಯಿಂದಲೇ ಬದುಕುವನು” ಎಂದು ಪ್ರಕಟವಾಗಿದೆ.<verse eid="GAL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 3:12"/>ಹಾಗೆಯೇ ಮೋಶೆಯ ಧರ್ಮಶಾಸ್ತ್ರಕ್ಕೆ ನಂಬಿಕೆಯು ಆಧಾರವಾಗಿಲ್ಲ, <note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">ಯಾಜ 18:5; ರೋಮಾ. 10:5</char></note>“ಅದರ ನೇಮಗಳನ್ನು ಆಚರಿಸುವವನೇ ಅವುಗಳ ಮೂಲಕ ಬದುಕುವನು” ಎಂದು ಬರೆದಿದೆ.<verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>ಯೇಸು ಕ್ರಿಸ್ತನು ನಮನ್ನು ಶಾಪದಿಂದ ಬಿಡಿಸುವುದಕ್ಕಾಗಿ ತಾನೇ ಶಾಪಗ್ರಸ್ತನಾದನು. ಏಕೆಂದರೆ ಮೋಶೆಯ <note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">ಗಲಾ. 4:5</char></note>ಧರ್ಮಶಾಸ್ತ್ರದಲ್ಲಿ ಬರೆದಿರುವ ಪ್ರಕಾರ <note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">ಧರ್ಮೋ 21:23</char></note>“ಮರಕ್ಕೆ ತೂಗುಹಾಕಲ್ಪಟ್ಟು ಪ್ರತಿಯೊಬ್ಬನು ಶಾಪಗ್ರಸ್ತನು” ಎಂದು ತಿಳಿದಿದ್ದೇವೆ.<verse eid="GAL 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 3:14"/>ಅಬ್ರಹಾಮನಿಗೆ ಉಂಟಾದ ಆಶೀರ್ವಾದವು, ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ <note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">ರೋಮಾ. 4:9,16</char></note>ಅನ್ಯಜನರಿಗೆಲ್ಲ ಸಿಗುವಂತೆಯೂ ಮತ್ತು <note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">ಅ. ಕೃ. 2:33; ಯೆಶಾ 32:15; 44:3; ಯೋವೇ. 2:28; ಯೋಹಾ 7:39; ಎಫೆ 1:13</char></note>ದೇವರು ವಾಗ್ದಾನ ಮಾಡಿದ ಪರಿಶುದ್ಧಾತ್ಮನು ನಮಗೆ <note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">ವ. 2</char></note>ನಂಬಿಕೆಯ ಮೂಲಕ ದೊರಕುವಂತೆಯೂ, ತನ್ನ ಮರಣದ ಮೂಲಕ ಕ್ರಿಸ್ತನು ನಮ್ಮನ್ನು ಕೊಂಡುಕೊಂಡನು.<verse eid="GAL 3:14"/></para>
  <para style="s">ಧರ್ಮಶಾಸ್ತ್ರವು ಹಾಗೂ ವಾಗ್ದಾನವು</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>ಸಹೋದರರೇ, <note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">ರೋಮಾ. 3:5</char></note>ದೈನಂದಿನ ಜೀವನದಿಂದ ಒಂದು ದೃಷ್ಟಾಂತವನ್ನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ, ಒಬ್ಬನು ಮತ್ತೊಬ್ಬನೊಡನೆ <note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">ಇಬ್ರಿ. 9:17</char></note>ಸ್ಥಿರಪಡಿಸಿದ ಒಂದು ಒಪ್ಪಂದವು ಕೇವಲ ಮನುಷ್ಯನದ್ದಾಗಿದ್ದರೂ, ಅದನ್ನು ಯಾರೂ ರದ್ದುಮಾಡುವಂತಿಲ್ಲ ಮತ್ತು ಅದಕ್ಕೆ ಏನನ್ನೂ ಸೇರಿಸುವಂತಿಲ್ಲ. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>ಹಾಗೆಯೇ, <note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">ರೋಮಾ. 4:13, 16; ಲೂಕ 1:55; ಅ. ಕೃ. 13:32</char></note>ದೇವರು ಅಬ್ರಹಾಮನಿಗೆ ಮತ್ತು ಅವನಿಂದ ಬರುವ ಪೀಳಿಗೆಗೆ ವಾಗ್ದಾನ ಮಾಡಿದನು. ಆದರೆ “ಪೀಳಿಗೆ” ಎಂದು ಹೇಳಿದಾಗ, ಅದು ವಂಶದಲ್ಲಿ ಇರುವ ಎಲ್ಲರಿಗೂ ಅನ್ವಯಿಸದೇ, ಅಬ್ರಹಾಮನ ವಂಶಕ್ಕೆ ಸೇರಿದ ಒಬ್ಬ ವ್ಯಕ್ತಿಯನ್ನೇ ಸೂಚಿಸುತ್ತದೆ. <note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">ಆದಿ 12:7; 13:15; 17:7,8; 22:18</char></note>ಆ ಒಬ್ಬನು ಕ್ರಿಸ್ತನೇ.<verse eid="GAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17"/>ನಾನು ಹೇಳಬಯಸುವುದೇನೆಂದರೆ, ದೇವರು ಮೊದಲು ಅನುಮೋದಿಸಿದ ಒಡಂಬಡಿಕೆಯನ್ನು, <note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">ವಿಮೋ 12:40,41; ಆದಿ 15:13; ಅ. ಕೃ. 7:6</char></note>ನಾನೂರ ಮೂವತ್ತು ವರ್ಷಗಳ ನಂತರ ಬಂದ ಮೋಶೆಯ ಧರ್ಮಶಾಸ್ತ್ರವು ಅದನ್ನು ನಿರರ್ಥಕಗೊಳಿಸಿ, ಆ ವಾಗ್ದಾನವನ್ನು ಬರಿದಾಗಿಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>ಅಬ್ರಹಾಮನಿಗೆ ಸಿಕ್ಕ ಆ ಬಾಧ್ಯತೆ ಮೋಶೆಯ ಧರ್ಮಶಾಸ್ತ್ರದ ಮೇಲೆ ಆಧಾರಗೊಂಡಿರುವುದಾದರೆ, ವಾಗ್ದಾನದ ಮೇಲೆ ಆಧಾರವಾಗಲು ಸಾಧ್ಯವಾಗುತ್ತಿರಲಿಲ್ಲ. <note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">ಇಬ್ರಿ. 6:13,14</char></note>ಆದರೆ ದೇವರು ಅಬ್ರಹಾಮನಿಗೆ ಕೊಟ್ಟ ಬಾಧ್ಯತೆಯನ್ನು ವಾಗ್ದಾನದ ಮೂಲಕವಾಗಿಯೇ ದಯಪಾಲಿಸಿದ್ದಾನೆ.<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>ಹಾಗಾದರೆ ಮೋಶೆಯ ಧರ್ಮಶಾಸ್ತ್ರವು ಯಾತಕ್ಕೆ? ವಾಗ್ದಾನದಲ್ಲಿ ಸೂಚಿತನಾದವನು ಹುಟ್ಟಿ ಬರುವತನಕ ದೇವರು ಇಂಥಿಂಥದು ಅಪರಾಧವೆಂದು ತೋರಿಸುವುದಕ್ಕಾಗಿ ಅದನ್ನು <note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">ವ. 16</char></note>ವಾಗ್ದಾನದ ತರುವಾಯ ನೇಮಿಸಿ ದೇವದೂತರ ಮುಖಾಂತರ ಒಬ್ಬ ಮಧ್ಯಸ್ಥನ ಕೈಯಲ್ಲಿ ಕೊಟ್ಟನು.<verse eid="GAL 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 3:20"/>ಒಂದೇ ಪಕ್ಷವಿದ್ದರೆ ಮಧ್ಯಸ್ಥನು ಬೇಕಿಲ್ಲ. ದೇವರಾದರೋ ಒಬ್ಬನೇ.<verse eid="GAL 3:20"/></para>
  <para style="s">ದಾಸರು ಹಾಗೂ ಮಕ್ಕಳು</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ಹಾಗಾದರೆ ಮೋಶೆಯ ಧರ್ಮಶಾಸ್ತ್ರವು ದೇವರ ವಾಗ್ದಾನಗಳಿಗೆ ವಿರುದ್ಧವೋ? ಹಾಗೆ ಎಂದಿಗೂ ತಿಳಿದುಕೊಳ್ಳಬಾರದು. ಬದುಕಿಸುವುದಕ್ಕೆ ಶಕ್ತವಾಗಿರುವ ಧರ್ಮಶಾಸ್ತ್ರವು ಕೊಡಲ್ಪಟ್ಟಿದ್ದರೆ ಅದನ್ನು ಅನುಸರಿಸುವುದರ ಮೂಲಕ ನಿಸ್ಸಂದೇಹವಾಗಿ ನೀತಿಯುಂಟಾಗುತ್ತಿತ್ತು. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>ಸಮಸ್ತ ಲೋಕವು ಪಾಪಕ್ಕೆ ಅಧೀನವಾಯಿತೆಂದು ಪವಿತ್ರಗ್ರಂಥವು ಸ್ಪಷ್ಪೀಕರಿಸುತ್ತದೆ. ಹೀಗಿರುವುದರಿಂದ ವಾಗ್ದಾನ ಮಾಡಿದ ಸೌಭಾಗ್ಯವನ್ನು ಯೇಸು ಕ್ರಿಸ್ತನಲ್ಲಿ ನಂಬಿಕೆಯಿಟ್ಟವರಿಗೆ ಅವರ ನಂಬಿಕೆಯ ಆಧಾರದ ಮೇಲೆ ಕೊಡಲಾಗುತ್ತದೆ.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>ಆದರೆ ಯೇಸು ಕ್ರಿಸ್ತನ ನಂಬಿಕೆಯಲ್ಲಿ ಜೀವಿಸುವ ಕಾಲ ಬರುವುದಕ್ಕೆ <note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false">1 ಪೇತ್ರ 1:5</char></note>ಮೊದಲು ನಾವು ಮುಂದಕ್ಕೆ ಪ್ರಕಟವಾಗಬೇಕಾಗಿದ್ದ ಆ ನಂಬಿಕೆಗೆ ವಶವಾಗುವುದಕ್ಕಾಗಿ ಮೋಶೆಯ <note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false">ನೇಮನಿಷ್ಠೆಗಳ</char></note>ಧರ್ಮಶಾಸ್ತ್ರದಿಂದ ನಾವು ಬಂಧಿಸಲ್ಪಟ್ಟಿದ್ದೆವು. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/><note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">ಗಲಾ. 3:11; 2:16</char></note>ನಾವು ನಂಬಿಕೆಯಿಂದ ಯೇಸು ಕ್ರಿಸ್ತನಲ್ಲಿ ನೀತಿವಂತರೆಂಬ ನಿರ್ಣಯವನ್ನು ಹೊಂದುವ ಕಾಲ ಬರುವ ತನಕ, ಮೋಶೆಯ ಧರ್ಮಶಾಸ್ತ್ರವು ನಮ್ಮನ್ನು ಮುನ್ನಡೆಸುವ ಪಾಲಕನಂತಾಗಿತ್ತು. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>ಆದರೆ ಈಗ ಕ್ರಿಸ್ತ ನಂಬಿಕೆಯು ಬಂದಿರಲಾಗಿ ನಾವು ಮುನ್ನಡೆಸುವಂಥ ಧರ್ಮಶಾಸ್ತ್ರದ ಹತೋಟಿಯಲ್ಲಿ ಇಲ್ಲ. <verse eid="GAL 3:25"/><verse number="26" style="v" sid="GAL 3:26"/>ಹಾಗೆ <note caller="+" style="f"><char style="fr" closed="false">3:26 </char><char style="ft" closed="false">ಗಲಾ. 4:5,6</char></note>ನೀವೆಲ್ಲರೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿಟ್ಟಿರುವ ನಂಬಿಕೆಯ ಮೂಲಕ ದೇವರ ಮಕ್ಕಳಾಗಿದ್ದೀರಿ.<verse eid="GAL 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GAL 3:27"/>ಹೇಗೆಂದರೆ <note caller="+" style="f"><char style="fr" closed="false">3:27 </char><char style="ft" closed="false">ರೋಮಾ. 6:3</char></note>ಕ್ರಿಸ್ತನಲ್ಲಿ ಸೇರುವುದಕ್ಕೆ ದೀಕ್ಷಾಸ್ನಾನ ಮಾಡಿಸಿಕೊಂಡಿರುವ <note caller="+" style="f"><char style="fr" closed="false">3:27 </char><char style="ft" closed="false">ರೋಮಾ. 13:14</char></note>ನೀವೆಲ್ಲರೂ ಕ್ರಿಸ್ತನನ್ನು ಧರಿಸಿಕೊಂಡಿದ್ದೀರಿ. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/><note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">ಯೋಹಾ 10:16; 17:11; 1 ಕೊರಿ 10:17; ಎಫೆ 2:14-16; 4:4 </char></note>ನೀವೆಲ್ಲರೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಒಂದೇ ಆಗಿರುವುದರಿಂದ <note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">ಗಲಾ. 3:14; 5:6; 6:15; ರೋಮಾ. 3:30; 8:17; ಎಫೆ 3:6</char></note>ಯೆಹೂದ್ಯನು ಅಥವಾ ಗ್ರೀಕನು ಎಂದಾಗಲೀ, ಆಳು ಅಥವಾ ಒಡೆಯ ಎಂದಾಗಲೀ, <note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">1 ಕೊರಿ 11:11</char></note>ಗಂಡು ಹಾಗೂ ಹೆಣ್ಣು ಎಂದಾಗಲೀ ಭೇದವಿಲ್ಲ. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/><note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="ft" closed="false">1 ಕೊರಿ 3:23</char></note>ನೀವು ಕ್ರಿಸ್ತನವರಾಗಿದ್ದರೆ <note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="ft" closed="false">ರೋಮಾ. 9:7</char></note>ಅಬ್ರಹಾಮನ ವಂಶದವರಾಗಿ ಹಾಗೂ ದೇವರ ವಾಗ್ದಾನಕ್ಕನುಸಾರವಾಗಿ <note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="ft" closed="false">ಗಲಾ. 4:1,7; ರೋಮಾ. 8:17; ಎಫೆ 3:6</char></note>ಬಾಧ್ಯರೂ ಆಗಿದ್ದೀರಿ.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ಆದರೆ ನಾನು ಹೇಳುವುದೇನಂದರೆ, ವಾರಸುದಾರನು, ತಾನು ಆಸ್ತಿಗೆಲ್ಲಾ ಒಡೆಯನಾಗಿದ್ದರೂ ಬಾಲಕನಾಗಿರುವ ತನಕ ದಾಸನಂತೆಯೇ ಇರುವನು. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>ತಂದೆಯು ಗೊತ್ತುಮಾಡಿದ ಸಮಯದವರೆಗೂ ಪಾಲಕರ ಮತ್ತು ಕಾರ್ಯನಿರ್ವಾಹಕರ ಅಧೀನದಲ್ಲಿರುವನು. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ಹಾಗೆಯೇ ನಾವು ಸಹ ಬಾಲಕರಾಗಿದ್ದಾಗ <note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">ಕೊಲೊ 2:8,20</char></note>ಲೋಕದ ಮೂಲತತ್ವಗಳಿಗೆ ಅಧೀನರಾಗಿದ್ದೆವು. <verse eid="GAL 4:3"/><verse number="4-5" style="v" sid="GAL 4:4-5"/>ಆದರೆ<note caller="+" style="f"><char style="fr" closed="false">4:4-5 </char><char style="ft" closed="false">ಮಾರ್ಕ 1:15</char></note> ಸೂಕ್ತಸಮಯ ಬಂದಾಗ ದೇವರು ತನ್ನ ಮಗನನ್ನು ಕಳುಹಿಸಿಕೊಟ್ಟನು. ಧರ್ಮಶಾಸ್ತ್ರಕ್ಕೆ ಅಧೀನರಾದವರನ್ನು <note caller="+" style="f"><char style="fr" closed="false">4:4-5 </char><char style="ft" closed="false">ಗಲಾ. 3:13</char></note>ಬಿಡಿಸಬೇಕೆಂತಲೂ, <note caller="+" style="f"><char style="fr" closed="false">4:4-5 </char><char style="ft" closed="false">ಗಲಾ. 3:26; ರೋಮಾ. 8:16</char></note>ಪುತ್ರರ ಬಾಧ್ಯತೆಯ ಪದವಿಯನ್ನು ನಮಗೆ ದೊರಕಿಸಿಕೊಡಬೇಕೆಂತಲೂ ಆತನು <note caller="+" style="f"><char style="fr" closed="false">4:4-5 </char><char style="ft" closed="false">ಫಿಲಿ. 2:7, ಯೋಹಾ 1:14</char></note>ಸ್ತ್ರೀಯಲ್ಲಿ ಹುಟ್ಟಿದವನಾಗಿಯೂ, <note caller="+" style="f"><char style="fr" closed="false">4:4-5 </char><char style="ft" closed="false">ಲೂಕ 2:21-22,27</char></note>ಧರ್ಮಶಾಸ್ತ್ರಾಧೀನನಾಗಿಯೂ ಬಂದನು. <verse eid="GAL 4:4-5"/><verse number="6" style="v" sid="GAL 4:6"/>ನೀವು ಪುತ್ರರಾಗಿರುವುದರಿಂದ ದೇವರು, “ಅಪ್ಪಾ ತಂದೆಯೇ” ಎಂದು ಕೂಗುವ <note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">ಅ. ಕೃ. 16:7, ರೋಮಾ. 5:5; 8:9,15. 2 ಕೊರಿ 3:17</char></note>ತನ್ನ ಮಗನ ಆತ್ಮನನ್ನು ನಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ಕಳುಹಿಸಿಕೊಟ್ಟನು. <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>ಹೀಗಿರುವಲ್ಲಿ ಇನ್ನು ನೀನು ಸೇವಕನಲ್ಲ, ಮಗನಾಗಿದ್ದೀ. ಮಗನೆಂದ ಮೇಲೆ <note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">ಗಲಾ. 3:29</char></note>ದೇವರ ಮೂಲಕ ವಾರಸುದಾರನು ಆಗಿದ್ದೀ.<verse eid="GAL 4:7"/></para>
  <para style="s">ಗಲಾತ್ಯದವರ ಕುರಿತು ಪೌಲನ ಕಾಳಜಿ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ಹಿಂದೆ <note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">1 ಕೊರಿ 1:21, 2 ಥೆಸ. 1:8</char></note>ನೀವು ದೇವರನ್ನು ಅರಿಯದೆ, ಸ್ವಾಭಾವಿಕವಾಗಿ <note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">ಎಫೆ 2:11-12, 1 ಥೆಸ. 1:9</char></note>ದೇವರಲ್ಲದವರುಗಳಿಗೆ ದಾಸರಾಗಿದ್ದೀರಿ. <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>ಈಗಲಾದರೋ ನೀವು ದೇವರನ್ನು ತಿಳಿದುಕೊಂಡಿದ್ದೀರಿ, ಅಥವಾ <note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">1 ಕೊರಿ 8:3</char></note>ದೇವರು ನಿಮ್ಮನ್ನು ತಿಳಿದುಕೊಂಡಿದ್ದಾನೆ. ಹೀಗಿರಲಾಗಿ ನೀವು ಬಲವಿಲ್ಲದ, <note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">ರೋಮಾ. 8:3, ಇಬ್ರಿ. 7:18</char></note>ಕೆಲಸಕ್ಕೆ ಬಾರದ, ದರಿದ್ರವಾದ ಮೂಲತತ್ವಗಳಿಗೆ <note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">ಗಲಾ. 3:3</char></note>ಹಿಂತಿರುಗಿ ಅದಕ್ಕೆ ದಾಸರಾಗುವುದಕ್ಕೆ ಏಕೆ ಬಯಸುತ್ತೀರಿ? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/><note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">ರೋಮಾ. 14:5, ಕೊಲೊ 2:16</char></note>ನೀವು ಆಯಾ ದಿನಗಳನ್ನೂ, ತಿಂಗಳುಗಳನ್ನೂ, ಕಾಲಗಳನ್ನೂ, ಸಂವತ್ಸರಗಳನ್ನೂ ನಿಷ್ಠೆಯಿಂದ ಆಚರಿಸಿದ್ದೀರಿ. <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/><note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">ಗಲಾ. 2:2, 5:2-4, 1 ಥೆಸ. 3:5</char></note>ನಾನು ನಿಮಗೋಸ್ಕರ ಪ್ರಯಾಸಪಟ್ಟದ್ದು ನಿಷ್ಫಲವಾಯಿತೋ ಏನೋ ಎಂದು ನಿಮ್ಮ ಕುರಿತು ಭಯಪಡುತ್ತೇನೆ.<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>ಸಹೋದರರೇ, ನಾನು ನಿಮ್ಮಂತೆ ಆದಹಾಗೆ ನೀವು ನನ್ನಂತೆ ಹಾಗೆ ಆಗಬೇಕೆಂದು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ. ನೀವು ನನಗೇನೂ ಅನ್ಯಾಯ ಮಾಡಲಿಲ್ಲ. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>ನಾನು ದೈಹಿಕವಾಗಿ ಅಸ್ವಸ್ಥನಾಗಿದ್ದುದರಿಂದ ನಿಮ್ಮಲ್ಲಿದ್ದು ಮೊದಲನೆಯ ಬಾರಿಗೆ ನಿಮಗೆ ಸುವಾರ್ತೆ ಸಾರಿದ್ದನ್ನು ನೀವು ಬಲ್ಲಿರಿ. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ನನ್ನ ದೇಹಸ್ಥಿತಿಯಿಂದ ನಿಮಗೆ ಸಮಸ್ಯೆಗಳು ಬಂದಾಗ್ಯೂ ಕೂಡ, ನೀವು ನನ್ನನ್ನು ಹೀನೈಸಲಿಲ್ಲ, ತಿರಸ್ಕರಿಸಲಿಲ್ಲ. ನನ್ನನ್ನು <note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">2 ಕೊರಿ 5:20</char></note>ದೇವದೂತನಂತೆ, <note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">ಮತ್ತಾ 10:40</char></note>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಂತೆ ಸೇರಿಸಿಕೊಂಡಿದ್ದೀರಿ. <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>ಆಗ ನಮಗೆ ಶುಭವಾಯಿತೆಂದು ನೀವು ಅಂದುಕೊಂಡಿರಲ್ಲಾ, ಆ ನಿಮ್ಮ ಶುಭವು ಎಲ್ಲಿ ಹೋಯಿತು? ಸಾಧ್ಯವಾಗಿದ್ದರೆ ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನಾದರೂ ಕಿತ್ತು ನನಗೆ ಕೊಡುತ್ತಿದ್ದಿರೆಂದು ನಿಮ್ಮನ್ನು ಕುರಿತು ಸಾಕ್ಷಿ ಹೇಳುತ್ತೇನೆ. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ಹೀಗಿರಲಾಗಿ ನಾನು ನಿಮಗೆ ಸತ್ಯವನ್ನು ಹೇಳುವುದರಿಂದ ನಿಮಗೆ ಶತ್ರುವಾಗಿದ್ದೇನೋ?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>ಅವರು ನಿಮ್ಮನ್ನು ಮೆಚ್ಚಿಸುವುದಕ್ಕೆ ಆಸಕ್ತಿಯನ್ನು ತೋರಿಸುತ್ತಿರುವುದು ಒಳಿತಾಗಿ ಅಲ್ಲ, ನೀವು ಅವರಿಗೆ ಆಸಕ್ತಿಯನ್ನು ತೋರಿಸಬೇಕೆಂದು ಅವರು ನಿಮ್ಮನ್ನು ನನ್ನಿಂದ ಆಗಲಿಸುವುದಕ್ಕೆ ಬಯಸುತ್ತಿದ್ದಾರೆ. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>ನಾನು ನಿಮ್ಮ ಸಂಗಡ ಇರುವಾಗ ಮಾತ್ರವಲ್ಲದೆ ಯಾವಾಗಲೂ ಒಳ್ಳೆಯ ವಿಷಯಕ್ಕಾಗಿ ನೀವು ಆಸಕ್ತಿಯನ್ನು ತೋರಿಸುವುದು ಒಳ್ಳೆಯದೇ. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/><note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">1 ಕೊರಿ 4:15, ಫಿಲೆ. 10 ನೋಡಿರಿ</char></note>ನನ್ನ ಪ್ರಿಯರಾದ ಮಕ್ಕಳೇ, <note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">ರೋಮಾ. 8:10, 2 ಕೊರಿ 13:5</char></note>ಕ್ರಿಸ್ತನ ಸಾರೂಪ್ಯವು ನಿಮ್ಮಲ್ಲಿ ಉಂಟಾಗುವ ತನಕ ನಾನು ನಿಮಗಾಗಿ ಪ್ರಸವವೇದನೆ ಪಡುತ್ತಿರುವೆನು. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>ನಿಮ್ಮ ವಿಷಯದಲ್ಲಿ ಏನು ಮಾಡಬೇಕೋ ನನಗೆ ತೋಚುತ್ತಿಲ್ಲ. ಬಹುಶಃ ನೇರವಾಗಿ ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದು, ನಿಮ್ಮ ಮಧ್ಯದಲ್ಲೇ ಇದ್ದು ನನ್ನ ಮಾತಿನ ರೀತಿಯನ್ನು ಬದಲಾಯಿಸಿದ್ದರೆ ಚೆನ್ನಾಗಿರುತ್ತಿತ್ತೇನೋ!<verse eid="GAL 4:20"/></para>
  <para style="s">ಸಾರಳ ಮತ್ತು ಹಾಗರಳ ದೃಷ್ಟಾಂತ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>ಧರ್ಮಶಾಸ್ತ್ರಕ್ಕೆ ಅಧೀನರಾಗಿರುವುದಕ್ಕೆ ಬಯಸುವವರೇ, ಧರ್ಮಶಾಸ್ತ್ರವು ಏನು ಹೇಳುತ್ತದೆಂದು ನಿಮಗೆ ತಿಳಿದಿಲ್ಲವೋ? ನನಗೆ ತಿಳಿಯಪಡಿಸಿರಿ. <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>ಅದರಲ್ಲಿ ಬರೆದಿರುವುದೇನಂದರೆ, ಅಬ್ರಹಾಮನಿಗೆ ಇಬ್ಬರು ಮಕ್ಕಳಿದ್ದರು. <note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">ಆದಿ 16:5,15</char></note>ಒಬ್ಬನು ದಾಸಿಯಲ್ಲಿ ಹುಟ್ಟಿದವನು, <note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">ಆದಿ 21:2</char></note>ಮತ್ತೊಬ್ಬನು ಸ್ವತಂತ್ರಳಾದವಳಲ್ಲಿ ಹುಟ್ಟಿದವನು. <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/><note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">ರೋಮಾ. 9:7-8</char></note>ದಾಸಿಯ ಮಗನು ಶರೀರಕ್ಕನುಸಾರವಾಗಿ ಹುಟ್ಟಿದವನು, <note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">ವ. 28, ಆದಿ 17:16-19, 18:10,14, ಇಬ್ರಿ. 11:11</char></note>ಸ್ವತಂತ್ರಳಾದವಳ ಮಗನಾದರೋ ವಾಗ್ದಾನದ ಮೂಲಕ ಹುಟ್ಟಿದವನು. <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>ಈ ಸಂಗತಿಗಳು ಹೋಲಿಕೆಗಳಾಗಿವೆ. ಹೇಗೆಂದರೆ ಆ ಇಬ್ಬರು ಸ್ತ್ರೀಯರು ಎರಡು ಒಡಂಬಡಿಕೆಗಳೇ, <note caller="+" style="f"><char style="fr" closed="false">4:24 </char><char style="ft" closed="false">ಧರ್ಮೋ 33:2</char></note>ಒಂದು ಒಡಂಬಡಿಕೆಯು ಸೀನಾಯಿ ಪರ್ವತದಿಂದ ಉಂಟಾಗಿ ದಾಸತ್ವದಲ್ಲಿರಬೇಕಾದ ಮಕ್ಕಳನ್ನು ಹೆರುವಂಥದು, ಅದೇ ಹಾಗರಳು. <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>ಹಾಗರಳು ಅಂದರೆ ಅರಬಸ್ಥಾನದಲ್ಲಿರುವ ಸೀನಾಯಿ ಪರ್ವತವನ್ನು ಸೂಚಿಸುವಂತಹದ್ದು ಈಗಿನ ಯೆರೂಸಲೇಮಿಗೆ ಎಂಬುವಳಿಗೆ ಹೋಲಿಕೆಯಾಗಿದ್ದಾಳೆ, ಏಕೆಂದರೆ ಆಕೆಯು ತನ್ನ ಮಕ್ಕಳೊಂದಿಗೆ ಈಗ ದಾಸತ್ವದಲ್ಲಿದ್ದಾಳೆ. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">ಇಬ್ರಿ. 12:22, ಪ್ರಕ 3:12, 21:2,10</char></note>ಮೇಲಣ ಯೆರೂಸಲೇಮ್ ಎಂಬವಳು ಸ್ವತಂತ್ರಳು, ಇವಳೇ ನಮಗೆ ತಾಯಿ.<verse eid="GAL 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GAL 4:27"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:27 </char>
      <char style="ft" closed="false">ಯೆಶಾ 54:1</char>
    </note>“ಹೆರದ ಬಂಜೆಯೇ, ಆನಂದಿಸು.</para>
  <para style="q2" vid="GAL 4:27">ಪ್ರಸವವೇದನೆಯಿಲ್ಲದವಳೇ, ಹರ್ಷೋದ್ಗಾರಮಾಡು,</para>
  <para style="q1" vid="GAL 4:27">ಗಂಡನುಳ್ಳವಳಿಗಿಂತ ಗಂಡಬಿಟ್ಟವಳಿಗೆ ಮಕ್ಕಳು ಹೆಚ್ಚು”</para>
  <para style="m" vid="GAL 4:27">ಎಂದು ಬರೆದಿದೆಯಲ್ಲಾ.<verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>ಸಹೋದರರೇ, <note caller="+" style="f"><char style="fr" closed="false">4:28 </char><char style="ft" closed="false">ಗಲಾ. 4:23, ರೋಮಾ. 9:8</char></note>ನಾವು ಇಸಾಕನಂತೆ ವಾಗ್ದಾನದ ಫಲವಾಗಿ ಹುಟ್ಟಿದ ಮಕ್ಕಳಾಗಿದ್ದೇವೆ. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>ಆದರೆ ಪೂರ್ವದಲ್ಲಿ ಶಾರೀರಿಕವಾಗಿ ಹುಟ್ಟಿದವನು, ದೇವರಾತ್ಮಬಲದಿಂದ ಹುಟ್ಟಿದವನನ್ನು <note caller="+" style="f"><char style="fr" closed="false">4:29 </char><char style="ft" closed="false">ಆದಿ 21:9, ಗಲಾ. 5:11</char></note>ಹಿಂಸೆಪಡಿಸಿದಂತೆಯೇ ಈಗಲೂ ಆಗುತ್ತಿದೆ. <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>ಆದರೆ ದೇವರ ವಾಕ್ಯವು ಏನು ಹೇಳುತ್ತದೆ? <note caller="+" style="f"><char style="fr" closed="false">4:30 </char><char style="ft" closed="false">ಆದಿ 21:10</char></note>“ದಾಸಿಯನ್ನೂ ಅವಳ ಮಗನನ್ನೂ ಹೊರಗೆ ಹಾಕು. ದಾಸಿಯ ಮಗನು <note caller="+" style="f"><char style="fr" closed="false">4:30 </char><char style="ft" closed="false">ಸ್ವತಂತ್ರಳು</char></note>ಸ್ವತಂತ್ರಳ ಮಗನೊಂದಿಗೆ ಎಷ್ಟು ಮಾತ್ರಕ್ಕೂ ಬಾಧ್ಯಸ್ಥನಾಗಬಾರದು” ಎಂದು ಹೇಳುತ್ತದೆ. <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ಸಹೋದರರೇ, ನಾವು ದಾಸಿಯ ಮಕ್ಕಳಲ್ಲ, <note caller="+" style="f"><char style="fr" closed="false">4:31 </char><char style="ft" closed="false">1 ಪೇತ್ರ. 3:6 </char></note>ಸ್ವತಂತ್ರಳಾದವಳ ಮಕ್ಕಳೇ ಎಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">ಕ್ರೈಸ್ತ ಸ್ವಾತಂತ್ರ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>ಕ್ರಿಸ್ತನು ನಮ್ಮನ್ನು <note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">ಗಲಾ. 2:4; 5:13</char></note>ಸ್ವತಂತ್ರರಾಗಿರಿಸಬೇಕೆಂದೇ ನಮಗೆ ಬಿಡುಗಡೆ ಮಾಡಿದನು. ಅದರಲ್ಲಿ ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲಿರಿ, <note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">ಅ. ಕೃ. 15:10</char></note>ದಾಸತ್ವದ ನೊಗದಲ್ಲಿ ತಿರುಗಿ ಸಿಕ್ಕಿಕೊಳ್ಳಬೇಡಿರಿ.<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>ನೋಡಿರಿ, ಪೌಲನೆಂಬ ನಾನು ನಿಮಗೆ ಹೇಳುತ್ತೇನೆ, <note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">ಅ. ಕೃ. 15:1; 1 ಕೊರಿ 7:18; ಗಲಾ. 5:3-11</char></note>ನೀವು ಸುನ್ನತಿಮಾಡಿಸಿಕೊಂಡರೆ ಕ್ರಿಸ್ತನಿಂದ ನಿಮಗೆ ಏನೂ ಪ್ರಯೋಜನವಿಲ್ಲ. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/><note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">ರೋಮಾ. 2:25</char></note>ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಳ್ಳುವ ಪ್ರತಿಯೊಬ್ಬನಿಗೆ, ನೀನು ಧರ್ಮಶಾಸ್ತ್ರದಲ್ಲಿ ಹೇಳಿರುವುದನ್ನೆಲ್ಲಾ ಮಾಡುವ ಹಂಗಿನಲ್ಲಿದ್ದೀ ಎಂದು ತಿರುಗಿ ಪ್ರಮಾಣವಾಗಿ ಹೇಳುತ್ತೇನೆ. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/><note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">ಗಲಾ. 2:21; 3:10; ರೋಮಾ. 9:31,32</char></note>ನಿಮ್ಮಲ್ಲಿ ಯಾರಾರು ಧರ್ಮಶಾಸ್ತ್ರದಿಂದ ನೀತಿವಂತರಾಗಬೇಕೆಂದು ಬಯಸಿದ್ದೀರೋ ಅವರು ಕ್ರಿಸ್ತನಿಂದ ಅಗಲಿಹೋದವರಾಗಿದ್ದೀರಿ. ಕೃಪೆಯಿಂದ ಬಿದ್ದಹೋದವರಾಗಿದ್ದೀರಿ. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>ನಾವಾದರೋ ದೇವರಾತ್ಮನ ಮೂಲಕ ನಂಬಿಕೆಯಿಂದ ನೀತಿವಂತರಾಗುತ್ತೇವೆಂಬುವ <note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">ರೋಮಾ. 8:23,25</char></note>ನಿರೀಕ್ಷೆ ಸಫಲವಾಗುವುದೆಂದು ಎದುರುನೋಡುವವರಾಗಿದ್ದೇವೆ. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವವರಿಗೆ <note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ಗಲಾ. 6:15; 1 ಕೊರಿ 7:19; ಕೊಲೊ 3:11; ಗಲಾ. 3:28</char></note>ಸುನ್ನತಿಯಾದರೂ ಆಗದಿದ್ದರೂ ಪ್ರಯೋಜನವಿಲ್ಲ, ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ಎಫೆ 6:23; 1 ಥೆಸ. 1:3; ಯಾಕೋಬ 2:18,20,22</char></note>ಅವರಲ್ಲಿ ಪ್ರೀತಿಯಿಂದ ಹೊರಹೊಮ್ಮುವ ನಂಬಿಕೆಯೇ ಪ್ರಯೋಜನವಾಗಿದೆ. <verse eid="GAL 5:6"/><verse number="7" style="v" sid="GAL 5:7"/>ಚೆನ್ನಾಗಿ ಓಡುತ್ತಾ ಇದ್ದೀರಿ. ಆದರೆ ನೀವು ಸತ್ಯವನ್ನು ಅನುಸರಿಸದಂತೆ ನಿಮ್ಮನ್ನು ತಡೆದವರು ಯಾರು? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>ಈ ಮನವೊಲಿಕೆಯು ನಿಮ್ಮನ್ನು ಕರೆದಾತನಿಂದ ಹುಟ್ಟಿದ್ದಲ್ಲ. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/><note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">1 ಕೊರಿ 5:6</char></note>ಸ್ವಲ್ಪ ಹುಳಿಯಿಂದ ಕಣಕವೆಲ್ಲಾ ಹುಳಿಯಾಗುವುದು. <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ನಿಮ್ಮಲ್ಲಿ ಭಿನ್ನಾಭಿಪ್ರಾಯಗಳು ಉಂಟಾಗುವುದಿಲ್ಲವೆಂದು ಕರ್ತನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಕುರಿತಾಗಿ ನನಗೆ ಭರವಸೆ ಉಂಟು. <note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">ಗಲಾ. 1:; 5:12</char></note>ನಿಮ್ಮಲ್ಲಿ ಬೇಧವನ್ನು ಹುಟ್ಟಿಸುವವನು ಯಾವನಾದರೂ ಸರಿಯೇ, ಅವನು ದಂಡನೆಯನ್ನು ಅನುಭವಿಸುವನು.<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>ಸಹೋದರರೇ, ನಾನಾದರೋ ಸುನ್ನತಿಯಾಗಬೇಕೆಂದು ಇನ್ನೂ ಸಾರುವವನಾಗಿದ್ದರೆ <note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">ಗಲಾ. 4:29; 6:12</char></note>ನನಗೆ ಹಿಂಸೆಯಾಗುವುದಾದರೂ ಯಾಕೆ? <note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">1 ಕೊರಿ 1:23</char></note>ಹಾಗಿದ್ದ ಪಕ್ಷದಲ್ಲಿ ಶಿಲುಬೆಯ ದೆಸೆಯಿಂದ ಉಂಟಾಗುವ ತೊಂದರೆಗಳು ನೀಗಿ ಹೋಯಿತಲ್ಲಾ? <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/><note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">ಗಲಾ. 5:10, 2:4</char></note>ನಿಮ್ಮನ್ನು ಕಳವಳಪಡಿಸುವವರು ತಮ್ಮನೇ ತಾವು <note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">ಕಸಿ ಮಾಡುವುದು</char></note>ಅಂಗಚ್ಛೇದನೆಯನ್ನಾದರೂ ಮಾಡಿಕೊಂಡರೆ ಚೆನ್ನಾಗಿತ್ತು.<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>ಸಹೋದರರೇ, <note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">ಗಲಾ. 5:1</char></note>ನೀವು ಸ್ವತಂತ್ರರಾಗಿರಬೇಕೆಂದು ದೇವರು ನಿಮ್ಮನ್ನು ಕರೆದನು. ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">1 ಪೇತ್ರ. 2:1; ಯೂದ. 4</char></note>ನಿಮಗಿರುವ ಸ್ವಾತಂತ್ರ್ಯವನ್ನು ಶರೀರಾಧೀನ ಸ್ವಭಾವಕ್ಕೆ ಆಸ್ಪದವಾಗಿ ಬಳಸದೆ, <note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">1 ಕೊರಿ 9:19</char></note>ಪ್ರೀತಿಯಿಂದ ಒಬ್ಬರಿಗೊಬ್ಬರು ಸೇವೆ ಮಾಡಿರಿ. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>“ನಿನ್ನ ನೆರೆಯವನನ್ನು ನಿನ್ನಂತೆಯೇ ಪ್ರೀತಿಸು” ಎಂಬ ಒಂದೇ ಮಾತಿನಲ್ಲಿ ಧರ್ಮಶಾಸ್ತ್ರವೆಲ್ಲಾ ಅಡಗಿದೆ. <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>ಆದರೆ ನೀವು ಒಬ್ಬರನ್ನೊಬ್ಬರು ಕಚ್ಚಾಡಿ, ಹರಕೊಂಡು, ತಿನ್ನುವವರಾದರೆ ಒಬ್ಬರಿಂದೊಬ್ಬರು ನಾಶವಾದೀರಿ, ಎಚ್ಚರಿಕೆ.<verse eid="GAL 5:15"/></para>
  <para style="s">ಆತ್ಮನ ಫಲವು ಮತ್ತು ದೇಹದ ದುಷ್ಫಲಗಳು</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ನಾನು ಹೇಳುವುದೇನಂದರೆ <note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">ಗಲಾ. 5:24,25; ರೋಮಾ. 8:4</char></note>ಪವಿತ್ರಾತ್ಮನನ್ನು ಅನುಸರಿಸಿ ನಡೆದುಕೊಳ್ಳಿರಿ, ಆಗ ನೀವು <note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">ಎಫೆ 2:3</char></note>ಶರೀರಭಾವದ ಅಭಿಲಾಷೆಗಳನ್ನು ಎಷ್ಟು ಮಾತ್ರಕ್ಕೂ ನೆರವೇರಿಸುವುದಿಲ್ಲ. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>ಏಕೆಂದರೆ ಶರೀರಾಭಿಲಾಷೆಯೂ ಆತ್ಮನಿಗೆ ವಿರುದ್ಧವಾಗಿದೆ, ಆತ್ಮನ ಅಭಿಲಾಷೆಯು ಶರೀರಭಾವಕ್ಕೆ ವಿರುದ್ಧವಾಗಿದೆ. <note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">ರೋಮಾ. 7:15, 18-20</char></note>ನೀವು ಮಾಡಲಿಚ್ಚಿಸುವುದನ್ನು ಮಾಡದಂತೆ ಇವು ಒಂದಕ್ಕೊಂದು ಹೋರಾಡುತ್ತವೆ. <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">ರೋಮಾ. 8:14</char></note>ನೀವು ಆತ್ಮನಿಂದ ನಡಿಸಿಕೊಳ್ಳುವವರಾದರೆ <note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">ರೋಮಾ. 7:4</char></note>ಧರ್ಮಶಾಸ್ತ್ರಕ್ಕೆ ಅಧೀನರಲ್ಲ.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>ಶರೀರಭಾವದ ಸ್ವಭಾವಗಳು ಪ್ರತ್ಯಕ್ಷವಾಗಿಯೇ ಇವೆ, ಅದು ಯಾವುವೆಂದರೆ, ಜಾರತ್ವ, ಬಂಡುತನ, ನಾಚಿಕೆಗೇಡಿತನ, <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ವಿಗ್ರಹಾರಾಧನೆ, ಮಾಟ, ಹಗೆತನ, ಜಗಳ, ಹೊಟ್ಟೆಕಿಚ್ಚು, ಸಿಟ್ಟು, ಪಕ್ಷಪಾತ, <note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">1 ಕೊರಿ 11:19</char></note>ಭಿನ್ನಮತ, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ಮತ್ಸರ, ಕುಡುಕುತನ, ಗಲಭೆ, ಢಂಭಾಚಾರ ಇಂಥವುಗಳೇ. <note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">ಕೊಲೊ 3:6; 1 ಕೊರಿ 6:9</char></note>ಇಂಥ ಕಾರ್ಯಗಳನ್ನು ನಡಿಸುವವರು ದೇವರ ರಾಜ್ಯಕ್ಕೆ ಬಾಧ್ಯಸ್ಥರಾಗುವುದಿಲ್ಲವೆಂದು ನಾನು ಈ ಮೊದಲು ಹೇಳಿದಂತೆಯೇ ಈಗಲೂ ನಿಮ್ಮನ್ನು ಎಚ್ಚರಿಸುತ್ತೇನೆ.<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">ರೋಮಾ. 7:4; 8:5; ಎಫೆ 5:9</char></note>ದೇವರಾತ್ಮನಿಂದ ಉಂಟಾಗುವ ಫಲವೇನಂದರೆ, ಪ್ರೀತಿ, ಸಂತೋಷ, ಸಮಾಧಾನ, ದೀರ್ಘಶಾಂತಿ, <note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">2 ಕೊರಿ 6:6</char></note>ದಯೆ, ಪರೋಪಕಾರ, ನಂಬಿಕೆ, <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>ಸಾಧುತ್ವ, <note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">ಅ. ಕೃ. 24:5; 2 ಪೇತ್ರ 1:6</char></note>ಶಮೆದಮೆ ಇಂಥವುಗಳೇ. <note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">1 ತಿಮೊ. 1:9</char></note>ಇವುಗಳಿಗೆ ವಿರುದ್ಧವಾಗಿ ಯಾವ ಧರ್ಮಶಾಸ್ತ್ರವೂ ಇಲ್ಲ. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿರುವವರು <note caller="+" style="f"><char style="fr" closed="false">5:24 </char><char style="ft" closed="false">ಗಲಾ. 5:16; ರೋಮಾ. 6:6</char></note>ತಮ್ಮ ಶರೀರಭಾವವನ್ನು ಅದರ ವಿಷಯಾಭಿಲಾಷೆ, ಸ್ವೇಚ್ಛಾಭಿಲಾಷೆಗಳ ಸಹಿತವಾಗಿ ಶಿಲುಬೆಗೆ ಹಾಕಿದವರಾಗಿದ್ದಾರೆ.<verse eid="GAL 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 5:25"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:25 </char>
      <char style="ft" closed="false">ಗಲಾ. 5:16</char>
    </note>ನಾವು ಆತ್ಮನಿಂದ ಜೀವಿಸುತ್ತಿರಲಾಗಿ ಆತ್ಮನನ್ನನುಸರಿಸಿ ನಡೆಯೋಣ. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/><note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="ft" closed="false">ಫಿಲಿ. 2:3</char></note>ಅಹಂಕಾರಿಗಳೂ, ಒಬ್ಬರನ್ನೊಬ್ಬರು ಕೆಣಕುವವರೂ, ಒಬ್ಬರ ಮೇಲೊಬ್ಬರು ಮತ್ಸರವುಳ್ಳವರೂ ಆಗದೆ ಇರೋಣ.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">ಪರಸ್ಪರ ಭಾರವನ್ನು ಹೊತ್ತುಕೊಳ್ಳಿರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>ಸಹೋದರರೇ, <note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">2 ಕೊರಿ 2:7, ಇಬ್ರಿ. 12:13, ಯಾಕೋಬ. 5:19</char></note>ನಿಮ್ಮಲ್ಲಿ ಯಾರಾದರೂ ಯಾವುದಾದರೂ ಪಾಪದಲ್ಲಿ ಸಿಕ್ಕಿಹಾಕಿಕೊಂಡಿದ್ದರೆ <note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">ರೋಮಾ. 15:1</char></note>ಅಂಥವರನ್ನು ಆತ್ಮಭರಿತರಾದ ನೀವು ಶಾಂತಭಾವದಿಂದ ತಿದ್ದಿ ಸರಿಮಾಡಿರಿ. ನೀವಾದರೂ ಶೋಧನೆಗೆ ಒಳಗಾಗದಂತೆ ನಿಮ್ಮ ವಿಷಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಾಗಿರಿ. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>ಒಬ್ಬರು ಮತ್ತೊಬ್ಬರ ಭಾರವನ್ನು ಹೊತ್ತುಕೊಳ್ಳಲಿ, ಹೀಗೆ ಕ್ರಿಸ್ತನ <note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು, ಗಲಾ. 5:14</char></note>ನೀತಿನಿಯಮಗಳನ್ನು ನೆರವೇರಿಸಿರಿ. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/><note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">1 ಕೊರಿ 3:18</char></note>ಯಾವನಾದರೂ ಅಲ್ಪನಾಗಿದ್ದು ತಾನು ದೊಡ್ಡವನೆಂದು ಭಾವಿಸಿಕೊಂಡರೆ ತನ್ನನ್ನು ತಾನೇ ಮೋಸಗೊಳಿಸಿಕೊಳ್ಳುವನಾಗಿದ್ದಾನೆ. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/><note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">1 ಕೊರಿ 11:28, 2 ಕೊರಿ 13:5</char></note>ಪ್ರತಿಯೊಬ್ಬನು ತಾನು ಮಾಡಿದ ಕೆಲಸವನ್ನು ಪರೀಕ್ಷಿಸಿಕೊಳ್ಳಲಿ. ಆಗ ಅವನು ತನ್ನ ನಿಮಿತ್ತದಿಂದ ಹೆಚ್ಚಳಪಡಬಹುದೇ ಹೊರತು ಮತ್ತೊಬ್ಬನೊಂದಿಗೆ ಹೋಲಿಸಿಕೊಂಡು ಹೆಚ್ಚಳಪಡಬೇಕಾಗಿರುವುದಿಲ್ಲ. <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>ಏಕೆಂದರೆ <note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">ರೋಮಾ. 14:12</char></note>ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಸ್ವಂತ ಹೊರೆಯನ್ನು ತಾನೇ ಹೊತ್ತುಕೊಳ್ಳಬೇಕು.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:6 </char>
      <char style="ft" closed="false">ರೋಮಾ. 15:27, 1 ಕೊರಿ 9:11</char>
    </note>ದೇವರ ವಾಕ್ಯವನ್ನು ಕಲಿಯುವವನು, ಅದನ್ನು ಕಲಿಸುವವನಿಗೆ ತನ್ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಮೇಲುಗಳಲ್ಲಿಯೂ ಪಾಲನ್ನು ಕೊಡಬೇಕು. <verse eid="GAL 6:6"/><verse number="7" style="v" sid="GAL 6:7"/>ಮೋಸಹೋಗಬೇಡಿರಿ. <note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">ಯೋಬ. 13:9</char></note>ದೇವರನ್ನು ಅಪಹಾಸ್ಯ ಮಾಡಲಾಗುವುದಿಲ್ಲ. <note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">2 ಕೊರಿ 9:6</char></note>ಮನುಷ್ಯನು ತಾನು ಏನು ಬಿತ್ತುತ್ತಾನೋ ಅದನ್ನೇ ಕೊಯ್ಯಬೇಕು. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ತನ್ನ <note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">ಶರೀರಭಾವದಲ್ಲಿ, ಹೋಶೇ. 8:7, ಯೋಬ. 4:8</char></note>ಶರೀರಭಾವವನ್ನು ಕುರಿತು ಬಿತ್ತುವವನು <note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">ರೋಮಾ. 6:21</char></note>ಆ ಭಾವದಿಂದ ನಾಶವನ್ನು ಕೊಯ್ಯುವನು. <note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">ಯಾಕೋಬ. 3:18</char></note>ಆತ್ಮನ ಕುರಿತಾಗಿ ಬಿತ್ತುವವನು ಆತ್ಮನಿಂದ ನಿತ್ಯಜೀವವನ್ನು ಕೊಯ್ಯುವನು. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/><note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">2 ಥೆಸ. 3:13, 1 ಕೊರಿ 15:58</char></note>ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಬೇಸರಗೊಳ್ಳದೇ ಇರೋಣ. ಏಕೆಂದರೆ ಮನಗುಂದದಿದ್ದರೆ ತಕ್ಕ ಸಮಯದಲ್ಲಿ ಬೆಳೆಯನ್ನು ಕೊಯ್ಯುವೆವು. <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ಆದ್ದರಿಂದ ಅವಕಾಶ ಸಿಕ್ಕಿದಾಗಲೆಲ್ಲಾ ಎಲ್ಲರಿಗೂ ಒಳ್ಳೆಯದನ್ನು ಮಾಡೋಣ, ವಿಶೇಷವಾಗಿ <note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">ಎಫೆ 2:19, ಇಬ್ರಿ. 3:6</char></note>ಒಂದೇ ಮನೆಯವರಂತಿರುವ ಕ್ರೈಸ್ತ ವಿಶ್ವಾಸಿಗಳಿಗೆ ಮಾಡೋಣ.<verse eid="GAL 6:10"/></para>
  <para style="s">ಕಡೆ ಎಚ್ಚರಿಕೆಗಳು ಮತ್ತು ವಂದನೆಗಳು</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ಇಗೋ ನೋಡಿರಿ, <note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">1 ಕೊರಿ 16:21</char></note>ಸ್ವಂತ ಕೈಯಿಂದ ಎಂಥಾ ದೊಡ್ಡ ಅಕ್ಷರಗಳಲ್ಲಿ ನಿಮಗೆ ಬರೆಯುತ್ತಾ ಇದ್ದೇನೆ. <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>ದೈಹಿಕವಾಗಿ ಪ್ರಶಂಸೆಯನ್ನು ಹೊಂದಬೇಕೆಂದಿರುವವರು ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಳ್ಳಿರಿ ಎಂಬುದಾಗಿ ನಿಮ್ಮನ್ನು ಒತ್ತಾಯಿಸುತ್ತಾರೆ. <note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">ಗಲಾ. 5:11</char></note>ಏಕೆಂದರೆ ಕ್ರಿಸ್ತನ ಶಿಲುಬೆಯ ದೆಸೆಯಿಂದ ತಮಗೆ ಹಿಂಸೆಯಾಗಬಾರದೆಂಬುದೇ ಅವರ ಉದ್ದೇಶ. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಂಡವರೇ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಕೈಕೊಂಡು ನಡೆಯುತ್ತಿಲ್ಲವಲ್ಲಾ. ಅವರು ನಿಮ್ಮ ಶರೀರದ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚಳಪಡುವುದಕ್ಕಾಗಿ ನಿಮಗೆ ಸುನ್ನತಿಯಾಗಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತಾರೆ. <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/><note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">1 ಕೊರಿ 2:2, ಫಿಲಿ. 3:3, 7-8</char></note>ನನಗಾದರೋ ನಮ್ಮ ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನ ಶಿಲುಬೆಯ ವಿಷಯದಲ್ಲಿಯೇ ಹೊರತು ಬೇರೆ ಯಾವ ವಿಷಯದಲ್ಲಿಯೂ ಹೆಚ್ಚಳಪಡುವುದು ಬೇಕಾಗಿಲ್ಲ. ಆತನ ಮೂಲಕ <note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">ರೋಮಾ. 6:6</char></note>ನಾನು ಲೋಕಕ್ಕೂ, ಲೋಕವು ನನಗಾಗಿಯೂ ಶಿಲುಬೆಗೆ ಹಾಕಿಕೊಂಡು ಸತ್ತಿತು. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/><note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">ರೋಮಾ. 2:28, ಗಲಾ. 5:6</char></note>ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಳ್ಳುವುದೋ ಅಥವಾ ಮಾಡಿಸಿಕೊಳ್ಳದಿರುವುದೋ ಏನು ಅಲ್ಲ, ಆದರೆ <note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">ಯೋಹಾ 3:5-7, ರೋಮಾ. 6:4, 2 ಕೊರಿ 5:17</char></note>ಹೊಸ ಸೃಷ್ಟಿಯಾಗುವುದೇ ಪ್ರಮುಖವಾದುದು. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>ಈ ನಿಯಮಗಳನ್ನು ಸರಿಯಾಗಿ ನಡೆಯುವವರೆಲ್ಲರಿಗೂ ಮತ್ತು ದೇವರ <note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">ಗಲಾ. 3:7-9,29; ರೋಮಾ. 2:29, 4:12, 9:6-8</char></note>ಇಸ್ರಾಯೇಲ್ಯರಿಗೆ ಶಾಂತಿಯೂ, ಕರುಣೆಯೂ ಉಂಟಾಗಲಿ.<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>ಇನ್ನು ಮೇಲೆ ಯಾರೂ ನನಗೆ ತೊಂದರೆಪಡಿಸಬಾರದು, <note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">ಯೆಶಾ 44:5, ಯೆಹೆ. 9:4, ಪ್ರಕ 13:16</char></note>ನನ್ನ ದೇಹದಲ್ಲಿ ಯೇಸುಕ್ರಿಸ್ತನ ಗುರುತುಗಳನ್ನು ಮುದ್ರಿಸಿಕೊಂಡಿದ್ದೇನೆ. <verse eid="GAL 6:17"/><verse number="18" style="v" sid="GAL 6:18"/>ಸಹೋದರರೇ, <note caller="+" style="f"><char style="fr" closed="false">6:18 </char><char style="ft" closed="false">ಫಿಲೆ. 25, ರೋಮಾ. 16:20</char></note>ನಮ್ಮ ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನ ಕೃಪೆಯು <note caller="+" style="f"><char style="fr" closed="false">6:18 </char><char style="ft" closed="false">2 ತಿಮೊ. 4:22</char></note>ನಿಮ್ಮ ಆತ್ಮದೊಂದಿಗಿರಲಿ. ಆಮೆನ್.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
