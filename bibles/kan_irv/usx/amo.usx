<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright © 2017 Bridge Connectivity Solutions. This translation is made available to you under the terms of the Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">ಆಮೋಸನು</para>
  <para style="toc1">ಆಮೋಸನು</para>
  <para style="toc2">ಆಮೋ</para>
  <para style="toc3">ಆಮೋ</para>
  <para style="mt">ಆಮೋಸನು</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಆಮೋಸ 1:1 ಪ್ರವಾದಿಯಾದ ಆಮೋಸನನ್ನು ಆಮೋಸ ಗ್ರಂಥದ ಗ್ರಂಥಕರ್ತನು ಎಂದು ಗುರುತಿಸುತ್ತದೆ. ಪ್ರವಾದಿಯಾದ ಆಮೋಸನು ತೆಕೋವದಲ್ಲಿದ್ದ ಕುರುಬರ ಗುಂಪಿನ ಮಧ್ಯದಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದನು. ಆಮೋಸನು ತನ್ನ ಬರಹಗಳಲ್ಲಿ ತಾನು ಪ್ರವಾದಿಗಳ ಕುಟುಂಬದಿಂದ ಬಂದವನಲ್ಲವೆಂದು, ಅಥವಾ ತಾನು ಅವರಲ್ಲಿ ಒಬ್ಬನೆಂದು ಪರಿಗಣಿಸಲ್ಪಡುವುದಿಲ್ಲವೆಂದು ಸ್ಪಷ್ಟಪಡಿಸಿದನು. ದೇವರು ಮಿಡತೆಗಳಿಂದ ಮತ್ತು ಬೆಂಕಿಯಿಂದ ನ್ಯಾಯತೀರ್ಪು ಮಾಡುವುದಾಗಿ ಬೆದರಿಸಿದನು, ಆದರೆ ಆಮೋಸನ ಪ್ರಾರ್ಥನೆಗಳು ಇಸ್ರಾಯೇಲ್ಯರನ್ನು ಕಾಪಾಡಿದವು.</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿ.ಪೂ. 760-750 ರ ನಡುವಿನ ಕಾಲದಲ್ಲಿ ಬರೆದಿರಬಹುದು.</para>
  <para style="ip">ಆಮೋಸನು ಇಸ್ರಾಯೇಲಿನ ಉತ್ತರದ ರಾಜ್ಯದಲ್ಲಿ, ಬೇತೇಲ್ ಮತ್ತು ಸಮಾರ್ಯದಿಂದ ಬೋಧಿಸಿದನು.</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಆಮೋಸನ ಮೂಲ ಪ್ರೇಕ್ಷಕರು ಇಸ್ರಾಯೇಲಿನ ಉತ್ತರ ರಾಜ್ಯದವರು ಮತ್ತು ಭವಿಷ್ಯದಲ್ಲಿ ಓದುಗಾರರು.</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ದೇವರು ಆಹಂಕಾರವನ್ನು ದ್ವೇಷಿಸುತ್ತಾನೆ. ಜನರು ತಾವು ಸ್ವಯಂ-ಸಮರ್ಥರಾಗಿದ್ದರೆಂದು ನಂಬಿದ್ದರು ಮತ್ತು ಅವರಿಗಿರುವಂಥದ್ದೆಲ್ಲವು ದೇವರಿಂದ ಬಂದದ್ದು ಎಂಬುದನ್ನು ಮರೆತುಹೋಗಿದ್ದರು. ನೀಡುವಂತೆ ದೇವರು ಎಲ್ಲ ಜನರನ್ನು ಗೌರವಿಸುತ್ತಾನೆ, ಬಡವರನ್ನು ಹೀನಾಯವಾಗಿ ನಡೆಸಿಕೊಳ್ಳುವರಿಗೆ ಎಚ್ಚರಿಕೆ ನೀಡಿದನು. ಅಂತಿಮವಾಗಿ, ಆತನನ್ನು ಗೌರವಿಸುವಂತಹ ವರ್ತನೆಯೊಂದಿಗಿನ ಯಥಾರ್ಥವಾದ ಆರಾಧನೆಯನ್ನು ದೇವರು ಬಯಸುತ್ತಾನೆ. ಆಮೋಸನ ಮೂಲಕ ಬಂದ ದೇವರ ವಾಕ್ಯವು, ತಮ್ಮ ನೆರೆಯವರಿಗಾಗಿ ಪ್ರೀತಿ ಇಲ್ಲದಂಥ ಜನರಾದ, ಇತರರನ್ನು ಶೋಷಿಸುವಂಥವವರಾದ, ಮತ್ತು ತಮ್ಮ ಸ್ವಂತ ಕಾಳಜಿಯನ್ನು ಮಾತ್ರ ನೋಡಿಕೊಳ್ಳುವವರಾದ ಸವಲತ್ತವುಳ್ಳ ಇಸ್ರಾಯೇಲ್ ಜನರಿಗೆ ವಿರುದ್ಧವಾಗಿದೆ.</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ನ್ಯಾಯತೀರ್ಪು</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ದೇಶಗಳ ಮೇಲೆ ನಾಶನ — 1:1-2:16</para>
  <para style="io1">2. ಪ್ರವಾದನಾತ್ಮಕವಾದ ಕರೆ — 3:1-8</para>
  <para style="io1">3. ಇಸ್ರಾಯೇಲಿನ ನ್ಯಾಯತೀರ್ಪು — 3:9-9:10</para>
  <para style="io1">4. ಪುನಃಸ್ಥಾಪನೆ — 9:11-15</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>ಯೆಹೂದದ ಅರಸನಾದ ಉಜ್ಜೀಯನ ಕಾಲದಲ್ಲಿ ಇಸ್ರಾಯೇಲಿನ ಅರಸನೂ, ಯೋವಾಷನ ಮಗನೂ ಆದ ಯಾರೊಬ್ಬಾಮನ ಕಾಲದಲ್ಲಿ ಭೂಕಂಪಕ್ಕೆ ಎರಡು ವರ್ಷಗಳ ಮೊದಲೇ ತೆಕೋವದ ಕುರುಬರಲ್ಲಿ ಒಬ್ಬನಾದ ಆಮೋಸನಿಗೆ ಇಸ್ರಾಯೇಲಿನ ವಿಷಯವಾಗಿ ಕೇಳಿಬಂದ ದೈವೋಕ್ತಿಗಳು.<verse eid="AMO 1:1"/></para>
  <para style="s">ಯೆಹೋವನ ಗರ್ಜನೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>ಆಮೋಸನು ಹೀಗೆ ಪ್ರಕಟಿಸಿದನು,</para>
  <para style="q" vid="AMO 1:2">“ಯೆಹೋವನು ಚೀಯೋನಿನಿಂದ ಗರ್ಜಿಸಿ,</para>
  <para style="q" vid="AMO 1:2">ಯೆರೂಸಲೇಮಿನಿಂದ ಧ್ವನಿಗೈಯುವನು.</para>
  <para style="q" vid="AMO 1:2">ಆಗ ಕುರುಬರ ಹುಲ್ಲುಗಾವಲುಗಳು ಬಾಡಿಹೋಗುವವು.</para>
  <para style="q" vid="AMO 1:2">ಕರ್ಮೆಲ್ ಬೆಟ್ಟದ ತುದಿಯು ಒಣಗಿಹೋಗುವವು.”<verse eid="AMO 1:2"/></para>
  <para style="s">ದಮಸ್ಕದ ಪಾಪಕ್ಕೆ ದಂಡನೆ</para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 1:3"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 1:3">“ದಮಸ್ಕವು ಬಹಳ ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 1:3">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="AMO 1:3">ಏಕೆಂದರೆ ಅದು ಗಿಲ್ಯಾದನ್ನು ಕಬ್ಬಿಣದ ಹಂತಿ ಕುಂಟೆಗಳಿಂದ ಒಕ್ಕಿ ನುಗ್ಗುಮಾಡಿತಷ್ಟೆ.<verse eid="AMO 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 1:4"/>ನಾನು ಹಜಾಯೇಲನ ವಂಶದ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಸುರಿಸುವೆನು.</para>
  <para style="q" vid="AMO 1:4">ಅದು ಬೆನ್ಹದದನ ಅರಮನೆಯನ್ನು ನುಂಗಿಬಿಡುವುದು.<verse eid="AMO 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 1:5"/>ನಾನು ದಮಸ್ಕದ ಹೆಬ್ಬಾಗಿಲುಗಳನ್ನು ಮುರಿಯುವೆನು</para>
  <para style="q" vid="AMO 1:5">ಮತ್ತು ಆವೆನ್ ತಗ್ಗಿನೊಳಗಿನಿಂದ ನಿವಾಸಿಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">ನಿವಾಸಿಗಳನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಸಿಂಹಾಸನರೂಢನಾಗಿರುವವನನ್ನು.</char></note> ಮತ್ತು</para>
  <para style="q" vid="AMO 1:5">ಬೇತ್ ಎದೆನ್ ಪಟ್ಟಣದ ಆಡಳಿತಾಧಿಕಾರಿಯನ್ನು ನಿರ್ಮೂಲಮಾಡುವೆನು;</para>
  <para style="q" vid="AMO 1:5">ಅರಾಮ್ಯರು ಕೀರ್ ಪಟ್ಟಣಕ್ಕೆ ಸೆರೆಯಾಗಿ ಹೋಗುವರು.”</para>
  <para style="q" vid="AMO 1:5">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 1:5"/></para>
  <para style="s">ಫಿಲಿಷ್ಟಿಯದ ಪಾಪಕ್ಕೆ ಆದ ದಂಡನೆ</para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 1:6"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 1:6">“ಗಾಜವು ಬಹಳ ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 1:6">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ,</para>
  <para style="q" vid="AMO 1:6">ಏಕೆಂದರೆ ಅದು ಜನರನ್ನು ಗುಂಪುಗುಂಪಾಗಿ ಸೆರೆಹಿಡಿದು ಎದೋಮಿಗೆ ವಶಮಾಡಿಬಿಟ್ಟಿತು.<verse eid="AMO 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 1:7"/>ನಾನು ಗಾಜದ ಕೋಟೆಯ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಸುರಿಸುವೆನು,</para>
  <para style="q" vid="AMO 1:7">ಅದು ಅದರ ಅರಮನೆಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು.<verse eid="AMO 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 1:8"/>ನಾನು ಅಷ್ದೋದಿನೊಳಗಿಂದ ಸಿಂಹಾಸನಾಸೀನನನ್ನೂ</para>
  <para style="q" vid="AMO 1:8">ಮತ್ತು ಅಷ್ಕೆಲೋನಿನೊಳಗಿಂದ ರಾಜದಂಡ ದಾರಿಯನ್ನೂ ನಿರ್ಮೂಲಮಾಡುವೆನು.</para>
  <para style="q" vid="AMO 1:8">ನಾನು ಎಕ್ರೋನಿನ ವಿರುದ್ಧವಾಗಿ ಕೈಯೆತ್ತುವೆನು,</para>
  <para style="q" vid="AMO 1:8">ಉಳಿದ ಫಿಲಿಷ್ಟಿಯರೆಲ್ಲರೂ ನಾಶವಾಗಿ ಹೋಗುವರು.”</para>
  <para style="q" vid="AMO 1:8">ಇದು ಕರ್ತನಾದ ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 1:8"/></para>
  <para style="s">ತೂರಿನ ಪಾಪಕ್ಕೆ ಆದ ದಂಡನೆ</para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 1:9"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ:</para>
  <para style="q" vid="AMO 1:9">“ತೂರ್ ಪಟ್ಟಣವು ಬಹಳ ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 1:9">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="AMO 1:9">ಏಕೆಂದರೆ ಅದು ಒಡಹುಟ್ಟಿದವರ ಒಡಂಬಡಿಕೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳದೇ,</para>
  <para style="q" vid="AMO 1:9">ಜನರನ್ನು ಗುಂಪುಗುಂಪಾಗಿ ಎದೋಮಿಗೆ ವಶಮಾಡಿಬಿಟ್ಟಿತು.<verse eid="AMO 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 1:10"/>ನಾನು ತೂರಿನ ಕೋಟೆಯ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಸುರಿಸುವೆನು,</para>
  <para style="q" vid="AMO 1:10">ಮತ್ತು ಅದು ಅದರ ಅರಮನೆಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು.”<verse eid="AMO 1:10"/></para>
  <para style="s">ಎದೋಮಿನ ಪಾಪಕ್ಕೆ ಆದ ದಂಡನೆ</para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 1:11"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ:</para>
  <para style="q" vid="AMO 1:11">“ಎದೋಮ್ ಬಹಳ ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 1:11">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="AMO 1:11">ಏಕೆಂದರೆ ಅವನು ಕತ್ತಿ ಹಿಡಿದು ತನ್ನ ಸಹೋದರರನ್ನು ಹಿಂದಟ್ಟಿದನು,</para>
  <para style="q" vid="AMO 1:11">ಕರುಣೆಯನ್ನು ತೋರಿಸಲಿಲ್ಲ. ರೋಷವನ್ನು ಸಾಧಿಸಿದ್ದಾರೆ.</para>
  <para style="q" vid="AMO 1:11">ಇದರಿಂದ ಅವನ ಕೋಪವು ಸದಾ ಹರಿಯುತ್ತಿತ್ತು,</para>
  <para style="q" vid="AMO 1:11">ಆತನು ರೌದ್ರವನ್ನು ನಿರಂತರವಾಗಿ ಇಟ್ಟುಕೊಂಡನು.<verse eid="AMO 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 1:12"/>ನಾನು ತೇಮಾನಿನ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಸುರಿಸುವೆನು,</para>
  <para style="q" vid="AMO 1:12">ಮತ್ತು ಅದು ಬೊಚ್ರದ ಅರಮನೆಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು.”<verse eid="AMO 1:12"/></para>
  <para style="s">ಅಮ್ಮೋನಿನ ಪಾಪಕ್ಕೆ ಆದ ದಂಡನೆ</para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 1:13"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 1:13">“ಅಮ್ಮೋನ್ಯರು ಬಹಳ ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 1:13">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="AMO 1:13">ಏಕೆಂದರೆ ಅವರು ತಮ್ಮ ದೇಶವನ್ನು ವಿಸ್ತರಿಸಬೇಕೆಂದು</para>
  <para style="q" vid="AMO 1:13">ಗಿಲ್ಯಾದಿನ ಗರ್ಭಿಣಿಯರ ಹೊಟ್ಟೆಯನ್ನು ಸೀಳಿಬಿಟ್ಟರು.<verse eid="AMO 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 1:14"/>ನಾನು ರಬ್ಬದ ಕೋಟೆಯನ್ನು ಬೆಂಕಿಯಿಂದ ಉರಿಸುವೆನು,</para>
  <para style="q" vid="AMO 1:14">ಅದು ಅದರ ಅರಮನೆಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು;</para>
  <para style="q" vid="AMO 1:14">ಆ ಯುದ್ಧದ ದಿನದಲ್ಲಿ ಆರ್ಭಟವಾಗುವುದು,</para>
  <para style="q" vid="AMO 1:14">ಆ ಸುಂಟರಗಾಳಿಯಂತ ದಿನದಲ್ಲಿ ಪ್ರಚಂಡ ಕಾದಾಟವೂ ಉಂಟಾಗುವುದು.<verse eid="AMO 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 1:15"/>ಅವರ ಅರಸನೂ ಮತ್ತು ಅವನ ರಾಜ್ಯಾಧಿಕಾರಗಳೂ ಒಟ್ಟಿಗೆ ಸೆರೆಯಾಗಿ ಹೋಗುವರು.”</para>
  <para style="q" vid="AMO 1:15">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="s">ಮೋವಾಬಿನ ಪಾಪಕ್ಕೆ ಆದ ದಂಡನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 2:1">“ಮೋವಾಬಿನವರು ಬಹಳ ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 2:1">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="AMO 2:1">ಅದು ಎದೋಮಿನ ಅರಸನ ಎಲುಬುಗಳನ್ನು ಸುಟ್ಟು ಬೂದಿಮಾಡಿತು.<verse eid="AMO 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 2:2"/>ನಾನು ಮೋವಾಬಿನ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಸುರಿಸುವೆನು,</para>
  <para style="q" vid="AMO 2:2">ಅದು ಕೆರೀಯೋತಿನ ಅರಮನೆಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು.</para>
  <para style="q" vid="AMO 2:2">ಭಟರು ಘೋಷಿಸಿ ಕೊಂಬೂದುವ ಯುದ್ಧದ ಕೋಲಾಹಲದಲ್ಲಿ,</para>
  <para style="q" vid="AMO 2:2">ಮೋವಾಬು ಸಾಯುವುದು;<verse eid="AMO 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 2:3"/>ನಾನು ಅದರೊಳಗಿಂದ ಅಧಿಪತಿಯನ್ನು ಕಡಿದುಹಾಕಿ,</para>
  <para style="q" vid="AMO 2:3">ಸಕಲ ರಾಜ್ಯಾಧಿಕಾರಿಗಳನ್ನೂ ಸಂಹರಿಸುವೆನು.”</para>
  <para style="q" vid="AMO 2:3">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 2:3"/></para>
  <para style="s">ಯೆಹೂದದ ಪಾಪಕ್ಕೆ ಆದ ದಂಡನೆ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 2:4">“ಯೆಹೂದವು ಮೂರು ದ್ರೋಹಗಳನ್ನು,</para>
  <para style="q" vid="AMO 2:4">ಹೌದು ನಾಲ್ಕು ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 2:4">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="AMO 2:4">ಏಕೆಂದರೆ ಯೆಹೂದ್ಯರು ಯೆಹೋವನ ಧರ್ಮೋಪದೇಶವನ್ನು ನಿರಾಕರಿಸಿದರು.</para>
  <para style="q" vid="AMO 2:4">ಆತನ ವಿಧಿಗಳನ್ನು ಕೈಕೊಳ್ಳಲಿಲ್ಲ.</para>
  <para style="q" vid="AMO 2:4">ಅವರ ಪೂರ್ವಿಕರು ಹಿಂಬಾಲಿಸಿದ ಸುಳ್ಳುದೇವತೆಗಳು,</para>
  <para style="q" vid="AMO 2:4">ಇವರನ್ನು ದಾರಿ ತಪ್ಪುವಂತೆ ಮಾಡಿದವು.<verse eid="AMO 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 2:5"/>ಆದಕಾರಣ ನಾನು ಯೆಹೂದದ ಮೇಲೆ ಬೆಂಕಿಯನ್ನು ಉರಿಸುವೆನು.</para>
  <para style="q" vid="AMO 2:5">ಅದು ಯೆರೂಸಲೇಮಿನ ಅರಮನೆಗಳನ್ನು ನುಂಗಿಬಿಡುವುದು.”<verse eid="AMO 2:5"/></para>
  <para style="s">ಇಸ್ರಾಯೇಲಿನ ಪಾಪಕ್ಕೆ ಆದ ದಂಡನೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 2:6">“ಇಸ್ರಾಯೇಲರು ಮೂರು ದ್ರೋಹಗಳನ್ನು,</para>
  <para style="q" vid="AMO 2:6">ಹೌದು ನಾಲ್ಕು ದ್ರೋಹಗಳನ್ನು ಮಾಡಿದ್ದರಿಂದ,</para>
  <para style="q" vid="AMO 2:6">ಅದಕ್ಕಾಗುವ ದಂಡನೆಯನ್ನು ನಾನು ತಪ್ಪಿಸುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="AMO 2:6">ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲರು ನ್ಯಾಯವಂತನನ್ನು ಬೆಳ್ಳಿಗೆ,</para>
  <para style="q" vid="AMO 2:6">ಒಂದು ಜೊತೆ ಕೆರದ ಸಾಲಕ್ಕಾಗಿ ದಿಕ್ಕಿಲ್ಲದವನನ್ನು ಮಾರಿದರು.<verse eid="AMO 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 2:7"/>ಬಡವರ ತಲೆಗಳನ್ನು ನೆಲದ ಧೂಳಿನಂತೆ ತುಳಿದು ಬಿಡುತ್ತಾರೆ,</para>
  <para style="q" vid="AMO 2:7">ದೀನರ ದಾರಿಗೆ ಅಡ್ಡ ಹಾಕುತ್ತಾರೆ.</para>
  <para style="q" vid="AMO 2:7">ಮಗನೂ ಮತ್ತು ತಂದೆಯೂ ಒಬ್ಬಳಲ್ಲಿ ಹೋಗಿ ನನ್ನ ಪವಿತ್ರ ನಾಮವನ್ನು ಅಪಕೀರ್ತಿಗೆ ಗುರಿಮಾಡುತ್ತಾರೆ.<verse eid="AMO 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 2:8"/>ಒಂದೊಂದು ಯಜ್ಞವೇದಿಯ ಹತ್ತಿರದಲ್ಲಿಯೂ ಅಡವು ಇಟ್ಟ ಬಟ್ಟೆಗಳ ಮೇಲೆ ಮಲಗಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="AMO 2:8">ದಂಡಹಾಕಿಸಿಕೊಂಡವರು ದ್ರಾಕ್ಷಾರಸವನ್ನು ತಮ್ಮ ದೇವರ ಮಂದಿರದಲ್ಲಿಯೂ ಕುಡಿಯುತ್ತಾರೆ.<verse eid="AMO 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 2:9"/>ಆಹಾ, ಅವರಿಗೆ ಎದುರಾಗಿ ನಿಂತ ಅಮೋರಿಯರನ್ನು ನಾನೇ ಧ್ವಂಸಮಾಡಿದೆನು,</para>
  <para style="q" vid="AMO 2:9">ಆ ಶತ್ರುವು ದೇವದಾರು ಮರದಷ್ಟು ಎತ್ತರವಾಗಿ,</para>
  <para style="q" vid="AMO 2:9">ಅಲ್ಲೋನ್ ಮರದ ಹಾಗೆ ಬಲಿಷ್ಠವಾಗಿಯೂ ಇದ್ದರು.</para>
  <para style="q" vid="AMO 2:9">ಆದರೂ ಮರದ ಮೇಲಿನ ಅದರ ಫಲವನ್ನು,</para>
  <para style="q" vid="AMO 2:9">ಕೆಳಗೆ ಅದರ ಬುಡವನ್ನು ನಾಶಪಡಿಸಿದೆನು.<verse eid="AMO 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 2:10"/>ಇಸ್ರಾಯೇಲ್ಯರೇ, ನೀವು ಅಮ್ಮೋನಿಯರ ದೇಶವನ್ನು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳಲು,</para>
  <para style="q" vid="AMO 2:10">ನಾನು ನಿಮ್ಮನ್ನು ಐಗುಪ್ತ ದೇಶದೊಳಗಿಂದ ಪಾರುಮಾಡಿ,</para>
  <para style="q" vid="AMO 2:10">ನಲ್ವತ್ತು ವರ್ಷ ಅರಣ್ಯದಲ್ಲಿ ನಿಮ್ಮನ್ನು ನಡೆಸಿದೆನು.<verse eid="AMO 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 2:11"/>ನಿಮ್ಮ ಪುತ್ರರಲ್ಲಿ ಪ್ರವಾದಿಗಳನ್ನೂ</para>
  <para style="q" vid="AMO 2:11">ಮತ್ತು ನಿಮ್ಮ ಯುವಕರಲ್ಲಿ ಪ್ರತಿಷ್ಠಿತರನ್ನೂ ಎಬ್ಬಿಸಿದೆನು.</para>
  <para style="q" vid="AMO 2:11">ಇಸ್ರಾಯೇಲಿನ ಜನರೇ,</para>
  <para style="q" vid="AMO 2:11">ಇದು ಸತ್ಯವಲ್ಲವೋ?”</para>
  <para style="q" vid="AMO 2:11">ಎಂದು ಯೆಹೋವನು ಅನ್ನುತ್ತಾನೆ.<verse eid="AMO 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 2:12"/>“ಆದರೆ ನೀವೋ ಪ್ರತಿಷ್ಠಿತರಿಗೆ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯಲು ಕೊಟ್ಟಿರಿ</para>
  <para style="q" vid="AMO 2:12">ಮತ್ತು ಪ್ರವಾದಿಗಳಿಗೆ ಪ್ರವಾದಿಸಬೇಡಿರೆಂದು ಆಜ್ಞಾಪಿಸಿದ್ದಿರಿ.<verse eid="AMO 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 2:13"/>ಇಗೋ, ನೀವು ನಿಂತಿರುವಲ್ಲಿಯೇ ನಿಮ್ಮನ್ನು ಸಿವುಡು ತುಂಬಿದ ಬಂಡಿ ಒತ್ತುವ ಪ್ರಕಾರ</para>
  <para style="q" vid="AMO 2:13">ನಾನು ನಿಮ್ಮನ್ನು ಕೆಳಗೆ ಹಾಕಿ ಒತ್ತುವೆನು.<verse eid="AMO 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 2:14"/>ತ್ವರೆಯಾಗಿ ಓಡುವವನು ತಪ್ಪಿಸಿಕೊಳ್ಳಲಾರನು.</para>
  <para style="q" vid="AMO 2:14">ಬಲಿಷ್ಠನು ತನ್ನ ಬಲವನ್ನು, ತನ್ನ ಪ್ರಾಣವನ್ನು ಬಲಪಡಿಸಿಕೊಳ್ಳಲಾರನು.</para>
  <para style="q" vid="AMO 2:14">ಪರಾಕ್ರಮಿಯು ತನ್ನ ಪ್ರಾಣವನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲಾರನು.<verse eid="AMO 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 2:15"/>ಬಿಲ್ಲು ಹಿಡಿಯುವವನು ಭೂಮಿಯ ಮೇಲೆ ನಿಲ್ಲಲಾರನು,</para>
  <para style="q" vid="AMO 2:15">ಪಾದತ್ವರಿತನು ತಪ್ಪಿಸಿಕೊಳ್ಳಲಾರನು,</para>
  <para style="q" vid="AMO 2:15">ಅಶ್ವಾರೂಢನು ತನ್ನ ಪ್ರಾಣವನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲಾರನು.<verse eid="AMO 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 2:16"/>ಆ ದಿನದಲ್ಲಿ ಶೂರರಲ್ಲಿ ಧೀರನಾದವನು</para>
  <para style="q" vid="AMO 2:16">ಬೆತ್ತಲೆಯಾಗಿ ಓಡಿಹೋಗುವನು” ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s">ಇಸ್ರಾಯೇಲಿನ ವಿವಿಧ ಪಾಪಕ್ಕೆ ಆದ ಘೋರ ದುರ್ಗತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>ಇಸ್ರಾಯೇಲರೇ ಯೆಹೋವನು ನಿಮಗೆ ವಿರುದ್ಧವಾಗಿ, ತಾನು ಐಗುಪ್ತ ದೇಶದೊಳಗಿಂದ ಪಾರು ಮಾಡಿದ ಪೂರ್ಣಕುಲಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ನುಡಿದಿರುವ ಈ ಮಾತನ್ನು ಕೇಳಿರಿ,<verse eid="AMO 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 3:2"/>ಭೂಮಿಯ ಸಕಲ ಕುಲಗಳೊಳಗೆ</para>
  <para style="q" vid="AMO 3:2">ನಿಮ್ಮನ್ನು ಮಾತ್ರ ನನ್ನವರೆಂದು ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q" vid="AMO 3:2">ಆದಕಾರಣ ನಿಮ್ಮ ಎಲ್ಲಾ ಪಾಪಗಳ ಫಲವನ್ನು</para>
  <para style="q" vid="AMO 3:2">ನೀವು ಅನುಭವಿಸುವಂತೆ ಮಾಡುವೆನು.<verse eid="AMO 3:2"/></para>
  <para style="s">ಪ್ರವಾದಿಯು ನಿಷ್ಕಾರಣವಾಗಿ ಖಂಡಿಸನು</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3"/>ಗೊತ್ತುಮಾಡಿಕೊಳ್ಳದೆ ಯಾರಾದರಿಬ್ಬರು</para>
  <para style="q" vid="AMO 3:3">ಜೊತೆಯಾಗಿ ನಡೆಯುವುದುಂಟೆ?<verse eid="AMO 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 3:4"/>ಬೇಟೆಯ ಬಲಿ ಕಾಣದೇ ಸಿಂಹವು</para>
  <para style="q" vid="AMO 3:4">ಅರಣ್ಯದಲ್ಲಿ ಗರ್ಜಿಸುವುದೋ?</para>
  <para style="q" vid="AMO 3:4">ಏನನ್ನೂ ಬೇಟೆಯಾಡದೆ</para>
  <para style="q" vid="AMO 3:4">ಪ್ರಾಯದ ಸಿಂಹವು ಗವಿಯಲ್ಲಿ ಕುಳಿತು ಗುರುಗುಟ್ಟುವುದೋ?<verse eid="AMO 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 3:5"/>ಕಾಳಿಲ್ಲದೆ ಪಕ್ಷಿಯು</para>
  <para style="q" vid="AMO 3:5">ನೆಲದಲ್ಲಿನ ಬಲೆಯೊಳಗೆ ಬೀಳುವುದೋ?</para>
  <para style="q" vid="AMO 3:5">ಏನೂ ಬಲೆಗೆ ಸಿಕ್ಕಿಕೊಳ್ಳದೇ ಬೋನು ಉರುಲಾಗುವುದೋ?<verse eid="AMO 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 3:6"/>ಪಟ್ಟಣದಲ್ಲಿ ಕೊಂಬನ್ನು ಊದಿದರೆ</para>
  <para style="q" vid="AMO 3:6">ಜನರು ಹೆದರುವುದಿಲ್ಲವೋ?</para>
  <para style="q" vid="AMO 3:6">ಯೆಹೋವನಿಂದಲ್ಲದೆ</para>
  <para style="q" vid="AMO 3:6">ಪಟ್ಟಣಕ್ಕೆ ವಿಪತ್ತು ಸಂಭವಿಸುವುದೋ?<verse eid="AMO 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 3:7"/>ನಿಶ್ಚಯವಾಗಿ ತನ್ನ ಸೇವಕರಾದ ಪ್ರವಾದಿಗಳಿಗೆ ತನ್ನ ಯೋಜನೆಯನ್ನು ತಿಳಿಸದೆ</para>
  <para style="q" vid="AMO 3:7">ಯೆಹೋವನಾದ ದೇವರು ಏನನ್ನೂ ಮಾಡುವುದಿಲ್ಲ.<verse eid="AMO 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 3:8"/>ಸಿಂಹವು ಗರ್ಜಿಸಿದರೆ,</para>
  <para style="q" vid="AMO 3:8">ಭಯಪಡದೆ ಇರುವವರು ಯಾರು?</para>
  <para style="q" vid="AMO 3:8">ಕರ್ತನಾದ ಯೆಹೋವನು ನುಡಿದಿದ್ದಾನೆ,</para>
  <para style="q" vid="AMO 3:8">ಆ ನುಡಿಯನ್ನು ಕೇಳಿ ಪ್ರವಾದಿಸದವರು ಯಾರು?<verse eid="AMO 3:8"/></para>
  <para style="s">ಸಮಾರ್ಯ ಪಟ್ಟಣದ ಧ್ವಂಸ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9"/>ಅಷ್ದೋದಿನ ಅರಮನೆಗಳಲ್ಲಿಯೂ,</para>
  <para style="q" vid="AMO 3:9">ಐಗುಪ್ತ ದೇಶದ ಅರಮನೆಗಳಲ್ಲಿಯೂ ಹೀಗೆ ಪ್ರಕಟಿಸಿರಿ,</para>
  <para style="q" vid="AMO 3:9">“ಸಮಾರ್ಯದ ಬೆಟ್ಟಗಳಲ್ಲಿ ಕೂಡಿಬನ್ನಿರಿ.</para>
  <para style="q" vid="AMO 3:9">ಪಟ್ಟಣದೊಳಗೆ ಇರುವ ಗದ್ದಲವನ್ನು,</para>
  <para style="q" vid="AMO 3:9">ಅದರೊಳಗಿರುವ ಹಿಂಸೆಯನ್ನೂ ನೋಡಿರಿ.<verse eid="AMO 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 3:10"/>ನ್ಯಾಯನೀತಿಗಳನ್ನು ಮಾಡುವುದಕ್ಕೆ ಅವರಿಗೆ ತಿಳಿದಿಲ್ಲ”</para>
  <para style="q" vid="AMO 3:10">ಇದು ಯೆಹೋವನ ನುಡಿ.</para>
  <para style="q" vid="AMO 3:10">ತಮ್ಮ ಉಪ್ಪರಿಗೆಗಳಲ್ಲಿ ಬಾಧೆಯನ್ನೂ,</para>
  <para style="q" vid="AMO 3:10">ನಾಶನವನ್ನೂ ಕೂಡಿಸಿಟ್ಟುಕೊಂಡಿದ್ದಾರೆ.<verse eid="AMO 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 3:11"/>ಹೀಗಿರಲು, ಕರ್ತನಾದ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ:</para>
  <para style="q" vid="AMO 3:11">“ಶತ್ರುವು ನಿನ್ನ ದೇಶವನ್ನು ಮುತ್ತಿಕೊಳ್ಳುವನು.</para>
  <para style="q" vid="AMO 3:11">ನಿನ್ನ ಶಕ್ತಿಯನ್ನು ಕುಂದಿಸಿಬಿಡುವನು</para>
  <para style="q" vid="AMO 3:11">ಮತ್ತು ನಿನ್ನ ಅರಮನೆಗಳು ಸೂರೆಯಾಗುವವು.”<verse eid="AMO 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 3:12"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ:</para>
  <para style="q" vid="AMO 3:12">“<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">ಕಾಡುಮೃಗಗಳು ಪ್ರಾಣಿಗಳನ್ನು ಕೊಂದಾಗ ಅದು ಹೇಗೆ ಕೊಲ್ಲಲ್ಪಟ್ಟಿತ್ತು ಎಂದು ಮಾಲೀಕರಿಗೆ ತೋರಿಸುವುದಕ್ಕಾಗಿ ಪ್ರಾಣಿಗಳ ಕೆಲವು ಅವಶೇಷಗಳನ್ನು ತರುವುದು ಕುರುಬನ ಕರ್ತವ್ಯವಾಗಿತ್ತು.</char></note>ಸಿಂಹದ ಬಾಯೊಳಗಿಂದ ಕುರುಬನು ತನ್ನ ಕುರಿಗಳ ಎರಡು ಕಾಲನ್ನೂ,</para>
  <para style="q" vid="AMO 3:12">ಅಥವಾ ಕಿವಿಯ ಒಂದು ತುಂಡನ್ನೂ,</para>
  <para style="q" vid="AMO 3:12">ಹೇಗೆ ರಕ್ಷಿಸುವನೋ, ಹಾಗೆಯೇ ಸಮಾರ್ಯದೊಳಗೆ ಹಾಸಿಗೆಯ ಮೂಲೆಯಲ್ಲಿಯೂ,</para>
  <para style="q" vid="AMO 3:12">ಮಂಚದ ಪಟ್ಟೇದಿಂಬುಗಳಲ್ಲಿಯೂ,</para>
  <para style="q" vid="AMO 3:12">ಒರಗಿಕೊಳ್ಳುವ ಇಸ್ರಾಯೇಲರ ಸ್ವಲ್ಪ ಭಾಗ ಮಾತ್ರ ರಕ್ಷಿಸಲ್ಪಡುವುದು.”<verse eid="AMO 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 3:13"/>ಸೇನಾಧೀಶ್ವರ ದೇವನಾದ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ;</para>
  <para style="q" vid="AMO 3:13">ಕೇಳಿರಿ, ಯಾಕೋಬ ವಂಶದವರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿಕೊಡಿರಿ.<verse eid="AMO 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 3:14"/>“ನಾನು ಇಸ್ರಾಯೇಲಿನ ದ್ರೋಹಗಳಿಗಾಗಿ ಅವರನ್ನು ಶಿಕ್ಷಿಸುವ ದಿನಗಳಲ್ಲಿ,</para>
  <para style="q" vid="AMO 3:14">ಬೇತೇಲಿನ ಯಜ್ಞವೇದಿಗಳನ್ನು ಧ್ವಂಸಮಾಡುವೆನು.</para>
  <para style="q" vid="AMO 3:14">ಯಜ್ಞವೇದಿಯ ಕೊಂಬುಗಳು ಕಡಿಯಲ್ಪಟ್ಟು</para>
  <para style="q" vid="AMO 3:14">ನೆಲದ ಮೇಲೆ ಉರುಳುವವು.<verse eid="AMO 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 3:15"/>ನಾನು ಚಳಿಗಾಲದ ಅರಮನೆಯನ್ನೂ,</para>
  <para style="q" vid="AMO 3:15">ಬೇಸಿಗೆಯ ಅರಮನೆಯನ್ನೂ ಹೊಡೆದುಹಾಕುವೆನು.</para>
  <para style="q" vid="AMO 3:15">ದಂತಮಂದಿರಗಳು ಹಾಳಾಗುವವು</para>
  <para style="q" vid="AMO 3:15">ಮತ್ತು ದೊಡ್ಡಮನೆಗಳು ಕೊನೆಗಾಣುವವು”</para>
  <para style="q" vid="AMO 3:15">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s">ಸಮಾರ್ಯದ ಸ್ತ್ರೀಯರ ಖಂಡನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1"/>ಸಮಾರ್ಯ ಬೆಟ್ಟದಲ್ಲಿನ,</para>
  <para style="q" vid="AMO 4:1">ಬಾಷಾನಿನ<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">ಬಾಷಾನಿನ </char><char style="ft" closed="false">ಅಂದರೆ ಬಹಳ ಫಲವತ್ತಾದ ಭೂಮಿ.</char></note> ಕೊಬ್ಬಿದ ಹಸುಗಳಂತಿರುವ ಸ್ತ್ರೀಯರೇ,</para>
  <para style="q" vid="AMO 4:1">ಬಡವರನ್ನು ಹಿಂಸಿಸಿ,</para>
  <para style="q" vid="AMO 4:1">ದಿಕ್ಕಿಲ್ಲದವರನ್ನು ಜಜ್ಜಿ,</para>
  <para style="q" vid="AMO 4:1">ನೀವು ನಿಮ್ಮ ಪತಿಗಳಿಗೆ,</para>
  <para style="q" vid="AMO 4:1">“ಪಾನಗಳನ್ನು ತರಿಸಿ, ಕುಡಿಯೋಣ” ಎಂದು ಹೇಳುವವರೇ, ಈ ಮಾತನ್ನು ಕೇಳಿರಿ.<verse eid="AMO 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 4:2"/>ಕರ್ತನಾದ ಯೆಹೋವನು ತನ್ನ ಪರಿಶುದ್ಧತ್ವದ ಮೇಲೆ ಆಣೆಯಿಟ್ಟು:</para>
  <para style="q" vid="AMO 4:2">“ಇಗೋ ನಿಮ್ಮನ್ನು ಕೊಂಡಿಗಳಿಂದಲೂ,</para>
  <para style="q" vid="AMO 4:2">ನಿಮ್ಮಲ್ಲಿ ಉಳಿದವರನ್ನು ಮೀನುಗಾಳಗಳಿಂದಲೂ,</para>
  <para style="q" vid="AMO 4:2">ಎಳೆದುಕೊಂಡು ಹೋಗುವ ದಿನಗಳು ನಿಮಗೆ ಬರುತ್ತವೆ ಎಂದು ಪ್ರಮಾಣ ಮಾಡಿದ್ದಾನೆ.<verse eid="AMO 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 4:3"/>ಗೋಡೆಯಲ್ಲಿಯ ಬಿರುಕುಗಳ ಮೂಲಕ,</para>
  <para style="q" vid="AMO 4:3">ಪ್ರತಿಯೊಬ್ಬ ಸ್ತ್ರೀಯೂ ನೇರವಾಗಿ ತನ್ನ ಮುಂದೆಯೇ ಹೊರಟು ಹೋಗುವಳು,</para>
  <para style="q" vid="AMO 4:3">ಹರ್ಮೋನಿನ<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">ಹರ್ಮೋನಿನ </char><char style="ft" closed="false">ಅಂದರೆ ಕಸವನ್ನು ಎಸೆಯುವ ತಿಪ್ಪೆಗೆ.</char></note> ದಿಕ್ಕಿನ ಕಡೆಗೆ ತಳ್ಳಲ್ಪಡುವಿರಿ”</para>
  <para style="q" vid="AMO 4:3">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 4:3"/></para>
  <para style="s">ಕೇವಲ ಆಚಾರಗಳು ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4"/>“ಬೇತೇಲಿಗೆ ಹೋಗಿ ದ್ರೋಹ ಮಾಡಿರಿ,</para>
  <para style="q" vid="AMO 4:4">ಗಿಲ್ಗಾಲಿನಲ್ಲಿ ಸೇರಿ ದ್ರೋಹವನ್ನು ಇನ್ನೂ ಹೆಚ್ಚಿಸಿರಿ.</para>
  <para style="q" vid="AMO 4:4">ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ ನಿಮ್ಮ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸಿರಿ,</para>
  <para style="q" vid="AMO 4:4">ಮೂರು ದಿನಕ್ಕೆ ಒಂದು ಸಲ ದಶಮಾಂಶವನ್ನು ಸಲ್ಲಿಸಿರಿ.<verse eid="AMO 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 4:5"/>ಹುಳಿಹಿಟ್ಟನ್ನು ಕೃತಜ್ಞತಾರ್ಪಣವಾಗಿ ಹೋಮ ಮಾಡಿರಿ; ಕೊಟ್ಟ ಕಾಣಿಕೆಯನ್ನು ಪ್ರಕಟಿಸಿರಿ; ಸಾರಿಹೇಳಿರಿ, ಇಸ್ರಾಯೇಲರೇ ಹೀಗೆ ಮಾಡುವುದು ನಿಮಗೆ ಇಷ್ಟ” ಇದು ಕರ್ತನಾದ ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 4:5"/></para>
  <para style="s">ಸನ್ಮಾರ್ಗಕ್ಕೆ ಬಾರದವರಿಗೆ ಹೆಚ್ಚು ದಂಡನೆಯು ಅವಶ್ಯ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6"/>“ನಿಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿ ನಿಮ್ಮ ಹಲ್ಲಿಗೆ ಏನೂ ಸಿಕ್ಕದಂತೆಯೂ</para>
  <para style="q" vid="AMO 4:6">ಮತ್ತು ನಿಮ್ಮ ಸಕಲ ನಿವಾಸಗಳಲ್ಲಿ ಅನ್ನದ ಕೊರತೆಯಾಗುವ ಹಾಗೆಯೂ ಮಾಡಿದೆನು.</para>
  <para style="q" vid="AMO 4:6">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಲಿಲ್ಲ”</para>
  <para style="q" vid="AMO 4:6">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 4:7"/>“ಸುಗ್ಗಿಗೆ ಮೂರು ತಿಂಗಳು ಕಳೆಯಬೇಕಾದಾಗಲೂ,</para>
  <para style="q" vid="AMO 4:7">ನಿಮಗೆ ಮಳೆಯನ್ನು ತಡೆದೆನು. ಒಂದು ಪಟ್ಟಣದ ಮೇಲೆ ಮಳೆಯಾಗುವಂತೆಯೂ,</para>
  <para style="q" vid="AMO 4:7">ಇನ್ನೊಂದು ಪಟ್ಟಣದ ಮೇಲೆ ಮಳೆಯಾಗದಂತೆಯೂ ಮಾಡಿದೆನು.</para>
  <para style="q" vid="AMO 4:7">ಒಂದು ಭಾಗದ ಹೊಲದಲ್ಲಿ ಮಳೆಯಾಯಿತು.</para>
  <para style="q" vid="AMO 4:7">ಮಳೆಯಾಗದ ಹೊಲದ ಭಾಗವು ಬಾಡಿಹೋಯಿತು.<verse eid="AMO 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 4:8"/>ಎರಡು ಅಥವಾ ಮೂರು ಪಟ್ಟಣದವರು ನೀರು ಕುಡಿಯುವುದಕ್ಕೆ ಮತ್ತೊಂದು ಪಟ್ಟಣಕ್ಕೆ ಬಳಲುತ್ತಾ ಹೋಗುತ್ತಿದ್ದರು,</para>
  <para style="q" vid="AMO 4:8">ಬಾಯಾರಿಕೆ ತೀರಲಿಲ್ಲ.</para>
  <para style="q" vid="AMO 4:8">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಲಿಲ್ಲ.”</para>
  <para style="q" vid="AMO 4:8">ಇದು ಯೆಹೋವನ ನುಡಿ. <verse eid="AMO 4:8"/><verse number="9" style="v" sid="AMO 4:9"/>“ನಿಮ್ಮನ್ನು ಬೂದಿಯಿಂದಲೂ, ಬಿಸಿಗಾಳಿಯಿಂದಲೂ ಬಾಧಿಸಿದೆನು.</para>
  <para style="q" vid="AMO 4:9">ನಿಮ್ಮ ಲೆಕ್ಕವಿಲ್ಲದ ವನ, ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು,</para>
  <para style="q" vid="AMO 4:9">ಅಂಜೂರದ ಗಿಡಗಳನ್ನು,</para>
  <para style="q" vid="AMO 4:9">ನಿಮ್ಮ ಎಣ್ಣೆಯ ಮರಗಳನ್ನು ಮಿಡತೆಯು ತಿಂದುಬಿಟ್ಟಿತು.</para>
  <para style="q" vid="AMO 4:9">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಲಿಲ್ಲ”</para>
  <para style="q" vid="AMO 4:9">ಇದು ಯೆಹೋವನು ನುಡಿ.<verse eid="AMO 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 4:10"/>“ಐಗುಪ್ತದ ವ್ಯಾಧಿಗಳಂತಹ ವ್ಯಾಧಿಯನ್ನು ನಿಮ್ಮ ಮೇಲೆ ಕಳುಹಿಸಿದೆನು.</para>
  <para style="q" vid="AMO 4:10">ನಿಮ್ಮ ಯುವಕರನ್ನು ಖಡ್ಗದಿಂದ ಹತಿಸಿದೆನು,</para>
  <para style="q" vid="AMO 4:10">ನಿಮ್ಮ ಕುದರೆಗಳನ್ನು ಸೂರೆಮಾಡಿಸಿದೆನು,</para>
  <para style="q" vid="AMO 4:10">ನಿಮ್ಮ ದಂಡುಗಳ ದುರ್ವಾಸನೆ ನಿಮ್ಮ ಮೂಗಿಗೆ</para>
  <para style="q" vid="AMO 4:10">ಬಡಿಯುವಂತೆ ಮಾಡಿದೆನು.</para>
  <para style="q" vid="AMO 4:10">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಲಿಲ್ಲ”</para>
  <para style="q" vid="AMO 4:10">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 4:11"/>“ಸೊದೋಮ್ ಮತ್ತು ಗೊಮೋರಗಳನ್ನು ಕೆಡವಿದಂತೆ,</para>
  <para style="q" vid="AMO 4:11">ನಾನು ನಿಮ್ಮ ಪಟ್ಟಣಗಳನ್ನು ಕೆಡವಿಬಿಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q" vid="AMO 4:11">ಬೆಂಕಿ ಉರಿಯಿಂದ ಎಳೆದ ಕೊಳ್ಳೆಯ ಹಾಗೆ ಇದ್ದೀರಿ.</para>
  <para style="q" vid="AMO 4:11">ಆದರೂ ನೀವು ನನ್ನ ಕಡೆಗೆ ಹಿಂದಿರುಗಲಿಲ್ಲ”</para>
  <para style="q" vid="AMO 4:11">ಇದು ಯೆಹೋವನು ನುಡಿ.<verse eid="AMO 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 4:12"/>“ಆದಕಾರಣ ಇಸ್ರಾಯೇಲೇ, ನಾನು ನಿನಗೆ ಮಾಡುತ್ತೇನೆ;</para>
  <para style="q" vid="AMO 4:12">ನಾನು ಮಾಡಬೇಕೆಂದಿರುವುದರಿಂದ,</para>
  <para style="q" vid="AMO 4:12">ಇಸ್ರಾಯೇಲೇ, ನಿನ್ನ ದೇವರ ಬರುವಿಕೆಗೆ ನಿನ್ನನ್ನು ಸಿದ್ಧಮಾಡಿಕೋ!<verse eid="AMO 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13"/>ಇಗೋ, ಪರ್ವತಗಳನ್ನು ರೂಪಿಸಿ,</para>
  <para style="q" vid="AMO 4:13">ಗಾಳಿಯನ್ನು ನಿರ್ಮಿಸಿ,</para>
  <para style="q" vid="AMO 4:13">ತನ್ನ ಸಂಕಲ್ಪವನ್ನು ಮನುಷ್ಯರಿಗೆ ವ್ಯಕ್ತಗೊಳಿಸಿ,</para>
  <para style="q" vid="AMO 4:13">ಉದಯವನ್ನು ಅಂಧಕಾರವನ್ನಾಗಿ ಮಾಡಿ</para>
  <para style="q" vid="AMO 4:13">ಮತ್ತು ಭೂಮಿಯ ಉನ್ನತ ಪ್ರದೇಶಗಳನ್ನು ತುಳಿದುಬಿಡುವಾತನು”</para>
  <para style="q" vid="AMO 4:13">ಸೇನಾಧೀಶ್ವರ ದೇವರಾದ ಯೆಹೋವನೆಂಬುದೇ ನನ್ನ ನಾಮಧೇಯ.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s">ಪ್ರಲಾಪವೂ ಪ್ರಬೋಧನೆಯೂ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>ಇಸ್ರಾಯೇಲ್ ವಂಶದವರೇ, ನಾನು ನಿಮ್ಮ ವಿಷಯದಲ್ಲಿ ಶೋಕಗೀತವಾಗಿ ಹಾಡುವ ಈ ಮಾತನ್ನು ಕೇಳಿರಿ:<verse eid="AMO 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2"/>ಇಸ್ರಾಯೇಲೆಂಬ ಯುವತಿಯು ಬಿದ್ದಿದ್ದಾಳೆ;</para>
  <para style="q" vid="AMO 5:2">ಮತ್ತೆ ಏಳುವುದೇ ಇಲ್ಲ;</para>
  <para style="q" vid="AMO 5:2">ದಿಕ್ಕಿಲ್ಲದೆ ತನ್ನ ನೆಲದ ಮೇಲೆ ಒರಗಿದ್ದಾಳೆ;</para>
  <para style="q" vid="AMO 5:2">ಅವಳನ್ನು ಎತ್ತಲು ಯಾರೂ ಇಲ್ಲ.<verse eid="AMO 5:2"/></para>
  <para style="s">ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ಕರೆ</para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 5:3"/>ಕರ್ತನಾದ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 5:3">“ಒಂದು ಪಟ್ಟಣದಿಂದ ಯುದ್ಧಕ್ಕೆ ಹೊರಟ ಸಾವಿರ ಸೈನಿಕರಲ್ಲಿ ನೂರು ಮಂದಿ ಉಳಿಯುವರು,</para>
  <para style="q" vid="AMO 5:3">ಒಂದು ಊರಿನಿಂದ ಹೊರಟ ನೂರು ಸೈನಿಕರಲ್ಲಿ</para>
  <para style="q" vid="AMO 5:3">ಇಸ್ರಾಯೇಲರ ವಂಶಕ್ಕೆ ಹತ್ತು ಜನ ನಿಲ್ಲುವರು.”<verse eid="AMO 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 5:4"/>ಯೆಹೋವನು ಇಸ್ರಾಯೇಲರ ವಂಶಕ್ಕೆ ಹೀಗೆ ನುಡಿಯುತ್ತಾನೆ:</para>
  <para style="q" vid="AMO 5:4">“ನೀವು ನನ್ನನ್ನು ಆಶ್ರಯಿಸಿ ಬದುಕಿಕೊಳ್ಳಿರಿ!<verse eid="AMO 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 5:5"/>ಬೇತೇಲನ್ನು ಆಶ್ರಯಿಸಬೇಡಿರಿ;</para>
  <para style="q" vid="AMO 5:5">ಗಿಲ್ಗಾಲನ್ನು ಸೇರಬೇಡಿರಿ;</para>
  <para style="q" vid="AMO 5:5">ಬೇರ್ಷೆಬಕ್ಕೆ ಯಾತ್ರೆ ಹೋಗಬೇಡಿರಿ.</para>
  <para style="q" vid="AMO 5:5">ಗಿಲ್ಗಾಲು ನಿಶ್ಚಯವಾಗಿ ಸೆರೆಗೆ ಹೋಗುವುದು.</para>
  <para style="q" vid="AMO 5:5">ಬೇತೇಲು ಬಯಲಾಗುವುದು.<verse eid="AMO 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 5:6"/>ಯೆಹೋವನ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು ಬದುಕಿರಿ,</para>
  <para style="q" vid="AMO 5:6">ತಿರುಗಿಕೊಳ್ಳದಿದ್ದರೆ ಆತನು ಬೆಂಕಿಯೋಪಾದಿಯಲ್ಲಿ</para>
  <para style="q" vid="AMO 5:6">ಯೋಸೇಫನ ವಂಶದೊಳಗೆ ಪ್ರವೇಶಿಸುವನು.</para>
  <para style="q" vid="AMO 5:6">ಅದು ದಹಿಸಿಬಿಡುವುದು,</para>
  <para style="q" vid="AMO 5:6">ಅದನ್ನು ಆರಿಸುವುದಕ್ಕೆ ಬೇತೇಲಿನಲ್ಲಿ ಯಾರೂ ಇರುವುದಿಲ್ಲ.<verse eid="AMO 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 5:7"/>ಅವರು ನ್ಯಾಯವನ್ನು ಕಹಿಮಾಡುವವರು</para>
  <para style="q" vid="AMO 5:7">ಮತ್ತು ಧರ್ಮವನ್ನು ನೆಲಕ್ಕೆ ಕೆಡವಿಬಿಡುವವರು!”<verse eid="AMO 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 5:8"/>ಕೃತ್ತಿಕಾ ಮತ್ತು ಒರಿಯನ್ ಎಂಬ ಪ್ರಕಾಶಮಾನವಾದ ನಕ್ಷತ್ರಗಳನ್ನು ಸೃಷ್ಟಿಸಿ,</para>
  <para style="q" vid="AMO 5:8">ಕಾರ್ಗತ್ತಲನ್ನು ಬೆಳಕನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q" vid="AMO 5:8">ಹಗಲನ್ನು ಇರುಳಾಗಿ ಮಾರ್ಪಡಿಸಿ,</para>
  <para style="q" vid="AMO 5:8">ಸಾಗರದ ಜಲವನ್ನು ಬರಮಾಡಿಕೊಂಡು,</para>
  <para style="q" vid="AMO 5:8">ಭೂಮಂಡಲದ ಮೇಲೆ ಸುರಿಯುವಾತನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳಿರಿ,</para>
  <para style="q" vid="AMO 5:8">ಯೆಹೋವನೆಂಬುದೇ ಆತನ ನಾಮಧೇಯ!<verse eid="AMO 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 5:9"/>ಬಲಿಷ್ಠರಿಗೆ ಧ್ವಂಸವನ್ನು ತಟ್ಟನೇ ತಂದೊಡ್ಡಿ,</para>
  <para style="q" vid="AMO 5:9">ಕೋಟೆಗೆ ನಾಶನವನ್ನು ತರುವವನು ಆತನೇ.<verse eid="AMO 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 5:10"/>ಕಂಡ ದೋಷವನ್ನು ಚಾವಡಿಯಲ್ಲಿ ಖಂಡಿಸುವವನ ಮೇಲೆ ಹಗೆತೋರಿಸುತ್ತೀರಿ,</para>
  <para style="q" vid="AMO 5:10">ಯಥಾರ್ಥರನ್ನು ದ್ವೇಷಿಸುತ್ತೀರಿ.<verse eid="AMO 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 5:11"/>ನೀವು ಬಡವರನ್ನು ತುಳಿದು,</para>
  <para style="q" vid="AMO 5:11">ಅವರಿಂದ ಗೋದಿಯನ್ನು ಬಿಟ್ಟಿ ತೆಗೆದುಕೊಂಡ ಕಾರಣ</para>
  <para style="q" vid="AMO 5:11">ಕೆತ್ತಿದ ಕಲ್ಲಿನಿಂದ ನೀವು ಕಟ್ಟಿಕೊಂಡ ಮನೆಗಳಲ್ಲಿ,</para>
  <para style="q" vid="AMO 5:11">ವಾಸಿಸದೆ ಇರುವಿರಿ.</para>
  <para style="q" vid="AMO 5:11">ಒಳ್ಳೆಯ ದ್ರಾಕ್ಷಿಯ ತೋಟಗಳನ್ನು ಮಾಡಿಕೊಂಡು,</para>
  <para style="q" vid="AMO 5:11">ಅದರ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುವಿರಿ.<verse eid="AMO 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 5:12"/>ನೀತಿವಂತರನ್ನು ಹಿಂಸಿಸುವವರೇ,</para>
  <para style="q" vid="AMO 5:12">ಲಂಚತೆಗೆದುಕೊಳ್ಳುವವರೇ,</para>
  <para style="q" vid="AMO 5:12">ಚಾವಡಿಯಲ್ಲಿ ದರಿದ್ರರ ನ್ಯಾಯವನ್ನು ತಪ್ಪಿಸುವವರೇ.</para>
  <para style="q" vid="AMO 5:12">ನಿಮ್ಮ ದ್ರೋಹಗಳು ಬಹಳ,</para>
  <para style="q" vid="AMO 5:12">ನಿಮ್ಮ ಪಾಪಗಳು ನನಗೆ ಗೊತ್ತಿದೆ.<verse eid="AMO 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 5:13"/>ಇಂಥ ಕಾಲದಲ್ಲಿ ವಿವೇಕಿಯು ಸುಮ್ಮನಿರುವನು, ಇದು ದುಷ್ಟ ಕಾಲವೇ ಸರಿ.<verse eid="AMO 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 5:14"/>ಕೆಟ್ಟದ್ದನಲ್ಲ ಒಳ್ಳೆಯದನ್ನು,</para>
  <para style="q" vid="AMO 5:14">ಅನುಸರಿಸಿ ಬಾಳಿರಿ.</para>
  <para style="q" vid="AMO 5:14">ನೀವು ಅಂದುಕೊಂಡಂತೆ,</para>
  <para style="q" vid="AMO 5:14">ಸೇನಾಧೀಶ್ವರ ದೇವರಾದ ಯೆಹೋವನು ನಿಮ್ಮ ಸಂಗಡ ಇರುವನು.<verse eid="AMO 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 5:15"/>ಕೆಟ್ಟದ್ದನ್ನು ದ್ವೇಷಿಸಿರಿ, ಒಳ್ಳೆಯದನ್ನು ಪ್ರೀತಿಸಿರಿ,</para>
  <para style="q" vid="AMO 5:15">ಚಾವಡಿಯಲ್ಲಿ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸಿರಿ.</para>
  <para style="q" vid="AMO 5:15">ಒಂದು ವೇಳೆ ಸೇನಾಧೀಶ್ವರ ದೇವರಾದ ಯೆಹೋವನು</para>
  <para style="q" vid="AMO 5:15">ಯೋಸೇಫನ ವಂಶದಲ್ಲಿ ಉಳಿದವರಿಗೆ ಪ್ರಸನ್ನನಾದನು.<verse eid="AMO 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 5:16"/>ಸೇನಾಧೀಶ್ವರ ದೇವರಾದ,</para>
  <para style="q" vid="AMO 5:16">ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ:</para>
  <para style="q" vid="AMO 5:16">“ಎಲ್ಲಾ ಚೌಕಗಳಲ್ಲಿ ಕಿರುಚಾಟವಾಗುವುದು</para>
  <para style="q" vid="AMO 5:16">ಮತ್ತು ಸಕಲ ಬೀದಿಗಳಲ್ಲಿ,</para>
  <para style="q" vid="AMO 5:16">‘ಅಯ್ಯೋ! ಅಯ್ಯೋ!’ ಎಂದು ಅರಚಿಕೊಳ್ಳುವರು.</para>
  <para style="q" vid="AMO 5:16">ರೈತರನ್ನು ಪ್ರಲಾಪಿಸುವುದಕ್ಕೂ</para>
  <para style="q" vid="AMO 5:16">ಗೋಳಾಟದವರನ್ನು ಗೋಳಾಡುವುದಕ್ಕೂ ಕರೆಯುವರು.<verse eid="AMO 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 5:17"/>ಎಲ್ಲಾ ದ್ರಾಕ್ಷಿಯ ತೋಟಗಳಲ್ಲಿ ರೋದನವಾಗುವುದು.</para>
  <para style="q" vid="AMO 5:17">ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮ ನಡುವೆ ಸಂಹಾರಕನಾಗಿ ಹಾದುಹೋಗುವೆನು”</para>
  <para style="q" vid="AMO 5:17">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 5:17"/></para>
  <para style="s">ಯೆಹೋವನ ದಿನವು ದುಷ್ಟರಿಗೆ ದುರ್ದಿನ</para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18"/>ಯೆಹೋವನ ದಿನವನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡವರೇ, ನಿಮ್ಮ ಗತಿಯನ್ನು ಏನು ಹೇಳಲಿ!</para>
  <para style="q" vid="AMO 5:18">ಯೆಹೋವನ ದಿನವು ನಿಮಗೇಕೆ?</para>
  <para style="q" vid="AMO 5:18">ಅದು ಬೆಳಕಲ್ಲ ಕತ್ತಲೆಯೇ.<verse eid="AMO 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="AMO 5:19"/>ಸಿಂಹದ ಕಡೆಯಿಂದ ಓಡಿದವನಿಗೆ,</para>
  <para style="q" vid="AMO 5:19">ಕರಡಿಯು ಎದುರುಬಿದ್ದಂತಾಗುವುದು,</para>
  <para style="q" vid="AMO 5:19">ಅವನು ಮನೆಗೆ ಓಡಿಬಂದು,</para>
  <para style="q" vid="AMO 5:19">ಕೈಯನ್ನು ಗೋಡೆಯ ಮೇಲೆ ಇಡಲು,</para>
  <para style="q" vid="AMO 5:19">ಹಾವು ಕಚ್ಚಿದ ಹಾಗಾಗುವುದು.<verse eid="AMO 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="AMO 5:20"/>ಯೆಹೋವನ ದಿನವು ಬೆಳಕಲ್ಲ; ಕತ್ತಲೆಯೇ!</para>
  <para style="q" vid="AMO 5:20">ಯಾವ ಪ್ರಕಾಶ ಇಲ್ಲದ ಗಾಢಾಂಧಕಾರವೇ!<verse eid="AMO 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="AMO 5:21"/>“ನಿಮ್ಮ ಜಾತ್ರೆಗಳನ್ನು ಹಗೆಮಾಡುತ್ತೇನೆ, ತುಚ್ಛೀಕರಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="AMO 5:21">ನಿಮ್ಮ ಉತ್ಸವಗಳ ವಾಸನೆಯೇ ನನಗೆ ಬೇಡ.<verse eid="AMO 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="AMO 5:22"/>ನೀವು ನನಗೆ ಸರ್ವಾಂಗಹೋಮಗಳನ್ನು ಮತ್ತು ಧಾನ್ಯನೈವೇದ್ಯಗಳನ್ನು ಅರ್ಪಿಸಿದರೂ,</para>
  <para style="q" vid="AMO 5:22">ನಾನು ಅದನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ,</para>
  <para style="q" vid="AMO 5:22">ಸಮಾಧಾನದ ಯಜ್ಞವಾಗಿ ನೀವು ಒಪ್ಪಿಸಿದ ಕೊಬ್ಬಿದ ಪಶುಗಳನ್ನು ನೋಡುವುದಿಲ್ಲ.<verse eid="AMO 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="AMO 5:23"/>ನಿಮ್ಮ ಗೀತೆಗಳ ಧ್ವನಿಯನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ;</para>
  <para style="q" vid="AMO 5:23">ನಿಮ್ಮ ವೀಣೆಗಳ ಮಧುರನಾದಕ್ಕೆ ಕಿವಿಗೊಡುವುದಿಲ್ಲ.<verse eid="AMO 5:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="AMO 5:24"/>ಅದರ ಬದಲಾಗಿ ನ್ಯಾಯವು ಹೊಳೆಯ ಹಾಗೆ ಹರಿಯಲಿ,</para>
  <para style="q" vid="AMO 5:24">ಧರ್ಮವು ಮಹಾನದಿಯಂತೆ ಹರಿಯಲಿ.<verse eid="AMO 5:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="AMO 5:25"/>ಇಸ್ರಾಯೇಲರ ವಂಶದವರೇ</para>
  <para style="q" vid="AMO 5:25">ನೀವು ಅರಣ್ಯದಲ್ಲಿ ನಲ್ವತ್ತು ವರ್ಷ ನನಗೆ ಯಜ್ಞಗಳನ್ನೂ, ಧಾನ್ಯನೈವೇದ್ಯಗಳನ್ನೂ ಅರ್ಪಿಸಿದ್ದೀರೋ?<verse eid="AMO 5:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="AMO 5:26"/>ಸಿಕ್ಕೊತ್ ಎಂಬ ನಿಮ್ಮ ಒಡೆಯನನ್ನು,</para>
  <para style="q" vid="AMO 5:26">ಕಿಯೂನ್ ಎಂಬ ನಿಮ್ಮ ನಕ್ಷತ್ರ ದೇವತೆಯನ್ನು,</para>
  <para style="q" vid="AMO 5:26">ನಿರ್ಮಿಸಿಕೊಂಡಿರುವ ನಿಮ್ಮ ಮೂರ್ತಿಗಳನ್ನು ನೀವು ಹೊತ್ತುಕೊಂಡು ಹೋಗಬೇಕಾಗುವುದು.<verse eid="AMO 5:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="AMO 5:27"/>ನಾನು ನಿಮ್ಮನ್ನು ದಮಸ್ಕದ ಆಚೆ ಸೆರೆಗೆ ಕಳುಹಿಸುವೆನು”</para>
  <para style="q" vid="AMO 5:27">ಸೇನಾಧೀಶ್ವರ ದೇವರೆಂಬ,</para>
  <para style="q" vid="AMO 5:27">ಯೆಹೋವನು ಇದನ್ನು ನುಡಿದಿದ್ದಾನೆ.<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s">ಇಸ್ರಾಯೇಲಿನ ದೌರ್ಭಾಗ್ಯ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 6:1"/>ಅಯ್ಯೋ! ಚೀಯೋನಿನಲ್ಲಿ ನೆಮ್ಮದಿಯಾಗಿರುವವರ ಗತಿಯನ್ನು ಏನೆಂದು ಹೇಳಲಿ,</para>
  <para style="q" vid="AMO 6:1">ಪ್ರಮುಖ ಜನಾಂಗದಲ್ಲಿ ಹೆಸರುಗೊಂಡು ಇಸ್ರಾಯೇಲರ ನ್ಯಾಯವಿಚಾರಕರಾಗಿ,</para>
  <para style="q" vid="AMO 6:1">ಸಮಾರ್ಯದ ಬೆಟ್ಟದಲ್ಲಿ ನಿಶ್ಚಿಂತರಾಗಿರುವವರ,</para>
  <para style="q" vid="AMO 6:1">ಗತಿಯನ್ನು ಏನೆಂದು ಹೇಳಲಿ!<verse eid="AMO 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 6:2"/>ನಿಮ್ಮ ಪ್ರಮುಖರು, “ಕಲ್ನೆಗೆ ಹೋಗಿ ನೋಡಲಿ;</para>
  <para style="q" vid="AMO 6:2">ಅಲ್ಲಿಂದ ಮಹಾ ಪಟ್ಟಣವಾದ ಹಮಾತಿಗೆ ತೆರಳಿರಿ;</para>
  <para style="q" vid="AMO 6:2">ಆ ಮೇಲೆ ಫಿಲಿಷ್ಟಿಯರ ಗತ್ ಊರಿಗೆ ಇಳಿಯಿರಿ.</para>
  <para style="q" vid="AMO 6:2">ಅವು ಈ ರಾಜ್ಯಗಳಿಗಿಂತ ಶ್ರೇಷ್ಠವೋ?</para>
  <para style="q" vid="AMO 6:2">ಅವುಗಳ ಪ್ರಾಂತ್ಯವು ನಿಮ್ಮ ಪ್ರಾಂತ್ಯಗಳಿಗಿಂತ ದೊಡ್ಡದೋ?”<verse eid="AMO 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 6:3"/>ಆಹಾ! ಆ ಪ್ರಮುಖರು ಆಪತ್ತಿನ ದಿನದ ಯೋಚನೆಯನ್ನು ದೂರಕ್ಕೆ ತಳ್ಳುತ್ತಾರೆ</para>
  <para style="q" vid="AMO 6:3">ಮತ್ತು ಅನ್ಯಾಯದ ಪೀಠಗಳನ್ನು ಹತ್ತಿರಕ್ಕೆ ತಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="AMO 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 6:4"/>ದಂತದ ಮಂಚಗಳ ಮೇಲೆ ಮಲಗುತ್ತಾರೆ</para>
  <para style="q" vid="AMO 6:4">ಮತ್ತು ತಮ್ಮ ಗದ್ದುಗೆಗಳಲ್ಲಿ ಹಾಯಾಗಿ ಒರಗಿಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q" vid="AMO 6:4">ಹಿಂಡಿನ ಕುರಿಮರಿಗಳನ್ನು,</para>
  <para style="q" vid="AMO 6:4">ಕೊಟ್ಟಿಗೆಯ ಕರುಗಳನ್ನು ತಿನ್ನುತ್ತಾರೆ.<verse eid="AMO 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 6:5"/>ವೀಣೆಯ ಮೇಲೆ ಮನಸ್ಸು ಬಂದಂತೆ ಹಾಡುತ್ತಾರೆ;</para>
  <para style="q" vid="AMO 6:5">ದಾವೀದನ ಹಾಗೆ ಗಾನವಾದ್ಯಗಳನ್ನು ಕಲ್ಪಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="AMO 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 6:6"/>ದ್ರಾಕ್ಷಾರಸವನ್ನು ಬೋಗುಣಿಯಲ್ಲಿ ಕುಡಿಯುತ್ತಾರೆ</para>
  <para style="q" vid="AMO 6:6">ಮತ್ತು ಉತ್ತಮ ಅಭಿಷೇಕ ತೈಲಗಳನ್ನು ಹಚ್ಚಿಕೊಳ್ಳುತ್ತಾರೆ,</para>
  <para style="q" vid="AMO 6:6">ಆದರೆ ಯೋಸೇಫನ ನಷ್ಟಕ್ಕೆ ವ್ಯಸನಪಡುವುದಿಲ್ಲ.<verse eid="AMO 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 6:7"/>ಆದುದರಿಂದ ಸೆರೆಗೆ ಒಯ್ಯುವವರ ಮುಂದುಗಡೆಯೇ,</para>
  <para style="q" vid="AMO 6:7">ಅವರು ಸೆರೆಗೆ ಹೋಗುವರು,</para>
  <para style="q" vid="AMO 6:7">ಮತ್ತು ಭೋಗಮಾಡುವವರ ಹರ್ಷಧ್ವನಿಯು ನಿಂತುಹೋಗುವುದು.<verse eid="AMO 6:7"/></para>
  <para style="s">ಆಹಂಕಾರಿಗಳಾದ ಇಸ್ರಾಯೇಲರನ್ನು ದ್ವೇಷಿಸುತ್ತಾನೆ</para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 6:8"/>ಸೇನಾಧೀಶ್ವರ ದೇವರಾದ ಯೆಹೋವನ ನುಡಿಯನ್ನು ಕೇಳಿರಿ</para>
  <para style="q" vid="AMO 6:8">ಕರ್ತನಾದ ಯೆಹೋವನು ತನ್ನ ಮೇಲೆ ಆಣೆಯಿಟ್ಟು ಹೀಗೆಂದಿದ್ದಾನೆ,</para>
  <para style="q" vid="AMO 6:8">“ನಾನು ಯಾಕೋಬಿನ ಅಟ್ಟಹಾಸಕ್ಕೆ ಅಸಹ್ಯಪಟ್ಟು;</para>
  <para style="q" vid="AMO 6:8">ಅದರ ಕೋಟೆಗಳನ್ನು ಹಗೆಮಾಡುತ್ತೇನೆ.</para>
  <para style="q" vid="AMO 6:8">ಆದುದರಿಂದ ನಾನು ರಾಜಧಾನಿಯನ್ನೂ,</para>
  <para style="q" vid="AMO 6:8">ಅದರ ಸಕಲ ಸಮೃದ್ಧಿಯನ್ನೂ ಆಪತ್ತಿಗೆ ಗುರಿಮಾಡುವೆನು”<verse eid="AMO 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 6:9"/>ಒಂದು ಮನೆಯಲ್ಲಿ ಹತ್ತು ಜನ ಉಳಿದರೂ ಅವರೆಲ್ಲರೂ ಸಾಯುವರು. <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>ಶವವನ್ನು ಸುಡಲು ಬಂದ ಸಂಬಂಧಿಕರು, ಹೆಣವನ್ನು ಮನೆಯೊಳಗಿಂದ ತೆಗೆದುಕೊಂಡು ಹೋದಾಗ, “ನಿಮ್ಮ ಹತ್ತಿರ ಇನ್ನೂ ಯಾರಾದರೂ ಇದ್ದಾರೋ?” ಎಂದು ಮನೆಯಲ್ಲಿರುವವರನ್ನು ಕೇಳುವಾಗ ಅವನು, “ಇಲ್ಲ” ಎನ್ನುವನು. ಆಗ ಸಂಬಂಧಿಕನು, “ಸುಮ್ಮನಿರು, ನಾವು ಯೆಹೋವನ ಹೆಸರನ್ನು ನೆನಪುಮಾಡಿಕೊಳ್ಳಬಾರದು.”<verse eid="AMO 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 6:11"/>ಇಗೋ, ನೋಡಿರಿ, ಯೆಹೋವನು ಆಜ್ಞಾಪಿಸಲು,</para>
  <para style="q" vid="AMO 6:11">ದೊಡ್ಡ ಮನೆಯು ಕೆಡವಲ್ಪಟ್ಟು ಚೂರುಚೂರಾಯಿತು,</para>
  <para style="q" vid="AMO 6:11">ಚಿಕ್ಕ ಮನೆಯೂ ಮುರಿದುಹೋಗುವುದು.<verse eid="AMO 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 6:12"/>ಕುದುರೆಗಳು ಬಂಡೆಯ ಮೇಲೆ ಓಡಾಡುವುವೋ?</para>
  <para style="q" vid="AMO 6:12">ಅದನ್ನು ಎತ್ತುಗಳಿಂದ ಉಳುವರೋ?</para>
  <para style="q" vid="AMO 6:12">ಆದರೆ ನೀವು ನ್ಯಾಯವನ್ನು ವಿಷವನ್ನಾಗಿ ಮಾಡಿ,</para>
  <para style="q" vid="AMO 6:12">ಧರ್ಮದ ಸುಫಲವನ್ನು ಕಹಿಯಾಗಿಸಿದಿರಿ.<verse eid="AMO 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 6:13"/>ನೀವು ಲೋ ದೆಬಾರ್ ಪಟ್ಟಣದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">ಲೋ ದೆಬಾರ್ ಪಟ್ಟಣದಲ್ಲಿ </char><char style="ft" closed="false">ಶೂನ್ಯವಾದದರಲ್ಲಿಯೇ.</char></note> ಉಲ್ಲಾಸಪಡುವವರೇ,</para>
  <para style="q" vid="AMO 6:13">ಸ್ವಬಲದಿಂದ ಕರ್ನಾಯಿಮ್ <note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">ಕರ್ನಾಯಿಮ್ </char><char style="ft" closed="false">ಸ್ವಬಲ.</char></note>ಪಟ್ಟಣವನ್ನು ಪಡೆದುಕೊಂಡಿಲ್ಲವೇ ಎಂದುಕೊಳ್ಳುವವರೇ.<verse eid="AMO 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 6:14"/>ಸೇನಾಧೀಶ್ವರ ದೇವರಾದ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 6:14">“ಇಸ್ರಾಯೇಲರ ವಂಶದವರೇ, ಇಗೋ, ನಾನು ನಿಮಗೆ ವಿರುದ್ಧವಾಗಿ ಒಂದು ಜನಾಂಗವನ್ನು ಎಬ್ಬಿಸುವೆನು;</para>
  <para style="q" vid="AMO 6:14">ಅವರು ಹಮಾತಿನ ದಾರಿಯಿಂದ ಅರಾಬಾ ತಗ್ಗಿನ ಹೊಳೆಯ ತನಕ,</para>
  <para style="q" vid="AMO 6:14">ನಿಮ್ಮನ್ನು ಹಿಂಸಿಸುವರು.”<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s">ಮಿಡತೆಯ ದರ್ಶನ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>ಕರ್ತನಾದ ಯೆಹೋವನು ಇದನ್ನು ನನಗೆ ತೋರಿಸಿದನು. ಹಿಂಗಾರು ಮಳೆಬಿದ್ದು ಪೈರು ಸೊಂಪಾಗುವುದಕ್ಕೆ ಆರಂಭವಾದಾಗ ಅಂದರೆ ರಾಜಾದಾಯದ ಹುಲ್ಲನ್ನು ಕೊಯ್ದ ಮೇಲೆ ಬೆಳೆಯು ವೃದ್ಧಿಯಾಗುತ್ತಿದ್ದಾಗ ಇಗೋ, ಯೆಹೋವನು ಮಿಡತೆಗಳನ್ನು ಉಂಟುಮಾಡಿದನು. <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>ಅವು ದೇಶದ ಹುಲ್ಲನ್ನೆಲ್ಲಾ ತಿಂದುಬಿಟ್ಟ ಮೇಲೆ ನಾನು, “ಕರ್ತನಾದ ಯೆಹೋವನೇ, ಲಾಲಿಸು, ನನ್ನನ್ನು ಕ್ಷಮಿಸು. ಯಾಕೋಬ ಜನಾಂಗವು ಹೇಗೆ ಉಳಿಯುವುದು? ಏಕೆಂದರೆ ಅದು ಚಿಕ್ಕದಾದ ಜನಾಂಗ” ಎಂದು ವಿಜ್ಞಾಪಿಸಿಕೊಂಡೆನು. <verse eid="AMO 7:2"/><verse number="3" style="v" sid="AMO 7:3"/>ಯೆಹೋವನು ಮನಮರುಗಿ, “ಈ ದರ್ಶನವು ನೆರವೇರುವುದಿಲ್ಲ” ಎಂದನು.<verse eid="AMO 7:3"/></para>
  <para style="s">ಕ್ಷಾಮದ ದರ್ಶನ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>ಕರ್ತನಾದ ಯೆಹೋವನು ಇನ್ನೊಂದು ದರ್ಶನವನ್ನು ನನಗೆ ತೋರಿಸಿದನು. ಇಗೋ, ಕರ್ತನಾದ ಯೆಹೋವನು ತನ್ನ ಜನರನ್ನು ದಂಡಿಸುವುದಕ್ಕಾಗಿ ಅಗ್ನಿಯನ್ನು ಕರೆದನು. ಅದು ಮಹಾ ಸಾಗರವನ್ನು ನುಂಗಿ ದೇಶವನ್ನೂ ತಿಂದುಬಿಟ್ಟಿತು. <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>ಆಗ ನಾನು, “ಕರ್ತನಾದ ಯೆಹೋವನೇ, ಲಾಲಿಸು. ಇದನ್ನು ನಿಲ್ಲಿಸಿಬಿಡು. ಯಾಕೋಬ ಜನಾಂಗ ಹೇಗೆ ಉಳಿಯುವುದು? ಏಕೆಂದರೆ ಅದು ಚಿಕ್ಕದಾದ ಜನಾಂಗವಾಗಿದೆ” ಎಂದು ಆಜ್ಞಾಪಿಸಲು <verse eid="AMO 7:5"/><verse number="6" style="v" sid="AMO 7:6"/>ಕರ್ತನಾದ ಯೆಹೋವನು ಮನಮರುಗಿ, “ಈ ದರ್ಶನವು ನೆರವೇರುವುದಿಲ್ಲ” ಎಂದನು.<verse eid="AMO 7:6"/></para>
  <para style="s">ನೂಲುಗುಂಡಿನ ದರ್ಶನ</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>ಕರ್ತನು ಮತ್ತೊಂದು ದರ್ಶನವನ್ನು ನನಗೆ ತೋರಿಸಿದನು. ಇಗೋ, ಯೆಹೋವನು ನೂಲುಮಟ್ಟದ ನೆಟ್ಟಗಿರುವ ಗೋಡೆಯ ಮೇಲೆ ನಿಂತಿದ್ದನು. ಆತನ ಕೈಯಲ್ಲಿ ನೂಲುಗುಂಡಿತ್ತು. <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>ಯೆಹೋವನು ನನಗೆ, “ಆಮೋಸನೇ, ನಿನ್ನ ಕಣ್ಣಿಗೆ ಕಾಣಿಸುವುದೇನು?” ಎಂದು ಕೇಳಲು ನಾನು, “ಒಂದು ನೂಲುಗುಂಡು” ಎಂದು ಉತ್ತರ ಕೊಟ್ಟೆನು. ಆಗ ಕರ್ತನು, “ಇಗೋ, ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲಿನ ಮಧ್ಯದಲ್ಲಿ ನೂಲುಗುಂಡನ್ನು ಇಡುತ್ತೇನೆ. ಇನ್ನು ಅವರನ್ನು ಕಂಡುಕಾಣದಂತೆ ದಂಡಿಸುವೆನು.<verse eid="AMO 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 7:9"/>ಇಸಾಕನ ವಂಶದವರ ಪೂಜಾಸ್ಥಳಗಳು ಹಾಳಾಗುವವು,</para>
  <para style="q" vid="AMO 7:9">ಇಸ್ರಾಯೇಲಿನ ಪವಿತ್ರಾಲಯಗಳು ಪಾಳುಬೀಳುವವು,</para>
  <para style="q" vid="AMO 7:9">ಮತ್ತು ನಾನು ಕತ್ತಿ ಹಿಡಿದು ಯಾರೊಬ್ಬಾಮನ ಮನೆತನಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ಏಳುವೆನು” ಅಂದನು.<verse eid="AMO 7:9"/></para>
  <para style="s">ಆಮೋಸನು ಯಾಜಕನನ್ನು ಮುಖಾಮುಖಿಯಾಗಿ ಎದುರಿಸಿದ್ದು</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>ಆಗ ಬೇತೇಲಿನ ಯಾಜಕನಾದ ಅಮಚ್ಯನು, ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯಾರೊಬ್ಬಾಮನಿಗೆ, “ಆಮೋಸನು ಇಸ್ರಾಯೇಲರ ಮಧ್ಯದಲ್ಲಿ ನಿನ್ನ ಮೇಲೆ ಒಳಸಂಚು ಮಾಡಿದ್ದಾನೆ. ದೇಶವು ಅವನ ವಿಪರೀತವಾದ ಮಾತುಗಳನ್ನು ತಾಳಲಾರದು” ಅಂದನು. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>ಅದಕ್ಕೆ ಆಮೋಸನು,</para>
  <para style="q" vid="AMO 7:11">“ಯಾರೊಬ್ಬಾಮನು ಖಡ್ಗದಿಂದ ಹತನಾಗುವನು.</para>
  <para style="q" vid="AMO 7:11">ಇಸ್ರಾಯೇಲರು ಖಂಡಿತವಾಗಿ ಸ್ವದೇಶದಿಂದ ಸೆರೆಯಾಗಿ ಒಯ್ಯಲ್ಪಡುವರು” ಎಂದು ಹೇಳಿಕಳುಹಿಸಿದನು.<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>ಅನಂತರ ಅಮಚ್ಯನು ಆಮೋಸನಿಗೆ, “ಕಣಿ ಹೇಳುವವನೇ, ಯೆಹೂದ ದೇಶಕ್ಕೆ ಓಡಿಹೋಗು. ಅಲ್ಲಿಯೇ ರೊಟ್ಟಿತಿಂದು ಪ್ರವಾದಿಸು. <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>ಆದರೆ ಬೇತೇಲಿನಲ್ಲಿ ಇನ್ನು ಪ್ರವಾದನೆ ಮಾಡಬೇಡ. ಇದು ರಾಜಕೀಯ ಪವಿತ್ರಾಲಯ, ಇದು ಅರಮನೆ<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="fq" closed="false">ಅರಮನೆ </char><char style="ft" closed="false">ದೇವಾಲಯ.</char></note>” ಎಂದು ಹೇಳಿದನು.<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>ಆಮೋಸನು ಅಮಚ್ಯನಿಗೆ ಪ್ರತ್ಯುತ್ತರವಾಗಿ, “ನಾನು ಪ್ರವಾದಿಯಲ್ಲ, ಪ್ರವಾದಿಯ ಮಗನೂ ಅಲ್ಲ. ಆದರೆ ನಾನು ಕುರುಬನು, ಅತ್ತಿಹಣ್ಣುಗಳನ್ನು ಕೂಡಿಸುವವನೂ<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">ಕೂಡಿಸುವವನೂ </char><char style="ft" closed="false">ನೋಡಿಕೊಳ್ಳುವವನು.</char></note> ಆಗಿದ್ದೇನೆ. <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>ಯೆಹೋವನು ನನ್ನನ್ನು ಮಂದೆ ಕಾಯುವವರಿಂದ ತಪ್ಪಿಸಿ, ‘ನೀನು ಹೋಗಿ ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರಿಗೆ ಪ್ರವಾದನೆ ಮಾಡು’ ಎಂದು ನನಗೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟನು.<verse eid="AMO 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 7:16"/>“ಈಗ ಯೆಹೋವನ ವಾಕ್ಯವನ್ನು ಕೇಳು ‘ಇಸ್ರಾಯೇಲರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಪ್ರವಾದನೆಮಾಡಬೇಡ. ಇಸಾಕನ ವಂಶಕ್ಕೆ ಖಂಡನೆಯಾಗಿ ಬಾಯಿ ಎತ್ತಬೇಡ’ ಎಂದು ನಿನಗೆ ಹೇಳಿದ ಕಾರಣ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,<verse eid="AMO 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 7:17"/>‘ನಿನ್ನ ಹೆಂಡತಿಯು ಈ ಪಟ್ಟಣದಲ್ಲಿ ಸೂಳೆಯಾಗುವಳು;</para>
  <para style="q" vid="AMO 7:17">ನಿನ್ನ ಗಂಡು ಮತ್ತು ಹೆಣ್ಣು ಮಕ್ಕಳು ಖಡ್ಗದಿಂದ ಹತರಾಗುವರು;</para>
  <para style="q" vid="AMO 7:17">ನಿನ್ನ ದೇಶವನ್ನು ಶತ್ರುಗಳು ನೂಲಿನಿಂದ ವಿಭಾಗಿಸಿಕೊಳ್ಳುವರು;</para>
  <para style="q" vid="AMO 7:17">ನೀನಂತೂ ಅಜ್ಞಾತವಾದ<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="fq" closed="false">ಅಜ್ಞಾತವಾದ </char><char style="ft" closed="false">ಅಥವಾ ಅಪವಿತ್ರವಾದ </char></note> ದೇಶದಲ್ಲಿ ಸಾಯುವಿ,</para>
  <para style="q" vid="AMO 7:17">ಇಸ್ರಾಯೇಲರು ಸ್ವದೇಶದಿಂದ ಸೆರೆಯಾಗಿ ಒಯ್ಯಲ್ಪಡುವುದು ಖಂಡಿತ’” ಎಂಬುದಾಗಿ ಯೆಹೋವನು ಹೇಳಿದನು.<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s">ಮಾಗಿದ ಹಣ್ಣಿನ ದರ್ಶನ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>ಕರ್ತನಾದ ಯೆಹೋವನು ಇದನ್ನು ನನಗೆ ತೋರಿಸಿದನು. ಇಗೋ, ಮಾಗಿದ ಹಣ್ಣಿನ<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">ಮಾಗಿದ ಹಣ್ಣಿನ </char><char style="ft" closed="false">ಅತ್ತಿಹಣ್ಣು.</char></note> ಪುಟ್ಟಿಯನ್ನು ಕಂಡೆನು! <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>ಆತನು ನನಗೆ, “ಆಮೋಸನೇ, ನಿನ್ನ ಕಣ್ಣಿಗೆ ಕಾಣಿಸುವುದೇನು?” ಎಂದು ಕೇಳಲು, ನಾನು ಅದಕ್ಕೆ, “ಮಾಗಿದ ಹಣ್ಣಿನ ಪುಟ್ಟಿ” ಎಂದೆನು. ಆಗ ಯೆಹೋವನು ನನಗೆ ಹೀಗೆ ಹೇಳಿದನು,</para>
  <para style="q" vid="AMO 8:2">“ಇಸ್ರಾಯೇಲೆಂಬ ನನ್ನ ಜನರಿಗೆ ಕಡೆಗಾಲವು ಮಾಗುತ್ತಾ ಬಂದಿದೆ.</para>
  <para style="q" vid="AMO 8:2">ಇನ್ನು ಮೇಲೆ ನಾನು ಅವರನ್ನು ಉಳಿಸುವುದಿಲ್ಲ.<verse eid="AMO 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 8:3"/>ಆ ದಿನದಲ್ಲಿ ದೇವಾಲಯದ ಹಾಡುಗಳು ಕಿರಿಚಾಟವಾಗುವವು”</para>
  <para style="q" vid="AMO 8:3">ಕರ್ತನಾದ ಯೆಹೋವನು ಹೀಗೆ ನುಡಿಯುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 8:3">“ಆಗ ಹೆಣಗಳು ಹೆಚ್ಚುವವು,</para>
  <para style="q" vid="AMO 8:3">ಅವುಗಳನ್ನು ಎಲ್ಲಾ ಸ್ಥಳಗಳಲ್ಲಿ ಸದ್ದುಗದ್ದಲವಿಲ್ಲದೆ ಬಿಸಾಡಿಬಿಡುವರು!”<verse eid="AMO 8:3"/></para>
  <para style="s">ಧನವಂತರ ಹಣದಾಸೆ ಮುಂದಿನ ದೌರ್ಭಾಗ್ಯ</para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 8:4"/>“ಎಷ್ಟು ಹೊತ್ತಿಗೆ ಅಮಾವಾಸ್ಯೆಯು ತೀರುವುದು?</para>
  <para style="q" vid="AMO 8:4">ಧಾನ್ಯವನ್ನು ಮಾರಬೇಕಲ್ಲಾ;</para>
  <para style="q" vid="AMO 8:4">ಸಬ್ಬತ್ತು ಇನ್ನೆಷ್ಟು ಹೊತ್ತು ಇರುವುದು?</para>
  <para style="q" vid="AMO 8:4">ಗೋದಿಯನ್ನು ಅಂಗಡಿಯಲ್ಲಿ ಇಡಬೇಕಲ್ಲಾ;</para>
  <para style="q" vid="AMO 8:4">ಕೊಳಗವನ್ನು ಕಿರಿದುಮಾಡೋಣ;</para>
  <para style="q" vid="AMO 8:4">ಬಡವರನ್ನು ನುಂಗುವವರೇ,</para>
  <para style="q" vid="AMO 8:4">ತೊಲವನ್ನು ಹೆಚ್ಚಿಸೋಣ;</para>
  <para style="q" vid="AMO 8:4">ಸುಳ್ಳು ತಕ್ಕಡಿಯಿಂದ ಮೋಸಮಾಡೋಣ;</para>
  <para style="q" vid="AMO 8:4">ದೇಶದ ಬಡವರನ್ನು ಮುಗಿಸಬೇಕೆಂದಿರುವವರೇ ಇದನ್ನು ಕೇಳಿರಿ.<verse eid="AMO 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 8:5"/>ಬಡವರನ್ನು ಬೆಳ್ಳಿಗೂ, ದಿಕ್ಕಿಲ್ಲದವರನ್ನು ಒಂದು ಜೊತೆ ಕೆರಗಳ ಜೋಡಿಗೂ ಕೊಂಡುಕೊಳ್ಳೋಣ;</para>
  <para style="q" vid="AMO 8:5">ಗೋದಿಯ ನುಚ್ಚುನ್ನು ಮಾರಿಬಿಡೋಣ” ಎಂದು ಹೇಳುತ್ತೀರಿ ಅಲ್ಲವೇ?<verse eid="AMO 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 8:6"/>ದಿಕ್ಕಿಲ್ಲದವರನ್ನು ತುಳಿದು ಬಿಡುವವರೇ,</para>
  <para style="q" vid="AMO 8:6">ದೇಶದ ಬಡವರನ್ನು ಮುಗಿಸಬೇಕೆಂದಿರುವವರೇ, ಇದನ್ನು ಕೇಳಿರಿ!<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>ಯೆಹೋವನು ಯಾಕೋಬಿನ ಮಹಿಮೆಯ ಮೇಲೆ ಹೀಗೆ ಆಣೆಯಿಟ್ಟಿದ್ದಾನೆ, “ಖಂಡಿತವಾಗಿ ಅವರ ಕೃತ್ಯಗಳಲ್ಲಿ ಯಾವುದನ್ನೂ ಎಂದಿಗೂ ಮರೆತುಬಿಡುವುದಿಲ್ಲ”<verse eid="AMO 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 8:8"/>ಆ ಕೃತ್ಯಗಳಿಗೆ ದೇಶವು ನಡುಗಬೇಕಾಗುವುದಲ್ಲವೇ,</para>
  <para style="q" vid="AMO 8:8">ಅದರ ನಿವಾಸಿಗಳೆಲ್ಲರೂ ದುಃಖಿಸುವರಲ್ಲವೇ?</para>
  <para style="q" vid="AMO 8:8">ದೇಶವೆಲ್ಲಾ ನೈಲ್ ನದಿಯಂತೆ ಉಬ್ಬಿ ಅಲ್ಲಕಲ್ಲೋಲವಾಗುವುದು,</para>
  <para style="q" vid="AMO 8:8">ಐಗುಪ್ತದ ನದಿಯ ಹಾಗೆಯೇ,</para>
  <para style="q" vid="AMO 8:8">ಇಳಿದು ಹೋಗುವುದು.<verse eid="AMO 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 8:9"/>ಆ ದಿನದಲ್ಲಿ</para>
  <para style="q" vid="AMO 8:9">ಕರ್ತನಾದ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 8:9">“ಆ ದಿನದಲ್ಲಿ ಸೂರ್ಯನನ್ನು ಮಧ್ಯಾಹ್ನಕ್ಕೆ ಮುಣುಗಿಸುವೆನು,</para>
  <para style="q" vid="AMO 8:9">ಭೂಮಿಯನ್ನು ಹಗಲಿನಲ್ಲೇ ಕತ್ತಲು ಮಾಡುವೆನು.<verse eid="AMO 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 8:10"/>ನಿಮ್ಮ ಉತ್ಸವಗಳನ್ನು ದುಃಖಕ್ಕೆ ಮಾರ್ಪಡಿಸುವೆನು</para>
  <para style="q" vid="AMO 8:10">ಮತ್ತು ನಿಮ್ಮ ಹರ್ಷಗೀತೆಗಳನ್ನೆಲ್ಲಾ ಶೋಕಗೀತೆಗೆ ತಿರುಗಿಸುವೆನು.</para>
  <para style="q" vid="AMO 8:10">ಎಲ್ಲರೂ ಸೊಂಟಕ್ಕೆ ಗೋಣಿತಟ್ಟನ್ನು ಸುತ್ತಿಕೊಂಡು,</para>
  <para style="q" vid="AMO 8:10">ತಲೆಬೋಳಿಸಿಕೊಳ್ಳುವಂತೆ ಮಾಡುವೆನು.</para>
  <para style="q" vid="AMO 8:10">ನಿಮ್ಮ ಪ್ರಲಾಪವು ಏಕಪುತ್ರಶೋಕಕ್ಕೆ ಸಮಾನವಾಗುವುದು,</para>
  <para style="q" vid="AMO 8:10">ಅದು ಆದ ಮೇಲೆಯೂ ಶೋಕವು ಇದ್ದೇ ಇರುವುದು.<verse eid="AMO 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 8:11"/>ಇಗೋ, ಆ ದಿನಗಳು ಬರುವವು.” ಕರ್ತನಾದ ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 8:11">“ನಾನು ದೇಶಕ್ಕೆ ಕ್ಷಾಮವನ್ನು ಉಂಟುಮಾಡುವ ದಿನಗಳು ಬರುತ್ತವೆ,</para>
  <para style="q" vid="AMO 8:11">ಅದು ಅನ್ನದ ಕ್ಷಾಮವಲ್ಲ,</para>
  <para style="q" vid="AMO 8:11">ನೀರಿನ ಕ್ಷಾಮವಲ್ಲ,</para>
  <para style="q" vid="AMO 8:11">ಯೆಹೋವನ ವಾಕ್ಯಗಳ ಕ್ಷಾಮವೇ.<verse eid="AMO 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 8:12"/>ಸಮುದ್ರದಿಂದ ಸಮುದ್ರಕ್ಕೆ;</para>
  <para style="q" vid="AMO 8:12">ಉತ್ತರದಿಂದ ಪೂರ್ವಕ್ಕೂ ಬಳಲುತ್ತಾ ಹೋಗುವರು</para>
  <para style="q" vid="AMO 8:12">ಯೆಹೋವನ ವಾಕ್ಯವನ್ನು ಹುಡುಕುತ್ತಾ ಓಡಾಡುವರು,</para>
  <para style="q" vid="AMO 8:12">ಆದರೂ ಅದು ಸಿಕ್ಕುವುದಿಲ್ಲ.<verse eid="AMO 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 8:13"/>ಆ ದಿನದಲ್ಲಿ ಸುಂದರವಾದ ಯುವತಿಯರೂ</para>
  <para style="q" vid="AMO 8:13">ಮತ್ತು ಯೌವನಸ್ಥರು ಸಹ ಬಾಯಾರಿಕೆಯಿಂದ ಮೂರ್ಛೆ ಹೋಗುವರು.<verse eid="AMO 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 8:14"/>‘ದಾನೇ, ನಿನ್ನ ದೇವರ ಜೀವದಾಣೆ’ ಎಂದೂ</para>
  <para style="q" vid="AMO 8:14">‘ಮತ್ತು ಬೇರ್ಷೆಬದ ಮಾರ್ಗದ<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="fq" closed="false">ಬೇರ್ಷೆಬದ ಮಾರ್ಗದ </char><char style="ft" closed="false">ಅಂದರೆ ವಿಗ್ರಹಗಳನ್ನು ಆರಾಧಿಸುವುದು.</char></note> ಜೀವದಾಣೆ’” ಎಂದೂ ಹೇಳುವರು.</para>
  <para style="q" vid="AMO 8:14">ಅವರು ಸಮಾರ್ಯದ ಪಾಪದ ಮೇಲೆ ಪ್ರಮಾಣಮಾಡಿಕೊಂಡು,</para>
  <para style="q" vid="AMO 8:14">ಅವರು ಬಿದ್ದು ಮತ್ತೆ ಮೇಲೆ ಏಳಲಾರರು.<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s">ಇಸ್ರಾಯೇಲಿನ ನಾಶನ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>ಕರ್ತನು ಯಜ್ಞವೇದಿಯ ಪಕ್ಕದಲ್ಲಿ ನಿಂತಿರುವುದನ್ನು ಕಂಡೆನು. ಆತನು ಹೀಗೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟನು, “ಹೊಸ್ತಿಲುಗಳು ಕದಲುವಂತೆ ಕಂಬಗಳ ಬೋದಿಗೆಗಳನ್ನು ಬಲವಾಗಿ ಹೊಡೆ.</para>
  <para style="q" vid="AMO 9:1">ಅವುಗಳನ್ನು ಒಡೆದುಬಿಟ್ಟು ಎಲ್ಲರ ತಲೆಯ ಮೇಲೆ ಬೀಳುವ ಹಾಗೆ ಮಾಡಿ,</para>
  <para style="q" vid="AMO 9:1">ಉಳಿದವರನ್ನು ಖಡ್ಗದಿಂದ ಸಂಹರಿಸುವೆನು.</para>
  <para style="q" vid="AMO 9:1">ಅವರಲ್ಲಿ ಯಾರೂ ಓಡಿಹೋಗರು, ಯಾರೂ ತಪ್ಪಿಸಿಕೊಳ್ಳರು.<verse eid="AMO 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 9:2"/>ಪಾತಾಳದವರೆಗೆ ತೋಡಿಕೊಂಡು ಹೋದರೂ,</para>
  <para style="q" vid="AMO 9:2">ನನ್ನ ಕೈ ಅವರನ್ನು ಅಲ್ಲಿಂದ ಹಿಡಿದೆಳೆಯುವುದು,</para>
  <para style="q" vid="AMO 9:2">ಸ್ವರ್ಗದ ತನಕ ಹತ್ತಿದರೂ</para>
  <para style="q" vid="AMO 9:2">ಅಲ್ಲಿಂದಲೂ ಅವರನ್ನು ಇಳಿಸುವೆನು.<verse eid="AMO 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 9:3"/>ಕರ್ಮೆಲ್ ಬೆಟ್ಟದ ತುದಿಯಲ್ಲಿ ಅಡಗಿಕೊಂಡರೂ,</para>
  <para style="q" vid="AMO 9:3">ನಾನು ಅವರನ್ನು ಹುಡುಕಿ ಅಲ್ಲಿಂದಲೂ ಹಿಡಿದು ತರುವೆನು.</para>
  <para style="q" vid="AMO 9:3">ನನ್ನ ಕಣ್ಣಿಗೆ ಮರೆಯಾಗಿ ಸಮುದ್ರದತಳದಲ್ಲಿ ಅಡಗಿಕೊಂಡರೂ,</para>
  <para style="q" vid="AMO 9:3">ಅಲ್ಲಿಯೂ ನನ್ನ ಅಪ್ಪಣೆಯ ಪ್ರಕಾರ ಘಟಸರ್ಪವು ಅವರನ್ನು ಕಚ್ಚುವುದು.<verse eid="AMO 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 9:4"/>ಅವರು ತಮ್ಮ ಶತ್ರುಗಳ ವಶವಾಗಿ ಸೆರೆಗೆ ಹೋದರೂ,</para>
  <para style="q" vid="AMO 9:4">ಖಡ್ಗವು ನನ್ನ ಆಜ್ಞಾನುಸಾರ ಅಲ್ಲಿಯೂ ಅವರನ್ನು ಹತಿಸುವುದು.</para>
  <para style="q" vid="AMO 9:4">ಮೇಲಿಗಲ್ಲ, ಕೇಡಿಗಾಗಿಯೇ ಅವರ ಮೇಲೆ ದೃಷ್ಟಿಯಿಡುವೆನು.”<verse eid="AMO 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನು ಭೂಮಿಯನ್ನು ಮುಟ್ಟಿದ ಮಾತ್ರಕ್ಕೆ ಅದು ಕರಗಿ ಹೋಗುತ್ತದೆ;</para>
  <para style="q" vid="AMO 9:5">ಸಕಲ ನಿವಾಸಿಗಳು ಗೋಳಾಡುತ್ತಾರೆ;</para>
  <para style="q" vid="AMO 9:5">ನೆಲವೆಲ್ಲಾ ನೈಲ್ ನದಿಯಂತೆ ಉಬ್ಬಿ,</para>
  <para style="q" vid="AMO 9:5">ಐಗುಪ್ತದ ನದಿಯ ಹಾಗೆಯೇ ಇಳಿದು ಹೋಗುತ್ತದೆ.<verse eid="AMO 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6"/>ಉನ್ನತಲೋಕದಲ್ಲಿ ಉಪ್ಪರಿಗೆಯನ್ನು ಅನೇಕ ಅಂತಸ್ತನ್ನಾಗಿ ಕಟ್ಟಿಕೊಂಡು,</para>
  <para style="q" vid="AMO 9:6">ಭೂಲೋಕದ ಮೇಲೆ ಗುಮ್ಮಟವನ್ನು ಸ್ಥಾಪಿಸಿಕೊಂಡಿದ್ದಾನೆ.</para>
  <para style="q" vid="AMO 9:6">ಸಮುದ್ರದ ನೀರನ್ನು ಸೇದಿ,</para>
  <para style="q" vid="AMO 9:6">ಭೂಮಂಡಲದ ಮೇಲೆ ಹೊಯ್ಯುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 9:6">ಯೆಹೋವನೆಂಬುವುದೇ ಆತನ ನಾಮಧೇಯ.<verse eid="AMO 9:6"/></para>
  <para style="s">ಇಸ್ರಾಯೇಲರು ಉಳಿದ ಜನಾಂಗಗಳಿಗಿಂತ ಹೆಚ್ಚೇನೂ ಅಲ್ಲ</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ,</para>
  <para style="q" vid="AMO 9:7">“ಇಸ್ರಾಯೇಲರೇ, ನೀವು ನನ್ನ ಗಣನೆಯಲ್ಲಿ ಕೂಷ್ಯರ ಹಾಗಿದ್ದೀರಲ್ಲವೇ?</para>
  <para style="q" vid="AMO 9:7">ನಾನು ಇಸ್ರಾಯೇಲರನ್ನು ಐಗುಪ್ತ ದೇಶದಿಂದ ಫಿಲಿಷ್ಟಿಯರನ್ನು</para>
  <para style="q" vid="AMO 9:7">ಕಫ್ತೋರಿನಿಂದ ಅರಾಮ್ಯರನ್ನು ಕೀರಿನಿಂದ ಏಕರೀತಿಯಾಗಿ ಬರಮಾಡಲಿಲ್ಲವೇ?<verse eid="AMO 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 9:8"/>ಇಗೋ, ಕರ್ತನಾದ ಯೆಹೋವನು ಪಾಪವುಳ್ಳ ರಾಜ್ಯದ ಮೇಲೆ ದೃಷ್ಟಿಯಿಟ್ಟಿದ್ದಾನೆ,</para>
  <para style="q" vid="AMO 9:8">ಮತ್ತು ಅದನ್ನು ಭೂಮಂಡಲದೊಳಗಿಂದ ನಾಶಮಾಡುವನು,</para>
  <para style="q" vid="AMO 9:8">ಆದರೆ ಯಾಕೋಬಿನ ಮನೆತನವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡನು”</para>
  <para style="q" vid="AMO 9:8">ಇದು ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 9:9"/>“ಇಗೋ, ಧಾನ್ಯವನ್ನು ಜರಡಿಯಲ್ಲಿ ಜಾಲಿಸುವ ಪ್ರಕಾರ,</para>
  <para style="q" vid="AMO 9:9">ಇಸ್ರಾಯೇಲರನ್ನು ಸಕಲ ಜನಾಂಗಗಳಲ್ಲಿ ಹಾಕಿ ಜಾಲಿಸಬೇಕು”</para>
  <para style="q" vid="AMO 9:9">ಆದರೂ ಒಂದು ಕಾಳಾದರೂ ನೆಲಕ್ಕೆ ಬೀಳುವುದಿಲ್ಲ,</para>
  <para style="q" vid="AMO 9:9">ಎಂದು ಅಪ್ಪಣೆ ಕೊಡುವೆನು.<verse eid="AMO 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 9:10"/>ನಮ್ಮನ್ನು ಆಪತ್ತು ಹಿಂದಟದು; ನಮ್ಮನ್ನು ತಡೆಯುವುದಿಲ್ಲ,</para>
  <para style="q" vid="AMO 9:10">ಎನ್ನುವ ನನ್ನ ಜನರಲ್ಲಿರುವ ಸಮಸ್ತ ಪಾಪಿಗಳೆಲ್ಲರು ಖಡ್ಗದಿಂದ ಹತರಾಗುವರು.<verse eid="AMO 9:10"/></para>
  <para style="s">ಇಸ್ರಾಯೇಲಿನ ಮುಂದಿನ ಸೌಭಾಗ್ಯ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>“ಆ ದಿನದಲ್ಲಿ ನಾನು ದಾವೀದನ ಬಿದ್ದುಹೋಗಿರುವ ಗುಡಾರವನ್ನು ಎತ್ತಿ,</para>
  <para style="q" vid="AMO 9:11">ಅದರ ಬಿರುಕುಗಳನ್ನು ಮುಚ್ಚುವೆನು,</para>
  <para style="q" vid="AMO 9:11">ಹಾಳಾದದ್ದನ್ನು ಎಬ್ಬಿಸಿ,</para>
  <para style="q" vid="AMO 9:11">ಹಿಂದಿನ ದಿನಗಳಲ್ಲಿ ಮಾಡಿದ ಹಾಗೆ ಕಟ್ಟುವೆನು.<verse eid="AMO 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 9:12"/>ನನ್ನ ಜನರು ಎದೋಮಿನ ಉಳಿದ ಭಾಗವನ್ನು,</para>
  <para style="q" vid="AMO 9:12">ಯೆಹೋವನ ಪ್ರಜೆ ಎನ್ನಿಸಿಕೊಂಡಿದ್ದ ಸಕಲ ಜನಾಂಗಗಳನ್ನೂ</para>
  <para style="q" vid="AMO 9:12">ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವ ಹಾಗೆ ಹಾಳಾದದ್ದನ್ನು ನಿಲ್ಲಿಸಿ ಮೊದಲಿದ್ದಂತೆ ಅದನ್ನು ತಿರುಗಿ ಕಟ್ಟಿಸುವೆನು”</para>
  <para style="q" vid="AMO 9:12">ಎಂಬುದಾಗಿ ಯೆಹೋವನು ನುಡಿದಿದ್ದಾನೆ.<verse eid="AMO 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 9:13"/>ಯೆಹೋವನು ಇಂತೆನ್ನುತ್ತಾನೆ, “ಇಗೋ, ದಿನಗಳು ಬರುವವು,</para>
  <para style="q" vid="AMO 9:13">ಆ ಕಾಲದಲ್ಲಿ ಉಳುವವನು ಕೊಯ್ಯುವವನನ್ನೂ,</para>
  <para style="q" vid="AMO 9:13">ದ್ರಾಕ್ಷಿಯನ್ನು ತುಳಿಯುವವನು ಬಿತ್ತುವವನನ್ನೂ ಹಿಂದಟ್ಟುವರು.</para>
  <para style="q" vid="AMO 9:13">ಆಗ ಬೆಟ್ಟಗಳು ಹೊಸ ಸಿಹಿ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಸುರಿಸುವವು,</para>
  <para style="q" vid="AMO 9:13">ಎಲ್ಲಾ ಗುಡ್ಡಗಳು ಕರಗುವವು.<verse eid="AMO 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 9:14"/>ನಾನು ನನ್ನ ಜನರಾದ ಇಸ್ರಾಯೇಲರ ದುರಾವಸ್ಥೆಯನ್ನು ತಪ್ಪಿಸುವೆನು.</para>
  <para style="q" vid="AMO 9:14">ಅವರು ಹಾಳು ಬಿದ್ದ ಪಟ್ಟಣಗಳನ್ನು ಪುನಃ ಕಟ್ಟಿ ಅವುಗಳಲ್ಲಿ ವಾಸಿಸುವರು</para>
  <para style="q" vid="AMO 9:14">ಮತ್ತು ದ್ರಾಕ್ಷಿಯ ತೋಟಗಳನ್ನು ಮಾಡಿಕೊಂಡು ಅವುಗಳ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುವರು,</para>
  <para style="q" vid="AMO 9:14">ತೋಟಗಳನ್ನು ಮಾಡಿಕೊಂಡು ಅವುಗಳ ಫಲಗಳನ್ನು ತಿನ್ನುವರು.<verse eid="AMO 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 9:15"/>ನಾನು ಅವರನ್ನು ಸ್ವದೇಶದಲ್ಲಿ ನೆಲೆಗೊಳಿಸುವೆನು,</para>
  <para style="q" vid="AMO 9:15">ಅವರಿಗೆ ನಾನು ದಯಪಾಲಿಸಿದ ಸೀಮೆಯೊಳಗಿಂದ</para>
  <para style="q" vid="AMO 9:15">ಇನ್ನು ಮುಂದೆ ಯಾರೂ ಅವರನ್ನು ಕಿತ್ತುಹಾಕುವುದಿಲ್ಲ”</para>
  <para style="q" vid="AMO 9:15">ಇದು ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವನ ನುಡಿ.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
