<usx version="3.0">
  <book code="PSA" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright © 2017 Bridge Connectivity Solutions. This translation is made available to you under the terms of the Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">ಕೀರ್ತನೆಗಳು</para>
  <para style="toc1">ಕೀರ್ತನೆಗಳು</para>
  <para style="toc2">ಕೀರ್ತ</para>
  <para style="toc3">ಕೀರ್ತ</para>
  <para style="mt">ಕೀರ್ತನೆಗಳು</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಕೀರ್ತನೆಗಳು ಸಾಹಿತ್ಯಿಕ ಕವಿತೆಗಳ ಸಂಗ್ರಹವಾಗಿದೆ, ಅನೇಕ ಲೇಖಕರನ್ನು ಒಳಗೊಂಡಿರುವ ಸಂಯೋಜಿತ ಕೃತಿಯೆಂದು ಗುರುತಿಸಲ್ಪಡುವಂಥ ಹಳೇ ಒಡಂಬಡಿಕೆಯ ಪುಸ್ತಕಗಳಲ್ಲಿ ಇದು ಒಂದಾಗಿದೆ, ಇದು ಬಹು ಲೇಖಕರಿಂದ ಬರೆಯಲ್ಪಟ್ಟಿದೆ; ದಾವೀದನು 73 ಬರೆದನು, ಆಸಾಫನು 12 ಬರೆದನು, ಕೋರಹನ ಮಕ್ಕಳು 9 ಬರೆದರು, ಸೊಲೊಮೋನನು 3 ಬರೆದನು, ಏತಾನ್ ಮತ್ತು ಮೋಶೆ ತಲಾ ಒಂದೊಂದು ಬರೆದರು (ಕೀರ್ತ 90), ಮತ್ತು 51 ಕೀರ್ತನೆಗಳು ಅನಾಮಧೇಯ ಕೀರ್ತನೆಗಳಾಗಿವೆ. ಸೊಲೊಮೋನನನ್ನು ಮತ್ತು ಮೋಶೆಯನ್ನು ಹೊರತುಪಡಿಸಿ, ಈ ಎಲ್ಲಾ ಹೆಚ್ಚುವರಿ ಲೇಖಕರು ದಾವೀದನ ಆಳ್ವಿಕೆಯ ಸಮಯದಲ್ಲಿ ದೇವದರ್ಶನ ಗುಡಾರದ ಆರಾಧನೆಗೆ ಸಂಗೀತವನ್ನು ಒದಗಿಸಲು ಜವಾಬ್ದಾರರಾಗಿರುವ ಯಾಜಕರು ಅಥವಾ ಲೇವಿಯರು ಆಗಿದ್ದಾರೆ.</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿ.ಪೂ. 1440-430 ರ ನಡುವಿನ ಕಾಲದಲ್ಲಿ ಬರೆದಿರಬಹುದು.</para>
  <para style="ip">ಕೆಲವೊಂದು ಕೀರ್ತನೆಗಳು ಮೋಶೆಯ ಕಾಲದಷ್ಟು ಹಿಂದಿನ ಇತಿಹಾಸದಲ್ಲಿಯೂ ಬರೆಯಲ್ಪಟ್ಟವು, ದಾವೀದನ, ಆಸಾಫನ ಮತ್ತು ಸೊಲೊಮೋನನ ಕಾಲದಲ್ಲೆಲ್ಲಾ, ಬಾಬೆಲಿನ ಸೆರೆವಾಸದ ನಂತರ ಬದುಕಿದ ಎಜ್ರಹಿಯರ ಕಾಲದವರೆಗೂ ಬರೆಯಲ್ಪಟ್ಟವು, ಇದರರ್ಥ ಪುಸ್ತಕದ ಬರವಣಿಗೆಯು ಸಾವಿರ ವರ್ಷಗಳ ಕಾಲಾವಧಿಯಾಗಿದೆ.</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಇಸ್ರಾಯೇಲ್ ರಾಷ್ಟ್ರವು, ದೇವರು ಇತಿಹಾಸದುದ್ದಕ್ಕೂ ಅವರಿಗೂ ಮತ್ತು ವಿಶ್ವಾಸಿಗಳಿಗೂ ಮಾಡಿರುವಂಥದ್ದರ ನೆನಪೋಲೆಯಾಗಿದೆ.</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ಕೀರ್ತನೆಗಳ ಗ್ರಂಥವು ದೇವರು ಮತ್ತು ಆತನ ಸೃಷ್ಟಿ, ಯುದ್ಧ, ಆರಾಧನೆ, ಜ್ಞಾನ, ಪಾಪ ಮತ್ತು ದುಷ್ಟತ್ವ, ನ್ಯಾಯತೀರ್ಪು, ನೀತಿ ಮತ್ತು ಮೆಸ್ಸೀಯ ಆಗಮನದಂತಹ ವಿಷಯಗಳನ್ನು ಒಳಗೊಂಡಿದೆ. ಕೀರ್ತನೆಗಳ ಗ್ರಂಥವು ಅದರ ಅನೇಕ ಪುಟಗಳಾದ್ಯಂತ, ತನ್ನ ಓದುಗಾರರನ್ನು ದೇವರು ಯಾರಾಗಿದ್ದಾನೆಂದು ತಿಳಿಸಿ ಮತ್ತು ಆತನು ಮಾಡಿರುವಂಥ ಕಾರ್ಯಗಳಿಗಾಗಿ ಆತನನ್ನು ಸ್ತುತಿಸಲು ಪ್ರೋತ್ಸಾಹಿಸುತ್ತದೆ. ಕೀರ್ತನೆಗಳ ಗ್ರಂಥವು ನಮ್ಮ ದೇವರ ಮಹತ್ವವನ್ನು ವಿಶದಪಡಿಸುತ್ತದೆ, ಅಪತ್ತಿನ ಕಾಲದಲ್ಲಿ ನಮ್ಮೊಂದಿಗಿನ ಆತನ ನಂಬಿಗಸ್ತಿಕೆಯನ್ನು ದೃಢಪಡಿಸುತ್ತದೆ, ಮತ್ತು ಆತನ ವಾಕ್ಯದ ಸಂಪೂರ್ಣ ಕೇಂದ್ರೀಯತೆಯ ನಮಗೆ ನೆನಪಿಸುತ್ತದೆ.</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ಸ್ತುತಿ</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ಮೆಸ್ಸೀಯನ ಪುಸ್ತಕ — 1:1-41:13</para>
  <para style="io1">2. ಅಪೇಕ್ಷೆಯ ಪುಸ್ತಕ — 42:1-72:20</para>
  <para style="io1">3. ಇಸ್ರಾಯೇಲ್ಯರ ಪುಸ್ತಕ — 73:1-89:52</para>
  <para style="io1">4. ದೇವರ ನಿಯಮದ ಪುಸ್ತಕ — 90:1-106:48</para>
  <para style="io1">5. ಸ್ತುತಿಯ ಪುಸ್ತಕ — 107:1-150:6</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">ಪ್ರಥಮ ಭಾಗವು (1 - 41)</para>
  <para style="s">ಸನ್ಮಾರ್ಗಸ್ಥರು ಮತ್ತು ದುರ್ಮಾರ್ಗಸ್ಥರು</para>
  <para style="r">
    <ref loc="JER 17:5-8">ಯೆರೆ 17:5-8</ref>; <ref loc="MAT 7:13">ಮತ್ತಾ 7:13</ref>,<ref loc="MAT 7:14">14</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1"/>ಯಾರು ದುಷ್ಟರ ಆಲೋಚನೆಯಂತೆ ನಡೆಯದೆ,</para>
  <para style="q" vid="PSA 1:1">ಪಾಪಾತ್ಮರ ಮಾರ್ಗದಲ್ಲಿ ನಿಂತುಕೊಳ್ಳದೆ,</para>
  <para style="q" vid="PSA 1:1">ಧರ್ಮನಿಂದಕರೊಡನೆ ಕುಳಿತುಕೊಳ್ಳದೆ,<verse eid="PSA 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2"/>ಯೆಹೋವನ ಧರ್ಮಶಾಸ್ತ್ರದಲ್ಲಿ ಸಂತೋಷಿಸುತ್ತಾ,</para>
  <para style="q" vid="PSA 1:2">ಅದನ್ನೇ ಹಗಲಿರುಳು ಧ್ಯಾನಿಸುತ್ತಿರುವವನು ಎಷ್ಟೋ ಧನ್ಯನು.<verse eid="PSA 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3"/>ನೀರಿನ ಕಾಲುವೆಗಳ ಬಳಿಯಲ್ಲಿ ಬೆಳೆದಿರುವ ಮರದ ಹಾಗೆ ಅವನಿರುವನು.</para>
  <para style="q" vid="PSA 1:3">ಅಂಥ ಮರವು ಸೂಕ್ತಕಾಲದಲ್ಲಿ ಫಲಕೊಡುತ್ತದಲ್ಲಾ.</para>
  <para style="q" vid="PSA 1:3">ಅದರ ಎಲೆ ಬಾಡುವುದೇ ಇಲ್ಲ.</para>
  <para style="q" vid="PSA 1:3">ಅದರಂತೆ ಅವನ ಕಾರ್ಯವೆಲ್ಲವೂ ಸಫಲವಾಗುವುದು.<verse eid="PSA 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4"/>ದುಷ್ಟರೋ ಹಾಗಲ್ಲ;</para>
  <para style="q" vid="PSA 1:4">ಅವರು ಗಾಳಿ ಬಡಿದುಕೊಂಡು ಹೋಗುವ ಹೊಟ್ಟಿನಂತೆ ಇದ್ದಾರೆ.<verse eid="PSA 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5"/>ಆದುದರಿಂದ ದುಷ್ಟರು ನ್ಯಾಯವಿಚಾರಣೆಯಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 1:5">ಪಾಪಾತ್ಮರು ನೀತಿವಂತರ ಸಭೆಯಲ್ಲಿಯೂ ನಿಲ್ಲುವುದಿಲ್ಲ.<verse eid="PSA 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6"/>ಯೆಹೋವನು ನೀತಿವಂತರ ಮಾರ್ಗವನ್ನು ಲಕ್ಷಿಸುವನು;</para>
  <para style="q" vid="PSA 1:6">ದುಷ್ಟರ ಮಾರ್ಗವೋ ನಾಶವಾಗುವುದು.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="s">ಯೆಹೋವನಿಂದ ಅಭಿಷೇಕಿಸಲ್ಪಟ್ಟವನ ಸರ್ವಾಧಿಪತ್ಯ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1"/>ಅನ್ಯಜನಾಂಗಗಳು ದಂಗೆಗೆ ಏಳುವುದೂ,</para>
  <para style="q" vid="PSA 2:1">ಜನಾಂಗಗಳು ವ್ಯರ್ಥಕಾರ್ಯಗಳನ್ನು ಯೋಚಿಸುವುದೂ ಏಕೆ?<verse eid="PSA 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2"/>ಅರಸರು ಒಟ್ಟಾಗಿ ಸೇರಿ ಆಲೋಚಿಸುತ್ತಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 2:2">ದೇಶಾಧಿಪತಿಗಳು ಯೆಹೋವನಿಗೂ ಮತ್ತು ಆತನಿಂದ ಅಭಿಷೇಕಿಸಲ್ಪಟ್ಟವನಿಗೂ ವಿರುದ್ಧವಾಗಿ ಸನ್ನದ್ಧರಾಗಿ ನಿಂತಿದ್ದಾರೆ,<verse eid="PSA 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3"/>“ನಮಗೆ ಅವರು ಹಾಕಿದ ಬಂಧನಗಳನ್ನು ಕಿತ್ತುಹಾಕಿ,</para>
  <para style="q" vid="PSA 2:3">ಬೇಡಿಗಳನ್ನು ಮುರಿದು ಬಿಸಾಡೋಣ” ಎಂದು ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಾರಲ್ಲಾ.<verse eid="PSA 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4"/>ಪರಲೋಕದಲ್ಲಿ ಆಸೀನನಾಗಿರುವಾತನು ಅದಕ್ಕೆ ನಗುವನು;</para>
  <para style="q" vid="PSA 2:4">ಕರ್ತನು ಅವರನ್ನು ಪರಿಹಾಸ್ಯಮಾಡುವನು.<verse eid="PSA 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5"/>ಅನಂತರ ಆತನು ಸಿಟ್ಟಾಗಿ, ಕೋಪಾವೇಶದಿಂದ ಅವರನ್ನು ಕಳವಳಗೊಳಿಸಿ,<verse eid="PSA 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6"/>“ನಾನು ನೇಮಿಸಿದ ಅರಸನನ್ನು</para>
  <para style="q" vid="PSA 2:6">ಚೀಯೋನೆಂಬ<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">ಚೀಯೋನೆಂಬ </char><char style="ft" closed="false">ಸೊಲೊಮೋನನು ದೇವಾಲಯವನ್ನು ಕಟ್ಟಿದ ಬೆಟ್ಟಕ್ಕೆ (ಮೊರೀಯ ಬೆಟ್ಟ) ಚೀಯೋನ್ ಎಂಬ ಹೆಸರನ್ನು ಅನ್ವಯಿಸಲಾಗಿದೆ; ಕಾಲಾಂತರದಲ್ಲಿ ದೇವಾಲಯಕ್ಕೆ, ಯೆರೂಸಲೇಮ್ ಪಟ್ಟಣಕ್ಕೆ, ಮತ್ತು ಕೆಲವೊಮ್ಮೆ ಇಡೀ ಇಸ್ರಾಯೇಲ್ ದೇಶಕ್ಕೆ ಈ ಹೆಸರನ್ನು ಅನ್ವಯಿಸಲಾಗಿದೆ. ಬೆಟ್ಟವನ್ನು ಪವಿತ್ರ ಬೆಟ್ಟ ಎಂದು ಕರೆಯಲಾಗುತ್ತಿತ್ತು ಏಕೆಂದರೆ ಅದು ಪ್ರತ್ಯೇಕವಾಗಿ ದೇವರಿಗೆ ಸೇರಿದ್ದಾಗಿದೆ. ಯೆರೂಸಲೇಮ್ ಪಟ್ಟಣಕ್ಕೆ ಸಂಬಂಧಿಸಿದಂತೆ ಚೀಯೋನ್ ಮತ್ತು ಯೆರೂಸಲೇಮ್ ಎರಡನ್ನೂ ಕೀರ್ತನೆಗಳಲ್ಲಿ ಬಳಸಲಾಗಿರುವುದ್ದರಿಂದ, ಎರಡೂ ಪದಗಳನ್ನು “ಯೆರೂಸಲೇಮ್” ಎಂದು ಭಾಷಾಂತರಿಸುವಲ್ಲಿ ಕೆಲವು ಪ್ರಯೋಜನವಿದೆ. ನಿರ್ದಿಷ್ಟವಾಗಿ ಇಂದಿನ ಬಹುತೇಕ ಓದುಗರು ಆ ಹೆಸರುಳ್ಳ ಪಟ್ಟಣದ ಅಸ್ತಿತ್ವದ ಬಗ್ಗೆ ತಿಳಿದಿದ್ದಾರೆ. ಆದಾಗ್ಯೂ, ಚೀಯೋನ್ ಮತ್ತು ಯೆರೂಸಲೇಮ್ ವಿವಿಧ ಸಂದರ್ಭಗಳಲ್ಲಿ ಗೋಚರಿಸುತ್ತವೆ. </char></note> ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿಯೇ ಸ್ಥಾಪಿಸಿದ್ದಾಯಿತು” ಎಂದು ಹೇಳುವನು.<verse eid="PSA 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7"/>ನಾನು ಯೆಹೋವನ ಆಜ್ಞೆಯನ್ನು ತಿಳಿಸುತ್ತೇನೆ, ಕೇಳಿರಿ;</para>
  <para style="q" vid="PSA 2:7">ಆತನು ನನಗೆ, “ನನಗೆ ನೀನು ಮಗನು; ನಾನೇ ಈ ಹೊತ್ತು ನಿನ್ನನ್ನು ಪಡೆದಿದ್ದೇನೆ.<verse eid="PSA 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8"/>ನೀನು ಕೇಳಿಕೊಂಡರೆ ನಾನು ಅನ್ಯಜನಗಳನ್ನೆಲ್ಲಾ ನಿನಗೆ ಅಧೀನಮಾಡುವೆನು;</para>
  <para style="q" vid="PSA 2:8">ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯವರೆಗೂ ಇರುವ ಎಲ್ಲಾ ದೇಶಗಳನ್ನೂ ನಿನಗೆ ಸ್ವತ್ತಾಗಿ ಕೊಡುವೆನು.<verse eid="PSA 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9"/>ನೀನು ಕಬ್ಬಿಣದ ಗದೆಯಿಂದ ಅವರನ್ನು ನಾಶಮಾಡುವಿ;</para>
  <para style="q" vid="PSA 2:9">ಮಣ್ಣಿನ ಮಡಿಕೆಗಳನ್ನೋ ಎಂಬಂತೆ ಅವರನ್ನು ಒಡೆದುಹಾಕುವಿ” ಎಂದು ಹೇಳಿದನು.<verse eid="PSA 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10"/>ಆದುದರಿಂದ ಅರಸುಗಳಿರಾ, ವಿವೇಕಿಗಳಾಗಿರಿ;</para>
  <para style="q" vid="PSA 2:10">ದೇಶಾಧಿಪತಿಗಳಿರಾ, ಬುದ್ಧಿವಾದಕ್ಕೆ ಕಿವಿಗೊಡಿರಿ.<verse eid="PSA 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11"/>ಯೆಹೋವನನ್ನು ಭಯಭಕ್ತಿಯಿಂದ ಸೇವಿಸಿರಿ;</para>
  <para style="q" vid="PSA 2:11">ನಡುಗುತ್ತಾ ಉಲ್ಲಾಸಪಡಿರಿ.<verse eid="PSA 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12"/>ಆತನ ಮಗನಿಗೆ ಮುದ್ದಿಡಿರಿ;</para>
  <para style="q" vid="PSA 2:12">ಇಲ್ಲವಾದರೆ ಯೆಹೋವನ ಕೋಪವು ಬೇಗನೆ ಪ್ರಜ್ವಲಿಸಲು ನೀವು ದಾರಿಯಲ್ಲೇ ನಾಶವಾದೀರಿ.</para>
  <para style="q" vid="PSA 2:12">ಯೆಹೋವನನ್ನು ಆಶ್ರಯಿಸುವವರೆಲ್ಲರು ಧನ್ಯರು.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s">ಶತ್ರುಬಾಧಿತನಾದ ದೈವಭಕ್ತನ ಉದಯಗೀತೆ</para>
  <para style="d">ದಾವೀದನು ತನ್ನ ಮಗನಾದ ಅಬ್ಷಾಲೋಮನಿಂದ ಓಡಿಹೋದಾಗ ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1"/>ಯೆಹೋವನೇ, ನನ್ನ ವಿರೋಧಿಗಳು ಎಷ್ಟೋ ಹೆಚ್ಚಾಗಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 3:1">ನನಗೆ ವೈರಿಗಳಾಗಿ ನಿಂತ ಜನರು ಅತ್ಯಧಿಕವಾಗಿದ್ದಾರೆ.<verse eid="PSA 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2"/>ಅನೇಕರು ನನ್ನ ವಿಷಯದಲ್ಲಿ, “ಅವನಿಗೆ ದೇವರಿಂದ <note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ಅಥವಾ ರಕ್ಷಣೆಯುಂಟಾಗುವುದಿಲ್ಲ.</char></note>ಸಹಾಯವು ಆಗುವುದೇ ಇಲ್ಲ” ಎಂದು ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3"/>ಆದರೂ ಯೆಹೋವನೇ, ನೀನು ನನ್ನನ್ನು ಕಾಯುವ ಗುರಾಣಿಯೂ;</para>
  <para style="q" vid="PSA 3:3">ನೀನು ನನ್ನ ಗೌರವಕ್ಕೆ ಆಧಾರನೂ,</para>
  <para style="q" vid="PSA 3:3">ನನ್ನ ತಲೆಯನ್ನು ಎತ್ತುವಂತೆ ಮಾಡುವವನೂ ಆಗಿದ್ದೀ.<verse eid="PSA 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4"/>ನಾನು ಸ್ವರವೆತ್ತಿ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡುವಾಗ,</para>
  <para style="q" vid="PSA 3:4">ಆತನು ತನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಿಂದ ಸದುತ್ತರವನ್ನು ಅನುಗ್ರಹಿಸುತ್ತಾನೆ. <char style="qs">ಸೆಲಾ. </char><verse eid="PSA 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5"/>ಯೆಹೋವನು ನನ್ನನ್ನು ಕಾಪಾಡುವವನು,</para>
  <para style="q" vid="PSA 3:5">ಆದುದರಿಂದ ನಾನು ಮಲಗಿಕೊಂಡು ನಿದ್ದೆಮಾಡಿ ಸುಖವಾಗಿ ಎಚ್ಚರಗೊಂಡೆನು.<verse eid="PSA 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6"/>ನನ್ನ ಸುತ್ತಲು ಸನ್ನದ್ಧರಾಗಿ ನಿಂತಿರುವ</para>
  <para style="q" vid="PSA 3:6">ಸಾವಿರಾರು ವೈರಿಗಳಿಗಾದರೂ ನಾನು ಹೆದರೆನು.<verse eid="PSA 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ,</para>
  <para style="q" vid="PSA 3:7">ನನ್ನ ಎಲ್ಲಾ ಶತ್ರುಗಳ ದವಡೆಯನ್ನು ಬಡಿದು ಅವರ ಹಲ್ಲುಗಳನ್ನು ಉದುರಿಸಿಬಿಟ್ಟವನೇ,</para>
  <para style="q" vid="PSA 3:7">ಎದ್ದು ಬಂದು ನನ್ನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:8 </char>
      <char style="ft" closed="false">ಅಥವಾ ರಕ್ಷಣೆಯು.</char>
    </note>ಜಯವು ಯೆಹೋವನಿಂದಲೇ ಉಂಟಾಗುವುದು.</para>
  <para style="q" vid="PSA 3:8">ಯೆಹೋವನೇ, ನಿನ್ನ ಆಶೀರ್ವಾದವು ನಿನ್ನ ಜನರ ಮೇಲೆ ಇರಲಿ. <char style="qs">ಸೆಲಾ. </char><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s">ವಿಶ್ವಾಸಯುಕ್ತ ಸಂಧ್ಯಾಕಾಲದ ಗೀತೆ</para>
  <para style="d">ಪ್ರಧಾನ ಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1"/>ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುವ ನನ್ನ ದೇವರೇ, ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 4:1">ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು.</para>
  <para style="q" vid="PSA 4:1">ನನ್ನನ್ನು ಅಪತ್ತಿನಿಂದ ಬಿಡಿಸಿ, ಸುರಕ್ಷಿತ ಸ್ಥಳದಲ್ಲಿ ಸೇರಿಸಿದಾತನೇ,</para>
  <para style="q" vid="PSA 4:1">ನನ್ನನ್ನು ಕರುಣಿಸಿ ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಆಲಿಸು.<verse eid="PSA 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2"/>ಜನರೇ, ನೀವು ಎಷ್ಟರವರೆಗೆ ನನ್ನ ಗೌರವವನ್ನು ಕೆಡಿಸುವಿರಿ,</para>
  <para style="q" vid="PSA 4:2">ಎಷ್ಟರವರೆಗೆ ನನ್ನನ್ನು ಅವಮಾನಪಡಿಸುವಿರಿ?</para>
  <para style="q" vid="PSA 4:2">ಎಷ್ಟರವರೆಗೆ ವ್ಯರ್ಥವಾದದ್ದನ್ನು ಪ್ರೀತಿಸಿ ಸುಳ್ಳನ್ನು ಹಿಂಬಾಲಿಸುವಿರಿ? <char style="qs">ಸೆಲಾ </char><verse eid="PSA 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3"/>ಯೆಹೋವನು ತನ್ನ ಭಕ್ತನನ್ನು ತನಗೋಸ್ಕರ ಪ್ರತ್ಯೇಕಿಸಿಕೊಂಡಿದ್ದಾನೆ ಎಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ.</para>
  <para style="q" vid="PSA 4:3">ನಾನು ಆತನಿಗೆ ಮೊರೆಯಿಡುವಾಗೆಲ್ಲಾ ಆತನು ಕೇಳುತ್ತಾನೆ.<verse eid="PSA 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4"/>ಭಯಪಡಿರಿ, ಪಾಪಮಾಡಬೇಡಿರಿ;</para>
  <para style="q" vid="PSA 4:4">ಹಾಸಿಗೆಯ ಮೇಲೆ ಇರುವಾಗ ಹೃದಯದಲ್ಲೇ ಆಲೋಚಿಸಿಕೊಳ್ಳಿರಿ ಮತ್ತು ಮೌನವಾಗಿರಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5"/>ನ್ಯಾಯವಾದ ಯಜ್ಞಗಳನ್ನು ಸಮರ್ಪಿಸಿರಿ;</para>
  <para style="q" vid="PSA 4:5">ಯೆಹೋವನಲ್ಲಿಯೇ ಭರವಸವಿಡಿರಿ.<verse eid="PSA 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6"/>“ನಮಗೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರು ಯಾರಿದ್ದಾರೆ?” ಎಂದು ಅನೇಕರು ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 4:6">ಯೆಹೋವನೇ, ನೀನು ಪ್ರಸನ್ನಮುಖದಿಂದ ನಮ್ಮನ್ನು ನೋಡಬೇಕು.<verse eid="PSA 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7"/>ಧಾನ್ಯದ್ರಾಕ್ಷಿಗಳು ಸಮೃದ್ಧಿಯಾಗಿ ಬೆಳೆದ ಸುಗ್ಗಿ ಕಾಲದಲ್ಲಿ ಜನರಿಗಾಗುವ ಸಂತೋಷಕ್ಕಿಂತಲೂ</para>
  <para style="q" vid="PSA 4:7">ನೀನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಹೆಚ್ಚಾದ ಆನಂದವನ್ನು ಉಂಟುಮಾಡಿದ್ದೀ.<verse eid="PSA 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8"/>ನಾನು ನಿರ್ಭಯವಾಗಿರುವುದರಿಂದ ಮಲಗಿಕೊಂಡು ಕೂಡಲೆ ನಿದ್ದೆಮಾಡುವೆನು.</para>
  <para style="q" vid="PSA 4:8">ಏಕೆಂದರೆ ಯೆಹೋವನೇ, ನನಗೆ ಯಾವ ಅಪಾಯವೂ ಬಾರದಂತೆ ನೀನು ನನ್ನನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಕಾಪಾಡುತ್ತೀ.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s">ಭಕ್ತ ರಕ್ಷಕನಾದ ಯೆಹೋವನಿಗೆ ಉದಯಕೀರ್ತನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ರಂಧ್ರವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕ ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1"/>ಯೆಹೋವನೇ ನನ್ನ ಮೊರೆಗೆ ಕಿವಿಗೊಡು;</para>
  <para style="q" vid="PSA 5:1">ನನ್ನ ನರಳಾಟವನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದುಕೋ.<verse eid="PSA 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2"/>ನನ್ನ ಅರಸನೇ, ನನ್ನ ದೇವರೇ, ನಿನ್ನನ್ನೇ ಪ್ರಾರ್ಥಿಸುವೆನು;</para>
  <para style="q" vid="PSA 5:2">ನನ್ನ ಮೊರೆಯನ್ನು ಆಲಿಸು.<verse eid="PSA 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3"/>ಯೆಹೋವನೇ, ಉದಯಕಾಲದಲ್ಲಿ ನನ್ನ ಸ್ವರವು ನಿನಗೆ ಕೇಳಿಸುವುದು;</para>
  <para style="q" vid="PSA 5:3">ಉದಯಕಾಲದಲ್ಲಿಯೇ ನನ್ನ <note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">ಅಥವಾ ಯಜ್ಞವನ್ನು.</char></note>ಪ್ರಾರ್ಥನೆಯನ್ನು ನಿನಗೆ ಸಮರ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 5:3">ನಿನ್ನಿಂದ ಸದುತ್ತರವನ್ನು ಎದುರುನೋಡುತ್ತಿರುವೆನು.<verse eid="PSA 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4"/>ನೀನು ದುಷ್ಟತ್ವದಲ್ಲಿ ಸಂತೋಷಿಸುವ ದೇವರಲ್ಲ;</para>
  <para style="q" vid="PSA 5:4">ಕೆಟ್ಟದ್ದು ನಿನ್ನ ಬಳಿಯಲ್ಲಿ ತಂಗಲಾರದು.<verse eid="PSA 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5"/>ಸೊಕ್ಕಿನವರು ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ನಿಲ್ಲಲಾರರು;</para>
  <para style="q" vid="PSA 5:5">ಅಧರ್ಮಿಗಳೆಲ್ಲರನ್ನು ನೀನು ಹಗೆಮಾಡುವಿ.<verse eid="PSA 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6"/>ಸುಳ್ಳು ಹೇಳುವವರನ್ನು ನಾಶಮಾಡುವಿ;</para>
  <para style="q" vid="PSA 5:6">ಯೆಹೋವನೇ, ನರಹತ್ಯ ಮಾಡುವವರು ಮತ್ತು ಕಪಟಿಗಳು ನಿನಗೆ ಅಸಹ್ಯರಾಗಿದ್ದಾರೆ.<verse eid="PSA 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7"/>ನಾನಂತು ನಿನ್ನ ಮಹಾಕೃಪೆಯನ್ನು ಹೊಂದಿದವನಾಗಿ</para>
  <para style="q" vid="PSA 5:7">ನಿನ್ನ ಮಂದಿರದೊಳಕ್ಕೆ ಪ್ರವೇಶಿಸುವೆನು;</para>
  <para style="q" vid="PSA 5:7">ನಿನ್ನಲ್ಲಿಯೇ ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿ,</para>
  <para style="q" vid="PSA 5:7">ನಿನ್ನ ಪರಿಶುದ್ಧ ಆಲಯದ ಕಡೆಗೆ ಅಡ್ಡಬೀಳುವೆನು.<verse eid="PSA 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8"/>ಯೆಹೋವನೇ, ವಿರೋಧಿಗಳು ನನಗೆ ಕೇಡನ್ನೇ ಹಾರೈಸುತ್ತಿರುವುದರಿಂದ</para>
  <para style="q" vid="PSA 5:8">ನಿನ್ನ ನೀತಿಗೆ ಸರಿಯಾಗಿ ನನ್ನನ್ನು ನಡೆಸು;</para>
  <para style="q" vid="PSA 5:8">ನನ್ನ ಮುಂದೆ ನಿನ್ನ ಮಾರ್ಗವನ್ನು ಸರಾಗಮಾಡು.<verse eid="PSA 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9"/>ಅವರ ಬಾಯಲ್ಲಿ ಯಥಾರ್ಥತ್ವವಿಲ್ಲ;</para>
  <para style="q" vid="PSA 5:9">ಅವರು ನಾಲಿಗೆಯಿಂದ ಸವಿಮಾತನಾಡಿದರೂ,</para>
  <para style="q" vid="PSA 5:9">ಅವರ ಹೃದಯವು ನಾಶಕರವಾದ ಗುಂಡಿ,</para>
  <para style="q" vid="PSA 5:9">ಅವರ ಗಂಟಲು ತೆರೆದಿರುವ ಸಮಾಧಿ.<verse eid="PSA 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10"/>ದೇವರೇ, ಅವರು ನಿನಗೆ ವಿರುದ್ಧವಾಗಿ ತಿರುಗಿಬಿದ್ದವರು;</para>
  <para style="q" vid="PSA 5:10">ಆದುದರಿಂದ ಅವರನ್ನು ಅಪರಾಧಿಗಳೆಂದು ನಿರ್ಣಯಿಸು;</para>
  <para style="q" vid="PSA 5:10">ಅವರು ತಮ್ಮ ಕುಯುಕ್ತಿಯಿಂದಲೇ ಮೋಸ ಹೋಗಲಿ;</para>
  <para style="q" vid="PSA 5:10">ಅವರ ದ್ರೋಹವು ಅಪಾರವಾಗಿರುವುದರಿಂದ ಅವರನ್ನು ತಳ್ಳಿಬಿಡು.<verse eid="PSA 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11"/>ನಿನ್ನನ್ನು ಮೊರೆಹೊಕ್ಕವರೆಲ್ಲರು ನಿನ್ನಲ್ಲಿ ಸಂತೋಷಪಡುವರು;</para>
  <para style="q" vid="PSA 5:11">ನೀನು ಕಾಪಾಡುವವನೆಂದು ಅವರು ಯಾವಾಗಲೂ ಆನಂದ ಧ್ವನಿಮಾಡುವರು.</para>
  <para style="q" vid="PSA 5:11">ನಿನ್ನ ನಾಮವನ್ನು ಪ್ರೀತಿಸುವವರು ನಿನ್ನಲ್ಲಿ ಉಲ್ಲಾಸಗೊಳ್ಳುವರು.<verse eid="PSA 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12"/>ಯೆಹೋವನೇ, ನೀತಿವಂತನನ್ನು ಆಶೀರ್ವದಿಸುವವನು ನೀನೇ;</para>
  <para style="q" vid="PSA 5:12">ನಿನ್ನ ದಯವು ದೊಡ್ಡ ಗುರಾಣಿಯಂತೆ ಅವನನ್ನು ಆವರಿಸಿಕೊಳ್ಳುವುದು.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s">ಕಷ್ಟಪೀಡಿತನಾದ ಭಕ್ತನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ತಂತಿವಾದ್ಯದ ಮಂದರಸ್ಥಾಯಿಯೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನು ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1"/>ಯೆಹೋವನೇ, ಕೋಪದಿಂದ ನನ್ನನ್ನು ಗದರಿಸಬೇಡ;</para>
  <para style="q" vid="PSA 6:1">ರೋಷದಿಂದ ನನ್ನನ್ನು ದಂಡಿಸಬೇಡ.<verse eid="PSA 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2"/>ಯೆಹೋವನೇ, ಕನಿಕರಿಸು; ನಾನು ನಿಶ್ಶಕ್ತನಾಗಿ ಹೋಗಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 6:2">ಯೆಹೋವನೇ, ವಾಸಿಮಾಡು; ನನ್ನ ಎಲುಬುಗಳೆಲ್ಲಾ ಅದುರುತ್ತವೆ.<verse eid="PSA 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3"/>ನನ್ನ ಪ್ರಾಣವು ಸಹ ಬಹಳವಾಗಿ ತತ್ತರಿಸುತ್ತದೆ.</para>
  <para style="q" vid="PSA 6:3">ಯೆಹೋವನೇ, ಎಷ್ಟರ ವರೆಗೆ ನನ್ನನ್ನು ಕೈಬಿಟ್ಟಿರುವಿ?<verse eid="PSA 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4"/>ಯೆಹೋವನೇ, ಹಿಂತಿರುಗು, ನನ್ನನ್ನು ಬಿಡಿಸು;</para>
  <para style="q" vid="PSA 6:4">ನಿನ್ನ ಕೃಪೆಯ ನಿಮಿತ್ತ ನನ್ನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5"/>ಮೃತರಿಗೆ ನಿನ್ನ ಜ್ಞಾಪಕವಿರುವುದಿಲ್ಲವಲ್ಲಾ;</para>
  <para style="q" vid="PSA 6:5">ಪಾತಾಳದಲ್ಲಿ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವವರು ಯಾರು?<verse eid="PSA 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6"/>ನಾನು ನರಳಿ ನರಳಿ ದಣಿದಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 6:6">ಪ್ರತಿರಾತ್ರಿಯೂ ನನ್ನ ಮಂಚವು ಕಣ್ಣೀರಿನಿಂದ ತೇಲಾಡುತ್ತದೆ.</para>
  <para style="q" vid="PSA 6:6">ಹಾಸಿಗೆಯು ಕಣ್ಣೀರಿನಿಂದ ನೆನದುಹೋಗುತ್ತದೆ.<verse eid="PSA 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7"/>ದುಃಖದಿಂದ ನನ್ನ ಕಣ್ಣು ಬತ್ತಿ ಹೋಯಿತು;</para>
  <para style="q" vid="PSA 6:7">ವಿರೋಧಿಗಳ ಬಾಧೆಯ ದೆಸೆಯಿಂದಲೇ ಅವು ಮೊಬ್ಬಾಯಿತು.<verse eid="PSA 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8"/>ಧರ್ಮವನ್ನು ಮೀರಿ ನಡೆಯುವವರೇ,</para>
  <para style="q" vid="PSA 6:8">ನೀವೆಲ್ಲರೂ ನನ್ನಿಂದ ತೊಲಗಿಹೋಗಿರಿ;</para>
  <para style="q" vid="PSA 6:8">ಯೆಹೋವನು ನನ್ನ ಗೋಳಾಟಕ್ಕೆ ಕಿವಿಗೊಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9"/>ಆತನು ನನ್ನ ವಿಜ್ಞಾಪನೆಯನ್ನು ಕೇಳಿದ್ದಾನಲ್ಲಾ;</para>
  <para style="q" vid="PSA 6:9">ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಅಂಗೀಕರಿಸುವನು.<verse eid="PSA 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10"/>ನನ್ನ ವಿರೋಧಿಗಳೆಲ್ಲರು ನಾಚಿಕೆಯಿಂದ ಕಳವಳಗೊಳ್ಳುವರು;</para>
  <para style="q" vid="PSA 6:10">ಅವರು ಪಕ್ಕನೆ ಲಜ್ಜೆಗೊಂಡು ಹಿಂದಿರುಗುವರು.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s">ಅನ್ಯಾಯವಾದ ದೋಷಾರೋಪಣೆಗೆ ಗುರಿಯಾದ ದೇವಭಕ್ತನು ಪ್ರಾರ್ಥಿಸುವುದು</para>
  <para style="d">ಬೆನ್ಯಾಮೀನ್ ಕುಲದವನಾದ ಕೂಷನ ಮಾತುಗಳ ವಿಷಯದಲ್ಲಿ ದಾವೀದನು ಯೆಹೋವನಿಗಾಗಿ ಹಾಡಿದ ಗೀತೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ, ನಿನ್ನ ಮೊರೆಹೊಕ್ಕಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 7:1">ಬೆನ್ನಟ್ಟುವವರೆಲ್ಲರಿಂದ ತಪ್ಪಿಸಿ ನನ್ನನ್ನು ಕಾಪಾಡು.<verse eid="PSA 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2"/>ಇಲ್ಲವಾದರೆ ನನಗೆ ರಕ್ಷಕನಿಲ್ಲವೆಂದು ತಿಳಿದು,</para>
  <para style="q" vid="PSA 7:2">ಶತ್ರುವು ಸಿಂಹದಂತೆ ಮೇಲೆ ಬಿದ್ದು ನನ್ನನ್ನು ಹರಿದುಬಿಟ್ಟಾನು.<verse eid="PSA 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ, ನಾನು ಕೈಗಳಲ್ಲಿ ಅನ್ಯಾಯವುಳ್ಳವನೂ,<verse eid="PSA 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4"/>ಮಿತ್ರದ್ರೋಹಿಯೂ ಆಗಿದ್ದರೆ ಶತ್ರುವು ಹಿಂದಟ್ಟಿ ಬಂದು,</para>
  <para style="q" vid="PSA 7:4">ನನ್ನನ್ನು ಹಿಡಿದು, ನೆಲಕ್ಕೆ ಕೆಡವಿ ತುಳಿಯಲಿ;<verse eid="PSA 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5"/>ನನ್ನ ಮಾನವನ್ನು ಮಣ್ಣುಪಾಲು ಮಾಡಲಿ. ನಾನಂಥವನಲ್ಲ;</para>
  <para style="q" vid="PSA 7:5">ನಿಷ್ಕಾರಣ ವೈರಿಯನ್ನು ರಕ್ಷಿಸಿದೆನಲ್ಲ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6"/>ಯೆಹೋವನೇ, ನ್ಯಾಯಸ್ಥಾಪಕನೇ, ನನಗೋಸ್ಕರ ಎಚ್ಚರವಾಗು.</para>
  <para style="q" vid="PSA 7:6">ಮಹಾಕೋಪದಿಂದ ಎದ್ದುಬಂದು ನನ್ನ ವಿರೋಧಿಗಳ ಕ್ರೋಧವನ್ನು ಭಂಗಪಡಿಸು.<verse eid="PSA 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7"/>ಎಲ್ಲಾ ಜನಾಂಗಗಳು ನಿನ್ನ ಸುತ್ತಲು ಸಭೆಯಾಗಿ ಕೂಡಿರುವಲ್ಲಿ</para>
  <para style="q" vid="PSA 7:7">ನೀನು ಪುನಃ ಆರೋಹಣಮಾಡು.<verse eid="PSA 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8"/>ಯೆಹೋವನು ಎಲ್ಲಾ ಜನಾಂಗಳಿಗೂ ನ್ಯಾಯತೀರಿಸುವವನಾಗಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 7:8">ಯೆಹೋವನೇ, ನಿರಪರಾಧಿಯೂ, ನೀತಿವಂತನೂ ಆಗಿರುವ ನನಗೋಸ್ಕರ ನ್ಯಾಯತೀರಿಸು.<verse eid="PSA 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9"/>ಮನುಷ್ಯರ ಹೃದಯವನ್ನೂ ಮತ್ತು ಅಂತರಿಂದ್ರಿಯವನ್ನೂ</para>
  <para style="q" vid="PSA 7:9">ಪರಿಶೋಧಿಸುವ ನೀತಿಸ್ವರೂಪನಾದ ದೇವರೇ,</para>
  <para style="q" vid="PSA 7:9">ದುಷ್ಟರ ಕೆಟ್ಟತನವು ಇಲ್ಲದೆ ಹೋಗುವಂತೆ ಮಾಡು;</para>
  <para style="q" vid="PSA 7:9">ನೀತಿವಂತರನ್ನು ದೃಢಪಡಿಸು.<verse eid="PSA 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10"/>ನನ್ನನ್ನು ರಕ್ಷಿಸುವ ಗುರಾಣಿಯು ದೇವರೇ;</para>
  <para style="q" vid="PSA 7:10">ಆತನು ಯಥಾರ್ಥರನ್ನು ಕಾಪಾಡುತ್ತಾನೆ.<verse eid="PSA 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11"/>ದೇವರು ನ್ಯಾಯಕ್ಕೆ ಸರಿಯಾಗಿ ತೀರ್ಪುಕೊಡುವವನು;</para>
  <para style="q" vid="PSA 7:11">ಆತನು ಯಾವಾಗಲೂ ದುಷ್ಟರ ವಿಷಯದಲ್ಲಿ ಕೋಪವುಳ್ಳವನು.<verse eid="PSA 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12"/>ದೋಷಿಯು ಮನಸ್ಸನ್ನು ಬದಲಾಯಿಸಿಕೊಳ್ಳದೆ ಹೋದರೆ</para>
  <para style="q" vid="PSA 7:12">ಆತನು ತನ್ನ ಕತ್ತಿಯನ್ನು ಮಸೆಯುವನು.</para>
  <para style="q" vid="PSA 7:12">ತನ್ನ ಬಿಲ್ಲನ್ನು ಬಗ್ಗಿಸಿ ಸಿದ್ಧಮಾಡಿದ್ದಾನೆ.<verse eid="PSA 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13"/>ಆತನು ಅದಕ್ಕೆ ಮರಣಕರವಾದ ಅಗ್ನಿಬಾಣಗಳನ್ನು ಹೂಡಿ</para>
  <para style="q" vid="PSA 7:13">ಅವನ ಮೇಲೆ ಪ್ರಯೋಗಿಸುವುದಕ್ಕೆ ಗುರಿಯಿಟ್ಟು ನಿಂತಿದ್ದಾನೆ.<verse eid="PSA 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14"/>ನನ್ನ ಶತ್ರುವು ಬದಲಾಯಿಸಿಕೊಳ್ಳದೆ ಕೇಡನ್ನು ಹೆರಬೇಕೆಂದು ಪ್ರಸವವೇದನೆಯಲ್ಲಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 7:14">ಅವನು ಹಾನಿಯನ್ನು ಹಡೆಯುವೆನೆಂದು ನೆನಸಿಕೊಂಡರೂ,</para>
  <para style="q" vid="PSA 7:14">ಶೂನ್ಯವನ್ನೇ ಹೆತ್ತನು ನೋಡಿರಿ.<verse eid="PSA 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15"/>ಅವನು ಅಗೆದು ಅಗೆದು ಗುಂಡಿಯನ್ನು ತೋಡಿ,</para>
  <para style="q" vid="PSA 7:15">ಅದರೊಳಗೆ ತಾನೇ ಬಿದ್ದುಹೋದನಲ್ಲಾ.<verse eid="PSA 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16"/>ಅವನು ಮಾಡಿದ ಕುಯುಕ್ತಿ ಅವನ ತಲೆಯ ಮೇಲೆಯೇ ಬರುವುದು;</para>
  <para style="q" vid="PSA 7:16">ಅವನು ಮಾಡಬೇಕೆಂದಿದ್ದ ಅನ್ಯಾಯವು ಸ್ವಂತ ತಲೆಯ ಮೇಲೆ ಬೀಳುವುದು.<verse eid="PSA 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17"/>ಯೆಹೋವನು ಮಾಡಿದ ನ್ಯಾಯವಾದ ತೀರ್ಪಿಗಾಗಿ,</para>
  <para style="q" vid="PSA 7:17">ನಾನು ಆತನನ್ನು ಕೊಂಡಾಡುವೆನು.</para>
  <para style="q" vid="PSA 7:17">ಪರಾತ್ಪರ ದೇವನಾದ ಯೆಹೋವನ ನಾಮವನ್ನು ಸಂಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s">ದೇವರು ಅನುಗ್ರಹಿಸಿರುವ ಗೌರವಕ್ಕಾಗಿ ಆತನನ್ನು ಕೊಂಡಾಡುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಗಿತ್ತೀಯ ರಾಗದಿಂದ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನದು.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1"/>ನಮ್ಮ ಕರ್ತನಾದ ಯೆಹೋವನೇ, ನಿನ್ನ ನಾಮವು ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಎಷ್ಟೋ ಮಹಿಮೆಯುಳ್ಳದ್ದು.</para>
  <para style="q" vid="PSA 8:1">ಆಕಾಶಮಂಡಲದಲ್ಲಿ ನಿನ್ನ ವೈಭವವನ್ನು ಪ್ರಕಾಶಪಡಿಸಿದ್ದೀ.<verse eid="PSA 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2"/>ನಿನಗೆ ವಿರುದ್ಧವಾಗಿ ನಿಂತು ಮುಯ್ಯಿತೀರಿಸುವ</para>
  <para style="q" vid="PSA 8:2">ವೈರಿಗಳ ಬಾಯನ್ನು ಕಟ್ಟುವುದಕ್ಕೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 8:2">ನೀನು ಬಾಲಕರ ಮತ್ತು ಮೊಲೆಕೂಸುಗಳ ಬಾಯಿಂದ</para>
  <para style="q" vid="PSA 8:2">ಬಲವಾದ ಸಾಕ್ಷಿ ಉಂಟಾಗುವಂತೆ ಮಾಡಿದ್ದೀ.<verse eid="PSA 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3"/>ನಿನ್ನ ಕೈಕೆಲಸವಾಗಿರುವ ಆಕಾಶಮಂಡಲವನ್ನೂ,</para>
  <para style="q" vid="PSA 8:3">ನೀನು ಉಂಟುಮಾಡಿದ ಚಂದ್ರ ಮತ್ತು ನಕ್ಷತ್ರಗಳನ್ನೂ ನಾನು ನೋಡುವಾಗ,<verse eid="PSA 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4"/>ಮನುಷ್ಯನು ಎಷ್ಟು ಮಾತ್ರದವನು,</para>
  <para style="q" vid="PSA 8:4">ಅವನನ್ನು ನೀನು ಏಕೆ ಸ್ಮರಿಸಬೇಕು?</para>
  <para style="q" vid="PSA 8:4">ಮಾನವನು ಎಷ್ಟರವನು? ಅವನಲ್ಲಿ ಏಕೆ ಲಕ್ಷ್ಯವಿಡಬೇಕು?<verse eid="PSA 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5"/>ಅವನನ್ನು ದೇವರಿಗಿಂತ<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="fq" closed="false">ದೇವರಿಗಿಂತ </char><char style="ft" closed="false">ಅಥವಾ ದೇವದೂತರಿಗಿಂತ.</char></note> ಸ್ವಲ್ಪವೇ ಕಡಿಮೆಯಾಗಿ ಸೃಷ್ಟಿ ಮಾಡಿದಿಯಲ್ಲಾ;</para>
  <para style="q" vid="PSA 8:5">ಪ್ರಭಾವವನ್ನೂ ಮತ್ತು ಮಾನವನ್ನೂ ಅವನಿಗೆ ಕಿರೀಟವಾಗಿ ಇಟ್ಟಿದ್ದಿ.<verse eid="PSA 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6"/>ನೀನು ಸೃಷ್ಟಿಸಿದ ಎಲ್ಲಾ ವಸ್ತುಗಳ ಮೇಲೆ</para>
  <para style="q" vid="PSA 8:6">
    <note caller="+" style="f">
      <char style="fr" closed="false">8:6 </char>
      <char style="ft" closed="false">ಇಬ್ರಿಯ 2:6-9 ಅನ್ನು ನೋಡಿರಿ.</char>
    </note>ಪ್ರಭುತ್ವವನ್ನು ಅವನಿಗೆ ಅನುಗ್ರಹಿಸಿದಿ.<verse eid="PSA 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7"/>ನೀನು ಎಲ್ಲಾ ಕುರಿ, ದನಗಳನ್ನು ಮಾತ್ರವೇ ಅಲ್ಲದೆ ಕಾಡುಮೃಗಗಳು,<verse eid="PSA 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8"/>ಆಕಾಶದ ಪಕ್ಷಿಗಳು, ಸಮುದ್ರದ ಮೀನುಗಳು,</para>
  <para style="q" vid="PSA 8:8">ಅದರಲ್ಲಿ ಸಂಚರಿಸುವ ಸಕಲವಿಧವಾದ ಜೀವಜಂತುಗಳು,</para>
  <para style="q" vid="PSA 8:8">ಇವೆಲ್ಲವನ್ನೂ ಅವನಿಗೆ ಅಧೀನಮಾಡಿದ್ದೀಯಲ್ಲವೇ.<verse eid="PSA 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9"/>ನಮ್ಮ ಕರ್ತನಾದ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 8:9">ನಿನ್ನ ನಾಮವು ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಎಷ್ಟೋ ಮಹಿಮೆಯುಳ್ಳದ್ದು.<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s">ನ್ಯಾಯಸ್ಥಾಪಕನಾದ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುವ ಇಬ್ರಿಯ ಅಕ್ಷರಕ್ರಮಾನುಸಾರವಾದ ಕೀರ್ತನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಮೂತ್ಲಬ್ಬೇನೆಂಬ ರಾಗ; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1"/>ಯೆಹೋವನೇ, ಮನಃಪೂರ್ವಕವಾಗಿ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 9:1">ನೀನು ಮಾಡಿದ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನೆಲ್ಲಾ ವರ್ಣಿಸುವೆನು.<verse eid="PSA 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2"/>ಪರಾತ್ಪರನಾದ ದೇವರೇ, ನಾನು ನಿನ್ನಲ್ಲಿ ಸಂತೋಷಿಸಿ ಉತ್ಸಾಹಗೊಳ್ಳುವೆನು;</para>
  <para style="q" vid="PSA 9:2">ನಿನ್ನ ಹೆಸರನ್ನು ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3"/>ನನ್ನ ಹಗೆಗಳು ನಿನ್ನ ಎದುರಿನಿಂದ ಹಿಂದಿರುಗಿ ಎಡವಿಬಿದ್ದು ಹಾಳಾದರಲ್ಲಾ.<verse eid="PSA 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4"/>ನನ್ನ ವ್ಯಾಜ್ಯದಲ್ಲಿ ನೀನು ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸಿದಿ;</para>
  <para style="q" vid="PSA 9:4">ನೀನು ಆಸನಾರೂಢನಾಗಿ ನೀತಿಯಿಂದ ನ್ಯಾಯವನ್ನು ನಿರ್ಣಯಿಸುತ್ತಿ.<verse eid="PSA 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5"/>ನೀನು ಜನಾಂಗಗಳನ್ನು ಹೆದರಿಸಿ ದುಷ್ಟರನ್ನು ನಾಶ ಮಾಡಿದ್ದಿ,</para>
  <para style="q" vid="PSA 9:5">ಅವರ ಹೆಸರನ್ನು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಅಳಿಸಿಬಿಟ್ಟಿದ್ದಿ.<verse eid="PSA 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6"/>ಶತ್ರುಗಳು ನಿಶ್ಶೇಷವಾದರು;</para>
  <para style="q" vid="PSA 9:6">ನೀನು ಕೆಡವಿದ ಅವರ ಪಟ್ಟಣಗಳು ಸಂಪೂರ್ಣವಾಗಿ ಹಾಳಾದವು.</para>
  <para style="q" vid="PSA 9:6">ಅವರ ಸ್ಮರಣೆಯೇ ಇಲ್ಲವಾಯಿತು.<verse eid="PSA 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7"/>ಯೆಹೋವನಾದರೋ ಯಾವಾಗಲೂ ನೆಲೆಗೊಂಡಿದ್ದು,</para>
  <para style="q" vid="PSA 9:7">ನ್ಯಾಯವಿಚಾರಿಸುವುದಕ್ಕಾಗಿ ತನ್ನ ಸಿಂಹಾಸನವನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾನೆ.<verse eid="PSA 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8"/>ಆತನೇ ನೀತಿಗನುಸಾರವಾಗಿ ಲೋಕಕ್ಕೆ ನ್ಯಾಯ ತೀರಿಸುವವನು;</para>
  <para style="q" vid="PSA 9:8">ಆತನು ಜನಾಂಗಗಳಿಗೆ ಸತ್ಯಕ್ಕನುಸಾರವಾಗಿ ತೀರ್ಪುಕೊಡುವನು.<verse eid="PSA 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9"/>ಯೆಹೋವನು ಕುಗ್ಗಿದವರಿಗೆ ಆಶ್ರಯವೂ,</para>
  <para style="q" vid="PSA 9:9">ಆಪತ್ಕಾಲದಲ್ಲಿ ದುರ್ಗವೂ ಆಗಿರುವನು.<verse eid="PSA 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10"/>ಯೆಹೋವನೇ, ನಿನ್ನ ನಾಮಮಹಿಮೆಯನ್ನು ಬಲ್ಲವರು</para>
  <para style="q" vid="PSA 9:10">ನಿನ್ನಲ್ಲಿ ಭರವಸವಿಡುವರು;</para>
  <para style="q" vid="PSA 9:10">ಏಕೆಂದರೆ ನಿನ್ನ ಮೊರೆಹೋಗುವವರನ್ನು ನೀನು ಕೈಬಿಡುವವನಲ್ಲ.<verse eid="PSA 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11"/>ಚೀಯೋನಿನಲ್ಲಿ ವಾಸಿಸುವ ಯೆಹೋವನನ್ನು ಕೀರ್ತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 9:11">ಆತನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಜನಾಂಗಗಳಲ್ಲಿ ಪ್ರಕಟಿಸಿರಿ.<verse eid="PSA 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12"/>ಆತನು ಕುಗ್ಗಿದವರ ಮೊರೆಯನ್ನು ಮರೆಯದೆ</para>
  <para style="q" vid="PSA 9:12">ಪ್ರಾಣಾಪರಾಧಕ್ಕೆ ಮುಯ್ಯಿತೀರಿಸುವವನಾಗಿ ಅವರನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳುವನು.<verse eid="PSA 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13"/>ಯೆಹೋವನೇ, ಮರಣದ್ವಾರದೊಳಗೆ ಸೇರದಂತೆ;</para>
  <para style="q" vid="PSA 9:13">ನನ್ನನ್ನು ಉದ್ಧರಿಸುವವನೇ, ಕನಿಕರಿಸು;</para>
  <para style="q" vid="PSA 9:13">ಹಗೆಗಳಿಂದ ನನಗುಂಟಾದ ಬಾಧೆಯನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದುಕೋ.<verse eid="PSA 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14"/>ಆಗ ನಾನು ನಿನ್ನ ಸ್ತೋತ್ರವನ್ನು ಪ್ರಸಿದ್ಧಪಡಿಸುವೆನು;</para>
  <para style="q" vid="PSA 9:14">ನಿನ್ನಿಂದಾದ ರಕ್ಷಣೆಗಾಗಿ ಚೀಯೋನೆಂಬ ಕುಮಾರಿಯ ಬಾಗಿಲುಗಳಲ್ಲಿ ಹರ್ಷಿಸುವೆನು.<verse eid="PSA 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15"/>ಜನಾಂಗಗಳವರು ತಾವು ಮಾಡಿದ ಕುಣಿಯಲ್ಲಿ ತಾವೇ ಬಿದ್ದು ಹೋದರು;</para>
  <para style="q" vid="PSA 9:15">ಅವರು ಹಾಸಿದ ಬಲೆಯಲ್ಲಿ ಅವರ ಕಾಲೇ ಸಿಕ್ಕಿಕೊಂಡಿತು.<verse eid="PSA 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16"/>ಯೆಹೋವನು ನ್ಯಾಯತೀರಿಸುವವನಾಗಿ ತನ್ನನ್ನು ಪ್ರಕಟಿಸಿಕೊಂಡಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 9:16">ದುಷ್ಟರು ತಾವೇ ಕಲ್ಪಿಸಿದ ಕುಯುಕ್ತಿಯಲ್ಲಿ ಸಿಕ್ಕಿಕೊಂಡಿದ್ದಾರಲ್ಲಾ. ಹಿಗ್ಗಾಯೋನ್ <char style="qs">ಸೆಲಾ </char><verse eid="PSA 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17"/>ದುಷ್ಟರು ಅಂದರೆ ದೇವರನ್ನು ಅಲಕ್ಷ್ಯಮಾಡುವ ಜನಾಂಗಗಳವರೆಲ್ಲಾ</para>
  <para style="q" vid="PSA 9:17">ಪಾತಾಳಕ್ಕೆ ಇಳಿದುಹೋಗುವರು.<verse eid="PSA 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18"/>ದಿಕ್ಕಿಲ್ಲದವರು ಕಡೆಯವರೆಗೆ ಮರೆಯಲ್ಪಡುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 9:18">ದೀನರ ನಿರೀಕ್ಷೆಯು ಕೆಡುವುದೇ ಇಲ್ಲ.<verse eid="PSA 9:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19"/>ಯೆಹೋವನೇ, ಏಳು; ಮನುಷ್ಯಮಾತ್ರದವರು ಬಲಗೊಳ್ಳಬಾರದು.</para>
  <para style="q" vid="PSA 9:19">ಜನಾಂಗಗಳಿಗೆ ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ತೀರ್ಪು ಉಂಟಾಗಲಿ.<verse eid="PSA 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20"/>ಯೆಹೋವನೇ, ಅವರಿಗೆ ಭಯವನ್ನು ಹುಟ್ಟಿಸು;</para>
  <para style="q" vid="PSA 9:20">ಜನಾಂಗಗಳು ತಾವು ಮನುಷ್ಯಮಾತ್ರದವರೆಂದು ತಿಳಿದುಕೊಳ್ಳಲಿ. <char style="qs">ಸೆಲಾ. </char><verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="s">ಯೆಹೋವನು ಕುಗ್ಗಿದವರನ್ನು ರಕ್ಷಿಸಬೇಕೆಂದು ಬೇಡಿಕೊಳ್ಳುವ ಇಬ್ರಿಯ ಅಕ್ಷರಕ್ರಮಾನುಸಾರವಾದ ಕೀರ್ತನೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1"/>ಯೆಹೋವನೇ, ನೀನು ಏಕೆ ದೂರವಾಗಿ ನಿಂತಿದ್ದೀ?</para>
  <para style="q" vid="PSA 10:1">ಕಷ್ಟಕಾಲದಲ್ಲಿ ಏಕೆ ಮರೆಯಾಗುತ್ತೀ?<verse eid="PSA 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2"/>ದುಷ್ಟರು ಅಹಂಕಾರದಿಂದ ದೀನರನ್ನು ಬಹಳವಾಗಿ ಹಿಂಸಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 10:2">ಅವರು ಕಲ್ಪಿಸಿದ ಕುಯುಕ್ತಿಯಲ್ಲಿ ತಾವೇ ಸಿಕ್ಕಿ ಬೀಳಲಿ.<verse eid="PSA 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3"/>ದುಷ್ಟನು ತನ್ನ ಹೃದಯದ ಸಂಕಲ್ಪಗಳು ನೆರವೇರಿತೆಂದು ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 10:3">
    <note caller="+" style="f">
      <char style="fr" closed="false">10:3 </char>
      <char style="ft" closed="false">ಅಥವಾ ದುಷ್ಟನು ಲಾಭಬಡುಕನನ್ನು ಹರಸುತ್ತಾನೆ.</char>
    </note>ಲಾಭಬಡುಕನು ಯೆಹೋವನನ್ನು ದೂಷಿಸಿ ತಿರಸ್ಕರಿಸುತ್ತಾನೆ.<verse eid="PSA 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4"/>ದುಷ್ಟನು ಸೊಕ್ಕಿನ ಮುಖದಿಂದ, “ಯೆಹೋವನು ವಿಚಾರಿಸುವುದಿಲ್ಲ” ಎಂದು ಹೇಳಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 10:4">ದೇವರಿಲ್ಲ ಎಂಬುದಾಗಿ ಸದಾ ಯೋಚಿಸುತ್ತಾನೆ.<verse eid="PSA 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5"/>ಅವನ ಪ್ರಯತ್ನಗಳು ಯಾವಾಗಲೂ ಕೈಗೂಡುತ್ತವೆ;</para>
  <para style="q" vid="PSA 10:5">ಆದರೆ ನಿನ್ನ ನ್ಯಾಯತೀರ್ಪು ಮಹೋನ್ನತವಾಗಿರುವುದರಿಂದ</para>
  <para style="q" vid="PSA 10:5">ಅದು ಅವನ ಗ್ರಹಿಕೆಗೆ ಬರುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 10:5">ವೈರಿಗಳ ಗುಂಪನ್ನಾದರೋ ತಾತ್ಸಾರಮಾಡುತ್ತಾನೆ.<verse eid="PSA 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6"/>ಅವನು, “ನಾನು ಕದಲುವುದೇ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 10:6">ನನಗೆ ವಿಪತ್ತು ಎಂದೆಂದಿಗೂ ಸಂಭವಿಸುವುದಿಲ್ಲ” ಅಂದುಕೊಂಡಿದ್ದಾನೆ.<verse eid="PSA 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7"/>ಅವನ ಬಾಯಿಯು ಶಾಪ, ಬಲಾತ್ಕಾರ ಮತ್ತು ವಂಚನೆಗಳಿಂದ ತುಂಬಿದೆ;</para>
  <para style="q" vid="PSA 10:7">ಅವನ ನಾಲಿಗೆಯ ಕೆಳಗೆ ಹಾನಿಯೂ, ನಾಶನವೂ ಇವೆ.<verse eid="PSA 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8"/>ಅವನು ಗ್ರಾಮಗಳ ಸಂದುಗೊಂದುಗಳಲ್ಲಿ ಹೊಂಚಿಕೊಂಡಿದ್ದು,</para>
  <para style="q" vid="PSA 10:8">ಮರೆಯಾದ ಸ್ಥಳಗಳಲ್ಲಿ ನಿರಪರಾಧಿಗಳನ್ನು ಕೊಲ್ಲುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 10:8">ಅವನು ಗತಿಹೀನನನ್ನು ಹಿಡಿಯುವುದಕ್ಕೆ ಸಮಯ ನೋಡುತ್ತಾನೆ.<verse eid="PSA 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9"/>ಗವಿಯಲ್ಲಿ ಅಡಗಿಕೊಂಡಿರುವ ಸಿಂಹದಂತೆ ಅವನು ಮರೆಯಾಗಿ ಹೊಂಚಿಕೊಂಡಿರುವನು.</para>
  <para style="q" vid="PSA 10:9">ಅವನು ಬಲೆಯೊಡ್ಡಿ ಕಾದಿದ್ದು, ಕುಗ್ಗಿದವನನ್ನು ಹಿಡಿದು ಎಳೆದುಕೊಂಡು ಹೋಗುತ್ತಾನೆ.<verse eid="PSA 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10"/>ಕುಗ್ಗಿದವನು ಜಜ್ಜಲ್ಪಟ್ಟು ಉರುಳಿಕೊಳ್ಳುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 10:10">ಗತಿಯಿಲ್ಲದವನು ಅವನ ಬಲಾತ್ಕಾರದಿಂದ ಬಿದ್ದು ಹೋಗುತ್ತಾನೆ.<verse eid="PSA 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11"/>ಆ ದುಷ್ಟನು ತನ್ನೊಳಗೆ, “ದೇವರು ಇವನನ್ನು ಬಿಟ್ಟು ವಿಮುಖನಾಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 10:11">ಆತನು ನೋಡುವುದೇ ಇಲ್ಲ” ಅಂದುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PSA 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12"/>ಯೆಹೋವನೇ, ಏಳು; ದೇವರೇ, ಕುಗ್ಗಿದವನನ್ನು ಮರೆಯಬೇಡ;</para>
  <para style="q" vid="PSA 10:12">ಅವನನ್ನು ರಕ್ಷಿಸುವುದಕ್ಕೆ ಕೈಚಾಚು.<verse eid="PSA 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13"/>“ದೇವರು ವಿಚಾರಿಸುವುದೇ ಇಲ್ಲ” ಎಂದು ಹೇಳುತ್ತಾ,</para>
  <para style="q" vid="PSA 10:13">ದುಷ್ಟನು ನಿನ್ನನ್ನು ಏಕೆ ಅಲಕ್ಷ್ಯಮಾಡಬೇಕು?<verse eid="PSA 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14"/>ನೀನು ಅವರ ಅನ್ಯಾಯ ಹಾಗು ಬಲಾತ್ಕಾರಗಳನ್ನು ನೋಡಿದ್ದಿ;</para>
  <para style="q" vid="PSA 10:14">ಅವುಗಳನ್ನು ವಿಚಾರಿಸುತ್ತೀ, ಗತಿಯಿಲ್ಲದವನು ತನ್ನನ್ನು ನಿನಗೇ ಒಪ್ಪಿಸುವನು;</para>
  <para style="q" vid="PSA 10:14">ದಿಕ್ಕಿಲ್ಲದವನಿಗೆ ನೀನೇ ದಿಕ್ಕು.<verse eid="PSA 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15"/>ದುಷ್ಟನ ಭುಜಬಲವನ್ನು ಮುರಿದುಹಾಕು,</para>
  <para style="q" vid="PSA 10:15">ಕೆಡುಕನ ದುಷ್ಟತ್ವವನ್ನು ಶೋಧಿಸಿ ನಿರ್ಮೂಲಮಾಡಿಬಿಡು.<verse eid="PSA 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16"/>ಯೆಹೋವನು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಅರಸನಾಗಿರುವನು;</para>
  <para style="q" vid="PSA 10:16">ಆತನ ದೇಶದಲ್ಲಿ ಅನ್ಯಜನಗಳು ನಿಶ್ಶೇಷರಾದರು.<verse eid="PSA 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17"/>ಯೆಹೋವನೇ, ನೀನು ದೀನರ ಕೋರಿಕೆಯನ್ನು ನೆರವೇರಿಸುವವನೇ ಆಗಿದ್ದಿ;</para>
  <para style="q" vid="PSA 10:17">ಅವರ ಹೃದಯವನ್ನು ಧೈರ್ಯಪಡಿಸುತ್ತಿ; ಅವರ ಮೊರೆಗೆ ಕಿವಿಗೊಡುತ್ತಿ.<verse eid="PSA 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18"/>ನೀನು ದಿಕ್ಕಿಲ್ಲದವರ ಮತ್ತು ಕುಗ್ಗಿದವರ ನ್ಯಾಯವನ್ನು ವಿಚಾರಿಸುತ್ತಿ.</para>
  <para style="q" vid="PSA 10:18">ಹೀಗಿರುವಲ್ಲಿ ಇನ್ನು ಮುಂದೆ ಮಣ್ಣಿನಿಂದಾದ ಮನುಷ್ಯರಿಂದ ಅವರಿಗೆ ಹೆದರಿಕೆ ಉಂಟಾಗುವುದಿಲ್ಲ.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s">ಯೆಹೋವನ ಶರಣರಿಗೆ ದುರ್ಗತಿಯಿಲ್ಲ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನದು.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1"/>ನಾನು ಯೆಹೋವನನ್ನು ಆಶ್ರಯಿಸಿಕೊಂಡಿದ್ದೇನೆ. ನೀವು, “ಪಕ್ಷಿಗಳಂತೆ ನಿಮ್ಮ ಬೆಟ್ಟಗಳಿಗೆ ಓಡಿಹೋಗಿರಿ” ಎಂದು ಹೇಳುವುದೇಕೆ?<verse eid="PSA 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2"/>ದುಷ್ಟರು ಕತ್ತಲಲ್ಲಿ ಯಥಾರ್ಥ ಹೃದಯವುಳ್ಳವರನ್ನು ಕೊಲ್ಲಬೇಕೆಂದು ಬಿಲ್ಲುಬೊಗ್ಗಿಸಿ,</para>
  <para style="q" vid="PSA 11:2">ಹೆದೆಗೆ ಬಾಣವನ್ನು ಹೂಡಿದ್ದಾರೆ ನೋಡಿರಿ.<verse eid="PSA 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3"/>ಆಧಾರಗಳೇ ಕೆಡವಲ್ಪಟ್ಟ ಮೇಲೆ ನೀತಿವಂತನ ಗತಿ ಏನಾದೀತು?<verse eid="PSA 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4"/>ಯೆಹೋವನು ತನ್ನ ಪರಿಶುದ್ಧಮಂದಿರದಲ್ಲಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 11:4">ಆತನು ತನ್ನ ಸಿಂಹಾಸನವನ್ನು ಪರಲೋಕದಲ್ಲಿ ಸ್ಥಾಪಿಸಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 11:4">ಆತನ ಕಣ್ಣುಗಳು ಮಾನವರನ್ನು ನೋಡುತ್ತವೆ;</para>
  <para style="q" vid="PSA 11:4">ಆತನು ಅವರನ್ನು ಬಹು ಸೂಕ್ಷ್ಮವಾಗಿ ಪರಿಶೋಧಿಸುತ್ತಾನೆ.<verse eid="PSA 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5"/>ಯೆಹೋವನು ನೀತಿವಂತರನ್ನು ಮತ್ತು ಅನೀತಿವಂತರನ್ನು ಪರೀಕ್ಷಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 11:5">ಬಲಾತ್ಕಾರವನ್ನು ಪ್ರೀತಿಸುವವರನ್ನು ಆತನು ದ್ವೇಷಿಸುತ್ತಾನೆ.<verse eid="PSA 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6"/>ಆತನು ದುಷ್ಟರ ಮೇಲೆ ಬೆಂಕಿ ಗಂಧಕಗಳನ್ನು ಸುರಿಸಲಿ.</para>
  <para style="q" vid="PSA 11:6">ಉರಿಗಾಳಿಗಳನ್ನು ಅವರಿಗೆ ಪಾನವಾಗಮಾಡಲಿ.<verse eid="PSA 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7"/>ಏಕೆಂದರೆ ನೀತಿಸ್ವರೂಪನಾದ ಯೆಹೋವನು ನೀತಿಯನ್ನು ಮೆಚ್ಚುವವನಾಗಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 11:7">ಸಜ್ಜನರು ಆತನ ಸಾನ್ನಿಧ್ಯವನ್ನು ಸೇರುವರು.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s">ದುಷ್ಟಾಧಿಕಾರದಲ್ಲಿ ಭಕ್ತನು ಪ್ರಾರ್ಥಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಮಂದರಸ್ಥಾಯಿಯೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1"/>ಯೆಹೋವನೇ, ರಕ್ಷಿಸು; ಭಕ್ತರು ಮುಗಿದು ಹೋಗಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 12:1">ಜನರೊಳಗೆ ನಂಬಿಗಸ್ತರನ್ನು ಕಾಣುವುದೇ ಇಲ್ಲ.<verse eid="PSA 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2"/>ಪ್ರತಿಯೊಬ್ಬರು ನೆರೆಯವರೊಡನೆ ಸುಳ್ಳನ್ನಾಡುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 12:2">ಅವರು ವಂಚನೆಯ ತುಟಿಗಳಿಂದ ಹೊರಗೊಂದು ಒಳಗೊಂದು ಮಾತನಾಡುತ್ತಾರೆ.<verse eid="PSA 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3"/>ಯೆಹೋವನು ವಂಚನೆಯ ತುಟಿಗಳನ್ನೂ, ಬಡಾಯಿ ನಾಲಿಗೆಯನ್ನೂ ಕಡಿದುಬಿಡಲಿ.<verse eid="PSA 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4"/>ಅವರು, “ನಮ್ಮ ಮಾತುಗಳಿಗೆ ತಡೆಯಿಲ್ಲವಲ್ಲಾ;</para>
  <para style="q" vid="PSA 12:4">ನಮ್ಮ ತುಟಿಗಳು ನಮ್ಮವೇ; ನಮಗೆ ಒಡೆಯನು ಯಾರು?” ಎಂದು ಹೇಳಿಕೊಳ್ಳುತ್ತಾರಲ್ಲಾ.<verse eid="PSA 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5"/>ಯೆಹೋವನು, “ಕುಗ್ಗಿದವರ ಬಾಧೆಯನ್ನು ನೋಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 12:5">ಗತಿಯಿಲ್ಲದವರ ನರಳುವಿಕೆಯು ನನಗೆ ಕೇಳಿಸಿತು.</para>
  <para style="q" vid="PSA 12:5">ಈಗ ಎದ್ದು ಬಂದು ಅವರ ಇಷ್ಟಾರ್ಥವನ್ನು ನೆರವೇರಿಸುವೆನು.</para>
  <para style="q" vid="PSA 12:5">ಅವರು ಬಯಸಿದಂತೆ ಅವರನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಇರಿಸುವೆನು” ಎಂದು ಹೇಳುತ್ತಾನೆ.<verse eid="PSA 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6"/>ಯೆಹೋವನ ಮಾತುಗಳು ಯಥಾರ್ಥವಾದವುಗಳೇ;</para>
  <para style="q" vid="PSA 12:6">ಅವು ಏಳು ಸಾರಿ ಪುಟಕ್ಕೆ ಹಾಕಿದ ಚೊಕ್ಕ ಬೆಳ್ಳಿಯೋಪಾದಿಯಲ್ಲಿವೆ.<verse eid="PSA 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7"/>ಜನರಲ್ಲಿ ಎಲ್ಲೆಲ್ಲೂ ನೀಚರೇ ತುಂಬಿಕೊಂಡಿದ್ದರೂ,</para>
  <para style="q" vid="PSA 12:7">ಜನರೊಳಗೆ ದುಷ್ಟತ್ವ ಆಳ್ವಿಕೆಗೆ ಬಂದಿದ್ದರೂ,<verse eid="PSA 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8"/>ಯೆಹೋವನೇ, ನೀನು <note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">ಅಥವಾ ಅವರನ್ನು. </char></note>ನಮ್ಮನ್ನು ನೋಡಿದ್ದಿ,</para>
  <para style="q" vid="PSA 12:8">ನೀನು ನಿನ್ನ ಭಕ್ತರನ್ನು ದುಷ್ಟರಿಂದ ಸದಾಕಾಲವೂ ತಪ್ಪಿಸಿ ಕಾಪಾಡುವಿ.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s">ಶತ್ರುಪೀಡಿತನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನು ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1"/>ಯೆಹೋವನೇ, ನೀನು ಇನ್ನೆಷ್ಟರವರೆಗೆ ನನ್ನನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಮರೆತಿರುವಿ?</para>
  <para style="q" vid="PSA 13:1">ಇನ್ನೆಲ್ಲಿಯ ತನಕ ನನಗೆ ವಿಮುಖನಾಗಿರುವಿ?<verse eid="PSA 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2"/>ನಾನು ಇನ್ನೆಷ್ಟರವರೆಗೆ ಹಗಲೆಲ್ಲಾ ದುಃಖಾಕ್ರಾಂತನಾಗಿದ್ದು,</para>
  <para style="q" vid="PSA 13:2">ಆಲೋಚಿಸಿಕೊಳ್ಳುತ್ತಾ ಇರಬೇಕು?</para>
  <para style="q" vid="PSA 13:2">ಇನ್ನೆಲ್ಲಿಯ ತನಕ ವಿರೋಧಿಯು ನನಗೆ ದೊರೆಯಾಗಿರಬೇಕು?<verse eid="PSA 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ, ನನ್ನಲ್ಲಿ ದೃಷ್ಟಿಯಿಟ್ಟು ನನಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು;</para>
  <para style="q" vid="PSA 13:3">ನನಗೆ ಮರಣನಿದ್ರೆಯು ಉಂಟಾಗದಂತೆ ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ಕಳೆಗೊಳಿಸು.<verse eid="PSA 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4"/>ನನ್ನ ಶತ್ರುವು, “ನಾನು ಅವನನ್ನು ಜಯಿಸಿದೆನು” ಎಂದು ಹೇಳಿಕೊಳ್ಳಬಾರದು;</para>
  <para style="q" vid="PSA 13:4">ವೈರಿಗಳು, “ನನ್ನ ಎದುರಾಳಿಯು ಜಾರಿಬಿದ್ದನು” ಎಂದು ಹಿಗ್ಗಬಾರದು.<verse eid="PSA 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5"/>ನಾನಂತೂ ನಿನ್ನ ಕೃಪೆಯಲ್ಲಿ ಭರವಸವಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 13:5">ನೀನು ನನ್ನನ್ನು ರಕ್ಷಿಸಿದ್ದರಿಂದ ನನ್ನ ಹೃದಯವು ಹರ್ಷಗೊಳ್ಳುವುದು.<verse eid="PSA 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6"/>ಯೆಹೋವನ ಮಹೋಪಕಾರಕ್ಕಾಗಿ ಆತನಿಗೆ ಹಾಡುವೆನು.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s">ದುಷ್ಟ ನಾಸ್ತಿಕರಿಂದ ತಪ್ಪಿಸಿ ಕಾಪಾಡಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನದು.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1"/>ದುರ್ಮತಿಗಳು ತಮ್ಮ ಮನಸ್ಸಿನಲ್ಲಿ, “ದೇವರೇ ಇಲ್ಲ” ಎಂದು ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 14:1">ಅವರು ಕೆಟ್ಟುಹೋದವರು; ಹೇಯವಾದ ಅಕ್ರಮಗಳನ್ನು ನಡೆಸುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 14:1">ಅವರಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರೇ ಇಲ್ಲ.<verse eid="PSA 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2"/>ಮನುಷ್ಯರಲ್ಲಿ ತನ್ನ ಸಾನ್ನಿಧ್ಯವನ್ನು ಅಪೇಕ್ಷಿಸುವ ಬುದ್ಧಿವಂತರು ಇದ್ದಾರೋ,</para>
  <para style="q" vid="PSA 14:2">ಎಂದು ಯೆಹೋವನು ಆಕಾಶದಿಂದ ಮನುಷ್ಯರನ್ನು ನೋಡಲಾಗಿ,<verse eid="PSA 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3"/>ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವನು ಇಲ್ಲ, ಒಬ್ಬನಾದರೂ ಇಲ್ಲ.</para>
  <para style="q" vid="PSA 14:3">ಪ್ರತಿಯೊಬ್ಬನೂ ದಾರಿತಪ್ಪಿದವನು, ಎಲ್ಲರೂ ಕೆಟ್ಟು ಹೋದವರೇ.<verse eid="PSA 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4"/>ದುಷ್ಟತ್ವವನ್ನು ನಡೆಸುವವರೆಲ್ಲರು ತಿಳಿಯುವುದಿಲ್ಲವೋ?</para>
  <para style="q" vid="PSA 14:4">ಅವರು ನನ್ನ ಜನರನ್ನು ಆಹಾರವನ್ನೋ ಎಂಬಂತೆ ನುಂಗಿಬಿಡುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 14:4">ಯೆಹೋವನನ್ನು ಸ್ಮರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5"/>ಅವರು ಫಕ್ಕನೆ ಭಯಭ್ರಾಂತರಾಗುವರು;</para>
  <para style="q" vid="PSA 14:5">ಏಕೆಂದರೆ ದೇವರು ನೀತಿವಂತರ ಪಕ್ಷದಲ್ಲಿದ್ದಾನೆ.<verse eid="PSA 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6"/>ನೀವು ಕುಗ್ಗಿದವರ ಸಂಕಲ್ಪವನ್ನು ಭಂಗಪಡಿಸಿದರೂ</para>
  <para style="q" vid="PSA 14:6">ಯೆಹೋವನು ಅವರ ಆಶ್ರಯವಲ್ಲವೇ.<verse eid="PSA 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7"/>ಚೀಯೋನಿನಿಂದ ಇಸ್ರಾಯೇಲರಿಗೆ ರಕ್ಷಣೆಯು ಬೇಗನೆ ಬರಲಿ.</para>
  <para style="q" vid="PSA 14:7">ಯೆಹೋವನು ತನ್ನ ಜನರನ್ನು ದುರವಸ್ಥೆಯಿಂದ ತಪ್ಪಿಸಿದಾಗ,</para>
  <para style="q" vid="PSA 14:7">ಆತನ ಪ್ರಜೆಗಳಾಗಿರುವ ಯಾಕೋಬವಂಶದವರು ಉಲ್ಲಾಸಗೊಳ್ಳುವರು,</para>
  <para style="q" vid="PSA 14:7">ಇಸ್ರಾಯೇಲರು ಹರ್ಷಿಸುವರು.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s">ಯೆಹೋವನ ಸನ್ನಿಧಿಗೆ ಬರಲು ಯೋಗ್ಯರಾದವರು</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಗುಡಾರದಲ್ಲಿ ಇಳಿದುಕೊಂಡಿರುವುದಕ್ಕೆ ಯಾರು ಯೋಗ್ಯರು?</para>
  <para style="q" vid="PSA 15:1">ನಿನ್ನ ಪರಿಶುದ್ಧಪರ್ವತದಲ್ಲಿ ವಾಸಿಸತಕ್ಕವನು ಎಂಥವನಾಗಿರಬೇಕು?<verse eid="PSA 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2"/>ಅವನು ಸಜ್ಜನನೂ, ನೀತಿವಂತನೂ,</para>
  <para style="q" vid="PSA 15:2">ಮನಃಪೂರ್ವಕವಾಗಿ ಸತ್ಯದ ಮಾತುಗಳನ್ನಾಡುವವನೂ ಆಗಿರಬೇಕು.<verse eid="PSA 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3"/>ಅವನು ಚಾಡಿಯನ್ನು ಹೇಳದವನೂ,</para>
  <para style="q" vid="PSA 15:3">ಮತ್ತೊಬ್ಬರಿಗೆ ಅನ್ಯಾಯ ಮಾಡದವನೂ,</para>
  <para style="q" vid="PSA 15:3">ಯಾರನ್ನೂ ನಿಂದಿಸದವನೂ ಆಗಿರಬೇಕು.<verse eid="PSA 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4"/>ಅವನು ಭ್ರಷ್ಟರನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟವನೂ,</para>
  <para style="q" vid="PSA 15:4">ಯೆಹೋವನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರನ್ನು ಸನ್ಮಾನಿಸುವವನೂ,</para>
  <para style="q" vid="PSA 15:4">ನಷ್ಟವಾದರೂ ಪ್ರಮಾಣತಪ್ಪದವನೂ ಆಗಿರಬೇಕು.<verse eid="PSA 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5"/>ಅವನು ಸಾಲಕ್ಕೆ ಬಡ್ಡಿ ಕೇಳದವನೂ,</para>
  <para style="q" vid="PSA 15:5">ನಿರಪರಾಧಿಯ ಕೇಡಿಗಾಗಿ ಲಂಚವನ್ನು ತೆಗೆದುಕೊಳ್ಳದವನೂ ಆಗಿರಬೇಕು.</para>
  <para style="q" vid="PSA 15:5">ಇಂಥವನು ಎಂದಿಗೂ ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s">ಯೆಹೋವನ ಸೇವೆಯು ಪೂರ್ಣಾನಂದಕರವಾದದ್ದು</para>
  <para style="d">ದಾವೀದನ ಕಾವ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1"/>ದೇವರೇ, ನಾನು ನಿನ್ನ ಶರಣಾಗತನು; ನನ್ನನ್ನು ಕಾಪಾಡು.<verse eid="PSA 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2"/>ನಾನು ಯೆಹೋವನನ್ನು ಕುರಿತು, “ನೀನೇ ನನ್ನ ಒಡೆಯನು;</para>
  <para style="q" vid="PSA 16:2">ನನ್ನ ಸುಖವು ನಿನ್ನಲ್ಲಿಯೇ ಹೊರತು ಬೇರೆ ಇಲ್ಲ” ಎಂದು ಹೇಳುವೆನು.<verse eid="PSA 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3"/>ಭೂಲೋಕದಲ್ಲಿರುವ ದೇವಜನರ ವಿಷಯದಲ್ಲಿ,</para>
  <para style="q" vid="PSA 16:3">“ಇವರೇ ಶ್ರೇಷ್ಠರು, ಇವರೇ ನನಗೆ ಇಷ್ಟರಾದವರು” ಎಂದು ಹೇಳುವೆನು.<verse eid="PSA 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4"/>ಇತರ ದೇವರುಗಳನ್ನು ಅವಲಂಬಿಸಿದವರಿಗೆ ಬಹಳ ಕಷ್ಟನಷ್ಟಗಳು ಉಂಟಾಗುವವು.</para>
  <para style="q" vid="PSA 16:4">ಅವರಂತೆ ನಾನು ರಕ್ತವನ್ನು ಪಾನದ್ರವ್ಯವಾಗಿ ಸಮರ್ಪಿಸುವುದೇ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 16:4">ಅವರ ನಾಮಗಳನ್ನಾದರೂ ಉಚ್ಚರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5"/>ನನ್ನ ಪಾಲೂ, ನನ್ನ ಪಾನವೂ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 16:5">ನೀನೇ ನನ್ನ ಸ್ವತ್ತನ್ನು ಭದ್ರಗೊಳಿಸುತ್ತೀ.<verse eid="PSA 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6"/>ನನಗೆ ಪ್ರಾಪ್ತವಾಗಿರುವ ಸ್ವತ್ತು ರಮಣೀಯವಾದದ್ದು;</para>
  <para style="q" vid="PSA 16:6">ಅದು ನನಗೆ ಸಂತೃಪ್ತಿಕರವಾಗಿದೆ.<verse eid="PSA 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7"/>ಯೆಹೋವನು ನನಗೆ ಆಲೋಚನೆಯನ್ನು ಹೇಳಿಕೊಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 16:7">ನಾನು ಆತನನ್ನು ಕೊಂಡಾಡುವೆನು.</para>
  <para style="q" vid="PSA 16:7">ರಾತ್ರಿಯ ಸಮಯಗಳಲ್ಲಿ ನನ್ನ ಅಂತರಾತ್ಮವು ನನ್ನನ್ನು ಬೋಧಿಸುತ್ತದೆ.<verse eid="PSA 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8"/>ನಾನು ಯೆಹೋವನನ್ನು ಯಾವಾಗಲೂ ನನ್ನೆದುರಿನಲ್ಲಿಯೇ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 16:8">ಆತನು ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ಇರುವುದರಿಂದ ನಾನು ಎಂದಿಗೂ ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9"/>ಆದಕಾರಣ ನನ್ನ ಹೃದಯವು ಹರ್ಷಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 16:9">ನನ್ನ ಮನವು ಉಲ್ಲಾಸಗೊಳ್ಳುತ್ತದೆ;</para>
  <para style="q" vid="PSA 16:9">ನನ್ನ ಶರೀರವೂ ಸುರಕ್ಷಿತವಾಗಿರುವುದು.<verse eid="PSA 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10"/>ಏಕೆಂದರೆ ನೀನು ನನ್ನ ಜೀವಾತ್ಮವನ್ನು ಪಾತಾಳದಲ್ಲಿ ಬಿಡುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 16:10">ನಿನ್ನ ಭಕ್ತನಿಗೆ ಅಧೋಲೋಕವನ್ನು ನೋಡಗೊಡಿಸುವುದಿಲ್ಲ.<verse eid="PSA 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11"/>ನೀನು ನನಗೆ ಜೀವಮಾರ್ಗವನ್ನು ತಿಳಿಯಪಡಿಸುವಿ;</para>
  <para style="q" vid="PSA 16:11">ನಿನ್ನ ಸಮ್ಮುಖದಲ್ಲಿ ಪರಿಪೂರ್ಣ ಸಂತೋಷವಿದೆ;</para>
  <para style="q" vid="PSA 16:11">ನಿನ್ನ ಬಲಗೈಯಲ್ಲಿ ಶಾಶ್ವತ ಭಾಗ್ಯವಿದೆ.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s">ಶತ್ರುಗಳಿಂದ ಕಾಪಾಡಬೇಕೆಂಬ ನಿರಪರಾಧಿಯ ಬೇಡಿಕೆ</para>
  <para style="d">ದಾವೀದನ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1"/>ಯೆಹೋವನೇ, ನ್ಯಾಯವಾದುದನ್ನು ಆಲೈಸು;</para>
  <para style="q" vid="PSA 17:1">ನನ್ನ ಮೊರೆಗೆ ಲಕ್ಷ್ಯವಿಡು. ನನ್ನ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಡು;</para>
  <para style="q" vid="PSA 17:1">ಅದು ಕಪಟವಾದ ಬಾಯಿಂದ ಬಂದದ್ದಲ್ಲ.<verse eid="PSA 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2"/>ನಿನ್ನಿಂದ ನನಗೆ ನ್ಯಾಯವಾದ ತೀರ್ಪು ಉಂಟಾಗಲಿ;</para>
  <para style="q" vid="PSA 17:2">ನೀನು ನೀತಿಗನುಸಾರವಾಗಿ ನೋಡುವವನಲ್ಲವೇ.<verse eid="PSA 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3"/>ನೀನು ನನ್ನ ಹೃದಯವನ್ನು ಪರೀಕ್ಷಿಸಿದರೂ, ರಾತ್ರಿಯ ವೇಳೆ ವಿಚಾರಿಸಿದರೂ,</para>
  <para style="q" vid="PSA 17:3">ನನ್ನನ್ನು ಪುಟಕ್ಕೆ ಹಾಕಿ ಶೋಧಿಸಿದರೂ,</para>
  <para style="q" vid="PSA 17:3">ಯಾವ ದುರಾಲೋಚನೆಯಾದರೂ ನನ್ನಲ್ಲಿ ದೊರೆಯುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 17:3">
    <note caller="+" style="f">
      <char style="fr" closed="false">17:3 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಾನು ಇತರರಂತೆ ಕೆಟ್ಟ ಮಾತುಗಳನ್ನು ಆಡುವುದಿಲ್ಲ.</char>
    </note>ನನ್ನ ಬಾಯಿ ಮಾತುಗಳಲ್ಲಿ ತಪ್ಪುವುದಿಲ್ಲ ಎಂದು ತೀರ್ಮಾನಿಸಿದ್ದೇನೆ.<verse eid="PSA 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4"/>ನಾನಂತೂ ಲೋಕವ್ಯವಹಾರಗಳಲ್ಲಿ ಬಲಾತ್ಕಾರಿಗಳಂತೆ ನಡೆಯದೆ</para>
  <para style="q" vid="PSA 17:4">ನಿನ್ನ ಮಾತನ್ನೇ ಅನುಸರಿಸಿದ್ದೇನೆ.<verse eid="PSA 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5"/>ನಿನ್ನ ಮಾರ್ಗದಲ್ಲೇ ಹೆಜ್ಜೆಯಿಟ್ಟು ನಡೆಯುತ್ತಾ ಇದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 17:5">ನನ್ನ ಕಾಲು ಜಾರಲಿಲ್ಲ.<verse eid="PSA 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6"/>ದೇವರೇ, ನನಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸುವಿಯೆಂದು ಮೊರೆಯಿಡುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 17:6">ಕಿವಿಗೊಟ್ಟು ಕೇಳು.<verse eid="PSA 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7"/>ಭುಜಬಲವನ್ನು ಪ್ರಯೋಗಿಸಿ,</para>
  <para style="q" vid="PSA 17:7">ಶರಣಾಗತರನ್ನು ವಿರೋಧಿಗಳಿಂದ ರಕ್ಷಿಸುವಾತನೇ,</para>
  <para style="q" vid="PSA 17:7">ನಿನ್ನ ಪ್ರೀತಿಯನ್ನು ವಿಶೇಷವಾಗಿ ತೋರಿಸು.<verse eid="PSA 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8"/>ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡು ಬಾಧಿಸುತ್ತಿರುವ ದುಷ್ಟರಿಂದಲೂ,</para>
  <para style="q" vid="PSA 17:8">ಪ್ರಾಣವೈರಿಗಳಿಂದಲೂ ತಪ್ಪಿಸಿದ್ದಿ.<verse eid="PSA 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9"/>ನಿನ್ನ ರೆಕ್ಕೆಗಳ ಮರೆಯಲ್ಲಿಟ್ಟುಕೊಂಡು ನನ್ನನ್ನು ದುಷ್ಟರಿಂದ ಕಾಯಿ;</para>
  <para style="q" vid="PSA 17:9">ಕಣ್ಣು ಗುಡ್ಡಿನಂತೆಯೇ ಕಾಪಾಡು.<verse eid="PSA 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10"/>ಅವರು ತಮ್ಮ ಹೃದಯವನ್ನು ಕಠಿಣಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 17:10">ಅಹಂಕಾರದಿಂದ ಮಾತನಾಡುತ್ತಾರೆ.<verse eid="PSA 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11"/>ನಾವು ಎಲ್ಲಿ ಕಾಲಿಟ್ಟರೂ ಅಲ್ಲೆಲ್ಲಾ ನಮ್ಮನ್ನು ಸುತ್ತಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 17:11">ನಮ್ಮನ್ನು ನೆಲಕ್ಕೆ ಬೀಳಿಸಬೇಕೆಂದು ಸಮಯನೋಡುತ್ತಾರೆ.<verse eid="PSA 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12"/>ನನ್ನ ಶತ್ರುವು ಸೀಳಿಬಿಡಲಾಶಿಸುವ ಸಿಂಹದಂತೆಯೂ,</para>
  <para style="q" vid="PSA 17:12">ಮರೆಯಲ್ಲಿ ಹೊಂಚುಹಾಕಿರುವ ಪ್ರಾಯದ ಸಿಂಹದಂತೆಯೂ ಇದ್ದಾನೆ.<verse eid="PSA 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13"/>ಯೆಹೋವನೇ, ನೀನು ಅವನಿಗೆ ಎದುರಾಗಿ ನಿಂತು ಅವನನ್ನು ಕೆಡವಿಬಿಡು;</para>
  <para style="q" vid="PSA 17:13">ನಿನ್ನ ಕತ್ತಿಯಿಂದ ನನ್ನ ಪ್ರಾಣವನ್ನು ದುಷ್ಟರಿಗೆ ತಪ್ಪಿಸಿ ಕಾಪಾಡು.<verse eid="PSA 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14"/>ಯೆಹೋವನೇ, ಇಹಲೋಕವೇ ತಮ್ಮ ಪಾಲೆಂದು</para>
  <para style="q" vid="PSA 17:14">ನಂಬಿದ ನರರಿಗೆ ಸಿಕ್ಕದಂತೆ ನಿನ್ನ ಕೈಯಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸು;</para>
  <para style="q" vid="PSA 17:14">ನಿನ್ನ ಐಶ್ವರ್ಯದಿಂದ ಅವರ ಹೊಟ್ಟೆಯನ್ನು ತುಂಬಿಸಿದ್ದೀಯಲ್ಲಾ.</para>
  <para style="q" vid="PSA 17:14">ಅವರು ಸಂತಾನವೃದ್ಧಿಹೊಂದಿ ಉಳಿದ ಆಸ್ತಿಯನ್ನು ತಮ್ಮ ಮಕ್ಕಳಿಗೆ ಬಿಡುತ್ತಾರೆ.<verse eid="PSA 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15"/>ನಾನಾದರೋ ನಿರಪರಾಧಿಯು; ನಿನ್ನ ಸಾನ್ನಿಧ್ಯವನ್ನು ಸೇರುವೆನು.</para>
  <para style="q" vid="PSA 17:15">ನಾನು ಎಚ್ಚತ್ತಾಗ ನಿನ್ನ ನೀತಿಸ್ವರೂಪ ದರ್ಶನದಿಂದ ತೃಪ್ತನಾಗಿರುವೆನು.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s">ಜಯಪ್ರದನಾದ ಯೆಹೋವನ ಸ್ತುತಿ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು. ಯೆಹೋವನ ಸೇವಕನಾದ ದಾವೀದನು ಸೌಲನಿಂದಲೂ, ಎಲ್ಲಾ ಶತ್ರುಗಳ ಕೈಯಿಂದಲೂ ತಪ್ಪಿಸಲ್ಪಟ್ಟಾಗ ಯೆಹೋವನ ಘನಕ್ಕಾಗಿ ಈ ಪದ್ಯವನ್ನು ರಚಿಸಿ ಹೇಳಿದನು.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1"/>ನನ್ನ ಬಲವಾಗಿರುವ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 18:1">ನಿನ್ನಲ್ಲಿಯೇ ಮಮತೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2"/>ಯೆಹೋವನು ನನ್ನ ಬಂಡೆಯು, ನನ್ನ ಕೋಟೆಯು,</para>
  <para style="q" vid="PSA 18:2">ನನ್ನ ವಿಮೋಚಕನು, ನನ್ನ ದೇವರು, ನನ್ನ ಆಶ್ರಯಗಿರಿಯು,</para>
  <para style="q" vid="PSA 18:2">ನನ್ನ ಗುರಾಣಿಯು, ನನ್ನ ರಕ್ಷಣೆಯ ಕೊಂಬು ಮತ್ತು ನನ್ನ ದುರ್ಗವು ಆಗಿದ್ದಾನೆ.<verse eid="PSA 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3"/>ಯೆಹೋವನು ಸ್ತೋತ್ರಕ್ಕೆ ಅರ್ಹನು;</para>
  <para style="q" vid="PSA 18:3">ನಾನು ಆತನಿಗೆ ಮೊರೆಯಿಡಲು ಆತನು ನನ್ನನ್ನು ಶತ್ರುಗಳಿಂದ ರಕ್ಷಿಸುತ್ತಾನೆ.<verse eid="PSA 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4"/>ಮೃತ್ಯುಪಾಶಗಳು ನನಗೆ ಸುತ್ತಿಕೊಂಡವು;</para>
  <para style="q" vid="PSA 18:4">ನಾಶಪ್ರವಾಹವು ನನ್ನನ್ನು ನಡುಗಿಸಿತು.<verse eid="PSA 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5"/>ಪಾತಾಳಪಾಶಗಳು ನನ್ನನ್ನು ಆವರಿಸಿಕೊಂಡವು;</para>
  <para style="q" vid="PSA 18:5">ಮರಣಕರವಾದ ಉರುಲುಗಳು ನನ್ನೆದುರಿನಲ್ಲಿದ್ದವು.<verse eid="PSA 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6"/>ಅಂಥ ಕಷ್ಟದಲ್ಲಿ ನಾನು ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಟ್ಟೆನು;</para>
  <para style="q" vid="PSA 18:6">ನನ್ನ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸಿದೆನು.</para>
  <para style="q" vid="PSA 18:6">ಆತನು ತನ್ನ ಮಂದಿರದಲ್ಲಿ ನನ್ನ ಶಬ್ದವನ್ನು ಕೇಳಿದನು;</para>
  <para style="q" vid="PSA 18:6">ನನ್ನ ಕೂಗು ಆತನಿಗೆ ಕೇಳಿಸಿತು.<verse eid="PSA 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7"/>ಆಗ ಆತನಿಗೆ ಸಿಟ್ಟೇರಿದ್ದರಿಂದ,</para>
  <para style="q" vid="PSA 18:7">ಭೂಮಿಯು ಗಡಗಡನೆ ಕಂಪಿಸಿತು,</para>
  <para style="q" vid="PSA 18:7">ಪರ್ವತಗಳ ಬುಡಗಳು ನಡುಗಿ ಕದಲಿದವು.<verse eid="PSA 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8"/>ಆತನ ಮೂಗಿನಿಂದ ಹೊಗೆಯು ಎದ್ದು;</para>
  <para style="q" vid="PSA 18:8">ಆತನ ಬಾಯಿಂದ ಅಗ್ನಿಜ್ವಾಲೆ ಹೊರಟು,</para>
  <para style="q" vid="PSA 18:8">ಸಿಕ್ಕಿದ್ದೆಲ್ಲವನ್ನು ದಹಿಸಿ ಕೆಂಡವನ್ನಾಗಿ ಮಾಡಿತು.<verse eid="PSA 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9"/>ಆತನು ಆಕಾಶವನ್ನು ತಗ್ಗಿಸಿ ಇಳಿದು ಬಂದನು;</para>
  <para style="q" vid="PSA 18:9">ಆತನ ಪಾದಗಳ ಕೆಳಗೆ ಕಾರ್ಗತ್ತಲು ಇತ್ತು.<verse eid="PSA 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10"/>ಕೆರೂಬಿವಾಹನನಾಗಿ<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="fq" closed="false">ಕೆರೂಬಿವಾಹನನಾಗಿ </char><char style="ft" closed="false">ಹಳೆಯ ಒಡಂಬಡಿಕೆಯಲ್ಲಿರುವ ಕೆರೂಬ್ (ಬಹುವಚನ “ಕೆರೂಬಿಮ್”) ರೆಕ್ಕೆಯುಳ್ಳ ಜೀವಿಯಾಗಿದ್ದು, ಯೆಹೋವನ ಸ್ವರ್ಗೀಯ ಸಿಂಹಾಸನವನ್ನು ಕಾಯುತ್ತಿದ್ದಾರೆ.</char></note> ಹಾರಿ,</para>
  <para style="q" vid="PSA 18:10">ವಾಯುವೇ ಆತನ ರೆಕ್ಕೆಗಳೋ ಎಂಬಂತೆ ಆತನು ಇಳಿದು ಬಂದನು.<verse eid="PSA 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11"/>ಕತ್ತಲನ್ನು ತನ್ನ ಸುತ್ತಲು ಗುಡಾರದಂತೆ ಕವಿಸಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 18:11">ಜಲಮಯವಾಗಿರುವ ನೀಲಮೇಘಗಳ ಮಧ್ಯದಲ್ಲಿ ಮರೆಯಾದನು.<verse eid="PSA 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12"/>ಆತನ ಸನ್ನಿಧಿಯ ಪ್ರಕಾಶದಿಂದ ಕಲ್ಮಳೆಯೂ, ಉರಿಗೆಂಡಗಳೂ ಹೊರಟು,</para>
  <para style="q" vid="PSA 18:12">ಆತನ ಸುತ್ತಲಿದ್ದ ಕಪ್ಪು ಮೋಡಗಳನ್ನು ದಾಟಿ ಸುರಿದವು.<verse eid="PSA 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13"/>ಯೆಹೋವನು ಆಕಾಶದಲ್ಲಿ ಗುಡುಗಿದನು;</para>
  <para style="q" vid="PSA 18:13">ಪರಾತ್ಪರನಾದ ದೇವರು ಧ್ವನಿಗೊಟ್ಟನು. ಕಲ್ಮಳೆಯೂ, ಉರಿಗೆಂಡಗಳೂ ಹೊರಟವು.<verse eid="PSA 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14"/>ಆತನು ಬಾಣಗಳನ್ನೆಸೆದು ಶತ್ರುಗಳನ್ನು ಚದರಿಸಿಬಿಟ್ಟನು;</para>
  <para style="q" vid="PSA 18:14">ಸಿಡಿಲುಗಳಿಂದ ಕಳವಳಗೊಳಿಸಿದನು.<verse eid="PSA 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15"/>ಆಗ ಯೆಹೋವನೇ, ನಿನ್ನ ಗದರಿಕೆಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 18:15">ನಿನ್ನ ಶ್ವಾಸಭರದಿಂದಲೂ ಸಮುದ್ರದ ತಳವು ಕಾಣಿಸಿತು.</para>
  <para style="q" vid="PSA 18:15">ಭೂಮಂಡಲದ ಅಸ್ತಿವಾರಗಳು ಕಂಡುಬಂದವು.<verse eid="PSA 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16"/>ಆತನು ಮೇಲಣ ಲೋಕದಿಂದ ಕೈಚಾಚಿ, ನನ್ನನ್ನು ಹಿಡಿದು,</para>
  <para style="q" vid="PSA 18:16">ಮಹಾಜಲರಾಶಿಗಳೊಳಗಿಂದ ಎಳೆದನು.<verse eid="PSA 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17"/>ನನಗಿಂತ ಬಲಿಷ್ಠರೂ, ಪುಷ್ಟರೂ ಆಗಿ ದ್ವೇಷಿಸುತ್ತಿದ್ದ ಶತ್ರುಗಳಿಂದ</para>
  <para style="q" vid="PSA 18:17">ನನ್ನನ್ನು ಬಿಡಿಸಿ ರಕ್ಷಿಸಿದನು.<verse eid="PSA 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18"/>ಅವರು ನನ್ನ ವಿಪತ್ಕಾಲದಲ್ಲಿ ನನ್ನ ಮೇಲೆ ಬಿದ್ದರು,</para>
  <para style="q" vid="PSA 18:18">ಆಗ ಯೆಹೋವನು ನನಗೆ ಉದ್ಧಾರಕನಾದನು.<verse eid="PSA 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19"/>ಆತನು ನನ್ನನ್ನು ಬಿಡಿಸಿ ವಿಶಾಲ ಸ್ಥಳದಲ್ಲಿ ಸೇರಿಸಿದನು;</para>
  <para style="q" vid="PSA 18:19">ನನ್ನನ್ನು ಮೆಚ್ಚಿ ರಕ್ಷಿಸಿದನು.<verse eid="PSA 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20"/>ಯೆಹೋವನು ನನ್ನ ನೀತಿಗೆ ಸರಿಯಾಗಿ ಮೇಲನ್ನು ಮಾಡಿದನು,</para>
  <para style="q" vid="PSA 18:20">ನನ್ನ ಕೈಗಳ ಶುದ್ಧತ್ವಕ್ಕೆ ತಕ್ಕಂತೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಟ್ಟನು.<verse eid="PSA 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21"/>ನಾನು ಯೆಹೋವನ ಮಾರ್ಗವನ್ನೇ ಅನುಸರಿಸಿದೆನಲ್ಲಾ;</para>
  <para style="q" vid="PSA 18:21">ನನ್ನ ದೇವರನ್ನು ಬಿಟ್ಟು ದುಷ್ಟನಾಗಲಿಲ್ಲವಲ್ಲಾ.<verse eid="PSA 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22"/>ನಾನು ಆತನ ನೀತಿಯ ಆಜ್ಞೆಗಳನ್ನು ಯಾವಾಗಲೂ ನನ್ನ ಎದುರಿನಲ್ಲಿ ಇಟ್ಟುಕೊಂಡೆನು;</para>
  <para style="q" vid="PSA 18:22">ಆತನ ವಿಧಿಗಳನ್ನು ಅಲಕ್ಷ್ಯಮಾಡಲೇ ಇಲ್ಲ.<verse eid="PSA 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23"/>ನಾನು ಆತನ ದೃಷ್ಟಿಯಲ್ಲಿ ನಿರ್ದೋಷಿಯು;</para>
  <para style="q" vid="PSA 18:23">ಪಾಪದಲ್ಲಿ ಬೀಳದಂತೆ ಜಾಗರೂಕತೆಯಿಂದ ನಡೆದುಕೊಂಡೆನು.<verse eid="PSA 18:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24"/>ಆದುದರಿಂದ ನಾನು ನೀತಿವಂತನೂ, ನಿರಪರಾಧಿಯೂ ಎಂದು ನೋಡಿ,</para>
  <para style="q" vid="PSA 18:24">ಯೆಹೋವನು ತಕ್ಕ ಪ್ರತಿಫಲವನ್ನು ಕೊಟ್ಟನು.<verse eid="PSA 18:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25"/>ನೀನು ಕೃಪೆಯುಳ್ಳವನಿಗೆ ಕೃಪಾವಂತನೂ,</para>
  <para style="q" vid="PSA 18:25">ದೋಷವಿಲ್ಲದವನಿಗೆ ನಿರ್ದೋಷಿಯೂ,<verse eid="PSA 18:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26"/>ಶುದ್ಧನಿಗೆ ಪರಿಶುದ್ಧನೂ, ಮೂರ್ಖನಿಗೆ ವಕ್ರನೂ ಆಗಿರುವಿ.<verse eid="PSA 18:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27"/>ದೀನರನ್ನು ಉದ್ಧರಿಸುವವನೂ,</para>
  <para style="q" vid="PSA 18:27">ಗರ್ವದ ಕಣ್ಣುಳ್ಳವರನ್ನು ತಗ್ಗಿಸಿಬಿಡುವವನೂ ನೀನಲ್ಲವೋ?<verse eid="PSA 18:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28"/>ನೀನೇ ನನ್ನ ದೀಪವನ್ನು ಹೊತ್ತಿಸುವವನಲ್ಲವೇ;</para>
  <para style="q" vid="PSA 18:28">ನನ್ನ ದೇವರಾದ ಯೆಹೋವನು ನನಗೆ ಬೆಳಕನ್ನು ಕೊಟ್ಟು ಕತ್ತಲನ್ನು ಪರಿಹರಿಸುವವನು.<verse eid="PSA 18:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29"/>ನಿನ್ನ ಬಲದಿಂದ ದಂಡಿನ ಮೇಲೆ ಬೀಳುವೆನು;</para>
  <para style="q" vid="PSA 18:29">ನನ್ನ ದೇವರ ಸಹಾಯದಿಂದ ಗೋಡೆಯನ್ನು ಹಾರುವೆನು<note caller="+" style="f"><char style="fr" closed="false">18:29 </char><char style="fq" closed="false">ಗೋಡೆಯನ್ನು ಹಾರುವೆನು </char><char style="ft" closed="false">ಅಥವಾ ಗೋಡೆಯನ್ನು ತುಳಿದುಹಾಕುವೆನು.</char></note>.<verse eid="PSA 18:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30"/>ದೇವರ ಮಾರ್ಗವು ಯಾವ ದೋಷವೂ ಇಲ್ಲದ್ದು;</para>
  <para style="q" vid="PSA 18:30">ಯೆಹೋವನ ವಚನವು ಶುದ್ಧವಾದದ್ದು.</para>
  <para style="q" vid="PSA 18:30">ಆತನು ಆಶ್ರಿತರೆಲ್ಲರಿಗೆ ಗುರಾಣಿಯಾಗಿದ್ದಾನೆ.<verse eid="PSA 18:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31"/>ಯೆಹೋವನಲ್ಲದೆ ದೇವರು ಯಾರು?</para>
  <para style="q" vid="PSA 18:31">ನಮ್ಮ ದೇವರ ಹೊರತು ಶರಣನು ಎಲ್ಲಿ?<verse eid="PSA 18:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32"/>ನನಗೆ ಶೌರ್ಯವೆಂಬ ನಡುಕಟ್ಟನ್ನು ಬಿಗಿಯುವವನೂ,</para>
  <para style="q" vid="PSA 18:32">ನನ್ನ ಮಾರ್ಗವನ್ನು ಸರಾಗ ಮಾಡುವವನೂ ದೇವರೇ.<verse eid="PSA 18:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33"/>ನನ್ನ ಕಾಲನ್ನು ಜಿಂಕೆಯ ಕಾಲಿನಂತೆ ಚುರುಕು ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 18:33">ನನ್ನನ್ನು ಉನ್ನತಪ್ರದೇಶಗಳಲ್ಲಿ ನಿಲ್ಲಿಸುತ್ತಾನೆ.<verse eid="PSA 18:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34"/>ಆತನೇ ನನಗೆ ಯುದ್ಧವಿದ್ಯೆಯನ್ನು ಕಲಿಸಿದ್ದರಿಂದ</para>
  <para style="q" vid="PSA 18:34">ನಾನು ತಾಮ್ರದ ಬಿಲ್ಲನ್ನಾದರೂ ಉಪಯೋಗಿಸಬಲ್ಲೆನು.<verse eid="PSA 18:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35"/>ನೀನೇ ನನಗೋಸ್ಕರ ಗುರಾಣಿಯನ್ನು ಹಿಡಿದು ರಕ್ಷಿಸಿದ್ದೀ.</para>
  <para style="q" vid="PSA 18:35">ನಿನ್ನ ಬಲಗೈ ನನಗೆ ಆಧಾರ;</para>
  <para style="q" vid="PSA 18:35">ನಿನ್ನ ಕೃಪಾಕಟಾಕ್ಷವು ನನಗೆ ದೊಡ್ಡಸ್ತಿಕೆಯನ್ನು ಉಂಟುಮಾಡಿದೆ.<verse eid="PSA 18:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36"/>ನೀನು ನನ್ನ ಕಾಲುಗಳಿಗೆ ವಿಶಾಲ ಸ್ಥಳವನ್ನು ಕೊಟ್ಟಿದ್ದರಿಂದ</para>
  <para style="q" vid="PSA 18:36">ನನ್ನ ಪಾದಗಳು ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 18:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37"/>ನನ್ನ ಶತ್ರುಗಳನ್ನು ಹಿಂದಟ್ಟಿ ಹಿಡಿದುಕೊಳ್ಳುವೆನು;</para>
  <para style="q" vid="PSA 18:37">ಅವರನ್ನು ಇಲ್ಲದಂತೆ ಮಾಡುವವರೆಗೂ ಹಿಂದಿರುಗುವುದಿಲ್ಲ.<verse eid="PSA 18:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38"/>ಅವರನ್ನು ಹೊಡೆದು ಏಳಲಾರದಂತೆ ಮಾಡುವೆನು;</para>
  <para style="q" vid="PSA 18:38">ನನ್ನ ಪಾದದ ಕೆಳಗೆ ಬೀಳುವರು.<verse eid="PSA 18:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39"/>ನೀನು ನನಗೆ ಯುದ್ಧಕ್ಕಾಗಿ ಶೌರ್ಯವೆಂಬ ನಡುಕಟ್ಟನ್ನು ಬಿಗಿದಿದ್ದೀ;</para>
  <para style="q" vid="PSA 18:39">ಎದುರಾಳಿಗಳನ್ನು ಕುಗ್ಗಿಸಿ ನನಗೆ ಅಧೀನಮಾಡಿದ್ದೀ.<verse eid="PSA 18:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40"/>ನನ್ನ ಶತ್ರುಗಳು ನನಗೆ ಬೆನ್ನುಕೊಟ್ಟು ಓಡುವಂತೆ ಮಾಡಿದ್ದೀ;</para>
  <para style="q" vid="PSA 18:40">ನನ್ನ ಹಗೆಯವರನ್ನು ನಾನು ನಿರ್ಮೂಲಮಾಡುವೆನು.<verse eid="PSA 18:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41"/>ಅವರು ಕೂಗಿಕೊಂಡರೂ ರಕ್ಷಿಸುವವನಿಲ್ಲ;</para>
  <para style="q" vid="PSA 18:41">ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಟ್ಟರೂ ಆತನು ಉತ್ತರವನ್ನು ಕೊಡಲೇ ಇಲ್ಲ.<verse eid="PSA 18:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42"/>ಗಾಳಿಯಿಂದ ಬಡಿಸಿಕೊಂಡು ಹೋಗುವ ಧೂಳನ್ನೋ ಎಂಬಂತೆ</para>
  <para style="q" vid="PSA 18:42">ಅವರನ್ನು ಪುಡಿಪುಡಿಮಾಡಿದೆನು.</para>
  <para style="q" vid="PSA 18:42">ಬೀದಿಯಲ್ಲಿರುವ ಕೆಸರನ್ನೋ ಎಂಬಂತೆ ಅವರನ್ನು ಎಸೆದುಬಿಟ್ಟೆನು.<verse eid="PSA 18:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43"/>ಜನರ ಕಲಹಗಳಿಗೆ ನನ್ನನ್ನು ತಪ್ಪಿಸಿ ಜನಾಂಗಗಳಿಗೆ ದೊರೆಯಾಗುವಂತೆ ಮಾಡಿದ್ದೀ;</para>
  <para style="q" vid="PSA 18:43">ನಾನರಿಯದ ಜನಾಂಗದವರು ಸಹ ನನಗೆ ಅಧೀನರಾಗುವರು.<verse eid="PSA 18:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44"/>ನನ್ನ ಸುದ್ದಿಯನ್ನು ಕೇಳಿದ ಮಾತ್ರಕ್ಕೆ ನನಗೆ ವಿಧೇಯರಾಗುವರು;</para>
  <para style="q" vid="PSA 18:44">ದೇಶಾಂತರದವರು ನನ್ನ ಮುಂದೆ ಅಂಜಿ ನಡುಗುವರು.<verse eid="PSA 18:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45"/>ಅವರು ಧೈರ್ಯಗುಂದಿದವರಾಗಿ ತಮ್ಮ ತಮ್ಮ ಕೋಟೆಗಳಿಂದ ನಡುಗುತ್ತಾ ಬರುವರು.<verse eid="PSA 18:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46"/>ಯೆಹೋವನು ಚೈತನ್ಯಸ್ವರೂಪನು;</para>
  <para style="q" vid="PSA 18:46">ನನ್ನ ಶರಣನಿಗೆ ಸ್ತೋತ್ರ; ನನ್ನನ್ನು ರಕ್ಷಿಸುವ ದೇವರಿಗೆ ಕೊಂಡಾಟವಾಗಲಿ.<verse eid="PSA 18:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47"/>ಆತನು ನನ್ನ ಶತ್ರುಗಳಿಗೆ ಪ್ರತಿದಂಡನೆಮಾಡುವ ದೇವರು;</para>
  <para style="q" vid="PSA 18:47">ಜನಾಂಗಗಳನ್ನು ನನಗೆ ಅಧೀನಪಡಿಸುತ್ತಾನೆ.<verse eid="PSA 18:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48"/>ಶತ್ರುಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸುವಾತನೇ,</para>
  <para style="q" vid="PSA 18:48">ನೀನು ನನ್ನನ್ನು ನನ್ನ ಎದುರಾಳಿಗಳಿಗೆ ತಪ್ಪಿಸಿ ಉನ್ನತಪಡಿಸುತ್ತೀ;</para>
  <para style="q" vid="PSA 18:48">ಬಲಾತ್ಕಾರಿಗಳಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸುತ್ತೀ.<verse eid="PSA 18:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49"/>ಈ ಕಾರಣದಿಂದ ಯೆಹೋವನೇ, ಅನ್ಯಜನಗಳ ಮಧ್ಯದಲ್ಲಿ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q" vid="PSA 18:49">ನಿನ್ನ ನಾಮವನ್ನು ಸಂಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 18:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50"/>ಆತನು ತಾನು ನೇಮಿಸಿದ ಅರಸನಿಗೋಸ್ಕರ</para>
  <para style="q" vid="PSA 18:50">ವಿಶೇಷ ರಕ್ಷಣೆಯನ್ನು ದಯಪಾಲಿಸುವವನಾಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 18:50">ತಾನು ಅಭಿಷೇಕಿಸಿದ ದಾವೀದನಿಗೂ ಮತ್ತು ಅವನ ಸಂತತಿಯವರಿಗೂ</para>
  <para style="q" vid="PSA 18:50">ಸದಾಕಾಲ ಕೃಪೆಯನ್ನು ಅನುಗ್ರಹಿಸುವವನಾಗಿದ್ದಾನೆ.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s">ದೇವರ ಸೃಷ್ಟಿ ಮತ್ತು ಧರ್ಮಶಾಸ್ತ್ರದ ಮಹಿಮೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1"/>ಆಕಾಶವು ದೇವರ ಪ್ರಭಾವವನ್ನು ಪ್ರಚುರಪಡಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 19:1">ಗಗನವು ಆತನ ಕೈಕೆಲಸವನ್ನು ತಿಳಿಸುತ್ತದೆ.<verse eid="PSA 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2"/>ದಿನವು ದಿನಕ್ಕೆ ದೇವರ ಮಹಿಮೆಯನ್ನು ತಿಳಿಸುತ್ತಿರುವುದು;</para>
  <para style="q" vid="PSA 19:2">ರಾತ್ರಿಯು ರಾತ್ರಿಗೆ ಜ್ಞಾನವನ್ನು ಪ್ರಕಟಿಸುತ್ತಿರುವುದು.<verse eid="PSA 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3"/>ಶಬ್ದವಿಲ್ಲ, ಮಾತಿಲ್ಲ, ಅವುಗಳ ಸ್ವರ ಕೇಳಿಸುವುದಿಲ್ಲ.<verse eid="PSA 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4"/>ಆದರೂ ಅವುಗಳ ಪ್ರಭುತ್ವವು ಭೂಮಿಯಲ್ಲೆಲ್ಲಾ ಪ್ರಸರಿಸಿದೆ;</para>
  <para style="q" vid="PSA 19:4">ಅವುಗಳ ನುಡಿಗಳು ಲೋಕದ ಕಟ್ಟಕಡೆಯವರೆಗೂ ವ್ಯಾಪಿಸಿರುತ್ತವೆ.</para>
  <para style="q" vid="PSA 19:4">ಅಲ್ಲಿ ದೇವರು ಸೂರ್ಯನಿಗೋಸ್ಕರ ಗುಡಾರವನ್ನು ಏರ್ಪಡಿಸಿದ್ದಾನೆ.<verse eid="PSA 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5"/>ಅವನು ತನ್ನ ಮಂಟಪದೊಳಗಿಂದ ಬರುವ ಮದಲಿಂಗನೋ ಎಂಬಂತೆ ಹೊರಟುಬರುವನು.</para>
  <para style="q" vid="PSA 19:5">ಅವನು ಶೂರನಂತೆ ತನಗೆ ನೇಮಕವಾದ ಮಾರ್ಗದಲ್ಲಿ ಓಡುವುದಕ್ಕೆ ಉಲ್ಲಾಸಗೊಂಡಿದ್ದಾನೆ.<verse eid="PSA 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6"/>ಆಕಾಶದ ಒಂದು ಕಡೆಯಿಂದ ಹೊರಟು ಮತ್ತೊಂದು ಕಡೆಗೆ ಬರುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 19:6">ಅವನ ಬಿಸಿಲಿಗೆ ಮರೆಯಾದದ್ದು ಒಂದೂ ಇಲ್ಲ.<verse eid="PSA 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7"/>ಯೆಹೋವನ ಧರ್ಮಶಾಸ್ತ್ರವು ಲೋಪವಿಲ್ಲದ್ದು;</para>
  <para style="q" vid="PSA 19:7">ಅದು ಪ್ರಾಣವನ್ನು ಉಜ್ಜೀವಿಸಮಾಡುವಂಥದ್ದು.</para>
  <para style="q" vid="PSA 19:7">ಯೆಹೋವನ ಕಟ್ಟಳೆಗಳು ನಂಬಿಕೆಗೆ ಯೋಗ್ಯವಾದದ್ದು;</para>
  <para style="q" vid="PSA 19:7">ಅವು ಬುದ್ಧಿಹೀನರಿಗೆ ವಿವೇಕಪ್ರದವಾಗಿದೆ.<verse eid="PSA 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8"/>ಯೆಹೋವನ ಆಜ್ಞೆಗಳು ನೀತಿಯುಳ್ಳವುಗಳಾಗಿವೆ;</para>
  <para style="q" vid="PSA 19:8">ಮನಸ್ಸನ್ನು ಹರ್ಷಪಡಿಸುತ್ತವೆ.</para>
  <para style="q" vid="PSA 19:8">ಯೆಹೋವನ ಆಜ್ಞೆ ಪವಿತ್ರವಾದದ್ದು; ಕಣ್ಣುಗಳನ್ನು ಕಳೆಗೊಳಿಸುತ್ತದೆ.<verse eid="PSA 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9"/>ಯೆಹೋವನ ಭಯ ಪರಿಶುದ್ಧವಾಗಿದೆ; ಅದು ಶಾಶ್ವತವಾದದ್ದೇ.</para>
  <para style="q" vid="PSA 19:9">ಯೆಹೋವನ ಕಟ್ಟಳೆಗಳು ಯಥಾರ್ಥವಾದವುಗಳು; ಅವು ಕೇವಲ ನ್ಯಾಯವಾಗಿವೆ.<verse eid="PSA 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10"/>ಅವು ಬಂಗಾರಕ್ಕಿಂತಲೂ, ಅಪರಂಜಿರಾಶಿಗಿಂತಲೂ ಅಪೇಕ್ಷಿಸತಕ್ಕವುಗಳು.</para>
  <para style="q" vid="PSA 19:10">ಅವು ಜೇನಿಗಿಂತಲೂ, ಶೋಧಿಸಿದ ಜೇನುತುಪ್ಪಕ್ಕಿಂತಲೂ ಸಿಹಿಯಾಗಿವೆ.<verse eid="PSA 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11"/>ಅವುಗಳ ಮೂಲಕ ನಿನ್ನ ದಾಸನಿಗೆ ವಿವೇಚನೆ ಉಂಟಾಗುತ್ತದೆ;</para>
  <para style="q" vid="PSA 19:11">ಅವುಗಳನ್ನು ಕೈಕೊಳ್ಳುವುದರಿಂದ ಬಹಳ ಫಲ ದೊರೆಯುತ್ತದೆ.<verse eid="PSA 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12"/>ತನ್ನ ತಪ್ಪುಗಳನ್ನೆಲ್ಲಾ ತಿಳಿದುಕೊಳ್ಳುವವನು ಯಾರು?</para>
  <para style="q" vid="PSA 19:12">ಮರೆಯಾದ ದೋಷಗಳಿಂದ ನನ್ನನ್ನು ನಿರ್ಮಲಮಾಡು.<verse eid="PSA 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13"/>ಅದಲ್ಲದೆ ಬೇಕೆಂದು ಪಾಪಮಾಡದಂತೆ ನಿನ್ನ ದಾಸನನ್ನು ಕಾಪಾಡು.</para>
  <para style="q" vid="PSA 19:13">ಅಂಥ ಪಾಪಗಳು ನನ್ನನ್ನು ಆಳದಿರಲಿ.</para>
  <para style="q" vid="PSA 19:13">ಆಗ ನಾನು ತಪ್ಪಿಲ್ಲದವನಾಗಿ ಮಹಾದ್ರೋಹಕ್ಕೆ ಒಳಗಾಗುವುದಿಲ್ಲ.<verse eid="PSA 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14"/>ಯೆಹೋವನೇ ನನ್ನ ಶರಣನೇ, ನನ್ನ ವಿಮೋಚಕನೇ,</para>
  <para style="q" vid="PSA 19:14">ನನ್ನ ಮಾತುಗಳೂ ಮತ್ತು ನನ್ನ ಹೃದಯದ ಧ್ಯಾನವೂ ನಿನಗೆ ಸಮರ್ಪಕವಾಗಿರಲಿ.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s">ಅರಸನ ಜಯಕ್ಕಾಗಿ ಪ್ರಾರ್ಥಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1"/>ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವನು ನಿನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಲಿ;</para>
  <para style="q" vid="PSA 20:1">ಯಾಕೋಬನ ದೇವರ ನಾಮವು ನಿನ್ನನ್ನು ಉದ್ಧಾರ ಮಾಡಲಿ.<verse eid="PSA 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2"/>ಆತನು ತನ್ನ ಪರಿಶುದ್ಧ ನಿವಾಸದಿಂದ ನಿನಗೆ ಸಹಾಯಮಾಡಲಿ;</para>
  <para style="q" vid="PSA 20:2">ಚೀಯೋನಿನಿಂದ ನಿನಗೆ ಆಧಾರ ದಯಪಾಲಿಸಲಿ.<verse eid="PSA 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3"/>ನೀನು ಸಮರ್ಪಿಸಿದ ನೈವೇದ್ಯಗಳು ಆತನ ನೆನಪಿಗೆ ಬರಲಿ;</para>
  <para style="q" vid="PSA 20:3">ನೀನು ಮಾಡಿದ ಸರ್ವಾಂಗಹೋಮಗಳು ಆತನಿಗೆ ಮೆಚ್ಚಿಕೆಯಾಗಲಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4"/>ಆತನು ನಿನ್ನ ಇಷ್ಟಾರ್ಥವನ್ನು ನೆರವೇರಿಸಲಿ;</para>
  <para style="q" vid="PSA 20:4">ನಿನ್ನ ಎಲ್ಲಾ ಸಂಕಲ್ಪಗಳನ್ನು ಸಫಲಮಾಡಲಿ.<verse eid="PSA 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5"/>ನಿನ್ನ ಜಯದಲ್ಲಿ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡುವೆವು;</para>
  <para style="q" vid="PSA 20:5">ನಮ್ಮ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಧ್ವಜ ಎತ್ತುವೆವು.</para>
  <para style="q" vid="PSA 20:5">ಯೆಹೋವನು ನಿನ್ನ ಎಲ್ಲಾ ವಿಜ್ಞಾಪನೆಗಳನ್ನು ನೆರವೇರಿಸಲಿ.<verse eid="PSA 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6"/>ಯೆಹೋವನು ತಾನು ಅಭಿಷೇಕಿಸಿದ ಅರಸನಿಗೆ</para>
  <para style="q" vid="PSA 20:6">ಜಯವನ್ನು ಅನುಗ್ರಹಿಸುವನೆಂದು ಈಗ ನನಗೆ ಗೊತ್ತಾಯಿತು.</para>
  <para style="q" vid="PSA 20:6">ಆತನು ತನ್ನ ಪವಿತ್ರ ಲೋಕದಿಂದ ಅವನ ಪ್ರಾರ್ಥನೆಗೆ ಸದುತ್ತರವನ್ನು ಕೊಡುವನು,</para>
  <para style="q" vid="PSA 20:6">ತನ್ನ ಭುಜಬಲದಿಂದ ಅವನಿಗೆ ವಿಜಯವನ್ನು ಉಂಟುಮಾಡುವನು.<verse eid="PSA 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7"/>ಕೆಲವರು ರಥಬಲದಲ್ಲಿ, ಕೆಲವರು ಅಶ್ವಬಲದಲ್ಲಿ ಹೆಚ್ಚಳಪಡುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 20:7">ನಾವಾದರೋ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವನಲ್ಲಿಯೇ ಹೆಚ್ಚಳಪಡುತ್ತೇವೆ.<verse eid="PSA 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8"/>ಅವರು ಬಿದ್ದುಹೋಗಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 20:8">ನಾವಾದರೋ ಎದ್ದು ನಿಂತಿದ್ದೇವೆ.<verse eid="PSA 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9"/>ಯೆಹೋವನೇ, ನಮ್ಮ ಅರಸನಿಗೆ ಜಯವನ್ನುಂಟುಮಾಡು;</para>
  <para style="q" vid="PSA 20:9">ನಾವು ಮೊರೆಯಿಡುವಾಗ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s">ಅರಸನ ವಿಜಯದಲ್ಲಿ ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸುವ ಕೀರ್ತನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಪರಾಕ್ರಮದಲ್ಲಿ ಅರಸನು ಸಂತೋಷಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 21:1">ನೀನು ಉಂಟುಮಾಡಿದ ಜಯಕ್ಕಾಗಿ ಎಷ್ಟೋ ಆನಂದಪಡುತ್ತಾನೆ.<verse eid="PSA 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2"/>ನೀನು ಅವನ ಪ್ರಾರ್ಥನೆಯನ್ನು ನಿರಾಕರಿಸದೆ,</para>
  <para style="q" vid="PSA 21:2">ಅವನ ಇಷ್ಟಾರ್ಥವನ್ನು ನೆರವೇರಿಸಿದಿಯಲ್ಲಾ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3"/>ನಾನಾ ಶುಭಗಳೊಡನೆ ನೀನೇ ಅವನನ್ನು ಎದುರುಗೊಂಡಿಯಲ್ಲಾ;</para>
  <para style="q" vid="PSA 21:3">ಅವನ ತಲೆಯ ಮೇಲೆ ಸುವರ್ಣ ಕಿರೀಟವನ್ನು ಇಟ್ಟಿದ್ದೀ.<verse eid="PSA 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4"/>ಅವನು ದೀರ್ಘಾಯುಷ್ಯವನ್ನು ಬೇಡಿಕೊಳ್ಳಲು,</para>
  <para style="q" vid="PSA 21:4">ನೀನು ಅವನಿಗೆ ಯುಗಯುಗಾಂತರಗಳ ಆಯುಷ್ಯವನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದೀ.<verse eid="PSA 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5"/>ನಿನ್ನ ರಕ್ಷಣಕಾರ್ಯದಿಂದ ಅವನ ಗೌರವ ಬಹು ವೃದ್ಧಿಯಾಯಿತು;</para>
  <para style="q" vid="PSA 21:5">ಘನತೆ ಮತ್ತು ವೈಭವಗಳನ್ನು ಅವನಿಗೆ ಅನುಗ್ರಹಿಸಿದ್ದೀ.<verse eid="PSA 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6"/>ಅವನಿಗೆ ಶಾಶ್ವತವಾದ ಸೌಭಾಗ್ಯನಿಧಿಯನ್ನು ದಯಪಾಲಿಸಿದ್ದೀ;</para>
  <para style="q" vid="PSA 21:6">ಅವನನ್ನು ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಅತ್ಯಾನಂದಪಡಿಸಿದ್ದೀ.<verse eid="PSA 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7"/>ಅರಸನು ಯೆಹೋವನಲ್ಲಿಯೇ ಭರವಸವಿಟ್ಟಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 21:7">ಪರಾತ್ಪರನಾದ ದೇವರ ಶಾಶ್ವತ ಪ್ರೀತಿಯ ನಿಮಿತ್ತ ಅವನು ಕದಲುವುದೇ ಇಲ್ಲ.<verse eid="PSA 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8"/>ಶತ್ರುಗಳೆಲ್ಲರು ನಿನಗೆ ಸಿಕ್ಕುವರು;</para>
  <para style="q" vid="PSA 21:8">ಭುಜಬಲದಿಂದ ನಿನ್ನ ಹಗೆಗಳನ್ನು ಹಿಡಿಯುವಿ.<verse eid="PSA 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9"/>ನೀನು ಪ್ರತ್ಯಕ್ಷನಾಗುವಾಗ ಉರಿಯುವ ಕುಲುಮೆಯಂತಿದ್ದು ಅವರನ್ನು ಬೂದಿ ಮಾಡುವಿ.</para>
  <para style="q" vid="PSA 21:9">ಯೆಹೋವನು ಮಹಾಕೋಪದಿಂದ ಅವರನ್ನು ನಾಶ ಮಾಡುವನು;</para>
  <para style="q" vid="PSA 21:9">ಆತನ ಕೋಪಾಗ್ನಿ ಅವರನ್ನು ದಹಿಸಿಬಿಡುವುದು.<verse eid="PSA 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10"/>ನೀನು ಅವರನ್ನು ಸಂಹರಿಸಿ, ಭೂಮಿಯ ಮೇಲೆ ಅವರ ಸಂತತಿಯೇ ಇಲ್ಲದಂತೆ ಮಾಡುವಿ;</para>
  <para style="q" vid="PSA 21:10">ಅವರ ವಂಶದವರು ಮನುಷ್ಯರೊಳಗೆ ಉಳಿಯುವುದೇ ಇಲ್ಲ.<verse eid="PSA 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11"/>ಅವರು ತಂತ್ರೋಪಾಯಗಳನ್ನು ಕಲ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 21:11">ನಿನಗೆ ಕೇಡನ್ನು ಮಾಡಬೇಕೆಂದು ಆಲೋಚಿಸಿದರೂ ಅದು ನಡೆಯುವುದಿಲ್ಲ.<verse eid="PSA 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12"/>ನೀನು ನಿನ್ನ ಬಾಣಗಳನ್ನು ಬಿಲ್ಲಿಗೆ ಹೂಡಿ, ಅವರ ಮುಖಗಳ ಮೇಲೆ ಎಸೆದು,</para>
  <para style="q" vid="PSA 21:12">ಅವರು ಬೆನ್ನುತೋರಿಸಿ ಓಡಿಹೋಗುವಂತೆ ಮಾಡುವಿ.<verse eid="PSA 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13"/>ಯೆಹೋವನೇ, ಪರಾಕ್ರಮದಿಂದ ನಿನ್ನನ್ನು ಘನಪಡಿಸಿಕೋ;</para>
  <para style="q" vid="PSA 21:13">ನಾವು ಗಾಯನಮಾಡುತ್ತಾ ನಿನ್ನ ಶೂರತ್ವವನ್ನು ಕೊಂಡಾಡುವೆವು.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s">ಘೋರಬಾಧೆಪಟ್ಟ ಭಕ್ತನ ಮನಃಪೂರ್ವಕ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">(ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಉದಯದ ಜಿಂಕೆ ಎಂಬ ರಾಗದ ಮೇಲೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.)</para>
  <para style="r">
    <ref loc="PSA 69">ಕೀರ್ತ 69</ref>; <ref loc="PSA 71">71</ref>; <ref loc="PSA 102">102</ref>; <ref loc="ISA 55">ಯೆಶಾ 55</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1"/>ನನ್ನ ದೇವರೇ, ನನ್ನ ದೇವರೇ, ಏಕೆ ನನ್ನನ್ನು ಕೈಬಿಟ್ಟಿದ್ದೀ?</para>
  <para style="q" vid="PSA 22:1">ನೀನು ಏಕೆ ನನಗೆ ಸಹಾಯಮಾಡದೆಯೂ, ನನ್ನ ಕೂಗನ್ನು ಕೇಳದೆಯೂ ದೂರವಾಗಿದ್ದೀ?<verse eid="PSA 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2"/>ನನ್ನ ದೇವರೇ, ಹಗಲಿನಲ್ಲಿ ಮೊರೆಯಿಡುತ್ತೇನೆ; ಪ್ರತ್ಯುತ್ತರವೇ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 22:2">ರಾತ್ರಿಯಲ್ಲಿಯೂ ನನಗೆ ಉಪಶಮನವಿಲ್ಲ.<verse eid="PSA 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3"/>ಇಸ್ರಾಯೇಲರ ಸ್ತೋತ್ರಸಿಂಹಾಸನದಲ್ಲಿ ಇರುವಾತನೇ,</para>
  <para style="q" vid="PSA 22:3">ನೀನು ಪವಿತ್ರಸ್ವರೂಪನು.<verse eid="PSA 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4"/>ನಮ್ಮ ಪೂರ್ವಿಕರು ನಿನ್ನಲ್ಲಿ ಭರವಸವಿಟ್ಟರು;</para>
  <para style="q" vid="PSA 22:4">ನಿನ್ನನ್ನು ನಂಬಿ ಉದ್ಧಾರವಾದರು.<verse eid="PSA 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5"/>ನಿನಗೆ ಮೊರೆಯಿಟ್ಟು ವಿಮುಕ್ತರಾದರು;</para>
  <para style="q" vid="PSA 22:5">ನಿನ್ನಲ್ಲಿ ವಿಶ್ವಾಸವಿಟ್ಟು ಆಶಾಭಂಗಪಡಲಿಲ್ಲ.<verse eid="PSA 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6"/>ನಾನಾದರೋ ಹುಳದಂಥವನೇ ಹೊರತು ಮನುಷ್ಯನಲ್ಲ;</para>
  <para style="q" vid="PSA 22:6">ಮನುಷ್ಯರಿಂದ ನಿಂದಿಸಲ್ಪಟ್ಟು ಜನರಿಂದ ತಿರಸ್ಕಾರ ಹೊಂದಿದ್ದೇನೆ.<verse eid="PSA 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7"/>ನನ್ನನ್ನು ನೋಡುವವರೆಲ್ಲರೂ ಹಾಸ್ಯಮಾಡುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 22:7">ಅವರು ಓರೇ ತುಟಿ ಮಾಡಿ ತಲೆ ಆಡಿಸುತ್ತಾ,<verse eid="PSA 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8"/>“ಯೆಹೋವನು ತನ್ನನ್ನು ರಕ್ಷಿಸುವನೆಂದು ಆತನಲ್ಲಿ ಭರವಸವಿಟ್ಟಿದ್ದಾನಲ್ಲಾ;</para>
  <para style="q" vid="PSA 22:8">ಆತನು ಇವನನ್ನು ಮೆಚ್ಚಿದ್ದಾದರೆ ರಕ್ಷಿಸಲಿ” ಎಂದು ಹೇಳುತ್ತಾರೆ.<verse eid="PSA 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9"/>ತಾಯಿಯ ಗರ್ಭದೊಳಗಿಂದ ನನ್ನನ್ನು ಬರಮಾಡಿದವನು ನೀನೇ ಅಲ್ಲವೇ.</para>
  <para style="q" vid="PSA 22:9">ತಾಯಿಯ ಎದೆಯಲ್ಲಿ ನನ್ನನ್ನು ನಿಶ್ಚಿಂತೆಯಿಂದ ಇರಿಸಿದವನು ನೀನೇ ಅಲ್ಲವೇ.<verse eid="PSA 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10"/>ಹುಟ್ಟಿದಂದಿನಿಂದ ನೀನೇ ನನಗೆ ಆಧಾರ;</para>
  <para style="q" vid="PSA 22:10">ತಾಯಿ ಹೆತ್ತಂದಿನಿಂದ ನನ್ನ ದೇವರು ನೀನೇ.<verse eid="PSA 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11"/>ನನಗೀಗ ಕಷ್ಟವು ಪ್ರಾಪ್ತವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 22:11">ಸಹಾಯಕರು ಯಾರೂ ಇಲ್ಲ, ದೂರವಾಗಿರಬೇಡ.<verse eid="PSA 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12"/>ಬಹಳ ಗೂಳಿಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿವೆ;</para>
  <para style="q" vid="PSA 22:12">ಬಾಷಾನಿನ ಬಲವುಳ್ಳ ಹೋರಿಗಳು ನನ್ನನ್ನು ಮುತ್ತಿಕೊಂಡಿವೆ.<verse eid="PSA 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13"/>ಅವರು ಗರ್ಜಿಸುವ ಉಗ್ರಸಿಂಹಗಳಂತೆ ನನ್ನನ್ನು ನುಂಗುವುದಕ್ಕೆ ಬಾಯಿ ತೆರೆದಿದ್ದಾರೆ.<verse eid="PSA 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14"/>ನಾನು ಹೊಯ್ಯಲ್ಪಟ್ಟ ನೀರಿನಂತಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 22:14">ನನ್ನ ಎಲುಬುಗಳೆಲ್ಲಾ ಕೀಲು ತಪ್ಪಿದೆ.</para>
  <para style="q" vid="PSA 22:14">ನನ್ನ ಹೃದಯ ಮೇಣದಂತೆ ನನ್ನಲ್ಲಿ ಕರಗಿಹೋಗಿದೆ.<verse eid="PSA 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">22:15 </char>
      <char style="ft" closed="false">ಅಥವಾ ಗಂಟಲು.</char>
    </note>ನನ್ನ ಶಕ್ತಿಯು ಬೋಕಿಯ ಹಾಗೆ ಒಣಗಿಹೋಗಿದೆ;</para>
  <para style="q" vid="PSA 22:15">ನನ್ನ ನಾಲಿಗೆಯು ಬಾಯಿಯ ಅಂಗಳಕ್ಕೆ ಹತ್ತಿಹೋಗಿದೆ.</para>
  <para style="q" vid="PSA 22:15">ನೀನು ನನ್ನನ್ನು ಮಣ್ಣಿಗೆ ಸೇರಿಸುತ್ತೀ.<verse eid="PSA 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16"/>ನಾಯಿಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿವೆ;</para>
  <para style="q" vid="PSA 22:16">ದುಷ್ಟರ ಗುಂಪು ನನ್ನನ್ನು ಆವರಿಸಿಕೊಂಡಿದೆ.</para>
  <para style="q" vid="PSA 22:16">ನನ್ನ ಕೈಕಾಲುಗಳನ್ನು ತಿವಿದಿದ್ದಾರೆ.<verse eid="PSA 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17"/>ನನ್ನ ಎಲುಬುಗಳನ್ನೆಲ್ಲಾ ಎಣಿಸುವುದಕ್ಕಾಗುವುದು;</para>
  <para style="q" vid="PSA 22:17">ಅವರೋ ನನ್ನನ್ನು ನೋಡಿ ನೋಡಿ ಹಿಗ್ಗುತ್ತಾರೆ.<verse eid="PSA 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18"/>ನನ್ನ ಮೇಲ್ಹೊದಿಕೆಯನ್ನು ತಮ್ಮಲ್ಲಿ ಪಾಲು ಮಾಡಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 22:18">ನನ್ನ ಅಂಗಿಗಾಗಿ ಚೀಟುಹಾಕುತ್ತಾರೆ.<verse eid="PSA 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19"/>ಯೆಹೋವನೇ, ನನ್ನ ರಕ್ಷಕನೇ, ನೀನಾದರೋ ದೂರವಾಗಿರಬೇಡ;</para>
  <para style="q" vid="PSA 22:19">ಬೇಗ ಬಂದು ಸಹಾಯಮಾಡು.<verse eid="PSA 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20"/>ಕತ್ತಿಗೆ ಸಿಕ್ಕದಂತೆ ನನ್ನನ್ನು ತಪ್ಪಿಸು;</para>
  <para style="q" vid="PSA 22:20">ನನ್ನ ಪ್ರಿಯ ಪ್ರಾಣವು ನಾಯಿಯ ವಶವಾಗದಂತೆ ಕಾಪಾಡು.<verse eid="PSA 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21"/>ಸಿಂಹಗಳ ಬಾಯಿಂದ ರಕ್ಷಿಸು, ಕಾಡುಕೋಣಗಳ ಕೊಂಬುಗಳಿಂದ ನನ್ನನ್ನು <note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">ಅಥವಾ ನನಗೆ ಸದುತ್ತರವನ್ನು ಕೊಟ್ಟಿದ್ದೀಯಲ್ಲಾ. </char></note>ತಪ್ಪಿಸು.<verse eid="PSA 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22"/>ನಿನ್ನ ನಾಮ ಮಹಿಮೆಯನ್ನು ನನ್ನ ಸಹೋದರರಿಗೆ ತಿಳಿಸುವೆನು;</para>
  <para style="q" vid="PSA 22:22">ಸಭಾಮಧ್ಯದಲ್ಲಿ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23"/>ಯೆಹೋವನ ಭಕ್ತರೇ, ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 22:23">ಯಾಕೋಬ ವಂಶದವರೇ, ನೀವೆಲ್ಲರೂ ಆತನನ್ನು ಕೊಂಡಾಡಿರಿ.</para>
  <para style="q" vid="PSA 22:23">ಇಸ್ರಾಯೇಲ್ ವಂಶಸ್ಥರೇ, ನೀವೆಲ್ಲರೂ ಆತನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿರಿ.<verse eid="PSA 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24"/>ಆತನು ಕುಗ್ಗಿಹೋದವನ ದುರವಸ್ಥೆಯನ್ನು ತಿರಸ್ಕರಿಸಲಿಲ್ಲ,</para>
  <para style="q" vid="PSA 22:24">ಅದಕ್ಕೆ ಅಸಹ್ಯಪಡಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 22:24">ತನ್ನ ಮುಖವನ್ನು ಅವನಿಗೆ ಮರೆಮಾಡದೆ,</para>
  <para style="q" vid="PSA 22:24">ಅವನ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಟ್ಟನು.<verse eid="PSA 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25"/>ನಾನು ಮಹಾಸಭೆಯಲ್ಲಿ ಮಾಡುವ ಸ್ತೋತ್ರಕ್ಕೆ ನೀನೇ ಆಧಾರನು;</para>
  <para style="q" vid="PSA 22:25">ನನ್ನ ಹರಕೆಗಳನ್ನು ನಿನ್ನ ಭಕ್ತರ ಮುಂದೆ ಸಲ್ಲಿಸುವೆನು.<verse eid="PSA 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26"/>ದೀನರು ಉಂಡು ತೃಪ್ತರಾಗುವರು;</para>
  <para style="q" vid="PSA 22:26">ಯೆಹೋವನ ಭಕ್ತರೆಲ್ಲರೂ ಆತನನ್ನು ಕೊಂಡಾಡುವರು.</para>
  <para style="q" vid="PSA 22:26">
    <note caller="+" style="f">
      <char style="fr" closed="false">22:26 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಿಮ್ಮ.</char>
    </note>ಅವರ ಅಂತರಾತ್ಮವು ಯಾವಾಗಲು ಚೈತನ್ಯವುಳ್ಳದ್ದಾಗಿರಲಿ.<verse eid="PSA 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27"/>ಭೂಮಂಡಲದವರೆಲ್ಲರೂ ಎಚ್ಚರಗೊಂಡು ಯೆಹೋವನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವರು;</para>
  <para style="q" vid="PSA 22:27">ಯೆಹೋವನೇ, ಎಲ್ಲಾ ಜನಾಂಗಗಳವರು <note caller="+" style="f"><char style="fr" closed="false">22:27 </char><char style="ft" closed="false">ಅಥವಾ ಆತನಿಗೆ.</char></note>ನಿನಗೆ ಅಡ್ಡಬೀಳುವರು.<verse eid="PSA 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28"/>ರಾಜ್ಯವು ಯೆಹೋವನದೇ;</para>
  <para style="q" vid="PSA 22:28">ಎಲ್ಲಾ ಜನಾಂಗಗಳಿಗೂ ಆತನೇ ಒಡೆಯನು.<verse eid="PSA 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29"/>ಭೂಲೋಕದಲ್ಲಿರುವ ಪುಷ್ಟರೆಲ್ಲರೂ <note caller="+" style="f"><char style="fr" closed="false">22:29 </char><char style="ft" closed="false">ಅಥವಾ ಉಂಡು ಆರಾಧಿಸುವರು.</char></note>ಆರಾಧಿಸುವರು;</para>
  <para style="q" vid="PSA 22:29">ತಮ್ಮ ಜೀವವನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲಾರದೆ ಮಣ್ಣು ಪಾಲಾಗುವವರೆಲ್ಲರೂ ಆತನಿಗೆ ಅಡ್ಡಬೀಳುವರು.<verse eid="PSA 22:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30"/>ಆತನನ್ನು ಸೇವಿಸುವವರ ಸಂತಾನದವರು</para>
  <para style="q" vid="PSA 22:30">ಯೆಹೋವನ ಸಂತಾನದವರೆಂದು ಎಣಿಸಲ್ಪಡವರು.<verse eid="PSA 22:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31"/>ಅವರು ಬಂದು ಆತನ ನೀತಿಯನ್ನೂ,</para>
  <para style="q" vid="PSA 22:31">ಆತನು ನಡೆಸಿದ ಕಾರ್ಯಗಳನ್ನೂ ಮುಂದೆ ಹುಟ್ಟುವ ಜನಕ್ಕೆ ತಿಳಿಸುವರು.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s">ಭಕ್ತರೆಂಬ ಕುರಿಗಳಿಗೆ ಒಳ್ಳೆಯ ಕುರುಬನಾದ ಯೆಹೋವನು</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1"/>ಯೆಹೋವನು ನನಗೆ ಕುರುಬನು; ಕೊರತೆಪಡೆನು.<verse eid="PSA 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2"/>ಆತನು ಹಸಿರುಗಾವಲುಗಳಲ್ಲಿ ನನ್ನನ್ನು ತಂಗಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 23:2">ವಿಶ್ರಾಂತಿಕರವಾದ ನೀರುಗಳ ಬಳಿಗೆ ಬರಮಾಡುತ್ತಾನೆ.<verse eid="PSA 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಉಜ್ಜೀವಿಸಮಾಡಿ ತನ್ನ ಹೆಸರಿಗೆ ತಕ್ಕಂತೆ</para>
  <para style="q" vid="PSA 23:3">ನೀತಿಯ ಮಾರ್ಗದಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಸುತ್ತಾನೆ.<verse eid="PSA 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4"/>ನಾನು ಕಾರ್ಗತ್ತಲಿನ ಕಣಿವೆಯಲ್ಲಿ ನಡೆಯುವಾಗಲೂ,</para>
  <para style="q" vid="PSA 23:4">ನೀನು ಹತ್ತಿರವಿರುವುದರಿಂದ ಕೇಡಿಗೆ ಹೆದರೆನು;</para>
  <para style="q" vid="PSA 23:4">ನಿನ್ನ ದೊಣ್ಣೆಯೂ ಮತ್ತು ನಿನ್ನ ಕೋಲೂ ನನಗೆ ಧೈರ್ಯ ಕೊಡುತ್ತವೆ.<verse eid="PSA 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5"/>ವೈರಿಗಳ ಮುಂದೆಯೇ ನೀನು ನನಗೋಸ್ಕರ ಔತಣವನ್ನು ಸಿದ್ಧಪಡಿಸುತ್ತೀ;</para>
  <para style="q" vid="PSA 23:5">
    <note caller="+" style="f">
      <char style="fr" closed="false">23:5 </char>
      <char style="ft" closed="false">ಲೂಕ 7:46.</char>
    </note>ನನ್ನ ತಲೆಗೆ ತೈಲವನ್ನು ಹಚ್ಚಿಸುತ್ತೀ,</para>
  <para style="q" vid="PSA 23:5">ನನ್ನ ಪಾತ್ರೆಯು ತುಂಬಿ ಹೊರಸೂಸುತ್ತದೆ.<verse eid="PSA 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6"/>ನಿಶ್ಚಯವಾಗಿ ನನ್ನ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಶುಭವೂ ಮತ್ತು ಕೃಪೆಯೂ ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸುವವು.</para>
  <para style="q" vid="PSA 23:6">ನಾನು ಸದಾಕಾಲವೂ ಯೆಹೋವನ ಮಂದಿರದಲ್ಲಿ ವಾಸಿಸುವೆನು.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s">ಯೆಹೋವನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಸೇರತಕ್ಕವರು</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1"/>ಭೂಮಿಯೂ ಅದರಲ್ಲಿರುವ ಸಮಸ್ತವೂ ಯೆಹೋವನದು;</para>
  <para style="q" vid="PSA 24:1">ಲೋಕವೂ ಮತ್ತು ಅದರ ನಿವಾಸಿಗಳೂ ಆತನವೇ.<verse eid="PSA 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2"/>ಆತನೇ ಅದರ ಅಸ್ತಿವಾರವನ್ನು ಸಾಗರದ ಮೇಲೆ ಹಾಕಿದವನು;</para>
  <para style="q" vid="PSA 24:2">ಅದನ್ನು ಜಲರಾಶಿಗಳ ಮೇಲೆ ಸ್ಥಿರಪಡಿಸಿದವನು ಆತನೇ.<verse eid="PSA 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3"/>ಯೆಹೋವನ ಪರ್ವತವನ್ನು<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="fq" closed="false">ಪರ್ವತವನ್ನು </char><char style="ft" closed="false">ಇದು ದೇವಾಲಯವನ್ನು ಕಟ್ಟಿದ ಪರ್ವತವಾಗಿದೆ. ಚೀಯೋನ್ ಪರ್ವತಾರೋಹಣವನ್ನು ಮಾಡುವ ಮತ್ತು ದೇವಾಲಯವನ್ನು ಪ್ರವೇಶಿಸುವ ಉದ್ದೇಶವೇನೆಂದರೆ ಯೆಹೋವನನ್ನು ಆರಾಧಿಸಲು ಹೋಗುವುದಾಗಿದೆ.</char></note> ಹತ್ತತಕ್ಕವನು ಯಾರು?</para>
  <para style="q" vid="PSA 24:3">ಆತನ ಪವಿತ್ರಸ್ಥಾನದಲ್ಲಿ <note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="ft" closed="false">ಅಥವಾ ನಿಲ್ಲುವುದಕ್ಕೆ.</char></note>ಪ್ರವೇಶಿಸುವುದಕ್ಕೆ ಎಂಥವನು ಯೋಗ್ಯನು?<verse eid="PSA 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4"/>ಯಾರು ಅಯೋಗ್ಯಕಾರ್ಯಗಳಲ್ಲಿ ಮನಸ್ಸಿಡದೆ,</para>
  <para style="q" vid="PSA 24:4">ಮೋಸ ಪ್ರಮಾಣಮಾಡದೆ,</para>
  <para style="q" vid="PSA 24:4">ಶುದ್ಧಹಸ್ತವೂ, ನಿರ್ಮಲಮನಸ್ಸೂ ಉಳ್ಳವನಾಗಿದ್ದಾನೋ,<verse eid="PSA 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5"/>ಅವನೇ ಯೆಹೋವನಿಂದ ಶುಭವನ್ನು ಹೊಂದುವನು;</para>
  <para style="q" vid="PSA 24:5">ತನ್ನ ರಕ್ಷಕನಾದ ದೇವರಿಂದ ನೀತಿಫಲವನ್ನು ಪಡೆಯುವನು.<verse eid="PSA 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6"/>ಇಂಥವರೇ ಆತನ ದರ್ಶನವನ್ನು ಬಯಸುವವರು.</para>
  <para style="q" vid="PSA 24:6">ಯಾಕೋಬ್ಯರ ದೇವರೇ, ನಿನ್ನ ಸಾನ್ನಿಧ್ಯವನ್ನು ಸೇರುವವರು ಇಂಥವರೇ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7"/>ದ್ವಾರಗಳೇ, ಉನ್ನತವಾಗಿರ್ರಿ!</para>
  <para style="q" vid="PSA 24:7">ಪುರಾತನವಾದ ಕದಗಳೇ ತೆರೆದುಕೊಂಡಿರ್ರಿ!</para>
  <para style="q" vid="PSA 24:7">ಮಹಾಮಹಿಮೆಯುಳ್ಳ ಅರಸನು ಆಗಮಿಸುತ್ತಾನೆ.<verse eid="PSA 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8"/>ಮಹಾಮಹಿಮೆಯುಳ್ಳ ಈ ಅರಸನು ಯಾರು?</para>
  <para style="q" vid="PSA 24:8">ಮಹಾ ಬಲಿಷ್ಠನೂ, ವಿಶೇಷ ಪರಾಕ್ರಮಿಯೂ ಆಗಿರುವ ಯೆಹೋವ,</para>
  <para style="q" vid="PSA 24:8">ಯುದ್ಧವೀರನಾಗಿರುವ ಯೆಹೋವ.<verse eid="PSA 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9"/>ದ್ವಾರಗಳೇ, ಉನ್ನತವಾಗಿರ್ರಿ!</para>
  <para style="q" vid="PSA 24:9">ಪುರಾತನವಾದ ಕದಗಳೇ, ತೆರೆದುಕೊಂಡಿರ್ರಿ!</para>
  <para style="q" vid="PSA 24:9">ಮಹಾಮಹಿಮೆಯುಳ್ಳ ಅರಸನು ಆಗಮಿಸುತ್ತಾನೆ.<verse eid="PSA 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10"/>ಮಹಾಮಹಿಮೆಯುಳ್ಳ ಈ ಅರಸನು ಯಾರು?</para>
  <para style="q" vid="PSA 24:10">ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 24:10">ಮಹಾಮಹಿಮೆಯುಳ್ಳ ಅರಸನು ಈತನೇ. <char style="qs">ಸೆಲಾ. </char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="s">ಇಬ್ರಿಯ ಅಕ್ಷರಕ್ರಮಾನುಸಾರವಾದ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1"/>ಯೆಹೋವನೇ, ನನ್ನ ಮನಸ್ಸನ್ನು ನಿನ್ನಲ್ಲಿಯೇ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2"/>ನನ್ನ ದೇವರೇ, ನಿನ್ನನ್ನೇ ನಂಬಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 25:2">ನನ್ನನ್ನು ಅಪಮಾನಕ್ಕೆ ಗುರಿಪಡಿಸಬೇಡ.</para>
  <para style="q" vid="PSA 25:2">ಶತ್ರುಗಳ ಉತ್ಸಾಹಕ್ಕೆ ಆಸ್ಪದಮಾಡಬೇಡ.<verse eid="PSA 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3"/>ನಿಷ್ಕಾರಣ ದ್ರೋಹಿಗಳಿಗೆ ಅಪಮಾನವಾಗಬೇಕೇ ಹೊರತು,</para>
  <para style="q" vid="PSA 25:3">ನಿನ್ನನ್ನು ನಿರೀಕ್ಷಿಸಿದವರಿಗೆ ಎಂದಿಗೂ ಆಗಬಾರದು.<verse eid="PSA 25:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಮಾರ್ಗವನ್ನು ನನಗೆ ತಿಳಿಯಪಡಿಸು;</para>
  <para style="q" vid="PSA 25:4">ನೀನು ಒಪ್ಪುವ ದಾರಿಯನ್ನು ತೋರಿಸು.<verse eid="PSA 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5"/>ನಿನ್ನ ಸತ್ಯಾನುಸಾರವಾಗಿ ನನ್ನನ್ನು ನಡೆಸುತ್ತಾ ಉಪದೇಶಿಸು;</para>
  <para style="q" vid="PSA 25:5">ನೀನೇ ನನ್ನನ್ನು ರಕ್ಷಿಸುವ ದೇವರು;</para>
  <para style="q" vid="PSA 25:5">ಹಗಲೆಲ್ಲಾ ನಿನ್ನನ್ನೇ ನಿರೀಕ್ಷಿಸುವವನಾಗಿದ್ದೇನೆ.<verse eid="PSA 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6"/>ಯೆಹೋವನೇ, ನೀನು ಆದಿಯಿಂದಲೂ ನನ್ನನ್ನು ಕರುಣಿಸುವವನಾಗಿ,</para>
  <para style="q" vid="PSA 25:6">ನನಗೆ ಮಾಡಿದ ಮಹೋಪಕಾರಗಳನ್ನು ನೆನಸಿಕೋ.<verse eid="PSA 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7"/>ಯೆಹೋವನೇ, ನನ್ನ ಯೌವನದ ತಪ್ಪುಗಳನ್ನೂ ಮತ್ತು ದ್ರೋಹಗಳನ್ನೂ ಮನಸ್ಸಿನಲ್ಲಿಡದೆ,</para>
  <para style="q" vid="PSA 25:7">ನಿನ್ನ ಕೃಪೆಗೆ ತಕ್ಕಂತೆ ದಯಾಪೂರ್ವಕವಾಗಿ ನನ್ನನ್ನು ನೆನಪುಮಾಡಿಕೋ.<verse eid="PSA 25:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8"/>ಯೆಹೋವನು ದಯಾಳುವೂ, ಸತ್ಯಸ್ವರೂಪನೂ ಆಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 25:8">ದಾರಿತಪ್ಪಿದವರನ್ನು ಬೋಧಿಸಿ ಸನ್ಮಾರ್ಗದಲ್ಲಿ ನಡೆಸುವನು.<verse eid="PSA 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9"/>ಆತನು ದೀನರನ್ನು ತನ್ನ ವಿಧಿಗನುಗುಣವಾಗಿ ನಡೆಸುವನು;</para>
  <para style="q" vid="PSA 25:9">ಅವರಿಗೆ ತನ್ನ ಮಾರ್ಗವನ್ನು ತೋರಿಸುವನು.<verse eid="PSA 25:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10"/>ಯೆಹೋವನ ನಿಬಂಧನೆ ಮತ್ತು ಆಜ್ಞೆಗಳನ್ನು ಕೈಕೊಂಡು ನಡೆಯುವವರಿಗೆ,</para>
  <para style="q" vid="PSA 25:10">ಆತನ ಎಲ್ಲಾ ಮಾರ್ಗಗಳು ಕೃಪೆಯೂ, ಸತ್ಯತೆಯುಳ್ಳವು.<verse eid="PSA 25:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11"/>ಯೆಹೋವನೇ, ನನ್ನ ಪಾಪವು ಬಹುಘೋರವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 25:11">ಆದರೂ ನಿನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತ ಅದನ್ನು ಕ್ಷಮಿಸು.<verse eid="PSA 25:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12"/>ಯಾರು ಯೆಹೋವನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿರುವರೋ</para>
  <para style="q" vid="PSA 25:12">ಅವರಿಗೆ ಉಚಿತವಾದ ಮಾರ್ಗವನ್ನು ಆತನು ಬೋಧಿಸುವನು.<verse eid="PSA 25:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13"/>ಅವರು ಸುಖದಿಂದಲೇ ಇರುವರು;</para>
  <para style="q" vid="PSA 25:13">ಅವರ ಸಂತತಿಯವರು ದೇಶವನ್ನು ಅನುಭವಿಸುವರು.<verse eid="PSA 25:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14"/>ಯೆಹೋವನು ತನ್ನ ಸದ್ಭಕ್ತರಿಗೆ ಆಪ್ತಮಿತ್ರನಂತಿರುವನು;</para>
  <para style="q" vid="PSA 25:14">ಅವರಿಗೆ ತನ್ನ ಒಡಂಬಡಿಕೆಯ ಅನುಭವವನ್ನು ದಯಪಾಲಿಸುವನು.<verse eid="PSA 25:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15"/>ನನ್ನ ದೃಷ್ಟಿ ಯಾವಾಗಲೂ ಯೆಹೋವನಲ್ಲಿದೆ;</para>
  <para style="q" vid="PSA 25:15">ಆತನೇ ನನ್ನ ಕಾಲುಗಳನ್ನು ಬಲೆಯಿಂದ ಬಿಡಿಸುವವನು.<verse eid="PSA 25:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16"/>ನಾನು ಒಬ್ಬೊಂಟಿಗನೂ, ಬಾಧೆಪಡುವವನೂ ಆಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 25:16">ನೀನು ಕಟಾಕ್ಷವಿಟ್ಟು ನನ್ನನ್ನು ಕರುಣಿಸು.<verse eid="PSA 25:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17"/>ನನ್ನ ಮನೋವ್ಯಥೆಗಳನ್ನು ನಿವಾರಿಸು;</para>
  <para style="q" vid="PSA 25:17">ಸಂಕಟಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು.<verse eid="PSA 25:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18"/>ನಾನು ಕುಗ್ಗಿರುವುದನ್ನೂ, ಕಷ್ಟಪಡುವುದನ್ನೂ ನೋಡಿ,</para>
  <para style="q" vid="PSA 25:18">ನನ್ನ ಎಲ್ಲಾ ಪಾಪಗಳನ್ನು ಪರಿಹರಿಸು.<verse eid="PSA 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19"/>ನನಗೆ ಎಷ್ಟೋ ಶತ್ರುಗಳು ಇದ್ದಾರಲ್ಲಾ;</para>
  <para style="q" vid="PSA 25:19">ಅವರು ಕಡು ವೈರತ್ವದಿಂದ ನನ್ನನ್ನು ಹಗೆಮಾಡುತ್ತಾರೆ.<verse eid="PSA 25:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿ ಉಳಿಸು;</para>
  <para style="q" vid="PSA 25:20">ನಿನ್ನನ್ನೇ ಆಶ್ರಯಿಸಿಕೊಂಡಿದ್ದೇನೆ, ನನಗೆ ಆಶಾಭಂಗವಾಗಬಾರದು.<verse eid="PSA 25:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21"/>ನಿನ್ನನ್ನೇ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 25:21">ನಿರ್ದೋಷಭಕ್ತಿಯೂ ಮತ್ತು ಯಥಾರ್ಥತ್ವವೂ ನನ್ನನ್ನು ಕಾಯಲಿ.<verse eid="PSA 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22"/>ದೇವರೇ, ಇಸ್ರಾಯೇಲರನ್ನು ಅವರ ಎಲ್ಲಾ ಬಾಧೆಗಳಿಂದ ವಿಮೋಚಿಸು.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s">ಬಲಾತ್ಕಾರಿಗಳಿಂದ ತಪ್ಪಿಸಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1"/>ಯೆಹೋವನೇ, ನನಗೋಸ್ಕರ ನ್ಯಾಯವನ್ನು ನಿರ್ಣಯಿಸು.</para>
  <para style="q" vid="PSA 26:1">ನಾನಾದರೋ ನಿರ್ದೋಷಿಯಾಗಿಯೇ ನಡೆದುಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 26:1">ನಾನು ಕದಲದೆ ಯೆಹೋವನಲ್ಲೇ ಭರವಸವಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2"/>ಯೆಹೋವನೇ, ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸು, ಪರಿಶೀಲಿಸು;</para>
  <para style="q" vid="PSA 26:2">ನನ್ನ ಅಂತರಿಂದ್ರಿಯವನ್ನೂ, ಹೃದಯವನ್ನೂ ಪರಿಶೋಧಿಸು.<verse eid="PSA 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3"/>ನಿನ್ನ ಶಾಶ್ವತವಾದ ಪ್ರೀತಿಯನ್ನು ನನ್ನ ದೃಷ್ಟಿಯಲ್ಲೇ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 26:3">ನಿನಗೆ ನಂಬಿಗಸ್ತನಾಗಿ ನಡೆದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4"/>ನಾನು ಮೋಸಗಾರರ ಸಹವಾಸ ಮಾಡುವವನಲ್ಲ;</para>
  <para style="q" vid="PSA 26:4">ಕಪಟಿಗಳನ್ನು ಸೇರುವವನಲ್ಲ.<verse eid="PSA 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5"/>ನನಗೆ ದುರ್ಜನರ ಕೂಟವು ಅಸಹ್ಯ;</para>
  <para style="q" vid="PSA 26:5">ದುಷ್ಟರ ಸಂಗವು ಬೇಕಿಲ್ಲ.<verse eid="PSA 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6"/>ಯೆಹೋವನೇ, ನಾನು ನಿರ್ದೋಷಿ ಎಂದು,</para>
  <para style="q" vid="PSA 26:6">ಕೈಗಳನ್ನು ತೊಳೆದುಕೊಂಡವನಾಗಿ,<verse eid="PSA 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7"/>ನಿನ್ನ ಅದ್ಭುತಕೃತ್ಯಗಳ ವರ್ಣನೆಯ ಸ್ತೋತ್ರ ಮಾಡುತ್ತಾ,</para>
  <para style="q" vid="PSA 26:7">ನಿನ್ನ ಯಜ್ಞವೇದಿಯನ್ನು ಪ್ರದಕ್ಷಿಣೆಮಾಡುವೆನು.<verse eid="PSA 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8"/>ಯೆಹೋವನೇ, ನಿನ್ನ ನಿವಾಸವು ನನಗೆ ಎಷ್ಟೋ ಪ್ರಿಯ;</para>
  <para style="q" vid="PSA 26:8">ನಿನ್ನ ಪ್ರಭಾವ ಸ್ಥಾನವು ನನಗೆ ಇಷ್ಟ.<verse eid="PSA 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9"/>ಪಾಪಿಷ್ಠರ ಪ್ರಾಣದ ಸಂಗಡ ನನ್ನ ಪ್ರಾಣವನ್ನೂ ತೆಗೆಯಬೇಡ;</para>
  <para style="q" vid="PSA 26:9">ಕೊಲೆಪಾತಕರ ಜೀವದೊಂದಿಗೆ ನನ್ನ ಜೀವವನ್ನೂ ತೆಗೆಯಬೇಡ.<verse eid="PSA 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10"/>ಅವರ ಕೈಗಳು ಬಲಾತ್ಕಾರ ನಡೆಸುತ್ತವೆ;</para>
  <para style="q" vid="PSA 26:10">ಅವರ ಬಲಗೈ ಲಂಚದಿಂದ ತುಂಬಿದೆ.<verse eid="PSA 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11"/>ನಾನಾದರೋ ನಿರ್ದೋಷಿಯಾಗಿಯೇ ನಡೆದುಕೊಳ್ಳುವವನು;</para>
  <para style="q" vid="PSA 26:11">ಯೆಹೋವನೇ, ಅವರಿಂದ ನನ್ನನ್ನು ವಿಮೋಚಿಸಿ ಪ್ರಸನ್ನನಾಗಿರು.<verse eid="PSA 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12"/>ನನ್ನ ಪಾದವು ಸಮಭೂಮಿಯಲ್ಲಿ ನಿಂತಿದೆ;</para>
  <para style="q" vid="PSA 26:12">ಕೂಡಿದ ಸಭೆಯಲ್ಲಿ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s">ಗಂಡಾಂತರದಲ್ಲಿ ಭಕ್ತನ ನಂಬಿಕೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1"/>ಯೆಹೋವನು ನನಗೆ ಬೆಳಕೂ, ರಕ್ಷಕನೂ ಆಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 27:1">ನಾನು ಯಾರಿಗೆ ಭಯಪಟ್ಟೆನು?</para>
  <para style="q" vid="PSA 27:1">ಯೆಹೋವನು ನನ್ನ ಪ್ರಾಣದ ಆಧಾರವು;</para>
  <para style="q" vid="PSA 27:1">ನಾನು ಯಾರಿಗೆ ಹೆದರೇನು?<verse eid="PSA 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2"/>ನನ್ನನ್ನು ಬಾಧಿಸುತ್ತಿರುವ ದುರ್ವೈರಿಗಳು</para>
  <para style="q" vid="PSA 27:2">ನನ್ನನ್ನು ನುಂಗಿಬಿಡಬೇಕೆಂದು ಬಂದು,</para>
  <para style="q" vid="PSA 27:2">ತಾವೇ ನೆಲಕ್ಕೆ ಬಿದ್ದುಹೋದರು.<verse eid="PSA 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3"/>ನನಗೆ ವಿರುದ್ಧವಾಗಿ ದಂಡು ಬಂದಿಳಿದರೂ ನನಗೇನೂ ಭಯವಿಲ್ಲ;</para>
  <para style="q" vid="PSA 27:3">ಚತುರಂಗಬಲವು ಯುದ್ಧಸನ್ನದ್ಧವಾಗಿ ನಿಂತರೂ,</para>
  <para style="q" vid="PSA 27:3">ಭರವಸವುಳ್ಳವನಾಗಿಯೇ ಇರುವೆನು.<verse eid="PSA 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4"/>ನನ್ನ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಯೆಹೋವನ ಮನೆಯಲ್ಲಿ ವಾಸಮಾಡುತ್ತಾ,</para>
  <para style="q" vid="PSA 27:4">ಆತನ ಪ್ರಸನ್ನತೆಯನ್ನು ನೋಡುವುದಕ್ಕೂ,</para>
  <para style="q" vid="PSA 27:4">ಆತನ ಮಂದಿರದಲ್ಲಿ ಧ್ಯಾನ ಮಾಡುವುದಕ್ಕೂ</para>
  <para style="q" vid="PSA 27:4">ನನಗೆ ಅಪ್ಪಣೆಯಾಗಬೇಕೆಂಬ ಒಂದೇ ವರವನ್ನು</para>
  <para style="q" vid="PSA 27:4">ಯೆಹೋವನಿಂದ ಕೇಳಿಕೊಂಡು ಅದನ್ನೇ ಎದುರು ನೋಡುತ್ತಿರುವೆನು.<verse eid="PSA 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5"/>ಅಪಾಯಕಾಲದಲ್ಲಿ ಆತನು ನನ್ನನ್ನು ಗುಪ್ತಸ್ಥಳದಲ್ಲಿ ಅಡಗಿಸುವನು;</para>
  <para style="q" vid="PSA 27:5">ತನ್ನ ಗುಡಾರವೆಂಬ ಆಶ್ರಯಸ್ಥಾನದಲ್ಲಿ ನನ್ನನ್ನು ಭದ್ರಪಡಿಸುವನು;</para>
  <para style="q" vid="PSA 27:5">ಪರ್ವತಶಿಖರದ ಮೇಲೆ ನನ್ನನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ನಿಲ್ಲಿಸುವನು.<verse eid="PSA 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6"/>ಹೀಗಿರುವುದರಿಂದ ನನ್ನ ಸುತ್ತಲಿರುವ ವೈರಿಗಳ ಮೇಲೆ,</para>
  <para style="q" vid="PSA 27:6">ನನ್ನ ತಲೆ ಎತ್ತಲ್ಪಟ್ಟಿರುವುದು;</para>
  <para style="q" vid="PSA 27:6">ನಾನು ಯೆಹೋವನ ಗುಡಾರದಲ್ಲಿ,</para>
  <para style="q" vid="PSA 27:6">ಉತ್ಸಾಹಧ್ವನಿಯೊಡನೆ ಯಜ್ಞಗಳನ್ನು ಸಮರ್ಪಿಸುವೆನು.</para>
  <para style="q" vid="PSA 27:6">ಆತನನ್ನು ಹಾಡುತ್ತಾ ವಾದ್ಯಬಾರಿಸುವೆನು.<verse eid="PSA 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7"/>ಯೆಹೋವನೇ, ನಿನಗೆ ಗಟ್ಟಿಯಾಗಿ ಮೊರೆಯಿಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 27:7">ನನ್ನನ್ನು ಕರುಣಿಸಿ, ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8"/>“ನನ್ನ ಸಾನ್ನಿಧ್ಯಕ್ಕೆ ಬಾ” ಎಂಬ ನಿನ್ನ ಮಾತಿಗೆ,</para>
  <para style="q" vid="PSA 27:8">ನಾನು, “ಯೆಹೋವನೇ, ನಿನ್ನ ಸಾನ್ನಿಧ್ಯಕ್ಕೆ ಬಂದೇ ಬರುವೆನು” ಎಂದು ಉತ್ತರಕೊಟ್ಟೆನು.<verse eid="PSA 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9"/>ನನಗೆ ವಿಮುಖನಾಗಿರಬೇಡ;</para>
  <para style="q" vid="PSA 27:9">ನಿನ್ನ ಸೇವಕನನ್ನು ಕೋಪದಿಂದ ತಳ್ಳಬೇಡ.</para>
  <para style="q" vid="PSA 27:9">ನೀನು ನನಗೆ ಸಹಾಯಕನಾಗಿಯೇ ಇದ್ದೆಯಲ್ಲವೇ;</para>
  <para style="q" vid="PSA 27:9">ನನ್ನನ್ನು ರಕ್ಷಿಸಿದ ದೇವರೇ, ಕೈಬಿಡಬೇಡ, ತೊರೆದುಬಿಡಬೇಡ.<verse eid="PSA 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10"/>ತಂದೆತಾಯಿಗಳು ನನ್ನನ್ನು ತೊರೆದುಬಿಟ್ಟರೇನು;</para>
  <para style="q" vid="PSA 27:10">ಯೆಹೋವನು ನನ್ನನ್ನು ಸೇರಿಸಿಕೊಳ್ಳುವನು.<verse eid="PSA 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಮಾರ್ಗವನ್ನು ನನಗೆ ಬೋಧಿಸು;</para>
  <para style="q" vid="PSA 27:11">ಹೊಂಚುಹಾಕಿರುವವರಿಗೆ ಸಿಕ್ಕದ ಹಾಗೆ ನನ್ನನ್ನು ಸಮವಾದ ದಾರಿಯಲ್ಲಿ ನಡೆಸು.<verse eid="PSA 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12"/>ಸುಳ್ಳುಸಾಕ್ಷಿಗಳೂ ಬೆದರಿಸುವವರೂ ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಎದ್ದಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 27:12">ಇಂಥ ವೈರಿಗಳ ವಶಕ್ಕೆ ನನ್ನನ್ನು ಕೊಡಬೇಡ.<verse eid="PSA 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13"/>ಜೀವಲೋಕದಲ್ಲಿಯೇ ಯೆಹೋವನ ದಯೆಯನ್ನು</para>
  <para style="q" vid="PSA 27:13">ಅನುಭವಿಸುವೆನು ಎಂದು ದೃಢವಾಗಿ ನಂಬಿದ್ದೇನೆ.<verse eid="PSA 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14"/>ಯೆಹೋವನನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿರು, ದೃಢವಾಗಿರು;</para>
  <para style="q" vid="PSA 27:14">ನಿನ್ನ ಹೃದಯವು ಧೈರ್ಯದಿಂದಿರಲಿ;</para>
  <para style="q" vid="PSA 27:14">ಯೆಹೋವನನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡೇ ಇರು.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s">ಭಕ್ತನ ಸ್ತುತಿ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1"/>ಯೆಹೋವನೇ, ನನ್ನ ಶರಣನೇ, ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 28:1">ಕೇಳದೆ ಇರಬೇಡ.</para>
  <para style="q" vid="PSA 28:1">ನೀನು ಕಿವಿಗೊಡದೆ ಹೋದರೆ ನಾನು ಸತ್ತವರಿಗೆ ಸಮಾನನಾಗುವೆನಲ್ಲವೇ.<verse eid="PSA 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2"/>ನೀನು ವಾಸಿಸುವ ಮಹಾಪರಿಶುದ್ಧಸ್ಥಾನದ ಕಡೆಗೆ</para>
  <para style="q" vid="PSA 28:2">ನಾನು ಕೈಯೆತ್ತಿ ಮೊರೆಯಿಡುತ್ತೇನಲ್ಲಾ;</para>
  <para style="q" vid="PSA 28:2">ನನ್ನ ವಿಜ್ಞಾಪನೆಯನ್ನು ಲಾಲಿಸು.<verse eid="PSA 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3"/>ನೀನು ದುಷ್ಟರೊಡನೆಯೂ, ದುರ್ಜನಗಳ ಸಂಗಡಲೂ</para>
  <para style="q" vid="PSA 28:3">ನನ್ನನ್ನೂ ಎಳೆದುಕೊಂಡು ಹೋಗಬೇಡ.</para>
  <para style="q" vid="PSA 28:3">ಅವರು ಹೊರಗೆ ಒಳ್ಳೆಯದಾಗಲಿ ಎಂದು ಹೇಳಿದರೂ,</para>
  <para style="q" vid="PSA 28:3">ಒಳಗೆ ಕೇಡಾಗಲಿ ಎಂದು ಯೋಚಿಸುವವರು.<verse eid="PSA 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4"/>ಅವರ ದುಷ್ಕೃತ್ಯಗಳಿಗೂ, ಕೆಡುಕಗಳಿಗೂ ಸರಿಯಾದ ಪ್ರತಿಫಲವನ್ನು ಅವರಿಗೆ ಕೊಡು;</para>
  <para style="q" vid="PSA 28:4">ಅವರು ಮತ್ತೊಬ್ಬರಿಗೆ ಮಾಡಿದಂತೆಯೇ ಅವರಿಗೆ ಮಾಡು.<verse eid="PSA 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5"/>ಅವರು ಯೆಹೋವನ ಕಾರ್ಯಗಳನ್ನೂ ಮತ್ತು</para>
  <para style="q" vid="PSA 28:5">ಆತನ ಕೈಕೆಲಸಗಳನ್ನೂ ವಿವೇಚಿಸಿ ತಿಳಿದುಕೊಳ್ಳದೆ ಹೋದರು;</para>
  <para style="q" vid="PSA 28:5">ಆದುದರಿಂದ ಆತನು ಅವರನ್ನು ಹಾಳುಮಾಡುವನೇ ಹೊರತು ವೃದ್ಧಿಪಡಿಸುವುದಿಲ್ಲ.<verse eid="PSA 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6"/>ಯೆಹೋವನು ನನ್ನ ವಿಜ್ಞಾಪನೆಗಳನ್ನು ಕೇಳಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 28:6">ಆತನಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.<verse eid="PSA 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7"/>ಯೆಹೋವನು ನನಗೆ ಬಲವೂ, ಗುರಾಣಿಯೂ ಆಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 28:7">ನಾನು ಆತನಲ್ಲಿ ಭರವಸವಿಟ್ಟೆನು, ನನಗೆ ಸಹಾಯವು ಉಂಟಾಯಿತು.</para>
  <para style="q" vid="PSA 28:7">ಆದಕಾರಣ ನನ್ನ ಹೃದಯವು ಹರ್ಷಿಸುವುದು;</para>
  <para style="q" vid="PSA 28:7">ಕೀರ್ತನಾರೂಪವಾಗಿ ಆತನನ್ನು ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8"/>ಯೆಹೋವನು ತನ್ನ ಜನರಿಗೆ ಬಲವೂ,</para>
  <para style="q" vid="PSA 28:8">ತಾನು ಅಭಿಷೇಕಿಸಿದವನಿಗೆ ಆಶ್ರಯದುರ್ಗವೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಜನರನ್ನು ರಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 28:9">ನಿನ್ನ ಸ್ವಕೀಯ ಪ್ರಜೆಯನ್ನು ಆಶೀರ್ವದಿಸು.</para>
  <para style="q" vid="PSA 28:9">ನೀನು ಅವರ ಕುರುಬನಾಗಿರು;</para>
  <para style="q" vid="PSA 28:9">ಅವರನ್ನು ಯಾವಾಗಲೂ ಪರಿಪಾಲಿಸುತ್ತಾ ಆಧಾರವಾಗಿರು.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s">ಮೇಘಮಂಡಲದಲ್ಲಿ ಕಾಣಿಸುವ ಯೆಹೋವನ ಮಹಿಮೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="JER 10:13">ಯೆರೆ 10:13</ref>; <ref loc="ISA 30:30">ಯೆಶಾ 30:30</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1"/>ದೇವದೂತರುಗಳಿರಾ, ಪರಮಪ್ರಭಾವವು,</para>
  <para style="q" vid="PSA 29:1">ಯೆಹೋವನದೇ, ಯೆಹೋವನದೇ ಎಂದು ಹೇಳಿ ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2"/>ಯೆಹೋವನ ನಾಮಕ್ಕೆ ಯೋಗ್ಯವಾದ ಘನತೆಯನ್ನು ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="q" vid="PSA 29:2">ಪರಿಶುದ್ಧತ್ವವೆಂಬ ಭೂಷಣದೊಡನೆ ಯೆಹೋವನಿಗೆ ಅಡ್ಡಬೀಳಿರಿ.<verse eid="PSA 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3"/>ಯೆಹೋವನ ಮಹಾಧ್ವನಿಯು ಮೇಘಮಂಡಲದಲ್ಲಿ ಕೇಳಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 29:3">ಪ್ರಭಾವಸ್ವರೂಪನಾದ ದೇವರು ಗುಡುಗುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 29:3">ಯೆಹೋವನು ಆಕಾಶದ ಜಲರಾಶಿಗಳ ಮೇಲೆ ಇದ್ದಾನೆ.<verse eid="PSA 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4"/>ಯೆಹೋವನ ಧ್ವನಿಯು ಎಷ್ಟೋ ಬಲವುಳ್ಳದ್ದು,</para>
  <para style="q" vid="PSA 29:4">ಎಷ್ಟೋ ಗಂಭೀರವಾದದ್ದು.<verse eid="PSA 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5"/>ಯೆಹೋವನ ಗರ್ಜನೆಗೆ ದೇವದಾರು ವೃಕ್ಷಗಳು ದಡಲ್ ಎಂದು ಮುರಿದು ಬೀಳುತ್ತವೆ;</para>
  <para style="q" vid="PSA 29:5">ಯೆಹೋವನು ಲೆಬನೋನ್ ಪರ್ವತದಲ್ಲಿನ ಮಹಾದೇವದಾರುಗಳನ್ನೂ ಮುರಿದುಬಿಡುತ್ತಾನೆ.<verse eid="PSA 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6"/>ಲೆಬನೋನ್ ಪರ್ವತವು ಕರುವಿನೋಪಾದಿಯಲ್ಲಿಯೂ, ಸಿರ್ಯೋನ್ ಬೆಟ್ಟವು</para>
  <para style="q" vid="PSA 29:6">ಕಾಡುಕೋಣದ ಮರಿಯಂತೆಯೂ ಹಾರಾಡುವ ಹಾಗೆ ಮಾಡುತ್ತಾನೆ.<verse eid="PSA 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7"/>ಯೆಹೋವನ ಗರ್ಜನೆಗೆ ಮಿಂಚುಗಳು</para>
  <para style="q" vid="PSA 29:7">ಥಳಥಳನೆ ಹೊಳೆಯುತ್ತವೆ.<verse eid="PSA 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8"/>ಯೆಹೋವನ ಗರ್ಜನೆಗೆ ಕಾಡು ಹೊರಳಾಡುತ್ತದೆ;</para>
  <para style="q" vid="PSA 29:8">ಕಾದೇಶ್ ಅರಣ್ಯವು ಕಂಪಿಸುತ್ತದೆ.<verse eid="PSA 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">29:9 </char>
      <char style="ft" closed="false">ಅಥವಾ ಯೆಹೋವನ ಗರ್ಜನೆಯು ಗರ್ಭದ ಜಿಂಕೆಗಳು ಈಯುತ್ತವೆ</char>
    </note>ಯೆಹೋವನ ಗರ್ಜನೆಯು ದೇವದಾರು ಮರಗಳನ್ನು ಕದಲಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 29:9">ಕಾಡಿನ ಮರಗಳು ಬರಿದಾಗುತ್ತವೆ.</para>
  <para style="q" vid="PSA 29:9">ಆಗ ಆತನ ಮಂದಿರದಲ್ಲಿರುವವರೆಲ್ಲರು, “ಎಷ್ಟೋ ಪ್ರಭಾವ!” ಎನ್ನುತ್ತಾರೆ.<verse eid="PSA 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10"/>ಯೆಹೋವನು ಜಲಪ್ರಳಯದಲ್ಲಿ ಆಸೀನನಾಗಿರುವನು;</para>
  <para style="q" vid="PSA 29:10">ಆತನು ಸದಾಕಾಲವೂ ಅರಸನಾಗಿ ಕುಳಿತಿರುವನು.<verse eid="PSA 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11"/>ಯೆಹೋವನು ತನ್ನ ಜನರಿಗೆ ಬಲವನ್ನು ಅನುಗ್ರಹಿಸುವನು;</para>
  <para style="q" vid="PSA 29:11">ಆತನು ತನ್ನ ಪ್ರಜೆಗೆ ಸುಕ್ಷೇಮವನ್ನು ದಯಪಾಲಿಸುವನು.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s">ಅಪಾಯದಿಂದ ತಪ್ಪಿಸಲ್ಪಟ್ಟವರು ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುವುದು</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ, ದೇವಾಲಯದ ಪ್ರತಿಷ್ಠೆಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು.</para>
  <para style="r">
    <ref loc="PSA 6">ಕೀರ್ತ 6</ref>; <ref loc="JHN 10:22">ಯೋಹಾ 10:22</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1"/>ಯೆಹೋವನೇ, ನನ್ನ ಶತ್ರುಗಳು ಸಂತೋಷಿಸುವುದಕ್ಕೆ ಅವಕಾಶಕೊಡದೆ,</para>
  <para style="q" vid="PSA 30:1">ನನ್ನನ್ನು ಉದ್ಧರಿಸಿದ್ದರಿಂದ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ,</para>
  <para style="q" vid="PSA 30:2">ನಿನಗೆ ಮೊರೆಯಿಡಲು ನನ್ನನ್ನು ಸ್ವಸ್ಥಮಾಡಿದಿ.<verse eid="PSA 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3"/>ಯೆಹೋವನೇ, ನನ್ನ ಪ್ರಾಣವನ್ನು ಪಾತಾಳದಿಂದಲೂ ಎತ್ತಿದಿಯಲ್ಲಾ;</para>
  <para style="q" vid="PSA 30:3">ನನ್ನನ್ನು ಸಮಾಧಿಯಲ್ಲಿ ಸೇರಿಸದೆ ಬದುಕಿಸಿದಿಯಲ್ಲಾ.<verse eid="PSA 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4"/>ಯೆಹೋವನ ಭಕ್ತರೇ, ಆತನನ್ನು ಕೀರ್ತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 30:4">ಆತನ ಪರಿಶುದ್ಧನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5"/>ಆತನ ಕೋಪವು ಕ್ಷಣಮಾತ್ರವೇ;</para>
  <para style="q" vid="PSA 30:5">ಆತನ ಅನುಗ್ರಹವೋ ಜೀವಮಾನವೆಲ್ಲಾ ಇರುವುದು;</para>
  <para style="q" vid="PSA 30:5">ಸಂಜೆಗೆ ದುಃಖವೆಂಬುದು ಬಂದು ನಮ್ಮ ಬಳಿಯಲ್ಲಿ ಇಳಿದುಕೊಂಡರೂ,</para>
  <para style="q" vid="PSA 30:5">ಮುಂಜಾನೆ ಹರ್ಷಧ್ವನಿಯು ಕೇಳಿಸುವುದು.<verse eid="PSA 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6"/>ನಾನಂತೂ ಸುಖದಿಂದಿದ್ದಾಗ, “ನಾನು ಎಂದಿಗೂ ಕದಲುವುದಿಲ್ಲ”</para>
  <para style="q" vid="PSA 30:6">ಎಂದು ಹೇಳಿಕೊಂಡಿದ್ದೆನು.<verse eid="PSA 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7"/>ಯೆಹೋವನೇ, ಕೃಪೆಮಾಡಿ ನಾನಿರುವ ಬೆಟ್ಟಕ್ಕೆ ಸ್ಥಿರವಾದ ಬಲವನ್ನು ಅನುಗ್ರಹಿಸಿದಿಯಲ್ಲಾ.</para>
  <para style="q" vid="PSA 30:7">ಆದರೂ ನೀನು ನಿನ್ನ ಮುಖವನ್ನು ಮರೆಮಾಡಿಕೊಂಡಾಗ ನಾನು ಕಳವಳಗೊಂಡೆನು.<verse eid="PSA 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8"/>ಯೆಹೋವನೇ, ನಿನಗೆ ಮೊರೆಯಿಟ್ಟೆನು; ನನ್ನ ಒಡೆಯನಿಗೆ ಬಿನ್ನವಿಸಿ,<verse eid="PSA 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9"/>“ನನ್ನನ್ನು ಕೊಂದುಹಾಕಿ ಸಮಾಧಿಗೆ ಸೇರಿಸಿದರೆ ನಿನಗೆ ಲಾಭವೇನು?</para>
  <para style="q" vid="PSA 30:9">ಮಣ್ಣು ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವುದೋ? ಅದು ನಿನ್ನ ನಂಬಿಕೆಯನ್ನು ಹೊಗಳುವುದೇನು?<verse eid="PSA 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10"/>ಯೆಹೋವನೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳಿ ಕರುಣಿಸು;</para>
  <para style="q" vid="PSA 30:10">ಯೆಹೋವನೇ, ನನ್ನ ಸಹಾಯಕ್ಕೆ ಬಾ” ಎಂದು ಹೇಳಿದೆನು.<verse eid="PSA 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11"/>ಆಗ ನೀನು ನನ್ನ ಗೋಳಾಟವನ್ನು ತಪ್ಪಿಸಿ, ಸಂತೋಷದಿಂದ ಕುಣಿದಾಡುವಂತೆ ಮಾಡಿದಿ;</para>
  <para style="q" vid="PSA 30:11">ನಾನು ಕಟ್ಟಿಕೊಂಡಿದ್ದ ಗೋಣಿತಟ್ಟನ್ನು ತೆಗೆದುಬಿಟ್ಟು,</para>
  <para style="q" vid="PSA 30:11">ಹರ್ಷವಸ್ತ್ರವನ್ನು ನನಗೆ ಧಾರಣೆಮಾಡಿಸಿದಿ.<verse eid="PSA 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12"/>ಇದರಿಂದ ಯೆಹೋವನೇ, ನನ್ನ ಮನಸ್ಸು ಎಡೆಬಿಡದೆ ನಿನ್ನನ್ನು ಕೀರ್ತಿಸುತ್ತಿರುವುದು;</para>
  <para style="q" vid="PSA 30:12">ನನ್ನ ದೇವರೇ, ನಿನ್ನನ್ನು ಸದಾಕಾಲವೂ ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s">ಕಷ್ಟದಲ್ಲಿರುವವರ ವಿಶ್ವಾಸದ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಮೊರೆಹೊಕ್ಕಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 31:1">ನನ್ನನ್ನು ಎಂದಿಗೂ ಅವಮಾನಕ್ಕೆ ಗುರಿಪಡಿಸಬೇಡ.</para>
  <para style="q" vid="PSA 31:1">ನಿನ್ನ ನೀತಿಗನುಸಾರವಾಗಿ ನನ್ನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2"/>ಕಿವಿಗೊಟ್ಟು ಕೇಳಿ ಬೇಗನೆ ನನ್ನನ್ನು ಬಿಡಿಸು;</para>
  <para style="q" vid="PSA 31:2">ನನ್ನನ್ನು ರಕ್ಷಿಸುವ ಆಶ್ರಯಗಿರಿಯೂ, ದುರ್ಗಸ್ಥಾನವೂ ಆಗಿರು.<verse eid="PSA 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3"/>ನೀನೇ ನನ್ನ ಬಂಡೆಯೂ, ಕೋಟೆಯೂ ಆಗಿದ್ದೀಯಲ್ಲಾ;</para>
  <para style="q" vid="PSA 31:3">ಆದುದರಿಂದ ನಿನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತ ದಾರಿತೋರಿಸಿ ನನ್ನನ್ನು ನಡೆಸು.<verse eid="PSA 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4"/>ಶತ್ರುಗಳು ನನಗೆ ರಹಸ್ಯವಾಗಿ ಹಾಕಿದ ಬಲೆಯೊಳಗೆ</para>
  <para style="q" vid="PSA 31:4">ಸಿಕ್ಕಿಬೀಳದಂತೆ ನನ್ನನ್ನು ಕಾಪಾಡು;<verse eid="PSA 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5"/>ನೀನೇ ನನಗೆ ಆಧಾರವಲ್ಲವೇ;</para>
  <para style="q" vid="PSA 31:5">ನನ್ನ ಆತ್ಮವನ್ನು ನಿನ್ನ ಕೈಗೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 31:5">ಯೆಹೋವನೇ, ನಂಬಿಗಸ್ತನಾದ ದೇವರೇ, ನನ್ನನ್ನು ವಿಮೋಚಿಸಿದ್ದೀ.<verse eid="PSA 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6"/>ವ್ಯರ್ಥವಾದ ವಿಗ್ರಹಗಳನ್ನೂ ಅವಲಂಬಿಸಿದವರನ್ನು ನಾನು ದ್ವೇಷಿಸುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 31:6">ನಾನಾದರೋ ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7"/>ನಿನ್ನ ಕೃಪೆಯಲ್ಲಿ ಸಂತೋಷಿಸಿ ಉಲ್ಲಾಸದಿಂದಿರುವೆನು;</para>
  <para style="q" vid="PSA 31:7">ನಾನು ಕುಗ್ಗಿಹೋಗಿರುವುದನ್ನು ನೋಡಿ,</para>
  <para style="q" vid="PSA 31:7">ನನ್ನ ಬಾಧೆಗಳನ್ನು ನೀನು ಲಕ್ಷ್ಯಕ್ಕೆ ತೆಗೆದುಕೊಂಡಿಯಲ್ಲಾ.<verse eid="PSA 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8"/>ನೀನು ನನ್ನನ್ನು ಶತ್ರುಗಳ ಕೈಕೆಳಗೆ ಬೀಳಿಸಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 31:8">ನಿರಾತಂಕ ಸ್ಥಾನದಲ್ಲಿ ನನ್ನನ್ನು ನಿಲ್ಲಿಸಿದಿ.<verse eid="PSA 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9"/>ಯೆಹೋವನೇ, ಕರುಣಿಸು; ಕಷ್ಟದಲ್ಲಿ ಬಿದ್ದಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 31:9">ನನಗುಂಟಾದ ಬಾಧೆಯ ದೆಸೆಯಿಂದ ನನ್ನ ಕಣ್ಣು ಗುಡ್ಡೆ ಸೇದಿಹೋಗಿದೆ; ದೇಹಾತ್ಮಗಳು ಕುಗ್ಗಿಹೋದವು.<verse eid="PSA 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10"/>ನನ್ನ ಜೀವಮಾನವೆಲ್ಲಾ ದುಃಖದಲ್ಲಿಯೂ, ನಿಟ್ಟುಸಿರಿನಲ್ಲಿಯೂ ಕಳೆದುಹೋಗುತ್ತಾ ಇದೆ;</para>
  <para style="q" vid="PSA 31:10">ನನ್ನ <note caller="+" style="f"><char style="fr" closed="false">31:10 </char><char style="ft" closed="false">ಅಥವಾ ಅಪರಾಧದಿಂದ. </char></note>ಸಂಕಟಗಳಿಂದ ನನ್ನ ಶಕ್ತಿಯು ಕುಂದಿಹೋಗಿದೆ;</para>
  <para style="q" vid="PSA 31:10">ನನ್ನ ಎಲುಬುಗಳು ಸವೆದುಹೋಗಿವೆ.<verse eid="PSA 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11"/>ನನ್ನ ಎಲ್ಲಾ ಹಿಂಸಕರ ದೆಸೆಯಿಂದ ದೂಷಣೆಗೆ ಗುರಿಯಾದೆನು;</para>
  <para style="q" vid="PSA 31:11">ವಿಶೇಷವಾಗಿ ನೆರೆಯವರು ನನ್ನನ್ನು ನಿಂದಿಸುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 31:11">ನನ್ನ ಪರಿಚಿತರಿಗೆ ನನ್ನಲ್ಲಿ ಭೀತಿಯುಂಟಾಯಿತು;</para>
  <para style="q" vid="PSA 31:11">ನನ್ನನ್ನು ದಾರಿಯಲ್ಲಿ ಕಂಡವರೆಲ್ಲರು ಓರೆಯಾಗಿ ಹೋಗುತ್ತಾರೆ.<verse eid="PSA 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12"/>ನಾನು ಸತ್ತವರಂತೆ ಯಾರ ಜ್ಞಾಪಕಕ್ಕೂ ಬಾರದವನಾದೆನು;</para>
  <para style="q" vid="PSA 31:12">ಒಡೆದ ಬೋಕಿಯಂತಿದ್ದೇನೆ.<verse eid="PSA 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13"/>ಅನೇಕರು ನನ್ನ ಪ್ರಾಣ ತೆಗೆಯಬೇಕೆಂದು ಒಳ ಸಂಚುಮಾಡುತ್ತಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 31:13">ಅವರು ಪಿಸುಗುಟ್ಟುವ ಮಾತುಗಳು ನನ್ನ ಕಿವಿಗೆ ಬಿದ್ದಿವೆ;</para>
  <para style="q" vid="PSA 31:13">ಎಲ್ಲಾ ಕಡೆಯಲ್ಲಿಯೂ ನನಗೆ ಭೀತಿಯುಂಟಾಗಿದೆ.<verse eid="PSA 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14"/>ನಾನಾದರೋ ಯೆಹೋವನೇ, ನಿನ್ನಲ್ಲೇ ಭರವಸವಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 31:14">ನೀನೇ ನನ್ನ ದೇವರೆಂದು ಹೇಳಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15"/>ನನ್ನ ಆಯುಷ್ಕಾಲವು ನಿನ್ನ ಕೈಯಲ್ಲಿದೆ;</para>
  <para style="q" vid="PSA 31:15">ಹಿಂದಟ್ಟುವ ಶತ್ರುಗಳಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿ ಕಾಪಾಡು.<verse eid="PSA 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16"/>ನಿನ್ನ ಸೇವಕನನ್ನು ಪ್ರಸನ್ನಮುಖದಿಂದ ನೋಡು;</para>
  <para style="q" vid="PSA 31:16">ಪ್ರೀತಿಯಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17"/>ಯೆಹೋವನೇ, ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ; ನನ್ನನ್ನು ನಿರಾಶೆಪಡಿಸಬೇಡ.</para>
  <para style="q" vid="PSA 31:17">ದುಷ್ಟರಿಗೇ ಆಶಾಭಂಗವಾಗಲಿ; ಅವರು ಸ್ತಬ್ಧರಾಗಿ ಪಾತಾಳಕ್ಕೆ ಬೀಳಲಿ.<verse eid="PSA 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18"/>ಯಾರು ನೀತಿವಂತರನ್ನು ತಾತ್ಸಾರಮಾಡಿ ಗರ್ವದಿಂದಲೂ, ಕೊಬ್ಬಿನಿಂದಲೂ</para>
  <para style="q" vid="PSA 31:18">ಅವರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸುಳ್ಳು ಹೇಳುತ್ತಾರೋ ಅವರ ತುಟಿಗಳು ಮುಚ್ಚಿಹೋಗಲಿ.<verse eid="PSA 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19"/>ಸದ್ಭಕ್ತರಿಗೋಸ್ಕರ ನೀನು ಇಟ್ಟುಕೊಂಡಿರುವ ಮೇಲೂ,</para>
  <para style="q" vid="PSA 31:19">ಆಶ್ರಿತರಿಗೋಸ್ಕರ ನೀನು ಎಲ್ಲರ ಮುಂದೆ ಮಾಡಿದ ಉಪಕಾರಗಳೂ</para>
  <para style="q" vid="PSA 31:19">ಎಷ್ಟೋ ವಿಶೇಷವಾಗಿವೆ.<verse eid="PSA 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20"/>ಮನುಷ್ಯರ ಒಳಸಂಚುಗಳಿಂದ ಹಾನಿ ಉಂಟಾಗದಂತೆ</para>
  <para style="q" vid="PSA 31:20">ಅವರನ್ನು ನಿನ್ನ ಸಾನ್ನಿಧ್ಯದಲ್ಲಿಯೇ ಮರೆಮಾಡುತ್ತೀ;</para>
  <para style="q" vid="PSA 31:20">ವಿವಾದಿಸುವ ನಾಲಿಗೆಗಳಿಂದ ಕೇಡಾಗದಂತೆ ಅವರನ್ನು ಗುಪ್ತಸ್ಥಳದಲ್ಲಿ ಅಡಗಿಸುತ್ತೀ.<verse eid="PSA 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21"/>ಮುತ್ತಿಗೆ ಹಾಕಲ್ಪಟ್ಟಿರುವ ನಗರದಲ್ಲಿದ್ದ ನನಗೆ,</para>
  <para style="q" vid="PSA 31:21">ತನ್ನ ಕೃಪೆಯನ್ನು ಆಶ್ಚರ್ಯಕರವಾಗಿ ತೋರಿಸಿದ ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ.<verse eid="PSA 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22"/>ನಾನಂತೂ ಭಯಭ್ರಾಂತನಾಗಿ, “ನಿನ್ನ ಸಾನ್ನಿಧ್ಯದಿಂದ ತೆಗೆದುಹಾಕಲ್ಪಟ್ಟೆನು” ಎಂದು ಅಂದುಕೊಂಡೆನು;</para>
  <para style="q" vid="PSA 31:22">ಆದರೂ ನಾನು ಮೊರೆಯಿಡಲು ನೀನು ಕೇಳಿದಿ.<verse eid="PSA 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23"/>ಭಕ್ತರೇ, ನೀವೆಲ್ಲರೂ ಯೆಹೋವನನ್ನು ಪ್ರೀತಿಸಿರಿ.</para>
  <para style="q" vid="PSA 31:23">ಆತನು ನಂಬಿಗಸ್ತರನ್ನು ಕಾಪಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 31:23">ಅಹಂಕಾರಿಗಳಿಗೆ ಚೆನ್ನಾಗಿ ಮುಯ್ಯಿತೀರಿಸುತ್ತಾನೆ.<verse eid="PSA 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24"/>ಯೆಹೋವನನ್ನು ನಿರೀಕ್ಷಿಸುವವರೇ, ದೃಢವಾಗಿರ್ರಿ;</para>
  <para style="q" vid="PSA 31:24">ನಿಮ್ಮ ಹೃದಯವು ಧೈರ್ಯದಿಂದಿರಲಿ.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s">ಪಾಪಪರಿಹಾರ ಮತ್ತು ನಂಬಿಕೆಯಿಂದ ಉಂಟಾಗುವ ಭಾಗ್ಯ</para>
  <para style="d">ದಾವೀದನ ಪದ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1"/>ಯಾರ ದ್ರೋಹವು ಪರಿಹಾರವಾಗಿದೆಯೋ,</para>
  <para style="q" vid="PSA 32:1">ಯಾರ ಪಾಪವು ಕ್ಷಮಿಸಲ್ಪಟ್ಟಿದೆಯೋ ಅವನೇ ಧನ್ಯನು.<verse eid="PSA 32:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2"/>ಯೆಹೋವನು ಯಾರ ಲೆಕ್ಕಕ್ಕೆ ಅಪರಾಧವನ್ನು ಎಣಿಸುವುದಿಲ್ಲವೋ?</para>
  <para style="q" vid="PSA 32:2">ಯಾರ ಹೃದಯದಲ್ಲಿ ಕಪಟವಿರುವುದಿಲ್ಲವೋ ಅವನು ಧನ್ಯನು.<verse eid="PSA 32:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3"/>ನಾನು ನನ್ನ ಪಾಪವನ್ನು ಅರಿಕೆಮಾಡದೆ ಇದ್ದಾಗ,</para>
  <para style="q" vid="PSA 32:3">ದಿನವೆಲ್ಲಾ ನರಳುವುದರಿಂದ ನನ್ನ ಎಲುಬುಗಳು ಸವೆದುಹೋಗುತ್ತಿದ್ದವು.<verse eid="PSA 32:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4"/>ಹಗಲಿರುಳು ನಿನ್ನ ಶಿಕ್ಷಾಹಸ್ತವು ನನ್ನ ಮೇಲೆ ಭಾರವಾಗಿತ್ತು;</para>
  <para style="q" vid="PSA 32:4">ನನ್ನ ಶರೀರದ ಸಾರವೆಲ್ಲಾ ಬೇಸಿಗೆಯ ನೀರಿನಂತೆ ಬತ್ತಿಹೋಯಿತು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 32:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5"/>ಹೀಗಿರುವಲ್ಲಿ ಯೆಹೋವನ ಸನ್ನಿಧಿಯಲ್ಲಿ ನನ್ನ ದ್ರೋಹವನ್ನು ಒಪ್ಪಿಕೊಳ್ಳುವೆನು ಅಂದುಕೊಂಡು</para>
  <para style="q" vid="PSA 32:5">ನನ್ನ ಪಾಪವನ್ನು ಮರೆಮಾಡದೆ ನಿನಗೆ ನನ್ನ ದೋಷವನ್ನು ತಿಳಿಸಿದೆನು.</para>
  <para style="q" vid="PSA 32:5">ನೀನು ನನ್ನ ಪಾಪಗಳ ಅಪರಾಧವನ್ನು ಪರಿಹರಿಸಿಬಿಟ್ಟಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 32:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6"/>ಆದುದರಿಂದ ಭಕ್ತರೆಲ್ಲರು <note caller="+" style="f"><char style="fr" closed="false">32:6 </char><char style="ft" closed="false">ಅಥವಾ ಕಷ್ಟಕಾಲದಲ್ಲಿ ಅಥವಾ ನೀನು ದೊರಕುವ ಕಾಲದಲ್ಲಿ.</char></note>ಅಗತ್ಯಕಾಲದಲ್ಲಿ ನಿನ್ನನ್ನು ಪ್ರಾರ್ಥಿಸಲಿ;</para>
  <para style="q" vid="PSA 32:6">ಆಗ ಮಹಾಪ್ರವಾಹವು ಅಂಥವರನ್ನು ಮುಟ್ಟುವುದೇ ಇಲ್ಲ.<verse eid="PSA 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7"/>ನೀನೇ ನನಗೆ ಮರೆಯು; ನಿರಪಾಯವಾಗಿ ನನ್ನನ್ನು ಕಾಯುವಿ;</para>
  <para style="q" vid="PSA 32:7">ವಿಮೋಚನಧ್ವನಿಯಿಂದ ನನ್ನನ್ನು ಆವರಿಸಿಕೊಳ್ಳುತ್ತೀ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 32:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8"/>ಯೆಹೋವನು, “ನಿನ್ನನ್ನು ಉಪದೇಶಿಸಿ ನಡೆಯಬೇಕಾದ ಮಾರ್ಗವನ್ನು ತಿಳಿಸುವೆನು;</para>
  <para style="q" vid="PSA 32:8">ನಿನ್ನನ್ನು ಕಟಾಕ್ಷಿಸಿ ಆಲೋಚನೆ ಹೇಳುವೆನು” ಎಂದು ಅನ್ನುತ್ತಾನಲ್ಲಾ.<verse eid="PSA 32:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9"/>ಆದುದರಿಂದ ನೀವು ವಿವೇಕಹೀನರಾಗಿ ಕುದುರೆಯಂತಾಗಲಿ ಅಥವಾ</para>
  <para style="q" vid="PSA 32:9">ಹೇಸರಗತ್ತೆಯಂತಾಗಲಿ ಇರಬೇಡಿರಿ;</para>
  <para style="q" vid="PSA 32:9">ಅವುಗಳು ಬಾರು ಕಡಿವಾಣಗಳಿಲ್ಲದೆ ಸ್ವಾಧೀನವಾಗುವುದಿಲ್ಲ.<verse eid="PSA 32:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10"/>ದುಷ್ಟರಿಗೆ ಅನೇಕ ಕಷ್ಟನಷ್ಟಗಳು ಉಂಟಾಗುವವು;</para>
  <para style="q" vid="PSA 32:10">ಆದರೆ ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಟ್ಟವರನ್ನು ಆತನ ಕೃಪೆಯು ಆವರಿಸಿಕೊಳ್ಳುವುದು.<verse eid="PSA 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11"/>ನೀತಿವಂತರೇ, ಯೆಹೋವನಲ್ಲಿ ಸಂತೋಷಿಸುತ್ತಾ ಉಲ್ಲಾಸವಾಗಿರಿ;</para>
  <para style="q" vid="PSA 32:11">ಯಥಾರ್ಥಚಿತ್ತರೇ, ಆತನ ವಿಷಯದಲ್ಲಿ ಉತ್ಸಾಹ ಧ್ವನಿಮಾಡಿರಿ.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="s">ರಕ್ಷಕನನ್ನು ಕೀರ್ತಿಸುವ ಭಕ್ತ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1"/>ನೀತಿವಂತರೇ, ಯೆಹೋವನ ವಿಷಯದಲ್ಲಿ ಉಲ್ಲಾಸಪಡಿರಿ;</para>
  <para style="q" vid="PSA 33:1">ಯಥಾರ್ಥಚಿತ್ತರು ಆತನನ್ನು ಸ್ತುತಿಸುವುದು ಯುಕ್ತವಾಗಿದೆ.<verse eid="PSA 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2"/>ಕಿನ್ನರಿಯನ್ನು ನುಡಿಸುತ್ತಾ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q" vid="PSA 33:2">ಹತ್ತುತಂತಿಗಳ ಸ್ವರಮಂಡಲವನ್ನು ನುಡಿಸುತ್ತಾ ಸಂಕೀರ್ತಿಸಿರಿ.<verse eid="PSA 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3"/>ಆತನ ಘನಕ್ಕಾಗಿ ನೂತನ ಕೀರ್ತನೆಯನ್ನು ಹಾಡಿರಿ;</para>
  <para style="q" vid="PSA 33:3">ಉತ್ಸಾಹಧ್ವನಿಯೊಡನೆ ಇಂಪಾಗಿ ಬಾರಿಸಿರಿ.<verse eid="PSA 33:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4"/>ಯೆಹೋವನ ವಚನವು ಯಥಾರ್ಥವಾದದ್ದು;</para>
  <para style="q" vid="PSA 33:4">ಆತನ ಕೃತ್ಯವೆಲ್ಲಾ ನಂಬಿಕೆಯುಳ್ಳದ್ದಾಗಿವೆ.<verse eid="PSA 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5"/>ಆತನು ನೀತಿ ಮತ್ತು ನ್ಯಾಯಗಳನ್ನು ಪ್ರೀತಿಸುವವನು;</para>
  <para style="q" vid="PSA 33:5">ಭೂಲೋಕವೆಲ್ಲಾ ಯೆಹೋವನ ಕೃಪೆಯಿಂದ ತುಂಬಿದೆ.<verse eid="PSA 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6"/>ಯೆಹೋವನ ಅಪ್ಪಣೆಯಿಂದಲೇ ಆಕಾಶವು ಉಂಟಾಯಿತು;</para>
  <para style="q" vid="PSA 33:6">ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ ಆತನ ಶ್ವಾಸದಿಂದ ನಿರ್ಮಿತವಾಯಿತು.<verse eid="PSA 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7"/>ನೀರುಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಿ ಸಮುದ್ರವನ್ನು ಮಾಡಿದವನು ಆತನೇ;</para>
  <para style="q" vid="PSA 33:7">ಭೂಮಿಯ ಕೆಳಗೆ ಜಲಾಶಯಗಳನ್ನು ಇಟ್ಟವನು ಆತನೇ.<verse eid="PSA 33:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8"/>ಭೂಲೋಕದವರೆಲ್ಲರೂ ಯೆಹೋವನಿಗೆ ಭಯಪಡಲಿ;</para>
  <para style="q" vid="PSA 33:8">ಭೂನಿವಾಸಿಗಳೆಲ್ಲರೂ ಆತನಿಗೆ ಹೆದರಲಿ.<verse eid="PSA 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9"/>ಆತನು ನುಡಿದ ಮಾತ್ರಕ್ಕೆ ಸಮಸ್ತವೂ ಉಂಟಾಯಿತು;</para>
  <para style="q" vid="PSA 33:9">ಆತನು ಆಜ್ಞಾಪಿಸುತ್ತಲೇ ಸರ್ವವೂ ಸ್ಥಾಪನೆಯಾಯಿತು.<verse eid="PSA 33:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10"/>ಯೆಹೋವನು ಅನ್ಯಜನರ ಸಂಕಲ್ಪಗಳನ್ನು ವ್ಯರ್ಥಮಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 33:10">ಅವರ ಯೋಚನೆಗಳನ್ನು ನಿಷ್ಫಲಮಾಡುತ್ತಾನೆ.<verse eid="PSA 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11"/>ಯೆಹೋವನ ಆಲೋಚನೆಯೋ ಶಾಶ್ವತವಾಗಿಯೇ ನಿಲ್ಲುವುದು;</para>
  <para style="q" vid="PSA 33:11">ಆತನ ಸಂಕಲ್ಪವು ಎಂದಿಗೂ ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 33:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12"/>ಯಾರಿಗೆ ಯೆಹೋವನೇ ದೇವರಾಗಿದ್ದಾನೋ,</para>
  <para style="q" vid="PSA 33:12">ಯಾವ ಜನಾಂಗದವರನ್ನು ಸ್ವಕೀಯರನ್ನಾಗಿ ಆದುಕೊಂಡಿದ್ದಾನೋ ಅವರೇ ಧನ್ಯರು.<verse eid="PSA 33:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13"/>ಯೆಹೋವನು ಆಕಾಶದಿಂದ ಮನುಷ್ಯರೆಲ್ಲರನ್ನು ನೋಡುತ್ತಾನೆ;<verse eid="PSA 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14"/>ತಾನಿರುವ ಸ್ಥಾನದಿಂದ ಭೂನಿವಾಸಿಗಳೆಲ್ಲರನ್ನು ದೃಷ್ಟಿಸುತ್ತಾನೆ.<verse eid="PSA 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15"/>ಅವರೆಲ್ಲರ ಹೃದಯಗಳನ್ನು ನಿರ್ಮಿಸಿದವನೂ,</para>
  <para style="q" vid="PSA 33:15">ಅವರ ಕೃತ್ಯಗಳನ್ನೆಲ್ಲಾ ವಿವೇಚಿಸುವವನೂ ಆತನೇ.<verse eid="PSA 33:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16"/>ಮಹಾ ಸೇನಾಬಲದಿಂದಲೇ ಯಾವ ಅರಸನಿಗೂ ಜಯವಾಗುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 33:16">ಯಾವ ಶೂರನೂ ಅಧಿಕವಾದ ಭುಜಬಲದಿಂದ ಸುರಕ್ಷಿತನಾಗುವುದಿಲ್ಲ.<verse eid="PSA 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17"/>ಜೀವದ ರಕ್ಷಣೆಗಾಗಿ ಕುದುರೆಯು ಪ್ರಯೋಜನವಿಲ್ಲ;</para>
  <para style="q" vid="PSA 33:17">ಅದು ತನ್ನ ವಿಶೇಷಬಲದಿಂದ ಯಾರನ್ನೂ ರಕ್ಷಿಸಲಾರದು.<verse eid="PSA 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18"/>ಯೆಹೋವನಾದರೋ ತನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರನ್ನು ಕಟಾಕ್ಷಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 33:18">ತನ್ನ ಕೃಪೆಯನ್ನು ನಿರೀಕ್ಷಿಸುವವರನ್ನು ಲಕ್ಷಿಸುತ್ತಾನೆ.<verse eid="PSA 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19"/>ಅವರ ಪ್ರಾಣವನ್ನು ಮರಣದಿಂದ ತಪ್ಪಿಸುವನು;</para>
  <para style="q" vid="PSA 33:19">ಬರಗಾಲದಲ್ಲಿ ಅವರ ಜೀವವನ್ನು ಉಳಿಸುವನು.<verse eid="PSA 33:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20"/>ನಮ್ಮ ಮನಸ್ಸು ಯೆಹೋವನಿಗೋಸ್ಕರ ಕಾದಿದೆ;</para>
  <para style="q" vid="PSA 33:20">ನಮ್ಮ ಸಹಾಯವೂ, ಗುರಾಣಿಯೂ ಆತನೇ.<verse eid="PSA 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21"/>ಆತನಲ್ಲಿ ನಮ್ಮ ಹೃದಯವು ಸಂತೋಷಿಸುವುದು;</para>
  <para style="q" vid="PSA 33:21">ಆತನ ಪರಿಶುದ್ಧನಾಮದಲ್ಲಿ ಭರವಸವಿಟ್ಟಿದ್ದೇವೆ.<verse eid="PSA 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22"/>ಯೆಹೋವನೇ, ನಾವು ನಿನ್ನನ್ನೇ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇವೆ;</para>
  <para style="q" vid="PSA 33:22">ನಿನ್ನ ಕೃಪೆಯು ನಮ್ಮ ಮೇಲೆ ಇರಲಿ.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s">ಯೆಹೋವನು ಸದಾ ಭಕ್ತಪಾಲಕನೆಂದು ವರ್ಣಿಸುವ ಇಬ್ರಿಯ ಅಕ್ಷರಕ್ರಮಾನುಸಾರವಾದ ಕೀರ್ತನೆ</para>
  <para style="d">ದಾವೀದನು ಅಬೀಮೆಲೆಕನ ಎದುರಿನಲ್ಲಿ ಹುಚ್ಚನಂತೆ ತೋರ್ಪಡಿಸಿಕೊಂಡು ಅವನ ಬಳಿಯಿಂದ ಹೊರಟಾಗ ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1"/>ನಾನು ಯೆಹೋವನನ್ನು ಎಡೆಬಿಡದೆ ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 34:1">ಆತನ ಸ್ತೋತ್ರವು ಯಾವಾಗಲೂ ನನ್ನ ಬಾಯಲ್ಲಿ ಇರುವುದು.<verse eid="PSA 34:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2"/>ನನ್ನ ಮನಸ್ಸು ಯೆಹೋವನಲ್ಲಿ ಹಿಗ್ಗುತ್ತಿರುವುದು;</para>
  <para style="q" vid="PSA 34:2">ಇದನ್ನು ದೀನರು ಕೇಳಿ ಸಂತೋಷಿಸುವರು.<verse eid="PSA 34:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3"/>ನನ್ನೊಡನೆ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q" vid="PSA 34:3">ನಾವು ಒಟ್ಟಾಗಿ ಆತನ ಹೆಸರನ್ನು ಘನಪಡಿಸೋಣ.<verse eid="PSA 34:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4"/>ನಾನು ಯೆಹೋವನ ಸನ್ನಿಧಿಯಲ್ಲಿ <note caller="+" style="f"><char style="fr" closed="false">34:4 </char><char style="ft" closed="false">ಅಥವಾ ಹುಡುಕಿದೆನು.</char></note>ಬೇಡಿಕೊಳ್ಳಲು,</para>
  <para style="q" vid="PSA 34:4">ಆತನು ಸದುತ್ತರವನ್ನು ಕೊಟ್ಟು ಎಲ್ಲಾ ಭೀತಿಯಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿದನು.<verse eid="PSA 34:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5"/>ಆತನನ್ನೇ ದೃಷ್ಟಿಸಿದವರು ಪ್ರಕಾಶವನ್ನು ಹೊಂದಿದರು;</para>
  <para style="q" vid="PSA 34:5">ಅವರ ಮುಖವು ಅವಮಾನಕ್ಕೆ ಈಡಾಗುವುದೇ ಇಲ್ಲ.<verse eid="PSA 34:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6"/>ಕಷ್ಟದಲ್ಲಿದ್ದ ಈ ಮನುಷ್ಯನು ಮೊರೆಯಿಡಲು,</para>
  <para style="q" vid="PSA 34:6">ಯೆಹೋವನು ಕೇಳಿ ಎಲ್ಲಾ ಬಾಧೆಗಳಿಂದ ಬಿಡಿಸಿದನು.<verse eid="PSA 34:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7"/>ಯೆಹೋವನ ಭಯಭಕ್ತಿಯುಳ್ಳವರ ಸುತ್ತಲು,</para>
  <para style="q" vid="PSA 34:7">ಆತನ ದೂತನು ದಂಡಿಳಿಸಿ, ಕಾವಲಾಗಿದ್ದು ಕಾಪಾಡುತ್ತಾನೆ.<verse eid="PSA 34:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8"/>ಯೆಹೋವನು ಸರ್ವೋತ್ತಮನೆಂದು ಅನುಭವದಿಂದ ತಿಳಿದುಕೊಳ್ಳಿರಿ;</para>
  <para style="q" vid="PSA 34:8">ಆತನನ್ನು ಆಶ್ರಯಿಸಿಕೊಂಡವರು ಎಷ್ಟೋ ಧನ್ಯರು.<verse eid="PSA 34:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9"/>ಯೆಹೋವನ ಜನರೇ, ಆತನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿರಿ;</para>
  <para style="q" vid="PSA 34:9">ಆತನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಿಗೆ ಯಾವ ಕೊರತೆಯೂ ಇರುವುದಿಲ್ಲ.<verse eid="PSA 34:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10"/>ಪ್ರಾಯದ ಸಿಂಹಗಳಾದರೋ ಹೊಟ್ಟೆಗಿಲ್ಲದೆ ಹಸಿದಾವು;</para>
  <para style="q" vid="PSA 34:10">ಯೆಹೋವನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಬೇಡಿಕೊಳ್ಳುವವರಿಗೆ ಯಾವ ಒಳಿತಿಗೆ ಕೊರತೆಯಿಲ್ಲ.<verse eid="PSA 34:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11"/>ಮಕ್ಕಳಿರಾ, ಬನ್ನಿರಿ, ನನ್ನ ಮಾತನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q" vid="PSA 34:11">ನಾನು ಯೆಹೋವನ ಭಯವನ್ನು ನಿಮಗೆ ಕಲಿಸುವೆನು.<verse eid="PSA 34:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12"/>ದೀರ್ಘಾಯುಷ್ಯವು ಬೇಕೋ?</para>
  <para style="q" vid="PSA 34:12">ಬಹುದಿನ ಬದುಕಿ ಸುಖವನ್ನು ಅನುಭವಿಸಬೇಕೋ?<verse eid="PSA 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13"/>ಹಾಗಾದರೆ ಕೆಟ್ಟದ್ದಕ್ಕೆ ಹೋಗದಂತೆ ನಾಲಿಗೆಯನ್ನು ಕಾದುಕೋ;</para>
  <para style="q" vid="PSA 34:13">ವಂಚನೆಯ ಮಾತುಗಳಿಗೆ ಬಿಡದೆ ತುಟಿಗಳನ್ನು ಇಟ್ಟುಕೋ.<verse eid="PSA 34:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14"/>ಕೆಟ್ಟದ್ದನ್ನು ಬಿಟ್ಟು ಒಳ್ಳೆಯದನ್ನೇ ಮಾಡು;</para>
  <para style="q" vid="PSA 34:14">ಸಮಾಧಾನವನ್ನು ಹಾರೈಸಿ ಅದಕ್ಕಾಗಿ ಪ್ರಯತ್ನಪಡು.<verse eid="PSA 34:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15"/>ಯೆಹೋವನು ನೀತಿವಂತರನ್ನು ಕಟಾಕ್ಷಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 34:15">ಅವರು ಮೊರೆಯಿಡುವಾಗ ಕಿವಿಗೊಡುತ್ತಾನೆ.<verse eid="PSA 34:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16"/>ಕೆಡುಕರಿಗೋ ಯೆಹೋವನು ಕೋಪದ ಮುಖವುಳ್ಳವನಾಗಿರುವನು;</para>
  <para style="q" vid="PSA 34:16">ಲೋಕದಲ್ಲಿ ಅವರ ನೆನಪೇ ಉಳಿಯದಂತೆ ತೆಗೆದುಹಾಕುವನು.<verse eid="PSA 34:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17"/>ಯೆಹೋವನು ನೀತಿವಂತರ ಕೂಗನ್ನು ಕೇಳಿ,</para>
  <para style="q" vid="PSA 34:17">ಎಲ್ಲಾ ಕಷ್ಟಗಳಿಂದ ಅವರನ್ನು ಬಿಡಿಸುತ್ತಾನೆ.<verse eid="PSA 34:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18"/>ಮುರಿದ ಮನಸ್ಸುಳ್ಳವರಿಗೆ ಯೆಹೋವನು ನೆರವಾಗುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 34:18">ಕುಗ್ಗಿಹೋದವರನ್ನು ಉದ್ಧಾರಮಾಡುತ್ತಾನೆ.<verse eid="PSA 34:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19"/>ನೀತಿವಂತನಿಗೆ ಸಂಭವಿಸುವ ಕಷ್ಟಗಳು ಅನೇಕವಿದ್ದರೂ,</para>
  <para style="q" vid="PSA 34:19">ಯೆಹೋವನು ಅವೆಲ್ಲವುಗಳಿಂದ ಅವನನ್ನು ಬಿಡಿಸುತ್ತಾನೆ.<verse eid="PSA 34:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20"/>ಆತನು ಅವನ ಎಲುಬುಗಳನ್ನೆಲ್ಲಾ ಕಾಪಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 34:20">ಅವುಗಳಲ್ಲಿ ಒಂದಾದರೂ ಮುರಿದುಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 34:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21"/>ದುಷ್ಟನ ಕೆಡುಕು ಅವನನ್ನೇ ಕೊಲ್ಲುವುದು;</para>
  <para style="q" vid="PSA 34:21">ನೀತಿವಂತನನ್ನು ದ್ವೇಷಿಸುವವರು ಅಪರಾಧಿಗಳೆಂದು ಎಣಿಸಲ್ಪಡುವರು.<verse eid="PSA 34:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22"/>ಯೆಹೋವನು ತನ್ನ ಸೇವಕರ ಪ್ರಾಣವನ್ನು ವಿಮೋಚಿಸುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 34:22">ಆತನ ಆಶ್ರಿತರಲ್ಲಿ ಒಬ್ಬರಾದರೂ ಅಪರಾಧಿಯೆಂದು ಎಣಿಸಲ್ಪಡುವುದಿಲ್ಲ.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s">ವೈರಿಗಳಿಂದ ಬಿಡಿಸಬೇಕೆಂಬ ವಿಜ್ಞಾಪನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 7">ಕೀರ್ತ 7</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1"/>ಯೆಹೋವನೇ, ನನ್ನ ಸಂಗಡ ವ್ಯಾಜ್ಯ ಮಾಡುವವರೊಡನೆ ವ್ಯಾಜ್ಯಮಾಡು;</para>
  <para style="q" vid="PSA 35:1">ನನ್ನ ಮೇಲೆ ಯುದ್ಧ ಮಾಡುವವರ ಸಂಗಡ ಯುದ್ಧ ಮಾಡು.<verse eid="PSA 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2"/>ಖೇಡ್ಯ ಮತ್ತು ಗುರಾಣಿಯನ್ನು ಹಿಡಿದುಕೊಂಡು,</para>
  <para style="q" vid="PSA 35:2">ನನಗೆ ಸಹಾಯಕನಾಗಿ ನಿಲ್ಲು.<verse eid="PSA 35:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3"/>ನೀನು ಭರ್ಜಿಯನ್ನೂ ಹಾಗೂ ಯುದ್ಧದ ಕೊಡಲಿಯನ್ನೂ ಹಿಡಿದು,</para>
  <para style="q" vid="PSA 35:3">ನನ್ನನ್ನು ಹಿಂದಟ್ಟುವ ವೈರಿಗಳನ್ನು ಎದುರಿಸು;</para>
  <para style="q" vid="PSA 35:3">“ನಾನೇ ನಿನ್ನ ರಕ್ಷಣೆ” ಎಂದು ಅಭಯಕೊಡು.<verse eid="PSA 35:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ತೆಗೆಯಬೇಕೆಂದಿರುವವರು ಆಶಾಭಂಗಪಟ್ಟು ಅವಮಾನಹೊಂದಲಿ;</para>
  <para style="q" vid="PSA 35:4">ನನಗೆ ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವರು ಕಳವಳದಿಂದ ಹಿಂದಿರುಗಿ ಓಡಲಿ.<verse eid="PSA 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5"/>ಅವರು ಗಾಳಿ ಹಾರಿಸುವ ಹೊಟ್ಟಿನಂತಾಗಲಿ;</para>
  <para style="q" vid="PSA 35:5">ಯೆಹೋವನ ದೂತನು ಅವರನ್ನು ಅಟ್ಟಿಬಿಡಲಿ.<verse eid="PSA 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6"/>ಕತ್ತಲೆಯೂ, ಜಾರಿಕೆಯೂ ಇರುವ ದಾರಿಯಲ್ಲಿ</para>
  <para style="q" vid="PSA 35:6">ಯೆಹೋವನ ದೂತನು ಅವರನ್ನು ಹಿಂದಟ್ಟಲಿ.<verse eid="PSA 35:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7"/>ಅವರು ನಿಷ್ಕಾರಣವಾಗಿ ನನಗೆ ಬಲೆಯೊಡ್ಡಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 35:7">ಕಾರಣವಿಲ್ಲದೆ ನನ್ನ ಪ್ರಾಣವನ್ನು ತೆಗೆಯಬೇಕೆಂದು ಗುಂಡಿಯನ್ನು ತೋಡಿದ್ದಾರೆ.<verse eid="PSA 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8"/>ಅವನಿಗೆ ನಾಶನವು ಆಕಸ್ಮಾತ್ತಾಗಿ ಬರಲಿ;</para>
  <para style="q" vid="PSA 35:8">ತಾನು ಹಾಸಿದ ಬಲೆಯಲ್ಲಿ ತಾನೇ ಸಿಕ್ಕಿಬೀಳಲಿ.</para>
  <para style="q" vid="PSA 35:8">ತಾನು ತೋಡಿದ ಕುಣಿಯಲ್ಲಿ ತಾನೇ ಬಿದ್ದುಹೋಗಲಿ.<verse eid="PSA 35:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9"/>ಆಗ ನನ್ನ ಮನಸ್ಸಿಗೆ ಯೆಹೋವನ ದೆಸೆಯಿಂದ ಹರ್ಷವುಂಟಾಗುವುದು;</para>
  <para style="q" vid="PSA 35:9">ಆತನಿಂದಾದ ರಕ್ಷಣೆಯ ನಿಮಿತ್ತ ಆನಂದಪಡುವೆನು.<verse eid="PSA 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10"/>ಯೆಹೋವನೇ, ಕುಗ್ಗಿದವನನ್ನು ಬಲಾತ್ಕಾರಿಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 35:10">ದಿಕ್ಕಿಲ್ಲದ ಬಡವನನ್ನು ಸೂರೆಮಾಡುವವನಿಂದಲೂ ತಪ್ಪಿಸಿ ರಕ್ಷಿಸುವಾತನೇ,</para>
  <para style="q" vid="PSA 35:10">“ನಿನಗೆ ಸಮಾನರು ಯಾರಿದ್ದಾರೆ?” ಎಂದು ನನ್ನ ಎಲುಬುಗಳೆಲ್ಲಾ ಹೇಳುವವು.<verse eid="PSA 35:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11"/>ನ್ಯಾಯವಿರುದ್ಧ ಸಾಕ್ಷಿಗಳು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಎದ್ದಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 35:11">ನಾನರಿಯದ ಸಂಗತಿಗಳ ವಿಷಯದಲ್ಲಿ ನನ್ನನ್ನು ವಿಚಾರಿಸುತ್ತಾರೆ.<verse eid="PSA 35:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12"/>ಅವರು ಉಪಕಾರಕ್ಕೆ ಅಪಕಾರವನ್ನೇ ಮಾಡುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 35:12">ನಾನು ದಿಕ್ಕಿಲ್ಲದವನಾದೆನು.<verse eid="PSA 35:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13"/>ನಾನಾದರೋ ಅವರ ಅಸ್ವಸ್ಥಕಾಲದಲ್ಲಿ ಗೋಣಿ ತಟ್ಟನ್ನೇ ಕಟ್ಟಿಕೊಂಡಿದ್ದೆನು;</para>
  <para style="q" vid="PSA 35:13">ಉಪವಾಸದಿಂದ ನನ್ನ ಆತ್ಮವನ್ನು ನೋಯಿಸಿದೆನು.</para>
  <para style="q" vid="PSA 35:13">
    <note caller="+" style="f">
      <char style="fr" closed="false">35:13 </char>
      <char style="ft" closed="false">ಅಥವಾ ನನ್ನ ತಲೆಬಾಗಿ ಪ್ರಾರ್ಥಿಸಿದನು. ಅಥವಾ ನನ್ನ ಪ್ರಾರ್ಥನೆಯು ನನ್ನ ಎದೆಗೆ ತಿರುಗಿತು.</char>
    </note>ನನ್ನ ಪ್ರಾರ್ಥನೆಯು ಕೇಳಲ್ಪಡಲಿಲ್ಲ.<verse eid="PSA 35:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14"/>ಅಸ್ವಸ್ಥನಾದವನನ್ನು ಸ್ನೇಹಿತನೋ, ಅಣ್ಣನೋ ಎಂದು ಭಾವಿಸಿ ನಡೆದುಕೊಂಡೆನು;</para>
  <para style="q" vid="PSA 35:14">ತಾಯಿ ಸತ್ತದ್ದಕ್ಕಾಗಿ ದುಃಖಿಸುವವನಂತೆ ನಾನು ತಲೆಬಾಗಿ ಅಳುತ್ತಿದ್ದೆನು.<verse eid="PSA 35:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15"/>ಆದರೂ ನನಗೆ ಆಪತ್ತು ಬಂದಾಗ,</para>
  <para style="q" vid="PSA 35:15">ಅವರು ಸಂತೋಷಿಸುತ್ತಾ ಕೂಡಿಕೊಂಡರು;</para>
  <para style="q" vid="PSA 35:15">ನಿರಾಕಾರಣವಾಗಿ ಈ ಭ್ರಷ್ಟರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಕೂಡಿ ಕೊಂಡಾಡಿದರು,</para>
  <para style="q" vid="PSA 35:15">ಸೂರೆ ಮಾಡುವುದನ್ನು ಬಿಡಲೇ ಇಲ್ಲ.<verse eid="PSA 35:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16"/>ಆಹಾರಕ್ಕೋಸ್ಕರ ಪರಿಹಾಸ್ಯಮಾಡುವ ಮೂರ್ಖರ ಸಂಗಡ,</para>
  <para style="q" vid="PSA 35:16">ನನ್ನ ಮೇಲೆ ಹಲ್ಲುಕಡಿಯುತ್ತಾರೆ.<verse eid="PSA 35:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17"/>ಕರ್ತನೇ, ಇನ್ನೆಷ್ಟರ ವರೆಗೆ ಸುಮ್ಮನೆ ನೋಡುತ್ತಾ ಇರುವಿ?</para>
  <para style="q" vid="PSA 35:17">ಅವರ ಅಪಾಯದಿಂದ ನನ್ನ ಪ್ರಾಣವನ್ನು ಬಿಡಿಸು;</para>
  <para style="q" vid="PSA 35:17">ನನ್ನ ಪರಮಪ್ರಿಯ ಪ್ರಾಣವನ್ನು ಆ ಸಿಂಹಗಳ ಬಾಯಿಗೆ ಸಿಕ್ಕದಂತೆ ತಪ್ಪಿಸು.<verse eid="PSA 35:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18"/>ಆಗ ನಾನು ಮಹಾಸಭೆಯಲ್ಲಿ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 35:18">ಬಹುಜನರ ಮುಂದೆ ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 35:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19"/>ಅವಶ್ಯವಿಲ್ಲದ ವಿರೋಧಿಗಳು ನನ್ನ ವಿಷಯದಲ್ಲಿ ಹಿಗ್ಗುವುದಕ್ಕೆ ಅವಕಾಶಕೊಡಬೇಡ;</para>
  <para style="q" vid="PSA 35:19">ನಿಷ್ಕಾರಣ ವೈರಿಗಳ ಕಣ್ಣುಸನ್ನೆಗೆ ಆಸ್ಪದಕೊಡಬೇಡ.<verse eid="PSA 35:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20"/>ಅವರ ಮಾತುಗಳು ಸಮಾಧಾನಕರವಾದವುಗಳಲ್ಲ;</para>
  <para style="q" vid="PSA 35:20">ದೇಶದ ಸಾಧುಜನರನ್ನು ಕೆಡಿಸುವುದಕ್ಕೆ ಮೋಸವನ್ನು ಕಲ್ಪಿಸುತ್ತಾರೆ.<verse eid="PSA 35:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21"/>ಅವರು ನನ್ನನ್ನು ನೋಡಿ ಬಾಯಿಕಿಸಿದು, “ಆಹಾ, ಆಹಾ, ನಮ್ಮ ಕಣ್ಣು ಕಂಡಿತಲ್ಲಾ” ಎಂದು ಅನ್ನುತ್ತಾರೆ.<verse eid="PSA 35:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22"/>ಯೆಹೋವನೇ, ನೀನೇ ನೋಡಿದಿಯಲ್ಲವೇ;</para>
  <para style="q" vid="PSA 35:22">ಸುಮ್ಮನಿರಬೇಡ;</para>
  <para style="q" vid="PSA 35:22">ನನ್ನ ಒಡೆಯನೇ, ನನ್ನಿಂದ ದೂರವಾಗಿರುವುದೇಕೆ?<verse eid="PSA 35:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23"/>ನನ್ನ ದೇವರೇ, ಎದ್ದು ನನಗಾಗಿ ನ್ಯಾಯವನ್ನು ನಿರ್ಣಯಿಸು;</para>
  <para style="q" vid="PSA 35:23">ನನ್ನ ಕರ್ತನೇ, ಎಚ್ಚೆತ್ತು ನನ್ನ ವಿವಾದವನ್ನು ವಿಚಾರಿಸು.<verse eid="PSA 35:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ, ನಿನ್ನ ನೀತಿಗನುಸಾರವಾಗಿ ನನಗೆ ತೀರ್ಪುಕೊಡು;</para>
  <para style="q" vid="PSA 35:24">ನನ್ನ ವಿಷಯದಲ್ಲಿ ಹಿಗ್ಗುವುದಕ್ಕೆ ಶತ್ರುಗಳಿಗೆ ಆಸ್ಪದವಿರಬಾರದು.<verse eid="PSA 35:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25"/>ಆಹಾ, ನಮ್ಮ ಆಶೆ ನೆರವೇರಿತು ಅಂದುಕೊಳ್ಳುವುದಕ್ಕೆ ಅವರಿಗೆ ಅವಕಾಶವಿರಬಾರದು;</para>
  <para style="q" vid="PSA 35:25">
    <note caller="+" style="f">
      <char style="fr" closed="false">35:25 </char>
      <char style="ft" closed="false">ಅಥವಾ ಅವನನ್ನು ನುಂಗಿಬಿಟ್ಟಿದ್ದೇವೆಂದು.</char>
    </note>ಅವನನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡಿಬಿಟ್ಟಿದ್ದೇವೆಂದು ಅವರು ಕೊಚ್ಚಿಕೊಳ್ಳಬಾರದು.<verse eid="PSA 35:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26"/>ನನ್ನ ಕೇಡಿನಲ್ಲಿ ಹಿಗ್ಗುವವರೆಲ್ಲರು ಆಶಾಭಂಗಪಟ್ಟು ಅವಮಾನಹೊಂದಲಿ;</para>
  <para style="q" vid="PSA 35:26">ನನ್ನನ್ನು ಹೀಯಾಳಿಸಿ ಆತ್ಮಸ್ತುತಿಮಾಡಿಕೊಳ್ಳುವವರು,</para>
  <para style="q" vid="PSA 35:26">ಅವಮಾನವನ್ನೂ, ಅಪಕೀರ್ತಿಯನ್ನೂ ಹೊಂದಲಿ.<verse eid="PSA 35:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27"/>ನನ್ನ ನ್ಯಾಯಸ್ಥಾಪನೆಯನ್ನು ಬಯಸುವವರು</para>
  <para style="q" vid="PSA 35:27">ಆನಂದದೊಡನೆ ಜಯಧ್ವನಿಮಾಡಲಿ;</para>
  <para style="q" vid="PSA 35:27">ತನ್ನ ಸೇವಕನ ಹಿತವನ್ನು ಕೋರುವ ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ ಎಂದು ಯಾವಾಗಲೂ ಹೇಳುವವರಾಗಲಿ.<verse eid="PSA 35:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28"/>ನನ್ನ ನಾಲಿಗೆಯು ನಿನ್ನ ನೀತಿಯನ್ನೂ ಮಹಿಮೆಯನ್ನೂ ದಿನವೆಲ್ಲಾ ವರ್ಣಿಸುವುದು.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s">ದುಷ್ಟರ ದುರ್ಲಕ್ಷಣ ಮತ್ತು ದೇವರ ಮಹಾಪ್ರೀತಿ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಯೆಹೋವನ ಸೇವಕನಾದ ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1"/>ಪಾಪವು ದುಷ್ಟನ ಮನಸ್ಸಿನೊಳಗೆ ನುಡಿಯುತ್ತಿರುವುದರಿಂದ</para>
  <para style="q" vid="PSA 36:1">ಅವನ ಕಣ್ಣೆದುರಿಗೆ ದೇವರ ಭಯವೇ ಇಲ್ಲ.<verse eid="PSA 36:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2"/>ಅದು ಅವನನ್ನು ವಂಚಿಸಿ, “ನಿನ್ನ ದ್ರೋಹವು ಬೈಲಿಗೆ ಬರುವುದಿಲ್ಲ ಮತ್ತು</para>
  <para style="q" vid="PSA 36:2">ನಿನಗೆ ಕೇಡು ತರುವುದಿಲ್ಲ” ಎಂದು ಊದಿಬಿಡುತ್ತದೆ.<verse eid="PSA 36:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3"/>ಅವನ ಬಾಯಿಂದ ಕೆಡುಕೂ, ವಂಚನೆಯೂ ಬರುತ್ತವೆ;</para>
  <para style="q" vid="PSA 36:3">ವಿವೇಕಮಾರ್ಗವನ್ನೂ, ಪರಹಿತವನ್ನೂ ಬಿಟ್ಟೇಬಿಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 36:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4"/>ಹಾಸಿಗೆಯ ಮೇಲೆ ಇರುವಾಗಲೂ ಕೆಡುಕನ್ನೇ ಯೋಚಿಸುತ್ತಿರುವನು;</para>
  <para style="q" vid="PSA 36:4">ದುಷ್ಟ ಮಾರ್ಗದಲ್ಲಿ ನಿಂತುಕೊಂಡಿದ್ದಾನೆ; ಎಂಥ ದುಷ್ಕೃತ್ಯಕ್ಕೂ ಹೇಸುವುದಿಲ್ಲ.<verse eid="PSA 36:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಪ್ರೀತಿಯು ಆಕಾಶದಷ್ಟು ಉನ್ನತವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 36:5">ನಿನ್ನ ನಂಬಿಗಸ್ತಿಕೆಯು ಮೇಘಮಾರ್ಗವನ್ನು ಮುಟ್ಟುತ್ತದೆ.<verse eid="PSA 36:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6"/>ನಿನ್ನ ನೀತಿಯು ದಿವ್ಯಪರ್ವತಗಳಂತೆಯೂ,</para>
  <para style="q" vid="PSA 36:6">ನಿನ್ನ ನ್ಯಾಯವು ಮಹಾಸಾಗರದಂತೆಯೂ ಇವೆ;</para>
  <para style="q" vid="PSA 36:6">ಯೆಹೋವನೇ, ನೀನು ಮನುಷ್ಯರನ್ನೂ, ಮೃಗಗಳನ್ನೂ ಸಂರಕ್ಷಿಸುತ್ತೀ.<verse eid="PSA 36:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7"/>ದೇವರೇ, ನಿನ್ನ ಪ್ರೀತಿ ಎಷ್ಟೋ ಅಮೂಲ್ಯವಾದದ್ದು;</para>
  <para style="q" vid="PSA 36:7">ಮಾನವರು ನಿನ್ನ ರೆಕ್ಕೆಗಳ ಮರೆಯನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 36:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8"/>ನಿನ್ನ ಮಂದಿರದ ಸಮೃದ್ಧಿಯಿಂದ ಅವರನ್ನು ಸಂತೃಪ್ತಿಪಡಿಸುತ್ತೀ;</para>
  <para style="q" vid="PSA 36:8">ನಿನ್ನ ಸಂಭ್ರಮಪ್ರವಾಹದಲ್ಲಿ ಅವರಿಗೆ ಪಾನಮಾಡಿಸುತ್ತೀ.<verse eid="PSA 36:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9"/>ನಿನ್ನ ಬಳಿಯಲ್ಲಿ ಜೀವದ ಬುಗ್ಗೆ ಉಂಟಲ್ಲಾ;</para>
  <para style="q" vid="PSA 36:9">ನಿನ್ನ ತೇಜಸ್ಸು ನಮಗೆ ಬೆಳಕು ಕೊಡುತ್ತದೆ.<verse eid="PSA 36:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10"/>ನಿನ್ನನ್ನು ಅರಿತವರಿಗೆ ನಿನ್ನ ಪ್ರೀತಿಯನ್ನು ಯಾವಾಗಲೂ ದಯಪಾಲಿಸು;</para>
  <para style="q" vid="PSA 36:10">ಯಥಾರ್ಥಚಿತ್ತರಿಗೆ ನಿನ್ನ ನ್ಯಾಯವನ್ನು ನಿರಂತರವೂ ಅನುಗ್ರಹಿಸು.<verse eid="PSA 36:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11"/>ಗರ್ವಿಷ್ಠರ ಕಾಲಕೆಳಗೆ ನಮ್ಮನ್ನು ಬೀಳಿಸಬೇಡ;</para>
  <para style="q" vid="PSA 36:11">ದುರ್ಜನರಿಂದ ನಾವು ದೇಶಭ್ರಷ್ಟರಾಗದಂತೆ ಮಾಡು.<verse eid="PSA 36:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12"/>ಇಗೋ, ಕೆಡುಕರು ಕೆಡವಲ್ಪಟ್ಟು ಏಳಲಾರದೆ ಬಿದ್ದಿದ್ದಾರೆ.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s">ಸದ್ಭಕ್ತರು ನಂಬಿಕೆಯಿಂದಲೇ ಜೀವಿಸಬೇಕೆಂದು ಬೋಧಿಸುವ ಇಬ್ರಿಯ ಅಕ್ಷರಕ್ರಮಾನುಸಾರವಾದ ಕೀರ್ತನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 39">ಕೀರ್ತ 39</ref>; <ref loc="PSA 73">73</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1"/>ಕೆಟ್ಟ ನಡತೆಯುಳ್ಳವರನ್ನು ನೋಡಿ ತಳಮಳಗೊಳ್ಳಬೇಡ;</para>
  <para style="q" vid="PSA 37:1">ದುರಾಚಾರಿಗಳನ್ನು ನೋಡಿ ಅಸೂಯೆಪಡಬೇಡ.<verse eid="PSA 37:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2"/>ಅವರು ಹುಲ್ಲಿನಂತೆ ಬೇಗ ಒಣಗಿಹೋಗುವರು;</para>
  <para style="q" vid="PSA 37:2">ಹಸಿರು ಸಸಿಯಂತೆ ಬಾಡಿಹೋಗುವರು.<verse eid="PSA 37:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3"/>ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಟ್ಟು ಒಳ್ಳೆಯದನ್ನು ಮಾಡು;</para>
  <para style="q" vid="PSA 37:3">ದೇಶದಲ್ಲಿ ವಾಸವಾಗಿದ್ದು ನಂಬಿಕೆಯನ್ನು ಅನುಸರಿಸು.<verse eid="PSA 37:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4"/>ನೀನು ಯೆಹೋವನಲ್ಲಿ ಸಂತೋಷಿಸು;</para>
  <para style="q" vid="PSA 37:4">ಆಗ ಆತನು ನಿನ್ನ ಇಷ್ಟಾರ್ಥಗಳನ್ನು ನೆರವೇರಿಸುವನು.<verse eid="PSA 37:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5"/>ನಿನ್ನ ಭೂಯಾತ್ರೆಯ ಚಿಂತೆಯನ್ನು ಯೆಹೋವನಿಗೆ ವಹಿಸಿಬಿಟ್ಟು ಭರವಸದಿಂದಿರು;</para>
  <para style="q" vid="PSA 37:5">ಆತನೇ ಅದನ್ನು ಸಾಗಿಸುವನು.<verse eid="PSA 37:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6"/>ಆತನು ನಿನ್ನ ನೀತಿಯನ್ನು ಉದಯದ ಬೆಳಕಿನಂತೆಯೂ,</para>
  <para style="q" vid="PSA 37:6">ನಿನ್ನ ನ್ಯಾಯವನ್ನು ಮಧ್ಯಾಹ್ನದ ತೇಜಸ್ಸಿನಂತೆಯೂ ಪ್ರಕಾಶಗೊಳಿಸುವನು.<verse eid="PSA 37:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7"/>ಯೆಹೋವನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಶಾಂತನಾಗಿ ಆತನಿಗೋಸ್ಕರ ಕಾದಿರು;</para>
  <para style="q" vid="PSA 37:7">ಕುಯುಕ್ತಿಗಳನ್ನು ನೆರವೇರಿಸಿಕೊಂಡು ಅಭಿವೃದ್ಧಿ ಹೊಂದುವವನನ್ನು ನೋಡಿ ಉರಿಗೊಳ್ಳಬೇಡ.<verse eid="PSA 37:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8"/>ಕೋಪವನ್ನು ಅಡಗಿಸಿಕೋ; ರೋಷವನ್ನು ಬಿಡು.</para>
  <para style="q" vid="PSA 37:8">ತಳಮಳಗೊಳ್ಳಬೇಡ; ಕೆಡುಕಿಗೆ ಕಾರಣವಾದೀತು.<verse eid="PSA 37:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9"/>ಕೆಡುಕರು ತೆಗೆದುಹಾಕಲ್ಪಡುವರು;</para>
  <para style="q" vid="PSA 37:9">ಯೆಹೋವನನ್ನು ನಿರೀಕ್ಷಿಸುವವರೇ ದೇಶವನ್ನು ಅನುಭವಿಸುವರು.<verse eid="PSA 37:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10"/>ಇನ್ನು ಸ್ವಲ್ಪಕಾಲದೊಳಗೆ ದುಷ್ಟನು ಕಾಣಿಸದೆ ನಿರ್ನಾಮವಾಗಿ ಹೋಗುವನು;</para>
  <para style="q" vid="PSA 37:10">ಅವನಿದ್ದ ಸ್ಥಳದಲ್ಲಿ ಎಷ್ಟು ವಿಚಾರಿಸಿದರೂ ಅವನು ಸಿಕ್ಕುವುದೇ ಇಲ್ಲ.<verse eid="PSA 37:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11"/>ಆದರೆ ದೀನರು ದೇಶವನ್ನು ಅನುಭವಿಸುವರು;</para>
  <para style="q" vid="PSA 37:11">ಅವರು ಮಹಾಸೌಖ್ಯದಿಂದ ಆನಂದಿಸುವರು.<verse eid="PSA 37:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12"/>ದುಷ್ಟನು ನೀತಿವಂತನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಆಲೋಚಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 37:12">ಅವನನ್ನು ನೋಡಿ ಹಲ್ಲುಕಡಿಯುತ್ತಾನೆ.<verse eid="PSA 37:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13"/>ಆದರೆ ಕರ್ತನು ಅವನಿಗೆ ಶಿಕ್ಷಾಕಾಲ ಬರುತ್ತದೆಂದು ನಗುತ್ತಾನೆ.<verse eid="PSA 37:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14"/>ದುಷ್ಟರು ದೀನದರಿದ್ರರನ್ನು ಕಡಿದುಬಿಡಬೇಕೆಂದು ಕತ್ತಿಯನ್ನು ಹಿರಿದಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 37:14">ಯಥಾರ್ಥರನ್ನು ಕೊಂದು ಹಾಕಬೇಕೆಂದು ಬಿಲ್ಲನ್ನು ಎತ್ತಿದ್ದಾರೆ.<verse eid="PSA 37:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15"/>ಆದರೆ ಅವರ ಕತ್ತಿ ಅವರ ಎದೆಯನ್ನೇ ಇರಿದುಬಿಡುವುದು;</para>
  <para style="q" vid="PSA 37:15">ಅವರ ಬಿಲ್ಲುಗಳು ಸಿಡಿದು ಮುರಿದುಹೋಗುವವು;<verse eid="PSA 37:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16"/>ದುಷ್ಟರ ಮಹಾಸಮೃದ್ಧಿಗಿಂತಲೂ ನೀತಿವಂತನ ಬಡತನವೇ ಲೇಸು.<verse eid="PSA 37:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17"/>ದುಷ್ಟರ ತೋಳುಗಳು ಮುರಿದುಹೋಗುವವು;</para>
  <para style="q" vid="PSA 37:17">ನೀತಿವಂತರನ್ನು ಯೆಹೋವನೇ ಉದ್ಧರಿಸುವನು.<verse eid="PSA 37:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18"/>ಯೆಹೋವನು ನಿರ್ದೋಷಿಗಳ ಜೀವಮಾನವನ್ನು ಲಕ್ಷಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 37:18">ಅವರ ಸ್ವತ್ತು ಶಾಶ್ವತವಾಗಿ ನಿಲ್ಲುವುದು.<verse eid="PSA 37:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19"/>ಅವರಿಗೆ ವಿಪತ್ಕಾಲದಲ್ಲಿಯೂ ಅಪಮಾನವಾಗುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 37:19">ಬರಗಾಲದಲ್ಲಿಯೂ ಅವರಿಗೆ ಕೊರತೆಯಿರುವುದಿಲ್ಲ.<verse eid="PSA 37:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20"/>ದುಷ್ಟರೋ ನಾಶವಾಗಿ ಹೋಗುವರು;</para>
  <para style="q" vid="PSA 37:20">ಯೆಹೋವನ ವೈರಿಗಳು ಹುಲ್ಲುಗಾವಲುಗಳ ಸೊಗಸಿನಂತಿದ್ದು ಮಾಯವಾಗುವರು.</para>
  <para style="q" vid="PSA 37:20">ಅವರು ಹಬೆಯಂತೆ ತೋರಿ ಅಡಗಿಹೋಗುವರು.<verse eid="PSA 37:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21"/>ದುಷ್ಟನು ಸಾಲಮಾಡಿಕೊಂಡು ತೀರಿಸಲಾರದೆ ಹೋಗುವನು;</para>
  <para style="q" vid="PSA 37:21">ನೀತಿವಂತನು ಪರೋಪಕಾರಿಯಾಗಿ ಧರ್ಮಕೊಡುವನು.<verse eid="PSA 37:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22"/>ಯೆಹೋವನ ಆಶೀರ್ವಾದವು ಯಾರಿಗಿರುವುದೋ ಅವರು ದೇಶವನ್ನು ಅನುಭವಿಸುವರು;</para>
  <para style="q" vid="PSA 37:22">ಆತನ ಶಾಪವು ಯಾರಿಗಿರುವುದೋ ಅವರು ತೆಗೆದುಹಾಕಲ್ಪಡುವರು.<verse eid="PSA 37:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23"/>ಸತ್ಪುರುಷನ ಗತಿಸ್ಥಾಪನೆಯು ಯೆಹೋವನಿಂದಲೇ ಆಗಿದೆ,</para>
  <para style="q" vid="PSA 37:23">ಆತನು ಅವನ ಪ್ರವರ್ತನೆಯನ್ನು ಮೆಚ್ಚುತ್ತಾನೆ.<verse eid="PSA 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24"/>ಅವನು ಕೆಳಗೆ ಬಿದ್ದರೂ ಏಳದೆ ಹೋಗುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 37:24">ಯೆಹೋವನು ಅವನನ್ನು ಕೈಹಿಡಿದು ಉದ್ಧಾರ ಮಾಡುವನು.<verse eid="PSA 37:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25"/>ನಾನು ಬಾಲಕನಾಗಿದ್ದೆನು, ಈಗ ವೃದ್ಧನಾಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 37:25">ಈ ವರೆಗೂ ನೀತಿವಂತನು ದಿಕ್ಕಿಲ್ಲದೆ ಬಿದ್ದಿರುವುದನ್ನಾಗಲಿ,</para>
  <para style="q" vid="PSA 37:25">ಅವನ ಸಂತತಿಯವರು ಭಿಕ್ಷೆಬೇಡಿ ತಿನ್ನುವುದನ್ನಾಗಲಿ ನೋಡಲಿಲ್ಲ.<verse eid="PSA 37:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26"/>ಅವನು ಯಾವಾಗಲೂ ಧರ್ಮಿಷ್ಠನಾಗಿ ಹಣ ಸಹಾಯವನ್ನು ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 37:26">ಅವನ ಸಂತತಿಯವರು ಆಶೀರ್ವಾದ ಹೊಂದುವರು.<verse eid="PSA 37:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27"/>ಕೆಟ್ಟದ್ದಕ್ಕೆ ಹೋಗದೆ ಒಳ್ಳೆಯದನ್ನೇ ಮಾಡು;</para>
  <para style="q" vid="PSA 37:27">ಆಗ ನೀನು ಯಾವಾಗಲೂ ದೇಶದಲ್ಲಿ ವಾಸವಾಗಿರುವಿ.<verse eid="PSA 37:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28"/>ಯೆಹೋವನು ನ್ಯಾಯವನ್ನು ಮೆಚ್ಚುವವನು;</para>
  <para style="q" vid="PSA 37:28">ತನ್ನ ಭಕ್ತರನ್ನು ಎಂದಿಗೂ ಕೈಬಿಡುವವನಲ್ಲ. ಅವರು ಸದಾಕಾಲವೂ ಸುರಕ್ಷಿತರಾಗಿರುವರು.</para>
  <para style="q" vid="PSA 37:28">ದುಷ್ಟರ ಸಂತತಿ ತೆಗೆದುಹಾಕಲ್ಪಡುವುದು.<verse eid="PSA 37:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29"/>ನೀತಿವಂತರೋ ದೇಶವನ್ನು ಅನುಭವಿಸುವವರಾಗಿ,</para>
  <para style="q" vid="PSA 37:29">ಅದರಲ್ಲಿ ಶಾಶ್ವತವಾಗಿ ವಾಸಿಸುವರು.<verse eid="PSA 37:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30"/>ನೀತಿವಂತನ ಬಾಯಿಯು ಸುಜ್ಞಾನವನ್ನು ನುಡಿಯುತ್ತದೆ,</para>
  <para style="q" vid="PSA 37:30">ಅವನ ನಾಲಿಗೆ ನ್ಯಾಯವನ್ನೇ ಹೇಳುತ್ತದೆ.<verse eid="PSA 37:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31"/>ದೇವರ ಧರ್ಮೋಪದೇಶವು ಅವನ ಹೃದಯದಲ್ಲಿರುವುದು;</para>
  <para style="q" vid="PSA 37:31">ಅವನು ಜಾರುವುದೇ ಇಲ್ಲ.<verse eid="PSA 37:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32"/>ದುಷ್ಟನು ಹೊಂಚುಹಾಕಿ ನೀತಿವಂತನನ್ನು ಕೊಲ್ಲಬೇಕೆಂದು ಸಮಯನೋಡುತ್ತಾನೆ.<verse eid="PSA 37:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33"/>ಆದರೆ ಯೆಹೋವನು ಅವನನ್ನು ಅವರ ಕೈಗೆ ಸಿಕ್ಕಗೊಡಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 37:33">ಅವನನ್ನು ನ್ಯಾಯವಿಚಾರಣೆಯಲ್ಲಿ ಅಪರಾಧಿಯೆಂದು ಎಣಿಸುವುದಿಲ್ಲ.<verse eid="PSA 37:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34"/>ಯೆಹೋವನನ್ನು ನಿರೀಕ್ಷಿಸುವವನಾಗಿ ಆತನ ಮಾರ್ಗವನ್ನೇ ಅನುಸರಿಸು;</para>
  <para style="q" vid="PSA 37:34">ಆಗ ಆತನು ನಿನ್ನನ್ನು ಮುಂದಕ್ಕೆ ತಂದು ದೇಶವನ್ನು ಅನುಭವಿಸುವಂತೆ ಮಾಡುವನು;</para>
  <para style="q" vid="PSA 37:34">ದುಷ್ಟರು ತೆಗೆದುಹಾಕಲ್ಪಡುವುದನ್ನು ನೀನು ನೋಡುವಿ.<verse eid="PSA 37:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35"/>ದುಷ್ಟನು ಭೀಕರನಾಗಿ ಸ್ವಸ್ಥಳದಲ್ಲಿ ಹಸಿರಾಗಿ ಬೆಳೆದ ಮರದಂತೆ <note caller="+" style="f"><char style="fr" closed="false">37:35 </char><char style="fq" closed="false">ಹಸಿರಾಗಿ ಬೆಳೆದ ಮರದಂತೆ </char><char style="ft" closed="false">ಅಂದರೆ ಲೆಬನೋನ್ ದೇಶದ ದೇವದಾರಿನಂತೆ.</char></note></para>
  <para style="q" vid="PSA 37:35">ವಿಸ್ತರಿಸಿಕೊಂಡಿರುವುದನ್ನು ನೋಡಿದ್ದೆನು.<verse eid="PSA 37:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36"/>ತರುವಾಯ <note caller="+" style="f"><char style="fr" closed="false">37:36 </char><char style="ft" closed="false">ಅಥವಾ ಅವನು.</char></note>ನಾನು ಆ ದಾರಿಯಲ್ಲಿ ಹೋಗಿ ನೋಡಲಾಗಿ,</para>
  <para style="q" vid="PSA 37:36">ಅವನು ಇಲ್ಲದೆ ಹೋಗಿದ್ದನು,</para>
  <para style="q" vid="PSA 37:36">ಅವನನ್ನು ಹುಡುಕಿದರೂ ಸಿಕ್ಕಲಿಲ್ಲ.<verse eid="PSA 37:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37"/>ಒಳ್ಳೇ ನಡತೆಯುಳ್ಳವನನ್ನು ನೋಡು,</para>
  <para style="q" vid="PSA 37:37">ಯಥಾರ್ಥನನ್ನು ಲಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 37:37">ಶಾಂತನಿಗೆ ಸಂತಾನವೃದ್ಧಿ ಆಗುವುದು.<verse eid="PSA 37:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38"/>ದ್ರೋಹಿಗಳೆಲ್ಲರೂ ನಾಶವಾಗುವರು;</para>
  <para style="q" vid="PSA 37:38">ದುಷ್ಟರ ಸಂತಾನವು ತೆಗೆದುಹಾಕಲ್ಪಡುವುದು.<verse eid="PSA 37:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39"/>ನೀತಿವಂತರ ರಕ್ಷಣೆ ಯೆಹೋವನಿಂದಲೇ;</para>
  <para style="q" vid="PSA 37:39">ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಆತನೇ ಅವರಿಗೆ ದುರ್ಗಸ್ಥಾನ.<verse eid="PSA 37:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40"/>ಯೆಹೋವನು ಸಹಾಯಕನಾಗಿ ಅವರನ್ನು ತಪ್ಪಿಸಿ ಬಿಡುವನು;</para>
  <para style="q" vid="PSA 37:40">ಅವರು ಆತನ ಆಶ್ರಿತರಾದುದರಿಂದ,</para>
  <para style="q" vid="PSA 37:40">ಆತನು ಅವರನ್ನು ದುಷ್ಟರ ಕೈಯಿಂದ ತಪ್ಪಿಸಿ ರಕ್ಷಿಸುವನು.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s">ದುರವಸ್ಥೆಯಲ್ಲಿರುವ ಭಕ್ತನು ದೇವರ ಸಹಾಯವನ್ನು ಬೇಡಿಕೊಳ್ಳುವುದು</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ; ಜ್ಞಾಪಕಾರ್ಥ ನೈವೇದ್ಯಸಮರ್ಪಣೆಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು.</para>
  <para style="r">
    <ref loc="PSA 6">ಕೀರ್ತ 6</ref>; <ref loc="LAM 3">ಪ್ರಲಾ 3</ref>; <ref loc="LEV 2:2">ಯಾಜ 2:2</ref>; <ref loc="LEV 6:15">6:15</ref>; <ref loc="LEV 24:7">24:7</ref>,<ref loc="LEV 24:8">8</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1"/>ಯೆಹೋವನೇ, ಕೋಪದಿಂದ ನನ್ನನ್ನು ಶಿಕ್ಷಿಸಬೇಡ;</para>
  <para style="q" vid="PSA 38:1">ರೋಷದಿಂದ ನನ್ನನ್ನು ದಂಡಿಸಬೇಡ.<verse eid="PSA 38:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2"/>ನಿನ್ನ ಬಾಣಗಳು ನನ್ನೊಳಗೆ ಹೊಕ್ಕಿವೆ;</para>
  <para style="q" vid="PSA 38:2">ನಿನ್ನ ಶಿಕ್ಷಾಹಸ್ತವು ನನ್ನ ಮೇಲೆ ಭಾರವಾಗಿದೆ.<verse eid="PSA 38:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3"/>ನಿನ್ನ ಸಿಟ್ಟಿನಿಂದ ನನ್ನ ಶರೀರದಲ್ಲಿ ಸ್ವಸ್ಥತೆ ತಪ್ಪಿ ಹೋಗಿದೆ;</para>
  <para style="q" vid="PSA 38:3">ನನ್ನ ಪಾಪದಿಂದ ನನ್ನ ಎಲುಬುಗಳಲ್ಲಿ ಸ್ವಲ್ಪವೂ ಕ್ಷೇಮವಿಲ್ಲ.<verse eid="PSA 38:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4"/>ನನ್ನ ಅಪರಾಧಗಳು ನನ್ನನ್ನು ಮುಳುಗಿಸಿಬಿಟ್ಟಿವೆ;</para>
  <para style="q" vid="PSA 38:4">ಅವು ಹೊರಲಾರದಷ್ಟು ಭಾರವಾದ ಹೊರೆಯಂತಿವೆ.<verse eid="PSA 38:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5"/>ನನ್ನ ಮೂರ್ಖತನದ ಫಲವಾದ ಬಾಸುಂಡೆಗಳು,</para>
  <para style="q" vid="PSA 38:5">ಕೀವು ಸೋರಿ ದುರ್ವಾಸನೆಯಿಂದ ನಾರುತ್ತಿದೆ.<verse eid="PSA 38:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6"/>ನಾನು ಬಹಳವಾಗಿ ಬಾಗಿ ಕುಗ್ಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 38:6">ಯಾವಾಗಲೂ ದುಃಖದಿಂದ ವಿಕಾರಿಯಾಗಿ ಅಲೆಯುತ್ತೇನೆ.<verse eid="PSA 38:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7"/>ನನ್ನ ಸೊಂಟಕ್ಕೆ ಉರಿಬಡಿದಂತಿದೆ;</para>
  <para style="q" vid="PSA 38:7">ನನ್ನ ದೇಹದಲ್ಲಿ ಸ್ವಲ್ಪವಾದರೂ ಕ್ಷೇಮವಿಲ್ಲ.<verse eid="PSA 38:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8"/>ನನಗೆ ಜೋಮುಹಿಡಿದಂತಿದೆ;</para>
  <para style="q" vid="PSA 38:8">ಬಹಳ ಮನಗುಂದಿದವನಾದೆನು.</para>
  <para style="q" vid="PSA 38:8">ಹೃದಯದ ಸಂಕಟದ ದೆಸೆಯಿಂದ ಅರಚಿಕೊಳ್ಳುತ್ತಾ ಇದ್ದೇನೆ.<verse eid="PSA 38:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9"/>ಕರ್ತನೇ, ನನ್ನ ಅಪೇಕ್ಷೆ ನಿನಗೆ ಗೊತ್ತುಂಟು;</para>
  <para style="q" vid="PSA 38:9">ನನ್ನ ನಿಟ್ಟುಸಿರು ನಿನಗೆ ಮರೆಯಾಗಿಲ್ಲ.<verse eid="PSA 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10"/>ನನ್ನ ಹೃದಯವು ಬಡಿದುಕೊಳ್ಳುತ್ತಿದೆ;</para>
  <para style="q" vid="PSA 38:10">ನನ್ನ ಚೈತನ್ಯವು ಕುಗ್ಗಿಹೋಯಿತು;</para>
  <para style="q" vid="PSA 38:10">ನನ್ನ ಕಣ್ಣುಗಳೂ ಮೊಬ್ಬಾಗಿ ಹೋದವು.<verse eid="PSA 38:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11"/>ನನ್ನ ಆಪ್ತಸ್ನೇಹಿತರು ಮತ್ತು ಜೊತೆಗಾರರು,</para>
  <para style="q" vid="PSA 38:11">ನನ್ನ ರೋಗವನ್ನು ನೋಡಿ ಓರೆಯಾಗಿ ಹೋಗುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 38:11">ನನ್ನ ಬಂಧುಗಳು ದೂರ ನಿಲ್ಲುತ್ತಾರೆ.<verse eid="PSA 38:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ತೆಗೆಯಬೇಕೆನ್ನುವವರು ನನಗೆ ಉರುಲುಗಳನ್ನು ಒಡ್ಡಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 38:12">ನನ್ನ ವಿಪತ್ತನ್ನು ಕೋರುವವರು ನನಗೆ ನಾಶನವನ್ನೇ ನಿಶ್ಚಯಿಸಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 38:12">ಯಾವಾಗಲೂ ಮೋಸವನ್ನು ಕಲ್ಪಿಸುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 38:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13"/>ನಾನಂತೂ ಕಿವುಡನಂತೆ ಕೇಳದವನಾಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 38:13">ಮೂಕನಂತೆ ಬಾಯಿ ತೆರೆಯುವುದೇ ಇಲ್ಲ.<verse eid="PSA 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14"/>ನಾನು ಕಿವಿ ಕೇಳಿಸದವನಂತೆಯೂ,</para>
  <para style="q" vid="PSA 38:14">ಪ್ರತ್ಯುತ್ತರ ಕೊಡಲಾರದವನಂತೆಯೂ ಆದೆನು.<verse eid="PSA 38:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15"/>ಯೆಹೋವನೇ, ನಿನ್ನನ್ನೇ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 38:15">ನನ್ನ ಕರ್ತನೇ, ನನ್ನ ದೇವರೇ, ನೀನೇ ಸದುತ್ತರವನ್ನು ಕೊಡುವವನು.<verse eid="PSA 38:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16"/>“ನನ್ನ ವಿಷಯದಲ್ಲಿ ಶತ್ರುಗಳಿಗೆ ಸಂತೋಷವಾಗಬಾರದು;</para>
  <para style="q" vid="PSA 38:16">ನಾನು ಜಾರಿಬಿದ್ದರೆ ಹಿಗ್ಗಬಾರದು” ಅಂದುಕೊಂಡೆನು.<verse eid="PSA 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17"/>ನನಗೆ ಆಪತ್ತೇ ಸಿದ್ಧವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 38:17">ಯಾವಾಗಲೂ ನನಗೆ ಸಂಕಟವಿದೆ.<verse eid="PSA 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18"/>ನಾನು ಅಪರಾಧಿಯೇ ಎಂದು ಒಪ್ಪಿಕೊಳ್ಳುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 38:18">ನನ್ನ ಪಾಪದ ದೆಸೆಯಿಂದಲೇ ನನಗೆ ವ್ಯಸನವುಂಟಾಯಿತು.<verse eid="PSA 38:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19"/>ನನ್ನ ಶತ್ರುಗಳು ಚುರುಕಾದವರೂ, ಬಲಿಷ್ಠರೂ ಆಗಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 38:19">ನನ್ನನ್ನು ಅನ್ಯಾಯವಾಗಿ ದ್ವೇಷಿಸುವವರು ಬಹು ಜನ.<verse eid="PSA 38:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20"/>ನಾನು ಒಳ್ಳೆಯದನ್ನು ಅನುಸರಿಸುವುದರಿಂದ,</para>
  <para style="q" vid="PSA 38:20">ನನ್ನ ಎದುರಾಳಿಗಳು ಉಪಕಾರಕ್ಕೆ ಪ್ರತಿಯಾಗಿ ಅಪಕಾರವನ್ನೇ ಸಲ್ಲಿಸುವರು.<verse eid="PSA 38:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21"/>ಯೆಹೋವನೇ, ಕೈ ಬಿಡಬೇಡ;</para>
  <para style="q" vid="PSA 38:21">ನನ್ನ ದೇವರೇ, ದೂರವಾಗಿರಬೇಡ.<verse eid="PSA 38:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22"/>ನನ್ನ ಕರ್ತನೇ, ನನ್ನ ರಕ್ಷಕನೇ,</para>
  <para style="q" vid="PSA 38:22">ಬೇಗ ಬಂದು ಸಹಾಯಮಾಡು.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s">ಮನುಷ್ಯನ ಅಸ್ಥಿರತೆಯನ್ನು ದೇವರ ಮುಂದೆ ಅರಿಕೆಮಾಡುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಯೆದೂತೂನನ ರಾಗದ ಪ್ರಕಾರ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1"/>“ನನ್ನ ನಾಲಿಗೆ ಪಾಪಕ್ಕೆ ಹೋಗದಂತೆ ಜಾಗರೂಕನಾಗಿರುವೆನು,</para>
  <para style="q" vid="PSA 39:1">ದುಷ್ಟರು ನನ್ನ ಮುಂದೆ ಇರುವಾಗ ಬಾಯಿಗೆ ಕಡಿವಾಣ ಹಾಕಿಕೊಂಡಿರುವೆನು” ಅಂದುಕೊಂಡೆನು.<verse eid="PSA 39:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2"/>ನಾನು ಮೌನವಾಗಿದ್ದೆನು;</para>
  <para style="q" vid="PSA 39:2">ಒಳ್ಳೆಯದನ್ನಾದರೂ ಆಡದೆ ಸುಮ್ಮನಿದ್ದೆನು;</para>
  <para style="q" vid="PSA 39:2">ಆದರೆ ನನ್ನ ಸಂಕಟವು ಹೆಚ್ಚಿತು.<verse eid="PSA 39:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3"/>ನನ್ನ ಹೃದಯವು ಆತಂಕದಿಂದ ಕೂಡಿತ್ತು;</para>
  <para style="q" vid="PSA 39:3">ನಾನು ಹೆಚ್ಚಾಗಿ ಯೋಚಿಸುತ್ತಿರುವಲ್ಲಿ ತಾಪ ಹೆಚ್ಚಿತು.</para>
  <para style="q" vid="PSA 39:3">ಆಗ ನಾನು ಬಾಯಿ ಬಿಟ್ಟು,<verse eid="PSA 39:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4"/>“ಯೆಹೋವನೇ, ನನಗೆ ಅವಸಾನವುಂಟೆಂದೂ,</para>
  <para style="q" vid="PSA 39:4">ನನ್ನ ಜೀವಮಾನವು ಅತ್ಯಲ್ಪವೆಂದೂ,</para>
  <para style="q" vid="PSA 39:4">ನಾನು ಎಷ್ಟೋ ಅಸ್ಥಿರನೆಂದೂ ನನಗೆ ತಿಳಿಯಪಡಿಸು.<verse eid="PSA 39:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5"/>ನನ್ನ ಆಯುಷನ್ನು ಗೇಣುದ್ದವಾಗಿ ಮಾಡಿದ್ದೀಯಲ್ಲಾ;</para>
  <para style="q" vid="PSA 39:5">ನನ್ನ ಜೀವಿತಕಾಲ ನಿನ್ನ ಎಣಿಕೆಯಲ್ಲಿ ಏನೂ ಅಲ್ಲ” ಅಂದೆನು.</para>
  <para style="q" vid="PSA 39:5">ಮನುಷ್ಯನೆಂಬವನು ಎಷ್ಟು ಸ್ಥಿರನೆಂದು ಕಂಡರೂ ಬರಿ ಉಸಿರೇ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 39:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6"/>ನರರು ಮಾಯಾರೂಪವಾದ ನೆರಳಿನಂತೆ ಸಂಚರಿಸುವವರು;</para>
  <para style="q" vid="PSA 39:6">ಅವರು ಸುಮ್ಮಸುಮ್ಮನೆ ಗಡಿಬಿಡಿಮಾಡುವವರು;</para>
  <para style="q" vid="PSA 39:6">ಆಸ್ತಿಯನ್ನು ಕೂಡಿಸಿಟ್ಟುಕೊಳ್ಳುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 39:6">ಆದರೆ ಅದು ಯಾರ ಪಾಲಾಗುವುದೋ ತಾವೇ ತಿಳಿಯರು.<verse eid="PSA 39:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7"/>“ಹೀಗಿರಲಾಗಿ ಕರ್ತನೇ, ನಾನು ಇನ್ನು ಯಾವುದಕ್ಕೆ ಕಾದುಕೊಳ್ಳಲಿ?</para>
  <para style="q" vid="PSA 39:7">ನೀನೇ ನನ್ನ ನಿರೀಕ್ಷೆ.<verse eid="PSA 39:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8"/>ಎಲ್ಲಾ ದ್ರೋಹಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡುಗಡೆಮಾಡು;</para>
  <para style="q" vid="PSA 39:8">ಮೂರ್ಖರ ನಿಂದೆಗೆ ಗುರಿಮಾಡಬೇಡ.<verse eid="PSA 39:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9"/>ನೀನೇ ಇದನ್ನು ಬರಮಾಡಿದ್ದರಿಂದ</para>
  <para style="q" vid="PSA 39:9">ನಾನು ಏನೂ ಹೇಳದೆ ಮೌನವಾಗಿರುವೆನು.<verse eid="PSA 39:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10"/>ನಿನ್ನ ದಂಡನೆಯನ್ನು ತೊಲಗಿಸು;</para>
  <para style="q" vid="PSA 39:10">ನಿನ್ನ ಕೈಹೊಡೆತದಿಂದ ಸಾಯುವ ಹಾಗಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 39:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11"/>ನೀನು ನರನನ್ನು ಪಾಪದ ನಿಮಿತ್ತ ಗದರಿಸಿ ಶಿಕ್ಷಿಸುವಾಗ,</para>
  <para style="q" vid="PSA 39:11">ಅವನ ಚೆಲುವಿಕೆಯು ನುಸಿ ಹತ್ತಿತೋ ಎಂಬಂತೆ ಹಾಳಾಗಿ ಹೋಗುತ್ತದೆ.</para>
  <para style="q" vid="PSA 39:11">ಮನುಷ್ಯನೆಂಬವನು ಬರಿ ಉಸಿರೇ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 39:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12"/>ಯೆಹೋವನೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಲಾಲಿಸು;</para>
  <para style="q" vid="PSA 39:12">ನನ್ನ ಮೊರೆಗೆ ಕಿವಿಗೊಡು. ನನ್ನ ಕಣ್ಣೀರನ್ನು ನೋಡು, ಸುಮ್ಮನಿರಬೇಡ.</para>
  <para style="q" vid="PSA 39:12">ನನ್ನ ಪೂರ್ವಿಕರಂತೆಯೇ ನಾನು ನಿನ್ನ ಮರೆಹೊಕ್ಕಿರುವ ಪ್ರವಾಸಿಯೂ,</para>
  <para style="q" vid="PSA 39:12">ಪರದೇಶದವನೂ ಆಗಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 39:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13"/>ನಾನು ಅಗಲಿ ಹೋಗಿ ಇಲ್ಲವಾಗುವುದಕ್ಕೆ ಮೊದಲು,</para>
  <para style="q" vid="PSA 39:13">ಸ್ವಲ್ಪ ಸಂತೋಷಪಡುವಂತೆ ನಿನ್ನ ಕೋಪದೃಷ್ಟಿಯನ್ನು</para>
  <para style="q" vid="PSA 39:13">ನನ್ನ ಕಡೆಯಿಂದ ತಿರುಗಿಸಿಕೊಳ್ಳಬೇಕು, ದೇವಾ.”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s">ರಕ್ಷಣೆಗಾಗಿ ಪ್ರಾರ್ಥಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1"/>ನಾನು ಯೆಹೋವನಿಗಾಗಿ ನಿರೀಕ್ಷಿಸಿಯೇ ನಿರೀಕ್ಷಿಸಿದೆನು;</para>
  <para style="q" vid="PSA 40:1">ಆತನು ನನ್ನ ಮೊರೆಗೆ ಕಿವಿಗೊಟ್ಟು ಲಕ್ಷಿಸಿದನು.<verse eid="PSA 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2"/>ನನ್ನನ್ನು ನಾಶನದ ಗುಂಡಿಯೊಳಗಿಂದ ಎತ್ತಿದನು;</para>
  <para style="q" vid="PSA 40:2">ಕೆಸರಿನೊಳಗಿಂದ ನನ್ನನ್ನು ತೆಗೆದು ಬಂಡೆಯ ಮೇಲೆ ನಿಲ್ಲಿಸಿ,</para>
  <para style="q" vid="PSA 40:2">ನಾನು ದೃಢವಾಗಿ ಹೆಜ್ಜೆಯಿಡುವಂತೆ ಮಾಡಿದನು.<verse eid="PSA 40:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3"/>ಆತನು ನನ್ನ ಬಾಯಲ್ಲಿ ನೂತನ ಕೀರ್ತನೆಯನ್ನು ಹುಟ್ಟಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 40:3">ಅದು ನಮ್ಮ ದೇವರ ಸ್ತೋತ್ರವೇ.</para>
  <para style="q" vid="PSA 40:3">ಆತನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನೋಡಿದ ಅನೇಕರು</para>
  <para style="q" vid="PSA 40:3">ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿ ಯೆಹೋವನಲ್ಲಿ ನಂಬಿಕೆಯಿಡುವರು.<verse eid="PSA 40:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4"/>ಯಾರು <note caller="+" style="f"><char style="fr" closed="false">40:4 </char><char style="ft" closed="false">ಅಥವಾ ವಿಗ್ರಹಗಳ.</char></note>ಅಹಂಕಾರಿಗಳ ಜೊತೆಯಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 40:4">ಸುಳ್ಳುದೇವರನ್ನು ಹಿಂಬಾಲಿಸುವವರಲ್ಲಿಯೂ ಸೇರದೆ,</para>
  <para style="q" vid="PSA 40:4">ಯೆಹೋವನನ್ನೇ ನಂಬುತ್ತಾನೋ, ಅವನೇ ಧನ್ಯನು.<verse eid="PSA 40:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ, ನಿನಗೆ ಸಮಾನನಾದ ದೇವರು ಯಾರು?</para>
  <para style="q" vid="PSA 40:5">ನಮ್ಮ ಹಿತಕ್ಕಾಗಿ ನೀನು ಮಾಡಿದ ಆಲೋಚನೆಗಳೂ,</para>
  <para style="q" vid="PSA 40:5">ಅದ್ಭುತಕಾರ್ಯಗಳೂ ಎಷ್ಟೋ ವಿಶೇಷವಾಗಿವೆ;</para>
  <para style="q" vid="PSA 40:5">ಅವುಗಳನ್ನು ವಿವರಿಸಿ ಹೇಳೋಣವೆಂದರೆ ಅಸಾಧ್ಯ;</para>
  <para style="q" vid="PSA 40:5">ಅವು ಅಸಂಖ್ಯಾತವಾಗಿವೆ.<verse eid="PSA 40:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6"/>ಯಜ್ಞನೈವೇದ್ಯಗಳು ನಿನಗೆ ಇಷ್ಟವಿಲ್ಲ;</para>
  <para style="q" vid="PSA 40:6">ಸರ್ವಾಂಗಹೋಮಗಳನ್ನಾಗಲಿ, ದೋಷಪರಿಹಾರಕ ಯಜ್ಞಗಳನ್ನಾಗಲಿ ನೀನು ಅಪೇಕ್ಷಿಸಲಿಲ್ಲ.</para>
  <para style="q" vid="PSA 40:6">ಆದರೆ ಶ್ರವಣಶಕ್ತಿಯನ್ನು ನನಗೆ ಅನುಗ್ರಹಿಸಿದಿ.<verse eid="PSA 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7"/>ಆಗ ನಾನು, “ಇಗೋ ಇದ್ದೇನೆ; ನನ್ನ ಕರ್ತವ್ಯವು ಗ್ರಂಥದ ಸುರುಳಿಯಲ್ಲಿ ಬರೆದದೆ.<verse eid="PSA 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8"/>ನನ್ನ ದೇವರೇ, ನಿನ್ನ ಚಿತ್ತವನ್ನು ಅನುಸರಿಸುವುದೇ ನನ್ನ ಸಂತೋಷವು;</para>
  <para style="q" vid="PSA 40:8">ನಿನ್ನ ಧರ್ಮೋಪದೇಶವು ನನ್ನ ಅಂತರಂಗದಲ್ಲಿದೆ” ಅಂದೆನು.<verse eid="PSA 40:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9"/>ನೀನು ನೀತಿಯನ್ನು ಸಾಧಿಸಿದ ಶುಭಸಮಾಚಾರವನ್ನು,</para>
  <para style="q" vid="PSA 40:9">ಧಾರಳವಾಗಿ ಮಹಾಸಭೆಯಲ್ಲಿ ಪ್ರಕಟಿಸಿದೆನು;</para>
  <para style="q" vid="PSA 40:9">ಯೆಹೋವನೇ, ನೀನೇ ಬಲ್ಲೆ.<verse eid="PSA 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10"/>ನಿನ್ನ ನೀತಿಸಾಧನೆಯನ್ನು ಮರೆಮಾಡಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 40:10">ನಿನ್ನ ನಂಬಿಕೆಯನ್ನೂ, ರಕ್ಷಣೆಯನ್ನೂ ಪ್ರಸಿದ್ಧಪಡಿಸಿದೆನು;</para>
  <para style="q" vid="PSA 40:10">ನಿನ್ನ ಕೃಪಾಸತ್ಯತೆಗಳನ್ನು ಮಹಾಸಮುದಾಯದಲ್ಲಿ ತಿಳಿಸದೆ ಇರಲಿಲ್ಲ.<verse eid="PSA 40:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11"/>ಯೆಹೋವನೇ, ನೀನಂತೂ ನಿನ್ನ ಕರುಣೆಯನ್ನು ನನ್ನಿಂದ ಅಗಲಿಸಬೇಡ;</para>
  <para style="q" vid="PSA 40:11">ನಿನ್ನ ಕೃಪಾಸತ್ಯತೆಗಳು ನನ್ನನ್ನು ಯಾವಾಗಲೂ ಕಾಪಾಡಲಿ.<verse eid="PSA 40:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12"/>ಏಕೆಂದರೆ ಲೆಕ್ಕವಿಲ್ಲದ ಆಪತ್ತುಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿವೆ;</para>
  <para style="q" vid="PSA 40:12">ನನ್ನ ಪಾಪಗಳು ನನ್ನನ್ನು ಹಿಂದಟ್ಟಿ ಹಿಡಿದಿರುತ್ತವೆ,</para>
  <para style="q" vid="PSA 40:12">ನನಗೆ ದಿಕ್ಕೇ ತೋರುವುದಿಲ್ಲ. ಅವು ನನ್ನ ತಲೆಯ ಕೂದಲುಗಳಿಗಿಂತಲೂ ಹೆಚ್ಚಾಗಿವೆ,</para>
  <para style="q" vid="PSA 40:12">ನಾನು ಎದೆಗುಂದಿ ಹೋದೆನು.<verse eid="PSA 40:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13"/>ಯೆಹೋವನೇ, ದಯವಿಟ್ಟು ನನ್ನನ್ನು ರಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 40:13">ಯೆಹೋವನೇ, ಬೇಗನೆ ಬಂದು ಸಹಾಯಮಾಡು.<verse eid="PSA 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ತೆಗೆಯುವುದಕ್ಕೆ ಸಮಯನೋಡುವವರು,</para>
  <para style="q" vid="PSA 40:14">ಆಶಾಭಂಗಪಟ್ಟು ಅವಮಾನಹೊಂದಲಿ;</para>
  <para style="q" vid="PSA 40:14">ನನ್ನ ಆಪತ್ತಿನಲ್ಲಿ ಸಂತೋಷಿಸುವವರು ಅಪಮಾನದಿಂದ ಹಿಂದಿರುಗಿ ಓಡಲಿ.<verse eid="PSA 40:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15"/>ಆಹಾ, ಆಹಾ ಎಂದು ನನ್ನನ್ನು ಪರಿಹಾಸ್ಯಮಾಡುವವರು,</para>
  <para style="q" vid="PSA 40:15">ತಮಗೆ ಆಗುವ ಅವಮಾನದಿಂದ ವಿಸ್ಮಯಗೊಳ್ಳಲಿ.<verse eid="PSA 40:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16"/>ನಿನ್ನ ದರ್ಶನವನ್ನು ಕೋರುವವರೆಲ್ಲರು ನಿನ್ನಲ್ಲಿ ಉಲ್ಲಾಸದಿಂದ ಸಂತೋಷಿಸಲಿ;</para>
  <para style="q" vid="PSA 40:16">ನಿನ್ನ ಜಯದಲ್ಲಿ ಆನಂದಿಸುವವರು, “ಯೆಹೋವನು ಮಹೋನ್ನತನು” ಎಂದು ಯಾವಾಗಲೂ ಹೇಳುವವರಾಗಲಿ.<verse eid="PSA 40:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17"/>ನಾನಾದರೋ ಕುಗ್ಗಿದವನೂ, ದಿಕ್ಕಿಲ್ಲದವನೂ ಆಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 40:17">ಕರ್ತನೇ ನನ್ನ ಹಿತಚಿಂತಕನು.</para>
  <para style="q" vid="PSA 40:17">ನನ್ನ ದೇವರೇ, ನೀನೇ ನನಗೆ ಸಹಾಯಕನೂ, ರಕ್ಷಕನೂ ಆಗಿದ್ದೀ;</para>
  <para style="q" vid="PSA 40:17">ತಡಮಾಡಬೇಡ.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s">ರೋಗ ಮತ್ತು ಶತ್ರುಬಾಧಿತನ ಮೊರೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1"/>ದಿಕ್ಕಿಲ್ಲದವನನ್ನು ಪರಾಂಬರಿಸುವವನು ಧನ್ಯನು;</para>
  <para style="q" vid="PSA 41:1">ಯೆಹೋವನು ಅವನನ್ನು ಆಪತ್ಕಾಲದಲ್ಲಿ ರಕ್ಷಿಸುವನು.<verse eid="PSA 41:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2"/>ಯೆಹೋವನು ಅವನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿ ಉಳಿಸುವನು;</para>
  <para style="q" vid="PSA 41:2">ಅವನು ದೇಶದಲ್ಲಿ ಧನ್ಯನೆನಿಸಿಕೊಳ್ಳುವನು;</para>
  <para style="q" vid="PSA 41:2">ಯೆಹೋವನು ಅವನನ್ನು ಶತ್ರುಗಳ ಅಧೀನಕ್ಕೆ ಕೊಡುವುದಿಲ್ಲ!<verse eid="PSA 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3"/>ಅವನು ಅಸ್ವಸ್ಥನಾಗಿ ಬಿದ್ದುಕೊಂಡಿರುವಾಗ,</para>
  <para style="q" vid="PSA 41:3">ಯೆಹೋವನು ಅವನನ್ನು ಉದ್ಧರಿಸುವನು;</para>
  <para style="q" vid="PSA 41:3">ಅವನ ರೋಗವನ್ನೆಲ್ಲಾ ಪರಿಹರಿಸಿ, ಆರೋಗ್ಯವನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದಿಯಲ್ಲಾ ಸ್ವಾಮೀ.<verse eid="PSA 41:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4"/>ನಾನಂತೂ, “ಯೆಹೋವನೇ, ನಿನ್ನ ಆಜ್ಞೆಯನ್ನು ಮೀರಿ ಪಾಪಮಾಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 41:4">ನನ್ನನ್ನು ಕರುಣಿಸಿ ಸ್ವಸ್ಥಮಾಡು” ಅಂದೆನು.<verse eid="PSA 41:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5"/>ನನ್ನ ಹಾನಿಯನ್ನು ಅಪೇಕ್ಷಿಸುವ ಶತ್ರುಗಳು, “ಅವನು ಯಾವಾಗ ಸತ್ತಾನು?</para>
  <para style="q" vid="PSA 41:5">ಅವನ ಹೆಸರು ಯಾವಾಗ ಇಲ್ಲದೆ ಹೋದೀತು?” ಎಂದು ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6"/>ಅವರಲ್ಲೊಬ್ಬನು ನನ್ನನ್ನು ನೋಡುವುದಕ್ಕೆ ಬಂದರೆ ಕಪಟದ ಮಾತನಾಡುವನು;</para>
  <para style="q" vid="PSA 41:6">ಮನಸ್ಸಿನಲ್ಲಿ ಕುಯುಕ್ತಿಗಳನ್ನು ಕಲ್ಪಿಸಿಕೊಂಡು ಹೋಗಿ ಹೊರಗೆ ಪ್ರಕಟಿಸುತ್ತಾನೆ.<verse eid="PSA 41:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7"/>ನನ್ನ ಹಗೆಯವರೆಲ್ಲರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಕಿವಿಗಳಲ್ಲಿ ಗುಜುಗುಜು ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 41:7">
    <note caller="+" style="f">
      <char style="fr" closed="false">41:7 </char>
      <char style="ft" closed="false">ಅಥವಾ ನನಗೆ ಕೇಡನ್ನು ಕಲ್ಪಿಸುತ್ತಾರೆ. </char>
    </note>ನನಗೆ ಕೇಡುಮಾಡಲು ಪರಸ್ಪರ ಆಲೋಚಿಸುತ್ತಾರೆ.<verse eid="PSA 41:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8"/>“ಅವನನ್ನು ಅಸಾಧ್ಯರೋಗ ಹಿಡಿದಿದೆ;</para>
  <para style="q" vid="PSA 41:8">ಅವನು ಹಾಸಿಗೆಯನ್ನು ಬಿಟ್ಟು ತಿರುಗಿ ಏಳುವುದೇ ಇಲ್ಲ” ಎಂದು ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9"/>ನಾನು ಯಾರನ್ನು ನಂಬಿದ್ದೆನೋ,</para>
  <para style="q" vid="PSA 41:9">ಯಾರು ನನ್ನ ಮನೆಯಲ್ಲಿ ಅನ್ನಪಾನಗಳನ್ನು ತೆಗೆದುಕೊಂಡನೋ,</para>
  <para style="q" vid="PSA 41:9">ಅಂತಹ ಆಪ್ತಸ್ನೇಹಿತನು ನನಗೆ ಕಾಲನ್ನು ಅಡ್ಡಗೊಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 41:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10"/>ಯೆಹೋವನೇ, ನೀನಾದರೋ ಕರುಣಿಸಿ ನನ್ನನ್ನು ಏಳುವಂತೆ ಮಾಡು;</para>
  <para style="q" vid="PSA 41:10">ಆಗ ನಾನು ಅವರಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು.<verse eid="PSA 41:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11"/>ಶತ್ರುಗಳ ಜಯಧ್ವನಿ ಇಲ್ಲದ್ದರಿಂದಲೇ</para>
  <para style="q" vid="PSA 41:11">ನಿನ್ನ ಒಲುಮೆ ನನಗುಂಟೆಂದು ತಿಳಿದುಕೊಳ್ಳುವೆನು.<verse eid="PSA 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12"/>ನಿರ್ದೋಷಿಯಾದ ನನ್ನನ್ನಾದರೋ ನೀನು ಉದ್ಧಾರಮಾಡಿ,</para>
  <para style="q" vid="PSA 41:12">ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಶಾಶ್ವತವಾಗಿ ನಿಲ್ಲಿಸುವಿ.<verse eid="PSA 41:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13"/>ಇಸ್ರಾಯೇಲರ ದೇವರಾದ ಯೆಹೋವನಿಗೆ ಯುಗಯುಗಾಂತರಗಳವರೆಗೂ ಕೊಂಡಾಟವಾಗಲಿ. ಆಮೆನ್. ಆಮೆನ್.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">ದ್ವಿತೀಯ ಭಾಗವು 42 - 72</para>
  <para style="d">ದೇಶಾಂತರದಲ್ಲಿರುವ ಭಕ್ತನು ದೇವದರ್ಶನಕ್ಕಾಗಿ ಹಂಬಲಿಸುವುದು. ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಕೋರಹೀಯರ ಪದ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1"/>ದೇವರೇ, ಬಾಯಾರಿದ ಜಿಂಕೆಯು ನೀರಿನ ತೊರೆಗಳನ್ನು ಹೇಗೋ,</para>
  <para style="q" vid="PSA 42:1">ಹಾಗೆಯೇ ನನ್ನ ಮನಸ್ಸು ನಿನ್ನನ್ನು ಬಯಸುತ್ತದೆ.<verse eid="PSA 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2"/>ನನ್ನ ಮನಸ್ಸು ದೇವರಿಗಾಗಿ, ಚೈತನ್ಯಸ್ವರೂಪನಾದ ದೇವರಿಗಾಗಿ ಹಾರೈಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 42:2">ನಾನು ಯಾವಾಗ ಹೋಗಿ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಸೇರುವೆನೋ?<verse eid="PSA 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3"/>“ನಿನ್ನ ದೇವರು ಎಲ್ಲಿ?” ಎಂದು ಜನರು</para>
  <para style="q" vid="PSA 42:3">ಯಾವಾಗಲೂ ನನ್ನನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡುವುದರಿಂದ,</para>
  <para style="q" vid="PSA 42:3">ಹಗಲಿರುಳು ನನಗೆ ಕಣ್ಣೀರೇ ಆಹಾರವಾಯಿತು.<verse eid="PSA 42:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4"/>ನಾನು ಭಜನೋತ್ಸವದಲ್ಲಿ ಸೇರಿ,</para>
  <para style="q" vid="PSA 42:4">ಜನಸಮೂಹದೊಡನೆ ಹರ್ಷಧ್ವನಿಮಾಡುತ್ತಾ, ಸ್ತೋತ್ರಪದಗಳನ್ನು ಹಾಡುತ್ತಾ,</para>
  <para style="q" vid="PSA 42:4">ದೇವಾಲಯಕ್ಕೆ ಹೋಗುತ್ತಿದ್ದದ್ದನ್ನೇ ನೆನಪಿಗೆ ತಂದುಕೊಂಡು,</para>
  <para style="q" vid="PSA 42:4">ನನ್ನೊಳಗೆ ನಾನೇ ಹಂಬಲಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 42:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5"/>ನನ್ನ ಮನವೇ, ನೀನು ಕುಗ್ಗಿ ಹೋಗಿರುವುದೇನು?</para>
  <para style="q" vid="PSA 42:5">ಹೀಗೆ ವ್ಯಥೆಪಡುವುದೇಕೆ?</para>
  <para style="q" vid="PSA 42:5">ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು; ಆತನೇ ನನಗೆ ರಕ್ಷಕನೂ ದೇವರೂ ಆಗಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 42:5">ನಾನು ಇನ್ನೂ ಆತನನ್ನು ಸ್ತುತಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 42:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6"/>ನನ್ನ ದೇವರೇ, ನನ್ನ ಪ್ರಾಣವು ಕುಗ್ಗಿಹೋಗಿದೆ;</para>
  <para style="q" vid="PSA 42:6">ಆದುದರಿಂದ ಯೊರ್ದನ್ ಹೊಳೆಯ ದೇಶ,</para>
  <para style="q" vid="PSA 42:6">ಹೆರ್ಮೋನ್ ಪರ್ವತ, ಮಿಸಾರ್ ಬೆಟ್ಟ ಇವುಗಳಲ್ಲಿರುವವನಾಗಿ ನಿನ್ನನ್ನು ಸ್ಮರಿಸುತ್ತೇನೆ.<verse eid="PSA 42:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7"/>ನಿನ್ನ ಜಲಪಾತಗಳಿಂದ ಉಂಟಾಗುವ ಮಹಾಘೋಷವು</para>
  <para style="q" vid="PSA 42:7">ಒಂದು ಪ್ರವಾಹವು ಮತ್ತೊಂದು ಪ್ರವಾಹವನ್ನು ಕರೆಯುತ್ತದೋ ಎಂಬಂತಿರುವುದು.</para>
  <para style="q" vid="PSA 42:7">ಹಾಗೆಯೇ ನೀನು ಅಲ್ಲಕಲ್ಲೋಲವಾದ ದುಃಖ ಪ್ರವಾಹದ ತೆರೆಗಳನ್ನು</para>
  <para style="q" vid="PSA 42:7">ನನ್ನ ತಲೆಯ ಮೇಲಿಂದ ದಾಟಿಸಿದಿಯಲ್ಲಾ.<verse eid="PSA 42:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8"/>ಯೆಹೋವನು ಹಗಲಿನಲ್ಲಿ ತನ್ನ ಪ್ರೀತಿಯನ್ನು ನನಗೆ ಅನುಗ್ರಹಿಸುವನು;</para>
  <para style="q" vid="PSA 42:8">ರಾತ್ರಿ ವೇಳೆಯಲ್ಲಿಯೂ ಆತನ ಕೀರ್ತನೆ ನನ್ನಲ್ಲಿರುವುದು.</para>
  <para style="q" vid="PSA 42:8">ನನ್ನ ಜೀವಾಧಾರಕನಾದ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸುವೆನು.<verse eid="PSA 42:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9"/>ನಾನು ನನ್ನ ಶರಣನಿಗೆ, “ದೇವರೇ, ಏಕೆ ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದಿ?</para>
  <para style="q" vid="PSA 42:9">ನಾನು ಏಕೆ ಶತ್ರುಬಾಧೆಯಿಂದ ದುಃಖಿಸುತ್ತಾ ವಿಕಾರಿಯಾಗಿ ಅಲೆಯಬೇಕು?” ಎಂದು ಮೊರೆಯಿಡುವೆನು.<verse eid="PSA 42:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10"/>ನನ್ನ ವಿರೋಧಿಗಳು, “ನಿನ್ನ ದೇವರು ಎಲ್ಲಿ?” ಎಂದು ಯಾವಾಗಲೂ ನನ್ನನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡುವುದರಿಂದ</para>
  <para style="q" vid="PSA 42:10">ನನ್ನ ಎಲುಬುಗಳೆಲ್ಲಾ ಮುರಿದ ಹಾಗಿವೆ.<verse eid="PSA 42:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11"/>ನನ್ನ ಮನವೇ, ನೀನು ಕುಗ್ಗಿ ಹೋಗಿರುವುದೇನು?</para>
  <para style="q" vid="PSA 42:11">ಹೀಗೆ ವ್ಯಥೆಪಡುವುದೇಕೆ? ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 42:11">ಆತನೇ ನನಗೆ ರಕ್ಷಕನೂ, ದೇವರೂ ಆಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 42:11">ನಾನು ಇನ್ನೂ ಆತನನ್ನು ಸ್ತುತಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1"/>ದೇವರೇ, ನ್ಯಾಯವನ್ನು ತೀರಿಸು;</para>
  <para style="q" vid="PSA 43:1">ನನಗೋಸ್ಕರ ವ್ಯಾಜ್ಯವನ್ನು ನಡೆಸಿ ಭಕ್ತಿ ಇಲ್ಲದ ಜನಾಂಗದಿಂದ ತಪ್ಪಿಸು,</para>
  <para style="q" vid="PSA 43:1">ದುರಾಚಾರಿಗಳಾದ ಮೋಸಗಾರರಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು.<verse eid="PSA 43:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2"/>ದೇವರೇ, ನೀನು ನನಗೆ ದುರ್ಗಸ್ಥಾನವಲ್ಲವೇ;</para>
  <para style="q" vid="PSA 43:2">ಏಕೆ ನನ್ನನ್ನು ತಳ್ಳಿಬಿಟ್ಟೆ?</para>
  <para style="q" vid="PSA 43:2">ನಾನು ಏಕೆ ಶತ್ರುಬಾಧೆಯಿಂದ ದುಃಖಿಸುತ್ತಾ ವಿಕಾರಿಯಾಗಿ ಅಲೆಯಬೇಕು?<verse eid="PSA 43:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3"/>ನಿನ್ನ ಬೆಳಕನ್ನು, ನಿನ್ನ ಸತ್ಯಪ್ರಸನ್ನತೆಗಳನ್ನು ಕಳುಹಿಸು;</para>
  <para style="q" vid="PSA 43:3">ಅವು ನಿನ್ನ ಪರಿಶುದ್ಧಪರ್ವತಕ್ಕೆ ನನ್ನನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗಿ ನಿನ್ನ ನಿವಾಸಕ್ಕೆ ಬರಮಾಡಲಿ.<verse eid="PSA 43:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4"/>ದೇವರೇ, ನನ್ನ ದೇವರೇ, ಆಗ ನಾನು ನಿನ್ನ ಯಜ್ಞವೇದಿಯ ಬಳಿಗೆ,</para>
  <para style="q" vid="PSA 43:4">ನನ್ನ ಆನಂದನಿಧಿಯಾಗಿರುವ ನಿನ್ನ ಹತ್ತಿರಕ್ಕೆ ಸೇರಿ,</para>
  <para style="q" vid="PSA 43:4">ಕಿನ್ನರಿಯನ್ನು ನುಡಿಸುತ್ತಾ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 43:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5"/>ನನ್ನ ಮನವೇ, ನೀನು ಕುಗ್ಗಿ ಹೋಗಿರುವುದೇನು? ಹೀಗೆ ವ್ಯಥೆಪಡುವುದೇಕೆ?</para>
  <para style="q" vid="PSA 43:5">ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 43:5">ಆತನೇ ನನಗೆ ರಕ್ಷಕನೂ, ದೇವರೂ ಆಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 43:5">ನಾನು ಇನ್ನೂ ಆತನನ್ನು ಸ್ತುತಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s">ನಿರಂತರ ರಕ್ಷಣೆಗಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">1 ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನಸಂಹಗ್ರದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಕೋರಹೀಯರ ಪದ್ಯ.</para>
  <para style="r">
    <ref loc="PSA 79">ಕೀರ್ತ 79</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1"/>ದೇವರೇ, ಪೂರ್ವಕಾಲದಲ್ಲಿ ನಮ್ಮ ಪೂರ್ವಿಕರ ದಿನದಲ್ಲಿ,</para>
  <para style="q" vid="PSA 44:1">ನೀನು ನಡೆಸಿದ ಮಹತ್ಕಾರ್ಯಗಳ ವಿಷಯವನ್ನು ಕೇಳಿದ್ದೇವೆ;</para>
  <para style="q" vid="PSA 44:1">ಅವರೇ ನಮಗೆ ತಿಳಿಸಿದರು.<verse eid="PSA 44:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2"/>ನಿನ್ನ ಹಸ್ತವೇ ಈ ದೇಶದಲ್ಲಿದ್ದ ಜನಾಂಗಗಳನ್ನು ಹೊರಡಿಸಿ,</para>
  <para style="q" vid="PSA 44:2">ನಮ್ಮ ಪೂರ್ವಿಕರನ್ನೇ ನೆಲೆಗೊಳಿಸಿದೆ;</para>
  <para style="q" vid="PSA 44:2">ನೀನು ಆ ಅನ್ಯಜನಗಳನ್ನು ತೆಗೆದುಬಿಟ್ಟು ನಮ್ಮವರನ್ನು ಹಬ್ಬಿಸಿದಿ.<verse eid="PSA 44:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3"/>ನಮ್ಮ ಪೂರ್ವಿಕರಿಗೆ ಕತ್ತಿಯೇ ಈ ದೇಶವನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಡಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 44:3">ನಿನ್ನ ಭುಜಬಲ, ಬಲಗೈ ಮತ್ತು ಪ್ರಸನ್ನತೆ ಅವರಿಗೆ ಜಯವನ್ನು ಉಂಟುಮಾಡಿದವು;</para>
  <para style="q" vid="PSA 44:3">ನಿನ್ನ ಸಹಾಯ ಸದಾಕಾಲ ಅವರಿಗಿತ್ತಲ್ಲಾ.<verse eid="PSA 44:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">44:4 </char>
      <char style="ft" closed="false">ಅಥವಾ ನೀನೇ ನನ್ನ ಅರಸನು, ಓ ದೇವರೇ, ಯಾಕೋಬನಿಗೆ ಜಯವನ್ನು ಆಜ್ಞಾಪಿಸು.</char>
    </note>ದೇವರೇ, ನೀನೇ ನನ್ನ ಅರಸನು;</para>
  <para style="q" vid="PSA 44:4">ಯಾಕೋಬನಿಗೆ ಜಯವನ್ನು ಆಜ್ಞಾಪಿಸಿದಾತನು.<verse eid="PSA 44:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5"/>ನಿನ್ನ ಸಹಾಯದಿಂದಲೇ ವೈರಿಗಳನ್ನು ಕೆಡವಿಬಿಡುವೆವು;</para>
  <para style="q" vid="PSA 44:5">ನಿನ್ನ ನಾಮಧೇಯದ ಬಲದಿಂದ ಎದುರಾಳಿಗಳನ್ನು ತುಳಿದುಬಿಡುವೆವು.<verse eid="PSA 44:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6"/>ನಾನು ನನ್ನ ಬಿಲ್ಲಿನಲ್ಲಿ ಭರವಸವಿಡುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 44:6">ಇಲ್ಲವೇ ನನ್ನ ಕತ್ತಿಯು ನನ್ನನ್ನು ರಕ್ಷಿಸಲಾರದು.<verse eid="PSA 44:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7"/>ಹಿಂಸಕರಿಂದ ಬಿಡಿಸಿದವನು ನೀನೇ;</para>
  <para style="q" vid="PSA 44:7">ನಮ್ಮನ್ನು ದ್ವೇಷಿಸುವವರನ್ನು ನಾಚಿಕೆಪಡಿಸಿದಾತನು ನೀನೇ.<verse eid="PSA 44:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8"/>ದೇವರೇ, ನಿನ್ನಲ್ಲಿಯೇ ಯಾವಾಗಲೂ ಹಿಗ್ಗುತ್ತಿದ್ದೇವೆ;</para>
  <para style="q" vid="PSA 44:8">ನಿನ್ನ ನಾಮವನ್ನೇ ಸದಾಕಾಲವೂ ಕೀರ್ತಿಸುವೆವು.<verse eid="PSA 44:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9"/>ಆದರೆ ಈಗ ನೀನು ನಮ್ಮನು ಕೈಬಿಟ್ಟಿದ್ದೀ, ಅವಮಾನಪಡಿಸಿದಿ;</para>
  <para style="q" vid="PSA 44:9">ನಮ್ಮ ಸೈನ್ಯಗಳ ಸಂಗಡ ನೀನು ಹೋಗಲಿಲ್ಲ.<verse eid="PSA 44:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10"/>ನಾವು ಹಗೆಗಳಿಗೆ ಬೆನ್ನುಕೊಟ್ಟು ಓಡಿಹೋಗುವಂತೆ ಮಾಡಿದಿ;</para>
  <para style="q" vid="PSA 44:10">ನಮ್ಮ ವೈರಿಗಳು ತಮಗೋಸ್ಕರ ಬೇಕಾದ ಹಾಗೆ ಕೊಳ್ಳೆಹೊಡೆಯುತ್ತಾರೆ.<verse eid="PSA 44:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11"/>ತಿನ್ನತಕ್ಕ ಕುರಿಗಳನ್ನೋ ಎಂಬಂತೆ ನಮ್ಮನ್ನು ವಂಚಕರಿಗೆ ಒಪ್ಪಿಸಿದಿ;</para>
  <para style="q" vid="PSA 44:11">ಜನಾಂಗಗಳಲ್ಲಿ ನಮ್ಮನ್ನು ಚದರಿಸಿದ್ದೀ.<verse eid="PSA 44:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12"/>ನೀನು ಯಾವ ಲಾಭವನ್ನೂ ಹೊಂದದೆ ನಿಷ್ಪ್ರಯೋಜನವಾಗಿ,</para>
  <para style="q" vid="PSA 44:12">ನಿನ್ನ ಪ್ರಜೆಯನ್ನು ಮಾರಿಬಿಟ್ಟಿದ್ದೀ.<verse eid="PSA 44:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13"/>ನಮ್ಮನ್ನು ನೆರೆಯವರ ನಿಂದೆಗೆ ಗುರಿಮಾಡಿದಿ;</para>
  <para style="q" vid="PSA 44:13">ಸುತ್ತಣ ಜನಾಂಗಗಳವರ ಪರಿಹಾಸ್ಯಕ್ಕೂ, ಕುಚೋದ್ಯಕ್ಕೂ ಒಳಪಡಿಸಿದಿ.<verse eid="PSA 44:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14"/>ನಮ್ಮನ್ನು ಅನ್ಯದೇಶೀಯರ ಗಾದೆಗೆ ಆಸ್ಪದಮಾಡಿದಿ;</para>
  <para style="q" vid="PSA 44:14">ಅವರು ನಮ್ಮನ್ನು ನೋಡಿ ತಲೆಯಾಡಿಸುತ್ತಾರೆ.<verse eid="PSA 44:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15"/>ದೂಷಕರ ನಿಂದಾವಚನಗಳಿಂದಲೂ,</para>
  <para style="q" vid="PSA 44:15">ಮುಯ್ಯಿತೀರಿಸುವ ವೈರಿಗಳ ದೃಷ್ಟಿಯಿಂದಲೂ,<verse eid="PSA 44:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16"/>ನನಗೆ ಉಂಟಾಗಿರುವ ಅವಮಾನವು ಯಾವಾಗಲೂ ನನ್ನ ಮುಂದೆ ಇದೆ;</para>
  <para style="q" vid="PSA 44:16">ನಾಚಿಕೆಯು ನನ್ನ ಮುಖವನ್ನು ಮುಚ್ಚಿದೆ.<verse eid="PSA 44:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17"/>ನಾವು ನಿನ್ನನ್ನು ಮರೆಯದೆಯೂ,</para>
  <para style="q" vid="PSA 44:17">ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಮೀರದೆಯೂ ಇದ್ದರೂ;</para>
  <para style="q" vid="PSA 44:17">ಇದೆಲ್ಲಾ ನಮ್ಮ ಮೇಲೆ ಬಂದಿದೆಯಲ್ಲಾ!<verse eid="PSA 44:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18"/>ನಮ್ಮ ಹೃದಯವು ಹಿಂದಿರುಗಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 44:18">ನಮ್ಮ ಹೆಜ್ಜೆಗಳು ನಿನ್ನ ದಾರಿಯಿಂದ ತೊಲಗಲಿಲ್ಲ.<verse eid="PSA 44:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19"/>ಆದರೂ ನೀನು ನಮ್ಮನ್ನು ಅಪಜಯಪಡಿಸಿ ನರಿಗಳಿರುವ ಕಾಡನ್ನಾಗಿ ಮಾಡಿದ್ದೇಕೆ?</para>
  <para style="q" vid="PSA 44:19">ಮರಣದ ನೆರಳು ನಮ್ಮನ್ನು ಕವಿಯುವಂತೆ ಮಾಡಿದ್ದೇಕೆ?<verse eid="PSA 44:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20"/>ನಾವು ನಮ್ಮ ದೇವರ ಹೆಸರನ್ನು ಮರೆತು,</para>
  <para style="q" vid="PSA 44:20">ಅನ್ಯದೇವತೆಗಳಿಗೆ ಕೈಯೆತ್ತಿದ್ದರೆ,<verse eid="PSA 44:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21"/>ಹೃದಯದ ರಹಸ್ಯಗಳನ್ನು ಬಲ್ಲವನಾದ ದೇವರು,</para>
  <para style="q" vid="PSA 44:21">ವಿಚಾರಿಸುತ್ತಿರಲಿಲ್ಲವೋ?<verse eid="PSA 44:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22"/>ದೇವರೇ, ನಾವು ನಿನ್ನ ನಿಮಿತ್ತ ದಿನವೆಲ್ಲಾ ಕೊಲೆಗೆ ಗುರಿಯಾಗಿದ್ದೇವೆ;</para>
  <para style="q" vid="PSA 44:22">ಜನರು ನಮ್ಮನ್ನು ಕೊಯ್ಗುರಿಗಳಂತೆ ಎಣಿಸಿದ್ದಾರೆ.<verse eid="PSA 44:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23"/>ಕರ್ತನೇ, ಏಕೆ ನಿದ್ರಿಸುತ್ತೀ? ಎಚ್ಚರವಾಗು;</para>
  <para style="q" vid="PSA 44:23">ಏಳು, ಸದಾಕಾಲಕ್ಕೆ ನಮ್ಮನ್ನು ತಳ್ಳಿಬಿಡಬೇಡ.<verse eid="PSA 44:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24"/>ಏಕೆ ವಿಮುಖನಾಗಿದ್ದಿ?</para>
  <para style="q" vid="PSA 44:24">ನಮಗಿರುವ ಬಾಧೆಗಳನ್ನೂ, ಹಿಂಸೆಗಳನ್ನೂ ಏಕೆ ಲಕ್ಷಿಸುವುದಿಲ್ಲ?<verse eid="PSA 44:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25"/>ನಮ್ಮ ಪ್ರಾಣವು ಧೂಳಿನವರೆಗೂ ಬಗ್ಗಿಹೋಗಿದೆ;</para>
  <para style="q" vid="PSA 44:25">ನಮ್ಮ ಶರೀರವು ನೆಲಕ್ಕೆ ಅಂಟಿಕೊಂಡಿದೆ.<verse eid="PSA 44:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26"/>ಎದ್ದು ಬಂದು ಸಹಾಯಮಾಡು;</para>
  <para style="q" vid="PSA 44:26">ನಿನ್ನ ಒಡಂಬಡಿಕೆಯ ನಂಬಿಗಸ್ತಿಕೆಗಾಗಿ ನಮ್ಮನ್ನು ವಿಮೋಚಿಸು.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s">ರಾಜನ ವಿವಾಹದ ವರ್ಣನೆ</para>
  <para style="d">1 ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಕೋಶನ್ನೀಮ್ ಎಂಬ ರಾಗದ ಮೇಲೆ ಹಾಡತಕ್ಕದ್ದು; ಕೋರಹೀಯರ ಪದ್ಯ; ಪ್ರೇಮಗೀತೆ.</para>
  <para style="r">
    <ref loc="ISA 61:10-62:5">ಯೆಶಾ 61:10-62:5</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1"/>ಒಂದು ದಿವ್ಯ ವಿಷಯವನ್ನು ಹೇಳುವುದಕ್ಕೆ ನನ್ನ ಹೃದಯವು ತವಕಪಡುತ್ತದೆ;</para>
  <para style="q" vid="PSA 45:1">ನಾನು ರಾಜನನ್ನು ಕುರಿತು ಈ ಪದ್ಯವನ್ನು ರಚಿಸುವೆನು.</para>
  <para style="q" vid="PSA 45:1">ನನ್ನ ನಾಲಿಗೆಯು ಒಳ್ಳೆಯ ಬರಹಗಾರನ ಲೇಖನಿಯಂತೆ ಸಿದ್ಧವಾಗಿದೆ.<verse eid="PSA 45:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2"/>ನೀನು ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗಿಂತ ಅತಿಸುಂದರನು;</para>
  <para style="q" vid="PSA 45:2">ನಿನ್ನ ಮಾತುಗಳು ಬಹು ಮಧುರ;</para>
  <para style="q" vid="PSA 45:2">ಇದರಿಂದಲೇ ದೈವಾನುಗ್ರಹವು ಯಾವಾಗಲೂ ನಿನ್ನ ಮೇಲಿದೆ ಎಂಬುದು ಸ್ವಷ್ಟವಾಗುತ್ತದೆ.<verse eid="PSA 45:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3"/>ಶೂರನೇ, ಮಹಿಮೆ ಮತ್ತು ಪ್ರಭಾವವನ್ನು ಧರಿಸಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 45:3">ಸೊಂಟಕ್ಕೆ ಪಟ್ಟದ ಕತ್ತಿಯನ್ನು ಕಟ್ಟಿಕೋ.<verse eid="PSA 45:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4"/>ಸತ್ಯತೆ, ದೈನ್ಯ, ನೀತಿಗಳನ್ನು ಸ್ಥಾಪಿಸುವುದಕ್ಕಾಗಿ</para>
  <para style="q" vid="PSA 45:4">ಸಕಲ ವೈಭವದೊಡನೆ ವಾಹನರೂಢನಾಗಿ,</para>
  <para style="q" vid="PSA 45:4">ವಿಜಯೋತ್ಸವದೊಡನೆ ಹೊರಡು.</para>
  <para style="q" vid="PSA 45:4">ನಿನ್ನ ಬಲಗೈ ಭಯಂಕರ ಕೃತ್ಯಗಳನ್ನು ನಡೆಸಲಿ.<verse eid="PSA 45:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5"/>ನಿನ್ನ ಬಾಣಗಳು ಮಹಾತೀಕ್ಷ್ಣವಾಗಿರುವವು;</para>
  <para style="q" vid="PSA 45:5">ಅವು ರಾಜನ ಶತ್ರುಗಳ ಎದೆಯನ್ನು ಭೇದಿಸುವವು;</para>
  <para style="q" vid="PSA 45:5">ಶತ್ರುಜನಾಂಗಗಳು ನಿನ್ನ ಪಾದದ ಕೆಳಗೆ ಬೀಳುವವು.<verse eid="PSA 45:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">45:6 </char>
      <char style="ft" closed="false">ಅಥವಾ ದೇವರೇ, ನಿನ್ನ ಸಿಂಹಾಸನವು. </char>
    </note>ದೇವರು ನಿನಗೆ ಕೊಟ್ಟಿರುವ ಸಿಂಹಾಸನವು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಇರುವುದು;</para>
  <para style="q" vid="PSA 45:6">ನಿನ್ನ ರಾಜದಂಡವು ನ್ಯಾಯ ದಂಡವಾಗಿದೆ.<verse eid="PSA 45:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7"/>ನೀನು ಧರ್ಮವನ್ನು ಪ್ರೀತಿಸುತ್ತಿ, ಅಧರ್ಮವನ್ನು ದ್ವೇಷಿಸುತ್ತಿ;</para>
  <para style="q" vid="PSA 45:7">ಆದುದರಿಂದ ದೇವರು, ನಿನ್ನ ದೇವರೇ, ನಿನ್ನನ್ನು ನಿನ್ನ ಜೊತೆಗಾರರಿಗಿಂತ,</para>
  <para style="q" vid="PSA 45:7">ಉನ್ನತಸ್ಥಾನಕ್ಕೆ ಏರಿಸಿ, ಪರಮಾನಂದತೈಲದಿಂದ ಅಭಿಷೇಕಿಸಿದ್ದಾನೆ.<verse eid="PSA 45:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8"/>ನಿನ್ನ ವಸ್ತ್ರಗಳೆಲ್ಲಾ ರಕ್ತಬೋಳ, ದಾಲ್ಚಿನ್ನಿ, ಚಂದನಗಳಿಂದ</para>
  <para style="q" vid="PSA 45:8">ಎಷ್ಟೋ ಸುವಾಸನೆಯುಳ್ಳವುಗಳಾಗಿವೆ;</para>
  <para style="q" vid="PSA 45:8">ಗಜದಂತ ಅರಮನೆಗಳೊಳಗೆ ಉತ್ಕೃಷ್ಟವಾದ ವಾದ್ಯಗಳು ನಿನ್ನನ್ನು ಆನಂದಗೊಳಿಸುತ್ತವೆ.<verse eid="PSA 45:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9"/>ನಿನ್ನ ಸ್ತ್ರೀಪರಿವಾರದಲ್ಲಿ ರಾಜಕುಮಾರಿಯರೂ ಇದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 45:9">ಪಟ್ಟದ ರಾಣಿಯು ಓಫೀರ್ ದೇಶದ ಬಂಗಾರದ ಆಭರಣಗಳಿಂದ ಅಲಂಕೃತಳಾಗಿ,</para>
  <para style="q" vid="PSA 45:9">ನಿನ್ನ ಬಲಭಾಗದಲ್ಲಿ ನಿಂತಿರುವಳು.<verse eid="PSA 45:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10"/>ಎಲೌ ರಾಜಕುಮಾರಿಯೇ, ನನ್ನ ಮಾತನ್ನು ಕೇಳಿ ಆಲೋಚಿಸು;</para>
  <para style="q" vid="PSA 45:10">ಸ್ವಜನರನ್ನೂ ತೌರಮನೆಯನ್ನೂ ಮರೆತುಬಿಡು.<verse eid="PSA 45:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11"/>ಆಗ ರಾಜನು ನಿನ್ನ ಲಾವಣ್ಯವನ್ನು ನೋಡಲು ಅಪೇಕ್ಷಿಸುವನು.</para>
  <para style="q" vid="PSA 45:11">ಆತನೇ ನಿನಗೆ ಒಡೆಯನು;</para>
  <para style="q" vid="PSA 45:11">ಆತನನ್ನು ಗೌರವಿಸು.<verse eid="PSA 45:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12"/>ತೂರ್ ಸಂಸ್ಥಾನದವರು ಕಾಣಿಕೆಗಳೊಂದಿಗೆ ಬರುವರು;</para>
  <para style="q" vid="PSA 45:12">ಪ್ರಜೆಗಳಲ್ಲಿ ಐಶ್ವರ್ಯವಂತರು ನಿನ್ನ ದಯೆಯನ್ನು ಕೋರುವರು.<verse eid="PSA 45:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13"/>ಅಂತಃಪುರದಲ್ಲಿ ರಾಜಕುಮಾರಿಯು ಎಷ್ಟೋ ವೈಭವದಿಂದಿದ್ದಾಳೆ;</para>
  <para style="q" vid="PSA 45:13">ಆಕೆಯು ಜರತಾರಿಯ<note caller="+" style="f"><char style="fr" closed="false">45:13 </char><char style="fq" closed="false">ಜರತಾರಿಯ </char><char style="ft" closed="false">ಚಿನ್ನದಿಂದ ನೇಯ್ದ</char></note> ವಸ್ತ್ರವನ್ನು ಧರಿಸಿಕೊಂಡಿದ್ದಾಳೆ.<verse eid="PSA 45:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14"/>ಆಕೆಯು ಬೂಟೇದಾರಿ <note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="fq" closed="false">ಬೂಟೇದಾರಿ </char><char style="ft" closed="false">ಕಸೂತಿ ಕೆಲಸದ</char></note>ವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 45:14">ಅವಳ ಸೇವೆಗಾಗಿ ಕನ್ಯೆಯರಾದ ಸಖೀಯರು ಅವಳನ್ನು ಹಿಂಬಾಲಿಸಿ,</para>
  <para style="q" vid="PSA 45:14">ಅರಸನ ಬಳಿಗೆ ಬರುವರು.<verse eid="PSA 45:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15"/>ಅವರು ಉಲ್ಲಾಸದಿಂದಲೂ, ಸಂತೋಷದಿಂದಲೂ ಬಂದು,</para>
  <para style="q" vid="PSA 45:15">ಅರಮನೆಯೊಳಗೆ ಪ್ರವೇಶಿಸುವರು.<verse eid="PSA 45:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16"/>ನಿನ್ನ ಪೂರ್ವಿಕರ ಸ್ಥಳಗಳಲ್ಲಿ ನಿನ್ನ ಮಕ್ಕಳು ಇರುವರು;</para>
  <para style="q" vid="PSA 45:16">ನೀನು ಅವರನ್ನು ಭೂಮಿಯ ಮೇಲೆಲ್ಲಾ ಅಧಿಕಾರಿಗಳನ್ನಾಗಿ ನೇಮಿಸುವಿ.<verse eid="PSA 45:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17"/>ನಿನ್ನ ಹೆಸರು ತಲತಲಾಂತರಗಳಲ್ಲಿ ಜ್ಞಾಪಕವಿರುವಂತೆ ನಾನು ಮಾಡುವೆನು;</para>
  <para style="q" vid="PSA 45:17">ಅದುದರಿಂದ ಎಲ್ಲಾ ಜನಗಳು ನಿನ್ನನ್ನು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಪ್ರಶಂಸಿಸುವರು.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s">ಯೆಹೋವನು ಭಕ್ತಪಾಲಕನೂ, ಸರ್ವಾಧಿಪತಿಯೂ ಎಂಬುದು</para>
  <para style="d">1 ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಕೋರಹೀಯರ ಗೀತೆ; ತಾರಕಸ್ಥಾಯಿಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು.</para>
  <para style="r">
    <ref loc="PSA 76">ಕೀರ್ತ 76</ref>; <ref loc="1CH 15:20">1ಪೂರ್ವ 15:20</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1"/>ದೇವರು ನಮಗೆ ಆಶ್ರಯದುರ್ಗವಾಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 46:1">ಆತನು ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ನಮಗೆ ವಿಶೇಷ ಸಹಾಯಕನು.<verse eid="PSA 46:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2"/>ಆದುದರಿಂದ ಭೂಮಿಯು ಮಾರ್ಪಟ್ಟರೂ,</para>
  <para style="q" vid="PSA 46:2">ಬೆಟ್ಟಗಳು ಸಮುದ್ರದಲ್ಲಿ ಮುಳುಗಿಹೋದರೂ,</para>
  <para style="q" vid="PSA 46:2">ನಮಗೇನೂ ಭಯವಿಲ್ಲ.<verse eid="PSA 46:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3"/>ಸಮುದ್ರವು ಬೋರ್ಗರೆಯುತ್ತಾ ನೊರೆಯನ್ನು ಕಾರಿದರೇನು?</para>
  <para style="q" vid="PSA 46:3">ಅದರ ಅಲ್ಲಕಲ್ಲೋಲಗಳಿಂದ ಪರ್ವತಗಳು ಚಲಿಸಿದರು ಭಯವಿಲ್ಲ? <char style="qs">ಸೆಲಾ </char><verse eid="PSA 46:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4"/>ಒಂದು ನದಿ ಇದೆ; ಅದರ ಕಾಲುವೆಗಳು,</para>
  <para style="q" vid="PSA 46:4">ಪರಾತ್ಪರನಾದ ದೇವರ ಪರಿಶುದ್ಧ ನಿವಾಸಸ್ಥಾನವಾಗಿರುವ,</para>
  <para style="q" vid="PSA 46:4">ದೇವರ ನಗರವನ್ನು ಸಂತೋಷಪಡಿಸುತ್ತವೆ.<verse eid="PSA 46:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5"/>ದೇವರು ಇದರಲ್ಲಿದ್ದಾನೆ; ಇದಕ್ಕೆ ಚಲನವೇ ಇಲ್ಲ.</para>
  <para style="q" vid="PSA 46:5">ಉದಯಕಾಲದಲ್ಲಿಯೇ ದೇವರು ಇದರ ಸಹಾಯಕ್ಕೆ ಬರುವನು.<verse eid="PSA 46:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6"/>ಜನಾಂಗಗಳು ಕಳವಳಗೊಂಡವು;</para>
  <para style="q" vid="PSA 46:6">ರಾಜ್ಯಗಳು ತತ್ತರಿಸಿದವು. ಆತನು ಗರ್ಜಿಸಲು ಭೂಲೋಕವೆಲ್ಲಾ ಕರಗಿ ಹೋಯಿತು.<verse eid="PSA 46:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನು ನಮ್ಮ ಸಂಗಡ ಇದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 46:7">ಯಾಕೋಬ ವಂಶದವರ ದೇವರು ನಮಗೆ ಆಶ್ರಯ ದುರ್ಗವಾಗಿದ್ದಾನೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 46:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8"/>ಬನ್ನಿರಿ, ಯೆಹೋವನ ಕಾರ್ಯವನ್ನು ನೋಡಿರಿ;</para>
  <para style="q" vid="PSA 46:8">ಆತನು ಭೂಲೋಕದಲ್ಲಿ ಎಂಥಾ ವಿನಾಶವನ್ನು ಉಂಟುಮಾಡಿದ್ದಾನೆ.<verse eid="PSA 46:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9"/>ಲೋಕದ ಎಲ್ಲಾ ಭಾಗದಲ್ಲೂ ಯುದ್ಧವನ್ನು ಸ್ಥಗಿತಗೊಳಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 46:9">ಬಿಲ್ಲುಗಳನ್ನೂ, ಭಲ್ಲೆಯಗಳನ್ನೂ ಮುರಿದುಹಾಕಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 46:9">
    <note caller="+" style="f">
      <char style="fr" closed="false">46:9 </char>
      <char style="ft" closed="false">ಅಥವಾ ಗುರಾಣಿಗಳನ್ನು. ಪ್ರಾಚೀನ ಗುರಾಣಿಗಳನ್ನು ಮರದಿಂದ ಮತ್ತು ಚರ್ಮದಿಂದ ತಯಾರಿಸಲಾಗುತ್ತಿತ್ತು ಮತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಆಲಿವ್ ಎಣ್ಣೆಯನ್ನು ಉಜ್ಜಲಾಗುತ್ತಿತ್ತು; ಇದರ ಪರಿಣಾಮವಾಗಿ ಅವುಗಳನ್ನು ಸುಲಭವಾಗಿ ದಹಿಸಬಹುದಾಗಿತ್ತು.</char>
    </note>ರಥಗಳನ್ನು ದಹಿಸಿಬಿಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 46:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10"/>“<note caller="+" style="f"><char style="fr" closed="false">46:10 </char><char style="ft" closed="false">ಅಥವಾ ಮೌನವಾಗಿರಿ.</char></note>ಕಾದಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿರಿ, ನಾನೇ ದೇವರು;</para>
  <para style="q" vid="PSA 46:10">ಲೋಕದ ಸಮಸ್ತ ಜನಗಳಿಗೂ ಸರ್ವಾಧಿಪತಿಯು ನಾನೇ ಎಂದು ತಿಳಿಯಿರಿ” ಎಂದು ಹೇಳಿದ್ದಾನೆ.<verse eid="PSA 46:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನು ನಮ್ಮ ಸಂಗಡ ಇದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 46:11">ಯಾಕೋಬವಂಶದವರ ದೇವರು ನಮಗೆ ಆಶ್ರಯ ದುರ್ಗವಾಗಿದ್ದಾನೆ. <char style="qs">ಸೆಲಾ. </char><verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s">ಸಾರ್ವಭೌಮನಾದ ಯೆಹೋವನು ಸಿಂಹಾಸನಾರೂಢನಾಗಿರುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಕೋರಹೀಯರ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 93">ಕೀರ್ತ 93</ref>; <ref loc="PSA 95:-1-100">95-100</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1"/>ಸರ್ವಜನಾಂಗದವರೇ, ಚಪ್ಪಾಳೆ ಹೊಡೆಯಿರಿ;</para>
  <para style="q" vid="PSA 47:1">ಆರ್ಭಟದಿಂದ ದೇವರಿಗೆ ಜಯಧ್ವನಿ ಮಾಡಿರಿ.<verse eid="PSA 47:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2"/>ಮಹೋನ್ನತನಾದ ಯೆಹೋವನು ಭಯಂಕರನಾಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 47:2">ಆತನು ಭೂಲೋಕಕ್ಕೆಲ್ಲಾ ಮಹಾರಾಜನು ಆಗಿದ್ದಾನೆ.<verse eid="PSA 47:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3"/>ಆತನು ಜನಾಂಗಗಳನ್ನು ನಮಗೆ ಅಧೀನಪಡಿಸಿ,</para>
  <para style="q" vid="PSA 47:3">ಜನಾಂಗಗಳನ್ನು ನಮ್ಮ ಕಾಲಕೆಳಗೆ ಹಾಕಿದ್ದಾನೆ.<verse eid="PSA 47:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4"/>ಆತನು ಘನತೆಯುಳ್ಳ ಯಾಕೋಬನ ವಂಶದವರಾದ ನಮ್ಮನ್ನು ಪ್ರೀತಿಸಿ,</para>
  <para style="q" vid="PSA 47:4">ನಮ್ಮ ಸ್ವತ್ತನ್ನು ಆಯ್ದುಕೊಂಡಿದ್ದಾನೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 47:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5"/>ದೇವರು ಜಯಘೋಷದಿಂದ ಏರಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 47:5">ಯೆಹೋವನು ತುತ್ತೂರಿಯ ಧ್ವನಿಯೊಡನೆ ಆರೋಹಣ ಮಾಡಿದ್ದಾನೆ.<verse eid="PSA 47:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6"/>ದೇವರನ್ನು ಸಂಕೀರ್ತಿಸಿರಿ, ಸ್ತುತಿಸಿ ಹಾಡಿರಿ;</para>
  <para style="q" vid="PSA 47:6">ನಮ್ಮ ಅರಸನನ್ನು ಕೀರ್ತಿಸಿರಿ, ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 47:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7"/>ಏಕೆಂದರೆ, ದೇವರು ಭೂಲೋಕಕ್ಕೆಲ್ಲಾ ರಾಜನು;</para>
  <para style="q" vid="PSA 47:7">ಆತನನ್ನು ಜ್ಞಾನಯುಕ್ತರಾಗಿ ಕೀರ್ತಿಸಿರಿ.<verse eid="PSA 47:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8"/>ದೇವರು ಸರ್ವಾಧಿಪತ್ಯವನ್ನು ವಹಿಸಿಕೊಂಡಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 47:8">ಆತನು ತನ್ನ ಪರಿಶುದ್ಧ ಸಿಂಹಾಸನದಲ್ಲಿ ಆಸೀನನಾಗಿದ್ದಾನೆ.<verse eid="PSA 47:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9"/>ಜನಾಂಗಗಳನ್ನು ಆಳುವ ಪ್ರಭುಗಳು ಅಬ್ರಹಾಮನ</para>
  <para style="q" vid="PSA 47:9">ದೇವರ ಪ್ರಜೆಗಳೊಂದಿಗೆ ಸೇರಿಕೊಂಡಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 47:9">ಏಕೆಂದರೆ ಭೂಪರಲೋಕದ ಗುರಾಣಿಗಳು ದೇವರಿಗೆ ಸೇರಿದವುಗಳೇ.</para>
  <para style="q" vid="PSA 47:9">ಆತನೇ ಸರ್ವೋನ್ನತನು.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s">ಚೀಯೋನನ್ನು ರಕ್ಷಿಸಿದ್ದಕ್ಕಾಗಿ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುವುದು</para>
  <para style="d">ಹಾಡು; ಕೋರಹೀಯರ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 46">ಕೀರ್ತ 46</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1"/>ಯೆಹೋವನು ಮಹೋನ್ನತನು;</para>
  <para style="q" vid="PSA 48:1">ನಮ್ಮ ದೇವರು ತನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತ ನಗರದಲ್ಲಿ ಸರ್ವಸ್ತುತಿಗೆ ಪಾತ್ರನಾಗಿದ್ದಾನೆ.<verse eid="PSA 48:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2"/>ರಾಜಾಧಿರಾಜನ ಪಟ್ಟಣವಿರುವ ಚೀಯೋನ್ ಪರ್ವತವು</para>
  <para style="q" vid="PSA 48:2">ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿ ಉನ್ನತವಾಗಿಯೂ, ರಮ್ಯವಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 48:2">ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಕಂಗೊಳಿಸುತ್ತಿರುವುದು.<verse eid="PSA 48:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3"/>ದೇವರು ಅದರ ಕೊತ್ತಲುಗಳಲ್ಲಿ,</para>
  <para style="q" vid="PSA 48:3">ತಾನೇ ಭದ್ರವಾದ ಬುರುಜೆಂದು ಕೀರ್ತಿಪಡೆದನು.<verse eid="PSA 48:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4"/>ರಾಜರು ಕೂಡಿಕೊಂಡರು;</para>
  <para style="q" vid="PSA 48:4">ಅವರು ಒಗ್ಗಟ್ಟಾಗಿ ಬಂದರು.<verse eid="PSA 48:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5"/>ನೋಡಿ ಬೆರಗಾದರು;</para>
  <para style="q" vid="PSA 48:5">ತಲ್ಲಣಿಸಿ ಓಡಿಹೋದರು.<verse eid="PSA 48:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6"/>ಕಂಪನವೂ ಹೆರುವವಳಂತೆ,</para>
  <para style="q" vid="PSA 48:6">ವೇದನೆಯೂ ಅವರಿಗೆ ಉಂಟಾಯಿತು.<verse eid="PSA 48:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7"/>ದೇವರೇ, ನೀನು ಬಿರುಗಾಳಿಯಿಂದ ತಾರ್ಷಿಷ್ ದೇಶದ</para>
  <para style="q" vid="PSA 48:7">ದೊಡ್ಡ ದೊಡ್ಡ ಹಡಗುಗಳನ್ನು ಒಡೆದುಬಿಟ್ಟಂತಾಯಿತು.<verse eid="PSA 48:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8"/>ನಾವು ಕಿವಿಯಿಂದ ಕೇಳಿದಂತೆಯೇ ಈಗ ಕಣ್ಣಾರೆ ಕಂಡೆವು;</para>
  <para style="q" vid="PSA 48:8">ನಮ್ಮ ದೇವರೂ ಸೇನಾಧೀಶನೂ ಆಗಿರುವ</para>
  <para style="q" vid="PSA 48:8">ಯೆಹೋವನ ಸಂಸ್ಥಾನದಲ್ಲಿ ಆತನ ಮಹತ್ತನ್ನು ನೋಡಿದ್ದೇವೆ.</para>
  <para style="q" vid="PSA 48:8">ದೇವರು ಅದನ್ನು ಶಾಶ್ವತವಾಗಿ ಸ್ಥಾಪಿಸುವನು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 48:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9"/>ದೇವರೇ, ನಾವು ನಿನ್ನ ಆಲಯದಲ್ಲಿ,</para>
  <para style="q" vid="PSA 48:9">ನಿನ್ನ ಪ್ರೀತಿಯನ್ನು ಸ್ಮರಿಸುತ್ತೇವೆ;<verse eid="PSA 48:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10"/>ದೇವರೇ, ನಿನ್ನ ನಾಮದ ಘನತೆಗೆ ತಕ್ಕಂತೆಯೇ,</para>
  <para style="q" vid="PSA 48:10">ಲೋಕವೆಲ್ಲಾ ನಿನ್ನನ್ನು ಹೊಗಳುವುದು.</para>
  <para style="q" vid="PSA 48:10">ನಿನ್ನ ಬಲಗೈ ನೀತಿಯನ್ನು ನೆರವೇರಿಸಿತು.<verse eid="PSA 48:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11"/>ಚೀಯೋನ್ ಪಟ್ಟಣದವರು<note caller="+" style="f"><char style="fr" closed="false">48:11 </char><char style="fq" closed="false">ಚೀಯೋನ್ ಪಟ್ಟಣದವರು </char><char style="ft" closed="false">ಮೂಲತಃ ಚೀಯೋನ್ ಪುತ್ರಿಯರು.</char></note> ಹರ್ಷಿಸಲಿ;</para>
  <para style="q" vid="PSA 48:11">ನೀನು ನ್ಯಾಯವನ್ನು ನಿರ್ಣಯಿಸಿದ್ದರಿಂದ,</para>
  <para style="q" vid="PSA 48:11">ಯೆಹೂದ ಸೀಮೆಯ ನಿವಾಸಿಗಳು ಆನಂದಪಡಲಿ.<verse eid="PSA 48:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12"/>ಚೀಯೋನ್ ಸಂಸ್ಥಾನದ ಸುತ್ತಲೂ ಸಂಚರಿಸಿ,</para>
  <para style="q" vid="PSA 48:12">ಅದರ ಬುರುಜುಗಳನ್ನು ಲೆಕ್ಕಿಸಿರಿ.<verse eid="PSA 48:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13"/>ಅದರ ಪ್ರಾಕಾರಗಳನ್ನು ಚೆನ್ನಾಗಿ ನೋಡಿರಿ;</para>
  <para style="q" vid="PSA 48:13">ಅದರ ಕೊತ್ತಲುಗಳನ್ನು ಸೂಕ್ಷ್ಮವಾಗಿ ಗಮನಿಸಿರಿ.<verse eid="PSA 48:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14"/>ಆಗ ನೀವು ನಿಮ್ಮ ಮುಂದಣ ಸಂತತಿಯವರಿಗೆ,</para>
  <para style="q" vid="PSA 48:14">ದೇವರು ಇಂಥವನು; ಆತನು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ನಮ್ಮ ದೇವರು,</para>
  <para style="q" vid="PSA 48:14">ನಿರಂತರವೂ ನಮ್ಮನ್ನು ನಡೆಸುವವನಾಗಿದ್ದಾನೆ ಎಂದು ತಿಳಿಸುವಿರಿ.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s">ಐಶ್ವರ್ಯ ವ್ಯರ್ಥ; ಮರಣ ನಿಶ್ಚಯ; ಸದ್ಭಕ್ತರಿಗೆ ನಿರೀಕ್ಷೆಯುಂಟು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಕೋರಹೀಯರ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 73">ಕೀರ್ತ 73</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1"/>ಸಕಲ ದೇಶಗಳ ಜನರೇ, ಕೇಳಿರಿ;</para>
  <para style="q" vid="PSA 49:1">ಭೂಲೋಕದ ನಿವಾಸಿಗಳೇ, ಕಿವಿಗೊಡಿರಿ.<verse eid="PSA 49:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2"/>ಜನರೇ, ಜನಾಧಿಪತಿಗಳೇ, ಬಡವರೇ ಮತ್ತು ಐಶ್ವರ್ಯವಂತರೇ,</para>
  <para style="q" vid="PSA 49:2">ನೀವೆಲ್ಲರೂ ಒಂದಾಗಿ ಬಂದು ಆಲಿಸಿರಿ.<verse eid="PSA 49:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3"/>ನನ್ನ ಬಾಯಿ ಸುಜ್ಞಾನವನ್ನು ಬೋಧಿಸುವುದು;</para>
  <para style="q" vid="PSA 49:3">ನನ್ನ ಹೃದಯದ ಧ್ಯಾನವು ವಿವೇಕದಿಂದ ಕೂಡಿದೆ.<verse eid="PSA 49:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4"/>ನಾನು ಆತನ ಸಾಮ್ಯಕ್ಕೆ ಕಿವಿಗೊಟ್ಟು, ಕಿನ್ನರಿಯನ್ನು ನುಡಿಸುತ್ತಾ,</para>
  <para style="q" vid="PSA 49:4">ಅದರ ಗೂಡಾರ್ಥವನ್ನು ಪ್ರಕಟಿಸುವೆನು.<verse eid="PSA 49:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5"/>ಕೇಡಿನ ದಿನಗಳಲ್ಲಿ ಏಕೆ ಭಯಪಡಬೇಕು?</para>
  <para style="q" vid="PSA 49:5">ಶತ್ರುಗಳು ಮೋಸದಿಂದ ಸುತ್ತಿಕೊಂಡಿರುವಾಗ ನಾನು ಏಕೆ ಹೆದರಬೇಕು?<verse eid="PSA 49:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6"/>ಅವರು ತಮ್ಮ ಐಶ್ವರ್ಯವನ್ನೇ ನಂಬಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 49:6">ತಾವು ಬಹಳ ಆಸ್ತಿವಂತರೆಂದು ಗರ್ವದಿಂದ ಉಬ್ಬಿದ್ದಾರೆ.<verse eid="PSA 49:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7"/>ಆದರೆ ಯಾರಾದರೂ ತನ್ನ ಸಹೋದರನು<note caller="+" style="f"><char style="fr" closed="false">49:7 </char><char style="fq" closed="false">ತನ್ನ ಸಹೋದರನು </char><char style="ft" closed="false">ಅಥವಾ ತನ್ನನ್ನು ತಾನು.</char></note> ಸಮಾಧಿಯಲ್ಲಿ ಸೇರದಂತೆ,</para>
  <para style="q" vid="PSA 49:7">ದೇವರಿಗೆ ಈಡನ್ನು ಕೊಡಲಾರನು.<verse eid="PSA 49:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8"/>ಅವನ ಪ್ರಾಣವು ಶಾಶ್ವತವಾಗಿ ಉಳಿಯಲು,</para>
  <para style="q" vid="PSA 49:8">ಅಪಾರ ಹಣವನ್ನು ಕೊಟ್ಟು ಬಿಡಿಸಲಾರನು.<verse eid="PSA 49:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9"/>ಮರಣವನ್ನು ತಪ್ಪಿಸಿಕೊಳ್ಳುವುದಕ್ಕೆ ಎಷ್ಟು ಹಣ ಕೊಟ್ಟರೂ,</para>
  <para style="q" vid="PSA 49:9">ಸಾಲುವುದೇ ಇಲ್ಲ, ಅಂಥ ಪ್ರಯತ್ನ ನಿಷ್ಫಲವೆಂದು ತಿಳಿಯಬೇಕು.<verse eid="PSA 49:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10"/>ಸುಜ್ಞಾನಿಗಳು ಸಾಯುವುದನ್ನು ನೋಡುತ್ತೇವಲ್ಲಾ;</para>
  <para style="q" vid="PSA 49:10">ಹಾಗೆಯೇ ಪಶುಗಳಂತಿರುವ ಜ್ಞಾನಹೀನರೂ ನಾಶವಾಗುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 49:10">ಅವರು ನಂಬಿದ್ದ ಆಸ್ತಿಯು ಇತರರ ಪಾಲಾಗುತ್ತದೆ.<verse eid="PSA 49:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11"/>ಅವರ ಸಮಾಧಿಯೇ<note caller="+" style="f"><char style="fr" closed="false">49:11 </char><char style="fq" closed="false">ಸಮಾಧಿಯೇ </char><char style="ft" closed="false">ಅಂದರೆ ಅವರ ಅಂತರಾಲೋಚನೆಗಳು.</char></note> ಶಾಶ್ವತಮಂದಿರವು;</para>
  <para style="q" vid="PSA 49:11">ತಮ್ಮ ನಿವಾಸಗಳು ತಲತಲಾಂತರಕ್ಕೂ ಇರುವುದೆಂದು ಯೋಚಿಸಿ,</para>
  <para style="q" vid="PSA 49:11">ಭೂಮಿಗಳಿಗೆ ತಮ್ಮ ಹೆಸರುಗಳನ್ನು ಕೊಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 49:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12"/>ಆದರೂ ಮನುಷ್ಯನು ಎಷ್ಟು ಘನವಾದ ಪದವಿಯಲ್ಲಿದ್ದರೂ ಸ್ಥಿರವಲ್ಲ;</para>
  <para style="q" vid="PSA 49:12">ನಾಶವಾಗುವ ಪಶುಗಳಂತೆಯೇ ಇಲ್ಲವಾಗುತ್ತಾನೆ.<verse eid="PSA 49:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13"/>ಮೂರ್ಖರಿಗೂ ಅವರ ಮಾತಿನಂತೆ</para>
  <para style="q" vid="PSA 49:13">ನಡೆಯುವವರಿಗೂ ಇದೇ ಗತಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 49:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14"/>ಅವರು ಕುರಿಗಳಂತೆ ಪಾತಾಳದಲ್ಲಿ ಸೇರಿಸಲ್ಪಡುವರು;</para>
  <para style="q" vid="PSA 49:14">ಮೃತ್ಯುವೇ ಅವರ ಪಾಲಕನು.</para>
  <para style="q" vid="PSA 49:14">
    <note caller="+" style="f">
      <char style="fr" closed="false">49:14 </char>
      <char style="ft" closed="false">ಅಥವಾ ಉದಯಕಾಲದಲ್ಲಿ ಯಥಾರ್ಥರು ಅವರ ಮೇಲೆ ದೊರೆತನ ನಡೆಸುವರು. </char>
    </note>ಅವರು ನೇರವಾಗಿ ಪಾತಾಳಕ್ಕೆ ಇಳಿದುಹೋಗುವರು,</para>
  <para style="q" vid="PSA 49:14">ಅವರಿಗೆ ನಿವಾಸವಿಲ್ಲದ ಹಾಗೆ,</para>
  <para style="q" vid="PSA 49:14">ಪಾತಾಳವು ಅವರ ರೂಪವನ್ನು ನಾಶಮಾಡುವುದು.<verse eid="PSA 49:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15"/>ಆದರೆ ದೇವರು ನನ್ನ ಪ್ರಾಣವನ್ನು ಮೃತ್ಯುಹಸ್ತದಿಂದ ತಪ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 49:15">ನನ್ನನ್ನು ಸ್ವೀಕಾರಮಾಡುವನು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 49:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16"/>ಒಬ್ಬನ ಐಶ್ವರ್ಯವೂ, ಗೃಹವೈಭವವೂ<note caller="+" style="f"><char style="fr" closed="false">49:16 </char><char style="fq" closed="false">ಗೃಹವೈಭವವೂ </char><char style="ft" closed="false">ಅಥವಾ ಗೃಹಸಂಪತ್ತು.</char></note></para>
  <para style="q" vid="PSA 49:16">ವೃದ್ಧಿಯಾದಾಗ ಕಳವಳಪಡಬೇಡ.<verse eid="PSA 49:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17"/>ಅವನು ಸಾಯುವಾಗ ಏನೂ ತೆಗೆದುಕೊಂಡು ಹೋಗುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 49:17">ಅವನ ವೈಭವವು ಅವನೊಡನೆ ಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 49:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18"/>ಸಿರಿ ಬಂದಾಗ ನೆರೆಯವರ ಹೊಗಳಿಕೆ ತಪ್ಪದು ಎಂಬಂತೆ,</para>
  <para style="q" vid="PSA 49:18">ಅವನು ಜೀವಮಾನದಲ್ಲಿ ಆತ್ಮಸ್ತುತಿಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 49:18">ಜನರಸ್ತುತಿಯಿಂದಲೂ ಕೂಡಿದವನಾದರೂ,<verse eid="PSA 49:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19"/>ಪೂರ್ವಿಕರ ಬಳಿಗೆ ಸೇರಿ ಅವರಂತೆಯೇ,</para>
  <para style="q" vid="PSA 49:19">ಎಂದಿಗೂ ಬೆಳಕನ್ನು ನೋಡುವುದಿಲ್ಲ.<verse eid="PSA 49:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20"/>ವಿವೇಕಹೀನ ಮನುಷ್ಯನು ಎಷ್ಟು ಘನವಾದ ಪದವಿಯಲ್ಲಿದ್ದರೂ,</para>
  <para style="q" vid="PSA 49:20">ನಶಿಸಿ ಹೋಗುವ ಪಶುಗಳಿಗೆ ಸಮಾನವಾಗಿ ಇಲ್ಲವಾಗುತ್ತಾನೆ.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s">ದೇವರು ಸದಾಚಾರವನ್ನೇ ಮೆಚ್ಚುವನು</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1"/>ಬಲಿಷ್ಠ ದೇವರಾದ ಯೆಹೋವನು</para>
  <para style="q" vid="PSA 50:1">ಪೂರ್ವದಿಂದ ಪಶ್ಚಿಮ ದಿಕ್ಕಿನವರೆಗೂ ಇರುವ ಭೂನಿವಾಸಿಗಳೆಲ್ಲರನ್ನೂ,</para>
  <para style="q" vid="PSA 50:1">ತನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಬರಬೇಕೆಂದು ಕರೆಯುತ್ತಾನೆ.<verse eid="PSA 50:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2"/>ಅತ್ಯಂತ ರಮಣೀಯವಾದ ಚೀಯೋನಿನಲ್ಲಿರುವ,</para>
  <para style="q" vid="PSA 50:2">ದೇವರು ಪ್ರಕಾಶಿಸುತ್ತಾನೆ.<verse eid="PSA 50:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3"/>ನಮ್ಮ ದೇವರು ಪ್ರತ್ಯಕ್ಷನಾಗುವನು,</para>
  <para style="q" vid="PSA 50:3">ಎಷ್ಟು ಮಾತ್ರವೂ ಸುಮ್ಮನಿರುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 50:3">ಆತನ ಮುಂಭಾಗದಲ್ಲಿ ಬೆಂಕಿ ಪ್ರಜ್ವಲಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 50:3">ಆತನ ಸುತ್ತಲು ಬಿರುಗಾಳಿ ಬೀಸುತ್ತದೆ.<verse eid="PSA 50:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4"/>ಆತನು ತನ್ನ ಪ್ರಜೆಗಳ ನ್ಯಾಯವಿಚಾರಣೆಯಲ್ಲಿ ಭೂಮ್ಯಾಕಾಶಗಳನ್ನು</para>
  <para style="q" vid="PSA 50:4">ಸಾಕ್ಷಿಗಳನ್ನಾಗಿ ನೇಮಿಸುತ್ತಾನೆ.<verse eid="PSA 50:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5"/>“ನನ್ನೊಡನೆ ಯಜ್ಞದ ಮೂಲಕ ಒಡಂಬಡಿಕೆಯನ್ನು ಮಾಡಿಕೊಂಡ ನನ್ನ ಭಕ್ತರನ್ನು</para>
  <para style="q" vid="PSA 50:5">ನನ್ನ ಬಳಿಗೆ ಕರೆದುಕೊಂಡು ಬನ್ನಿರಿ” ಎಂದು ಆಜ್ಞಾಪಿಸುತ್ತಾನೆ.<verse eid="PSA 50:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6"/>ದೇವರು ತಾನೇ ನ್ಯಾಯಾಧಿಪತಿ;</para>
  <para style="q" vid="PSA 50:6">ಆತನು ನೀತಿಸ್ವರೂಪನೆಂದು ಆಕಾಶಮಂಡಲವು ಘೋಷಿಸುತ್ತದೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 50:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7"/>ಆತನು ಆಜ್ಞಾಪಿಸುವುದು ಏನೆಂದರೆ, “ಪ್ರಜೆಗಳಿರಾ, ಇಸ್ರಾಯೇಲ್ಯರೇ,</para>
  <para style="q" vid="PSA 50:7">ದೇವರಾದ ನಾನೇ ನಿಮ್ಮ ದೇವರು;</para>
  <para style="q" vid="PSA 50:7">ನಿಮಗೆ ಖಂಡಿತವಾಗಿ ಹೇಳುತ್ತೇನೆ” ಕೇಳಿರಿ.<verse eid="PSA 50:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8"/>ನಾನು ನಿಮ್ಮ ಯಜ್ಞದ ವಿಷಯದಲ್ಲಿ ತಪ್ಪೆಣಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 50:8">ಸರ್ವಾಂಗಹೋಮಗಳನ್ನು ನೀವು ನಿತ್ಯವೂ ನನಗೆ ಸಮರ್ಪಿಸುತ್ತೀರಲ್ಲಾ.<verse eid="PSA 50:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9"/>ಆದರೂ ನಿಮ್ಮ ಮನೆಗಳಿಂದ ನನಗೆ ಹೋರಿ ಬೇಕಾಗಿಲ್ಲ;</para>
  <para style="q" vid="PSA 50:9">ನಿಮ್ಮ ದೊಡ್ಡಿಗಳಿಂದ ಹೋತ ಬೇಕಿಲ್ಲ.<verse eid="PSA 50:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10"/>ಕಾಡಿನಲ್ಲಿರುವ ಸರ್ವಮೃಗಗಳೂ,</para>
  <para style="q" vid="PSA 50:10">ಗುಡ್ಡಗಳಲ್ಲಿರುವ ಸಾವಿರಾರು ಪಶುಗಳೂ ನನ್ನವೇ.<verse eid="PSA 50:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">50:11 </char>
      <char style="ft" closed="false">ಅಥವಾ ಆಕಾಶದ.</char>
    </note>ಬೆಟ್ಟಗಳ ಪಕ್ಷಿಗಳನ್ನೆಲ್ಲಾ ನಾನು ಬಲ್ಲೆ;</para>
  <para style="q" vid="PSA 50:11">ಅಡವಿಯ ಜೀವಜಂತುಗಳೆಲ್ಲಾ ನನಗೆ ಗೊತ್ತುಂಟು.<verse eid="PSA 50:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12"/>ನನಗೆ ಹಸಿವೆಯಿದ್ದರೆ ನಿಮಗೆ ತಿಳಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 50:12">ಏಕೆಂದರೆ ಲೋಕವೂ ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ ನನ್ನದಲ್ಲವೇ.<verse eid="PSA 50:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13"/>ನಾನು ಹೋರಿಗಳ ಮಾಂಸವನ್ನು ತಿನ್ನುವುದೂ,</para>
  <para style="q" vid="PSA 50:13">ಹೋತಗಳ ರಕ್ತವನ್ನು ಕುಡಿಯುವುದೂ ಉಂಟೇ?<verse eid="PSA 50:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14"/>ಸ್ತುತಿಯಜ್ಞವನ್ನೇ ದೇವರಿಗೆ ಸಮರ್ಪಿಸಿರಿ;</para>
  <para style="q" vid="PSA 50:14">ವಾಗ್ದಾನ ಮಾಡಿದ ಹರಕೆಗಳನ್ನು ಪರಾತ್ಪರನಾದ ದೇವರಿಗೆ ಸಲ್ಲಿಸಿರಿ.<verse eid="PSA 50:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15"/>ಕಷ್ಟಕಾಲದಲ್ಲಿ ನನಗೆ ಮೊರೆಯಿಡಿರಿ, ಬಿಡಿಸುವೆನು;</para>
  <para style="q" vid="PSA 50:15">ಆಗ ನನ್ನನ್ನು ಕೊಂಡಾಡುವಿರಿ.<verse eid="PSA 50:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16"/>ದುಷ್ಟರಿಗಾದರೋ ದೇವರು ಹೇಳುವುದು ಏನೆಂದರೆ,</para>
  <para style="q" vid="PSA 50:16">“ನನ್ನ ವಿಧಿಗಳನ್ನು ಹೇಳುವುದಕ್ಕೆ ನಿಮಗೇನು ಬಾಧ್ಯತೆ ಉಂಟು?</para>
  <para style="q" vid="PSA 50:16">ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ನಿಮ್ಮ ಬಾಯಲ್ಲಿ ಉಚ್ಚರಿಸುವುದೇಕೆ?<verse eid="PSA 50:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17"/>ನೀವೋ ನನ್ನ ಸುಶಿಕ್ಷಣವನ್ನು ಹಗೆಮಾಡುತ್ತೀರಲ್ಲಾ;</para>
  <para style="q" vid="PSA 50:17">ನನ್ನ ಆಜ್ಞೆಯನ್ನು ಉಲ್ಲಂಘಿಸುತ್ತೀರಿ.<verse eid="PSA 50:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18"/>ನೀವು ಕಳ್ಳರೊಡನೆ ಸೇರಿ ಅವರಿಗೆ ಸಮ್ಮತಿ ನೀಡುತ್ತೀರಿ;</para>
  <para style="q" vid="PSA 50:18">ಜಾರರ ಒಡನಾಟದಲ್ಲಿ ನೀವು ಸಂತೋಷದಿಂದ ಇರುತ್ತೀರಿ.<verse eid="PSA 50:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19"/>ನಿಮ್ಮ ಬಾಯಿಯನ್ನು ಕೇಡಿಗೆ ಒಪ್ಪಿಸುತ್ತೀರಿ;</para>
  <para style="q" vid="PSA 50:19">ನಾಲಿಗೆಯು ಮೋಸವನ್ನು ನೇಯುತ್ತದೆ.<verse eid="PSA 50:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20"/>ನೀವು ಕುಳಿತುಕೊಂಡು ನಿಮ್ಮ ಸಹೋದರರ ವಿರುದ್ಧವಾಗಿ ಮಾತನಾಡುತ್ತೀರಿ;</para>
  <para style="q" vid="PSA 50:20">ನಿಮ್ಮ ಒಡಹುಟ್ಟಿದವರನ್ನು ದೂರುತ್ತೀರಿ.<verse eid="PSA 50:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21"/>ನೀವು ಹೀಗೆ ಮಾಡಿದರೂ ನಾನು ಮೌನವಾಗಿದ್ದೆನು.</para>
  <para style="q" vid="PSA 50:21">ಆದುದರಿಂದ, ‘ದೇವರೂ ನಮ್ಮಂಥವನೇ’ ಎಂದು ತಿಳಿದುಕೊಂಡಿರಿ.</para>
  <para style="q" vid="PSA 50:21">ಈಗಲಾದರೋ ನಾನು ಎಲ್ಲವನ್ನು,</para>
  <para style="q" vid="PSA 50:21">ನಿಮ್ಮ ಮುಂದೆ ವಿವರಿಸಿ ನಿಮ್ಮನ್ನು ಅಪರಾಧಿಗಳೆಂದು ಸ್ಥಾಪಿಸುವೆನು.<verse eid="PSA 50:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22"/>ದೇವರನ್ನು ಬಿಟ್ಟವರೇ, ಇದನ್ನು ಮನದಟ್ಟು ಮಾಡಿಕೊಳ್ಳಿರಿ;</para>
  <para style="q" vid="PSA 50:22">ಇಲ್ಲವಾದರೆ ನಿಮ್ಮನ್ನು ಹರಿದುಬಿಟ್ಟೇನು.</para>
  <para style="q" vid="PSA 50:22">ನಿಮ್ಮನ್ನು ತಪ್ಪಿಸುವವರು ಯಾರೂ ಇರುವುದಿಲ್ಲ.<verse eid="PSA 50:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23"/>ಯಾರು ಸ್ತುತಿಯಜ್ಞವನ್ನು ಸಮರ್ಪಿಸುತ್ತಾರೋ ಅವರೇ ನನ್ನನ್ನು ಗೌರವಿಸುವವರು;</para>
  <para style="q" vid="PSA 50:23">ತಮ್ಮ ನಡತೆಯನ್ನು ಸರಿಪಡಿಸಿಕೊಳ್ಳುವವರಿಗೆ ನನ್ನ ವಿಶೇಷವಾದ ರಕ್ಷಣೆಯನ್ನು ತೋರಿಸುವೆನು.”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s">ಪಾಪಕ್ಷಮಾಪಣೆಗಾಗಿ ವಿಜ್ಞಾಪನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನು ಬತ್ಷೆಬಳ ಬಳಿಗೆ ಹೋದ ಮೇಲೆ ಪ್ರವಾದಿಯಾದ ನಾತಾನನು ಎಚ್ಚರಿಸಿದಾಗ ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 51:1"/>ಪ್ರೀತಿಸ್ವರೂಪನಾದ ದೇವರೇ, ನನ್ನನ್ನು ಕರುಣಿಸು;</para>
  <para style="q" vid="PSA 51:1">ಕರುಣಾನಿಧಿಯೇ, ನನ್ನ ದ್ರೋಹವನ್ನೆಲ್ಲಾ ಅಳಿಸಿಬಿಡು.<verse eid="PSA 51:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2"/>ನನ್ನ ಪಾಪವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ತೊಳೆದುಬಿಡು;</para>
  <para style="q" vid="PSA 51:2">ನನ್ನ ದೋಷವನ್ನು ಪರಿಹರಿಸಿ, ನನ್ನನ್ನು ಶುದ್ಧಿಗೊಳಿಸು.<verse eid="PSA 51:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3"/>ನಾನು ದ್ರೋಹಿ ಎಂದು ನಾನೇ ಒಪ್ಪಿಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 51:3">ನನ್ನ ಪಾಪವು ಯಾವಾಗಲೂ ನನ್ನ ಮುಂದೆ ಇದೆ.<verse eid="PSA 51:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4"/>ನಿನಗೇ, ಕೇವಲ ನಿನಗೇ ತಪ್ಪುಮಾಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 51:4">ನಿನ್ನ ದೃಷ್ಟಿಗೆ ಕೆಟ್ಟದ್ದಾಗಿರುವುದನ್ನೇ ಮಾಡಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 51:4">ನಿನ್ನ ನಿರ್ಣಯ ನ್ಯಾಯವಾಗಿಯೂ, ನಿನ್ನ ತೀರ್ಪು ನಿಷ್ಕಳಂಕವಾಗಿಯೂ ಇರುತ್ತದೆ.<verse eid="PSA 51:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5"/>ಹುಟ್ಟಿದಂದಿನಿಂದ ನಾನು ಪಾಪಿಯೇ;</para>
  <para style="q" vid="PSA 51:5">ಮಾತೃಗರ್ಭವನ್ನು ಹೊಂದಿದ ದಿನದಿಂದ ದ್ರೋಹಿಯೇ.<verse eid="PSA 51:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6"/>ಯಥಾರ್ಥಚಿತ್ತವೇ ನಿನಗೆ ಸಂತೋಷ;</para>
  <para style="q" vid="PSA 51:6">ಸುಜ್ಞಾನದ ರಹಸ್ಯಗಳನ್ನು ನನಗೆ ತಿಳಿಯಪಡಿಸು.<verse eid="PSA 51:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7"/>ಹಿಸ್ಸೋಪ್ ಗಿಡದ ಬರಲಿನಿಂದ ನೀರನ್ನು ಚಿಮಕಿಸಿಯೋ ಎಂಬಂತೆ</para>
  <para style="q" vid="PSA 51:7">ನನ್ನ ಅಶುದ್ಧತ್ವವನ್ನು ತೆಗೆದುಬಿಡು, ಆಗ ಶುದ್ಧನಾಗುವೆನು;</para>
  <para style="q" vid="PSA 51:7">ನನ್ನನ್ನು ತೊಳೆ, ಆಗ ಹಿಮಕ್ಕಿಂತಲೂ ಬೆಳ್ಳಗಾಗುವೆನು.<verse eid="PSA 51:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8"/>ನನ್ನಲ್ಲಿ ಸಂಭ್ರಮೋತ್ಸವದ ಧ್ವನಿ ಉಂಟಾಗುವಂತೆ ಮಾಡು;</para>
  <para style="q" vid="PSA 51:8">ಆಗ ನೀನು ಜಜ್ಜಿದ ಎಲುಬುಗಳು ಆನಂದಪಡುವವು.<verse eid="PSA 51:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9"/>ನನ್ನ ದೋಷಕ್ಕೆ ವಿಮುಖನಾಗು;</para>
  <para style="q" vid="PSA 51:9">ನನ್ನ ಪಾಪಗಳನ್ನೆಲ್ಲಾ ಅಳಿಸಿಬಿಡು.<verse eid="PSA 51:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10"/>ದೇವರೇ, ನನ್ನಲ್ಲಿ ಶುದ್ಧಹೃದಯವನ್ನು ನಿರ್ಮಿಸು;</para>
  <para style="q" vid="PSA 51:10">ನನಗೆ ಸ್ಥಿರಚಿತ್ತವನ್ನು ಅನುಗ್ರಹಿಸಿ ನನ್ನನ್ನು ನೂತನಪಡಿಸು.<verse eid="PSA 51:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11"/>ನಿನ್ನ ಸನ್ನಿಧಿಯಿಂದ ನನ್ನನ್ನು ತಳ್ಳಬೇಡ;</para>
  <para style="q" vid="PSA 51:11">ನಿನ್ನ ಪರಿಶುದ್ಧಾತ್ಮವನ್ನು ನನ್ನಿಂದ ತೆಗೆಯಬೇಡ.<verse eid="PSA 51:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12"/>ನಿನ್ನ ರಕ್ಷಣಾನಂದವನ್ನು ನಾನು ಪುನಃ ಅನುಭವಿಸುವಂತೆ ಮಾಡು;</para>
  <para style="q" vid="PSA 51:12">ನನ್ನಲ್ಲಿ ಸಿದ್ಧಮನಸ್ಸನ್ನು ಹುಟ್ಟಿಸಿ ನನಗೆ ಆಧಾರನಾಗು.<verse eid="PSA 51:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13"/>ಆಗ ನಿನ್ನ ಮಾರ್ಗವನ್ನು ದ್ರೋಹಿಗಳಿಗೆ ಬೋಧಿಸುವೆನು;</para>
  <para style="q" vid="PSA 51:13">ಪಾಪಿಗಳು ನಿನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವರು.<verse eid="PSA 51:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14"/>ದೇವರೇ, ನನ್ನ ರಕ್ಷಣಾ ಕರ್ತನೇ,</para>
  <para style="q" vid="PSA 51:14">ಪ್ರಾಣಹತ್ಯದ ಅಪರಾಧದಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು;</para>
  <para style="q" vid="PSA 51:14">ಆಗ ನನ್ನ ನಾಲಿಗೆಯು ಉತ್ಸಾಹದಿಂದ ನಿನ್ನ ನೀತಿಯನ್ನು ಕೊಂಡಾಡುವುದು.<verse eid="PSA 51:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15"/>ಕರ್ತನೇ, ನನ್ನ ಬಾಯಿ ನಿನ್ನನ್ನು ಸ್ತೋತ್ರಮಾಡುವಂತೆ</para>
  <para style="q" vid="PSA 51:15">ನನ್ನ ತುಟಿಗಳನ್ನು ತೆರೆಯಮಾಡು.<verse eid="PSA 51:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16"/>ನಿನಗೆ ಯಜ್ಞಗಳಲ್ಲಿ ಅಪೇಕ್ಷೆಯಿಲ್ಲ, ಇದ್ದರೆ ಸಮರ್ಪಿಸುತ್ತಿದ್ದೆನು;</para>
  <para style="q" vid="PSA 51:16">ಸರ್ವಾಂಗಹೋಮಗಳಲ್ಲಿ ನಿನಗೆ ಸಂತೋಷವಿಲ್ಲ.<verse eid="PSA 51:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">51:17 </char>
      <char style="ft" closed="false">ಅಥವಾ ಓ ದೇವರೇ, ನನ್ನ ಯಜ್ಞವು ಕುಗ್ಗಿದ ಮನಸ್ಸೇ.</char>
    </note>ಕುಗ್ಗಿದ ಮನಸ್ಸೇ ದೇವರಿಗೆ ಇಷ್ಟವಾದ ಯಜ್ಞ;</para>
  <para style="q" vid="PSA 51:17">ದೇವರೇ, ಪಶ್ಚಾತ್ತಾಪದಿಂದ ಜಜ್ಜಿಹೋದ ಮನಸ್ಸನ್ನು ನೀನು ತಿರಸ್ಕರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 51:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18"/>ಚೀಯೋನ್ ಪಟ್ಟಣವನ್ನು ಕಟಾಕ್ಷಿಸಿ ಅದಕ್ಕೆ ಶುಭವನ್ನುಂಟುಮಾಡು;</para>
  <para style="q" vid="PSA 51:18">ಯೆರೂಸಲೇಮಿನ ಪೌಳಿಗೋಡೆಯನ್ನು ಕಟ್ಟಿಸು.<verse eid="PSA 51:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19"/>ಆಗ ಜನರು ನ್ಯಾಯವಾದ ಯಜ್ಞಗಳನ್ನೂ, ಸರ್ವಾಂಗಹೋಮಗಳನ್ನೂ ಸಮರ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 51:19">ದೇವರೇ ನಿನಗೆ ಸಂತೋಷವನ್ನು ಉಂಟುಮಾಡುವರು.</para>
  <para style="q" vid="PSA 51:19">ನಿನ್ನ ಯಜ್ಞವೇದಿಯ ಮೇಲೆ ಹೋರಿಗಳನ್ನು ಸಮರ್ಪಿಸುವರು.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s">ದುಷ್ಟಾಧಿಕಾರಿಯ ದುರ್ಸ್ವಭಾವದ ಖಂಡನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನು ಅಹೀಮೆಲೆಕನ ಮನೆಗೆ ಬಂದ ವರ್ತಮಾನವನ್ನು ಎದೋಮ್ಯನಾದ ದೋಯೇಗನು ಸೌಲನಿಗೆ ತಿಳಿಸಿದಾಗ ದಾವೀದನು ರಚಿಸಿದ ಪದ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">52:1 </char>
      <char style="ft" closed="false">ಅಥವಾ ಓ ಪರಾಕ್ರಮಿಯೇ, ನೀನು ದೇವರ ಮನುಷ್ಯನಿಗೆ ಮಾಡಿದ ಕಾರ್ಯದ ಬಗ್ಗೆ ಹಿಗ್ಗುವದೇನು?</char>
    </note>ಪರಾಕ್ರಮಿಯೇ, ನೀನು ಕೆಡುಕುಮಾಡಿ ಹಿಗ್ಗುವುದೇನು?</para>
  <para style="q" vid="PSA 52:1">ದೇವರ ಕೃಪೆಯು ಯಾವಾಗಲೂ ಇರುವುದು.<verse eid="PSA 52:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2"/>ಮೋಸಗಾರನೇ, ನಿನ್ನ ನಾಲಿಗೆಯು ಹರಿತವಾದ ಕ್ಷೌರಕತ್ತಿಯಂತೆ</para>
  <para style="q" vid="PSA 52:2">ಅಪಾಯಗಳನ್ನೇ ಕಲ್ಪಿಸುತ್ತದೆ.<verse eid="PSA 52:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3"/>ಉಪಕಾರಕ್ಕಿಂತಲೂ ಅಪಕಾರವೇ ನಿನಗೆ ಇಷ್ಟ;</para>
  <para style="q" vid="PSA 52:3">ನೀತಿಯನ್ನು ಬಿಟ್ಟು ಅನೀತಿಯನ್ನು ಸ್ಥಾಪಿಸುವುದೇ ನಿನಗೆ ಸಂತೋಷ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 52:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4"/>ಮೋಸದ ನಾಲಿಗೆಯೇ, ಹಾನಿಕರವಾದ ಮಾತುಗಳೇ ನಿನಗೆ ಇಷ್ಟ.<verse eid="PSA 52:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5"/>ದೇವರು ನಿನ್ನನ್ನು ಎಂದಿಗೂ ಏಳದಂತೆ ಕೆಡವಿಬಿಡುವನು;</para>
  <para style="q" vid="PSA 52:5">ನಿನ್ನನ್ನು ಹಿಡಿದು ಗುಡಾರದೊಳಗಿಂದ ಕಿತ್ತು ಬೀಸಾಡುವನು;</para>
  <para style="q" vid="PSA 52:5">ಆತನು ನಿನ್ನನ್ನು ಜೀವಲೋಕದಿಂದ ಬೇರು ಸಹಿತವಾಗಿ ಕಿತ್ತುಹಾಕುವನು.<verse eid="PSA 52:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6"/>ನೀತಿವಂತರು ಅದನ್ನು ನೋಡಿ ಭಯಪಡುವರು;</para>
  <para style="q" vid="PSA 52:6">ಅವರು ಪರಿಹಾಸ್ಯಮಾಡುತ್ತಾ,<verse eid="PSA 52:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7"/>“ನೋಡಿರಿ, ದೇವರನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳದೆ, ತನ್ನ ಅಧಿಕವಾದ ಐಶ್ವರ್ಯದಲ್ಲಿ ಭರವಸವಿಟ್ಟು,</para>
  <para style="q" vid="PSA 52:7">
    <note caller="+" style="f">
      <char style="fr" closed="false">52:7 </char>
      <char style="ft" closed="false">ಅಥವಾ ತನ್ನ ದುಷ್ಟಕಾರ್ಯಗಳಲ್ಲಿ ಆಧಿಕ ಬಲಿಷ್ಠನಾಗುತ್ತಾ ಬಂದನು.</char>
    </note>ತನ್ನ ದುಷ್ಟತ್ವವೇ ತನಗೆ ಬಲವೆಂದು ನಂಬಿಕೊಂಡ ಮೂಢನು ಇವನೇ” ಎಂದು ಹೇಳುವರು.<verse eid="PSA 52:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8"/>ಆದರೆ ನಾನು ದೇವಾಲಯದ ಸೊಗಸಾದ ಎಣ್ಣೇ ಮರದಂತಿರುವೆನು;</para>
  <para style="q" vid="PSA 52:8">ದೇವರ ಕೃಪೆಯನ್ನು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ನಂಬಿಕೊಂಡಿರುವೆನು.<verse eid="PSA 52:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9"/>ದೇವರೇ, ನಿನ್ನ ಉಪಕಾರಕ್ಕಾಗಿ ಯಾವಾಗಲೂ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q" vid="PSA 52:9">ನಿನ್ನ ನಾಮವು ಸರ್ವೋತ್ತಮವೆಂದು ನಿನ್ನ ಭಕ್ತರ ಮುಂದೆ ಹೊಗಳುವೆನು.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s">ದುಷ್ಟನಾಸ್ತಿಕರಿಂದ ತಪ್ಪಿಸಿ ಕಾಪಾಡಬೇಕೆಂದು ಪ್ರಾರ್ಥಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಮಹಲಾತ್ ಎಂಬ ರಾಗದ ಪ್ರಕಾರ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಪದ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1"/>ದುರ್ಮತಿಗಳು, “ದೇವರಿಲ್ಲ” ಎಂದು ತಮ್ಮ ಮನಸ್ಸಿನಲ್ಲಿ ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 53:1">ಅವರು ಕೆಟ್ಟವರು; ಅಸಹ್ಯವಾದ ಅಕ್ರಮಗಳನ್ನು ನಡೆಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 53:1">ಅವರಲ್ಲಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರೇ ಇಲ್ಲ.<verse eid="PSA 53:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2"/>ಮನುಷ್ಯರಲ್ಲಿ ತನ್ನ ಸಾನ್ನಿಧ್ಯವನ್ನು ಅಪೇಕ್ಷಿಸುವ ಬುದ್ಧಿವಂತರು ಇದ್ದಾರೋ ಎಂದು</para>
  <para style="q" vid="PSA 53:2">ದೇವರು ಆಕಾಶದಿಂದ ಮನುಷ್ಯರನ್ನು ನೋಡಲಾಗಿ,<verse eid="PSA 53:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3"/>ಒಳ್ಳೆಯದನ್ನು ನಡೆಸುವವರು ಒಬ್ಬರೂ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 53:3">ಅವರೆಲ್ಲರೂ ದ್ರೋಹಿಗಳಾಗಿ ಕೆಟ್ಟುಹೋದವರೇ.<verse eid="PSA 53:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4"/>ದುಷ್ಟತ್ವವನ್ನು ನಡೆಸುವವರು ಯಾರೆಂದು ತಿಳಿಯುವುದಿಲ್ಲವೋ?</para>
  <para style="q" vid="PSA 53:4">
    <note caller="+" style="f">
      <char style="fr" closed="false">53:4 </char>
      <char style="ft" closed="false">ಅಥವಾ ಅವರು ನನ್ನ ಜನರನ್ನು ಆಹಾರವನ್ನೋ ಎಂಬಂತೆ ನುಂಗಿಬಿಡುತ್ತಾರೆ;</char>
    </note>ಅವರು ನನ್ನ ಜನರನ್ನು ಕೊಳ್ಳೆಹೊಡೆದು ಜೀವಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 53:4">ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸುವುದಿಲ್ಲ.<verse eid="PSA 53:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5"/>ಭಯಪಡುವುದಕ್ಕೆ ಕಾರಣವಿಲ್ಲದಿದ್ದರೂ,</para>
  <para style="q" vid="PSA 53:5">ಅವರು ಪಕ್ಕನೆ ಭಯಭ್ರಾಂತರಾದರು;</para>
  <para style="q" vid="PSA 53:5">
    <note caller="+" style="f">
      <char style="fr" closed="false">53:5 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಿಮಗೆ ಮುತ್ತಿಗೆಹಾಕಿದವರನ್ನು.</char>
    </note>ದುಷ್ಟರನ್ನು ದೇವರು ಸಂಹರಿಸಿ</para>
  <para style="q" vid="PSA 53:5">ಅವರ ಎಲುಬುಗಳನ್ನು ಚದರಿಸಿಬಿಟ್ಟನಲ್ಲಾ.</para>
  <para style="q" vid="PSA 53:5">
    <note caller="+" style="f">
      <char style="fr" closed="false">53:5 </char>
      <char style="ft" closed="false">ಅಥವಾ ದೇವರು ಅವರನ್ನು ಕೈಬಿಟ್ಟದ್ದರಿಂದ ನೀವು ಅವರನ್ನು ಅವಮಾನಪಡಿಸಿದ್ದೀರಿ.</char>
    </note>ದೇವರು ಅವರನ್ನು ಕೈಬಿಟ್ಟದ್ದರಿಂದ ಅವರು ಅವಮಾನಕ್ಕೊಳಗಾಗುವರು.<verse eid="PSA 53:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6"/>ಚೀಯೋನಿನಿಂದ ಇಸ್ರಾಯೇಲ್ಯರಿಗೆ ರಕ್ಷಣೆಯು ಬೇಗನೆ ಬರಲಿ.</para>
  <para style="q" vid="PSA 53:6">ದೇವರು ತನ್ನ ಭಾಗ್ಯವನ್ನು ಜನರಿಗೆ ಹಿಂದಿರುಗಿಸುವಾಗ,</para>
  <para style="q" vid="PSA 53:6">ಆತನ ಪ್ರಜೆಗಳಾಗಿರುವ ಯಾಕೋಬ ವಂಶದವರು ಉಲ್ಲಾಸಗೊಳ್ಳುವರು;</para>
  <para style="q" vid="PSA 53:6">ಇಸ್ರಾಯೇಲರು ಹರ್ಷಿಸುವರು.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s">ವೈರಿಗಳಿಂದ ರಕ್ಷಿಸಬೇಕೆಂದು ಪ್ರಾರ್ಥಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ಜಿಫ್ಯರು ಸೌಲನ ಬಳಿಗೆ ಬಂದು ದಾವೀದನು ತಮ್ಮಲ್ಲೇ ಅಡಗಿಕೊಂಡಿದ್ದಾನೆಂದು ತಿಳಿಸಿದಾಗ ದಾವೀದನು ರಚಿಸಿದ ಪದ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1"/>ದೇವರೇ, ನಿನ್ನ ನಾಮಮಹತ್ತಿನಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 54:1">ನಿನ್ನ ಪರಾಕ್ರಮದಿಂದ ನನ್ನ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸು.<verse eid="PSA 54:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2"/>ದೇವರೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಲಾಲಿಸು;</para>
  <para style="q" vid="PSA 54:2">ನನ್ನ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡು.<verse eid="PSA 54:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">54:3 </char>
      <char style="ft" closed="false">ಅಥವಾ ಅನ್ಯರು.</char>
    </note>ಗರ್ವಿಗಳು ನನ್ನ ವಿರುದ್ಧವಾಗಿ ನಿಂತಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 54:3">ಬಲಾತ್ಕಾರಿಗಳು ನನ್ನ ಪ್ರಾಣವನ್ನು ತೆಗೆಯಬೇಕೆಂದಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 54:3">ಅವರು ದೇವರನ್ನು ಲಕ್ಷಿಸುವುದೇ ಇಲ್ಲ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 54:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4"/>ಇಗೋ, ದೇವರೇ ನನಗೆ ಸಹಾಯಕನು;</para>
  <para style="q" vid="PSA 54:4">
    <note caller="+" style="f">
      <char style="fr" closed="false">54:4 </char>
      <char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ನನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡುವವರೊಂದಿಗೆ ಕರ್ತನು ಇದ್ದಾನೆ.</char>
    </note>ಕರ್ತನೇ ನನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡುವವನು.<verse eid="PSA 54:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5"/>ನನ್ನ ಕೆಡುಕಿಗೆ ಸಮಯ ನೋಡುವವರು ತಾವೇ ಕೇಡನ್ನು ಅನುಭವಿಸಲಿ.</para>
  <para style="q" vid="PSA 54:5">ನೀನು ನಂಬಿಗಸ್ತನಲ್ಲವೇ; ಅವರನ್ನು ನಿರ್ಮೂಲಮಾಡು.<verse eid="PSA 54:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6"/>ನಾನು ಸಂತೋಷದಿಂದ ನಿನಗೆ ಯಜ್ಞವನ್ನು ಸಮರ್ಪಿಸುವೆನು;</para>
  <para style="q" vid="PSA 54:6">ಉತ್ತಮೋತ್ತಮವಾಗಿರುವ ನಿನ್ನ ಹೆಸರನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 54:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7"/>ಏಕೆಂದರೆ ಯೆಹೋವನೇ, ನೀನು ನನ್ನನ್ನು ಸರ್ವ ಆಪತ್ತುಗಳಿಂದ ಬಿಡಿಸಿ,</para>
  <para style="q" vid="PSA 54:7">ನನ್ನ ಕಣ್ಣ ಮುಂದೆಯೇ ನನ್ನ ವೈರಿಗಳನ್ನು ಶಿಕ್ಷಿಸಿದ್ದಿ.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s">ದ್ರೋಹಿಗಳ ನಿರ್ಮೂಲಕ್ಕಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಪದ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1"/>ದೇವರೇ, ನನ್ನ ಮೊರೆಯನ್ನು ಲಾಲಿಸು;</para>
  <para style="q" vid="PSA 55:1">ನನ್ನ ವಿಜ್ಞಾಪನೆಗೆ ಕಿವಿಮುಚ್ಚಿಕೊಳ್ಳಬೇಡ.<verse eid="PSA 55:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2"/>ನನ್ನ ಕಡೆಗೆ ಲಕ್ಷ್ಯಕೊಟ್ಟು ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 55:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3"/>ಶತ್ರುಗಳ ಅಬ್ಬರ, ದುಷ್ಟರ ಹಿಂಸೆ ಇವುಗಳ ದೆಸೆಯಿಂದ ಪ್ರಲಾಪಿಸುವವನಾಗಿ,</para>
  <para style="q" vid="PSA 55:3">ಹೊಯ್ದಾಡುತ್ತಾ ನರಳುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 55:3">ಅವರು ನನ್ನ ಮೇಲೆ ಅಪಾಯವನ್ನು ಬರಮಾಡಿ,</para>
  <para style="q" vid="PSA 55:3">ಕೋಪದಿಂದ ನನ್ನನ್ನು ದ್ವೇಷಿಸುತ್ತಾರೆ.<verse eid="PSA 55:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4"/>ನನ್ನ ಹೃದಯವು ನೊಂದು ಬೆಂದುಹೋಗಿದೆ;</para>
  <para style="q" vid="PSA 55:4">ಮರಣಭಯವು ನನ್ನನ್ನು ಆವರಿಸಿಕೊಂಡಿದೆ.<verse eid="PSA 55:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5"/>ಅಂಜಿ ನಡುಗುತ್ತಿದ್ದೇನೆ; ದಿಗಿಲು ನನ್ನನ್ನು ಹಿಡಿದಿದೆ.<verse eid="PSA 55:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6"/>ನಾನು, “ಆಹಾ, ನನಗೆ ರೆಕ್ಕೆಗಳಿದ್ದರೆ ಪಾರಿವಾಳದಂತೆ ಹಾರಿಹೋಗಿ ಆಶ್ರಯ ಸೇರಿಕೊಳ್ಳುತ್ತಿದ್ದೆನು.<verse eid="PSA 55:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7"/>ಅವಸರದಿಂದ ಹಾನಿಕರವಾದ ಬಿರುಗಾಳಿಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು,<verse eid="PSA 55:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8"/>ದೂರ ಹೋಗಿ ಅರಣ್ಯಸ್ಥಳದಲ್ಲಿ ಪ್ರವಾಸಿಯಾಗಿರುತ್ತಿದ್ದೆನು” ಅಂದುಕೊಂಡೆನು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 55:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9"/>ಕರ್ತನೇ, ಅವರ ಭಾಷೆಯನ್ನು ತಾರುಮಾರುಮಾಡಿ ಅವರನ್ನು ಭ್ರಾಂತಿಗೊಳಿಸು.</para>
  <para style="q" vid="PSA 55:9">ಪಟ್ಟಣದಲ್ಲಿ ಕಲಹ, ಬಲಾತ್ಕಾರಗಳು ಕಾಣಬರುತ್ತವೆ.<verse eid="PSA 55:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10"/>ಅವೇ ಅದರ ಪೌಳಿಗೋಡೆಗಳ ಮೇಲೆ ಹಗಲಿರುಳು ಸುತ್ತುತ್ತಿರುವ ಕಾವಲುಗಾರರು;</para>
  <para style="q" vid="PSA 55:10">ಊರೊಳಗೆ ಕೇಡು, ತೊಂದರೆಗಳು ಪ್ರಬಲವಾಗಿವೆ.<verse eid="PSA 55:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11"/>ಅದರೊಳಗೆಲ್ಲಾ ನಾಶನವೇ;</para>
  <para style="q" vid="PSA 55:11">ದಬ್ಬಾಳಿಕೆ ಮತ್ತು ವಂಚನೆ ಅದರ ಬೀದಿಗಳಿಂದ ತೊಲಗವು.<verse eid="PSA 55:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12"/>ನನ್ನನ್ನು ದೂಷಿಸುವವನು ವೈರಿಯಾಗಿದ್ದರೆ ತಾಳಿಕೊಂಡೇನು;</para>
  <para style="q" vid="PSA 55:12">ನನ್ನನ್ನು ತಿರಸ್ಕರಿಸಿ ಉಬ್ಬಿಕೊಳ್ಳುವವನು ದ್ವೇಷಿಯಾಗಿದ್ದರೆ ಅಡಗಿಕೊಂಡೆನು.<verse eid="PSA 55:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13"/>ಆದರೆ ನೀನು ನನಗೆ ಸ್ವಕೀಯನೂ ಆಪ್ತಮಿತ್ರನೂ ಅಲ್ಲವೇ.<verse eid="PSA 55:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14"/>ನಾವು ಪರಸ್ಪರವಾಗಿ ರಸಭರಿತ ಸಂಭಾಷಣೆ ಮಾಡುತ್ತಾ</para>
  <para style="q" vid="PSA 55:14">ಭಕ್ತಸಮೂಹದೊಡನೆ ದೇವಾಲಯಕ್ಕೆ ಹೋಗುತ್ತಿದ್ದೆವಲ್ಲಾ.<verse eid="PSA 55:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15"/>ಆ ದುಷ್ಟರಿಗೆ ಮರಣವು ತಟ್ಟನೆ ಬರಲಿ; ಸಜೀವರಾಗಿಯೇ ಪಾತಾಳಕ್ಕೆ ಇಳಿದುಹೋಗಲಿ.</para>
  <para style="q" vid="PSA 55:15">ಅವರ ಮನೆಯಲ್ಲಿಯೂ, ಮನಸ್ಸಿನಲ್ಲಿಯೂ ಕೆಟ್ಟತನವೇ ತುಂಬಿದೆ.<verse eid="PSA 55:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16"/>ನಾನಂತೂ ದೇವರಾದ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡುವೆನು;</para>
  <para style="q" vid="PSA 55:16">ಆತನು ನನ್ನನ್ನು ರಕ್ಷಿಸುವನು.<verse eid="PSA 55:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17"/>ತ್ರಿಕಾಲದಲ್ಲಿಯೂ ಹಂಬಲಿಸುತ್ತಾ ಮೊರೆಯಿಡುವೆನು.</para>
  <para style="q" vid="PSA 55:17">ಆತನು ಹೇಗೂ ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳಿ<verse eid="PSA 55:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18"/>ನನ್ನ ವಿರೋಧಿಗಳು ಅನೇಕರಿದ್ದರೂ</para>
  <para style="q" vid="PSA 55:18">ಅವರು ನನ್ನನ್ನು ಮುಟ್ಟದಂತೆ ಸುರಕ್ಷಿತವಾಗಿ ಇಡುವನು.<verse eid="PSA 55:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19"/>ಅನಾದಿಕಾಲದಿಂದ ಆಸನಾರೂಢನಾಗಿರುವ ದೇವರು ಲಕ್ಷ್ಯವಿಟ್ಟು</para>
  <para style="q" vid="PSA 55:19">ಅವರನ್ನು ತಗ್ಗಿಸಿಬಿಡುವನು. <char style="qs">ಸೆಲಾ </char></para>
  <para style="q" vid="PSA 55:19">ಅವರು ತಮ್ಮ ಸುಖವು ಕದಲದೆಂದುಕೊಂಡು ದೇವರಿಗೆ ಹೆದರುವುದಿಲ್ಲ.<verse eid="PSA 55:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20"/>ಆ ದ್ರೋಹಿಯಾದರೋ ತನ್ನೊಡನೆ ಸಮಾಧಾನದಿಂದಿದ್ದವರ ಮೇಲೆ ವಿರುದ್ಧವಾಗಿ ಕೈಯೆತ್ತಿ</para>
  <para style="q" vid="PSA 55:20">ತಾನು ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಭಂಗಪಡಿಸಿದ್ದಾನೆ.<verse eid="PSA 55:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21"/>ಅವನ ಮಾತು ಬೆಣ್ಣೆಯಂತೆ ನುಣುಪು;</para>
  <para style="q" vid="PSA 55:21">ಹೃದಯವೋ ಕಲಹಮಯ.</para>
  <para style="q" vid="PSA 55:21">ಅವನ ನುಡಿಗಳು ಎಣ್ಣೆಗಿಂತ ನಯವಾಗಿದ್ದರೂ ಬಿಚ್ಚು ಕತ್ತಿಗಳೇ ಸರಿ.<verse eid="PSA 55:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22"/>ನಿನ್ನ ಚಿಂತಾಭಾರವನ್ನು ಯೆಹೋವನ ಮೇಲೆ ಹಾಕು;</para>
  <para style="q" vid="PSA 55:22">ಆತನು ನಿನ್ನನ್ನು ಉದ್ಧಾರಮಾಡುವನು.</para>
  <para style="q" vid="PSA 55:22">ನೀತಿವಂತನನ್ನು ಎಂದಿಗೂ ಕದಲಗೊಡಿಸನು.<verse eid="PSA 55:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23"/>ದೇವರೇ, ನೀನು ದುಷ್ಟರನ್ನು ಪಾತಾಳದ ಕೆಳಕ್ಕೆ ದೊಬ್ಬಿಬಿಡುವಿ.</para>
  <para style="q" vid="PSA 55:23">ಕೊಲೆಪಾತಕರೂ ವಂಚಕರೂ ನರಾಯುಷ್ಯದ ಅರ್ಧಾಂಶವಾದರೂ ಬದುಕುವುದಿಲ್ಲ.</para>
  <para style="q" vid="PSA 55:23">ನಾನಂತೂ ನಿನ್ನನ್ನೆ ನಂಬಿಕೊಂಡಿರುವೆನು.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s">ಶತ್ರುಪೀಡಿತರಾದ ಭಕ್ತರ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಯೋನತ್ ಎಲೆಮ್ ರೆಹೋಕೀಮ್ ಎಂಬ ರಾಗ; ದಾವೀದನು ಗತ್ ಎಂಬ ಊರಲ್ಲಿ ಫಿಲಿಷ್ಟಿಯರ ಕೈವಶವಾದಾಗ ರಚಿಸಿದ ಕಾವ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1"/>ದೇವರೇ, ಕರುಣಿಸು; ನರರು ನನ್ನನ್ನು ತುಳಿದುಬಿಡಬೇಕೆಂದು ಎದ್ದಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 56:1">ನನ್ನ ಎದುರಾಳಿಗಳು ಹಗಲೆಲ್ಲಾ ಯುದ್ಧಕ್ಕೆ ನಿಂತು ಬಾಧಿಸುತ್ತಾರೆ.<verse eid="PSA 56:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2"/>ಹೊಂಚುಹಾಕಿ ನನ್ನನ್ನು ನುಂಗಿಬಿಡಬೇಕೆಂದು ಯಾವಾಗಲೂ ಬಾಯ್ದೆರೆದಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 56:2">ಸೊಕ್ಕಿನಿಂದ ನನ್ನ ಮೇಲೆ ಯುದ್ಧಕ್ಕೆ ನಿಂತವರು ಎಷ್ಟೋ ಜನರು.<verse eid="PSA 56:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3"/>ನನಗೆ ಹೆದರಿಕೆಯುಂಟಾದಾಗ ನಿನ್ನನ್ನೇ ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 56:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4"/>ದೇವರ ವಾಗ್ದಾನಕ್ಕೋಸ್ಕರ ಆತನಲ್ಲಿಯೇ ಹೆಚ್ಚಳಪಡುವೆನು;</para>
  <para style="q" vid="PSA 56:4">ದೇವರನ್ನು ನಂಬಿ ನಿರ್ಭಯದಿಂದಿರುವೆನು.</para>
  <para style="q" vid="PSA 56:4">ನರಪ್ರಾಣಿಗಳು ನನಗೆ ಏನು ಮಾಡಾರು?<verse eid="PSA 56:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5"/>ಹಗಲೆಲ್ಲಾ ನನ್ನ ಮಾತುಗಳನ್ನು ಅಪಾರ್ಥಮಾಡುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 56:5">ಅವರು ಬಗೆಯುವುದೆಲ್ಲ ನನಗೆ ಕೇಡೇ.<verse eid="PSA 56:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6"/>ಅವರು ಒಟ್ಟುಗೂಡಿ ನನ್ನ ಜೀವ ತೆಗೆಯಬೇಕೆಂದು ಹೊಂಚುಹಾಕಿ,</para>
  <para style="q" vid="PSA 56:6">ನನ್ನ ಹೆಜ್ಜೆಜಾಡು ಹಿಡಿದು ಬರುತ್ತಾರೆ.<verse eid="PSA 56:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7"/>ಇಂಥ ಅನ್ಯಾಯಗಾರರು ತಪ್ಪಿಸಿಕೊಳ್ಳಬಹುದೋ?</para>
  <para style="q" vid="PSA 56:7">ದೇವರೇ, ರೌದ್ರದಿಂದ ಆ ಜನಾಂಗಗಳನ್ನು ಉರುಳಿಸಿಬಿಡು.<verse eid="PSA 56:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8"/>ನಾನು ದೇಶಭ್ರಷ್ಟನಾಗಿ ಅಲೆದಾಡಿದ್ದನ್ನು ನೀನೇ ಬಲ್ಲೆ.</para>
  <para style="q" vid="PSA 56:8">ನನ್ನ ಕಣ್ಣೀರು ನಿನ್ನ ಬುದ್ದಲಿಯಲ್ಲಿ ತುಂಬಿದೆಯಲ್ಲಾ;</para>
  <para style="q" vid="PSA 56:8">ಅದರ ವಿಷಯವಾಗಿ ನಿನ್ನ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆದದೆಯಲ್ಲಾ.<verse eid="PSA 56:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9"/>ನಾನು ಆತನಿಗೆ ಮೊರೆಯಿಡುವಾಗಲೇ ನನ್ನ ಶತ್ರುಗಳು ಫಕ್ಕನೆ ಹಿಂದಿರುಗಿ ಓಡುವರು;</para>
  <para style="q" vid="PSA 56:9">
    <note caller="+" style="f">
      <char style="fr" closed="false">56:9 </char>
      <char style="ft" closed="false">ಅಥವಾ ನನಗೆ ಇದು ತಿಳಿದಿದೆ ಯಾಕೆಂದರೆ ದೇವರು ನನ್ನ ಕಡೆಯಲ್ಲಿದ್ದಾನೆ.</char>
    </note>ದೇವರು ನನ್ನ ಸಂಗಡ ಇರುವುದು ನಿಶ್ಚಯ.<verse eid="PSA 56:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10"/>ದೇವರ ವಾಗ್ದಾನಗಳಲ್ಲಿ ಹಾಡಿ ಹರಸುತ್ತೇನೆ.</para>
  <para style="q" vid="PSA 56:10">ಯೆಹೋವನ ವಾಗ್ದಾನಗಳಲ್ಲಿ ಹಾಡಿ ಹರಸುತ್ತೇನೆ.<verse eid="PSA 56:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11"/>ದೇವರನ್ನು ನಂಬಿ ನಿರ್ಭಯದಿಂದಿರುವೆನು;</para>
  <para style="q" vid="PSA 56:11">ನರಪ್ರಾಣಿಗಳು ನನಗೆ ಏನು ಮಾಡಾರು?<verse eid="PSA 56:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12"/>ದೇವರೇ, ನಿನಗೆ ಹೊತ್ತ ಹರಕೆಗಳನ್ನು ನಾನು ಸಲ್ಲಿಸುವೆನು;</para>
  <para style="q" vid="PSA 56:12">ಕೃತಜ್ಞತಾ ಯಜ್ಞಗಳನ್ನು ನಿನಗೆ ಸಮರ್ಪಿಸುವೆನು.<verse eid="PSA 56:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13"/>ಏಕೆಂದರೆ, ನಾನು ಜೀವದಿಂದ ಬೆಳಕಿನಲ್ಲಿದ್ದು ನಿನಗೆ ನಡೆದುಕೊಳ್ಳಬೇಕೆಂದು</para>
  <para style="q" vid="PSA 56:13">ನೀನು ನನ್ನ ಪ್ರಾಣವನ್ನು ಮರಣಕ್ಕೆ ತಪ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 56:13">ನನ್ನ ಪಾದಗಳನ್ನು ಎಡವಿಬೀಳದಂತೆ ಕಾಪಾಡಿದ್ದಿ.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s">ಶತ್ರುಬಾಧಿತನಾದ ಸದ್ಭಕ್ತನ ವಿಜ್ಞಾಪನೆಯೂ ಸ್ತೋತ್ರವೂ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು. ಅಲ್ತಷ್ಖೇತೆಂಬ ರಾಗ; ದಾವೀದನು ಸೌಲನ ಭೀತಿಯಿಂದ ಓಡಿಹೋಗಿ ಗುಹೆಯಲ್ಲಿ ಅಡಗಿಕೊಂಡಿದ್ದಾಗ ರಚಿಸಿದ ಕಾವ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1"/>ದೇವರೇ, ಕರುಣಿಸು, ನನ್ನನ್ನು ಕರುಣಿಸು.</para>
  <para style="q" vid="PSA 57:1">ನೀನೇ ನನ್ನ ಆಶ್ರಯಸ್ಥಾನವಲ್ಲವೇ!</para>
  <para style="q" vid="PSA 57:1">ಆಪತ್ತುಗಳು ಕಳೆದುಹೋಗುವ ತನಕ ನಿನ್ನ ರೆಕ್ಕೆಗಳ ಮರೆಯನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 57:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2"/>ಪರಾತ್ಪರನಾದ ದೇವರಿಗೆ ಮೊರೆಯಿಡುವೆನು,</para>
  <para style="q" vid="PSA 57:2">ನನ್ನ ಕಾರ್ಯವನ್ನು ಸಫಲಮಾಡುವ ದೇವರನ್ನು ಕೂಗಿ ಕರೆಯುವೆನು.<verse eid="PSA 57:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3"/>ಆತನು ಪರಲೋಕದಿಂದ ಆಲಿಸಿ,</para>
  <para style="q" vid="PSA 57:3">ನಿಂದಕರ ಮಾತಿನಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸುವನು; <char style="qs">ಸೆಲಾ </char></para>
  <para style="q" vid="PSA 57:3">ತನ್ನ ಪ್ರೀತಿಯನ್ನು ಮತ್ತು ಸತ್ಯತೆಯನ್ನೂ ತೋರ್ಪಡಿಸುವನು.<verse eid="PSA 57:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4"/>ನಾನು ಸಿಂಹಗಳಂತಿರುವ ಶತ್ರುಗಳ ಮಧ್ಯದಲ್ಲಿ ಸಿಕ್ಕಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 57:4">ದುರಾಶೆಯಿಂದ ಕಬಳಿಸುವಂತಹ<note caller="+" style="f"><char style="fr" closed="false">57:4 </char><char style="fq" closed="false">ದುರಾಶೆಯಿಂದ ಕಬಳಿಸುವಂತಹ </char><char style="ft" closed="false">ಅಥವಾ ಬೆಂಕಿಕಾರುವ. </char></note> ಮನುಷ್ಯರ ನಡುವೆ ಬಿದ್ದಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 57:4">ಅವರ ಹಲ್ಲುಗಳು ಈಟಿ ಮತ್ತು ಬಾಣಗಳಂತಿವೆ,</para>
  <para style="q" vid="PSA 57:4">ನಾಲಿಗೆಗಳು ಹದವಾದ ಕತ್ತಿಗಳೇ.<verse eid="PSA 57:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5"/>ದೇವರೇ, ಮೇಲಣ ಲೋಕಗಳಲ್ಲಿ ನಿನ್ನ ಪ್ರಭಾವವು ಮೆರೆಯಲಿ;</para>
  <para style="q" vid="PSA 57:5">ಭೂಮಂಡಲದ ಮೇಲೆಲ್ಲಾ ನಿನ್ನ ಮಹತ್ವವು ಹಬ್ಬಲಿ.<verse eid="PSA 57:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6"/>ನನ್ನ ಕಾಲಿಗೆ ಬಲೆಯನ್ನು ಹಾಸಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 57:6">ನನ್ನ ಪ್ರಾಣವು ಕುಂದಿಹೋಯಿತು.</para>
  <para style="q" vid="PSA 57:6">ನನ್ನ ದಾರಿಯಲ್ಲಿ ಕುಣಿಯನ್ನು ಅಗೆದರು;</para>
  <para style="q" vid="PSA 57:6">ತಾವೇ ಅದರಲ್ಲಿ ಬಿದ್ದುಹೋದರು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 57:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7"/>ದೇವರೇ, ನನ್ನ ಹೃದಯವು ಸ್ಥಿರವಾಗಿದೆ, ಸ್ಥಿರವಾಗಿದೆ.</para>
  <para style="q" vid="PSA 57:7">ನಾನು ವಾದ್ಯಗಳನ್ನು ನುಡಿಸುತ್ತಾ ಹಾಡುವೆನು.<verse eid="PSA 57:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8"/>ನನ್ನ ಮನವೇ, ಚುರುಕಾಗು; ಸ್ವರಮಂಡಲವೇ, ಕಿನ್ನರಿಯೇ, ಎಚ್ಚರವಾಗಿರಿ.</para>
  <para style="q" vid="PSA 57:8">ಸಂಕೀರ್ತನೆಯಿಂದ ಉದಯವನ್ನು ಎದುರುಗೊಳ್ಳುವೆನು.<verse eid="PSA 57:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9"/>ಕರ್ತನೇ, ಜನಾಂಗಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q" vid="PSA 57:9">ಸರ್ವದೇಶದವರೊಳಗೆ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 57:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10"/>ಏಕೆಂದರೆ ನಿನ್ನ ಕೃಪೆಯು ಆಕಾಶವನ್ನೂ,</para>
  <para style="q" vid="PSA 57:10">ನಿನ್ನ ಸತ್ಯತೆಯು ಮುಗಿಲನ್ನೂ ಮುಟ್ಟುವಷ್ಟು ದೊಡ್ಡವಾಗಿವೆ.<verse eid="PSA 57:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11"/>ದೇವರೇ, ಮೇಲಣ ಲೋಕಗಳಲ್ಲಿ ನಿನ್ನ ಪ್ರಭಾವವು ಮೆರೆಯಲಿ;</para>
  <para style="q" vid="PSA 57:11">ಭೂಮಂಡಲದ ಮೇಲೆಲ್ಲಾ ನಿನ್ನ ಮಹತ್ವವು ಹಬ್ಬಲಿ.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s">ಅನ್ಯಾಯಾಧಿಕಾರಿಗಳಿಗೆ ಪ್ರತಿದಂಡನೆಯಾಗಬೇಕೆಂದು ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಅಲ್ತಷ್ಖೇತೆಂಬ ರಾಗ; ದಾವೀದನ ಕಾವ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1"/>ಅಧಿಕಾರಿಗಳೇ<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="fq" closed="false">ಅಧಿಕಾರಿಗಳೇ </char><char style="ft" closed="false">ಅಥವಾ ದೇವರುಗಳೇ ಅಥವಾ ಮೂಕರು.</char></note>, ನೀವು ಕೊಡುವ ತೀರ್ಪುಗಳು ನೀತಿಗನುಸಾರವಾಗಿವೆಯೋ?</para>
  <para style="q" vid="PSA 58:1">ಜನರ ವ್ಯಾಜ್ಯಗಳನ್ನು ನ್ಯಾಯಯುತವಾಗಿ ಬಗೆಹರಿಸುತ್ತಿರೋ?<verse eid="PSA 58:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2"/>ನಿಮ್ಮ ಮನಸ್ಸಿನ ಕಲ್ಪನೆಯೆಲ್ಲಾ ಕೆಟ್ಟತನವೇ;</para>
  <para style="q" vid="PSA 58:2">ನೀವು ದೇಶದವರಿಗೆ ಅನ್ಯಾಯವನ್ನೇ ತೂಗಿಕೊಡುವವರಾಗಿದ್ದೀರಲ್ಲಾ.<verse eid="PSA 58:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3"/>ದುಷ್ಟರು ಜನ್ಮದಿಂದಲೇ ಧರ್ಮಭ್ರಷ್ಟರು;</para>
  <para style="q" vid="PSA 58:3">ಅವರು ಹುಟ್ಟಿದಂದಿನಿಂದ ಸುಳ್ಳುಗಾರರಾಗಿ ದಾರಿ ತಪ್ಪಿದವರು.<verse eid="PSA 58:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4"/>ಅವರು ಸರ್ಪದಂತೆ ವಿಷಭರಿತರು.<verse eid="PSA 58:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5"/>ಜಾಣತನದಿಂದ ಮಂತ್ರಿಸುವ ಹಾವಾಡಿಗರ ನಾಗಸ್ವರಕ್ಕೂ ಮರುಳಾಗದ</para>
  <para style="q" vid="PSA 58:5">ಅಥವಾ ಅದಕ್ಕೆ ಕಿವಿಗೊಡದ ಕಳ್ಳ ಹಾವಿನಂತೆ ಇರುತ್ತಾರೆ.<verse eid="PSA 58:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6"/>ದೇವರೇ, ಅವರ ಹಲ್ಲುಗಳನ್ನು ಮುರಿದುಬಿಡು;</para>
  <para style="q" vid="PSA 58:6">ಯೆಹೋವನೇ, ಪ್ರಾಯದ ಸಿಂಹಗಳ ಕೋರೆ ಹಲ್ಲುಗಳನ್ನು ಕಿತ್ತುಹಾಕು.<verse eid="PSA 58:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7"/>ಕ್ಷಣದಲ್ಲಿ ಹರಿದು ಕಾಣದೆ ಹೋಗುವ ನೀರಿನಂತೆ ಅವರು ಮಾಯವಾಗಲಿ;</para>
  <para style="q" vid="PSA 58:7">ಬಾಣ ತಾಗಿತೋ ಎಂಬಂತೆ ಅವರು ಬೀಳಲಿ.<verse eid="PSA 58:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8"/>ಒಣಗಿ ಸತ್ತ ಬಸವನಹುಳದಂತೆ ನಿರ್ನಾಮವಾಗಲಿ;</para>
  <para style="q" vid="PSA 58:8">ಗರ್ಭವಿಳಿದ ಪಿಂಡದಂತೆ ಸೂರ್ಯನನ್ನು ನೋಡದೆ ಹೋಗಲಿ.<verse eid="PSA 58:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9"/>ಇನ್ನೂ ಹಸಿರಿರುರುವಾಗಲೇ ಒಲೆಗೆ ಹಾಕಿದ ಮುಳ್ಳಿನ ಕೊಂಪೆಯನ್ನು ಬಿರುಗಾಳಿಯು ಹಾರಿಸಿಬಿಡುವಂತೆ</para>
  <para style="q" vid="PSA 58:9">ದೇವರ ಉಗ್ರಕೋಪವು ಅವರನ್ನು ನಿಶ್ಶೇಷಮಾಡಲಿ.<verse eid="PSA 58:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10"/>ದುಷ್ಟರಿಗಾಗುವ ಪ್ರತಿದಂಡನೆಯನ್ನು ಭಕ್ತರು ನೋಡಿ ಹರ್ಷಿಸಿ,</para>
  <para style="q" vid="PSA 58:10">ಅವರ ರಕ್ತದಲ್ಲಿ ಕಾಲಾಡಿಸುವರು.<verse eid="PSA 58:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11"/>ನೀತಿವಂತನಿಗೆ ಫಲವುಂಟೆಂತಲೂ,</para>
  <para style="q" vid="PSA 58:11">ಲೋಕದಲ್ಲಿ ನ್ಯಾಯಸ್ಥಾಪಕನಾದ ದೇವರು ಇದ್ದಾನೆಂತಲೂ ಸರ್ವರು ಒಪ್ಪಿಕೊಳ್ಳುವರು.<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s">ಹಿಂಸೆಗೊಳಗಾದ ನಿರಪರಾಧಿಯ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಅಲ್ತಷ್ಖೇತೆಂಬ ರಾಗ; ಸೌಲನ ಕಡೆಯವರು ದಾವೀದನ ಜೀವತೆಗೆಯಬೇಕೆಂದು ಅವನ ಮನೆಯ ಸುತ್ತಲೂ ಹೊಂಚುಹಾಕುತ್ತಿದ್ದಾಗ ಅವನು ರಚಿಸಿದ ಕಾವ್ಯ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1"/>ನನ್ನ ದೇವರೇ, ಶತ್ರುಗಳ ಕೈಯಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು;</para>
  <para style="q" vid="PSA 59:1">ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಎದ್ದಿರುವವರಿಗೆ ನನ್ನನ್ನು ತಪ್ಪಿಸಿ ಭದ್ರಸ್ಥಳದಲ್ಲಿರಿಸು.<verse eid="PSA 59:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2"/>ಕೆಡುಕರಿಂದ ಬಿಡಿಸು; ಕೊಲೆಪಾತಕರಿಂದ ನನ್ನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 59:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3"/>ಇಗೋ, ಅವರು ನನ್ನ ಜೀವಕ್ಕೆ ಹೊಂಚುಹಾಕುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 59:3">ಬಲಿಷ್ಠರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಗುಂಪುಕೂಡಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 59:3">ಯೆಹೋವನೇ, ನಾನು ನಿರ್ದೋಷಿಯೂ ನಿರಪರಾಧಿಯೂ ಅಲ್ಲವೇ!<verse eid="PSA 59:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4"/>ನಿಷ್ಕಾರಣವಾಗಿ ನನ್ನ ಮೇಲೆ ಬೀಳಲು ಮುತ್ತಿಗೆ ಹಾಕಿ ನಿಂತಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 59:4">ಎದ್ದು ಬಂದು ಪರಾಂಬರಿಸಿ ನನಗೆ ಸಹಾಯಮಾಡು.<verse eid="PSA 59:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನೇ, ಇಸ್ರಾಯೇಲರ ದೇವರೇ,</para>
  <para style="q" vid="PSA 59:5">ನೀನು ಎಚ್ಚರವಾಗಿ ಎಲ್ಲಾ ಅನ್ಯಜನಾಂಗಗಳನ್ನು ದಂಡಿಸು.</para>
  <para style="q" vid="PSA 59:5">ದುಷ್ಟದ್ರೋಹಿಗಳಲ್ಲಿ ಒಬ್ಬನಿಗೂ ದಯತೋರಿಸಬೇಡ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 59:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6"/>ಅವರು ಪ್ರತಿಸಾಯಂಕಾಲವೂ ಬಂದು ಬಂದು</para>
  <para style="q" vid="PSA 59:6">ನಾಯಿಗಳಂತೆ ಗುರುಗುಟ್ಟುತ್ತಾ ಪಟ್ಟಣವನ್ನೆಲ್ಲಾ ಸುತ್ತುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 59:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7"/>ಇಗೋ, ಅವರ ಬಾಯಿಗಳು ಎಷ್ಟೋ ಮಾತುಗಳನ್ನು ಕಕ್ಕುತ್ತವೆ;</para>
  <para style="q" vid="PSA 59:7">ಅವೆಲ್ಲಾ ಹರಿತವಾದ ಕತ್ತಿಗಳಂತಿವೆ,</para>
  <para style="q" vid="PSA 59:7">ಅವರು, “ನಮ್ಮನ್ನು ಕೇಳುವವರು ಯಾರು?” ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 59:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8"/>ಯೆಹೋವನೇ, ನೀನಾದರೋ ಅವರನ್ನು ನೋಡಿ ನಗುವಿ;</para>
  <para style="q" vid="PSA 59:8">ಎಲ್ಲಾ ಅನ್ಯಜನಾಂಗಗಳನ್ನು ಪರಿಹಾಸ್ಯಮಾಡುವಿ.<verse eid="PSA 59:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9"/>ನನ್ನ ಬಲವೇ, ನಿನ್ನನ್ನು ನಿರೀಕ್ಷಿಸುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 59:9">ನನ್ನ ಆಶ್ರಯದುರ್ಗವು ದೇವರೇ.<verse eid="PSA 59:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10"/>ನನ್ನ ದೇವರು ತನ್ನ ಮಹಾ ಪ್ರೀತಿಯಿಂದ ನನಗೆ ಸಹಾಯಮಾಡುವನು;</para>
  <para style="q" vid="PSA 59:10">ನನ್ನ ವಿರೋಧಿಗಳಿಗುಂಟಾದ ಶಿಕ್ಷೆಯನ್ನು ನಾನು ನೋಡುವಂತೆ ಮಾಡುವನು.<verse eid="PSA 59:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11"/>ಕರ್ತನೇ, ನಮ್ಮ ಗುರಾಣಿಯೇ, ಅವರನ್ನು ಫಕ್ಕನೆ ಸಂಹರಿಸಬೇಡ.</para>
  <para style="q" vid="PSA 59:11">ನನ್ನ ಜನರು ಮರೆತುಬಿಡದ ಹಾಗೆ ಅವರು ಉಳಿಯಲಿ.</para>
  <para style="q" vid="PSA 59:11">ನಿನ್ನ ಸೇನಾಬಲದಿಂದ ಚದುರಿಸಿ, ಭ್ರಾಂತಿಯಿಂದ ಅಲೆದಾಡಿಸಿ ಅವರನ್ನು ಕೆಡವಿಬಿಡು.<verse eid="PSA 59:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12"/>ಅವರ ಬಾಯಿಂದ ಬರುವುದೆಲ್ಲಾ ಪಾಪದ ಮಾತೇ.</para>
  <para style="q" vid="PSA 59:12">ಅವರ ಅಹಂಕಾರದಿಂದಲೇ ಅವರು ಸಿಕ್ಕಿಬೀಳಲಿ.<verse eid="PSA 59:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13"/>ಅವರು ನುಡಿಯುವ ಶಾಪಕ್ಕಾಗಿಯೂ ಸುಳ್ಳಿಗಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 59:13">ಅವರನ್ನು ರೌದ್ರದಿಂದ ಸಂಹರಿಸಿ ನಿರ್ನಾಮಗೊಳಿಸು.</para>
  <para style="q" vid="PSA 59:13">
    <note caller="+" style="f">
      <char style="fr" closed="false">59:13 </char>
      <char style="ft" closed="false">ಅಥವಾ ಇಸ್ರಾಯೇಲ ದೇಶವನ್ನು.</char>
    </note>ಯಾಕೋಬನ ವಂಶದವರನ್ನು ಆಳುವವನು ದೇವರೇ ಎಂಬುದು,</para>
  <para style="q" vid="PSA 59:13">ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಗೊತ್ತಾಗಲಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 59:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14"/>ಅವರು ಪ್ರತಿಸಾಯಂಕಾಲವೂ ಬಂದು ಬಂದು,</para>
  <para style="q" vid="PSA 59:14">ನಾಯಿಗಳಂತೆ ಗುರುಗುಟ್ಟುತ್ತಾ ಪಟ್ಟಣವನ್ನೆಲ್ಲಾ ಸುತ್ತುತ್ತಾ ಇದ್ದಾರೆ.<verse eid="PSA 59:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15"/>ಆಹಾರಕ್ಕಾಗಿ ಅತ್ತಿತ್ತ ತಿರುಗುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 59:15">ಹೊಟ್ಟೆಗಿಲ್ಲದಿದ್ದರೆ ಗುಣುಗುಟ್ಟುತ್ತಾರೆ<note caller="+" style="f"><char style="fr" closed="false">59:15 </char><char style="fq" closed="false">ಗುಣುಗುಟ್ಟುತ್ತಾರೆ </char><char style="ft" closed="false">ಅಥವಾ ರಾತ್ರಿಯೆಲ್ಲಾ ಗುಣುಗುಟ್ಟುತ್ತಾರೆ.</char></note>.<verse eid="PSA 59:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16"/>ನಾನಾದರೋ, ಇಕ್ಕಟ್ಟಿನ ಕಾಲದಲ್ಲಿ</para>
  <para style="q" vid="PSA 59:16">ಆಶ್ರಯವೂ ದುರ್ಗವೂ ಆಗಿರುವ ನಿನ್ನ ಬಲವನ್ನು ಹಾಡಿ ಹೊಗಳುವೆನು;</para>
  <para style="q" vid="PSA 59:16">ಪ್ರಾತಃಕಾಲದಲ್ಲಿ ನಿನ್ನ ಪ್ರೇಮವನ್ನು ಉಲ್ಲಾಸದಿಂದ ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 59:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17"/>ನನ್ನ ಬಲವೇ, ನಿನ್ನನ್ನು ಹಾಡಿಹರಸುವೆನು,</para>
  <para style="q" vid="PSA 59:17">ನನ್ನ ಆಶ್ರಯದುರ್ಗವೂ ಕೃಪಾನಿಧಿಯೂ ದೇವರೇ.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="s">ಅಪಜಯ ಹೊಂದಿದವರು ಜಯಕ್ಕಾಗಿ ಪ್ರಾರ್ಥಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಷೂಷನ್ ಎದೂತೆಂಬ ರಾಗ; ದಾವೀದನು ಅರಾಮ್ ರಾಜ್ಯಗಳ ಸಂಗಡ ಯುದ್ಧ ಮಾಡುವಷ್ಟರೊಳಗೆ ಯೋವಾಬನು ಹಿಂದಿರುಗಿ ಹೋಗಿ ಉಪ್ಪಿನ ತಗ್ಗಿನಲ್ಲಿ ಹನ್ನೆರಡು ಸಾವಿರ ಎದೋಮ್ಯರನ್ನು ಹೊಡೆದಾಗ ದಾವೀದನು ರಚಿಸಿದ ಕಾವ್ಯ. ಬಾಯಿಪಾಠ ಮಾಡಿಸತಕ್ಕದ್ದು.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1"/>ದೇವರೇ, ನೀನು ನಮ್ಮನ್ನು ಕೋಪದಿಂದ ತಳ್ಳಿ ಕೆಡವಿಬಿಟ್ಟಿದ್ದೀ;</para>
  <para style="q" vid="PSA 60:1">ನಮ್ಮ ರಕ್ಷಣಾ ಸಾಧನವನ್ನು ಮುರಿದುಬಿಟ್ಟಿದ್ದೀ;</para>
  <para style="q" vid="PSA 60:1">ನಮ್ಮನ್ನು ಪುನಃ ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲಿಸು.<verse eid="PSA 60:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2"/>ನೀನು ದೇಶವನ್ನು ಕಂಪನಗೊಳಿಸಿ ಒಡೆದುಬಿಟ್ಟಿದ್ದೀ;</para>
  <para style="q" vid="PSA 60:2">ಅದು ನಡುಗುತ್ತಿರುವುದಲ್ಲಾ.</para>
  <para style="q" vid="PSA 60:2">ಅದರ ಒಡಕುಗಳನ್ನು ಸರಿಮಾಡು;<verse eid="PSA 60:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3"/>ನಿನ್ನ ಜನರನ್ನು ಸಂಕಟಕ್ಕೆ ಗುರಿಪಡಿಸಿದ್ದೀ;</para>
  <para style="q" vid="PSA 60:3">ನೀನು ನಮಗೆ ರೋಷವೆಂಬ ಪಾತ್ರೆಯಿಂದ ಪಾನಮಾಡಿಸಿದಿ.<verse eid="PSA 60:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4"/>ನೀನು ನಿನ್ನ ಭಕ್ತರಿಗೆ ಧ್ವಜವನ್ನು ಕೊಟ್ಟಿದ್ದು,</para>
  <para style="q" vid="PSA 60:4">ಆದ್ದರಿಂದ ಅವರು ಬಿಲ್ಲಿನಿಂದ<note caller="+" style="f"><char style="fr" closed="false">60:4 </char><char style="fq" closed="false">ಬಿಲ್ಲಿನಿಂದ </char><char style="ft" closed="false">ಅಥವಾ ಸತ್ಯದ ನಿಮಿತ್ತ ಅವರು ತಪ್ಪಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.</char></note> ತಪ್ಪಿಸಿಕೊಳ್ಳಬಹುದು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 60:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5"/>ನಿನ್ನ ಪ್ರಿಯರಾದ ನಮ್ಮ ಮೊರೆಯನ್ನು ಲಾಲಿಸಿ ರಕ್ಷಿಸು.</para>
  <para style="q" vid="PSA 60:5">ನಿನ್ನ ಭುಜಬಲದಿಂದ ನಮ್ಮನ್ನು ಜಯಗೊಳಿಸು.<verse eid="PSA 60:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6"/>ದೇವರು ತನ್ನ ಪವಿತ್ರಸ್ಥಳದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">60:6 </char><char style="fq" closed="false">ಪವಿತ್ರಸ್ಥಳದಲ್ಲಿ </char><char style="ft" closed="false">ಅಥವಾ ಪವಿತ್ರತ್ವವನ್ನು ಸಾಕ್ಷಿಯಾಗಿ. </char></note> ನುಡಿದಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 60:6">ಜಯಘೋಷಮಾಡುವೆನು;</para>
  <para style="q" vid="PSA 60:6">ಶೆಖೆಮ್ ಪ್ರದೇಶವನ್ನು ಹಂಚುವೆನು.</para>
  <para style="q" vid="PSA 60:6">ಸುಖೋತ್ ಬಯಲನ್ನು ಅಳೆದುಕೊಡುವೆನು.<verse eid="PSA 60:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7"/>ಗಿಲ್ಯಾದ್ ಸೀಮೆಯೂ ಮತ್ತು ಮನಸ್ಸೆಯ ದೇಶವೂ ನನ್ನವು;</para>
  <para style="q" vid="PSA 60:7">ಎಫ್ರಾಯೀಮ್ ಗೋತ್ರವು ನನಗೆ ಶಿರಸ್ತ್ರಾಣ.</para>
  <para style="q" vid="PSA 60:7">ನನ್ನ ರಾಜದಂಡವು ಯೆಹೂದ ಕುಲವೇ.<verse eid="PSA 60:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8"/>ಮೋವಾಬ್ ಪ್ರದೇಶವು ನನ್ನ ಸ್ನಾನಪಾತ್ರೆಯು;</para>
  <para style="q" vid="PSA 60:8">ಎದೋಮ್ ಸೀಮೆ ನನ್ನ ಪಾದರಕ್ಷೆಗಳನ್ನು ಬಿಡುವ ಸ್ಥಳ.</para>
  <para style="q" vid="PSA 60:8">
    <note caller="+" style="f">
      <char style="fr" closed="false">60:8 </char>
      <char style="ft" closed="false">ಓ ಫಿಲಿಷ್ಟಿಯ ದೇಶವೇ ನೀನು ನನ್ನ ವಿಷಯವಾಗಿ ಜಯಘೋಷ ಮಾಡುವಿ.</char>
    </note>ಫಿಲಿಷ್ಟಿಯ ದೇಶವೇ ನಾನು ನಿನ್ನ ಮೇಲೆ ಜಯಹೊಂದಿ ನಿನ್ನ ವಿಷಯವಾಗಿ ಜಯಘೋಷ ಮಾಡುವೆನು.<verse eid="PSA 60:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9"/>ಕೋಟೆಕೊತ್ತಲುಗಳುಳ್ಳ ನಗರಕ್ಕೆ</para>
  <para style="q" vid="PSA 60:9">ನನ್ನನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗುವವರು ಯಾರು?</para>
  <para style="q" vid="PSA 60:9">ಎದೋಮ್ ಪ್ರಾಂತ್ಯದೊಳಗೆ ನನ್ನನ್ನು ಸೇರಿಸುವವರು ಯಾರು?<verse eid="PSA 60:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10"/>ದೇವರೇ, ನೀನು ನಮ್ಮ ಸೈನ್ಯಗಳ ಸಂಗಡ ಬರಲಿಲ್ಲವಲ್ಲಾ!</para>
  <para style="q" vid="PSA 60:10">ದೇವರೇ, ನಮ್ಮನ್ನು ಕೈಬಿಟ್ಟಿರುವೆಯಾ?<verse eid="PSA 60:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11"/>ನಮಗೆ ಕೈನೀಡಿ ಶತ್ರುಬಾಧೆಯಿಂದ ಪಾರುಮಾಡು;</para>
  <para style="q" vid="PSA 60:11">ಮನುಷ್ಯರ ಸಹಾಯವು ವ್ಯರ್ಥ.<verse eid="PSA 60:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12"/>ದೇವರ ಸಹಾಯದಿಂದ ಶೂರಕೃತ್ಯಗಳನ್ನು ನಡೆಸುವೆವು;</para>
  <para style="q" vid="PSA 60:12">ನಮ್ಮ ವೈರಿಗಳನ್ನು ತುಳಿದುಬಿಡುವವನು ಆತನೇ.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s">ಸದ್ಭಕ್ತರು ತಮಗಾಗಿಯೂ ತಮ್ಮ ರಾಜನಿಗಾಗಿಯೂ ಮಾಡುವ ವಿಜ್ಞಾಪನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1"/>ದೇವರೇ, ನನ್ನ ಕೂಗನ್ನು ಕೇಳಿ ನನ್ನ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಡು.<verse eid="PSA 61:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2"/>ನಾನು ಎದೆಗುಂದಿದವನಾಗಿ ಭೂಮಿಯ ಕಡೆಯ ಭಾಗದಿಂದ ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 61:2">ನಾನು ಹತ್ತಲಾರದ ಆಶ್ರಯಗಿರಿಯ ಮೇಲೆ ನನ್ನನ್ನು ಹತ್ತಿಸು.<verse eid="PSA 61:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3"/>ನೀನು ನನಗೆ ಶರಣನೂ,</para>
  <para style="q" vid="PSA 61:3">ಶತ್ರುಗಳಿಂದ ತಪ್ಪಿಸುವ ಭದ್ರವಾದ ಬುರುಜು ಆಗಿದ್ದೀ.<verse eid="PSA 61:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4"/>ನನಗೆ ನಿರಂತರವೂ ನಿನ್ನ ಗುಡಾರದಲ್ಲಿ ಬಿಡಾರವಾಗಲಿ;</para>
  <para style="q" vid="PSA 61:4">ನಿನ್ನ ರೆಕ್ಕೆಗಳ ಮರೆಯನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವಂತೆ ಅನುಗ್ರಹಿಸು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 61:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5"/>ದೇವರೇ, ನೀನು ನನ್ನ ಹರಕೆಗಳಿಗೆ ಲಕ್ಷ್ಯಕೊಟ್ಟಿದ್ದೀ;</para>
  <para style="q" vid="PSA 61:5">ನಿನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಿಗೆ ಸಿಕ್ಕತಕ್ಕ ಬಾಧ್ಯತೆಯನ್ನು ನನಗೂ ದಯಪಾಲಿಸಿದ್ದೀ.<verse eid="PSA 61:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6"/>ಅರಸನು ದೀರ್ಘಕಾಲ ಬಾಳುವಂತೆ ಅನುಗ್ರಹಿಸು;</para>
  <para style="q" vid="PSA 61:6">ಅವನ ಆಯಸ್ಸು ತಲತಲಾಂತರಗಳವರೆಗೆ ವೃದ್ಧಿಯಾಗಲಿ.<verse eid="PSA 61:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7"/>ಅವನು ನಿನ್ನ ಸಾನ್ನಿಧ್ಯವನ್ನು ಪಡೆದು,</para>
  <para style="q" vid="PSA 61:7">ಸದಾಕಾಲವೂ ಸಿಂಹಾಸನಾರೂಢನಾಗಿರಲಿ;</para>
  <para style="q" vid="PSA 61:7">ನಿನ್ನ ಪ್ರೇಮ ಮತ್ತು ಸತ್ಯತೆಗಳು ಅವನನ್ನು ಕಾಯಲಿ.<verse eid="PSA 61:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8"/>ಹೀಗಾದರೆ ನಾನು ಪ್ರತಿದಿನವೂ ನನ್ನ ಹರಕೆಗಳನ್ನು ಸಲ್ಲಿಸುವವನಾಗಿ,</para>
  <para style="q" vid="PSA 61:8">ನಿನ್ನ ನಾಮವನ್ನು ಸದಾ ಸ್ಮರಿಸಿ ಕೀರ್ತಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s">ದೇವರ ಆಶ್ರಯದಲ್ಲಿರುವವರ ಮನಶ್ಯಾಂತಿ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಯೆದುತೂನನ ರೀತಿಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1"/>ನನ್ನ ಮನಸ್ಸು ದೇವರನ್ನೇ ನಂಬಿ ಶಾಂತವಾಗಿರುವುದು.</para>
  <para style="q" vid="PSA 62:1">ನನ್ನ ರಕ್ಷಣೆಯು ಆತನಿಂದಲೇ.<verse eid="PSA 62:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2"/>ಆತನೇ ನನಗೆ ಶರಣನೂ, ರಕ್ಷಕನೂ ಮತ್ತು ದುರ್ಗವೂ;</para>
  <para style="q" vid="PSA 62:2">ನಾನು ಕದಲಿದರೂ ಬೀಳೆನು.<verse eid="PSA 62:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3"/>ನೀವೆಲ್ಲರೂ ಒಬ್ಬ ಪುರುಷನ ಮೇಲೆ ಬಿದ್ದು,</para>
  <para style="q" vid="PSA 62:3">ಅವನು ಬಾಗಿದ ಗೋಡೆಯ ಹಾಗೆ ಮತ್ತು ಕುಸಿದ ಪ್ರಾಕಾರವೋ ಎಂಬಂತೆ</para>
  <para style="q" vid="PSA 62:3">ಅವನನ್ನು ಹೊಡೆದು ಕೆಡವಬೇಕೆಂದಿರುವುದು ಇನ್ನೆಷ್ಟರವರೆಗೆ?<verse eid="PSA 62:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4"/>ಅವನನ್ನು ಉನ್ನತಸ್ಥಾನದಿಂದ ದೊಬ್ಬುವುದೇ ಅವರ ಆಲೋಚನೆ.</para>
  <para style="q" vid="PSA 62:4">ಸುಳ್ಳಾಡುವುದು ಅವರಿಗೆ ಅತಿಸಂತೋಷ;</para>
  <para style="q" vid="PSA 62:4">ಬಾಯಿಂದ ಹರಸಿ ಮನಸ್ಸಿನಿಂದ ಶಪಿಸುತ್ತಾರೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 62:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5"/>ನನ್ನ ಮನವೇ, ದೇವರನ್ನೇ ನಂಬಿ ಶಾಂತವಾಗಿರು.</para>
  <para style="q" vid="PSA 62:5">ನನ್ನ ನಿರೀಕ್ಷೆಯು ನೆರವೇರುವುದು ಆತನಿಂದಲೇ.<verse eid="PSA 62:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6"/>ಆತನೇ ನನಗೆ ಶರಣನೂ, ರಕ್ಷಕನೂ ಮತ್ತು ದುರ್ಗವೂ;</para>
  <para style="q" vid="PSA 62:6">ನಾನು ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 62:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7"/>ನನ್ನ ರಕ್ಷಣೆಗೂ, ಮಾನಕ್ಕೂ ದೇವರೇ ಆಧಾರ;</para>
  <para style="q" vid="PSA 62:7">ನನಗೆ ಬಲವಾದ ದುರ್ಗವೂ, ಆಶ್ರಯವೂ ದೇವರಲ್ಲಿಯೇ.<verse eid="PSA 62:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8"/>ಜನರೇ, ಯಾವಾಗಲೂ ಆತನನ್ನೇ ನಂಬಿ,</para>
  <para style="q" vid="PSA 62:8">ನಿಮ್ಮ ಹೃದಯವನ್ನು ಆತನ ಮುಂದೆ ತೆರೆಯಿರಿ;</para>
  <para style="q" vid="PSA 62:8">ದೇವರು ನಮ್ಮ ಆಶ್ರಯವು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 62:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9"/>ನರರು ಬರೀ ಉಸಿರೇ;</para>
  <para style="q" vid="PSA 62:9">ನರಾಧಿಪತಿಗಳು ಬರೀ ಮಾಯವೇ.</para>
  <para style="q" vid="PSA 62:9">ಅವರೆಲ್ಲರನ್ನು ತ್ರಾಸಿನಲ್ಲಿ ತೂಗಿ ನೋಡಿದರೆ ಉಸಿರಿಗಿಂತಲೂ ಹಗುರ.<verse eid="PSA 62:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10"/>ಅನ್ಯಾಯದಿಂದ ಸಂಪಾದಿಸಿದ್ದನ್ನು ನೆಚ್ಚಬೇಡಿರಿ;</para>
  <para style="q" vid="PSA 62:10">ಸುಲಿಗೆಯಿಂದ ಗಳಿಸಿ ಅಹಂಕಾರಪಡಬೇಡಿರಿ;</para>
  <para style="q" vid="PSA 62:10">ಹೆಚ್ಚಿದ ಆಸ್ತಿಯಲ್ಲಿ ಮನಸ್ಸಿಡಬೇಡಿರಿ.<verse eid="PSA 62:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11"/>ಸರ್ವಾಧಿಕಾರವು ದೇವರದೇ ಎಂದು ದೇವರು ಒಮ್ಮೆ ಅಲ್ಲ,</para>
  <para style="q" vid="PSA 62:11">ಎರಡಾವರ್ತಿ ಹೇಳಿದ್ದನ್ನು ಕೇಳಿದ್ದೇನೆ.<verse eid="PSA 62:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12"/>ಕರ್ತನೇ, ನೀನು ಪ್ರೀತಿಸ್ವರೂಪನಾಗಿ</para>
  <para style="q" vid="PSA 62:12">ಪ್ರತಿಯೊಬ್ಬನಿಗೆ ಅವನವನ ಕೃತ್ಯಗಳಿಗೆ ತಕ್ಕ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುವಂಥವನಲ್ಲವೇ.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s">ಭಕ್ತನು ದೇವದರ್ಶನವನ್ನು ಹಂಬಲಿಸಿ ಸಂತೃಪ್ತಿಹೊಂದಿದ್ದು</para>
  <para style="d">ದಾವೀದನು ಯೆಹೂದ ಸೀಮೆಯ ಅರಣ್ಯದಲ್ಲಿದ್ದಾಗ ರಚಿಸಿದ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1"/>ದೇವರೇ, ನೀನೇ ನನ್ನ ದೇವರು;</para>
  <para style="q" vid="PSA 63:1">ನಾನು ನಿನ್ನ ದರ್ಶನವನ್ನು ಕುತೂಹಲದಿಂದ ಎದುರುನೋಡುತ್ತೇನೆ.</para>
  <para style="q" vid="PSA 63:1">ನನ್ನ ಆತ್ಮವೂ ನಿನಗಾಗಿ ಹಂಬಲಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 63:1">ನೀರಿಲ್ಲದೆ ಒಣಗಿದ ಭೂಮಿಯಲ್ಲಿದ್ದವನು ನೀರಿಗಾಗಿಯೋ ಎಂಬಂತೆ,</para>
  <para style="q" vid="PSA 63:1">ನನ್ನ ಶರೀರವು ನಿನಗಾಗಿ ದಾಹಗೊಳ್ಳುತ್ತದೆ.<verse eid="PSA 63:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2"/>ನಿನ್ನ ಮಂದಿರದಲ್ಲಿ ನಾನು ನಿನ್ನ ಮಹತ್ತನ್ನೂ, ಪ್ರಭಾವವನ್ನೂ ಕಂಡ ಪ್ರಕಾರ,</para>
  <para style="q" vid="PSA 63:2">ಈಗಲೂ ಕಾಣಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತೇನೆ.<verse eid="PSA 63:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3"/>ನಿನ್ನ ಪ್ರೇಮಾನುಭವವು ಜೀವಕ್ಕಿಂತಲೂ ಶ್ರೇಷ್ಠ;</para>
  <para style="q" vid="PSA 63:3">ನನ್ನ ಬಾಯಿ ನಿನ್ನನ್ನು ಕೀರ್ತಿಸುವುದು.<verse eid="PSA 63:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4"/>ನನ್ನ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಹೀಗೆಯೇ ನಿನ್ನನ್ನು ಹಾಡಿ ಹರಸುತ್ತಾ,</para>
  <para style="q" vid="PSA 63:4">ನಿನ್ನ ಹೆಸರೆತ್ತಿ ಕೈಮುಗಿಯುವೆನು.<verse eid="PSA 63:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5"/>ಮೃಷ್ಟಭೋಜನದಿಂದಲೋ ಎಂಬಂತೆ,</para>
  <para style="q" vid="PSA 63:5">ನನ್ನ ಮನಸ್ಸು ಸಂತುಷ್ಟವಾಗಿರುವುದು;</para>
  <para style="q" vid="PSA 63:5">ನನ್ನ ಬಾಯಿ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡುತ್ತಾ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವುದು.<verse eid="PSA 63:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6"/>ನಾನು ಹಾಸಿಗೆಯ ಮೇಲಿದ್ದುಕೊಂಡು ನಿನ್ನನ್ನು ಸ್ಮರಿಸುವಾಗ,</para>
  <para style="q" vid="PSA 63:6">ರಾತ್ರಿಯ ಜಾವಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 63:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7"/>ನೀನು ನನಗೆ ಸಹಾಯಕನಾಗಿರುವೆಯಲ್ಲಾ;</para>
  <para style="q" vid="PSA 63:7">ನಿನ್ನ ರೆಕ್ಕೆಗಳ ಮರೆಯಲ್ಲಿ ಸುರಕ್ಷಿತನಾಗಿದ್ದುಕೊಂಡು,</para>
  <para style="q" vid="PSA 63:7">ಆನಂದಘೋಷ ಮಾಡುತ್ತಿರುವೆನು.<verse eid="PSA 63:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8"/>ನನ್ನ ಆತ್ಮವು ನಿನ್ನನ್ನು ಅಂಟಿಕೊಂಡು ಹಿಂಬಾಲಿಸುವುದು;</para>
  <para style="q" vid="PSA 63:8">ನಿನ್ನ ಬಲಗೈ ನನಗೆ ಆಧಾರವಾಗಿರುವುದು.<verse eid="PSA 63:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9"/>ನನ್ನ ಜೀವಕ್ಕೆ ಕೇಡು ಬಗೆಯುವವರೋ,</para>
  <para style="q" vid="PSA 63:9">ಅಧೋಲೋಕಕ್ಕೆ ಇಳಿದುಹೋಗುವರು.<verse eid="PSA 63:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10"/>ಅವರು ಕತ್ತಿಗೆ ಬಲಿಯಾಗುವರು;</para>
  <para style="q" vid="PSA 63:10">ನರಿಗಳ ಪಾಲಾಗುವರು.<verse eid="PSA 63:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11"/>ಆದರೆ ಅರಸನೋ ದೇವರಲ್ಲಿ ಆನಂದಿಸುವನು,</para>
  <para style="q" vid="PSA 63:11">ದೇವರ ಮೇಲೆ ಆಣೆಯಿಡುವವರೆಲ್ಲರು</para>
  <para style="q" vid="PSA 63:11">ಸುಳ್ಳುಬಾಯಿ ಮುಚ್ಚಿಹೋಗುವುದನ್ನು ಕಂಡು ಹಿಗ್ಗುವರು.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s">ಸಂರಕ್ಷಣೆಗಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1"/>ದೇವರೇ, ನನ್ನ ಸ್ವರವನ್ನು ಕೇಳಿ,</para>
  <para style="q" vid="PSA 64:1">ಶತ್ರುಭಯದಿಂದ ನನ್ನ ಜೀವವನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 64:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2"/>ದುಷ್ಟರ ಒಳಸಂಚಿಗೂ, ಕೆಡುಕರ ಗುಪ್ತ ಆಲೋಚನೆಗೂ ಸಿಕ್ಕದಂತೆ,</para>
  <para style="q" vid="PSA 64:2">ನನ್ನನ್ನು ತಪ್ಪಿಸಿ ಭದ್ರಪಡಿಸು.<verse eid="PSA 64:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3"/>ಅವರು ನಾಲಿಗೆಯೆಂಬ ಕತ್ತಿಯನ್ನು ಮಸೆದಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 64:3">ವಿಷವಚನವೆಂಬ ಬಾಣವನ್ನು ಹೂಡಿದ್ದಾರೆ.<verse eid="PSA 64:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4"/>ಗುಪ್ತಸ್ಥಳಗಳಲ್ಲಿದ್ದು ಸಜ್ಜನನಿಗೆ ಗುರಿಯಿಟ್ಟಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 64:4">ಸ್ವಲ್ಪವೂ ಹೆದರದೆ ಅವನ ಮೇಲೆ ಫಕ್ಕನೆ ಎಸೆಯುತ್ತಾರೆ.<verse eid="PSA 64:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5"/>ದುಷ್ಕೃತ್ಯಕ್ಕಾಗಿ ಮನಸ್ಸನ್ನು ದೃಢಪಡಿಸಿಕೊಂಡು</para>
  <para style="q" vid="PSA 64:5">ತಮ್ಮೊಳಗೆ, “ರಹಸ್ಯವಾಗಿ ಬಲೆಗಳನ್ನು ಒಡ್ಡೋಣ;</para>
  <para style="q" vid="PSA 64:5">ನಮ್ಮನ್ನು<note caller="+" style="f"><char style="fr" closed="false">64:5 </char><char style="fq" closed="false">ನಮ್ಮನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಅವರನ್ನು.</char></note> ನೋಡುವವರು ಯಾರು?” ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 64:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6"/>ಅವರು, “ಕೇಡನ್ನು ಕಲ್ಪಿಸಿ, ಒಳ್ಳೆಯ ಉಪಾಯವನ್ನು ಕಂಡುಕೊಂಡಿದ್ದೇವೆ” ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 64:6">ಅವರ ಹೃದಯವೂ, ಅಂತರಂಗದ ಆಲೋಚನೆಯೂ ಅಶೋಧ್ಯವಾಗಿವೆ.<verse eid="PSA 64:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7"/>ಆದರೆ ದೇವರು ಬಾಣವನ್ನು ಎಸೆಯಲು,</para>
  <para style="q" vid="PSA 64:7">ಫಕ್ಕನೆ ಅವರಿಗೆ ಗಾಯವಾಗುವುದು.<verse eid="PSA 64:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8"/>ಅವರ ನಾಲಿಗೆಗಳೇ ಅವರಿಗೆ ವಿಘ್ನವಾಗಿ ಅವರು ಎಡವಿಬೀಳುವರು;</para>
  <para style="q" vid="PSA 64:8">ಆಗ ನೋಡುವವರೆಲ್ಲರು ತಲೆ ಅಲ್ಲಾಡಿಸಿ ಅಣಕಿಸುವರು.<verse eid="PSA 64:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9"/>ಎಲ್ಲಾ ಮನುಷ್ಯರು ಭಯಪಟ್ಟು ದೇವರ ಕೆಲಸವೆಂದು ಹೇಳಿ,</para>
  <para style="q" vid="PSA 64:9">ಆತನ ಕೃತ್ಯಗಳನ್ನು ಆಲೋಚಿಸಿಕೊಳ್ಳುವರು.<verse eid="PSA 64:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10"/>ಸದ್ಭಕ್ತರು ಯೆಹೋವನಲ್ಲಿ ಆನಂದಪಟ್ಟು ಆತನನ್ನೇ ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವರು;</para>
  <para style="q" vid="PSA 64:10">ಸರಳಹೃದಯದವರೆಲ್ಲರೂ ಹಿಗ್ಗುವರು.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s">ಲೋಕಪರಿಪಾಲನೆ ಮತ್ತು ಫಲಸಮೃದ್ಧಿಗಾಗಿ ದೇವರನ್ನು ಸ್ತುತಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ, ಹಾಡು.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1"/>ದೇವರೇ, ಚೀಯೋನಿನಲ್ಲಿ ನಿನಗೋಸ್ಕರ ಸ್ತೋತ್ರವು ಸಿದ್ಧವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 65:1">ಹರಕೆಗಳು ನಿನಗೆ ಸಲ್ಲುತ್ತವೆ.<verse eid="PSA 65:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2"/>ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳುವವನೇ,</para>
  <para style="q" vid="PSA 65:2">ನರರೆಲ್ಲರೂ ನಿನ್ನ ಬಳಿಗೆ ಬರುವರು.<verse eid="PSA 65:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3"/>ನನ್ನ ಪಾಪಗಳನ್ನು ನಿವಾರಿಸಲು ನನ್ನಿಂದಾಗುವುದಿಲ್ಲ.</para>
  <para style="q" vid="PSA 65:3">ಆದರೆ ನಮ್ಮ ದೋಷಪರಿಹಾರಕನು ನೀನೇ.<verse eid="PSA 65:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4"/>ನಿನ್ನ ಅಂಗಳದಲ್ಲಿ ವಾಸಿಸುವವರಾಗಿ,</para>
  <para style="q" vid="PSA 65:4">ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಸೇವೆಮಾಡುವುದಕ್ಕೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 65:4">ನೀನು ಯಾರನ್ನು ಆರಿಸಿಕೊಳ್ಳುತ್ತೀಯೋ ಅವರೇ ಧನ್ಯರು.</para>
  <para style="q" vid="PSA 65:4">ನೀನು ವಾಸಿಸುವ ಮಹಾಪವಿತ್ರಾಲಯದ ಸೌಭಾಗ್ಯದಿಂದ</para>
  <para style="q" vid="PSA 65:4">ನಮಗೆ ಸಂತೃಪ್ತಿಯಾಗಲಿ.<verse eid="PSA 65:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5"/>ನಮ್ಮ ರಕ್ಷಕನಾದ ದೇವರೇ,</para>
  <para style="q" vid="PSA 65:5">ನೀನು ಭಯಂಕರ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡೆಸಿ,</para>
  <para style="q" vid="PSA 65:5">ನಿನ್ನ ನೀತಿಗನುಸಾರವಾಗಿ ನಮಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸುವಿ.</para>
  <para style="q" vid="PSA 65:5">ಭೂಮಿಯ ಎಲ್ಲಾ ಕಡೆಯವರ,</para>
  <para style="q" vid="PSA 65:5">ಬಹುದೂರ ಸಮುದ್ರದ ಆಚೆಯ ಎಲ್ಲಾ ನಿವಾಸಿಗಳ</para>
  <para style="q" vid="PSA 65:5">ನಂಬಿಕೆಗೆ ಆಧಾರನು ನೀನೇ.<verse eid="PSA 65:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6"/>ನೀನು ಶೌರ್ಯವೆಂಬ ನಡುಕಟ್ಟನ್ನು ಬಿಗಿದುಕೊಂಡು,</para>
  <para style="q" vid="PSA 65:6">ಬಲದಿಂದ ಪರ್ವತಗಳನ್ನು ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲಿಸಿದವನು.<verse eid="PSA 65:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7"/>ನೀನು ಸಮುದ್ರ ತರಂಗಗಳ ಘೋಷವನ್ನು ತಡೆಯುವವನೂ,</para>
  <para style="q" vid="PSA 65:7">ಜನಾಂಗಗಳ ಗೊಂದಲವನ್ನು ಶಾಂತಿಪಡಿಸುವವನೂ ಆಗಿದೀ.<verse eid="PSA 65:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8"/>ಭೂಮಿಯ ಕಟ್ಟಕಡೆಗಳಲ್ಲಿ ವಾಸಿಸುವವರೂ,</para>
  <para style="q" vid="PSA 65:8">ನಿನ್ನ ಅದ್ಭುತಕೃತ್ಯಗಳಿಗಾಗಿ ಭಯಪಡುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 65:8">ಪೂರ್ವದಿಂದ ಪಶ್ಚಿಮದವರೆಗೆ ಇರುವವರನ್ನು ಹರ್ಷಗೊಳಿಸುವಿ.<verse eid="PSA 65:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9"/>ನೀನು ನಮ್ಮ ದೇಶವನ್ನು ಕಟಾಕ್ಷಿಸಿ, ಅದರ ಮೇಲೆ ಮಳೆಸುರಿಸಿ,</para>
  <para style="q" vid="PSA 65:9">ಚೆನ್ನಾಗಿ ಹದಗೊಳಿಸುತ್ತೀ; ದೇವರೇ, ನಿನ್ನ ಕಾಲುವೆಗಳಲ್ಲಿ ನೀರಿಗೆ ಕೊರತೆ ಇಲ್ಲ.</para>
  <para style="q" vid="PSA 65:9">ಹೀಗೆ ಭೂಮಿಯನ್ನು ಸಿದ್ಧಮಾಡಿ ಮನುಷ್ಯರಿಗೆ ಧಾನ್ಯವನ್ನು ಒದಗಿಸುತ್ತಿ.<verse eid="PSA 65:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10"/>ನೇಗಿಲಗೆರೆಗಳನ್ನು ತೇವಗೊಳಿಸಿ,</para>
  <para style="q" vid="PSA 65:10">ಮಳೆಯಿಂದ ಅದರ ಹೆಂಟೆಗಳನ್ನು ಕರಗಿಸಿ ಸಮಮಾಡುತ್ತಿ;</para>
  <para style="q" vid="PSA 65:10">ಅದರ ಬೆಳೆಯನ್ನು ವೃದ್ಧಿಪಡಿಸುತ್ತಿ.<verse eid="PSA 65:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11"/>ನಿನ್ನ ಕೃಪೆಯಿಂದ ಸಂವತ್ಸರಕ್ಕೆ ಸುಭಿಕ್ಷ ಕಿರೀಟವನ್ನು ಇಟ್ಟಿದ್ದಿ;</para>
  <para style="q" vid="PSA 65:11">ನೀನು ಹಾದುಹೋಗುವ ಮಾರ್ಗದಲ್ಲೆಲ್ಲಾ</para>
  <para style="q" vid="PSA 65:11">ಸಮೃದ್ಧಿಕರವಾದ ವೃಷ್ಟಿಯು ಸುರಿಯುವುದು.<verse eid="PSA 65:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12"/>ಮೇವುಗಾಡುಗಳು ಹಸಿರಾಗಿ ಕಂಗೊಳಿಸುತ್ತವೆ;</para>
  <para style="q" vid="PSA 65:12">ಗುಡ್ಡಗಳು ಹರ್ಷವೆಂಬ ನಡುಕಟ್ಟನ್ನು ಬಿಗಿದುಕೊಂಡಂತಿವೆ.<verse eid="PSA 65:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13"/>ಹುಲ್ಲುಗಾವಲುಗಳು ಕುರಿಹಿಂಡುಗಳೆಂಬ ವಸ್ತ್ರವನ್ನು ಹೊದ್ದುಕೊಂಡಿವೆ;</para>
  <para style="q" vid="PSA 65:13">ತಗ್ಗುಗಳು ಬೆಳೆಯಿಂದ ಶೋಭಿಸುತ್ತವೆ;</para>
  <para style="q" vid="PSA 65:13">ಅವು ಆನಂದಘೋಷಮಾಡಿ ಹಾಡುತ್ತವೋ ಎಂಬಂತಿವೆ.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s">ದೇವರ ಮಹತ್ಕಾರ್ಯಗಳಿಗಾಗಿ ಸ್ತುತಿಸುವುದು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಹಾಡು; ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1"/>ಸರ್ವಭೂನಿವಾಸಿಗಳೇ, ದೇವರಿಗೆ ಜಯಧ್ವನಿ ಮಾಡಿರಿ.<verse eid="PSA 66:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2"/>ಆತನ ನಾಮದ ಮಹತ್ತನ್ನು ಕೀರ್ತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 66:2">ಆತನ ಪ್ರಭಾವವನ್ನು ವರ್ಣಿಸುತ್ತಾ ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 66:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3"/>ನೀವು ದೇವರಿಗೆ, “ನಿನ್ನ ಕೃತ್ಯಗಳು ಎಷ್ಟೋ ಭಯಂಕರವಾಗಿವೆ;</para>
  <para style="q" vid="PSA 66:3">ನಿನ್ನ ಪರಾಕ್ರಮದ ಮಹತ್ತಿನ ದೆಸೆಯಿಂದ ನಿನ್ನ ಶತ್ರುಗಳು ನಿನ್ನ ಮುಂದೆ ಮುದುರಿಕೊಳ್ಳುವರು;<verse eid="PSA 66:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4"/>ಸರ್ವಭೂನಿವಾಸಿಗಳು ನಿನಗೆ ಅಡ್ಡಬಿದ್ದು ಭಜಿಸುತ್ತಾ,</para>
  <para style="q" vid="PSA 66:4">ನಿನ್ನ ನಾಮವನ್ನು ಕೀರ್ತಿಸುವರು” ಎಂದು ಹೇಳಿರಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 66:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5"/>ಬನ್ನಿರಿ, ದೇವರ ಕಾರ್ಯಗಳನ್ನು ನೋಡಿರಿ;</para>
  <para style="q" vid="PSA 66:5">ಆತನ ಆಳ್ವಿಕೆ ನರರಲ್ಲಿ ಭಯ ಹುಟ್ಟಿಸತಕ್ಕದ್ದಾಗಿದೆ.<verse eid="PSA 66:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6"/>ಸಮುದ್ರವನ್ನು ಒಣನೆಲವಾಗುವಂತೆ ಮಾಡಿದನು;</para>
  <para style="q" vid="PSA 66:6">ಜನರು ನದಿಯ ಮಧ್ಯದಲ್ಲಿ ಕಾಲಿನಿಂದ ದಾಟಿದರು;</para>
  <para style="q" vid="PSA 66:6">ಅದಕ್ಕಾಗಿ ನಾವು ಆತನಲ್ಲಿ ಆನಂದಪಡೋಣ.<verse eid="PSA 66:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7"/>ಆತನು ಪರಾಕ್ರಮದಿಂದ ಸದಾಕಾಲವೂ ಆಳುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 66:7">ಜನಾಂಗಗಳನ್ನು ನೋಡಿಕೊಳ್ಳುತ್ತಾನೆ. ದಂಗೆಕೋರರು ಏಳದಿರಲಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 66:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8"/>ಜನಾಂಗಗಳೇ, ನಮ್ಮ ದೇವರನ್ನು ವಂದಿಸಿರಿ;</para>
  <para style="q" vid="PSA 66:8">ಆತನನ್ನು ಸ್ತುತಿಸುವ ಧ್ವನಿ ಕೇಳಿಸಲಿ.<verse eid="PSA 66:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9"/>ಆತನು ನಮ್ಮನ್ನು ಜೀವದಿಂದುಳಿಸಿ,</para>
  <para style="q" vid="PSA 66:9">ನಮ್ಮ ಕಾಲುಗಳನ್ನು ಜಾರದಂತೆ ಕಾಪಾಡಿದನು.<verse eid="PSA 66:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10"/>ದೇವರೇ, ನಮ್ಮನ್ನು ಶೋಧಿಸಿದಿ;</para>
  <para style="q" vid="PSA 66:10">ಬೆಳ್ಳಿಯನ್ನು ಪುಟಕ್ಕೆ ಹಾಕುವ ಮೇರೆಗೆ ಶುದ್ಧಿಮಾಡಿದಿ.<verse eid="PSA 66:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11"/>ನಮ್ಮನ್ನು ಬಲೆಯಲ್ಲಿ ಸಿಕ್ಕಿಸಿದಿ;</para>
  <para style="q" vid="PSA 66:11">ನಮ್ಮ ಸೊಂಟಕ್ಕೆ ಭಾರವಾದ ಹೊರೆಯನ್ನು ಕಟ್ಟಿದಿ;<verse eid="PSA 66:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12"/>ಮನುಷ್ಯರು ನಮ್ಮ ತಲೆಗಳ ಮೇಲೆಯೇ,</para>
  <para style="q" vid="PSA 66:12">ತಮ್ಮ ರಥಗಳನ್ನು ಹಾಯಿಸುವಂತೆ ಮಾಡಿದಿ.</para>
  <para style="q" vid="PSA 66:12">ನಾವು ಬೆಂಕಿಯನ್ನೂ, ನೀರನ್ನೂ ದಾಟಬೇಕಾಯಿತು;</para>
  <para style="q" vid="PSA 66:12">ಆದರೂ ಸುಸ್ಥಿತಿಗೆ ನಮ್ಮನ್ನು ನಡೆಸಿದಿ.<verse eid="PSA 66:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13"/>ನಾನು ನಿನ್ನ ಆಲಯಕ್ಕೆ ಬಂದು ಸರ್ವಾಂಗಹೋಮಗಳನ್ನು ಸಮರ್ಪಿಸುವೆನು.<verse eid="PSA 66:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14"/>ಇಕ್ಕಟ್ಟಿನ ವೇಳೆಯಲ್ಲಿ ನನ್ನ ತುಟಿಗಳು ಉಚ್ಚರಿಸಿದ</para>
  <para style="q" vid="PSA 66:14">ಬಾಯಿಂದ ಮಾಡಿದ ಹರಕೆಗಳನ್ನು ನಿನಗೆ ಸಲ್ಲಿಸುವೆನು.<verse eid="PSA 66:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15"/>ನಿನಗೆ ಟಗರು ಮುಂತಾದ ಪುಷ್ಟಪಶುಗಳನ್ನು</para>
  <para style="q" vid="PSA 66:15">ಯಜ್ಞರೂಪವಾಗಿ ಸಮರ್ಪಿಸಿ, ಸುವಾಸನೆಯನ್ನು ಉಂಟುಮಾಡುವೆನು;</para>
  <para style="q" vid="PSA 66:15">ಯಜ್ಞಕ್ಕಾಗಿ ಹೋತ ಮತ್ತು ಹೋರಿಗಳನ್ನು ಅರ್ಪಿಸುವೆನು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 66:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16"/>ಎಲ್ಲಾ ದೇವಭಕ್ತರೇ, ಬಂದು ಕೇಳಿರಿ;</para>
  <para style="q" vid="PSA 66:16">ಆತನು ನನಗಾಗಿ ಮಾಡಿದ್ದೆಲ್ಲವನ್ನು ನಿಮಗೆ ತಿಳಿಸುವೆನು.<verse eid="PSA 66:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17"/>ನನ್ನ ಮೊರೆಯೊಡನೆ ಕೃತಜ್ಞತಾಸ್ತುತಿಯೂ ನನ್ನ ನಾಲಿಗೆಯ ಮೇಲಿತ್ತು.<verse eid="PSA 66:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18"/>ನಾನು ಕೆಟ್ಟತನದ ಮೇಲೆ ಮನಸ್ಸಿಟ್ಟಿದ್ದರೆ,</para>
  <para style="q" vid="PSA 66:18">ಸ್ವಾಮಿಯು ನನ್ನ ವಿಜ್ಞಾಪನೆಯನ್ನು ಕೇಳುತ್ತಿದ್ದಿಲ್ಲ.<verse eid="PSA 66:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19"/>ಆದರೆ ದೇವರು ನನ್ನ ಮೊರೆಯನ್ನು ಲಕ್ಷಿಸಿ ಕೇಳಿದ್ದಾನಲ್ಲಾ.<verse eid="PSA 66:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20"/>ಆತನು ನನ್ನ ಬಿನ್ನಹವನ್ನು ತಿರಸ್ಕರಿಸಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 66:20">ನನ್ನ ಮೇಲಿನ ತನ್ನ ದಯೆಯನ್ನು ತಪ್ಪಿಸಿಬಿಡಲಿಲ್ಲ.</para>
  <para style="q" vid="PSA 66:20">ದೇವರಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s">ದೇವಸ್ತುತಿ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ಕೀರ್ತನೆ; ಹಾಡು.</para>
  <para style="r">
    <ref loc="PSA 98">ಕೀರ್ತ 98</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1"/>ದೇವರು ನಮ್ಮನ್ನು ಕಟಾಕ್ಷಿಸಿ ಆಶೀರ್ವದಿಸಲಿ;</para>
  <para style="q" vid="PSA 67:1">ಪ್ರಸನ್ನ ಮುಖದಿಂದ ನಮ್ಮನ್ನು ನೋಡಲಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 67:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2"/>ಇದರಿಂದ ಭೂಲೋಕದಲ್ಲಿ ನಿನ್ನ ಪರಿಪಾಲನ ಮಾರ್ಗವೂ,</para>
  <para style="q" vid="PSA 67:2">ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ನಿನ್ನ ರಕ್ಷಣೆಯೂ ಪ್ರಸಿದ್ಧವಾಗುವವು.<verse eid="PSA 67:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3"/>ದೇವರೇ, ಸರ್ವಜನಾಂಗಗಳು ನಿನ್ನನ್ನು ಕೀರ್ತಿಸಲಿ;</para>
  <para style="q" vid="PSA 67:3">ಸರ್ವಜನಾಂಗಗಳು ನಿನ್ನನ್ನು ಕೀರ್ತಿಸಲಿ.<verse eid="PSA 67:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4"/>ನೀನು ಸಮಸ್ತ ದೇಶಗಳವರನ್ನು ನೀತಿಯಿಂದ ಪಾಲಿಸಿ,</para>
  <para style="q" vid="PSA 67:4">ಭೂಪ್ರಜೆಗಳನ್ನೆಲ್ಲಾ ನಡೆಸುವಾತನಾಗಿರುವುದರಿಂದ</para>
  <para style="q" vid="PSA 67:4">ಜನಾಂಗಗಳು ಹರ್ಷಿಸಿ ಆನಂದಘೋಷ ಮಾಡಲಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 67:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5"/>ದೇವರೇ, ಜನಾಂಗಗಳು ನಿನ್ನನ್ನು ಕೀರ್ತಿಸಲಿ;</para>
  <para style="q" vid="PSA 67:5">ಸರ್ವಜನಾಂಗಗಳು ನಿನ್ನನ್ನು ಕೀರ್ತಿಸಲಿ.<verse eid="PSA 67:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6"/>ಭೂಮಿಯು ಒಳ್ಳೆಯ ಬೆಳೆಯನ್ನು ಕೊಟ್ಟಿರುತ್ತದೆ.</para>
  <para style="q" vid="PSA 67:6">ದೇವರೇ, ನಮ್ಮ ದೇವರೇ ನಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಿದ್ದಾನೆ;<verse eid="PSA 67:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7"/>ಆತನು ನಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುವವನಾಗಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 67:7">ಭೂಮಂಡಲದವರೆಲ್ಲರೂ ಆತನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಾಗಿರುವರು.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s">ರಕ್ಷಕನಾದ ದೇವರ ಪ್ರತಾಪವರ್ಣನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು. ದಾವೀದನ ಕೀರ್ತನೆ; ಹಾಡು.</para>
  <para style="r">
    <ref loc="JDG 5">ನ್ಯಾಯ 5</ref>; <ref loc="DEU 33">ಧರ್ಮೋ 33</ref>; <ref loc="HAB 3">ಹಬ 3</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1"/>ದೇವರು ಎದ್ದು ಹೊರಡುವಾಗ, ಆತನ ವೈರಿಗಳು ಚದರಿಹೋಗಲಿ;</para>
  <para style="q" vid="PSA 68:1">ಆತನ ಹಗೆಗಾರರು ಆತನ ಎದುರಿನಿಂದ ಓಡಿಹೋಗಲಿ.<verse eid="PSA 68:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2"/>ಹೊಗೆಯು ಗಾಳಿಯಿಂದ ಹೇಗೋ,</para>
  <para style="q" vid="PSA 68:2">ಹಾಗೆ ಅವರು ಆತನಿಂದ ಹಾರಿಹೋಗಲಿ;</para>
  <para style="q" vid="PSA 68:2">ಬೆಂಕಿಯ ಮುಂದೆ ಮೇಣವು ಕರಗಿ ಲಯವಾಗಿ ಹೋಗುವಂತೆ,</para>
  <para style="q" vid="PSA 68:2">ದೇವರ ಎದುರಿನಲ್ಲಿ ದುಷ್ಟರು ನಾಶವಾಗಿ ಹೋಗಲಿ.<verse eid="PSA 68:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3"/>ನೀತಿವಂತರಾದರೋ ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಹರ್ಷಿಸಲಿ;</para>
  <para style="q" vid="PSA 68:3">ಉಲ್ಲಾಸಿಸಲಿ, ಆನಂದಧ್ವನಿಮಾಡಲಿ.<verse eid="PSA 68:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4"/>ದೇವರಿಗೆ ಗಾಯನಮಾಡಿರಿ; ಆತನ ನಾಮವನ್ನು ಭಜಿಸಿರಿ;</para>
  <para style="q" vid="PSA 68:4">ಅರಣ್ಯದಲ್ಲಿ ಸವಾರಿಮಾಡುತ್ತಾ<note caller="+" style="f"><char style="fr" closed="false">68:4 </char><char style="fq" closed="false">ಅರಣ್ಯದಲ್ಲಿ ಸವಾರಿಮಾಡುತ್ತಾ </char><char style="ft" closed="false">ಅಥವಾ ಮೇಘಾರೂಢನಾಗಿ.</char></note> ಬರುವಾತನಿಗೆ ರಾಜಮಾರ್ಗವನ್ನು ಸಿದ್ಧಮಾಡಿರಿ.</para>
  <para style="q" vid="PSA 68:4">ಆತನ ನಾಮಧೇಯ ಯಾಹು; ಆತನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಉಲ್ಲಾಸಿಸಿರಿ.<verse eid="PSA 68:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5"/>ಪರಿಶುದ್ಧ ವಾಸಸ್ಥಾನದಲ್ಲಿರುವ ದೇವರು ದಿಕ್ಕಿಲ್ಲದವರಿಗೆ ತಂದೆಯೂ,</para>
  <para style="q" vid="PSA 68:5">ವಿಧವೆಯರಿಗೆ ಸಹಾಯಕನೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 68:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6"/>ಒಬ್ಬೊಂಟಿಗರನ್ನು ಸಂಸಾರಿಕರಾಗುವಂತೆ ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 68:6">ಸೆರೆಯಲ್ಲಿರುವವರನ್ನು ಬಿಡಿಸಿ ಸುಖಾವಸ್ಥೆಗೆ ತರುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 68:6">ದ್ರೋಹಿಗಳಾದರೋ ಮರುಭೂಮಿಯಲ್ಲಿ ಉಳಿಯಬೇಕಾಗುವುದು.<verse eid="PSA 68:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7"/>ದೇವರೇ, ನೀನು ನಿನ್ನ ಪ್ರಜೆಯ ಮುಂದೆ ಹೊರಟು,</para>
  <para style="q" vid="PSA 68:7">ಅರಣ್ಯಮಾರ್ಗವಾಗಿ ಪ್ರಯಾಣ ಮಾಡುತ್ತಾ ಬರುವಾಗ, <char style="qs">ಸೆಲಾ </char><verse eid="PSA 68:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8"/>ದೇವರು ಪ್ರತ್ಯಕ್ಷನಾಗಿದ್ದಾನೆಂದು ಭೂಮಿಯು ಕಂಪಿಸಿತು;</para>
  <para style="q" vid="PSA 68:8">ಮೇಘಮಂಡಲವು ಮಳೆಸುರಿಸಿತು.</para>
  <para style="q" vid="PSA 68:8">ಇಸ್ರಾಯೇಲರ ದೇವರು ಪ್ರತ್ಯಕ್ಷನಾಗಿದ್ದಾನೆಂದು,</para>
  <para style="q" vid="PSA 68:8">ಆ ಸೀನಾಯ್ ಬೆಟ್ಟವು ಕದಲಿತು.<verse eid="PSA 68:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9"/>ದೇವರೇ, ನೀನು ಹೇರಳವಾಗಿ ಮಳೆಸುರಿಸಿ,</para>
  <para style="q" vid="PSA 68:9">ಬಾಯ್ದೆರೆದಿದ್ದ ನಿನ್ನ ಸ್ವತ್ತನ್ನು ಶಾಂತಪಡಿಸಿದಿ.<verse eid="PSA 68:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10"/>ನಿನ್ನ ಪ್ರಜಾಮಂಡಲಿಯು ಅದರಲ್ಲಿ ವಾಸಮಾಡಿತು.</para>
  <para style="q" vid="PSA 68:10">ದೇವರೇ, ನೀನು ದಯಾಪರನಾಗಿ ದರಿದ್ರರಿಗೆ ಬೇಕಾದದ್ದೆಲ್ಲವನ್ನು ಒದಗಿಸಿಕೊಟ್ಟಿ.<verse eid="PSA 68:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11"/>ಕರ್ತನು ಆಜ್ಞಾಪಿಸಿದನು; ಶುಭವಾರ್ತೆಯನ್ನು ಪ್ರಸಿದ್ಧಪಡಿಸುವ ಸ್ತ್ರೀಸಮೂಹವು ಎಷ್ಟೋ ದೊಡ್ಡದು.<verse eid="PSA 68:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12"/>ಓಡಿ ಹೋಗುತ್ತಾರೆ; ಸೈನ್ಯದೊಡನೆ ಅರಸುಗಳು ಓಡಿ ಹೋಗುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 68:12">ಮನೆಯಲ್ಲಿದ್ದ ಸ್ತ್ರೀಯರು ಕೊಳ್ಳೆಯನ್ನು ಹಂಚುತ್ತಾರೆ.<verse eid="PSA 68:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">68:13 </char>
      <char style="ft" closed="false">ಇದು ಸ್ತ್ರೀಯರು ಕೊಳ್ಳೆಯನ್ನು ತಮ್ಮಲ್ಲಿ ಹಂಚಿಕೊಳ್ಳುತ್ತಿರುವ ವಿವರಣೆಯಾಗಿದೆ. ಪಾರಿವಾಳವು ಇಸ್ರಾಯೇಲಿನ ಸಂಕೇತವಾಗಿದೆ. ಕುರಿಹಟ್ಟಿಗಳಲ್ಲಿ ಮಲಗಿಕೊಂಡಿರುವವರಿಗಾಗಿಯೂ ಸಹ ಬೆಳ್ಳಿಯಿಂದ ಆವರಿಸಿರುವ ಪಾರಿವಾಳದ ರೆಕ್ಕೆಗಳು, ಚೊಕ್ಕ ಬಂಗಾರದಿಂದ ಆವರಿಸಿರುವ ಅದರ ಗರಿಗಳು ಇವೆ.</char>
    </note>ನೀವು ಕುರಿಹಟ್ಟಿಗಳಲ್ಲಿ ಮಲಗಿಕೊಂಡಿರುವುದೇನು?</para>
  <para style="q" vid="PSA 68:13">ಪಾರಿವಾಳದ ರೆಕ್ಕೆಗಳು ಬೆಳ್ಳಿಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 68:13">ಅದರ ಗರಿಗಳು ಬಂಗಾರದಿಂದಲೂ ಥಳಥಳಿಸುತ್ತವೆ.<verse eid="PSA 68:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14"/>ಸರ್ವಶಕ್ತನು ಅಲ್ಲಿ ರಾಜರನ್ನು ಚದುರಿಸಿದಾಗ,</para>
  <para style="q" vid="PSA 68:14">ಸಲ್ಮೋನಿನ ಮೇಲೆ ಹಿಮವು ಬಿದ್ದಿತು.<verse eid="PSA 68:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15"/>ಬಾಷಾನಿನ ಪರ್ವತವು ಮಹೋನ್ನತವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 68:15">ಆ ಬಾಷಾನ್ ಗಿರಿಯು ಶಿಖರಗಳುಳ್ಳದ್ದೇ.<verse eid="PSA 68:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16"/>ಎಲೈ, ಶಿಖರೋನ್ನತಪರ್ವತಗಳೇ,</para>
  <para style="q" vid="PSA 68:16">ದೇವರು ತನ್ನ ನಿವಾಸಕ್ಕಾಗಿ ಆರಿಸಿಕೊಂಡಿರುವ ಈ ಪರ್ವತವನ್ನು</para>
  <para style="q" vid="PSA 68:16">ನೀವು ಓರೆಗಣ್ಣಿನಿಂದ ನೋಡುವುದೇಕೆ?</para>
  <para style="q" vid="PSA 68:16">ಯೆಹೋವನು ಸದಾಕಾಲವೂ ಇದರಲ್ಲೇ ವಾಸಿಸುವನು.<verse eid="PSA 68:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17"/>ದೇವರಿಗೆ ಸಹಸ್ರಾರು ಮಾತ್ರವಲ್ಲ ಲಕ್ಷಾಂತರ ರಥಗಳು ಇವೆ.</para>
  <para style="q" vid="PSA 68:17">ಕರ್ತನಾದ ಯೆಹೋವನು ಅವುಗಳ ಸಮೇತವಾಗಿ,</para>
  <para style="q" vid="PSA 68:17">ಸೀನಾಯ್ ಬೆಟ್ಟದಿಂದ ಪವಿತ್ರಾಲಯಕ್ಕೆ ಬಂದಿದ್ದಾನೆ<note caller="+" style="f"><char style="fr" closed="false">68:17 </char><char style="fq" closed="false">ಸೀನಾಯ್ ಬೆಟ್ಟದಿಂದ ಪವಿತ್ರಾಲಯಕ್ಕೆ ಬಂದಿದ್ದಾನೆ </char><char style="ft" closed="false">ಅಥವಾ ಯೆಹೋವನು ಅವರ ಮಧ್ಯದಲ್ಲಿ ವಾಸಿಸುತ್ತಾನೆ, ಸೀನಾಯ್ ಬೆಟ್ಟವು ಪವಿತ್ರಸ್ಥಳದಲ್ಲಿದೆ. </char></note>.<verse eid="PSA 68:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18"/>ನೀನು ಜಯಿಸಿದ ಬಹು ಜನರನ್ನು ಸೆರೆಹಿಡಿದುಕೊಂಡು ಹೋಗಿ,</para>
  <para style="q" vid="PSA 68:18">ನಿನಗೆ ದ್ರೋಹಿಗಳಾದ ಮನುಷ್ಯರಿಂದಲೇ ಕಪ್ಪಗಳನ್ನು ಸಂಗ್ರಹಿಸಿ,</para>
  <para style="q" vid="PSA 68:18">ದೇವನಾದ ಯಾಹುವು ಅಲ್ಲೇ ವಾಸಿಸುವಂತೆ,</para>
  <para style="q" vid="PSA 68:18">ಉನ್ನತಸ್ಥಾನಕ್ಕೆ ಏರಿದ್ದೀ.<verse eid="PSA 68:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19"/>ಅನುದಿನವೂ ನಮ್ಮ ಭಾರವನ್ನು ಹೊರುತ್ತಿರುವ ಕರ್ತನಿಗೆ ಸ್ತೋತ್ರವಾಗಲಿ.</para>
  <para style="q" vid="PSA 68:19">ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವ ದೇವರು ಆತನೇ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 68:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20"/>ನಮ್ಮ ದೇವರು ನಮ್ಮನ್ನು ವಿಮೋಚಿಸುವುದಕ್ಕೋಸ್ಕರ ದೇವರಾಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 68:20">ಕರ್ತನಾದ ಯೆಹೋವನು ಮರಣಕ್ಕೆ ತಪ್ಪಿಸ ಶಕ್ತನಾಗಿದ್ದಾನೆ.<verse eid="PSA 68:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21"/>ಆಹಾ, ಆತನು ತನ್ನ ವೈರಿಗಳ ಶಿರಸ್ಸುಗಳನ್ನೂ,</para>
  <para style="q" vid="PSA 68:21">ಸ್ವೇಚ್ಛೆಯಿಂದ ಪಾಪದಲ್ಲಿ ಪ್ರವರ್ತಿಸುವವರ ತುಂಬುಗೂದಲಿನ ತಲೆಗಳನ್ನೂ ಒಡೆದು ನಿರ್ಮೂಲ ಮಾಡುವನು.<verse eid="PSA 68:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22"/>ಕರ್ತನು, “ನಾನು ಅವರನ್ನು ಬಾಷಾನಿನಿಂದಲೂ,</para>
  <para style="q" vid="PSA 68:22">ಸಮುದ್ರ ತಳದಿಂದಲೂ ಹಿಡಿದು ತರುವೆನು.<verse eid="PSA 68:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23"/>ಆಗ ನೀನು ನಿನ್ನ ಶತ್ರುಗಳ ರಕ್ತದಲ್ಲಿ ಕಾಲಾಡಿಸುವಿ.</para>
  <para style="q" vid="PSA 68:23">ನಿನ್ನ ನಾಯಿಗಳ ನಾಲಿಗೆಗಳಿಗೆ ವೈರಿಗಳ ದೇಹದಲ್ಲಿ ಪಾಲುಸಿಕ್ಕುವುದು” ಎಂದು ನುಡಿದನು.<verse eid="PSA 68:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24"/>ದೇವರೇ, ನಿನ್ನ ಮೆರವಣಿಗೆ ಶೋಭಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 68:24">ನನ್ನ ಅರಸನಾದ ದೇವರು ತನ್ನ ಪರಿಶುದ್ಧಾಲಯಕ್ಕೆ ಮೆರವಣಿಗೆಯಾಗಿ ಪ್ರವೇಶಿಸುತ್ತಾನೆ.<verse eid="PSA 68:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25"/>ಮುಂಭಾಗದಲ್ಲಿ ಹಾಡುವವರೂ, ಹಿಂಭಾಗದಲ್ಲಿ ವಾದ್ಯಬಾರಿಸುವವರೂ,</para>
  <para style="q" vid="PSA 68:25">ಸುತ್ತಲೂ ದಮ್ಮಡಿಬಡಿಯುವ ಸ್ತ್ರೀಯರೂ ಹೋಗುತ್ತಾ,<verse eid="PSA 68:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26"/>“ಇಸ್ರಾಯೇಲ್ ವಂಶಸ್ಥರೇ, ಸಮೂಹವಾಗಿ ದೇವರಾದ ಕರ್ತನನ್ನು ಕೊಂಡಾಡಿರಿ” ಎಂದು ಹಾಡುತ್ತಾರೆ.<verse eid="PSA 68:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27"/>ಅಲ್ಲಿ ಎಲ್ಲರಿಗೆ ನಾಯಕರಾಗಿರುವ ಬೆನ್ಯಾಮೀನ್ ಎಂಬ ಸಣ್ಣ ಗೋತ್ರದವರೂ,</para>
  <para style="q" vid="PSA 68:27">ಗುಂಪಾಗಿ ಬರುವ ಯೆಹೂದ ಕುಲದ ಪ್ರಭುಗಳೂ,</para>
  <para style="q" vid="PSA 68:27">ಜೆಬುಲೂನ್, ನಫ್ತಾಲಿ ಗೋತ್ರಗಳ ಪ್ರಧಾನರೂ ಇದ್ದಾರೆ.<verse eid="PSA 68:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28"/>ದೇವರೇ, ನಿನ್ನ ಪ್ರತಾಪವನ್ನು ಆಜ್ಞಾಪಿಸು<note caller="+" style="f"><char style="fr" closed="false">68:28 </char><char style="fq" closed="false">ಆಜ್ಞಾಪಿಸು </char><char style="ft" closed="false">ಅಥವಾ ತೋರ್ಪಡಿಸು</char></note>.</para>
  <para style="q" vid="PSA 68:28">ನಿನ್ನ ಮಂದಿರದಲ್ಲಿ ಆಸೀನನಾಗಿ</para>
  <para style="q" vid="PSA 68:28">ನಮಗೋಸ್ಕರ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡೆಸಿದ ದೇವರೇ, ನಿನ್ನ ಬಲವನ್ನು ಪ್ರಕಟಿಸು.<verse eid="PSA 68:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29"/>ಅರಸುಗಳು ಯೆರೂಸಲೇಮ್ ಪಟ್ಟಣಕ್ಕೆ ನಿನಗೋಸ್ಕರ ಕಾಣಿಕೆಗಳನ್ನು ತಂದು ಸಮರ್ಪಿಸಲಿ.<verse eid="PSA 68:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30"/>ಆಪಿನೊಳಗೆ ವಾಸಿಸುವ ನೀರಾನೆ, ಕರುಗಳ ಸಹಿತವಾದ ಹೋರಿಗಳ ಗುಂಪು,</para>
  <para style="q" vid="PSA 68:30">ಇವುಗಳಂತಿರುವ ಶತ್ರುಜನಾಂಗಗಳನ್ನು ಬೆದರಿಸು.</para>
  <para style="q" vid="PSA 68:30">ಅವು ಬೆಳ್ಳಿಗಟ್ಟಿಗಳನ್ನು ತಂದು ನಿನಗೆ ಅಡ್ಡಬೀಳಲಿ.</para>
  <para style="q" vid="PSA 68:30">ಯುದ್ಧಾಸಕ್ತ ಜನಾಂಗಗಳನ್ನು ಚದುರಿಸಿಬಿಡು.<verse eid="PSA 68:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31"/>ಐಗುಪ್ತ ದೇಶದಿಂದ ರಾಯಭಾರಿಗಳು ಬರುವರು;</para>
  <para style="q" vid="PSA 68:31">ಕೂಷ್ ದೇಶದವರ ಕೈಗಳು ದೇವರಿಗೆ ಕಾಣಿಕೆಗಳನ್ನು ನೀಡಲಿಕ್ಕೆ ಅವಸರಪಡುವವು.<verse eid="PSA 68:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32"/>ಭೂರಾಜ್ಯಗಳೇ, ದೇವರಿಗೆ ಗಾಯನಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 68:32">ಕರ್ತನನ್ನು ಸಂಕೀರ್ತಿಸಿರಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 68:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33"/>ಅನಾದಿಕಾಲದಿಂದಿರುವ ಮಹೋನ್ನತಾಕಾಶದಲ್ಲಿ</para>
  <para style="q" vid="PSA 68:33">ವಾಹನಾರೂಢನಾಗಿ ಇರುವಾತನನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="q" vid="PSA 68:33">ಕೇಳಿರಿ; ಆತನ ಗರ್ಜನೆಯು ಮಹಾಘೋರವಾದದ್ದು.<verse eid="PSA 68:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34"/>ದೇವರ ಪ್ರತಾಪವನ್ನು ಕೊಂಡಾಡಿರಿ.</para>
  <para style="q" vid="PSA 68:34">ಆತನ ಗಾಂಭೀರ್ಯವು ಇಸ್ರಾಯೇಲರ ಆಶ್ರಯವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 68:34">ಆತನ ಶಕ್ತಿಯು ಮೇಘಮಾರ್ಗದಲ್ಲೆಲ್ಲಾ ವ್ಯಾಪಿಸಿದೆ.<verse eid="PSA 68:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35"/>ದೇವರೇ, ಪರಿಶುದ್ಧಾಲಯದಲ್ಲಿರುವ ನೀನು ಮಹಾಭಯಂಕರನು.</para>
  <para style="q" vid="PSA 68:35">ಇಸ್ರಾಯೇಲರ ದೇವರು ತನ್ನ ಪ್ರಜೆಗೆ ಬಲಪರಾಕ್ರಮಗಳನ್ನು ದಯಪಾಲಿಸುವನು.</para>
  <para style="q" vid="PSA 68:35">ದೇವರಿಗೆ ಸ್ತೋತ್ರ.<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s">ಸ್ವರಕ್ಷಣೆ ಮತ್ತು ವೈರಿಶಿಕ್ಷೆಗಾಗಿ ಭಕ್ತನ ವಿಜ್ಞಾಪನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು. ಶೋಶನ್ನೀಮೆಂಬ ರಾಗದ ಮೇಲೆ ಹಾಡತಕ್ಕದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 22">ಕೀರ್ತ 22</ref>; <ref loc="PSA 35">35</ref>; <ref loc="PSA 40">40</ref>; <ref loc="PSA 45">45</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1"/>ದೇವರೇ, ರಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 69:1">ಜಲವು ನನ್ನ ಕುತ್ತಿಗೆಯವರೆಗೂ ಏರಿಬಂದಿದೆ.<verse eid="PSA 69:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2"/>ಆಳವಾದ ಕೆಸರಿನಲ್ಲಿ ಕುಸಿಯುತ್ತಿದ್ದೇನೆ; ನೆಲೆ ಸಿಕ್ಕುತ್ತಿಲ್ಲ.</para>
  <para style="q" vid="PSA 69:2">ಜಲರಾಶಿಯೊಳಗೆ ಮುಳುಗುತ್ತಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 69:2">ಪ್ರವಾಹವು ನನ್ನನ್ನು ಹೊಡೆದುಕೊಂಡು ಹೋಗುತ್ತಿದೆ.<verse eid="PSA 69:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3"/>ಮೊರೆಯಿಟ್ಟು ಬೇಸತ್ತು ಹೋಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 69:3">ಗಂಟಲು ಒಣಗಿಹೋಯಿತು. ನನ್ನ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸುತ್ತಾ ಕಣ್ಣುಗಳು ಕ್ಷೀಣಿಸುತ್ತವೆ.<verse eid="PSA 69:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4"/>ನಿಷ್ಕಾರಣ ದ್ವೇಷಿಗಳು ನನ್ನ ತಲೆಗೂದಲುಗಳಿಗಿಂತ ಹೆಚ್ಚಾಗಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 69:4">ನಿರಾಕಾರಣವಾಗಿ ನನ್ನನ್ನು ಮುಗಿಸಿಬಿಡಬೇಕೆಂದಿರುವ ವೈರಿಗಳು ಬಲಿಷ್ಠರಾಗಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 69:4">ನಾನು ಅಪಹರಿಸದಿದ್ದರೂ ನನ್ನಿಂದ ದಂಡ ತೆಗೆದುಕೊಂಡರಲ್ಲಾ.<verse eid="PSA 69:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5"/>ದೇವರೇ, ನನ್ನ ಮೂರ್ಖತನವು ನಿನಗೆ ಗೊತ್ತು;</para>
  <para style="q" vid="PSA 69:5">ನನ್ನ ಅಪರಾಧಗಳು ನಿನಗೆ ಮರೆಯಾಗಿಲ್ಲ.<verse eid="PSA 69:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6"/>ಸೇನಾಧೀಶ್ವರನೇ, ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 69:6">ನಿನ್ನನ್ನು ನಂಬಿದವರಿಗೆ ನನ್ನಿಂದ ನಿರಾಶೆಯಾಗದಿರಲಿ;</para>
  <para style="q" vid="PSA 69:6">ಇಸ್ರಾಯೇಲರ ದೇವರೇ, ನಿನ್ನ ದರ್ಶನವನ್ನು ಬಯಸುವವರು</para>
  <para style="q" vid="PSA 69:6">ನನ್ನಿಂದ ಅಪಮಾನಕ್ಕೆ ಗುರಿಯಾಗದಿರಲಿ.<verse eid="PSA 69:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7"/>ನಿನಗೋಸ್ಕರವಾಗಿ ನಿಂದೆಗೆ ಒಳಗಾದೆನಲ್ಲಾ;</para>
  <para style="q" vid="PSA 69:7">ನಾಚಿಕೆಯು ನನ್ನ ಮುಖವನ್ನು ಕವಿದಿದೆ.<verse eid="PSA 69:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8"/>ನನ್ನ ಅಣ್ಣತಮ್ಮಂದಿರಿಗೆ ಅಪರಿಚಿತನಂತಾದೆನು;</para>
  <para style="q" vid="PSA 69:8">ಒಡಹುಟ್ಟಿದವರಿಗೆ ಪರದೇಶಿಯಂತೆ ಇದ್ದೇನೆ.<verse eid="PSA 69:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9"/>ನಿನ್ನ ಆಲಯದ ಅಭಿಮಾನವು ನನ್ನನ್ನು ಬೆಂಕಿಯಂತೆ ದಹಿಸಿದೆ.</para>
  <para style="q" vid="PSA 69:9">ನಿನ್ನನ್ನು ದೂಷಿಸುವವರ ದೂಷಣೆಗಳು ನನ್ನ ಮೇಲೆ ಬಂದಿವೆ.<verse eid="PSA 69:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">69:10 </char>
      <char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ನಾನು ನನ್ನನ್ನು ಉಪವಾಸದಿಂದ ತಗ್ಗಿಸಿಕೊಂಡಿದ್ದೇನೆ ಎಂದು ಇದೆ.</char>
    </note>ನಾನು ದುಃಖದಿಂದ ಅತ್ತು ಉಪವಾಸ ಮಾಡಿ ನನ್ನ ಆತ್ಮವನ್ನು ಕುಗ್ಗಿಸಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 69:10">ಪರಿಹಾಸ್ಯಕ್ಕೆ ಕಾರಣವಾಯಿತು.<verse eid="PSA 69:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11"/>ನಾನು ಗೋಣಿತಟ್ಟು ಕಟ್ಟಿಕೊಂಡದ್ದು,</para>
  <para style="q" vid="PSA 69:11">ಅವರ ಗಾದೆಗೆ ಆಸ್ಪದವಾಯಿತು.<verse eid="PSA 69:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12"/>ಊರ ಬಾಗಿಲಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವವರ ಆಡು ಮಾತಿಗೆ ಗುರಿಯಾಗಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 69:12">ಕುಡುಕರು ನನ್ನ ವಿಷಯವನ್ನು ಹಾಡಿ ಪರಿಹಾಸ್ಯ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 69:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13"/>ಯೆಹೋವನೇ, ನಾನಾದರೋ ನಿನಗೆ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 69:13">ಇದು ನಿನ್ನ ಪ್ರಸನ್ನತೆಗೆ ಸಕಾಲ. ಪ್ರೇಮಪೂರ್ಣನಾದ ದೇವನೇ,</para>
  <para style="q" vid="PSA 69:13">ಸತ್ಯವಂತನಾದ ರಕ್ಷಕನೇ, ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 69:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14"/>ನಾನು ಕೆಸರಿನಲ್ಲಿ ಮುಳುಗಿಹೋಗದಂತೆ ಮೇಲೆತ್ತು;</para>
  <para style="q" vid="PSA 69:14">ವೈರಿಗಳ ಕೈಯೊಳಗಿಂದ ಬಿಡಿಸು;</para>
  <para style="q" vid="PSA 69:14">ಮಹಾಜಲರಾಶಿಯಿಂದ ಎಳೆದುಕೋ.<verse eid="PSA 69:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15"/>ಪ್ರವಾಹವು ನನ್ನನ್ನು ಬಡಕೊಂಡು ಹೋಗದಿರಲಿ;</para>
  <para style="q" vid="PSA 69:15">ಅಗಾಧವು ನನ್ನನ್ನು ಒಳಗೆ ಎಳೆದುಕೊಳ್ಳದಿರಲಿ;</para>
  <para style="q" vid="PSA 69:15">ಪಾತಾಳವು ನನ್ನನ್ನು ನುಂಗದಿರಲಿ.<verse eid="PSA 69:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16"/>ಯೆಹೋವನೇ, ನನ್ನ ಮೊರೆಯನ್ನು ಲಾಲಿಸು;</para>
  <para style="q" vid="PSA 69:16">ನಿನ್ನ ಕೃಪೆಯು ಶುಭಕರವಾಗಿದೆಯಲ್ಲಾ.</para>
  <para style="q" vid="PSA 69:16">ಕರುಣಾನಿಧಿಯೇ, ನನ್ನನ್ನು ಕಟಾಕ್ಷಿಸು.<verse eid="PSA 69:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17"/>ನಿನ್ನ ದಾಸನಿಗೆ ವಿಮುಖನಾಗಬೇಡ,</para>
  <para style="q" vid="PSA 69:17">ಇಕ್ಕಟ್ಟಿನಲ್ಲಿದ್ದೇನೆ, ತಡಮಾಡದೆ ಸಹಾಯಮಾಡು.<verse eid="PSA 69:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18"/>ಸಮೀಪಿಸಿ ನನ್ನ ಪ್ರಾಣವನ್ನು ವಿಮೋಚಿಸು.</para>
  <para style="q" vid="PSA 69:18">ಶತ್ರು ನಿಮಿತ್ತವಾಗಿ ನನ್ನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 69:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19"/>ನನಗುಂಟಾದ ನಿಂದೆ, ಲಜ್ಜೆ, ಅಪಮಾನ ಇವು ನಿನಗೇ ಗೊತ್ತು;</para>
  <para style="q" vid="PSA 69:19">ನನ್ನ ವಿರೋಧಿಗಳು ನಿನಗೆ ಮರೆಯಾಗಿಲ್ಲವಲ್ಲಾ.<verse eid="PSA 69:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20"/>ನಿಂದೆಯಿಂದ ನಿರಾಶೆಗೊಂಡು ಕುಂದಿಹೋಗಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 69:20">ಕರುಣಾಳುಗಳನ್ನು ನಿರೀಕ್ಷಿಸಿದೆ; ದೊರೆಯಲಿಲ್ಲ.</para>
  <para style="q" vid="PSA 69:20">ಸಂತೈಸುವವರನ್ನು ಹಾರೈಸಿದೆ; ಸಿಕ್ಕಲಿಲ್ಲ.<verse eid="PSA 69:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21"/>ನನಗೆ ಉಣ್ಣುವುದಕ್ಕೆ ಕಹಿಯಾದ ವಸ್ತುವನ್ನೂ,</para>
  <para style="q" vid="PSA 69:21">ಬಾಯಾರಿದಾಗ, ಹುಳಿ ದ್ರಾಕ್ಷಾರಸವನ್ನೂ ಕೊಟ್ಟರು.<verse eid="PSA 69:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">69:22 </char>
      <char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ಅವರ ಯಜ್ಞಸಮರ್ಪಿತ ಊಟವು ಅವರ ಸ್ನೇಹಿತರಿಗೆ ಉರುಲಾಗಿರಲಿ.</char>
    </note>ಅವರ ಸಂಪತ್ತು ಅವರಿಗೆ ಉರುಲಾಗಲಿ;</para>
  <para style="q" vid="PSA 69:22">ನಿಶ್ಚಿಂತರಾಗಿರುವಾಗಲೇ ಅದು ಅವರಿಗೆ ಬೋನಾಗಲಿ.<verse eid="PSA 69:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23"/>ಅವರ ಕಣ್ಣು ಮೊಬ್ಬಾಗಿ ಕಾಣದೆ ಹೋಗಲಿ;</para>
  <para style="q" vid="PSA 69:23">ಅವರ ನಡುವು ಯಾವಾಗಲೂ ನಡಗುತ್ತಿರಲಿ.<verse eid="PSA 69:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24"/>ನಿನ್ನ ರೌದ್ರವನ್ನು ಅವರ ಮೇಲೆ ಸುರಿದುಬಿಡು;</para>
  <para style="q" vid="PSA 69:24">ನಿನ್ನ ಕೋಪಾಗ್ನಿಯು ಅವರನ್ನು ದಹಿಸಲಿ.<verse eid="PSA 69:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25"/>ಅವರ ಪಾಳೆಯವು ಹಾಳುಬೀಳಲಿ;</para>
  <para style="q" vid="PSA 69:25">ಅವರ ನಿವಾಸಗಳು ಜನಶೂನ್ಯವಾಗಲಿ.<verse eid="PSA 69:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26"/>ನೀನು ಹೊಡೆದವನನ್ನು ಅವರು ಹಿಂಸಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 69:26">ನೀನು ಗಾಯಮಾಡಿದವರ ನೋವು ಅವರ ಪರಿಹಾಸ್ಯಕ್ಕೆ ಕಾರಣವಾಗಿದೆ.<verse eid="PSA 69:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27"/>ಅವರ ಅಪರಾಧಗಳು ಒಂದೊಂದಾಗಿ ಹೆಚ್ಚುತ್ತಾ ಬರಲಿ.</para>
  <para style="q" vid="PSA 69:27">ನಿನ್ನ ನೀತಿಯಲ್ಲಿ ಅವರಿಗೆ ಪಾಲುಕೊಡಬೇಡ.<verse eid="PSA 69:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28"/>ಜೀವಿತರ ಪಟ್ಟಿಯಿಂದ ಅವರ ಹೆಸರು ತೆಗೆದು ಹಾಕು,</para>
  <para style="q" vid="PSA 69:28">ಸದ್ಭಕ್ತರ ಹೆಸರಿನ ಸಂಗಡ ಅವರ ಹೆಸರು ಬರೆಯಲ್ಪಡದಿರಲಿ.<verse eid="PSA 69:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29"/>ದೇವರೇ, ನೊಂದು ಕುಗ್ಗಿದವನಾದ ನನ್ನನ್ನಾದರೋ,</para>
  <para style="q" vid="PSA 69:29">ನಿನ್ನ ರಕ್ಷಣೆಯು ಭದ್ರಸ್ಥಳದಲ್ಲಿರಿಸುವುದು.<verse eid="PSA 69:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30"/>ನಾನು ಸಂಕೀರ್ತಿಸುತ್ತಾ ದೇವರ ನಾಮವನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 69:30">ಕೃತಜ್ಞತಾಸ್ತುತಿಯಿಂದ ಘನಪಡಿಸುವೆನು.<verse eid="PSA 69:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31"/>ಇದು ಯೆಹೋವನಿಗೆ ಕೊಂಬುಗೊರಸುಗಳುಳ್ಳ,</para>
  <para style="q" vid="PSA 69:31">ಎಳೇ ಹೋರಿಗಳ ಯಜ್ಞಕ್ಕಿಂತ ಬಹು ಪ್ರಿಯವಾದದ್ದು.<verse eid="PSA 69:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32"/>ದೀನರು ಇದನ್ನು ನೋಡಿ ಹರ್ಷಿಸುವರು.</para>
  <para style="q" vid="PSA 69:32">ದೇವದರ್ಶನವನ್ನು ಅಪೇಕ್ಷಿಸುವವರೇ, ನಿಮ್ಮ ಆತ್ಮವು ಉಜ್ಜೀವಿಸಲಿ.<verse eid="PSA 69:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33"/>ಯೆಹೋವನು ಬಡವರ ಮೊರೆಗೆ ಲಕ್ಷ್ಯಕೊಡುವನು;</para>
  <para style="q" vid="PSA 69:33">ಸೆರೆಯಲ್ಲಿರುವ ತನ್ನವರನ್ನು ತಿರಸ್ಕರಿಸುವುದಿಲ್ಲ.<verse eid="PSA 69:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34"/>ಭೂಮ್ಯಾಕಾಶಗಳೂ, ಸಮುದ್ರಗಳೂ,</para>
  <para style="q" vid="PSA 69:34">ಜಲಚರಗಳೂ ಆತನನ್ನು ಕೊಂಡಾಡಲಿ.<verse eid="PSA 69:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35"/>ದೇವರು ಚೀಯೋನ್ ಪಟ್ಟಣವನ್ನು ರಕ್ಷಿಸಿ,</para>
  <para style="q" vid="PSA 69:35">ಯೆಹೂದ ದೇಶದ ನಗರಗಳನ್ನು ಕಟ್ಟಿಸುವನು;</para>
  <para style="q" vid="PSA 69:35">ಆತನ ಪ್ರಜೆಗಳು ಅಲ್ಲಿ ವಾಸಮಾಡುತ್ತಾ ಅದನ್ನು ಸ್ವದೇಶವನ್ನಾಗಿ ಮಾಡಿಕೊಳ್ಳುವರು.<verse eid="PSA 69:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36"/>ಅವರ ಸಂತತಿಗೇ ಅದರ ಹಕ್ಕಿರುವುದು;</para>
  <para style="q" vid="PSA 69:36">ಆತನ ನಾಮವನ್ನು ಪ್ರೀತಿಸುವವರು ಅದರಲ್ಲಿ ವಾಸಿಸುವರು.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s">ಸಂರಕ್ಷಣೆಗಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು, ದಾವೀದನ ಕೀರ್ತನೆ; ಜ್ಞಾಪಕಾರ್ಥ ನೈವೇದ್ಯಸಮರ್ಪಣೆಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು.</para>
  <para style="r">
    <ref loc="PSA 40:13-17">ಕೀರ್ತ 40:13-17</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1"/>ದೇವರೇ, ದಯವಿಟ್ಟು ನನ್ನನ್ನು ರಕ್ಷಿಸು.</para>
  <para style="q" vid="PSA 70:1">ಯೆಹೋವನೇ, ಬೇಗನೆ ಬಂದು ಸಹಾಯ ಮಾಡು.<verse eid="PSA 70:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2"/>ನನ್ನ ಪ್ರಾಣಕ್ಕಾಗಿ ಸಮಯನೋಡುವವರು ಆಶಾಭಂಗಪಟ್ಟು ಅಪಮಾನಹೊಂದಲಿ;</para>
  <para style="q" vid="PSA 70:2">ನನ್ನ ಆಪತ್ತಿನಲ್ಲಿ ಸಂತೋಷಿಸುವವರು ಕಳವಳದಿಂದ ಹಿಂದಿರುಗಿ ಓಡಲಿ.<verse eid="PSA 70:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3"/>ಆಹಾ, ಆಹಾ ಎಂದು ಪರಿಹಾಸ್ಯಮಾಡುವವರು</para>
  <para style="q" vid="PSA 70:3">ತಮಗಾಗುವ ಅಪಮಾನದಿಂದ ಬೆನ್ನು ಕೊಟ್ಟು ಓಡಿಹೋಗಲಿ.<verse eid="PSA 70:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4"/>ನಿನ್ನ ದರ್ಶನವನ್ನು ಕೋರುವವರೆಲ್ಲರು</para>
  <para style="q" vid="PSA 70:4">ನಿನ್ನಲ್ಲಿ ಉಲ್ಲಾಸದಿಂದ ಸಂತೋಷಿಸಲಿ;</para>
  <para style="q" vid="PSA 70:4">ನಿನ್ನ ಜಯದಲ್ಲಿ ಆನಂದಿಸುವವರು, “ದೇವರು ಮಹೋನ್ನತನು” ಎಂದು ಯಾವಾಗಲೂ ಹೇಳಲಿ.<verse eid="PSA 70:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5"/>ನಾನಾದರೋ ಕುಗ್ಗಿದವನೂ, ದಿಕ್ಕಿಲ್ಲದವನೂ ಆಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 70:5">ದೇವರೇ, ಬೇಗನೆ ಬಾ.</para>
  <para style="q" vid="PSA 70:5">ಯೆಹೋವನೇ, ನೀನೇ ನನಗೆ ಸಹಾಯಕನೂ, ರಕ್ಷಕನೂ ಆಗಿದ್ದೀ; ತಡಮಾಡಬೇಡ.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="s">ವೃದ್ಧಾಪ್ಯದ ಪ್ರಾರ್ಥನೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1"/>ಯೆಹೋವನೇ, ನಿನ್ನನ್ನು ಮೊರೆಹೊಕ್ಕಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 71:1">ಎಂದಿಗೂ ಅವಮಾನಕ್ಕೆ ಗುರಿಮಾಡಬೇಡ.<verse eid="PSA 71:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2"/>ನಿನ್ನ ನೀತಿಗನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಬಿಡಿಸಿ ಪಾರುಮಾಡು;</para>
  <para style="q" vid="PSA 71:2">ನನ್ನ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಟ್ಟು ಉದ್ಧರಿಸು.<verse eid="PSA 71:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3"/>ನಾನು ಯಾವಾಗಲೂ ಮರೆಹೋಗುವ ಆಶ್ರಯಗಿರಿಯಾಗಿರು;</para>
  <para style="q" vid="PSA 71:3">ನನ್ನ ರಕ್ಷಣೆಗೋಸ್ಕರ ಆಜ್ಞಾಪಿಸಿದ್ದೀಯಲ್ಲವೇ.</para>
  <para style="q" vid="PSA 71:3">ನೀನೇ ನನ್ನ ಬಂಡೆಯೂ, ಕೋಟೆಯೂ ಆಗಿದ್ದೀಯಲ್ಲಾ.<verse eid="PSA 71:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4"/>ದೇವರೇ, ನನ್ನನ್ನು ದುಷ್ಟನ ಕೈಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 71:4">ಅನ್ಯಾಯ ಮತ್ತು ಹಿಂಸಕನ ವಶದಿಂದಲೂ ತಪ್ಪಿಸು.<verse eid="PSA 71:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5"/>ಕರ್ತನಾದ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 71:5">ಬಾಲ್ಯದಿಂದ ನನ್ನ ನಿರೀಕ್ಷೆಯೂ, ಭರವಸವೂ ನೀನಲ್ಲವೋ?<verse eid="PSA 71:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6"/>ನಾನು ಹುಟ್ಟಿದಂದಿನಿಂದ ನಿನ್ನನ್ನೇ ಅವಲಂಬಿಸಿಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 71:6">ತಾಯಿ ಹೆತ್ತಂದಿನಿಂದ ನನ್ನ ಉದ್ಧಾರಕನು ನೀನೇ.</para>
  <para style="q" vid="PSA 71:6">ನಾನು ಯಾವಾಗಲೂ ಹಿಗ್ಗುತ್ತಿರುವುದು ನಿನ್ನಲ್ಲಿಯೇ.<verse eid="PSA 71:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7"/>ನನ್ನ ದುಸ್ಥಿತಿಯು ಅನೇಕರಿಗೆ ಒಂದು ಗುರುತಾಗಿದೆ;</para>
  <para style="q" vid="PSA 71:7">ಆದರೂ ನೀನು ನನಗೆ ಬಲವಾದ ಆಶ್ರಯಸ್ಥಾನವಾಗಿರುತ್ತೀ.<verse eid="PSA 71:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8"/>ನನ್ನ ಬಾಯಲ್ಲಿ ನಿನ್ನ ಸ್ತೋತ್ರವಲ್ಲದೆ ಮತ್ತೊಂದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 71:8">ದಿನವೆಲ್ಲಾ ನಿನ್ನ ಘನತೆಯನ್ನು ವರ್ಣಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 71:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9"/>ವೃದ್ಧಾಪ್ಯದಲ್ಲಿ ನನ್ನನ್ನು ಧಿಕ್ಕರಿಸಬೇಡ;</para>
  <para style="q" vid="PSA 71:9">ನನ್ನ ಬಲವು ಕುಂದಿದಾಗ ಕೈಬಿಡಬೇಡ.<verse eid="PSA 71:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10"/>ನನ್ನ ಜೀವಕ್ಕೆ ಹೊಂಚುಹಾಕುವ ವೈರಿಗಳು ಒಟ್ಟಾಗಿ ಆಲೋಚಿಸುತ್ತಾ,<verse eid="PSA 71:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11"/>“ದೇವರು ಅವನನ್ನು ಕೈಬಿಟ್ಟಿದ್ದಾನೆ; ಬೆನ್ನಟ್ಟಿ ಹಿಡಿಯಿರಿ;</para>
  <para style="q" vid="PSA 71:11">ಬಿಡಿಸುವವರು ಯಾರೂ ಇಲ್ಲ” ಎಂದು ಹೇಳಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 71:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12"/>ದೇವರೇ, ದೂರವಾಗಿರಬೇಡ. ನನ್ನ ದೇವರೇ, ಬೇಗ ಸಹಾಯಮಾಡು.<verse eid="PSA 71:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13"/>ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಹೊಂಚು ಹಾಕುವವರು ಅಪಮಾನ ಹೊಂದಿ ನಾಶವಾಗಲಿ;</para>
  <para style="q" vid="PSA 71:13">ನನಗೆ ಕೇಡುಬಗೆಯುವವರನ್ನು ನಿಂದೆ, ಅಪಮಾನಗಳು ಕವಿಯಲಿ.<verse eid="PSA 71:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14"/>ನಾನಂತೂ ನಿರೀಕ್ಷಿಸಿಕೊಂಡೇ ಇರುವೆನು;</para>
  <para style="q" vid="PSA 71:14">ನಿನ್ನನ್ನು ಅಧಿಕಾಧಿಕವಾಗಿ ಹೊಗಳುತ್ತಿರುವೆನು.<verse eid="PSA 71:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15"/>ನನ್ನ ಬಾಯಿ ನಿನ್ನ ನೀತಿಯನ್ನು, ರಕ್ಷಣೆಯನ್ನು ಹಗಲೆಲ್ಲಾ ವರ್ಣಿಸುತ್ತಿರುವುದು;</para>
  <para style="q" vid="PSA 71:15">ಆದರೂ ಅವುಗಳ ವಿವರಣೆ ನನಗೆ ಅಸಾಧ್ಯ.<verse eid="PSA 71:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16"/>ಕರ್ತನಾದ ಯೆಹೋವನೇ, ನಾನು ನಿನ್ನ ಮಹತ್ತರವಾದ ಕೃತ್ಯಗಳನ್ನು ಸ್ಮರಿಸುವವನಾಗಿ</para>
  <para style="q" vid="PSA 71:16">ನಿನ್ನೊಬ್ಬನ ನೀತಿಯನ್ನೇ ಪ್ರಕಟಪಡಿಸುವೆನು.<verse eid="PSA 71:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17"/>ದೇವರೇ, ನೀನು ಬಾಲ್ಯದಿಂದಲೂ ನನ್ನನ್ನು ಉಪದೇಶಿಸುತ್ತಾ ಬಂದಿದ್ದಿ.</para>
  <para style="q" vid="PSA 71:17">ನಾನು ನಿನ್ನ ಅದ್ಭುತಕೃತ್ಯಗಳನ್ನು ಇಂದಿನ ವರೆಗೂ ಪ್ರಚುರಪಡಿಸುತ್ತಿದ್ದೇನೆ.<verse eid="PSA 71:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18"/>ದೇವರೇ, ನಾನು ನರೆಯ ಮುದುಕನಾದಾಗಲೂ ಕೈಬಿಡಬೇಡ;</para>
  <para style="q" vid="PSA 71:18">ಆಗ ಮುಂದಿನ ತಲೆಯವರಿಗೆ ನಿನ್ನ ಭುಜಬಲವನ್ನು ಸಾರುವೆನು,</para>
  <para style="q" vid="PSA 71:18">ತಲತಲಾಂತರದವರಿಗೆಲ್ಲಾ ನಿನ್ನ ಪ್ರತಾಪವನ್ನು ಪ್ರಕಟಿಸುವೆನು.<verse eid="PSA 71:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19"/>ದೇವರೇ, ನಿನ್ನ ನೀತಿಯು ಆಕಾಶವನ್ನು ನಿಲುಕುವಷ್ಟು ಮಹೋನ್ನತವಾಗಿದೆ.</para>
  <para style="q" vid="PSA 71:19">ಮಹತ್ತರವಾದ ಕೃತ್ಯಗಳನ್ನು ನಡೆಸಿದ ದೇವರೇ, ನಿನಗೆ ಸಮಾನರು ಯಾರು?<verse eid="PSA 71:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20"/>ನಮ್ಮನ್ನು ಅನೇಕ ಕಷ್ಟನಷ್ಟಗಳಿಗೆ ಗುರಿಮಾಡಿದ ನೀನೇ ಪುನಃ ಉಜ್ಜೀವಿಸಮಾಡು;</para>
  <para style="q" vid="PSA 71:20">ನಮ್ಮನ್ನು ಭೂಮಿಯ ಅಧೋಭಾಗದಿಂದ ಮೇಲೆತ್ತು.<verse eid="PSA 71:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21"/>ನನ್ನ ಗೌರವವನ್ನು ಹೆಚ್ಚಿಸು;</para>
  <para style="q" vid="PSA 71:21">ನನಗೆ ಅಭಿಮುಖನಾಗಿ ಸಂತೈಸು.<verse eid="PSA 71:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22"/>ನನ್ನ ದೇವರೇ, ನಿನ್ನ ಸತ್ಯತೆಯನ್ನು ಸ್ಮರಿಸುವೆನು;</para>
  <para style="q" vid="PSA 71:22">ಸ್ವರಮಂಡಲದಿಂದ ನಿನ್ನನ್ನು ಸಂಕೀರ್ತಿಸುವೆನು.</para>
  <para style="q" vid="PSA 71:22">ಇಸ್ರಾಯೇಲರ ಪರಿಶುದ್ಧ ದೇವರು,</para>
  <para style="q" vid="PSA 71:22">ಕಿನ್ನರಿಯನ್ನು ನುಡಿಸುತ್ತಾ ನಿನ್ನನ್ನು ಭಜಿಸುವೆನು.<verse eid="PSA 71:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23"/>ನನ್ನ ತುಟಿಗಳೂ ಮತ್ತು ನೀನು ರಕ್ಷಿಸಿದ ನನ್ನ ಪ್ರಾಣವೂ</para>
  <para style="q" vid="PSA 71:23">ನಿನ್ನನ್ನು ಹಾಡಿಹರಸುವವು.<verse eid="PSA 71:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24"/>ನನ್ನ ಕೇಡಿಗೆ ಪ್ರಯತ್ನಿಸಿದವರು ಆಶಾಭಂಗಪಟ್ಟು ಅಪಮಾನ ಹೊಂದಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 71:24">ಆದುದರಿಂದ ನನ್ನ ನಾಲಿಗೆಯು ದಿನವೆಲ್ಲಾ ನಿನ್ನ ನೀತಿಸಾಧನೆಯನ್ನು ವರ್ಣಿಸುತ್ತಿರುವುದು.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s">ರಾಜಾಶೀರ್ವಾದ</para>
  <para style="d">ಸೊಲೊಮೋನನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 21">ಕೀರ್ತ 21</ref>; <ref loc="PSA 45">45</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1"/>ದೇವರೇ, ಅರಸನಿಗೆ ನಿನ್ನ ನ್ಯಾಯವನ್ನು;</para>
  <para style="q" vid="PSA 72:1">ರಾಜಕುಮಾರನಿಗೆ ನಿನ್ನ ನೀತಿಯನ್ನು ಅನುಗ್ರಹಿಸು.<verse eid="PSA 72:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2"/>ಅವನು ನಿನ್ನ ಜನರಿಗೆ ನೀತಿಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 72:2">ಕುಗ್ಗಿಹೋದ ನಿನ್ನವರಿಗೆ ನ್ಯಾಯವಾಗಿಯೂ ತೀರ್ಪುಕೊಡಲಿ.<verse eid="PSA 72:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3"/>ಗುಡ್ಡ ದಿನ್ನೆಗಳೆಲ್ಲವು ನಿನ್ನ ಜನರಿಗೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 72:3">ನೀತಿಗನುಸಾರವಾಗಿ ಸುಕ್ಷೇಮವನ್ನು ಫಲಿಸಲಿ.<verse eid="PSA 72:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4"/>ಅವನು ಬಡವರ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸಲಿ;</para>
  <para style="q" vid="PSA 72:4">ದೀನರ ಮಕ್ಕಳನ್ನು ಉದ್ಧರಿಸಲಿ;</para>
  <para style="q" vid="PSA 72:4">ಪ್ರಜಾಹಿಂಸಕರನ್ನು ಖಂಡಿಸಿಬಿಡಲಿ.<verse eid="PSA 72:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5"/>ಸೂರ್ಯನು, ಚಂದ್ರನು ಇರುವವರೆಗೂ,</para>
  <para style="q" vid="PSA 72:5">
    <note caller="+" style="f">
      <char style="fr" closed="false">72:5 </char>
      <char style="ft" closed="false">ತಲಲಾಂತರಗಳವರೆಲ್ಲರು ನಿನಗೆ ಭಯಪಡಲಿ.</char>
    </note>ತಲತಲಾಂತರಗಳವರೆಗೂ ಅವರು ನಿನಗೆ ಭಯಪಡಲಿ.<verse eid="PSA 72:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6"/>ಹುಲ್ಲುಕೊಯ್ದ ಮೇಹುಗಾಡಿನ ಮೇಲೆ ಸುರಿಯುವ ವೃಷ್ಟಿಯಂತೆಯೂ,</para>
  <para style="q" vid="PSA 72:6">ಭೂಮಿಯನ್ನು ನೆನಸುವ ಹದಮಳೆಯಂತೆಯೂ ಅವನು ಇರಲಿ.<verse eid="PSA 72:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7"/>ಅವನ ದಿನಗಳಲ್ಲಿ ನೀತಿಯು ವೃದ್ಧಿಯಾಗಲಿ<note caller="+" style="f"><char style="fr" closed="false">72:7 </char><char style="fq" closed="false">ನೀತಿಯು ವೃದ್ಧಿಯಾಗಲಿ </char><char style="ft" closed="false">ಅಥವಾ ನೀತಿವಂತರು ವೃದ್ಧಿಯಾಗಲಿ.</char></note>;</para>
  <para style="q" vid="PSA 72:7">ಚಂದ್ರನಿರುವವರೆಗೂ ಪರಿಪೂರ್ಣ ಸೌಭಾಗ್ಯವಿರಲಿ.<verse eid="PSA 72:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8"/>ಅವನು ಸಮುದ್ರದಿಂದ ಸಮುದ್ರದ ವರೆಗೂ,</para>
  <para style="q" vid="PSA 72:8">ಯೂಫ್ರೆಟಿಸ್ ನದಿಯಿಂದ ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯವರೆಗೂ ಆಳಲಿ.<verse eid="PSA 72:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9"/>ಅರಣ್ಯವಾಸಿಗಳು<note caller="+" style="f"><char style="fr" closed="false">72:9 </char><char style="fq" closed="false">ಅರಣ್ಯವಾಸಿಗಳು </char><char style="ft" closed="false">ಅಥವಾ ಅವನ ಶತ್ರುಗಳು.</char></note> ಅವನಿಗೆ ಅಡ್ಡಬೀಳಲಿ;</para>
  <para style="q" vid="PSA 72:9">ಅವನ ವೈರಿಗಳು ಮಣ್ಣುಮುಕ್ಕಲಿ.<verse eid="PSA 72:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10"/>ತಾರ್ಷೀಷ್ ಪ್ರಾಂತ್ಯದ ಮತ್ತು ಸಮುದ್ರದ ಕರಾವಳಿಯ ಅರಸರು ಕಪ್ಪಗಳನ್ನು ಸಲ್ಲಿಸಲಿ;</para>
  <para style="q" vid="PSA 72:10">ಶೆಬಾ ಮತ್ತು ಸೆಬಾ ಎಂಬ ಪ್ರದೇಶಗಳ ರಾಜರೂ ಕಾಣಿಕೆಗಳನ್ನು ತಂದೊಪ್ಪಿಸಲಿ.<verse eid="PSA 72:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11"/>ಎಲ್ಲಾ ಅರಸರೂ ಅವನಿಗೆ ಸಾಷ್ಟಾಂಗವೆರಗಲಿ;</para>
  <para style="q" vid="PSA 72:11">ಸರ್ವಜನಾಂಗಗಳು ಆತನನ್ನು ಸೇವಿಸಲಿ.<verse eid="PSA 72:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12"/>ಏಕೆಂದರೆ ಅವನು ಮೊರೆಯಿಡುವ ಬಡವರನ್ನೂ,</para>
  <para style="q" vid="PSA 72:12">ದಿಕ್ಕಿಲ್ಲದೆ ಕುಗ್ಗಿದವರನ್ನೂ ಉದ್ಧರಿಸುವನು.<verse eid="PSA 72:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13"/>ದೀನದರಿದ್ರರ ಮೇಲೆ ಕರುಣೆಯುಳ್ಳವನಾಗಿ ಅವರ ಪ್ರಾಣಗಳನ್ನು ಸಂತೈಸುವನು.<verse eid="PSA 72:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14"/>ಕುಯುಕ್ತಿ, ಬಲಾತ್ಕಾರಗಳಿಗೆ ತಪ್ಪಿಸಿ ಅವರ ಜೀವವನ್ನು ಕಾಯುವನು;</para>
  <para style="q" vid="PSA 72:14">ಅವರ ಜೀವವು<note caller="+" style="f"><char style="fr" closed="false">72:14 </char><char style="fq" closed="false">ಅವರ ಜೀವವು </char><char style="ft" closed="false">ಅಥವಾ ಅವರ ರಕ್ತವು.</char></note> ಅವನ ದೃಷ್ಟಿಯಲ್ಲಿ ಅಮೂಲ್ಯವಾಗಿರುವುದು.<verse eid="PSA 72:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15"/>ಅವನು ಬಾಳಲಿ; ಶೆಬಾ ಪ್ರಾಂತ್ಯದ ಬಂಗಾರವು ಅವನಿಗೆ ಸಮರ್ಪಣೆಯಾಗಲಿ.</para>
  <para style="q" vid="PSA 72:15">ಅವನಿಗೋಸ್ಕರ ಯಾವಾಗಲೂ ದೇವರಲ್ಲಿ ವಿಜ್ಞಾಪನೆಯು ನಡೆಯಲಿ;</para>
  <para style="q" vid="PSA 72:15">ದಿನದಿನವೂ ಅವನಿಗೆ ಆಶೀರ್ವಾದಗಳು ಉಂಟಾಗಲಿ.<verse eid="PSA 72:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16"/>ದೇಶದಲ್ಲಿ ಬೆಟ್ಟಗಳ ಮೇಲೆಲ್ಲಾ ಬೆಳೆಯು ಸಮೃದ್ಧಿಯಾಗಲಿ;</para>
  <para style="q" vid="PSA 72:16">ಪೈರುಗಳ ಶಬ್ದವು ಲೆಬನೋನಿನ ಮರಗಳ ಸಪ್ಪಳದಂತಿರಲಿ.</para>
  <para style="q" vid="PSA 72:16">ಹೊಲದಲ್ಲಿ ಕಾಯಿಪಲ್ಯದಂತೆ ಪಟ್ಟಣಗಳಲ್ಲಿ ಜನರು ಹೆಚ್ಚಲಿ.<verse eid="PSA 72:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17"/>ಅವನ ನಾಮವು ಸ್ಥಿರವಾಗಿರಲಿ;</para>
  <para style="q" vid="PSA 72:17">ಅವನ ಹೆಸರು ಸೂರ್ಯನಿರುವವರೆಗೆ ಇರಲಿ.</para>
  <para style="q" vid="PSA 72:17">ಎಲ್ಲಾ ಜನಾಂಗಗಳವರು ಅವನನ್ನು ಧನ್ಯನೆಂದು ಹೇಳಿ,</para>
  <para style="q" vid="PSA 72:17">ಅವನಿಗಿದ್ದ ಆಶೀರ್ವಾದವು ತಮಗೂ ಆಗಬೇಕೆಂದು ಕೋರುವವರಾಗಲಿ.<verse eid="PSA 72:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18"/>ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡೆಸುವುದರಲ್ಲಿ ಅದ್ವಿತೀಯನೂ,</para>
  <para style="q" vid="PSA 72:18">ಇಸ್ರಾಯೇಲರ ದೇವರಾದ ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರವು.<verse eid="PSA 72:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19"/>ಆತನ ಪ್ರಭಾವವುಳ್ಳ ನಾಮಕ್ಕೆ ಸದಾಕಾಲಕ್ಕೂ ಸ್ತುತಿ ಇರಲಿ;</para>
  <para style="q" vid="PSA 72:19">ಭೂಮಂಡಲವೆಲ್ಲಾ ಆತನ ಪ್ರಭಾವದಿಂದ ತುಂಬಿರಲಿ. ಆಮೆನ್. ಆಮೆನ್.<verse eid="PSA 72:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20"/>ಇಲ್ಲಿಗೆ ಇಷಯನ ಮಗನಾದ ದಾವೀದನ ಪ್ರಾರ್ಥನೆಗಳ ಸಮಾಪ್ತಿ.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">ತೃತೀಯ ಭಾಗವು 73-89</para>
  <para style="d">ದುಷ್ಟರ ಸೌಭಾಗ್ಯವನ್ನು ಕಂಡು ವಿಶ್ವಾಸಭ್ರಷ್ಟರಾಗಬಾರದೆಂಬ ಬೋಧನೆ</para>
  <para style="s">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 49">ಕೀರ್ತ 49</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1"/>ದೇವರು ನಿರ್ಮಲಚಿತ್ತರಾದ ಇಸ್ರಾಯೇಲರಿಗೆ ದಯಾಪರನೇ ಹೌದು.<verse eid="PSA 73:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2"/>ನನ್ನ ಕಾಲುಗಳು ಜಾರಿದವುಗಳೇ; ನನ್ನ ಹೆಜ್ಜೆಗಳು ತಪ್ಪಿದವುಗಳೇ.<verse eid="PSA 73:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3"/>ಆದರೆ ನಾನು ದುಷ್ಟರ ಸೌಭಾಗ್ಯವನ್ನು ಕಂಡು</para>
  <para style="q" vid="PSA 73:3">ಸೊಕ್ಕಿನವರ ಮೇಲೆ ಉರಿಗೊಂಡೆನು.<verse eid="PSA 73:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4"/>ಅವರ ಮರಣವು ನಿರ್ಬಾಧಕವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 73:4">ಅವರ ದೇಹವು ಕೊಬ್ಬಿದೆ.<verse eid="PSA 73:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5"/>ಮನುಷ್ಯರ ಕಷ್ಟದಲ್ಲಿ ಅವರು ಭಾಗಿಗಳಾಗುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 73:5">ಇತರರಿಗೆ ತಗುಲುವಂತೆ ಅವರಿಗೆ ಅಂಟುರೋಗವೂ ತಗುಲುವುದಿಲ್ಲ.<verse eid="PSA 73:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6"/>ಆದುದರಿಂದ ಅವರಿಗೆ ಗರ್ವವು ಕಂಠಮಾಲೆಯಾಗಿದೆ;</para>
  <para style="q" vid="PSA 73:6">ಬಲಾತ್ಕಾರವು ಉಡುಪಾಗಿದೆ.<verse eid="PSA 73:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7"/>ಕೊಬ್ಬಿನಿಂದ ಅವರ ಕಣ್ಣುಗಳು ಉಬ್ಬಿಕೊಂಡಿವೆ;</para>
  <para style="q" vid="PSA 73:7">ಅವರ ದುಷ್ಕಲ್ಪನೆಗಳು ತುಂಬಿತುಳುಕುತ್ತವೆ.<verse eid="PSA 73:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8"/>ಹಾಸ್ಯಮಾಡುವವರಾಗಿ ಕೆಡುಕಿನ ವಿಷಯ ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 73:8">ಬಲಾತ್ಕಾರನಡಿಸಬೇಕೆಂದು ಹೆಮ್ಮೆಕೊಚ್ಚುತ್ತಾರೆ.<verse eid="PSA 73:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9"/>ತಾವು ಮೇಲುಲೋಕದವರೋ ಎಂಬಂತೆ ದೊಡ್ಡ ಬಾಯಿಮಾಡುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 73:9">ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಅವರ ಮಾತೇ ಮುಂದು.<verse eid="PSA 73:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10"/>ಆದುದರಿಂದ ಜನರು ಅವರ ಪಕ್ಷವನ್ನು ಹಿಡಿಯುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 73:10">
    <note caller="+" style="f">
      <char style="fr" closed="false">73:10 </char>
      <char style="ft" closed="false">ಅಥವಾ ಅವರಿಗೆ ಪಾನವು ಯಥೇಚ್ಛವಾಗಿ ದೊರಕುವುದು. </char>
    </note>ಅವರು ಅವರಲ್ಲಿ ಯಾವುದೇ ತಪ್ಪನ್ನು ಕಂಡುಹಿಡಿಯಲಿಲ್ಲ.<verse eid="PSA 73:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11"/>ಅವರು “ದೇವರು ವಿಚಾರಿಸುವುದೆಲ್ಲಿ? ಪರಾತ್ಪರನಾದ ದೇವರು ಚಿಂತಿಸುವದುಂಟೋ” ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 73:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12"/>ನೋಡಿರಿ, ದುಷ್ಟರು ಇಂಥವರೇ;</para>
  <para style="q" vid="PSA 73:12">ಅವರು ಸದಾ ಸುಖದಿಂದಿದ್ದು ಸ್ಥಿತಿವಂತರಾಗಿ ಹೋಗುತ್ತಾರೆ.<verse eid="PSA 73:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13"/>ನನ್ನ ಮನಸ್ಸನ್ನು ನಿರ್ಮಲಮಾಡಿಕೊಂಡಿದ್ದೂ,</para>
  <para style="q" vid="PSA 73:13">ಶುದ್ಧತ್ವದಲ್ಲಿ ಕೈತೊಳಕೊಂಡಿದ್ದೂ ವ್ಯರ್ಥವೇ ಸರಿ.<verse eid="PSA 73:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14"/>ನಾನು ಯಾವಾಗಲೂ ವ್ಯಾಧಿಪೀಡಿತನಾಗಿದ್ದು,</para>
  <para style="q" vid="PSA 73:14">ಪ್ರತಿದಿನವೂ ದಂಡಿಸಲ್ಪಡುತ್ತಾ ಇದ್ದೇನಲ್ಲಾ.<verse eid="PSA 73:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15"/>ನಾನು ಈ ಪ್ರಕಾರ ಬಾಯಿಬಿಡುವುದಕ್ಕೆ ಮನಸ್ಸು ಮಾಡಿಕೊಂಡಿದ್ದರೆ,</para>
  <para style="q" vid="PSA 73:15">ನಿನ್ನ ಭಕ್ತಕುಲಕ್ಕೆ ದ್ರೋಹಿಯಾಗುತ್ತಿದ್ದೆನು.<verse eid="PSA 73:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16"/>ನಾನು ಇದನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳಬೇಕೆಂದು ಎಷ್ಟು ಚಿಂತಿಸಿದರೂ</para>
  <para style="q" vid="PSA 73:16">ಅದು ಒಂದು ಕಷ್ಟಕರವಾದ ಮರ್ಮವೆಂದು ತೋಚಿತು.<verse eid="PSA 73:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17"/>ಆದರೆ ದೇವಾಲಯಕ್ಕೆ ಹೋಗಿ ಅವರ ಅಂತ್ಯಾವಸ್ಥೆಯನ್ನು ಆಲೋಚಿಸಿದಾಗ ನನಗೆ ಗೊತ್ತಾಯಿತು.<verse eid="PSA 73:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18"/>ಹೌದು, ನೀನು ಅವರನ್ನು ಅಪಾಯಕರ ಸ್ಥಳದಲ್ಲಿಟ್ಟು,</para>
  <para style="q" vid="PSA 73:18">ಬೀಳಿಸಿ, ನಾಶಮಾಡಿಬಿಡುತ್ತೀ.<verse eid="PSA 73:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19"/>ಅವರು ನಿಮಿಷಮಾತ್ರದಲ್ಲಿಯೇ ಹಾಳಾಗಿ ಹೋಗುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 73:19">ಭಯಂಕರ ರೀತಿಯಿಂದ ಸಂಹಾರವಾಗಿ ಮುಗಿದು ಹೋಗುತ್ತಾರೆ.<verse eid="PSA 73:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20"/>ಎಚ್ಚರವಾದವನು ಕನಸ್ಸನ್ನು ಕಂಡ ಹಾಗೆ</para>
  <para style="q" vid="PSA 73:20">ಯೆಹೋವನೇ, ನೀನು ಏಳುವಾಗ ಅವರನ್ನು ಮಾಯಾರೂಪರೆಂದು ಭಾವಿಸುತ್ತೀ.<verse eid="PSA 73:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21"/>ನನ್ನ ಮನಸ್ಸು ನೊಂದುಹೋಗಿತ್ತು;</para>
  <para style="q" vid="PSA 73:21">ಆಂತರ್ಯದಲ್ಲಿ ಅಲಗು ನೆಟ್ಟಂತಿತ್ತು.<verse eid="PSA 73:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22"/>ನಾನು ವಿವೇಕಹೀನ ತಿಳಿವಳಿಕೆ ಇಲ್ಲದವನಂತೆ,</para>
  <para style="q" vid="PSA 73:22">ನಿನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೇವಲ ಪಶುವೇ ಆಗಿದ್ದೆನು.<verse eid="PSA 73:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23"/>ಆದರೂ ಸದಾ ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿಯೇ ಇದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 73:23">ನೀನು ನನ್ನ ಬಲಗೈಯನ್ನು ಹಿಡಿದು,<verse eid="PSA 73:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24"/>ನಿನ್ನ ಚಿತ್ತವನ್ನು ತಿಳಿಯಪಡಿಸಿ,</para>
  <para style="q" vid="PSA 73:24">ನನ್ನನ್ನು ನಡೆಸಿ ತರುವಾಯ ಮಹಿಮೆಗೆ ಸೇರಿಸಿಕೊಳ್ಳುವಿ.<verse eid="PSA 73:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25"/>ಪರಲೋಕದಲ್ಲಿ ನನಗೆ ನೀನಲ್ಲದೆ ಮತ್ತಾರು ಅವಶ್ಯ?</para>
  <para style="q" vid="PSA 73:25">ಇಹಲೋಕದಲ್ಲಿ ನಿನ್ನನ್ನಲ್ಲದೆ ಇನ್ನಾರನ್ನೂ ಬಯಸುವುದಿಲ್ಲ.<verse eid="PSA 73:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26"/>ತನುಮನಗಳು ಕ್ಷಯಿಸಿದರೂ</para>
  <para style="q" vid="PSA 73:26">ನನ್ನ ಆತ್ಮಕ್ಕೆ ಬಲವು<note caller="+" style="f"><char style="fr" closed="false">73:26 </char><char style="fq" closed="false">ಬಲವು </char><char style="ft" closed="false">ಅಥವಾ ಬಂಡೆ.</char></note></para>
  <para style="q" vid="PSA 73:26">ನನ್ನ ಶಾಶ್ವತವಾದ ಪಾಲೂ ದೇವರೇ.<verse eid="PSA 73:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27"/>ಇಗೋ, ನಿನ್ನನ್ನು ಬಿಟ್ಟವರು ನಾಶವಾಗುವರು;</para>
  <para style="q" vid="PSA 73:27">ನಿನಗೆ ದ್ರೋಹ ಮಾಡಿದವರೆಲ್ಲರನ್ನು ನಿರ್ಮೂಲ ಮಾಡುತ್ತೀ.<verse eid="PSA 73:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28"/>ನನಗಾದರೋ ದೇವರ ಸಾನ್ನಿಧ್ಯವೇ ಭಾಗ್ಯವು.</para>
  <para style="q" vid="PSA 73:28">ಕರ್ತನೇ, ಯೆಹೋವನೇ, ನಾನು ನಿನ್ನನ್ನು ಆಶ್ರಯಿಸಿಕೊಂಡವನಾಗಿ</para>
  <para style="q" vid="PSA 73:28">ನಿನ್ನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಪ್ರಕಟಿಸುವೆನು.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s">ದೇವಾಲಯವನ್ನು ಹಾಳುಮಾಡಿದ ಶತ್ರುಗಳನ್ನು ತಗ್ಗಿಸಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಆಸಾಫನ ಪದ್ಯ.</para>
  <para style="r">
    <ref loc="PSA 79">ಕೀರ್ತ 79</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1"/>ದೇವರೇ, ನೀನು ನಮ್ಮನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ತಳ್ಳಿಬಿಟ್ಟಿದ್ದೇಕೆ?</para>
  <para style="q" vid="PSA 74:1">ನೀನು ಪಾಲಿಸುವ ಹಿಂಡಿನ ಮೇಲೆ ನಿನ್ನ ಕೋಪಾಗ್ನಿಯ ಹೊಗೆ ಏರುವುದೇಕೆ?<verse eid="PSA 74:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2"/>ನೀನು ಹಿಂದಿನ ಕಾಲದಲ್ಲಿ ಸ್ವಕುಲವಾಗಿರಬೇಕೆಂದು</para>
  <para style="q" vid="PSA 74:2">ಬಿಡುಗಡೆ ಮಾಡಿ ಸಂಪಾದಿಸಿಕೊಂಡ ನಿನ್ನ ಸಭಾಮಂಡಲಿಯನ್ನು ಜ್ಞಾಪಿಸಿಕೋ;</para>
  <para style="q" vid="PSA 74:2">ನಿನ್ನ ವಾಸಸ್ಥಾನವಾಗಿದ್ದ ಚೀಯೋನ್ ಪರ್ವತವನ್ನು ಮರೆಯಬೇಡ.<verse eid="PSA 74:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3"/>ಬಹುಕಾಲದಿಂದ ಹಾಳುಬಿದ್ದಿರುವ ಈ ಸ್ಥಾನದ ಕಡೆಗೆ ನೀನು ಹೆಜ್ಜೆ ಹಾಕು.</para>
  <para style="q" vid="PSA 74:3">ನೋಡು, ವೈರಿಯು ಪವಿತ್ರಾಲಯದಲ್ಲಿ ಎಲ್ಲವನ್ನು ಕೆಡವಿಬಿಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 74:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4"/>ನಿನ್ನ ದರ್ಶನಾಲಯದ ಮಧ್ಯದಲ್ಲಿ ನಿನ್ನ ವಿರೋಧಿಗಳು ಆರ್ಭಟಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 74:4">ನಮ್ಮ ಆರಾಧನಾ ಚಿಹ್ನೆಗಳನ್ನು ತೆಗೆದು ತಮ್ಮ ಚಿಹ್ನೆಗಳನ್ನು ಇಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 74:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5"/>ಮರಗಳ ಗುಂಪಿನಲ್ಲಿ ಕೊಡಲಿಗಳನ್ನು ಮೇಲೆತ್ತುವ ಜನರೋ ಎಂಬಂತಿದ್ದಾರೆ.<verse eid="PSA 74:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6"/>ನೋಡು, ಅವರು ಈಗ ಕೈಕೊಡಲಿ ಮತ್ತು ಸುತ್ತಿಗೆಗಳಿಂದ,</para>
  <para style="q" vid="PSA 74:6">ದೇವಾಲಯದ ಕೆತ್ತನೆಯ ಕೆಲಸವನ್ನೆಲ್ಲಾ ಹೊಡೆದುಹಾಕುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 74:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7"/>ಅವರು ನಿನ್ನ ಪವಿತ್ರಾಲಯಕ್ಕೆ ಬೆಂಕಿ ಹಚ್ಚಿ,</para>
  <para style="q" vid="PSA 74:7">ನಿನ್ನ ನಾಮಕ್ಕೆ ಪ್ರತಿಷ್ಠಿತವಾದ ಮಂದಿರವನ್ನು ಹೊಲೆಮಾಡಿ, ನೆಲಸಮಗೊಳಿಸಿದ್ದಾರೆ.<verse eid="PSA 74:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8"/>“ನಾವು ಈ ಜನವನ್ನೆಲ್ಲಾ ಸಂಹರಿಸಿಬಿಡೋಣ” ಅಂದುಕೊಂಡಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 74:8">ದೇಶದಲ್ಲಿರುವ ನಿನ್ನ ಎಲ್ಲಾ ಸಭಾಮಂದಿರಗಳನ್ನು ಸುಟ್ಟುಬಿಟ್ಟಿದ್ದಾರೆ.<verse eid="PSA 74:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9"/>ನಮ್ಮ ಆರಾಧನಾ ಚಿಹ್ನೆಗಳು ಈಗ ಕಾಣುವುದಿಲ್ಲ.</para>
  <para style="q" vid="PSA 74:9">ಮುಂಚೆ ಇದ್ದಂತೆ ನಮಗೆ ಪ್ರವಾದಿಗಳು ಯಾರೂ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 74:9">ಇದು ಎಷ್ಟರವರೆಗೆ ಇರುವುದೆಂದು ಬಲ್ಲವರು ನಮ್ಮಲ್ಲಿ ಯಾರೂ ಇಲ್ಲ.<verse eid="PSA 74:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10"/>ದೇವರೇ, ವಿರೋಧಿಗಳು ಇನ್ನೆಲ್ಲಿಯ ತನಕ ನಿಂದಿಸುತ್ತಿರಬೇಕು?</para>
  <para style="q" vid="PSA 74:10">ವೈರಿಗಳು ನಿನ್ನ ನಾಮವನ್ನು ಸದಾಕಾಲವೂ ತಿರಸ್ಕರಿಸಬಹುದೋ?<verse eid="PSA 74:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11"/>ಚಾಚಿದ ಬಲಗೈಯನ್ನು ಏಕೆ ಹಿಂದೆಗೆದಿದ್ದೀ?</para>
  <para style="q" vid="PSA 74:11">ಅದನ್ನು ಎದೆಯ ಮೇಲಿನಿಂದ ತೆಗೆದು ಅವರನ್ನು ಸಂಹರಿಸಿಬಿಡು.<verse eid="PSA 74:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12"/>ದೇವರೇ, ನೀನು ಮೊದಲಿನಿಂದಲೂ ನನ್ನ ಅರಸನೂ,</para>
  <para style="q" vid="PSA 74:12">ಲೋಕಮಧ್ಯದಲ್ಲಿ ರಕ್ಷಣೆಗಳನ್ನು ನಡೆಸಿದಾತನೂ ಆಗಿದ್ದೀಯಲ್ಲವೇ?<verse eid="PSA 74:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13"/>ಸ್ವಶಕ್ತಿಯಿಂದ ಸಮುದ್ರವನ್ನು ಭೇದಿಸಿದವನು ನೀನು;</para>
  <para style="q" vid="PSA 74:13">ಜಲರಾಶಿಯ ಮೇಲೆ ತಿಮಿಂಗಿಲಗಳ ತಲೆಗಳನ್ನು ಜಜ್ಜಿಬಿಟ್ಟವನು ನೀನು.<verse eid="PSA 74:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14"/>ಲಿವ್ಯಾತಾನನ<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">ಲಿವ್ಯಾತಾನನ </char><char style="ft" closed="false">ಲಿವ್ಯಾತಾನ್ (104:26; ಯೆಶಾ 27:1) ಎಂಬುದು ಪೌರಾಣಿಕ ಘಟಸರ್ಪದ ಹೆಸರಾಗಿದೆ, ಇತರ ಸ್ಥಳಗಳಲ್ಲಿ ಬೇರೆ ಹೆಸರಿನಿಂದ ಕರೆಯಲ್ಪಟ್ಟಿದೆ. ಇದು ಅನೇಕ ತಲೆಗಳನ್ನು ಹೊಂದಿದೆಯೆಂದು ಭಾವಿಸಲಾಗಿದೆ. ಕೆಲವೊಮ್ಮೆ ನೀರಿನಲ್ಲಿರುವ ಘಟಸರ್ಪಗಳನ್ನು “ಕಡಲ ಮಹಾ ಹಾವುಗಳು” ಅಥವಾ “ಸಮುದ್ರದಲ್ಲಿ ವಾಸಿಸುವ ಮಹಾ ಪ್ರಾಣಿಗಳು” ಎಂದು ಅನುವಾದಿಸಲಾಗಿದೆ.</char></note> ಶಿರಚ್ಛೇದನೆಮಾಡಿ,</para>
  <para style="q" vid="PSA 74:14">ಅಡವಿಯ ಮೃಗಸಮುದಾಯಕ್ಕೆ<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">ಮೃಗಸಮುದಾಯಕ್ಕೆ </char><char style="ft" closed="false">ಅಥವಾ ಜನರಿಗೆ.</char></note> ಆಹಾರ ಕೊಟ್ಟವನು ನೀನು.<verse eid="PSA 74:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15"/>ಬುಗ್ಗೆಹಳ್ಳಗಳನ್ನು ಉಕ್ಕಿಸಿದವನು ನೀನು;</para>
  <para style="q" vid="PSA 74:15">ಮಹಾನದಿಗಳನ್ನು ಒಣಗಿಸಿಬಿಟ್ಟವನು ನೀನು.<verse eid="PSA 74:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16"/>ಹಗಲಿರುಳುಗಳನ್ನು ನೇಮಿಸಿದವನು ನೀನು;</para>
  <para style="q" vid="PSA 74:16">ಸೂರ್ಯ ಮತ್ತು ಜ್ಯೋತಿರ್ಮಂಡಲಗಳ ನಿರ್ಮಾಪಕನು ನೀನು.<verse eid="PSA 74:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17"/>ಭೂಮಿಯ ಎಲ್ಲಾ ಮೇರೆಗಳನ್ನು ಸ್ಥಾಪಿಸಿದವನು ನೀನು;</para>
  <para style="q" vid="PSA 74:17">ಬೇಸಿಗೆ ಮತ್ತು ಚಳಿಗಾಲಗಳನ್ನು ನೇಮಿಸಿದವನು ನೀನು.<verse eid="PSA 74:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18"/>ಯೆಹೋವನೇ, ವೈರಿಗಳು ನಿನ್ನನ್ನು ನಿಂದಿಸಿದ್ದನ್ನು,</para>
  <para style="q" vid="PSA 74:18">ದುರ್ಮತಿಗಳು ನಿನ್ನ ನಾಮವನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದನ್ನು ಜ್ಞಾಪಿಸಿಕೋ.<verse eid="PSA 74:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19"/>ನಿನ್ನ ಬೆಳವಕ್ಕಿಯ ಜೀವವನ್ನು ಕಾಡುಮೃಗಕ್ಕೆ ಕೊಡಬೇಡ;</para>
  <para style="q" vid="PSA 74:19">ನಿನ್ನ ದೀನಮಂಡಲಿಯನ್ನು ಸದಾ ಮರೆಯಬೇಡ.<verse eid="PSA 74:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20"/>ನಿನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದುಕೋ.</para>
  <para style="q" vid="PSA 74:20">ದೇಶದ ಅಂಧಕಾರ ಸ್ಥಾನಗಳಲ್ಲಿ ಬಲತ್ಕಾರವು ತುಂಬಿ ವಾಸಿಸುತ್ತದಲ್ಲಾ.<verse eid="PSA 74:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21"/>ಕುಗ್ಗಿದವರು ಆಶಾಭಂಗದಿಂದ ಹಿಂದಿರುಗದಿರಲಿ;</para>
  <para style="q" vid="PSA 74:21">ದುಃಖಿತರೂ, ಬಡವರೂ ನಿನ್ನ ನಾಮವನ್ನು ಕೀರ್ತಿಸಲಿ.<verse eid="PSA 74:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22"/>ದೇವರೇ, ಎದ್ದು ನಿನ್ನ ನ್ಯಾಯವನ್ನು ನಡೆಸುವವನಾಗು;</para>
  <para style="q" vid="PSA 74:22">ದುರ್ಮತಿಯು ಯಾವಾಗಲೂ ನಿನ್ನನ್ನು ನಿಂದಿಸುತ್ತಿರುವುದನ್ನು ಜ್ಞಾಪಿಸಿಕೋ.<verse eid="PSA 74:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23"/>ಮೇಲಣ ಲೋಕವನ್ನು ಎಡೆಬಿಡದೆ ಮುಟ್ಟುತ್ತಿರುವ,</para>
  <para style="q" vid="PSA 74:23">ನಿನ್ನ ವೈರಿಗಳ ಗದ್ದಲವನ್ನೂ ನಿನ್ನ ವಿರೋಧಿಗಳ ದೊಂಬಿಯನ್ನೂ ಮರೆಯದಿರು.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s">ನ್ಯಾಯಾಧೀಶನಾದ ದೇವರಿಗೆ ಸ್ತುತಿ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಅಲ್ತಷ್ಖೇತೆಂಬ ರಾಗ; ಕೀರ್ತನೆ; ಹಾಡು; ಆಸಾಫನದು.</para>
  <para style="r">
    <ref loc="PSA 57">ಕೀರ್ತ 57</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1"/>ದೇವರೇ, ಕೊಂಡಾಡುತ್ತೇವೆ;</para>
  <para style="q" vid="PSA 75:1">ನಿನ್ನನ್ನು ಕೊಂಡಾಡುತ್ತೇವೆ. ನಿನ್ನ ನಾಮ ಮಹತ್ವವನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡು;</para>
  <para style="q" vid="PSA 75:1">ನಿನ್ನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ವರ್ಣಿಸುತ್ತೇವೆ.<verse eid="PSA 75:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2"/>ದೇವರು ನುಡಿದದ್ದು, “ನಿಯಮಿತ ಕಾಲವು ಬಂದಾಗ,</para>
  <para style="q" vid="PSA 75:2">ನಾನೇ ನೀತಿಯಿಂದ ತೀರ್ಪುಕೊಡುವೆನು.<verse eid="PSA 75:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3"/>ಎಲ್ಲಾ ನಿವಾಸಿಗಳೊಡನೆ ಭೂಮಿಯು ಕರಗಿ ಹೋದರೂ,</para>
  <para style="q" vid="PSA 75:3">ಅದರ ಸ್ತಂಭಗಳನ್ನು ಸ್ಥಾಪಿಸುವವನು ನಾನೇ” ಎಂಬುದು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 75:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4"/>ನಾನು ಹೆಮ್ಮೆಗಾರರಿಗೆ, “ಕೊಚ್ಚಿಕೊಳ್ಳಬೇಡಿರಿ” ಎಂದು;</para>
  <para style="q" vid="PSA 75:4">ದುಷ್ಟರಿಗೆ, “ನಿಮ್ಮ ಕೊಂಬುಗಳನ್ನು ಮೇಲೆತ್ತಬೇಡಿರಿ;<verse eid="PSA 75:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5"/>ಕೊಂಬುಗಳನ್ನು ಮೇಲೆತ್ತಬೇಡಿರಿ;</para>
  <para style="q" vid="PSA 75:5">ಸೊಕ್ಕಿನಿಂದ ಮಾತನಾಡಬೇಡಿರಿ” ಎಂದು ಹೇಳುವೆನು.<verse eid="PSA 75:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6"/>ಏಕೆಂದರೆ ಉದ್ಧಾರವು ಪೂರ್ವದಿಂದಾಗಲಿ, ಪಶ್ಚಿಮದಿಂದಾಗಲಿ,</para>
  <para style="q" vid="PSA 75:6">ಅರಣ್ಯದಿಂದಾಗಲಿ ಬರುವುದಿಲ್ಲ.<verse eid="PSA 75:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7"/>ದೇವರೇ ನ್ಯಾಯಾಧೀಶನಾಗಿ ಒಬ್ಬನನ್ನು ತೆಗೆದು,</para>
  <para style="q" vid="PSA 75:7">ಇನ್ನೊಬ್ಬನನ್ನು ಸ್ಥಾಪಿಸುತ್ತಾನೆ.<verse eid="PSA 75:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8"/>ಯೆಹೋವನ ಕೈಯಲ್ಲಿ ಪಾತ್ರೆ ಇದೆ;</para>
  <para style="q" vid="PSA 75:8">ಅದು ಔಷಧಿಮಿಶ್ರವಾಗಿ ಉಕ್ಕುವ ದ್ರಾಕ್ಷಾರಸದಿಂದ ತುಂಬಿದೆ.</para>
  <para style="q" vid="PSA 75:8">ಅದರಿಂದ ಹೊಯ್ದು ಹಂಚುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 75:8">ಲೋಕದ ದುಷ್ಟರೆಲ್ಲರೂ ಅದರೊಳಗಿನ ಮಡ್ಡಿಯನ್ನು ಸಹ ಕುಡಿದು ಮುಗಿಸಬೇಕು.<verse eid="PSA 75:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9"/>ನಾನಾದರೋ ಸದಾ ವರ್ಣಿಸುವವನಾಗಿ,</para>
  <para style="q" vid="PSA 75:9">ಯಾಕೋಬ ವಂಶದವರ ದೇವರನ್ನು ಸಂಕೀರ್ತಿಸುತ್ತಾ ವರ್ಣಿಸಿ ಹಾಡುವೆನು.<verse eid="PSA 75:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10"/>ದುಷ್ಟರ ಕೊಂಬುಗಳನ್ನೆಲ್ಲಾ<note caller="+" style="f"><char style="fr" closed="false">75:10 </char><char style="fq" closed="false">ಕೊಂಬುಗಳನ್ನೆಲ್ಲಾ </char><char style="ft" closed="false">ಅಥವಾ ಬಲವನ್ನು.</char></note> ಮುರಿದುಬಿಡುವೆನು;</para>
  <para style="q" vid="PSA 75:10">ಆದರೆ ನೀತಿವಂತರ ಕೊಂಬುಗಳನ್ನು <note caller="+" style="f"><char style="fr" closed="false">75:10 </char><char style="fq" closed="false">ಕೊಂಬುಗಳನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಬಲವನ್ನು.</char></note>ಉನ್ನತಮಟ್ಟಕ್ಕೆ ಎತ್ತಲ್ಪಡುವವು.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s">ಮಹಾಭಯಂಕರನಾದ ದೇವರಿಗೆ ಸ್ತುತಿ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ತಂತಿವಾದ್ಯದೊಡನೆ ಹಾಡತಕ್ಕದ್ದು; ಕೀರ್ತನೆ; ಆಸಾಫನ ಹಾಡು.</para>
  <para style="r">
    <ref loc="PSA 75">ಕೀರ್ತ 75</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1"/>ದೇವರು ಯೆಹೂದ ದೇಶದಲ್ಲಿ ಪ್ರಸಿದ್ಧಗೊಂಡವನು;</para>
  <para style="q" vid="PSA 76:1">ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಆತನ ನಾಮವು ದೊಡ್ಡದು.<verse eid="PSA 76:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2"/>ಸಾಲೇಮಿನಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">76:2 </char><char style="fq" closed="false">ಸಾಲೇಮಿನಲ್ಲಿ </char><char style="ft" closed="false">ಅಥವಾ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ.</char></note> ಆತನ ಬಿಡಾರವಿದೆ;</para>
  <para style="q" vid="PSA 76:2">ಚೀಯೋನಿನಲ್ಲಿ ಆತನು ವಾಸಿಸುತ್ತಾನೆ.<verse eid="PSA 76:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3"/>ಅಲ್ಲಿ ಆತನು ಮಿಂಚಿನಂತೆ ಹಾರಿ ಬರುವ ಬಾಣಗಳನ್ನೂ,</para>
  <para style="q" vid="PSA 76:3">ಗುರಾಣಿ, ಖಡ್ಗ ಮುಂತಾದ ಯುದ್ಧ ಆಯುಧಗಳನ್ನೂ ಮುರಿದುಬಿಟ್ಟಿದ್ದಾನೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 76:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4"/>ನೀನು ತೇಜೋಮಯನು;</para>
  <para style="q" vid="PSA 76:4">ಕೊಳ್ಳೆಹೊಡೆದ ಬೆಟ್ಟಗಳಿಗಿಂತ ಘನ ಗಾಂಭೀರ್ಯಯುಳ್ಳವನು.<verse eid="PSA 76:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5"/>ಧೀರಹೃದಯರು ಸುಲಿಗೆಯಾಗಿ ದೀರ್ಘನಿದ್ರೆ ಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 76:5">ಎಲ್ಲಾ ಶೂರರ ಕೈಗಳು ಬಿದ್ದುಹೋದವು.<verse eid="PSA 76:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6"/>ಯಾಕೋಬ ವಂಶದವರ ದೇವರೇ,</para>
  <para style="q" vid="PSA 76:6">ನಿನ್ನ ಗದರಿಕೆಯಿಂದ ರಥಬಲವೂ, ಅಶ್ವಬಲವೂ ಮೈಮರೆತು ಹೋದವು.<verse eid="PSA 76:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7"/>ನೀನು ಮಹಾಶಕ್ತಿಶಾಲಿ;</para>
  <para style="q" vid="PSA 76:7">ನೀನು ಸಿಟ್ಟುಗೊಂಡಾಗ ನಿನ್ನ ಮುಂದೆ ಯಾರು ನಿಂತಾರು?<verse eid="PSA 76:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8"/>ಪರಲೋಕದಲ್ಲಿರುವ ನೀನು ನಿನ್ನ ನ್ಯಾಯವಿಧಿಯನ್ನು ಆಜ್ಞಾಪಿಸುವಾಗ,<verse eid="PSA 76:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9"/>ದೇವರು ಲೋಕದ ದೀನರನ್ನು ರಕ್ಷಿಸಿ,</para>
  <para style="q" vid="PSA 76:9">ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುವುದಕ್ಕೋಸ್ಕರ ಎದ್ದು ಬಂದಿದ್ದಾನೆಂದು</para>
  <para style="q" vid="PSA 76:9">ಭೂನಿವಾಸಿಗಳು ಭಯದಿಂದ ಸ್ತಬ್ಧರಾದರು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 76:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10"/>ಮನುಷ್ಯರ ಮೇಲಿನ ಕೋಪವೂ ನಿನ್ನ ಘನತೆಗೆ ಸಾಧನವಾಗುವುದು;</para>
  <para style="q" vid="PSA 76:10">ಕೋಪಶೇಷವನ್ನು ನಡುಕಟ್ಟಿನಂತೆ ಬಿಗಿದುಕೊಳ್ಳುವಿ<note caller="+" style="f"><char style="fr" closed="false">76:10 </char><char style="fq" closed="false">ಕೋಪಶೇಷವನ್ನು ನಡುಕಟ್ಟಿನಂತೆ ಬಿಗಿದುಕೊಳ್ಳುವಿ </char><char style="ft" closed="false">ಅಥವಾ ಯುದ್ಧದ ನಂತರ ಉಳಿದ ಜನರು ನಿನ್ನ ಹಬ್ಬವನ್ನು ಆರಿಸುತ್ತಾರೆ. </char></note>.<verse eid="PSA 76:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11"/>ನಿಮ್ಮ ದೇವನಾದ ಯೆಹೋವನಿಗೆ ಹರಕೆಮಾಡಿ ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="q" vid="PSA 76:11">ಅವನ ಸುತ್ತಲಿರುವ ಜನರು ಮಹಾಮಹಿಮನಿಗೆ ಕಾಣಿಕೆಗಳನ್ನು ಸಮರ್ಪಿಸಲಿ.<verse eid="PSA 76:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12"/>ಆತನು ಭೂಪತಿಗಳಿಗೆ ಭಯಪ್ರದರಾಗಿದ್ದ</para>
  <para style="q" vid="PSA 76:12">ಪ್ರಭುಗಳ ಅಹಂಭಾವವನ್ನು ಮುರಿದುಬಿಡುವನು.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s">ದೇವರ ಮಹತ್ಕಾರ್ಯಗಳ ಧ್ಯಾನ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಯೆದುತೂನನ ರೀತಿಯಲ್ಲಿ ಹಾಡತಕ್ಕದ್ದು; ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1"/>ದೇವರಿಗೆ ಮೊರೆಯಿಡುವೆನು, ಕೂಗಿ ಮೊರೆಯಿಡುವೆನು;</para>
  <para style="q" vid="PSA 77:1">ಆತನು ನನಗೆ ಕಿವಿಗೊಡುವನು.<verse eid="PSA 77:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2"/>ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಸ್ವಾಮಿಯನ್ನು ಕರೆದೆನು;</para>
  <para style="q" vid="PSA 77:2">ಬೇಸರವಿಲ್ಲದೆ ರಾತ್ರಿಯೆಲ್ಲಾ ಕೈಚಾಚಿಕೊಂಡೇ ಇದ್ದೆನು.</para>
  <para style="q" vid="PSA 77:2">ನನ್ನ ಮನಸ್ಸು ಶಾಂತಿಯನ್ನು ಹೊಂದಲೊಲ್ಲದೆ ಇತ್ತು.<verse eid="PSA 77:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3"/>ನಾನು ವ್ಯಥೆಪಡುತ್ತಾ ದೇವರನ್ನು ಸ್ಮರಿಸುವೆನು;</para>
  <para style="q" vid="PSA 77:3">ಮನಗುಂದಿದವನಾಗಿಯೇ ಹಂಬಲಿಸುವೆನು.<verse eid="PSA 77:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4"/>ನಾನು ರೆಪ್ಪೆಗಳನ್ನು ಮುಚ್ಚದಂತೆ ನೀನು ಮಾಡಿದಿ.</para>
  <para style="q" vid="PSA 77:4">ತಳಮಳಗೊಂಡು ಮಾತನಾಡಲಾರದೆ ಇದ್ದೆನು.<verse eid="PSA 77:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5"/>ಹಳೆಯ ದಿನಗಳನ್ನೂ,</para>
  <para style="q" vid="PSA 77:5">ಪುರಾತನ ವರ್ಷಗಳನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡೆನು.<verse eid="PSA 77:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6"/>ನಾನು ರಾತ್ರಿಯಲ್ಲಿ ಮಾಡುತ್ತಿದ್ದ ಗಾನವನ್ನು ನೆನಪಿಸಿಕೊಳ್ಳುವೆನು,</para>
  <para style="q" vid="PSA 77:6">ನನ್ನ ಆಂತರ್ಯದಲ್ಲಿ ಮಾತನಾಡಿಕೊಳ್ಳುವೆನು ಅಂದುಕೊಂಡು</para>
  <para style="q" vid="PSA 77:6">ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ,<verse eid="PSA 77:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7"/>“ಕರ್ತನು ಸದಾಕಾಲಕ್ಕೂ ಬಿಟ್ಟೇಬಿಡುವನೋ?</para>
  <para style="q" vid="PSA 77:7">ಆತನು ಪುನಃ ಪ್ರಸನ್ನನಾಗುವುದಿಲ್ಲವೋ?<verse eid="PSA 77:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8"/>ಆತನ ಕೃಪಾವಾತ್ಸಲ್ಯವು ನಿಂತೇ ಹೋಯಿತೋ?</para>
  <para style="q" vid="PSA 77:8">ಆತನ ವಾಗ್ದಾನವು ಎಂದೆಂದಿಗೂ ಬಿದ್ದೇ ಹೋಯಿತೋ?<verse eid="PSA 77:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9"/>ದೇವರು ದಯೆ ತೋರಿಸಲಿಕ್ಕೆ ಮರೆತುಬಿಟ್ಟನೋ?</para>
  <para style="q" vid="PSA 77:9">ಕೋಪದಿಂದ ತನ್ನ ಕರಳುಗಳನ್ನು ಬಿಗಿಹಿಡಿದಿದ್ದಾನೋ?” ಎಂದು ಅಂದುಕೊಂಡೆನು <char style="qs">ಸೆಲಾ </char><verse eid="PSA 77:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10"/>ಪುನಃ ನಾನು,</para>
  <para style="q" vid="PSA 77:10">“ಹೀಗೆ ನೆನಸುವುದು ನನ್ನ ಬಲಹೀನತೆಯೇ.</para>
  <para style="q" vid="PSA 77:10">ಪರಾತ್ಪರನಾದ ದೇವರ ಭುಜಬಲವು ಪ್ರಕಟವಾದ ವರ್ಷಗಳನ್ನು ಜ್ಞಾಪಿಸಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 77:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11"/>ಯೆಹೋವನ ಕೃತ್ಯಗಳನ್ನು ವರ್ಣಿಸುವೆನು;</para>
  <para style="q" vid="PSA 77:11">ಪೂರ್ವದಿಂದ ನೀನು ನಡೆಸಿದ ಅದ್ಭುತಗಳನ್ನು ನೆನಪು ಮಾಡಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 77:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12"/>ನಿನ್ನ ಕಾರ್ಯಗಳನ್ನೆಲ್ಲಾ ಧ್ಯಾನಿಸುವೆನು;</para>
  <para style="q" vid="PSA 77:12">ನಿನ್ನ ಪ್ರವರ್ತನೆಗಳನ್ನು ಸ್ಮರಿಸುವೆನು” ಅಂದುಕೊಂಡೆನು.<verse eid="PSA 77:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13"/>ದೇವರೇ, ನಿನ್ನ ಮಾರ್ಗವು ಪರಿಶುದ್ಧವಾದುದು.</para>
  <para style="q" vid="PSA 77:13">ನಮ್ಮ ದೇವರಂತೆ ಮಹತ್ವವುಳ್ಳ ದೇವರು ಯಾರು?<verse eid="PSA 77:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14"/>ಅದ್ಭುತಗಳನ್ನು ನಡೆಸುವ ದೇವರು ನೀನೇ;</para>
  <para style="q" vid="PSA 77:14">ಜನಾಂಗಗಳಲ್ಲಿ ಪರಾಕ್ರಮವನ್ನು ತೋರ್ಪಡಿಸಿದಿ.<verse eid="PSA 77:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15"/>ಯಾಕೋಬ ಮತ್ತು ಯೋಸೇಫರ ವಂಶದವರಾದ ನಿನ್ನ ಪ್ರಜೆಯನ್ನು,</para>
  <para style="q" vid="PSA 77:15">ಭುಜಬಲದಿಂದ ಬಿಡುಗಡೆಮಾಡಿದಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 77:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16"/>ದೇವರೇ, ಜಲರಾಶಿಗಳು ನಿನ್ನನ್ನು ಕಂಡವು;</para>
  <para style="q" vid="PSA 77:16">ಕಾಣುತ್ತಲೇ ತಳಮಳಗೊಂಡು</para>
  <para style="q" vid="PSA 77:16">ತಳದವರೆಗೂ ಅಲ್ಲಕಲ್ಲೋಲವಾದವು.<verse eid="PSA 77:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17"/>ಮೇಘಮಂಡಲವು ಮಳೆಗರೆಯಿತು;</para>
  <para style="q" vid="PSA 77:17">ಆಕಾಶವು ಗರ್ಜಿಸಿತು;</para>
  <para style="q" vid="PSA 77:17">ನಿನ್ನ ಬಾಣಗಳು ಎಲ್ಲಾ ಕಡೆಯೂ ಹಾರಿದವು.<verse eid="PSA 77:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18"/>ಬಿರುಗಾಳಿಯಲ್ಲಿ ನಿನ್ನ ಗುಡುಗು ಕೇಳಿಸಿತು;</para>
  <para style="q" vid="PSA 77:18">ಮಿಂಚುಗಳು ಭೂಮಂಡಲವನ್ನು ಬೆಳಗಿಸಿದವು;</para>
  <para style="q" vid="PSA 77:18">ಭೂಮಿಯು ಅಲ್ಲಾಡಿ ಕಂಪಿಸಿತು.<verse eid="PSA 77:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19"/>ನೀನು ಸಮುದ್ರದಲ್ಲಿ ಮಾರ್ಗಮಾಡಿದಿ;</para>
  <para style="q" vid="PSA 77:19">ಮಹಾಜಲರಾಶಿಗಳನ್ನು ದಾಟಿದಿ;</para>
  <para style="q" vid="PSA 77:19">ನಿನ್ನ ಹೆಜ್ಜೆ ಗುರುತು ಕಾಣಲಿಲ್ಲ.<verse eid="PSA 77:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20"/>ಕುರುಬನು ಕುರಿಹಿಂಡನ್ನು ಹೇಗೋ,</para>
  <para style="q" vid="PSA 77:20">ಹಾಗೆಯೇ ನೀನು ಮೋಶೆ ಮತ್ತು ಆರೋನರ ಮುಖಾಂತರ,</para>
  <para style="q" vid="PSA 77:20">ನಿನ್ನ ಪ್ರಜೆಯನ್ನು ಮುನ್ನಡೆಸಿದಿ.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s">ಇಸ್ರಾಯೇಲರ ಉಪದೇಶಯುಕ್ತವಾದ ಪೂರ್ವಚರಿತ್ರೆ</para>
  <para style="d">ಆಸಾಫನ ಪದ್ಯ.</para>
  <para style="r">
    <ref loc="PSA 105">ಕೀರ್ತ 105</ref>; <ref loc="PSA 106">106</ref>; <ref loc="DEU 32">ಧರ್ಮೋ 32</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1"/>ನನ್ನ ಜನರೇ, ನನ್ನ ಉಪದೇಶವನ್ನು ಕೇಳಿರಿ;</para>
  <para style="q" vid="PSA 78:1">ನನ್ನ ನುಡಿಗಳನ್ನು ಕಿವಿಗೊಟ್ಟು ಲಾಲಿಸಿರಿ.<verse eid="PSA 78:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2"/>ನಾನು ಬಾಯ್ದೆರೆದು ಸಾಮ್ಯರೂಪವಾಗಿ ಉಪದೇಶಿಸುವೆನು.</para>
  <para style="q" vid="PSA 78:2">ಪೂರ್ವಕಾಲದ ಗೂಢಾರ್ಥಗಳನ್ನು ಬಹಿರಂಗಪಡಿಸುವೆನು.<verse eid="PSA 78:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3"/>ನಾವು ನಮ್ಮ ಹಿರಿಯರ ಬಾಯಿಂದ ತಿಳಿದ ಸಂಗತಿಗಳನ್ನು,</para>
  <para style="q" vid="PSA 78:3">ಅವರ ಸಂತಾನದವರಿಗೆ ಮರೆಮಾಡದೆ,<verse eid="PSA 78:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4"/>ಯೆಹೋವನ ಘನತೆಯನ್ನು, ಆತನ ಪರಾಕ್ರಮವನ್ನು,</para>
  <para style="q" vid="PSA 78:4">ಅದ್ಭುತಕೃತ್ಯಗಳನ್ನು ಮುಂದಣ ಸಂತತಿಯವರಿಗೆ ವಿವರಿಸುವೆವು.<verse eid="PSA 78:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5"/>ಆತನು ಯಾಕೋಬವಂಶದಲ್ಲಿ ತನ್ನ ಕಟ್ಟಳೆಯನ್ನಿಟ್ಟು,</para>
  <para style="q" vid="PSA 78:5">ಇಸ್ರಾಯೇಲರಿಗೆ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಕೊಟ್ಟು,</para>
  <para style="q" vid="PSA 78:5">ನಮ್ಮ ಹಿರಿಯರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ್ದೇನೆಂದರೆ, “ಇವುಗಳನ್ನು ನಿಮ್ಮ ಮಕ್ಕಳಿಗೆ ಹೇಳಿಕೊಡಿರಿ;<verse eid="PSA 78:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6"/>ಇದರಿಂದ ಅವು ಅವರ ಮುಂದಿನ ಪೀಳಿಗೆಗೆ ಗೊತ್ತಾಗಿ,</para>
  <para style="q" vid="PSA 78:6">ಅವರ ಮಕ್ಕಳು ಅವುಗಳನ್ನು ತಮ್ಮ ಮಕ್ಕಳು ಮತ್ತು ಮೊಮ್ಮಕ್ಕಳಿಗೆ ತಿಳಿಸುತ್ತಾ ಹೋಗುವರು.<verse eid="PSA 78:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7"/>ಆಗ ಅವರು ಮೊಂಡರೂ, ಅವಿಧೇಯರೂ, ಚಪಲಚಿತ್ತರೂ,</para>
  <para style="q" vid="PSA 78:7">ದೇವದ್ರೋಹಿಗಳೂ ಆದ ತಮ್ಮ ಪೂರ್ವಿಕರಂತೆ ಆಗದೆ,<verse eid="PSA 78:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8"/>ನನ್ನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮರೆಯದೆ, ನನ್ನಲ್ಲಿಯೇ ಭರವಸೆಯಿಟ್ಟು,</para>
  <para style="q" vid="PSA 78:8">ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳುವರು” ಎಂಬುದೇ.<verse eid="PSA 78:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9"/>ಎಫ್ರಾಯೀಮ್ ಕುಲದವರು ಬಿಲ್ಲುಗಳಿಂದ ಸಿದ್ಧರಾಗಿ,</para>
  <para style="q" vid="PSA 78:9">ಯುದ್ಧಸಮಯದಲ್ಲಿ ಹಿಂದಿರುಗಿ ಓಡಿಹೋದರು.<verse eid="PSA 78:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10"/>ಅವರು ದೇವರ ನಿಬಂಧನೆಯನ್ನು ಪಾಲಿಸಲಿಲ್ಲ,</para>
  <para style="q" vid="PSA 78:10">ಆತನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಅನುಸರಿಸಲು ಮನಸ್ಸು ಮಾಡಲಿಲ್ಲ.<verse eid="PSA 78:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11"/>ಆತನ ಕಾರ್ಯಗಳನ್ನು, ಆತನು ತಮ್ಮೆದುರಿನಲ್ಲಿ ನಡೆಸಿದ</para>
  <para style="q" vid="PSA 78:11">ಅದ್ಭುತಗಳನ್ನು ಮರೆತುಬಿಟ್ಟರು.<verse eid="PSA 78:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12"/>ಆತನು ಐಗುಪ್ತದೇಶದ ಸೋನ್ ಸೀಮೆಯಲ್ಲಿ,</para>
  <para style="q" vid="PSA 78:12">ಅವರ ಪೂರ್ವಿಕರ ಸಮಕ್ಷದಲ್ಲಿಯೇ ಆಶ್ಚರ್ಯ ಕ್ರಿಯೆಗಳನ್ನು ನಡೆಸಿದನು.<verse eid="PSA 78:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13"/>ಆತನು ಸಮುದ್ರವನ್ನು ವಿಭಾಗಿಸಿ,</para>
  <para style="q" vid="PSA 78:13">ಅದರ ನೀರನ್ನು ರಾಶಿಯಾಗಿ ನಿಲ್ಲುವಂತೆ ಮಾಡಿ, ಅವರನ್ನು ದಾಟಿಸಿದನು.<verse eid="PSA 78:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14"/>ಹಗಲಿನಲ್ಲಿ ಮೋಡದಿಂದಲೂ, ರಾತ್ರಿಯಲ್ಲಿ ಬೆಂಕಿಯ ಬೆಳಕಿನಿಂದಲೂ,</para>
  <para style="q" vid="PSA 78:14">ಆತನು ಅವರನ್ನು ಕರೆದೊಯ್ದನು.<verse eid="PSA 78:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15"/>ಆತನು ಅರಣ್ಯದಲ್ಲಿ ಬಂಡೆಗಳನ್ನು ಸೀಳಿ,</para>
  <para style="q" vid="PSA 78:15">ಅವರಿಗೆ ಸಾಗರದಿಂದಲೋ ಎಂಬಂತೆ ಧಾರಾಳವಾಗಿ ನೀರು ಕುಡಿಸಿದನು.<verse eid="PSA 78:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16"/>ಗಿರಿಶಿಲೆಯಿಂದ ಜಲಪ್ರವಾಹಗಳನ್ನು ಹೊರಡಿಸಿ,</para>
  <para style="q" vid="PSA 78:16">ನದಿಗಳಾಗಿ ಹರಿಯಮಾಡಿದನು.<verse eid="PSA 78:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17"/>ಆದರೂ ಅವರು ನಿರ್ಜಲಪ್ರದೇಶದಲ್ಲಿ ಪರಾತ್ಪರನಾದ ದೇವರಿಗೆ ಪದೇಪದೇ ಅವಿಧೇಯರಾಗಿ,</para>
  <para style="q" vid="PSA 78:17">ಇನ್ನೂ ಹೆಚ್ಚು ಪಾಪಮಾಡುತ್ತಾ ಬಂದರು.<verse eid="PSA 78:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18"/>ಅವರು ಇಷ್ಟಭೋಜನವನ್ನು ಕೇಳಿಕೊಳ್ಳುವಾಗ,</para>
  <para style="q" vid="PSA 78:18">ಸಂಶಯ ಮನಸ್ಸಿನಿಂದ ದೇವರನ್ನು ಪರೀಕ್ಷಿಸಿದರು.<verse eid="PSA 78:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19"/>ಅವರು ಆತನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q" vid="PSA 78:19">“ದೇವರು ಅರಣ್ಯದಲ್ಲಿ ಊಟಕ್ಕೆ ಬಡಿಸಬಲ್ಲನೋ?<verse eid="PSA 78:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20"/>ಬಂಡೆಯನ್ನು ಹೊಡೆದು, ನೀರು ಚಿಮ್ಮಿ ಹೊರಗೆ ಬರುವಂತೆಯೂ,</para>
  <para style="q" vid="PSA 78:20">ಪ್ರವಾಹವು ದಡಮೀರಿ ಹರಿಯುವಂತೆಯೂ ಮಾಡಿದನಲ್ಲವೋ?</para>
  <para style="q" vid="PSA 78:20">ಆತನು ರೊಟ್ಟಿಯನ್ನು ಕೊಡಲು ಶಕ್ತನೋ?</para>
  <para style="q" vid="PSA 78:20">ತನ್ನ ಜನರಿಗೆ ಮಾಂಸವನ್ನೂ ಒದಗಿಸುವನೋ” ಎಂಬುದೇ.<verse eid="PSA 78:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21"/>ಯೆಹೋವನು ಇದನ್ನು ಕೇಳಿ ರೋಷಗೊಂಡನು.</para>
  <para style="q" vid="PSA 78:21">ಅವರು ದೇವರಲ್ಲಿ ಭರವಸವಿಡದೆಯೂ,</para>
  <para style="q" vid="PSA 78:21">ಆತನ ರಕ್ಷಣೆಯನ್ನು ನಂಬದೆ ಹೋದುದರಿಂದಲೂ,<verse eid="PSA 78:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22"/>ಆತನಿಗೆ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಕೋಪವುಂಟಾಯಿತು;</para>
  <para style="q" vid="PSA 78:22">ಯಾಕೋಬ್ ವಂಶದವರಲ್ಲಿ ಬೆಂಕಿ ಹತ್ತಿತು.<verse eid="PSA 78:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23"/>ಆತನು ಮೇಘಗಳಿಗೆ ಅಪ್ಪಣೆಕೊಟ್ಟು ಆಕಾಶದ್ವಾರಗಳನ್ನು ತೆರೆದು,<verse eid="PSA 78:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24"/>ಸ್ವರ್ಗಧಾನ್ಯವಾದ ಮನ್ನವನ್ನು ಅವರಿಗೋಸ್ಕರ ಸುರಿಸಿ,</para>
  <para style="q" vid="PSA 78:24">ಉಣ್ಣಲಿಕ್ಕೆ ಕೊಟ್ಟನು.<verse eid="PSA 78:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25"/>ಅವರಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ದೇವದೂತರ ಆಹಾರವನ್ನು ಸೇವಿಸಿದನು.</para>
  <para style="q" vid="PSA 78:25">ಆತನು ಅವರಿಗೆ ಭೋಜನವನ್ನು ಸಂತೃಪ್ತಿಯಾಗಿ ಅನುಗ್ರಹಿಸಿದನು.<verse eid="PSA 78:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26"/>ಆತನು ಗಗನಮಂಡಲದಲ್ಲಿ ಮೂಡಣ ಗಾಳಿಯನ್ನು ಉಂಟುಮಾಡಿ,</para>
  <para style="q" vid="PSA 78:26">ಪ್ರತಾಪದಿಂದ ತೆಂಕಣ ಗಾಳಿಯನ್ನೂ ಹೊಡೆದುಕೊಂಡು ಬಂದು,<verse eid="PSA 78:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27"/>ಧೂಳಿನಷ್ಟು ಮಾಂಸವೃಷ್ಟಿಯನ್ನು ಸುರಿಸಿದನು;</para>
  <para style="q" vid="PSA 78:27">ಸಮುದ್ರದ ಮರಳಿನಷ್ಟು ಪಕ್ಷಿಗಳು ಅವರಿದ್ದಲ್ಲಿ ಬೀಳುವಂತೆ ಮಾಡಿದನು.<verse eid="PSA 78:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28"/>ಅವು ಪಾಳೆಯದ ಮಧ್ಯದಲ್ಲಿಯೇ ಅವರ ಬಿಡಾರಗಳ ಸುತ್ತಲೂ ಬಿದ್ದವು.<verse eid="PSA 78:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29"/>ಅವರು ತಿಂದು ಸಂತೃಪ್ತರಾದರು;</para>
  <para style="q" vid="PSA 78:29">ಆತನು ಅವರಿಗೆ ಬಯಸಿದ್ದನ್ನು ಕೊಟ್ಟನು.<verse eid="PSA 78:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30"/>ಅವರ ಇಷ್ಟಭೋಜನವು ಅವರಿಗೆ ಅಸಹ್ಯವಾಗುವುದಕ್ಕಿಂತ ಮೊದಲು,</para>
  <para style="q" vid="PSA 78:30">ಅವರು ಅದನ್ನು ಇನ್ನೂ ಸೇವಿಸುತ್ತಿರುವಾಗಲೇ,<verse eid="PSA 78:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31"/>ದೇವರ ಕೋಪವು ಅವರಿಗೆ ವಿರುದ್ಧವಾಗಿ ಎದ್ದು,</para>
  <para style="q" vid="PSA 78:31">ಅವರಲ್ಲಿ ಕೊಬ್ಬಿದವರನ್ನು ವಧಿಸಿ,</para>
  <para style="q" vid="PSA 78:31">ಇಸ್ರಾಯೇಲರ ಪ್ರಾಯಸ್ಥರನ್ನು ನೆಲಕ್ಕುರುಳಿಸಿತು.<verse eid="PSA 78:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32"/>ಇಷ್ಟಾದರೂ ಪುನಃ ಪುನಃ ಪಾಪಮಾಡುತ್ತಾ ಬಂದರು;</para>
  <para style="q" vid="PSA 78:32">ಅವರು ಆತನ ಅದ್ಭುತಕೃತ್ಯಗಳನ್ನು ನಂಬದೆ ಹೋದರು.<verse eid="PSA 78:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33"/>ಆದುದರಿಂದ ಆತನು ಅವರ ಜೀವಿತ ದಿನಗಳನ್ನು ಉಸಿರಿನಂತೆಯೂ,</para>
  <para style="q" vid="PSA 78:33">ಅವರ ವರ್ಷಗಳನ್ನು ಭಯದಿಂದಲೂ ಮುಗಿಸಿದನು.<verse eid="PSA 78:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34"/>ಸಂಹಾರವಾಗುವಾಗೆಲ್ಲಾ ಅವರು ದೇವರನ್ನು ನೆನಸಿ,</para>
  <para style="q" vid="PSA 78:34">ಪುನಃ ಆತನ ಪ್ರಸನ್ನತೆಯನ್ನು ಬಯಸಿ,<verse eid="PSA 78:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35"/>ದೇವರು ತಮ್ಮ ಬಂಡೆಯು, ಪರಾತ್ಪರನಾದ ದೇವರು,</para>
  <para style="q" vid="PSA 78:35">ತಮ್ಮ ವಿಮೋಚಕನು ಆಗಿದ್ದಾನೆ ಎಂಬುದನ್ನು ನೆನಪಿಗೆ ತಂದುಕೊಳ್ಳುವರು.<verse eid="PSA 78:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36"/>ಆದರೆ ಅವರು ಆತನನ್ನು ತಮ್ಮ ಬಾಯಿಂದ ವಂಚಿಸಿ,</para>
  <para style="q" vid="PSA 78:36">ತಮ್ಮ ನಾಲಿಗೆಯಿಂದ ಸುಳ್ಳಾಡಿದರು.<verse eid="PSA 78:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37"/>ಅವರ ಹೃದಯವು ಆತನಲ್ಲಿ ನೆಲೆಗೊಳ್ಳಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 78:37">ಅವರು ಆತನ ನಿಬಂಧನೆಯನ್ನು ನಿಷ್ಠೆಯಿಂದ ಕೈಗೊಳ್ಳಲಿಲ್ಲ.<verse eid="PSA 78:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38"/>ಆದರೂ ಆತನು ಕರುಣಾಳುವೂ,</para>
  <para style="q" vid="PSA 78:38">ಅಪರಾಧಿಗಳನ್ನು ಸಂಹರಿಸದೆ ಕ್ಷಮಿಸುವವನೂ ಆಗಿ,</para>
  <para style="q" vid="PSA 78:38">ತನ್ನ ಸಿಟ್ಟನ್ನೆಲ್ಲಾ ಏರಗೊಡಿಸದೆ, ಅದನ್ನು ಹಲವು ಸಾರಿ ತಡೆಯುತ್ತಾ ಬಂದನು.<verse eid="PSA 78:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39"/>ಅವರು ಮಾಂಸಮಾತ್ರದವರೂ,</para>
  <para style="q" vid="PSA 78:39">ಶ್ವಾಸವನ್ನು ತಿರುಗಿ ಪಡೆಯದವರಾಗಿದ್ದಾರೆ ಎಂಬುದನ್ನು ನೆನಪುಮಾಡಿಕೊಳ್ಳುತ್ತಿದ್ದನು.<verse eid="PSA 78:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40"/>ಅರಣ್ಯದಲ್ಲಿ ಅವರು ಎಷ್ಟೋ ಸಾರಿ ಅವಿಧೇಯರಾಗಿ,</para>
  <para style="q" vid="PSA 78:40">ಅಲ್ಲಿ ಆತನನ್ನು ನೋಯಿಸಿದರು.<verse eid="PSA 78:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41"/>ಆತನನ್ನು ಪದೇಪದೇ ಪರೀಕ್ಷಿಸಿ,</para>
  <para style="q" vid="PSA 78:41">ಇಸ್ರಾಯೇಲರ ಸದಮಲಸ್ವಾಮಿಯನ್ನು ಕೋಪಕ್ಕೆ ಗುರಿಮಾಡಿದರು.<verse eid="PSA 78:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42"/>ಅವರು ಆತನ ಭುಜಬಲವನ್ನೂ,</para>
  <para style="q" vid="PSA 78:42">ತಮ್ಮನ್ನು ಶತ್ರುಗಳಿಂದ ಬಿಡಿಸಿದ ಸಮಯವನ್ನೂ,<verse eid="PSA 78:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43"/>ಆತನು ಐಗುಪ್ತದಲ್ಲಿ ಮಾಡಿದ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು,</para>
  <para style="q" vid="PSA 78:43">ಸೋನ್ ಸೀಮೆಯಲ್ಲಿ ನಡೆಸಿದ ಅದ್ಭುತಗಳನ್ನೂ ಮರೆತುಬಿಟ್ಟರು.<verse eid="PSA 78:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44"/>ಅವರು ಹಳ್ಳದ ನೀರನ್ನು ಕುಡಿಯಲಾಗದಂತೆ,</para>
  <para style="q" vid="PSA 78:44">ಆತನು ಅಲ್ಲಿನ ನದಿಗಳನ್ನು ರಕ್ತವನ್ನಾಗಿ ಮಾರ್ಪಡಿಸಿದನು.<verse eid="PSA 78:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45"/>ಅವರನ್ನು ನಾಶಮಾಡುವ ವಿಷದ ಹುಳಗಳನ್ನು,</para>
  <para style="q" vid="PSA 78:45">ಹಾಳುಮಾಡುವ ಕಪ್ಪೆಗಳನ್ನು ಕಳುಹಿಸಿಕೊಟ್ಟನು.<verse eid="PSA 78:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46"/>ಅವರ ಬೆಳೆಗಳನ್ನು ಜಿಟ್ಟೆಹುಳಗಳಿಗೂ,</para>
  <para style="q" vid="PSA 78:46">ಕಷ್ಟಫಲವನ್ನು ಮಿಡತೆಗಳಿಗೂ ಕೊಟ್ಟುಬಿಟ್ಟನು.<verse eid="PSA 78:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47"/>ಅವರ ದ್ರಾಕ್ಷಾಲತೆಗಳನ್ನು ಆನೆಕಲ್ಲಿನಿಂದಲೂ,</para>
  <para style="q" vid="PSA 78:47">ಅತ್ತಿಮರಗಳನ್ನು ಕಲ್ಮಳೆಯಿಂದಲೂ ಹಾಳುಮಾಡಿದನು.<verse eid="PSA 78:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48"/>ಅವರ ದನಗಳನ್ನು ಕಲ್ಮಳೆಗೂ,</para>
  <para style="q" vid="PSA 78:48">ಕುರಿಹಿಂಡುಗಳನ್ನು ಸಿಡಿಲಿಗೂ ಒಪ್ಪಿಸಿದನು.<verse eid="PSA 78:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49"/>ಆತನು ಅವರ ಮೇಲೆ ತನ್ನ ಕೋಪರೌದ್ರಗಳನ್ನು,</para>
  <para style="q" vid="PSA 78:49">ಉಗ್ರಹಿಂಸೆಗಳನ್ನು ಸಂಹಾರಕ ದೂತಗಣವನ್ನೋ ಎಂಬಂತೆ ಕಳುಹಿಸಿದನು.<verse eid="PSA 78:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50"/>ತನ್ನ ರೌದ್ರಕ್ಕೆ ಎಡೆಗೊಟ್ಟು ಅವರನ್ನು ಬದುಕಗೊಡಿಸದೆ,</para>
  <para style="q" vid="PSA 78:50">ಅವರ ಜೀವವನ್ನು ಮರಣವ್ಯಾಧಿಗೆ ಆಹುತಿಕೊಟ್ಟನು.<verse eid="PSA 78:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51"/>ಹಾಮನ ವಂಶದವರ<note caller="+" style="f"><char style="fr" closed="false">78:51 </char><char style="fq" closed="false">ಹಾಮನ ವಂಶದವರ </char><char style="ft" closed="false">ಅಥವಾ ಹಾಮನ ಡೇರೆಗಳು ಐಗುಪ್ತದ ಬಗ್ಗೆ ಮಾತನಾಡುವ ರೀತಿಯಾಗಿದೆ (ನೋಡಿರಿ 105:23,27; 106:22, ಅಲ್ಲಿ ಐಗುಪ್ತವನ್ನು “ಹಾಮನ ದೇಶ” ಎಂದು ಕರೆಯಲಾಗಿದೆ). ಹಾಮನು, ನೋಹನ ಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬನಾಗಿದ್ದನು, ಅವನನ್ನು ಐಗುಪ್ತದವರ ಪೂರ್ವಜನೆಂದು ಪರಿಗಣಿಸಲ್ಪಟ್ಟಿದ್ದಾನೆ (ಆದಿ 10:6 ನೋಡಿರಿ).</char></note> ಪ್ರಥಮಫಲವಾಗಿರುವ</para>
  <para style="q" vid="PSA 78:51">ಐಗುಪ್ತ್ಯರ ಚೊಚ್ಚಲಮಕ್ಕಳನ್ನು ಸಂಹರಿಸಿದನು.<verse eid="PSA 78:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52"/>ಆತನು ಕುರಿಗಳನ್ನೋ ಎಂಬಂತೆ ತನ್ನ ಜನವನ್ನು ಹೊರತಂದು,</para>
  <para style="q" vid="PSA 78:52">ಅಡವಿಯಲ್ಲಿ ಹಿಂಡನ್ನು ಪೋಷಿಸಿ ನಡೆಸಿದನು.<verse eid="PSA 78:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53"/>ಆತನು ಸುರಕ್ಷಿತವಾಗಿ ನಡೆಸಿದ್ದರಿಂದ ಅವರು ಭಯಪಡಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 78:53">ಅವರ ಶತ್ರುಗಳನ್ನು ಸಮುದ್ರವು ಮುಚ್ಚಿಬಿಟ್ಟಿತು;<verse eid="PSA 78:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54"/>ಅವರನ್ನು ತನ್ನ ಪವಿತ್ರದೇಶಕ್ಕೆ ಅಂದರೆ</para>
  <para style="q" vid="PSA 78:54">ತನ್ನ ಭುಜಬಲದಿಂದ ಸಂಪಾದಿಸಿದ ಈ ಪರ್ವತಸೀಮೆಗೆ ಕರೆದುಕೊಂಡು ಬಂದನು.<verse eid="PSA 78:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55"/>ಜನಾಂಗಗಳನ್ನು ಅವರ ಮುಂದಿನಿಂದ ಓಡಿಸಿಬಿಟ್ಟು,</para>
  <para style="q" vid="PSA 78:55">ಅವರ ದೇಶವನ್ನು ಇಸ್ರಾಯೇಲ್ ಗೋತ್ರಗಳಿಗೆ ಸ್ವತ್ತಾಗಿರುವಂತೆ ಹಂಚಿಕೊಟ್ಟು,</para>
  <para style="q" vid="PSA 78:55">ಆ ಜನಾಂಗಗಳ ಬಿಡಾರಗಳಲ್ಲಿ ಅವರನ್ನು ನೆಲೆಗೊಳಿಸಿದನು.<verse eid="PSA 78:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56"/>ಆದರೂ ಅವರು ಪರಾತ್ಪರನಾದ ದೇವರನ್ನು ಪರೀಕ್ಷಿಸಿ ಅವಿಧೇಯರಾದರು.</para>
  <para style="q" vid="PSA 78:56">ಆತನ ವಿಧಿಗಳನ್ನು ಕೈಗೊಳ್ಳದೆ,<verse eid="PSA 78:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57"/>ಆತನಿಗೆ ವಿಮುಖರಾಗಿ ತಮ್ಮ ಹಿರಿಯರಂತೆ ದ್ರೋಹಿಗಳಾದರು.</para>
  <para style="q" vid="PSA 78:57">ಮೋಸದ ಬಿಲ್ಲಿನಂತೆ ತಿರುಗಿಕೊಂಡರು.<verse eid="PSA 78:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58"/>ಅವರು ತಮ್ಮ ಪೂಜಾಸ್ಥಳಗಳಿಂದ ಆತನನ್ನು ಬೇಸರಗೊಳಿಸಿ,</para>
  <para style="q" vid="PSA 78:58">ವಿಗ್ರಹಗಳಿಂದ ರೇಗಿಸಿದರು.<verse eid="PSA 78:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59"/>ದೇವರು ಇದನ್ನು ತಿಳಿದು ರೌದ್ರನಾಗಿ</para>
  <para style="q" vid="PSA 78:59">ಇಸ್ರಾಯೇಲರನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಿರಾಕರಿಸಿಬಿಟ್ಟನು.<verse eid="PSA 78:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60"/>ತಾನು ಜನರ ಮಧ್ಯದಲ್ಲಿ ವಾಸಿಸುವುದಕ್ಕೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 78:60">ಶಿಲೋವ್<note caller="+" style="f"><char style="fr" closed="false">78:60 </char><char style="fq" closed="false">ಶಿಲೋವ್ </char><char style="ft" closed="false">ಶಿಲೋವ್ ಎಫ್ರಾಯೀಮ್ ಕುಲದ ಪ್ರದೇಶದಲ್ಲಿರುವ ಪಟ್ಟಣವಾಗಿದೆ, ಯೆರೂಸಲೇಮಿನ ಉತ್ತರ ಭಾಗಕ್ಕೆ 32 ಕಿಲೋಮೀಟರ್ ದೂರವಿದೆ, ಇಸ್ರಾಯೇಲಿನ ಇತಿಹಾಸದ ಆರಂಭಿಕ ದಿನಗಳಲ್ಲಿ ಮಂಜೂಷ ಪೆಟ್ಟಿಗೆಯನ್ನು ಅಲ್ಲಿ ಇಡಲಾಗಿತ್ತು (ಯೆಹೋ. 18:1; 1 ಸಮು 1:3 ನೋಡಿರಿ). </char></note> ಪಟ್ಟಣದಲ್ಲಿ ಹಾಕಿಸಿದ ನಿವಾಸಸ್ಥಾನವನ್ನು<note caller="+" style="f"><char style="fr" closed="false">78:60 </char><char style="fq" closed="false">ನಿವಾಸಸ್ಥಾನವನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಗುಡಾರವನ್ನು. </char></note> ತ್ಯಜಿಸಿಬಿಟ್ಟು,<verse eid="PSA 78:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61"/>ತನ್ನ ಪ್ರತಾಪವನ್ನು ಸೆರೆಯಾಗುವುದಕ್ಕೂ,</para>
  <para style="q" vid="PSA 78:61">ಮಹಿಮೆಯನ್ನು ವಿರೋಧಿಗಳಿಗೂ ಒಪ್ಪಿಸಿಬಿಟ್ಟನು.<verse eid="PSA 78:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62"/>ಆತನು ತನ್ನ ಪ್ರಜೆಯನ್ನು ಖಡ್ಗಕ್ಕೆ ಗುರಿಮಾಡಿ,</para>
  <para style="q" vid="PSA 78:62">ತನ್ನ ಬಾಧ್ಯತೆಯ ಮೇಲೆ ಉಗ್ರನಾದನು.<verse eid="PSA 78:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63"/>ಅವರ ಯೌವನಸ್ಥರು ಅಗ್ನಿಗೆ ಆಹುತಿಯಾದರು;</para>
  <para style="q" vid="PSA 78:63">ಅವರ ಕನ್ಯೆಯರು ವಿವಾಹವಾಗಲಿಲ್ಲ.<verse eid="PSA 78:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64"/>ಯಾಜಕರು ಕತ್ತಿಯಿಂದ ಸಂಹೃತರಾದರು;</para>
  <para style="q" vid="PSA 78:64">ಇವರ ವಿಧವೆಯರು ದುಃಖಕ್ರಿಯೆಗಳನ್ನು ನೆರವೇರಿಸಲಿಲ್ಲ.<verse eid="PSA 78:64"/></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65"/>ಆ ವರೆಗೆ ನಿದ್ರಿಸುವವನಂತೆಯೂ,</para>
  <para style="q" vid="PSA 78:65">ದ್ರಾಕ್ಷಾರಸದಿಂದ ಮೈಮರೆತ ವೀರನಂತೆಯೂ ಇದ್ದ ಕರ್ತನು ಫಕ್ಕನೆ ಎಚ್ಚೆತ್ತು,<verse eid="PSA 78:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66"/>ತನ್ನ ಶತ್ರುಗಳನ್ನು ಸದೆಬಡಿದು,</para>
  <para style="q" vid="PSA 78:66">ನಿತ್ಯನಿಂದೆಗೆ ಅವರನ್ನು ಗುರಿಮಾಡಿದನು.<verse eid="PSA 78:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67"/>ಯೋಸೇಫನ ಕುಲದ ಗುಡಾರವನ್ನು ತಿರಸ್ಕರಿಸಿ,</para>
  <para style="q" vid="PSA 78:67">ಎಫ್ರಾಯೀಮ್ ಕುಲವನ್ನು ತ್ಯಜಿಸಿ,<verse eid="PSA 78:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68"/>ಯೆಹೂದ ಕುಲವನ್ನೂ ಮತ್ತು ತನ್ನ ಪ್ರಿಯವಾದ ಚೀಯೋನ್ ಗಿರಿಯನ್ನೂ ಆರಿಸಿಕೊಂಡನು.<verse eid="PSA 78:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69"/>ಆತನು ತನ್ನ ಆಲಯವನ್ನು ಪರ್ವತದಂತೆಯೂ,</para>
  <para style="q" vid="PSA 78:69">ತಾನು ಸ್ಥಾಪಿಸಿದ ಭೂಮಿಯಂತೆಯೂ ಶಾಶ್ವತವಾಗಿ ಕಟ್ಟಿದನು.<verse eid="PSA 78:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70"/>ಇದಲ್ಲದೆ ಆತನು ತನ್ನ ಸೇವಕನಾದ ದಾವೀದನನ್ನು ಆರಿಸಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 78:70">ಕುರಿಹಟ್ಟಿಯಿಂದ ತೆಗೆದುಕೊಂಡು,<verse eid="PSA 78:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71"/>ಕುರಿಮರಿಗಳನ್ನು ರಕ್ಷಿಸುವ ಕೆಲಸದಿಂದ ಬಿಡಿಸಿ,</para>
  <para style="q" vid="PSA 78:71">ಅವನನ್ನು ತನ್ನ ಪ್ರಜೆಗಳಾದ ಯಾಕೋಬ್ಯರನ್ನು ಅಂದರೆ</para>
  <para style="q" vid="PSA 78:71">ತನ್ನ ಸ್ವತ್ತಾಗಿರುವ ಇಸ್ರಾಯೇಲರನ್ನು ಸಾಕುವುದಕ್ಕೆ ನೇಮಿಸಿದನು.<verse eid="PSA 78:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72"/>ಇವನು ಅವರನ್ನು ಯಥಾರ್ಥಹೃದಯದಿಂದ ಸಾಕಿ,</para>
  <para style="q" vid="PSA 78:72">ತನ್ನ ಹಸ್ತಕೌಶಲ್ಯದಿಂದ ನಡೆಸಿದನು.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s">ಮ್ಲೇಚ್ಛರಿಗೆ ದಂಡನೆಯಾಗಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 74">ಕೀರ್ತ 74</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1"/>ದೇವರೇ, ಮ್ಲೇಚ್ಛರು ನಿನ್ನ ಸ್ವತ್ತನ್ನು ಹೊಕ್ಕು,</para>
  <para style="q" vid="PSA 79:1">ನಿನ್ನ ಪರಿಶುದ್ಧಾಲಯವನ್ನು ಹೊಲೆಮಾಡಿದರು;</para>
  <para style="q" vid="PSA 79:1">ಯೆರೂಸಲೇಮ್ ಪಟ್ಟಣವನ್ನು ಹಾಳು ದಿಬ್ಬಗಳನ್ನಾಗಿ ಮಾಡಿಬಿಟ್ಟರು.<verse eid="PSA 79:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2"/>ಅವರು ನಿನ್ನ ಸೇವಕರ ಹೆಣಗಳನ್ನು ಆಕಾಶದ ಪಕ್ಷಿಗಳಿಗೆ ಆಹಾರಮಾಡಿದರು;</para>
  <para style="q" vid="PSA 79:2">ನಿನ್ನ ಭಕ್ತರ ದೇಹವನ್ನು ಕಾಡುಮೃಗಗಳಿಗೆ ಹಾಕಿದರು.<verse eid="PSA 79:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3"/>ಯೆರೂಸಲೇಮಿನ ಸುತ್ತಲೂ ಅವರ ರಕ್ತವನ್ನು ನೀರಿನ ಹಾಗೆ ಚೆಲ್ಲಿದರು;</para>
  <para style="q" vid="PSA 79:3">ಅವರನ್ನು ಹೂಣಿಡುವವರು ಯಾರೂ ಇರಲಿಲ್ಲ.<verse eid="PSA 79:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4"/>ನಾವು ನಮ್ಮ ನೆರೆಹೊರೆಯ ಜನಾಂಗಗಳಿಗೆ ನಿಂದಾಸ್ಪದರಾದೆವು;</para>
  <para style="q" vid="PSA 79:4">ಸುತ್ತಣ ಜನರ ಪರಿಹಾಸ್ಯ ಮತ್ತು ತಿರಸ್ಕಾರಕ್ಕೆ ಗುರಿಯಾದೆವು.<verse eid="PSA 79:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5"/>ಯೆಹೋವನೇ, ಇನ್ನೆಷ್ಟರವರೆಗೆ ಕೋಪವುಳ್ಳವನಾಗಿರುವಿ?</para>
  <para style="q" vid="PSA 79:5">ನಿನ್ನ ರೋಷಾಗ್ನಿಯು ಸದಾಕಾಲವೂ ಉರಿಯುತ್ತಲಿರಬೇಕೋ?<verse eid="PSA 79:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6"/>ನಿನ್ನನ್ನು ಅರಿಯದ ಮ್ಲೇಚ್ಛರ ಮೇಲೆಯೂ,</para>
  <para style="q" vid="PSA 79:6">ನಿನ್ನ ನಾಮವನ್ನು ಉಚ್ಚರಿಸದ ರಾಜ್ಯಗಳ ಮೇಲೆಯೂ,</para>
  <para style="q" vid="PSA 79:6">ನಿನ್ನ ರೌದ್ರವನ್ನು ಸುರಿದುಬಿಡು.<verse eid="PSA 79:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7"/>ಅವರು ಯಾಕೋಬ್ ವಂಶದವರನ್ನು ನುಂಗಿಬಿಟ್ಟು,</para>
  <para style="q" vid="PSA 79:7">ಅವರ ವಾಸಸ್ಥಳಗಳನ್ನು ಹಾಳುಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 79:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8"/>ಪೂರ್ವಿಕರ ಅಪರಾಧಗಳನ್ನು ನಮ್ಮ ಹಾನಿಗಾಗಿ ನೆನಪಿಸಿಕೊಳ್ಳಬೇಡ.</para>
  <para style="q" vid="PSA 79:8">ಬೇಗನೆ ನಿನ್ನ ಕನಿಕರವು ನಮ್ಮನ್ನು ಎದುರುಗೊಳ್ಳಲಿ;</para>
  <para style="q" vid="PSA 79:8">ಬಹಳವಾಗಿ ಕುಗ್ಗಿಹೋಗಿದ್ದೇವೆ.<verse eid="PSA 79:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9"/>ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವ ದೇವರೇ,</para>
  <para style="q" vid="PSA 79:9">ನಿನ್ನ ನಾಮದ ಘನತೆಗೋಸ್ಕರ ಸಹಾಯಮಾಡು;</para>
  <para style="q" vid="PSA 79:9">ನಿನ್ನ ಹೆಸರಿಗೆ ತಕ್ಕಂತೆ ರಕ್ಷಿಸಿ ನಮ್ಮ ಪಾಪಗಳನ್ನು ಅಳಿಸಿಬಿಡು.<verse eid="PSA 79:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10"/>ಮ್ಲೇಚ್ಛರು, “ಅವರ ದೇವರು ಎಲ್ಲಿ?” ಎಂದು ಕೇಳುವುದೇಕೆ?</para>
  <para style="q" vid="PSA 79:10">ನಿನ್ನ ಸೇವಕರ ರಕ್ತವನ್ನು ಸುರಿಸಿದವರಿಗೆ ನಮ್ಮ ಮುಂದೆಯೇ ದಂಡನೆಯಾದದ್ದು,</para>
  <para style="q" vid="PSA 79:10">ಜನಾಂಗಗಳಿಗೆ ಗೊತ್ತಾಗಲಿ.<verse eid="PSA 79:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11"/>ಸೆರೆಹೋದವರ ನರಳುವಿಕೆಯು ನಿನ್ನ ಲಕ್ಷ್ಯಕ್ಕೆ ಬರಲಿ;</para>
  <para style="q" vid="PSA 79:11">ಸಾಯಲಿರುವವರನ್ನು ನಿನ್ನ ಭುಜಮಹತ್ತಿನಿಂದ ಉಳಿಸು.<verse eid="PSA 79:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12"/>ಸ್ವಾಮಿಯೇ, ನಿನ್ನನ್ನು ನಿಂದಿಸಿದ ಸುತ್ತಣ ಜನಾಂಗಗಳ ಉಡಿಲಲ್ಲಿ,</para>
  <para style="q" vid="PSA 79:12">ಏಳರಷ್ಟು ನಿಂದನೆ ತುಂಬಿರುವಂತೆ ಮಾಡು.<verse eid="PSA 79:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13"/>ನಿನ್ನ ಪ್ರಜೆಯೂ, ನೀನು ಪಾಲಿಸುವ ಮಂದೆಯೂ ಆಗಿರುವ ನಾವಾದರೋ,</para>
  <para style="q" vid="PSA 79:13">ಸದಾ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವವರಾಗಿ,</para>
  <para style="q" vid="PSA 79:13">ಮುಂದಣ ಸಂತಾನದವರೆಲ್ಲರಿಗೂ ನಿನ್ನ ಮಹತ್ತನ್ನು ವರ್ಣಿಸುತ್ತಾ ಹೋಗುವೆವು.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s">ದ್ರಾಕ್ಷಾಲತೆಯಂತಿರುವ ಇಸ್ರಾಯೇಲರನ್ನು ಪುನಃ ಸ್ಥಾಪಿಸಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಶೋಶನ್ನೀಮ್ ಎದೂತೆಂಬ ರಾಗ. ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1"/>ಇಸ್ರಾಯೇಲರನ್ನು ಕಾಯುವ ಕುರುಬನೇ, ಕಿವಿಗೊಡು;</para>
  <para style="q" vid="PSA 80:1">ಯೋಸೇಫನ ವಂಶದವರನ್ನು ಕುರಿಹಿಂಡಿನಂತೆ ಕರೆತಂದವನೇ,</para>
  <para style="q" vid="PSA 80:1">ಕೆರೂಬಿಯರ ಮಧ್ಯದಲ್ಲಿ ಆಸೀನನಾಗಿರುವಾತನೇ, ಪ್ರಕಾಶಿಸು.<verse eid="PSA 80:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2"/>ಎಫ್ರಾಯೀಮ್, ಬೆನ್ಯಾಮೀನ್ ಮತ್ತು ಮನಸ್ಸೆ ಕುಲಗಳ ಮುಂದೆ ಹೋಗುವವನಾಗಿ,</para>
  <para style="q" vid="PSA 80:2">ನಿನ್ನ ಶೌರ್ಯವನ್ನು ತೋರ್ಪಡಿಸು;</para>
  <para style="q" vid="PSA 80:2">ಬಂದು ನಮಗೆ ಜಯಪ್ರದನಾಗು.<verse eid="PSA 80:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3"/>ದೇವರೇ, ನಮ್ಮನ್ನು ತಿರುಗಿ ಉನ್ನತಸ್ಥಿತಿಗೇರಿಸು.</para>
  <para style="q" vid="PSA 80:3">ಪ್ರಸನ್ನಮುಖದಿಂದ ನೋಡು; ಆಗ ಉದ್ಧಾರವಾಗುವೆವು.<verse eid="PSA 80:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q" vid="PSA 80:4">ನಿನ್ನ ಪ್ರಜೆಗಳು ಪ್ರಾರ್ಥಿಸುವಾಗ ನೀನು ಇನ್ನೆಷ್ಟರವರೆಗೆ ಕೋಪಿಸಿಕೊಳ್ಳುವಿ?<verse eid="PSA 80:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5"/>ರೋದನವೇ ಅವರ ಆಹಾರವಾಗುವಂತೆಯೂ,</para>
  <para style="q" vid="PSA 80:5">ಅಶ್ರುಧಾರೆಯೇ ಅವರ ಪಾನವಾಗುವಂತೆಯೂ ಮಾಡಿದಿ.<verse eid="PSA 80:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6"/>ನಮ್ಮನ್ನು ಸುತ್ತಣ ಜನಾಂಗಗಳ ದಿಕ್ಕಾರಕ್ಕೂ,</para>
  <para style="q" vid="PSA 80:6">ಶತ್ರುಗಳ ನಿಂದೆಗೂ ಗುರಿಯನ್ನಾಗಿ ಮಾಡಿದಿ.<verse eid="PSA 80:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7"/>ಸೇನಾಧೀಶ್ವರನಾದ ದೇವರೇ, ನಮ್ಮನ್ನು ತಿರುಗಿ ಉನ್ನತಸ್ಥಿತಿಗೇರಿಸು.</para>
  <para style="q" vid="PSA 80:7">ಪ್ರಸನ್ನಮುಖದಿಂದ ನೋಡು; ಆಗ ಉದ್ಧಾರವಾಗುವೆವು.<verse eid="PSA 80:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8"/>ನೀನು ಐಗುಪ್ತ ದೇಶದಿಂದ ಒಂದು ದ್ರಾಕ್ಷಾಲತೆಯನ್ನು ತಂದು,</para>
  <para style="q" vid="PSA 80:8">ಜನಾಂಗಗಳನ್ನು ಹೊರಗೆ ಹಾಕಿ, ಅದನ್ನು ನೆಟ್ಟಿದ್ದಿ.<verse eid="PSA 80:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9"/>ಅದಕ್ಕೋಸ್ಕರ ನೆಲವನ್ನು ಹಸನುಮಾಡಿದ ಮೇಲೆ,</para>
  <para style="q" vid="PSA 80:9">ಅದು ಬೇರುಬಿಟ್ಟು ದೇಶದಲ್ಲೆಲ್ಲಾ ಹಬ್ಬಿಕೊಂಡಿತು.<verse eid="PSA 80:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10"/>ಅದರ ನೆರಳಿನಿಂದ ಗುಡ್ಡಗಳೆಲ್ಲಾ ಕವಿಯಲ್ಪಟ್ಟವು.</para>
  <para style="q" vid="PSA 80:10">ಅದರ ಕುಡಿಗಳು ದೇವದಾರುವೃಕ್ಷಗಳ ಮೇಲೆ ಹಬ್ಬಿ ಅವುಗಳನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟವು.<verse eid="PSA 80:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11"/>ಅದರ ಕೊಂಬೆಗಳು ಸಮುದ್ರದವರೆಗೂ,</para>
  <para style="q" vid="PSA 80:11">ಅದರ ಚಿಗುರುಗಳು ಮಹಾನದಿಯವರೆಗೂ ಹರಡಿಕೊಂಡವು.<verse eid="PSA 80:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12"/>ನೀನು ಅದರ ಬೇಲಿಯನ್ನೇಕೆ ಮುರಿದುಹಾಕಿದಿ?</para>
  <para style="q" vid="PSA 80:12">ದಾರಿಗರೆಲ್ಲರು ಅದರ ಫಲವನ್ನು ಕಿತ್ತುಬಿಡುತ್ತಾರೆ.<verse eid="PSA 80:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13"/>ಕಾಡುಹಂದಿಯು ಅದನ್ನು ನಿರ್ಮೂಲಮಾಡುತ್ತದೆ;</para>
  <para style="q" vid="PSA 80:13">ಅರಣ್ಯಮೃಗಗಳು ಅದನ್ನು ತಿಂದುಹಾಕುತ್ತವೆ.<verse eid="PSA 80:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14"/>ಸೇನಾಧೀಶ್ವರನಾದ ದೇವರೇ, ಅಭಿಮುಖನಾಗಬೇಕು;</para>
  <para style="q" vid="PSA 80:14">ನೀನು ಪರಲೋಕದಿಂದ ಕಟಾಕ್ಷಿಸಿ, ಈ ದ್ರಾಕ್ಷಾಲತೆಯನ್ನು ಪರಾಂಬರಿಸು.<verse eid="PSA 80:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15"/>ನಿನ್ನ ಬಲಗೈ ನೆಟ್ಟು, ಸಾಕಿ, ಬೆಳೆಸಿದ ಸಸಿಯನ್ನು ಕಾಪಾಡು.<verse eid="PSA 80:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16"/>ಅದು ಕಡಿದು ಬೆಂಕಿಯಿಂದ ಸುಡಲ್ಪಟ್ಟಿದೆ.</para>
  <para style="q" vid="PSA 80:16">ಅವರು ನಿನ್ನ ಗದರಿಕೆಯಿಂದ ನಾಶವಾಗುತ್ತಾರೆ.<verse eid="PSA 80:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17"/>ನಿನ್ನ ಬಲಗೈ ಉದ್ಧರಿಸಿದ ಪುರುಷನೂ,</para>
  <para style="q" vid="PSA 80:17">ನೀನು ನಿನಗೋಸ್ಕರ ಸಾಕಿ ಬೆಳೆಸಿದ ನರಪುತ್ರನೂ ಆಗಿರುವವನನ್ನು,</para>
  <para style="q" vid="PSA 80:17">ನಿನ್ನ ಹಸ್ತದಿಂದ ಹಿಡಿದಿರು.<verse eid="PSA 80:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18"/>ಆಗ ನಾವು ನಿನ್ನಿಂದ ಅಗಲುವುದಿಲ್ಲ.</para>
  <para style="q" vid="PSA 80:18">ನಿನ್ನ ಹೆಸರನ್ನು ಹೇಳಿಕೊಂಡು ಆರಾಧಿಸುವಂತೆ ನಮ್ಮನ್ನು ಚೈತನ್ಯಗೊಳಿಸು.<verse eid="PSA 80:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವ ದೇವರೇ,</para>
  <para style="q" vid="PSA 80:19">ನಮ್ಮನ್ನು ತಿರುಗಿ ಉನ್ನತಸ್ಥಿತಿಗೇರಿಸು. ಪ್ರಸನ್ನಮುಖದಿಂದ ನೋಡು;</para>
  <para style="q" vid="PSA 80:19">ಆಗ ಉದ್ಧಾರವಾಗುವೆವು.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s">ದೇವಭಕ್ತಿಯ ವಿಷಯದಲ್ಲಿ ಪ್ರೋತ್ಸಾಹ ಮತ್ತು ಎಚ್ಚರಿಕೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಗಿತ್ತೀಯ ರಾಗದಿಂದ ಹಾಡತಕ್ಕದ್ದು; ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="DEU 32">ಧರ್ಮೋ 32</ref>; <ref loc="PSA 8">ಕೀರ್ತ 8</ref>; <ref loc="PSA 84">84</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1"/>ನಮಗೆ ಬಲಪ್ರದನಾಗಿರುವ ದೇವರಿಗೆ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 81:1">ಯಾಕೋಬ್ಯರ ದೇವರಿಗೆ ಜಯಘೋಷಮಾಡಿರಿ.<verse eid="PSA 81:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2"/>ರಾಗವನ್ನು ಎತ್ತಿರಿ; ದಮ್ಮಡಿಯನ್ನು ಬಡಿಯಿರಿ;</para>
  <para style="q" vid="PSA 81:2">ಇಂಪಾದ ಕಿನ್ನರಿಯನ್ನೂ, ಸ್ವರಮಂಡಲವನ್ನೂ ಬಾರಿಸಿರಿ.<verse eid="PSA 81:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3"/>ಅಮಾವಾಸ್ಯೆಯಲ್ಲಿಯೂ, ನಮ್ಮ ಉತ್ಸವದಿನವಾಗಿರುವ ಹುಣ್ಣಿಮೆಯಲ್ಲಿಯೂ ಕೊಂಬನ್ನು ಊದಿರಿ.<verse eid="PSA 81:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4"/>ಇದು ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಒಂದು ಕಟ್ಟಳೆ;</para>
  <para style="q" vid="PSA 81:4">ಇದು ಯಾಕೋಬ್ಯರ ದೇವರು ವಿಧಿಸಿದ್ದು.<verse eid="PSA 81:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5"/>ಆತನು ಐಗುಪ್ತ ದೇಶವನ್ನು ಬಾಧಿಸಲಿಕ್ಕೆ ಹೊರಟಾಗ,</para>
  <para style="q" vid="PSA 81:5">ನೆನಪಿಗಾಗಿ ಯೋಸೇಫ್ಯರಲ್ಲಿ ಈ ಕಟ್ಟಳೆಯನ್ನು ನೇಮಿಸಿದನು.</para>
  <para style="q" vid="PSA 81:5">ಪರಿಚಯವಿಲ್ಲದವನ ಮಾತು ನನಗೆ ಕೇಳಿಸುತ್ತದೆ; ಏನೆಂದರೆ,<verse eid="PSA 81:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6"/>“ಅವನ ಹೆಗಲನ್ನು ಹೊರೆಗೆ ತಪ್ಪಿಸಿದೆನು;</para>
  <para style="q" vid="PSA 81:6">ಅವನ ಕೈಗಳನ್ನು ಪುಟ್ಟಿಯಿಂದ ಬಿಡಿಸಿದೆನು.<verse eid="PSA 81:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7"/>ಕಷ್ಟದಲ್ಲಿ ಮೊರೆಯಿಟ್ಟ ನಿನ್ನನ್ನು ವಿಮೋಚಿಸಿದೆನು;</para>
  <para style="q" vid="PSA 81:7">ಗುಡುಗುವ ಮೋಡದಲ್ಲಿದ್ದು ನಿನಗೆ ಉತ್ತರವನ್ನು ಕೊಟ್ಟೆನು;</para>
  <para style="q" vid="PSA 81:7">ಮೆರೀಬಾ ಪ್ರವಾಹಗಳ ಬಳಿಯಲ್ಲಿ ನಿನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿದೆನು. <char style="qs">ಸೆಲಾ.</char><verse eid="PSA 81:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8"/>ನನ್ನ ಜನರೇ, ಕೇಳಿರಿ; ಖಂಡಿತವಾಗಿ ಹೇಳುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 81:8">ಇಸ್ರಾಯೇಲರೇ, ಕಿವಿಗೊಟ್ಟರೆ ಎಷ್ಟೋ ಒಳ್ಳೇದು,<verse eid="PSA 81:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9"/>ನಿಮ್ಮಲ್ಲಿ ಅನ್ಯದೇವತೆಗಳು ಇರಬಾರದು;</para>
  <para style="q" vid="PSA 81:9">ಪರರ ದೇವತೆಗಳನ್ನು ಪೂಜಿಸಬಾರದು;<verse eid="PSA 81:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10"/>ನಿಮ್ಮನ್ನು ಐಗುಪ್ತದಿಂದ ಕರೆತಂದ ಯೆಹೋವನೆಂಬ ನಾನೇ ನಿಮ್ಮ ದೇವರು;</para>
  <para style="q" vid="PSA 81:10">ಅಗಲವಾಗಿ ಬಾಯಿತೆರೆಯಿರಿ; ಅದನ್ನು ತುಂಬಿಸುವೆನು ಅಂದೆನು.<verse eid="PSA 81:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11"/>ಆದರೆ ನನ್ನ ಜನರು ನನ್ನ ಮಾತು ಕೇಳಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 81:11">ಇಸ್ರಾಯೇಲರು ನನಗೆ ಸಮ್ಮತಿಸಲಿಲ್ಲ.<verse eid="PSA 81:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12"/>ಆದುದರಿಂದ ಇವರು ಹಟಮಾರಿಗಳು;</para>
  <para style="q" vid="PSA 81:12">ತಮ್ಮ ಮನಸ್ಸಿನಂತೆ ನಡೆಯಲಿ ಎಂದು ಬಿಟ್ಟುಬಿಟ್ಟೆನು.<verse eid="PSA 81:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13"/>ನನ್ನ ಪ್ರಜೆಗಳಾದ ಇಸ್ರಾಯೇಲರು ನನ್ನ ಮಾತನ್ನು ಕೇಳಿ,</para>
  <para style="q" vid="PSA 81:13">ನನ್ನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದರೆ ಎಷ್ಟೋ ಒಳ್ಳೆಯದು!<verse eid="PSA 81:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14"/>ನಾನು ಅವರ ಎದುರಾಳಿಗಳ ಮೇಲೆ ಕೈಯೆತ್ತಿ,</para>
  <para style="q" vid="PSA 81:14">ಅವರ ಶತ್ರುಗಳನ್ನು ಸುಲಭವಾಗಿ ಬಗ್ಗಿಸುವೆನು.<verse eid="PSA 81:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15"/>ಯೆಹೋವನ ದ್ವೇಷಿಗಳು ಅವರ ಮುಂದೆ ಮುದುರಿಕೊಳ್ಳುವರು;</para>
  <para style="q" vid="PSA 81:15">ಅವರಾದರೋ ಸದಾಕಾಲವೂ ಇರುವರು.<verse eid="PSA 81:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16"/>ನಾನು ಅವರಿಗೆ ಶ್ರೇಷ್ಠವಾದ ಗೋದಿಯನ್ನು ಊಟಕ್ಕೆ ಕೊಟ್ಟು,</para>
  <para style="q" vid="PSA 81:16">ಬಂಡೆಯೊಳಗಿನ ಜೇನಿನಿಂದ ತೃಪ್ತಿಪಡಿಸುವೆನು” ಎಂಬುದೇ.<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s">ಅನೀತಿವಂತರಾದ ಅಧಿಪತಿಗಳಿಗೆ ನ್ಯಾಯ ವಿಧಿಸುವ ದೇವರು</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 58">ಕೀರ್ತ 58</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1"/>ದೇವರು ತನ್ನ ಸಭೆಯಲ್ಲಿ ನಿಂತುಕೊಂಡವನಾಗಿ,</para>
  <para style="q" vid="PSA 82:1">ದೇವರುಗಳೆಂದು <note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="fq" closed="false">ದೇವರುಗಳೆಂದು </char><char style="ft" closed="false">ಅಥವಾ ದೇವದೂತರು ಅಥವಾ ಪರಲೋಕದಲ್ಲಿ ದೇವರನ್ನು ಆರಾಧಿಸುವವರು.</char></note>ಕರೆಯಲ್ಪಡುವವರೊಳಗೆ ನ್ಯಾಯವಿಧಿಸುತ್ತಾನೆ.<verse eid="PSA 82:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2"/>“ನೀವು ಅನ್ಯಾಯವಾಗಿ ತೀರ್ಪುಕೊಡುವುದೂ,</para>
  <para style="q" vid="PSA 82:2">ದುಷ್ಟರಿಗೆ ಮುಖದಾಕ್ಷಿಣ್ಯ ತೋರಿಸುವುದೂ ಇನ್ನೆಷ್ಟರವರೆಗೆ? <char style="qs">ಸೆಲಾ.</char><verse eid="PSA 82:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3"/>ಕುಗ್ಗಿದವರ ಮತ್ತು ಅನಾಥರ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸಿರಿ,</para>
  <para style="q" vid="PSA 82:3">ದುಃಖಿತರ ಮತ್ತು ದರಿದ್ರರ ನೀತಿಯನ್ನು ಉಳಿಸಿರಿ.<verse eid="PSA 82:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4"/>ಕುಗ್ಗಿದವರನ್ನು, ಬಡವರನ್ನು ದುಷ್ಟರ ಕೈಯಿಂದ ಬಿಡಿಸಿ ರಕ್ಷಿಸಿರಿ.”<verse eid="PSA 82:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5"/>ಇವರು ಬುದ್ಧಿಹೀನರೂ, ವಿವೇಕಶೂನ್ಯರೂ ಆಗಿ ಅಂಧಕಾರದಲ್ಲಿ ಅಲೆಯುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 82:5">ಭೂಮಿಯ ಅಸ್ತಿವಾರಗಳೆಲ್ಲಾ ಕದಲುತ್ತವೆ.<verse eid="PSA 82:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6"/>“ನೀವು ದೇವರುಗಳು, ಎಲ್ಲರೂ ಪರಾತ್ಪರನಾದ ದೇವರ ಮಕ್ಕಳು,<verse eid="PSA 82:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7"/>ಆದರೂ ನರರಂತೆ ಸತ್ತೇ ಹೋಗುವಿರಿ,</para>
  <para style="q" vid="PSA 82:7">ಪ್ರತಿಯೊಬ್ಬ ಪ್ರಭುವಿನಂತೆ ನೀವೆಲ್ಲರೂ ಬಿದ್ದು ಹೋಗುವಿರಿ”</para>
  <para style="q" vid="PSA 82:7">ಎಂದು ನಾನು ಹೇಳಿದೆನು.<verse eid="PSA 82:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8"/>ದೇವರೇ, ಏಳು; ಭೂಲೋಕದಲ್ಲಿ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸು.</para>
  <para style="q" vid="PSA 82:8">ನೀನು ಎಲ್ಲಾ ಜನಾಂಗಗಳ ಒಡೆಯನು ಅಲ್ಲವೋ?<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s">ಇಸ್ರಾಯೇಲ್ ವಿರೋಧಿಗಳ ಸೋಲಿಗಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಆಸಾಫನ ಕೀರ್ತನೆ; ಗೀತೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1"/>ದೇವರೇ, ಸುಮ್ಮನಿರಬೇಡ!</para>
  <para style="q" vid="PSA 83:1">ನಿಶ್ಚಿಂತನಾಗಿ ಮೌನದಿಂದಿರಬೇಡ ಸ್ವಾಮೀ.<verse eid="PSA 83:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2"/>ನೋಡು, ನಿನ್ನ ಶತ್ರುಗಳು ಘೋಷಿಸುತ್ತಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 83:2">ನಿನ್ನ ದ್ವೇಷಿಗಳು ತಲೆಯೆತ್ತಿದ್ದಾರೆ.<verse eid="PSA 83:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3"/>ಅವರು ನಿನ್ನ ಪ್ರಜೆಗಳಿಗೆ ವಿರುದ್ಧವಾಗಿ ಒಳಸಂಚುಮಾಡಿ,</para>
  <para style="q" vid="PSA 83:3">ನಿನ್ನ ಮರೆಹೊಕ್ಕವರನ್ನು ಕೆಡಿಸಬೇಕೆಂದು ಆಲೋಚಿಸಿ,<verse eid="PSA 83:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4"/>“ಬನ್ನಿರಿ; ಅವರು ಜನಾಂಗವಾಗಿ ಉಳಿಯದಂತೆಯೂ,</para>
  <para style="q" vid="PSA 83:4">ಇಸ್ರಾಯೇಲೆಂಬ ಹೆಸರು ಅಳಿದುಹೋಗುವಂತೆ,</para>
  <para style="q" vid="PSA 83:4">ಅವರನ್ನು ಸಂಹರಿಸೋಣ” ಅಂದುಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 83:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5"/>ಎದೋಮ್ಯರ ಮತ್ತು ಇಷ್ಮಾಯೇಲರ ಪಾಳೆಯಗಳವರು,</para>
  <para style="q" vid="PSA 83:5">ಮೋವಾಬ್ಯರು, ಹಗ್ರೀಯರು,<verse eid="PSA 83:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6"/>ಗೆಬಾಲ್ಯರು, ಅಮ್ಮೋನಿಯರು, ಅಮಾಲೇಕ್ಯರು,</para>
  <para style="q" vid="PSA 83:6">ಫಿಲಿಷ್ಟಿಯರು, ತೂರ್ ಸಂಸ್ಥಾನದವರು,<verse eid="PSA 83:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7"/>ಇವರೆಲ್ಲಾ ಏಕಮನಸ್ಸಿನಿಂದ ಕೂಡಿ,</para>
  <para style="q" vid="PSA 83:7">ನಿನಗೆ ವಿರುದ್ಧವಾಗಿ ಒಳಸಂಚು ಮಾಡುತ್ತಾರಲ್ಲಾ;<verse eid="PSA 83:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8"/>ಅಶ್ಯೂರ್ಯರೂ ಇವರೊಡನೆ ಕೂಡಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 83:8">ಲೋಟನ ವಂಶದವರಿಗೆ ಭುಜಬಲವಾಗಿದ್ದಾರೆ. <char style="qs">ಸೆಲಾ</char><verse eid="PSA 83:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9"/>ನೀನು ಮಿದ್ಯಾನ್ಯರನ್ನು ಸಂಹರಿಸಿದಂತೆ ಇವರನ್ನೂ ಸಂಹರಿಸು.</para>
  <para style="q" vid="PSA 83:9">ಕೀಷೋನ್ ಹಳ್ಳದ ಬಳಿಯಲ್ಲಿ ಸೀಸೆರ್, ಯಾಬೀನ್ ಎಂಬುವವರಿಗೆ ಮಾಡಿದಂತೆ,</para>
  <para style="q" vid="PSA 83:9">ಇವರಿಗೂ ಮಾಡು.<verse eid="PSA 83:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10"/>ಅವರು ಎಂದೋರಿನಲ್ಲಿ ವಧಿಸಲ್ಪಟ್ಟು,</para>
  <para style="q" vid="PSA 83:10">ಹೊಲದ ಗೊಬ್ಬರವಾಗಿ ಹೋದರಲ್ಲಾ.<verse eid="PSA 83:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11"/>ಓರೇಬ್ ಮತ್ತು ಜೇಬ್ ಎಂಬವರ ಗತಿಯು,</para>
  <para style="q" vid="PSA 83:11">ಇವರ ಶ್ರೀಮಂತರಿಗೂ ಸಂಭವಿಸಲಿ;</para>
  <para style="q" vid="PSA 83:11">ಜೇಬಹ ಮತ್ತು ಚಲ್ಮುನ್ನ ಎಂಬವರ ಹಾಗೆ ಇವರ ಪ್ರಭುಗಳಿಗೂ ಆಗಲಿ.<verse eid="PSA 83:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12"/>ಅವರು “ದೇವರು ಅವರಿಗೆ ಕೊಟ್ಟ ದೇಶವನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುತ್ತೇವೆ”</para>
  <para style="q" vid="PSA 83:12">ಅಂದುಕೊಳ್ಳುತ್ತಾರಲ್ಲಾ.<verse eid="PSA 83:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13"/>ನನ್ನ ದೇವರೇ, ಅವರನ್ನು ಸುಂಟರ ಗಾಳಿಯಲ್ಲಿ ಸುತ್ತಾಡುವ ಧೂಳಿನಂತೆಯೂ,</para>
  <para style="q" vid="PSA 83:13">ಹಾರಿಹೋಗುವ ಹೊಟ್ಟಿನಂತೆಯೂ ಮಾಡು.<verse eid="PSA 83:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14"/>ನೀನು ಕಾಡನ್ನು ಸುಟ್ಟುಬಿಡುವ ಬೆಂಕಿಯಂತೆಯೂ,</para>
  <para style="q" vid="PSA 83:14">ಪರ್ವತಗಳನ್ನು ದಹಿಸಿಬಿಡುವ ಜ್ವಾಲೆಯಂತೆಯೂ ಇದ್ದು,<verse eid="PSA 83:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15"/>ನಿನ್ನ ಸುಂಟರಗಾಳಿಯಿಂದ ಅವರನ್ನು ಬೆನ್ನಟ್ಟು;</para>
  <para style="q" vid="PSA 83:15">ತುಫಾನಿನಿಂದ ಅವರನ್ನು ಕಳವಳಗೊಳಿಸು.<verse eid="PSA 83:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16"/>ನಾಚಿಕೆಯು ಅವರ ಮುಖವನ್ನು ಕವಿಯಲಿ.</para>
  <para style="q" vid="PSA 83:16">ಯೆಹೋವನೇ, ಆಗ ಅವರು ನಿನ್ನ ಹೆಸರನ್ನು ಕೇಳಿಕೊಂಡು ಬಂದಾರು.<verse eid="PSA 83:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17"/>ಅವರು ನಿರಂತರವೂ ಆಶಾಭಂಗದಿಂದ ಕಳವಳಗೊಳ್ಳಲಿ;</para>
  <para style="q" vid="PSA 83:17">ಅಪಮಾನದಿಂದ ನಾಶವಾಗಲಿ.<verse eid="PSA 83:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18"/>ಆಗ ಯೆಹೋವನ ನಾಮದಿಂದ ಪ್ರಸಿದ್ಧನಾದ ನೀನೊಬ್ಬನೇ</para>
  <para style="q" vid="PSA 83:18">ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಸರ್ವೋನ್ನತನೆಂದು ಗ್ರಹಿಸುವರು.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s">ದೇವಾಲಯದ ಯಾತ್ರಿಕರ ಕೀರ್ತನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಗಿತ್ತೀಯ ರಾಗದಿಂದ ಹಾಡತಕ್ಕದ್ದು; ಕೋರಹೀಯರ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 8">ಕೀರ್ತ 8</ref>; <ref loc="PSA 81">81</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 84:1">ನಿನ್ನ ನಿವಾಸಗಳು ಎಷ್ಟೋ ರಮ್ಯವಾಗಿವೆ!<verse eid="PSA 84:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2"/>ಯೆಹೋವನ ಆಲಯದ ಅಂಗಳಗಳಲ್ಲಿ ಸೇರಬೇಕೆಂದು,</para>
  <para style="q" vid="PSA 84:2">ನನ್ನ ಆತ್ಮವು ಹಂಬಲಿಸುತ್ತಾ ಕುಂದಿಹೋಗಿತ್ತು.</para>
  <para style="q" vid="PSA 84:2">ಆದರೆ ಈಗ ಚೈತನ್ಯಸ್ವರೂಪನಾದ ದೇವರಿಗೆ</para>
  <para style="q" vid="PSA 84:2">ನನ್ನ ತನುಮನಗಳಿಂದ ಹರ್ಷಧ್ವನಿಮಾಡುತ್ತೇನೆ.<verse eid="PSA 84:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3"/>ಆಹಾ, ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಅರಸನೇ,</para>
  <para style="q" vid="PSA 84:3">ನಿನ್ನ ಯಜ್ಞವೇದಿಗಳ ಸಮೀಪದಲ್ಲಿಯೇ ಗುಬ್ಬಿಗೆ ಮನೆಯೂ,</para>
  <para style="q" vid="PSA 84:3">ಪಾರಿವಾಳಕ್ಕೆ ಮರಿಮಾಡುವ ಗೂಡೂ ದೊರಕಿತಲ್ಲಾ!<verse eid="PSA 84:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4"/>ನಿನ್ನ ಮಂದಿರದಲ್ಲಿ ವಾಸಿಸುವವರು ಧನ್ಯರು.</para>
  <para style="q" vid="PSA 84:4">ಅವರು ನಿತ್ಯವೂ ನಿನ್ನನ್ನು ಕೀರ್ತಿಸುತ್ತಾ ಇರುತ್ತಾರೆ. <char style="qs">ಸೆಲಾ</char><verse eid="PSA 84:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5"/>ನಿನ್ನಲ್ಲೇ ಬಲವನ್ನು ಹೊಂದುವ ಮನುಷ್ಯರು ಧನ್ಯರು.</para>
  <para style="q" vid="PSA 84:5">ಅವರು ಯಾತ್ರಿಕರಾಗಿ,<verse eid="PSA 84:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6"/>ಕಣ್ಣೀರಿನ ತಗ್ಗನ್ನು ದಾಟುವಾಗ,</para>
  <para style="q" vid="PSA 84:6">ಅಲ್ಲಿ ಒರತೆಗಳನ್ನು ತೋಡಿ ನೀರಿನ ಸ್ಥಳವಾಗ ಮಾಡುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 84:6">ಮುಂಗಾರು ಮಳೆಯು ಅದನ್ನು ಸಮೃದ್ಧಿಗೊಳಿಸುತ್ತದೆ.<verse eid="PSA 84:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7"/>ಅವರು ಹೆಚ್ಚು ಹೆಚ್ಚಾಗಿ ಬಲಹೊಂದಿ,</para>
  <para style="q" vid="PSA 84:7">ಚೀಯೋನ್ ಗಿರಿಯಲ್ಲಿ ದೇವರ ಸನ್ನಿಧಿಯನ್ನು ಸೇರಿ,<verse eid="PSA 84:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8"/>“ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳು;</para>
  <para style="q" vid="PSA 84:8">ಯಾಕೋಬ್ಯರ ದೇವರೇ, ಕಿವಿಗೊಡು” ಅನ್ನುತ್ತಾರೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 84:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9"/>ದೇವರೇ, ನಮಗೆ ಗುರಾಣಿಯಾಗಿರುವವನನ್ನು ನೋಡು;</para>
  <para style="q" vid="PSA 84:9">ನಿನ್ನ ಅಭಿಷಿಕ್ತನ ಮುಖವನ್ನು ಕಟಾಕ್ಷಿಸು.<verse eid="PSA 84:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10"/>ನಿನ್ನ ಆಲಯದ ಅಂಗಳಗಳಲ್ಲಿ ಕಳೆದ ಒಂದು ದಿನವು,</para>
  <para style="q" vid="PSA 84:10">ಬೇರೆ ಸಹಸ್ರದಿನಗಳಿಗಿಂತ ಉತ್ತಮವಾಗಿದೆ.</para>
  <para style="q" vid="PSA 84:10">ದುಷ್ಟರ ಗುಡಾರಗಳಲ್ಲಿ ವಾಸಿಸುವುದಕ್ಕಿಂತ</para>
  <para style="q" vid="PSA 84:10">ನನ್ನ ದೇವರ ಆಲಯದ ಹೊಸ್ತಿಲಲ್ಲಿ ಬಿದ್ದುಕೊಂಡಿರುವುದೇ ಲೇಸು.<verse eid="PSA 84:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11"/>ಯೆಹೋವ ದೇವರು ಸೂರ್ಯನೂ, ಗುರಾಣಿಯೂ ಆಗಿದ್ದಾನಲ್ಲಾ.</para>
  <para style="q" vid="PSA 84:11">ಯೆಹೋವನು ಕೃಪೆಯನ್ನೂ, ಘನವನ್ನೂ ಅನುಗ್ರಹಿಸುವನು;</para>
  <para style="q" vid="PSA 84:11">ಆತನು ಸದ್ಭಕ್ತರಿಗೆ ಯಾವ ಶುಭವನ್ನು ದಯಪಾಲಿಸದೆ ಇದ್ದಾನೋ?<verse eid="PSA 84:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12"/>ಸೇನಾಧೀಶ್ವರನಾದ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 84:12">ನಿನ್ನಲ್ಲಿ ಭರವಸವಿಡುವ ಮನುಷ್ಯನು ಧನ್ಯನು.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s">ಸಂಪೂರ್ಣ ರಕ್ಷಣೆಯನ್ನು ನಿರೀಕ್ಷಿಸುವ ಭಕ್ತನ ವಿಜ್ಞಾಪನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಕೋರಹೀಯರ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1"/>ಯೆಹೋವನೇ, ನಿನ್ನ ದೇಶವನ್ನು ಕಟಾಕ್ಷಿಸಿದ್ದಿ;</para>
  <para style="q" vid="PSA 85:1">ಯಾಕೋಬ್ಯರನ್ನು ಸೆರೆಯಿಂದ ಬಿಡಿಸಿ ಬರಮಾಡಿದ್ದಿ.<verse eid="PSA 85:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2"/>ನಿನ್ನ ಪ್ರಜೆಯ ದ್ರೋಹವನ್ನು ಕ್ಷಮಿಸಿದ್ದಿ;</para>
  <para style="q" vid="PSA 85:2">ಅವರ ಎಲ್ಲಾ ಪಾಪಗಳನ್ನು ಅಳಿಸಿಬಿಟ್ಟಿದ್ದಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 85:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3"/>ನಿನ್ನ ರೌದ್ರವನ್ನೆಲ್ಲಾ ತೊರೆದಿದ್ದಿ;</para>
  <para style="q" vid="PSA 85:3">ನಿನ್ನ ಉಗ್ರಕೋಪವನ್ನು ಬಿಟ್ಟಿದ್ದಿ.<verse eid="PSA 85:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4"/>ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವ ದೇವರೇ, ನಮಗೆ ಅಭಿಮುಖನಾಗು;</para>
  <para style="q" vid="PSA 85:4">ನಮ್ಮ ವಿಷಯದಲ್ಲಿ ಬೇಸರವನ್ನು ಬಿಡು.<verse eid="PSA 85:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5"/>ಸದಾಕಾಲವೂ ನಮ್ಮ ಮೇಲೆ ಸಿಟ್ಟು ಮಾಡಿಕೊಳ್ಳುವೆಯಾ?</para>
  <para style="q" vid="PSA 85:5">ತಲತಲಾಂತರಗಳಿಗೂ ಕೋಪವನ್ನು ಬೆಳೆಸುವಿಯೋ?<verse eid="PSA 85:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6"/>ನಿನ್ನ ಪ್ರಜೆಯಾದ ನಾವು ನಿನ್ನಲ್ಲಿ ಆನಂದಿಸುವಂತೆ,</para>
  <para style="q" vid="PSA 85:6">ನೀನು ನಮ್ಮನ್ನು ಪುನಃ ಉಜ್ಜೀವಿಸುವುದಿಲ್ಲವೋ?<verse eid="PSA 85:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕೃಪೆಯನ್ನು ನಮಗೆ ತೋರಿಸು;</para>
  <para style="q" vid="PSA 85:7">ನಿನ್ನ ರಕ್ಷಣೆಯನ್ನು ನಮಗೆ ಅನುಗ್ರಹಿಸು.<verse eid="PSA 85:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8"/>ಯೆಹೋವ ದೇವರು ಏನು ಹೇಳುತ್ತಾನೋ ಕೇಳುತ್ತೇನೆ.</para>
  <para style="q" vid="PSA 85:8">ಆತನು ತನ್ನ ಭಕ್ತಜನರಿಗೆ ಸಮಾಧಾನದ ವಾಕ್ಯವನ್ನು ಹೇಳುತ್ತಾನಲ್ಲಾ.</para>
  <para style="q" vid="PSA 85:8">ಅವರಾದರೋ ತಿರುಗಿ ಮೂರ್ಖತನದಲ್ಲಿ ಬೀಳದಿರಲಿ.<verse eid="PSA 85:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9"/>ಭಯಭಕ್ತಿಯುಳ್ಳ ಜನರಿಗೆ ಆತನ ರಕ್ಷಣೆಯು ಹತ್ತಿರವಿರುವುದು ಸತ್ಯ.</para>
  <para style="q" vid="PSA 85:9">ಇದರಿಂದ ಆತನ ಮಹಿಮೆ ನಮ್ಮ ದೇಶದಲ್ಲಿ ನೆಲೆಗೊಳ್ಳುವುದು.<verse eid="PSA 85:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10"/>ಆತನ ಶಾಶ್ವತ ಪ್ರೀತಿ ಮತ್ತು ನಂಬಿಗಸ್ತಿಕೆ ಒಂದನ್ನೊಂದು ಕೂಡಿರುವವು;</para>
  <para style="q" vid="PSA 85:10">ನೀತಿಯು, ಸಮಾಧಾನವು ಮುದ್ದಿಟ್ಟುಕೊಳ್ಳುವವು.<verse eid="PSA 85:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11"/>ಸತ್ಯತೆಯು ಭೂಮಿಯಿಂದ ಹುಟ್ಟುವುದು;</para>
  <para style="q" vid="PSA 85:11">ನೀತಿಯು ಆಕಾಶದಿಂದ ಕೆಳಗೆ ದೃಷ್ಟಿಸುವುದು.<verse eid="PSA 85:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12"/>ನಿಜವಾಗಿ ಯೆಹೋವನು ಒಳ್ಳೆಯದನ್ನು ಅನುಗ್ರಹಿಸುವನು;</para>
  <para style="q" vid="PSA 85:12">ನಮ್ಮ ದೇಶವು ತನ್ನ ಬೆಳೆ ಕೊಡುವುದು.<verse eid="PSA 85:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13"/>ನೀತಿಯು ಆತನ ಮುಂದೆ ಹೋಗುತ್ತಾ,</para>
  <para style="q" vid="PSA 85:13">ನಾವು ಆತನ ಹೆಜ್ಜೆಹಿಡಿದು ನಡೆಯುವಂತೆ ದಾರಿ ಮಾಡುವುದು.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s">ಶತ್ರಪೀಡಿತನ ವಿಜ್ಞಾಪನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 25">ಕೀರ್ತ 25</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1"/>ಯೆಹೋವನೇ, ಕಿವಿಗೊಡು; ನನಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು;</para>
  <para style="q" vid="PSA 86:1">ಕುಗ್ಗಿದವನೂ, ದಿಕ್ಕಿಲ್ಲದವನೂ ಆಗಿದ್ದೇನೆ.<verse eid="PSA 86:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2"/>ನಾನು ನಿನ್ನ ಭಕ್ತನು; ನನ್ನ ಪ್ರಾಣವನ್ನು ಉಳಿಸು;</para>
  <para style="q" vid="PSA 86:2">ನೀನೇ ನನ್ನ ದೇವರು; ನಿನ್ನಲ್ಲಿ ಭರವಸವಿಟ್ಟಿರುವ ನಿನ್ನ ಸೇವಕನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 86:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3"/>ಕರ್ತನೇ, ಕರುಣಿಸು;</para>
  <para style="q" vid="PSA 86:3">ದಿನವೆಲ್ಲಾ ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 86:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4"/>ಕರ್ತನೇ, ನಿನ್ನ ಸೇವಕನ ಹೃದಯವನ್ನು ಆನಂದಗೊಳಿಸು;</para>
  <para style="q" vid="PSA 86:4">ನಿನ್ನನ್ನೇ ನಿರೀಕ್ಷಿಸುತ್ತಿರುವೆನಲ್ಲಾ.<verse eid="PSA 86:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5"/>ಕರ್ತನೇ, ನೀನು ಒಳ್ಳೆಯವನೂ, ಕ್ಷಮಿಸುವವನೂ,</para>
  <para style="q" vid="PSA 86:5">ನಿನಗೆ ಮೊರೆಯಿಡುವವರೆಲ್ಲರಲ್ಲಿ ಕೃಪಾಪೂರ್ಣನೂ ಆಗಿದ್ದಿಯಲ್ಲಾ.<verse eid="PSA 86:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6"/>ಯೆಹೋವನೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಗೆ ಕಿವಿಗೊಡು;</para>
  <para style="q" vid="PSA 86:6">ನನ್ನ ವಿಜ್ಞಾಪನೆಗಳ ಕೂಗನ್ನು ಲಾಲಿಸು.<verse eid="PSA 86:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7"/>ನೀನು ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸುವಿಯೆಂದು ನಂಬಿ,</para>
  <para style="q" vid="PSA 86:7">ನನ್ನ ಇಕ್ಕಟ್ಟಿನ ದಿನದಲ್ಲಿ ನಿನ್ನನ್ನೇ ಕರೆಯುವೆನು.<verse eid="PSA 86:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8"/>ಕರ್ತನೇ, ದೇವರುಗಳಲ್ಲಿ ನಿನಗೆ ಸಮಾನನೇ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 86:8">ನಿನ್ನ ಕೃತ್ಯಗಳಿಗೆ ಸರಿಯಾದದ್ದು ಇನ್ನೊಂದಿಲ್ಲ.<verse eid="PSA 86:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9"/>ಕರ್ತನೇ, ನಿನ್ನಿಂದುಂಟಾದ ಎಲ್ಲಾ ಜನಾಂಗಗಳು ಬಂದು,</para>
  <para style="q" vid="PSA 86:9">ನಿನಗೆ ಅಡ್ಡಬಿದ್ದು ನಿನ್ನ ನಾಮವನ್ನು ಘನಪಡಿಸುವವು.<verse eid="PSA 86:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10"/>ಮಹೋನ್ನತನು, ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡೆಸುವವನು ನೀನು;</para>
  <para style="q" vid="PSA 86:10">ನೀನೊಬ್ಬನೇ ದೇವರು.<verse eid="PSA 86:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಮಾರ್ಗವನ್ನು ನನಗೆ ಬೋಧಿಸು;</para>
  <para style="q" vid="PSA 86:11">ನಿನ್ನ ಸತ್ಯತೆಯನ್ನು ನನ್ನ ದೃಷ್ಟಿಯಲ್ಲೇ ಇಟ್ಟುಕೊಂಡು ನಡೆಯುವೆನು.</para>
  <para style="q" vid="PSA 86:11">ನಾನು ನಿನ್ನ ನಾಮದಲ್ಲಿ ಭಯಭಕ್ತಿಯಿಂದಿರುವಂತೆ ಏಕಮನಸ್ಸನ್ನು ಅನುಗ್ರಹಿಸು.<verse eid="PSA 86:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12"/>ಕರ್ತನೇ, ನನ್ನ ದೇವರೇ, ಮನಃಪೂರ್ವಕವಾಗಿ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 86:12">ಎಂದೆಂದಿಗೂ ನಿನ್ನ ನಾಮವನ್ನು ಘನಪಡಿಸುವೆನು.<verse eid="PSA 86:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13"/>ನೀನು ಬಹಳವಾಗಿ ಕನಿಕರಿಸಿ,</para>
  <para style="q" vid="PSA 86:13">ನನ್ನ ಪ್ರಾಣವನ್ನು ಪಾತಾಳದ ತಳದಿಂದ ತಪ್ಪಿಸಿದ್ದಿಯಲ್ಲಾ.<verse eid="PSA 86:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14"/>ದೇವರೇ, ಅಹಂಕಾರಿಗಳು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಎದ್ದಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 86:14">ಬಲಾತ್ಕಾರಿಗಳ ಗುಂಪು ನನ್ನ ಪ್ರಾಣಕ್ಕಾಗಿ ಕಾದಿದೆ.</para>
  <para style="q" vid="PSA 86:14">ಅವರು ನಿನ್ನನ್ನು ಲಕ್ಷಿಸುವುದಿಲ್ಲ.<verse eid="PSA 86:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15"/>ಕರ್ತನೇ, ನೀನು ಕನಿಕರವೂ, ದಯೆಯೂ ಉಳ್ಳ ದೇವರು;</para>
  <para style="q" vid="PSA 86:15">ದೀರ್ಘಶಾಂತನು, ಬಹಳ ಪ್ರೀತಿಯೂ, ನಂಬಿಕೆಯೂ ಉಳ್ಳವನು.<verse eid="PSA 86:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16"/>ಕಟಾಕ್ಷವಿಟ್ಟು ನನ್ನನ್ನು ಕರುಣಿಸು; ನಿನ್ನ ಸೇವಕನಿಗೆ ಬಲವನ್ನು ಅನುಗ್ರಹಿಸು;</para>
  <para style="q" vid="PSA 86:16">ನಿನ್ನ ಸೇವಕಳ ಮಗನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 86:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17"/>ನನಗಾಗಿ ಒಂದು ಶುಭಸೂಚನೆಯನ್ನು ತೋರಿಸು;</para>
  <para style="q" vid="PSA 86:17">ನನ್ನ ಶತ್ರುಗಳು ನೋಡಿ, “ಯೆಹೋವನು ಸಹಾಯಕನಾಗಿ</para>
  <para style="q" vid="PSA 86:17">ಇವನನ್ನು ಸಂತೈಸಿದ್ದಾನೆ” ಎಂದು ನಾಚಿಕೆಪಡಲಿ.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s">ಚೀಯೋನೇ ಎಲ್ಲಾ ದೇವಜನರ ಮಾತೃಭೂಮಿ</para>
  <para style="d">ಕೋರಹೀಯರ ಕೀರ್ತನೆ; ಗೀತೆ.</para>
  <para style="r">
    <ref loc="ISA 2:2-4">ಯೆಶಾ 2:2-4</ref>; <ref loc="ISA 19:19-24">19:19-24</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1"/>ಯೆಹೋವನು ಸ್ಥಾಪಿಸಿದ ಪಟ್ಟಣವು</para>
  <para style="q" vid="PSA 87:1">ಪರಿಶುದ್ಧ ಪರ್ವತದ ಮೇಲಿದೆ.<verse eid="PSA 87:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2"/>ಆತನು ಯಾಕೋಬ್ ವಂಶದವರ ಎಲ್ಲಾ ನಿವಾಸಗಳಿಗಿಂತ,</para>
  <para style="q" vid="PSA 87:2">ಚೀಯೋನಿನ ದ್ವಾರಗಳನ್ನು ಹೆಚ್ಚಾಗಿ ಪ್ರೀತಿಸುತ್ತಾನೆ.<verse eid="PSA 87:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3"/>ದೇವನಗರವೇ, ನಿನ್ನ ವಿಷಯವಾದ ಗೌರವೋಕ್ತಿಯೇನೆಂದರೆ,<verse eid="PSA 87:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4"/>“ರಹಬ<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="fq" closed="false">ರಹಬ </char><char style="ft" closed="false">ಅಥವಾ ಐಗುಪ್ತ.</char></note>, ಬಾಬೆಲ್ ದೇಶಗಳವರನ್ನು, ನನ್ನನ್ನು ಬಲ್ಲವರಲ್ಲಿ ಎಣಿಸುವೆನು.</para>
  <para style="q" vid="PSA 87:4">ಇಗೋ ಫಿಲಿಷ್ಟಿಯ, ತೂರ್, ಕೂಷ್, ಜನಾಂಗಗಳು ಅಲ್ಲೇ ಹುಟ್ಟಿದವು” ಎಂಬುದೇ.<verse eid="PSA 87:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5"/>ಇದರಿಂದ ಚೀಯೋನೇ ಪ್ರತಿಯೊಂದು ಜನಾಂಗದ ಜನ್ಮನಗರವೆಂದು ಹೇಳಲ್ಪಡುವುದು;</para>
  <para style="q" vid="PSA 87:5">ಅದನ್ನು ಪರಾತ್ಪರನಾದ ದೇವರು ತಾನೇ ಸ್ಥಿರಪಡಿಸುವನು.<verse eid="PSA 87:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6"/>ಯೆಹೋವನು ಜನಾಂಗಗಳ ಪಟ್ಟಿಯನ್ನು ಮಾಡುವಾಗ,</para>
  <para style="q" vid="PSA 87:6">“ಪ್ರತಿಯೊಂದರ ವಿಷಯ ಇದು ಅಲ್ಲಿಯೇ ಹುಟ್ಟಿದ್ದು” ಎಂದು ಬರೆಯುವನು. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 87:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7"/>ಇವರು ಹಾಡುತ್ತಾ, ಕುಣಿಯುತ್ತಾ,</para>
  <para style="q" vid="PSA 87:7">“ನನ್ನ ಜೀವಜಲದ ಒರತೆಗಳೆಲ್ಲಾ ನಿನ್ನಲ್ಲಿಯೇ ಇವೆ” ಎಂದು ಹೇಳುವರು.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s">ದುಃಖತಪ್ತನ ಮೊರೆ</para>
  <para style="d">ಹಾಡು; ಕೋರಹೀಯರ ಕೀರ್ತನೆ; ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ಮಹಲಾತ್ ಎಂಬ ರಾಗದ ಪ್ರಕಾರ ಹಾಡತಕ್ಕದ್ದು; ಜೇರಹ ಕುಲದವನಾದ ಹೇಮಾನನ ಪದ್ಯ.</para>
  <para style="r">
    <ref loc="LAM 3">ಪ್ರಲಾ 3</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1"/>ಯೆಹೋವನೇ, ನನ್ನನ್ನು ರಕ್ಷಿಸುವ ದೇವರೇ,</para>
  <para style="q" vid="PSA 88:1">ಹಗಲಿರುಳು ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 88:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2"/>ನನ್ನ ಪ್ರಾರ್ಥನೆಯು ನಿನ್ನ ಸನ್ನಿಧಿಯನ್ನು ಮುಟ್ಟಲಿ;</para>
  <para style="q" vid="PSA 88:2">ಕಿವಿಗೊಟ್ಟು ನನ್ನ ಕೂಗನ್ನು ಕೇಳು.<verse eid="PSA 88:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3"/>ನನ್ನ ಜೀವವು ಕಷ್ಟಗಳಿಂದ ತುಂಬಿಹೋಯಿತು;</para>
  <para style="q" vid="PSA 88:3">ನನ್ನ ಪ್ರಾಣವು ಪಾತಾಳಕ್ಕೆ ಹತ್ತಿರವಾಯಿತು.<verse eid="PSA 88:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4"/>ಸಮಾಧಿಯಲ್ಲಿ ಸೇರುವವರೊಳಗೆ ಎಣಿಸಲ್ಪಟ್ಟಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 88:4">ನಿತ್ರಾಣ ಮನುಷ್ಯನಂತಿದ್ದೇನೆ.<verse eid="PSA 88:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5"/>ಸತ್ತವನ ಹಾಗೆ ನನ್ನನ್ನು ಹೊರಗೆ ಹಾಕಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 88:5">ಹತನಾದವನಂತೆ ಸಮಾಧಿಯಲ್ಲಿ ಬಿದ್ದಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 88:5">ಹತರಾದವರು ನಿನ್ನ ಪರಿಪಾಲನೆ ಇಲ್ಲದವರು;</para>
  <para style="q" vid="PSA 88:5">ಅಂಥವರನ್ನು ನೀನು ನೆನಪು ಮಾಡಿಕೊಳ್ಳುವುದಿಲ್ಲ.<verse eid="PSA 88:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6"/>ಅಧೋಲೋಕದಲ್ಲಿಯೂ, ಗಾಢಾಂಧಕಾರದಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 88:6">ಅಗಾಧ ಸ್ಥಳದಲ್ಲಿಯೂ ನನ್ನನ್ನು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದಿ.<verse eid="PSA 88:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7"/>ನಿನ್ನ ಕೋಪಭಾರವು ನನ್ನನ್ನು ಕುಗ್ಗಿಸಿಬಿಟ್ಟಿದೆ;</para>
  <para style="q" vid="PSA 88:7">ನಿನ್ನ ಎಲ್ಲಾ ತೆರೆಗಳಿಂದ ನನ್ನನ್ನು ಬಾಧಿಸಿದ್ದಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 88:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8"/>ನನ್ನ ಆಪ್ತರು ನನ್ನನ್ನು ನೋಡಿ ಅಸಹ್ಯಪಟ್ಟರು,</para>
  <para style="q" vid="PSA 88:8">ನನ್ನನ್ನು ಅವರು ಹೇಸಿ ಬಿಟ್ಟುಹೋಗುವಂತೆ ಮಾಡಿದ್ದೀ;</para>
  <para style="q" vid="PSA 88:8">ಸಿಕ್ಕಿಬಿಟ್ಟಿದ್ದೇನೆ, ಬಿಡಿಸಿಕೊಳ್ಳಲಾರೆನು.<verse eid="PSA 88:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9"/>ಬಾಧೆಯಿಂದ ನನ್ನ ಕಣ್ಣುಗಳು ಮೊಬ್ಬಾಗಿ ಹೋಗಿವೆ.</para>
  <para style="q" vid="PSA 88:9">ಯೆಹೋವನೇ, ಹಗಲೆಲ್ಲಾ ಕೈಚಾಚಿ ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 88:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10"/>ನೀನು ಸತ್ತವರಿಗೆ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ತೋರಿಸುವಿಯೋ?</para>
  <para style="q" vid="PSA 88:10">ಪ್ರೇತಗಳು ಎದ್ದು ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವವೋ? <char style="qs">ಸೆಲಾ </char><verse eid="PSA 88:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11"/>ಸಮಾಧಿಯಲ್ಲಿ ನಿನ್ನ ಕೃಪೆಯನ್ನೂ,</para>
  <para style="q" vid="PSA 88:11">ನಾಶನಲೋಕದಲ್ಲಿ ನಿನ್ನ ಸತ್ಯತೆಯನ್ನು ಸಾರುವುದುಂಟೋ?<verse eid="PSA 88:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12"/>ಕತ್ತಲೆಯ ಲೋಕದಲ್ಲಿ ನಿನ್ನ ಮಹತ್ಕಾರ್ಯಗಳೂ,</para>
  <para style="q" vid="PSA 88:12">ಮರೆಯುವ ದೇಶದಲ್ಲಿ ನಿನ್ನ ನೀತಿಯು ತಿಳಿಯಲ್ಪಡುವವೋ?<verse eid="PSA 88:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13"/>ನಾನಾದರೋ ಯೆಹೋವನೇ, ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 88:13">ಮುಂಜಾನೆಯಲ್ಲಿ ನನ್ನ ವಿಜ್ಞಾಪನೆಯು ನಿನ್ನ ಮುಂದೆ ಬರುವುದು.<verse eid="PSA 88:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14"/>ಯೆಹೋವನೇ, ನನ್ನ ಪ್ರಾಣವನ್ನೇಕೆ ತಳ್ಳಿಬಿಟ್ಟಿ?</para>
  <para style="q" vid="PSA 88:14">ನಿನ್ನ ಮುಖವನ್ನು ಮರೆಮಾಡಿದ್ದೇಕೆ?<verse eid="PSA 88:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15"/>ಯೌವನಾರಭ್ಯ ಕುಗ್ಗಿದವನೂ, ಮೃತಪ್ರಾಯನೂ,</para>
  <para style="q" vid="PSA 88:15">ನಿನ್ನ ಗದರಿಕೆಯಿಂದ ದೆಸೆಗೆಟ್ಟವನೂ ಆಗಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 88:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16"/>ನಿನ್ನ ಕೋಪಜ್ವಾಲೆಯು ನನ್ನನ್ನು ಕವಿದಿದೆ;</para>
  <para style="q" vid="PSA 88:16">ನಿನ್ನಿಂದುಂಟಾದ ದಿಗಿಲಿನಿಂದ ಹಾಳಾದೆನು.<verse eid="PSA 88:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17"/>ಅವು ದಿನವೆಲ್ಲಾ ನೀರಿನಂತೆ ನನ್ನನ್ನು ಆವರಿಸಿಕೊಂಡಿವೆ;</para>
  <para style="q" vid="PSA 88:17">ಒಟ್ಟುಗೂಡಿ ನನ್ನನ್ನು ಸುತ್ತಿಬಿಟ್ಟಿವೆ.<verse eid="PSA 88:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18"/>ನನ್ನ ಆಪ್ತಮಿತ್ರರನ್ನು ದೂರಮಾಡಿದಿ;</para>
  <para style="q" vid="PSA 88:18">ಅಂಧಕಾರವೇ ನನ್ನ ಒಡನಾಡಿ.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s">ಸರ್ವಶಕ್ತನಾದ ದೇವರು ದಾವೀದನಿಗೆ ಮಾಡಿದ ವಾಗ್ದಾನವನ್ನು ನೆರವೇರಿಸಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಜೇರಹ ಕುಲದವನಾದ ಏತಾನನ ಪದ್ಯ.</para>
  <para style="r">
    <ref loc="2SA 7">2ಸಮು 7</ref>; <ref loc="PSA 44">ಕೀರ್ತ 44</ref>; <ref loc="PSA 80">80</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1"/>ಯೆಹೋವನೇ, ನಿತ್ಯವೂ ನಿನ್ನ ಕೃಪಾತಿಶಯವನ್ನು ಹಾಡಿಹರಸುವೆನು;</para>
  <para style="q" vid="PSA 89:1">ನನ್ನ ಬಾಯಿ ನಿನ್ನ ಸತ್ಯವನ್ನು,</para>
  <para style="q" vid="PSA 89:1">ಮುಂದಣ ಸಂತಾನದವರೆಲ್ಲರಿಗೂ ತಿಳಿಯಮಾಡುವುದು.<verse eid="PSA 89:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2"/>ನಿನ್ನ ಪ್ರೀತಿಸಂಕಲ್ಪವು ನಿತ್ಯವು ಸಿದ್ಧಿಗೆ ಬರುತ್ತಲೇ ಇರುವುದು;</para>
  <para style="q" vid="PSA 89:2">ಆಕಾಶದಲ್ಲಿ ನಿನ್ನ ಸತ್ಯತೆಯನ್ನು ಸ್ಥಾಪಿಸುವಿ ಎಂದು ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 89:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3"/>ನೀನು ನುಡಿದದ್ದೇನೆಂದರೆ, “ನಾನು ಆರಿಸಿಕೊಂಡ</para>
  <para style="q" vid="PSA 89:3">ಸೇವಕನಾದ ದಾವೀದನ ಸಂಗಡ ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡು ಆಣೆಯಿಟ್ಟು,<verse eid="PSA 89:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4"/>‘ಶಾಶ್ವತವಾಗಿ ನಿನ್ನ ಸಂತತಿಯನ್ನು ಸ್ಥಾಪಿಸುವೆನು,</para>
  <para style="q" vid="PSA 89:4">ತಲತಲಾಂತರಗಳಿಗೂ ನಿನ್ನ ಸಿಂಹಾಸನವನ್ನು ಸ್ಥಿರಪಡಿಸುವೆನು</para>
  <para style="q" vid="PSA 89:4">ಎಂದು ಹೇಳಿದ್ದೇನೆ’” ಎಂಬುವುದೇ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 89:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5"/>ಯೆಹೋವನೇ, ಗಗನವು ನಿನ್ನ ಮಹತ್ತನ್ನು ಪ್ರಸಿದ್ಧಪಡಿಸುವುದು;</para>
  <para style="q" vid="PSA 89:5">ನಿನ್ನ ಸತ್ಯವನ್ನು ಪರಿಶುದ್ಧರ ಸಭೆಯಲ್ಲಿ ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 89:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6"/>ಮೇಘಮಂಡಲದಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಸಮಾನರು ಯಾರು?</para>
  <para style="q" vid="PSA 89:6">ದೇವದೂತರಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಸರಿಯಾದವರು ಯಾರು?<verse eid="PSA 89:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7"/>ಆತನು ಪರಿಶುದ್ಧರ ಸಭೆಯಲ್ಲಿ ಘನ ಹೊಂದುವ ದೇವರು;</para>
  <para style="q" vid="PSA 89:7">ತನ್ನ ಎಲ್ಲಾ ಪರಿವಾರದವರಿಗಿಂತ ಭಯಂಕರನು.<verse eid="PSA 89:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8"/>ಯೆಹೋವನೇ, ಸೇನಾಧೀಶ್ವರನಾದ ದೇವರೇ,</para>
  <para style="q" vid="PSA 89:8">ನಿನಗೆ ಸಮಾನರು ಯಾರು?</para>
  <para style="q" vid="PSA 89:8">ಯಾಹುವೇ, ನೀನು ಶಕ್ತನು, ಸತ್ಯತೆಯಿಂದ ಆವರಿಸಲ್ಪಟ್ಟವನು.<verse eid="PSA 89:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9"/>ಸಮುದ್ರದ ಅಲ್ಲಕಲ್ಲೋಲಗಳನ್ನು ಅಧೀನದಲ್ಲಿ ಇಟ್ಟುಕೊಂಡಿರುವವನು ನೀನು;</para>
  <para style="q" vid="PSA 89:9">ತೆರೆಗಳು ಏಳುವಾಗ ಅವುಗಳನ್ನು ತಡೆಯುವವನು ನೀನು.<verse eid="PSA 89:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10"/>ರಹಬನ್ನು<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="fq" closed="false">ರಹಬನ್ನು </char><char style="ft" closed="false">ಪೌರಾಣಿಕ ಸಮುದ್ರ ದೈತ್ಯ ರಹಬನು ಯೋಬ. 9:13; 26:2; ಯೆಶಾ 51:9 ರಲ್ಲಿ ಕೂಡ ಉಲ್ಲೇಖಿಸಲಾಗಿದೆ; 87:4 ರಲ್ಲಿ ಅದರ ಬಳಕೆಯು ಭಿನ್ನವಾಗಿದೆ, ಇಲ್ಲಿ ರಹಬ ಕಡಲ ಪೌರಾಣಿಕ ಸರ್ಪವನ್ನು ಸೂಚಿಸುತ್ತದೆ.</char></note> ಛೇದಿಸಿ ಸಾಯಿಸಿದವನು ನೀನು;</para>
  <para style="q" vid="PSA 89:10">ನಿನ್ನ ಭುಜಬಲದಿಂದ ಶತ್ರುಗಳನ್ನು ಚದರಿಸಿಬಿಟ್ಟಿದ್ದಿ.<verse eid="PSA 89:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11"/>ಆಕಾಶವೂ ನಿನ್ನದು, ಭೂಮಿಯೂ ನಿನ್ನದೇ;</para>
  <para style="q" vid="PSA 89:11">ಲೋಕವನ್ನೂ ಅದರಲ್ಲಿರುವುದೆಲ್ಲವನ್ನೂ ನಿರ್ಮಿಸಿದವನು ನೀನು.<verse eid="PSA 89:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12"/>ದಕ್ಷಿಣೋತ್ತರ ದಿಕ್ಕುಗಳನ್ನು ಉಂಟುಮಾಡಿದವನು ನೀನು.</para>
  <para style="q" vid="PSA 89:12">ತಾಬೋರ್<note caller="+" style="f"><char style="fr" closed="false">89:12 </char><char style="fq" closed="false">ತಾಬೋರ್ </char><char style="ft" closed="false">ತಾಬೋರ್ ಗಲಿಲಾಯ ಸರೋವರದ ದಕ್ಷಿಣದ ತುದಿಯಲ್ಲಿರುವ ಪರ್ವತವಾಗಿದೆ, 555 ಮೀಟರ್ ಎತ್ತರವಿದೆ.</char></note>, ಹೆರ್ಮೋನ್<note caller="+" style="f"><char style="fr" closed="false">89:12 </char><char style="fq" closed="false">ಹೆರ್ಮೋನ್ </char><char style="ft" closed="false">ಹೆರ್ಮೋನ್ ಪರ್ವತವು ಗಲಿಲಾಯ ಸರೋವರದಿಂದ 75 ಕಿಲೋಮೀಟರ್ (45 ಮೈಲುಗಳು) ಈಶಾನ್ಯ ಭಾಗದಲ್ಲಿದೆ, ಸುಮಾರು 2,750 ಮೀಟರ್ (8,940 ಅಡಿ) ಎತ್ತರವಿದೆ.</char></note> ಪರ್ವತಗಳು ನಿನ್ನ ನಾಮದಲ್ಲಿ ಆನಂದಧ್ವನಿ ಮಾಡುತ್ತವೆ.<verse eid="PSA 89:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13"/>ನಿನ್ನ ಭುಜಬಲವು ಮಹಾಬಲವುಳ್ಳದ್ದು. ನಿನ್ನ ಹಸ್ತವು ಶಕ್ತಿಯುಳ್ಳದ್ದು;</para>
  <para style="q" vid="PSA 89:13">ನಿನ್ನ ಬಲಗೈ ಮಹತ್ತುಗಳನ್ನು ನಡೆಸುತ್ತದೆ.<verse eid="PSA 89:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14"/>ನೀತಿ ಮತ್ತು ನ್ಯಾಯಗಳು ನಿನ್ನ ಸಿಂಹಾಸನದ ಅಸ್ತಿವಾರವು;</para>
  <para style="q" vid="PSA 89:14">ನಿನ್ನ ಸಾನ್ನಿಧ್ಯದೂತರು ಪ್ರೀತಿ ಮತ್ತು ಸತ್ಯತೆಗಳೇ.<verse eid="PSA 89:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15"/>ಉತ್ಸಾಹಧ್ವನಿಯನ್ನು <note caller="+" style="f"><char style="fr" closed="false">89:15 </char><char style="fq" closed="false">ಉತ್ಸಾಹಧ್ವನಿಯನ್ನು </char><char style="ft" closed="false">ಅಂದರೆ ದೇವರನ್ನು ಆರಾಧಿಸುವಾಗ ಮಾಡುವ ಶಬ್ದ.</char></note>ತಿಳಿದಿರುವ ಜನರು ಧನ್ಯರು;</para>
  <para style="q" vid="PSA 89:15">ಯೆಹೋವನೇ, ಅವರು ನಿನ್ನ ಮುಖಪ್ರಕಾಶದಲ್ಲಿ ಸಂಚರಿಸುತ್ತಾರೆ.<verse eid="PSA 89:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16"/>ಯಾವಾಗಲೂ ನಿನ್ನ ನಾಮದಲ್ಲಿ ಆನಂದಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 89:16">ನಿನ್ನ ನೀತಿಯಿಂದ ಏಳಿಗೆ ಹೊಂದುತ್ತಾರೆ.<verse eid="PSA 89:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17"/>ಅವರು ಹಿಗ್ಗುವ ಬಲವು ನೀನೇ.</para>
  <para style="q" vid="PSA 89:17">ನಿನ್ನ ಕರುಣೆಯ ಕಟಾಕ್ಷದಿಂದ ನಮ್ಮ ಕೊಂಬು<note caller="+" style="f"><char style="fr" closed="false">89:17 </char><char style="fq" closed="false">ಕೊಂಬು </char><char style="ft" closed="false">ಅಂದರೆ ಬಲ.</char></note> ಎತ್ತಲ್ಪಟ್ಟಿರುವುದು.<verse eid="PSA 89:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18"/>ನಮಗೆ ಗುರಾಣಿಯಂತಿರುವ ನಮ್ಮ ಅರಸನು ಯೆಹೋವನೇ;</para>
  <para style="q" vid="PSA 89:18">ಅವನು ಇಸ್ರಾಯೇಲರ ಸದಮಲಸ್ವಾಮಿಯ, ಸ್ವಕೀಯನು.<verse eid="PSA 89:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19"/>ಆ ಕಾಲದಲ್ಲಿ ನೀನು ದರ್ಶನದಲ್ಲಿ ನಿನ್ನ ಭಕ್ತರಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ,</para>
  <para style="q" vid="PSA 89:19">“ಒಬ್ಬ ಶೂರನಿಗೆ ರಕ್ಷಾಬಲವನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 89:19">ಪ್ರಜೆಗಳಲ್ಲಿ ಒಬ್ಬ ಯೌವನಸ್ಥನನ್ನು ಆರಿಸಿ ಉನ್ನತಸ್ಥಾನದಲ್ಲಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 89:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20"/>ನನ್ನ ಸೇವಕನಾದ ದಾವೀದನನ್ನು ಕಂಡು,</para>
  <para style="q" vid="PSA 89:20">ಪರಿಶುದ್ಧ ತೈಲದಿಂದ ಅವನನ್ನು ಅಭಿಷೇಕಿಸಿದ್ದೇನೆ.<verse eid="PSA 89:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21"/>ನನ್ನ ಹಸ್ತವು ಅವನ ಮೇಲೆ ಸ್ಥಿರವಾಗಿರುವುದು;</para>
  <para style="q" vid="PSA 89:21">ನನ್ನ ಭುಜವು ಅವನನ್ನು ಬಲಪಡಿಸುವುದು.<verse eid="PSA 89:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22"/>ವೈರಿಯ ಕುತಂತ್ರವು ಅವನಲ್ಲಿ ಸಾಗದು;</para>
  <para style="q" vid="PSA 89:22">ಯಾವ ಕೆಡುಕನೂ ಅವನನ್ನು ಕುಗ್ಗಿಸಲಾರನು.<verse eid="PSA 89:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23"/>ಅವನ ವಿರೋಧಿಗಳನ್ನು ಅವನ ಮುಂದೆಯೇ ಜಜ್ಜಿ ಹಾಕುವೆನು;</para>
  <para style="q" vid="PSA 89:23">ಅವನ ದ್ವೇಷಿಗಳನ್ನು ಹತಮಾಡಿಬಿಡುವೆನು.<verse eid="PSA 89:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24"/>ಆದರೆ ನನ್ನ ಪ್ರೀತಿ ಮತ್ತು ಸತ್ಯತೆಗಳು ಅವನೊಡನೆ ಇರುವವು;</para>
  <para style="q" vid="PSA 89:24">ನನ್ನ ಹೆಸರಿನಿಂದ ಅವನ ಕೊಂಬು ಎತ್ತಲ್ಪಡುವುದು.<verse eid="PSA 89:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25"/>ಸಮುದ್ರದಿಂದ ನದಿಗಳವರೆಗೂ ಅವನ ಹಸ್ತಕ್ಕೆ ಅಧಿಕಾರವನ್ನು ಕೊಡುವೆನು.<verse eid="PSA 89:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26"/>ಅವನು ನನಗೆ, ‘ನನ್ನ ತಂದೆಯೂ, ದೇವರೂ,</para>
  <para style="q" vid="PSA 89:26">ಆಶ್ರಯದುರ್ಗವೂ ನೀನೇ’ ಎಂದು ಹೇಳುವನು.<verse eid="PSA 89:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27"/>ನಾನಾದರೋ ಅವನನ್ನು ಜ್ಯೇಷ್ಠಪುತ್ರನನ್ನಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 89:27">ಭೂರಾಜರಲ್ಲಿ ಉನ್ನತನನ್ನಾಗಿಯೂ ಮಾಡಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 89:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28"/>ನನ್ನ ಕೃಪೆಯು ಅವನಲ್ಲಿ ಶಾಶ್ವತವಾಗಿ ಇರುವುದು;</para>
  <para style="q" vid="PSA 89:28">ನನ್ನ ಒಡಂಬಡಿಕೆಯು ಅವನಲ್ಲಿ ಸ್ಥಿರವಾಗಿರುವುದು.<verse eid="PSA 89:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29"/>ಅವನ ಸಂತಾನವನ್ನು ಯಾವಾಗಲೂ ಉಳಿಸುವೆನು.</para>
  <para style="q" vid="PSA 89:29">ಅವನ ಸಿಂಹಾಸನವು ಆಕಾಶವಿರುವವರೆಗೂ ಇರುವುದು.<verse eid="PSA 89:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30"/>ಅವನ ಸಂತಾನದವರು ನನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಬಿಟ್ಟು,</para>
  <para style="q" vid="PSA 89:30">ನನ್ನ ಆಜ್ಞೆಗಳಲ್ಲಿ ನಡೆಯದೆ,<verse eid="PSA 89:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31"/>ನನ್ನ ವಿಧಿಗಳನ್ನು ಮೀರಿ, ನನ್ನ ನೇಮಗಳನ್ನು ಪಾಲಿಸದೆ ಹೋದರೆ,<verse eid="PSA 89:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32"/>ಆಗ ನಾನು ಅವರ ದ್ರೋಹಕ್ಕಾಗಿ ಅವರನ್ನು ಬೆತ್ತದಿಂದ ಹೊಡೆಯುವೆನು;</para>
  <para style="q" vid="PSA 89:32">ಅವರ ಅಪರಾಧಕ್ಕಾಗಿ ಪೆಟ್ಟುಕೊಡುವೆನು.<verse eid="PSA 89:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33"/>ಆದರೂ ನಾನು ಅವನಲ್ಲಿಟ್ಟಿರುವ ಕೃಪೆಯನ್ನು ತಪ್ಪಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 89:33">ನನ್ನ ನಂಬಿಗಸ್ತಿಕೆಯಿಂದ ಜಾರುವುದಿಲ್ಲ.<verse eid="PSA 89:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34"/>ನನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಭಂಗಪಡಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 89:34">ನನ್ನ ಮಾತನ್ನು ಬದಲಿಸುವುದಿಲ್ಲ.<verse eid="PSA 89:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35"/>ನನ್ನ ಪವಿತ್ರತ್ವದಲ್ಲಿ ಆಣೆಯಿಟ್ಟು ಒಂದು ಸಂಗತಿಯನ್ನು ಹೇಳಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 89:35">ಅದರ ವಿಷಯದಲ್ಲಿ ನಾನು ದಾವೀದನಿಗೆ ಸುಳ್ಳುಗಾರನಾಗುವುದಿಲ್ಲ.<verse eid="PSA 89:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36"/>ಅದೇನೆಂದರೆ, ಅವನ ಸಂತತಿಯು ಶಾಶ್ವತವಾಗಿ ಇರುವುದು;</para>
  <para style="q" vid="PSA 89:36">ಅವನ ಸಿಂಹಾಸನವು ಸೂರ್ಯನಂತೆ ನನ್ನ ಎದುರಿನಲ್ಲಿದ್ದು,<verse eid="PSA 89:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37"/>ಚಂದ್ರನಂತೆ ನಿತ್ಯಕ್ಕೂ ಸ್ಥಿರವಾಗಿರುವುದು.</para>
  <para style="q" vid="PSA 89:37">ಪರಲೋಕದ ಸಾಕ್ಷಿ ಸತ್ಯವೇ ಸರಿ.” <char style="qs">ಸೆಲಾ. </char><verse eid="PSA 89:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38"/>ಹೀಗೆ ಹೇಳಿದ ನೀನು ನಿನ್ನ ಅಭಿಷಿಕ್ತನ ಮೇಲೆ ಕೋಪಗೊಂಡವನಾಗಿ,</para>
  <para style="q" vid="PSA 89:38">ಅವನನ್ನು ಅಸಹ್ಯಿಸಿ ತಳ್ಳಿಬಿಟ್ಟಿದ್ದೀ.<verse eid="PSA 89:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39"/>ನೀನು ನಿನ್ನ ಸೇವಕನ ಸಂಗಡ ಮಾಡಿಕೊಂಡ ಒಡಂಬಡಿಕೆಯನ್ನು ಭಂಗಪಡಿಸಿ,</para>
  <para style="q" vid="PSA 89:39">ಅವನ ಕಿರೀಟವನ್ನು ನೆಲಕ್ಕೆ ಹಾಕಿ ಅಪವಿತ್ರಮಾಡಿದ್ದೀ.<verse eid="PSA 89:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40"/>ಅವನ ದೇಶದ ಮೇರೆಗಳನ್ನು ಕೆಡವಿ, ಕೋಟೆಗಳನ್ನು ಹಾಳುಮಾಡಿದ್ದೀ.<verse eid="PSA 89:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41"/>ದಾರಿಗರೆಲ್ಲರೂ ಅವನನ್ನು ಸುಲಿಗೆ ಮಾಡುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 89:41">ಅವನು ನೆರೆಹೊರೆಯವರ ಪರಿಹಾಸ್ಯಕ್ಕೆ ಗುರಿಯಾಗಿದ್ದಾನೆ.<verse eid="PSA 89:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42"/>ಅವನ ವಿರೋಧಿಗಳ ಹಸ್ತವನ್ನು ಉನ್ನತಪಡಿಸಿದ್ದೀ;</para>
  <para style="q" vid="PSA 89:42">ಅವನ ವೈರಿಗಳಿಗೆಲ್ಲಾ ಆನಂದವಾಗುವಂತೆ ಮಾಡಿದ್ದೀ.<verse eid="PSA 89:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43"/>ಇದಲ್ಲದೆ ಅವನ ಕತ್ತಿಯನ್ನು ತಿರುಗಿಸಿಬಿಟ್ಟಿದ್ದೀ;</para>
  <para style="q" vid="PSA 89:43">ಅವನನ್ನು ಯುದ್ಧದಲ್ಲಿ ನಿಲ್ಲದಂತೆ ಮಾಡಿದ್ದೀ.<verse eid="PSA 89:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44"/>ಅವನ ವೈಭವವನ್ನು<note caller="+" style="f"><char style="fr" closed="false">89:44 </char><char style="fq" closed="false">ವೈಭವವನ್ನು </char><char style="ft" closed="false">ಅಂದರೆ ರಾಜದಂಡ.</char></note> ತಡೆದುಬಿಟ್ಟಿದ್ದೀ;</para>
  <para style="q" vid="PSA 89:44">ಅವನ ಸಿಂಹಾಸನವನ್ನು ನೆಲಕ್ಕುರುಳಿಸಿದ್ದೀ.<verse eid="PSA 89:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45"/>ಅವನ ಯೌವನದ ದಿನಗಳನ್ನು ಬೇಗ ಮುಗಿಸಿ,</para>
  <para style="q" vid="PSA 89:45">ನಾಚಿಕೆಯು ಅವನನ್ನು ಕವಿಯುವಂತೆ ಮಾಡಿದ್ದಿ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 89:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46"/>ಯೆಹೋವನೇ, ಇನ್ನೆಷ್ಟರವರೆಗೆ ಮರೆಯಾಗಿರುವಿ?</para>
  <para style="q" vid="PSA 89:46">ನಿನ್ನ ಕೋಪಾಗ್ನಿಯು ನಮ್ಮ ಮೇಲೆ ಸದಾ ಉರಿಯುತ್ತಿರಬೇಕೋ?<verse eid="PSA 89:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47"/>ನನ್ನ ಆಯುಷ್ಯವು ಎಷ್ಟು ಅಲ್ಪವೆಂದೂ,</para>
  <para style="q" vid="PSA 89:47">ಎಂಥಾ ವ್ಯರ್ಥ ಜೀವಿತಕ್ಕಾಗಿ ಮನುಷ್ಯರನ್ನು ನಿರ್ಮಿಸಿದ್ದಿ ಎಂದೂ ಜ್ಞಾಪಿಸಿಕೋ.<verse eid="PSA 89:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48"/>ತಮ್ಮನ್ನು ಪಾತಾಳಕ್ಕೆ ತಪ್ಪಿಸಿಕೊಂಡು, ಮರಣಹೊಂದದೆ</para>
  <para style="q" vid="PSA 89:48">ಚಿರಂಜೀವಿಯಾಗಿರುವವರು ಯಾರು? <char style="qs">ಸೆಲಾ </char><verse eid="PSA 89:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49"/>ಕರ್ತನೇ, ನೀನು ನಿನ್ನ ಸತ್ಯತೆಯಲ್ಲಿ ಆಣೆಯಿಟ್ಟು,</para>
  <para style="q" vid="PSA 89:49">ದಾವೀದನಿಗೆ ವಾಗ್ದಾನಮಾಡಿ ನಡೆಸುತ್ತಿದ್ದ ಹಿಂದಿನ ಕೃಪಾಕಾರ್ಯಗಳು ಎಲ್ಲಿ?<verse eid="PSA 89:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50"/>ಯೆಹೋವನೇ, ನಿನ್ನ ವೈರಿಗಳು ನಿಂದಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 89:50">ನಿನ್ನ ಅಭಿಷಿಕ್ತನನ್ನು ಹೆಜ್ಜೆ ಹೆಜ್ಜೆಗೂ ಅಪಮಾನ ಮಾಡುತ್ತಾರೆ.<verse eid="PSA 89:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51"/>ಕರ್ತನೇ, ನಿನ್ನ ಸೇವಕರಿಗಾಗುವ ಅಪವಾದವನ್ನೂ,</para>
  <para style="q" vid="PSA 89:51">ನಾನು ಎಲ್ಲಾ ಜನಾಂಗಗಳ ನಿಂದಾಭಾರವನ್ನು ಉಡಿಲಲ್ಲಿ ಕಟ್ಟಿರುವುದನ್ನೂ ಜ್ಞಾಪಿಸಿಕೋ.<verse eid="PSA 89:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52"/>ಯೆಹೋವನಿಗೆ ಸದಾಕಾಲವೂ ಕೊಂಡಾಟವಾಗಲಿ. ಆಮೆನ್, ಆಮೆನ್.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">ಚತುರ್ಥ ಭಾಗ (90-106)</para>
  <para style="d">ಪಾಪಾತ್ಮರಿಗೆ ದೇವರ ದಯವೇ ಆಶ್ರಯ</para>
  <para style="s">ದೇವರ ಮನುಷ್ಯನಾದ ಮೋಶೆಯ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="r">
    <ref loc="DEU 32">ಧರ್ಮೋ 32</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1"/>ಕರ್ತನೇ, ತಲತಲಾಂತರಗಳಿಂದಲೂ ನಮ್ಮ ಆಶ್ರಯಸ್ಥಾನವು ನೀನೇ.<verse eid="PSA 90:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2"/>ಬೆಟ್ಟಗಳು ಉಂಟಾಗುವುದಕ್ಕಿಂತ ಮೊದಲೇ,</para>
  <para style="q" vid="PSA 90:2">ಭೂಮಿಯೂ ಅದರ ದೇಶಗಳೂ ನಿರ್ಮಾಣವಾಗುವುದಕ್ಕಿಂತ ಮೊದಲೇ,</para>
  <para style="q" vid="PSA 90:2">ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ನೀನೇ ದೇವರು.<verse eid="PSA 90:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3"/>“ಮನುಷ್ಯರೇ, ಸಾಯಿರಿ” ಎಂದು ಆಜ್ಞಾಪಿಸಿ,</para>
  <para style="q" vid="PSA 90:3">ಅವರನ್ನು ಪುನಃ ಮಣ್ಣಿಗೆ ಸೇರಿಸುತ್ತೀ.<verse eid="PSA 90:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4"/>ಸಾವಿರ ವರ್ಷಗಳು ನಿನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ</para>
  <para style="q" vid="PSA 90:4">ಗತಿಸಿಹೋದ ನಿನ್ನೆಯ ದಿನದಂತೆಯೂ,</para>
  <para style="q" vid="PSA 90:4">ರಾತ್ರಿಯ ಜಾವದಂತೆಯೂ ಇವೆ.<verse eid="PSA 90:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5"/>ನೀನು ಮನುಷ್ಯರನ್ನು ಪ್ರವಾಹದಿಂದ ಬಡಿದುಕೊಂಡು ಹೋಗುತ್ತೀ;</para>
  <para style="q" vid="PSA 90:5">ಅವರು ನಿದ್ರೆಗೆ ಸಮಾನರೇ.</para>
  <para style="q" vid="PSA 90:5">ಅವರು ಹೊತ್ತಾರೆಯಲ್ಲಿ ಚಿಗುರುವ ಹುಲ್ಲಿನಂತಿದ್ದಾರೆ.<verse eid="PSA 90:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6"/>ಅದು ಮುಂಜಾನೆಯಲ್ಲಿ ಬೆಳೆದು ಹೂಬಿಡುತ್ತದೆ;</para>
  <para style="q" vid="PSA 90:6">ಸಂಜೆಯಲ್ಲಿ ಕೊಯ್ಯಲ್ಪಟ್ಟು ಒಣಗಿಹೋಗುತ್ತದೆ.<verse eid="PSA 90:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7"/>ನಿನ್ನ ಕೋಪದಿಂದ ನಾವು ಇಲ್ಲವಾದೆವು;</para>
  <para style="q" vid="PSA 90:7">ನಿನ್ನ ರೌದ್ರದಿಂದ ತಲ್ಲಣಗೊಂಡೆವು.<verse eid="PSA 90:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8"/>ನಮ್ಮ ದ್ರೋಹಗಳನ್ನು ನಿನ್ನ ಮುಂದೆಯೂ,</para>
  <para style="q" vid="PSA 90:8">ನಮ್ಮ ಗುಪ್ತಪಾಪಗಳನ್ನು ನಿನ್ನ ತೇಜೋದೃಷ್ಟಿಯಲ್ಲಿಯೂ ಇಟ್ಟುಕೊಂಡಿದ್ದಿ.<verse eid="PSA 90:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9"/>ನಿನ್ನ ರೋಷದಿಂದ ನಮ್ಮ ಕಾಲವೆಲ್ಲಾ ಕಳೆದು ಹೋಯಿತು;</para>
  <para style="q" vid="PSA 90:9">ನಮ್ಮ ವರ್ಷಗಳು ನಿಟ್ಟುಸಿರಿನಂತೆ ತೀರಿಹೋದವು.<verse eid="PSA 90:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10"/>ನಮ್ಮ ಆಯುಷ್ಕಾಲವು<note caller="+" style="f"><char style="fr" closed="false">90:10 </char><char style="fq" closed="false">ಆಯುಷ್ಕಾಲವು </char><char style="ft" closed="false">ಅಥವಾ ಪ್ರತಾಪ.</char></note> ಎಪ್ಪತ್ತು ವರ್ಷ,</para>
  <para style="q" vid="PSA 90:10">ಬಲ ಹೆಚ್ಚಿದರೆ ಎಂಭತ್ತು;</para>
  <para style="q" vid="PSA 90:10">ಕಷ್ಟಸಂಕಟಗಳೇ ಅದರ ಆಡಂಬರ.</para>
  <para style="q" vid="PSA 90:10">ಅದು ಬೇಗನೆ ಗತಿಸಿಹೋಗುತ್ತದೆ;</para>
  <para style="q" vid="PSA 90:10">ನಾವು ಹಾರಿ ಹೋಗುತ್ತೇವೆ.<verse eid="PSA 90:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11"/>ನಿನ್ನ ಕೋಪದ ಬಲವನ್ನೂ,</para>
  <para style="q" vid="PSA 90:11">ಭಯಭಕ್ತಿಗೆ ಕಾರಣವಾಗಿರತಕ್ಕ ನಿನ್ನ ರೌದ್ರವನ್ನೂ ಗ್ರಹಿಸುವವರಾರು?<verse eid="PSA 90:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12"/>ನಮ್ಮ ದಿನಗಳು ಕೊಂಚವೇ ಎಂದು ಎಣಿಸಿಕೊಳ್ಳುವ ಹಾಗೆ ನಮಗೆ ಕಲಿಸು;</para>
  <para style="q" vid="PSA 90:12">ಆಗ ಜ್ಞಾನದ ಹೃದಯವನ್ನು ಪಡೆದುಕೊಳ್ಳುವೆವು.<verse eid="PSA 90:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13"/>ಯೆಹೋವನೇ, ಮನಸ್ಸನ್ನು ಬೇರೆ ಮಾಡಿಕೋ;</para>
  <para style="q" vid="PSA 90:13">ಎಷ್ಟರವರೆಗೆ ಕೋಪ ಮಾಡುವಿ?</para>
  <para style="q" vid="PSA 90:13">ನಿನ್ನ ಸೇವಕರ ಮೇಲೆ ಕರುಣೆಯಿರಲಿ.<verse eid="PSA 90:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14"/>ಮುಂಜಾನೆಯಲ್ಲಿ ನಿನ್ನ ಕೃಪೆಯಿಂದ ನಮ್ಮನ್ನು ಸಂತೃಪ್ತಿಪಡಿಸು;</para>
  <para style="q" vid="PSA 90:14">ಆಗ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಉಲ್ಲಾಸಿಸಿ ಹರ್ಷಿಸುವೆವು.<verse eid="PSA 90:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15"/>ನೀನು ನಮ್ಮನ್ನು ಕುಗ್ಗಿಸಿದ ದಿನಗಳಿಗೂ,</para>
  <para style="q" vid="PSA 90:15">ನಾವು ಕೇಡನ್ನು ಅನುಭವಿಸಿದ ವರ್ಷಗಳಿಗೂ ತಕ್ಕಂತೆ ನಮ್ಮನ್ನು ಸಂತೋಷಪಡಿಸು.<verse eid="PSA 90:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16"/>ನಿನ್ನ ಸೇವಕರಿಗೆ ನಿನ್ನ ರಕ್ಷಣಾ ಕಾರ್ಯವೂ,</para>
  <para style="q" vid="PSA 90:16">ಅವರ ಮಕ್ಕಳಿಗೋಸ್ಕರ ನಿನ್ನ ಮಹತ್ತೂ ಪ್ರಕಟವಾಗಲಿ.<verse eid="PSA 90:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17"/>ನಮ್ಮ ಯೆಹೋವ ದೇವರ ಪ್ರಸನ್ನತೆಯು ನಮ್ಮ ಮೇಲೆ ಇರಲಿ.</para>
  <para style="q" vid="PSA 90:17">ನಾವು ಕೈ ಹಾಕಿದ ಕೆಲಸವನ್ನು ನಮಗೆ ಸಫಲಪಡಿಸು;</para>
  <para style="q" vid="PSA 90:17">ನಾವು ಕೈಹಾಕಿದ ಕೆಲಸವನ್ನು ಸಫಲ ವಾಗುವಂತೆ ಮಾಡು.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="s">ದೇವಾಶ್ರಿತನು ಸುರಕ್ಷಿತನು</para>
  <para style="r">
    <ref loc="EXO 23:20-26">ವಿಮೋ 23:20-26</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1"/>ಅತ್ಯುನ್ನತನಾದ ದೇವರ ಮೊರೆಹೊಕ್ಕವನು,</para>
  <para style="q" vid="PSA 91:1">ಸರ್ವಶಕ್ತನ ಆಶ್ರಯದಲ್ಲಿ ಸುರಕ್ಷಿತನಾಗಿರುವನು.<verse eid="PSA 91:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2"/>ನಾನು ಯೆಹೋವನಿಗೆ, “ನೀನೇ ನನ್ನ ಶರಣನು, ನನ್ನ ದುರ್ಗವು,</para>
  <para style="q" vid="PSA 91:2">ನಾನು ಭರವಸವಿಟ್ಟಿರುವ ನನ್ನ ದೇವರು” ಎಂದು ಹೇಳುವೆನು.<verse eid="PSA 91:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3"/>ನನ್ನನ್ನು ಬೇಟೆಗಾರನ ಬಲೆಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 91:3">ಮರಣಕರ ವ್ಯಾಧಿಯಿಂದಲೂ ತಪ್ಪಿಸುವವನು ಆತನೇ.<verse eid="PSA 91:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4"/>ಆತನು ನನ್ನನ್ನು ತನ್ನ ರೆಕ್ಕೆಗಳಿಂದ ಹೊದಗಿಸುವನು;</para>
  <para style="q" vid="PSA 91:4">ಆತನ ಪಕ್ಕೆಗಳ ಮರೆಯನ್ನು ಆಶ್ರಯಿಸಿಕೊಳ್ಳುವೆ.</para>
  <para style="q" vid="PSA 91:4">ಆತನ ಸತ್ಯತೆಯೇ ನನಗೆ ಖೇಡ್ಯವೂ, ಗುರಾಣಿಯೂ ಆಗಿದೆ.<verse eid="PSA 91:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5"/>ರಾತ್ರಿಯಲ್ಲಿ ಭಯಹುಟ್ಟಿಸುವ ಯಾವುದಕ್ಕೂ,</para>
  <para style="q" vid="PSA 91:5">ಹಗಲಲ್ಲಿ ಹಾರಿಬರುವ ಬಾಣಕ್ಕೂ,<verse eid="PSA 91:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6"/>ಕತ್ತಲೆಯಲ್ಲಿ ಸಂಚರಿಸುವ ವಿಪತ್ತಿಗೂ,</para>
  <para style="q" vid="PSA 91:6">ಹಾನಿಕರವಾದ ಮಧ್ಯಾಹ್ನದ ಕೇಡಿಗೂ ಭಯಪಡಬೇಕಾಗಿಲ್ಲ.<verse eid="PSA 91:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7"/>ನಿನ್ನ ಮಗ್ಗುಲಲ್ಲಿ ಸಾವಿರ ಜನರು,</para>
  <para style="q" vid="PSA 91:7">ನಿನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ಹತ್ತು ಸಾವಿರ ಜನರು ಸತ್ತು ಬಿದ್ದರೂ ನಿನಗೇನೂ ತಟ್ಟದು.<verse eid="PSA 91:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8"/>ನೀನು ಅದನ್ನು ಕಣ್ಣಾರೆ ಕಂಡು,</para>
  <para style="q" vid="PSA 91:8">ದುಷ್ಟರಿಗೆ ಪ್ರತಿದಂಡನೆಯುಂಟು ಎಂಬುದಕ್ಕೆ ಸಾಕ್ಷಿಯಾಗಿರುವಿಯಷ್ಟೆ.<verse eid="PSA 91:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9"/>ಯೆಹೋವನೇ ನನ್ನ ಶರಣನು!</para>
  <para style="q" vid="PSA 91:9">ಅತ್ಯುನ್ನತನಾದ ದೇವರನ್ನು ನಿವಾಸಸ್ಥಾನ ಮಾಡಿಕೊಂಡಿದ್ದಿಯಲ್ಲಾ.<verse eid="PSA 91:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10"/>ಯಾವ ಕೇಡೂ ನಿನಗೆ ಸಂಭವಿಸದು;</para>
  <para style="q" vid="PSA 91:10">ಉಪದ್ರವವು ನಿನ್ನ ಗುಡಾರದ ಸಮೀಪಕ್ಕೂ ಬಾರದು.<verse eid="PSA 91:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11"/>ನೀನು ಹೋಗುವಲ್ಲೆಲ್ಲಾ ನಿನ್ನನ್ನು ಕಾಯುವುದಕ್ಕೆ</para>
  <para style="q" vid="PSA 91:11">ಆತನು ನಿನ್ನ ವಿಷಯವಾಗಿ ತನ್ನ ದೂತರಿಗೆ ಅಪ್ಪಣೆಕೊಡುವನು.<verse eid="PSA 91:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12"/>ನಿನ್ನ ಕಾಲು ಕಲ್ಲಿಗೆ ತಗಲದಂತೆ,</para>
  <para style="q" vid="PSA 91:12">ಅವರು ನಿನ್ನನ್ನು ಕೈಗಳಲ್ಲಿ ಎತ್ತಿಕೊಳ್ಳುವರು.<verse eid="PSA 91:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13"/>ಸಿಂಹ ಮತ್ತು ಸರ್ಪಗಳ ಮೇಲೆ ನಡೆಯುವಿ;</para>
  <para style="q" vid="PSA 91:13">ಪ್ರಾಯದ ಸಿಂಹವನ್ನೂ, ಘಟಸರ್ಪವನ್ನೂ ತುಳಿದುಬಿಡುವಿ.<verse eid="PSA 91:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14"/>ಅವನು ನನ್ನಲ್ಲಿ ಆಸಕ್ತನಾಗಿರುವುದರಿಂದ ಅವನನ್ನು ರಕ್ಷಿಸುವೆನು;</para>
  <para style="q" vid="PSA 91:14">ನನ್ನ ನಾಮವನ್ನು ಅರಿತವನಾಗಿರುವುದರಿಂದ ಅವನನ್ನು ಉದ್ಧರಿಸುವೆನು.<verse eid="PSA 91:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15"/>ಅವನು ನನಗೆ ಮೊರೆಯಿಡುವಾಗ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸುವೆನು;</para>
  <para style="q" vid="PSA 91:15">ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಹತ್ತಿರವಿದ್ದು ಅವನನ್ನು ತಪ್ಪಿಸಿ ಘನಪಡಿಸುವೆನು;<verse eid="PSA 91:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16"/>ದೀರ್ಘಾಯುಷ್ಯವನ್ನು ಅನುಗ್ರಹಿಸಿ, ಅವನನ್ನು ತೃಪ್ತಿಪಡಿಸುವೆನು;</para>
  <para style="q" vid="PSA 91:16">ನನ್ನ ವಿಶೇಷವಾದ ರಕ್ಷಣೆಯನ್ನು ತೋರಿಸುವೆನು.<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s">ದೇವರ ನೀತಿಸಾಧನೆಗಳನ್ನು ಹೊಗಳುವುದು</para>
  <para style="d">ಕೀರ್ತನೆ; ಸಬ್ಬತ್ ದಿನದ ಗೀತೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1"/>ಯೆಹೋವನೇ, ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವುದೂ,</para>
  <para style="q" vid="PSA 92:1">ಪರಾತ್ಪರನಾದ ದೇವರೇ, ನಿನ್ನ ನಾಮವನ್ನು ಸಂಕೀರ್ತಿಸುವುದೂ ಯುಕ್ತವಾಗಿದೆ.<verse eid="PSA 92:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2"/>ವೀಣೆ, ಸ್ವರಮಂಡಲಗಳಿಂದಲೂ, ಕಿನ್ನರಿಯ ಘನಸ್ವರದಿಂದಲೂ,<verse eid="PSA 92:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3"/>ಹೊತ್ತಾರೆಯಲ್ಲಿ ನಿನ್ನ ಪ್ರೇಮವನ್ನೂ,</para>
  <para style="q" vid="PSA 92:3">ರಾತ್ರಿಯಲ್ಲಿ ನಿನ್ನ ಸತ್ಯವನ್ನೂ ವರ್ಣಿಸುವುದು ಉಚಿತವಾಗಿದೆ.<verse eid="PSA 92:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕ್ರಿಯೆಗಳಿಂದ ನನ್ನನ್ನು ಸಂತೋಷಪಡಿಸಿದ್ದಿ;</para>
  <para style="q" vid="PSA 92:4">ನಿನ್ನ ಕೆಲಸಗಳಿಗಾಗಿ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡುತ್ತೇನೆ.<verse eid="PSA 92:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕೃತ್ಯಗಳು ಎಷ್ಟೋ ಶ್ರೇಷ್ಠವಾಗಿವೆ;</para>
  <para style="q" vid="PSA 92:5">ನಿನ್ನ ಆಲೋಚನೆಗಳು ಅಶೋಧ್ಯವಾಗಿವೆ.<verse eid="PSA 92:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6"/>ಪಶುಪ್ರಾಯನು ಅರಿಯನು;</para>
  <para style="q" vid="PSA 92:6">ಮೂರ್ಖನು ಇದನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳನು.<verse eid="PSA 92:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7"/>ದುಷ್ಟರು ಹುಲ್ಲಿನಂತೆ ಬೆಳೆಯುವುದೂ,</para>
  <para style="q" vid="PSA 92:7">ಕೆಡುಕರು ಹೂವಿನಂತೆ ಮೆರೆಯುವುದೂ ತೀರಾ ಹಾಳಾಗುವುದಕ್ಕಾಗಿಯೇ.<verse eid="PSA 92:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8"/>ಯೆಹೋವನೇ, ನೀನಾದರೋ ಸದಾ ಉನ್ನತಸ್ಥಾನದಲ್ಲಿರುತ್ತೀ.<verse eid="PSA 92:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9"/>ಯೆಹೋವನೇ, ಇಗೋ ನಿನ್ನ ಶತ್ರುಗಳು!</para>
  <para style="q" vid="PSA 92:9">ಅವರೆಲ್ಲಾ ನಾಶವಾಗುತ್ತಿದ್ದಾರೆ. ಅಧರ್ಮಿಗಳೆಲ್ಲಾ ಚದರಿಹೋಗುವರು.<verse eid="PSA 92:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10"/>ಆದರೆ ನನ್ನ ಕೊಂಬನ್ನು<note caller="+" style="f"><char style="fr" closed="false">92:10 </char><char style="fq" closed="false">ಕೊಂಬನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಬಲ.</char></note> ಕಾಡುಕೋಣದ ಕೊಂಬಿನಂತೆ<note caller="+" style="f"><char style="fr" closed="false">92:10 </char><char style="fq" closed="false">ಕೊಂಬಿನಂತೆ </char><char style="ft" closed="false">ಅಥವಾ ಬಲ.</char></note> ಎತ್ತಿದ್ದಿ;</para>
  <para style="q" vid="PSA 92:10">
    <note caller="+" style="f">
      <char style="fr" closed="false">92:10 </char>
      <char style="ft" closed="false">ಅಥವಾ ನೀನು ನನ್ನನ್ನು ಸಂತೋಷವುಳ್ಳವನಾಗಿರುವಂತೆ ಆಶೀರ್ವದಿಸಿದ್ದೀ.</char>
    </note>ಚೈತನ್ಯತೈಲದಿಂದ ನನ್ನನ್ನು ಅಭಿಷೇಕಿಸಿದ್ದಿ.<verse eid="PSA 92:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11"/>ನನ್ನ ಶತ್ರುಗಳಿಗುಂಟಾದ ದುರ್ಗತಿಯನ್ನು ಕಣ್ಣಾರೆ ಕಂಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 92:11">ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಎದ್ದವರ ವಿಪತ್ತನ್ನು ಕಿವಿಯಾರೆ ಕೇಳಿದ್ದೇನೆ.<verse eid="PSA 92:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12"/>ನೀತಿವಂತರು ಖರ್ಜೂರದ ಮರದಂತೆ ಬೆಳೆಯುವರು;</para>
  <para style="q" vid="PSA 92:12">ಲೆಬನೋನಿನ ದೇವದಾರು ವೃಕ್ಷದ ಹಾಗೆ ವೃದ್ಧಿಯಾಗುವರು.<verse eid="PSA 92:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13"/>ಯೆಹೋವನ ಆಲಯದಲ್ಲಿ ಸಸಿಗಳಂತೆ ನೆಡಲ್ಪಟ್ಟವರು,</para>
  <para style="q" vid="PSA 92:13">ನಮ್ಮ ದೇವರ ಅಂಗಳದಲ್ಲಿ ಚೆನ್ನಾಗಿ ಬೆಳೆಯುವರು.<verse eid="PSA 92:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14"/>ಮುಪ್ಪಿನಲ್ಲಿಯೂ ಫಲಿಸುವರು;</para>
  <para style="q" vid="PSA 92:14">ಪುಷ್ಟಿಯಾಗಿದ್ದು ಶೋಭಿಸುವರು.<verse eid="PSA 92:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15"/>ಹೀಗೆ ಅವರು ಯೆಹೋವನ ಸತ್ಯಸಂಧತೆಗೆ ದೃಷ್ಟಾಂತರಾಗಿರುವರು.</para>
  <para style="q" vid="PSA 92:15">ಆತನೇ ನನ್ನ ಬಂಡೆಯು; ಆತನು ನಿರ್ವಂಚಕನು.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="s">ಯೆಹೋವನೇ ನಿತ್ಯಕ್ಕೂ ರಾಜಾಧಿರಾಜನು</para>
  <para style="r">
    <ref loc="EXO 15">ವಿಮೋ 15</ref>; <ref loc="ISA 52:7">ಯೆಶಾ 52:7</ref>; <ref loc="PSA 96">ಕೀರ್ತ 96</ref>; <ref loc="PSA 97">97</ref>; <ref loc="PSA 99">99</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1"/>ಯೆಹೋವನು ರಾಜ್ಯಾಧಿಕಾರವನ್ನು ವಹಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 93:1">ಆತನು ಮಹಿಮಾ ವಸ್ತ್ರವನ್ನು ಧರಿಸಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 93:1">ಶೌರ್ಯವನ್ನು ನಡುಕಟ್ಟನ್ನಾಗಿ ಬಿಗಿದಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 93:1">ಹೌದು, ಭೂಲೋಕವು ಸ್ಥಿರವಾಗಿರುವುದು ಅದು ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 93:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2"/>ಅನಾದಿಯಿಂದ ನಿನ್ನ ಸಿಂಹಾಸನವು ಸ್ಥಿರವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 93:2">ಯುಗಯುಗಾಂತರದಿಂದಲೂ ನೀನು ಇರುವಿ.<verse eid="PSA 93:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3"/>ಯೆಹೋವನೇ, ನದಿಗಳು ಮೊರೆದವು, ನದಿಗಳು ಭೋರ್ಗರೆದವು;</para>
  <para style="q" vid="PSA 93:3">ನದಿಗಳು ಘೋಷಿಸುತ್ತವೆ.<verse eid="PSA 93:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4"/>ಜಲರಾಶಿಗಳ ಘೋಷಕ್ಕಿಂತಲೂ, ಮಹಾತರಂಗಗಳ ಗರ್ಜನೆಗಿಂತಲೂ,</para>
  <para style="q" vid="PSA 93:4">ಉನ್ನತದಲ್ಲಿರುವ ಯೆಹೋವನ ಮಹಿಮೆಯು ಗಾಂಭೀರ್ಯವುಳ್ಳದ್ದು.<verse eid="PSA 93:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕಟ್ಟಳೆಗಳು ಬಹುಖಂಡಿತವಾಗಿವೆ;</para>
  <para style="q" vid="PSA 93:5">ಸದಾ ನಿನ್ನ ಮನೆಗೆ ಯೋಗ್ಯವಾದದ್ದು ಪರಿಶುದ್ಧತ್ವವೇ.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="s">ದೇವರ ಶಿಕ್ಷೆ ಮತ್ತು ರಕ್ಷಣೆಗೆ ಒಳಗಾದವನು ಧನ್ಯನು</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1"/>ಯೆಹೋವನೇ, ಮುಯ್ಯಿತೀರಿಸುವ ದೇವರೇ,</para>
  <para style="q" vid="PSA 94:1">ಮುಯ್ಯಿತೀರಿಸುವ ದೇವರೇ, ಕೋಪವನ್ನು ತೋರ್ಪಡಿಸು.<note caller="+" style="f"><char style="fr" closed="false">94:1 </char><char style="fq" closed="false">ಕೋಪವನ್ನು ತೋರ್ಪಡಿಸು. </char><char style="ft" closed="false">ಅಥವಾ ಪ್ರಕಾಶಿಸು. </char></note><verse eid="PSA 94:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2"/>ಲೋಕದ ನ್ಯಾಯಾಧಿಪತಿಯೇ, ಏಳು;</para>
  <para style="q" vid="PSA 94:2">ಗರ್ವಿಷ್ಠರಿಗೆ ತಕ್ಕ ಶಿಕ್ಷೆಯನ್ನು ಕೊಡು.<verse eid="PSA 94:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3"/>ಯೆಹೋವನೇ, ದುಷ್ಟರು ಎಲ್ಲಿಯವರೆಗೆ,</para>
  <para style="q" vid="PSA 94:3">ದುಷ್ಟರು ಎಲ್ಲಿಯವರೆಗೆ ಹಿಗ್ಗುತ್ತಿರಬೇಕು?<verse eid="PSA 94:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4"/>ಕೆಡುಕರೆಲ್ಲರು ಉಬ್ಬಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 94:4">ಅಹಂಕಾರವನ್ನು ಕಕ್ಕುತ್ತಾರೆ.<verse eid="PSA 94:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಪ್ರಜೆಯನ್ನು ಜಜ್ಜಿಹಾಕುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 94:5">ನಿನ್ನ ಸ್ವತ್ತನ್ನು ಕುಗ್ಗಿಸಿಬಿಡುತ್ತಾರೆ;<verse eid="PSA 94:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6"/>ವಿಧವೆಯರನ್ನೂ, ಪರದೇಶಿಯನ್ನೂ ಕೊಲ್ಲುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 94:6">ಅನಾಥರನ್ನು ಹತಮಾಡುತ್ತಾರೆ.<verse eid="PSA 94:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7"/>ಅವರು, “ಯಾಹುವು ನೋಡುವುದೇ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 94:7">ಯಾಕೋಬ್ಯರ ದೇವರು ಲಕ್ಷಿಸುವುದೇ ಇಲ್ಲ” ಅನ್ನುತ್ತಾರೆ.<verse eid="PSA 94:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8"/>ಪಶುಪ್ರಾಯರಾದ ಪ್ರಜೆಗಳಿರಾ, ಲಕ್ಷಿಸಿರಿ;</para>
  <para style="q" vid="PSA 94:8">ಮೂರ್ಖರೇ, ನಿಮಗೆ ಬುದ್ಧಿಬರುವುದು ಯಾವಾಗ?<verse eid="PSA 94:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9"/>ಕಿವಿಮಾಡಿದವನು ಕೇಳನೋ?</para>
  <para style="q" vid="PSA 94:9">ಕಣ್ಣುಕೊಟ್ಟವನು ನೋಡನೋ?<verse eid="PSA 94:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10"/>ಜನಾಂಗಗಳನ್ನು ಶಿಕ್ಷಿಸುವವನೂ,</para>
  <para style="q" vid="PSA 94:10">ಮನುಷ್ಯರಿಗೆ ಬುದ್ಧಿಕಲಿಸುವವನೂ ಗದರಿಸನೋ?<verse eid="PSA 94:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11"/>ಮನುಷ್ಯನ ಯೋಚನೆಗಳು, “ಉಸಿರೇ” ಎಂದು ಯೆಹೋವನು ತಿಳುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PSA 94:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12"/>ಯಾಹುವೇ, ನೀನು ಯಾರನ್ನು ಶಿಕ್ಷಿಸಿ,</para>
  <para style="q" vid="PSA 94:12">ಧರ್ಮೋಪದೇಶಮಾಡುತ್ತೀಯೋ ಅವನೇ ಧನ್ಯನು.<verse eid="PSA 94:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13"/>ಅಂಥವನನ್ನು, ದುಷ್ಟನಿಗೋಸ್ಕರ ಗುಂಡಿಯು ಅಗೆಯಲ್ಪಡುವ ತನಕ,</para>
  <para style="q" vid="PSA 94:13">ಆಪತ್ತಿನಲ್ಲಿಯೂ ನೀನು ಸಂರಕ್ಷಿಸುತ್ತಿ.<verse eid="PSA 94:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14"/>ಯೆಹೋವನು ತನ್ನ ಜನರನ್ನು ಬೇಡವೆಂದು ತಳ್ಳಿಬಿಡುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 94:14">ತನ್ನ ಸ್ವತ್ತನ್ನು ಕೈಬಿಡುವುದಿಲ್ಲ.<verse eid="PSA 94:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15"/>ನ್ಯಾಯತೀರ್ಪು ನೀತಿಗೆ ತಿರುಗಿಕೊಳ್ಳುವುದು;</para>
  <para style="q" vid="PSA 94:15">ಯಥಾರ್ಥಚಿತ್ತರೆಲ್ಲರೂ ಅದನ್ನೇ ಅನುಸರಿಸುವರು.<verse eid="PSA 94:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16"/>ದುಷ್ಟರಿಗೆ ವಿರುದ್ಧವಾಗಿ ನನಗೋಸ್ಕರ ಏಳುವವರು ಯಾರು?</para>
  <para style="q" vid="PSA 94:16">ಕೆಡುಕರಿಗೆ ವಿರುದ್ಧವಾಗಿ ನನಗೋಸ್ಕರ ಎದ್ದು ನಿಲ್ಲುವವರು ಯಾರು?<verse eid="PSA 94:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17"/>ಯೆಹೋವನ ಸಹಾಯವಿಲ್ಲದಿದ್ದರೆ ಇಷ್ಟರಲ್ಲೇ ಸಮಾಧಿ ಸೇರುತ್ತಿದ್ದೆನು.<verse eid="PSA 94:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18"/>ಯೆಹೋವನೇ, ನನ್ನ ಕಾಲು ಜಾರಿತೆಂದು ಅಂದುಕೊಂಡಾಗಲೇ,</para>
  <para style="q" vid="PSA 94:18">ನಿನ್ನ ಕೃಪೆಯು ನನಗೆ ಆಧಾರವಾಯಿತು.<verse eid="PSA 94:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19"/>ನನ್ನಲ್ಲಿ ಅನೇಕ ಚಿಂತೆಗಳಿರುವಾಗ ನಿನ್ನ ಸಂತೈಸುವಿಕೆಯಿಂದಲೇ,</para>
  <para style="q" vid="PSA 94:19">ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಸಂತೋಷವುಂಟಾಗುತ್ತದೆ.<verse eid="PSA 94:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20"/>ಧರ್ಮಶಾಸ್ತ್ರದ ನೆಪದಿಂದ ಕೇಡುಕಲ್ಪಿಸುವ ದುಷ್ಟ ಅಧಿಪತಿಗಳಿಗೂ,</para>
  <para style="q" vid="PSA 94:20">ನಿನಗೂ ಸಂಬಂಧವೇನು?<verse eid="PSA 94:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21"/>ಜೀವವನ್ನು ತೆಗೆಯಬೇಕೆಂದು ನೀತಿವಂತರ ಮೇಲೆ ಬೀಳುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 94:21">ನಿರಪರಾಧಿಗಳಿಗೆ ಮರಣಶಿಕ್ಷೆ ವಿಧಿಸುತ್ತಾರೆ.<verse eid="PSA 94:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22"/>ಆದರೆ ಯೆಹೋವನು ನನ್ನ ದುರ್ಗವೂ,</para>
  <para style="q" vid="PSA 94:22">ನನ್ನ ದೇವರು ಆಶ್ರಯಗಿರಿಯೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 94:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23"/>ಅವರ ಕೆಟ್ಟತನವನ್ನು ಅವರಿಗೇ ತಿರುಗಿಸುವನು;</para>
  <para style="q" vid="PSA 94:23">ಅವರ ದುಷ್ಟತನದಿಂದಲೇ ಅವರನ್ನು ನಿರ್ಮೂಲಮಾಡುವನು.</para>
  <para style="q" vid="PSA 94:23">ನಮ್ಮ ಯೆಹೋವ ದೇವರು ಅವರನ್ನು ಸಂಹರಿಸಿಬಿಡುವನು.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="s">ದೇವರನ್ನು ವಿಶ್ವಾಸದಿಂದ ಆರಾಧಿಸುವುದು</para>
  <para style="r">
    <ref loc="PSA 81">ಕೀರ್ತ 81</ref>; <ref loc="PSA 96:-1-100">96-100</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1"/>ಬನ್ನಿರಿ, ಯೆಹೋವನಿಗೆ ಉತ್ಸಾಹದಿಂದ ಹಾಡೋಣ;</para>
  <para style="q" vid="PSA 95:1">ನಮ್ಮ ರಕ್ಷಕನಾದ ಶರಣನಿಗೆ ಜಯಘೋಷ ಮಾಡೋಣ.<verse eid="PSA 95:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2"/>ಕೃತಜ್ಞತಾಸ್ತುತಿಯೊಡನೆ ಆತನ ಸನ್ನಿಧಿಗೆ ಸೇರೋಣ;</para>
  <para style="q" vid="PSA 95:2">ಕೀರ್ತನೆಗಳಿಂದ ಆತನಿಗೆ ಜಯಘೋಷ ಮಾಡೋಣ.<verse eid="PSA 95:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3"/>ಯೆಹೋವನು ಮಹಾದೇವರೂ,</para>
  <para style="q" vid="PSA 95:3">ಎಲ್ಲಾ ದೇವರುಗಳಲ್ಲಿ ಮಹಾರಾಜನೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 95:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4"/>ಭೂಮಿಯ ಅಗಾಧವು ಆತನ ಕೈಯಲ್ಲಿರುತ್ತದೆ;</para>
  <para style="q" vid="PSA 95:4">ಪರ್ವತಶಿಖರಗಳು ಆತನವೇ.<verse eid="PSA 95:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5"/>ಆತನೇ ಸಮುದ್ರವನ್ನು ನಿರ್ಮಿಸಿದವನು;</para>
  <para style="q" vid="PSA 95:5">ಅದು ಆತನದೇ, ಒಣನೆಲವು ಆತನ ಕೈಕೆಲಸವೇ.<verse eid="PSA 95:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6"/>ಬನ್ನಿರಿ; ನಮ್ಮ ನಿರ್ಮಾಣಿಕನಾದ ಯೆಹೋವನಿಗೆ</para>
  <para style="q" vid="PSA 95:6">ಸಾಷ್ಟಾಂಗವೆರಗಿ ಆರಾಧಿಸೋಣ.<verse eid="PSA 95:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7"/>ಆತನು ನಮ್ಮ ದೇವರು;</para>
  <para style="q" vid="PSA 95:7">ನಾವೋ ಆತನು ಪಾಲಿಸುವ ಪ್ರಜೆಯೂ,</para>
  <para style="q" vid="PSA 95:7">ಆತನ ಕೈಕೆಳಗಿರುವ ಹಿಂಡೂ ಆಗಿದ್ದೇವೆ.</para>
  <para style="q" vid="PSA 95:7">ನೀವು ಈ ಹೊತ್ತು ಆತನ ಶಬ್ದಕ್ಕೆ ಕಿವಿಗೊಟ್ಟರೆ ಎಷ್ಟೋ ಒಳ್ಳೇಯದು.<verse eid="PSA 95:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8"/>ನಿಮ್ಮ ಹಿರಿಯರು ಅರಣ್ಯದಲ್ಲಿರುವ ಮೆರೀಬದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">ಮೆರೀಬ </char><char style="ft" closed="false">ಅಂದರೆ ವಾಗ್ವಾದ.</char></note>,</para>
  <para style="q" vid="PSA 95:8">ಮಸ್ಸಾದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">ಮಸ್ಸಾದಲ್ಲಿ </char><char style="ft" closed="false">ಅಂದರೆ ಪರೀಕ್ಷೆ, ವಿಮೋ 17:1-17, ಅರಣ್ಯ 20:1-13, ಧರ್ಮೋ 6:16, 33:8.</char></note> ಮಾಡಿದ ದಿನದಂತೆ,</para>
  <para style="q" vid="PSA 95:8">ನೀವು ನಿಮ್ಮ ಹೃದಯವನ್ನು ಕಠಿಣಮಾಡಿಕೊಳ್ಳಬೇಡಿರಿ.<verse eid="PSA 95:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9"/>ಅಲ್ಲಿ ಅವರು ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿದರು;</para>
  <para style="q" vid="PSA 95:9">ನನ್ನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನೋಡಿದರೂ ನನ್ನನ್ನು ಪರಿಶೋಧಿಸಿದರು.<verse eid="PSA 95:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10"/>ನಾನು ನಲ್ವತ್ತು ವರ್ಷ ಆ ಸಂತತಿಯವರ ವಿಷಯದಲ್ಲಿ ಬೇಸರಗೊಂಡೆನು;</para>
  <para style="q" vid="PSA 95:10">“ಈ ಜನರು ಹೃದಯದಲ್ಲಿ ತಪ್ಪಿಹೋಗುವವರು,</para>
  <para style="q" vid="PSA 95:10">ನನ್ನ ಆಜ್ಞೆಗಳಿಗೆ ವಿಧೇಯರಾಗದವರು<note caller="+" style="f"><char style="fr" closed="false">95:10 </char><char style="fq" closed="false">ನನ್ನ ಆಜ್ಞೆಗಳಿಗೆ ವಿಧೇಯರಾಗದವರು </char><char style="ft" closed="false">ಅಥವಾ ನನ್ನ ಮಾರ್ಗವನ್ನು ತಿಳಿಯದವರು.</char></note>” ಎಂದು ಹೇಳಿದೆನು.<verse eid="PSA 95:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11"/>ಆದುದರಿಂದ ಇವರು, “ನನ್ನ ವಿಶ್ರಾಂತಿಯಲ್ಲಿ ಸೇರಬಾರದು” ಎಂದು</para>
  <para style="q" vid="PSA 95:11">ಕೋಪಗೊಂಡು ಪ್ರಮಾಣಮಾಡಿದೆನು.<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="s">ರಾಜಾಧಿರಾಜನಾದ ಯೆಹೋವನ ಆಗಮನ</para>
  <para style="r">
    <ref loc="1CH 16:23-33">1ಪೂರ್ವ 16:23-33</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1"/>ಯೆಹೋವನಿಗೆ ಹೊಸ ಕೀರ್ತನೆಯನ್ನು ಹಾಡಿರಿ;</para>
  <para style="q" vid="PSA 96:1">ಎಲ್ಲಾ ಭೂನಿವಾಸಿಗಳೇ, ಯೆಹೋವನಿಗೆ ಹಾಡಿರಿ.<verse eid="PSA 96:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2"/>ಯೆಹೋವನಿಗೆ ಹಾಡಿರಿ; ಆತನ ನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ.</para>
  <para style="q" vid="PSA 96:2">ಆತನ ರಕ್ಷಣೆಯನ್ನು ಪ್ರತಿನಿತ್ಯವೂ ಸಾರಿ ಹೇಳಿರಿ.<verse eid="PSA 96:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3"/>ಜನಾಂಗಗಳಲ್ಲಿ ಆತನ ಘನತೆಯನ್ನೂ,</para>
  <para style="q" vid="PSA 96:3">ಎಲ್ಲಾ ಜನರಲ್ಲಿ ಆತನ ಅದ್ಭುತಕೃತ್ಯಗಳನ್ನೂ ಪ್ರಸಿದ್ಧಪಡಿಸಿರಿ.<verse eid="PSA 96:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4"/>ಯೆಹೋವನು ದೊಡ್ಡವನೂ, ಬಹು ಸ್ತುತ್ಯನೂ ಆಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 96:4">ಎಲ್ಲಾ ದೇವರುಗಳಲ್ಲಿ ಆತನೇ ಮಹಾದೇವರು.<verse eid="PSA 96:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5"/>ಜನಾಂಗಗಳ ದೇವತೆಗಳೆಲ್ಲಾ ಬೊಂಬೆಗಳೇ;</para>
  <para style="q" vid="PSA 96:5">ಯೆಹೋವನಾದರೋ ಗಗನಮಂಡಲವನ್ನು ನಿರ್ಮಿಸಿದನು.<verse eid="PSA 96:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6"/>ಆತನ ಸಾನ್ನಿಧ್ಯದಲ್ಲಿ ಘನತೆ ಮತ್ತು ಮಹಿಮೆಗಳೂ,</para>
  <para style="q" vid="PSA 96:6">ಆತನ ಪವಿತ್ರಾಲಯದಲ್ಲಿ ಬಲ ಮತ್ತು ಸೌಂದರ್ಯಗಳೂ ಇರುತ್ತವೆ.<verse eid="PSA 96:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7"/>ಭೂಜನಾಂಗಗಳೇ, ಬಲಪ್ರಭಾವಗಳು ಯೆಹೋವನವೇ, ಯೆಹೋವನವೇ,</para>
  <para style="q" vid="PSA 96:7">ಎಂದು ಹೇಳಿ ಆತನನ್ನು ಘನಪಡಿಸಿರಿ.<verse eid="PSA 96:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8"/>ಯೆಹೋವನ ನಾಮಕ್ಕೆ ಯೋಗ್ಯವಾದ ಘನವನ್ನು ಸಲ್ಲಿಸಿರಿ;</para>
  <para style="q" vid="PSA 96:8">ಕಾಣಿಕೆಯೊಡನೆ ಆತನ ಅಂಗಳಗಳಿಗೆ ಬನ್ನಿರಿ.<verse eid="PSA 96:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9"/>ಪರಿಶುದ್ಧತ್ವವೆಂಬ ಭೂಷಣದೊಡನೆ ಯೆಹೋವನಿಗೆ ನಮಸ್ಕರಿಸಿರಿ;</para>
  <para style="q" vid="PSA 96:9">ಎಲ್ಲಾ ಭೂನಿವಾಸಿಗಳೇ, ಆತನ ಮುಂದೆ ಭಯಭಕ್ತಿಯಿಂದಿರಿ.<verse eid="PSA 96:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10"/>ಯೆಹೋವನು ರಾಜ್ಯಾಧಿಕಾರವನ್ನು ವಹಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 96:10">ಭೂಮಿಯು ಸ್ಥಿರವಾಗಿರುವುದು, ಕದಲುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 96:10">ಸರ್ವರಿಗೂ ನ್ಯಾಯಾನುಸಾರವಾಗಿ ತೀರ್ಪುಕೊಡುವನೆಂದು</para>
  <para style="q" vid="PSA 96:10">ಜನಾಂಗಗಳಲ್ಲಿ ಪ್ರಸಿದ್ಧಪಡಿಸಿರಿ.<verse eid="PSA 96:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11"/>ಯೆಹೋವನ ಮುಂದೆ ಗಗನಮಂಡಲವು ಹರ್ಷಿಸಲಿ;</para>
  <para style="q" vid="PSA 96:11">ಭೂಲೋಕವು ಸಂತೋಷಿಸಲಿ;</para>
  <para style="q" vid="PSA 96:11">ಸಮುದ್ರವೂ, ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ ಘೋಷಿಸಲಿ.<verse eid="PSA 96:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12"/>ಹೊಲಗಳೂ, ಅವುಗಳ ಪೈರುಗಳೂ ಉಲ್ಲಾಸಿಸಲಿ;</para>
  <para style="q" vid="PSA 96:12">ವನದ ಎಲ್ಲಾ ಮರಗಳು ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಲಿ.<verse eid="PSA 96:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13"/>ಆತನು ಬರುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 96:13">ಭೂನಿವಾಸಿಗಳಿಗೆ ನ್ಯಾಯತೀರಿಸಲಿಕ್ಕೆ ಬರುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 96:13">ಆತನು ಲೋಕಕ್ಕೆ ನೀತಿಗನುಸಾರವಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 96:13">ಜನಾಂಗಗಳಿಗೆ ಸತ್ಯತೆಯಿಂದಲೂ ನ್ಯಾಯತೀರಿಸುವನು.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="s">ಸಾರ್ವಭೌಮನಾದ ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸುವುದು</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1"/>ಯೆಹೋವನು ರಾಜ್ಯಾಧಿಕಾರವನ್ನು ವಹಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 97:1">ಭೂಲೋಕವು ಸಂತೋಷಿಸಲಿ;</para>
  <para style="q" vid="PSA 97:1">ಸಮುದ್ರದ ತೀರಪ್ರದೇಶಗಳೆಲ್ಲಾ ಹರ್ಷಿಸಲಿ.<verse eid="PSA 97:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2"/>ಮೋಡಗಳೂ, ಕಾರ್ಗತ್ತಲೆಯೂ ಆತನ ಸುತ್ತಲೂ ಇರುತ್ತವೆ;</para>
  <para style="q" vid="PSA 97:2">ಯೆಹೋವನು ನೀತಿ ಮತ್ತು ನ್ಯಾಯಗಳಿಂದ ಆಳುತ್ತಾನೆ<note caller="+" style="f"><char style="fr" closed="false">97:2 </char><char style="fq" closed="false">ಯೆಹೋವನು ನೀತಿ ಮತ್ತು ನ್ಯಾಯಗಳಿಂದ ಆಳುತ್ತಾನೆ </char><char style="ft" closed="false">ಮೂಲತಃ ನೀತಿ ಮತ್ತು ನ್ಯಾಯಗಳು ಆತನ ಸಿಂಹಾಸನದ ಅಸ್ತಿವಾರ.</char></note>.<verse eid="PSA 97:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3"/>ಬೆಂಕಿಯು ಆತನ ಮುಂದೆ ಹೋಗಿ,</para>
  <para style="q" vid="PSA 97:3">ಸುತ್ತಲೂ ಆವರಿಸಿ ಆತನ ವೈರಿಗಳನ್ನು ದಹಿಸಿಬಿಡುತ್ತದೆ.<verse eid="PSA 97:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4"/>ಆತನ ಮಿಂಚುಗಳು ಲೋಕವನ್ನು ಬೆಳಗಿಸಿದವು;</para>
  <para style="q" vid="PSA 97:4">ಭೂಮಿಯು ಅದನ್ನು ಕಂಡು ನಡುಗಿತು.<verse eid="PSA 97:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5"/>ಸಾರ್ವಭೌಮನಾದ ಯೆಹೋವನ ಎದುರಿನಲ್ಲಿ</para>
  <para style="q" vid="PSA 97:5">ಪರ್ವತಗಳು ಮೇಣದಂತೆ ಕರಗಿಹೋದವು.<verse eid="PSA 97:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6"/>ಗಗನಮಂಡಲವು ಆತನ ನೀತಿಯನ್ನು ಪ್ರಸಿದ್ಧಪಡಿಸಿತು;</para>
  <para style="q" vid="PSA 97:6">ಎಲ್ಲಾ ಜನರು ಆತನ ಮಹಿಮೆಯನ್ನು ಕಂಡರು.<verse eid="PSA 97:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7"/>ವಿಗ್ರಹಗಳಲ್ಲಿ ಹಿಗ್ಗುವವರೂ,</para>
  <para style="q" vid="PSA 97:7">ಮೂರ್ತಿಪೂಜಕರೆಲ್ಲರೂ ನಾಚಿಕೆಗೆ ಒಳಪಡುವರು;</para>
  <para style="q" vid="PSA 97:7">
    <note caller="+" style="f">
      <char style="fr" closed="false">97:7 </char>
      <char style="ft" closed="false">ಅಥವಾ ದೇವರುಗಳೆಂದು ಕರೆಯಲ್ಪಡುವವರೇ, ನೀವೆಲ್ಲರೂ ಆತನಿಗೆ ಅಡ್ಡಬೀಳುತ್ತಾರೆ.</char>
    </note>ದೇವರುಗಳೆಂದು ಕರೆಯಲ್ಪಡುವವರೇ, ನೀವೆಲ್ಲರೂ ಆತನಿಗೆ ಅಡ್ಡಬೀಳಿರಿ.<verse eid="PSA 97:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8"/>ಯೆಹೋವನೇ, ನೀನು ನ್ಯಾಯಸ್ಥಾಪಿಸಿದ ವಾರ್ತೆಯನ್ನು ಕೇಳಿ</para>
  <para style="q" vid="PSA 97:8">ಚೀಯೋನ್ ಪಟ್ಟಣವು ಹರ್ಷಿಸಿತು;</para>
  <para style="q" vid="PSA 97:8">ಯೆಹೂದ ಪ್ರಾಂತ್ಯದ ಊರುಗಳು ಸಂತೋಷಿಸಿದವು.<verse eid="PSA 97:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9"/>ಯೆಹೋವನೇ, ನೀನು ಭೂಲೋಕದ ಸರ್ವಾಧಿಕಾರಿ;</para>
  <para style="q" vid="PSA 97:9">ಎಲ್ಲಾ ದೇವರುಗಳಲ್ಲಿ ಮಹೋನ್ನತನು ನೀನೇ.<verse eid="PSA 97:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">97:10 </char>
      <char style="ft" closed="false">ಅಥವಾ ಯೆಹೋವನನ್ನು ಪ್ರೀತಿಸುವವರೇ, ಕೆಟ್ಟತನವನ್ನು ಹಗೆಮಾಡಿರಿ.</char>
    </note>ಕೆಟ್ಟತನವನ್ನು ಹಗೆಮಾಡುವವರನ್ನು, ಯೆಹೋವನನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 97:10">ಆತನು ತನ್ನ ಭಕ್ತರ ಪ್ರಾಣಗಳನ್ನು ಕಾಯುವವನಾಗಿ,</para>
  <para style="q" vid="PSA 97:10">ದುಷ್ಟರ ಕೈಯೊಳಗಿಂದ ಅವರನ್ನು ಬಿಡಿಸುವನು.<verse eid="PSA 97:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11"/>ನೀತಿವಂತರಿಗೋಸ್ಕರ ಬೆಳಕು ಪ್ರಕಾಶಿಸುವುದು<note caller="+" style="f"><char style="fr" closed="false">97:11 </char><char style="fq" closed="false">ಪ್ರಕಾಶಿಸುವುದು </char><char style="ft" closed="false">ಅಥವಾ ಬಿತ್ತಲ್ಪಟ್ಟಿದೆ.</char></note>,</para>
  <para style="q" vid="PSA 97:11">ಯಥಾರ್ಥಹೃದಯವುಳ್ಳವರಿಗೆ ಸಂತೋಷವೂ ಕೊಡಲ್ಪಟ್ಟಿವೆ.<verse eid="PSA 97:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12"/>ನೀತಿವಂತರೇ, ಯೆಹೋವನಲ್ಲಿ ಆನಂದಿಸಿರಿ;</para>
  <para style="q" vid="PSA 97:12">ಆತನ ಪರಿಶುದ್ಧನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ.<note caller="+" style="f"><char style="fr" closed="false">97:12 </char><char style="fq" closed="false">ಆತನ ಪರಿಶುದ್ಧನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ. </char><char style="ft" closed="false">ಅಥವಾ ಆತನ ಪರಿಶುದ್ಧ ಸ್ಮರಣೆಗಾಗಿ ಕೊಂಡಾಡಿರಿ.</char></note><verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s">ಯೆಹೋವರಾಜನ ರಕ್ಷಣೆಯನ್ನು ಕೊಂಡಾಡುವುದು</para>
  <para style="r">
    <ref loc="PSA 67">ಕೀರ್ತ 67</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1"/>ಯೆಹೋವನಿಗೆ ಹೊಸ ಕೀರ್ತನೆಯನ್ನು ಹಾಡಿರಿ;</para>
  <para style="q" vid="PSA 98:1">ಆತನು ಅದ್ಭುತಕೃತ್ಯಗಳನ್ನು ನಡೆಸಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 98:1">ಆತನ ಬಲಗೈಯೂ, ಪರಿಶುದ್ಧಬಾಹುವೂ ಜಯವನ್ನು ಉಂಟುಮಾಡಿವೆ.<verse eid="PSA 98:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2"/>ಯೆಹೋವನು ತನ್ನ ರಕ್ಷಣೆಯನ್ನು ಪ್ರಕಟಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 98:2">ಜನಾಂಗಗಳೆದುರಿಗೆ ತನ್ನ ನೀತಿಯನ್ನು ತೋರ್ಪಡಿಸಿದ್ದಾನೆ.<verse eid="PSA 98:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3"/>ಆತನು ಇಸ್ರಾಯೇಲನ ಮನೆತನದವರ ಬಗ್ಗೆ ಇದ್ದ,</para>
  <para style="q" vid="PSA 98:3">ತನ್ನ ಪ್ರೀತಿ, ಸತ್ಯತೆಗಳನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 98:3">ಭೂಲೋಕದ ಎಲ್ಲಾ ಕಡೆಯವರೂ,</para>
  <para style="q" vid="PSA 98:3">ನಮ್ಮ ದೇವರ ರಕ್ಷಣಾಕಾರ್ಯವನ್ನು ನೋಡಿದ್ದಾರೆ.<verse eid="PSA 98:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4"/>ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ,</para>
  <para style="q" vid="PSA 98:4">ಯೆಹೋವನಿಗೆ ಜಯಘೋಷಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 98:4">ಹರ್ಷಿಸಿರಿ, ಉತ್ಸಾಹಧ್ವನಿಮಾಡಿ ಹಾಡಿರಿ.<verse eid="PSA 98:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5"/>ಕಿನ್ನರಿಯೊಡನೆ ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 98:5">ಕಿನ್ನರಿಯನ್ನು ನುಡಿಸುತ್ತಾ ಭಜಿಸಿರಿ.<verse eid="PSA 98:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6"/>ತುತ್ತೂರಿಗಳನ್ನೂ, ಕೊಂಬನ್ನೂ ಊದುತ್ತಾ,</para>
  <para style="q" vid="PSA 98:6">ಯೆಹೋವರಾಜನಿಗೆ ಜಯಘೋಷಮಾಡಿರಿ.<verse eid="PSA 98:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7"/>ಯೆಹೋವನ ಮುಂದೆ ಸಮುದ್ರವೂ, ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ,</para>
  <para style="q" vid="PSA 98:7">ಭೂಮಿಯೂ, ಅದರ ನಿವಾಸಿಗಳೂ ಘೋಷಿಸಲಿ.<verse eid="PSA 98:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8"/>ನದಿಗಳು ಚಪ್ಪಾಳೆ ಹೊಡೆಯಲಿ;</para>
  <para style="q" vid="PSA 98:8">ಪರ್ವತಗಳೆಲ್ಲಾ ಉತ್ಸಾಹಧ್ವನಿಮಾಡಲಿ.<verse eid="PSA 98:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9"/>ಆತನು ಭೂನಿವಾಸಿಗಳಿಗೆ ನ್ಯಾಯತೀರಿಸಲಿಕ್ಕೆ ಬರುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 98:9">ಆತನು ಲೋಕಕ್ಕೆ ನೀತಿಗನುಸಾರವಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 98:9">ಜನಾಂಗಗಳಿಗೆ ಯಥಾರ್ಥವಾಗಿಯೂ ತೀರ್ಪುಕೊಡುವನು.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="s">ಯೆಹೋವರಾಜನ ಪವಿತ್ರತೆಯನ್ನು ಕೊಂಡಾಡುವುದು</para>
  <para style="r">
    <ref loc="ISA 6">ಯೆಶಾ 6</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1"/>ಯೆಹೋವನು ರಾಜ್ಯಾಧಿಕಾರವನ್ನು ವಹಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 99:1">ಜನಾಂಗಗಳು ನಡುಗಲಿ.</para>
  <para style="q" vid="PSA 99:1">ಕೆರೂಬಿಯರ ಮಧ್ಯದಲ್ಲಿ ಆಸೀನನಾಗಿರುವಾತನು ಆಳುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 99:1">ಭೂಮಿಯು ಕಂಪಿಸಲಿ.<verse eid="PSA 99:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2"/>ಚೀಯೋನಿನಲ್ಲಿರುವ ಯೆಹೋವನು ದೊಡ್ಡವನು;</para>
  <para style="q" vid="PSA 99:2">ಆತನು ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಮಹೋನ್ನತನು.<verse eid="PSA 99:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3"/>ಅವರು ಯೆಹೋವನ ಭಯಂಕರವಾದ ಮಹಾನಾಮವನ್ನು ಕೊಂಡಾಡಲಿ;</para>
  <para style="q" vid="PSA 99:3">ಆತನು ಪರಿಶುದ್ಧನು.<verse eid="PSA 99:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4"/>ಪರಾಕ್ರಮಿಯಾದ ಅರಸನು ನೀತಿಯನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ<note caller="+" style="f"><char style="fr" closed="false">99:4 </char><char style="fq" closed="false">ಪರಾಕ್ರಮಿಯಾದ ಅರಸನು ನೀತಿಯನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ </char><char style="ft" closed="false">ಅಥವಾ ಅರಸನಾದ ಯೆಹೋವನು, ಪರಾಕ್ರಮಿಯಾಗಿದ್ದು ನೀತಿಯನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ. </char></note>;</para>
  <para style="q" vid="PSA 99:4">ಯಥಾರ್ಥವಾದದ್ದನ್ನು ಸ್ಥಾಪಿಸಿದವನೂ,</para>
  <para style="q" vid="PSA 99:4">ಯಾಕೋಬ್ಯರಲ್ಲಿ ನ್ಯಾಯ, ನೀತಿಗಳನ್ನು ಸಿದ್ಧಿಗೆ ತಂದವನೂ ನೀನೇ.<verse eid="PSA 99:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5"/>ನಮ್ಮ ಯೆಹೋವ ದೇವರನ್ನು ಘನಪಡಿಸಿರಿ;</para>
  <para style="q" vid="PSA 99:5">ಆತನ ಪಾದಪೀಠದ ಮುಂದೆ ಅಡ್ಡಬೀಳಿರಿ.</para>
  <para style="q" vid="PSA 99:5">ಆತನು ಪರಿಶುದ್ಧನು.<verse eid="PSA 99:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6"/>ಆತನ ಯಾಜಕರಲ್ಲಿ ಮೋಶೆ ಮತ್ತು ಆರೋನರೂ,</para>
  <para style="q" vid="PSA 99:6">ಆತನ ಹೆಸರಿನಲ್ಲಿ ಪ್ರಾರ್ಥಿಸುವವರೊಳಗೆ ಸಮುವೇಲನೂ ಪ್ರಾರ್ಥಿಸಿದಾಗೆಲ್ಲ,</para>
  <para style="q" vid="PSA 99:6">ಯೆಹೋವನು ಅವರಿಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸುತ್ತಿದ್ದನು.<verse eid="PSA 99:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7"/>ಆತನು ಮೇಘಸ್ತಂಭದಲ್ಲಿದ್ದು ಅವರೊಡನೆ ಮಾತನಾಡುತ್ತಿದ್ದನು;</para>
  <para style="q" vid="PSA 99:7">ಅವರು ಆತನ ವಿಧಿನಿಯಮಗಳನ್ನು ಕೈಕೊಂಡವರು.<verse eid="PSA 99:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8"/>ನಮ್ಮ ಯೆಹೋವ ದೇವರೇ, ಅವರಿಗೆ ಸದುತ್ತರ ಕೊಟ್ಟವನು ನೀನೇ.</para>
  <para style="q" vid="PSA 99:8">ನೀನು ದುಷ್ಕೃತ್ಯಗಳಿಗಾಗಿ ಅವರನ್ನು ದಂಡಿಸುತ್ತಿದ್ದರೂ,</para>
  <para style="q" vid="PSA 99:8">ಕ್ಷಮಿಸುವ ದೇವರಾಗಿದ್ದಿ.<verse eid="PSA 99:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9"/>ನಮ್ಮ ಯೆಹೋವ ದೇವರನ್ನು ಘನಪಡಿಸಿರಿ;</para>
  <para style="q" vid="PSA 99:9">ಆತನ ಪರಿಶುದ್ಧಪರ್ವತದ ಕಡೆಗೆ ಅಡ್ಡಬೀಳಿರಿ.</para>
  <para style="q" vid="PSA 99:9">ನಮ್ಮ ಯೆಹೋವ ದೇವರು ಪರಿಶುದ್ಧನು.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s">ಲೋಕವೆಲ್ಲಾ ಇಸ್ರಾಯೇಲರ ದೇವರನ್ನು ಆರಾಧಿಸಬೇಕೆಂಬ ಬೋಧನೆ</para>
  <para style="d">ಕೃತಜ್ಞತಾಯಜ್ಞ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 95">ಕೀರ್ತ 95</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1"/>ಸಮಸ್ತಭೂನಿವಾಸಿಗಳೇ, ಯೆಹೋವನಿಗೆ ಉತ್ಸಾಹಧ್ವನಿಮಾಡಿರಿ.<verse eid="PSA 100:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2"/>ಯೆಹೋವನನ್ನು ಸಂತೋಷದಿಂದ ಸೇವಿಸಿರಿ;</para>
  <para style="q" vid="PSA 100:2">ಕೀರ್ತನೆ ಹಾಡುತ್ತಾ ಆತನ ಸನ್ನಿಧಿಗೆ ಬನ್ನಿರಿ.<verse eid="PSA 100:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3"/>ಯೆಹೋವನೇ ದೇವರೆಂದು ತಿಳಿದುಕೊಳ್ಳಿರಿ.</para>
  <para style="q" vid="PSA 100:3">ನಮ್ಮನ್ನು ಉಂಟುಮಾಡಿದವನು ಆತನೇ;</para>
  <para style="q" vid="PSA 100:3">ನಾವು ಆತನವರು, ಆತನ ಪ್ರಜೆಯೂ,</para>
  <para style="q" vid="PSA 100:3">ಆತನು ಪಾಲಿಸುವ ಹಿಂಡೂ ಆಗಿದ್ದೇವೆ.<verse eid="PSA 100:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4"/>ಕೃತಜ್ಞತಾ ಸ್ತುತಿಯೊಡನೆ ಆತನ ಮಂದಿರದ್ವಾರಗಳಿಗೂ,</para>
  <para style="q" vid="PSA 100:4">ಸ್ತುತಿಸ್ತೋತ್ರದೊಡನೆ ಆತನ ಅಂಗಳಗಳಿಗೂ ಬನ್ನಿರಿ;</para>
  <para style="q" vid="PSA 100:4">ಆತನ ಉಪಕಾರಗಳನ್ನು ಸ್ಮರಿಸಿರಿ;</para>
  <para style="q" vid="PSA 100:4">ಆತನ ನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 100:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5"/>ಯೆಹೋವನು ಒಳ್ಳೆಯವನು;</para>
  <para style="q" vid="PSA 100:5">ಆತನ ಕೃಪೆಯು ಯುಗಯುಗಕ್ಕೂ,</para>
  <para style="q" vid="PSA 100:5">ಆತನ ಸತ್ಯತೆಯು ತಲತಲಾಂತರಕ್ಕೂ ಇರುವವು.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s">ರಾಜಶ್ರೇಷ್ಠನ ಪ್ರತಿಜ್ಞೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 15">ಕೀರ್ತ 15</ref>; <ref loc="PSA 24">24</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1"/>ಪ್ರೀತಿ, ನೀತಿಗಳನ್ನು ಕುರಿತು ಹಾಡುವೆನು;</para>
  <para style="q" vid="PSA 101:1">ಯೆಹೋವನೇ, ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 101:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2"/>ಸನ್ಮಾರ್ಗವನ್ನು ಲಕ್ಷಿಸಿ ನಡೆಯುವೆನು;</para>
  <para style="q" vid="PSA 101:2">ನನಗೆ ಯಾವಾಗ ದರ್ಶನಕೊಡುವಿ?</para>
  <para style="q" vid="PSA 101:2">ಮನೆಯೊಳಗೂ ಯಥಾರ್ಥ ಹೃದಯದಿಂದಲೇ ನಡೆದುಕೊಳ್ಳುವೆನು.<verse eid="PSA 101:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3"/>ಯಾವ ನೀಚವಾದ ಕಾರ್ಯವನ್ನೂ ದೃಷ್ಟಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 101:3">ದುರಾಚಾರವನ್ನು ಹಗೆಮಾಡುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 101:3">ಅದರ ಗೊಡವೆಯೇ ನನಗೆ ಬೇಡ.<verse eid="PSA 101:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4"/>ಮೂರ್ಖತನವು ನನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗಲಿ;</para>
  <para style="q" vid="PSA 101:4">ಕೆಟ್ಟತನವನ್ನು ಅರಿಯದಿರುವೆನು.<verse eid="PSA 101:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5"/>ಗುಪ್ತದಲ್ಲಿ ನೆರೆಯವನ ಮೇಲೆ ಚಾಡಿ ಹೇಳುವವನನ್ನು ಸಂಹರಿಸುವೆನು;</para>
  <para style="q" vid="PSA 101:5">ಸೊಕ್ಕಿನ ಕಣ್ಣೂ, ಉಬ್ಬಿದ ಮನಸ್ಸೂ ಉಳ್ಳವನನ್ನು ಸಹಿಸುವುದಿಲ್ಲ.<verse eid="PSA 101:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6"/>ದೇಶದಲ್ಲಿರುವ ನಂಬಿಗಸ್ತರನ್ನು ಆರಿಸಿಕೊಳ್ಳುವೆನು;</para>
  <para style="q" vid="PSA 101:6">ಅವರೇ ನನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ವಾಸಿಸಬೇಕು,</para>
  <para style="q" vid="PSA 101:6">ಸನ್ಮಾರ್ಗಿಯೇ ನನ್ನ ಸೇವೆಯಲ್ಲಿರಬೇಕು.<verse eid="PSA 101:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7"/>ಮೋಸಗಾರನು ನನ್ನ ಮನೆಯಲ್ಲಿ ಇರಲೇಬಾರದು;</para>
  <para style="q" vid="PSA 101:7">ಸುಳ್ಳುಗಾರನು ನನ್ನ ಮುಂದೆ ನಿಲ್ಲಕೂಡದು.<verse eid="PSA 101:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8"/>ಯೆಹೋವನ ಪಟ್ಟಣದಲ್ಲಿ ಕೆಡುಕರೇ ಉಳಿಯದಂತೆ,</para>
  <para style="q" vid="PSA 101:8">ಪ್ರತಿ ಮುಂಜಾನೆಯಲ್ಲಿ ದೇಶದ ದುಷ್ಟರನ್ನು ಸಂಹರಿಸುತ್ತಾ ಬರುವೆನು.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s">ದುಃಖಿತನಾದ ದೀನನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1"/>ಯೆಹೋವನೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಕೇಳು;</para>
  <para style="q" vid="PSA 102:1">ನನ್ನ ಕೂಗು ನಿನಗೆ ಮುಟ್ಟಲಿ.<verse eid="PSA 102:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2"/>ನನ್ನ ಕಷ್ಟದಲ್ಲಿ ವಿಮುಖನಾಗಬೇಡ;</para>
  <para style="q" vid="PSA 102:2">ನನ್ನ ಮೊರೆಗೆ ಕಿವಿಗೊಡು;</para>
  <para style="q" vid="PSA 102:2">ನಾನು ಕೂಗಿಕೊಳ್ಳುವ ದಿನದಲ್ಲಿ ಬೇಗನೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 102:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3"/>ನನ್ನ ಜೀವಮಾನವು ಹೊಗೆಯಂತೆ ಮಾಯವಾಗುತ್ತದೆ;</para>
  <para style="q" vid="PSA 102:3">ನನ್ನ ಎಲುಬುಗಳು ಕೊಳ್ಳಿಯಂತೆ ಸುಟ್ಟುಹೋಗುತ್ತವೆ.<verse eid="PSA 102:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4"/>ನನ್ನ ಹೃದಯವು ಬಿಸಿಲಿನಿಂದ ಬಾಡಿಹೋದ ಹುಲ್ಲಿನಂತಿದೆ;</para>
  <para style="q" vid="PSA 102:4">ಊಟವನ್ನು ಮರೆತೆನು.<verse eid="PSA 102:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5"/>ನಿಟ್ಟುಸಿರಿನಿಂದ ನನ್ನಲ್ಲಿ ಎಲುಬು, ತೊಗಲು ಮಾತ್ರ ಉಳಿದಿರುತ್ತವೆ.<verse eid="PSA 102:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6"/>ಅಡವಿಯ ಬಕಪಕ್ಷಿಯಂತಿದ್ದೇನೆ;<note caller="+" style="f"><char style="fr" closed="false">102:6 </char><char style="fq" closed="false">ಬಕಪಕ್ಷಿ; </char><char style="ft" closed="false">ಅಥವಾ ರಣಹದ್ದು.</char></note></para>
  <para style="q" vid="PSA 102:6">ಹಾಳೂರಿನ ಗೂಬೆಯಂತಿದ್ದೇನೆ.<verse eid="PSA 102:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7"/>ನಿದ್ರೆಯಿಲ್ಲದವನಾಗಿ ಮನೆಮಾಳಿಗೆಯ ಮೇಲಿರುವ,</para>
  <para style="q" vid="PSA 102:7">ಒಂಟಿಯಾದ ಪಕ್ಷಿಯಂತಿದ್ದೇನೆ.<verse eid="PSA 102:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8"/>ವೈರಿಗಳು ಹಗಲೆಲ್ಲಾ ನನ್ನನ್ನು ನಿಂದಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 102:8">ನನ್ನ ಮೇಲೆ ಕೋಪಾವೇಶವುಳ್ಳವರು ಯಾರನ್ನಾದರೂ ಶಪಿಸುವಾಗ,</para>
  <para style="q" vid="PSA 102:8">ನನ್ನನ್ನು ದೃಷ್ಟಾಂತಮಾಡಿ ಶಪಿಸುತ್ತಾರೆ.<verse eid="PSA 102:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9"/>ಬೂದಿಯೇ ನನಗೆ ಆಹಾರವಾಯಿತು;</para>
  <para style="q" vid="PSA 102:9">ನನ್ನ ಪಾನದಲ್ಲಿ ಕಣ್ಣೀರು ಮಿಶ್ರವಾಯಿತು.<verse eid="PSA 102:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10"/>ಇದಕ್ಕೆಲ್ಲಾ ನಿನ್ನ ಕೋಪ, ರೌದ್ರಗಳೇ ಕಾರಣ,</para>
  <para style="q" vid="PSA 102:10">ನೀನು ನನ್ನನ್ನು ಎತ್ತಿ ಒಗೆದುಬಿಟ್ಟಿದ್ದಿಯಲ್ಲಾ!<verse eid="PSA 102:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11"/>ನನ್ನ ಜೀವಮಾನವು ಸಂಜೆಯ ನೆರಳಿನಂತಿದೆ;</para>
  <para style="q" vid="PSA 102:11">ನಾನು ಬಾಡಿಹೋದ ಹುಲ್ಲಿನಂತಿದ್ದೇನೆ.<verse eid="PSA 102:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12"/>ಯೆಹೋವನೇ, ನೀನಾದರೋ ಸದಾ ಸಿಂಹಾಸನಾರೂಢನಾಗಿರುವಿ;</para>
  <para style="q" vid="PSA 102:12">ನಿನ್ನ ನಾಮವು ತಲತಲಾಂತರಕ್ಕೂ ಸ್ಮರಿಸಲ್ಪಡುವುದು.<verse eid="PSA 102:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13"/>ನೀನು ಎದ್ದು ಚೀಯೋನನ್ನು ಕರುಣಿಸುವಿ.</para>
  <para style="q" vid="PSA 102:13">ಅದಕ್ಕೆ ಕೃಪೆತೋರಿಸುವ ಸಮಯ ಇದೇ;</para>
  <para style="q" vid="PSA 102:13">ನಿಯಮಿತ ಕಾಲವು ಬಂದಿದೆ.<verse eid="PSA 102:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14"/>ಅದು ಕಲ್ಲುಕುಪ್ಪೆಯಾಗಿ ಹೋಗಿದ್ದರೂ,</para>
  <para style="q" vid="PSA 102:14">ಅದು ನಿನ್ನ ಸೇವಕರಿಗೆ ಅತಿಪ್ರಿಯವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 102:14">ಅದರ ಧೂಳಿಗೆ ಅವರು ಮರಗುತ್ತಾರೆ.<verse eid="PSA 102:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15"/>ಯೆಹೋವನು ಗತಿಹೀನರ ಮೊರೆಯನ್ನು ತಿರಸ್ಕರಿಸದೆ ನೆರವೇರಿಸಿದನೆಂದೂ,<verse eid="PSA 102:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16"/>ಆತನು ಮಹಿಮೆಯಲ್ಲಿ ಬಂದು ಚೀಯೋನನ್ನು ತಿರುಗಿ ಕಟ್ಟಿಸಿದನೆಂದೂ,<verse eid="PSA 102:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17"/>ಜನಾಂಗಗಳು ಯೆಹೋವ ಎಂಬ ನಿನ್ನ ನಾಮಕ್ಕೂ,</para>
  <para style="q" vid="PSA 102:17">ಭೂರಾಜರು ನಿನ್ನ ಪ್ರತಾಪಕ್ಕೂ ಭಯಪಡುವರು.<verse eid="PSA 102:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18"/>ಇದು ಮುಂದಣ ಸಂತಾನದವರಿಗೋಸ್ಕರ ಶಾಸನವಾಗಿರಲಿ,</para>
  <para style="q" vid="PSA 102:18">ಮುಂದೆ ಹುಟ್ಟುವ ಪ್ರಜೆಯು ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುತ್ತಾ,<verse eid="PSA 102:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19"/>“ಯೆಹೋವನು ತನ್ನ ಮಹೋನ್ನತವಾದ ಪವಿತ್ರಸ್ಥಾನದಿಂದ ಕೆಳಕ್ಕೆ ನೋಡಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 102:19">ಆತನು ಪರಲೋಕದಿಂದ ಭೂಮಿಯನ್ನು ದೃಷ್ಟಿಸಿದ್ದಾನೆ.<verse eid="PSA 102:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20"/>ಸೆರೆಯವರ ಗೋಳಾಟವನ್ನು ಪರಿಗಣಿಸಿ, ಮರಣಪಾತ್ರರನ್ನು ಬಿಡಿಸಿ,<verse eid="PSA 102:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21"/>ಅವರು ಚೀಯೋನಿನಲ್ಲಿ ಯೆಹೋವನ ನಾಮವನ್ನು ವರ್ಣಿಸುವಂತೆಯೂ,</para>
  <para style="q" vid="PSA 102:21">ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ತನ್ನ ಕೀರ್ತನೆಯನ್ನು ಹಾಡುವಂತೆಯೂ ಮಾಡಿದ್ದಾನೆ.<verse eid="PSA 102:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22"/>ಜನಾಂಗಗಳೂ, ರಾಜ್ಯಗಳೂ ಕೂಡಿಬಂದು</para>
  <para style="q" vid="PSA 102:22">ಇವರೊಡನೆ ಯೆಹೋವನನ್ನು ಸೇವಿಸುತ್ತವೆ” ಎಂದು ಹೇಳುವುದು.<verse eid="PSA 102:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23"/>ಆತನು ಯೌವನಪ್ರಾಯದಲ್ಲಿಯೇ<note caller="+" style="f"><char style="fr" closed="false">102:23 </char><char style="fq" closed="false">ಯೌವನಪ್ರಾಯದಲ್ಲಿಯೇ </char><char style="ft" closed="false">ಅಥವಾ ದಾರಿಯಲ್ಲಿಯೇ.</char></note> ನನ್ನ ಬಲವನ್ನು ಕುಂದಿಸಿದ್ದಾನೆ;<verse eid="PSA 102:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24"/>ನನ್ನ ಆಯುಷ್ಯವನ್ನು ಕಡಿಮೆ ಮಾಡಿಬಿಟ್ಟಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 102:24">ಆದುದರಿಂದ, “ನನ್ನ ದೇವರೇ, ಅರ್ಧಾಯುಷ್ಯದಲ್ಲಿಯೇ ನನ್ನನ್ನು ಒಯ್ಯಬೇಡ;</para>
  <para style="q" vid="PSA 102:24">ನಿನ್ನ ವರ್ಷಗಳು ತಲತಲಾಂತರಕ್ಕೂ ಇರುತ್ತವೆ.<verse eid="PSA 102:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25"/>ಆದಿಯಲ್ಲಿ ನೀನು ಭೂಮಿಗೆ ಅಸ್ತಿವಾರವನ್ನು ಹಾಕಿದಿ;</para>
  <para style="q" vid="PSA 102:25">ಗಗನಮಂಡಲವು ನಿನ್ನ ಕೈಕೆಲಸವಾಗಿದೆ.<verse eid="PSA 102:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26"/>ಅವು ನಾಶವಾಗುವವು;</para>
  <para style="q" vid="PSA 102:26">ಆದರೆ ನೀನು ಶಾಶ್ವತವಾಗಿರುತ್ತಿ.</para>
  <para style="q" vid="PSA 102:26">ಅವೆಲ್ಲವೂ ವಸ್ತ್ರದಂತೆ ಹಳೆಯದಾಗುವವು.</para>
  <para style="q" vid="PSA 102:26">ಉಡುಪಿನಂತೆ ಅವುಗಳನ್ನು ಬದಲಿಸುತ್ತಿ; ಅವು ಮಾರ್ಪಡುವವು.<verse eid="PSA 102:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27"/>ನೀನಾದರೋ ಏಕರೀತಿಯಾಗಿರುತ್ತಿ;</para>
  <para style="q" vid="PSA 102:27">ನಿನ್ನ ವರ್ಷಗಳು ಮುಗಿದುಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 102:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28"/>ನಿನ್ನ ಸೇವಕರ ಮಕ್ಕಳು ಬಾಳುವರು.</para>
  <para style="q" vid="PSA 102:28">ಅವರ ಸಂತತಿಯವರು ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಸ್ಥಿರವಾಗಿರುವರು” ಎಂದು ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s">ದೇವರ ಕೃಪೆಯನ್ನು ಕೊಂಡಾಡುವುದು</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1"/>ನನ್ನ ಮನವೇ, ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡು;</para>
  <para style="q" vid="PSA 103:1">ನನ್ನ ಸರ್ವೇಂದ್ರಿಯಗಳೇ, ಆತನ ಪವಿತ್ರ ನಾಮವನ್ನು ಕೀರ್ತಿಸಿರಿ.<verse eid="PSA 103:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2"/>ನನ್ನ ಮನವೇ, ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡು;</para>
  <para style="q" vid="PSA 103:2">ಆತನ ಉಪಕಾರಗಳಲ್ಲಿ ಒಂದನ್ನೂ ಮರೆಯಬೇಡ.<verse eid="PSA 103:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3"/>ಆತನು ನಿನ್ನ ಎಲ್ಲಾ ಅಪರಾಧಗಳನ್ನು ಕ್ಷಮಿಸುವವನೂ,</para>
  <para style="q" vid="PSA 103:3">ಸಮಸ್ತ ರೋಗಗಳನ್ನು ವಾಸಿಮಾಡುವವನೂ,<verse eid="PSA 103:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4"/>ನಿನ್ನ ಜೀವವನ್ನು ನಾಶನದಿಂದ ತಪ್ಪಿಸುವವನೂ,</para>
  <para style="q" vid="PSA 103:4">
    <note caller="+" style="f">
      <char style="fr" closed="false">103:4 </char>
      <char style="ft" closed="false">ಅಥವಾ ಆತನು ನಿನ್ನನ್ನು ಶಾಶ್ವತ ಪ್ರೀತಿಯಿಂದ ಮತ್ತು ಕೃಪೆಯಿಂದ ಆಶೀರ್ವದಿಸುತ್ತಾನೆ.</char>
    </note>ಶಾಶ್ವತ ಪ್ರೀತಿ ಮತ್ತು ಕರುಣೆಯೆಂಬ ಕಿರೀಟದಿಂದ ನಿನ್ನನ್ನು ಶೃಂಗರಿಸುವವನೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 103:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5"/>ಶ್ರೇಷ್ಠ ವರಗಳಿಂದ ನಿನ್ನ ಆಶೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 103:5">ಹದ್ದಿಗೆ ಬರುವಂತೆಯೇ ನಿನಗೆ ಯೌವನವನ್ನು ತಿರುಗಿ ಬರಮಾಡುತ್ತಾನೆ.<verse eid="PSA 103:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6"/>ಯೆಹೋವನು ನೀತಿಯನ್ನು ಸಾಧಿಸುವವನಾಗಿ,</para>
  <para style="q" vid="PSA 103:6">ಕುಗ್ಗಿಹೋದವರೆಲ್ಲರ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುತ್ತಾನೆ.<verse eid="PSA 103:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7"/>ಆತನು ಮೋಶೆಗೆ ತನ್ನ ಮಾರ್ಗವನ್ನೂ,</para>
  <para style="q" vid="PSA 103:7">ಇಸ್ರಾಯೇಲರಿಗೆ ತನ್ನ ಕೃತ್ಯಗಳನ್ನೂ ಪ್ರಕಟಿಸಿದನು.<verse eid="PSA 103:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8"/>ಯೆಹೋವನು ಕನಿಕರವೂ, ದಯೆಯೂ,</para>
  <para style="q" vid="PSA 103:8">ದೀರ್ಘಶಾಂತಿಯೂ, ಪೂರ್ಣಪ್ರೀತಿಯೂ ಉಳ್ಳವನು.<verse eid="PSA 103:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9"/>ಆತನು ಯಾವಾಗಲೂ ತಪ್ಪು ಹುಡುಕುವವನಲ್ಲ;</para>
  <para style="q" vid="PSA 103:9">ನಿತ್ಯವೂ ಕೋಪಿಸುವವನಲ್ಲ.<verse eid="PSA 103:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10"/>ಆತನು ನಮ್ಮ ಪಾಪಗಳಿಗೆ ಸರಿಯಾಗಿ ನಮ್ಮನ್ನು ಶಿಕ್ಷಿಸಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 103:10">ನಮ್ಮ ಅಪರಾಧಗಳಿಗೆ ತಕ್ಕಂತೆ ದಂಡಿಸಲಿಲ್ಲ.<verse eid="PSA 103:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11"/>ಭೂಮಿಯ ಮೇಲೆ ಆಕಾಶವು ಎಷ್ಟು ಉನ್ನತವೋ,</para>
  <para style="q" vid="PSA 103:11">ಆತನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರ ಮೇಲೆ ಆತನ ಕೃಪೆಯು ಅಷ್ಟು ಅಪಾರವಾಗಿದೆ.<verse eid="PSA 103:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12"/>ಪೂರ್ವಕ್ಕೂ, ಪಶ್ಚಿಮಕ್ಕೂ ಎಷ್ಟು ದೂರವೋ,</para>
  <para style="q" vid="PSA 103:12">ನಮ್ಮ ದ್ರೋಹಗಳನ್ನು ನಮ್ಮಿಂದ ತೆಗೆದು ಅಷ್ಟು ದೂರ ಮಾಡಿದ್ದಾನೆ.<verse eid="PSA 103:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13"/>ತಂದೆಯು ಮಕ್ಕಳನ್ನು ಕನಿಕರಿಸುವಂತೆ,</para>
  <para style="q" vid="PSA 103:13">ಯೆಹೋವನು ತನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರನ್ನು ಕನಿಕರಿಸುತ್ತಾನೆ.<verse eid="PSA 103:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14"/>ನಾವು ರೂಪಗೊಂಡಿದ್ದನ್ನು ಆತನು ಬಲ್ಲನು;</para>
  <para style="q" vid="PSA 103:14">ನಾವು ಧೂಳಾಗಿದ್ದೇವೆ ಎಂಬುವುದನ್ನು ನೆನಪುಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PSA 103:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15"/>ಮನುಷ್ಯನ ಆಯುಷ್ಕಾಲವು ಹುಲ್ಲಿನಂತಿದೆ;</para>
  <para style="q" vid="PSA 103:15">ಅವನು ಅಡವಿಯ ಹೂವಿನ ಹಾಗೆ ಶೋಭಿಸುತ್ತಾನೆ.<verse eid="PSA 103:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16"/>ಗಾಳಿ ಬಡಿಯುತ್ತಲೇ ಅದು ಹೋಗುವುದು;</para>
  <para style="q" vid="PSA 103:16">ಅದರ ಸ್ಥಳವು ಅದನ್ನು ತಿರುಗಿ ಕಾಣುವುದಿಲ್ಲ.<verse eid="PSA 103:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17"/>ಆದರೆ ಯೆಹೋವನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರ ಮೇಲೆ,</para>
  <para style="q" vid="PSA 103:17">ಆತನ ದಯೆಯು ಯುಗಯುಗಾಂತರಗಳವರೆಗೂ ಇರುತ್ತದೆ.<verse eid="PSA 103:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18"/>ಆತನ ನಿಬಂಧನೆಗಳನ್ನು ಕೈಕೊಂಡು,</para>
  <para style="q" vid="PSA 103:18">ಆತನ ವಿಧಿಗಳನ್ನು ನೆನಪಿನಲ್ಲಿಟ್ಟುಕೊಂಡು ನಡೆಯುವವರ</para>
  <para style="q" vid="PSA 103:18">ಮಕ್ಕಳು ಮೊಮ್ಮಕ್ಕಳವರೆಗೂ ಆತನು ತನ್ನ ನೀತಿಯನ್ನು ಸಾಧಿಸುವನು.<verse eid="PSA 103:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19"/>ಯೆಹೋವನು ಮೇಲಣ ಲೋಕದಲ್ಲಿ ತನ್ನ ಸಿಂಹಾಸನವನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 103:19">ಆತನು ಸಮಸ್ತವನ್ನೂ ಆಳುತ್ತಾನೆ.<verse eid="PSA 103:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20"/>ದೇವದೂತರೇ, ಆತನ ಶಬ್ದಕ್ಕೆ ಕಿವಿಗೊಡುವವರೆ</para>
  <para style="q" vid="PSA 103:20">ಆತನ ಆಜ್ಞೆಯನ್ನು ನೆರವೇರಿಸುವ ಪರಾಕ್ರಮಶಾಲಿಗಳೇ,</para>
  <para style="q" vid="PSA 103:20">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 103:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21"/>ಆತನ ಸೈನ್ಯಗಳೇ, ಆತನ ಚಿತ್ತವನ್ನು ನೆರವೇರಿಸುವ ಸೇವಕರೇ,</para>
  <para style="q" vid="PSA 103:21">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 103:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22"/>ಆತನ ರಾಜ್ಯದ ಸರ್ವಸ್ಥಳಗಳಲ್ಲಿರುವ ಎಲ್ಲಾ ಸೃಷ್ಟಿಗಳೇ,</para>
  <para style="q" vid="PSA 103:22">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.</para>
  <para style="q" vid="PSA 103:22">ನನ್ನ ಮನವೇ, ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡು.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="s">ಯೆಹೋವನ ಸೃಷ್ಟಿಯ ಮಹತ್ವ</para>
  <para style="r">
    <ref loc="GEN 1">ಆದಿ 1</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1"/>ನನ್ನ ಮನವೇ, ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡು.</para>
  <para style="q" vid="PSA 104:1">ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ, ನೀನು ಸರ್ವೋತ್ತಮನು;</para>
  <para style="q" vid="PSA 104:1">ಪ್ರಭಾವ ಮತ್ತು ಮಹತ್ವಗಳಿಂದ ಭೂಷಿತನಾಗಿರುವೆ.<verse eid="PSA 104:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2"/>ಬೆಳಕನ್ನು ವಸ್ತ್ರದಂತೆ ಹೊದ್ದುಕೊಂಡಿರುವೆ;</para>
  <para style="q" vid="PSA 104:2">ಆಕಾಶವನ್ನು ಗುಡಾರದಂತೆ ಎತ್ತಿ ಹರಡಿರುವೆ.<verse eid="PSA 104:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3"/>ನೀರಿನ ಮೇಲೆ ತೊಳೆಗಳನ್ನು ನಿಲ್ಲಿಸಿ ಉಪ್ಪರಿಗೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡು;</para>
  <para style="q" vid="PSA 104:3">ಮೋಡಗಳನ್ನು ವಾಹನವಾಗಿ ಮಾಡಿಕೊಂಡಿರುವೆ;</para>
  <para style="q" vid="PSA 104:3">ವಾಯುವಿನ ರೆಕ್ಕೆಗಳ ಮೇಲೆ ಸಂಚರಿಸುತ್ತೀ.<verse eid="PSA 104:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">104:4 </char>
      <char style="ft" closed="false">ಅಥವಾ ಆತನು ತನ್ನ ದೂತರನ್ನು ಗಾಳಿಯನ್ನಾಗಿಯೂ, ತನ್ನ ಸೇವಕರನ್ನು ಅಗ್ನಿಜ್ವಾಲೆಯನ್ನಾಗಿ ಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ.</char>
    </note>ಗಾಳಿಯನ್ನು ನಿನ್ನ ದೂತರನ್ನಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 104:4">ಅಗ್ನಿಜ್ವಾಲೆಯನ್ನು ಸೇವಕರನ್ನಾಗಿಯೂ ಮಾಡಿಕೊಳ್ಳುತ್ತೀ.<verse eid="PSA 104:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5"/>ಭೂಮಿಯು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಕದಲದ ಹಾಗೆ</para>
  <para style="q" vid="PSA 104:5">ಅದನ್ನು ದೃಢವಾದ ಅಸ್ತಿವಾರದ ಮೇಲೆ ಸ್ಥಾಪಿಸಿದ್ದೀ.<verse eid="PSA 104:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6"/>ನೀನು ಅದನ್ನು ಆದಿಸಾಗರವೆಂಬ ವಸ್ತ್ರದಿಂದ ಹೊದಿಸಿದ್ದೀ;</para>
  <para style="q" vid="PSA 104:6">ನೀರು ಪರ್ವತಗಳನ್ನೂ ಮುಚ್ಚಿಬಿಟ್ಟಿತ್ತು.<verse eid="PSA 104:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7"/>ನೀನು ಗದರಿಸಲು ಅದು ಓಡಿಹೋಯಿತು;</para>
  <para style="q" vid="PSA 104:7">ನಿನ್ನ ಗರ್ಜನೆಗೆ ಹೆದರಿ ನೀನು ನೇಮಿಸಿದ ಸ್ಥಳಕ್ಕೆ ಹೋಗಲು,<verse eid="PSA 104:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8"/>ಪರ್ವತಗಳು ಎದ್ದವು; ತಗ್ಗುಗಳು ಇಳಿದವು.<verse eid="PSA 104:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9"/>ಜಲರಾಶಿಗಳು ಬಂದು ಪುನಃ ಭೂಮಿಯನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳದ ಹಾಗೆ,</para>
  <para style="q" vid="PSA 104:9">ನೀನು ಮೇರೆಗಳನ್ನು ಗೊತ್ತುಮಾಡಿದಿ.<verse eid="PSA 104:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10"/>ಬುಗ್ಗೆಗಳನ್ನು ತಗ್ಗುಗಳಿಗೆ ಬರಮಾಡುತ್ತೀ;</para>
  <para style="q" vid="PSA 104:10">ಅವು ಪರ್ವತಗಳ ನಡುವೆ ಹರಿದುಹೋಗುತ್ತವೆ.<verse eid="PSA 104:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11"/>ಅವು ಅಡವಿಯ ಮೃಗಗಳಿಗೆ ನೀರುಕೊಡುತ್ತವೆ;</para>
  <para style="q" vid="PSA 104:11">ಕಾಡುಕತ್ತೆಗಳು ದಾಹ ತೀರಿಸಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 104:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12"/>ಪಕ್ಷಿಗಳು ಅವುಗಳ ಬಳಿಯ ಮರಗಳ ಕೊಂಬೆಗಳಲ್ಲಿ ವಾಸವಾಗಿದ್ದು ಗಾನಮಾಡುತ್ತವೆ.<verse eid="PSA 104:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13"/>ನೀನು ನಿನ್ನ ಮೇಲಂತಸ್ತುಗಳಿಂದ<note caller="+" style="f"><char style="fr" closed="false">104:13 </char><char style="fq" closed="false">ಮೇಲಂತಸ್ತುಗಳಿಂದ </char><char style="ft" closed="false">ಅಥವಾ ಆಕಾಶದಿಂದ. </char></note> ಪರ್ವತಗಳಿಗೆ ನೀರು ಕೊಡುತ್ತೀ;</para>
  <para style="q" vid="PSA 104:13">ನಿನ್ನ ಕಾರ್ಯಫಲದಿಂದ ಭೂಮಿಯು ತೃಪ್ತಿಹೊಂದುತ್ತದೆ.<verse eid="PSA 104:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14"/>ಪಶುಗಳಿಗೋಸ್ಕರ ಹುಲ್ಲನ್ನು ಮೊಳಿಸುತ್ತೀ;</para>
  <para style="q" vid="PSA 104:14">ಮನುಷ್ಯರಿಗೋಸ್ಕರ ಪೈರುಗಳನ್ನು ಹುಟ್ಟಿಸುತ್ತೀ.</para>
  <para style="q" vid="PSA 104:14">ಅವರು ಭೂವ್ಯವಸಾಯಮಾಡಿ ಆಹಾರವನ್ನು,<verse eid="PSA 104:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15"/>ಹೃದಯಾನಂದಕರವಾದ ದ್ರಾಕ್ಷಾರಸವನ್ನು,</para>
  <para style="q" vid="PSA 104:15">ಮುಖಕ್ಕೆ ಕಾಂತಿಯನ್ನು ಉಂಟುಮಾಡುವ ಎಣ್ಣೆಯನ್ನು,</para>
  <para style="q" vid="PSA 104:15">ಪ್ರಾಣಾಧಾರವಾದ ರೊಟ್ಟಿಯನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳುತ್ತಾರೆ.<verse eid="PSA 104:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16"/>ಯೆಹೋವನು ನೆಟ್ಟ ಮರಗಳಾದ ಲೆಬನೋನಿನ ದೇವದಾರು ವೃಕ್ಷಗಳಿಗೆ</para>
  <para style="q" vid="PSA 104:16">ಬೇಕಾದಷ್ಟು ಜಲವಿರುತ್ತದೆ.<verse eid="PSA 104:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17"/>ಪಕ್ಷಿಗಳು ಅವುಗಳಲ್ಲಿ ಗೂಡು ಕಟ್ಟಿಕೊಳ್ಳುತ್ತವೆ;</para>
  <para style="q" vid="PSA 104:17">ತುರಾಯಿ ಮರಗಳಲ್ಲಿ ಬಕಪಕ್ಷಿಗಳು ವಾಸಿಸುತ್ತವೆ.<verse eid="PSA 104:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18"/>ಕಾಡಕುರಿಗಳಿಗೆ ಉನ್ನತವಾದ ಪರ್ವತಗಳೂ,</para>
  <para style="q" vid="PSA 104:18">ಬೆಟ್ಟದ ಮೊಲಗಳಿಗೆ ಬಂಡೆಗಳೂ ಆಶ್ರಯಸ್ಥಾನಗಳಾಗಿವೆ.<verse eid="PSA 104:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19"/>ವಿಶೇಷಕಾಲಗಳ ಸೂಚನೆಗಾಗಿ ಚಂದ್ರನನ್ನು ನಿರ್ಮಿಸಿರುವೆ;</para>
  <para style="q" vid="PSA 104:19">ಸೂರ್ಯನು ತನ್ನ ಅಸ್ತಮಾನ ಸಮಯವನ್ನು ಬಲ್ಲನು.<verse eid="PSA 104:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20"/>ನೀನು ಕತ್ತಲೆಯನ್ನು ಬರಮಾಡಲು ರಾತ್ರಿಯಾಗುತ್ತದೆ.</para>
  <para style="q" vid="PSA 104:20">ಆಗ ಕಾಡಿನ ಮೃಗಗಳೆಲ್ಲಾ ಹೊರಬರುತ್ತವೆ.<verse eid="PSA 104:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21"/>ಪ್ರಾಯದ ಸಿಂಹಗಳು ಬೇಟೆಗಾಗಿ ಗರ್ಜಿಸುತ್ತವೆ;</para>
  <para style="q" vid="PSA 104:21">ದೇವರಿಂದ ಆಹಾರವನ್ನು ಕೇಳಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 104:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22"/>ಸೂರ್ಯೋದಯವಾಗಲು ಅವು ಬಂದು ತಮ್ಮ ಗವಿಗಳಲ್ಲಿ ಮಲಗಿಕೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 104:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23"/>ಮನುಷ್ಯನು ತನ್ನ ಕೆಲಸಕ್ಕೆ ಹೊರಟು ಹೋಗುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 104:23">ಸಾಯಂಕಾಲದವರೆಗೆ ದುಡಿಯುತ್ತಾನೆ.<verse eid="PSA 104:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕೈಕೆಲಸಗಳು ಬಗೆ ಬಗೆಯಾಗಿವೆ.</para>
  <para style="q" vid="PSA 104:24">ಅವುಗಳನ್ನೆಲ್ಲಾ ಜ್ಞಾನದಿಂದಲೇ ಮಾಡಿರುವೆ;</para>
  <para style="q" vid="PSA 104:24">ಭೂಲೋಕವು ನಿನ್ನ ಆಸ್ತಿಯಿಂದ ತುಂಬಿರುತ್ತದೆ.<verse eid="PSA 104:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25"/>ಇಗೋ, ಬಹುವಿಶಾಲವಾದ ಸಮುದ್ರವು!</para>
  <para style="q" vid="PSA 104:25">ಅದರೊಳಗೆ ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಸಣ್ಣ, ದೊಡ್ಡ ಜೀವಜಂತುಗಳು ಚಲಿಸುತ್ತಿರುತ್ತವೆ.<verse eid="PSA 104:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26"/>ಅದರಲ್ಲಿ ಹಡಗುಗಳು ಸಂಚರಿಸುತ್ತವೆ</para>
  <para style="q" vid="PSA 104:26">ನೀನು ಉಂಟುಮಾಡಿದ <note caller="+" style="f"><char style="fr" closed="false">104:26 </char><char style="ft" closed="false">ಕೀರ್ತನೇ. 74:14 ಅನ್ನು ನೋಡಿರಿ</char></note>ಲಿವ್ಯಾತಾನವು ಅದರಲ್ಲಿ ಆಡುತ್ತದೆ.<verse eid="PSA 104:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27"/>ಇವುಗಳು ಹೊತ್ತುಹೊತ್ತಿಗೆ ಆಹಾರಕ್ಕೋಸ್ಕರ ನಿನ್ನನ್ನೇ ನಿರೀಕ್ಷಿಸುತ್ತವೆ.<verse eid="PSA 104:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28"/>ನೀನು ಕೊಡಲು ಅವು ತೆಗೆದುಕೊಳ್ಳುತ್ತವೆ;</para>
  <para style="q" vid="PSA 104:28">ನೀನು ಕೈತೆರೆಯಲು ಅವು ಒಳ್ಳೇಯದನ್ನು ಹೊಂದಿ ತೃಪ್ತಿಗೊಳ್ಳುತ್ತವೆ.<verse eid="PSA 104:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29"/>ನೀನು ವಿಮುಖನಾಗಲು ತಲ್ಲಣಿಸುತ್ತವೆ;</para>
  <para style="q" vid="PSA 104:29">ಅವುಗಳ ಶ್ವಾಸವನ್ನು ತೆಗೆದುಬಿಡಲು ಅವು ಸತ್ತು ತಿರುಗಿ ಮಣ್ಣಿಗೆ ಸೇರುತ್ತವೆ.<verse eid="PSA 104:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30"/>ನೀನು ಜೀವಶ್ವಾಸವನ್ನು ಊದಲು ಅವು ಹೊಸದಾಗಿ ಹುಟ್ಟುತ್ತವೆ.</para>
  <para style="q" vid="PSA 104:30">ನೀನು ಭೂಮಿಯನ್ನು ನೂತನಪಡಿಸುತ್ತಿರುತ್ತಿ.<verse eid="PSA 104:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31"/>ಯೆಹೋವನ ಮಹಿಮೆಯು ಸದಾಕಾಲವೂ ಇರಲಿ;</para>
  <para style="q" vid="PSA 104:31">ಯೆಹೋವನಿಗೆ ಆತನ ಸೃಷ್ಟಿಗಳಿಂದ ಸಂತೋಷವಾಗಲಿ.<verse eid="PSA 104:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32"/>ಆತನು ದೃಷ್ಟಿಸಿದ ಮಾತ್ರದಿಂದಲೇ ಭೂಮಿಯು ಕಂಪಿಸುತ್ತದೆ;</para>
  <para style="q" vid="PSA 104:32">ಮುಟ್ಟುತ್ತಲೇ ಪರ್ವತಗಳು ಹೊಗೆಹಾಯುತ್ತವೆ.<verse eid="PSA 104:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33"/>ನಾನು ಬದುಕಿರುವವರೆಗೂ ಯೆಹೋವನನ್ನು ಕೀರ್ತಿಸುತ್ತಿರುವೆನು;</para>
  <para style="q" vid="PSA 104:33">ಜೀವಮಾನವೆಲ್ಲಾ ನನ್ನ ದೇವರನ್ನು ಭಜಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 104:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34"/>ನನ್ನ ಧ್ಯಾನದಿಂದ ಆತನಿಗೆ ಮೆಚ್ಚಿಕೆಯಾಗಲಿ;</para>
  <para style="q" vid="PSA 104:34">ನಾನಾದರೋ ಯೆಹೋವನಲ್ಲಿ ಆನಂದಿಸುವೆನು.<verse eid="PSA 104:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35"/>ಪಾಪಾತ್ಮರು ಭೂಲೋಕದಲ್ಲಿ ಮುಗಿದುಹೋಗಲಿ;</para>
  <para style="q" vid="PSA 104:35">ದುಷ್ಟರು ನಿರ್ಮೂಲವಾಗಲಿ.</para>
  <para style="q" vid="PSA 104:35">ನನ್ನ ಮನವೇ, ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡು;</para>
  <para style="q" vid="PSA 104:35">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="s">ವಾಗ್ದಾನವನ್ನು ನೆರವೇರಿಸಿದ ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ</para>
  <para style="r">
    <ref loc="PSA 78">ಕೀರ್ತ 78</ref>; <ref loc="PSA 106">106</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1"/>ಯೆಹೋವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 105:1">ಆತನ ನಾಮದ ಮಹತ್ವವನ್ನು ವರ್ಣಿಸಿರಿ;</para>
  <para style="q" vid="PSA 105:1">ಜನಾಂಗಗಳಲ್ಲಿ ಆತನ ಕೃತ್ಯಗಳನ್ನು ಪ್ರಸಿದ್ಧಪಡಿಸಿರಿ.<verse eid="PSA 105:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2"/>ಆತನನ್ನು ಕೀರ್ತಿಸಿರಿ, ಭಜಿಸಿರಿ;</para>
  <para style="q" vid="PSA 105:2">ಆತನ ಅದ್ಭುತಕೃತ್ಯಗಳನ್ನೆಲ್ಲಾ ಧ್ಯಾನಿಸಿರಿ.<verse eid="PSA 105:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3"/>ಆತನ ಪರಿಶುದ್ಧ ನಾಮದಲ್ಲಿ ಹಿಗ್ಗಿರಿ;</para>
  <para style="q" vid="PSA 105:3">ಯೆಹೋವನ ದರ್ಶನವನ್ನು ಕೋರುವವರ ಹೃದಯವು ಹರ್ಷಿಸಲಿ.<verse eid="PSA 105:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4"/>ಯೆಹೋವನನ್ನೂ, ಆತನ ಬಲವನ್ನೂ ಆಶ್ರಯಿಸಿರಿ;</para>
  <para style="q" vid="PSA 105:4">ನಿತ್ಯವೂ ಆತನ ದರ್ಶನವನ್ನು ಅಪೇಕ್ಷಿಸಿರಿ.<verse eid="PSA 105:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5"/>ಆತನು ಮಾಡಿದ ಅದ್ಭುತಕೃತ್ಯ, ಆತನ ಮಹತ್ಕಾರ್ಯ,</para>
  <para style="q" vid="PSA 105:5">ಆತನ ಬಾಯಿಂದ ಹೊರಟ ನ್ಯಾಯನಿರ್ಣಯ ಇವುಗಳನ್ನು,<verse eid="PSA 105:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6"/>ಆತನ ಸೇವಕನಾದ ಅಬ್ರಹಾಮನ ಸಂತತಿಯವರೇ,</para>
  <para style="q" vid="PSA 105:6">ಆತನು ಆರಿಸಿಕೊಂಡ ಯಾಕೋಬನ ವಂಶದವರೇ, ನೀವು ನೆನಪುಮಾಡಿಕೊಳ್ಳಿರಿ.<verse eid="PSA 105:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7"/>ಯೆಹೋವನೆಂಬಾತನೇ ನಮ್ಮ ದೇವರು;</para>
  <para style="q" vid="PSA 105:7">ಆತನ ನ್ಯಾಯವಿಧಿಗಳು ಭೂಲೋಕದಲ್ಲೆಲ್ಲಾ ಇವೆ.<verse eid="PSA 105:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8"/>ಆತನು ತನ್ನ ವಾಗ್ದಾನವನ್ನು ಸಾವಿರ ತಲೆಗಳವರೆಗೂ,</para>
  <para style="q" vid="PSA 105:8">ತನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ನಿತ್ಯವೂ ನೆನಪಿನಲ್ಲಿಟ್ಟುಕೊಳ್ಳುತ್ತಾನೆ.<verse eid="PSA 105:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9"/>ಆತನು ಆ ಒಡಂಬಡಿಕೆಯನ್ನು ಅಬ್ರಹಾಮನ ಸಂಗಡ ಮಾಡಿಕೊಂಡನು;</para>
  <para style="q" vid="PSA 105:9">ಇಸಾಕನಿಗೆ ತನ್ನ ವಾಗ್ದಾನಗಳನ್ನು ಕೊಟ್ಟನು.<verse eid="PSA 105:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10"/>ಅದು ರಾಜಶಾಸನದಂತೆ ಇರುವುದೆಂದು ಇಸ್ರಾಯೇಲನಿಗೂ ಮಾತುಕೊಟ್ಟನು.<verse eid="PSA 105:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11"/>ಅವರಲ್ಲಿ ಸ್ವಲ್ಪ ಜನರು</para>
  <para style="q" vid="PSA 105:11">ಕಾನಾನ್ ದೇಶದಲ್ಲಿ ಪ್ರವಾಸಿಗಳಾಗಿ ಇರುವಾಗಲೇ,<verse eid="PSA 105:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12"/>ಆತನು, “ನಿಮಗೆ ಈ ದೇಶವನ್ನು ಕೊಡುವೆನು;</para>
  <para style="q" vid="PSA 105:12">ಅದು ನಿಮ್ಮ ಸಂತತಿಯವರಿಗೆ ಸ್ವತ್ತಾಗಿರುವುದು” ಎಂದು ಹೇಳಿದನು.<verse eid="PSA 105:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13"/>ಅವರು ದೇಶದಿಂದ ದೇಶಕ್ಕೂ, ರಾಜ್ಯದಿಂದ ರಾಜ್ಯಕ್ಕೂ ಹೋಗುತ್ತಿರುವಾಗ,<verse eid="PSA 105:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14"/>ಅವರಿಗೆ ಯಾರಿಂದಲೂ ಅನ್ಯಾಯವಾಗಗೊಡಿಸಲಿಲ್ಲ.</para>
  <para style="q" vid="PSA 105:14">ಆತನು ಅವರ ವಿಷಯದಲ್ಲಿ ಅರಸರನ್ನೂ ಗದರಿಸಿ,<verse eid="PSA 105:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15"/>“ನಾನು ಅಭಿಷೇಕಿಸಿದವರನ್ನು ಮುಟ್ಟಬಾರದು,</para>
  <para style="q" vid="PSA 105:15">ನನ್ನ ಪ್ರವಾದಿಗಳಿಗೆ ಯಾವ ಕೇಡನ್ನೂ ಮಾಡಬಾರದು” ಎಂದು ಹೇಳಿದನು.<verse eid="PSA 105:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16"/>ಅನಂತರ ಆತನು ಐಗುಪ್ತ ದೇಶದಲ್ಲಿ ಕ್ಷಾಮವನ್ನು ಬರಮಾಡಿ,</para>
  <para style="q" vid="PSA 105:16">
    <note caller="+" style="f">
      <char style="fr" closed="false">105:16 </char>
      <char style="ft" closed="false">ಅಥವಾ ಆಹಾರವೆಂಬ ಊರುಗೋಲನ್ನು ಮುರಿದುಬಿಟ್ಟನು. </char>
    </note>ಆಹಾರವನ್ನು ನಾಶಮಾಡಿಬಿಟ್ಟನು.<verse eid="PSA 105:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17"/>ಆತನು ಅವರ ಮುಂದಾಗಿ ಒಬ್ಬನನ್ನು ಕಳುಹಿಸಿದನು;</para>
  <para style="q" vid="PSA 105:17">ದಾಸತ್ವಕ್ಕೆ ಮಾರಲ್ಪಟ್ಟ ಯೋಸೇಫನೇ ಅವನು.<verse eid="PSA 105:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18"/>ಅವನ ಕಾಲುಗಳು ಬೇಡಿಗಳಿಂದ ಕಟ್ಟಲ್ಪಟ್ಟವು;</para>
  <para style="q" vid="PSA 105:18">ಕಬ್ಬಿಣದ ಕೊರಳಪಟ್ಟಿಯಿಂದ ಅವನು ಬಂಧಿತನಾದನು.<verse eid="PSA 105:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19"/>ಅವನು ತನ್ನ ಮಾತು ನೆರವೇರುವ ತನಕ</para>
  <para style="q" vid="PSA 105:19">ಯೆಹೋವನ ವಾಕ್ಯದಿಂದ ಶೋಧಿತನಾದನು.<verse eid="PSA 105:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20"/>ಅರಸನು ಅಪ್ಪಣೆಮಾಡಿ ಅವನನ್ನು ತಪ್ಪಿಸಿದನು;</para>
  <para style="q" vid="PSA 105:20">ಜನಾಧಿಪತಿಯು ಅವನನ್ನು ಬಿಡಿಸಿದನು.<verse eid="PSA 105:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21"/>ಅವನನ್ನು ತನ್ನ ಮನೆಗೆ ಯಜಮಾನನನ್ನಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 105:21">ತನ್ನ ಆಸ್ತಿಗೆಲ್ಲಾ ಅಧಿಕಾರಿಯನ್ನಾಗಿಯೂ ಮಾಡಿದನು.<verse eid="PSA 105:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22"/>ತನ್ನ ಪ್ರಧಾನರನ್ನು ಇಷ್ಟಾನುಸಾರವಾಗಿ ಬಂಧಿಸುವುದಕ್ಕೂ,</para>
  <para style="q" vid="PSA 105:22">ತನ್ನ ಮಂತ್ರಿಗಳಿಗೆ ಬುದ್ಧಿಕಲಿಸುವುದಕ್ಕೂ ಅವನಿಗೆ ಅಧಿಕಾರಕೊಟ್ಟನು.<verse eid="PSA 105:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23"/>ಆಗ ಇಸ್ರಾಯೇಲನು ಐಗುಪ್ತಕ್ಕೆ ಬಂದನು;</para>
  <para style="q" vid="PSA 105:23">ಯಾಕೋಬನು ಹಾಮನ ದೇಶದಲ್ಲಿ ಪ್ರವಾಸಿಯಾದನು.<verse eid="PSA 105:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24"/>ದೇವರು ತನ್ನ ಜನರನ್ನು ಬಹಳವಾಗಿ ವೃದ್ಧಿಮಾಡಿ,</para>
  <para style="q" vid="PSA 105:24">ಅವರು ಶತ್ರುಗಳಿಗಿಂತ ಬಲಿಷ್ಠರಾಗುವಂತೆ ಮಾಡಿದನು.<verse eid="PSA 105:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25"/>ಆತನು ಆ ದೇಶದವರ ಹೃದಯವನ್ನು ಮಾರ್ಪಡಿಸಿದ್ದರಿಂದ,</para>
  <para style="q" vid="PSA 105:25">ಅವರು ಆತನ ಜನರನ್ನು ದ್ವೇಷಿಸಿ, ಆತನ ಸೇವಕರನ್ನು ಕುಯುಕ್ತಿಯಿಂದ ನಡೆಸಿದರು.<verse eid="PSA 105:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26"/>ಆಗ ಆತನು ತನ್ನ ಸೇವಕನಾದ ಮೋಶೆಯನ್ನೂ,</para>
  <para style="q" vid="PSA 105:26">ತಾನು ಆರಿಸಿಕೊಂಡ ಆರೋನನನ್ನೂ ಕಳುಹಿಸಿದನು.<verse eid="PSA 105:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27"/>ಅವರು ಹಾಮನ ದೇಶದವರ ಮಧ್ಯದಲ್ಲಿ,</para>
  <para style="q" vid="PSA 105:27">ಆತನು ಆಜ್ಞಾಪಿಸಿದ ವಿವಿಧ ಮಹತ್ಕಾರ್ಯಗಳನ್ನೂ, ಅದ್ಭುತಗಳನ್ನೂ ನಡೆಸಿದರು.<verse eid="PSA 105:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28"/>ಆತನು ಕತ್ತಲೆಯನ್ನು ಕಳುಹಿಸಲು ಕತ್ತಲೆಯಾಯಿತು.</para>
  <para style="q" vid="PSA 105:28">ಐಗುಪ್ತ್ಯರು ಆತನ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸಲಿಲ್ಲ.<verse eid="PSA 105:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29"/>ಆತನು ಐಗುಪ್ತ್ಯರ ನೀರನ್ನು ರಕ್ತಮಾಡಿ, ಮೀನುಗಳನ್ನು ಸಾಯಿಸಿದನು.<verse eid="PSA 105:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30"/>ಅವರ ದೇಶದಲ್ಲೆಲ್ಲಾ ಕಪ್ಪೆಗಳು ತುಂಬಿಕೊಂಡವು;</para>
  <para style="q" vid="PSA 105:30">ಅರಮನೆಯಲ್ಲಿಯೂ ವ್ಯಾಪಿಸಿಕೊಂಡವು.<verse eid="PSA 105:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31"/>ಆತನು ಆಜ್ಞಾಪಿಸಲು ಅವರ ಎಲ್ಲಾ ಪ್ರಾಂತ್ಯಗಳಲ್ಲಿ,</para>
  <para style="q" vid="PSA 105:31">ವಿಷದ ಹುಳಗಳೂ, ಹೇನುಗಳೂ ಉಂಟಾದವು.<verse eid="PSA 105:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32"/>ಆತನು ಅವರ ದೇಶದಲ್ಲಿ ಕಲ್ಮಳೆಯನ್ನು, ಅಗ್ನಿಜ್ವಾಲೆಯನ್ನು ಬರಮಾಡಿ,<verse eid="PSA 105:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33"/>ಅವರ ದ್ರಾಕ್ಷಾಲತೆಗಳನ್ನು, ಅಂಜೂರದ ಗಿಡಗಳನ್ನು ನಾಶಮಾಡಿ,</para>
  <para style="q" vid="PSA 105:33">ಅವರ ಪ್ರಾಂತ್ಯಗಳಲ್ಲಿದ್ದ ಮರಗಳನ್ನು ಮುರಿದುಬಿಟ್ಟನು.<verse eid="PSA 105:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34"/>ಆತನು ಆಜ್ಞಾಪಿಸಲು ಮಿಡತೆಗಳೂ,</para>
  <para style="q" vid="PSA 105:34">ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಜಿಟ್ಟೆಹುಳಗಳೂ ಬಂದು,<verse eid="PSA 105:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35"/>ಅವರ ದೇಶದಲ್ಲಿದ್ದ ಎಲ್ಲಾ ಪೈರುಗಳನ್ನು,</para>
  <para style="q" vid="PSA 105:35">ಭೂಮಿಯ ಬೆಳೆಗಳನ್ನು ತಿಂದುಬಿಟ್ಟವು.<verse eid="PSA 105:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36"/>ಅವನು ಆ ದೇಶದವರ ವೀರ್ಯಕ್ಕೆ ಪ್ರಥಮಫಲವಾಗಿದ್ದ,</para>
  <para style="q" vid="PSA 105:36">ಚೊಚ್ಚಲ ಮಕ್ಕಳನ್ನು ಸಂಹರಿಸಿದನು.<verse eid="PSA 105:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37"/>ಇಸ್ರಾಯೇಲರನ್ನು ಬೆಳ್ಳಿ, ಬಂಗಾರಗಳ ಸಹಿತವಾಗಿ ಹೊರಗೆ ಬರಮಾಡಿದನು;</para>
  <para style="q" vid="PSA 105:37">ಅವರ ಕುಲಗಳಲ್ಲಿ ಎಡವುವವನು ಒಬ್ಬನಾದರೂ ಇರಲಿಲ್ಲ.<verse eid="PSA 105:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38"/>ಐಗುಪ್ತ್ಯರು ಅವರ ವಿಷಯದಲ್ಲಿ ಹೆದರಿಕೆಯುಳ್ಳವರಾದ್ದರಿಂದ,</para>
  <para style="q" vid="PSA 105:38">ಅವರು ಹೊರಟು ಹೋದದ್ದಕ್ಕೆ ಸಂತೋಷಿಸಿದರು.<verse eid="PSA 105:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39"/>ಅವರಿಗೆ ಹಗಲಲ್ಲಿ ನೆರಳಿಗೋಸ್ಕರ ಮೋಡವನ್ನು,</para>
  <para style="q" vid="PSA 105:39">ಇರುಳಲ್ಲಿ ಬೆಳಕಿಗೋಸ್ಕರ ಬೆಂಕಿಯನ್ನು ಮೇಲೆ ಹರಡಿದನು.<verse eid="PSA 105:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40"/>ಅವರು ಬೇಡಿಕೊಳ್ಳಲು ಲಾವಕ್ಕಿಗಳನ್ನು ಬರಮಾಡಿದನು;</para>
  <para style="q" vid="PSA 105:40">ದಿವ್ಯ ಆಹಾರದಿಂದ ಅವರನ್ನು ತೃಪ್ತಿಗೊಳಿಸಿದನು.<verse eid="PSA 105:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41"/>ಆತನು ಬಂಡೆಯನ್ನು ಸೀಳಲು ನೀರು ಚಿಮ್ಮಿ ಬಂದು,</para>
  <para style="q" vid="PSA 105:41">ಅರಣ್ಯದಲ್ಲಿ ನದಿಯಾಗಿ ಹರಿಯಿತು.<verse eid="PSA 105:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42"/>ಹೀಗೆ ಆತನು ತನ್ನ ಪರಿಶುದ್ಧ ವಚನವನ್ನೂ,</para>
  <para style="q" vid="PSA 105:42">ತನ್ನ ಸೇವಕನಾದ ಅಬ್ರಹಾಮನನ್ನೂ ನೆನಪುಮಾಡಿಕೊಂಡು<verse eid="PSA 105:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43"/>ತನ್ನ ಪ್ರಜೆಯು ಉಲ್ಲಾಸದಿಂದಲೂ,</para>
  <para style="q" vid="PSA 105:43">ತಾನು ಆರಿಸಿಕೊಂಡವರು ಉತ್ಸಾಹಧ್ವನಿಯಿಂದಲೂ ಹೊರಗೆ ಬರುವಂತೆ ಮಾಡಿದನು.<verse eid="PSA 105:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44"/>ಆತನು ಅವರಿಗೆ ಪರಜನಾಂಗಗಳ ದೇಶವನ್ನು ಕೊಟ್ಟನು;</para>
  <para style="q" vid="PSA 105:44">ಅನ್ಯಜನಾಂಗಗಳ ಕಷ್ಟಾರ್ಜಿತವು ಅವರ ಕೈ ಸೇರಿತು.<verse eid="PSA 105:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45"/>ಅವರು ತನ್ನ ವಿಧಿಗಳನ್ನು ಕೈಕೊಂಡು,</para>
  <para style="q" vid="PSA 105:45">ತನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಅನುಸರಿಸಬೇಕೆಂಬುದೇ ಆತನ ಉದ್ದೇಶವಾಗಿತ್ತು.</para>
  <para style="q" vid="PSA 105:45">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="s">ಯೆಹೋವನ ಕ್ಷಮಾಯಾಚನೆ</para>
  <para style="r">
    <ref loc="PSA 78">ಕೀರ್ತ 78</ref>; <ref loc="PSA 105">105</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ! ಯೆಹೋವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ.</para>
  <para style="q" vid="PSA 106:1">ಆತನು ಒಳ್ಳೆಯವನು. ಆತನ ಕೃಪೆಯು ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="PSA 106:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2"/>ಯೆಹೋವನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಯಾರು ವರ್ಣಿಸಬಲ್ಲರು?</para>
  <para style="q" vid="PSA 106:2">ಆತನನ್ನು ತಕ್ಕಂತೆ ಕೀರ್ತಿಸುವುದು ಯಾರಿಂದಾದೀತು?<verse eid="PSA 106:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3"/>ಯಾವಾಗಲೂ ನ್ಯಾಯವನ್ನು ಕಾಪಾಡುವವರೂ,</para>
  <para style="q" vid="PSA 106:3">ನೀತಿಯನ್ನು ಪಾಲಿಸುವವರೂ ಧನ್ಯರು.<verse eid="PSA 106:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4"/>ಯೆಹೋವನೇ, ನನ್ನನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 106:4">ನಿನ್ನ ಪ್ರಜೆಗೆ ತೋರಿಸುವ ದಯೆಯನ್ನು ನನಗೂ ತೋರಿಸು.</para>
  <para style="q" vid="PSA 106:4">ನನ್ನನ್ನು ರಕ್ಷಿಸಲಿಕ್ಕೆ ಬಾ,<verse eid="PSA 106:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5"/>ಆಗ ನೀನು ಆರಿಸಿಕೊಂಡ ಪ್ರಜೆಯ ಏಳಿಗೆಯನ್ನು ನೋಡಿ,</para>
  <para style="q" vid="PSA 106:5">ನಾನೂ ಅವರೊಂದಿಗೆ ಸಂತೋಷಿಸುವೆನು;</para>
  <para style="q" vid="PSA 106:5">ನಿನ್ನ ಸ್ವಕೀಯರೊಂದಿಗೆ ನಾನೂ ಹಿಗ್ಗುವೆನು.<verse eid="PSA 106:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6"/>ನಮ್ಮ ಪೂರ್ವಿಕರಂತೆ ನಾವೂ ಪಾಪಿಗಳು;</para>
  <para style="q" vid="PSA 106:6">ಅಪರಾಧಮಾಡಿದೆವು; ದುಷ್ಟತನವನ್ನು ನಡೆಸಿದೆವು.<verse eid="PSA 106:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7"/>ನಮ್ಮ ಪೂರ್ವಿಕರು ಐಗುಪ್ತದಲ್ಲಿ ನಿನ್ನ ಅದ್ಭುತಕ್ರಿಯೆಗಳನ್ನು ಲಕ್ಷಿಸಲಿಲ್ಲ;</para>
  <para style="q" vid="PSA 106:7">ನಿನ್ನ ಕೃಪಾತಿಶಯವನ್ನು ಸ್ಮರಿಸಲಿಲ್ಲ.</para>
  <para style="q" vid="PSA 106:7">ಅವರು ಕೆಂಪು ಸಮುದ್ರದ ಬಳಿಯಲ್ಲಿ ನಿನಗೆ ತಿರುಗಿಬಿದ್ದರು.<verse eid="PSA 106:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8"/>ಆದರೂ ಆತನು ತನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತವಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 106:8">ತನ್ನ ಶೌರ್ಯವನ್ನು ಪ್ರಕಟಿಸುವುದಕ್ಕಾಗಿಯೂ ಅವರನ್ನು ರಕ್ಷಿಸಿದನು.<verse eid="PSA 106:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9"/>ಆತನು ಗದರಿಸಲು ಕೆಂಪು ಸಮುದ್ರವು ಒಣಗಿಹೋಯಿತು;</para>
  <para style="q" vid="PSA 106:9">ಅಡವಿಯನ್ನೋ ಎಂಬಂತೆ ಸಾಗರವನ್ನು ದಾಟಿಸಿದನು.<verse eid="PSA 106:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10"/>ಹಗೆಗಳ ಕೈಯಿಂದ ಅವರನ್ನು ತಪ್ಪಿಸಿದನು;</para>
  <para style="q" vid="PSA 106:10">ವೈರಿಯ ಹಸ್ತದಿಂದ ಬಿಡಿಸಿದನು.<verse eid="PSA 106:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11"/>ಜಲರಾಶಿಯು ಅವರ ವಿರೋಧಿಗಳನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟಿತು;</para>
  <para style="q" vid="PSA 106:11">ಒಬ್ಬನೂ ಉಳಿಯಲಿಲ್ಲ.<verse eid="PSA 106:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12"/>ಆಗ ಅವರು ಆತನ ಮಾತನ್ನು ನಂಬಿ ಆತನನ್ನು ಕೀರ್ತಿಸಿದರು.<verse eid="PSA 106:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13"/>ಆದರೆ ಅವರು ಬೇಗನೆ ಆತನ ಕೆಲಸಗಳನ್ನು ಮರೆತು,</para>
  <para style="q" vid="PSA 106:13">ಆತನ ನಡೆಸುವಿಕೆಗೆ ಕಾದಿರದೆ,<verse eid="PSA 106:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14"/>ಅರಣ್ಯದಲ್ಲಿ ಅತಿ ಆಶೆಗೊಂಡವರಾಗಿ,</para>
  <para style="q" vid="PSA 106:14">ಅಡವಿಯಲ್ಲಿ ದೇವರನ್ನು ಪರೀಕ್ಷಿಸಿದರು.<verse eid="PSA 106:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15"/>ಆತನು ಅವರ ಆಶೆಯನ್ನು ಪೂರೈಸಿದರೂ,</para>
  <para style="q" vid="PSA 106:15">ಅವರ ಪ್ರಾಣಕ್ಕೆ ಕ್ಷಯವನ್ನು ಬರಮಾಡಿದನು.<verse eid="PSA 106:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16"/>ಅವರು ಪಾಳೆಯದಲ್ಲಿ ಮೋಶೆಯ ಮೇಲೆಯೂ,</para>
  <para style="q" vid="PSA 106:16">ಯೆಹೋವನು ಪ್ರತಿಷ್ಠಿಸಿದ ಆರೋನನ ಮೇಲೆಯೂ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಲು,<verse eid="PSA 106:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17"/>ಭೂಮಿಯು ಬಾಯ್ದೆರೆದು ದಾತಾನನನ್ನು ನುಂಗಿಬಿಟ್ಟಿತು;</para>
  <para style="q" vid="PSA 106:17">ಅಬಿರಾಮನ ಕಡೆಯವರನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟಿತು.<verse eid="PSA 106:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18"/>ಅವರ ಮಧ್ಯದಲ್ಲಿ ಬೆಂಕಿಯುಂಟಾಯಿತು;</para>
  <para style="q" vid="PSA 106:18">ಅಗ್ನಿಜ್ವಾಲೆಯು ದುಷ್ಟರನ್ನು ದಹಿಸಿಬಿಟ್ಟಿತು.<verse eid="PSA 106:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19"/>ಹೋರೇಬಿನಲ್ಲಿ ಎರಕದ ಬಸವನನ್ನು ಮಾಡಿ,</para>
  <para style="q" vid="PSA 106:19">ಅದಕ್ಕೆ ಅಡ್ಡಬಿದ್ದರು.<verse eid="PSA 106:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20"/>ಹೀಗೆ ಅವರು ತಮ್ಮ ದಿವ್ಯಮಹಿಮೆಯ ದೇವರನ್ನು ಬಿಟ್ಟು,</para>
  <para style="q" vid="PSA 106:20">ಹುಲ್ಲು ತಿನ್ನುವ ಎತ್ತಿನ ಮೂರ್ತಿಯನ್ನು ಹಿಡಿದುಕೊಂಡರು.<verse eid="PSA 106:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21"/>ಐಗುಪ್ತದಲ್ಲಿ ಮಹತ್ತುಗಳನ್ನೂ, ಹಾಮನ ದೇಶದಲ್ಲಿ ಅದ್ಭುತಗಳನ್ನೂ,<verse eid="PSA 106:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22"/>ಕೆಂಪು ಸಮುದ್ರದ ಬಳಿಯಲ್ಲಿ ಘೋರಕೃತ್ಯಗಳನ್ನೂ ನಡೆಸಿದ,</para>
  <para style="q" vid="PSA 106:22">ತಮ್ಮ ರಕ್ಷಕನಾದ ದೇವರನ್ನು ಮರೆತೇ ಬಿಟ್ಟರು.<verse eid="PSA 106:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23"/>ಆದುದರಿಂದ ಆತನು ಅವರನ್ನು ಸಂಹರಿಸುವೆನು ಎನ್ನಲು,</para>
  <para style="q" vid="PSA 106:23">ಆತನು ಆರಿಸಿಕೊಂಡ ಮೋಶೆಯು ಮಧ್ಯಸ್ಥನಾಗಿ,</para>
  <para style="q" vid="PSA 106:23">ಅವರನ್ನು ಸಂಹರಿಸದಂತೆ ಆತನ ಕೋಪವನ್ನು ಶಾಂತಪಡಿಸಿದನು.<verse eid="PSA 106:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24"/>ಅವರು ಆ ರಮಣೀಯ ದೇಶವನ್ನು ತಿರಸ್ಕರಿಸಿದರು,</para>
  <para style="q" vid="PSA 106:24">ಆತನ ಮಾತನ್ನು ನಂಬಲಿಲ್ಲ.<verse eid="PSA 106:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25"/>ತಮ್ಮ ತಮ್ಮ ಗುಡಾರಗಳಲ್ಲಿ ಗುಣುಗುಟ್ಟಿ,</para>
  <para style="q" vid="PSA 106:25">ಯೆಹೋವನ ಮಾತಿಗೆ ಕಿವಿಗೊಡಲಿಲ್ಲ.<verse eid="PSA 106:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26"/>ಇದರಿಂದ ಆತನು ಅವರನ್ನು ಅರಣ್ಯದಲ್ಲಿಯೇ ಬೀಳಿಸುವೆನೆಂದೂ,<verse eid="PSA 106:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27"/>ಅವರ ಸಂತಾನವನ್ನು ದೇಶಾಂತರಗಳಲ್ಲಿ ಚದುರಿಸಿ,</para>
  <para style="q" vid="PSA 106:27">ಅನ್ಯಜನಾಂಗಗಳ ನಡುವೆ ನಾಶಮಾಡುವೆನೆಂದೂ ಕೈಯೆತ್ತಿದನು.<verse eid="PSA 106:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28"/>ಅವರು ತಮ್ಮನ್ನು ಬಾಳ್ ಪೆಗೋರನ ಸೇವೆಗೆ ಒಪ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 106:28">ಮೂರ್ತಿಗಳಿಗೆ ಯಜ್ಞ ಮಾಡಿದ್ದನ್ನು ಊಟಮಾಡಿದರು.<verse eid="PSA 106:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29"/>ಈ ತಮ್ಮ ಕ್ರಿಯೆಗಳಿಂದ ಆತನನ್ನು ಕೆಣಕಿದರು;</para>
  <para style="q" vid="PSA 106:29">ಅವರಲ್ಲಿ ವ್ಯಾಧಿಯುಂಟಾಯಿತು.<verse eid="PSA 106:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30"/>ಫೀನೆಹಾಸನು ಎದ್ದು ಅವರನ್ನು ದಂಡಿಸಲು,</para>
  <para style="q" vid="PSA 106:30">ಆ ವ್ಯಾಧಿಯು ನಿಂತುಹೋಯಿತು.<verse eid="PSA 106:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31"/>ಅವನು ಮಾಡಿದ್ದು ತಲಾತಲಾಂತರಕ್ಕೂ ನೀತಿಯೆಂದು ಎಣಿಸಲ್ಪಟ್ಟಿತು.<verse eid="PSA 106:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32"/>ಅವರು ಮೆರೀಬ ಪ್ರವಾಹದ ಸಮೀಪದಲ್ಲಿ ಆತನನ್ನು ರೇಗಿಸಿದರು.</para>
  <para style="q" vid="PSA 106:32">ಅವರ ದೆಸೆಯಿಂದ ಮೋಶೆಗೆ ಕೇಡು ಉಂಟಾಯಿತು.<verse eid="PSA 106:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33"/>ಅವರು ದೇವರಾತ್ಮನಿಗೆ ವಿರುದ್ಧವಾಗಿ ನಿಂತಿದ್ದರಿಂದ,</para>
  <para style="q" vid="PSA 106:33">ಮೋಶೆ ದುಡುಕಿ ಮಾತನಾಡಿದನು.<verse eid="PSA 106:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34"/>ಅನ್ಯ ಜನಾಂಗದವರನ್ನು ಸಂಹರಿಸಬೇಕೆಂಬ,</para>
  <para style="q" vid="PSA 106:34">ಯೆಹೋವನ ಆಜ್ಞೆಗೆ ಅವಿಧೇಯರಾಗಿ,<verse eid="PSA 106:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35"/>ಅವರೊಡನೆ ಕೂಡಿಕೊಂಡು, ಅವರ ದುರಾಚಾರಗಳನ್ನು ಕಲಿತುಕೊಂಡರು.<verse eid="PSA 106:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36"/>ಅವರ ವಿಗ್ರಹಗಳನ್ನು ಸೇವಿಸಿದರು; ಅವು ಅವರಿಗೆ ಉರುಲಿನಂತಾದವು.<verse eid="PSA 106:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37"/>ಅವರು ತಮ್ಮ ಗಂಡು ಹೆಣ್ಣು ಮಕ್ಕಳನ್ನು ಭೂತಗಳಿಗೆ ಬಲಿಕೊಟ್ಟರು.<verse eid="PSA 106:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38"/>ಕಾನಾನ್ಯರ ಮೂರ್ತಿಗಳ ಅರ್ಪಣೆಗೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 106:38">ತಮ್ಮ ಮಕ್ಕಳ ನಿರಪರಾಧ ರಕ್ತವನ್ನು ಸುರಿಸಿದರು;</para>
  <para style="q" vid="PSA 106:38">ಇಂಥ ಕೊಲೆಗಳಿಂದ ದೇಶವನ್ನು ಹೊಲೆಮಾಡಿದರು.<verse eid="PSA 106:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39"/>ಅವರು ತಮ್ಮ ದುಷ್ಕೃತ್ಯಗಳಿಂದ ಅಶುದ್ಧರಾದರು.</para>
  <para style="q" vid="PSA 106:39">ದುರಾಚಾರಗಳಿಂದ ದೇವದ್ರೋಹಿಗಳಾದರು.<verse eid="PSA 106:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40"/>ಆಗ ಯೆಹೋವನ ಕೋಪವು ಅವರ ಮೇಲೆ ಉರಿಗೊಂಡಿತು;</para>
  <para style="q" vid="PSA 106:40">ಆತನು ತನ್ನ ಸ್ವಾಸ್ತ್ಯವಾದ ಪ್ರಜೆಗಳನ್ನು ಅಸಹ್ಯಿಸಿ,<verse eid="PSA 106:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41"/>ಅವರನ್ನು ಅನ್ಯಜನಾಂಗಗಳ ಕೈಗೆ ಒಪ್ಪಿಸಿದನು.</para>
  <para style="q" vid="PSA 106:41">ವೈರಿಗಳು ಅವರ ಮೇಲೆ ಅಧಿಕಾರ ನಡೆಸಿದರು;<verse eid="PSA 106:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42"/>ಶತ್ರುಗಳು ಅವರನ್ನು ಕುಗ್ಗಿಸಿದರು; ಅವರ ಕೈಕೆಳಗೆ ತಗ್ಗಿಹೋದರು.<verse eid="PSA 106:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43"/>ಆತನು ಅವರನ್ನು ಅನೇಕಾವರ್ತಿ ರಕ್ಷಿಸಿದರೂ,</para>
  <para style="q" vid="PSA 106:43">ಅವರು ತಮ್ಮ ಆಲೋಚನೆಯನ್ನೇ ಅನುಸರಿಸಿ ಅವಿಧೇಯರಾದರು;</para>
  <para style="q" vid="PSA 106:43">ತಮ್ಮ ಅಕ್ರಮದಿಂದಲೇ ಹೀನಸ್ಥಿತಿಗೆ ಬಂದರು.<verse eid="PSA 106:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44"/>ಆದರೆ ಆತನು ಕಷ್ಟದಲ್ಲಿದ್ದ,</para>
  <para style="q" vid="PSA 106:44">ಅವರ ಮೊರೆಯನ್ನು ಕೇಳಿ ಪರಾಂಬರಿಸಿದನು.<verse eid="PSA 106:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45"/>ತನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 106:45">ತನ್ನ ಕೃಪಾತಿಶಯದಿಂದ ಅವರನ್ನು ಕನಿಕರಿಸಿದನು.<verse eid="PSA 106:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46"/>ಸೆರೆಯೊಯ್ದವರ ದಯೆಗೆ ಅವರು ಪಾತ್ರರಾಗುವಂತೆ ಮಾಡಿದನು.<verse eid="PSA 106:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47"/>ಯೆಹೋವನೇ, ನಮ್ಮ ದೇವರೇ, ರಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 106:47">ಅನ್ಯಜನಗಳಲ್ಲಿ ಚದರಿರುವ ನಮ್ಮನ್ನು ತಿರುಗಿ ಕೂಡಿಸು.</para>
  <para style="q" vid="PSA 106:47">ಆಗ ನಿನ್ನ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು ಕೊಂಡಾಡುವೆವು;</para>
  <para style="q" vid="PSA 106:47">ನಿನ್ನ ಸ್ತೋತ್ರದಲ್ಲಿ ಹೆಚ್ಚಳಪಡುವೆವು.<verse eid="PSA 106:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48"/>ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವನಿಗೆ,</para>
  <para style="q" vid="PSA 106:48">ಯುಗಯುಗಾಂತರಗಳವರೆಗೂ ಕೊಂಡಾಟವಾಗಲಿ;</para>
  <para style="q" vid="PSA 106:48">ಸರ್ವಜನರೂ “ಆಮೆನ್” ಎನ್ನಲಿ.</para>
  <para style="q" vid="PSA 106:48">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">ಪಂಚಮ ಭಾಗ (107-150)</para>
  <para style="s">ವಿಮುಕ್ತರ ಕೊಂಡಾಟ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1"/>ಯೆಹೋವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 107:1">ಆತನು ಒಳ್ಳೆಯವನು.</para>
  <para style="q" vid="PSA 107:1">ಆತನ ಕೃಪೆಯು ಶಾಶ್ವತವಾಗಿರುವುದು.<verse eid="PSA 107:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2"/>ಯೆಹೋವನ ವಿಮುಕ್ತರು ಅಂದರೆ ಆತನು ಶತ್ರುಗಳಿಂದ ಬಿಡಿಸಿ,<verse eid="PSA 107:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3"/>ಪೂರ್ವ, ಪಶ್ಚಿಮ, ಉತ್ತರ ಮತ್ತು ದಕ್ಷಿಣಗಳಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 107:3">ಸಮುದ್ರದ ಕಡೆಯಲ್ಲಿಯೂ ಇರುವ ದೇಶಗಳಿಂದ ಕೂಡಿಸಿದವರೆಲ್ಲರೂ ಸ್ತುತಿಮಾಡಲಿ.<verse eid="PSA 107:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4"/>ಅವರು ಅರಣ್ಯದಲ್ಲಿಯೂ, ಮರಳುಗಾಡಿನಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 107:4">ದಾರಿತಪ್ಪಿ ಅಲೆಯುವವರಾಗಿ,</para>
  <para style="q" vid="PSA 107:4">ಜನವಿರುವ ಊರನ್ನು ಕಾಣದೆ,<verse eid="PSA 107:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5"/>ಹಸಿವೆ, ನೀರಡಿಕೆಗಳಿಂದ ಬಲಗುಂದಿದವರಾಗಿದ್ದರು.<verse eid="PSA 107:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6"/>ಅವರು ತಮ್ಮ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡಲು,</para>
  <para style="q" vid="PSA 107:6">ಆತನು ಅವರನ್ನು ಕಷ್ಟದಿಂದ ಬಿಡಿಸಿದನು.<verse eid="PSA 107:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7"/>ಜನವಿರುವ ಊರನ್ನು ಸೇರುವಂತೆ,</para>
  <para style="q" vid="PSA 107:7">ಅವರನ್ನು ಸರಿಯಾದ ದಾರಿಯಲ್ಲಿ ನಡೆಸಿದನು.<verse eid="PSA 107:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8"/>ಅವರು ಯೆಹೋವನ ಕೃಪೆಗೋಸ್ಕರವೂ,</para>
  <para style="q" vid="PSA 107:8">ಆತನು ಮಾನವರಿಗಾಗಿ ನಡೆಸಿದ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ,</para>
  <para style="q" vid="PSA 107:8">ಆತನನ್ನು ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9"/>ಆತನು ಬಾಯಾರಿದವರ ಆಶೆಯನ್ನು ಪೂರೈಸಿ,</para>
  <para style="q" vid="PSA 107:9">ಹಸಿದವರನ್ನು ಮೃಷ್ಟಾನ್ನದಿಂದ ತೃಪ್ತಿಗೊಳಿಸುತ್ತಾನೆ.<verse eid="PSA 107:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10"/>ಕತ್ತಲಲ್ಲಿಯೂ, ಘೋರಾಂಧಕಾರದಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 107:10">ಬೇಡಿಗಳಿಂದ ಬಂಧಿಸಲ್ಪಟ್ಟು, ನೋವಿನಿಂದ ಬಿದ್ದುಕೊಂಡಿದ್ದರು.<verse eid="PSA 107:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11"/>ಅವರು ದೇವರ ಕಟ್ಟಳೆಗಳಿಗೆ ವಿರುದ್ಧವಾಗಿ ನಿಂತು,</para>
  <para style="q" vid="PSA 107:11">ಪರಾತ್ಪರನಾದ ದೇವರ ಸಂಕಲ್ಪವನ್ನು ನಿರಾಕರಿಸಿದ್ದರಿಂದ,<verse eid="PSA 107:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12"/>ಆತನು ಅವರನ್ನು ಕಷ್ಟಗಳಿಂದ ಕುಗ್ಗಿಸಿದನು;</para>
  <para style="q" vid="PSA 107:12">ನಿರಾಶ್ರಯರಾಗಿ ಬಿದ್ದುಹೋದರು.<verse eid="PSA 107:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13"/>ಅವರು ತಮ್ಮ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡಲು,</para>
  <para style="q" vid="PSA 107:13">ಆತನು ಅವರನ್ನು ಕಷ್ಟದಿಂದ ತಪ್ಪಿಸಿದನು.<verse eid="PSA 107:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14"/>ಆತನು ಅವರ ಬಂಧನಗಳನ್ನು ತೆಗೆದುಹಾಕಿ,</para>
  <para style="q" vid="PSA 107:14">ಕತ್ತಲೆಯಿಂದಲೂ, ಘೋರಾಂಧಕಾರದಿಂದಲೂ ಅವರನ್ನು ಹೊರತಂದನು.<verse eid="PSA 107:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15"/>ಅವರು ಯೆಹೋವನ ಕೃಪೆಗೋಸ್ಕರವೂ,</para>
  <para style="q" vid="PSA 107:15">ಆತನು ಮಾನವರಿಗಾಗಿ ನಡೆಸಿದ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ,</para>
  <para style="q" vid="PSA 107:15">ಆತನನ್ನು ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16"/>ಆತನು ತಾಮ್ರದ ಕದಗಳನ್ನು ಒಡೆದು,</para>
  <para style="q" vid="PSA 107:16">ಕಬ್ಬಿಣದ ಅಗುಳಿಗಳನ್ನು ಮುರಿದುಬಿಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 107:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17"/>ಮೂರ್ಖರು ಅಪರಾಧ, ದುರಾಚಾರಗಳ ದೆಸೆಯಿಂದ ಬಾಧೆಗೊಳಗಾದರು.<verse eid="PSA 107:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18"/>ಎಲ್ಲಾ ಆಹಾರಕ್ಕೂ ಅಸಹ್ಯಪಟ್ಟು ಮರಣದ್ವಾರಕ್ಕೆ ಸಮೀಪವಾದರು.<verse eid="PSA 107:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19"/>ಅವರು ತಮ್ಮ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡಲು,</para>
  <para style="q" vid="PSA 107:19">ಆತನು ಅವರನ್ನು ಕಷ್ಟದಿಂದ ತಪ್ಪಿಸಿದನು.<verse eid="PSA 107:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20"/>ಆತನು ದೂತನನ್ನೋ ಎಂಬಂತೆ ತನ್ನ ವಾಕ್ಯವನ್ನು ಕಳುಹಿಸಿ,</para>
  <para style="q" vid="PSA 107:20">ಅವರನ್ನು ಗುಣಪಡಿಸಿದನು;</para>
  <para style="q" vid="PSA 107:20">ಸಮಾಧಿಗೆ ಸೇರದಂತೆ ಮಾಡಿದನು.<verse eid="PSA 107:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21"/>ಅವರು ಯೆಹೋವನ ಕೃಪೆಗೋಸ್ಕರವೂ,</para>
  <para style="q" vid="PSA 107:21">ಆತನು ಮಾನವರಿಗಾಗಿ ನಡೆಸಿದ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ,</para>
  <para style="q" vid="PSA 107:21">ಆತನನ್ನು ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22"/>ಕೃತಜ್ಞತಾ ಯಜ್ಞಗಳನ್ನು ಸಮರ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 107:22">ಉತ್ಸಾಹಧ್ವನಿಮಾಡುತ್ತಾ</para>
  <para style="q" vid="PSA 107:22">ಆತನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ವರ್ಣಿಸಲಿ.<verse eid="PSA 107:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23"/>ಹಡಗು ಹತ್ತಿ ಸಮುದ್ರ ಪ್ರಯಾಣ ಮಾಡುತ್ತಾ,</para>
  <para style="q" vid="PSA 107:23">ಮಹಾಜಲರಾಶಿಯಲ್ಲಿ ತಮ್ಮ ಉದ್ಯೋಗವನ್ನು ನಡೆಸುವವರು,<verse eid="PSA 107:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24"/>ಯೆಹೋವನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನೂ,</para>
  <para style="q" vid="PSA 107:24">ಅಗಾಧಜಲದಲ್ಲಿ ಆತನ ಅದ್ಭುತಗಳನ್ನೂ ನೋಡುತ್ತಾರೆ.<verse eid="PSA 107:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25"/>ಆತನು ಅಪ್ಪಣೆಕೊಡಲು ಬಿರುಗಾಳಿಯುಂಟಾಗಿ,</para>
  <para style="q" vid="PSA 107:25">ಅದರಲ್ಲಿ ತೆರೆಗಳನ್ನು ಎಬ್ಬಿಸಿತು.<verse eid="PSA 107:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26"/>ಜನರು<note caller="+" style="f"><char style="fr" closed="false">107:26 </char><char style="fq" closed="false">ಜನರು </char><char style="ft" closed="false">ಅಥವಾ ನಾವಿಕರು.</char></note> ಆಕಾಶಕ್ಕೆ ಏರುತ್ತಲೂ,</para>
  <para style="q" vid="PSA 107:26">ಅಗಾಧಕ್ಕೆ ಇಳಿಯುತ್ತಲೂ ಕಂಗೆಟ್ಟು ಕರಗಿಹೋದರು.<verse eid="PSA 107:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27"/>ಅವರು ದಿಕ್ಕುತೋರದವರಾಗಿ ಸುತ್ತುತ್ತಾ,</para>
  <para style="q" vid="PSA 107:27">ಕುಡುಕರಂತೆ ಹೊಯ್ದಾಡುತ್ತಿದ್ದರು.<verse eid="PSA 107:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28"/>ಅವರು ತಮ್ಮ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡಲು,</para>
  <para style="q" vid="PSA 107:28">ಆತನು ಅವರನ್ನು ಕಷ್ಟದಿಂದ ಹೊರತಂದನು.<verse eid="PSA 107:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29"/>ಆತನು ಬಿರುಗಾಳಿಯನ್ನು ಶಾಂತಪಡಿಸಿದನು;</para>
  <para style="q" vid="PSA 107:29">ತೆರೆಗಳು ನಿಂತವು.<verse eid="PSA 107:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30"/>ಸಮುದ್ರವು ಶಾಂತವಾದುದರಿಂದ,</para>
  <para style="q" vid="PSA 107:30">ಹಡಗಿನವರು ಸಂತೋಷಪಟ್ಟರು,</para>
  <para style="q" vid="PSA 107:30">ಅವರು ಮುಟ್ಟಬೇಕಾದ ರೇವಿಗೆ ಆತನು ಅವರನ್ನು ಸೇರಿಸಿದನು.<verse eid="PSA 107:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31"/>ಅವರು ಯೆಹೋವನ ಕೃಪೆಗೋಸ್ಕರವೂ</para>
  <para style="q" vid="PSA 107:31">ಆತನು ಮಾನವರಿಗಾಗಿ ನಡೆಸಿದ ಅದ್ಭುತಗಳಿಗೋಸ್ಕರವೂ</para>
  <para style="q" vid="PSA 107:31">ಆತನನ್ನು ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32"/>ನೆರೆದ ಸಭೆಯಲ್ಲಿ ಆತನನ್ನು ಕೀರ್ತಿಸಲಿ;</para>
  <para style="q" vid="PSA 107:32">ಹಿರಿಯರ ಸಮೂಹದಲ್ಲಿ ಕೊಂಡಾಡಲಿ.<verse eid="PSA 107:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33"/>ಆತನು ನಿವಾಸಿಗಳ ದುಷ್ಟತನಕ್ಕಾಗಿ</para>
  <para style="q" vid="PSA 107:33">ನದಿಗಳನ್ನು ಅರಣ್ಯವಾಗುವಂತೆಯೂ,<verse eid="PSA 107:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34"/>ನೀರಿನ ಬುಗ್ಗೆಗಳನ್ನು ಒಣನೆಲವಾಗುವಂತೆಯೂ,</para>
  <para style="q" vid="PSA 107:34">ಫಲಭೂಮಿಯನ್ನು ಉಪ್ಪು ನೆಲವಾಗುವಂತೆಯೂ ಮಾಡಿದನು.<verse eid="PSA 107:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35"/>ಅರಣ್ಯವನ್ನು ಕೆರೆಯಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 107:35">ಒಣನೆಲವನ್ನು ಬುಗ್ಗೆಗಳಾಗಿಯೂ ಮಾಡಿ,<verse eid="PSA 107:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36"/>ಅಲ್ಲಿ ಹಸಿದವರನ್ನು ನೆಲೆಗೊಳಿಸಿದನು;</para>
  <para style="q" vid="PSA 107:36">ಅವರು ನೆಲೆಯಾಗಿ ವಾಸಿಸಲು ಪಟ್ಟಣವನ್ನು ಕಟ್ಟಿಕೊಂಡು,<verse eid="PSA 107:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37"/>ಹೊಲಗಳನ್ನು ಬಿತ್ತಿ, ದ್ರಾಕ್ಷಾಲತೆಗಳನ್ನು ನೆಟ್ಟು,</para>
  <para style="q" vid="PSA 107:37">ಆದಾಯವನ್ನು ಕೂಡಿಸಿಕೊಂಡರು.<verse eid="PSA 107:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38"/>ಆತನು ಆಶೀರ್ವದಿಸಿದ್ದರಿಂದ ಅವರು ಬಹಳವಾಗಿ ಹೆಚ್ಚಿದರು.</para>
  <para style="q" vid="PSA 107:38">ಅವರಿಗೆ ದನಕರುಗಳೇನೂ ಕಡಿಮೆ ಇರಲಿಲ್ಲ.<verse eid="PSA 107:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39"/>ಅವರು ಕೇಡು ತೊಂದರೆಗಳಿಂದಲೂ,</para>
  <para style="q" vid="PSA 107:39">ಸಂಕಟದಿಂದಲೂ ಕುಗ್ಗಿಹೋಗಿ ಸ್ವಲ್ಪ ಜನರಾದರು.<verse eid="PSA 107:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40"/>ಪ್ರಭುಗಳಿಗೆ ಅಪಮಾನವನ್ನು ಉಂಟುಮಾಡಿ,</para>
  <para style="q" vid="PSA 107:40">ಅವರನ್ನು ದಾರಿಯಿಲ್ಲದ ಅರಣ್ಯದಲ್ಲಿ ಅಲೆದಾಡಿಸುವವನು.<verse eid="PSA 107:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41"/>ಕಷ್ಟದಲ್ಲಿದ್ದ ದೀನರನ್ನು ಉನ್ನತಸ್ಥಿತಿಗೆ ಏರಿಸಿ,</para>
  <para style="q" vid="PSA 107:41">ಅವರ ಕುಟುಂಬಗಳನ್ನು ಕುರಿಹಿಂಡಿನಂತೆ ಹೆಚ್ಚಿಸಿದನು.<verse eid="PSA 107:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42"/>ಯಥಾರ್ಥರು ಇದನ್ನು ನೋಡಿ ಹಿಗ್ಗುವರು;</para>
  <para style="q" vid="PSA 107:42">ಕೆಡುಕುಬಾಯಿ ಮುಚ್ಚಿಹೋಗುವುದು.<verse eid="PSA 107:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43"/>ಜ್ಞಾನಿಗಳು ಈ ಸಂಗತಿಗಳನ್ನು ಗಮನಿಸಿ,</para>
  <para style="q" vid="PSA 107:43">ಯೆಹೋವನ ಕೃಪಾಕಾರ್ಯಗಳನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳಲಿ.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s">ಜಯದ ವಾಗ್ದಾನ ನೆರವೇರಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1"/>ದೇವರೇ, ನನ್ನ ಹೃದಯವು ಸ್ಥಿರವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 108:1">ನಾನು ನುಡಿಸುತ್ತಾ ಹಾಡುವೆನು; ನನ್ನ ಆತ್ಮವೇ, ಎಚ್ಚೆತ್ತುಕೋ!<verse eid="PSA 108:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2"/>ಸ್ವರಮಂಡಲವೇ, ಕಿನ್ನರಿಯೇ, ಎಚ್ಚರಗೊಳ್ಳಿರಿ.</para>
  <para style="q" vid="PSA 108:2">ಸಂಕೀರ್ತನೆಯಿಂದ ಉದಯವನ್ನು ಎದುರುಗೊಳ್ಳುವೆನು.<verse eid="PSA 108:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3"/>ಯೆಹೋವನೇ, ಜನಾಂಗಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವೆನು;</para>
  <para style="q" vid="PSA 108:3">ಸರ್ವದೇಶದವರೊಳಗೆ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 108:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4"/>ಏಕೆಂದರೆ ನಿನ್ನ ಕೃಪೆಯು ಆಕಾಶಕ್ಕಿಂತಲೂ ದೊಡ್ಡದಾಗಿದೆ,</para>
  <para style="q" vid="PSA 108:4">ನಿನ್ನ ಸತ್ಯತೆಯು ಮುಗಿಲನ್ನು ನಿಲುಕುತ್ತದೆ.<verse eid="PSA 108:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5"/>ದೇವರೇ, ಮೇಲಣ ಲೋಕಗಳಲ್ಲಿ ನಿನ್ನ ಪ್ರಭಾವವು ಮೆರೆಯಲಿ;</para>
  <para style="q" vid="PSA 108:5">ಭೂಮಂಡಲದ ಮೇಲೆಲ್ಲಾ ನಿನ್ನ ಮಹತ್ವವು ಹಬ್ಬಲಿ.<verse eid="PSA 108:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6"/>ನಿನ್ನ ಪ್ರಿಯರಾದ ನಮ್ಮ ಮೊರೆಯನ್ನು ಲಾಲಿಸಿ ರಕ್ಷಿಸು,</para>
  <para style="q" vid="PSA 108:6">ನಿನ್ನ ಭುಜಬಲದಿಂದ ನಮ್ಮನ್ನು ಜಯಗೊಳಿಸು.<verse eid="PSA 108:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7"/>ದೇವರು ತನ್ನ ಪವಿತ್ರತ್ವವನ್ನು ಸಾಕ್ಷಿಮಾಡಿ ನುಡಿದಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 108:7">ಜಯಘೋಷಮಾಡುವೆನು; ಶೆಖೆಮ್ ಪ್ರದೇಶವನ್ನು ಹಂಚುವೆನು.</para>
  <para style="q" vid="PSA 108:7">ಸುಖೋತ್ ಬಯಲನ್ನು ಅಳತೆಮಾಡಿ ಕೊಡುವೆನು.<verse eid="PSA 108:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8"/>ಗಿಲ್ಯಾದ್ ಸೀಮೆಯೂ, ಮನಸ್ಸೆಯ ದೇಶವೂ ನನ್ನವು.</para>
  <para style="q" vid="PSA 108:8">ಎಫ್ರಾಯೀಮ್ ಗೋತ್ರವು ನನಗೆ ಶಿರಸ್ತ್ರಾಣ.</para>
  <para style="q" vid="PSA 108:8">ನನ್ನ ರಾಜದಂಡವು ಯೆಹೂದ ಕುಲವೇ.<verse eid="PSA 108:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9"/>ಮೋವಾಬ್ ಪ್ರದೇಶವು ನನ್ನ ಸ್ನಾನಪಾತ್ರೆ;</para>
  <para style="q" vid="PSA 108:9">ಎದೋಮ್ ಸೀಮೆಯು ನನ್ನ ಕೆರಗಳನ್ನು ಬಿಡುವ ಸ್ಥಳ.</para>
  <para style="q" vid="PSA 108:9">ಫಿಲಿಷ್ಟಿಯದ ವಿಷಯವಾಗಿ ಜಯಘೋಷ ಮಾಡುವೆನು.<verse eid="PSA 108:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10"/>ಕೋಟೆಕೊತ್ತಲುಗಳುಳ್ಳ ನಗರಕ್ಕೆ ನನ್ನನ್ನು ಕರೆದುಕೊಂಡು ಹೋಗುವವರು ಯಾರು?</para>
  <para style="q" vid="PSA 108:10">ಎದೋಮ್ ಪ್ರಾಂತ್ಯದೊಳಗೆ ನನ್ನನ್ನು ಸೇರಿಸುವವರು ಯಾರು?<verse eid="PSA 108:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11"/>ದೇವರೇ, ನೀನು ನಮ್ಮ ಸೈನ್ಯಗಳ ಸಂಗಡ ಬರಲಿಲ್ಲವಲ್ಲಾ!</para>
  <para style="q" vid="PSA 108:11">ದೇವರೇ, ನಮ್ಮನ್ನು ಕೈಬಿಟ್ಟಿಯಾ?<verse eid="PSA 108:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12"/>ನಮಗೆ ಕೈನೀಡಿ ಶತ್ರುಬಾಧೆಯಿಂದ ಪಾರುಮಾಡು.</para>
  <para style="q" vid="PSA 108:12">ಮನುಷ್ಯರ ಸಹಾಯವು ವ್ಯರ್ಥ.<verse eid="PSA 108:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13"/>ದೇವರಿಂದ ಶೂರಕೃತ್ಯಗಳನ್ನು ನಡೆಸುವೆವು;</para>
  <para style="q" vid="PSA 108:13">ನಮ್ಮ ವೈರಿಗಳನ್ನು ತುಳಿದುಬಿಡುವವನು ಆತನೇ.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s">ರಕ್ಷಣೆಗಾಗಿ ಭಕ್ತನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="LEV 26">ಯಾಜ 26</ref>; <ref loc="DEU 28">ಧರ್ಮೋ 28</ref>; <ref loc="PSA 35">ಕೀರ್ತ 35</ref>; <ref loc="PSA 69">69</ref>; <ref loc="MAT 5:38-44">ಮತ್ತಾ 5:38-44</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1"/>ನಾನು ಸ್ತುತಿಸುವ ದೇವರೇ, ಸುಮ್ಮನಿರಬೇಡ.<verse eid="PSA 109:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2"/>ದುಷ್ಟರು, ವಂಚಕರು ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಬಾಯ್ದೆರೆದಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 109:2">ಅವರು ಸುಳ್ಳು ನಾಲಿಗೆಯಿಂದ ನನ್ನೊಡನೆ ಮಾತನಾಡುತ್ತಿದ್ದಾರೆ.<verse eid="PSA 109:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3"/>ಅವರು ಹಗೆಯ ನುಡಿಗಳಿಂದ ನನ್ನನ್ನು ಮುತ್ತಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 109:3">ಕಾರಣವಿಲ್ಲದೆ ನನ್ನ ಸಂಗಡ ಯುದ್ಧ ಮಾಡಿದ್ದಾರೆ.<verse eid="PSA 109:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4"/>ನಾನು ಅವರನ್ನು ಪ್ರೀತಿಸಿದರೂ, ಅವರು ನನ್ನನ್ನು ವಿರೋಧಿಸುತ್ತಾರೆ;</para>
  <para style="q" vid="PSA 109:4">ನಾನಾದರೋ ನಿನಗೆ ಮೊರೆಯಿಡುತ್ತೇನೆ.<verse eid="PSA 109:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5"/>ಉಪಕಾರಕ್ಕೆ ಅಪಕಾರವನ್ನು ಮಾಡಿದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 109:5">ನಾನು ಪ್ರೀತಿಸಿದ್ದಕ್ಕೆ ಪ್ರತಿಯಾಗಿ ನನ್ನನ್ನು ದ್ವೇಷಿಸಿದ್ದಾರೆ.<verse eid="PSA 109:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6"/>ದುಷ್ಟ ಅಧಿಕಾರಿಯನ್ನು ಅವರ ಮೇಲೆ ನೇಮಿಸು;</para>
  <para style="q" vid="PSA 109:6">ತಪ್ಪು ಹೊರಿಸುವವನನ್ನು ಅವನ ಬಲಗಡೆಯಲ್ಲಿ ನಿಲ್ಲಿಸು.<verse eid="PSA 109:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7"/>ನ್ಯಾಯವಿಚಾರಣೆಯಲ್ಲಿ ಅವನು ಅಪರಾಧಿ ಎಂದು ತೀರ್ಪುಹೊಂದಲಿ;</para>
  <para style="q" vid="PSA 109:7">ಅವನ ಪ್ರಾರ್ಥನೆಯೂ ಪಾಪವೆಂದು ಎಣಿಸಲ್ಪಡಲಿ.<verse eid="PSA 109:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8"/>ಅವನ ಜೀವಿತದ ದಿನಗಳು ಸ್ವಲ್ಪವಾಗಿರಲಿ;</para>
  <para style="q" vid="PSA 109:8">ಅವನ ಉದ್ಯೋಗವು ಮತ್ತೊಬ್ಬನಿಗಾಗಲಿ.<verse eid="PSA 109:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9"/>ಅವನ ಮಕ್ಕಳು ಅನಾಥರೂ ಮತ್ತು ಹೆಂಡತಿ ವಿಧವೆಯೂ ಆಗಲಿ.<verse eid="PSA 109:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10"/>ಅವನ ಮಕ್ಕಳು ತಮ್ಮ ಹಾಳಾದ ಸ್ಥಳಗಳನ್ನು ಬಿಟ್ಟು,</para>
  <para style="q" vid="PSA 109:10">ದಿಕ್ಕಿಲ್ಲದವರಂತೆ ಅಲೆಯುತ್ತಾ ಭಿಕ್ಷೆಬೇಡಲಿ.<verse eid="PSA 109:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11"/>ಸಾಲಕೊಟ್ಟವನು ಅವನ ಆಸ್ತಿಯನ್ನೆಲ್ಲಾ ಕಸಿದುಕೊಳ್ಳಲಿ;</para>
  <para style="q" vid="PSA 109:11">ಪರರು ಅವನ ಕಷ್ಟಾರ್ಜಿತವನ್ನು ಸುಲಿದುಕೊಳ್ಳಲಿ.<verse eid="PSA 109:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12"/>ಅವನಿಗೆ ಯಾರೂ ಕೃಪೆತೋರಿಸದಿರಲಿ,</para>
  <para style="q" vid="PSA 109:12">ದಿಕ್ಕಿಲ್ಲದ ಅವನ ಮಕ್ಕಳಿಗೆ ಯಾರೂ ದಯೆತೋರದಿರಲಿ,<verse eid="PSA 109:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13"/>ಅವನ ಸಂತತಿಯು ನಿರ್ಮೂಲವಾಗಲಿ;</para>
  <para style="q" vid="PSA 109:13">ಎರಡನೆಯ ತಲೆಯಲ್ಲಿಯೇ ಅದು ನಿರ್ನಾಮವಾಗಿ ಹೋಗಲಿ.<verse eid="PSA 109:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14"/>ಯೆಹೋವನು ಅವನ ಹಿರಿಯರ ಪಾಪವನ್ನು ಮರೆಯದಿರಲಿ;</para>
  <para style="q" vid="PSA 109:14">ಅವನ ತಾಯಿಯ ಪಾಪವು ಅಳಿದುಹೋಗದಿರಲಿ.<verse eid="PSA 109:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15"/>ಅವು ಯೆಹೋವನ ಜ್ಞಾಪಕದಲ್ಲಿ ಇದ್ದೇ ಇರಲಿ.</para>
  <para style="q" vid="PSA 109:15">ಆತನು ಅವರ ಹೆಸರನ್ನು ಭೂಮಿಯಿಂದ ತೆಗೆದುಹಾಕಲಿ.<verse eid="PSA 109:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16"/>ಏಕೆಂದರೆ ಅವನು ಕರುಣೆ ತೋರಿಸುವುದನ್ನು ಮರೆತುಬಿಟ್ಟನು,</para>
  <para style="q" vid="PSA 109:16">ಬಡವನನ್ನು, ದೀನನನ್ನು, ಮನಗುಂದಿದವನನ್ನು ಹಿಂಸಿಸಿ ಕೊಲ್ಲಬೇಕೆಂದು ಯತ್ನಿಸಿದನು.<verse eid="PSA 109:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17"/>ಶಪಿಸುವುದು ಅವನಿಗೆ ಇಷ್ಟವಾಗಿತ್ತು, ಅದೇ ಅವನಿಗೆ ಬರಲಿ!</para>
  <para style="q" vid="PSA 109:17">ಆಶೀರ್ವದಿಸುವುದು ಅವನಿಗೆ ಇಷ್ಟವಿರಲ್ಲಿಲ್ಲ, ಅದು ಅವನಿಂದ ದೂರವಿರಲಿ!<verse eid="PSA 109:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18"/>ಅವನು ಶಾಪವನ್ನೇ ವಸ್ತ್ರವನ್ನಾಗಿ ಹೊದ್ದುಕೊಳ್ಳಲಿ,</para>
  <para style="q" vid="PSA 109:18">ಅದು ನೀರಿನಂತೆ ಅವನ ಅಂತರಂಗದಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 109:18">ಎಣ್ಣೆಯಂತೆ ಎಲುಬುಗಳಲ್ಲಿಯೂ ಸೇರಲಿ.<verse eid="PSA 109:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19"/>ಶಾಪವೇ ಅವನ ಹೊದಿಕೆಯಂತೆಯೂ,</para>
  <para style="q" vid="PSA 109:19">ನಿತ್ಯವಾದ ನಡುಕಟ್ಟಿನಂತೆಯೂ ಆಗಲಿ.<verse eid="PSA 109:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20"/>ನನ್ನನ್ನು ಎದುರಿಸಿ ಕೀಳುಮಾತನಾಡುವವರಿಗೆ</para>
  <para style="q" vid="PSA 109:20">ಯೆಹೋವನಿಂದ ಬರುವ ಪ್ರತಿಫಲವು ಇದೇ ಆಗಿರಲಿ.<verse eid="PSA 109:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21"/>ಕರ್ತನೇ, ಯೆಹೋವನೇ, ನಿನ್ನ ಕೃಪೆಯು ಹಿತಕರವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 109:21">ನಿನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತ ನನ್ನ ಪಕ್ಷವನ್ನು ಹಿಡಿದು ರಕ್ಷಿಸು.<verse eid="PSA 109:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22"/>ನಾನು ಬಡವನೂ, ದೀನನೂ ಆಗಿದ್ದೇನಲ್ಲಾ!</para>
  <para style="q" vid="PSA 109:22">ನನ್ನ ಹೃದಯದಲ್ಲಿ ಅಲಗು ನೆಟ್ಟಂತಾಗಿದೆ.<verse eid="PSA 109:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23"/>ಸಂಜೆಯ ನೆರಳಿನಂತೆ ಗತಿಸಿಹೋಗುತ್ತಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 109:23">ಗಾಳಿಯು ಬಡಿದುಕೊಂಡು ಹೋಗುವ ಮಿಡತೆಯಂತಿದ್ದೇನೆ.<verse eid="PSA 109:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24"/>ಉಪವಾಸದಿಂದ ನನ್ನ ಮೊಣಕಾಲುಗಳು ಬಲಹೀನವಾದವು;</para>
  <para style="q" vid="PSA 109:24">ನನ್ನ ದೇಹವು ಎಣ್ಣೆಯಿಲ್ಲದೆ ಕ್ಷೀಣವಾಯಿತು.<verse eid="PSA 109:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25"/>ನಾನು ಜನರ ಪರಿಹಾಸ್ಯಕ್ಕೆ ಗುರಿಯಾಗಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 109:25">ನನ್ನನ್ನು ನೋಡುವವರು ತಲೆಯಾಡಿಸುತ್ತಾರೆ.<verse eid="PSA 109:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26"/>ಯೆಹೋವನೇ, ನನ್ನ ದೇವರೇ, ಸಹಾಯಮಾಡು;</para>
  <para style="q" vid="PSA 109:26">ನಿನ್ನ ಕೃಪೆಗೆ ತಕ್ಕಂತೆ ರಕ್ಷಿಸು.<verse eid="PSA 109:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27"/>ಆಗ ಅವರು ಇದು ನಿನ್ನ ಕೈಕೆಲಸವೆಂದೂ,</para>
  <para style="q" vid="PSA 109:27">ಯೆಹೋವನಾದ ನೀನೇ ಇದನ್ನು ಮಾಡಿದೆ ಎಂದು ತಿಳಿದುಕೊಳ್ಳುವರು.<verse eid="PSA 109:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28"/>ಅವರು ಶಪಿಸಲಿ, ಚಿಂತೆಯಿಲ್ಲ; ನೀನು ಆಶೀರ್ವದಿಸುವಿ.</para>
  <para style="q" vid="PSA 109:28">ಅವರು ಎದ್ದು ಅಪಮಾನ ಹೊಂದುವರು.</para>
  <para style="q" vid="PSA 109:28">ಆದರೆ ನಿನ್ನ ಸೇವಕನಾದ ನಾನು ಉಲ್ಲಾಸಿಸುವೆನು.<verse eid="PSA 109:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29"/>ಮಾನಭಂಗವೇ ನನ್ನ ವಿರೋಧಿಗಳಿಗೆ ವಸ್ತ್ರವಾಗಲಿ;</para>
  <para style="q" vid="PSA 109:29">ನಾಚಿಕೆಯೇ ಅವರ ಹೊದಿಕೆಯಾಗಲಿ.<verse eid="PSA 109:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30"/>ಯೆಹೋವನನ್ನು ಬಹಳವಾಗಿ ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 109:30">ಜನಸಮೂಹದ ಮಧ್ಯದಲ್ಲಿ ಆತನನ್ನು ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 109:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31"/>ಆತನು ದೀನನ ಬಲಗಡೆಯಲ್ಲಿ ನಿಂತುಕೊಂಡು,</para>
  <para style="q" vid="PSA 109:31">ಪ್ರಾಣಶಿಕ್ಷೆ ವಿಧಿಸುವವರ ಕೈಯಿಂದ ತಪ್ಪಿಸಿ ರಕ್ಷಿಸುವನು.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="s">ಯೆಹೋವನಿಂದ ಆರಿಸಲ್ಪಟ್ಟ ಚೀಯೋನಿನ ಅರಸ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 2">ಕೀರ್ತ 2</ref>; <ref loc="PSA 21">21</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1"/>ಯೆಹೋವನು ನನ್ನ ಒಡೆಯನಿಗೆ,</para>
  <para style="q" vid="PSA 110:1">“ನಾನು ನಿನ್ನ ವಿರೋಧಿಗಳನ್ನು ನಿನ್ನ ಪಾದಪೀಠವಾಗುವಂತೆ ಮಾಡುವ ತನಕ,</para>
  <para style="q" vid="PSA 110:1">ನನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡಿರು” ಎಂದು ನುಡಿದನು.<verse eid="PSA 110:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2"/>ಯೆಹೋವನು ನಿನ್ನ ರಾಜದಂಡದ ಆಳ್ವಿಕೆಯನ್ನು</para>
  <para style="q" vid="PSA 110:2">ಚೀಯೋನಿನ ಹೊರಗೂ ಹಬ್ಬಿಸುವನು;</para>
  <para style="q" vid="PSA 110:2">ನಿನ್ನ ವೈರಿಗಳ ಮಧ್ಯದಲ್ಲಿ ದೊರೆತನ ಮಾಡು.<verse eid="PSA 110:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3"/>ನೀನು ಸೈನ್ಯವನ್ನು ಕೂಡಿಸುವ ದಿನದಲ್ಲಿ,</para>
  <para style="q" vid="PSA 110:3">ನಿನ್ನ ಪ್ರಜೆಗಳು ಸಂತೋಷದಿಂದ ತಾವಾಗಿಯೇ ಸೇರಿಕೊಳ್ಳುವರು.</para>
  <para style="q" vid="PSA 110:3">ಪರಿಶುದ್ಧ ವಸ್ತ್ರಭೂಷಿತರಾದ ನಿನ್ನ ಯುವ ಸೈನಿಕರು,</para>
  <para style="q" vid="PSA 110:3">ಉದಯಕಾಲದ ಇಬ್ಬನಿಯಂತಿರುವರು.<verse eid="PSA 110:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4"/>“ನೀನು ಸದಾಕಾಲವೂ <note caller="+" style="f"><char style="fr" closed="false">110:4 </char><char style="ft" closed="false">ಇಬ್ರಿಯ 5:6, 6:20, 7:17,21 ಗಳನ್ನು ನೋಡಿರಿ.</char></note>ಮೆಲ್ಕಿಜೆದೇಕನ ತರಹ ಯಾಜಕನಾಗಿರುವೆ” ಎಂದು</para>
  <para style="q" vid="PSA 110:4">ಯೆಹೋವನು ಆಣೆಯಿಟ್ಟು ನುಡಿದಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 110:4">ಪಶ್ಚಾತ್ತಾಪಡುವುದಿಲ್ಲ.<verse eid="PSA 110:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5"/>ನಿನ್ನ ಬಲಗಡೆಯಲ್ಲಿರುವ ಕರ್ತನು ತನ್ನ ಕೋಪದ ದಿನದಲ್ಲಿ</para>
  <para style="q" vid="PSA 110:5">ರಾಜರನ್ನು ಖಂಡಿಸುವನು.<verse eid="PSA 110:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6"/>ಆತನು ಜನಾಂಗಗಳಲ್ಲಿ ನ್ಯಾಯಸ್ಥಾಪಿಸುವಾಗ,</para>
  <para style="q" vid="PSA 110:6">ವಿಸ್ತಾರವಾದ ರಣರಂಗದಲ್ಲಿ ಶತ್ರುಗಳ ಶಿರಸ್ಸನ್ನು ಛೇದಿಸಿ,</para>
  <para style="q" vid="PSA 110:6">ಹೆಣಗಳಿಂದ ಅದನ್ನು ತುಂಬಿಸುವನು.<verse eid="PSA 110:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7"/>ಒಡೆಯನು ದಾರಿಯಲ್ಲಿ ಹಳ್ಳದ ನೀರನ್ನು ಕುಡಿದು ತಲೆಯೆತ್ತುವನು.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="s">ದೇವಸ್ತುತಿ</para>
  <para style="r">
    <ref loc="PSA 112">ಕೀರ್ತ 112</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ! ನಾನು ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 111:1">ಯಥಾರ್ಥರ ಕೂಟದಲ್ಲಿಯೂ, ನೆರೆದ ಸಭೆಯಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 111:1">ಮನಃಪೂರ್ವಕವಾಗಿ ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 111:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2"/>ಯೆಹೋವನ ಕೃತ್ಯಗಳು ಮಹತ್ತಾದವುಗಳು;</para>
  <para style="q" vid="PSA 111:2">ಅವುಗಳಲ್ಲಿ ಸಂತೋಷಿಸುವವರು ಅವುಗಳನ್ನೇ ಧ್ಯಾನಿಸುವರು.<verse eid="PSA 111:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3"/>ಆತನ ಕಾರ್ಯವು ಘನ, ಮಾನಗಳುಳ್ಳದ್ದು;</para>
  <para style="q" vid="PSA 111:3">ಆತನ ನೀತಿಯು ಸದಾಕಾಲವೂ ಇರುವುದು.<verse eid="PSA 111:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4"/>ಆತನು ತನ್ನ ಅದ್ಭುತಕೃತ್ಯಗಳ ಜ್ಞಾಪಕವನ್ನು ಉಳಿಯಮಾಡಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 111:4">ಯೆಹೋವನು ಕೃಪೆಯೂ, ಕನಿಕರವೂ ಉಳ್ಳವನು.<verse eid="PSA 111:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5"/>ತನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಿಗೆ ಆಹಾರವನ್ನು ಕೊಟ್ಟಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 111:5">ತನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ಯಾವಾಗಲೂ ನೆನಪಿನಲ್ಲಿಟ್ಟುಕೊಂಡಿದ್ದಾನೆ<verse eid="PSA 111:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6"/>ಆತನು ಅನ್ಯಜನಗಳ ಸ್ವತ್ತನ್ನು ತನ್ನ ಪ್ರಜೆಗೆ ಕೊಡುವುದರ ಮೂಲಕ</para>
  <para style="q" vid="PSA 111:6">ಸ್ವಪ್ರತಾಪವನ್ನು ತೋರ್ಪಡಿಸಿದ್ದಾನೆ.<verse eid="PSA 111:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7"/>ಆತನ ಕೈಕೆಲಸಗಳು ನೀತಿ, ಸತ್ಯತೆಗಳನ್ನು ಪ್ರಕಟಿಸುತ್ತವೆ;</para>
  <para style="q" vid="PSA 111:7">ಆತನ ನಿಯಮಗಳೆಲ್ಲಾ ಸ್ಥಿರವಾಗಿವೆ.<verse eid="PSA 111:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8"/>ಅವು ದೃಢವಾದ ಆಧಾರವುಳ್ಳವುಗಳು; ಯುಗಯುಗಾಂತರಕ್ಕೂ ಇರುವವು.</para>
  <para style="q" vid="PSA 111:8">ಸತ್ಯ, ನೀತಿಗಳಿಗನುಸಾರವಾಗಿ ವಿಧಿಸಲ್ಪಟ್ಟಿವೆ.<verse eid="PSA 111:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9"/>ಯೆಹೋವನು ತನ್ನ ಜನರಿಗೆ ವಿಮೋಚನೆಯನ್ನು ಉಂಟುಮಾಡಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 111:9">ತನ್ನ ಒಡಂಬಡಿಕೆಯನ್ನು ನಿತ್ಯಕ್ಕೂ ಸ್ಥಾಪಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 111:9">ಆತನ ನಾಮವು ಪರಿಶುದ್ಧವೂ, ಮಹೋನ್ನತವೂ ಆಗಿದೆ.<verse eid="PSA 111:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10"/>ಯೆಹೋವನ ಭಯವೇ ಜ್ಞಾನಕ್ಕೆ ಮೂಲ;</para>
  <para style="q" vid="PSA 111:10">ಆತನ ಕಟ್ಟಳೆಗಳನ್ನು ಕೈಕೊಳ್ಳುವವರು ಪೂರ್ಣ ವಿವೇಕಿಗಳು.</para>
  <para style="q" vid="PSA 111:10">ಆತನ ಸ್ತುತಿಯು ನಿರಂತರವಾದದ್ದು.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="s">ಭಕ್ತರ ಧನ್ಯತೆ</para>
  <para style="r">
    <ref loc="PSA 111">ಕೀರ್ತ 111</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 112:1">ಯಾರು ಯೆಹೋವನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿ,</para>
  <para style="q" vid="PSA 112:1">ಆತನ ಆಜ್ಞೆಗಳಲ್ಲಿ ಅತ್ಯಾನಂದಪಡುವನೋ ಅವನೇ ಧನ್ಯನು.<verse eid="PSA 112:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2"/>ಅವನ ಸಂತಾನವು ಲೋಕದಲ್ಲಿ ಬಲಿಷ್ಠವಾಗುವುದು;</para>
  <para style="q" vid="PSA 112:2">ನೀತಿವಂತನ ವಂಶವು ಶುಭಹೊಂದುವುದು.<verse eid="PSA 112:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3"/>ಅವನ ಮನೆಯಲ್ಲಿ ಸಿರಿಸಂಪತ್ತುಗಳು ಇರುವವು;</para>
  <para style="q" vid="PSA 112:3">ಅವನ ನೀತಿಯು ಸದಾಕಾಲವೂ ಫಲಿಸುತ್ತಿರುವುದು.<verse eid="PSA 112:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4"/>ಯಥಾರ್ಥರಿಗೆ ಕತ್ತಲೆಯಲ್ಲಿಯೂ ಜ್ಯೋತಿ ಮೂಡುವುದು;</para>
  <para style="q" vid="PSA 112:4">ದಯೆಯೂ, ಕನಿಕರವೂ, ನೀತಿಯುಳ್ಳ ದೇವರೇ ಆ ಜ್ಯೋತಿ.<verse eid="PSA 112:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5"/>ದಯಾಳುವಾಗಿ ಧನಸಹಾಯ ಮಾಡುವವನೂ,</para>
  <para style="q" vid="PSA 112:5">ತನ್ನ ಕಾರ್ಯಗಳನ್ನು ನೀತಿಯಿಂದ ನಡೆಸುವವನೂ ಭಾಗ್ಯವಂತನು.<verse eid="PSA 112:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6"/>ಅವನು ಎಂದಿಗೂ ಕದಲುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 112:6">ನೀತಿವಂತನನ್ನು ಯಾವಾಗಲೂ ಸ್ಮರಿಸುವರು.<verse eid="PSA 112:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7"/>ಅವನಿಗೆ ಕೆಟ್ಟ ಸುದ್ದಿಯ ಭಯವಿರುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 112:7">ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಟ್ಟಿರುವುದರಿಂದ,</para>
  <para style="q" vid="PSA 112:7">ಅವನ ಮನಸ್ಸು ಸ್ಥಿರವಾಗಿರುವುದು.<verse eid="PSA 112:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8"/>ದುಷ್ಟರಿಗಾಗುವ ಶಿಕ್ಷೆಯನ್ನು ಕಣ್ಣಾರೆ ಕಾಣುವೆನೆಂಬ ಭರವಸೆ ಇರುವುದರಿಂದ</para>
  <para style="q" vid="PSA 112:8">ಅವನ ಮನಸ್ಸು ದೃಢವಾಗಿದೆ, ಹೆದರುವುದಿಲ್ಲ.<verse eid="PSA 112:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9"/>ಬಡವರಿಗೆ ಉದಾರವಾಗಿ ಕೊಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 112:9">ಅವನ ನೀತಿಯ ಫಲವು ಸದಾಕಾಲವೂ ಇರುವುದು.</para>
  <para style="q" vid="PSA 112:9">
    <note caller="+" style="f">
      <char style="fr" closed="false">112:9 </char>
      <char style="ft" closed="false">ಅಥವಾ ಅವನು ಬಲಿಷ್ಠನಾಗುವನು.</char>
    </note>ಮಹಿಮೆಯೊಡನೆ ಅವನ ಕೊಂಬು ಎತ್ತಲ್ಪಡುವುದು.<verse eid="PSA 112:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10"/>ದುಷ್ಟನು ನೋಡಿ ವ್ಯಥೆಪಡುವನು;</para>
  <para style="q" vid="PSA 112:10">ಅವನು ಹಲ್ಲುಕಡಿಯುತ್ತಾ ನಾಶವಾಗುವನು.</para>
  <para style="q" vid="PSA 112:10">ದುಷ್ಟರ ನಿರೀಕ್ಷೆಯು ಭಂಗವಾಗುವುದು.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="s">ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸುವುದು</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 113:1">ಯೆಹೋವನ ಸೇವಕರೇ, ಸ್ತೋತ್ರಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 113:1">ಯೆಹೋವನ ನಾಮವನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 113:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2"/>ಈಗಿನಿಂದ ಯುಗಯುಗಕ್ಕೂ,</para>
  <para style="q" vid="PSA 113:2">ಯೆಹೋವನ ನಾಮವು ಕೀರ್ತಿಸಲ್ಪಡಲಿ.<verse eid="PSA 113:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3"/>ಯೆಹೋವನ ನಾಮವು ಪೂರ್ವದಿಂದ,</para>
  <para style="q" vid="PSA 113:3">ಪಶ್ಚಿಮದವರೆಗೂ ಸ್ತುತಿಹೊಂದಲಿ.<verse eid="PSA 113:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4"/>ಯೆಹೋವನು ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಮಹೋನ್ನತನು;</para>
  <para style="q" vid="PSA 113:4">ಆತನ ಪ್ರಭಾವವು ಮೇಲಣ ಲೋಕಕ್ಕಿಂತಲೂ ಉನ್ನತವಾಗಿದೆ.<verse eid="PSA 113:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5"/>ನಮ್ಮ ಯೆಹೋವ ದೇವರಿಗೆ ಸಮಾನರು ಯಾರು?</para>
  <para style="q" vid="PSA 113:5">ಆತನು ಉನ್ನತಲೋಕದಲ್ಲಿ ಆಸನಾರೂಢನಾಗಿ,<verse eid="PSA 113:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6"/>ಆಕಾಶವನ್ನೂ, ಭೂಮಿಯನ್ನೂ ನೋಡಲಿಕ್ಕೆ ಬಾಗುತ್ತಾನೆ.<verse eid="PSA 113:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7"/>ಆತನು ದೀನರನ್ನು ಧೂಳಿನಿಂದ ಎಬ್ಬಿಸಿ,</para>
  <para style="q" vid="PSA 113:7">ಬಡವರನ್ನು ತಿಪ್ಪೆಯಿಂದ ಎತ್ತುತ್ತಾನೆ.<verse eid="PSA 113:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8"/>ಪ್ರಭುಗಳ ಜೊತೆಯಲ್ಲಿ,</para>
  <para style="q" vid="PSA 113:8">ಅಂದರೆ ಅವರ ಜನಾಧಿಪತಿಗಳೊಡನೆ ಅವರನ್ನು ಕುಳ್ಳಿರಿಸುತ್ತಾನೆ.<verse eid="PSA 113:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9"/>ಬಂಜೆಯು ಮಕ್ಕಳೊಂದಿಗೆ,</para>
  <para style="q" vid="PSA 113:9">ಸಂತೋಷದಿಂದ ಮನೆಯಲ್ಲಿ ವಾಸಿಸುವ ಹಾಗೆ ಮಾಡುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 113:9">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="s">ಇಸ್ರಾಯೇಲರ ರಕ್ಷಕನ ಮಹತ್ವ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1"/>ಇಸ್ರಾಯೇಲರು ಐಗುಪ್ತ ದೇಶವನ್ನೂ,</para>
  <para style="q" vid="PSA 114:1">ಯಾಕೋಬನ ಮನೆತನದವರು ಅನ್ಯಜನಾಂಗವನ್ನು ಬಿಟ್ಟ ಮೇಲೆ,<verse eid="PSA 114:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2"/>ಯೆಹೂದವು ದೇವರ ಪರಿಶುದ್ಧ ವಾಸಸ್ಥಾನವೂ,</para>
  <para style="q" vid="PSA 114:2">ಇಸ್ರಾಯೇಲ್ ಆತನ ರಾಜ್ಯವೂ ಆಯಿತು.<verse eid="PSA 114:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3"/>ಸಮುದ್ರವು ಕಂಡು ಓಡಿಹೋಯಿತು;</para>
  <para style="q" vid="PSA 114:3">ಯೊರ್ದನ್ ಹೊಳೆಯು ಹಿಂದಿರುಗಿತು.<verse eid="PSA 114:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4"/>ಪರ್ವತಗಳು ಟಗರುಗಳಂತೆಯೂ,</para>
  <para style="q" vid="PSA 114:4">ಗುಡ್ಡಗಳು ಕುರಿಮರಿಗಳಂತೆಯೂ ಹಾರಾಡಿದವು.<verse eid="PSA 114:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5"/>ಸಮುದ್ರವೇ, ನಿನಗೇನಾಯಿತು? ಏಕೆ ಓಡಿ ಹೋಗುತ್ತೀ?</para>
  <para style="q" vid="PSA 114:5">ಯೊರ್ದನೇ, ಏಕೆ ಹಿಂದಿರುಗುತ್ತೀ?<verse eid="PSA 114:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6"/>ಪರ್ವತಗಳೇ, ನೀವು ಟಗರುಗಳಂತೆಯೂ,</para>
  <para style="q" vid="PSA 114:6">ಗುಡ್ಡಗಳೇ, ನೀವು ಕುರಿಮರಿಗಳಂತೆಯೂ ಏಕೆ ಹಾರಾಡುತ್ತೀರಿ?<verse eid="PSA 114:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7"/>ಭೂಲೋಕವೇ, ಕರ್ತನು ಪ್ರತ್ಯಕ್ಷನಾಗಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 114:7">ಯಾಕೋಬನ ದೇವರು ನಿನ್ನ ಮುಂದೆ ಇದ್ದಾನೆ, ಕಂಪಿಸು.<verse eid="PSA 114:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8"/>ಆತನು ಬಂಡೆಯನ್ನು ಕೆರೆಯನ್ನಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 114:8">ಶಿಲೆಯನ್ನು ಬುಗ್ಗೆಯನ್ನಾಗಿಯೂ ಮಾರ್ಪಡಿಸುತ್ತಾನೆ.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="s">ಯೆಹೋವನೊಬ್ಬನೇ ರಕ್ಷಕನು</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1"/>ನಮ್ಮನ್ನಲ್ಲ, ಯೆಹೋವನೇ, ನಮ್ಮನ್ನಲ್ಲ, ನಿನ್ನ ಪ್ರೀತಿ, ಸತ್ಯತೆಗಳ ನಿಮಿತ್ತವಾಗಿ</para>
  <para style="q" vid="PSA 115:1">ನಿನ್ನ ಹೆಸರನ್ನೇ ಘನಪಡಿಸು.<verse eid="PSA 115:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2"/>“ಅವರ ದೇವರು ಎಲ್ಲಿದ್ದಾನೆ?” ಎಂದು ಅನ್ಯರು ಏಕೆ ಹೇಳಬೇಕು?<verse eid="PSA 115:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3"/>ನಮ್ಮ ದೇವರು ಪರಲೋಕದಲ್ಲಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 115:3">ಆತನು ತನಗೆ ಬೇಕಾದುದನ್ನೆಲ್ಲಾ ಮಾಡುತ್ತಾನೆ.<verse eid="PSA 115:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4"/>ಅವರ ವಿಗ್ರಹಗಳೋ ಬೆಳ್ಳಿ ಬಂಗಾರದವುಗಳೇ;</para>
  <para style="q" vid="PSA 115:4">ಅವು ಮನುಷ್ಯರ ಕೈಕೆಲಸವಷ್ಟೇ.<verse eid="PSA 115:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5"/>ಅವು ಬಾಯಿದ್ದರೂ ಮಾತನಾಡುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 115:5">ಕಣ್ಣಿದ್ದರೂ ನೋಡುವುದಿಲ್ಲ.<verse eid="PSA 115:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6"/>ಕಿವಿಯಿದ್ದರೂ ಕೇಳುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 115:6">ಮೂಗಿದ್ದರೂ ಮೂಸುವುದಿಲ್ಲ.<verse eid="PSA 115:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7"/>ಕೈಯುಂಟು ಮುಟ್ಟುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 115:7">ಕಾಲುಂಟು ನಡೆಯುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 115:7">ಅವುಗಳ ಗಂಟಲಲ್ಲಿ ಶಬ್ದವೇ ಇಲ್ಲ.<verse eid="PSA 115:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8"/>ಅವುಗಳನ್ನು ಮಾಡುವವರೂ,</para>
  <para style="q" vid="PSA 115:8">ಅವುಗಳಲ್ಲಿ ಭರವಸವಿಡುವವರೂ ಅವುಗಳಂತೆಯೇ.<verse eid="PSA 115:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9"/>ಇಸ್ರಾಯೇಲರೇ, ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡಿರಿ.</para>
  <para style="q" vid="PSA 115:9">ಅವರ ಸಹಾಯಕನು, ಗುರಾಣಿಯು ಆತನೇ.<verse eid="PSA 115:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10"/>ಆರೋನನ ಮನೆತನದವರೇ, ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡಿರಿ.</para>
  <para style="q" vid="PSA 115:10">ಅವರ ಸಹಾಯಕನು, ಗುರಾಣಿಯು ಆತನೇ.<verse eid="PSA 115:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11"/>ಯೆಹೋವನ ಭಕ್ತರೇ, ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡಿರಿ.</para>
  <para style="q" vid="PSA 115:11">ಅವರ ಸಹಾಯಕನು, ಗುರಾಣಿಯು ಆತನೇ.<verse eid="PSA 115:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12"/>ಯೆಹೋವನು ನಮ್ಮನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 115:12">ಸಣ್ಣವರು ಮೊದಲುಗೊಂಡು ದೊಡ್ಡವರ ವರೆಗೆ ಎಲ್ಲರನ್ನೂ ಆಶೀರ್ವದಿಸುವನು.<verse eid="PSA 115:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13"/>ಇಸ್ರಾಯೇಲನ ಮನೆತನದವರನ್ನು ಆಶೀರ್ವದಿಸುವನು;</para>
  <para style="q" vid="PSA 115:13">ಆರೋನನ ಮನೆತನದವರನ್ನು ಆಶೀರ್ವದಿಸುವನು.</para>
  <para style="q" vid="PSA 115:13">ತನ್ನ ಭಕ್ತರನ್ನು ಆಶೀರ್ವದಿಸುವನು.<verse eid="PSA 115:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14"/>ಯೆಹೋವನು ನಿಮ್ಮನ್ನೂ, ನಿಮ್ಮ ಮಕ್ಕಳನ್ನೂ ಅಭಿವೃದ್ಧಿಪಡಿಸಲಿ;<verse eid="PSA 115:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15"/>ಯೆಹೋವನಿಂದ ನಿಮಗೆ ಆಶೀರ್ವಾದವಾಗಲಿ.</para>
  <para style="q" vid="PSA 115:15">ಆತನು ಭೂಪರಲೋಕಗಳನ್ನು ಉಂಟುಮಾಡಿದ್ದಾನೆ.<verse eid="PSA 115:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16"/>ಪರಲೋಕವು ಯೆಹೋವನದು;</para>
  <para style="q" vid="PSA 115:16">ಭೂಲೋಕವನ್ನು ಮಾನವ ಸಂತಾನಕ್ಕೆ ಕೊಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 115:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17"/>ಸತ್ತವರು ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 115:17">ಮೌನಲೋಕವನ್ನು ಸೇರಿದವರಲ್ಲಿ ಯಾರೂ ಆತನನ್ನು ಕೀರ್ತಿಸುವುದಿಲ್ಲ.<verse eid="PSA 115:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18"/>ನಾವೋ ಇಂದಿನಿಂದ ಸದಾಕಾಲವೂ</para>
  <para style="q" vid="PSA 115:18">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುವೆವು.</para>
  <para style="q" vid="PSA 115:18">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="s">ಕೃತಜ್ಞತಾಯಜ್ಞ ಕೀರ್ತನೆ</para>
  <para style="r">
    <ref loc="ISA 38">ಯೆಶಾ 38</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1"/>ಯೆಹೋವನನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 116:1">ಆತನು ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳುವನು.<verse eid="PSA 116:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2"/>ಆತನು ನನ್ನ ವಿಜ್ಞಾಪನೆಗೆ ಕಿವಿಗೊಟ್ಟಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 116:2">ಜೀವದಿಂದ ಇರುವವರೆಗೂ ಆತನನ್ನೇ ಪ್ರಾರ್ಥಿಸುವೆನು.<verse eid="PSA 116:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3"/>ಮರಣಪಾಶಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದವು;</para>
  <para style="q" vid="PSA 116:3">ಪಾತಾಳ ವೇದನೆಗಳು ನನ್ನನ್ನು ಹಿಡಿದಿದ್ದವು.</para>
  <para style="q" vid="PSA 116:3">ಚಿಂತೆಯಲ್ಲಿಯೂ, ಇಕ್ಕಟ್ಟಿನಲ್ಲಿಯೂ ಬಿದ್ದುಹೋಗಿದ್ದೆನು.<verse eid="PSA 116:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4"/>ಆಗ ಯೆಹೋವನ ಹೆಸರನ್ನು ಹೇಳಿ,</para>
  <para style="q" vid="PSA 116:4">“ಯೆಹೋವನೇ, ಕೃಪೆಮಾಡಿ ನನ್ನ ಪ್ರಾಣವನ್ನು ರಕ್ಷಿಸು” ಎಂದು ಪ್ರಾರ್ಥಿಸಿದೆನು.<verse eid="PSA 116:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5"/>ಯೆಹೋವನು ಕೃಪಾಳುವೂ, ನೀತಿವಂತನೂ ಆಗಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 116:5">ನಮ್ಮ ದೇವರು ಕನಿಕರವುಳ್ಳವನು.<verse eid="PSA 116:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6"/>ಯೆಹೋವನು ಸರಳ ಮನಸ್ಸುಳ್ಳವರನ್ನು ಕಾಪಾಡುವನು;</para>
  <para style="q" vid="PSA 116:6">ಕುಗ್ಗಿದವನಾದ ನನ್ನನ್ನು ರಕ್ಷಿಸಿದನು.<verse eid="PSA 116:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7"/>ನನ್ನ ಮನವೇ, ನಿನ್ನ ವಿಶ್ರಾಂತಿಯ ನೆಲೆಗೆ ತಿರುಗು.</para>
  <para style="q" vid="PSA 116:7">ಯೆಹೋವನು ನಿನಗೆ ಮಹೋಪಕಾರಗಳನ್ನು ಮಾಡಿದ್ದಾನಲ್ಲಾ.<verse eid="PSA 116:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8"/>ಯೆಹೋವನೇ, ನಾನು ಜೀವಲೋಕದಲ್ಲಿದ್ದು ನಿನಗೆ ನೀತಿಯುಳ್ಳವನಾಗಿ ನಡೆದುಕೊಳ್ಳಬೇಕೆಂದು,<verse eid="PSA 116:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9"/>ನೀನು ನನ್ನ ಪ್ರಾಣವನ್ನು ಮರಣದಿಂದ ತಪ್ಪಿಸಿ,</para>
  <para style="q" vid="PSA 116:9">ಕಣ್ಣೀರನ್ನು ನಿಲ್ಲಿಸಿ, ನನ್ನ ಪಾದಗಳನ್ನು ಎಡವದಂತೆ ಕಾದಿದ್ದೀ.<verse eid="PSA 116:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10"/>“ನಾನು ಬಹಳವಾಗಿ ಕುಗ್ಗಿಹೋದೆ” ಎಂದು ಹೇಳಿದಾಗಲೂ,<verse eid="PSA 116:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11"/>“ಮನುಷ್ಯರೆಲ್ಲಾ ಸುಳ್ಳುಗಾರರು” ಎಂದು ಭ್ರಾಂತಿಯಿಂದ ಹೇಳಿದಾಗಲೂ,</para>
  <para style="q" vid="PSA 116:11">ಭರವಸವುಳ್ಳವನಾಗಿಯೇ ಇದ್ದೆನು.<verse eid="PSA 116:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12"/>ಯೆಹೋವನ ಮಹೋಪಕಾರಗಳಿಗೆ ಬದಲೇನು ಮಾಡಲಿ?<verse eid="PSA 116:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13"/>ರಕ್ಷಣಾಪಾತ್ರೆಯನ್ನು ತೆಗೆದುಕೊಂಡು,</para>
  <para style="q" vid="PSA 116:13">ಯೆಹೋವನ ನಾಮವನ್ನು ಪ್ರಖ್ಯಾತಿಪಡಿಸುವೆನು.<verse eid="PSA 116:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14"/>ಯೆಹೋವನಿಗೆ ಹೊತ್ತ ಹರಕೆಗಳನ್ನು,</para>
  <para style="q" vid="PSA 116:14">ಆತನ ಎಲ್ಲಾ ಜನರ ಮುಂದೆಯೇ ಸಲ್ಲಿಸುವೆನು.<verse eid="PSA 116:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15"/>ಯೆಹೋವನು ತನ್ನ ಭಕ್ತರ ಮರಣವನ್ನು ಅಲ್ಪವೆಂದು ಎಣಿಸುವುದಿಲ್ಲ.<verse eid="PSA 116:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16"/>ಯೆಹೋವನೇ, ಕರುಣಿಸು, ನಾನು ನಿನ್ನ ಸೇವಕನು;</para>
  <para style="q" vid="PSA 116:16">ನಿನ್ನ ದಾಸಿಯ ಮಗನೂ, ನಿನ್ನ ದಾಸನೂ ಆಗಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 116:16">ನನ್ನ ಬಂಧನಗಳನ್ನು ಬಿಚ್ಚಿಬಿಟ್ಟಿದ್ದಿ.<verse eid="PSA 116:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17"/>ನಾನು ನಿನಗೆ ಕೃತಜ್ಞತಾ ಯಜ್ಞಗಳನ್ನು ಸಮರ್ಪಿಸುವೆನು;</para>
  <para style="q" vid="PSA 116:17">ಯೆಹೋವನ ನಾಮವನ್ನು ಪ್ರಖ್ಯಾತಿಪಡಿಸುವೆನು.<verse eid="PSA 116:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18"/>ಯೆರೂಸಲೇಮೇ, ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ,</para>
  <para style="q" vid="PSA 116:18">ಯೆಹೋವನ ಮಂದಿರದ ಅಂಗಳಗಳಲ್ಲಿ,<verse eid="PSA 116:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19"/>ಆತನಿಗೆ ಹೊತ್ತ ಹರಕೆಗಳನ್ನು,</para>
  <para style="q" vid="PSA 116:19">ಆತನ ಎಲ್ಲಾ ಜನರ ಮುಂದೆಯೇ ಸಲ್ಲಿಸುವೆನು.</para>
  <para style="q" vid="PSA 116:19">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="s">ಭೂಲೋಕವೆಲ್ಲಾ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಬೇಕು</para>
  <para style="r">
    <ref loc="PSA 66">ಕೀರ್ತ 66</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1"/>ಸರ್ವಜನಾಂಗಗಳೇ, ಯೆಹೋವನನ್ನು ಕೀರ್ತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 117:1">ಸಮಸ್ತ ಪ್ರಜೆಗಳೇ, ಆತನನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 117:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2"/>ಆತನ ಕೃಪೆಯು ನಮ್ಮ ಮೇಲೆ ಅಪಾರವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 117:2">ಯೆಹೋವನ ಸತ್ಯತೆಯು ಸದಾ ಇರುವುದು.</para>
  <para style="q" vid="PSA 117:2">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="s">ಹಬ್ಬದ ಗೀತೆ</para>
  <para style="r">
    <ref loc="NEH 8:14-18">ನೆಹೆ 8:14-18</ref>; <ref loc="ISA 12">ಯೆಶಾ 12</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1"/>ಯೆಹೋವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 118:1">ಆತನು ಒಳ್ಳೆಯವನು.</para>
  <para style="q" vid="PSA 118:1">ಆತನ ಕೃಪೆಯು ಶಾಶ್ವತವಾಗಿದೆ.<verse eid="PSA 118:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2"/>ಇಸ್ರಾಯೇಲರು, “ಆತನ ಕೃಪೆಯು ಶಾಶ್ವತ” ಎಂದು ಹೇಳಲಿ.<verse eid="PSA 118:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3"/>ಆರೋನನ ಮನೆತನದವರು, “ಆತನ ಕೃಪೆಯು ಶಾಶ್ವತ” ಎಂದು ಹೇಳಲಿ.<verse eid="PSA 118:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4"/>ಯೆಹೋವನ ಭಕ್ತರು, “ಆತನ ಕೃಪೆಯು ಶಾಶ್ವತ” ಎಂದು ಹೇಳಲಿ.<verse eid="PSA 118:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5"/>ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಟ್ಟೆನು;</para>
  <para style="q" vid="PSA 118:5">ಆತನು ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸಿ, ನನ್ನನ್ನು ವಿಶಾಲವಾದ ಸ್ಥಳದಲ್ಲಿ ನೆಲೆಸುವಂತೆ ಮಾಡಿದನು.<verse eid="PSA 118:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6"/>ಯೆಹೋವನು ನನ್ನ ಕಡೆ ಇದ್ದಾನೆ; ಭಯಪಡೆನು.</para>
  <para style="q" vid="PSA 118:6">ಮನುಷ್ಯನು ನನಗೆ ಏನು ಮಾಡಾನು?<verse eid="PSA 118:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7"/>ಯೆಹೋವನು ನನಗೆ ಇದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 118:7">ಆತನೇ ನನಗೆ ಸಹಾಯಕನು;</para>
  <para style="q" vid="PSA 118:7">ನನ್ನ ವೈರಿಗಳಿಗಾಗುವ ಶಿಕ್ಷೆಯನ್ನು ನೋಡುವೆನು.<verse eid="PSA 118:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8"/>ಮನುಷ್ಯರಲ್ಲಿ ಭರವಸವಿಡುವುದಕ್ಕಿಂತ,</para>
  <para style="q" vid="PSA 118:8">ಯೆಹೋವನನ್ನು ಆಶ್ರಯಿಸುವುದು ಒಳ್ಳೆಯದು.<verse eid="PSA 118:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9"/>ಪ್ರಭುಗಳಲ್ಲಿ ಭರವಸವಿಡುವುದಕ್ಕಿಂತ,</para>
  <para style="q" vid="PSA 118:9">ಯೆಹೋವನನ್ನು ಆಶ್ರಯಿಸುವುದು ಒಳ್ಳೆಯದು.<verse eid="PSA 118:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10"/>ಜನಾಂಗದವರೆಲ್ಲಾ ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡರು;</para>
  <para style="q" vid="PSA 118:10">ಯೆಹೋವನ ಬಲದಿಂದ<note caller="+" style="f"><char style="fr" closed="false">118:10 </char><char style="fq" closed="false">ಬಲದಿಂದ </char><char style="ft" closed="false">ಅಥವಾ ಹೆಸರಿನಿಂದ. </char></note> ಅವರನ್ನು ಸಂಹರಿಸುವೆನು.<verse eid="PSA 118:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11"/>ಅವರು ನನ್ನನ್ನು ಸುತ್ತಲೂ ಮುತ್ತಿದರು;</para>
  <para style="q" vid="PSA 118:11">ಯೆಹೋವನ ಹೆಸರಿನ ಬಲದಿಂದ ಅವರನ್ನು ಸಂಹರಿಸುವೆನು.<verse eid="PSA 118:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12"/>ಅವರು ಜೇನು ನೊಣಗಳಂತೆ ನನ್ನನ್ನು ಕವಿದರೂ;</para>
  <para style="q" vid="PSA 118:12">ಮುಳ್ಳಿನ ಬೆಂಕಿಯಂತೆ ಕ್ಷಣದಲ್ಲಿ ಅಳಿದುಹೋಗುವರು.</para>
  <para style="q" vid="PSA 118:12">ಯೆಹೋವನ ಹೆಸರಿನಿಂದ ಅವರನ್ನು ಸಂಹರಿಸುವೆನು.<verse eid="PSA 118:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13"/>ವೈರಿಯೇ, ನನ್ನನ್ನು ಬೀಳುವಂತೆ ಮಾಡಿದಿ;</para>
  <para style="q" vid="PSA 118:13">ಆದರೆ ಯೆಹೋವನು ನನಗೆ ಸಹಾಯ ಮಾಡಿದನು.<verse eid="PSA 118:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14"/>ನನ್ನ ಬಲವು, ಕೀರ್ತನೆಯು ಯೆಹೋವನೇ;</para>
  <para style="q" vid="PSA 118:14">ಆತನಿಂದ ನನಗೆ ರಕ್ಷಣೆಯುಂಟಾಯಿತು.<verse eid="PSA 118:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15"/>ಉತ್ಸಾಹಧ್ವನಿಯು, ಜಯಘೋಷವು ನೀತಿವಂತರ ಗುಡಾರಗಳಲ್ಲಿವೆ;</para>
  <para style="q" vid="PSA 118:15">ಯೆಹೋವನ ಬಲಗೈ ಪರಾಕ್ರಮವನ್ನು ನಡೆಸುತ್ತದೆ.<verse eid="PSA 118:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16"/>ಯೆಹೋವನ ಬಲಗೈ ಉನ್ನತವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 118:16">ಯೆಹೋವನ ಬಲಗೈ ಪರಾಕ್ರಮವನ್ನು ನಡೆಸುತ್ತದೆ.<verse eid="PSA 118:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17"/>ನಾನು ಸಾಯುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 118:17">ಜೀವದಿಂದಿದ್ದು ಯೆಹೋವನ ಕ್ರಿಯೆಗಳನ್ನು ಸಾರುವೆನು.<verse eid="PSA 118:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18"/>ಯೆಹೋವನು ನನ್ನನ್ನು ಕಠಿಣವಾಗಿ ಶಿಕ್ಷಿಸಿದನು;</para>
  <para style="q" vid="PSA 118:18">ಆದರೆ ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸಲಿಲ್ಲ.<verse eid="PSA 118:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19"/>ನೀತಿದ್ವಾರಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">118:19 </char><char style="fq" closed="false">ನೀತಿದ್ವಾರಗಳನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ದೇವಜನರು ಪ್ರವೇಶಿಸುವಂಥ ದ್ವಾರವನ್ನು ಅಥವಾ ದೇವಾಲಯದ ದ್ವಾರವನ್ನು ತೆರೆಯಿರಿ.</char></note> ತೆರೆಯಿರಿ;</para>
  <para style="q" vid="PSA 118:19">ನಾನು ಒಳಗೆ ಪ್ರವೇಶಿಸಿ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 118:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20"/>ಇದು ಯೆಹೋವನ ಮಂದಿರದ್ವಾರವು;</para>
  <para style="q" vid="PSA 118:20">ಇದರೊಳಗೆ ಪ್ರವೇಶಿಸತಕ್ಕವರು ನೀತಿವಂತರೇ.<verse eid="PSA 118:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21"/>ನನಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸಿ ರಕ್ಷಿಸಿದಾತನೇ,</para>
  <para style="q" vid="PSA 118:21">ನಿನ್ನನ್ನು ಕೊಂಡಾಡುತ್ತೇನೆ.<verse eid="PSA 118:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22"/>ಮನೆಕಟ್ಟುವವರು ಬೇಡವೆಂದು ಬಿಟ್ಟ ಕಲ್ಲೇ,</para>
  <para style="q" vid="PSA 118:22">ಮುಖ್ಯವಾದ ಮೂಲೆಗಲ್ಲಾಯಿತು;<verse eid="PSA 118:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23"/>ಇದು ಯೆಹೋವನಿಂದಲೇ ಆಯಿತು;</para>
  <para style="q" vid="PSA 118:23">ನಮಗೆ ಆಶ್ಚರ್ಯವಾಗಿ ತೋರುತ್ತದೆ.<verse eid="PSA 118:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24"/>ಈ ದಿನವು ಯೆಹೋವನಿಂದಲೇ ನೇಮಕವಾದದ್ದು;</para>
  <para style="q" vid="PSA 118:24">ಇದರಲ್ಲಿ ನಾವು ಉಲ್ಲಾಸದಿಂದ ಆನಂದಿಸೋಣ.<verse eid="PSA 118:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25"/>ಯೆಹೋವನೇ, ದಯವಿಟ್ಟು ರಕ್ಷಿಸು;</para>
  <para style="q" vid="PSA 118:25">ಯೆಹೋವನೇ, ದಯವಿಟ್ಟು ಸಾಫಲ್ಯಕೊಡು.<verse eid="PSA 118:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26"/>ಯೆಹೋವನ ಹೆಸರಿನಲ್ಲಿ ಒಳಗೆ ಬರುವವನಿಗೆ ಆಶೀರ್ವಾದ;</para>
  <para style="q" vid="PSA 118:26">ಯೆಹೋವನ ಮಂದಿರದಲ್ಲಿರುವ ನಾವು ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುತ್ತೇವೆ.<verse eid="PSA 118:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27"/>ಯೆಹೋವನೇ ದೇವರು;</para>
  <para style="q" vid="PSA 118:27">ಆತನು ನಮಗೆ ಪ್ರಕಾಶವನ್ನು ಅನುಗ್ರಹಿಸಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 118:27">ರೆಂಬೆಗಳನ್ನು ಹಿಡಿದುಕೊಂಡು ಮೆರವಣಿಗೆಯಾಗಿ</para>
  <para style="q" vid="PSA 118:27">ಯಜ್ಞವೇದಿಯ ಕೊಂಬುಗಳ ಸಮೀಪಕ್ಕೆ ಬನ್ನಿರಿ.<verse eid="PSA 118:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28"/>ನೀನು ನನ್ನ ದೇವರು; ನಿನ್ನನ್ನು ಕೊಂಡಾಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 118:28">ನನ್ನ ದೇವರೇ, ನಿನ್ನನ್ನು ಘನಪಡಿಸುತ್ತೇನೆ.<verse eid="PSA 118:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29"/>ಯೆಹೋವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ;</para>
  <para style="q" vid="PSA 118:29">ಆತನು ಒಳ್ಳೆಯವನು.</para>
  <para style="q" vid="PSA 118:29">ಆತನ ಕೃಪೆಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="s">ಧರ್ಮಶಾಸ್ತ್ರದ ಮಹತ್ವವನ್ನು ವರ್ಣಿಸುವ ಇಬ್ರಿಯ ಅಕ್ಷರ ಕ್ರಮಾನುಸಾರವಾದ ಕೀರ್ತನೆ</para>
  <para style="r">
    <ref loc="PSA 19:7-11">ಕೀರ್ತ 19:7-11</ref></para>
  <para style="d">ಆಲೆಫ್.</para>
  <para style="s">ಧರ್ಮಶಾಸ್ತ್ರದ ಅನುಕರಣೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1"/>ಯೆಹೋವನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಅನುಸರಿಸಿ,</para>
  <para style="q" vid="PSA 119:1">ಸದಾಚಾರಿಗಳಾಗಿ ನಡೆಯುವವರು ಧನ್ಯರು.<verse eid="PSA 119:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2"/>ಆತನ ಕಟ್ಟಳೆಗಳನ್ನು ಕೈಕೊಂಡು,</para>
  <para style="q" vid="PSA 119:2">ಪೂರ್ಣಹೃದಯದಿಂದ ಆತನನ್ನು ಹುಡುಕುವವರು ಭಾಗ್ಯವಂತರು.<verse eid="PSA 119:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3"/>ಅವರು ಆತನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 119:3">ಅನ್ಯಾಯ ಮಾಡುವುದೇ ಇಲ್ಲ.<verse eid="PSA 119:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4"/>ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಜಾಗರೂಕತೆಯಿಂದ ಕೈಕೊಂಡು ನಡೆಸಬೇಕೆಂದು,</para>
  <para style="q" vid="PSA 119:4">ನೀನೇ ಆಜ್ಞಾಪಿಸಿರುತ್ತಿ.<verse eid="PSA 119:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಕೈಕೊಳ್ಳುವುದರಲ್ಲಿ,</para>
  <para style="q" vid="PSA 119:5">ನಾನು ಸ್ಥಿರಮನಸ್ಸುಳ್ಳವನಾಗಿದ್ದರೆ ಒಳ್ಳೇಯದು!<verse eid="PSA 119:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6"/>ಹೀಗೆ ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನೆಲ್ಲಾ ಲಕ್ಷಿಸುವವನಾದರೆ,</para>
  <para style="q" vid="PSA 119:6">ನಾನು ಅಪಮಾನಕ್ಕೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ.<verse eid="PSA 119:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7"/>ನಾನು ನಿನ್ನ ನೀತಿಯ ವಿಧಿಗಳನ್ನು ಕಲಿತ ಹಾಗೆಲ್ಲಾ,</para>
  <para style="q" vid="PSA 119:7">ನಿನ್ನನ್ನು ಯಥಾರ್ಥ ಹೃದಯದಿಂದ ಕೊಂಡಾಡುತ್ತಾ ಹೋಗುವೆನು.<verse eid="PSA 119:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಅನುಸರಿಸುವ ನನ್ನನ್ನು,</para>
  <para style="q" vid="PSA 119:8">ಸಂಪೂರ್ಣವಾಗಿ ಕೈಬಿಡಬೇಡ.</para>
  <para style="d" vid="PSA 119:8">ಬೇತ್.<verse eid="PSA 119:8"/></para>
  <para style="s">ಉಪದೇಶಯುಕ್ತವಾದ ಯೆಹೋವನ ಕಟ್ಟಳೆಗಳು</para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9"/>ಯೌವನಸ್ಥನು ತನ್ನ ನಡತೆಯನ್ನು ಶುದ್ಧಪಡಿಸಿಕೊಳ್ಳುವುದು ಯಾವುದರಿಂದ?</para>
  <para style="q" vid="PSA 119:9">ನಿನ್ನ ವಾಕ್ಯವನ್ನು ಗಮನಿಸಿ ನಡೆಯುವುದರಿಂದಲೇ.<verse eid="PSA 119:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10"/>ನಾನು ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ನಿನ್ನನ್ನು ಹುಡುಕುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:10">ನಿನ್ನ ಆಜ್ಞೆಗಳಿಗೆ ತಪ್ಪಿಹೋಗದಂತೆ ನನ್ನನ್ನು ಕಾಪಾಡು.<verse eid="PSA 119:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11"/>ನಿನಗೆ ವಿರುದ್ಧವಾಗಿ ಪಾಪಮಾಡದಂತೆ,</para>
  <para style="q" vid="PSA 119:11">ನಿನ್ನ ನುಡಿಗಳನ್ನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12"/>ಸ್ತುತಿಪಾತ್ರನಾದ ಯೆಹೋವನೇ,</para>
  <para style="q" vid="PSA 119:12">ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ನನಗೆ ಕಲಿಸು.<verse eid="PSA 119:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13"/>ನಿನ್ನ ಎಲ್ಲಾ ಉಪದೇಶಾಜ್ಞೆಗಳನ್ನು,</para>
  <para style="q" vid="PSA 119:13">ನನ್ನ ತುಟಿಗಳು ವರ್ಣಿಸುತ್ತವೆ.<verse eid="PSA 119:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14"/>ಸರ್ವಸಂಪತ್ತಿನಲ್ಲಿ ಹೇಗೋ,</para>
  <para style="q" vid="PSA 119:14">ಹಾಗೆಯೇ ನಿನ್ನ ಕಟ್ಟಳೆಯ ಮಾರ್ಗದಲ್ಲಿ ಆನಂದಿಸುತ್ತೇನೆ.<verse eid="PSA 119:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15"/>ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಧ್ಯಾನಿಸುತ್ತಾ,</para>
  <para style="q" vid="PSA 119:15">ನಿನ್ನ ದಾರಿಯನ್ನು ಲಕ್ಷಿಸುವೆನು.<verse eid="PSA 119:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16"/>ನಿನ್ನ ನಿಬಂಧನೆಗಳಲ್ಲಿ ಉಲ್ಲಾಸಪಡುವೆನು,</para>
  <para style="q" vid="PSA 119:16">ನಿನ್ನ ವಾಕ್ಯವನ್ನು ಮರೆಯುವುದಿಲ್ಲ.</para>
  <para style="d" vid="PSA 119:16">ಗಿಮೆಲ್.<verse eid="PSA 119:16"/></para>
  <para style="s">ದೇವರಾಜ್ಞೆಗಳಲ್ಲಿ ಸಂತೋಷಿಸುವುದು</para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17"/>ನಿನ್ನ ಸೇವಕನಾದ ನನ್ನ ಮೇಲೆ ದಯವಿಡು,</para>
  <para style="q" vid="PSA 119:17">ಆಗ ಜೀವದಿಂದಿದ್ದು ನಿನ್ನ ವಾಕ್ಯವನ್ನು ಕೈಗೊಳ್ಳುವೆನು.<verse eid="PSA 119:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18"/>ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ತೆರೆ,</para>
  <para style="q" vid="PSA 119:18">ಆಗ ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರದ ಅದ್ಭುತಗಳನ್ನು ಕಂಡುಕೊಳ್ಳುವೆನು.<verse eid="PSA 119:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19"/>ನಾನು ಭೂಲೋಕದಲ್ಲಿ ಪ್ರವಾಸಿಯಾಗಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:19">ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನನಗೆ ಮರೆಮಾಡಬೇಡ.<verse eid="PSA 119:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20"/>ಯಾವಾಗಲೂ ನಿನ್ನ ವಿಧಿಗಳನ್ನೇ ಹಂಬಲಿಸುತ್ತಿರುವ</para>
  <para style="q" vid="PSA 119:20">ನನ್ನ ಪ್ರಾಣವು ಜಜ್ಜಿಹೋಗಿದೆ.<verse eid="PSA 119:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21"/>ನೀನು ಗರ್ವಿಷ್ಠರನ್ನು ಗದರಿಸುತ್ತಿ,</para>
  <para style="q" vid="PSA 119:21">ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಮೀರಿದವರು ಶಾಪಗ್ರಸ್ತರು.<verse eid="PSA 119:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಕೈಕೊಂಡವನಾದರಿಂದ,</para>
  <para style="q" vid="PSA 119:22">ನನಗಿರುವ ನಿಂದೆ, ಅಪಮಾನಗಳನ್ನು ತೊಲಗಿಸು.<verse eid="PSA 119:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23"/>ಪ್ರಭುಗಳು ಕುಳಿತುಕೊಂಡು,</para>
  <para style="q" vid="PSA 119:23">ನನಗೆ ವಿರುದ್ಧವಾಗಿ ಒಳಸಂಚು ಮಾಡಿದರೂ,</para>
  <para style="q" vid="PSA 119:23">ನಿನ್ನ ಸೇವಕನು ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನೇ ಧ್ಯಾನಿಸುತ್ತಿರುವನು.<verse eid="PSA 119:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳು ನನ್ನ ಪರಮಾನಂದ,</para>
  <para style="q" vid="PSA 119:24">ಅವೇ ನನ್ನ ಮಾರ್ಗದರ್ಶನ.</para>
  <para style="d" vid="PSA 119:24">ದಾಲಿತ್.<verse eid="PSA 119:24"/></para>
  <para style="s">ಆಜ್ಞಾಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುವ ನಿರ್ಧಾರ</para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25"/>ನನ್ನ ಪ್ರಾಣವು ಧೂಳಿನಲ್ಲಿ ಸೇರಿಹೋಗುತ್ತದೆ,</para>
  <para style="q" vid="PSA 119:25">ನಿನ್ನ ವಾಗ್ದಾನಕ್ಕನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಉಜ್ಜೀವಿಸಮಾಡು.<verse eid="PSA 119:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26"/>ನನ್ನ ಯಾತ್ರಾನುಭವವನ್ನು ನಿನಗೆ ಹೇಳಿಕೊಂಡಾಗ,</para>
  <para style="q" vid="PSA 119:26">ನನಗೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸಿದಿ,</para>
  <para style="q" vid="PSA 119:26">ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ನನಗೆ ಉಪದೇಶಿಸು.<verse eid="PSA 119:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27"/>ನಿನ್ನ ನಿಯಮಗಳ ದಾರಿಯನ್ನು ತಿಳಿಯಪಡಿಸು,</para>
  <para style="q" vid="PSA 119:27">ಆಗ ನಿನ್ನ ಬೋಧನೆಗಳನ್ನು<note caller="+" style="f"><char style="fr" closed="false">119:27 </char><char style="fq" closed="false">ಬೋಧನೆಗಳನ್ನು </char><char style="ft" closed="false">ಅದ್ಭುತಕೃತ್ಯಗಳನ್ನು.</char></note> ಧ್ಯಾನಿಸುವೆನು.<verse eid="PSA 119:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28"/>ಮನೋವ್ಯಥೆಯಿಂದ ಕಣ್ಣೀರು ಸುರಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:28">ನಿನ್ನ ವಾಗ್ದಾನಕ್ಕನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಬಲಪಡಿಸು.<verse eid="PSA 119:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29"/>ತಪ್ಪಾದ ಮಾರ್ಗವನ್ನು ನನ್ನಿಂದ ದೂರಮಾಡು,</para>
  <para style="q" vid="PSA 119:29">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ನನಗೆ ಅನುಗ್ರಹಿಸು.<verse eid="PSA 119:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30"/>ಭಕ್ತಿಮಾರ್ಗವನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:30">ನಿನ್ನ ವಿಧಿಗಳನ್ನು ನನ್ನ ಮುಂದೆಯೇ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31"/>ನಾನು ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಅಪ್ಪಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:31">ಯೆಹೋವನೇ, ನನಗೆ ಆಶಾಭಂಗಪಡಿಸಬೇಡ.<verse eid="PSA 119:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32"/>ನೀನು ನನ್ನ ಅಂತರಾತ್ಮವನ್ನು ವಿಮೋಚಿಸು,</para>
  <para style="q" vid="PSA 119:32">ಆಗ ಆಸಕ್ತಿಯಿಂದ ನಿನ್ನ ಆಜ್ಞಾಮಾರ್ಗವನ್ನು ಅನುಸರಿಸುವೆನು.</para>
  <para style="d" vid="PSA 119:32">ಹೇ.<verse eid="PSA 119:32"/></para>
  <para style="s">ಮಾರ್ಗದರ್ಶನಕ್ಕಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕಟ್ಟಳೆಗಳ</para>
  <para style="q" vid="PSA 119:33">ಮಾರ್ಗವನ್ನು ನನಗೆ ಉಪದೇಶಿಸು,</para>
  <para style="q" vid="PSA 119:33">ಕಡೆಯವರೆಗೂ ಅದನ್ನೇ ಅನುಸರಿಸಿ ನಡೆಯುವೆನು.<verse eid="PSA 119:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34"/>ನನಗೆ ತಿಳಿವಳಿಕೆಯನ್ನು ದಯಪಾಲಿಸು,</para>
  <para style="q" vid="PSA 119:34">ಆಗ ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ಕೈಕೊಂಡು ನಡೆಯುವೆನು.<verse eid="PSA 119:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35"/>ನಿನ್ನ ಆಜ್ಞಾಮಾರ್ಗದಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಸು,</para>
  <para style="q" vid="PSA 119:35">ಅದೇ ನನ್ನ ಇಷ್ಟ.<verse eid="PSA 119:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36"/>ನನ್ನ ಮನಸ್ಸನ್ನು ದ್ರವ್ಯಾಶೆಗಲ್ಲ,</para>
  <para style="q" vid="PSA 119:36">ನಿನ್ನ ಕಟ್ಟಳೆಗಳ ಕಡೆಗೆ ತಿರುಗಿಸು.<verse eid="PSA 119:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37"/>ವ್ಯರ್ಥಕಾರ್ಯಗಳಲ್ಲಿ ದೃಷ್ಟಿಯಿಡದಂತೆ ನನ್ನನ್ನು ಕಾಪಾಡು,</para>
  <para style="q" vid="PSA 119:37">ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುವಂತೆ ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸು.<verse eid="PSA 119:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38"/>ನಿನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಿಗಾಗಿ ನೀನು ಮಾಡಿದ ವಾಗ್ದಾನಗಳನ್ನು,</para>
  <para style="q" vid="PSA 119:38">ನಿನ್ನ ಸೇವಕನ ವಿಷಯದಲ್ಲಿ ನೆರವೇರಿಸು.<verse eid="PSA 119:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39"/>ನನ್ನ ಅವಮಾನವನ್ನು ತೊಲಗಿಸು,</para>
  <para style="q" vid="PSA 119:39">ಅದಕ್ಕೋಸ್ಕರ ಅಂಜುತ್ತಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 119:39">ನಿನ್ನ ಕಟ್ಟಳೆಗಳು ಹಿತಕರವಾಗಿವೆ.<verse eid="PSA 119:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40"/>ಇಗೋ, ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:40">ನಿನ್ನ ನೀತಿಗನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಉಜ್ಜೀವಿಸಮಾಡು.</para>
  <para style="d" vid="PSA 119:40">ವಾವ್.<verse eid="PSA 119:40"/></para>
  <para style="s">ಭರವಸಕ್ಕೆ ಆಧಾರವಾದ ದೇವರ ಕಟ್ಟಳೆಗಳು</para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕೃಪೆಯು ನನಗೆ ದೊರಕಲಿ,</para>
  <para style="q" vid="PSA 119:41">ನಿನ್ನ ನುಡಿಗನುಸಾರವಾಗಿ ನನಗೆ ರಕ್ಷಣೆಯುಂಟಾಗಲಿ.<verse eid="PSA 119:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42"/>ಆಗ ನನ್ನನ್ನು ನಿಂದಿಸುವವನಿಗೆ ಉತ್ತರಕೊಡುವೆನು,</para>
  <para style="q" vid="PSA 119:42">ನಾನು ನಿನ್ನ ವಾಕ್ಯದಲ್ಲಿ ಭರವಸವಿಟ್ಟಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 119:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43"/>ಸತ್ಯ ವಾಕ್ಯವನ್ನು ನನ್ನ ಬಾಯಿಂದ ತೆಗೆಯಬೇಡ.</para>
  <para style="q" vid="PSA 119:43">ನಿನ್ನ ನ್ಯಾಯವಿಧಿಗಳನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಸದಾ ತಪ್ಪದೆ ಕೈಗೊಳ್ಳುವೆನು.<verse eid="PSA 119:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45"/>ನಾನು ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಅಭ್ಯಾಸಿಸುವವನಾದುದರಿಂದ,</para>
  <para style="q" vid="PSA 119:45">ಸರಾಗವಾಗಿ ನಡೆಯುವೆನು.<verse eid="PSA 119:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳ ವಿಷಯವಾಗಿ,</para>
  <para style="q" vid="PSA 119:46">ಅರಸುಗಳ ಮುಂದೆಯೂ ಮಾತನಾಡುವೆನು,</para>
  <para style="q" vid="PSA 119:46">ನಾಚಿಕೆಪಡುವುದಿಲ್ಲ.<verse eid="PSA 119:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47"/>ನಿನ್ನ ಆಜ್ಞೆಗಳಲ್ಲಿ ಆನಂದಪಡುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:47">ಅವು ನನಗೆ ಇಷ್ಟವಾಗಿವೆ.<verse eid="PSA 119:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48"/>ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಗೌರವಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:48">ಅವುಗಳನ್ನು ನಾನು ಪ್ರೀತಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:48">ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಧ್ಯಾನಿಸುತ್ತೇನೆ.</para>
  <para style="d" vid="PSA 119:48">ಸಾಯಿನ್.<verse eid="PSA 119:48"/></para>
  <para style="s">ಚೈತನ್ಯಗೊಳಿಸುವ ಯೆಹೋವನ ನುಡಿ</para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49"/>ನಿನ್ನ ವಾಗ್ದಾನವನ್ನು ನಿನ್ನ ಸೇವಕನಿಗೋಸ್ಕರ ನೆನಪುಮಾಡಿಕೋ,</para>
  <para style="q" vid="PSA 119:49">ನನ್ನಲ್ಲಿ ನಿರೀಕ್ಷೆಯನ್ನು ಹುಟ್ಟಿಸಿದ್ದಿಯಲ್ಲಾ!<verse eid="PSA 119:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50"/>ನಿನ್ನ ನುಡಿಯು ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸುತ್ತದೆ,</para>
  <para style="q" vid="PSA 119:50">ಆಪತ್ಕಾಲದಲ್ಲಿ ಇದೇ ನನಗೆ ಆದರಣೆ.<verse eid="PSA 119:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51"/>ಗರ್ವಿಷ್ಠರು ನನ್ನನ್ನು ಬಹಳವಾಗಿ ಅಪಹಾಸ್ಯ ಮಾಡಿದರು,</para>
  <para style="q" vid="PSA 119:51">ಆದರೂ ನಾನು ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಬಿಡಲಿಲ್ಲ.<verse eid="PSA 119:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಪುರಾತನ ಉಪದೇಶಾಜ್ಞೆಗಳನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 119:52">ನನ್ನನ್ನು ಸಂತೈಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರ ಭ್ರಷ್ಟರಾದ ದುಷ್ಟರಿಗಾಗಿ, ಕೋಪಗೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54"/>ನನ್ನ ಪ್ರವಾಸದ ಮನೆಯಲ್ಲಿ</para>
  <para style="q" vid="PSA 119:54">ನಿನ್ನ ಕಟ್ಟಳೆಗಳು ನನಗೆ ಗಾಯನವಾದವು.<verse eid="PSA 119:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55"/>ಯೆಹೋವನೇ, ರಾತ್ರಿಯಲ್ಲಿ ನಿನ್ನ ನಾಮವನ್ನು ಸ್ಮರಿಸಿಕೊಳ್ಳುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:55">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಕೈಗೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 119:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56"/>ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಅನುಸರಿಸಿದ್ದರಿಂದ ಇದೆಲ್ಲಾ ನನಗೆ ಲಭಿಸಿತು.</para>
  <para style="d" vid="PSA 119:56">ಹೇತ್.<verse eid="PSA 119:56"/></para>
  <para style="s">ಯೆಹೋವನ ನೀತಿವಿಧಿಗಳಲ್ಲಿ ಆಸಕ್ತಿ</para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57"/>ಯೆಹೋವನೇ, ನನ್ನ ಪಾಲು ನೀನೇ,</para>
  <para style="q" vid="PSA 119:57">ನಿನ್ನ ವಾಕ್ಯಗಳನ್ನು ಕೈಗೊಳ್ಳುವೆನೆಂದು ನಿರ್ಣಯಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58"/>ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ನಿನ್ನ ದಯೆಯನ್ನು ಅಪೇಕ್ಷಿಸಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:58">ನಿನ್ನ ನುಡಿಗನುಸಾರವಾಗಿ ನನಗೆ ಪ್ರಸನ್ನನಾಗು.<verse eid="PSA 119:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59"/>ನನ್ನ ನಡತೆಯನ್ನು ಶೋಧಿಸಿದೆನು,</para>
  <para style="q" vid="PSA 119:59">ನಿನ್ನ ಕಟ್ಟಳೆಗಳ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60"/>ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸುವುದರಲ್ಲಿ ಆಸಕ್ತನಾದೆನು,</para>
  <para style="q" vid="PSA 119:60">ಆಲಸ್ಯಮಾಡಲಿಲ್ಲ.<verse eid="PSA 119:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61"/>ದುಷ್ಟರ ಪಾಶಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡವು,</para>
  <para style="q" vid="PSA 119:61">ಆದರೂ ನಾನು ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಮರೆಯಲಿಲ್ಲ.<verse eid="PSA 119:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62"/>ನಿನ್ನ ನೀತಿವಿಧಿಗಳಿಗೋಸ್ಕರ ನಿನ್ನನ್ನು ಕೊಂಡಾಡಲು,</para>
  <para style="q" vid="PSA 119:62">ಮಧ್ಯರಾತ್ರಿಯಲ್ಲಿ ಏಳುವೆನು.<verse eid="PSA 119:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63"/>ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಕೈಕೊಂಡು ನಿನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಿಗೆ</para>
  <para style="q" vid="PSA 119:63">ನಾನು ಸಂಗಡಿಗನು.<verse eid="PSA 119:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64"/>ಯೆಹೋವನೇ, ಭೂಲೋಕವು ನಿನ್ನ ಶಾಶ್ವತ ಪ್ರೀತಿಯಿಂದ ತುಂಬಿದೆ,</para>
  <para style="q" vid="PSA 119:64">ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ನನಗೆ ಬೋಧಿಸು.</para>
  <para style="d" vid="PSA 119:64">ಟೇತ್.<verse eid="PSA 119:64"/></para>
  <para style="s">ದೇವರಾಜ್ಞೆಗಳ ಮೌಲ್ಯ</para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65"/>ಯೆಹೋವನೇ, ನೀನು ನಿನ್ನ ವಾಗ್ದಾನಕ್ಕೆ ತಕ್ಕಂತೆ,</para>
  <para style="q" vid="PSA 119:65">ನಿನ್ನ ಸೇವಕನಿಗೆ ಮಹೋಪಕಾರ ಮಾಡಿದ್ದಿ.<verse eid="PSA 119:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66"/>ಸುಜ್ಞಾನವನ್ನು, ವಿವೇಕಗಳನ್ನು ನನಗೆ ಕಲಿಸಿಕೊಡು,</para>
  <para style="q" vid="PSA 119:66">ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನಂಬಿಕೊಂಡಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 119:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67"/>ಕಷ್ಟಾನುಭವಕ್ಕಿಂತ ಮೊದಲೇ ತಪ್ಪಿಹೋಗುತ್ತಿದ್ದೆನು,</para>
  <para style="q" vid="PSA 119:67">ಈಗಲಾದರೋ ನಿನ್ನ ನುಡಿಗಳನ್ನು ಕೈಗೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 119:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68"/>ನೀನು ಒಳ್ಳೆಯವನು, ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವನೂ ಆಗಿದ್ದಿ,</para>
  <para style="q" vid="PSA 119:68">ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ನನಗೆ ಬೋಧಿಸು.<verse eid="PSA 119:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69"/>ಗರ್ವಿಷ್ಠರು ನನ್ನ ವಿರುದ್ಧವಾಗಿ ಸುಳ್ಳುಕಲ್ಪಿಸಿದ್ದಾರೆ,</para>
  <para style="q" vid="PSA 119:69">ನಾನಾದರೋ ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಕೈಕೊಳ್ಳುವೆನು.<verse eid="PSA 119:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70"/>ಅವರ ಹೃದಯದಲ್ಲಿ ಸತ್ಯವಿಲ್ಲ<note caller="+" style="f"><char style="fr" closed="false">119:70 </char><char style="fq" closed="false">ಅವರ ಹೃದಯದಲ್ಲಿ ಸತ್ಯವಿಲ್ಲ </char><char style="ft" closed="false">ಕೊಬ್ಬಿನಂತೆ ಅವರ ಬುದ್ಧಿ ಮಂದವಾಯಿತು</char></note>,</para>
  <para style="q" vid="PSA 119:70">ನಾನಾದರೋ ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರದಲ್ಲಿ ಉಲ್ಲಾಸಪಡುತ್ತೇನೆ.<verse eid="PSA 119:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71"/>ಕಷ್ಟಾನುಭವವು ಹಿತಕರವಾಯಿತು,</para>
  <para style="q" vid="PSA 119:71">ಅದುದರಿಂದಲೇ ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಕಲಿತೆನು.<verse eid="PSA 119:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72"/>ನೀನು ಕೊಟ್ಟ ಧರ್ಮಶಾಸ್ತ್ರವು,</para>
  <para style="q" vid="PSA 119:72">ಸಾವಿರಾರು ಚಿನ್ನ, ಬೆಳ್ಳಿಯ ನಾಣ್ಯಗಳಿಗಿಂತಲೂ ನನಗೆ ಅತಿಪ್ರಿಯವಾಗಿದೆ.</para>
  <para style="d" vid="PSA 119:72">ಯೋದ್.<verse eid="PSA 119:72"/></para>
  <para style="s">ನ್ಯಾಯಬದ್ಧವಾದ ಕಟ್ಟಳೆಗಳು</para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73"/>ನಿನ್ನ ಕೈಗಳು ನನ್ನನ್ನು ರೂಪಿಸಿ ನಿಲ್ಲಿಸಿದವು,</para>
  <para style="q" vid="PSA 119:73">ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕಲಿಯುವುದಕ್ಕೆ ನನಗೆ ಬುದ್ಧಿಯನ್ನು ಕೊಡು.<verse eid="PSA 119:73"/></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74"/>ನಿನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರು ನನ್ನನ್ನು ನೋಡಿ ಸಂತೋಷಿಸಲಿ,</para>
  <para style="q" vid="PSA 119:74">ನಾನು ನಿನ್ನ ವಾಕ್ಯವನ್ನೇ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 119:74"/></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75"/>ಯೆಹೋವನೇ, ನಿನ್ನ ವಿಧಿಗಳು ನೀತಿಯುಳ್ಳವುಗಳಾಗಿವೆ ಎಂದೂ,</para>
  <para style="q" vid="PSA 119:75">ನೀನು ನಂಬಿಗಸ್ತಿಕೆಯಿಂದಲೇ ನನ್ನನ್ನು ಕುಗ್ಗಿಸಿದ್ದೀ ಎಂದೂ ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:75"/></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76"/>ನಿನ್ನ ಸೇವಕನಿಗೆ ನುಡಿದ ಪ್ರಕಾರ,</para>
  <para style="q" vid="PSA 119:76">ನನ್ನ ಸಮಾಧಾನಕ್ಕೋಸ್ಕರ ಕೃಪೆಯನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 119:76"/></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77"/>ನಾನು ಬದುಕುವಂತೆ ನಿನ್ನ ಕರುಣೆಯು ನನಗೆ ದೊರೆಯಲಿ,</para>
  <para style="q" vid="PSA 119:77">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವೇ ನನ್ನ ಆನಂದವಾಗಿದೆ.<verse eid="PSA 119:77"/></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78"/>ಗರ್ವಿಷ್ಠರು ಮಾನಭಂಗ ಹೊಂದಲಿ,</para>
  <para style="q" vid="PSA 119:78">ಅವರು ಮೋಸದಿಂದ ನನಗೆ ಕೇಡು ಮಾಡಿದ್ದಾರೆ.</para>
  <para style="q" vid="PSA 119:78">ನಾನಾದರೋ ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 119:78"/></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79"/>ನಿನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು,</para>
  <para style="q" vid="PSA 119:79">ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳಲಿ.<verse eid="PSA 119:79"/></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80"/>ನನ್ನ ಮನಸ್ಸು ನಿನ್ನ ಕಟ್ಟಳೆಗಳಲ್ಲಿ ಆಸಕ್ತವಾಗಲಿ,</para>
  <para style="q" vid="PSA 119:80">ಆಗ ನನ್ನ ಆಶಾಭಂಗಕ್ಕೆ ಕಾರಣವಿರುವುದಿಲ್ಲ.</para>
  <para style="d" vid="PSA 119:80">ಕಾಫ್.<verse eid="PSA 119:80"/></para>
  <para style="s">ವಿಮೋಚನೆಗಾಗಿ ವಿಜ್ಞಾಪನೆ</para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81"/>ನಿನ್ನ ರಕ್ಷಣೆಯ ಬಯಕೆಯಿಂದಲೇ ನನ್ನ ಮನವು ಬಲಗುಂದಿತು,</para>
  <para style="q" vid="PSA 119:81">ನಾನು ನಿನ್ನ ವಾಕ್ಯದಲ್ಲೇ ನಿರೀಕ್ಷೆಯುಳ್ಳವನಾಗಿದ್ದೇನೆ.<verse eid="PSA 119:81"/></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82"/>ನಿನ್ನ ನುಡಿಯನ್ನು ನೆರವೇರಿಸಿ ಯಾವಾಗ ನನ್ನನ್ನು ಸಂತೈಸುವಿ?</para>
  <para style="q" vid="PSA 119:82">ಎಂಬುವುದಕ್ಕೋಸ್ಕರವೇ ನನ್ನ ದೃಷ್ಟಿಯು ಮಂದವಾಯಿತು.<verse eid="PSA 119:82"/></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83"/>ಹೊಗೆಯಲ್ಲಿ ನೇತು ಹಾಕಿರುವ ಬುದ್ದಲಿಯಂತಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:83">ಆದರೂ ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಮರೆಯಲಿಲ್ಲ.<verse eid="PSA 119:83"/></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84"/>ನಿನ್ನ ಸೇವಕನ ದಿನಗಳು ಬಹುಸ್ವಲ್ಪವಲ್ಲಾ!</para>
  <para style="q" vid="PSA 119:84">ನನ್ನನ್ನು ಬಾಧಿಸುವವರಿಗೆ ಶಿಕ್ಷೆ ವಿಧಿಸುವುದು ಯಾವಾಗ?<verse eid="PSA 119:84"/></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಅನುಸರಿಸದ ಗರ್ವಿಷ್ಠರು</para>
  <para style="q" vid="PSA 119:85">ನನಗಾಗಿ ಗುಂಡಿಗಳನ್ನು ತೋಡಿದ್ದಾರೆ.<verse eid="PSA 119:85"/></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86"/>ನಿನ್ನ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ಸ್ಥಿರವಾಗಿವೆ,</para>
  <para style="q" vid="PSA 119:86">ಅವರು ಮೋಸದಿಂದ ಹಿಂಸಿಸುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 119:86">ನನಗೆ ಸಹಾಯಮಾಡು.<verse eid="PSA 119:86"/></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87"/>ನನ್ನನ್ನು ಭೂಮಿಯಿಂದ ತೆಗೆದೇಬಿಟ್ಟಿದ್ದರು,</para>
  <para style="q" vid="PSA 119:87">ಆದರೆ ನಾನು ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಬಿಡಲೇ ಇಲ್ಲ.<verse eid="PSA 119:87"/></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88"/>ನಿನ್ನ ಕೃಪೆಗೆ ಅನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಕಾಪಾಡು,<note caller="+" style="f"><char style="fr" closed="false">119:88 </char><char style="fq" closed="false">ನನ್ನನ್ನು ಕಾಪಾಡು, </char><char style="ft" closed="false">ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸು</char></note></para>
  <para style="q" vid="PSA 119:88">ಆಗ ನೀನು ಆಜ್ಞಾಪಿಸಿದ ಕಟ್ಟಳೆಯನ್ನು ಕೈಕೊಳ್ಳುವೆನು.</para>
  <para style="d" vid="PSA 119:88">ಲಾಮೆದ್.<verse eid="PSA 119:88"/></para>
  <para style="s">ಘನವಾದ ಆಜ್ಞಾಶಾಸನ</para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89"/>ಯೆಹೋವನೇ, ನಿನ್ನ ವಾಕ್ಯವು ಪರಲೋಕದಲ್ಲಿ ಶಾಶ್ವತವಾಗಿ ಸ್ಥಾಪಿಸಲ್ಪಟ್ಟಿದೆ.<verse eid="PSA 119:89"/></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90"/>ನಿನ್ನ ಸತ್ಯವು ತಲತಲಾಂತರಕ್ಕೂ ಇರುವುದು.</para>
  <para style="q" vid="PSA 119:90">ನೀನು ಭೂಮಿಯನ್ನು ಸ್ಥಾಪಿಸಿರುತ್ತಿ, ಅದು ಕದಲುವುದಿಲ್ಲ.<verse eid="PSA 119:90"/></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91"/>ನಿನ್ನ ವಿಧಿಗಳಿಗನುಸಾರವಾಗಿ ಅವು ಇಂದಿನವರೆಗೂ,</para>
  <para style="q" vid="PSA 119:91">ಸ್ಥಿರವಾಗಿ ನಿಂತಿರುತ್ತವೆ.</para>
  <para style="q" vid="PSA 119:91">ಏಕೆಂದರೆ ಸರ್ವವಸ್ತುಗಳೂ ನಿನ್ನ ಸೇವೆ ಮಾಡುತ್ತವೆ.<verse eid="PSA 119:91"/></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವು ನನಗೆ ಆನಂದಕರವಾಗದಿದ್ದರೆ,</para>
  <para style="q" vid="PSA 119:92">ನನಗೊದಗಿದ ಆಪತ್ತಿನಲ್ಲಿ ಹಾಳಾಗಿ ಹೋಗುತ್ತಿದ್ದೆನು.<verse eid="PSA 119:92"/></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93"/>ನಾನು ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಎಂದಿಗೂ ಮರೆಯುವುದಿಲ್ಲ,</para>
  <para style="q" vid="PSA 119:93">ಅವುಗಳಿಂದಲೇ ನನ್ನನ್ನು ಬದುಕಿಸಿದ್ದಿ.<verse eid="PSA 119:93"/></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94"/>ನಾನು ನಿನ್ನವನು, ರಕ್ಷಿಸು,</para>
  <para style="q" vid="PSA 119:94">ನಿನ್ನ ನಿಯಮಗಳಲ್ಲಿ ಆಸಕ್ತನಾಗಿದ್ದೇನಲ್ಲಾ.<verse eid="PSA 119:94"/></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95"/>ದುಷ್ಟರು ನನ್ನನ್ನು ಸಂಹರಿಸಬೇಕೆಂದು ಹೊಂಚಿ ನೋಡುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 119:95">ನಾನು ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನೇ ಲಕ್ಷಿಸಿಕೊಂಡಿರುವೆನು.<verse eid="PSA 119:95"/></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96"/>ಎಲ್ಲಾ ಸಂಪೂರ್ಣತೆಗೂ ಮೇರೆಯುಂಟೆಂದು ಬಲ್ಲೆನು,</para>
  <para style="q" vid="PSA 119:96">ಆದರೆ ನಿನ್ನ ಆಜ್ಞಾಶಾಸನವು ಅಪರಿಮಿತವಾದದ್ದು.<note caller="+" style="f"><char style="fr" closed="false">119:96 </char><char style="fq" closed="false">ಅಪರಿಮಿತವಾದದ್ದು. </char><char style="ft" closed="false">ವಿಶಾಲವಾದದ್ದು.</char></note></para>
  <para style="d" vid="PSA 119:96">ಮೆಮ್.<verse eid="PSA 119:96"/></para>
  <para style="s">ಜ್ಞಾನವಂತರನ್ನಾಗಿ ಮಾಡುವ ಧರ್ಮಶಾಸ್ತ್ರ</para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವು ನನಗೆ ಎಷ್ಟೋ ಪ್ರಿಯವಾಗಿದೆ,</para>
  <para style="q" vid="PSA 119:97">ದಿನವೆಲ್ಲಾ ಅದೇ ನನ್ನ ಧ್ಯಾನ.<verse eid="PSA 119:97"/></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98"/>ನಿನ್ನ ಆಜ್ಞೆಗಳ ಮೂಲಕ ನನ್ನ ವೈರಿಗಳಿಗಿಂತ ಬುದ್ಧಿವಂತನಾಗಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:98">ಸದಾಕಾಲವೂ ಅವೇ ನನಗಿವೆ.<verse eid="PSA 119:98"/></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳು ನನ್ನ ಧ್ಯಾನವಾಗಿರುವುದರಿಂದ,</para>
  <para style="q" vid="PSA 119:99">ನನ್ನ ಉಪಾಧ್ಯಾಯರಿಗಿಂತ ಜ್ಞಾನಿಯಾಗಿದ್ದೇನೆ.<verse eid="PSA 119:99"/></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100"/>ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಕೈಗೊಂಡಿರುವುದರಿಂದ,</para>
  <para style="q" vid="PSA 119:100">ಹಿರಿಯರಿಗಿಂತ ವಿವೇಕಿಯಾಗಿದ್ದೇನೆ.<verse eid="PSA 119:100"/></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101"/>ನಿನ್ನ ವಾಕ್ಯವನ್ನೇ ಅನುಸರಿಸಬೇಕೆಂದು,</para>
  <para style="q" vid="PSA 119:101">ನನ್ನ ಕಾಲುಗಳನ್ನು ಯಾವ ಕೆಟ್ಟ ದಾರಿಗೂ ಹೋಗದಂತೆ ಕಾದಿದ್ದೇನೆ.<verse eid="PSA 119:101"/></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102"/>ನಾನು ನಿನ್ನ ವಿಧಿಗಳಿಂದ ಸ್ವಲ್ಪವೂ ತಪ್ಪಿಹೋಗಲಿಲ್ಲ,</para>
  <para style="q" vid="PSA 119:102">ಏಕೆಂದರೆ ನೀನು ನನಗೆ ಬೋಧಿಸಿದ್ದೀ.<verse eid="PSA 119:102"/></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103"/>ನಿನ್ನ ನುಡಿಗಳು ನನ್ನ ನಾಲಿಗೆಗೆ ಎಷ್ಟೋ ರುಚಿಯಾಗಿವೆ,</para>
  <para style="q" vid="PSA 119:103">ಅವು ನನ್ನ ಬಾಯಿಗೆ ಜೇನು ತುಪ್ಪಕ್ಕಿಂತಲೂ ಸಿಹಿಯಾಗಿವೆ.<verse eid="PSA 119:103"/></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104"/>ನಿನ್ನ ನಿಯಮಗಳ ಮೂಲಕ ವಿವೇಕಿಯಾದೆನು,</para>
  <para style="q" vid="PSA 119:104">ಸುಳ್ಳು ಮಾರ್ಗವನ್ನೆಲ್ಲಾ ನಾನು ದ್ವೇಷಿಸುತ್ತೇನೆ.</para>
  <para style="d" vid="PSA 119:104">ನೂನ್.<verse eid="PSA 119:104"/></para>
  <para style="s">ದೇವರ ವಾಕ್ಯ ಕಾಲಿಗೆ ದೀಪ, ದಾರಿಗೆ ಬೆಳಕು</para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105"/>ನಿನ್ನ ವಾಕ್ಯವು ನನ್ನ ಕಾಲಿಗೆ ದೀಪವೂ,</para>
  <para style="q" vid="PSA 119:105">ನನ್ನ ದಾರಿಗೆ ಬೆಳಕೂ ಆಗಿದೆ.<verse eid="PSA 119:105"/></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106"/>ನಿನ್ನ ನೀತಿವಿಧಿಗಳನ್ನು ಅನುಸರಿಸುವೆನೆಂದು ಪ್ರಮಾಣಮಾಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:106">ಅದನ್ನು ನೆರವೇರಿಸುವೆನು.<verse eid="PSA 119:106"/></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107"/>ನಾನು ಬಹಳವಾಗಿ ಕುಗ್ಗಿಹೋಗಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:107">ಯೆಹೋವನೇ, ನಿನ್ನ ವಾಕ್ಯಾನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸು.<verse eid="PSA 119:107"/></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108"/>ಯೆಹೋವನೇ, ನನ್ನ ಮನಃಪೂರ್ವಕವಾದ ಸ್ತುತಿ ಸಮರ್ಪಣೆಗಳನ್ನು,</para>
  <para style="q" vid="PSA 119:108">ದಯವಿಟ್ಟು ಅಂಗೀಕರಿಸು,</para>
  <para style="q" vid="PSA 119:108">ನಿನ್ನ ವಿಧಿಗಳನ್ನು ನನಗೆ ಕಲಿಸು.<verse eid="PSA 119:108"/></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">119:109 </char>
      <char style="ft" closed="false">ನನ್ನ ಜೀವವನ್ನು ಕೈಯಲ್ಲೇ ಹಿಡಿದಿದ್ದೇನೆ.</char>
    </note>ನನ್ನ ಜೀವವು ಅಪಾಯದಲ್ಲಿದ್ದೆ,</para>
  <para style="q" vid="PSA 119:109">ಆದರೂ ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಮರೆಯುವುದಿಲ್ಲ.<verse eid="PSA 119:109"/></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110"/>ದುಷ್ಟರು ಬಲೆಯೊಡ್ಡಿದ್ದಾರೆ,</para>
  <para style="q" vid="PSA 119:110">ನಾನು ನಿನ್ನ ನಿಯಮಗಳಿಂದ ತಪ್ಪಿಹೋಗುವುದಿಲ್ಲ.<verse eid="PSA 119:110"/></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ನನ್ನ ನಿತ್ಯಸ್ವತ್ತಾಗಿ ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:111">ಅವು ನನ್ನ ಹೃದಯಕ್ಕೆ ಉಲ್ಲಾಸಕರವಾಗಿವೆ.<verse eid="PSA 119:111"/></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112"/>ಕಡೆಯವರೆಗು ಯಾವಾಗಲೂ ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಕೈಗೊಳ್ಳುವುದಕ್ಕೆ ಮನಸ್ಸುಮಾಡಿದ್ದೇನೆ.</para>
  <para style="d" vid="PSA 119:112">ಸಾಮೆಕ್.<verse eid="PSA 119:112"/></para>
  <para style="s">ಆಶ್ರಯವಾಗಿರುವ ದೇವರಾಜ್ಞೆಗಳು</para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113"/>ಚಂಚಲ ಮನಸ್ಸುಳ್ಳವರನ್ನು ದ್ವೇಷಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:113">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 119:113"/></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114"/>ನನ್ನ ಆಶ್ರಯವೂ, ಗುರಾಣಿಯೂ ನೀನೇ,</para>
  <para style="q" vid="PSA 119:114">ನಿನ್ನ ವಾಕ್ಯವನ್ನೇ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:114"/></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115"/>ದುಷ್ಟರೇ, ತೊಲಗಿರಿ,</para>
  <para style="q" vid="PSA 119:115">ನನ್ನ ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳುವೆನು.<verse eid="PSA 119:115"/></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116"/>ನಿನ್ನ ನುಡಿಯ ಪ್ರಕಾರ ನನ್ನನ್ನು ಉದ್ಧಾರಮಾಡು,</para>
  <para style="q" vid="PSA 119:116">ಆಗ ಬದುಕುವೆನು. ನಾನು ನಿರೀಕ್ಷೆಯುಳ್ಳವನಾಗಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:116">ನನ್ನನ್ನು ನಿರಾಶೆಪಡಿಸಬೇಡ.<verse eid="PSA 119:116"/></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117"/>ನೀನು ನನಗೆ ಆಧಾರವಾಗಿರು,</para>
  <para style="q" vid="PSA 119:117">ಆಗ ನಾನು ಸುರಕ್ಷಿತನಾಗಿ ಸದಾ ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಲಕ್ಷಿಸುವೆನು.<verse eid="PSA 119:117"/></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118"/>ನಿನ್ನ ನಿಬಂಧನೆಗಳಿಗೆ ತಪ್ಪಿದವರೆಲ್ಲರನ್ನು ನೀನು ತಳ್ಳಿಬಿಡುತ್ತೀ,</para>
  <para style="q" vid="PSA 119:118">ಅವರ ಕುಯುಕ್ತಿಯು ವ್ಯರ್ಥವಾದದ್ದೇ.<verse eid="PSA 119:118"/></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119"/>ಭೂಲೋಕದ ದುಷ್ಟರೆಲ್ಲರನ್ನು ಕಸದಂತೆ ತೆಗೆದುಬಿಡುತ್ತೀ,</para>
  <para style="q" vid="PSA 119:119">ಆದುದರಿಂದ ನಾನು ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ.<verse eid="PSA 119:119"/></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120"/>ನಿನ್ನ ಭಯದಿಂದ ನನ್ನ ದೇಹದ ಮಾಂಸವು ಕಂಪಿಸುತ್ತದೆ,</para>
  <para style="q" vid="PSA 119:120">ನಿನ್ನ ನ್ಯಾಯವಿಧಿಗಳಿಗೆ ಹೆದರುತ್ತೇನೆ.</para>
  <para style="d" vid="PSA 119:120">ಆಯಿನ್.<verse eid="PSA 119:120"/></para>
  <para style="s">ಅಪರಂಜಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠವಾದ ದೇವರ ವಾಕ್ಯಗಳು</para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121"/>ನಾನು ನಿನ್ನ ನೀತಿವಿಧಿಗಳನ್ನು ಅನುಸರಿಸಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:121">ಬಲಾತ್ಕಾರಿಗಳಿಗೆ ನನ್ನನ್ನು ಒಪ್ಪಿಸಬೇಡ.<verse eid="PSA 119:121"/></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122"/>ನಿನ್ನ ಸೇವಕನ ಮೇಲಿಗಾಗಿ ನೀನು ಹೊಣೆಗಾರನಾಗು,</para>
  <para style="q" vid="PSA 119:122">ಗರ್ವಿಷ್ಠರು ನನ್ನನ್ನು ಬಾಧಿಸದಿರಲಿ.<verse eid="PSA 119:122"/></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123"/>ನಿನ್ನ ರಕ್ಷಣೆಯನ್ನೂ, ನಿನ್ನ ನೀತಿಯುಳ್ಳ ನುಡಿಯು ನೆರವೇರುವುದನ್ನೂ ನಿರೀಕ್ಷಿಸುತ್ತಾ,</para>
  <para style="q" vid="PSA 119:123">ನನ್ನ ದೃಷ್ಟಿ ಮೊಬ್ಬಾಯಿತು.<verse eid="PSA 119:123"/></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124"/>ನಿನ್ನ ಸೇವಕನನ್ನು ಕೃಪೆಯಿಂದ ನಡೆಸು,</para>
  <para style="q" vid="PSA 119:124">ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ನನಗೆ ಕಲಿಸು.<verse eid="PSA 119:124"/></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125"/>ನಾನು ನಿನ್ನ ಸೇವಕನು,</para>
  <para style="q" vid="PSA 119:125">ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ ವಿವೇಕವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 119:125"/></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126"/>ಯೆಹೋವನೇ, ನೀನು ಕಾರ್ಯ ನಡೆಸುವುದಕ್ಕೆ ಸಮಯ ಬಂದಿದೆ,</para>
  <para style="q" vid="PSA 119:126">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಉಲ್ಲಂಘಿಸಿದ್ದಾರೆ.<verse eid="PSA 119:126"/></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127"/>ನಿಜವಾಗಿ ನಿನ್ನ ಆಜ್ಞೆಗಳು ಬಂಗಾರಕ್ಕಿಂತಲೂ,</para>
  <para style="q" vid="PSA 119:127">ಅಪರಂಜಿಗಿಂತಲೂ ನನಗೆ ಬಹುಪ್ರಿಯವಾಗಿವೆ.<verse eid="PSA 119:127"/></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128"/>ನಿಜವಾಗಿ ನಿನ್ನ ಎಲ್ಲಾ ನಿಯಮಗಳು ನ್ಯಾಯವಾಗಿವೆ ಎಂದು ಒಪ್ಪಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:128">ಎಲ್ಲಾ ಸುಳ್ಳು ಮಾರ್ಗಗಳನ್ನು ದ್ವೇಷಿಸುತ್ತೇನೆ.</para>
  <para style="d" vid="PSA 119:128">ಪೆ.<verse eid="PSA 119:128"/></para>
  <para style="s">ಕಟ್ಟಳೆಗಳನ್ನು ಪಾಲಿಸುವ ತವಕ</para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳು ಮಹತ್ವವುಳ್ಳವುಗಳೇ,</para>
  <para style="q" vid="PSA 119:129">ಪೂರ್ಣಹೃದಯದಿಂದ ಅವುಗಳನ್ನು ಕೈಗೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 119:129"/></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130"/>ನಿನ್ನ ವಾಕ್ಯವಿವರಣೆ ಬೆಳಕನ್ನು ಕೊಡುತ್ತದೆ,</para>
  <para style="q" vid="PSA 119:130">ಸರಳ ಹೃದಯರಿಗೆ ವಿವೇಚನೆಯನ್ನು ನೀಡುತ್ತದೆ.<verse eid="PSA 119:130"/></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131"/>ನಾನು ಬಾಯಾರಿ ನಿನ್ನನ್ನೇ ಎದುರುನೋಡುತ್ತಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:131">ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಲವಲವಿಕೆಯಿಂದ ಬಯಸಿದ್ದೇನೆ.<verse eid="PSA 119:131"/></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132"/>ನನಗೆ ಅಭಿಮುಖನಾಗಿ ಕರುಣಿಸು,</para>
  <para style="q" vid="PSA 119:132">ನಿನ್ನ ಹೆಸರನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ಹೀಗೆ ಮಾಡುವುದು ನಿನ್ನ ನಿಯಮವಲ್ಲವೇ?<verse eid="PSA 119:132"/></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133"/>ನಿನ್ನ ನುಡಿಗನುಸಾರವಾಗಿ ನನ್ನ ಹೆಜ್ಜೆಯನ್ನು ದೃಢಪಡಿಸು,</para>
  <para style="q" vid="PSA 119:133">ಯಾವ ಅನ್ಯಾಯವಾದರೂ ನನ್ನನ್ನು ಆಳದಂತೆ ಮಾಡು.<verse eid="PSA 119:133"/></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134"/>ನರ ಮನುಷ್ಯರ ಬಲಾತ್ಕಾರದಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು,</para>
  <para style="q" vid="PSA 119:134">ಆಗ ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಕೈಗೊಳ್ಳುವೆನು.<verse eid="PSA 119:134"/></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135"/>ನಿನ್ನ ದಾಸನ ಮೇಲೆ ನಿನ್ನ ಮುಖಪ್ರಸನ್ನತೆಯಿರಲಿ,</para>
  <para style="q" vid="PSA 119:135">ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ನನಗೆ ಕಲಿಸು.<verse eid="PSA 119:135"/></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಅನುಸರಿಸದವರ ನಿಮಿತ್ತ,</para>
  <para style="q" vid="PSA 119:136">ನನ್ನ ಕಣ್ಣೀರು ಪ್ರವಾಹವಾಗಿ ಹರಿಯುತ್ತದೆ.</para>
  <para style="d" vid="PSA 119:136">ಸಾದ್ದಿ.<verse eid="PSA 119:136"/></para>
  <para style="s">ಯೆಹೋವನ ನ್ಯಾಯ ವಿಧಿಗಳು</para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137"/>ಯೆಹೋವನೇ, ನೀನು ನೀತಿಸ್ವರೂಪನು,</para>
  <para style="q" vid="PSA 119:137">ನಿನ್ನ ವಿಧಿಗಳು ನ್ಯಾಯವಾಗಿವೆ.<verse eid="PSA 119:137"/></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138"/>ನೀತಿ, ಸತ್ಯತೆಗಳಿಂದಲೇ ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಿ,<verse eid="PSA 119:138"/></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139"/>ವೈರಿಗಳು ನಿನ್ನ ವಾಕ್ಯಗಳನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದರಿಂದ</para>
  <para style="q" vid="PSA 119:139">ನಿನ್ನ ಮೇಲಿನ ಅಭಿಮಾನ ನನ್ನನ್ನು ದಹಿಸಿಬಿಟ್ಟಿತು,<verse eid="PSA 119:139"/></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140"/>ನಿನ್ನ ನುಡಿಯು ಪರಿಶುದ್ಧವಾದದ್ದು,</para>
  <para style="q" vid="PSA 119:140">ನಿನ್ನ ಸೇವಕನು ಅದನ್ನೇ ಪ್ರೀತಿಸುತ್ತಾನೆ.<verse eid="PSA 119:140"/></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141"/>ನಾನು ಅಲ್ಪನೂ, ತಿರಸ್ಕಾರ ಹೊಂದಿದವನೂ ಆಗಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:141">ಆದರೂ ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಮರೆಯುವುದಿಲ್ಲ.<verse eid="PSA 119:141"/></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142"/>ನಿನ್ನ ನೀತಿಯು ನಿತ್ಯವಾಗಿದೆ,</para>
  <para style="q" vid="PSA 119:142">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವು ಸತ್ಯವಾಗಿದೆ.<verse eid="PSA 119:142"/></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143"/>ಕಷ್ಟ, ಸಂಕಟಗಳು ನನ್ನನ್ನು ಮುತ್ತಿಕೊಂಡಿವೆ,</para>
  <para style="q" vid="PSA 119:143">ಆದರೂ ನಿನ್ನ ಆಜ್ಞೆಗಳು ನನಗೆ ಸಂತೋಷಕರವಾಗಿವೆ.<verse eid="PSA 119:143"/></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳು ಸದಾಕಾಲವೂ ನೀತಿಯುಳ್ಳವುಗಳು,</para>
  <para style="q" vid="PSA 119:144">ನನಗೆ ವಿವೇಕವನ್ನು ದಯಪಾಲಿಸು, ಆಗ ಬದುಕುವೆನು.</para>
  <para style="d" vid="PSA 119:144">ಖೋಫ್.<verse eid="PSA 119:144"/></para>
  <para style="s">ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡುವುದು</para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145"/>ಯೆಹೋವನೇ, ಸಂಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:145">ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು,</para>
  <para style="q" vid="PSA 119:145">ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಅನುಸರಿಸುವೆನು.<verse eid="PSA 119:145"/></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146"/>ನಿನಗೇ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ ರಕ್ಷಿಸು.</para>
  <para style="q" vid="PSA 119:146">ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಕೈಗೊಳ್ಳುವೆನು.<verse eid="PSA 119:146"/></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147"/>ಅರುಣೋದಯದಲ್ಲಿ ಎದ್ದು ಮೊರೆಯಿಟ್ಟೆನು,</para>
  <para style="q" vid="PSA 119:147">ನಿನ್ನ ವಾಕ್ಯವನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:147"/></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148"/>ನಿನ್ನ ನುಡಿಯನ್ನು ಧ್ಯಾನಿಸಲು,</para>
  <para style="q" vid="PSA 119:148">ನನ್ನ ಕಣ್ಣುಗಳು ಇರುಳಿನ ಒಂದೊಂದು ಜಾವದಲ್ಲೂ ತೆರೆದಿರುತ್ತವೆ.<verse eid="PSA 119:148"/></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕೃಪೆಗೆ ತಕ್ಕಂತೆ ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳು,</para>
  <para style="q" vid="PSA 119:149">ನಿನ್ನ ವಿಧಿಗನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸು.<verse eid="PSA 119:149"/></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಬಿಟ್ಟು ಕೆಟ್ಟದ್ದನ್ನು ಅನುಸರಿಸುವವರು,</para>
  <para style="q" vid="PSA 119:150">ನನ್ನ ಸಮೀಪಕ್ಕೆ ಬಂದಿದ್ದಾರೆ.<verse eid="PSA 119:150"/></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151"/>ಯೆಹೋವನೇ, ನೀನು ನನ್ನ ಹತ್ತಿರವೇ ಇರುವೆ,</para>
  <para style="q" vid="PSA 119:151">ನಿನ್ನ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ಯಥಾರ್ಥವಾಗಿವೆ.<verse eid="PSA 119:151"/></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152"/>ನೀನು ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಸ್ಥಾಪಿಸಿದ್ದಿ ಎಂದು,</para>
  <para style="q" vid="PSA 119:152">ನಾನು ಮೊದಲಿನಿಂದಲೇ ಅವುಗಳ ಮೂಲಕ ತಿಳಿದುಕೊಂಡಿದ್ದೇನೆ.</para>
  <para style="d" vid="PSA 119:152">ರೇಷ್.<verse eid="PSA 119:152"/></para>
  <para style="s">ಸಂರಕ್ಷಣೆಗಾಗಿ ವಿಜ್ಞಾಪನೆ</para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153"/>ನನ್ನ ಕಷ್ಟವನ್ನು ನೋಡಿ ನನ್ನನ್ನು ರಕ್ಷಿಸು,</para>
  <para style="q" vid="PSA 119:153">ನಾನು ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಮರೆತವನಲ್ಲ.<verse eid="PSA 119:153"/></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154"/>ನನ್ನ ವ್ಯಾಜ್ಯವನ್ನು ನಡೆಸಿ ನನ್ನನ್ನು ಬಿಡಿಸು,</para>
  <para style="q" vid="PSA 119:154">ನಿನ್ನ ನುಡಿಗನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸು.<verse eid="PSA 119:154"/></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155"/>ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ಅಲಕ್ಷ್ಯಮಾಡುವ ದುಷ್ಟರಿಗೆ ರಕ್ಷಣೆಯೇ ಇಲ್ಲ.<verse eid="PSA 119:155"/></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಕೃಪಾಕಾರ್ಯಗಳು ಬಹಳವಾಗಿವೆ,</para>
  <para style="q" vid="PSA 119:156">ನಿನ್ನ ವಿಧಿಗಳಿಗೆ ತಕ್ಕಂತೆ ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸು.<verse eid="PSA 119:156"/></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157"/>ನನ್ನನ್ನು ಹಿಂಸಿಸುವ ವೈರಿಗಳು ಅನೇಕರಿದ್ದರೂ,</para>
  <para style="q" vid="PSA 119:157">ನಾನು ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಬಿಟ್ಟು ನಡೆಯಲಿಲ್ಲ.<verse eid="PSA 119:157"/></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158"/>ನಿನ್ನ ನುಡಿಯನ್ನು ಕೈಗೊಳ್ಳದ</para>
  <para style="q" vid="PSA 119:158">ಧರ್ಮಭ್ರಷ್ಟರನ್ನು ನೋಡಿ ಅಸಹ್ಯಪಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 119:158"/></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159"/>ಯೆಹೋವನೇ, ನೋಡು,</para>
  <para style="q" vid="PSA 119:159">ನಿನ್ನ ನಿಯಮಗಳು ನನಗೆ ಎಷ್ಟೋ ಪ್ರಿಯವಾಗಿವೆ,</para>
  <para style="q" vid="PSA 119:159">ನಿನ್ನ ಕೃಪಾನುಸಾರವಾಗಿ ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳಿಸು.<verse eid="PSA 119:159"/></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160"/>ನಿನ್ನ ವಾಕ್ಯದ ಸಾರಾಂಶವು ಸತ್ಯವೇ,</para>
  <para style="q" vid="PSA 119:160">ನಿನ್ನ ನೀತಿವಿಧಿಗಳೆಲ್ಲಾ ಯುಗಯುಗಾಂತರಕ್ಕೂ ಇರುವವು.</para>
  <para style="d" vid="PSA 119:160">ಷಿನ್.<verse eid="PSA 119:160"/></para>
  <para style="s">ಎಷ್ಟೋ ಪ್ರಿಯವಾದ ನೀತಿವಿಧಿಗಳು</para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161"/>ಪ್ರಭುಗಳು ಕಾರಣವಿಲ್ಲದೆ ನನ್ನನ್ನು ಹಿಂಸಿಸುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 119:161">ನನ್ನ ಹೃದಯವು ನಿನ್ನ ವಾಕ್ಯಕ್ಕೆ ಮಾತ್ರ ಭಯಪಡುತ್ತದೆ.<verse eid="PSA 119:161"/></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162"/>ಒಬ್ಬನು ತಾನು ಸಂಪಾದಿಸಿದ ದೊಡ್ಡ ಕೊಳ್ಳೆಯಲ್ಲಿ ಹೇಗೋ,</para>
  <para style="q" vid="PSA 119:162">ಹಾಗೆಯೇ ನಾನು ನಿನ್ನ ನುಡಿಯಲ್ಲಿ ಆನಂದಿಸುತ್ತೇನೆ.<verse eid="PSA 119:162"/></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163"/>ಮಿಥ್ಯವಾದದ್ದನ್ನು ದ್ವೇಷಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:163">ಅದು ನನಗೆ ಅಸಹ್ಯವಾಗಿದೆ,</para>
  <para style="q" vid="PSA 119:163">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವು ನನಗೆ ಪ್ರಿಯವಾಗಿದೆ.<verse eid="PSA 119:163"/></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164"/>ನಿನ್ನ ನೀತಿವಿಧಿಗಳಿಗೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 119:164">ನಿನ್ನನ್ನು ದಿನಕ್ಕೆ ಏಳು ಸಾರಿ ಕೊಂಡಾಡುತ್ತೇನೆ.<verse eid="PSA 119:164"/></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165"/>ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ,</para>
  <para style="q" vid="PSA 119:165">ಸಂಪೂರ್ಣ ಸಮಾಧಾನವಿರುತ್ತದೆ,</para>
  <para style="q" vid="PSA 119:165">ಅಂಥವರಿಗೆ ವಿಘ್ನಕರವಾದದ್ದೇನೂ ಇರುವುದಿಲ್ಲ.<verse eid="PSA 119:165"/></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166"/>ಯೆಹೋವನೇ, ಯಾವಾಗ ರಕ್ಷಿಸುವಿಯೋ ಎಂದು,</para>
  <para style="q" vid="PSA 119:166">ನಿರೀಕ್ಷಿಸುತ್ತಾ ಇದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:166">ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 119:166"/></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167"/>ನಿನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಅನುಸರಿಸಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:167">ಅವು ನನಗೆ ಬಹುಪ್ರಿಯವಾಗಿವೆ.<verse eid="PSA 119:167"/></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168"/>ನಿನ್ನ ನಿಯಮಗಳನ್ನೂ, ಕಟ್ಟಳೆಗಳನ್ನೂ ಅನುಸರಿಸಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:168">ನನ್ನ ನಡತೆಯೆಲ್ಲಾ ನಿನಗೆ ಗೋಚರವಾಗಿದೆ.</para>
  <para style="d" vid="PSA 119:168">ತಾವ್.<verse eid="PSA 119:168"/></para>
  <para style="s">ಯೆಹೋವನ ಸಹಾಯಕ್ಕಾಗಿ ಬೇಡಿಕೊಳ್ಳುವುದು</para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169"/>ಯೆಹೋವನೇ, ನನ್ನ ಕೂಗು ನಿನ್ನ ಸನ್ನಿಧಿಯನ್ನು ಮುಟ್ಟಲಿ,</para>
  <para style="q" vid="PSA 119:169">ನಿನ್ನ ವಾಕ್ಯಾನುಸಾರವಾಗಿ ನನಗೆ ಜ್ಞಾನವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 119:169"/></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170"/>ನನ್ನ ವಿಜ್ಞಾಪನೆಯು ನಿನ್ನ ಸನ್ನಿಧಿಗೆ ಸೇರಲಿ,</para>
  <para style="q" vid="PSA 119:170">ನಿನ್ನ ನುಡಿಗೆ ತಕ್ಕಂತೆ ನನ್ನನ್ನು ರಕ್ಷಿಸು.<verse eid="PSA 119:170"/></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171"/>ನಿನ್ನ ನಿಬಂಧನೆಗಳನ್ನು ನನಗೆ ಕಲಿಸಿದ್ದಿಯಲ್ಲಾ.</para>
  <para style="q" vid="PSA 119:171">ನನ್ನ ತುಟಿಗಳಿಂದ ಸದಾ ನಿನ್ನ ಸ್ತುತಿ ಹೊರಡಲಿ,<verse eid="PSA 119:171"/></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172"/>ನನ್ನ ನಾಲಿಗೆಯು ನಿನ್ನ ನುಡಿಗಳನ್ನು ವರ್ಣಿಸಲಿ,</para>
  <para style="q" vid="PSA 119:172">ನಿನ್ನ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ನೀತಿಯುಳ್ಳದ್ದು.<verse eid="PSA 119:172"/></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173"/>ನಿನ್ನ ನಿಯಮಗಳನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:173">ನಿನ್ನ ಕೈ ನನಗೆ ನೆರವಾಗಲಿ.<verse eid="PSA 119:173"/></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174"/>ಯೆಹೋವನೇ, ನಿನ್ನಿಂದುಂಟಾಗುವ ರಕ್ಷಣೆಯನ್ನು ಕೋರುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 119:174">ನಿನ್ನ ಧರ್ಮಶಾಸ್ತ್ರವೇ ನನ್ನ ಆನಂದವು.<verse eid="PSA 119:174"/></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175"/>ನನ್ನ ಪ್ರಾಣವನ್ನು ಉಳಿಸು,</para>
  <para style="q" vid="PSA 119:175">ಅದು ನಿನ್ನನ್ನು ಕೊಂಡಾಡಲಿ.</para>
  <para style="q" vid="PSA 119:175">ನಿನ್ನ ನಿಯಮಗಳಿಂದ ನನಗೆ ಸಹಾಯವಾಗಲಿ.<verse eid="PSA 119:175"/></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176"/>ನಾನು ತಪ್ಪಿಹೋದ ಕುರಿಯಂತೆ ಅಲೆಯುತ್ತಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 119:176">ನಿನ್ನ ಸೇವಕನನ್ನು ಪರಾಂಬರಿಸು.</para>
  <para style="q" vid="PSA 119:176">ನಾನು ನಿನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಮರೆಯುವುದಿಲ್ಲ.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s">ಮೋಸಗಾರರ ಮಧ್ಯದಲ್ಲಿ ವಾಸಿಸುವವನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1"/>ನನ್ನ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿ ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಟ್ಟೆನು;</para>
  <para style="q" vid="PSA 120:1">ಆತನು ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸಿದನು.<verse eid="PSA 120:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2"/>ಯೆಹೋವನೇ, ಸುಳ್ಳು ಬಾಯಿಯೂ,</para>
  <para style="q" vid="PSA 120:2">ವಂಚಿಸುವ ನಾಲಿಗೆ ಉಳ್ಳವರಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು.<verse eid="PSA 120:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3"/>ವಂಚಿಸುವ ನಾಲಿಗೆಯೇ, ದೇವರು ನಿನಗೇನು ಕೊಡಬೇಕು?</para>
  <para style="q" vid="PSA 120:3">ಯಾವ ಹೆಚ್ಚಿನ ಶಿಕ್ಷೆಯನ್ನು ಒದಗಿಸಬೇಕು?<verse eid="PSA 120:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4"/>ಶೂರನ<note caller="+" style="f"><char style="fr" closed="false">120:4 </char><char style="fq" closed="false">ಶೂರನ </char><char style="ft" closed="false">ಬಲಿಷ್ಠನ.</char></note> ಹದವಾದ ಬಾಣಗಳನ್ನೂ,</para>
  <para style="q" vid="PSA 120:4">ಜಾಲಿಯ ಕೆಂಡಗಳನ್ನೂ ನಿನಗೆ ಕೊಡುವರು.<verse eid="PSA 120:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5"/>ಅಯ್ಯೋ, ನಾನು ಮೇಷೆಕಿನವರಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">120:5 </char><char style="fq" closed="false">ಮೇಷೆಕಿನವರಲ್ಲಿ </char><char style="ft" closed="false">ಮೇಷೆಕ್ ಕಪ್ಪು ಸಮುದ್ರ ಮತ್ತು ಕ್ಯಾಸ್ಪಿಯನ್ ಸಮುದ್ರದ ನಡುವೆಯಿರುವ ಪ್ರದೇಶವಾಗಿದೆ, ಕೇದಾರನಿಂದ ಬಹಳ ದೂರವಿದೆ. ಕೇದಾರ್ ಮರುಭೂಮಿ ಪ್ರದೇಶವಾಗಿದ್ದು, ಬುಡಕಟ್ಟು ಜನಾಂಗದವರು ಸಿರಿಯಾದಲ್ಲಿನ ದಕ್ಷಿಣದ ದಮಸ್ಕದಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದರು. ಆ ಪ್ರದೇಶಗಳ ಜನರು ಬಹಳ ಹಿಂಸಾತ್ಮಕರಾಗಿದ್ದರು.</char></note> ತಂಗಬೇಕಲ್ಲಾ!</para>
  <para style="q" vid="PSA 120:5">ಕೇದಾರಿನವರ ಪಾಳೆಯಗಳಲ್ಲಿ ವಾಸಿಸಬೇಕಾಯಿತಲ್ಲಾ!<verse eid="PSA 120:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6"/>ಸಮಾಧಾನವನ್ನು ದ್ವೇಷಿಸುವವರೊಳಗೆ,</para>
  <para style="q" vid="PSA 120:6">ಇದ್ದು ಇದ್ದು ಸಾಕಾಯಿತು.<verse eid="PSA 120:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7"/>ನಾನು ಸಮಾಧಾನಪ್ರಿಯನು;</para>
  <para style="q" vid="PSA 120:7">ಅವರೋ, ನಾನು ಮಾತನಾಡಿದರೆ ಯುದ್ಧಕ್ಕೆ ಬರುತ್ತಾರೆ.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s">ಯೆಹೋವನ ಭಕ್ತಪಾಲನೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="r">
    <ref loc="GEN 28:15">ಆದಿ 28:15</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1"/>ನಾನು ಕಣ್ಣೆತ್ತಿ ಪರ್ವತಗಳ ಕಡೆಗೆ ನೋಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 121:1">ನನ್ನ ಸಹಾಯವು ಎಲ್ಲಿಂದ ಬರುವುದು?<verse eid="PSA 121:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2"/>ಭೂಮಿ, ಆಕಾಶಗಳನ್ನು ನಿರ್ಮಿಸಿದ ಯೆಹೋವನಿಂದಲೇ,</para>
  <para style="q" vid="PSA 121:2">ನನ್ನ ಸಹಾಯವು ಬರುತ್ತದೆ.<verse eid="PSA 121:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3"/>ಆತನು ನಿನ್ನ ಪಾದಗಳನ್ನು ಕದಲಗೊಡಿಸುವುದಿಲ್ಲ;</para>
  <para style="q" vid="PSA 121:3">ನಿನ್ನನ್ನು ಕಾಯುವವನು ತೂಕಡಿಸದಿರಲಿ.<verse eid="PSA 121:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4"/>ಇಗೋ, ಇಸ್ರಾಯೇಲರನ್ನು ಕಾಯುವಾತನು,</para>
  <para style="q" vid="PSA 121:4">ತೂಕಡಿಸುವುದೂ ಇಲ್ಲ, ನಿದ್ರಿಸುವುದೂ ಇಲ್ಲ.<verse eid="PSA 121:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5"/>ನಿನ್ನನ್ನು ಕಾಯುವವನು ಯೆಹೋವನೇ;</para>
  <para style="q" vid="PSA 121:5">ನಿನ್ನ ಬಲಗಡೆಯಲ್ಲಿ ನೆರಳಿನಂತೆ ನಿಂತಿರುವಾತನು ಯೆಹೋವನೇ.<verse eid="PSA 121:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6"/>ಹಗಲಿನಲ್ಲಿ ಸೂರ್ಯನೂ, ಇರುಳಿನಲ್ಲಿ ಚಂದ್ರನೂ,</para>
  <para style="q" vid="PSA 121:6">ನಿನ್ನನ್ನು ಬಾಧಿಸುವುದಿಲ್ಲ.<verse eid="PSA 121:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7"/>ಯೆಹೋವನು ನಿನ್ನನ್ನು ಎಲ್ಲಾ ಕೇಡಿನಿಂದ ತಪ್ಪಿಸುವನು;</para>
  <para style="q" vid="PSA 121:7">ನಿನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಯುವನು.<verse eid="PSA 121:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8"/>ನೀನು ಹೋಗುವಾಗಲೂ, ಬರುವಾಗಲೂ,</para>
  <para style="q" vid="PSA 121:8">ಈಗಿನಿಂದ ಸದಾಕಾಲವೂ ಯೆಹೋವನು ನಿನ್ನನ್ನು ಕಾಪಾಡುವನು.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s">ಯಾತ್ರಿಕರು ಯೆರೂಸಲೇಮನ್ನು ಸ್ಮರಿಸುವುದು</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1"/>“ಯೆಹೋವನ ಮಂದಿರಕ್ಕೆ ಹೋಗೋಣ ಬಾ!”</para>
  <para style="q" vid="PSA 122:1">ಎಂದು ಜನರು ನನ್ನನ್ನು ಕರೆದಾಗ ನನಗೆ ಸಂತೋಷವಾಯಿತು.<verse eid="PSA 122:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2"/>ಯೆರೂಸಲೇಮೇ! ನಮ್ಮ ಕಾಲುಗಳು,</para>
  <para style="q" vid="PSA 122:2">ನಿನ್ನ ಬಾಗಿಲುಗಳಲ್ಲಿ ಸೇರಿರುತ್ತವಲ್ಲಾ.<verse eid="PSA 122:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3"/>ಯೆರೂಸಲೇಮೇ! ನೀನು ಸರಿಯಾದ ಹೊಂದಿಕೆಯಿಂದ,</para>
  <para style="q" vid="PSA 122:3">ಕಟ್ಟಲ್ಪಟ್ಟ ನಗರವಾಗಿದ್ದಿ.<verse eid="PSA 122:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4"/>ಕುಲಗಳು ಅಂದರೆ ಯೆಹೋವನ ಕುಲದವರು,</para>
  <para style="q" vid="PSA 122:4">ಯೆಹೋವನ ನಾಮದ ಕೀರ್ತನೆಗೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 122:4">ಇಲ್ಲಿಗೆ ಯಾತ್ರೆ ಮಾಡುತ್ತಿದ್ದರು.</para>
  <para style="q" vid="PSA 122:4">ಇದು ಇಸ್ರಾಯೇಲರಲ್ಲಿದ್ದ ಕಟ್ಟಳೆಯಷ್ಟೆ.<verse eid="PSA 122:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5"/>ನ್ಯಾಯಪೀಠಗಳಾಗಿರುವ ದಾವೀದನ ಮನೆತನದವರ,</para>
  <para style="q" vid="PSA 122:5">ಸಿಂಹಾಸನಗಳು ಇಲ್ಲಿಯೇ ಇದ್ದವಲ್ಲಾ.<verse eid="PSA 122:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6"/>ಯೆರೂಸಲೇಮಿನ ಸಮಾಧಾನಕ್ಕಾಗಿ ಪ್ರಾರ್ಥಿಸಿರಿ.</para>
  <para style="q" vid="PSA 122:6">“ಯೆರೂಸಲೇಮೇ, ನಿನ್ನನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ಸೌಭಾಗ್ಯವುಂಟಾಗಲಿ.<verse eid="PSA 122:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7"/>ನಿನ್ನ ಪೌಳಿಗೋಡೆಗಳೊಳಗೆ ಶುಭವುಂಟಾಗಲಿ;</para>
  <para style="q" vid="PSA 122:7">ನಿನ್ನ ಅರಮನೆಗಳಲ್ಲಿ ಸೌಭಾಗ್ಯವಿರಲಿ.”<verse eid="PSA 122:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8"/>ನನ್ನ ಬಂಧುಮಿತ್ರರ ನಿಮಿತ್ತವಾಗಿ,</para>
  <para style="q" vid="PSA 122:8">“ನಿನಗೆ ಸಮಾಧಾನವಾಗಲಿ” ಎಂದು ಹೇಳುತ್ತೇನೆ.<verse eid="PSA 122:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9"/>ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವನ ಮಂದಿರದ ನಿಮಿತ್ತವಾಗಿ,</para>
  <para style="q" vid="PSA 122:9">ನಿನ್ನ ಸುಕ್ಷೇಮಕ್ಕಾಗಿ ಪ್ರಾರ್ಥಿಸುತ್ತೇನೆ.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s">ಬಾಧಿಸಲ್ಪಟ್ಟವನ ನಿರೀಕ್ಷೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="r">
    <ref loc="NEH 4:1-6">ನೆಹೆ 4:1-6</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1"/>ಪರಲೋಕದಲ್ಲಿ ಆಸೀನನಾಗಿರುವಾತನೇ,</para>
  <para style="q" vid="PSA 123:1">ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ನಿನ್ನ ಕಡೆಗೆ ಎತ್ತಿದ್ದೇನೆ.<verse eid="PSA 123:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2"/>ಯಜಮಾನನ ಕೈಯನ್ನು ದಾಸನ ಕಣ್ಣುಗಳು,</para>
  <para style="q" vid="PSA 123:2">ಯಜಮಾನಿಯ ಕೈಯನ್ನು ದಾಸಿಯ ಕಣ್ಣುಗಳು ನೋಡುವ ಪ್ರಕಾರವೇ,</para>
  <para style="q" vid="PSA 123:2">ನಮ್ಮ ಕಣ್ಣುಗಳು ನಮ್ಮ ಯೆಹೋವ ದೇವರನ್ನು ನೋಡುತ್ತಾ,</para>
  <para style="q" vid="PSA 123:2">ಆತನ ಕಟಾಕ್ಷವನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿವೆ.<verse eid="PSA 123:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3"/>ಯೆಹೋವನೇ, ನಮ್ಮನ್ನು ಕಟಾಕ್ಷಿಸು, ಕಟಾಕ್ಷಿಸು.</para>
  <para style="q" vid="PSA 123:3">ಅವಮಾನ ಹೊಂದಿ ಹೊಂದಿ ನಮಗೆ ಸಾಕಾಯಿತು;<verse eid="PSA 123:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4"/>ಲೋಕಭೋಗಿಗಳ ಹಾಸ್ಯದಿಂದಲೂ,</para>
  <para style="q" vid="PSA 123:4">ಗರ್ವಿಷ್ಠರ ನಿಂದೆಯಿಂದಲೂ ನಮ್ಮ ಮನಸ್ಸು ಬೇಸತ್ತು ಹೋಯಿತು.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s">ಯೆಹೋವನೊಬ್ಬನೇ ರಕ್ಷಕನು</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ; ದಾವೀದನದು.</para>
  <para style="r">
    <ref loc="PSA 129">ಕೀರ್ತ 129</ref>; <ref loc="NEH 4:7-23">ನೆಹೆ 4:7-23</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1"/>“ಯೆಹೋವನು ನಮಗಿಲ್ಲದಿದ್ದರೆ ನಮ್ಮ ಗತಿ ಏನಾಗುತ್ತಿತ್ತು?”,</para>
  <para style="q" vid="PSA 124:1">ಎಂದು ಇಸ್ರಾಯೇಲರೇ ಹೇಳಲಿ.<verse eid="PSA 124:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2"/>ನರ ಮನುಷ್ಯರು ನಮಗೆ ವಿರುದ್ಧವಾಗಿ ಎದ್ದಾಗ,</para>
  <para style="q" vid="PSA 124:2">ಯೆಹೋವನು ನಮಗಿಲ್ಲದಿದ್ದರೆ,<verse eid="PSA 124:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3"/>“ನಿಶ್ಚಯವಾಗಿ ಅವರು ಕೋಪದಿಂದ ಉರಿಗೊಂಡು,</para>
  <para style="q" vid="PSA 124:3">ನಮ್ಮನ್ನು ಜೀವಸಹಿತ ನುಂಗಿಬಿಡುತ್ತಿದ್ದರು;<verse eid="PSA 124:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4"/>ನಿಶ್ಚಯವಾಗಿ ಪ್ರವಾಹವು ನಮ್ಮನ್ನು ಬಡಿದುಕೊಂಡು ಹೋಗುತ್ತಿತ್ತು;</para>
  <para style="q" vid="PSA 124:4">ನದಿಯು ನಮ್ಮನ್ನು ಕೊಚ್ಚಿಕೊಂಡು ಹೋಗುತ್ತಿತ್ತು;<verse eid="PSA 124:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5"/>ಮೀರಿದ ಪ್ರವಾಹವು ನಮ್ಮನ್ನು ಮುಳುಗಿಸಿಬಿಡುತ್ತಿತ್ತು.”<verse eid="PSA 124:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6"/>ಯೆಹೋವನಿಗೆ ಕೊಂಡಾಟವಾಗಲಿ;</para>
  <para style="q" vid="PSA 124:6">ಆತನು ನಮ್ಮನ್ನು ಅವರ ಹಲ್ಲುಗಳಿಗೆ ಸೀಳಿಬಿಡಲು ಕೊಡಲಿಲ್ಲ.<verse eid="PSA 124:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7"/>ನಮ್ಮ ಜೀವವು ಬೇಟೆಗಾರನ ಬಲೆಯಿಂದ ತಪ್ಪಿಸಿಕೊಂಡ ಪಕ್ಷಿಯಂತಿದೆ;</para>
  <para style="q" vid="PSA 124:7">ಬಲೆಯು ಹರಿದುಹೋಯಿತು, ನಾವು ತಪ್ಪಿಸಿಕೊಂಡೆವು.<verse eid="PSA 124:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8"/>ಭೂಮಿ, ಆಕಾಶಗಳನ್ನು ಉಂಟುಮಾಡಿದ,</para>
  <para style="q" vid="PSA 124:8">ಯೆಹೋವನ ನಾಮದಲ್ಲಿ ನಮಗೆ ರಕ್ಷಣೆಯಾಗುವುದು.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s">ಯೆಹೋವನೇ ವಿಶ್ವಾಸಿಗಳ ಆಶ್ರಯ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1"/>ಯೆಹೋವನಲ್ಲಿ ಭರವಸೆ ಇಡುವವರು,</para>
  <para style="q" vid="PSA 125:1">ಚೀಯೋನ್ ಪರ್ವತದ ಹಾಗೆ ಇದ್ದಾರೆ;</para>
  <para style="q" vid="PSA 125:1">ಅದು ಕದಲುವುದಿಲ್ಲ, ಸದಾ ಸ್ಥಿರವಾಗಿರುತ್ತದೆ.<verse eid="PSA 125:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2"/>ಪರ್ವತಗಳು ಯೆರೂಸಲೇಮಿನ ಸುತ್ತಲೂ ಹೇಗೋ ಹಾಗೆಯೇ,</para>
  <para style="q" vid="PSA 125:2">ಯೆಹೋವನು ಈಗಿನಿಂದ ಸದಾಕಾಲವೂ ತನ್ನ ಜನರ ಸುತ್ತಲೂ ಇರುವನು.<verse eid="PSA 125:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3"/>ದುಷ್ಟರ ದಂಡಾಧಿಕಾರವು ನೀತಿವಂತರ ಸ್ವತ್ತಿನಲ್ಲಿ ಉಳಿಯುವುದೇ ಇಲ್ಲ;</para>
  <para style="q" vid="PSA 125:3">ಉಳಿದರೆ ನೀತಿವಂತರೂ ಅಕ್ರಮಕ್ಕೆ ಕೈ ಹಾಕಬಹುದು.<verse eid="PSA 125:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4"/>ಯೆಹೋವನೇ, ಒಳ್ಳೆಯವರೂ, ಯಥಾರ್ಥಚಿತ್ತರೂ,</para>
  <para style="q" vid="PSA 125:4">ಆಗಿರುವವರಿಗೆ ಉಪಕಾರಮಾಡು.<verse eid="PSA 125:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5"/>ಯೆಹೋವನು ಡೊಂಕುದಾರಿ ಹಿಡಿದವರನ್ನು,</para>
  <para style="q" vid="PSA 125:5">ಪಾತಕಿಗಳು ಹೋಗುವ ಸ್ಥಳಕ್ಕೆ ನಡೆಸುವನು.</para>
  <para style="q" vid="PSA 125:5">ಇಸ್ರಾಯೇಲರಿಗೆ ಶುಭವುಂಟಾಗಲಿ.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s">ಚೀಯೋನಿನ ಸೌಭಾಗ್ಯದ ಪುನಃಸ್ಥಾಪನೆಗಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="r">
    <ref loc="PSA 85">ಕೀರ್ತ 85</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">126:1 </char>
      <char style="ft" closed="false">ಅಥವಾ ಯೆಹೋವನು ನಮ್ಮನ್ನು ಸೆರೆಯಿಂದ ತಿರುಗಿ ಚೀಯೋನಿಗೆ ಬರಮಾಡಿದಾಗ ಆತನು ಚೀಯೋನನ್ನು ಪುನಃಸ್ಥಾಪಿಸಿದನು ಅಥವಾ ಅಭಿವೃದ್ಧಿಪಡಿಸು. ಚೀಯೋನ್ ಅಂದರೆ ಯೆರೂಸಲೇಮ್. </char>
    </note>ಸೆರೆಯಲ್ಲಿದ್ದ ನಮ್ಮನ್ನು ಯೆಹೋವನು ತಿರುಗಿ ಚೀಯೋನಿಗೆ ಬರಮಾಡಿದಾಗ,</para>
  <para style="q" vid="PSA 126:1">ನಾವು ಕನಸು ಕಂಡವರಂತೆ ಇದ್ದೆವು.<verse eid="PSA 126:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2"/>ಆಗ ನಮ್ಮ ಬಾಯಿ ಬಲು ನಗೆಯಿಂದಲೂ,</para>
  <para style="q" vid="PSA 126:2">ನಮ್ಮ ನಾಲಿಗೆ ಹರ್ಷಗೀತದಿಂದಲೂ ತುಂಬಿದವು.</para>
  <para style="q" vid="PSA 126:2">ಅನ್ಯಜನರು, “ಯೆಹೋವನು ಇವರಿಗೋಸ್ಕರ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ್ದಾನೆ” ಎಂದು</para>
  <para style="q" vid="PSA 126:2">ತಮ್ಮೊಳಗೆ ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಿದ್ದರು.<verse eid="PSA 126:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3"/>ಯೆಹೋವನು ನಮಗೋಸ್ಕರ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡಿದ್ದು ನಿಜ;</para>
  <para style="q" vid="PSA 126:3">ಆದುದರಿಂದ ನಾವು ಸಂತೋಷವುಳ್ಳವರಾಗಿದ್ದೇವೆ.<verse eid="PSA 126:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4"/>ಯೆಹೋವನೇ, ನೀನು ದಕ್ಷಿಣದೇಶದ ಹಳ್ಳಗಳನ್ನೋ ಎಂಬಂತೆ,</para>
  <para style="q" vid="PSA 126:4">
    <note caller="+" style="f">
      <char style="fr" closed="false">126:4 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಮ್ಮನ್ನು ಪುನಃಸ್ಥಾಪಿಸು ಅಥವಾ ಅಭಿವೃದ್ಧಿಪಡಿಸು.</char>
    </note>ಸೆರೆಯಲ್ಲಿ ಉಳಿದಿರುವ ನಮ್ಮವರನ್ನೂ ತಿರುಗಿ ಬರಮಾಡು.<verse eid="PSA 126:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5"/>ಅಳುತ್ತಾ ಬಿತ್ತುವವರು, ಹಾಡುತ್ತಾ ಕೊಯ್ಯುವರು,<verse eid="PSA 126:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6"/>ದುಃಖಿಸುತ್ತಾ ಬೀಜವನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗುವವನು,</para>
  <para style="q" vid="PSA 126:6">ಹರ್ಷಿಸುತ್ತಾ ಸಿವುಡುಗಳನ್ನು ಹೊತ್ತುಕೊಂಡು ಬರುವನು.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s">ಯೆಹೋವನ ಕೃಪೆಯಿಂದಲೇ ಕೃತಾರ್ಥರಾಗುವೆವು</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ; ಸೊಲೊಮೋನನದು.</para>
  <para style="r">
    <ref loc="NEH 7:3-4">ನೆಹೆ 7:3-4</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1"/>ಯೆಹೋವನು ಮನೆಯನ್ನು ಕಟ್ಟದಿದ್ದರೆ,</para>
  <para style="q" vid="PSA 127:1">ಅದನ್ನು ಕಟ್ಟುವವರು ಕಷ್ಟಪಡುವುದು ವ್ಯರ್ಥ;</para>
  <para style="q" vid="PSA 127:1">ಯೆಹೋವನು ಪಟ್ಟಣವನ್ನು ಕಾಯದಿದ್ದರೆ,</para>
  <para style="q" vid="PSA 127:1">ಕಾವಲುಗಾರರು ಅದನ್ನು ಕಾಯುವುದು ವ್ಯರ್ಥ.<verse eid="PSA 127:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2"/>ಬೆಳಗಾಗುವುದಕ್ಕಿಂತ ಮುಂಚೆ ಏಳುವವರೇ,</para>
  <para style="q" vid="PSA 127:2">ಹೊತ್ತು ಮೀರಿ ಮಲಗುವವರೇ,</para>
  <para style="q" vid="PSA 127:2">ನೀವು ಆಹಾರಕ್ಕಾಗಿ ಇಷ್ಟು ಕಷ್ಟಪಡುವುದು ವ್ಯರ್ಥ;</para>
  <para style="q" vid="PSA 127:2">
    <note caller="+" style="f">
      <char style="fr" closed="false">127:2 </char>
      <char style="ft" closed="false">ಅಥವಾ ಆತನು ತನ್ನ ಪ್ರಿಯರಿಗೆ ನಿದ್ರೆಯನ್ನು ಅಥವಾ ಪ್ರತಿಫಲವನ್ನು ಕೊಡುತ್ತಾನೆ.</char>
    </note>ಆತನು ಅದನ್ನು ತನ್ನ ಪ್ರಿಯರಿಗೆ ನಿದ್ರೆಯಲ್ಲಿಯೂ ಕೊಡುತ್ತಾನೆ.<verse eid="PSA 127:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3"/>ಪುತ್ರಸಂತಾನವು ಯೆಹೋವನಿಂದ ಬಂದ ಸ್ವತ್ತು;</para>
  <para style="q" vid="PSA 127:3">ಗರ್ಭಫಲವು ಆತನ ಬಹುಮಾನವೇ.<verse eid="PSA 127:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4"/>ಯೌವನದಲ್ಲಿ ಹುಟ್ಟಿದ ಮಕ್ಕಳು,</para>
  <para style="q" vid="PSA 127:4">ಯುದ್ಧವೀರನ ಕೈಯಲ್ಲಿರುವ ಅಂಬುಗಳಂತಿದ್ದಾರೆ;<verse eid="PSA 127:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5"/>ಇವುಗಳಿಂದ ತನ್ನ ಬತ್ತಳಿಕೆಯನ್ನು ತುಂಬಿದವನು ಧನ್ಯನು.</para>
  <para style="q" vid="PSA 127:5">ಊರ ಬಾಗಿಲಲ್ಲಿ ವೈರಿಗಳ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡುವಾಗ</para>
  <para style="q" vid="PSA 127:5">ಅಂಥವರು ಅವಮಾನ ಹೊಂದುವುದಿಲ್ಲ.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s">ಭಕ್ತನ ಭಾಗ್ಯ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="r">
    <ref loc="PSA 127">ಕೀರ್ತ 127</ref>; <ref loc="PSA 144:12-15">144:12-15</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1"/>ಯೆಹೋವನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿ,</para>
  <para style="q" vid="PSA 128:1">ಆತನ ಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆಯುವವನು ಧನ್ಯನು.<verse eid="PSA 128:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2"/>ನಿನ್ನ ಕಷ್ಟಾರ್ಜಿತವನ್ನು ನೀನೇ ಅನುಭವಿಸುವಿ,</para>
  <para style="q" vid="PSA 128:2">ನೀನು ಧನ್ಯನು, ನಿನಗೆ ಶುಭವಿರುವುದು.<verse eid="PSA 128:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3"/>ಅಂತಃಪುರದಲ್ಲಿರುವ ನಿನ್ನ ಹೆಂಡತಿಯು,</para>
  <para style="q" vid="PSA 128:3">ಫಲಭರಿತವಾದ ದ್ರಾಕ್ಷಾಲತೆಯಂತೆ ಇರುವಳು;</para>
  <para style="q" vid="PSA 128:3">ನಿನ್ನ ಸಂಗಡ ಊಟದ ಮಣೆಯ ಸುತ್ತಲೂ ಕುಳಿತುಕೊಳ್ಳುವ ನಿನ್ನ ಮಕ್ಕಳು,</para>
  <para style="q" vid="PSA 128:3">ಎಣ್ಣೇಮರದ ಸಸಿಗಳ ಹಾಗೆ ಇರುವರು.<verse eid="PSA 128:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4"/>ಇಗೋ, ಯೆಹೋವನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳ ಪುರುಷನು,</para>
  <para style="q" vid="PSA 128:4">ಈ ರೀತಿಯಾಗಿ ಆಶೀರ್ವಾದ ಹೊಂದುವನು.<verse eid="PSA 128:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5"/>ಚೀಯೋನಿನಲ್ಲಿರುವ ಯೆಹೋವನು ನಿನ್ನನ್ನು ಆಶೀರ್ವದಿಸಲಿ;</para>
  <para style="q" vid="PSA 128:5">ಜೀವಮಾನವೆಲ್ಲಾ ಯೆರೂಸಲೇಮಿನ ಸೌಭಾಗ್ಯವನ್ನು ನೋಡುವವನಾಗು.<verse eid="PSA 128:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6"/>ಮಕ್ಕಳ ಮಕ್ಕಳನ್ನು ಕಾಣುವವನಾಗು.</para>
  <para style="q" vid="PSA 128:6">ಇಸ್ರಾಯೇಲರಿಗೆ ಶುಭವಾಗಲಿ.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s">ಯೆಹೋವನು ತನ್ನ ಭಕ್ತರನ್ನು ಶತ್ರುಗಳಿಂದ ಬಿಡಿಸುವನೆಂಬ ನಿರೀಕ್ಷೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="r">
    <ref loc="PSA 124">ಕೀರ್ತ 124</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1"/>“ನಮ್ಮ ಯೌವನ ಕಾಲದಿಂದ ಶತ್ರುಗಳು ನಮ್ಮನ್ನು ಹಲವು ಸಾರಿ ಬಾಧಿಸಿದ್ದಾರೆ”</para>
  <para style="q" vid="PSA 129:1">ಎಂದು ಇಸ್ರಾಯೇಲರು ಹೇಳಲಿ.<verse eid="PSA 129:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2"/>“ನಾವು ಯೌವನ ಕಾಲದಿಂದ ಎಷ್ಟೋ ಸಾರಿ ಬಾಧೆ ಹೊಂದಿದರೂ,</para>
  <para style="q" vid="PSA 129:2">ಅವರು ನಮ್ಮನ್ನು ಜಯಿಸಲಿಲ್ಲ.<verse eid="PSA 129:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3"/>ಉಳುವವರು ನಮ್ಮ ಬೆನ್ನಿನ ಮೇಲೆ ಉಳುತ್ತಾ,</para>
  <para style="q" vid="PSA 129:3">ಉದ್ದವಾದ ಗೆರೆಗಳನ್ನು ಹಾಕಿದರು.”<verse eid="PSA 129:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4"/>ಆದರೆ ನೀತಿಸ್ವರೂಪನಾದ ಯೆಹೋವನು,</para>
  <para style="q" vid="PSA 129:4">
    <note caller="+" style="f">
      <char style="fr" closed="false">129:4 </char>
      <char style="ft" closed="false">ಅಥವಾ ದುಷ್ಟರ ಬಂಧನಗಳಿಂದ ಬಿಡಿಸಿದನು.</char>
    </note>ದುಷ್ಟರು ಹಾಕಿದ ಬಂಧನಗಳನ್ನು ಛೇದಿಸಿಬಿಟ್ಟನು.<verse eid="PSA 129:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5"/>ಚೀಯೋನನ್ನು ದ್ವೇಷಿಸುವವರೆಲ್ಲರೂ ಅವಮಾನದಿಂದ ಹಿಂದಿರುಗಲಿ.<verse eid="PSA 129:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6"/>ಅವರು ಮಾಳಿಗೆಯ ಮೇಲಣ ಹುಲ್ಲಿನಂತಾಗಲಿ;</para>
  <para style="q" vid="PSA 129:6">ಅದು ಹೂವು ಬಿಡುವುದಕ್ಕೆ ಮೊದಲೇ ಒಣಗಿಹೋಗುತ್ತದೆ;<verse eid="PSA 129:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7"/>ಅದನ್ನು ಕೊಯ್ಯುವವನ ಹಿಡಿಯೂ,</para>
  <para style="q" vid="PSA 129:7">ಸಿವುಡು ಕಟ್ಟುವವನ ಉಡಿಲೂ ತುಂಬುವುದಿಲ್ಲ.<verse eid="PSA 129:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8"/>ಹಾದುಹೋಗುವವರು, “ಯೆಹೋವನು ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸಲಿ ಎಂದು,</para>
  <para style="q" vid="PSA 129:8">ಯೆಹೋವನ ನಾಮದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಆಶೀರ್ವದಿಸುತ್ತೇವೆ” ಎಂದೂ ಹೇಳುವುದಿಲ್ಲ.<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s">ಪಾಪಪರಿಹಾರಕ್ಕಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="r">
    <ref loc="NEH 1:4-11">ನೆಹೆ 1:4-11</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1"/>ಯೆಹೋವನೇ, ಪಾತಾಳದಲ್ಲಿದ್ದು ನಿನ್ನನ್ನು ಕೂಗಿಕೊಳ್ಳುತ್ತೇನೆ.<verse eid="PSA 130:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2"/>ಕರ್ತನೇ, ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳು;</para>
  <para style="q" vid="PSA 130:2">ನನ್ನ ವಿಜ್ಞಾಪನೆಯ ಶಬ್ದಕ್ಕೆ ಕಿವಿದೆರೆ.<verse eid="PSA 130:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3"/>ಕರ್ತನೇ, ಯೆಹೋವನೇ, ನೀನು ಪಾಪಗಳನ್ನು ಲೆಕ್ಕಿಸುವುದಾದರೆ</para>
  <para style="q" vid="PSA 130:3">ನಿನ್ನ ಮುಂದೆ ಯಾರು ನಿಲ್ಲಲು ಸಾಧ್ಯ?<verse eid="PSA 130:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4"/>ನೀನು ಪಾಪವನ್ನು ಕ್ಷಮಿಸುವವನಾದುದರಿಂದ,</para>
  <para style="q" vid="PSA 130:4">ಮನುಷ್ಯರ ಭಯಭಕ್ತಿಗೆ ನೀನೇ ಪಾತ್ರನು.<verse eid="PSA 130:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5"/>ನಾನು ಯೆಹೋವನನ್ನು ಎದುರುನೋಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 130:5">ನನ್ನ ಪ್ರಾಣವು ಆತನನ್ನು ಕಾದುಕೊಂಡಿದೆ;</para>
  <para style="q" vid="PSA 130:5">ಆತನ ನುಡಿಯನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ.<verse eid="PSA 130:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6"/>ಕಾವಲುಗಾರರು ಬೆಳಗಾಗುವುದನ್ನು ಮುನ್ನೋಡುತ್ತಾರಲ್ಲಾ;</para>
  <para style="q" vid="PSA 130:6">ಕಾವಲುಗಾರರು ಬೆಳಗಾಗುವುದನ್ನು ಮುನ್ನೋಡುವುದಕ್ಕಿಂತ ವಿಶೇಷವಾಗಿ,</para>
  <para style="q" vid="PSA 130:6">ನನ್ನ ಅಂತರಾತ್ಮವು ಕರ್ತನನ್ನು ಮುನ್ನೋಡುತ್ತದೆ.<verse eid="PSA 130:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7"/>ಇಸ್ರಾಯೇಲೇ, ಯೆಹೋವನನ್ನು ಎದುರುನೋಡುತ್ತಿರು;</para>
  <para style="q" vid="PSA 130:7">ಯೆಹೋವನು ಕೃಪಾಸಂಪನ್ನನು;</para>
  <para style="q" vid="PSA 130:7">ಪೂರ್ಣವಿಮೋಚನೆಯು ಆತನಿಂದಲೇ ದೊರಕುವುದು.<verse eid="PSA 130:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8"/>ಆತನೇ ಇಸ್ರಾಯೇಲನ್ನು ಅದರ ಸಕಲ ಪಾಪಗಳಿಂದ ವಿಮೋಚಿಸುವನು.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s">ಭಕ್ತರ ದೀನಭಾವ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ; ದಾವೀದನದು.</para>
  <para style="r">
    <ref loc="PRO 23:26">ಜ್ಞಾನೋ 23:26</ref>; <ref loc="MAT 18:3">ಮತ್ತಾ 18:3</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1"/>ಯೆಹೋವನೇ, ನನ್ನ ಹೃದಯದಲ್ಲಿ ಗರ್ವವಿಲ್ಲ;</para>
  <para style="q" vid="PSA 131:1">ನನಗೆ ಸೊಕ್ಕಿನ ಕಣ್ಣುಗಳಿಲ್ಲ;</para>
  <para style="q" vid="PSA 131:1">ಅಸಾಧ್ಯ ಕಾರ್ಯಗಳಿಗೆ ಕೈಹಾಕುವುದಿಲ್ಲ.<verse eid="PSA 131:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2"/>ನಿಜವಾಗಿ ನನ್ನ ಮನಸ್ಸನ್ನು ಸಮಾಧಾನಪಡಿಸಿಕೊಂಡಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 131:2">ತಾಯಿಯ ಮಡಿಲಲ್ಲಿರುವ ಮೊಲೆಬಿಡಿಸಿದ ಕೂಸಿನಂತೆ,</para>
  <para style="q" vid="PSA 131:2">ನನ್ನಲ್ಲಿ ನನ್ನ ಮನಸ್ಸು ಮೊಲೆಬಿಡಿಸಿದ ಕೂಸಿನಂತೆ ನೆಮ್ಮದಿಯಿಂದಿದೆ.<verse eid="PSA 131:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3"/>ಇಸ್ರಾಯೇಲೇ, ಇಂದಿನಿಂದ ಯುಗಯುಗಕ್ಕೂ</para>
  <para style="q" vid="PSA 131:3">ಯೆಹೋವನನ್ನೇ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿರು.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s">ದಾವೀದನ ಮನೆತನವನ್ನು ಪುನಃಸ್ಥಾಪಿಸಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="r">
    <ref loc="PSA 89">ಕೀರ್ತ 89</ref>; <ref loc="2SA 7">2ಸಮು 7</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1"/>ಯೆಹೋವನೇ, ದಾವೀದನ ಹಿತಕ್ಕೋಸ್ಕರ,</para>
  <para style="q" vid="PSA 132:1">ಅವನ ಶ್ರಮೆಗಳನ್ನು ನೆನಪುಮಾಡಿಕೋ.<verse eid="PSA 132:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2"/>ಯಾಕೋಬನ ಶೂರನಾದ ಯೆಹೋವನಿಗಾಗಿ</para>
  <para style="q" vid="PSA 132:2">ಒಂದು ವಾಸಸ್ಥಾನವನ್ನು ಏರ್ಪಡಿಸುವ ತನಕ,<verse eid="PSA 132:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3"/>“ನಾನು ನನ್ನ ಮನೆಯೊಳಗೆ ಪ್ರವೇಶಿಸುವುದಿಲ್ಲ,</para>
  <para style="q" vid="PSA 132:3">ಮಂಚವನ್ನು ಹತ್ತುವುದಿಲ್ಲ,<verse eid="PSA 132:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4"/>ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚುವುದಿಲ್ಲ,</para>
  <para style="q" vid="PSA 132:4">ರೆಪ್ಪೆಗಳನ್ನು ಕೂಡಿಸುವುದಿಲ್ಲ” ಎಂದು<verse eid="PSA 132:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5"/>ಅವನು ಯೆಹೋವನಿಗೆ ಪ್ರಮಾಣಮಾಡಿ,</para>
  <para style="q" vid="PSA 132:5">ಯಾಕೋಬನ ಶೂರನಿಗೆ ಹರಕೆ ಮಾಡಿಕೊಂಡನಲ್ಲಾ.<verse eid="PSA 132:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6"/>ಇಗೋ, ಅದು ಎಫ್ರಾತದಲ್ಲಿರುತ್ತದೆಂದು ಕೇಳಿದೆವು;</para>
  <para style="q" vid="PSA 132:6">ಯಹಾರ್ ಮೈದಾನದಲ್ಲಿ ನಮಗೆ ಸಿಕ್ಕಿತು.<verse eid="PSA 132:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7"/>“ಬನ್ನಿರಿ, ಆತನ ಮಂದಿರಕ್ಕೆ ಹೋಗಿ</para>
  <para style="q" vid="PSA 132:7">ಆತನ ಪಾದಪೀಠದ ಮುಂದೆ ಅಡ್ಡಬೀಳೋಣ!”<verse eid="PSA 132:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8"/>ಯೆಹೋವನೇ, ಎದ್ದು ನಿನ್ನ ಪ್ರತಾಪಯುಕ್ತವಾದ ಮಂಜೂಷದೊಡನೆ,</para>
  <para style="q" vid="PSA 132:8">ನಿನ್ನ ವಾಸಸ್ಥಾನಕ್ಕೆ ಬಂದು ನೆಲೆಸು.<verse eid="PSA 132:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9"/>ನಿನ್ನ ಯಾಜಕರು ನೀತಿಯೆಂಬ ವಸ್ತ್ರವನ್ನು ಹೊದ್ದುಕೊಳ್ಳಲಿ;</para>
  <para style="q" vid="PSA 132:9">ನಿನ್ನ ಭಕ್ತರು ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಲಿ.<verse eid="PSA 132:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10"/>ನಿನ್ನ ಸೇವಕನಾದ ದಾವೀದನನ್ನು ನೆನಪುಮಾಡಿಕೋ;</para>
  <para style="q" vid="PSA 132:10">ನೀನು ಅಭಿಷೇಕಿಸಿದವನನ್ನು ತಳ್ಳಿಬಿಡಬೇಡ.<verse eid="PSA 132:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11"/>ಯೆಹೋವನು ದಾವೀದನಿಗೆ ಮಾಡಿದ ಪ್ರಮಾಣವು ಸ್ಥಿರವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 132:11">ಆತನು ಅದನ್ನು ಬದಲಿಸುವುದಿಲ್ಲ.</para>
  <para style="q" vid="PSA 132:11">“ನಿನ್ನ ಸಂತಾನದವರನ್ನು ನಿನ್ನ ಸಿಂಹಾಸನದ ಮೇಲೆ ಕುಳ್ಳಿರಿಸುವೆನು;<verse eid="PSA 132:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12"/>ನಿನ್ನ ಮಕ್ಕಳು ನನ್ನ ನಿಬಂಧನೆಯನ್ನೂ,</para>
  <para style="q" vid="PSA 132:12">ನಾನು ಆಜ್ಞಾಪಿಸಿದ ಕಟ್ಟಳೆಗಳನ್ನೂ ಕೈಕೊಂಡು ನಡೆಯುವುದಾದರೆ,</para>
  <para style="q" vid="PSA 132:12">ಅವರ ಮಕ್ಕಳು ನಿನ್ನ ಸಿಂಹಾಸನದಲ್ಲಿ ಸದಾಕಾಲ ಕುಳಿತುಕೊಳ್ಳುವರು.”<verse eid="PSA 132:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13"/>ನಿಶ್ಚಯವಾಗಿ ಯೆಹೋವನು ಚೀಯೋನನ್ನು ಅಪೇಕ್ಷಿಸಿ,</para>
  <para style="q" vid="PSA 132:13">ತನ್ನ ನಿವಾಸಕ್ಕಾಗಿ ಆರಿಸಿಕೊಂಡಿದ್ದಾನೆ.<verse eid="PSA 132:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14"/>ಆತನು, “ಇದು ನನ್ನ ಶಾಶ್ವತ ವಾಸಸ್ಥಾನ;</para>
  <para style="q" vid="PSA 132:14">ಇಲ್ಲೇ ಇರುವೆನು; ಇದು ನನಗೆ ಇಷ್ಟ.<verse eid="PSA 132:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15"/>ಇದರ ಆದಾಯವನ್ನು ಆಶೀರ್ವದಿಸುವೆನು;</para>
  <para style="q" vid="PSA 132:15">ಇಲ್ಲಿಯ ಬಡವರನ್ನು ಆಹಾರದಿಂದ ತೃಪ್ತಿಗೊಳಿಸುವೆನು;<verse eid="PSA 132:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16"/>ಯಾಜಕರಿಗೆ ರಕ್ಷಣೆಯೆಂಬ ವಸ್ತ್ರವನ್ನು ಹೊದಿಸುವೆನು;</para>
  <para style="q" vid="PSA 132:16">ಭಕ್ತರು ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡುವರು.<verse eid="PSA 132:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17"/>ಇಲ್ಲಿಯೇ ದಾವೀದನ ಕೊಂಬು ಚಿಗುರುವಂತೆ ಮಾಡುವೆನು;</para>
  <para style="q" vid="PSA 132:17">ನನ್ನ ಅಭಿಷಿಕ್ತನ ದೀಪವು ಉರಿಯುತ್ತಲೇ ಇರಬೇಕೆಂದು ನೇಮಿಸಿದ್ದೇನೆ.<verse eid="PSA 132:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18"/>ಅವನ ವೈರಿಗಳನ್ನು ನಾಚಿಕೆಯೆಂಬ ವಸ್ತ್ರದಿಂದ ಹೊದಿಸುವೆನು;</para>
  <para style="q" vid="PSA 132:18">ಆದರೆ ಅವನ ಮೇಲೆ ಕಿರೀಟವು ಶೋಭಿಸುತ್ತಿರುವುದು.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s">ಐಕಮತ್ಯವು ಶ್ರೇಷ್ಠವಾದುದು</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ; ದಾವೀದನದು.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1"/>ಆಹಾ, ಸಹೋದರರು ಒಂದಾಗಿರುವುದು,</para>
  <para style="q" vid="PSA 133:1">ಎಷ್ಟೋ ಒಳ್ಳೆಯದು, ಎಷ್ಟೋ ರಮ್ಯವಾದದ್ದು!<verse eid="PSA 133:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2"/>ಅದು ಆರೋನನ ತಲೆಯ ಮೇಲೆ ಹಾಕಲ್ಪಟ್ಟು,</para>
  <para style="q" vid="PSA 133:2">ಅವನ ಗಡ್ಡದ ಮೇಲೆಯೂ,</para>
  <para style="q" vid="PSA 133:2">ಅವನ ಅಂಗಿಗಳ ಕೊರಳ ಪಟ್ಟಿಯವರೆಗೂ ಹರಿದು ಬರುವ ಶ್ರೇಷ್ಠ ತೈಲದಂತೆಯೂ,<verse eid="PSA 133:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3"/>ಹೆರ್ಮೋನ್ ಪರ್ವತದಲ್ಲಿ ಹುಟ್ಟಿ,</para>
  <para style="q" vid="PSA 133:3">ಚೀಯೋನ್ ಪರ್ವತದ ಮೇಲೆ ಬೀಳುವ ಮಂಜಿನಂತೆಯೂ ಇದೆ.</para>
  <para style="q" vid="PSA 133:3">ಅಲ್ಲಿ ಆಶೀರ್ವಾದವೂ, ಜೀವವೂ ಸದಾಕಾಲ ಇರಬೇಕೆಂದು,</para>
  <para style="q" vid="PSA 133:3">ಯೆಹೋವನು ಆಜ್ಞಾಪಿಸಿದ್ದಾನೆ.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s">ಸಂಧ್ಯಾಸೇವಕರಿಗೆ ಎಚ್ಚರಿಕೆ</para>
  <para style="d">ಯಾತ್ರಾಗೀತೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1"/>ರಾತ್ರಿಯಲ್ಲಿ ಯೆಹೋವನ ಮಂದಿರದಲ್ಲಿರುವ ಆತನ ಸರ್ವಸೇವಕರೇ,</para>
  <para style="q" vid="PSA 134:1">ಬನ್ನಿರಿ, ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 134:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2"/>ಮಹಾಪರಿಶುದ್ಧ ಸ್ಥಳದ ಕಡೆಗೆ ಕೈಯೆತ್ತಿ,</para>
  <para style="q" vid="PSA 134:2">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 134:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3"/>ಭೂಮ್ಯಾಕಾಶಗಳನ್ನು ಉಂಟುಮಾಡಿದ ಯೆಹೋವನು,</para>
  <para style="q" vid="PSA 134:3">ಚೀಯೋನಿನೊಳಗಿಂದ ನಿನ್ನನ್ನು ಆಶೀರ್ವದಿಸಲಿ.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="s">ಸೃಷ್ಟಿಪಾಲಕನಾಗಿರುವ ಏಕದೇವರಿಗೆ ಸ್ತೋತ್ರ</para>
  <para style="r">
    <ref loc="PSA 136">ಕೀರ್ತ 136</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 135:1">ಯೆಹೋವನ ನಾಮವನ್ನು ಸ್ತುತಿಸಿರಿ.</para>
  <para style="q" vid="PSA 135:1">ಯೆಹೋವನ ಸೇವಕರೇ,<verse eid="PSA 135:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2"/>ಯೆಹೋವನ ಮಂದಿರದಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 135:2">ನಮ್ಮ ದೇವರ ಆಲಯದ ಅಂಗಳಗಳಲ್ಲಿಯೂ ಸೇವೆ ಮಾಡುವವರೇ,</para>
  <para style="q" vid="PSA 135:2">ಆತನನ್ನು ಕೀರ್ತಿಸಿರಿ.<verse eid="PSA 135:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 135:3">ಯೆಹೋವನು ಒಳ್ಳೆಯವನು.</para>
  <para style="q" vid="PSA 135:3">ಆತನ ನಾಮವನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q" vid="PSA 135:3">ಆತನು ಕೃಪಾಪೂರ್ಣನು.<verse eid="PSA 135:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4"/>ಯೆಹೋವನು ಯಾಕೋಬನ ವಂಶದವರನ್ನು ತನಗಾಗಿಯೂ,</para>
  <para style="q" vid="PSA 135:4">ಇಸ್ರಾಯೇಲರನ್ನು ಸ್ವಕೀಯ ಜನರನ್ನಾಗಿಯೂ ಆರಿಸಿಕೊಂಡನಲ್ಲಾ.<verse eid="PSA 135:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5"/>ಯೆಹೋವನು ದೊಡ್ಡವನೆಂದೂ,</para>
  <para style="q" vid="PSA 135:5">ನಮ್ಮ ಕರ್ತನು ಎಲ್ಲಾ ದೇವರುಗಳಿಗಿಂತ ಹೆಚ್ಚಿನವನೆಂದೂ ತಿಳಿದಿದ್ದೇನೆ.<verse eid="PSA 135:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6"/>ಯೆಹೋವನು ಭೂಮಿಯಲ್ಲಿಯೂ, ಆಕಾಶದಲ್ಲಿಯೂ,</para>
  <para style="q" vid="PSA 135:6">ಸಮುದ್ರಗಳಲ್ಲಿಯೂ, ಬೇರೆ ಎಲ್ಲಾ ಜಲರಾಶಿಗಳಲ್ಲಿಯೂ</para>
  <para style="q" vid="PSA 135:6">ತನಗೆ ಬೇಕಾದದ್ದನ್ನು ಮಾಡುತ್ತಾನೆ.<verse eid="PSA 135:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7"/>ಆತನು ಭೂಮಿಯ ಕಟ್ಟಕಡೆಯಿಂದ ಮೋಡಗಳನ್ನು ಮೇಲೇರುವಂತೆ ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 135:7">ಮಳೆಗೋಸ್ಕರ ಮಿಂಚನ್ನು ಹೊಳೆಯುವಂತೆ ಮಾಡುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 135:7">ತನ್ನ ಉಗ್ರಾಣದಿಂದ ಗಾಳಿಯನ್ನು ಬೀಸುವಂತೆ ಮಾಡುತ್ತಾನೆ.<verse eid="PSA 135:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8"/>ಆತನು ಐಗುಪ್ತದ ಮನುಷ್ಯರು ಮೊದಲುಗೊಂಡು ಪಶುಗಳವರೆಗೂ,</para>
  <para style="q" vid="PSA 135:8">ಚೊಚ್ಚಲುಗಳನ್ನೆಲ್ಲಾ ಸಂಹರಿಸಿದನು.<verse eid="PSA 135:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9"/>ಐಗುಪ್ತವೇ, ಆತನು ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ ಫರೋಹನಿಗೂ,</para>
  <para style="q" vid="PSA 135:9">ಅವನ ಸೇವಕರಿಗೂ ವಿರುದ್ಧವಾಗಿ ಅದ್ಭುತಗಳನ್ನು,</para>
  <para style="q" vid="PSA 135:9">ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡೆಸಿದನು.<verse eid="PSA 135:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10"/>ಆತನು ದೊಡ್ಡ ಜನಾಂಗಗಳನ್ನು ನಾಶಮಾಡಿಬಿಟ್ಟನು;</para>
  <para style="q" vid="PSA 135:10">ಬಲಿಷ್ಠ ರಾಜರನ್ನು ಕೊಂದುಹಾಕಿದನು.<verse eid="PSA 135:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11"/>ಅವರಲ್ಲಿ ಅಮೋರಿಯರ ಅರಸನಾದ ಸೀಹೋನನೂ,</para>
  <para style="q" vid="PSA 135:11">ಬಾಷಾನಿನ ಅರಸನಾದ ಓಗನೂ ಇದ್ದರು.</para>
  <para style="q" vid="PSA 135:11">ಆತನು ಕಾನಾನ್ ದೇಶದ ಎಲ್ಲಾ ರಾಜ್ಯಗಳನ್ನು ನಿರ್ಮೂಲ ಮಾಡಿದನು.<verse eid="PSA 135:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12"/>ಅವರ ದೇಶವನ್ನು ಇಸ್ರಾಯೇಲರಿಗೆ ಕೊಟ್ಟನು;</para>
  <para style="q" vid="PSA 135:12">ಆತನ ಪ್ರಜೆಗೆ ಅದು ಸ್ವಾಸ್ತ್ಯವಾಯಿತು.<verse eid="PSA 135:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13"/>ಯೆಹೋವನೇ, ನಿನ್ನ ನಾಮವು ಶಾಶ್ವತವಾದದ್ದು;</para>
  <para style="q" vid="PSA 135:13">ಯೆಹೋವನೇ, ನೀನು ತಲತಲಾಂತರಕ್ಕೂ ಸ್ಮರಿಸಲು ಯೋಗ್ಯನಾಗಿರುತ್ತೀ.<verse eid="PSA 135:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14"/>ನಿಜವಾಗಿ ಯೆಹೋವನು ತನ್ನ ಪ್ರಜೆಯ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುವನು,</para>
  <para style="q" vid="PSA 135:14">ತನ್ನ ಸೇವಕರನ್ನು ಕನಿಕರಿಸುವನು.<verse eid="PSA 135:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15"/>ಅನ್ಯಜನಗಳ ವಿಗ್ರಹಗಳು ಬೆಳ್ಳಿ ಮತ್ತು ಬಂಗಾರದವುಗಳೇ;</para>
  <para style="q" vid="PSA 135:15">ಅವು ಮನುಷ್ಯರ ಕೈಕೆಲಸವಷ್ಟೇ.<verse eid="PSA 135:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16"/>ಅವುಗಳಿಗೆ ಬಾಯಿದ್ದರೂ ಮಾತನಾಡುವುದಿಲ್ಲ,</para>
  <para style="q" vid="PSA 135:16">ಕಣ್ಣಿದ್ದರೂ ನೋಡುವುದಿಲ್ಲ,<verse eid="PSA 135:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17"/>ಕಿವಿಯಿದ್ದರೂ ಕೇಳುವುದಿಲ್ಲ,</para>
  <para style="q" vid="PSA 135:17">ಇದಲ್ಲದೆ ಅವುಗಳ ಬಾಯಲ್ಲಿ ಶ್ವಾಸವೇ ಇಲ್ಲ.<verse eid="PSA 135:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18"/>ಅವುಗಳನ್ನು ಮಾಡುವವರು,</para>
  <para style="q" vid="PSA 135:18">ಅವುಗಳಲ್ಲಿ ಭರವಸವಿಡುವವರು ಅವುಗಳಂತೆಯೇ.<verse eid="PSA 135:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19"/>ಇಸ್ರಾಯೇಲನ ಮನೆತನದವರೇ,</para>
  <para style="q" vid="PSA 135:19">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q" vid="PSA 135:19">ಆರೋನನ ಮನೆತನದವರೇ,</para>
  <para style="q" vid="PSA 135:19">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 135:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20"/>ಲೇವಿಯ ಮನೆತನದವರೇ,</para>
  <para style="q" vid="PSA 135:20">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ;</para>
  <para style="q" vid="PSA 135:20">ಯೆಹೋವನ ಭಕ್ತರೇ,</para>
  <para style="q" vid="PSA 135:20">ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 135:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ವಾಸಿಸುವ ಚೀಯೋನಿನ ದೇವರಿಗೆ,</para>
  <para style="q" vid="PSA 135:21">ಕೀರ್ತಿ ಉಂಟಾಗಲಿ,</para>
  <para style="q" vid="PSA 135:21">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="s">ಯೆಹೋವನ ಸ್ತುತಿ</para>
  <para style="r">
    <ref loc="PSA 135">ಕೀರ್ತ 135</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1"/>ಯೆಹೋವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ,</para>
  <para style="q" vid="PSA 136:1">ಆತನು ಒಳ್ಳೆಯವನು. ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2"/>ದೇವಾಧಿದೇವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ,</para>
  <para style="q" vid="PSA 136:2">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3"/>ಕರ್ತರ ಕರ್ತನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ,</para>
  <para style="q" vid="PSA 136:3">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4"/>ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡೆಸುವುದಕ್ಕೆ ಆತನೊಬ್ಬನೇ ಶಕ್ತನು,</para>
  <para style="q" vid="PSA 136:4">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5"/>ಆತನು ಆಕಾಶವನ್ನು ಜ್ಞಾನದಿಂದ ನಿರ್ಮಿಸಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 136:5">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6"/>ಆತನು ಭೂಮಿಯನ್ನು ಜಲರಾಶಿಗಳ ಮೇಲೆ ಹಾಸಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 136:6">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7"/>ಆತನು ಮಹಾ ಜ್ಯೋತಿರ್ಮಂಡಲಗಳನ್ನು ಸೃಷ್ಟಿಸಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 136:7">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8"/>ಸೂರ್ಯನು ಹಗಲನ್ನು ಆಳುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 136:8">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9"/>ಚಂದ್ರ, ನಕ್ಷತ್ರಗಳು ರಾತ್ರಿಯನ್ನು ಆಳುತ್ತವೆ,</para>
  <para style="q" vid="PSA 136:9">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10"/>ಆತನು ಐಗುಪ್ತ್ಯರ ಚೊಚ್ಚಲ ಮಕ್ಕಳನ್ನು ಸಂಹರಿಸಿದನು,</para>
  <para style="q" vid="PSA 136:10">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11"/>ಇಸ್ರಾಯೇಲರನ್ನು ಅವರ ಮಧ್ಯದಿಂದ ಹೊರಗೆ ತಂದನು,</para>
  <para style="q" vid="PSA 136:11">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12"/>ತನ್ನ ಭುಜಬಲ, ಶಿಕ್ಷಾಹಸ್ತ ಇವುಗಳಿಂದ ಅವರನ್ನು ಬಿಡಿಸಿದನು,</para>
  <para style="q" vid="PSA 136:12">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13"/>ಆತನು ಕೆಂಪು ಸಮುದ್ರವನ್ನು ವಿಭಾಗಿಸಿದನು,</para>
  <para style="q" vid="PSA 136:13">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14"/>ಇಸ್ರಾಯೇಲರನ್ನು ಅದರ ಮಧ್ಯದಲ್ಲಿಯೇ ನಡೆಸಿದನು,</para>
  <para style="q" vid="PSA 136:14">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15"/>ಫರೋಹನನ್ನೂ, ಅವನ ಸೈನ್ಯವನ್ನೂ ಕೆಂಪು ಸಮುದ್ರದಲ್ಲಿ ಕೆಡವಿಬಿಟ್ಟನು,</para>
  <para style="q" vid="PSA 136:15">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16"/>ಆತನು ತನ್ನ ಪ್ರಜೆಯನ್ನು ಅರಣ್ಯದೊಳಗೆ ಕರೆತಂದನು,</para>
  <para style="q" vid="PSA 136:16">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17"/>ದೊಡ್ಡ ಅರಸರನ್ನು ಹೊಡೆದನು,</para>
  <para style="q" vid="PSA 136:17">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18"/>ಶ್ರೇಷ್ಠ ರಾಜರನ್ನು ಸಂಹರಿಸಿದನು,</para>
  <para style="q" vid="PSA 136:18">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19"/>ಅಮೋರಿಯರ ಅರಸನಾದ ಸೀಹೋನನು ಅವರಲ್ಲೊಬ್ಬನು,</para>
  <para style="q" vid="PSA 136:19">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20"/>ಬಾಷಾನಿನ ಅರಸನಾದ ಓಗನು ಇನ್ನೊಬ್ಬನು,</para>
  <para style="q" vid="PSA 136:20">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21"/>ಅವರ ದೇಶವನ್ನು ಇಸ್ರಾಯೇಲರಿಗೆ ಸ್ವತ್ತಾಗಿ ಕೊಟ್ಟನು,</para>
  <para style="q" vid="PSA 136:21">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22"/>ಆತನ ಸೇವಕರಾದ ಇಸ್ರಾಯೇಲರಿಗೆ ಅದು ಸ್ವಾಸ್ತ್ಯವಾಯಿತು,</para>
  <para style="q" vid="PSA 136:22">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23"/>ನಾವು ದೀನಾವಸ್ಥೆಯಲ್ಲಿ ಇದ್ದಾಗ ನಮ್ಮನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡನು,</para>
  <para style="q" vid="PSA 136:23">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24"/>ನಮ್ಮ ಶತ್ರುಗಳಿಂದ ನಮ್ಮನ್ನು ಬಿಡಿಸಿದನು,</para>
  <para style="q" vid="PSA 136:24">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25"/>ಎಲ್ಲಾ ಜೀವಿಗಳಿಗೂ ಆಹಾರ ಕೊಡುವವನು ಆತನೇ,</para>
  <para style="q" vid="PSA 136:25">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26"/>ಪರಲೋಕದಲ್ಲಿರುವ ದೇವರಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ,</para>
  <para style="q" vid="PSA 136:26">ಆತನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="s">ಸೆರೆಯವರ ಪ್ರಲಾಪ</para>
  <para style="r">
    <ref loc="2CH 36">2ಪೂರ್ವ 36</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1"/>ನಾವು ಬಾಬೆಲ್ ದೇಶದ ನದಿಗಳ ಬಳಿಯಲ್ಲಿ ಕುಳಿತುಕೊಂಡು,</para>
  <para style="q" vid="PSA 137:1">ಚೀಯೋನನ್ನು ನೆನಪುಮಾಡಿಕೊಂಡು ಅತ್ತೆವು.<verse eid="PSA 137:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2"/>ಆ ದೇಶದ ನೀರವಂಜಿ ಮರಗಳಿಗೆ ನಮ್ಮ ಕಿನ್ನರಿಗಳನ್ನು ತೂಗುಹಾಕಿದೆವು.<verse eid="PSA 137:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3"/>ನಮ್ಮನ್ನು ಸೆರೆಹಿಡಿದು ಪೀಡಿಸುತ್ತಿದ್ದವರು ನಮಗೆ,</para>
  <para style="q" vid="PSA 137:3">“ಚೀಯೋನಿನ ಗೀತೆಗಳಲ್ಲಿ ಒಂದನ್ನು ನಮ್ಮ ವಿನೋದಕ್ಕಾಗಿ ಹಾಡಿರಿ” ಎಂದು ಹೇಳುತ್ತಿದ್ದರು.<verse eid="PSA 137:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4"/>ನಾವು ಪರದೇಶದಲ್ಲಿ ಯೆಹೋವನ ಗೀತೆಗಳನ್ನು ಹಾಡುವುದು ಹೇಗೆ?<verse eid="PSA 137:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5"/>ಯೆರೂಸಲೇಮೇ, ನಾನು ನಿನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟರೆ</para>
  <para style="q" vid="PSA 137:5">
    <note caller="+" style="f">
      <char style="fr" closed="false">137:5 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಾನು ಕಿನ್ನರಿಯನ್ನು ಇನ್ನೆಂದಿಗೂ ನನ್ನ ಬಲಗೈಯಿಂದ ಬಾರಿಸಲು ಆಗುವುದಿಲ್ಲ.</char>
    </note>ನನ್ನ ಬಲಗೈಯು ತನ್ನ ಕೌಶಲ್ಯವನ್ನು ಮರೆತು ಹೋಗಲಿ.<verse eid="PSA 137:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6"/>ಯೆರೂಸಲೇಮೇ, ನಾನು ನಿನ್ನನ್ನು ನೆನಪು ಮಾಡಿಕೊಳ್ಳದಿದ್ದರೆ,</para>
  <para style="q" vid="PSA 137:6">ಎಲ್ಲಾದಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ ನಾನು ನಿನ್ನಲ್ಲಿ ಆನಂದಿಸದಿದ್ದರೆ,</para>
  <para style="q" vid="PSA 137:6">
    <note caller="+" style="f">
      <char style="fr" closed="false">137:6 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಾನು ಇನ್ನೆಂದಿಗೂ ಹಾಡಲು ಆಗುವುದಿಲ್ಲ.</char>
    </note>ನನ್ನ ನಾಲಿಗೆಯು ಸೇದಿಹೋಗಲಿ.<verse eid="PSA 137:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7"/>ಯೆಹೋವನೇ, ಎದೋಮ್ಯರ ಹಾನಿಗಾಗಿ,</para>
  <para style="q" vid="PSA 137:7">ಯೆರೂಸಲೇಮಿನ ನಾಶನದ ದಿನವನ್ನು ನೆನಪುಮಾಡಿಕೋ.</para>
  <para style="q" vid="PSA 137:7">ಅವರು, “ಅದನ್ನು ಹಾಳುಮಾಡಿರಿ, ಅಸ್ತಿವಾರ ಸಹಿತ ಹಾಳುಮಾಡಿರಿ” ಎಂದು ಹೇಳಿದರಲ್ಲಾ.<verse eid="PSA 137:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8"/>ಹಾಳಾಗುವುದಕ್ಕಿರುವ ಬಾಬೆಲ್ ಪಟ್ಟಣವೇ,</para>
  <para style="q" vid="PSA 137:8">ನೀನು ನನಗೆ ಮಾಡಿದ್ದಕ್ಕೆ ಮುಯ್ಯಿ ತೀರಿಸುವವನು ಧನ್ಯನು.<verse eid="PSA 137:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9"/>ನಿನ್ನ ಮಕ್ಕಳನ್ನು ಹಿಡಿದು ಬಂಡೆಗೆ ಅಪ್ಪಳಿಸುವವನು ಭಾಗ್ಯಹೊಂದಲಿ.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s">ರಕ್ಷಣಾ ಕರ್ತನ ಸ್ತುತಿ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 102:13-23">ಕೀರ್ತ 102:13-23</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1"/>ಯೆಹೋವನೇ, ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು;</para>
  <para style="q" vid="PSA 138:1">ದೇವರುಗಳ ಎದುರಿನಲ್ಲಿ ನಿನ್ನನ್ನು ಕೀರ್ತಿಸುವೆನು.<verse eid="PSA 138:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2"/>ನಿನ್ನ ಪರಿಶುದ್ಧ ಆಲಯದ ಕಡೆಗೆ ಅಡ್ಡಬೀಳುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 138:2">ನಿನ್ನ ಕೃಪೆ, ಸತ್ಯತೆ ಇವುಗಳಿಗೋಸ್ಕರ ನಿನ್ನ ನಾಮವನ್ನು ಕೊಂಡಾಡುತ್ತೇನೆ.</para>
  <para style="q" vid="PSA 138:2">
    <note caller="+" style="f">
      <char style="fr" closed="false">138:2 </char>
      <char style="ft" closed="false">ಅಥವಾ ನಿನ್ನ ವಾಕ್ಯವನ್ನು ನಿನ್ನ ಎಲ್ಲಾ ನಾಮಕ್ಕಿಂತಲೂ ಮಿಗಿಲಾಗಿ ಘನಪಡಿಸಿದ್ದೀ. </char>
    </note>ನಿನ್ನ ನಾಮದ ಮತ್ತು ಆಜ್ಞೆಯ ಘನಪಡಿಸಿ ತೋರಿಸಿದ್ದೀ.<verse eid="PSA 138:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3"/>ನಾನು ಮೊರೆಯಿಟ್ಟಾಗ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸಿದಿ;</para>
  <para style="q" vid="PSA 138:3">ನನ್ನ ಆತ್ಮಕ್ಕೆ ಬಲಕೊಟ್ಟು ನನ್ನನ್ನು ಧೈರ್ಯಪಡಿಸಿದ್ದೀ.<verse eid="PSA 138:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4"/>ಯೆಹೋವನೇ, ಭೂರಾಜರೆಲ್ಲರು ನೀನು ನುಡಿದ ನುಡಿಗಳನ್ನು ಕೇಳಿ</para>
  <para style="q" vid="PSA 138:4">ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವರು.<verse eid="PSA 138:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5"/>ಅವರು ಯೆಹೋವನ ಮಾರ್ಗಗಳನ್ನು ಹಾಡಿಹರಸುವರು;</para>
  <para style="q" vid="PSA 138:5">ಯೆಹೋವನ ಪ್ರಭಾವವು ದೊಡ್ಡದಾಗಿದೆಯಲ್ಲಾ.<verse eid="PSA 138:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6"/>ಯೆಹೋವನು ಮಹೋನ್ನತನು;</para>
  <para style="q" vid="PSA 138:6">ಆದರೂ ದೀನರನ್ನು ಲಕ್ಷಿಸುತ್ತಾನೆ;</para>
  <para style="q" vid="PSA 138:6">ಗರ್ವಿಷ್ಠರನ್ನು ದೂರದಿಂದಲೇ ಗುರುತು ಹಿಡಿಯುತ್ತಾನೆ.<verse eid="PSA 138:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7"/>ನಾನು ಇಕ್ಕಟ್ಟಿನ ದಾರಿಯಲ್ಲಿ ನಡೆಯುವಾಗ,</para>
  <para style="q" vid="PSA 138:7">
    <note caller="+" style="f">
      <char style="fr" closed="false">138:7 </char>
      <char style="ft" closed="false">ಅಥವಾ ನನ್ನನ್ನು ಕಾಪಾಡುವಿ.</char>
    </note>ನನ್ನನ್ನು ಚೈತನ್ಯಗೊಳ್ಳಿಸುವಿ,</para>
  <para style="q" vid="PSA 138:7">ನನ್ನ ಶತ್ರುಗಳ ಕೋಪಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ನಿನ್ನ ಕೈ ಚಾಚುವಿ,</para>
  <para style="q" vid="PSA 138:7">ನಿನ್ನ ಬಲಗೈ ನನ್ನನ್ನು ರಕ್ಷಿಸುವುದು.<verse eid="PSA 138:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8"/>ಯೆಹೋವನು ನನ್ನ ಕಾರ್ಯವನ್ನು ಸಿದ್ಧಿಗೆ ತರುವನು.</para>
  <para style="q" vid="PSA 138:8">ಯೆಹೋವನೇ, ನಿನ್ನ ಪ್ರೀತಿಯು ಶಾಶ್ವತವಾದದ್ದು,</para>
  <para style="q" vid="PSA 138:8">ನೀನು ಕೈಹಾಕಿದ ಕೆಲಸವನ್ನು ನೆರವೇರಿಸದೆ ಬಿಡಬೇಡ.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s">ಸರ್ವಜ್ಞಾನಿ, ಸರ್ವವ್ಯಾಪಿ ಅದ ದೇವರು</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು; ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1"/>ಯೆಹೋವನೇ, ನೀನು ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿ ತಿಳಿದುಕೊಂಡಿದ್ದೀ;<verse eid="PSA 139:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2"/>ನಾನು ಕುಳಿತುಕೊಳ್ಳುವುದು, ಏಳುವುದು ನಿನಗೆ ಗೊತ್ತಿದೆ,</para>
  <para style="q" vid="PSA 139:2">ದೂರದಿಂದಲೇ ನನ್ನ ಆಲೋಚನೆಗಳನ್ನು ಬಲ್ಲವನಾಗಿರುತ್ತಿ.<verse eid="PSA 139:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3"/>ನಾನು ನಡೆಯುವುದನ್ನು, ಮಲಗುವುದನ್ನು ಶೋಧಿಸಿ ಗ್ರಹಿಸಿಕೊಳ್ಳುತ್ತಿ,</para>
  <para style="q" vid="PSA 139:3">ನನ್ನ ನಡತೆಯೆಲ್ಲಾ ನಿನಗೆ ಗೋಚರವಾಗಿದೆ.<verse eid="PSA 139:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4"/>ಯೆಹೋವನೇ, ನನ್ನ ನಾಲಿಗೆಯ ಮಾತುಗಳಲ್ಲಿ,</para>
  <para style="q" vid="PSA 139:4">ನೀನು ಅರಿಯದೆ ಇರುವಂಥದು ಒಂದೂ ಇಲ್ಲ.<verse eid="PSA 139:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5"/>ಸುತ್ತಲೂ ನನ್ನನ್ನು ಆವರಿಸಿ, ನಿನ್ನ ಕೈಯನ್ನು ನನ್ನ ಮೇಲೆ ಇಟ್ಟಿದ್ದಿ.<verse eid="PSA 139:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6"/>ಇಂಥ ಜ್ಞಾನವು ನನಗೆ ಬಹು ಆಶ್ಚರ್ಯವಾಗಿದೆ;</para>
  <para style="q" vid="PSA 139:6">ಅದು ಉನ್ನತವಾದದ್ದು, ನನಗೆ ನಿಲುಕುವುದಿಲ್ಲ.<verse eid="PSA 139:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7"/>ನಾನು ನಿನ್ನ ಆತ್ಮಕ್ಕೆ ತಪ್ಪಿಸಿಕೊಳ್ಳುವಂತೆ ಎಲ್ಲಿಗೆ ಹೋಗಲಿ?</para>
  <para style="q" vid="PSA 139:7">ನಿನ್ನ ಕಣ್ಣಿಗೆ ಮರೆಯಾಗುವಂತೆ ಎಲ್ಲಿಗೆ ಓಡಲಿ?<verse eid="PSA 139:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8"/>ಮೇಲಣ ಲೋಕಕ್ಕೆ ಏರಿಹೋದರೆ ಅಲ್ಲಿ ನೀನಿರುತ್ತಿ,</para>
  <para style="q" vid="PSA 139:8">ಪಾತಾಳಕ್ಕೆ ಹೋಗಿ ಮಲಗಿಕೊಂಡೇನೆಂದರೆ ಅಲ್ಲಿಯೂ ನೀನಿರುವಿ.<verse eid="PSA 139:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9"/>ಅರುಣನ ರೆಕ್ಕೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡು ಹಾರಿಹೋಗಿ,</para>
  <para style="q" vid="PSA 139:9">ಸಮುದ್ರದ ಕಟ್ಟಕಡೆಯಲ್ಲಿ ವಾಸಮಾಡಲು ಪ್ರಯತ್ನಿಸಿದರೆ,<verse eid="PSA 139:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10"/>ಅಲ್ಲಿಯೂ ನಿನ್ನ ಕೈ ನನ್ನನ್ನು ನಡೆಸುವುದು;</para>
  <para style="q" vid="PSA 139:10">ನಿನ್ನ ಬಲಗೈ ನನ್ನನ್ನು ಹಿಡಿದಿರುವುದು.<verse eid="PSA 139:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11"/>ಕಾರ್ಗತ್ತಲೆಯು ನನ್ನನ್ನು ಕವಿಯುವುದು,</para>
  <para style="q" vid="PSA 139:11">“ಹಗಲು ಹೋಗಿ ನನ್ನ ಸುತ್ತಲು ಇರುಳಾಗುವುದು” ಎಂದು ಹೇಳಿಕೊಂಡರೇನು?<verse eid="PSA 139:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12"/>ನಿನಗೆ ಕತ್ತಲೆಯು ಕತ್ತಲೆಯಲ್ಲ; ಇರುಳು ಹಗಲಾಗಿಯೇ ಇರುತ್ತದೆ,</para>
  <para style="q" vid="PSA 139:12">ಕತ್ತಲು ಬೆಳಕುಗಳೆರಡೂ ನಿನಗೆ ಒಂದೇ.<verse eid="PSA 139:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13"/>ನನ್ನ ಅಂತರಿಂದ್ರಿಯಗಳನ್ನು ಉಂಟುಮಾಡಿದವನೂ,</para>
  <para style="q" vid="PSA 139:13">ತಾಯಿಯ ಗರ್ಭದಲ್ಲಿ ನನ್ನನ್ನು ರೂಪಿಸಿದವನೂ ನೀನಲ್ಲವೋ?<verse eid="PSA 139:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14"/>ನೀನು ನನ್ನನ್ನು ಅದ್ಭುತವಾಗಿಯೂ, ವಿಚಿತ್ರವಾಗಿಯೂ ರಚಿಸಿದ್ದರಿಂದ,</para>
  <para style="q" vid="PSA 139:14">ನಿನ್ನನ್ನು ಕೊಂಡಾಡುತ್ತೇನೆ.</para>
  <para style="q" vid="PSA 139:14">ನಿನ್ನ ಕೃತ್ಯಗಳು ಆಶ್ಚರ್ಯವಾಗಿವೆಯೆಂದು,</para>
  <para style="q" vid="PSA 139:14">ನನ್ನ ಹೃದಯವು ಚೆನ್ನಾಗಿ ಗ್ರಹಿಸಿಕೊಂಡಿದೆ.<verse eid="PSA 139:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15"/>ನಾನು ಗುಪ್ತಸ್ಥಳದಲ್ಲಿ ಏರ್ಪಡುತ್ತಾ,</para>
  <para style="q" vid="PSA 139:15">ಭೂಗರ್ಭದಲ್ಲಿ ರಚಿಸಲ್ಪಡುತ್ತಾ ಇದ್ದಾಗ,</para>
  <para style="q" vid="PSA 139:15">ನನ್ನ ಅಸ್ಥಿಪಂಜರವು ನಿನಗೆ ಮರೆಯಾಗಿದ್ದಿಲ್ಲ.<verse eid="PSA 139:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16"/>ನಾನು ಇನ್ನೂ ಕೇವಲ ಪಿಂಡವಾಗಿರುವಾಗ,</para>
  <para style="q" vid="PSA 139:16">ನಿನ್ನ ಕಣ್ಣುಗಳು ನನ್ನನ್ನು ನೋಡಿದವು,</para>
  <para style="q" vid="PSA 139:16">ನನ್ನ ಆಯುಷ್ಕಾಲದ ಪ್ರಥಮದಿನವು ಪ್ರಾರಂಭವಾಗುವ ಮೊದಲೇ,</para>
  <para style="q" vid="PSA 139:16">ಅದರ ಎಲ್ಲಾ ದಿನಗಳು ನಿನ್ನ ಪುಸ್ತಕದಲ್ಲಿ ಬರೆಯಲ್ಪಟ್ಟವು.<verse eid="PSA 139:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17"/>ದೇವರೇ, ನಿನ್ನ ಸಂಕಲ್ಪಗಳು ನನ್ನ ಎಣಿಕೆಯಲ್ಲಿ ಎಷ್ಟೋ ಗೌರವವಾಗಿವೆ,</para>
  <para style="q" vid="PSA 139:17">ಅವುಗಳು ಎಷ್ಟೋ ಅಸಂಖ್ಯವಾಗಿವೆ.<verse eid="PSA 139:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18"/>ಅವುಗಳನ್ನು ಲೆಕ್ಕಿಸುವುದಾದರೆ ಸಮುದ್ರದ ಮರಳಿಗಿಂತ ಹೆಚ್ಚಾಗಿವೆ,</para>
  <para style="q" vid="PSA 139:18">ನಾನು ಎಚ್ಚರವಾಗಲು ಮೊದಲಿನಂತೆಯೇ ನಿನ್ನ ಬಳಿಯಲ್ಲಿರುತ್ತೇನೆ.<verse eid="PSA 139:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19"/>ಯೆಹೋವನೇ, ನೀನು ದುಷ್ಟರನ್ನು ಸಂಹರಿಸಿಬಿಟ್ಟರೆ,</para>
  <para style="q" vid="PSA 139:19">ಎಷ್ಟೋ ಒಳ್ಳೆಯದು.</para>
  <para style="q" vid="PSA 139:19">
    <note caller="+" style="f">
      <char style="fr" closed="false">139:19 </char>
      <char style="ft" closed="false">ರಕ್ತಪ್ರಿಯರೇ</char>
    </note>ಕೊಲೆಪಾತಕರೇ, ನನ್ನಿಂದ ತೊಲಗಿಹೋಗಿರಿ.<verse eid="PSA 139:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20"/>ದೇವರೇ, ಅವರು ನಿನ್ನ ಶತ್ರುಗಳು,</para>
  <para style="q" vid="PSA 139:20">ಅಯೋಗ್ಯ ಕಾರ್ಯಕ್ಕಾಗಿ ನಿನ್ನ ಹೆಸರೆತ್ತುತ್ತಾರೆ, ಸುಳ್ಳಾಣೆಯಿಡುತ್ತಾರೆ.<verse eid="PSA 139:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21"/>ಯೆಹೋವನೇ, ನಿನ್ನನ್ನು ದ್ವೇಷಿಸುವವರನ್ನು ನಾನು ದ್ವೇಷಿಸುತ್ತೇನಲ್ಲವೋ?</para>
  <para style="q" vid="PSA 139:21">ನಿನ್ನ ವಿರೋಧಿಗಳಿಗೆ ನಾನು ಬೇಸರಗೊಳ್ಳುವುದಿಲ್ಲವೋ?<verse eid="PSA 139:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22"/>ನಾನು ಅವರನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ದ್ವೇಷಿಸುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 139:22">ಅವರು ನನಗೂ ವೈರಿಗಳೇ ಆಗಿದ್ದಾರೆ.<verse eid="PSA 139:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23"/>ದೇವಾ, ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿ ನನ್ನ ಹೃದಯವನ್ನು ತಿಳಿದುಕೋ,</para>
  <para style="q" vid="PSA 139:23">ನನ್ನನ್ನು ಶೋಧಿಸಿ ನನ್ನ ಆಲೋಚನೆಗಳನ್ನು ತಿಳಿದುಕೋ.<verse eid="PSA 139:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24"/>ನನ್ನಲ್ಲಿ ಕೇಡಿನ ಮಾರ್ಗ ಇರುತ್ತದೋ ಏನೋ ನೋಡಿ,</para>
  <para style="q" vid="PSA 139:24">ಸನಾತನ ಮಾರ್ಗದಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಸು.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s">ಶತ್ರುಪೀಡಿತನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ಪ್ರಧಾನಗಾಯಕನ ಕೀರ್ತನ ಸಂಗ್ರಹದಿಂದ ಆರಿಸಿಕೊಂಡದ್ದು, ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 7">ಕೀರ್ತ 7</ref>; <ref loc="PSA 35">35</ref>; <ref loc="PSA 64">64</ref>; <ref loc="PSA 141:-1-143">141-143</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1"/>ಯೆಹೋವನೇ, ಕೆಡುಕರಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು,</para>
  <para style="q" vid="PSA 140:1">ಬಲಾತ್ಕಾರಿಗಳಿಂದ ತಪ್ಪಿಸಿ ಕಾಪಾಡು.<verse eid="PSA 140:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2"/>ಅವರು ಕೇಡು ಕಲ್ಪಿಸುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 140:2">ಯಾವಾಗಲೂ ಜಗಳವೆಬ್ಬಿಸುತ್ತಾರೆ.<verse eid="PSA 140:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3"/>ತಮ್ಮ ನಾಲಿಗೆಯನ್ನು ಸರ್ಪದಂತೆ ಹದಮಾಡಿದ್ದಾರೆ,</para>
  <para style="q" vid="PSA 140:3">ಅವರ ತುಟಿಗಳ ಹಿಂದೆ ಹಾವಿನ ವಿಷವಿದೆ. <char style="qs">ಸೆಲಾ</char><verse eid="PSA 140:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4"/>ಯೆಹೋವನೇ, ದುಷ್ಟರ ಕೈಗೆ ಸಿಕ್ಕದಂತೆ ನನ್ನನ್ನು ಕಾಪಾಡು,</para>
  <para style="q" vid="PSA 140:4">ಬಲಾತ್ಕಾರಿಗಳಿಂದ ತಪ್ಪಿಸಿ ರಕ್ಷಿಸು.</para>
  <para style="q" vid="PSA 140:4">ಅವರು ನನ್ನ ಕಾಲುಗಳನ್ನು ಎಡವಿಸಿಬಿಡಬೇಕೆಂದು ಯೋಚಿಸಿದ್ದಾರೆ.<verse eid="PSA 140:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5"/>ಗರ್ವಿಷ್ಠರು ನನಗೋಸ್ಕರ ಗುಪ್ತಸ್ಥಳದಲ್ಲಿ</para>
  <para style="q" vid="PSA 140:5">ಉರುಲನ್ನೂ, ಪಾಶಗಳನ್ನೂ ಒಡ್ಡಿದ್ದಾರೆ,</para>
  <para style="q" vid="PSA 140:5">ದಾರಿಯ ಮಗ್ಗುಲಲ್ಲಿ ಬಲೆಹಾಸಿದ್ದಾರೆ,</para>
  <para style="q" vid="PSA 140:5">ನನಗಾಗಿ ಬಲೆಬೀಸಿಟ್ಟಿದ್ದಾರೆ. <char style="qs">ಸೆಲಾ</char><verse eid="PSA 140:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6"/>ನಾನು ಯೆಹೋವನಿಗೆ, “ನೀನೇ ನನ್ನ ದೇವರು,</para>
  <para style="q" vid="PSA 140:6">ಯೆಹೋವನೇ, ನನ್ನ ವಿಜ್ಞಾಪನೆಗೆ ಕಿವಿಗೊಡು,<verse eid="PSA 140:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7"/>ಕರ್ತನೇ, ಯೆಹೋವನೇ, ನನ್ನ ಆಶ್ರಯದುರ್ಗವೇ,</para>
  <para style="q" vid="PSA 140:7">
    <note caller="+" style="f">
      <char style="fr" closed="false">140:7 </char>
      <char style="ft" closed="false">ಅಥವಾ ಯುದ್ಧಸಮಯದಲ್ಲಿ ನೀನು ನನ್ನನ್ನು ಕಾಪಾಡಿದ್ದೀ.</char>
    </note>ಯುದ್ಧ ಸಮಯದಲ್ಲಿ ನೀನೇ ನನ್ನ ಶಿರಸ್ತ್ರಾಣ,<verse eid="PSA 140:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8"/>ಯೆಹೋವನೇ, ದುಷ್ಟರು ತಮ್ಮನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳದಂತೆ,</para>
  <para style="q" vid="PSA 140:8">ಅವರ ಆಶೆಗಳನ್ನು ನೆರವೇರಿಸಬೇಡ,</para>
  <para style="q" vid="PSA 140:8">ಅವರ ಕುಯುಕ್ತಿಯನ್ನು ಸಾಗಗೊಡಿಸಬೇಡ” ಎಂದು ಹೇಳುತ್ತೇನೆ. <char style="qs">ಸೆಲಾ </char><verse eid="PSA 140:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9"/>ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿರುವವರ ತುಟಿಗಳ ಕೇಡು</para>
  <para style="q" vid="PSA 140:9">ಅವರ ತಲೆಯ ಮೇಲೆಯೇ ಬರಲಿ,<verse eid="PSA 140:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10"/>ಅವರ ಮೇಲೆ ಕೆಂಡಗಳು ಸುರಿಯಲಿ,</para>
  <para style="q" vid="PSA 140:10">ಅವರು ಅಗ್ನಿಕುಂಡದೊಳಕ್ಕೂ,</para>
  <para style="q" vid="PSA 140:10">ಆಳವಾದ ತಗ್ಗಿನೊಳಕ್ಕೂ ದೊಬ್ಬಲ್ಪಟ್ಟು ತಿರುಗಿ ಏಳದಿರಲಿ.<verse eid="PSA 140:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11"/>ಚಾಡಿಗಾರನು ದೇಶದಲ್ಲಿ ಉಳಿಯನು,</para>
  <para style="q" vid="PSA 140:11">ಕೇಡು ಬಲಾತ್ಕಾರಿಯನ್ನು ಹಿಂದಟ್ಟಿ ಕೆಡವಿಬಿಡುವುದು.<verse eid="PSA 140:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12"/>ಯೆಹೋವನು ದೀನರ ವ್ಯಾಜ್ಯವನ್ನು ನಡೆಸುವನೆಂತಲೂ,</para>
  <para style="q" vid="PSA 140:12">ಬಡವರ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುವನೆಂತಲೂ ಬಲ್ಲೆನು.<verse eid="PSA 140:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13"/>ನಿಶ್ಚಯವಾಗಿ ನೀತಿವಂತರು ನಿನ್ನ ಹೆಸರನ್ನು ಕೊಂಡಾಡುವರು,</para>
  <para style="q" vid="PSA 140:13">ಯಥಾರ್ಥರು ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಬದುಕುವರು.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s">ಬಲಾತ್ಕಾರ ದುಷ್ಪ್ರೇರಣೆಗಳಿಂದ ತಪ್ಪಿಸಬೇಕೆಂಬ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 140">ಕೀರ್ತ 140</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1"/>ಯೆಹೋವನೇ, ಮೊರೆಯಿಡುತ್ತೇನೆ,</para>
  <para style="q" vid="PSA 141:1">ಬೇಗನೆ ಬಾ, ನಾನು ಮೊರೆಯಿಡುವಾಗ ನನ್ನ ಕೂಗನ್ನು ಲಾಲಿಸು.<verse eid="PSA 141:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2"/>ನನ್ನ ಪ್ರಾರ್ಥನೆಯು ಧೂಪದಂತೆಯೂ,</para>
  <para style="q" vid="PSA 141:2">ನಾನು ಕೈಯೆತ್ತುವುದು ಸಂಧ್ಯಾನೈವೇದ್ಯದಂತೆಯೂ ನಿನಗೆ ಸಮರ್ಪಕವಾಗಲಿ.<verse eid="PSA 141:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3"/>ಯೆಹೋವನೇ, ನನ್ನ ಬಾಯಿಗೆ ಕಾವಲಿರಿಸು,</para>
  <para style="q" vid="PSA 141:3">ನನ್ನ ತುಟಿಗಳೆಂಬ ಕದವನ್ನು ಕಾಯಿ.<verse eid="PSA 141:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4"/>ನನ್ನ ಹೃದಯವು ದುರಾಚಾರವನ್ನು ಮೆಚ್ಚದಂತೆಯೂ,</para>
  <para style="q" vid="PSA 141:4">ನಾನು ದುಷ್ಟರೊಡನೆ ಸೇರಿ ಕೆಟ್ಟ ಕೆಲಸಗಳನ್ನು ನಡೆಸದಂತೆಯೂ ನನ್ನನ್ನು ಕಾಪಾಡು.</para>
  <para style="q" vid="PSA 141:4">ಅವರ ಮೃಷ್ಟಾನ್ನವು ನನಗೆ ಬೇಡವೇ ಬೇಡ.<verse eid="PSA 141:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5"/>ನೀತಿವಂತರು ನನ್ನನ್ನು ಹೊಡೆಯಲಿ, ಅದು ನನಗೆ ಉಪಕಾರ,</para>
  <para style="q" vid="PSA 141:5">ಅವರು ನನ್ನನ್ನು ಶಿಕ್ಷಿಸಲಿ, ಅದು ನನ್ನ ತಲೆಗೆ ಎಣ್ಣೆಯಂತಿದೆ,</para>
  <para style="q" vid="PSA 141:5">ನನ್ನ ತಲೆಯು ಅದನ್ನು ಬೇಡವೆನ್ನದಿರಲಿ.</para>
  <para style="q" vid="PSA 141:5">ಆದರೆ ದುಷ್ಟರ ಕೆಟ್ಟತನಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸುತ್ತಿರುವೆನು.<verse eid="PSA 141:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6"/>ಅವರ ಪ್ರಮುಖರು ಕಡುಬಂಡೆಯಿಂದ ಕೆಳಕ್ಕೆ ದೊಬ್ಬಲ್ಪಟ್ಟ ಮೇಲೆ,</para>
  <para style="q" vid="PSA 141:6">ಜನರು ನನ್ನ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡುವರು,</para>
  <para style="q" vid="PSA 141:6">ಅವು ಅವರಿಗೆ ಹಿತವಾಗಿರುವವು.<verse eid="PSA 141:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7"/>ಒಬ್ಬನು ಹೊಲವನ್ನು ಉಳುತ್ತಾ,</para>
  <para style="q" vid="PSA 141:7">ಹೆಂಟೆಗಳನ್ನು ಒಡೆದು ಚದರಿಸುವ ಪ್ರಕಾರವೇ,</para>
  <para style="q" vid="PSA 141:7">ನಮ್ಮ ಎಲುಬುಗಳು ಪಾತಾಳದ್ವಾರದಲ್ಲಿ ಚದರಿಸಲ್ಪಟ್ಟಿರುತ್ತವೆ.<verse eid="PSA 141:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8"/>ಕರ್ತನೇ, ಯೆಹೋವನೇ, ನನ್ನ ದೃಷ್ಟಿ ನಿನ್ನಲ್ಲಿದೆ,</para>
  <para style="q" vid="PSA 141:8">ನಿನ್ನನ್ನು ಆಶ್ರಯಿಸಿಕೊಂಡಿದ್ದೇನೆ,</para>
  <para style="q" vid="PSA 141:8">ನನ್ನ ಪ್ರಾಣವನ್ನು ಮರಣಕ್ಕೆ ಒಪ್ಪಿಸಬೇಡ.<verse eid="PSA 141:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9"/>ಕೆಡುಕರ ಉರುಲಿನಲ್ಲಿ ಸಿಕ್ಕಿಬೀಳದಂತೆ ನನ್ನನ್ನು ಕಾಪಾಡು,</para>
  <para style="q" vid="PSA 141:9">ಅವರು ಬೀಸಿಟ್ಟಿರುವ ಬಲೆಯಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸು.<verse eid="PSA 141:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10"/>ದುಷ್ಟರು ತಮ್ಮ ಬಲೆಯಲ್ಲಿ ತಾವೇ ಬಿದ್ದುಹೋಗಲಿ,</para>
  <para style="q" vid="PSA 141:10">ಆಗ ನಾನು ತಪ್ಪಿಸಿಕೊಳ್ಳುವೆನು.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s">ಇಕ್ಕಟ್ಟಿನಲ್ಲಿದ್ದವನ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ದಾವೀದನ ಪದ್ಯ, ಅವನು ಗುಹೆಯಲ್ಲಿ ಅಡಗಿಕೊಂಡಿದ್ದಾಗ ಮಾಡಿದ ಪ್ರಾರ್ಥನೆ.</para>
  <para style="r">
    <ref loc="PSA 140">ಕೀರ್ತ 140</ref>; <ref loc="1SA 22">1ಸಮು 22</ref>; <ref loc="1SA 24">24</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1"/>ನಾನು ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡುವೆನು,</para>
  <para style="q" vid="PSA 142:1">ಯೆಹೋವನಿಗೆ ಕೂಗಿ ಬಿನ್ನೈಸುವೆನು.<verse eid="PSA 142:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2"/>ನನ್ನ ಚಿಂತೆಗಳನ್ನು ಆತನ ಮುಂದೆ ಬಿಚ್ಚುವೆನು,</para>
  <para style="q" vid="PSA 142:2">ನನ್ನ ಕಷ್ಟವನ್ನು ಆತನಿಗೆ ಅರಿಕೆಮಾಡುವೆನು.<verse eid="PSA 142:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3"/>ನನ್ನ ಆತ್ಮವು ಕುಂದಿಹೋದಾಗ,</para>
  <para style="q" vid="PSA 142:3">ನೀನು ನನ್ನ ಮಾರ್ಗವನ್ನು ಬಲ್ಲವನಾಗಿರುತ್ತಿ,</para>
  <para style="q" vid="PSA 142:3">ನಾನು ಹೋಗಬೇಕಾದ ದಾರಿಯಲ್ಲಿ ಅವರು ಉರುಲನ್ನೊಡ್ಡಿದ್ದಾರೆ.<verse eid="PSA 142:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4"/>ನಾನು ನನ್ನ ಬಲಗಡೆಗೆ ನೋಡಲು,</para>
  <para style="q" vid="PSA 142:4">ಅಲ್ಲಿ ಸಹಾಯಕರು ಯಾರೂ ಇಲ್ಲ,</para>
  <para style="q" vid="PSA 142:4">ಆಶ್ರಯವೂ ನಾಶವಾಯಿತು,</para>
  <para style="q" vid="PSA 142:4">ನನ್ನ ಪ್ರಾಣಕ್ಕೆ ಹಿತಚಿಂತಕರು ಒಬ್ಬರೂ ಇಲ್ಲ.<verse eid="PSA 142:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5"/>ಯೆಹೋವನೇ, ನಾನು ನಿನಗೆ, “ನೀನೇ ನನ್ನ ಶರಣನೂ,</para>
  <para style="q" vid="PSA 142:5">ಜೀವಲೋಕದಲ್ಲಿ ನನ್ನ ಪಾಲೂ ಆಗಿದ್ದಿ” ಎಂದು ಕೂಗಿ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 142:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6"/>ನನ್ನ ಕೂಗನ್ನು ಲಾಲಿಸು, ಬಲು ಕುಗ್ಗಿಹೋಗಿದ್ದೇನೆ.</para>
  <para style="q" vid="PSA 142:6">ಹಿಂಸಕರ ಕೈಯಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸು,</para>
  <para style="q" vid="PSA 142:6">ಅವರು ನನಗಿಂತ ಬಲಿಷ್ಠರಾಗಿದ್ದಾರಲ್ಲಾ.<verse eid="PSA 142:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7"/>ಸೆರೆಯಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು,</para>
  <para style="q" vid="PSA 142:7">ನಿನ್ನ ನಾಮವನ್ನು ಕೀರ್ತಿಸುವೆನು.</para>
  <para style="q" vid="PSA 142:7">ನೀತಿವಂತರು ನಿನ್ನ ಮಹೋಪಕಾರಕ್ಕಾಗಿ,</para>
  <para style="q" vid="PSA 142:7">ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡು ಉತ್ಸಾಹಗೊಳ್ಳುವರು.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s">ಶಿಕ್ಷಾರಕ್ಷಣೆಗಳಿಗಾಗಿ ಪ್ರಾರ್ಥನೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 140">ಕೀರ್ತ 140</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1"/>ಯೆಹೋವನೇ, ನನ್ನ ಪ್ರಾರ್ಥನೆಯನ್ನು ಆಲಿಸು;</para>
  <para style="q" vid="PSA 143:1">ನನ್ನ ಬಿನ್ನಹಕ್ಕೆ ಕಿವಿಗೊಡು;</para>
  <para style="q" vid="PSA 143:1">ನಿನ್ನ ನೀತಿ ಸತ್ಯತೆಗಳಿಗೆ ಅನುಸಾರವಾಗಿ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು.<verse eid="PSA 143:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2"/>ನಿನ್ನ ಸೇವಕನನ್ನು ವಿಚಾರಣೆಗೆ ಗುರಿಮಾಡಬೇಡ;</para>
  <para style="q" vid="PSA 143:2">ನಿನ್ನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಯಾವ ಜೀವಿಯೂ ನೀತಿವಂತನಲ್ಲ.<verse eid="PSA 143:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3"/>ವೈರಿಯು ನನ್ನ ಪ್ರಾಣವನ್ನು ಹಿಂಸಿಸಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 143:3">ಜೀವವನ್ನು ನೆಲಕ್ಕೆ ಹಾಕಿ ಜಜ್ಜಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 143:3">ಕಾರ್ಗತ್ತಲೆಯಲ್ಲಿ ನನ್ನನ್ನು ಹಾಕಿದ್ದಾನೆ;</para>
  <para style="q" vid="PSA 143:3">ಬಹು ಕಾಲದಿಂದ ಸತ್ತವರಂತಿದ್ದೇನೆ.<verse eid="PSA 143:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4"/>ನನ್ನ ಆತ್ಮವು ಕುಂದಿಹೋಗಿದೆ;</para>
  <para style="q" vid="PSA 143:4">ನನ್ನ ಮನಸ್ಸು ಬೆರಗಾಗಿದೆ.<verse eid="PSA 143:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5"/>ಹಳೆಯ ದಿನಗಳನ್ನು ನೆನಪುಮಾಡಿಕೊಳ್ಳುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 143:5">ನಿನ್ನ ಎಲ್ಲಾ ಕಾರ್ಯಗಳನ್ನು ಧ್ಯಾನಿಸುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 143:5">ನಿನ್ನ ಕೈಕೆಲಸಗಳನ್ನು ಸ್ಮರಿಸುತ್ತೇನೆ;<verse eid="PSA 143:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6"/>ಕೈಚಾಚಿ ಬೇಡುತ್ತೇನೆ;</para>
  <para style="q" vid="PSA 143:6">ಒಣನೆಲವು ನೀರಿಗಾಗಿ ಹೇಗೋ,</para>
  <para style="q" vid="PSA 143:6">ಹಾಗೆಯೇ ನನ್ನ ಆತ್ಮವು ನಿನಗಾಗಿ ತವಕಪಡುತ್ತದೆ. <char style="qs">ಸೆಲಾ</char><verse eid="PSA 143:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7"/>ಯೆಹೋವನೇ, ಬೇಗನೆ ಸದುತ್ತರವನ್ನು ದಯಪಾಲಿಸು;</para>
  <para style="q" vid="PSA 143:7">ನನ್ನ ಆತ್ಮವು ಕುಂದಿಹೋಗಿದೆ.</para>
  <para style="q" vid="PSA 143:7">ನೀನು ವಿಮುಖನಾದರೆ ಸಮಾಧಿಯಲ್ಲಿ ಸೇರಿದವರಿಗೆ ನಾನು ಸಮಾನನಾಗಿರುವೆನು.<verse eid="PSA 143:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8"/>ಹೊತ್ತಾರೆ ನಿನ್ನ ಕೃಪೆಯು ನನಗೆ ಪ್ರಕಟವಾಗಲಿ;</para>
  <para style="q" vid="PSA 143:8">ನಿನ್ನಲ್ಲಿ ಭರವಸವಿಟ್ಟಿದ್ದೇನಲ್ಲಾ.</para>
  <para style="q" vid="PSA 143:8">ನಾನು ನಡೆಯತಕ್ಕ ಮಾರ್ಗವನ್ನು ತಿಳಿಸು;</para>
  <para style="q" vid="PSA 143:8">ನನ್ನ ಮನಸ್ಸನ್ನು ನಿನ್ನಲ್ಲಿಯೇ ಇಟ್ಟಿದ್ದೇನೆ.<verse eid="PSA 143:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9"/>ಯೆಹೋವನೇ, ನಿನ್ನನ್ನೇ ಮೊರೆಹೊಕ್ಕಿದ್ದೇನೆ;</para>
  <para style="q" vid="PSA 143:9">ಶತ್ರುಗಳಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು.<verse eid="PSA 143:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10"/>ನಿನ್ನ ಚಿತ್ತದಂತೆ ನಡೆಯಲು ನನಗೆ ಕಲಿಸು,</para>
  <para style="q" vid="PSA 143:10">ನನ್ನ ದೇವರು ನೀನಲ್ಲವೋ?</para>
  <para style="q" vid="PSA 143:10">ಶುಭಕಾರಿಯಾಗಿರುವ ನಿನ್ನ ಆತ್ಮನು ನನ್ನನ್ನು ಸಮದಾರಿಯಲ್ಲಿ ನಡೆಸಲಿ.<verse eid="PSA 143:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಹೆಸರಿನ ನಿಮಿತ್ತ ನನ್ನನ್ನು ಉಜ್ಜೀವಿಸಮಾಡು;</para>
  <para style="q" vid="PSA 143:11">ನಿನ್ನ ನೀತಿಗನುಸಾರವಾಗಿ ನನ್ನ ಪ್ರಾಣವನ್ನು ವಿಪತ್ತಿನಿಂದ ಬಿಡಿಸು.<verse eid="PSA 143:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12"/>ನನಗೆ ಕೃಪೆತೋರಿಸಿ ನನ್ನ ವೈರಿಗಳನ್ನು ಖಂಡಿಸಿಬಿಡು.</para>
  <para style="q" vid="PSA 143:12">ನನ್ನ ಪ್ರಾಣಕಂಟಕರನ್ನೆಲ್ಲಾ ಕಡಿದುಹಾಕು;</para>
  <para style="q" vid="PSA 143:12">ನಾನು ನಿನ್ನ ಸೇವಕನಲ್ಲವೇ.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s">ಜಯದ ಗೀತೆ, ಸೌಭಾಗ್ಯದ ನಿರೀಕ್ಷೆ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="r">
    <ref loc="PSA 18">ಕೀರ್ತ 18</ref>; <ref loc="DEU 33:26-29">ಧರ್ಮೋ 33:26-29</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1"/>ನನ್ನ ಶರಣನಾದ ಯೆಹೋವನಿಗೆ ಕೊಂಡಾಟವಾಗಲಿ.</para>
  <para style="q" vid="PSA 144:1">ಆತನು ನನ್ನ ಕೈಗಳಿಗೆ ಯುದ್ಧವಿದ್ಯೆಯನ್ನು,</para>
  <para style="q" vid="PSA 144:1">ನನ್ನ ಬೆರಳುಗಳಿಗೆ ಕಾಳಗವನ್ನು ಕಲಿಸಿದ್ದಾನೆ.<verse eid="PSA 144:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2"/>ನನ್ನ ಪ್ರೀತಿಯು, ನನ್ನ ಕೋಟೆಯು, ನನ್ನ ದುರ್ಗವು,</para>
  <para style="q" vid="PSA 144:2">ನನ್ನ ರಕ್ಷಕನು, ನನ್ನ ಗುರಾಣಿಯು, ಆಶ್ರಯವು,</para>
  <para style="q" vid="PSA 144:2">
    <note caller="+" style="f">
      <char style="fr" closed="false">144:2 </char>
      <char style="ft" closed="false">ಅಥವಾ ನನ್ನ ಜನವನ್ನು</char>
    </note>ಜನಾಂಗಗಳನ್ನು ನನಗೆ ಅಧೀನಮಾಡಿದವನೂ ಆತನೇ.<verse eid="PSA 144:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3"/>ಯೆಹೋವನೇ, ಮನುಷ್ಯನು ಎಷ್ಟು ಮಾತ್ರದವನು?</para>
  <para style="q" vid="PSA 144:3">ಅವನನ್ನು ನೀನು ಏಕೆ ನೆನಸಬೇಕು?</para>
  <para style="q" vid="PSA 144:3">ಮಾನವನು ಎಷ್ಟರವನು?</para>
  <para style="q" vid="PSA 144:3">ಅವನಲ್ಲಿ ಏಕೆ ಲಕ್ಷ್ಯವಿಡಬೇಕು?<verse eid="PSA 144:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4"/>ಮನುಷ್ಯನು ಬರೀ ಉಸಿರೇ,</para>
  <para style="q" vid="PSA 144:4">ಅವನ ಜೀವಕಾಲವು ಬೇಗನೆ ಗತಿಸಿಹೋಗುವ ನೆರಳಿನಂತಿದೆ.<verse eid="PSA 144:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5"/>ಯೆಹೋವನೇ, ಆಕಾಶವನ್ನು ತಗ್ಗಿಸಿ ಇಳಿದು ಬಾ,</para>
  <para style="q" vid="PSA 144:5">ಪರ್ವತಗಳನ್ನು ಮುಟ್ಟು, ಆಗ ಅವು ಹೊಗೆಹಾಯುವವು.<verse eid="PSA 144:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6"/>ಸಿಡಿಲಿನಿಂದ ಶತ್ರುಗಳನ್ನು ಚದರಿಸಿಬಿಡು,</para>
  <para style="q" vid="PSA 144:6">ನಿನ್ನ ಬಾಣಗಳಿಂದ ಅವರನ್ನು ಭ್ರಾಂತಿಗೊಳಿಸು.<verse eid="PSA 144:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7"/>ಮೇಲಣ ಲೋಕದಿಂದ ಕೈಚಾಚಿ,</para>
  <para style="q" vid="PSA 144:7">ಮಹಾ ಜಲರಾಶಿಯೊಳಗಿಂದ ನನ್ನನ್ನು ಎಳೆದುಕೋ.<verse eid="PSA 144:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8"/>ಕಪಟವಚನದವರೂ, ಬಲಗೈಯೆತ್ತಿ ಸುಳ್ಳಾಣೆಯಿಡುವವರೂ</para>
  <para style="q" vid="PSA 144:8">ಆಗಿರುವ ಅನ್ಯಜನಗಳ ಕೈಯಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸು.<verse eid="PSA 144:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9"/>ದೇವರೇ, ನಿನಗೆ ನೂತನ ಕೀರ್ತನೆಯನ್ನು ಹಾಡುವೆನು,</para>
  <para style="q" vid="PSA 144:9">ಹತ್ತುತಂತಿಗಳ ಸ್ವರಮಂಡಲವನ್ನು ನುಡಿಸುತ್ತಾ ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 144:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10"/>ಅರಸುಗಳಿಗೆ ಜಯಪ್ರದನೂ, ಸೇವಕನಾದ ದಾವೀದನನ್ನು</para>
  <para style="q" vid="PSA 144:10">ಹಾನಿಕರವಾದ ಕತ್ತಿಗೆ ತಪ್ಪಿಸಿದವನೂ ನೀನೇ.<verse eid="PSA 144:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11"/>ಕಪಟವಚನದವರೂ, ಬಲಗೈಯೆತ್ತಿ ಸುಳ್ಳಾಣೆ ಇಡುವವರೂ ಆಗಿರುವ</para>
  <para style="q" vid="PSA 144:11">ಅನ್ಯಜನಗಳ ಕೈಯಿಂದ ನನ್ನನ್ನು ಬಿಡಿಸಿ ಕಾಪಾಡು.<verse eid="PSA 144:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12"/>ಯೌವನಸ್ಥರಾದ ನಮ್ಮ ಗಂಡುಮಕ್ಕಳು</para>
  <para style="q" vid="PSA 144:12">ಸಮೃದ್ಧಿಯಾಗಿ ಬೆಳದಿರುವ ಸಸಿಗಳಂತಿರುವರು,</para>
  <para style="q" vid="PSA 144:12">ಹೆಣ್ಣುಮಕ್ಕಳು ಅರಮನೆಯಲ್ಲಿ ಕೆತ್ತಿದ ಮೂಲೆಗಂಬದಂತೆ ಇರುವರು.<verse eid="PSA 144:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13"/>ನಮ್ಮ ಕಣಜಗಳು ಸಕಲವಿಧವಾದ ಧಾನ್ಯಗಳಿಂದ ತುಂಬಿರುವವು,</para>
  <para style="q" vid="PSA 144:13">ನಮ್ಮ ಹೊಲಗಳಲ್ಲಿರುವ ಕುರಿಗಳು ಸಾವಿರಾರು ಮರಿಗಳನ್ನು ಈಯುವವು.<verse eid="PSA 144:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14"/>ನಮ್ಮ ಪಶುಗಳು ಅಸಂಖ್ಯಾತವಾಗಲಿ,</para>
  <para style="q" vid="PSA 144:14">ವೈರಿಗಳು ಒಳಗೆ ನುಗ್ಗುವುದಾಗಲಿ,</para>
  <para style="q" vid="PSA 144:14">ನಮ್ಮವರನ್ನು ಸೆರೆ ಒಯ್ಯುವುದಾಗಲಿ ಇರುವುದಿಲ್ಲ,</para>
  <para style="q" vid="PSA 144:14">ಬೀದಿಗಳಲ್ಲಿ ಗೋಳಾಟವು ಕೇಳಿಸುವುದಿಲ್ಲ.<verse eid="PSA 144:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15"/>ಇಂಥ ಸುಸ್ಥಿತಿಯಲ್ಲಿರುವ ಜನರು ಧನ್ಯರು,</para>
  <para style="q" vid="PSA 144:15">ಯಾರಿಗೆ ಯೆಹೋವನು ದೇವರಾಗಿರುತ್ತಾನೋ ಅವರು ಭಾಗ್ಯವಂತರು.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s">ಯೆಹೋವನ ಕೃಪೆ ಪ್ರಭಾವಗಳಿಗಾಗಿ ಕೊಂಡಾಟ</para>
  <para style="d">ದಾವೀದನ ಕೀರ್ತನೆ.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1"/>ನನ್ನ ದೇವರೇ, ರಾಜನೇ, ನಿನ್ನನ್ನು ಘನಪಡಿಸುವೆನು,</para>
  <para style="q" vid="PSA 145:1">ನಿನ್ನ ನಾಮವನ್ನು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 145:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2"/>ಪ್ರತಿದಿನವೂ ನಿನ್ನನ್ನು ಕೀರ್ತಿಸುವೆನು,</para>
  <para style="q" vid="PSA 145:2">ನಿನ್ನ ನಾಮವನ್ನು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಸ್ತುತಿಸುವೆನು.<verse eid="PSA 145:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3"/>ಯೆಹೋವನು ಮಹೋನ್ನತನೂ, ಮಹಾಸ್ತುತಿಪಾತ್ರನೂ ಆಗಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 145:3">ಆತನ ಮಹತ್ತು ಅಪಾರವಾದದ್ದು.<verse eid="PSA 145:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4"/>ಜನರು ವಂಶ ಪಾರಂಪರ್ಯವಾಗಿ ನಿನ್ನ ಕೃತ್ಯಗಳನ್ನು ಹೊಗಳುವರು,</para>
  <para style="q" vid="PSA 145:4">ನಿನ್ನ ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ವರ್ಣಿಸುವರು.<verse eid="PSA 145:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">145:5 </char>
      <char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ನಾನು ನಿನ್ನ ಮಹಾಪ್ರಭಾವಯುಕ್ತವಾದ ಮಹಿಮೆಯನ್ನು ಕೊಂಡಾಡುವೆನು ಎಂದು ಇದೆ. </char>
    </note>ಅವರು ನಿನ್ನ ಮಹಾಪ್ರಭಾವಯುಕ್ತವಾದ ಮಹಿಮೆಯನ್ನು ಕೊಂಡಾಡುವರು,</para>
  <para style="q" vid="PSA 145:5">ನಿನ್ನ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನೂ ಧ್ಯಾನಿಸುವೆನು.<verse eid="PSA 145:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6"/>ಮನುಷ್ಯರು ನಿನ್ನ ಭಯಂಕರ ಕೃತ್ಯಗಳಲ್ಲಿ ಕಂಡು ಬಂದ ಪ್ರತಾಪವನ್ನು ಕೊಂಡಾಡುವರು.</para>
  <para style="q" vid="PSA 145:6">ನಾನು ನಿನ್ನ ಮಹತ್ತನ್ನು ಪ್ರಸಿದ್ಧಪಡಿಸುವೆನು.<verse eid="PSA 145:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7"/>ಜನರು ನಿನ್ನ ಮಹೋಪಕಾರವನ್ನು ನೆನಪಿನಲ್ಲಿಟ್ಟುಕೊಂಡು ಪ್ರಕಟಿಸುವರು,</para>
  <para style="q" vid="PSA 145:7">ನಿನ್ನ ನೀತಿಯನ್ನು ಹೊಗಳುವರು.<verse eid="PSA 145:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8"/>ಯೆಹೋವನು ದಯೆಯು, ಕನಿಕರವು ಉಳ್ಳವನು,</para>
  <para style="q" vid="PSA 145:8">ದೀರ್ಘಶಾಂತನು, ಪ್ರೀತಿಪೂರ್ಣನು ಆಗಿದ್ದಾನೆ.<verse eid="PSA 145:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9"/>ಯೆಹೋವನು ಸರ್ವೋಪಕಾರಿಯು,</para>
  <para style="q" vid="PSA 145:9">ತಾನು ನಿರ್ಮಿಸಿದವುಗಳನ್ನೆಲ್ಲಾ ಕರುಣಿಸುವಾತನೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 145:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10"/>ಯೆಹೋವನೇ, ನಿನ್ನ ಸೃಷ್ಟಿಯೆಲ್ಲವು ನಿನ್ನನ್ನು ಸ್ತುತಿಸುವುದು,</para>
  <para style="q" vid="PSA 145:10">ನಿನ್ನ ಭಕ್ತರು ನಿನ್ನನ್ನು ಕೊಂಡಾಡುವರು.<verse eid="PSA 145:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11"/>ಅವರು ನಿನ್ನ ರಾಜ್ಯಮಹತ್ತನ್ನು ಪ್ರಸಿದ್ಧಪಡಿಸುವರು,</para>
  <para style="q" vid="PSA 145:11">ನಿನ್ನ ಪ್ರತಾಪವನ್ನು ವರ್ಣಿಸುವರು.<verse eid="PSA 145:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12"/>ಹೀಗೆ ಮಾನವರು ನಿನ್ನ ಶೂರಕೃತ್ಯಗಳನ್ನೂ,</para>
  <para style="q" vid="PSA 145:12">ನಿನ್ನ ರಾಜ್ಯದ ಮಹಾಪ್ರಭಾವವನ್ನೂ ಗ್ರಹಿಸಿಕೊಳ್ಳುವರು.<verse eid="PSA 145:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">145:13 </char>
      <char style="ft" closed="false">ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ಯೆಹೋವನು ತನ್ನ ಎಲ್ಲ ವಾಗ್ದಾನಗಳಲ್ಲಿ ನಂಬಿಗಸ್ತನು, ತನ್ನ ಎಲ್ಲಾ ಕ್ರಿಯೆಗಳಲ್ಲಿ ಕರುಣೆಯುಳ್ಳವನು ಆಗಿದ್ದಾನೆ ಎಂದು ಇದೆ.</char>
    </note>ನಿನ್ನ ರಾಜ್ಯವು ಶಾಶ್ವತವಾಗಿದೆ,</para>
  <para style="q" vid="PSA 145:13">ನಿನ್ನ ಆಳ್ವಿಕೆಯು ತಲತಲಾಂತರಕ್ಕೂ ಇರುವುದು.<verse eid="PSA 145:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14"/>ಯೆಹೋವನು ಬಿದ್ದವರನ್ನೆಲ್ಲಾ ಎತ್ತುವವನೂ,</para>
  <para style="q" vid="PSA 145:14">ಕುಗ್ಗಿದವರನ್ನೆಲ್ಲಾ ಉದ್ಧರಿಸುವವನೂ ಆಗಿದ್ದಾನೆ.<verse eid="PSA 145:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15"/>ಯೆಹೋವನೇ, ಎಲ್ಲಾ ಜೀವಿಗಳ ಕಣ್ಣುಗಳು ನಿನ್ನನ್ನೇ ನೋಡುತ್ತವೆ,</para>
  <para style="q" vid="PSA 145:15">ನೀನು ಅವುಗಳಿಗೆ ಹೊತ್ತುಹೊತ್ತಿಗೆ ಆಹಾರಕೊಡುತ್ತಿ.<verse eid="PSA 145:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16"/>ನೀನು ಕೈತೆರೆದು ಎಲ್ಲಾ ಜೀವಿಗಳ ಇಷ್ಟವನ್ನು ನೆರವೇರಿಸುತ್ತಿ.<verse eid="PSA 145:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17"/>ಯೆಹೋವನ ಮಾರ್ಗಗಳೆಲ್ಲಾ ನೀತಿಯುಳ್ಳವುಗಳು,</para>
  <para style="q" vid="PSA 145:17">ಆತನು ಎಲ್ಲಾ ಕಾರ್ಯಗಳಲ್ಲಿ ಕೃಪೆ ತೋರಿಸುವವನು.<verse eid="PSA 145:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18"/>ಯೆಹೋವನಿಗೆ ಮೊರೆಯಿಡುವವರು,</para>
  <para style="q" vid="PSA 145:18">ಯಥಾರ್ಥವಾಗಿ ಮೊರೆಯಿಡುವುದಾದರೆ ಆತನು ಹತ್ತಿರವಾಗಿಯೇ ಇದ್ದಾನೆ.<verse eid="PSA 145:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19"/>ತನ್ನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರ ಇಷ್ಟವನ್ನು ನೆರವೇರಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 145:19">ಅವರ ಕೂಗನ್ನು ಕೇಳಿ ರಕ್ಷಿಸುತ್ತಾನೆ.<verse eid="PSA 145:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20"/>ಯೆಹೋವನು ತನ್ನನ್ನು ಪ್ರೀತಿಸುವವರೆಲ್ಲರನ್ನು ಕಾಪಾಡುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 145:20">ಆದರೆ ಎಲ್ಲಾ ದುಷ್ಟರನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ.<verse eid="PSA 145:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21"/>ನನ್ನ ಬಾಯಿ ಯೆಹೋವನನ್ನು ಕೀರ್ತಿಸುವುದು,</para>
  <para style="q" vid="PSA 145:21">ಎಲ್ಲಾ ಜೀವಿಗಳು ಆತನ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು</para>
  <para style="q" vid="PSA 145:21">ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಕೊಂಡಾಡಲಿ.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="s">ಯೆಹೋವನನ್ನು ಆಶ್ರಯಿಸಿಕೊಂಡವನು ಧನ್ಯನು</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 146:1">ನನ್ನ ಮನವೇ, ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸು.<verse eid="PSA 146:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2"/>ಪ್ರಾಣವಿರುವವರೆಗೂ ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸುವೆನು,</para>
  <para style="q" vid="PSA 146:2">ಜೀವಮಾನವೆಲ್ಲಾ ನನ್ನ ದೇವರನ್ನು ಕೊಂಡಾಡುವೆನು.<verse eid="PSA 146:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3"/>ಪ್ರಭುಗಳಲ್ಲಾಗಲಿ, ಮನುಷ್ಯರಲ್ಲಾಗಲಿ ಭರವಸವಿಡಬೇಡಿರಿ,</para>
  <para style="q" vid="PSA 146:3">ಅವರು ಸಹಾಯ ಮಾಡ ಶಕ್ತರಲ್ಲ,<verse eid="PSA 146:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4"/>ಉಸಿರು ಹೋಗಲು ಅವರು ಮಣ್ಣಿಗೆ ಸೇರುತ್ತಾರೆ,</para>
  <para style="q" vid="PSA 146:4">ಅವರ ಸಂಕಲ್ಪಗಳೆಲ್ಲಾ ಅದೇ ದಿನದಲ್ಲಿ ಹಾಳಾಗುವುದು.<verse eid="PSA 146:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5"/>ಯಾರಿಗೆ ಯಾಕೋಬನ ದೇವರು ಸಹಾಯಕನೋ,</para>
  <para style="q" vid="PSA 146:5">ಯಾರು ತನ್ನ ದೇವರಾದ ಯೆಹೋವನನ್ನು ನಂಬಿರುತ್ತಾನೋ,</para>
  <para style="q" vid="PSA 146:5">ಅವನೇ ಧನ್ಯನು.<verse eid="PSA 146:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6"/>ಭೂಮಿ, ಆಕಾಶ, ಸಾಗರ, ಜಲಚರ ಇವುಗಳನ್ನು ನಿರ್ಮಿಸಿದವನೂ,</para>
  <para style="q" vid="PSA 146:6">ವಾಗ್ದಾನವನ್ನು ಯಾವಾಗಲೂ ನೆರವೇರಿಸುವವನೂ,<verse eid="PSA 146:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7"/>ಹಿಂಸೆಗೆ ಗುರಿಯಾದವರ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸುವವನೂ,</para>
  <para style="q" vid="PSA 146:7">ಹಸಿದವರಿಗೆ ಆಹಾರ ಕೊಡುವವನೂ ಆತನೇ.</para>
  <para style="q" vid="PSA 146:7">ಯೆಹೋವನು ಸೆರೆಯಲ್ಲಿರುವವರನ್ನು ಬಿಡಿಸುತ್ತಾನೆ.<verse eid="PSA 146:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8"/>ಯೆಹೋವನು ಕುರುಡರಿಗೆ ಕಣ್ಣು ಕೊಡುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 146:8">ಯೆಹೋವನು ಕುಗ್ಗಿದವರನ್ನು ಉದ್ಧರಿಸುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 146:8">ಯೆಹೋವನು ನೀತಿವಂತರನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ.<verse eid="PSA 146:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9"/>ಯೆಹೋವನು ಪರದೇಶದವರನ್ನು ಕಾಪಾಡುತ್ತಾನೆ.</para>
  <para style="q" vid="PSA 146:9">ಆತನು ಅನಾಥರಿಗೂ, ವಿಧವೆಯರಿಗೂ ಆಧಾರವಾಗಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 146:9">ಆದರೆ ದುಷ್ಟರ ಮಾರ್ಗವನ್ನು ಡೊಂಕು ಮಾಡುತ್ತಾನೆ.<verse eid="PSA 146:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10"/>ಯೆಹೋವನು ಸದಾಕಾಲವೂ ಅರಸನಾಗಿರುವನು,</para>
  <para style="q" vid="PSA 146:10">ಚೀಯೋನೇ, ನಿನ್ನ ದೇವರು ತಲತಲಾಂತರಕ್ಕೂ ಆಳುವನು,</para>
  <para style="q" vid="PSA 146:10">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="s">ಸ್ವಪ್ರಜಾರಕ್ಷಕನಾಗಿರುವ ಸೃಷ್ಟಿಪಾಲಕನಿಗೆ ಸ್ತೋತ್ರ</para>
  <para style="r">
    <ref loc="PSA 33">ಕೀರ್ತ 33</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 147:1">ನಮ್ಮ ದೇವರನ್ನು ಸ್ತುತಿಸುವುದು ಒಳ್ಳೆಯದೂ, ಸಂತೋಷಕರವೂ ಆಗಿದೆ,</para>
  <para style="q" vid="PSA 147:1">ಆತನನ್ನು ಕೀರ್ತಿಸುವುದು ಯುಕ್ತವಾಗಿದೆ.<verse eid="PSA 147:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2"/>ಯೆಹೋವನು ಯೆರೂಸಲೇಮನ್ನು ಕಟ್ಟಿಸುತ್ತಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 147:2">ಚದರಿಹೋಗಿದ್ದ ಇಸ್ರಾಯೇಲರನ್ನು ಕೂಡಿಸುತ್ತಿದ್ದಾನೆ,<verse eid="PSA 147:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3"/>ಮುರಿದ ಮನಸ್ಸುಳ್ಳವರನ್ನು ವಾಸಿಮಾಡುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:3">ಅವರ ಗಾಯಗಳನ್ನು ಕಟ್ಟುತ್ತಾನೆ.<verse eid="PSA 147:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4"/>ಅವನು ನಕ್ಷತ್ರಗಳ ಸಂಖ್ಯೆಯನ್ನು ಗೊತ್ತುಮಾಡಿ,</para>
  <para style="q" vid="PSA 147:4">ಪ್ರತಿಯೊಂದಕ್ಕೂ ಹೆಸರಿಟ್ಟಿದ್ದಾನೆ.<verse eid="PSA 147:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5"/>ನಮ್ಮ ಕರ್ತನು ದೊಡ್ಡವನೂ, ಪರಾಕ್ರಮಿಯೂ ಆಗಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 147:5">ಆತನ ಜ್ಞಾನವು ಅಪರಿಮಿತವಾಗಿದೆ.<verse eid="PSA 147:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6"/>ಯೆಹೋವನು ದೀನರಿಗೆ ಆಧಾರವಾಗಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 147:6">ದುಷ್ಟರನ್ನು ನೆಲಕ್ಕೆ ಹಾಕಿ ತುಳಿದುಬಿಡುತ್ತಾನೆ.<verse eid="PSA 147:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7"/>ಯೆಹೋವನಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಮಾಡಿರಿ,</para>
  <para style="q" vid="PSA 147:7">ಕಿನ್ನರಿಯೊಡನೆ ನಮ್ಮ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ.<verse eid="PSA 147:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8"/>ಆತನು ಆಕಾಶದಲ್ಲಿ ಮೋಡಗಳನ್ನು ಕವಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:8">ಭೂಮಿಗೋಸ್ಕರ ಮಳೆಯನ್ನು ಸಿದ್ಧಮಾಡುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:8">ಬೆಟ್ಟಗಳಲ್ಲಿ ಹುಲ್ಲನ್ನು ಬೆಳೆಸುತ್ತಾನೆ.<verse eid="PSA 147:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9"/>ಆತನು ಪಶುಗಳಿಗೂ, ಕೂಗುತ್ತಿರುವ ಕಾಗೆಮರಿಗಳಿಗೂ</para>
  <para style="q" vid="PSA 147:9">ಬೇಕಾದ ಆಹಾರಕೊಡುತ್ತಾನೆ.<verse eid="PSA 147:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10"/>ಕುದುರೆಯ ಶಕ್ತಿಯಲ್ಲಿ ಆತನಿಗೆ ಇಷ್ಟವಿಲ್ಲ,</para>
  <para style="q" vid="PSA 147:10">ಆಳಿನ ತೊಡೆಯ ಬಲವನ್ನು ಆತನು ಮೆಚ್ಚುವುದಿಲ್ಲ.<verse eid="PSA 147:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11"/>ಯೆಹೋವನು ಆನಂದಿಸುವುದು</para>
  <para style="q" vid="PSA 147:11">ತನ್ನ ಕೃಪೆಯನ್ನು ನಿರೀಕ್ಷಿಸುವ ಭಕ್ತರಲ್ಲೇ.<verse eid="PSA 147:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12"/>ಯೆರೂಸಲೇಮೇ, ಯೆಹೋವನನ್ನು ಕೀರ್ತಿಸು,</para>
  <para style="q" vid="PSA 147:12">ಚೀಯೋನೇ, ನಿನ್ನ ದೇವರನ್ನು ಸ್ತುತಿಸು.<verse eid="PSA 147:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13"/>ಆತನು ನಿನ್ನ ಹೆಬ್ಬಾಗಿಲುಗಳ ಅಗುಳಿಗಳನ್ನು ಬಲಪಡಿಸಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 147:13">ನಿನ್ನ ಮಕ್ಕಳನ್ನು ಆಶೀರ್ವದಿಸಿದ್ದಾನೆ.<verse eid="PSA 147:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14"/>ಆತನು ನಿನ್ನ ಪ್ರಾಂತ್ಯದೊಳಗೆ ಸೌಭಾಗ್ಯವನ್ನು ಉಂಟುಮಾಡುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:14">ಶ್ರೇಷ್ಠವಾದ ಗೋದಿಯಿಂದ ನಿನ್ನನ್ನು ತೃಪ್ತಿಗೊಳಿಸುತ್ತಾನೆ.<verse eid="PSA 147:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15"/>ತನ್ನ ನುಡಿಯನ್ನು ಭೂಲೋಕಕ್ಕೆ ಕಳುಹಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:15">ಆತನ ವಾಕ್ಯವು ಬಹು ವೇಗಶಾಲಿಯಾಗಿದೆ.<verse eid="PSA 147:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16"/>ಉಣ್ಣೆಯಂತಿರುವ ಹಿಮವನ್ನು ಬೀಳಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:16">ಇಬ್ಬನಿಯನ್ನು ಬೂದಿಯಂತೆ ಹರವುತ್ತಾನೆ.<verse eid="PSA 147:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17"/>ರೊಟ್ಟಿ ತುಂಡುಗಳಂತಿರುವ ಆನೆಕಲ್ಲುಗಳನ್ನು ಸುರಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:17">ಆತನು ಚಳಿಯನ್ನು ಬರಮಾಡಲು ಅದನ್ನು ಸಹಿಸುವವರು ಯಾರು?<verse eid="PSA 147:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18"/>ಆತನು ಅಪ್ಪಣೆಕೊಡಲು ಅವು ಕರಗುತ್ತವೆ,</para>
  <para style="q" vid="PSA 147:18">ತನ್ನ ಗಾಳಿಯನ್ನು ಬೀಸಮಾಡಲು ನೀರು ಹರಿಯುತ್ತದೆ.<verse eid="PSA 147:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19"/>ಆತನು ತನ್ನ ವಾಕ್ಯವನ್ನು ಯಾಕೋಬ್ಯರಿಗೆ ತಿಳಿಸುತ್ತಾನೆ,</para>
  <para style="q" vid="PSA 147:19">ತನ್ನ ನಿಯಮವಿಧಿಗಳನ್ನು ಇಸ್ರಾಯೇಲರಿಗೆ ಪ್ರಕಟಿಸುತ್ತಾನೆ.<verse eid="PSA 147:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20"/>ಬೇರೆ ಯಾವ ಜನಾಂಗದವರಿಗೂ ಆತನು ಹೀಗೆ ಮಾಡಲಿಲ್ಲ,</para>
  <para style="q" vid="PSA 147:20">ಆತನ ನ್ಯಾಯವಿಧಿಗಳನ್ನು ಅವರು ಅರಿಯರು.</para>
  <para style="q" vid="PSA 147:20">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="s">ಭೂಮ್ಯಾಕಾಶಗಳು ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಲಿ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 148:1">ಆಕಾಶಮಂಡಲದಿಂದ ಯೆಹೋವನಿಗೆ ಸ್ತುತಿಯುಂಟಾಗಲಿ,</para>
  <para style="q" vid="PSA 148:1">ಮಹೋನ್ನತದಲ್ಲಿ ಆತನ ಸ್ತೋತ್ರವು ಕೇಳಿಸಲಿ.<verse eid="PSA 148:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2"/>ಆತನ ಎಲ್ಲಾ ದೂತರೇ, ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ,</para>
  <para style="q" vid="PSA 148:2">ಆತನ ಎಲ್ಲಾ ಸೈನ್ಯಗಳೇ, ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3"/>ಸೂರ್ಯ ಮತ್ತು ಚಂದ್ರರೇ, ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ,</para>
  <para style="q" vid="PSA 148:3">ಹೊಳೆಯುವ ಎಲ್ಲಾ ನಕ್ಷತ್ರಗಳೇ, ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4"/>ಉನ್ನತೋನ್ನತವಾದ ಆಕಾಶವೇ,</para>
  <para style="q" vid="PSA 148:4">ಅದರ ಮೇಲಿರುವ ಜಲರಾಶಿಗಳೇ,</para>
  <para style="q" vid="PSA 148:4">ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 148:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5"/>ಅವು ಯೆಹೋವನ ನಾಮವನ್ನು ಸ್ತುತಿಸಲಿ,</para>
  <para style="q" vid="PSA 148:5">ಆತನು ಅಪ್ಪಣೆಕೊಡಲು ಅವು ಉಂಟಾದವು.<verse eid="PSA 148:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6"/>ಆತನು ಅವುಗಳನ್ನು ಯುಗಯುಗಾಂತರಕ್ಕೂ ಸ್ಥಾಪಿಸಿದ್ದಾನೆ,</para>
  <para style="q" vid="PSA 148:6">ಆತನು ಎಂದಿಗೂ ಮೀರಲಾಗದಂಥ ಕಟ್ಟಳೆಯನ್ನು ವಿಧಿಸಿದ್ದಾನೆ.<verse eid="PSA 148:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7"/>ಭೂಮಂಡಲದಿಂದ ಯೆಹೋವನಿಗೆ ಸ್ತುತಿಯುಂಟಾಗಲಿ.</para>
  <para style="q" vid="PSA 148:7">ತಿಮಿಂಗಿಲಗಳು, ಆದಿಸಾಗರಗಳು<verse eid="PSA 148:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8"/>ಬೆಂಕಿ,<note caller="+" style="f"><char style="fr" closed="false">148:8 </char><char style="fq" closed="false">ಬೆಂಕಿ, </char><char style="ft" closed="false">ಮಿಂಚು.</char></note> ಕಲ್ಮಳೆ, ಹಿಮ, ಹಬೆ ಇವುಗಳು,</para>
  <para style="q" vid="PSA 148:8">ಆತನ ಅಪ್ಪಣೆಯನ್ನು ನೆರವೇರಿಸುವ ಬಿರುಗಾಳಿಯು,<verse eid="PSA 148:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9"/>ಬೆಟ್ಟಗಳು, ಎಲ್ಲಾ ಗುಡ್ಡಗಳು, ಹಣ್ಣಿನ ಮರಗಳು,</para>
  <para style="q" vid="PSA 148:9">ಎಲ್ಲಾ ತುರಾಯಿ ಮರಗಳು,<verse eid="PSA 148:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10"/>ಎಲ್ಲಾ ಮೃಗ, ಪಶು, ಪಕ್ಷಿ, ಕ್ರಿಮಿಕೀಟಗಳು,<verse eid="PSA 148:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11"/>ಭೂರಾಜರು, ಎಲ್ಲಾ ಜನಾಂಗಗಳು, ಪ್ರಭುಗಳು, ಸರ್ವದೇಶಾಧಿಪತಿಗಳು,<verse eid="PSA 148:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12"/>ಪ್ರಾಯಸ್ಥರಾದ ಸ್ತ್ರೀಪುರುಷರು, ಮುದುಕರು, ಹುಡುಗರು<verse eid="PSA 148:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13"/>ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಲಿ.</para>
  <para style="q" vid="PSA 148:13">ಆತನ ನಾಮವೊಂದೇ ಮಹತ್ವವುಳ್ಳದ್ದು,</para>
  <para style="q" vid="PSA 148:13">ಆತನ ಪ್ರಭಾವವು ಭೂಮ್ಯಾಕಾಶಗಳಲ್ಲಿ ಪ್ರಸರಿಸಿದೆ.<verse eid="PSA 148:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14"/>ಆತನು ತನ್ನ ಪ್ರಜೆಗೋಸ್ಕರ ಘನದ ಕೊಂಬನ್ನು ಎಬ್ಬಿಸಿದ್ದಾನೆ.</para>
  <para style="q" vid="PSA 148:14">ಆದುದರಿಂದ ಆತನ ಎಲ್ಲಾ ಭಕ್ತರು,</para>
  <para style="q" vid="PSA 148:14">ಆತನ ಸಮೀಪ ಪ್ರಜೆಗಳಾದ ಇಸ್ರಾಯೇಲರು ಹಿಗ್ಗುತ್ತಾರೆ.</para>
  <para style="q" vid="PSA 148:14">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="s">ಜಯಗೀತೆ</para>
  <para style="r">
    <ref loc="REV 19">ಪ್ರಕ 19</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 149:1">ಯೆಹೋವನಿಗೆ ನೂತನ ಕೀರ್ತನೆಯನ್ನು ಹಾಡಿರಿ;</para>
  <para style="q" vid="PSA 149:1">ಭಕ್ತರ ಸಭೆಯಲ್ಲಿ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 149:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2"/>ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಸೃಷ್ಟಿಕರ್ತನಲ್ಲಿ ಹೆಮ್ಮೆಪಡಲಿ;</para>
  <para style="q" vid="PSA 149:2">ಚೀಯೋನಿನವರು ತಮ್ಮ ರಾಜನಲ್ಲಿ ಹರ್ಷಿಸಲಿ.<verse eid="PSA 149:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3"/>ಕುಣಿಯುತ್ತಾ ಆತನ ನಾಮವನ್ನು ಕೀರ್ತಿಸಲಿ;</para>
  <para style="q" vid="PSA 149:3">ದಮ್ಮಡಿ, ಕಿನ್ನರಿಗಳಿಂದ ಆತನನ್ನು ಭಜಿಸಲಿ.<verse eid="PSA 149:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4"/>ಯೆಹೋವನು ತನ್ನ ಪ್ರಜೆಗೆ ಪ್ರಸನ್ನನಾದನು;</para>
  <para style="q" vid="PSA 149:4">ದೀನರನ್ನು ರಕ್ಷಣೆಯಿಂದ ಭೂಷಿಸುತ್ತಾನೆ.<verse eid="PSA 149:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5"/>ಭಕ್ತರು ತಮಗುಂಟಾದ ಮಹಿಮೆಯಲ್ಲಿ ಹಿಗ್ಗಲಿ;</para>
  <para style="q" vid="PSA 149:5">ಹಾಸಿಗೆಯ ಮೇಲಿರುವಾಗಲೂ ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಲಿ.<verse eid="PSA 149:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6"/>ಅವರ ಬಾಯಲ್ಲಿ ಯೆಹೋವನ ಸ್ತೋತ್ರವೂ,</para>
  <para style="q" vid="PSA 149:6">ಕೈಯಲ್ಲಿ ಇಬ್ಬಾಯಿಕತ್ತಿಯೂ ಇರಲಿ.<verse eid="PSA 149:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7"/>ಅವರು ಜನಾಂಗಗಳಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವರು;</para>
  <para style="q" vid="PSA 149:7">ಅನ್ಯಜನಗಳನ್ನು ದಂಡಿಸುವರು;<verse eid="PSA 149:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8"/>ಅವರ ರಾಜರನ್ನು ಸಂಕೋಲೆಯಿಂದ ಬಂಧಿಸುವರು;</para>
  <para style="q" vid="PSA 149:8">ಪ್ರಭುಗಳಿಗೆ ಕಬ್ಬಿಣದ ಬೇಡಿಗಳನ್ನು ಹಾಕುವರು.<verse eid="PSA 149:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9"/>ಲಿಖಿತದಂತೆ ಅವರಿಗೆ ಶಿಕ್ಷೆಯನ್ನು ವಿಧಿಸುವರು;</para>
  <para style="q" vid="PSA 149:9">ಇದು ಆತನ ಭಕ್ತರೆಲ್ಲರಿಗೆ ಗೌರವವಾಗಿರುವುದು.</para>
  <para style="q" vid="PSA 149:9">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="s">ಸಮಾಪ್ತಿಯ ಕೀರ್ತನೆ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1"/>ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!</para>
  <para style="q" vid="PSA 150:1">ದೇವರನ್ನು ಆತನ ಪರಿಶುದ್ಧ ಆಲಯದಲ್ಲಿ ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 150:1">ಆತನ ಶಕ್ತಿಪ್ರದರ್ಶಕವಾದ ಆಕಾಶಮಂಡಲದಲ್ಲಿ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2"/>ಆತನ ಮಹತ್ಕಾರ್ಯಗಳಿಗಾಗಿ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 150:2">ಆತನ ಮಹಾಪ್ರಭಾವಕ್ಕೆ ಸರಿಯಾಗಿ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3"/>ಕೊಂಬೂದುತ್ತಾ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 150:3">ಸ್ವರಮಂಡಲ, ಕಿನ್ನರಿಗಳಿಂದ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4"/>ದಮ್ಮಡಿಯನ್ನು ಬಡಿಯುತ್ತಾ, ಕುಣಿಯುತ್ತಾ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 150:4">ತಂತಿವಾದ್ಯಗಳಿಂದಲೂ, ಕೊಳಲುಗಳಿಂದಲೂ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5"/>ತಾಳದಿಂದ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ;</para>
  <para style="q" vid="PSA 150:5">ಝಲ್ಲರಿಯಿಂದ ಆತನನ್ನು ಸ್ತುತಿಸಿರಿ.<verse eid="PSA 150:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6"/>ಶ್ವಾಸವಿರುವ ಎಲ್ಲವೂ ಯೆಹೋವನನ್ನು ಸ್ತುತಿಸಲಿ;</para>
  <para style="q" vid="PSA 150:6">ಯೆಹೋವನಿಗೆ ಸ್ತೋತ್ರ!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
