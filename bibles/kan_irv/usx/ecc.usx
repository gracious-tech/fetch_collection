<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright © 2017 Bridge Connectivity Solutions. This translation is made available to you under the terms of the Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">ಪ್ರಸಂಗಿ</para>
  <para style="toc1">ಪ್ರಸಂಗಿ</para>
  <para style="toc2">ಪ್ರಸ</para>
  <para style="toc3">ಪ್ರಸ</para>
  <para style="mt">ಪ್ರಸಂಗಿ</para>
  <para style="is">ಗ್ರಂಥಕರ್ತೃತ್ವ</para>
  <para style="ip">ಪ್ರಸಂಗಿಯ ಗ್ರಂಥವು ಅದರ ಗ್ರಂಥಕರ್ತನನ್ನು ಪ್ರತ್ಯಕ್ಷವಾಗಿ ಗುರುತಿಸುವುದಿಲ್ಲ. ಪ್ರಸಂಗಿ 1:1 ರಲ್ಲಿ ಕ್ಹೊಹೆಲೆಥ್ ಎಂಬ ಹೀಬ್ರೂ ಪದದಿಂದ ಗ್ರಂಥಕರ್ತನು ತನ್ನನ್ನು ತಾನು ಗುರುತಿಸಿಕೊಂಡಿದ್ದಾನೆ, ಆ ಪದವನ್ನು “ಪ್ರಸಂಗಿ” ಎಂದು ಅನುವಾದಿಸಲಾಗಿದೆ. ದಾವೀದನ ಮಗನೂ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಆಳುವ ಅರಸನೂ, ನನಗಿಂತ ಮೊದಲು ಯೆರೂಸಲೇಮನ್ನು ಆಳಿದವರೆಲ್ಲರಿಗಿಂತಲೂ ಹೆಚ್ಚು ಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸಿಕೊಂಡವನು, ಅನೇಕಾನೇಕ ಜ್ಞಾನೋಕ್ತಿಗಳನ್ನು ಧ್ಯಾನಿಸಿ, ಪರೀಕ್ಷಿಸಿ ಕ್ರಮಪಡಿಸಿದನು ಎಂದು ತನ್ನನ್ನು ತಾನು ಕರೆದುಕೊಳ್ಳುತ್ತಾನೆ (ಪ್ರಸಂಗಿ 1:1,16; 12:9). ದಾವೀದನ ಏಕೈಕ ಮಗನಾಗಿದ್ದ ಸೊಲೊಮೋನನು ಆ ಪಟ್ಟಣದಿಂದ ಎಲ್ಲಾ ಇಸ್ರಾಯೇಲ್ಯರನ್ನು ಆಳುವುದಕ್ಕಾಗಿ ದಾವೀದನ ನಂತರ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಸಿಂಹಾಸನವನ್ನೇರಿದ್ದನು (1:12). ಸೊಲೊಮೋನನ್ನೇ ಈ ಪುಸ್ತಕವನ್ನು ಬರೆದಿದ್ದಾನೆಂದು ಸೂಚಿಸುವ ಕೆಲವೇ ಕೆಲವು ವಚನಗಳಿವೆ. ಸೊಲೊಮೋನನ ಮರಣದ ನಂತರ, ಬಹುಶಃ ನೂರಾರು ವರ್ಷಗಳ ನಂತರ ಈ ಪುಸ್ತಕವನ್ನು ವಿಭಿನ್ನ ವ್ಯಕ್ತಿಯು ಬರೆದಿರಬಹುದು ಎಂದು ಸೂಚಿಸುವಂಥ ಕೆಲವು ಸುಳಿವುಗಳು ಸನ್ನಿವೇಶದಲ್ಲಿವೆ.</para>
  <para style="is">ಬರೆದ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳ</para>
  <para style="ip">ಸರಿಸುಮಾರು ಕ್ರಿ.ಪೂ. 940-931 ರ ನಡುವಿನ ಕಾಲದಲ್ಲಿ ಬರೆದಿರಬಹುದು.</para>
  <para style="ip">ಬಹುಶಃ ಪ್ರಸಂಗಿಯ ಪುಸ್ತಕವು ಸೊಲೊಮೋನನ ಆಳ್ವಿಕೆಯ ಅಂತ್ಯಕಾಲದಲ್ಲಿ ಬರೆಯಲ್ಪಟ್ಟಿರಬಹುದು, ಇದು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಬರೆಯಲ್ಪಟ್ಟಿದೆ ಎಂದು ತೋರುತ್ತದೆ.</para>
  <para style="is">ಸ್ವೀಕೃತದಾರರು</para>
  <para style="ip">ಪ್ರಸಂಗಿಯ ಪುಸ್ತಕವು ಪ್ರಾಚೀನ ಇಸ್ರಾಯೇಲ್ಯರಿಗಾಗಿ ಮತ್ತು ನಂತರದ ಎಲ್ಲಾ ಸತ್ಯವೇದದ ಓದುಗರಿಗಾಗಿ ಬರೆಯಲಾಯಿತ್ತು.</para>
  <para style="is">ಉದ್ದೇಶ</para>
  <para style="ip">ಈ ಪುಸ್ತಕವು ನಮಗೆ ಕಠಿಣ ಎಚ್ಚರಿಕೆಯಾಗಿ ನಿಲ್ಲುತ್ತದೆ. ಗೊತ್ತುಗುರಿಯಿಲ್ಲದೆ ಮತ್ತು ದೇವರ ಭಯವಿಲ್ಲದೆ ಜೀವಿಸುವ ಜೀವನವು ನಿರರ್ಥಕವಾದುದು, ಮತ್ತು ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟಿದ ಹಾಗೆ ವ್ಯರ್ಥವಾದುದು ಆಗಿದೆ. ನಾವು ಸುಖಸಂತೋಷ, ಸಂಪತ್ತು, ಸೃಜನಶೀಲ ಚಟುವಟಿಕೆ, ಜ್ಞಾನ ಅಥವಾ ಸರಳವಾದ ಆನಂದವನ್ನು ಹಿಂದಟ್ಟಿದರೂ, ನಾವು ಜೀವನದ ಅಂತ್ಯಕ್ಕೆ ಬರುತ್ತೇವೆ ಮತ್ತು ನಮ್ಮ ಜೀವನವನ್ನು ವ್ಯರ್ಥವಾಗಿ ಜೀವಿಸಿದ್ದೇವು ಎಂದು ಕಂಡುಕೊಳ್ಳುತ್ತೇವೆ. ದೇವರ ಮೇಲೆ ಕೇಂದ್ರೀಕೃತವಾಗಿರುವ ಜೀವನದ ಮೂಲಕ ಮಾತ್ರವೇ ಜೀವನಕ್ಕೆ ಅರ್ಥ ಬರುತ್ತದೆ.</para>
  <para style="is">ಮುಖ್ಯಾಂಶ</para>
  <para style="ip">ದೇವರಿಗೆ ಬೇರೆಯಾದ ಸಕಲವು ವ್ಯರ್ಥ</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">1. ಪೀಠಿಕೆ — 1:1-11</para>
  <para style="io1">2. ಜೀವನದ ವಿವಿಧ ಅಂಶಗಳ ವ್ಯರ್ಥತೆ — 1:12-5:7</para>
  <para style="io1">3. ದೇವರ ಭಯ — 5:8-12:8</para>
  <para style="io1">4. ಅಂತಿಮ ಸಮಾಪ್ತಿ — 12:9-14</para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s">ಎಲ್ಲವೂ ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1"/>ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಅರಸನಾಗಿದ್ದ ದಾವೀದನ ಮಗನಾದ ಪ್ರಸಂಗಿಯ ಮಾತುಗಳು. <verse eid="ECC 1:1"/><verse number="2" style="v" sid="ECC 1:2"/>ಪ್ರಸಂಗಿಯು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ.</para>
  <para style="q1" vid="ECC 1:2">“ವ್ಯರ್ಥವೇ ವ್ಯರ್ಥ,</para>
  <para style="q2" vid="ECC 1:2">ವ್ಯರ್ಥವೇ ವ್ಯರ್ಥ,</para>
  <para style="q1" vid="ECC 1:2">ಸಮಸ್ತವೂ ವ್ಯರ್ಥ.<verse eid="ECC 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3"/>ಈ ಲೋಕದಲ್ಲಿ<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">ಈ ಲೋಕದಲ್ಲಿ </char><char style="ft" closed="false">ಅಥವಾ ಸೂರ್ಯನ ಕೆಳಗೆ.</char></note> ಮನುಷ್ಯನು ಪಡುವ ಎಲ್ಲಾ ಪ್ರಯಾಸದಿಂದ ಅವನಿಗೆ ಲಾಭವೇನು?<verse eid="ECC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4"/>ಒಂದು ಸಂತತಿಯು ಹೋಗುವುದು,</para>
  <para style="q2" vid="ECC 1:4">ಇನ್ನೊಂದು ಸಂತತಿಯು ಬರುವುದು,</para>
  <para style="q1" vid="ECC 1:4">ಆದರೆ ಭೂಮಿಯು ಶಾಶ್ವತವಾಗಿ ನಿಲ್ಲುವುದು.<verse eid="ECC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5"/>ಸೂರ್ಯನು ಉದಯಿಸುತ್ತಾನೆ.</para>
  <para style="q2" vid="ECC 1:5">ಸೂರ್ಯನು ಮುಳುಗುತ್ತಾನೆ.</para>
  <para style="q1" vid="ECC 1:5">ತಾನು ಉದಯಿಸುವ ಸ್ಥಾನಕ್ಕೆ ಅವಸರವಾಗಿ ಹಿಂತಿರುಗಿ ಹೋಗುತ್ತಾನೆ.<verse eid="ECC 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6"/>ಗಾಳಿಯು ದಕ್ಷಿಣದ ಕಡೆಗೆ ಬೀಸುತ್ತದೆ.</para>
  <para style="q2" vid="ECC 1:6">ಉತ್ತರದ ಕಡೆಗೆ ತಿರುಗುವುದು.</para>
  <para style="q1" vid="ECC 1:6">ಅದು ಸುತ್ತುತ್ತಾ ಸುತ್ತುತ್ತಾ ಹೋಗಿ,</para>
  <para style="q2" vid="ECC 1:6">ಗಾಳಿ ಸುತ್ತಳತೆಯ ಪ್ರಕಾರ ಹಿಂದಿರುಗುತ್ತವೆ.<verse eid="ECC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7"/>ನದಿಗಳೆಲ್ಲಾ ಸಮುದ್ರಕ್ಕೆ ಹರಿದು ಹೋಗುತ್ತವೆ.</para>
  <para style="q2" vid="ECC 1:7">ಆದರೂ ಸಮುದ್ರವು ತುಂಬುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 1:7">ನದಿಗಳು ಎಲ್ಲಿಂದ ಬಂದಿವೆಯೋ</para>
  <para style="q2" vid="ECC 1:7">ಅದೇ ಸ್ಥಳಕ್ಕೆ ಹಿಂತಿರುಗುತ್ತವೆ.<verse eid="ECC 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8"/>ಎಲ್ಲಾ ಕಾರ್ಯಗಳು ಪ್ರಯಾಸದಿಂದ ತುಂಬಿದೆ.</para>
  <para style="q2" vid="ECC 1:8">ಇದನ್ನು ಮನುಷ್ಯನು ವಿವರಿಸಲಾರನು.</para>
  <para style="q1" vid="ECC 1:8">ನೋಡುವುದರಿಂದ ಕಣ್ಣು ತೃಪ್ತಿಗೊಳ್ಳದು,</para>
  <para style="q2" vid="ECC 1:8">ಕೇಳುವುದರಿಂದ ಕಿವಿಯು ದಣಿಯದು.<verse eid="ECC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9"/>ಇದ್ದದ್ದೇ ಇರುವುದು,</para>
  <para style="q2" vid="ECC 1:9">ನಡೆದದ್ದೇ ನಡೆಯುವುದು.</para>
  <para style="q1" vid="ECC 1:9">ಸೂರ್ಯನ ಕೆಳಗೆ ಹೊಸದಾದದ್ದು ಯಾವುದೂ ಇಲ್ಲ.<verse eid="ECC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10"/>‘ನೋಡು, ಇದು ಹೊಸದು’ ಎಂದು ಯಾವ ವಿಷಯದಲ್ಲಾದರೂ ಹೇಳಬಹುದೋ?</para>
  <para style="q2" vid="ECC 1:10">ನಮಗಿಂತ ಮೊದಲು ಇದ್ದದ್ದು,</para>
  <para style="q1" vid="ECC 1:10">ಪುರಾತನ ಕಾಲದಿಂದ ಇದ್ದದ್ದೇ.<verse eid="ECC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11"/>ಪುರಾತನ ಕಾಲದಲ್ಲಿ ನಡೆದ ಸಂಗತಿಗಳ ಜ್ಞಾಪಕವು ಈಗಿನ ಜನರಿಗೆ ಇಲ್ಲ.</para>
  <para style="q2" vid="ECC 1:11">ಮುಂದಿನ ಕಾಲದಲ್ಲಿ ನಡೆಯುವ ಸಂಗತಿಗಳ ಜ್ಞಾಪಕವು ಮುಂದಿನ ಕಾಲದ ಜನರಿಗೆ ಇರುವುದಿಲ್ಲ.”<verse eid="ECC 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12"/>ಪ್ರಸಂಗಿಯಾದ ನಾನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಇಸ್ರಾಯೇಲರಿಗೆ ಅರಸನಾಗಿದ್ದೆನು. <verse eid="ECC 1:12"/><verse number="13" style="v" sid="ECC 1:13"/>ಆಕಾಶದ ಕೆಳಗಡೆ ನಡೆಯುವ ಎಲ್ಲಾ ಕೆಲಸಗಳನ್ನು ಜ್ಞಾನದಿಂದ ವಿಚಾರಿಸಿ ವಿಮರ್ಶಿಸುವುದಕ್ಕೆ ನನ್ನ ಮನಸ್ಸನ್ನು ಇಟ್ಟೆನು. ದೇವರು ಮನುಷ್ಯರ ಮೇಲೆ ನೇಮಿಸಿರುವ ಕೆಲಸವೆಲ್ಲಾ ಬಹು ಪ್ರಯಾಸವೇ. <verse eid="ECC 1:13"/><verse number="14" style="v" sid="ECC 1:14"/>ಲೋಕದಲ್ಲಿ ನಡೆಯುವ ಎಲ್ಲಾ ಕೆಲಸಗಳನ್ನು ನೋಡಿದ್ದೇನೆ. ಆಹಾ, ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟುವ<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟುವ </char><char style="ft" closed="false">ಅಥವಾ ಗಾಳಿಯನ್ನು ತಿನ್ನುವ ಹಾಗೆ.</char></note> ಹಾಗೆ ಸಮಸ್ತವೂ ವ್ಯರ್ಥ.<verse eid="ECC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15"/>ವಕ್ರವಾದದ್ದನ್ನು ಸರಿಮಾಡುವುದಕ್ಕೆ ಆಗುವುದಿಲ್ಲ!</para>
  <para style="q2" vid="ECC 1:15">ಇಲ್ಲದ್ದನ್ನು ಲೆಕ್ಕಿಸುವುದಕ್ಕೆ ಅಸಾಧ್ಯ!<verse eid="ECC 1:15"/></para>
  <para style="s">ಜ್ಞಾನಿಯ ಅನಿಸಿಕೆ</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>ನಾನು ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ ಯೋಚಿಸುತ್ತಾ, “ನೋಡು, ನನಗಿಂತ ಮೊದಲು ಯೆರೂಸಲೇಮನ್ನು ಆಳಿದವರೆಲ್ಲರಿಗಿಂತಲೂ ಹೆಚ್ಚು ಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸಿಕೊಂಡಿದ್ದೇನೆ. ನನ್ನ ಹೃದಯವು ಜ್ಞಾನವನ್ನೂ, ತಿಳಿವಳಿಕೆಯನ್ನೂ ವಿಶೇಷವಾಗಿ ಹೊಂದಿದೆ” ಎಂದುಕೊಂಡೆನು. <verse eid="ECC 1:16"/><verse number="17" style="v" sid="ECC 1:17"/>ಆಗ ಜ್ಞಾನವನ್ನೂ, ಹುಚ್ಚುತನವನ್ನೂ, ಬುದ್ಧಿಹೀನತೆಯನ್ನೂ ಗ್ರಹಿಸಲು ನಾನು ಮನಸ್ಸಿಟ್ಟೆನು. ಇದು ಸಹ ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟುವ ಹಾಗೆ ಎಂದು ನಾನು ಅರಿತುಕೊಂಡೆನು. <verse eid="ECC 1:17"/><verse number="18" style="v" sid="ECC 1:18"/>ಏಕೆಂದರೆ ಬಹಳ ಜ್ಞಾನವಿದ್ದಲ್ಲಿ ಬಹಳ ಸಂಕಟ. ಹೆಚ್ಚು ತಿಳಿವಳಿಕೆಯನ್ನು ಪಡೆದವನಿಗೆ ಹೆಚ್ಚು ವ್ಯಥೆ ಇದೆ.<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s">ಲೋಕದ ಸುಖಸಂತೋಷ ವ್ಯರ್ಥವೇ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>ನಾನು ಮನಸ್ಸಿನಲ್ಲಿ, “ಈಗ ಬಾ, ನಾನು ನಿನ್ನನ್ನು ಸಂತೋಷದ ಮೂಲಕ ಪರೀಕ್ಷಿಸುವೆನು. ಸುಖವನ್ನು ಅನುಭವಿಸು” ಅಂದುಕೊಂಡೆನು. ಆಹಾ! ಇದು ವ್ಯರ್ಥವೇ. <verse eid="ECC 2:1"/><verse number="2" style="v" sid="ECC 2:2"/>“ನಗುವುದು ಹುಚ್ಚುತನ, ಸಂತೋಷದಿಂದ ಏನನ್ನು ಸಾಧಿಸುವೆನು?” ಅಂದುಕೊಂಡೆನು.<verse eid="ECC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 2:3"/>ಆಕಾಶದ ಕೆಳಗೆ ಮನುಷ್ಯರ ಅಲ್ಪಾಯುಷ್ಯದಲ್ಲಿ ಏನು ಮಾಡುವುದು ಒಳ್ಳೆಯದೆಂದು ನಾನು ತಿಳಿದುಕೊಳ್ಳುವುದಕ್ಕಾಗಿ, ನನ್ನ ಮನಸ್ಸು ಜ್ಞಾನದಿಂದಿರುವಾಗಲೇ ದೇಹವನ್ನು ದ್ರಾಕ್ಷಾರಸದಿಂದ ಸಂತೋಷದಲ್ಲಿ ಇಡುವುದಕ್ಕೂ, ಬುದ್ಧಿಹೀನತೆಯನ್ನು ಅವಲಂಬಿಸುವುದಕ್ಕೂ ಮನಸ್ಸಿನಲ್ಲಿ ವಿಚಾರಮಾಡಿಕೊಂಡೆನು.<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>ನಾನು ಮಹತ್ಕಾರ್ಯಗಳನ್ನು ನಡೆಸಿದೆನು. ಮನೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡೆನು ಮತ್ತು ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟನು. <verse eid="ECC 2:4"/><verse number="5" style="v" sid="ECC 2:5"/>ತೋಟಗಳನ್ನೂ ಮತ್ತು ಉದ್ಯಾನವನಗಳನ್ನೂ ಮಾಡಿಸಿ; ಅವುಗಳಲ್ಲಿ ಸಕಲ ವಿಧವಾದ ಫಲವೃಕ್ಷಗಳನ್ನು ನೆಟ್ಟೆನು. <verse eid="ECC 2:5"/><verse number="6" style="v" sid="ECC 2:6"/>ಬೆಳೆಯುವ ಗಿಡಗಳ ತೋಪುಗಳಿಗೆ ನೀರು ಹಾಯಿಸುವುದಕ್ಕಾಗಿ ಕುಂಟೆಗಳನ್ನು ತೋಡಿಸಿದೆನು.<verse eid="ECC 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 2:7"/>ಗಂಡು ಮತ್ತು ಹೆಣ್ಣಾಳುಗಳನ್ನು ಕೊಂಡುಕೊಂಡೆನು; ನನ್ನ ಅರಮನೆಯಲ್ಲಿ ಇವರಿಂದ ಗುಲಾಮರು ಹುಟ್ಟಿದರು. ಇದಲ್ಲದೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹಿಂದೆ ಇದ್ದವರೆಲ್ಲರಿಗಿಂತಲೂ ನಾನು ಬಹಳ ಸಂಪತ್ತುವುಳ್ಳವನಾಗಿ ದನಕುರಿಗಳ ಮಂದೆಯನ್ನು ಹೊಂದಿದೆನು. <verse eid="ECC 2:7"/><verse number="8" style="v" sid="ECC 2:8"/>ನಾನು ಬೆಳ್ಳಿಬಂಗಾರಗಳನ್ನೂ ಅರಸರ ಮತ್ತು ಪ್ರಾಂತ್ಯಗಳ ಕಪ್ಪವನ್ನೂ ಸಂಗ್ರಹಿಸಿಕೊಂಡೆನು. ಗಾಯಕ, ಗಾಯಕಿಯರನ್ನು ಮತ್ತು ಮನುಷ್ಯರಿಗೆ ಭೋಗ್ಯರಾದ ಅನೇಕ ಸ್ತ್ರೀಯರನ್ನು<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fq" closed="false">ಸ್ತ್ರೀಯರನ್ನು </char><char style="ft" closed="false">ಅಥವಾ ಅನೇಕ ಸಂಗೀತ ಉಪಕರಣಗಳು ಅಥವಾ ಉಪಪತ್ನಿಯರನ್ನು. </char></note> ಸಂಪಾದಿಸಿಕೊಂಡೆನು.<verse eid="ECC 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9"/>ಹೀಗೆ ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಹಿಂದೆ ಇದ್ದವರೆಲ್ಲರಿಗಿಂತಲೂ ಹೆಚ್ಚು ಅಭಿವೃದ್ಧಿಹೊಂದಿ ದೊಡ್ಡವನಾದೆನು. ಇದಲ್ಲದೆ ನನ್ನ ಜ್ಞಾನವು ನನ್ನಲ್ಲಿ ನೆಲೆಯಾಗಿತ್ತು.<verse eid="ECC 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 2:10"/>ನನ್ನ ಕಣ್ಣು ಬಯಸಿದ್ದೆಲ್ಲವನ್ನು,</para>
  <para style="q2" vid="ECC 2:10">ಅದಕ್ಕೆ ನಾನು ಒಪ್ಪಿಸದೆ ಬಿಡಲಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 2:10">ಯಾವ ಸಂತೋಷವನ್ನು ಅನುಭವಿಸುವುದಕ್ಕೂ ನನ್ನ ಹೃದಯವನ್ನು ತಡೆಯಲಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 2:10">ಏಕೆಂದರೆ ನನ್ನ ಹೃದಯವು ನಾನು ನಡಿಸುವ ಕಾರ್ಯಗಳಲ್ಲಿ ಹರ್ಷಿಸುತ್ತಿತ್ತು.</para>
  <para style="q2" vid="ECC 2:10">ನನ್ನ ಪ್ರಯಾಸದಿಂದ ನನಗೆ ದೊರೆತ ಫಲವು ಇದೆ.<verse eid="ECC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11"/>ಆಗ ನನ್ನ ಕೈಯಿಂದ ನಡೆಸಿದ ಎಲ್ಲಾ ಕೆಲಸಗಳನ್ನೂ,</para>
  <para style="q2" vid="ECC 2:11">ನಾನು ಪಟ್ಟ ಪ್ರಯಾಸಗಳನ್ನೂ ಗಮನವಿಟ್ಟು ಪರಿಶೀಲಿಸಿದೆ,</para>
  <para style="q1" vid="ECC 2:11">ಆಹಾ ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟಿದ ಹಾಗೆ ಸಮಸ್ತವೂ ವ್ಯರ್ಥವಾಯಿತು.</para>
  <para style="q2" vid="ECC 2:11">ಸೂರ್ಯನ ಕೆಳಗೆ ಯಾವ ಲಾಭವೂ ಕಾಣಲಿಲ್ಲ.<verse eid="ECC 2:11"/></para>
  <para style="s">ಬುದ್ಧಿಹೀನತೆಗಿಂತ ಜ್ಞಾನವು ಉತ್ತಮ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12"/>ಜ್ಞಾನವನ್ನೂ ನೋಡುವುದಕ್ಕೆ ತಿರುಗಿಕೊಂಡೆನು,</para>
  <para style="q2" vid="ECC 2:12">ಮರುಳುತನವನ್ನೂ ಬುದ್ಧಿಹೀನತೆಯನ್ನೂ ನೋಡುವುದಕ್ಕೆ ತಿರುಗಿಕೊಂಡೆನು.</para>
  <para style="q1" vid="ECC 2:12">ರಾಜನ ಪ್ರಯತ್ನವೇ ಹೀಗಾದ ಮೇಲೆ ಮತ್ತೊಬ್ಬನಿಂದ ಏನಾದೀತು?</para>
  <para style="q2" vid="ECC 2:12">ಆದದ್ದೇ ಆಗುತ್ತದೆ ಎಂದುಕೊಂಡೆ.<verse eid="ECC 2:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="ECC 2:13"/>ಜ್ಞಾನವು ಮೂಢತ್ವಕ್ಕಿಂತ ಶ್ರೇಷ್ಠವೆಂದು</para>
  <para style="q2" vid="ECC 2:13">ಬೆಳಕು ಕತ್ತಲಿಗಿಂತ ಶ್ರೇಷ್ಠವಾಗಿರುವುದೆಂದು ಗೋಚರವಾಯಿತು.<verse eid="ECC 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14"/>ಜ್ಞಾನಿಯ ಕಣ್ಣು ಅವನ ತಲೆಯಲ್ಲಿರುವುದು</para>
  <para style="q2" vid="ECC 2:14">ಮೂಢನು ಕತ್ತಲಲ್ಲಿ ನಡೆಯುವನು.</para>
  <para style="q1" vid="ECC 2:14">ಇವರಿಬ್ಬರಿಗೂ ಒಂದೇ ಗತಿಯೆಂದು ನನಗೆ ಕಂಡು ಬಂದಿತು.<verse eid="ECC 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 2:15"/>ಆಗ ನಾನು ನನ್ನ ಹೃದಯದಲ್ಲಿ,</para>
  <para style="q2" vid="ECC 2:15">“ಮೂಢನಿಗೆ ಸಂಭವಿಸುವ ಗತಿಯು,</para>
  <para style="q2" vid="ECC 2:15">ನನಗೂ ಸಂಭವಿಸುವುದು.</para>
  <para style="q1" vid="ECC 2:15">ನನ್ನ ಹೆಚ್ಚು ಜ್ಞಾನದಿಂದ ಲಾಭವೇನು?”</para>
  <para style="q2" vid="ECC 2:15">ಇದೂ ವ್ಯರ್ಥವೆಂದು</para>
  <para style="q2" vid="ECC 2:15">ನನ್ನ ಹೃದಯದಲ್ಲಿ ಅಂದುಕೊಂಡೆನು.<verse eid="ECC 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16"/>ಏಕೆಂದರೆ ಮೂಢನು ಹೇಗೋ ಹಾಗೆಯೇ ಜ್ಞಾನಿಯೂ ಬಹಳ ದಿನಗಳವರೆಗೆ ಮರೆತುಹೋಗುವನು.</para>
  <para style="q2" vid="ECC 2:16">ಈಗಿನ ಜನರು ಮುಂದಿನ ಕಾಲದೊಳಗಾಗಿಯೇ ಮರೆತುಹೋಗುವರು.</para>
  <para style="q1" vid="ECC 2:16">ಆಹಾ! ಮೂಢನಂತೆ ಜ್ಞಾನಿಯೂ ಸಾಯುವನು.<verse eid="ECC 2:16"/></para>
  <para style="s">ಕಠಿಣ ಶ್ರಮವು ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>ಲೋಕ ವ್ಯವಹಾರವು ಕೆಟ್ಟದ್ದೆಂದು ನನಗೆ ಕಂಡುಬಂದದ್ದರಿಂದ ಜೀವವೇ ಅಸಹ್ಯವಾಗಿ ತೋರಿತು. ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟಿದ ಹಾಗೆ ಸಮಸ್ತವೂ ವ್ಯರ್ಥ. <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>ನನ್ನ ಪ್ರಯಾಸದ ಫಲವನ್ನು ಮುಂದಿನವನಿಗೆ ಬಿಟ್ಟುಬಿಡಬೇಕೆಂದು ನಾನು ಲೋಕದಲ್ಲಿ ಪಟ್ಟ ಪ್ರಯಾಸಕ್ಕೆ ಬೇಸರಗೊಂಡೆನು. <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>ಅವನು ಜ್ಞಾನಿಯೋ ಅಥವಾ ಮೂಢನೋ ಯಾರಿಗೆ ಗೊತ್ತು? ಎಂಥವನಾದರೂ ನಾನು ಲೋಕದೊಳಗೆ ಯಾವುದರಲ್ಲಿ ಜ್ಞಾನವನ್ನೂ, ಪ್ರಯಾಸವನ್ನೂ ವೆಚ್ಚಮಾಡಿದ್ದೇನೋ ಅದರ ಮೇಲೆ ದೊರೆತನಮಾಡುವೆನು. ಇದೂ ವ್ಯರ್ಥವೇ. <verse eid="ECC 2:19"/><verse number="20" style="v" sid="ECC 2:20"/>ಹೀಗಿರಲು ನಾನು ಲೋಕದಲ್ಲಿ ಪ್ರಯಾಸಪಟ್ಟ ಕೆಲಸದ ವಿಷಯವಾಗಿ ನಿರಾಶೆಗೊಳಗಾದೆನು. <verse eid="ECC 2:20"/><verse number="21" style="v" sid="ECC 2:21"/>ಒಬ್ಬನು ಜ್ಞಾನದಿಂದಲೂ, ತಿಳಿವಳಿಕೆಯಿಂದಲೂ ತನ್ನ ಕೆಲಸವನ್ನು ನಡೆಸಿ ಸಿದ್ಧಿಗೆ ತಂದ ಮೇಲೆ ಆ ಕೆಲಸದಲ್ಲಿ ಪ್ರಯಾಸಪಡದವನಿಗೆ ಅದರ ಫಲವನ್ನು ಭಾಧ್ಯತೆಯಾಗಿ ಬಿಡಬೇಕಾಯಿತು. ಇದು ಸಹ ವ್ಯರ್ಥವೂ, ಕೇವಲ ಅನ್ಯಾಯವೂ ಆಗಿದೆ.<verse eid="ECC 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 2:22"/>ಲೋಕದಲ್ಲಿ ಮನುಷ್ಯನು ಹೃದಯಪೂರ್ವಕವಾಗಿ ಪಡುವ ಪ್ರಯಾಸದಿಂದ ಅವನಿಗೆ ಸಿಗುವ ಲಾಭವಾದರೂ ಏನು? <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>ಅವನ ದಿನಗಳೆಲ್ಲಾ ವ್ಯಸನವೇ. ಅವನ ಕೆಲಸವು ತೊಂದರೆಯೇ. ರಾತ್ರಿಯಲ್ಲಿಯೂ ಅವನ ಮನಸ್ಸಿಗೆ ವಿಶ್ರಾಂತಿಯಿಲ್ಲ. ಇದೂ ಸಹ ವ್ಯರ್ಥವೇ.<verse eid="ECC 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>ಅನ್ನ ಪಾನಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ತನ್ನ ಪ್ರಯಾಸದಲ್ಲಿಯೂ ಸುಖವನ್ನು ಅನುಭವಿಸುವುದಕ್ಕಿಂತ ಇನ್ನೇನೂ ಮನುಷ್ಯನಿಗೆ ಮೇಲಿಲ್ಲ. ಇದು ದೇವರಿಂದಾಯಿತೆಂಬುದನ್ನು ಕಂಡುಕೊಂಡೆನು. <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>ಆತನಿಲ್ಲದೆ<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">ಆತನಿಲ್ಲದೆ </char><char style="ft" closed="false">ಅಥವಾ ನಾನಿಲ್ಲದೆ.</char></note> ಯಾರು ಭೋಜನ ಮಾಡಿ ಸುಖವನ್ನು ಅನುಭವಿಸುವರು? <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>ದೇವರು ತಾನು ಮೆಚ್ಚಿದವನಿಗೆ ಜ್ಞಾನವನ್ನೂ, ತಿಳಿವಳಿಕೆಯನ್ನೂ, ಸಂತೋಷವನ್ನೂ ದಯಪಾಲಿಸುತ್ತಾನೆ. ಆದರೆ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಒಳ್ಳೆಯವನಿಗೆ ಕೊಡುವುದಕ್ಕಾಗಿ ಕೂಡಿಸಿ ಒದಗಿಸುವಂತೆ ಪಾಪಿಗಾದರೋ ಪ್ರಯಾಸವನ್ನೇ ಕೊಡುತ್ತಾನೆ. ಇದು ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟಿದ ಹಾಗೆ ವ್ಯರ್ಥವೇ.<verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s">ಪ್ರತಿಯೊಂದು ಕಾರ್ಯಕ್ಕೂ ಸೂಕ್ತ ಸಮಯವುಂಟು</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1"/>ಪ್ರತಿಯೊಂದು ಕಾರ್ಯಕ್ಕೂ ನಿಗದಿಯಾದ ಸಮಯವಿದೆ, ಆಕಾಶದ ಕೆಳಗೆ ನಡೆಯುವ ಒಂದೊಂದು ಕೆಲಸಕ್ಕೂ ತಕ್ಕ ಸಮಯವುಂಟು.<verse eid="ECC 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2"/>ಹುಟ್ಟುವ ಸಮಯ, ಸಾಯುವ ಸಮಯ,</para>
  <para style="q1" vid="ECC 3:2">ನೆಡುವ ಸಮಯ, ನೆಟ್ಟದ್ದನ್ನು ಕಿತ್ತುಹಾಕುವ ಸಮಯ,<verse eid="ECC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3"/>ಕೊಲ್ಲುವ ಸಮಯ, ಸ್ವಸ್ಥಮಾಡುವ ಸಮಯ</para>
  <para style="q1" vid="ECC 3:3">ಕೆಡುವಿಬಿಡುವ ಸಮಯ, ಕಟ್ಟುವ ಸಮಯ,<verse eid="ECC 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4"/>ಅಳುವ ಸಮಯ, ನಗುವ ಸಮಯ,</para>
  <para style="q1" vid="ECC 3:4">ಗೋಳಾಡುವ ಸಮಯ, ಕುಣಿದಾಡುವ ಸಮಯ,<verse eid="ECC 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5"/>ಕಲ್ಲುಗಳನ್ನು ಚೆಲ್ಲುವ ಸಮಯ, ಕಲ್ಲುಗಳನ್ನು ಕೂಡಿಸುವ ಸಮಯ,</para>
  <para style="q1" vid="ECC 3:5">ಅಪ್ಪಿಕೊಳ್ಳುವ ಸಮಯ ಅಪ್ಪಿಕೊಳ್ಳದಿರುವ ಸಮಯ,<verse eid="ECC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6"/>ಸಂಪಾದಿಸುವ ಸಮಯ, ಕಳೆದುಕೊಳ್ಳುವ ಸಮಯ,</para>
  <para style="q1" vid="ECC 3:6">ಕಾಪಾಡುವ ಸಮಯ, ಬಿಸಾಡುವ ಸಮಯ,<verse eid="ECC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7"/>ಹರಿಯುವ ಸಮಯ, ಹೊಲಿಯುವ ಸಮಯ,</para>
  <para style="q1" vid="ECC 3:7">ಸುಮ್ಮನಿರುವ ಸಮಯ, ಮಾತನಾಡುವ ಸಮಯ,<verse eid="ECC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8"/>ಪ್ರೀತಿಸುವ ಸಮಯ, ದ್ವೇಷಿಸುವ ಸಮಯ,</para>
  <para style="q1" vid="ECC 3:8">ಯುದ್ಧದ ಸಮಯ, ಸಮಾಧಾನದ ಸಮಯ.<verse eid="ECC 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>ದುಡಿಯುವವನಿಗೆ ಅವನ ಪ್ರಯಾಸದಿಂದ ಲಾಭವೇನು? <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>ಮನುಷ್ಯನಿಗೆ ಕರ್ತವ್ಯವೆಂದು ದೇವರು ನೇಮಿಸಿರುವ ಪ್ರಯಾಸವನ್ನು ನೋಡಿದ್ದೇನೆ.<verse eid="ECC 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 3:11"/>ಒಂದೊಂದು ವಸ್ತುವನ್ನು ಸಮಯಕ್ಕೆ ತಕ್ಕ ಹಾಗೆ ಅಂದವಾಗಿ ನಿರ್ಮಿಸಿದ್ದಾನೆ. ಇದಲ್ಲದೆ ಮನುಷ್ಯರ ಹೃದಯದಲ್ಲಿ ಅನಂತಕಾಲದ ಯೋಚನೆಯನ್ನು ಇಟ್ಟಿದ್ದಾನೆ. ಆದರೂ ದೇವರು ನಡೆಸುತ್ತಿರುವ ಕೆಲಸವನ್ನು ಅವರು ಗ್ರಹಿಸಲಾರದಂತೆ ಮಾಡಿದ್ದಾನೆ.<verse eid="ECC 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 3:12"/>ಮನುಷ್ಯರು ತಮ್ಮ ಜೀವಮಾನದಲ್ಲೆಲ್ಲಾ ಉಲ್ಲಾಸವಾಗಿ ಸುಖವನ್ನು ಅನುಭವಿಸುವುದಕ್ಕಿಂತ ಇನ್ನೇನೂ ಅವರಿಗೆ ಮೇಲಿಲ್ಲವೆಂದು ನಾನು ಗ್ರಹಿಸಿದ್ದೇನೆ. <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>ಇದಲ್ಲದೆ ಪ್ರತಿಯೊಬ್ಬನೂ ಅನ್ನಪಾನಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ತನ್ನ ನಾನಾ ಪ್ರಯಾಸಗಳಲ್ಲಿಯೂ ಸುಖವನ್ನನುಭವಿಸುವುದು ದೇವರ ಅನುಗ್ರಹವೇ ಎಂದು ನನಗೆ ಗೊತ್ತಿದೆ.<verse eid="ECC 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14"/>ದೇವರ ಕಾರ್ಯವೆಲ್ಲವು ನಿತ್ಯವೆಂದು ಬಲ್ಲೆನು. ಅದಕ್ಕೆ ಯಾವುದನ್ನೂ ಸೇರಿಸಲಾರೆವು. ಅದರಿಂದ ಯಾವುದನ್ನೂ ತೆಗೆಯಲಾರೆವು. ದೇವರ ಈ ನಿಯಮಕ್ಕೆ ಮನುಷ್ಯರು ತನ್ನ ಎದುರಿನಲ್ಲಿ ಭಯಭಕ್ತಿ ಉಳ್ಳವರಾಗಿರಬೇಕೆಂಬುದೇ ಕಾರಣ.<verse eid="ECC 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15"/>ಈಗಿನದು ಹಿಂದೆ ಇತ್ತು;</para>
  <para style="q2" vid="ECC 3:15">ಮುಂದಿನದು ಈಗಲೂ ಇದೆ.</para>
  <para style="q1" vid="ECC 3:15">ಗತಿಸಿ ಹೋದದ್ದನ್ನು ದೇವರು ತಿರುಗಿ ಬರಮಾಡುವನು.<verse eid="ECC 3:15"/></para>
  <para style="s">ಲೋಕದಲ್ಲಿ ಅಧರ್ಮ</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16"/>ಇದಲ್ಲದೆ ನಾನು ಲೋಕದಲ್ಲಿ ದೃಷ್ಟಿಸಿ ನ್ಯಾಯಸ್ಥಾನದಲ್ಲಿಯೂ, ಧರ್ಮಸ್ಥಾನದಲ್ಲಿಯೂ ಅಧರ್ಮವಿರುವುದೆಂದು ನೋಡಿದೆನು. <verse eid="ECC 3:16"/><verse number="17" style="v" sid="ECC 3:17"/>ಆಗ ನಾನು ಮನಸ್ಸಿನಲ್ಲಿ, “ದೇವರು ನೀತಿವಂತನಿಗೂ, ಅನೀತಿವಂತನಿಗೂ ನ್ಯಾಯತೀರಿಸುವನು. ಆತನ ನ್ಯಾಯಕ್ರಮಗಳಿಗೂ, ಎಲ್ಲಾ ಕೆಲಸಕಾರ್ಯಗಳಿಗೂ ತಕ್ಕ ಸಮಯ ಉಂಟು” ಎಂದು ಅಂದುಕೊಂಡೆನು.<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>ನಾನು ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ ಹೀಗೆ ಯೋಚಿಸಿದೆನು, “ದೇವರು ಮನುಷ್ಯರನ್ನು ಪರೀಕ್ಷಿಸಿ, ಅವರು ಪಶುಗಳಿಗೆ ಸಮಾನರು ಎಂಬುದನ್ನು ತೋರಿಸುತ್ತಾನೆ.” <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>ಮನುಷ್ಯನ ಗತಿಯೂ ಪಶುವಿನ ಗತಿಯೂ ಒಂದೇ. ಪಶುವಿಗೆ ಸಾವು ಬರುವ ಹಾಗೆ ಮನುಷ್ಯನಿಗೂ ಬರುವುದು. ಎಲ್ಲಕ್ಕೂ ಪ್ರಾಣ ಒಂದೇ. ಮನುಷ್ಯನು ಪಶುವಿಗಿಂತ ಶ್ರೇಷ್ಠನಲ್ಲ. ಎಲ್ಲವು ವ್ಯರ್ಥವೇ. <verse eid="ECC 3:19"/><verse number="20" style="v" sid="ECC 3:20"/>ಎಲ್ಲಾ ಪ್ರಾಣಿಗಳು ಒಂದೇ ಸ್ಥಳಕ್ಕೆ ಹೋಗುವವು. ಎಲ್ಲವು ಮಣ್ಣಿನಿಂದಾದವು. ಎಲ್ಲವೂ ಮಣ್ಣಿಗೆ ಪುನಃ ಸೇರುವವು.<verse eid="ECC 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 3:21"/>ಮನುಷ್ಯನ ಆತ್ಮವು ಮೇಲಕ್ಕೆ ಏರುತ್ತದೋ, ಪಶುವಿನ ಆತ್ಮವು ಕೆಳಕ್ಕೆ ಇಳಿದು ಭೂಮಿಗೆ ಸೇರುತ್ತದೋ ಯಾರಿಗೆ ಗೊತ್ತು? <verse eid="ECC 3:21"/><verse number="22" style="v" sid="ECC 3:22"/>ಈ ಪ್ರಕಾರ ನಾನು ಯೋಚಿಸಿ ಮನುಷ್ಯನು ತನ್ನ ಕಾರ್ಯಗಳಲ್ಲಿ ಉಲ್ಲಾಸಗೊಳ್ಳುವುದಕ್ಕಿಂತ ಅವನಿಗೆ ಯಾವ ಮೇಲೂ ಇಲ್ಲ. ಇದೇ ಅವನ ಪಾಲು ಎಂದು ಗ್ರಹಿಸಿಕೊಂಡೆನು. ಜೀವಮಾನದ ನಂತರ ಸಂಭವಿಸುವವುಗಳನ್ನು ನೋಡುವುದಕ್ಕೆ ಮನುಷ್ಯನನ್ನು ಯಾರು ಪುನಃ ಬರಮಾಡುವರು?<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s">ದಬ್ಬಾಳಿಕೆ, ಶ್ರಮೆ, ವೈರತ್ವ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1"/>ಆ ಮೇಲೆ ಪುನಃ ದೃಷ್ಟಿಸಿ ಸೂರ್ಯನ ಕೆಳಗೆ ನಡೆಯುತ್ತಿರುವ ಹಿಂಸೆಗಳನ್ನೆಲ್ಲಾ ನೋಡಿದೆನು.</para>
  <para style="q1" vid="ECC 4:1">ಆಹಾ! ಹಿಂಸೆಗೊಂಡವರ ಕಣ್ಣೀರನ್ನು ನೋಡು.</para>
  <para style="q2" vid="ECC 4:1">ಅವರನ್ನು ಸಂತೈಸುವವರು ಯಾರೂ ಇಲ್ಲ. ಅವರನ್ನು ಹಿಂಸಿಸುವವರಿಗೆ ಬಹಳ ಬಲ ಇದೆ.</para>
  <para style="q1" vid="ECC 4:1">ಹಿಂಸೆಗೊಂಡವರನ್ನು ಸಂತೈಸುವವರು ಒಬ್ಬರೂ ಇಲ್ಲ.<verse eid="ECC 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2"/>ಇದನ್ನು ನೋಡಿ ಇನ್ನೂ ಜೀವದಿಂದಿದ್ದು ಬದುಕುವವರಿಗಿಂತ ಸತ್ತವರೇ ಮೇಲೆಂದು ಹೊಗಳಿದೆನು.<verse eid="ECC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3"/>ಹೌದು, ಈ ಇಬ್ಬರಿಗಿಂತಲೂ ಇನ್ನೂ ಹುಟ್ಟದೇ,</para>
  <para style="q2" vid="ECC 4:3">ಲೋಕದಲ್ಲಿ ನಡೆಯುತ್ತಿರುವ ಅಧರ್ಮವನ್ನು ನೋಡದೆ ಇರುವುದೇ ಒಳ್ಳೆಯದೆಂದು ತಿಳಿದುಕೊಂಡೆನು.<verse eid="ECC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4"/>ಆಗ ಸಮಸ್ತ ಪ್ರಯಾಸವನ್ನು, ಕೈಗೂಡುವ ಸಕಲ ಕಾರ್ಯವನ್ನು ನೋಡಿ ಇವು ಪರಸ್ಪರ ಮತ್ಸರಕ್ಕೆ ಆಸ್ಪದವೆಂದು ಗ್ರಹಿಸಿಕೊಂಡೆನು. ಇದು ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟಿದ ಹಾಗೆ ವ್ಯರ್ಥವೇ.<verse eid="ECC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5"/>ಮೂಢನು ತನ್ನ ಕೈಗಳನ್ನು ಮುಚ್ಚಿಕೊಂಡು ಯಾವ ಕೆಲಸವನ್ನು ಮಾಡದೆ,</para>
  <para style="q2" vid="ECC 4:5">ತನ್ನನ್ನು ತಾನು ನಾಶಪಡಿಸಿಕೊಳ್ಳುವನು.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="fq" closed="false">ತನ್ನನ್ನು ತಾನು ನಾಶಪಡಿಸಿಕೊಳ್ಳುವನು. </char><char style="ft" closed="false">ಅಥವಾ ತನ್ನ ಮಾಂಸವನ್ನು ತಾನೇ ತಿನ್ನುವನು.</char></note><verse eid="ECC 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6"/>ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟುವ ಹಾಗೆಯೇ ಪ್ರಯಾಸದಿಂದ ತುಂಬಿದ ಎರಡು ಕೈಗಳಿಂದ ಮಾಡಿದ ಕೆಲಸಕ್ಕಿಂತ</para>
  <para style="q2" vid="ECC 4:6">ನೆಮ್ಮದಿಯಾಗಿ ಒಂದು ಕೈಯಿಂದ ಮಾಡಿದ ಕೆಲಸವೇ ಲೇಸು.<verse eid="ECC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7"/>ಆಗ ನಾನು ಲೋಕದಲ್ಲಿ ಮತ್ತೊಂದು ವ್ಯರ್ಥ ವಿಷಯವನ್ನು ಕಂಡೆನು.<verse eid="ECC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8"/>ಒಬ್ಬಂಟಿಗನಾದ ಒಬ್ಬ ಮನುಷ್ಯನಿದ್ದಾನೆ.</para>
  <para style="q2" vid="ECC 4:8">ಅವನಿಗೆ ಅಣ್ಣತಮ್ಮಂದಿರು ಇಲ್ಲ, ಮಕ್ಕಳೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ECC 4:8">ಆದರೂ ಅವನ ಪ್ರಯಾಸಕ್ಕೆ ಅಂತ್ಯವಿಲ್ಲ,</para>
  <para style="q2" vid="ECC 4:8">ಐಶ್ವರ್ಯದಿಂದ ಅವನ ಕಣ್ಣಿಗೆ ತೃಪ್ತಿಯಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 4:8">ಅವನು, “ನಾನು ಸುಖವನ್ನು ತೊರೆದು</para>
  <para style="q2" vid="ECC 4:8">ಯಾರಿಗೋಸ್ಕರ ಪ್ರಯಾಸಪಡುತ್ತಾ ಇದ್ದೇನೆ?” ಅಂದುಕೊಳ್ಳುವನು.</para>
  <para style="q1" vid="ECC 4:8">ಇದೂ ಸಹ ವ್ಯರ್ಥವೇ. ಕೇವಲ ಪ್ರಯಾಸದ ಕೆಲಸವೇ ಸರಿ.<verse eid="ECC 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9"/>ಒಬ್ಬನಿಗಿಂತ ಇಬ್ಬರು ಕೆಲಸ ಮಾಡುವುದು ಒಳ್ಳೆಯದು.</para>
  <para style="q2" vid="ECC 4:9">ಅವರ ಪ್ರಯಾಸಕ್ಕೆ ಒಳ್ಳೆಯ ಲಾಭವನ್ನು ಸಂಪಾದಿಸಬಹುದು.<verse eid="ECC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10"/>ಒಬ್ಬನು ಬಿದ್ದರೆ, ಇನ್ನೊಬ್ಬನು ತನ್ನ ಸ್ನೇಹಿತನನ್ನು ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುವನು.</para>
  <para style="q2" vid="ECC 4:10">ಒಬ್ಬನು ಒಬ್ಬಂಟ್ಟಿಗನಾಗಿ ಬಿದ್ದರೆ, ಅವನನ್ನು ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುವವನು ಯಾರೂ ಇಲ್ಲ,</para>
  <para style="q2" vid="ECC 4:10">ಅವನ ಗತಿ ದುರ್ಗತಿಯೇ.<verse eid="ECC 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11"/>ಮತ್ತು ಇಬ್ಬರು ಜೊತೆಯಲ್ಲಿ ಮಲಗಿಕೊಂಡರೆ ಅವರಿಗೆ ಬೆಚ್ಚಗಾಗುತ್ತದೆ,</para>
  <para style="q2" vid="ECC 4:11">ಆದರೆ ಒಬ್ಬನು ಹೇಗೆ ಬೆಚ್ಚಗಿರುತ್ತಾನೆ?<verse eid="ECC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12"/>ಒಬ್ಬನನ್ನು ಮತ್ತೊಬ್ಬನು ಜಯಿಸಬಹುದು, ಆದರೆ</para>
  <para style="q2" vid="ECC 4:12">ಗೆದ್ದವನನ್ನು ಇಬ್ಬರು ಎದುರಿಸಿ ನಿಲ್ಲಿಸಬಹುದು.</para>
  <para style="q2" vid="ECC 4:12">ಮೂರು ಹುರಿಯ ಹಗ್ಗ ಬೇಗನೆ ಕಿತ್ತುಹೋಗುವುದಿಲ್ಲ.<verse eid="ECC 4:12"/></para>
  <para style="s">ರಾಜಕೀಯ ಶಕ್ತಿಯು ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>ಎಚ್ಚರಿಕೆಯ ಮಾತಿಗೆ ಕಿವಿಗೊಡದ ಮುದಕನೂ, ಮೂಢನೂ ಆದ ಅರಸನಿಗಿಂತ ಜ್ಞಾನಿಯಾದ ಬಡ ಯುವಕನೇ ಮೇಲು. <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>ಇಂಥ ಯುವಕನೊಬ್ಬನು ರಾಜನಾಗಲು ಸೆರೆಮನೆಯಿಂದ ಬಂದಿರಬಹುದು ಅಥವಾ ತನ್ನ ರಾಜ್ಯದಲ್ಲಿ ಬಡ ಪ್ರಜೆಯಾಗಿ ಹುಟ್ಟಿರಬಹುದು.<verse eid="ECC 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 4:15"/>ಸೂರ್ಯನ ಕೆಳಗೆ ಜೀವಿಸಿ ಮತ್ತು ನಡೆದಾಡಿದವರೆಲ್ಲರೂ ಅರಸನ ಉತ್ತರಾಧಿಕಾರಿಯಾದ ಯುವಕನ ಪಕ್ಷವಹಿಸುವುದನ್ನು ನಾನು ನೋಡಿದೆನು. <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>ಇವನ ಅಧಿಪತ್ಯಕ್ಕೆ ಒಳಪಟ್ಟ ಎಲ್ಲಾ ಜನರ ಸಂಖ್ಯೆಯು ಅಪಾರ. ಅವನ ಆಳ್ವಿಕೆಯ ನಂತರ ಇವನಲ್ಲಿ ಆನಂದಿಸುವುದಿಲ್ಲ. ಇದೂ ಸಹ ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟಿದ ಹಾಗೆ ವ್ಯರ್ಥವಾಗಿದೆ.<verse eid="ECC 4:16"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="s">ದೇವರನ್ನು ಗೌರವಿಸಿ ಆತನಿಗೆ ಭಯಪಡು</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1"/>ದೇವಸ್ಥಾನಕ್ಕೆ ಹೋಗುವಾಗ ನಿನ್ನ ಹೆಜ್ಜೆಯನ್ನು ಗಮನಿಸು. ಮೂಢರ ಯಜ್ಞಕ್ಕಿಂತ ಸಾನ್ನಿಧ್ಯಕ್ಕೆ ಬಂದು ಕಿವಿಗೊಡುವುದು ಲೇಸು. ತಾವು ತಪ್ಪು ಮಾಡುತ್ತಿದ್ದೇವೆಂಬುದು ಮೂಢರಿಗೆ ಗೊತ್ತೇ ಇಲ್ಲ.<verse eid="ECC 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2"/>ನಿನ್ನ ಬಾಯಿಂದ ದುಡುಕಬೇಡ</para>
  <para style="q2" vid="ECC 5:2">ಮತ್ತು ದೇವರ ಮುಂದೆ ಮಾತನಾಡಲು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಆತುರಪಡಬೇಡ.</para>
  <para style="q1" vid="ECC 5:2">ದೇವರು ಪರಲೋಕದಲ್ಲಿದ್ದಾನೆ. ನೀನು ಭೂಮಿಯಲ್ಲಿದ್ದಿ,</para>
  <para style="q2" vid="ECC 5:2">ಆದಕಾರಣ ನಿನ್ನ ಮಾತುಗಳು ಕಡಿಮೆಯಾಗಿರಲಿ.<verse eid="ECC 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3"/>ಬಹಳ ಚಿಂತೆಯ ಮೂಲಕ ಕನಸು ಉಂಟಾಗುತ್ತದೆ</para>
  <para style="q2" vid="ECC 5:3">ಮತ್ತು ಮೂಢನ ಧ್ವನಿಯು ಬಹಳ ಮಾತುಗಳಿಂದ ಕೂಡಿದ್ದಾಗಿದೆ.<verse eid="ECC 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4"/>ನೀನು ದೇವರಿಗೆ ಹರಕೆಯನ್ನು ಮಾಡಿದರೆ ಅದನ್ನು ತೀರಿಸಲು ತಡಮಾಡಬೇಡ. ಮೂಢರಲ್ಲಿ ದೇವರಿಗೆ ಸಂತೋಷವಿಲ್ಲ. ನೀನು ಪ್ರಮಾಣಮಾಡಿದ್ದನ್ನು ತೀರಿಸು. <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>ನೀನು ಹರಕೆಮಾಡಿದ್ದನ್ನು ನೆರವೇರಿಸದೆ ಇರುವುದಕ್ಕಿಂತ ಹರಕೆಮಾಡದೆ ಇರುವುದು ಒಳ್ಳೆಯದು.<verse eid="ECC 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 5:6"/>ನಿನ್ನ ಬಾಯಿ ನಿನ್ನನ್ನು ಪಾಪಕ್ಕೆ ಗುರಿಮಾಡದಂತೆ ನೋಡಿಕೋ. “ಇದು ಅಜಾಗ್ರತೆಯಿಂದ ಆಯಿತು” ಎಂದು ದೂತನ ಮುಂದೆ ಹೇಳಬೇಡ. ದೇವರು ನಿನ್ನ ಮಾತಿಗೆ ರೋಷಗೊಂಡು ನಿನ್ನ ಕೈಕೆಲಸವನ್ನು ಏಕೆ ಹಾಳುಮಾಡಬೇಕು? <verse eid="ECC 5:6"/><verse number="7" style="v" sid="ECC 5:7"/>ಬಹಳ ಕನಸುಗಳಿಂದಲೂ, ವ್ಯರ್ಥ ವಿಷಯಗಳಿಂದಲೂ, ಹೆಚ್ಚು ಮಾತುಗಳಿಂದಲೂ ವ್ಯರ್ಥವೇ. ನೀನಂತೂ ದೇವರಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿರು.<verse eid="ECC 5:7"/></para>
  <para style="s">ಐಶ್ವರ್ಯವೂ ವ್ಯರ್ಥ</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8"/>ಸಂಸ್ಥಾನದಲ್ಲಿ ಬಡವರ ಹಿಂಸೆಯನ್ನೂ, ನೀತಿನ್ಯಾಯಗಳ ನಾಶನವನ್ನೂ ನೀನು ನೋಡಿದರೆ ಆಶ್ಚರ್ಯಪಡಬೇಡ. ಏಕೆಂದರೆ ಒಬ್ಬ ಅಧಿಕಾರಿಯ ಮೇಲೆ ಇನ್ನೊಬ್ಬನಿದ್ದಾನೆ. ಅವರಿಬ್ಬರ ಮೇಲೆ ಹೆಚ್ಚಿನ ಅಧಿಕಾರವುಳ್ಳವನಿದ್ದಾನೆ. <verse eid="ECC 5:8"/><verse number="9" style="v" sid="ECC 5:9"/>ಭೂಮಿಯಿಂದ ಎಲ್ಲರಿಗೂ ಲಾಭವಿದೆ ಮತ್ತು ಹೊಲಗದ್ದೆಗಳಿಂದ ರಾಜನಿಗೆ ಲಾಭವಾಗುತ್ತದೆ.<verse eid="ECC 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10"/>ಬೆಳ್ಳಿಯನ್ನು ಆಶಿಸುವವನಿಗೆ ಎಷ್ಟು ಬೆಳ್ಳಿಯಿಂದಲೂ ತೃಪ್ತಿಯಾಗುವುದಿಲ್ಲ</para>
  <para style="q2" vid="ECC 5:10">ಮತ್ತು ಸಮೃದ್ಧಿಯನ್ನು ಬಯಸುವವನಿಗೆ ಆದಾಯವೆಷ್ಟಾದರೂ ಸಾಲುವುದಿಲ್ಲ.</para>
  <para style="q1" vid="ECC 5:10">ಇದೂ ಸಹ ವ್ಯರ್ಥವೇ.<verse eid="ECC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11"/>ಆಸ್ತಿ ಹೆಚ್ಚಾದರೆ ಅನುಭವಿಸುವವರ ಸಂಖ್ಯೆಯೂ ಹೆಚ್ಚಾಗುವುದು.</para>
  <para style="q1" vid="ECC 5:11">ಅದನ್ನು ಕಣ್ಣಿನಿಂದ ನೋಡುವುದೇ ಹೊರತು</para>
  <para style="q2" vid="ECC 5:11">ಯಜಮಾನನಿಗೆ ಇನ್ಯಾವ ಲಾಭವೂ ಇಲ್ಲ.<verse eid="ECC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12"/>ದುಡಿಯುವವನು ಸ್ವಲ್ಪವೇ ತಿನ್ನಲಿ ಹೆಚ್ಚೇ ತಿನ್ನಲಿ,</para>
  <para style="q2" vid="ECC 5:12">ಹಾಯಾಗಿ ನಿದ್ರಿಸುತ್ತಾನೆ.</para>
  <para style="q1" vid="ECC 5:12">ಆದರೆ ಐಶ್ವರ್ಯವಂತನ ಸಮೃದ್ಧಿಯು ಅವನಿಗೆ ನಿದ್ರೆ ಮಾಡಗೊಡಿಸದು.<verse eid="ECC 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13"/>ಸೂರ್ಯನ ಕೆಳಗೆ ನಾನು ಮತ್ತೊಂದು ಕೇಡನ್ನು ಕಂಡೆನು.</para>
  <para style="q1" vid="ECC 5:13">ಯಜಮಾನನು ತನ್ನ ಆಸ್ತಿಯನ್ನು ಕಾಪಾಡುವುದರಲ್ಲಿಯೇ ಕೊರಗುತ್ತಿರುವನು.<verse eid="ECC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 5:14"/>ಆ ಆಸ್ತಿಯು ವ್ಯರ್ಥ ಪ್ರಯತ್ನದಿಂದ ಹಾಳಾಗುವುದು.</para>
  <para style="q2" vid="ECC 5:14">ಅವನಿಗೆ ಮಗನಿದ್ದರೆ ಆ ಮಗನಿಗಾಗಿ ಅವನ ಕೈಯಲ್ಲಿ ಏನೂ ಇರದು.<verse eid="ECC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15"/>ತಾಯಿಯ ಗರ್ಭದಿಂದ ಹೇಗೆ ಬಂದನೋ ಹಾಗೆಯೇ</para>
  <para style="q2" vid="ECC 5:15">ಏನೂ ಇಲ್ಲದವನಾಗಿ ಗತಿಸಿ ಹೋಗುವನು.</para>
  <para style="q1" vid="ECC 5:15">ಅವನು ಪ್ರಯಾಸಪಟ್ಟರೂ, ತನ್ನ ಕೈಯಲ್ಲಿ ಏನೂ ತೆಗೆದುಕೊಂಡು ಹೋಗುವುದಿಲ್ಲ. <verse eid="ECC 5:15"/><verse number="16" style="v" sid="ECC 5:16"/>ಇದು ಸಹ ದುರದೃಷ್ಟಕರವೇ.</para>
  <para style="q1" vid="ECC 5:16">ಮನುಷ್ಯನು ಹೇಗೆ ಬಂದನೋ ಹಾಗೆಯೇ ಹೋಗುವನು.</para>
  <para style="q1" vid="ECC 5:16">ಗಾಳಿಗಾಗಿ ಪಟ್ಟ ಪ್ರಯಾಸದಿಂದ ಅವನಿಗೆ ಲಾಭವೇನು?<verse eid="ECC 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17"/>ಅವನು ತನ್ನ ಜೀವಮಾನವೆಲ್ಲಾ ಕತ್ತಲೆಯಲ್ಲಿ ಜೀವಿಸುವನು.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="fq" closed="false">ಕತ್ತಲೆಯಲ್ಲಿ ಜೀವಿಸುವನು. </char><char style="ft" closed="false">ಅಥವಾ ಕತ್ತಲೆಯಲ್ಲಿ ಊಟಮಾಡುವನು ಅಥವಾ ಅವನ ಊಟದಲ್ಲಿ ಕತ್ತಲು ಕವಿದಿರುವುದು. </char></note></para>
  <para style="q2" vid="ECC 5:17">ಅವನ ರೋಗದೊಂದಿಗೆ ಅವನಿಗೆ ಬಹಳ ರೋಷವೂ ವ್ಯಥೆಯೂ ಇರುವುದು.<verse eid="ECC 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18"/>ಇಗೋ, ನಾನು ಕಂಡದ್ದು ಇದೇ. ದೇವರು ಒಬ್ಬನಿಗೆ ದಯಪಾಲಿಸಿರುವ ಜೀವಮಾನದ ದಿನಗಳಲ್ಲೆಲ್ಲಾ ಅವನು ಅನ್ನಪಾನಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ತಾನು ಲೋಕದೊಳಗೆ ಪಡುವ ಪ್ರಯಾಸದಲ್ಲಿಯೂ ಸುಖವನ್ನು ಅನುಭವಿಸುವನು. ಇದು ಅವನಿಗೆ ಉಚಿತವಾದದ್ದೂ, ಉತ್ತಮವಾದದ್ದೂ ಆಗಿದೆ. ಇದೇ ಅವನ ಪಾಲು.<verse eid="ECC 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 5:19"/>ಪ್ರತಿಯೊಬ್ಬ ಮನುಷ್ಯನಿಗೆ ದೇವರು ಆಸ್ತಿಪಾಸ್ತಿಗಳನ್ನು ದಯಪಾಲಿಸಿ, ಅದನ್ನು ಅನುಭವಿಸಿ, ಪಾಲಿಗೆ ಬಂದದ್ದನ್ನು ಪಡೆದು ತನ್ನ ಪ್ರಯಾಸದಲ್ಲಿ ಸಂತೋಷಪಡಲು ಶಕ್ತಿಕೊಟ್ಟಿದ್ದರೆ ಅದು ಅವನಿಗೆ ದೊರೆತ ದೇವರ ಅನುಗ್ರಹವೇ. <verse eid="ECC 5:19"/><verse number="20" style="v" sid="ECC 5:20"/>ಇಂಥವನು ತನ್ನ ಜೀವಮಾನದ ದಿನಗಳನ್ನು ಹೆಚ್ಚಾಗಿ ಗಣನೆಗೆ ತಂದುಕೊಳ್ಳುವುದಿಲ್ಲ. ಅವನು ತನ್ನ ಹೃದಯಾನಂದದಲ್ಲೇ ಮಗ್ನನಾಗಿರುವಂತೆ ದೇವರು ಮಾಡಿದ್ದಾನೆ.<verse eid="ECC 5:20"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>ಈ ಲೋಕದಲ್ಲಿ ಮನುಷ್ಯರಿಗೆ ವಿಪರೀತವಾಗಿ ಉಂಟಾಗಿರುವ ದುರಾವಸ್ಥೆಯನ್ನು ಕಂಡೆನು. <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>ಅದೇನೆಂದರೆ ದೇವರು ಒಬ್ಬನಿಗೆ ಯಾವ ಇಷ್ಟಾರ್ಥಕ್ಕೂ ಕೊರತೆಯಿಲ್ಲದಂತೆ ಧನವನ್ನು, ಸಂಪತ್ತನ್ನು ಹಾಗು ಘನತೆಯನ್ನು ಅನುಗ್ರಹಿಸುವನು. ಆದರೆ ಅದನ್ನು ಅನುಭವಿಸುವುದಕ್ಕೆ ದೇವರು ಅವನನ್ನು ಶಕ್ತಿಗೊಳಿಸುವುದಿಲ್ಲ. ಅದನ್ನು ಮತ್ತೊಬ್ಬನು ಅನುಭವಿಸುವನು. ಇದು ಸಹ ವ್ಯರ್ಥವೂ, ದುಃಖಕರವಾದ ಕೆಟ್ಟತನವೂ ಆಗಿದೆ.<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>ನೂರಾರು ಮಕ್ಕಳನ್ನು ಪಡೆದು ಮುಪ್ಪಿನ ಮುದುಕನಾಗುವ ತನಕ ಬಹಳ ವರ್ಷ ಬದುಕಿದವನಿಗೆ ಸಂತೃಪ್ತಿಯೂ, ಉತ್ತರಕ್ರಿಯೆಯೂ ಇಲ್ಲದಿದ್ದರೆ, ಇವನಿಗಿಂತಲೂ ಗರ್ಭಸ್ರಾವದ ಪಿಂಡವೇ ಉತ್ತಮ ಅಂದುಕೊಂಡೆನು. <verse eid="ECC 6:3"/><verse number="4" style="v" sid="ECC 6:4"/>ಅದು ವ್ಯರ್ಥವಾಗಿ ಬರುತ್ತದೆ. ಕತ್ತಲಲ್ಲಿ ಮರೆಯಾಗುತ್ತದೆ. ಅಂಧಕಾರವು ಅದರ ಹೆಸರನ್ನು ಕವಿದಿರುತ್ತದೆ.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="fq" closed="false">ಅಂಧಕಾರವು ಅದರ ಹೆಸರನ್ನು ಕವಿದಿರುತ್ತದೆ. </char><char style="ft" closed="false">ಅಥವಾ ಅವನ ಹೆಸರು ಮರೆತುಹೋಗಲ್ಪಡುತ್ತದೆ.</char></note><verse eid="ECC 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 6:5"/>ಅದು ಸೂರ್ಯನನ್ನು ಕಂಡಿಲ್ಲ. ಅದಕ್ಕೆ ತಿಳಿವಳಿಕೆಯೇ ಇಲ್ಲ. ಆದರೂ ಅವನಿಗಿಂತ ಅದರ ಶಾಂತಿಯೇ ಹೆಚ್ಚು. <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>ಎರಡು ಸಾವಿರ ವರ್ಷ ಅವನು ಬದುಕಿದರೂ ಅವನು ತನ್ನ ಐಶ್ವರ್ಯವನ್ನು ಅನುಭವಿಸಲಿಲ್ಲ. ಎಲ್ಲರೂ ಒಂದೇ ಸ್ಥಳಕ್ಕೆ ಹೋಗುತ್ತಾರೆ.<verse eid="ECC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7"/>ಮನುಷ್ಯನು ಪಡುವ ಪ್ರಯಾಸವೆಲ್ಲಾ ತನ್ನ ಹೊಟ್ಟೆಗಾಗಿಯೇ,</para>
  <para style="q2" vid="ECC 6:7">ಆದರೂ ಅವನಿಗೆ ತೃಪ್ತಿಯಿಲ್ಲ.<verse eid="ECC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8"/>ಬುದ್ಧಿಹೀನನಿಗಿಂತ ಜ್ಞಾನಿಗೆ ಹೆಚ್ಚು ಲಾಭ ಏನಿದೆ?</para>
  <para style="q2" vid="ECC 6:8">ಜನರ ಮುಂದೆ ಸರಿಯಾಗಿ ನಡೆದುಕೊಳ್ಳಲು ತಿಳಿಯದೇ ಇರುವ</para>
  <para style="q3" vid="ECC 6:8">ಬಡವನಿಗೆ ಲಾಭವೇನು?<verse eid="ECC 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9"/>ಬಗೆಬಗೆಯಾಗಿ ಆಶಿಸುವುದಕ್ಕಿಂತ</para>
  <para style="q2" vid="ECC 6:9">ಕಣ್ಣೆದುರಿಗಿರುವುದನ್ನು ಅನುಭವಿಸುವುದೇ ಒಳ್ಳೇಯದು.</para>
  <para style="q1" vid="ECC 6:9">ಇದು ಕೂಡ ಗಾಳಿಯನ್ನು ಹಿಂದಟ್ಟಿದ ಹಾಗೆ ವ್ಯರ್ಥವೇ.<verse eid="ECC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10"/>ಮನುಷ್ಯನು ಎಂಥವನಾದರೂ ಪೂರ್ವದಲ್ಲಿ ಅವನಿಗೆ ವಿಧಿಸಲ್ಪಟ್ಟ ಹೆಸರಿನಿಂದ ಅವನು ಮಣ್ಣಿನವನೇ ಎಂದು ಗೊತ್ತಾಗಿದೆ. ತನಗಿಂತ ಬಲಿಷ್ಠನ ಸಂಗಡ ಹೋರಾಡಲಾರನು.<verse eid="ECC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11"/>ಮಾತು ಹೆಚ್ಚಿದಷ್ಟು ಪರಿಣಾಮ ಕಡಿಮೆ,</para>
  <para style="q2" vid="ECC 6:11">ಅವುಗಳಿಂದ ಮನುಷ್ಯನಿಗೆ ಏನು ಪ್ರಯೋಜನ?<verse eid="ECC 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12"/>ನೆರಳಿನಂತೆ ವ್ಯರ್ಥವಾಗಿ ಕಳೆದುಹೋಗುವ ಮನುಷ್ಯನ ಜೀವಮಾನದ ದಿನಗಳಲ್ಲೆಲ್ಲಾ ಅವನಿಗೆ ಯಾವುದು ಮೇಲೆಂದು ಯಾರಿಗೆ ಗೊತ್ತು? ತಾನು ಸತ್ತುಹೋದ ಮೇಲೆ ಇಹಲೋಕದಲ್ಲಿ ಏನಾಗುವುದೆಂದು ಅವನು ಯಾರಿಂದ ತಿಳಿದುಕೊಂಡಾನು?<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s">ಜ್ಞಾನ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1"/>ಸುಗಂಧತೈಲಕ್ಕಿಂತ ಒಳ್ಳೆಯ ಹೆಸರು ಉತ್ತಮ,</para>
  <para style="q2" vid="ECC 7:1">ಮತ್ತು ಜನನ ದಿನಕ್ಕಿಂತ ಮರಣ ದಿನವೇ ಮೇಲು.<verse eid="ECC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2"/>ಔತಣದ ಮನೆಗಿಂತ</para>
  <para style="q2" vid="ECC 7:2">ಮರಣದುಃಖದ ಮನೆಗೆ ಹೋಗುವುದು ಲೇಸು.</para>
  <para style="q1" vid="ECC 7:2">ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗೂ ಕೊನೆಗೆ ಇದೇ ಗತಿ,</para>
  <para style="q2" vid="ECC 7:2">ಜೀವಂತನು ಇದನ್ನು ನೋಡಿ ತನ್ನ ಹೃದಯದಲ್ಲಿ ಸ್ಮರಿಸುವನು.<verse eid="ECC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3"/>ನಗೆಗಿಂತ ದುಃಖವು ವಾಸಿ,</para>
  <para style="q2" vid="ECC 7:3">ಮುಖವು ಸಪ್ಪಗಿರುವಲ್ಲಿ ಹೃದಯಕ್ಕೆ ಮೇಲು.<verse eid="ECC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4"/>ದುಃಖದ ಮನೆಯು ಜ್ಞಾನಿಗಳ ಮನಸ್ಸಿಗೆ ನೆಲೆ,</para>
  <para style="q2" vid="ECC 7:4">ಉಲ್ಲಾಸದ ಮನೆಯು ಮೂಢರ ಮನಸ್ಸಿಗೆ ನಿವಾಸ.<verse eid="ECC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5"/>ಮೂಢರ ಗಾನಕ್ಕಿಂತ</para>
  <para style="q2" vid="ECC 7:5">ಜ್ಞಾನಿಗಳ ಗದರಿಕೆಯನ್ನು ಕೇಳುವುದು ಲೇಸು.<verse eid="ECC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6"/>ಮೂಢರ ನಗುವು ಮಡಿಕೆಯ ಕೆಳಗೆ ಉರಿಯುವ</para>
  <para style="q2" vid="ECC 7:6">ಮುಳ್ಳಿನ ಚಟಪಟ ಶಬ್ದದ ಹಾಗೆಯೇ. ಇದೂ ಕೂಡ ವ್ಯರ್ಥ.<verse eid="ECC 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7"/>ದಬ್ಬಾಳಿಕೆಯು ಜ್ಞಾನಿಯನ್ನು ಮೂರ್ಖನನ್ನಾಗಿಸುತ್ತದೆ,</para>
  <para style="q2" vid="ECC 7:7">ಲಂಚವು ಹೃದಯವನ್ನು ಕೆಡಿಸುತ್ತದೆ.<verse eid="ECC 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8"/>ಆದಿಗಿಂತ ಅಂತ್ಯವು ಲೇಸು;</para>
  <para style="q2" vid="ECC 7:8">ಅಹಂಕಾರಿಗಿಂತ ತಾಳ್ಮೆಯುಳ್ಳವನು ಉತ್ತಮ.<verse eid="ECC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9"/>ನಿನ್ನ ಮನಸ್ಸು ಕೋಪಕ್ಕೆ ಆತುರಪಡದಿರಲಿ,</para>
  <para style="q2" vid="ECC 7:9">ಕೋಪಕ್ಕೆ ಮೂಢರ ಎದೆಯೇ ಲೇಸು.<verse eid="ECC 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10"/>ಹಿಂದಿನ ಕಾಲವು ಈ ಕಾಲಕ್ಕಿಂತ ಮೇಲಾದದ್ದಕ್ಕೆ ಕಾರಣವೇನು ಅನ್ನಬೇಡ.</para>
  <para style="q2" vid="ECC 7:10">ನೀನು ಈ ವಿಷಯದಲ್ಲಿ ವಿಚಾರಿಸುವುದು ಜ್ಞಾನಕಾರ್ಯವಲ್ಲ.<verse eid="ECC 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11"/>ಜ್ಞಾನವು ಸ್ವತ್ತಿನಂತೆ ಪ್ರಯೋಜನಕರ.</para>
  <para style="q2" vid="ECC 7:11">ಇದು ಲೋಕದಲ್ಲಿ ಜೀವಿಸುವವರಿಗೆ<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="fq" closed="false">ಲೋಕದಲ್ಲಿ ಜೀವಿಸುವವರಿಗೆ </char><char style="ft" closed="false">ಅಥವಾ ಸೂರ್ಯನನ್ನು ನೋಡುವವರಿಗೆ</char></note> ಸ್ವತ್ತಿಗಿಂತ ಉತ್ತಮೋತ್ತಮವಾಗಿದೆ.<verse eid="ECC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12"/>ಧನವು ಹೇಗೊ ಹಾಗೆ ಜ್ಞಾನವು ಆಶ್ರಯ.</para>
  <para style="q2" vid="ECC 7:12">ಜ್ಞಾನಕ್ಕೆ ವಿಶೇಷವೇನೆಂದರೆ ತನ್ನನ್ನು ಹೊಂದಿದವನಿಗೆ ಅದು ಜೀವದಾಯಕವೆಂಬುದೇ.<verse eid="ECC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 7:13"/>ದೇವರ ಕಾರ್ಯವನ್ನು ನೋಡು;</para>
  <para style="q2" vid="ECC 7:13">ಆತನು ಸೊಟ್ಟಗೆ ಮಾಡಿದ್ದನ್ನು ನೆಟ್ಟಗೆ ಮಾಡುವುದಕ್ಕೆ ಯಾರಿಂದಾದೀತು?<verse eid="ECC 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14"/>ಸುಖದ ದಿನದಲ್ಲಿ ಸುಖದಿಂದಿರು,</para>
  <para style="q2" vid="ECC 7:14">ದುಃಖದ ದಿನದಲ್ಲಿ ಯೋಚಿಸು;</para>
  <para style="q1" vid="ECC 7:14">ಮನುಷ್ಯನು ತನ್ನ ಕಾಲವಾದ ಮೇಲೆ ಸಂಭವಿಸುವ ಯಾವುದನ್ನೂ ಗ್ರಹಿಸಲಾರದಂತೆ,</para>
  <para style="q2" vid="ECC 7:14">ದೇವರು ಇವುಗಳನ್ನು ಒಂದರ ಮೇಲೊಂದು ಬರಮಾಡಿದ್ದಾನೆ.<verse eid="ECC 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15"/>ನೀತಿವಂತನು ತನ್ನ ನೀತಿಯಲ್ಲಿಯೇ ನಶಿಸುವುದುಂಟು.</para>
  <para style="q1" vid="ECC 7:15">ದುಷ್ಟನು ತನ್ನ ದುಷ್ಟತನದಲ್ಲಿಯೇ ಬಹಳ ದಿನ ಬದುಕುವುದುಂಟು.</para>
  <para style="q2" vid="ECC 7:15">ಇದನ್ನೆಲ್ಲಾ ನನ್ನ ವ್ಯರ್ಥವಾದ ಜೀವಮಾನದಲ್ಲಿ ನೋಡಿದ್ದೇನೆ.<verse eid="ECC 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16"/>ನೀನು ಅತಿಯಾಗಿ ನೀತಿವಂತನಾಗಿರಬೇಡ,</para>
  <para style="q2" vid="ECC 7:16">ನಿನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ನೀನು ಜ್ಞಾನಿಯಾಗಿರಬೇಡ.</para>
  <para style="q1" vid="ECC 7:16">ನಿನ್ನನ್ನು ನೀನೇ ನಾಶನಕ್ಕೆ ಏಕೆ ಗುರಿಮಾಡಿಕೊಳ್ಳುವಿ?<verse eid="ECC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17"/>ನೀನು ಅತಿಯಾಗಿ ದುಷ್ಟನಾಗಿರಬೇಡ ಇಲ್ಲವೇ ಮೂರ್ಖನಾಗಿರಬೇಡ,</para>
  <para style="q1" vid="ECC 7:17">ಏಕೆ ಅಕಾಲ ಮರಣವನ್ನು ಹೊಂದುವಿ?<verse eid="ECC 7:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ECC 7:18"/>ನೀನು ಇದನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವುದು ಒಳ್ಳೆಯದು, ಅದರಿಂದ ಕೈಯನ್ನು ಹಿಂತೆಗೆಯಬೇಡ.</para>
  <para style="q1" vid="ECC 7:18">ದೇವರಿಗೆ ಭಯಪಡುವವನು ಅವೆಲ್ಲವುಗಳಿಂದ ಪಾರಾಗುವನು.<verse eid="ECC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19"/>ಹತ್ತು ಮಂದಿ ಅಧಿಕಾರಿಗಳಿಂದ ಪಟ್ಟಣಕ್ಕೆ ಉಂಟಾಗುವ ಬಲಕ್ಕಿಂತಲೂ</para>
  <para style="q2" vid="ECC 7:19">ಜ್ಞಾನಿಗೆ ಜ್ಞಾನದಿಂದ ಉಂಟಾಗುವ ಬಲವು ಹೆಚ್ಚು.<verse eid="ECC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20"/>ಪಾಪಮಾಡದೇ ಧರ್ಮವನ್ನೇ ಆಚರಿಸುತ್ತಿರುವ</para>
  <para style="q2" vid="ECC 7:20">ಸತ್ಪುರುಷರು ಲೋಕದಲ್ಲಿ ಇಲ್ಲವೇ ಇಲ್ಲ.<verse eid="ECC 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21"/>ಆಡುವ ಮಾತುಗಳನ್ನೆಲ್ಲಾ ಲಕ್ಷ್ಯಕ್ಕೆ ತಾರದಿರು,</para>
  <para style="q2" vid="ECC 7:21">ನಿನ್ನ ಆಳು ನಿನ್ನನ್ನು ಶಪಿಸುವುದು ಕಿವಿಗೆ ಬಿದ್ದೀತು.<verse eid="ECC 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22"/>ನೀನು ಕೂಡ ಅನೇಕ ವೇಳೆ ಇತರರನ್ನು ಶಪಿಸಿದ್ದಿ</para>
  <para style="q2" vid="ECC 7:22">ಎಂಬುದಕ್ಕೆ ನಿನ್ನ ಮನಸ್ಸೇ ಸಾಕ್ಷಿ.<verse eid="ECC 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23"/>ಇದನ್ನೆಲ್ಲಾ ಜ್ಞಾನದಿಂದ ಪರೀಕ್ಷಿಸಿದೆನು.</para>
  <para style="q1" vid="ECC 7:23">“ನಾನು ಜ್ಞಾನಿಯಾಗುವೆನು” ಎಂದುಕೊಂಡೆನು.</para>
  <para style="q2" vid="ECC 7:23">ಆದರೆ ಅದು ನನ್ನಿಂದ ದೂರವಾಯಿತು.<verse eid="ECC 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24"/>ಜ್ಞಾನವು ಬಹಳ ದೂರದಲ್ಲಿಯೂ, ಅಗಾಧದಲ್ಲಿಯೂ ಇದೆ.</para>
  <para style="q1" vid="ECC 7:24">ಅದನ್ನು ಯಾರು ಕಂಡುಕೊಂಡಾರು?<verse eid="ECC 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25"/>ನಾನು ತಿರುಗಿಕೊಂಡು,</para>
  <para style="q2" vid="ECC 7:25">ಜ್ಞಾನವನ್ನು ಮತ್ತು ಮೂಲತತ್ವವನ್ನು ಹುಡುಕಿ, ವಿಚಾರಿಸಿ ಗ್ರಹಿಸುವುದಕ್ಕೂ</para>
  <para style="q1" vid="ECC 7:25">ಅಧರ್ಮವು ಮೂರ್ಖತನ,</para>
  <para style="q2" vid="ECC 7:25">ಅಜ್ಞಾನವು ಹುಚ್ಚುತನ ಎಂದು ತಿಳಿದುಕೊಳ್ಳುವುದಕ್ಕೂ ಮನಸ್ಸಿಟ್ಟೆನು.<verse eid="ECC 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26"/>ಆಗ ಮರಣಕ್ಕಿಂತ ಹೆಚ್ಚು ವಿಷವೊಂದು ಕಂಡುಬಂತು. ಯಾವುದೆಂದರೆ ಕೆಟ್ಟ ಹೆಂಗಸೇ.</para>
  <para style="q2" vid="ECC 7:26">ಅವಳ ಹೃದಯವು ಉರುಲುಗಳೂ, ಬಲೆಗಳೂ,</para>
  <para style="q2" vid="ECC 7:26">ಅವಳ ತೋಳುಗಳು ಸಂಕೋಲೆಗಳು.</para>
  <para style="q1" vid="ECC 7:26">ದೇವರು ಒಲಿದವನು ಅವಳಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳುವನು.</para>
  <para style="q2" vid="ECC 7:26">ಆದರೆ ಪಾಪಿಯು ಅವಳ ಕೈಗೆ ಸಿಕ್ಕಿಬೀಳುವನು.<verse eid="ECC 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27"/>ಪ್ರಸಂಗಿಯು ಹೀಗೆ ಹೇಳುತ್ತಾನೆ, “ನೋಡು, ನಾನು ಇದನ್ನು ಹುಡುಕಿ ಕಂಡುಕೊಂಡಿದ್ದೇನೆ” ಮತ್ತೊಂದು ಸಂಶೋಧನೆಯನ್ನು ಎಷ್ಟು ನಡೆಸಿದರೂ ಉತ್ತರ ಸಿಕ್ಕಲಿಲ್ಲ. <verse eid="ECC 7:27"/><verse number="28" style="v" sid="ECC 7:28"/>ಸಹಸ್ರ ಪುರುಷರಲ್ಲಿ ಯೋಗ್ಯನೊಬ್ಬನನ್ನು ಕಂಡಿದ್ದರೂ ಕಂಡಿರಬಹುದು, ಆದರೆ ಸಹಸ್ರ ಸ್ತ್ರೀಯರಲ್ಲಿ ಯೋಗ್ಯಳೊಬ್ಬಳನ್ನೂ ಕಂಡಿಲ್ಲ.<verse eid="ECC 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ECC 7:29"/>ದೇವರು ಮನುಷ್ಯರನ್ನು ಸತ್ಯವಂತನನ್ನಾಗಿ ಸೃಷ್ಟಿಸಿದನು. ಅವರಾದರೋ ಬಹು ಯುಕ್ತಿಗಳನ್ನು ಕಲ್ಪಿಸಿಕೊಂಡಿದ್ದಾರೆ. ಇದನ್ನು ಮಾತ್ರ ನಾನು ಕಂಡುಕೊಂಡಿದ್ದೇನೆ.<verse eid="ECC 7:29"/></para>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1"/>ಜ್ಞಾನಿಯ ಹಾಗೆ ಇರುವವನು ಯಾರು?</para>
  <para style="q2" vid="ECC 8:1">ವಿಷಯವನ್ನು ವಿವರಿಸಬಲ್ಲವರು ಯಾರು?</para>
  <para style="q1" vid="ECC 8:1">ಜ್ಞಾನದಿಂದ ಒಬ್ಬನ ಮುಖವು ಪ್ರಕಾಶಗೊಳ್ಳುವುದು,</para>
  <para style="q2" vid="ECC 8:1">ಒರಟು ಮುಖವು ಬದಲಾಗುವುದು.<verse eid="ECC 8:1"/></para>
  <para style="s">ಅರಸನ ಆಜ್ಞೆ ಪಾಲಿಸು</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2"/>ದೇವರ ಮೇಲೆ ಇಟ್ಟ ಆಣೆಯ ನಿಮಿತ್ತ ರಾಜನ ಆಜ್ಞೆಯನ್ನು ಕೈಕೊಳ್ಳಬೇಕೆಂಬುದು ನನ್ನ ಬೋಧನೆ. <verse eid="ECC 8:2"/><verse number="3" style="v" sid="ECC 8:3"/>ಅರಸನ ಸನ್ನಿಧಿಯಿಂದ ತೊಲಗಿಬಿಡಲು ಆತುರಪಡಬೇಡ. ದ್ರೋಹಕ್ಕೆ ಸೇರದಿರು. ಅವನು ಇಷ್ಟಬಂದಂತೆ ಮಾಡಬಲ್ಲನು. <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>ಅರಸನ ಮಾತಿಗೆ ಅಧಿಕಾರವುಂಟು “ನೀನು ಏನು ಮಾಡುತ್ತಿರುವೆ?” ಎಂದು ಅವನನ್ನು ಯಾರು ತಾನೇ ಕೇಳಬಹುದು.<verse eid="ECC 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5"/>ಅರಸನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಕೊಳ್ಳುವವನು ಕೇಡನ್ನು ಅನುಭವಿಸುವುದಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 8:5">ಜ್ಞಾನಿಯ ಹೃದಯವು ಕಾಲ ಮತ್ತು ನ್ಯಾಯ ಎರಡನ್ನು ತಿಳಿದುಕೊಳ್ಳುತ್ತದೆ.<verse eid="ECC 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6"/>ಪ್ರತಿಯೊಂದು ಕಾರ್ಯಕ್ಕೂ ಒಂದು ಕಾಲ ಮತ್ತು ಒಂದು ಕ್ರಮ ಇರುತ್ತದೆಯಲ್ಲವೇ,</para>
  <para style="q2" vid="ECC 8:6">ಮನುಷ್ಯನು ಪಡುವ ಕಷ್ಟವು ಅವನಿಗೆ ಘೋರವಾಗಿದೆ.<verse eid="ECC 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7"/>ಮುಂದೆ ಏನಾಗುವುದು ಯಾರಿಗೂ ಗೊತ್ತಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 8:7">ಮುಂದೆ ಆಗುವುದನ್ನು ಅವನಿಗೆ ವಿವರಿಸಬಲ್ಲವರು ಯಾರು?<verse eid="ECC 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8"/>ಗಾಳಿಯನ್ನು ತಡೆಯುವ ಶಕ್ತಿಯು ಹೇಗೆ ಯಾರಿಗೂ ಇಲ್ಲವೋ,</para>
  <para style="q2" vid="ECC 8:8">ಹಾಗೆಯೇ ತಮ್ಮ ಮರಣ ದಿನವನ್ನು ತಡೆಯುವ ಶಕ್ತಿಯು ಯಾರಿಗೂ ಇಲ್ಲ.</para>
  <para style="q1" vid="ECC 8:8">ಯುದ್ಧ ಕಾಲದಲ್ಲಿ ಹೇಗೆ ವಿರಾಮ ದೊರೆಯುವುದಿಲ್ಲವೋ,</para>
  <para style="q2" vid="ECC 8:8">ಹಾಗೆಯೇ ದುಷ್ಟನಿಗೆ ದುಷ್ಟತನದಿಂದ ಬಿಡುಗಡೆಯೇ ಇಲ್ಲ. <verse eid="ECC 8:8"/><verse number="9" style="v" sid="ECC 8:9"/>ನಾನು ಇದನ್ನೆಲ್ಲಾ ನೋಡಿ, ಈ ಲೋಕದೊಳಗೆ ನಡೆಯುವ ಸಕಲ ಕಾರ್ಯಗಳನ್ನೂ ಪರಿಶೀಲಿಸಿದ್ದೇನೆ. ಒಬ್ಬ ಮನುಷ್ಯನು ಇನ್ನೊಬ್ಬನ ಮೇಲೆ ಅಧಿಕಾರ ನಡೆಸಿ ಅವನಿಗೆ ಹಾನಿಯನ್ನು ಉಂಟುಮಾಡುವ ಕಾಲವೂ ಇದೆ.<verse eid="ECC 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10"/>ಇದಲ್ಲದೆ ದುಷ್ಟರಿಗೆ ಸಮಾಧಿಯಾಗುವುದನ್ನು ಕಂಡೆನು. ಅವರು ಸುಖವಾಗಿ ಗತಿಸುವರು. ಧಾರ್ಮಿಕರೋ ಪರಿಶುದ್ಧ ಸ್ಥಾನದಿಂದ ತೊಲಗಬೇಕಾಯಿತು. ಪಟ್ಟಣದಲ್ಲಿ ಅವರ ಜ್ಞಾಪಕವೇ ಇಲ್ಲವಾಯಿತು.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="fq" closed="false">ಜ್ಞಾಪಕವೇ ಇಲ್ಲವಾಯಿತು. </char><char style="ft" closed="false">ಅಥವಾ ಅವರನ್ನು ಹೊಗಳುವರು.</char></note> ಇದೂ ವ್ಯರ್ಥವೇ. <verse eid="ECC 8:10"/><verse number="11" style="v" sid="ECC 8:11"/>ಅಪರಾಧಕ್ಕೆ ವಿಧಿಸಿದ ದಂಡನೆಯು ಕೂಡಲೇ ನಡೆಯದಿರುವ ಕಾರಣ ಅಪರಾಧ ಮಾಡಬೇಕೆಂಬ ಯೋಚನೆಯು ಮನುಷ್ಯರ ಹೃದಯದಲ್ಲಿ ತುಂಬಿ ತುಳುಕುವುದು.<verse eid="ECC 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 8:12"/>ಪಾಪಿಯು ನೂರು ಸಲ ಅಧರ್ಮ ಮಾಡಿ ಬಹು ಕಾಲ ಬದುಕಿದರೂ, ದೇವರ ಮುಂದೆ ಹೆದರಿ, ಆತನಲ್ಲಿ ಭಯಭಕ್ತಿಯುಳ್ಳವರಿಗೆ ಒಳ್ಳೆಯದೇ ಆಗುವುದೆಂದು ಬಲ್ಲೆನು. <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>ಆದರೆ ದುಷ್ಟನಿಗೆ ಒಳ್ಳೆಯದಾಗುವುದಿಲ್ಲ. ನೆರಳಿನಂತಿರುವ ಅವನ ದಿನಗಳು ಹೆಚ್ಚುವುದಿಲ್ಲ. ಏಕೆಂದರೆ ಅವನು ದೇವರಿಗೆ ಭಯಪಡುವುದಿಲ್ಲ.<verse eid="ECC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>ಲೋಕದಲ್ಲಿ ನಡೆಯುವ ವ್ಯರ್ಥಕಾರ್ಯವು ಒಂದುಂಟು. ದುಷ್ಟರ ನಡತೆಗೆ ತಕ್ಕ ಗತಿಯು ಶಿಷ್ಟನಿಗೆ ಆಗುವುದು. ಶಿಷ್ಟರ ನಡತೆಗೆ ತಕ್ಕ ಗತಿಯು ದುಷ್ಟರಿಗೆ ಆಗುವುದು. ಇದು ವ್ಯರ್ಥವೆಂದು ನಾನು ಹೇಳಿದೆನು. <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>ಆದುದರಿಂದಲೇ ನಾನು ಸಂತೋಷವನ್ನು ಹೊಗಳಿದೆನು. ಏಕೆಂದರೆ ಮನುಷ್ಯನಿಗೆ ಲೋಕದಲ್ಲಿ ಕುಡಿಯುವುದೂ, ತಿನ್ನುವುದೂ, ಸಂತೋಷಪಡುವುದೇ ಹೊರತು ಬೇರೇನೂ ಒಳ್ಳೆಯದು ಇಲ್ಲ. ಲೋಕದಲ್ಲಿ ದೇವರು ಅವನಿಗೆ ಅನುಗ್ರಹಿಸುವ ದಿನಗಳಲ್ಲಿ ಅವನು ಪಡುವ ಪ್ರಯಾಸದಲ್ಲಿ ಸಂತೋಷವೇ ಸೇರಿರುವುದು.<verse eid="ECC 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 8:16"/>ನಾನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ಜ್ಞಾನವನ್ನು ಪಡೆಯಲು, ಲೋಕದಲ್ಲಿ ನಡೆಯುವುದನ್ನು ಅರಿತುಕೊಳ್ಳಲು ಪ್ರಯತ್ನಿಸಿದಾಗ, ನಾನು ಕಂಡುಕೊಂಡ ಸಂಗತಿಯೇನೆಂದರೆ, “ಒಬ್ಬನು ರಾತ್ರಿಹಗಲು ಕಣ್ಣುಗಳಿಗೆ ನಿದ್ರೆಕೊಡದೆ ಕೆಲಸ ಮಾಡಿದರೂ, <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>ದೇವರ ಎಲ್ಲಾ ಕಾರ್ಯಗಳನ್ನೂ ಮತ್ತು ಲೋಕದಲ್ಲಿ ಮಾಡುವ ಕೆಲಸಗಳನ್ನೂ ಮನುಷ್ಯನು ಗ್ರಹಿಸಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ಮನುಷ್ಯನು ಅದನ್ನು ಹುಡುಕುವುದಕ್ಕೆ ಎಷ್ಟು ಪ್ರಯಾಸಪಟ್ಟರೂ ಅದನ್ನು ಕಂಡುಕೊಳ್ಳಲಾರನು. ಹೌದು, ಜ್ಞಾನಿಯು ಅದನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳಲು ಯೋಚಿಸಿದರೂ ಅವನು ಅದನ್ನು ಗ್ರಹಿಸಲಾರನು.”<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s">ಎಲ್ಲರ ಅಂತ್ಯ ಸ್ಥಿತಿಯು ಒಂದೇ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>ಇವೆಲ್ಲವುಗಳನ್ನು ನನ್ನ ಮನಸ್ಸಿನಲ್ಲಿ ವಿಚಾರಿಸಿಕೊಂಡು ಒಂದು ತೀರ್ಮಾನಕ್ಕೆ ಬಂದೆನು. ಅದೇನೆಂದರೆ ನೀತಿವಂತನ ಮತ್ತು ಜ್ಞಾನಿಗಳ ಕೆಲಸಗಳು ದೇವರ ಕೈಯಲ್ಲಿವೆ. ಯಾವ ಮನುಷ್ಯನೂ ತನ್ನ ಮುಂದಿರುವ ಪ್ರೀತಿಯನ್ನು ಅಥವಾ ದ್ವೇಷವನ್ನು ತಿಳಿಯಲಾರನು.<verse eid="ECC 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 9:2"/>ಎಲ್ಲವುಗಳು ಎಲ್ಲರಿಗೂ ಒಂದೇ ಬಗೆಯಾಗಿ ಸಂಭವಿಸುವುದು.</para>
  <para style="q1" vid="ECC 9:2">ನೀತಿವಂತನಿಗೂ ಮತ್ತು ದುಷ್ಟನಿಗೂ,</para>
  <para style="q1" vid="ECC 9:2">ಒಳ್ಳೆಯವನಿಗೂ ಮತ್ತು ಕೆಟ್ಟವನಿಗೂ,</para>
  <para style="q1" vid="ECC 9:2">ಶುದ್ಧನಿಗೂ ಮತ್ತು ಅಶುದ್ಧನಿಗೂ,</para>
  <para style="q1" vid="ECC 9:2">ಯಜ್ಞವನ್ನು ಅರ್ಪಿಸುವವನಿಗೂ ಮತ್ತು ಅರ್ಪಿಸದವನಿಗೂ ಒಂದೇ ಗತಿಯಾಗುವುದು.</para>
  <para style="q1" vid="ECC 9:2">ಒಳ್ಳೆಯವನು ಹೇಗೋ ಹಾಗೆಯೇ ಪಾಪಿಯೂ ಇರುವನು.</para>
  <para style="q1" vid="ECC 9:2">ಆಣೆಯಿಡುವವನು ಹೇಗೋ ಹಾಗೆಯೇ ಆಣೆಗೆ ಭಯಪಡುವವನೂ ಇರುವನು.<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>ಈ ಲೋಕದಲ್ಲಿ ನಡೆಯುವ ಎಲ್ಲಾ ಸಂಗತಿಗಳಿಗೂ ಕೆಟ್ಟ ಪ್ರತಿಫಲ ಉಂಟು ಮತ್ತು ಎಲ್ಲರಿಗೂ ಒಂದೇ ಗತಿಯಾಗುವುದು. ಇದಲ್ಲದೆ ಮನುಷ್ಯರ ಹೃದಯದಲ್ಲಿ ಕೆಟ್ಟತನವು ತುಂಬಿದೆ. ಅವರು ಬದುಕಿರುವ ತನಕ ಹುಚ್ಚುತನವು ಅವರ ಮನಸ್ಸನ್ನು ಹಿಡಿದಿರುವುದು. ಅನಂತರ ಅವರು ಸಾಯುತ್ತಾರೆ.<verse eid="ECC 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 9:4"/>ಜೀವಿತರ ಗುಂಪಿನಲ್ಲಿ ಸೇರಿದವನಿಗೆ ನಿರೀಕ್ಷೆಯುಂಟು. ಸತ್ತ ಸಿಂಹಕ್ಕಿಂತ ಬದುಕಿರುವ ನಾಯಿಯೇ ಲೇಸು.<verse eid="ECC 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5"/>ಜೀವಿಸುವವರಿಗೆ ಸಾಯುತ್ತೇವೆಂಬ ತಿಳಿವಳಿಕೆಯು ಉಂಟು.</para>
  <para style="q1" vid="ECC 9:5">ಸತ್ತವರಿಗೋ ಯಾವ ತಿಳಿವಳಿಕೆಯೂ ಇಲ್ಲ.</para>
  <para style="q2" vid="ECC 9:5">ಅವರಿಗೆ ಇನ್ನು ಮೇಲೆ ಪ್ರತಿಫಲವು ಇಲ್ಲ.</para>
  <para style="q1" vid="ECC 9:5">ಅವರ ಜ್ಞಾಪಕವೇ ಇಲ್ಲ.<verse eid="ECC 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6"/>ಅವರು ಸತ್ತಾಗಲೇ ಅವರ ಪ್ರೀತಿಯೂ,</para>
  <para style="q2" vid="ECC 9:6">ಹಗೆಯೂ, ಹೊಟ್ಟೆಕಿಚ್ಚು ಅಳಿದುಹೋಗಿವೆ.</para>
  <para style="q1" vid="ECC 9:6">ಲೋಕದೊಳಗೆ ನಡೆಯುವ ಯಾವ ಕೆಲಸದಲ್ಲಿಯೂ</para>
  <para style="q2" vid="ECC 9:6">ಅವರಿಗೆ ಇನ್ನೆಂದಿಗೂ ಪಾಲು ಇಲ್ಲ.<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>ಹೋಗು, ನಿನ್ನ ಅನ್ನವನ್ನು ಸಂತೋಷದಿಂದ ಉಣ್ಣು. ನಿನ್ನ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಒಳ್ಳೆಯ ಮನಸ್ಸಿನಿಂದ ಕುಡಿ. ದೇವರು ನಿನ್ನ ಕೆಲಸಗಳನ್ನು ಈಗ ಒಪ್ಪಿಕೊಳ್ಳುತ್ತಾನೆ. <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>ನಿನ್ನ ಬಟ್ಟೆಗಳು ಯಾವಾಗಲೂ ಬಿಳುಪಾಗಿರಲಿ. ನಿನ್ನ ತಲೆಗೆ ಎಣ್ಣೆಯ ಕೊರತೆ ಇಲ್ಲದಿರಲಿ.<verse eid="ECC 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 9:9"/>ಲೋಕದೊಳಗೆ ದೇವರು ನಿನಗೆ ನೇಮಿಸಿರುವ ವ್ಯರ್ಥ ಜೀವಮಾನದ ವ್ಯರ್ಥ ದಿನಗಳೆಲ್ಲಾ ನಿನ್ನ ಪ್ರಿಯಪತ್ನಿಯೊಡನೆ ಸುಖದಿಂದ ಬದುಕು. ನಿನ್ನ ಬಾಳಿನಲ್ಲಿಯೂ, ನೀನು ಲೋಕದೊಳಗೆ ಪಡುವ ಪ್ರಯಾಸದಲ್ಲಿಯೂ ಇದೇ ನಿನ್ನ ಪಾಲಾಗಿದೆ. <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>ನಿನ್ನ ಕೈಗೆ ಸಿಕ್ಕಿದ ಕೆಲಸವನ್ನೆಲ್ಲಾ ನಿನ್ನ ಪೂರ್ಣ ಶಕ್ತಿಯಿಂದ ಮಾಡು. ಏಕೆಂದರೆ ನೀನು ಸೇರಬೇಕಾದ ಸಮಾಧಿಯಲ್ಲಿ ಯಾವ ಕೆಲಸವೂ, ಯುಕ್ತಿಯೂ, ತಿಳಿವಳಿಕೆಯೂ, ಜ್ಞಾನವೂ ಇರುವುದಿಲ್ಲ.<verse eid="ECC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11"/>ನಾನು ಲೋಕದಲ್ಲಿ ತಿರುಗಿ ದೃಷ್ಟಿಸಲು</para>
  <para style="q2" vid="ECC 9:11">ವೇಗಿಗಳಿಗೆ ಓಟದಲ್ಲಿ ಗೆಲುವಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 9:11">ಬಲಿಷ್ಠರಿಗೆ ಯುದ್ಧದಲ್ಲಿ ಜಯವಿಲ್ಲ.</para>
  <para style="q2" vid="ECC 9:11">ಜ್ಞಾನಿಗಳಿಗೆ ಅನ್ನ ಸಿಕ್ಕದು.</para>
  <para style="q2" vid="ECC 9:11">ವಿವೇಕಿಗಳಿಗೆ ಧನ ಲಭಿಸದು.</para>
  <para style="q2" vid="ECC 9:11">ಪ್ರವೀಣರಿಗೆ ದಯೆ ದೊರಕದು.</para>
  <para style="q1" vid="ECC 9:11">ಕಾಲವೂ, ಗತಿಯೂ ಅವರೆಲ್ಲರಿಗೆ ಸಂಭವಿಸುತ್ತದೆ.<verse eid="ECC 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 9:12"/>ಮನುಷ್ಯನೋ ತನ್ನ ಕಾಲ ಗತಿಯನ್ನು ತಿಳಿಯನಷ್ಟೆ.</para>
  <para style="q2" vid="ECC 9:12">ಮೀನುಗಳು ಕೆಟ್ಟ ಬಲೆಗೂ,</para>
  <para style="q2" vid="ECC 9:12">ಪಕ್ಷಿಗಳು ಉರುಲಿನಲ್ಲಿ ಸಿಕ್ಕಿಬೀಳುವ ಹಾಗೆ</para>
  <para style="q1" vid="ECC 9:12">ಮನುಷ್ಯರು ಪ್ರಾಣಿಗಳ ಹಾಗೆ ತಮ್ಮ ಮೇಲೆ</para>
  <para style="q2" vid="ECC 9:12">ತಟ್ಟನೆ ಬೀಳುವ ಕೇಡಿನ ಕಾಲಕ್ಕೆ ಸಿಕ್ಕಿಕೊಳ್ಳುವರು.<verse eid="ECC 9:12"/></para>
  <para style="s">ದಡ್ಡತನಕ್ಕಿಂತ ಜ್ಞಾನ ಲೇಸು</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>ನಾನು ಲೋಕದಲ್ಲಿ ಜ್ಞಾನವನ್ನು ಈ ವಿಧವಾಗಿಯೂ ಕಂಡುಕೊಂಡೆನು. ಅದು ದೊಡ್ಡದೆಂದು ತೋಚಿತು. <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>ಇಗೋ, ಒಂದು ಚಿಕ್ಕ ಪಟ್ಟಣ. ಅದರಲ್ಲಿ ಸ್ವಲ್ಪ ಜನರು ಇದ್ದರು. ಒಬ್ಬ ದೊಡ್ಡ ಅರಸನು ಅದಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ಬಂದು ಮುತ್ತಿಗೆ ಹಾಕಿ ಅಲ್ಲಿ ದೊಡ್ಡ ದಿಬ್ಬಗಳನ್ನು ಹಾಕಿದನು. <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>ಆಗ ಅಲ್ಲಿದ್ದವರು ತಮ್ಮಲ್ಲಿ ಒಬ್ಬ ಬಡ ಜ್ಞಾನಿಯನ್ನು ಕಂಡುಕೊಂಡರು. ಅವನು ತನ್ನ ಜ್ಞಾನದಿಂದಲೇ ಆ ಪಟ್ಟಣವನ್ನು ರಕ್ಷಿಸಿದನು. ಆದರೆ ಆ ಬಡ ಜ್ಞಾನಿಯನ್ನು ಯಾರೂ ಸ್ಮರಿಸಲಿಲ್ಲ.<verse eid="ECC 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 9:16"/>ನಾನು ಇದನ್ನು ನೋಡಿ ಬಲಕ್ಕಿಂತ ಜ್ಞಾನವೇ ಶ್ರೇಷ್ಠ, ಆದರೆ ಜನರು ಬಡವನ ಜ್ಞಾನವನ್ನು ತಾತ್ಸಾರ ಮಾಡಿ ಅವನ ಮಾತುಗಳನ್ನು ಗಮನಿಸುವುದಿಲ್ಲ ಅಂದುಕೊಂಡೆನು.<verse eid="ECC 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17"/>ಹುಚ್ಚರನ್ನು ಆಳುವವನ ಕೂಗಿಗಿಂತ ಜ್ಞಾನಿಯ</para>
  <para style="q2" vid="ECC 9:17">ಮೆಲ್ಲನೆಯ ಮಾತುಗಳು ಕಿವಿಗೆ ಕೇಳಿಸುತ್ತದೆ.<verse eid="ECC 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18"/>ಯುದ್ಧದ ಆಯುಧಗಳಿಗಿಂತಲೂ ಜ್ಞಾನವೇ ಉತ್ತಮ.</para>
  <para style="q2" vid="ECC 9:18">ಆದರೆ ಒಬ್ಬ ಪಾಪಿಯು ಬಹಳ ಶುಭವನ್ನು ಹಾಳುಮಾಡುತ್ತಾನೆ.<verse eid="ECC 9:18"/></para>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1"/>ಸತ್ತ ನೊಣಗಳಿಂದ ಗಂಧದತೈಲವು ಕೊಳೆತು ನಾರುವುದು.</para>
  <para style="q2" vid="ECC 10:1">ಹಾಗೆಯೇ ಸ್ವಲ್ಪ ಹುಚ್ಚುತನವು ಜ್ಞಾನ ಮತ್ತು ಘನತೆಗಳನ್ನು ಕೆಡಿಸುತ್ತದೆ.<verse eid="ECC 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2"/>ಜ್ಞಾನಿಯ ಬುದ್ಧಿಯು ಅವನ ಬಲಗಡೆಯಿರುವುದು.</para>
  <para style="q2" vid="ECC 10:2">ಅಜ್ಞಾನಿಯ ಬುದ್ಧಿಯು ಅವನ ಎಡಗಡೆಯಿರುವುದು.<verse eid="ECC 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3"/>ಇದಲ್ಲದೆ ಹುಚ್ಚನು ಬುದ್ಧಿತಪ್ಪಿ ತಿರುಗುವ</para>
  <para style="q2" vid="ECC 10:3">ದಾರಿಯಲ್ಲಿ ತನ್ನ ಹುಚ್ಚುತನವನ್ನು</para>
  <para style="q3" vid="ECC 10:3">ಎಲ್ಲರಿಗೆ ಪ್ರಕಟಮಾಡುವನು.<verse eid="ECC 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4"/>ದೊರೆಯು ನಿನ್ನ ಮೇಲೆ ಸಿಟ್ಟುಗೊಂಡರೆ ಉದ್ಯೋಗವನ್ನು ಬಿಡಬೇಡ.</para>
  <para style="q2" vid="ECC 10:4">ತಾಳ್ಮೆಯು ದೊಡ್ಡ ಸಿಟ್ಟನ್ನು ಅಡಗಿಸುತ್ತದೆ.<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">ತಾಳ್ಮೆಯು ದೊಡ್ಡ ಸಿಟ್ಟನ್ನು ಅಡಗಿಸುತ್ತದೆ </char><char style="ft" closed="false">ಅಥವಾ ನೀನು ಶಾಂತನಾಗಿರುವಾಗ ದೊಡ್ಡ ದೋಷಗಳು ಕ್ಷಮಿಸಲ್ಪಡುತ್ತವೆ ಅಥವಾ ನಿನ್ನ ದೋಷಗಳನ್ನು ಅವನಿಗೆ ಒಪ್ಪಿಸಿಕೊಡು.</char></note><verse eid="ECC 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5"/>ಲೋಕದಲ್ಲಿ ಒಂದು ಸಂಕಟವನ್ನು ಕಂಡಿದ್ದೇನೆ.</para>
  <para style="q2" vid="ECC 10:5">ಅದು ಆಳುವವನ ಸಮ್ಮುಖದಿಂದ ಹೊರಟುಬರುವ ಹಾಗೆಯೇ ತೋರುತ್ತದೆ.<verse eid="ECC 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6"/>ಮೂಢರಿಗೆ ಮಹಾ ಪದವಿ ದೊರೆಯುವುದು.</para>
  <para style="q2" vid="ECC 10:6">ಘನವಂತರೂ ಹೀನಸ್ಥಿತಿಯಲ್ಲಿರುವರು.<verse eid="ECC 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7"/>ಆಳುಗಳು ಕುದುರೆ ಸವಾರಿ ಮಾಡುವುದನ್ನೂ,</para>
  <para style="q2" vid="ECC 10:7">ಪ್ರಭುಗಳು ಆಳುಗಳಂತೆ ನೆಲದ ಮೇಲೆ ನಡೆಯುವುದನ್ನೂ ನೋಡಿದ್ದೇನೆ.<verse eid="ECC 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8"/>ಗುಂಡಿಯನ್ನು ತೋಡುವವನು</para>
  <para style="q2" vid="ECC 10:8">ತಾನೇ ಅದರಲ್ಲಿ ಬೀಳುವನು, ಗೋಡೆಯನ್ನು ಒಡೆಯುವವನಿಗೆ,</para>
  <para style="q2" vid="ECC 10:8">ಹಾವು ಕಚ್ಚುವುದು.<verse eid="ECC 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9"/>ಯಾವನು ಕಲ್ಲುಗಳನ್ನು ಕೀಳುವನೋ</para>
  <para style="q2" vid="ECC 10:9">ಅವನಿಗೆ ಹಾನಿ ಆಗುವುದು.</para>
  <para style="q1" vid="ECC 10:9">ಮರವನ್ನು ಕಡೆಯುವವನಿಗೆ</para>
  <para style="q2" vid="ECC 10:9">ಅಪಾಯವಿದೆ.<verse eid="ECC 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10"/>ಮೊಂಡು ಕೊಡಲಿಯ ಬಾಯಿಯನ್ನು ಮಸೆಯದಿದ್ದರೆ ಅವನು ಹೆಚ್ಚು ಬಲವನ್ನು ಪ್ರಯೋಗಿಸಬೇಕು. ಕಾರ್ಯಸಿದ್ಧಿಗೆ ಜ್ಞಾನವೇ ಸಾಧನ.<verse eid="ECC 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11"/>ಹಾವಾಡಿಸುವುದರೊಳಗೆ ಹಾವು ಕಚ್ಚಿದರೆ,</para>
  <para style="q2" vid="ECC 10:11">ಹಾವಾಡಿಗನಿಗೆ ಯಾವ ಪ್ರಯೋಜನವೂ ಇಲ್ಲ.<verse eid="ECC 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12"/>ಜ್ಞಾನಿಯ ಮಾತು ಹಿತ.</para>
  <para style="q2" vid="ECC 10:12">ಅಜ್ಞಾನಿಯ ಬಾಯಿ ತನ್ನನ್ನೇ ನುಂಗಿಬಿಡುವುದು.<verse eid="ECC 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13"/>ಅಜ್ಞಾನಿಯ ಮಾತುಗಳು ಆರಂಭದಲ್ಲಿ ಬುದ್ಧಿಹೀನತೆ,</para>
  <para style="q2" vid="ECC 10:13">ಅಂತ್ಯದಲ್ಲಿ ಅಪಾಯದ ಮರಳುತನ.<verse eid="ECC 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 10:14"/>ಮನುಷ್ಯನು ಮುಂದೆ ಆಗುವುದನ್ನು ತಿಳಿಯನು.</para>
  <para style="q2" vid="ECC 10:14">ತಾನು ಕಾಲವಾದ ಮೇಲೆ ಹೀಗೆಯೇ ಆಗುವುದೆಂದು ಅವನು ಯಾರಿಂದ ತಿಳಿದುಕೊಂಡಾನು?</para>
  <para style="q2" vid="ECC 10:14">ಅಜ್ಞಾನಿಯ ಮಾತುಗಳೋ ಬಹಳ.<verse eid="ECC 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15"/>ಪಟ್ಟಣದ ದಾರಿ ತಿಳಿಯದವನಿಗೆ ಮೂಢರು ತಿಳಿಸಲು,</para>
  <para style="q2" vid="ECC 10:15">ಪಡುವ ಪ್ರಯಾಸದಿಂದ ಆಯಾಸವೇ.<verse eid="ECC 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16"/>ದೇಶದ ಅರಸನು ಯುವಕನಾಗಿದ್ದರೆ,<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="fq" closed="false">ಯುವಕನಾಗಿದ್ದರೆ, </char><char style="ft" closed="false">ಅಥವಾ ಸೇವಕನಾಗಿದ್ದರೆ.</char></note></para>
  <para style="q2" vid="ECC 10:16">ಪ್ರಭುಗಳು ಹೊತ್ತಾರೆ ಔತಣಕ್ಕೆ ಕುಳಿತುಕೊಂಡರೆ ನಿನಗೆ ದೌರ್ಭಾಗ್ಯವೇ!<verse eid="ECC 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17"/>ದೇಶದ ಅರಸನು ಕುಲೀನನಾಗಿದ್ದರೆ,</para>
  <para style="q2" vid="ECC 10:17">ಪ್ರಭುಗಳು ಅಮಲಿಗಾಗಿ ಅಲ್ಲ,</para>
  <para style="q2" vid="ECC 10:17">ಆದರೆ ಶಕ್ತಿಗಾಗಿ ಸಕಾಲದಲ್ಲಿ ಊಟಕ್ಕೆ ಕುಳಿತರೆ</para>
  <para style="q2" vid="ECC 10:17">ನಿನಗೆ ಭಾಗ್ಯವೇ!<verse eid="ECC 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18"/>ಸೋಮಾರಿತನದಿಂದ ತೊಲೆಗಳು ಬೊಗ್ಗುವವು.</para>
  <para style="q2" vid="ECC 10:18">ಜೋಲುಗೈಯಿಂದ ಮನೆ ಸೋರುವುದು.<verse eid="ECC 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19"/>ನಗುವಿಗಾಗಿ ಔತಣವು,</para>
  <para style="q2" vid="ECC 10:19">ದ್ರಾಕ್ಷಾರಸದಿಂದ ಜೀವನಕ್ಕೆ ಆನಂದವು,</para>
  <para style="q3" vid="ECC 10:19">ಧನವು ಎಲ್ಲವನ್ನೂ ಒದಗಿಸಿಕೊಡುವುದು.<verse eid="ECC 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20"/>ಮನಸ್ಸಿನಲ್ಲಿಯೂ ಅರಸನನ್ನು ದೂಷಿಸದಿರು.</para>
  <para style="q2" vid="ECC 10:20">ಮಲಗುವ ಕೋಣೆಯಲ್ಲಿಯೂ ಧನಿಕನನ್ನು ಬಯ್ಯದಿರು.</para>
  <para style="q1" vid="ECC 10:20">ಆಕಾಶದ ಹಕ್ಕಿಯು ಆ ಶಬ್ದವನ್ನು ಮುಟ್ಟಿಸುವವು;</para>
  <para style="q2" vid="ECC 10:20">ಪಕ್ಷಿಯು ಆ ವಿಷಯವನ್ನು ತಿಳಿಸುವುದು.<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s">ನೀರಿನ ಮೇಲೆ ರೊಟ್ಟಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1"/>ನಿನ್ನ ಆಹಾರವನ್ನು ನೀರಿನ ಮೇಲೆ ಚೆಲ್ಲು,</para>
  <para style="q2" vid="ECC 11:1">ಬಹಳ ದಿನಗಳ ನಂತರ ಅದು ನಿನಗೆ ಸಿಕ್ಕುವುದು.<verse eid="ECC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2"/>ನೀನು ಅದನ್ನು ಏಳು ಮತ್ತು ಎಂಟು ಮಂದಿಗೆ ಹಂಚಿಬಿಡು.</para>
  <para style="q2" vid="ECC 11:2">ಲೋಕದಲ್ಲಿ ಮುಂದೆ ಸಂಭವಿಸುವ ಕೇಡು ನಿನಗೆ ಗೊತ್ತಿಲ್ಲ.<verse eid="ECC 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3"/>ಮಳೆ ತುಂಬಿದ ಮೋಡಗಳು,</para>
  <para style="q2" vid="ECC 11:3">ತಾವಾಗಿಯೇ ಭೂಮಿಯ ಮೇಲೆ ಸುರಿದುಬಿಡುವವು,</para>
  <para style="q1" vid="ECC 11:3">ಮರವು ಉತ್ತರಕ್ಕಾಗಲಿ, ದಕ್ಷಿಣಕ್ಕಾಗಲಿ,</para>
  <para style="q2" vid="ECC 11:3">ಬಿದ್ದರೆ ಬಿದ್ದ ಸ್ಥಳದಲ್ಲಿಯೇ ಇರುವುದು.<verse eid="ECC 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4"/>ಗಾಳಿಯನ್ನು ನೋಡುತ್ತಲೇ ಇರುವವನು ಬೀಜವನ್ನು ಬಿತ್ತುವುದಿಲ್ಲ,</para>
  <para style="q2" vid="ECC 11:4">ಮೋಡಗಳನ್ನು ಗಮನಿಸುತ್ತಲೇ ಇರುವವನು ಪೈರನ್ನು ಕೊಯ್ಯುವುದಿಲ್ಲ.<verse eid="ECC 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5"/>ಗಾಳಿಯ ಮಾರ್ಗವನ್ನೂ,</para>
  <para style="q2" vid="ECC 11:5">ಗರ್ಭಿಣಿಯ ಗರ್ಭದಲ್ಲಿ ಎಲುಬುಗಳು ಬೆಳೆಯುವ ರೀತಿಯನ್ನೂ,</para>
  <para style="q1" vid="ECC 11:5">ನೀನು ಹೇಗೆ ತಿಳಿಯುವುದಿಲ್ಲವೋ ಹಾಗೆಯೇ,</para>
  <para style="q2" vid="ECC 11:5">ಸರ್ವಶಕ್ತನಾದ ದೇವರ ಕಾರ್ಯವನ್ನು ಅರಿಯುವುದಿಲ್ಲ.<verse eid="ECC 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6"/>ಮುಂಜಾನೆ ಬೀಜ ಬಿತ್ತು;</para>
  <para style="q2" vid="ECC 11:6">ಸಂಜೆಯ ತನಕ ಕೈಯನ್ನು ಹಿಂದಕ್ಕೆ ತೆಗೆಯಬೇಡ,</para>
  <para style="q1" vid="ECC 11:6">ಇದು ಸಫಲವಾಗುವುದೋ ಅಥವಾ ಅದು ಸಫಲವಾಗುವುದೋ,</para>
  <para style="q2" vid="ECC 11:6">ಇಲ್ಲವೇ ಒಂದು ವೇಳೆ ಎರಡೂ</para>
  <para style="q2" vid="ECC 11:6">ಒಳ್ಳೆಯದಾಗುವುದೋ ನಿನಗೆ ತಿಳಿಯದು.<verse eid="ECC 11:6"/></para>
  <para style="s">ಯೌವನದಲ್ಲಿ ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಸ್ಮರಿಸು</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7"/>ನಿಜವಾಗಿ ಬೆಳಕು ಇಂಪಾಗಿಯೂ,</para>
  <para style="q2" vid="ECC 11:7">ಮತ್ತು ಸೂರ್ಯನನ್ನು ಕಾಣುವುದು ಕಣ್ಣಿಗೆ ಹಿತವಾಗಿಯೂ ಇರುವುದು.<verse eid="ECC 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8"/>ಬಹಳ ವರ್ಷ ಬದುಕುವವನು,</para>
  <para style="q2" vid="ECC 11:8">ಅವುಗಳಲ್ಲೆಲ್ಲಾ ಆನಂದಿಸಲಿ,</para>
  <para style="q1" vid="ECC 11:8">ಆದರೆ ಅಂಧಕಾರದ ದಿನಗಳನ್ನು ನೆನಪಿಗೆ ತರಲಿ,</para>
  <para style="q2" vid="ECC 11:8">ಏಕೆಂದರೆ ಅವು ಬಹಳವಾಗಿರುವವು.</para>
  <para style="q1" vid="ECC 11:8">ಮುಂದಾಗುವುದೆಲ್ಲ ವ್ಯರ್ಥವೇ.<verse eid="ECC 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9"/>ಯೌವನಸ್ಥನೇ, ಯೌವನಪ್ರಾಯದಲ್ಲಿ ಆನಂದಿಸು,</para>
  <para style="q2" vid="ECC 11:9">ಯೌವನದ ದಿನಗಳಲ್ಲಿ ಹೃದಯವು ನಿನ್ನನ್ನು ಹರ್ಷಗೊಳಿಸಲಿ.</para>
  <para style="q1" vid="ECC 11:9">ಮನಸ್ಸಿಗೆ ತಕ್ಕಂತೆಯೂ,</para>
  <para style="q2" vid="ECC 11:9">ಕಣ್ಣಿಗೆ ಸರಿಬೀಳುವ ಹಾಗೆಯೂ ನಡೆದುಕೋ.</para>
  <para style="q1" vid="ECC 11:9">ಆದರೆ ಈ ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿಯೂ ದೇವರು ನಿನ್ನನ್ನು ನ್ಯಾಯವಿಚಾರಣೆಗೆ ಗುರಿಮಾಡುವನೆಂದು ತಿಳಿದಿರು.<verse eid="ECC 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10"/>ನಿನ್ನ ಹೃದಯದಿಂದ ದುಃಖವನ್ನೂ,</para>
  <para style="q2" vid="ECC 11:10">ದೇಹದಿಂದ ಶ್ರಮೆಯನ್ನೂ ತೊಲಗಿಸು,</para>
  <para style="q1" vid="ECC 11:10">ಏಕೆಂದರೆ ಬಾಲ್ಯವೂ, ಯೌವನವೂ ವ್ಯರ್ಥವಷ್ಟೆ.<verse eid="ECC 11:10"/></para>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1"/>ಕಷ್ಟದ ದಿನಗಳು ಬರುವುದಕ್ಕೆ ಮೊದಲು,</para>
  <para style="q2" vid="ECC 12:1">“ಇವುಗಳಲ್ಲಿ ನನಗೆ ಸಂತೋಷವಿಲ್ಲ” ಎಂದು,</para>
  <para style="q2" vid="ECC 12:1">ನೀನು ಹೇಳುವ ವರ್ಷಗಳು ಸಮೀಪಿಸುವುದರೊಳಗಾಗಿ,</para>
  <para style="q3" vid="ECC 12:1">ಯೌವನದಲ್ಲಿಯೇ ನಿನ್ನ ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಸ್ಮರಿಸು.<verse eid="ECC 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2"/>ಸೂರ್ಯನೂ, ಚಂದ್ರನೂ ಮತ್ತು ನಕ್ಷತ್ರಗಳೂ ಕತ್ತಲಾಗುವ ಮೊದಲೇ,</para>
  <para style="q2" vid="ECC 12:2">ಮಳೆಯ ಮೋಡಗಳು ಹಿಂತಿರುಗಿ ಬರುವವು.<verse eid="ECC 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:3 </char>
      <char style="ft" closed="false">ಇಲ್ಲಿ ಮನೆ ಮಾನವ ಶಾರೀರಿಕ ದೇಹವೆಂಬ, ಗಾವಲಿನವರು ಕೈಗಳೆಂಬ, ಬಲಿಷ್ಠರು ಕಾಲುಗಳೆಂಬ, ಅರೆಯುವವರು ಹಲ್ಲುಗಳೆಂಬ, ಮತ್ತು ನೋಡುವವರು ಕಣ್ಣುಗಳೆಂಬ ಅರ್ಥವನ್ನು ನೀಡುತ್ತದೆ. ಈ ಉದಾಹರಣೆಗಳು ಮರಣದ ಅರ್ಥವನ್ನು ಸಹ ತೋರಿಸುತ್ತವೆ ಎಂದು ಕೆಲವು ಪಂಡಿತರು ಹೇಳುತ್ತಾರೆ.</char>
    </note>ಅದೇ ಕಾಲದಲ್ಲಿ ಮನೆಗಾವಲಿನವರು ನಡುಗುವರು,</para>
  <para style="q2" vid="ECC 12:3">ಬಲಿಷ್ಠರು ಬಗ್ಗುವರು,</para>
  <para style="q1" vid="ECC 12:3">ಅರೆಯುವವರು ಕಡಿಮೆ ಜನರಿರುವುದರಿಂದ ಕೆಲಸವನ್ನು ನಿಲ್ಲಿಸಿಬಿಡುವರು,</para>
  <para style="q2" vid="ECC 12:3">ಕಿಟಕಿಗಳಿಂದ ನೋಡುವವರು ಮಂಕಾಗುವರು.<verse eid="ECC 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4"/>ಬೀದಿಯ ಬಾಗಿಲುಗಳು ಮುಚ್ಚಿರುವವು,</para>
  <para style="q2" vid="ECC 12:4">ಅರೆಯುವ ಶಬ್ದವು ನಿಲ್ಲುವುದು,</para>
  <para style="q1" vid="ECC 12:4">ಮನುಷ್ಯನು ಹಕ್ಕಿಯ ಧ್ವನಿಗೆ ಎದ್ದೇಳುವನು,</para>
  <para style="q2" vid="ECC 12:4">ಗಾಯಕಿಯರೆಲ್ಲಾ ಕುಗ್ಗುವರು.<verse eid="ECC 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5"/>ಇದಲ್ಲದೆ ಆ ದಿನಗಳಲ್ಲಿ ಮನುಷ್ಯನಿಗೆ ದಿನ್ನೆಯನ್ನು ಕಂಡರೆ ಭಯ,</para>
  <para style="q2" vid="ECC 12:5">ಮತ್ತು ದಾರಿಯಲ್ಲಿ ಅಪಾಯ,</para>
  <para style="q1" vid="ECC 12:5">ಬಾದಾಮಿಯ ಮರವು ಹೂ ಬಿಡುವುದು,</para>
  <para style="q2" vid="ECC 12:5">ಮಿಡತೆಯು ಕೂಡಾ ಭಾರವಾಗಿರುವುದು,</para>
  <para style="q2" vid="ECC 12:5">ಆಶೆಯು ಕುಂದುವುದು.</para>
  <para style="q1" vid="ECC 12:5">ಮನುಷ್ಯನು ತನ್ನ ನಿತ್ಯ ಗೃಹಕ್ಕೆ ಹೊರಡುವನು,</para>
  <para style="q2" vid="ECC 12:5">ಗೋಳಾಟದವರು ಬೀದಿಯಲ್ಲಿ ತಿರುಗುವರು.<verse eid="ECC 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6"/>ಇನ್ನು ಮುಂದೆ ಬೆಳ್ಳಿಯ ತಂತಿಯು ಕಿತ್ತುಹೋಗುವುದು,</para>
  <para style="q2" vid="ECC 12:6">ಚಿನ್ನದ ಬಟ್ಟಲು ಜಜ್ಜಿಹೋಗುವುದು,</para>
  <para style="q2" vid="ECC 12:6">ಮಡಿಕೆಯು ಬುಗ್ಗೆಯ ಹತ್ತಿರ ಒಡೆಯುವುದು,</para>
  <para style="q2" vid="ECC 12:6">ಬಾವಿಯ ರಾಟೆ ಮುರಿಯುವುದು,<verse eid="ECC 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7"/>ಮಣ್ಣು ಭೂಮಿಗೆ ಸೇರಿ ಇದ್ದ ಹಾಗಾಗುವುದು,</para>
  <para style="q2" vid="ECC 12:7">ಆತ್ಮವು ತನ್ನನ್ನು ದಯಪಾಲಿಸಿದ ದೇವರ ಬಳಿಗೆ ಸೇರುವುದು. ಇಷ್ಟರೊಳಗಾಗಿ ನಿನ್ನ ಸೃಷ್ಟಿ ಕರ್ತನನ್ನು ಸ್ಮರಿಸದಿರಬೇಡ.<verse eid="ECC 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8"/>“ವ್ಯರ್ಥವೇ ವ್ಯರ್ಥ, ಸಮಸ್ತವೂ ವ್ಯರ್ಥ” ಎಂದು ಪ್ರಸಂಗಿಯು ಹೇಳುತ್ತಾನೆ.<verse eid="ECC 12:8"/></para>
  <para style="s">ಸಮಾಪ್ತಿ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>ಪ್ರಸಂಗಿಯು ಜ್ಞಾನಿಯಾಗಿದ್ದು, ಜನರಿಗೆ ತಿಳಿವಳಿಕೆಯನ್ನು ಬೋಧಿಸುತ್ತಾ ಬಂದನು, ಅನೇಕಾನೇಕ ಜ್ಞಾನೋಕ್ತಿಗಳನ್ನು ಧ್ಯಾನಿಸಿ, ಪರೀಕ್ಷಿಸಿ ಕ್ರಮಪಡಿಸಿದನು.<verse eid="ECC 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 12:10"/>ಪ್ರಸಂಗಿಯು ಯಥಾರ್ಥ ಭಾವದಿಂದ ರಚಿಸಿದ ಒಪ್ಪಿಗೆಯ ಸತ್ಯದ ಮಾತುಗಳನ್ನು ಹುಡುಕಿ ಆರಿಸಿದನು. <verse eid="ECC 12:10"/><verse number="11" style="v" sid="ECC 12:11"/>ಜ್ಞಾನಿಗಳ ಮಾತುಗಳು ಮುಳ್ಳುಗೋಲುಗಳು, ಸಂಗ್ರಹ ವಾಕ್ಯಗಳು ಬಿಗಿಯಾಗಿ ಬಡಿದ ಮೊಳೆಗಳು ಇವೆರಡು ಒಬ್ಬನೇ ಕುರುಬನಿಂದ ಕೊಡಲ್ಪಟ್ಟಿದೆ.<verse eid="ECC 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12"/>ನನ್ನ ಕಂದಾ, ಇವುಗಳಲ್ಲದೆ ಉಳಿದವುಗಳಲ್ಲಿಯೂ ಎಚ್ಚರದಿಂದಿರು. ಬಹಳ ಗ್ರಂಥಗಳ ರಚನೆಗೆ ಮಿತಿಯಿಲ್ಲ. ಅತಿವ್ಯಾಸಂಗವು ದೇಹಕ್ಕೆ ಆಯಾಸ.<verse eid="ECC 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13"/>ವಿಷಯವು ತೀರಿತು,</para>
  <para style="q2" vid="ECC 12:13">ಎಲ್ಲವೂ ಕೇಳಿ ಮುಗಿಯಿತು,</para>
  <para style="q1" vid="ECC 12:13">ದೇವರಿಗೆ ಭಯಪಟ್ಟು ಆತನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಕೊಳ್ಳು,</para>
  <para style="q2" vid="ECC 12:13">ಮನುಷ್ಯರೆಲ್ಲರ ಕರ್ತವ್ಯವು ಇದೇ.<verse eid="ECC 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14"/>ಒಳ್ಳೆಯದಾಗಲೀ ಅಥವಾ ಕೆಟ್ಟದ್ದಾಗಲೀ,</para>
  <para style="q2" vid="ECC 12:14">ಸಕಲ ರಹಸ್ಯ ಸಂಗತಿಗಳನ್ನು ವಿಮರ್ಶಿಸಿ,</para>
  <para style="q1" vid="ECC 12:14">ನ್ಯಾಯವಿಚಾರಣೆಗೆ ದೇವರು ಪ್ರತಿಯೊಂದು ಕಾರ್ಯವನ್ನು ಗುರಿಮಾಡುವನು.<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
