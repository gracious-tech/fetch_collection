<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">RRK29.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">YOELI</para>
  <para style="toc1">Ekitabo Kya Nabi Yoeli</para>
  <para style="toc2">Yoeli</para>
  <para style="toc3">Yoel</para>
  <para style="mt2">EKITABO KYA NABI</para>
  <para style="mt1">YOELI</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="s1">Yoeli okugamba aha nzigye ezaateire ensi</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Eki n'ekigambo kya MUKAMA ekyaizire ahari Yoeli mwene Pesueli.<verse eid="JOL 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:2">Yoel 2:2</ref>. </char>
    </note> Imwe bagurusi 'mwe, nimuhurire eki;</para>
  <para style="q1" vid="JOL 1:2">Naimwe mwena abatwire omu nsi, mutegye amatu!</para>
  <para style="q1" vid="JOL 1:2">Ebintu nk'ebi birabaireho omu biro byanyu,</para>
  <para style="q1" vid="JOL 1:2">Nari omu biro bya baashwenkuriimwe?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:4">Zab 78:4</ref>. </char>
    </note> Mubiteekyerereze abaana baanyu,</para>
  <para style="q1" vid="JOL 1:3">Abaana baanyu babiteekyerereze abaabo,</para>
  <para style="q1" vid="JOL 1:3">N'abaabo baryabiteekyerereza abaijukuruza.<verse eid="JOL 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:46">Zab 78:46</ref>; <ref loc="PSA 105:34">105:34</ref>; <ref loc="AMO 4:9">Amo 4:9</ref>; <ref loc="AMO 7:1">7:1</ref>. </char>
    </note> Ebi rushanda etsigire,</para>
  <para style="q1" vid="JOL 1:4">Biriirwe kahembwe.</para>
  <para style="q1" vid="JOL 1:4">Ebi kahembwe etsigire,</para>
  <para style="q1" vid="JOL 1:4">Biriirwe ebitootera;</para>
  <para style="q1" vid="JOL 1:4">Kandi ebi ebitootera bitsigire,</para>
  <para style="q1" vid="JOL 1:4">Biriirwe ikuura.<verse eid="JOL 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 24:11">Isa 24:11</ref>. </char>
    </note> Imwe basinzi 'mwe, nimusisiimukye, murire;</para>
  <para style="q1" vid="JOL 1:5">Imwe mwena abanywi b'amaarwa, muboroogye,</para>
  <para style="q1" vid="JOL 1:5">Ahabw'okuburirwa amaarwa g'omutahe,</para>
  <para style="q1" vid="JOL 1:5">Ahabw'okuba gacwekire, tigarigaruka mu kanwa kaanyu.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="REV 9:8">Kush 9:8</ref>. </char>
    </note> Ahakuba eihanga rihurwire, ryateera ensi yangye,</para>
  <para style="q1" vid="JOL 1:6">Eihanga ry'amaani eritarikubarwa;</para>
  <para style="q1" vid="JOL 1:6">Amaino gaaryo ni nk'ag'entare,</para>
  <para style="q1" vid="JOL 1:6">N'ag'enshongyezo ni nk'ag'entare enkazi.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Rimazireho emizaabibu yangye,</para>
  <para style="q1" vid="JOL 1:7">Ryahenda emitiini yangye,</para>
  <para style="q1" vid="JOL 1:7">Ryagimaraho ebishushu, ryabinaga ahansi;</para>
  <para style="q1" vid="JOL 1:7">Amataagi gaayo gaatsigara nigeera.<verse eid="JOL 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Tonzya nk'omwishiki empangare oyezirikire ekiguniya,</para>
  <para style="q1" vid="JOL 1:8">Orikucurira obaire naayenda kumushwera.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 29:41">Kur 29:41</ref>; <ref loc="EZK 45:4">Ezk 45:4</ref>. </char>
    </note> Empongano z'esaano n'ez'eby'okunywa</para>
  <para style="q1" vid="JOL 1:9">Zicwirwe omu nju ya MUKAMA;</para>
  <para style="q1" vid="JOL 1:9">Abanyamurwa abarikuheereza MUKAMA nibacura.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:10: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 2:9">Hos 2:9</ref>; <ref loc="HOS 4:3">4:3</ref>. </char>
    </note> Emisiri emazirweho, ensi ecuramiriirwe;</para>
  <para style="q1" vid="JOL 1:10">Ahabw'okuba engano zihweireho,</para>
  <para style="q1" vid="JOL 1:10">Viinyo eyomire, kandi amajuta gabuzire.<verse eid="JOL 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:11: </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:4">Yer 14:4</ref>. </char>
    </note> Imwe bahingi 'mwe, nimushoberwe,</para>
  <para style="q1" vid="JOL 1:11">Imwe abasharizi b'emizaabibu, muboroogye,</para>
  <para style="q1" vid="JOL 1:11">Muririre engano na sayiri;</para>
  <para style="q1" vid="JOL 1:11">Ahabw'okuba emyaka y'omu misiri efiire.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:12: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 16:10">Isa 16:10</ref>. </char>
    </note> Omuzaabibu niguhotoka,</para>
  <para style="q1" vid="JOL 1:12">Omutiini nigukabakaba,</para>
  <para style="q1" vid="JOL 1:12">Emikomamahanga, emikindo n'ebiti by'amapeera,</para>
  <para style="q1" vid="JOL 1:12">Nangwa n'ebiti byona eby'omu misiri byomire;</para>
  <para style="q1" vid="JOL 1:12">Kandi okushemererwa kuhweire omu bantu.<verse eid="JOL 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 1:8">Mik 1:8</ref>. </char>
    </note> Imwe banyamurwa 'mwe, nimwezirikye ebiguniya, mutonzye;</para>
  <para style="q1" vid="JOL 1:13">Naimwe abahereza aha itambiro, muboroogye!</para>
  <para style="q1" vid="JOL 1:13">Imwe baheereza ba Ruhanga wangye 'mwe,</para>
  <para style="q1" vid="JOL 1:13">Nimwije museese ekiro mujwaire ebiguniya;</para>
  <para style="q1" vid="JOL 1:13">Ahabw'okuba empongano z'esaano n'ez'eby'okunywa</para>
  <para style="q1" vid="JOL 1:13">Zicwirwe omu nju ya Ruhanga waanyu.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:14: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 20:3">2 Bus 20:3</ref>. </char>
    </note> Mweze eizooba ry'okwesiibyakwo,</para>
  <para style="q1" vid="JOL 1:14">Mwetere abantu okuteerana okurikwera.</para>
  <para style="q1" vid="JOL 1:14">Muteeranire hamwe abakuru</para>
  <para style="q1" vid="JOL 1:14">N'abatwire omu nsi egi boona,</para>
  <para style="q1" vid="JOL 1:14">Baije omu nju ya MUKAMA Ruhanga waanyu,</para>
  <para style="q1" vid="JOL 1:14">Mumutakire.<verse eid="JOL 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:6">Isa 13:6</ref>; <ref loc="JER 46:10">Yer 46:10</ref>; <ref loc="JOL 2:1">Yoel 2:1</ref>, <ref loc="JOL 2:11">11</ref>, <ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:14">3:14</ref>; <ref loc="OBA 1:15">Oba 15</ref>; <ref loc="ZEC 14:1">Zek 14:1</ref>; <ref loc="2PE 3:10">2 Pet 3:10</ref>. </char>
    </note> Ai bambe!</para>
  <para style="q1" vid="JOL 1:15">Ahabw'okuba eizooba rya MUKAMA riri haihi,</para>
  <para style="q1" vid="JOL 1:15">Niriija riri nk'okucwekyereza okurikuruga aha W'obushoboorozi bwona.<verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:16: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 12:6">Bir 12:6</ref>, <ref loc="DEU 12:7">7</ref>. </char>
    </note> Beitu eby'okurya tibituhweireho nitubireeba,</para>
  <para style="q1" vid="JOL 1:16">Okushemererwa n'okwesiima bikahwa omu nju ya Ruhanga waitu?<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Embibo zigwire omu itaka</para>
  <para style="q1" vid="JOL 1:17">Ebitara n'emirangara,</para>
  <para style="q1" vid="JOL 1:17">Amabiikiro gasheenyukire ahabw'okubura engano.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18: </char>
      <char style="xt" closed="false">
        <ref loc="JER 12:4">Yer 12:4</ref>; <ref loc="HOS 4:3">Hos 4:3</ref>. </char>
    </note> Amatungo nigaboroogyerana!</para>
  <para style="q1" vid="JOL 1:18">Amasyo g'ente gashobeirwe ahabw'okubura obunyaatsi;</para>
  <para style="q1" vid="JOL 1:18">Nangwa n'amasyo g'entaama gaburaburiirwe.<verse eid="JOL 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:15">Zab 50:15</ref>; <ref loc="JER 9:10">Yer 9:10</ref>. </char>
    </note> Ai MUKAMA, niiwe ndikutakira.</para>
  <para style="q1" vid="JOL 1:19">Ahabw'okuba omuriro gumazireho</para>
  <para style="q1" vid="JOL 1:19">Amariisizo g'omu ihamba,</para>
  <para style="q1" vid="JOL 1:19">N'endimi zaagwo zookize ebiti byona eby'omu ishwa.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:21">Zab 104:21</ref>. </char>
    </note> Nangwa n'enyamaishwa z'omu ishwa nizikutakira,</para>
  <para style="q1" vid="JOL 1:20">Ahabw'okuba otugyera twomire,</para>
  <para style="q1" vid="JOL 1:20">Kandi omuriro gumazireho amariisizo g'omu ihamba.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Ekibonaboneso ky'okuteerwa enzigye</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:15">Yoel 1:15</ref>; <ref loc="JOL 2:15">2:15</ref>. </char>
    </note> Muteerere enzamba omuri Saayuuni;</para>
  <para style="q1" vid="JOL 2:1">Muteerere enduuru aha rushozi rwangye orurikwera!</para>
  <para style="q1" vid="JOL 2:1">K'abatwire omu nsi boona bateteme,</para>
  <para style="q1" vid="JOL 2:1">Ahabw'okuba eizooba rya MUKAMA, niriija, riri haihi,<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:2: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 30:3">Ezk 30:3</ref>; <ref loc="AMO 5:18">Amo 5:18</ref>, <ref loc="AMO 5:20">20</ref>; <ref loc="ZEP 1:15">Zef 1:15</ref>. </char>
    </note> Eizooba ry'omwirima n'ekibunda,</para>
  <para style="q1" vid="JOL 2:2">Eizooba ry'ebicu n'omwirima ndindindi!</para>
  <para style="q1" vid="JOL 2:2">Eihanga rihango kandi ery'amaani rishwekire ebibungo nk'omwirima;</para>
  <para style="q1" vid="JOL 2:2">Okwiha iranaira enzigye ezirikushusha zityo tizikabahoga,</para>
  <para style="q1" vid="JOL 2:2">Kandi na bwanyima yaazo tizirigaruka kubaho</para>
  <para style="q1" vid="JOL 2:2">Nangwa n'omu myaka yoona ey'obusingye oburikurataho.<verse eid="JOL 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:3: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:19">Yoel 1:19</ref>, <ref loc="JOL 1:20">20</ref>; <ref loc="GEN 2:8">Kut 2:8</ref>, <ref loc="GEN 2:9">9</ref>; <ref loc="ISA 51:3">Isa 51:3</ref>; <ref loc="ZEC 7:14">Zek 7:14</ref>. </char>
    </note> Omuriro nigurya busha omu maisho gaazo,</para>
  <para style="q1" vid="JOL 2:3">Kandi enyima yaazo endimi z'omuriro nizibuguma.</para>
  <para style="q1" vid="JOL 2:3">Omu maisho gaazo ensi neeshusha nk'ekibanja kya Edeni,</para>
  <para style="q1" vid="JOL 2:3">Kwonka enyima yaazo n'eihamba eririmu busha;</para>
  <para style="q1" vid="JOL 2:3">Tihaine kintu kyona ekirikuzikira.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:4: </char>
      <char style="xt" closed="false">
        <ref loc="REV 9:7">Kush 9:7</ref>, <ref loc="REV 9:9">9</ref>. </char>
    </note> Emisusire yaazo ni nk'ey'embaraasi,</para>
  <para style="q1" vid="JOL 2:4">Kandi niziiruka nk'embaraasi z'orugamba.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:24">Isa 5:24</ref>; <ref loc="OBA 1:18">Oba 18</ref>. </char>
    </note> Niziguruka aha mitwe y'ebibungo,</para>
  <para style="q1" vid="JOL 2:5">Nizihoorera nk'ebigaari by'orugamba,</para>
  <para style="q1" vid="JOL 2:5">Nk'okubarabaruka kw'omuriro ogurikwotsya embuba,</para>
  <para style="q1" vid="JOL 2:5">Nk'eihe ry'amaani eritengire orugamba.<verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="NAM 2:10">Nah 2:10</ref>. </char>
    </note> Omu maisho gaazo abantu baine obusaasi;</para>
  <para style="q1" vid="JOL 2:6">Ahamaisho ga boona hahinduriize.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Niziteera nk'abarwani,</para>
  <para style="q1" vid="JOL 2:7">Nizitemba engo z'amabaare nk'engabo,</para>
  <para style="q1" vid="JOL 2:7">Buri rumwe nirugyenda ruturumbwize;</para>
  <para style="q1" vid="JOL 2:7">Tizirikushiisha mishorongo.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:27">Enf 30:27</ref>. </char>
    </note> Tizirikubandana,</para>
  <para style="q1" vid="JOL 2:8">Buri rumwe nirugyenda omu muhanda gwarwo,</para>
  <para style="q1" vid="JOL 2:8">Nizitwarana ziraba omu macumu,</para>
  <para style="q1" vid="JOL 2:8">Kandi tizikwemerezibwa.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 33:4">Isa 33:4</ref>; <ref loc="JHN 10:1">Yoh 10:1</ref>. </char>
    </note> Niziguruka, zigwa aha rurembo,</para>
  <para style="q1" vid="JOL 2:9">Ziirukira aha ngo z'amabaare;</para>
  <para style="q1" vid="JOL 2:9">Zitemba, zitaaha omu maju,</para>
  <para style="q1" vid="JOL 2:9">Ziraba omu madirisa nk'abashuma.<verse eid="JOL 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 3:15">Yoel 3:15</ref>, <ref loc="JOL 3:16">16</ref>; <ref loc="PSA 18:7">Zab 18:7</ref>; <ref loc="ISA 13:10">Isa 13:10</ref>. </char>
    </note> Ensi neezitengyetera omu maisho,</para>
  <para style="q1" vid="JOL 2:10">N'eiguru naryo niritengyeta.</para>
  <para style="q1" vid="JOL 2:10">Eizooba n'okwezi bishwekwa omwirima,</para>
  <para style="q1" vid="JOL 2:10">N'enyonyoozi zireka kwaka.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:25">Yoel 2:25</ref>, <ref loc="JOL 2:31">31</ref>; <ref loc="MAL 3:2">Mal 3:2</ref>; <ref loc="1TH 4:16">1 Tes 4:16</ref>; <ref loc="REV 18:8">Kush 18:8</ref>. </char>
    </note> MUKAMA naimutsya eiraka rye omu maisho g'eihe rye,</para>
  <para style="q1" vid="JOL 2:11">Ahabw'okuba eihe rye ni rihango munonga,</para>
  <para style="q1" vid="JOL 2:11">Kandi orikuhikiiriza ekigambo kye n'ow'amaani.</para>
  <para style="q1" vid="JOL 2:11">Ahakuba eizooba rya MUKAMA ni rikuru, kandi ni ritiinisa munonga;</para>
  <para style="q1" vid="JOL 2:11">N'oha owaakuryemera?<verse eid="JOL 2:11" /></para>
  <para style="s1">MUKAMA okugambira abantu be kweteisa</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:30">Bir 4:30</ref>; <ref loc="1SA 7:3">1 Sam 7:3</ref>, <ref loc="1SA 7:6">6</ref>; <ref loc="JER 4:1">Yer 4:1</ref>. </char>
    </note> MUKAMA naagira ati: Kwonka na hati</para>
  <para style="q1" vid="JOL 2:12">Mungarukire n'emitima yaanyu yoona,</para>
  <para style="q1" vid="JOL 2:12">Nimwesiibyakwo, nimurira, kandi nimucura.<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 34:6">Kur 34:6</ref>; <ref loc="PSA 34:18">Zab 34:18</ref>; <ref loc="PSA 86:5">86:5</ref>, <ref loc="PSA 86:15">15</ref>; <ref loc="JON 4:2">Yon 4:2</ref>. </char>
    </note> Mutaagure emitima yaanyu, ti by'okujwara byanyu,</para>
  <para style="q1" vid="JOL 2:13">Kandi muhindukire MUKAMA Ruhanga waanyu,</para>
  <para style="q1" vid="JOL 2:13">Ahabw'okuba aba ow'embabazi, agira esaasi,</para>
  <para style="q1" vid="JOL 2:13">Tarahuka kuguubwa kubi, aijwire rukundo etahinduka.</para>
  <para style="q1" vid="JOL 2:13">Kandi ayegarukamu, areka kureeta akabi.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:9">Yoel 1:9</ref>, <ref loc="JOL 1:13">13</ref>; <ref loc="JON 3:9">Yon 3:9</ref>; <ref loc="HAG 2:19">Hag 2:19</ref>; <ref loc="MAL 3:10">Mal 3:10</ref>. </char>
    </note> N'oha orikumanya ngu takaahinduka, akeegarukamu,</para>
  <para style="q1" vid="JOL 2:14">Akabatsigira omugisha,</para>
  <para style="q1" vid="JOL 2:14">Mukabona kuhongyera MUKAMA Ruhanga waanyu</para>
  <para style="q1" vid="JOL 2:14">Empongano z'esaano n'ez'eby'okunywa?<verse eid="JOL 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Muteerere enzamba omuri Saayuuni,</para>
  <para style="q1" vid="JOL 2:15">Mweze eizooba ry'okwesiibyakwo;<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:16: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:10">Kur 19:10</ref>, <ref loc="EXO 19:14">14</ref>, <ref loc="EXO 19:15">15</ref>; <ref loc="DEU 24:5">Bir 24:5</ref>; <ref loc="2CH 20:13">2 Bus 20:13</ref>; <ref loc="ECC 3:5">Mub 3:5</ref>; <ref loc="1CO 7:5">1 Kor 7:5</ref>. </char>
    </note> Muteeranire hamwe abantu,</para>
  <para style="q1" vid="JOL 2:16">Mweze ogwo mutwe gw'abateeraine,</para>
  <para style="q1" vid="JOL 2:16">Mureete abakuru, muteerane abaana,</para>
  <para style="q1" vid="JOL 2:16">Nangwa n'abeereere abarikwonka.</para>
  <para style="q1" vid="JOL 2:16">Kishwera arugye omu nju ye,</para>
  <para style="q1" vid="JOL 2:16">Na kishwerwa arugye omu kishengye kye.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3">Zab 42:3</ref>; <ref loc="EZK 8:16">Ezk 8:16</ref>. </char>
    </note> Abanyamurwa, abaheereza ba MUKAMA, baririre</para>
  <para style="q1" vid="JOL 2:17">Ahagati y'ekisasi n'eitambiro,</para>
  <para style="q1" vid="JOL 2:17">Nibagira bati: Ai MUKAMA, saasira abantu baawe,</para>
  <para style="q1" vid="JOL 2:17">Otahindura obuhunguzi bwawe ekijumo,</para>
  <para style="q1" vid="JOL 2:17">N'eky'okucweraho enfumu omu mahanga.</para>
  <para style="q1" vid="JOL 2:17">Mbwenu abanyamahanga bagirire ki bati:</para>
  <para style="q1" vid="JOL 2:17">Ruhanga waabo arahi?<verse eid="JOL 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:13">Zab 103:13</ref>; <ref loc="ZEC 1:14">Zek 1:14</ref>. </char>
    </note> Bwanyima MUKAMA yaagirira ensi ye eihato,</para>
  <para style="q1" vid="JOL 2:18">Yaagirira abantu be esaasi.<verse eid="JOL 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:19: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:10">Yoel 1:10</ref>; <ref loc="PSA 4:7">Zab 4:7</ref>; <ref loc="MAL 3:10-12">Mal 3:10-12</ref>. </char>
    </note> MUKAMA yaagarukamu abantu be naagira ati:</para>
  <para style="q1" vid="JOL 2:19">Reeba, naaza kubooherereza</para>
  <para style="q1" vid="JOL 2:19">Engano, viinyo n'amajuta, muhaagye;</para>
  <para style="q1" vid="JOL 2:19">Kandi tindigaruka kubahindura kijumo</para>
  <para style="q1" vid="JOL 2:19">Omuri ago mahanga obundi.<verse eid="JOL 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:20: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:3">Isa 34:3</ref>. </char>
    </note> Ndyabaihaho eihe ry'omu bukiizi-bwa-bumosho,</para>
  <para style="q1" vid="JOL 2:20">Ndibingire omu nsi ekarangataine kandi ey'eihamba,</para>
  <para style="q1" vid="JOL 2:20">Ekicweka kyaryo eky'omumaisho kigwe omu nyanja y'oburugwa-izooba,</para>
  <para style="q1" vid="JOL 2:20">N'eky'enyima kigwe omu nyanja y'oburengyerwa-izooba,</para>
  <para style="q1" vid="JOL 2:20">N'ekinuuko ky'ekijunde kyaryo kiimukye,</para>
  <para style="q1" vid="JOL 2:20">Ahabw'okuba rikakora ebirengyesereize.<verse eid="JOL 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 126:2">Zab 126:2</ref>, <ref loc="PSA 126:3">3</ref>. </char>
    </note> Iwe nsi 'we, otatiina;</para>
  <para style="q1" vid="JOL 2:21">Shemererwa kandi oyesiime,</para>
  <para style="q1" vid="JOL 2:21">Ahabw'okuba MUKAMA akozire bikuru!<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />Imwe nyamaishwa z'omu ishwa 'mwe, mutatiina,</para>
  <para style="q1" vid="JOL 2:22">Ahabw'okuba amariisizo g'omu ihamba gamezire;</para>
  <para style="q1" vid="JOL 2:22">Ebiti nibyana ebijuma byabyo,</para>
  <para style="q1" vid="JOL 2:22">Emitiini n'emizaabibu neeyera munonga.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:23: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 11:14">Bir 11:14</ref>; <ref loc="HOS 6:3">Hos 6:3</ref>; <ref loc="HAB 3:18">Hab 3:18</ref>. </char>
    </note> Imwe baana ba Saayuuni 'mwe, nimushemererwe;</para>
  <para style="q1" vid="JOL 2:23">Mwesiimire omuri MUKAMA Ruhanga waanyu;</para>
  <para style="q1" vid="JOL 2:23">Ahabw'okuba abahaire enjura y'ebiba ey'orugyero ruhikire,</para>
  <para style="q1" vid="JOL 2:23">Kandi yaabagwisiza enjura nyingi munonga</para>
  <para style="q1" vid="JOL 2:23">Ey'eibiba n'eya katumba nk'eya bwabiso.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Amahuuriro garyaijura engano,</para>
  <para style="q1" vid="JOL 2:24">Amaato gaijure viinyo n'amajuta bisheeshekye.<verse eid="JOL 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />Ndyabashumbuusha emyaka</para>
  <para style="q1" vid="JOL 2:25">Ei enzigye zaariire,</para>
  <para style="q1" vid="JOL 2:25">Ebitootera, kahembwe na rushanda,</para>
  <para style="q1" vid="JOL 2:25">Eihe ryangye rihango, eri naabateize.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:26: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 25:19">Lev 25:19</ref>; <ref loc="ISA 49:23">Isa 49:23</ref>. </char>
    </note> Muryarya bingi, muhaagye,</para>
  <para style="q1" vid="JOL 2:26">Muhimbise eiziina rya MUKAMA Ruhanga waanyu,</para>
  <para style="q1" vid="JOL 2:26">Owaabatwaize gye omu muringo gw'okutangaaza;</para>
  <para style="q1" vid="JOL 2:26">N'abantu bangye tibarigaruka kuhemurwa bundi.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:27: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 3:17">Yoel 3:17</ref>; <ref loc="ISA 44:8">Isa 44:8</ref>; <ref loc="HOS 11:9">Hos 11:9</ref>. </char>
    </note> Muryamanya ku ndi omu Baisraeli,</para>
  <para style="q1" vid="JOL 2:27">Kandi ku nyowe, MUKAMA, ndi Ruhanga waanyu, ku hatariho ondiijo;</para>
  <para style="q1" vid="JOL 2:27">N'abantu bangye tibarigaruka kuhemurwa bundi.<verse eid="JOL 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:28-32: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:17-21">Byak 2:17-21</ref>; <ref loc="ISA 32:15">Isa 32:15</ref>; <ref loc="EZK 39:29">Ezk 39:29</ref>; <ref loc="JHN 7:39">Yoh 7:39</ref>; <ref loc="ACT 10:45">Byak 10:45</ref>. </char>
    </note> Bwanyima obunaku ku burihika,</para>
  <para style="q1" vid="JOL 2:28">Ndyashuka Omwoyo wangye aha bantu boona;</para>
  <para style="q1" vid="JOL 2:28">Batabani baanyu na bahara baanyu baryaragura,</para>
  <para style="q1" vid="JOL 2:28">Abagurusi baanyu baryaroota ebirooto,</para>
  <para style="q1" vid="JOL 2:28">N'abatsigazi baanyu baryayorekwa.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:29: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 12:13">1 Kor 12:13</ref>. </char>
    </note> Nangwa n'abahuuku bangye n'abazaana bangye</para>
  <para style="q1" vid="JOL 2:29">Ndyabashukaho Omwoyo wangye omu biro ebyo.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Kandi ndyayoreka eby'amahano omu iguru n'omu nsi, eshagama n'omuriro n'okucumba kw'omwika.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:31: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 4:5">Mal 4:5</ref>; <ref loc="MAT 24:29">Mat 24:29</ref>; <ref loc="REV 6:12">Kush 6:12</ref>. </char>
    </note> Eizooba riryahinduka omwirima, n'okwezi kuhindukye eshagama, ekyo kiro kikuru kya MUKAMA ekirikutiinisa kitakahikire.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:32: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 59:20">Isa 59:20</ref>; <ref loc="OBA 1:17">Oba 17</ref>; <ref loc="MIC 4:7">Mik 4:7</ref>; <ref loc="ZEC 8:12">Zek 8:12</ref>; <ref loc="ROM 9:27">Rom 9:27</ref>; <ref loc="ROM 10:13">10:13</ref>. </char>
    </note> Kandi omu bunaku obwo boona abaritakira eiziina rya MUKAMA baryajunwa; ahabw'okuba aha rushozi rwangye Saayuuni n'omuri Yerusaalemu haryabayo abarihonokaho, omu baritsigaraho habemu abu MUKAMA arikweta.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Ruhanga okucwera amahanga orubanja</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="JER 30:3">Yer 30:3</ref>. </char>
    </note> Ahakuba reeba, omuri ebyo biro n'omuri obwo bunaku, obu ndigaruriramu Abayuda n'Abaisraeli nimbaiha omu bukwatwa, <verse eid="JOL 3:1" /><verse number="2" style="v" sid="JOL 3:2" /><note caller="-" style="x"><char style="xo" closed="false">3:2: </char><char style="xt" closed="false"><ref loc="JER 25:31">Yer 25:31</ref>; <ref loc="ZEP 3:8">Zef 3:8</ref>. </char></note> ndyateeranira hamwe amahanga goona, ngashuumye omu ruhita rwa Yehoshafaati, mbacwerereyo orubanja, nimbatura abantu bangye n'obuhunguzi bwangye Israeli, ahabw'okubataataanisiza omu mahanga, bakabaganisa ensi yangye, <verse eid="JOL 3:2" /><verse number="3" style="v" sid="JOL 3:3" /><note caller="-" style="x"><char style="xo" closed="false">3:3: </char><char style="xt" closed="false"><ref loc="NAM 3:10">Nah 3:10</ref>. </char></note> bakateerera abantu bangye enteenyu, omwana w'omwojo bakamuhingisa maraaya, n'ow'omwishiki bakamuhinga viinyo, ngu babone eby'okunywa. <verse eid="JOL 3:3" /><verse number="4" style="v" sid="JOL 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3:4: </char><char style="xt" closed="false"><ref loc="ISA 23:1">Isa 23:1</ref>, <ref loc="ISA 23:2">2</ref>; <ref loc="EZK 25:15">Ezk 25:15</ref>, <ref loc="EZK 25:16">16</ref>. </char></note> Iwe Tuuro na Sidoni, n'ebyanga byona eby'Abafilistia, nyine kakwate ki naimwe? Mwine eki murikwenda kunzimuurira ahabw'eki naabakoreire? Ku muranzimuurire, naanye niinyija kurahuka kubazimuurira juba eki mwakozire. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" /><note caller="-" style="x"><char style="xo" closed="false">3:5: </char><char style="xt" closed="false"><ref loc="2CH 21:16">2 Bus 21:16</ref>, <ref loc="2CH 21:17">17</ref>. </char></note> Ahabw'okuba mukatwara efeeza zangye n'ezaabu zangye, mwatwara ebintu byangye eby'obuguzi bwingi omuri hekalu zaanyu. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Abayuda n'aba Yerusaalemu mwabaguza Abagriika, mwabatwara hare n'ensi yaabo y'obuzaarwa. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />Kwonka hati niinyija kubaimutsya, mbaihe omu nsi ei mwabagurizemu, mbazimuurire ebi mwakozire. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Abaana baanyu b'aboojo n'ab'abaishiki ndyabaguza Abayuda, nabo babaguze aba Sheeba, eihanga erya hare; ahabw'okuba MUKAMA niwe yaakigamba.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:9: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:4">Yer 6:4</ref>. </char>
    </note> Eki mukirangye omu mahanga,</para>
  <para style="q1" vid="JOL 3:9">Mweteekateekyere orugamba;</para>
  <para style="q1" vid="JOL 3:9">Mwimutsye amamanzi,</para>
  <para style="q1" vid="JOL 3:9">Abarwani boona bairire haihi, bainamukye.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:4">Isa 2:4</ref>. </char>
    </note> Amafuka gaanyu mugaheeshemu zaarurara,</para>
  <para style="q1" vid="JOL 3:10">N'empabyo zaanyu muziheeshemu amacumu;</para>
  <para style="q1" vid="JOL 3:10">Otaine maani ahigye ati, Ndi ow'amaani.<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Imwe mahanga mwe, agari aha mbaju zoona,</para>
  <para style="q1" vid="JOL 3:11">Nimurahukye mwije, mweteeranire hamwe.</para>
  <para style="q1" vid="JOL 3:11">Ai MUKAMA, okwo obe niyo waashuumya amamanzi gaawe.<verse eid="JOL 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:9">Zab 98:9</ref>; <ref loc="PSA 110:6">110:6</ref>; <ref loc="ISA 3:13">Isa 3:13</ref>. </char>
    </note> Amahanga geimutsye,</para>
  <para style="q1" vid="JOL 3:12">Gaije omu ruhita rwa Yehoshafaati;</para>
  <para style="q1" vid="JOL 3:12">Ahabw'okuba okwo niyo ndishutama</para>
  <para style="q1" vid="JOL 3:12">Kucwera amahanga agari aha mbaju zoona emanja.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 63:2">Isa 63:2</ref>, <ref loc="ISA 63:3">3</ref>; <ref loc="JER 51:33">Yer 51:33</ref>; <ref loc="HOS 6:11">Hos 6:11</ref>; <ref loc="JHN 4:35">Yoh 4:35</ref>; <ref loc="REV 14:15-20">Kush 14:15-20</ref>. </char>
    </note> Mutwekyere omusyo gw'engyesho,</para>
  <para style="q1" vid="JOL 3:13">Ahabw'okuba eigyesha rihikire;</para>
  <para style="q1" vid="JOL 3:13">Mwije munyuukye, ahabw'okuba einyuukiro riijwire;</para>
  <para style="q1" vid="JOL 3:13">Amaato gaijwire viinyo nigasheesheka,</para>
  <para style="q1" vid="JOL 3:13">Ahabw'okuba obubi bwabo ni bwingi.<verse eid="JOL 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:14, 15: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:15">Yoel 1:15</ref>; <ref loc="JOL 2:10">2:10</ref>. </char>
    </note> Reeba, enyanja y'abantu, enyanja y'abantu</para>
  <para style="q1" vid="JOL 3:14">Omu ruhita rw'okucweramu emanja!</para>
  <para style="q1" vid="JOL 3:14">Ahakuba eizooba rya MUKAMA riri haihi</para>
  <para style="q1" vid="JOL 3:14">Omu ruhita rw'okucweramu emanja.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Eizooba n'okwezi bishwekirwe omwirima,</para>
  <para style="q1" vid="JOL 3:15">Kandi enyonyoozi tizirikwaka.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:11">Yoel 2:11</ref>; <ref loc="ISA 25:4">Isa 25:4</ref>; <ref loc="JER 25:30">Yer 25:30</ref>. </char>
    </note> MUKAMA naatsinda naayema Saayuuni,</para>
  <para style="q1" vid="JOL 3:16">Naimutsya eiraka rye ari Yerusaalemu,</para>
  <para style="q1" vid="JOL 3:16">Kandi eiguru n'ensi nibitengyeta.</para>
  <para style="q1" vid="JOL 3:16">Kwonka MUKAMA niwe buhungiro bw'abantu be,</para>
  <para style="q1" vid="JOL 3:16">Ekigo kigumire eky'Abaisraeli.<verse eid="JOL 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:1">Zab 48:1</ref>; <ref loc="ISA 52:1">Isa 52:1</ref>; <ref loc="JER 31:23">Yer 31:23</ref>; <ref loc="EZK 6:7">Ezk 6:7</ref>; <ref loc="NAM 1:15">Nah 1:15</ref>; <ref loc="ZEC 14:21">Zek 14:21</ref>; <ref loc="REV 21:27">Kush 21:27</ref>; <ref loc="REV 22:15">22:15</ref>. </char>
    </note> Nahabw'ekyo muryamanya ku ndi MUKAMA Ruhanga waanyu,</para>
  <para style="q1" vid="JOL 3:17">Otuura Saayuuni, orushozi rwangye orurikwera.</para>
  <para style="q1" vid="JOL 3:17">Yerusaalemu eryaba erikwera,</para>
  <para style="q1" vid="JOL 3:17">Kandi abanyamahanga tibarigirabamu bundi.<verse eid="JOL 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:18: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 30:25">Isa 30:25</ref>; <ref loc="EZK 47:1">Ezk 47:1</ref>; <ref loc="AMO 9:13">Amo 9:13</ref>. </char>
    </note> Ahari eryo izooba enshozi ziryatoonya viinyo enuzire,</para>
  <para style="q1" vid="JOL 3:18">Ebibungo bihimintikwemu amate,</para>
  <para style="q1" vid="JOL 3:18">Kandi otugyera tw'omuri Yuda twona turyaijura amaizi;</para>
  <para style="q1" vid="JOL 3:18">N'enshuro y'amaizi erugye omu nju ya MUKAMA,</para>
  <para style="q1" vid="JOL 3:18">Eitirire oruhanga rwa Shitimu.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:19: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 19:1-17">Isa 19:1-17</ref>; <ref loc="ISA 34:5">34:5</ref>. </char>
    </note> Misri eryaba amatongo,</para>
  <para style="q1" vid="JOL 3:19">Na Edomu ebe eihamba ririmu busha,</para>
  <para style="q1" vid="JOL 3:19">Niziturwa obubisha obu zaagiriire Abayuda,</para>
  <para style="q1" vid="JOL 3:19">Ahabw'okuba zikasheesha eshagama y'abataine rubanja omu nsi yaabo.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 125:1">Zab 125:1</ref>, <ref loc="PSA 125:2">2</ref>; <ref loc="EZK 37:25">Ezk 37:25</ref>. </char>
    </note> Kwonka Yuda eryatuurwamu ebiro byona,</para>
  <para style="q1" vid="JOL 3:20">Na Yerusaalemu etuurwemu obusingye bwona.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:21: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 4:4">Isa 4:4</ref>. </char>
    </note> Ndyahoorera eshagama yaabo,</para>
  <para style="q2" vid="JOL 3:21">Kandi abasingirwe orubanja tindirubaihaho,</para>
  <para style="q1" vid="JOL 3:21">Ahabw'okuba MUKAMA atuura Saayuuni.<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>