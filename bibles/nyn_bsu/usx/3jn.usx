<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">RRK65.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">3 YOHAANA</para>
  <para style="toc1">Ebaruha ya Kashatu eyaahandiikirwe Yohaana</para>
  <para style="toc2">3 Yohaana</para>
  <para style="toc3">3 Yoh</para>
  <para style="mt2">EBARUHA YA KASHATU EYAAHANDIIKIRWE</para>
  <para style="mt1">YOHAANA</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Nyowe nk'omukuru naakuhandiikira, iwe Gaayo orikukundwa, ou nkunda omu mazima.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Orikukundwa, ninshaba ngu obe gye omuri byona, kandi ngu ogire amagara omu mubiri, nk'oku ori gye omu mwoyo. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Ahakuba nkashemererwa munonga obu abamwe aha b'eishe-emwe baija, nibahamya amazima gaawe, kandi n'oku orikugagyenderamu. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Tihariho ki ndikushemerererwa okukira eki, okuhurira ngu abaana bangye nibagyendera omu mazima. <verse eid="3JN 1:4" /><verse number="5" style="v" sid="3JN 1:5" />Orikukundwa, nookora omurimo gw'obwesigwa omuri byona ebi orikukorera ab'eishe-emwe, haza kandi bari abagyenyi abu otarikumanya, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />abahamize okukunda kwawe omu maisho g'ekanisa. Kandi ku oribaraga gye omu rugyendo rwabo omu muringo ogurikusiimisa Ruhanga, oryaba okozire gye. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" /><note caller="-" style="x"><char style="xo" closed="false">1:7: </char><char style="xt" closed="false"><ref loc="1CO 9:12">1 Kor 9:12</ref>, <ref loc="1CO 9:15">15</ref>. </char></note> Ahabw'okuba bakaruga owaabo ahabw'Eiziina eryo, bataine ki baihire aha Banyamahanga. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" /><note caller="-" style="x"><char style="xo" closed="false">1:8: </char><char style="xt" closed="false"><ref loc="HEB 13:2">Heb 13:2</ref>. </char></note> N'ahabw'ekyo naitwe tushemereire kwakiira abari nk'abo, tube abarikukwatanisa nabo kuhwerana omu mazima.<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Hariho eki naahandiikiire ekanisa; kwonka Diotorefe, okunda kwekuza, tarikutwikiriza. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />N'ahabw'ekyo, ku ndiija, ndyabaijutsya ebi arikukora, naatujuma, kandi naatugambaho ebigambo bibi. Kandi tagarukira hari ebyo byonka, kureka ataho n'okwanga kwakiira ab'eishe-emwe, n'abarikwenda kubaakiira abazibira, agaruka abacwa omu kanisa.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Orikukundwa, otaritooreza orikukora ekibi, kureka orikukora ekirungi. Orikukora gye n'owa Ruhanga; orikukora kubi, takareebaga Ruhanga. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Demeterio naasiimwa boona, kandi n'amazima nigakihamya; naitwe noomanya ngu okuhamya kwaitu n'okw'amazima.<verse eid="3JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Nkaba nyine bingi kukuhandiikira; kwonka tindikusiima kubihandiikisa akacumu na bwino. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Kwonka nyine amatsiko kukureeba juba; obwo turyagaaniira nitureebana. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />Obusingye bugume naiwe. Banywani baitu baakuramutsya. Ndamukiza banywani baitu buri omwe.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>