<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">RRK58.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">FILEMOONI</para>
  <para style="toc1">Ebaruha ei Paulo yaahandiikiire Filemooni</para>
  <para style="toc2">Filemooni</para>
  <para style="toc3">Film</para>
  <para style="mt2">EBARUHA EI PAULO YAAHANDIIKIIRE</para>
  <para style="mt1">FILEMOONI</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Nyowe Paulo, embohe ahabwa Kristo Yesu na Timoseo ow'eishe-emwe, twakuhandiikira, iwe Filemooni omukozi mugyenzi waitu orikukundwa, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" /><note caller="-" style="x"><char style="xo" closed="false">1:2: </char><char style="xt" closed="false"><ref loc="2TI 2:3">2 Tim 2:3</ref>. </char></note> na Apofia munyaanyaitwe, na Arakipo ou tukwataniise orugamba, n'ekanisa ey'omu nju yaawe, <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />nitubendeza embabazi n'obusingye ebirikuruga ahari Ruhanga Tataitwe na Mukama waitu Yesu Kristo.<verse eid="PHM 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Obutoosha nsiima Ruhanga wangye, ku nkwijuka omu kushaba kwangye, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />ahabw'okuhurira okukunda kwawe oku oine aha barikwera boona, n'okwikiriza oku oine ahari Mukama waitu Yesu, <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />kandi nkushabira ngu okukwatanisa n'abandi eby'okwikiriza kwawe kwongyere omuribo okushoborokyerwa ebirungi byona ebi twine omuri Kristo. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" /><note caller="-" style="x"><char style="xo" closed="false">1:7: </char><char style="xt" closed="false"><ref loc="2CO 7:4">2 Kor 7:4</ref>. </char></note> Ow'eishe-emwe, okukunda kwawe kukanshemeza munonga, kwangarura omutima omunda, ahabw'okuba okaruhuura emitima y'abarikwera.<verse eid="PHM 1:7" /></para>
  <para style="s1">Paulo okushaba Filemooni kwakiira omuhuuku we, Onesimo</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />N'ahabw'ekyo, n'obu ndaabe nyine obumanzi bwingi omuri Kristo kukuragiira kukora ekihikire, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />kwonka ahabwa rukundo naihamu kukweshengyereza, nyowe Paulo omugurusi kandi hati embohe ahabwa Kristo Yesu. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" /><note caller="-" style="x"><char style="xo" closed="false">1:10: </char><char style="xt" closed="false"><ref loc="COL 4:9">Kol 4:9</ref>; <ref loc="GAL 4:19">Gal 4:19</ref>. </char></note> Ninkweshengyereza ahabw'omwana wangye, Onesimo, ou naazaariire omu kihome. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Ira akaba atakwiniire mugasho, kwonka hati n'ow'omugasho buzima ahariiwe n'ahariinye. <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />Naamukugarurira, nk'owaakugarurira orura rwangye buzima. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" /><note caller="-" style="x"><char style="xo" closed="false">1:13: </char><char style="xt" closed="false"><ref loc="PHP 2:30">Fil 2:30</ref>. </char></note> Nkaayenzire kuguma nawe, ngu ampeereze omu mwanya gwawe omu kubohwa kwangye ahabw'engiri; <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" /><note caller="-" style="x"><char style="xo" closed="false">1:14: </char><char style="xt" closed="false"><ref loc="1PE 5:2">1 Pet 5:2</ref>. </char></note> kwonka tiinyenzire kukora kintu kyona otaanyikiriize, ngu ekirungi kyawe kirekye kuba eki ogyemirwe, kureka eki oyekundiire.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Shana akaaba yaakurugireho omwanya mukye, ngu abone kugaruka kuguma naiwe ebiro byona, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" /><note caller="-" style="x"><char style="xo" closed="false">1:16: </char><char style="xt" closed="false"><ref loc="1TI 6:2">1 Tim 6:2</ref>. </char></note> atakiri muhuuku kureka orikukira omuhuuku, ow'eishe-emwe orikukundwa na buzima ahariinye, kwonka okukira munonga ahariiwe, omu by'obuntu n'omu bya Mukama. <verse eid="PHM 1:16" /><verse number="17" style="v" sid="PHM 1:17" />N'ahabw'ekyo ku oraabe noonyenta mugyenzi waawe, omwakiire nk'oku waakuunyakiire. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Kandi ku araabe yaakushaagiize, nari aine eibanja ryawe, obe niinye waihuza. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Nyowe, Paulo, niinye naahandiika ebi n'omukono gwangye, nti, Ndyariihura; ndekye kusiiba ninkugambira nti, naiwe oine eibanja ryangye; eibanja ryangye eryo n'amagara gaawe. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Eego Ow'eishe-emwe, ka ntungye okushemererwa ahariiwe omuri Mukama. Oruhuure omutima gwangye omuri Kristo.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Naakuhandiikira nyesigire okworoba kwawe, kandi nimmanya ngu nangwa oryakora ebirikukira ebi naagamba. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Kandi ekindi onteguurire ah'okuraara, ahabw'okuba nyine amatsiko ngu nimwija kundeeba ahabw'okushaba kwanyu.<verse eid="PHM 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:23: </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">Kol 1:7</ref>; <ref loc="COL 4:12">4:12</ref>. </char>
    </note> Epafura, embohe mugyenzi wangye omuri Kristo Yesu, yaabaramutsya, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />kandi na Mako, Aristariiko, Deema na Luka, abakozi bagyenzi bangye.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Embabazi za Mukama waitu Yesu Kristo zigume n'emyoyo yaanyu.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>