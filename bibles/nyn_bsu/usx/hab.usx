<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">RRK35.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">HABAKUUKI</para>
  <para style="toc1">Ekitabo Kya Nabi Habakuuki</para>
  <para style="toc2">Habakuuki</para>
  <para style="toc3">Hab</para>
  <para style="mt2">EKITABO KYA NABI</para>
  <para style="mt1">HABAKUUKI</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="s1">Nabi okwetomboitera Ruhanga ahabw'okugumisiririza ababi</para>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="NAM 1:1">Nah 1:1</ref>. </char>
    </note> Eby'okuhanuura ebi nabi Habakuuki yaayorekirwe.<verse eid="HAB 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:46">Zab 89:46</ref>. </char>
    </note> Ai MUKAMA, ndyahitysa hi okukutakira,</para>
  <para style="q1" vid="HAB 1:2">Okanga kumpurira?</para>
  <para style="q1" vid="HAB 1:2">Nari okukutakira ahabw'okukorwa kubi,</para>
  <para style="q1" vid="HAB 1:2">Otanjune?<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:2-6">Yer 9:2-6</ref>. </char>
    </note> Ahabw'enki nondeebesa ebitahikire n'eby'eitima?</para>
  <para style="q1" vid="HAB 1:3">Okuhwerekyerera n'obubisha biri omu maisho gangye,</para>
  <para style="q1" vid="HAB 1:3">Entongane n'empaka ziri ahaiguru.<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 7:3">Mik 7:3</ref>. </char>
    </note> N'ahabw'ekyo ebiragiro tibikiine maani,</para>
  <para style="q1" vid="HAB 1:4">Kandi n'emanja tizirikucuubwa mu buryo.</para>
  <para style="q1" vid="HAB 1:4">Ahabw'okuba ababi nibeehinduririza abahikiriire,</para>
  <para style="q1" vid="HAB 1:4">Nikyo emanja z'oburyo zirikwitirwa.<verse eid="HAB 1:4" /></para>
  <para style="s1">Obushaarizi bw'Abakaludaaya</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 28:21">Isa 28:21</ref>; <ref loc="ISA 29:14">29:14</ref>; <ref loc="ACT 13:41">Byak 13:41</ref>. </char>
    </note> Nimwetegyereze omu mahanga, mureebe;</para>
  <para style="q1" vid="HAB 1:5">Mutangaare, mute engaro aha munwa;</para>
  <para style="q1" vid="HAB 1:5">Ahabw'okuba ninkora omurimo omu biro byanyu,</para>
  <para style="q1" vid="HAB 1:5">Ogu mutarikubaasa kwikiriza, n'obu mwakugambirwa muta.<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:15">Yer 5:15</ref>. </char>
    </note> Ahakuba reeba, niinyimutsya Abakaludaaya,</para>
  <para style="q1" vid="HAB 1:6">Eryo ihanga ry'enshaarizi kandi eririkubakuka,</para>
  <para style="q1" vid="HAB 1:6">Eririkubuga ensi yoona</para>
  <para style="q1" vid="HAB 1:6">Kukubuura amaka agatari gaaryo.<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />Nibatiinisa, kandi nibaitsa obwoba,</para>
  <para style="q1" vid="HAB 1:7">Emicwe yaabo n'ekitiinisa kyabo</para>
  <para style="q1" vid="HAB 1:7">Nibo barikubyeha.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:8: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:49">Bir 28:49</ref>; <ref loc="JER 4:13">Yer 4:13</ref>; <ref loc="JER 5:6">5:6</ref>. </char>
    </note> Embaraasi zaabo ziine amaguru kukira engwe,</para>
  <para style="q1" vid="HAB 1:8">Nizishaarira okukira emishega y'omu mwabazyo;</para>
  <para style="q1" vid="HAB 1:8">Abarikuzigyenderaho nibazikinisa n'amaryo,</para>
  <para style="q1" vid="HAB 1:8">Buzima abantu baabo abazitembire nibaruga hare.</para>
  <para style="q1" vid="HAB 1:8">Nibaguruka nk'eishamba eririkusyoka kuteera eky'okurya.<verse eid="HAB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 1:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 11:4">Yos 11:4</ref>. </char>
    </note> Boona nibareetwa okukora eby'obubisha,</para>
  <para style="q1" vid="HAB 1:9">Okutiinisa kwabo kubeebembeire,</para>
  <para style="q1" vid="HAB 1:9">Nibarunda hamwe enkwatwa nk'omusheenyi.<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:10: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 4:2">Ezk 4:2</ref>. </char>
    </note> Nibateerera abagabe enaku,</para>
  <para style="q1" vid="HAB 1:10">Nibagaaniiza abategyeki.</para>
  <para style="q1" vid="HAB 1:10">Buri kigo nibakishekyerera,</para>
  <para style="q1" vid="HAB 1:10">Ahabw'okuba nibakirundaho eitaka, bakikwata.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />Batyo barabaho nk'omuyaga, bagumizamu,</para>
  <para style="q1" vid="HAB 1:11">N'abantu abaine orubanja, abahindwire amaani gaabo ruhanga waabo.<verse eid="HAB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:12: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:4">Bir 32:4</ref>; <ref loc="DEU 33:27">33:27</ref>; <ref loc="PSA 90:2">Zab 90:2</ref>; <ref loc="PSA 93:2">93:2</ref>; <ref loc="ISA 10:5-7">Isa 10:5-7</ref>; <ref loc="MAL 3:6">Mal 3:6</ref>. </char>
    </note> Ai MUKAMA Ruhanga wangye, Orikwera wangye,</para>
  <para style="q1" vid="HAB 1:12">Tori otahwaho ebiro byona?</para>
  <para style="q1" vid="HAB 1:12">Titurifa.</para>
  <para style="q1" vid="HAB 1:12">Ai MUKAMA, obataireho kucwera abantu emanja;</para>
  <para style="q1" vid="HAB 1:12">Naiwe Rukiri, obahamize ngu babone kuhana.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:5">Zab 5:5</ref>; <ref loc="PSA 35:22">35:22</ref>; <ref loc="JER 12:1">Yer 12:1</ref>. </char>
    </note> Iwe ow'amaisho gashemeire, agatenda kureeba kibi,</para>
  <para style="q1" vid="HAB 1:13">Kandi agatarikwemera kureeba bitahikire,</para>
  <para style="q1" vid="HAB 1:13">Ahabw'enki nooreeba abantu endeebya,</para>
  <para style="q1" vid="HAB 1:13">Omubi naamirakwo orikumukiza okuhikiirira,</para>
  <para style="q1" vid="HAB 1:13">Haza okeetsiza?<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />Ahakuba noohindura abantu nk'eby'enyanja,</para>
  <para style="q1" vid="HAB 1:14">Baba nk'ebirikugyendesa enda, ebitagira mukama.<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="JER 16:16">Yer 16:16</ref>. </char>
    </note> Boona abatuuhuuzamu eirobo,</para>
  <para style="q1" vid="HAB 1:15">Abaihisamu akatimba ke,</para>
  <para style="q1" vid="HAB 1:15">Abakwatsa entukuru;</para>
  <para style="q1" vid="HAB 1:15">Atyo ashemererwa, ayesiima.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />N'ahabw'ekyo atambira akatimba ke ebitambo,</para>
  <para style="q1" vid="HAB 1:16">Ayooterera entukuru ye obubaane,</para>
  <para style="q1" vid="HAB 1:16">Ahakuba ebyo nibyo bimureetera kujarama,</para>
  <para style="q1" vid="HAB 1:16">Akarya eby'ebishaju.<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />Naija kuguma naafukunkura entukuru ye,</para>
  <para style="q1" vid="HAB 1:17">Naita amahanga ebiro byona ataine saasi?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s1">Abahikiriire okubaisibwaho okwikiriza</para>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:8">Zab 85:8</ref>; <ref loc="ISA 21:8">Isa 21:8</ref>. </char>
    </note> Niinyija kwemerera kureeba,</para>
  <para style="q1" vid="HAB 2:1">Nyemerere aha munaara gw'okurindiraho,</para>
  <para style="q1" vid="HAB 2:1">Nnagye amaisho, ndeebe eki arangambire,</para>
  <para style="q1" vid="HAB 2:1">N'eki ndaagarukyemu ahabw'ebi ndikwetonganira.<verse eid="HAB 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 2:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 30:8">Isa 30:8</ref>. </char>
    </note> MUKAMA yangarukamu ati:</para>
  <para style="q1" vid="HAB 2:2">Handiika ebi waayorekwa,</para>
  <para style="q1" vid="HAB 2:2">Obihandiikye gye aha bishate,</para>
  <para style="q1" vid="HAB 2:2">Oraabishome abishome naarahutsya.<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 8:17">Isa 8:17</ref>; <ref loc="DAN 10:14">Dan 10:14</ref>; <ref loc="HEB 10:37">Heb 10:37</ref>; <ref loc="2PE 3:9">2 Pet 3:9</ref>. </char>
    </note> Ahabw'okuba ebi waayorekwa ebyo biine obunaku bwabyo obwatairweho;</para>
  <para style="q1" vid="HAB 2:3">Tibirituuraho kuhikiirizibwa,</para>
  <para style="q1" vid="HAB 2:3">Kandi tibiribeiha.</para>
  <para style="q1" vid="HAB 2:3">N'obu byakutuuraho, obitegyereze;</para>
  <para style="q1" vid="HAB 2:3">Buzimazima biryaija, tibirikyerererwa.<verse eid="HAB 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:4: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:17">Rom 1:17</ref>; <ref loc="GAL 3:11">Gal 3:11</ref>; <ref loc="HEB 10:38">Heb 10:38</ref>. </char>
    </note> Reeba, ow'omutima ogutagororokire aryaremwa;</para>
  <para style="q1" vid="HAB 2:4">Kwonka ohikiriire aryaba ohuriire ahabw'okwikiriza kwe.<verse eid="HAB 2:4" /></para>
  <para style="s1">Okuhanuura aha bi Abakaludaaya barizimuurirwa</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:20">Enf 27:20</ref>; <ref loc="ISA 5:14">Isa 5:14</ref>; <ref loc="DAN 2:37">Dan 2:37</ref>, <ref loc="DAN 2:38">38</ref>. </char>
    </note> Kandi buzimazima viinyo eba bareebyana,</para>
  <para style="q1" vid="HAB 2:5">Kandi omunyamaryo otaikara muka.</para>
  <para style="q1" vid="HAB 2:5">Omururu gwe ni mwingi nk'Okuzimu;</para>
  <para style="q1" vid="HAB 2:5">Ni nka rufu, tahaaga.</para>
  <para style="q1" vid="HAB 2:5">Ayeteeraniraho amahanga goona,</para>
  <para style="q1" vid="HAB 2:5">Ayeshangururizaho enganda zoona.<verse eid="HAB 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:8">Isa 5:8</ref>; <ref loc="MIC 2:4">Mik 2:4</ref>; <ref loc="ZEC 1:12">Zek 1:12</ref>. </char>
    </note> Abo boona tibarimugaaniiza,</para>
  <para style="q1" vid="HAB 2:6">bakamuteerera enaku? Nibagira bati:</para>
  <para style="q1" vid="HAB 2:6">Eshi oyerundira ebitari bye, aryakareeba!</para>
  <para style="q2" vid="HAB 2:6">Mbwenu aryahitsya hi?</para>
  <para style="q2" vid="HAB 2:6">Orikwerundaho emikwato nawe aryakareeba!<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />Abu orikwihuza tibariimuka kitaraariire,</para>
  <para style="q1" vid="HAB 2:7">N'abarikutetemesa bakasisiimuka?</para>
  <para style="q1" vid="HAB 2:7">Obwo oryaba omunyago gwabo.<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 33:1">Isa 33:1</ref>. </char>
    </note> Ahabw'okunyaga amahanga maingi,</para>
  <para style="q1" vid="HAB 2:8">Amahanga goona agatsigaireho naiwe garyakunyaga,</para>
  <para style="q1" vid="HAB 2:8">Nigakutura eshagama y'abantu n'obubisha,</para>
  <para style="q1" vid="HAB 2:8">Obu waagiriire ensi n'endembo n'abazitwiremu boona.<verse eid="HAB 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:13">Isa 14:13</ref>; <ref loc="JER 22:13">Yer 22:13</ref>; <ref loc="JER 49:16">49:16</ref>. </char>
    </note> Aryakareeba, otunga amagoba mabi ahabw'eka ye,</para>
  <para style="q1" vid="HAB 2:9">Ngu ayeyarikire ekyashuri kye ahaiguru,</para>
  <para style="q1" vid="HAB 2:9">Akabi koona karekye kumuhikaho.<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:10: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:38">Kub 16:38</ref>. </char>
    </note> Enaama ei waagizire, okamaraho amahanga maingi,</para>
  <para style="q1" vid="HAB 2:10">Okahemura eka yaawe;</para>
  <para style="q1" vid="HAB 2:10">Waareebya amagara gaawe.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:40">Luk 19:40</ref>. </char>
    </note> Ahabw'okuba eibaare riryaboroogyera omu kisiika,</para>
  <para style="q1" vid="HAB 2:11">N'omutambiko gw'omu biti by'enju gurigarukyemu.<verse eid="HAB 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 3:10">Mik 3:10</ref>. </char>
    </note> Orikwombekyesa tauni eshagama,</para>
  <para style="q1" vid="HAB 2:12">Akahamisa orurembo okutahikiirira, aryakareeba!<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13: </char>
      <char style="xt" closed="false">
        <ref loc="JER 51:58">Yer 51:58</ref>. </char>
    </note> Mbwenu, eki tikirikuruga ahari MUKAMA ow'amahe,</para>
  <para style="q1" vid="HAB 2:13">Abantu okuhendekyera omuriro gwonka,</para>
  <para style="q1" vid="HAB 2:13">N'amahanga okwerusya ahabw'ebitaine mugasho?<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:19">Zab 72:19</ref>; <ref loc="ISA 11:9">Isa 11:9</ref>. </char>
    </note> Ahabw'okuba ensi eryabugwa</para>
  <para style="q1" vid="HAB 2:14">Okumanya ekitiinisa kya MUKAMA,</para>
  <para style="q1" vid="HAB 2:14">Nk'oku amaizi gabuga hoona omu nyanja.<verse eid="HAB 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:15: </char>
      <char style="xt" closed="false">
        <ref loc="JER 51:7">Yer 51:7</ref>; <ref loc="LAM 4:21">Tonz 4:21</ref>. </char>
    </note> Aryakareeba, orikunywaisa mutaahi we ekikopo ky'ekiniga kye,</para>
  <para style="q1" vid="HAB 2:15">Akakimusinzisa, ngu areebe enjuuro ye.<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:16: </char>
      <char style="xt" closed="false">
        <ref loc="JER 25:15">Yer 25:15</ref>; <ref loc="NAM 3:5">Nah 3:5</ref>, <ref loc="NAM 3:6">6</ref>. </char>
    </note> Oryaiguta enshoni omu mwanya gw'ekitiinisa.</para>
  <para style="q1" vid="HAB 2:16">Naiwe nywa, otaruze!</para>
  <para style="q1" vid="HAB 2:16">Ekikopo ekiri omu ngaro ya MUKAMA eya buryo</para>
  <para style="q1" vid="HAB 2:16">Nikiija kurugaho kikuhikyeho,</para>
  <para style="q1" vid="HAB 2:16">Enshoni zize aha ktiinisa kyawe.<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:17: </char>
      <char style="xt" closed="false">
        <ref loc="JER 22:23">Yer 22:23</ref>. </char>
    </note> Obubisha obwagiriirwe Lebanooni buryakumaraho,</para>
  <para style="q1" vid="HAB 2:17">Okucwekyereza enyamaishwa kwawe kukwitse obwoba,</para>
  <para style="q1" vid="HAB 2:17">Ahabw'eshagama y'abantu ei waaseesire,</para>
  <para style="q1" vid="HAB 2:17">N'obubisha obu waagiriire ensi,</para>
  <para style="q1" vid="HAB 2:17">N'endembo n'abazitwiremu boona.<verse eid="HAB 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:18: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 44:10">Isa 44:10</ref>; <ref loc="JER 10:8">Yer 10:8</ref>; <ref loc="JER 14">14</ref>; <ref loc="1CO 12:2">1 Kor 12:2</ref>. </char>
    </note> Ekishushani ekirikuramibwa nikigasha ki,</para>
  <para style="q1" vid="HAB 2:18">Omukozi waakyo yaaheza kukikora,</para>
  <para style="q1" vid="HAB 2:18">Ekishushani ky'ekyoma ekirikwegyesa ebishuba?</para>
  <para style="q1" vid="HAB 2:18">Ahakuba omukozi ku aba naakora ebishushani bitarikugamba,</para>
  <para style="q1" vid="HAB 2:18">Aba naayesiga ebi ayekoreire n'emikono ye.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:19: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 18:26">1 Bag 18:26</ref>, <ref loc="1KI 18:27">27</ref>; <ref loc="PSA 135:17">Zab 135:17</ref>. </char>
    </note> Aryakareeba, orikugira ekiti ati: Sisiimuka!</para>
  <para style="q1" vid="HAB 2:19">N'eibaare eritarikugamba ati: Imuka!</para>
  <para style="q1" vid="HAB 2:19">Nimugira ngu ebyo nibibasa kwegyesa?</para>
  <para style="q1" vid="HAB 2:19">Reeba, bishwekirwe ezaabu n'efeeza,</para>
  <para style="q1" vid="HAB 2:19">Kandi tibirimu mwitsyo gwona.<verse eid="HAB 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:4">Zab 11:4</ref>; <ref loc="ZEC 2:13">Zek 2:13</ref>. </char>
    </note> Kwonka MUKAMA ari omuri hekalu ye erikwera;</para>
  <para style="q1" vid="HAB 2:20">Ensi yoona ececekye omu maisho ge.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s1">Okushaba kwa Habakuuki</para>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 3:1" />Okushaba kwa Habakuuki omu iraka rya Shigionoosi.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:1">Zab 44:1</ref>; <ref loc="PSA 85:6">85:6</ref>. </char>
    </note> Ai MUKAMA, mpuriire ebyawe, naatiina,</para>
  <para style="q1" vid="HAB 3:2">Ai MUKAMA, garura busya omurimo gwawe omuri egi myaka,</para>
  <para style="q1" vid="HAB 3:2">Ahagati y'egi myaka ogumanyise;</para>
  <para style="q1" vid="HAB 3:2">Omu kugira ekiniga oijukye okugira embabazi.<verse eid="HAB 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:3: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 33:2">Bir 33:2</ref>. </char>
    </note> Ruhanga akaruga Temani,</para>
  <para style="q1" vid="HAB 3:3">Orikwera yaaruga aha rushozi Parani,</para>
  <para style="q1" vid="HAB 3:3">Ekitiinisa kye kyashweka eiguru,</para>
  <para style="q1" vid="HAB 3:3">Kandi ensi yaijura okuhimbisibwa kwe. Sela<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 1:27">Ezk 1:27</ref>. </char>
    </note> Okumurinkana kwe kwaba nk'omushana,</para>
  <para style="q1" vid="HAB 3:4">Amaranzi gaaturuka omu ngaro ze nigarabya;</para>
  <para style="q1" vid="HAB 3:4">Kandi okwo niyo yaasherekire amaani ge.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:5: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 21:11-15">1 Bus 21:11-15</ref>; <ref loc="PSA 18:8">Zab 18:8</ref>. </char>
    </note> Orufu rwamwebembera,</para>
  <para style="q1" vid="HAB 3:5">Emyambi y'omuriro yaamukuratira, emuri omu ntegye.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:26">Kut 49:26</ref>; <ref loc="PSA 60:6">Zab 60:6</ref>; <ref loc="ISA 51:9">Isa 51:9</ref>; <ref loc="MIC 1:4">Mik 1:4</ref>. </char>
    </note> Yaayemerera, yaagyera ensi;</para>
  <para style="q1" vid="HAB 3:6">Yaanaga amaisho, yaatengyetsa amahanga;</para>
  <para style="q1" vid="HAB 3:6">Obwo enshozi ezituuraho zaataataanisibwa,</para>
  <para style="q1" vid="HAB 3:6">N'ebibungo by'ebiro byona byabandama,</para>
  <para style="q1" vid="HAB 3:6">Emitwarize ye yaaba nk'eya ira.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 3:10">Bar 3:10</ref>; <ref loc="JDG 8:12">8:12</ref>. </char>
    </note> Naareeba amahema ga Kushani nigabonabona;</para>
  <para style="q1" vid="HAB 3:7">Emikingo y'ensi ya Midiani yaatetema.<verse eid="HAB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:8: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 33:26">Bir 33:26</ref>; <ref loc="PSA 18:10">Zab 18:10</ref>; <ref loc="PSA 114:5">114:5</ref>; <ref loc="ISA 66:15">Isa 66:15</ref>. </char>
    </note> Ai MUKAMA, beitu shi okaba oiniire emigyera ekiniga,</para>
  <para style="q1" vid="HAB 3:8">Nari shi egyo migyera niyo waagwereirwe kubi,</para>
  <para style="q1" vid="HAB 3:8">Nari shi okagirira enyanja ekiniga,</para>
  <para style="q1" vid="HAB 3:8">Obu waagyendera aha mbaraasi zaawe,</para>
  <para style="q1" vid="HAB 3:8">N'omu kigaari kyawe ky'obusinguzi?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:15">Zab 78:15</ref>, <ref loc="PSA 78:16">16</ref>. </char>
    </note> Okashembuura obuta bwawe,</para>
  <para style="q1" vid="HAB 3:9">Waatamika emyambi omu rugye. Sela</para>
  <para style="q1" vid="HAB 3:9">Ensi waagicwamu emikura y'emigyera.<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:22">Kur 14:22</ref>; <ref loc="EXO 19:18">19:18</ref>; <ref loc="PSA 93:3">Zab 93:3</ref>. </char>
    </note> Enshozi zaakureeba, zaatiina,</para>
  <para style="q1" vid="HAB 3:10">Emyegyemure y'amaizi yaahimintika,</para>
  <para style="q1" vid="HAB 3:10">Eiraka ry'amaizi g'ahagati y'enyanja ryahurirwa,</para>
  <para style="q1" vid="HAB 3:10">Ebingozi byayo byanaga emikono.<verse eid="HAB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 10:12">Yos 10:12</ref>, <ref loc="JOS 10:13">13</ref>; <ref loc="2SA 22:15">2 Sam 22:15</ref>. </char>
    </note> Eizooba n'okwezi byayemerera omu myanya yaabyo,</para>
  <para style="q1" vid="HAB 3:11">Ahabw'okumurinkana kw'emyambi yaawe neerashwa,</para>
  <para style="q1" vid="HAB 3:11">N'ahabw'okurabya kw'eicumu ryawe eririkutyankana.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 4:12">Mik 4:12</ref>, <ref loc="MIC 4:13">13</ref>. </char>
    </note> Okagyenda nooraba omu nsi oine ekiniga kingi,</para>
  <para style="q1" vid="HAB 3:12">Waaribatiirira amahanga ogagwereirwe kubi.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:15">Zab 105:15</ref>; <ref loc="PSA 110:6">110:6</ref>. </char>
    </note> Okahurura kujuna abantu baawe,</para>
  <para style="q1" vid="HAB 3:13">N'okujuna ou waashukireho amajuta.</para>
  <para style="q1" vid="HAB 3:13">Waasingyera omutwe gw'omubi,</para>
  <para style="q1" vid="HAB 3:13">Waamujweka busha okuruga aha bibero okuhika omu bitsya. Sela<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />Waacumita emitwe y'abarwani be emango zaawe,</para>
  <para style="q1" vid="HAB 3:14">Abaizire nk'akasooroora kuntuntumura,</para>
  <para style="q1" vid="HAB 3:14">Nibeesiima nk'abarikwenda kumaraho abooro bwesherekye.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:19">Zab 77:19</ref>. </char>
    </note> Enyanja waagiribatiiriza embaraasi zaawe,</para>
  <para style="q1" vid="HAB 3:15">Okwecunda kw'amaizi g'amaani.<verse eid="HAB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:3">Isa 14:3</ref>, <ref loc="ISA 14:4">4</ref>; <ref loc="JER 4:19">Yer 4:19</ref>. </char>
    </note> Ku naahuriire, naagira orutetema omunda,</para>
  <para style="q1" vid="HAB 3:16">Eminwa yangye yaagira ekitengo ahabw'eryo iraka;</para>
  <para style="q1" vid="HAB 3:16">Okujunda kwantaaha omu magufa,</para>
  <para style="q1" vid="HAB 3:16">Amaguru ganjogajogoka.</para>
  <para style="q1" vid="HAB 3:16">Ndyategyereza eizooba ry'enaku, ntuurize,</para>
  <para style="q1" vid="HAB 3:16">Ku rihika aha bantu abarihurura kututeera.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />N'obu emitiini eraabe etarikurabya,</para>
  <para style="q1" vid="HAB 3:17">Emizaabibu etaine bijuma,</para>
  <para style="q1" vid="HAB 3:17">Emizeituuni ebuzire amajuta,</para>
  <para style="q1" vid="HAB 3:17">Emisiri etarikwera by'okurya,</para>
  <para style="q1" vid="HAB 3:17">Obusyo bw'entaama buhweire omu kibuga,</para>
  <para style="q1" vid="HAB 3:17">N'obw'ente buhweire omuka,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:18: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 13:15">Yob 13:15</ref>; <ref loc="PSA 9:14">Zab 9:14</ref>; <ref loc="LUK 1:47">Luk 1:47</ref>. </char>
    </note> Kwonka ndyashemerererwa MUKAMA,</para>
  <para style="q1" vid="HAB 3:18">Nyesiimire omuri Ruhanga ow'okujunwa kwangye.<verse eid="HAB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:19: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:13">Bir 32:13</ref>; <ref loc="2SA 2:18">2 Sam 2:18</ref>; <ref loc="ISA 38:20">Isa 38:20</ref>. </char>
    </note> RUHANGA Mukama niwe maani gangye;</para>
  <para style="q1" vid="HAB 3:19">Ahindura ebigyere byangye nk'eby'empara,</para>
  <para style="q1" vid="HAB 3:19">Kandi angyendesa omu myanya yangye etunguukire.</para>
  <para style="p" vid="HAB 3:19">Aha mukuru w'abeeshongozi byeshongorerwe aha nanga y'emirya.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>