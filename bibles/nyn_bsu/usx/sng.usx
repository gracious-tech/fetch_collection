<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">RRK22.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">EKYESHONGORO</para>
  <para style="toc1">Ekyeshongoro kya Sulemaani</para>
  <para style="toc2">Ekyeshongoro kya Sulemaani</para>
  <para style="toc3">Kyesh</para>
  <para style="mt1">EKYESHONGORO KYA SULEMAANI</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="s1">Ekyeshongoro kya kishwera na kisherwa ekirikumanyisa rukundo ya Kristo n'ey'Ekanisa ye</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:32">1 Bag 4:32</ref>. </char>
    </note> Ekyeshongoro kya Sulemaani ekirikukira byona.<verse eid="SNG 1:1" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Nkaabaasibwa ki, onnywegyera n'eminwa yaawe,</para>
  <para style="q1" vid="SNG 1:2">Ahabw'okuba okukunda kwawe nikumpitira viinyo;<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 7:1">Mub 7:1</ref>; <ref loc="JHN 12:3">Yoh 12:3</ref>. </char>
    </note> Amajuta gaawe g'okwesiiga garimu omugaju,</para>
  <para style="q1" vid="SNG 1:3">Eiziina ryawe ni nk'amajuta agashukirwe;</para>
  <para style="q1" vid="SNG 1:3">Nikyo empangare zikukundira.<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:14">Zab 45:14</ref>, <ref loc="PSA 45:15">15</ref>; <ref loc="JER 31:3">Yer 31:3</ref>; <ref loc="HOS 11:4">Hos 11:4</ref>; <ref loc="JHN 6:44">Yoh 6:44</ref>; <ref loc="PHP 3:12">Fil 3:12</ref>. </char>
    </note> Nyiriza ah'ori; nitwija kwiruka tukukuratiire.</para>
  <para style="q1" vid="SNG 1:4">Omugabe antaahize omu bishengye bye;</para>
  <para style="q1" vid="SNG 1:4">Nitwija kwesiima, tushemerererwe omuriiwe,</para>
  <para style="q1" vid="SNG 1:4">Tusingize okukunda kwawe okukira viinyo.</para>
  <para style="q1" vid="SNG 1:4">Eki barikukukundira n'eky'amazima.<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />Imwe baishiki ba Yerusaalemu 'mwe,</para>
  <para style="q1" vid="SNG 1:5">Niinyiragura, kwonka ndi murungi;</para>
  <para style="q1" vid="SNG 1:5">Ndi nk'amahema ga Kedari,</para>
  <para style="q1" vid="SNG 1:5">Nk'emikingo ya Sulemaani.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 8:11">Kyesh 8:11</ref>; <ref loc="1CO 9:27">1 Kor 9:27</ref>. </char>
    </note> Murekye kunshamaarira ahabw'okwiragura,</para>
  <para style="q1" vid="SNG 1:6">Ahakuba eizooba niryo ryanyokize.</para>
  <para style="q1" vid="SNG 1:6">Abaana ba maawe bakangirira ekiniga,</para>
  <para style="q1" vid="SNG 1:6">Bangira omurinzi w'emizaabibu,</para>
  <para style="q1" vid="SNG 1:6">Kwonka eyangye tinaagirinda!<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:7: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 34:14">Ezk 34:14</ref>, <ref loc="EZK 34:15">15</ref>. </char>
    </note> Iwe ou nkunda n'omutima gwangye gwona,</para>
  <para style="q1" vid="SNG 1:7">Ngambira ahu oriisiza obusyo bwawe,</para>
  <para style="q1" vid="SNG 1:7">N'ahu obuzaagiza omu ihangwe;</para>
  <para style="q1" vid="SNG 1:7">Ahabw'enki nimba nk'orikuzengyerera</para>
  <para style="q1" vid="SNG 1:7">Omu masyo ga bagyenzi baawe.<verse eid="SNG 1:7" /></para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />Iwe mukazi orikuhita abandi 'we,</para>
  <para style="q1" vid="SNG 1:8">Ku oraabe otarikuhamya,</para>
  <para style="q1" vid="SNG 1:8">Toora ekirari ky'obwo busyo haihi n'amahema g'abariisa,</para>
  <para style="q1" vid="SNG 1:8">Oriisizeyo abaana b'entaama.<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:9: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 1:16">2 Bus 1:16</ref>. </char>
    </note> Nkunzi yangye, ninkushushanisa n'ebuguma y'embaraasi y'ebigaari bya Faraho.<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:10: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 16:11">Ezk 16:11</ref>. </char>
    </note> Enshaya zaawe ni nungi, zirengyeirweho obutsibo bw'eishokye,</para>
  <para style="q1" vid="SNG 1:10">N'omu maraka gaawe harimu orukwanzi rw'amabaare ag'obuguzi bwingi.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />Nitwija kukukorera amahunde g'ezaabu</para>
  <para style="q1" vid="SNG 1:11">N'amapeesha g'efeeza.<verse eid="SNG 1:11" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:12: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 12:3">Yoh 12:3</ref>. </char>
    </note> Omugabe ku yaabaire aba ashutami aha kitabo kye,</para>
  <para style="q1" vid="SNG 1:12">amajuta gangye g'omugaju gataamirana.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Nkunzi yangye ahariinye ni nk'akashaho ka sumuruna</para>
  <para style="q1" vid="SNG 1:13">akari ahagati y'amabeere gangye.<verse eid="SNG 1:13" /></para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />Nkunzi yangye ni nk'enganda y'ebirabyo bya Koferi</para>
  <para style="q1" vid="SNG 1:14">Omu misiri y'emizaabibu ya Eni-geedi.<verse eid="SNG 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:1">Kyesh 4:1</ref>. </char>
    </note> Nkunzi yangye, ori murungi;</para>
  <para style="q1" vid="SNG 1:15">Eshi ori murungi, amaisho gaawe ni nk'ag'enkombe.<verse eid="SNG 1:15" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Nkunzi yangye, eshi ori murungi;</para>
  <para style="q1" vid="SNG 1:16">Buzimazima nooshemeza,</para>
  <para style="q1" vid="SNG 1:16">Kandi ekitanda kyaitu ni nk'obunyaatsi buto.<verse eid="SNG 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />Emitambiko y'enju yaitu n'emyereezi,</para>
  <para style="q1" vid="SNG 1:17">N'emiraba yaayo n'emiberooshi.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />Ndi nk'endungu ya Sharooni,</para>
  <para style="q1" vid="SNG 2:1">Omwangangye gw'omu mpita.<verse eid="SNG 2:1" /></para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Nk'omwangangye oku guba omu mahwa</para>
  <para style="q1" vid="SNG 2:2">Na nkunzi yangye nikwo aba omu baishiki.<verse eid="SNG 2:2" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 32:2">Isa 32:2</ref>. </char>
    </note> Nk'omucungwa omu biti by'omu ihamba,</para>
  <para style="q1" vid="SNG 2:3">Nikwo nkunzi yangye ari omu batsigazi.</para>
  <para style="q1" vid="SNG 2:3">Nkashutama ahansi y'ekicuucu kye n'okushemererwa kwingi,</para>
  <para style="q1" vid="SNG 2:3">Ebijuma bye byannurira;<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />Yantaasya omu nju y'obugyenyi,</para>
  <para style="q1" vid="SNG 2:4">Orurango rwe orwabaire ruri ahaiguru y'omutwe gwangye kukaba kuri okukunda.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Mpimbuuza otuzaabibu, onduhuuze otucungwa;</para>
  <para style="q1" vid="SNG 2:5">Ahabw'okuba rukundo n'ey'okuunyita.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 8:3">Kyesh 8:3</ref>. </char>
    </note> Nkaabaasibwa ki, omukono gwe gwa bumosho gunshegura,</para>
  <para style="q1" vid="SNG 2:6">N'ogwa buryo gunfumbata!<verse eid="SNG 2:6" /></para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 3:5">Kyesh 3:5</ref>; <ref loc="SNG 8:4">8:4</ref>. </char>
    </note> Imwe baishiki ba Yerusaalemu 'mwe</para>
  <para style="q1" vid="SNG 2:7">Nimbarahiza esirabo n'ebuguma y'empara,</para>
  <para style="q1" vid="SNG 2:7">Mutasisiimura nkunzi yangye, n'obu kwakuba okumwimutsya</para>
  <para style="q1" vid="SNG 2:7">Atakeeyendeire.<verse eid="SNG 2:7" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Hurira! Eiraka rya nkunzi yangye!</para>
  <para style="q1" vid="SNG 2:8">Ngugwo yaija aha nshozi naaguruka,</para>
  <para style="q1" vid="SNG 2:8">Naagurukagurukira omu bibungo.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Nkuunzi yangye ni nk'esirabo, nari eshonga y'empara;</para>
  <para style="q1" vid="SNG 2:9">Reeba, ayemereire enyima y'orugo rwaitu,</para>
  <para style="q1" vid="SNG 2:9">Naaringuririza omu madirisa,</para>
  <para style="q1" vid="SNG 2:9">Naayeyoreka nitumureebera omu mbazi zaago.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Nkunzi yangye yaagamba nangira ati:</para>
  <para style="q1" vid="SNG 2:10">Imuka, nkunzi yangye, murungi wangye, tugyendane;<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Ahakuba reeba, katumba ehweire,</para>
  <para style="q1" vid="SNG 2:11">Obunaku bw'enjura buhingwire;<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12: </char>
      <char style="xt" closed="false">
        <ref loc="JER 8:7">Yer 8:7</ref>. </char>
    </note> Ensi neetandika kurabya,</para>
  <para style="q1" vid="SNG 2:12">Obunaku bw'okweshongora bwahika,</para>
  <para style="q1" vid="SNG 2:12">N'eiraka ry'enkombe nirihurirwa omu nsi yaitu.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 7:12">Kyesh 7:12</ref>; <ref loc="MAT 24:32">Mat 24:32</ref>. </char>
    </note> Omutiini nigwera ebijuma byagwo,</para>
  <para style="q1" vid="SNG 2:13">N'emizaabibu neerabya, neetaamirana emigaju,</para>
  <para style="q1" vid="SNG 2:13">Imuka, nkunzi yangye, tugyendane.<verse eid="SNG 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:14: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 8:13">Kyesh 8:13</ref>; <ref loc="JER 48:28">Yer 48:28</ref>. </char>
    </note> Nkombe yangye, otuura omu bwatika bw'orukiri</para>
  <para style="q1" vid="SNG 2:14">N'omu nyanga z'amabaare,</para>
  <para style="q1" vid="SNG 2:14">Ka nkureebe ahamaisho, mpurire eiraka ryawe;</para>
  <para style="q1" vid="SNG 2:14">Ahabw'okuba eiraka ryawe nirishemeza,</para>
  <para style="q1" vid="SNG 2:14">N'aha maisho gaawe ni harungi.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />Mutukwatire zaamuha,</para>
  <para style="q1" vid="SNG 2:15">Bwamuha obuto oburikushiisha emizaabibu,</para>
  <para style="q1" vid="SNG 2:15">Ahabw'okuba emizaabibu neerabya.<verse eid="SNG 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:16: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 6:3">Kyesh 6:3</ref>. </char>
    </note> Nkunzi yangye n'owangye, naanye ndi owe;</para>
  <para style="q1" vid="SNG 2:16">Ariisiza obusyo bwe omu myangangye.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:17: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:6">Kyesh 4:6</ref>; <ref loc="JER 6:4">Yer 6:4</ref>. </char>
    </note> Okuhitsya obu burisheesha, ebibunda bikahwaho,</para>
  <para style="q1" vid="SNG 2:17">Nkunzi yangye, kubuuka, obe nk'esirabo</para>
  <para style="q1" vid="SNG 2:17">Nari eshonga y'empara aha nshozi za Beteeri.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="s1">Okusherura Kristo n'okumubona</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:7">Kyesh 1:7</ref>; <ref loc="SNG 5:6">5:6</ref>; <ref loc="ISA 26:9">Isa 26:9</ref>. </char>
    </note> Ku naabaire ndi aha kitanda kyangye nyekiro,</para>
  <para style="q1" vid="SNG 3:1">Naasherura ou omutima gwangye gukunda;</para>
  <para style="q1" vid="SNG 3:1">Naamusherura, kwonka tinaamureeba;<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Nikwo kugira nti: Ka nyimukye, ngyendagyende omu rurembo,</para>
  <para style="q1" vid="SNG 3:2">Omu nguuto n'omu nteeraniro z'emihanda,</para>
  <para style="q1" vid="SNG 3:2">Nsherure ou omutima gwangye gukunda.</para>
  <para style="q1" vid="SNG 3:2">Naamusherura, kwonka tinaamureeba.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:3: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 5:7">Kyesh 5:7</ref>. </char>
    </note> Abarinzi abarikugyendagyenda omu rurembo bandeeba;</para>
  <para style="q1" vid="SNG 3:3">Naababuuza nti: Mwareeba ou omutima gwangye gukunda?<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 8:2">Kyesh 8:2</ref>. </char>
    </note> Ku naabaire naabarugaho nti,</para>
  <para style="q1" vid="SNG 3:4">Naareeba ogwo ou omutima gwangye gukunda,</para>
  <para style="q1" vid="SNG 3:4">Naamukwata, naayanga kumurekura,</para>
  <para style="q1" vid="SNG 3:4">Okuhitsya obu naamuhikize omu nju ya maawe,</para>
  <para style="q1" vid="SNG 3:4">Omu kishengye ky'owanzaire.<verse eid="SNG 3:4" /></para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:5: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:7">Kyesh 2:7</ref>. </char>
    </note> Imwe baishiki ba Yerusaalemu 'mwe,</para>
  <para style="q1" vid="SNG 3:5">Nimbarahiza esirabo n'ebuguma y'empara,</para>
  <para style="q1" vid="SNG 3:5">Mutasiisimura nkunzi yangye, n'obu kwakuba okumwimutsya,</para>
  <para style="q1" vid="SNG 3:5">Atakeeyendeire.<verse eid="SNG 3:5" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 8:5">Kyesh 8:5</ref>. </char>
    </note> Oriya n'oha orikuruga omu ihamba,</para>
  <para style="q1" vid="SNG 3:6">Orikushusha enyomyo y'omwika,</para>
  <para style="q1" vid="SNG 3:6">Oyoteire sumuruna n'obubaane n'emigaju yoona ey'abashuubuzi?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Reeba, n'engozi ya Sulemaani</para>
  <para style="q1" vid="SNG 3:7">Eyeehinguririziibwe abashaija b'amaani makumi mukaaga</para>
  <para style="q1" vid="SNG 3:7">Ab'omu mamanzi ga Israeli;<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />Boona bahagatiire zaarurara, n'amahano omu kurwana;</para>
  <para style="q1" vid="SNG 3:8">Buri muntu aine rurara aha kibero kye</para>
  <para style="q1" vid="SNG 3:8">Ahabw'okutiina akabi nyekiro.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Omugabe Sulemaani akeekorera engozi y'ekitiinisa</para>
  <para style="q1" vid="SNG 3:9">Omu miti ya Lebanooni;<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Yaakora enyomyo zaayo omu feeza,</para>
  <para style="q1" vid="SNG 3:10">Eky'okwegamira kyayo kyaba eky'ezaabu,</para>
  <para style="q1" vid="SNG 3:10">Aharikushutamwa yaahakoresa omwenda gwa bujwa,</para>
  <para style="q1" vid="SNG 3:10">N'omunda yaayo haakorwa abaishiki ba Yerusaalemu na rukundo.<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:16">Isa 3:16</ref>; <ref loc="ISA 62:5">62:5</ref>. </char>
    </note> Imwe baishiki ba Saayuuni 'mwe, nimushohore,</para>
  <para style="q1" vid="SNG 3:11">Mureebe omugabe Sulemaani,</para>
  <para style="q1" vid="SNG 3:11">Aine ekirunga eki yaajwekirwe nyina</para>
  <para style="q1" vid="SNG 3:11">Aha izooba eri yaashwereireho,</para>
  <para style="q1" vid="SNG 3:11">Niryo izooba eri omutima gwe gwananukiireho.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="s1">Oburungi bw'omugore wa Kristo</para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:15">Kyesh 1:15</ref>; <ref loc="SNG 6:5">6:5</ref>. </char>
    </note> Eshi ori murungi, nkunzi yangye,</para>
  <para style="q1" vid="SNG 4:1">Buzimazima ori murungi!</para>
  <para style="q1" vid="SNG 4:1">Amaisho gaawe ni nk'ag'enkombe omu kyetwekyerero kyawe;</para>
  <para style="q1" vid="SNG 4:1">Eishokye ryawe ni nk'obusyo bw'embuzi</para>
  <para style="q1" vid="SNG 4:1">Ezibyami omu rukiizi rw'orushozi Gileadi;<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:2: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 6:6">Kyesh 6:6</ref>. </char>
    </note> Amaino gaawe ni nk'obusyo bw'entaama ezikyemwirwe,</para>
  <para style="q1" vid="SNG 4:2">Ezirikuruga kwogibwa;</para>
  <para style="q1" vid="SNG 4:2">Zoona zigira babiri, tihaine n'emwe efiisa.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Eminwa yaawe ni nka karari,</para>
  <para style="q1" vid="SNG 4:3">N'akanwa kaawe ni karungi,</para>
  <para style="q1" vid="SNG 4:3">Enshaya zaawe ni nk'embari y'eikomamahanga</para>
  <para style="q1" vid="SNG 4:3">omu kyetwekyerero kyawe;<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 7:4">Kyesh 7:4</ref>; <ref loc="NEH 3:19">Neh 3:19</ref>; <ref loc="EZK 27:11">Ezk 27:11</ref>. </char>
    </note> Ebitsya byawe ni nk'omunaara gwa Daudi,</para>
  <para style="q1" vid="SNG 4:4">Ogwayombekyeirwe okubiikamu eby'okurwanisa,</para>
  <para style="q1" vid="SNG 4:4">Oguhanikirwemu engabo rukumi,</para>
  <para style="q1" vid="SNG 4:4">Engabo zoona ez'amamanzi ge;<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 7:3">Kyesh 7:3</ref>. </char>
    </note> Amabeere gaawe ni nk'abaana b'esirabo</para>
  <para style="q1" vid="SNG 4:5">Abarikuriira omu myangangye.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:17">Kyesh 2:17</ref>. </char>
    </note> Okuhitsya obu buraasheeshe, ebibunda bikahwaho,</para>
  <para style="q1" vid="SNG 4:6">Niinyija kwegiira aha rushozi rwa sumuruna</para>
  <para style="q1" vid="SNG 4:6">N'aha kibungo ky'obubaane.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:7: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 5:2">Kyesh 5:2</ref>; <ref loc="EPH 5:27">Efe 5:27</ref>. </char>
    </note> Nkunzi yangye, ori murungi weena,</para>
  <para style="q1" vid="SNG 4:7">Toine kamogo.<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:8: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:9">Bir 3:9</ref>; <ref loc="1CH 5:23">1 Bus 5:23</ref>. </char>
    </note> Mugore wangye, ija turugye hamwe Lebanooni,</para>
  <para style="q1" vid="SNG 4:8">Turugye hamwe Lebanooni;</para>
  <para style="q1" vid="SNG 4:8">Naga amaisho nooyema aha mutwe gwa Amano,</para>
  <para style="q1" vid="SNG 4:8">Aha mutwe gwa Seniiri na Herumooni,</para>
  <para style="q1" vid="SNG 4:8">Ori omu nyanga z'entare, n'omu bibungo by'engwe.<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:9: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 5:1">Kyesh 5:1</ref>. </char>
    </note> Ontwaire omutima iwe munyaanyazi, mugore wangye;</para>
  <para style="q1" vid="SNG 4:9">ku ondeebeise oti eriisho, wantwara omutima</para>
  <para style="q1" vid="SNG 4:9">N'orukwanzi rw'omu maraka gaawe.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:10: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:2-4">Kyesh 1:2-4</ref>. </char>
    </note> Rukundo yaawe ka ni nungi, munyaanyazi mugore wangye!</para>
  <para style="q1" vid="SNG 4:10">Okukunda kwawe ka nikunkirira viinyo!</para>
  <para style="q1" vid="SNG 4:10">Kandi okutaamirana kw'amajuta gaawe nikunkirira emigaju y'emiringo yoona.<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:3">Enf 5:3</ref>; <ref loc="HOS 14:6">Hos 14:6</ref>. </char>
    </note> Eminwa yaawe, mugore wangye, neetoonya nk'omushongi;</para>
  <para style="q1" vid="SNG 4:11">Obwoki n'amate biri ahansi y'orurimi rwawe,</para>
  <para style="q1" vid="SNG 4:11">Okutaamirana kw'ebijwaro byawe ni nk'okwa Lebanooni.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:12: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 29:3">Kut 29:3</ref>; <ref loc="PRO 5:15">Enf 5:15</ref>. </char>
    </note> Iwe munyaanyazi mugore wangye, ori omusiri oguzitiire,</para>
  <para style="q1" vid="SNG 4:12">N'enshuro eigaire, n'eziba eryatairweho akamanyiso;<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Ebibyairwe byawe n'omusiri gw'amakomamahanga</para>
  <para style="q1" vid="SNG 4:13">Ogweramu ebijuma birungi by'emiringo yoona,</para>
  <para style="q1" vid="SNG 4:13">Koferi n'otuti twa narada,<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />Narada na karakoomu, kalamo na kinamoono,</para>
  <para style="q1" vid="SNG 4:14">N'ebiti byona eby'obubaane,</para>
  <para style="q1" vid="SNG 4:14">Surumuna na <note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">Ahalooti n'ekirikumera ekirikushusha enkaka. </char></note>ahalooti, n'eby'emigaju byona ebirikukira oburungi.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:15: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:10">Yoh 4:10</ref>, <ref loc="JHN 4:11">11</ref>. </char>
    </note> Ori enshuro eri ahagati y'emisiri,</para>
  <para style="q1" vid="SNG 4:15">Ori eiziba ery'amaizi g'amagara,</para>
  <para style="q1" vid="SNG 4:15">N'emigyera erikushuuma neeruga Lebanooni.<verse eid="SNG 4:15" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:16: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 6:2">Kyesh 6:2</ref>. </char>
    </note> Iwe muyaga gw'aha bukiizi-bwa-bumosho 'we, sisiimuka;</para>
  <para style="q1" vid="SNG 4:16">Naiwe ogw'aha bukiizi-bwa-buryo, rugayo!</para>
  <para style="q1" vid="SNG 4:16">Huuha omusiri gwangye, omugaju gwagwo gutaamirane hoona.</para>
  <para style="q1" vid="SNG 4:16">Ka nkunzi yangye aije omu musiri gwe,</para>
  <para style="q1" vid="SNG 4:16">Arye aha bijuma bye ebirikukira oburungi.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 6:2">Kyesh 6:2</ref>; <ref loc="JHN 3:29">Yoh 3:29</ref>. </char>
    </note> Naija omu musiri gwangye, iwe munyaanyazi mugore wangye,</para>
  <para style="q1" vid="SNG 5:1">Kushoroma sumuruna yangye n'emigaju yangye,</para>
  <para style="q1" vid="SNG 5:1">N'okurya engabo zangye n'obwoki bwamwo,</para>
  <para style="q1" vid="SNG 5:1">N'okunywa viinyo yangye n'amate gangye.</para>
  <para style="q1" vid="SNG 5:1">Imwe banywani bangye, nimurye, kandi munywe;</para>
  <para style="q1" vid="SNG 5:1">Buzimazima munywe munonga, nkunzi zangye!<verse eid="SNG 5:1" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:2: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:7">Kyesh 4:7</ref>. </char>
    </note> Nkaba ngwejegyeire, kwonka omutima gwangye nigureeba;</para>
  <para style="q1" vid="SNG 5:2">Naahurira eiraka rya nkunzi yangye naakongoota, naagira ati:</para>
  <para style="q1" vid="SNG 5:2">Nyigurira, munyaanyazi, nkunzi yangye,</para>
  <para style="q1" vid="SNG 5:2">Nkombe yangye, owangye oshugaine;</para>
  <para style="q1" vid="SNG 5:2">Ahakuba omutwe gwangye gutonzirweho orume,</para>
  <para style="q1" vid="SNG 5:2">N'eishokye ryangye ririmu amatondo ga nyekiro.<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:3: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:7">Luk 11:7</ref>. </char>
    </note> Naajwire ekijwaro kyangye,</para>
  <para style="q1" vid="SNG 5:3">Nimbaasa nta kukigarukamu?</para>
  <para style="q1" vid="SNG 5:3">Naanaabire ebigyere, ngarukye mbishiishe?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Nkunzi yangye yaayozya engaro ze omu kihengyere ky'orwigi,</para>
  <para style="q1" vid="SNG 5:4">Omutima gwangye gwaijura okushemererwa.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Naimuka kwigurira nkunzi yangye,</para>
  <para style="q1" vid="SNG 5:5">Engaro zangye nizitoonya sumuruna,</para>
  <para style="q1" vid="SNG 5:5">Sumuruna neeyagayaga aha nkumu zangye,</para>
  <para style="q1" vid="SNG 5:5">Yaatoonya aha byoma ebikinga orwigi.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:6: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 3:1">Kyesh 3:1</ref>; <ref loc="PRO 1:28">Enf 1:28</ref>. </char>
    </note> Baigurira nkunzi yangye;</para>
  <para style="q1" vid="SNG 5:6">Naashanga yaayegyendeire, atakiriho;</para>
  <para style="q1" vid="SNG 5:6">Kwonka obu yaabaire naagamba, omutima gukampuruutuka;</para>
  <para style="q1" vid="SNG 5:6">Naamusherura, yaamburira;</para>
  <para style="q1" vid="SNG 5:6">Naamweta, tiyaanyetaba.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:7: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 3:3">Kyesh 3:3</ref>. </char>
    </note> Abarinzi abaabaire bagyendagyenda omu rurembo</para>
  <para style="q1" vid="SNG 5:7">Bambugana, banteera, bamputaaza;</para>
  <para style="q1" vid="SNG 5:7">Abarinzi b'orugo rwarwo baanyaka omunagiro gwangye.<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:8: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:5">Kyesh 2:5</ref>, <ref loc="SNG 2:7">7</ref>. </char>
    </note> Imwe baishiki ba Yerusaalemu 'mwe, nimbarahiza,</para>
  <para style="q1" vid="SNG 5:8">Ku muraareebe nkunzi yangye, mumugambire</para>
  <para style="q1" vid="SNG 5:8">Ku rukundo erikwenda kuunyita.<verse eid="SNG 5:8" /></para>
  <para style="s1">Abaishiki ba Yerusaalemu</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />Beitu nkunzi yaawe naakiza ki abandi,</para>
  <para style="q1" vid="SNG 5:9">Iwe mukazi ohita abandi 'we?</para>
  <para style="q1" vid="SNG 5:9">Waaza kuturahiza otyo,</para>
  <para style="q1" vid="SNG 5:9">Nkunzi yaawe naakiza ki abandi?<verse eid="SNG 5:9" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />Nkunzi yangye naayera, naamwamwatikana,</para>
  <para style="q1" vid="SNG 5:10">Tarikubura mu bantu kakumi.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Omutwe gwe ni nk'ezaabu nungi munonga,</para>
  <para style="q1" vid="SNG 5:11">Eishokye rye n'omushasha,</para>
  <para style="q1" vid="SNG 5:11">Niriiragura nk'omubiri gw'ekikoona,<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:12: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:15">Kyesh 1:15</ref>. </char>
    </note> Amaisho ge ni nk'ag'enkombe eziri aha mugyera,</para>
  <para style="q1" vid="SNG 5:12">Googiibwe amate, geemi gye;<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Enshaya ze ni nk'akasiri k'emigaju erikutaamirana,</para>
  <para style="q1" vid="SNG 5:13">Eminwa ye ni nk'emyangangye erikutoonya sumuruna erikuyagayaga.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Engaro ze ni nk'empeta z'ezaabu ezirimu berulo;</para>
  <para style="q1" vid="SNG 5:14">Omubiri gwe ni nk'emiino y'enjojo ebaizirwe, ehunzirwe n'otubaare twa safiro;<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Amaguru ge ni nk'enyomyo za marimaari,</para>
  <para style="q1" vid="SNG 5:15">Ezibyairwe omu biina by'ezaabu nungi;</para>
  <para style="q1" vid="SNG 5:15">Emishusire ye ni nka Lebanooni,</para>
  <para style="q1" vid="SNG 5:15">Ni mirungi nk'emyereezi.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:2">Zab 45:2</ref>. </char>
    </note> Emigambire ye ni mirungi munonga;</para>
  <para style="q1" vid="SNG 5:16">Buzimazima ni murungi weena.</para>
  <para style="q1" vid="SNG 5:16">Imwe baishiki ba Yerusaalemu 'mwe,</para>
  <para style="q1" vid="SNG 5:16">Ogwo niwe nkunzi yangye, kandi niwe munywani wangye.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="s1">Abaishiki ba Yerusaalemu</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:8">Kyesh 1:8</ref>. </char>
    </note> Iwe mukazi ohita abandi 'we,</para>
  <para style="q1" vid="SNG 6:1">Nkunzi yaawe agiire hi?</para>
  <para style="q1" vid="SNG 6:1">Nkunzi yaawe yaagaruka hi,</para>
  <para style="q1" vid="SNG 6:1">Tukabona kumusherura naiwe?<verse eid="SNG 6:1" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:2: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:16">Kyesh 4:16</ref>. </char>
    </note> Nkunzi yangye yaashuuma omu musiri gwe,</para>
  <para style="q1" vid="SNG 6:2">Omu tusiri tw'emigaju,</para>
  <para style="q1" vid="SNG 6:2">Kuriisa obusyo bwe omu musiri,</para>
  <para style="q1" vid="SNG 6:2">N'okucwa emyangangye.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:3: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:16">Kyesh 2:16</ref>. </char>
    </note> Ndi owa nkunzi yangye na nkunzi yangye nawe n'owangye;</para>
  <para style="q1" vid="SNG 6:3">Ariisiza obusyo bwe omu myangangye.<verse eid="SNG 6:3" /></para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:2">Zab 50:2</ref>; <ref loc="LAM 2:15">Tonz 2:15</ref>. </char>
    </note> Nkunzi yangye, ori murungi nka Tiruza,</para>
  <para style="q1" vid="SNG 6:4">Oshemeire nka Yerusaalemu,</para>
  <para style="q1" vid="SNG 6:4">Nootinisa nk'eihe eririkugyenda n'endango.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5-7: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:1-3">Kyesh 4:1-3</ref>. </char>
    </note> Nyihaho amaisho, ahakuba gankozire kubi;</para>
  <para style="q1" vid="SNG 6:5">Eishokye ryawe ni nk'obusyo bw'embuzi</para>
  <para style="q1" vid="SNG 6:5">Ezibyami omu rukiizi rwa Gileadi;<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Amaino gaawe ni nk'obusyo bw'entaama</para>
  <para style="q1" vid="SNG 6:6">Ezirikuruga kwogibwa,</para>
  <para style="q1" vid="SNG 6:6">Zoona zigira babiri, tihaine n'emwe efiisa;<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Enshaya zaawe ni nk'embari z'eikomamahanga omu kyetwekyerero kyawe.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Hariho abagarire makumi mukaaga n'ebinyanshunju makumi munaana,</para>
  <para style="q1" vid="SNG 6:8">N'abaishiki batarikubarwa.<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />Kwonka nkombe yangye, owangye oshugaine, n'omwe wenka,</para>
  <para style="q1" vid="SNG 6:9">N'omwana omwe nyamunegyere ahari nyina,</para>
  <para style="q1" vid="SNG 6:9">Orikukundwa owaamuzaire.</para>
  <para style="q1" vid="SNG 6:9">Abaishiki ku baamureebire, baamweta ohiiriirwe,</para>
  <para style="q1" vid="SNG 6:9">Nangwa n'abaigarire n'ebinyanshunju baamusingiza.<verse eid="SNG 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Ogu n'oha owaija orikushusha nk'omushekye ogurikujuguta,</para>
  <para style="q1" vid="SNG 6:10">Murungi nk'okwezi, orikumurinkana nk'eizooba,</para>
  <para style="q1" vid="SNG 6:10">Orikutiinisa nk'eihe eririkugyenda n'endango?<verse eid="SNG 6:10" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:11: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 7:12">Kyesh 7:12</ref>. </char>
    </note> Nkashuuma omu musiri gw'ebinyoobwa</para>
  <para style="q1" vid="SNG 6:11">Kureeba ebimezire omu mpita,</para>
  <para style="q1" vid="SNG 6:11">kureeba yaaba omuzaabibu gutookire,</para>
  <para style="q1" vid="SNG 6:11">Nari amakomamahanga garabize.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Ntakakimanyire, omutima gwangye gwanta omu kigaari</para>
  <para style="q1" vid="SNG 6:12">Aha rubaju rw'omunyiginya mukama wangye.<verse eid="SNG 6:12" /></para>
  <para style="s1">Abaishiki ba Yerusaalemu</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Garuka, garuka, iwe Mushulaami 'we,</para>
  <para style="q1" vid="SNG 6:13">Garuka, garuka, tukwetegyereze.</para>
  <para style="s1" vid="SNG 6:13">Kishwerwa</para>
  <para style="q1" vid="SNG 6:13">Ahabw'enki nimwenda kwetegyereza Omushulaami</para>
  <para style="q1" vid="SNG 6:13">Nk'ekizino kya Mahanaimu?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="s1">Abaishiki ba Yerusaalemu</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:13">Zab 45:13</ref>. </char>
    </note> Iwe muhara w'omugabe 'we,</para>
  <para style="q1" vid="SNG 7:1">Ebigyere byawe ka nibishemera omu nkaito!</para>
  <para style="q1" vid="SNG 7:1">Enyugunyu zaawe ni nk'amabaare g'obuguzi bwingi,</para>
  <para style="q1" vid="SNG 7:1">Nomurimo gw'engaro z'omuhangu;<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Ekishoroshoro kyawe ni nk'ekikopo</para>
  <para style="q1" vid="SNG 7:2">Ekitakooshaga viinyo ejwangize;</para>
  <para style="q1" vid="SNG 7:2">Enda yaawe ni nk'ekirundo ky'engano</para>
  <para style="q1" vid="SNG 7:2">Ekyehinguririziibwe emyangangye;<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:3, 4: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:4">Kyesh 4:4</ref>, <ref loc="SNG 4:5">5</ref>. </char>
    </note> Amabeere gaawe ni nk'abaana b'esirabo babiri</para>
  <para style="q1" vid="SNG 7:3">Abaazairwe empasha.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Ebitsya byawe ni nk'omunaara gw'emiino y'enjojo;</para>
  <para style="q1" vid="SNG 7:4">Amaisho gaawe ni nk'ebiyanja bya Heshibooni</para>
  <para style="q1" vid="SNG 7:4">Ebiri aha irembo rya Batirabiimu;</para>
  <para style="q1" vid="SNG 7:4">Enyindo yaawe ni nk'omunaara gwa Lebanooni</para>
  <para style="q1" vid="SNG 7:4">Ogurikureeba Damasiko;<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Omutwe gwawe ni nka Karumeeli;</para>
  <para style="q1" vid="SNG 7:5">Eishokye ryawe ni nk'omwenda gwa bujwa,</para>
  <para style="q1" vid="SNG 7:5">Omugabe akwatwa obutsibo bwaryo nk'enkwatwa.<verse eid="SNG 7:5" /></para>
  <para style="s1">Kishwera</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Iwe orikukundwa, omwishiki orikurigirwa,</para>
  <para style="q1" vid="SNG 7:6">Eshi ori murungi kandi nooshemeza!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Ekyemerero kyawe ni nk'omukindo,</para>
  <para style="q1" vid="SNG 7:7">Amabeere gaawe ni nk'omutsitsa gwagwo.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />Ningira nti: Niinyija kutemba ogwo mukindo,</para>
  <para style="q1" vid="SNG 7:8">Nkwate amataagi gaagwo.</para>
  <para style="q1" vid="SNG 7:8">Nkaabaasibwa ki, amabeere gaawe gaba nk'ebijuma by'omuzaabibu,</para>
  <para style="q1" vid="SNG 7:8">n'okutaamirana kw'omwitsyo gwawe kuba nk'okw'emicungwa.<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />Akanwa kaawe kaba nka viinyo erikuhita ezindi,</para>
  <para style="q1" vid="SNG 7:9">Erikuraba omu kanwa n'omu maino,</para>
  <para style="q1" vid="SNG 7:9">Ekasheneneka gye aha mumiro.<verse eid="SNG 7:9" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:10: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:16">Kyesh 2:16</ref>; <ref loc="PSA 45:11">Zab 45:11</ref>. </char>
    </note> Ndi owa nkunzi yangye,</para>
  <para style="q1" vid="SNG 7:10">Kandi rukundo ye niinye eriho.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Nkunzi yangye, ija tugyendane omu ishwa,</para>
  <para style="q1" vid="SNG 7:11">Tuze omu birorero, tucumbikyeyo;<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:12: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:13">Kyesh 2:13</ref>, <ref loc="SNG 2:15">15</ref>; <ref loc="SNG 6:11">6:11</ref>. </char>
    </note> Tugurukire omu misiri y'emizaabibu,</para>
  <para style="q1" vid="SNG 7:12">Tureebe oku erikutooka,</para>
  <para style="q1" vid="SNG 7:12">Tureebe ku eraabe yaarabize,</para>
  <para style="q1" vid="SNG 7:12">N'amakomamahanga gaarabize.</para>
  <para style="q1" vid="SNG 7:12">Okwo niyo ndaakworekyere rukundo yangye.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:13: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:13">Kyesh 4:13</ref>; <ref loc="GEN 30:14">Kut 30:14</ref>. </char>
    </note> Amadudayimu gareeta okutaamirana,</para>
  <para style="q1" vid="SNG 7:13">Kandi aha muryango gwaitu hariho ebijuma binuzire</para>
  <para style="q1" vid="SNG 7:13">Eby'emiringo yoona, ebisya n'ebikuru,</para>
  <para style="q1" vid="SNG 7:13">Ebi naakubiikiire, iwe nkunzi yangye.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />Nkaabaasibwa ki, oba nka munyaanyazi,</para>
  <para style="q1" vid="SNG 8:1">Owaayonkire aha mabeere ga maawe!</para>
  <para style="q1" vid="SNG 8:1">Ku nkukubugaine aheeru, nkaakunywegyeire,</para>
  <para style="q1" vid="SNG 8:1">Kandi tihaine owaakungayire.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:2">Enf 9:2</ref>, <ref loc="PRO 9:5">5</ref>. </char>
    </note> Nkaakutwaire, nkuhitsya omu nju ya maawe,</para>
  <para style="q1" vid="SNG 8:2">Omu kishengye ky'ogwo owanzaire,</para>
  <para style="q1" vid="SNG 8:2">Nkunywaisa aha nturire ya viinyo</para>
  <para style="q1" vid="SNG 8:2">N'aha shande y'amakomamahanga gangye.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:3, 4: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:6">Kyesh 2:6</ref>, <ref loc="SNG 2:7">7</ref>. </char>
    </note> Nkaabaasibwa ki, omukono gwe gwa bumosho gunshegura,</para>
  <para style="q1" vid="SNG 8:3">N'ogwa buryo gunfumbata!<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />Imwe baishiki ba Yerusaalemu 'mwe, nimbarahiza,</para>
  <para style="q1" vid="SNG 8:4">Mutasisiimura nkunzi yangye, n'obu kwakuba okumwimutsya,</para>
  <para style="q1" vid="SNG 8:4">Atakeeyendeire.<verse eid="SNG 8:4" /></para>
  <para style="s1">Abaishiki ba Yerusaalemu</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Oriya orikwinamuka naaruga omu ihamba,</para>
  <para style="q1" vid="SNG 8:5">Ayegamiire nkunzi ye, n'oha?</para>
  <para style="s1" vid="SNG 8:5">Kishwera</para>
  <para style="q1" vid="SNG 8:5">Nkusisiimwire ahansi y'omucungwa,</para>
  <para style="q1" vid="SNG 8:5">Ahu nyoko yaarumiirwe naayenda kukuzaara;</para>
  <para style="q1" vid="SNG 8:5">Eego owaakuzaire niho yaarumiirwe.<verse eid="SNG 8:5" /></para>
  <para style="s1">Kishwerwa</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:6: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:24">Bir 4:24</ref>; <ref loc="PRO 6:34">Enf 6:34</ref>, <ref loc="PRO 6:35">35</ref>; <ref loc="ISA 49:16">Isa 49:16</ref>; <ref loc="ROM 8:35">Rom 8:35</ref>. </char>
    </note> Onte aha mutima gwawe nk'akamanyiso,</para>
  <para style="q1" vid="SNG 8:6">Kandi onte n'aha mukono gwawe;</para>
  <para style="q1" vid="SNG 8:6">Ahabw'okuba rukundo n'ey'amaani nka rufu,</para>
  <para style="q1" vid="SNG 8:6">Kandi okufuuha tikusaasira, ni nk'ekituuro;</para>
  <para style="q1" vid="SNG 8:6">Endimi zaakwo nizityankana nk'ez'omuriro,</para>
  <para style="q1" vid="SNG 8:6">Nk'ez'omuriro ogurikurya busha.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Amaizi maingi tigarikubaasa kuraaza rukundo,</para>
  <para style="q1" vid="SNG 8:7">N'emyegyemure tekaagimira;</para>
  <para style="q1" vid="SNG 8:7">Omuntu n'obu yaakuhayo ebi atungire omu ka ye byona,</para>
  <para style="q1" vid="SNG 8:7">Bikaagayirwa kimwe.<verse eid="SNG 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />Twine murumuna waitu omuto,</para>
  <para style="q1" vid="SNG 8:8">Takashunire mabeere.</para>
  <para style="q1" vid="SNG 8:8">Mbwenu turyamugira tuta</para>
  <para style="q1" vid="SNG 8:8">Aha izooba eri arigambirwaho obugyenyi?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Ku ariba orugo rw'amabaare,</para>
  <para style="q1" vid="SNG 8:9">Turyamwombekaho omunaara gw'efeeza;</para>
  <para style="q1" vid="SNG 8:9">Kwonka ku ariba omuryango,</para>
  <para style="q1" vid="SNG 8:9">Turyamukingisa embaaho z'emyereezi.<verse eid="SNG 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />Nyowe nkaba ndi orugo rw'amabaare;</para>
  <para style="q1" vid="SNG 8:10">N'amabeere gangye gari nk'eminaara</para>
  <para style="q1" vid="SNG 8:10">Okuruga obwo naagira obusingye omu maisho ge.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 7:23">Isa 7:23</ref>; <ref loc="MAT 21:33">Mat 21:33</ref>. </char>
    </note> Sulemaani akaba aine omusiri gw'emizaabibu Baali-hamoni,</para>
  <para style="q1" vid="SNG 8:11">Yaagutamu abarinzi,</para>
  <para style="q1" vid="SNG 8:11">Buri muntu okuguma naaha ebicweka by'efeeza ahabw'ebijuma byamwo.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />Omusiri gwangye gw'emizaabiru n'ogwangye ahabwangye.</para>
  <para style="q1" vid="SNG 8:12">Iwe Sulemaani, oryaheebwa rukumi rwawe,</para>
  <para style="q1" vid="SNG 8:12">N'abarinzi b'ebijuma baheebwe magana abiri.<verse eid="SNG 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:13: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:7">Kyesh 1:7</ref>; <ref loc="SNG 2:14">2:14</ref>; <ref loc="SNG 5:1">5:1</ref>. </char>
    </note> Iwe otuura omu misiri,</para>
  <para style="q1" vid="SNG 8:13">Bagyenzi bangye nibenda kuhurira ebi orikugamba;</para>
  <para style="q1" vid="SNG 8:13">Naanye ka mbihurire.<verse eid="SNG 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:14: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:17">Kyesh 2:17</ref>. </char>
    </note> Nkunzi yangye, rahuka, obe nk'esirabo,</para>
  <para style="q1" vid="SNG 8:14">Nari nk'eshonga y'empara</para>
  <para style="q1" vid="SNG 8:14">Aha nshozi z'eby'emigaju.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>