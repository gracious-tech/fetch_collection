<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">RRK20.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">ENFUMU</para>
  <para style="toc1">Ekitabo Ky'Enfumu</para>
  <para style="toc2">Enfumu</para>
  <para style="toc3">Enf</para>
  <para style="mt2">EKITABO</para>
  <para style="mt1">KY'ENFUMU</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:32">1 Bag 4:32</ref>; <ref loc="PRO 10:1">Enf 10:1</ref>; <ref loc="PRO 25:1">25:1</ref>; <ref loc="ECC 12:9">Mub 12:9</ref>. </char>
    </note> Enfumu za Sulemaani mwene Daudi, omugabe wa Israeli,<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Ez'okumanyisa obwengye n'okuhabura,</para>
  <para style="q1" vid="PRO 1:2">N'ez'okushoboorora ebigambo ebirimu okwetegyereza,<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:9">Enf 2:9</ref>. </char>
    </note> Ez'okwegyesa okukoresa obwengye</para>
  <para style="q1" vid="PRO 1:3">Omu kuhikiirira, omu buryo n'omu bwinganisa;<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Okuhaisa otaine bwengye okwerinda;</para>
  <para style="q1" vid="PRO 1:4">N'omutsigazi okumuha okumanya obwerinzi,<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Ngu omunyabwengye ahurire, ayeyongyere kwega,</para>
  <para style="q1" vid="PRO 1:5">Kandi omushaija oine okwetegyereza atungye obwengye obuhikire;<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:2">Zab 78:2</ref>. </char>
    </note> Okumanya enfumu n'eby'okurengyezana,</para>
  <para style="q1" vid="PRO 1:6">Ebigambo by'abanyabwengye n'ebishaakuzo.<verse eid="PRO 1:6" /></para>
  <para style="s1">Ebirikuhabura okureka emicwe mibi</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:10">Enf 9:10</ref>; <ref loc="PRO 15:33">15:33</ref>; <ref loc="PSA 111:10">Zab 111:10</ref>; <ref loc="JOB 28:28">Yob 28:28</ref>. </char>
    </note> Okutiina MUKAMA niyo ntandikiro y'okumanya,</para>
  <para style="q1" vid="PRO 1:7">Kwonka abashema bagaya obwengye n'okuhaburwa.<verse eid="PRO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Mwana wangye, guma ohurire ebi sho arikukuhabura,</para>
  <para style="q1" vid="PRO 1:8">Kandi otanga ebi nyoko arikukwegyesa;<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:9: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:42">Kut 41:42</ref>; <ref loc="DAN 5:29">Dan 5:29</ref>. </char>
    </note> Ahabw'okuba biryaba eihunde aha mutwe gwawe,</para>
  <para style="q1" vid="PRO 1:9">Kandi emikuufu omu bitsya byawe.<verse eid="PRO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Mwana wangye, abasiisi ku barikubeihabeiha,</para>
  <para style="q1" vid="PRO 1:10">Otariikiriza.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Ku barigira ngu, Ija tugyendane, tugwere ab'okwita,</para>
  <para style="q1" vid="PRO 1:11">N'abataine rubanja tubature busha,<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:12: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:32">Kub 16:32</ref>, <ref loc="NUM 16:33">33</ref>. </char>
    </note> Tubamire bahuriire, nk'oku</para>
  <para style="q1" vid="PRO 1:12">Okuzimu emira abantu bashugaine,</para>
  <para style="q1" vid="PRO 1:12">Nk'abo abashuuma omu Kiina;<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Turyagwa aha bintu by'obuguzi bwingi,</para>
  <para style="q1" vid="PRO 1:13">Twijuze amaka gaitu eminyago;<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Mbwenu kwatanisa naitwe,</para>
  <para style="q1" vid="PRO 1:14">Twena tugire enshaho emwe;<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:1">Zab 1:1</ref>. </char>
    </note> Mwana wangye, otarigyenda nabo,</para>
  <para style="q1" vid="PRO 1:15">N'obu kwakuba okwimutsya ekigyere kyawe kutoora emihanda yaabo;<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:16: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 59:7">Isa 59:7</ref>; <ref loc="ROM 3:15">Rom 3:15</ref>. </char>
    </note> Ahabw'okuba ebigyere byabo biirukira ebibi,</para>
  <para style="q1" vid="PRO 1:16">Birahuka kusheesha eshagama.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Manya, okutega omutego enyonyi neegureeba,</para>
  <para style="q1" vid="PRO 1:17">N'okweruhiza busha.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Kwonka abo bantu baba nibagwera eshagama yaabo bonka,</para>
  <para style="q1" vid="PRO 1:18">Nibagira amagara gaabo omu kyetindo.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Niyo mihanda y'abo boona abagira omururu gw'amagoba,</para>
  <para style="q1" vid="PRO 1:19">Gaihaho amagara ga bakama baago.<verse eid="PRO 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:1-3">Enf 8:1-3</ref>; <ref loc="PRO 9:3">9:3</ref>. </char>
    </note> Bwengye naayeta naayamuriza omu nguuto,</para>
  <para style="q1" vid="PRO 1:20">Eiraka rye naariimukiza omu butare.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Naayetera aha mutwe gw'engo z'amabaare z'orurembo,</para>
  <para style="q1" vid="PRO 1:21">Aha marembo gaarwo niho arikugambira ebigambo bye, naagira ati:<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />Imwe abataine bwengye, muryahitsya hi okukunda okutagira bwengye?</para>
  <para style="q1" vid="PRO 1:22">Abateezi b'enaku baryahitsya hi okwesiimira okuteera enaku kwabo,</para>
  <para style="q1" vid="PRO 1:22">N'abashema okwanga okumanya?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:23: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:28">Yoel 2:28</ref>. </char>
    </note> Mute omutima aha kuhana kwangye;</para>
  <para style="q1" vid="PRO 1:23">Reeba, naaza kushuka Omwoyo wangye ahariimwe,</para>
  <para style="q1" vid="PRO 1:23">Mbamanyise ebigambo byangye.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:24: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 65:12">Isa 65:12</ref>; <ref loc="JER 7:13">Yer 7:13</ref>; <ref loc="ZEC 7:11">Zek 7:11</ref>; <ref loc="ROM 10:21">Rom 10:21</ref>. </char>
    </note> Ahabw'okubeeta, mukanga kuhurira,</para>
  <para style="q1" vid="PRO 1:24">Nkatega emikono, hakabura owaakitaho omutima;<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:11">Zab 107:11</ref>; <ref loc="LUK 7:30">Luk 7:30</ref>. </char>
    </note> Ahabw'okuteeta ha kuhabura kwangye kwona,</para>
  <para style="q1" vid="PRO 1:25">Mukangira kimwe okuhana kwangye,<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:4">Zab 2:4</ref>. </char>
    </note> Naanye ndyasheka omu bunaku bw'ebihikiirizi byanyu;</para>
  <para style="q1" vid="PRO 1:26">Ndyabateerera enaku, ekimurikutiina kyabahikaho.<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />Ekirikubatiinisa ku kiriija nk'eihunga,</para>
  <para style="q1" vid="PRO 1:27">N'ebihikiirizi byanyu byaija nk'omuyaga gw'akasooroora,</para>
  <para style="q1" vid="PRO 1:27">Mwagira enaku n'obusaasi,<verse eid="PRO 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:28: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 8:18">1 Sam 8:18</ref>; <ref loc="MIC 3:4">Mik 3:4</ref>. </char>
    </note> Obwo baryantakira, kwonka tindigarukamu;</para>
  <para style="q1" vid="PRO 1:28">Baryayezirika kunsherura, kwonka tibarindeeba.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:29: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:14">Yob 21:14</ref>. </char>
    </note> Ahabw'okwanga okumanya,</para>
  <para style="q1" vid="PRO 1:29">N'okwihamu okutiina MUKAMA,<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:30: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:11">Zab 107:11</ref>. </char>
    </note> Bakangira kimwe okuhabura kwangye,</para>
  <para style="q1" vid="PRO 1:30">Bakagaya okuhana kwangye kwona,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:31: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:19">Yer 6:19</ref>. </char>
    </note> Nikyo baririira ebyana by'emitwarize yaabo,</para>
  <para style="q1" vid="PRO 1:31">Bakaiguta enaama zaabo mbi.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:32: </char>
      <char style="xt" closed="false">
        <ref loc="JER 2:19">Yer 2:19</ref>. </char>
    </note> Ahabw'okuba okugaruka enyima kw'abataine bwengye kuryabaita,</para>
  <para style="q1" vid="PRO 1:32">N'okugogyera kw'abashema kuryabacwekyereza;<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:33: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:13">Zab 25:13</ref>; <ref loc="PSA 112:7">112:7</ref>. </char>
    </note> Kwonka weena orikumpurira aryatuura buhooro,</para>
  <para style="q1" vid="PRO 1:33">Agume agaramisiriize, ataine kabi k'arikutiina.<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Omugasho gw'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Mwana wangye, ku oraikirize ebigambo byangye,</para>
  <para style="q1" vid="PRO 2:1">Waagumya ebiragiro byangye aha mutima,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />Waatega okutu kwawe obwengye,</para>
  <para style="q1" vid="PRO 2:2">Omutima gwawe waaguta aha kwetegyereza;<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />Eego, ku oriririra obwengye bw'okukyenga,</para>
  <para style="q1" vid="PRO 2:3">Eiraka waariimutsya nooshaba okwetegyereza,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />Waakusherura nk'efeeza,</para>
  <para style="q1" vid="PRO 2:4">Waakuronda nk'eky'eitungo ekisherekirwe,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />Obwo nibwo orishoborokyerwa okutiina MUKAMA,</para>
  <para style="q1" vid="PRO 2:5">okazoora okumanya Ruhanga;<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 32:8">Yob 32:8</ref>. </char>
    </note> Ahakuba MUKAMA niwe aha obwengye,</para>
  <para style="q1" vid="PRO 2:6">Kandi omu kanwa ke nimwo haruga okumanya n'okwetegyereza;<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 84:11">Zab 84:11</ref>. </char>
    </note> Abaine emitima egororokire ababiikira obwengye obuhikire,</para>
  <para style="q1" vid="PRO 2:7">Kandi abagyendera omu bwesigwa ababeera engabo;<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:9">1 Sam 2:9</ref>. </char>
    </note> Arinda emihanda y'eby'oburyo,</para>
  <para style="q1" vid="PRO 2:8">Kandi n'abarikwera be abarinda omu mihanda yaabo.<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Obwo oryamanya okuhikiirira n'eby'oburyo,</para>
  <para style="q1" vid="PRO 2:9">N'obwinganisa, na buri muhanda gwona omurungi;<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Ahabw'okuba obwengye buryataaha omu mutima gwawe,</para>
  <para style="q1" vid="PRO 2:10">N'amagara gaawe gashemerererwe okumanya.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:22">Enf 6:22</ref>. </char>
    </note> Okwerinda kuryakureeberera,</para>
  <para style="q1" vid="PRO 2:11">N'okwetegyereza kukurinde,<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Kukwihe omu mihanda y'obubi,</para>
  <para style="q1" vid="PRO 2:12">Kukujune abantu abarikugamba eby'obutahurira,<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 82:5">Zab 82:5</ref>; <ref loc="JHN 3:19">Yoh 3:19</ref>, <ref loc="JHN 3:20">20</ref>. </char>
    </note> Abareka emihanda ehikire,</para>
  <para style="q1" vid="PRO 2:13">Bakagyendera omu mihanda y'omwirima,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:14: </char>
      <char style="xt" closed="false">
        <ref loc="JER 11:15">Yer 11:15</ref>. </char>
    </note> Abeesiima nibakora ebibi,</para>
  <para style="q1" vid="PRO 2:14">Bakashemerererwa obutahurira bw'abanyabibi,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 125:5">Zab 125:5</ref>. </char>
    </note> Abantu abatoora emihanda etegami,</para>
  <para style="q1" vid="PRO 2:15">Kandi abu emitwarize yaabo etagororokire.<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:5">Enf 7:5</ref>. </char>
    </note> Oryajunwa omu mikono y'omukazi enshambani,</para>
  <para style="q1" vid="PRO 2:16">Omukazi owaariire enshoni, owa karimi karungi,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:17: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 2:14">Mal 2:14</ref>, <ref loc="MAL 2:15">15</ref>. </char>
    </note> Owaataine n'owaabaire amushweire omu buhangare bwe,</para>
  <para style="q1" vid="PRO 2:17">Kandi akeebwa endagaano ya Ruhanga we;<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:27">Enf 7:27</ref>. </char>
    </note> Ahabw'okuba enju ye neeza omu kufa,</para>
  <para style="q1" vid="PRO 2:18">N'emihanda ye neeshuuma omu bafu.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Abaza owe tibagaruka,</para>
  <para style="q1" vid="PRO 2:19">N'obu kwakuba okugaruka omu muhanda gw'amagara.<verse eid="PRO 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />N'ahabw'ekyo oshemereire kugyendera omu mihanda y'abarungi,</para>
  <para style="q1" vid="PRO 2:20">N'okugumira omu mihanda y'abahikiriire;<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:9">Zab 37:9</ref>. </char>
    </note> Ahabw'okuba ab'emitima egororokire nibo batuura omu nsi,</para>
  <para style="q1" vid="PRO 2:21">N'abeesigwa bakagigumamu;<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:38">Zab 37:38</ref>; <ref loc="PSA 52:5">52:5</ref>. </char>
    </note> Kwonka ababi baryamarwaho omu nsi,</para>
  <para style="q1" vid="PRO 2:22">Kandi abarikureebya baryagikuurirwamu kimwe.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Oku abantu bashemereire kuba ahari Ruhanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 8:1">Bir 8:1</ref>. </char>
    </note> Mwana wangye, oteebwa okwegyesa kwangye,</para>
  <para style="q1" vid="PRO 3:1">Kureka omutima gwawe gugume gworobere ebiragiro byangye;<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:11">Enf 9:11</ref>; <ref loc="PSA 119:165">Zab 119:165</ref>. </char>
    </note> Ahakuba ebyo biryakureetera kugira ebiro bingi,</para>
  <para style="q1" vid="PRO 3:2">N'emyaka mingi, n'okuba gye munonga omu magara gaawe.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:9">Enf 1:9</ref>; <ref loc="PRO 7:3">7:3</ref>; <ref loc="PSA 85:10">Zab 85:10</ref>; <ref loc="JER 17:1">Yer 17:1</ref>; <ref loc="2CO 3:3">2 Kor 3:3</ref>. </char>
    </note> Embabazi n'obwesigwa birekye kukurugaho, obijware omu maraka,</para>
  <para style="q1" vid="PRO 3:3">Obihandiikye aha kishate ky'omutima gwawe.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:26">1 Sam 2:26</ref>; <ref loc="LUK 2:52">Luk 2:52</ref>; <ref loc="ROM 14:18">Rom 14:18</ref>. </char>
    </note> Obwo nibwo oraashongokye, okagira eiziina rirungi</para>
  <para style="q1" vid="PRO 3:4">Omu maisho ga Ruhanga n'abantu.<verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:3">Zab 37:3</ref>; <ref loc="JER 9:23">Yer 9:23</ref>. </char>
    </note> Yesigye MUKAMA n'omutima gwawe gwona,</para>
  <para style="q1" vid="PRO 3:5">Orekye kwegamira okwetegyereza kwawe ahabwawe;<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 28:9">1 Bus 28:9</ref>; <ref loc="JER 10:23">Yer 10:23</ref>. </char>
    </note> Omwemere omu mitwarize yaawe yoona,</para>
  <para style="q1" vid="PRO 3:6">Nawe aryaguma naatebeekanisa emihanda yaawe yoona.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Yob 28:28</ref>; <ref loc="ROM 12:16">Rom 12:16</ref>. </char>
    </note> Reka kwemanya obwengye;</para>
  <para style="q1" vid="PRO 3:7">Tiina MUKAMA, orugye omu bibi.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Kiryaba eky'okutambira omubiri gwawe,</para>
  <para style="q1" vid="PRO 3:8">Kandi ekirikuruhuura amagufa gaawe.<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:19">Kur 23:19</ref>. </char>
    </note> Haisa MUKAMA ekitiinisa ebintu byawe,</para>
  <para style="q1" vid="PRO 3:9">Kandi n'emiganuro y'ebi oyerize.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:8">Bir 28:8</ref>. </char>
    </note> Obwo ebitara byawe biryaijura n'aha bunwa,</para>
  <para style="q1" vid="PRO 3:10">N'amaato gaawe garyaijura viinyo, esheeshekye.<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11, 12: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 8:5">Bir 8:5</ref>; <ref loc="JOB 5:17">Yob 5:17</ref>; <ref loc="1CO 11:32">1 Kor 11:32</ref>; <ref loc="HEB 12:5">Heb 12:5</ref>, <ref loc="HEB 12:6">6</ref>; <ref loc="REV 3:19">Kush 3:19</ref>. </char>
    </note> Mwana wangye, otarigaya okutegyeka kwa MUKAMA,</para>
  <para style="q1" vid="PRO 3:11">N'obu kwakuba okutamwa okuhana kwe;<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Ahakuba ou MUKAMA akunda, amuhana,</para>
  <para style="q1" vid="PRO 3:12">Nk'oku ishe w'omwana ahana omwana we ou ashemerererwa,<verse eid="PRO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Ohiiriirwe n'omuntu ozoora obwengye,</para>
  <para style="q1" vid="PRO 3:13">Kandi n'omuntu otunga okwetegyereza;<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:14, 15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:10">Enf 8:10</ref>, <ref loc="PRO 8:11">11</ref>; <ref loc="JOB 28:15-18">Yob 28:15-18</ref>. </char>
    </note> Ahabw'okuba omugasho ogurimu nigukira ogw'omu feeza,</para>
  <para style="q1" vid="PRO 3:14">Kandi n'amagoba gaabwo nigakira ag'ezaabu;<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />N'obw'obuguzi bwingi okukira amabaare g'omuhendo,</para>
  <para style="q1" vid="PRO 3:15">Kandi omu bi waakwetenga byona, tihaine kirikwingana nabwo.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:18">Enf 8:18</ref>. </char>
    </note> Okuhangaara kuri omu mukono gwabwo gwa buryo,</para>
  <para style="q1" vid="PRO 3:16">N'omu gwa bumosho harimu obutungi n'ekitiinisa.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Emihanda yaabwo n'emihanda erikugwisa gye,</para>
  <para style="q1" vid="PRO 3:17">N'otuhanda twabwo twona n'obusingye.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:18: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 2:9">Kut 2:9</ref>; <ref loc="GEN 3:22">3:22</ref>; <ref loc="REV 2:7">Kush 2:7</ref>; <ref loc="REV 22:2">22:2</ref>. </char>
    </note> N'omuti gw'amagara aha barikubukwata,</para>
  <para style="q1" vid="PRO 3:18">N'abarikubuhamya nibeetwa abahiiriirwe.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:27">Enf 8:27</ref>; <ref loc="PSA 104:24">Zab 104:24</ref>; <ref loc="PSA 136:5">136:5</ref>. </char>
    </note> MUKAMA ahabw'obwengye bwe akahanga ensi,</para>
  <para style="q1" vid="PRO 3:19">N'eiguru yaarihamya ahabw'okwetegyereza kwe.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:20: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 7:11">Kut 7:11</ref>; <ref loc="DEU 33:28">Bir 33:28</ref>; <ref loc="JOB 38:8">Yob 38:8</ref>. </char>
    </note> Ahabw'okumanya kwe enshuro z'okuzimu zikafumuka,</para>
  <para style="q1" vid="PRO 3:20">N'ebicu byatoonya orume ahansi.<verse eid="PRO 3:20" /></para>
  <para style="s1">Oku abantu bashemereire kuba aha bandi</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Mwana wangye, guma n'obwengye obuhikire, n'okwerinda;</para>
  <para style="q1" vid="PRO 3:21">Otaribireka bikakurugaho.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:9">Enf 1:9</ref>; <ref loc="DEU 32:47">Bir 32:47</ref>. </char>
    </note> Ebyo biryahangaaza amagara gaawe,</para>
  <para style="q1" vid="PRO 3:22">Kandi bikubeere eby'okwehunda omu maraka.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:11">Zab 91:11</ref>, <ref loc="PSA 91:12">12</ref>. </char>
    </note> Nibwo origyenda omu muhanda gwawe buhooro,</para>
  <para style="q1" vid="PRO 3:23">N'ekigyere kyawe kitateere ntsibo.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:24: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:6">Lev 26:6</ref>; <ref loc="JER 31:26">Yer 31:26</ref>. </char>
    </note> Ku orishutama, toritiina;</para>
  <para style="q1" vid="PRO 3:24">Ku oribyama, oturo turyakunurira.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:25: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:21">Yob 5:21</ref>; <ref loc="PSA 91:5">Zab 91:5</ref>. </char>
    </note> Otaritiina okukangwa kw'ahonaaho,</para>
  <para style="q1" vid="PRO 3:25">Nari okuhwerekyerera kw'ababi kwabaho,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Ahabw'okuba MUKAMA aryaba obwesigye bwawe,</para>
  <para style="q1" vid="PRO 3:26">Kandi arinde ekigyere kyawe kirekye kukwatwa omutego.<verse eid="PRO 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:27: </char>
      <char style="xt" closed="false">
        <ref loc="GAL 6:10">Gal 6:10</ref>. </char>
    </note> Ebirungi ebiri omu bushoboorozi bwawe,</para>
  <para style="q1" vid="PRO 3:27">Otaribiima ababishemereire.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:28: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:13">Lev 19:13</ref>; <ref loc="DEU 24:15">Bir 24:15</ref>. </char>
    </note> Otarigira mutaahi waawe oti: Irooko ogarukye;</para>
  <para style="q1" vid="PRO 3:28">Nyencakare nkikuhe.</para>
  <para style="q1" vid="PRO 3:28">Haza obwo okiine.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Otarigirira mutaahi waawe enaama mbi,</para>
  <para style="q1" vid="PRO 3:29">Ou otwire nawe naakwesiga.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Otaritonganisiza busha omuntu weena,</para>
  <para style="q1" vid="PRO 3:30">Ataine ki akwitsize.<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:1">Zab 37:1</ref>. </char>
    </note> Otarigirira eihari orikunyagisa abandi amaani,</para>
  <para style="q1" vid="PRO 3:31">Kandi omu mitwarize ye otarigira ei waamwegaho;<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:32: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:4">Yob 29:4</ref>. </char>
    </note> Ahakuba omuntu orikwehabagiza n'ekirikunugwa ahari Ruhanga,</para>
  <para style="q1" vid="PRO 3:32">Kwonka ab'omutima ogugororokire abeesiga.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:33: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 8:6">Yob 8:6</ref>; <ref loc="ZEC 5:4">Zek 5:4</ref>. </char>
    </note> Omukyeeno gwa MUKAMA guri aha nju y'ababi,</para>
  <para style="q1" vid="PRO 3:33">Kwonka obutaaho bw'abahikiriire abuha omugisha.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:26">Zab 18:26</ref>; <ref loc="JAS 4:6">Yak 4:6</ref>; <ref loc="1PE 5:5">1 Pet 5:5</ref>. </char>
    </note> Aha barikugaya, aba omugayi;</para>
  <para style="q1" vid="PRO 3:34">Kwonka abacureezi abagirira embabazi.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:35: </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:19">Fil 3:19</ref>. </char>
    </note> Ab'obwengye baryahungura ekitiinisa,</para>
  <para style="q1" vid="PRO 3:35">Kwonka abashema baryahemuka.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Omugisha oguheebwa abanyabwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Baana bangye, mugume mutegye amatu okwegyesa kwa shoimwe,</para>
  <para style="q1" vid="PRO 4:1">Kandi mukuteho omutima, mubone kugira okwetegyereza;<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Ahabw'okuba nimbaha ebiragiro birungi,</para>
  <para style="q1" vid="PRO 4:2">Mutarireka okwegyesa kwangye.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Ku naabaire ndi omwana, ndi hamwe na tata,</para>
  <para style="q1" vid="PRO 4:3">Ndi omwana orikworoba, kandi omwe wenka ahari maawe,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 18:5">Lev 18:5</ref>; <ref loc="ISA 55:3">Isa 55:3</ref>. </char>
    </note> Tata akanyegyesa, yangira ati:</para>
  <para style="q1" vid="PRO 4:4">Omutima gwawe gugume guhamye ebigambo byangye,</para>
  <para style="q1" vid="PRO 4:4">Oyorobere ebiragiro byangye, obone kugumaho.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:2">Enf 2:2</ref>. </char>
    </note> Otaryebwa ebigambo by'omu kanwa kangye, kandi otaribireka.</para>
  <para style="q1" vid="PRO 4:5">Gira obwengye; gira okwetegyereza.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6: </char>
      <char style="xt" closed="false">
        <ref loc="2TH 2:10">2 Tes 2:10</ref>. </char>
    </note> Otaribureka, nibwo burikugumyaho;</para>
  <para style="q1" vid="PRO 4:6">Obukunde, buryakurinda.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Obwengye n'ekintu kikuru; gira obwengye;</para>
  <para style="q1" vid="PRO 4:7">Ebi otungire byona, obisheruze okwetegyereza.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:8: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:30">1 Sam 2:30</ref>. </char>
    </note> Obusingize munonga, nabwo buryakutunguura;</para>
  <para style="q1" vid="PRO 4:8">Ku oribubumbatira, buryakuhaisa ekitiinisa.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:9">Enf 1:9</ref>. </char>
    </note> Buryakujweka eihunde rirungi aha mutwe,</para>
  <para style="q1" vid="PRO 4:9">Kandi bukuteho ekirunga kirungi.<verse eid="PRO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Mwana wangye, hurira ebigambo byangye, kandi obiikirize,</para>
  <para style="q1" vid="PRO 4:10">Emyaka y'amagara gaawe ebone kuba mingi.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Nkakwegyesa oku oraatungye obwengye,</para>
  <para style="q1" vid="PRO 4:11">Naakuhabura emihanda egororokire.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:23">Enf 3:23</ref>; <ref loc="PSA 18:36">Zab 18:36</ref>. </char>
    </note> Omu kugyenda kwawe toritsibaaza,</para>
  <para style="q1" vid="PRO 4:12">Kandi ku oriiruka, toriteera ntsibo.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Hamya ebi oyegyesiibwe, otaribireka;</para>
  <para style="q1" vid="PRO 4:13">Obirinde, ahabw'okuba nigo magara gaawe.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:1">Zab 1:1</ref>. </char>
    </note> Otaritoora akahanda k'enkozi z'ebibi,</para>
  <para style="q1" vid="PRO 4:14">Kandi otarigyendera omu muhanda gw'abantu babi.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Ogume ogwetantare, orekye kugurabamu;</para>
  <para style="q1" vid="PRO 4:15">Ogwehuzye, ogumizemu;<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:4">Zab 36:4</ref>. </char>
    </note> Ahakuba bo, ku baba batakakozire kibi, tibagwejegyera;</para>
  <para style="q1" vid="PRO 4:16">Ku baba batakateerize muntu ntsibo, babura oturo.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Ahabw'okuba barya eby'okurya by'obubi,</para>
  <para style="q1" vid="PRO 4:17">Kandi banywa viinyo y'okunyagisa abandi amaani.<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:18: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 11:17">Yob 11:17</ref>; <ref loc="JOB 22:28">22:28</ref>; <ref loc="ISA 62:1">Isa 62:1</ref>; <ref loc="DAN 12:3">Dan 12:3</ref>. </char>
    </note> Kwonka omuhanda gw'abahikiriire ni nk'omushana ogw'omu kasheeshe</para>
  <para style="q1" vid="PRO 4:18">Ogugumizamu nigwaka gukahitsya omu ihangwe.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:19: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:9">1 Sam 2:9</ref>; <ref loc="ISA 59:9">Isa 59:9</ref>, <ref loc="ISA 59:10">10</ref>; <ref loc="JER 23:12">Yer 23:12</ref>; <ref loc="JHN 11:10">Yoh 11:10</ref>; <ref loc="1JN 2:10">1 Yoh 2:10</ref>. </char>
    </note> Omuhanda gw'ababi ni nk'omwirima ndindindi;</para>
  <para style="q1" vid="PRO 4:19">Tibamanya kibateeza entsibo.<verse eid="PRO 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Mwana wangye, ta omutima aha bigambo byangye,</para>
  <para style="q1" vid="PRO 4:20">Otegye okutu ebi ndikugamba.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Otaribireka bikakuruga omu maisho,</para>
  <para style="q1" vid="PRO 4:21">Obigumye aha mutima gwawe;<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:35">Enf 8:35</ref>; <ref loc="DEU 32:47">Bir 32:47</ref>. </char>
    </note> Ahabw'okuba n'amagara ahari abo ababizoora,</para>
  <para style="q1" vid="PRO 4:22">Kandi n'omubazi aha mibiri yaabo yoona.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:23: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">Mat 12:34</ref>, <ref loc="MAT 12:35">35</ref>. </char>
    </note> Rinda omutima gwawe okukira ebindi byona ebi orikurinda,</para>
  <para style="q1" vid="PRO 4:23">Ahakuba nigwo gurugwamu enshuro z'amagara.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Yete hare akanwa akarikugamba eby'okwehabagiza,</para>
  <para style="q1" vid="PRO 4:24">Kandi n'ebigaaniiro ebirikuhabisa obyete hare.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:25: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:2">Heb 12:2</ref>. </char>
    </note> Shoronzya amaisho gaawe gareebere kimwe omu maisho,</para>
  <para style="q1" vid="PRO 4:25">Kandi ogahamizeyo kimwe.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:26: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:6">Enf 5:6</ref>, <ref loc="PRO 5:21">21</ref>; <ref loc="HEB 12:13">Heb 12:13</ref>. </char>
    </note> Yetegyereze ahu ebigyere byawe birikuraba,</para>
  <para style="q1" vid="PRO 4:26">Obwo nibwo emihanda yaawe erihama.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:27: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 5:32">Bir 5:32</ref>. </char>
    </note> Otarigwera aha rubaju rwa buryo nari orwa bumosho;</para>
  <para style="q1" vid="PRO 4:27">Iha ekigyere kyawe omu bubi.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Eby'okwerinda obushambani</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Mwana wangye, ta omutima aha bwengye bwangye,</para>
  <para style="q1" vid="PRO 5:1">Otegye okutu okwetegyereza kwangye,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:2: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 2:7">Mal 2:7</ref>. </char>
    </note> Obone kugumya okwerinda,</para>
  <para style="q1" vid="PRO 5:2">Kandi eminwa yaawe erinde okumanya,<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:16">Enf 2:16</ref>; <ref loc="PSA 55:21">Zab 55:21</ref>; <ref loc="SNG 4:11">Kyesh 4:11</ref>. </char>
    </note> Ahabw'okuba eminwa y'omukazi enshambani etoonya obwoki,</para>
  <para style="q1" vid="PRO 5:3">N'ebigambo bye bikiza amajuta kuterera,<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 149:6">Zab 149:6</ref>; <ref loc="ECC 7:26">Mub 7:26</ref>; <ref loc="LAM 3:15">Tonz 3:15</ref>. </char>
    </note> Kwonka aha muheru ashaarira nk'omuravunga,</para>
  <para style="q1" vid="PRO 5:4">Agira obwogi nka rurara y'amoogi abiri.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:27">Enf 7:27</ref>. </char>
    </note> Ebigyere bye bishuuma omu kufa,</para>
  <para style="q1" vid="PRO 5:5">N'entambwe ze zitoora omuhanda ogurikuza Okuzimu.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Tayeta ha muhanda gw'amagara.</para>
  <para style="q1" vid="PRO 5:6">Emihanda ye n'ey'okuzengyerera, kwonka we tabimanya.<verse eid="PRO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Mbwenu baana bangye, mumpurire,</para>
  <para style="q1" vid="PRO 5:7">Murekye kuruga aha bi ndikugamba.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Mwetantarire hare,</para>
  <para style="q1" vid="PRO 5:8">Kandi otairira haihi emiryango y'enju ye,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Otakaaha ekitiinisa kyawe abandi,</para>
  <para style="q1" vid="PRO 5:9">N'emyaka yaawe abatarikusaasira,<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Abanyamahanga batakaakumaramu amaani,</para>
  <para style="q1" vid="PRO 5:10">N'emirimo yaawe ekakorerwa omu nju y'omunyaihanga;<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Kandi aha muheru gw'amagara gaawe okaborooga,</para>
  <para style="q1" vid="PRO 5:11">Waahweire aha magufa,<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:22">Enf 1:22</ref>, <ref loc="PRO 1:25">25</ref>, <ref loc="PRO 1:29">29</ref>; <ref loc="PSA 107:11">Zab 107:11</ref>. </char>
    </note> Okeefuuza noogira oti: Eshi nkaba eihano kwanga kutegyekwa,</para>
  <para style="q1" vid="PRO 5:12">N'omutima gwangye kwanga kuhanwa!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Tindahuriire bi abashomesa bangye bangambiire,</para>
  <para style="q1" vid="PRO 5:13">N'obu kwakuba okutega amatu abarikumpabura.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Nkaba ndi haihi kufeera kimwe,</para>
  <para style="q1" vid="PRO 5:14">N'okugwa ahagati y'omutwe gw'abantu.<verse eid="PRO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:15: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:12">Kyesh 4:12</ref>, <ref loc="SNG 4:15">15</ref>; <ref loc="JER 2:13">Yer 2:13</ref>. </char>
    </note> Nywa amaizi g'eiziba ryawe,</para>
  <para style="q1" vid="PRO 5:15">Agarikuruga omu iziba eri oyefukuriire.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Beitu shi, enshuro zaawe zishemereire kumaamagizibwa oku n'oku,</para>
  <para style="q1" vid="PRO 5:16">Zikaba emigyera y'amaizi omu nguuto?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:10">Enf 14:10</ref>. </char>
    </note> Ka gabe agaawe wenka,</para>
  <para style="q1" vid="PRO 5:17">Garekye kuba ag'abagyenyi baawe.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:18: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 9:9">Mub 9:9</ref>; <ref loc="MAL 2:14">Mal 2:14</ref>. </char>
    </note> K'enshuro yaawe eheebwe omugisha,</para>
  <para style="q1" vid="PRO 5:18">Oshemerererwe omukazi ow'omu butsigazi bwawe,<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:19: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:5">Kyesh 4:5</ref>. </char>
    </note> Akubeere nk'ebuguma y'empara erikukundwa, n'ey'esirabo erikushemeza;</para>
  <para style="q1" vid="PRO 5:19">Amabeere ge gagume gakuhaazye,</para>
  <para style="q1" vid="PRO 5:19">Kandi obutoosha oshemezibwe okukunda kwe.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:3">Enf 5:3</ref>. </char>
    </note> Mwana wangye, ahabw'enki oshemezibwa omukazi enshambani,</para>
  <para style="q1" vid="PRO 5:20">Okenda ngu ofumbate ogwo mukazi waariire enshoni?<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:21: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 31:4">Yob 31:4</ref>; <ref loc="PSA 119:168">Zab 119:168</ref>; <ref loc="JER 16:17">Yer 16:17</ref>; <ref loc="HEB 4:13">Heb 4:13</ref>. </char>
    </note> Ahakuba emitwarize y'omuntu eba omu maisho ga MUKAMA,</para>
  <para style="q1" vid="PRO 5:21">Kandi niwe agumya eriisho aha mihanda ye yoona.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>, <ref loc="PSA 7:16">16</ref>; <ref loc="HOS 7:2">Hos 7:2</ref>. </char>
    </note> Omunyabibi aryakwatwa okutahikiirira kwe,</para>
  <para style="q1" vid="PRO 5:22">Emigoye y'ekibi kye emugumye.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:21">Enf 10:21</ref>; <ref loc="JOB 4:21">Yob 4:21</ref>. </char>
    </note> Afe azire okwanga kuhaburwa,</para>
  <para style="q1" vid="PRO 5:23">Kandi ahabw'obufa-mutima bwe afeere kimwe.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Eby'okwemererera</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 17:3">Yob 17:3</ref>. </char>
    </note> Mwana wangye, ku oryemererera mutaahi waawe,</para>
  <para style="q1" vid="PRO 6:1">Waakwatiriza omunyaihanga,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />Bwanyima waashanga ogwire omu mutego omu bi ogambire,</para>
  <para style="q1" vid="PRO 6:2">Okwatiirwe omu bigambo ebirugire omu kanwa kaawe,<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:3: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:8">Luk 11:8</ref>. </char>
    </note> Obwo oryatwaza oti, mwana wangye, obone kwejuna;</para>
  <para style="q1" vid="PRO 6:3">Ahakuba oryaba ogwire omu mikono ya mutaahi waawe;</para>
  <para style="q1" vid="PRO 6:3">Oryagyenda nooyehuuta, omukwate amaguru noomweshengyereza;<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 132:4">Zab 132:4</ref>. </char>
    </note> Otariikiriza amaisho gaawe kugwejegyera,</para>
  <para style="q1" vid="PRO 6:4">N'ebitsigye byawe kuhungira;<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:3">Zab 91:3</ref>. </char>
    </note> Yejune nk'oku enzaza eyejuna omuhiigi,</para>
  <para style="q1" vid="PRO 6:5">Nk'oku enyonyi esyoka omu ngaro z'ogitegire.<verse eid="PRO 6:5" /></para>
  <para style="s1">Eby'obweremwa</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:25">Enf 30:25</ref>. </char>
    </note> Iwe mweremwa we, za ow'ekimunyu,</para>
  <para style="q1" vid="PRO 6:6">Oyetegyereze oku kitwaza, haza ogire obwengye.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:27">Enf 30:27</ref>. </char>
    </note> Tikigira mukuru,</para>
  <para style="q1" vid="PRO 6:7">Nari omutware, nari omutegyeki;<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:5">Enf 10:5</ref>. </char>
    </note> Kwonka kyehunikira eby'okurya omu kyanda,</para>
  <para style="q1" vid="PRO 6:8">Kandi omu ishaaruura kyeshangururiza eby'okukitunga.<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Iwe mweremwa 'we, oryabyama ohitsye hi?</para>
  <para style="q1" vid="PRO 6:9">Oryasisiimuka ryari kuruga omu turo?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:10, 11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:33">Enf 24:33</ref>, <ref loc="PRO 24:34">34</ref>; <ref loc="ECC 4:5">Mub 4:5</ref>. </char>
    </note> Noogira oti: Reka ngwejegyereho kakye, mpungireho kaingana busha;</para>
  <para style="q1" vid="PRO 6:10">Nangwa mpinyeho nti omukono, ngwejegyereho.<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />Kwonka omanye obworo ku burikwizira nk'omunyagi,</para>
  <para style="q1" vid="PRO 6:11">N'obukyene bukakuhikaho nk'omuntu ohagatiire eby'okurwanisa.<verse eid="PRO 6:11" /></para>
  <para style="s1">Ebi Ruhanga ayanga</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Omuntu otaine mugasho, omuntu omubi,</para>
  <para style="q1" vid="PRO 6:12">Agyenda naagamba ebikiikami,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:19">Zab 35:19</ref>. </char>
    </note> Aitira abandi amaisho, agambisa ebigyere,</para>
  <para style="q1" vid="PRO 6:13">Arengyeza bagyenzi be n'engaro.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Ateekateeka enaama mbi omu mutima ogurikwehabagiza,</para>
  <para style="q1" vid="PRO 6:14">Obutoosha abiba okwangana.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:1">Enf 29:1</ref>; <ref loc="JER 19:11">Yer 19:11</ref>. </char>
    </note> N'ahabw'ekyo aryagwerwa akagwe kitaraariire,</para>
  <para style="q1" vid="PRO 6:15">Ahendekye ahonaaho okuhendeka okutaribungwa.<verse eid="PRO 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Hariho ebintu mukaaga, nangwa ni mushanju,</para>
  <para style="q1" vid="PRO 6:16">Ebi MUKAMA ayanga, kandi ebi anuga,<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:22">Enf 12:22</ref>; <ref loc="PSA 101:5">Zab 101:5</ref>; <ref loc="ISA 59:3">Isa 59:3</ref>, <ref loc="ISA 59:7">7</ref>. </char>
    </note> Amaisho g'amaryo, orurimi orubeiha,</para>
  <para style="q1" vid="PRO 6:17">Emikono esheesha eshagama y'abataine rubanja,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:16">Enf 1:16</ref>; <ref loc="GEN 6:5">Kut 6:5</ref>. </char>
    </note> Omutima oguteekateeka enaama mbi,</para>
  <para style="q1" vid="PRO 6:18">Ebigyere ebirahukira ekibi,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:17">Enf 12:17</ref>; <ref loc="PRO 14:5">14:5</ref>; <ref loc="PRO 16:28">16:28</ref>. </char>
    </note> Mushinja otari w'amazima ogamba ebishuba,</para>
  <para style="q1" vid="PRO 6:19">N'omuntu obiba eby'okuteerana abantu omu b'eisheemwe.<verse eid="PRO 6:19" /></para>
  <para style="s1">Ebya baamaraaya</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Mwana wangye, ogume oyorobere ebiragiro bya sho,</para>
  <para style="q1" vid="PRO 6:20">Kandi otaruga aha kwegyesa kwa nyoko.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:3">Enf 3:3</ref>. </char>
    </note> Ogume obikomeire aha mutima gwawe,</para>
  <para style="q1" vid="PRO 6:21">Kandi obizingirire omu maraka gaawe.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:23">Enf 3:23</ref>, <ref loc="PRO 3:24">24</ref>. </char>
    </note> Biryakwebembera omu kugyenda,</para>
  <para style="q1" vid="PRO 6:22">Bikurinde ogwejegyeire,</para>
  <para style="q1" vid="PRO 6:22">Kandi bigaaniire naiwe waasisiimuka.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:105">Zab 119:105</ref>. </char>
    </note> Ahabw'okuba ebiragiro n'etabaaza, n'okwegyesa n'omushana,</para>
  <para style="q1" vid="PRO 6:23">N'okuhana kw'orikukutegyeka nigwo muhanda gw'amagara,<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Okukurinda omukazi mubi,</para>
  <para style="q1" vid="PRO 6:24">N'okukurinda karimi karungi, omukazi owaariire enshoni.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:25: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 9:30">2 Bag 9:30</ref>; <ref loc="MAT 5:28">Mat 5:28</ref>. </char>
    </note> Otaryetenga oburungi bwe omu mutima gwawe,</para>
  <para style="q1" vid="PRO 6:25">Kandi otaritwarwa engohe ze;<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:26: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:3">Enf 29:3</ref>; <ref loc="1SA 2:36">1 Sam 2:36</ref>; <ref loc="EZK 13:18">Ezk 13:18</ref>. </char>
    </note> Ahabw'okuba maraaya agurwa akagaati,</para>
  <para style="q1" vid="PRO 6:26">Kwonka omukazi enshambani ahiiga amagara g'omushaija.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:27: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 31:12">Yob 31:12</ref>. </char>
    </note> Omuntu akaabaasa kutwarira omuriro omu kifuba kye,</para>
  <para style="q1" vid="PRO 6:27">Emyenda ye etasye?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Nari omuntu akaabaasa kugyendera aha makara garikwotsya,</para>
  <para style="q1" vid="PRO 6:28">Ebigyere bye bitababukye?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Nikwo ari atyo oza ahari muka mutaahi we;</para>
  <para style="q1" vid="PRO 6:29">Tihariho n'omwe omukoraho oribura kufubirwa.<verse eid="PRO 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Abantu tibagaya mushuma</para>
  <para style="q1" vid="PRO 6:30">Yaiba kwemara enjara;<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:31: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 22:1">Kur 22:1</ref>, <ref loc="EXO 22:4">4</ref>. </char>
    </note> Kwonka ku akwatwa, ariha emirundi mushanju,</para>
  <para style="q1" vid="PRO 6:31">Ahayo eby'omu ka ye byona.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:32: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:7">Enf 7:7</ref>; <ref loc="PRO 9:4">9:4</ref>; <ref loc="PRO 10:13">10:13</ref>. </char>
    </note> Oshambana, aba ataine bwengye;</para>
  <para style="q1" vid="PRO 6:32">Okikora, aba naacwekyereza amagara ge.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Eki aihayo n'obuhuta n'okuhemuka,</para>
  <para style="q1" vid="PRO 6:33">Kandi okuhemuka kwe tikuriragazibwa;<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:34: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:4">Enf 27:4</ref>; <ref loc="SNG 8:6">Kyesh 8:6</ref>. </char>
    </note> Ahabw'okuba obufuuhi bureetera omuntu ekiniga kingi,</para>
  <para style="q1" vid="PRO 6:34">Omu kuhoora enzigu tasaasira.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Taikiriza kuhongyerwa kwona,</para>
  <para style="q1" vid="PRO 6:35">N'obu waakumuha ebiconco ebirikwingana bita, takaikaikana.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Omuheru gw'obushambani</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Mwana wangye, rinda ebigambo byangye,</para>
  <para style="q1" vid="PRO 7:1">Kandi ebiragiro byangye obyezirikye.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 4:4">Enf 4:4</ref>; <ref loc="DEU 32:10">Bir 32:10</ref>. </char>
    </note> Ogume oyorobere ebiragiro byangye, obone kugumaho;</para>
  <para style="q" vid="PRO 7:2">N'ebi ndikwegyesa obirinde nk'emboni y'eriisho ryawe.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:3">Enf 3:3</ref>; <ref loc="DEU 6:8">Bir 6:8</ref>. </char>
    </note> Bikome aha nkumu zaawe,</para>
  <para style="q1" vid="PRO 7:3">Obihandiikye aha kishate ky'omutima gwawe.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Gira Bwengye oti: Niiwe munyaanyazi;</para>
  <para style="q1" vid="PRO 7:4">Kandi okwetegyereza okwete munywani waawe ow'aha mara.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:16">Enf 2:16</ref>. </char>
    </note> Ebyo bikurinde omukazi enshambani,</para>
  <para style="q1" vid="PRO 7:5">N'akarimi karungi ak'omukazi owaariire enshoni.<verse eid="PRO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Ahakuba nkaringuririza</para>
  <para style="q1" vid="PRO 7:6">Omu dirisa y'enju yangye,<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:32">Enf 6:32</ref>. </char>
    </note> Naareeba, kandi naayetegyereza,</para>
  <para style="q1" vid="PRO 7:7">Omu batsigazi abataine bwengye,<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Naaraba omu nguuto erikuraba haihi n'akeekubo k'aha nju y'ogwo mukazi,</para>
  <para style="q1" vid="PRO 7:8">Agyemire omuhanda ogurikuzayo,<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 24:15">Yob 24:15</ref>. </char>
    </note> Omu rwita-waabo omu mwabazyo,</para>
  <para style="q1" vid="PRO 7:9">Nyekiro omu mwirima ndindindi.<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Kandi reeba ogwo mukazi yaamubugana,</para>
  <para style="q1" vid="PRO 7:10">Ajwaire eby'obwamaraarya, aine omutima gw'oburyarya.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:11: </char>
      <char style="xt" closed="false">
        <ref loc="1TI 5:13">1 Tim 5:13</ref>. </char>
    </note> N'omukazi omuhwa-nshoni kandi ekyegyengye,</para>
  <para style="q1" vid="PRO 7:11">Ou ebigyere bye bitaikara mu nju.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Obumwe aza omu nguuto, obundi omu katare,</para>
  <para style="q1" vid="PRO 7:12">Naategyereza ahari buri keekubo k'omuhanda.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Ku yamureebire, yaamukwata, yaamunywegyera,</para>
  <para style="q1" vid="PRO 7:13">Yaagamba nawe ataine kashoni, naamugira ati:<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:14: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 7:11">Lev 7:11</ref>; <ref loc="PSA 50:14">Zab 50:14</ref>. </char>
    </note> Mbaire ndi ow'okuhonga empongano z'okusiima ahabw'obusingye,</para>
  <para style="q1" vid="PRO 7:14">Mbwenu ebi naaraganiise naabiheza eri izooba.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Nikyo naizira hati kukubugana,</para>
  <para style="q1" vid="PRO 7:15">Ninkusherura nkwiniire orushusho; mbwenu naakubona.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 31:22">Enf 31:22</ref>; <ref loc="ISA 19:9">Isa 19:9</ref>. </char>
    </note> Ekitabo kyangye nkyazireho emyenda etariize eya bafuta,</para>
  <para style="q1" vid="PRO 7:16">Ecwererainemu amabara g'emyenda ya Misri.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:8">Zab 45:8</ref>. </char>
    </note> Nyoteire ekitanda kyangye n'emigaju erikutaamirana</para>
  <para style="q1" vid="PRO 7:17">Ya sumuruna n'obunyanunga n'omudarasiini.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Ija tuhikiirize okukundana kwaitu, burugyeho busheeshe,</para>
  <para style="q1" vid="PRO 7:18">Tweshemeze omu kukundana kwaitu;<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Ahakuba ibanye tarimu,</para>
  <para style="q1" vid="PRO 7:19">Azindukiire hare;<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Atwaire enshaho y'empiiha;</para>
  <para style="q1" vid="PRO 7:20">Aryagaruka okwezi kuri ekizooro.<verse eid="PRO 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:2">Zab 12:2</ref>. </char>
    </note> Ahabw'ebigambo ebirikunuriirira, yaamubeihabeiha,</para>
  <para style="q1" vid="PRO 7:21">Yaamutwaza akarimi karungi.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Ahonaaho yaamukurata,</para>
  <para style="q1" vid="PRO 7:22">Nk'ente erikuza kubaagwa,</para>
  <para style="q1" vid="PRO 7:22">Nk'omugwa-iraro orikutwarwa omu nkomo kuhanwa;<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:23: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 9:12">Mub 9:12</ref>. </char>
    </note> Okuhitsya obu omwambi gwamucumitsire omu kitugu;</para>
  <para style="q1" vid="PRO 7:23">Nk'oku enyonyi eiruka ekagwa omu mutego,</para>
  <para style="q1" vid="PRO 7:23">Etarikumanya ku amagara gaayo gategirwe.<verse eid="PRO 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Mbwenu baana bangye, mutegye amatu;</para>
  <para style="q1" vid="PRO 7:24">Mute omutima aha bigambo ebirikuruga omu kanwa kangye.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Otaikiriza omutima gwawe kuhungutukira omu mihanda ye,</para>
  <para style="q1" vid="PRO 7:25">Otahabira omu tuhanda twe;<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:26: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 13:26">Neh 13:26</ref>. </char>
    </note> Ahabw'okuba agwisize baingi;</para>
  <para style="q1" vid="PRO 7:26">Eego, boona abu araitsire n'eihe rihango.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:18">Enf 2:18</ref>; <ref loc="PRO 5:3">5:3</ref>; <ref loc="PRO 9:18">9:18</ref>. </char>
    </note> Enju ye n'omuhanda ogurikuza Okuzimu,</para>
  <para style="q1" vid="PRO 7:27">nigushuuma omu bishengye bya rufu.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Ebya Bwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:1-3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:20">Enf 1:20</ref>, <ref loc="PRO 1:21">21</ref>; <ref loc="PRO 9:3">9:3</ref>. </char>
    </note> Bwengye tarikweta,</para>
  <para style="q1" vid="PRO 8:1">Kandi Kwetegyereza tarikwimutsya eiraka rye?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Ayemereire aha mutwe gw'ebibungo,</para>
  <para style="q1" vid="PRO 8:2">Omu nteeraniro z'emihanda,<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Aha rubaju rw'amarembo omu maisho g'orurembo,</para>
  <para style="q1" vid="PRO 8:3">Ahu orikutaahira nooza omu irembo, niho arikwetera n'eiraka rihango naagira ati:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />Imwe bashaija 'mwe, manya niimwe ndikweta,</para>
  <para style="q1" vid="PRO 8:4">Kandi eiraka ryangye niryeta abaana b'abantu.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Imwe abataine bwengye, mwegye okwerinda,</para>
  <para style="q1" vid="PRO 8:5">Naimwe abashema, mugire omutima ogurikwetegyereza.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Muhurire, ahabw'okuba ebi naaza kubagambira ni bikuru,</para>
  <para style="q1" vid="PRO 8:6">Kandi eminwa yangye neija kugamba ebihikire;<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:30">Zab 37:30</ref>. </char>
    </note> Ahakuba akanwa kangye kaaza kugamba amazima,</para>
  <para style="q1" vid="PRO 8:7">Kandi okugamba ebibi eminwa yangye nikyo enuga.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Ebigambo by'omu kanwa kangye byona bihikiriire;</para>
  <para style="q1" vid="PRO 8:8">Tibirimu kigambo na kimwe ekikiikakiikire nari ekitegami;<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:6">Enf 14:6</ref>. </char>
    </note> Byona nibishoborokyera orikwetegyereza,</para>
  <para style="q1" vid="PRO 8:9">Kandi n'ebihikire aha barikuzoora okumanya.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:10, 11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:14">Enf 3:14</ref>, <ref loc="PRO 3:15">15</ref>; <ref loc="PSA 119:72">Zab 119:72</ref>, <ref loc="PSA 119:127">127</ref>. </char>
    </note> Mwakiire okwegyesa kwangye okukira efeeza,</para>
  <para style="q1" vid="PRO 8:10">N'okumanya okukira ezaabu etoorainwe;<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Ahabw'okuba obwengye nibukira amabaare g'obuguzi bwingi,</para>
  <para style="q1" vid="PRO 8:11">Kandi omu birikwetengwa byona tihaine kirikwingana nabwo.<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Nyowe Bwengye, okwerinda nkakugira obutaaho bwangye,</para>
  <para style="q1" vid="PRO 8:12">Nzoire okumanya n'okwetwara.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:5">Enf 16:5</ref>, <ref loc="PRO 16:6">6</ref>; <ref loc="PSA 97:10">Zab 97:10</ref>. </char>
    </note> Okutiina MUKAMA nikwo kwanga ebibi;</para>
  <para style="q1" vid="PRO 8:13">amaryo n'emyehimbiso, omuhanda gw'obubi,</para>
  <para style="q1" vid="PRO 8:13">N'ebigambo by'okwehabagiza nibyo nyanga.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:14: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 7:19">Mub 7:19</ref>; <ref loc="ISA 11:2">Isa 11:2</ref>. </char>
    </note> Niinye mukama w'enaama n'obwengye obuhikire,</para>
  <para style="q1" vid="PRO 8:14">Niinye kwetegyereza, kandi nyine obushoboorozi,<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:15, 16: </char>
      <char style="xt" closed="false">
        <ref loc="DAN 2:21">Dan 2:21</ref>; <ref loc="ROM 13:1">Rom 13:1</ref>. </char>
    </note> Abagabe bategyeka ahabwangye,</para>
  <para style="q1" vid="PRO 8:15">N'abategyeki bataho ebiragiro by'oburyo.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Ahabwangye abanyiginya bategyeka</para>
  <para style="q1" vid="PRO 8:16">N'abakungu batwara ensi.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:17: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:30">1 Sam 2:30</ref>; <ref loc="PSA 91:14">Zab 91:14</ref>; <ref loc="JHN 14:21">Yoh 14:21</ref>; <ref loc="JAS 1:5">Yak 1:5</ref>. </char>
    </note> Abankunda mbakunda,</para>
  <para style="q1" vid="PRO 8:17">N'abataho omutima kunsherura, bambona.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:16">Enf 3:16</ref>; <ref loc="PSA 112:3">Zab 112:3</ref>; <ref loc="MAT 6:33">Mat 6:33</ref>. </char>
    </note> Eitungo n'ekitiinisa niinye mbiine,</para>
  <para style="q1" vid="PRO 8:18">Hamwe n'obutungi oburikugumaho n'okugogyera.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:19: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:15">Yob 28:15</ref>. </char>
    </note> Ebijuma byangye nibikira ezaabu, nangwa n'ezaabu eshemeziibwe,</para>
  <para style="q1" vid="PRO 8:19">Kandi ebi nyerize nibikira efeeza etoorainwe.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ngyendera omu mihanda y'okuhikiirira,</para>
  <para style="q1" vid="PRO 8:20">N'omu tuhanda tw'oburyo,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Ngu mbone kutungisa abarikunkunda,</para>
  <para style="q1" vid="PRO 8:21">N'okwijuza amabiikiro gaabo.<verse eid="PRO 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:19">Enf 3:19</ref>; <ref loc="PSA 104:24">Zab 104:24</ref>; <ref loc="JHN 1:1">Yoh 1:1</ref>. </char>
    </note> MUKAMA akampanga naakitandika emirimo ye,</para>
  <para style="q1" vid="PRO 8:22">Atakagizire ki yaahanga.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:23: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:2">Kut 1:2</ref>; <ref loc="JOB 15:7">Yob 15:7</ref>; <ref loc="PSA 90:2">Zab 90:2</ref>. </char>
    </note> Okwiha ira ryona nkateebwaho,</para>
  <para style="q1" vid="PRO 8:23">Omu kutandika, ensi etakahangirwe.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Okuzimu etakabaireho nkoorekwa butunu,</para>
  <para style="q1" vid="PRO 8:24">Enshuro ezirikuhimintika amaizi maingi zitakabaireho,<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Enshozi zitakahangirwe,</para>
  <para style="q1" vid="PRO 8:25">N'ebibungo bitakabaireho, nibwo naayorekwa;<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Ruhanga atakahangire nsi n'obwerere,</para>
  <para style="q1" vid="PRO 8:26">N'obu gwakuba omucuucu gw'omu nsi ogwabandize.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Obu yaataho eiguru, nkaba ndiho;</para>
  <para style="q1" vid="PRO 8:27">Obu yaataho obugarukiro bw'okuzimu,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:28: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:6">Kut 1:6</ref>. </char>
    </note> Obu yaahamya eiguru ahaiguru,</para>
  <para style="q1" vid="PRO 8:28">Obu yaataho enshuro z'okuzimu,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:29: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:9">Kut 1:9</ref>, <ref loc="GEN 1:10">10</ref>; <ref loc="JOB 26:10">Yob 26:10</ref>; <ref loc="PSA 104:5">Zab 104:5</ref>. </char>
    </note> Obu yaateeraho enyanja obugarukiro,</para>
  <para style="q1" vid="PRO 8:29">Ngu amaizi gatarenga emisingi y'ensi;<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:30: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:1">Yoh 1:1</ref>, <ref loc="JHN 1:2">2</ref>. </char>
    </note> Obwo nkaba ndi hamwe nawe, ndi omukozi mukuru;</para>
  <para style="q1" vid="PRO 8:30">Obutoosha niinye naabaire ndi okushemererwa kwe,</para>
  <para style="q1" vid="PRO 8:30">Niinyesiimira omu maisho ge buri izooba,<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:3">Zab 16:3</ref>; <ref loc="PSA 104:31">104:31</ref>; <ref loc="ISA 45:18">Isa 45:18</ref>. </char>
    </note> Niinyesiimira omu nsi eyaahangirwe kutuurwamu,</para>
  <para style="q1" vid="PRO 8:31">Kandi okushemererwa kwangye kukaba kuri okuguma n'abantu.<verse eid="PRO 8:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:32: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 128:1">Zab 128:1</ref>; <ref loc="LUK 11:28">Luk 11:28</ref>. </char>
    </note> Mbwenu hati, baana bangye, mumpurire,</para>
  <para style="q1" vid="PRO 8:32">Ahabw'okuba abarikugumizamu emihanda yangye bahiiriirwe.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Muhurire ebi ndikubahabura,</para>
  <para style="q1" vid="PRO 8:33">Mugire obwengye, mutabyanga.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:34: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:13">Enf 3:13</ref>. </char>
    </note> Ohiiriirwe n'orikuunyorobera,</para>
  <para style="q1" vid="PRO 8:34">Akaguma omu marembo gangye naareeba,</para>
  <para style="q1" vid="PRO 8:34">Ategyerereize aha biti by'emiryango yangye;<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:35: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:18">Enf 3:18</ref>; <ref loc="PRO 4:22">4:22</ref>; <ref loc="JHN 1:4">Yoh 1:4</ref>; <ref loc="JHN 17:3">17:3</ref>. </char>
    </note> Ahabw'okuba ondeebire weena aba aboine amagara,</para>
  <para style="q1" vid="PRO 8:35">Kandi atunga obushongore ahari MUKAMA;<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:36: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:32">Enf 15:32</ref>; <ref loc="PRO 21:6">21:6</ref>. </char>
    </note> Kwonka orikuncumuraho, naaba asiisire amagara ge.</para>
  <para style="q1" vid="PRO 8:36">Boona abarikuunyanga, nibaba bakunzire rufu.<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Omugasho gw'obwengye bw'okutiina Ruhanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:1: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:18">Mat 16:18</ref>; <ref loc="EPH 2:20-22">Efe 2:20-22</ref>. </char>
    </note> Bwengye ayombekire enju ye,</para>
  <para style="q1" vid="PRO 9:1">Yaabyara enyomyo ze mushanju.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:5">Zab 23:5</ref>; <ref loc="MAT 22:4">Mat 22:4</ref>; <ref loc="LUK 14:17">Luk 14:17</ref>. </char>
    </note> Aitsire amatungo ge, yaaturira viinyo ye,</para>
  <para style="q1" vid="PRO 9:2">Yaatebeekanisa emeeza ye.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:1">Enf 8:1</ref>, <ref loc="PRO 8:2">2</ref>; <ref loc="MAT 22:3">Mat 22:3</ref>. </char>
    </note> Yaatuma abazaana be kweta n'eiraka rihango,</para>
  <para style="q1" vid="PRO 9:3">Beemereire omu myanya mikuru y'omu irembo etunguukire</para>
  <para style="q1" vid="PRO 9:3">Nibagira bati:<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:32">Enf 6:32</ref>. </char>
    </note> Weena otaine bugobya, aije aha!</para>
  <para style="q1" vid="PRO 9:4">Kandi nawe naagambira abataine bwengye ati:<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:5: </char>
      <char style="xt" closed="false">
        <ref loc="SNG 8:2">Kyesh 8:2</ref>; <ref loc="ISA 55:1">Isa 55:1</ref>; <ref loc="JHN 6:27">Yoh 6:27</ref>. </char>
    </note> Mwije murye aha by'okurya byangye,</para>
  <para style="q1" vid="PRO 9:5">Kandi munywe ahari viinyo ei nturiire.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Murekye obushema, mubone kugumaho,</para>
  <para style="q1" vid="PRO 9:6">N'okugyendera omu muhanda gw'okwetegyereza.<verse eid="PRO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:7, 8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 141:5">Zab 141:5</ref>; <ref loc="MAT 7:6">Mat 7:6</ref>. </char>
    </note> Orikuhana omugayi, naaba ayereeteire okujumwa;</para>
  <para style="q1" vid="PRO 9:7">Kandi orikuhana enkozi y'ebibi, naaba ayegwisiize akagwe.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Otarihana omugayi, nyentsya akakwanga;</para>
  <para style="q1" vid="PRO 9:8">Ohane omunyabwengye, naija kukukunda.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:9: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:12">Mat 13:12</ref>. </char>
    </note> Ohabure omunyabwengye, aryayeyongyera kugira obwengye;</para>
  <para style="q1" vid="PRO 9:9">Oyegyese ohikiriire, naija kweyongyera kwega.<verse eid="PRO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:7">Enf 1:7</ref>. </char>
    </note> Okutiina MUKAMA nibwo butandikiro bw'obwengye,</para>
  <para style="q1" vid="PRO 9:10">N'okumanya Orikwera nikwo kwetegyereza;<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:2">Enf 3:2</ref>. </char>
    </note> Ahakuba niinye ndikanyisa ebiro byawe,</para>
  <para style="q1" vid="PRO 9:11">Nkakwongyeraho emyaka ei orimara omu nsi.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 22:2">Yob 22:2</ref>; <ref loc="JOB 35:7">35:7</ref>. </char>
    </note> Ku oraabe oine obwengye, obweiniire;</para>
  <para style="q1" vid="PRO 9:12">Kandi ku oraabe omugayi, noomwebeera.<verse eid="PRO 9:12" /></para>
  <para style="s1">Okubeihabeiha kwa baamaraaya</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:13-18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:7-27">Enf 7:7-27</ref>. </char>
    </note> Omukazi ekifa-mutima ayomba,</para>
  <para style="q1" vid="PRO 9:13">Tagira buntu, kandi tagira kashoni.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Ashutama aha muryango gw'enju ye,</para>
  <para style="q1" vid="PRO 9:14">Kandi arumbaara aha kitebe omu myanya mikuru y'orurembo<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />Kweta abarikuhingura,</para>
  <para style="q1" vid="PRO 9:15">Abakwaitse emihanda yaabo naagira ati:<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:4">Enf 9:4</ref>. </char>
    </note> Otaine bugobya aije aha!</para>
  <para style="q1" vid="PRO 9:16">Kandi agambira abataine bwengye ati:<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:17">Enf 20:17</ref>. </char>
    </note> Amaizi g'enyibano ganura,</para>
  <para style="q1" vid="PRO 9:17">Kandi ebiriibwa bwesherekye nibyo bishemeza.<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:27">Enf 7:27</ref>. </char>
    </note> Kwonka we tamanya ku abafu niyo bari,</para>
  <para style="q1" vid="PRO 9:18">Kandi n'abagyenyi be ku bari okuzimu owa Nyamuteza.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Enfumu ezirikumanyisa abahikiriire n'ababi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:1">Enf 1:1</ref>; <ref loc="PRO 17:25">17:25</ref>; <ref loc="PRO 29:3">29:3</ref>, <ref loc="PRO 29:15">15</ref>. </char>
    </note> Enfumu za Sulemaani.</para>
  <para style="q1" vid="PRO 10:1">Omwana w'obwengye ashemeza ishe;</para>
  <para style="q1" vid="PRO 10:1">Kwonka omwana omushema agwisa kubi nyina.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:4">Enf 11:4</ref>; <ref loc="PRO 21:6">21:6</ref>; <ref loc="EZK 7:19">Ezk 7:19</ref>. </char>
    </note> Obutungi oburugire omu bibi tibugira mugasho,</para>
  <para style="q1" vid="PRO 10:2">Kwonka okuhikiirira kujuna omuntu omu kufa.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:9">Zab 34:9</ref>, <ref loc="PSA 34:10">10</ref>; <ref loc="PSA 112:10">112:10</ref>. </char>
    </note> MUKAMA tarireka bahikiriire kwitwa enjara,</para>
  <para style="q1" vid="PRO 10:3">Kwonka okwetenga kw'ababi akurwanisa.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:4">Enf 13:4</ref>; <ref loc="PRO 21:5">21:5</ref>. </char>
    </note> Engaro z'omweremwa zireeta obworo,</para>
  <para style="q1" vid="PRO 10:4">Kwonka ez'omweziriki zimutungisa.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:6-8">Enf 6:6-8</ref>. </char>
    </note> Omwana oshaaruura omu kyanda aba aine obwengye,</para>
  <para style="q1" vid="PRO 10:5">Kwonka ogwejegyera omu igyesha aitsa enshoni.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Emigisha eba aha mutwe gw'ohikiriire,</para>
  <para style="q1" vid="PRO 10:6">Kwonka akanwa k'omubi kashereka okukora kubi.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:5">Zab 9:5</ref>; <ref loc="PSA 112:6">112:6</ref>. </char>
    </note> Okwijuka ohikiriire kureeta omugisha,</para>
  <para style="q1" vid="PRO 10:7">Kwonka eiziina ry'omubi riryajunda.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:24">Mat 7:24</ref>; <ref loc="MAT 25">25</ref>. </char>
    </note> Omunyabwengye omu mutima ayeta aha biragiro,</para>
  <para style="q1" vid="PRO 10:8">Kwonka omushema engambi ya maingi aryagwa.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:23">Enf 3:23</ref>; <ref loc="PRO 28:18">28:18</ref>; <ref loc="ISA 33:15">Isa 33:15</ref>, <ref loc="ISA 33:16">16</ref>; <ref loc="1TI 5:25">1 Tim 5:25</ref>. </char>
    </note> Orikugyendera omu bwesigwa, naagyenda ahamire,</para>
  <para style="q1" vid="PRO 10:9">Kwonka orikwehabagiza aryamanywa.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:13">Enf 6:13</ref>. </char>
    </note> Oitira abandi eriisho ateerana abantu,</para>
  <para style="q1" vid="PRO 10:10">Kwonka ohana butunu areeta obusingye.<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:14">Enf 13:14</ref>; <ref loc="PSA 36:9">Zab 36:9</ref>. </char>
    </note> Akanwa k'ohikiriire n'enshuro y'amagara,</para>
  <para style="q1" vid="PRO 10:11">Kwonka akanwa k'omubi kashereka okukora kubi.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:9">Enf 17:9</ref>; <ref loc="1PE 4:8">1 Pet 4:8</ref>. </char>
    </note> Okwangana kureeta okurwana,</para>
  <para style="q1" vid="PRO 10:12">Kwonka okukundana kushweka ebishobyo byona.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:32">Enf 6:32</ref>; <ref loc="PRO 19:29">19:29</ref>. </char>
    </note> Eminwa y'orikwetegyereza ereebekwaho obwengye,</para>
  <para style="q1" vid="PRO 10:13">Kwonka amabega g'otaine bwengye gaba ag'enkoni.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Abanyabwengye babiika okumanya,</para>
  <para style="q1" vid="PRO 10:14">Kwonka omushema w'orurimi ayekururira okucwekyerera.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:11">Enf 18:11</ref>. </char>
    </note> Eitungo ry'omutungi rimubeera orurembo rugumire;</para>
  <para style="q1" vid="PRO 10:15">Ekicwekyereza abooro n'obworo bwabo.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:19">Enf 11:19</ref>; <ref loc="PRO 19:23">19:23</ref>. </char>
    </note> Ebi ohikiriire akora bimureetera amagara;</para>
  <para style="q1" vid="PRO 10:16">Amagoba g'omubi gamureetera okukora ekibi.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:23">Enf 6:23</ref>. </char>
    </note> Okunda kuhaburwa aba ari omu muhanda gw'amagara,</para>
  <para style="q1" vid="PRO 10:17">Kwonka nyantagambirwa ahaba.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Oshereka orwango, agira eminwa y'ebishuba,</para>
  <para style="q1" vid="PRO 10:18">Kandi obeiherera abandi aba ekifa-mutima.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:27">Enf 17:27</ref>; <ref loc="MAT 12:36">Mat 12:36</ref>, <ref loc="MAT 12:37">37</ref>; <ref loc="JAS 1:19">Yak 1:19</ref>; <ref loc="JAS 3:2">3:2</ref>. </char>
    </note> Ebigambo bingi tibiburamu kushobya,</para>
  <para style="q1" vid="PRO 10:19">Kwonka oyerinda omu bi arikugamba, aba aine obwengye.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Orurimi rw'ohikiriire n'efeeza etoorainwe,</para>
  <para style="q1" vid="PRO 10:20">Omutima gw'enkozi y'ebibi gugasha kakye.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Eminwa y'ohikiriire egaburira baingi,</para>
  <para style="q1" vid="PRO 10:21">Kwonka abashema bafa, bazira okutagira bwengye.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:22: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 24:35">Kut 24:35</ref>; <ref loc="DEU 8:18">Bir 8:18</ref>. </char>
    </note> Omugisha ogu MUKAMA aha, gutungisa abantu,</para>
  <para style="q1" vid="PRO 10:22">Kandi tagwongyeraho busaasi.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Aha mushema, okukora kubi ni nk'omuzaano,</para>
  <para style="q1" vid="PRO 10:23">Kwonka orikwetegyereza eki ayesiimira n'okukora n'obwengye.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:24: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 15:21">Yob 15:21</ref>; <ref loc="PSA 145:19">Zab 145:19</ref>; <ref loc="ISA 66:4">Isa 66:4</ref>; <ref loc="MAT 7:24-27">Mat 7:24-27</ref>. </char>
    </note> Eki omubi atiina kiryamuhikaho,</para>
  <para style="q1" vid="PRO 10:24">Kandi eki ohikiriire ayetenga aryakiheebwa.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Omuyaga gw'akasooroora ku gurabaho, omubi ahwaho;</para>
  <para style="q1" vid="PRO 10:25">Kwonka ohikiriire aguma ahamire ebiro byona.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Nk'oku viinyo erikushaarira ereeta amangigina,</para>
  <para style="q1" vid="PRO 10:26">Kandi nk'oku omwika gusaasa amaisho,</para>
  <para style="q1" vid="PRO 10:26">N'orikweganda nikwo aba aha barikumutuma.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:2">Enf 3:2</ref>; <ref loc="ECC 7:17">Mub 7:17</ref>; <ref loc="JOB 15:32">Yob 15:32</ref>, <ref loc="JOB 15:33">33</ref>. </char>
    </note> Okutiina MUKAMA kureeta okuhangaara,</para>
  <para style="q1" vid="PRO 10:27">Kwonka emyaka y'omubi eryacuubwaho.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:28: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 8:13">Yob 8:13</ref>; <ref loc="ROM 5:2">Rom 5:2</ref>. </char>
    </note> Omuheru gw'amatsiko g'ohikiriire n'okushemererwa,</para>
  <para style="q1" vid="PRO 10:28">Kwonka amatsiko g'omubi garyabura.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:29: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:15">Enf 21:15</ref>. </char>
    </note> MUKAMA n'orugo rugumire aha muntu ou omuhanda gwe gugororokire,</para>
  <para style="q1" vid="PRO 10:29">Kwonka aha nkozi z'ebibi n'okucwekyerera.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:30: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:22">Zab 37:22</ref>, <ref loc="PSA 37:29">29</ref>; <ref loc="PSA 125:1">125:1</ref>. </char>
    </note> Ohikiriire tarihwaho na kakye,</para>
  <para style="q1" vid="PRO 10:30">Kwonka omubi tariguma mu nsi.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:30">Zab 37:30</ref>. </char>
    </note> Akanwa k'ohikiriire karugwamu obwengye,</para>
  <para style="q1" vid="PRO 10:31">Kwonka orurimi orurikwehabagiza ruryacuubwaho.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:32: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 10:12">Mub 10:12</ref>. </char>
    </note> Eminwa y'ohikiriire emanya ebirikusiimwa,</para>
  <para style="q1" vid="PRO 10:32">Kwonka akanwa k'omubi kagamba ebikiikami.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:11">Enf 16:11</ref>; <ref loc="PRO 20:10">20:10</ref>, <ref loc="PRO 20:23">23</ref>; <ref loc="LEV 19:35">Lev 19:35</ref>, <ref loc="LEV 19:36">36</ref>. </char>
    </note> Eminzaani y'oburyarya n'ekirikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 11:1">Kwonka ebipimo by'amazima bimushemeza.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:18">Enf 16:18</ref>; <ref loc="PRO 18:12">18:12</ref>; <ref loc="PRO 29:23">29:23</ref>; <ref loc="DAN 4:30">Dan 4:30</ref>, <ref loc="DAN 4:31">31</ref>. </char>
    </note> Amaryo gakuratwa okuhemuka,</para>
  <para style="q1" vid="PRO 11:2">Kwonka obwengye bugirwa abacureezi.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:6">Enf 13:6</ref>. </char>
    </note> Obwesigwa bw'abahikiriire bubahabura,</para>
  <para style="q1" vid="PRO 11:3">Kwonka obugobya bw'abarikureebya buryabacwekyereza.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:4: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 7:1">Kut 7:1</ref>; <ref loc="EZK 7:19">Ezk 7:19</ref>; <ref loc="ZEP 1:18">Zef 1:18</ref>. </char>
    </note> Eitungo tiriine ki rigasha aha izooba ry'ekiniga,</para>
  <para style="q1" vid="PRO 11:4">Kwonka okuhikiirira kwiha omu kufa.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Okuhikiirira kw'otaine kamogo kumushorongyeza omuhanda,</para>
  <para style="q1" vid="PRO 11:5">Kwonka omubi agwisibwa obubi bwe.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>, <ref loc="PSA 7:16">16</ref>. </char>
    </note> Okuhikiirira kw'abahikire kuryabajuna,</para>
  <para style="q1" vid="PRO 11:6">Kwonka abarikureebya baryakwatwa eitima ryabo.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:28">Enf 10:28</ref>. </char>
    </note> Omubi ku afa, amatsiko ge gahwaho,</para>
  <para style="q1" vid="PRO 11:7">Kandi amatsiko g'abatarikutiina Ruhanga gahwerekyerera.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:18">Enf 21:18</ref>. </char>
    </note> Ohikiriire ajunwa omu kabi,</para>
  <para style="q1" vid="PRO 11:8">Omubi aba niwe yaakagwamu.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Otarikutiina Ruhanga acwekyereza mutaahi we n'akanwa ke,</para>
  <para style="q1" vid="PRO 11:9">Kwonka abahikiriire baryatambirwa okumanya.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:12">Enf 28:12</ref>; <ref loc="EST 8:15">Est 8:15</ref>. </char>
    </note> Abahikiriire ku baba gye, orurembo rushemererwa;</para>
  <para style="q1" vid="PRO 11:10">Kandi ababi ku bacwekyerera, habaho okuteera akaari.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Orurembo rutunguurwa omugisha gw'ow'omutima ogugororokire,</para>
  <para style="q1" vid="PRO 11:11">Kwonka rusheenywa akanwa k'omubi.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:21">Enf 14:21</ref>. </char>
    </note> Ocamura mutaahi we, aba ataine bwengye;</para>
  <para style="q1" vid="PRO 11:12">Kwonka omuntu orikwetegyereza aguma ayehunamiire.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:19">Enf 20:19</ref>; <ref loc="LEV 19:16">Lev 19:16</ref>. </char>
    </note> Orikugyenda naagambuura bagyenzi be, agamba emibonano,</para>
  <para style="q1" vid="PRO 11:13">Kwonka ow'omutima gw'obwesigwa tagigamba.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:22">Enf 15:22</ref>; <ref loc="PRO 20:18">20:18</ref>; <ref loc="PRO 24:6">24:6</ref>. </char>
    </note> Ahu abahabuzi b'obwengye batari, abantu bagwa;</para>
  <para style="q1" vid="PRO 11:14">Kwonka ahu abahi b'obwengye bari, habaho obusingye.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:1">Enf 6:1</ref>. </char>
    </note> Orikwemererera ou atarikumanya, aryakizira;</para>
  <para style="q1" vid="PRO 11:15">Kwonka orikwanga okwemererera, naaguma ari buhooro.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Omukazi w'embabazi aheebwa ekitiinisa;</para>
  <para style="q1" vid="PRO 11:16">Abarikunyagisa amaani bagira obutungi.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:17: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:7">Mat 5:7</ref>; <ref loc="MAT 25:34-40">25:34-40</ref>. </char>
    </note> Ow'embabazi ayezimuurira ebirungi,</para>
  <para style="q1" vid="PRO 11:17">Kwonka omunyamwaga ayesaasa.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:18: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 10:12">Hos 10:12</ref>; <ref loc="GAL 6:8">Gal 6:8</ref>, <ref loc="GAL 6:9">9</ref>; <ref loc="JAS 3:18">Yak 3:18</ref>. </char>
    </note> Omubi aheebwa ebihembo by'omuyaayuuko,</para>
  <para style="q1" vid="PRO 11:18">Kwonka orikubiba okuhikiirira taribura kutunga ebihembo by'amazima.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:16">Enf 10:16</ref>; <ref loc="ROM 6:23">Rom 6:23</ref>. </char>
    </note> Orikuhamira omu kuhikiirira aryagumaho,</para>
  <para style="q1" vid="PRO 11:19">Kwonka orikukuratira ebibi aryafa.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:20: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 29:17">1 Bus 29:17</ref>; <ref loc="PSA 119:1">Zab 119:1</ref>. </char>
    </note> Abaine omutima ogurikwehabagiza n'ekirikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 11:20">Kwonka ab'emitwarize ehikire bamushemeza.<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:5">Enf 16:5</ref>. </char>
    </note> Mumanyire kimwe ngu omunyabibi taribura kufubirwa,</para>
  <para style="q1" vid="PRO 11:21">Kwonka abahikiriire baryajunwa.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Omukazi murungi otaine mutima</para>
  <para style="q1" vid="PRO 11:22">Ni nk'empeta y'ezaabu ejwekirwe omu nyindo z'empunu.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:23: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:8">Rom 2:8</ref>. </char>
    </note> Omuheru gw'ebi ohikiriire ayetenga n'ebirungi bisha,</para>
  <para style="q1" vid="PRO 11:23">Kwonka ogw'amatsiko g'omubi n'okugirirwa ekiniga.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:7">Enf 13:7</ref>. </char>
    </note> Omuntu, n'obu agabisa emikono ebiri, ayeyongyera kutunga;</para>
  <para style="q1" vid="PRO 11:24">Ondiijo aima eki ashemereire kuha, haza kimureetera kugira obworo bwonka.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:25: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">Mat 7:2</ref>; <ref loc="2CO 9:6">2 Kor 9:6</ref>. </char>
    </note> Omuntu efura aryatunga,</para>
  <para style="q1" vid="PRO 11:25">Kandi orikuha abandi amaizi, nawe aryagaheebwa.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Orikwima abantu engano, aryajumwa boona;</para>
  <para style="q1" vid="PRO 11:26">Kwonka omugisha guryaba ahari orikuzibaguza.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:6">Enf 11:6</ref>; <ref loc="EST 7:10">Est 7:10</ref>. </char>
    </note> Orikwezirika kusherura ebirungi, aba ayesheruriire okukundwa;</para>
  <para style="q1" vid="PRO 11:27">Kwonka orikwendeza abandi obubi, buryamugarukana.<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:12">Zab 92:12</ref>; <ref loc="MRK 10:24">Mak 10:24</ref>; <ref loc="LUK 12:20">Luk 12:20</ref>, <ref loc="LUK 12:21">21</ref>; <ref loc="1TI 6:17">1 Tim 6:17</ref>. </char>
    </note> Orikwesiga eitungo rye aryahotoka,</para>
  <para style="q1" vid="PRO 11:28">Kwonka ohikiriire aryabengyeya nk'eibabi ribisi.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:29: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:27">Enf 15:27</ref>; <ref loc="ECC 5:16">Mub 5:16</ref>. </char>
    </note> Orikurabanisamu eka ye, aryahungura omuyaga,</para>
  <para style="q1" vid="PRO 11:29">Kandi omushema aryahakwa omunyabwengye.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:30: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:18">Enf 3:18</ref>. </char>
    </note> Ebyana by'ohikiriire n'ekiti ky'amagara,</para>
  <para style="q1" vid="PRO 11:30">Kandi oine obwengye ajunisa abantu.<verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:31: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:18">1 Pet 4:18</ref>. </char>
    </note> Abahikiriire ku baraabe nibafubirwa bakiri omu nsi,</para>
  <para style="q1" vid="PRO 11:31">Kaashwa ababi n'abasiisi.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:12">Enf 5:12</ref>. </char>
    </note> Okunda kuhanwa aba naakunda obwengye,</para>
  <para style="q1" vid="PRO 12:1">Kwonka oyanga kuhanwa aba ari omushema.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:35">Enf 8:35</ref>. </char>
    </note> Omuntu murungi agira obushongore ahari MUKAMA,</para>
  <para style="q1" vid="PRO 12:2">Kwonka ogira enaama mbi, MUKAMA amucwera orubanja.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:25">Enf 10:25</ref>. </char>
    </note> Omuntu tahamibwa bubi,</para>
  <para style="q1" vid="PRO 12:3">Kwonka emizi y'abahikiriire terikuurwa.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:30">Enf 14:30</ref>; <ref loc="PRO 31:10">31:10</ref>; <ref loc="SNG 3:11">Kyesh 3:11</ref>. </char>
    </note> Omukazi w'emicwe mirungi aba ekirunga kya iba,</para>
  <para style="q1" vid="PRO 12:4">Kwonka okora ebirikuhemura buba obujunde omu magufa ge.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:5: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:35">Mat 12:35</ref>. </char>
    </note> Ebiteekateeko by'ohikiriire n'eby'oburyo,</para>
  <para style="q1" vid="PRO 12:5">Kwonka okuhanuura kw'ababi n'okureebya.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:3">Enf 14:3</ref>. </char>
    </note> Ebigambo by'ababi biba eby'okugwera kujwisa eshagama,</para>
  <para style="q1" vid="PRO 12:6">Kwonka akanwa k'abaine emitima egororokire kakiza abantu.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:25">Enf 10:25</ref>, <ref loc="PRO 10:30">30</ref>; <ref loc="JOB 34:25">Yob 34:25</ref>. </char>
    </note> Ababi banagwa ahansi, bahwaho;</para>
  <para style="q1" vid="PRO 12:7">Kwonka enju y'abahikiriire eryagumaho.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Omuntu asiimwa nk'oku obwengye bwe buri,</para>
  <para style="q1" vid="PRO 12:8">Kwonka ow'omutima ogurikwehabagiza agaywa.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Omuntu otaine kitiinisa, orikwekorera,</para>
  <para style="q1" vid="PRO 12:9">Naakira orikwegira mukuru, haza ataine ky'okurya.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:10: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 25:4">Bir 25:4</ref>. </char>
    </note> Omuntu ohikiriire ata omutima aha matungo ge,</para>
  <para style="q1" vid="PRO 12:10">Kwonka embabazi z'omubi guba omwaga.<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:19">Enf 28:19</ref>. </char>
    </note> Ohinga emisiri ye, agira eby'okurya bingi;</para>
  <para style="q1" vid="PRO 12:11">Kwonka okuratira ebitaine mugasho, tagira bwengye.<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Omunaara gugumire ogw'ababi gusheenyagurika,</para>
  <para style="q1" vid="PRO 12:12">Kwonka emizi y'abahikiriire eguma ehamire.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:7">Enf 18:7</ref>; <ref loc="PRO 21:23">21:23</ref>; <ref loc="MAT 12:37">Mat 12:37</ref>. </char>
    </note> Okushobya kw'eminwa y'omubi kumunaga omu mutego,</para>
  <para style="q1" vid="PRO 12:13">Kwonka ohikiriire akira enaku.<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:2">Enf 13:2</ref>; <ref loc="PRO 18:20">18:20</ref>; <ref loc="ISA 3:10">Isa 3:10</ref>, <ref loc="ISA 3:11">11</ref>. </char>
    </note> Ebiruga omu kanwa k'omuntu nibyo bimuhaazya ebirungi;</para>
  <para style="q1" vid="PRO 12:14">Kandi ebi omuntu akora n'engaro ze nibyo azimuurirwa.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:7">Enf 3:7</ref>; <ref loc="PRO 16:2">16:2</ref>. </char>
    </note> Omuhanda gw'omushema omu kureeba kwe guba guhikire,</para>
  <para style="q1" vid="PRO 12:15">Kwonka omunyabwengye aikiriza kuhaburwa.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Okuguubwa kubi kw'omushema kumanywa ahonaaho,</para>
  <para style="q1" vid="PRO 12:16">Kwonka omuntu orikwerinda tayeta ha bijumo.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:19">Enf 6:19</ref>. </char>
    </note> Ogamba amazima, aha obwakareebi obuhikire;</para>
  <para style="q1" vid="PRO 12:17">Kwonka kareebi ow'ebishuba agamba eby'obugobya.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:4">Zab 57:4</ref>. </char>
    </note> Hariho orahukiiriza ebigambo, ebirikucumita nka rurara,</para>
  <para style="q1" vid="PRO 12:18">Kwonka orurimi rw'omunyabwengye rutamba.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Eminwa egamba amazima egumaho ebiro byona,</para>
  <para style="q1" vid="PRO 12:19">Kwonka orurimi orubeiha ruba orw'akaanya kakye.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Obugobya buba omu mitima y'abaza omu naama z'obubi,</para>
  <para style="q1" vid="PRO 12:20">Kwonka abo abaza omu naama z'obusingye bagira okushemererwa.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:10">Zab 91:10</ref>; <ref loc="ROM 8:28">Rom 8:28</ref>. </char>
    </note> Ohikiriire tahikwaho kabi,</para>
  <para style="q1" vid="PRO 12:21">Kwonka ababi batuura baijwire enaku.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:17">Enf 6:17</ref>; <ref loc="PRO 11:1">11:1</ref>, <ref loc="PRO 11:20">20</ref>. </char>
    </note> Eminwa ebeiha eba ekirikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 12:22">Kwonka abakora eby'obwesigwa nibo ashemerererwa.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Omuntu orikwerinda ashereka okumanya kwe,</para>
  <para style="q1" vid="PRO 12:23">Kwonka abashema babuzya obushema bwabo.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Omukono gw'omweziriki guryategyeka,</para>
  <para style="q1" vid="PRO 12:24">Kwonka omweremwa aryakoresibwa eby'obuhuuku.<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:13">Enf 15:13</ref>. </char>
    </note> Amaganya g'omutima gw'omuntu gamureetera okweyinamirira,</para>
  <para style="q1" vid="PRO 12:25">Kwonka ekigambo kirungi kigushemeza.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Omuntu ohikiriire ayebembera mutaahi we,</para>
  <para style="q1" vid="PRO 12:26">Kwonka omuhanda gw'ababi gubahabya.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Omweremwa takwata ki ahiigire,</para>
  <para style="q1" vid="PRO 12:27">Kwonka omweziriki aryatunga ebintu by'obuguzi bwingi.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:2">Enf 10:2</ref>. </char>
    </note> Omu muhanda gw'okuhikiirira harimu amagara,</para>
  <para style="q1" vid="PRO 12:28">Kwonka omuhanda gw'okushobya gutwara omu kufa.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:1: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:25">1 Sam 2:25</ref>. </char>
    </note> Omwana oine obwengye ahurira okuhabura kwa ishe,</para>
  <para style="q1" vid="PRO 13:1">Kwonka omugayi taikiriza kuhanwa.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:14">Enf 12:14</ref>. </char>
    </note> Omuntu arya ebirungi naabiiha omu birikuruga omu kanwa ke,</para>
  <para style="q1" vid="PRO 13:2">Kwonka eki endeebya zeetenga n'okunyagisa abandi amaani.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:7">Enf 18:7</ref>; <ref loc="PRO 21:23">21:23</ref>. </char>
    </note> Orinda akanwa ke aba arinzire amagara ge,</para>
  <para style="q1" vid="PRO 13:3">Kwonka okaashamya munonga aryacwekyerera.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:9-11">Enf 6:9-11</ref>. </char>
    </note> Omutima gw'omweremwa gwetenga, haza tiguritunga;</para>
  <para style="q1" vid="PRO 13:4">Kwonka omutima gw'omweziriki guhaaga ebirungi.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Omuntu ohikiriire ayanga ebishuba,</para>
  <para style="q1" vid="PRO 13:5">Kwonka omubi ayetamisa, kandi ayehemura.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:3">Enf 11:3</ref>. </char>
    </note> Okuhikiirira kurinda ou omuhanda gwe gugororokire,</para>
  <para style="q1" vid="PRO 13:6">Kwonka obubi bugwisa ababi.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:24">Enf 11:24</ref>; <ref loc="LUK 12:21">Luk 12:21</ref>. </char>
    </note> Hariho oyegira omutungi, haza ataine ki aine;</para>
  <para style="q1" vid="PRO 13:7">Kandi hariho oyegira omworo, haza aine eitungo ringi.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Amagara g'omuntu gacungurwa eitungo rye,</para>
  <para style="q1" vid="PRO 13:8">Kwonka omworo tagira ky'okumucungura.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 18:5">Yob 18:5</ref>; <ref loc="JOB 29:3">29:3</ref>. </char>
    </note> Omushana gw'ohikiriire gwaka gye,</para>
  <para style="q1" vid="PRO 13:9">Kwonka etabaaza y'omubi eryaraazibwa.<verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Amaryo gareeta entongane zonka,</para>
  <para style="q1" vid="PRO 13:10">Kwonka obwengye bugirwa abaikiriza kuhaburwa.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:21">Enf 20:21</ref>; <ref loc="PRO 21:6">21:6</ref>. </char>
    </note> Eitungo rya bugubugu riryatuuba,</para>
  <para style="q1" vid="PRO 13:11">Kwonka orikutunga mporampora aryarikanyisa.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:18">Enf 3:18</ref>. </char>
    </note> Amatsiko gatahweire garusya omutima,</para>
  <para style="q1" vid="PRO 13:12">Kwonka ekirikwetengwa ku kiboneka, kiba ekiri ky'amagara.<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:13: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 15:31">Kub 15:31</ref>; <ref loc="2CH 36:16">2 Bus 36:16</ref>. </char>
    </note> Ogaya ekigambo kya Ruhanga, ayereetera kucwekyerera,</para>
  <para style="q1" vid="PRO 13:13">Kwonka oyorobera ekiragiro kye, aryaheebwa ebihembo.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:11">Enf 10:11</ref>; <ref loc="PRO 14:27">14:27</ref>. </char>
    </note> Okwegyesa kw'abanyabwengye n'enshuro y'amagara,</para>
  <para style="q1" vid="PRO 13:14">Kureetera omuntu kwetantara emitego ya rufu.<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Okumanya okuhikire kureeta obushongore,</para>
  <para style="q1" vid="PRO 13:15">Kwonka omuhanda gw'abasiisi gurusya.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:2">Enf 15:2</ref>; <ref loc="PRO 18:2">18:2</ref>; <ref loc="ECC 10:3">Mub 10:3</ref>. </char>
    </note> Orikwerinda weena akoresa okumanya,</para>
  <para style="q1" vid="PRO 13:16">Kwonka omushema ayoreka obushema bwe butunu.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:13">Enf 25:13</ref>. </char>
    </note> Entumwa mbi enaga abantu omu kabi,</para>
  <para style="q1" vid="PRO 13:17">Kwonka entumwa erikwesigwa ereeta obugwa gye.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:5">Enf 15:5</ref>, <ref loc="PRO 15:32">32</ref>. </char>
    </note> Oyanga kuhaburwa, omugabo gwe guba obworo n'okuhemuka,</para>
  <para style="q1" vid="PRO 13:18">Kwonka okunda kuhanwa aryaheebwa ekitiinisa.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Ebirikwetengwa ku bihikiirizibwa, bishemeza omutima,</para>
  <para style="q1" vid="PRO 13:19">Kwonka okwetantara ebibi n'ekirikunugwa aha bashema.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Ogyenda n'abanyabwengye, nawe ahinduka omunyabwengye,</para>
  <para style="q1" vid="PRO 13:20">Kwonka mugyenzi w'abashema aryakizira.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:10">Zab 32:10</ref>; <ref loc="LUK 6:38">Luk 6:38</ref>. </char>
    </note> Akagwe kahiiga abasiisi,</para>
  <para style="q1" vid="PRO 13:21">Kwonka abahikiriire baryaheebwa okugogyera.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:22: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 27:16">Yob 27:16</ref>, <ref loc="JOB 27:17">17</ref>; <ref loc="ECC 2:26">Mub 2:26</ref>. </char>
    </note> Omuntu murungi atsigira abaijukuru obuhunguzi,</para>
  <para style="q1" vid="PRO 13:22">Kwonka eitungo ry'omusiisi ribiikirwa abahikiriire.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Emisiri y'abooro eyeza bingi,</para>
  <para style="q1" vid="PRO 13:23">Kwonka ehwa neenyagirwa busha.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:18">Enf 19:18</ref>; <ref loc="PRO 22:15">22:15</ref>. </char>
    </note> Otateera mwana we, amwanga,</para>
  <para style="q1" vid="PRO 13:24">Kwonka omukunda, amuhana bukiri kare.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Ohikiriire agira ebirikumuhaazya,</para>
  <para style="q1" vid="PRO 13:25">Kwonka enda y'omubi eguma n'enjara.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:3">Enf 24:3</ref>; <ref loc="RUT 4:11">Rus 4:11</ref>. </char>
    </note> Omukazi w'obwengye weena ayombeka eka ye,</para>
  <para style="q1" vid="PRO 14:1">Kwonka omukazi omushema agyesheenyera.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:6">Enf 28:6</ref>. </char>
    </note> Ogyenda n'omutima ogugororokire aba naatiina MUKAMA,</para>
  <para style="q1" vid="PRO 14:2">Kwonka oyehabagiza omu mihanda ye, aba naamugaya.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:6">Enf 12:6</ref>; <ref loc="JER 18:18">Yer 18:18</ref>. </char>
    </note> Ebi omushema agamba bimuteeza enkoni y'amabega,</para>
  <para style="q1" vid="PRO 14:3">Kwonka eminwa y'abanyabwengye eryabarinda.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Ahu ente z'okuhingisa zitari, tihagira bihunikirwe;</para>
  <para style="q1" vid="PRO 14:4">Kwonka ahabw'amaani g'ezo nte ebyezire biba bingi.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:19">Enf 6:19</ref>; <ref loc="EXO 23:1">Kur 23:1</ref>. </char>
    </note> Kareebi orikwesigwa tabeiha,</para>
  <para style="q1" vid="PRO 14:5">Kwonka kareebi ow'ebishuba abeiha.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:9">Enf 8:9</ref>; <ref loc="PRO 24:7">24:7</ref>. </char>
    </note> Omuteezi w'enaku ayeruhiza busha kusherura obwengye,</para>
  <para style="q1" vid="PRO 14:6">Kwonka okumanya kurahukira orikwetegyereza.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Ruga aha mushema,</para>
  <para style="q1" vid="PRO 14:7">Ahakuba tihariho kigambo ky'obwengye, eki orimushangamu.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Obwengye bw'omwerinzi n'okumanya omuhanda gwe,</para>
  <para style="q1" vid="PRO 14:8">Kwonka obushema bw'abashema n'okugobya.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:23">Enf 10:23</ref>. </char>
    </note> Ekibi kiryarya abashema,</para>
  <para style="q1" vid="PRO 14:9">Kwonka ab'emitima egororokire bagira obushongore.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Obusaasi bumanywa omutima ogu burimu,</para>
  <para style="q1" vid="PRO 14:10">Kandi omu kushemererwa kwagwo tihariho mugyenyi okwatanisa nagwo.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:25">Enf 15:25</ref>. </char>
    </note> Enju y'omubi eryasheenywa,</para>
  <para style="q1" vid="PRO 14:11">Kwonka eihema ry'ow'omutima gugororokire riryahama.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:25">Enf 16:25</ref>; <ref loc="ROM 6:21">Rom 6:21</ref>. </char>
    </note> Hariho omuhanda ogu omuntu ayeta murungi,</para>
  <para style="q1" vid="PRO 14:12">Kwonka omuheru gwagwo guri omuhanda gw'okufa.<verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:13: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 2:2">Mub 2:2</ref>; <ref loc="LUK 6:25">Luk 6:25</ref>. </char>
    </note> Nangwa n'obu asheka, omutima gwe guguma gwine obusaasi,</para>
  <para style="q1" vid="PRO 14:13">Kandi omuheru gw'okushemererwa n'enaku.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:31">Enf 1:31</ref>; <ref loc="PRO 12:14">12:14</ref>; <ref loc="ISA 3:10">Isa 3:10</ref>. </char>
    </note> Omuntu orikwehabagiza aryahaagibwa ebyana by'emitwarize ye,</para>
  <para style="q1" vid="PRO 14:14">Kandi omuntu murungi aryahaagibwa ebyana by'ebi arikukora.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Otaine bwengye aikiririza eryo,</para>
  <para style="q1" vid="PRO 14:15">Kwonka omwerinzi ayetegyereza ahu arikuraba.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:7">Enf 3:7</ref>; <ref loc="JOB 28:28">Yob 28:28</ref>. </char>
    </note> Omunyabwengye ayerinda, kandi ayetantara obubi,</para>
  <para style="q1" vid="PRO 14:16">Kwonka omushema tayenda kutegyekwa, kandi tagira ki ayetaho.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Orahuka kugira ekiniga, akora eby'obushema;</para>
  <para style="q1" vid="PRO 14:17">Kwonka omuntu orikwerinda agumisiriza.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Abataine bwengye batunga obushema,</para>
  <para style="q1" vid="PRO 14:18">Kwonka abeerinzi bajwekwa ekirunga ky'okumanya.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:19: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 42:6">Kut 42:6</ref>. </char>
    </note> Enkozi z'ebibi ziinamira abarungi,</para>
  <para style="q1" vid="PRO 14:19">N'ababi baguma aha marembo g'abahikiriire.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:4">Enf 19:4</ref>, <ref loc="PRO 19:7">7</ref>. </char>
    </note> Omworo ayangwa; nangwa na bataahi be tibamwenda;</para>
  <para style="q1" vid="PRO 14:20">Kwonka omutungi agira abanyamikago baingi.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:12">Enf 11:12</ref>; <ref loc="PSA 41:1">Zab 41:1</ref>. </char>
    </note> Orikugaya mutaahi we n'omusiisi,</para>
  <para style="q1" vid="PRO 14:21">Kwonka orikugirira abooro embabazi, ahiiriirwe.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Abagira enaama mbi, baba batahabire?</para>
  <para style="q1" vid="PRO 14:22">Kwonka abagira enaama nungi, baryakorerwa eby'embabazi n'eby'amazima.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Omu kufa kubi okw'emiringo yoona habamu omugasho;</para>
  <para style="q1" vid="PRO 14:23">Kwonka okugamba kwonka kureeta obworo.<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Ekirunga ky'abanyabwengye n'obutungi bwabo,</para>
  <para style="q1" vid="PRO 14:24">Kwonka obushema n'eihunde ry'abashema.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:5">Enf 14:5</ref>. </char>
    </note> Kareebi ow'amazima akiza amagara g'abantu,</para>
  <para style="q1" vid="PRO 14:25">Kwonka ogamba ebishuba aba omureebya.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:26: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:33">Enf 1:33</ref>; <ref loc="PSA 14:6">Zab 14:6</ref>. </char>
    </note> Omu kutiina MUKAMA omuntu agiriramu obwesigye buhamire,</para>
  <para style="q1" vid="PRO 14:26">Kandi abaana be baryabona obuhungiro.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:14">Enf 13:14</ref>. </char>
    </note> Okutiina MUKAMA n'enshuro y'amagara,</para>
  <para style="q1" vid="PRO 14:27">Kureetera abantu kuruga omu mitego ya rufu.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:28: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:20">1 Bag 4:20</ref>. </char>
    </note> Ekihaisa omugabe ekitiinisa n'okugira abantu baingi munonga,</para>
  <para style="q1" vid="PRO 14:28">Kwonka omutegyeki otaine bantu acwekyerera.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:29: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:18">Enf 15:18</ref>; <ref loc="PRO 16:32">16:32</ref>; <ref loc="PRO 19:11">19:11</ref>; <ref loc="ECC 7:9">Mub 7:9</ref>; <ref loc="JAS 1:19">Yak 1:19</ref>. </char>
    </note> Otarahuka kugira kiniga, aba aine okwetegyereza kwingi,</para>
  <para style="q1" vid="PRO 14:29">Kwonka orahuka kukigira, ahimbisisa obushema.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:30: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:4">Enf 12:4</ref>. </char>
    </note> Omutima ogutuurize gureetera omubiri amagara,</para>
  <para style="q1" vid="PRO 14:30">Kwonka eihari rireetera amagufa kujunda.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:31: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:5">Enf 17:5</ref>; <ref loc="PRO 22:2">22:2</ref>; <ref loc="MAT 25:40">Mat 25:40</ref>, <ref loc="MAT 25:45">45</ref>. </char>
    </note> Ohata omunaku, aba naajuma Omuhangi we,</para>
  <para style="q1" vid="PRO 14:31">Kwonka ogirira abakyene embabazi, amuha ekitiinisa.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:32: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 23:10">Kub 23:10</ref>; <ref loc="JOB 19:25-27">Yob 19:25-27</ref>; <ref loc="PSA 23:4">Zab 23:4</ref>. </char>
    </note> Omubi agarurwa ahansi okukora kubi kwe,</para>
  <para style="q1" vid="PRO 14:32">Kwonka ohikiriire aguma n'amatsiko, nangwa n'omu kufa kwe.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Obwengye butuura omu mutima gw'orikwetegyereza,</para>
  <para style="q1" vid="PRO 14:33">Kwonka omu mitima y'abashema tibumanywamu.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Okuhikiirira kuhimbisisa eihanga;</para>
  <para style="q1" vid="PRO 14:34">Kwonka ekibi kijumisa ibara ihanga.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:35: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:13">Enf 16:13</ref>; <ref loc="MAT 24:45-47">Mat 24:45-47</ref>. </char>
    </note> Omugabe agirira embabazi omugaragwa orikukora n'obwengye;</para>
  <para style="q1" vid="PRO 14:35">Kwonka agirira ekiniga orikukora ebirikuhemura.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:1: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 8:1-3">Bar 8:1-3</ref>; <ref loc="1SA 25:10-13">1 Sam 25:10-13</ref>; <ref loc="1KI 12:13-16">1 Bag 12:13-16</ref>; <ref loc="PRO 25:15">Enf 25:15</ref>. </char>
    </note> Okugarukamu gye kwikaikanisa ekiniga;</para>
  <para style="q1" vid="PRO 15:1">Kwonka ekigambo ekirikusaasa kiimutsya ekiniga.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:23">Enf 12:23</ref>. </char>
    </note> Orurimi rw'abanyabwengye rumanyisa okumanya nk'oku kishemereire,</para>
  <para style="q1" vid="PRO 15:2">Kwonka akanwa k'abashema kafukunkuka eby'obushema.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:21">Enf 5:21</ref>; <ref loc="JOB 31:4">Yob 31:4</ref>; <ref loc="JER 16:17">Yer 16:17</ref>; <ref loc="ZEC 4:10">Zek 4:10</ref>; <ref loc="HEB 4:13">Heb 4:13</ref>. </char>
    </note> Amaisho ga MUKAMA gaba hoonahoona,</para>
  <para style="q1" vid="PRO 15:3">Gareeba ababi n'abarungi.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:3">Enf 11:3</ref>; <ref loc="PRO 12:18">12:18</ref>. </char>
    </note> Orurimi orurikukiza n'ekiti ky'amagara;</para>
  <para style="q1" vid="PRO 15:4">Kwonka ku rukiikama, omutima gucweka.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:18">Enf 13:18</ref>. </char>
    </note> Omushema agaya okuhabura kwa ishe,</para>
  <para style="q1" vid="PRO 15:5">Kwonka ota omutima aha kuhanwa, niwe aba omwerinzi.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Omu nju y'ohikiriire habamu obutungi bwingi,</para>
  <para style="q1" vid="PRO 15:6">Kwonka omu magoba g'omubi habamu enaku.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:7: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">Mat 12:34</ref>, <ref loc="MAT 12:35">35</ref>. </char>
    </note> Eminwa y'abanyabwengye ebuzya okumanya,</para>
  <para style="q1" vid="PRO 15:7">Kwonka emitima y'abashema tekora etyo.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:27">Enf 21:27</ref>; <ref loc="PRO 28:9">28:9</ref>; <ref loc="ISA 1:11">Isa 1:11</ref>, <ref loc="ISA 1:15">15</ref>; <ref loc="ISA 66:3">66:3</ref>; <ref loc="JER 6:20">Yer 6:20</ref>; <ref loc="AMO 5:22">Amo 5:22</ref>. </char>
    </note> Ekitambo ky'omubi n'ekirikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 15:8">Kwonka okushaba kw'ow'omutima ogugororokire nikwo ashemerererwa.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:21">Enf 21:21</ref>; <ref loc="ISA 51:1">Isa 51:1</ref>; <ref loc="1TI 6:11">1 Tim 6:11</ref>. </char>
    </note> Omuhanda gw'omubi n'ogurikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 15:9">Kwonka akunda orikukuratira okuhikiirira.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:1">Enf 12:1</ref>. </char>
    </note> Orikuteishuka omuhanda naaheebwa ekifubiro ekirikusaasa,</para>
  <para style="q1" vid="PRO 15:10">Kwonka orikwanga kuhanwa aryafa.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:11: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:7">1 Sam 16:7</ref>; <ref loc="2KI 6:30">2 Bag 6:30</ref>; <ref loc="JOB 26:6">Yob 26:6</ref>; <ref loc="JHN 2:24">Yoh 2:24</ref>, <ref loc="JHN 2:25">25</ref>. </char>
    </note> Okuzimu n'okucwekyerera nibireebwa butunu omu maisho ga MUKAMA,</para>
  <para style="q1" vid="PRO 15:11">Kaashwa ebiri omu mitima y'abantu!<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Omugayi takunda kuhanwa,</para>
  <para style="q1" vid="PRO 15:12">Kandi taza w'abanyabwengye.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:25">Enf 12:25</ref>; <ref loc="PRO 17:22">17:22</ref>. </char>
    </note> Omutima gunanukire gushemuura ahamaisho,</para>
  <para style="q1" vid="PRO 15:13">Kwonka omutima ogwine obusaasi gureeta okwehwa amatsiko.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:6">Enf 14:6</ref>. </char>
    </note> Omutima gw'orikwetegyereza gusherura okumanya,</para>
  <para style="q1" vid="PRO 15:14">Kwonka akanwa k'abashema katungwa obushema.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Ebiro by'abarikubonabona byona ni bibi,</para>
  <para style="q1" vid="PRO 15:15">Kwonka oine omutima ogushemereirwe ni nk'omuntu otuura omu bugyenyi.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:8">Enf 16:8</ref>; <ref loc="PSA 37:16">Zab 37:16</ref>; <ref loc="ECC 4:6">Mub 4:6</ref>. </char>
    </note> Akakye akarimu okutiina MUKAMA</para>
  <para style="q1" vid="PRO 15:16">Nikakira obutungi bwingi oburimu obujune.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:1">Enf 17:1</ref>. </char>
    </note> Okurya obunyaata okurimu okukundana</para>
  <para style="q1" vid="PRO 15:17">Nikukira okurya ente y'ebishaju okurimu okwangana.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:29">Enf 14:29</ref>; <ref loc="PRO 29:22">29:22</ref>. </char>
    </note> Orahuka kubakirwa aimutsya entongane,</para>
  <para style="q1" vid="PRO 15:18">Otarahuka kugira kiniga acureeza empaka.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Omuhanda gw'omweremwa gufa ahabw'okumerwamu amahwa,</para>
  <para style="q1" vid="PRO 15:19">Kwonka akahanda k'ow'omutima ogugororokire guba omuhanda rugyendwa.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:1">Enf 10:1</ref>. </char>
    </note> Omwana oine obwengye ashemeza ishe,</para>
  <para style="q1" vid="PRO 15:20">Kwonka omuntu omushema agaya nyina.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:21: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:15">Efe 5:15</ref>. </char>
    </note> Obushema bureetera otaine bwengye kushemererwa,</para>
  <para style="q1" vid="PRO 15:21">Kwonka omuntu orikwetegyereza ayetebeekanisiza omuhanda oguhikire.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:14">Enf 11:14</ref>. </char>
    </note> Ahatari kuhanuura enaama zifa busha,</para>
  <para style="q1" vid="PRO 15:22">Kwonka ahu abahi b'obwengye bari baingi, zihikiirizibwa.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Okugarukamu gye kureetera omuntu kushemererwa,</para>
  <para style="q1" vid="PRO 15:23">Kandi ekigambo ekigambiirwe omu bunaku bwakyo ka ni kirungi!<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:24: </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:2">Kol 3:2</ref>. </char>
    </note> Aha munyabwengye omuhanda gw'amagara gwinamuka,</para>
  <para style="q1" vid="PRO 15:24">Ngu abone kuruga okuzimu owa Nyamuteza.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:10">Enf 23:10</ref>; <ref loc="PSA 146:9">Zab 146:9</ref>. </char>
    </note> MUKAMA asheenyera kimwe orugo rw'ab'amaryo,</para>
  <para style="q1" vid="PRO 15:25">Kwonka ahamya orubibi rw'omufaakazi.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Ebiteekateeko by'ababi n'ekirikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 15:26">Ebigambo by'abashemeire bimushemeza.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:19">Enf 1:19</ref>; <ref loc="PRO 17:23">17:23</ref>; <ref loc="JOS 6:18">Yos 6:18</ref>; <ref loc="JOS 7:25">7:25</ref>. </char>
    </note> Omunyamururu gw'amagoba agatahikire areetera eka ye omurabanamu;</para>
  <para style="q1" vid="PRO 15:27">Kwonka orikwanga enguzi aryagumaho.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:28: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:15">1 Pet 3:15</ref>. </char>
    </note> Omutima gw'ohikiriire guteekateeka oku araagarukyemu,</para>
  <para style="q1" vid="PRO 15:28">Kwonka akanwa k'omubi kafukunkuka ebigambo bibi.<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:18">Zab 145:18</ref>, <ref loc="PSA 145:19">19</ref>; <ref loc="JHN 9:31">Yoh 9:31</ref>. </char>
    </note> MUKAMA aba hare enkozi z'ebibi,</para>
  <para style="q1" vid="PRO 15:29">Kwonka ahurira okushaba kw'ohikiriire.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Amaisho gashemuukire gashemeza omutima,</para>
  <para style="q1" vid="PRO 15:30">N'enkuru nungi ziruhuura amagufa.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Orikutega okutu okuhana kurungi</para>
  <para style="q1" vid="PRO 15:31">Aryatuura n'abanyabwengye.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:32: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:33">Enf 8:33</ref>, <ref loc="PRO 8:36">36</ref>. </char>
    </note> Oyanga kuhanwa aba naayeyanga,</para>
  <para style="q1" vid="PRO 15:32">Kwonka ota omutima aha kuhanwa ayeyongyera okwetegyereza.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:33: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:7">Enf 1:7</ref>; <ref loc="PRO 18:12">18:12</ref>; <ref loc="PRO 29:23">29:23</ref>. </char>
    </note> Okutiina MUKAMA nikwo kuhaburwa omu by'obwengye,</para>
  <para style="q1" vid="PRO 15:33">Kandi okwecureeza kukuratwa ekitiinisa.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="s1">Ezindi nfumu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:19">Mat 10:19</ref>. </char>
    </note> Enaama ei omuntu agira omu mutima ebe eye,</para>
  <para style="q1" vid="PRO 16:1">Kwonka okugarukamu kw'orurimi kuruga ahari MUKAMA.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:2">Enf 21:2</ref>; <ref loc="PRO 24:12">24:12</ref>. </char>
    </note> Emitwarize y'omuntu yoona, omu kureeba kwe, eba eshemeire;</para>
  <para style="q1" vid="PRO 16:2">Kwonka MUKAMA apima emitima.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:5">Zab 37:5</ref>. </char>
    </note> Emirimo yaawe gyegyekyerere MUKAMA;</para>
  <para style="q1" vid="PRO 16:3">Obwo nibwo enaama zaawe zirihamibwa.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:4: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:30">Yob 21:30</ref>; <ref loc="ROM 9:22">Rom 9:22</ref>. </char>
    </note> Buri kintu MUKAMA agira eki yaakihangiire;</para>
  <para style="q1" vid="PRO 16:4">Nangwa n'ababi akabateeraho ekiro ky'enaku.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:21">Enf 11:21</ref>; <ref loc="LUK 16:15">Luk 16:15</ref>. </char>
    </note> Omuntu weena ow'amaryo g'omu mutima n'ekirikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 16:5">Buzimazima taribura kufubirwa.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:16">Enf 14:16</ref>; <ref loc="DAN 4:27">Dan 4:27</ref>. </char>
    </note> Embabazi n'amazima nibyo birihiirira okutahikiirira,</para>
  <para style="q1" vid="PRO 16:6">Kandi okutiina MUKAMA nikwo kurekyesa abantu ebibi.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 26:28">Kut 26:28</ref>; <ref loc="2CH 17:10">2 Bus 17:10</ref>; <ref loc="1PE 3:13">1 Pet 3:13</ref>. </char>
    </note> Emitwarize y'omuntu ku eshemeza MUKAMA,</para>
  <para style="q1" vid="PRO 16:7">Areetera abantu kuba gye nawe, nangwa n'abazigu be.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:16">Enf 15:16</ref>. </char>
    </note> Akakye akarimu okuhikiirira</para>
  <para style="q1" vid="PRO 16:8">Nikakira empiiha nyingi ezitungirwa omu kutahikiirira.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:21">Enf 19:21</ref>; <ref loc="PRO 20:24">20:24</ref>; <ref loc="JER 10:23">Yer 10:23</ref>. </char>
    </note> Omutima gw'omuntu guteekateeka eby'orugyendo rwe;</para>
  <para style="q1" vid="PRO 16:9">Kwonka MUKAMA niwe amuhabura oku araateere entambwe.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:10: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 3:28">1 Bag 3:28</ref>. </char>
    </note> Okuragura okuri nk'okwa Ruhanga kuruga aha rurimi rw'omugabe;</para>
  <para style="q1" vid="PRO 16:10">Omu kucwa emanja akanwa ke tikashobya.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:1">Enf 11:1</ref>. </char>
    </note> Eminzaani ehikire n'eby'okupimisa n'ebya MUKAMA,</para>
  <para style="q1" vid="PRO 16:11">N'amabaare goona agarikupima ag'omu nshaho n'omurimo gwe.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:14">Enf 29:14</ref>; <ref loc="ISA 16:5">Isa 16:5</ref>. </char>
    </note> Abagabe okukora ebibi n'ekirikunugwa,</para>
  <para style="q1" vid="PRO 16:12">Ahakuba ekitebe ky'obugabe kihamibwa okuhikiirira.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:11">Enf 22:11</ref>. </char>
    </note> Eminwa y'okuhikiirira niyo eshemeza omugabe,</para>
  <para style="q1" vid="PRO 16:13">Kandi akunda orikugamba ebihikire.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:15">Enf 25:15</ref>. </char>
    </note> Ekiniga ky'omugabe n'entumwa ya rufu,</para>
  <para style="q1" vid="PRO 16:14">Kwonka omunyabwengye aryakiikaikanisa.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Omugabe ku ashemuuka ahamaisho, kireeta amagara;</para>
  <para style="q1" vid="PRO 16:15">Kandi okukunda kwe kushusha ebicu ebirugamu enjura ya katumba.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:10">Enf 8:10</ref>, <ref loc="PRO 8:11">11</ref>, <ref loc="PRO 8:19">19</ref>. </char>
    </note> Okugira obwengye ni kurungi okukira okutunga ezaabu;</para>
  <para style="q1" vid="PRO 16:16">Eego, omuntu akaatoorana okugira okwetegyereza okukira okutunga efeeza.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 4:27">Enf 4:27</ref>. </char>
    </note> Omuhanda rugyendwa gw'ow'omutima gugororokire n'okwetantara ebibi;</para>
  <para style="q1" vid="PRO 16:17">Orinda emitwarize ye, aba naarinda amagara ge.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:2">Enf 11:2</ref>. </char>
    </note> Amaryo gakuratwa okucwekyerera,</para>
  <para style="q1" vid="PRO 16:18">N'omutima ogurikwetunguura gukuratwa okugwa.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Ni kirungi okugira omutima gworobi, okakwatanisa n'abooro,</para>
  <para style="q1" vid="PRO 16:19">Okukira okubagana eminyago n'abanyamaryo.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:12">Zab 2:12</ref>. </char>
    </note> Orikuta omutima aha kigambo kya Ruhanga aryagogyera,</para>
  <para style="q1" vid="PRO 16:20">Kandi oyesiga MUKAMA aba ahiiriirwe.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Oine omutima gw'obwengye ayetwa omuntu orikukyenga;</para>
  <para style="q1" vid="PRO 16:21">Emigambire mirungi eyongyera kwikirizisa abantu.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:11">Enf 10:11</ref>. </char>
    </note> Obwengye bubeera obwine enshuro y'amagara,</para>
  <para style="q1" vid="PRO 16:22">Kwonka ekifubiro ky'abashema n'obushema bwabo.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:23: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">Mat 12:34</ref>. </char>
    </note> Omutima gw'omunyabwengye guhindura emigambire ye kuba ehikire,</para>
  <para style="q1" vid="PRO 16:23">Kandi gumwongyera kugamba ebirikwikirizisa abantu.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:10">Zab 19:10</ref>. </char>
    </note> Ebigambo ebirikushemeza ni nk'obwoki,</para>
  <para style="q1" vid="PRO 16:24">Binurira amagara g'omuntu, kandi bihamya amagufa ge.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:12">Enf 14:12</ref>. </char>
    </note> Hariho omuhanda ogu omuntu ayeta murungi,</para>
  <para style="q1" vid="PRO 16:25">Kwonka omuheru gwagwo guri omuhanda gw'okufa.<verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:26: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 6:7">Mub 6:7</ref>. </char>
    </note> Enda y'omukozi niyo emukoresa,</para>
  <para style="q1" vid="PRO 16:26">N'akanwa ke niko kamugyema kukora.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:12">Enf 6:12</ref>, <ref loc="PRO 6:14">14</ref>; <ref loc="JAS 3:6">Yak 3:6</ref>. </char>
    </note> Omuntu otaine mugasho agira enaama z'okukora kubi,</para>
  <para style="q1" vid="PRO 16:27">Kandi emigambire ye ni nk'omuriro ogurikubabura.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:9">Enf 17:9</ref>; <ref loc="PRO 26:20">26:20</ref>. </char>
    </note> Omuntu orikwehabagiza abuzya entongane,</para>
  <para style="q1" vid="PRO 16:28">Kandi omuhwihwitsi ataanisa abanyamikago.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Omunyaitima abeihabeiha mutaahi we,</para>
  <para style="q1" vid="PRO 16:29">Amutwara omu muhanda ogutari murungi.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Oitira abandi eriisho, aba naahanuura enaama zikiikami;</para>
  <para style="q1" vid="PRO 16:30">Onena enshaya, aba naayenda kuhikiiriza obubi.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:31: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:29">Enf 20:29</ref>. </char>
    </note> Omutwe gujwengize enju n'ekirunga ky'ekitiinisa,</para>
  <para style="q1" vid="PRO 16:31">Kandi kitungwa ahabw'okugyendera omu muhanda gw'okuhikiirira.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:32: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:29">Enf 14:29</ref>; <ref loc="PRO 25:28">25:28</ref>. </char>
    </note> Otarikurahuka kugira ekiniga naakira emanzi,</para>
  <para style="q1" vid="PRO 16:32">Kandi orikutegyeka omutima gwe naakira okwatsire orurembo.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:33: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:26">Enf 29:26</ref>; <ref loc="ACT 1:26">Byak 1:26</ref>. </char>
    </note> Abantu baraguzisa entetere aha ruhu,</para>
  <para style="q1" vid="PRO 16:33">Kwonka endagu yoona eruga ahari MUKAMA.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:17">Enf 15:17</ref>. </char>
    </note> Ak'okurya k'obunyaata, kwonka karimu obusingye,</para>
  <para style="q1" vid="PRO 17:1">Nikakira eka eijwire eby'okurya by'obugyenyi, kwonka erimu entongane.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Omuhuuku orikukoresa obwengye,</para>
  <para style="q1" vid="PRO 17:2">Aryategyeka omwana wa mukama we orikuhemura,</para>
  <para style="q1" vid="PRO 17:2">Kandi aragwe hamwe n'abaana ba mukama we.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:21">Enf 27:21</ref>; <ref loc="1CH 29:17">1 Bus 29:17</ref>; <ref loc="PSA 26:2">Zab 26:2</ref>; <ref loc="JER 17:10">Yer 17:10</ref>. </char>
    </note> Eiziiko riba ery'okushemerezamu efeeza,</para>
  <para style="q1" vid="PRO 17:3">N'omuriro guba ogw'okushemerezamu ezaabu,</para>
  <para style="q1" vid="PRO 17:3">Kwonka MUKAMA niwe agyeza emitima.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Enkozi y'ebibi ehurira emigambire y'obubi,</para>
  <para style="q1" vid="PRO 17:4">Kandi orikubeiha atega okutu orurimi rw'eitima.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:31">Enf 14:31</ref>; <ref loc="PRO 24:17">24:17</ref>; <ref loc="JOB 31:29">Yob 31:29</ref>; <ref loc="OBA 1:13">Oba 13</ref>. </char>
    </note> Oteerera enaku omukyene, aba naajuma Omuhangi we;</para>
  <para style="q1" vid="PRO 17:5">Orikwesiimira abandi kugwerwa akagwe, taribura kufubirwa.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Abaijukuru n'ekirunga ky'abagurusi,</para>
  <para style="q1" vid="PRO 17:6">Kandi ekitiinisa ky'abaana ni baishebo.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Emigambire ehikire teizihira mushema,</para>
  <para style="q1" vid="PRO 17:7">Kandi okukira munonga emigambire y'ebishuba teizihira mutegyeki.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Enguzi aha muntu ogihaire ni nk'eibaare eririkukora eby'okutangaaza;</para>
  <para style="q1" vid="PRO 17:8">Ahu arikuza hoona, naagogyera.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:12">Enf 10:12</ref>; <ref loc="PRO 16:28">16:28</ref>. </char>
    </note> Oshwekyerera ekishobyo, aba naayenda kukundwa;</para>
  <para style="q1" vid="PRO 17:9">Kwonka oyata eibanga, aba naayeyangisa munywani we.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Okuhanwa kuhika omunyabwengye aha mutima,</para>
  <para style="q1" vid="PRO 17:10">Okukira okuhanisa omushema enkoni igana.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:11: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 2:29">1 Bag 2:29</ref>. </char>
    </note> Omuntu mubi akunda obugomi bwonka;</para>
  <para style="q1" vid="PRO 17:11">Nikyo aritumirwa entumwa y'enshaarizi kumukwata.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:12: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 17:8">2 Sam 17:8</ref>; <ref loc="HOS 13:8">Hos 13:8</ref>. </char>
    </note> Haakiri okubugana edubu eyakirwe ebyana byayo</para>
  <para style="q1" vid="PRO 17:12">Okukira okubugana omushema oitsirwe obushema.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:13: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 12:11">2 Sam 12:11</ref>; <ref loc="PSA 109:5">Zab 109:5</ref>. </char>
    </note> Orikuzimuura obubi ahabw'oburungi,</para>
  <para style="q1" vid="PRO 17:13">Obubi tiburiruga mu ka ye.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:3">Enf 20:3</ref>; <ref loc="PRO 25:8">25:8</ref>.</char>
    </note> Okutandika entongane ni nk'okwigurira amaizi;</para>
  <para style="q1" vid="PRO 17:14">N'ahabw'ekyo reka empaka zitakarugiremu okutongana.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:5">Enf 18:5</ref>; <ref loc="PRO 24:24">24:24</ref>; <ref loc="EXO 23:7">Kur 23:7</ref>; <ref loc="ISA 5:23">Isa 5:23</ref>. </char>
    </note> Oiha orubanja aha babi, kandi n'orusingisa abahikiriire,</para>
  <para style="q1" vid="PRO 17:15">Bombi n'ekirikunugwa ahari MUKAMA.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Ahabw'enki omushema agira empiiha omu ngaro ngu agure obwengye,</para>
  <para style="q1" vid="PRO 17:16">Haza ataine mutima?<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:24">Enf 18:24</ref>; <ref loc="RUT 1:16">Rus 1:16</ref>. </char>
    </note> Munywani w'omuntu amukunda ebiro byona,</para>
  <para style="q1" vid="PRO 17:17">Kandi ow'eishe-emwe azaarirwa okuhwera abantu omu bihikiirizi.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:1">Enf 6:1</ref>. </char>
    </note> Omuntu otaine bwengye aha omukwato,</para>
  <para style="q1" vid="PRO 17:18">Kandi ayemererera ondi omu maisho ga mutaahi we.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:23">Enf 29:23</ref>. </char>
    </note> Okunda entongane, aba akunzire okushiisha;</para>
  <para style="q1" vid="PRO 17:19">Orikukunda kweshumbya abandi eka, naaba ayesheruriire okucwekyerera.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Oine omutima ogurikwehabagiza, taribona kirungi;</para>
  <para style="q1" vid="PRO 17:20">Kandi n'ow'orurimi orukiikami aryagwa omu kabi.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:13">Enf 19:13</ref>. </char>
    </note> Ozaara omushema, aba ayereeteire obusaasi;</para>
  <para style="q1" vid="PRO 17:21">Ishe w'otaine bwengye tashemererwa.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:13">Enf 15:13</ref>; <ref loc="PSA 22:15">Zab 22:15</ref>. </char>
    </note> Omutima ogushemereirwe n'omubazi murungi,</para>
  <para style="q1" vid="PRO 17:22">Kwonka omutima ogucuramiriirwe gureetera omuntu kuhwa aha magufa.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:23: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:8">Kur 23:8</ref>; <ref loc="MIC 3:11">Mik 3:11</ref>. </char>
    </note> Omubi ayakiira enguzi erikushooboorwa omu kwahwa,</para>
  <para style="q1" vid="PRO 17:23">Ngu abone kwita emanja z'oburyo.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:6">Enf 14:6</ref>; <ref loc="DEU 30:11-14">Bir 30:11-14</ref>. </char>
    </note> Orikwetegyereza, amaisho ge agata aha bwengye;</para>
  <para style="q1" vid="PRO 17:24">Kwonka amaisho g'omushema, agata aha by'aha muheru gw'ensi.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:1">Enf 10:1</ref>. </char>
    </note> Omwana ekifa-mutima areetera ishe obusaasi,</para>
  <para style="q1" vid="PRO 17:25">Na nyina owaamuzaire amureetera obushaarizi.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Okubonabonesa ohikiriire ti kirungi,</para>
  <para style="q1" vid="PRO 17:26">N'obu kwakuba okuteera abakungu noobatura oburungi bwabo.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:19">Enf 10:19</ref>. </char>
    </note> Oyetwara omu kugamba aba ow'obwengye,</para>
  <para style="q1" vid="PRO 17:27">Kandi ow'omutima gutuurize aba omuntu orikwetegyereza.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Nangwa n'omushema ku ahunama, bateekateeka ngu n'omunyabwengye;</para>
  <para style="q1" vid="PRO 17:28">Ku aba abumbire eminwa, bagira ngu, N'omwerinzi.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Oyetaanisa n'abandi, aba naasherura ebye wenka;</para>
  <para style="q1" vid="PRO 18:1">Kandi aba ayangire obwengye bwona obuhikire.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:16">Enf 13:16</ref>. </char>
    </note> Omushema tashemerererwa kwetegyereza,</para>
  <para style="q1" vid="PRO 18:2">Kureka ashemezibwa okugamba ebiteekateeko bye.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Ku haija obubi, n'okugaya kwija;</para>
  <para style="q1" vid="PRO 18:3">Kandi emitwarize mibi ereeta okuhemuka.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:5">Enf 20:5</ref>. </char>
    </note> Ebigambo by'omu kanwa k'omuntu ni nk'amaizi maingi,</para>
  <para style="q1" vid="PRO 18:4">Kandi enshuro y'obwengye ni nk'omugyera gurikuhimintika.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:15">Enf 17:15</ref>; <ref loc="PSA 82:2">Zab 82:2</ref>; <ref loc="DEU 1:17">Bir 1:17</ref>; <ref loc="LEV 19:15">Lev 19:15</ref>. </char>
    </note> Ti kirungi kugwera orubaju rw'omubi omu rubanja,</para>
  <para style="q1" vid="PRO 18:5">N'obu kwakuba okwita orubanja rw'ohikiriire.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Ebigambo by'omushema bireeta entongane,</para>
  <para style="q1" vid="PRO 18:6">Kandi orurimi rwe rumuteeza enkoni.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:13">Enf 12:13</ref>; <ref loc="ECC 10:12">Mub 10:12</ref>. </char>
    </note> Akanwa k'omushema kamucwekyereza,</para>
  <para style="q1" vid="PRO 18:7">N'eminwa ye niyo emugwisa omu mutego.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:22">Enf 26:22</ref>. </char>
    </note> Ebigambo by'abahwihwitsi ni nk'eby'okurya ebinuzire munonga,</para>
  <para style="q1" vid="PRO 18:8">Bishuuma omu bicweka by'omunda.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Orikweganda aha murimo gwe</para>
  <para style="q1" vid="PRO 18:9">Ni murumuna w'orikucwekyereza.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:25">Enf 29:25</ref>; <ref loc="PSA 61:3">Zab 61:3</ref>. </char>
    </note> Eiziina rya MUKAMA n'omunaara gugumire,</para>
  <para style="q1" vid="PRO 18:10">Ohikiriire ku aguhungiramu, aguma ari buhooro.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:15">Enf 10:15</ref>. </char>
    </note> Eitungo ry'omutungi nirwo rurembo rwe oruhamire,</para>
  <para style="q1" vid="PRO 18:11">Kandi ni nk'orugo ruraingwa rw'amabaare orurikumurinda.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:2">Enf 11:2</ref>; <ref loc="PRO 15:33">15:33</ref>. </char>
    </note> Okwehimbisa kw'omutima gw'omuntu kukuratwa okucwekyerera,</para>
  <para style="q1" vid="PRO 18:12">Kwonka okwecureeza kukuratwa ekitiinisa.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Ogarukamu atabandize kuhurira</para>
  <para style="q1" vid="PRO 18:13">Kyoreka obushema bwe n'okuhemuka.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Omutima guhamire gugumya omuntu omu ndwara ye,</para>
  <para style="q1" vid="PRO 18:14">Kwonka oguhahaire n'oha owaakubaasa kugwemera?<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Omutima gw'omwerinzi gutunga okumanya,</para>
  <para style="q1" vid="PRO 18:15">Kandi okutu kw'omunyabwengye nikyo kwetenga.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 32:20">Kut 32:20</ref>; <ref loc="1SA 25:27">1 Sam 25:27</ref>. </char>
    </note> Ekiconco ky'omuntu kimuhaisa omwanya,</para>
  <para style="q1" vid="PRO 18:16">Kandi kimuhitsya omu maisho g'ab'ekitiinisa.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Omu rubanja, obanza kutongana oshusha oti, ebye nibyo bihikire;</para>
  <para style="q1" vid="PRO 18:17">Kwonka kitabaarizibwa ku aija, amwomesereza.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Enteenyu emara empaka,</para>
  <para style="q1" vid="PRO 18:18">Kandi eramura ab'ekitiinisa abarikuhakana.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Okugarukana n'ow'eishe-mwe ogwisiibwe kubi kugumire okukira okwata orurembo rw'amaani,</para>
  <para style="q1" vid="PRO 18:19">Kandi entongane nk'ezo zigumire okukira ebihongorezo by'ekigo.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:14">Enf 12:14</ref>. </char>
    </note> Ebiruga omu kanwa k'omuntu nibyo bimuhaazya,</para>
  <para style="q1" vid="PRO 18:20">Kandi omweru gw'eminwa ye nigwo gurimuhaazya.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Orurimi rugira obushoboorozi bw'okwita n'obw'okukiza,</para>
  <para style="q1" vid="PRO 18:21">N'abarukunda baryaheebwa ebi ruribareetera.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:14">Enf 19:14</ref>. </char>
    </note> Oboine mukazi w'okushwera, aba aboine ekintu kirungi;</para>
  <para style="q1" vid="PRO 18:22">Kandi aba atungire omugisha ogurugire ahari MUKAMA.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:23: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 2:6">Yak 2:6</ref>. </char>
    </note> Omworo agamba naayeshengyereza munonga;</para>
  <para style="q1" vid="PRO 18:23">Kwonka omutungi amugarukisamu ekikabuko.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:17">Enf 17:17</ref>. </char>
    </note> Emikago mingi esheenya eka,</para>
  <para style="q1" vid="PRO 18:24">Kwonka habaho munywani w'omuntu okira owaanyina owaazairwe nawe.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:6">Enf 28:6</ref>. </char>
    </note> Omworo ogyendera omu bwesigwa</para>
  <para style="q1" vid="PRO 19:1">Akira ow'orurimi rurikukiikamya ebigambo kandi omushema.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Omuntu okubaho otaine bwengye ti kirungi,</para>
  <para style="q1" vid="PRO 19:2">Kandi ogyenda naayehuuta, ahaba omuhanda.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:3: </char>
      <char style="xt" closed="false">
        <ref loc="REV 16:11">Kush 16:11</ref>. </char>
    </note> Obushema bw'omuntu ku bumuhabya omuhanda,</para>
  <para style="q1" vid="PRO 19:3">Omutima gwe gwetomboitera MUKAMA.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:20">Enf 14:20</ref>. </char>
    </note> Obutungi bureeta emikago mingi,</para>
  <para style="q1" vid="PRO 19:4">Kwonka omworo atsigwaho munywani we.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:19">Enf 6:19</ref>; <ref loc="PRO 21:28">21:28</ref>. </char>
    </note> Kareebi w'ebishuba taribura kufubirwa,</para>
  <para style="q1" vid="PRO 19:5">Kandi orikugamba ebishuba tarikira.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Baingi basherura obuhakwa ha muntu efura,</para>
  <para style="q1" vid="PRO 19:6">Kandi buri muntu aba munywani w'ogwo orikugaba.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:20">Enf 14:20</ref>. </char>
    </note> Abazairwe n'omworo boona bamwanga,</para>
  <para style="q1" vid="PRO 19:7">Mbwenu banywani be tibakiraho kumwetantara?</para>
  <para style="q1" vid="PRO 19:7">Ku abakuratsa amaganya, bamuhugaho beegyendera.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Owaagira obwengye, akunda amagara ge;</para>
  <para style="q1" vid="PRO 19:8">Orikurinda okwetegyereza, aryagogyera.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Kareebi ow'ebishuba taribura kufubirwa</para>
  <para style="q1" vid="PRO 19:9">Kandi omunyabishuba aryacwekyerera.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:21">Enf 30:21</ref>, <ref loc="PRO 30:22">22</ref>; <ref loc="ECC 10:6">Mub 10:6</ref>, <ref loc="ECC 10:7">7</ref>. </char>
    </note> Omushema tashemereire kuba orikwegira gye,</para>
  <para style="q1" vid="PRO 19:10">N'okukira munonga omuhuuku tashemereire kutegyeka abanyiginya.<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:29">Enf 14:29</ref>; <ref loc="ROM 12:19">Rom 12:19</ref>; <ref loc="EPH 4:32">Efe 4:32</ref>. </char>
    </note> Okwerinda kw'omuntu kumuzibira kurahuka kugira ekiniga,</para>
  <para style="q1" vid="PRO 19:11">Kandi okwehuzya eki bamushobeize kumuhaisa ekitiinisa.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:14">Enf 16:14</ref>, <ref loc="PRO 16:15">15</ref>; <ref loc="PRO 20:2">20:2</ref>; <ref loc="PSA 113:3">Zab 113:3</ref>. </char>
    </note> Ekiniga ky'omugabe ni nk'okutsinda kw'entare,</para>
  <para style="q1" vid="PRO 19:12">Kwonka embabazi ze ziba nk'orume orutonzire aha bunyaatsi.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:21">Enf 17:21</ref>; <ref loc="PRO 27:15">27:15</ref>. </char>
    </note> Omwana ekifa-mutima n'akabi ahari ishe,</para>
  <para style="q1" vid="PRO 19:13">Kandi okutongana kw'omukazi ni nk'enjura erikuguma neetoonyerera.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:22">Enf 18:22</ref>; <ref loc="2CO 12:14">2 Kor 12:14</ref>. </char>
    </note> Eka n'eitungo, omuntu abiragwa abazaire be;</para>
  <para style="q1" vid="PRO 19:14">Kwonka omukazi orikwerinda amuheebwa MUKAMA.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:9-11">Enf 6:9-11</ref>; <ref loc="PRO 20:4">20:4</ref>, <ref loc="PRO 20:13">13</ref>. </char>
    </note> Okweganda kureeta okugwejegyera obutasisiimuka,</para>
  <para style="q1" vid="PRO 19:15">Kandi omweremwa aryaitwa enjara.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:13">Enf 13:13</ref>; <ref loc="LUK 10:28">Luk 10:28</ref>. </char>
    </note> Oyorobera ebiragiro, aba naarinda amagara ge;</para>
  <para style="q1" vid="PRO 19:16">Kwonka otarikweta ha mitwarize ye aryafa.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:14">Enf 12:14</ref>; <ref loc="PRO 28:27">28:27</ref>; <ref loc="DEU 15:7-11">Bir 15:7-11</ref>; <ref loc="LUK 6:38">Luk 6:38</ref>; <ref loc="2CO 9:5">2 Kor 9:5</ref>, <ref loc="2CO 9:8">8</ref>. </char>
    </note> Ogirira abooro embabazi, aba naaguza MUKAMA;</para>
  <para style="q1" vid="PRO 19:17">Aryamuzimuurira ebi yaakozire.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:24">Enf 13:24</ref>. </char>
    </note> Hana omwana waawe, okimwineho amatsiko;</para>
  <para style="q1" vid="PRO 19:18">Kwonka otamuteera ez'okumwita.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Ow'ekiniga kingi aryakizira,</para>
  <para style="q1" vid="PRO 19:19">Ahakuba n'obu waakumuramura, oryaguma okikora.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Guma ohurire enaama, oikirize okuhaburwa,</para>
  <para style="q1" vid="PRO 19:20">Obone kugira obwengye omu biro by'omumaisho.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:9">Enf 16:9</ref>; <ref loc="PSA 33:10">Zab 33:10</ref>, <ref loc="PSA 33:11">11</ref>; <ref loc="ISA 14:26">Isa 14:26</ref>, <ref loc="ISA 14:27">27</ref>. </char>
    </note> Omu mutima gw'omuntu habamu enaama nyingi,</para>
  <para style="q1" vid="PRO 19:21">Kwonka enaama ya Ruhanga niyo egumaho.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Embabazi z'omuntu nizo zimureetera kukundwa,</para>
  <para style="q1" vid="PRO 19:22">Kandi omworo naahita omunyabishuba.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:16">Enf 10:16</ref>; <ref loc="1TI 4:8">1 Tim 4:8</ref>. </char>
    </note> Okutiina MUKAMA kureeta amagara,</para>
  <para style="q1" vid="PRO 19:23">Kandi okwine aryaguma amazirwe;</para>
  <para style="q1" vid="PRO 19:23">Tarihikwaho kabi.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:15">Enf 26:15</ref>. </char>
    </note> Omweremwa ata engaro ze omu rwabya,</para>
  <para style="q1" vid="PRO 19:24">Abura ageetamika.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:8">Enf 9:8</ref>; <ref loc="PRO 21:11">21:11</ref>. </char>
    </note> Teera omugayi, abataine bugobya beegye okwerinda;</para>
  <para style="q1" vid="PRO 19:25">Hana orikwetegyereza, aryayeyongyera obwengye.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Oshiisha ebya ishe, akabinga nyina,</para>
  <para style="q1" vid="PRO 19:26">N'omwana orikuhemura, kandi areeta ekijumo.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:27: </char>
      <char style="xt" closed="false">
        <ref loc="2PE 2:21">2 Pet 2:21</ref>. </char>
    </note> Mwana wangye, reka kufa okuhurira ebi orikuhaburwa,</para>
  <para style="q1" vid="PRO 19:27">Haza okahaba, okareka ebigambo by'okumanya.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:28: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 15:16">Yob 15:16</ref>. </char>
    </note> Kareebi otaine mugasho ashekyerera emanja z'oburyo,</para>
  <para style="q1" vid="PRO 19:28">Kandi akanwa k'omubi kamirakwo okutahikiirira.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:29: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:3">Enf 26:3</ref>. </char>
    </note> Ebifubiro biteekateekyeirwe abateezi b'enaku,</para>
  <para style="q1" vid="PRO 19:29">Kandi enkoni zicumiirwe amabega g'abashema.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:29-32">Enf 23:29-32</ref>; <ref loc="GEN 9:21">Kut 9:21</ref>; <ref loc="ISA 28:7">Isa 28:7</ref>. </char>
    </note> Amaarwa n'omuteezi w'enaku, n'ekirikusinza kiyombesa,</para>
  <para style="q1" vid="PRO 20:1">Kandi ohabisibwa ebyo, tagira bwengye.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:36">Enf 8:36</ref>; <ref loc="PRO 19:12">19:12</ref>. </char>
    </note> Okutiinisa kw'omugabe ni nk'okutsinda kw'entare;</para>
  <para style="q1" vid="PRO 20:2">Owaamukwatsa ekiniga, aba ayekoreire kubi.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:14">Enf 17:14</ref>; <ref loc="GEN 13:7-9">Kut 13:7-9</ref>. </char>
    </note> Okwetantara entongane kihaisa omuntu ekitiinisa,</para>
  <para style="q1" vid="PRO 20:3">Kwonka omushema weena akunda okutongana.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:15">Enf 19:15</ref>, <ref loc="PRO 19:24">24</ref>. </char>
    </note> Omweremwa tayenda kuhinga mu ishekyera;</para>
  <para style="q1" vid="PRO 20:4">N'ahabw'ekyo aryashabiriza omu ishaaruura, kwonka taine ki ariheebwa.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:4">Enf 18:4</ref>. </char>
    </note> Enaama z'omu mutima gw'omuntu ni nk'amaizi maingi,</para>
  <para style="q1" vid="PRO 20:5">Kwonka orikwetegyereza aryazikyenga.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:14">Enf 25:14</ref>; <ref loc="JER 5:1">Yer 5:1</ref>; <ref loc="MAT 6:2">Mat 6:2</ref>; <ref loc="LUK 18:8">Luk 18:8</ref>. </char>
    </note> Baingi omu bantu bakunda kwegamba marungi;</para>
  <para style="q1" vid="PRO 20:6">Mbwenu omuntu orikwesigwa okaamuzoora hi?<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:7: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 15:4">1 Bag 15:4</ref>; <ref loc="PSA 112:2">Zab 112:2</ref>. </char>
    </note> Ohikiriire, kandi orikugyendera omu bwesigwa–</para>
  <para style="q1" vid="PRO 20:7">Abaana be abarimukurata bahiiriirwe!<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:10">Enf 16:10</ref>. </char>
    </note> Omugabe oshutama aha kitebe ky'eiramuriro,</para>
  <para style="q1" vid="PRO 20:8">Ebibi byona abibingisa amaisho ge, bitaataana.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 15:14">Yob 15:14</ref>; <ref loc="ECC 7:20">Mub 7:20</ref>. </char>
    </note> N'oha owaakubaasa kugira ati: Niinye nshemeize omutima gwangye;</para>
  <para style="q1" vid="PRO 20:9">Hati ekibi kyangye kindugireho?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:1">Enf 11:1</ref>. </char>
    </note> Eby'okupimisa n'eby'okurengyesa ebitahikire,</para>
  <para style="q1" vid="PRO 20:10">Byombi n'ekirikunugwa ahari MUKAMA.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:11: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:16">Mat 7:16</ref>. </char>
    </note> Omuntu n'obu yaakuba omwana amanyirwa aha bi arikukora,</para>
  <para style="q1" vid="PRO 20:11">Omurimo gwe gwaba gushemeire, kandi guhikire.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 4:11">Kur 4:11</ref>; <ref loc="PSA 94:9">Zab 94:9</ref>. </char>
    </note> Okutu okuhurira, n'eriisho erireeba,</para>
  <para style="q1" vid="PRO 20:12">Byombi bikahangwa MUKAMA.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:11">Enf 12:11</ref>; <ref loc="PRO 19:15">19:15</ref>; <ref loc="ROM 12:11">Rom 12:11</ref>. </char>
    </note> Otakunda okugwejegyera, nyentsya okaba omworo;</para>
  <para style="q1" vid="PRO 20:13">Imuka ogume nooreeba; oryagira eby'okurya, ohaagye.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Orikugura, acamura eki arikugura ati: Ni kibi! Ni kibi!</para>
  <para style="q1" vid="PRO 20:14">Kwonka ku agyenda, ayesiima ahabw'eki yaagura.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:15: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:18">Yob 28:18</ref>. </char>
    </note> Hariho ezaabu n'amabaare agarikutukurikana,</para>
  <para style="q1" vid="PRO 20:15">Kwonka eminwa y'obwengye n'enkwanzi z'obuguzi bwingi.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:13">Enf 27:13</ref>. </char>
    </note> Omuntu ku aryemerera ou atarikumanya, omwiheho ekijwaro kye;</para>
  <para style="q1" vid="PRO 20:16">Kandi ku aryemererera abanyamahanga, omugumye nk'omukwato.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:17">Enf 9:17</ref>. </char>
    </note> Eby'okurya ebirugire omu bugobya binurira omuntu;</para>
  <para style="q1" vid="PRO 20:17">Kwonka bwanyima bimubeera omusheenyi omu kanwa.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:14">Enf 11:14</ref>; <ref loc="PRO 24:6">24:6</ref>. </char>
    </note> Enaama zoona zihamibwa okuhanuura;</para>
  <para style="q1" vid="PRO 20:18">Kandi ku oriza kuhurura, ohurure oine enaama z'obwengye.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:13">Enf 11:13</ref>; <ref loc="PRO 13:3">13:3</ref>. </char>
    </note> Ogyendagyenda naagamba maingi, agamba emibonano;</para>
  <para style="q1" vid="PRO 20:19">N'ahabw'ekyo otarikwatanisa n'orikugambira eryo.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:20: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 21:17">Kur 21:17</ref>; <ref loc="2SA 21:17">2 Sam 21:17</ref>; <ref loc="JOB 18:5">Yob 18:5</ref>. </char>
    </note> Orikukyeena ishe nari nyina,</para>
  <para style="q1" vid="PRO 20:20">Etabaaza ye eryaraarizibwa omu mwirima ndindindi.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:11">Enf 13:11</ref>. </char>
    </note> Obuhunguzi obutungirwa ahonaaho omu kutandika,</para>
  <para style="q1" vid="PRO 20:21">Omuheru gwabwo tigurigira mugisha.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:29">Enf 24:29</ref>; <ref loc="PSA 27:14">Zab 27:14</ref>; <ref loc="ROM 12:17">Rom 12:17</ref>, <ref loc="ROM 12:19">19</ref>; <ref loc="1PE 3:9">1 Pet 3:9</ref>. </char>
    </note> Otarigira oti: Ndyayehoorera.</para>
  <para style="q1" vid="PRO 20:22">Tegyereza MUKAMA, nawe aryakuhwera.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:10">Enf 20:10</ref>. </char>
    </note> Amabaare ag'okupimisa agatahikire n'ekirikunugwa ahari MUKAMA,</para>
  <para style="q1" vid="PRO 20:23">Kandi eminzaani y'ebishuba teba nungi.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:9">Enf 16:9</ref>. </char>
    </note> Orugyendo rw'omuntu ruragiirwa MUKAMA.</para>
  <para style="q1" vid="PRO 20:24">Mbwenu omuntu naabaasa ata kumanya omuhanda gwe?<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:25: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 5:2">Mub 5:2</ref>, <ref loc="ECC 5:5">5</ref>. </char>
    </note> Omuntu okurahukwa aha rurimi, akarahira ati:</para>
  <para style="q1" vid="PRO 20:25">Ekintu eki n'ekirikwera! N'omutego;</para>
  <para style="q1" vid="PRO 20:25">Akiheza kurahira, akatsigara naayefuuza.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Omugabe w'obwengye ashungura ababi,</para>
  <para style="q1" vid="PRO 20:26">Kandi abaribatisa nyamuziga.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:27: </char>
      <char style="xt" closed="false">
        <ref loc="ZEP 1:12">Zef 1:12</ref>; <ref loc="1CO 2:11">1 Kor 2:11</ref>. </char>
    </note> Omwoyo gw'omuntu n'etabaaza ya MUKAMA,</para>
  <para style="q1" vid="PRO 20:27">Ecaaka ebisherekirwe omu mutima gwe.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:12">Enf 16:12</ref>. </char>
    </note> Embabazi n'amazima nibyo birinda omugabe,</para>
  <para style="q1" vid="PRO 20:28">Kandi ekitebe ky'obugabe bwe kihamibwa okuhikiirira.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:29: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:31">Enf 16:31</ref>. </char>
    </note> Ekitiinisa ky'abatsigazi n'amaani gaabo,</para>
  <para style="q1" vid="PRO 20:29">Kandi oburungi bw'abagurusi n'enju zaabo.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Okwasha omuntu na kibooko kumaraho ebibi,</para>
  <para style="q1" vid="PRO 20:30">Kandi enkoni zishemeza ebicweka by'omunda ebya hare.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:1: </char>
      <char style="xt" closed="false">
        <ref loc="EZR 6:22">Ezr 6:22</ref>. </char>
    </note> Omutima gw'omugabe guba omu mukono gwa MUKAMA,</para>
  <para style="q1" vid="PRO 21:1">Agutooza ahu arikwenda hoona, nk'orikuhabura amaizi omu mikura yaago.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:2">Enf 16:2</ref>; <ref loc="PRO 24:12">24:12</ref>; <ref loc="1SA 16:7">1 Sam 16:7</ref>; <ref loc="LUK 16:15">Luk 16:15</ref>. </char>
    </note> Omuhanda gw'omuntu gwona, omu kureeba kwe, guba ogushemeire;</para>
  <para style="q1" vid="PRO 21:2">Kwonka MUKAMA apima omutima.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:3: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 15:22">1 Sam 15:22</ref>; <ref loc="HOS 6:6">Hos 6:6</ref>. </char>
    </note> Okukora eby'okuhikiirira n'eby'oburyo;</para>
  <para style="q1" vid="PRO 21:3">Bisiimwa MUKAMA okukira ebitambo.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:17">Enf 6:17</ref>; <ref loc="PSA 101:5">Zab 101:5</ref>. </char>
    </note> Ekitsyori n'omutima gw'amaryo</para>
  <para style="q1" vid="PRO 21:4">Niyo tabaaza y'ababi; byombi n'ekibi.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:4">Enf 10:4</ref>; <ref loc="PRO 19:2">19:2</ref>. </char>
    </note> Ebi omweziriki ateekateeka kukora tibibura kureeta mweru;</para>
  <para style="q1" vid="PRO 21:5">Kwonka weena orahukiiriza, ayereetera obukyene.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Obutungi obu omuntu atunga ahabw'okubeiha, n'omuyaayuuko;</para>
  <para style="q1" vid="PRO 21:6">Ababusherura baba ni basherura rufu.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Eitima ry'ababi riryabamaraho,</para>
  <para style="q1" vid="PRO 21:7">Ahabw'okuba banga kukora ebihikire.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:15">Enf 2:15</ref>. </char>
    </note> Omuhanda gw'abaine orubanja gukiikami,</para>
  <para style="q1" vid="PRO 21:8">Kwonka emicwe y'oshemeire ehikire.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:24">Enf 25:24</ref>. </char>
    </note> Haakiri okutuura omu karugu k'aha mutwe gw'enju</para>
  <para style="q1" vid="PRO 21:9">Okukira okukwatana enju mpango n'omukazi entongani.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Omutima gw'omubi gwetenga ebibi;</para>
  <para style="q1" vid="PRO 21:10">Mutaahi we tamureebamu mbabazi.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:25">Enf 19:25</ref>. </char>
    </note> Omuteezi w'enaku ku afubirwa,</para>
  <para style="q1" vid="PRO 21:11">Abataine bwengye bahinduka ababwine.</para>
  <para style="q1" vid="PRO 21:11">Omunyabwengye ku ahaburwa, aihamu okumanya.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:35">Zab 37:35</ref>, <ref loc="PSA 37:36">36</ref>. </char>
    </note> Ohikiriire ayetegyereza enju y'omubi;</para>
  <para style="q1" vid="PRO 21:12">Amanya oku ababi banagwa ahansi, bakacwekyerera.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:13: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">Mat 7:2</ref>; <ref loc="MAT 18:30-34">18:30-34</ref>. </char>
    </note> Oyanga kuhurira okutaka kw'abooro,</para>
  <para style="q1" vid="PRO 21:13">Nawe aryataka, abure ow'okumuhurira.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Ekiconco ky'omu mubonano kiikaikanisa okuguubwa kubi,</para>
  <para style="q1" vid="PRO 21:14">Kandi empongano esherekirwe omu kwahwa eikaikanisa ekiniga kingi.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:29">Enf 10:29</ref>. </char>
    </note> Emanja ku zicuubwa omu buryo abahikiriire bakishemerererwa</para>
  <para style="q1" vid="PRO 21:15">Kwonka ababi bo bahahaaza omutima.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Omuntu orikuhaba, akaruga omu muhanda gw'okwetegyereza,</para>
  <para style="q1" vid="PRO 21:16">Aryahuumurira omu mutwe gw'abaafiire.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Orikukunda eby'okweshemeza aryaba omworo;</para>
  <para style="q1" vid="PRO 21:17">Orikukunda viinyo n'amajuta tariba mutungi.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:8">Enf 11:8</ref>. </char>
    </note> Omubi n'eky'okucungura ohikiriire,</para>
  <para style="q1" vid="PRO 21:18">Kandi endeebya n'eky'okucungura ow'omutima gugororokire.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Haakiri okutuura omu nsi etatuurwamu bantu</para>
  <para style="q1" vid="PRO 21:19">Okukira okutuura n'omukazi entongani kandi orikuguubwa kubi hakyehakye.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:20: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 20:15">Yob 20:15</ref>, <ref loc="JOB 20:18">18</ref>; <ref loc="PSA 112:3">Zab 112:3</ref>. </char>
    </note> Omu ka y'omunyabwengye harimu obutungi bw'obuguzi bwingi n'amajuta,</para>
  <para style="q1" vid="PRO 21:20">Kwonka omushema abimirakwo.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:9">Enf 15:9</ref>; <ref loc="MAT 5:6">Mat 5:6</ref>; <ref loc="MAT 6:33">6:33</ref>. </char>
    </note> Orikukuratira okuhikiirira n'embabazi,</para>
  <para style="q1" vid="PRO 21:21">Aryagira amagara n'ekitiinisa.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:22: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 5:6-9">2 Sam 5:6-9</ref>; <ref loc="ECC 7:19">Mub 7:19</ref>. </char>
    </note> Omunyabwengye atemba orugo rw'orurembo rw'emanzi,</para>
  <para style="q1" vid="PRO 21:22">Asheenya ekigo eki baabaire nibeesiga.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:3">Enf 13:3</ref>. </char>
    </note> Orinda akanwa ke n'orurimi rwe,</para>
  <para style="q1" vid="PRO 21:23">Ayerinda akabi.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Omunyamaryo kandi ow'ekiziizi ayetwa omugayi;</para>
  <para style="q1" vid="PRO 21:24">Akora n'amaryo n'emyekuniko.<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:4">Enf 13:4</ref>. </char>
    </note> Omweremwa aitwa okwetenga kwe,</para>
  <para style="q1" vid="PRO 21:25">Ahabw'okuba emikono ye eyanga kufa kubi.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:26">Zab 37:26</ref>. </char>
    </note> Eizooba ryona omubi ayetenga,</para>
  <para style="q1" vid="PRO 21:26">Kwonka ohikiriire we aha, kandi taima.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:8">Enf 15:8</ref>; <ref loc="ISA 66:3">Isa 66:3</ref>. </char>
    </note> Ekitambo ky'omubi n'ekirikunugwa;</para>
  <para style="q1" vid="PRO 21:27">Reero kaashwa okukitamba n'omutima mubi!<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:9">Enf 19:9</ref>. </char>
    </note> Kareebi w'ebishuba aryacwekyerera,</para>
  <para style="q1" vid="PRO 21:28">Kwonka omuntu orikuhurira aryagamba atarikuzibirwa.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Omubi ayoma ahamaisho,</para>
  <para style="q1" vid="PRO 21:29">Kwonka ow'omutima gugororokire atebeekanisa emihanda ye.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:30: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:21">Enf 19:21</ref>; <ref loc="ISA 8:10">Isa 8:10</ref>. </char>
    </note> Tihariho bwengye, nari okwetegyereza, n'obu yaakuba enaama</para>
  <para style="q1" vid="PRO 21:30">Ebirikubaasa kurwanisa MUKAMA.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 20:7">Zab 20:7</ref>; <ref loc="JER 3:23">Yer 3:23</ref>. </char>
    </note> Embaraasi eteekateekyerwa eizooba ry'orugamba,</para>
  <para style="q1" vid="PRO 21:31">Kwonka okusingura kuba okwa MUKAMA.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:1: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 7:1">Mub 7:1</ref>. </char>
    </note> Eiziina rirungi n'ery'okwetengwa okukira eitungo ringi;</para>
  <para style="q1" vid="PRO 22:1">N'okugira obushongore nikukira efeeza n'ezaabu.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:13">Enf 29:13</ref>; <ref loc="JOB 31:15">Yob 31:15</ref>. </char>
    </note> Abatungi n'abooro bateeranira hamwe;</para>
  <para style="q1" vid="PRO 22:2">Boona MUKAMA niwe yaabahangire.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:16">Enf 14:16</ref>; <ref loc="PRO 27:12">27:12</ref>. </char>
    </note> Omwerinzi ku areeba akabi kaija, ayeshereka;</para>
  <para style="q1" vid="PRO 22:3">Kwonka otaine bwengye akeegyema, kamwita.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:20">Enf 21:20</ref>, <ref loc="PRO 21:21">21</ref>. </char>
    </note> Ebihembo by'omucureezi kandi orikutiina MUKAMA</para>
  <para style="q1" vid="PRO 22:4">N'obutungi n'ekitiinisa n'amagara.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:23">Enf 21:23</ref>. </char>
    </note> Amahwa n'emitego biri omu muhanda gw'orikwehabagiza;</para>
  <para style="q1" vid="PRO 22:5">Orikwerinda aryabyetantara.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:6: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:4">Efe 6:4</ref>. </char>
    </note> Manyiiza omwana omuhanda ogu ashemereire kutoora;</para>
  <para style="q1" vid="PRO 22:6">Kandi n'obu arikura, tarigurugamu.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Omutungi ategyeka omworo,</para>
  <para style="q1" vid="PRO 22:7">Kandi oyegurize aba omuhuuku w'omugurize.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 4:8">Yob 4:8</ref>; <ref loc="HOS 10:13">Hos 10:13</ref>. </char>
    </note> Orikubiba okutahikiirira, aryagyesha akagwe;</para>
  <para style="q1" vid="PRO 22:8">N'enkoni y'ekiniga kye eryaremwa.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:17">Enf 19:17</ref>; <ref loc="LUK 14:13">Luk 14:13</ref>, <ref loc="LUK 14:14">14</ref>. </char>
    </note> Oine eriisho ry'obufura aryaheebwa omugisha,</para>
  <para style="q1" vid="PRO 22:9">Ahabw'okuba abooro abaha aha by'okurya bye.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:20">Enf 26:20</ref>. </char>
    </note> Binga omuteezi w'enaku; nibwo entongane ziraarugyeho,</para>
  <para style="q1" vid="PRO 22:10">Okutongana n'okujumiirana bikahwaho.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:13">Enf 16:13</ref>; <ref loc="ECC 10:12">Mub 10:12</ref>. </char>
    </note> Orikukunda omutima ogushemeire, kandi orikugamba eby'embabazi,</para>
  <para style="q1" vid="PRO 22:11">Omugabe aryaba munywani we.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Amaisho ga MUKAMA garinda oine okumanya,</para>
  <para style="q1" vid="PRO 22:12">Kwonka ebigambo by'endeebya abibuzabuza.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:13">Enf 26:13</ref>. </char>
    </note> Omweremwa ayekwatsakwatsa ati: Aheeru hariho entare.</para>
  <para style="q1" vid="PRO 22:13">Ku ndikushohora, neenyitira omu muhanda.<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:16">Enf 2:16</ref>; <ref loc="PRO 23:27">23:27</ref>; <ref loc="ECC 7:26">Mub 7:26</ref>. </char>
    </note> Akanwa k'omukazi enshambani n'ekiina kiraingwa;</para>
  <para style="q1" vid="PRO 22:14">Ou MUKAMA agwereirwe kubi aryakigwamu.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:24">Enf 13:24</ref>. </char>
    </note> Obushema bubohirwe omu mutima gw'omwana;</para>
  <para style="q1" vid="PRO 22:15">Kwonka enkoni y'okuhana eryabumwihamu, ebute hare.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:22">Enf 28:22</ref>; <ref loc="JOB 20:19-23">Yob 20:19-23</ref>; <ref loc="AMO 5:11">Amo 5:11</ref>. </char>
    </note> Orikuhata abooro ahabw'okwekanyisiza obutungi,</para>
  <para style="q1" vid="PRO 22:16">Nari orikuha abatungi, eki ariihamu n'okukyena.<verse eid="PRO 22:16" /></para>
  <para style="s1">Ebigambo by'abanyabwengye</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Tega okutu, ohurire ebigambo by'abanyabwengye,</para>
  <para style="q1" vid="PRO 22:17">Kandi ote omutima gwawe aha kumanya kwangye;<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Ahabw'okuba kiryaba kirungi, waabigumya omu mutima gwawe,</para>
  <para style="q1" vid="PRO 22:18">Kandi waabigumya aha minwa yaawe byona.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Nikyo naabikumanyisiza eri izooba, iwe wenka,</para>
  <para style="q1" vid="PRO 22:19">Ngu ogume nooyesiga MUKAMA.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Tinaakuhandiikira ebigambo ebirikukira oburungi,</para>
  <para style="q1" vid="PRO 22:20">Eby'okuhana n'eby'okumanya,<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:21: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:3">Luk 1:3</ref>, <ref loc="LUK 1:4">4</ref>. </char>
    </note> Okukworeka ebihikire n'eby'amazima,</para>
  <para style="q1" vid="PRO 22:21">Ngu obone kugarukamu abakutumire ebigambo by'amazima?<verse eid="PRO 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:22: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:4">Yob 5:4</ref>; <ref loc="JOB 31:21">31:21</ref>; <ref loc="ZEC 7:10">Zek 7:10</ref>. </char>
    </note> Otarinyaga omworo, ngu niho ari omworo,</para>
  <para style="q1" vid="PRO 22:22">Nari okwita kubi abarikusingisirizibwa aha marembo;<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:11">Enf 23:11</ref>; <ref loc="1SA 24:15">1 Sam 24:15</ref>; <ref loc="JER 50:34">Yer 50:34</ref>. </char>
    </note> Ahabw'okuba MUKAMA aryabatonganira,</para>
  <para style="q1" vid="PRO 22:23">Kandi abarikubanyaga, aryabaihaho amagara gaabo.<verse eid="PRO 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Otarinywana n'omuntu orikurahuka kuguubwa kubi,</para>
  <para style="q1" vid="PRO 22:24">N'obu kwakuba okugyenda n'omunyakiniga,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Nyentsya otakaayega emitwarize ye,</para>
  <para style="q1" vid="PRO 22:25">Okeenaga omu mutego.<verse eid="PRO 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:26, 27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:1">Enf 6:1</ref>, <ref loc="PRO 6:2">2</ref>; <ref loc="PRO 20:16">20:16</ref>. </char>
    </note> Otariba nk'abo abaha emikwato,</para>
  <para style="q1" vid="PRO 22:26">Abeemererera abaine amabanja.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Ku oraabe otaine ky'okumwihurira,</para>
  <para style="q1" vid="PRO 22:27">Nooyenda ku bakwiha aha kitanda kyawe, bakakitwara?<verse eid="PRO 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:10">Enf 23:10</ref>; <ref loc="DEU 19:14">Bir 19:14</ref>. </char>
    </note> Otarikuura ekiti ky'omwatano,</para>
  <para style="q1" vid="PRO 22:28">Ekyabyairwe baashwenkuru.<verse eid="PRO 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:29: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:21">1 Sam 16:21</ref>; <ref loc="1KI 11:28">1 Bag 11:28</ref>; <ref loc="1KI 12:6">12:6</ref>, <ref loc="1KI 12:8">8</ref>. </char>
    </note> Nooreeba omuntu orikwezirika omu murimo gwe?</para>
  <para style="q1" vid="PRO 22:29">Aryayemerera omu maisho g'abagabe naabaheereza;</para>
  <para style="q1" vid="PRO 22:29">Tariheereza bataine iziina.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Ku orishutama kurya n'omutegyeki,</para>
  <para style="q1" vid="PRO 23:1">Oteekateekye ahari ogwo muntu okuri omu maisho.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Ku oraabe noomanya ngu ori omunyamururu,</para>
  <para style="q1" vid="PRO 23:2">Oyegumye omusyo aha mumiro.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Otaryetenga eby'okurya bye ebinuzire,</para>
  <para style="q1" vid="PRO 23:3">Ahabw'okuba nibibihabeiha.<verse eid="PRO 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:5">Enf 3:5</ref>; <ref loc="PRO 28:20">28:20</ref>; <ref loc="1TI 6:9">1 Tim 6:9</ref>, <ref loc="1TI 6:10">10</ref>. </char>
    </note> Otarigwa ahaiguru noosherura eitungo;</para>
  <para style="q1" vid="PRO 23:4">Gira obwengye, okirekye.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:24">Enf 27:24</ref>. </char>
    </note> Ku origumyaho amaisho, ribura,</para>
  <para style="q1" vid="PRO 23:5">Ahabw'okuba ahonaaho rigira amapapa,</para>
  <para style="q1" vid="PRO 23:5">Riguruka nk'empungu erikuza ahaiguru.<verse eid="PRO 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:14">Enf 11:14</ref>; <ref loc="PRO 28:22">28:22</ref>; <ref loc="DEU 15:9">Bir 15:9</ref>; <ref loc="PSA 141:4">Zab 141:4</ref>. </char>
    </note> Otarirya eby'okurya by'efura-nkye;</para>
  <para style="q1" vid="PRO 23:6">Kandi otaryetenga eby'okurya bye ebinuzire.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:2">Zab 12:2</ref>. </char>
    </note> N'obu araabe naakugira ati: Ija orye, kandi onywe!</para>
  <para style="q1" vid="PRO 23:7">Kwonka omu mutima gwe, naaba atakwetsire.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Ekitongye eki oriba waamira, oryakitanaka,</para>
  <para style="q1" vid="PRO 23:8">N'ebigambo byawe birungi bife busha.<verse eid="PRO 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Otarigira eki waagamba, omushema akuhuriire;</para>
  <para style="q1" vid="PRO 23:9">Ahabw'okuba aryagira ngu ebigambo byawe tibirimu bwengye.<verse eid="PRO 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:28">Enf 22:28</ref>. </char>
    </note> Otarikuura ekiti ky'omwatano ogwa ira,</para>
  <para style="q1" vid="PRO 23:10">Nari okurenga, okaza omu kibanja ky'efuuzi;<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:23">Enf 22:23</ref>. </char>
    </note> Ahabw'okuba Omucunguzi waabo n'ow'amaani;</para>
  <para style="q1" vid="PRO 23:11">Aryakutonganisa, naabatonganira.<verse eid="PRO 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Omutima gwawe ogute aha kuhaburwa,</para>
  <para style="q1" vid="PRO 23:12">N'okutu kwawe aha bigambo by'okumanya.<verse eid="PRO 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:24">Enf 13:24</ref>; <ref loc="PRO 19:18">19:18</ref>. </char>
    </note> Otarireka kuhana omwana;</para>
  <para style="q1" vid="PRO 23:13">Ku orikumuteera omunyaafu, tarikufa.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Ku orimuteera omunyaafu,</para>
  <para style="q1" vid="PRO 23:14">Oryakiza amagara ge okuza Okuzimu.<verse eid="PRO 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:3">Enf 29:3</ref>. </char>
    </note> Mwana wangye, omutima gwawe ku guraabe gwine obwengye,</para>
  <para style="q1" vid="PRO 23:15">N'ogwangye nigwija kushemererwa.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Ku origuma noogamba ebihikire,</para>
  <para style="q1" vid="PRO 23:16">Amagara gangye garyashemererwa.<verse eid="PRO 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:14">Enf 28:14</ref>; <ref loc="PSA 37:1">Zab 37:1</ref>. </char>
    </note> Omutima gwawe gutarigirira abasiisi eihari,</para>
  <para style="q1" vid="PRO 23:17">Kureka gugume nigutiina MUKAMA okurenzya eizooba.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:14">Enf 24:14</ref>. </char>
    </note> Buzimazima haryabaho ebihembo;</para>
  <para style="q1" vid="PRO 23:18">Kandi amatsiko gaawe tigariihwaho.<verse eid="PRO 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:6">Enf 9:6</ref>. </char>
    </note> Mwana wangye, hurira, kandi ogire obwengye,</para>
  <para style="q1" vid="PRO 23:19">Oshoronzye omutima gwawe omu muhanda.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:7">Enf 28:7</ref>; <ref loc="ISA 5:11">Isa 5:11</ref>; <ref loc="LUK 21:34">Luk 21:34</ref>; <ref loc="EPH 5:18">Efe 5:18</ref>. </char>
    </note> Otariza omu mutwe gw'abanywi ba viinyo,</para>
  <para style="q1" vid="PRO 23:20">N'obu gwakuba ogw'abanyamairu;<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:10">Enf 6:10</ref>, <ref loc="PRO 6:11">11</ref>. </char>
    </note> Ahakuba omusinzi n'omunyanda baryaba abooro,</para>
  <para style="q1" vid="PRO 23:21">Kandi n'okuhungira kuryajweka omuntu obucancabari.<verse eid="PRO 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 23:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:8">Enf 1:8</ref>; <ref loc="PRO 30:17">30:17</ref>; <ref loc="EPH 6:1">Efe 6:1</ref>. </char>
    </note> Hurira sho owaakuzaire,</para>
  <para style="q1" vid="PRO 23:22">Kandi otarigaya nyoko yaakura.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 4:5">Enf 4:5</ref>, <ref loc="PRO 4:7">7</ref>. </char>
    </note> Gura amazima, kwonka otarigatunda;</para>
  <para style="q1" vid="PRO 23:23">Kandi ogure obwengye, okuhaburwa n'okwetegyereza.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Ishe w'ohikiriire aryashemererwa munonga;</para>
  <para style="q1" vid="PRO 23:24">Orikuzaara omwana w'obwengye aryayesiima ahabwe.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Ka sho na nyoko bashemererwe,</para>
  <para style="q1" vid="PRO 23:25">Kandi nyoko owaakuzaire ayesiime!<verse eid="PRO 23:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Mwana wangye, mpa omutima gwawe,</para>
  <para style="q1" vid="PRO 23:26">N'amaisho gaawe geetegyereze emitwarize yangye;<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:14">Enf 22:14</ref>. </char>
    </note> Ahakuba maraaya n'ekiina kiraingwa,</para>
  <para style="q1" vid="PRO 23:27">Kandi omukazi owaariire enshoni n'obusya bufunzire.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:12">Enf 7:12</ref>. </char>
    </note> Agwera nk'omwambuzi,</para>
  <para style="q1" vid="PRO 23:28">Kandi akanyisa endeebya omu bantu.<verse eid="PRO 23:28" /></para>
  <para style="s1">Ebibi ebiruga omu businzi</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:29: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:12">Kut 49:12</ref>. </char>
    </note> Enaku zigirwa oha? Obusaasi bugirwa oha?</para>
  <para style="q1" vid="PRO 23:29">Empaka zigirwa oha? Okwetomboita kugirwa oha?</para>
  <para style="q1" vid="PRO 23:29">Obuhuta bwa busha bugirwa oha? Okutukura amaisho kugirwa oha?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:30: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:2">Enf 9:2</ref>, <ref loc="PRO 9:5">5</ref>; <ref loc="ISA 5:11">Isa 5:11</ref>, <ref loc="ISA 5:22">22</ref>. </char>
    </note> Bigirwa abaraara enkyera,</para>
  <para style="q1" vid="PRO 23:30">Abaza kuvumba enturire.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Otareeba viinyo ngu niho erikutukura,</para>
  <para style="q1" vid="PRO 23:31">Yaaba neebirira omu kikopo,</para>
  <para style="q1" vid="PRO 23:31">Neesheneneka aha mumiro.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:32: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 20:16">Yob 20:16</ref>. </char>
    </note> Bwanyima eruma nk'enjoka,</para>
  <para style="q1" vid="PRO 23:32">Etema nk'empiri.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Amaisho gareeba ensi neegyenda,</para>
  <para style="q1" vid="PRO 23:33">Omutima gwawe gugamba ebitakwatiraine.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Oshusha nk'obyami ahagati y'enyanja,</para>
  <para style="q1" vid="PRO 23:34">Nari nk'obyami ahaiguru y'omurongooti gw'omu meeri;<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:35: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 56:12">Isa 56:12</ref>; <ref loc="2PE 2:22">2 Pet 2:22</ref>. </char>
    </note> Okagira oti: Banteire, kwonka tinsaasire!</para>
  <para style="q1" vid="PRO 23:35">Baanyasire, kwonka tiinyine ki mpuriire!</para>
  <para style="q1" vid="PRO 23:35">Nsisiimukye ryari, nkaza kuvumba agandi!<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s1">Ezindi nfumu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:1">Zab 37:1</ref>. </char>
    </note> Otarigirira abantu babi eihari,</para>
  <para style="q1" vid="PRO 24:1">N'obu kwakuba okwetenga kuguma nabo;<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:7">Zab 10:7</ref>. </char>
    </note> Ahabw'okuba emitima yaabo eteekateeka eby'okurwana,</para>
  <para style="q1" vid="PRO 24:2">N'eminwa yaabo egamba eby'eitima.<verse eid="PRO 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:1">Enf 14:1</ref>. </char>
    </note> Ahabw'obwengye enju eyombekwa,</para>
  <para style="q1" vid="PRO 24:3">N'ahabw'okwetegyereza ehamira kimwe.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:23">Enf 23:23</ref>. </char>
    </note> Ahabw'okumanya, ebishengye byayo</para>
  <para style="q1" vid="PRO 24:4">Biijura ebintu byona ebirikushemeza kandi eby'obuguzi bwingi.<verse eid="PRO 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:22">Enf 21:22</ref>. </char>
    </note> Omunyabwengye aba ow'amaani;</para>
  <para style="q1" vid="PRO 24:5">Eego, omuntu oine okumanya ayeyongyera amaani.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:18">Enf 20:18</ref>. </char>
    </note> Ahakuba oshemereire kuhurura, nooyebemberwa obwengye;</para>
  <para style="q1" vid="PRO 24:6">Kandi ahu abahi b'obwengye baingi bari, habaho obusinguzi.<verse eid="PRO 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Obwengye n'obw'ahaiguru, omushema tarikubaasa kubuhika;</para>
  <para style="q1" vid="PRO 24:7">Aha irembo, ahu abantu bateeraniire, tateerezaho.<verse eid="PRO 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Ogira enaama ez'okukora kubi,</para>
  <para style="q1" vid="PRO 24:8">Ayetwa omunyaitima.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:9: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:22">Byak 8:22</ref>; <ref loc="2CO 10:5">2 Kor 10:5</ref>. </char>
    </note> Enaama z'obushema n'ekibi,</para>
  <para style="q1" vid="PRO 24:9">Kandi omuteezi w'enaku n'ekirikunugwa omu bantu.<verse eid="PRO 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:10: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:3">Heb 12:3</ref>. </char>
    </note> Ku orikugwa enshazi aha izooba ry'okuhikiirirwa,</para>
  <para style="q1" vid="PRO 24:10">Biri amaani gaawe ni makye.<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 82:4">Zab 82:4</ref>. </char>
    </note> Juna abarikutwarwa kwitwa,</para>
  <para style="q1" vid="PRO 24:11">N'abarikutetema nibaza kwitwa, obazibire.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:2">Enf 16:2</ref>; <ref loc="JOB 34:11">Yob 34:11</ref>; <ref loc="ECC 5:8">Mub 5:8</ref>; <ref loc="JER 32:19">Yer 32:19</ref>. </char>
    </note> Ku oraagire oti: Ekyo titurakimanyire,</para>
  <para style="q1" vid="PRO 24:12">Torikumanya opima emitima ku arikukireeba?</para>
  <para style="q1" vid="PRO 24:12">Noogira ngu orinda amagara gaawe tarikukimanya,</para>
  <para style="q1" vid="PRO 24:12">Tarizimuurira omuntu weena ebishemereire ebi yaakozire?<verse eid="PRO 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:10">Zab 19:10</ref>; <ref loc="PSA 119:103">119:103</ref>. </char>
    </note> Mwana wangye, guma orye obwoki; ahabw'okuba ni burungi,</para>
  <para style="q1" vid="PRO 24:13">Orye n'omushongi, ogurikuruga omu ngabo zaabwo, nigukunurira.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:18">Enf 23:18</ref>. </char>
    </note> Omanye ngu n'obwengye nikwo buriba omu magara gaawe;</para>
  <para style="q1" vid="PRO 24:14">Ku oribubona, oryaba oboine ebihembo,</para>
  <para style="q1" vid="PRO 24:14">N'amatsiko gaawe tigariihwaho.<verse eid="PRO 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:9">Zab 10:9</ref>. </char>
    </note> Iwe muntu mubi 'we, otarigwera enju y'ohikiriire,</para>
  <para style="q1" vid="PRO 24:15">Kandi otarikora kubi eka ye;<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:32">Enf 14:32</ref>; <ref loc="PSA 37:24">Zab 37:24</ref>; <ref loc="JOB 5:19">Yob 5:19</ref>. </char>
    </note> Ahakuba ohikiriire agwa emirundi mushanju naimuka,</para>
  <para style="q1" vid="PRO 24:16">Kwonka ababi bagwisibwa ebihikiirizi.<verse eid="PRO 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:5">Enf 17:5</ref>. </char>
    </note> Otarishemerererwa okugwa kw'omuzigu waawe,</para>
  <para style="q1" vid="PRO 24:17">Kandi omutima gwawe gutaryesiima yaateera entsibo,<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />MUKAMA atakaakireeba, kikamusaasa,</para>
  <para style="q1" vid="PRO 24:18">Akamwihaho ekiniga kye.<verse eid="PRO 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:1">Zab 37:1</ref>; <ref loc="JER 12:1">Yer 12:1</ref>. </char>
    </note> Otaryemereza omutima ahabw'enkozi z'ebibi,</para>
  <para style="q1" vid="PRO 24:19">N'obu kwakuba okugirira ababi eihari;<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:9">Enf 13:9</ref>; <ref loc="JOB 18:5">Yob 18:5</ref>. </char>
    </note> Ahabw'okuba omubi tarigira bihembo,</para>
  <para style="q1" vid="PRO 24:20">Kureka etabaaza ye eryaraazibwa.<verse eid="PRO 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:21: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 2:17">1 Pet 2:17</ref>. </char>
    </note> Mwana wangye, tiina MUKAMA n'omugabe,</para>
  <para style="q1" vid="PRO 24:21">Kandi bombi otagira ou waagomera;<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Ahabw'okuba akabi nikaija kubarugaho kitaraariire.</para>
  <para style="q1" vid="PRO 24:22">Kandi n'oha orikumanya okucwekyereza okuribarugaho bombi?<verse eid="PRO 24:22" /></para>
  <para style="s1">Ebindi bigambo by'abanyabwengye</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:5">Enf 18:5</ref>; <ref loc="2CH 19:7">2 Bus 19:7</ref>. </char>
    </note> Ebi nabyo n'ebigambo by'abanyabwengye.</para>
  <para style="q1" vid="PRO 24:23">Ni kibi okugwera orubaju omu kucwa emanja.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:15">Enf 17:15</ref>. </char>
    </note> Orikugira omubi ati: Ori mwere!</para>
  <para style="q1" vid="PRO 24:24">Aryakyeenwa abantu, amahanga gamutamwe;<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Kwonka abarikuhana omubi baryashemererwa,</para>
  <para style="q1" vid="PRO 24:25">Kandi omugisha murungi guryabahikaho.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Ogarukamu ebihikire, aba anywegyeire eminwa.<verse eid="PRO 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Banza otebeekanise ebi orikwija kukora aheeru,</para>
  <para style="q1" vid="PRO 24:27">Oteekateekye ekintu kyona eki orikwenda omu ishwa;</para>
  <para style="q1" vid="PRO 24:27">Bwanyima obone kwombeka enju yaawe.<verse eid="PRO 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:18">Enf 25:18</ref>. </char>
    </note> Otarishinja mutaahi waawe noomutura busha,</para>
  <para style="q1" vid="PRO 24:28">Kandi otarigobya n'eminwa yaawe.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:29: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:22">Enf 20:22</ref>. </char>
    </note> Otarigira oti: Ndyamugira nk'oku yanginzire,</para>
  <para style="q1" vid="PRO 24:29">Ndyamuhoora ahabw'eki yaakozire.<verse eid="PRO 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Nkaraba aha musiri gw'omweremwa,</para>
  <para style="q1" vid="PRO 24:30">N'aha musiri gw'emizaabibu gw'omuntu otaine bwengye;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:31: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:5">Isa 5:5</ref>. </char>
    </note> Naashanga gwona gumezire amahwa,</para>
  <para style="q1" vid="PRO 24:31">Gushwekirwe ebicuragyenyi,</para>
  <para style="q1" vid="PRO 24:31">Kandi orugo rwagwo rw'amabaare rusheenyukire.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Ku naabireebire, naabiteekateekaho munonga,</para>
  <para style="q1" vid="PRO 24:32">Naabyetegyereza, naihamu okushoborokyerwa.<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:33, 34: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:10">Enf 6:10</ref>, <ref loc="PRO 6:11">11</ref>. </char>
    </note> Noogira oti: Reka ngwejegyereho kakye, mpungireho kaingana busha;</para>
  <para style="q1" vid="PRO 24:33">Nangwa mpinyeho nti omukono, mpuumureho!<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Obwo, obworo buryakwizira nk'omunyagi,</para>
  <para style="q1" vid="PRO 24:34">N'obukyene bukuhikyeho nk'omuntu ohagatiire eby'okurwanisa.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Ezindi nfumu</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:1">Enf 1:1</ref>. </char>
    </note> Ezi nazo n'enfumu za Sulemaani, ezi abashaija ba Hezekia omugabe wa Yuda baahandukurwire.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 29:29">Bir 29:29</ref>; <ref loc="ROM 11:33">Rom 11:33</ref>. </char>
    </note> Ebi Ruhanga asherekire nibyo bimuhaisa ekitiinisa,</para>
  <para style="q1" vid="PRO 25:2">Kwonka ekihaisa abagabe ekitiinisa n'okucondooza ebintu.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Nk'oku eiguru riri ahaiguru munonga, kandi nk'oku ensi ehikire hare okuzimu,</para>
  <para style="q1" vid="PRO 25:3">N'emitima y'abagabe nikwo etarikwetegyerezibwa.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:4: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 3:2">Mal 3:2</ref>, <ref loc="MAL 3:3">3</ref>. </char>
    </note> Iha enkamba aha feeza,</para>
  <para style="q1" vid="PRO 25:4">Haza omuheesi abone kutunga eky'okuheeshamu ekintu.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:12">Enf 16:12</ref>. </char>
    </note> Iha ababi omu maisho g'omugabe,</para>
  <para style="q1" vid="PRO 25:5">Ekitebe ky'obugabe bwe kibone kuhamibwa okuhikiirira.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:6, 7: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:8-11">Luk 14:8-11</ref>. </char>
    </note> Otaryekuza omu maisho g'omugabe,</para>
  <para style="q1" vid="PRO 25:6">Kandi otaryemerera omu mwanya gw'abakuru;<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Ahakuba ekirungi n'okwetwa ngu, Garuka aha!</para>
  <para style="q1" vid="PRO 25:7">Okukira okugarurwa enyima omu maisho g'omugabe naakureeba.<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:25">Mat 5:25</ref>; <ref loc="LUK 12:58">Luk 12:58</ref>. </char>
    </note> Otarirahuka kutabaariza mutaahi waawe,</para>
  <para style="q1" vid="PRO 25:8">Nyentsya akikusinga okaitwa enshoni,</para>
  <para style="q1" vid="PRO 25:8">Okabura oku waagira;<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:9: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:15">Mat 18:15</ref>. </char>
    </note> Kureka gamba nawe, mubyemarire mwenka,</para>
  <para style="q1" vid="PRO 25:9">Orekye kubibuzya,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Owaakihurira akakugaya,</para>
  <para style="q1" vid="PRO 25:10">Ekihemu kikakugumaho.<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:23">Enf 15:23</ref>. </char>
    </note> Ekigambo kihikire, ekigambirwe omu bunaku bwakyo,</para>
  <para style="q1" vid="PRO 25:11">Ni nk'amapeera g'ezaabu agari omu kiibo ky'efeeza.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:31">Enf 15:31</ref>. </char>
    </note> Nk'empeta y'ezaabu ey'omu matu, nari nk'enkwanzi z'ezaabu eshemeziibwe,</para>
  <para style="q1" vid="PRO 25:12">N'omuhani ow'obwengye nikwo aba atyo ahari ogwo omutegire okutu.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:17">Enf 13:17</ref>. </char>
    </note> Nk'embeho y'ebirika oku eba omu ishaaruura,</para>
  <para style="q1" vid="PRO 25:13">Nikwo n'entumwa etaangirira eba aha bagitumire,</para>
  <para style="q1" vid="PRO 25:13">ahabw'okuba eruhuura emitima y'abakama baayo.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:6">Enf 20:6</ref>; <ref loc="JUD 1:12">Yud 12</ref>. </char>
    </note> Nk'oku enjura erimu omuyaga ehiika, ekabura,</para>
  <para style="q1" vid="PRO 25:14">Nikwo n'omuntu aba oyehimbisiza aha kiconco eki atarikwija kuha.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:14">Enf 16:14</ref>; <ref loc="ECC 10:4">Mub 10:4</ref>. </char>
    </note> Okugumisiriza kwikirizisa omutegyeki,</para>
  <para style="q1" vid="PRO 25:15">N'orurimi rworobi rwata eigufa.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Ku oraabe waagwire aha bwoki, oryeho oburikukuhaazya,</para>
  <para style="q1" vid="PRO 25:16">Otakaarengyesereza, okabutanaka.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Orekye kwitsa omwa mutaahi waawe akaribatiiriro,</para>
  <para style="q1" vid="PRO 25:17">Atakaakuhararuka, akakwanga.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:28">Enf 24:28</ref>. </char>
    </note> Mushinja orikushinja mutaahi we ebishuba,</para>
  <para style="q1" vid="PRO 25:18">Ni nk'akateererezo nari rurara, nari omwambi gw'omunwa.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Okwesiga otarikwesigwa omu bunaku bw'akabi</para>
  <para style="q1" vid="PRO 25:19">Ni nk'eriino rijunzire, nari ekigyere ekikonyokire.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Orikweshongorera ow'omutima ogweshobeire</para>
  <para style="q1" vid="PRO 25:20">Ni nk'orikujuura ekijwaro omu mbeho,</para>
  <para style="q1" vid="PRO 25:20">Kandi nka viinyo erikushaarira omu buhuta.<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:21, 22: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 6:22">2 Bag 6:22</ref>; <ref loc="MAT 5:44">Mat 5:44</ref>; <ref loc="ROM 12:20">Rom 12:20</ref>. </char>
    </note> Omuzigu waawe, ku arigira enjara, omugaburire;</para>
  <para style="q1" vid="PRO 25:21">Ku arikwatwa eiriho, omuhe eky'okunywa;<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Ahabw'okuba oryaba omurunzire amakara g'omuriro aha mutwe,</para>
  <para style="q1" vid="PRO 25:22">Kandi MUKAMA aryakuzimuurira.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Omuyaga gw'obukiizi-bwa-bumosho gureeta enjura,</para>
  <para style="q1" vid="PRO 25:23">Kandi orurimi orurikugambuura rureeta okuhinduriza ahamaisho.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:9">Enf 21:9</ref>. </char>
    </note> Haakiri okutuura omu keehogo k'aha mutwe gw'enju,</para>
  <para style="q1" vid="PRO 25:24">Okukira okukwatana enju n'omukazi entongani.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Nk'amaizi agarikufuka oku gaba aha muntu oine ekyaka,</para>
  <para style="q1" vid="PRO 25:25">Nikwo n'amakuru marungi gaba agarikuruga omu nsi ya hare.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Ohikiriire orikuhigiza omubi</para>
  <para style="q1" vid="PRO 25:26">Ni nk'eiziba ry'amaizi gatabangukire, nari enshuro esiisikaire.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:2">Enf 27:2</ref>. </char>
    </note> Ti kirungi kurya obwoki bwingi,</para>
  <para style="q1" vid="PRO 25:27">Kandi n'ebigambo by'okumamarika toshemereire kubirengyesereza.<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Omuntu otarikubaasa kwezibira,</para>
  <para style="q1" vid="PRO 25:28">Ni nk'orurembo orusheenyirwe, rukagumira aho, rutaine rugo.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="s1">Eby'abashema</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:1: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 12:17">1 Sam 12:17</ref>. </char>
    </note> Nk'oku orubaare rutashemereire kubaho mu kyanda, n'enjura omu igyesha,</para>
  <para style="q1" vid="PRO 26:1">Nikwo n'omushema atashemereire kitiinisa.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:2: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 23:8">Kub 23:8</ref>; <ref loc="2SA 16:12">2 Sam 16:12</ref>. </char>
    </note> Nk'oku ekiteera-nkumba kizengyerera, kandi nk'oku entaratambi eguruka,</para>
  <para style="q1" vid="PRO 26:2">Nikwo n'omukyeeno gwa busha gutagira u gwita.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:29">Enf 19:29</ref>; <ref loc="PSA 32:9">Zab 32:9</ref>. </char>
    </note> Kibooko eshemerera embaraasi, n'enkoba z'omu kanwa zishemerera endogoya,</para>
  <para style="q1" vid="PRO 26:3">Kandi n'enkoni zishemerera amabega g'abashema.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:4: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 16:11">2 Sam 16:11</ref>. </char>
    </note> Otarigarukamu omushema nk'oku obushema bwe buri,</para>
  <para style="q1" vid="PRO 26:4">Haza naiwe okaba nkawe.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:5: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1-4">Mat 16:1-4</ref>; <ref loc="MAT 21:24-27">21:24-27</ref>; <ref loc="ROM 12:16">Rom 12:16</ref>. </char>
    </note> Garukamu omushema nk'oku obushema bwe buri,</para>
  <para style="q1" vid="PRO 26:5">Atakaayemanya ku aine obwengye.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Otuma omushema aba naayehenda amaguru,</para>
  <para style="q1" vid="PRO 26:6">Kandi ayereetera okufeerwa.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Nk'oku amaguru g'ebirema gatuura nigaregyeijana,</para>
  <para style="q1" vid="PRO 26:7">Nikwo n'enfumu eba etyo omu kanwa k'abashema.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Okuha omushema ekitiinisa</para>
  <para style="q1" vid="PRO 26:8">Ni nk'okukomera eibaare omu kenda k'enjungu.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Nk'oku eihwa ricumita engaro y'omusinzi, rikagihweramu,</para>
  <para style="q1" vid="PRO 26:9">Nikwo n'enfumu eba omu kanwa k'abashema.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Nk'oku omurasi arasha weena ou yaabanda,</para>
  <para style="q1" vid="PRO 26:10">N'orikukoresa omushema nari omuhinguzi nikwo ari.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:11: </char>
      <char style="xt" closed="false">
        <ref loc="2PE 2:22">2 Pet 2:22</ref>. </char>
    </note> Nk'oku embwa egarukira ebitanaki byayo,</para>
  <para style="q1" vid="PRO 26:11">Nikwo n'omushema ari orikugarukira obushema bwe.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:20">Enf 29:20</ref>. </char>
    </note> Nooreeba omuntu orikwemanya obwengye?</para>
  <para style="q1" vid="PRO 26:12">Okaagira amatsiko aha mushema okukira ahari ogwo muntu.<verse eid="PRO 26:12" /></para>
  <para style="s1">Eby'abeeremwa</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:13">Enf 22:13</ref>. </char>
    </note> Omweremwa agira ati: Omu nguuto harimu ntare;</para>
  <para style="q1" vid="PRO 26:13">N'omu mihanda harimu entare.<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Nk'oku orwigi rwecundira aha pata zaarwo,</para>
  <para style="q1" vid="PRO 26:14">Nikwo n'omweremwa ayehindahindurira aha kitanda kye.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:24">Enf 19:24</ref>. </char>
    </note> Omweremwa atibika engaro ze omu rwabya,</para>
  <para style="q1" vid="PRO 26:15">Abura agaazigarura omu kanwa.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:5">Enf 26:5</ref>. </char>
    </note> Omweremwa, omu kureeba kwe, aba ow'obwengye</para>
  <para style="q1" vid="PRO 26:16">Okukira abashaija mushanju abarikubaasa kugarukamu nibeerinda.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Orikwetaasya omu ntongane zitari ze,</para>
  <para style="q1" vid="PRO 26:17">Ni nk'orikukwata amatu g'embwa erikuhingura.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Omuntu ogobeza mutaahi we, akagira ati: Naaba ninteera obuyaga!<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />Ni nk'omugwa-iraro orikurekyera ebikongyezo n'emyambi na rufu.<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Ahu enku zibura, omuriro guraara;</para>
  <para style="q1" vid="PRO 26:20">N'ahu omuhwihwitsi atari, entongane zihwaho.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:18">Enf 15:18</ref>; <ref loc="2SA 20:1">2 Sam 20:1</ref>. </char>
    </note> Nk'oku bongyera amakara aha makara gaacwetsya, nari enku aha muriro,</para>
  <para style="q1" vid="PRO 26:21">Nikwo omuntu entongani akanyisa entongane.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:8">Enf 18:8</ref>. </char>
    </note> Ebigambo by'omuhwihwitsi n'otw'okurya tunuzire,</para>
  <para style="q1" vid="PRO 26:22">Bimirwa, bihika omunda omu kishansha.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Omuntu orikugamba eby'okukunda, haza aine omutima mubi,</para>
  <para style="q1" vid="PRO 26:23">Ni nk'enyungu eshwekirwe ebirikwengyengyeta by'efeeza.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Omwangani aryarya n'eminwa ye,</para>
  <para style="q1" vid="PRO 26:24">Kwonka omu mutima gwe aba asherekiremu eitima.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:3">Zab 28:3</ref>. </char>
    </note> N'obu arigamba gye, otarimwesiga;</para>
  <para style="q1" vid="PRO 26:25">ahabw'okuba omu mutima gwe harimu ebirikunugwa mushanju.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />N'obu yaakushweka rwango ye n'oburyarya,</para>
  <para style="q1" vid="PRO 26:26">Obubi bwe buryareebeka butunu, ahu abantu bateeraniire.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:10">Enf 28:10</ref>; <ref loc="PSA 7:15">Zab 7:15</ref>. </char>
    </note> Orikutimba ekiina aryakigwamu,</para>
  <para style="q1" vid="PRO 26:27">Kandi orikukumbagaza eibaare, riryamugarukira.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Orurimi rurikubeiha rwanga abu rwahutaize,</para>
  <para style="q1" vid="PRO 26:28">Kandi akanwa akarikumamarika kareeta okucwekyerera.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:1: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:19">Luk 12:19</ref>, <ref loc="LUK 12:20">20</ref>; <ref loc="JAS 4:13">Yak 4:13</ref>, <ref loc="JAS 4:14">14</ref>. </char>
    </note> Otaryehimbisa ahabw'ebya nyencakare,</para>
  <para style="q1" vid="PRO 27:1">Ahabw'okuba torikumanya ebi eryo izooba riraareete.<verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:27">Enf 25:27</ref>; <ref loc="2CO 10:18">2 Kor 10:18</ref>. </char>
    </note> Reka ondiijo akusiime okukira iwe okwesiima;</para>
  <para style="q1" vid="PRO 27:2">Haakiri osiimwe omugyenyi, kunu ti minwa yaawe.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:12">Enf 17:12</ref>. </char>
    </note> Eibaare riremeera, n'omusheenyi gugira oburemeezi;</para>
  <para style="q1" vid="PRO 27:3">Kwonka ekiniga ky'omushema nikibikira byombi.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:34">Enf 6:34</ref>. </char>
    </note> Ekiniga tikisaasira, n'okuguubwa kubi ni nk'omutunga ogutwara ebintu;</para>
  <para style="q1" vid="PRO 27:4">Kwonka n'oha owaakubaasa kugumisiririza eihari?<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:23">Enf 28:23</ref>; <ref loc="GAL 2:14">Gal 2:14</ref>. </char>
    </note> Okuhana butunu nikukira okukunda kusherekirwe.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 141:5">Zab 141:5</ref>. </char>
    </note> Obuhuta obu ohutaazibwa omunyamukago n'obuhikire;</para>
  <para style="q1" vid="PRO 27:6">Kwonka okunywegyera kw'omuzigu kuba okurengyesereza.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:16">Enf 25:16</ref>. </char>
    </note> Ohaagire atamwa obwoki,</para>
  <para style="q1" vid="PRO 27:7">Kwonka aha mujara ekirikushaarira kyona kinuriirira.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:2">Enf 26:2</ref>. </char>
    </note> Nk'oku enyonyi egyenda ekatsigaho ekyashuri kyayo,</para>
  <para style="q1" vid="PRO 27:8">Nikwo n'omuntu, orara, akatsigaho eka ye, aba.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Nk'oku amajuta g'omugaju gashemeza omutima,</para>
  <para style="q1" vid="PRO 27:9">Nikwo n'omuntu ananurwa enaama za mugyenzi we ez'aha mutima.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:17">Enf 17:17</ref>; <ref loc="1KI 12:6">1 Bag 12:6</ref>. </char>
    </note> Otaritsigaho munywani waawe na munywani wa sho,</para>
  <para style="q1" vid="PRO 27:10">Kandi aha izooba eri origiriraho ebihikiirizi,</para>
  <para style="q1" vid="PRO 27:10">Otaryerusya kuza kweta mwene sho.</para>
  <para style="q1" vid="PRO 27:10">Mutaahi waawe okuri haihi naakira ou ozairwe nawe okuri hare.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:1">Enf 10:1</ref>; <ref loc="PSA 119:42">Zab 119:42</ref>. </char>
    </note> Mwana wangye, gira obwengye, oshemeze omutima gwangye,</para>
  <para style="q1" vid="PRO 27:11">Mbone kugarukamu ogwo otuura nanjuma.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:3">Enf 22:3</ref>. </char>
    </note> Omwerinzi ku areeba akabi kaija, ayeshereka;</para>
  <para style="q1" vid="PRO 27:12">Kwonka otaine bwengye akeegyema, kamwita.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:16">Enf 20:16</ref>. </char>
    </note> Omuntu ku araayemererere ou atarikumanya, omwiheho ekijwaro kye,</para>
  <para style="q1" vid="PRO 27:13">Kandi ku araayemererere abanyamahanga, omugumye nk'omukwato.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Oimuka kare akaza kwendeza mutaahi we omugisha naayomba,</para>
  <para style="q1" vid="PRO 27:14">Aryabarwa nk'orikumukyeena.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:13">Enf 19:13</ref>. </char>
    </note> Amaizi agarikuguma nigatoonya aha izooba ry'enjura,</para>
  <para style="q1" vid="PRO 27:15">N'omukazi entongani nibishushana.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Orikwenda kumuzibira ni nk'owaakwenda kuzibira omuyaga,</para>
  <para style="q1" vid="PRO 27:16">Nari okukwata amajuta omu mukono gwe gwa buryo.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Nk'oku ekyoma kityaza ekindi,</para>
  <para style="q1" vid="PRO 27:17">Nikwo n'omuntu atyaza mugyenzi we.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:18: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 20:6">Bir 20:6</ref>; <ref loc="MAT 25:21">Mat 25:21</ref>; <ref loc="1CO 3:8">1 Kor 3:8</ref>; <ref loc="1CO 9:7">9:7</ref>. </char>
    </note> Orikuhingirira omutiini niwe arirya ebijuma byagwo;</para>
  <para style="q1" vid="PRO 27:18">N'orikurinda mukama we aryaheebwa ekitiinisa.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Nk'oku amaisho g'omuntu geereebera omu maizi,</para>
  <para style="q1" vid="PRO 27:19">Nikwo n'omutima gw'omuntu gureebana n'ogundi.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:15">Enf 30:15</ref>, <ref loc="PRO 30:16">16</ref>; <ref loc="ECC 1:8">Mub 1:8</ref>; <ref loc="ECC 4:8">4:8</ref>. </char>
    </note> Nk'oku Okuzimu owa Nyamuteza etahaaga,</para>
  <para style="q1" vid="PRO 27:20">Nikwo n'amaisho g'omuntu gatahaaga kureeba.<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:3">Enf 17:3</ref>. </char>
    </note> Eiziiko riba ery'okushemerezamu efeeza,</para>
  <para style="q1" vid="PRO 27:21">N'omuriro guba ogw'okushemerezamu ezaabu,</para>
  <para style="q1" vid="PRO 27:21">Kandi n'omuntu amanyirwa aha bi barikumusiima.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:22: </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:3">Yer 5:3</ref>. </char>
    </note> N'obu waakushekura omushema n'omuhini hamwe n'ekihere ky'engano,</para>
  <para style="q1" vid="PRO 27:22">Obushema bwe tibukaamurugamu.<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Yezirikye kumanya amatungo gaawe oku gari,</para>
  <para style="q1" vid="PRO 27:23">Kandi oteho omutima kureeberera ente zaawe;<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:5">Enf 23:5</ref>. </char>
    </note> Ahabw'okuba eitungo tirigumaho ebiro byona.</para>
  <para style="q1" vid="PRO 27:24">Noogira ngu ekirunga kigumaho obusingye bwona?<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:5">Zab 90:5</ref>, <ref loc="PSA 90:6">6</ref>. </char>
    </note> Obunyaatsi obukuru ku buhwaho, haamera obuto,</para>
  <para style="q1" vid="PRO 27:25">N'obw'omu bibungo bwateeranirwa omuka,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:26, 27: </char>
      <char style="xt" closed="false">
        <ref loc="1TI 6:8">1 Tim 6:8</ref>. </char>
    </note> Nibwo abaana b'entaama bakuha eby'okujwara,</para>
  <para style="q1" vid="PRO 27:26">N'embuzi zikarugwamu empiiha z'okugura emisiri.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Amahenehene garyaba eky'okurya kyawe,</para>
  <para style="q1" vid="PRO 27:27">Gakuhaazye n'ab'omu ka yaawe,</para>
  <para style="q1" vid="PRO 27:27">Kandi gatungye n'abazaana baawe.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="s1">Okugyeragyeranisa abarungi n'ababi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:1: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:17">Lev 26:17</ref>; <ref loc="1SA 17:37">1 Sam 17:37</ref>. </char>
    </note> Omubi ahunga, hataine omubingire;</para>
  <para style="q1" vid="PRO 28:1">Kwonka abahikiriire baba emanzi nk'entare.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:2: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 16:8-23">1 Bag 16:8-23</ref>. </char>
    </note> Ensi ku eshobya, egira abategyeki baingi;</para>
  <para style="q1" vid="PRO 28:2">Kwonka ku egira abanyabwengye abaine okumanya,</para>
  <para style="q1" vid="PRO 28:2">Bagireetera okuguma ehamire<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:3: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:28">Mat 18:28</ref>. </char>
    </note> Omworo orikuhata abandi booro,</para>
  <para style="q1" vid="PRO 28:3">Ni nk'enjura etatsiga myaka.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:4: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 18:18">1 Bag 18:18</ref>, <ref loc="1KI 18:21">21</ref>; <ref loc="NEH 13:11">Neh 13:11</ref>, <ref loc="NEH 13:15">15</ref>; <ref loc="MAT 3:7">Mat 3:7</ref>; <ref loc="ROM 1:32">Rom 1:32</ref>. </char>
    </note> Abareka ebiragiro basiima ababi,</para>
  <para style="q1" vid="PRO 28:4">Kwonka ababyorobera babarwanisa.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:6">Zab 92:6</ref>; <ref loc="PSA 119:100">119:100</ref>; <ref loc="JHN 7:17">Yoh 7:17</ref>; <ref loc="1CO 2:15">1 Kor 2:15</ref>. </char>
    </note> Enkozi z'ebibi tizimanya by'oburyo,</para>
  <para style="q1" vid="PRO 28:5">Kwonka abasherura MUKAMA bamanya byona.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:6: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:1">Enf 19:1</ref>. </char>
    </note> Omworo ogyendera omu bwesigwa</para>
  <para style="q1" vid="PRO 28:6">Akira omutungi oyehabagiriza omu mihanda ye.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:20">Enf 23:20</ref>. </char>
    </note> Omwana oyorobera ebiragiro aba ow'obwengye,</para>
  <para style="q1" vid="PRO 28:7">Kwonka onywana n'abanyamururu ahemura ishe.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:31">Enf 14:31</ref>; <ref loc="LEV 25:36">Lev 25:36</ref>. </char>
    </note> Okanyisa eitungo rye ahabw'ebiteebwamu n'amagoba ebirengyesereize,</para>
  <para style="q1" vid="PRO 28:8">Aba ahendekyeire orikusaasira abooro.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:8">Enf 15:8</ref>; <ref loc="PSA 109:7">Zab 109:7</ref>. </char>
    </note> Oyeita amatu ngu atahurira ebiragiro,</para>
  <para style="q1" vid="PRO 28:9">Okushaba kwe kuba ekirikunugwa.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>. </char>
    </note> Orikuhabisa ow'omutima gugororokire, akamutooza omuhanda mubi,</para>
  <para style="q1" vid="PRO 28:10">Aryagwa omu kiina eki atimbire;</para>
  <para style="q1" vid="PRO 28:10">Kwonka otaine kamogo aryahungura ebirungi.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Omutungi ayeyeta omunyabwengye,</para>
  <para style="q1" vid="PRO 28:11">Kwonka omworo orikwetegyereza amumanyira kimwe.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:10">Enf 11:10</ref>; <ref loc="PRO 28:28">28:28</ref>. </char>
    </note> Abahikiriire ku basingura, habaho ekitiinisa kingi;</para>
  <para style="q1" vid="PRO 28:12">Kwonka ababi ku batunguuka, abantu beeshereka.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:13: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 31:33">Yob 31:33</ref>; <ref loc="PSA 32:5">Zab 32:5</ref>; <ref loc="1JN 1:8">1 Yoh 1:8</ref>, <ref loc="1JN 1:9">9</ref>. </char>
    </note> Orikushereka eby'okushiisha bye, tariba gye;</para>
  <para style="q1" vid="PRO 28:13">Kwonka orikubyatura, akabireka, aryasaasirwa.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Omuntu orikutiina MUKAMA obutoosha aine omugisha;</para>
  <para style="q1" vid="PRO 28:14">Kwonka orikugangaaza omutima gwe, aryagwerwa akagwe.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:15: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:13">Kur 1:13</ref>, <ref loc="EXO 1:14">14</ref>; <ref loc="MAT 2:16">Mat 2:16</ref>. </char>
    </note> Omutegyeki mubi orikutegyeka eihanga ry'abooro,</para>
  <para style="q1" vid="PRO 28:15">Ni nk'entare erikutsinda, nari nk'edubu eyaasyokayo kurwana.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Omutegyeki otaine kwetegyereza abonabonesa abantu munonga,</para>
  <para style="q1" vid="PRO 28:16">Kwonka omuntu orikwanga amagoba mabi aryahangaara.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Omuntu otukuriirwe eshagama y'ou aitsire,</para>
  <para style="q1" vid="PRO 28:17">K'agume ari omuhungi, okuhitsya aha kufa;</para>
  <para style="q1" vid="PRO 28:17">Kandi hatarigira owaamuhwera.<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:9">Enf 10:9</ref>. </char>
    </note> Orikugyendera omu bwesigwa aryajunwa.</para>
  <para style="q1" vid="PRO 28:18">Kwonka orikwehabagiriza omu mihanda ye, aryagwa omu kiina.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:19: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:11">Enf 12:11</ref>. </char>
    </note> Orikuhinga emisiri ye, aryagira eby'okurya bingi,</para>
  <para style="q1" vid="PRO 28:19">Kwonka orikukuratira ebitaine mugasho, aryagira obworo bwingi.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:20: </char>
      <char style="xt" closed="false">
        <ref loc="1TI 6:9">1 Tim 6:9</ref>. </char>
    </note> Omuntu omwesigwa aryagira emigisha mingi,</para>
  <para style="q1" vid="PRO 28:20">Kwonka orikutunga ebya bugubugu taribura kufubirwa.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:5">Enf 18:5</ref>; <ref loc="EZK 13:19">Ezk 13:19</ref>. </char>
    </note> Okushoroora omu bantu ti kirungi,</para>
  <para style="q1" vid="PRO 28:21">N'obu kwakuba omuntu okushiisha ahabw'ak'okurya kakye.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Omuntu engumya asheruza eitungo obwira,</para>
  <para style="q1" vid="PRO 28:22">Kandi tamanya ku obworo burimuhikaho.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:5">Enf 27:5</ref>, <ref loc="PRO 27:6">6</ref>; <ref loc="PRO 29:5">29:5</ref>. </char>
    </note> Orikuhana omuntu aryakundwa</para>
  <para style="q1" vid="PRO 28:23">Okukira ow'orurimi rurikumamarika.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Oiba ishe nari nyina, akagira ati: Tiinyine ki naashobya,</para>
  <para style="q1" vid="PRO 28:24">Ogwo aba ari munywani w'omuhwerekyerezi.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:18">Enf 15:18</ref>. </char>
    </note> Omunyamururu aimutsya entongane,</para>
  <para style="q1" vid="PRO 28:25">Kwonka orikwesiga MUKAMA aryatungisibwa.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:26: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 3:18">1 Kor 3:18</ref>. </char>
    </note> Orikwesiga omutima gwe n'omushema;</para>
  <para style="q1" vid="PRO 28:26">Kwonka orikugyendera omu bwengye aryajunwa.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:27: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:24">Enf 11:24</ref>; <ref loc="PRO 19:17">19:17</ref>. </char>
    </note> Orikuha abooro, tarikyena;</para>
  <para style="q1" vid="PRO 28:27">Kwonka orikubeehuzya aryagira emikyeeno mingi.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:28: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:12">Enf 28:12</ref>. </char>
    </note> Ababi ku batunguuka, abantu beeshereka;</para>
  <para style="q1" vid="PRO 28:28">Kwonka ku bacwekyerera, abahikiriire bakanya.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:14-27">Enf 1:14-27</ref>; <ref loc="PRO 6:15">6:15</ref>; <ref loc="JER 19:11">Yer 19:11</ref>. </char>
    </note> Orikuhanwa kaingi, akaguma agangaize ebitsya,</para>
  <para style="q1" vid="PRO 29:1">Aryahendeka kitaraariire, kandi taritambirwa.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:12">Enf 28:12</ref>, <ref loc="PRO 28:28">28</ref>; <ref loc="EST 3:15">Est 3:15</ref>; <ref loc="EST 8:15">8:15</ref>. </char>
    </note> Abahikiriire ku bategyeka, abantu bashemererwa;</para>
  <para style="q1" vid="PRO 29:2">Kwonka ababi ku bategyeka, abantu batsinda, baborooga.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:26">Enf 6:26</ref>; <ref loc="PRO 10:1">10:1</ref>; <ref loc="1KI 1:48">1 Bag 1:48</ref>. </char>
    </note> Okunda obwengye ashemeza ishe;</para>
  <para style="q1" vid="PRO 29:3">Kwonka okwatanisa na baamaraaya, ashiisha ebye.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Omugabe ocwera ensi ye emanja z'oburyo, agihamya;</para>
  <para style="q1" vid="PRO 29:4">Kwonka orya enguzi, agicwekyereza.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:23">Enf 28:23</ref>; <ref loc="PSA 9:15">Zab 9:15</ref>. </char>
    </note> Omuntu ogira ekimama ahari mutaahi we,</para>
  <para style="q1" vid="PRO 29:5">Aba nk'omutegire ekigoye.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:6: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 9:12">Mub 9:12</ref>. </char>
    </note> Omu kucumura kw'omuntu mubi habamu omutego;</para>
  <para style="q1" vid="PRO 29:6">Kwonka ohikiriire ayesiima, ateera akaari.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:16">Yob 29:16</ref>; <ref loc="PSA 41:1">Zab 41:1</ref>. </char>
    </note> Ohikiriire amanya ebishemereire omunaku,</para>
  <para style="q1" vid="PRO 29:7">Kwonka omubi tagira kwetegyereza kw'okubimanya.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Abagayi bajagaraza orurembo,</para>
  <para style="q1" vid="PRO 29:8">Kwonka abanyabwengye baikaikanisa ekiniga.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Ow'obwengye ku ahakana n'omushema,</para>
  <para style="q1" vid="PRO 29:9">Omushema n'obu agira ekiniga kingi, nari akasheka,</para>
  <para style="q1" vid="PRO 29:9">Hoona tihabaho buhuumure.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:10: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 4:5">Kut 4:5</ref>, <ref loc="GEN 4:8">8</ref>; <ref loc="1JN 3:12">1 Yoh 3:12</ref>. </char>
    </note> Abakunda kwitana banga otaine kamogo;</para>
  <para style="q1" vid="PRO 29:10">Kandi n'ow'omutima gugororokire basherura oku baraamwite.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Omushema ayoreka butunu ekiniga kye kyona,</para>
  <para style="q1" vid="PRO 29:11">Kwonka omunyabwengye ayezibira, akiikaikanisa.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Omutegyeki ku arikutega amatu enkuru z'ebishuba,</para>
  <para style="q1" vid="PRO 29:12">Abatware be boona baryahinduka babi.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:13: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:2">Enf 22:2</ref>; <ref loc="PSA 13:3">Zab 13:3</ref>. </char>
    </note> Omworo n'orikuhata bateeranira hamwe;</para>
  <para style="q1" vid="PRO 29:13">MUKAMA ahwezesa amaisho gaabo bombi.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:12">Enf 16:12</ref>; <ref loc="PSA 72:2">Zab 72:2</ref>, <ref loc="PSA 72:4">4</ref>. </char>
    </note> Omugabe orikucwera abooro emanja omu bwinganisa,</para>
  <para style="q1" vid="PRO 29:14">Ekitebe ky'obugabe bwe kiryahamibwa ebiro byona.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:1">Enf 10:1</ref>. </char>
    </note> Omunyaafu n'okuhana byegyesa obwengye;</para>
  <para style="q1" vid="PRO 29:15">Kwonka omwana ou bahugaho, ahemura nyina.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:34">Zab 37:34</ref>; <ref loc="PSA 91:8">91:8</ref>. </char>
    </note> Ababi ku bakanya, n'eby'okushiisha bikanya;</para>
  <para style="q1" vid="PRO 29:16">Kwonka abahikiriire baryareeba okugwa kwabo.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:24">Enf 13:24</ref>. </char>
    </note> Hana omwana waawe, aryakuruhuura,</para>
  <para style="q1" vid="PRO 29:17">Ashemeze omutima gwawe.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:18: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:25">Kur 32:25</ref>; <ref loc="1SA 3:1">1 Sam 3:1</ref>; <ref loc="AMO 8:11">Amo 8:11</ref>, <ref loc="AMO 8:12">12</ref>; <ref loc="JHN 13:17">Yoh 13:17</ref>; <ref loc="JAS 1:25">Yak 1:25</ref>. </char>
    </note> Ahatari kworekwa abantu banga kutegyekwa,</para>
  <para style="q1" vid="PRO 29:18">Kwonka oyorobera ebiragiro, ahiiriirwe.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Omuheereza tategyekwa bigambo byonka,</para>
  <para style="q1" vid="PRO 29:19">Ahakuba, n'obu abihurira, tabyetaho.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:12">Enf 26:12</ref>. </char>
    </note> Beitu nooreeba omuntu orahukwa aha rurimi?</para>
  <para style="q1" vid="PRO 29:20">Bakaagira amatsiko aha mushema okukira ogwo.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Omuhuuku orikwiha omu buto naatetsibwa mukama we,</para>
  <para style="q1" vid="PRO 29:21">Aha muheru aryashangwa yaabaire omuhunguzi.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:18">Enf 15:18</ref>. </char>
    </note> Omunyakiniga aimutsya entongane,</para>
  <para style="q1" vid="PRO 29:22">Orikurahuka kuguubwa kubi akanyisa ebicumuro.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:23: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:2">Enf 11:2</ref>; <ref loc="PRO 15:33">15:33</ref>; <ref loc="MAT 23:12">Mat 23:12</ref>; <ref loc="JAS 4:6">Yak 4:6</ref>. </char>
    </note> Amaryo g'omuntu garyamugarura ahansi,</para>
  <para style="q1" vid="PRO 29:23">Kwonka orikucureera omu mutima aryaheebwa ekitiinisa.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:24: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 5:1">Lev 5:1</ref>. </char>
    </note> Okwatanisa n'omushema, aba ayangire amagara ge;</para>
  <para style="q1" vid="PRO 29:24">Ku ahurira nibamurahiza, tagira ki agarukamu.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:10">Enf 18:10</ref>; <ref loc="GEN 12:12">Kut 12:12</ref>, <ref loc="GEN 12:13">13</ref>; <ref loc="JHN 12:42">Yoh 12:42</ref>, <ref loc="JHN 12:43">43</ref>. </char>
    </note> Okutiina abantu kureeta omutego,</para>
  <para style="q1" vid="PRO 29:25">Kwonka orikwesiga MUKAMA aryaguma ari buhooro.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:26: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:4">Isa 49:4</ref>. </char>
    </note> Baingi bakunda kushongoka aha mutegyeki,</para>
  <para style="q1" vid="PRO 29:26">Kwonka MUKAMA niwe areetera omuntu kucwerwa orubanja rw'oburyo.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Otahikiriire n'ekirikunugwa aha bahikiriire,</para>
  <para style="q1" vid="PRO 29:27">Kandi ow'omutima gugororokire n'ekirikunugwa aha babi.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 31:1">Enf 31:1</ref>. </char>
    </note> Ebigambo bya Aguri mwene Yaake owa Maasa. Ogwo mushaija naagira Ityeli, Ityeli hamwe na Ukaali ati:<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:22">Zab 73:22</ref>. </char>
    </note> Buzima ndi ekituuriizi, ekitashemereire kuba omuntu;</para>
  <para style="q1" vid="PRO 30:2">Tiinyine kwetegyereza nk'okw'omuntu.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Tindeegire bwengye, kandi tindikumanya Orikwera.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:3">Zab 104:3</ref>, <ref loc="PSA 104:4">4</ref>; <ref loc="JOB 26:8">Yob 26:8</ref>; <ref loc="JHN 3:13">Yoh 3:13</ref>; <ref loc="REV 19:12">Kush 19:12</ref>. </char>
    </note> N'oha owaatembire omu iguru, akagaruka, akashuuma?</para>
  <para style="q1" vid="PRO 30:4">N'oha owaafumbatiize omuyaga omu ntomi?</para>
  <para style="q1" vid="PRO 30:4">N'oha owaazingiriire amaizi omu mwenda?</para>
  <para style="q1" vid="PRO 30:4">N'oha owaateireho enshonda zoona ez'ensi?</para>
  <para style="q1" vid="PRO 30:4">Eiziina rye n'oha, n'ery'omutabani niriiha,</para>
  <para style="q1" vid="PRO 30:4">Ku oraabe noogamanya?<verse eid="PRO 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:30">Zab 18:30</ref>. </char>
    </note> Buri kigambo kya Ruhanga kihamibwa ku kiri eky'amazima;</para>
  <para style="q1" vid="PRO 30:5">Niwe ngabo y'abamuhungiraho.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:6: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:2">Bir 4:2</ref>. </char>
    </note> Otagira eki waayongyera aha bigambo bye,</para>
  <para style="q1" vid="PRO 30:6">Atakaakuhana, okashangwa ori omubeihi.<verse eid="PRO 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Ninkushaba ebintu bibiri, otabiinyima ntakafiire.<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:11">Mat 6:11</ref>. </char>
    </note> Nyihaho ebitaine mugasho n'ebishuba, obite hare;</para>
  <para style="q1" vid="PRO 30:8">Otampindura omworo nari omutungi,</para>
  <para style="q1" vid="PRO 30:8">Kureka ogume ompe eby'okurya ebinshemereire,<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 5:2">Kur 5:2</ref>; <ref loc="EXO 20:7">20:7</ref>; <ref loc="DEU 8:12">Bir 8:12</ref>, <ref loc="DEU 8:14">14</ref>. </char>
    </note> Ntakaiguta munonga, nkakwehakana,</para>
  <para style="q1" vid="PRO 30:9">Nkagira nti: MUKAMA niki?</para>
  <para style="q1" vid="PRO 30:9">Nari shi, ntakaba omworo nkaiba.</para>
  <para style="q1" vid="PRO 30:9">Nkajumisa eiziina rya Ruhanga wangye.<verse eid="PRO 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 15:3">Zab 15:3</ref>. </char>
    </note> Otaribeiherera omuheereza ahari mukama we,</para>
  <para style="q1" vid="PRO 30:10">Nyentsya atarikukyeena, okagiibwaho orubanja.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:11: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 21:17">Kur 21:17</ref>. </char>
    </note> Hariho abakyeena baishebo,</para>
  <para style="q1" vid="PRO 30:11">Kandi batashabira baanyinabo omugisha.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:2">Enf 16:2</ref>; <ref loc="ISA 65:5">Isa 65:5</ref>; <ref loc="LUK 18:11">Luk 18:11</ref>; <ref loc="REV 3:17">Kush 3:17</ref>. </char>
    </note> Hariho abeeyeta abashemeire,</para>
  <para style="q1" vid="PRO 30:12">Kwonka bateeziibweho bihagaro byabo.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 101:5">Zab 101:5</ref>. </char>
    </note> Hariho n'abandi; yeimwe, eshi bagira amaisho g'amaryo,</para>
  <para style="q1" vid="PRO 30:13">Bagayisa abantu amaisho!<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:4">Zab 14:4</ref>; <ref loc="AMO 8:4">Amo 8:4</ref>. </char>
    </note> Hariho abu amaino gaabo geemi nka rurara,</para>
  <para style="q1" vid="PRO 30:14">N'ebigigo byabo biri nk'emisyo,</para>
  <para style="q1" vid="PRO 30:14">Okumira abooro, bakabamara omu nsi,</para>
  <para style="q1" vid="PRO 30:14">N'abakyene, bakabamara omu bantu.<verse eid="PRO 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Omushundo gwine bahara baagwo babiri,</para>
  <para style="q1" vid="PRO 30:15">Bashaba obutoosha nibagira bati: Mpa! Mpa!</para>
  <para style="q1" vid="PRO 30:15">Hariho ebintu bishatu ebitahaaga,</para>
  <para style="q1" vid="PRO 30:15">Nangwa ni bina, ebitagira biti, Naiguta;<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 30:1">Kut 30:1</ref>. </char>
    </note> Nibyo ebi–Okuzimu, enda y'engumba,</para>
  <para style="q1" vid="PRO 30:16">Ensi etahaaga amaizi.</para>
  <para style="q1" vid="PRO 30:16">N'omuriro ogutakagiraga guti, Naiguta.<verse eid="PRO 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:17: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:22">Enf 23:22</ref>; <ref loc="GEN 9:22">Kut 9:22</ref>; <ref loc="JER 16:4">Yer 16:4</ref>. </char>
    </note> Eriisho ry'oteerera ishe enaku,</para>
  <para style="q1" vid="PRO 30:17">Akeekunika, akanga kworobera nyina,</para>
  <para style="q1" vid="PRO 30:17">Riryanonkoorwa ebikoona by'omu mpanga,</para>
  <para style="q1" vid="PRO 30:17">Ririibwe amahungu.<verse eid="PRO 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Hariho ebintu bishatu ebikira kuntangaaza,</para>
  <para style="q1" vid="PRO 30:18">Nangwa ni bina ebi nteetegyereza,<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Nibyo ebi: Emizeereerere y'empungu omu mwanya,</para>
  <para style="q1" vid="PRO 30:19">Emigyendere y'enjoka aha rukiri,</para>
  <para style="q1" vid="PRO 30:19">Emigyendere y'emeeri aha nyanja,</para>
  <para style="q1" vid="PRO 30:19">N'emitwarize y'omushaija aha mwishiki.<verse eid="PRO 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Nikwo n'emitwarize y'omukazi enshambani eba.</para>
  <para style="q1" vid="PRO 30:20">Arya, ayeragaza aha minwa, agira ati: Tiinyine ki naashobya.<verse eid="PRO 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Hariho ebintu bishatu ebitengyetsa ensi,</para>
  <para style="q1" vid="PRO 30:21">Nangwa ni bina ebi etabaasa kugumisiririza,<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:22: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:10">Enf 19:10</ref>. </char>
    </note> Nibyo ebi: Omuhuuku kuba omugabe,</para>
  <para style="q1" vid="PRO 30:22">Omushema kuhaaga eby'okurya,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />Omwishiki owaabengirwe kushwerwa,</para>
  <para style="q1" vid="PRO 30:23">N'omuzaana kuhungurira mugore we.<verse eid="PRO 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Aha nsi hariho ebintu bina, n'obu biraabe biba bikye,</para>
  <para style="q1" vid="PRO 30:24">Kwonka bigira obwengye bwingi munonga.<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:6-8">Enf 6:6-8</ref>. </char>
    </note> Nibyo ebi: Ebimunyu n'eihanga eritagira maani,</para>
  <para style="q1" vid="PRO 30:25">Kwonka byehunikira eby'okurya omu kyanda;<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:18">Zab 104:18</ref>. </char>
    </note> Endirira n'eihanga eritagira maani,</para>
  <para style="q1" vid="PRO 30:26">Kwonka zeegirira amaju omu mabaare;<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:27: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:7">Yoel 2:7</ref>, <ref loc="JOL 2:8">8</ref>. </char>
    </note> Enzigye tizigira mukama,</para>
  <para style="q1" vid="PRO 30:27">Kwonka zigyendera hamwe omu buteeka;<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />N'ekinya n'ekintu eki orikubaasa kutwara omu ngaro,</para>
  <para style="q1" vid="PRO 30:28">Kwonka kituura omu bikaari by'abagabe.<verse eid="PRO 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Hariho ebintu bishatu nangwa ni bina,</para>
  <para style="q1" vid="PRO 30:29">Ebinyigimba omu migyendere yaabyo.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Nibyo ebi: Entare egira amaani okukira ezindi nyamaishwa,</para>
  <para style="q1" vid="PRO 30:30">Kandi tegira kindi kyona eki ehunga;<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />Embaraasi y'aha rugamba, empaya y'embuzi,</para>
  <para style="q1" vid="PRO 30:31">N'omugabe otaturukirirwa.<verse eid="PRO 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:32: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 7:16">Mik 7:16</ref>. </char>
    </note> Ku oraabe okozire eby'obushema, okeetunguura,</para>
  <para style="q1" vid="PRO 30:32">Nari okateekateeka kukora kubi, kwata aha munwa;<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Ahabw'okuba okucunda amate kujwisa amajuta,</para>
  <para style="q1" vid="PRO 30:33">Okumiga enyindo kujwisa eshagama,</para>
  <para style="q1" vid="PRO 30:33">N'okwitsa ekiniga kureeta entongane.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Omugabe oku ashemereire kuba</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:1">Enf 30:1</ref>. </char>
    </note> Ebigambo bya Lemueli, omugabe wa Maasa, ebi yaayegyesiibwe nyina.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />N'enki, mwana wangye, ou naayezaariire?</para>
  <para style="q1" vid="PRO 31:2">N'enki, mwana wangye, ou naaraganiise Ruhanga nimpiga?<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:3: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 17:17">Bir 17:17</ref>; <ref loc="1KI 11:1">1 Bag 11:1</ref>, <ref loc="1KI 11:4">4</ref>; <ref loc="NEH 13:26">Neh 13:26</ref>. </char>
    </note> Otariha abakazi amaani gaawe,</para>
  <para style="q1" vid="PRO 31:3">N'obu kwakuba okuza omuri abo abacwekyereza abagabe.<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:4: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 20:16">1 Bag 20:16</ref>; <ref loc="ECC 10:17">Mub 10:17</ref>; <ref loc="HOS 4:11">Hos 4:11</ref>. </char>
    </note> Tikishemereire bagabe, iwe Lemueli,</para>
  <para style="q1" vid="PRO 31:4">Ti ky'abagabe kunywa viinyo,</para>
  <para style="q1" vid="PRO 31:4">N'obu baakuba abategyeki kwetenga ebirikusinza,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:22">Isa 5:22</ref>, <ref loc="ISA 5:23">23</ref>. </char>
    </note> Ngu batakaanywa, bakeebwa ebiragiro,</para>
  <para style="q1" vid="PRO 31:5">Bakaita emanja z'abarikubonabonesibwa boona.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Ekirikusinza okihe orikwenda kufa,</para>
  <para style="q1" vid="PRO 31:6">Na viinyo ogihe oine obusaasi bwingi omu mutima,<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:15">Zab 104:15</ref>. </char>
    </note> Anywe, ayebwe obworo bwe, arekye kwijuka enaku ze.<verse eid="PRO 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:12">Yob 29:12</ref>, <ref loc="JOB 29:15">15</ref>, <ref loc="JOB 29:16">16</ref>; <ref loc="ISA 1:17">Isa 1:17</ref>. </char>
    </note> Yashamya akanwa kaawe, ogambirire ebiteta,</para>
  <para style="q1" vid="PRO 31:8">Kandi otonganire abatsigirweho abataine ifo na ruguru.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:9: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:15">Lev 19:15</ref>; <ref loc="DEU 1:16">Bir 1:16</ref>; <ref loc="JER 22:16">Yer 22:16</ref>; <ref loc="ZEC 7:9">Zek 7:9</ref>, <ref loc="ZEC 7:10">10</ref>; <ref loc="JHN 7:24">Yoh 7:24</ref>. </char>
    </note> Yashamya akanwa kaawe, ocwe emanja z'oburyo,</para>
  <para style="q1" vid="PRO 31:9">Orwanirire abooro n'abakyene.<verse eid="PRO 31:9" /></para>
  <para style="s1">Okusiimwa kw'omukazi w'omutima</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:4">Enf 12:4</ref>. </char>
    </note> Omukazi w'omutima, n'oha owaakumuzoora?</para>
  <para style="q1" vid="PRO 31:10">Ahakuba naakira amabaare g'obuguzi bwingi.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Omutima gwa iba gumwesiga,</para>
  <para style="q1" vid="PRO 31:11">Kandi omushaija we taribura kutunga.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Ebiro byona eby'amagara ge</para>
  <para style="q1" vid="PRO 31:12">Akora gye iba, tamukora kubi.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Ayezirika kutunga ebyoya by'entaama na furakisi,</para>
  <para style="q1" vid="PRO 31:13">Kandi akora n'emikono eyekundiire.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Omukazi ogwo ni nk'amaato g'abashuubuzi,</para>
  <para style="q1" vid="PRO 31:14">Aiha eby'okurya bye hare.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:15: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:13">Enf 20:13</ref>; <ref loc="MAT 24:45">Mat 24:45</ref>; <ref loc="LUK 12:42">Luk 12:42</ref>. </char>
    </note> Aimuka butakaseesire,</para>
  <para style="q1" vid="PRO 31:15">Atebeekanisiza ab'omu ka ye eby'okurya,</para>
  <para style="q1" vid="PRO 31:15">Kandi n'abazaana be abateekateekyera emirimo.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Ayetegyereza omusiri, agugura,</para>
  <para style="q1" vid="PRO 31:16">Agubyaramu emizaabibu, naakoresa ebirugire omu mikono ye.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Ayezirika amaani nk'omweko, kandi ahamya emikono ye.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Amanya ebi arikukora ku bimwiniire omugasho,</para>
  <para style="q1" vid="PRO 31:18">Kandi etabaaza ye nyekiro teraara.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Emikono ye agita aha kiti ky'ebyoya by'entaama,</para>
  <para style="q1" vid="PRO 31:19">N'engaro ze zikwata akati k'okukaragisa.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Ashashaanurira abooro engaro,</para>
  <para style="q1" vid="PRO 31:20">N'abakyene abahwera n'emikono ye.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Tatiinirira b'omu ka y'ebiro by'embeho,</para>
  <para style="q1" vid="PRO 31:21">Ahabw'okuba ab'omu ka ye boona bajwara ebirikutukura.<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />Ayebaziirira eby'okwefubika,</para>
  <para style="q1" vid="PRO 31:22">Kandi ajwara emyenda ya bafuta na bujwa.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:23: </char>
      <char style="xt" closed="false">
        <ref loc="RUT 4:1">Rus 4:1</ref>, <ref loc="RUT 4:2">2</ref>. </char>
    </note> Iba amanyirwa omu marembo, ashutami n'abakuru b'ensi.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Abaziira ebijwaro bya kitaani, kandi abitunda,</para>
  <para style="q1" vid="PRO 31:24">Abashuubuzi abaha emyeko.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Amaani n'ekitiinisa nibyo bijwaro bye;</para>
  <para style="q1" vid="PRO 31:25">Ebiriija tabitiina, abishekyerera.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Akanwa ke kagamba eby'obwengye,</para>
  <para style="q1" vid="PRO 31:26">Kandi okwegyesa eby'embabazi tikumuruga mu kanwa.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Areeberera gye emicwe y'ab'omu ka ye;</para>
  <para style="q1" vid="PRO 31:27">Kandi tariira koya.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Abaana be baimuka, bamweta ow'omugisha;</para>
  <para style="q1" vid="PRO 31:28">Kandi na iba amusingiza naagira ati:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />Abakazi baingi batwaza gye, kwonka iwe obakira boona.<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:30: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:16">Enf 11:16</ref>. </char>
    </note> Karimi karungi n'oburyarya; kandi oburungi ni busha;</para>
  <para style="q1" vid="PRO 31:30">Kwonka omukazi otiina MUKAMA aba ow'okusiimwa.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Mumusiime ahabw'ebi emikono ye ekozire,</para>
  <para style="q1" vid="PRO 31:31">Kandi emirimo ye emuhimbisise omu marembo.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>