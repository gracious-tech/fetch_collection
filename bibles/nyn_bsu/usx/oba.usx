<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">RRK31.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">OBADIA</para>
  <para style="toc1">Ekitabo Kya Nabi Obadia</para>
  <para style="toc2">Obadia</para>
  <para style="toc3">Oba</para>
  <para style="mt2">EKITABO KYA NABI</para>
  <para style="mt1">OBADIA</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">Ruhanga okufubira Edomu ahabw'okwita kubi Israeli</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="JER 49:7-22">Yer 49:7-22</ref>; <ref loc="EZK 25:12-14">Ezk 25:12-14</ref>. </char>
    </note> Okworekwa kwa Obadia. Oku nikwo Mukama RUHANGA arikugamba ahari Edomu naagira ati:</para>
  <para style="q1" vid="OBA 1:1">Tuhuriire amakuru agarugire ahari MUKAMA,</para>
  <para style="q1" vid="OBA 1:1">Entumwa etumirwe aha mahanga.</para>
  <para style="q1" vid="OBA 1:1">Nimwimukye, twimukye tumurwanise.<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />Reeba, niinyija kukugira mukye omu mahanga,</para>
  <para style="q1" vid="OBA 1:2">Obe orikugayirwa kimwe.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Amaryo g'omu mutima gwawe gakubeihire,</para>
  <para style="q1" vid="OBA 1:3">Iwe otuura omu bicokoromi by'amabaare,</para>
  <para style="q1" vid="OBA 1:3">Otuura omu myanya y'ahaiguru,</para>
  <para style="q1" vid="OBA 1:3">Orikugira omu mutima gwawe oti:</para>
  <para style="q1" vid="OBA 1:3">N'oha owaakumpanurayo, akangarura ahansi?<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />N'obu oraatumbiikye eiguru nk'eishamba,</para>
  <para style="q1" vid="OBA 1:4">Okaarika ahaiguru ahagati y'enyonyoozi,</para>
  <para style="q1" vid="OBA 1:4">Okwo nayo ndyakuhanurayo, ogarukye ahansi;</para>
  <para style="m" vid="OBA 1:4">nikwo MUKAMA arikugira.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5, 6: </char>
      <char style="xt" closed="false">
        <ref loc="JER 49:9">Yer 49:9</ref>, <ref loc="JER 49:10">10</ref>. </char>
    </note> Abashuma nari abambuzi ku baakukwijaho nyekiro,</para>
  <para style="q1" vid="OBA 1:5">Tibakaiba ebirikubamara byonka?</para>
  <para style="q1" vid="OBA 1:5">(Eshi ocwekyereziibwe!)</para>
  <para style="q1" vid="OBA 1:5">Abashoromi b'emizaabibu ku baakwija owaawe,</para>
  <para style="q1" vid="OBA 1:5">Tibakaakutsigira eby'okuhumba?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Eshi Esau anyagirwe,</para>
  <para style="q1" vid="OBA 1:6">Ebintu bye by'obuguzi bwingi byacaakwa!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:9">Zab 41:9</ref>. </char>
    </note> Abakwatanisa naiwe boona bakubeihire,</para>
  <para style="q1" vid="OBA 1:7">Baakubinga, baakuhitsya aha mwatano;</para>
  <para style="q1" vid="OBA 1:7">Abantu abu ogira nabo obusingye bakusingwire,</para>
  <para style="q1" vid="OBA 1:7">Banywani baawe abu orikwesiga bakutegire omutego;</para>
  <para style="q1" vid="OBA 1:7">Kwonka tiwaakimanya.<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:8: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:14">Isa 29:14</ref>. </char>
    </note> MUKAMA naagira ati: Eryo izooba</para>
  <para style="q1" vid="OBA 1:8">Tindicwekyereza abanyabwengye, nkabamara omuri Edomu,</para>
  <para style="q1" vid="OBA 1:8">Okwetegyereza kukahwa aha rushozi rwa Esau?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:9: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 1:12">Amo 1:12</ref>. </char>
    </note> Iwe Temani, amamanzi gaawe garyahahaaza emitima,</para>
  <para style="q1" vid="OBA 1:9">Buri muntu w'aha rushozi rwa Esau aitwe.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:10: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 20:20">Kub 20:20</ref>, <ref loc="NUM 20:21">21</ref>. </char>
    </note> Obubisha obu waagiriire murumuna waawe Yakobo</para>
  <para style="q1" vid="OBA 1:10">Buryakureetera kushwekwa enshoni,</para>
  <para style="q1" vid="OBA 1:10">Omarirweho kimwe ebiro byona.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:11: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:10-20">2 Bag 25:10-20</ref>; <ref loc="PSA 137:7">Zab 137:7</ref>; <ref loc="JOL 3:3">Yoel 3:3</ref>. </char>
    </note> Eizooba riri obu waamwemerera hangahari,</para>
  <para style="q1" vid="OBA 1:11">Obu abahinguzi baanyaga obutungi bwe,</para>
  <para style="q1" vid="OBA 1:11">Abanyamahanga bakataaha omu marembo ge,</para>
  <para style="q1" vid="OBA 1:11">Bakateerera Yerusaalemu enteenyu,</para>
  <para style="q1" vid="OBA 1:11">Naiwe okaba ori nkabo.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:12: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 4:11">Mik 4:11</ref>; <ref loc="MIC 7:8">7:8</ref>. </char>
    </note> Kwonka okaba otashemereire kuteerera murumuna waawe omu kwahwa</para>
  <para style="q1" vid="OBA 1:12">Aha izooba eri yaagwereirweho akagwe;</para>
  <para style="q1" vid="OBA 1:12">Okaba otashemereire kwesiimirana Abayuda</para>
  <para style="q1" vid="OBA 1:12">Aha izooba eri baacwekyerereziibweho;</para>
  <para style="q1" vid="OBA 1:12">Okaba otashemereire kwehimbisa</para>
  <para style="q1" vid="OBA 1:12">Aha izooba ry'okweshobera;<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Okaba otashemereire kutaaha omu irembo ry'abantu bangye</para>
  <para style="q1" vid="OBA 1:13">Aha izooba eri baareebeireho enaku,</para>
  <para style="q1" vid="OBA 1:13">Nari okubateerera omu kwahwa</para>
  <para style="q1" vid="OBA 1:13">Aha izooba eri baareebeireho enaku,</para>
  <para style="q1" vid="OBA 1:13">Nari okushahura ebintu byabo</para>
  <para style="q1" vid="OBA 1:13">Aha izooba eri baareebeireho enaku;<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Okaba otashemereire kwemerera omu ntaaniro z'emihanda</para>
  <para style="q1" vid="OBA 1:14">Kumaraho abantu be abarikuhunga;</para>
  <para style="q1" vid="OBA 1:14">Kandi okaba otashemereire kuhayo abantu be abahonokireho</para>
  <para style="q1" vid="OBA 1:14">Aha izooba ryabo ry'okureeberaho enaku.<verse eid="OBA 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 35:15">Ezk 35:15</ref>; <ref loc="JOL 1:15">Yoel 1:15</ref>; <ref loc="HAB 2:8">Hab 2:8</ref>. </char>
    </note> Ahabw'okuba eizooba rya MUKAMA riri haihi kuhika aha mahanga goona.</para>
  <para style="q1" vid="OBA 1:15">Nk'oku mwagizire, naimwe nikwo murigirwa;</para>
  <para style="q1" vid="OBA 1:15">Ebi mwakozire, biryabahindukana.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:16: </char>
      <char style="xt" closed="false">
        <ref loc="JER 25:27">Yer 25:27</ref>, <ref loc="JER 25:28">28</ref>. </char>
    </note> Nk'oku mwanywereire aha rushozi rwangye orurikwera,</para>
  <para style="q1" vid="OBA 1:16">Nikwo n'amahanga goona agari embaju zoona garinywa;</para>
  <para style="q1" vid="OBA 1:16">Buzima garyanywa, gataruze,</para>
  <para style="q1" vid="OBA 1:16">Gabe nk'agatakabahoga.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:17: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 9:8">Amo 9:8</ref>, <ref loc="AMO 9:12">12</ref>; <ref loc="JOL 2:32">Yoel 2:32</ref>. </char>
    </note> Kwonka aha rushozi Saayuuni haryabaho abahonokireho;</para>
  <para style="q1" vid="OBA 1:17">Habe aharikwera.</para>
  <para style="q1" vid="OBA 1:17">Kandi ab'enju ya Yakobo baryagaruka batungye</para>
  <para style="q1" vid="OBA 1:17">Ebyabaire biri ebyabo.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 10:17">Isa 10:17</ref>; <ref loc="ZEC 12:6">Zek 12:6</ref>. </char>
    </note> Enju ya Yakobo eryaba omuriro;</para>
  <para style="q1" vid="OBA 1:18">Enju ya Yosefu eryaba ekirimi ky'omuriro,</para>
  <para style="q1" vid="OBA 1:18">N'enju ya Esau ebe nk'ebitsintsi by'embuba.</para>
  <para style="q1" vid="OBA 1:18">Baryabootsya, babamareho,</para>
  <para style="q1" vid="OBA 1:18">Habure owaahonokaho aha b'omuri egyo nju;</para>
  <para style="q1" vid="OBA 1:18">Ahabw'okuba MUKAMA niwe yaakigamba.<verse eid="OBA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:19: </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:26">Yer 17:26</ref>. </char>
    </note> Ab'omuri Negebu baryakubuura orushozi rwa Esau,</para>
  <para style="q1" vid="OBA 1:19">Ab'omu mpita bakubuure ensi y'Abafilistia,</para>
  <para style="q1" vid="OBA 1:19">Bakubuure ensi ya Efuraimu n'eya Samaria;</para>
  <para style="q1" vid="OBA 1:19">Kandi Benyamiini eryakubuura Gileadi.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:20: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 17:9">1 Bag 17:9</ref>; <ref loc="LUK 4:26">Luk 4:26</ref>. </char>
    </note> Enkwatwa z'omuri Hala ez'omu Baisraeli</para>
  <para style="q1" vid="OBA 1:20">Ziryakubuura Foiniiki okuhika Zarefaasi,</para>
  <para style="q1" vid="OBA 1:20">N'enkwatwa za Yerusaalemu ez'omuri Sefaraadi</para>
  <para style="q1" vid="OBA 1:20">Ziryakubuura endembo z'omuri Negebu.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:28">Zab 22:28</ref>; <ref loc="ISA 19:20">Isa 19:20</ref>; <ref loc="LUK 1:33">Luk 1:33</ref>; <ref loc="1CO 15:24">1 Kor 15:24</ref>; <ref loc="REV 11:15">Kush 11:15</ref>; <ref loc="REV 19:6">19:6</ref>. </char>
    </note> Abajuni baryainamuka aha rushozi Saayuuni</para>
  <para style="q1" vid="OBA 1:21">Kutegyeka orushozi rwa Esau;</para>
  <para style="q1" vid="OBA 1:21">Kandi obugabe buryaba obwa MUKAMA.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>