<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">RRK35.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">ZEFANIA</para>
  <para style="toc1">Ekitabo Kya Nabi Zefania</para>
  <para style="toc2">Zefania</para>
  <para style="toc3">Zef</para>
  <para style="mt2">EKITABO KYA NABI</para>
  <para style="mt1">ZEFANIA</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="s1">Nabi okuhanuura aha kufubirwa kw'Abayuda</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 22:1">2 Bag 22:1</ref>; <ref loc="JER 1:2">Yer 1:2</ref>. </char>
    </note> Eki n'ekigambo kya MUKAMA ekyaizire ahari Zefania mwene Kuushi, mwijukuru wa Gedalia, mwene Amaria, mwijukuru wa Hezekia, omu busingye bwa Yosia mwene Amoni omugabe wa Yuda.<verse eid="ZEP 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 22:16">2 Bag 22:16</ref>, <ref loc="2KI 22:17">17</ref>; <ref loc="JER 8:13">Yer 8:13</ref>. </char>
    </note> MUKAMA naagira ati: Ndyamariraho kimwe</para>
  <para style="q1" vid="ZEP 1:2">Ebintu byona aha nsi,<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 4:3">Hos 4:3</ref>. </char>
    </note> Mmareho abantu n'enyamaishwa,</para>
  <para style="q1" vid="ZEP 1:3">Mmareho ebirikuguruka omu mwanya,</para>
  <para style="q1" vid="ZEP 1:3">Kandi n'eby'omu nyanja.</para>
  <para style="q1" vid="ZEP 1:3">Ndyahwerekyereza ababi,</para>
  <para style="q1" vid="ZEP 1:3">Mmareho oyetwa omuntu weena ori omu nsi;</para>
  <para style="q1" vid="ZEP 1:3">nikwo MUKAMA arikugira.<verse eid="ZEP 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 23:4">2 Bag 23:4</ref>, <ref loc="2KI 23:5">5</ref>. </char>
    </note> Ndyabangira Yuda omukono,</para>
  <para style="q1" vid="ZEP 1:4">N'abatwire omuri Yerusaalemu boona;</para>
  <para style="q1" vid="ZEP 1:4">Kandi omuri ogu mwanya ndyamaramu aba Baali abatsigaireho,</para>
  <para style="q1" vid="ZEP 1:4">Mmareho eiziina ry'abanyamurwa abarikuramya ebishushani;<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5: </char>
      <char style="xt" closed="false">
        <ref loc="JER 19:13">Yer 19:13</ref>; <ref loc="JER 49:1">49:1</ref>. </char>
    </note> Abarikuramiza eihe ry'omu iguru</para>
  <para style="q1" vid="ZEP 1:5">Aha mitwe y'amaju,</para>
  <para style="q1" vid="ZEP 1:5">Abarikuramya nibarahira MUKAMA,</para>
  <para style="q1" vid="ZEP 1:5">Kandi bakaramya na Milikoomu;<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="JER 15:6">Yer 15:6</ref>. </char>
    </note> Kandi n'abaagarukire enyima, bakareka kukuratira MUKAMA,</para>
  <para style="q1" vid="ZEP 1:6">Abatakisherura MUKAMA, n'obu kwakuba okumwehanuuzaho.<verse eid="ZEP 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:7: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:5">1 Sam 16:5</ref>; <ref loc="ISA 13:6">Isa 13:6</ref>; <ref loc="JER 46:10">Yer 46:10</ref>; <ref loc="EZK 39:17">Ezk 39:17</ref>; <ref loc="HAB 2:20">Hab 2:20</ref>. </char>
    </note> Ceceka omu maisho ga Mukama RUHANGA!</para>
  <para style="q1" vid="ZEP 1:7">Ahakuba eizooba rya MUKAMA riri haihi;</para>
  <para style="q1" vid="ZEP 1:7">MUKAMA atebeekaniise ekitambo,</para>
  <para style="q1" vid="ZEP 1:7">Yaayeza abagyenyi be.<verse eid="ZEP 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:8: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 24:12">2 Bag 24:12</ref>, <ref loc="2KI 24:14">14</ref>. </char>
    </note> Aha izooba ry'ekitambo kya MUKAMA</para>
  <para style="q1" vid="ZEP 1:8">Ndyafubira abategyeki n'abatabani b'omugabe</para>
  <para style="q1" vid="ZEP 1:8">N'abajwaire ebijwaro by'enduga-mahanga boona.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />Kandi eryo izooba ndyafubira</para>
  <para style="q1" vid="ZEP 1:9">Buri muntu orikuguruka omuryango,</para>
  <para style="q1" vid="ZEP 1:9">N'abariwijuza enju ya mukama waabo</para>
  <para style="q1" vid="ZEP 1:9">Obubisha n'oburyangatanisa.<verse eid="ZEP 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:10: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 33:14">2 Bus 33:14</ref>. </char>
    </note> Kandi MUKAMA naagira ati: Eryo izooba</para>
  <para style="q1" vid="ZEP 1:10">Enduuru eryahurirwa neeruga aha Irembo ry'Eby'enyanja,</para>
  <para style="q1" vid="ZEP 1:10">N'okuborooga nikureetwa omu kicweka kya kabiri,</para>
  <para style="q1" vid="ZEP 1:10">N'okubaruka kuhango nikuruga omu bibungo.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:11: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 12:7">Hos 12:7</ref>; <ref loc="ZEC 14:21">Zek 14:21</ref>; <ref loc="JAS 5:1">Yak 5:1</ref>. </char>
    </note> Imwe batuuzi ba Makiteeshi 'mwe, nimuboroogye!</para>
  <para style="q1" vid="ZEP 1:11">Ahakuba abashuubuzi boona tibaakiriho,</para>
  <para style="q1" vid="ZEP 1:11">N'abarikupima efeeza boona bamazirweho.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:7">Zab 94:7</ref>; <ref loc="JER 48:11">Yer 48:11</ref>; <ref loc="EZK 8:12">Ezk 8:12</ref>; <ref loc="AMO 6:1">Amo 6:1</ref>; <ref loc="AMO 9:3">9:3</ref>. </char>
    </note> Omuri obwo bunaku ndyacaakisa Yerusaalemu amatabaaza,</para>
  <para style="q1" vid="ZEP 1:12">Nfubire abantu abarikugira omu mitima yaabo</para>
  <para style="q1" vid="ZEP 1:12">Bati: MUKAMA tarikora kurungi,</para>
  <para style="q1" vid="ZEP 1:12">n'obu kwakuba okukora kubi.<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 5:11">Amo 5:11</ref>; <ref loc="MIC 6:15">Mik 6:15</ref>. </char>
    </note> Ebintu byabo biryanyagwa,</para>
  <para style="q1" vid="ZEP 1:13">N'amaju gaabo gacwekyerezibwe.</para>
  <para style="q1" vid="ZEP 1:13">N'obu baraayombekye amaju,</para>
  <para style="q1" vid="ZEP 1:13">Kwonka tibarigaraaramu;</para>
  <para style="q1" vid="ZEP 1:13">N'obu baraabyare emizaabibu,</para>
  <para style="q1" vid="ZEP 1:13">Kwonka tibarinywa viinyo yaayo.<verse eid="ZEP 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:14: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 7:7">Ezk 7:7</ref>, <ref loc="EZK 7:12">12</ref>. </char>
    </note> Eizooba rya MUKAMA erikuru riri haihi;</para>
  <para style="q1" vid="ZEP 1:14">Riri haihi, kandi nirirahuka munonga;</para>
  <para style="q1" vid="ZEP 1:14">Nimuhurire! Eizooba rya MUKAMA!</para>
  <para style="q1" vid="ZEP 1:14">Emanzi neetakirayo munonga.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:15">Yoel 1:15</ref>; <ref loc="JOL 2:2">2:2</ref>. </char>
    </note> Eryo izooba n'eizooba ry'ekiniga,</para>
  <para style="q1" vid="ZEP 1:15">Ery'enaku n'obusaasi,</para>
  <para style="q1" vid="ZEP 1:15">Ery'okucwekyereza n'okumariraho kimwe,</para>
  <para style="q1" vid="ZEP 1:15">Ery'ekibunda n'omwirima,</para>
  <para style="q1" vid="ZEP 1:15">Ery'ebicu n'omwirima ndindindi,<verse eid="ZEP 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 1:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:16: </char>
      <char style="xt" closed="false">
        <ref loc="JER 4:19">Yer 4:19</ref>. </char>
    </note> Ery'okuteera enzamba y'akasirikiriro n'enduuru y'orugamba,</para>
  <para style="q1" vid="ZEP 1:16">Kurwanisa endembo ezeehinguririziibwe engo z'amabaare</para>
  <para style="q1" vid="ZEP 1:16">N'eminaara miraingwa.<verse eid="ZEP 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:17: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:29">Bir 28:29</ref>; <ref loc="PSA 79:3">Zab 79:3</ref>; <ref loc="PSA 83:10">83:10</ref>. </char>
    </note> Ndyareetera abantu okweshobera,</para>
  <para style="q1" vid="ZEP 1:17">Babandagire nk'empumi;</para>
  <para style="q1" vid="ZEP 1:17">Ahabw'okuba bakacumura ahari MUKAMA,</para>
  <para style="q1" vid="ZEP 1:17">Eshagama yaabo eryasheeshwa nk'omucuucu,</para>
  <para style="q1" vid="ZEP 1:17">n'emibiri yaabo enagwe nk'amazi.<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 7:19">Ezk 7:19</ref>; <ref loc="EZK 36:5">36:5</ref>. </char>
    </note> Efeeza zaabo, n'obu zaakuba ezaabu zaabo,</para>
  <para style="q1" vid="ZEP 1:18">Tiziribaasa kubajuna aha izooba ry'ekiniga kya MUKAMA.</para>
  <para style="q1" vid="ZEP 1:18">Kureka ensi yoona eryamarwaho</para>
  <para style="q1" vid="ZEP 1:18">Omuriro gw'eihato ry'ekiniga kye;</para>
  <para style="q1" vid="ZEP 1:18">Eego, aryamariraho kimwe</para>
  <para style="q1" vid="ZEP 1:18">Abatwire omu nsi boona kitaraariire.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s1">Abantu okwehanangirizibwa kweteisa</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:15">Yer 6:15</ref>. </char>
    </note> Imwe ihanga ritaine kashoni 'mwe,</para>
  <para style="q1" vid="ZEP 2:1">Nimwije, muteeranire hamwe,<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:2: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 23:26">2 Bag 23:26</ref>. </char>
    </note> Mutakabingirwe</para>
  <para style="q1" vid="ZEP 2:2">Nk'ebishushunga ebirikutuntumuka,</para>
  <para style="q1" vid="ZEP 2:2">Mutakahikirweho kiniga kya MUKAMA ekingi,</para>
  <para style="q1" vid="ZEP 2:2">Mutakahikirweho izooba ry'ekiniga kya MUKAMA.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 76:9">Zab 76:9</ref>; <ref loc="ISA 26:20">Isa 26:20</ref>; <ref loc="AMO 5:6">Amo 5:6</ref>, <ref loc="AMO 5:14">14</ref>, <ref loc="AMO 5:15">15</ref>. </char>
    </note> Imwe abacureezi b'omu nsi mwena,</para>
  <para style="q1" vid="ZEP 2:3">Abakora ebi MUKAMA aragiira,</para>
  <para style="q1" vid="ZEP 2:3">Nimumusherure;</para>
  <para style="q1" vid="ZEP 2:3">Kandi musherure okuhikiirira n'obucureezi;</para>
  <para style="q1" vid="ZEP 2:3">Obundi mukaasherekwa aha izooba ry'ekiniga kya MUKAMA.<verse eid="ZEP 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:4: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 1:6-8">Amo 1:6-8</ref>. </char>
    </note> Ahabw'okuba Gaaza eryatsigwaho,</para>
  <para style="q1" vid="ZEP 2:4">Ashikelooni ehindukye amatongo,</para>
  <para style="q1" vid="ZEP 2:4">Ab'omuri Ashidoodi babingwe omu ihangwe,</para>
  <para style="q1" vid="ZEP 2:4">Na Ekurooni erandurwe.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 13:3">Yos 13:3</ref>; <ref loc="EZK 25:16">Ezk 25:16</ref>. </char>
    </note> Imwe ihanga ry'Abakeresi 'mwe,</para>
  <para style="q1" vid="ZEP 2:5">Abatwire aha rubaju rw'enyanja, muryakareeba!</para>
  <para style="q1" vid="ZEP 2:5">Imwe Abanyakanaani, ensi y'Abafilistia,</para>
  <para style="q1" vid="ZEP 2:5">Ekigambo kya MUKAMA kiryabarwanisa.</para>
  <para style="q1" vid="ZEP 2:5">Ndyabacwekyereza okuhitsya obu hatarigira</para>
  <para style="q1" vid="ZEP 2:5">Mutuuzi weena owaatsigaraho.<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />Kandi ezo mbaju z'enyanja ziryaba amariisizo,</para>
  <para style="q1" vid="ZEP 2:6">Amaka g'abariisa n'ag'amasyo g'entaama,<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 10:3">Zek 10:3</ref>; <ref loc="LUK 1:68">Luk 1:68</ref>. </char>
    </note> Zibe ez'ab'enju ya Yuda,</para>
  <para style="q1" vid="ZEP 2:7">Abariba batsigaireho, baziriisizemu,</para>
  <para style="q1" vid="ZEP 2:7">Kandi omu maju g'omuri Ashikelooni</para>
  <para style="q1" vid="ZEP 2:7">Nimwo baribyama omu mwabazyo;</para>
  <para style="q1" vid="ZEP 2:7">Ahakuba MUKAMA Ruhanga waabo aryabataho omutima,</para>
  <para style="q1" vid="ZEP 2:7">Abaihe omu bukwatwa, abagarure.<verse eid="ZEP 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8: </char>
      <char style="xt" closed="false">
        <ref loc="JER 48:27">Yer 48:27</ref>; <ref loc="EZK 25:3">Ezk 25:3</ref>, <ref loc="EZK 25:6">6</ref>. </char>
    </note> MUKAMA ow'amahe, Ruhanga wa Israeli naagira ati:</para>
  <para style="q1" vid="ZEP 2:8">Nkahurira ebigaaniizo bya Moabu</para>
  <para style="q1" vid="ZEP 2:8">N'ebijumo by'Abaamoni,</para>
  <para style="q1" vid="ZEP 2:8">Oku baagaaniirize abantu bangye,</para>
  <para style="q1" vid="ZEP 2:8">Bakeehimbisa ku barikwija kuteera ensi yaabo.<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 29:23">Bir 29:23</ref>. </char>
    </note> N'ahabw'ekyo niinyerahira nti:</para>
  <para style="q1" vid="ZEP 2:9">Buzimazima Moabu eryaba nka Sodoma</para>
  <para style="q1" vid="ZEP 2:9">N'Abaamoni babe nka Gomora,</para>
  <para style="q1" vid="ZEP 2:9">Ensi emazirweho ebicuragyenyi n'ebiina by'omwonyo,</para>
  <para style="q1" vid="ZEP 2:9">Ebeere kimwe amatongo ebiro byona.</para>
  <para style="q1" vid="ZEP 2:9">Abantu bangye abaritsigaraho baryabanyaga,</para>
  <para style="q1" vid="ZEP 2:9">N'ab'eihanga ryangye abarihonokaho baryabakubuura.<verse eid="ZEP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 16:6">Isa 16:6</ref>. </char>
    </note> Ebyo nibyo barizimuurirwa ahabw'amaryo gaabo,</para>
  <para style="q1" vid="ZEP 2:10">ahabw'okuba bakateerera enaku abantu ba MUKAMA ow'amahe,</para>
  <para style="q1" vid="ZEP 2:10">Baabeesiimirana.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Zab 22:27</ref>; <ref loc="MAL 1:11">Mal 1:11</ref>. </char>
    </note> MUKAMA aryabarwanisa omu muringo gurikutiinisa;</para>
  <para style="q1" vid="ZEP 2:11">Eego, baaruhanga b'ensi boona aryabahorootsa,</para>
  <para style="q1" vid="ZEP 2:11">Kandi abantu baryamuramya,</para>
  <para style="q1" vid="ZEP 2:11">Buri muntu amuramize ei ari,</para>
  <para style="q1" vid="ZEP 2:11">Nangwa n'ab'omu nsi zoona ez'amahanga.<verse eid="ZEP 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />Naimwe Abanyesiopia,</para>
  <para style="q1" vid="ZEP 2:12">Muryaitwa rurara yangye;<verse eid="ZEP 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 10:12">Isa 10:12</ref>; <ref loc="NAM 3:7">Nah 3:7</ref>. </char>
    </note> Kandi aryabanga omukono gwe kurwanisa obukiizi-bwa-bumosho,</para>
  <para style="q1" vid="ZEP 2:13">Acwekyereze Asiria,</para>
  <para style="q1" vid="ZEP 2:13">Ahindure Nineeve amatongo,</para>
  <para style="q1" vid="ZEP 2:13">Ebe ensi ekarangataine nk'eihamba ry'omusheenyi.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:14: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:11">Isa 34:11</ref>, <ref loc="ISA 34:13">13</ref>, <ref loc="ISA 34:14">14</ref>; <ref loc="JER 22:14">Yer 22:14</ref>, <ref loc="JER 22:15">15</ref>. </char>
    </note> Kandi amasyo g'ente garyagibyamamu,</para>
  <para style="q1" vid="ZEP 2:14">N'enyamaishwa zoona ez'omu ishwa,</para>
  <para style="q1" vid="ZEP 2:14">Ebihuhura-bahuta n'ebinyogote</para>
  <para style="q1" vid="ZEP 2:14">Biryatuura omu bisheenyuka by'enyomyo zaayo,</para>
  <para style="q1" vid="ZEP 2:14">Ebihihizi bihihirire omu madirisha gaayo,</para>
  <para style="q1" vid="ZEP 2:14">N'ebikoona bigambire omu bisasi by'amaju gaayo;</para>
  <para style="q1" vid="ZEP 2:14">Ahakuba embaaho zaayo z'emyereezi ziryashuuruurwa.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:15: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 47:8">Isa 47:8</ref>; <ref loc="JER 19:8">Yer 19:8</ref>; <ref loc="NAM 3:19">Nah 3:19</ref>. </char>
    </note> Oru nirwo rurembo ruri orwabaire rutwire buhooro,</para>
  <para style="q1" vid="ZEP 2:15">Nirwehimbisa, nirwegira ruti:</para>
  <para style="q1" vid="ZEP 2:15">Niinye ndiho, tihariho ondiijo.</para>
  <para style="q1" vid="ZEP 2:15">Mbwenu ka ruhindukire amatongo,</para>
  <para style="q1" vid="ZEP 2:15">Rukaba oburaaro bw'enyamaishwa!</para>
  <para style="q1" vid="ZEP 2:15">Orikururabaho weena</para>
  <para style="q1" vid="ZEP 2:15">Naayeshaanya, aruha mutinzi.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s1">Obugomi bwa Yerusaalemu na Yuda</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:6">Yer 6:6</ref>. </char>
    </note> Orurembo orurikuhata, orugomi,</para>
  <para style="q1" vid="ZEP 3:1">Kandi orusiisikaire, ruryakareeba!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:2: </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:3">Yer 5:3</ref>. </char>
    </note> Tirurikuhurira iraka,</para>
  <para style="q1" vid="ZEP 3:2">Tirurikwenda kuhanwa,</para>
  <para style="q1" vid="ZEP 3:2">Tirurikwirira haihi Ruhanga waarwo.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:3: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 22:27">Ezk 22:27</ref>. </char>
    </note> Abategyeki baamwo n'entare ezirikutsinda,</para>
  <para style="q1" vid="ZEP 3:3">Abaramuzi baarwo n'emishega y'omu mwabazyo</para>
  <para style="q1" vid="ZEP 3:3">Etagira ki etsiga okuhitsya omu kasheeshe;<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 22:26">Ezk 22:26</ref>. </char>
    </note> Baanabi baarwo n'abantu batyo</para>
  <para style="q1" vid="ZEP 3:4">Abatarikwesigwa;</para>
  <para style="q1" vid="ZEP 3:4">Abanyamurwa baarwo nibashiisha ekyetwa ekirikwera kyona,</para>
  <para style="q1" vid="ZEP 3:4">Nibashiisha nkana Ebiragiro.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:5: </char>
      <char style="xt" closed="false">
        <ref loc="JER 12:1">Yer 12:1</ref>; <ref loc="HOS 6:5">Hos 6:5</ref>. </char>
    </note> MUKAMA ori ahagati yaarwo n'ohikiriire,</para>
  <para style="q1" vid="ZEP 3:5">Takora kubi;</para>
  <para style="q1" vid="ZEP 3:5">Buri kasheeshe areeta eby'oburyo bye omu mushana,</para>
  <para style="q1" vid="ZEP 3:5">Tayosha;</para>
  <para style="q1" vid="ZEP 3:5">Kwonka otahikiriire tagira kashoni.<verse eid="ZEP 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="ZEP 2:4-15">Zef 2:4-15</ref>; <ref loc="ZEC 7:14">Zek 7:14</ref>. </char>
    </note> Mmazireho amahanga,</para>
  <para style="q1" vid="ZEP 3:6">Eminaara yaago n'ebisheenyuka;</para>
  <para style="q1" vid="ZEP 3:6">Nyitiire kimwe enguuto zaago,</para>
  <para style="q1" vid="ZEP 3:6">Ngu hatagira owaazirabamu;</para>
  <para style="q1" vid="ZEP 3:6">Endembo zaago zihindukire amatongo,</para>
  <para style="q1" vid="ZEP 3:6">Zaabura omuntu, zaabura n'ow'okuzituuramu.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 7:3">Mik 7:3</ref>. </char>
    </note> Naagira nti: Buzimazima ruryantiina,</para>
  <para style="q1" vid="ZEP 3:7">Rwikirize kuhanwa,</para>
  <para style="q1" vid="ZEP 3:7">Rurekye kwehuzya</para>
  <para style="q1" vid="ZEP 3:7">Ebi naaruragiire byona.</para>
  <para style="q1" vid="ZEP 3:7">Kwonka abarutwiremu baayeyongyera kwezirika</para>
  <para style="q1" vid="ZEP 3:7">Kushiisha omu kukora kwabo kwona.<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 3:2">Yoel 3:2</ref>; <ref loc="HAB 2:3">Hab 2:3</ref>; <ref loc="ZEP 1:18">Zef 1:18</ref>. </char>
    </note> MUKAMA naagira ati: N'ahabw'ekyo muntegyereze,</para>
  <para style="q1" vid="ZEP 3:8">Okuhitsya aha izooba eri ndiimukiraho ndi mushinja;</para>
  <para style="q1" vid="ZEP 3:8">Ahabw'okuba mmaririire kuteeranira hamwe</para>
  <para style="q1" vid="ZEP 3:8">Amahanga n'obugabe butari bumwe,</para>
  <para style="q1" vid="ZEP 3:8">Mbone kubishukaho ekiniga kyangye</para>
  <para style="q1" vid="ZEP 3:8">N'okuguubwa kubi kwangye kwona,</para>
  <para style="q1" vid="ZEP 3:8">Ahakuba ensi yoona eryamarwaho</para>
  <para style="q1" vid="ZEP 3:8">Omuriro gw'eihato ry'ekiniga kyangye.<verse eid="ZEP 3:8" /></para>
  <para style="s1">Oku Ruhanga ari ahagati y'abantu be kubajuna</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 6:5">Isa 6:5</ref>; <ref loc="ISA 19:18">19:18</ref>. </char>
    </note> Eego, omuri obwo bunaku ndyahindura engambo y'amahanga,</para>
  <para style="q1" vid="ZEP 3:9">Ebe engambo nungi,</para>
  <para style="q1" vid="ZEP 3:9">Ab'omuri ago mahanga boona</para>
  <para style="q1" vid="ZEP 3:9">Babone kutakira eiziina rya MUKAMA</para>
  <para style="q1" vid="ZEP 3:9">N'okumuheereza n'omutima gumwe.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:31">Zab 68:31</ref>; <ref loc="ISA 60:4">Isa 60:4</ref>. </char>
    </note> Abariinyeshengyereza nibo bantu bangye abaataataine;</para>
  <para style="q1" vid="ZEP 3:10">Baryandeetera empongano, nibagiiha seeri y'emigyera ya Esiopia.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:11">Isa 2:11</ref>; <ref loc="MAL 4:1">Mal 4:1</ref>; <ref loc="MAT 3:9">Mat 3:9</ref>. </char>
    </note> Iwe Israeli, eryo izooba torikwatwa nshoni</para>
  <para style="q1" vid="ZEP 3:11">Ahabw'ebi waakozire nongomera;</para>
  <para style="q1" vid="ZEP 3:11">Ahabw'okuba obwo ndyakwihamu</para>
  <para style="q1" vid="ZEP 3:11">Abanyamaryo baawe abarikwehimbisa;</para>
  <para style="q1" vid="ZEP 3:11">Kandi torigaruka kwekunikira</para>
  <para style="q1" vid="ZEP 3:11">Ha rushozi rwangye orurikwera.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:32">Isa 14:32</ref>. </char>
    </note> Ahakuba ndyakutsigamu</para>
  <para style="q1" vid="ZEP 3:12">Abantu abacureezi kandi abatarikwetunguura;</para>
  <para style="q1" vid="ZEP 3:12">Baryasherura obuhungiro omu iziina rya MUKAMA.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 60:21">Isa 60:21</ref>; <ref loc="MIC 5:4">Mik 5:4</ref>; <ref loc="REV 14:5">Kush 14:5</ref>. </char>
    </note> Kandi abaritsigara omuri Israeli tibarikora kubi,</para>
  <para style="q1" vid="ZEP 3:13">N'obu kwakuba okugamba ebishuba,</para>
  <para style="q1" vid="ZEP 3:13">N'orurimi rw'obugobya</para>
  <para style="q1" vid="ZEP 3:13">Tirurishangwa mu kanwa kaabo;</para>
  <para style="q1" vid="ZEP 3:13">Ahakuba baryarya, babyame</para>
  <para style="q1" vid="ZEP 3:13">Hataine orikubatiinisa.<verse eid="ZEP 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:14: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 12:6">Isa 12:6</ref>; <ref loc="ISA 54:1">54:1</ref>; <ref loc="ZEC 9:9">Zek 9:9</ref>. </char>
    </note> Iwe Saayuuni, yeshongore munonga;</para>
  <para style="q1" vid="ZEP 3:14">Iwe Israeli, teera akaari!</para>
  <para style="q1" vid="ZEP 3:14">Naiwe Yerusaalemu, shemererwa,</para>
  <para style="q1" vid="ZEP 3:14">Oyesiime n'omutima gwawe gwona!<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:5">Zab 46:5</ref>; <ref loc="ZEC 2:10">Zek 2:10</ref>; <ref loc="MAT 27:42">Mat 27:42</ref>; <ref loc="JHN 1:49">Yoh 1:49</ref>; <ref loc="REV 21:3">Kush 21:3</ref>. </char>
    </note> MUKAMA akwihireho emanja ezi obaire oine,</para>
  <para style="q1" vid="ZEP 3:15">N'abazigu baawe yaabanaga aheeru.</para>
  <para style="q1" vid="ZEP 3:15">Omugabe wa Israeli, MUKAMA, ari ahagati yaawe;</para>
  <para style="q1" vid="ZEP 3:15">Torigaruka kutiina kabi bundi.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 35:3">Isa 35:3</ref>. </char>
    </note> Eryo izooba baryagira Yerusaalemu bati:</para>
  <para style="q1" vid="ZEP 3:16">Iwe Saayuuni 'we, otatiina,</para>
  <para style="q1" vid="ZEP 3:16">Emikono yaawe etatentebuka.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:17: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 62:5">Isa 62:5</ref>; <ref loc="ISA 63:1">63:1</ref>. </char>
    </note> MUKAMA Ruhanga waawe ari ahagati yaawe,</para>
  <para style="q1" vid="ZEP 3:17">Emanzi erikujuna.</para>
  <para style="q1" vid="ZEP 3:17">Aryakushemerererwa, aine obunanukye,</para>
  <para style="q1" vid="ZEP 3:17">Aryakushemerererwa, naayeshongora</para>
  <para style="q1" vid="ZEP 3:17">Nk'aha izooba ry'obugyenyi.<verse eid="ZEP 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:18: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 1:4">Tonz 1:4</ref>; <ref loc="LAM 2:6">2:6</ref>. </char>
    </note> MUKAMA naagira ati:</para>
  <para style="q1" vid="ZEP 3:18">Ndyakwihaho akabi,</para>
  <para style="q1" vid="ZEP 3:18">Karekye kukujumisa.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:19: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 60:14">Isa 60:14</ref>; <ref loc="JER 13:11">Yer 13:11</ref>; <ref loc="MIC 4:6">Mik 4:6</ref>. </char>
    </note> Reeba, omuri obwo bunaku</para>
  <para style="q1" vid="ZEP 3:19">Ndyaitana n'abarikukuhata boona.</para>
  <para style="q1" vid="ZEP 3:19">Ndyakiza abarema,</para>
  <para style="q1" vid="ZEP 3:19">Ntaaruure encuubwa;</para>
  <para style="q1" vid="ZEP 3:19">Kandi abaabaire bahemukiire omu nsi yoona</para>
  <para style="q1" vid="ZEP 3:19">Ndyabaha okugambwa gye n'eiziina rirungi.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:20: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 11:17">Ezk 11:17</ref>; <ref loc="ZEP 2:7">Zef 2:7</ref>. </char>
    </note> Ndyabagarura owaanyu omu bunaku</para>
  <para style="q1" vid="ZEP 3:20">Obu ndibataaruuriramu;</para>
  <para style="q1" vid="ZEP 3:20">Ahakuba ku ndigarura abantu baanyu</para>
  <para style="q1" vid="ZEP 3:20">Abatwairwe omu bukwatwa nimureeba,</para>
  <para style="q1" vid="ZEP 3:20">Ndyabaha eiziina rirungi n'okuhimbisibwa</para>
  <para style="q1" vid="ZEP 3:20">Omu mahanga goona ag'omu nsi;</para>
  <para style="m" vid="ZEP 3:20">nikwo MUKAMA arikugira.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>