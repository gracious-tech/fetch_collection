<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">-Kamano-Kafe</book>
  <para style="h">Mak</para>
  <para style="mt1">Mak</para>
  <para style="mt2">Knare Musenke Maki Kre'nea Naneke</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s">Ti frezmante Joni eri'zamofo naneke</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Jon 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Hagi Anumzamofo Mofavre Jisas Kraisi Knare Musenkea ama agafa hu'ne.<verse eid="MRK 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2"/>Kasnampa ne' Aisaia'a amanage huno avona krentene, <char style="bdit">Antahiho, nagra huntanenkeno nagri naneke erino ome huamahu ne'mo'a ugagota kagrira huganteno, kana retro hugahie. </char> <verse eid="MRK 1:2"/><verse number="3" style="v" sid="MRK 1:3"/><char style="bdit">Ka'ma kopinti mago'mofo agerumo amanage huno kezanetie, ramofo kana retro nehutma, kama vania kana erinte fatgo hiho. </char><verse eid="MRK 1:3"/></para>
  <para style="r">(<ref loc="ISA 40:3">Ais 40:3</ref>; <ref loc="MAL 3:1">Mal 3:1</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Ka'ma mopafinti mono ti frezmante Joni'a eama nehuno, agafa huno kumi'zmigu zamagu'ama rukrahe hanageno apasezmante mono tima fresaza'zanku huama huno zamasmi'ne. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Maka Judia kazigati vahe'mo'zane Jerusaleti'ene, agrite maka'mo'za vu'za huama kumizmia ome hazageno, Jodani timpina mono tina frezmante'ne. <verse eid="MRK 1:5"/><verse number="6" style="v" sid="MRK 1:6"/>Hagi Joni'a kemori azokate tro hu'nea anakre ku'a hu'neno, zagagafa akruteti tro hu'nea amu nofi afafafi rugagino hu'neno, kenu'ene afi' tumemofo tima'ane nenea nere. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Hanki mago'ma henkama ne-emo'a nagrira nagetereno hanave'ane ne' neankina, prihu'na aga anomofonte anakinea nofira kazufega osu'noe. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Nagra tintfanu mono tina freneramantoe. Hianagi Agra Ruotge Avamunu, mono tina freramantegahie, huno huama huno zmasamine.<verse eid="MRK 1:8"/></para>
  <para style="s">Joni'a mono ti Jisasina frente'nea naneke</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mat 3:13-4:11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>,<ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Ana knafi Galili kaziga Nazareti kumateti Jisasi'a egeno, Joni'a Jodani timpi mono tina frente'ne. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Timpinti anama Jisasi'a marerino ne-egeno, mona kamo hagro nehigeno Ruotge Avamumo maho namagna huno hareno Agrite emanine. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Monafinti mago agerumo'a amanage hu'ne, Kagra navesimanegantoa mofavre'nimokagina muse hugantoe. <verse eid="MRK 1:11"/><verse number="12" style="v" sid="MRK 1:12"/>Avamumo'a ame huno ka'ma kopi atufegeno vu'ne. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Ka'ma kopina 40'a kna umani'negeno, Sata'a revatga hu'ne. Agra afizaga kfane maninegeno, ankero vahe'mo'za aza hu'naze.<verse eid="MRK 1:13"/></para>
  <para style="s">Jisasi'a Galili kaziga mono eri'za erigafa nehuno, amage'ma antesaza vahezaga zamavare'nea naneke</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat 4:12-22</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Hagi Jonima kina huntageno, Jisasi'a ana knafi Galili vuno Anumzamofo knare so'e naneke huama huno, <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/><char style="wj">Anumzamo'ma huhampri'nea kna hago eforehie. Anumzamofo kumamo'a hago eravao hie. Tamagu'a rukrahe huta Knare Musenkere tamentinti hiho.</char><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Galili timofo ankenare Jisasi'a nevuno Saimoni'ene Endrukea, koganararemoke, kuko timpi netrakeno ome znagene. Na'ankure zanagra nozame ahe ne'trene. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Jisasi'a anage huno znasami'ne, <char style="wj">Enamage antenkena, Nagra vahe'ma avazu hu'zana huranami'neno.</char> <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Higeke ame huke kuko zani'a netre'ne amage anteke vu'na'e. <verse eid="MRK 1:18"/><verse number="19" style="v" sid="MRK 1:19"/>Ananteti Jisasi'a mago'ene osi'a nevuno, Jemisi'a Zebeti nemofokino nefu'ene votifi mani'ne'za kukozamia nehatizageno ome zamage'ne. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>Neznageno zanagi higeke, neznafa Zebetine eri'za vahe'a ana votifi nezmatreke ame huke amage eme ante'ne vu'na'e.<verse eid="MRK 1:20"/></para>
  <para style="s">Jisasi'a havi avamu hu megi atre'nea naneke</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Hagi zamagrama Kapaneam kumate'ma umahanatite'za, mani fruhu knama egeno'a ame huno Jisasi'a osi mono nompi vuno rempi ome huzami'ne. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Vahe zagamo'za tusiza hu'za rempima huzamia zankura antri hu'naze. Na'ankure kasegere ugagota hu'naza vahe'mo'za nehazaza osu'neanki, hanave'ane agi me'nea vahe'mo rempi hu'nezamiankna hu'ne. <verse eid="MRK 1:22"/><verse number="23" style="v" sid="MRK 1:23"/>Anama nehigeno'a mago'mofona agu'afi havi avamu fre'nea ne'mo osi mono nompinti kezatino, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>Nazareti Jisasiga na'a hurantenaku nehane? Tagri tazeri haviza hunaku neampi? Nagra antahi'noe, Kagra Anumzamofona Ruotge hunamoke. <verse eid="MRK 1:24"/><verse number="25" style="v" sid="MRK 1:25"/>Hianagi Jisasi'a kesuno, <char style="wj">Taganenka atrenka atiramio!</char> <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>Ana havi avamumo'a azeri hirahi hirahi nehuno, tusiza huno krafage nehuno ana ne' agu'afinti atiramino evu'ne. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Ana'ma hige'za vahe'mo'za tusiza hu'za zmagogogu nehu'za, ontahige antahige hu'za, amazana na'a fore nehie, kahefaza hanave'ane rempi nehuno, havi avamumofona kea higeno ke'a amagenente. <verse eid="MRK 1:27"/><verse number="28" style="v" sid="MRK 1:28"/>Anama hiazamofo agenkemo'a maka Galili kaziga ame huno vuno eno hu'ne.<verse eid="MRK 1:28"/></para>
  <para style="s">Pita nenemo Jisasi'a azeri knamare'nea naneke</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Hanki osi mono nompinti' atirami'za Saimonine Endru kizini nonte Jemisi'ene Joniza vu'za umareri'naze. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Hagi Saimoni nenaro nerera'a avufa amuhohu kri erino maseno maninegeno, Jisasina krima eri'nea kea ame hu'za ome asami'naze. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Anama hige'za ana a'te vuno azante ome azeriotigeno, avufgama tevehama nehiazamo'a atrentegeno, otino ne'za krezamante'ne.<verse eid="MRK 1:31"/></para>
  <para style="s">Jisasi'a hakare kri vahe' zamazeri knamarenea naneke</para>
  <para style="r">(<ref loc="MAT 8:16-17">Mat 8:16-17</ref>; <ref loc="LUK 4:40-41">Luk 4:40-41</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Hagi zagea uramino kinagasegeno, vahe'zagamo'za krima eri'naza vahe'ene, havi avamu'mo'ma zamagu'afi mani'nea vahera zamavare'za Jisasinte e'naze. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Ana rankumate vahe'mo'za ana kasante eme eritru huvagare'naze. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Ana nehazageno rama'a ruzahu ruzahu krima eri'naza vahera zamazeri so'e nehuno, havi avamu'mo'zama rama'a zamagu'afi mani'nazana hufegi netreno, ama anazankura kea osiho huno havi avamura i'o huzmante'ne. Na'ankure havi avamumo'za Agrira ke'za antahi'za hu'naze.<verse eid="MRK 1:34"/></para>
  <para style="s">Jisasi'a nunamu nehuno rempi huzami'nea naneke</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Hagi kotu hanimpi Jisasi'a ana nompinti atiramino vuno vahe omani'afi umani'neno, anantega nunamu hu'ne. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Hagi Saimoni ene mago'amo'za oti'za hake'naze. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Hagi ome age'za erifore nehu'za, mika vahe'mo'za kagriku nehakraze hu'za asami'naze. <verse eid="MRK 1:37"/><verse number="38" style="v" sid="MRK 1:38"/>Anage huno Agra kenona zamirera zamasmi'ne, <char style="wj">Erinketa tava'onte'ma me'nea kumatamimpi vuta, anantega mono kea huama haneno. Na'ankure Nagra e'ina agafare e'noe. </char> <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Anage nehuno maka Galili kaziga vano nehuno, osi mono nontamimpi mono naneke huama nehuno, havi avamutmina zamagu'afima freneana hufegi atrezmante'ne.<verse eid="MRK 1:39"/></para>
  <para style="s">Jisasi'a fugo namune ne' azeri so'e hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Hagi mago fugo namurenea ne'mo Jisasinte eno kepri huno agiafi traka humaseno, Muse hugantoanki Kagrama nazeri knamrenaku hanunka, amne nazeri agru huo, huno antahigene. <verse eid="MRK 1:40"/><verse number="41" style="v" sid="MRK 1:41"/>Higeno Jisasi'a asunku hunenteno, azana asuteno avako nehuno anage hu'ne, <char style="wj">Nagri'ma navesiana knare huo! </char> Higeno, <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>ana fugo namumo'a ame huno vagarentegeno agru hu'ne. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Hanki Jisasi'a amazama hugantoazankura vahera ozamasamio huno hanave avumro nenteno, ame huno hunenteno, <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/><char style="wj">Kama antahio, ama'nazama hugantoa zankura mago'mofona osamitfa huo. Hianagi pristi nete vunka kavufga ome averi hugeno keno. Anante Mosese'ma ko'ma huno kazeri agrumahu ofa ome hugahane hu'nea kante ome hugeno, veamo'za nege'za hago agru hu'ne hu'za hiho. </char> <verse eid="MRK 1:44"/><verse number="45" style="v" sid="MRK 1:45"/>Hianagi ana ne'mo nevuno, kri'ama azeri knamare neazankura vahepi huama nehige'za, rama'a vahe'mo'za nentahizageno, ana kemo'a ra hiazanku, rankumapina Jisasi'a eamara huno omeno, megia rama'a vahera omani'naza kumapi umaninege'za rama'a vahe'mo'za anantega eme ke'naze.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s">Jisasi'a aga stinea ne'ma azeri so'e hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Mago'a kna evutegeno Jisasi'a rukrahe huno Kapaneamu nemania kumate emani'nege'za, Jisasi'ma e'ne kema veamo'za antahi'naze. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Hagi rama'a vahe krerfamo'za atru hu'za nompine kasante'ene mani titipa nehazageno, mono kea zamasmi'ne. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Hagi mago'a vahe'mo'za aga sti'nea ne' avare'za e'naze. Hagi 4'a vahe'mo'za sesenku hu'za erizafa hu'za e'naze. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Zamagra zafahu'za ufrega osu'naze, na'ankure rama'a vahe krefamo'za manihiza hazageno, Jisasi'ma mani'nea avamenteti nomuza eri anasege'za, ana nera sesenkufi mase'nege'za nofite azerineza atrageno akoheno urami'ne. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Anama hazageno'a Jisasi'a avare'za e'namokizmi zamentinti negeno, agama sti'nea nera amanage huno asami'ne, <char style="wj">Ne'nimoka kumika'a apasegantoe. </char> <verse eid="MRK 2:5"/><verse number="6" style="v" sid="MRK 2:6"/>Hianagi anampina mago'a kasegere ugagota hu'naza vahe'mo'za mani'ne'za, anage hu'za zamagu'afina antahi'naze. <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>Na'a higeno ama ne'mo'a kumira atregantoe nehie? Anumzamofo huhaviza hunente! Iza Agra kumira atregantoe nehie, Anumzamoke kumira atrentegahie hu'za antahinaze? <verse eid="MRK 2:7"/><verse number="8" style="v" sid="MRK 2:8"/>E'i anage hu'za zamagesa nentahizageno, Jisasi'a zamagu'afi negeno, ame huno zamasami'ne, <char style="wj">Na'a higetma tamaguafina e'inahu antahintahia nehaze?</char> <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/><char style="wj">Agama sti'nea nera ina'i kema hanua kemo fru huntegahie. Kumi ka'a atregantoe hanua kemopi, ontinka sesenku ka'a erinka vuo hanua kemo fru huntegahio?</char> <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/><char style="wj">Hianagi tamagra antahitama ketma hugahaze. Vahe'mofo Mofavremo'a, ama mopafi vahe'ma kumi'ma atrente hihamua erineankino, kumira atrentegahie.</char> <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/><char style="wj">Nagra hugantoanki otinka sesenkuka'a erinka nonka'arega vuo. </char> <verse eid="MRK 2:11"/><verse number="12" style="v" sid="MRK 2:12"/>Higeno ame huno otino sesenku'a eri kofino mika vahe zamure atiramino vu'ne. Nevige'za mika vahe'mo'za zamagogo fege'za, Anumzamofo agi erisaga nehu'za, e'inahu ruzahu ruzahu avu'ava zana nonkonaza erifore nehie, hu'naze.<verse eid="MRK 2:12"/></para>
  <para style="s">Livaema agi hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Henka ete Jisasi'a Galili tiru ankenarega nevige'za, veamo'za eri hantage'za mani'nerega azageno rempi huzami'ne. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Agra nevuno Alfiasi nemofo agi'a Livae takisi e'neriza osi nompi mani'negeno ome negeno amanage hu'ne, <char style="wj">Eme namage anto</char> higeno otino amage vu'ne.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Hagi Jisasi'ma Livae nompi ne'za ome ne'negeno'a, rama'a takesi zagoma eneriza vahe'mo'zane, kumi vahe'mo'za Jisasi'ene amage'ma nentaza disaipolo naga'ane magopi ne'za ne'naze. Na'ankure rama'a vahe'mo'za Jisasina amagera ante'naze. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Hagi kasegere ugagota hu'naza vahe'ene, Farisi vahe'mo'zama, kazageno kumi vahe'ene takisi zagoma e'neri'za vahe'ene, magopima manineno tine ne'zama nenazageno, na'a higeno takesi e'neri'za vahe'ene kumi vahe'enena magopina ne'zana nene? Hu'za amage'ma nentaza disaipol nagara zmantahige'naze. <verse eid="MRK 2:16"/><verse number="17" style="v" sid="MRK 2:17"/>Jisasi'a ana naneke nentahino amanage huno zamasmi'ne, <char style="wj">Krima e'orinaza vahe'mo'zage tusa vahetera novaze. Hanki krima eri'naza vahe'mo'za tusa vahetera nevaze. Nagra fatgo vahe kehunakura omenoanki, kumi vahe kehuku e'noe.</char><verse eid="MRK 2:17"/></para>
  <para style="s">Ne'zama a'o huzamofo naneke</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Hagi Joni amage'ma nentaza disaipol naga'mo'zane, Farisi mono vahe'mo'za, ne'zana a'o nehaze. Anama hu'naza zanku mago'a vahe'mo'za Jisasinte e'za anage hu'naze. Na'a higeno Joni amage'ma nentaza disaipol vahe'ene Farisi vahe'mo'za ne'za a'o nehazanagi, Kagri kamagema nentaza disaipol vahe'mo'za ne'zana a'o nosaze? <verse eid="MRK 2:18"/><verse number="19" style="v" sid="MRK 2:19"/>Hazageno Jisasi'a anage huno zamasami'ne, <char style="wj">Aravema hunakuma hirema etruma hu'naza naga'mo'za aravema hunaku hu'nesia ne'ma zamagri enema mani'nenige'za ne'zana a'o hugahazafi? Aravema hu'naku hu'nesia ne'ma mani'nenigeno'a, ne'zana a'o osugahaze. </char> <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/><char style="wj">Hianagi mago'a kna ne-eankino, aravema hunaku hania ne'ma avare'za vutesageno, ana knafi ne'zana a'o hugahaze. </char> <verse eid="MRK 2:20"/><verse number="21" style="v" sid="MRK 2:21"/><char style="wj">Hagi mago vahe'mo'e huno atafa kenama tagato hu'nerera kasefa tavravea erinteno ohatigahie. Sese nehanigeno ampimpi nehuno mago'ene ruragato hura hu'zanku anaranosie.</char> <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/><char style="wj">Magore huno vahe'mo'a kahefa wainia, atafa tintafema meme akrute tro huntepina taginonte. Na'ankure wainimo'a ana tafena rutagato hanigeno, wainimo'ene ana tintafemo'enena haviza hugaha'e. Hagino kahefa waini'a kahefa tintafempi tagintegahie. </char><verse eid="MRK 2:22"/></para>
  <para style="s">Mani fruhu knazupa (Sabati) kasege ruhantagi'naza naneke</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Mago mani fruhu knazupa Jisasi'a witi hozafi rukitagino nevigeno, Agri'ma amage'ma nentaza disaipol naga'mo'za mago'a witi eritaniza nene'za vu'naze. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Ana hazageno Farisi vahe'mo'za anage Jisasinkura hu'naze. Ko, na'a hige'za kasegemo mani fruhu knazupa osiho hu'neazana nehaze? <verse eid="MRK 2:24"/><verse number="25" style="v" sid="MRK 2:25"/>Hazageno agra anage huno zamasami'ne, <char style="wj">Devitima mago zupama hu'nea zana tamagra hamprita ontahinazo? Agra'ene magokama vu'naza vahe'mo'za, zamaga'ma atege'za hu'naza zana zanku nehue. </char> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/><char style="wj">Abiatama, ugagota Prisima maninerera, Deviti'ma Anumzamofo nompi ufreno, pristi vahe'moke nenea bretia erino neneno zami'neana, kasegemo'a pristi vahe'mo'zage negahaze hu'nea bretia ne'neazamofo kea ontahineta nehazo?</char> <verse eid="MRK 2:26"/><verse number="27" style="v" sid="MRK 2:27"/>Huteno Jisasi'a anage huno zamasami'ne, <char style="wj">Anumza'mo'ma mani fruhu knama anteneana, vahe'mofo aza hinogu antene. Hagi vahe'mo'za mani fruhu kna aza hanazagura ontene.</char> <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/><char style="wj">Hagi Vahe'mofo Mofavremo'a mani fruhu knamofo ra mani'ne.</char><verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s">Jisasi'a aza sti'nea ne'ma mani fruhu knazupa eri so'e hunte'nea naneke</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Mago'ane Jisasi'a osi mono nompi ufregeno, aza stinea nera anampinka mani'ne. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Hagi vahe'mo'za Jisasi'ma aza stinea ne'ma azeri so'e mani fruhu knazupa hanige'za, keagama Agrira huntesagu zamua antete'za mani'naze. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Hagi Jisasi'a azama sti'nea ne'mofonku anage hu'ne, <char style="wj">Ama vahe'zagamofo zamavuga eme otio!</char> <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Anante Jisasi'a anage huno zamasami'ne, <char style="wj">Mani fruhu knazupa vahe aza hanuna zamo'a kasegefina knare tavutava hugahumpi, havi tavutva hugahune, hifi vahe aza hugahumpi, vahe ahe frigahune?</char> Higeno ke'zamia omane'ne. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Hagi zamarimpamo hanavetia zanku, arimpa henezmanteno keganti kegama huno nezmageno, asunku huno aza sti'nea nera <char style="wj">Kazana rusuto</char> higeno azana rusutegeno, azamo'a so'e hunte'ne. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Anama hige'za Farisi vahe'mo'za ame hu'za atirami'za Heroti naga'ene Jisasima ahe frisnaza naneke ome huge antahige hu'naze.<verse eid="MRK 3:6"/></para>
  <para style="s">Tusi'a vea tinkenarega mani'naza naneke</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Hagi anampinti Jisasi'ene amage'ma nentaza disaipol naga'mo'za atre'za tinkenarega nevazageno, Galiliti'ene Judiati'enena tusi'a vahe krerfamo'za avaririza vu'naze. <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Jerusalemi kumateti'ene, Itumia kuma Jodani timofo kantu kazigati'ene Tairi kumapinti ene Saidoni kuma agu'afinti'ene tusi'a veamo'za Jisasi'ma hiazamofo kema nentahiza, erihantge'za Agrite omeri atru hu'naze. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Hagi tusi'a vahe'ma emetruma hazazanku, amage'ma nentaza disaipol naga'agu mago voti retro hunantenkeno veamo'za naretufe'za omeho huno zmasamine. <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Na'ankure rama'a vahezagama zamazeri so'e hu'negu, krima eri'naza vahe'mo'za Jisasima avako hanageno kri zamimo'a atre zamantesiegu oretufe aretufe hu'naze. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Hagi agru osu havi avamu'mo'za, Jisasi'ma nege'za upri hu'za ranke hu'za, Anumzamofo nemofoge hu'naze. <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>Hianagi ana havi avamukura Jisasi'a huhankavetino, Nagra iza'na mani'noe vahera ozmasamiho huno huzmante'ne.<verse eid="MRK 3:12"/></para>
  <para style="s">12fu'a Aposol naga'a huhampri'nea naneke</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Hagi Jisasi'a agonarega marerino umaniteno, avesi'nea vaheke zamagi hige'za agra mani'nerega e'naze. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Azageno 12fu'a aposol namage'ante nagare huno huhampri zmantene. Agrane mani'ne'nageno huzmantesige'za mono kea huama hanagu huhampri nezmanteno, <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>havi avamu'ma huzmante hihamua zami'ne. <verse eid="MRK 3:15"/><verse number="16" style="v" sid="MRK 3:16"/>Hagi 12fu'a huhamprizmanteno, Saimoninkura Pita'e huno agi'a antemi'ne, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Zebeti mofavre'rarena, Jemisine Joni kizanigura Boaneges'ne, ana agimofona agafa'amo'a mona krafagemofo Mofavre huno znagia ante'ne. <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Hagi Endruki, Filipiki, Vatoromuki, Matiuki Tomasi'e, hanki Arafiasi nemofo agi'a Jemisi'e. Hagi Tatiasiki, mago ne' agi'a Saimoni'a Zelati nagapinti nere. <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>Hanki Judasi Isakariotikino, henka'a Jisasima ha' vahe'amokizmi zamazampi komoru huno avrentesige'za ahesaza nere.<verse eid="MRK 3:19"/></para>
  <para style="s">Jisasinku Belsebuli hanavefi eri'za enerie hu'za hu'naza naneke</para>
  <para style="r">(<ref loc="MAT 12:22-33">Mat 12:22-33</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>; <ref loc="LUK 12:10">Luk 12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Hagi Jisasi'a kumatega ete vige'za, hakare veamo'za eri hantage'za ome atru hazage'za, Jisasi'ene amage'ma nentaza disaipol naga'mo'za ne'za neknazmia omanene. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Ana kema naga'amo'za nentahiza avrenaku vu'naze. Na'ankure zamagra'ma zamagesama antahi'zana hago negi nenegahie hu'za hu'naze. <verse eid="MRK 3:21"/><verse number="22" style="v" sid="MRK 3:22"/>Hagi Jerusaleti erami'naza kasegere ugagota hu'naza vahe'mo'za anage hu'naze. Belsebuli agu'afi fre'negeno, ugagota havi Avamumofo hanavefi, havi avamura hunente hu'naze. <verse eid="MRK 3:22"/><verse number="23" style="v" sid="MRK 3:23"/>Anage nehazageno Jisasi'a nentahino, kehige'za azageno fronka kea anage huno zamasmi'ne, <char style="wj">Inankna huno Sata'a, Satana ahenanti tregahie?</char> <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/><char style="wj">Hagi mago rankumapi vahe'mo'za refko hu'za ha' orente arente hanu'za oti hanave otigahaze.</char> <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/><char style="wj">Hagi mago nompi vahe'mo'za refko'ma hu'za ha' orente arente hanu'za, oti hanave otigahaze.</char> <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/><char style="wj">Hagi Sata'ma otinoma agra'ama ha'ma renenteno, amu'nompinti refko'ma haniana, oti hanave otino vagaregahie. </char> <verse eid="MRK 3:26"/><verse number="27" style="v" sid="MRK 3:27"/><char style="wj">Hianagi mago'mo'e huno hanave ne'mofo nompinti kumzafama asenakura, amane vuno musufa ose'neno, ana nera azerino anaki atreteno, anante noma'afinti'zana enerie.</char><verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>
    <char style="wj">Tamage hu'na neramasmue, Anumzamo'a vahe'mo'za ana miko kumi'ma hanaza zane huhavizama huntesaza kumira apase zamantegahie.</char> <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/><char style="wj">Hianagi Ruotge Avamumofo huhaviza huntesimofona, kumi'a eri atre ontesigeno, kumi'amo'a mevava hugahie.</char> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>Na'ankure zamagra hu'za, Jisasi'a agru osuno havi avamu ene mani'ne hu'za hu'naza kegu hu'ne.<verse eid="MRK 3:30"/></para>
  <para style="s">Tamage naga'agu Jisasi'a hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Hagi anante Jisasi nerera'ene aganahe'zane e'za fegi'a eme oti'neza, ome asaminkeno eno hu'za ke huzmante'naze. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Anante tusi'a vahe'mo'za mani kaginte'nazafi anage hu'za ome asami'naze, antahio, negarera'ene kaganahe'zane kasarahe'za megia mani'ne'za kagriku ke nehaze. <verse eid="MRK 3:32"/><verse number="33" style="v" sid="MRK 3:33"/>Hazageno ana kenona'a amanage huno zamasami'ne, <char style="wj">Iza'za nagri nenrera'ene naganahe'za mani'naze?</char> <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Keganti kegama huno manigagi'naza vea nezmageno anage hu'ne, <char style="wj">Keho, nenrera'ene naganahe'za ama mani'naze.</char> <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Hagi iza'zo Anumzamofo avesizama amage'ma nentamo'za, nenaganaki nensaroki nenreraki hu'za mani'naze.<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s">Avimaza avi rurani'nea fronka naneke</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Mago'ene Jisasi'a rantiru'mofo ankenare mani'neno naneke erigafa huno rempi huzami'ne. Ana nehige'za tusi'a vahe krerfamo'za regorave hazageno, Jisasi'a votifi marerino mani'nege'za, tusi'a vahe krerfamo'za tiru ankenarega mani'naze. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>Ana nehuno agra rama'a fronka ke zamasami'ne. Rempima huzamifina, anage hu'ne, <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/><char style="wj">Kama antahiho! Hoza ne'mo avimaza ruraniku hozarega vu'ne.</char> <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/><char style="wj">Ana'ma huno ome runeranigeno, mago'a avimzamo'a kamofo ankinafi evuramigeno, namamo'za eme ne'naze.</char> <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/><char style="wj">Mago'a avimaza avimo'a havege huno rama'a mopa omanenefi evuramiteno ame huno hagene. Na'ankure havege huno osia mopa me'negeno'e.</char> <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/><char style="wj">Hagi zagemo'a hanatino teosaparene, na'ankure rafu'namo'a fempina uorami'negeno osapare'ne.</char> <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/><char style="wj">Mago'a avimaza avimo'a ave'ave trazampi evuramigeno, aveave trazamo'a hageno, rentrako higeno raga'a reonte'ne.</char> <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/><char style="wj">Hu'neanagi mago'a avimzamo'a tima'ane mopafi evuramiteno hageno raga'a rente'ne. Mago'amo'a 30'a rentegeno, mago'amo'a 60'a rentegeno, mago'amo'a 100'a rente'ne.</char> <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>Ana nehuno anage hu'ne, <char style="wj">Izano agesa me'nenigeno nentahisimofona, atregeno ama kea antahise hino.</char><verse eid="MRK 4:9"/></para>
  <para style="s">Fronka kema zamasmi'nea kemofo agafa'e</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Hagi anama huteno Jisasi'ma Agrake'ma umani'nege'za, mago'a manigagi'naza vahe'mo'zane, 12fu'a amage'ma nentaza disaipol naga'mo'za, ana fronka keramimofo agafa'a antahise hunaku antahige'naze. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Jisasi'a anage huno zamasami'ne, <char style="wj">Anumzamofo kumamofo oku'a antahintahia tamagrira ko tamine. Hianagi megi'ama mani'naza vahe'mo'za fronka kege nentahize.</char> <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/><char style="wj">Ana higu Avontafepina anage hu'ne, <char style="qt">kegahazanagi keama osugahaze. Antahigahazanagi antahi amara osugahaze. Zamagra aru zmagu'a rukrahe hanageno Anumzamo kumizimi eri atrezankure anara hugahie.</char> </char> (Ais 6:9-10) <verse eid="MRK 4:12"/><verse number="13" style="v" sid="MRK 4:13"/>Anante Jisasi'a anage huno zamasami'ne, <char style="wj">Ama fronka kemofo agafa'a antahi ama'ma osanutma, inankna hutma mika fronka kemofo agafa'a antahi amara hugahaze?</char> <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/><char style="wj">Avimaza rurani'nea ne'mo'a, Anumzamofo ke ome krine.</char> <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/><char style="wj">Mago'a avimazama kamofo ankinarega evurami'neana, mago'a vahe'mo'za Anumzamofo kea nentahizageno, Sata'a ame huno zamagu'afima krinea kea eritrene.</char> <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/><char style="wj">Havege mopafima rurani'neana, Anumzamofo kema nentahi'za, muse hu'za ame hu'za eneri'ze.</char> <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/><char style="wj">Hianagi zamagu'afina rafuna ore'neza oti hanave oti'nazankiza, anante'ma Anumzamofo kegu hu'za hazenke zano, zamazeri haviza huzama fore hige'za, ame hu'za atre'za nevaze.</char> <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/><char style="wj">Mago'amo'za ave'ave trazampi avimaza ruranineankna hu'naze. Anamo'za Anumzamofo kea antahinazanagi,</char> <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/><char style="wj">mopafi zankuke zamagesa nentahi'za, zago afu fenoma eri atruma huzamo rezmatga nehuno, mago'azama zamesinte'zamo zamagu'afina efreno Anumzamofo nanekea rentrako higeno ne'za raga'a renonte.</char> <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/><char style="wj">Hianagi tima'ane mopafi rurani'nea avimazana, zamagra Anumzamofo kea antahi ankere'za, ana kea e'neri'za nena raga'a renentaze. Mago'mo'a 30'a rentegeno, mago'mo'a 60'a rentegeno, mago'mo'a 100'a renente. </char><verse eid="MRK 4:20"/></para>
  <para style="s">Tavi'mofo fronka naneke</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Jisasi'a amanage huno mago'ane zamasmi'ne, <char style="wj">Rampe tavi'ma rekruma hazana, sipagampi ome nentafi, kavo agu'afinka ome nentazo? A'o anara nosaze. Rekru hutma tavima rekru hunte azotare ome nentaze.</char> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/><char style="wj">Na'ankure miko'zama fra'ma ki'nesiazamo'a, eama nehanigeno, oku'a me'nesiazamo'a, masare eama hugahie.</char> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/><char style="wj">Izano agesa me'nenigeno nentahisimofona, atregeno ama kea antahise hino. </char> <verse eid="MRK 4:23"/><verse number="24" style="v" sid="MRK 4:24"/>Mago'ane anage huno zamasmi'ne, <char style="wj">Kema nentahizana antahi so'e hiho. Tamagrama amisaza avamente, ana avamente tamagrira neramamino, mago'ane agofetu huno tamamigahie.</char> <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/><char style="wj">Na'ankure iza'o eri'nenimofona mago'ene agofetu huno amigahie. Hagi iza'o e'orinesimofona, osiama eri'nenia zana eritre vagaregahie.</char><verse eid="MRK 4:25"/></para>
  <para style="s">Avimaza hage'zamofo fronka naneke</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Hagi Jisasi'a mago'ane anage hu'ne, <char style="wj">Anumzamofo kumamo'a, mago vahe'mo avimza avi mopafi ruranino kriankna hu'ne.</char> <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/><char style="wj">Kriteno umasenegeno feru ene kenage'enena hageno, ana avimza avimo'a ru hanana huno hagegeno, anama hageana nankna huno hage'neo agra ontahine.</char> <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/><char style="wj">Mopamo'a agra'a azerinena higeno ne'zama'a rente'ne, esera asina reno rampa'a fore huteno, anante amosare aheno, ramparera ne'zana rente avinete.</char> <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/><char style="wj">Anantera raga'a renteno nena hutegeno, agena kazaki kazinteti eme taga hu'ne. Na'ankure hozama hamarekna egeno'e.</char><verse eid="MRK 4:29"/></para>
  <para style="s">Masteti ragamofo fronka naneke</para>
  <para style="r">(Mat 13:31-32,34; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Hagi Jisasi'a mago'ane anage huno zamantahige'ne, <char style="wj">Inankna ke hunteta Anumzamofo kumakura hugahune. Inankna fronka ke hunteta eriama hugahune?</char> <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/><char style="wj">Masteti raga'agna hunege'za mopafi negrize, ama mopafima me'nea avimzana agatereno onensatfa hu'ne.</char> <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/><char style="wj">Hagi kritageno'a hageno nena huno, maka hozafima me'nea ne'zana ra huno agetenereno, rama'a azankuna'a hageno vuno eno higeno, maka afi' namamo'za ana zafamofo tonapi nona eme kigahaze.</char><verse eid="MRK 4:32"/></para>
  <para style="s">Jisasi'a fronka kefinti ke zamasami'nea naneke</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Ana nehuno rama'a fronka kefinti zamagrama antahi ama' hanaza avamente zamasami'ne. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Agra mago'a kema hunakura fronka kefintike zamasmi'ne. Ana hu'neanagi amage'ma nentaza disaipol nagamo'zama zamagrake'ma mani'nageno, eriama huno maka'zana zamasami'ne.<verse eid="MRK 4:34"/></para>
  <para style="s">Jisasi'a ke higeno timo rurava ahe'nea naneke</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Hagi ananzupa kinagasegeno Jisasi'a amage nentaza disaipol naga'agura anage hu'ne, <char style="wj">Erinketa kantu kaziga tinkenare vamneno</char> huno hige'za, <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>vahe krerfa zamatrete'za Jisasi'ma mani'nea votifi mareri'za vazageno, mago'a ventea zamagrane vu'naze. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Nevazageno tusi'a ununko atuno, tina erikranto kranto nehuno, ana votifi timo'a marevite'za higeno, timpi votimo'a tami'za hu'ne. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Hagi Jisasi'a votimofona arigarega fita runo mase'negeza, azeri oti'za anage Agrikura hu'naze. Rempi hurami ne'moka, timo'ma tazeri nakri'za nehiana nonkano? <verse eid="MRK 4:38"/><verse number="39" style="v" sid="MRK 4:39"/>Anante otino zaho'mofona kesuno, <char style="wj">Tami avazago </char> huno timofona higeno, akoheno urami avazagene. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Ana higeno Jisasi'a anage huno zmantahige'ne, <char style="wj">Nahigetma amanahu huta koro nehaze? Tamentintia nosazo?</char> <verse eid="MRK 4:40"/><verse number="41" style="v" sid="MRK 4:41"/>Ana nehige'za zamagra tusi'a zamagogo fege'za, inankna ne'mo kea nehigeno zahomo'ene timokea ke'a antahinezmi'e hu'za hu'naze.<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s">Jisasima negi ne'mofo agu'afinti havi avamu hunte'nea naneke</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Hagi Ventefi vu'za Galili timofo kantu kaziga'a Gerasin uhanati'naze. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Anama Jisasi'a votifinti eneramigeno'a, agru osu havi avamumo agu'afi fre'nea ne'mo'a, ame huno hezamopinti (matipinti) eme tutagiha hunte'ne. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Ana ne'mo vahe asenentea kumapi mani'nege'za, mago vahemo'e huno azerino anaki ontege, seni nofinu anaki onte'ne. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Na'ankure ana ne'mofona azeriza seni nofi'nu azampi kina renentaza aeni agare azantera kina rente'naze. Hianagi ana ne'mo'a azampine agafinema rente'nea nofira rukampruhu osi osi hu'ne. Ana higeno mago vahe'mo'a hanaveti'za azeri arava hugara osu'naze. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Mika zupa hanine, zagene vahe asenentaza kumapine agonaregane vano nehuno, rankege huno, have erino avufa tagarago hu'ne. <verse eid="MRK 5:5"/><verse number="6" style="v" sid="MRK 5:6"/>Jisasi'a afete mani'negeno ana ne'mo negeno, agareno agafi ome renareno, <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>anante ranke huno kezatino, Jisasiga marerisa Anumzamofo Mofavremoka, na'a hurante'za nehane! Nagra Anumzamofo agifi huhanavetina negasamue, tazeri havizana osuo! <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>Na'ankure Jisasi'a havi avamumofonku huno, <char style="wj">Ama ne'pintira atiraminka evuo</char> huno hu'negeno'e! <verse eid="MRK 5:8"/><verse number="9" style="v" sid="MRK 5:9"/>Jisasi'a <char style="wj">Kagi'a iza'e </char> huno antahigegeno? Nagini'a hakarena mani'noe, Na'ankure tagra rama'a sondia vahe mani'none. <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Jisasiga amafintira hurantegeta atreta ovamneno huno kazikazi huno asami'ne.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Hagi agonamofo asoparega rama'a afu'mo'za ne'za nene'za mani'naze. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Ana havi avamumo'za kazigazi hu'za antahige'za, tataregeta antu afutamimofo zamagu'afi uframaneno hu'za hu'naze. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Jisasi'a knareki viho huno ana havi avamutamina huzmantege'za, ana ne'mofo agu'afinti atirami'za, afu'mokizmi zamagu'afi ufre'naze. Ana maka afu'tamina 2 tauseni'a afu'mo'za agonaregati tragi'za uramiza zavaniteti timpi takaure'za ti nakri'za fri'naze.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Anante afu kva vahe'mo'za koro nehu'za, fre'za vu'za rankumate'ene osi kumate'ene ke huganti hugma hu'za vahera zamasmi'naze. Nezmasmige'za ana veamo'za nentahi'za ana'ma hu'neaza kenaku eri hantage'za e'naze. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Jisasinte e'za eme kageno havi avamu'mo'ma agu'afi fre'nea ne'mo'a anante mani'nege'za ke'naze. Kukena nehuno fatgo antahintahi erino mani'nege'za, rama'a havi avamumo agu'afi fre'nea nere nehu'za koro hu'naze. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Hagi ana nete'ma fore'msa nehuno afute'enema fore hu'neazama ke'naza vahe'mo'za onke'naza vahe'mokizmi zamasmi vagarage'za antahi'naze. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Hagi ana vahe'mo'za Jisasinku hankavetiza, ama mopa atreno vanie hu'za hunte'naze. <verse eid="MRK 5:17"/><verse number="18" style="v" sid="MRK 5:18"/>Hagi Jisasi'a votifi marenerigeno havi avamu'mo'ma agu'afi fre'nea ne'mo'a, natregena kagrane va'neno huno antahige'ne. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>Hianagi Jisasi'a nagranena ovugahane nehuno, anage huno asami'ne, <char style="wj">Kumakarega vunka, vahe ka'afi Ramo'ma asunku'ma huganteno, razama so'eza hugante'nea zankura ome zamasamio.</char> <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Anage huno asamigeno atreno Dekapolisi 10ni'e nehaza kumate vuno Jisasi'ma knare huno aza hu'nea nanekea zamasmige'za, maka vahe'mo'za nentahi'za antarintru hu'naze.<verse eid="MRK 5:20"/></para>
  <para style="s">Kva ne'mofo mofa'ene korankri eri'nea a'mofo naneke</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Hagi Jisasi'a ete votifima vuno kantu kaziga Galili tiru ankenare'ma umahanatige'za, hakare veamo'za agrite e'za eme regagi ante'naze. Anama hazazanku Jisasi'a anante mani'ne. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Anante osi mono nonte kva vahe zagafinti mago ne'mofo agi'a Jairusi'e nehaza ne'mo'a, eno Jisasima eme negeno'a, agafi emaseno, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>muse hugantoanki, osi mofa'nimo'a fri'za higena neonki, enka kazana agofetu eme antegeno ofrino manino huno antahige'ne. <verse eid="MRK 5:23"/><verse number="24" style="v" sid="MRK 5:24"/>Higeno Jisasi'a ana ne'ene nevigeno tusi'a vahe krerfamo'za otufe atufe hu'za vu'naze.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Hagi mago ara korankria 12fu'a zage kafufi eri'nea a'mo anampi mani'ne. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Zago afufenoma'a ana krimoma vagarentesigu atrevagareno rama'a tusa vahe'mofo ome miza hu'neanagi, atage'za amizageno ana kri'amo'a vagaore rura hu'ne. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Hagi ana a'mo'a Jisasi agenke antahiteno tusi vea kevufinti, Jisasina amefiti zaza kena'are eme avako hu'ne. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Na'ankure antahintahi afina kukena'are ome avako hanugenoke kri'nimo'a atrenantegahie huno nentahino, <verse eid="MRK 5:28"/><verse number="29" style="v" sid="MRK 5:29"/>ome avako higeno ame huno korankrima eri'neazamo'a atrentegeno keno antahino hu'ne. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Hagi Jisasina mago'a hanave'amo agripinti nevigeno nentahino, ame huno ana vahe kevufinti rukrahe huno anage hu'ne, <char style="wj">Kenani'arera iza avako hu'ne?</char> <verse eid="MRK 5:30"/><verse number="31" style="v" sid="MRK 5:31"/>Higeno Agri amage'ma nentaza disaipol naga'mo'za anage hu'za, mika vahe'mo'za oretufe aretufe hu'nazanki nahigenka, aza navako hu'ne nehane? <verse eid="MRK 5:31"/><verse number="32" style="v" sid="MRK 5:32"/>Hianagi Jisasi'a rukrehe huno keganti kegma huno avako hu'nemofonku hakare'ne. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Nehakregeno ana a'mo'a koro nehuno agu'amo'a fakifaki nehigeno kri'ama amane hu'nea zanku nentahino, avuga kepri huno maka kri'amo vagarenteazana huama huno asami'ne. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Jisasi'a anage huno ana akura hu'ne, <char style="wj">Mofa, kagri ka'a kamentintimo kazeri knare hianki, karimpa frune vugeno krikamo'a atreganteno. </char><verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Anage huno nehigeno'a, osi mono nomofo kva ne' nompinti e'naza vahe'mo'za, Jairusinku hu'za mofa kamo'a hago fri'neanki rempi hurami ne'mofona kna omio. <verse eid="MRK 5:35"/><verse number="36" style="v" sid="MRK 5:36"/>Hianagi anama hazankea Jisasi'a antahi amane nehuno, ana kva nera anage huno asami'ne, <char style="wj">Korora osunka kamentinti huo. </char> <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Nehuno maka vahera maniho hunezmanteno, Pitama Jemisi nefu Joni'ma Jemisima huno zamavarege'za amage ante'za vu'naze. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Zamagrama ana mono kva ne'mofo nontema uhanatiza kazana, ranke hu'za tusi zavi krafa hu'za zavira netageno, Jisasi'a zamage'ne. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Ana nompima unefreno'a, <char style="wj">Na'a higetma ranke hutma zavira netaze, mofavremo'a ofrineanki amane mase'ne.</char> <verse eid="MRK 5:39"/><verse number="40" style="v" sid="MRK 5:40"/>Anagema hiankegura zamagra kiza re'naze. Hianagi miko megi'a huzmantege'za mani'zageno, ana mofa'mofo nererane, nefane nezanevareno amage'ma nentaza disaipol naga'a nezamavareno ana mofa'ma hunaragi antepinka ante'nazafinka ufre'naze. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Anante ana mofamofo azante akoheno aze'nerino <char style="wj">Talita kum!</char> Zamagri'a kefina osi mofa'moka Nagra kagriku huanki otio hu'ne. <verse eid="MRK 5:41"/><verse number="42" style="v" sid="MRK 5:42"/>Ana mofamo'a 12fu'a zagegafu hu'neakino ame huno otino kana vano hige'za tusi antri hu'naze. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Jisasi'a hanavetino ama zankura mago vahere hutma ozmasamiho nehuno, ne'za aminkeno neno huno zamasami'ne.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s">Jisasina Nazareti kuma'are veamo'za zamefi humi'naza naneke</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Hagi Jisasi'a ana kumara netreno kuma'arega ege'za, amage'ma nentaza disaipol naga'mo'za avariri'za e'naze. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Mani fruhu knama (Sabat) egeno'a agafa huno osi mono nompi rempi huzamigeno, rama'a vahe'mo'za antahizamo'za, antri hu'za zmagogogu nehu'za anage hu'naze, igati amanahu antahintahia erine? Iza amanahu knare antahintahizana ami'ne, nankna huno kagu'vazana eri fore nehie? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Ama kapenta ne' Maria mofavrefi? Jemisi'ma Josefema Judasima Saimonikizmi nempu'zimi mani'ne. Hanki asarahe'za tagrane mani'nazafi? Anage nehu'za ha' arente'naze. <verse eid="MRK 6:3"/><verse number="4" style="v" sid="MRK 6:4"/>Anante Jisasi'a anage huno zamasami'ne, <char style="wj">Kasnampa ne'mofona mika vahe'mo'za antahi amiza, ra agi'a amigahazanagi, kuma'are vahe'mo'za antahi nomizageno, naga'amo'zane, noma'afi vahe'mo'zanena antahi omi'naze.</char> <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>Anampina mago'a kaguvazana Agra eri fore osu'neanagi, mago mago kri vahete azanteno zamazeri so'e huzmantetere hu'ne. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Hanki zamentintima osaza'zankura Jisasi'a antahintahi hakare nehuno, mago'a kuma tamimpi vano huno, Agra rempi huzami'ne.<verse eid="MRK 6:6"/></para>
  <para style="s">12fu'a Aposol vahe'ma mono erizante huzmante'nea naneke</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>Hagi Jisasi'a 12fu'a amage nentaza disaipol naga zamagi hige'za ageno, tare tare huno hunezmanteno, agru osu havi avamu humazmante hihamu zami'ne. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>Agra amana hugahaze huno zamasami'ne, <char style="wj">Nevanutama bretine, kutamine, zagonena erinetama oviho, azompage eritma viho. </char> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/><char style="wj">Tamaga ano vazigahazanagi, tare kukena hutma oviho.</char> <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/><char style="wj">Ina nonte'ma vanutma, ana nompinke maninetma ana kumara atretma viho.</char> <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/><char style="wj">Hagi mago kumate nevanage'za oramavrege, naneketimi ontahisagetma zamatreta nevuta, tamagareti kugusopa rupopo hunetretma vinke'za, anazama hanaza zamo'a hazenkefi mani'naze huno zamaveri hino. </char> <verse eid="MRK 6:11"/><verse number="12" style="v" sid="MRK 6:12"/>Ana hige'za amage'ma nentaza disaipol naga'mo'za vu'za, zmagu'a rukrehe hanazegu, mono kea ome huama hu'za mika vahe zmasami'naze. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Ana nehu'za zamagra rama'a havi avamura hunezmante'za, krima eri'naza vahe'mokizimi, masave tagi'za frenezmante'za, zamazeri kanamare'naze.<verse eid="MRK 6:13"/></para>
  <para style="s">Mono ti frezmante Jonima fri'nea naneke</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Hagi kini ne' Heroti'a Jisasi agi agenkemo'a ra higeno nentahige'za, mago'amo'za hu'za mono ti frezmante Joni fri'nefinti oti'negu kagu'vazana nehie hu'naze. <verse eid="MRK 6:14"/><verse number="15" style="v" sid="MRK 6:15"/>Hianagi mago'amo'za Elaiaj'e hu'za nehazageno, mago'amo'za hu'za, agra korapa mani'naza kasnampa vahekna nere hu'naze. <verse eid="MRK 6:15"/><verse number="16" style="v" sid="MRK 6:16"/>Hagi mago'ane Heroti'ma nentahino'a anage hu'ne, Joni agenama akafrinoa ne'mo otino e'negahie! Hu'ne. <verse eid="MRK 6:16"/><verse number="17" style="v" sid="MRK 6:17"/>Na'ankure nefu, Filipi nenaro Herotiasi, Herotima rehanare'nea agenke Jonima huama hu'neazanku, Heroti'a huzmantege'za Jonina ome azeri'za kina nompi ome ante'naze. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Na'ankure Joni'a hanavetino ke huvava huno Herotina asamino, negafu a'ma rehanarenka a'ma erinanana kasege rufutaginka knare avu'avara osu'nane. <verse eid="MRK 6:18"/><verse number="19" style="v" sid="MRK 6:19"/>Ana higeno Herodiasi'a Jonina rimpa ahenteno ahe frinaku hu'ne. Hianagi ahe ofri'ne. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Na'ankure Heroti'a Joninku koro nehuno, kegava krintene. Na'ankure agra antahino keno hu'ne. Joni'a fatgo huno ruotage hu'nea nere. Joni agenke nentahino agogogu hu'neanagi, Jonima hania kema antahinakura muse hu'ne.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Mago kankamu eforema hu'neana, Herotima kasente'nea kna fore higeno, muse huno kasente'nea kna'are ne'za nenaku atru nehu'za, agri nompima eri'zama e'neriza vahe'ene, sondia vahe'mokizimi ugagota kva vahe'ene, Heroti'a ne'zana ne'ne. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Herodiasi mofamo'a efreno avoa eme nehagegeno, Heroti'ene ne'za neku zamagima hu'nea vahe'mo'za muse hu'naze. Ana hazageno Heroti'a ana kasefa mofara asamino, na'ankuro kave'masinia zanku'ma nantahi kesnanke'na, amane kamigahue hu'ne. <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Heroti'a huvempa huno ana mofara asamino, na'ankuro kavesinesia zanku'ma nantahi kesnankena amane negamina, kegavama kri'noa kumara amu'nompintira refko hu'na kamigahue. <verse eid="MRK 6:23"/><verse number="24" style="v" sid="MRK 6:24"/>Anage higeno ana mofa'mo atiramino vuno, nererankura na'ane hu'na ome antahigegahue? Higeno nerera'a anage hu'ne, mono ti frezmante Joni agenope hunka ome huo huno asamigeno, <verse eid="MRK 6:24"/><verse number="25" style="v" sid="MRK 6:25"/>ana mofa'mo'a ame huno Herotinte vuno, menintfa Mono ti frezmante Joni agenopa rukafrinka zuompafi antenka erinka eme namisane huno higeno, <verse eid="MRK 6:25"/><verse number="26" style="v" sid="MRK 6:26"/>Kini ne'mo'a nentahino Joninkura tusiza huno asuragi ante'neanagi, hanave huvempa kema mofa'ama agrane mani'naza vahe zamufi hunte'nea kegu nentahino, i'ora osu'ne. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Hagi kini ne'mo'a ame huno agenama ome akafri vahe huntegeno kina nompi vuno, Joni agena ome akafrine. <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>Ana ne'mo'a agenopa'a zoumpafi erino vuno, ana mofa ome ami'geno, ana mofamo erino vuno nererana ome ami'ne. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Hagi Joni amage'ma nentaza disaipol naga'mo'za ana kema nentahi'za, avufa'a emeri'za havegampi ome asente'naze.<verse eid="MRK 6:29"/></para>
  <para style="s">Jisasi'a 5 tauseni'a venene ne'za zami'nea naneke</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-13">Jon 6:1-13</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Anante Jisasi aposol naga'mo'za, ehanati'za miko'zama nehu'za, vahe'ma rempima hu'zami'naza nanekea eme asami'naze. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Jisasi'a anage huno zamasami'ne, <char style="wj">Nagrane enketa vahe omanitega onsia umanikasa hamneno,</char> (na'ankure vahe'mo'za vute'ete hazageno, ne'zama nesaza knazimi omanenegure.) <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Zamagraku vahe omani kaziga vunaku votifi mareri'za vu'naze. <verse eid="MRK 6:32"/><verse number="33" style="v" sid="MRK 6:33"/>Hianagi zahufama nevazageno, hakare veamo'za e'irega vazanki hu'za nentahi'za, mopafi rugagi'za miko kumapinti veamo'za kote'za anama umanisare, ko umani'naze. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Hagi Jisasi'ma anante uhanitino votifinti'ma takaureno, tusi'a vea kevu nezamageno'a asunku huzmante'ne. Na'ankure zamagra kvazimi omani sipisipigna hu'nazageno agafa huno hakare kea rempi huzami'ne.<verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>Hagi kinaga nesegeno'a amage'ma nentaza disaipol naga'mo'za Jisasinte e'za anage hu'naze, Vahe omani ka'ma kopi mani'nonkeno hago kinaga nesegu, <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>huzmantege'za hozafi kiza mani'naza kumapine, kuma tamimpi vu'za ne'zama nesazazana ome miza seho hu'naze. <verse eid="MRK 6:36"/><verse number="37" style="v" sid="MRK 6:37"/>Hianagi Jisasi'a anage huno zamasami'ne, <char style="wj">Tamagratmi ne'zana zaminke'za neho, </char> hige'za zamagra anage hu'naze, 8'a ikampi eri'za erino miza eriga mizanteti ne'zana mizaseta zamigara hu'ne hu'za asami'naze. <verse eid="MRK 6:37"/><verse number="38" style="v" sid="MRK 6:38"/>Agra anage huno zamasami'ne, <char style="wj">Nama'a breti eri'nazafi ome keho?</char> Huno hige'za ome kete'za e'za 5fu'a bretigi, tare nozame me'ne hu'za hu'naze. <verse eid="MRK 6:38"/><verse number="39" style="v" sid="MRK 6:39"/>Anante Jisasi'a amage'ma nentaza disaipol naga'a huzmanteno, zafa asinage hu'nea apepate huzmantenke'za omeri atru, eme eritru hu'za maniho huno huzmante'ne. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Maka vahe'mo'za refko hu'za mago'a kevufina 100'a vahe nemanizageno, mago'a kevufina 50'a nemanizageno hutere hu'naze. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Mani'nageno 5fu'a bretine, tare noza'ene erino kesga huno monafi negeno, Anumzamofontega susu huteno, eri korino amage'ma nentaza disaipol naga'a veva hanazegu nezamino, nozamea anazanke huno refko huno zami'ne. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Ana maka'mo'za nazageno zamu hu'ne. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Nene'zama atraza bretine, noza enena zogi'za, 12fu'a eka eka kupi eri avite'naze. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Bretima ne'nazana 5tauseni'a venenemo'za ne'naze.<verse eid="MRK 6:44"/></para>
  <para style="s">Jisasi'a timofo agofetu vu'nea naneke</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="JHN 6:15-21">Jon 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Hagi Jisasi'a ame huno amagema nentaza disaipol naga'a votifi vugote'za kantu Betsaida kaziga vihogu huzmantage'za nevazageno, vahetaminkura viho huno huzmante'ne. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Viho huno huso'e huzmanteteno, agonarega nunamu hunaku vu'ne. <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>Kinagama segeno'a votimo'a timofo amunompi nevigeno, Agrake moparera mani'ne. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Jisasi'a nezmagege'za, tusi maraguzati'za azotanu tina vakakiza vu'naze. Na'ankure zahomo tusiza huno eme zamaretunefege'za, maraguzati'za nevazageno ko'ma atu masa hu'za nehigeno, Jisasi'a timofo avozare eno zamagatere'za nehige'za, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>zamagrama timofo agofetu nevigeza nege'za, zamagesama antahi'zana hankrore nehu'za zamagogo nehu'za krafa hu'naze. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Na'ankure makamo'za nege'za zmagogogu hu'naze. Hianagi hantaka huno anage huno zamasami'ne, <char style="wj">Nagragi oti hanavenetita, korora osiho.</char> <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Anage huteno mani'naza ventefi marerigeno, zaho'mo amane nehige'za tusiza hu'za antri hu'naze. <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>Na'ankure bretima tamanasino zami'nea zamofo agafa'a, ke so'e osazageno zamagu'amo hanavetine.<verse eid="MRK 6:52"/></para>
  <para style="s">Jisasi'a Genesareti kaziga kri veamokizmi zamazeri so'e hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Hanki kantu kaziga takahe'za Genesareti mopare uhanati'za, votia kina rentete'za, <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>ana votifinti atineramizageno'a, vahe'mo'za ame hu'za Jisasi'e hu'za keama nehu'za, <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>zamaga re'za vu'za e'za hu'za, ana kazigama me'nea maka kumatamimpinti kri vahetamina sesenku hu'za zamavarente'za, Jisasima mani'ne hu'zama hazankumate vu'naze. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Hagi ina osi kumatero rankumatero, hozafi ki'za mani'naza kumapino, Jisasi'ma virega kri vahera zamavare'za maketi kumapi ome zmantene'za, Knare zamatresanke'za za'za kena kamofo atupare azerigahuno huza antahinege'za, kukena'arema avakoma hazamokizmia kri zamimo'a vagare'ne.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s">Anumzamofo kemo vahe'mofo kea agatere'nea naneke</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Hagi Farisi mono vahe'mo'zane kasegere ugagota hu'naza vahe'mo'za Jerusalemi kumateti' e'za, Jisasinte emeri atru nehu'za, <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Jisasi amage'ma nentaza disaipol nagapinti mago'amo'za zamazana sese osu'za bretia nenage'za ke'naze. <verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>Na'ankure Farisi vahe'ene, mika Jiu vahe'mo'za, zmagehe'mofo zamavu zmavama avaririza, zamazana sese huso'e osune'za ne'zana nonaze. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Hagi maketi kumapinti ne-e'za, zamagra ne'zana onene'za zamazana sese hute'zage ne'zana nenaze. Hagi zamagra rama'a zmagehemofo kasegea eri'naze. Kapuma kavoma tinkavoma nezama anteno ne' zantamima sesehu agruma hute'za, ne'zama ne'zana azenerize. <verse eid="MRK 7:4"/><verse number="5" style="v" sid="MRK 7:5"/>Hagi Farisi vahe'mo'zane, kasegere ugagota hu'naza vahe'mo'za Jisasina antahige'za, Nahige'za kamage'ma nentaza disaipol nagakamo'za tagehe'i avu'avamofo kea amage onte'za, ne'zama nenakura zamazana sese nosaze? <verse eid="MRK 7:5"/><verse number="6" style="v" sid="MRK 7:6"/>Hazageno Jisasi'a anage huno zamasmi'ne, <char style="wj">Aisaia'a fatgo huno krunage vahere huno krenteneana, tamagriku hu'ne, <char style="qt">Ama vahe'mo'za zamagiteti nagi'a ahentesga nehaze. Hianagi zamagu'amo'a nagritera omaneno, afete'are me'ne.</char> </char> <verse eid="MRK 7:6"/><verse number="7" style="v" sid="MRK 7:7"/><char style="wj"><char style="qt">Amegati nezama'a omane mono hunenante'za, vahe'mofo kasege rempi nehaze.</char> </char><verse eid="MRK 7:7"/></para>
  <para style="r">(<ref loc="ISA 29:13">Ais 29:13</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>
    <char style="wj">Hagi Anumzamo'ma hihoma hu'nea kasegea netre'za, vahe'mofo zamuzma'mofo ke azeri hanavetiza amage nentaze.</char> <verse eid="MRK 7:8"/><verse number="9" style="v" sid="MRK 7:9"/>Anage huno mago'ane zamasami'ne, <char style="wj">Anumzamofo kasegema eritre kaziga knare hu'naze. Hanki tamagehe'i avu'ava'mofo amagera nentaze.</char> <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/><char style="wj">Na'ankure Mosesi'a anage hu'ne, negafane negreranena antahiminka agoraga'a manio. Hagi iza'o nefama nererama agoraga'a omanino, huhaviza huntesimofona, ahe friho hu'ne hutma nehaze.</char> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/><char style="wj">Hianagi tamagra anage nehaze, aza'o nefama nererama asamino, Nagrama tanaza hu'zama ante'noana, Anumzamofo ami'naku ante'noe haniana e'i knare hu'ne huta nehaze.</char> <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/><char style="wj">Ana nehutma, ana ne'mofona atrageno nefane nereranena mago'zana aza nosie.</char> <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/><char style="wj">Tamagri tami tamavu tamava'za rempima huzamiza'zamo higeta Anumzamofo ke'mofo hanavea eri netreta, rama'a ama anahu'zana nehaze.</char><verse eid="MRK 7:13"/></para>
  <para style="s">Vahe'mokizimi zamazeri pehena nehia zamofo naneke</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Hagi maka veaku Jisasi'a ke hige'za ageno anage huno zamasmi'ne, <char style="wj">Tamagra nanekeni'a nentahita antahi ama' hiho.</char> <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/><char style="wj">Magore huno fegiatima vahe'mofo agu'afima ufresiazamo'a, vahera azeri pehena osugahie. Hianagi vahe'mofo agu'afinti atiramino esiazamo, vahera azeri pehena hugahie. </char> <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/><char style="wj">[Kagesa antahinamoka antahio.] </char> <verse eid="MRK 7:16"/><verse number="17" style="v" sid="MRK 7:17"/>Anage huteno, ana vahe zamatreno Jisasi'a nompi marerige'za, amage'ma nentaza disaipol naga'mo'za, ana fronka ke'mofo agafa'agu antahige'naze. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>Anante Jisasi'a anage huno zamasami'ne, <char style="wj">Tamagrira knare antahi'zana omane'nefi? Tamagra antahi amara nosazo, inankanzamo'ma fegiatima vahe'mofo agu'afinka ufrezamo'a, vahe'mofona azeri pehena nosie.</char> <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/><char style="wj">Na'ankure anazamo'a vahe'mofo agu'afina novie. Hanki rimpafi uramiteno, anantetira rifa kerifi nevie.</char> (Jisasima anagema hu'nea kemo'a, mafka ne'zamo'a agru huno hu'ne.) <verse eid="MRK 7:19"/><verse number="20" style="v" sid="MRK 7:20"/>Hagi Jisasi'a anage huno zamasami'ne, <char style="wj">Vahe'mofo zmaguafinti atiramiazamo, zamazeri pehena nehie.</char> <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/><char style="wj">Vahe'mofo agu'afinti'ma efore'ma nehiana, havi agu'agesa antahi'zane, monko zane, kumzafa se'zane, vahema ahe fri'zana ne-e,</char> <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/><char style="wj">arave hu'nea a'ene vene monko avu'ava hu'zane, agraguke antahi'zane, havi avu'ava'ene, vahe'mofo krunage hunte'zane, vahe'mofo kumipi avrente avu'avazane, vahe'mofo zanku kenunu hu'zama, knare vahe'mofo havige hunte'zane, neginagi avu'ava hu'zane, avufga eriantesga hu'zane,</char> <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/><char style="wj">ana mafkazana vahe'mofo agu'afinti atiramiazamo vahera azeri pehena nehie. </char><verse eid="MRK 7:23"/></para>
  <para style="s">Mago a'mo Jisasinte amentinti hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Hagi Jisasi'a otino ana mopa atreno Tairi kuma kaziga vu'ne. Vuno mago nompi ufreno, vahe'mo'za emenine huza ontahisaze nehuno umanine, hianagi frakigara osu'ne. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Ana hianagi mago mofara havi avamu'mo agu'afi fre'nea mofa'mofo nerera'a Jisasi'ma emani'nea kema nentahino, ame huno eno agafi eme prihuno, <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>ana ara Sairofonesia kumateti Griki megi'a vahepinti a'kino, Jisasinkura muse hugantoanki havi avamura ome hunto huno asami'ne. <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>Higeno Jisasi'a anage huno ana akura hu'ne, <char style="wj">Mofavremofo bretima erita kramofo amizamo'a knarera osu'neanki, atregeno mofavremo kotazana nemu huteno.</char> <verse eid="MRK 7:27"/><verse number="28" style="v" sid="MRK 7:28"/>Higeno ana a'mo'a anage hu'ne, Ramoka tamage hananagi, itaretima mofavre'mo'za nenazageno ankrama heramiama'a kramo'za zogi'za nenaze. <verse eid="MRK 7:28"/><verse number="29" style="v" sid="MRK 7:29"/>Anante Jisasi'a anage hu'ne, <char style="wj">E'inahu kenona hanku vuo, havi avamumo'a mofaka'amofo agu'afinti hago atiramino vu'ne.</char> <verse eid="MRK 7:29"/><verse number="30" style="v" sid="MRK 7:30"/>Higeno noma'arega vuno ome keana, mofa'amofona havi avamumo'a ko atreno vigeno, sipare mase'negeno ome ke'ne.<verse eid="MRK 7:30"/></para>
  <para style="s">Agesa anari renegeno ageru noria ne' Jisasi'a azeri knamare'nea naneke</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Anante Jisasi'a Tairi kumara atreno, Saido kumapinti rugitagino Dekapolisi kaziga, Galili tirutega uhanatige'za, <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>mago agesa ankaniregeno kea nosia ne' avare'za e'za, Jisasinku muse hugantonanki kazana agofetu anto hu'naze. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Jisasi'a veara nezmatreno ana ne' avareno znagrake umanine'ne, agesa gampi azana nevazino, avetu aheno azankonu aganefunare avako nehuno, <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>kesga huno monafi negeno ra asimu nenteno, <char style="wj">Efata </char> huno hu'ne, (ana kemofo agafa'a ruhagro huo hu'ne.) <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Higeno ame huno ana ne'mofo agesamo'a ru hagro higeno, agefunamo'a oza higeno, knare huno kea hu'ne. <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>Jisasi'a amazama huazana vahera ozmasamiho huno nezmasamiana netre'za, ete mago'ane vahera huama hu'za zamasami'naze. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Hagi tusi zamagogo fege'za, Agra mika' zana knare'za nehie hu'za nehu'za, zamagesa ankanire'naza vahe erinkro huzmantege'za, knare hu'za kea nentahize. Hagi zamagnefu'na kna hu'nea vahe zamazeri so'e hige'za knare hu'za kea nehaze hu'za hu'naze.<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s">Jisasima 4tauseni'a venenerami ne'za zami'nea naneke</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Hagi ana knafina maka veamo'za mago'ene eritru hazageno, ne'zana omanegeno, Jisasi'a amage'ma nentaza disaipol naga ke hige'za ageno anage huno zamasmi'ne. <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/><char style="wj">Nagra ama vea krerfagura nasunku huzmantoe. Na'ankure zamagra tagufa kna nagri'enena mani'zageno, ne'zama ne'zana omane'ne. </char> <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/><char style="wj">Nagrama huzmantesuge'za kuma zimirega zamaga'ma netesige'za vanu'za, mago'amo'za afeteti e'nazanki'za kantega utraka hugahaze.</char> <verse eid="MRK 8:3"/><verse number="4" style="v" sid="MRK 8:4"/>Hige'za Agri amage'ma nentza disaipol naga'mo'za anankemofo nona'a anage hu'za asami'naze, vahe omani mopafi mani'nonanki inantegati ne'zana erizamisunke'za neganare hugahaze? <verse eid="MRK 8:4"/><verse number="5" style="v" sid="MRK 8:5"/>Hazageno Jisasi'a huno, <char style="wj">Nama'a breti eri'naze?</char> huno zamantahigege'za, 7ni'a breti eri'none, <verse eid="MRK 8:5"/><verse number="6" style="v" sid="MRK 8:6"/>hazageno, Jisasi'a ana maka veara mopafi maniho huno zamasamige'za manizageno, 7ni'a bretia erino Anumzamofo susu hunteteno, tamanasino amage'ma nentaza disaipol nagara zamige'za, ana veara refko hu'za zami'naze. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Ana nehazageno onensa nozamene mago'a me'negeno erino Anumzamofo susu hunteteno, amagema nentazana disaipol nagakura eritma zamiho huno zamasmi'ne. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Maka vahe'mo'za ana ne'za nenageno zamu hige'za ankra'ama atrazama'a, amagema nentaza disaipol naga'mo'za 7ni'a ra eka eka kupi zogiri avite'naze. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Ana vahera 4tauseni'a vahe nazamo'za netageno, huzmantege'za vu'za e'za hu'naze. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>Jisasi'a anama huteno, ame huno amage'ma nentaza disaipol naga'ane votifi mareri'za Talmanuta kaziga vu'naze.<verse eid="MRK 8:10"/></para>
  <para style="s">Farisi vahe'mo'za Jisasinku avame'za huraverio hu'za hu'naza naneke</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Anante Farisi vahe'mo'za e'za Jisasina ke hakare hunte'za, Monafinti ruzahu hankave kaguvaza erifore hugeta kamneno hu'za rehe'za ke'naze. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>Hagi Jisasina rimpamo'a kna nehigeno anage hu'ne. <char style="wj">Na'a hige'za meni knafi vahe'mo'za avame'za kenakura nahaze? Nagra tamage hu'na neramasamue, mago avame'zana ama knafi vahe'mo'za onkegahaze. </char> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>Ana huteno zamatreno ete votifi marerino kantu kaziga vu'ne.<verse eid="MRK 8:13"/></para>
  <para style="s">Herotine Farisi vahe'mokizmi havige kemofonku, zistire hunteno zamasami'nea fronka naneke</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Hagi amage'ma nentaza disaipol naga'mo'za zmagekani'za bretia eri'za omazanagi, magoke bretige votifina me'nege'za vu'naze. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Nevazageno Jisasi'a huno, <char style="wj">Farisi vahe'mokizmi zistigu'ene kini ne' Heroti zistigura kva hiho.</char> <verse eid="MRK 8:15"/><verse number="16" style="v" sid="MRK 8:16"/>Hige'za zamagra zamagra ke huge antahige hu'za bretima erita ome'nona zanku nehugahie hu'za hu'naze. <verse eid="MRK 8:16"/><verse number="17" style="v" sid="MRK 8:17"/>Nehazageno Jisasi'a antahino keno nehuno, <char style="wj">Nahigeta breti omane'nea zankura huge antahige nehaze? Tamagra ketma antahi amara osu'nazafi? Tamagri tamagu'amo'a eriginefi? </char> <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/><char style="wj">Tamavurga me'neana ke so'e nosazafi? Tamagesama me'neana antahi so'e nosazo? Tamagrira tamage'kaninegahie.</char> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/><char style="wj">Ko'ma 5fu'a breti tamanasina, 5 tauseni'a venene zami'noge'za nene'za atrazama'a, nama'a eka eka kupi erivite'naze? </char>12fu'a eka eka kupi zogiri'none hu'naze. <verse eid="MRK 8:19"/><verse number="20" style="v" sid="MRK 8:20"/><char style="wj">Hagi 7ni'a bretireti tamanasi'na 4tauseni'a vahe'ma zami'noge'za nene'za atrazama'a, nama'a eka eka kupi zogiri avite'naze? </char> Hige'za 7ni'a kupi zogiri'none hu'za hu'naze. <verse eid="MRK 8:20"/><verse number="21" style="v" sid="MRK 8:21"/>Anante Jisasi'a anage huno zamasami'ne, <char style="wj">E'ina'ma hu'noazankura menina tamagra tamagesa antahi'ama nosazafi?</char><verse eid="MRK 8:21"/></para>
  <para style="s">Jisasi'a avusu hu'nea ne' azeri hari hunte'nea naneke</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Ana hige'za zamagra Bedsaita kumate azageno, mago'a vahe'mo'za avusu hu'nea ne' avare'za Jisasinte e'naze. Avurgare avako hinkeno so'e huntenogu hanaveti'za Jisasina antahige'naze. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Ana hazageno, Jisasi'a avusu hu'nea ne'mofo azante avazu huno kumara atreno megi'a vuteno, Jisasi'a avufi avetu ahenenteno, azanu avako nehuno, <char style="wj">Mago'azana negano? </char> Huno antahigene. <verse eid="MRK 8:23"/><verse number="24" style="v" sid="MRK 8:24"/>Higeno kesga huno avua negeno, Vahera vano nehazage'na zamagoanagi, zafamo vano nehiaza nehige'na nezmagoe huno hu'ne. <verse eid="MRK 8:24"/><verse number="25" style="v" sid="MRK 8:25"/>Anante Jisasi'a mago'ene azanu avurgare avako higeno, ana ne'mofo avurgamo'a hari higeno, ke ankereno negeno maka'zana keama huno ke'ne. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Anante Jisasi'a hunenteno, <char style="wj">Kumapina ufrege efrege osunka, fatgo hunka nonkarega vuo</char> huno asami'ne.<verse eid="MRK 8:26"/></para>
  <para style="s">Pita'a huama Jisasinku hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Jisasi'a amage nentaza disaipol naga'ane Sisaria Filipai kumatamimpi vu'naze. Kantegama nevu'za Jisasi'a anage huno zmantahige'ne, <char style="wj">Nagrikura vahe'mo'za iza'e hu'za neheze?</char> <verse eid="MRK 8:27"/><verse number="28" style="v" sid="MRK 8:28"/>Hagi mago'amo'za, hu'za mono ti frezamante'nea Joni'e hu'za nehaze. Hagi mago'a mo'za, kasnampa ne' Elaija'e hu'za nehaze. Hagi mago'amo'za korapa kasnampa vahepinti mago'zmimo'e hu'za neheze. <verse eid="MRK 8:28"/><verse number="29" style="v" sid="MRK 8:29"/>Anage hazageno Jisasi'a zamagri zamantahigeno, <char style="wj">Hagi tamagra iza'e hutma Nagrikura nehaze? </char> Higeno Pita'a kenona huno, kagra Kraisige, Anumzamo'ma huhamprino vahe'ama zamavaregahanema hu'nea nere hu'ne. <verse eid="MRK 8:29"/><verse number="30" style="v" sid="MRK 8:30"/>Agra hu hankavetino mago vahera ana naneke huama hutma ozmasmiho huno zamasmi'ne.<verse eid="MRK 8:30"/></para>
  <para style="s">Jisasi'a knafima ufreno frisnia ke zamasmi'nea naneke</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Anante Jisasi'a erigafa huno amage'ma nentaza disaipol naga'a rempi huzamino, Vahe'mofo Mofavremo'a rama'a ata e'nerisigeno, mono kva vahe'mo'zane, ugagota kva vahe'mo'zane, kasegere ugagota hu'naza vahe'mo'za zamefi humiza ahefrisageno, tagufagna maseteno otigahie huno zamasami'ne. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>Hagi ana nanekea huama huno amate zmasamigeno, Pita'a nentahino Jisasina avaregantiteno, agafa huno e'inahu kea osuo huno kesu'ne. <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>Hianagi Jisasi'a rukrahe huno, amage nentaza disaipol nagatega nezmageno Pitana kesuno, <char style="wj">Sataga manignenka namefiga'a evuo, Anumzamofo antahintahi novaririnanki, vahe'mofo antahintahi nevaririne.</char><verse eid="MRK 8:33"/></para>
  <para style="s">Jisasima amage'antezamofo naneke</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Anante Jisasi'a maka veamokizmi ke hige'za, amage'ma nentaza disaipol naga'ene emetru hazageno, anage huno zamasami'ne, <char style="wj">Mago vahe'mo nagri namage'ma antenaku'ma hanuno'a, agra'a avesi'zana netreno, keka zafa'a erigofino namage egahie.</char> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/><char style="wj">Na'ankure iza'o, agra'a agu'vazino eri so'e huku hanimo'a, asimu'a atregahie. Iza'o nagriteku'ene Knare Musenkerema asimu'a atresimo'a agu'vazigahie.</char> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/><char style="wj">Mago vahe'mo'ma ama mopafi fenoza eri atruma nehanigeno, agu amema'a fnanema haniana, nankna aza hu'za erigahie? </char> <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/><char style="wj">Na'a vahe'mo'a asimuma erisigura nona'a huno Anumzamofona amigahie?</char> <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/><char style="wj">Iza'o ama knafi keontahi kumike vahepi, Nagriku'ene Nanekenimofoma agaze huntesimofona, henka Vahe'mofo Mofavremo Nafa'amofo hanavefima routage ankero vahe'ane esuno'a, Agranena zamagaze hunte'nesamokizmia, eme agaze huzmantegahie.</char><verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Hagi Jisasi'a mago'ane zamasamino, <char style="wj">Tamage hu'na neramasmue, amafi otiza mani'naza vahepintira, ofri mani'ne'za Anumzamofo kumamo'a hanave'ane esige'za kegahaze.</char><verse eid="MRK 9:1"/></para>
  <para style="s">Jisasi avufgamo masanentake nehige'za kenaza naneke</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Hagi 6'a zagegna evutegeno, Jisasi'a Pitama, Jemisima, Jonikizmia zamavareno za'za agonafi mareriza zamagrake umani'ne'za, negageno Jisasi avufagamo'a rukrehe huno ruzahe nehigeno, <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>kukena'amo'a efe anentake huno tampre tampre hu'ne. Mopafina kukena sese nehigeno e'inahukna efenentake nosiaza huno efenentake hu'ne. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Hagi Elaija'a Mosesi'ene zamavuga efore huke Jisasi'ene naneke hu'naze. <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>Ana higeno Pita'a anage huno Jisasina asami'ne, Hurami' ne'moke, knare amafina mani'none. Hagi tagufa tona nona kigahune. Mago nona Kagriki, mago nona Mosesinki, mago nona Elaijanki huta kigahune. <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Na'ankure zamagra tusi koro nehazageno, na'ane naneke hugahie, Pita'a ontahineno ana kea hu'ne. <verse eid="MRK 9:6"/><verse number="7" style="v" sid="MRK 9:7"/>Anante hampomo refitenezmantegeno, mago agerumo amanage ana hampompinti hu'ne, ama'i tusiza hu'na navesima nentoa Mofavreni'e. Agrama hania kea antahi amiho! <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Hagi keganti kegma hu'za kazana, ame huke Moseke Elaijake omani'nakeno, Jisasi'a Agrake mani'nege'za ke'naze.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Hagi zamagrama agonaregati magoka eneramizageno hanave ke zamasamino, ke'naza zana vahera ozmasamitfa hu'nenkeno, Vahe'mofo Mofavremo'a fripinti otiteno hu'ne. <verse eid="MRK 9:9"/><verse number="10" style="v" sid="MRK 9:10"/>Hagi fritena otigahema hia nanekema zamagra'a nentahiza, na agu'agesare nehie hu'za hu'naze. <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>Anante zamagra Jisasina anage hu'za antahige'naze, na'a hige'za kasegere ugagota hu'naza vahe'mo'za, hu'za Elaija'a etenkeno'e hu'za nehaze? <verse eid="MRK 9:11"/><verse number="12" style="v" sid="MRK 9:12"/>Jisasi'a anage huno zamasami'ne, <char style="wj">Tamage Elaija ko eno maka'zama haviza hu'neazana eriso'e hu'ne. Hagi na'a higeno avontafepina krenteno, Vahe'mofo Mofavremo'a rama'a ataza erina, vahe'mo'za zamefi humigahaze hu'ne? </char><verse eid="MRK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 9:13"/>
    <char style="wj">Hianagi anage hu'na neramasamue, Elaija'a ko' ehanatige'za nanknazama hunte'naku'ma haza'zana avontafepima kre'nea kante ante'za maka'zana hunte'naze. </char><verse eid="MRK 9:13"/></para>
  <para style="s">Jisasi'a mago mofavre azeri knamre'nea naneke</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat 17:14-21</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Jisasi'ene tagufa amage'ma nentaza disaipol naga'mo'zama, ete ruga'a amage'ma nentaza disaipol nagatema, e'za eme zamagazana kasegere ugagota hu'naza vahe'mo'za keha renezmantazage'za eme zamage'naze. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Anante ana maka vahe'mo'za Jisasina nege'za antri nehu'za, ame hu'za zamagare'za vu'za muse ome hunte'naze. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Jisasi'a huno, <char style="wj">Na'anku kehara zamagranena nehaze</char> huno zamantahige'ne? <verse eid="MRK 9:16"/><verse number="17" style="v" sid="MRK 9:17"/>Tusi'a vahepinti mago'mo ana kemofo nona'a anage hu'ne, Rempi hurami ne'moke, havi avamumo agu'afi mani'neno agira eri antrako higeno, ke nosia mofavreni'a avarena Kagrite neoe. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Anama havi avamu'mo'ma agu'afi nefreno'a azeri traka hutregeno mopafi masenegeno, ahirahi neregeno agipinti agremo zuzu nehigeno, avera anikreki nehuno mase havavu nehie. Ana nehige'na avre'na Kagri kamage'ma nentaza disaipol nagate havi avamu humegi atresazegu zamantahigo'anagi, azeri so'e huonte'naze. <verse eid="MRK 9:18"/><verse number="19" style="v" sid="MRK 9:19"/>Ana kemofo nona'a Jisasi'a anage huno zamasami'ne, <char style="wj">Tamagra tamentinti osu vahere! Nama'a gna tamagra nena manigahue? Nama'agna tamagri kna erina vugahue? Ana mofavre avaretma Nagrite eho.</char> <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Hagi ana mofavre avare'za azageno, havi avamumo Jisasima anama negeno'a, ana mofavre azeri traka hutregeno mopafi traka huno maseno rukre rukre nehigeno, agipintira agremo'a zuzu hurami'ne. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Ana nehigeno Jisasi'a ana mofavremofo nefana antahigeno, <char style="wj">Nanknafi ana zana agafa hu'ne?</char> Higeno, mofavre mani'negeno anazana fore humine huno hu'ne. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Rama'a zupa tevefine tirupine ahefri'naku azeri traka hunetre. Hagi Kagrama azahuga hunesunka, kasunku hurantenka taza huo huno hu'ne. <verse eid="MRK 9:22"/><verse number="23" style="v" sid="MRK 9:23"/>Higeno Jisasi'a anage huno ana mofavremofo nefana asami'ne, <char style="wj">Na'a higenka kagrama azahuga hunesunka azeri otio hunka nehane? Hagi mago'moma amentinti huno, maka'zana fore hugahie hanimofontera, amane maka'zana fore hugahie. </char> <verse eid="MRK 9:23"/><verse number="24" style="v" sid="MRK 9:24"/>Ana mofavremofo nefa'a ranke huno anage hu'ne, namentinti huanki namentintima osu'zana naza huo! <verse eid="MRK 9:24"/><verse number="25" style="v" sid="MRK 9:25"/>Hagi Jisasi'ma keama rama'a vahe'mo'za ame hu'za eritru nehazageno, havi avamura hanavetino hunteno, <char style="wj">Kagra vahe'mokizmi zamazeri negi nenenka zamagi zamazeri antrako nehana havi avamumoka, hugantoanki agu'afintira atiraminka nevunka, mago'anena eofro. </char><verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Higeno ranke huno azeri tagosi tagosi nehuno atiramino enevigeno, ana mofavremo fri vahekna huno mase'nege'za, hago frine hu'za hakare vahe'mo'za sumi sumi ke hugantigama hu'naze! <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Hianagi Jisasi'a azante akoheno azeri otigeno oti'ne. <verse eid="MRK 9:27"/><verse number="28" style="v" sid="MRK 9:28"/>Ana huteno Jisasi'a nompi umarerige'za, amage'ma nentaza disaipol naga'mo'za, Agrane zamagraku umani'ne'za, na'a higeta havi avamura ahenati notrone hu'za antahige'naze? <verse eid="MRK 9:28"/><verse number="29" style="v" sid="MRK 9:29"/>Hazageno Jisasi'a anage huno zamasami'ne, <char style="wj">Amana huknazana, nunamuhu kantetike huntesageno atiramigahie.</char><verse eid="MRK 9:29"/></para>
  <para style="s">Jisasi'a friteno otisia zamofonku hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Hagi Jisasi'ene amage'ma nentaza disaipol naga'mo'za ana kumara atre'za, atiramiza Galili kaziga rukitagiza vu'naze. Hianagi Jisasi'a kama vazama'a mago vahemo antahi zankura ave'osine. <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>Na'ankure amage'ma nentaza disaipol nagara rempi hunezamino, anage huno zamasami'ne, <char style="wj">Vahe'mofo Mofavre avare'za ha' vahe zamazampi antesage'za ahe fritesageno, tagufa kna maniteno kerifintira otigahie. </char> <verse eid="MRK 9:31"/><verse number="32" style="v" sid="MRK 9:32"/>Hianagi ana naneke antahi ama nosu'za, antahige'zankura koro hu'naze.<verse eid="MRK 9:32"/></para>
  <para style="s">Amu'nontifina i'za rana mani'ne hu'naza naneke</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Anantetira Kapaneamu kumatega ete'za, Jisasima nompinka enemanino'a anage huno zamantahige'ne. <char style="wj">Kantegama ne-eta na'anku keaga huta e'naze?</char> <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Hianagi kantegama ne-eza i'za amu'nontifintira ugagota hu'ne hu'za hugantugama hu'nazagu, zamagra kea osutfa hu'naze. <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>Anante'ma Jisasi'ma mopafima nemanino'a 12fu'a amage'ma nentaza disaipol naga'a, kehuno anage huno zamasami'ne, <char style="wj">Iza'o ugagota hunaku'ma hanimo'a, henkarfa nemanino, maka vahe'mofo eriza vahe manigahie.</char> <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>Agra osi mofavre amunozmifi azante azerino azeri onetino, anage huno zamasami'ne. <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/><char style="wj">Iza'o amanahu'kna osi mofavre, Nagri nagifi avreno azeri so'e huntesimo'a, Nagri navareno nazeri so'e hunantegahie. Iza'o Nagri'ma nevareno nazeri so'e hunante'nimo'a, Nagrike navareno nazeri so'e osugahianki, Nenfa hunantege'na e'nomofo avreno azeri so'e huntegahie.</char><verse eid="MRK 9:37"/></para>
  <para style="s">Erizanti eri haviza nosimo'a tagri kaziga mani'ne hu'nea naneke</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Anante Joni'a Jisasina asamino, Hurami ne'moka mago ne'mo kagri kagifi havi avamutamina humegi netregeta negeta, ana osuo huta hunte'none. Na'ankure ana ne'mo'a tagranena vano osu'negu ana osuo huta asevazinte'none. <verse eid="MRK 9:38"/><verse number="39" style="v" sid="MRK 9:39"/>Hianagi Jisasi'a anage hu'ne, <char style="wj">I'o huonteho, na'ankure mago vahe'mo'e huno Nagri nagifima kaguvazama nehanimo'a, hantga huno hu haviza hu onantegahie.</char> <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/><char style="wj">E'ina hu'negu iza'o tagri'ma ha'marema norante'nimo'a, tagri kaziga mani'ne.</char> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/><char style="wj">Na'ankure tamage hu'na neramasamue, iza'o, Kraisi amage'ma nentaza disaipol naga zamaza hanue huno nehuno, tima afi tamisimofona, mizama'amo'a fanane osugahie.</char><verse eid="MRK 9:41"/></para>
  <para style="s">Havi avu'avazamo zamentinti zamazeri haviza nehia naneke</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>Jisasi'a anage huno zamasami'ne, <char style="wj">Iza'o ama osi mofavremo'za, Nagrite'ma zamentinti nehaza mofavre nagama kumipi zamarentesamokizmia, tusi'a monu havereti anankempi rentete'za, hagerimpi matevu'za atresageno uramisiana knare'zantfa hugahie.</char> <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/><char style="wj">Hagi kazamo'ma kumipi kavare nentesigenka akafri atro. Na'ankure ru tare kaza me'nenigeno asu osu tevava tevefi kavarente zanku, magoke kaza me'nena manivava asimu erisanana knare hugahie.</char> <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/><char style="wj">[Anampina kanimo'a zamufgafi manivava hugahie. Hanki tevemo asu osu tevava hugahie.] </char> <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/><char style="wj">Hagi kagamo'ma kumipi kavare nentesigenka akafri tro, na'ankure ru tare kaga me'neno asu osu tevava tevefi kavarente'zanku, magoke kaga me'nena, manivava asimu erizampi ufresanana knare hugahie.</char> <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/><char style="wj">[Anampina kanimo'a zamufgafi manivava hugahie. Hanki tevemo asu osu tevava hugahie.]</char> <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/><char style="wj">Hagi kavurgamo'ma kumipi kavare nentesigenka, anankavuraga tagati atro, na'ankure ru tare kavurga me'neno, asu osu tevava tevefi kavretre'zanku, magoke kavurgama me'nena, Anumzamofo kumapima ufresanana knare hugahie.</char> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/><char style="wj"><char style="qt">Anampina kanimo'a zamufgafi manivava hugahie. Hanki tevemo asu osu tevava hugahie.</char> </char> (Ais 66:24) <verse eid="MRK 9:48"/><verse number="49" style="v" sid="MRK 9:49"/><char style="wj">Na'ankure hagereti'ma ofama eri hagama nehiaza huno ana mikomofona tevenu kre fatgo hugahie. </char> <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/><char style="wj">Hagemo'a knare hu'neanagi, haga'ama atresigenka, inankna hunka ete kagra eri haga hugahane? Tamagra hagegna huta amuno tamifina ovesinte avesinte hutma tamarimpa frune maniho.</char><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s">Jisasi'a arave atane zanku zamasami'nea naneke</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat 19:1-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Hagi Jisasi'a ananku'ma atreno Judia kaziga vuno Jodani tina takaheno kantu kaziga vu'ne. Nevige'za tusi'a veamo'za mago'ene Agrite emeri atru hazageno anante umani'neno, ko'ma nehiaza huno naneke mago'ene agafa huno rempi huzami'ne. <verse eid="MRK 10:1"/><verse number="2" style="v" sid="MRK 10:2"/>Farisi vahe'mo'za e'za Jisasina rehe'za anage hu'za antahige'naze, vemoma nenaro atrezamo'a kasege amage antegahifi? <verse eid="MRK 10:2"/><verse number="3" style="v" sid="MRK 10:3"/>Hu'za nehazageno ana kenona'a anage huno zamasami'ne, <char style="wj">Na'a hiho huno Mosesi'a kasegea krerami'ne?</char> <verse eid="MRK 10:3"/><verse number="4" style="v" sid="MRK 10:4"/>Hige'za Zamagra anage hu'naze, Mosesi'a avompina, vemo'a nenaro atrenakura amane katroe huno eriamahu avona kre nemino, huntenkeno vugahie. <verse eid="MRK 10:4"/><verse number="5" style="v" sid="MRK 10:5"/>Hianagi Jisasi'a amanage huno zamasmi'ne, <char style="wj">Na'ankure tamarimpamo'a hankavetino erigi'nea zanku huno Mosesi'a ana kasegea kreno tamami'ne.</char> <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/><char style="wj">Hianagi Anumzamo'a ese agafare <char style="qt">vene a'ene trohu zanante'ne. </char> </char> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/><char style="wj">E'i ana agafare vemo'a nefane nereranena netreno, nenaro'ene hagerfino, </char> (Diu-Kas 24:1, Jen-Agf 1:27, 5:2) <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/><char style="wj">erimago znavufa neseke, mago'ane tare vahera omanina'anki, magoke mani'na'e.</char> <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/><char style="wj">E'ina hu'negu nazano Anumzamo'ma eri hagerafi neniazana, atregeno mago vahe'mo'a eri ovasaneno. </char> <verse eid="MRK 10:9"/><verse number="10" style="v" sid="MRK 10:10"/><char style="wj">Ete mago'ene nompi umareri'za mani'neza amage'ma nentaza disaipol naga'mo'za aravema refutagizankura antahige'naze.</char> <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Jisasi'a ke'nona zamire anage huno zamasami'ne, <char style="wj">Iza'o ese a'ma netreno aru a'ma erisia ne'mo'a, ese a'mofona kumi hunteno monko avu'avaza hugahie. </char> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/><char style="wj">Hagi mago a'moma neve netreno, aru ve eri snimo'a, monko avu'ava hugahie.</char><verse eid="MRK 10:12"/></para>
  <para style="s">Jisasine ne'one mofavre naga'mofo naneke</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Anante vahe'zagamo'za ne'one mofavreramina Jisasi'ma azanteno asomu huzmantenogu zmavare'za neage'za, amage'ma nentaza disaipol naga'mo'za kezamasu'za azeri amuho osiho hu'naze. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Hianagi Jisasima nezmageno asi vazigeno, anage huno zamasami'ne, <char style="wj">Zamazeorita zamatrenke'za osi mofavre'mo'za Nagrite eho. Na'ankure Anumzamofo kumara e'inahu vahe'mofo kuma me'ne.</char> <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/><char style="wj">Tamage hu'na neramasamue, iza'o Anumzamofo kumama mofavre'moma eneriaza huno e'orisimo'a, uofretfa hugahie.</char> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Jisasi'a anage huteno, ana mofavre'rami zamavareno, azana zamagofetu anteno agafa huno asomu kea huzmante'ne.<verse eid="MRK 10:16"/></para>
  <para style="s">Afufenone ne'mo Jisasi antahige'nea naneke</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Hagi Jisasi'a otino kantega nevigeno mago ne'mo negeno, agareno agafi rena omenereno anage huno hu'ne, knare rempi hurami ne'moka, nankna hanuna manivava asimura erigahue? <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/>Higeno Jisasi'a anage huno ana nera asami'ne, <char style="wj">Na'a higenka kagra knare hu'nane hunka nehane? Mago vahe'mo'e huno knare osu'neanki, Anumzamo Agrake knarera hu'ne.</char> <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/><char style="wj">Hagi kasegefina ko amanage hu'negenka antahinane, vahe ahe ofrio, rumofo a'enena monko'zana osuo, kumzafa oso, vahera havige huozmanteho, vahezana eri savarira osiho, negrerane negafa kea antahi zanaminka zanamage antegahane hu'negenka antahinane. </char> <verse eid="MRK 10:19"/><verse number="20" style="v" sid="MRK 10:20"/>Anante ana ne'mo'a Jisasina anage huno asami'ne Rempi hurami ne'moka, osi'ma mani'noretima eno menima ama knarema eana, nagu'areti hu'na maka ana kasegea amage ante'noe. <verse eid="MRK 10:20"/><verse number="21" style="v" sid="MRK 10:21"/>Jisasi'a ana nera negeno avesinteno anage hu'ne, <char style="wj">Mago'zanku atupa hu'nane, vunka inanknazama ante'nesnana zana, maka zagore ome atrenka eritenka, ana zago erinka zamunte omane vahe nezamigeno, monafinka fenonka'a meno. Ana nehunka kagra, Nagri eme namage'anto.</char> <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Ana naneke nentahigeno, avugosamo ruzahe higeno, rama'a afufeno ante'negu rimpagna nehuno atreno oti'no vu'ne.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Vigeno Jisasi'a ome zamage eme zamage nehuno, amanage huno amage'ma nentaza disaipol naga'a zamasmi'ne, <char style="wj">Afufenozamine vahe'mo'za Anumzamofo kumapi ufrenaku'ma hanazana, tusi'a amuho hugahaze!</char> <verse eid="MRK 10:23"/><verse number="24" style="v" sid="MRK 10:24"/>Anagema hige'za amagema nentaza disaipol naga'mo'za antri ana kegura hu'naze. Hianagi mago'ene Jisasi'a anage huno zamasami'ne, <char style="wj">Mofavre naga'mote, Anumzamofo kumapima ufrezamo'a tusi'a amuho hu'ne!</char> <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/><char style="wj">Kemoli afumo'za </char> <note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Nekazamofo kampinema hu'neana osi kahanku hu'ne.</char></note> <char style="wj">nekazamofo kampima ufrenakuma nehazana amuhoa hunozmante. Hianagi afufenone vahe'mo'za Anumzamofo kumapi ufre'naku hanazana, tusi amuho huzmantegahie. </char> <verse eid="MRK 10:25"/><verse number="26" style="v" sid="MRK 10:26"/>Mago'ene antri hu'za tusi zmagogogu nehu'za, zamagra zamagra anage hu'naze, hagi iza manivava manizana erigahie? <verse eid="MRK 10:26"/><verse number="27" style="v" sid="MRK 10:27"/>Hazageno Jisasi'a nezmageno ana kenona amanage huno hu'ne, <char style="wj">Vahetfamota amanahu'zana hugara osu'nazanki, Anumzamo'a amane maka'zana hugara hu'ne.</char><verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Higeno Pita'a anage huno Jisasina asmi'ne, ko, tagra mafka'zana atreta kagri kamage'nentone. <verse eid="MRK 10:28"/><verse number="29" style="v" sid="MRK 10:29"/>Higeno Jisasi'a anage hu'ne, <char style="wj">Tamage hu'na neramasamue, iza'o Nagriku'ene Knare Musenkereku'ma huno noma'afi, afuhe'impi, asarahehe'impi, nererampi, nefampi, mofavre'zaga'afi hoza ramima'ama atresimo'a,</char> <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/><char style="wj">ana nona'a maka'zana 100'a agatereno menina ama knafina rama'a e'nerino, rama'a kuma'ene, nefu'zane nesaro'zane nererane mofavre' naga'ane, hoza'ane e'nerisige'za, vahe'mo'za azeri haviza nehanageno, henkama esia knarera manivava asimu erigahie.</char> <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/><char style="wj">Hianagi rama'amo'za ugagota hu'nenamo'za, henka esnage'za, rama'a henka e'nenamo'za, ugagota hu'za vugahaze.</char><verse eid="MRK 10:31"/></para>
  <para style="s">Jisasi'a friteno otisia zanku hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Hagi Jerusalemi vu kantega mareri'za nevazageno, Jisasi'a ugota huno vu'ne. Hianagi amagema nentaza naga'mo'za antri nehazageno, zamavaririza vu'naza vahe'mo'za koro hu'naze. Hianagi Jisasi'a 12fu'a amage'ma nentaza disaipol nagara zamare kanti mago'ene zamanteno, agafa huno agrite'ma fore hania zamofo naneke zamasami'ne. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/><char style="wj">Keho, Jerusalemi kumate marerita meni nevunankino, Vahe'mofo Mofavrea azeriza ugagota mono kva vahete'ene kasegere ugota hu'naza vahe zamazampi avrentegahaze. Zamagra ahe friho nehu'za, fegi'a vahe zamazampi avrentegahaze. </char> <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/><char style="wj">Ana vahe'mo'za huhaviza hunente'za, zamavetu ahenente'za sefunemiza, ahe frigahaze. Hianagi tagufa zagekna zupa frinefintira otigahie.</char><verse eid="MRK 10:34"/></para>
  <para style="s">Jemisike Jonike kota vahe maninaku Jisasina antahige' na'a naneke</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Anante tare Zebeti nemofoke Joni'ene Jemisikea Jisasinte e'ne anage hu'na'e, Hurami ne'moka, menima tagrima tavemanesiza hurantogu kantahinego'e? <verse eid="MRK 10:35"/><verse number="36" style="v" sid="MRK 10:36"/>Jisasi'a anage hu'ne, <char style="wj">Na'a huranantesuegu neha'e?</char> <verse eid="MRK 10:36"/><verse number="37" style="v" sid="MRK 10:37"/>Anage huke asami'na'e, monafima hihamu hanaveka'afima kinima umaninunka tatregeno, mago'mo'a kazantmaga manina, mago'mo'a kaza hoga'a maninogu nehue. <verse eid="MRK 10:37"/><verse number="38" style="v" sid="MRK 10:38"/>Hianagi Jisasi'a anage huno znasami'ne, <char style="wj">Tanagra antahitna ketna osu na'azanku nantahinega'e! Tanagra nesua kapufintira negaha'o, hifi tima fresuaza hutna, tina fregaha'o?</char> <verse eid="MRK 10:38"/><verse number="39" style="v" sid="MRK 10:39"/>Higeke ana netremoke anage huke Jisasina asami'na'e, tagra amane negahu'e huke hakeno, anante Jisasi'a anage huno znasami'ne, <char style="wj">Nagrama nesua kapufintira amane neta, tima frezama nehua tina fregaha'e.</char> <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/><char style="wj">Hu'neanagi nazantamaga mani'zane, naza hogama mani'zana Nagri'zana omane'ne. Anumzamo'ma huhampri zamanteno, retro'ma huzmanteno erigahazema hu'nea vahe'mo'za erigahaze.</char><verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Anage nehige'za 10'a amage'ma nentaza disaipol naga'mo'za ana naneke nentahi'za, Jemisine Jonigiznia agafa hu'za zamarimpa aheznante'naze. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Hagi Jisasi'a mika'amokizmi ke hige'za ageno anage huno zamasmi'ne, <char style="wj">Megi'a vahepinti kva vahere hu'za antahizamiza vahe'mo'za ra vahe'zimi nemanizage'za, iza'zo ra zamagima eri'za vahe'mo'za hanave zamireti zmagatere'za kegava hunezmantaze. </char> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/><char style="wj">Hu'neanagi tamagra anahuknara osugahaze. Hianagi iza'o ra vahe mani'naku hanimo'a, tamagri amu'nompina eri'za vahe manino.</char> <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/><char style="wj">Iza'o amunotamifintima ugagota huramante'nakuma hanimo'a, mika'motma kazo kazo eriza vahe manigahie.</char> <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/><char style="wj">Ana hu'negu Vahe'mofo Mofavre'mo enena, eri'za erintehogura ome'ne. Hianagi eri'za erino tamagri tamaza nehuno, Agra'a asimura atreno rama'mokizmi miza sezmantenaku e'ne.</char><verse eid="MRK 10:45"/></para>
  <para style="s">Avusu hu'nea ne' Batamiasi naneke</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Hagi zamagrama Jeriko kumate ehanatite'za, Jisasi'ene amage'ma nentaza disaipol naga'ene tusi'a veamo'za ana kuma atre'za nevazageno, Timeasi nemofo Batamiasi'a avusuhu ne'mo, kamofo ankenarega mani'neno, azama hanagu meme hu'ne. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Hagi ana ne'mo'a antahiama Nazareti Jisasi ne-e hiankema nentahino'a, agafa huno kezatino, Jisasiga Deviti nemofoga nagrira kasunku hunantenka nazahuo! <verse eid="MRK 10:47"/><verse number="48" style="v" sid="MRK 10:48"/>Hage'za rama'a vahe'mo'za kesu'za, kagra tagano hu'naze. Hianagi mago'ene kezatino, Jisasiga Deviti nemofoga nagrira kasunku hunantenka nazahuo! <verse eid="MRK 10:48"/><verse number="49" style="v" sid="MRK 10:49"/>Higeno Jisasi'a nevifinti uotino, <char style="wj">Ke hinkeno eno</char> hige'za, zamagra ana avusuhu neku, kagriku ke nehianki krimpamo'a so'e nehinkenka otinka eno hu'za hu'naze. <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>Ana ne'mo zanra anakreku'a netreno ame huno otino Jisasinte e'ne. <verse eid="MRK 10:50"/><verse number="51" style="v" sid="MRK 10:51"/>Higeno anante Jisasi'a anage hu'ne, <char style="wj">Na'a hugante'nuegu kave'nesie?</char> Hurami ne'moka, ete navu kenaku nehue. <verse eid="MRK 10:51"/><verse number="52" style="v" sid="MRK 10:52"/>Higeno, Jisasi'a anage huno asami'ne, <char style="wj">Kamentintimo kazeri so'e hianki vuo</char> higeno, ame huno avurgamo'a ete hari higeno amage' avaririno kantega vu'ne.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s">Jerusalemi kumapi Jisasi'a donki afu'mofo agumpi manino kini vahekna huno ufre'nea naneke</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Jon 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Hagi Jerusalemi kuma tava'onte e'naze. Betfakene Betania Olive agonare me'nea kumate ne-eza, Jisasi'a tare amage'ma nenta'a disaipol netre'na huznanteno, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>anage huno znasami'ne, <char style="wj">Tanagra ugoteta antu kumapi vi'o. Kasefa donki vahe'mo'a agumpi omaninenia kina arente nenigeta ome kenutna, nofira eri katufetna avazu huta e'o.</char> <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/><char style="wj">Hanki ana nehanakeno mago'a vahe'mo, na'a hu'naku nevra'e huno hinketna'a anage hi'o, Ramofona eri'za me'ne hutna hanakeno'a, ame huno atrenketna avretna egaha'e. </char> <verse eid="MRK 11:3"/><verse number="4" style="v" sid="MRK 11:4"/>Huno huznantegeke karanka nevu'ne ome ka'ana, fegia nomofo kafante rente'nagene ome negene katufe'na'e. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Anante oti'naza vahe'mo'za, na'a hunaku donkia katunefa'e hu'za znantahige'naze? <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>Hazageno Jisasi'ma hu'nea kea nezmasamige'za, anante'ma oti'naza vahe'mo'za knarere hu'za huznante'naze. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Anante ana kasefa donkina avre'ne Jisasinte ne-ene anakreku'zani zafi'ne ana donkimofo agumpi tafevasi nentakeno, Jisasi'a ana agofetu manino vu'ne. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Mika veamo'za zaza anakre ku'zimi zafiza kampi vasiza nevazage'za, mago'amo'za zafa asina hozafinti akafri'za kampi tafe vasiza nevazageno, Jisasi'a ana tafete vu'ne. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Hagi kote'za vaza vahe'mo'zane henkama aza vahemo'zanena amrara hu'za ranke hu'za muse hunente'za, <char style="bdit">Tazahu nera, hosanna ramofo agifi ne-emofona asomu huntesanie! </char> (Sam-Zga 118:25-26) <verse eid="MRK 11:9"/><verse number="10" style="v" sid="MRK 11:10"/>Nerafa Deviti nagapintima ne-emofonkura marerisa Anumzamofona muse hunenteta, Tazahu ne'mofona agi'a ahentesga hanune. <verse eid="MRK 11:10"/><verse number="11" style="v" sid="MRK 11:11"/>Anante Jisasi'a Jerusalemi kumapi vuno, ra mono nompi ufreno maka'za ome kagino ke vagareteno, atiramino 12fu'a amage'ma nentaza disaipol naga'a zagemo kinaga segeno nezamavareno atreno Betani kumate vu'ne.<verse eid="MRK 11:11"/></para>
  <para style="s">Fiki zafamo raga'a oreno huno sifna hente'nea naneke</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Hagi masete'za nanterana Betani kumara atre'za neageno, Jisasina aga ate'ne. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Fiki zafa'mofo asina kuronkuro huno ogamanu me'negeno negeno, nezama rente'nenigu kenaku eme ke'ne. Hianagi eme keana asinage me'negeno ke'ne. Na'ankure fiki zafa raga rentekna omane'ne. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Ana higeno ana zafamofonkura anage huno hu'ne, <char style="wj">Mago'ene raga oresnanke'za veamo'za tagi'za onegahaze.</char> Anage hige'za amage'ma nentaza disaipol naga'mo'za ana naneke antahi'naze.<verse eid="MRK 11:14"/></para>
  <para style="s">Ra mono nompi maketi nehaza vahe Jisasi'a zamahe fegi zmatre'nea naneke</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Jon 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Hagi Jisasi'ene amagema nentaza disaipol naga'ane Jerusalemi kumate uhanati'zageno, Jisasi'a ra mono nompi mareriteno agafa huno maketima nehaza vahera zamahenati netreno, zagore netre'za miza nesaza vahe'mokizmi trara erikaha hunetreno, mani'ne'za maho nama zagore netraza tra'ene zagoma rezahema nehaza vahe trara erikaha hutre'ne. <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Ana huteno feno zantamia mago vahe'mote hutma eritma ra mono nompina aru kitagita vuta eta osutfa hiho huno hu'ne. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Ana huteno agafa huno rempi hunezamino anage huno zamasmi'ne, <char style="wj">Amanage huno Anumzamofo avontafepina krente'ne, <char style="qt">Nagri nona mika kaziga vea'moza nunamu hanaza no me'ne,</char> hianagi tamagra kumzafa vahe'mo'za fraki nonkuma eri tro nehaze.</char> (Ais 56:7, Jer 7:11) <verse eid="MRK 11:17"/><verse number="18" style="v" sid="MRK 11:18"/>Hagi ra mono kva vahe'mo'zane, kasegerema ugagota hu'naza vahe'mo'za nentahiza, inankna huta ahegahune hu'za ahesaza kankamunku hakrenaze. Na'ankure zamagra koro Agrikura hu'naze. Hagi maka vahe'mo'za rempima huzamia zankura antri hu'naze. <verse eid="MRK 11:18"/><verse number="19" style="v" sid="MRK 11:19"/>Ana kinaga Jisasi'ene amage'ma nentaza disaipol naga'mo'za, rankuma atre'za fegi'a vu'naze.<verse eid="MRK 11:19"/></para>
  <para style="s">Sifnama ahente'nea fiki zafamo hagege hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Nantera enevu'za kazana, sifnama Jisasi'ma ahente'nea fiki zafamo'ene arfu'na'amo'a, osapa re'nege'za ke'naze. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Pita'a Jisasi'ma hu'nea kegu age'sa nentahino anage hu'ne, Rempi hurami ne'moka ko! Okima sifna kema hunka raga renontenka osaparo hu'nana Fiki zafamo'a osapa re'ne. <verse eid="MRK 11:21"/><verse number="22" style="v" sid="MRK 11:22"/>Jisasi'a kenona anage huno zamagrira zamasami'ne, <char style="wj">Anumzamofonte tamentinti hiho.</char> <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/><char style="wj">Tamage hu'na neramasamue, mago vahe'mo'ma ami agonagu'ma huno, otinka hagerimpi takauro huno tare agesa ontahi amentinti nehuno hanigeno'a, amane ke haniaza huno fore hugahie.</char> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/><char style="wj">E'ina hu'negu anage hu'na neramasamue. Nazankuma nunamu hunka Anumzamofo antahima kesunka, hago eri'noe hunka kamentinti hanunka erigahne.</char> <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/><char style="wj">Hagi otinka nunamu hunakuma hanunka, mago'mo haviza hugante'nesnia zana atrento. Anama hanankeno'a, monafi nemania Nafakamo'a kagri'enena kumika'a atregantegahie.</char> <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/><char style="wj">[Hu'neanagi kagra vahe'mofo kefoza atre ozmantesanana, monare mani'nea Nafakamo kagri kefozana ana zanke huno atre ogantegahie.] </char><verse eid="MRK 11:26"/></para>
  <para style="s">Jisasi hanavegu agenoka hu'naza naneke</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Hagi Jerusalemi kumate ete uhanatizageno, Jisasi'a ranmono kumapi nevige'za, ra mono kva vahe'mo'zane, kasegere ugagota hu'naza vahe'mo'zane, mago'a ugagota kva vahe'mo'zane, nege'za Jisasinte e'za, <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>anage hu'za antahige'naze, Kagra ina hihamure hakare zana eri fore nehane? Iza hihamua kamigenka hakare zana nehane? <verse eid="MRK 11:28"/><verse number="29" style="v" sid="MRK 11:29"/>Jisasi'a zamagrikura anage huno hu'ne, <char style="wj">Nagra ete tamagrira mago'zanku tamantahigegahue, ana kenona'a hutenkena, aza hihamu namige'na eri'zana e'nerufi tamasmigahue.</char> <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/><char style="wj">Hagi nasamiho, Jonima mono ti frezmante'nea, zana monafinti e'nefi, vahe'mo erifore hu'ne?</char> <verse eid="MRK 11:30"/><verse number="31" style="v" sid="MRK 11:31"/>Jisasi'a nehige'za zamagra ohumi ahumi nehu'za anage hu'naze. Tagrama monafintire huta hanunkeno'a, Agra anage hugahie. Hagi nahigetma tamentintia ana zankura nosaze? huno hugahie. <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Hianagi vahe'mo eri fore hu'ne, huta osugosune, nehu'za maka veaku koro hu'za atre'naze. Na'ankure maka veamo'za Joninkura tamage kasnampa nere hu'za antahi'naze. <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Anage nehu'za Jisasina kenona hunte'ze, ontahi'none hazageno Jisasi'a anage huno zamasami'ne, <char style="wj">Nagranena iza hihamufi eri'zana enerue ontamasmigahue </char> huno hu'ne.<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s">Hoza nafa'amofo mofavrene eri'za vahe'a zamazeri haviza hu'naza fronka naneke</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Jisasi'a erigafa huno fronka kea zamasami'ne, <char style="wj">Mago mopa agafa ne'mo'a waini hoza kri'ne. Ana hoza kegina huno, wainima tatisia keria asenteteno, mani'neno kvahu nona kinte'ne. Hagi zoka umani'neno enaku ikante zago miza seterehu (rent) vahete, hoza'a netreno afete ka vu'ne.</char> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/><char style="wj">Hagi hozama vasage knama egeno'a, kazokzo eri'za ne'a huntegeno, agri'ma refko hu'za amisnazama'a erisnigu, kegava hune'za ikantema mizama (rent) nezamiza naga'mokizmire e'ne.</char> <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/><char style="wj">Ana hianagi, anama kegavama hu'naza naga'mo'za, azeri'za knonkeve nemi'za, atrageno mago'zana e'ori amane vu'ne.</char> <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/><char style="wj">Ete mago'ane ru kazokazo eri'za ne'a huntegeno vige'za, anu rutane'za ahete'za, ke huhaviza hazageno atreno e'ne.</char> <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/><char style="wj">Ana hazageno ete mago'ene huntegeno vimofona, ahe frigeno hakare'a huzmantege'za nevazageno, mago'a knonkeve nezami'za, mago'a zamahe fri'naze.</char> <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/><char style="wj">Ana hazageno, magoke avesi avesi hunentea mofavrege mani'ne. Ana huzmante vagareteno, henkarfana magoke mani'nea mofavre'a hunenteno, zamagra magoke mofavre ni'agi'za antahimigahaze hu'ne.</char> <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/><char style="wj">Hianagi ana hoza kva hu'naza vahe'mo'za, zamagra zamagra anage hu'naze, nafa'amofo zama erisanti haresia nera ama eanki, enketa ahe frisunkeno nefa fenozamo'a, tagrizase'nie! Hu'za hu'naze.</char> <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/><char style="wj">Ana nehu'za azeri'za ana mofavrea ahe frite'za, avufa'a waini hozafinti megi'a mate vu'naze. </char><verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>
    <char style="wj">Hagi waini hozamofo nefa'a nankna eme hugahie? Agra eno waini hoza kegava krinaza vahera eme zmaheno, waini hoza ru vahe'mokizmi eri zaminke'za, kegava hugahaze.</char> <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/><char style="wj">Hanki ama naneke Anumzamofo avontafepi krente'nazana hampritma ontahinazo? <char style="qt">Nogi vahe'mo'za haviza hie huza atre'naza havemo'a, no renage antepinka no azeri hanaveti have fore hu'ne.</char> </char> <verse eid="MRK 12:10"/><verse number="11" style="v" sid="MRK 12:11"/><char style="wj"><char style="qt">Anumzamo ama anazana hu'neanki, tavuma konana knare zantfa hu'ne. </char> </char> (Sam-Zga 118:22-23.)<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Hagi ana vahe'mo'za azeri'saza kanku hakre'naze. Na'ankure fronka kema hu'neana zamagriku hu'ne. Hianagi zamagra tusi'a vahe kevugu koro nehu'za atre'za vu'naze.<verse eid="MRK 12:12"/></para>
  <para style="s">Takisi zago Sisama amizanku Jisasina antahige'naza naneke</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Hagi Juda kva vahe'mo'za Jisasina rehe'za kema huhaviza hanige'za, ana ke eri'za keaga hunte'naku, mago'a farisi vahe'ene, Heroti naga'ane huzmantage'za vu'naze. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Zamagrama Jisasinte'ma ne-eza anage hu'naze, Hurami ne'moka, tagra antahi'none, kagra tamagege nehunka, mago vahekura koro nosunka, havi vahe'ene fatgo vahe'ene mago'zanke hunka Anumzamofo fatgo kankura rempi huneraminketa nentahune. Hagi knare Sisana takesia amigahumpi omigahune? <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>Hianagi krunage haza nezamageno, anage huno zamasami'ne, <char style="wj">Na'a higetma Nagrira renahetma negaze? Mago zagoa eritma enkena kaneno,</char> <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>hige'za mago zago eri'za eme amizageno, <char style="wj">Iza amema'ane avone me'ne?</char> Hige'za zamagra hu'za, Sisane hu'za hu'naze. <verse eid="MRK 12:16"/><verse number="17" style="v" sid="MRK 12:17"/>Anante Jisasi'a amanage huno hu'ne, <char style="wj">Knareki Sisa zana Sisa amigahaze. Hagi Anumzamofo zana, Anumzamofo amigahaze</char> huno hige'za tusiza hu'za antri hu'naze.<verse eid="MRK 12:17"/></para>
  <para style="s">Fripinti otino arave hanaza zanku antahige'naza naneke?</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Hagi mago'a Satusi mono vahe'mo'za (fripinti o'otigahaze nehaza vahe'mo'za) Jisasinte e'za anage hu'za antahige'naze. <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>Hurami ne'moke, anage huno korapa Mosesi'a avona krerami'ne, mago ne'mo'ma <char style="bdit">ara eriteno mofavre onteno frinkeno'a, nefu ana ara erineno, mofavre kasentesigeno, nefu agimo'a fanane osugahie huno avona krente'ne.</char> (Diu-Kas 25:5-6) <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Hagi 7ni'a kogna mani'nazafinti, agonesa zimimo ara eriteno mofavre onteno frine. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Nagna'amo ana ara eri'ne. Eriteno mofavre onte frigeno, anante'mo'a anazanke huno ana ara eriteno, mofavre onteno fri'ne. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Ana 7ni'a kogna naga'mo'za, magore hu'za mofavre kase onte fri vagaretageno, ana ara henka'a fri'ne. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Fripinti'ma oti knazupa, ana maka kognamo'za fripinti'ma oti'nageno'a, iza a' manigahie? Na'ankure maka ana 7ni'a kognamo'za ana ara kazo eritere hute'za fri'naze. <verse eid="MRK 12:23"/><verse number="24" style="v" sid="MRK 12:24"/>Jisasi'a anage huno zamasami'ne, <char style="wj">Hantagama hazana, tamagra Anumzamofo avontafepi kre'nea kea antahitama ketma osuta, Anumzamofo hihamu'a onkenetma nehazafigure.</char> <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/><char style="wj">Na'ankure fri'nehnafinti'ma oti snazana, arave hu'zana omnesigeno, ara vasi omi ami hu'zana omnesigeno, monafinka ankero vahe'kna hu'za manigahaze.</char> <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/><char style="wj">Hianagi tamage nanekema me'neana frite'za otigahaze. Anumzamo'a onensa zafa tevenerefinti Mosesenku ke higeno antahiteno, avontafepi krente'neana omne'negeta hamprita onkenetma nehazo? Anumzamo amanage huno asami'ne, <char style="qt">Nagra Abrahamu Anumza mani'na, Aisaki Anumza mani'na Jekopu Anumza mani'noe.</char> </char> (Eks-Ati 3:2, 6) <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/><char style="wj">Huno hu'negu, Agra fri vahe'mokizmi Anumzana omani'neanki, kasefa hu'za mani'naza vahe'mokizmi Anumza manine, tamagra tusi'a hantaga nehaze.</char><verse eid="MRK 12:27"/></para>
  <para style="s">Ugota hu'nea kasegemofo naneke</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Hagi mago kasegere ugagota hu'nea ne'mo eme antahiama ke hakare nehazageno, Jisasi'a so'eza huno kenona zamirera nezmasamigeno, ananke eme nentahino, Jisasina antahigeno, Maka kasegefina ina kasegemo vugota hu'ne? <verse eid="MRK 12:28"/><verse number="29" style="v" sid="MRK 12:29"/>Higeno Jisasi'a amanage huno hu'ne, <char style="wj">Kagota kasegea amanahu me'ne, <char style="qt">Israeli vahe'mota antahiho, Ramo'a tagri Anumzane. Rana agrake mani'ne.</char> </char> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/><char style="wj"><char style="qt">Kagra kagu'areti Anumza ka'amofona avesinto, maka kamema'areti hunka avesinto, maka antahintahi ka'areti hunka avesinto, maka hanave ka'areti hunka avesinto hu'ne.</char></char> (Diu-Kas 6:4-5) <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/><char style="wj">Anantera amanahu kasege me'ne, <char style="qt">kagragu kavesi nentanaza hunka tva'onkare'ma mani'nenimofona avesinto.</char></char> (Lev-Pris 19:18) <char style="wj">Ama tare kasegemofona mago kasegemo'e huno znagateore'ne </char> <verse eid="MRK 12:31"/><verse number="32" style="v" sid="MRK 12:32"/>Higeno kasegere ugota hu'nea ne'mo'a anage hu'ne, Hurami ne'moka, tamage hunka hane, Agra magoke mani'neankino magore huno amefiga'a vahera omani'ne. <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Ana hanigeta Anumzamofona tagu'areti avesinteta, maka antahintahireti avesinteta, maka hanavereti avesinteta, tagragu tavesi nentonaza huta tva'onte maninesaza nagara zmavesinte sunazamo'a, Kresramana vuzane, Anumzamofo hakare zanka'a ami'zana agatereno ugagotaza me'ne. <verse eid="MRK 12:33"/><verse number="34" style="v" sid="MRK 12:34"/>Jisasima antahiama ana ne'mo'ma kenona'a hu so'e higeno, anage huno asami'ne, <char style="wj">Kagra Anumzamofo kuma tava'onte mani'nane.</char> Higeno mago'a vahe'mo'za antahige zankura koro hu'za antahi onke'naze.<verse eid="MRK 12:34"/></para>
  <para style="s">Kraisi'a aza mofavre hu'za hu'naza naneke</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Jisasi'ma ra mono nompi rempi hunezamino'a anage hu'ne, <char style="wj">Na'ante kasegere ugagota hu'naza vahe'mo'za Kraisinkura, Deviti nemofo'e nehaze?</char><verse eid="MRK 12:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 12:36"/>
    <char style="wj">Hagi Ruotge Avamu'mo Devitina azeri otigeno amanage hu'ne, <char style="qt">Ramo'a anage huno Ranimofonkura hu'ne, Nazantmaga kaziga trate manige'na, ha' vaheka'a kagafinka zamazeri fenkamu atraneno hu'ne.</char> </char> (Sam-Zga 110:1) <verse eid="MRK 12:36"/><verse number="37" style="v" sid="MRK 12:37"/><char style="wj">Devitima agra'ama huno Ranimo'e hanigeno'a, inankna huno Deviti mofavre manigahie?</char><verse eid="MRK 12:37"/></para>
  <para style="s">Kasegere ugagota hu'naza vaheku kva hanaza naneke</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="LUK 20:45-47">Luk 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Rempima huzamifina Jisasi'a anage huno mago'ene zamasami'ne, <char style="wj">Kasegere ugagota hu'naza vahekura kva hiho. Zamagra za'za kukena hu'za maketi kumapi vano nehazage'za hakare vahe'mo'za nezmage'za muse huzmante zanku zamavesi vahere. </char> <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/><char style="wj">Hanki osi mono nompi vugota hu'nea trate unemaniza, nezama nepina zamagi eri trate nemanize. </char> <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/><char style="wj">Kento a'nemokizmi krunage hu'za fenozimi eneri'za zamo, eama hu'zanku za'za nunamu nehaze. Ana hu'negu ama anazamofo mizama'a, agatere'za ranknaza erigahaze.</char><verse eid="MRK 12:40"/></para>
  <para style="s">Kento a'mo ofa zago ante'nea naneke</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Jisasi'a ra mono nompi, zagoma nentaza taferomofo tva'onte mani'neno zagoma eme antazana zmage'ne. Fenozimi me'nea vahe'mo'za rama'a zago eme ante'naze. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Ana nehageno amunte omane kento a'mo eno, tare osi koranke zago mago toza avamente me'nea erino ana taferopi eme netregeno, <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Jisasi'a amage'ma nentaza disaipol nagara ke hige'za ageno anage huno zamasami'ne, <char style="wj">Tamage hu'na neramasmue, ama amunte omane kento a'mo rama'a zagoa ruga'a vahera zamagetereno taferopina eme ante'ne.</char> <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/><char style="wj">Na'ankure maka vahe'mo'za rama'a ante'nafinti, osi'a ofa zagoa eme ante'naze. Hianagi ama kento a'mo'a amunte omanetfa hunefinti eri'neama'a ante vaga reneankino, miza seno neneno manisiazana omane'ne.</char><verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s">Ra mono no tapage hugahie hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Hagi Jisasi'ma Ra mono nompinti atiramigeno'a, amage'ma nentaza disaipol nagapinti mago'mo'a anage hu'ne, Hurami ne'moke, asinentike havereti'ma hiro naro nontamina ki'nazanki ko! <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/>Higeno Jisasi'a anage huno zamasami'ne, <char style="wj">Tamagra ama hironaro nontami negazo? Mago havemo'a, mago havemofo agofetura omane'tfa hugahie. Mika havemo'a fragu vazi ramigahie.</char><verse eid="MRK 13:2"/></para>
  <para style="s">Maka'zama vagarenaku hania knafi fore'ma hania zamofo naneke</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Anante ra mono nomofo kantu kaziga, Olive agonare Jisasi'a marerino umaninege'za, Pita'ma, Jemisi'ma, Joni'ma, Endru'ma hu'za zamagrake emanine'za Jisasina amanage hu'za antahige'naze. <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>Tagrira tasamio, nankna zupa anazana fore hugahie? Anazama fore hunaku'ma hanigeno'a, nankna avame'za fore hinketa ketenunkeno, ana knazana fore hugahie? hu'za hu'naze. <verse eid="MRK 13:4"/><verse number="5" style="v" sid="MRK 13:5"/>Hazageno Jisasi'a agafa huno zamasami'ne, <char style="wj">Mago'mo havige huno tamavareno havi kante vu'zankura, kva hiho.</char> <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/><char style="wj">Rama'a vahe'mo'za Nagri nagifi ne-eza anage hugahaze, nagra ana ne' ama'i neoe nehu'za, rama'a vahe havi kante zamavrentegahaze.</char> <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/><char style="wj">Hanki ha'ma hania kema nentahita, ha'mofo zaho nanekema antahisanuta korora osiho. E'ina hu'zana fore hugahie. Hianagi vagare kna ome'ne.</char> <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/><char style="wj">Hanki anantera mago kumate naga'mo'za, oti'za mago kumate nagara zamahegahaze. Mago kaziga vahe'mo'za oti'za, mago kaziga vahera ha' rezmantegahaze. Ana nehanageno mago'a kumapina imi e'nerisigeno, mago'a kumapina agate'za fore hugahie. Ama ana zamo'a, a'mo'ma mofavre kasentenaku higeno, agafa huno ata negriankna ataza fore hugahie.</char><verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>
    <char style="wj">Hanki tamagratamia kva hutma maniho. Kanisolo vahete tamavare'za nevu'za, osi mono nompinti tamavre'za kanonkeve ome nerami'za, rankuma kva vahete'ene kini vahe zamavure tamavrentesageta otigahaze. Na'ankure nagriteku ana hanageno, e'i anazama fore'ma haniana nagri musenkema eri'ama hutma nezmasami'za zanteku fore hugahie.</char> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/><char style="wj">Hanki esera maka mopane mopanena vahe'mo'za Knare Musenkea huama hanageno antahi vagaretesageno'e. </char> <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/><char style="wj">Hagi keaga hurmanteku tamazeri'za vanagetma, na'ane huta hugahune hutma antahintahi hakarea osiho. Ana knafima hiho huno'ma hania nanekea amane hiho. Na'ankure ana nanekea tamagra'a osugahazanki, Ruotage Avamumo hugahie.</char> <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/><char style="wj">Ana knafi nefuna ahe frinogu avare nezaminkeno, nefa'a nemofona avreno ahe frinogu ana zanke nehinkeno, mofavremo'za ana zanke huza nerera nefana zamahe frinogu avare zamigahaze.</char> <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/><char style="wj">Maka vahe'mo'za tamagrira zamarimpa kna huneramante'za ha' reramantegahaze. Na'ankure Nagri nagimo'a tamagripi me'negu hu'za anara huramante'gahaze. Hianagi iza'o oti hanavetino manino vu refarega vanimofona agu vazigahie. </char><verse eid="MRK 13:13"/></para>
  <para style="s">Maka'za agtereno haviza hania zamofo naneke</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat 24:15-28</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>Hagi Jisasi'a anage huno zamasami'ne, <char style="wj">Nanekema hampri snamota, nehamprita ama hiho. Tusi'a havizantfa huno agotenesiazamo, agra otiga osu'nenia trate otina, ana knazupa Judiama mani'nesaza veamo'za freza agonare viho. </char> (Dan 9:27, 11:31, 12:11) <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/><char style="wj">Nomofo agofetuma mani'nesamo'za, uramiza nompintira mago'a zana eriza atioramigahaze.</char> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/><char style="wj">Hozafima mani'ne snimo'a, kuma'aregati nakre ku'a eme e'orino. </char> <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/><char style="wj">Ananknafima amu'ene hu'nesnia a'negu'ene, mofavre aminte mani'nesnia a'negura, nasunku huzmantoe.</char> <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/><char style="wj">Hianagi nunamuna nehinkeno, tusi'a zasi knafina anazana forera osino.</char> <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/><char style="wj">Na'ankure ananknafina tusi'a knaza fore hugahiankino, Anumzamo'ma mopama tro hu'nereti eno menima ehanatinerera, fore osu'neankna knaza fore hugahie. Hagi henka'a ana hukna knazana fore osutfa hugahie.</char> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/><char style="wj">Ramo'a ana knama eri atupa osanigeno'a, mago'a vahera omanigahie. Hianagi Nagri vahere huno hunefinti huhampri'nea vahekuma agesama antahiteno, ana kna eri atupa hugahie.</char> <verse eid="MRK 13:20"/><verse number="21" style="v" sid="MRK 13:21"/><char style="wj">Ana knafi mago'a vahe'mo'za hu'za, keho ama'i kraisi'e huge, agra antu mani'ne hanagetma tamentintia osutfa hiho! </char> <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/><char style="wj">Na'ankure ana knafina mago'a havige kraisi'e huza efore nehu'za, kasnampa vahe efore hu'za, haviza hu'za kagu'vazane avame'za hugahaze. Anama hanazana Anumzamo'ma huhampri zmante'nea vahe'mokizmi, rezmataga hu'naku hugahaze. Hianagi zamagra Anumzamo'ma huhampri zamante'nea vahe'ma zamazeri savari hu'nakuma hanuza anara hugahaze.</char> <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/><char style="wj">Hagi tamagra kva hutma maniho! Ana maka'zana fore osunege'na, tamagrira neramasamue.</char><verse eid="MRK 13:23"/></para>
  <para style="s">Vahe'mofo Mofavremo ete esianknamofo naneke</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>
    <char style="wj">Hianagi ana knafina tusi'a knazamo vagama resigeno'a, zagemo hani hanigeno, ikamo'a remsa osanigeno,</char> <verse eid="MRK 13:24"/><verse number="25" style="v" sid="MRK 13:25"/><char style="wj">monafinti hanafi tamimo'za atafri neraminage'za, monafi me'nea hanave zantamimo'za tore hugahaze. </char> (Ais 13:10, 34:4, Joel 2:31-32) <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/><char style="wj">Anante Vahe'mofo Mofavremo'a hampompi, tusi'a hihamu'ane masa'afi ne-esigeta kegahaze.</char> (Dan 7:13) <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/><char style="wj">Anante ankero vahe'a huzmantena, Anumzamo huhampri zamante'nea vahera mona mopa ome tre emetre kazigatira ome zmavare eme zmavare hu'za zamazeri atru hugahaze. </char><verse eid="MRK 13:27"/></para>
  <para style="s">Fiki zafamofo fronka naneke</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>
    <char style="wj">Ama fronka kema fiki zafare'ma hanua fronka kereti antahi'zana eriho. Azanku'namo asinareno amosrema nehegetma, hago zagegna tava'o nehie hutma nentahize.</char> <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/><char style="wj">Hagi tamagra anahu zama fore'ma hanigetma negesnutma, hago Vahe'mofo Mofavre esia kna'a tava'o huno kafante me'ne hutma tamagesa antahiho.</char> <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/><char style="wj">Tamage hu'na tamagrira neramasamue. Ama knafi veamota ofri mani'nesnageno, ana zana fore hugahie.</char> <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/><char style="wj">Monane mopane fanane hugahianagi, Nagri nanekemo'a fanane osu mevava hugahie.</char><verse eid="MRK 13:31"/></para>
  <para style="s">Jisasi'ma esia kna mago vahe'mo'e huno ontahine hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>
    <char style="wj">Hianagi mago vahe'mo'e huno anazama fore'ma hania knane zagenena ontahi'ne. Monare nemaniza ankero vahe'mo'za ontahi'zageno, Mofavre'amo'a ontahi'ne. Nefa Agrake ana kna antahi'ne.</char> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/><char style="wj">Kva hunetma retro hutma maniho. Na'ankure tamagra anazama efore'ma hania kna ontahi'naze.</char> <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/><char style="wj">Amanahu hugahie, mago ne'mo afete vunaku, kazokzo eriza vahe'a noma'a kegava hiho hunezmanteno, magoke magoke eri'za vahe'a eri'za refko hunezamino, kafante kva nekura kavu antenka maninenka kva hu so'e huo huno hunte'ne.</char> <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/><char style="wj">E'ina hu'negu tamagra anahu kna huta, kva hu so'e huta maniho. Nomofo nafa'amo esnia kna ontahi'naze. Kinaga esifi, kenage amu'no esifi, kokore ke nehinkeno esifi, nantera esifi ontahi'naze.</char> <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/><char style="wj">Aru masenenageno, ame huno eno eme tamageno eri fore hanigi, kva hutma maniho.</char> <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/><char style="wj">Hanki tamagri'ma neramasmuana mifka veaku nehue. Kva huso'e hiho.</char><verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s">Kva vahe'mo'za Jisasima ahesnageno frisnia ke retro hu'naza naneke</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Jon 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Hagi Anumzamo'ma Israeli veama kinafinti zamare'nea kanagu antahimi'za zo'ore breti nenaza kna zahufa tare zagegna me'nege'za, ra mono kva vahe'mo'zane, kasegere ugagota hu'naza vahe'mo'zane, Jisasima havige hunte'za oku azerizama ahesaza kanku hake'za ahe fri'naku huge antahige hu'naze. <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>Na'ankure mafka vahe'mo'za ana ne'zama (pasova) nenaza knare'ma ana'ma hanunke'za, ke hakare nehu'za ha' azeri oti'za hugahaze.<verse eid="MRK 14:2"/></para>
  <para style="s">Mago a'mo Jisasina mnanentake masave tagino frente'nea naneke</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="JHN 12:1-8">Jon 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Hagi Jisasi'a Betani kumate ko'ma fugo namumare'nea ne'mofo Saimoni nompi, zamaza tununte manine'za trateti ne'za nenageno, mago a'mo'a zago'amo'a mareri'nea, mananentake masave zafa rafunareti tro hu'naza, alabasta tafempi erino e'ne. Ana tafe avaza'a runagino Jisasina anumpi taginte'ne. <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Hianagi mago'amo'za anampi mani'namo'za zamasigu nehu'za, zamagra zamagra anage hu'naze, Na'a higeno ana masavena amne tagi netre? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Mizante atreta 300'a silva zago nazana erita zamunte omane vahe zamuntesine. Hianagi nahigenka amnefina tagi netrane? Anage nehu'za ana ara kesu'naze. <verse eid="MRK 14:5"/><verse number="6" style="v" sid="MRK 14:6"/>Hianagi Jisasi'a amanage huno zamasmi'ne, <char style="wj">Atrenkeno manino, nahigeta ama ara knanemize? Agra knare so'eza hunenante.</char> <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/><char style="wj">Hianagi zamunte omane veara hakare kna tamagrane mani'nenageta, ina knare'ma, knare tamavu tamavama huzmantenaku'ma hanutma, amne huzamantegahaze. Hianagi Nagra hakare kna tamagranena omanigahue.</char> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/><char style="wj">Agra nazano hunantenaku hiazana hago hunante. Kerifima ufresugu masave frenanteno retro hunante.</char> <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/><char style="wj">Nagra tamage hu'na neramasamue, inantego knare musenkeni'a, eri'za kokankoka ome huama hanarega, ama a'mo hu'nea avu'avamofo agenkea, nehanage'za antahigahaze.</char><verse eid="MRK 14:9"/></para>
  <para style="s">Judasi'ma komoru huno Jisasina ha' vahe avrezmisia naneke</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26:14-16</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Hagi 12fu'a amage'ma nentaza disaipol nagapinti, Judas Iskarioti'a Jisasina komoru huno avrezamisia naneke vugota mono kva vahera ome zamasami'ne. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Ana nanekema nentahiza muse hunte'naze. Judasina zago kamigahune hu'za huvempa kea asamizageno, Jisasima komoru huno ha' vahe zamazampi avare'zamisia, kanku agafa huno hakre'ne.<verse eid="MRK 14:11"/></para>
  <para style="s">Vagare ne'za Jisasi'a disaipol naga'ane ne'nea naneke</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="LUK 22:7-14">Luk 22:7-14</ref>; <ref loc="JHN 13:21-30">Jon 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Hagi (Zo'ore breti nenaza kna efore higeno) ese knazupa kinafinti Anumzamo'ma ozmahe zamagatere'nea kna antahimiza sipisipi afu anenta aheza Kresramana nevaza knazupa, Jisasima amage nentaza disaipol naga'mo'za anage hu'za antahige'naze, Inantega Kagrira kinafinti zmavre'nea knagu antahimi'za nenaza (Pasova) ne'zana retro hugantesunegu kave'nesie? <verse eid="MRK 14:12"/><verse number="13" style="v" sid="MRK 14:13"/>Hazageno Jisasi'a tare disaipol ne'tre amage'ma nentaza nagapinti zanasmino, <char style="wj">Jerusalemi kumapi ufresakeno'a, mago ne'mo'a tima afi kavofi tifino ne-enketa ome tutagiha huntesuta, ana ne' avaririta vugaha'e. </char><verse eid="MRK 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 14:14"/>
    <char style="wj">Hagi ana ne'mo'ma ina nompino umarerisiana, ana nomofo nefana amanage huta antahige'o, Rempi hurami ne'mo'a kagrikura huno, inantega disaipol naga'nianena Anumzamo'ma ozmaheno zamagtere'nea zanku antahimiza nenaza ne'zana, kankamuna me'nea negahune hu'ne. </char> <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/><char style="wj">Hanankeno'a mago hunaraginte nomofo anaga kaziga, ra kakamu me'nesifi agra tanaveri hugahie. Anampina ne'zane sipa ko retro hunte'naze. Ana nompi mareritna ne'zana ome retro huranteho.</char> <verse eid="MRK 14:15"/><verse number="16" style="v" sid="MRK 14:16"/>Anage hige'ne ana netre mokea rankumate vu'na'e. Anante Jisasi'ma zanasami'nea kante fore higene ke'na'e. Anumzamo'ma ozmahe zamagatere'nea knagu antahimiza nenaza ne'zana ome retro hu'na'e. <verse eid="MRK 14:16"/><verse number="17" style="v" sid="MRK 14:17"/>Kinaga sege'za, Jisasi ene amagema nentaza 12fu'a disaipol naga'ane e'naze. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Ne'zane sipare mani'neza ne'za nenageno, Jisasi'a amanage huno zamasmi'ne, <char style="wj">Tamage hu'na neramasamue, amafima magoka nezama nenompinti, mago'moka komoru hunka ha' vahe zamazampi navrentegahane</char>. <verse eid="MRK 14:18"/><verse number="19" style="v" sid="MRK 14:19"/>Hige'za zamarimpamo'a ana kegura kna nehige'za, mago mago'mo'za nagra anara hugahue hunka nehampi? <verse eid="MRK 14:19"/><verse number="20" style="v" sid="MRK 14:20"/>Hazageno Jisasi'a kenona zamirera amanage huno zamasami'ne, <char style="wj">12fu'a nagamotafinti, Nagrane magoka zoumpafinti breti areno nenesnimo'e.</char> <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/><char style="wj">Na'ankure Anumzamofo avontafepi krente'nea kante, Vahe'mofo Mofavremo'a vugahie. Hianagi Vahe'mofo mofavrema komoru huno ha' vahe zamazampima avrente'simo'a, knaza erigahiankina nasunku huntoe. Nererama kase onteasina knare'zantfa hisine!</char><verse eid="MRK 14:21"/></para>
  <para style="s">Jisasi'a bretine wainine zamige'za ne'naza naneke</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>; <ref loc="LUK 22:15-20">Luk 22:15-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Hagi ne'zana nenageno, Jisasi'a mago breti erino Anumzamofo antahigegeno asomu hutegeno, tamanasino nezmino amanage huno zamasmi'ne, <char style="wj">Ama'i Nagri navufe, erita neho.</char> <verse eid="MRK 14:22"/><verse number="23" style="v" sid="MRK 14:23"/>Hagi waini tintafe erino Anumzamofo nunamu huno antahigegeno asomu huntegeno, zamige'za maka'mo'za anampinti ne'naze. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Nenageno amanage huno zamasmi'ne, <char style="wj">Ama'i Nagri korane, ama ana koramo Anumzane huhagerafita manisaza manizana eri kasefa hugahie. Maka'mofonku huno tagine.</char> <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/><char style="wj">Tamage hu'na neramasmue, Waini ragamofo tima'a mago'ene one'na henka'a Anumzamofo kumapi kasefa waini negahue.</char><verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Mono zagame hute'za, atirami'za Olive Agonarega vu'naze.<verse eid="MRK 14:26"/></para>
  <para style="s">Pita'a amagena Jisasi humisnia naneke</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Jon 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Hagi Jisasi'a amanage huno zamasmi'ne, <char style="wj">Tamagra makamota natreta fregahaze. Na'ankure Anumzamofo avontafepina amanage huno krentegeno me'ne, <char style="qt">Anumzamo'na sipisipi afu kva vahe'mofona, ahanena sipisipimo'za panani hu'za ufre efre hugahaze hu'ne.</char> </char> (Zek 13:7.)<verse eid="MRK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 14:28"/>
    <char style="wj">Hianagi fritena otisuna, tamagrira vugota huramante'na Galili vugahue.</char> <verse eid="MRK 14:28"/><verse number="29" style="v" sid="MRK 14:29"/>Higeno Pita'a anage huno Jisasina asami'ne, mika'mo'za katre'za vanazanagi, nagra katrena ovutfa hugahue. <verse eid="MRK 14:29"/><verse number="30" style="v" sid="MRK 14:30"/>Higeno Pitana kenona Jisasi'a amanage huno asami'ne, <char style="wj">Tamage hu'na negasamue, meni kenagera tare zupa kokoremo'a krafa osu'nesigenka, tagufa zupa Jisasina onke'noa nere hunka vahane hugahane. </char> <verse eid="MRK 14:30"/><verse number="31" style="v" sid="MRK 14:31"/>Hianagi Pita'a agra'a kere hu hankavetino, vahane huogantegosue nehuno, amne kagranena friga hanigena frigahue huno hu'ne. Hige'za mika'mo'za ana kege'za hu'naze.<verse eid="MRK 14:31"/></para>
  <para style="s">Jisasi'a Getsameni hozafi nunamu hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Hagi Jisasi'ene amage nentaza disaipol naga'mo'za Getsamenie nehazare ehanati'naze. Anante Jisasi'a zmasamino, <char style="wj">Amare mani'nenkena nunamuna haneno. </char><verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>Anante Pitanki, Jemisinki, Joninki huno zmareno nevigeno, agu'amo'a tusi'gna nehigeno, asunku hu'ne. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Jisasi'a amanage huno zamasmi'ne, <char style="wj">Nagu' namemo'a tusi kna navenesino nahe friza nehianki, amare mani'neta kva hiho.</char> <verse eid="MRK 14:34"/><verse number="35" style="v" sid="MRK 14:35"/>Nehuno osi'a vugamuteno mopafi vutrakahu maseno, Anumzamofonte nunamu ome nehuno, knare'ma hanigeno'a, ana knamo'a evu nagateresie hu'ne. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>Agra huno, <char style="wj">Aba, Nafanimoke! Maka'zana amane hugahane, ama kapua eri atro. Hianagi Nagri navesira ovarario, Kagra kavesi avaririo.</char> <verse eid="MRK 14:36"/><verse number="37" style="v" sid="MRK 14:37"/>Ana huteno eno eme amagema nentaza disaipol nagama zamageana masenageno, Pitanku amanage huno antahige'ne, <char style="wj">Saimoniga kavu mase'nano? Knare osi'agnafina kva krigahampi?</char> <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/><char style="wj">Kvahuta mani'neta, nunamuna nehuta revatgazama esifina evuoramiho. Tamagu'amofona avenesianagi, tamavufamofona hanave'a nomane. </char> <verse eid="MRK 14:38"/><verse number="39" style="v" sid="MRK 14:39"/>Ete mago'ane vuno, anahu kna nunamu ome hu'ne. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Agrama mago'ene ete eno eme zmageana, mase'nagenokino zamuma hari huzamo'a kna huzmante'ne. Na'ane huta ke'arera hugahune hu'za kegura hake'naze. <verse eid="MRK 14:40"/><verse number="41" style="v" sid="MRK 14:41"/>Anante Jisasi'a mago'ene tagufa zupa zamagrite eno, amanage hu'ne, <char style="wj">Tamavu nemaseta manigasa nehazo? Ha vagare! Nagrira knani'a ama eanki keho. Vahe'mofo Mofavrea kumi vahe'mokizmi zamazampi komoru hu'za avrente'gahaze. </char> <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/><char style="wj">Otinketa tagra vamaneno! Keho Nagri'ma komoru huno ha' vahe zamazampima navrentesia nera, ama erava'o nehie. </char><verse eid="MRK 14:42"/></para>
  <para style="s">Komoru hige'za Jisasi azeri'naza naneke</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Jon 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Hagi anankea huvaga ore'negeno, amage'ma nentaza 12fu'a disaipol nagapinti mago'zmimo, Judas Iskarioti anante ehanatine. Agri'enena sondia vahe'mo'za kaziknontamine, kumpa knozmine eri'neza, pristi kva vahe'mo'zane, kasegere ugagota hu'naza vahe'mo'zane, ugota kva vahe'mo'za huzmantage'za e'naze. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Hagi Judasi'a ha' vahe zamazampi komoru huno avrezmi ne'mo'a anage huno zamasami'ne, Amanahu avame'za hugahuanki keho, ome agi'ma antakoma hanuana, e'i ana neki ome azerita kegava huta avreta viho. <verse eid="MRK 14:44"/><verse number="45" style="v" sid="MRK 14:45"/>Hagi Judasi'ma anantema ne-eno'a, Jisasinte hantka huno vuno, Rempi Hurami Nemoke, nehuno agira antako hu'ne. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Anante mafka vahe'mo'za zamaza ante'za, azeri'naze. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Hianagi oti'nazafinti mago'mo kazinknoma'a erisaga huno, ugagota pristi ne'mofo kazokzo eriza ne'mofo agesa rukfri atre'ne. <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>Jisasi'a amanage huno zamasami'ne, <char style="wj">Nahigeta Nagri nazeriku bainati kazintamine kumpa knontaminena eneritma kumzafa vahe zamazeri ku nehazankna hutma neaze?</char> <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/><char style="wj">Maka knane knane, ra mono nompi tamagrane maninena rempi huneramugeta, naze'ori'naze. Hianagi amama fore'ma nehizana, korapa avontafepi kre'nea kemofo avufga'a fore nehie.</char> <verse eid="MRK 14:49"/><verse number="50" style="v" sid="MRK 14:50"/>Anage nehige'za amage'ma nentaza naga'mo'za, atre'za koro fre'naze. <verse eid="MRK 14:50"/><verse number="51" style="v" sid="MRK 14:51"/>Mago nehaza nera amage anteno vu'nea ne'mo'a, mago'a kukena osu'neanki za'za kukenage'za hu'nea ne' azeri'naze. <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>Hianagi ana za'za kukena'a ruzafi atreno, avufa avapa koro fre'ne.<verse eid="MRK 14:52"/></para>
  <para style="s">Jisasina avre'za mono kanisolo vahete vu'naza naneke</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat 26:57-68</ref>; Luk 22:54-55,63-71; Jon 18:13-14,19-24)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Hagi anante Jisasina avare'za ugagota pristi kva nete vazageno, ranra pristi kva vahe'mo'zane ranra kva vahe'mo'zane, kasegere ugota hu'naza vahe'mo'za atru hu'naze. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Pita'a, Jisasina amefi afete avaririno, ugagota pristi ne'mofo kumapi ufre'ne. Teve hegare'nare avufa ome tonehino ra mono noma kegava nehaza ati vahe'ene umani'ne. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Ugagota pristi vahe'mo'zane, maka kanisolo vahe'mo'za Jisasina havige hunte'za ahesnaza ke agafa'agu hakre'naze. Hianagi magore hu'za ke'za eri fore osu'naze. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Rama'a vahe'mo'za havige hunte'nazankino, ana kezmimo'a magoke kantera ovu'ne.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>Mago'amo'za oti'za amanage hu'za havige hunte'za, <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>Tagra nentahunkeno ama ne'mo'a anage hu'ne, Ra mono nona vahe'mo'za zamazanuti ki'naza nona tapage hunetrena, tagufa knamofo agu'afi vahe'mo azanuti onki'nea mono no ru kigahue hu'ne. <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Hianagi kezamimo'a fatgo osu'ne.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Anante ugagota pristi kva ne'mo zamuga otino, anage huno Jisasina antahige'ne, na'ane hunka kezimirera huzmante'gahane? Na'anku Kagrira keaga hunegantaze? <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>Hianagi ke nona'a osu akoheno mani'negeno, mago'ene ugota pristi ne'mo'a antahigeno, Kagra Kraisigo, Mrerisa Anumzamofo mofavremokafi? <verse eid="MRK 14:61"/><verse number="62" style="v" sid="MRK 14:62"/>Jisasi'a huno, <char style="wj"><char style="qt">E'i Nagre </char>kagra negesankeno, Vahe'mofo Mofavremo Anumzamofona <char style="qt">azantmaga kaziga manino </char>hampompi tusi'a hanave'ane egahie.</char> (Eks-Utr 3:14, Sam-Zga 110:1) <verse eid="MRK 14:62"/><verse number="63" style="v" sid="MRK 14:63"/>Anankema nentahino, ugota pristi ne'mo agra'a kukena eri tagato nehuno anage hu'ne. Na'anku mago'enena keagama hufore hunte vahekura hakegahune. <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Hagi tamagra nentahizageno Ramofona huhaviza hunte'ne! Tamagra na'ane hutma hugahaze? Makamo'za huza Anumzamofo huhaviza hunteankino frisie hu'za hunte'naze. <verse eid="MRK 14:64"/><verse number="65" style="v" sid="MRK 14:65"/>Anante mago'amo'za zamavetu ahenente'za avu kisu hune'za, zamaza knonu nehe'za, Kagra kasnampa ke hunka, iza negahefi hufore huo. Mago'a ra mono noma kegava nehaza ati vahe'mo'zanena avugosa ruhapati'za ahe'naze.<verse eid="MRK 14:65"/></para>
  <para style="s">Pita'a Jisasinku, onke'noe hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat 26:69-75</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; Jon 18:15-18,25-27)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Hagi Pita'a ufenkamuteno kva nemofo kumapi mani'negeno, anante ugagota pristi nemofo eri'za mofane zagafinti mago'mo e'no, <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Pita'ma teve tonehino mani'negeno eme negeno, kagranena Nazareti kumateti' Jisasi'ene vanoma nehana ne' mani'nane hu'ne. <verse eid="MRK 14:67"/><verse number="68" style="v" sid="MRK 14:68"/>Hianagi Pita'a vahane huno, nagra antahina kena osu'nogenka nehane! Anante kama emrerite nevigeno mago kokorege hu'ne. <verse eid="MRK 14:68"/><verse number="69" style="v" sid="MRK 14:69"/>Ete ana mofa'mo mago'ene Pita negeno anante oti'naza vahe zmasmino, e'i nera Jisasi amage anteno vano nehia nere huno hu'ne! <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Hianagi ete Pita'a, mago'ene vahane hu'ne. Anante oti'naza vahe'mo'za, osiagna manige'za Pitankura anage hu'za, tamage kagra mago zmimoke. Na'ankure Galili ne' tfa mani'nane. <verse eid="MRK 14:70"/><verse number="71" style="v" sid="MRK 14:71"/>Anante Pita'a Ontahinoa neku nehaze nehuno, nagra tamage ana nekuma havigema hanenkeno'a, huvempa huankino Anumzamo nazeri haviza hanie huno, <verse eid="MRK 14:71"/><verse number="72" style="v" sid="MRK 14:72"/>nehigeno, ame huno mago'ane anante kokorege nehigeno, Pita'a, Jisasi'ma asmi'nea kegu agesa antahi'ne. <char style="wj">Tare zupa kokorege osunenigenka, tagufa zupa Nagrikura onkenoe hunka vahane</char> hugahanema huno asami'nea kegu agesa nentahino zavite'ne.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s">Jisasina Paerotinte avare'za vu'naza naneke</para>
  <para style="r">(Mat 27:1-2,11-14; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>; <ref loc="JHN 18:28-38">Jon 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Hagi nanterame ranra pristi mono kva vahe'mo'zane, ranra kva vahe'mo'zane, kasegere ugagota hu'naza vahe'mo'zane, maka kanisol vahe'mo'za, ome atru hute'za, Jisasina nofi kinte'za avre'za Paeroti ome ami'naze. <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>Paeroti'a agenoka huno, Kagra Jiu vahe'mokizmi kini mani'nano? huno Jisasina antahige'ne. <char style="wj">E'i kagra nehanane </char> huno Jisasi'a hu'ne. <verse eid="MRK 15:2"/><verse number="3" style="v" sid="MRK 15:3"/>Anante ranra pristi kva vahe'mo'za, Jisasinkura rama'a haviza hu'ne hu'za hunte'naze. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Paeroti'a mago'ane agenoka huno, Ko, Kagrira rama'a ke hunegantazanki, Kagra ke zamirera kenona hugahampi? <verse eid="MRK 15:4"/><verse number="5" style="v" sid="MRK 15:5"/>Hianagi Jisasi'a ana kemofo nona'a osu mani'negeno, Paeroti'a tusiza huno antri nehuno agogogu hu'ne.<verse eid="MRK 15:5"/></para>
  <para style="s">Jisasi ahe nefrinka Barabas tamio hu'naza naneke</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Jon 18:39-19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Kafune kafune Anumzamo kinafinti zmavre'nea knama egeno'a, Paeroti'a kina vahepintima zmavesimofonku hazageno kazufe netrea kna e'ne. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Hagi ana knafina mago nera Barabasi'e nehia ne'ene, mago'a kamani vahe'mo'zane ha' hu'naza knafi, vahe zamahe fri'naza zanku kina huzmante'naza vahe'ene anampina mani'naze. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Hagi maka veamo'za Paerotinte e'za, ana kna'ma egeno nehiaza huno kina vahe katufe atresnigu antahige'naze. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Anante Paeroti'a kenona huno anage hu'ne, Jiu vahe kini ne' katufe tamisuegu tamave'nesio? <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Na'ankure agra, ranra pristi kva vahe'mo'za kanive renente'za, avare'za eme ami'zama'a ko antahi'ne. <verse eid="MRK 15:10"/><verse number="11" style="v" sid="MRK 15:11"/>Hianagi ranra pristi kva vahe'mo'za maka vahe zamarimpa rekehu'za, Barabasi kazufe tamio hutma hiho hu'za zmasami'naze. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Anante Paeroti'a mago'ene kenona huno, Jiu vahe kinie hutma nehaza nera, na'a huntesuegu tmave'nesie? <verse eid="MRK 15:12"/><verse number="13" style="v" sid="MRK 15:13"/>Hige'za ete mago'ane kezati'za, Aheta kekazafare hantiho hu'naze. <verse eid="MRK 15:13"/><verse number="14" style="v" sid="MRK 15:14"/>Hianagi Paeroti'a anage huno zamasami'ne, na'a kefoza hune, inankna kefoza hu'negeta aheta hantiho nehaze? Hianagi zamagra mago'ene ranke hu'za, ahe friho hu'naze. <verse eid="MRK 15:14"/><verse number="15" style="v" sid="MRK 15:15"/>Na'ankure Paeroti'a ana maka veamokizmi zamarimpamo so'e hania kazigati, Barabasi kazufe nezamino, Jisasina sefu amiho hige'za, sefu amitazageno keka zafare ahe'za hantisagu avrezmi'ne.<verse eid="MRK 15:15"/></para>
  <para style="s">Sondia vahe'mo'za Jisasina azanva ante'naza naneke</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat 27:27-31</ref>; <ref loc="JHN 19:2-3">Jon 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Anante sondia vahe'mo'za avare'za marerisa kumapi ufre'naze. (E'i ana kumara Gavana ne'mofo kumapi) maka Romu sondia vahetamina ome ke hutru hu'naze. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Zamagra fitunke kukena hunente'za, ave'ave nofite kini vahe'mokizmi fetorikna huza fetori tro hu'za asenire antaninte'naze. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Kezanke hunte'za, Jiu vahe'mofo kinimokagura ferure hugantone. <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Mago'ane kno eriza asenire nemasagi'za, zmavetu ahenente'za, zmarena renamagiza, pri hu'za havi mono hunte'naze. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Zamagrama azanava anteteza fitunke kukena erizafi netre'za, ete Agri kukena eri huntete'za, keka zafare aheza hantinaku megi'a avare'za vu'naze.<verse eid="MRK 15:20"/></para>
  <para style="s">Keka zafare Jisasina ahe'naza naneke</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Hagi Sairini kumateti ne' Saimoni, (Aleksendane Rufusikizni neznafa) fegu'ati rankumapi evu frenaku enevige'za, Jisasi keka zafa'a erio hu'za hunente'za kofintageno eri'ne. <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Hagi Jisasina avare'za Golgote nehaza agonare uhanati'naze. (Tagri kefima rukrahe'ma hanunana, anu zaferine hu'ne.) <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Anante waini tine mere zafa arima'ane magopi taginte'za eri havia hute'za tagiami'zana, one atre'ne.<verse eid="MRK 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 15:24"/>Hagi Jisasina rugeka zafare ahe'za hantite'za, mago'mo tagatere simo erisie nehu'za taisi zokogo re'za kukena'a refko hu'naze. <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>Nanterama zage hanatino 9 kiloki hige'za, Jisasina rugeka zafare ahe'za hanti'naze.<verse eid="MRK 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 15:26"/>Ahe'naza nanekemofo agafa'ama avoma krente'nazana, JIU VAHE'MOKIZMI KINI NERE, hu'za krente'naze. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Ana nehu'za tare kumzafa netrena magoka zanahete'za, magomofona azantmaga'a nehantiza, magomofona hoga'a hanti'naze. <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>[Ana hazageno korapa'ma Anumzamofo avontafepima kre'nea kemofo avufga'a efore' hu'ne. Ana kemo'a, hazenke vahe'kna hugahie hu'ne (Ais 53:12)]. <verse eid="MRK 15:28"/><verse number="29" style="v" sid="MRK 15:29"/>Hagi anante'ma vute ete nehu'za vahe'mo'za azanva ke hu'za, Oho! Kagra ra mono nona tapage hunka tagufa knafi kigahue hu'nana nere, nehu'za zmage'na ru'naze. <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>Kagra ka'a kaza hunka keka zafaretira eramio, hu'naze! <verse eid="MRK 15:30"/><verse number="31" style="v" sid="MRK 15:31"/>Anahukna hu'za ranra pristi kva vahe'mo'zane kasegere ugagota hu'naza vahe'mo'za, azanva ke hunte'za, Ru vahe azama nehiaza huno Agra'a aza osugahifi? <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>Atregeno Kraisi'a Israeli vahe'mokizmi kini ne'mo'a, keka zafaretira menina eraminketa negeta, tamentinti hamaneno! Tare ne'trema keka zafare'ma ahe'za hanti'naza ne'tremokea, anazanke huke Jisasina azanava ke hunte'na'e.<verse eid="MRK 15:32"/></para>
  <para style="s">Jisasi fri'nea naneke</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Jon 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Hagi ana knazupa zagemo'a feru trage higeno, maka ana mopafina hanimo refitegeno vuno kinaga 3 kiloki higeno rumasa hu'ne. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Tri (3) kiloki higeno Jisasi'a Arami kefinti ranke huno kezatino, <char style="wj">ELOI ELOI LEMA SABATANI?</char> Anankemofo agafa'amo'a anage hu'ne, <char style="wj"><char style="qt">ANUMZANIMOKE ANUMZANIMOKE, NAHIGENKA KAMAGENA HUNENAMINE?</char> </char> (Sam-Zga 22:1.)<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Hanki tava'onte mani'naza vahe'mo'za nentahi'za, anage hu'naze, Antahiho, Elaijanku ke nehie hu'za hu'naze. <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>Hagi mago'mo aga reno vuno mi'mi'tata hu'nea waini timpi kapukua ome reteno, zotare vazigase huno erino Jisasi'ma nesigu eme nemino anage hu'ne, Atrenenketa Elaijama eme avarefenka atresigura kamneno! <verse eid="MRK 15:36"/><verse number="37" style="v" sid="MRK 15:37"/>Hianagi Jisasi'a rankrafa nehuno, vagare asimu anteteno fri'ne. <verse eid="MRK 15:37"/><verse number="38" style="v" sid="MRK 15:38"/>Ana nehigeno ra mono nomofo agu'afi hanti'naza tavaravemo, anagamuti ruhakeke hutare huno henkamu erami'ne. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Hanki 100'a sondia vahete kva (centurian) ne'mo Jisasina avuga mani'neno Jisasima nefrinoma hiazana keteno anage huno hu'ne. Tamage ama nera Anumzamofo Mofavre mani'ne huno hu'ne! <verse eid="MRK 15:39"/><verse number="40" style="v" sid="MRK 15:40"/>Hagi mago'a a'nemo'za ogantu'a mani'ne'za uruha ke'naze. Ana a'nefina, Makdala kumateti Mariaki, Saromeki mago Mariaki (osi Jemisine, Josefekizni neznareraki) hu'za mani'naze. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Ana a'ne zagamo'za Jisasi Galili mopare mani'nege'za amage nente'za aza nehaza ane zagane, mago'a anampina Jerusalemi ne-ege'za avaririza e'naza ane zagane mani'naze.<verse eid="MRK 15:41"/></para>
  <para style="s">Jisasi'ma asente'naza naneke</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Jon 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>Hagi anazama fore hu'neana Frante zupa kinage. Mani fru hukna esigu (Sabat) retro tra nehaza kna e'ne. <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>Arimatia kumateti ne' Josefe'a koro osu hanave enerino, Jisasi avufa'ama erisigu Paeroti ome antahige'ne. (Ana nera kanisol vahepina agi me'negeno, Anumzamofo Kuma esigu nentahino aveganentea nere.) <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>Hagi Jisasi'ma frine higeno'a, Paeroti'a antri nehuno, 100'a sondia vahete kva (centurian) ne' ke huno frinesigu antahige'ne. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Ana sondia kva ne'mo hago fri'ne huno Paerotina asmigeno, Knareki avufga'a erinka vuo huno Josefena hunte'ne. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Higeno Josefe'ma efeke tavrave miza huno avufa'a eri mopafi atreno, ana efeke tavravenu kazrinteno, havefi frage'za tro hunte'naza kerifi ome asenteteno, have rekrehe huno kama ufrete runkanire'ne. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Makdala kumateti Mariaki, mago Mariaki Josefe nereraki huke anama asentea kumara ke'na'e.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s">Jisasi'a fripinti oti'nea naneke</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Hagi mani fruhu kna (Sabat) vagarege'za Makdalati Mariaki, mago Maria Jemisi nereraki, Salomeki hu'za mananentake masave Jisasi avufare ome frentenaku miza se'naze. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Ana wikimofo ese knazupa (Sonta) nanterame zage nehanatige'za, Jisasi kerirega vu'naze. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Nevu'za ontahige antahige hu'za, kerimofo kafantema rehiza hu'nea havea iza rekrehe hutregahie, hu'za hume vu'naze. <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>Hianagi tusi'a haveagi, ko revahe hutrenege'za ome ke'naze. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Anante have kerigampi ufre'za kazana, mago nehaza ne'mo efeke kukena huno tamaga'a kaziga mani'nege'za ome nege'za zamagogogu hu'naze. <verse eid="MRK 16:5"/><verse number="6" style="v" sid="MRK 16:6"/>Hianagi anage huno zamasami'ne, Tamagogogura osiho. Nazareti Jisasima keka zafarema ahe'naza ne'ku nehakaze. Hianagi Agra ko oti'ne. Amafina omanine, avufa'ama ante'nazarera ami'nagi keho! <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Hianagi vutma amage'ma nentaza disaipol naga'ane, Pitanena ome zmasamiho, Agra vugota huno Galili vu'ne, koma tmasami'nea kante antetma anantega Jisasina ome kegahaze. <verse eid="MRK 16:7"/><verse number="8" style="v" sid="MRK 16:8"/>Anagema hige'za zmagare'za keria atre'za atinerami'za, zmahirahi nerege'za zamagogogu hu'naze. Na'ankure zamagra koro nehu'za, mago vahere hu'za ozmasami'naze.<verse eid="MRK 16:8"/></para>
  <para style="s">Jisasi'a amage'nentaza disaipol nagate efore hu'nea naneke</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="JHN 20:11-18">Jon 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>[Hagi ana wikimofo ese zupa (Sonta), nanterame Jisasi'a fri'nefinti otiteno, esera Makdala kumate a' Mariana, 7ni'a havi avamu agu'afi mani'negeno eri atrente'nea ate efore hu'ne. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Hagi Jisasi'ene vano nehaza vahe'mo'za zavi krafage nehazageno ana a'mo'a ome zamasami'ne. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Ana a'mo'a, Jisasi'a otino asimu erino maninege'na ke'noe huno'ma hia kegura, antahi omi'naze.<verse eid="MRK 16:11"/></para>
  <para style="s">Tare amage'ma nenta'a disaipol netremoke Jisasi ke'na'a naneke</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luk 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Hagi ana'ma hutegeno tare netremo'kea Jerusalemi atreke fegi'a nevakeno, Jisasi avufagamo'a ruzahe nehigeno zanagrite efore hu'ne. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Fore nehige'ne kete'ne rukrehe hune e'ne, mago'a disaipol nagama mani'namokizmi eme zamasamizage'za, anankegura zamentinti osu'naze.<verse eid="MRK 16:13"/></para>
  <para style="s">Jisasi'a amage nentaza naga'a eri'za zmi'nea naneke</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Jon 20:19-23</ref>; <ref loc="ACT 1:6-8">Apo 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Ana huteno 11ni'a amage'ma nentaza disaipol nagatera, ne'za nene'za maninageno, Jisasi'a zmagrite efore nehuno, frinefinti oti'ne hu'za zmasami'naza kere antahi ozami'naza zankura, nahigeta tamentintia osu'naze huno ke zamasu'ne. <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>Anage hu'ne, <char style="wj">maka moparega vutma Knare Musenkea ome huama hutma, hakare vahera zamasamiho.</char> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/><char style="wj">Hagi iza'o Nagrite'ma amentinti nehuno, mono ti fresnimofona Anumzamo'a agu'vazina knare huno manigahie. Hianagi iza'o amentinti osanimo'a, keagafi manino fanana hugahie.</char> <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/><char style="wj">Hagi zamentinti hanamo'za amanahu avame'za erigahaze. Nagri nagirera havi avamura hunente'za, kasefa zamageru arugahaze.</char> <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/><char style="wj">Ha' osifa'vea zamazanu azeneri'za, avuataga zama nesnaza'zamo'a zamazeri haviza nosinke'za, kri vahete zamazama antesageno'a, krizamimo'a amane hinke'za, knare hu'za manigahaze.</char><verse eid="MRK 16:18"/></para>
  <para style="s">Jisasina avregeno monafi mareri'nea naneke</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk 24:50-53</ref>; <ref loc="ACT 1:9-11">Apo 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Hagi anagema huno Rana Jisasima zamasmitegeno'a, Anumzamo'a Jisasina avareno monafi marerino, azantmaga kaziga ome antegeno mani'ne. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Ana huno vutege'za, amage'ma nentaza naga'mo'za maka kaziga vano nehu'za, Ramofona ke'a huama nehazageno, Jisasi'a ana kezmia eri hanavetino avame'zane, kaguva'zanena anama hazankefina hu'ne].<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
