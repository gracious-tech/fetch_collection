<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id" />
  <para style="h">1 Juan</para>
  <para style="toc3">1 Jn.</para>
  <para style="toc2">Ye's ner jwan' mke' Juan</para>
  <para style="toc1">Yeꞌs ner jwanꞌ mkeꞌ apóst Juan</para>
  <para style="mt">Yeꞌs ner jwanꞌ mkeꞌ Juan</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Diꞌs ndaꞌ yalnaban</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Tej náꞌ lo goꞌ jwanꞌ nzola xata mdobte nera, jwanꞌ mbin náꞌ, jwanꞌ mbwiꞌ lo náꞌ, jwanꞌ mne náꞌ nde kon yaꞌ náꞌ mbwal náꞌ jwanꞌ nak Diꞌs ndaꞌ yalnaban. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Tak leꞌ yalnaban mbroꞌtoy lo men nde mbwiꞌ náꞌy, nde ndaꞌ náꞌ kwent chanꞌ naꞌy nde ndej náꞌ leꞌy nak yalnaban adiꞌ, leꞌy ndo kon Xud naꞌ Dios nde mbroꞌtoy lo náꞌ. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Jwanꞌ mbwiꞌ náꞌ nde mbin náꞌ, jwanꞌ naxa ndotej náꞌ lo goꞌ, sa thita gak naꞌ, nde lipa thita gak naꞌ kon Xud naꞌ Dios nde kon xinꞌ Xaꞌ Jesucrist. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Jwanꞌ reꞌ ngekeꞌ náꞌ lo goꞌ, sa thiptane yo nale lazoꞌ reta naꞌ.<verse eid="1JN 1:4" /></para>
  <para style="s">Dios nak xni</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Jwanꞌ reꞌ nak jwanꞌ mbin náꞌ mdej Jesucrist lo náꞌ nde jwanꞌ naga ndeja náꞌ lo goꞌ: Dios nak xni, nde naꞌndonod Xaꞌ nek lud yalꞌkow. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Tez gab naꞌ, thita nak naꞌ kon Xaꞌ, nde ngetenꞌ lo yalꞌkow, nkwinꞌ naꞌ nde naꞌngelid naꞌ jwanꞌ galꞌpa. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Per tez ngetenꞌ lo xni, ta xa ndo Dios lo xni, zyasa thita gak reta naꞌ, nde ren chanꞌ Xinꞌ Xaꞌ Jesús, tombiy naꞌ lo reta xken naꞌ.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Tez gab naꞌ naꞌngenod naꞌ yalke, leꞌga lazonꞌ nge kwinꞌnonꞌ, nde nandlid naꞌ jwanꞌ galꞌ. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Per tez xobdol naꞌ reta xken naꞌ lo Dios, mnega naꞌ leꞌ Dios nak Xaꞌ galꞌ, tonꞌ Xaꞌ reta xken naꞌ nde tombi Xaꞌ naꞌ lo reta jwanꞌ narax mblinꞌ. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Tez gab naꞌ, tera linꞌ yalke, zyasa ndlilal naꞌ Dios Xaꞌ kwinꞌ, tak teraꞌ lipa lazonꞌ xkiꞌs Xaꞌ.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Crist, nak Xaꞌ ndlaꞌstonꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Xinꞌ bix na, re jwanꞌ reꞌ ngekeꞌn lo goꞌ sa nalid goꞌ yalke. Per tez nzo goꞌ ndli yalke, ngenonꞌ ti Xaꞌ ak ronꞌ jwanꞌ ndlaꞌstonꞌ lo Xud naꞌ Dios, Xaꞌ ya nak Jesucrist, Xaꞌ galꞌ. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Nde Jesucrist nak Xaꞌ mdayaꞌ lazonꞌ lo Dios, sa mbyax reta xken naꞌ nde naꞌnakte benꞌta xken naꞌ, noga xken reta men nzi dib lo izyoy.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Nde jwanꞌ reꞌ mnenꞌ ke nzolonꞌ Xaꞌ, tez xobyek naꞌ re yalnyebeꞌ chanꞌ Xaꞌ. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Leꞌ men jwanꞌ mbez: “Nzolon Dios”, nde nanxobyekta xaꞌ re yalnyebeꞌ chanꞌ Dios, xaꞌ ya nak xaꞌ kwinꞌ, nde naꞌndonod xaꞌ jwanꞌ li lenꞌ lazoꞌ xaꞌ. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Leꞌ men jwanꞌ nxobyek xkiꞌs Dios, lazoꞌ men ya ndloꞌpa mxyut yalkeꞌ lazoꞌ chanꞌ Dios nde cheꞌ sa mnenꞌ ndonopa naꞌ Dios. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Xaꞌ jwanꞌ mbez tiblaꞌ ndono xaꞌ Dios, ndablo kete xaꞌ xa mkete Jesús.<verse eid="1JN 2:6" /></para>
  <para style="s">Yalnyebeꞌ kub</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Wes na, ptan na, naꞌngeket na yalnyebeꞌ kub lo goꞌ, leꞌn ngekeꞌ yalnyebeꞌ gox nzola neraꞌ, jwanꞌ ngenola goꞌ senꞌ mdobte mbli lazoꞌ goꞌ Crist. Leꞌ yalnyebeꞌ reꞌ nzolay pola, naka diꞌs jwanꞌ mbin goꞌ senꞌ lo mdobte mbli lazoꞌ goꞌ Xaꞌ. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Nde taga, ngekeꞌn yalnyebeꞌ reꞌ xaja jwanꞌ kuba lo goꞌ, jwanꞌ reꞌ ndloꞌy mod galꞌ mkete Jesucrist nde tagaꞌ galꞌ ngete goꞌ, tak leꞌ yalꞌkow ndorid ndaba nde leꞌ xni jwanꞌ nak lipa ndotoxniley.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Tez cho xaꞌ mbez ndo xaꞌ lo xni nde ngiꞌno xaꞌ ta men xaꞌ, xaꞌ ya benꞌ ndo lo yalꞌkow. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Leꞌ xaꞌ nkeꞌ lazonꞌ ta men naꞌ, xaꞌ ya tiblaꞌ ndo lo xni nde naꞌngenta jwanꞌ cheb xaꞌ. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Leꞌ xaꞌ jwanꞌ ngiꞌno ta men xaꞌ, ndo xaꞌ nde ngete xaꞌ lo yalꞌkow nde naꞌnyed xaꞌ plo nda xaꞌ, tak leꞌ yalꞌkow mtokowa lo xaꞌ.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Ngekeꞌn jwanꞌ reꞌ lo goꞌ, xinꞌ bix na, tak Dios mtonꞌla reta xken goꞌ por kwent chanꞌ Jesucrist. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Ngekeꞌn jwanꞌ reꞌ lo re goꞌ men gox, tak mbyolo goꞌ Xaꞌ jwanꞌ nzola axta senꞌ mdobte mdoxkwaꞌ izyo. Ngekeꞌn jwanꞌ reꞌ lo re goꞌ, or yenꞌ, tak goꞌ mbli gan lo maxuꞌ.</para>
  <para style="p" vid="1JN 2:13">Ngekeꞌn jwanꞌ reꞌ lo re goꞌ mey bix, tak mbyolo goꞌ Xud naꞌ Dios. <verse eid="1JN 2:13" /><verse number="14" style="v" sid="1JN 2:14" />Mkeꞌn jwanꞌ reꞌ lo re goꞌ men gox, tak mbyolo goꞌ Xaꞌ jwanꞌ nzola axta senꞌ mdobte mdoxkwaꞌ izyo. Mkeꞌn jwanꞌ reꞌ lo re goꞌ, or yenꞌ, tak ne ndo goꞌ nde leꞌ xkiꞌs Dios tiblaꞌ ndonoy goꞌ nde mbli goꞌ gan lo maxuꞌ.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Naꞌkeꞌd lazoꞌ goꞌ yalnarax lo izyo reꞌ, neka re jwanꞌ narax ndli re men. Tez nzo xaꞌ nkeꞌ lazonꞌ re jwanꞌ na, lenꞌ lazoꞌ xaꞌ ya naꞌngenta yalkeꞌ lazoꞌ chanꞌ Xud naꞌ Dios. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Tak reta jwanꞌ reꞌ nzo lo izyo, re jwanꞌ ndyen belꞌ men, re jwanꞌ ndyen ngud lo men nde re xaꞌ nchak naro lo re jwanꞌ toz ngeno xaꞌ, reta jwanꞌ reꞌ naꞌndede lo Xud naꞌ Dios, leꞌy ndryoꞌ lo izyo reꞌ. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Nde re jwanꞌ narax lo izyo reꞌ ndluxa kon re xgab naꞌy, per men ndli jwanꞌ ncholas Dios, men ya mban thiptane.<verse eid="1JN 2:17" /></para>
  <para style="s">Xaꞌ ntokan men</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Xinꞌ bix na, ndosinla wiza nde xa nchonla goꞌ, leꞌ xaꞌ kwinꞌ mbez nak Crist ndela xaꞌ, taga naya jwanꞌ toz ndoroꞌtola re xaꞌ kwinꞌ mbez nak Crist, jwanꞌ nasa mnenꞌ ndosinla wiza. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Re xaꞌ reꞌ, mbroꞌ xaꞌ xij naꞌ, per naꞌnakta xaꞌ men naꞌ, tak tez ngak xaꞌ men naꞌ, nxek xaꞌ ngyanꞌ xaꞌ kon naꞌ, per mbroꞌte xaꞌ xij naꞌ sa ndloꞌ ke naꞌnakta re xaꞌ nak men naꞌ.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Leꞌ goꞌ ngeno Mbi Nayon jwanꞌ mdaꞌ Crist, nde nzolola goꞌ reta jwanꞌ chanꞌ Dios. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Ngekeꞌn jwanꞌ reꞌ lo goꞌ, tak nzolo goꞌ kwan nak jwanꞌ li, naꞌnakte tak naꞌnzolod goꞌy nde goꞌ mne ke lo jwanꞌ li naꞌndeda nek tib jwanꞌ kwinꞌ.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />¿Cho nak xaꞌ kwinꞌ? Xaꞌ ta nkalaꞌs ke Jesús nak Xaꞌ jwanꞌ mtelꞌ Dios, xaꞌ reꞌ nak xaꞌ ntokan men, xaꞌ jwanꞌ nkalaꞌs Xud naꞌ Dios nde Xinꞌ Xaꞌ Jesús. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Reta xaꞌ jwanꞌ nkalaꞌs ke Jesús nak Xin Dios, xaꞌ ya nandonoda Dios, nde leꞌ xaꞌ jwanꞌ ndej ke Jesús nak Xinꞌ Dios, xaꞌ ya ndono Dios.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Jw vxwanꞌ ta mbin goꞌ lo senꞌ mdobte goꞌ, jwanꞌ na tiblaꞌ yo lazoꞌ goꞌ, nde tez jwanꞌ mbin goꞌ zya tiblaꞌ nzoy lazoꞌ goꞌ, zyasa tiblaꞌ ndono goꞌ Dios nde ndono goꞌ Xinꞌ Xaꞌ Jesucrist. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Nde jwanꞌ mkeꞌyek Xaꞌ taꞌ Xaꞌ lonꞌ, jwanꞌ na nak yalnaban adiꞌ.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Mkeꞌn jwanꞌ re lo goꞌ, sa ndawiꞌ toz goꞌ lo re xaꞌ jwanꞌ ncholaꞌs kwinꞌno goꞌ. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Leꞌ Mbi Nayon jwanꞌ mdaꞌ Crist mkayaꞌ goꞌ, tiblaꞌ nzoy lenꞌ lazoꞌ goꞌ. Nde naꞌnakinꞌta goꞌ nek tib men loꞌy lo goꞌ, tak leꞌga Mbi Nayon ndloꞌ reta jwanꞌ lo goꞌ nde naka jwanꞌ li, nakte jwanꞌ kwinꞌ, nde xata mbloꞌ Mbi Nayona lo goꞌ, tata tiblaꞌ ptono goꞌ Xaꞌ.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Nde naya, xinꞌ bix na, tibla ptono goꞌ Jesucrist, sa senꞌ lo ryoꞌto Xaꞌ, naꞌzyepta naꞌ nde senꞌ yed Xaꞌ naꞌtyolaꞌsta naꞌ ryoꞌtonꞌ lo Xaꞌ. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Tez mne goꞌ Jesucrist nak Xaꞌ galꞌ, ndabloga nye goꞌ, re men ndli jwanꞌ galꞌ, men ya nak xinꞌ Dios.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Re xaꞌ nak xinꞌ Dios</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Bwiꞌ goꞌ plopa bro toz mkeꞌ lazoꞌ Xud naꞌ Dios naꞌ, sa naya ndolenꞌ xinꞌ Dios; jwanꞌ nasa re xaꞌ naꞌndlid lazonꞌ Dios nayolod xaꞌ naꞌ, tak nambyolod xaꞌ Dios. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Wes na, ptanꞌ na, naya nakla naꞌ xinꞌ Dios, nde tenye tera loꞌ cho kwan ak naꞌ yoloba, mnela naꞌ senꞌ lo ryoꞌto Jesucrist, ak naꞌ xaxa nak Xaꞌ, tak xata nya Xaꞌ ta winꞌ Xaꞌ. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Nde re men jwanꞌ ngembed jwanꞌ reꞌ, lega xaꞌ nkwanꞌ xaꞌ nambi tyo xaꞌ lo Dios, ta xa nambi nak Jesucrist.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Reta men ndli jwanꞌ narax, nanxobyekta xaꞌ ley chanꞌ Dios, tak reta jwanꞌ narax ngiꞌsa ley chanꞌ Dios. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Nde mne goꞌ, leꞌ Jesús mbyed kib reta xken naꞌ, nde naꞌnchapta Xaꞌ nek tib yalke. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Reta men jwanꞌ thiblaꞌ ndono Jesús, nandlid men jwanꞌ narax, leꞌ reta xaꞌ ndli jwanꞌ narax, tera yen xaꞌ cho nak Jesús, neka nzolo xaꞌ Jesús. <verse eid="1JN 3:6" /><verse number="7" style="v" sid="1JN 3:7" />Xinꞌ bix na, naꞌtaꞌda goꞌ diꞌs kwinꞌno xaꞌ goꞌ, tak xaꞌ ndli jwanꞌ galꞌ, galꞌ nak xaꞌ, xaxa galꞌ nak Jesús. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Tak xaꞌ ndli jwanꞌ narax, xinꞌ maxuꞌ nak xaꞌ, tak maxuꞌ ndli jwanꞌ narax xata mdobte mdoxkwaꞌ izyo. Jwanꞌ nasa mbyed Xinꞌ Dios, mbyed sil Xaꞌ reta jwanꞌ ndli maxuꞌ.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Reta men jwanꞌ nak xinꞌ Dios, nandlid men jwanꞌ narax, tak leꞌ yalnaban chanꞌ Dios nzo bina lenꞌ lazoꞌ men nde naꞌnyeda li men jwanꞌ narax tak leꞌ men nak xinꞌ Dios. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Jwanꞌ reꞌ ndloꞌ xanya men nak xinꞌ Dios nde xanya men nak xinꞌ maxuꞌ, re xaꞌ jwanꞌ nandlid jwanꞌ galꞌ nde ngiꞌno xaꞌ ta men xaꞌ, xaꞌ ya naꞌnakta xinꞌ Dios.<verse eid="1JN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Tak diꞌs reꞌ nak jwanꞌ mbin ner goꞌ: Ndablo keꞌ lazonꞌ ta men naꞌ. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Naꞌlid naꞌ xa mbli Caín, xaꞌ ngok xinꞌ maxuꞌ mbij xaꞌ wes xaꞌ. ¿Nde kwan nak yalke mbij xaꞌ wes xaꞌ? Tak re jwanꞌ mbli xaꞌ naka jwanꞌ narax, nde leꞌ jwanꞌ mbli wes xaꞌ naka jwanꞌ galꞌ.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Wes na, ptanꞌ na, naꞌyoyenta goꞌ tez re men jwanꞌ nandlid lazonꞌ Dios, ngiꞌno xaꞌ goꞌ. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Leꞌ naꞌ mnenꞌ, mbronꞌ lo yalguj nde mblanꞌ lo yalnaban, tak nkeꞌ lazonꞌ re ta men naꞌ, leꞌ xaꞌ naꞌnkeꞌd lazonꞌ ta men naꞌ, tata benꞌ nzo xaꞌ lo yalguj. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Tak re xaꞌ ngiꞌno ta men naꞌ, nak xaꞌ, xaꞌ guj men. Nde mnela goꞌ nek tib xaꞌ guj men naꞌndonod xaꞌ yalnaban adiꞌ. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Lo ta mdayaꞌ Jesús yalnaban chanꞌ Xaꞌ por naꞌ, tamod sa mbyolonꞌ yalkeꞌ lazoꞌ, nde taga naꞌ, ndablo tayanꞌ yalnaban chanꞌ naꞌ por reta ta men naꞌ. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Tez cho xaꞌ nkeno bro jwanꞌ lo izyo reꞌ nde ngwiꞌ xaꞌ ti ta men xaꞌ ndyak yalti, nde naꞌndlata lazoꞌ xaꞌ men ya, ¿xamod keno xaꞌ ya yalkeꞌ lazoꞌ chanꞌ Dios lenꞌ lazoꞌ xaꞌ sa? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Xinꞌ bix na, leꞌ yalkeꞌ lazoꞌ men naꞌakte benꞌta diꞌs, nekla benꞌta tyoba ro men, ndablo li mena nde lipa aka.<verse eid="1JN 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Cheꞌ, sa ncholonꞌ ndonꞌ lo jwanꞌ li,<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">ndonꞌ lo jwanꞌ li nak, ban naꞌ xaꞌ ncholaꞌs Dios nde nak naꞌ men Dios.</char></note> nde yo ne lazonꞌ lo Dios, <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />nde tez lazonꞌ mbeza lonꞌ nchap naꞌ yalke, cho leꞌa Dios, mas naro nak Xaꞌ lo lazonꞌ, nde mne Xaꞌ reta jwanꞌ. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Wes na, ptanꞌ na, tez lazonꞌ ndenꞌ na galꞌ ndonꞌ, zyasa dib laꞌs ndonꞌ lo Dios. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />Nde choja jwanꞌ nyaꞌb naꞌ lo Xaꞌ, taꞌ Xaꞌy, tak nxobyek naꞌ yalnyebeꞌ chanꞌ Xaꞌ nde ndlinꞌ re jwanꞌ ndryoꞌ lazoꞌ Xaꞌ. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Nde jwanꞌ reꞌ nak yalnyebeꞌ chanꞌ Dios: Ndablo thiptane li lazonꞌ le Jesucrist Xinꞌ Dios nde keꞌ lazonꞌ ta men naꞌ, xata mnabeꞌ Xaꞌ lonꞌ. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Nde leꞌ men ndli jwanꞌ nyebeꞌ Dios, tiblaꞌ ndono men Dios nde tiblaꞌ ndono Dios men. Nde mnenꞌ leꞌ Dios tiblaꞌ ndono Xaꞌ naꞌ tak mdaꞌ Xaꞌ Mbi Nayon chanꞌ Xaꞌ lonꞌ.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Xbi chanꞌ Dios nde xbi chanꞌ maxuꞌ xaꞌ ntokan men</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Wes naꞌ, ptanꞌ na, nanakta re xaꞌ jwanꞌ mbez ndono Xbin Dios, li lazoꞌ goꞌ, ndablo blibeꞌ goꞌ nyenꞌ cho liga Xbin Dios ndono xaꞌ. Tak lo izyo reꞌ jwanꞌ toz ndoyoche re xaꞌ kwinꞌ mbez ndyodiꞌs xaꞌ xkiꞌs Dios.<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">xaꞌ reꞌ nak profet kwinꞌ</char></note> <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Nde mod reꞌ yolo goꞌ xaꞌ ndono Xbin Dios. Reta xaꞌ mbez Jesucrist mbyed lo izyo ngok Xaꞌ ti men, xaꞌ ya ndono Xbin Dios. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Leꞌ xaꞌ nambezta Jesucrist mbyeꞌd ngok men lo izyo reꞌ, xaꞌ ya nandonoda xbin Dios, nde xbi ya nak xbin xaꞌ ngino Crist, xbi jwanꞌ mbinla goꞌ yed nde leꞌ xbi ya nzolay lo izyo reꞌ naya.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Xinꞌ bix na, goꞌ nak xinꞌ Dios nde mbli goꞌ ngoyo re xaꞌ kwinꞌ ya, tak Xaꞌ jwanꞌ nzo lenꞌ lazoꞌ goꞌ naro toz nak yalnyebeꞌ chanꞌ Xaꞌ lo xbi jwan ndono re xaꞌ kwinꞌ ya. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Tak re xaꞌ ya ndli xgab jwanꞌ lo izyo reꞌ, nde jwanꞌ lo izyo ndyodiꞌs xaꞌ, nde re men ndli xgab jwanꞌ lo izyo, nchon xaꞌ xkiꞌs xaꞌ ya. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Naꞌ nak xinꞌ Dios, nde re xaꞌ jwanꞌ ndli lazonꞌ Dios, nchon xaꞌ xkiꞌs naꞌ, leꞌ xaꞌ jwanꞌ naꞌnakta xinꞌ Dios, naꞌnchonta xaꞌ xkiꞌs naꞌ, nde jwanꞌ reꞌ sa yolonꞌ xanya xaꞌ ndono Xbi li nde xanya xaꞌ ndono xbi kwinꞌ.<verse eid="1JN 4:6" /></para>
  <para style="s">Dios nak yalkeꞌ lazoꞌ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Wes na, ptanꞌ na, keꞌ lazonꞌ re ta men naꞌ, tak yalkeꞌ lazoꞌ nak chanꞌ Dios. Reta xaꞌ jwanꞌ nkeꞌ lazonꞌ ta mena, xaꞌ ya nak xinꞌ Dios, nde nzolo xaꞌ Dios. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Leꞌ xaꞌ naꞌnked lazonꞌ ta men naꞌ, tera yolo xaꞌ Dios, tak Dios nak yalkeꞌ lazoꞌ. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Cheꞌ, sa mbloꞌ nkeꞌ lazoꞌ Dios naꞌ, senꞌ mtelꞌ Xaꞌ thib nya tir Xinꞌ Xaꞌ jwanꞌ ngeno Xaꞌ, mbyed lo izyo reꞌ nde Xinꞌ Xaꞌ mbli sa ngenonꞌ yalnaban. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Jwanꞌ reꞌ nak yalkeꞌ lazoꞌ: Naꞌnakte naꞌ mkeꞌ lazonꞌ Dios, Dios mkeꞌ lazoꞌ Xaꞌ naꞌ jwanꞌ nasa mtelꞌ Xaꞌ Xinꞌ Xaꞌ Jesús mdayaꞌ lazonꞌ lo Dios, sa mbyax reta xkenꞌ naꞌ.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />Wes na, ptanꞌ na, tez ta mkeꞌ lazoꞌ Dios naꞌ, noga naꞌ ndablo keꞌ lazonꞌ re ta men naꞌ. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Ngenta cho tera wiꞌ yub Dios, per tez nkeꞌ lazonꞌ re ta men naꞌ, Dios nzo lazonꞌ nde leꞌ yalkeꞌ lazoꞌ chanꞌ Dios ndloꞌpa mxyuta lenꞌ lazonꞌ. <verse eid="1JN 4:12" /><verse number="13" style="v" sid="1JN 4:13" />Jwanꞌ reꞌ sa mnenꞌ ke tiblaꞌ ndononꞌ Dios nde Dios tiblaꞌ ndono Xaꞌ naꞌ, tak mdaꞌ Xaꞌ Mbi Nayon chanꞌ Xaꞌ lonꞌ. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Nde yub náꞌ mbwiꞌ náꞌ nde ndej náꞌ, Xud naꞌ Dios mtelꞌ Xaꞌ Xinꞌ Xaꞌ, tolaꞌ reta men. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Re xaꞌ jwanꞌ mbez leꞌ Jesús nak Xinꞌ Dios, tiblaꞌ ndono Dios xaꞌ ya, nde taga tiblaꞌ ndono xaꞌ Dios.<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />Naya mbyolonꞌ nde ndli lazonꞌ plopa nkeꞌ lazoꞌ Dios naꞌ. Dios nak yalkeꞌ lazoꞌ, nde men jwanꞌ tiblaꞌ ndono yalkeꞌ lazoꞌ, tiblaꞌ ndono xaꞌ Dios nde taga tiblaꞌ ndono Dios xaꞌ. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Cheꞌ, sa liga lenꞌ lazonꞌ ndloꞌpa mxyut yalkeꞌ lazoꞌ chanꞌ Dios, sa senꞌ sin wiz kwezke Dios jwanꞌ mblinꞌ, zya dib laꞌs yo lazonꞌ, tak xa nak Jesucrist, taga nak naꞌ lo izyo reꞌ. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Tenꞌ nzo yalkeꞌ lazoꞌ tya naꞌngenta zeb, cheꞌla jwanꞌ nak yalkeꞌ lazoꞌ ngotey yalzeb, tak leꞌ yalzeb ndeno yalti. Nde jwanꞌ nasa, lazoꞌ xaꞌ ta nzyeba tera loꞌ xyut yalkeꞌ lazoꞌ chanꞌ Dios.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Naꞌ nkeꞌ lazonꞌ Dios, tak ner Dios mkeꞌ lazoꞌ Xaꞌ naꞌ <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Tez nzo xaꞌ mbez: Nkeꞌ lazoꞌn Dios, nde ngiꞌno xaꞌ ta men xaꞌ, xaꞌ ya ndokwinꞌ. Tak xaꞌ jwanꞌ naꞌnked lazonꞌ ta men xaꞌ, jwanꞌ ngwiꞌ xaꞌ, ¿xa nye keꞌ lazoꞌ xaꞌ Dios jwanꞌ naꞌngwid xaꞌ? <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Nde Jesucrist mtanꞌ yalnyebeꞌ reꞌ lonꞌ: Xaꞌ jwanꞌ nkeꞌ lazonꞌ Dios, noga ta men xaꞌ ndablo keꞌ lazoꞌ xaꞌ.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Lipa lazoꞌ men Jesús sa lyayo re jwanꞌ narax</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Reta men jwanꞌ ndli lazonꞌ leꞌ Jesús nak Xaꞌ mtelꞌ Dios, men ya nak xinꞌ Dios. Nde reta men jwanꞌ nkeꞌ lazonꞌ xud mdyenꞌ, taga nkeꞌ lazoꞌ men re mdyenꞌ xinꞌ xaꞌ <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Senꞌ nxobyek naꞌ yalnyebeꞌ chanꞌ Dios nde nkeꞌ lazonꞌ Xaꞌ, zyasa ndloꞌ nkeꞌ lazonꞌ re xinꞌ Xaꞌ. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Jwanꞌ reꞌ nak keꞌ lazoꞌ men Dios, xobyek men re yalnyebeꞌ chanꞌ Xaꞌ. Nde re yalnyebeꞌ chanꞌ Xaꞌ naꞌnakte jwanꞌ nagan, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />tak re men jwanꞌ nak xinꞌ Dios, men ya li lyayo re jwanꞌ narax lo izyo. Senꞌ lipa lazoꞌ men Jesús, jwanꞌ reꞌ li lyayo re jwanꞌ narax lo izyo. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />¿Cho men li lyayo re jwanꞌ narax lo izyo? Men jwanꞌ ndli lazonꞌ Jesús nak Xinꞌ Dios.<verse eid="1JN 5:5" /></para>
  <para style="s">Jwanꞌ ndej Mbi Nayon</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Senꞌ mbyed Jesucrist lo izyo reꞌ, mbroꞌle Xaꞌ lenꞌ nit nde senꞌ nguj Xaꞌ mxo Xaꞌ ren Xaꞌ. Nde leꞌ Mbi Nayon ndej jwanꞌ reꞌ, tak Mbi Nayon nak jwanꞌ li. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Tak son Xaꞌ ndej lo beꞌ jwanꞌ nak Jesús, Xaꞌ ya nak: Xud naꞌ Dios, Diꞌs Naban nde Mbi Nayon. Nde re yon Xaꞌ reꞌ, thita Xaꞌ. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Tagaꞌ lo izyo, nzo son jwanꞌ ndej jwanꞌ nak Jesús: xbi, nit nde ren. Nde re yona thita naka. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Tez ndli lazonꞌ jwanꞌ ndej men lo izyo reꞌ, ndablo mas li lazonꞌ jwanꞌ ndej Dios, tak Dios ndej jwanꞌ nak Xinꞌ Xaꞌ. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Men jwanꞌ ndli lazonꞌ Xinꞌ Dios, neꞌ xaꞌ jwanꞌ reꞌ lenꞌ lazoꞌ xaꞌ, leꞌ xaꞌ jwanꞌ naꞌndlid lazonꞌ Dios ndlilal xaꞌ Dios xaja ti Xaꞌ kwinꞌ, tak naꞌndlid lazoꞌ xaꞌ jwanꞌ ndej Dios kwent chanꞌ Xinꞌ Dios. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Nde jwanꞌ reꞌ nak jwanꞌ ndej Dios: Dios mdaꞌ yalnaban adiꞌ lonꞌ, nde yalnaban reꞌ ngeno Xinꞌ Xaꞌ. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Men jwanꞌ ndono Xinꞌ Dios, men ya ndono yalnaban, leꞌ xaꞌ jwanꞌ naꞌndonod Xinꞌ Dios naꞌndonod xaꞌ yalnaban.<verse eid="1JN 5:12" /></para>
  <para style="s">Yolo men yalnaban adiꞌ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Ngekeꞌn jwanꞌ reꞌ lo re goꞌ jwanꞌ ndli lazonꞌ le Xinꞌ Dios, sa nye goꞌ ngeno goꞌ yalnaban adiꞌ, nde li lazoꞌ goꞌ Xaꞌ nak Xinꞌ Dios.<verse eid="1JN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 5:14" />Nde jwanꞌ reꞌ nak xlaꞌs ngenonꞌ lo Dios, tez nyaꞌb naꞌ jwanꞌ xaja ncholaꞌs Xaꞌ, ton Xaꞌ xkiꞌs naꞌ. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Nde tez mnenꞌ Dios nchon choja jwanꞌ nyaꞌb naꞌ lo Xaꞌ, ndablo nyenꞌ mkayaꞌla naꞌ re jwanꞌ mnaꞌb naꞌ lo Xaꞌ.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Tez nzo cho goꞌ ngwiꞌ ti xaꞌ ndli lazonꞌ Dios ngeli xaꞌ yalke jwanꞌ naꞌncheda men lo yalguj, mnaꞌb goꞌ lo Dios, nde Dios taꞌ yalnaban lo xaꞌ, jwanꞌ reꞌ nak lo re xaꞌ ndli yalke jwanꞌ naꞌncheda men lo yalguj. Nzo yalke ndeno yalguj, jwanꞌ na naꞌnit na lo goꞌ cho tnaꞌb goꞌ por xaꞌ ya lo Dios. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Reta jwanꞌ naꞌgalꞌta, yalke naka, per nzo yalke naꞌnchede men lo yalguj.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Mnenꞌ nek tib men jwanꞌ nak xinꞌ Dios naꞌndlid men jwanꞌ narax, tak Jesús Xinꞌ Dios nkenap Xaꞌ men nde maxuꞌ naꞌgaltraꞌ xaꞌ men.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Mnenꞌ, nak naꞌ xinꞌ Dios nde leꞌ dib izyo nzoyaꞌ maxuꞌy.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Nde mnenꞌ leꞌ Jesús Xinꞌ Dios mbyed lo izyo reꞌ, mbyed taꞌ yalnchak lonꞌ sa yolonꞌ, liga Xaꞌ nak Dios. Nde ndononꞌ Xaꞌ lipa, Xaꞌ ya nak Xinꞌ Xaꞌ Jesucrist. Xaꞌ reꞌ nak lipa Dios nde yalnaban adiꞌ. <verse eid="1JN 5:20" /><verse number="21" style="v" sid="1JN 5:21" />Xinꞌ bix na, pkenap lazoꞌ goꞌ lo re mnab. Ta naka.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>