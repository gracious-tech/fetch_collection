<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id" />
  <para style="h">Marcos</para>
  <para style="toc3">Mr.</para>
  <para style="toc2">Marcos</para>
  <para style="toc1">Diꞌs wen chanꞌ Jesucrist jwanꞌ mkeꞌ Marcos</para>
  <para style="mt">Diꞌs wen chanꞌ Jesucrist mkeꞌ Marcos</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Juan Bautist mdej kwent chanꞌ xkiꞌs Dios</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mt. 3:1-12</ref>; <ref loc="LUK 3:1-9">Lc. 3:1-9</ref>,<ref loc="LUK 3:15-17">15-17</ref>; <ref loc="JHN 1:19-28">Jn. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />14 Mod reꞌ mdobte diꞌs wen chanꞌ Jesucrist Xinꞌ Dios.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Jwan' xa nchab lo yeꞌs mkeꞌ profet Isaías,<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Xaꞌ reꞌ nak </char><char style="fq" closed="false">profeta </char></note> diꞌs jwanꞌ nchab Dios lo Crist:</para>
  <para style="q" vid="MRK 1:2">Ncheꞌ tel na thi xaꞌ todiꞌs xkiꞌs na ndasiblo loa,</para>
  <para style="q" vid="MRK 1:2">xaꞌ ya ndasiblo ndatoxkwa' xa' xned la.<verse eid="MRK 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MRK 1:3" />Nchen mbez ti xaꞌ izyo nagan:</para>
  <para style="q" vid="MRK 1:3">“Ptoxkwaꞌ goꞌ xned Xaꞌ Nyebeꞌ; nali bdix goꞌ xned Xaꞌ.”<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Isaías 40:3</char></note><verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Ngole Juan men izyo nagan, nde mdej xaꞌ nakin' ryo'le men, laꞌ men re jwanꞌ narax nak men nde bere men lo Dios, sa tonꞌ Dios xken men. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Nde reta men nzo lo xyon Judea nde re men nzo yez Jerusalén mbye'd xaꞌ lo Juan, mxo'bdol xaꞌ reta xken xaꞌ nde mblole Juan xaꞌ lenꞌ yoꞌ Jordán.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Nde xab Juan naksaꞌ yis kamey nde sint nachal lenꞌ Juan nak yid; nde jwan' ncha Juan nak maꞌ bix nchat lo wan, nde mzin wan nchu' Juan. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Nde mdej Juan' lo men, nchab Juan:</para>
  <para style="p" vid="MRK 1:7">—Xis na nde tib Xaꞌ ngeno yalne ro ke na nde nansalꞌta na nekla par go'ten yalyid ni Xaꞌ. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Na lipa benꞌta lenꞌ nit mblolen goꞌ; per Xaꞌ kole goꞌ kon Mbi Nayon.<verse eid="MRK 1:8" /></para>
  <para style="s">Mbro'le Jesús</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mt. 3:13-17</ref>; <ref loc="LUK 3:21-22">Lc. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Lenꞌ wiz ya, Jesús mbroꞌ yez Nazaret lo xyon Galilea, mzin Xaꞌ lo Juan nde mblole Juan Xaꞌ lenꞌ yoꞌ Jordán. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Nde lo le'ja ryo'te Jesús lenꞌ nit zya mbwiꞌ Xaꞌ mxyalꞌ lo beꞌ nde xaja ti palom nya Mbi Nayon mblay yek Jesús.<figure style="fig" alt="Juan bautizando Jesús" file="CN01656b.TIF" size="col" ref="1:10">Juan mblole Jesús lenꞌ yoꞌ Jordán</figure> <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Nde lo beꞌ mbro' mbyen mni ti Xa' jwan' nchab:</para>
  <para style="p" vid="MRK 1:11">—Lu nak Xinꞌ na jwanꞌ toz nkeꞌ lazoꞌn la; lu ngo nale lazoꞌn.<verse eid="MRK 1:11" /></para>
  <para style="s">Ncholaꞌs Maxuꞌ tokan xaꞌ Jesús</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mt. 4:1-11</ref>; <ref loc="LUK 4:1-13">Lc. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Zyaga mbe' Mbi Nayon Jesús tenꞌ nak izyo nagan. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Nde tya mkete Jesús choꞌ wiz tenꞌ nzo re maꞌ tin nde taja ncholaꞌs Maxuꞌ tokan xaꞌ Jesús. Nde re áng mkenap xa' Jesús.<verse eid="MRK 1:13" /></para>
  <para style="s">Jesús mdobte mbli rsinꞌ Dios</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mt. 4:12-17</ref>; <ref loc="LUK 4:14-15">Lc. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Senꞌ mblola xa' Juan liz yib, Jesús nda lo xyon Galilea ndatej Xaꞌ diꞌs wen lo yalnyebeꞌ chanꞌ Dios, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />nchab Xaꞌ:</para>
  <para style="p" vid="MRK 1:15">—Ngoxobla be', nde yalnyebeꞌ chanꞌ Dios ndosinlay gax; bere go' lo Dios nde blaꞌ goꞌ re jwanꞌ narax nak goꞌ nde bli lazoꞌ goꞌ diꞌs wen chanꞌ Dios.<verse eid="MRK 1:15" /></para>
  <para style="s">Jesús mbrez tap xaꞌ god mbel</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mt. 4:18-22</ref>; <ref loc="LUK 5:1-11">Lc. 5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Jesús ngete ro nittoꞌ Galilea, mbwiꞌ Jesús ndo Simón kon Ndres rop wes xaꞌ, nge gobi xaꞌ ye'd lo nittoꞌ; tak xaꞌ nak men god mbel. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Zyasa nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 1:17">—Deꞌ goꞌ nde ptonke goꞌ xis na, sa lilal na goꞌ men god, sa li goꞌ gan men par Dios.<verse eid="MRK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 1:18" />Nde zyaga mblaꞌ xaꞌ ye'd, mdonke xaꞌ xis Jesús.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Le'ga tya mde Jesús tud nde mbwiꞌ Xa' Jakob kon wes xa' Juan xinꞌ Zebedeo, taga lo bark nzo xaꞌ, ngeyibde xaꞌ ye'd. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Nde zyaga mbrez Jesús rop xaꞌ, mblaꞌta xaꞌ xud xaꞌ Zebedeo lenꞌ bark kon re mos, ndanke xa' xis Jesús.<verse eid="MRK 1:20" /></para>
  <para style="s">Ti mbiꞌ ndono mbi narax</para>
  <para style="r">(<ref loc="LUK 4:31-37">Lc. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Nde mzin xaꞌ yez Capernaum; nde len' re wiz jwanꞌ ndryoxkwen men, Jesús nchote lenꞌ yo tenꞌ ndyop re men Israel<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Tya ndole </char><char style="fq" closed="false">sinagog</char></note>, ntoteꞌd Xaꞌ men. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Nde nzoyen reta men ngwiꞌ xaꞌ xa nate'd Jesús; tak ntote'd Jesús men xaga Xa' ngeno yalnyebeꞌ, na'nakta Xa' xa nak re maestr ndlo' ley. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Nde len' yo ten' ndyop re men israel tya ndo thi mbiꞌ ndono mbi narax, nde ne mbrez xaꞌ, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />nchab xaꞌ:</para>
  <para style="p" vid="MRK 1:24">—¡Aah! ¿Cho kwan ndyaknoa náꞌ, Jesús Xa' Nazaret? ¿Cho ndea sa lu'x la náꞌ? Mnen cho nak la, lu nak Xaꞌ Nayon chan' Dios.<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Jesús mbres lo mbi narax, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 1:25">—¡Btowꞌ roa nde broꞌte lazoꞌ mbiꞌ reꞌ!<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Le' mbi naraxa, mdinkey mbiꞌ ya nde ne mbrezyaja mbroꞌtey lazoꞌ mbiꞌ. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Nde reta men nzi tya nzoyen toz xaꞌ, nya'bdi's xa' lo ta xa' nchab xaꞌ:</para>
  <para style="p" vid="MRK 1:27">—¿Cho kwan jwanꞌ reꞌ? ¿Cho yalte'd kub naka, sa kon yalnyebeꞌ ni Xaꞌ lo re mbi narax nde nxobyeka xkiꞌs Xaꞌ?<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Nde jwanꞌ toz mxyo'b xkiꞌs Jesús dib lo xyon Galilea.<verse eid="MRK 1:28" /></para>
  <para style="s">Jesús mtodanꞌ xnaꞌsap Pedr</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mt. 8:14-17</ref>; <ref loc="LUK 4:38-41">Lc. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Senꞌ mbroꞌ xaꞌ lenꞌ yo tenꞌ ndyop men Israel, Jesús kon Jakob nde Juan ngwa xaꞌ liz Simón nde liz Ndres. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Leꞌ xnaꞌsap Simón naxno xlye, nde zyaga nchab re mena lo Jesús. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Zyasa mbike Jesús gax, mxen Jesús yaꞌ xaꞌ nde mbliche Jesús xaꞌ; nde zyaga mbyib xlye lo xaꞌ, nde leꞌ xaꞌ mdaꞌ jwan' mda re xaꞌ.<verse eid="MRK 1:31" /></para>
  <para style="s">Bro toz men yiz mtodanꞌ Jesús senꞌ ngwadla wiz</para>
  <para style="r">(<ref loc="MAT 8:16-17">Mt. 8:16-17</ref>; <ref loc="LUK 4:40-41">Lc. 4:40-41</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Senꞌ ngwadla wiz, lo ndakowla izyo, mbyeꞌdno xaꞌ reta men nayiz lo Jesús nde re men jwanꞌ nzo mbi narax. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Reta men nzo yez ya mdyop xaꞌ xis yala tenꞌ nzo Jesús. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Nde bro toz men mtodanꞌ Jesús choja re yiz jwanꞌ ndyak men nde taja mbloꞌche Xaꞌ re mbi narax jwanꞌ nzo lazoꞌ men. Per na'nda'd Jesús diꞌs ni re mbi narax, tak nzoloy Jesús.<verse eid="MRK 1:34" /></para>
  <para style="s">Jesús mketetej xkiꞌs Dios dib Galilea</para>
  <para style="r">(<ref loc="LUK 4:42-44">Lc. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Tilꞌ toz tata benꞌ nakow nya ngoche Jesús nde nda xaꞌ tij, ti plo tenꞌ nagan nde tya mdodiꞌsno Xaꞌ Dios. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Leꞌ Simón nde kon tipla xaꞌ ngwa kwanꞌ xaꞌ Jesús. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Nde senꞌ mzyal xaꞌ Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 1:37">—¡Reta men nkwanꞌ xaꞌ lu!<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Leꞌ Jesús nchab: Ndanꞌ re yez jwanꞌ nzi gax ncheꞌ ndatej na' xkiꞌs Dios lo re men; tak jwanꞌ naga ndal na. <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Nde ngwa Jesús reta ten' nzi re yo ndyop re men Israel jwanꞌ nak lo xyon Galilea, ngwa tej Xaꞌ xkiꞌs Dios nde mbloꞌche Xaꞌ re mbi narax.<verse eid="MRK 1:39" /></para>
  <para style="s">Jesús mtodanꞌ ti xaꞌ ndyak yis tin ndole lepra</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mt. 8:1-4</ref>; <ref loc="LUK 5:12-16">Lc. 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Mbye'd ti xaꞌ lo Jesús, xa' ndyak yis tin ndole lepra anta ndoye belꞌ xaꞌ, mdoxub xaꞌ nde mnab xaꞌ lo Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 1:40">—Tezka ncholaꞌs la, toyal todan' la na lo yis re'.<figure style="fig" alt="Jesús sanando un leproso" file="CN01683B.TIF" size="col" ref="1:40">Tib mbiꞌ ndyak yis tin nyab lo Jesús sa dyanꞌ xaꞌ</figure><verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Nden mblat lazoꞌ Jesús mbiꞌ ya, mxob yaꞌ Jesus yek xaꞌ, nde nchab Jesus lo xaꞌ:</para>
  <para style="p" vid="MRK 1:41">—Toyala, yan' nambia naya.<verse eid="MRK 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 1:42" />Nde senꞌ lo ta nchab Jesús lo xaꞌ, zyaga mbyi'b yiz dib xaꞌ nde mbi xaꞌ. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Zyaza mbloned Jesús xa' nde mna'b toz Jesús lo xaꞌ, nchab Jesús:<verse eid="MRK 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 1:44" />—Nek tib lo men na'tejta lu jwanꞌ reꞌ, jwanꞌ ndablo lia, wa lo nglweyꞌ sa wiꞌ xaꞌ lu nde beꞌ maꞌ yon jwanꞌ nyebeꞌ Moisés, sa nye re men ke mbyak la lo yiz.<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Per senꞌ lo ndyala xaꞌ, tolo mdej toz xa' lo re men, mxo'b xa' di's jwan' mbli Jesús lo xa', jwanꞌna mbli sa na'ngakta ngete Jesús lenꞌ yez, be'nta tij re ro yez mbyan' Jesús, nde reta lad ndryo' re men nzin xa' lo Jesús.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Jesús mtodanꞌ tib xaꞌ naꞌakta tye</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mt. 9:1-8</ref>; <ref loc="LUK 5:17-26">Lc. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Mbrid pla wiz, Jesús mbla len' yez Capernaum tedi gob; nde mbin re men Jesús nzo yo. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Zyaga men toz tir mdyop, na'galtra' ten' kwe men nekla ro yo na'galtra; le' Jesús ndotej xkiꞌs Dios lo re men. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Zyasa mzin pla xaꞌ lo Jesús ndeno ti men nayiz naꞌakta tye, nde thap xa' ne' men yisa.<figure style="fig" alt="Jesús sana un paralítico" file="CN01684B.TIF" size="col" ref="2:3">¿Xomod sin men yis reꞌ lo Jesús, men toz nzi lenꞌ yo?</figure> <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Nde lo ta bro toz men nziy, na'ndlid xaꞌ gan mbike xaꞌ lo Jesús, mched xaꞌ yek yo nde mbla xaꞌ men yiza kon dib ya lonꞌ xaꞌ ten' ndo Jesús. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Senꞌ mbwiꞌ Jesús ndlipa lazoꞌ xaꞌ Jesús, nchab Jesús lo xa' yiza:</para>
  <para style="p" vid="MRK 2:5">—Xinꞌ na, mdyonꞌla reta xken la.<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Tya ndob pla xa' nak maestr nte'd ley xkiꞌs Dios, mbli xaꞌ xgab lenꞌ lazoꞌ xaꞌ: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“¿Kwan sa ta mbez Xaꞌ? Ni xin Xa' xis Dios. ¿Cho men ligan tonꞌ xken ta men, Benꞌta Dios ndli gan?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Nde zyaga mne Jesús xgab jwanꞌ ndono re xa' ya lenꞌ lazoꞌ xaꞌ, nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 2:8">—¿Cho kwan liy ta nya xgab ndli goꞌ lenꞌ lazoꞌ goꞌ? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />¿Cho di's mas nambi, gab na lo xa' yiz reꞌ: “Re xken la mdyonꞌla,” o gab na: “Ptoli, bxen lonꞌ la nde pte?” <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Naya loꞌn lo goꞌ, leꞌ Xinꞌ Mbi' ngeno yalnyebeꞌ dib lo izyo sa tonꞌ Xaꞌ xken re men.</para>
  <para style="p" vid="MRK 2:10">Zyasa nchab Jesús lo xa' ta nayiza:<verse eid="MRK 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 2:11" />—Na ni loa, ptoli, bxen lonꞌ la nde bya liz la.<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Zyaga mtoli xaꞌ yiza, mxen xaꞌ lonꞌ xaꞌ mbro'te xa' xij reta men, jwan' nasa nzoyen toz reta men, nde mni xaꞌ diꞌs wen lo Dios, nchab xaꞌ:</para>
  <para style="p" vid="MRK 2:12">—¡Tera winꞌ ti jwanꞌ ta mbwinꞌ naya!<verse eid="MRK 2:12" /></para>
  <para style="s">Jesús mbrez Leví Mateo</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mt. 9:9-13</ref>; <ref loc="LUK 5:27-32">Lc. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Ngolo jwanꞌ reꞌ Jesús nda ro nittoꞌ tedib gob. Nde reta men nda lo Xaꞌ, nde mtote'd Xa' men. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Nde lo ndarid Jesús, mbwiꞌ Xaꞌ Leviꞌ xinꞌ Alfeo, ndob xa' ten' nthop xaꞌ tmi low jwanꞌ nchax lo izyo, nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 2:14">—Btoke xis na.</para>
  <para style="p" vid="MRK 2:14">Zyaga mdoli xaꞌ nde mdoke xaꞌ xis Jesús.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Senꞌ nax Jesús ro mes kon re xinꞌ teꞌd Xaꞌ liz Leví, bro re xaꞌ jwanꞌ nthop tmi chanꞌ izyo nde re xaꞌ jwanꞌ nzo'b xken' thita nzi re xaꞌ ro mes kon Jesús nde re xin' te'd Jesus, tak bro toz men jwan' ndyonke xis Jesús. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Nde re xaꞌ nak maestr ndlo' ley xkiꞌs Dios nde re xaꞌ nak fariseo, lo mbwiꞌ xaꞌ nax ya Jesús kon re men nthop tmi chan' izyo nde kon re men nzo'b xken', nchab xaꞌ lo re xinꞌ teꞌd Jesús:</para>
  <para style="p" vid="MRK 2:16">—¿Cho kwan nak jwanꞌ reꞌ, kwan sa ncha Xaꞌ kon re men nthop tmi nde kon re men nzo'b xken naꞌ?<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Senꞌ l o mbin Jesús jwanꞌ reꞌ, Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 2:17">—Re men nadanꞌ nanakiꞌnta xaꞌ men todanꞌ xaꞌ, che'la re men nayiza. Na'ndalta na sa bez na re men galꞌ, na ndal par re men nzo'b xken naꞌ.<verse eid="MRK 2:17" /></para>
  <para style="s">Nyabdiꞌs xaꞌ lo Jesús kwan nak yalse</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mt. 9:14-17</ref>; <ref loc="LUK 5:33-39">Lc. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Nde re xaꞌ nak xinꞌ teꞌd Juan nde re xaꞌ fariseo ndli xaꞌ yalse; nde mbyeꞌd pla men lo Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 2:18">—¿Cho kwan liy sa re xinꞌ teꞌd Juan nde re xa' fariseo ndli xaꞌ yalse nde re xinꞌ teꞌd la na'ndlid xaꞌ yalse?<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 2:19">—¿Cho toyal re men jwan' nzi lo yalselya' li xa' yalse laj leꞌ mbyo selyaꞌ ndo kon xa'? Laj benꞌ ndo mbyo selya'ya kon xa', na'toyalta li xa' yalse. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Per tsin wiz senꞌ mbyo mselyaꞌya naꞌngentra', zyasa li xaꞌ yalse.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />’Ngen cho men nkibde tib ble lar kub lad lar gox; tak lar kub mbey nde cheda lar gox, zyasa masraꞌ cheda. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Nde taga', ngenta cho men ngo nit ub kub lenꞌ ti ye gox jwanꞌ naksaꞌ yid maꞌ; tak nit ub kub ncheda ye gox nde xyoy nde leꞌ ye ya yaja ngosaꞌy; Jwanꞌ nasa leꞌ nit ub kub ndablo yoy lenꞌ ti ye kub.<verse eid="MRK 2:22" /></para>
  <para style="s">Xinꞌ teꞌd Jesús nthop trig lenꞌ wiz ndryoxkwen men</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mt. 12:1-8</ref>; <ref loc="LUK 6:1-5">Lc. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Ti wiz jwanꞌ ndryoxkwen men, Jesús kon re xinꞌ teꞌd xaꞌ ndarid xa' plo tenꞌ ndo trig, nde re xinꞌ teꞌd Jesús tolo mthop xaꞌ trig. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Zyasa pla xaꞌ fariseo nchab xaꞌ lo Jesús:</para>
  <para style="p" vid="MRK 2:24">—Bwiꞌ, ¿Cho kwan liy re xinꞌ teꞌd la ngeli xaꞌ jwanꞌ nandabloda li xa' naya lenꞌ wiz ndryoxkwen men?<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Per Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 2:25">—¿Cho tera' lab goꞌ jwanꞌ mbli David senꞌ lo mkeno xaꞌ yalti nde msi'b ndyanꞌ xaꞌ kon re men jwanꞌ nzino xaꞌ tya? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />David ngote xaꞌ lenꞌ liz Dios nde mda xaꞌ pan nayon nzi tya, pan jwanꞌ benꞌta re xaꞌ nak nglweyꞌ ro toyal way; nde noga mdaꞌ Davida mda re xaꞌ jwanꞌ ngete kon xaꞌ. lin' jwan' Abiatar nak mbol ngwleyꞌ ro.<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Noga nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 2:27">—Par yalwen lo men mbyanꞌ wiz ndryoxkwen men nde nambyanꞌta wiz reꞌ par nye men yalti. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Jwanꞌ nasa, le' Xinꞌ Mbiꞌ nak Xa' men Nyebeꞌ len' wiz jwan' ndryoxkwen men.<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Jesús mtodanꞌ tib xaꞌ mbiz yanꞌ</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mt. 12:9-14</ref>; <ref loc="LUK 6:6-11">Lc. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Ngote Jesús tedib gob lenꞌ yo tenꞌ ndyop men Israel, nde tya ndo ti mbi' mbis yaꞌ xaꞌ. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Nde ndola's pla xaꞌ sa nyenꞌ cho todanꞌ Jesús men yiza lenꞌ wiz ndryoxkwen men, sa zyal xaꞌ yalke keꞌ xaꞌ yek Jesús. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Zyasa nchab Jesús lo mbi' mbis yanꞌ ya:</para>
  <para style="p" vid="MRK 3:3">—Ptoli nde pto xtowꞌ re men reꞌ.<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />Nde nchab Jesús lo re xaꞌ nzi tya:</para>
  <para style="p" vid="MRK 3:4">— ¿Cho yalke naka tez len' wiz jwanꞌ ndryoxkwen men li men jwanꞌ wen o jwan' narax, tola' men yalnaban chan' ti men, o kuj men xa'?</para>
  <para style="p" vid="MRK 3:4">Per nek tib xaꞌ nankabta. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Zyasa mbwiꞌ nayiꞌ Jesús lo reta men nzi tya nde ngo nabil lazoꞌ Jesús lo taja ne lazoꞌ re men, nchab Jesús lo mbi' nayiza:</para>
  <para style="p" vid="MRK 3:5">—Btogaꞌ yaꞌa.</para>
  <para style="p" vid="MRK 3:5">Nde mtogaꞌ xaꞌ yaꞌ xaꞌ, taxa nawe mbyanꞌna nde mbyaka. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Leꞌ re xaꞌ fariseo mbro'te ndya xaꞌ nde mdyop xaꞌ kon re men Herodes sa mdodiꞌs xaꞌ par zyal xaꞌ mod gaj Jesús.<verse eid="MRK 3:6" /></para>
  <para style="s">Bro toz men mdoke xis Jesús ro nittoꞌ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Leꞌ Jesús nda ro nittoꞌ kon re xinꞌ teꞌd Xaꞌ nde bro toz men mdoke xis Jesús, xaꞌ nzi lo xyon Galilea. Nde re men Judea, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />men yez Jerusalén, men nzi lo xyon Idumea, men nzi tib lad ro yoꞌ Jordán nde re men jwanꞌ nzo re yez nzi lo xyon Tiro nde Sidón, senꞌ mbin re men naro toz nak re jwanꞌ ndli Jesús, bro toz tir men mbyeꞌd lo Xa'. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Nde nchab Jesús lo re xinꞌ teꞌd Xaꞌ, ndablo thibla' tobsaꞌ xaꞌ ti bark yap Jesús, lo ta bro toz tir men ndyop, sa naga'sta men Jesús.<verse eid="MRK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 3:10" />Tak bro toz men mtodan' Jesús, jwanꞌ nasa reta men nayiz ncholaꞌs xaꞌ gal xaꞌ lad Jesús. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Nde re mbi narax, lo ngwiꞌ xaꞌ Jesús, ndyoxub xaꞌ lo ni Jesús nde ne mbez xaꞌ, nchab xa':</para>
  <para style="p" vid="MRK 3:11">—Lu nak Xinꞌ Dios.<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Per mbrez toz Jesús lo re mbi narax sa na'koxo'bta xa' cho nak Jesús.<verse eid="MRK 3:12" /></para>
  <para style="s">Jesús mbli re tib sen xinꞌ teꞌd Xaꞌ</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mt. 10:1-4</ref>; <ref loc="LUK 6:12-16">Lc. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Ngolo jwanꞌ na, Jesús ngwap yek ti yiꞌ, nde mbrez Xaꞌ men jwanꞌ nchola's Xaꞌ; nde ngwa re xa' lo Jesús. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Nde mblí Jesús tib sen xa', sa re xa' ya tyeno Jesús nde telꞌ Jesús xaꞌ yatej xaꞌ xkiꞌs Dios lo re men.<figure style="fig" alt="Los discípulos de Jesús" file="CN01714B.TIF" size="col" ref="3:14">Re tib sen xaꞌ reꞌ tyonke xis Jesús</figure> <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />Nde keno xaꞌ yalnyebeꞌ todanꞌ xaꞌ re men yiz nde kote xaꞌ re mbi narax nzo lazoꞌ men. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Re tib sen xaꞌ ya jwan' reꞌ: Simón (xaꞌ mblole Jesús Pey), <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Jakob kon Juan (rop wes xaꞌ reꞌ nak xinꞌ Zebedeo, rop xaꞌ reꞌ mblole Jesús, Boanerg, diꞌs reꞌ nak: “Xinꞌ mdiꞌ”);<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Xinꞌ mdiꞌ nak: Naret xaꞌ, nathoz xaꞌ, ne xkiꞌs xaꞌ. </char></note> <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Ti pla xaꞌ nak: Ndres, Blib, Bartol, Mateo, Max, Jakob (xinꞌ Alfeo), Tadeo, Simón xaꞌ Kananeo,<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Re xaꞌ cananist, nak tib ned men jwanꞌ ncholaꞌs tolaꞌ xaꞌ re men laz xaꞌ jwanꞌ nak Israel lo yaꞌ re xaꞌ Rom.</char></note> <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />nde Judas Iscariot (xaꞌ jwanꞌ tayaꞌ Jesús lo men sa kuj xaꞌ Jesús). Ngolo mne jwanꞌ reꞌ, zyasa ndya re xaꞌ yo.<verse eid="MRK 3:19" /></para>
  <para style="s">Nixin men xis Mbi Nayon</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mt. 12:22-32</ref>; <ref loc="LUK 11:14-23">Lc. 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Nde taxa mdyop bro toz men tya tedi gob, nayenta wa Jesús neka re xinꞌ teꞌd Xaꞌ. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Senꞌ mbin re xaꞌ liz Jesús jwanꞌ reꞌ, mbye'd xa' nde mbrez xaꞌ yek Jesús, tak nchab xaꞌ:</para>
  <para style="p" vid="MRK 3:21">—Ndoyosaꞌ yek mbiꞌ reꞌ.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Noga mzin pla maestr ndlo' ley xkiꞌs Dios, xa' mbroꞌ yez Jerusalén nchab xaꞌ, ke Jesús ndono Maxuꞌ ndole Beelzebuꞌ jwanꞌ nyebeꞌ lo re mbi narax nde por xaꞌ ya sa ndli Jesús gan ndryo'che re mbi narax nzo lazoꞌ men.<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Nde sen' mbrez Jesús re men ya mdej Jesús ti kwent nabix lo xaꞌ, nchab Jesús:</para>
  <para style="p" vid="MRK 3:23">—¿Xamod kote Maxuꞌ le'ga le' Maxuꞌ? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Tez ti yez ak rol xaꞌ nde yo xaꞌ kon le'ga re ta xaꞌ, naxekta xaꞌ, tlux xaꞌ. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Nde tez ti liz men ak rol xaꞌ nde yo xaꞌ, re xaꞌ nzo yo ya naxekta xaꞌ bro. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Nde taga, tez Maxuꞌ ak rol xaꞌ nde yo xaꞌ kon le'ga ta xaꞌ, naxekta xaꞌ, tlux xaꞌ.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />’Ngen cho xaꞌ ligan lya liz ti mbiꞌ ne toz, sa we wanꞌ xaꞌ re chanꞌ mbiꞌ, nerla ndablo tobo xaꞌ mbiꞌ, zyara' li xaꞌ gan we xaꞌ re chanꞌ mbiꞌ.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />’Nipa na lo goꞌ, Dios ton' re yalke jwanꞌ ndli men nde choja re diꞌs xin jwanꞌ ni men. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Per choja men jwanꞌ ni xin xis Mbi Nayon, nek lud natonꞌta Dios xken xaꞌ, nchanꞌ no xaꞌ yalken xaꞌ tiptane.<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />Jwanꞌ reꞌ nchab Jesús lo xaꞌ, tak leꞌ xaꞌ nchab ke Jesús ndono mbi narax.<verse eid="MRK 3:30" /></para>
  <para style="s">Xnaꞌ Jesús nde re wes xaꞌ</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mt. 12:46-50</ref>; <ref loc="LUK 8:19-21">Lc. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Xisa zyara' mzin xnaꞌ Jesús kon re wes xaꞌ, nzi xaꞌ le, mbloned xaꞌ tib men sa yachez xaꞌ Jesús. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Nde re men jwanꞌ nzi ndob cho Jesús tya, nchab xa' lo Jesús:</para>
  <para style="p" vid="MRK 3:32">—Xnaꞌa nde re wes la nzi le, ndekwanꞌ xaꞌ lu.<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Jesús mkab lo xa':</para>
  <para style="p" vid="MRK 3:33">—¿Cho nak xnaꞌn nde re wes na, ndyak goꞌ?<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Nde mbwiꞌ Jesús lo re men jwanꞌ nzindob dib cho Jesus, nchab Xa':</para>
  <para style="p" vid="MRK 3:34">—Bwiꞌ goꞌ, le'ga goꞌ nak xnaꞌn nde wes na. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Tak re men ndli jwanꞌ ncholaꞌs Dios, xaꞌ ya nak wes na, btanꞌ na nde xnaꞌn.<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Di's nabix chanꞌ xaꞌ ngo bin</para>
  <para style="r">(<ref loc="MAT 13:1-23">Mt. 13:1-23</ref>; <ref loc="LUK 8:4-15">Lc. 8:4-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Tedib gob mdobte Jesús mtoteꞌd Xaꞌ re men ro nittoꞌ nde bro toz men mdyop lo Xaꞌ, yaja ngwap Jesús lo ti bark jwanꞌ nzo'b lo nit nde tya mdob Xaꞌ, leꞌ reta men nzi ro yux. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Nde kon di's nabix mblo' Xa' lo re men na'r toz jwan', nde mblo' Xa' lo men jwan' xa naka yalte'd chan' Xaꞌ:<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />—Pto nza go': Ngo ti mbi mbroꞌ ndalo bin mbis.<figure style="fig" alt="Sembrador" file="cn02064b.tif" size="col" ref="4:3">Nzo tap ned lo yo tenꞌ ngob mbis bin</figure> <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Nde senꞌ ndogo xaꞌ bin, nzo mbis ngob ro ned, zyasa mbyeꞌd mbyin nde mda mbyina. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Tipla mbis ngob xij ke tenꞌ ngenta bro yo jwanꞌ nasa naban toz mblyena, <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />per senꞌ lo mbla toz be, mbolꞌ la tak nangenta loxa nde mbiza. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Tipla mbis ngob xij yis; nde mas mxyen yis, mtowꞌ yis yek neꞌy nde tamod sa nandopta lo neꞌy. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Leꞌ tipla mbis jwanꞌ ngob lo yobeꞌb, mblyena, mxyen na nde nawe mdob lo neꞌy, choy mdaꞌ galbsiꞌ mbis axta songal mbis nde nzoy mdaꞌ axta tib ayoꞌ mbis kad tiba.<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Zyasa nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 4:9">—¡Goꞌ jwanꞌ ndob nzanꞌ par gona, bin goꞌy!<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Senꞌ mbyanꞌ thipta Jesús, re xaꞌ jwanꞌ ngete nke xis Jesús nde kon re tib sen xinꞌ teꞌd Jesús, mnabdiꞌs xaꞌ lo Jesús nyenꞌ xamod nak di's nabix jwanꞌ ta mdej Xaꞌ. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Nde nchab Jesus lo xa':</para>
  <para style="p" vid="MRK 4:11">—Lo goꞌ ngoxkan Dios re diꞌs naga's jwanꞌ nak yalnyebeꞌ chanꞌ Dios; le' lo re men jwanꞌ ngete xisa, nab di's nabix tej men re jwanꞌ lo xaꞌ. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Sa te'nye ngwiꞌ xaꞌ per nawiꞌd xaꞌy, tenye nchon xaꞌ per na'yenta xaꞌy; sa na'syed xgab xaꞌ lo Dios nde natonꞌta Dios xken xaꞌ.<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 4:13">—¿Cho naꞌyenta goꞌ di's nabix reꞌ? ¿Xomodka yen goꞌ masra' re di's nabix sa? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Xaꞌ jwanꞌ ngobin mbis, xa' ya nak xaꞌ ngobin xkiꞌs Dios. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Nde re men jwan' nak xaja mbis nzo bin ro ned: nzobin xki's Dios lazo' xa', per sen' mne mbin xa'y, zyaga nde Maxuꞌ, nde nkib Maxuꞌ xkiꞌs Dios jwan' nzobin lazoꞌ xaꞌ. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Taga' re men jwan' nak xaja mbis nzobin xij ke: re xa' re' sen' nchon xaꞌ xkiꞌs Dios, zyaga nale toz ncho lazoꞌ xaꞌ nkayaꞌ xa'y, <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />per na'ngenta lox xkiꞌs Dios lazoꞌ xaꞌ, nak xaꞌ men plata wiz, tak senꞌ nde yalti lo xaꞌ o nchubla men xaꞌ xke chanꞌ xkiꞌs Dios, zyaga ndlaꞌ xaꞌ xkiꞌs Dios. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Re xa' re' nak xaja mbis jwan ngobin xij yis. Men ya, nchon xaꞌ xkiꞌs Dios, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />per ndyen toz xa' re jwanꞌ lo izyo nde ntokil'la xa' ak rik xa' nde ndyablaꞌs xaꞌ masra' jwanꞌ, reta jwanꞌ reꞌ ndyay lazoꞌ xaꞌ nde ntolu'xa xkiꞌs Dios. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Le' re men jwan' nak xaja mbis ngobin lo yo beꞌb: re xa' re' nchon xaꞌ xkiꞌs Dios nde ndli lazo' xaꞌy, nak xaꞌ xaja mbis bin jwanꞌ nawe ndob lonꞌ nde bro toz jwanꞌ ndaꞌy, choy ndaꞌ galbsiꞌ mbis, axta songal mbis nde axta por ayoꞌ mbis ndaꞌ kad thiba.<verse eid="MRK 4:20" /></para>
  <para style="s">Ngenta jwan' nagaꞌs na'ryoꞌxobta</para>
  <para style="r">(<ref loc="LUK 8:16-18">Lc. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Noga nchab Jesús:</para>
  <para style="p" vid="MRK 4:21">—¿Cho ndeno men xni sa towꞌ xaꞌ yek na'y kon ti xi beꞌ o ko xaꞌy xanꞌ lonꞌ? ¿Cho nanakta tob xaꞌy gap sa taꞌy xni? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Tak ngenta jwanꞌ nzo naga's na'ryoxo'bta, nek jwanꞌ nzo kaꞌslo, na'ryoxo'bta lo xni. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />¡Tez nzo goꞌ ndob nzanꞌ par gon goꞌy, bin goꞌy!<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Nde noga nchab Jesús:</para>
  <para style="p" vid="MRK 4:24">—Jwin bwi' go' jwan' mbin go'; tak xa nchix goꞌ nka men, taga' chi'x xa' ka goꞌ nde masra'y kayaꞌ goꞌ jwan' xa mbin go'. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Tak men ngenolay, kayaꞌ xa' masra'y; Nde men nangenoday, axta jwanꞌ lud ngeno xaꞌ yi'ba lo xaꞌ.<verse eid="MRK 4:25" /></para>
  <para style="s">Di's nabix xa nxyen mbis bin</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Noga nchab Jesús:</para>
  <para style="p" vid="MRK 4:26">—Che' nak yalnyebeꞌ chanꞌ Dios, xa nak ti mbi' jwan' ngwalo bin mbis xis izyo, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />nchat xaꞌ nde nchoche xa', yal' nde ndlyabe, leꞌ mbis nchas, nde ndoxena ana'nye xaꞌ xa ndoyaka. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Tak le'ga izyo ndli sa ndlyena, nerla ndryo'xoba nde nxyena, senꞌ lo mne mxyena zya ndryoꞌ do lo neꞌy, nde lo do sey ndryo'xob mbis. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Nde senꞌ ngol mbis, zyaga nthop xaꞌy, tak ngoxo'b be'y.<verse eid="MRK 4:29" /></para>
  <para style="s">Di's nabix chanꞌ mbis mostaz</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mt. 13:31-32</ref>; <ref loc="LUK 13:18-19">Lc. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Noga nchab Jesús:</para>
  <para style="p" vid="MRK 4:30">—¿Cho jwanꞌ thita nya kon yalnyebeꞌ chanꞌ Dios, o cho ti di's nabix thita lilal na'y? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Naka xa nak mbis mostaz, tak sen' li bin mena xis izyo, naka mbis mas bix lo reta mbis nzo xis izyo. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Per senꞌ ngo bin lay, nxyena, nde mas naroy lo reta ya bin nde nol' toz xoda, jwan' nasa re mbyin ntoyal ncho ma' xan' xkal na'y.<verse eid="MRK 4:32" /></para>
  <para style="s">Jwanꞌ reꞌ ndlirsinꞌ Jesús re di's nabix</para>
  <para style="r">(<ref loc="MAT 13:34-35">Mt. 13:34-35</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Na'r toz re di's nabix reꞌ ndloꞌ Jesús xkiꞌs Dios lo men, axaja nchen mena. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Nde napta di's nabix mdodiꞌs Jesús lo re men; benꞌ lo re xinꞌ teꞌd Xaꞌ ngoxkan Xaꞌ retay.<verse eid="MRK 4:34" /></para>
  <para style="s">Jesús ngota'b yalnathoz</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mt. 8:23-27</ref>; <ref loc="LUK 8:22-25">Lc. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Le'ga wiz ya, senꞌ ndolala yalꞌ, Jesús nchab lo re xinꞌ teꞌd Xaꞌ:</para>
  <para style="p" vid="MRK 4:35">—Ndanꞌ tedib lad ro nittoꞌ.<verse eid="MRK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 4:36" />Nde mcha's xaꞌ reta men nzi tya, yaja mxen xa' bark, le' Jesús nzola lo bark nde xisa mdonke tipla bark jwanꞌ nzi tya. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Per mxyo'b mbi toz lo nit, nde axta lenꞌ bark nchoche bde, ndosey nzo nit. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Leꞌ Jesús naxyat xanꞌ bark, xis ti almwad; nde mbloꞌxkalꞌ xaꞌ Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 4:38">—Maestr, ¿Cho na'ndlid la xgab ta ndolan' lenꞌ nit?<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Nde ngoche Jesús, mbrez Xaꞌ lo mbi nde nchab Xaꞌ lo bde:</para>
  <para style="p" vid="MRK 4:39">—¡Te'zta go'! ¡Xe bre goꞌ!</para>
  <para style="p" vid="MRK 4:39">Nde gotab mbi nde retay xe mbrey.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 4:40">—¿Cho kwan liy mzyeb toz goꞌ? ¿Cho na'ndlid lazoꞌ goꞌ Dios?<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Zyasa mzeb toz lazo' xaꞌ, nde nchab xaꞌ lo ta xaꞌ:</para>
  <para style="p" vid="MRK 4:41">—¿Cho Xaꞌ reꞌ, sa axta mbi nde nittoꞌ nxo'byeka Xaꞌ?<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Mbiꞌ yez Gadara nzo mbi narax lazonꞌ</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mt. 8:28-34</ref>; <ref loc="LUK 8:26-39">Lc. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Mzin xaꞌ tedib lad ro nittoꞌ, tenꞌ nak lo xyon Gadara. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Nde sen' mbla Jesús lo bark, zyaga mbro'to ti mbiꞌ lo Jesús, mbi' jwan' mbroꞌ xij re baꞌ nde nzo mbi narax lazo' xa'. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Tenꞌ nzi re baꞌ tya nak liz xaꞌ nde nek thib men na'lida gan go men xa', nekla kon kaden . <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Tak nar toz gob mbo men xaꞌ kon yi'b nde kaden, per nya kaden ncho' xa', nde nchix xa' yi'b; ngen cho men li gan tobo xaꞌ. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Nde reta yalꞌ nde ndlyabe ngete xaꞌ mbez xa' re lenꞌ wan nde xij re ba', ntowiyꞌ xaꞌ lad xaꞌ kon ke. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />Senꞌ mbwiꞌ xaꞌ tijra' nde Jesús, mke xaꞌ karrel nde mdo xub xaꞌ lo Jesús. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Nde mbrezyaj xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 5:7">—¿Cho kwan ndyaknoa na, Jesús, Xinꞌ Dios naro toz? Nya'b na loa, ndowiꞌ Dios, na'totid la na.<verse eid="MRK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 5:8" />Tak Jesús nchab la:</para>
  <para style="p" vid="MRK 5:8">—Mbi narax, broꞌte lazoꞌ mbiꞌ reꞌ.<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Nde mnabdiꞌs Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 5:9">—¿Cho lea?</para>
  <para style="p" vid="MRK 5:9">Leꞌ xaꞌ mkab, nchab xa':</para>
  <para style="p" vid="MRK 5:9">—Na ndole Bro toz;<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Diꞌs Legión nak: Bro toztir men xaja mer tib xop mil sondad.</char></note> Tak bro toz tir náꞌ.<verse eid="MRK 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 5:10" />Nde mna'b toz xaꞌ lo Jesús sa natelꞌta Jesús xaꞌ, xaꞌga lo xyon men. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Gax yek yi' tya nzi bro toz nguch nzi ya. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Nde mna'b reta mbi naraxa lo Jesús, nchaba:</para>
  <para style="p" vid="MRK 5:12">—Btelꞌ náꞌ lo re nguch sa lya náꞌ lenꞌ maꞌ.<verse eid="MRK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 5:13" />Nde zyaga mdaꞌ Jesús diꞌs. Nde mbro' reta mbi naraxa, mblay lenꞌ reta nguch, lo re nguch nzi ti chop mil maꞌ nde mbro'xon' maꞌ mbixnda'b maꞌ yek ke, nde mbla maꞌ lenꞌ nittoꞌ, ngwap maꞌ nit nde nguj re maꞌ.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Leꞌ re xaꞌ jwanꞌ nkenap nguch mxonꞌ xaꞌ nde ngwa tej xaꞌy lo re men nzi yez nde ranch. Nde mbro' reta men ngwa twiꞌ xaꞌ jwanꞌ ngok. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Sen' mzin reta men lo Jesús, mbwiꞌ xaꞌ mbiꞌ ta ngo bro toz mbi naraxa, xe ndob xaꞌ, nok xab xaꞌ nde mbi yek xaꞌ; nde mzyeb reta men. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Leꞌ re men jwanꞌ mbwiꞌ mtodanꞌ Jesús mbiꞌ ya, mdej xa' lo re men xa ngotey kon mbiꞌ ta ngo mbi naraxa nde kwan ngotey kon re nguch. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Nde mdobte mna'b xaꞌ lo Jesús sa ryoꞌte Jesús lo xyon xaꞌ.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Laj ndoyap Jesús lo bark, leꞌ mbiꞌ ta ngo mbi naraxa, mna'b toz xaꞌ lo Jesús sa tyonke xaꞌ xis Jesús. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Per na'nkapta Jesús diꞌs, che'la nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 5:19">—Bya liz la, tenꞌ nzi re xaꞌ taa, ptej re yalnaro jwanꞌ mbli Dios loa nde xa mblat lazoꞌ Dios mbwiꞌ Xaꞌ lu.<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Zyasa ndya xaꞌ, nde dib lo xyon Decápolis<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">Diꞌs Decápolis nak, siꞌ yez</char></note> mdobte mdej xa' plopa nak yalnaro jwanꞌ mbli Jesús lo xaꞌ; nde nzoyen re men mbin mena.<verse eid="MRK 5:20" /></para>
  <para style="s">Jesús mtodanꞌ ti ngol nde kon mzaꞌ xinꞌ Jaíro</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mt. 9:18-26</ref>; <ref loc="LUK 8:40-56">Lc. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Senꞌ mbere Jesús lo bark tedib lad ro nitto', men toz tir mdyop lo Jesús tya, yaja tyata mbyan' Xaꞌ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Nde mbye'd ti xaꞌ ndole Jairo, xa' nyebeꞌ lenꞌ yo tenꞌ ndyop men Israel, senꞌ mbwiꞌ xaꞌ Jesús, mdo xub xaꞌ lo ni Jesús, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />nde mna'b toz xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 5:23">—Mzaꞌ xinꞌ na naxyajla or; deꞌ sa xo'b la yaꞌa yek or, sa dyanꞌ or nde nagajta or.<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Zyasa nda Jesús kon Jaíro; nde bro toz men mdonke xis Xaꞌ, anta ngaꞌz men Xaꞌ. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Xija nzo ti ngol ndala tibsen linꞌ thiblaꞌ nge ren xa'. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Nde jwanꞌ tozla mbri'd xa' re yalti mkete xaꞌ lo re xa' ntoda'n men, nde mbre re tmin xaꞌ mbri'd xa' nde tatka nayiz xa', cheꞌla ndoro yiz lo xaꞌ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Senꞌ mbin ngol re jwan' ndyodiꞌs men ndli Jesús, mbike ngol gax xis Jesús, nde mbwal ngol xab Jesús. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Tak xgab ngol nak: “Masa gal ngol xab Jesús, sa dyanꞌ ngol.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Nde zyaga ngota'b yiz ren lo ngol, mdenꞌ xaꞌ mbyak xaꞌ nde mblyaꞌ xaꞌ lo yiz. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Zyaga mdenꞌ Jesús yalne chanꞌ Xaꞌ mbli mdyanꞌ ti men nde mbwiꞌ Xaꞌ lo re men, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 5:30">—¿Cho mbwal lad xab na?<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Re xinꞌ teꞌd Xaꞌ nchab:</para>
  <para style="p" vid="MRK 5:31">—Bwiꞌ, jwanꞌ toz ngaꞌz men lu nde mbez la: “¿Cho mbwal lad xab na?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Per Jesús, tatka ngwiꞌ Xaꞌ lo re men jwanꞌ nzi dib tenꞌ ndo Xaꞌ, nyenꞌ cho mbwal lad xab Xaꞌ. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Zyasa leꞌ ngol ya, mzyeb toz xaꞌ nde nxid xaꞌ, tak mne xaꞌ jwanꞌ ngok lo xa', mbike xaꞌ gax lo Jesús nde mdo xub xaꞌ lo Jesús, nde mdej xaꞌ jwan' xa nakpe'y. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Leꞌ Jesús nchab lo ngol:</para>
  <para style="p" vid="MRK 5:34">—Xinꞌ na, lo ta ndlipa lazoꞌa na, jwanꞌna mbli mblyaꞌa; nabeꞌz bya, tak mbyak la lo yiz jwanꞌ mxak la.<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Laj benꞌ ndotodiꞌs Jesús, mzin pla xaꞌ jwanꞌ mbroꞌ liz Jairo, nchab xaꞌ lo Jairo:</para>
  <para style="p" vid="MRK 5:35">—Ngujla mzaꞌ xinꞌ la; na'todotra' la lo maestr.<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Leꞌ Jesús, zyaga mbin Xaꞌ jwanꞌ nzi bez men tya, nchab Jesús lo Jaíro:</para>
  <para style="p" vid="MRK 5:36">—Nazyebta lu, benꞌta bli lazoꞌa na.<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Nde naꞌndad Jesús diꞌs ndonke xaꞌga men xis Xaꞌ, benꞌta Pedr, Jakob nde Juan wes Jakob mdonke. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Nde lo mzin xaꞌ liz Jaíro, mbwiꞌ Jesús anta chepa nziyak re men, re xa' jwan' nzi yonꞌ nde re xa' jwan' mbez nabil. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Leꞌ Jesús ngote lenꞌ yo nde nchab Xaꞌ:</para>
  <para style="p" vid="MRK 5:39">—¿Cho kwan liy taja nziyak goꞌ nde nziyon' goꞌ? Na'ngujta mzaꞌ, benꞌ naxyat mzaꞌ.<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Nde re men mxino xaꞌ Jesús. Le' Jesús, mbloꞌte xaꞌ reta men le, ben' xud mzaꞌ nde xnaꞌ mzaꞌ nde kon re yon xinꞌ teꞌd Jesús ngote tenꞌ nax mzaꞌ. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Nde mxen Jesús yaꞌ mzaꞌ, nchab Jesús lo mza':</para>
  <para style="p" vid="MRK 5:41">—Talita kumi<note caller="+" style="f"><char style="fr" closed="false">5:41 </char><char style="ft" closed="false">“Talita kumi” nak, diꞌs arameo.</char></note> —diꞌs reꞌ nak: ¡Mzaꞌ lud, na ni loa, gocheꞌ!<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Nde zyaga ngoche mzaꞌ nde mde mzaꞌ, ben' tibsen lin' nzor. Nde jwan' toz nzoyen re men.<figure style="fig" alt="Jesús levanta la hija de Jairo" file="cn01713B.tif" size="col" ref="5:42">¡Mzaꞌ lud, na ni loa, goche!</figure> <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Per mna'b toz Jesús lo re xa', sa nekthib lo men na'gapta xa'y, nde nchab Jesús lo xa', taꞌ xaꞌ jwanꞌ wa mzaꞌ.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Jesús mzin yez Nazaret</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mt. 13:53-58</ref>; <ref loc="LUK 4:16-30">Lc. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Mbroꞌ Jesús tya nde ndya Xaꞌ yez Nazaret tenꞌ nak laz Xaꞌ, kon re xinꞌ teꞌd Xaꞌ. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Senꞌ mzin wiz jwanꞌ ndryoxkwen men, Jesús mdobte mbloꞌ xkiꞌs Dios len' yo tenꞌ ndyop men Israel; bro toz men, mbin xa'y, nde nzoyen xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 6:2">—¿Plo ngwa teꞌd Xaꞌ re jwan' reꞌ? ¿Nde plo ngwa xiꞌ Xaꞌ yalnchak nde re yalnaro jwanꞌ ndli Xaꞌ? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />¿Cho na'nakta Xaꞌ reꞌ ta ntoxkwaꞌ re ya? Xnaꞌ Xaꞌ nak Marí nde wes Xaꞌ nak Jakob, José, Judas nde Simón? ¿Cho na'noda re men nak ptanꞌ Xaꞌ nche' nzo xaꞌ?</para>
  <para style="p" vid="MRK 6:3">Nde ntola mbre xaꞌ lo Jesús. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Leꞌ Jesús nchab lo xa':</para>
  <para style="p" vid="MRK 6:4">—Reta lad nxo'byek men ti profet, <note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Xaꞌ reꞌ nak Profeta.</char></note> per plo tenꞌ nak laz xaꞌ, na'nxo'byekta men xaꞌ, nek re men ta xaꞌ nde neka men liz xaꞌ.<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Nde nek thib yalnaro na'ndlid Jesús tya, benꞌta pla men nayiz mxo'b yaꞌ Jesús yek xaꞌ nde mbyak men. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Nde nzoyen toz Jesús lo na'ndlid lazoꞌ men Xaꞌ. Nde mkete Jesús re yez bix jwanꞌ nzi dib gax tya, mblo' Xa' xki's Dios.<verse eid="MRK 6:6" /></para>
  <para style="s">Mbloned Jesús re tib sen xinꞌ teꞌd Xaꞌ sa ya tej xaꞌ xkiꞌs Dios</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mt. 10:5-15</ref>; <ref loc="LUK 9:1-6">Lc. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Ngolo jwanꞌna, mbrez Jesús re tib sen xinꞌ teꞌd Xaꞌ nde mdaꞌ Jesús yalnyebeꞌ lo xaꞌ sa kote xaꞌ re mbi narax nzo lazoꞌ men nde mbloned Jesús chop chopa xaꞌ.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />Nde mnabe' Jesus na'wed xa' nek thib jwan' par ned, benꞌta ti yaga jwanꞌ nata we xa'. Na'wed xaꞌ yex, nek jwanꞌ wa xaꞌ, nek tmi, <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ben' yalyid ke ni xa' nde benꞌ lar nokta xaꞌ we xa'. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Noga nchab Jesus lo xa': Oneja cho liz men sin goꞌ, tya byanꞌ goꞌ axta kebeꞌ ryoꞌ goꞌ yez ya. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Nde tez nzo ten' na'kabta xaꞌ lo goꞌ nde na'tonzad xaꞌ jwan' tej goꞌ, broꞌte goꞌ tya nde bsib goꞌ yothiꞌ ni goꞌ, sa lo' ke namkaya'd xa' go'. Nipa na lo goꞌ senꞌ sin wiz jwanꞌ nya'b Dios kwent lo reta men, mas bro pen nye re men yez ta na'mkaya'd xa' goꞌ, ke re men yez Sodoma nde Gomorra.<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Nde mbro' re xaꞌ, nda tej xaꞌ lo re men, laꞌ men re jwanꞌ narax nak men nde bere men lo Dios. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Nde bro toz re mbi narax mblo'te xa' lazoꞌ men nde bro toz re men nayiz mdaꞌb xaꞌ aceit yek men nde mbyak men.<verse eid="MRK 6:13" /></para>
  <para style="s">Nguj Juan ngole men</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mt. 14:1-12</ref>; <ref loc="LUK 9:7-9">Lc. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Dib nax mxyo'b xkiꞌs Jesús, re jwanꞌ wen ndli Xaꞌ, axta rey Herodes xaꞌ nyebeꞌ lo xyon Galilea, mbin xaꞌy nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 6:14">—Juan ngole men mbro'xban xij re xa' nguj, xaꞌ ya ta nak Jesús, jwanꞌ nasa nchak ndli xaꞌ reta yalnaro.<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Tipla men nchab:</para>
  <para style="p" vid="MRK 6:15">—Elías nak Xa ya.<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">1de Reyes 17 al 2 de Reyes 2 y Malaquías 4:5-6</char></note></para>
  <para style="p" vid="MRK 6:15">Nde tipla men nchab:</para>
  <para style="p" vid="MRK 6:15">—Ti profeta, o ti profet ta ngo polay.<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">Xaꞌ reꞌ nak Profeta</char></note> <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Senꞌ mbin Herodes ta mbez re men, Herodes nchab:</para>
  <para style="p" vid="MRK 6:16">—Xaꞌ ya nak Juan, xaꞌ ta mnabeꞌn mcho' yek naꞌ, nde naya mbroxban xaꞌ xij re men ngujla.<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Tak le'ga Herodes jwan' mtelꞌ men sa mxen xa' Juan nde mkedoꞌ xaꞌ Juan lenꞌ liz yib kon kaden, xke chanꞌ Herodías ngol Blib, wes Herodes, tak Herodes ndobno ngol. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Tak Juan nchab lo Herodes:</para>
  <para style="p" vid="MRK 6:18">—Na'ndabloda tyob noa ngol wes la.<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Jwanꞌ nasa mbyiꞌno toz Herodías Juan, ncholaꞌs ngol kuj ngol xaꞌ, per na'lid ngol gan, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />tak Herodes mzyeb xaꞌ Juan, mne xaꞌ ke Juan nak xa' ti mbi' gal' nde mbi' nayon, jwanꞌ nasa thibla' ndla Herodes Juan; tak lo nchon xa' jwan' ndej Juan na'nyed xaꞌ kwan li xaꞌ, per dib nzo lazo' xa' ndonza xa' Juan. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />Per mzin ti wiz wen lo Herodías, wiz jwan' ngoxo'b linꞌ Herodes, zya mbli xa' ni, mda rzye' xaꞌ kon re ta nak sinꞌ xaꞌ, re xaꞌ jwanꞌ nyebeꞌ lo re sondad nde re xaꞌ jwanꞌ nak xaꞌ ro lo xyon Galilea, <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />tya ngote mzaꞌ xinꞌ Herodías, tolo mkani mzaꞌ, nde mbroꞌ toz lazoꞌ Herodes nde kon re xaꞌ nzi ro mes xa nkani mzaꞌ, nde nchab Herodes lo mzaꞌ:</para>
  <para style="p" vid="MRK 6:22">—Mna'b jwanꞌ ncholaꞌs la lon, ta ney kaa.<verse eid="MRK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 6:23" />Nde mke'ro xa', nchab xa': Reta jwanꞌ nya'b la lon taney kaa, axta rol yalnyebe' chan' na tan kaa.<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Zya mbroꞌte mzaꞌ nde nchab mzaꞌ lo xnaꞌ mzaꞌ:</para>
  <para style="p" vid="MRK 6:24">—¿Cho kwan nya'b na?</para>
  <para style="p" vid="MRK 6:24">Leꞌ xnaꞌ mzaꞌ nchab:</para>
  <para style="p" vid="MRK 6:24">—Mna'b yek Juan ta ngole men.<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Zyasa naban toz mbere mzaꞌ lo rey, nde nchab mzaꞌ:</para>
  <para style="p" vid="MRK 6:25">—Ncholas na, le'ga naya taꞌa ngud yek Juan kan, tyoba ti lo yen.<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Leꞌ Rey Herodes nabil toz ngo lazo' xaꞌ; per lo ta mke'ro xa' nzi wiꞌ re men jwanꞌ nzi ro mesa, jwanꞌ nasa naꞌnkabrod xaꞌ. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Nde zyaga mbloned rey ti sondad, mnabe' xaꞌ cho ngud yek Juan nde yedno xaꞌy. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Leꞌ sondad ngwa xa', mcho' xa' ngud yek Juan len' liz yi'b, ndeno xaꞌy ndoba ti lo yen nde mdayaꞌ xaꞌy lo mzaꞌ, leꞌ mzaꞌ mdaꞌya'y lo xnaꞌ mzaꞌ.<verse eid="MRK 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 6:29" />Senꞌ mbin re xinꞌ teꞌd Juan jwan'na, ngwaxiꞌ xaꞌ thobol nde mkaꞌs xaꞌ xaꞌ len' ba'.<verse eid="MRK 6:29" /></para>
  <para style="s">Jesús mtowa ti gayꞌ mil mbiꞌ</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mt. 14:13-21</ref>; <ref loc="LUK 9:10-17">Lc. 9:10-17</ref>; <ref loc="JHN 6:1-14">Jn. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Zyasa re xa' nak apost thita mdyop xa' kon Jesús, nde mdej xaꞌ lo Jesús reta jwanꞌ ngwa li xaꞌ nde re jwanꞌ ngwa loꞌ xaꞌ. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Jesús nchab lo xa':</para>
  <para style="p" vid="MRK 6:31">—Yaꞌ goꞌ ndanꞌ ti tenꞌ naꞌngenta men, sa ryo'xkwen naꞌ lud. Tak bro toz men jwan' ndya nde men jwan' nzin, nekla ta' men di's wa re xa'<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Nde leꞌta xaꞌ nda lo ti bark ti plo tenꞌ naꞌngenta men. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Per bro toz men mne nda re xa' nde mblibeꞌ men Jesús; bro toz men jwanꞌ nzo re yez gax nzi tya nda ni xaꞌ nde nerla xaꞌ mzin, mkata re xa' lo Jesús. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Sen' mbla Jesús lo bark, mbwiꞌ Xaꞌ men toz nzila tya, nde mblat lazoꞌ Jesús mbwiꞌ Xa' lo re men ya, tak nak men xaja mbakxilꞌ jwanꞌ naꞌngenta xa' kenap, nde mdobte mtoteꞌd Jesús xaꞌ lo bro toz jwanꞌ. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Senꞌ mzyela izyo, re xinꞌ teꞌd Jesús mbike xaꞌ gax nde nchab xaꞌ lo Jesús:</para>
  <para style="p" vid="MRK 6:35">—Bzye tozla nde naꞌngenta liz men ncheꞌ. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Pchaꞌs reta men, sa ya ka xaꞌ jwanꞌ wa xaꞌ re yez jwanꞌ nzi gax ncheꞌ nde re ranch, tak ncheꞌ ngenta jwanꞌ wa xaꞌ.<figure style="fig" alt="Jesús da de comer a los 5,000" file="cn01715B.tif" size="col" ref="6:36">¿Plo ya xi náꞌ jwanꞌ wa reta men reꞌ?</figure><verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 6:37">—Goꞌ Ptaꞌ jwanꞌ wa men.</para>
  <para style="p" vid="MRK 6:37">Leꞌ xaꞌ nchab:</para>
  <para style="p" vid="MRK 6:37">—¿Plo ya xiꞌ náꞌ tmi tyuꞌ jwanꞌ wa reta men reꞌ? Tenye chop ayoꞌ wiz ke tib men sinꞌ nagalta tmi ya.<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">Tib wiz ndli tib xaꞌ gan tib denario, chop ayoꞌ wiz chop ayoꞌ denario.</char></note><verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 6:38">—Wa twiꞌ goꞌ nyenꞌ pla pan ngeno goꞌ. Zyasa ngwa twiꞌ xaꞌ nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 6:38">—Benꞌta gayꞌ pan nde chopta mbel nzo. <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Nde mnabeꞌ Jesús sa kweksaꞌ xaꞌ men lo yix naye nzi tya. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Nde mbrezaꞌ xaꞌ, ayoꞌ por ayoꞌ xaꞌ nde choꞌpsiꞌ por choꞌpsiꞌ xaꞌ. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Zyasa mxen Jesús re gayꞌ pan kon rop mbel nde mbwiꞌ Xaꞌ lo beꞌ, mbli ley' xa'y, nde mblirol Xaꞌ pan mda' Xa'y lo re xinꞌ teꞌd Xaꞌ sa yathi'd xaꞌy lo reta men nde taga mdi'd Xaꞌ mbel. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Nde mda reta men axta mze lenꞌ xaꞌ. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Nde mthop xa' reta jwan' mbroxo'b, mbro' tib sen chokwid sey chan' pan nde mbel. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Nde reta xaꞌ jwanꞌ mda nak xa' ti gayꞌ mil mbi'.<verse eid="MRK 6:44" /></para>
  <para style="s">Jesús ndye lo nittoꞌ</para>
  <para style="r">(<ref loc="MAT 14:22-27">Mt. 14:22-27</ref>; <ref loc="JHN 6:16-21">Jn. 6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Ngolo jwan' re', mbloned Jesús re xin' te'd xa' ngwap xa' lo ti bark sa nda xa' yez Betsaida tedib lad ro nit.</para>
  <para style="p" vid="MRK 6:45">Laja leꞌ Jesús ndotodiꞌsno re men sa rya's men. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Senꞌ ngolo mcha's Jesús reta men, Jesús ngwap yek yi' ngwatodiꞌsno Xaꞌ Dios. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Lo mbla yal', leꞌ bark jwanꞌ nzo re xinꞌ teꞌd Xaꞌ ndale rolja nittoꞌ nde Jesús benꞌ ndo ro nit. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Nde mbwi' Jesús ne toz ndateno re xin' te'd Xaꞌ bark, tak narax nde mbi lo nit, senꞌ merla tuxni Jesús ndoyotu ten' nda bark ndani Xa' lo nittoꞌ, nde nchola's Xa' ri'dnda'b gal' Xa'. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Sen' mbwiꞌ re xaꞌ ndoni Jesús lo nittoꞌ, mbli xaꞌ xgab naka jwanꞌ bet, nde mbrez yaj toz re xa'. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Tak reta xaꞌ mbwiꞌ Jesús nde mzyeb toz xaꞌ. Per zyaga mni Jesús lo xa', nchab Jesús:</para>
  <para style="p" vid="MRK 6:50">—¡Blo ne lazoꞌ goꞌ, nay, naꞌzyepta goꞌ!<figure style="fig" alt="Jesús sobre el mar" file="cn01720B.tif" size="col" ref="6:50">Jesús nchab: —Blo ne lazoꞌ goꞌ, nay, naꞌzyepta goꞌ</figure><verse eid="MRK 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51" />Nde ngwap Jesús lo bark, nde ngota'b mbi, nde nzoyen toz reta xaꞌ nde nale toz ngo lazo' xaꞌ. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Tak tera' yen re xaꞌ yalnaro jwanꞌ mbli Jesús kon re pan, ben' ne yek xaꞌ jwanꞌ nasa naꞌngyenta xaꞌ.<verse eid="MRK 6:52" /></para>
  <para style="s">Jesús ntodanꞌ re men nayiz yez Genesaret</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mt. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Senꞌ ngolo mbri'd xaꞌ lo nittoꞌ, mzin xaꞌ lo xyon Genesaret, nde tya mkedoꞌ xaꞌ bark ro nit. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Nde laj ndola xaꞌ lo bark, zyaga reta men nzi tya mbyolo xaꞌ Jesús. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Nde mchaꞌs xaꞌ diꞌs dib nax lo xyon ya, nde reta lad mdobte ndryo' re men ndeno xaꞌ re men nayiz lo Jesús, nge xaꞌ lo ya lonꞌ, nda xa' tenꞌ nchon xaꞌ ndo Jesús. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Nde one ploja nda Jesús, re yez ro, re yez bix nde re ranch, reta men ngote xaꞌ re men nayiz, ndob xaꞌ re mena ro ned nde nya'b toz xaꞌ lo Jesús sa ta' Jesús diꞌs te' benꞌ gal men yiza lad xab Jesús sa dyanꞌ xaꞌ. Nde reta men yiz jwanꞌ mbwal lad xab Jesús mdyan' xaꞌ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Jwanꞌ ndli yalke lo men</para>
  <para style="r">(<ref loc="MAT 15:1-20">Mt. 15:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Re xaꞌ fariseo nde pla maestr nte'd ley xa' mbroꞌ yez Jerusalén, mdyop xaꞌ tenꞌ ndo Jesús. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Re xa' re', mbwiꞌ xaꞌ pla xinꞌ teꞌd Jesús tata nabew ya xaꞌ ncha xaꞌ pan, na'ntachta xa' ya' xa', jwanꞌna nak yalke mkeꞌ xaꞌ yek xinꞌ teꞌd Jesús. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />Tak re xaꞌ fariseo nde reta men Israel, nxo'byek toz xaꞌ mod mtanꞌ re xaꞌ gox jwanꞌ mbre pola, tez naꞌyachta yaꞌ xaꞌ, natoyalta wa xaꞌ. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Nde lo mbere xaꞌ ngwa xaꞌ lo xbiꞌ, tez na'yachta yaꞌ xaꞌ na'wad xaꞌ. Nde na'r toz xaꞌga re jwanꞌ nkenap xaꞌ lo mod gox, xa nak yach re xi nchuꞌ xaꞌ nit, yach ré nde re yet yi'b jwanꞌ ndli rsinꞌ xaꞌ, nde axta re lon' xaꞌ, yacha. <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />Jwanꞌ nasa re xaꞌ fariseo nde re maestr nchak ley, mnabdiꞌs xaꞌ lo Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 7:5">—¿Cho kwan liy sa re xinꞌ teꞌd la na'ntachta xaꞌ ya' xa' senꞌ ncha xaꞌ, na'nxo'byekta xaꞌ re mod jwanꞌ mtanꞌ re xaꞌ gox mbre pola, che'la tata ya' xa' ncha xa'?<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 7:6">—Men kwinꞌ go', galꞌka mdej Isaías, jwan' xa ngeniga lo xkiꞌs Dios<note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="ft" closed="false">Xaꞌ reꞌ nak ti Profet</char></note>:</para>
  <para style="q" vid="MRK 7:6">Yez reꞌ benꞌ ro xaꞌ nxo'byek xaꞌ na,</para>
  <para style="q" vid="MRK 7:6">Le' lazoꞌ xaꞌ tij ndoy lon.<verse eid="MRK 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MRK 7:7" />Benꞌ nale nxo'byek xa' na,</para>
  <para style="q" vid="MRK 7:7">Ndloꞌ xaꞌ re yalte'd jwan' nak yalnyebe' chanꞌ men.<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">Isaías. 29:13</char></note><verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Tak mblaꞌ goꞌ re yalnyebeꞌ chanꞌ Dios, na leꞌ goꞌ ndyonke xis re mod gox jwanꞌ mtanꞌ re men gox pola, jwan' xa nak yach yet ré nde yach re xi jwanꞌ nchuꞌ goꞌ nit nde masraꞌ re jwanꞌ re' ndli goꞌ.<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Noga nchab Jesús:</para>
  <para style="p" vid="MRK 7:9">Thiptane mblo'tal goꞌ re yalnyebeꞌ chanꞌ Dios sa nxo'byek goꞌ re mod gox. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Tak Moisés nchab: “Bxo'byek xud la nde xnaꞌa;”<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">Ex. 20:12</char></note> nde: “Men jwanꞌ nke'de xis xud naꞌ o xnanꞌ, ndablo gaj xaꞌ.”<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">Ex. 21:17</char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Leꞌ goꞌ mbez: Toyal gab men lo xud men o lo xnaꞌ men: “Na'lit na gan tan jwan' la'ston la tak reta jwanꞌ ngenon naka, korbán.” (Diꞌs reꞌ nak: “naka jwan' nayon lo Dios”.) <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Nde lo ta gab xaꞌ, na'toyalta la'sto xa' xud xaꞌ o xnaꞌ xaꞌ. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Tamod ngo'tal goꞌ yalnyebeꞌ chanꞌ Dios, ndyonke goꞌ xis re mod gox jwanꞌ nden goꞌ. Nde na'r toz jwanꞌ tamod ndli goꞌ. <verse eid="MRK 7:13" /><verse number="14" style="v" sid="MRK 7:14" />Nde mbrez Jesús reta men nzi tya, nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 7:14">—Reta goꞌ, pkeꞌnza jwanꞌ ni lo go' nde byen goꞌy. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Nekthib re jwan' ta nda len' men, na'ndlide narax lo men; per re xgab narax nde diꞌs narax jwanꞌ ndryoꞌ lazoꞌ men, jwanꞌna ndli narax lo men. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />¡Tez nzo goꞌ ngeno nzanꞌ sa gon go'y, bin goꞌy!<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Senꞌ mbroꞌ Jesús xij reta men nde ngote Xaꞌ lenꞌ yo, zya mna'bdiꞌs re xin' te'd Xa' nyenꞌ xamod nak di's nabixa. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 7:18">—¿Cho noga' goꞌ nangyenta go'y? ¿Cho na'nyed goꞌ reta jwanꞌ ta ncha men na'ndlide narax lo men, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />tak na'ndlyade lazoꞌ men, leꞌy nda lenꞌ men nde tya ndryoꞌtey nday wan?</para>
  <para style="p" vid="MRK 7:19">Jwanꞌ reꞌ mdej Jesús, nchab Xaꞌ ke reta jwanꞌ ncha men na'dlide narax lo men.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Per nchab Jesús:</para>
  <para style="p" vid="MRK 7:20">—Reta xgab narax nde diꞌs narax jwanꞌ ndryoꞌ lazoꞌ men, jwanꞌna ndli narax lo men. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Tak lazoꞌ men nchal reta xgab narax, xa nak, re xaꞌ jwan' ncha'xno tedib men na'nakta sal' xa', re xaꞌ ta ndli re ned yalxkap nde re xaꞌ nguj men, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />yalwanꞌ, yaltablaꞌs, yalxinlaꞌs, yalkwinꞌ, jwan' thiptane ndlya men lo jwan' narax, nayiꞌ xaꞌ nye xaꞌ chanꞌ ta xaꞌ, yaltodiꞌsyix, yalbxalꞌ nde yalneyek.<verse eid="MRK 7:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MRK 7:23" />Reta jwan' narax reꞌ, lazoꞌ men ndryoꞌy nde ndliy narax lo men.<verse eid="MRK 7:23" /></para>
  <para style="s">Ti ngol na'nakta men Israel, mblipa lazoꞌ xaꞌ Jesús</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mt. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Mbroꞌ Jesús tya, nda Xaꞌ lo xyon Tiro nde Sidón. Senꞌ mzin xaꞌ, mbla Xa' len' yo, na'nchola'sta Xaꞌ nye nek thib mena, per na'ndlid Xaꞌ gan nka'slo Xa'. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Tak ngo ti ngol ngeno xaꞌ ti mzaꞌ xinꞌ xaꞌ nzo mbi narax lazo'r, sen' mbin xaꞌ mzin Jesús, mbyeꞌd xaꞌ lo Jesús nde mdoxub ngol lo ni Jesús. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Ngol reꞌ nanakta xaꞌ men Israel, leꞌ xaꞌ nak men lo xyon Sirofenicia. Nde mna'b toz xa' lo Jesús sa kote Jesús mbi narax nzo lazoꞌ mza'. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Leꞌ Jesús nchab lo ngol:</para>
  <para style="p" vid="MRK 7:27">—Btaꞌ diꞌs sa nerla wa re mdyenꞌ, tak nawenta kib men jwanꞌ ndob yar nde taꞌ mena lo mbak.<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Leꞌ ngol mkab:</para>
  <para style="p" vid="MRK 7:28">—Taga naka Xaꞌ Nyebeꞌ; per re mbaka ndlya maꞌ xanꞌ mes nde ncha maꞌ re kos jwanꞌ nchab lo yaꞌ mdyenꞌ.<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Zyasa nchab Jesús lo ngol:</para>
  <para style="p" vid="MRK 7:29">—Lo di's ta mkab la re', bya, leꞌ mbi narax mbroꞌtelay lazoꞌ xinꞌ la.<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Nde senꞌ mzin ngol liz ngol, mbwiꞌ ngol mbro'tela mbi narax lazoꞌ mzaꞌ nde xe nax mzaꞌ lo lonꞌ.<verse eid="MRK 7:30" /></para>
  <para style="s">Jesús mtodanꞌ tib xaꞌ nka ronꞌ nde nkweꞌ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Tya bere mbro' Jesús lo xyon Tiro, mbri'd xaꞌ yez Sidón nde nda xaꞌ ro nittoꞌ chan' Galilea, tya mbri'd xaꞌ lo xyon Decápolis. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Nde tya mbye'dno xa' lo Jesús ti mbiꞌ nkwe' nde nka ro xa', nde mna'b toz xaꞌ sa xo'b yaꞌ Jesús yek mbiꞌ ta nayiza.<figure style="fig" alt="La gente pide a Jesús por un hombre" file="CN01755B.TIF" size="col" ref="7:32">Jesús mtodanꞌ tib mbiꞌ lo xzyon Decápolis</figure> <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Nde xa'ta mbeꞌ Jesús mbiꞌ ya, mblo Jesús kwenyaꞌ Xaꞌ rop lenꞌ nza mbiꞌ nde kon lud xit suk Xaꞌ mdob Xaꞌy lo loz mbiꞌ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Nde mbwiꞌ Jesús lo beꞌ, mdiꞌ lazoꞌ Xaꞌ, nde nchab Xaꞌ:</para>
  <para style="p" vid="MRK 7:34">—¡Efata! (Diꞌs ya nak: ¡Pxyalꞌ!)<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Zyaga mxyalꞌ rop nza men yiza nde mxyalꞌ ro xaꞌ nde mdobte nawe mdodiꞌs xaꞌ. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Nde mnabeꞌ Jesús ngen cho lo men gab xa'y, per senꞌ nya'b toz Jesús na'tejta xa'y, masraꞌ ndej xa'y lo re men. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Nde jwan' toz tir nzoyen reta men, nchab xaꞌ:</para>
  <para style="p" vid="MRK 7:37">—¡Wen toz ndli Xaꞌ, ndli Xaꞌ nxyalꞌ nza men nkweꞌ nde ndli Xaꞌ ndyodiꞌs re men jwanꞌ naꞌakta todiꞌs.<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">Is. 35:5-6</char></note><verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Jesús ntowa thap mil men</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mt. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Lenꞌ wiz ya taxa mkata bro toz men lo Jesús nde naꞌngenta jwanꞌ wa re men. Zyasa mbrez Jesús re xinꞌ teꞌd Xaꞌ nde nchab Xaꞌ:<verse eid="MRK 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 8:2" />—Ndlat lazoꞌn ngwi'n re men reꞌ, tak ndala son wiz nzi xaꞌ kon na nche' nde naꞌngenod xaꞌ jwanꞌ wa xaꞌ, <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />tez tata tera wa xaꞌ goned na xaꞌ liz xaꞌ, naxkeꞌ mbiy yek xaꞌ ned, tak nzo xaꞌ xija nde tij.<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Leꞌ re xa nak xinꞌ teꞌd Jesús nchab:</para>
  <para style="p" vid="MRK 8:4">—¿Plo ya xinꞌ jwanꞌ wa reta men reꞌ, tak ncheꞌ ngenta kwan nak nde tij nzi re yez?<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Zya mnabdiꞌs Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 8:5">—¿Pla pan ngeno goꞌ?</para>
  <para style="p" vid="MRK 8:5">Leꞌ xaꞌ mkab:</para>
  <para style="p" vid="MRK 8:5">—Gaza.<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Zyasa mnabeꞌ Jesús tyob reta men izyo; nde mxen Jesús re gaz pan, ngolo mdaꞌ Xaꞌ dyux lo Dios, mblirol Xaꞌy, nde mdaꞌ Xaꞌy lo re xinꞌ teꞌd Xaꞌ, sa yathi'd xaꞌy; nde ngwathi'd xa'y lo reta men. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Noga ngeno xaꞌ pla mbel tya; nde taga mbli le'y Xaꞌy nde mnabeꞌ Jesús yathi'd xaꞌy lo reta men. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Nde mda men axta kebeꞌ mze lenꞌ men; ngolo mne mda reta men, zyasa mthop xaꞌ reta jwanꞌ mbroxo'b nde mkata tib gaz chokwida. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Lo reta men jwanꞌ nzi tya, nzi ti thap mil xaꞌ, zyasa mchaꞌs Jesús reta men. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Nde ngwap Jesús lo bark kon re xinꞌ teꞌd Xaꞌ nde nda xaꞌ tenꞌ nak lo xyon Dalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Re xaꞌ fariseo nya'b xaꞌ li Jesús yalnaro lo xaꞌ</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mt. 16:1-4</ref>; <ref loc="LUK 12:54-56">Lc. 12:54-56</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Tya mzin pla xaꞌ fariseo, tolo chepa mbrez xaꞌ lo Jesús, mna'b xaꞌ yalnaro jwanꞌ nde lo beꞌ, sa libeꞌ xaꞌ nyenꞌ cho liga Dios mtelꞌ Jesús.<verse eid="MRK 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12" />Zyasa axta mtiꞌ lazoꞌ Jesús nde nchab Jesus lo xaꞌ:</para>
  <para style="p" vid="MRK 8:12">—¿Kwan sa re men nzi nche' ncholaꞌs xaꞌ lin yalnaro lo xaꞌ? Nipa na lo go', ke nekthib yalnaro na'lot na lo me ta nzi nche'.<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Nde mblaꞌ Jesús re men ya, bere ngwap xaꞌ lo bark tedib gob, nda xaꞌ tedib lad ro nittoꞌ.<verse eid="MRK 8:13" /></para>
  <para style="s">Lebadur jwan' nak re xa' fariseo</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mt. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Le' re xin' te'd Jesús mbyaj yek xaꞌ nkweꞌ xaꞌ pan, benꞌ thipta pan ngeno xa' len' bark. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Le' Jesús mnabe' lo xaꞌ, nchab Jesús:</para>
  <para style="p" vid="MRK 8:15">—Pto nza go', nda wiꞌ toz goꞌ kon lebadur jwan' nak re xaꞌ fariseo nde lebadur jwan' nak Herodes.<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Nde mdobte nchab xaꞌ lo ta xaꞌ:</para>
  <para style="p" vid="MRK 8:16">—Tak na'ndenod naꞌ pan jwanꞌ nasa ta mbez Xaꞌ.<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Zyaga mne Jesús jwan' ta nzi bez xaꞌ nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 8:17">—¿Kwan ta nzi bez go',cho tak naꞌndenod goꞌ pana? ¿Cho naꞌnchonta goꞌ diꞌs, neka tera yen goꞌ? ¿Tata ben' ne toz lazo' goꞌ? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />¿Ndob ngud lo goꞌ nde nangwi'd goꞌ, ndob nza goꞌ nde nanchonta goꞌ diꞌs? ¿Nde naꞌntelaꞌsta go'? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Senꞌ mdi'd na re gayꞌ pan xij re gayꞌ mil mbiꞌ, ¿pla chokwid pan jwanꞌ mbro'xo'b mthop goꞌ?</para>
  <para style="p" vid="MRK 8:19">Leꞌ xaꞌ mkab:</para>
  <para style="p" vid="MRK 8:19">—Tib sen na.<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />Nde senꞌ mdi'd na re gaz pan xij re tap mil men, ¿Pla chokwid pan mbro'xo'b mthop goꞌ?</para>
  <para style="p" vid="MRK 8:20">Leꞌ xaꞌ mkab:</para>
  <para style="p" vid="MRK 8:20">—Gaza.<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 8:21">—¿Cho kwan liy tera' yen goꞌ sa?<verse eid="MRK 8:21" /></para>
  <para style="s">Jesús mxalꞌ ngudlo ti xaꞌ naꞌakta wiꞌ nzo yez Betsaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Zyaga mzin Xa' yez Betsaida; tya mbye'dno men ti xaꞌ naꞌakta wiꞌ nde mna'b xaꞌ lo Jesús sa gal Jesús men ta nayiza. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Zyasa mxen Jesús yaꞌ mbiꞌ ta nayiz ngudlonꞌ ya, mbeꞌ Jesús xaꞌ lad ro yez; tya mzuk Jesús ngudlo xaꞌ nde mbwal Jesús ngudlo xaꞌ nde mnabdiꞌs Jesús lo xaꞌ, cho toyala wi' xa' lud<figure style="fig" alt="Jesús sana un ciego" file="CN01741B.TIF" size="col" ref="8:23">Jesús nchab lo mbiꞌ: —¿Cho ndoyonila lud loa?</figure> <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Zya mbwiꞌ xa' nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 8:24">—Xanya ya nya re mena ndyak na, per ngwi'n ndye xaꞌ. <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Zyaga bere mbwal Jesús ngudlo xaꞌ tedib gob, nde mbli Jesús mbwi' xa'; nde nawe mxyal' lo xa', tij nchoni lo xa' nde nambi ngwi' xa' reta men. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Nde mbloned Jesús xaꞌ liz xaꞌ, nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 8:26">—Naꞌlyad la lenꞌ yez nde nagapta luy nek tib lo men nzo yez.<verse eid="MRK 8:26" /></para>
  <para style="s">Pedr ndej ke Jesús nak Xaꞌ Mtelꞌ Dios</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mt. 16:13-20</ref>; <ref loc="LUK 9:18-21">Lc. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Jesús mbroꞌ kon re xinꞌ teꞌd Xaꞌ nda xaꞌ re yez jwanꞌ nzi lo xyon Cesarea chan' Filipo. Nde ned mnabdiꞌs Jesús lo re xinꞌ teꞌd Xaꞌ, nchab Xa':</para>
  <para style="p" vid="MRK 8:27">—¿Cho nak na mbez re men?<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Leꞌ xinꞌ teꞌd Xaꞌ nchab:</para>
  <para style="p" vid="MRK 8:28">—Nzo men mbez nak la Juan Bautist, nzo men mbez nak la Elías<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Elías nak tib profet xaꞌ jwanꞌ mbyeꞌd taꞌ xkiꞌs Dios pola. Mikeas 4:5-6, I Reyes 17-II Reyes 2</char></note> nde nzo men mbez nzo cho ti profet nak la.<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Diꞌs reꞌ nak Profet</char></note> <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Zyasa nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 8:29">—Mbay goꞌ, ¿Cho nak na mbez goꞌ?</para>
  <para style="p" vid="MRK 8:29">Le' Pedr mkab</para>
  <para style="p" vid="MRK 8:29">—Lu nak Xaꞌ Mtelꞌ Dios.<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Per mnabeꞌ Jesús lo xaꞌ nek thib lo men na'tejta xaꞌ jwanꞌ reꞌ.<verse eid="MRK 8:30" /></para>
  <para style="s">Jesús ndej gaj Xaꞌ</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mt. 16:21-28</ref>; <ref loc="LUK 9:22-27">Lc. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Nde mdobte mblo' Jesús lo xa' nakin' le' Xinꞌ Mbiꞌ rid Xa' brotoz yalti, nde re xaꞌ gol nak sinꞌ lo men Israel, re xaꞌ nak ngwleyꞌ ro nde re xaꞌ nak maestr ndlo' ley. nde kuj men Xin' Mbi', per yoxo'b mbyon wiz ryo'xban Xa'.<verse eid="MRK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 8:32" />Nambi toz mdej Jesús re jwan' re'. Zyasa mbeꞌ Pey Jesús tedib lad nde mbrez Pey yek Xaꞌ. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Leꞌ Jesús mbyek, mbwiꞌ Xaꞌ lo re xinꞌ teꞌd Xaꞌ nde mbrez Xaꞌ yek Pey, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 8:33">—¡Bike lon Maxuꞌ! tak nandobta xgab la lo chanꞌ Dios, leꞌ xgab la ndob lo chan' men.<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Zya mbrez Jesús re xinꞌ teꞌd Xaꞌ kon reta men nzi tya nde nchab Xaꞌ:</para>
  <para style="p" vid="MRK 8:34">—Tez nzo goꞌ ncholaꞌs tyonke xis na, bla' go' re jwan' nak go', nde beꞌ goꞌ kruz goꞌ, nde ptonke goꞌ xis na. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Tak re men jwanꞌ ncholaꞌs tolaꞌ yalnaban chanꞌ xaꞌ lo izyo reꞌ, xaꞌ ya taꞌb yalnaban adiꞌ jwanꞌ ndaꞌ Dios; nde re men jwanꞌ taꞌb yalnaban chanꞌ xaꞌ lo izyo reꞌ por ndli lazoꞌ xaꞌ na nde diꞌs wen chanꞌ Dios, xaꞌ ya ligan yalnaban adiꞌ jwanꞌ ndaꞌ Dios. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Tak, ¿cho sinꞌ liy lo men keno men reta jwanꞌ nzo lo izyo reꞌ nde ta'b men yalnaban adiꞌ ndaꞌ Dios? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Ngenta cho men li gan kix par lyaꞌ xbin men. <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Nde tez nzo xaꞌ ndyolaꞌs gab, ke ndli lazoꞌ xaꞌ na nde natejta xaꞌ xkiꞌs na lo re men jwanꞌ nzo'b xkenꞌ, men jwanꞌ mblaꞌ xkiꞌs Dios ta nzi naya, no na, Xinꞌ Mbiꞌ mbyeꞌd lo izyo reꞌ tolaꞌs na nyen men ya senꞌ yal na kon yalnaro chanꞌ Pay nde kon re áng Nayon.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Noga nchab Jesús:</para>
  <para style="p" vid="MRK 9:1">—Nipa na lo goꞌ, ke nzo pla xaꞌ jwanꞌ nzi ncheꞌ na'gajta xaꞌ axta kebeꞌ wiꞌ xaꞌ yalnyebeꞌ chanꞌ Dios ye'd kon yalnaro.<verse eid="MRK 9:1" /></para>
  <para style="s">Mzyeꞌ nya Jesús</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mt. 17:1-13</ref>; <ref loc="LUK 9:28-36">Lc. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Mbri'dnda'b xop wiz, Jesús ngwa ti yek yiꞌ nde benꞌta mbeꞌ Xaꞌ Pey, Jakob nde Juan, le'ta re xaꞌ ngwa; nde senꞌ lo mzin xaꞌ tya, nzi wiꞌ re yon xaꞌ mzyeꞌ nya Jesús. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Leꞌ xab Jesus thiptane nakistir ngolala anta ndyob xni nyay, ngenta nekthib men lo izyo jwan' ntach lar taja nakis nya.<figure style="fig" alt="Jesús sana un ciego" file="CN01728B.TIF" size="col" ref="9:3">Nakistir ngolal xab Jesús, anta ndyob xni nyay</figure> <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Tya mbroꞌto Elías kon Moisés, ntotodiꞌsno xa' Jesús. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Leꞌ Pey nchab lo Jesús:</para>
  <para style="p" vid="MRK 9:5">—Maestr, wenka nzinꞌ ncheꞌ; sa toxkwaꞌ náꞌ son ramad, thiba chanꞌ la, thiba chanꞌ Moisés nde thiba chanꞌ Elías.<verse eid="MRK 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 9:6" />Na'nyeda Pey jwanꞌ nchab Pey, tak mzyeb toz re yon xaꞌ. <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />Zya mbla ti xkow yek re xaꞌ nde xij xkowa mbyen tib diꞌs jwanꞌ nchab:</para>
  <para style="p" vid="MRK 9:7">—Xaꞌ reꞌ nak xinꞌ na nkeꞌ toz lazoꞌn Xaꞌ. Bin goꞌ xkiꞌs Xaꞌ.<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Nde zyaga, senꞌ lo mbwiꞌ xaꞌ, ngenta cho ndono Jesús benꞌta tib Jesús ndo. <verse eid="MRK 9:8" /><verse number="9" style="v" sid="MRK 9:9" />Senꞌ lo ngo xaꞌ ned, ndela xaꞌ lad yiꞌ, zya mnabeꞌ Jesús lo re yon xaꞌ ke nek thib lo men na'tejta xaꞌ jwanꞌ mbwiꞌ xaꞌ, axta kebeꞌ Xinꞌ Mbiꞌ mbyeꞌd lo izyo ryoxban Xaꞌ xij re men nguj. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Mbin xaꞌ diꞌs, ngenta cho lo men ndej xaꞌy, per benꞌta re yon xaꞌ ndyodiꞌs, xomod nak jwan' ta ryo'xban Xaꞌ xij re men nguj. <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Nde mnabdiꞌs xaꞌ lo Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 9:11">—¿Cho kwan ndliy mbez re maestr ndlo' ley xkiꞌs Dios, ke nakinꞌ nerla Elías ye'd?<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Leꞌ Jesús nchab:</para>
  <para style="p" vid="MRK 9:12">—Liy, nerka Elías ndablo ye'd, sa toni xaꞌ re men, nde xa nchabka lo xkiꞌs Dios leꞌ Xinꞌ Mbiꞌ mbyeꞌd lo izyo nakinꞌ rid Xaꞌ yalti nde kotal men Xaꞌ. <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Per na ni lo goꞌ ke mbyeꞌdla Elías nde mtoti men xaꞌ mod ndalazoꞌ men, jwan' xa nchabka lo xkiꞌs Dios.<verse eid="MRK 9:13" /></para>
  <para style="s">Jesús mtodanꞌ ti mbyo nzo mbi narax lazonꞌ</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mt. 17:14-21</ref>; <ref loc="LUK 9:37-43">Lc. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Senꞌ lo mzin Jesús tenꞌ nzi tipla xinꞌ teꞌd Xaꞌ, men toz nzi lo xaꞌ nde tya nzi pla xaꞌ nak maestr nteꞌd ley xkiꞌs Dios, anta chepa nzi bez xaꞌ kon xinꞌ teꞌd Jesús. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Nde axta nzoyen re men senꞌ mbwiꞌ men mzin Jesús, mke xaꞌ karrel ngwa ni xaꞌ dyux lo Jesús. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Zyasa mnabdiꞌs Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 9:16">—¿Cho kwan liy taja nzi bez goꞌ ncheꞌ?<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Xija mkab tib xaꞌ, nchab:</para>
  <para style="p" vid="MRK 9:17">—Maestr, na ndeno xinꞌ na loa, tak ti mbi narax nzo lazoꞌr nde jwanꞌna mbli nda xkiꞌs or. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Nde one ploja ngeter ndyen mbi narax or, ngobiy or izyo, ndryoꞌ psinꞌ ror, ngaꞌz ler nde mbyez or. Nchab na lo re xinꞌ teꞌd la kote xaꞌ mbi narax nzo lazoꞌr, per na'lid xaꞌ gan.<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Leꞌ Jesús nchab lo xa':</para>
  <para style="p" vid="MRK 9:19">—¡Nak go' men nandlid lazonꞌ Dios! ¿Plopa ndablo keteꞌnon goꞌ? ¿Plopa ndablo xek na goꞌ? Deꞌno goꞌ mbyo ncheꞌ. <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Zyasa ngwano xaꞌ mbyo lo Jesús. Nde senꞌ mbwiꞌ mbi naraxa Jesús, xaja kwana mtotiy mbyo, mdinkey or izyo anta nchub or nde taja nke psinꞌ ror. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Jesús mnabdiꞌs lo xud or:</para>
  <para style="p" vid="MRK 9:21">—¿Pol ndate ta ndyak or?</para>
  <para style="p" vid="MRK 9:21">Leꞌ xud or nchab:</para>
  <para style="p" vid="MRK 9:21">—Xata lud ora. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Nde naꞌr toz gob axta lo ki nde lenꞌ nit ngobi mbi narax or par kuja or. Per tez tlia gan lia ti jwan', blat lazoꞌa náꞌ nde blaꞌsto náꞌ.<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Jesús nchab:</para>
  <para style="p" vid="MRK 9:23">—Tezka tlia gan li lazo'a, tak men jwanꞌ ndli lazonꞌ reta jwanꞌ taka lo xaꞌ.<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Zyaga xud mbyo ya mbrezyaj xa', nchab xaꞌ:</para>
  <para style="p" vid="MRK 9:24">—Li lazoꞌ ney, blaꞌston sa masra' li lazoꞌn.<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Nde senꞌ mbwiꞌ Jesús men toz ndodop tya, zya mbrez Jesús lo mbi narax, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 9:25">—Mbi ngup, mbi nkweꞌ, na nyebeꞌ loa, broꞌte lazoꞌ mbyo reꞌ nde na'beretra lu.<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Zyasa leꞌ mbi naraxa mbliy mbrez yaj or nde xaja kwana mtotiy mbyo tamod mbroꞌtey lazoꞌr; nde mbyanꞌ mbyo xaja men nguja.</para>
  <para style="p" vid="MRK 9:26">Reta men nzi tya, nchab xaꞌ:</para>
  <para style="p" vid="MRK 9:26">—Nguj mbyo. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Per Jesús, mxen Xaꞌ yaꞌ mbyo, mbliche Xaꞌ or, nde mtolir.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Senꞌ ngote Jesús lenꞌ yo, zya re xinꞌ teꞌd Jesús xaꞌta mnabdiꞌs xaꞌ lo Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 9:28">—¿Cho kwan liy sa na'ndlid náꞌ gan ngote náꞌ mbi naraxa? <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Nde nchab Jesús lo xa':</para>
  <para style="p" vid="MRK 9:29">—Tib ned mbi narax reꞌ na'ryo'teday tata, nakinꞌ nerla todiꞌsno men Dios nde li men yalse, sa ryo'tey.<verse eid="MRK 9:29" /></para>
  <para style="s">Jesús bere mdej gaj Xaꞌ</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mt. 17:22-23</ref>; <ref loc="LUK 9:43-45">Lc. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Senꞌ mbroꞌ Jesús tya kon re xinꞌ teꞌd Xaꞌ, ndeni xaꞌ dib lo xyon Galilea; nde na'ncholasta Jesús ke nek tib men nye plo ngete Xaꞌ. <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />Tak leꞌ Xaꞌ ndlo' lo re xinꞌ teꞌd Xaꞌ, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 9:31">—Leꞌ Xinꞌ Mbiꞌ mbyeꞌd lo izyo, tayaꞌ men Xaꞌ lo yaꞌ re men nde kuj men Xaꞌ. Per senꞌ lo ngujla Xaꞌ, ngoxo'b mbyon wiz ryo'xban Xaꞌ tedi gob. <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Per naꞌngyenta xaꞌ jwanꞌ nchab Jesús nde mzyeb xaꞌ na'bdiꞌs xaꞌ lo Jesus.<verse eid="MRK 9:32" /></para>
  <para style="s">¿Cho nak mas xaꞌ ro?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mt. 18:1-5</ref>; <ref loc="LUK 9:46-48">Lc. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Nde senꞌ mzin xaꞌ yez Capernaum; tya ndob ti yo mbled xaꞌ, zyasa mnabdiꞌs Jesús lo re xinꞌ teꞌd Xaꞌ, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 9:33">—¿Cho kwan taja ndetodiꞌs goꞌ neda?<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Nek tib xaꞌ na'nkabta, tak ned ndebez xaꞌ lo ta xaꞌ xanya xa' ak mas xaꞌ ro.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Zyasa mdob Jesús nde mbrez Xaꞌ re tib sen xinꞌ teꞌd Xaꞌ, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 9:35">—Tez nzo goꞌ ncholaꞌs ak xaꞌ ner, xa' ya nakinꞌ tyo xis nde li xaꞌ sinꞌ lo reta go'.<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Zya mxen Jesús tib or lud, mto Xaꞌ or xij re xaꞌ nde mdob Xaꞌ or lo yaꞌ Xaꞌ, nchab Xaꞌ:<verse eid="MRK 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 9:37" />—Men jwanꞌ kayaꞌ ti or lud reꞌ por kwent chanꞌ na, xaꞌ ya mkayaꞌ na; nde xaꞌ jwanꞌ kayaꞌ na, namkayaꞌd xaꞌ na leꞌ xaꞌ mkayaꞌ Xaꞌ jwanꞌ mtelꞌ na.<verse eid="MRK 9:37" /></para>
  <para style="s">Xaꞌ na'nixinta xis Jesús, kon Jesús ndo xaꞌ</para>
  <para style="r">(<ref loc="LUK 9:49-50">Lc. 9:49-50</ref>; <ref loc="MAT 10:42">Mt. 10:42</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Leꞌ Juan nchab:</para>
  <para style="p" vid="MRK 9:38">—Maestr, mbwiꞌ náꞌ tib xaꞌ, kon lea ndej xaꞌ sa ngote xaꞌ re mbi narax nzo lazoꞌ men nde nakte xaꞌ ta ngete kon naꞌ, jwanꞌ nasa mka náꞌ diꞌs li xaꞌy tak na'nzod xaꞌ xij naꞌ.<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Per Jesús nchab:</para>
  <para style="p" vid="MRK 9:39">—Na'kad goꞌ diꞌs li xaꞌy; tak ngenta nek thib men kon len ndli xaꞌ yalnaro nde nixin xaꞌ xis na. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Tak xaꞌ jwanꞌ na'nixinta xis naꞌ, kon naꞌ ndo xaꞌ. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Nde choja men jwanꞌ taꞌlas tib xi nit gu goꞌ por kwent chanꞌ na, tak ndli lazoꞌ goꞌ Crist, Xaꞌ mtelꞌ Dios,<note caller="+" style="f"><char style="fr" closed="false">9:41 </char><char style="ft" closed="false">Miska Jesús nak Crist, Xaꞌ mtelꞌ Dios.</char></note> nipa na lo goꞌ ke ngenola Dios jwanꞌ taꞌlas Xaꞌ lo men ya.<verse eid="MRK 9:41" /></para>
  <para style="s">Jwanꞌ ndli gab men lo yalke</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mt. 18:6-9</ref>; <ref loc="LUK 17:1-2">Lc. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />’Nde choja xaꞌ jwanꞌ li sa cheb ti or lud re' lo yalke, or ta ndli lazonꞌ na reꞌ, mas wen nda xaꞌ tez tyobdoꞌ ti ke ro yen xaꞌ nde kobi men xaꞌ lenꞌ nittoꞌ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Tez yaꞌa li sa gab la lo yalke, bchoꞌy. Mas wen ndaa kon thipta yaꞌa, kayaꞌa yalnaban adiꞌ, ke ndob rop yaꞌa nde yaa lo pen tenꞌ nzo bel naꞌakta yuꞌ, <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />tya nzo re mbyeꞌd nandluxta nde bel nanchu'da. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Nde tez nia li sa gab la lo yalke, bchoꞌy. Mas wen ndaa kon thipta nia, kayaꞌa yalnaban adiꞌ, ke ndob rop nia nde yaa lo pen tenꞌ nzo bel naꞌakta yuꞌ, <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />tya nzo re mbye'd na'ndluxta nde bel nanchu'da. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Nde tez ngud loa li sa gab la lo yalke, bloꞌtey. Mas wen ndaa kon thipta ngud loa, kayaꞌa yalnaban adiꞌ, ke ndob rop ngud loa nde yaa lo pen tenꞌ ndo bel naꞌakta yuꞌ, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />tya nzo re mbye'd na'ndluxta nde bel nanchu'da.<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />’Tak reta men ak nasig kon bel nde reta jwanꞌ yon yo teda sa ak nasiga.<note caller="+" style="f"><char style="fr" closed="false">9:49 </char><char style="ft" closed="false">Cheꞌga toyal koxkan men versículo reꞌ: Re belꞌ ta ncha mena, ndablo yo teda nde key lo xlye tamod sa xeka nde jwanꞌ na nak yalti ndablo rid re men jwanꞌ ndli lazoꞌn Dios, tak tamod ndlino xaꞌ re maꞌ yon ndayaꞌ xaꞌ lo Dios pola. (Levítico 2:13)</char></note> <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />Wen nak ted, per tez leꞌ ted nanasigtay,<note caller="+" style="f"><char style="fr" closed="false">9:50 </char><char style="ft" closed="false">Pola ndaloꞌ xaꞌ tib ned ted ke lenꞌ nittoꞌ jwanꞌ mbli sinꞌ xaꞌ, ted ya senꞌ lo nchey ya nanasigtay ngenta cho sinꞌ liy lo xaꞌ.</char></note> ¿xomod li goꞌ ak nasiga tedi gob? Jwanꞌ nasa ndablo ak goꞌ xaja ted nasiga, nabeꞌz bre goꞌ kon kad tiba goꞌ.<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Jesús ndlo' yalke naka laꞌ men salꞌ men</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mt. 19:1-12</ref>; <ref loc="LUK 16:18">Lc. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Mbroꞌ Jesús yez Capernaum, nda Xaꞌ lo xyon Judea nde mzin Xaꞌ tedib lad ro yoꞌ Jordán, nde taxa mdyop re men lo Xaꞌ tya, nde bere mtote'd Xa' reta men mod jwanꞌ ndliga Xaꞌ. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />Zyasa mbike pla xaꞌ fariseo mnabdiꞌs xaꞌ lo Jesús benꞌ sa kwanꞌ xaꞌ mod keꞌ xaꞌ yalke yek Jesús, sa nchab xaꞌ:</para>
  <para style="p" vid="MRK 10:2">—¿Cho galꞌ naka laꞌ xaꞌ biꞌ ngol xaꞌ?<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Le' Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 10:3">—¿Xomodka nchab ley jwanꞌ mnabe' Moisés?<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Leꞌ xaꞌ nchab:</para>
  <para style="p" vid="MRK 10:4">— Moisés nta' di's toyal laꞌ men salꞌ men, benꞌ tyoxkwaꞌ yeꞌs jwanꞌ nyebeꞌ ke laꞌ xaꞌ biꞌ salꞌ xaꞌ.<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Leꞌ Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 10:5">—Por yalneyek chanꞌ goꞌ jwanꞌ nasa mkeꞌ Moisés yalnyebeꞌ ya. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Tak sen' mdobte ner mtoxkwaꞌ Dios reta jwanꞌ, mbi' nde ngol mtoxkwaꞌ Dios.<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Gen. 1:27</char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />“Jwanꞌ nasa la' men biꞌ xud xaꞌ nde xnaꞌ xaꞌ nde tyobno xaꞌ ngol xaꞌ, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />nde rop xaꞌ, thipta bel' ak xaꞌ.”<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Gen. 2:24</char></note> Jwanꞌ nasa na'nakta xaꞌ chop, che'la thipta nak xa'. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Jwan' nasa, xa' jwanꞌ mtenta Dios, ngenta cho men li sa laꞌ xaꞌ salꞌ xaꞌ.<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Senꞌ mzin re xaꞌ yo re xinꞌ teꞌd Jesus bere mnabdiꞌs xa' jwanꞌna. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Nde nchab Jesús lo xa':</para>
  <para style="p" vid="MRK 10:11">—Choja men jwan' laꞌ ngol na' nde ka xaꞌ tedib ngol, nak xa' men ndli jwan' xkap kon ngol xaꞌ jwan' nak ner. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Nde noga ngol, tez laꞌ xaꞌ salꞌ xaꞌ nde ka ngol tedib mbiꞌ, nak xa' ngol ndli jwan' xkap kon xa' bi' jwan' nak sal' ner xa'.<verse eid="MRK 10:12" /></para>
  <para style="s">Jesús ndli leyꞌ re or bix</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mt. 19:13-15</ref>; <ref loc="LUK 18:15-17">Lc. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Nde ndano xa' re or bix lo Jesús sa xo'b ya' Xaꞌ yek or;<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">Sa li leyꞌ Jesús re or bix.</char></note> leꞌ re xaꞌ nak xinꞌ teꞌd Jesús mbrez xaꞌ yek re men ta ndeno or bixa. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Senꞌ lo mbwiꞌ Jesús ta nzi li xaꞌ, ngok nayiꞌ Jesús nde nchab Xaꞌ:</para>
  <para style="p" vid="MRK 10:14">—Btaꞌ goꞌ diꞌs ye'd re or bixa lon nde nakad goꞌ diꞌs; tak Dios nyebeꞌ lazoꞌ men jwanꞌ nak xaja or bix reꞌ.<figure style="fig" alt="Jesús con los niños" file="cn01772B.tif" size="col" ref="10:14">Dios nyebeꞌ lazoꞌ men jwanꞌ nak xaja or bix reꞌ</figure> <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Nipa na lo goꞌ, men jwanꞌ nakayaꞌda yalnyebeꞌ chanꞌ Dios, xaja ti or bix reꞌ, men ya naꞌlyada lo yalnyebeꞌ chanꞌ Dios.<verse eid="MRK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 10:16" />Nde mdob Jesús or lo ya' Xa', mxob Xa' yaꞌ Xaꞌ yek or nde mbli leyꞌ Xaꞌ or.<verse eid="MRK 10:16" /></para>
  <para style="s">Ti mbiꞌ rik</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mt. 19:16-30</ref>; <ref loc="LUK 18:18-30">Lc. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Laj ndoroꞌ Jesús sa nda xaꞌ, zya naban toz mzin ti mbiꞌ lo Jesús mdoxub xaꞌ nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 10:17">—Maestr mnen ke galꞌ nak la, na nyabdiꞌs loa. ¿Cho kwan lin sa lin gan yalnaban adiꞌ?<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Leꞌ Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 10:18">—¿Cho kwan liy mbez la galꞌ nak na? Ngenta nek tib men galꞌ, benꞌta Dios nak Xaꞌ galꞌ. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Re jwanꞌ nyebeꞌ Dios mnea luy:</para>
  <para style="q" vid="MRK 10:19">Naꞌketenod la tedib men na'nakta salꞌ la.</para>
  <para style="q" vid="MRK 10:19">Na'kujta lu men.</para>
  <para style="q" vid="MRK 10:19">Na'lid la yalwanꞌ.</para>
  <para style="q" vid="MRK 10:19">Na'ked la yalke yek men jwanꞌ na'nakta xaꞌ.</para>
  <para style="q" vid="MRK 10:19">Na'kwinꞌta lu.</para>
  <para style="q" vid="MRK 10:19">Bxob yek xud la nde xnaꞌa.<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Leꞌ xaꞌ nchab:</para>
  <para style="p" vid="MRK 10:20">—Maestr, reta jwanꞌ re' axta lud nandolila nay.<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Zya mbwiꞌ Jesús lo xaꞌ nde mblat lazoꞌ Jesús xaꞌ, nchab Jesús:</para>
  <para style="p" vid="MRK 10:21">—Tipta jwanꞌ tera lia, bya, ptho reta jwanꞌ ngenoa nde ptaꞌ tmi lo re xaꞌ jwanꞌ ngenta chanꞌ naꞌ, tamod kenoa bro toz jwanꞌ lo beꞌ zyasa deꞌ, sa wea kruz la nde tyonkea xis na.<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft" closed="false">We men kruz nak: Xek men lo reta yalti jwanꞌ nde senꞌ lo ndli lazoꞌ men Dios.</char></note><verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Zya mbli toz mbi' ya xgab senꞌ lo mbin xaꞌ diꞌs ya nde nabil ndya xaꞌ, tak bro toz jwanꞌ ngeno xaꞌ. <verse eid="MRK 10:22" /><verse number="23" style="v" sid="MRK 10:23" />Zyasa mbwiꞌ Jesús lo re xinꞌ teꞌd Xaꞌ nde nchab Xaꞌ:</para>
  <para style="p" vid="MRK 10:23">—Plopa ne naka lo re xaꞌ ngeno bro toz jwanꞌ, sa yote xaꞌ lo yalnyebeꞌ chanꞌ Dios.<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Nzoyen toz re xaꞌ nak xinꞌ teꞌd Jesús senꞌ mbin xaꞌ re diꞌs reꞌ; leꞌ Jesús bere nchab:</para>
  <para style="p" vid="MRK 10:24">—Xinꞌ na, plopa ne naka yote xaꞌ lo yalnyebeꞌ chanꞌ Dios, re xaꞌ ndob xgab naꞌ lo re jwanꞌ ngeno xaꞌ. <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Mas naleꞌ rid ndab ti kamey xan' ye'r yagux, ke rid ti xaꞌ rik lya xaꞌ lo yalnyebeꞌ chanꞌ Dios.<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Zya masraꞌ nzoyen re xaꞌ nde nchab xaꞌ lo ta xaꞌ:</para>
  <para style="p" vid="MRK 10:26">—¿Choꞌ men li gan lyaꞌ sa?<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Jesús mbwiꞌ lo xaꞌ nde nchab Jesús:</para>
  <para style="p" vid="MRK 10:27">—Lo re men nagana, leꞌ lo Dios nakte nagan, reta jwanꞌ tak li Dios.<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Leꞌ Pey mdobte nchab lo Jesús:</para>
  <para style="p" vid="MRK 10:28">—Náꞌ reꞌ, reta jwanꞌ mblaꞌ náꞌ nde mdonke náꞌ xis la.<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Jesús mkab nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 10:29">—Nipa na lo goꞌ, tez nzo men mblaꞌ liz naꞌ, wes naꞌ, ptanꞌ naꞌ, xud naꞌ, xnanꞌ, ngol naꞌ, xinꞌ naꞌ, izyon naꞌ tak ndyonke xaꞌ xis na nde ndataꞌ xaꞌ xkiꞌs Dios, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />men ya laj naban xaꞌ kayaꞌ xaꞌy tib ayoꞌ gob masraꞌ. Kayaꞌ xaꞌ liz xaꞌ, wes xaꞌ, ptanꞌ xaꞌ, xnaꞌ xaꞌ, xinꞌ xaꞌ nde izyon xaꞌ nde noga toti men xaꞌ lo izyo reꞌ. Per sin tib wiz kayaꞌ xaꞌ yalnaban adiꞌ lo beꞌ. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Tak bro toz re men ta ndo ner naya yan' xa' xis, nde bro toz re xa' ndo xis ak xa' xa' ner.<verse eid="MRK 10:31" /></para>
  <para style="s">Mbyon gob Jesús mdej gaj Xaꞌ</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mt. 20:17-19</ref>; <ref loc="LUK 18:31-34">Lc. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Zyasa ngo xaꞌ ned nda xaꞌ yez Jerusalén. Jesús nda siblo, leꞌ re xinꞌ teꞌd Xaꞌ ndanke xis anta ngan xgab xaꞌ nde masraꞌ re men anta ndake seb xaꞌ xis Jesús. Zyasa xaꞌta mbrez Jesús re xinꞌ teꞌd Xaꞌ nde ndobte mdej Xa' re jwanꞌ yote Xaꞌ, nachab Xa':<verse eid="MRK 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 10:33" />—Bwiꞌ goꞌ naya ndanꞌ yez Jerusalén, leꞌ Xinꞌ Mbiꞌ mbyeꞌd lo izyo reꞌ, tayaꞌ men Xaꞌ lo re ngwleyꞌ ro nde lo re xaꞌ nak maestr ndlo' ley xkiꞌs Dios, nde tya nyebeꞌ men gaj Xaꞌ nde tayaꞌ men Xaꞌ lo re men nanakta Israel, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />nde xino men Xaꞌ, kin men Xaꞌ, suk men lo Xaꞌ nde kuj men Xaꞌ; per yoxob mbyon wiz ryoxban Xaꞌ.<verse eid="MRK 10:34" /></para>
  <para style="s">Jakob nde Juan mna'b xaꞌ ti jwanꞌ lo Jesús</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mt. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Zyasa Jakob nde Juan, xinꞌ Zebedeo, mbike xaꞌ lo Jesús nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 10:35">—Maestr, ncholaꞌs náꞌ ke lia ti jwanꞌ nya'b náꞌ loa.<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Leꞌ Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 10:36">—¿Cho kwan ncholaꞌs goꞌ lin?<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Leꞌ rop xaꞌ nchab:</para>
  <para style="p" vid="MRK 10:37">—Náꞌ ncholaꞌs senꞌ tyob la nyebeꞌa, taꞌa diꞌs tib náꞌ tyob lad ban la nde tedib náꞌ tyob lad beg la.<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Jesús nchab lo xa':</para>
  <para style="p" vid="MRK 10:38">—Na'nyed goꞌ jwanꞌ nyab goꞌ. ¿Cho tli goꞌ gan rid goꞌ re yalti, jwanꞌ rid na nde gaj goꞌ mod jwanꞌ gaj na?<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false">¿Cho tuꞌ goꞌ tib kop nit nala ta gun reꞌ nde ryole goꞌ mod jwanꞌ ryoꞌlen? (Diꞌs reꞌ nak xata ngey diꞌs xtil.)</char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Leꞌ rop xaꞌ mkab nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 10:39">—Tli náꞌ gan.</para>
  <para style="p" vid="MRK 10:39">Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 10:39">—Lin goꞌy, reta yalti rid na jwanꞌna rid goꞌ nde taj goꞌ, mod jwanꞌ gaj na. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Leꞌ jwanꞌ ta nya'b goꞌ, tib goꞌ tyob lad ban na nde tedib goꞌ tyob lad beg na, nakta jwanꞌna kwent chanꞌ na, benꞌta Dios nyebeꞌ jwanꞌna.<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Senꞌ mbin ti siꞌ xinꞌ teꞌd Xaꞌ jwanꞌ reꞌ, zya mdobte ngok nayiꞌ xaꞌ lo Juan nde lo Jakob. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Zyasa mbrez Jesús re xaꞌ nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 10:42">—Mnela goꞌ xamod nak re xaꞌ ta nchak sinꞌ ro, benꞌta ndob nyebeꞌ xaꞌ nde nchak naro xaꞌ lo tedib ned men. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Leꞌ xij goꞌ reꞌ na'nakte tamod; cheꞌla, tez nzo goꞌ ncholaꞌs ak xaꞌ ro, xaꞌ ya nerla nakinꞌ li sinꞌ lo re goꞌ. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Nde tez nzo goꞌ ncholaꞌs nyebeꞌ, xaꞌ ya ndablo li sinꞌ lo re men. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Tak na Xinꞌ Mbiꞌ mbyeꞌd lo izyo reꞌ, na'ndalta na sa li men sinꞌ lon, na ndal sa lin sinꞌ lo men nde tob na yalnaban chanꞌ na, sa lyaꞌ re men lo xken men.<verse eid="MRK 10:45" /></para>
  <para style="s">Jesús mxalꞌ ngud lo Bartimeo</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mt. 20:29-34</ref>; <ref loc="LUK 18:35-43">Lc. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Zyasa mzin Jesús yez Jericó kon re xinꞌ teꞌd Xaꞌ. Nde senꞌ lo mbroꞌ xaꞌ yez ya kon reta men jwanꞌ ndanke xis xaꞌ, ned ndob ti xaꞌ ngwle<note caller="+" style="f"><char style="fr" closed="false">10:46 </char><char style="ft" closed="false">Ngwle nak ti men cieg.</char></note> nya'b gon ndole Bartimeo, xinꞌ Timeo. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Senꞌ mbin xaꞌ leꞌ Jesús, Xaꞌ yez Nazaret ndarid tya, zyaga ne mbrez xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 10:47">—Jesús nde lo bin David, blat lazoꞌa na.<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Nde nar men ngok nayiꞌ lo xaꞌ sa nakwesta xaꞌ, per zya mas ne mbrez xaꞌ:</para>
  <para style="p" vid="MRK 10:48">—¡Jesús nde lo bin David, blat lazoꞌa na!<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Zya ngoto Jesús nde nchab Xaꞌ lo men:</para>
  <para style="p" vid="MRK 10:49">—Brez goꞌ xaꞌ.</para>
  <para style="p" vid="MRK 10:49">Nde mbrez xaꞌ men nayiza, nchab xaꞌ:</para>
  <para style="p" vid="MRK 10:49">—¡Blo nale lazoꞌa, ptoli, tak ngebez Xaꞌ lu!<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Leꞌ men ngwle ya zyaga gotoli xaꞌ, mblobi xaꞌ lar nzob xis xaꞌ nde nda xaꞌ lo Jesús. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />Jesús mnabdiꞌs lo xaꞌ:</para>
  <para style="p" vid="MRK 10:51">—¿Cho kwan ncholaꞌs la lin loa?</para>
  <para style="p" vid="MRK 10:51">Leꞌ men ngwle ya nchab:</para>
  <para style="p" vid="MRK 10:51">—Maestr, na ncholas xyalꞌ ngud lon sa wiꞌn.<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 10:52">—Bya, mbyak la lu, tak ndlipa lazoꞌa Dios.</para>
  <para style="p" vid="MRK 10:52">Zyaga mxyalꞌ ngud lo xaꞌ nde mdonke xaꞌ xis Jesús.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Jesús ndosin yez Jerusalén</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mt. 21:1-11</ref>; <ref loc="LUK 19:28-40">Lc. 19:28-40</ref>; <ref loc="JHN 12:12-19">Jn. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Senꞌ ndosin gaxla re xaꞌ yez Jerusalén, gax lo yez Betfage nde Betania, ngo' lo yi' Olib, Jesús mbloned chop xinꞌ teꞌd Xaꞌ, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 11:2">—Wa goꞌ yez lud ta nax ngo' lonꞌ reꞌ, senꞌ sin goꞌ tya, yosi'b goꞌ ti burr yenꞌ nkedoꞌ, ti burr jwanꞌ terka tyob xaꞌ xis naꞌ. Xak goꞌ maꞌ nde ye'dno goꞌ maꞌ. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Nde tez nzo xaꞌ nye lo goꞌ: “¿Cho kwan liy ta nya jwan' ndli go'?” Le' goꞌ gab lo xaꞌ: “Xaꞌ Nyebeꞌ nakinꞌ maꞌ, nde napa ye'dno Xaꞌ maꞌ.”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Zyasa ngwa rop xaꞌ nde mzyal xaꞌ ti burr yenꞌ nkedoꞌ ro ned gax ti ro yo nde mxak xaꞌ maꞌ.<verse eid="MRK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 11:5" />Nde pla xaꞌ jwanꞌ nzi tya, nchab xaꞌ:</para>
  <para style="p" vid="MRK 11:5">—¿Cho kwan liy ngexak goꞌ burr?<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Zya nchab xaꞌ jwan' xa mnabe' Jesús lo xaꞌ, nde mdaꞌ xaꞌ diꞌs mbeꞌ xaꞌ burr. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Nde mzin no xaꞌ burr lo Jesús, mxo'b xaꞌ xab xaꞌ xis maꞌ nde mdob Jesús xis ma'. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Bro toz men mxen xaꞌ lar jwanꞌ nzo'b xis xaꞌ, mtogaꞌ xaꞌy ned, tipla xaꞌ taja mchoꞌ re xod la wan nde mblek xaꞌy ned.<figure style="fig" alt="Jesús entra Jerusalén" file="CN01782B.TIF" size="col" ref="11:8">Ndyen toz re men ndosin Jesús yez Jerusalén</figure> <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Nde reta men jwanꞌ nda siblo nde reta men jwanꞌ ndanke xis, nyaga ne mbez xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 11:9">—¡Naro Dios, Nayon nak Xaꞌ ta nde lo le Xa' Nyebe'! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />¡Nayon nak yalnyebe' ta nde lo bin xud na' David, ¡Naro toz nak Dios lo beꞌ!<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Nde ngote Jesús lenꞌ yez Jerusalén, nde tenꞌ ndob yodoꞌ, mbwiꞌ Xaꞌ reta jwan' nzi tya, yaja ndekowla izyo, nda Xaꞌ yez Betania kon re tib sen xinꞌ teꞌd Xaꞌ.<verse eid="MRK 11:11" /></para>
  <para style="s">Jesús ngosib ya hig ngenta ngud</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mt. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Mduxni izyo tedib wiz, senꞌ lo mbroꞌ xaꞌ yez Betania, laj ndo xaꞌ ned msi'b ndyanꞌ xaꞌ. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Nde mbwiꞌ xaꞌ tij ndob tib ya hig ndo la lonꞌ, zyasa ngwa twiꞌ xaꞌ lo ya nyenꞌ cho tozal xaꞌ ti ngud wa xaꞌ. Nde senꞌ lo mzin xaꞌ tenꞌ ndob ya, nek tib ngud ngenta benꞌta la ndo lo ya, tak nakte tiemp jwanꞌ ndaꞌy ngud. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Zyasa nchab Jesús lo ya hig:</para>
  <para style="p" vid="MRK 11:14">—Nek tib ngud ya natyotra loa wa men.</para>
  <para style="p" vid="MRK 11:14">Nde mbin re xinꞌ teꞌd Xaꞌ diꞌs jwanꞌ nchab Xaꞌ lo ya.<verse eid="MRK 11:14" /></para>
  <para style="s">Jesús mtoxonꞌ re men jwanꞌ nzi tho cho yodoꞌ</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mt. 21:12-17</ref>; <ref loc="LUK 19:45-48">Lc. 19:45-48</ref>; <ref loc="JHN 2:13-22">Jn. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Senꞌ lo mzin xaꞌ yez Jerusalén, Jesús ngote tenꞌ ndob yodoꞌ, tolo mblote Xaꞌ re men, re xaꞌ jwanꞌ nzi tho nde re xaꞌ jwanꞌ nzi tiꞌ. Mxen Jesús re mes xaꞌ jwanꞌ nzi nsilꞌ tmi, mtub Xaꞌy, taga mtub Xaꞌ re yasil xaꞌ nzi tho palom. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Nde naꞌndad Jesús diꞌs rid re men ndeno re jwanꞌ tenꞌ nak lo le chanꞌ yodoꞌ. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Nde mtoteꞌd Jesús re men, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 11:17">—Lo xkiꞌs Dios ngeniy nchaba: “Liz na ryole yo todiꞌsno men Dios ten' ndyop reta men.”<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">Isaías 56:7</char></note> ¡Nde goꞌ mblilal ncheꞌ xaja ti yo tenꞌ ndyop re xaꞌ wanꞌ!<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">Jeremías 7:11</char></note><figure style="fig" alt="Jesús purifica el templo" file="CN01787B.TIF" size="col" ref="11:17">Goꞌ mblilal ncheꞌ xaja tib yo tenꞌ ndyop re xaꞌ wanꞌ</figure><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Nde re xaꞌ nak maestr ndlo' ley xkiꞌs Dios nde re ngwleyꞌ xa' nyebe' mbin xaꞌ re jwanꞌ nchab Jesús, zyasa tolo mkwanꞌ xaꞌ mod kuj xaꞌ Jesús, tak nzyeb xaꞌ, men toz nzoyen re jwanꞌ ndloꞌ Jesús. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Senꞌ ndela yalꞌ, zya mbroꞌ re xinꞌ teꞌd Xaꞌ yez Jerusalén.<verse eid="MRK 11:19" /></para>
  <para style="s">Mbiz ya hig</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mt. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Mduxni tedib wiz, tilꞌ toz mbrid re xaꞌ tenꞌ ndob ya hig nde mbwiꞌ xaꞌ axta dib lox ya mbiz. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Zyasa mtelaꞌs Pey nde nchab Pey lo Jesús:</para>
  <para style="p" vid="MRK 11:21">—Maestr, bwiꞌ, leꞌ ya hig ta mkeꞌdea ya, mbiza.<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Leꞌ Jesús nchab:</para>
  <para style="p" vid="MRK 11:22">—Blipa lazoꞌ goꞌ Dios. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Tak nipa na lo goꞌ tez nzo xaꞌ naꞌakropta xgab naꞌ, nde li lazoꞌ xaꞌy tak jwanꞌ gab xaꞌ, toyal gab xaꞌ lo kox reꞌ: “Byib ncheꞌ nde wa yo lenꞌ nittoꞌ”, nde taka. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Jwanꞌ nasa nin lo goꞌ, reta jwanꞌ ta nya'b goꞌ lo Dios, bli lazoꞌ goꞌ ke taꞌ Xaꞌy nde ta aka. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Nde senꞌ lo ndyodiꞌsno goꞌ Dios, tez nzo kwan narax ndateno goꞌ ta men goꞌ, ndablo tiptane bri'd goꞌy yek goꞌ, tamod sa Xud naꞌ ndob lo beꞌ tonꞌ Xaꞌ re xken goꞌ. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Tak tez narita goꞌy tiptane yek goꞌ re jwanꞌ narax ndli men lo goꞌ, no Xud naꞌ ndob lo beꞌ, natonꞌta Xaꞌ re xken goꞌ.<verse eid="MRK 11:26" /></para>
  <para style="s">¿Kon cho yalnyebeꞌ ndli Jesús re jwanꞌ?</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mt. 21:23-27</ref>; <ref loc="LUK 20:1-8">Lc. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Zyasa bere nda xaꞌ yez Jerusalén tedib gob. Nde laj ngete Jesús tenꞌ ndob yodoꞌ, tya mbyeꞌd re ngwleyꞌ xa' nyebe', re xaꞌ nak maestr ndlo' ley xkiꞌs Dios nde re xaꞌ nak sinꞌ lo men Israel. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Nde nchab xaꞌ lo Jesús:</para>
  <para style="p" vid="MRK 11:28">—¿Kon cho yalnyebeꞌ ndlia re jwanꞌ reꞌ nde cho mdaꞌ diꞌs sa ndlia le?<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Leꞌ Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 11:29">—Tej na lo goꞌ kon cho yalnyebeꞌ ndlin re jwanꞌ reꞌ, tez kab goꞌ ti jwanꞌ nyabdiꞌs na lo goꞌ. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />¿Lo mblole Juan men? ¿Cho naka jwan' nde lo be' o naka chan' men? Pkab goꞌ lon.<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Zyasa mdodiꞌsno xaꞌ ta xaꞌ nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 11:31">—Tez gab naꞌ: Lo be' mbro'y, nye xaꞌ lonꞌ: “¿Cho kwan liy nandlid lazoꞌ goꞌ xkiꞌs xaꞌ sa?” <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Nde tez gab naꞌ: Chan' mena</para>
  <para style="p" vid="MRK 11:32">Per mzyeb xaꞌ ta gab xaꞌ, tak reta men ndli lazonꞌ ke Juan liga ngok tib xaꞌ mbyeꞌd mdaꞌ xkiꞌs Dios.<note caller="+" style="f"><char style="fr" closed="false">11:32 </char><char style="ft" closed="false">Profet nak ti xaꞌ mbyeꞌd taꞌ xkiꞌs Dios pola.</char></note> <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Zyasa nchab xaꞌ lo Jesús:</para>
  <para style="p" vid="MRK 11:33">—Nanyet náꞌy.</para>
  <para style="p" vid="MRK 11:33">Leꞌ Jesús mkab lo xaꞌ:</para>
  <para style="p" vid="MRK 11:33">—Noga na natejta na lo goꞌ kon cho yalnyebeꞌ ndlin re jwanꞌ reꞌ.<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Kwent nabix chanꞌ pla xaꞌ narax mke sinꞌ</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mt. 21:33-46</ref>; <ref loc="LUK 20:9-19">Lc. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Zyasa mdobte Jesús mdej Xaꞌ re di's nabix, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 12:1">—Ngo ti mbiꞌ mblo bin lus ub nde mtowꞌ xaꞌ dib tenꞌ nzo bina kon ke, mtoxkwaꞌ xaꞌ ti plo tenꞌ koꞌ xaꞌ nit ub nde mtoxkwaꞌ xaꞌ ti yo ke gap toz nda'b, ’nde mtanꞌno xaꞌy lo pla men sa li men sinꞌna nde leꞌ xaꞌ ngo ned ndya tij. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Senꞌ ngoxo'b beꞌ mtelꞌ xaꞌ ti mos lo re xa' nge sin', sa kaya' mos ngud mke lo lus ub. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Leꞌ re xaꞌ ta nzo lo sin', mxen xaꞌ mos, mkeꞌ xaꞌy nde mbloned xaꞌ mos ngen kwan mtelꞌ xaꞌ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Zya bere mtel' xaꞌ tedib mos, per mbwadke xaꞌ mos axta mbwiꞌy yek mos, nde noga mblo's xa' mos ndya mos. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Bere mtelꞌ xaꞌ tedib mos nde mos reꞌ mbij xaꞌ; taga mblino xaꞌ tipla mos jwanꞌ mtelꞌ xaꞌ nak xwanꞌ lus ub, cho mos mke xaꞌy nde cho mos mbij xaꞌ.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />’ Lulka ngeno xaꞌ tibnya xinꞌ xaꞌ jwanꞌ nke toz lazoꞌ xaꞌ, mtel' xa' or lo re xa' ya, nchab xaꞌ: “Te' xo'b yek xaꞌ xin' na re'.” <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Leꞌ re xaꞌ ta mbyanꞌ no lus ub ba, nchab xaꞌ lo ta xaꞌ: “Or re' yan'no dib jwan' re'. Yeꞌd goꞌ, kuj naꞌ or sa naꞌ kayaꞌ dib jwan' re', aka chanꞌ naꞌ.” <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Nde mxen xaꞌ or, mbij xaꞌ or nde mblobi xaꞌ or tij tenꞌ nzo'b lus ub.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />¿Cho kwan li xaꞌ ta nak xwanꞌ lus ub? Ye'd xaꞌ nde lu'x xaꞌ reta men ta mbyanꞌno lus ub nde tayaꞌ xaꞌy lo tedib ned men.<verse eid="MRK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 12:10" />’¿Cho nandlapta goꞌ jwanꞌ nchab lo xkiꞌs Dios?</para>
  <para style="q" vid="MRK 12:10">Leꞌ ke jwanꞌ mblo'tal xaꞌ ntaꞌ yo,</para>
  <para style="q" vid="MRK 12:10">ke ya ngok tib ke jwanꞌ ndenkeꞌ dib yo.<verse eid="MRK 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MRK 12:11" />Dios ta mtoxkwaꞌy;</para>
  <para style="q" vid="MRK 12:11">nde naya naka tib jwanꞌ nzoyen na'.<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">Salmos 118:22-23.</char></note><verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Zya mchal xa' nten xaꞌ Jesús, tak mne xaꞌ xis xaꞌ ndej Jesus kwent nabix. Per mzyeb xaꞌ reta men yaja mbla' xa' Jesus nde nda xaꞌ.<verse eid="MRK 12:12" /></para>
  <para style="s">Mnabdiꞌs xaꞌ lo Jesús cho tyix xaꞌ lo Cesar</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mt. 22:15-22</ref>; <ref loc="LUK 20:20-26">Lc. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Zyasa mtelꞌ xaꞌ pla xaꞌ fariseo nde pla men Herodes, sa yana'bdiꞌs xaꞌ lo Jesús, benꞌ sa kwanꞌ xaꞌ mod keꞌ xaꞌ yalke yek Jesús. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Senꞌ mzin xaꞌ nchab xaꞌ:</para>
  <para style="p" vid="MRK 12:14">—Maestr, mne náꞌ li re jwanꞌ ndyodiꞌs la nde nandyod la re jwanꞌ ndyodiꞌs men xis la, neka ndlia xgab cho xaꞌy, tak lu benꞌta ndloꞌa jwanꞌ li, nyenꞌ xa xo'b yek men Dios. Jwanꞌ nasa nyabdiꞌs náꞌ loa: “¿Cho ndablo kix naꞌ tmi chanꞌ izyo lo Cesar<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">Cesar nak tib mbol ro jwanꞌ nyebeꞌ dib yez Rom noga nyebeꞌ xaꞌ re yez jwanꞌ mbli xaꞌ gan pola nde axta lo re men Israel nyebeꞌ xaꞌ.</char></note> o nakixta naꞌy? ¿Taꞌ naꞌy, o nata'd naꞌy?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Leꞌ Jesús mnela xgab narax jwanꞌ ndono re men ya nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 12:15">—¿Cho kwan liy nkwanꞌ goꞌ yalke keꞌ goꞌ yek na? Deꞌno goꞌ ti tmi Rom, wiꞌn.<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Zya ngwano xaꞌy, leꞌ Jesús nchab:</para>
  <para style="p" vid="MRK 12:16">—¿Cho lo xa' nde cho le nke lo tmi reꞌ?</para>
  <para style="p" vid="MRK 12:16">Leꞌ re xaꞌ mkab, nchab xaꞌ:</para>
  <para style="p" vid="MRK 12:16">—Chan' Cesar.<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Leꞌ Jesús nchab:</para>
  <para style="p" vid="MRK 12:17">—Btaꞌ goꞌ lo Cesar jwanꞌ nak chanꞌ Cesar nde btaꞌ goꞌ lo Dios jwanꞌ nak chanꞌ Dios.</para>
  <para style="p" vid="MRK 12:17">Nde nzoyen toz xaꞌ xa mkab Jesús.<verse eid="MRK 12:17" /></para>
  <para style="s">Nyabdiꞌs xa' xa nak jwan' ryoxban men</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mt. 22:23-33</ref>; <ref loc="LUK 20:27-40">Lc. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Zyasa mbyeꞌd pla xaꞌ saduceos lo Jesús, re xaꞌ jwanꞌ mbez: “Re men nguj naryoxbanta men.” Jwanꞌ nasa mna'bdiꞌs xaꞌ lo Jesús, nchab xaꞌ:<verse eid="MRK 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 12:19" />—Maestr, lo ley jwanꞌ mkeꞌ Moisés nchab: “Tez ti xaꞌ biꞌ mselyaꞌ, nde naꞌnkad ngol xinꞌ xaꞌ tata nguj xaꞌ, tya sa wes thabol ndablo selyaꞌno ngol, sa tanꞌ xaꞌ bin wes xaꞌ.”<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">Dt. 25:5</char></note> <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Ngo ti xaꞌ mkeno gaz wes naꞌ. Xaꞌ ner, mka xaꞌ ngol nde naꞌnkad ngol xinꞌ xaꞌ, tata nguj xaꞌ. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Tya sa xa' brop mka ngol nde taga' naꞌnkad ngol xinꞌ xaꞌ, tata nguj xaꞌ. Nde taga' ngotey kon xaꞌ byon. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Nde tamod ngotey kon re gaz wes xaꞌ. Nek thib xaꞌ na'mkad ngol xinꞌ xaꞌ nde ngolo mbri'd re xa' noga ngol nguj. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />¿Lo senꞌ ryoxban re xa', xanya xaꞌ ak salꞌ ngol, lo ta re gaz wes xaꞌ mdobno ngol?<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Zyasa mkab Jesús, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 12:24">—¡Mbwan yek goꞌ! Tak nanzolot goꞌ xkiꞌs Dios neka nye goꞌ yalne chanꞌ Dios. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Tak senꞌ ryoxban men xij re xa' nguj, nekla selyaꞌ men, nek yo yalselya', che'la ak men xa nak re Áng ta nzi lo beꞌ ba. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Per jwanꞌ ta ryo'xban re xaꞌ nguja, ¿Cho na'ndlapta goꞌ yeꞌs mkeꞌ Moisés, jwan' xa mni Dios lo xaꞌ lo ya yis, ten' nchab Dios: “Na nak Dios lo Abraham, Dios lo Isaak nde Dios lo Jakob”?<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false">Ex. 3:6</char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Dios na'nakta Xaꞌ Dios chan' re men nguj, leꞌ Xaꞌ nak Dios chan' re men naban. Nde goꞌ thitane mbwan yek goꞌ.<verse eid="MRK 12:27" /></para>
  <para style="s">Yalnyebeꞌ ro toz</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mt. 22:34-40</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Tya ndo tib xaꞌ nak maestr ndlo' ley xkiꞌs Dios, mbin xaꞌ re jwanꞌ mdodiꞌsno Jesús xaꞌ saduceo, nde mbwiꞌ xaꞌ nawe mkab Jesús, zyasa mbike xaꞌ lo Jesús nde mnabdiꞌs xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 12:28">—¿Lo reta yalnyebeꞌ jwanꞌ ngebez Dios, xanyay nak jwanꞌ ner?<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Jesús mkab:</para>
  <para style="p" vid="MRK 12:29">—Leꞌ yalnyebeꞌ ner lo retay nak: “Pto nza goꞌ, men Israel; leꞌ Dios naꞌ, Xaꞌ nyebeꞌ lonꞌ, thipta Xaꞌ. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Nde keꞌ lazoꞌa Dios Xa' Nyebe' loa dib nzo lazoꞌa, dib yalnaban chanꞌ la, dib xgab la nde dib yalne chanꞌ la.”<note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">Dt. 6:4-5 nde Josué 22:5.</char></note> Jwanꞌ reꞌ nak yalnyebeꞌ ndak toz lo retay. <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Leꞌ yalnyebeꞌ brop lal naka: “Pkeꞌ lazoꞌa ta men la xaja nkeꞌ lazoꞌa le'ga lu.”<note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">Lv. 19:18</char></note> Naꞌngentra tedib yalnyebeꞌ ro toz xa nak jwanꞌ reꞌ.<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Zyasa xaꞌ nak maestr nteꞌd ley xkiꞌs Dios, nchab:</para>
  <para style="p" vid="MRK 12:32">—¡Linka luy, maestr! ¡Li jwanꞌ ndej la! Tipta Dios nde naꞌngentra tedib Xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false">Dt. 4:35.</char></note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Leꞌ jwanꞌ keꞌ lazoꞌ men Dios, dib nzo lazoꞌ men, dib xgab men, dib yalnaban chanꞌ men nde dib yalne chanꞌ men nde keꞌ lazoꞌ men ta men axaja nke' lazoꞌ men le'ga men, re jwanꞌ reꞌ ndak toz, lo reta jwanꞌ ta ndli xaꞌ, nguj xaꞌ maꞌ sa taꞌ xaꞌ gon lo Dios.<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Mbwiꞌ Jesús nawe mkab xaꞌ liga nchen xaꞌ xkiꞌs Dios, sa nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 12:34">—Nandod la tij lo yalnyebeꞌ chan' Dios.</para>
  <para style="p" vid="MRK 12:34">Yaja nek thib men naꞌnabdiꞌstra xa' lo Jesús.<verse eid="MRK 12:34" /></para>
  <para style="s">¿Cho lo bin nde Crist?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mt. 22:41-46</ref>; <ref loc="LUK 20:41-44">Lc. 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Laj ngeloꞌ Jesús xkiꞌs Dios lo men tenꞌ ndob yodoꞌ, zya mnabdiꞌs Jesús, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 12:35">—¿Cho kwan ndliy re xaꞌ nak maestr ndlo' ley xkiꞌs Dios, mbez xaꞌ: “Lo bin David ye'd Xaꞌ telꞌ Dios”? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Tak yub David mni senꞌ ndono xaꞌ Mbi Nayon chanꞌ Dios, nchab xaꞌ:</para>
  <para style="q" vid="MRK 12:36">Leꞌ Dios<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false">Diꞌsxtil nchaba, Xaꞌ nyebeꞌ.</char></note> nchab lo Xaꞌ Nyebeꞌ lon:</para>
  <para style="q" vid="MRK 12:36">“Ptob lad ban na,</para>
  <para style="q" vid="MRK 12:36">kebeꞌ lin sa lyayo re xaꞌ jwanꞌ nayiꞌ loa.”<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false">Salmos. 110:1</char></note><verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Yub David mbez leꞌ Crist nak “Xaꞌ Nyebeꞌ lo David”. ¿Xamod yed Crist lo bin David sa?</para>
  <para style="p" vid="MRK 12:37">Nde bro toz men yez, nale ngo lazoꞌ xaꞌ mbin xaꞌ xkiꞌs Jesús.<verse eid="MRK 12:37" /></para>
  <para style="s">Jesús mdej xa nak re maestr ndlo' ley xkiꞌs Dios</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mt. 23:1-36</ref>; <ref loc="LUK 11:37-54">Lc. 11:37-54</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Xij ngetoted Jesús men, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 12:38">—Kenap toz goꞌ lo re xaꞌ nak maestr ndlo' ley xkiꞌs Dios, tak re xaꞌ reꞌ ndyen xaꞌ gok xaꞌ lar nolꞌ jwanꞌ ntak toz nde ndyen xaꞌ ni men dyux lo xaꞌ lo xbiꞌ. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Nde nkwanꞌ xaꞌ jwin' tyobzaꞌ xaꞌ lenꞌ yo tenꞌ ndyop men Israel, taga senꞌ wa xaꞌ, nkwanꞌ xaꞌ tenꞌ jwin nya tyobsa' xaꞌ. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Nde nkib xaꞌ liz re ngol nguj salꞌ naꞌ, taja nolꞌ toz ndyodiꞌsno xaꞌ Dios sa tyak men naxut toz nak xaꞌ. Re xaꞌ reꞌ naro toz nak yalti kayaꞌ xaꞌ.<verse eid="MRK 12:40" /></para>
  <para style="s">Ti ngol prob mdaꞌ tmi yon</para>
  <para style="r">(<ref loc="LUK 21:1-4">Lc. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Jesús ndob gax ro yodoꞌ tenꞌ ndob jwanꞌ ngo xaꞌ tmi yon, ndowiꞌ Jesus xa ngo re men tmi tya, nar xaꞌ rik bro tmi ngo xaꞌ tya.<figure style="fig" alt="Jesús viendo las ofrendas" file="cn01794B.tif" size="col" ref="12:41">Nzo chop ned men ndaꞌ tmi yon</figure> <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Nde mzin ti ngol prob nguj salꞌ naꞌ, ndeno xaꞌ chop tmi jwanꞌ lud ntak nde mblo xaꞌy tya. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Zyasa mbrez Jesús re xinꞌ teꞌd Xaꞌ, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 12:43">—Nipa na lo goꞌ, ngol prob ta nguj salꞌ naꞌ reꞌ, bro toz tmi mblo xaꞌ ke lo reta men. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Tak reta men, tmi jwanꞌ mbroxo'b lo xaꞌ, tmi ya mdaꞌ xaꞌ. Nde ngol reꞌ, reta tmi jwanꞌ nden xaꞌ, tyuꞌ jwanꞌ wa xaꞌ, retay mdaꞌ xaꞌ.<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Jesús mdej yub yodoꞌ</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mt. 24:1-2</ref>; <ref loc="LUK 21:5-6">Lc. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Senꞌ ndaroꞌ Jesús tenꞌ ndob yodoꞌ, tib xinꞌ teꞌd Jesús nchab:</para>
  <para style="p" vid="MRK 13:1">—¡Maestr, bwiꞌ xa nawe nya re ke naksaꞌ yodoꞌ reꞌ nde nawe nya diba!<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Mkab Jesús lo xa', nchab Jesús:</para>
  <para style="p" vid="MRK 13:2">—¿Cho ngwiꞌa dib yodoꞌ ro reꞌ? Nek thib ke ba nayaꞌntay xis ta ne'y, retay yub.<verse eid="MRK 13:2" /></para>
  <para style="s">Jwan' lo' ak sen' tera' yoloy thibta ne</para>
  <para style="r">(<ref loc="MAT 24:3-28">Mt. 24:3-28</ref>; <ref loc="LUK 21:7-24">Lc. 21:7-24</ref>; <ref loc="LUK 17:22-24">17:22-24</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Zyasa nda xaꞌ tenꞌ ndole kox ya Olib, tenꞌ ndloꞌ ndob yodoꞌ. Tya mdob Jesús, leꞌ Pedr, Jakob, Juan nde Ndres, xaꞌta mnabdiꞌs xaꞌ lo Jesús, nchab xaꞌ:<verse eid="MRK 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 13:4" />—Btej lo náꞌ. ¿Pol ak re jwanꞌ reꞌ? ¿Nde kwan libeꞌ men senꞌ lo tyobte aka?<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Leꞌ Jesús nchab:</para>
  <para style="p" vid="MRK 13:5">—Nda wiꞌ toz goꞌ sa nek thib men nakwinꞌnoda xa' goꞌ. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Tak nar toz xaꞌ ye'd nde nye xaꞌ: “Na nak Crist, Xaꞌ mtelꞌ Dios”. Nde bro toz men kwin'no xa'.<verse eid="MRK 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 13:7" />Nde senꞌ lo gon goꞌ nzo yalbyo nde nzo'b diꞌs yora yalbyo, nazyepta goꞌ, tak nakiꞌnka ta aka nde na'nakta jwanꞌ nata mney. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Zyara' yo re yez kon yez nde rey kon rey; nde na'r toz tenꞌ win xo nde taja yo win, zya anta ndryoꞌ men karrel, jwanꞌ re' nak xanꞌ re yalti jwan' ye'd.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Lega goꞌ, nda wiꞌ toz goꞌ, tak tayaꞌ men goꞌ lo re xaꞌ nak sinꞌ nde lenꞌ yo tenꞌ ndyop men Israel tya kin xaꞌ goꞌ. We xaꞌ goꞌ lo re xaꞌ nyebeꞌ lo reta yez nde lo rey tak ndli lazoꞌ goꞌ na, tya tej goꞌ na lo xaꞌ. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Nde ndablo nerla diꞌs wen chanꞌ Dios ryaꞌs dib xis izyo. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Nde senꞌ nda xiꞌ xaꞌ goꞌ sa tayaꞌ xaꞌ goꞌ lo xaꞌ nak sinꞌ, nalit goꞌ xgab xamod kab goꞌ, tak Dios tob diꞌs ro goꞌ sa kab goꞌ nde nakta goꞌ jwanꞌ todiꞌs zya, Mbi Nayon chanꞌ Dios todiꞌs. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Nde nzo xaꞌ tayaꞌ lega wes xaꞌ sa kuj men xaꞌ, xud xaꞌ tayaꞌ xinꞌ xaꞌ nde xinꞌ xaꞌ yo xud xaꞌ nde kuj xaꞌ xud xaꞌ. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Nde reta men yiꞌno xaꞌ goꞌ tak ndli lazoꞌ goꞌ na. Leꞌ goꞌ jwanꞌ ne ndo lo xkiꞌs Dios, xek goꞌ kebeꞌ yolo reta jwanꞌ reꞌ, men ya kayaꞌ yalnaban adiꞌ.<figure style="fig" alt="Jesús enseñando" file="cn01882B.tif" size="col" ref="13:13">Jesús ngetaꞌ kwent lo re xinꞌ teꞌd Xaꞌ</figure><verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Men ndlab, xaꞌ ya yen diꞌs jwanꞌ mkeꞌ profet Daniel<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Profet nak ti xaꞌ mbrid xkiꞌs Dios pola. </char></note> nchab xa':<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Daniel 9:27, 11:31, 12:11</char></note> “Senꞌ lo wiꞌ goꞌ ndoyak jwanꞌ narax nakap toz nya tenꞌ nandabloda aka”,<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Tenꞌ nandabloda ak jwanꞌ nakap toz nya, tya nak lenꞌ yodoꞌ Jerusalén.</char></note> zyasa bxonꞌ goꞌ, leꞌ reta men nzi lo xyon Judea, xyonꞌ xaꞌ nda xaꞌ yek yi'. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Leꞌ xaꞌ ndo yek yo, lya xaꞌ nde na'yoted xaꞌ lenꞌ yo sa kote xaꞌ chanꞌ xaꞌ. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Nde xaꞌ jwanꞌ nke sinꞌ wan, na'beretra xaꞌ sa we xaꞌ xab xaꞌ. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Nalat tyák re ngol nzo xinꞌ nde re ngol jwanꞌ ngeno mbed mey wiz ya. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Mna'b toz goꞌ lo Dios, sa naꞌakta jwanꞌ reꞌ senꞌ nxyo'b yop. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Tak re wiz ya jwanꞌ toz yo yalti, ti yalti jwanꞌ nanchoda xata mtoxkwaꞌ Dios izyo nde axta naya nde na'yotray tedib gob. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Nde tez Xaꞌ Nyebeꞌ taꞌ diꞌs bro yo yalti, nek tib men nabantra; benꞌta tak nkeꞌ lazoꞌ Dios re men jwanꞌ mbli Xaꞌ, jwanꞌ nasa lud taꞌ Xaꞌ diꞌs yo yalti.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />Zyasa tez nzo men nye lo goꞌ: “Bwiꞌ goꞌ, xaꞌ reꞌ nak Crist xaꞌ mtelꞌ Dios”, “Bwiꞌ goꞌ, leꞌ Xaꞌ ndo ba”, nalid lazoꞌ goꞌy. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Tak zya ye'd re xaꞌ kwinꞌ gab xaꞌ, “xa' nak Crist nde xa' nak profet”<note caller="+" style="f"><char style="fr" closed="false">13:22 </char><char style="ft" closed="false">Profet nak ti xaꞌ jwanꞌ ndrid xkiꞌs Dios pola. </char></note> nde li xaꞌ re yalnaro jwanꞌ nzoyen men, sa kwinꞌno xaꞌ men, axta noga re men jwanꞌ mbli Dios, chal xaꞌ kwin'no xaꞌ men ya. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Jwanꞌ nasa nda wiꞌ toz goꞌ; tak mdej la nay lo goꞌ nal tera aka.<verse eid="MRK 13:23" /></para>
  <para style="s">Sen' ye'd Xinꞌ Mbiꞌ</para>
  <para style="r">(<ref loc="MAT 24:29-35">Mt. 24:29-35</ref>,<ref loc="MAT 24:42-44">42-44</ref>; <ref loc="LUK 21:25-36">Lc. 21:25-36</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Lenꞌ wiz ya, senꞌ mne mbrid reta yalti toz, leꞌ wiz na'toxnitray nde mbeꞌ natatray xni, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />nde reta mbel nzi lo beꞌ ryo'ndaba nde re yalne naro toz nzo lo beꞌ, xi'da. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Zyasa wiꞌ goꞌ, Xinꞌ Mbiꞌ mbyeꞌd lo izyo, ye'd Xaꞌ xij xkow, ye'dno Xaꞌ yalne toz nde dib yalnaro chanꞌ Xaꞌ. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Nde zya telꞌ Xaꞌ reta Áng Xaꞌ, nde thop Áng reta men jwanꞌ mbli Dios dib nax xis izyo, axta ploja tenꞌ mdib izyo nde mdib beꞌ.<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Pteꞌd goꞌ di's nabix chan' ya hig: Senꞌ ndryo'xo'b re xod yen'na nde ndryo'xo'b re la yenꞌ lo xod, mne goꞌ leꞌ beꞌ yi ndea gax. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Nde taga jwanꞌ goꞌ, senꞌ mne go' ndoyakla reta jwanꞌ reꞌ, ndablo nye goꞌ leꞌ wiz yed Xaꞌ, ndosin gaxla. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Lipa nin lo goꞌ, reta jwan' re' ak sen' tera' lux reta men ta nzi naya. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Le' beꞌ nde izyo tluxa, per re xkiꞌs na na'luxtay.<verse eid="MRK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Per wiz ya nde hor ya ngenta cho nyey, nekla re áng nzi lo beꞌ, nde nekla Xinꞌ Mbi' naꞌnyeday, benꞌta Pay mney.<verse eid="MRK 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 13:33" />Jwanꞌ nasa, brena goꞌ nde ptodiꞌsno goꞌ Dios, tak na'nyed goꞌ pol yoxo'b beꞌ ya. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Naka xa ti mbiꞌ mbroꞌ nda tij, mtanꞌno xa' liz xaꞌ lo men nde mda' xa' yalnyebe' lo re mos, nde kad thiba xaꞌ sinꞌ li xa' nde mnabeꞌ xaꞌ tyobna xaꞌ jwanꞌ kenap ro yo. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Taga goꞌ, brena goꞌ, tak na'nyed goꞌ pol bere xaꞌ nak liz; cho ndakow izyoy, cho rol yalꞌ la, senꞌ mbez ngidteꞌy, o ndatuxni izyoy, <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />sa sen' lo xajta sin xaꞌ, naꞌyosibta xaꞌ goꞌ nziyat goꞌ. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Nde jwanꞌ ta ntej na lo goꞌ reꞌ, lo reta men ntej nay: Brena goꞌ.<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Ngok diꞌs xaꞌ tyen xaꞌ Jesus</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mt. 26:1-5</ref>; <ref loc="LUK 22:1-2">Lc. 22:1-2</ref>; <ref loc="JHN 11:45-53">Jn. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Ndab ti chop wiz sin Pask nde ni chanꞌ pan ngenta lebadur,<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Lebadur jwanꞌ nak ndli ndyobes pan.</char></note> nde re xaꞌ nak ngwleyꞌ ro nde re xaꞌ jwanꞌ nak maestr nteꞌd ley xkiꞌs Dios, nkwanꞌ xaꞌ mod sa kon yalkwinꞌ kuj xaꞌ Jesús. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 14:2">—Na'lid naꞌy lenꞌ wiz ni reꞌ, sa naꞌakxolta re men.<verse eid="MRK 14:2" /></para>
  <para style="s">Ti ngol mblo nit naxe'<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Perfum, nit naxeꞌ ncho lad men.</char></note> dib Jesús</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mt. 26:6-13</ref>; <ref loc="JHN 12:1-8">Jn. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Per Jesús nkete yez Betania, liz Simón xaꞌ jwanꞌ mxak yiz tin ndole lepra, laj nzi xaꞌ ro mes, mzin ti ngol ndeno ti bot naksaꞌ ke ndole alabastro,<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Alabastro ndole ke naksaꞌ bot, jwanꞌ reꞌ ndoxkwaꞌ xaꞌ Egipto, nzoy jwanꞌ naguz nde jwanꞌ nagas.</char></note> sey nzo nit naxeꞌ napta aceit nardo nde nap toza.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Yeꞌ reꞌya ngos izyo ndole India, naxeꞌ toz ndyeꞌy nde nap toza.</char></note> Zyasa mdiꞌs ngol yen bot naksa' ke, mchub ngola yek Jesús. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Nde ngo pla xaꞌ nayiꞌ xija, nchab xaꞌ lo ta xaꞌ:</para>
  <para style="p" vid="MRK 14:4">—¿Kwan liy sa taja ntoti ngol nit naxe' ba? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Tak ntoyal ntho xa'y nde taꞌy tmi jwanꞌ ndli men gan dib ti linꞌ, nde tmi ya ntaꞌ xa' lo re men prob. Mod re' mdodiꞌs xaꞌ xis ngol.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Leꞌ Jesús nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 14:6">—Blaꞌ goꞌ ngol, ¿Kwan liy ta mbez go' lo ngol? Wen nkeli ngol lon. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Re men proba thibka nzino goꞌ xaꞌ nde choja wiz ncholaꞌs goꞌ laꞌsto goꞌ xaꞌ toyala; per na na'ndonod go' na dib tyemp. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Ngol reꞌ mbli xaꞌ jwan' mbli xaꞌ gan, tak nkenla ngol mblo xa' nit naxe' dib na sen' sin wiz ga's na. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Lipa nin lo goꞌ, one ploja tej men diꞌs wen chanꞌ Dios, lo dib nax izyo, noga tej xa' jwanꞌ ta mbli ngol reꞌ, sa telaꞌs men ngol.<verse eid="MRK 14:9" /></para>
  <para style="s">Mbyanꞌdiꞌs Judas tayaꞌ xa' Jesús</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mt. 26:14-16</ref>; <ref loc="LUK 22:3-6">Lc. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Zyasa Judas Iscariote, ti xaꞌ jwanꞌ nakwent lo re tib sen xinꞌ teꞌd Jesús, ngwa xaꞌ lo re xaꞌ nak ngwleyꞌ ro, sa tayaꞌ xaꞌ Jesús. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Senꞌ mbin re xaꞌ nak sin' jwanꞌ reꞌ, ndyen toz xaꞌ, nde mkeꞌyek xaꞌ kix xaꞌ ka Judas. Le' Judas mkwanꞌ mod nyenꞌ xa tayaꞌ xaꞌ Jesús.<verse eid="MRK 14:11" /></para>
  <para style="s">Rsyeꞌ Nayon chanꞌ Xaꞌ Nyebeꞌ</para>
  <para style="r">(<ref loc="MAT 26:17-29">Mt. 26:17-29</ref>; <ref loc="LUK 22:7-23">Lc. 22:7-23</ref>; <ref loc="JHN 13:21-30">Jn. 13:21-30</ref>; <ref loc="1CO 11:23-26">1 Co. 11:23-26</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Wiz ner senꞌ nchal ni ncha xaꞌ pan ngenta lebadur, sen' nchuj xaꞌ mbakxilꞌ lo Pask,<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="ft" closed="false">Pask nak tib ni jwanꞌ ndli xaꞌ par ntelaꞌs xaꞌ xamod mbloꞌte Dios xaꞌ lenꞌ yez Egipto.</char></note> zyasa re xinꞌ teꞌd Jesús nchab:</para>
  <para style="p" vid="MRK 14:12">—¿Plo ncholaꞌs la ya toxkwan' jwanꞌ wanꞌ lo ni Pask?<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Nde mtel' Jesús chop xinꞌ teꞌd Xaꞌ, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 14:13">—Wa goꞌ yez sa tya yosib goꞌ ti xaꞌ biꞌ ndano tib ré<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">Ré, nak ti yet nde xaꞌ nit.</char></note> nit. Ptonke goꞌ xis xaꞌ, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />nde tenꞌ ndob yo sin xaꞌ, tya nyabdiꞌs goꞌ lo xaꞌ nak liz yo, gab goꞌ: “Leꞌ Maestr nyabdiꞌs: ¿Plo taꞌ goꞌ wa rsyeꞌ Xaꞌ kon re xinꞌ teꞌd Xaꞌ lo Pask reꞌ?” <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Nde xa' loꞌ lo goꞌ ti yo ro chop xtaꞌ gap tenꞌ naksaꞌla; tya toxkwaꞌ goꞌ jwanꞌ wanꞌ. <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Ngwa rop xaꞌ nak xinꞌ teꞌd Jesús, mzin xaꞌ lenꞌ yez nde xata nchab Jesús lo xaꞌ, ta ngoka nde tya mtoxkwaꞌ xaꞌ jwanꞌ wa xaꞌ lo Pask.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Nde senꞌ mbla yalꞌ, mzin Jesús kon re tib sen xinꞌ teꞌd Xaꞌ tya. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Nde senꞌ mblatob re xaꞌ ro mes, laj nzi ya xaꞌ, Jesus nchab lo xa':</para>
  <para style="p" vid="MRK 14:18">—Lipa nin lo goꞌ, xij goꞌ reꞌ nzo tib xaꞌ jwanꞌ ndob yanon, xaꞌ ya tayan'.<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Zyasa ndolo ngo nabil lazoꞌ re xaꞌ nde nchab xa' lo ta xa':</para>
  <para style="p" vid="MRK 14:19">—¿Cho nay?<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Leꞌ Jesús mkab, nchab Xa':</para>
  <para style="p" vid="MRK 14:20">—Xij re tib sen goꞌ reꞌ, nzo tib goꞌ jwanꞌ thipta ndo gaz pan naꞌ lenꞌ yen na, xaꞌ yay. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Liga leꞌ Xinꞌ Mbiꞌ nakiꞌnka gaj Xaꞌ, jwan' xa nchabka lo xki's Dios, per ¡nalat toz nya mbi' jwanꞌ tayaꞌ Xinꞌ Mbiꞌ mbyeꞌd lo izyo reꞌ! Wen toz nda mbiꞌ ya tez naꞌngalta xaꞌ.<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Nde laj nzi ya re xaꞌ, mxen Jesús pan nde mbli leyꞌ Xaꞌy, nde mchix Xa'y, mdaꞌ Xaꞌy lo re xinꞌ teꞌd Xaꞌ, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 14:22">—Bda goꞌy, jwanꞌ reꞌ nak belꞌ na.<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Nde mxen Jesus jwanꞌ nzo nit ub, nde ngolo mdaꞌ Xaꞌ dyux lo Dios, mdaꞌ Xaꞌy lo re xinꞌ teꞌd Xaꞌ, nde ngu' reta xa'y.<figure style="fig" alt="Ultima cena" file="CN01803B.TIF" size="col" ref="14:23">Lult rsyeꞌ Nayon chan’ Jesús kon re xinꞌ teꞌd Xaꞌ</figure> <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Nde nchab Jesús:</para>
  <para style="p" vid="MRK 14:24">—Jwanꞌ reꞌ nak ren na, jwan' mda' nakub Dios xkiꞌs Xaꞌ, ren reꞌ xyoy par bro toz men. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Lipa nin lo goꞌ na'gutra na nit ub re' tedib gob, axta kebeꞌ gun nit ub kub ten' nyebeꞌ Dios.<verse eid="MRK 14:25" /></para>
  <para style="s">Jesús ndej xa kala's Pey</para>
  <para style="r">(<ref loc="MAT 26:30-35">Mt. 26:30-35</ref>; <ref loc="LUK 22:31-34">Lc. 22:31-34</ref>; <ref loc="JHN 13:36-38">Jn. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Senꞌ ngolo mbilꞌ xaꞌ salmo, mbroꞌ xaꞌ nda xaꞌ yek yi' Olib. <verse eid="MRK 14:26" /><verse number="27" style="v" sid="MRK 14:27" />Zyasa nchab Jesús lo re xa':</para>
  <para style="p" vid="MRK 14:27">—Nayal' re' ta'b go' xgab go' lon, tak lo xkiꞌs Dios nchab: “Guj na Xaꞌ ndowa mbakxilꞌ nde ryaꞌs reta mbakxilꞌ.”<note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false">Zacarías 13:7</char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Lo senꞌ ngolo ryoxban na, ner na siblo lo goꞌ sin na Galilea.<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Zyasa Pey nchab lo Jesús:</para>
  <para style="p" vid="MRK 14:29">—¡Tenye reta xaꞌ ta'b xa' xgab xa' loa, na naꞌlit nay!<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Leꞌ Jesús nchab lo Pey:</para>
  <para style="p" vid="MRK 14:30">—Lipa nin loa le' lu, nayalꞌ reꞌ, senꞌ tera' kwez ngidteꞌ mbrop gob, lu mbyon la gob gab la, na'nzolot la na.<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Leꞌ Pey masraꞌ mdosaꞌ nchab Pey:</para>
  <para style="p" vid="MRK 14:31">—Te'nye mbij xa' na, na'lat na lu.</para>
  <para style="p" vid="MRK 14:31">Noga reta xa' taga' nchab xaꞌ.<verse eid="MRK 14:31" /></para>
  <para style="s">Jesús mdodiꞌsno Dios tenꞌ nak Getsemaní</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mt. 26:36-46</ref>; <ref loc="LUK 22:39-46">Lc. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Ngolo jwanꞌna, nda xaꞌ tenꞌ ndole Getsemaní, nde nchab Jesús lo re xinꞌ teꞌd Xaꞌ:</para>
  <para style="p" vid="MRK 14:32">—Ncheta bre goꞌ, laja na nda todiꞌsno Dios.<verse eid="MRK 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33" />Nde mbeꞌ Jesús Pey, Jakob nde Juan, nde ngonabil lazoꞌ Jesús, narax mxak Xaꞌ. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Nde nchab Xaꞌ:</para>
  <para style="p" vid="MRK 14:34">—Nabil toz nzo lazoꞌn, axta gaj na; ncheta byanꞌ goꞌ nde brena goꞌ.<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Mde Jesús tud tya, mdoxub Xaꞌ mdinꞌ yek Xaꞌ izyo, nde mna'b Xaꞌ lo Dios, nyenꞌ cho toyal na'rita Xaꞌ lo yalti. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Nchab Xaꞌ:</para>
  <para style="p" vid="MRK 14:36">—¡Pay, Xud na! reta jwanꞌ toyal lia; nata'd la diꞌs rid na lo re yalti reꞌ, per nagaktay xa ncholas na, gaka xa ncholaꞌs la.<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Zyaga mbere Jesús nde ngosi'b Jesús re xaꞌ, nzi yat xaꞌ; nde nchab Jesus lo Pey:</para>
  <para style="p" vid="MRK 14:37">—Simón, ¿cho naxyat la? ¿Cho nek ti hor na'xekta la tyobnaa? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Brena goꞌ nde ptodiꞌsno goꞌ Dios, sa na'tokil'ta maxuꞌ goꞌ; xbin men liga ndosaꞌy, per belꞌ men na'xektay.<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Ngwa todiꞌsno Jesús Dios tedib gob, le'ga re diꞌs ya nchab Xaꞌ. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Senꞌ mbere Jesus, bere ngosi'b Xaꞌ re xinꞌ teꞌd Xaꞌ nzi yat re xa', tak xekta ngudlo xaꞌ ncho mkalꞌ nde nanyet xaꞌ kwan kab xaꞌ lo Jesús. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Lo ngoxo'b byon gob mbere Jesús, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 14:41">—¿Cho tatka nzi yat goꞌ nde nzi roxkwen goꞌ? ¡mney! mzin hor, naya taya' xa' Xinꞌ Mbiꞌ lo yaꞌ re men nzob xkenꞌ. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Goche goꞌ sa ndan', tak gax la nde xaꞌ jwanꞌ tayaꞌn.<verse eid="MRK 14:42" /></para>
  <para style="s">Mxen xaꞌ Jesús</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mt. 26:47-56</ref>; <ref loc="LUK 22:47-53">Lc. 22:47-53</ref>; <ref loc="JHN 18:2-11">Jn. 18:2-11</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Laj benꞌ ndotodiꞌs Jesús, mzin Judas, ti xaꞌ jwanꞌ nakwent lo re tib sen xinꞌ teꞌd Jesus, ndeno xaꞌ bro toz men, kon espad nde ya, reta xaꞌ reꞌ mtelꞌ re xaꞌ nak ngwleyꞌ ro, re maestr ndlo' ley xkiꞌs Dios nde re xaꞌ jwanꞌ nak sinꞌ lo men Israel. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Tak xaꞌ jwanꞌ tayaꞌ Jesús, mbyanꞌdiꞌsla xaꞌ lo reta men ndano xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 14:44">—Xaꞌ jwanꞌ tan chut lad kwat na, Xaꞌ yay; tyen goꞌ Xaꞌ nde nata'd goꞌ diꞌs lyaꞌ Xaꞌ.<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Nde senꞌ mzin Judas, zyaga mbike xaꞌ gax lo Jesús nde nchab xaꞌ:</para>
  <para style="p" vid="MRK 14:45">—¡Maestr, maestr!</para>
  <para style="p" vid="MRK 14:45">Nde mdaꞌ xaꞌ chut kwat Jesús. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Zyasa reta xa' ya mblo' ya xa' nde mxen xaꞌ Jesús.<figure style="fig" alt="Arrresto de Jesús" file="cn01814B.tif" size="col" ref="14:46">Mxen xaꞌ Jesús xaja tib xaꞌ wanꞌ</figure><verse eid="MRK 14:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 14:47" />Per ti xaꞌ jwanꞌ ndo tya, mbloꞌte xaꞌ espad, mchoꞌ xaꞌ nza ti xaꞌ jwanꞌ nak sinꞌ lo mbol nglweyꞌ ro. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Leꞌ Jesús mkab, nchab Xaꞌ:</para>
  <para style="p" vid="MRK 14:48">—¿Xaja men ndexen ti wan'na nde go' kon espad nde kon ya ndexen goꞌ na? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Reta wiz mdon xij goꞌ mbloꞌn xkiꞌs Dios tenꞌ ndob yodoꞌ, nde na'ndenta goꞌ na; per taga gaka, sa ak jwanꞌ nchab lo xkiꞌs Dios.<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Zyasa reta xa' nak xinꞌ teꞌd Jesús, mxonꞌ xaꞌ, mblaꞌ xaꞌ Jesús.<verse eid="MRK 14:50" /></para>
  <para style="s">Ti mbyo yenꞌ mxonꞌ</para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Per ngo ti mbyo yenꞌ mdonke xis Jesús, benꞌ tib ble lar nachal or; nde mxen xa' or. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Le' mbyo ya mbla'r lar nachal or, tata cheyꞌ or mxonꞌ or.<verse eid="MRK 14:52" /></para>
  <para style="s">Mzino xaꞌ Jesús lo re xaꞌ nak sinꞌ</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mt. 26:57-68</ref>; <ref loc="LUK 22:54-55">Lc. 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:12-14">Jn. 18:12-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Zyasa mzin no xaꞌ Jesús lo mbol ngwleyꞌ ro; nde tya mdyop re xaꞌ nak ngwleyꞌ nyebe', reta xaꞌ jwanꞌ nak sinꞌ lo men Israel nde re xaꞌ jwanꞌ nak maestr ndlo' ley xkiꞌs Dios. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Leꞌ Pey tij tij mdonke xaꞌ xis Jesús ngote xaꞌ lo le chan' mbol ngwleyꞌ ro; nde nzo Pedr xij re xaꞌ nkenap yodoꞌ, nzi bis xaꞌ lo ki. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Leꞌ re xaꞌ jwanꞌ nak ngwleyꞌ nyebe' nde reta ta nak sinꞌ xaꞌ, nkwanꞌ xaꞌ cho yalke nchap Jesús sa tayaꞌ xaꞌ Jesús lo yalguj, nde nek thib yalke naꞌngasalta xaꞌ . <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Tenye nar xaꞌ mdej diꞌs kwinꞌ xis Jesús per na'nsal'ta xki's xa'. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Zyasa mdoli pla xaꞌ, mdej diꞌs kwinꞌ xis Jesus, nchab xaꞌ:<verse eid="MRK 14:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MRK 14:58" />—Mbin náꞌ cheꞌ nchab xaꞌ reꞌ: “Sil na yodoꞌ ta mtoxkwaꞌ ya' mena nde lenꞌ sonta wiz toxkwan tediba jwan' na'toxkwa'da men.”<verse eid="MRK 14:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MRK 14:59" />Per nekla ta na'nsal'ta xki's xa' lo jwan' ndej xa'. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />Zyasa le' mbol ngwleyꞌ ro, mtoli xa' xij re men nzi tya, mna'bdiꞌs xaꞌ lo Jesús nchab xaꞌ:</para>
  <para style="p" vid="MRK 14:60">—¿Cho ngen kwan kab la? ¿Cho li jwanꞌ ta mbez re men reꞌ xisla?<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Leꞌ Jesús mtow' ro Xa' nde ngen kwan nkab Xaꞌ. Leꞌ mbol ngwleyꞌ ro bere mnabdiꞌs xaꞌ lo Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 14:61">—¿Cho lu nak Crist, Xinꞌ Xa' Nayon?<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Leꞌ Jesús nchab:</para>
  <para style="p" vid="MRK 14:62">—Nay; nde wiꞌ goꞌ Xinꞌ Mbiꞌ mbyeꞌd lo izyo, tyob Xa' lad ban Dios tenꞌ nzo yalne toz, nde ye'd Xa' xij xkow lo be'.<note caller="+" style="f"><char style="fr" closed="false">14:62 </char><char style="ft" closed="false">Salmos 110:1, Daniel 7:13-14</char></note><verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Zyasa leꞌ mbol ngwleyꞌ ro, mched xaꞌ xab xaꞌ, nchab xaꞌ:</para>
  <para style="p" vid="MRK 14:63">—¿Cho kwanra' mas ngembed na' men taꞌ kwent? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />¡Mbinla goꞌ, diꞌs xin mni Xaꞌ! ¿Xa ngwiꞌ goꞌ di's ba?</para>
  <para style="p" vid="MRK 14:64">Zyasa reta xaꞌ nchab:</para>
  <para style="p" vid="MRK 14:64">—¡Liga nchap Xaꞌ yalke, ndablo gaj Xaꞌ!<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Nde pla men ntolo mzuk xa' lo Jesús, mtowꞌ xaꞌ lo Jesús nde mdin xaꞌ Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 14:65">—¡Btej, nyenꞌ cho nkeꞌy choa!</para>
  <para style="p" vid="MRK 14:65">Leꞌ re xaꞌ nkenap yodoꞌ taga mdin xaꞌ Jesús.<verse eid="MRK 14:65" /></para>
  <para style="s">Nkalaꞌs Pey nzolo xaꞌ Jesús</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mt. 26:69-75</ref>; <ref loc="LUK 22:56-62">Lc. 22:56-62</ref>; <ref loc="JHN 18:15-18">Jn. 18:15-18</ref>,<ref loc="JHN 18:25-29">25-29</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Leꞌ Pey ndo lo le lad la, tya ndarid tib ngol nge sinꞌ lo mbol ngwleyꞌ ro. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Senꞌ mbwi' ngol ndobis Pey lo ki, xe mbwiꞌ ngol lo Pey, nchab ngol:</para>
  <para style="p" vid="MRK 14:67">—No lu mketenke xis Jesús, xaꞌ yez Nazaret.<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Leꞌ Pey mkalaꞌs, nchab Pey:</para>
  <para style="p" vid="MRK 14:68">—Na'nzolot na Xaꞌ, nanyet na kwan ta mbez la.</para>
  <para style="p" vid="MRK 14:68">Nde mbroꞌte Pey le; zyaga mbil' ngidteꞌ. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Leꞌ ngol ya, mbwiꞌ ngol Pey tedib gob, ntolo mtobte nchab ngol lo re xaꞌ nzi tya:</para>
  <para style="p" vid="MRK 14:69">—No xaꞌ reꞌ mketenke xis Jesús.<verse eid="MRK 14:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MRK 14:70" />Le' Pey bere mkala's tedib gob. Nde tud la ndatey, re xaꞌ nzi tya bere nchab xaꞌ lo Pey:</para>
  <para style="p" vid="MRK 14:70">—Liga noga lu nak ti xaꞌ ta mketenke xis Jesús; tak men Galilea nak la, nde xaxa ndyodiꞌs re xa' ya taxa ndyodi's la.<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Zyasa ntolo mni xin Pey nde mke'ro Pey nchab Pey:</para>
  <para style="p" vid="MRK 14:71">—Na'nzolot na mbi' ta ndej goꞌ lon ba!<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Nde zyaga mbil' ngidteꞌ mbrop gob. Zya mtelaꞌs Pey diꞌs jwanꞌ nchab Jesús lo Pey: “Senꞌ tera gol ngidte' brop gob, leꞌ lu mbyonla gob gab la nanzolot la na.” Nde mte'laꞌs Pey jwanꞌna, mbinꞌ Pey.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Mbeꞌ xaꞌ Jesús lo Pilat</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mt. 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Lc. 23:1-5</ref>; <ref loc="JHN 18:28-38">Jn. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Tedib wiz til' toz, sen' ngolo mdodi's reta xaꞌ nyebeꞌ lo re men Israel, re xa' nak ngwleyꞌ nyebe', re xaꞌ nak sinꞌ lo men Israel nde re maestr ndlo' ley xkiꞌs Dios, nago Jesus mbe' xa' Xaꞌ, nde mda'ya' xa' Jesus lo Pilat. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Leꞌ Pilat mnabdiꞌs lo Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 15:2">—¿Cho lu nak Rey lo re men Israel?</para>
  <para style="p" vid="MRK 15:2">Jesús mkab nde nchab Xaꞌ:</para>
  <para style="p" vid="MRK 15:2">—Lu ney.<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Leꞌ re xa' nak ngwleyꞌ nyebe' jwanꞌ toz mkeꞌ xaꞌ yalke yek Jesús. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Bere mnabdiꞌs Pilat lo Jesús tedi gob, nchab xaꞌ:</para>
  <para style="p" vid="MRK 15:4">—¿Cho ngen kwan kab la? ¡Bwiꞌ, plopa yalke nkeꞌ men yek la!<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Leꞌ Jesús nekla lo jwan' na naꞌnkabta Xaꞌ; zyasa nzoyen toz Pilat.<verse eid="MRK 15:5" /></para>
  <para style="s">Mna'b re men gaj Jesús</para>
  <para style="r">(<ref loc="MAT 27:15-31">Mt. 27:15-31</ref>; <ref loc="LUK 23:13-25">Lc. 23:13-25</ref>; <ref loc="JHN 18:38-19:16">Jn. 18:38—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Le' naya, senꞌ nchal ni chanꞌ Pask ndla' xa' ti xaꞌ nke liz yi'b, choja xaꞌ jwan' nchola's xa' ryoꞌte. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Nde ngo ti xaꞌ ndole Barrabás, nke xa' liz yi'b kon tipla ta xaꞌ jwan' mbij xa' men lo byo. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Nde lo mzin reta men, mdobte mna'b xaꞌ lo Pilat jwan' xa ndliga xa' re len' lin'. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Leꞌ Pilat mkab, nchab Pilat lo reta xa':</para>
  <para style="p" vid="MRK 15:9">—¿Cho ncholaꞌs goꞌ lan Xaꞌ ta nak Rey lo re men Israel?<verse eid="MRK 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 15:10" />Tak mne Pilat ke re xa' nak ngwleyꞌ nyebe' ben' por ngiꞌno xaꞌ Jesús sa mdayaꞌ xaꞌ Jesús. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Leꞌ re xa' nak ngwleyꞌ nyebe' mblo xaꞌ yek reta men sa mna'b xaꞌ mas jwin ryo'te Barrabás. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Bere mkab Pilat nchab xa' lo reta men:</para>
  <para style="p" vid="MRK 15:12">—¿Cho kwan ncholaꞌs goꞌ li non Xaꞌ ta mbez goꞌ nak Rey lo re men Israel?<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Nde reta men ne mbrez xa', nchab xa':</para>
  <para style="p" vid="MRK 15:13">—¡Bkeꞌ Xaꞌ lo kruz!<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Leꞌ Pilat nchab lo xaꞌ:</para>
  <para style="p" vid="MRK 15:14">—¿Cho yalke mbli Xa'?</para>
  <para style="p" vid="MRK 15:14">Per masra' ne mbrez reta men, nchab xa':</para>
  <para style="p" vid="MRK 15:14">—¡Bkeꞌ Xaꞌ lo kruz!<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Nde Pilat ndyen xa' li xa' jwan' nya'b reta men, mbloꞌte xa' Barrabás, nde mdaya' xa' Jesus, sen' mne mdin xa' Jesus, ke' xaꞌ Jesús lo kruz.<verse eid="MRK 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Zyasa re soldad mbeꞌ xaꞌ Jesús len' yo, lo le chanꞌ yolow, nde mbrez xaꞌ reta soldad. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Nde mxo'b xaꞌ ti lar konch nane xis Jesus,<note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false">Lar reꞌ nxyob xis xaꞌ nak rey.</char></note> nde mdob xaꞌ ti koron naksa' yis yek Jesús, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />mdobte mni xaꞌ dyux lo Jesús, nchab xa':</para>
  <para style="p" vid="MRK 15:18">—¡Naro nak Rey lo re men Israel!<figure style="fig" alt="Burlando de Jesús" file="cn01827B.tif" size="col" ref="15:18">Mbloꞌs xaꞌ Jesús, nchab xaꞌ: —Naro nak Rey men Israel</figure><verse eid="MRK 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 15:19" />Nde mkeꞌ xaꞌy yek Jesus kon tible ya, nde mzuk xaꞌ lo Jesús, nde mdoxub xaꞌ lo Jesus xaga ti lo rey. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Senꞌ mne mbloꞌs xaꞌ Jesús, mkib xaꞌ xab rey xis Jesús nde mxo'b xaꞌ le'ga xab Jesús xis Jesús, nde mbroꞌteno xaꞌ Jesús sa keꞌ xaꞌ Jesús lo kruz.<verse eid="MRK 15:20" /></para>
  <para style="s">Mke Jesus lo kruz nde nguj Xa'</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mt. 27:32-44</ref>; <ref loc="LUK 23:26-43">Lc. 23:26-43</ref>; <ref loc="JHN 19:17-27">Jn. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Nde mna'b xa ti lo mbiꞌ jwan' ndarid tya, Simon xa' yez Ciren, xud Lejantr nde xud Ruf, mbro' xa' lo sin' wan, nde mnabeꞌ xaꞌ lo Simón sa we xaꞌ kruz Jesús. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Nde mbe' xaꞌ Jesús ti tenꞌ ndole Gólgota. (Diꞌs reꞌ nak: Cho yek men.)<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="ft" closed="false">Gólgota ndole tib kox ke, nde xanya yek men tamod naksaꞌ ke, jwanꞌ nasa mblole xaꞌ tya “Sij yek men”.</char></note> <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Nde mdaꞌ xaꞌ nit ub nos mirra<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="ft" closed="false">Nit ub nos kon mirra, nit ya nchuꞌ xaꞌ par yib nchow xaꞌ. </char></note> gu Jesús, per na'ngud Xaꞌy. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Senꞌ ngolo mkeꞌ xa' Jesús lo kruz, ndolo mdij xaꞌ sa nyenꞌ xanya xab Jesús dinꞌ tiba xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">15:24 </char><char style="ft" closed="false">Salmos 22:18.</char></note><verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />Senꞌ ndyekela wiz mkeꞌ xaꞌ Jesús lo kruz. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Nde yalke jwan' mke' xa' yek Jesus, nchaba: “REY LO RE MEN JUDIO.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Nde noga chop xaꞌ wanꞌ mke' xa' cho Jesus, tib xaꞌ mke lad ban nde tedib xaꞌ mke lad beg. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Nde ngok jwanꞌ nchab lo xkiꞌs Dios: “Thipta mblo' men kwent Xa' kon re men nzo'b xkenꞌ.”<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Tib ned versión nangenta versículo 28 per diꞌs reꞌ mbroꞌ lo libr chanꞌ Isaías 53:12.</char></note> <figure style="fig" alt="La muerte de Jesús" file="CN01836B.TIF" size="col" ref="15:28">Tipta mblilal men Xaꞌ xij xaꞌ nzob xkenꞌ</figure><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Nde re men ndarid tya mbloꞌs xaꞌ Jesús, nkwin xaꞌ yek xaꞌ, nchab xaꞌ lo Jesús:</para>
  <para style="p" vid="MRK 15:29">—Maga lu mbez, sil la yodoꞌ chanꞌ Dios nde lenꞌ son wiz tokub lay, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />ptolaꞌ lega lu, nde bla lo kruz.<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Nde noga re xa' nak ngwleyꞌ nyebe' nde re xaꞌ nak maestr ndlo' ley xkiꞌs Dios, taga' mbloꞌs xaꞌ Jesús, nchab xaꞌ lo ta xaꞌ:</para>
  <para style="p" vid="MRK 15:31">—Xaga xaꞌla re men mtola' Xa' nde le'ga Xa' naꞌakta tolaꞌ Xaꞌ lazo' Xaꞌ.<verse eid="MRK 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 15:32" />Crist, Rey lo men Israel, bla lo kruz naya, sa wiꞌ ná' nde li lazoꞌ ná' lu. Nde noga xaꞌ jwanꞌ nke lo kruz cho Jesús, mbloꞌs xaꞌ Jesús.<verse eid="MRK 15:32" /></para>
  <para style="s">Nguj Jesús</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mt. 27:45-56</ref>; <ref loc="LUK 23:44-49">Lc. 23:44-49</ref>; <ref loc="JHN 19:28-30">Jn. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Senꞌ rolja wiz, mblato yalꞌkow dib nax izyo axta bzye. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Nde bzye ya mbrez yaj Jesús nchab Xaꞌ:</para>
  <para style="p" vid="MRK 15:34">—Eloi, Eloi, ¿lama sabaktani? (Diꞌs ya nak: Dios na, Dios na, ¿Cho kwan liy mblaꞌ ya'a na?)<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Salmos 22:11.</char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Nde pla xaꞌ nzi tya, lo mbin xaꞌ ta mbrez Jesus, nchab xaꞌ:</para>
  <para style="p" vid="MRK 15:35">—Bwiꞌ goꞌ, ngebez Xaꞌ Elias.<note caller="+" style="f"><char style="fr" closed="false">15:35 </char><char style="ft" closed="false">Jesús mni Xaꞌ xkiꞌs Xaꞌ Hebreo nchab Xaꞌ “Eloi”, diꞌs reꞌ nak “Xud na Dios”, nde re men nzi tya xaꞌla mbyen xaꞌy, leꞌ xaꞌ mbyena leꞌ Jesús ngebez Elías xaꞌ mbrid xkiꞌs Dios pola.</char></note><verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Nde mke' ti xaꞌ karel, mbwaz xa' ti xilꞌ lo nit ub mbyál nde mtob xaꞌy ti lo ya, mda' xaꞌy ngu' Jesús, nchab xaꞌ:</para>
  <para style="p" vid="MRK 15:36">—Naa sa win' nyenꞌ cho tye'd la Elías Xaꞌ lo kruz.<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Le' Jesus, mbrez yaj Xa', nguj Xaꞌ. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />Zyasa lar nge tenꞌ Nayon lenꞌ yodoꞌ, chop mble ngoka, xata gap nde axta la. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Leꞌ xaꞌ nyebeꞌ lo tib ayoꞌ sondad ta ndo xa' gax lo Jesus, ndowiꞌ xa' senꞌ mbrez Jesús nde nguj Jesus, nchab xaꞌ:</para>
  <para style="p" vid="MRK 15:39">—Lipa liga mbi' reꞌ nak Xinꞌ Dios.<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Noga tij nzi pla ngol nzi wi' tya; xija nzo Marí Magdalen,<note caller="+" style="f"><char style="fr" closed="false">15:40 </char><char style="ft" closed="false">María Magdalen, ta ndole xaꞌ tak leꞌ xaꞌ nak men yez Magdala. Marí reꞌ nchaj lo versículo 15:47, 16:1,8,9.</char></note> nde Marí xnaꞌ Jakob or yenꞌ, wes José nde Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Re ngol reꞌ mketenke xis Jesús, nde mbli ngol sinꞌ lo Xaꞌ sen' ngwa xa' Galilea; nde tipla ngol mketenke xis Jesus senꞌ ngwa Xaꞌ Jerusalén.<verse eid="MRK 15:41" /></para>
  <para style="s">Mbwaꞌs Jesús</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mt. 27:57-61</ref>; <ref loc="LUK 23:50-56">Lc. 23:50-56</ref>; <ref loc="JHN 19:38-42">Jn. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Sen' ndela yal', tak wiz yaja nak par toxkwaꞌ xaꞌ re chan' xaꞌ, tedib wiz nakla wiz ndryoxkwen men. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Jose xaꞌ yez Arimatea nak xa' ti xa' nakaya' sinꞌ ro lo yolow, no xa' ngembed ye'd Yalnyebeꞌ chanꞌ Dios, jwan' nasa na'nzyebta xa' mbike xa' lo Pilat, nde mna'b xa' thobol Jesús lo kruz. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Leꞌ Pilat nzoyen toz senꞌ mbin xaꞌ ngujla Jesús; nde mbrez Pilat xaꞌ nyebeꞌ lo sondad, sa mnabdiꞌs Pilat lo xaꞌ nyen' cho nguj la Jesús?<verse eid="MRK 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 15:45" />Sen' lo mdej xa' nyebe' lo sondad ke nguj la Jesus, zyasa mdaꞌya Pilat thobol lo José, <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />le' Jose mxi' xa' lar nakis lar lan, nde mbla xaꞌ thabol lo kruz, mchal lar xaꞌ Xaꞌ nde mkaꞌs xaꞌ Jesus lenꞌ ti baꞌ nadenꞌ lenꞌ ke nde mdub xa' ti ke ro mtowꞌ xaꞌ ro baꞌ. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Leꞌ Marí Magdalen nde Marí xnaꞌ José mbwiꞌ xaꞌ plo mkaꞌs xaꞌ Jesús. <figure style="fig" alt="Metiendo el curepo de Jesus en la tumba." file="cn01847B.tif" size="col" ref="15:47">Nda kaꞌs xaꞌ thabol Jesús lenꞌ ti baꞌ</figure><verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Mbro'xban Jesús</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mt. 28:1-10</ref>; <ref loc="LUK 24:1-12">Lc. 24:1-12</ref>; <ref loc="JHN 20:1-10">Jn. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Senꞌ mbridla wiz ndryoxkwen men, leꞌ Marí Magdalen, Marí xnaꞌ Jakob, nde Salome, mxiꞌ xaꞌ nit naxeꞌ yalo xaꞌ lad thabol Jesús. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Nde tilꞌ toz, wiz ner xan' sman, sen' ndoro'xo'b la wiz, ngwa ngol ro baꞌ. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Nde nchab ngol lo ta ngol:</para>
  <para style="p" vid="MRK 16:3">—¿Cho xaꞌ sike' ke jwanꞌ nowꞌ ro baꞌ?<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Per senꞌ mzin xaꞌ, mbwi' xa' mbike ke jwanꞌ nowꞌ ro baꞌ, ke ro toza.<figure style="fig" alt="Resurrección de Jesús" file="cn01850B.tif" size="col" ref="16:4">Ngenta Jesús ncheꞌ, mbroꞌxbanla Xaꞌ</figure> <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Senꞌ ngote xaꞌ lenꞌ baꞌ, mbwiꞌ xaꞌ ti mbyo yenꞌ<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">Mbyo yenꞌ, nak tib Áng chanꞌ Dios, Mateo 28:2, Lucas 24:4</char></note> ndob lad ban, dib mbyo nachal lar nakis, nde mzyeb toz xaꞌ. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Leꞌ mbyo nchab:</para>
  <para style="p" vid="MRK 16:6">—¡Nazyebta goꞌ! Goꞌ nkwanꞌ Jesús, Xaꞌ yez Nazaret, Xaꞌ jwanꞌ mke lo kruz. Ngenta Xaꞌ ncheꞌ, mbro'xbanla Xaꞌ. Bwiꞌ goꞌ plo tenꞌ ngo'x Xaꞌ. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Per bya goꞌ, guz goꞌ lo re xinꞌ teꞌd Xaꞌ nde lo Pey, le' Xaꞌndasi'blola lo go' sin xa' Galilea, tya wiꞌ goꞌ Xaꞌ, xatka ne Xaꞌ lo goꞌ.<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Le' re ngol ya mbro' xa' len' ba' mke' xa' karel ndya xa', tak mxi'd toz xa' nde mzyeb xaꞌ; ngenta kwan ngab xaꞌ lo nek tib men tak mzyeb toz xaꞌ.<verse eid="MRK 16:8" /></para>
  <para style="s">Jesús mbroto lo Marí Magdalen</para>
  <para style="r">(<ref loc="JHN 20:11-18">Jn. 20:11-18</ref>; <ref loc="LUK 24:13-35">Lc. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Sen' lo ta mbro'xbanla Jesús tilꞌ toz, wiz ner xan' sman, nerla mbro'to Jesús lo Marí Magdalen, ngol jwanꞌ mbloꞌte Jesus gaz mbi narax lazonꞌ. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Ngol ya ngwateja lo re xaꞌ jwanꞌ mketenke xis Jesús, tak nabil toz ndyak xaꞌ nde nzi yonꞌ xaꞌ. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Re xa' ya, senꞌ mbin xa' naban Jesús nde mbwiꞌ ngol Jesús, naꞌndlid lazoꞌ xaꞌy.<verse eid="MRK 16:11" /></para>
  <para style="s">Jesús mbroto lo chop xinꞌ teꞌd Xaꞌ</para>
  <para style="r">(<ref loc="LUK 24:13-35">Lc. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Per xisla xaꞌla mod mbroꞌto Jesus lo chop xinꞌ teꞌd Xaꞌ senꞌ rop xaꞌ reꞌ ndote, nda xa' ned wan. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Rop xaꞌ reꞌ ngwateja lo tipla xaꞌ; nde nekla xkiꞌs rop xaꞌ ya na'ndlid lazoꞌ xaꞌy.<verse eid="MRK 16:13" /></para>
  <para style="s">Jesús mtaya' sinꞌ lo re xinꞌ teꞌd Xaꞌ</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mt. 28:16-20</ref>; <ref loc="LUK 24:36-49">Lc. 24:36-49</ref>; <ref loc="JHN 20:19-23">Jn. 20:19-23</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Ngolo jwan'na Jesús mbroꞌto lo re siꞌ thib xinꞌ teꞌd Xaꞌ, senꞌ nzi re xaꞌ ro mes, nde mtokox Jesús xaꞌ kwent na'ndlid lazoꞌ xa' nde nchak ne lazo' xaꞌ, tak namblid lazoꞌ xaꞌ re xaꞌ jwanꞌ mbwi' mbroxban Jesús. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Nde nchab Jesús lo xaꞌ:</para>
  <para style="p" vid="MRK 16:15">—Wa goꞌ dib nax izyo nde ptej goꞌ diꞌs wen chanꞌ Dios lo reta men. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Men li lazon' xkiꞌs na nde ryole xaꞌ, xaꞌ ya lya'. Leꞌ xaꞌ na'lid lazonꞌ xkiꞌs na, xa' ya kix xaꞌ xken xaꞌ. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Nde reta jwanꞌ re' toyal li re xa' jwan' li lazon' xkiꞌs na: Lo len kote xaꞌ re mbi narax, todiꞌs xaꞌ re diꞌs kub, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />tyen xaꞌ mbelꞌ lo yaꞌ xaꞌ nde tez gu xaꞌ nit tin, ngenta kwan tyak xaꞌ. Xob xaꞌ yaꞌ xaꞌ yek re men nayiz nde tyan' nadan' xaꞌ.<verse eid="MRK 16:18" /></para>
  <para style="s">Ngwap Jesus lo beꞌ</para>
  <para style="r">(<ref loc="LUK 24:50-53">Lc. 24:50-53</ref>; <ref loc="ACT 1:6-11">He. 1:6-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Le' Xaꞌ Nyebe', sen' ngolo mdodi's Xa', ngwap Xa' ndya Xa' lo beꞌ, nde mdob Xaꞌ lad ban Dios.<figure style="fig" alt="Ascensión de Jesús" file="CN01883B.TIF" size="col" ref="16:19">Nzi wiꞌ re xinꞌ teꞌd Jesús, ngwap Xaꞌ lo beꞌ</figure> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Leꞌ re xaꞌ nak xinꞌ teꞌd Jesús, mbroꞌ xaꞌ nda tej xaꞌ xkiꞌs Dios reta lad, Xa' Nyebe' ndolaꞌsto xaꞌ nde ngoto' Xa' liga re dis jwan' ndej xa' kon re yalnaro jwan' nchak lo men.</para>
  <para style="p" vid="MRK 16:20">Ta aka<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>