<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id" />
  <para style="h">HEBREOS</para>
  <para style="toc3">Heb.</para>
  <para style="toc2">Hebreos</para>
  <para style="toc1">Hebreos</para>
  <para style="mt2">Yeꞌs jwanꞌ mkeꞌ xaꞌ lo re xaꞌ</para>
  <para style="mt">HEBREO</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">Xinꞌ Dios mblirsinꞌ Dios sa mni Xaꞌ lo men</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Axta pol toza, naꞌr tozla gob nde naꞌr toz mod mni Dios lo re xaꞌ gox lonꞌ ngo pola nde mblirsinꞌ Xaꞌ re profet lo mni Xaꞌ, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />per naya, lenꞌ re wiz lulka reꞌ, Dios mblirsinꞌ Xinꞌ Xaꞌ lo mni Xaꞌ lonꞌ. Xinꞌ Xaꞌ mblirsinꞌ Xaꞌ sa mdoxkwaꞌ reta jwanꞌ nzi lo beꞌ nde lo izyo nde lo Xinꞌ Xaꞌ mdayaꞌ Xaꞌ retey. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Xinꞌ Dios nak xni nde yalnaro jwanꞌ nak Dios, nde Xaꞌ ndloꞌ dibto jwanꞌ nak Dios, nde kon yalne chanꞌ xkiꞌs Xaꞌ ndenkeꞌ Xaꞌ reta jwanꞌ. Nde ngolo mtombi Xaꞌ naꞌ lo xken naꞌ, seraꞌ mdob Xaꞌ lad ban Dios lo beꞌ, <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />jwanꞌ nasa mas ntak le Xaꞌ lo re anj, tak yalnyebeꞌ jwanꞌ mkayaꞌ Xaꞌ mas naroy ke lo re anj.<verse eid="HEB 1:4" /></para>
  <para style="s1">Mas ntak Xinꞌ Dios lo re anj</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Tak nek thib gob nanchabta Dios lo thi anj:</para>
  <para style="q" vid="HEB 1:5">“Lu nak Xinꞌ na,</para>
  <para style="q" vid="HEB 1:5">na mbli sa nzoa naya,<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt"><ref loc="PSA 2:7">Sal. 2:7</ref>.</char></note>”</para>
  <para style="m" vid="HEB 1:5">nekla nchab Dios lo thi anj:</para>
  <para style="q" vid="HEB 1:5">“Na ak Xud la,</para>
  <para style="q" vid="HEB 1:5">nde lu ak xinꞌ na.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">2 Samuel 7:14 </char></note>”<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Mbay lo mtelꞌ Dios Xinꞌ ner Dios lo izyo, nchab Dios:</para>
  <para style="q" vid="HEB 1:6">“Reta goꞌ anj chanꞌ Dios ptoxub goꞌ lo Xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Dt 32:43</char></note>”<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Nde lo ndej Dios re anj, nchab Dios:</para>
  <para style="q" vid="HEB 1:7">“Dios ndli sa re anj Xaꞌ nak xaja mbi ba,</para>
  <para style="q" vid="HEB 1:7">Nde re anj jwanꞌ ndli sinꞌ lo Dios nak xaja bela.<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Sal. 104:4</char></note>”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Per lo ndej Dios Xinꞌ Dios, nchab Xaꞌ:</para>
  <para style="q" vid="HEB 1:8">Dios, dib adiꞌ nyebeꞌa,</para>
  <para style="q" vid="HEB 1:8">Nde galꞌ tir nyebeꞌa.<verse eid="HEB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 1:9" />Ndyen la re jwanꞌ galꞌ nde ngiꞌnoa jwanꞌ narax,</para>
  <para style="q" vid="HEB 1:9">Jwanꞌ nasa Dios jwanꞌ ta nak Dios la mpchub Xaꞌ aseit yek la,</para>
  <para style="q" vid="HEB 1:9">mas mblo nale Xaꞌ lazoꞌa, ke lo temas xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Sal. 45:6,7</char></note><verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Nde nchabaꞌ Dios lo Xinꞌ Xaꞌ:</para>
  <para style="q" vid="HEB 1:10">Lu Xaꞌ Nyebeꞌ, senꞌ mdobte ner reta jwanꞌ, mdoxkwaꞌa izyo,</para>
  <para style="q" vid="HEB 1:10">nde yub la mdoxkwaꞌ be ba.<verse eid="HEB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 1:11" />Reta jwanꞌ ná tluxa, per lu thipka naban la.</para>
  <para style="q" vid="HEB 1:11">Retey, xaja nchaꞌx lara gaxa;<verse eid="HEB 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 1:12" />xaja nkiꞌs men lara kiꞌsley,</para>
  <para style="q" vid="HEB 1:12">ta xa ntseꞌ men lara ta tseꞌley.</para>
  <para style="q" vid="HEB 1:12">Per lu, nanzyeꞌt la,</para>
  <para style="q" vid="HEB 1:12">nde lu, naꞌluxta la.<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Sal.102:25-27</char></note><verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Mbay, ¿cho lo thi anja nchab Dios:</para>
  <para style="q" vid="HEB 1:13">Ptob lad ban na,</para>
  <para style="q" vid="HEB 1:13">axta kebeꞌ yix na re xaꞌ ngiꞌnoa, sa xaꞌ ak jwanꞌ tyob nia?<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Sal. 110:1</char></note><verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Tak reta anj nak xbi jwanꞌ benꞌta ndli sinꞌ lo Dios, nde Dios ntelꞌ xaꞌ sa laꞌsto xaꞌ reta men jwanꞌ kayaꞌ yalnaban adiꞌ.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Naro toz nak tolaꞌ Dios naꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Jwanꞌ nasa nakinꞌ mas jwin tob nzanꞌ reta jwanꞌ mbin naꞌ, tak nday na naxlanꞌ xned Dios. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Tak tez re xkiꞌs Dios jwanꞌ mdej re anj nanzyeꞌdey, nde reta men jwanꞌ mpchixlaꞌy nde naꞌnxoꞌbyekta xaꞌy mbriꞌdka xaꞌ pen jwanꞌ nzalꞌ xaꞌ. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />¿Xamodka lyaꞌ naꞌ tez naꞌkenapta naꞌ jwanꞌ naro toz nak, ta mtolaꞌ Dios naꞌ ba? Tak jwanꞌ reꞌ yub Jesús Xaꞌ Nyebeꞌ mdej nera, nde xisa seraꞌ reta xaꞌ jwanꞌ mbina, mdej xaꞌy lonꞌ ke ligay, <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />nde nogaꞌ Dios mdej Xaꞌ ke liy, kon reta yalnaro, re yalbzeꞌye, reta jwanꞌ nzoyen men nde kon re xaꞌxaꞌ jwanꞌ ndaꞌ Mbi Nayon chanꞌ Dios a xaja ncholaꞌs Xaꞌ.<verse eid="HEB 2:4" /></para>
  <para style="s">Jesus nak Xaꞌ ntolaꞌ naꞌ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Tak Dios namtanꞌta lo re anj, sa nyebe' xa' izyo kub jwan' nara' ye'd, jwan' ta ndotej ná' ba. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Tak nzo thib lad lo xkiꞌs Dios tenꞌ nchab thi xaꞌ:</para>
  <para style="q" vid="HEB 2:6">¿Cho nak men sa ntelaꞌs la men?</para>
  <para style="q" vid="HEB 2:6">O ¿Cho nak xinꞌ men sa ndetnaa xaꞌ?<verse eid="HEB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 2:7" />Tud nalaxa mdoxkwaꞌa men ke lo re anj,</para>
  <para style="q" vid="HEB 2:7">mbli naroa xaꞌ nde mdaꞌa yalnaro lo xaꞌ,</para>
  <para style="q" vid="HEB 2:7">nde mtob la xaꞌ nyebeꞌ xaꞌ lo reta jwanꞌ mdoxkwaꞌa,<verse eid="HEB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 2:8" />Reta jwanꞌ mdayaꞌa lo xaꞌ sa nyebeꞌ xaꞌy.<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Sal.8:4-6</char></note></para>
  <para style="m" vid="HEB 2:8">Jwanꞌ nasa lo mdaꞌ Dios reta jwanꞌ sa nyebeꞌ xaꞌ loneꞌy, re nak tira mdaꞌ Dios nyebeꞌ xaꞌ, per tera wiꞌ naꞌ nyebeꞌ xaꞌ lo reta jwanꞌ. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Per xaꞌ jwanꞌ ta lud tyemp nalaxa mtanꞌ Dios ke lo re anja, xaꞌ ya nak Jesús, mbli naro Dios Xaꞌ nde wen mbwiꞌ Dios Xaꞌ, lo nguj Xaꞌ por men. Tak lo nkeꞌ lazoꞌ Dios men, Jesus nguj por reta men.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Tak Dios, Xaꞌ jwanꞌ ta mdoxkwaꞌ reta jwanꞌ nde ndli sa nzo retay, ncholaꞌs Xaꞌ ya bro thoz xinꞌ Xaꞌ lo xni chanꞌ Xaꞌ, jwanꞌ nasa mbli Xaꞌ sa mbriꞌd Jesucrist re yalti, sa yanꞌ Jesucrist Xaꞌ galꞌ, tak Jesucrist nak Xaꞌ ntolaꞌ reta men. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Tak leꞌy re men nchak nayon nde leꞌy Jesus jwanꞌ ndli nayon re men, thipta tenꞌ nde re xaꞌ. Jwanꞌ nasa, nandyolaꞌsta Jesus ni Xaꞌ re men ya wes Xaꞌ nde ptanꞌ xaꞌ. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Lo nchab Xaꞌ:</para>
  <para style="q" vid="HEB 2:12">Tej na kwent chanꞌ la lo reta wes na,</para>
  <para style="q" vid="HEB 2:12">nde xij tenꞌ ndyop reta xaꞌ, gol na diꞌs wen loa.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Sal.22:22</char></note><verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Nde nchaba Xaꞌ:</para>
  <para style="q" vid="HEB 2:13">Lo Dios ndob xgab na.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Isaías 8:17</char></note></para>
  <para style="m" vid="HEB 2:13">Nde tedibaꞌ gob nchab Xaꞌ:</para>
  <para style="q" vid="HEB 2:13">Ncheꞌ ndon kon reta mdyenꞌ jwanꞌ mdaꞌ Dios lon.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Isaías 8:18</char></note><verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Lo ta belꞌ nde ren naksaꞌ re mdyenꞌ, noga Jesus belꞌ nde ren ngok Xaꞌ sa toyal gaj Xaꞌ, sa lo nguj Xaꞌ ya, mbli Xaꞌ gan lo xaꞌ nyebeꞌ lo yalguj, xaꞌ ya nak maxuꞌ. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />Nde lo ta nguj Jesus, mtolaꞌ Xaꞌ reta men jwanꞌ dib naban xaꞌ nzyeb xaꞌ gaj xaꞌ. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Tak galꞌ diꞌs, nambyeꞌdlaꞌstod Xaꞌ re anj, leꞌ Xaꞌ mbyeꞌd sa laꞌsto Xaꞌ reta men jwanꞌ nde lo bin Abraham. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Jwanꞌ nasa nakinꞌka ngok Xaꞌ xa naka reta mena, sa ak Xaꞌ thi nglweyꞌ ro jwanꞌ xa ncholaꞌs Dios, jwanꞌ ndli xa nchab xkiꞌs Dios nde lat lazoꞌ Xaꞌ reta men, sa tonꞌ Xaꞌ xken reta men yez Dios. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Tak lo yub Xaꞌ mbriꞌd re ned yalti nde ncholaꞌs jwanꞌ narax tokana Xaꞌ, jwanꞌ nasa naya tak laꞌsto Xaꞌ re men jwanꞌ nketokan jwanꞌ narax.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Mas ntak Jesus ke lo Moises</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Jwanꞌ nasa wes na nde ptanꞌ na, men nayon chanꞌ Dios, mbrez Dios goꞌ sa ak goꞌ men chanꞌ Dios, ne ptob goꞌ xgab goꞌ lo jwanꞌ mbli Jesus, Xaꞌ nak Xaꞌ mtelꞌ Dios nde Xaꞌ nak nglweyꞌ ro lo jwanꞌ ta ndli lazonꞌ ba. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Jesus mblì Xaꞌ xata nchab Dios lo Xaꞌ, Dios jwan' ta mblí Xaꞌ, ta xa mblì Moises jwanꞌ nchab Dios lo Moises, lo reta men yez Dios. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Tak mas ntak Jesus ke lo Moises, ta xa mas ntak thi xaꞌ ntaꞌ thi yo ke leꞌga yo jwanꞌ mtaꞌ xaꞌ. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Nde reta yo ba nzo thi men mtaꞌy, per Dios mdoxkwaꞌ reta jwanꞌ. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Galꞌ diꞌs Moises mxoꞌbyek xaꞌ reta jwanꞌ nchab Dios lo xaꞌ, lo mbli xaꞌ sinꞌ lo Dios, sa tej xaꞌ jwanꞌ ncholaꞌs Dios gab Dios lo re men liz Dios. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Mbay leꞌ Crist lo nak Xaꞌ Xinꞌ Dios thiblaꞌ ndo Xaꞌ lo re men liz Dios, jwanꞌ nak re naꞌ reꞌ, tezka thiblaꞌ ne ndo naꞌ lo jwanꞌ ndli lazonꞌ nde thiblaꞌ ne tob xgab naꞌ lo jwanꞌ nkembed naꞌ.<verse eid="HEB 3:6" /></para>
  <para style="s">Ryoꞌxkwen men yez Dios</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Jwanꞌ nasa, ta xa ne Mbi Nayon:</para>
  <para style="q" vid="HEB 3:7">Tez naya gon goꞌ jwanꞌ ndoni Dios,<verse eid="HEB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 3:8" />naꞌlined lazoꞌ goꞌ lo Dios ta xa ngok ne lazoꞌ re xaꞌ naꞌngonta diꞌs ro Dios pola</para>
  <para style="q" vid="HEB 3:8">nde mblibeꞌ xaꞌ Dios lad izyo nagan.<verse eid="HEB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 3:9" />Tya mblibeꞌ re xaꞌ gox lo goꞌ na pola,</para>
  <para style="q" vid="HEB 3:9">teꞌnyega dib lenꞌ choꞌ linꞌ mbwiꞌ xaꞌ reta jwanꞌ mblin.<verse eid="HEB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 3:10" />Tamod sa mxi lazoꞌn mbwiꞌn re men ngo tyemp ya,</para>
  <para style="q" vid="HEB 3:10">nde nchab na: "Thiblaꞌ ngan xgab xaꞌ,</para>
  <para style="q" vid="HEB 3:10">nde nancholaꞌsta xaꞌ yo xaꞌ lo xned na."<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Sal.95:7-11</char></note><verse eid="HEB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 3:11" />Jwanꞌ nasa lo xyan ya mkeyek na,</para>
  <para style="q" vid="HEB 3:11">naꞌyoted xaꞌ tenꞌ ngenon ryoꞌxkwen xaꞌ.<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Wes na, ptanꞌ na, nda wiꞌ thoz goꞌ, sa nek thib goꞌ naꞌlyad jwanꞌ narax lazonꞌ, nde kay diꞌs li lazoꞌ goꞌ Dios nde bike tij goꞌ lo Dios nabana. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Cheꞌla reta wiz ptobeꞌ goꞌ yek ta goꞌ, naya ta benꞌ nzo tyemp reꞌ, sa nek thib goꞌ naꞌakned lazonꞌ nde gab goꞌ lo yalkwinꞌ chanꞌ jwanꞌ narax. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Tak nogaꞌ naꞌ thita nak naꞌ kon Crist, tezka thiblaꞌ tob naꞌ xgab naꞌ lo jwanꞌ ndli lazonꞌ, ta xa mbli lazoꞌ neꞌy lo senꞌ mdobte ner naꞌ, tagaꞌ li lazoꞌ neꞌy axta lulka.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Ta xa nchabka lo xkiꞌs Dios:</para>
  <para style="q" vid="HEB 3:15">Tez naya gon goꞌ jwanꞌ ndoni Dios,</para>
  <para style="q" vid="HEB 3:15">naꞌlined lazoꞌ goꞌ lo Dios ta xa ngok ne lazoꞌ re xaꞌ naꞌngonta diꞌs ro Dios pola.<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">Sal.95:7,8</char></note><verse eid="HEB 3:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="HEB 3:16" />Mbay, ¿cho re xaꞌ ta teꞌnye mbin xaꞌ jwanꞌ nchab Dios nde mtoxi xaꞌ lazoꞌ Dios saꞌ? ¿Cho naꞌnaktey reta xaꞌ ta mbloꞌte Moises lo xyon Egipto yaꞌ? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Mbay, ¿kon cho re xaꞌ ngonaxi lazoꞌ Dios dib lenꞌ choꞌ linꞌ naꞌ? ¿Cho naꞌnaktey kon re xaꞌ ta mbli jwanꞌ narax ta nguj izyo nagan nay? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Nde ¿cho lo xaꞌ mkeyek Dios naꞌyoted xaꞌ tenꞌ ryoꞌxkwen xaꞌ ya? ¿Cho naꞌnaktey lo re xaꞌ ta naꞌngonta diꞌs say? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Nde ncheꞌya ngwinꞌ naya naꞌndlid xaꞌ gan ngate xaꞌ tya, tak naꞌndlid lazoꞌ xaꞌ Dios.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Naya lo ta benꞌ nzo jwanꞌ mkeyek Dios yotenꞌ tenꞌ taꞌ Dios ryoꞌxkwen naꞌ, pkenap goꞌ lazoꞌ goꞌ, tak ndaga na, nzo thib goꞌ naꞌlid gan yote tya. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Tak noga lonꞌ mbyaj diꞌs wen xa mdej Diosa lo xaꞌ, per ngen cho sinꞌ ndliy lo xaꞌ mbin xaꞌy, tak na'ndlid lazoꞌ xaꞌy. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Per reta naꞌ jwanꞌ ta mbli lazoꞌ neꞌy, naya toyal yotenꞌ tenꞌ ryoꞌxkwen naꞌ, per re xaꞌ naꞌndlid lazoꞌ neꞌy, ta xa nchabka Dios:</para>
  <para style="q" vid="HEB 4:3">Jwanꞌ nasa lo ta mxi lazoꞌn mkeꞌyek na,</para>
  <para style="q" vid="HEB 4:3">naꞌyoted xaꞌ tenꞌ ngenon ryoꞌxkwen xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Sal. 95:11</char></note></para>
  <para style="m" vid="HEB 4:3">Teꞌnyega mnela reta rsinꞌ Xaꞌ ta mdoxkwaꞌ Xaꞌ izyo, <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />tak thib lad cheꞌmod nchab lo xkiꞌs Dios lo ndeja wiz gaz:</para>
  <para style="q" vid="HEB 4:4">Lenꞌ wiz gaz mbroꞌxkwen Dios lo reta rsinꞌ Xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Gen.2:2</char></note><verse eid="HEB 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="HEB 4:5" />Nde nchaba lo xkiꞌs Dios tedib gob ncheꞌ ya:</para>
  <para style="q" vid="HEB 4:5">Naꞌyoted xaꞌ tenꞌ ngenon ryoꞌxkwen xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Sal.95:11</char></note><verse eid="HEB 4:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 4:6" />Per tata benꞌ nchak jwad yote tipla xaꞌ tenꞌ ryoꞌxkwen xaꞌ, mbay leꞌ lo xaꞌ jwanꞌ mbyaj ner re diꞌs wen ya, naꞌngated xaꞌ tenꞌ ryoꞌxkwen xaꞌ, tak naꞌnxobyekta xaꞌy. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Jwanꞌ nasa bere mdaꞌ Dios thi wiz nde wiz ya nak naya, nde bro toz tyemp mbriꞌd lo mdej Xaꞌy lo David, senꞌ nchab Xaꞌ:</para>
  <para style="q" vid="HEB 4:7">Tez naya gon goꞌ jwanꞌ ndoni Dios,</para>
  <para style="q" vid="HEB 4:7">naꞌlined lazoꞌ goꞌ.<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Sal.95:7,8</char></note><verse eid="HEB 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />Tak tez ngaka Josue ndaꞌ tenꞌ ndroꞌxkwen xaꞌ, pa tejraꞌ Dios tediba wiz. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Jwanꞌ nasa benꞌ nzo ti tenꞌ taꞌ Dios ryoꞌxkwen re men yez Dios. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Tak xaꞌ jwanꞌ ngote tenꞌ ryoꞌxkwen xaꞌ lo Dios, noga ryoꞌxkwen xaꞌ lo reta rsinꞌ xaꞌ, ta xa mbroꞌxkwen Dios lo re rsinꞌ Dios. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Jwanꞌ nasa ndablo chal naꞌ yotenꞌ tya, sa naꞌtyakta naꞌ jwanꞌ mxak reta xaꞌ ta naꞌngonta diꞌsa.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Tak xkiꞌs Dios nabana, nchapa yalne nde nchaꞌda axta tenꞌ mas naꞌs lenꞌ lazoꞌ men, nde lenꞌ xbin men, nchaꞌda axta tenꞌ nzota re sij men nde axta naꞌs lenꞌ re sij men, nde ngoxyoy reta xgab nzo yek men nde reta jwanꞌ nzo lazoꞌ men ta ncholaꞌs men li men, ta xa nak thi espad jwanꞌ nale rop lad lonꞌ. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Ngen cho thi jwanꞌ mdoxkwaꞌ Dios liy gan kaꞌsloy lo Dios, cheꞌla reta jwanꞌ ndloꞌxaꞌy lo Dios, lo Dios jwanꞌ ta tayaꞌ reta men kwent lonꞌ ya.<verse eid="HEB 4:13" /></para>
  <para style="s">Jesus nak nglweyꞌ ro ntak toz</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Lo ta ngenonꞌ thi nglweyꞌ ro ntak toz jwanꞌ nak Jesús Xinꞌ Dios, Xaꞌ jwanꞌ ta ngote lo beꞌ ba, jwanꞌ nasa, ndablo thibla ne tyonꞌ lo jwanꞌ ndli lazonꞌ. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Tak ngenonꞌ thi nglweyꞌ ro jwanꞌ tak lat lazoꞌ Xaꞌ naꞌ, lo re jwanꞌ narax ta ncholaꞌsa tokana naꞌ, tak nogaꞌ Xaꞌ mbriꞌd lo re jwanꞌ na, per nekthib jwanꞌ narax naꞌndlid Xaꞌ. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Jwanꞌ nasa, dib laꞌs, bikenꞌ tenꞌ ndob Dios nyebe' Xaꞌ, sa lat lazoꞌ Xaꞌ naꞌ lo yalwen chanꞌ Xaꞌ, sa laꞌsto Xaꞌ naꞌ senꞌ nakinꞌ naꞌ Xaꞌ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Tak reta nglweyꞌ ro, xij men reꞌ mblí Dios xaꞌ, nde sinꞌ nakà xaꞌ nak, tyo xaꞌ lo Dios kwent chanꞌ men sa taꞌ xaꞌ re jwanꞌ yon lo Dios nde kuj xaꞌ maꞌ taꞌ xaꞌ lo Dios sa yax xken men. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Nde naꞌyoched lazoꞌ xaꞌ re men nanchenta nde re xaꞌ ngetetab lo xned Dios, tak nogaꞌ xaꞌ men nak xaꞌ nde ndriꞌd xaꞌ reta jwanꞌ ndriꞌdka re mena. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Nde jwanꞌ nasa ndablo kuj xaꞌ maꞌ taꞌ xaꞌ lo Dios, por xken xaꞌ nde por xken reta men.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Nde ngen cho thi men leꞌga leꞌ ak xaꞌ nglweyꞌ ro, benꞌta xaꞌ jwanꞌ mbrez Dios nkayaꞌ sinꞌ ya, ta xa mbrez Dios Aaron. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Tagaꞌ Crist nanakta leꞌga leꞌ mbli naro Xaꞌ lazoꞌ Xaꞌ sa nak Xaꞌ nglweyꞌ ro, cheꞌla Dios mbli naro Xaꞌ sa nak Xaꞌy lo nchab Dios lo Xaꞌ:</para>
  <para style="q" vid="HEB 5:5">Lu nak Xinꞌ na,</para>
  <para style="q" vid="HEB 5:5">na mbli sa nzoa naya.<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">Sal. 2:7.</char></note><verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Nde ta xa nchab tedibaꞌ lad lo xkiꞌs Dios:</para>
  <para style="q" vid="HEB 5:6">Lu nak nglweyꞌ dib tyemp,</para>
  <para style="q" vid="HEB 5:6">ta xa ngok Melquisedec nglweyꞌ.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt"><ref loc="PSA 110:4">Sal. 110:4</ref>.</char></note><verse eid="HEB 5:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 5:7" />Nde senꞌ mkete Crist lo izyo reꞌ xajka mena, jwanꞌ toz mdodiꞌsno Xaꞌ Dios, ne mbrez Xaꞌ mnaꞌb Xaꞌ lo Dios nde mbinꞌ Xaꞌ lo Dios, Dios jwanꞌ toyal tolaꞌ Xaꞌ lo yalguj, mbin Dios xkiꞌs Xaꞌ tak mxobyek Xaꞌ Dios. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Teꞌnyega Xinꞌ Dios nak Xa', per lo reta yalti jwanꞌ mbriꞌd Xaꞌ, mteꞌd Xaꞌ mxoꞌbyek Xaꞌ Dios, <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />nde lo nawe tir mbyanꞌ Xaꞌ lo Dios, tamod ngolal Xaꞌ, Xaꞌ jwanꞌ tolaꞌ adiꞌ reta men jwanꞌ nxoꞌbyek Dios. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Nde Dios mtanꞌ Xaꞌ sa nak Xaꞌ nglweyꞌ ro ta xa ngok Melquisedec nglweyꞌ.<verse eid="HEB 5:10" /></para>
  <para style="s">Nathoz naka laꞌ men xkiꞌs Dios</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Mbay lo jwanꞌ reꞌ nzo toz jwanꞌ tej náꞌ lo goꞌ, nde nagana par náꞌ koꞌxkan náꞌy, tak tsowꞌ thoz nchen goꞌ. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Ndablola ak goꞌ maestr loꞌ goꞌ xkiꞌs Dios, tak ndala nzolo goꞌ xkiꞌs Dios, per cheꞌla nakinꞌ goꞌ bere loꞌ náꞌ reta jwanꞌ mas nambi nchab lo xkiꞌs Dios lo goꞌ. Tak cheꞌ ngolal goꞌ xaja thi mbed jwanꞌ nakinꞌ gu nisa nde naꞌakta war, ta nak goꞌ. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Nde re men jwanꞌ nak xaja nak mbed ta benꞌ nchuꞌ nisa, naꞌlid xaꞌ gan yen xaꞌ jwanꞌ galꞌ, tak xa nak mbed nak xaꞌ. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Leꞌ re men jwanꞌ ngola xgab naꞌ lo xkiꞌs Dios, mnea xaꞌ kwan nak jwanꞌ wen nde kwan nak jwanꞌ narax, ta xa nak men jwanꞌ nchala re ned jwanꞌ.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Jwanꞌ nasa, naꞌbixnod naꞌ leꞌga re jwanꞌ mteꞌd ner naꞌ lo chanꞌ Crist, ndablo thibla xyen naꞌ axta ke ak na men ngol xgab naꞌ lo xkiꞌs Dios. Naꞌberetra naꞌ lo re jwanꞌ mteꞌd ner naꞌ, nandabloda bere teꞌd naꞌ xomod laꞌ naꞌ re jwanꞌ narax nde xomod li lazoꞌ naꞌ Dios, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />nde tagaꞌ xa nak jwanꞌ ryoꞌle men, xa nak jwanꞌ xoꞌb xaꞌ yaꞌ xaꞌ yek men, xa leꞌ re xaꞌ nguj ryoꞌxban nde xa nyaꞌb Dios kwent nyenꞌ cho ya pen adiꞌ. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Jwanꞌ nasa thipka toteꞌd náꞌ goꞌ sa ak goꞌ men ngol xgab naꞌ, tez Dios taꞌ diꞌs.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Tak naꞌtyoxkwaꞌtraꞌ re men jwanꞌ mtoxnila Dios lonꞌ nde mkayala xaꞌ re jwanꞌ nde lo beꞌ ndalaꞌs Dios lo xaꞌ nde tagaꞌ mkayala xaꞌ Mbi Nayon, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />nde tagaꞌ mbyolo xaꞌ xa wen nak xkiꞌs Dios nde mbwiꞌ xaꞌ xa nak yalne chanꞌ Dios jwanꞌ nara yeꞌd, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />nde laꞌ xaꞌ, nalitra lazoꞌ xaꞌ xkiꞌs Dios, naꞌtoyaltraꞌ zyeꞌ xgab xaꞌ laꞌ xaꞌ re jwanꞌ narax, tak bere ngekeꞌ nakub xaꞌ Xinꞌ Dios lo kruz nde ngegoꞌ yantho xaꞌ Xinꞌ Dios lo reta men. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Re men ndli lazoꞌn xkiꞌs Dios nak, xa nak izyo jwanꞌ nawe thoz ngeꞌ nit senꞌ ndlya yi ba, nde nawe thoz nchak jwanꞌ na lo men jwanꞌ ngobina, yalwen chanꞌ Dios nkaya xaꞌ ya. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Mbay leꞌ izyo jwanꞌ benꞌta ya yis nde lus yis ndlyen, naꞌngen cho sinꞌ liy, mbyenla ke dey nde yola.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Mbay teꞌnye ta mbez náꞌ, per nanaktey lo goꞌ wes náꞌ, ptanꞌ náꞌ, jwanꞌ nkeꞌ thoz lazoꞌ náꞌ, mnepaꞌ náꞌ lo ned wen nzo goꞋ ta tolaꞌ Dios goꞌ lo xken goꞌ. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Tak galꞌ nak Dios nde naꞌrita Xaꞌ yek Xaꞌ reta sinꞌ mbli goꞌ lo Xaꞌ nde xa ndloꞌ nkeꞌ lazoꞌ goꞌ Xaꞌ, tak mbli goꞌ sinꞌ lo re men yez nayon chanꞌ Xaꞌ nde xa benꞌ nge li goꞌy naya. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Per ncholaꞌs náꞌ ke kad thibaꞌ goꞌ tagaꞌ dib naban goꞌ thiblaꞌ ta bli goꞌ, axta kebeꞌ akpaꞌ jwanꞌ ngembed goꞌ. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Naꞌzyaꞌbta goꞌ, cheꞌla bli goꞌ reta jwanꞌ ndli re men jwanꞌ ndli lazonꞌ Dios nde nanchoched lazoꞌ xaꞌ nkembed xaꞌ kayaꞌ xaꞌ reta jwanꞌ mkeyek Dios taꞌ Dios lo xaꞌ.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Tak lo senꞌ mkeꞌyek Dios jwanꞌ li Dios lo Abraham, leꞌga leꞌ Xaꞌ mtobro Xaꞌ tak naꞌngetraꞌ cho mas naro lo Xaꞌ tobro Xaꞌ, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />nde nchab Dios lo Abraham: "Li tirpaꞌ, jwanꞌ toz li leyꞌ na lu, nde lin sa jwanꞌ toz yaꞌr men lo bin la."<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">Gen.22:17</char></note> <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Nde lo nangoched lazoꞌ Abraham mbled xaꞌ, mkayaꞌga xaꞌ reta jwanꞌ mkeꞌyek Dios lo xaꞌ. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Lo senꞌ thi mena nkeꞌyek xaꞌ li xaꞌ thi jwanꞌ, thi men mas ntak lo xaꞌ ntobro xaꞌ, sa li lazoꞌ men, li xaꞌ jwanꞌ ta ndej xaꞌ ya. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Tamod sa, Dios ncholaꞌs loꞌ lo re men jwanꞌ kayaꞌ re jwanꞌ mkeꞌyek Dios taꞌ Dios, ke namzyeꞌd nek luda, jwanꞌ nasa leꞌga leꞌ Dios mtobro Dios lo mdej Diosa. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Sa por rop jwanꞌ reꞌ naꞌnyeda zyeꞌy, xkiꞌs Dios jwanꞌ mdaꞌ Dios nde jwanꞌ mkeꞌyek Dios, nde mnenꞌ nankwinꞌta Dios. Jwanꞌ nasa re naꞌ jwanꞌ mbike lo Dios kone lazonꞌ, thibla tob naꞌ xgab naꞌ lo jwanꞌ ngembed naꞌ. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Jwanꞌ ta ngembed naꞌ reꞌ ndli sa ne ndo xbin na' nde ngencho jwan' li wina, ta xa nak yiꞌb jwanꞌ ndyentob bark, tagaꞌ jwanꞌ reꞌ ndenkeꞌy men axta tenꞌ nke lar nayon toz tir, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />tenꞌ ngote Jesus por naꞌ sa mxalꞌ xaꞌ ned lonꞌ. Tamod sa dib tyemp nak Jesus nglweyꞌ ro lonꞌ, ta xa ngok Melquisedec nglweyꞌ.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Jesus nak nglweyꞌ xa nak Melquisedec</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Melquisedec reꞌ ngok rey yez Salem, nde tagaꞌ ngok xaꞌ nglweyꞌ lo Dios ro. Senꞌ mbere Abraham ngwakeꞌ Abraham byo nde mbli Abraham gan lo temas rey, mbroꞌ xaꞌ ned lo Abraham nde mbli leyꞌ xaꞌ Abraham, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />nde lo xaꞌ mdaꞌ Abraham reta diezmo<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">thi part lo tsi' part</char></note> chanꞌ reta jwanꞌ mbli Abraham gan lo byo. Nde le Melquisedec nak Rey ndli jwanꞌ galꞌ, Rey yez Salem, nde diꞌs ya nak Rey nda yalnabeꞌz. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Ngencho nye cho ngok xud xaꞌ, nekla cho ngok xnaꞌ xaꞌ, ngencho nye plo nde lo bin xaꞌ, neka nye men pol ngol xaꞌ nde pol nguj xaꞌ, xa nak Xinꞌ Dios nak xaꞌ, dib adiꞌ nak xaꞌ nglweyꞌ.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Naya bwiꞌ goꞌ nea, plopa naro ntak Melquisedec jwanꞌ nasa axta yub Abraham, xaꞌ gox lonꞌ ta ngo pola, mdaꞌ dyezmo chanꞌ reta jwanꞌ ta mbli xaꞌ gan lo byo ya, lo xaꞌ. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Nde liga, re men jwanꞌ nde lo bin Levi xaꞌ jwanꞌ nak nglweyꞌ, re xaꞌ ya, mnebeꞌ ley kayaꞌ xaꞌ reta dyezmo chanꞌ reta xaꞌ ta xaꞌ, teꞌnyega thita lo bin Abraham nde re xaꞌ. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Per Melquisedec teꞌnyega nanded xaꞌ lo bin Levi, mkayaꞌ xaꞌ dyezmo jwanꞌ mdaꞌ Abraham, nde mbli leyꞌ xaꞌ Abraham, Abraham jwanꞌ ta mdaꞌa Dios xkiꞌs Dios lonꞌ, li leyꞌ Dios sa. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Mbay naya ta mnea naꞌ, leꞌ xaꞌ jwanꞌ ndli leyꞌ men, xaꞌ ya mas ntak ke lo xaꞌ jwanꞌ nchak leyꞌ. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Naya, galꞌ diꞌs re nglweyꞌ jwanꞌ nkayaꞌ dyezmo lo izyo reꞌ, tagaꞌ men nak xaꞌ nde taj xaꞌ xaga naꞌ reꞌ, per lo xkiꞌs Dios nchaj Melquisedec xaja thi xaꞌ benꞌ nabana xaꞌ. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Jwanꞌ nasa toyal gab naꞌ na, lo mdaꞌ Abraham dyezmo lo Melquisedeca, nogaꞌ dyezmo chanꞌ Levi nda tya, Levi jwanꞌ ta nkayaꞌ reta dyezmo naya, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />tak lo senꞌ mbroꞌ Melquisedec ned lo Abraham, tera gal Levi, benꞌ nzo xaꞌ lad xud xaꞌ Abraham.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Re xaꞌ Israel mkayaꞌ xaꞌ ley, sa re xaꞌ nde lo bin Levi ak xaꞌ nglweyꞌ, mbay tez liga por re ngwleyꞌ ya ndli sa galꞌ ngak re men jwanꞌ nxobyek ley, nanakinꞌtraꞌ ngyeꞌd tedib nglweyꞌ, cheꞌla mbyeꞌd thi nglweyꞌ jwanꞌ xa ngok Melquisedec jwanꞌ nanded lo bin Aaron. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Tak lo mzyeꞌ lo bin xaꞌ nak nglweyꞌ, tagaꞌ nakinꞌ zyeꞌ ley. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Mbay Jesus, xaꞌ ta nak nglweyꞌ ndej xkiꞌs Dios reꞌ, tedibaꞌ lo bin xinꞌ Israel nde xaꞌ, nde lo bin ya, nekthib xaꞌ nangokta nglweyꞌ. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Tak cheꞌ mne naꞌ leꞌ Jesus Xaꞌ Nyebeꞌ lonꞌ, nde lo bin Juda, mbay na lo bin Juda namdejta Moises ak xaꞌ nglweyꞌ.<verse eid="HEB 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Jwanꞌ reꞌ mas nambi mbroꞌxkana, tak nglweyꞌ kub ta mbroꞌto reꞌ, xa nak Melquisedec nak xaꞌ, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />xaꞌ reꞌ nangokta nglweyꞌ jwanꞌ xa ndej ley nyenꞌ cho lo bin ndablo ryoꞌ nglweyꞌ, cheꞌla leꞌ Xaꞌ ngok nglweyꞌ tak Dios mbloꞌ Xaꞌ, nde ngeno Xaꞌ yalne chanꞌ yalnaban adiꞌ. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Tak jwanꞌ reꞌ ndej Dios nak Xaꞌ:</para>
  <para style="q" vid="HEB 7:17">Lu nak nglweyꞌ dib tyemp,</para>
  <para style="q" vid="HEB 7:17">ta xa ngok Melquisedec nglweyꞌ.<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">Sal.110:4</char></note><verse eid="HEB 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 7:18" />Jwanꞌ nasa mbroꞌtal ley nera, tak nalay nde naꞌlitra sinꞌ na. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Tak ley naꞌndlidey gan ndli galꞌ la nekthib men. Mbay jwanꞌ ngembed naꞌ naya mas jwina, nde leꞌy ndli sa mbike gax naꞌ lo Dios.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Nde jwanꞌ reꞌ ngoka, leꞌga leꞌ yub Dios mtobro Dios. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Lo mbloꞌ Dios tedib ned nglweyꞌ ya namtobrod Xaꞌ nek thib jwanꞌ, per Jesus ngolal nglweyꞌ, por jwanꞌ ta mtobro Dios mdaꞌ Dios xkiꞌs Dios, tak lo xkiꞌs Dios nchab:</para>
  <para style="q" vid="HEB 7:21">Lo jwanꞌ nkeyek Dios naꞌntseꞌd Xaꞌ xgab Xaꞌ:</para>
  <para style="q" vid="HEB 7:21">“Lu nak nglweyꞌ dib tyemp,</para>
  <para style="q" vid="HEB 7:21">ta xa ngok Melquisedec nglweyꞌ.”<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false">Sal.110:4</char></note><verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Jwanꞌ nasa mnenꞌ ke por Jesus mas jwin nak jwanꞌ mkeyek Dios, kon jwanꞌ mbli Xaꞌ por re men, ke lo jwanꞌ neraꞌ. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />Leꞌ tedib ned nglweyꞌ ya, naꞌr toz xaꞌ ngo, tak lo nchaj xaꞌ nakinꞌ tediba xaꞌ kayaꞌ rsinꞌ xaꞌ, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />mbay nglweyꞌ reꞌ, lo ta thiptane naban Xaꞌ, nanakintra tayaꞌ Xaꞌ rsinꞌ Xaꞌ lo tedib nglweyꞌ. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Jwanꞌ nasa tli Xaꞌ gan thipta gob nde thiptane tolaꞌ Xaꞌ reta men jwanꞌ mbike lo Dios por Xaꞌ, tak thiptane naban Xaꞌ sa nyaꞌb Xaꞌ lo Dios por re men ya.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Tak thi nglweyꞌ ro jwanꞌ tapaꞌ naka nakinꞌ naꞌ: Nayon Xaꞌ, nanzobta xken Xaꞌ, naꞌlud namblid Xaꞌ jwanꞌ narax, nde natsalꞌtad Xaꞌ re xaꞌ ndli jwanꞌ narax nde mas gap ndob Xaꞌ ke lo beꞌ. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Nanakinꞌta Xaꞌ li Xaꞌ, xa ndli tedib ned nglweyꞌ ro ba, rejaꞌ wiz nerla nguj xaꞌ maꞌ sa dyonꞌ xken xaꞌ, seraꞌ kuj xaꞌ maꞌ sa dyonꞌ xken reta men yez, mbay leꞌ nglweyꞌ ro reꞌ na, leꞌ mdayaꞌ Xaꞌ lazoꞌ Xaꞌ, thib gobta nguj Xaꞌ nde dib tyemp ndli sinꞌ na. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Leꞌ ley chanꞌ Moises leꞌga leꞌ re men nzoꞌb xkena ba ndlilala nglweyꞌ ro, per xis ta nzola leya, Dios mtobro mtanꞌ Dios Xinꞌ Dios ak nglweyꞌ ro, nde thiptane galꞌ nak Xaꞌ.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Jesus nak nglweyꞌ lo jwanꞌ nakub mkeꞌ yek Dios lonꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Mbay naya, jwanꞌ mas ntak lo re jwanꞌ ngetej náꞌ reꞌ nak, ngenonꞌ thi nglweyꞌ ro jwanꞌ ndob lad ban Dios tenꞌ nyebeꞌ Dios lo beꞌ, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />nde Xaꞌ ndli sinꞌ xaga jwanꞌ ndli nglweyꞌ, tenꞌ nakpa yodoꞌ jwanꞌ yub Dios mdoxkwaꞌ jwanꞌ namdoxkwaꞌda men. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Reta nglweyꞌ ro, ndo xaꞌ sa leꞌ xaꞌ taꞌ gon nde kuj xaꞌ maꞌ lo Dios, jwanꞌ nasa nakinꞌ no Jesucrist ndablo keno Xaꞌ jwanꞌ taꞌ Xaꞌ lo Dios. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Tez ngaka lo izyo reꞌ nzo Xaꞌ nekla ngak xaꞌ nglweyꞌ, tak izyo reꞌ nzola re nglweyꞌ jwanꞌ ndaꞌ jwanꞌ yon xa nyebeꞌ ley chanꞌ Moises. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Per re nglweyꞌ jwanꞌ nzo lo izyo reꞌ, lo yodoꞌ jwanꞌ ta ndli xaꞌ sinꞌ na, xkal nde xim re jwanꞌ nzo lo beꞌ naka, ta xa nchabka Dios lo Moises lo toxkwaꞌ xaꞌ tenꞌ nayona: "Jwin bwiꞌ nea, ptoxkwaꞌ reta jwanꞌ xata nak jwanꞌ mbloꞌn loa lo ndoa yek yiꞌ ya." <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Mbay sinꞌ jwanꞌ nakà Xaꞌ nak nglweyꞌ ro lonꞌ, mas ntaka, tak jwanꞌ mbli Xaꞌ mas jwina lo re jwanꞌ mkeyek ner Dios lonꞌ, lo ta ndo Xaꞌ xtowꞌ Dios nde men, jwanꞌ reꞌ nak jwanꞌ kub nde mas ntak re jwanꞌ ndenoy.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Tak tez jwanꞌ tá mkeyek ner Dios ngen kwan ngak jwad lo neꞌy, nanakinꞌtra nkeyek Xaꞌ tedib jwanꞌ brop. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Per lo mbwiꞌ Dios ke nagalꞌta nak re men ya, nchab Dios lo xaꞌ:</para>
  <para style="q" vid="HEB 8:8">Tsin thi wiz, ne Dios,</para>
  <para style="q" vid="HEB 8:8">nakub keyek na tan xkiꞌs na lo re men yez Israel nde lo re men yez Juda.<verse eid="HEB 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 8:9" />Jwanꞌ ta keyek na reꞌ naꞌaktey xa nak jwanꞌ mkeyek na lo re xaꞌ gox lo goꞌ ngo pola,</para>
  <para style="q" vid="HEB 8:9">wiz jwanꞌ mxen na yaꞌ xaꞌ nde mbloꞌten xaꞌ xyon Egipto,</para>
  <para style="q" vid="HEB 8:9">nde lo naꞌndlid xaꞌ jwanꞌ nchab na lo xaꞌ,</para>
  <para style="q" vid="HEB 8:9">jwanꞌ nasa mblan xaꞌ, ne Dios.<verse eid="HEB 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 8:10" />Jwanꞌ nasa jwanꞌ reꞌ ak jwanꞌ keyek na lo re men liz Israel ngolo mbriꞌd re wiz ya, ne Xaꞌ Nyebeꞌ:</para>
  <para style="q" vid="HEB 8:10">lenꞌ yek xaꞌ gon reta ley chanꞌ na,</para>
  <para style="q" vid="HEB 8:10">nde lenꞌ lazoꞌ xaꞌ keꞌ ney.</para>
  <para style="q" vid="HEB 8:10">Na ak Dios xaꞌ,</para>
  <para style="q" vid="HEB 8:10">nde xaꞌ ak men yez na.<verse eid="HEB 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 8:11" />Nde nanakinꞌtra loꞌ xaꞌ xkiꞌs na lo ta xaꞌ,</para>
  <para style="q" vid="HEB 8:11">nde ngentra cho gab lo wes naꞌ: byolo Dios,</para>
  <para style="q" vid="HEB 8:11">tak reta men yolo xaꞌ na,</para>
  <para style="q" vid="HEB 8:11">xata men jwanꞌ mas lud ntak nde axta men mas bro ntak.<verse eid="HEB 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 8:12" />Ton na reta jwanꞌ narax mbli xaꞌ,</para>
  <para style="q" vid="HEB 8:12">nde naꞌtelaꞌstra na reta yalke mbli xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">Jer. 31:31-34</char></note><verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />Lo senꞌ ndej Dios ke nakub mkeyek Xaꞌ xkiꞌs Xaꞌ, jwanꞌna nak ke mbroꞌtal jwanꞌ mkeyek ner Xaꞌ, tak naꞌlitra sinꞌ jwanꞌ na, mer lux xa.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Yodoꞌ lo izyo reꞌ nde yodoꞌ lo beꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Mbay bwiꞌ goꞌ nea, axta jwanꞌ ta mkeyek ner Dios, ngenoy modneꞌy xamod li men kult lo Dios nde thi tenꞌ li men kult lo Dios lo izyo reꞌ. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Leꞌ yo yida cheꞌ mod naktsaꞌ lenꞌ ney: Tenꞌ yote ner nglweyꞌ ndole Tenꞌ Nayon, tya ndoli kandil ndob ninꞌ, nde ndo mes jwanꞌ nzi pan yon lonꞌ. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Nde xis tenꞌ nge lar brop lenꞌ yo yida, tya ndole Tenꞌ Nayon toz tir, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />tya ndaꞌb thi jwanꞌ nchol xtarak naktsaꞌ or, nde tyaga nzoꞌb kaj jwanꞌ mdaꞌ Dios xkiꞌs Dios jwanꞌ dib lad naꞌ nadaꞌb or. Lenꞌ kaja nzo thi pseꞌ or jwanꞌ nzo mana<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="fq" closed="false">mana </char><char style="ft" closed="false">mana nak: comid nde lo be'</char></note>, tagaꞌ lenꞌ kaj nzo yagan Aaron jwanꞌ ta mblen mbeda nde tya nzo rop ke naba jwanꞌ nge ley chanꞌ Dios. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Xis kaj nziꞌb chop kerubin ndob xilꞌ naꞌ, jwanꞌ na ndloꞌ ke tya ndo Dios, nde kon xilꞌ xaꞌ ya nkot xaꞌ tap xis kaj, tenꞌ ntonꞌ Dios xken men. Per naya, naꞌakta tej jwin náꞌ xomodpa nak re jwanꞌ reꞌ.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Lo ta nzitsaꞌla reta jwanꞌ na, reta wiz nchote re nglweyꞌ, tenꞌ nchote ner xaꞌ lenꞌ yo yida, sa li xaꞌ rsinꞌ xaꞌ lo Dios. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Per, xis tenꞌ nke lar brop lenꞌ yo yida, tya nchote benꞌta nglweyꞌ ro kad linꞌ, nde senꞌ nchote xaꞌ, ndablo we xaꞌ ren maꞌ taꞌ xaꞌ sa dyonꞌ xken xaꞌ nde xken reta men yez, re yalke jwanꞌ naꞌnyed xaꞌ mbli xaꞌ. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Kon jwanꞌ reꞌ ndloꞌ Mbi Nayon lonꞌ ke laja benꞌ nchak rsinꞌ tenꞌ nayona, naꞌnyeda xyalꞌ ned sin men tenꞌ nayon toz tira. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Reta jwanꞌ reꞌ ndloꞌy lonꞌ nal tyemp reꞌ ke reta jwanꞌ yon ndaꞌ men lo Dios nde re maꞌ nguj men lo Dios tya, naꞌlidey gan tombiy xgab men, re men jwanꞌ tamod nxobyek xaꞌ Dios. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Tak benꞌta ndeja jwanꞌ ncha men nde jwanꞌ nchuꞌ men nde xamod ak nambi belꞌ men, per jwanꞌ reꞌ benꞌ ndli sinꞌ na laja teraꞌ tseꞌ Dios re jwanꞌ na.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Per naya mbyeꞌdla Crist nde Xaꞌ nak nglweyꞌ ro chanꞌ reta jwanꞌ wen ta nzo naya. Leꞌ tenꞌ nayon ndli Crist sinꞌ naya mas naxut nde mas galꞌ naka nde namenta mtaꞌy, gab men na, nanaktey jwanꞌ lo izyo reꞌ. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Nde nanakta kon ren re chib teꞌ nde ren re ngon yenꞌ, cheꞌla kon yub ren Xaꞌ ngote Xaꞌ tenꞌ nayon toz tir. Thiptane nde thipta gob ngote Xaꞌ tya, nde tamod thiptane mxi Xaꞌ naꞌ. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Tezka ren re ngon teꞌ, ren re chib teꞌ nde di mbroꞌ lo mbyol re ngon gol yenꞌ, di ya nchub xaꞌy yek re men nzoꞌb xken naꞌ, re jwanꞌ na ndli sa benꞌ aꞌ xis nchak nambi xaꞌ. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Choleꞌta ren Crist mas ntaka, tak Mbi Nayon naban adiꞌ mbli sa leꞌ mdayaꞌ Xaꞌ lazoꞌ Xaꞌ lo Dios, sa gaj Xaꞌ tak nambi laꞌs Xaꞌ, nde ren Xaꞌ tombiy naꞌ lo re xgab narax ndononꞌ, jwanꞌ ncheꞌ naꞌ lo yalguj, sa toyal linꞌ sinꞌ lo Dios nabana.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Jwanꞌ nasa Jesucrist nak thi Xaꞌ ndo xtowꞌ Dios nde men, lo jwanꞌ ta nakub mkeyek Dios lo re men, sa lo ta nguj Crist dyonꞌ reta xken men jwanꞌ mbli men lo nzo men lo jwanꞌ ta mkeyek ner Dios, sa reta men jwanꞌ mbrez Dios, kayaꞌ men jwanꞌ adiꞌ, ta mkeyek Dios taꞌ Dios. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Tak lo senꞌ nzoꞌb thi yeꞌs par kayaꞌ men thi jwanꞌ mtanꞌ xaꞌ lo men, nakinꞌ axta nguj xaꞌ ta mtanꞌ jwanꞌ lo mena, zyara toyal kayaꞌ men chanꞌ xaꞌ. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Tak laja naban xaꞌ ya, nalida sinꞌ yeꞌs ta mtanꞌ xaꞌ ya, axta kebeꞌ nguj xaꞌ, sa ntaka. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Jwanꞌ nasa, nogaꞌ lo jwanꞌ mkeyek ner Dios, mtanꞌ Dios gaj maꞌ sa ryoꞌ ren maꞌ, sa ntaka. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Tak ngolo mdej Moises lo reta men jwanꞌ mnabeꞌ Dios nge lo ley, mxen Moises yis naren mbakxilꞌ kon thi xod ya ndole hisopo nde mxen Moises ren re ngon yenꞌ nde ren re chib teꞌ nos nit mpchub Moisesa xis yeꞌs nge ley nde tagaꞌ mpchub Moises ren lo reta men, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />nde nchab Moises: “Ren reꞌ loꞌ sa nye goꞌ ke mdaꞌa Dios ley Dios lo goꞌ sa xoꞌbyek goꞌy.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Nde tagaꞌ mpchub Moises ren lenꞌ yo yid nde xis reta jwanꞌ ndlirsinꞌ xaꞌ nzi lenꞌ yo ya. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Nde xa nchab lo ley, chub ren xis reta jwanꞌ sa ak nambiy nde tez naꞌgajta maꞌ par ryoꞌ ren, naꞌdyonꞌta xken men.<verse eid="HEB 9:22" /></para>
  <para style="s">Lo nguj Crist ndyonꞌ xken men</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Jwanꞌ nasa nakinꞌka gaj re maꞌ, sa ren maꞌ ak nambi jwanꞌ izyo reꞌ, re jwanꞌ ta nak xkal re jwanꞌ nzo lo beꞌ ba, mbay leꞌ re jwanꞌ nzopa lo beꞌ nakinꞌka ak nambiy kon yalguj chanꞌ thi xaꞌ mas jwin ntak ke lo maꞌ. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Tak Crist nangoted Xaꞌ lenꞌ tenꞌ nayon jwanꞌ mdoxkwaꞌ mena, jwanꞌ ta nak benꞌta thi xkal jwanꞌ ndob lo beꞌ, cheꞌla Crist ngote merpa lo beꞌ, sa naya ndo Xaꞌ lo Dios nde ngenaꞌb Xaꞌ por reta naꞌ. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Mbay Crist namdayaꞌd Xaꞌ lazoꞌ Xaꞌ sa gaj Xaꞌ naꞌr gob, ta xa nchote re nglweyꞌ ro tenꞌ nayon toz tir kad linꞌ, kon ren jwanꞌ nanakta ren nglweyꞌ. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Tezka ta naka, naꞌr toz gob ndablo ngaj Crist axta xata mdoxkwaꞌ izyo. Per natad naka, naya lo ta ngoxoꞌb wiza, mbyeꞌd Crist thipta gob nde thiptane, na leꞌ mdayaꞌ lazoꞌ Xaꞌ nguj Xaꞌ sa dyonꞌ xken reta men. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Ta xa mbyanꞌla par reta men, thibta gob gaj men nde xisa nyaꞌb Dios kwent lo reta men, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />tagaꞌ Crist thibta gob mdaꞌya lazoꞌ Xaꞌ nguj Xaꞌ, sa dyonꞌ xken bro toz men. Xisa bere yeꞌd Xaꞌ brop gob, per naꞌyedtonꞌta xaꞌ xken men, leꞌ Xaꞌ yeꞌd sa tolaꞌ Xaꞌ reta men jwanꞌ ndyen toz nkembed yeꞌd Xaꞌ.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Tak ley chanꞌ Moisés ben'ta thi xkal chanꞌ re jwanꞌ nara taꞌ Dios naka, nde nanaktey xa nyapa re jwanꞌ na. Jwanꞌ nasa nalid ley gan ak galꞌ reta men jwanꞌ dib lenꞌ linꞌ nde linꞌ kon linꞌ mbike xaꞌ lo Dios sa tatka mod kuj xaꞌ re maꞌ taꞌ xaꞌ lo Dios. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Tez ngaka ley ndli gan ngak nambi xaꞌ lo xken xaꞌ, pa thiblaꞌ kuj xaꞌ maꞌ dib lenꞌ linꞌ nde linꞌ kon linꞌ taꞌ xaꞌ lo Dios, tak thiptane mbi xaꞌ lo xken xaꞌ nde naꞌtentraꞌ xaꞌ nzoꞌb xken xaꞌ. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Nde lo ta nchuj xaꞌ maꞌ kad linꞌ na, benꞌ ndli sinꞌ na, sa telaꞌs xaꞌ re xken xaꞌ, <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />tak ren re ngon nde ren re chib teꞌ naꞌlidey gan tombiy men lo reta xken men.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Jwanꞌ nasa lo senꞌ mbyeꞌd Crist lo izyo nchab Crist lo Dios:</para>
  <para style="q" vid="HEB 10:5">Nancholasta la gaj maꞌ tan loa neka ncholaꞌs la jwanꞌ yon,</para>
  <para style="q" vid="HEB 10:5">cheꞌla mdaꞌa lon nak na thi men.<verse eid="HEB 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 10:6" />Nandryoꞌd lazoꞌa kuj xaꞌ maꞌ tolꞌ xaꞌ loa, neꞌka re jwanꞌ yon ndaꞌ xaꞌ loa sa yax xken xaꞌ.<verse eid="HEB 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 10:7" />Jwanꞌ nasa nchab na: “Ncheꞌya ndal na, sa lin jwanꞌ ncholaꞌs la Dios na,</para>
  <para style="q" vid="HEB 10:7">ta xa ngeniga lo xkiꞌs la lo ndeja na.”<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Sal.40:6-8</char></note><verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Jwanꞌ ner ndoteja nak nandryoꞌd lazoꞌa gaj maꞌ ta men loa, neka re jwanꞌ yon ndaꞌ men loa nde neka kuj men maꞌ tolꞌ men loa nde nancholasta la re jwanꞌ yon ndaꞌ men sa dyonꞌ xken men, teꞌnyega re jwanꞌ na nyebeꞌ ley li men. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Nde noga ndoteja: “Ncheꞌya ndal na sa lin jwanꞌ ncholaꞌs la Dios na.” Mkib Xaꞌ jwanꞌ ner nak ley sa mtanꞌ Xaꞌ jwanꞌ brop reꞌ. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Dios mbli nayon Xa' naꞌ, lo ta mbli Jesucrist xata ncholaꞌs Dios, lo mdayaꞌ Xaꞌ lazoꞌ Xaꞌ sa nguj Xaꞌ por xken reta men, thipta gob nde thiptane.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Galꞌ diꞌs re nglweyꞌ a reja wiz ndli xaꞌ rsinꞌ xaꞌ, naꞌr thoz gob athipka nchuj xaꞌ re ma' ndaꞌ xaꞌ lo Dios, teꞌnyega natombid maꞌ men lo re xken men. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Mbay na Crist, thipta gob mdayaꞌ lazoꞌ Xaꞌ nguj Xaꞌ sa thiptane mbi men lo xken men, nde xisa mdob Xaꞌ a lad ban Dios. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Tya ndob mbed Xaꞌ, axta kebeꞌ li Dios sa re xa' nayi' lo Xa' ak xis jwan' tyob ni Xa'. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Tak thipta gob mdayaꞌ lazoꞌ Xaꞌ nguj Xaꞌ, sa thiptane mbli galꞌ Xaꞌ re men nayon chanꞌ Dios. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Nde mnenꞌ li jwanꞌ reꞌ, tak yub Mbi Nayon ndeja lo nchab Xaꞌ:<verse eid="HEB 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HEB 10:16" />Jwanꞌ reꞌ nak jwanꞌ keꞌyek na lo xaꞌ, ngolo mbriꞌd re wiz ya, ne Xaꞌ Nyebeꞌ:</para>
  <para style="q" vid="HEB 10:16">Lenꞌ lazoꞌ re men keꞌn ley na,</para>
  <para style="q" vid="HEB 10:16">nde goney lenꞌ yek xa'.<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Nde nchaba Xaꞌ:</para>
  <para style="q" vid="HEB 10:17">Nek lud naꞌtelastra' na reta yalke mbli xaꞌ nekla re jwanꞌ narax mbli xaꞌ.<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Tak senꞌ mdyonꞌla re xken men, nanakinꞌtraꞌ taꞌ men mas yon lo Dios sa dyonꞌ xken men.<verse eid="HEB 10:18" /></para>
  <para style="s">Ndablo bike gax naꞌ lo Dios</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Jwanꞌ nasa wes na, ptanꞌ na, toyal dib laꞌs yotenꞌ tenꞌ nayon toz tir, por ren Jesus, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />por ned kub nde ned nzo yalnaban ta mxalꞌ Xaꞌ lo mched lar nge tenꞌ nayon lenꞌ yodoꞌ lo ta nguj Xaꞌ ya. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Nde ngenonꞌ thi nglweyꞌ ro ntak toz jwanꞌ ndli sinꞌ liz Dios, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />jwanꞌ nasa dib nzo lazonꞌ bikenꞌ lo Dios nde dib nzo lazonꞌ li lazonꞌ Dios, nde mbila lazon' lo re xgab narax nde dib ben na mbyach kon nit nambi. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Thiblaꞌ ne tyonꞌ nde naꞌakropta xgab na' lo jwanꞌ ngembed naꞌ, tak liga li Dios re xkiꞌs Dios jwanꞌ mdaꞌ Dios lonꞌ. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Nde chal naꞌ sa la'stonꞌ wes na' nde ptan' na', sa masraꞌ keꞌ lazonꞌ tan' nde linꞌ jwanꞌ wen. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Naꞌlaꞌd naꞌ yanꞌ tenꞌ ndyopbenꞌ kon re xaꞌ ndli lazonꞌ Dios, ta xa ndli ti pla xaꞌ ta nden mod ya, cheꞌla ko nale men, lazoꞌ ta men, masta, nal ta mnenꞌ ke leꞌ wiz yeꞌd Jesucrist ndosin gaxla.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Tak tez tatka sinꞌ leꞌ ngelinꞌ re jwanꞌ narax, lo ta mbyoloa naꞌ jwanꞌ lí, naꞌngentra cho gaj sa dyonꞌ re xken naꞌ. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Che'la ngembed naꞌ pen toz senꞌ nyaꞌb Dios kwent lonꞌ nde bel ndoblaꞌb tenꞌ ya re xaꞌ nginoꞌ Dios. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Lo senꞌ thi men ngiꞌs ley chanꞌ Moises, tez diꞌs ro chop men o tson men jwan' mbwi'y nde koꞌxob jwanꞌ mbli xaꞌ ya, naꞌlata lazoꞌ xaꞌ men ya a ndabloga gaj xaꞌ. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Choleꞌta xaꞌ nchixlaꞌ Xinꞌ Dios, ngotal xaꞌ ren Xinꞌ Dios, ren jwanꞌ mbli mbyanꞌ jwanꞌ mkeꞌyek Dios, nde ren jwanꞌ mbli sa mbi xaꞌ, nde nixin xaꞌ xis Mbi Nayon jwanꞌ nkeꞌ lazoꞌ xaꞌ, ¿plopa mas bro pen rid xaꞌ ya? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Tak mnenꞌ ke Dios nchab: "Na gota re jwan mbli xaꞌ, na li sa kix xaꞌ re jwanꞌ mbli xaꞌ."<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false">Dt.32:35</char></note> Nde nchaba Dios: "Dios nyaꞌb kwent lo reta men yez Dios."<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false">Dt.32:36</char></note> <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />¡Nathoz toz tir naka gab men lo pen nzo lo yaꞌ Dios naban na!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Per ptelaꞌs goꞌ re jwanꞌ mbriꞌd goꞌ nera, lo senꞌ ngolo mbyolo goꞌ xkiꞌs Dios, mxek goꞌ ne mdo goꞌ lo mbriꞌd goꞌ lo re yalti toz. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Nzo pla goꞌ mbrezno xaꞌ goꞌ nde mtoti xaꞌ goꞌ, mbroꞌ yantho goꞌ xij re men, nde nzo pla goꞌ mblaꞌsto re men jwanꞌ tagaꞌ ndorid re yalti ya. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Mblat lazoꞌ goꞌ re men jwanꞌ nge lizyiꞌb, mbay lo mkib xaꞌ jwanꞌ ngeno goꞌ nale nzo lazoꞌ goꞌ, tak mne goꞌ ke lo beꞌ ngeno goꞌ thi jwanꞌ mas ntak nde nandluxta. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Jwanꞌ nasa naꞌtabta goꞌ xgab goꞌ lo Dios, tak jwanꞌ na li sa li goꞌ gan thi jwanꞌ ntak toz. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Nakinꞌ nayoched lazoꞌ goꞌ, sa lo ngolo mbli goꞌ jwanꞌ ncholaꞌs Dios, kayaꞌ goꞌ jwanꞌ mkeyek Dios lo goꞌ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Tak lo xkiꞌs Dios nchab:</para>
  <para style="q" vid="HEB 10:37">Mbyenla, mbyentirla,</para>
  <para style="q" vid="HEB 10:37">yeꞌd Xaꞌ ndablo yeꞌd nde naꞌlyenꞌta Xaꞌ.<verse eid="HEB 10:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="HEB 10:38" />Mbay re men galꞌ ndo lon, lo ndli lazoꞌ xaꞌ na, ban xaꞌ,</para>
  <para style="q" vid="HEB 10:38">per tez laꞌ xaꞌ naꞌlid lazoꞌ xaꞌ na, naꞌyowenta lazoꞌn wiꞌn xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false">Hab.2:3,4</char></note><verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Per naꞌ nanakta naꞌ xa nak men mbere aꞌ xis sa ya pen, cheꞌla thiblaꞌ ndli lazonꞌ Dios sa lyaꞌ xbin naꞌ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Re men jwanꞌ mbli lazonꞌ Dios</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Mbay naya na, jwanꞌ ta ndli lazoꞌ men Dios nak mnepa men ke liga kayaꞌ men jwanꞌ ngembed men, teꞌnye nangwi'd mena per mnepa men ke liga nzoy nde taka. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Tak lo mbli lazoꞌ re xaꞌ gox lonꞌ ngo pola Dios, tamod sa wen mbwiꞌ Dios xaꞌ.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Tak lo ndli lazonꞌ Dios nchen naꞌ ke xkiꞌs Dios mbli sa mdoxkwaꞌ beꞌ nde izyo, tamod sa jwanꞌ ngwinꞌ naya mdoxkwaꞌy kon re jwanꞌ nangwiꞌd men.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Tak lo mbli lazoꞌ Abel Dios, jwanꞌ nasa mas nawe nyaꞌ maꞌ mbij Abel mdaꞌ Abel lo Dios ke jwanꞌ mdaꞌ Cain, tamod sa mbyanꞌ Abel men galꞌ lo Dios nde mbroꞌ lazoꞌ Dios jwanꞌ yon mdaꞌ Abel. Nde teꞌnyega ngujla Abel benꞌ ndloꞌy lonꞌ xa mbli lazo' Abel Dios.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Tak lo mbli lazoꞌ Enoc Dios jwanꞌ nasa naban xaꞌ mbeꞌ Dios xaꞌ nde nangujta xaꞌ, nde naꞌngazalta men xaꞌ tak Dios mbe xaꞌ, per lo senꞌ teraꞌ we Dios xaꞌ ya, lo xkiꞌs Dios nchab, mbroꞌ lazoꞌ Dios mod nak xaꞌ. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Per tez nandlid lazoꞌ men Dios naꞌlid men gan lin men jwanꞌ ndryoꞌ lazoꞌ Xaꞌ, tak men nyekeꞌ lo Dios ndablo li lazoꞌ men ke nzo Xaꞌ, nde Xaꞌ taꞌ jwanꞌ mzalꞌ re men jwanꞌ nkwanꞌ Xaꞌ.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Tak lo mbli lazoꞌ Noe Dios, jwanꞌ nasa mdej Dios re jwanꞌ nangwiꞌd xaꞌ nchak, mpseb lazoꞌ Noe nde mdoxkwaꞌ xaꞌ thi bark sa lyaꞌ xaꞌ kon reta men liz xaꞌ. Nde taga lo mbli lazoꞌ Noe Dios, lo jwanꞌ na mbloꞌ xaꞌ ke reta men nzo lo izyo mzalꞌ xaꞌ ya xaꞌ pen, nde mbyanꞌ Noe men galꞌ lo Dios tak mbli lazoꞌ xaꞌ Dios.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Tak lo mbli lazoꞌ Abraham Dios, senꞌ mbrez Dios xaꞌ, mbin xaꞌ diꞌs ro Dios, mbroꞌ xaꞌ tya nda xaꞌ tenꞌ kayaꞌ xaꞌ ak chanꞌ xaꞌ. Mbroꞌte xaꞌ las xaꞌ teꞌnye naꞌnyed xaꞌ plo nda xaꞌ. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Tak lo mbli lazoꞌ xaꞌ Dios, jwanꞌ nasa ngo xaꞌ xajka men thib lada izyo tenꞌ mkeyek Dios taꞌ Dios lo xaꞌ ak chanꞌ xaꞌ. Nde yo yid ngok liz xaꞌ, tagaꞌ yo yid ngo Isac nde Jacob, jwanꞌ nogaꞌ mkeyek Dios lo xaꞌ, izyo ya ak chanꞌ xaꞌ. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Tak Abraham ngembed yo yez jwanꞌ ne naksaꞌ xanꞌ na, yez jwanꞌ yub Dios mdixsaꞌ nde mdoxkwaꞌy.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Tagaꞌ tak lo mbli lazoꞌ xaꞌ Dios, axta yub Sar, teꞌnyega men nij xaꞌ, Dios mblaꞌsto xaꞌ, sa kelo xinꞌ xaꞌ nde mxan xaꞌ thi mbed senꞌ ngox tozla xaꞌ, tak mbli lazoꞌ xaꞌ ke liga tli Xaꞌ ta mdaꞌ xkiꞌs naꞌ ya jwanꞌ nchab Xaꞌ lo xaꞌ. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Jwanꞌ nasa, Abraham, thi xaꞌ gox thoz naꞌaktraꞌ taꞌ mbed, mkeno xaꞌ xinꞌ xaꞌ nde mbyaꞌr lo bin xaꞌ nde ngen cho ak lab men lo bin xaꞌ, xaja re mbel nzi lo beꞌ ba nde xaja yux ta nzi ro nittoꞌ ba re xaꞌ.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Reta men ya nguj xaꞌ nde naꞌnkayaꞌd xaꞌ reta jwanꞌ mkeyek Dios taꞌ Dios lo xaꞌ, nde lo ta mbli lazoꞌ xaꞌ Dios benꞌta tij mbwiꞌ xaꞌy, per mbli lazoꞌ xaꞌ tkayaꞌga xaꞌy tak mne xaꞌ ke xaꞌ thib lad xaꞌ nde benꞌ nderidndaꞌb xaꞌ xis izyo reꞌ. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Re men jwanꞌ ta ndodiꞌsa, ndloꞌpaꞌ ke tata benꞌ ngete kwanꞌ xaꞌ tenꞌ ak lazpa xaꞌ. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Tez ngaka izyo jwanꞌ mbroꞌ xaꞌ ya nzoyek xaꞌ ak laz xaꞌ, cheꞌ ngyen lo xaꞌ mbere xaꞌ tya. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Per leꞌ xaꞌ ndyablaꞌs thi tenꞌ mas jwin ak laz xaꞌ, lo beꞌ ncholaꞌs xaꞌ ak laz xaꞌ. Jwanꞌ nasa nandyolaꞌsta Dios, nak Dios, Dios xaꞌ, takꞌ mdoxkwaꞌla Dios thi yez tenꞌ ak laz xaꞌ.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Tak lo mbli lazoꞌ Abraham Dios senꞌ mblibeꞌ Dios xaꞌ, nde mxen xaꞌ Isaac sa kuj xaꞌ or lo Dios, mxoꞌbyek xaꞌ mdaꞌ xaꞌ thibnya xinꞌ xaꞌ gaj, tenꞌnyega Dios mdaꞌ xkiꞌs Dios lo xaꞌ, nchab Dios: <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />"Por Isaac yaꞌr men lo bin la."<note caller="+" style="f"><char style="fr" closed="false">11:18 </char><char style="ft" closed="false">Gen. 21:12</char></note> <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Tak Abraham mne ke Dios ngeno yalne sa koꞌxban Dios re men nguj, nde mkayaꞌ Abraham Isaac tedib gob, jwanꞌ re nak, xajka Dios mbloꞌxban Isaac.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Tak lo mbli lazoꞌ Isaac Dios jwanꞌ nasa mbli leyꞌ xaꞌ rop xinꞌ xaꞌ Jacob kon Esau, mdej xaꞌ re jwanꞌ nara li Dios. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Tak lo mbli lazoꞌ Jacob Dios, jwanꞌ nasa senꞌ mer gaj xaꞌ mbli leyꞌ xaꞌ rop xinꞌ Jose nde mxoꞌbkoꞌ xaꞌ yek yagan xaꞌ, mbli naro xaꞌ le Dios. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Tak lo mbli lazoꞌ Jose Dios, jwanꞌ nasa lo ndayajla xaꞌ mdej xaꞌ ke reta men nde lo bin Israel ryoꞌte xaꞌ Egipto nde mtanꞌ xaꞌ diꞌs jwanꞌ lino xaꞌ zij xaꞌ.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Tak lo mbli lazoꞌ xud Moises nde xnaꞌ Moises Dios, jwanꞌ nasa lo senꞌ ngol or mkaꞌs xaꞌ or son mbeꞌ, tak mbwiꞌ xaꞌ nawe nyar, namzyebta xaꞌ jwanꞌ mnebeꞌ rey ta ndablo gaj re mbed biꞌ. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Tak lo mbli lazoꞌ Moises Dios, jwanꞌ nasa lo senꞌ ngolal xaꞌ, naꞌndoyalta xaꞌ ngak xaꞌ xinꞌ ngol xinꞌ Faraon, <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />cheꞌla mblí xaꞌ thita rid xaꞌ yalti kon men yez Dios, ke li xaꞌ jwanꞌ narax, koꞌ xil xaꞌ lazoꞌ xaꞌ lud tyemp lo re jwanꞌ ndryoꞌ lazoꞌ belꞌ xaꞌ. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Mbwiꞌ xaꞌ ke mas ntak rid xaꞌ yalti, xajkaꞌ mbriꞌd Xaꞌ mtelꞌ Dios, ke keno xaꞌ re jwanꞌ ntak ngeno re xaꞌ Egipto, tak leꞌ xaꞌ nketoblo re jwanꞌ taꞌ Dios ka xaꞌ. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Tak lo mbli lazoꞌ Moises Dios, jwanꞌ nasa nanzyebta xaꞌ ak nayiꞌ rey, mbroꞌte xaꞌ Egipto nde thiblaꞌ ne mdo xaꞌ lo xgab xaꞌ, xajka men ndowiꞌpa Dios jwanꞌ naꞌakta wiꞌ men.<verse eid="HEB 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 11:28" />Tak lo mbli lazoꞌ Moises Dios, jwanꞌ nasa mbli Moises Pask nde mnebeꞌ Moises sa mpchub xaꞌ ren ro re yala liz xaꞌ, sa naꞌgalta anj nyebeꞌ lo yalguj re xinꞌ biꞌ ner re xaꞌ Israel. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Tak lo mbli lazoꞌ re xaꞌ Israel Dios, jwanꞌ nasa mbriꞌd xaꞌ Nittoꞌ Nane, xaja men ndriꞌd izyo biza, nde lo senꞌ ncholaꞌs re xaꞌ Egipto tagaꞌ rid xaꞌ, ngwap xaꞌ nit.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Tak lo mbli lazoꞌ re xaꞌ Israel Dios, jwanꞌ nasa ngob pto jwanꞌ nowꞌ yez Jerico, lo senꞌ ngoxoꞌb gaz wiꞌz mbyek xaꞌ dibta lad yez. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Tak lo mbli lazoꞌ Rahab Dios, ngol jwanꞌ ntho lad naꞌ, jwanꞌ nasa naꞌngajta ngol kon re men jwanꞌ ne yek naꞌ, tak nabeꞌz mdaꞌ ngol liz ngol mkaslo re xaꞌ Israel, xaꞌ jwanꞌ ngwalaꞌs yez Jerico.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />¿Kwanraꞌ mas nin lo goꞌ? Naꞌgalta tyemp tez tej na kwent chanꞌ Gedeon, kwent chanꞌ Barac, kwent chanꞌ Sanson, kwent chanꞌ Jefte, kwent chanꞌ David, jwanꞌ mbli Samuel nde kwent chanꞌ reta profet. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Tak lo mbli lazoꞌ xaꞌ Dios, mbli xaꞌ gan byo lo re naꞌr ned yez, mbli xaꞌ jwanꞌ galꞌ, nde mbwiꞌ xaꞌ ngok re jwanꞌ nchab Dios lo xaꞌ, mtowꞌ xaꞌ re ro mbeꞌs, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />ngo xaꞌ lo bel thoz tir nde ngen kwan ngate xaꞌ nde mtolaꞌ lazoꞌ xaꞌ lo kuj men xaꞌ kon espad, ngo ne lazoꞌ xaꞌ senꞌ mas nalà nzo lazoꞌ xaꞌ, naꞌndlayod lazoꞌ xaꞌ nde mbli xaꞌ gan byo, mtoxonꞌ xaꞌ re sondad xaꞌga yez. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Ngo pla re men got mbroꞌ xban ta xaꞌ.</para>
  <para style="p" vid="HEB 11:35">Ngo pla xaꞌ nguj lo pen nde naꞌndoyalta xaꞌ ndlaꞌ xaꞌ xaꞌ, tak leꞌ xaꞌ ngembed ryoꞌxban xaꞌ, sa naꞌgajtra xaꞌ. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Ti pla xaꞌ mxino men xaꞌ, mdin men xaꞌ, mkeꞌ lizyiꞌb men xaꞌ nde axta mdobo men xaꞌ kon kaden. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Nzo xaꞌ mbwadke men xaꞌ nguj xa', mchoꞌbroꞌ xaꞌ xaꞌ kon syer, mblibeꞌ xaꞌ xaꞌ. Nzo xaꞌ mbij xaꞌ kon espad, andoja plo mkete xonꞌ xaꞌ, yid mbakxilꞌ nde yid chib ngok xab xaꞌ, mbwiꞌ xaꞌ yalprob, nalat mxak xaꞌ nde mtoti men xaꞌ. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Reta men lo izyo reꞌ nanzalꞌta xaꞌ yo xaꞌ kon re xaꞌ ta ndli lazonꞌ Dios sa, mkete xaꞌ re izyo nagan, lenꞌ wana, re lenꞌ yeꞌr xanꞌ ke ba nde re yeꞌr lenꞌ izyo ba ngo xaꞌ. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />Reta xaꞌ ya, teꞌnyega mbloꞌpaꞌ mbli lazoꞌ xaꞌ Dios, naꞌnkayad xaꞌ jwanꞌ nchab Dios taꞌ Dios lo xaꞌ, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />tak Dios ngeno xgab jwanꞌ mas jwin par naꞌ, sa nanakta benꞌta xaꞌ ya yanꞌ men galꞌ, noga naꞌ thita yanꞌ naꞌ men galꞌ kon re xaꞌ ya.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Nyekenꞌ lo Jesus</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Jwanꞌ nasa lo ta ngenonꞌ men thoz tir jwanꞌ mblipa lazo xaꞌ Dios, jwanꞌ nasa laꞌ naꞌ reta jwanꞌ ntowꞌ lonꞌ nde laꞌ naꞌ reta jwanꞌ narax ta nka diꞌs linꞌ jwanꞌ wen, chal naꞌ taꞌ naꞌ goba nde naꞌyoched lazonꞌ tyonꞌ lo ned jwanꞌ mbloꞌ Dios lonꞌ. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Tob lo naꞌ lo Jesus, tenꞌ nak xanꞌ jwanꞌ ndli lazonꞌ nde benꞌta Xaꞌ ntoxut jwanꞌ ta ndli lazonꞌ. Nde nandyod Xaꞌ mbroꞌ yantho Xaꞌ lo nguj Xaꞌ lo kruz, tak mne Xaꞌ senꞌ ngolo mbriꞌd Xaꞌ re pen ya yo nale lazoꞌ Xaꞌ nde naya ndob Xaꞌ lad banꞌ Dios, tenꞌ nyebeꞌ Dios.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Jwanꞌ nasa bli goꞌ xgab reta pen jwanꞌ mbriꞌd Jesus, plopa nalat mxak Xaꞌ lo yaꞌ reta men nzoꞌb xken naꞌ, naꞌzanta goꞌ nde naꞌlyayod lazoꞌ goꞌ. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Tak goꞌ teꞌnyega ndorid goꞌ pen, tera yopa goꞌ ro yalguj, lo ta ngechal goꞌ laꞌ goꞌ re jwanꞌ xkapa. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Cho seba mbyaj yek goꞌ diꞌs mtobeꞌ Dios yek goꞌ xajka xinꞌ Xaꞌ ba lo ndej Xaꞌ lo xkiꞌs Xaꞌ:</para>
  <para style="q" vid="HEB 12:5">Xinꞌ na, senꞌ ntoxut Dios la naꞌkotalta lay,</para>
  <para style="q" vid="HEB 12:5">neꞌka konabil la lazoꞌa lo ntobeꞌ Xaꞌ yek la.<verse eid="HEB 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 12:6" />Tak Xaꞌ Nyebeꞌ, ntoxut Xaꞌ re men jwanꞌ nkeꞌ lazoꞌ Xaꞌ,</para>
  <para style="q" vid="HEB 12:6">nde ngoꞌb Xaꞌ kos xis reta men jwanꞌ nkayaꞌ Xaꞌ ak xinꞌ Xaꞌ.<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">Prov. 3:11-12</char></note><verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Tez xek goꞌ toxut Dios goꞌ, sa wiꞌ Dios goꞌ xajka xinꞌpa Dios, tak ¿cho thi mdyenꞌ na naꞌtoxuta xaꞌ xud or, or? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Mbay tez naꞌtoxuta Xaꞌ goꞌ, ta xa ntoxut Xaꞌ re xinꞌ Xaꞌ, nanakta goꞌ xinꞌpa Xaꞌ nde nanakta Xaꞌ xud goꞌ. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Mbay tagaꞌ xa nak xud naꞌ xis izyo reꞌ, mtoxut xaꞌ naꞌ, nde nxoꞌbyek naꞌ xaꞌ. ¿Cho namasta ndablo xoꞌbyek naꞌ Xud naꞌ Dios ndob lo beꞌ, jwanꞌ nak xwanꞌ xbin naꞌ sa ban naꞌ? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Leꞌ xud naꞌ xis izyo reꞌ, mtoxut xaꞌ naꞌ lud tyemp lo re jwanꞌ ndyak xaꞌ nak jwanꞋ wen, per Dios ntoxut Xaꞌ naꞌ sa wen nda naꞌ nde sa ak nayon naꞌ ta xa nak Xaꞌ. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Galꞌ diꞌs senꞌ ngetoxut xaꞌ naꞌ, naktey jwanꞌ nale, cheꞌla nabil ngoy lazoꞌ naꞌ, per senꞌ mxyutla naꞌ, nabeꞌz nde galꞌ ban naꞌ.<verse eid="HEB 12:11" /></para>
  <para style="s">Men jwanꞌ ngoꞌtal yalwen chanꞌ Dios</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Jwanꞌ nasa blo ne lazoꞌ reta goꞌ, ptaꞌ goꞌ gob ba, xaja thi men jwanꞌ bere ndyen jwers lo mzanla xaꞌ ba. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Pchal goꞌ sa naxuta ban goꞌ, sa reta men jwanꞌ ngan na, naꞌlad xaꞌ xned Dios, cheꞌla chal xaꞌ tyonke xaꞌ xis neꞌy.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Pchal goꞌ nabeꞌz ak goꞌ lo re men, nde nayon pkete goꞌ, tak men jwanꞌ nanayonta ngete, naꞌwiꞌd xaꞌ Xaꞌ Nyebeꞌ. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Nda wiꞌ thoz goꞌ sa nek thib goꞌ naꞌlaꞌd yalwen chanꞌ Dios, nde lyen thi yalnanlanꞌ lazoꞌ goꞌ jwanꞌ towꞌ nde koꞌ goꞌy lo bro men. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Nek thib goꞌ naꞌlid re ned yalxkap gaxno goꞌ men, nde naꞌkotalta goꞌ re jwanꞌ nayon, ta xa mbli Esau, por thibnya yen komid, mtho xaꞌ re yalwen jwanꞌ kayaꞌ xaꞌ lo nak xaꞌ or ner lo xud xaꞌ. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Nde mne goꞌ lo senꞌ nchalaꞌs Esau li leyꞌ xud xaꞌ xaꞌ, naꞌndlileyꞋta xud xaꞌ xaꞌ, nde tenꞌnyega nchonꞌ thoz tir xaꞌ nandlileyꞌta xud xaꞌ xaꞌ, tak naꞌaktra zyeꞌ jwanꞌ ta mblia xaꞌ.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Tak go' nambiked go' lo yiꞌ Sinai, jwan' toyal gal men tenꞌ ngwa re xaꞌ gox lonꞌ pola, jwan' ndob bel, tenꞌ nzo yalꞌkow, tenꞌ nakow tub nya nde tenꞌ ndlya mdiꞌ, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />nekla mbin goꞌ bi chanꞌ wad, nde neka mbin goꞌ lo senꞌ mni Dios lo goꞌ. Reta xaꞌ mbin jwanꞌ na mnaꞌb thoz xaꞌ sa naꞌnitra Dios lo xaꞌ. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Tak naꞌnxekta xaꞌ re jwanꞌ mnebeꞌ Dios senꞌ nchab Dios: “Axta thi maꞌ ba tez dinꞌ maꞌ lad yiꞌ, ndablo gadke xaꞌ maꞌ sa gaj maꞌ o kuj xaꞌ maꞌ kon flech<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="fq" closed="false">Axta thi maꞌ ba tez dinꞌ maꞌ lad yiꞌ, ndablo gadke xaꞌ maꞌ sa gaj maꞌ o kuj xaꞌ maꞌ kon flech </char><char style="ft" closed="false">Éxodo 19:12-13</char></note>.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Nde nathoz toz nya jwanꞌ mbwiꞌ xaꞌ jwanꞌ nasa axta Moises nchab na: “Nzyeb na, na nxiꞌd na.”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Mbay leꞌ goꞌ cheꞌla mbike lo yiꞌ Sion, yez chanꞌ Dios naban, lo yez Jerusalen lo beꞌ, tenꞌ nzi por mil anj. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Mbike goꞌ tenꞌ ndyop re men jwanꞌ nak re xinꞌ ner Dios jwanꞌ nzo le naꞌ lo beꞌ, lo Dios Xaꞌ jwanꞌ nyaꞌb kwent lo reta men, tenꞌ nzo xbin reta men wen jwanꞌ mbli jwanꞌ galꞌ lo Dios. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Mbike goꞌ lo Jesus Xaꞌ ndo xtowꞌ Dios nde men, chanꞌ jwanꞌ nakub ta mkeyek Dios, lo ren Jesus jwanꞌ mxo Jesus, tak ren Jesus mas jwin naka ke lo ren Abel.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Jwanꞌ nasa nda wiꞌ toz goꞌ sa naꞌkotalta goꞌ xaꞌ jwanꞌ ndoni, Xaꞌ jwanꞌ nak Dios. Tak tez naꞌndlaꞌd re xaꞌ jwanꞌ mblotal re men jwanꞌ mni lo xaꞌ xis izyo reꞌ, xa lyaꞌ naꞌ tez kotal naꞌ Xaꞌ jwanꞌ ni lonꞌ axta tenꞌ ndob Xaꞌ lo beꞌ. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Tyemp ya lo senꞌ mni Dios, mxiꞌd izyo, per naya ne Dios: “Bere kwin na izyo tib gob, nde nanakey benꞌta izyo, noga beꞌ kwin na.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Lo ta mbez Dios “Bere aka tedib gob”, jwanꞌ na ndej ke kib Dios reta jwanꞌ ndoyal ngwin ta mdoxkwaꞋ Dios, sa yanꞌ reta jwanꞌ nangwinta. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Jwanꞌ nasa lo ta ngekayaꞌ naꞌ thi tenꞌ nyebenꞌ jwanꞌ nangwinta, taꞌ naꞌ dyux lo Dios nde li naꞌ sinꞌ lo Xaꞌ xa ndryoꞌ lazoꞌ Xaꞌ, tseb lazonꞌ Xaꞌ nde tyoxub naꞌ lo Xaꞌ, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />tak Dios naꞌ nak xaja bel doꞌ ba, ta reta jwanꞌ ntolꞌ la.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Jwanꞌ li men lo ndli lazoꞌ men xkiꞌs Dios</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Thiblaꞌ pkeꞌ lazo goꞌ ta goꞌ xajka wespa goꞌ nde ptanꞌ goꞌ, <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Naꞌyajta yek goꞌ nabeꞌz ak goꞌ lo re men ndaꞌ goꞌ yo mbed, tak tamod mbli pla xaꞌ, nde naꞌnyed xaꞌ mdaꞌ xaꞌ liz xaꞌ mbled anj.<verse eid="HEB 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 13:3" />Pteꞌ lazoꞌ goꞌ reta men jwanꞌ nge lizyiꞌb, xajka no goꞌ nge lizyiꞌb kon xaꞌ. Pteꞌlaꞌs goꞌ reta xaꞌ jwanꞌ ntoti men, ta xajka no goꞌ ndoriꞌd re yalti jwanꞌ ndoriꞌd xaꞌ.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Nachixlaꞌda goꞌ tsalꞌ goꞌ, nde nambi ptobno goꞌ tsalꞌ goꞌ, tak Dios nyaꞌb kwent lo re xaꞌ ndli re ned jwanꞌ bew nde lo re xaꞌ ngeteno xaꞌ nanakta salꞌ xaꞌ.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Naꞌtyablasta goꞌ tmi, blo nale lazoꞌ goꞌ kon jwanꞌ ngeno goꞌ, tak Dios nchab: "Nek lud naꞌlat na lu, reta wiz ndonon la." <note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">Dt. 31:6-8, Jos. 1:5 </char></note> <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Jwanꞌ nasa dib nzo lazonꞌ toyal gab naꞌ:</para>
  <para style="q" vid="HEB 13:6">Xaꞌ Nyebeꞌ nak Xaꞌ ndlaꞌston,</para>
  <para style="q" vid="HEB 13:6">naꞌzyebta na cho kwan lino men na.<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false">Sal. 56:3,4</char></note><verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ptelaꞌs goꞌ re xaꞌ ngenap goꞌ jwanꞌ mdej xkiꞌs Dios lo goꞌ, bwiꞌ goꞌ xa ngete xaꞌ nde ta pkete goꞌ, nde xa ndli lazoꞌ xaꞌ Dios ta bli lazoꞌ goꞌ Dios.<verse eid="HEB 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8" />Jesucrist nanzyeꞌd nak Xaꞌ, xa nak Xaꞌ nera, ta nak Xaꞌ naya, nde ta nak Xaꞌ thiptane. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Naꞌtyonked goꞌ xis xaꞌxaꞌ re jwanꞌ nagalꞌta nak ndloꞌ men lo goꞌ. Tak mas jwina kone goꞌ lazoꞌ goꞌ lo yalwen chanꞌ Dios, ke xoꞌbyek goꞌ re mod nyenꞌ cho kwan tak wa men, re jwanꞌ na naꞌngen cho sinꞌ liy lo men.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Naꞌ ngeno thi tenꞌ nayon, nde re nglweyꞌ jwanꞌ ndli sinꞌ lenꞌ yo yida, naꞌnyeda wa xaꞌ jwanꞌ nziꞌb lo tenꞌ nayona. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Tak reta maꞌ jwanꞌ nchuj nglweyꞌ ro, ren maꞌ ncheꞌ xaꞌ ndaꞌ xaꞌ tenꞌ nayon sa yiꞌb xken men, leꞌ belꞌ maꞌ ntolꞌ xaꞌ lad tenꞌ mdib nzi re yo yid nzo xaꞌ. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Jwanꞌ nasa tagaꞌ Jesus aꞌ lad ro yez nguj Xaꞌ, sa kon ren Xaꞌ li nayon Xaꞌ re men Xaꞌ. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Jwanꞌ nasa noga naꞌ ndankenꞌ xis Jesus ryoꞌtenꞌ lenꞌ yez, nde ryoꞋ yanthonꞌ xa mbroꞌ yantho Xaꞌ. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Tak lo izyo reꞌ nangenod naꞌ thi yez jwanꞌ thiptane nzi dib adiꞌ, cheꞌla leꞌ naꞌ ngembed thi yez jwanꞌ nara yeꞌd. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Tamod sa por Jesucrist thiblaꞌ li naronꞌ le Dios. Diꞌs ya nak jwanꞌ tanꞌ lo Dios, xaja thi jwanꞌ yona. ¡Li naronꞌ le Dios kon re diꞌs ndryoꞌ ronꞌ! <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Naꞌriꞌdta yek goꞌ li goꞌ re jwanꞌ wen nde blaꞌsto goꞌ ta men goꞌ, tak re jwanꞌ na ndyen Dios, jwanꞌ na nak xaja maꞌ yon jwanꞌ taꞌ men lo Dios.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Bxobyek goꞌ re xaꞌ ngenap goꞌ nde dib nzo lazoꞌ goꞌ bin goꞌ diꞌs ro xaꞌ, tak xaꞌ thiblaꞌ ngenap xaꞌ goꞌ xajka xaꞌ tayaꞌ kwent lo Dios. Sa nale yo lazoꞌ xaꞌ kenap xaꞌ goꞌ nde naꞌtaꞌd goꞌ xgab yek xaꞌ, tak tez ta li goꞌ nawenta nak jwanꞌ na lo goꞌ.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Mnaꞌb goꞌ lo Dios por náꞌ, tak mne náꞌ ke galꞌ nak xgab náꞌ nde ncholaꞌs náꞌ naxuta kete náꞌ lo reta jwanꞌ. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Nde jwanꞌ nyaꞌb toz na lo goꞌ, mnaꞌb goꞌ lo Dios sa sala sin wiz yatwiꞌn goꞌ.<verse eid="HEB 13:19" /></para>
  <para style="s">Diꞌs ngolo yes</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Leꞌ Dios ta ndaꞌ yalnabeꞌz, nde ta mbloꞌxban Jesucrist Xaꞌ nak Xwanꞌ na, xij re xaꞌ nguj, Jesucrist jwanꞌ nakpa Pastor ro lo re men jwanꞌ nak mbak xilꞌ Xaꞌ, nde por ren Xaꞌ mkeyek Xaꞌ diꞌs adiꞌ lo naꞌ. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Nyaꞌb na lo Dios sa laꞌsto Xaꞌ goꞌ sa galꞌ li goꞌ reta jwanꞌ, xa ncholaꞌs Xaꞌ, nde por Jesucrist li Dios jwanꞌ ncholaꞌs Dios kon naꞌ. ¡Li naronꞌ Crist dib adiꞌ! Ta aka.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Wes na, ptanꞌ na, nyaꞌb na lo goꞌ sa tob nza goꞌ gon goꞌ chop lan diꞌs jwanꞌ nketobeꞌn yek goꞌ lo yeꞌs reꞌ. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Ncholas na nye goꞌ leꞌ wes naꞌ Timoteo mbroꞌtea lizyiꞌb, tez sala sin xaꞌ sa rop náꞌ xaꞌ ya, yatna náꞌ goꞌ.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Mni goꞌ dyux lo reta xaꞌ ngenap goꞌ nde tagaꞌ lo reta men yez nayon Dios. Men yez Dios jwanꞌ nzo lo xyon Italia ntelꞌ xaꞌ dyux lo goꞌ.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Yalwen chanꞌ Dios tyono reta goꞌ. Ta aka.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>