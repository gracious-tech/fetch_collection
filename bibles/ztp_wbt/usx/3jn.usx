<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">chanꞌ diꞌste</book>
  <para style="h">3 Juan</para>
  <para style="toc3">3 Jn.</para>
  <para style="toc2">3 Juan</para>
  <para style="toc1">Yeꞌs byon jwanꞌ mkeꞌ apóst Juan</para>
  <para style="mt">Yeꞌs byon jwanꞌ mtelꞌ Juan xaꞌ nak apost chanꞌ Jesús</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">Dyux chanꞌ Juan</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Na, xaꞌ gox, nin dyux lo Gay, xaꞌ jwanꞌ lipa nkeꞌ toz lazoꞌn.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Wes na, ngenaꞌb na lo Dios sa reta jwanꞌ ndlia naxut ryoꞌy, nde kenoa yalnadanꞌ, ta xa naxut ndoxen yalnaban chanꞌ la. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Nale toz ngo lazoꞌn senꞌ mbyed re wes nde mdej xaꞌ xa galꞌ ndoa nde ngetea lo jwanꞌ lipa. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Nangenotra na yalnale taja naro lo jwanꞌ reꞌ, senꞌ nchon na leꞌ xinꞌ na ngete lo jwanꞌ lipa.<verse eid="3JN 1:4" /></para>
  <para style="s">Nale nzo lazoꞌ Juan lo rsinꞌ Gay</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Wes na, galꞌ toz ndlia senꞌ ndlaꞌstoa re xaꞌ ndli lazonꞌ Dios, tenye nanzolot la xaꞌ. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Tak re xaꞌ ya, mdej xaꞌ lo yodoꞌ re yalwen jwanꞌ ndlia lo xaꞌ. Nyaꞌb na loa thitka blaꞌsto xaꞌ, btaꞌ jwanꞌ nakinꞌ xaꞌ ned tenꞌ nda xaꞌ, xaxa ndryoꞌ lazoꞌ Dios. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Tak re xaꞌ ya, ndyen xaꞌ nda xaꞌ lo rsinꞌ Jesucrist, nde nek thib jwanꞌ ndaꞌ re men naꞌnzolod Dios nankayaꞌd xaꞌ. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Jwanꞌ nasa, ndablo lastonꞌ re xaꞌ ya, zyasa nonꞌ ndolaꞌsto jwanꞌ lipa.<verse eid="3JN 1:8" /></para>
  <para style="s">Naꞌndryoꞌd lazoꞌ Diófretes jwanꞌ ndli Juan</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Na mkeꞌ ti yeꞌs mtel na lo yodoꞌ, per Diófretes naꞌndryoꞌd lazoꞌ xaꞌ jwanꞌ ndli náꞌ, tak xaꞌ ncholaꞌs nyebeꞌ lo yodoꞌ. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Jwanꞌ nasa, tez leꞌn ya, zya tej na lo xaꞌ re jwanꞌ ndli xaꞌ, xa ndyodiꞌs yix xaꞌ nde ni xin xaꞌ xis náꞌ. Nde nanakte benꞌta jwanꞌ nata ndli xaꞌ, noga naꞌtaꞌda xaꞌ plo kwed re xaꞌ ndli lazonꞌ Dios nzin tya. Leꞌ re xaꞌ jwanꞌ ncholas taꞌ plo kwed re xaꞌ ya, nka Diófretes diꞌs li xaꞌy nde ngote Diófretes xaꞌ yodoꞌ.<verse eid="3JN 1:10" /></para>
  <para style="s">Demetr ndli jwanꞌ wen</para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Wes na, naꞌteꞌdta lu jwanꞌ narax, cheꞌla pteꞌd jwanꞌ wen. Tak men ndli jwanꞌ wen, men ya nak xinꞌ Dios, leꞌ xaꞌ ndli jwanꞌ narax, xaꞌ ya nanzolod Dios.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Reta men, wen ndyodiꞌs xaꞌ xis Demetr nde yub lo xkiꞌs Dios wen ndo xaꞌ. Nde taga náꞌ, wen ndyodiꞌs náꞌ xis xaꞌ, nde lu mne re jwanꞌ ndyodiꞌs náꞌ, jwanꞌ liy.<verse eid="3JN 1:12" /></para>
  <para style="s">Juan mni dyux sa ngolo yeꞌs</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Bro toz jwanꞌ ncholas na tej na loa, per naꞌncholasta na keꞌ nay lo yeꞌs, <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />tak ndlin xgab yatwiꞌn la lenꞌ wiz reꞌ, sa todiꞌs rop naꞌ.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Yalnabeꞌz chanꞌ Dios tyonoa. Re xaꞌ ndli lazonꞌ Dios nzi ncheꞌ ya, ni xaꞌ dyux loa. Nde ba btaꞌ dyux lo tiba xaꞌ nzinoa.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>