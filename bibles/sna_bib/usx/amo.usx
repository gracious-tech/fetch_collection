<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Shona Contemporary Bible 2017</book>
  <para style="h">Amosi</para>
  <para style="toc1">Amosi</para>
  <para style="toc2">Amosi</para>
  <para style="toc3">Amo</para>
  <para style="mt1">AMOSI</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>Mashoko aAmosi mumwe wavafudzi veTekoa, zvaakaona pamusoro peIsraeri makore maviri kudengenyeka kwenyika kusati kwaitika, Uzia paakanga ari mambo weJudha uye Jerobhoamu mwanakomana waJoashi ari mambo weIsraeri.<verse eid="AMO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>Akati:</para>
  <para style="q1" vid="AMO 1:2">“Jehovha anoomba ari paZioni</para>
  <para style="q2" vid="AMO 1:2">uye anotinhira ari paJerusarema;</para>
  <para style="q1" vid="AMO 1:2">mafuro avafudzi anooma,</para>
  <para style="q2" vid="AMO 1:2">pamusoro peKarimeri panosvava.”<verse eid="AMO 1:2"/></para>
  <para style="s1">Vavakidzani veIsraeri vanotongwa</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 1:3">“Nemhaka yezvivi zvitatu zveDhamasiko,</para>
  <para style="q2" vid="AMO 1:3">kunyange zvina, handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 1:3">Nokuti vakapura Gireadhi</para>
  <para style="q2" vid="AMO 1:3">nemipuro ina meno amatare,<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>ndichatumira moto paimba yaHazaeri</para>
  <para style="q2" vid="AMO 1:4">uchaparadza nhare dzaBheni Hadhadhi.<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>Ndichavhuna suo reDhamasiko;</para>
  <para style="q2" vid="AMO 1:5">ndichaparadza mambo agere mumupata weAvheni</para>
  <para style="q1" vid="AMO 1:5">uye nouyo akabata tsvimbo youshe muBheti Edheni.</para>
  <para style="q2" vid="AMO 1:5">Vanhu veAramu vachaenda muutapwa kuKiri,”</para>
  <para style="q4" vid="AMO 1:5">ndizvo zvinotaura Jehovha.<verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 1:6">“Nemhaka yezvivi zvitatu zveGaza,</para>
  <para style="q2" vid="AMO 1:6">kunyange zvina, handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 1:6">Nokuti vakatapa rudzi rwose</para>
  <para style="q2" vid="AMO 1:6">uye vakavatengesa kuEdhomu,<verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>ndichatuma moto pamusoro pamasvingo eGaza</para>
  <para style="q2" vid="AMO 1:7">uchaparadza nhare dzake.<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>Ndichaparadza mambo weAshidhodhi</para>
  <para style="q2" vid="AMO 1:8">uye nouyo akabata tsvimbo youshe muAshikeroni.</para>
  <para style="q1" vid="AMO 1:8">Ndichatambanudzira ruoko rwangu kuti ndirwise Ekironi</para>
  <para style="q2" vid="AMO 1:8">kusvikira vaFiristia vose vapera kufa,”</para>
  <para style="q4" vid="AMO 1:8">ndizvo zvinotaura Ishe Jehovha.<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 1:9">“Nemhaka yezvivi zvitatu zveTire,</para>
  <para style="q2" vid="AMO 1:9">kunyange zvina handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 1:9">Nokuti akatengesera Edhomu rudzi rwose savatapwa,</para>
  <para style="q2" vid="AMO 1:9">akasacherechedza sungano youkama,<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>ndichatuma moto pamasvingo eTire,</para>
  <para style="q2" vid="AMO 1:10">uchaparadza nhare dzake.”<verse eid="AMO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 1:11">“Nemhaka yezvivi zvitatu zvaEdhomu,</para>
  <para style="q2" vid="AMO 1:11">kunyange zvina, handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 1:11">Nokuti akadzinganisa mununʼuna wake nomunondo,</para>
  <para style="q2" vid="AMO 1:11">akaramba kumunzwira tsitsi,</para>
  <para style="q1" vid="AMO 1:11">nokuti kutsamwa kwake kwakaramba kwakangodaro,</para>
  <para style="q2" vid="AMO 1:11">uye hasha dzake dzakapfuta, hadzina akadzimisa,<verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>ndichatuma moto pamusoro peTemani</para>
  <para style="q2" vid="AMO 1:12">uchaparadza nhare dzeBhozira.”<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>Zvanzi naJehovha: “Nemhaka yezvivi zvitatu zvaAmoni,</para>
  <para style="q2" vid="AMO 1:13">kunyange zvina, handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 1:13">Nokuti akatumbura vakadzi vane mimba veGireadhi,</para>
  <para style="q2" vid="AMO 1:13">kuti awedzere miganhu yake,<verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>ndichatungidza moto pamasvingo eRabha</para>
  <para style="q2" vid="AMO 1:14">uchaparadza nhare dzaro,</para>
  <para style="q1" vid="AMO 1:14">pakati pemheremhere yehondo pazuva rokurwa,</para>
  <para style="q2" vid="AMO 1:14">pakati pemhepo huru nezuva redutu.<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>Mambo wake achaenda kuutapwa,</para>
  <para style="q2" vid="AMO 1:15">iye namakurukota ake pamwe chete,”</para>
  <para style="q4" vid="AMO 1:15">ndizvo zvinotaura Jehovha.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 2:1">“Nemhaka yezvivi zvitatu zvaMoabhu,</para>
  <para style="q2" vid="AMO 2:1">kunyange zvina, handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 2:1">Nokuti akapisa, kuita madota,</para>
  <para style="q2" vid="AMO 2:1">mapfupa amambo weEdhomu.<verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>Ndichatuma moto pamusoro paMoabhu</para>
  <para style="q2" vid="AMO 2:2">uchaparadza nhare dzeKerioti.</para>
  <para style="q1" vid="AMO 2:2">Moabhu achawira pasi mubope guru</para>
  <para style="q2" vid="AMO 2:2">pakati pemheremhere yehondo, nokurira kwehwamanda.<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>Ndichaparadza mutongi wake</para>
  <para style="q2" vid="AMO 2:3">uye ndichauraya makurukota ake pamwe chete naye,”</para>
  <para style="q4" vid="AMO 2:3">ndizvo zvinotaura Jehovha.<verse eid="AMO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 2:4">“Nemhaka yezvivi zvitatu zvaJudha,</para>
  <para style="q2" vid="AMO 2:4">kunyange zvina, handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 2:4">Nokuti vakaramba murayiro waJehovha</para>
  <para style="q2" vid="AMO 2:4">uye havana kuchengeta mitemo yake,</para>
  <para style="q1" vid="AMO 2:4">nokuti vakatsauswa mukurasika navamwari venhema,</para>
  <para style="q2" vid="AMO 2:4">vamwari vakateverwa namadzitateguru avo,<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>ndichatuma moto pamusoro peJudha,</para>
  <para style="q2" vid="AMO 2:5">uchaparadza nhare dzeJerusarema.”<verse eid="AMO 2:5"/></para>
  <para style="s1">Israeri inotongwa</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 2:6">“Nemhaka yezvivi zvitatu zvaIsraeri,</para>
  <para style="q2" vid="AMO 2:6">kunyange zvina, handingadzori hasha dzangu.</para>
  <para style="q1" vid="AMO 2:6">Vanotengesa vakarurama kuti vawane sirivha,</para>
  <para style="q2" vid="AMO 2:6">navanoshayiwa kuti vawane shangu.<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>Vanotsika-tsika pamisoro yavarombo</para>
  <para style="q2" vid="AMO 2:7">savanotsika paguruva,</para>
  <para style="q2" vid="AMO 2:7">uye vanoshayisa vakadzvinyirirwa kururamisirwa.</para>
  <para style="q1" vid="AMO 2:7">Baba nomwanakomana vanorara nomusikana mumwe chete,</para>
  <para style="q2" vid="AMO 2:7">nokudaro vanosvibisa zita rangu dzvene.<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>Vanovata pasi parutivi pearitari</para>
  <para style="q2" vid="AMO 2:8">imwe neimwe panguo dzakatorwa norubatso.</para>
  <para style="q1" vid="AMO 2:8">Mumba yamwari wavo</para>
  <para style="q2" vid="AMO 2:8">vanonwa waini yakatorwa somuripo.<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>“Ndakaparadza Amori pamberi pavo,</para>
  <para style="q2" vid="AMO 2:9">kunyange akanga akareba somusidhari</para>
  <para style="q2" vid="AMO 2:9">uye akasimba somuouki.</para>
  <para style="q1" vid="AMO 2:9">Ndakaparadza zvibereko zvake</para>
  <para style="q2" vid="AMO 2:9">kumusoro nemidzi yake pasi.<verse eid="AMO 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>“Ndakakubudisa kubva muIjipiti,</para>
  <para style="q2" vid="AMO 2:10">ndikakutungamirira kwamakore makumi mana murenje,</para>
  <para style="q2" vid="AMO 2:10">kuti ndikupe nyika yavaAmori.<verse eid="AMO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>Ndakamutsawo vaprofita kubva pakati pavanakomana venyu,</para>
  <para style="q2" vid="AMO 2:11">navaNaziri kubva pakati pamajaya enyu.</para>
  <para style="q1" vid="AMO 2:11">Ichi hachisi chokwadi here, nhai vanhu veIsraeri?”</para>
  <para style="q4" vid="AMO 2:11">ndizvo zvinotaura Jehovha.<verse eid="AMO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12"/>“Asi makaita kuti vaNaziri vanwe waini</para>
  <para style="q2" vid="AMO 2:12">uye mukarayira vaprofita kuti varege kuprofita.<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>“Zvino ipapo ndichakupwanyai</para>
  <para style="q2" vid="AMO 2:13">sokupwanya kunoita ngoro izere nezviyo.<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>Vanomhanya kwazvo havangapunyuki,</para>
  <para style="q2" vid="AMO 2:14">vakasimba havangazovi nesimba ravo,</para>
  <para style="q2" vid="AMO 2:14">uye murwi haangazoponesi upenyu hwake.<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>Anopfura nemiseve haangazoramba amire,</para>
  <para style="q2" vid="AMO 2:15">murwi anogona kumhanya haangapunyuki,</para>
  <para style="q2" vid="AMO 2:15">uye mutasvi webhiza haangazoponesi upenyu hwake.<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>Kunyange mhare dzakashinga</para>
  <para style="q2" vid="AMO 2:16">dzichatiza dzisina nguo pazuva iro,”</para>
  <para style="q4" vid="AMO 2:16">ndizvo zvinotaura Jehovha.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">Zvapupu zvinodaidzwa kuti zvizopomera Israeri mhosva</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>Inzwai shoko iri rakataurwa naJehovha pamusoro penyu, imi vanhu veIsraeri, pamusoro pemhuri yose yandakabudisa kubva muIjipiti:<verse eid="AMO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2"/>“Ndimi moga vandakasarudza</para>
  <para style="q2" vid="AMO 3:2">pamhuri dzose dzapanyika;</para>
  <para style="q1" vid="AMO 3:2">naizvozvo ndichakurangai</para>
  <para style="q2" vid="AMO 3:2">nokuda kwezvivi zvenyu zvose.”<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>Ko, vaviri vangafamba pamwe chete</para>
  <para style="q2" vid="AMO 3:3">vasina kunge vatenderana here?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>Ko, shumba ingaomba mudondo</para>
  <para style="q2" vid="AMO 3:4">isina chayaruma here?</para>
  <para style="q1" vid="AMO 3:4">Ko, ingarira mubako rayo isina chayabata here?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>Ko, shiri ingawira pasi mumusungo</para>
  <para style="q2" vid="AMO 3:5">pasina kuteyiwa rugombe here?</para>
  <para style="q1" vid="AMO 3:5">Ko, musungo ungaurukira kumusoro</para>
  <para style="q2" vid="AMO 3:5">pasina chawabata here?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>Hwamanda ingarira muguta,</para>
  <para style="q2" vid="AMO 3:6">vanhu vakasatya here?</para>
  <para style="q1" vid="AMO 3:6">Njodzi painowira guta,</para>
  <para style="q2" vid="AMO 3:6">ko, haazi Jehovha anenge azviita here?<verse eid="AMO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>Zvirokwazvo, Ishe Jehovha haaiti chinhu</para>
  <para style="q2" vid="AMO 3:7">asina kuzivisa varanda vake,</para>
  <para style="q2" vid="AMO 3:7">vaprofita, zvakavanzika zvake.<verse eid="AMO 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>Shumba yaomba,</para>
  <para style="q2" vid="AMO 3:8">ndiani angarega kutya?</para>
  <para style="q1" vid="AMO 3:8">Ishe Jehovha ataura,</para>
  <para style="q2" vid="AMO 3:8">ndiani angarega kuprofita?<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9"/>Paridzirai nhare dzeAshidhodhi</para>
  <para style="q2" vid="AMO 3:9">nenhare dzeIjipiti muchiti:</para>
  <para style="q1" vid="AMO 3:9">“Unganai pamakomo eSamaria;</para>
  <para style="q2" vid="AMO 3:9">onai kusagadzikana kukuru kuri mukati maro,</para>
  <para style="q2" vid="AMO 3:9">noudzvinyiriri huri pakati pavanhu varo.”<verse eid="AMO 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10"/>“Havazivi kuita zvakarurama,” ndizvo zvinotaura Jehovha,</para>
  <para style="q2" vid="AMO 3:10">“ivo vanounganidza zvakapambwa nezvakabiwa munhare dzaro.”<verse eid="AMO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11"/>Naizvozvo zvanzi naIshe Jehovha,</para>
  <para style="q1" vid="AMO 3:11">“Muvengi achatora nyika; achawisira pasi nzvimbo dzako</para>
  <para style="q2" vid="AMO 3:11">uye achapamba nhare dzako.”<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>Zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 3:12">“Mufudzi sezvaanobvuta pamuromo</para>
  <para style="q2" vid="AMO 3:12">weshumba mapfupa maviri amakumbo chete kana chipandi chenzeve,</para>
  <para style="q2" vid="AMO 3:12">vaIsraeri vachaponeswa saizvozvowo,</para>
  <para style="q1" vid="AMO 3:12">avo vanogara muSamaria</para>
  <para style="q2" vid="AMO 3:12">pamicheto yemibhedha yavo,</para>
  <para style="q2" vid="AMO 3:12">nomuDhamasiko pazvigaro zvavo.”<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>“Inzwai izvi, mugopupura pamusoro peimba yaJakobho,” ndizvo zvinotaura Ishe Jehovha, Mwari Wamasimba Ose.<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>“Pazuva randicharanga Israeri nokuda kwezvivi zvayo,</para>
  <para style="q2" vid="AMO 3:14">ndichaparadza aritari dzeBheteri;</para>
  <para style="q1" vid="AMO 3:14">nyanga dzearitari dzichaparadzwa</para>
  <para style="q2" vid="AMO 3:14">uye dzichawira pasi.<verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>Ndichaparadza imba yenguva yechando,</para>
  <para style="q2" vid="AMO 3:15">pamwe chete neimba yenguva yechirimo;</para>
  <para style="q1" vid="AMO 3:15">dzimba dzakashongedzwa nenyanga dzenzou dzichaparadzwa</para>
  <para style="q2" vid="AMO 3:15">uye dzimba huru dzichaparadzwa,”</para>
  <para style="q4" vid="AMO 3:15">ndizvo zvinotaura Jehovha.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">Israeri haina kudzokera kuna Mwari</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1"/>Inzwai shoko iri, imi mhou dzeBhashani paGomo reSamaria,</para>
  <para style="q2" vid="AMO 4:1">imi vakadzi vanodzvinyirira varombo</para>
  <para style="q2" vid="AMO 4:1">uye vanopwanya vanoshayiwa muchiti kuvarume venyu, “Tiunzirei zvokunwa.”<verse eid="AMO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2"/>Ishe Jehovha apika noutsvene hwake achiti,</para>
  <para style="q2" vid="AMO 4:2">“Zvirokwazvo nguva ichasvika</para>
  <para style="q1" vid="AMO 4:2">yamuchatorwa nezvikokovono,</para>
  <para style="q2" vid="AMO 4:2">vokupedzisira pakati penyu nezviredzo.<verse eid="AMO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3"/>Muchabuda pakarepo mumwe nomumwe,</para>
  <para style="q2" vid="AMO 4:3">napakakoromoka masvingo,</para>
  <para style="q2" vid="AMO 4:3">uye mucharasirwa kunze makananga kuHamoni,”</para>
  <para style="q4" vid="AMO 4:3">ndizvo zvinotaura Jehovha.<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>“Endai kuBheteri mundotadza;</para>
  <para style="q2" vid="AMO 4:4">endai kuGirigari mundowedzera kutadza kwenyu.</para>
  <para style="q1" vid="AMO 4:4">Uyai nezvibayiro zvenyu mangwanani namangwanani,</para>
  <para style="q2" vid="AMO 4:4">zvegumi zvenyu mushure mamakore matatu.<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>Pisai chingwa chine mbiriso sechibayiro chokuvonga</para>
  <para style="q2" vid="AMO 4:5">muzvirumbidze pamusoro pezvipiriso zvenyu zvokupa nokuzvisarudzira,</para>
  <para style="q1" vid="AMO 4:5">zvirumbidzei nazvo, imi vaIsraeri,</para>
  <para style="q2" vid="AMO 4:5">nokuti izvi ndizvo zvamunofarira kuita,”</para>
  <para style="q4" vid="AMO 4:5">ndizvo zvinotaura Ishe Jehovha.<verse eid="AMO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6"/>“Ndakakupai matumbu asina chinhu mumaguta makuru ose</para>
  <para style="q2" vid="AMO 4:6">uye ndikakushayisai chingwa mumaguta maduku ose,</para>
  <para style="q2" vid="AMO 4:6">kunyange zvakadaro hamuna kudzokera kwandiri,”</para>
  <para style="q4" vid="AMO 4:6">ndizvo zvinotaura Jehovha.<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7"/>“Ndakamisawo mvura</para>
  <para style="q2" vid="AMO 4:7">kuti isanaya kwasara mwedzi mitatu kuti mukohwe.</para>
  <para style="q1" vid="AMO 4:7">Ndakatumira mvura kuguta rimwe chete</para>
  <para style="q2" vid="AMO 4:7">ndikasanayisa kune rimwe.</para>
  <para style="q1" vid="AMO 4:7">Mumwe munda wakawana mvura</para>
  <para style="q2" vid="AMO 4:7">mumwe wakashayiwa uye ukaoma.<verse eid="AMO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8"/>Vanhu vakadzedzereka vachibva kune rimwe guta vachienda kune rimwe kundotsvaka mvura,</para>
  <para style="q2" vid="AMO 4:8">asi havana kuwana yaivaringana kuti vanwe,</para>
  <para style="q2" vid="AMO 4:8">kunyange zvakadaro hamuna kudzokera kwandiri,”</para>
  <para style="q4" vid="AMO 4:8">ndizvo zvinotaura Jehovha.<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9"/>“Kakawanda kwazvo ndakarova mapindu neminda yenyu yemizambiringa,</para>
  <para style="q2" vid="AMO 4:9">ndakairova nechirwere nokuvhuvha.</para>
  <para style="q1" vid="AMO 4:9">Mhashu dzakaparadza mionde nemiti yenyu yemiorivhi,</para>
  <para style="q2" vid="AMO 4:9">kunyange zvakadaro hamuna kudzokera kwandiri,”</para>
  <para style="q4" vid="AMO 4:9">ndizvo zvinotaura Jehovha.<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10"/>“Ndakatumira hosha pakati penyu</para>
  <para style="q2" vid="AMO 4:10">sezvandakaita kuIjipiti.</para>
  <para style="q1" vid="AMO 4:10">Ndakauraya majaya enyu nomunondo,</para>
  <para style="q2" vid="AMO 4:10">pamwe chete namabhiza enyu akapambwa.</para>
  <para style="q1" vid="AMO 4:10">Ndakazadza mhino dzenyu nokunhuhwa kwemisasa yenyu,</para>
  <para style="q2" vid="AMO 4:10">asi hamuna kudzokera kwandiri,”</para>
  <para style="q4" vid="AMO 4:10">ndizvo zvinotaura Jehovha.<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11"/>“Ndakaparadza vamwe venyu</para>
  <para style="q2" vid="AMO 4:11">sokuparadza kwandakaita Sodhomu neGomora.</para>
  <para style="q1" vid="AMO 4:11">Makanga makaita sorukuni runotsva, rwabviswa mumoto,</para>
  <para style="q2" vid="AMO 4:11">asi hamuna kudzokera kwandiri,”</para>
  <para style="q4" vid="AMO 4:11">ndizvo zvinotaura Jehovha.<verse eid="AMO 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>“Naizvozvo izvi ndizvo zvandichaita kwauri, Israeri,</para>
  <para style="q2" vid="AMO 4:12">uye nokuti ndichaita izvi kwauri,</para>
  <para style="q2" vid="AMO 4:12">gadzirira kusangana naMwari wako, iwe Israeri.”<verse eid="AMO 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>Iye anoita makomo,</para>
  <para style="q2" vid="AMO 4:13">ndiye anosika mhepo,</para>
  <para style="q2" vid="AMO 4:13">ndiyezve anozivisa pfungwa dzake kumunhu,</para>
  <para style="q1" vid="AMO 4:13">Iye anoshandura mangwanani akava rima,</para>
  <para style="q2" vid="AMO 4:13">anotsika panzvimbo dzakakwirira dzenyika,</para>
  <para style="q2" vid="AMO 4:13">Jehovha Mwari Wamasimba Ose ndiro zita rake.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">Kuchema nokudanidzira kuti vanhu vatendeuke</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>Inzwai shoko iri, imi imba yaIsraeri, kuchema uku kwandinoita pamusoro penyu:<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“Yawira pasi Mhandara Israeri,</para>
  <para style="q2" vid="AMO 5:2">haingazosimukizve,</para>
  <para style="q1" vid="AMO 5:2">akasiyiwa ari oga munyika yake,</para>
  <para style="q2" vid="AMO 5:2">pasina angamusimudza.”<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>Zvanzi naIshe Jehovha:</para>
  <para style="q1" vid="AMO 5:3">“Guta richaendesa varwi chiuru vakasimba pakati peIsraeri</para>
  <para style="q2" vid="AMO 5:3">richasarirwa nezana chete;</para>
  <para style="q1" vid="AMO 5:3">guta richaendesa varwi zana</para>
  <para style="q2" vid="AMO 5:3">vakasimba richasarirwa negumi chete.”<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>Zvanzi naJehovha kuimba yaIsraeri:</para>
  <para style="q1" vid="AMO 5:4">“Nditsvakei murarame;<verse eid="AMO 5:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5"/>musatsvaka Bheteri,</para>
  <para style="q1" vid="AMO 5:5">musaenda kuGirigari,</para>
  <para style="q2" vid="AMO 5:5">musaita rwendo rwokuenda kuBheerishebha.</para>
  <para style="q1" vid="AMO 5:5">Nokuti zvirokwazvo Girigari ichaendeswa kuutapwa,</para>
  <para style="q2" vid="AMO 5:5">uye Bheteri richava sapasina chinhu.”<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>Tsvakai Jehovha mugorarama,</para>
  <para style="q2" vid="AMO 5:6">mukasadaro achatsvaira imba yaJosefa sezvinoita moto;</para>
  <para style="q1" vid="AMO 5:6">uchaparadza,</para>
  <para style="q2" vid="AMO 5:6">uye Bheteri richashaya anoudzima.<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>Imi vanoshandura kururamisira muchikuita gavakava</para>
  <para style="q2" vid="AMO 5:7">uye muchikandira kururama pasi<verse eid="AMO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>(Iye akaita nyeredzi dzeChimutanhatu neOrioni,</para>
  <para style="q2" vid="AMO 5:8">anoshandura rima richiva mambakwedza,</para>
  <para style="q2" vid="AMO 5:8">uye anoita kuti zuva risvibe huve usiku,</para>
  <para style="q1" vid="AMO 5:8">anodana mvura zhinji yegungwa achiidururira panyika,</para>
  <para style="q2" vid="AMO 5:8">Jehovha ndiro zita rake,<verse eid="AMO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9"/>anoparadza nhare pakarepo uye anoita</para>
  <para style="q2" vid="AMO 5:9">kuti guta rina masvingo rive dongo),<verse eid="AMO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>munovenga anorayira padare</para>
  <para style="q2" vid="AMO 5:10">uye munozvidza anotaura chokwadi.<verse eid="AMO 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>Munotsika pamusoro pomurombo</para>
  <para style="q2" vid="AMO 5:11">muchimumanikidza kuti akupei zviyo.</para>
  <para style="q1" vid="AMO 5:11">Naizvozvo, kunyange makavaka dzimba huru dzamabwe,</para>
  <para style="q2" vid="AMO 5:11">hamungagari madziri;</para>
  <para style="q1" vid="AMO 5:11">kunyange makasima minda yakasvibira yemizambiringa,</para>
  <para style="q2" vid="AMO 5:11">hamunganwi waini yayo.<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>Nokuti ndinoziva kuwanda kwemhosva</para>
  <para style="q2" vid="AMO 5:12">dzenyu nokukura kwakaita zvivi zvenyu.</para>
  <para style="b" vid="AMO 5:12"/>
  <para style="q1" vid="AMO 5:12">Munodzvinyirira vakarurama uye munotora fufuro,</para>
  <para style="q2" vid="AMO 5:12">uye munoshayisa varombo kururamisirwa pamatare.<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>Naizvozvo munhu akangwara anonyarara panguva dzakadai,</para>
  <para style="q2" vid="AMO 5:13">nokuti inguva dzakaipa.<verse eid="AMO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14"/>Tsvakai zvakanaka, kwete zvakaipa,</para>
  <para style="q2" vid="AMO 5:14">kuti murarame.</para>
  <para style="q1" vid="AMO 5:14">Ipapo Jehovha Mwari Wamasimba Ose achava nemi,</para>
  <para style="q2" vid="AMO 5:14">sezvamunoti ndizvo zvaari.<verse eid="AMO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15"/>Vengai zvakaipa, mude zvakanaka;</para>
  <para style="q2" vid="AMO 5:15">chengetedzai kururamisira mumatare.</para>
  <para style="q1" vid="AMO 5:15">Zvichida Jehovha Mwari Wamasimba Ose</para>
  <para style="q2" vid="AMO 5:15">achanzwira tsitsi vakasara vaJosefa.<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>Naizvozvo zvanzi naIshe, Jehovha Mwari Wamasimba Ose,</para>
  <para style="q1" vid="AMO 5:16">“Muchava nokuchema mumigwagwa</para>
  <para style="q2" vid="AMO 5:16">yose nemhere yokurwadziwa pazvivara zvose.</para>
  <para style="q1" vid="AMO 5:16">Varimi vachadanwa kuti vazochema</para>
  <para style="q2" vid="AMO 5:16">uye vanochema vazoungudza.<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>Kuchava nokuungudza muminda yose yemizambiringa,</para>
  <para style="q2" vid="AMO 5:17">nokuti ndichapfuura napakati penyu,”</para>
  <para style="q4" vid="AMO 5:17">ndizvo zvinotaura Jehovha.<verse eid="AMO 5:17"/></para>
  <para style="s1">Zuva raJehovha</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>Mune nhamo imi</para>
  <para style="q2" vid="AMO 5:18">munoshuva zuva raJehovha!</para>
  <para style="q1" vid="AMO 5:18">Sei muchishuva zuva raJehovha?</para>
  <para style="q2" vid="AMO 5:18">Zuva iro richava rima kwete chiedza.<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>Zvichaita somunhu akatiza shumba</para>
  <para style="q2" vid="AMO 5:19">achibva asangana nebere,</para>
  <para style="q1" vid="AMO 5:19">sokunge akapinda mumba</para>
  <para style="q2" vid="AMO 5:19">make ndokubata madziro noruoko rwake</para>
  <para style="q2" vid="AMO 5:19">achibva arumwa nenyoka.<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>Ko, zuva raJehovha haringavi rima here,</para>
  <para style="q2" vid="AMO 5:20">kwete chiedza, rima guru, risina kana bwerazuva?<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>“Ndinovenga, ndinozvidza mitambo yenyu yechinamato;</para>
  <para style="q2" vid="AMO 5:21">handifadzwi neungano dzenyu.<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>Kunyange mukandivigira zvipiriso zvenyu zvinopiswa nezvipiriso zvezviyo,</para>
  <para style="q2" vid="AMO 5:22">handingazvigamuchiri.</para>
  <para style="q1" vid="AMO 5:22">Kunyange mukandivigira zvipiriso zvakaisvonaka zvokuwadzana,</para>
  <para style="q2" vid="AMO 5:22">handingavi nehanya nazvo.<verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>Ibvai pamberi pangu noruzha rwenziyo dzenyu!</para>
  <para style="q2" vid="AMO 5:23">Handidi kunzwa kurira kwembira dzenyu.<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>Asi kururamisira ngakuyerere sorwizi,</para>
  <para style="q2" vid="AMO 5:24">kururama sorukova rusingapwi!<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>“Makandivigira zvibayiro nezvipiriso</para>
  <para style="q2" vid="AMO 5:25">makore makumi mana muri murenje here, nhai imba yaIsraeri?<verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>Makasimudzira temberi yamambo wenyu,</para>
  <para style="q2" vid="AMO 5:26">chitsiko chezvifananidzo zvenyu,</para>
  <para style="q2" vid="AMO 5:26">nyeredzi yamwari wenyu,</para>
  <para style="q2" vid="AMO 5:26">wamakazvigadzirira.<verse eid="AMO 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27"/>Naizvozvo ndichakutamisai muende mberi kweDhamasiko,”</para>
  <para style="q2" vid="AMO 5:27">ndizvo zvinotaura Jehovha ane zita rinonzi Mwari Wamasimba Ose.<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">Vane nhamo vakavarairwa</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1"/>Mune nhamo imi makavarairwa muZioni,</para>
  <para style="q2" vid="AMO 6:1">nemi munofunga kuti mugere pakasimba paGomo reSamaria,</para>
  <para style="q1" vid="AMO 6:1">imi varume vanozivikanwa vorudzi rukuru,</para>
  <para style="q2" vid="AMO 6:1">kunoenda vanhu veIsraeri!<verse eid="AMO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2"/>Endai kuKarine mundoritarisa;</para>
  <para style="q2" vid="AMO 6:2">muchibvapo moenda kuHamati guta guru,</para>
  <para style="q2" vid="AMO 6:2">uye mozodzika kuGati muFiristia.</para>
  <para style="q1" vid="AMO 6:2">Vari nani kupfuura umambo hwenyu huviri here?<verse eid="AMO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3"/>Munoti zuva rakaipa ngarirege</para>
  <para style="q2" vid="AMO 6:3">kusvika muchiswededza pedyo utongi hwokuvhundutsira.<verse eid="AMO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4"/>Munovata pamibhedha yenyanga dzenzou,</para>
  <para style="q2" vid="AMO 6:4">muchizorora pazvigaro zvenyu.</para>
  <para style="q1" vid="AMO 6:4">Munodya makwayana akaisvonaka</para>
  <para style="q2" vid="AMO 6:4">nemhuru dzakakodzwa.<verse eid="AMO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5"/>Munoridza zvenyu mbira dzenyu saDhavhidhi,</para>
  <para style="q2" vid="AMO 6:5">uye munozvigadzirira zviridzwa.<verse eid="AMO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6"/>Munonwa waini yakawanda,</para>
  <para style="q2" vid="AMO 6:6">muchizora mafuta akaisvonaka,</para>
  <para style="q2" vid="AMO 6:6">asi hamuchemi nokuda kwamatongo aJosefa.<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>Naizvozvo muchava pakati pevachatanga kuenda kuutapwa;</para>
  <para style="q2" vid="AMO 6:7">mabiko enyu nokuzorora kwenyu zvichapera.<verse eid="AMO 6:7"/></para>
  <para style="s1">Jehovha anosema kuzvikudza kwaIsraeri</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>Ishe Jehovha akapika naiye pachake, Jehovha Mwari Wamasimba Ose anoti,</para>
  <para style="q1" vid="AMO 6:8">“Ndinosema kuzvikudza kwaJakobho,</para>
  <para style="q2" vid="AMO 6:8">uye ndinovenga nhare dzake;</para>
  <para style="q1" vid="AMO 6:8">ndichaisa guta kuvavengi</para>
  <para style="q2" vid="AMO 6:8">nezvose zviri mariri.”<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>Kana varume gumi vakasiyiwa muimba imwe chete naivowo vachafa. <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>Uye kana hama inofanira kupisa mitumbi ikauya kuzovabudisa mumba, uye ikabvunza munhu achakahwanda imomo ichiti, “Pane mumwe waunaye here?” uye akati, “Kwete,” ipapo iye achati, “Nyarara! Hatifaniri kuti titaure zita raJehovha.”<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>Nokuti Jehovha akarayira,</para>
  <para style="q2" vid="AMO 6:11">uye achaparadza imba huru igoita murwi,</para>
  <para style="q2" vid="AMO 6:11">nemba duku igoti mwarara.<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>Ko, mabhiza angamhanya paruware here?</para>
  <para style="q2" vid="AMO 6:12">Ko, pane angaparima ipapo nemombe here?</para>
  <para style="q1" vid="AMO 6:12">Asi makashandura kururamisira mukakuita muchetura,</para>
  <para style="q2" vid="AMO 6:12">nechibereko chokururama mukachiita gavakava,<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>imi munopembera pakukundwa kweRo Dhibhari uye munoti,</para>
  <para style="q2" vid="AMO 6:13">“Hatina kuzvitorera Karinaini nesimba redu here?”<verse eid="AMO 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14"/>Nokuti Jehovha Mwari Wamasimba Ose anoti,</para>
  <para style="q2" vid="AMO 6:14">“Ndichakumutsirai rumwe rudzi kuti rukumukirei, imi imba yaIsraeri,</para>
  <para style="q1" vid="AMO 6:14">ruchakutambudzai panzira yenyu yose,</para>
  <para style="q2" vid="AMO 6:14">kubva kuRebho Hamati kusvikira kumupata weArabha.”<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">Mhashu, Moto neRwodzi Rwokuyeresa</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>Izvi ndizvo zvandakaratidzwa naIshe Jehovha: Akanga achigadzirira chimokoto chemhashu mushure mokukohwewa kwomugove wamambo uye mumera wechipiri uchangobuda. <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>Dzakati dzapedza zvose zvaiva munyika, ndakadanidzira ndichiti, “Ishe Jehovha chikanganwirai henyu! Ko, Jakobho angararame sei? Muduku kwazvo!”<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>Nokudaro Jehovha akadzora mwoyo.</para>
  <para style="p" vid="AMO 7:3">Jehovha akati, “Izvi hazvichazoitika.”<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>Izvi ndizvo zvandakaratidzwa naIshe Jehovha: Ishe Jehovha akanga achidanidzira kuti pave nokutonga nomoto; wakaomesa gungwa rakadzika uye ukaparadza nyika. <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>Ipapo ndakadanidzira ndichiti, “Ishe Jehovha, ndinokukumbirai, imbomirai henyu. Ko, Jakobho angararame sei? Muduku kwazvo!”<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>Nokudaro Jehovha akadzora mwoyo.</para>
  <para style="p" vid="AMO 7:6">Ishe Jehovha akati, “Izviwo hazvichaitiki.”<verse eid="AMO 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>Izvi ndizvo zvaakandiratidza: Jehovha akanga akamira pamadziro akanga akavakwa zvakaenzaniswa nerwodzi, ane rwodzi rwokuyeresa muruoko rwake. <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>Uye Jehovha akandibvunza akati, “Unooneiko, Amosi?”</para>
  <para style="p" vid="AMO 7:8">Ndakapindura ndikati, “Rwodzi rwokuyeresa.”</para>
  <para style="p" vid="AMO 7:8">Ipapo Jehovha akati, “Tarira, ndichaisa rwodzi rwokuyeresa pakati pavanhu vangu vaIsraeri, handichavaponesazve.<verse eid="AMO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9"/>“Nzvimbo dzakakwirira dzaIsaka dzichaparadzwa,</para>
  <para style="q2" vid="AMO 7:9">uye nzvimbo tsvene dzaIsraeri dzichaitwa matongo;</para>
  <para style="q2" vid="AMO 7:9">ndichamukira imba yaJerobhoamu nomunondo wangu.”<verse eid="AMO 7:9"/></para>
  <para style="s1">Amosi naAmazia</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>Ipapo Amazia muprista weBheteri akatumira shoko kuna Jerobhoamu mambo weIsraeri achiti, “Amosi akaita rangano yokukumukirai pakati chaipo pemwoyo weIsraeri. Nyika haigoni kugamuchira mashoko ake ose. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>Nokuti izvi ndizvo zviri kutaurwa naAmosi:</para>
  <para style="q1" vid="AMO 7:11">“ ‘Jerobhoamu achafa nomunondo,</para>
  <para style="q2" vid="AMO 7:11">uye Israeri ichaenda kuutapwa,</para>
  <para style="q2" vid="AMO 7:11">zvirokwazvo kure nenyika yavo yechizvarwa.’ ”<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>Ipapo Amazia akati kuna Amosi, “Ibva muno, iwe muoni! Dzokera kunyika yeJudha. Uzviwanire zvokudya zvako ikoko, uchiprofita ikoko. <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>Usaprofitazve paBheteri, nokuti iyi ndiyo nzvimbo tsvene yamambo uye netemberi youmambo.”<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>Amosi akapindura Amazia achiti, “Ndakanga ndisiri muprofita, kana mwanakomana womuprofita, asi ndaiva mufudzi nomutariri wemionde yemisikamo. <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>Asi Jehovha akanditora kubva paufudzi hwamakwai akati kwandiri, ‘Enda uprofite kuvanhu vangu Israeri.’ <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>Zvino, chinzwa shoko raJehovha. Iwe unoti,</para>
  <para style="q1" vid="AMO 7:16">“Usaprofita pamusoro paIsraeri,</para>
  <para style="q2" vid="AMO 7:16">uye rega kuparidza pamusoro peimba yaIsaka.”<verse eid="AMO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17"/>“Naizvozvo zvanzi naJehovha:</para>
  <para style="q1" vid="AMO 7:17">“ ‘Mukadzi wako achava chifeve muguta,</para>
  <para style="q2" vid="AMO 7:17">uye vanakomana nevanasikana vako vachaparadzwa nomunondo.</para>
  <para style="q1" vid="AMO 7:17">Nyika yako ichayerwa igoganhurwa,</para>
  <para style="q2" vid="AMO 7:17">uyezve iwe pachako uchafira munyika yevedzimwe ndudzi,</para>
  <para style="q1" vid="AMO 7:17">Uye zvirokwazvo Israeri ichaenda kuutapwa,</para>
  <para style="q2" vid="AMO 7:17">kure nenyika yavo yechizvarwa.’ ”<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">Tswanda yemichero yakaibva</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>Izvi ndizvo zvandakaratidzwa naIshe Jehovha: tswanda ine michero yakaibva. <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>Akabvunza akati, “Unooneiko, Amosi?”</para>
  <para style="p" vid="AMO 8:2">Ndakapindura ndichiti, “Tswanda ine michero yakaibva.”</para>
  <para style="p" vid="AMO 8:2">Ipapo Jehovha akati kwandiri, “Nguva yakwana kuvanhu vangu Israeri; handingavararamisizve.<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>“Pazuva iro,” ndizvo zvinotaura Ishe Jehovha, “nziyo dzomutemberi dzichashanduka dzigova kuchema. Mitumbi yevakafa ichava mizhinji. Munzvimbo dzose icharaswa vanhu vanyerere.”<verse eid="AMO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>Inzwai izvi imi munotsika-tsika vanoshayiwa</para>
  <para style="q2" vid="AMO 8:4">uye muchiparadza varombo venyika,<verse eid="AMO 8:4"/></para>
  <para style="m">
    <verse number="5" style="v" sid="AMO 8:5"/>muchiti,</para>
  <para style="q1" vid="AMO 8:5">“Kugara kwoMwedzi kuchapfuura riniko</para>
  <para style="q2" vid="AMO 8:5">kuti tigotengesa zviyo,</para>
  <para style="q1" vid="AMO 8:5">uye kupera kweSabata</para>
  <para style="q2" vid="AMO 8:5">kuti tigotengesa gorosi?”</para>
  <para style="q1" vid="AMO 8:5">muchitapudza chiero,</para>
  <para style="q2" vid="AMO 8:5">muchikwidza mitengo</para>
  <para style="q2" vid="AMO 8:5">uye muchibiridzira nezvikero zvinonyengera,<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>muchitenga varombo nesirivha</para>
  <para style="q2" vid="AMO 8:6">uye vanoshayiwa neshangu,</para>
  <para style="q2" vid="AMO 8:6">muchitengesa kunyange makoto pamwe chete negorosi.<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>Jehovha apika noKuzvikudza kwaJakobho achiti, “Handizokanganwi chinhu chipi nechipi zvacho chavakaita.<verse eid="AMO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8"/>“Ko, nyika haingadederi nokuda kwaizvozvi here</para>
  <para style="q2" vid="AMO 8:8">uye vose vanogara mairi havangachemi?</para>
  <para style="q1" vid="AMO 8:8">Nyika yose ichadira seNairi,</para>
  <para style="q2" vid="AMO 8:8">ichabvongodzwa</para>
  <para style="q2" vid="AMO 8:8">uye igoderera sorwizi rweIjipiti.<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>“Pazuva iro,” ndizvo zvinotaura Ishe Jehovha,</para>
  <para style="q1" vid="AMO 8:9">“ndichaita kuti zuva rivire masikati makuru</para>
  <para style="q2" vid="AMO 8:9">uye ndichauyisa rima panyika masikati machena.<verse eid="AMO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10"/>Ndichashandura mitambo yenyu yechinamato ive kuchema,</para>
  <para style="q2" vid="AMO 8:10">nokuimba kwose kuti kuve mhere.</para>
  <para style="q1" vid="AMO 8:10">Ndichaita kuti mose mupfeke masaga</para>
  <para style="q2" vid="AMO 8:10">uye mugoveura misoro yenyu.</para>
  <para style="q1" vid="AMO 8:10">Ndichaita kuti nguva iyi ive samariro omwanakomana akaberekwa ari mumwe oga,</para>
  <para style="q2" vid="AMO 8:10">uye magumo acho ave sezuva rakaipa kwazvo.<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11"/>“Mazuva ari kuuya,” ndizvo zvinotaura Ishe Jehovha,</para>
  <para style="q2" vid="AMO 8:11">“andichatumira nzara panyika yose,</para>
  <para style="q1" vid="AMO 8:11">kwete nzara yezvokudya kana nyota yemvura,</para>
  <para style="q2" vid="AMO 8:11">asi nzara yokunzwa mashoko aJehovha.<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>Vanhu vachadzedzereka vachibva kugungwa</para>
  <para style="q2" vid="AMO 8:12">vachienda kune rimwe gungwa,</para>
  <para style="q1" vid="AMO 8:12">uye vachadzungaira vachibva kumusoro vachienda kumabvazuva,</para>
  <para style="q2" vid="AMO 8:12">vachitsvaka shoko raJehovha, asi havangariwani.<verse eid="AMO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13"/>“Pazuva iro,</para>
  <para style="q1" vid="AMO 8:13">“mhandara dzakaisvonaka namajaya</para>
  <para style="q2" vid="AMO 8:13">akasimba vachaziya nenyota.<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>Avo vanopika nokunyadzisa kweSamaria, kana vanoti,</para>
  <para style="q2" vid="AMO 8:14">‘Namwari wako mupenyu, iwe Dhani,’ kana kuti,</para>
  <para style="q2" vid="AMO 8:14">‘Namwari waBheerishebha mupenyu,’</para>
  <para style="q1" vid="AMO 8:14">vachawa,</para>
  <para style="q2" vid="AMO 8:14">vasingazomukazve.”<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">Israeri ichaparadzwa</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>Ndakaona Jehovha amire parutivi rwearitari, uye akati,</para>
  <para style="q1" vid="AMO 9:1">“Rova misoro yembiru</para>
  <para style="q2" vid="AMO 9:1">kuti zvikumbaridzo zvizunguzike.</para>
  <para style="q1" vid="AMO 9:1">Zviputsire pasi pamisoro yevanhu vose;</para>
  <para style="q2" vid="AMO 9:1">avo vachasara ndichavauraya nomunondo.</para>
  <para style="q1" vid="AMO 9:1">Hapana kana mumwe chete achatiza,</para>
  <para style="q2" vid="AMO 9:1">hapana achapunyuka.<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>Kunyange vakachera kusvikira panoperera guva,</para>
  <para style="q2" vid="AMO 9:2">kubva imomo ruoko rwangu ruchavatora.</para>
  <para style="q1" vid="AMO 9:2">Kunyange vakakwira kumatenga,</para>
  <para style="q2" vid="AMO 9:2">kubva ikoko ndichavadzikisa pasi.<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>Kunyange vakazvivanza pamusoro peKarimeri,</para>
  <para style="q2" vid="AMO 9:3">ipapo ndichavavhima ndigovabata.</para>
  <para style="q1" vid="AMO 9:3">Kunyange vakahwanda kubva kwandiri pasi pegungwa,</para>
  <para style="q2" vid="AMO 9:3">ipapo ndicharayira nyoka kuti ivarume.<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>Kunyange vakaendeswa kuutapwa navavengi vavo,</para>
  <para style="q2" vid="AMO 9:4">ikoko ndicharayira munondo kuti uvaparadze.</para>
  <para style="q1" vid="AMO 9:4">Ndichananʼanidza meso angu pavari</para>
  <para style="q2" vid="AMO 9:4">kuti ndivaitire zvakaipa, kwete zvakanaka.”<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>Ishe, Jehovha Wamasimba Ose,</para>
  <para style="q2" vid="AMO 9:5">iye anobata nyika igonyungudika,</para>
  <para style="q2" vid="AMO 9:5">navose vagere mairi vagochema,</para>
  <para style="q1" vid="AMO 9:5">nyika yose inozara seNairi,</para>
  <para style="q2" vid="AMO 9:5">uye igoderera serwizi rweIjipiti,<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>iye anovaka muzinda wake kumatenga</para>
  <para style="q2" vid="AMO 9:6">agomisa hwaro hwawo panyika,</para>
  <para style="q1" vid="AMO 9:6">anodana mvura dzegungwa</para>
  <para style="q2" vid="AMO 9:6">agodzidururira pamusoro penyika,</para>
  <para style="q2" vid="AMO 9:6">Jehovha ndiro zita rake.<verse eid="AMO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7"/>“Nhai imi vaIsraeri, ko,</para>
  <para style="q2" vid="AMO 9:7">hamusi kwandiri vamwe chete savaEtiopia here?”</para>
  <para style="q4" vid="AMO 9:7">ndizvo zvinotaura Jehovha.</para>
  <para style="q1" vid="AMO 9:7">“Handina kubudisa Israeri kubva kuIjipiti here,</para>
  <para style="q2" vid="AMO 9:7">vaFiristia kubva kuKafitori</para>
  <para style="q2" vid="AMO 9:7">navaAramu kubva kuKiri?<verse eid="AMO 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>“Zvirokwazvo meso aIshe Jehovha</para>
  <para style="q2" vid="AMO 9:8">ari paumambo hunotadza.</para>
  <para style="q1" vid="AMO 9:8">Ndichahuparadza</para>
  <para style="q2" vid="AMO 9:8">kubva pamusoro penyika,</para>
  <para style="q1" vid="AMO 9:8">asi handingaparadzi zvachose</para>
  <para style="q2" vid="AMO 9:8">imba yaJakobho,”</para>
  <para style="q4" vid="AMO 9:8">ndizvo zvinotaura Jehovha.<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>“Nokuti ndicharayira,</para>
  <para style="q2" vid="AMO 9:9">uye ndichazunguza imba yaIsraeri pakati pendudzi dzose,</para>
  <para style="q2" vid="AMO 9:9">sokuzunguzwa kunoitwa zviyo murusero,</para>
  <para style="q1" vid="AMO 9:9">uye hapana kana tsanga</para>
  <para style="q2" vid="AMO 9:9">imwe chete ichawira pasi.<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>Vatadzi vose pakati pavanhu vangu</para>
  <para style="q2" vid="AMO 9:10">vachafa nomunondo,</para>
  <para style="q1" vid="AMO 9:10">vose vanoti,</para>
  <para style="q2" vid="AMO 9:10">‘Njodzi haingatiwiri kana kusangana nesu.’<verse eid="AMO 9:10"/></para>
  <para style="s1">Israeri inomutsidzirwa</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11"/>“Pazuva iro ndichamisazve</para>
  <para style="q2" vid="AMO 9:11">tende raDhavhidhi rakawa.</para>
  <para style="q1" vid="AMO 9:11">Ndichavakazve nzvimbo dzaro dzakaputsika,</para>
  <para style="q2" vid="AMO 9:11">ndigovakazve matongo aro,</para>
  <para style="q2" vid="AMO 9:11">uye ndicharivaka sezvarakanga rakaita,<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>kuti vazvitorere zvakasara zvaEdhomu</para>
  <para style="q2" vid="AMO 9:12">nendudzi dzose dzine zita rangu,”</para>
  <para style="q4" vid="AMO 9:12">ndizvo zvinotaura Jehovha, iye achaita zvinhu izvi.<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>“Mazuva ari kuuya,” ndizvo zvinotaura Jehovha,</para>
  <para style="q1" vid="AMO 9:13">“mucheki paachapfuurwa nomurimi,</para>
  <para style="q2" vid="AMO 9:13">uye mudyari paachapfuurwa neanosvina mazambiringa.</para>
  <para style="q1" vid="AMO 9:13">Waini itsva ichadonha kubva kumakomo,</para>
  <para style="q2" vid="AMO 9:13">uye ichayerera kubva pazvikomo zvose.<verse eid="AMO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14"/>Ndichadzosazve vanhu vangu vakatapwa, ivo vaIsraeri;</para>
  <para style="q2" vid="AMO 9:14">vachavakazve maguta akaitwa matongo uye vachagara maari.</para>
  <para style="q1" vid="AMO 9:14">Vachasima minda yemizambiringa vagonwa waini yayo.</para>
  <para style="q2" vid="AMO 9:14">Vacharima mapindu uye vachadya zvibereko zvawo.<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>Ndichasima Israeri munyika yavo voga,</para>
  <para style="q2" vid="AMO 9:15">havangazodzurwizve</para>
  <para style="q2" vid="AMO 9:15">kubva panyika yandakavapa,”</para>
  <para style="b" vid="AMO 9:15"/>
  <para style="q4" vid="AMO 9:15">ndizvo zvinotaura Jehovha Mwari wako.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
