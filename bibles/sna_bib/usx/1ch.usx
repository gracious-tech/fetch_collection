<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Shona Contemporary Bible 2017</book>
  <para style="h">1 Makoronike</para>
  <para style="toc1">1 Makoronike</para>
  <para style="toc2">1 Makoronike</para>
  <para style="toc3">1 Makoro</para>
  <para style="mt1">1 MAKORONIKE</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">Zvinyorwa zvenhoroondo kubva kuna</para>
  <para style="s1">Adhamu kusvika kuna Abhurahama</para>
  <para style="s2">Kusvika kuvanakomana vaNoa</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>Adhamu, Seti, Enoshi,<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>Kenani, Maharareri, Jaredhi,<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>Inoki, Metusera, Rameki,</para>
  <para style="li1" vid="1CH 1:3">Noa.<verse eid="1CH 1:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 1:4"/>Vanakomana vaNoa vaiva: Shemu, Hamu, naJafeti.<verse eid="1CH 1:4"/></para>
  <para style="s2">VaJafeti</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>Vanakomana vaJafeti vaiva:</para>
  <para style="li2" vid="1CH 1:5">Gomeri, Magogi, Madhai, Javhani, Tubhari, Mesheki naTirasi.<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>Vanakomana vaGomeri vaiva:</para>
  <para style="li2" vid="1CH 1:6">Ashikenazi, Rifati naTogarima.<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>Vanakomana vaJavhani vaiva:</para>
  <para style="li2" vid="1CH 1:7">Erisha, Tashishi, Kitimi naRodhanimi.<verse eid="1CH 1:7"/></para>
  <para style="s2">VaHamu</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>Vanakomana vaHamu vaiva:</para>
  <para style="li2" vid="1CH 1:8">Kushi, Miziraimi, Puti naKenani.<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>Vanakomana vaKushi vaiva:</para>
  <para style="li2" vid="1CH 1:9">Sebha, Havhira, Sabata, Raama naSabhiteka.</para>
  <para style="li1" vid="1CH 1:9">Vanakomana vaRaama vaiva:</para>
  <para style="li2" vid="1CH 1:9">Shebha naDedhani.<verse eid="1CH 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10"/>Kushi aiva baba vaNimurodhi;</para>
  <para style="li2" vid="1CH 1:10">uyo akakura akava murwi mukuru panyika.<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>Miziraimi aiva baba</para>
  <para style="li2" vid="1CH 1:11">vavaRudhi, vaAnami, vaRehabhi, vaNafutuhi, <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>vaPatiri, vaKasiruhi (umo makazobvawo vaFiristia) navaKafitori.<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>Kenani aiva baba</para>
  <para style="li2" vid="1CH 1:13">vaSidhoni dangwe rake, nevaHiti, <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>vaJebhusi vaAmori, vaGirigashi, <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>vaHivhi, vaAriki, vaSini, <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>vaArivhadhi, vaZemari nevaHamati.<verse eid="1CH 1:16"/></para>
  <para style="s2">VaSemi</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>Vanakomana vaShemu vaiva:</para>
  <para style="li2" vid="1CH 1:17">Eramu, Ashua, Arifakisadhi, Rudhi naAramu.</para>
  <para style="li1" vid="1CH 1:17">Vanakomana vaAramu vaiva:</para>
  <para style="li2" vid="1CH 1:17">Uzi, Huri, Geteri naMesheki.<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>Arifakisadhi aiva baba vaShera,</para>
  <para style="li2" vid="1CH 1:18">uye Shera aiva baba vaEbheri.<verse eid="1CH 1:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19"/>Vanakomana vaviri vakaberekerwa Ebheri:</para>
  <para style="li2" vid="1CH 1:19">mumwe ainzi Peregi, nokuti panguva yake nyika yakanga yakakamurana; mununʼuna wake ainzi Jokitani.<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>Jokitani aiva baba</para>
  <para style="li2" vid="1CH 1:20">vaArimodhadhi, Sherefi, Hazarimavheti, Jera, <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>Hadhoramu, Uzari, Dhikira, <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>Obhari, Abhimaeri, Shebha, <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>Ofiri, Havhira naJobhabhi. Ava vose vaiva vanakomana vaJokitani.<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>Shemu, Arifakisadhi, Shera,<verse eid="1CH 1:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25"/>Ebheri, Peregi, Reu,<verse eid="1CH 1:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26"/>Serugi, Nahori, Tera<verse eid="1CH 1:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27"/>naAbhurama (iye Abhurahama).<verse eid="1CH 1:27"/></para>
  <para style="s2">Mhuri yaAbhurahama</para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 1:28"/>Vanakomana vaAbhurahama vaiva: Isaka naIshumaeri.<verse eid="1CH 1:28"/></para>
  <para style="s2">Zvizvarwa zvaHagari</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>Izvi ndizvo zvaiva zvizvarwa zvavo:</para>
  <para style="li2" vid="1CH 1:29">Nebhayoti dangwe raIshumaeri, Kedhari, Adhibheeri, Mibhisami, <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>Mishima, Dhuma, Masa, Hadhadhi, Tema, <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>Jeturi, Nafishi, naKedhema.</para>
  <para style="li4" vid="1CH 1:31">Ava ndivo vaiva vanakomana vaIshumaeri.<verse eid="1CH 1:31"/></para>
  <para style="s2">Zvizvarwa zvaKetura</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>Vanakomana vakaberekwa naKetura, murongo waAbhurahama vaiva:</para>
  <para style="li2" vid="1CH 1:32">Zimirani, Jokishani, Medhani, Midhiani, Ishibhaki naShua.</para>
  <para style="li1" vid="1CH 1:32">Vanakomana vaJokishani vaiva:</para>
  <para style="li2" vid="1CH 1:32">Shebha naDhedhani.<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>Vanakomana vaMidhiani vaiva:</para>
  <para style="li2" vid="1CH 1:33">Efa, Eferi, Hanoki, Abhidha naEridha.</para>
  <para style="li4" vid="1CH 1:33">Ava vose vaiva zvizvarwa zvaKetura.<verse eid="1CH 1:33"/></para>
  <para style="s2">Zvizvarwa zvaSara</para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 1:34"/>Abhurahama aiva baba vaIsaka.</para>
  <para style="li1" vid="1CH 1:34">Vanakomana vaIsaka vaiva:</para>
  <para style="li2" vid="1CH 1:34">Esau naIsraeri.<verse eid="1CH 1:34"/></para>
  <para style="s1">Vanakomana vaEsau</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>Vanakomana vaEsau vaiva:</para>
  <para style="li2" vid="1CH 1:35">Erifazi, Reueri, Jeushi, Jaramu, naKora.<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>Vana vaErifazi vaiva:</para>
  <para style="li2" vid="1CH 1:36">Temani, Omari, Zefo, Gatami, naKenazi;</para>
  <para style="li2" vid="1CH 1:36">naTimina, vakabereka Amareki.<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>Vanakomana vaReueri vaiva:</para>
  <para style="li2" vid="1CH 1:37">Nahati, Zera, Shama naMiza.<verse eid="1CH 1:37"/></para>
  <para style="s2">VaSeiri muEdhomu</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>Vanakomana vaSeiri vaiva:</para>
  <para style="li2" vid="1CH 1:38">Rotani, Shobhari, Zibheoni, Ana, Dhishoni, Ezeri naDhishani.<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>Vanakomana vaRotani vaiva:</para>
  <para style="li2" vid="1CH 1:39">Hori naHomami, Timina aiva hanzvadzi yaRotani.<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>Vanakomana vaShobhari vaiva:</para>
  <para style="li2" vid="1CH 1:40">Arivhani, Manahati, Ebhari, Shefo naOnami.</para>
  <para style="li1" vid="1CH 1:40">Vanakomana vaZibheoni vaiva:</para>
  <para style="li2" vid="1CH 1:40">Aya naAna.<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>Mwanakomana waAna</para>
  <para style="li2" vid="1CH 1:41">ainzi Dhishoni.</para>
  <para style="li1" vid="1CH 1:41">Vanakomana vaDhishoni vaiva:</para>
  <para style="li2" vid="1CH 1:41">Hemidhani, Eshibhani, Itirani naKerani.<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>Vanakomana vaEzeri vaiva:</para>
  <para style="li2" vid="1CH 1:42">Bhirihani, Zaavhani naAkani.</para>
  <para style="li1" vid="1CH 1:42">Vanakomana vaDhishani vaiva:</para>
  <para style="li2" vid="1CH 1:42">Uzi naArani.<verse eid="1CH 1:42"/></para>
  <para style="s1">Vatongi veEdhomu</para>
  <para style="li4">
    <verse number="43" style="v" sid="1CH 1:43"/>Aya ndiwo aiva madzimambo aitonga muEdhomu kusati kwava namambo upi zvake aitonga muIsraeri vaiva:</para>
  <para style="li1" vid="1CH 1:43">Bhera mwanakomana waBheori, guta rake rainzi Dhinihabha.<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>Bhera paakafa, Jobhabhi mwanakomana waZera aibva kuBhozira akamutevera paumambo.<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>Jobhabhi paakafa, Hushami aibva kunyika yevaTemani akamutevera paumambo.<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>Hushami paakafa, Hadhadhi mwanakomana waBhedhadhi uyo akakunda Midhiani munyika yaMoabhu akamutevera paumambo. Guta rake rainzi Avhiti.<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>Hadhadhi paakafa Samira aibva kuMasireka akamutevera paumambo.<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>Samira paakafa, Shauri aibva kuRehobhoti parwizi akamutevera paumambo.<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>Shauri paakafa Bhaari Hanani mwanakomana waAkibhori akamutevera paumambo.<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>Bhaari Hanani paakafa, Hadhadhi akamutevera paumambo. Guta rake rainzi Pau uye mudzimai wake ainzi Mehetabheri, mwanasikana waMatiredhi, mwanasikana waMe-Zahabhi. <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>Hadhadhi akafawo.</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="li4" vid="1CH 1:51">Madzishe eEdhomu aiva:</para>
  <para style="li1" vid="1CH 1:51">Timina, Arivha, Jeteti <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>Ohoribhama, Era, Pinoni, <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>Kenazi, Temani, Mibhiza, <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>Magidhieri naIrami.</para>
  <para style="li4" vid="1CH 1:54">Aya ndiwo aiva madzishe eEdhomu.<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">Vanakomana vaIsraeri</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 2:1"/>Ava ndivo vaiva vanakomana vaIsraeri: Rubheni, Simeoni, Revhi, Judha, Isakari, Zebhuruni, <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>Dhani, Josefa, Bhenjamini, Nafutari, Gadhi naAsheri.<verse eid="1CH 2:2"/></para>
  <para style="s1">Judha</para>
  <para style="s2">Kuvanakomana vaHezironi</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>Vanakomana vaJudha vaiva:</para>
  <para style="li2" vid="1CH 2:3">Eri, Onani naShera. Vatatu ava akavaberekerwa nomudzimai wechiKenani, mwanasikana waShua.</para>
  <para style="li2" vid="1CH 2:3">Eri dangwe raJudha, akanga akaipa pamberi paJehovha. Saka Jehovha akamuuraya.<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>Tamari muroora waJudha akamuberekera Perezi naZera.</para>
  <para style="li4" vid="1CH 2:4">Judha aiva navanakomana vashanu vose pamwe chete.<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>Vanakomana vaPerezi vaiva:</para>
  <para style="li2" vid="1CH 2:5">Hezironi naHamuri.<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>Vanakomana vaZera vaiva:</para>
  <para style="li2" vid="1CH 2:6">Zimuri, Etani, Hemani, Karikori naDharidha; vose vaiva vashanu.<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>Mwanakomana waKarimi aiva:</para>
  <para style="li2" vid="1CH 2:7">Akari, uyo akauyisa matambudziko pamusoro peIsraeri nokutyora murayiro wokusatora zvinhu zvakaereswa.<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>Mwanakomana waEtani ainzi</para>
  <para style="li2" vid="1CH 2:8">Azaria.<verse eid="1CH 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>Vanakomana vaHezironi vaiva:</para>
  <para style="li2" vid="1CH 2:9">Jerameeri, Rami naKarebhu.<verse eid="1CH 2:9"/></para>
  <para style="s2">Kubva kuna Rami mwanakomana waHezironi</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>Rami aiva baba vaAminadhabhi,</para>
  <para style="li1" vid="1CH 2:10">uye Aminadhabhi aiva baba vaNahashoni mutungamiri wavanhu veJudha.<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>Nahashoni aiva baba vaSarimoni,</para>
  <para style="li1" vid="1CH 2:11">Sarimoni ari baba vaBhoazi,<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>Bhoazi aiva baba vaObhedhi</para>
  <para style="li1" vid="1CH 2:12">uye Obhedhi aiva baba vaJese.<verse eid="1CH 2:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>Jese aiva baba</para>
  <para style="li2" vid="1CH 2:13">vaEriabhi dangwe rake; mwanakomana wake wechipiri ainzi Abhinadhabhi,</para>
  <para style="li2" vid="1CH 2:13">wechitatu ainzi Shimea, <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>wechina ainzi Netaneri,</para>
  <para style="li2" vid="1CH 2:14">wechishanu ainzi Radhai, <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>wechitanhatu ainzi Ozemi</para>
  <para style="li2" vid="1CH 2:15">uye wechinomwe ainzi Dhavhidhi.<verse eid="1CH 2:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16"/>Hanzvadzi dzavo dzaiva Zeruya naAbhigairi.</para>
  <para style="li3" vid="1CH 2:16">Vanakomana vatatu vaZeruya vaiva Abhishai, Joabhu naAsaheri.<verse eid="1CH 2:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17"/>Abhigairi aiva amai vaAmasa, baba vaAmasa vainzi Jeteri muIshumaeri.<verse eid="1CH 2:17"/></para>
  <para style="s2">Karebhu mwanakomana waHezironi</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>Karebhu mwanakomana waHezironi akabereka vana nomudzimai wake Azubha (uye naJerioti). Ava ndivo vaiva vanakomana vake:</para>
  <para style="li2" vid="1CH 2:18">Jesheri Shobhabhi naAridhoni.<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>Azubha paakafa Karebhu akaroora Efurati uyo akamuberekera Huri.<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>Huri aiva baba vaUri uye Uri aiva baba vaBhezareri.<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>Shure kwaizvozvo, Hezironi akavata nomwanasikana waMakiri baba vaGireadhi; akanga amuwana paakanga ava namakore makumi matanhatu; akamuberekera Segubhi.<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>Segubhi aiva baba vaJairi, uyo aitonga maguta makumi maviri namatatu muGireadhi.<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>(Asi Geshuri naAramu vakatapa Habhoti Jairi pamwe chete neKenati namaguta akaripoteredza, maguta makumi matanhatu.)</para>
  <para style="li4" vid="1CH 2:23">Ava vose vaiva vorudzi rwaMakiri baba vaGireadhi.<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>Mushure mokunge Hezironi afira muKarebhu Efurata, Abhija mudzimai waHezironi akamuberekera Ashuri baba vaTekoa.<verse eid="1CH 2:24"/></para>
  <para style="s2">Jerameeri mwanakomana waHezironi</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>Vanakomana vaJerameeri dangwe raHezironi vaiva:</para>
  <para style="li2" vid="1CH 2:25">Rami dangwe rake, Bhuna, Oreni, Ozemi naAhija. <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>Jerameeri akanga ane mumwe mukadzi, zita rake rainzi Atara. Akanga ari amai vaOnami.<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>Vanakomana vaRamu dangwe raJerameeri vaiva:</para>
  <para style="li2" vid="1CH 2:27">Maazi, Jamini naEkeri.<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>Vanakomana vaOnami vaiva:</para>
  <para style="li2" vid="1CH 2:28">Shamai naJadha.</para>
  <para style="li1" vid="1CH 2:28">Vanakomana vaShamai vaiva:</para>
  <para style="li2" vid="1CH 2:28">Nadhabhi naAbhishuri. <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>Mukadzi waAbhishuri ainzi Abhihairi akamuberekera Abhani naMoridhi.<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>Vanakomana vaNadhabhi vaiva:</para>
  <para style="li2" vid="1CH 2:30">Seredhi naApaimi. Seredhi akafa asina vana.<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>Mwanakomana waApaimi</para>
  <para style="li2" vid="1CH 2:31">ainzi Ishi uyo aiva baba vaSheshani. Sheshani aiva baba vaArai.<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>Vanakomana vaJadha, mununʼuna waShamai vaiva:</para>
  <para style="li2" vid="1CH 2:32">Jeteri naJonatani. Jeteri akafa asina vana.<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>Vanakomana vaJonatani vaiva:</para>
  <para style="li2" vid="1CH 2:33">Pereti naZaza.</para>
  <para style="li4" vid="1CH 2:33">Ava ndivo vaiva zvizvarwa zvaJerameeri.<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>Sheshani aiva asina vanakomana, aiva navanasikana chete.</para>
  <para style="li2" vid="1CH 2:34">Aiva nomuranda wechiIjipita ainzi Jara. <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>Sheshani akapa mwanasikana wake kuti ave mukadzi womuranda wake. Jara akamuberekera Atai.<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>Atai aiva baba vaNatani,</para>
  <para style="li1" vid="1CH 2:36">Natani aiva baba vaZabhadhi,<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>Zabhadhi baba vaEfirari,</para>
  <para style="li1" vid="1CH 2:37">Efirari baba vaObedhi,<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>Obhedhi baba vaJehu,</para>
  <para style="li1" vid="1CH 2:38">Jehu baba vaAzaria,<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>Azaria baba vaHerezi,</para>
  <para style="li1" vid="1CH 2:39">Herezi baba vaEreasa,<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>Ereasa baba vaSisimai,</para>
  <para style="li1" vid="1CH 2:40">Sisimai baba vaSharumi,<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>Sharumi baba vaJekamia,</para>
  <para style="li1" vid="1CH 2:41">uye Jekamia aiva baba vaErishama.<verse eid="1CH 2:41"/></para>
  <para style="s2">Dzimba dzaKarebhu</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>Vanakomana vaKarebhu mununʼuna waJerameeri vaiva:</para>
  <para style="li2" vid="1CH 2:42">Mesha dangwe rake, uyo aiva baba vaZifi</para>
  <para style="li2" vid="1CH 2:42">uye nomwanakomana wake Maresha, uyo aiva baba vaHebhuroni.<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>Vanakomana vaHebhuroni vaiva:</para>
  <para style="li2" vid="1CH 2:43">Kora, Tapuwa, Rekemu naShema.<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>Shema aiva baba vaRahamu,</para>
  <para style="li2" vid="1CH 2:44">uye Rahamu baba vaJorikeami.</para>
  <para style="li1" vid="1CH 2:44">Rekemu aiva baba vaShamai.<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>Mwanakomana waShamai ainzi Maoni,</para>
  <para style="li2" vid="1CH 2:45">uye Maoni aiva baba vaBheti Zuri.<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>Mumwe murongo waKarebhu ainzi Efa ndiye aiva amai</para>
  <para style="li2" vid="1CH 2:46">vaHarani, Moza naGazezi.</para>
  <para style="li2" vid="1CH 2:46">Harani aiva baba vaGazezi.<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>Vanakomana vaJadhai vaiva:</para>
  <para style="li2" vid="1CH 2:47">Regemu, Jotamu, Geshani, Pereti, Efa naShaafi.<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>Mumwe murongo waKarebhu ainzi Maaka ndiye aiva amai</para>
  <para style="li2" vid="1CH 2:48">vaShebheri naTirana.<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>Akaberekawo Shaafi baba vaMadhimana</para>
  <para style="li2" vid="1CH 2:49">naShevha baba vaMakibhena naGibhea.</para>
  <para style="li1" vid="1CH 2:49">Mwanasikana waKarebhu ainzi Akisa.<verse eid="1CH 2:49"/></para>
  <para style="li4">
    <verse number="50" style="v" sid="1CH 2:50"/>Izvi ndizvo zvizvarwa zvaKarebhu.</para>
  <para style="b" vid="1CH 2:50"/>
  <para style="li1" vid="1CH 2:50">Vanakomana vaHuri dangwe raEfurata:</para>
  <para style="li2" vid="1CH 2:50">Shobhari baba vaKiriati Jearimi, <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>Sarima baba vaBheterehema, naHarefi baba vaBheti Gadheri.<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>Zvizvarwa zvaShobhari baba vaKiriati Jearimi zvaiva:</para>
  <para style="li2" vid="1CH 2:52">Haroe, hafu yavaManahati, <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>uye dzimba dzaKiriati Jearimi dzaiva: vaItiri, vaPuti, vaShumati navaMishirai. Kuna ivava kwakabva vaZorati navaEshitaori.<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>Zvizvarwa zvaSarima zvaiva:</para>
  <para style="li2" vid="1CH 2:54">Bheterehema, vaNetofati, Atiroti Bheti Joabhu, hafu yavaManahati, vaZori, <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>uye dzimba dzavanyori vaigara paJabhezi dzaiva: vaTirati, vaShimeati navaSukati. Ava ndivo vaKeni vakabva kuna Hamati baba veimba yaRekabhi.<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s1">Vanakomana vaDhavhidhi</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 3:1"/>Ava ndivo vanakomana vaDhavhidhi vaakaberekerwa ari kuHebhuroni:</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">Dangwe rake rainzi Amunoni mwanakomana waAhinoami weJezireeri.</para>
  <para style="li1" vid="1CH 3:1">Wechipiri ainzi Dhanieri, mwanakomana waAbhigairi weKarimeri;<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>wechitatu, Abhusaromu mwanakomana waMaaka mwanasikana waTarimai mambo weGeshuri;</para>
  <para style="li1" vid="1CH 3:2">wechina, Adhoniya mwanakomana waHagiti,<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>wechishanu, Shefatia mwanakomana waAbhitari uye</para>
  <para style="li1" vid="1CH 3:3">wechitanhatu Itireami nomukadzi wake Egira.<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 3:4"/>Ava vatanhatu vakaberekerwa Dhavhidhi muHebhuroni umo maakatonga kwamakore manomwe nemwedzi mitanhatu.</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="b" vid="1CH 3:4"/>
  <para style="li4" vid="1CH 3:4">Dhavhidhi akazotonga muJerusarema kwamakore makumi matatu namatatu <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>uye ava ndivo vana vaakaberekerwa ikoko. Vaiva:</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">Shamua, Shobhabhi, Natani naSoromoni. Ava vana vakaberekwa naBhatishebha mwanasikana waAmieri.<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>Kwaivawo naIbhari, Erishua, Erifereti, <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>Noga, Nefegi, Jafia, <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>Erishama, Eriadha naErifereti, vose vaiva vapfumbamwe.<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 3:9"/>Ava vose vaiva vanakomana vaDhavhidhi, tisingaverengi vanakomana vake vaakaita navarongo vake. Uye Tamari aiva hanzvadzi yavo.<verse eid="1CH 3:9"/></para>
  <para style="s2">Madzimambo eJudha</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>Mwanakomana waSoromoni ainzi Rehobhoamu,</para>
  <para style="li1" vid="1CH 3:10">Abhija mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:10">Asa mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:10">Jehoshafati mwanakomana wake,<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>Jehoramu mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:11">Ahazia mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:11">Joashi mwanakomana wake,<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>Amazia mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:12">Azaria mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:12">Jotamu mwanakomana wake,<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>Ahazi mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:13">Hezekia mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:13">Manase mwanakomana wake,<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>Amoni mwanakomana wake,</para>
  <para style="li1" vid="1CH 3:14">Josia mwanakomana wake.<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>Vanakomana vaJosia vaiva:</para>
  <para style="li2" vid="1CH 3:15">Johanani dangwe,</para>
  <para style="li2" vid="1CH 3:15">Jehoyakimi wechipiri,</para>
  <para style="li2" vid="1CH 3:15">Zedhekia wechitatu</para>
  <para style="li2" vid="1CH 3:15">naSharumi wechina.<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>Vakatevera Jehoyakimi vaiva:</para>
  <para style="li2" vid="1CH 3:16">Jehoyakini mwanakomana wake</para>
  <para style="li2" vid="1CH 3:16">naZedhekia.<verse eid="1CH 3:16"/></para>
  <para style="s2">Veimba yoUmambo shure kwoUtapwa</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>Zvizvarwa zvaJehoyakini mutapwa zvaiva:</para>
  <para style="li2" vid="1CH 3:17">Shearitieri mwanakomana wake, <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>Marikirami, Pedhaya, Shenazari, Jekamia, Hoshama naNedhabhia.<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>Vanakomana vaPedhaya vaiva:</para>
  <para style="li2" vid="1CH 3:19">Zerubhabheri naShimei.</para>
  <para style="li1" vid="1CH 3:19">Vanakomana vaZerubhabheri vaiva:</para>
  <para style="li2" vid="1CH 3:19">Meshurami naHanania. Sheromiti aiva hanzvadzi yavo. <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>Kwaivawo navamwe vashanu vaiti: Hashubha, Oheri, Bherekia, Hasadhia naJushabhi-Hesedhi.<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>Zvizvarwa zvaHanania zvaiva:</para>
  <para style="li2" vid="1CH 3:21">Peratia naJeshaya, navanakomana vaRefaya, vaArinani, vaObhadhia nevaShekania.<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>Zvizvarwa zvaShekania zvaiva:</para>
  <para style="li2" vid="1CH 3:22">Shemaya navanakomana vake vaiti: Hatushi, Igari, Bharia, Nearia naShafati, vatanhatu vose pamwe chete.<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>Vanakomana vaNearia vaiva:</para>
  <para style="li2" vid="1CH 3:23">Erioenai, Hizikia naAzirikamu, vatatu pamwe chete.<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>Vanakomana vaErioenai vaiva:</para>
  <para style="li2" vid="1CH 3:24">Hodhavhia, Eriashibhi, Peraya, Akubhi, Johanani, Dheraya naAnani, vanomwe pamwe chete.<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s1">Dzimwe Dzimba dzaJudha</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>Zvizvarwa zvaJudha zvaiva:</para>
  <para style="li2" vid="1CH 4:1">Perezi, Hezironi, Karimi, Huri naShobhari.<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>Reaya mwanakomana waShobhari aiva baba vaJahati, uye Jahati ari baba vaAhumai naRahadhi. Idzi ndidzo dzaiva dzimba dzavaZorati.<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>Ava ndivo vaiva vanakomana vaEtami:</para>
  <para style="li2" vid="1CH 4:3">Jezireeri, Ishima naIdhibashi. Hanzvadzi yavo yainzi Hazereriponi. <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>Penueri aiva baba vaGedhori uye Ezeri aiva baba vaHusha.</para>
  <para style="li1" vid="1CH 4:4">Izvi ndizvo zvaiva zvizvarwa zvaHuri dangwe raEfurata baba vaBheterehema.<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>Ashuri baba vaTekoa vaiva navakadzi vaviri, Hera naNaara.<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>Naara akamuberekera Ahuzami, Heferi, Temeni naHaahashitari. Izvi ndizvo zvaiva zvizvarwa zvaNaara.<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>Vanakomana vaHera vaiva:</para>
  <para style="li2" vid="1CH 4:7">Zareti, Zohari, Etinani <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>naKozi uyo aiva baba vaAnubhi naHazobhebha nevedzimba dzaAhareri mwanakomana waHaruni.<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>Jabhezi aikudzwa zvikuru kukunda vanunʼuna vake. Mai vake vakamutumidza kuti Jabhezi vachiti, “Ndakamubereka mukurwadziwa.” <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>Jabhezi akachema kuna Mwari waIsraeri achiti, “Haiwa, dai mandiropafadza mukakurisa nyika yangu! Ruoko rwenyu ngaruve neni, rundichengete kune zvinokuvadza kuitira kuti ndisarwadziwa.” Uye Mwari akamupa zvaakakumbira.<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>Kerubhi, mununʼuna waShuha aiva baba vaMehiri uyo aiva baba vaEshitoni. <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>Eshitoni aiva baba vaBheti Rafa, Pasea naTehina baba vaIri Nahashi. Ava ndivo vaiva varume veReka.<verse eid="1CH 4:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>Vanakomana vaKenazi vaiva:</para>
  <para style="li2" vid="1CH 4:13">Otinieri naSeraya.</para>
  <para style="li1" vid="1CH 4:13">Vanakomana vaOtinieri vaiva:</para>
  <para style="li2" vid="1CH 4:13">Hatati naMeonotai. <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>Meonotai aiva baba vaOfira.</para>
  <para style="li1" vid="1CH 4:14">Seraya aiva baba vaJoabhu,</para>
  <para style="li2" vid="1CH 4:14">baba vaGe Harashimi. Vakapiwa zita iri nokuti vaiva mhizha.<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>Vanakomana vaKarebhu mwanakomana waJefune vaiva:</para>
  <para style="li2" vid="1CH 4:15">Iru, Era naNaami.</para>
  <para style="li1" vid="1CH 4:15">Mwanakomana waEra</para>
  <para style="li2" vid="1CH 4:15">ainzi Kenazi.<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>Vanakomana vaJehareri vaiva:</para>
  <para style="li2" vid="1CH 4:16">Zifi, Zifa, Tiria naAsareri.<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>Vanakomana vaEzira vaiva:</para>
  <para style="li2" vid="1CH 4:17">Jeteri, Meredhi, Eferi, naJaroni.</para>
  <para style="li1" vid="1CH 4:17">Mumwe wavakadzi vaMeredhi akavaberekera Miriamu, Shamai naIshibha baba vaEshitemoa. <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>Ava ndivo vaiva vana vomwanasikana waFaro ainzi Bhitia akanga aroorwa naMeredhi.</para>
  <para style="li1" vid="1CH 4:18">Mukadzi wake wechiJudha akabereka Jeredhi baba vaGedhori, Hebheri baba vaSoko, naJekutieri baba vaZanoa.<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>Vanakomana vomukadzi waHodhia, hanzvadzi yaNahamu vaiva:</para>
  <para style="li2" vid="1CH 4:19">baba vaKeira muGarimi naEshitemoa muMaakati.<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>Vanakomana vaShimoni vaiva:</para>
  <para style="li2" vid="1CH 4:20">Amunoni, Rina, Bheni-Hanani naTironi.</para>
  <para style="li1" vid="1CH 4:20">Zvizvarwa zvaIshi zvaiva:</para>
  <para style="li2" vid="1CH 4:20">Zoheti naBheni-Zoheti.<verse eid="1CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>Vanakomana vaShera mwanakomana waJudha vaiva:</para>
  <para style="li2" vid="1CH 4:21">Eri baba vaReka, Raadha baba vaMaresha nedzimba dzavairuka mucheka wakaisvonaka paBheti Ashibhea.<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>Jokimi, varume veKozebha naJoashi naSarafi vaitonga muMoabhu naJashubhi Rehemi. (Zvinyorwa izvi ndezvakare.) <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>Vaiva vaumbi vehari vaigara paNetaimi nepaGedhera; vaigarapo vachishandira mambo.<verse eid="1CH 4:23"/></para>
  <para style="s2">Simeoni</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>Zvizvarwa zvaSimeoni zvaiva:</para>
  <para style="li2" vid="1CH 4:24">Nemueri, Jamini, Jaribhi, Zera naShauri;<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>Sharumi aiva mwanakomana waShauri, Mibhisami ari mwanakomana wake naMishima mwanakomana wake.<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>Zvizvarwa zvaMishima zvaiva:</para>
  <para style="li2" vid="1CH 4:26">Hamueri mwanakomana wake, Zakuri mwanakomana wake naShimei mwanakomana wake.<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>Shimei aiva navanakomana gumi navatanhatu navanasikana vatanhatu, asi vanunʼuna vake vaiva vasina vana vakawanda; saka rudzi rwavo haruna kuwanda sokuwanda kwavanhu vavaJudha. <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>Vaigara muBheerishebha Moradha, Hazari Shuari, <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>Bhiriha, Ezemi, Toradhi, <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>Bhetueri, Horima, Zikiragi, <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>Bheti Makabhoti, Hazari Susimi, Bheti Bhiri neSharaimi. Aya ndiwo aiva maguta avo kusvikira pakutonga kwaDhavhidhi. <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>Misha yaiva yakaapoteredza yaiva: Etami, Aini, Rimoni, Tokeni neAshani, maguta mashanu <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>nemisha yose yakanga yakaapoteredza kusvika kuBhaarati. Idzi ndidzo nzvimbo dzavaigara.</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="li4" vid="1CH 4:33">Uye vakachengeta nhoroondo yezvizvarwa zvavo:<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>Meshobhabhi, Jamireki,</para>
  <para style="li1" vid="1CH 4:34">Josha mwanakomana waAmazia, <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>Joere,</para>
  <para style="li1" vid="1CH 4:35">Jehu mwanakomana waJoshibhia, mwanakomana waSeraya, mwanakomana waAsieri,<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>uye Erioenai, Jaakobha, Jeshohaya,</para>
  <para style="li1" vid="1CH 4:36">Asaya, Adhieri, Jesimieri, Bhenaya,<verse eid="1CH 4:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37"/>naZiza mwanakomana waShifi, mwanakomana waAroni mwanakomana waJedhaya, mwanakomana waShimiri, mwanakomana waShemaya.<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 4:38"/>Varume vakanyorwa pamusoro namazita avo vaiva vatungamiri vedzimba dzavo.</para>
  <para style="b" vid="1CH 4:38"/>
  <para style="p" vid="1CH 4:38">Mhuri dzavo dzakakura kwazvo <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>uye vakaenda kumucheto kweGedhori kurutivi rwokumabvazuva nomupata vachitsvakira makwai avo mafuro. <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>Vakawana mafuro akanaka kwazvo akapfuma, uye nyika yakanaka ine nzvimbo huru ine runyararo norugare. VaHamu ndivo vakanga vachimbogaramo kare.<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>Varume vane mazita akanyorwa vakauya pamazuva aHezekia mambo waJudha. Vakarwisa vaHamu mumatende avo navaMeuniwo vaivapo vakavaparadza zvachose kusvikira nhasi. Ipapo vakazogarapo munzvimbo yavo nokuti paiva namafuro amakwai avo. <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>Uye mazana mashanu avo vaiva vaSimeoni vachitungamirirwa naPeratia, Nearia, Refaya naUzieri, vanakomana vaIshi, vakandorwisa nyika yamakomo yeSeiri. <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>Vakauraya vaAmareki vakanga vasara avo vakanga vapunyuka, uye vakagarapo kusvikira nhasi.<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">Rubheni</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 5:1"/>Vanakomana vaRubheni dangwe raIsraeri. (Ndiye aiva dangwe, asi paakasvibisa nhoo yewaniso yababa vake, kodzero dzoudangwe hwake dzakapiwa kuvanakomana vaJosefa mwanakomana waIsraeri; saka haana kuzoverengerwawo munhoroondo dzamadzitateguru ake maererano nekodzero yokuberekwa kwake. <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>Uye kunyange zvazvo Judha aiva akasimba kwazvo kupfuura vana vababa vake vose, uye kunyange zvazvo mutongi akazobuda maari, kodzero youdangwe yaiva yaJosefa.) <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>Vanakomana vaRubheni dangwe raIsraeri vaiva:</para>
  <para style="b" vid="1CH 5:3"/>
  <para style="li2" vid="1CH 5:3">Hanoki, Paru, Hezironi naKarimi.<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>Zvizvarwa zvaJoere zvaiva:</para>
  <para style="li2" vid="1CH 5:4">Shemaya mwanakomana wake, Gogi mwanakomana wake,</para>
  <para style="li2" vid="1CH 5:4">Shimei mwanakomana wake, <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>Mika mwanakomana wake,</para>
  <para style="li2" vid="1CH 5:5">Reaya mwanakomana wake, naBhaari mwanakomana wake.<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>Uye naBheera mwanakomana wake uyo akatorwa akaiswa muutapwa naTigirati-Pireseri mambo weAsiria. Bheera akanga ari mutungamiri wavaRubheni.<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>Hama dzavo nedzimba dzavo dzakanyorwa munhoroondo dzamadzitateguru avo dzaiva:</para>
  <para style="li2" vid="1CH 5:7">Jeyeri aiva Ishe, naZekaria uye <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>Bhera mwanakomana waAzazi, mwanakomana waShema, mwanakomana waJoere.</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">Vakagara munzvimbo yaibva kuAroeri kusvikira kuNebho neBhaari Meoni. <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>Kumabvazuva vakatora nyika kusvikira pamuganhu wegwenga rinosvika kuRwizi Yufuratesi nokuti zvipfuwo zvavo zvakanga zvawanda muGireadhi.<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>Panguva yokutonga kwaSauro vakarwa navaHagiri vakavakunda vakagara mumatende avaHagiri mudunhu rose rokumabvazuva eGireadhi.<verse eid="1CH 5:10"/></para>
  <para style="s1">Gadhi</para>
  <para style="li4">
    <verse number="11" style="v" sid="1CH 5:11"/>VaGadhi vakanga vakavakidzana navo muBhashani kusvikira kuSareka:<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>Joere ndiye aiva ishe, Shafami ari wechipiri, kuchizotevera Janai naShafati, muBhashani.<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>Hama dzavo, tichiverenga mhuri dzavo, dzaiva:</para>
  <para style="li2" vid="1CH 5:13">Mikaeri, Meshurami, Shebha, Jorai, Jakani, Zia naEbheri, vanomwe pamwe chete.<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>Ava ndivo vaiva vanakomana vaAbhihairi mwanakomana waHuri, mwanakomana waJarowa, mwanakomana Gireadhi, mwanakomana waMikaeri, mwanakomana waJeshishai, mwanakomana waJadho, mwanakomana waBhuzi.<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>Ahi mwanakomana waAbhidhieri, mwanakomana waGuni, ndiye aiva mukuru wemhuri yavo.<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>VaGadhi vaigara muGireadhi, muBhashani nomumisha yaro yakaripoteredza, uye nomumafuro ose eSharoni kusvikira kwaanogumira.<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>Iva vose vakanyorwa munhoroondo dzamadzitateguru avo munguva yokutonga kwaJotamu mambo weJudha naJerobhoamu mambo weIsraeri.<verse eid="1CH 5:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>VaRubheni, vaGadhi nehafu yorudzi rwaManase vaiva navarume zviuru makumi mana nezvina namazana manomwe namakumi matanhatu vakanga vakagadzirira kundorwa, varume vakasimba vaigona kushandisa nhoo nomunondo, uye vaigona kushandisa uta, uye vakanga vakadzidziswa kurwa. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>Vakarwa navaHagiri, vaJeturi, vaNafishi navaNodhabhi. <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>Vakabatsirwa pakurwa navo, uye Mwari akaisa vaHagiri, navose vaiva kurutivi rwavo, mumaoko avo, nokuti vakanga vachema kwaari vari pakurwa. Akapindura minyengetero yavo nokuti vakavimba naye. <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>Vakapamba zvipfuwo zvavaHagiri zvaiti: zviuru makumi mashanu zvengamera, zviuru mazana maviri ane makumi mashanu zvamakwai nezviuru zviviri zvembongoro. Vakatapawo zviuru zana zvavanhu, <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>uye vamwe vazhinji vakaurayiwa nokuti kurwa uku kwaiva kwaMwari. Uye vakagara munyika iyoyi kusvikira pakutapwa.<verse eid="1CH 5:22"/></para>
  <para style="s1">Hafu yorudzi rwaManase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>Vanhu vehafu yorudzi rwaManase vaiva vazhinji kwazvo vakagara munyika yaibva kuBhashani ichisvika kuBhari Hemoni ndiko kuSeniri (Gomo reHemoni).<verse eid="1CH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24"/>Ava ndivo vaiva vakuru vedzimba dzavo: Eferi, Ishi, Erieri, Azireri, Jeremia, Hodhavhia naJadhieri. Ava vaiva varwi vakashinga, varume vembiri uye vari vakuru vedzimba dzavo. <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>Asi vakanga vasina kutendeka kuna Mwari wamadzibaba avo, vakaita ufeve hwokunamata vamwari vavanhu venyika iyi avo vakanga vaparadzwa naMwari pamberi pavo. <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>Saka Mwari waIsraeri akamutsa mweya waPuri mambo weAsiria iwo mweya waTigirati-Pireseri mambo weAsiria, akatapa vaRubheni, vaGadhi nehafu yorudzi rwaManase. Akavatora akandovaisa kuHarahi, Habhori, Hara nokurwizi Gozani uko kwavari kusvikira zuva ranhasi.<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">Revhi</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>Vanakomana vaRevhi vaiva</para>
  <para style="li2" vid="1CH 6:1">Gerishoni, Kohati naMerari.<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>Vanakomana vaKohati vaiva:</para>
  <para style="li2" vid="1CH 6:2">Amiramu, Izhari, Hebhuroni naUzieri.<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>Vana vaAmiramu vaiva:</para>
  <para style="li2" vid="1CH 6:3">Aroni, Mozisi naMiriamu.</para>
  <para style="li1" vid="1CH 6:3">Vanakomana vaAroni vaiva:</para>
  <para style="li2" vid="1CH 6:3">Nadhabhi, Abhihu, Ereazari naItamari.<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>Ereazari aiva baba vaFinehasi,</para>
  <para style="li2" vid="1CH 6:4">Finehasi baba vaAbhishua,<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>Abhishua baba vaBhuki,</para>
  <para style="li2" vid="1CH 6:5">Bhuki baba vaUzi,<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>Uzi baba vaZerahia,</para>
  <para style="li2" vid="1CH 6:6">Zerahia baba vaMerayoti,<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>Merayoti baba vaAmaria,</para>
  <para style="li2" vid="1CH 6:7">Amaria baba vaAhitubhi,<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>Ahitubhi baba vaZadhoki,</para>
  <para style="li2" vid="1CH 6:8">Zadhoki baba vaAhimaazi,<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>Ahimaazi baba vaAzaria,</para>
  <para style="li2" vid="1CH 6:9">Azaria baba vaJohanani,<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>Johanani baba vaAzaria.</para>
  <para style="li2" vid="1CH 6:10">(Ndiye aibata basa somuprista mutemberi yakavakwa naSoromoni muJerusarema.)<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>Azaria baba vaAmaria,</para>
  <para style="li2" vid="1CH 6:11">Amaria baba vaAhitubhi.<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>Ahitubhi baba vaZadhoki,</para>
  <para style="li2" vid="1CH 6:12">Zadhoki baba vaSharumi,<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>Sharumi baba vaHirikia,</para>
  <para style="li2" vid="1CH 6:13">Hirikia baba vaAzaria,<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>Azaria baba vaSeraya</para>
  <para style="li2" vid="1CH 6:14">uye Seraya baba vaJehozadhaki.<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>(Jehozadhaki akadzingwa Jehovha paakaendesa Judha neJerusarema kuutapwa noruoko rwaNebhukadhinezari.)<verse eid="1CH 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>Vanakomana vaRevhi vaiva:</para>
  <para style="li2" vid="1CH 6:16">Gerishoni, Kohati naMerari.<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>Aya ndiwo mazita avanakomana vaGerishoni:</para>
  <para style="li2" vid="1CH 6:17">Ribhini naShimei.<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>Vanakomana vaKohati vaiva:</para>
  <para style="li2" vid="1CH 6:18">Amiramu, Izhari, Hebhuroni naUzieri.<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>Vanakomana vaMerari vaiva:</para>
  <para style="li2" vid="1CH 6:19">Mairi naMushi.</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="li4" vid="1CH 6:19">Idzi ndidzo dzimba dzavaRevhi dzakanyorwa maererano namazita amadzibaba avo:<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>VaGerishoni:</para>
  <para style="li2" vid="1CH 6:20">Ribhini mwanakomana wake, Jehati mwanakomana wake</para>
  <para style="li2" vid="1CH 6:20">naZima mwanakomana wake, <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>Joa mwanakomana wake</para>
  <para style="li2" vid="1CH 6:21">Idho mwanakomana wake, Zera mwanakomana wake</para>
  <para style="li2" vid="1CH 6:21">naJeaterai mwanakomana wake.<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>Zvizvarwa zvaKohati zvaiva:</para>
  <para style="li2" vid="1CH 6:22">Aminadhabhi mwanakomana wake, Kora mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:22">Asiri mwanakomana wake, <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>Erikana mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:23">naEbhiasafi mwanakomana wake, Asiri mwanakomana wake,<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>naTahati mwanakomana wake, Urieri mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:24">Uzia mwanakomana wake naShauri mwanakomana wake.<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>Zvizvarwa zvaErikana zvaiva:</para>
  <para style="li2" vid="1CH 6:25">Amasai, Ahimoti,<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>Erikana mwanakomana wake, Zofai mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:26">naNahati mwanakomana wake, <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>naEriabhi mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:27">Jerohamu mwanakomana wake, naErikana mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:27">naSamueri mwanakomana wake,<verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>Vanakomana vaSamueri vaiva:</para>
  <para style="li2" vid="1CH 6:28">Joere dangwe rake</para>
  <para style="li2" vid="1CH 6:28">naAbhija mwanakomana wake wechipiri.<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>Zvizvarwa zvaMerari zvaiva:</para>
  <para style="li2" vid="1CH 6:29">Mari, Ribhini mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:29">Shimei mwanakomana wake, Uza mwanakomana wake,<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>Shimea mwanakomana wake, Hagia mwanakomana wake</para>
  <para style="li2" vid="1CH 6:30">naAsaya mwanakomana wake.<verse eid="1CH 6:30"/></para>
  <para style="s2">Vaimbi vomuTemberi</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>Ava ndivo varume vakagadzwa naDhavhidhi kuti vafambise basa rokuimba muimba yaJehovha mushure mokunge areka yawana pokuzorora imomo. <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>Vaishumira uye vaiimba pamberi petabhenakeri, muTende Rokusangana, kusvikira Soromoni avaka temberi yaJehovha muJerusarema. Vaibata basa ravo maererano nemitemo yavakanga vakadzikirwa.<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="33" style="v" sid="1CH 6:33"/>Ava ndivo varume vaibata basa pamwe chete navanakomana vavo:</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">kubva kuvaKohati:</para>
  <para style="li2" vid="1CH 6:33">Hemani muimbi,</para>
  <para style="li2" vid="1CH 6:33">mwanakomana waJoere, mwanakomana waSamueri,<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>mwanakomana waErikana,</para>
  <para style="li2" vid="1CH 6:34">mwanakomana waJerohamu, mwanakomana waErieri, mwanakomana waToa,<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>mwanakomana waZufi, mwanakomana waErikana,</para>
  <para style="li2" vid="1CH 6:35">mwanakomana waMahati, mwanakomana waAmasai,<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>mwanakomana waErikana, mwanakomana waJoere,</para>
  <para style="li2" vid="1CH 6:36">mwanakomana waAzaria, mwanakomana waZefania,<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>mwanakomana waTahati, mwanakomana waAsiri,</para>
  <para style="li2" vid="1CH 6:37">mwanakomana waEbhiasafi; mwanakomana waKora,<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>mwanakomana waIzhari, mwanakomana waKohati,</para>
  <para style="li2" vid="1CH 6:38">mwanakomana waRevhi mwanakomana waIsraeri.<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>Uye mubatsiri waHemani pabasa ainzi Asafi akanga amire kurudyi rwake:</para>
  <para style="li2" vid="1CH 6:39">Asafi mwanakomana waBherekia mwanakomana waShimea,<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>mwanakomana waMikaeri,</para>
  <para style="li2" vid="1CH 6:40">mwanakomana Bhaaseya, mwanakomana waMarikia, <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>mwanakomana waEtini,</para>
  <para style="li2" vid="1CH 6:41">mwanakomana waZera, mwanakomana waAdhaya,<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>mwanakomana waEtani, mwanakomana waZima,</para>
  <para style="li2" vid="1CH 6:42">mwanakomana waShimei, <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>mwanakomana waJahati,</para>
  <para style="li2" vid="1CH 6:43">mwanakomana waGerishoni, mwanakomana waRevhi;<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>uye kubva kuvabatsiri vavo, vaMerari, kuruboshwe rwake, vaiva:</para>
  <para style="li2" vid="1CH 6:44">Etani mwanakomana waKishi, mwanakomana waAbhidhi,</para>
  <para style="li2" vid="1CH 6:44">mwanakomana waMaruki, <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>mwanakomana waHashabhia,</para>
  <para style="li2" vid="1CH 6:45">mwanakomana waAmazia, mwanakomana waHirikia,<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>mwanakomana waAmuzi, mwanakomana waBhani,</para>
  <para style="li2" vid="1CH 6:46">mwanakomana waShemeri, <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>mwanakomana waMari,</para>
  <para style="li2" vid="1CH 6:47">mwanakomana waMushi, mwanakomana waMerari,</para>
  <para style="li2" vid="1CH 6:47">mwanakomana waRevhi.<verse eid="1CH 6:47"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>Vamwe vavo vaRevhi vakapiwa mamwe mabasa ose omutabhenakeri, imba yaMwari. <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>Asi Aroni nezvizvarwa zvake ndivo vaiisa zvipiriso paaritari yezvipiriso zvinopiswa uye nepaaritari yezvinonhuhwira maererano nezvose zvaiitwa paNzvimbo Tsvene-tsvene, vachiyananisira Israeri maererano nezvose zvakanga zvarayirwa Mozisi muranda waMwari.<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>Izvi ndizvo zvizvarwa zvaAroni:</para>
  <para style="li2" vid="1CH 6:50">Ereazari mwanakomana wake, Finehasi mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:50">Abhishua mwanakomana wake <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>Bhuki mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:51">Uzi mwanakomana wake naZerahia mwanakomana wake,<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>Merayoti mwanakomana wake, Amaria mwanakomana wake,</para>
  <para style="li2" vid="1CH 6:52">Ahitubhi mwanakomana wake, <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>Zadhoki mwanakomana wake</para>
  <para style="li2" vid="1CH 6:53">naAhimaazi mwanakomana wake.<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="54" style="v" sid="1CH 6:54"/>Idzi ndidzo dzakanga dziri nzvimbo dzavo dzavakagoverwa dzokugara senyika yavo (dzakapiwa kuzvizvarwa zvaAroni, avo vaibva kuimba yaKohati, nokuti mugove wokutanga wakanga uri wavo).<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>Vakapiwa Hebhuroni iri muJudha namafuro ose akaipoteredza. <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>Asi minda nemisha yose yakapoteredza guta iri yakapiwa kuna Karebhu mwanakomana waJefune. <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>Saka zvizvarwa zvaAroni zvakapiwa Hebhuroni (Guta routiziro) uye Ribhina, Jatiri, Eshitemoa, <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>Hireni, Dhebhiri, <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>Ashani, Juta, Bheti Shemeshi pamwe chete namafuro awo.<verse eid="1CH 6:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60"/>Uye kubva kurudzi rwaBhenjamini vakapiwa Gibheoni, Gebha Aremeti neAnatoti pamwe chete namafuro awo.</para>
  <para style="li4" vid="1CH 6:60">Maguta aya, akagoverwa pakati pedzimba dzavaKohati akanga ari gumi namatatu pamwe chete.<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>Zvimwe zvizvarwa zvaKohati zvakagoverwa maguta gumi kubva kudzimba dzorudzi rwehafu rwaManase.<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>Zvizvarwa zvaGerishoni mhuri nemhuri zvakagoverwawo maguta gumi namatatu kubva kumarudzi aIsakari, Asheri naNafutari uye nokubva kuchikamu chorudzi rwaManase chiri muBhashani.<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>Zvizvarwa zvaMerari, mhuri nemhuri zvakagoverwa maguta gumi namaviri kubva kumarudzi aRubheni, Gadhi naZebhuruni.<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="64" style="v" sid="1CH 6:64"/>Saka vaIsraeri vakapa vaRevhi maguta aya namafuro awo.<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>Kubva kurudzi rwaJudha, rwaSimeoni norwaBhenjamini vakagoverwa maguta ayo akanga arehwa namazita.<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="66" style="v" sid="1CH 6:66"/>Vamwe vedzimba dzaKohati vakapiwa kuti ive nyika yavo, maguta kubva kurudzi rwaEfuremu.<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>Munyika yamakomo yaEfuremu vakapiwa Shekemu (guta routiziro) neGezeri, <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>neJokimeami, neBheti Horoni, <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>Aijaroni, neGati Rimoni pamwe chete namafuro awo.<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>Uye kubva kuhafu yorudzi rwaManase vaIsraeri vakapawo Aneri neBhireamu pamwe chete namafuro awo kuvaKohati vakanga vasara.<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="71" style="v" sid="1CH 6:71"/>VaGerishoni vakagamuchirawo zvinotevera:</para>
  <para style="li1" vid="1CH 6:71">Kubva kuimba yehafu yorudzi rwaManase vakagamuchira Gorani muBhashani neAshitarotiwo pamwe chete namafuro awo;<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>kubva kurudzi rwaIsakari vakagamuchira Kedheshi neDhabherati, <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>Ramoti, neAnemi, pamwe chete namafuro awo;<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>kubva kurudzi rwaAsheri vakagamuchira Mashari, neAbhidhoni, <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>Hukoki neRehobhi pamwe chete namafuro awo;<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>uye kubva kurudzi rwaNafutari vakagamuchira Kedheshi muGarirea, neHamoni neKiriataimi pamwe chete namafuro awo.<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="77" style="v" sid="1CH 6:77"/>VaMerari (vaRevhi vose vakanga vasara) vakagamuchira zvinotevera:</para>
  <para style="li1" vid="1CH 6:77">Kubva kurudzi rwaZebhuruni vakagamuchira Jokineami, Karita Rimono, neTabhori pamwe chete namafuro awo;<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>kubva kurudzi rwaRubheni mhiri kworwizi Jorodhani kumabvazuva kweJeriko vakagamuchirwawo Bhezeri murenje, Jaza, <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>Kedhemoti neMefaati pamwe chete namafuro awo;<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>uye kubva kurudzi rwaGadhi vakagamuchira Ramoti muGireadhi, Mahanaimi, <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>Heshibhoni neJazeri pamwe chete namafuro awo.<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">Isakari</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>Vanakomana vaIsakari vaiva:</para>
  <para style="li2" vid="1CH 7:1">Tora, Puwa, Jashubhi, naShimironi; vose vaiva vana.<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>Vanakomana vaTora vaiva:</para>
  <para style="li2" vid="1CH 7:2">Uzi, Refaya, Jerieri, Jamai, Ibhisami naSamueri, vakuru vedzimba dzavo. Pamazuva okutonga kwaDhavhidhi, zvizvarwa zvaTora zvakaverengwa savarwi munhoroondo yavo zvakasvika zviuru zvina makumi maviri nezviviri namazana matanhatu.<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>Mwanakomana waUzi aiva:</para>
  <para style="li2" vid="1CH 7:3">Izirahia.</para>
  <para style="li1" vid="1CH 7:3">Vanakomana vaIzirahia vaiva:</para>
  <para style="li2" vid="1CH 7:3">Mikaeri, Obhadhia, Joere naIshia. Vose vari vashanu vaiva madzishe. <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>Munhoroondo yemhuri yavo, vakanga vaine varume zviuru makumi matatu nezvitanhatu vakanga vakagadzirira kurwa, nokuti vakanga vaine vakadzi vazhinji navanakomana vazhinji.<verse eid="1CH 7:4"/></para>
  <para style="li4">
    <verse number="5" style="v" sid="1CH 7:5"/>Hama dzavo vakanga vari varume vokurwa vari vedzimba dzose dzaIsakari, sokunyorwa kwazvakanga zvakaita munhoroondo yavo, vose vaisvika zviuru makumi masere nezvinomwe.<verse eid="1CH 7:5"/></para>
  <para style="s1">Bhenjamini</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>Vanakomana vaBhenjamini vatatu vaiva:</para>
  <para style="li2" vid="1CH 7:6">Bhera, Bhekeri, naJedhiaeri.<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>Vanakomana vaBhera vaiva:</para>
  <para style="li2" vid="1CH 7:7">Ezibhoni, Uzi, Uzieri, Jerimoti naIri, vose vakuru vedzimba vashanu pamwe chete. Munhoroondo yavo varwi vakanyorwa vaiva varume zviuru makumi maviri nezviviri namakumi matatu navana.<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>Vanakomana vaBhekeri vaiva:</para>
  <para style="li2" vid="1CH 7:8">Zemira, Joashi, Eriezeri, Erioenai, Omiri, Jeremoti, Abhija, Anatoti naAremeti. Vose ava vaiva vakomana vaBhekeri. <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>Munhoroondo yavo, vakuru vemhuri vakanyorwa uye vari varwi vaiva zviuru makumi maviri namazana maviri.<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>Mwanakomana waJedhiaeri</para>
  <para style="li2" vid="1CH 7:10">ainzi Bhirihani.</para>
  <para style="li1" vid="1CH 7:10">Vanakomana vaBhirihani vaiva:</para>
  <para style="li2" vid="1CH 7:10">Jehushi, Bhenjamini, Ehudhi, Kenana, Zetani, Tashishi naAhishahari. <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>Vanakomana ava vose vaJedhiaeri vaiva vakuru vemhuri. Paiva nezviuru gumi nezvinomwe namazana maviri avarume vokurwa vakanga vakagadzirira kuenda kuhondo.<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>VaShupi navaHupi vaiva zvizvarwa zvaIri, uye vaHushi vaiva zvizvarwa zvaAheri.<verse eid="1CH 7:12"/></para>
  <para style="s1">Nafutari</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>Vanakomana vaNafutari vaiva:</para>
  <para style="li2" vid="1CH 7:13">Jazieri, Guni, Jezeri naShiremi, zvizvarwa zvaBhiriha.<verse eid="1CH 7:13"/></para>
  <para style="s1">Manase</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>Zvizvarwa zvaManase zvaiva:</para>
  <para style="li2" vid="1CH 7:14">Asirieri chizvarwa chake kubudikidza nomurongo wake muAramu. Iye akaberekawo Makiri baba vaGireadhi. <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>Makiri akatora mukadzi kubva pakati pavaHupi navaShupi. Zita rehanzvadzi yake rainzi Maaka. Chimwezve chizvarwa chainzi Zerofehadhi, akanga aine vanasikana chete. <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>Mukadzi waMakiri Maaka akabereka mwanakomana akamutumidza zita rokuti Pereshi. Mununʼuna wake ainzi Shereshi, uye vanakomana vake vaiva Uramu naRakemu.<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>Mwanakomana waUramu</para>
  <para style="li2" vid="1CH 7:17">ainzi Bhedhani.</para>
  <para style="li1" vid="1CH 7:17">Ava ndivo vaiva vanakomana vaGireadhi mwanakomana waMakiri mwanakomana waManase.<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>Hanzvadzi yake Hamoreketi akabereka Ishodhi, Abhiezeri naMara.<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>Vanakomana vaShimidha vaiva:</para>
  <para style="li2" vid="1CH 7:19">Ahiani, Shekemu, Riki naAniami.<verse eid="1CH 7:19"/></para>
  <para style="s1">Efuremu</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>Zvizvarwa zvaEfuremu zvaiva:</para>
  <para style="li2" vid="1CH 7:20">Shutera, Bheredhi mwanakomana wake,</para>
  <para style="li2" vid="1CH 7:20">Tahati mwanakomana wake, Ereadha mwanakomana wake,</para>
  <para style="li2" vid="1CH 7:20">Tahati mwanakomana wake, <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>Zabhadhi mwanakomana wake</para>
  <para style="li2" vid="1CH 7:21">naShutera mwanakomana wake.</para>
  <para style="li2" vid="1CH 7:21">(Ezeri naEreadha vakaurayiwa navarume veGati vakanga vakaberekerwa munyika iyi pavakaburukira kundopamba zvipfuwo zvavo. <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>Baba wavo Efuremu akavachema kwamazuva mazhinji uye hama dzake dzakauya kuzomunyaradza. <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>Ipapo akarara nomukadzi wake zvakare akava nemimba uye akabereka mwanakomana. Akamutumidza zita rokuti Bheria nokuti mumhuri yake makanga maita dambudziko. <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>Mwanasikana wake ainzi Sheera, uye akavaka Bheti Horoni, yeZasi neyokumusoro uyewo neUzeni Sheera.)<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>Refa aiva mwanakomana wake, Reshefi mwanakomana wake,</para>
  <para style="li2" vid="1CH 7:25">Tera mwanakomana wake, Tahani mwanakomana wake,<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>Radhani mwanakomana wake, Amihudhi mwanakomana wake,</para>
  <para style="li2" vid="1CH 7:26">Erishama mwanakomana wake, <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>Nuni mwanakomana wake</para>
  <para style="li2" vid="1CH 7:27">naJoshua mwanakomana wake.<verse eid="1CH 7:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 7:28"/>Nyika dzavo nemisha yavo zvaisanganisira Bheteri nemisha yose yakaripoteredza, Naarani kumabvazuva, Gezeri nemisha yaro, kumavirira neShekemu nemisha yaro kuenda kunosvika kuAya nemisha yaro. <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>Pamiganhu yaManase paiva neBheti Shani, Taanaki, Megidho neDhori pamwe chete nemisha yawo. Zvizvarwa zvaJosefa mwanakomana waIsraeri zvaigara mumaguta aya.<verse eid="1CH 7:29"/></para>
  <para style="s1">Asheri</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>Vanakomana vaAsheri vaiva:</para>
  <para style="li2" vid="1CH 7:30">Imina, Ishivha, Ishivhi naBheria. Hanzvadzi yavo yainzi Sera.<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>Vanakomana vaBheria vaiva:</para>
  <para style="li2" vid="1CH 7:31">Hebheri naMarikieri, uyo aiva baba vaBhirizaiti.<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>Hebheri aiva baba vaJafireti, Shomeri naHotami uye nehanzvadzi yavo Shua.<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>Vanakomana vaJafireti vaiva:</para>
  <para style="li2" vid="1CH 7:33">Pasaki, Bhimari naAshivhati.</para>
  <para style="li4" vid="1CH 7:33">Ava ndivo vaiva vanakomana vaJafireti.<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>Vanakomana vaShomeri vaiva:</para>
  <para style="li2" vid="1CH 7:34">Ahi, Roga, Hubhai naAramu.<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>Vanakomana vomununʼuna wake Heremu vaiva:</para>
  <para style="li2" vid="1CH 7:35">Zofa, Imina, Shereshi, naAmari.<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>Vanakomana vaZofa vaiva:</para>
  <para style="li2" vid="1CH 7:36">Sua, Haneferi, Shuari, Bheri, Imira, <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>Bhezeri, Hodhi, Shama Shirisha, Itirani, naBheera.<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>Vanakomana vaJeteri vaiva:</para>
  <para style="li2" vid="1CH 7:38">Jefune, Pisipa naAra.<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>Vanakomana vaUra vaiva:</para>
  <para style="li2" vid="1CH 7:39">Ara, Hanieri, naRizia.<verse eid="1CH 7:39"/></para>
  <para style="li4">
    <verse number="40" style="v" sid="1CH 7:40"/>Vose ava vaiva zvizvarwa zvaAsheri, vakuru vemhuri yavo, varume vakanga vakasarudzika, varwi vakanga vakashinga uye vari vatungamiri vakasanangurika. Uwandu hwavarume vakanga vakagadzirira kurwa sezvazvakanyorwa munhoroondo yavo hwaiva zviuru makumi maviri nezvitanhatu.<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">Nhoroondo yaSauro muBhenjamini</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>Bhenjamini aiva baba</para>
  <para style="li2" vid="1CH 8:1">vaBhera dangwe rake,</para>
  <para style="li2" vid="1CH 8:1">Ashibheri mwanakomana wechipiri, Ahara wechitatu,<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>Noha wechina naRafa wechishanu.<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>Vanakomana vaBhera vaiva:</para>
  <para style="li2" vid="1CH 8:3">Adha, Gera, Abhihudhi, <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>Abhishua, Naamani Ahoa, <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>Gera, Shefufani naHurami.<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>Izvi ndizvo zvaiva zvizvarwa zvaEhudhi vakanga vari vakuru vemhuri yeavo vaigara muGebha vakazodzingwa vakaendeswa kuManahati:<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>Naamani, Ahifa naGera, uyo akavadzinga uya aiva baba vaUza naArihudhi.<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>Vanakomana vakaberekerwa Shaharaimi muMoabhu mushure mokunge arambana navakadzi vake Hushini naBhaara. <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>Nomukadzi wake Hodheshi akabereka Johabhi, Zibhia, Mesha Marikami, <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>Jeuzi, Sakia naMirima. Ava ndivo vaiva vanakomana vake, vakuru vemhuri. <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>NaHushimi akabereka Abhitubhi naEripaari.<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>Vanakomana vaEripaari vaiva:</para>
  <para style="li2" vid="1CH 8:12">Ebheri, Mishamu, Shemedhi (uyo akavaka Ono neRodhi pamwe chete nemisha yakaapoteredza) <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>naBheria naShema, avo vakanga vari vakuru vemhuri dzaavo vaigara muAijaroni uye vakadzinga vagari veGati.<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>Ahiyo, Shashaki, Jeremoti, <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>Zebhabhia, Aradhi, Edheri, <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>Mikaeri, Ishipa naJoha vaiva vanakomana vaBeria.<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>Zebhadhia, Meshurami, Hiziki, Hebheri, <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>Ishimerai, Iziria naJobhabhi vaiva vanakomana vaEripaari.<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>Jakimi, Zikiri, Zabhidhi, <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>Erienai, Ziretai, Erieri, <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>Adhaya, Bheraya naShimirati vaiva vanakomana vaShimei.<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>Ishipani, Ebheri, Erieri, <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>Abhidhoni, Zikiri, Hanani, <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>Hanania, Eramu Anitotiya, <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>Ifidheya naPenueri vaiva vanakomana vaShashaki.<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>Shamisherai, Sheharia, Ataria, <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>Jaareshia, Eria, naZikiri vaiva vanakomana vaJerohamu.<verse eid="1CH 8:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 8:28"/>Vose ava vaiva vakuru vemhuri, vari madzishe sezvazvakanyorwa munhoroondo dzavo. Uye vaigara muJerusarema.<verse eid="1CH 8:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>Jeyeri, baba vaGibheoni vaigara muGibheoni.</para>
  <para style="li2" vid="1CH 8:29">Zita romukadzi wake rainzi Maaka, <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>uye mwanakomana wake wedangwe ainzi Abhidhoni, achiteverwa naZuri, Kishi, Bhaari, Neri, Nadhabhi, <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>Gedhori, Ahio, Zekeri, <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>uye Mikiroti, uyo aiva baba vaShimea. Ivo vaigarawo pedyo nehama dzavo muJerusarema.<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>Neri aiva baba vaKishi, Kishi aiva baba vaSauro, uye Sauro aiva baba vaJonatani, Mariki-Shua, Abinadhabhi, naEshi-Bhaari.<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>Mwanakomana waJonatani ainzi</para>
  <para style="li2" vid="1CH 8:34">Meribhi-Bhaari uyo aiva baba vaMika.<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>Vanakomana vaMika vaiva:</para>
  <para style="li2" vid="1CH 8:35">Pitoni, Mereki Tarea, naAhazi.<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>Ahazi aiva baba vaJehoadha, Jehoadha aiva baba vaAremeti, Azimavheti naZimiri uye Zimiri aiva baba vaMoza. <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>Moza aiva baba vaBhinea Rafa aiva mwanakomana wake, Ereasa mwanakomana wake naAzeri mwanakomana wake.<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>Azeri aiva navanakomana vatanhatu, uye aya ndiwo mazita avo:</para>
  <para style="li2" vid="1CH 8:38">Arizakami, Bhokeru, Ishumaeri, Shearia, Obhadhia naHanani. Vose ava vaiva vanakomana vaAzeri.<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>Vanakomana vomununʼuna wake Esheki vaiva:</para>
  <para style="li2" vid="1CH 8:39">Uramu dangwe rake, Jeushi mwanakomana wake wechipiri naErifereti wechitatu. <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>Vanakomana vaUramu vaiva varwi voumhare vaigona kushandisa uta. Vaiva navanakomana navazukuru vazhinji vaisvika zana namakumi mashanu pamwe chete.</para>
  <para style="li1" vid="1CH 8:40">Vose ava vaiva zvizvarwa zvaBhenjamini.<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>VaIsraeri vose vakanyorwa munhoroondo dzakanyorwa mubhuku ramadzimambo eIsraeri.</para>
  <para style="s1" vid="1CH 9:1">Vanhu vaigara muJerusarema</para>
  <para style="li4" vid="1CH 9:1">VaJudha vakatapwa vakaendeswa kuBhabhironi nokuda kwokusatendeka kwavo. <verse eid="1CH 9:1"/><verse number="2" style="v" sid="1CH 9:2"/>Zvino vakatanga kugara panyika yavo mumaguta avo vaiva vamwe vaIsraeri, vaprista, vaRevhi navaranda vomutemberi.<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="1CH 9:3"/>Avo vaibva kuJudha, nevaibva kwaBhenjamini nevaibva kwaEfuremu naManase vaigara muJerusarema vaiva:<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>Utai mwanakomana waAmihudhi, mwanakomana waOmuri, mwanakomana waImiri, mwanakomana waBhani, chizvarwa chaPerezi mwanakomana waJudha.<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>VaShiro:</para>
  <para style="li2" vid="1CH 9:5">Asaya uyo aiva dangwe navanakomana vake.<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>VaZerahi:</para>
  <para style="li2" vid="1CH 9:6">Jeueri.</para>
  <para style="li4" vid="1CH 9:6">Vanhu vaibva kuJudha vaiva mazana matanhatu namakumi mapfumbamwe.<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="7" style="v" sid="1CH 9:7"/>VaBhenjamini:</para>
  <para style="li1" vid="1CH 9:7">Saru mwanakomana waMeshurami, mwanakomana waHodhavhia, mwanakomana waHasenua;<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>Ibhineya mwanakomana waJerohamu;</para>
  <para style="li1" vid="1CH 9:8">Era mwanakomana waUzi, mwanakomana waMikiri;</para>
  <para style="li1" vid="1CH 9:8">naMeshurami mwanakomana waShefatia, mwanakomana waReueri, mwanakomana waIbhiniya.<verse eid="1CH 9:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 9:9"/>Vanhu vorudzi rwaBhenjamini sezvazvakanyorwa munhoroondo yavo, vaisvika mazana mapfumbamwe namakumi mashanu navatanhatu. Varume ava vose vakanga vari vakuru vemhuri.<verse eid="1CH 9:9"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="10" style="v" sid="1CH 9:10"/>Vaprista:</para>
  <para style="li1" vid="1CH 9:10">Jedhaya, naJehoyaribhi naJakini;<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>Azaria mwanakomana waHirikia, mwanakomana waMeshurami, mwanakomana waZadhoki, mwanakomana waMerayoti, mwanakomana waAhitubhi, mubati mukuru muimba yaMwari.<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>Adhaya mwanakomana waJerohamu, mwanakomana waPashuri, mwanakomana waMarikia;</para>
  <para style="li1" vid="1CH 9:12">naMaasai mwanakomana waAdhieri, mwanakomana waJahazera, mwanakomana waMeshurami, mwanakomana waMeshiremiti, mwanakomana waIma.<verse eid="1CH 9:12"/></para>
  <para style="li4">
    <verse number="13" style="v" sid="1CH 9:13"/>Vaprista, vaiva vakuru vemhuri, vaisvika chiuru namazana manomwe namakumi matanhatu. Vose vaiva varume vaikwanisa uye vaibata basa rokushumira muimba yaMwari.<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="14" style="v" sid="1CH 9:14"/>VaRevhi:</para>
  <para style="li1" vid="1CH 9:14">Shemaya mwanakomana waHashubhi, mwanakomana waAzirikami, mwanakomana waHashabhia, muMerari;<verse eid="1CH 9:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15"/>Bhakibhaka, Hereshi, Garari naMatania mwanakomana waMika, mwanakomana waZikiri, mwanakomana waAsafi;<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>Obhadhia mwanakomana waShemaya, mwanakomana waGarari, mwanakomana waJedhutuni;</para>
  <para style="li1" vid="1CH 9:16">naBherekia mwanakomana waAsa, mwanakomana waErikana, vaigara mumisha yavaNetofati.<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="17" style="v" sid="1CH 9:17"/>Vatariri vamasuo:</para>
  <para style="li1" vid="1CH 9:17">Sharumi, Akubhi, Tarimoni, Ahimani navanunʼuna vavo, Sharumi ari mukuru wavo, <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>vakaiswa paSuo raMambo kumabvazuva, kusvikira nanhasi. Ava ndivo vaiva vatariri vamasuo, okumusasa wavaRevhi.<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>Sharumi mwanakomana waKore mwanakomana waEbhiasafi, mwanakomana waKora navamwe vatariri vamasuo vokumhuri yake, vaKora, vaiva nebasa rokuchengetedza mikova yeTende sezvaingoitwa namadzibaba avo vakanga vane basa rokurinda suo rokupinda kuugaro hwaJehovha.<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>Panguva dzapakutanga Finehasi mwanakomana waEreazari ndiye aiva mukuru wavatariri vamasuo, uye Jehovha aiva naye.<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>Zekaria mwanakomana waMesheremia aiva mutariri wesuo pamukova weTende Rokusangana.<verse eid="1CH 9:21"/></para>
  <para style="li4">
    <verse number="22" style="v" sid="1CH 9:22"/>Vose pamwe chete vakanga vasarudzwa kuti vave vatariri vamasuo pamikova vaisvika mazana maviri negumi navaviri.</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">Vakanga vakanyorwa munhoroondo dzokuberekwa dzemisha yavo. Vatariri vamasuo vakapiwa mabasa avo nenzvimbo dzavo naDhavhidhi naSamueri muoni. <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>Ivo nezvizvarwa zvavo vaiva nebasa rokurinda masuo eimba yaJehovha, imba yainzi Tende. <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>Vatariri vamasuo vaiva kumativi mana, kumabvazuva, kumavirira, kumusoro nezasi. <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>Vanunʼuna vavo mumisha yavo vaiuya nguva nenguva vachizogoverana mabasa avo vachiita madzoro amazuva manomwe. <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>Asi vakuru vana pakati pavatariri vamasuo, vaiva vaRevhi, vakapiwa basa rokuchengetedza makamuri namatura epfuma muimba yaMwari. <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>Vaipedza usiku hwose vari panzvimbo dzavo vakapoteredza imba yaMwari, nokuti vaifanira kuichengetedza; uye vaiva nebasa rokuizarura mangwanani oga oga.<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>Vamwe vavo vaiva nebasa rokuchengetedza midziyo yaishandiswa muTemberi; vaiiverenga ichibuda voiverengazve yodzorerwa. <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>Vamwe vakapiwa basa rokuti vachengetedze nhumbi nemimwe midziyo yose yapanzvimbo tsvene pamwe chete noupfu hwakatsetseka newaini, namafuta, nezvinonhuhwira nemiti inonhuhwira. <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>Asi vamwe vavaprista vaiitawo basa rokusanganisa miti inonhuhwira. <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>MuRevhi ainzi Matitia, dangwe raSharumi muKora, akagadzwa basa rokubika chingwa chechipiriso. <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>Vamwe vehama dzavo vaKohati vakapiwa basa rokubika chingwa chaizoiswa patafura pamaSabata ose.<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>Avo vaiva vaimbi, vakuru vemhuri dzavaRevhi, vaigara mumakamuri omuTemberi uye vaisaita mamwe mabasa ose nokuti vaifanira kuita basa iri masikati nousiku.<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>Ava vose vaiva vakuru vemhuri dzavaRevhi, vakuru sezvavakanyorwa munhoroondo dzokuberekwa kwavo. Uye vaigara muJerusarema.<verse eid="1CH 9:34"/></para>
  <para style="s1">Nhoroondo yoRudzi rwaSauro</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>Jeyeri baba vaGibheoni aigara muGibheoni.</para>
  <para style="li2" vid="1CH 9:35">Mukadzi wake ainzi Maaka, <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>uye dangwe rake raivawo Abhidhoni, achiteverwa naZuri, Kishi, Bhaari, Neri, Nadhabhi, <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>Gedhori, Ahio, Zekaria naMikiroti. <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>Mikiroti aiva baba vaShimeamu. Ivowo vaigara pedyo nehama dzavo muJerusarema.<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>Neri aiva baba vaKishi, Kishi ari baba vaSauro, uye Sauro aiva baba vaJonatani, Mariki-Shua, Abhinadhabhi naEshi-Bhaari.<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>Mwanakomana waJonatani ainzi</para>
  <para style="li2" vid="1CH 9:40">Meribhi-Bhaari uye aiva baba vaMika.<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>Vanakomana vaMika</para>
  <para style="li2" vid="1CH 9:41">vaiva Pitoni: Mereki, Tahirea naAhazi.<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>Ahazi aiva baba vaJadha, Jadha aiva baba vaAremeti, Azimavheti naZimiri, uye Zimiri aiva baba vaMoza. <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>Moza aiva baba vaBhinea; Refaya aiva mwanakomana wake, Ereasa mwanakomana wake naAzeri mwanakomana wake.<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>Azeri aiva navanakomana vatanhatu, uye aya ndiwo mazita avo:</para>
  <para style="li2" vid="1CH 9:44">Azirikami, Bhokeru, Ishumaeri, Sheariya, Obhadhia naHanani. Ava ndivo vaiva vana vaAzeri.<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">Sauro anozviuraya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>Zvino vaFiristia vakarwisa vaIsraeri; vaIsraeri vakatiza pamberi pavo, vazhinji vakaurayiwa paGomo reGiribhoa. <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>VaFiristia vakatevera Sauro navanakomana vake kwazvo uyezve vakauraya vanakomana vake Jonatani, Abhinadhabhi naMariki-Shua. <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>Hondo yakarwiwa zvinotyisa kumativi ose aSauro uye vapfuri vouta pavakamubata, vakamukuvadza.<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>Sauro akati kumubati wenhumbi dzake dzokurwa, “Vhomora munondo wako undibaye nawo kuti varume ava vasina kudzingiswa varege kuuya vakanditambudza.”</para>
  <para style="p" vid="1CH 10:4">Asi mubati wenhumbi dzake dzokurwa akatya kwazvo akasada kuzviita; saka Sauro akatora munondo wake akazviwisira pauri. <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>Mubati wenhumbi dzake dzokurwa paakaona kuti Sauro afa, iyewo akazviwisira pamunondo wake akafa. <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>Saka Sauro navanakomana vake vatatu neimba yake yose vakafa pamwe chete.<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>Zvino vaIsraeri vose vakanga vagere pamupata vakati vaona kuti varwi vose vakanga vatiza uye Sauro navanakomana vake vatatu vakanga vafa, vakasiya maguta avo vakatiza. Uye vaFiristia vakauya vakagara maari.<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>Zuva raitevera, vaFiristia pavakauya kuzokutunura nhumbi dzavakanga vafa; vakawana Sauro navanakomana vake vakafa pagomo reGiribhoa. <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>Vakamukutunura nhumbi dzake uye vakatora musoro wake nezvombo zvake vakatuma nhume munyika yose yavaFiristia kuti vandoparadzira shoko iri pakati pavamwari vavo uye navanhu vavo. <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>Vakaisa zvombo zvake mutemberi yavamwari vavo vakaturika musoro wake mutemberi yaDhagoni.<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>Vagari vose vomuJabheshi Gireadhi pavakanzwa zvose zvakanga zvaitwa navaFiristia kuna Sauro, <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>mhare dzose dzakasimuka dzikandotora zvitunha zvaSauro, navanakomana vake vakauya nazvo kuJabheshi vakaviga mapfupa avo pamuti mukuru weJabheshi uye vakatsanya kwamazuva manomwe.<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>Sauro akafa nokuti akanga asina kutendeka kuna Jehovha, haana kuchengeta shoko raJehovha uyezve akandobvunzira kumasvikiro kuti atungamirirwe. <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>Haana kubvunza kuna Jehovha. Saka Jehovha akamuuraya akapa umambo kuna Dhavhidhi mwanakomana waJese.<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">Dhavhidhi anova Mambo weIsraeri</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>VaIsraeri vose vakaungana kuna Dhavhidhi paHebhuroni vakati, “Isu tiri nyama yenyu neropa renyu. <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>Kare kunyange Sauro paaiva mambo ndimi maitungamirira Israeri kundorwa. Uye Jehovha Mwari wenyu akati kwamuri, ‘Uchafudza vanhu vangu vaIsraeri uye uchava mutongi wavo.’ ”<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>Vakuru vose veIsraeri pavakauya kuna mambo Dhavhidhi paHebhuroni, akaita sungano navo paHebhuroni pamberi paJehovha, uye vakazodza Dhavhidhi kuti ave mambo weIsraeri sezvakanga zvavimbiswa naJehovha kubudikidza naSamueri.<verse eid="1CH 11:3"/></para>
  <para style="s1">Dhavhidhi anokunda Jerusarema</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>Dhavhidhi navaIsraeri vose vakaenda kuJerusarema (ndiro Jebhusi). VaJebhusi vaigaramo <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>vakati kuna Dhavhidhi, “Hamusi kuzopinda muno.” Kunyange zvakadaro Dhavhidhi akatapa nhare yeZioni, Guta raDhavhidhi.<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>Dhavhidhi akanga ati, “Achatungamirira kundorwisa vaJebhusi ndiye achava mukuru wavarwi.” Joabhu mwanakomana waZeruya ndiye akatanga kuenda, saka akapiwa utungamiri hwacho.<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>Dhavhidhi akagara munhare yeZioni, saka rakazodaidzwa kuti Guta raDhavhidhi. <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>Akavaka guta richipoteredza, kubva pamihomba yokutsigira kusvikira kurusvingo rwakanga rwakapoteredza, Joabhu achivaka patsva chimwe chikamu chose cheguta. <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>Uye Dhavhidhi akaramba achiva nesimba guru nokuti Jehovha Wamasimba Ose aiva naye.<verse eid="1CH 11:9"/></para>
  <para style="s1">Machinda aDhavhidhi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>Ava ndivo vaiva vakuru pakati pavarume voumhare vaiva naDhavhidhi, avo pamwe chete neIsraeri yose, vakatsigira umambo hwake zvakasimba kuti husvike munyika yose sokuvimbisa kwakanga kwaita Jehovha. <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>Aya ndiwo mazita avarume voumhare vaiva naDhavhidhi:</para>
  <para style="p" vid="1CH 11:11">Jashobheami, muHakimoni, aiva mukuru wamachinda ehondo; akasimudza pfumo rake akarwa navarume mazana matatu, avo vaakauraya pakurwisana panguva imwe chete.<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>Aimutevera ainzi Ereazari mwanakomana waDhodhai muAhohi mumwe wavarume voumhare vatatu. <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>Aiva naDhavhidhi paPasi Dhamimi vaFiristia pavakaungana ipapo kuzorwa. Pane imwe nzvimbo paiva nomunda wakanga uzere nebhari, varwi vakatiza vaFiristia. <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>Asi ivo vakaramba vamire pakati pomunda vakaurwira vakauraya vaFiristia uye Jehovha akaita kuti vakunde nokukunda kukuru.<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>Vatatu pakati pamakumi matatu avakuru vakaburukira kuna Dhavhidhi kuDombo pabako reAdhurami, uye hondo yavaFiristia yakanga yadzika matende muMupata weRefaimi. <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>Panguva iyoyo Dhavhidhi akanga ari munhare, uye boka rehondo yavaFiristia rakanga riri paBheterehema. <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>Dhavhidhi akanzwa nyota akati, “Haiwa, dai mumwe munhu ainondicherera mvura yokunwa kubva mutsime riri pedyo nesuo reBheterehema!” <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>Saka Vatatu ava vakapinda napakati pehondo dzavaFiristia, vakachera mvura kubva mutsime raiva pedyo nesuo reBheterehema vakaenda nayo kuna Dhavhidhi. Asi akaramba kuinwa akaidururira pasi pamberi paJehovha. <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>Dhavhidhi akati, “Mwari ngaandidzivise ndiregere kunwa izvi! Ndinganwa here ropa ravarume ava vaenda vachiisa upenyu hwavo panjodzi?” Nokuti vakaisa upenyu hwavo panjodzi kuti vadzoke vanayo, Dhavhidhi akaramba kuinwa.</para>
  <para style="p" vid="1CH 11:19">Aya ndiwo mamwe amabasa okukunda akaitwa navarume voumhare vatatu.<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>Abhishai mununʼuna waJoabhu akanga ari mukuru waVatatu Ava. Akasimudza pfumo rake kuti arwise varume mazana matatu, akavauraya, uye akava nomukurumbira saVatatu Vaya. <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>Akaremekedzwa zvakapetwa kaviri pamusoro paVatatu Vaya uye akaitwa mutungamiri wavo, kunyange zvazvo akanga asina kuverengerwa pakati pavo.<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>Bhenaya mwanakomana waJehoyadha aiva murwi woumhare aibva kuKabhizeeri, akaita mabasa makuru. Akauraya mhare mbiri dzapamusoro dzavaMoabhu. Akapindawo mugomba mumwe musi kuine chando akauraya shumba. <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>Uye akauraya muIjipita akanga akareba makubhiti mashanu<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">mamita angaita 2.3</char></note>. Kunyange zvazvo muIjipita akanga akapakata pfumo rainge tsvimbo yomuruki muruoko rwake, Bhenaya akamurwisa netsvimbo. Akabvuta pfumo kubva muruoko rwomuIjipita akamuuraya nepfumo rake. <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>Aya ndiwo aiva mabasa aBhenaya mwanakomana waJehoyadha; naiyewo akaita mukurumbira savarume vatatu voumhare. <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>Akakudzwa nokuremekedzwa kukuru kupfuura Vaya Makumi Matatu, asi akanga asiri pakati paVatatu Vaya. Uye Dhavhidhi akamuita mutariri wavarindi vake.<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="26" style="v" sid="1CH 11:26"/>Varume voumhare vaiva:</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">Asaheri mununʼuna waJoabhu,</para>
  <para style="li1" vid="1CH 11:26">Erihanani mwanakomana waDhodho aibva kuBheterehema.<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>Shamoti muHarori,</para>
  <para style="li1" vid="1CH 11:27">Herezi muPeroni,<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>Ira mwanakomana waIkeshi aibva kuTekoa,</para>
  <para style="li1" vid="1CH 11:28">Abhiezeri aibva kuAnatoti,<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>Sibhekai muHushati,</para>
  <para style="li1" vid="1CH 11:29">Irai muAhohi,<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>Maharai muNetofati,</para>
  <para style="li1" vid="1CH 11:30">Heredhi mwanakomana waBhaana muNetofati,<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>Itai mwanakomana waRibhai aibva kuGibhea muBhenjamini,</para>
  <para style="li1" vid="1CH 11:31">Bhenaya muPiratoni,<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>Hurai aibva kuhova dzeGaashi,</para>
  <para style="li1" vid="1CH 11:32">Abhieri muAribhati,<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>Azimavheti muBhaharumi,</para>
  <para style="li1" vid="1CH 11:33">Eriabha muShaaribhoni,<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>vanakomana vaHashemi muGizoni,</para>
  <para style="li1" vid="1CH 11:34">Jonatani mwanakomana waShage muHarari,<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>Ahiami mwanakomana waSaka muHarari,</para>
  <para style="li1" vid="1CH 11:35">Erifari mwanakomana waUri,<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>Heferi muMekerati,</para>
  <para style="li1" vid="1CH 11:36">Ahija muPeroni,<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>Heziro muKarimeri,</para>
  <para style="li1" vid="1CH 11:37">Naarai mwanakomana waEzibhai,<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>Joere mununʼuna waNatani,</para>
  <para style="li1" vid="1CH 11:38">Mibha mwanakomana waHagiri,<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>Zereki muAmoni,</para>
  <para style="li1" vid="1CH 11:39">Naharai muBheroti, mubati wenhumbi dzokurwa nadzo dzaJoabhu mwanakomana waZeruya,<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>Ira muItiri,</para>
  <para style="li1" vid="1CH 11:40">Garebhi muItiri,<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>Uria muHiti,</para>
  <para style="li1" vid="1CH 11:41">Zabhadhi mwanakomana waArai,<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>Adhina mwanakomana waShiza muRubheni iye aiva mukuru wavaRubheni, navaya makumi matatu, vaaiva navo,<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>Hanani mwanakomana waMaaka,</para>
  <para style="li1" vid="1CH 11:43">Joshafati muMitini,<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>Uzia muAshiterati,</para>
  <para style="li1" vid="1CH 11:44">Shama naJeyeri vanakomana vaHotamu muAroeri,<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>Jedhieri mwanakomana waShimiri,</para>
  <para style="li1" vid="1CH 11:45">mununʼuna wake Joha muTizi,<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>Erieri muMahavhi,</para>
  <para style="li1" vid="1CH 11:46">Jeribhai naJoshavhia vanakomana vaErinaami,</para>
  <para style="li1" vid="1CH 11:46">Itima muMoabhu,<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>Erieri, Obhedhi naJaasieri muMezobhai.<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">Varwi vanobatana naDhavhidhi</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 12:1"/>Ava ndivo varume vakauya kuna Dhavhidhi paZikiragi achakavanda nokuda kwaSauro mwanakomana waKishi; uye ndivo vamwe vavarwi vakamubatsira muhondo. <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>Vakanga vapakata uta uye vaigona kupfura miseve nezvimviriri noruoko rworudyi kana rworuboshwe; vaiva hama dzaSauro dzokurudzi rwaBhenjamini.<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>Ahiezeri, mukuru wavo, naJoashi, vanakomana vaShemaya muGibheati;</para>
  <para style="li1" vid="1CH 12:3">Jezieri naPereti vanakomana vaAzimavheti;</para>
  <para style="li1" vid="1CH 12:3">Bheraka, Jehu muAnatoti, <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>naIshimaya muGibheoni, aiva mhare pakati paMakumi Matatu; aiva mutungamiri waMakumi Matatu;</para>
  <para style="li1" vid="1CH 12:4">Jeremia, Jahazieri, Johanani; Jozabadhi muGedherati, <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>Eruzai, Jerimoti, Bhearia, Shemaria naShafatia muHarufi;<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>Erikana, Ishiya, Azareri, Joezeri naJashobheami vaKorahi;<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>naJoera naZebhadhia vanakomana vaJehoramu vaibva kuGedhori.<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>Vamwe vaGadhi vakazvitsaurawo vakaenda kwaiva naDhavhidhi kunhare yake kurenje. Vaiva varwi vakashinga, vakagadzirira kurwa uye vaigona kubata nhoo nepfumo. Zviso zvavo zvaiva zviso zveshumba, uye vaimhanya semharapara mumakomo.<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>Ezeri ndiye aiva mukuru,</para>
  <para style="li1" vid="1CH 12:9">Obhadhia ari wechipiri, Eriabhi ari wechitatu,<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>Mishimana wechina, Jeremia wechishanu,<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>Atai wechitanhatu, Erieri wechinomwe,<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>Johanani worusere, Erizabhadhi wechipfumbamwe,<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>Jeremia wegumi naMakibhanai wegumi nomumwe.<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>VaGadhi ava ndivo vaiva vatungamiriri vamauto, mudiki ainge akaenzana nezana, uye mukuru ainge akaenzana nechiuru. <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>Ivava ndivo vaya vakayambuka Jorodhani mumwedzi wokutanga parwainge rwakazara nokumahombekombe uye vakaita kuti vanhu vose vaigara mumipata, kumabvazuva nokumavirira, vatize.<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>Vamwe vaBhenjamini navamwe varume vaibva kuJudha vakauyawo kuna Dhavhidhi munhare yake. <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>Dhavhidhi akaenda kundosangana navo akati kwavari, “Kana mauya kwandiri norugare, kuzondibatsira, ndakagadzirira kuti mubatane neni. Asi kana mauya kuzonditengesa kuvavengi vangu iwo maoko angu asina kuita zvechisimba, Mwari wamadzibaba edu ngaazvione uye akutongei.”<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>Ipapo Mweya wakauya pana Amasi mukuru waMakumi Matatu akati,</para>
  <para style="q1" vid="1CH 12:18">“Haiwa Dhavhidhi, tiri vako!</para>
  <para style="q2" vid="1CH 12:18">Haiwa mwanakomana waJese, tinewe!</para>
  <para style="q1" vid="1CH 12:18">Kubudirira, kubudirira ngakuve kwauri,</para>
  <para style="q2" vid="1CH 12:18">uye kubudirira ngakuve kuna vanokubatsira</para>
  <para style="q3" vid="1CH 12:18">nokuti Mwari wako achakubatsira.”</para>
  <para style="p" vid="1CH 12:18">Saka Dhavhidhi akavagamuchira akavaita vatungamiri veboka ravarwi vake.<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>Vamwe varume vokwaManase vakabatana naDhavhidhi paakaenda navaFiristia kundorwisa Sauro. Iye navanhu vake havana kubatsira vaFiristia nokuti, vapedza kubvunzana, vatongi vavo vakamudzosa vakati, “Zvichatiurayisa kana akazotitiza akandobatana namambo wake Sauro.” <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>Dhavhidhi paakaenda kuZikiragi, ava ndivo vaiva varume vokwaManase vakabatana naye: Adhina, Jozabhadhi, Jedhieri, Mikaeri, Jozabhadhi, Erihu naZiretai, vatungamiri vemapoka echiuru muna Manase. <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>Vakabatsira Dhavhidhi paairwisana namapoka amakororo, nokuti vose vakanga vari varwi vakashinga uye vaiva vatungamiri muhondo yake. <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>Zuva nezuva varume vakauya kuzobatsira Dhavhidhi kusvikira ava nehondo huru kwazvo, sehondo yaMwari.<verse eid="1CH 12:22"/></para>
  <para style="s1">Vamwe vanobatana naDhavhidhi paHebhuroni</para>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 12:23"/>Uku ndiko kuwanda kwavarume vakanga vakapakata zvombo kuti vandorwa, vakauya kuna Dhavhidhi paHebhuroni kuti vatore umambo hwaSauro vahupe kwaari, sezvazvakanga zvarehwa naJehovha:<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>Varume vokwaJudha vakanga vakapakata nhoo namapfumo vaiva zviuru zvitanhatu namazana masere uye akapakata zvombo kuti vandorwa;<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>varume vokwaSimeoni, varwi vakanga vakagadzirira kundorwa vaiva zviuru zvinomwe nezana;<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>varume vokwaRevhi zviuru zvina namazana matanhatu, <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>pamwe chete naJehoyadha, mutungamiri wemhuri yaAroni aiva navarume zviuru zvitatu namazana manomwe, <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>naZadhoki, murwi wechidiki aiva akashinga, navakuru vamapoka makumi maviri navaviri kubva kumhuri yake;<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>varume vokwaBhenjamini, hama dzaSauro vaiva zviuru zvitatu vazhinji vavo vakanga vamboramba vachitevera Sauro kusvikira musi uyu;<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>varume vokwaEfuremu varwi vakashinga vaiva nomukurumbira kwazvo kumhuri dzavo vaiva zviuru makumi maviri namazana masere;<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>varume vokuhafu yorudzi rwaManase vakadanwa namazita avo kuti vauye vazogadza Dhavhidhi umambo vaiva zviuru gumi nezvisere;<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>varume vokwaIsakari vainzwisisa nguva uye vaiziva kuti Israeri yaifanira kuitei, vaiva vakuru mazana maviri nehama dzavo dzose dzaiva pasi pavo;<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>varume vokwaZebhuruni, varwi vaiziva, vakanga vakagadzirira kurwa nezvombo zvemhando dzose, vakauya kuzobatsira Dhavhidhi nomwoyo wakaperera, vaiva zviuru makumi mashanu;<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>varume vokwaNafutari vaiva chiuru chavakuru vamapoka, pamwe chete nezviuru makumi matatu nezvinomwe zvavarume vakanga vakatakura nhoo namapfumo;<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>varume vokwaDhani, vakanga vakagadzirira kurwa, zviuru makumi maviri nezvisere namazana matanhatu;<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>varume vokwaAsheri, vakanga vane unyanzvi hwokurwa uye vakagadzirira kurwa, vaiva zviuru makumi mana;<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>uye kubva kumabvazuva aJorodhani, varume vokwaRubheni, Gadhi nehafu yorudzi rwaManase vakanga vakapakata zvombo zvemhando dzose, vaiva zviuru zana namakumi maviri.<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 12:38"/>Ava vose vaiva varume vokurwa vakazvipira kundorwa.</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">Vakauya paHebhuroni vakagadzirira zvizere kuzogadza Dhavhidhi kuti ave mambo weIsraeri. Vamwe vaIsraeri vose vaiva nomwoyo mumwe chete wokuti vaite Dhavhidhi mambo. <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>Varume vakagara mazuva matatu ipapo vaina Dhavhidhi vachidya uye vachinwa nokuti mhuri dzavo dzainge dzavavigira zvokudya. <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>Uyewo, vavakidzani vavo vokure kwazvo kunyange kwaIsakari, kwaZebhuruni nokwaNafutari vakauya nezvokudya zviri pambongoro, ngamera, manyurusi nenzombe. Pakanga paine zvokudya zvizhinji kwazvo zvaiti upfu, makeke amaonde, makeke amazambiringa akaoma, waini, mafuta, nzombe, namakwai nokuti mufaro wakanga uripo pakati peIsraeri.<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">Kudzorwa kweAreka</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>Dhavhidhi akataurirana nomumwe nomumwe wavabati vake vose, vatungamiri vezviuru, navatungamiri vamazana. <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>Akati kuungano yose yeIsraeri, “Kana zvichiita sezvakakunakirai uye kana kuri kuda kwaJehovha Mwari wedu, ngatitumirei shoko kwose kwose kuhama dzedu dzakasara munyika yose yeIsraeri, nokuvaprista navaRevhi vavagere navo mumaguta avo nokumafuro avo kuti vauye vazobatana nesu. <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>Ngatidzorei areka yaMwari wedu kwatiri zvakare, nokuti izvi hatina kuzvibvunza panguva yokutonga kwaSauro.” <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>Ungano yose yakabvuma kuita izvi, nokuti zvairatidzika kunge zvakanaka kuvanhu vose.<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>Saka Dhavhidhi akaunganidza vaIsraeri vose kubva kuRwizi Shihori muIjipiti kusvika kuRebho Hamati, kuti vatore areka yaMwari kubva kuKiriati Jearimi. <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>Dhavhidhi navaIsraeri vose vaiva naye vakaenda kuBhaara reJudha (Kiriati Jearimi) kuti vandotora areka yaMwari Jehovha, agere pakati pamakerubhi, iyo areka inodaidzwa neZita irori.<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>Vakatakura areka yaMwari kubva muimba yaAbhinadhabhi iri mungoro itsva, Uza naAhio vakaitungamirira. <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>Dhavhidhi navaIsraeri vose vakanga vachipembera nesimba ravo rose pamberi paMwari, nenziyo, nembira, nemitengeranwa, netambureni, nemakandira nehwamanda.<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>Pavakasvika paburiro raKidhoni, Uza akatambanudza ruoko rwake kuti atsigire areka nokuti nzombe dzakanga dzagumburwa. <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>Kutsamwa kwaJehovha kwakamukira Uza akamuuraya nokuti akanga atambanudza ruoko rwake akabata areka. Saka akafa pakarepo pamberi paMwari.<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>Ipapo Dhavhidhi akatsamwa nokuti kutsamwa kwaJehovha kwakanga kwawira pana Uza, uye kusvikira nhasi nzvimbo iyoyo inonzi Perezi Uza.<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>Dhavhidhi akatya Mwari zuva iroro uye akabvunza achiti, “Ko, ndingadzosa areka yaMwari kwandiri seiko?” <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>Haana kutora areka kuti ive naye muguta raDhavhidhi. Asi akaenda nayo kuimba yaObhedhi-Edhomu muGiti. <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>Areka yaMwari yakasara mumhuri yaObhedhi-Edhomu muimba yake kwemwedzi mitatu, uye Jehovha akaropafadza imba yake nezvose zvaakanga anazvo.<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">Imba yaDhavhidhi neMhuri Yake</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>Zvino Hiramu mambo weTire akatuma nhume kuna Dhavhidhi namatanda emisidhari navavaki, navavezi, kuti vamuvakire imba youmambo. <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>Uye Dhavhidhi akaziva kuti Jehovha akanga amusimbisa samambo pamusoro peIsraeri uye kuti umambo hwake hwakanga hwakudzwa kwazvo nokuda kwavanhu vake Israeri.<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>MuJerusarema, Dhavhidhi akazvitorerazve vamwe vakadzi akava baba vavanakomana navanasikana vazhinji. <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>Aya ndiwo mazita avana vaakaberekerwa ikoko: Shamua, Shobhabhi, Natani, Soromoni, <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>Ibhari, Erishua, Eripereti, <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>Noga, Nefegi, Jafia, <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>Erishama, Bheeriyadha naErifereti.<verse eid="1CH 14:7"/></para>
  <para style="s1">Dhavhidhi Anokunda vaFiristia</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>VaFiristia pavakanzwa kuti Dhavhidhi akanga agadzwa kuti ave mambo weIsraeri, vakaenda nehondo yose kundomutsvaka, asi Dhavhidhi akazvinzwa akabuda kundosangana navo. <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>Zvino vaFiristia vakanga vauya kuzopamba mupata weRefaimi; <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>saka Dhavhidhi akabvunza kuna Mwari akati, “Ndingaenda here kundorwisa vaFiristia? Mungavaisa mumaoko angu here?”</para>
  <para style="p" vid="1CH 14:10">Jehovha akapindura akati, “Enda ndichavaisa mumaoko ako.”<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>Saka Dhavhidhi navanhu vake vakakwidza kuBhaari Perazimu uye ikoko akavakunda akati, “Sokupwanya kunoita mvura, Mwari akapwanya vavengi vangu noruoko rwangu.” Saka nzvimbo iyoyo yakatumidzwa kunzi Bhaari Perazimu. <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>VaFiristia vakasiya vamwari vavo ipapo, Dhavhidhi akarayira kuti vapiswe mumoto.<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>VaFiristia vakarwisa zvakare mupata uya. <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>Saka Dhavhidhi akabvunza Mwari zvakare, Mwari akamupindura akati, “Usangonanga ikoko asi vakomberedze wozovarwisa wava pamberi pemiti yemibharisamu. <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>Pamunotanga kunzwa kutinhira kwokufamba pamisoro yemiti yemibharisamu, unofanira kubuda kundorwa, nokuti zvichange zvichireva kuti Mwari akutungamirira kundoparadza hondo yavaFiristia.” <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>Saka Dhavhidhi akaita sokurayirwa kwaakanga aitwa naMwari, uye vakaparadza hondo yavaFiristia, kubva kuGibheoni, kusvika kuGezeri.<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>Saka mukurumbira waDhavhidhi wakapararira nenyika yose uye Jehovha akaita kuti marudzi ose amutye.<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">Areka inouyiswa kuJerusarema</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>Dhavhidhi paakapedza kuzvivakira dzimba muguta raDhavhidhi, akagadzira nzvimbo yainogara areka yaMwari uye akaidzikira tende. <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>Ipapo Dhavhidhi akati, “Hakuna munhu kunze kwavaRevhi anofanira kutakura areka yaMwari, nokuti Jehovha akavasarudza kuti vatakure areka yaJehovha uye kuti vashumire pamberi pake nokusingaperi.”<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>Dhavhidhi akaunganidza Israeri yose muJerusarema kuti vatore areka yaJehovha vagoiisa kunzvimbo yaakanga aigadzirira.<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 15:4"/>Akaunganidza zvizvarwa zvaAroni navaRevhi:<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>kubva kuzvizvarwa zvaKohati,</para>
  <para style="li2" vid="1CH 15:5">Urieri mutungamiri nehama dzake zana namakumi maviri;<verse eid="1CH 15:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>kubva kuzvizvarwa zvaMerari,</para>
  <para style="li2" vid="1CH 15:6">Asaya mutungamiri nehama dzake mazana maviri namakumi maviri;<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>kubva kuzvizvarwa zvaGerishoni,</para>
  <para style="li2" vid="1CH 15:7">Joere mutungamiri nehama dzake zana namakumi matatu;<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>kubva kuzvizvarwa zvaErizafani,</para>
  <para style="li2" vid="1CH 15:8">Shemaya mutungamiri nehama dzake mazana maviri;<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>kubva kuzvizvarwa zvaHebhuroni,</para>
  <para style="li2" vid="1CH 15:9">Erieri mutungamiri nehama dzake makumi masere;<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>kubva kuzvizvarwa zvaUzieri,</para>
  <para style="li2" vid="1CH 15:10">Aminadhabhi mutungamiri nehama dzake zana negumi navaviri.<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>Ipapo Dhavhidhi akadana Zadhoki naAbhiatari vaprista, naUrieri, Asaya, Joere, Shemaya, Erieri naAminadhabhi vaRevhi. <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>Akati kwavari, “Imi muri vakuru vemhuri dzavaRevhi, imi navamwe vaRevhi vose munofanira kuzvinatsa kuti mukwire neareka yaJehovha Mwari weIsraeri kunzvimbo yandakaigadzirira. <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>Izvi zvakaitika nokuti imi vaRevhi hamuna kukwira neareka pakutanga paya Jehovha Mwari wedu paakatiratidza kutsamwa kukuru. Hatina kunge tabvunza kwaari kuti tingazviite sei nenzira yakarayirwa.” <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>Saka vaprista navaRevhi vakazvinatsa kuti vakwire neareka yaJehovha Mwari waIsraeri. <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>Uye vaRevhi vakatakura areka yaMwari namatanda pamapfudzi avo, sezvakanga zvarayirwa naMozisi maererano neshoko raJehovha.<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>Dhavhidhi akataurira vatungamiri vavaRevhi kuti vagadze hama dzavo kuti vave vaimbi kuti vazonoimba dzimbo dzomufaro nezviridzwa zvaiti: mitengeranwa, mbira, namakandira.<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>Saka vaRevhi vakagadza Hemani mwanakomana waJoere; kubva kuhama dzake Asafi mwanakomana waBherekia; uye kubva kuhama dzavo vaMerari, Etani mwanakomana waKushaya; <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>uye pamwe chete navo hama dzavo dzaitevera paukuru dzaiti: Zekaria, Jaazieri, Shemiramoti, Jehieri, Uni, Eriabhi, Bhenaya, Maaseya, Matitia, Eriferehu, Mikineya, Obhedhi-Edhomu, Jeyeri varindi vemikova.<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>Vaimbi vaiti Hemani, Asafi naEtani vakagadzwa kuti varidze makandira endarira. <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>Zekaria, Azieri, Shemiramoti, Jehieri, Uni, Eriabhi, Maaseya, naBhenaya vaizoridza mitengeranwa, maererano nearamoti, <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>uye Matitia, Eriferehu, Mikineya, Obhedhi-Edhomu, Jeyeri, naAzazia vaizoridza mbira maererano neshiminiti. <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>Kenania mukuru wavaRevhi ndiye aitungamirira kuimba; ndiro rakanga riri basa rake nokuti aiva nyanzvi pariri.<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>Bherekia naErikana ndivo vaizova varindi vemikova weareka. <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>Shebhania, Joshafati, Netaneri, Amasai, Zekaria, Bhenaya naErieza vaprista vaizoridza hwamanda pamberi peareka yaMwari. Obhedhi-Edhomu naJehia vaizovawo vatariri vomusuo weareka.<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>Dhavhidhi navakuru veIsraeri navakuru vamapoka ane chiuru vakaenda kundotora areka yesungano yaMwari kubva kumba kwaObhedhi-Edhomu, vachifara. <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>Nokuti Mwari akanga abatsira vaRevhi avo vainge vatakura areka yesungano yaMwari, vakabayira Mwari hando nomwe namakondobwe manomwe. <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>Zvino Dhavhidhi akanga akapfeka nguo yomucheka wakanaka sezvakanga zvakaita vaimbi, naKenania akanga ari mutungamiri wokuimba kuvaimbi. Dhavhidhi akanga akapfekawo efodhi yomucheka. <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>Saizvozvo vaIsraeri vose vakakwidza neareka yesungano yaJehovha vachidanidzira, uye vachiridza mimhanzi yenyanga dzamakondobwe nehwamanda namakandira, uye vachiridza mitengeranwa nembira.<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>Zvino areka yesungano yaJehovha yakati yasvika muguta raDhavhidhi, Mikaeri mwanasikana waSauro akatarira napawindo. Uye akaona Mambo Dhavhidhi achipembera nokutamba, akamushora mumwoyo make.<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>Vakauya neareka yaMwari vakaiisa mukati metende rayakanga yagadzirirwa naDhavhidhi, vakapa zvipiriso zvinopiswa nezvipiriso zvokuwadzana pamberi paMwari. <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>Dhavhidhi akati apedza kubayira zvipiriso zvinopiswa, akaropafadza vanhu muzita raJehovha. <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>Ipapo akapa mumwe nomumwe womudzimai nomurume wechiIsraeri rofu rechingwa, keke romuchero womuchindwe nekeke ramazambiringa akaoma.<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>Akagadza vamwe vavaRevhi kuti vashumire pamberi peareka yaJehovha, vakumbirire, vavonge uye kuti varumbidze Jehovha, Mwari waIsraeri: <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>Asafi ndiye aiva mukuru wavo, Zekaria wechipiri, kuchitevera Jeyeri Shemiramoti, Jehieri, Matitia, Eriabhi, Bhenaya, Obhedhi-Edhomu naJeyeri. Vaizoridza mitengeranwa nembira; Asafi aizoridza makandira <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>uye Bhenaya naJahazieri vaprista vaizoridza hwamanda nguva dzose pamberi peareka yesungano yaMwari.<verse eid="1CH 16:6"/></para>
  <para style="s1">Pisarema raDhavhidhi roKuvonga</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>Zuva iroro Dhavhidhi akapa kwokutanga Asafi navamwe vake pisarema iri rokuvonga Jehovha:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>Vongai Jehovha, danai kuzita rake;</para>
  <para style="q2" vid="1CH 16:8">zivisai pakati pendudzi dzose zvaakaita.<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>Muimbirei, muimbirei nziyo dzokurumbidza;</para>
  <para style="q2" vid="1CH 16:9">taurai zvose zvamabasa ake anoshamisa.<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>Zvirumbidzei muzita rake dzvene;</para>
  <para style="q2" vid="1CH 16:10">mwoyo yaavo vanotsvaka Jehovha ngaifare.<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>Tarisai kuna Jehovha nokusimba rake;</para>
  <para style="q2" vid="1CH 16:11">tsvakai chiso chake nguva dzose.<verse eid="1CH 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>Rangarirai zvishamiso zvaakaita,</para>
  <para style="q2" vid="1CH 16:12">zviratidzo zvake uye nemitongo yaakareva.<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>Haiwa, imi zvizvarwa zvaIsraeri muranda wake,</para>
  <para style="q2" vid="1CH 16:13">haiwa imi vanakomana vaJakobho vasanangurwa vake.<verse eid="1CH 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>Ndiye Jehovha Mwari wedu;</para>
  <para style="q2" vid="1CH 16:14">mitongo yake iri munyika yose.<verse eid="1CH 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>Anorangarira sungano yake nokusingaperi,</para>
  <para style="q2" vid="1CH 16:15">shoko raakarayira, kwechiuru chezvizvarwa.<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>Sungano yaakaita naAbhurahama,</para>
  <para style="q2" vid="1CH 16:16">mhiko yaakapika kuna Isaka.<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>Akasimbisa kuna Jakobho somutemo,</para>
  <para style="q2" vid="1CH 16:17">kuna Israeri sesungano isingaperi, achiti:<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“Kwauri ndichapa nyika yeKenani,</para>
  <para style="q2" vid="1CH 16:18">sechikamu chenhaka yako.”<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>Pavakanga vari vashoma,</para>
  <para style="q2" vid="1CH 16:19">vari vashoma kwazvo, vari vatorwa mairi,<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>vakadzungaira kubva kuno rumwe rudzi kusvika kuno rumwe,</para>
  <para style="q2" vid="1CH 16:20">kubva kuno humwe umambo kusvika kuno humwe.<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>Haana kutendera munhu kuti avadzvinyirire;</para>
  <para style="q2" vid="1CH 16:21">nokuda kwavo akatuka madzimambo.<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“Musabata vazodziwa vangu;</para>
  <para style="q2" vid="1CH 16:22">musaitira vaprofita vangu zvakaipa.”<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>Imbirai Jehovha, pasi pose;</para>
  <para style="q2" vid="1CH 16:23">paridzai ruponeso rwake zuva nezuva.<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>Zivisai kubwinya kwake pakati pendudzi,</para>
  <para style="q2" vid="1CH 16:24">mabasa ake anoshamisa pakati pavanhu vose.<verse eid="1CH 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>Nokuti Jehovha mukuru uye anofanira kwazvo kurumbidzwa;</para>
  <para style="q2" vid="1CH 16:25">anofanira kutyiwa pamusoro pavamwari vose.<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>Nokuti vamwari vose vendudzi zvifananidzo,</para>
  <para style="q2" vid="1CH 16:26">asi Jehovha akasika matenga.<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>Kubwinya nokukudzwa zviri pamberi pake;</para>
  <para style="q2" vid="1CH 16:27">simba nomufaro zviri munzvimbo yougaro hwake.<verse eid="1CH 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>Ipai kuna Jehovha, imi mhuri dzendudzi,</para>
  <para style="q2" vid="1CH 16:28">ipai Jehovha kukudzwa nesimba,<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>ipai Jehovha kukudzwa kunofanira zita rake.</para>
  <para style="q2" vid="1CH 16:29">Uyai nezvipiriso uye muuye pamberi pake;</para>
  <para style="q2" vid="1CH 16:29">namatai Jehovha mukubwinya kwoutsvene hwake.<verse eid="1CH 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30"/>Dederai pamberi pake, imi nyika yose!</para>
  <para style="q2" vid="1CH 16:30">Nyika yakasimbiswa kwazvo; haingazungunuswi.<verse eid="1CH 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>Matenga ngaafare, nyika ngaifare;</para>
  <para style="q2" vid="1CH 16:31">ngavati pakati pendudzi, “Jehovha anotonga!”<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>Gungwa ngaritinhire nezvose zviri mariri;</para>
  <para style="q2" vid="1CH 16:32">minda ngaifarisise nezvose zviri mairi.<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>Ipapo miti yesango ichaimba,</para>
  <para style="q2" vid="1CH 16:33">ichaimba nomufaro pamberi paJehovha,</para>
  <para style="q2" vid="1CH 16:33">nokuti anouya kuzotonga nyika.<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>Vongai Jehovha nokuti akanaka;</para>
  <para style="q2" vid="1CH 16:34">rudo rwake runogara nokusingaperi.<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>Danidzirai muchiti, “Tiponesei, imi Mwari Muponesi wedu;</para>
  <para style="q2" vid="1CH 16:35">tiunganidzei uye mutirwire pandudzi,</para>
  <para style="q1" vid="1CH 16:35">kuti tigovonga zita renyu dzvene</para>
  <para style="q2" vid="1CH 16:35">kuti tifarisise mukukurumbidzai.”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>Rumbidzai Jehovha, Mwari waIsraeri,</para>
  <para style="q2" vid="1CH 16:36">kubva pakusingaperi kusvikira pakusingaperi.</para>
  <para style="m" vid="1CH 16:36">Ipapo vanhu vose vakati, “Ameni” uye vakarumbidza Jehovha.<verse eid="1CH 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>Dhavhidhi akasiya Asafi navamwe vake pamberi peareka yesungano yaJehovha kuti ashumirepo nguva dzose maererano nezvaidiwa zuva rimwe nerimwe. <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>Akasiya Obhedhi-Edhomu navamwe vake makumi matanhatu navasere kuti vashumire navo. Obhedhi-Edhomu mwanakomana waJedhutuni naHosa vaiva vatariri vamasuo.<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>Dhavhidhi akasiya Zadhoki muprista navamwe vaprista pamberi petabhenakeri yaJehovha panzvimbo yakakwirira muGibheoni <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>kuti vape zvipiriso zvinopiswa, kuna Jehovha paaritari yezvipiriso zvinopiswa, nguva dzose, mangwanani namanheru maererano nezvose zvakanga zvakanyorwa muMurayiro waJehovha waakanga apa Israeri. <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>Pakati pavo paiva naHemani naJedhutuni navamwe vose vaiva vakasarudzwa namazita kuti vavonge Jehovha, “Nokuti rudo rwake runogara nokusingaperi.” <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>Hemani naJedhutuni vaiva nebasa rokuridza hwamanda namakandira uye nokuridza zvimwe zviridzwa parwiyo rutsvene. Vanakomana vaJedhutuni vakaitwa vatariri vamasuo.<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>Ipapo vanhu vose vakabvapo, mumwe nomumwe akaenda kumba kwake, uye Dhavhidhi akadzokera kumba kwake kundoropafadza mhuri yake.<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">Chivimbiso chaMwari kuna Dhavhidhi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>Shure kwokunge Dhavhidhi agara mumuzinda wake akati kuna Natani muprofita, “Ndiri pano zvangu ndigere mumuzinda womusidhari, asi areka yesungano yaJehovha iri pasi peTende.”<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>Natani akapindura kuna Dhavhidhi akati, “Zvose zvamunazvo mupfungwa itai nokuti Mwari anemi.”<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>Usiku ihwohwo shoko raMwari rakasvika kuna Natani richiti:<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“Enda unotaurira muranda wangu Dhavhidhi kuti, ‘Zvanzi naJehovha: Hausiwe uchandivakira imba yokugara. <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>Handina kumbogara mumba kubvira zuva randakaburitsa Israeri kubva muIjipiti kusvikira zuva ranhasi. Ndaifamba kubva mutende ndichienda mune rimwe, kubva pane imwe nzvimbo yokugara ndichienda pane imwe. <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>Kwose kwose kwandakafamba navaIsraeri vose, ndakamboti here kuno mumwe zvake wavatungamiri vavo, wandairayira kuti afudze vanhu vangu, “Seiko usina kundivakira imba yomusidhari?” ’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“Zvino naizvozvo udza muranda wangu Dhavhidhi kuti, ‘Zvanzi naJehovha Wamasimba Ose: Ndakakutora kubva kumafuro kwawakanga uchifudza makwai, kuti uve mutongi wavanhu vangu Israeri. <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>Ndakanga ndinewe kwose kwawaienda uye ndakauraya vavengi vako vose pamberi pako. Zvino ndichaita kuti zita rako rive samazita avarume vakuru kwazvo panyika. <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>Uye ndichapa nzvimbo kuvanhu vangu Israeri uye ndichavadyara kuti vave nomusha wavo pachavo uye kuti vasazokanganiswa. Vanhu vakaipa havangazovadzvinyiriri zvakare sezvavakavaita pakutanga <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>uye sezvavakaita kubvira panguva yandakagadza vatungamiri vavanhu vangu Israeri. Ndichakundawo vavengi venyu vose.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Ndinokuudza kuti Jehovha achakuvakira imba: <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>Kana mazuva ako akwana uye pauchaenda kundova namadzibaba ako, ndichasimudza mwana wako achakutevera paumambo, mumwe wavanakomana vako pachako uye ndichasimbisa umambo hwake. <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>Iyeye ndiye achandivakira imba, uye ndichasimbisa chigaro chake choumambo nokusingaperi. <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>Ndichava baba vake uye iye achava mwanakomana wangu. Handizobvisi rudo rwangu kwaari zvakare sokurubvisa kwandakaita kune akakutangira. <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>Ndichamugadza kuti atonge imba yangu noumambo hwangu nokusingaperi; chigaro chake chichasimbiswa nokusingaperi.’ ”<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>Natani akandotaura kuna Dhavhidhi mashoko ose echiratidzo chose ichi.<verse eid="1CH 17:15"/></para>
  <para style="s1">Munyengetero waDhavhidhi</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>Ipapo mambo Dhavhidhi akapinda akagara pamberi paMwari akati:</para>
  <para style="pm" vid="1CH 17:16">“Ndini aniko, nhai Jehovha Mwari, uye mhuri yangu chiiko, kuti mandisvitsawo pano? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>Uye sokuti izvi hazvina kukwana pamberi penyu, haiwa Mwari, mataurazve nezveramangwana reimba yomuranda wenyu. Mandiona sokunge ndini ndinokudzwa kupinda vanhu vose, imi Jehovha Mwari.<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“Chiizve chimwe chingataurwa naDhavhidhi kwamuri nokuda kwokuti maremekedza muranda wenyu kudai? Nokuti munoziva muranda wenyu, <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>imi Jehovha, nokuda kwomuranda wenyu uye maererano nokuda kwenyu maita chinhu chikuru ichi mukaita kuti zvivimbiso izvi zvikuru zviziviswe.<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“Hakuna mumwe akaita semi, imi Jehovha, uye hakuna Mwari kunze kwenyu, sezvatakanzwa nenzeve dzedu pachedu. <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>Uye ndiani akaita savanhu venyu Israeri, rudzi rumwe chete panyika runa Mwari warwo akaenda kundozvidzikinurira vanhu, kuti azviitire zita, uye kuti aite zvishamiso zvikuru zvinotyisa, nokudzinga ndudzi kubva pamberi pavanhu venyu vamakadzikinura kubva kuIjipiti? <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>Makazvigadzirira vanhu venyu Israeri kuti vave venyu pachenyu nokusingaperi, uye imi, imi Jehovha, mava Mwari wavo.<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“Uye zvino, Jehovha, itai kuti chivimbiso chamaita kumuranda wenyu neimba yake chisimbiswe nokusingaperi. Itai sezvamakavimbisa, <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>kuitira kuti chisimbiswe uye kuti zita renyu rive guru nokusingaperi. Ipapo vanhu vachati, ‘Jehovha Wamasimba Ose, Mwari waIsraeri, ndiye Mwari waIsraeri.’ Uye imba yomuranda wenyu Dhavhidhi ichasimbiswa pamberi penyu.<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“Imi Mwari wangu, mazivisa muranda wenyu kuti muchamuvakira imba. Saka muranda wenyu atsunga kuti anyengetere kwamuri. <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>Haiwa Jehovha, muri Mwari! Mavimbisawo zvinhu izvi zvakanaka kumuranda wenyu. <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>Zvino makafadzwa kuti muropafadze imba yomuranda wenyu kuti ienderere mberi nokusingaperi pamberi penyu, nokuti imi, imi Jehovha, mairopafadza uye ichava yakaropafadzwa nokusingaperi.”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">Kukunda kwaDhavhidhi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>Nokufamba kwenguva, Dhavhidhi akakunda vaFiristia akavaisa pasi pake, uye akavatorera Gati nemisha yakaripoteredza kuti ribve pasi poruoko rwavaFiristia.<verse eid="1CH 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2"/>Dhavhidhi akakundawo vaMoabhu, uye vakava pasi pake, vakamuvigira mutero.<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>Pamusoro pezvo Dhavhidhi akarwisa Hadhadhezeri mambo weZobha kusvikira kuHamati, paakaenda kundosimbisa kutonga kwake achitevedza Rwizi Yufuratesi. <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>Dhavhidhi akapamba chiuru chengoro dzake, vachairi vengoro zviuru zvinomwe navarwi vetsoka zviuru makumi maviri. Akadimbura marunda amakumbo amabhiza ose kusara kwezana ramabhiza engoro.<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>VaAramu veDhamasiko pavakauya kuzobatsira Hadhadhezeri mambo weZobha, Dhavhidhi akauraya zviuru makumi maviri nezviviri zvavo. <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>Akaisa mapoka avarwi vake muumambo hwavaAramu veDhamasiko, uye vaAramu vakava pasi pake uye vakamuvigira mutero. Jehovha akapa Dhavhidhi kukunda kwose kwose kwaakaenda.<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>Dhavhidhi akatora nhoo dzegoridhe dzaiva dzakatakurwa navatungamiri vehondo yaHadhadhezeri akaenda nadzo kuJerusarema. <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>Kubva kuTebha nokuKuni, maguta aHadhadhezeri, Dhavhidhi akatora ndarira zhinji, yakazoshandiswa naSoromoni kugadzira gungwa rendarira, nembiru uye nezvimwe zvinhu zvakasiyana-siyana zvakazogadzirwa nendarira.<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>Tou mambo weHamati paakanzwa kuti Dhavhidhi akanga akunda hondo yose yaHadhadhezeri mambo weZobha, <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>akatuma mwanakomana wake Hadhoramu akauya nezvinhu zvamarudzi ose zvegoridhe nesirivha nendarira.<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>Mambo Dhavhidhi akakumikidza zvipo izvi kuna Jehovha sezvaakanga aita nesirivha negoridhe, zvaakanga atora kubva kundudzi idzi dzose dzaiti: Edhomu, Moabhu, vaAmoni, vaFiristia neAmareki.<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>Abhishai mwanakomana waZeruya akauraya vaEdhomu zviuru gumi nezvisere muMupata weMunyu. <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>Akaisa mapoka avarwi muEdhomu uye vaEdhomu vose vakava pasi poutongi hwaDhavhidhi. Jehovha akapa Dhavhidhi kukunda kwose kwose kwaakaenda.<verse eid="1CH 18:13"/></para>
  <para style="s1">Machinda aDhavhidhi</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>Dhavhidhi akatonga Israeri achiita zvose zvakarurama uye zvakanaka kuvanhu vake vose.<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>Joabhu mwanakomana waZeruya aitungamirira hondo;</para>
  <para style="li1" vid="1CH 18:15">Jehoshafati mwanakomana waAhirudhi aiva munyori wenhoroondo;<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>Zadhoki mwanakomana waAhitubhi naAhimereki mwanakomana waAbhiatari vaiva vaprista;</para>
  <para style="li1" vid="1CH 18:16">Shavhisha akanga ari munyori;<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>Bhenaya mwanakomana waJehoyadha aitungamirira vaKereti navaPereti;</para>
  <para style="li1" vid="1CH 18:17">uye vanakomana vaDhavhidhi vaiva machinda makuru parutivi pamambo.<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">Hondo navaAmoni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>Mukufamba kwenguva, Nahashi mambo wavaAmoni akafa, mwanakomana wake akamutevera paumambo. <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>Dhavhidhi akafunga akati, “Ndicharatidza mwoyo wakanaka kuna Hanuni mwanakomana waNahashi nokuti baba vake vakaratidza mwoyo wakanaka kwandiri.” Saka Dhavhidhi akatuma nhume kundonyaradza Hanuni pamusoro pababa vake.</para>
  <para style="p" vid="1CH 19:2">Vanhu vaDhavhidhi pavakasvika kuna Hanuni munyika yavaAmoni kuzomunyaradza, <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>machinda avaAmoni akati kuna Hanuni, “Unofunga here kuti Dhavhidhi ari kukudza baba vako nokutuma vanhu vake kuti vauye kuzokunyaradza? Vanhu vake havana kuuya kuzosora nyika yedu here kuti vaitore?” <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>Saka Hanuni akabata vanhu vaDhavhidhi, akavagera ndebvu dzavo, akacheka nguo dzavo napakati kumagaro, akavadzinga.<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>Mumwe munhu akauya akaudza Dhavhidhi pamusoro pavarume ava, Dhavhidhi akatuma nhume kuti dzinosangana navo nokuti vakanga vanyadziswa kwazvo. Mambo akati, “Garai paJeriko kusvikira ndebvu dzenyu dzakura, mugozodzoka.”<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>VaAmoni vakati vaziva kuti vakanga vava chinhu chinonhuhwa mumhino dzaDhavhidhi, Hanuni navaAmoni vakatumira chiuru chamatarenda<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">matani angaita 34 </char></note> esirivha kuti vanokumbira ngoro navachairi vadzo kubva kuAramu Naharaimu, Aramu Maaka nokuZobha. <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>Vakakumbira ngoro zviuru makumi matatu nezviviri navachairi vadzo, pamwe chete namambo weMaaka navarwi vake, uye akauya akadzika musasa pedyo neMedebha, ukuwo vaAmoni vachiungana kubva mumaguta avo, uye vakabuda kundorwa.<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>Paakanzwa izvi, Dhavhidhi akatuma Joabhu kuti abude nehondo yose yavarume vokurwa. <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>VaAmoni vakabudawo vakagadzirira kurwa uye vakamira vari mumitsetse yokurwa pasuo reguta ravo, uye madzimambo akanga auya akanga ari pachawo musango.<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>Joabhu akaona kuti kwaiva nemitsetse yavanhu vakagadzirira kurwa mberi kwake neshure kwake; saka akasarudza mamwe amapoka avarwi vapamusoro muIsraeri akavaendesa kuti vandorwa navaAramu. <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>Akaisa vamwe varume vose pasi paAbhishai mununʼuna wake uye vakaendeswa kuti vandorwa navaAmoni. <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>Joabhu akati, “Kana vaAramu vandikundaka, ipapo iwe unofanira kuzondinunura; asi kana vaAmoni vakakukunda, ipapo ini ndichakununura. <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>Simba uye ngatirwirei vanhu vedu namaguta aMwari wedu takashinga. Jehovha achaita zvakanaka pamberi pake.”<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>Ipapo Joabhu navarwi vaiva naye vakaenda kundorwa navaAramu, ivo vakatiza pamberi pavo. <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>VaAmoni pavakaona kuti vaAramu vakanga vava kutiza, ivo vakatizawo pamberi pomununʼuna wake Abhishai vakamhanyira mukati meguta. Ipapo Joabhu akadzokera kuJerusarema.<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>Mushure mokunge vaAramu vaona kuti vakanga vakundwa neIsraeri vakatumira nhume kunokokorodza vamwe vaAramu mberi kweRwizi, Shofaki mutungamiri wehondo yaHadhadhezeri achivatungamirira.<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>Dhavhidhi paakaudzwa izvi, akaunganidza Israeri yose ndokuyambuka Jorodhani; akaswedera kwavari kunovarwisa uye akaronga mitsetse yehondo akatarisana navo. Dhavhidhi akaita kuti mitsetse yake isangane navaAramu muhondo uye ivo vakarwa naye. <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>Asi vakatiza pamberi paIsraeri, uye Dhavhidhi akauraya zviuru zvinomwe zvavachairi vengoro, nezviuru makumi mana zvavarwi vetsoka. Akaurayawo Shofaki mutungamiri wehondo yavo.<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>Varanda vaHadhadhezeri pavakaona kuti vakanga vakundwa neIsraeri, vakayanana naDhavhidhi uye vakava pasi pake.</para>
  <para style="p" vid="1CH 19:19">Saka vaAramu havana kuzoda kubatsira vaAmoni zvakare.<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">Kutapwa kweRabha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>Munguva yechirimo, panguva iyo madzimambo anoenda kuhondo, Joabhu, akatungamirira mauto akashonga zvombo zvokurwa. Akaparadza nyika yavaAmoni akaenda kuRabha akandorikomba, asi Dhavhidhi akasara muJerusarema. Joabhu akarwisa Rabha akarisiya raparara. <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>Dhavhidhi akatora korona kubva pamusoro wamambo wavo, uremu hwayo hwakaonekwa kuti hwaiva tarenda<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">makirogiramu angaita 34 </char></note> regoridhe uye yakanga ina mabwe anokosha uye yakaiswa pamusoro paDhavhidhi. Akapamba zvinhu zvizhinji kwazvo muguta iri <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>uye akabudisa vanhu vakanga varimo, akavatongera kuti vashande namajeko namapiki namatemo. Dhavhidhi akaita saizvozvi kumaguta ose avaAmoni. Ipapo Dhavhidhi nehondo yake yose akadzokera kuJerusarema.<verse eid="1CH 20:3"/></para>
  <para style="s1">Hondo navaFiristia</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>Nokufamba kwenguva, hondo yakatanga navaFiristia paGezeri. Panguva iyoyi Sibhekai muHushati akauraya Sipai, mumwe wezvizvarwa zvavaRefa, vaFiristia vakakundwa.<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>Mune kumwe kurwisana navaFiristia, Erihanani mwanakomana waJairi akauraya Rami mununʼuna waGoriati muGiti, aiva nepfumo raiva nomubato wakafanana nedanda romuruki.<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>Mune kumwe kurwisana zvakare, kwakaitika paGati paiva nomumwe murume mukuru kwazvo aiva neminwe mitanhatu muruoko rumwe norumwe nezvigunwe zvitanhatu kugumbo rimwe nerimwe, zvose pamwe chete zvaiva makumi maviri nezvina. Aivawo worudzi rwaRafa. <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>Paakatuka Israeri, Jonatani mwanakomana waShimea, mununʼuna waDhavhidhi akamuuraya.<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>Izvi ndizvo zvizvarwa zvaRafa muGati, uye vakaurayiwa naDhavhidhi navanhu vake.<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">Dhavhidhi anoverenga varwi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>Satani akamukira Israeri akakurudzira Dhavhidhi kuti averenge vaIsraeri. <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>Saka Dhavhidhi akati kuna Joabhu navatungamiri vamapoka avarwi, “Endai mundoverenga vaIsraeri vose kubva kuBheerishebha kusvikira kuDhani. Uye mugozondiudza kuitira kuti ndizive kuti vangani variko.”<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>Asi Joabhu akapindura akati, “Jehovha ngavawedzere uwandu hwavarwi vake kakapetwa kazana. Ishe wangu mambo, ava vose havasi pasi petsoka dzenyu here? Seiko ishe wangu muchida kuita izvi? Sei muchida kuuyisa mhosva kuna Israeri?”<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>Zvisinei, shoko ramambo rakakunda raJoabhu, saka Joabhu akabvapo akaenda muIsraeri yose uye akadzokera kuJerusarema. <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>Joabhu akataurira Dhavhidhi uwandu hwavarwi achiti muIsraeri yose maiva navanhu vaigona kubata munondo vaisvika miriyoni nezana rezviuru zvavarume, vachisanganisira zviuru mazana mana nemakumi manomwe muJudha.<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>Asi Joabhu haana kusanganisira Revhi naBhenjamini mukuverenga uku, nokuti kurayira kwamambo kwakanga kwakaipa kwazvo kwaari. <verse eid="1CH 21:6"/><verse number="7" style="v" sid="1CH 21:7"/>Kurayira uku kwakanga kwakaipawo pamberi paMwari, saka akaranga Israeri.<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>Ipapo Dhavhidhi akati kuna Mwari, “Ndakatadza zvikuru pandakaita chinhu ichi. Zvino ndinokumbirawo kuti mubvise kuipa kwomuranda wenyu. Ndakaita sebenzi kwazvo.”<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>Jehovha akati kuna Gadhi muoni waDhavhidhi, <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“Enda undotaurira Dhavhidhi kuti, ‘Zvanzi naJehovha: Ndinokupa zvinhu zvitatu zvokusarudza. Zvisarudzire chaunoda kuti ndikuitire ndichikuranga.’ ”<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>Saka Gadhi akaenda kuna Dhavhidhi akati kwaari, “Zvanzi naJehovha: ‘Sarudza pakati peizvi: <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>Makore matatu enzara, mwedzi mitatu yokutsvairwa pamberi pavavengi vako, minondo yavo ichikuparadzai, kana kuti mazuva matatu omunondo waJehovha, mazuva edenda munyika mutumwa waJehovha achiparadza panyika yose yaIsraeri.’ Zvino saka zvisarudzirei kuti ndinganopindura sei uyo akandituma.”<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>Dhavhidhi akati kuna Gadhi, “Ndiri mukutambudzika kukuru kwazvo. Rega hako ndiwire mumaoko aJehovha nokuti tsitsi dzake dzakakura kwazvo, asi musandirega ndichiwira mumaoko avanhu.”<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>Saka Jehovha akatumira denda muIsraeri uye zviuru makumi manomwe zvavarume veIsraeri vakawira pasi vakafa. <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>Uye Jehovha akatuma mutumwa kuti aparadze Jerusarema, asi mutumwa uya paakanga achiita izvi Jehovha akazviona uye akazvidemba nokuda kwedambudziko iri akati kumutumwa aiparadza vanhu, “Zvakwana! Dzosa ruoko rwako.” Mutumwa waJehovha ipapo akanga akamira paburiro raArauna muJebhusi.<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>Dhavhidhi akatarisa kumusoro akaona mutumwa waJehovha akamira pakati pedenga nenyika, aine munondo muruoko rwake akarutambanudzira pamusoro peJerusarema. Ipapo Dhavhidhi navakuru vose vakapfeka masaga, vakawira pasi vakatsikitsira zviso zvavo.<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>Dhavhidhi akati kuna Mwari, “Handisini here ndakarayira kuti varwi vose vaverengwe? Ndini ndakatadza ndikaita zvakaipa, ava vanongova makwai chete. Vakaiteiko? Haiwa Jehovha, Mwari wangu, regai ruoko rwenyu ruwire pandiri ini nemhuri yangu, asi musarega denda iri riri pamusoro pavanhu venyu.”<verse eid="1CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>Ipapo mutumwa waJehovha akarayira Gadhi kuti ataurire Dhavhidhi kuti akwire andovakira Jehovha aritari muburiro raArauna muJebhusi. <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>Saka Dhavhidhi akakwidza mukuteerera shoko rakanga rataurwa naGadhi muzita raJehovha.<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>Arauna paakanga achipura zviyo, akacheuka akaona mutumwa; vanakomana vake vana vaaiva navo vakanohwanda. <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>Ipapo Dhavhidhi akaswedera, uye Arauna paakatarisa akamuona, akasiya buriro akakotamira pasi pamberi paDhavhidhi akaisa chiso chake pasi.<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>Dhavhidhi akati kwaari, “Ndipewo nzvimbo yeburiro rako kuti ndigovakira Jehovha aritari, kuti denda riri pavanhu rimiswe. Nditengeserewo nomutengo waro wakazara.”<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>Arauna akati kuna Dhavhidhi, “Ritorei henyu! Ishe wangu mambo ngavaite zvinovafadza. Tarirai ndichakupai nzombe yezvibayiro zvinopiswa, matanda okupurisa dzive huni, uye zviyo zvive zvipiriso zvoupfu. Ndichakupai zvose izvi.”<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>Asi mambo Dhavhidhi akapindura Arauna akati, “Kwete, ndinoda kutenga nomutengo wakazara. Handingatori ndichipa Jehovha zvinhu zvako iwe kana kubayira chipiriso chinopiswa chandisina kuripira.”<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>Saka Dhavhidhi akaripira Arauna mashekeri mazana matanhatu<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">makirogiramu angaita 34 </char></note> egoridhe kuti apiwe nzvimbo iyi. <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>Dhavhidhi akavaka aritari kuna Jehovha ipapo uye akapa zvipiriso zvinopiswa nezvipiriso zvokuwadzana. Akadana kuna Jehovha uye Jehovha akamupindura nomoto wakabva kudenga ukaenda paaritari yezvipiriso zvinopiswa.<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>Ipapo Jehovha akataurira mutumwa iye akadzorera munondo wake mumuhara wawo. <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>Panguva iyoyo Dhavhidhi paakaona kuti Jehovha akanga amupindura paburiro raArauna muJebhusi, akapa zvipiriso ipapo. <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>Tabhenakeri yaJehovha yakanga yagadzirwa naMozisi murenje. Nearitari yezvipiriso zvinopiswa zvakanga zviri panzvimbo yakakwirira paGibheoni panguva iyoyo. <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>Asi Dhavhidhi haaikwanisa kuenda pamberi payo kundobvunza Mwari nokuti aitya munondo womutumwa waJehovha.<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>Ipapo Dhavhidhi akati, “Imba yaJehovha Mwari inofanira kuva pano, pamwe chete nearitari yezvipiriso zvinopisirwa Israeri.”<verse eid="1CH 22:1"/></para>
  <para style="s1">Kugadzirira kuvaka Temberi</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>Saka Dhavhidhi akarayira kuti vatorwa vose vaigara muIsraeri vaungane pamwe chete, uye kubva mukati mavo akasarudza vavezi vamatombo kuti vagadzire matombo akavezwa zvakanaka okuvakisa imba yaMwari. <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>Akapa simbi dzakawanda kwazvo kuti dzigoshandiswa kugadzirisa zvipikiri zvamakonhi apamasuo nezvikorekedzo uye ndarira yakawanda kupfuura yaigona kuiswa pachikero. <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>Akapawo zvakare matanda emisidhari akawanda kupfuura aigona kuverengwa, nokuti vaSidhoni nevaTire vakanga vavigira Dhavhidhi matanda akawanda.<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>Dhavhidhi akati, “Mwanakomana wangu Soromoni mudiki kwazvo uye haasati ava noruzivo, uye imba ichavakirwa Jehovha inofanira kuva huru kwazvo, inorumbidzwa uye inokudzwa kwazvo pamberi pendudzi dzose. Saka ndichaigadzirira.” Saka Dhavhidhi akagadzirira zvikuru kwazvo asati afa.<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>Ipapo akadana mwanakomana wake Soromoni akamurayira kuti avake imba yaJehovha, Mwari weIsraeri. <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>Dhavhidhi akati kuna Soromoni, “Mwanakomana wangu zvaiva mumwoyo mangu kuti ndivakire Zita raJehovha Mwari wangu imba. <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>Asi shoko iri raJehovha rakauya kwandiri richiti, ‘Wakadeura ropa zhinji uye ukarwa hondo dzakawanda. Iwe haungavakiri Zita rangu imba, nokuti wakadeura ropa rakawanda kwazvo pamberi pouso hwangu. <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>Asi uchava nomwanakomana achava murume worugare nokuzorora, uye ndichamupa zororo kubva kuvavengi vake kumativi ose. Zita rake achanzi Soromoni uye ndichapa Israeri runyararo norugare panguva yokutonga kwake. <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>Iyeye ndiye achavakira Zita rangu imba. Achava mwanakomana wangu uye ini ndichava baba vake. Uye ndichasimbisa chigaro choumambo hwake pamusoro peIsraeri nokusingaperi.’<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“Zvino mwanakomana wangu, Jehovha ave newe, uye uve nokubudirira uye uvake imba yaJehovha Mwari wako sezvaakati uchaita. <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>Jehovha ngaakupe uchenjeri nokunzwisisa paachakuisa pakutonga pamusoro peIsraeri, kuitira kuti uchengete murayiro waJehovha Mwari wako. <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>Ipapo uchava nokubudirira kana ukachenjerera kuchengetedza mitemo nemirayiro yakapiwa Mozisi naJehovha kuti ape Israeri. Iva nesimba utsunge mwoyo. Usatya uye usaora mwoyo.<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“Ndakatambura zvikuru kwazvo kuti ndipe kutemberi yaJehovha matarenda zviuru zana<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">matani angaita 3,450 </char></note> zvegoridhe, matarenda miriyoni<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">matani angaita 34,500 </char></note> esirivha, ndarira nesimbi yakawanda zvokuti haingayerwe pachikero, namatanda namatombo. Uye unogona kuwedzera pamusoro pazvo. <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>Une varume vebasa vazhinji kwazvo: vavezi vamatombo, vavezi vamatanda navamwe varume vane unyanzvi mumabasa ose akasiyana-siyana <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>mune zvegoridhe nesirivha, ndarira nesimbi navarume voumhizha vasingaverengeki. Zvino chitanga basa uye Jehovha ave newe.”<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>Ipapo Dhavhidhi akarayira vatungamiri vose veIsraeri kuti vabatsire mwanakomana wake Soromoni. <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>Akati kwavari, “Ko, Jehovha Mwari wenyu haasi nemi here? Uye haana kukupai zororo kumativi ose here? Nokuti akaisa vagari venyika iyi muruoko rwangu, uye nyika iri pasi paJehovha nepasi pavanhu vake. <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>Zvino zvipirei mwoyo nemweya kutsvaka Jehovha Mwari wenyu. Tangai kuvaka nzvimbo tsvene yaJehovha Mwari, kuitira kuti mugouyisa areka yesungano yaJehovha nemidziyo mitsvene yaMwari mutemberi ichavakirwa Zita raJehovha.”<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">VaRevhi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>Dhavhidhi paakanga akwegura ava namakore mazhinji, akaita kuti mwanakomana wake Soromoni ave mambo pamusoro peIsraeri.<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>Akaunganidzawo vatungamiri vose veIsraeri pamwe chete navaprista navaRevhi. <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>VaRevhi vose vana makore makumi matatu zvichienda mberi vakaverengwa, uye varume vose vakasvika zviuru makumi matatu nezvisere. <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>Dhavhidhi akati, “Pane ava, zviuru makumi maviri nezvina vachava vatariri vebasa rokuvakwa kwetemberi yaJehovha uye zviuru zvitanhatu vachava vakuru navatongi. <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>Zviuru zvina vachava vachengeti vamasuo uye zviuru zvina vacharumbidza Jehovha nezviridzwa zvandakapa nokuda kwechikonzero ichi.”<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="6" style="v" sid="1CH 23:6"/>Dhavhidhi akapatsanura vaRevhi akavaisa mumapoka zvichienderana navanakomana vaRevhi vaiti: Gerishoni, Kohati naMerari.<verse eid="1CH 23:6"/></para>
  <para style="s1">VaGerishoni</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>VokwaGerishoni vaiva:</para>
  <para style="li2" vid="1CH 23:7">Radhani naShimei.<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>Vanakomana vaRadhani vaiva:</para>
  <para style="li2" vid="1CH 23:8">Jehieri dangwe, Zetami naJoere, vatatu pamwe chete.<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>Vanakomana vaShimei vaiva:</para>
  <para style="li2" vid="1CH 23:9">Sheromoti, Hazieri naHarani, vatatu pamwe chete.</para>
  <para style="li2" vid="1CH 23:9">Ava ndivo vaiva vakuru vemhuri dzaRadhani.<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>Uye vanakomana vaShimei vaiva:</para>
  <para style="li2" vid="1CH 23:10">Jahati, Ziza, Jeushi naBheria.</para>
  <para style="li2" vid="1CH 23:10">Ava ndivo vaiva vanakomana vaShimei, vana pamwe chete.<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>(Jahati aiva wokutanga, Ziza ari wechipiri, asi Jeushi naBheria vakanga vasina vanakomana vakawanda; saka vakaverengwa semhuri imwe chete ine basa rimwe chete.)<verse eid="1CH 23:11"/></para>
  <para style="s1">VaKohati</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>Vanakomana vaKohati vaiva:</para>
  <para style="li2" vid="1CH 23:12">Amiramu, Izhari, Hebhuroni naUzieri, vana pamwe chete.<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>Vanakomana vaAmiramu vaiva:</para>
  <para style="li2" vid="1CH 23:13">Aroni naMozisi.</para>
  <para style="li2" vid="1CH 23:13">Aroni akatsaurwa iye nezvizvarwa zvake nokusingaperi, kuti anatse zvinhu zvaiva zvitsvene-tsvene, kuti vape zvipiriso pamberi paJehovha, kushumira pamberi pake uye kutaura maropafadzo muzita rake nokusingaperi. <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>Vanakomana vaMozisi munhu waMwari vakaverengwa sechikamu chorudzi rwaRevhi.<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>Vanakomana vaMozisi vaiva:</para>
  <para style="li2" vid="1CH 23:15">Gerishomi naEriezeri.<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>Zvizvarwa zvaGerishomi:</para>
  <para style="li2" vid="1CH 23:16">Shubhaeri ndiye aiva wokutanga.<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>Zvizvarwa zvaEriezeri zvaiva:</para>
  <para style="li2" vid="1CH 23:17">Rehabhia ndiye aiva wokutanga.</para>
  <para style="li2" vid="1CH 23:17">(Eriezeri haana kuzoita vamwe vanakomana, asi Rehabhia akaita vanakomana vakawanda kwazvo.)<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>Vanakomana vaIzhari:</para>
  <para style="li2" vid="1CH 23:18">Sheromiti ndiye aiva wokutanga.<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>Vanakomana vaHebhuroni:</para>
  <para style="li2" vid="1CH 23:19">Jeria ndiye wokutanga, Amaria wechipiri,</para>
  <para style="li2" vid="1CH 23:19">Jahazieri wechitatu naJekameami wechina.<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>Vanakomana vaUzieri:</para>
  <para style="li2" vid="1CH 23:20">Mika wokutanga naIshia wechipiri.<verse eid="1CH 23:20"/></para>
  <para style="s1">VaMerari</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>Vanakomana vaMerari, vaiva:</para>
  <para style="li2" vid="1CH 23:21">Mari naMushi.</para>
  <para style="li1" vid="1CH 23:21">Vanakomana vaMari vaiva:</para>
  <para style="li2" vid="1CH 23:21">Ereazari naKishi.<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>(Ereazari akafa asina vanakomana: aingova navanasikana chete. Hama dzavo, vanakomana vaKishi vakavaroora.)<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>Vanakomana vaMushi vaiva:</para>
  <para style="li2" vid="1CH 23:23">Mari, Edheri, naJerimoti, vatatu pamwe chete.<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="24" style="v" sid="1CH 23:24"/>Ava ndivo vaiva zvizvarwa zvaRevhi nemhuri dzavo, vakuru vemhuri sezvazvakanga vakanyorwa pasi pamazita avo uye vachiverengwa mumwe nomumwe, zvichireva vashandi vaiva namakore makumi maviri naanopfuura vaishanda mutemberi yaJehovha. <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>Nokuti Dhavhidhi akanga ati, “Sezvo Jehovha, Mwari waIsraeri apa zororo kuvanhu vake uye akauya kuzogara muJerusarema nokusingaperi, <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>vaRevhi havachafaniri kuramba vachitakura tabhenakeri kana mimwe midziyo yose yaishandiswa pabasa rayo.” <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>Maererano nokurayira kwaDhavhidhi kwokupedzisira, vaRevhi vakaverengwa kubva pana vana makore makumi maviri kana anopfuura ipapo.<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>Basa ravaRevhi raiva rokubatsira zvizvarwa zvaAroni, mukubata basa romutemberi yaJehovha: kuvatariri voruvanze, makamuri omumativi, kunatsa zvinhu zvose zvaiera, nokuita mamwe mabasa paimba yaMwari. <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>Vaiva vachengeti vechingwa chaiiswa patafura, upfu hwakatsetseka hwezvipiriso zvezviyo, zvingwa zvitete zvisina mbiriso, kubika nokusanganisa, uye zviero zvose zvouwandu noukuru. <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>Vaifanirawo zvakare kumira mangwanani oga oga vachitenda uye vachirumbidza Jehovha. Vaifanira kuita zvimwe chetezvo manheru <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>uye napose paipiwa zvipiriso zvinopiswa kuna Jehovha pamaSabata uye napamitambo yoKugara kwoMwedzi napane mimwe mitambo yakarayirwa. Vaifanira kushanda pamberi paJehovha nguva dzose nouwandu hwaidiwa uye nenzira yavakanga varayirwa kuti vaiite.<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>Nokudaro vaRevhi vakaita mabasa omuTende Rokusangana, romuNzvimbo Tsvene uye vari pasi pehama dzavo zvizvarwa zvaAroni, mubasa roushumiri mutemberi yaJehovha.<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">Mapoka aVaprista</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>Aya ndiwo aiva mapoka avanakomana vaAroni:</para>
  <para style="p" vid="1CH 24:1">Vanakomana vaAroni vaiva: Nadhabhi, Abhihu, Ereazari naItamari. <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>Asi Nadhabhi naAbhihu vakafa baba vavo vasati vafa, uye vakanga vasina vanakomana; saka Ereazari naItamari vakashumira savaprista. <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>Achibatsirwa naZadhoki chizvarwa chaEreazari naAhimereki chizvarwa chaItamari, Dhavhidhi akavapatsanura akavaisa mumapoka kuti vaite basa ravo roushumiri ravakanga varayirwa. <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>Vatungamiri vazhinji vakanyanyowanikwa pane zvizvarwa zvaEreazari kupfuura pakati pezvizvarwa zvaItamari uye vakaiswa mumapoka zvakakodzerana: vakuru gumi navatanhatu kubva kuzvizvarwa zvaEreazari uye vakuru vasere kubva kuzvizvarwa zvaItamari. <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>Vakavaisa mumapoka zvakakodzerana, nokukanda mijenya nokuti paiva navabati venzvimbo tsvene navabati vaMwari pakati pezvizvarwa zvaEreazari nezvizvarwa zvaItamari.<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>Munyori Shemaya mwanakomana waNetaneri, muRevhi, akanyora mazita avo pamberi pamambo, napamberi pavabati vaiti: Zadhoki muprista, Ahimereki mwanakomana waAbhiatari navakuru vemhuri dzavaprista navaRevhi mhuri imwe chete ichitorwa kubva kuna Ereazari uye imwe chete kubva kuna Itamari.<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>Mujenya wokutanga wakawira pana Jehoyaribhi,</para>
  <para style="li1" vid="1CH 24:7">wechipiri pana Jedhaya,<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>wechitatu kuna Harimi,</para>
  <para style="li1" vid="1CH 24:8">wechina kuna Seorimi,<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>wechishanu kuna Marikia,</para>
  <para style="li1" vid="1CH 24:9">wechitanhatu kuna Miyamini,<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>wechinomwe kuna Hakozi,</para>
  <para style="li1" vid="1CH 24:10">wechisere kuna Abhija,<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>wepfumbamwe kuna Jeshua,</para>
  <para style="li1" vid="1CH 24:11">wegumi kuna Shekania,<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>wegumi nomumwe kuna Eriashibhi,</para>
  <para style="li1" vid="1CH 24:12">wegumi nembiri kuna Jakimi,<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>wegumi nenhatu kuna Hupa,</para>
  <para style="li1" vid="1CH 24:13">wegumi neina kuna Jeshebheabhi,<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>wegumi neshanu kuna Bhiriga,</para>
  <para style="li1" vid="1CH 24:14">wegumi nenhanhatu kuna Imeri,<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>wegumi nenomwe kuna Heziri,</para>
  <para style="li1" vid="1CH 24:15">wegumi netsere kuna Hapizezi,<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>wegumi nepfumbamwe kuna Petahia,</para>
  <para style="li1" vid="1CH 24:16">wemakumi maviri kuna Jehezikeri,<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>wemakumi maviri nomumwe kuna Jakini,</para>
  <para style="li1" vid="1CH 24:17">wemakumi maviri nembiri kuna Gamuri,<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>wemakumi maviri nenhatu kuna Dheraya,</para>
  <para style="li1" vid="1CH 24:18">uye wemakumi maviri neina kuna Maazia.<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>Iri ndiro raiva basa ravo roushumiri ravakanga varayirwa pavakapinda mutemberi yaJehovha, maererano nemitemo yavakanga vapiwa nababa wavo Aroni sokurayirwa kwaakanga aitwa naJehovha, Mwari waIsraeri.<verse eid="1CH 24:19"/></para>
  <para style="s1">Vamwe vaRevhi vose</para>
  <para style="li4">
    <verse number="20" style="v" sid="1CH 24:20"/>Kana zviri zvimwe zvizvarwa zvaRevhi:</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">kubva kuvanakomana vaAmiramu, Shubhaeri;</para>
  <para style="li2" vid="1CH 24:20">kubva kuvanakomana vaShubhaeri: Jedheya.<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>Kana ari Rehabhia, kuvanakomana vake: Ishia aiva wokutanga.<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>Kubva kuvaIzhari: Sheromoti;</para>
  <para style="li2" vid="1CH 24:22">kubva kuvanakomana vaSheromoti: Jahati.<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>Vanakomana vaHebhuroni vaiva:</para>
  <para style="li2" vid="1CH 24:23">Jeria wokutanga, Amaria wechipiri, Jehazieri wechitatu naJekameami wechina.<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>Mwanakomana waUzieri aiva: Mika;</para>
  <para style="li2" vid="1CH 24:24">kubva kuvanakomana vaMika: Shamiri.<verse eid="1CH 24:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25"/>Mununʼuna waMika: Ishia;</para>
  <para style="li2" vid="1CH 24:25">kubva kuvanakomana vaIshia: Zekaria.<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>Vanakomana vaMerari vaiva: Mari naMushi.</para>
  <para style="li2" vid="1CH 24:26">Mwanakomana waJaazia aiva: Bheno.<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>Vanakomana vaMerari vaiva:</para>
  <para style="li2" vid="1CH 24:27">kubva kuna Jaazia: Bheno, Shoshami, Zakuri, naIbhiri.<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>Kubva kuna Mari: Ereazari, uye akanga asina vanakomana.<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>Kubva kuna Kishi mwanakomana waKishi aiva: Jerameeri.<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>Uye vanakomana vaMushi vaiti: Mari, Edheri naJerimoti.</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="li4" vid="1CH 24:30">Ava ndivo vaiva vaRevhi maererano nemhuri dzavo.<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>Vakakandawo mijenya sezvaingoita hama dzavo zvizvarwa zvaAroni, pamberi paMambo Dhavhidhi naZadhoki, Ahimereki navakuru vemhuri dzavaprista navaRevhi. Mhuri dzomukoma pane vose dzaingoverengwa zvimwe chetezvo sedzomudiki pane vose.<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">Vaimbi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>Dhavhidhi, pamwe chete navatungamiri vehondo: vakatsaura vamwe vavanakomana vaAsafi, Hemani naJedhutuni kuti vaite ushumiri hwokuprofita kuchiridzwa mbira, mitengeranwa namakandira. Aya ndiwo mazita avarume vaiita basa iri.<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>Kubva kuvanakomana vaAsafi:</para>
  <para style="li2" vid="1CH 25:2">Zakuri, Josefa, Netania naAsarera. Vanakomana vaAsafi vaitungamirirwa naAsafi uyo aiprofita achitungamirirwa namambo.<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>Kana ari Jedhutuni, kuvanakomana vake:</para>
  <para style="li2" vid="1CH 25:3">Gedharia, Zeri, Jeshaya, Shimei, Hashabhia naMatitia, vatanhatu pamwe chete, vachitungamirirwa nababa vavo Jedhutuni uyo aiprofita achishandisa mbira mukuvonga nokurumbidza Jehovha.<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>Kana ari Hemani, kubva kuvanakomana vake:</para>
  <para style="li2" vid="1CH 25:4">Bhukia, Matania, Uzieri, Shubhaeri naJerimoti; Hanania, Hanani, Eriata, Gidhariti naRomamiti-Ezeri; Joshibhekasha, Maroti, Hotiri naMahazioti. <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>Vose ava vaiva vanakomana vaHemani muoni wamambo. Akavapiwa kubudikidza nezvivimbiso zvaMwari kuti amukudze. Mwari akapa Hemani vanakomana gumi navana, navanasikana vatatu.<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>Varume vose ava vaitungamirirwa namadzibaba avo mukuimba mutemberi yaJehovha, nomukuridza makandira nemitengeranwa nembira, kuti vaite ushumiri paimba yaMwari. Asafi, Jedhutuni naHemani vaiva pasi pamambo. <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>Pamwe chete nehama dzavo, vose vakadzidzira uye vakava nyanzvi mukuimbira Jehovha, vaisvika mazana maviri amakumi masere navasere. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>Vaduku navakuru pamwe chete, mudzidzisi pamwe chete nomudzidzi, vakakanda mijenya pakupiwa mabasa avo.<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>Mujenya wokutanga waiva waAsafi, wakawira pana Josefa,</para>
  <para style="li2" vid="1CH 25:9">vanakomana vake nehama dzake—gumi navaviri;</para>
  <para style="li1" vid="1CH 25:9">wechipiri kuna Gedharia,</para>
  <para style="li2" vid="1CH 25:9">iye nehama dzake navanakomana vake—gumi navaviri;<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>wechitatu kuna Zakuri,</para>
  <para style="li2" vid="1CH 25:10">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>wechina kuna Iziri,</para>
  <para style="li2" vid="1CH 25:11">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>wechishanu kuna Netania,</para>
  <para style="li2" vid="1CH 25:12">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>wechitanhatu kuna Bhukia,</para>
  <para style="li2" vid="1CH 25:13">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>wechinomwe kuna Jesarera,</para>
  <para style="li2" vid="1CH 25:14">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>worusere kuna Jeshaya,</para>
  <para style="li2" vid="1CH 25:15">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>wepfumbamwe kuna Matania,</para>
  <para style="li2" vid="1CH 25:16">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>wegumi kuna Shimei,</para>
  <para style="li2" vid="1CH 25:17">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>wegumi nomumwe kuna Azareri,</para>
  <para style="li2" vid="1CH 25:18">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>wegumi nemiviri kuna Hashabhia, vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>wegumi nemitatu kuna Shubhaeri, vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>wegumi nemina kuna Matitia, vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>wegumi nemishanu kuna Jerimoti, vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>wegumi nemitanhatu kuna Hanania, vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>wegumi neminomwe kuna Joshibhekasha,</para>
  <para style="li2" vid="1CH 25:24">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>wegumi nemisere kuna Hanani, vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>wegumi nemipfumbamwe kuna Maroti,</para>
  <para style="li2" vid="1CH 25:26">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>wamakumi maviri kuna Eriata,</para>
  <para style="li2" vid="1CH 25:27">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>wamakumi maviri nomumwe kuna Hotiri,</para>
  <para style="li2" vid="1CH 25:28">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>wamakumi maviri nemiviri kuna Gidhariti,</para>
  <para style="li2" vid="1CH 25:29">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>wamakumi maviri nemitatu kuna Mahazioti,</para>
  <para style="li2" vid="1CH 25:30">vanakomana vake nehama dzake—gumi navaviri;<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>wamakumi maviri nemina kuna Romamiti-Ezeri,</para>
  <para style="li2" vid="1CH 25:31">vanakomana vake nehama dzake—gumi navaviri.<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">Vachengeti veMikova</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 26:1"/>Mapoka avachengeti vemikova aiva:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="li4" vid="1CH 26:1">Kubva kuvaKora:</para>
  <para style="li1" vid="1CH 26:1">Mesheremia mwanakomana waKore, mumwe wavanakomana vaAsafi. <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>Mesheremia aiva navanakomana vaiti:</para>
  <para style="li2" vid="1CH 26:2">Zekaria dangwe, Jedhiaeri wechipiri,</para>
  <para style="li2" vid="1CH 26:2">Zebhadhia wechitatu, Jatinieri wechina,<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>Eramu wechishanu, Jehohanani wechitanhatu,</para>
  <para style="li2" vid="1CH 26:3">naEriehoenai wechinomwe.<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>Obhedhi-Edhomu aivawo navanakomana vaiti:</para>
  <para style="li2" vid="1CH 26:4">Shemaya dangwe, Jehozabhadhi wechipiri,</para>
  <para style="li2" vid="1CH 26:4">Joa wechitatu, Sakari wechina,</para>
  <para style="li2" vid="1CH 26:4">Netaneri wechishanu, <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>Amieri wechitanhatu,</para>
  <para style="li2" vid="1CH 26:5">Isakari wechinomwe naPeuretai wechisere.</para>
  <para style="li2" vid="1CH 26:5">(Nokuti Mwari akanga aropafadza Obedhi-Edhomu.)<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>Mwanakomana wake Shemaya aivawo navanakomana vaiva: vatungamiri mumhuri yababa vavo nokuti vaiva varume vaikwanisa kwazvo. <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>Vanakomana vaShemaya vaiti:</para>
  <para style="li2" vid="1CH 26:7">Otini, Refaeri, Obhedhi naErizabhadhi;</para>
  <para style="li2" vid="1CH 26:7">hama dzake Erihu naSemakia vaivawo varume vaikwanisa.<verse eid="1CH 26:7"/></para>
  <para style="li4">
    <verse number="8" style="v" sid="1CH 26:8"/>Vose ava vaiva zvizvarwa zvaObhedhi-Edhomu. Ivo navanakomana vavo nehama dzavo vaiva varume vaikwanisa vaine simba rokuita basa, zvizvarwa zvaObhedhi-Edhomu, vaisvika makumi matanhatu navaviri pamwe chete.<verse eid="1CH 26:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 26:9"/>Mesheremia aiva navanakomana nehama vakanga vari varume voumhare vaisvika gumi navasere pamwe chete.<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>Hosa muMerati aiva navanakomana vaiti:</para>
  <para style="li2" vid="1CH 26:10">Shimiri wokutanga (kunyange zvake akanga asiri dangwe, baba vake vakamuita wokutanga.)<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>Hirikia wechipiri, Tabharia wechitatu</para>
  <para style="li2" vid="1CH 26:11">naZekaria wechina.</para>
  <para style="li4" vid="1CH 26:11">Vanakomana nehama dzaHosa vaiva gumi navatatu vose pamwe chete.<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="1CH 26:12"/>Aya mapoka avachengeti vamasuo, kubudikidza navakuru vavo, vaiva nemabasa okushumira mutemberi yaJehovha, sezvaingoitawo hama dzavo. <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>Mijenya yakakandwa nokuda kwesuo rimwe nerimwe, maererano nemhuri dzavo, vadiki nevakuru pamwe chete.<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>Mujenya weSuo Rokumabvazuva wakawira pana Sheremia.</para>
  <para style="li1" vid="1CH 26:14">Zvino mijenya yakakandwa nokuda kwomwanakomana wake Zekaria, mupi wamazano akachenjera uye mujenya weSuo Rokumusoro wakawira paari.<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>Mujenya weSuo Rezasi wakawira pana Obhedhi-Edhomu, uye mujenya wedura wakawira kuvanakomana vake.<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>Mijenya yeSuo Rokumadokero neSuo reShareketi kunzira yokumusoro yakawira kuna Shupimi naHosa.</para>
  <para style="b" vid="1CH 26:16"/>
  <para style="li4" vid="1CH 26:16">Murindi aimira parutivi rwomumwe murindi.<verse eid="1CH 26:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>Kumabvazuva kwainge kuine vaRevhi vatanhatu pazuva,</para>
  <para style="li1" vid="1CH 26:17">kurutivi rwokumusoro kuine vana pazuva,</para>
  <para style="li1" vid="1CH 26:17">zasi kuine vana pazuva</para>
  <para style="li1" vid="1CH 26:17">uye vaviri panguva imwe chete padura.<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>Kana rwuri ruvanze rwokumadokero kwaiva navana kunzira navaviri paruvanze chaipo.<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="1CH 26:19"/>Aya ndiwo aiva mapoka avachengeti vemasuo avo vaiva zvizvarwa zvaKora naMerari.<verse eid="1CH 26:19"/></para>
  <para style="s1">Vabati veHomwe yeMari naMamwe Machinda</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>Pakati pehama dzavo vaRevhi, Ahija ndiye aiva mukuru wavachengeti vepfuma yomumba yaMwari nepfuma yezvinhu zvakakumikidzwa.<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>Zvizvarwa zvaRadhani, avo vaiva vaGerishoni kubudikidza naRadhani uye vaiva vatungamiri vemhuri dzaRadhani muGerishoni vaiti: Jehieri, <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>vanakomana vaJeheri, Zetami, nomununʼuna wake Joere. Vaiva nebasa rokuchengeta pfuma yetemberi yaJehovha.<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 26:23"/>Kubva kuvaAmiramu, vaIzhari, vaHebhuroni navaUzieri:<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>Shubhaeri chizvarwa chaGerishoni mwanakomana waMozisi, ndiye aiva mukuru pakuchengetwa kwepfuma. <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>Hama dzake kubudikidza naEriezeri dzaiva: Rehabhia mwanakomana wake, Jeshaya mwanakomana wake, Joramu mwanakomana wake, Zikiri mwanakomana wake naSheromiti mwanakomana wake.<verse eid="1CH 26:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26"/>(Sheromiti nehama dzake vaiva nebasa rokuchengetedza pfuma yose yezvinhu zvakakumikidzwa naMambo Dhavhidhi, navakuru vemhuri dzavo vaiva vatungamiri vezviuru navatungamiri vamazana uye navamwe vatungamiri. <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>Zvimwe zvezvakapambwa muhondo vakazvikumikidza kuti zvishandiswe pakugadziridza temberi yaJehovha. <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>Uye zvose zvakakumikidzwa naSamueri muoni naSauro naJoabhu mwanakomana waZeruya, nezvimwe zvinhu zvose zvakakumikidzwa zvaichengetwa naSheromiti nehama dzake.)<verse eid="1CH 26:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 26:29"/>Kubva kuvaIzhari:</para>
  <para style="li2" vid="1CH 26:29">Kenania navanakomana vake vakapiwa mabasa ekure netemberi vari machinda navatongi muIsraeri.<verse eid="1CH 26:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 26:30"/>Kubva kuvaHebhuroni:</para>
  <para style="li2" vid="1CH 26:30">Hashabhia nehama dzake, varume chiuru namazana manomwe vaikwanisa ndivo vaiva vakuru muIsraeri kumadokero kweJorodhani pabasa rose raJehovha napabasa rose ramambo. <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>Kana vari vaHebhuroni, Jeria ndiye aiva mukuru wavo maererano nezvinyorwa zvenhoroondo dzemhuri dzavo.</para>
  <para style="li2" vid="1CH 26:31">(Mugore ramakumi mana rokutonga kwaDhavhidhi, pakaitwa ongororo yezvinyorwa zvenhoroondo, uye pakawanikwa varume vaikwanisa pakati pavaHebhuroni paJazeri muGireadhi. <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>Jeria aiva nehama zviuru zviviri namazana manomwe vaiva varume vaikwanisa uye vari vakuru vemhuri dzavo, uye Mambo Dhavhidhi akavaita kuti vave vatariri vavaRubheni, vaGhadhi, nehafu yorudzi rwaManase kuti vagadzirise nyaya dzose dzezvaMwari nenyaya dzose dzamambo.)<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">Mapoka eHondo</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 27:1"/>Aya ndiwo mazita avaIsraeri, vakuru vemhuri, vatungamiri vezviuru navatungamiri vamazana, namachinda avo, vaishandira mambo mune zvose pamusoro pamapoka avarwi ainge ari pabasa mwedzi nomwedzi mugore rose. Boka rimwe nerimwe raiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>Aitungamirira boka rokutanga mwedzi wokutanga, aiva Jashobheami mwanakomana waZabhidhieri. Muboka rake maiva navarume zviuru makumi maviri nezvina. <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>Aiva chizvarwa chaPerezi uyewo ari mukuru wavakuru vavavarwi vose mumwedzi wokutanga.<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>Aitungamirira boka remwedzi wechipiri ainzi Dhodhai muAhohi; Mikiroti ndiye aiva mutungamiri weboka rake. Muboka rake maiva nezviuru makumi maviri nezvina.<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>Mukuru wavarwi wechitatu mumwedzi wechitatu ainzi Bhenaya mwanakomana waJehoyadha muprista. Ndiye aiva mukuru uye muboka rake maiva navarume zviuru makumi maviri nezvina. <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>Uyu ndiye Bhenaya uya aiva mumwe woumhare pakati paMakumi Matatu uye aiva pamusoro paMakumi Matatu vacho. Mwanakomana wake Amizabhadhi ndiye aitungamirira boka rake.<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>Wechina pamwedzi wechina, aiva Asaheri mununʼuna waJoabhu; mwanakomana wake Zebhadhia ndiye akamutevera pakutungamirira boka iri. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>Wechishanu pamwedzi wechishanu, aiva mutungamiri Shamihuti muIzirahi. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>Wechitanhatu pamwedzi wechitanhatu, aiva Ira mwanakomana waIkeshi muTeko. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>Wechinomwe pamwedzi wechinomwe, aiva Herezi muPeroni, muEfuremu. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>Worusere, pamwedzi worusere, aiva Sibhekai muHushati muZerahi. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>Wechipfumbamwe, mumwedzi wechipfumbamwe, aiva Abhiezeri muAnatoti, muBhenjamini. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>Wegumi, mumwedzi wegumi, aiva Maharai muNetofati, muZerahi. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>Wegumi nomumwe, mumwedzi wegumi nomumwe, aiva Bhenaya muPiratoni, muEfuremu. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>Wegumi navaviri, mumwedzi wegumi nemiviri, aiva Heridhai muNetofati, aibva mumhuri yaOtinieri. Muboka rake maiva navarume zviuru makumi maviri nezvina.<verse eid="1CH 27:15"/></para>
  <para style="s1">Machinda aMarudzi</para>
  <para style="li4">
    <verse number="16" style="v" sid="1CH 27:16"/>Machinda pamusoro pamarudzi aIsraeri aiti:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">pamusoro pavaRubheni: Eriezeri mwanakomana waZikiri;</para>
  <para style="li1" vid="1CH 27:16">pamusoro pavaSimeoni: Shefatia mwanakomana waMaaka;<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>pamusoro paRevhi: Hashabhia mwanakomana waKemueri;</para>
  <para style="li1" vid="1CH 27:17">pamusoro paAroni: Zadhoki;<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>pamusoro paJudha: Erihu, mununʼuna waDhavhidhi;</para>
  <para style="li1" vid="1CH 27:18">pamusoro paIsakari: Omiri mwanakomana waMikaeri;<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>pamusoro paZebhuruni: Ishimaya mwanakomana waObhadhia;</para>
  <para style="li1" vid="1CH 27:19">pamusoro paNafutari: Jerimoti mwanakomana waAzirieri;<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>pamusoro pavaEfuremu: Hoshea mwanakomana waAzazia;</para>
  <para style="li1" vid="1CH 27:20">pamusoro pehafu yorudzi rwaManase: Joere mwanakomana waPedhaya;<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>pamusoro pehafu yorudzi rwaManase muGireadhi: Idho mwanakomana waZekaria;</para>
  <para style="li1" vid="1CH 27:21">pamusoro paBhenjamini: Jaasieri mwanakomana waAbhineri;<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>pamusoro paDhani: Azareri mwanakomana waJerohamu.</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="li4" vid="1CH 27:22">Ava ndivo vaiva machinda pamusoro pamarudzi avaIsraeri.<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>Dhavhidhi haana kuverenga varume vaiva namakore makumi maviri zvichidzika, nokuti Jehovha akanga avimbisa kuti vaIsraeri vaizowanda senyeredzi dziri mudenga. <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>Joabhu mwanakomana waZeruya akatanga kuverenga varume ava asi haana kuzopedza. Kutsamwa kwakauya pamusoro peIsraeri nokuda kwokuverengwa uku, saka uwandu uhu hahuna kuiswa mubhuku renhoroondo dzegore negore raMambo Dhavhidhi.<verse eid="1CH 27:24"/></para>
  <para style="s1">Vatariri vaMambo</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>Azimavheti mwanakomana waAdhieri aiva muchengeti wamatura amambo.</para>
  <para style="li1" vid="1CH 27:25">Jonatani mwanakomana waUzia aiva muchengeti wamatura kumaruwa okure, mumaguta, mumisha neshongwe dzavarindi.<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>Eziri mwanakomana waKerubhi aiva mutariri pamusoro wavashandi vairima minda.<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>Shimei muRamati aiva mutariri weminda yemizambiringa.</para>
  <para style="li1" vid="1CH 27:27">Zabhidhi muShifimi aiva mutariri wezvibereko zveminda yemizambiringa zvokuzoisa muzvirongo zvewaini.<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>Bhaari-Hanani muGedheri aiva mutariri wemiorivhi nemionde yakanga iri mujinga mezvikomo zvokumadokero.</para>
  <para style="li1" vid="1CH 27:28">Joashi aiva mutariri wamafuta omuorivhi.<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>Shitirai muSharoni, aiva mutariri wemombe dzaifura muSharoni.</para>
  <para style="li1" vid="1CH 27:29">Shafati mwanakomana waAdhirai ndiye aiva mutariri wemombe dzaiva mumipata.<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>Obhiri muIshumaeri aiva mutariri wengamera.</para>
  <para style="li1" vid="1CH 27:30">Jedheya muMeronoti aiva mutariri wembongoro.<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>Jazizi muHagiri aiva mutariri wamakwai.</para>
  <para style="li4" vid="1CH 27:31">Ava ndivo vaiva vabati vaichengeta pfuma yaMambo Dhavhidhi.<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>Jonatani, babamunini vaDhavhidhi vaiva mupi wamazano, murume woruzivo nomunyori.</para>
  <para style="li1" vid="1CH 27:32">Jehieri mwanakomana waHakimoni aiva muchengeti wavanakomana vamambo.<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>Ahitoferi aiva mupi wamazano kuna mambo.</para>
  <para style="li1" vid="1CH 27:33">Hushai muAriki aiva shamwari yamambo.<verse eid="1CH 27:33"/></para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 27:34"/>(Ahitoferi akazoteverwa pachinzvimbo naJehoyadha mwanakomana waBhenaya uye naAbhiatari.)</para>
  <para style="li1" vid="1CH 27:34">Joabhu ndiye aiva mutungamiri wehondo yamambo.<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">Urongwa hwaDhavhidhi pamusoro peTemberi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>Dhavhidhi akarayira vabati veIsraeri vose kuti vaungane paJerusarema: vabati pamusoro pamarudzi, vatungamiri vamapoka aishandira mambo, vatungamiri vezviuru navatungamiri vamazana, navabati vaichengeta zvinhu nezvipfuwo zvamambo uye navanakomana vake, pamwe chete navabati vomumuzinda wamambo, varume vane simba nemhare dzose dzakashinga.<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>Mambo Dhavhidhi akasimuka akamira akati, “Teererai kwandiri, hama dzangu navanhu vangu. Zvakanga zviri mumwoyo mangu kuti ndivake imba senzvimbo yokuzororera yeareka yesungano yaJehovha, kuti zvive chitsiko chetsoka dzaMwari wedu, uye ndakaita urongwa hwokuivaka. <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>Asi Mwari akati kwandiri, ‘Iwe hausi kuzovakira Zita rangu imba, nokuti uri murwi uye wakateura ropa.’<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“Asi Jehovha, Mwari waIsraeri, akandisarudza kubva kumhuri yangu yose kuti ndive mambo pamusoro paIsraeri nokusingaperi. Akasarudza Judha kuti ave mhuri yangu, uye kubva muvanakomana vababa vangu akafadzwa nokundiita mambo pamusoro peIsraeri. <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>Pavanakomana vangu vose, uye Jehovha akandipa vakawanda kwazvo, iye akasarudza mwanakomana wangu Soromoni kuti agare pachigaro choumambo hwaJehovha pamusoro paIsraeri. <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>Akati kwandiri, ‘Soromoni mwanakomana wako ndiye achavaka imba yangu nezvivanze zvangu, ndichava baba vake. <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>Ndichasimbisa umambo hwake nokusingaperi kana iye akatsungirira mukuita zvandakarayira nemitemo yangu sezviri kuitwa panguva ino.’<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“Saka zvino ndinokurayira pamberi peIsraeri yose uye napamberi peungano yaJehovha, uye Mwari wedu achinzwa: Chenjerera kuti utevere kurayira kwose kwaJehovha senhaka kuvana vako nokusingaperi.<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“Newewo mwanakomana wangu Soromoni, ziva Mwari wababa vako, uye umushumire nomwoyo wose uye nepfungwa dzako dzose, nokuti Jehovha anonzvera mwoyo uye anonzwisisa chinangwa chipi nechipi chiri mupfungwa. Ukamutsvaga achawanikwa newe, asi kana ukamurasa, iye achakuramba nokusingaperi. <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>Funga zvino, nokuti Jehovha akusarudza kuti uvake temberi senzvimbo tsvene. Iva nesimba uye uite basa iri.”<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>Ipapo Dhavhidhi akapa mwanakomana wake Soromoni urongwa hwebiravira retemberi, dzimba dzayo, matura ayo, makamuri ayo okumusoro, makamuri ayo omukati uye nenzvimbo yokuyananisira. <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>Akamupa urongwa hwazvose zvakanga zvaiswa noMweya mupfungwa make pamusoro pezvivanze zvetemberi yaJehovha namakamuri ose akapoteredza, pamusoro pamatura epfuma yetemberi yaMwari napamusoro pamatura ezvinhu zvakakumikidzwa. <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>Akamurayira zvokuita pamusoro pamapoka avaprista navaRevhi uye napamusoro pebasa rose rokushumira mutemberi yaJehovha, uyewo napamusoro pemidziyo yaizoshandiswa mubasa rayo. <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>Akarayira uremu hwegoridhe remidziyo yose yaizoshandiswa mumhando dzose dzokushumira, nouremu hwesirivha yemidziyo yose yaizoshandiswa mumhando dzose dzokushumira: <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>Uremu hwegoridhe rezvigadziko zvemwenje zvegoridhe nemwenje yazvo, nouremu hwechigadziko chomwenje chimwe nechimwe, nemwenje yacho, maererano nokushandiswa kwechigadziko chemwenje chimwe nechimwe. <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>Uremu hwegoridhe retafura imwe neimwe yechingwa chakatsaurwa; uremu hwesirivha yetafura dzesirivha; <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>uremu hwegoridhe rakanatswa reforogo, ndiro dzokusasa nemikombe; uremu hwegoridhe nedhishi rimwe nerimwe regoridhe; uremu hwesirivha yedhishi rimwe nerimwe resirivha; <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>uye uremu hwegoridhe rakanatswa nearitari yezvinonhuhwira. Akamupawo mufananidzo wengoro iyo ina makerubhi egoridhe akatambanudza mapapiro awo achifukidza areka yesungano yaJehovha.<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>Dhavhidhi akati, “Zvose izvi ndakazviziviswa zvanyorwa noruoko rwaJehovha uye akaita ndinzwisise urongwa hwake hwose.”<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>Dhavhidhi akatiwo kumwanakomana wake Soromoni, “Simba utsunge mwoyo, uye uite basa iri. Usatya kana kuora mwoyo, nokuti Jehovha Mwari, Mwari wangu, anewe. Haachazokusiyi kana kukurasa, kusvikira basa rose rokushandira temberi yaJehovha rapera. <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>Mapoka avaprista navaRevhi akagadzirira kuita basa rose rapatemberi yaMwari, uye murume wose anoda uye ane umhizha hupi nehupi pamabasa amaoko achakubatsira pabasa iri rose. Vabati vose navanhu vose vachateerera kurayira kwako kwose.”<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">Zvipo Zvokuvakisa Temberi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>Ipapo Mambo Dhavhidhi akati kuungano yose, “Mwanakomana wangu Soromoni uyo asarudzwa naMwari mudiki uye haasati ava kunyatsogona. Basa iri iguru kwazvo nokuti muzinda uyu hausi womunhu asi ndowaJehovha Mwari. <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>Nokuwana kwangu kwose ndapa kutemberi yaMwari wangu goridhe pabasa regoridhe, sirivha pabasa resirivha, ndarira pabasa rendarira, simbi pabasa resimbi uye matanda pabasa ramatanda, pamwe chete neonikisi, namabwe okuisa mukati namatombo amavara akasiyana-siyana, namamwe mabwe akaurungana amarudzi ose namamwe machena, zvose izvi zvakawanda kwazvo. <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>Pamusoro pezvo mukuzvipira kwangu kutemberi yaMwari wangu zvino ndava kupa upfumi hwangu pachangu hwegoridhe nesirivha kutemberi yaMwari wangu, ndichiwedzera pamusoro pezvose zvandakapa kutemberi iyi tsvene zvinoti: <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>Matarenda zviuru zvitatu<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">matani angaita 100 </char></note> egoridhe (goridhe reOfiri) namatarenda zviuru zvinomwe<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">matani angaita 240 </char></note> esirivha yakanatswa yokufukidza madziro edzimba, <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>kuitira basa regoridhe, nebasa resirivha uye kuti basa rose riitwe navarume voumhizha. Zvino ndiani anoda kuzvitsaurira kuna Jehovha nhasi!”<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>Ipapo vatungamiri vemhuri, vakuru vamarudzi eIsraeri, vatungamiri vezviuru, vatungamiri vamazana namachinda aitungamirira basa ramambo vakapa nomwoyo unoda. <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>Vakapa kubasa rapatemberi matarenda zviuru zvishanu<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">matani angaita 170 </char></note> namadhariki zviuru gumi<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">matani angaita 84 </char></note> egoridhe, matarenda zviuru gumi<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">matani angaita 345 </char></note> esirivha, matarenda zviuru gumi nezvisere<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">matani angaita 620 </char></note> endarira, namatarenda zviuru zana<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">matani angaita 3,450 </char></note> esimbi. <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>Ani naani akanga ane matombo anokosha akapa ose kuimba yokuchengeta pfuma yetemberi yaJehovha zvichichengetwa naJehieri muGerishoni. <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>Vanhu vakapembera nomufaro pavakaona kuti vatungamiri vavo vakanga vapa nomwoyo unoda, nokuti vakanga vapa kuna Jehovha vakasununguka uye nomwoyo wose. Mambo Dhavhidhi akafarawo zvikuru.<verse eid="1CH 29:9"/></para>
  <para style="s1">Munyengetero waDhavhidhi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>Dhavhidhi akarumbidza Jehovha pamberi peungano yose achiti,</para>
  <para style="q1" vid="1CH 29:10">“Rumbidzwai imi Jehovha,</para>
  <para style="q2" vid="1CH 29:10">Mwari wababa vedu Israeri,</para>
  <para style="q2" vid="1CH 29:10">kubva kusingaperi kusvika kusingaperi.<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>Ukuru nesimba ndezvenyu, imi Jehovha,</para>
  <para style="q2" vid="1CH 29:11">kukudzwa noushe nokubwinya,</para>
  <para style="q2" vid="1CH 29:11">nokuti zvose zviri kudenga napasi ndezvenyu.</para>
  <para style="q1" vid="1CH 29:11">Umambo ndohwenyu,</para>
  <para style="q2" vid="1CH 29:11">imi Jehovha munokudzwa somusoro wezvose.<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>Upfumi nokuremekedzwa zvinobva kwamuri;</para>
  <para style="q2" vid="1CH 29:12">ndimi mutongi wezvinhu zvose.</para>
  <para style="q1" vid="1CH 29:12">Mumaoko enyu mune simba noushe</para>
  <para style="q2" vid="1CH 29:12">kuti musimudzire uye musimbise vanhu vose.<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>Zvino, Mwari wedu, tinokuvongai,</para>
  <para style="q2" vid="1CH 29:13">uye tinorumbidza zita renyu rakanakisa.<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“Asi ini ndini aniko, uye vanhu vangu ndivanaaniko kuti tingakwanisa kupa zvakawanda kudai? Zvose zvinobva kwamuri, uye tangokupai chete zvinobva mumaoko enyu. <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>Tiri vatorwa navapfuuri pamberi penyu, sezvakanga zvakaita madzibaba edu ose. Mazuva edu panyika akaita somumvuri, asina tariro. <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>Imi Jehovha, Mwari wedu, izvi zvose zvakawanda kudai zvatapa kuti temberi yenyu ivakwe nokuda kweZita renyu Dzvene zvinobva muruoko rwenyu uye zvose ndezvenyu. <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>Ndinoziva, Mwari wangu, kuti munoedza mwoyo uye munofadzwa nokururama. Zvinhu zvose izvi ndakupai ndichida uye nomwoyo wakatendeka. Uye zvino ndaona ndikafadzwa namapiro aita vanhu venyu vari pano kwamuri nomwoyo unoda. <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>Imi Jehovha, Mwari wamadzibaba edu Abhurahama, Isaka, naIsraeri, chengetedzai kudokwairira kwakadai mumwoyo yavanhu venyu nokusingaperi, uye muite kuti mwoyo yavo irambe yakazvipira kwamuri. <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>Uye ipai mwanakomana wangu Soromoni mwoyo wakaperera kuti achengete mirayiro yenyu, zvose zvamunoda nemitemo yenyu uye kuti aite zvose kuti avake muzinda wandagadzirira zvose izvi.”<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>Ipapo Dhavhidhi akati kuungano yose, “Rumbidzai Jehovha Mwari wenyu.” Saka vose vakarumbidza Jehovha, Mwari wamadzibaba avo; vakakotamira pasi vakawira pasi nezviso pamberi paJehovha naMambo.<verse eid="1CH 29:20"/></para>
  <para style="s1">Soromoni anogamuchirwa saMambo</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>Zuva raitevera vakapa zvipiriso kuna Jehovha vakapa zvipiriso zvinopiswa kwaari zvinoti: hando chiuru, makondobwe chiuru, namakwayana makono chiuru, pamwe chete nezvipiriso zvavo zvokunwa, nezvimwe zvibayiro zvakawanda zveIsraeri. <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>Vakadya uye vakanwa nomufaro mukuru pamberi paJehovha zuva iroro.</para>
  <para style="p" vid="1CH 29:22">Ipapo vakazogamuchira Soromoni mwanakomana waDhavhidhi samambo kechipiri, vakamuzodza pamberi paJehovha kuti ave mutongi, uye Zadhoki ave muprista. <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>Saka Soromoni akagara pachigaro choushe chaJehovha samambo panzvimbo yababa vake Dhavhidhi. Akabudirira uye Israeri yose yakamuteerera. <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>Vatungamiri vose pamwe chete navarume voumhare, pamwe chete navanakomana vose vaMambo vaDhavhidhi vakavimbisa kuzviisa pasi paMambo Soromoni.<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>Jehovha akasimudzira Soromoni kwazvo pamberi peIsraeri yose akaisa paari kukudzwa kwoumambo kusina kumbopiwa mumwe mambo weIsraeri akamutangira.<verse eid="1CH 29:25"/></para>
  <para style="s1">Kufa kwaDhavhidhi</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>Dhavhidhi mwanakomana waJese aiva mambo pamusoro peIsraeri yose. <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>Akatonga Israeri kwamakore makumi mana, manomwe muHebhuroni uye makumi matatu namatatu muJerusarema. <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>Akafa akwegura zvikuru ararama upenyu hurefu, hune upfumi nokukudzwa. Mwanakomana wake Soromoni akamutevera paumambo.<verse eid="1CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29"/>Kana zviri zvinhu zvakaitika panguva yokutonga kwaMambo Dhavhidhi kubva pakutanga kusvika kumagumo, zvakanyorwa muzvinyorwa zvaSamueri muoni, zvinyorwa zvaNatani muprofita, uye nomuzvinyorwa zvaGadhi muoni, <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>pamwe chete nenhoroondo dzokutonga kwake, uye nesimba, nezvinhu zvakaitika kwaari iye neIsraeri noumambo hwedzimwe nyika dzose.<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
