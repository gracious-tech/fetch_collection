<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open Shona Contemporary Bible 2017</book>
  <para style="h">Rwiyo Rukuru rwaSoromoni</para>
  <para style="toc1">Rwiyo Rukuru rwaSoromoni</para>
  <para style="toc2">Rwiyo Rukuru rwaSoromoni</para>
  <para style="toc3">Rwiyo</para>
  <para style="mt1">RWIYO RUKURU RWASOROMONI</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>Rwiyo Rukuru rwaSoromoni:<verse eid="SNG 1:1"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>Ngaanditsvode hake nokutsvoda kwomuromo wake.</para>
  <para style="q2" vid="SNG 1:2">Nokuti rudo rwako runofadza kupfuura waini.<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>Kunhuhwirira kwamafuta enyu kunofadza;</para>
  <para style="q2" vid="SNG 1:3">zita renyu rakafanana namafuta anonhuwirira adururwa.</para>
  <para style="q2" vid="SNG 1:3">Hazvishamisi kuti mhandara dzinokudai!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>Nditorei muende neni, ngatikurumidzei.</para>
  <para style="q2" vid="SNG 1:4">Mambo ngaandipinze mudzimba dzake dzomukati.</para>
  <para style="sp" vid="SNG 1:4">Shamwari</para>
  <para style="q1" vid="SNG 1:4">Tinokupembererai uye tinokufarirai;</para>
  <para style="q2" vid="SNG 1:4">ticharumbidza rudo rwenyu kupfuura waini.</para>
  <para style="sp" vid="SNG 1:4">Mukadzi</para>
  <para style="q1" vid="SNG 1:4">Regai zvenyu mhandara dzikudei!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>Kusviba ndakasviba zvangu, asi ndakanaka hangu,</para>
  <para style="q2" vid="SNG 1:5">vanasikana veJerusarema,</para>
  <para style="q2" vid="SNG 1:5">ndakasviba samatende eKedhari,</para>
  <para style="q2" vid="SNG 1:5">sezvidzitiro zvetende raSoromoni.<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>Musanditarisisa nokuda kwoutema hwangu,</para>
  <para style="q2" vid="SNG 1:6">nokuti ndakasvibiswa nezuva.</para>
  <para style="q1" vid="SNG 1:6">Vanakomana vamai vangu vakanditsamwira</para>
  <para style="q2" vid="SNG 1:6">vakandiita kuti ndichengete minda yemizambiringa;</para>
  <para style="q2" vid="SNG 1:6">munda wangu chaiwo wemizambiringa ndakaushayira nguva.<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>Ndiudze, iwe mudiwa wangu, kwaunofudzira makwai ako</para>
  <para style="q2" vid="SNG 1:7">nokwaunozorodzera makwai ako masikati.</para>
  <para style="q1" vid="SNG 1:7">Ko, ndichaitirei somukadzi akafukidza chiso chake</para>
  <para style="q2" vid="SNG 1:7">pedyo namakwai eshamwari dzako?<verse eid="SNG 1:7"/></para>
  <para style="sp">Shamwari</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>Kana usingazivi, iwe mukadzi akanaka kukunda vamwe,</para>
  <para style="q2" vid="SNG 1:8">chitevera makwara amakwai</para>
  <para style="q1" vid="SNG 1:8">ugondofudzira mbudzana dzako</para>
  <para style="q2" vid="SNG 1:8">pedyo namatende avafudzi.<verse eid="SNG 1:8"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>Ndinokufananidza, iwe mudiwa wangu, nebhiza rakasungwa</para>
  <para style="q2" vid="SNG 1:9">pane imwe yengoro dzaFaro.<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>Matama ako akashongedzwa zvakanaka nemhete,</para>
  <para style="q2" vid="SNG 1:10">mutsipa wako nezvuma zvamatombo anokosha.<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>Tichakugadzirira mhete</para>
  <para style="q2" vid="SNG 1:11">dzenzeve dzegoridhe nesirivha.<verse eid="SNG 1:11"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>Mambo paakanga agere patafura yake,</para>
  <para style="q2" vid="SNG 1:12">munhuwi wamafuta andainge ndazora wakapararira.<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>Mudiwa wangu, kwandiri akaita sakahomwe kemura</para>
  <para style="q2" vid="SNG 1:13">kanogara pakati pamazamu angu.<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>Mudiwa wangu, kwandiri akaita sesumbu ramaruva machena</para>
  <para style="q2" vid="SNG 1:14">anobva mubindu remizambiringa yeEni Gedhi.<verse eid="SNG 1:14"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>Kunaka here kwawakaita uku, mudiwa wangu!</para>
  <para style="q2" vid="SNG 1:15">A-a, wakazonaka!</para>
  <para style="q2" vid="SNG 1:15">Meso ako injiva chaidzo!<verse eid="SNG 1:15"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>Wakanaka sei, mudiwa wangu!</para>
  <para style="q2" vid="SNG 1:16">A-a, unofadza!</para>
  <para style="q2" vid="SNG 1:16">Uye mubhedha wedu wakasvibira.<verse eid="SNG 1:16"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>Nhungo dzeimba yedu ndedzomusidhari;</para>
  <para style="q2" vid="SNG 1:17">mbariro dzacho ndedzomupaini.<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>Ndiri ruva reSharoni,</para>
  <para style="q2" vid="SNG 2:1">ruva romumipata.<verse eid="SNG 2:1"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>Seruva riri pakati peminzwa,</para>
  <para style="q2" vid="SNG 2:2">ndizvo zvakaita mudiwa wangu pakati pemhandara.<verse eid="SNG 2:2"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>Somuti womuapuro pakati pemiti yesango,</para>
  <para style="q2" vid="SNG 2:3">ndizvo zvawakaita mudiwa wangu pakati pamajaya.</para>
  <para style="q1" vid="SNG 2:3">Ndinofarira kugara mumumvuri wake,</para>
  <para style="q2" vid="SNG 2:3">uye muchero wake unondinakira kuudya.<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>Akaenda neni kuimba yamabiko,</para>
  <para style="q2" vid="SNG 2:4">uye mureza wake pamusoro pangu ndirwo rudo.<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>Ndisimbise namazambiringa akaomeswa,</para>
  <para style="q2" vid="SNG 2:5">ndisimbise namaapuro;</para>
  <para style="q2" vid="SNG 2:5">nokuti ndoziya norudo.<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>Ruoko rwake rworuboshwe rwuri pasi pomusoro wangu,</para>
  <para style="q2" vid="SNG 2:6">uye ruoko rwake rworudyi rwakandimbundikira.<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>Imi vanasikana veJerusarema ndinokupikirai</para>
  <para style="q2" vid="SNG 2:7">nemhara uye nenondo dzesango:</para>
  <para style="q1" vid="SNG 2:7">Musazunguza kana kumutsa rudo</para>
  <para style="q2" vid="SNG 2:7">kusvikira irwo rwada rwoga.<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>Inzwai! Inzwi romudiwa wangu!</para>
  <para style="q2" vid="SNG 2:8">Tarirai! Hoyo</para>
  <para style="q1" vid="SNG 2:8">ouya achiuruka nomumakomo,</para>
  <para style="q2" vid="SNG 2:8">achikwakuka nomuzvikomo.<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>Mudiwa wangu akafanana nemhara</para>
  <para style="q2" vid="SNG 2:9">kana netsvana yenondo.</para>
  <para style="q1" vid="SNG 2:9">Tarirai! Hoyo amira seri kworusvingo rwedu,</para>
  <para style="q2" vid="SNG 2:9">akatarira napamawindo achidongorera napamaburi apamawindo.<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>Mudiwa wangu akataura kwandiri akati,</para>
  <para style="q2" vid="SNG 2:10">“Simuka, mudiwa wangu,</para>
  <para style="q2" vid="SNG 2:10">iwe munakunaku wangu, uya tiende tose.<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>Tarira! Nguva yechando yapera;</para>
  <para style="q2" vid="SNG 2:11">mvura yapera; uye haichanayi.<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>Maruva oonekwa panyika;</para>
  <para style="q2" vid="SNG 2:12">nguva yokuimba yasvika,</para>
  <para style="q1" vid="SNG 2:12">kurira kwenjiva</para>
  <para style="q2" vid="SNG 2:12">kwonzwikwa munyika yedu.<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>Muonde wobereka michero yawo yokutanga;</para>
  <para style="q2" vid="SNG 2:13">uye mizambiringa yotunga maruva ayo anonhuhwira kwazvo.</para>
  <para style="q1" vid="SNG 2:13">Simuka, uya, mudiwa wangu;</para>
  <para style="q2" vid="SNG 2:13">munakunaku wangu, uya tiende tose.”<verse eid="SNG 2:13"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>Njiva yangu iri mumikaha yedombo,</para>
  <para style="q2" vid="SNG 2:14">munzvimbo dzokuvanda mumativi egomo,</para>
  <para style="q1" vid="SNG 2:14">ndiratidze chiso chako,</para>
  <para style="q2" vid="SNG 2:14">ndinoda kunzwa inzwi rako;</para>
  <para style="q1" vid="SNG 2:14">nokuti inzwi rako rinotapira,</para>
  <para style="q2" vid="SNG 2:14">uye chiso chako chinoyevedza.<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>Tibatirei makava,</para>
  <para style="q2" vid="SNG 2:15">ivo vana vemakava</para>
  <para style="q1" vid="SNG 2:15">anoparadza minda yemizambiringa,</para>
  <para style="q2" vid="SNG 2:15">iyo mizambiringa yedu yotunga maruva.<verse eid="SNG 2:15"/></para>
  <para style="sp">Mudiwa</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>Mudiwa wangu ndewangu uye ndiri wake;</para>
  <para style="q2" vid="SNG 2:16">anofamba-famba pakati pamaruva omubani.<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>Kusvikira zuva rabuda</para>
  <para style="q2" vid="SNG 2:17">uye mimvuri yatiza,</para>
  <para style="q1" vid="SNG 2:17">pinduka, mudiwa,</para>
  <para style="q2" vid="SNG 2:17">ubve waita semhara</para>
  <para style="q1" vid="SNG 2:17">kana tsvana</para>
  <para style="q2" vid="SNG 2:17">pamusoro pezvikomo.<verse eid="SNG 2:17"/></para>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>Usiku hwose ndiri pamubhedha wangu</para>
  <para style="q2" vid="SNG 3:1">ndakatsvaka uyo anodiwa nomwoyo wangu;</para>
  <para style="q2" vid="SNG 3:1">ndakamutsvaka asi handina kumuwana.<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>Ndichasimuka zvino ndinofamba-famba muguta,</para>
  <para style="q2" vid="SNG 3:2">mumigwagwa yaro nomuzvivara zvaro;</para>
  <para style="q1" vid="SNG 3:2">ndichatsvaka iye anodiwa nomwoyo wangu.</para>
  <para style="q2" vid="SNG 3:2">Saka ndakamutsvaka asi handina kumuwana.<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>Varindi vakandiona</para>
  <para style="q2" vid="SNG 3:3">pavaiva pabasa ravo rokufamba-famba vachichengetedza guta.</para>
  <para style="q2" vid="SNG 3:3">“Ko, mamboona here iye anodiwa nomwoyo wangu?”<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>Ndichingopfuudzana navo</para>
  <para style="q2" vid="SNG 3:4">ndakabva ndamuwana, iye anodiwa nomwoyo wangu.</para>
  <para style="q1" vid="SNG 3:4">Ndakamubata ndikasamuregedza</para>
  <para style="q2" vid="SNG 3:4">kusvikira ndaenda naye kumba kwamai vangu,</para>
  <para style="q2" vid="SNG 3:4">kuimba yaavo vakandibereka.<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>Vanasikana veJerusarema, ndinokurayirai</para>
  <para style="q2" vid="SNG 3:5">nemhara kana nenondo dzesango kuti:</para>
  <para style="q1" vid="SNG 3:5">Musazunguza kana kumutsa rudo</para>
  <para style="q2" vid="SNG 3:5">kusvikira irwo rwada rwoga.<verse eid="SNG 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>Ndianiko uyo ari kuuya achibva nokurenje</para>
  <para style="q2" vid="SNG 3:6">seshongwe youtsi</para>
  <para style="q1" vid="SNG 3:6">ine munhuwi wemura, nezvimwe zvinonhuhwira</para>
  <para style="q2" vid="SNG 3:6">zvakagadzirwa nezvikuyiwa zvinonhuhwira zvavashambadzi?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>Tarirai! Ndiyo ngoro yaSoromoni,</para>
  <para style="q2" vid="SNG 3:7">yakachengetedzwa nemhare makumi matanhatu dzamachinda,</para>
  <para style="q2" vid="SNG 3:7">apamusoro-soro omuIsraeri.<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>Mumwe nomumwe wavo akabata munondo</para>
  <para style="q2" vid="SNG 3:8">vose vakarwa hondo,</para>
  <para style="q1" vid="SNG 3:8">mumwe nomumwe ane munondo parutivi rwake,</para>
  <para style="q2" vid="SNG 3:8">vakagadzirira kutarisana nezvinotyisa usiku.<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>Mambo Soromoni akazvigadzirira ngoro;</para>
  <para style="q2" vid="SNG 3:9">akaigadzira nemiti yokuRebhanoni.<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>Mbiru dzacho akadzigadzira nesirivha,</para>
  <para style="q2" vid="SNG 3:10">pokuzembera musana pakagadzirwa negoridhe.</para>
  <para style="q1" vid="SNG 3:10">Pokugara pakashongedzwa nejira repepuru,</para>
  <para style="q2" vid="SNG 3:10">mukati mayo makashongedzwa norudo</para>
  <para style="q2" vid="SNG 3:10">navanasikana veJerusarema.<verse eid="SNG 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>Budai imi vanasikana veZioni,</para>
  <para style="q2" vid="SNG 3:11">muzoona Mambo Soromoni akapfeka korona,</para>
  <para style="q2" vid="SNG 3:11">korona yaakapfekedzwa namai vake</para>
  <para style="q1" vid="SNG 3:11">musi wesvitsa,</para>
  <para style="q2" vid="SNG 3:11">zuva iro mwoyo wake wakafara.<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>Wakanaka sei, mudiwa wangu!</para>
  <para style="q2" vid="SNG 4:1">A, wakazonaka!</para>
  <para style="q2" vid="SNG 4:1">Meso ako uri mumumbure injiva chaidzo.</para>
  <para style="q1" vid="SNG 4:1">Bvudzi rako rakaita sedanga rembudzi</para>
  <para style="q2" vid="SNG 4:1">riri kuburuka kubva muGomo reGireadhi.<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>Meno ako akafanana neboka ramakwai achangobva mukuveurwa,</para>
  <para style="q2" vid="SNG 4:2">ari kubva kundoshambidzwa.</para>
  <para style="q1" vid="SNG 4:2">Rimwe nerimwe riine rarakafanana naro,</para>
  <para style="q2" vid="SNG 4:2">pasina rimwe riri roga zvaro.<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>Miromo yako yakafanana nomucheka mutsvuku;</para>
  <para style="q2" vid="SNG 4:3">muromo wako wakaisvonaka.</para>
  <para style="q1" vid="SNG 4:3">Zvavovo zvako zviri mumumbure wako</para>
  <para style="q2" vid="SNG 4:3">zvakaita sezvikamu zviviri zvedamba.<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>Mutsipa wako wakafanana neshongwe yaDhavhidhi</para>
  <para style="q2" vid="SNG 4:4">yakavakwa zvinoyevedza.</para>
  <para style="q1" vid="SNG 4:4">Mairi makaturikwa nhoo dzine chiuru,</para>
  <para style="q2" vid="SNG 4:4">dzose dziri nhoo dzemhare.<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>Mazamu ako ari maviri akafanana netsvana mbiri dzemhara,</para>
  <para style="q2" vid="SNG 4:5">mapatya emhara</para>
  <para style="q2" vid="SNG 4:5">dzinofura pamwe chete pakati pemaruva.<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>Kusvikira zuva rabuda</para>
  <para style="q2" vid="SNG 4:6">uye mimvuri yotiza,</para>
  <para style="q1" vid="SNG 4:6">ndichaenda kugomo remura</para>
  <para style="q2" vid="SNG 4:6">nokuchikomo chezvinonhuhwira.<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>Wakaisvonaka iwe, mudiwa wangu;</para>
  <para style="q2" vid="SNG 4:7">mauri hamuna kana chinongo.<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>Ngatibvei tose kuRebhanoni, iwe mwenga wangu,</para>
  <para style="q2" vid="SNG 4:8">ngatibvei tose kuRebhanoni.</para>
  <para style="q1" vid="SNG 4:8">Buruka kubva pamusoro-soro peAmana,</para>
  <para style="q2" vid="SNG 4:8">kubva pamusoro peSeniri,</para>
  <para style="q1" vid="SNG 4:8">pamusoro-soro peHerimoni,</para>
  <para style="q2" vid="SNG 4:8">kubva kumapako eshumba nokumakomo anofamba-famba mbada.<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>Watora mwoyo wangu hanzvadzi yangu, mwenga wangu;</para>
  <para style="q2" vid="SNG 4:9">wanditora mwoyo</para>
  <para style="q1" vid="SNG 4:9">nokungondiringa kwawaita kamwe chete,</para>
  <para style="q2" vid="SNG 4:9">uye nedombo rimwe rinokosha rechishongo chomutsipa wako.<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>Rudo rwako kwandiri runondifadza sei, hanzvadzi yangu, mwenga wangu!</para>
  <para style="q2" vid="SNG 4:10">Rudo rwako runofadza sei kukunda waini,</para>
  <para style="q2" vid="SNG 4:10">uye kunhuhwira kwamafuta ako okuzora</para>
  <para style="q2" vid="SNG 4:10">kunokunda zvose zvinonhuhwira.<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>Miromo yako inodonhesa zvinotapira sezinga rouchi, mwenga wangu;</para>
  <para style="q2" vid="SNG 4:11">uchi nomukaka zviri pasi porurimi rwako.</para>
  <para style="q2" vid="SNG 4:11">Kunhuhwira kwenguo dzako kwakafanana nokweRebhanoni.<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>Uri bindu rakapfigwa, hanzvadzi yangu, mwenga wangu.</para>
  <para style="q2" vid="SNG 4:12">Uri tsime rakakomberedzwa, nechitubu chakavakirirwa.<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>Miti yako ibindu ramatamba</para>
  <para style="q2" vid="SNG 4:13">nemimwe michero yakaisvonaka,</para>
  <para style="q2" vid="SNG 4:13">hena nenaridhi,<verse eid="SNG 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14"/>naridhi nesafuroni,</para>
  <para style="q2" vid="SNG 4:14">karamusi, nesinamoni,</para>
  <para style="q2" vid="SNG 4:14">nemiti yose inogadziriswa zvinonhuhwira</para>
  <para style="q2" vid="SNG 4:14">nemura negavakava,</para>
  <para style="q2" vid="SNG 4:14">uye nezvose zvinonhuhwira zvakanakisisa.<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>Uri chitubu chomubindu,</para>
  <para style="q2" vid="SNG 4:15">tsime remvura inoerera,</para>
  <para style="q2" vid="SNG 4:15">inoerera ichibva kuRebhanoni.<verse eid="SNG 4:15"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>Muka, iwe mhepo yokumusoro,</para>
  <para style="q2" vid="SNG 4:16">uye uya iwe mhepo yezasi!</para>
  <para style="q1" vid="SNG 4:16">Vhuvhuta napabindu rangu</para>
  <para style="q2" vid="SNG 4:16">kuti kunhuhwirira kwezvirimo kuparadzirwe kwose kwose.</para>
  <para style="q1" vid="SNG 4:16">Rega mudiwa wangu apinde mubindu rake,</para>
  <para style="q2" vid="SNG 4:16">agoravira michero yaro yakaisvonaka, sepaanodira.<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>Ndauya zvangu mubindu rangu, hanzvadzi yangu, iwe mwenga wangu;</para>
  <para style="q2" vid="SNG 5:1">ndaunganidza mura yangu pamwe chete nezvinonhuhwira zvangu.</para>
  <para style="q1" vid="SNG 5:1">Ndadya zinga rangu rouchi nouchi hwangu;</para>
  <para style="q2" vid="SNG 5:1">ndanwa waini yangu nomukaka wangu.</para>
  <para style="sp" vid="SNG 5:1">Shamwari</para>
  <para style="q1" vid="SNG 5:1">Idyai, imi shamwari, uye munwe;</para>
  <para style="q2" vid="SNG 5:1">inwai mugute, imi vanodanana.<verse eid="SNG 5:1"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>Ndakavata asi mwoyo wangu wakanga wakasvinura.</para>
  <para style="q2" vid="SNG 5:2">Inzwai! Mudiwa wangu ari kugogodza, achiti,</para>
  <para style="q1" vid="SNG 5:2">“Ndizarurire, hanzvadzi yangu, mudiwa wangu,</para>
  <para style="q2" vid="SNG 5:2">njiva yangu, wangu asina chinongo.</para>
  <para style="q1" vid="SNG 5:2">Musoro wangu wanyorova nedova,</para>
  <para style="q2" vid="SNG 5:2">bvudzi rangu ranyoroveswa nounyoro hweusiku.”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>Ndabvisa nguo yangu,</para>
  <para style="q2" vid="SNG 5:3">ndoipfekazve here?</para>
  <para style="q1" vid="SNG 5:3">Ndashambidza tsoka dzangu,</para>
  <para style="q2" vid="SNG 5:3">ndodzisvibisazve here?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>Mudiwa wangu akapinza ruoko rwake nepahwangwadza yomukova;</para>
  <para style="q2" vid="SNG 5:4">mwoyo wangu wakatanga kumudokwairira.<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>Ndakasimuka kuti ndizarurire mudiwa wangu,</para>
  <para style="q2" vid="SNG 5:5">maoko angu akadonha mura,</para>
  <para style="q1" vid="SNG 5:5">mimwe yangu ichiyerera mura,</para>
  <para style="q2" vid="SNG 5:5">pazvibato zvechizarira.<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>Ndakazarurira mudiwa wangu,</para>
  <para style="q2" vid="SNG 5:6">asi mudiwa wangu akanga abva; akanga atoenda.</para>
  <para style="q1" vid="SNG 5:6">Mwoyo wangu wakarwadziwa nokuenda kwake.</para>
  <para style="q2" vid="SNG 5:6">Ndakamutsvaka asi handina kumuwana.</para>
  <para style="q2" vid="SNG 5:6">Ndakamudana asi haana kupindura.<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>Varindi vakandiona</para>
  <para style="q2" vid="SNG 5:7">pavaiva pabasa ravo rokufamba-famba vachichengetedza guta.</para>
  <para style="q1" vid="SNG 5:7">Vakandirova, vakandikuvadza;</para>
  <para style="q2" vid="SNG 5:7">vakanditorera jasi rangu,</para>
  <para style="q2" vid="SNG 5:7">ivavo varindi vamasvingo!<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>Imi vanasikana veJerusarema, ndinokurayirai,</para>
  <para style="q2" vid="SNG 5:8">kana mukaona mudiwa wangu,</para>
  <para style="q1" vid="SNG 5:8">muchamuudzeiko?</para>
  <para style="q2" vid="SNG 5:8">Mumuudze kuti ndinorwara nerudo.<verse eid="SNG 5:8"/></para>
  <para style="sp">Shamwari</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>Mudiwa wako akanaka kukunda vamwe pakudii,</para>
  <para style="q2" vid="SNG 5:9">iwe zvako wakanaka kukunda vamwe vakadzi?</para>
  <para style="q1" vid="SNG 5:9">Mudiwa wako akanaka kukunda vamwe pakudii,</para>
  <para style="q2" vid="SNG 5:9">zvaunotirayira kudaro?<verse eid="SNG 5:9"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>Mudiwa wangu akanaka uye mutsvuku,</para>
  <para style="q2" vid="SNG 5:10">anokunda vanokwana zviuru gumi.<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>Musoro wake igoridhe chairo;</para>
  <para style="q2" vid="SNG 5:11">bvudzi rake rinoyevedza</para>
  <para style="q2" vid="SNG 5:11">uye rakasviba segunguo.<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>Meso ake akafanana nenjiva</para>
  <para style="q2" vid="SNG 5:12">dziri pahova dzemvura,</para>
  <para style="q1" vid="SNG 5:12">dzakashambidzwa mumukaka,</para>
  <para style="q2" vid="SNG 5:12">akarongwa sezvishongo.<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>Matama ake akaita semihomba yezvinonhuhwira</para>
  <para style="q2" vid="SNG 5:13">inobereka zvinonhuhwira.</para>
  <para style="q1" vid="SNG 5:13">Miromo yake yakaita samaruva amahapa</para>
  <para style="q2" vid="SNG 5:13">anodonha mura.<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>Maoko ake itsvimbo dzegoridhe</para>
  <para style="q2" vid="SNG 5:14">dzakaiswa mabwe anokosha ekrisorite.</para>
  <para style="q1" vid="SNG 5:14">Muviri wake wakaita senyanga dzenzou dzinobwinya</para>
  <para style="q2" vid="SNG 5:14">dzakashongedzwa nesafire.<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>Makumbo ake imbiru dzamabwe machena</para>
  <para style="q2" vid="SNG 5:15">akamiswa pazvigadziko zvegoridhe rakanatswa.</para>
  <para style="q1" vid="SNG 5:15">Chimiro chake chakaita seRebhanoni,</para>
  <para style="q2" vid="SNG 5:15">chakanakisisa semisidhari yayo.<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>Muromo wake inhapitapi pachayo;</para>
  <para style="q2" vid="SNG 5:16">zvirokwazvo akaisvonaka.</para>
  <para style="q1" vid="SNG 5:16">Uyu ndiye mudiwa wangu, ndiye shamwari yangu,</para>
  <para style="q2" vid="SNG 5:16">imi vanasikana veJerusarema.<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">Shamwari</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>Ko, mudiwa wako aendepiko,</para>
  <para style="q2" vid="SNG 6:1">iwe zvako wakanaka kukunda vamwe vakadzi?</para>
  <para style="q1" vid="SNG 6:1">Mudiwa wako aenda nokupiko,</para>
  <para style="q2" vid="SNG 6:1">kuti tigomutsvaka pamwe chete newe?<verse eid="SNG 6:1"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>Mudiwa wangu adzika kubindu rake,</para>
  <para style="q2" vid="SNG 6:2">kumihomba yezvinonhuwirira,</para>
  <para style="q1" vid="SNG 6:2">kuti andomema mumapindu</para>
  <para style="q2" vid="SNG 6:2">uye agotanha maruva.<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>Ini ndiri womudiwa wangu uye mudiwa wangu ndowangu;</para>
  <para style="q2" vid="SNG 6:3">anomema pakati pamaruva.<verse eid="SNG 6:3"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>Wakanaka iwe mudiwa wangu, seTiriza,</para>
  <para style="q2" vid="SNG 6:4">unoyevedza seJerusarema,</para>
  <para style="q2" vid="SNG 6:4">unoremekedzeka samauto ane mireza.<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>Bvisa meso ako pandiri;</para>
  <para style="q2" vid="SNG 6:5">anondikunda.</para>
  <para style="q1" vid="SNG 6:5">Bvudzi rako rakaita sedanga rembudzi</para>
  <para style="q2" vid="SNG 6:5">riri kuburuka muGireadhi.<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>Meno ako akafanana neboka ramakwai</para>
  <para style="q2" vid="SNG 6:6">achangobva mukushambidzwa.</para>
  <para style="q1" vid="SNG 6:6">Rimwe nerimwe rine rarakafanana naro,</para>
  <para style="q2" vid="SNG 6:6">pasina riri roga zvaro.<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>Zvavovo zvako zviri mumumbure wako</para>
  <para style="q2" vid="SNG 6:7">zvakaita sezvikamu zviviri zvedamba.<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>Kungava navanamambokadzi makumi matanhatu,</para>
  <para style="q2" vid="SNG 6:8">navarongo makumi masere</para>
  <para style="q2" vid="SNG 6:8">nemhandara dzisingaverengeki;<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>Asi njiva yangu, iye akakwana wangu,</para>
  <para style="q2" vid="SNG 6:9">ndiwe mumwe oga, mwanasikana mumwe oga wamai vake,</para>
  <para style="q2" vid="SNG 6:9">iye woga anodikanwa naiye akamubereka.</para>
  <para style="q1" vid="SNG 6:9">Mhandara dzakamuona dzikamuti akaropafadzwa.</para>
  <para style="q2" vid="SNG 6:9">Vanamambokadzi navarongo vakamurumbidza.<verse eid="SNG 6:9"/></para>
  <para style="sp">Shamwari</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>Ko, ndiani uyo anoratidzika samambakwedza,</para>
  <para style="q2" vid="SNG 6:10">akanaka somwedzi, anopenya sezuva,</para>
  <para style="q2" vid="SNG 6:10">akanaka senyeredzi dziri mumudungwe?<verse eid="SNG 6:10"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>Ndakadzika kusango remiti yemipfura</para>
  <para style="q2" vid="SNG 6:11">kundoona zvitsva zvakamera mumupata,</para>
  <para style="q1" vid="SNG 6:11">kundoona kana mizambiringa yainge yabukira,</para>
  <para style="q2" vid="SNG 6:11">kana kuti mitamba yainge yava namaruva.<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>Ndisati ndambodii,</para>
  <para style="q2" vid="SNG 6:12">mwoyo wangu wakandiisa pakati pengoro dzoumambo dzavanhu vangu.<verse eid="SNG 6:12"/></para>
  <para style="sp">Shamwari</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>Dzoka, dzoka iwe muShurami;</para>
  <para style="q2" vid="SNG 6:13">dzoka, dzoka kuti timbokuona!</para>
  <para style="sp" vid="SNG 6:13">Mudiwa</para>
  <para style="q1" vid="SNG 6:13">Ko, munodirei kuona muShurami</para>
  <para style="q2" vid="SNG 6:13">sezvamunoita mutambo weMahanaimi?<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>Dzakanaka sei tsoka dzako dzakapfekedzwa shangu,</para>
  <para style="q2" vid="SNG 7:1">iwe mwanasikana womuchinda!</para>
  <para style="q1" vid="SNG 7:1">Makumbo ako akanakisisa akaita sezvishongo,</para>
  <para style="q2" vid="SNG 7:1">basa ramaoko emhizha.<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>Guvhu rako rakatenderera somukombe</para>
  <para style="q2" vid="SNG 7:2">unogara uine waini yakasanganiswa zvakanaka.</para>
  <para style="q1" vid="SNG 7:2">Chiuno chako murwi wegorosi</para>
  <para style="q2" vid="SNG 7:2">wakakomberedzwa namaruva.<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>Mazamu ako akaita setsvana mbiri,</para>
  <para style="q2" vid="SNG 7:3">mapatya emhara.<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>Mutsipa wakaita seshongwe yakagadzirwa nenyanga dzenzou.</para>
  <para style="q1" vid="SNG 7:4">Meso ako ndiwo madziva eHeshibhoni</para>
  <para style="q2" vid="SNG 7:4">pasuo reBhati Rabhimi.</para>
  <para style="q1" vid="SNG 7:4">Mhuno yako yakaita seshongwe yeRebhanoni</para>
  <para style="q2" vid="SNG 7:4">yakatarisa kudivi reDhamasiko.<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>Musoro wako unokushongedza nekorona seGomo reKarimeri.</para>
  <para style="q2" vid="SNG 7:5">Bvudzi rako rakaita sezvirukwa zvomumba mamambo;</para>
  <para style="q2" vid="SNG 7:5">mwoyo wamambo wakabatwa nokugadzirwa kwebvudzi rako.<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>Wakanaka uye unofadza sei,</para>
  <para style="q2" vid="SNG 7:6">iwe mudiwa nezvinofadza zvako!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>Chimiro chako chakaita somuti womuchindwe;</para>
  <para style="q2" vid="SNG 7:7">uye mazamu ako samasumbu omuchero.<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>Ndakati, “Ndichakwira muchindwi uyu,</para>
  <para style="q2" vid="SNG 7:8">ndigobata muchero wawo.”</para>
  <para style="q1" vid="SNG 7:8">Mazamu ako ngaaite samasumbu omuzambiringa,</para>
  <para style="q2" vid="SNG 7:8">munhuwi wokufema kwako uite samaapuro,<verse eid="SNG 7:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9"/>muromo wako ugoita sewaini yakanakisisa.</para>
  <para style="sp" vid="SNG 7:9">Mukadzi</para>
  <para style="q1" vid="SNG 7:9">Waini ngaiendeswe kumudiwa wangu chaiko,</para>
  <para style="q2" vid="SNG 7:9">igoyerera zvinyoronyoro, napamiromo yake nameno ake.<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>Ini ndiri womudiwa wangu,</para>
  <para style="q2" vid="SNG 7:10">uye iye anondishuva.<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>Uya, mudiwa wangu, ngatiendei kumunda,</para>
  <para style="q2" vid="SNG 7:11">tigozopedza usiku hwose kumaruwa.<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>Ngatimukirei kuminda yemizambiringa</para>
  <para style="q2" vid="SNG 7:12">tindoona kana mizambiringa yakabukira,</para>
  <para style="q1" vid="SNG 7:12">uye kana maruva awo azaruka,</para>
  <para style="q2" vid="SNG 7:12">uye kana mitamba yatumbuka yava namaruva,</para>
  <para style="q2" vid="SNG 7:12">ikoko ndiko kwandichakupa rudo rwangu.<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>Miti yemidiwadiwa inopa kunhuhwira kwayo,</para>
  <para style="q2" vid="SNG 7:13">uye pamusuo pedu pane zvinonaka zvose,</para>
  <para style="q1" vid="SNG 7:13">zvose zvitsva nezvitsaru,</para>
  <para style="q2" vid="SNG 7:13">zvandakachengetera iwe, mudiwa wangu.<verse eid="SNG 7:13"/></para>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>Dai chete wakanga uri sehanzvadzi kwandiri,</para>
  <para style="q2" vid="SNG 8:1">akanwa pamazamu amai vangu!</para>
  <para style="q1" vid="SNG 8:1">Ipapo kana ndaikuwana panze,</para>
  <para style="q2" vid="SNG 8:1">ndaikutsvoda</para>
  <para style="q2" vid="SNG 8:1">uye hapana aizondishora.<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>Ndaizokutora ndouya newe</para>
  <para style="q2" vid="SNG 8:2">kumba kwamai vangu,</para>
  <para style="q2" vid="SNG 8:2">ivo vakandidzidzisa.</para>
  <para style="q1" vid="SNG 8:2">Ndaikupa waini yakaiswa zvinonhuhwira kuti unwe,</para>
  <para style="q2" vid="SNG 8:2">nomukume wemitamba yangu.<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>Ruoko rwake rworuboshwe rwuri pasi pomusoro wangu,</para>
  <para style="q2" vid="SNG 8:3">uye ruoko rwake rworudyi rwakandimbundikira.<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>Imi vanasikana veJerusarema ndinokurayirai:</para>
  <para style="q2" vid="SNG 8:4">Musazunguza kana kumutsa rudo</para>
  <para style="q2" vid="SNG 8:4">kusvikira irwo rwada rwoga.<verse eid="SNG 8:4"/></para>
  <para style="sp">Shamwari</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>Ndianiko uyo ari kuuya achibva kurenje</para>
  <para style="q2" vid="SNG 8:5">akazendamira pamudiwa wake?</para>
  <para style="sp" vid="SNG 8:5">Mukadzi</para>
  <para style="q1" vid="SNG 8:5">Pasi pomuti womuapuro ndakakumutsa;</para>
  <para style="q2" vid="SNG 8:5">ipapo mai vako vakakubereka,</para>
  <para style="q2" vid="SNG 8:5">ipapo ivo vairwadziwa vakakubereka.<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>Ndiise pamwoyo pako sechisimbiso,</para>
  <para style="q2" vid="SNG 8:6">sechisimbiso paruoko rwako;</para>
  <para style="q1" vid="SNG 8:6">nokuti rudo rwakasimba sorufu,</para>
  <para style="q2" vid="SNG 8:6">godo rarwo seguva harishanduki.</para>
  <para style="q1" vid="SNG 8:6">Runopisa serimi romoto,</para>
  <para style="q2" vid="SNG 8:6">somurazvo mukuru kwazvo.<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>Mvura zhinji haigoni kudzima rudo;</para>
  <para style="q2" vid="SNG 8:7">nzizi hadzigoni kurukukura.</para>
  <para style="q1" vid="SNG 8:7">Kunyange munhu akapa</para>
  <para style="q2" vid="SNG 8:7">pfuma yose yemba yake kuti awane rudo,</para>
  <para style="q2" vid="SNG 8:7">zvingazvidzwa chose.<verse eid="SNG 8:7"/></para>
  <para style="sp">Shamwari</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>Tine hanzvadzi yedu duku</para>
  <para style="q2" vid="SNG 8:8">uye mazamu ake haasati akura.</para>
  <para style="q1" vid="SNG 8:8">Tichaitireiko hanzvadzi yedu</para>
  <para style="q2" vid="SNG 8:8">pazuva rokukumbirwa kwayo kuti iwanikwe?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>Kana ari rusvingo,</para>
  <para style="q2" vid="SNG 8:9">tichavaka shongwe dzesirivha paari.</para>
  <para style="q1" vid="SNG 8:9">Kana ari musuo,</para>
  <para style="q2" vid="SNG 8:9">tichamukomberedza namapuranga omusidhari.<verse eid="SNG 8:9"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>Ndiri rusvingo,</para>
  <para style="q2" vid="SNG 8:10">mazamu angu akaita seshongwe.</para>
  <para style="q1" vid="SNG 8:10">Ndizvo zvandava pamberi pake,</para>
  <para style="q2" vid="SNG 8:10">somunhu anouyisa kugutsikana.<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>Soromoni aiva nomunda wemizambiringa muBhaari Hamoni;</para>
  <para style="q2" vid="SNG 8:11">akapa munda wake wemizambiringa kuvanhu vairima vachimuripira.</para>
  <para style="q1" vid="SNG 8:11">Mumwe nomumwe wavo pachibereko chawo</para>
  <para style="q2" vid="SNG 8:11">aiuya namashekeri chiuru<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">makirogiramu angaita 11.5 </char></note> esirivha.<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>Asi munda wangu wemizambiringa ndewangu kuti ndiupe;</para>
  <para style="q2" vid="SNG 8:12">chiuru chamashekeri esirivha ndechako, iwe Soromoni,</para>
  <para style="q2" vid="SNG 8:12">asi mazana maviri<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">makirogiramu angaita 2.3</char></note> ndeevanochengeta michero yawo.<verse eid="SNG 8:12"/></para>
  <para style="sp">Murume</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>Iwe unogara mumapindu</para>
  <para style="q2" vid="SNG 8:13">unoshandirwa neshamwari,</para>
  <para style="q2" vid="SNG 8:13">rega ndinzwe inzwi rako!<verse eid="SNG 8:13"/></para>
  <para style="sp">Mukadzi</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>Handei mudiwa wangu,</para>
  <para style="q2" vid="SNG 8:14">uite semhara kana setsvana</para>
  <para style="q1" vid="SNG 8:14">pamusoro pamakomo</para>
  <para style="q2" vid="SNG 8:14">azere zvinonhuhwira.<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
