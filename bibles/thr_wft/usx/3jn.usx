<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Rana Tharu</book>
  <para style="h">3 यूहन्ना</para>
  <para style="toc3">3 यूहन्ना</para>
  <para style="toc2">3 यूहन्ना</para>
  <para style="toc1">यूहन्ना की तीसरी चिट्ठी</para>
  <para style="mt2">यूहन्ना की तीसरी चिट्ठी</para>
  <para style="mt1">यूहन्ना की तीसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">3 यूहन्ना की चिट्ठी प्रेरित यूहन्ना के जरिया मसीह के जनम के 50 और 100 सालन के बीच लिखी गई रहै। यूहन्ना खुदकै लेखक के रूप मैं नाय मानथै, बल्किन खुदकै बड़ो-बूढ़ो कहथै<char style="xt"><ref loc="3JN 1:1">1:1</ref></char>। बौ 2 यूहन्ना मैं भी ऐसोई करथै <char style="xt"><ref loc="3JN 1:1">1:1</ref></char>। ऐसो मानो जाथै कि यूहन्ना इफिसुस मैं रहत भै यूहन्ना और तीन किताबन कै 1 यूहन्ना, 2 यूहन्ना और 3 यूहन्ना लिखी रहै।</para>
  <para style="ip">यूहन्ना जौ चिट्ठी गयुस नाओं के एक विस्वासी कै लिखी रहै। बौ गयुस कै एक दोस्त के रूप मैं संबोधित करथै और बाकै मसीह भईय्यन की तरफदारी करन को निर्देस देथै जो बौ छेत्र से सफर कर रै हैं।</para>
  <para style="iot">रूपरेखा:</para>
  <para style="io1">1. यूहन्ना अपनी चिट्ठी को परिचय देथै। <char style="ior"><ref loc="3JN 1:1">1:1</ref></char></para>
  <para style="io1">2. फिर बौ गयुस कै प्रोत्साहित करथै और बाके भईय्यन की तरफदारी करन को निर्देस देथै। <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">3. जाके बाद, बौ दुई दुसरे लोगन, दियुत्‌रिफेस और दिमेत्‌रियुस की बात करथै। <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref> </char></para>
  <para style="io1">4. आखरी मैं बौ अपनी चिट्ठी खतम करथै। <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>बड़े-बूढ़ेन से मेरे प्रिय गयुस, जोकै मैं सच्चो प्रेम करथौं।<verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>मेरे प्रिय दोस्त, मैं मन से प्रार्थना करथौं कि तेरे संग सब कछु अच्छो होबै और तैं अच्छी सेहत को रहबै, काहैकि मोकै पता है कि तैं आत्मा से अच्छो है। <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>मोकै बड़ा खुसी भइ जब कुछ संग के मसीह भईय्या आए और मोकै गभाई दईं कि तैं सच्चाई के प्रति कितनो वफादार है, जैसे तैं हमेसा से सच्चाई मैं जीथैं। <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>जितनी खुसी मोकै जौ सुनकै होथै कि मेरे बालका सच्चाई मैं जीथैं उतनी खुसी मोकै और कोई बात से ना होथै।<verse eid="3JN 1:4"/></para>
  <para style="s">गयुस कि बड़ाँईं करी जाथै</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>मेरे प्रिय दोस्त, दुसरे मसीह भईय्या और अजनबियन के संग जो भी करै तैं भरोसेमंद कर। <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>बे तेरे प्रेम के बारे मैं कलीसिया के सामने गभाई दईं हैं। किरपा करकै उनके सफर कै जो तरीका से जारी रखन मैं मदत कर जो कि परमेस्वर कै खुस करैं। <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>काहैकि बे बौ नाओं के ताहीं निकरे हैं, और गैर यहूदि से कुछ ना लेथैं। <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>हम मसीहीयन कै जे आदमिन कि मदत करनो चाहिए, ताकी हम सच्चाई के पक्छ मैं उनके सहकर्मी होमैं।<verse eid="3JN 1:8"/></para>
  <para style="s">दियुत्‌रिफेस और दिमेत्‌रियुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>मैं कलीसिया कै एक छोटी चिट्ठी लिखो; लेकिन दियुत्‌रिफेस, जो उनको नेता बननो पसंद करथै, मैं जौ कहथौं, बाके ऊपर कोई ध्यान ना देगो। <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>जब मैं आंगो, तौ मैं बाकी हर बात जो बौ कर रौ है मैं ध्यान मैं लांगो: जो भयानक और झूठी बातैं बौ हमरे बारे मैं कहथै! लेकिन बौ बाके ताहीं काफी ना है; जब मसीह भईय्या आंगे तौ उनकै बौ अपनात न है और जो लोग उनकै अपनानो चाहथैं उनकै बौ रोकथै और उन्हैं कलीसिया से निकारन की कोसिस करथै!<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>मेरे प्रिय दोस्त, जो बुरो है बाकी नकल मत करौ, बल्कि जो अच्छो है बाकी नकल करौ। जो अच्छो करथै बौ परमेस्वर को है; जो बुरो करथै बौ परमेस्वर कै ना देखी है।<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>हर कोई दिमेत्‌रियुस के बारे मैं अच्छो कहथै; बल्किन सच्चाई भी खुद गभाई दई। और हमउँ अपनी गभाई जोड़थैं, और तैं जानथै कि हम जो कहथैं बौ सच है।<verse eid="3JN 1:12"/></para>
  <para style="s">आखरी नमस्ते</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>मेरे पास तोकै बतान के ताहीं भौत कछु है, लेकिन मैं जाकै कलम और स्याई से ना लिखनो चाहथौं। <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>मोकै आसा है कि तोसे जल्दियै भेंटा होगो, और फिर हम आमने-सामने बातचीत करंगे।<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>तोकै सांति मिलत रहबै।</para>
  <para style="p" vid="3JN 1:15">तेरे सबै दोस्त तोकै नमस्ते करथैं। हूँना के दोस्तन के नाओं लै लैकै नमस्ते कह दिये।<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
