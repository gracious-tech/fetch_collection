<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Rana Tharu</book>
  <para style="toc3">2 तीमुथियुस</para>
  <para style="toc2">2 तीमुथियुस</para>
  <para style="toc1">तीमुथियुस कै लिखी भइ पौलुस की दुसरी चिट्ठी</para>
  <para style="mt2">तीमुथियुस को लिखी हुई पौलुस की दूसरी चिट्ठी</para>
  <para style="mt1">तीमुथियुस कै लिखी भइ पौलुस की दुसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">2 तीमुथियुस की किताब प्रेरित पौलुस को अपनो चेला तीमुथियुस कै लिखी दुसरी चिट्ठी है। 2 तीमुथियुस पौलुस की जिंदगी के आखरी मैं लिखी गई रहै। बौ जौ समय रोम देस मैं कैदी रहै<char style="xt"><ref loc="2TI 1:16">1:16</ref></char>। पौलुस को तीमुथियुस के संग सगो रिस्ता रहै और जद्धेतर बाकै लौड़ा के रूप मैं भौत बार संबोधित करथै <char style="xt"><ref loc="2TI 2:22">2:22</ref></char>,<char style="xt"><ref loc="1TI 2">1 तीमुथियुस 2</ref></char>, <char style="xt"><ref loc="2TI 1:18">1:18</ref></char>। जौ चिट्ठी पौलुस की बे चार चिट्ठिन मैं से है जो कलीसिया के बजाय एक आदमी कै संबोधित करथै। दुसरी तीन चिट्ठी जे हैं: 1 तीमुथियुस, तीतुस और फिलेमोन। बौ समय के पोती जब 2 तीमुथियुस कै लिखो गौ रहै, रोमन साम्राज्य मैं मसीहीयन कै सताओ जात रहै। सायद जहे कारड़ रहै कि पौलुस कैदखाना मैं रहै; और तीमुथियुस कै परेसानी झेलन की खबर देत रहै। 1 तीमुथियुस के हानी, पौलुस तीमुथियुस कै झूठे सिक्छन के बारे मैं तमान चितौनिया दई <char style="xt"><ref loc="1TI 1:16-18">1 तीमुथियुस 1:16-18</ref></char>। बौ तीमोथी कै जहो बताथै कि अग्गु मुस्किल समय होगो। <char style="xt"><ref loc="2TI 3:1">3:1</ref> </char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस तीमुथियुस कै नमस्ते करकै सुरुवात करथै और फिरौंकी बाकै बढ़ावा देथै <char style="ior"><ref loc="2TI 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. फिर बौ तीमुथियुस कै धीरज धरन की चितौनी दई है। <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref></char></para>
  <para style="io1">3. जाके बाद बौ बाकै कुछ सामान्य सूचना देथै। <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref></char></para>
  <para style="io1">4. फिरौंकी बौ बाकै भविस्य की घटना और प्रतिसाद देन के सई तरीका के बारे मैं चितौनी देथै। <char style="ior"><ref loc="2TI 3:1-4:8">3:1–4:8</ref></char></para>
  <para style="io1">5. पौलुस तीमुथियुस के ताहीं कुछ निजी राय के संग खतम करथै। <char style="ior"><ref loc="2TI 4:9-22">4:9-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पौलुस के घाँईं से, परमेस्वर की मरजी से मसीह ईसु को एक प्रेरित, जो हमैं दौ गौ है बौ जिंदगी को वादा करन ताहीं भेजो गौ है, जो हमरे झोने ईसु मसीह के संग एक होन के नाते। <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितो 16:1</ref></char></note>तीमुथियुस के ताहीं, मेरे प्रिय लौड़ा: मैं परमेस्वर दऊवा और ईसु मसीह हमरो प्रभु तुमकै अनुग्रह, दया और सांति देबै।<verse eid="2TI 1:2" /></para>
  <para style="s">धन्यवाद और बढ़ावा</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />मैं परमेस्वर को धन्यवाद देथौं, जिनको मैं साफ मन से सेवा करथौं, जैसी मेरे पुरखा करी रहैं। मैं बाकै धन्यवाद देथौं काहैकि मैं तुमकै हमेसा रात-दिन प्रार्थना मैं समकथौं। <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />मैं तुमरे आँसुअन कै समकत रहाथौं, और मेरी भावना तुमकै देखन ताहीं तरस गई है, ताकी तुमकै देखकै मैं खुसी से भर जामौं। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितो 16:1</ref> </char></note>मोकै तेरी बौ इमानदारी बारो बिस्वास समक मैं आथै, जो पहले तेरी नानी लोइस और तेरी अईय्या यूनीके मैं रहै, और मोकै सच मैं पता है कि तहूँ मैं है। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />जौ बजह से मैं तुमकै समकाथौं, जब मैं तुमरे ऊपर हाथ रखो तौ परमेस्वर तुमकै जो उपहार दई, बाकै जिंदो रखैं। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />जो आत्मा परमेस्वर हमकै दई है बौ हमकै डरपुकना नाय बनाथै; जाके अलावा, बाकी आत्मा हमकै सक्ति, प्रेम और अपने आपकै काबू मैं रखान की आत्मा दई है।<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />तभई हमरे प्रभु की गभाई से, और मोसे जो बाको कैदी हौं, सरमाबै मत्ती, पर बौ परमेस्वर की सामर्थ्य से सुसमाचार के ताहीं दुख मैं सहभागी हो। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />बौ हमैं बचाई और हमकै पवित्र बुलाहट से अपने लोगन के रूप मैं बुलाई, ना कि हम जो करे हैं, बाके बजह से, पर अपने उद्देस्य और अनुग्रह के बजह से। बौ हमकै जौ अनुग्रह दई है कि अनंत समय के सुरू होन से पहलिये ईसु मसीह के जरिया भौ है, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पर जौ हमरे उद्धारकर्ता, ईसु मसीह के आन से हमैं पता चलो है। बौ मौत की सक्ति कै खतम कर दई है और सुसमाचार के जरिया अनंत जिंदगी कै दिखाई है।<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:11 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 2:7">1 तीमुथियुस 2:7</ref> </char>
    </note>परमेस्वर मोकै सुसमाचार सुनान के ताहीं एक प्रेरित और सिक्छक के रूप मैं चुनी है, <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />जौ बजह से कि मैं जे चीजन कै भुगत्थौं, पर मैं अभऊ बिस्वास से भरो हौं, काहैकि मैं जानथौं कि जोके ऊपर मैं भरोसो करो हौं, और मोकै यकीन है कि बौ बहे दिन ले समारे रखान मैं कामयाब है, जो बौ मोकै सौंपीं है। <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जिन खरी बातन कै तैं मेरे मोहों से सुनो, उनकै दृढ़ता से सच्चे सब्दन कै जोमैं तुमकै सिखाओ, जैसो की ईसु मसीह के संग, हमरो बिस्वास और प्रेम को पालन करन के ताहीं और हमरे संग बने रहेन के ताहीं उदाहरड़ है। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />पवित्र आत्मा की सक्ति, जो हमरे मैं रहथै, बे अच्छी चीजन कै अपने झोने रख जो तुमकै सौंपीं गई हैं।<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />तुम जानथौ कि फिगेल्स और हर्मोजेनेस समेत आसिया के सबै देस मैं मोकै छोड़ दौ गौ है। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />प्रभु उनेसिफुरुस के परिवार ऊपर दया करी, काहैकि मोकै निरे बार मेरे जी कै ठंडो करी, और मेरी जंजीरन से लज्जित नाय भौ; <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पर जब बौ रोम मैं आओ, बौ मोकै ढूँड़नो सुरू कर दई, जबले कि बौ मोकै पाय ना डारी। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />प्रभु बौ दिन बाकै अपनी दया दिखाबै! और तुम अच्छे तरीका से जानथौ कि बौ इफिसुस मैं मेरे संग कित्तो कुछ सेवा करी।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">ईसु मसीह को एक बफादार सैनिक</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />जैसे कि, मेरे लौड़ा, तेरे ताहीं अनुग्रह के जरिया से मजबूत हुई जा जो मसीह ईसु के संग एक होन के नाते है। <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />बे उपदेसन कै ले जो तैं मोकै निरे गभा की मौजूदगी मैं सुनाओ, और उनकै बिस्वास बारे लोगन कै सौंपो, जो दूसरेन कै भी सिखान मैं कामयाब होंगे।<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />ईसु मसीह के एक बफादार सैनिक के रूप मैं, दुख को अपनो हिस्सा लै लियौ। <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />जब कोई सैनिक लड़न कै जाथै, तौ जहे बजह से कि अपने आग्या देनबारे अधिकारी कै खुस करै, और खुदकै दुनिया के दैनिक जिंदगी के कामन मैं नाय फसाथै। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />एक दौड़ को खिलाड़ी दौड़ मैं हिस्सा लेथै, जबले कि बौ नियमन को पालन नाय करै, इनाम नाय पाय सकथै। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जो किसान मेहनत करी है, बाके पास फसल को पहलो हिस्सा होनो चाहिए। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जोमैं कहरौ हौं, बाके बारे मैं सोचौ, काहैकि प्रभु तुमकै जौ सब समझन मैं कामयाबी देगो।<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />ईसु मसीह कै याद करौ, जो मौत से जी उठ गौ रहै, जो दाऊद के बंस को रहै, जैसे कि जो सुसमाचार मैं सुनाथौं बामै पढ़ाओ जाथै। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />काहैकि मैं सुसमाचार को प्रचार करथौं, मोकै तकलीफ होथै और मैं एक गुन्हेगार के तराहनी बेड़ियन मैं भंद जाथौं। पर परमेस्वर को बचन बेड़ियन मैं नाय है, <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />और तभई मैं परमेस्वर के चुने भै लोगन के खातिर सब कछु सह लेथौं, ताकी बेऊँ ईसु मसीह के जरिया आनबारे उद्धार कै लै सकैं और अनंत महिमा लाय पामैं। <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />जौ एक सच्ची कहाबत है:</para>
  <para style="q1" vid="2TI 2:11">“अगर हम बाके संग मर गै हैं, तौ हमउँ बाके संग जिंदे रहेंगे। <verse eid="2TI 2:11" /><verse number="12" style="v" sid="2TI 2:12" /><note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">मत्ती 10:33</ref>; <ref loc="LUK 12:9">लूका 12:9</ref>; <ref loc="NUM 16:5">गिनती 16:5</ref></char></note> अगर हम सहैत रहाथैं, तौ हमउँ बाके संग राज्य करंगे। अगर हम बाकै नकारथैं, तौ बहो हमकै नकारैगो। <verse eid="2TI 2:12" /><verse number="13" style="v" sid="2TI 2:13" />अगर हम वफादार नाय हैं, तौ बौ वफादार रहथै, काहैकि बौ खुद से झूठ नाय बोल सकथै।”<verse eid="2TI 2:13" /></para>
  <para style="s">एक अपनाओ भौ करमचारी</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />अपने लोगन कै जाके बारे मैं समकाबौ, और उनकै परमेस्वर की मौजूदगी के ताहीं गंभीर तरीका से सुधी दिबाए देबौ कि बे सब्दन के ऊपर नाय लड़ैं। जो फायदेमंद ना है, पर सिरफ सुनन बारेन कै बरबाद करथै। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />परमेस्वर की नजर मैं पूरी पसंद आन के ताहीं पूरी कोसिस करौ, एक ऐसे करमचारी के रूप मैं जो अपने काम से सरमात नाय है, बौ जो परमेस्वर की सच्चाई के संदेसो कै सई ढंग से सिखाथै। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />अपवित्र और अभक्ति की बेकार की बातन से परे रहाबौ, जो सिरफ आदमिन कै परमेस्वर से दूर लै जाथैं। <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />उनको बचन सड़े भै घाव के हानी फैलत जागो: दुई लोग हुमिनयुस और फिलेटस हैं जो ऐसी बातन कै सिखाथैं। <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />बे सच्चाई की रहा छोड़ दईं हैं और जौ कहकै कुछ विस्वासिन कै परेसान कर्‌रै हैं कि हमरो पुनरुत्थान पहले हुई चुको है। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />लेकिन परमेस्वर जो ठोस बुनियाद डारी है बाकै हीलाओ नाय जाए सकथै; और बाके ऊपर जे सब्द लिखे गै हैं: “प्रभु जानथै कि जो बाको नाओं लेथैं, उनकै अधर्म के कामन से दूर रहनो चाहिए।” <verse eid="2TI 2:19" /><verse number="20" style="v" sid="2TI 2:20" />एक बड़े घर मैं सबै तराहनी के भोज और कटोरा होथैं: कुछ सोने और चाँदी से बने होथैं, दूसरे कठिया और मट्टी से; एकाद खास मौका के ताहीं हैं, और दूसरे ऐसियै इस्तमाल करन ताहीं हैं। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />जो आदमी बे सब बुरी चीजन से खुदकै सपा करथैं, उनको इस्तमाल खास उद्देस्य के ताहीं करो जागो, काहैकि बे अपने गुरु के ताहीं समर्पित और उपयोगी हैं, हर अच्छे काम के ताहीं इस्तमाल होन के ताहीं तैयार हैं। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जवानी की अभिलासा से बचौ, और न्यायीपन, बिस्वास, प्रेम और सांति के ताहीं कोसिस करौ, बे लोगन के संग जो साफ मन से मदत के ताहीं प्रभु कै पुकारथैं। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पर मूर्ख और अग्यानी तर्कन से दूर रहबौ; तुमकै पता है कि बे लड़ाई मैं खतम होथैं। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />प्रभु के सेवक के रूप मैं तुमकै लड़ाई करन बारो नाय होनो चहाईये। तुम सबन कै एक अच्छो और धीर धरन बारो सिक्छक बननो चहाईये। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />जो तुमरे बिरोधिन कै सई करन के समय विनम्र है, काहैकि जौ हुई सकथै कि परमेस्वर उनकै पछताबा करन और सच्चाई जानन को मौका देगो। <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />और जो-जो उनकै पकड़ी रहैं और उनकी इच्छा को पालन करी रहैं। फिरौंकी बे अपने होस मैं आंगे और सैतान के चाल से बच जांगे।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">अंत के दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />याद रखौ कि अंत के दिनन मैं मुस्किल को समय होगो। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />लोग अपनो काम बनान बारे, पैसा से भौत प्यार करन बारे, लालची, घमंडी, और डींग हाँकन बारे होंगे; बे आदर नाय करन बारे, अपने अईय्या-दऊवा को कहनो नाय मानन बारे, कृतघ्न, और अधार्मिक होंगे; <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />बे निरदई, माफ ना करन बारे, निंदक, हिंसा करन बारे और उग्र होमंगे; बे अच्छाई से नफरत करंगे; <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />बे विस्वासघाती, लापरवाह, और घमंड से फूले भै होंगे; बे परमेस्वर के बजाय सुखविलास से प्रेम करंगे; <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />बे धर्म के बहारी रूप कै धरंगे, लेकिन धर्म की सच्चाई की सक्ति कै ना मानथैं; ऐसे आदमिन से दूर रहाबौ। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />उनमैं से एक-काद आदमिन के घरै जाएकै बे कमजोर बईंय्यरन कै वस मैं करथैं, जो पापन से दबी और सबै जैसी इच्छा के वस मैं हैं, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />जो बईंय्यरैं हमेसा सिखन की कोसिस कर रइ हैं पर बे कहु सच्चाई नाय जान सकथैं। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" /><note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">निर्गमन 7:11</ref></char></note>जैसे कि जैनेस और जैम्ब्रिज मूसा के बिरोधी रहैं, तहुँओं जे लोग सच्चाई के बिरोध मैं हैं, ऐसे आदमी जिनके दिमाक काम नाय करथैं और जो बिस्वास मैं असफल होथैं। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पर बे भौत दूर नाय जाए पांगे, काहैकि हर कोई देखैगो कि बे कित्ते बेअकली हैं। बैसिये भौ जैनेस और जैम्ब्रिज को।<verse eid="2TI 3:9" /></para>
  <para style="s">आखरी निर्देस</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />लेकिन तैं मेरी सिक्छा, मेरे चाल-चलन और जिंदगी मैं मेरे उद्देस्य को पालन करो है; तैं मेरो बिस्वास, मेरो सबर, मेरो प्रेम और मेरी सहनसक्ति, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">प्रेरितो 13:14-52</ref> </char></note>मेरो सताव, और मेरी परेसानी जानथै, कि अन्ताकिया, इकुनियुम और लुस्त्रा मैं मेरे संग जो भौ, बौ भयानक सताव रहै जोकै मैं सहो! पर प्रभु मोकै बे सबन से बचाई। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />सबै जनी जो ईसु मसीह के संग एक भक्ति मैं जीवन जीनो चाहथैं, बाकै सताओ जागो; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />और दुस्ट लोग और बहकानबारे बुरे से बुरे होत जांगे, और औरन कै और अपने आपकै धोका देत रहंगे। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पर तुम बे सच्चाई मैं चलते जाबौ, जो तुमकै सिखाई गई रहैं और मजबूती से बिस्वास करौ। तुम जानथौ कि तुमरे सिक्छा देनबारे कौन रहैं, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />और तुम समक रखाए हौ कि जब तुम बालका रहौ, तौ से पवित्र सास्त्र मैं लिखे बचन कै जानथौ, जो तुमकै ईसु मसीह मैं बिस्वास के जरिया से उद्धार के घाँईं लै जान बारो ग्यान देन मैं जाके काबिल है। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />पूरो सास्त्र परमेस्वर से प्रेरित हैं और सच्चाई कै सिखान, गलती कै झुकाने, दोसन कै सुधारन, धार्मिकता और सई जिंदगी जीन के निर्देस देन के ताहीं काम मैं आनबारे है, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ताकी परमेस्वर की सेवा करन बारो आदमी पूरे तरीका से लायक और काबिल हुई सकै और सबै तरहन के अच्छे काम कर सकै।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />परमेस्वर और मसीह ईसु की मौजूदगी मैं, जो जिंदे और मरे भै हैं, लोगन को न्याय करैगो, काहैकि बौ राजा के रूप मैं सासन करन के ताहीं आए रौ है, मैं तुमकै राज्य की सुधी दिबात भै नहोरे करथौं <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />तैं संदेसो को प्रचार कर; बेरा अबेरा समरो रहा, बड़े धीरज के संग सिक्छा कै देत रहा और लोगन कै सुधार, झुकाए और प्रोत्साहित कर। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />समय आगो जब आदमी अच्छे सिद्धांत कै नाय सुनंगे, लेकिन अपनी मरजी को चलंगे और अपने ताहीं जद्धे से जद्धे सिक्छकन कै जोड़ंगे जो उनकै बतांगे जो बे सुननो चाहथैं, जो सुनन के ताहीं उनके कान मैं खुजली ही रइ है। <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />बे सच्चाई कै ना सुनंगे और कहानी-कहानियन मैं अपनो ध्यान देमंगे। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पर तुमकै हर हाल मैं खुदकै काबु मैं रखनो चाहिए, दुख सहबौ, सुसमाचार प्रचारक को काम करौ और अपनी पूरी जिम्मेदारी परमेस्वर के सेवक के रूप मैं निभाबौ।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />मेरे ताहीं बलिदान होन को समय आए गौ है; जौ जिंदगी कै छोड़न को समय हीनैं है। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />मैं अपनी दौड़ अच्छी दौड़ो हौं, मैं जित्ती दूरी है उत्ति दौड़ लगाओ हौं, और मैं बिस्वास कै बनाए रखाओ हौं। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />और अब परमेस्वर के संग होन को जीत को इनाम मोकै असियाय रौ है कि, जो न्याई प्रभु, मोकै बौ दिन देगो और नाय सिरफ मेरे ताहीं, बल्किन बे सबन के ताहीं जो उनके संग प्यार कै असियाथैं।<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तिगत बोल</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />जल्दियै मेरे झोने आन की पूरी कोसिस करौ। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियों 4:14</ref>; <ref loc="2CO 8:23">2 कुरिन्थियों 8:23</ref>; <ref loc="GAL 2:3">गलातियों 2:3</ref>; <ref loc="TIT 1:4">तीतुस 1:4</ref></char></note>देमास कै जौ वर्तमान युग से प्रेम हुई गौ है और बौ मोकै छोड़ दई, थिस्सलुनीके के ताहीं चलो गौ, और क्रेसेन्स गलातिया कै और तीतुस दलमतिया कै चलो गौ। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियों 4:14</ref>; <ref loc="ACT 12:12">प्रेरितो 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलुस्सियों 4:10</ref></char></note>सिरफ लूका मेरे संग है, मरकुस कै अपने संगै लैया, काहैकि बौ सेवा के काम मैं मेरी मदत कर सकथै। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितो 20:4</ref>; <ref loc="EPH 6:21">इफिसियों 6:21</ref>,<ref loc="EPH 6:22">22</ref>; <ref loc="COL 4:7">कुलुस्सियों 4:7</ref>,<ref loc="COL 4:8">8</ref></char></note>मैं तुखिकुस कै इफिसुस भेजो हौं। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">प्रेरितो 20:6</ref></char></note>जब तुम आबौ, तौ मेरो कोट लियईयो जोकै मैं करपुस के संग तरोआस मैं छोड़याओ रहौं और किताबन कै जो खासकर कै चर्म पत्‌र से बने हैं।<figure style="fig" alt="Scrolls standing by ink well" file="hk00153c.tif" size="col" copy="Horace Knowles ©" ref="4:13">अच्छे तरहन से स्याही लगी भइ किताब</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">1 तीमुथियुस 1:20</ref>; <ref loc="PSA 62:12">भजन संहिता 62:12</ref>; <ref loc="ROM 2:6">रोमियों 2:6</ref></char>
    </note>सिकन्दर ठठेरा मेरो भौत नुकसान करी है; जो कछु बौ करी है बहे से प्रभु बाकै इनाम चुकागो। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />बाके के खिलाप चौकन्ने रहाबौ, काहैकि बौ बड़ा बुरे तरीका से हमरे संदेसो को बिरोध करत रहै।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />जब मैं पहली दफा खुदकै बचानो चाहो तौ, कोइयो मेरे संग नाय ठाड़ो रहै; सब मोकै छोड़ दईं। परमेस्वर जाकै उनके खिलाप नाय गिराय सकथै! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पर प्रभु मेरे संग रहै और मोकै सक्ति दई, जोसे कि मैं सबै गैर यहूदिन कै सुनन के ताहीं पूरो सुसमाचार को प्रचार करन मैं काबिल रहौं; और प्रभु मोकै सेरा के मोहों से बचाई। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />और प्रभु मोकै सब बुराइयन से बचामंगे और मोकै अपने स्वर्गिय राज्य मैं सई सलामत लै जांगे। बाकी महिमा हमेसा और हमेसा के ताहीं होबै! आमीन।<verse eid="2TI 4:18" /></para>
  <para style="s">आखरी नमस्ते</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितो 18:2</ref>; <ref loc="2TI 1:16">2 तीमुथियुस 1:16</ref>,<ref loc="2TI 1:17">17</ref></char>
    </note>मैं प्रिस्किल्ला और अक्विला और उनेसिफुरुस के परिवार कै सुभकामना भेजथौं। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">प्रेरितो 19:22</ref>; <ref loc="ROM 16:23">रोमियों 16:23</ref>; <ref loc="ACT 20:4">प्रेरितो 20:4</ref>; <ref loc="ACT 21:29">21:29</ref></char></note>एरास्तुस कुरिन्थ मैं रहो, और मैं तुरुफिमुस कै मीलेतुस मैं छोड़ दौ, काहैकि बौ बिमार रहै। <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />सर्दी से पहले आन की कोसिस करियो: युबुलुस, पुदेन्स, लीनुस और क्लौदिया और सबै मसीह भईय्या तोकै नमस्ते भेज रै हैं।<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />प्रभु तुमरी आत्मा के संग रहबै, परमेस्वर को अनुग्रह और किरपा तुम सबन ऊपर बनी रहाबै।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>