<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Rana Tharu</book>
  <para style="h">2 पतरस</para>
  <para style="toc3">2 पतरस</para>
  <para style="toc2">2 पतरस</para>
  <para style="toc1">पतरस से दुसरी चिट्ठी</para>
  <para style="mt2">पतरस की दुसरी चिट्ठी</para>
  <para style="mt1">पतरस की दुसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">2 पतरस की चिट्ठी मैं कहो गौ है कि जौ प्रेरित पतरस के जरिया लिखी गई रहै, लेकिन आज तमान विद्वान जाकै सच नाय मानथैं। जौ हुई सकथै कि कोई और जाकै पतरस के तरफ से लिखी होबै। और लेखक कहथै कि बौ ईसु की जिंदगी को खास रूप से रूपान्तरड़ कै देखी रहै <char style="xt"><ref loc="2PE 1:17-18">1:17-18</ref></char>। अगर पतरस चिट्ठी लिखी रहै, तौ हुई सकथै कि बौ जाकै रोम मैं मसीह के जनम के 65-69 सालन के बीच, मरन से पहले लिखी होबै। पतरस जाकै अपनी दुसरी चिट्ठी भी कहथै <char style="xt"><ref loc="2PE 3:1">3:1</ref></char> जो 1 पतरस की चिट्ठी के बाद लिखन की तारीक रखथै। बौ सबै मसीहियन कै चिट्ठी से संबोधित करी।</para>
  <para style="ip">पतरस जौ चिट्ठी विस्वासिन कै अच्छी जिंदगी जीन के ताहीं प्रोत्साहित करन और झूठे सिक्छकन को अनुसरँड़ ना करन की चितौनी देन के ताहीं लिखी रहै। बौ उनकै बे लोगन की उपेक्छा करन के ताहीं प्रोत्साहित करी जो कह रै हैं कि ईसु कै बापस लौटन मैं भौत समय लग रहो है। जाके बजाय बौ बताई कि परमेस्वर ढीलो नाय है बल्किन चाहथै कि हर कोई बचाओ जाबै <char style="xt"><ref loc="2PE 3:8-9">3:8-9</ref></char>। जौ एक अच्छी जिंदगी जीन को बजह है। <char style="xt"><ref loc="2PE 3:14">3:14</ref> </char></para>
  <para style="iot">रूपरेखा:</para>
  <para style="io1">1. पतरस अपनो परिचय देथै और अपने पढ़न बारेन कै संबोधित करथै। <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. फिर बौ उनकै अच्छी जिंदगी जीन कै समकबाथै काहैकि परमेस्वर हमैं काबिल करी है। <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref></char></para>
  <para style="io1">3. जाके बाद बौ झूठे सिक्छकन के खिलाप चितौनी देथै और कहथै कि अंत मैं झूठे सिक्छकन को का होगो। <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref> </char></para>
  <para style="io1">4. बाके बाद पतरस विस्वासिन कै ईसु के दुबारा आन की तैयारी के ताहीं अच्छी जिंदगी जीन के ताहीं प्रोत्साहित करत भै खतम करथै। <char style="ior"><ref loc="2PE 3:1-17">3:1-17</ref> </char></para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>सिमौन पतरस के घाँईं से, जो ईसु मसीह के सेवक और प्रेरित है, बे लोगन के ताहीं जिनकै हमरे परमेस्वर और उद्धारकर्ता ईसु मसीह के न्याय के जरिया हमरे हानी एक कीमती बिस्वास दौ गौ है। <verse eid="2PE 1:1"/><verse number="2" style="v" sid="2PE 1:2"/>परमेस्वर और हमरे प्रभु ईसु के ग्यान के जरिया तुम्हैं अनुग्रह और सांति बहुतायत से बढ़त जाबै।<verse eid="2PE 1:2"/></para>
  <para style="s">परमेस्वर को बुलावा और चुननो</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>परमेस्वर की ईस्वरीय सामर्थ्य हमैं बौ सब कुछ दई है जोकी हमैं बाकई मैं धार्मिकता की जिंदगी जीन के ताहीं जरूरत होथै जौ जिंदगी हम बाके ग्यान के ताहीं जी सकथैं जो हमैं अपनी महिमा और अच्छाई मैं साझा करन के ताहीं बुलाई है। <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>जौ तरह से बौ आपन कै दै भै भौतै सानदार और कीमती तोफा वादा के तौर मैं दई, ताकी जे तोफा के जरिया से तुम नास करन बारी वासना से जो दुनिया मैं है बच सकौ, और बाके ईस्वरीय स्वभाव के सहभागी हुई सकौ। <verse eid="2PE 1:4"/><verse number="5" style="v" sid="2PE 1:5"/>जौ तरह से तुम अपनेई बिस्वास मैं अच्छाई जोड़न की पूरी कोसिस करौ; अपने अच्छाई मैं ग्यान जोड़ौ; <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>अपने ग्यान मैं संयम; संयम मैं धीरज जोड़ौ; अपनेई सहनसक्ति से ईस्वर भक्ति जोड़ौ; <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>अपने ईस्वर भक्ति मैं मसीह स्नेह जोड़ौ; और अपने मसीह स्नेह से प्रेम जोड़ौ। <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>जे बे गुन हैं जोकी तुम्हैं जरूरत है, और अगर तुम्हारे पास जाधे मैं है, तौ प्रभु ईसु मसीह हमरे ग्यान मैं तुम्हैं निकम्मो और निस्फल न होन देगो। <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>लेकिन जिनके झोने जे गुन नाय हैं बे इत्ते अंधरा हैं कि बे देख नाय सकथैं और भूल गै हैं कि उन्हैं उनके पिछले पापन से सुद्ध करो गौ है।<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>इसलै, मेरे भईय्यौ, परमेस्वर की बुलाहट और बाकै चुने जानकै सिद्ध करन की भली भाँति कोसिस करत जाबौ; अगर तुम ऐसो करथौ, तौ तुम कहु ठोकर ना खागे। <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>जौ तरह से तुम्हैं हमरे प्रभु और उद्धारकर्ता ईसु मसीह के अनंत राज्य मैं बड़ा आदर के संग घुसन को पूरो हक दौ जागो।<verse eid="2PE 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>और इसलै मैं तुमकै हमेसा जे मामलेन की याद दिबांगो, भलेई तुम उन्हैं पहले से ही जानत होबौ और तुमरे जरिये मिली भइ सच्चाई के ऊपर मजबूती से स्थिर होमैं। <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>मेरे बिचार मैं जबले जौ सरीर तुमरे बीच मैं जिंदी है, ऐसो करनो ठीक समझथौं कि जे बातन की याद दिलात भै तुमरी याद्‌दास कै उत्तेजित करत रहमौ। <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>मोए मालुम है मैं जल्दिये जौ नासवान सरीर कै छोड़ दुंगो, जैसो कि हमरो प्रभु ईसु मसीह साफ-साफ बताई रहै। <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>मैं ऐसी पूरी कोसिस भी करंगो कि मेरी मौत के बाद तुम कोई भी समय जे बातन कै याद कर सकौ।<verse eid="2PE 1:15"/></para>
  <para style="s">मसीह महिमा के चस्मदीद गभा</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>हम तुम्हैं हमरे प्रभु ईसु मसीह के सामर्थ्य से आन के बारे मैं बतान के ताहीं गढ़ी भइ कहानियाँ के भरोसे नाय हैं। खुद की आँखिन से बाकी महानता देखें हैं। <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>जब हम परमेस्वर दऊवा के जरिया उन्हैं आदर और महिमा दै, तौ हम हुँआँ रहैं, तौ परतापी महिमा से अबाज आई, “जौ मेरो प्रिय लौड़ा है, जासे मैं भौत खुस हौं!”<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MRK 9:7">मरकुस 9:7</ref></char></note> <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>हम खुद स्वर्ग से आनबारी जौ अबाज कै सुने, जब हम पवित्र पहाड़ मैं बाके संग रहैं।<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>तभई हम भविस्यवक्ता के जरिया ऐलान करे गै संदेस के बारे मैं जाधे आसस्वस्त हैं। अगर तुम बाकै ध्यान देथौ तौ अच्छी बात है, काहैकि जौ एक अंधियारो जघा मैं चमकन बारी दिया के तराहनी है जबले कि दिन नाय निकरथै और सुबेरे को तारा तुमरे दिल मैं नाय चमकथै। <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>हालाकि, सबन से ऊपर, जौ याद रखौ कि हमसे खुद कोई भी सास्त्र लेख समझाए नाय सकथै। <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>कोई भी सास्त्र मैं लिखो भौ संदेस सिरफ इंसानी इच्छा से नाय आओ रहै, लेकिन लोग पवित्र आत्मा के मार्ग दरसन के जरिये परमेस्वर के घाँईं से बोलत रहैं।<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s">झूठे सिक्छक</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>काहैकि लोगन के बीच झूठे भविस्यवक्ता उठ आए हैं जैसो कि अतीत मैं बताओ गौ रहै, और बहे तराहनी तुमरे बीच मैं झूठे उपदेसक दिखाई देंगे। बे विनासकारी, और गलत सिद्धांत कै लांगे, और बौ प्रभु कै जो उन्हैं मोल लई है इंकार करंगे, और जहेमारे बे खुदकै अनकाचीति बिनास मैं लांगे। <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>फिर भी, भौत से लोग उनके अनैतिक रस्ता के ऊपर चलंगे; और जोभी बे जो करथैं, उनके बजह दुसरे लोग सच्चाई के रस्ता की बुराई करंगे। <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>और लालच मैं जे झूठे गुरुजी तुमकै झूठ-मूठ की कहानियाँ बतायकै तुमसे फायदा उठांगे। भौत दिन से उनको न्याई मरगौ है, और उनको बिनास करन बारो पूरी तरह से जग्गौ है!<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>परमेस्वर पाप करन बारे स्वर्गदूतन कै भी नाय छोड़ी, और उन्हैं नरक मैं फेंक दई, जितै न्याय के दिन के ताहीं उन्हैं साँकरन से भाँदकै अंधियारे मैं रखो जाथै। <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>परमेस्वर पुरानी दुनिया कै नाय छोड़ी, लेकिन नास्तिक लोगन की दुनिया मैं सैलाब लाय दई; सिरफ नूह जो न्याय को बचन देत रहै, और बाके संग सात लोग रहैं। <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>परमेस्वर सदोम और अमोरा के सहरन कै दोसी करत भै, उन्हैं आगी से भसम कर दई, और उन्हैं एक उदाहरड़ बनाई कि जो बाकी आग्या कै ठुकरामंगे उनको का होगो। <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>जबकी बौ न्याई लूत कै बचाई, और बौ अधर्मियन के अनैतिक चाल-चलन से भौत दुखी रहै। <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>उनके बीच बौ एकै न्याई आदमी रहत रहै, और जब उनके अधर्म के कामन कै देखतो और सुनतो, तौ बौ हर दिन अपने धर्मी मन कै पीड़ित करत रहै। <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>और तभई प्रभु जानथै कि कैसे न्याई लोगन कै परेसानी से बचाओ जाबै और कैसे अधर्मियन कै सजा देन के ताहीं न्याय के दिन ले रखो जाए। <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>खासकर उन्हैं जो असुद्ध अभिलासा के पच्छू सरीर के अनुसार चलथैं, और परमेस्वर के अधिकार कै तुच्छ समझथैं। जे झूठे सिक्छक ढीट और अभिमानी होथैं और गौरवसाली इंसानन को आदर करन के बजाय उनकी बुराई करनो नाय छोड़थैं। <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>हिंयाँ तक कि स्वर्गदूत, जे झूठे सिक्छक की बराबरी मैं भौत मजबूत और सामर्थी हैं, उनकै प्रभु के अग्गु बुरो-भलो कहकै दोस नाय लगाबौ। <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>लेकिन जे लोग बेअकली जानवरन के हानी हैं, जो पकड़े जान और नास होन के ताहीं पैदा भै हैं; और जिन बातन कै जानतै ना हैं, उनके बारे मैं औरन की बुराई करथैं, बे अपनी सड़ाहट मैं खुदै सड़ जामंगे। <verse eid="2PE 2:12"/><verse number="13" style="v" sid="2PE 2:13"/>और उनके जरिये करे गै कस्टन के ताहीं उन्हैं दुख के संग भुगतान करो जागो। उनके ताहीं सुख-विलास की बात जौ है कि बे अधर्म के काम दिन के उजियारे मैं कुछ भी करथैं जो उनकी सारीरिक भूंक कै संतुस्ट करैगो; बे लज्जित और लज्जित होथैं, जब बे तेरे खानु मैं सामिल होथैं, तौ हर समय अपने अन्याय के काम मैं और छल-कपट मैं खुस होत रहथैं! <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>उनकी आँखी हमेसा व्यभिचार से भरी रहथैं; पाप के ताहीं उनकी भूंक कहुए नाय रुकथै। बे चंचल मन बारेन कै फुसलाए लेथैं। उनके मन लालची होन के ताहीं सीखे भै हैं। बे परमेस्वर के अभिस्राप के तहत हैं! <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>बे तौ सीधी रहा छोड़ दईं हैं और अपनी रहा हरबाए दईं हैं; जे बिओर के लौड़ा बिलाम के पच्छू-पच्छू चलत रहैं, जो बौ अधर्म से कमाए भै पैसन से प्रेम करी <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>और तभई बाके पाप के ताहीं फटकार लगाई गई रहै। तौ एक गधा के जरिया इंसानी अबाज निकरबाए कै बौ भविस्यवक्ता के पागलपन कै रोको गौ।<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>जे सूखे पानी के सोता, और आँधी मैं उड़ाए गै बादर के तराहनी हैं, जिनके ताहीं घोर अंधियारो ठहराओ गौ है। <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>बे घमंड और पागलन हानी बयान देथैं, और लुचपन जैसी चाल-चलन के जरिया बे लोगन कै सरीर की अभिलासा मैं फसाए लेथैं जो गलत लोगन की संगती से छुटकै निकर आए हैं। <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>जे उनकै आजाद करन को वादा देथैं जबकी खुद बिनास कारी आदतन के दास हैं, काहैकि इंसान जोसे हार जाथै, बहे को दास बन जाथै। <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>अगर जे हमरे उद्धारकर्ता प्रभु और ईसु मसीह के ग्यान के जरिया से दुनिया की असुद्ध ताकतन से बच गै हैं, और दुबारा से बहे रहामैं चल पड़े हैं तौ उनकी गत पहले से खराब हुई जागी। <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>न्याय के रस्ता कै जानन के बाद जो पवित्र आग्या दई गई बासे पलट जानो जासे जौ उनके ताहीं भौत अच्छो होतो कि बे कहु भी बौ न्याय के रहा कै नाय जानते। <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>उनके ऊपर जौ कहाबत सच है: “एक कुत्ता अपनी उल्टी खान कै लौट जाथै” और “हँदाई भइ सुअरनी कींच मैं लेहमन ताहीं लौट जाथै।”<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s">प्रभु के आन को वादा</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>मेरे प्रिय दोस्तौ, अब जौ दुसरी चिट्ठी तुमरे ताहीं लिखो हौं। दोनों चिट्ठी मैं जौ बातन की याद दिलात भै तुमरे मन मैं सुद्ध बिचार जगान की कोसिस करो हौं। <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>मैं चाहथौं कि तुम पवित्र भविस्यवक्ता के जरिया भौत पहले बोले गै सब्दन कै याद करौ, और उद्धारकर्ता प्रभु की बौ आग्या कै जो तुमरे प्रेरितन के जरिया दई गई रहै। <verse eid="2PE 3:2"/><verse number="3" style="v" sid="2PE 3:3"/>सबसे पहले, तुमकै जौ समझनो चाहिए कि आखरी दिनन मैं कुछ लोग दिखाई देंगे जिनकी जिंदगी उनकी अपनी वासना के जरिये काबू होथैं। बे तुमरो मजाक उड़ांगे <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>और कहमंगे, “जो बौ आन को वादा करी रहै, बौ कितै है? हमरे पुरखन की मौत हुई चुकी है, लेकिन दुनिया की सुरुवात के बाद से सब कुछ अभै भी बैसोई है!” <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>बे जान बूझकै जौ सच्चाई कै अनदेखो करथैं कि भौत पहले परमेस्वर एक आग्या दई रहै, और स्वर्ग और धरती बनाई रहै। जो धरती पानी मैं से बनी और पानी मैं टिकी है, <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>और जहे पानी के सैलाब मैं बदलकै बहे समय की दुनिया डूबकै खतम हुई गई। <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>लेकिन स्वर्ग और धरती जो अभै मौजूद है, इन्हैं आगी के जरिया खात्मा के ताहीं परमेस्वर की आग्या के जरिया समार कै रखौ जाएरौ है। उन्हैं बौ दिन के ताहीं रखो जाएरौ है जब प्रभु की आग्या ना मानन बारे लोगन को न्याय और बिनास करो जागो।<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>लेकिन एक बात मत भूलौ, मेरे प्रिय दोस्तौ! एक दिन और हजार साल के बीच प्रभु की नजर मैं कोई अंतर नाय है; बाके ताहीं सब एक जैसो है। <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>जैसो कि कुछ लोग सोचथैं, प्रभु अपने वादा कै पूरो करन मैं धीमो ना है। जाके अलावा, बौ तुमरे संग धीरज रखथै, काहैकि बौ ना चाहथै कि कोई खतम हुई जाबै, लेकिन सब अपने पापन से मन फिरानो चाहथैं।<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>लेकिन प्रभु बौ दिन चुट्टा के तराहनी आगो। बौ दिन स्वर्ग एक गरजन से गायब हुई जागो, और तत्व भौतै गरम हुईकै किम्हल जांगे, स्वर्गिय सरीर खतम हुई जागी, और सब कछु धरती के संग मैं गायब हुई जांगी। <verse eid="2PE 3:10"/><verse number="11" style="v" sid="2PE 3:11"/>जबकी जे चीज जौ तराहनी से खतम हुई जांगी, तौ तुम्हैं कैसो होनो चाहिए? तुमरी जिंदगी पवित्र और परमेस्वर कै सौंपी भइ होनी चाहिए, <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>जैसो कि तुम परमेस्वर के दिन को इंतजार करथौ और जाकै जल्दिये पूरो करन के ताहीं अपनी पूरी कोसिस करथौ, बौ दिन आसमान के तत्व गरम हुईकै जर जांगे और खतम हुई जागो, और स्वर्गिय सरीर घामो से पिघल जागी। <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>लेकिन हम इंतजार करथैं जोको परमेस्वर वादा करी है: नया स्वर्ग और एक नई धरती, जामैं न्याय बास करथै।<verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>और इसलै, मेरे प्रिय दोस्तौ, जब तुम बौ दिन कै असियात होगे, तौ परमेस्वर की नजर मैं सुद्ध और बेकसूर और बाके संग सांति से रहन की पूरी कोसिस करौ। <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>और हमरे प्रभु के धीरज कै उद्धार समझौ, जैसो कि हमरे प्रिय भईय्या पौलुस ग्यान के जरिया जो बाकै दियो गौ, तुम्हैं लिखी। <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>जब बौ जे सबन के बारे मैं लिखथै, तौ बौ खुद की सबै चिट्ठी मैं जहे कहथै। उनकी चिट्ठी मैं कुछ टेहड़ी बात हैं जो अग्यानी लोग गलत तरीका से समझाथैं, जैसो कि बे दुसरी पवित्र सास्त्रन के संग करथैं। तभई बे बिनास के घाँईं लै आथैं। <verse eid="2PE 3:16"/><verse number="17" style="v" sid="2PE 3:17"/>लेकिन तुम, मेरे प्रिय दोस्तौ, जौ सब पहलिये जानत भै तैयार रहाबौ। और चहाचीते रहबौ, ताकी तुम अधर्मी लोगन की गलतियन से बहकियो मत्ती और अपनी कुसल जघा से रपट ना जाबौ। <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>लेकिन हमरे प्रभु और उद्धारकर्ता ईसु मसीह के अनुग्रह और ग्यान मैं बढ़त जाबौ। और अब हमेसा बाकी महिमा हमेसा और हमेसा होत रहाबै! आमीन।<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
