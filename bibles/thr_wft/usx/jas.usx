<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Rana Tharu</book>
  <para style="toc3">याकूब</para>
  <para style="toc2">याकूब</para>
  <para style="toc1">याकूब की चिट्ठी</para>
  <para style="mt2">याकूब की चिट्ठी</para>
  <para style="mt1">याकूब की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">याकूब की किताब याकूब नाओं के कोई आदमी के जरिया लिखी गई रहै। जौ हुई सकथै: ईसु को भईय्या याकूब रहै, जो सुरु की कलीसिया मैं एक अगुवा रहै और यरूसलेम के परिसद को हिस्सा रहै <char style="xt"><ref loc="ACT 15:13">प्रेरितो 15:13</ref></char>। प्रेरित पौलुस बाकै <char style="xt"><ref loc="GAL 2:9">गलातियों 2:9</ref></char> मैं कलीसिया को खम्मा भी कही। विद्वानन को माननो है कि याकूब की किताब ईसु के जनम के लमसम 50 साल बाद लिखी गई रहै। काहैकि याकूब यरूसलेम की कलीसिया को अगुवा रहै, उनसे जाधेतर हुँआँ रहत भै किताब लिखी रहै। याकूब अपनी किताब कै “गैर यहूदियन मैं बिखरे भै बारह गोत्रन” कै संबोधित करथै <char style="xt"><ref loc="JAS 1:1">1:1</ref></char>। याकूब के पाठ सबै मसीहियन मैं लागू होथैं लेकिन “बारह गोत्रन” सब्दन के उपयोग से जौ संभव हुई जाथै कि याकूब सीधे यहूदि मसीहियन कै लिखरौ है। काहैकि जौ किताब पढ़न बारे के एक व्यापक समूह ले पहुँचन के ताहीं रहै, जौ तमान विसयन कै संबोधित करी। याकूब बिस्वास और कामन के बीच के संबंध के ऊपर ध्यान केंद्रित करथै। सच्चो बिस्वास कारवाई मैं दिखाओ जागो <char style="xt"><ref loc="JAS 2:17">2:17</ref></char>। बौ सेठ लोगन के प्रति पक्छपात ना दिखान की चितौनी भी देथै <char style="xt"><ref loc="JAS 2:1-4">2:1-4</ref></char>और कहथै कि हम जो कहथैं बासे चहाचीते रहमैं। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="iot">रूपरेखा:</para>
  <para style="io1">1. अपने पढ़न बारेन को अभिवादन करथै। <char style="ior"><ref loc="JAS 1:1">याकूब 1:1</ref></char></para>
  <para style="io1">2. जाके बाद बौ मसीहियन कै प्रोत्साहित करथै कि जब बे कस्ट सहमैं तौ दृढ़ बने रहमैं। <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref> </char></para>
  <para style="io1">3. फिर बौ कहथै कि करमन के जरिया बिस्वास को दिखाई देनो कैसे जरूरी है। <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref> </char></para>
  <para style="io1">4. जाके बाद बौ कहथै कि सब्द कितने सक्तिसाली हुई सकथैं। <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">5. तौ याकूब समझाथै कि कैसे परमेस्वर की बुद्धि दुनिया की बुद्धि से अलग है। <char style="ior"><ref loc="JAS 3:13-4:10">3:13–4:10</ref></char></para>
  <para style="io1">6. जाके बाद बौ अपने पढ़न बारेन कै घमंडी होन के खिलाप चितौनी देथै। <char style="ior"><ref loc="JAS 4:1-5:6">4:1–5:6</ref></char></para>
  <para style="io1">7. याकूब कुछ सामान्य निर्देस दैकै अपनी किताब कै खतम करथै। <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>परमेस्वर और प्रभु ईसु मसीह के सेवक याकूब के घाँईं से परमेस्वर के लोगन कै जो पूरी दुनिया मैं फैले भै हैं उनकै नमस्ते।<verse eid="JAS 1:1"/></para>
  <para style="s">बिस्वास और बुद्धि</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>मेरे भईय्यौ, जब तुम अलग-अलग परिक्छा मैं पड़ौ तौ जाकै भौत खुसी कि बात समझौ, <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>जौ जानकै कि तुमरे बिस्वास के परखे जान से तुमरो बिस्वास पैदा होथै, तौ नतीजा स्वरूप तुमकै सहन की छमता मिलथै। <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>सुनिस्चित करैं कि तुमरो धीरज बिना कोई असफलता के तुमकै हर तरह से आखरी ले लै जाथै, ताकी तुम सिद्ध और पूरे हुई जाबौ और तुम मैं कोई बात की कमी ना रहबै। <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>लेकिन अगर तुम मैं से कोई कै बुद्धि कि कमी होबै तौ परमेस्वर से प्रार्थना करै, तौ बौ तुमकै देगो; काहैकि परमेस्वर सबन कै उदारता और प्रेम से देथै। <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>लेकिन जब तुम प्रार्थना करथौ, तौ तुमकै बिस्वास करनो चाहिए, और कछु संका ना करनो चाहिए। जो कोई भी संका करथै बौ समुंदर कि लहर के हानी होथै जो ब्यार के जरिये चलथै और उड़ाइ जाथै। <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>अगर तुम ऐसे हौ तौ तुम ऐसो मत समझौ, कि मोकै प्रभु से कछु मिलैगो। <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>ऐसे लोग, अपने मन कै बनान मैं असमर्थ्य हैं, और अपनी सब बातन मैं चंचल हैं।<verse eid="JAS 1:8"/></para>
  <para style="s">गरीबी और अमीरी</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>जो मसीह गरीब भईय्या हैं जब परमेस्वर उनकै अच्छी दसा मैं उठाथै, तौ उनकै खुसी होनो चाहिए, <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>और सेठ मसीहियन कै खुसी होनी चाहिए जब परमेस्वर उनकै निचली दसा मैं लाथै। काहैकि सेठ जंगली घाँस के फूल के हानी गुजर जाबैगो। <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>सूरज अपने धधकत भौ घामो के संग निकरथै और घाँस कै जलाए देथै; बाको फूला गिर जाथै, और बाको सुगड़पन खतम हुई जाथै। बैसिये सेठ तभा ही जांगे जबकी बे अपने काम के बारे मैं जानंगे।<verse eid="JAS 1:11"/></para>
  <para style="s">परिक्छा और लालच</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>धन्य हैं बे जो परिक्छन ले वफादार रहथैं, काहैकि जब बे ऐसी परिक्छा पास करन मैं कामयाब होथैं, तौ बे अपने इनाम मतलब जिंदगी के मुकुट कै पांगे जो कि परमेस्वर अपने प्रेम करन बारेन से वादा करी है। <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>जब कोई कि परिक्छा होबै, तौ बौ जौ ना कहबै, कि मेरी परिक्छा परमेस्वर के घाँईं से ही रइ है; काहैकि ना तौ बुरी बातन से परमेस्वर मोह रखथै, और ना बौ खुद कोई कि परिक्छा लेथै। <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>लेकिन हर आदमी अपनी अभिलासा मैं खिंचकै, और फसकै परिक्छा मैं पड़थै। <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>फिर अभिलासा पेट से हुईकै पाप कै पैदा करथै और पाप बढ़थै तौ मौत कै पैदा करथै। <verse eid="JAS 1:15"/><verse number="16" style="v" sid="JAS 1:16"/>हे मेरे प्रिय भईय्यौ, और बहेनियौ धोका मत खाबौ। <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>हर एक अच्छो और सई दान ऊपर सेई है, और जोतिन के दऊवा के घाँईं से मिलथै, जोमैं नाय तौ कछु बदलो जाए सकथै, अदल-बदल की बजह से जोमैं ना तौ कोई बदलाव आथै और ना कोई छाईं पड़थै। <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>बौ अपनी ही इच्छा से हमकै सच्चे बचन से पैदा करी, ताकी हम बाकी बनाई भइ चीजन मैं से एक पहले फल होमैं।<verse eid="JAS 1:18"/></para>
  <para style="s">सुननो और करनो</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>हे मेरे प्रिय भईय्यौ! जौ बात तुम जानलेबौ, हर एक आदमी सुनन के ताहीं तैयार, बोलन मैं और गुस्सा मैं धीमो होबै। <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>इंसान के गुस्सा से बौ धार्मिकता की जिंदगी जो परमेस्वर चाहथै बौ दिखाई ना दै सकथै। <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>इसलै हर गंदी आदत और सब दुस्ट व्यवहार से छुटकारा पाएकै परमेस्वर कै सौंपौ और बौ बचन कै स्वीकार करौ जो बौ तुमरे मन मैं रोपथै, जो तुमकै बचान मैं काबिल है। <verse eid="JAS 1:21"/><verse number="22" style="v" sid="JAS 1:22"/>लेकिन बचन मैं चलन बारे बनौ, खाली सुनन बारे नाय जो अपनिए आपकै धोका देथैं। <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>काहैकि जो बचन कै सुनन बारो होबै, बामै चलन बारो नाय, तौ बौ बौ आदमी के हानी है जो अपनो मोहों दरपन मैं देखथै। <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>काहैकि बौ अपने आपकै देखकै चलो जाथै, और तुरंत भूल जाथै कि बौ कैसो रहै। <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>पर अगर तुम बौ सिद्ध नियम कै ध्यान से देखैगे जो लोगन कै आजाद करथै, और बाके ऊपर ध्यान देत रहथौ और ना खाली सुनथौ और फिर जाकै भूल जाथौ, बल्कि जाकै व्यवहार मैं लाथौ, तौ तुम जो करथौ बामै धन्य हुईकै परमेस्वर को आर्सिवाद पाबैगे। <verse eid="JAS 1:25"/><verse number="26" style="v" sid="JAS 1:26"/>अगर कोई अपने आपकै धर्मी समझै, और अपनी जीभ मैं लगाम नाय लगाबै, पर अपने दिल कै धोका देबै, तौ बाको धर्म बेकार है। <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>हमरे परमेस्वर और दऊवा के झोने पवित्र और निरमल धर्म जौ है, कि अनाथन और बिधवन के कलेस मैं उनकै याद करै, अपने आपकै दुनिया से निर्दोस रखाबै।<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s">पक्छपात को पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>भईय्यौ, और बहेनियौ हमरे महिमायुक्त प्रभु ईसु मसीह को बिस्वास तुम मैं भेद-भाव के संग नाय होबै। <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>काहैकि एक आदमी सोने की अंगूठी और सुगड़ लत्ता पहने भै तुमरी सभा मैं आबै और एक कंगाल भी मैले कुचैले लत्ता पहने भै आबै। <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>तुम बौ सुगड़ लत्ता पहने भै आदमी कै जाधे मान दैकै कहबौ, “तू हिंयाँ अच्छी जघा बैठ,” और बौ कंगाल से कहबौ, “तू हुँआँ खड़ो रहे,” या “मेरी टाँग के झोने फर्स मैं बैठ,” <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>तौ का तुम आपस मैं संका नाय करे और बुरे बिचार से न्याय करन बारे ना बने। <verse eid="JAS 2:4"/><verse number="5" style="v" sid="JAS 2:5"/>सुनौ, मेरे प्रिय भईय्यौ और बहेनियौ! का परमेस्वर जौ दुनिया के कंगालन कै नाय चुनी कि बे बिस्वास मैं सेठ और राज्य के अधिकारी होमैं जोकी बौ उनसे वादा करी है जो बासे प्रेम करथैं। <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>पर तुम बौ कंगाल को अपमान करे! का सेठ आदमी तुम्मैं अत्याचार नाय करथैं! और का बे तुमकै पंचायतन मैं घसीट-घसीट कै नाय लै जाथैं? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>का बे बौ उत्तम नाओं कि बुराई नाय करथैं जो तुमकै दौ गौ है।<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>तुम सई काम करत होगे अगर तुम राज्य के नियमन को पालन करथौ, जो सास्त्र मैं पाओ जाथै, “अपने पड़ोसी से प्रेम करौ जैसे तुम अपने आप से प्रेम करथौ।” <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>पर अगर तुम पक्छपात करथौ, तौ पाप करथौ, और नियम तुमकै अपराधी ठहराथै। <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>काहैकि जो कोई सबै नियम को पालन करथै लेकिन एक नियम मैं चूक जाबै तौ बौ सब बातन मैं दोसी ठहरो। <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>काहैकि जो जौ कहो, “तू व्यभिचार मत करिये,” बहे जौ भी कही, “तू हत्या मत करिये।” काहैकि तू व्यभिचार तौ नाय करो, लेकिन हत्या करो तौभी तू नियम कै नाय मानन बारो ठहरो। <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>तुम बे आदमिन के हानी बचन बोलौ, और काम भी करौ जिनको फैसला आजादी के नियम के हानी होगो। <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>काहैकि जो दया नाय करो, बाको न्याय बेरहमी से होगो; दया फैसला के ऊपर बिजय पाथै।<verse eid="JAS 2:13"/></para>
  <para style="s">बिस्वास और काम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>मेरे भईय्यौ, तुम मैं से एक के ताहीं जौ कहन को का फायदा है कि अगर तुमरे काम से जौ साबित ना होथै तौ तुमरो बिस्वास है? का बौ बिस्वास तुमकै बचाए सकथै? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>अगर कोई भईय्या और बहेनिया हैं जिनकै लत्ता कि जरूरत है, और उनकै रोजाना खान कि कमी होबै। <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>तुम मैं से कोई उनसे कहबै, “सांति से जाबौ, तुम गरम रहबौ और भरे-पूरे रहबौ!” लेकिन जो चीज सरीर के ताहीं जरूरी है बौ उनकै नाय देमैं, तौ का फायदा? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>बैसिये बिस्वास भी: अगर काम के संग नाय होबै तौ अपने मैं मरो भौ है। <verse eid="JAS 2:17"/><verse number="18" style="v" sid="JAS 2:18"/>लेकिन कोई कह सकथै, “तोकै बिस्वास है, और मैं काम करथौं। तू अपनो बिस्वास मोकै काम बिना तौ दिखा। और मैं अपनो बिस्वास अपने कामन से तोकै दिखामंगो।” <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>तोकै बिस्वास है कि एकै परमेस्वर है? तू अच्छो करथै! प्रेत आत्मा भी बिस्वास रखथैं, और थरथराथैं। <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>लेकिन निकम्मे आदमी का तू जौ भी नाय जानथै! कि काम बिना बिस्वास खाली बेकार है? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>जब हमरो दऊवा अब्राहम अपने लौड़ा इसहाक कै बेदी मैं चढ़ाई, तौ का बौ कामन से न्याई नाय ठहरो रहै? <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>तू देख लौ कि बिस्वास बाके कामन के संग मिलकै असर डारी है? और बाके कामन से बाको बिस्वास सिद्ध होगो। <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>और सास्त्र को बौ बचन पूरो भौ, “अब्राहम परमेस्वर मैं बिस्वास करी, और जौ बाके ताहीं धार्मिकता मैं गिनो गौ।” और बौ परमेस्वर को दोस्त कहलाओ गौ। <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>तू देख लौ कि आदमी सिरफ बिस्वास सेई नाय, लेकिन कामन से भी न्याई ठहरथै। <verse eid="JAS 2:24"/><verse number="25" style="v" sid="JAS 2:25"/>बैसिये राहाब वेस्या भी जब बौ दूतन कै अपने घर मैं उतारी, और दूसरे रस्ता से भेज दई, तौ का कामन से न्याई नाय ठहरी। <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>जैसे सरीर आत्मा बिना मरो भौ है, बैसिये बिस्वास भी काम बिना मरो भौ है।<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s">जीभ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>मेरे भईय्यौ और बहेनियौ, तुम मैं से बड़ा जोड़ उपदेसक नाय बनै। काहैकि तुम जानथौ, कि आपन उपदेसकन को फैसला और भी सख्ती से होबैगो। <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>काहैकि आपन बड़ा जोड़ बार चूक जाथैं जो कोई बचन मैं नाय चूकथै, बहे तौ सिद्ध आदमी है; और पूरे सरीर मैं भी लगाम लगाए सकथै। <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>जब आपन अपने वस मैं करन के ताहीं घोड़न के मोहों मैं लगाम लगाथैं, तौ आपन बाकै पूरे भरोसा से बाके सरीर कै भी फेर सकथैं। <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>देखौ, जहाज भी, कितने बड़े होथैं, और तेज ब्यार से चलाय जाथैं, तौभी एक छोटी सी पतवार से माँझी कि इच्छा से घुमाए जाथैं। <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>बैसिये जीभ भी छोटो सो अंग है और बड़ी-बड़ी डींग मारथै; देखो कैसे, थोड़ी सी आगी से कितने बड़े-बड़े बन मैं आगी लग जाथै। <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>जीभ एक आगी है; जीभ हमरे अंगन मैं एक अधर्म की एक दुनिया है और पूरे सरीर मैं कलंक लगाथै, और भवचक्र मैं आगी लगाए देथै और नरक कुंड की आगी से जलत रहथै। <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>काहैकि सब हानी के बन-पसु, पक्छी, और नेंगन बारे जानवर और जलचर तौ आदमी जाति के वस मैं हुई सकथैं और हुई भी गै हैं। <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>लेकिन जीभ कै आदमी मैं से कोई वस मैं नाय कर सकथै; बौ एक ऐसी बला है जो कभी रुकतै नाय; बौ नासवान विस से भरी पड़ी है। <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>जहे से हम प्रभु और दऊवा को धन्यवाद देन ताहीं करथैं और जहे से दुसरे लोगन कै आसीस की जघा स्राप देन के ताहीं करथैं, जो परमेस्वर के तराहनी बनाये गै हैं। <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>एकै मोहों से आर्सिवाद और स्राप दोनों निकरथैं। मेरे भईय्यौ और बहेनियौ, ऐसो नाय होनो चाहिए। <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>का सोता के एकै मोहों से मीठो और खारो दोनों पानी निकरथैं? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>मेरे भईय्यौ और बहेनियौ, का अंजीर के पेंड़ मैं जैतून, या दाखलता मैं अंजीर लग सकथैं? बैसिये खारे सोता से मीठो पानी नाय निकर सकथै।<figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="3:3">घोड़ा मैं बैठो भौ</figure><verse eid="JAS 3:12"/></para>
  <para style="s">ऊपर से बुद्धि</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>तुम्मैं ग्यानवान और समझदार कौन है? जो ऐसो होबै बौ अपने कामन कै अच्छे चाल-चलन से भोलो हुईकै दिखाबै जो ग्यान से पैदा होथैं। <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>लेकिन तुम अपने-अपने दिल मैं जलन और लालच रखथौ, तौ डींग मत मारियो और ना सच कै नकारौ। <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>जौ ग्यान बौ नाय, जो ऊपर से उतरथै लेकिन सांसारिक, सारीरिक, और सैतानी है। <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>काहैकि जहाँ पर जलन और बिरोध होथै, हुँआँ बखेड़ा और हर तरहन को दुस्करम भी होथै। <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>पर जो बुद्धि ऊपर से आथै बौ सबसे पहले सुद्ध होथै; फिर मिलनसार, कोमल, और मीठो स्वभाव और दया, और अच्छे फलन से लदे भै और पक्छपात और कपटरहित होथै। <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>और मिलाप करन बारे जो बीज सांति से बोथैं बे धार्मिकता की फसल पाथैं।<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s">दुनिया से दोस्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>तुम्मैं लड़ाई और झगड़ा कहाँ से आथैं? का बे सुख विलासन से नाय जो तुमरे आँगन मैं लड़थै-भिड़थै? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>तुम लालसा रखथौ, और तुमकै मिलत नाय है; तुम हत्या और डाह करथौ, कछु पाए नाय सकथौ; तुम झगड़थौ और लड़थौ; तुमकै जहे बजह से नाय मिलथै कि तुम मांगत नाय हौ। <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>तुम मांगत हौ और पात नाय हौ, काहैकि बुरी इच्छा से मांगत हौ, ताकी अपने भोग विलास मैं उड़ाए देबौ। <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>हे व्यभिचारियौ का तुम नाय जानथौ, कि दुनिया से दोस्ती करनो परमेस्वर से बैर करनो है? काहैकि जो कोई दुनिया से दोस्ती करनो चाहथै, बौ अपने आपकै परमेस्वर को बैरी बनाथै। <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ऐसो मत सोचौ कि सास्त्र मैं कोई सच्चाई ना है जो कहथै, “परमेस्वर हममैं जो आत्मा रखी है बौ भैंकर इच्छाओं से भरी है।” <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>लेकिन परमेस्वर जो अनुग्रह देथै बौ और भी जाधे सक्तिसाली होथै। जौ बजह से सास्त्र कहथै, “परमेस्वर अभिमान करन बारे से बिरोध करथै, लेकिन भोले के ऊपर अनुग्रह करथै।” <verse eid="JAS 4:6"/><verse number="7" style="v" sid="JAS 4:7"/>काहैकि परमेस्वर के अधीन हुई जाबौ; और सैतान को सामना करौ, तौ बौ तुमरे झोने से भाज जागो। <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>परमेस्वर के झोने आबौ, तौ बौ भी तुमरे झोने आगो: हे पापियौ, अपने हात सुद्ध करौ; और हे दुई चित्तेयौ अपने दिल कै पवित्र करौ। <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>दुखी होबौ, और सोक करौ, और रोबौ, तुमरी हँसी सोक मैं और तुमरी खुसी उदासी मैं बदल जाबै। <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>प्रभु के सामने भोले बनौ, तौ बौ तुमकै सिरोमड़ीं बनागो। <verse eid="JAS 4:10"/><verse number="11" style="v" sid="JAS 4:11"/>हे भईय्यौ और बहेनियौ, एक दुसरे कि बुराई मत करौ, जो अपने भईय्या कि बुराई करथै, या दोस लगाथै, बौ नियम कि बुराई करथै, और नियम मैं दोस लगाथै, तौ तू नियम मैं चलन बारो नाय, लेकिन न्यायधीस ठहरो। <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>नियम देन बारो और न्यायधीस तौ एकै है, जोकै बचान की और मारन की सामर्थ्य है पर तू कौन है, जो अपने पड़ोसी के ऊपर दोस लगाथै? <verse eid="JAS 4:12"/><verse number="13" style="v" sid="JAS 4:13"/>तुम जो जौ कहथौ, “आज या कल हम कोई और नगर मैं जाएकै हुँआँ एक साल बितामंगे, और ब्यापार करकै पैसा कमांगे।” <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>और जौ नाय जानथौ कि कल को होगो सुन तौ लेबौ, तुमरी जिंदगी हईये का? तुम तौ मानौ धुंध के हानी हौ, जो थोड़ी देर दिखाई देथै, फिर लोप हुई जाथै। <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>जाके बदले तुमकै कहनो चाहिए, “अगर प्रभु चाही तौ हम जिंदे रहमंगे, और जौ या बौ काम भी करंगे।” <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>पर अब तुम अपनी डींग मारन मैं घमंड करथौ; ऐसो सबै घमंड बुरो होथै। <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>तौ फिर, अगर हम बौ अच्छो ना करते जो हम जानथैं कि हमैं करनो चाहिए, तौ हम पाप के दोसी हैं।<figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="4:13">खरीदन और बेचन बारे अपने सामान के संग</figure><verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s">सेठन कै चितौनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>हे सेठौ सुन तौ लेबौ; तुम अपने आनबारे कलेसन के बजह से चिल्लाए-चिल्लाए कै रोबौ। <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>तुमरो धन बिगड़ गौ और तुमरे लत्तन कै कीरा खाए गै। <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>तुमरे सोने-चाँदी मैं काई लग गई है; और बौ तुमरे खिलाप गभाई देगी, और आगी के हानी तुमरो सरीर को मास खाए जागी: तुम तौ आखरी युग मैं धन बटोरे हौ। <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>देखौ, जो मजदूर तुमरे खेत कै काटी रहैं, उनकी मजदूरी जो तुम उनकै नाय दै; चिल्लाए रइ है, और लेन बारेन कि अपील, सेनाओं के प्रभु के झोने पौहौंच गई है। <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>तुम धरती मैं भोग-विलास मैं लगे रहे और बड़ा सुख भोगे; तुम जौ वध के दिन के ताहीं अपने दिल कै पाल-पलोस कै मोटो ताजो करे। <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>तुम धर्मी लोगन की बुराई और उनकै मार डारे हौ, और बे तुमरो बिरोध नाय करथैं।<verse eid="JAS 5:6"/></para>
  <para style="s">धीरज और प्रार्थना</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>काहैकि हे भईय्यौ और बहेनियौ, प्रभु के आन तक धीरज धरौ, जैसे, किसान जमीन के अच्छे फल कि आसा रखत भै पहलो और आखरी मेंहें बरसन के इंतजार मैं धीरज धरे रहथै। <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>तुम भी धीरज धरौ, और अपने दिल कै मजबूत करौ, को है कि प्रभु जल्दिये आनबारो है। <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>हे भईय्यौ एक दुसरे के ऊपर दोस मत लगाबौ ताकी तुम दोसी नाय ठहरौ, देखौ, न्यायधीस फाटक मैं खड़ो है। <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>हे भईय्यौ जो भविस्यवक्ता प्रभु के नाओं से बात करीं रहैं, उनकै दुख उठान को और धीरज धरन को आदर्स समझौ। <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>देखौ, हम धीरज धरन बारेन कै धन्य कहथैं। तुम अय्यूब के धीरज धरन के बारे मैं तौ सुनेई हौ, और प्रभु के घाँईं से जो बाकै फल मिलो बाकै भी जान लै हौ, जोसे प्रभु कि बड़ी करुना और दया दिखाई देथै। <verse eid="JAS 5:11"/><verse number="12" style="v" sid="JAS 5:12"/>पर हे मेरे भईय्यौ, सबसे बड़ी बात जौ है, कि कसम मत खईयो; ना स्वर्ग कि ना धरती कि, ना कोई और चीज कि, पर तुमरी बात हाँ कि हाँ और ना कि ना होबै, ताकी तुम सजा के लायक नाय ठहरौ। <verse eid="JAS 5:12"/><verse number="13" style="v" sid="JAS 5:13"/>अगर तुम्मैं कोई दुखी होबै तौ बौ प्रार्थना करै; अगर खुस होबै तौ, बौ स्तुति के गाना गाबै। <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>अगर कोई तुम्मैं रोगी है तौ कलीसिया के बड़े-बूढ़ेन कै बुलबाबौ, और बे प्रभु के नाओं से बाकै जैतून को तेल लगाएकै बाको अभिसेक करकै बाके ताहीं प्रार्थना करैं। <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>और बिस्वास कि प्रार्थना से रोगी बच जागो और प्रभु बाकै ठड़बाए देगो; अगर बौ पाप भी करी होगो तौ, परमेस्वर बाकै माफ कर देगो। <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>काहैकि तुम्हऊँ एक दुसरे के सामने अपने-अपने पापन कै मान लेबौ; और एक दुसरे के ताहीं प्रार्थना करौ, जोसे चंगे ही जाबौ; न्याई आदमी कि प्रार्थना को एक सक्तिसाली प्रभाव होथै। <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>एलिय्याह भी तौ हमारिये हानी दुख-सुख भोगी आदमी रहै; और बौ गिड़गिड़ाए कै प्रार्थना करी, कि मेंहें नाय बरसै; और साढ़े तीन साल तक धरती मैं मेंहें नाय बरसो। <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>फिर बौ प्रार्थना करी, तौ आसमान से मेंहें बरसो, और धरती फिर से हरी-भरी और फरन लगी। <verse eid="JAS 5:18"/><verse number="19" style="v" sid="JAS 5:19"/>हे मेरे भईय्यौ, अगर तुम्मैं से कोई अगर सच्चाई के रस्ता से भटक जाबै, और कोई बाकै लौटार लाबै। <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>तौ बौ जान लेबै, कि जो कोई बौ भटके भै पापी कै मन से लौटार लागो, बौ एक पापी की आत्मा कै मौत से बचागो और निरे पापन मैं माफ लागो।<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
