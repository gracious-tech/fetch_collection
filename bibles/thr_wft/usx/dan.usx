<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Rana Tharu</book>
  <para style="h">दानिय्येल</para>
  <para style="toc3">दानिय्येल</para>
  <para style="toc2">दानिय्येल</para>
  <para style="toc1">दानिय्येल की किताब</para>
  <para style="mt2">दानिय्येल की किताब</para>
  <para style="mt1">दानिय्येल</para>
  <para style="ip">प्रस्तुत ग्रंथ दानिय्येल नबी के जरिये लिखी गई। नबी दानिय्येल कसदी राजन और बेलसस्सर और मादी राजा दारा और फारसी राजा कुस्रू के सासन काल मैं रहो और नबूवत की।</para>
  <para style="ip">नबी के रूप मैं दानिय्येल को महत्व खुद प्रभु ईसु मत्ती 24:15 मैं प्रकट करी है।</para>
  <para style="ip">दानिय्येल नाओं को मतलब है “परमेस्वर मेरो न्यायी है।” प्रभु परमेस्वर के ऊपर विस्वास और भक्ति बाके जीवन की सच्चाई कै स्पस्ट से प्रस्तुत करथै।</para>
  <para style="ip">जौ ग्रंथ कि विसय-वस्तु कै हम दुई मुख्य खंडन मैं बाँट सकथैं।</para>
  <para style="ip">
    <char style="bd">1. दानिय्येल </char> और बाके संग के साथी-दिलबरन से संबंधित घटना। जे परमेस्वर के ऊपर अटूट विस्वास करथैं, और बाके प्रति आग्याकारी बने रहथैं। अपने विस्वास और आग्याकारिता से जे अपने विरोधियन कै हराथैं। जे घरना बेबीलोनी और मादी-फारसी साम्राज्य-काल मैं घटी रहैं।</para>
  <para style="ip">
    <char style="bd">2. दानिय्येल कै मिले दर्सन। </char> दानिय्येल कै मिले जे दर्सन एक के बाद एक होनबारे साम्राज्यन के उत्थान और पतन की घटना की भविस्यवाड़ी करथैं। दर्सनन मैं बताओ गौ है कि साम्राज्यन को पतन होगो, और बाके संग अत्याचारी सासन को भी। आखरी मैं परमेस्वर के भक्त लोगन कै राजसत्ता फिर से मिल जागी।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">दानिय्येल और बाके दिलबरन की कहानी <char style="ior"><ref loc="DAN 1:1-6:28">1:1–6:28</ref></char></para>
  <para style="io1">दानिय्येल के दर्सन <char style="ior"><ref loc="DAN 7:1-12:13">7:1–12:13</ref> </char></para>
  <para style="io2">क. चार बड़े जानवर <char style="ior"><ref loc="DAN 7:1-28">7:1-28</ref> </char></para>
  <para style="io2">ख. मेड़ा और बकरा <char style="ior"><ref loc="DAN 8:1-9:27">8:1–9:27</ref> </char></para>
  <para style="io2">ग. दिव्य आदमी के दर्सन <char style="ior"><ref loc="DAN 10:1-11:45">10:1–11:45</ref></char></para>
  <para style="io2">घ. युगांत कब होगो <char style="ior"><ref loc="DAN 12:1-13">12:1-13</ref> </char></para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">बेबीलोन को दानिय्येल और बाके दोस्त की कहानी</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />यहूदा को राजा यहोयाकीम के देस के तीसरे साल मैं बेबीलोन के राजा नबूकदनेस्सर ने यरूसलेम मैं लड़ाई करी और गाओं कै घेर लईं। <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />तभई प्रभु यहूदा के राजा यहोयाकीम जो बाके ऊपर विजय दई, मंदिर को खजानन बाके हाथ मैं दै दई। बौ कुछ आदमिन कै अपने संग बेबीलोन के सिनार देस मैं अपने देवतन के मंदिर मैं लैगौ, और पकड़े गै खजाना कै परमेस्वर के मंदिर के भंडार घर मैं रख दई। <verse eid="DAN 1:2" /><verse number="3" style="v" sid="DAN 1:3" />तभई राजा अपने ईमानदार अधिकारी असपनज कै आदेस दई कि बौ इस्राएलियन मैं से साही परिवार और नामी खास परिवारन कै कुछ आदमिन कै बंधुवाई मैं से चुनै। <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />बे अच्छे, बुध्दिमान, अच्छी तराह से समझदार और ग्यान सीखन मैं तेज और सरीर से ताकतवर और अच्छे होने चाहिए, और उनकै कसदी जाति को साहित्य और भासा सिखा ताकी बे राजा के साही परिवार के घर मैं सेवा करन के ताहीं काबिल हुई सकैं। असपनज उनकै बेबीलोनियन भासा पढ़नो और लिखनो सिखाथै। <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />राजा जौ भी आदेस दई कि हर दिन बे अच्छे घर के लोगन के अग्गु खानू और दाखमधु दौ जाबै। ऐसे करकै उनको तीन साल ले पालन-पोसँड़ होत रहेगो और बाके बाद बे राजा के अग्गु हाजिर करे जांगे। <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />चुने गै लोगन कै दानिय्येल, हनन्याह, मीसाएल और अजर्याह रहैं जो सब यहूदा के वंस से रहैं। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />खास अधिकारी उनकै नया नाओं दई:</para>
  <para style="p" vid="DAN 1:7">दानिय्येल को बेलतसस्सर, और हनन्याह को सद्रक, मीसाएल को मेसक और अजर्याह को अबेदनगो ऐसो नाओं रखी। <verse eid="DAN 1:7" /><verse number="8" style="v" sid="DAN 1:8" />दानिय्येल अपने मन मैं तै करी कि बौ राजदरबार को खानू खाएकै और दाखमधु पीकै अपने आपकै असुद्ध नाय करैगो,</para>
  <para style="p" vid="DAN 1:8">तौ बे असपनज से बाकी मदद करन कै कही। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />और परमेस्वर असपनज राजा कै दानिय्येल के ताहीं अनुग्रह और सहानुभूति से बाकै भर दई। <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />जैसे असपनज राजा से डराथैं, तौ बे दानिय्येल से कहीं “राजा तौ से कह दई है कि तुमकै का खाने और पीने है, और अगर तुम दूसरे आदमिन के जैसी अच्छे ना दिखाने, तौ बौ मोकै मार सकथै।”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />बाके बाद असपनज, दानिय्येल, हनन्याह, मीसाएल और अजर्याह जे सब अधिपतियन की देखरेख करन के ताहीं चुनो गौ रहै, दानिय्येल बासे कहथै। <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“मैं नौहरे करथौं कि दस दिन ले हमरी निगरानी करौ।” बे कहीं “हमैं खान के ताहीं साग-सब्जी और पीन के ताहीं पानी दौ जाबै। <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />फिर हमरी तुलना बे नये जुआन से करीं जो राजदरबार को खानू खाथैं, और हम कैसे दिखाथैं बाके बाद फैसला करैं।”<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />बौ उनकी जौ विनती मान लई, और दस दिन ले उनकै जाँचत रहो। <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />जब दिन खतम भौ, तौ बे सब लोगन की तुलना मैं जो राजदरबार को खानू खात रहैं उनसे हट्टे-कट्टे और मजबूत दिखात रहैं। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />तौ बौ अधिकारी उनको खानू और पीन के ताहीं ठहराओ भौ पानी, दाखमधु की जघा मैं साग-पात देन लगे।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />प्रभु के चारौ आदमिन को समूह और दर्सन मैं ग्यान और बुध्दि दई। जाके अलावा, बौ दानिय्येल कै दर्सन और सपनो की ब्याख्या करन मैं ग्यान दई।<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />राजा के निर्धारित तीन साल के बाद, असपनज बे सब अधिकारी लोगन कै नबूकदनेस्सर के झोने लैगौ। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राजा उन सब से बात करी और दानिय्येल, हनन्याह, मीसाएल और अजर्याह के जे सब दूसरे सब की तुलना मैं जे भौत प्रभावित करीं। फिर बे राजा के दरबार के सदस्य बन गै। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />राजा कोई भी सबाल पूँछी होबै या कोई भी नुकसान उठाई होबै, जे चारौ बाके सब देस मैं कोई भी ज्योतिसी या जादूगर से बुध्दि मैं दस गुना जाधे जानथैं। <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />दानिय्येल राजसाही दरबार मैं तब तक रहौ जब तक फारस के सम्राट कुस्रू और बेबीलोन मैं जीत नाय प्राप्त कर पाई।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबूकदनेस्सर को सपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />नबूकदनेस्सर राजा अपने राज्यकाल के दूसरे साल मैं बौ एक सपनो देखी। जौ उनकै इत्तो चिंता मैं कर दई कि बौ सोए नाय पाई, <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />बौ अपने ज्योतिसी, जादूगरन, और ओझाओं और कसदी के लोगन कै बुलाई कि बे आ मैं और बाकै सपनो को मतलब समझा मैं। जब बे आएकै राजा के अग्गू खड़े भै, <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />तभई राजा उनसे कहथै, “मैं अपने एक सपनो के काम से परेसान हौं। मैं जाननो चाहथौं की जाको का मतलब है।” <verse eid="DAN 2:3" /><verse number="4" style="v" sid="DAN 2:4" />बे राजा कै अरामी भासा मैं जबाब दईं, “महामहिम हमेसा जिन्दो रहबै! हमैं अपनो सपनो बता, हम तोकै बाको मतलब समझाए देंगे।” <verse eid="DAN 2:4" /><verse number="5" style="v" sid="DAN 2:5" />राजा उनसे कही, मैं पक्को कर लौ हौं कि तुम मोकै सपनो बतागे और फिर बाको मतलब भी बतागे। अगर तुम बाको मतलब नाय बताए पागे, तौ मैं तुमरे टुकड़ा-टुकड़ा कर दुंगो और तुमरे घरन कै खंडरन को ढेर बनाए दुंगो। <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />फिर अगर तुम मोकै सपनो और बाको मतलब बताए सकौ, तौ मैं तुमकै ईनाम मैं उपहार और बड़ा आदर-सम्मान दुंगो। तौ अब मोकै बताबौ कि सपनो का रहै और जाको मतलब का है।<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />बे फिर जबाब दईं, “हे राजा, अगर हम खाली बतायें कि सपनो का रहै, तौ हम बाकै समझाए देंगे।”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />फिर से राजा कही, “मैं जानथौं कि तुम समय कै बढ़ान को बहाना कर रहै हौ, तुम देख रहै हौ कि मैं अपनो मन बनाए लौ हौं <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />तुम मोकै सपनो नाय बतागे तौ तुम सबकै ऐकै दंड दूँगो। तुम आपस मैं जौ बात के ऊपर सहमत ही गै हौ कि मोसे झूठ बोलथौ तुम्हैं आसा है कि समय के संग चीज बदल जाथैं। तुम मोकै बताबौ कि सपनो का रहै, और तौ मैं जानंगो कि तुम जाको मतलब भी समझाए सकथौ।”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />कसदी लोग बाकै जबाब दईं, “धरती मैं एसो कोई नाय है जो महामहिम कै बता पाबै कि तुम का जाननो चाहथौ। कोई भी राजा, जहाँ तक तौ सबसे बड़ो और सक्तिसाली राजा भी अपनो ज्योतिसी और जादूगरन से भी माँग नाय करी रहै। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />महामहिम जो माँग रहै हैं बौ इत्तो कठिन है कि देवतन कै छोड़कै कोई भी अपने ताहीं जौ नाय कर सकथै, और बौ आदमिन के बीच नाय रहथै।”<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />ऐसे मैं, राजा भौत गुस्सा हीगौ और बौ बेबीलोन के सब राजसाही सलाहकारन कै फाँसी देन को आदेस दै दई। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />तभई दानिय्येल और बाके संगबारे दोस्तन कै बौ सबकै मारन को आदेस दई।<verse eid="DAN 2:13" /></para>
  <para style="s">परमेस्वर दानिय्येल कै बताई की सपनो को का मतलब है</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />तौ दानिय्येल राजा के सेना को अधिकारी अर्योक के झोने गौ, जो बेबीलोन के पंडितन कै मारन के ताहीं निकरो रहै, सोच-बिचार और बुध्दिमानी से बासे कही, <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />बौ अर्योक से पूँछी कि राजा इत्तो कठोर आदेस काहे दई। फिर बौ दानिय्येल कै सब बात बताईं की का भौ रहै।<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />दानिय्येल भीतर जाए कै राजा से विनती करी कि बाके ताहीं कोई समय ठहराओ जाबै, तौ बौ राजा कै बौ सपनो को मतलब बताए देगो। <verse eid="DAN 2:16" /><verse number="17" style="v" sid="DAN 2:17" />तौ दानिय्येल अपने घरै जाएकै, अपने संग हनन्याह, मीसाएल, और अजर्याह कै जौ हाल बताए कै कही: <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />दानिय्येल उनसे कही की बे स्वर्ग को परमेस्वर से दया के ताहीं प्रार्थना करैं और बासे उनकै बात बतान के ताहीं कहीं ताकि बे बेबीलोन मैं दूसरे सलाहकारन संग मारे ना जा मैं। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />फिर बहे रात दानिय्येल कै दर्सन मैं जो छिपो भौ रहै बौ दानिय्येल के सामने दिखाओ गौ, और बौ स्वर्गीय परमेस्वर को धन्यवाद करी;<verse eid="DAN 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="DAN 2:20" />दानिय्येल कही “परमेस्वर बुद्धिमान और सक्तिसाली है!</para>
  <para style="q2" vid="DAN 2:20">हमेसा बाकी स्तुति करौ।<verse eid="DAN 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21" />बौ समय और मौसम कै एक समान करथै; बौ राजन कै बनाथै और बिगाड़थै;</para>
  <para style="q2" vid="DAN 2:21">बहै बुद्धि और समझ देथै।<verse eid="DAN 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22" />बौ गहरी और अंदर की बात कै दिखाथै;</para>
  <para style="q2" vid="DAN 2:22">बौ जानथै कि अंधकार मैं का छिपो है,</para>
  <para style="q2" vid="DAN 2:22">और बौ तुमरिये ही रोसनी से घिरो है।<verse eid="DAN 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23" />हे मेरे पुरखन को परमेस्वर, मैं तेरी स्तुति करथौं</para>
  <para style="q2" vid="DAN 2:23">और मैं तेरो आदर करथौं तू मोकै बुद्धि और बल दौ है;</para>
  <para style="q2" vid="DAN 2:23">तू मेरी प्रार्थना को जबाब दौ और सब बात उजागर करो है कि हमैं राजा से का कहने है।”<verse eid="DAN 2:23" /></para>
  <para style="s">दानिय्येल राजा कै सपनो को मतलब बताथै</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />फिर दानिय्येल अर्योक के झोने गौ, जो राजा के ग्यानी लोगन कै मार डारन की आग्या दई। बौ बासे कही, उनकै मत मारौ। मोकै बेबीलोन के राजा के झोने लै चलो, और मैं बाकै बतांगो कि बाको सपनो को का मतलब है।<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />अर्योक तुरन्त दानिय्येल को राजा के अग्गू लै गौ और बासे कही, “मोकै यहूदा बंधुवा दासन मैं से एक दास मोकै मिल गौ है जो राजा के जरिये देखे गै सपनो को मतलब बताए सकथै।”<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />राजा दानिय्येल से जोकै बेलतसस्सर भी कहो जाथै कही, का तुम मोकै बताए सकथौ कि मैं का अपनो देखो और बाको का मतलब है?<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />दानिय्येल जबाब दई, महाराज, ऐसो जादूगर, तांत्रिक या ज्योतिसी नाय है जो तोकै बाको मतलब बता पाबै। <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />फिर स्वर्ग मैं एक परमेस्वर है, जो रहस्यन कै दिखाथै। बे राजा नबूकदनेस्सर कै बताए दई है कि भविस्य मैं का होगो। अब मैं तुम से बौ सपनो और जो दर्सन तुम सोत समय देखकै बाकै बताथौं।<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />“जब महाराज सोत रहै, अपने भविस्य के बारे मैं सपनो देखी; जो भेदन कै दिखाथै, तुमकै दिखागो कि का होनबारो है।” <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />अब, जौ रहस्य मेरे अग्गू दिखाईं कि नाय मैं कोई और से जाधा बुद्धिमान हौं, ताकी महामहिम तुमरे सपनो को मतलब जान पामैं तुमरे मन मैं आए बिचारन कै समझ पामैं। <verse eid="DAN 2:30" /><verse number="31" style="v" sid="DAN 2:31" />“हे राजा, जब तू अपने दर्सन मैं अपने अग्गू एक बड़ी मूर्ति खड़ी देखी, बौ देखन मैं चमकदार और अजीब रहै।” <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />जाकी मुड़िया सुद्ध सोने से बनी रहै; जाकी छाती और भुजा चाँदी की बनी रहै; जाको करिहाँओ और कूल्हा पीतल के रहैं, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />बाकी टाँग लोहो की और पाँव कुछ लोहो और कुछ मट्टी की रहैं। <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />फिर तेरे देखत-देखत मैं, एक बड़ो पथरा बिना कोई कै छुईकै चट्टान से टकराएकै मूर्ति के लोहो और मट्टी के टाँगन से टकराथै और बाकै चकनाचूर कर दई। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />लोहो, मट्टी, पीतल, चाँदी और सोनो टूटकै ग्रीस्मकाल मैं खेतन की धूल के जैसी ही गै। हवा जे सब उड़ाए लै गई, कोई निसान नाय छोड़ी फिर बौ पत्थर बड़ो हीकै पर्वत बन गौ और सब धरती कै तोप लई।<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />“जौ सपनो रहै अब मैं महामहिम कै बतांगो कि जाको का मतलब है। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />हे राजा, तू सब राजन मैं सबसे बड़ो है। स्वर्ग के परमेस्वर तुमकै बड़ो बनाई है और तुमकै सक्ति और आदर दई।” <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />बौ तुमकै पूरी दुनिया को अधिपति, और सब पसु- पक्छीन कै अधिपति बताईं। तुहीं सोने की मुड़िया हौ। <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />तुमरे बाद एक और राज्य होगो जो तुमरे जैसी बड़ो नाय होगो, और बाके बाद एक तीसरो राज्य होगो, जो पूरी धरती मैं राज्य करैगो। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />और फिर एक चौथो राज्य होगो, लोहो जैसी तगड़ो, जो सब कछु चकनाचूर करकै तोड़ देगो। और जैसी लोहो सब चीज कै चकनाचूर कर देथै, बैसिये जो पहले के सब राज्यन कै चकनाचूर और कुचल देगो। <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />तैं जौ भी देखौ कि बाकी टाँग और उंगरियन कुछ-कुछ मट्टी और कुछ-कुछ लोहो की रहैं। जाको मतलब जौ है कि जौ एक अलग-अलग साम्राज्य होगो जा मैं से कुछ हद तक लोहो की ताकत होगी, का मट्टी मैं लोहो मिलो भौ रहै। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />टाँग की उंगरिया अधूरे रूप से लोहो और अधूरे रूप से मट्टी की रहै जाको मतलब जौ है की राज्य को एक हिस्सा अच्छो होगो और जाको एक हिस्सा कमजोर होगो। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />और तू लोहो कै कुम्हार की मट्टी मैं मिलो भौ देखे, जाको मतलब जौ है, कि बौ राज्य के लोग एक दूसरे लोगन से मिले-जूले तौ रहमंगे, पर जैसे लोहो मट्टी के संग मेल नाय खाथै, बैसिये बे भी एक नाय बने रहमंगे। <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />बे राजन के समय स्वर्ग को परमेस्वर एक एसो राज्य ठहरैगो जो कभी खत्म नाय होगो और जा मैं कभी भी कामयाब नाय ही पागे, और सब राज्यन कै खत्म कर देगो और फिर हमेसा के ताहीं बनो रहगो। <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />तुम देखे कि कैसो एक पत्थर बिना कोई कै छुए पहाड़ से टूट गौ और लोहो, कांसे, मट्टी, चाँदी और सोनो से बनी मूर्ती से टकराओ। अच्छो परमेस्वर महामहिम कै बताए रहैं हैं कि बाद मैं का होगो मैं तुमकै भी बताए दौहौं जो तुम सपनो देखे रहौ और तुमकै बाको सही मतलब भी बताओ रहौं।<verse eid="DAN 2:45" /></para>
  <para style="s">राजा दानिय्येल कै उपहार देथै</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />फिर राजा नबूकदनेस्सर जमीन मैं गिर कै दानिय्येल कै बलिदान और भेंट चढ़ान को आदेस दई। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />राजा कही, “तुमरो परमेस्वर सब देवतन को देवता, राजन को राजा, और भेदन कै खोलन बारो है तुम जौ रहस्य कै समझान मैं सहमत भै हैं।” <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />बौ बेबीलोन मैं दानिय्येल राजा कै एक ऊँचो पद दई, और बाकै अच्छो उपहार और सब बड़े ग्यानी के ऊपर खास मुखिया ठहराई। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />दानिय्येल को अनुरोध मैं राजा सद्रक, मेसक और अबेदनगो कै बेबीलोन के कामन कै कहन बारो चुनी दानिय्येल अच्छो दरबार मैं रहौ।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">नबूकदनेस्सर सबकै सोने की मूर्ति की पूजा करन कै आदेस दई</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />राजा नबूकदनेस्सर साठ हात ऊँची और छ: हाथ चौड़ी एक सोने की मूर्ति बनबाई, और बौ बेबीलोन के दूरा नामक मैंदान मैं ठड़बाई। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />तौ नबूकदनेस्सर राजा अपने सब अधिकारी कै जुरान के ताहीं आग्या दई - बामैं राजकुमार, राज्यपाल, ग्यानी लोग, न्यायी सास्त्री कि बे बौ मूर्ति की प्रतिस्टा मैं आ मैं जो बौ खड़ो करबाई रहै। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />फिर नबूकदनेस्सर और जे सब सासक राज्य के ताहीं एक झोने जुराने और मूर्ती के समर्पित ताहीं अग्गू ठाड़ गै <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />उन मैं से एक कुटबार ऊँची आबाज मैं चिल्लाए कै कही, “सब देस, जाति के लोग और अलग अलग भासा के बोलन बारेयौ, तुम कै जौ आग्या सुनाई जाथै कि! <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />तुम तुरहियन को सब्द सुनैगे, और बाके बाद ओबो, वीड़ा, सितार, और वीड़ा को बजनो सुनैगे; और फिर सब मिल जांगे। और जैसिये गाना सुरु होगो तुमकै सोने की मूर्ति की पूजा करन होगी जो राजा नबूकदनेस्सर बनाई रहै। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />जो कोई लोहोक कै दंडवत नाय करैगो, बौ बहे घड़ी फिर धधकती भट्ठी मैं डारो जागो।” <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />और फिर जैसिये बे बजान की आवाज सुनी, तौ सब देसन की जाति और भासा के लोगन कै लोहोक कै बौ सोने की मूर्ति कै दंडवत करीं जो राजा नबूकदनेस्सर एक जघा ठड़बाई रहै।<verse eid="DAN 3:7" /></para>
  <para style="s">दानिय्येल के तीन दोस्तन ऊपर राजा की आग्या को उल्लंघन करनो</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />बहे समय कुछ कसदी बेबीलोनी लोग राजा के झोने गै और मौका ढूँड़कै यहूदियन की बुराई करीं। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />बे राजा नबूकदनेस्सर से कहीं, “महामहिम हमेसा जिन्दो रहबै! <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />राजा आदेस दई है कि जैसिये गाना सुरु होगो, सबकै लोहोकने होगो और घुपटियाए कै सोने की मूर्ति की पूजा करन होगी, <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />और जो कोई लोहोक कै दंडवत नाय करैगो, बौ धधकत भै भट्टी मैं डारो जागो। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />सद्रक, मेसक, और अबेदनगो नाओं के कुछ यहूदी हैं जिनकै तुम बेबीलोन के पहले को अधिकारी ठहराई है, जो महामहिम की आग्यन कै मना कर रहैं हैं। नाय तौ बे तुमरे देवता की पूजा करथैं और ना तेरी खड़ी भई मूर्ति कै लोहोक कै दंड़वत करथैं।”<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />जा मैं राजा भौत गुस्सा हीगौ और बौ तीनौ आदमिन सद्रक, मेसक और अबेदनगो कै अपने अग्गू लान को आदेस दई। और तभई बे तीनौ आदमिन कै राजा के अग्गु हाजिर करे गै। <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />राजा नबूकदनेस्सर उनसे कही, हे सद्रक, मेसक, और अबेदनगो, का जौ सच है, कि तुम मेरे देवता कै दंड़वत और मेरी खड़ी कराई भई सोने की मूर्ति कै दंड़वत करन से मना करथौ? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />अब जैसिये तुरहियां, ओबो, वीड़ा, सितार, वीड़ा और सब बाजन को सब्द सुनौ, लोहोक कै मूर्ती कै दंड़वत करौ। अगर तुम ऐसो नाय करैगे, तौ तुमकै धधकती भट्ठी मैं फेंक दियो जागो। का ऐसो कोई परमेस्वर है जो तुम्हैं मेरे हात से बचाए सकथै?<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">2राजा. 18:35</char></note><verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />सद्रक, मेसक, और अबेदनगो जबाब दईं, “हे राजा, हम बौ बिसय के बारे मैं जबाब देन को प्रयोजन नाय करंगे। <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />अगर हम जो परमेस्वर की सेवा करथैं, तौ बौ हमैं धधकती भट्ठी से और तेरी सक्ति से बचाए सकथै, राजा बौ हमकै तेरे हातन से भी छुड़ाएगो। <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />अगर जौ ऐसो नाय करैं, तौभी महामहिम कै पता होए कि हम तेरे परमेस्वर की आराधना नाय करंगे, और जो सोने की मूर्ति तुम खड़ी कराए हौ, हम बाकै दंडवत नाय करंगे।”<verse eid="DAN 3:18" /></para>
  <para style="s">दानिय्येल के तीन दोस्तन कै आगी की भट्टी मैं डारनो</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />तौ नबूकदनेस्सर अपनो आपा खोए बैठो, और बाको मोह सद्रक, मेसक, और अबेदनगो के ऊपर गुस्सा से लाल हीगौ। फिर बौ भट्ठी के जैसी सात गुना जाधे धधकान की आग्या दई। <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />और बौ अपनी सेना के सबसे ताकतबर लोगन कै आग्या दई, कि बे तीनौ आदमिन सद्रक, मेसक और अबेदनगो कै भाँद कै धधकत भै भट्टी मैं डार देबौ। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />फिर उन्हैं उनके, कुर्ता, चोंगा, टुपिया और सब कुछ पहनाए दईं और उनकै भाँदकै धधकत भई भट्टी मैं फेंक दईं। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />राजा को आदेस इतनो अच्छो रहै और भट्ठी इतनी गर्म रहै कि आगी की लपट बे सद्रक, मेसक, और अबेदनगो कै पकड़न बारे आगी से जर गै, <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />तौ सद्रक, मेसक, और अबेदनगो, जो हबै ले भँदे रहैं, उनकै बे धधकत भई आगी के बीच मैं फेंक देथैं।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />नबूकदनेस्सर राजा अचम्भित भौ और अपने पाँव मैं खड़ो ही गौ। बौ अपने अधिकारिन से पूँछी, “का हम तीन आदमियन कै बाँधकै धधकत भई भट्टी मैं तौ नाय डारे रहैं?”<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">भजन. 34:19</char></note></para>
  <para style="p" vid="DAN 3:24">बे जबाब दईं, “हाँ, महाराज जौ बात तौ है।”<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />“फिर मैं चार आदमिन कै अपने अग्गू आगी के किनारे घूमत भई काहे देखथौं?” बौ पूँछी। “बे बंधे नाय हैं, और उन मैं चोट लगन को कोई निसान नाय दिखथै-और चौथो एक देवता के रूप के तराहनी दिखाई पड़थै।”<verse eid="DAN 3:25" /></para>
  <para style="s">तीनौ आदमियन कै छोड़नो और उनको प्रचार</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />फिर नबूकदनेस्सर धददकत भई भट्ठी के अग्गू गौ और चिल्लाए कै कही “सद्रक, मेसक! अबेदनगो! परमपिता परमेस्वर के सेवक! बाहर आबौ!” और बे जल्दी बाहर आए गै। <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />राजा के सब अधिकारी, राज्यपाल, और भी दुसरे अधिकारी बे तीनौ आदमियन कै देखन के ताहीं इकट्ठो भै, जिनकै आगी से कोई नुकसान नाय भौ रहै। उनके बार तक नाय खराब भै, उनके लत्ता भी नाय जरे रहैं और उन मैं धुंआँ की कोई महक भी नाय रहै।<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />राजा कहथै, “परमेस्वर को धन्यवाद होबै कि सद्रक, मेसक और अबेदनगो, बौ अपनो दूत भेजी और बे लोगन कै बचाई जो बाकी सेवा करत रहैं और बाके ऊपर भरोसा करत रहैं। बे मेरे आदेसन की आदर नाय करीं और अपने देवता कै छोड़कै कोई दुसरे देवता के अग्गू लोहोक कै बाकी पूजा करन की बजाए अपनी जान खतरा मैं डार लईं।”<verse eid="DAN 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29" />“और मैं आग्या देथौं, की अगर कोई जाति, या वंस, या कोई भी भासा को आदमी सद्रक, मेसक, और अबेदनगो कै परमेस्वर को अपमान करै, तौ बाकै टुकड़ा- टुकड़ा करो जाएगो, और बाके घर कै खंडरन को ढेर बनाए दौ जागो। और फिर उद्धार करन बारो कोई दुसरो कोई देवता भी नाय होगो।”<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />और राजा सद्रक, मेसक, और अबेदनगो कै बेबीलोन के देस मैं ऊँचे पदन मैं बड़ाई।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबूकदनेस्सर को दुसरो सपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />राजा नबूकदनेस्सर संसार के सब देसन की जातियन और सब भासा के बोलनबारे लोग जो पृथ्वी मैं रहथैं बे सबन कै अलग अलग संदेस भेजी:</para>
  <para style="p" vid="DAN 4:1">“सुभकामना! <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />परमेस्वर मोकै जो आस्चार्य के काम और चमत्कार दिखाई है, उनकी और मेरी बात प्रकट करनो चाहथौं।”<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">भजन. 66:16</char></note><verse eid="DAN 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3" />“परमेस्वर हमैं कितने महान चमत्कार दिखाथै!</para>
  <para style="q1" vid="DAN 4:3">बौ जो चमत्कार करथै बे कित्तो सक्तिसाली है!</para>
  <para style="q1" vid="DAN 4:3">परमेस्वर हमेसा राजा है; बौ हमेसा राज्य करैगो।”<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />“मैं नबूकदनेस्सर अपने भवन मैं चैन से और अपने महल मैं खुसी से रहत रहौं।” <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />मैं एसो सपनो देखो जोके कारड़ मैं डराए गौ; और खटिया मैं लेटो-लेटो जौ बिचार मेरे मन मैं आओ और जौ बात मैं देखो, उनके कारड़ मैं घबराए गौ। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />मैं बेबीलोन के सब अच्छे ग्यानी लोग कै मेरे झोने लान को आदेस दई कि बता मैं मेरे सपनो को का मतलब है। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />तौ राजा कही मैं सब भविस्यवक्ता, जादूगरन, पुजारी और ज्योतिसियन कै बुलाओ गौ, और मैं उनकै सपनो बताओ, तौ बे मोकै मतलब नाय बताए पाईं। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />फिर दानिय्येल भीतर आओ। बाके मेरे परमेस्वर के नाओं से बेलतसस्सर भी कहो जाथै। पवित्र देवता की आत्मा बामैं है, फिर मैं बाकै बताओ कि मैं कौन सो सपनो देखो रहौं। मैं बासे कहो: <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />बेलतसस्सर, ज्योतिसियन को मुखिया, मैं जानथौं कि पवित्र परमेस्वर की आत्मा तेरे मैं है और तू सब रहस्य कै जानथै। जौ मेरो सपनो है मोकै बताबौ कि जाको का मतलब है?<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />“जब मैं सोत रहौं तौ मैं एक दर्सन देखो, कि मोकै धरती के बीच मैं एक बड़ो पेंड़ दिखाई दई बाकी लम्बाई भौत जाधे रहै। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />जौ तब तक बड़ो और बड़ो होत गौ और बाकी ऊँचाई स्वर्ग तक ही गई। और बौ पृथ्वी की छोर तक दिखाई देन लगो। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />बाके पत्ता अच्छे रहैं, और बौ फल से लदो पड़ो रहै। जौ पूरो संसार कै खान ताहीं भरपूर रहै। जंगली जानवर बाकी छाईं मैं आराम करत रहैं, पक्छी बाकी हंगईय्या और घोसलन कै बनात रहैं, और सब तराहनी के जिन्दे प्राँड़ी बाके फल खात रहैं।”<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">मत्ती. 13:32</char></note><verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />“मैं पलंग मैं दर्सन के समय का देखो की एक पवित्र स्वर्गदूत स्वर्ग से उतर आओ है।” <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />बौ ऊँचे सब्द से चिल्लाए कै कही, जौ पेंड़ कै काट डारौ, और बाकी हंगईय्यन कै काट डारौ; और बाके पत्तन कै तोड़ देबौ और बाके फल बिखेर देबौ। जानवरन कै बाके नीचे से हट जा मैं और पक्छी बाकी हंगईय्यन से उड़ जा मैं। <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />फिर ठुड्डी को लोहो और पीतर की पत्ती से मोड़ कै जमीन मैं छोड़ दई। जाकै बहै घाँस बारे मैंदान मैं छोड़ देबौ।</para>
  <para style="p" vid="DAN 4:15">“अब जौ आदमी मैं ओस गिरै, और जे जानवरन और पौधन के संग रहन दे।” <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />सात साल तक बाको मन आदमी को नाय रहै, जानवर को मन रहै। <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />“जे चौकन्ने और चौकन्ने देवदूतन को विचार है। तौ फिर, सब जघा के सब लोगन कै जौ जानन देबौ कि अच्छो परमेस्वर के झोने देसन की सक्ति है और बौ उनकै अपनी जैसी इच्छा रहै कोई कै भी दै सकथै- जौ तक की बे लोगन कै सबसे कम जरुरी है।”<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />मैं राजा नबूकदनेस्सर कही, “जहे बौ सपनो है जो मैं देखो रहौं।” “अब, बेलतसस्सर, मोकै बताबौ जाको मतलब का है। मेरो कोई भी अच्छो पंडित मोकै नाय बता पाईं, कि तुम बताए सकथौ, कि पवित्र परमेस्वर की आत्मा तुम मैं है।”<verse eid="DAN 4:18" /></para>
  <para style="s">दानिय्येल सपने की ब्याख्या करथै</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />जा मैं दानिय्येल, जाकै बेलतसस्सर भी कहथैं, इतनो घबराए गौ कि कुछ कहै नाय पाबै। राजा बासे कही, हे बेलतसस्सर, सपनो और बाको सन्देस से घबराए मत जईयो।</para>
  <para style="p" vid="DAN 4:19">बेलतसस्सर उत्तर दई, “महाराज, मैं चाहथौं कि सपनो और बाको खुलासा तुम मैं नाय जबकि बाके दुस्मन मैं लागू होबै। <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />जौ पेंड़ इतनो ऊँचो रहै कि जौ आसमान तक पहोंच गौ, जाकै संसार मैं सब कोई देख सकथै।” <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />बाके पत्ता सुन्दर रहैं और बामैं इतने फल रहैं कि पूरे संसार को पेट भर सकथै। जंगली जानवर बाके नीचे आराम करत रहैं, और पक्छी बाकी हंगईयन मैं घोसला बनाथैं।<verse eid="DAN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 4:22" />“महामहिम, तुम पेंड़ हौ, ऊँचे और मजबूत। तुम इतनो महान ही गै हौ कि तुम आसमान तक पहोंच गै हौ, और तुमरी राज्य सक्ति पूरी दुनिया मैं फैल गई है। <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />जब राजा देखत रहै, तौ एक स्वर्गदूत स्वर्ग से उतरो और बोली, ‘पेंड़ कै काट डारौ और खत्म कर देबौ, और ठ्ठडी कै धरती मैं छोड़ दईं। बाके चारौ घाँईं लोहो और पीतर की पट्टी लपेटौ, और बाकै घाँस के संग मैंदान मैं छोड़ दईं। और जौ आदमी के ऊपर ओस गिरै, और जे जानवरन के संग सात साल तक हुनै रहन दे।’”<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />“तौ जाको जहे मतलब है, महामहिम, और जौ बहै है जो अच्छो परमेस्वर घोसित करी है कि तुमरे संग घटना होगी। <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />तुमकै आदमिन के गाओं से निकार दौ जागो और जंगली जानवरन के संग रहन होगो। सात साल तक तू बरधा के जैसी चारौ खागो, और खुले आसमान मैं सोगो, और जहाँ ओस तेरे ऊपर गिरैगी। तभई तुम मानैगे कि अच्छो परमेस्वर सब आदमी देसन की रक्छा करथै और बौ जो चाहे बाकै दे सकथै। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />देवदूत ठुड्डी कै जमीन मैं छोड़न को आदेस दई। जाको मतलब जौ है कि तुम फिर से राजा बन जागे जब तुम मानैगे कि परमेस्वर पूरी दुनिया मैं राज्य करथै। <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />तौ फिर, महामहिम, मेरी सलाह को पालन करौ। पाप करनो बंद करौ, जो अच्छो है बौ करौ और गरीबन के ऊपर दया करौ। तभई तुम अच्छे बने रहागे।”<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />जौ सब राजा नबूकदनेस्सर के संग भौ। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />खाली बाहरै महेना बाद, जब बौ बेबीलोन मैं अपने अच्छे महल के ऊपर घूमत रहै, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />बौ कही, “देखौ बेबीलोन कितनो महान! मैं अपनी सक्ति और अपनी महिमा देखन के ताहीं जौ अपनी राजधानी के रूप मैं बनाई।”<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />जासे पहले कि बाके मोह से जे सब्द निकरते, स्वर्ग से एक आवाज आई, “राजा नबूकदनेस्सर, मैं जो कहथौं बौ सुनौ! तुमरो राज्य तुमरे हात से छीन लौ गौ है। <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />तू आदमी के समाज से निकार दौ जागो, और जंगली जानवरन के संग रहेगो, और बरधा के जैसी सात साल तक चारौ खागो। तब तुम मानैगे कि परमप्रधान परमेस्वर के झोने आदमिन के राज्य मैं सक्ति है और बौ उनकै जो चाहे बौ दै सकथै।”<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />बात तुरन्तै सच्ची ही गई। नबूकदनेस्सर को आदमी समाज से निकार दई और बौ बरधा के जैसी चारौ खान लगो। ओस बाके सरीर मैं गिरत रहै, और बाके बार चील के पंखन के जैसी लम्बे ही जाथैं और बाके नहा पक्छी के पंजन के जैसी लम्बे ही जाथैं।<verse eid="DAN 4:33" /></para>
  <para style="s">नबूकदनेस्सर परमेस्वर की स्तुति करथै</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />“जब सात साल बीत जांगे,” राजा कही मैं आसमान के घाँईं देखो, और मेरी बुद्धि लौट आई। मैं परम परमेस्वर की स्तुति करो, और जो हमेसा जिन्दो है, बाकै आदर और महिमा देबौ।</para>
  <para style="q1" vid="DAN 4:34">“बौ हमेसा राज्य करैगो,</para>
  <para style="q2" vid="DAN 4:34">और बाको राज्य हमेसा बनो रहगो।<note caller="+" style="f"><char style="fr" closed="false">4:34 </char><char style="ft" closed="false">भजन. 145:13, 1तीमु. 1:17</char></note><verse eid="DAN 4:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35" />बे धरती के लोगन कै कुछ नाय समझथैं;</para>
  <para style="q2" vid="DAN 4:35">स्वर्ग मैं देवदूत और धरती मैं लोग</para>
  <para style="q2" vid="DAN 4:35">बाके नियम एक जैसी हैं।</para>
  <para style="q1" vid="DAN 4:35">बाकी इच्छा को कोई विरोध नाय कर सकथै</para>
  <para style="q2" vid="DAN 4:35">का सवाल करैं कि बौ का करथै।”<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />“जब मेरी बुद्धि लौट आई, तौ मेरो सम्मान, मेरी इज्जत और मेरे राज्य को गौरब मोकै बापस दौ गौ। मेरे अधिकारिन और मेरो मालिक मेरो आदर करीं, और मोकै मेरो राज्य पहले से जाधा सम्मान के संग लौटार दौ गौ।”<verse eid="DAN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37" />“और अब, मैं, नबूकदनेस्सर, स्वर्ग के राजा की स्तुति, सम्मान और महिमा करथैं। बौ कुछ भी करथै बौ सही और न्याय है, और कोई कै भी अपमान कर सकथै जो गर्व से काम करथै।”<note caller="+" style="f"><char style="fr" closed="false">4:37 </char><char style="ft" closed="false">व्यव. 32:4</char></note><verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बेलसस्सर को भोज</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />एक रात राजा बेलसस्सर एक हजार कुलीन लोगन कै एक बड़ो भोज मैं हटकी, और बे एक संग दाखरस पीं। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />जब बे दाखरस पीत रहैं, बेलसस्सर बे सोने और चाँदी के गिलास और कटोरी लान को आदेस दई, जे बाके दऊवा नबूकदनेस्सर यरूसलेम के मंदिर से लैगौ। राजा उनकै बुलान भेजी फिर बौ, बाकै सरदार बाके बईंय्यरन और बाकी प्रेमिका बामैं से पी सकैं। <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />तब जे सोने के बर्तन यरूसलेम मैं परमेश्‍वर के भवन के मन्दिर मैं से निकारे गै रहैं, बे लाए गै; और राजा अपने प्रधानन, और बईंय्यरन, और प्रेमिका समेत उन मैं पीन लगे। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />और सोनो, चाँदी, कठिया और पत्थर के बने देवता की महिमा करीं।<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />अचानक से एक आदमी को हात आओ और महल की पलस्तर बारी दीवार मैं लिखनो सुरू कर दई, जहाँ दिया को उजियारो सबसे तेज चमकत रहै। और राजा बौ हात कै देखी जो लिखत रहै। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />बाकै देखकै राजा भयभीत ही गौ बाको मोहों उतर गौ और इतनो भयानक हीगौ कि बाके घुंटो कांपन लगे। <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />बौ चिल्लाए कै कोई जादूगरन और ज्योतिसियन कै बुलान के ताहीं कही। जब बे अंदर आए, तौ बेबीलोन को राजा उनसे कही, “जो कोई भी जौ लेख कै पड़ सकथै और मोकै बताए सकथै कि जाको का मतलब है, बाकै राजसाही लत्ता पहनाओ जागो, बाकी गर्दन मैं आदर की सोने की माला पहनाईं जागी, और अब मेरे राज्य मैं बाकै तीसरो सासक बनाए दुंगो।” <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />तभई ग्यानी और सलाहकार लोग अग्गू आए, लेकिन बामैं से कोई भी लेख कै पड़ नाय पाओ या राजा कै जाको मतलब नाय बता पाईं <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />तभई राजा बेलसस्सर और जाधा दुखी ही गौ और बाको मोहों उतर गौ, और बाके बुलाए गै प्रधान भी बड़ा घबराए गै।<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />तभई रानी, राजा और प्रधानन को गुलु सुनी तौ बौ रुटकुरा मैं गई जितै सब भोज मैं बैठे रहैं और बौ कहन लगी, “महामहिम हमेसा जिन्दो रहबै! इतनो परेसान मत होबै और अपनो चैहरा मत उतारौ। <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तुमरे राज्य मैं एक आदमी है जो मैं पवित्र परमेस्वरन की आत्मा है। जब तुमरे दऊवा राजा रहैं, तौ जौ आदमी के देवतन को दिमाक, और ग्यान दिखाई। और तेरो दऊवा राजा नबूकदनेस्सर बाकै भविस्य बतान बारो, तांत्रिक, जादूगर और ज्योतिसियन मैं मुखिया ठहराईं हैं। <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />बाके झोने अलग छमता है और बौ सपनो की ब्याख्या करन की पहेलियन कै सुरजान और रहस्यन कै समझन मैं बुद्धिमान और कुसल है; तभई बौ दानिय्येल कै, जोको नाओं राजा बेलतसस्सर नाओं रखी है, बुलान भेजी, और बौ तुमकै बताए देगो कि जे सब बातन को का मतलब है।”<verse eid="DAN 5:12" /></para>
  <para style="s">दानिय्येल लेखन की ब्याख्या करथै</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />तभई दानिय्येल कै राजा बेलसस्सर के अग्गू लाओ गौ, और राजा बासे कही, का तू दानिय्येल बहे यहूदी बंधुवा है जोकै मेरो राजा दऊवा तुम्हैं यहूदा देस से इतै लै आई रहै? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />मैं सुनो हौं कि पवित्र परमेस्वरन की आत्मा तुमरे भीतर वास करथै और तेरे भीतर समझ, ग्यान और बुद्धि है। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />जौ लिखो भौ कै पढ़नो और मोकै जाको मतलब बतान के ताहीं ग्यानी और जादूगरन कै लाओ गौ, लेकिन बे जाको मतलब नाय खोज पाईं। <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />अब मैं सुनो हौं कि तू लुके भै को मतलब ढूँड़ सकथै और रहस्मय की बात समझाए सकथै। अगर तुम जौ लिखो भौ कै पढ़ सकथौ और मोकै बताए सकथौ कि जाको का मतलब है, तौ तोए राजसाही लत्ता पहनाओ जाएगो, और घेंट मैं आदर की सोने की माला पहनैगो, और राज्य मैं तीसरो सबसे सक्तिसाली आदमी होगो।<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />तभई दानिय्येल जबाब दई, “अपने उपहार अपने झोने रखौ या जे कोई और कै दै देबौ। मैं महामहिम के ताहीं जो लिखो गौ है बाकै पढ़ंगो और तुमकै बतांगो कि जाको का मतलब है।”<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />“परमेस्वर तुमरो दऊवा नबूकदनेस्सर कै एक परमप्रधान राजा बनाई और बौ गौरब और महिमा दई।” <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />बौ इत्तो महान रहै कि सब देसन, जातियन और भासा के लोग बासे डरात और काँपत रहैं। अगर बौ कोई कै मारनो चाहतो तौ बौ मार डारतो; अगर बौ कोई कै रखनो चाहतो तौ बाकै जिन्दो रखतो और जोकै बौ ना चाहतो बाकै घात करतो, और जो चहातो बौ बाको आदर करतो और जो चाहतो बाकै गिराए देतो। <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />लेकिन जब बाको मन घमंडी, जिद्दी और क्रूर ही गौ, तभई बौ बाकै राजगद्दी से हटा दई और बौ अपनो आदर की जघा खोए दई। <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />बौ आदमी समाज से निकार दौ गौ और बाको मन जानवरन के जैसी ही गौ। बौ जंगल के गधन के संग रहत रहै, बरधा के जैसी चारौ खात रहै और खुली हवा मैं सोत रहै, और बाके झोने ओस से बचन के ताहीं कुछ नाय रहै। बाद मैं बे मानी कि परमप्रधान परमेस्वर सब आदमिन के राज्यन कै सम्भालत है और बौ जो चाँहे बाकै दै सकथै।<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />“पर हे बेलसस्सर नबूकदनेस्सर को लौड़ा, तू सब जौ जानत भै भी अपने मन कै नम्र नाय करो।” <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />तुम स्वर्ग के प्रभु के खिलाप काम करे, और बाके मंदिर से कटोरा लै आई। तुमरे रईस, तुमरी बईंय्यरैं और तुमरी रखेलियन बे अंगूर को रस पीत रहैं और सोना, चाँदी, कांसे, लोहो, कठिया और पत्थरा से बने देवतन की पूजा करत रहैं-ऐसे देवता जो देखकै सुन नाय पात रहैं और कुछ नाय जानत रहैं। फिर तुम बौ परमेस्वर को आदर नाय करैं जौ बौ बताथैं कि तुम जिन्दे रहेगे या मरैगे और जो तुम हर काम कै संभालथौ। <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />तभईये जौ हात को एक भाग बहे के घाँईं से प्रकट करो गौ है और बे सब्द लिखे गै हैं।<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />“और जो सब्द लिखे गै हैं बे जे हैं मने, मने, तकेल, ऊपर्सीन <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />और जाको मतलब जौ है: गिनती, परमेस्वर तुमरे राज्य के दिन कै गिन लई है और जाकै खत्म कर दई है; <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />तकेल तौ मानौ तखरी मैं तौलो गौ , तुमकै तखरी मैं तोली और तुम बड़ा हल्के निकरे; <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />तुमरो राज्य बाँट दौ गौ है और मादियन और फरीसियन कै दै दईं है।”<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />फिर बेलसस्सर अपने सेवकन कै आदेस दई कि दानिय्येल कै राजसाही लत्ता पहनाओ जाबै और बाके घेंट मैं सोनो की माला पहनाई जाबै। और बौ राज्य को तीसरो सक्तिसाली सासक होगो। <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />बहे रात कसदियन को राजा बेलसस्सर मार डारो गौ; <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />और दारा मादे, बहे समय बौ बासठ साल को भौ रहै, और बौ हुँआँ को नया सासक बनो।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">बकटा के गड्ढा मैं दानिय्येल</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा अपनो राज्य पद लेन ताहीं एक सौ बीस राज्यपालन कै चुनी। <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />जाके अलावा, बौ राज्यपालन कै देखन कै और राजा की देखभाल करन के ताहीं दानिय्येल दुई और आदमिन कै चुनी। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />दानिय्येल जल्दी से दिखाई कि बौ दुसरे राज्यपालन की तुलना मैं अच्छो काम कर सकथै। बौ अच्छो काम रहै, राजा बौ पूरे राज्य कै अधिकारी बनान के ताहीं कही। <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />तौ दुसरे देखन बारे और राज्यपालन दानिय्येल के राज्य कामकाज के तरीका मैं कुछ गलत देखन की कोसिस करी, लेकिन बे ऐसो नाय कर पाईं, दानिय्येल विसवासी रहै और बौ कुछ भी गलत या बेईमान नाय करी रहै। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />बे एक दुसरे से कहीं, “हमैं दानिय्येल के आरोप लगान के ताहीं कछु नाय मिलो जब तक कि बाके धर्म के बारे मैं कुछ नाय है।”<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />फिर बे राजा से मिलन गै और कहीं, “राजा दारा, महामहिम लम्बी जिंदगी जिए! <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />हम सब जो तुमरे राज्य कै देखन बारो करथै देखन बारो राज्यपाल, और दुसरो अधिकारी जौ बात मैं सहमत रहैं कि महामहिम को आदेस करनो चाहिए और जाकै सख्ती से लागू करनो चाहिए। और आदेस दई की तीस दिन तक कोई भी महामहिम के अलावा कोई भी देवता या कोई आदमी से कुछ भी माँगन को आदेस दई, और जो कोई आदेस कै नाय मानैगो बाकै बकटा से भरे गड्डा मैं फेंक दौ जागो। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />तौ महामहिम को जौ आदेस दई और जा मैं दस्तखत करन दे, और जौ पता करीं मादियन और फरीसियन को एक कानून, जो बदल नाय सकथै।” <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />और तभई राजा दारा आदेस मैं दस्तखत करी। <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />जब दानिय्येल कै पता चलो कि आदेस मैं दस्तखत ही गै, तौ बौ घर चले गौ। बाके घर के ऊपर मंजिल के कमरा मैं खिड़की रहैं जो यरूसलेम के घाँईं खुलत रहैं जैसिये बौ हमेसा के तराहनी बौ खुली खिड़की के झोने घुंटो टेक कै दिन मैं तीन बार परमेस्वर से प्रार्थना करत रहै कि।<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />तभई दानिय्येल कै बाके दुस्मन अधिकारी परमेस्वर से प्रार्थना मैं कुछ माँगत भै देखीं, <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />फिर का भौ कि बे सब राजा के झोने गै, और बे राजा से बौ नियम के बारे मैं बताथैं जो बौ बनाई रहै। जबाब दई, “हाँ जौ एक सक्त आदेस है, मादियन और फरीसियन को कानून है, जोकै बदल नाय सकथैं।”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />तब बे राजा से कही, “यहूदा परदेसी मैं से एक दानिय्येल नाओं को आदमी है, महामहिम बौ तेरे बनाए गै दस्तखती आदेस को पालन नाय करथै। बौ परमेस्वर से हमेसा दिन मैं तीन बार प्रार्थना करथै।”<verse eid="DAN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14" />तौ राजा जौ सुनी, तौ बौ परेसान हीगौ और बौ दानिय्येल कै बचान को रास्ता ढूँड़न की पूरी कोसिस करी। बौ सूरज डूबन तक कोसिस करत रहौ। <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />तौ दानिय्येल के दुस्मन अधिकारी राजा के झोने आए और बासे कहीं, “महामहिम जानथौ कि राजा और मादियन, फरीसियन के जरिया कानून बनाओ गौ मैं दस्तखत कर दौ जाथै तौ कोई भी बौ आदेस बदलो ना जाए सकथै।”<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />तभई राजा दानिय्येल कै पकड़कै बकटा से भरे गड्डा मैं डारन को आदेस दई। बौ दानिय्येल से कही, “तू जो परमेस्वर की इत्ती ईमानदारी से सेबा करथै, बहे तोकै बचाबै।” <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />तभई अधिकारी बकटा के माँद के मोहों मैं एक बड़ो पत्थर रख दईं, और राजा बामैं अपनी राजसाही मोहर और अपने सरदारन की मोहर लगाए दई, ताकी कोई दानिय्येल के बारे मैं कुछ बदल नाय सकै। <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />तौ राजा महल मैं लौट गौ और बाके झोने सुख-बिलास की कोई भी चीज बाके झोने नाय आई और बाकै नींद भी नाय आई।<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />भोर होथै राजा उठो और जल्दी से बकटा की माँद के घाँईं गौ। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जब राजा बकटा की माँद मैं पहुँचो, तौ बौ चिल्लाए कै कही, “दानिय्येल, जिन्दो परमेस्वर को सेवक! जो तू परमेस्वर की इतनी इमानदारी से सेबा करथै, तोकै बकटन से बचान की छमता है?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />दानिय्येल जबाब दई, “महामहिम लम्बी जिंदगी जिए! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />परमेस्वर अपनो दूत भेजकै बकटन के मोहो बंद कर दई, कि बे मोकै नुकसान नाय पहोंचा मैं। बौ एसो तभई करी कि बौ जानत रहै कि मेरी कोई गलती नाय है और मैं तुमरे संग कोई गलत नाय कर रहौं, महाराज।”<note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="ft" closed="false">यसा. 63:9, भजन. 34:7</char></note><verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />राजा बड़ा खुस भौ और बौ दानिय्येल कै गड्डा से बाहर निकारन को आदेस दई। तभई बे बाकै ऊपर खींच लईं और देखीं की बाकै एकौ चोट नाय लगी है, का बौ परमेस्वर मैं भरोसा करथै। <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />तौ राजा बे सब कै पकड़न को आदेस दई जो दानिय्येल ऊपर दोस लगाई रहैं, और उनकी बईंय्यरन और लौड़ा समेत बकटा के माँद मैं डरबाए दई। जासे पहले की बे गड्डा के नीचे पहौंचते, बकटा उनके ऊपर हमला कर दई और उनकी सब हड्डियन समेत उनकै खाए गौ।<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />तौ राजा दारा पृथ्वी के सब जातियन और सब भासा के लोगन कै जौ चिट्ठी लिखी:</para>
  <para style="p" vid="DAN 6:25">“सुभकाना! <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />मैं आदेस देथौं कि मेरे राज्य मैं सब कै दानिय्येल के परमेस्वर को भय मानैं और बाको आदर करैं।”</para>
  <para style="q1" vid="DAN 6:26">“बौ जिन्दो परमेस्वर है,</para>
  <para style="q2" vid="DAN 6:26">और हमेसा राज्य करै।</para>
  <para style="q1" vid="DAN 6:26">बाको राज्य कहुए खत्म नाय होबै,</para>
  <para style="q2" vid="DAN 6:26">और बौ हमेसा स्थिर रहेगो।<verse eid="DAN 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27" />बौ बचाथै और बचात रहगो;</para>
  <para style="q2" vid="DAN 6:27">बौ अदभुत काम और चमत्कार करथै</para>
  <para style="q2" vid="DAN 6:27">स्वर्ग और धरती मैं।</para>
  <para style="q1" vid="DAN 6:27">बौ दानिय्येल कै बकटन से मारे जान से बचाई।”<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />दारा राजा के सासनकाल और फारस के कुस्रू के सासनकाल के दिनन मैं दानिय्येल सुख-चैन से रहो।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="ms">दानिय्येल को बाके बारे मैं दर्सन</para>
  <para style="s">चार जानवरन के बारे मैं दानिय्येल को दर्सन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बेलसस्सर बेबीलोन को राजा होन के पहले साल मैं एक सपनो देखी, और रात को एक दर्सन देखी। मैं सपनो लिख दौ, और जौ बाको वर्ड़न है <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />बौ रात दानिय्येल जो सपनो देखी:</para>
  <para style="p" vid="DAN 7:2">सब घाँईं से ब्यार चल रही है और समुद्र के किनारे से टकराए रही है।<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">प्रका. 7:1</char></note> <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />चार बड़े जानवर समुद्र से बाहर आए, सब एक दुसरे से अलग रहैं। <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />पहलो बकटा जैसी दिखथै लेकिन बाके पंखमा उकाब जैसी रहैं। जब मैं देखत रहौं, तौ पंखमा टूट गै। और बाकै पृथ्वी से बौ जानवर कै उठाए कै सीध खड़ो कर दई। और फिर जाकै एक आदमी को दिमाक दई।<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />दुसरो जानवर अपनी पच्छू टाँग मैं खड़ो भलुआ जैसी लगत रहै। बौ अपने दाँतन के बीच तीन पुसरिया पकड़ रखाई रहै, और एक आबाज उनसे कही, “अग्गू बढ़, जितनो हुई पाबै उतनो माँस खा!”<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />जब मैं देखत रहौं, एक और जानवर दिखाई दई। बौ चितौना जैसी दिखात रहै, फिर बाकी पीट मैं पक्छी के पंखमा के जैसी चार पंखमा रहैं, और बाके चार मूड़ रहैं। जाके बारे मैं अधिकारी को आदेस रहै।<verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />फिर जाके बाद रात मैं मैं एक सपनो देखो, एक चौथौ जानवर सामने आओ। बौ सक्तिसाली, भयानक, रहै। अपने बड़े लोहो के दाँतन से बाकै मार दई, दुसरे जानवर के जैसी बाके दस सींग रहैं। <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />जब मैं सींगन कै देखत रहौं, मैं देखो की दुसरे सींगन के बीच मैं एक छोटो सो सींग निकारत रहै। बौ उतै पहले से तीन सींगन कै तोड़ दई। जौ सींग मैं आदमी की आँखी और मोहो रहै जो दुसरे जानवरन से अलग दिखात रहै।<verse eid="DAN 7:8" /></para>
  <para style="s">बौ आदमी को दर्सन जो हमेसा जिन्दो रहौ है</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />जब मैं देखत रहौं, तौ जघा- जघा सिंहासन लगे भै रहैं बौ हमेसा लम्बी जिंदगी जीन बारो, एक राज सिंहासन मैं बैठ गौ। बाके लत्ता बरफ के जैसी सेते ही जाथैं और राज्य सिंहासन सबार और पहिया आगी से जलत रहैं,<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">प्रका. 1:14</char></note> <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />और बामैं से आगी की लपट निकरत रहै। बे बाकी सेबा के ताहीं हजारौं- हजारौं लोग हाजिर भै और लाखों-लाखों लोग बाके अग्गू खड़े रहैं। अदालत अपनो साल सुरु करी और किताब कै खोलीं।<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">प्रका. 20:11,12</char></note><verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />जब मैं देखत रहौं, मैं भी छोटे आबाज की डींगें हाँकत भई सुन सकथै। जैसी मैं देखो, चौथौ जानवर मरगौ, और बाको सरीर आगी की लपट मैं फेंक दई और खत्म ही गौ। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />दुसरे जानवरन से बाकी सक्ति छीन लईं, लेकिन बे उनकै सीमित समय तक जिन्दो रहन को आदेस दई।<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />रात मैं मैं सपने मैं देखो और मनुस्य के लौड़ा के हानी कोई मेरे सामने स्वर्ग के बादरन के संग आत भई दिखाई दई। बौ प्राचीन काल के झोने पहोंचो और बाकै बाकी उपस्थिति मैं लै गौ।<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">प्रका. 14:14 मत्ती. 26:64</char></note> <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />बौ अधिकार, सम्मान और साही सक्ति दईं, ताकि सब देसन, जातिन और भासा के लोग बाकी सेबा करैं। बाको अधिकार हमेसा बनो रहेगो, और बाको राज्य कभी खत्म नाय होगो।<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">प्रका. 11:15</char></note><verse eid="DAN 7:14" /></para>
  <para style="s">दर्सन की व्याख्या करी गई है</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />दानिय्येल जो दर्सन देखी बासे मैं दुखी हीगौ और मैं बड़ा परेसान हीगौ। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />मैं उतै खड़े लोगन मैं से एक झोने गौ और बाकै सब समझान कै कही। तौ बौ मोकै मतलब बताई। <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />बे कहीं, “जे चार बड़े जानवर चार राज्य हैं जो पृथ्वी मैं आंगे। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />और पवित्र परमेस्वर के लोग साही सक्ति प्राप्त करीं और हमेसा-हमेसा के ताहीं राज्य प्राप्त करन के ताहीं अपने झोने रखंगे।”<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">प्रका. 7:27</char></note><verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />फिर मैं चार जानवर के बारे मैं जाधा जाननो चाहत रहै, जो कोई भी दुसरे जानवर के तराहनी नाय रहै बौ भयानक जानवर जो अपनो सिकार कै अपने पंजन और लोहो के दाँतन से टुकड़ा-टुकड़ा कर देथै और फिर उनकै पाँओं से रौंद देथै। <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />और मैं बाके मुड़िया मैं दस सींग के बारे मैं, जाननो चाहथौं जो बाके बाद निकरो और बाके तीन सींग कै गिराए दई बाकी आँखी और मोहो रहै और बौ गर्व से सेखी दिखात रहै जे दुसरे सब जाधा भयानक रहैं।<note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">दानी. 7:8</char></note><verse eid="DAN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 7:21" />जब मैं देखत रहौं, तौ बौ सींग परमेस्वर के पवित्र लोगन से लड़ाई करीं और उनकै जीत लईं <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />तौ जौ हमेसा लम्बी जिंदगी जिए, बौ आओ, और परमेस्वर के पवित्र लोगन के पक्छ मैं समाधान करी। परमेस्वर के पवित्र लोगन के ताहीं साही सक्ति मिली।<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">मत्ती. 19:28</char></note><verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />जौ बौ समाधान है जो मोकै दई है “चौथौ जानवर एक चौथौ राज्य है जो धरती मैं होगो और दुसरे सब राज्यन से अलग होगो। बौ पूरी पृथ्वी कै कुचल देगो और रौंद डारैगो। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />दस सींग दस राजा है जौ बौ राज्य मैं राज करैगो। तौ एक और राजा सामने आगो; बौ पहले राजन से अलग होगो और तीन राजन के ऊपर राज्य करैगो। <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />बौ महासक्तिसाली परमेस्वर के ताहीं बोलो और परमेस्वर के लोगन कै सताए करैगो। बे उनके धार्मिक कानून और त्योहारन कै बदलन की कोसिस करैगो, और परमेस्वर के लोग साढ़े तीन साल तक उनके हातन मैं सौंपैगो।<note caller="+" style="f"><char style="fr" closed="false">7:25 </char><char style="ft" closed="false">प्रका. 13:6,7</char></note> <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />पर, जब न्याय करन बारे बैठंगे और बाकी प्रभुत्ता छीनकै मिटाई और पूरी तरह से नास करी जागी, हिंयाँ तक कि बाको अंत ही होगो। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />धरती मैं सब राज्यन की सक्ति और महानता परमेस्वर के पवित्र लोगन कै दई जागी। बाकी साही सक्ति कभी खत्म नाय होगी, और धरती के सब राजा बाकी सेबा करंगे और बाकी आग्या को पालन करंगे।”<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="ft" closed="false">प्रका. 11:15</char></note><verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />बात हिंये खतम ही गई, मैं दानिय्येल अपने बिचारन से बड़ा परेसान रहौं और मेरो मोहों पेरो पड़ गौ रहै, लेकिन मैं बात अपने तक ही रखो।<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">दानिय्येल कै भेंड़ा और बकरा को दर्सन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />बेलसस्सर के राज्यकाल के तिसरे साल मैं दानिय्येल कै एक दर्सन आओ, जो मोकै पहले दर्सन के बाद दिखाई दई। <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />दर्सन मैं अचानक अपने आप कै एलाम प्रांत के सूसा सहर मैं ठाड़ो पाओ। जो मैं उलाई नदिया के किनारे ठाड़ो रहौं, <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />और बौ नदिया के किनारे मैं एक भेंड़ा देखो, जोके दुई लम्बे सींग रहैं, और दुसरे नया सींग पहलो से लम्बे निकरत होत हैं। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />मैं भेंड़ा के अगार, पछार, सीरे, तरिहाँए के घाँईं अपने सींग से चिल्लात भई देखो। कोई भी जानवर बाकै रोक नाय सकत रहै और बाकी सक्ति से बच नाय सकथै। बौ जैसो चाहत रहै बैसोई अपनी इच्छा से करी और बाकै घमंड आयगौ।<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />जब मैं सोचत रहौं कि जाको का मतलब है, एक बकरा पछार के घाँईं से इतनी जोर से दौड़त व चिल्लात भई आओ, और बाके पाँव धरती कै नाय छुई पात रहैं। बाकी आखिंन के बीच एक सींग रहै। <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />बौ भेंड़ा के घाँईं आओ, जोकै मैं नदिया के किनारे खड़ो देखो रहौं, और बौ अपनी पूरी ताकत से बाके ऊपर झपटो। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />मैं बौ भेड़ा कै लड़त भई देखो। बौ इतनो गुस्सा मैं रहै कि बौ बासे लड़ पड़ो और बाके दोनो सींग तोड़ दई। भेंड़ा मैं लड़न की ताकत नाय रहै। बाकै धरती मैं गिराय दई और रौंद दईं, और बाकै बचान बारो कोई नाय रहै।<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />बकरा गजब घमंडी होत गौ, फिर अपनी सक्ति के चक्कर मैं बाकी बड़ी सींग टूट गई। बाके जघा मैं आसमान से चार और सींग आए, जो अलग अलग तराहनी के दिखात रहैं। <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />जे चार सींग मैं से एक छोटो सींग निकरो, जोकी सक्ति सीरे और अगार के घाँईं बादा करी भई जमीन के घाँईं बढ़ गई। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />बौ सींग बढ़ गौ और इतनो सक्तिसाली ही गौ कि स्वर्ग की सेना ले पहोंच गौ, और आसमानी तारा अपने आप धरती मैं गिरन लागे और बौ उनकै रौंद डारी। <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />जे स्वर्गीय सेना के राजकुमार कै भी लक्कारी, बाकै दौ जान बारो रोज बलिदान कै रोक दई और मंदिर कै नास कर दई। <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />और लोगन के अपराधन की बजह से बलिदान चढ़ान व सेना भी बाके हात मैं कर दौ गौ, और जमीनी धार्मिकता कै धूदर मैं रौंद दई। और सींग अपने हर काम मैं सच्चो और कामयाब ही गौ।<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />फिर मैं एक स्वर्गदूत कै दुसरे स्वर्गदूत से पूँछत भौ सुनो, “जे जौ बातन कै दर्सन मैं देखी, बे कब तक बने रहांगे? कब तक बुरो पाप रोज बलिदान लेगो? कब तक स्वर्ग की सेना और मंदिर कै रौंदो जागो?”<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">प्रका. 11:2</char></note><verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />मैं दुसरे स्वर्गदूत कै जबाब देत भई सुनो, “जे दुई हजार तीन सौ रात और सुबेरे तक होत रहैंगी, पर बाके जैसी बलिदान नाय चढ़ाओ जागो।”<verse eid="DAN 8:14" /></para>
  <para style="s">स्वर्गदूत जिब्राएल दर्सन की ब्याख्या करथै</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />मैं दानिय्येल, जौ समझन की कोसिस करत रहौं कि बौ दर्सन को का मतलब रहै, तभई अचानक कोई मेरे अग्गू खड़ो हीगौ। आदमी के रूप धरो भौ मेरे अग्गु ठाड़ो भौ दिखाई पड़ो और अग्गू ठाड़ गौ <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />मैं उलाई नदिया के ऊपर एक आदमी की आबाज सुनो, “जिब्राएल, बौ का देखी बाको मतलब समझाबौ।” <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />जैसिये जिब्राएल बौ जघा के झोने आओ जितै मैं ठाड़ो रहौं, मैं डराएगौ और मोहों के बल गिर पड़ो।</para>
  <para style="p" vid="DAN 8:17">बौ मोसे कही, “आदमी को लौड़ा, समझ ले कि जौ दर्सन अंत के समय से सम्बन्धित है।”<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">दानी. 9:21</char></note> <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />जब बौ मोसे बात करत रहै, मैं बिहोस हीकै धरती मैं गिर पड़ो। फिर बौ मोकै पकड़ लई, मोकै मेरी टाँग मैं खड़ो कर दई, <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />और कही, “मैं तुमकै देखथौं कि परमेस्वर को गुस्सा को का नतिजा होगो। दर्सन खतम होन के बाद दर्साथै।”<verse eid="DAN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 8:20" />“तुम जो भेंड़ा देखे, बाके दुई सींग रहैं, बौ मादी और फारस के राजा कै दर्साथै।” <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />बकरा यावन के राज्य कै अगुवाई करथै, और बाकी आँखिन के बीच जो बड़ो सींग निकरो, बौ पहलो राजा ठहरो। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />पहलो सींग टूटन की जघा मैं जो चार सींग निकरे, बे चारौ राज्यन कै अगुवाई करथै, जो मैं बौ देस से अलग ही जागो और जो पहलो राज्य के हानी ताकत मैं मजबूत नाय होगो।<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />“जब बे राज्यन को दिन झोने आगो और बे जघा इतनो खतम ही जांगे कि बे उनकै दंड दौ जागो, तौ बौ एक जिद्दी, खराब और धोखेबाज राजा है। <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />बौ ताकतबर तौ ही जागो- लेकिन बाकी अपनी ताकत ना होगी। बौ भयानक रूप से नास करैगो और अपने सब काम मैं सफल होगो। बौ सक्तिसाली आदमी और परमेस्वर के अपने पवित्र लोगन कै नास करैगो। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />काहैकि बौ चलाँक है, बौ छल करन और अपनी कपटी चालन मैं सफल ही जागो। बौ अपने आप घमंड करैगो और बिना कोई चितौनी के सब लोगन कै नास कर देगो। बौ सबसे अच्छो राजा की भी बेसती करैगो, लेकिन बौ कोई भी आदमी सक्ति को उपयोग के बिना खतम ही जागो। <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />रात और सुबेरे के समय पुजारी के बारे मैं जो दर्सन तुमकै बताओ गौ है बौ पूरो होगो। लेकिन जाकै अभै मत बताबौ, का जाके सच होन मैं जाधा समय लग जागो।”<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />मैं दानिय्येल बड़ा दिन ले उदास और बीमार रहौं। जब मैं बिमारी से उठो और राजा के बौ काम मैं लौट गौ, लेकिन जो दर्सन देखो रहौं बासे मैं अचम्भित रहौं, काहैकि जाकै समझानबारो कोईये नाय रहै।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">दानिय्येल अपने लोगन के ताहीं प्रार्थना करथै</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />मादी दारा राजा जो छयर्स को लौड़ा रहै, बाकै कसदी जाति के ऊपर पहले साल मैं बेबीलोन राज्य को सासक बनाओ गौ। <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />सासनकाल के पहले साल कै दानिय्येल पवित्र किताबन को अध्ययन करत रहौं और सत्तर साल के बारे मैं सोचत रहौं कि यरूसलेम की जघा खंडर ही जागी, जैसो की प्रभु जो भविस्यवक्ता यिर्मयाह से कही रहै। <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />और मैं उपवास करकै, टाट ओढ़कै, और राख मैं बैठकै प्रभु परमेस्वर से अच्छे मन से प्रार्थना करो, और बासे बिनती करी।<verse eid="DAN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 9:4" />मैं अपने प्रभु परमेस्वर से प्रार्थना करो और अपने पापन कै मान लौ।</para>
  <para style="p" vid="DAN 9:4">मैं कहो, “प्रभु परमेस्वर, तू महान है और हम तेरो आदर करथैं तू अपने वाचा मैं ईमानदार है, और तू बे लोगन ऊपर अपनो प्रेम दिखाथै जो तोरे भय मानथैं और तेरी आग्यन को पालन करथैं।”<verse eid="DAN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 9:5" />“हम पाप करैं हैं, हम पापी हैं, हम बगावत करैं हैं। तू जो कुछ हमैं करन की आग्या देथै, बाकै हम ठुकराए दै, और जो कुछ तू हमैं ठीक बताओ है, बासे हम भटक गै हैं।” <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />हम तेरे दास भविस्यवक्तन की नाय सुनी, जो तेरे नाओं से हमरे राजन, हाकिमन, पुरखन, हमरी सब जाति से बात करथैं। <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />हे प्रभु, तू धर्मी है, लेकिन आज हम लज्जित हैं, यहूदा के आदमी, और यरूसलेम के निवासी, और सब इस्राएल, का झोने के का दूर के, बे सब देसन मैं जहाँ तू हमकै हमारे विस्वासघात की बजह से तितर-बितर कर दौ है, बे सब लज्जित होंगे। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />हे प्रभु, हमरे राजा, हमरे सासकन, और हमरे पूर्वजन के विरूद्ध गलत काम करी रहै और पाप करी रहै जौ कारँड़ हमकै लज्जित होन पड़ो। <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />हमरो दयावान और छमा करन बारो है, हम अपने प्रभु परमेस्वर के खिलाप बगावत करे हैं। <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />हे हमरो परमेस्वर यहोवा, जब तू हमसे कहो, कि जौ व्यवस्था तू अपने दास भविस्यवक्तन के जैसी दौ है, बाके जैसी जिन्दगी जीन कै कही, तौ हम अपने परमेस्वर की नाय सुने।<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">2 राजा. 18:12</char></note> <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />सब इस्राएली तेरी बातन के नियम कै नाय मानी, और तेरी बातन कै सुनन से मना करी। हम तेरे खिलाप पाप करे, और परमेस्वर हमैं बौ स्राप दौ जो तेरो दास मूसा की व्यवस्था मैं लिखो है। <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />तू हमरे ऊपर बड़ी विपत्ती लाएकै हमरे और हमरे अधिकारिन के खिलाप कहो भै वचन पूरो करो हौ। पूरे स्वर्ग के नीचे कभी भी ऐसो कछुवे नाय करो गौ जैसो यरूसलेम के संग करो गौ। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />हम मूसा की व्यवस्था मैं सब दंड देत रहैं। फिर अभै भी, हे यहोवा, हमरो परमेस्वर, हम अपने पापन से फिरकै, तेरे सत्य मैं चलंगे और तोकै खुस करन की कोसिस नाय करंगे। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />हे हमरे परमेस्वर यहोवा, तू हमकै दंड देन कै तैयार रहै, और तू बैसो ही करो, काहैकि तू धर्मी के ताहीं हमेसा सई ही करथै, लेकिन हम तेरी नाय सुनथैं।<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />“हे हमरे प्रभु परमेस्वर, तू अपने लोगन कै अपने बलबान हातन से मिस्र से निकार कै अपनो नाओं करो है, और जो आज तक बौ एक यादगार है। लेकिन हम पाप करे हैं; और हम दुस्टता के काम भी करे हैं।” <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />प्रभु हमरे बीते समय मैं हमरी रक्छा करी है, तभई अब तुम यरूसलेम ऊपर से अपनो गुस्सा हटाए ले। जौ तुमरो सहर, तुमरो पवित्र पहाड़ है हमरे पापन और हमरे पूर्वजन जैसी करे गै रहैं बुरे कामन के ताहीं पड़ोसी देसन के सब लोग यरूसलेम और तुमरे लोगन कै खराब समझत रहैं। <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />हे प्रभु, अपने दास की प्रार्थना और विनती कै सुन। अपने मंदिर कै दुबारा से बना जो उजाड़ पड़ो है; ताकी सब कोई जान पामैं कि तहीं प्रभु है। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />हमरी बात सुनौ, हे प्रभु; हमरे घाँईं देखौ कि हम कोई मुसीबत मैं हैं और बौ सहर की पीड़ा कै देखौ जो मैं तुमरो नाओं है। हम तुमसे प्रार्थना कर रहै हैं काहैकि तुमरी धार्मिकता के कामन मैं नाय बल्किन तुमरी बड़ी दया के कामन मैं भरोसो रख कै करथैं। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />प्रभु हमरी सुनौ। प्रभु हमकै छमा करौ। प्रभु हमरी बात सुनौ, और काम करौ! जो से सब जान पामैं कि तू परमेस्वर है, तू चिंता मत करै! जौ सहर और जे लोग तुमरे हैं।<verse eid="DAN 9:19" /></para>
  <para style="s">जिब्राएल भविस्यवाँड़ी की व्याख्या करथै</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />मैं प्रार्थना करत रहौं, और अपने पापन और अपनी प्रजा इस्राएल के पापन कै माने करत रहौं और अपने परमेस्वर यहोवा से बाके पवित्र पर्वत के ताहीं गिड़गिड़ाएकै विनती करत रहत रहै। <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />जब मैं प्रार्थना करत रहौं, जिब्राएल, जो मैं पहले दर्सन मैं देखो रहौं, उड़कै उतै आए गौ जितै मैं रहौं। जौ संजाखिन कै बलि चढ़ान को समय रहै।<note caller="+" style="f"><char style="fr" closed="false">9:21 </char><char style="ft" closed="false">लूका. 1:19</char></note> <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />उनकै समझाईं, “दानिय्येल, मैं भविस्यवाँड़ी कै समझन मैं तुमरी मदद करन के ताहीं इतै आओ हौं। <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जब तुम परमेस्वर से विनती करन लगे, तौ बौ तुमकै जबाब दई। बौ तुमसे जाधा प्यार करथै, और तभई मैं तुमकै जाको जबाब बतान आओ हौं। अब जब मैं दर्सन समझाथौं तौ ध्यान दियो।”<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />“तुमरे लोगन और तुमरे पवित्र नगर कै पाप और बुराई से मुक्त करन के ताहीं परमेस्वर जौ समय ठहराई रहै बौ सात गुना सत्तर साल हैं।” पाप माफ कर दौ जागो ताकी दर्सन और भविस्यवाँड़ी सच ही जाबै, और पवित्र मंदिर फिर से सौंप दौ जागो। <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />जा मैं ध्यान देबौ और जाकै समझौ: जब से यरूसलेम कै बनान को आदेस दौ गौ है तब तक परमेस्वर को चुनो भौ नेता नाय आगो, सात गुना सात साल बीत जांगे। यरूसलेम रास्ता और मजबूत सुरक्छा के संग फिर से बनाओ जागो, और सात गुना बासठ साल तक खड़ो रहागो, लेकिन जौ मुसीबत को समय होगो। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />और बासठ सप्ताह के बीतन के बाद परमेस्वर को चुनो भौ नेता कै दुसरे लोगन से मर दौ जागो। एक सक्तिसाली राजा की भयानक सेना जैसी सहर और मंदिर कै खत्म कर दौ जागो। बाद मैं बाढ़ के जैसी आगो, जो लड़ाई और विनास लागो जो परमेस्वर तैयार करी है। <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />बौ सासक सात साल तक बहोत लोगन के संग वाचा बाँधैगो, और जब जौ आधो समय बीत जागो, तौ बौ बलिदान और भेंट बन्द कर देगो। घिनौनो दिखान बारो मंदिर के सबसे ऊपर जघा मैं रखो जागो और बौ तब तक उतई रहागो जब तक बाकै उतै रखन बारो कै खत्म नाय ही जातो और जो प्रभु बाके ताहीं तैयार करी है।<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">टाइग्रिस नदिया जैसी डेनियल को दर्सन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />तीसरो साल जब कुस्रू फारस को राज रहै, दानिय्येल कै, जाकै बेलतसस्सर भी कहथैं, एक संदेस अग्गू आओ। संदेस सच्चो रहै लेकिन समझनो बड़ा कठिन रहै। बौ एक दर्सन के जैसी समझाओ गौ।<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />बे दिनन, मैं दानिय्येल, तीन हप्ताह ले सोक करत रहो। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />तीन सप्ताह बीत जान के बाद मैं कोई दुसरो खानु या कोई मास नाय खाओ, कोई दाखरस नाय पियो, और अपने बारन मैं कंघा तक नाय डारो।<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />साल के पहले महेना के चौबीसमें दिन, मैं सबसे बड़ी हिद्देकेल नाओं की नदिया के किनारे ठाड़ो रहौं। <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />तौ मैं नजर उठाएकै देखो, कि मलमल को लत्ता पहने भै, और अच्छे सोने को पट्टा पहने भौ एक आदमी जमीन मैं ठाड़ो है।<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">प्रकासितवाक्य 1:13</char></note> <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />बाकी सरीर रत्न के जैसी चमक रहै। बाको मोहो बिजली की रोसनी के जैसी चमकत रहै, और बाकी आँखी आगी के जैसी चमकत रहैं। बाके हाथ और टाँग चमकत भै पीतर के जैसी चमकत रहैं, और बाकी आवाज बड़ी भीड़ की दहाड़ के जैसी रहै।<verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />मेरे संग कुछ आदमी रहैं। उनकै जौ दर्सन दिखाई ना दई, जौ दर्सन खाली मैं दानिय्येल देखो। पर बे कांपन लगे, और लुकन के ताहीं भाज पड़े। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />मैं अकेलो रह गौ, और मैं जौ महादर्सन देखो। पर दर्सन देखन के बाद मेरे मैं ताकत नाय बची। मेरो दमकत भई वैभव डर के मारे सूख गौ, और मैं कमजोर हुई गौ। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />जब मैं बाकी आवाज सुनो तौ मैं बेहोस हुईकै जमीन मैं मोहों के बल गिर पड़ो। <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />तौ एक हाथ मोकै पकड़कै मेरे हातन और घुंटो तक उठा लई; मैं अभै भी काँपत रहौं।<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />देवदूत मोसे कहीं, “दानिय्येल, प्रभु तुमसे प्यार करथै। अपनी जघा मैं खड़े ही जाबौ और जौ मैं कहेन जाए रहौं हौं बाकै अच्छे से सुनौ। मोकै तुमरे झोने भेजो गौ है।” जब बौ जौ कही, तौ मैं खड़ो हीगौ, तब भी काँपत रहौं।<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />फिर बौ कही, “दानिय्येल, मत डरा। प्रभु तुमरी प्रार्थना तब से सुनी है जब पहले दिन से अपनो समझकै हासिल करन के ताहीं खुद कै विनम्र बनान को फैसला करी। मैं तुमरी प्रार्थना के उत्तर मैं आओ हौं।<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">दानी. 12:1</char></note> <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />फारस के राज्य के स्वर्गदूत राजकुमार इक्कीस दिन तक मेरो विरोध करी। तब मीकाएल, मुख्य स्वर्गदूतन मैं से एक, मेरी मदद करन के ताहीं आओ, काहैकि मैं फारस के राजन के झोने अकेलो रहै गौ रहौं। <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />और अब मैं तोकै समझान आओ हौं, कि अंत के दिनन मैं तेरे लोगन की का दसा होगी। काहैकि जौ दर्सन तू देखो है, बौ कुछ दिनन के बाद पुरो होगो।”<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />जब बौ जौ कही तौ मैं मजबूत हीकै धरती के घाँईं मोहों करकै देखन लगो और चुप रहै गौ। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />तौ आदमी के जैसी दिखान बारो देवदूत अग्गू बढ़ो और मेरे ओंठ कै छुई। मैं बासे कहो, “गुरुजी, जौ दर्सन मोकै ताकत मैं इतनो कमजोर बनाए देथै कि कांपनो बंद नाय कर पाथौं।<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">यिर्म. 1:9</char></note> <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />मैं बौ दास के जैसी हौं जो अपने प्रभु के अग्गू खड़ो है। मैं तुमसे कैसे बात कर सकथौं? मेरे झोने न ताकत बची है और न ही सांस।”<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />तभई आदमी के तराहनी कोई छुइकै फिर मेरो हियाव बाँधी। <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />बे कहीं, “हे परमेस्वर को प्रिय, मत डराबै, तोकै सांति मिलै; तू मजबूत हो और तेरा हियाव बाँधे रहै। तब मैं बासे जौ कहो, हे मेरे प्रभु, मोए बता तेरोअब का कहनो है, काहैकि तू मेरो हियाव बाँधो है।”<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">यसा. 41:10</char></note><verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />बौ कही, “तू तौ जानथै कि मैं तेरे झोने काहे आओ हौं। पर अब मोकै फारस के प्रधान से लड़न के ताहीं लौटन नाय होगो। जब मैं बासे निपट चुकंगो, तौ यावन को स्वर्गदूत आगो।” <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />और जो कुछ भी सच्ची बात किताब मैं लिखी भईं हैं, मैं तुमकै बताथौं। इस्राएल को प्रधान स्वर्गदूत मीकाएल के अलावा मेरी मदत करनबारो कोईये न है।<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />दारा नाओं को मादी राजा के राज्य के पहले साल मैं बाकी मदत करन और बल देन के ताहीं मैं खड़ो ही गौ।<verse eid="DAN 11:1" /></para>
  <para style="s">मिस्र और सीरिया को राज्य</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />और अब जो मैं तुमकै बतान जाए रहौ हौं बौ सच है।</para>
  <para style="p" vid="DAN 11:2">स्वर्गदूत कहीं, “तीन राजा फारस मैं राज्य करंगे, बाके बाद चौथौ राजा होगो, जो जे तीनौ से जाधे सेठ होगो। तभई अपनी सक्ति और सेठ के बजह से यावन राज्य कै चितौनी देगो।”<verse eid="DAN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3" />बाके बाद एक पराक्रमी राजा उठकै अपनो राज्य बड़ा जोर बढ़ागो, और अपनी इच्छा के जैसी ही काम करैगो। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />बाके उभरन के बाद बाको साम्राज्य टूट जागो और स्वर्ग की चार दिसन मैं बट जागो। जौ बाके वंसजन के झोने नाय जागो और न ही बामैं बौ सक्ति होगी जो बौ इस्तमाल करी रहै, काहैकि बाको साम्राज्य उखाड़कै दुसरे कै दै दौ जागो।<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />“तौ तरिहाँए दिसा से मिस्र देस को राजा बड़ा ताकतबर होगो पर बाको एक सेना अधिकारी बासे जाधा ताकतबर हीकै राज्य करैगो; हिंयाँ तक कि बाको राज्य बड़ो ही जागो।” <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />कुछ सालन के बाद बे सहयोगी बन जामंगे। तरिहाँए दिसा के राजा की लौड़िया गठबंधन करन के ताहीं सीरे दिसा के राजा के झोने जाबैगी, पर बौ अपनी सक्ति कै बरकरार नाय रखैगी, बौ और बाकी सक्ति नाय टिकैगी। बे दिनन मैं बाके संग, बाकी साही मरम्मत और बाके दऊवा और जो बाको समर्थन करी रहै, बाके संग विस्वासघात करकै मार दौ जागो। <verse eid="DAN 11:6" /><verse number="7" style="v" sid="DAN 11:7" />फिर जाके बाद बाको एक हितुआ राजा बनैगो। बौ सीरे के राजा के सेना मैं लड़ाई करैगो, बाके गढ़ मैं जागो और उनकै हराए देगो। <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />परमेस्वर उनके देवतन, धातु की मूर्तियन और चाँदी और सोने की उनकी मूल्यवान चीजन कै जब्त कर लेगो और उनकै मिस्र लै जाबैगो। और कुछ सालन के ताहीं बौ सीरे दिसा के राजा कै अकेलो छोड़ देगो। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />तौ सीरे दिसा को राजा तरिहाँए दिसा के राजा के राज्य मैं लड़ाई करैगो, फिर अपने देस मैं लौट जाबैगो।<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />“सीरिया के राजा को लौड़ा लड़न की तैयारी करंगे और एक बड़ी सेना जुरागी। बामैं से एक बाढ़ के जैसी अग्गू बढ़ैगो और दुस्मन के किलन मैं हमला करैगो।” <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />अपने गुस्सा मैं मिस्र को राजा सीरिया के राजा के विरुद्ध लड़ाई करन के ताहीं बड़ी भीड़ इकट्ठी करैगो और बौ भीड़ बाके हात मैं कर दई जागी। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />जब सेना चली जाबैगी, तौ दछिड़ को राजा घमंड से भर जाबैगो और हजारन लोगन कै मार डारैगो, फिर भी बौ विजयी नाय रहगो।<verse eid="DAN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13" />काहैकि उत्तर को राजा दुसरी सेना इकट्ठी करैगो, जो पहले से भी बड़ी होगी; और कई सालन के बाद, बौ पूरी तरहन से पूरे सामान के संग एक विसाल सेना के संग अग्गू बढ़ैगो। <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />बे दिनन मैं बहोत से लोग दछिड़ देस के राजा के बिरोध मैं उठंगे; और तेरे लोगन मैं से भी उपद्रवी लोग उठ खड़े होमंगे, जोसे जौ दर्सन कि बात पूरी ही जाबैगी; पर बे ठोकर खाएकै गिर पड़गे। <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />तौ उत्तर को राजा आएकै घेराबंदी करैगो, और गढ़बारे नगर मैं अधिकार लेगो। दछिड़ की सेना बिरोध करन मैं सक्तिहीन होगी; हिंयाँ तक की उनकी महान सेना मैं भी ठाड़े होन की ताकत नाय होगी। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />सीरियाई लड़न बाके संग बिना कोई बिरोध के जैसी चाहे बैसिये करैगो। बौ वादा करैगो देस मैं खड़ो होगो और जाकै अपनी इच्छा से सब तराहानी से अपने हाथ मैं रखैगो।<verse eid="DAN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17" />“सीरिया को राजा अपनी सब सेना को उपयोग करकै एक काम की योजना बनागो। तौ बौ अपने दुस्मन के राज्य कै नुकसान करन के ताहीं बाके संग मिलैगो, और अपनी लौड़िया को बिहा बासे करैगो; लेकिन बाकी योजना सफल नाय होगी।” <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />बाके बाद बौ समुद्र टापू के किनारे देसन मैं लड़ाई करैगो और बामैं से भौतन कै जीत लेगो। फिर एक विदेसी नेता बाकै हराए देगो और बाके घमंड कै खत्म कर देगो; सच्ची बौ अराम के राजा को घमंड बामैं लौटार देगो। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />तौ बौ अपने देस के गढ़न के घाँईं मोहों फेरैगो, और बौ ठोकर खाएकै गिरैगो, और कहीं बाको पता नाय रहेगो।<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />उनको उत्तराधिकारी साही वैभव कै बनाए रखन के ताहीं एक अधिकारी कै भेजैगो। भलेई कुछ सालन मैं बौ नस्ट ही जागो, फिर भी गुस्सा या लड़ाई करे बिना बौ मारो जाएगो।<verse eid="DAN 11:20" /></para>
  <para style="s">सीरिया को दुस्ट राजा</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />स्वर्गदूत समझात भई कही: “सीरिया को दुसरो राजा एक खराब आदमी होगो जोकै राजा बनान कोई अधिकार नाय है, लेकिन बौ एक बिना रुप से आगो और छल और वैभव से सत्ता मैं कब्जा कर लेगो।” <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />जो कोई बाकी वाचा को विरोध करैगो, हिंयाँ तक की परमेस्वर के राजा और सेना कै भी कुचल डारैगो और उनकै नास कर दौ जाएगो। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />जोसे भी बौ वाचा उठाएगो, बौ दुसरे देसन कै भी धोखा देगो, और बौ और जाधे मजबूत होत जागो, भलेई बौ खाली एक छोटे राज्य मैं सासन करत होबै। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />बौ बिना कोई चेतावनी को एक समृद्ध प्रांत मैं लड़ाई करैगो और ऐसो काम करैगो, जो कि बाके पूर्वजन मैं से भी कोई नाय करो होगो। फिर बौ लड़ाई मैं कब्जा करे भै माल और संपत्ति कै अपने लोगन के बीच बाँट देगो। बौ गढ़न मैं हमला करन की योजना बनागो, लेकिन बाको समय जल्दी खत्म ही जागो।<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />“बाके बाद बौ अपनी ताकत और अपने साहस के बजह से इनतो उत्तेजित होगो की बौ एक बड़ी सेना कै लैकै मिस्र देस मैं हमला कर देगो। मिस्र देस को राजा भी महाविसाल सेना के संग लड़ाई मैं बाको सामना करैगो, लेकिन बौ बाके सामने टिक ना पागो; काहैकि बाके खुद के देस मैं बाके खिलाप चाल चली जांगी।” <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />हिंयाँ ले कि बे लोग जो बाके संग खानु-खान बारे हैं, बाकै हरबांगे, बाकी सेना नास हुई जागी, तमान सिपईय्या मौत के घाट उतार दै जांगे। <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />तौ बे दोने राजन के मन बुराई करन मैं लगंगे, हिंयाँ ले कि बे एकै मेज मैं बैठे भै आपस मैं झूठ बोलंगे, पर बासे कोई फायदा ना होगो; काहैकि जे सब बातन को अंत चुने गै समय मैं होन बारो है। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />सीरिया देस को राजा सब लूट के संग अपने देस लौटैगो, और परमेस्वर के लोगन के धर्म कै खत्म करन के ताहीं पवित्र वाचा के खिलाप होगो। बौ जैसो चाहबै बैसो करैगो और फिर अपने देस कै लौट जागो।<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />“ठहराए भै समय मैं बौ फिर से मिस्र मैं लड़ाई करैगो, लेकिन अबकी बार चीज अलग होगी।” <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />काहैकि कित्ती के जहाज बाके खिलाप आंगे, और बौ जघा से उदास हुईकै लौटैगो, और पवित्र वाचा से चिड़कै अपनी इच्छा पूरी करैगो। बौ लौटकै पवित्र वाचा कै तोड़न बारेन की सुधि लेगो।<verse eid="DAN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 11:31" />बाके कुछ सिपईय्या मंदिर कै अपवित्र कर देंगे। बे हर दिन के बलिदान कै बंद कर देंगे और बे उजाड़न बारे घिनौनी चीज कै खड़ो कर देंगे। <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />छल से राजा बे लोगन को समर्थन जीत लेगो जो पहले वाचा कै छोड़ दईं हैं, लेकिन जो लोग प्रभु कै जानथैं, बे जबाब दैकै बगावत करंगे। <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />लोगन के ग्यानी नेता अपनो ग्यान कै दुसरे लोगन के संग साझा करंगे। फिर कुछ समय के ताहीं बामैं से कुछ लड़ाई मैं तलवार से मारे जांगे और जलाए कै मार डारंगे, और कुछ कै लूट लौ जागो और बंदी बनाए लौ जागो। <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />जब बे गिरंगे तौ उनकै सम्भलन मैं थोड़ी मदत मिलैगी, उनके जो लोग इमानदार ना हैं, बे भी उनके संग सामिल हुई जांगे। <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />बे बुध्दिमान लोग भी ठोकर खांगे, ताकि बे अंत ले सुध्द और पवित्र और निस्कलंक बने रहा मैं, काहैकि बौ ठहराए भै अंत के समय मैं ही होगो।<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />“राजा अपनी इच्छा से काम करैगो, बौ अपने आप कै सब देवतन से ऊँचो उठागो और बड़ो करैगो, और देवतन के परमेस्वर के विरोध मैं अनसुनी बात कहगो।” गुस्सा को समय पूरो होन तक बौ सफल रहगो, काहैकि जो ठान लौ गौ है बौ पूरो होने ही है। <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />प्रभु अपने पुर्खन के देवतन की परवाह भी ना करैगो और न बईंय्यरन के प्रिय देवतन की। और न कोई भी देवता की परवाह करैगो, काहैकि बौ समझ मैं खुदकै सब देवतन से ऊपर बड़ो ठहरागो। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />काहैकि, बौ किलन की रक्छा करन बारे देवता को आदर करैगो। बौ देवता को सोनो, चाँदी, जवाहरात और दुसरे उपहार चढ़ागो जोकी बाके पुरखा कभी अराधना नाय करीं रहैं। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />अपने किलन की रक्छा के ताहीं, बौ बे लोगन को इस्तमाल करैगो जो एक विदेसी देवतन की अराधना करथैं। और बे लोगन को बड़ा आदर करैगो जो बाकै सासक के तराहनी मानथैं, बौ उन्हैं बड़े पद मैं बैठारैगो, और उनकै ईनाम के रुप मैं जमीन भी देगो।<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />“जब सीरिया के राजा को आखरी समय लगभग आए जागो, तौ मिस्र को राजा बामैं लड़ाई करैगो, और सीरिया को राजा रथ, घोड़न और निरे जहाजन को इस्तमाल करकै अपनी सब सक्ति से हमला करैगो। बौ बाढ़ के पानी के जैसी सब देसन मैं बहे जागो। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />बौ वादा करे गै सुगड़ देस मैं भी हमला करैगो, और हजारौं लोगन कै मार डारैगो, लेकिन एदोम, मोआब और अम्मोन देस बाके हाथ से बच जांगे। <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />जब बौ बे सब देसन मैं हात बढ़ाबै गो, तौ मिस्र भी नाय बचैगो। <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />बौ मिस्र देस को सोनो, चाँदी और का लुको भौ खजाना को मालिक बन जाएगो। बौ लीबिया और इथियोपिया मैं जीत हाँसिल करैगो। और बे लोग बाके पिच्छू ही जामंगे। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />लेकिन अगार और सीरे दिसा के समाचार बाकै घबड़बाए देमंगे, और बौ बड़े गुस्सा मैं बहोतन कै नस्ट करन के ताहीं निकर पड़ैगो। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />बौ समुद्र और बौ पहाड़ के बीच जो मैं मंदिर खड़ो है, अपनो गजब बड़ो साही तम्बू भी खड़ो करैगो। फिर बौ मर जागो, और बाकी मदत करन बारो कोई नाय होगो।”<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">अंत को समय</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />मलमल लत्ता पहने भै स्वर्गदूत कहीं, “बौ समय महान स्वर्गदूत मीकाएल, जो तुमरे लोगन की रक्छा करथै, सामने आगो। तौ मुसीबत को समय आगो, जो देसन के पहली बार मैं आन के बाद से सबसे बुरो समय होगो। जब बौ समय आगो, तौ तुमरे राज्यन के सब लोग जिनके नाओं परमेस्वर की किताब मैं लिखे हैं, बचाए जांगे।<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">मत्ती 24:21; मरकुस 13:19; प्रकासितवाक्य 7:14; 12:7</char></note> <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />जो लोग पहलिये मर चुके हैं बामैं से कई फिर से जिन्दे होंगे: कुछ अनन्त जिंदगी को आनंद लेंगे, और कुछ कै अनन्त अपमान सहने होगो।<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">यूहन्ना 5:28,29</char></note> <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />जो बुध्दिमान नेता हैं, बे आसमान के उजियारो के तराहनी चमक चमकंगे, और जो भौतन कै धर्मी बनात हैं, बे हमेसा तारन के तराहनी चमकन लगंगे।”<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">मत्ती 13:43</char></note><verse eid="DAN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4" />पर हे दानिय्येल, “तैं किताब कै सई से बंद करकै सब्दन कै अंत तक के ताहीं मोहरबंद कर दे। काहैकि तमान लोग ग्यान बढ़ान के ताहीं इतै-उतै जांगे।”<verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />जब मैं, दानिय्येल नजर उठाएकै का देखो कि दुई आदमी ठाड़े हैं, एक तौ नदिया के जौ तट मैं, और दुसरो नदिया के बौ तट मैं है। <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />उन मैं से एक बौ मलमल के लत्ता पहने भै आदमी से, जो नदिया के पानी के ऊपर रहै, बासे कही, “जौ अचम्भित बात पूरी होन मैं कित्तो समय लगैगो?”<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />मलमल के लत्ता पहने भौ स्वर्गदूत अपने दोनो हात आसमान के घाँईं उठाई और अनन्त परमेस्वर को नाओं लैकै वादा करी। मैं बाकै जौ कहत भई सुनो, “साढ़े तीन साल ही जामंगे, तौ परमेस्वर के लोगन को दुख खतम ही जागो, तभई सचमुच जे सब बात पूरी होंगी।”<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">प्रकासितवाक्य 10:5-7</char></note><verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />मैं सुनो कि बौ का कही, लेकिन मैं बौ समझ नाय पाओ। तौ मैं पूँछो, “लेकिन गुरुजी, जौ सब कैसे खत्म होगो?”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />बौ जबाब दई, “तुमकै अब जाने होगो, दानिय्येल, के जे सब्द अंत समय आन तक बन्द और इन मैं मुहर दई भई है। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />बहोत लोग खुदकै सुद्ध, और बेदाग और बनांगे, पर दुस्ट लोग दुस्टै बने रहमंगे। दुस्टन मैं से कोई नाय समझैगो, पर बुध्दिमान लोग समझंगे।<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">प्रका. 22:11</char></note><verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />जब जे रोजाना की होमबलि उठाई जान बारी रुक जामंगी, जो घिनौनी चीजन कै उजाड़ कर देथै, स्थिर करी जागी, तभई बारह सौ नब्बै दिन बीत चुके होमंगे। <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />धन्य है बे जो 1335 दिन पूरे होन तक वफादार बने रहथैं!<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />अब तू जाएकै अंत तक ठहरो रहिए; और तू विसराम करत रहेगो; और बे दिनन के अंत मैं तू अपने निजी भाग मैं खड़ो होगो।”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>