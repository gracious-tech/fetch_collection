<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Rana Tharu</book>
  <para style="h">2 यूहन्ना</para>
  <para style="toc3">2 यूहन्ना</para>
  <para style="toc2">2 यूहन्ना</para>
  <para style="toc1">यूहन्ना की दुसरी चिट्ठी</para>
  <para style="mt2">यूहन्ना की दूसरी चिट्ठी</para>
  <para style="mt1">यूहन्ना की दुसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">1 यूहन्ना की चिट्ठी प्रेरित यूहन्ना के जरिये मसीह के जनम के 50 से 100 सालन के बीच लिखी गई रहै। यूहन्ना खुदकै लेखक के रूप मैं नाय पहचानथै, जाके बजाय बौ खुदकै सबसे बड़ो-बूढ़ो कहथै। 2 यूहन्ना को जो संदेस है बौ यूहन्ना सुसमाचार से काफी मिलथै-जुलथै। जौ खास रूप से साफ है जो तरह से बौ एक दूसरे से प्रेम करन के ताहीं ईसु की आग्या पर जोर देथै और जौ तरह से बौ ईसु से प्रेम करन की बराबरी बाकी आग्यन को पालन करन के संग करथै <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char>, <char style="xt"><ref loc="JHN 15:9-10">यूहन्ना 15:9-10</ref></char>। ऐसो मानो जाथै कि यूहन्ना इफिसुस मैं रहत भै यूहन्ना और तीन पत्‌री 1 यूहन्ना, 2 यूहन्ना और 3 यूहन्ना के अनुसार द गौस्पल लिखी रहै। यूहन्ना जौ चिट्ठी कै चुनी भइ बईय्यर और बाके बालकन कै संबोधित करी। बौ सायद एक कलीसिया की बात कर रहो है। जौ चिट्ठी कै लिखन मैं यूहन्ना को उद्देस्य कलीसिया कै प्रोत्साहित करनो और उनकै झूठे सिक्छकन से चहाचीतो करनो रहै।</para>
  <para style="iot">रूपरेखा:</para>
  <para style="io1">1. यूहन्ना जौ कहकै चिट्ठी को परिचय देथै कि जौ कौनके ताहीं है और जाके लेन बारेन को अभिवादन करकै। <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. फिर बौ कलीसिया कै प्रोत्साहित करथै और उनकै सबसे बड़ी आग्या की याद दिलाथै। <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref> </char></para>
  <para style="io1">3. जाके बाद, बौ उनकै झूठे सिक्छकन के बारे मैं चितौनी देथै। <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">4. यूहन्ना अपनी चिट्ठी कै बौ कलीसिया के विस्वासिन से, जितै बौ रह रहो है, अभिवादन दैकै खतम करथै। <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>बड़े-बूढ़ेन के घाँईं से बे चुनी भइ बईंय्यरन और उनके बालकन के ताहीं, जोकै बाकई मैं प्रेम करथौं। और मैं सिरफ इकल्लो नाय हौं, बल्किन जो सच्चाई कै जानथैं, तुम सबन से प्रेम करथैं, <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>काहैकि सच्चाई आपन के भीतर है और हमेसा के ताहीं आपन के संग रहबैगी।<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>परमेस्वर दऊवा और दऊवा को लौड़ा ईसु मसीह हमैं अनुग्रह, दया और सांति देबै। और प्रेम और सच्चाई के जरिया जे सब बातैं हमरे संग रहबै।<verse eid="2JN 1:3"/></para>
  <para style="s">सच्चो प्रेम</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>मोकै जौ जानकै भौत खुसी भइ कि तुमरे कुछ बालका सच्चाई मैं चलथैं, जैसो कि दऊवा आपन कै आग्या दई रहै। <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>अब ओ बईय्यर, मैं तोकै कोई नई आग्या नाय लिखथौं; लेकिन बहे जो सुरु से हमरे झोने है, और तोसे नहोरे करथौं, कि हम एक दुसरे से प्रेम रखैं। <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>जो प्रेम की बात मैं कर रौ हौं, जाको मतलब जौ है कि आपन कै परमेस्वर की आग्यन मैं चलनो चाहिए। आग्या, जोकै तुम सबै सुरु से सुने रहौ, जौ है कि तुम सबन कै प्रेम से रहनों चाहिए।<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>काहैकि दुनिया भर मैं भौत से दगाबाज निकर आए हैं। जो लोग जौ मानन के ताहीं राजी नाय हैं, कि ईसु मसीह सरीर मैं हुईकै आओ रहै। ऐसे लोग एक दगाबाज और मसीह के दुस्मन है। <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>चहाचीते रहबौ, काहैकि जो तुम मेहनत से कमाए हौ बौ हराए ना जाबै, लेकिन ऐसो होबै कि तुमरो तोफा पूरी तरह से मिलै।<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>जो कोई भी मसीह की सिक्छा मैं नाय चलथै, लेकिन बासे अग्गु बड़नो चाहथै, बाके झोने परमेस्वर ना है। और जो कोई बाकी सिक्छा के संग रहथै बाके झोने दऊवा और लौड़ा दोनों होथैं। <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>अगर तुमरे झोने जहे तराहनी सिक्छा कै नाय लाथै, तौ बाकै अपने घरै बैठन मत दियो; “और ना बासे नमस्ते करियो।” <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>काहैकि जो कोई ऐसो आदमी कै नमस्ते करथै, बौ बहे के बुराई मैं भागीदार हुई जाथै जो बे करथैं।<verse eid="2JN 1:11"/></para>
  <para style="s">आखरी सब्द</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>मेरे झोने तुम्हैं बातन ताहीं भौत कुछ है, लेकिन कागज और स्याई से नाय लिखनो चाहथौं; जाके जघा, मैं तुमसे भेंटा करन की आसा करथौं, ताकी आपन पूरी तरह से खुस रहामैं। <verse eid="2JN 1:12"/><verse number="13" style="v" sid="2JN 1:13"/>तेरी चुनी भइ बहेनिया के बालका तोकै नमस्ते करथैं।<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
