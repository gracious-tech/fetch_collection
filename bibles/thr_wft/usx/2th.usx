<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Rana Tharu</book>
  <para style="h">2 थिस्सलुनीकियों</para>
  <para style="toc3">2 थिस्सलुनीकियों</para>
  <para style="toc2">2 थिस्सलुनीकियों</para>
  <para style="toc1">थिस्सलुनीकियों कै लिखी भइ पौलुस की दुसरी चिट्ठी</para>
  <para style="mt2">थिस्सलुनीकियों को लिखी हुई पौलुस की दूसरी चिट्ठी</para>
  <para style="mt1">थिस्सलुनीकियों कै लिखी भइ पौलुस की दुसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">थिस्सलुनीकियन सहर कै दुसरी चिट्ठी प्रेरितो पौलुस के जरिया लिखो गौ रहै <char style="xt"><ref loc="2TH 1:1">1:1</ref></char>। बौ जौ चिट्ठी ईसु के जनम के लमसम 51 साल के बाद 1 थिस्सलुनीकियन के तुरंत बाद लिखी गई रहै। पौलुस कुरिन्थ सहर मैं तब भी रहै जब बौ थिस्सलुनीके मैं कलीसिया कै जौ चिट्ठी लिखी रहै, एक कलीसिया जोकै बौ अपनी दुसरी मिसनरी सफर मैं बनाई रहै <char style="xt"><ref loc="ACT 17:1-10">प्रेरितो 17:1-10</ref></char>। जौ अधिनियम की किताब मैं कहो गौ है कि कलीसिया कुछ यहूदियन और कुछ यूनानियन से बनी रहै। थिस्सलुनीकियन कलीसिया को अंत काल और ईसु के दुबारा आन से जुड़ो होगो, काहैकि पौलुस थिस्सलुनीकियन कै लिखी अपनी चिट्ठी मैं जाके बारे मैं भौत कछु लिखी है। 2 थिस्सलुनीकियन को लमसम आधो समय खतम होथै। पौलुस आलस के खिलाप चितौनियो दै है। हर आदमी कै अपने खान के ताहीं काम करनो चहाईये। <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref> </char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. मैं अपनो और अपने संग बारेन को परिचय देत भै चिट्ठी की सुरुवात करी। <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. तौ बौ थिस्सलुनीकियन मैं कलीसिया के ताहीं परमेस्वर को धन्यवाद करथै और उनके ताहीं प्रार्थना करथै। <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">3. पौलुस आखरी समय के बारे मैं कहथै। <char style="ior"><ref loc="2TH 2">2</ref></char></para>
  <para style="io1">4. फिरौंकी बौ आलस और काम करन की जरूरत के खिलाप है। <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref> </char></para>
  <para style="io1">5. फिरौंकी पौलुस कलीसिया कै नमस्ते करकै खतम करथै। <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref> </char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेरितो 17:1</ref> </char>
    </note>पौलुस, सीलास और तीमुथियुस से थिस्सलुनीकियों मैं कलीसिया के लोगन के ताहीं, जो हमरे परमेस्वर दऊवा और प्रभु ईसु मसीह के हैं:<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />हमरे परमेस्वर दऊवा और प्रभु ईसु मसीह तुमकै अनुग्रह और सांति देत रहबै।<verse eid="2TH 1:2" /></para>
  <para style="s">मसीह को न्याय करन ताहीं आनो</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />हमरे भईय्यौ और बहेनियौ, हमकै तुमरे ताहीं हर समय परमेस्वर को धन्यवाद करनो चाहिए। हमरे ताहीं ऐसो करनो सई है, तुमरो बिस्वास बढ़त जाथै, और तुम्मैं से सबन को प्रेम दुसरेन के ताहीं जद्धे होत जाथै। <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />तभई हम खुदै परमेस्वर की कलीसिया मैं तुमरे बारे मैं घमंड करथैं कि जित्ते दुख और कलेस तुम सहथौ, उन सब मैं तुमरो सकारनो और बिस्वास दिखाई देथै।<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />जौ सब साबित करथै कि परमेस्वर को न्याय सई न्याय है और सिरफ तुम बाके राज्य के काबिल बनैगे, जोके ताहीं तुम दुख उठाए। <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />परमेस्वर बहे करथै जो ठीक है: बौ सिरफ बे लोगन के ऊपर दुख लागो जो तुमकै दुखी करथैं, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />और बौ तुम जो कलेस पाथौ, तुमकै सांति देगो। बौ समय जब प्रभु ईसु अपनी सामर्थ्य से स्वर्गदूतन के संग स्वर्ग से दिखाई देगो, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />धधकत भइ आगी की लपटन के संग, बे लोगन कै सजा देन ताहीं जो परमेस्वर कै अपनात नाय हैं और जो हमरे प्रभु ईसु के बारे मैं सुसमाचार नाय मानथैं। <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" /><note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ISA 2:10">यसायाह 2:10</ref> </char></note>जो प्रभु की मौजूदगी से और उनकी महिमा से अलग हुई जागो, बे अनंत बिनास की सजा भुगतंगे, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />जब बौ दिन अपने सब पवित्र लोगन से महिमा और विस्वासिन से आदर लेन ताहीं आगो। तुम्हऊँ उनमैं से गभा होगे, तुम बौ सुसमाचार मैं बिस्वास करे हौ जो हम तुमकै बताए रहैं।<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />जहे बजह है कि हम हमेसा तुमरे ताहीं प्रार्थना करथैं। हम अपने परमेस्वर से तुमकै बौ जीवन के काबिल बनान ताहीं कहथैं जो बौ तुमकै जीन के ताहीं कही है, हुई सकथै, कि बौ अपनी सामर्थ्य से तुमरी भलाई की सबै इच्छन कै पूरी करै और तुमरे बिस्वास को काम पूरो करै। <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />जौ तरीका से हमरे प्रभु ईसु को नाओं तुमसे और तुमरे जरिया, हमरे महिमामय परमेस्वर और प्रभु ईसु मसीह की किरपा से तुम्हैं अनुग्रह मिलै।<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">एक दुस्ट</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />भईय्यौ प्रभु ईसु मसीह के आन और बाके संग रहन के ताहीं हमरे होन के बारे मैं: मैं तुमसे नहोरे करत भै पूछथौं, मेरे दोस्तौ, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />अपनी सोच मैं इत्ती आसानी से भ्रमित मन हुइयो या जौ दाबा से परेसान होनो कि प्रभु को दिन आए गौ है। सायद जौ सोचो जाबै कि हम भविस्यवाँड़ी या आत्मा मैं उपदेस देन पोती जौ कहे रहैं, या कि हम जाकै एक चिट्ठी मैं लिखे रहैं। <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />कोई कै कैसे भी करकै धोका मत दियो। जबले अधर्म को त्याग नाय होथै और बदमास आदमी अराजकता फैलाथै, तौले दिन नाय आगो, जोको भाग नरक मैं है, तब तक बिनास होन को बौ दिन नाय आगो। <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" /><note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="DAN 11:36">दानिय्येल 11:36</ref>; <ref loc="EZK 28:2">यहेजकेल 28:2</ref> </char></note>बौ हर तथाकथित दुईतन या पूजा की चीज को बिरोध करैगो और खुदकै सबन से ऊपर रखैगो। हिंयाँ ले कि बौ परमेस्वर के मंदिर मैं जाएकै बैठ जागो और अपने आपकै परमेस्वर होन को दाबा करैगो।<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />का तुमकै याद नाय है? मैं तुमरे संग रहौं तौ जौ सब बताओ। <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />तहुँओं कछु ऐसो है जो अब होन से रोकथै, और तुम जानथौ कि जौ का है। तौ सई समय मैं, दुस्ट आदमी दिखाई देगो। <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />रहस्यमयी अराजकता भरी अधर्म के काम पहलेई से करी है, लेकिन जो होन बारो है बौ तौले नाय होगो जबले कि जाकै बापस रखन बारे कै राह से हटाय नाय दौ जागो। <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" /><note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 11:4">यसायाह 11:4</ref> </char></note> तौ एक अधर्मी दिखाई देगो, लेकिन जब प्रभु ईसु आगो, तौ बौ बाकै अपने मोहों से सास के संग मार देगो और बाकै बाकी चमकदार हाजरी के संग बाकी आत्मा कै खतम कर देगो। <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">मत्ती 24:24</ref> </char></note>दुस्ट आदमी सैतान की सामर्थ्य के संग आगो और सब तरह के अचम्मे चिन्ह चमत्कार करैगो, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />और जो नास होंगे उनके ऊपर सब तरह के अधर्म छल करियो। बे नास हुई जांगे काहैकि बे उद्धार पान के ताहीं सच को स्वागत और प्रेम कै नाय अपनाईं। <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />और तभई परमेस्वर उनकै काम करन के ताहीं गलती की सक्ति भेजथै ताकी बे बिस्वास करैं कि का झूठ है। <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />जाको नतीजा जौ है कि जो सब जनी सच्चाई के ऊपर बिस्वास नाय करीं हैं, पर पाप मैं खुसी मनाईं हैं, उनकी बातन कै परख कै उनकी बुराई करी जागी।<verse eid="2TH 2:12" /></para>
  <para style="s">तुम उद्धार के ताहीं चुने गै हौ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />पर भईय्यौ, हमैं हर समय परमेस्वर को धन्यवाद करनो चाहिए, दोस्तौ, जोकै तुम्हैं प्रभु प्रेम करथै। काहैकि परमेस्वर तुमकै सबसे पहले उद्धार के ताहीं चुन लई है कि पवित्र आत्मा की सक्ति से पवित्र लोग बनान के ताहीं और सच्चाई मैं तुमरे बिस्वास के जरिया बचाबौ। <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />परमेस्वर तुमकै जौ बात के ताहीं मस्काई है कि हम तुमकै सुसमाचार सुनामैं; बौ तुमकै हमरे प्रभु ईसु मसीह की महिमा को हिस्सा बताई। <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />तौ, हमरे भईय्यौ और बहेनियौ, मजबूती से ठाड़े रहबौ और बे सच्चाई की सिक्छा कै थामें रहबौ जो रीत हम तुम्हैं सिखाए, अपने उपदेस और हमरी चिट्ठी मैं।<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />हमरे प्रभु ईसु मसीह खुद और हमरे दऊवा परमेस्वर, जो हमरे संग अच्छाई और प्रेम करी अपने अटूट साहस अनुग्रह और मजबूत अनंत आसा और सांति दई है, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />तुमकै प्रोत्साहन करै और तुमकै हमेसा ऐसो करन के ताहीं तुमरे मन मजबूत करैं और कहमैं कि अच्छो है।<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">मेरे ताहीं प्रार्थना करियो</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />आखरी मैं, हमरे भईय्यौ और बहेनियौ, हमरे ताहीं प्रार्थना करौ, कि प्रभु को संदेसो तेजी से फैलै और बड़ाँईं के संग मिलत रहबै, जैसे कि तुमरे बीच भौ। <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />जहो प्रार्थना करौ कि परमेस्वर हमैं दुस्ट और बुरे लोगन से बचाबै; सबन कै संदेस के ऊपर बिस्वास ना है।<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />लेकिन प्रभु वफादार और भरोसे के लायक है, और बौ तुमकै मजबूत करैगो और तुमकै सैतान से बचाए रखागो। <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />और प्रभु हमकै तुमरे ऊपर भरोसो दिलाथैं, और हमकै यकीन है कि तुम कर्‌रै हौ और हम तुमकै जो बताथैं बौ करत रहागे।<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />प्रभु तुमकै परमेस्वर के प्रेम और मसीह के जरिया दी गई मन मैं सहनसक्ति की समझ मैं ले जाबै।<verse eid="2TH 3:5" /></para>
  <para style="s">काम करन मैं रुकावट</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />भईय्यौ और बहेनियौ, हम तुमकै हमरे प्रभु ईसु मसीह के नाओं मैं बे सब विस्वासियन से दूर रहेन की आग्या देथैं जो आलसी जिंदगी जी रै हैं और जो हमरे जरिया दै गई सिक्छा के निर्देसन को पालन नाय करथैं। <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />तुम खुदै अच्छे तरहन से जानथौ कि तुमकै बहे करनो चहाईये जो हम करे। जब हम तुमरे संग रहैं तौ हम आलसी नाय रहैं। <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />हम जाके ताहीं भुगतान करे बिना कोई के समर्थन कै नाय अपनाय। जाके अलावा, हम काम करे और अब्बल आए; हम दिन-रात काम करत रहे ताकी तुम्मैं से कोई के ताहीं खर्चा ना होबै। <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />हम ऐसो तभई करे, हमैं अपने समर्थन की माँग करन को अधिकार नाय है; हम तुमकै अनुसरँड़ करन के ताहीं एक उदाहरड़ दै। <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />जब हम तुमरे संग रहैं, हम तुमकै बतात रहैं, “जो कोई काम करन से मना करथै बाकै खान की अनुमति नाय है।”<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />हम ऐसो इसलै कहथैं काहैकि हम सुनथैं कि तुमरे बीच कुछ आदमी रह हैं जो आलसी जिंदगी जीथैं और जो दुसरे आदमिन के व्यवसाय मैं टाँग अड़ान के अलावा कछु नाय करथैं। <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />प्रभु ईसु मसीह के नाओं ऊपर हम जे आदमिन कै आग्या देत उनसे नहोरे करथैं कि बे कहे के अनुसार जिंदगी बितामैं और अपनो गुजारो चलान के ताहीं काम करैं।<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />लेकिन भईय्यौ और बहेनियौ, अच्छो काम करन के ताहीं तुमकै थकनो ना चहाईये। <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />ऐसो हुई सकथै कि कोई जौ चिट्ठी मैं तुमरे जरिया भेजे गै संदेसो को पालन नाय करंगे। अगर हाँ, तौ उनके ऊपर ध्यान देबौ और कोई लेनो देनो उनसे नाय है, जोसे उनकै सरम आबै। <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />लेकिन भईय्यौ उनकै बैरी मत समझौ; जाके अलावा, उनकै विस्वासियन के रूप मैं चितौनी देबौ।<verse eid="2TH 3:15" /></para>
  <para style="s">आखरी सब्द</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />खुद परमेस्वर, जो सांति को हमरो सोता है, तुमकै हर घड़ी चिन्ह और सब तरह से सांति देथै। प्रभु तुम सबन के संग रहमैं।<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />मैं पौलुस अपने हात से नमस्ते लिखथौं: मेरे हर एक चिट्ठी की पहचान चिन्ह जहे है; मैं ऐसिये करकै लिखथौं।<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />हमरे प्रभु ईसु मसीह को अनुग्रह और किरपा तुम सबन ऊपर बनी रहबै।<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>