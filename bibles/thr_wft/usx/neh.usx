<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NEH" style="id">- Rana Tharu</book>
  <para style="h">नहेम्याह</para>
  <para style="toc3">नहेम्याह</para>
  <para style="toc2">नहेम्याह</para>
  <para style="toc1">नहेम्याह</para>
  <para style="mt2">नहेम्याह की किताब</para>
  <para style="mt1">नहेम्याह</para>
  <para style="imt">परिचय</para>
  <para style="ip">एज्रा और नहेम्याह की किताब बताथैं कि कैसे फारस और बेबीलोन मैं बंदी बनाए जान के बाद इस्राएलियन के इस्राएल लौटन की इजाजत दी गई रहै। नहेम्याह जौ बात मै जोर देथै कि यरुसलेम के चारौ घाँईं की दीबार फिर से कैसे बनाई गई रहै। कई ग्यानी को माननो है कि एज्रा 1 और 2 इतिहास की किताब के संग-संग एज्रा और नहेम्याह की किताबन कै भी लिखी और संकलित करी। अगर जौ एज्रा नाय रहै तौ जरूर है कि एकै आदमी जेईं किताबन कै संकलन करी होए। नहेम्याह की किताब जरूर: 430 ईसा पहले के आसपास संकलित करी गई होगी।</para>
  <para style="ip">नहेम्याह बौ पिलानोहार रहै जौ फारस राजा अर्तछत्र की सेवा करी रहै, और बौ यरुसलेम की सहरी दीवारन कै दुबारा से बनान मै मदत करन के ताहीं अर्तछत्र से यरुसलेम लौटन की इजाजत माँगी रहै। अर्तछत्र नहेम्याह कै ऐसो करन की इजाजत दई और बाद मै बौ नहेम्याह को यहूदिया, यरुसलेम के आसपास की सीमा को राज्यपाल चुनी। हाँलाकि कुछ लोग नहेम्याह कै यरुसलेम की दीवारन कै दुबारा बनान से रोकन की कोसिस करी, लेकिन परमेस्वर की मदत से काम 52 दिन मै पूरो ही गौ। तब राजा इस्राएलिन कै परमेस्वर के संग अपनो समझौता को नया करन के ताहीं निर्वाह करन मै नहेम्याह की मदत करी।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">नहेम्याह को यरूशलेम मैं लौटनों <char style="ior"><ref loc="NEH 1:1-2:20">1:1–2:20</ref> </char></para>
  <para style="io1">यरूशलेम की शहरपनाह को फिर से बननों <char style="ior"><ref loc="NEH 3:1-7:73">3:1–7:73</ref></char></para>
  <para style="io1">व्यवस्था को पाठ और वाचा को नवीकरड़ <char style="ior"><ref loc="NEH 8:1-10:39">8:1–10:39</ref> </char></para>
  <para style="io1">नहेम्याह की आग्गु की गतिविधियाँ <char style="ior"><ref loc="NEH 11:1-13:31">11:1–13:31</ref> </char></para>
  <chapter number="1" style="c" sid="NEH 1" />
  <para style="s">यरूसलेम के ताहीं नहेम्याह की चिंता</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 1:1" />हकल्याह के लौड़ा नहेम्याह के वचन। बीसमें साल के किसलेव नाओं के महेना मैं, जब मैं सूसा नाओं की राजधानी मैं रहत रहौं, <verse eid="NEH 1:1" /><verse number="2" style="v" sid="NEH 1:2" />तौ हनानी, मेरो एक भईय्या, एक दुसरे झुंड़ के संग यहूदा से आओ, और मैं बासे यरूसलेम के बारे मै और भी यहूदियन के बारे मै पूँछो जो बेबीलोन मै बंधुँवाई से लौट आए रहैं। <verse eid="NEH 1:2" /><verse number="3" style="v" sid="NEH 1:3" />बे मोसे कहीं कि जो लोग बच गै, बे सब अपनी जनम जघा मै बापस आए गै हैं, बे बड़े संकट मै हैं और आस-पास रहन बारे विदेसी उन्हैं गंदी नजर से देखथैं। बे मोकै जौ भी बताई कि यरूसलेम की दीवार हबै भी टूटी पड़ी हैं और जब से मोहोट जलाए गै हैं तब से उनकी मरम्मत नाय भई है।<verse eid="NEH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 1:4" />जब मैं जौ सब सुनो तौ मैं बैठकै रोन लगो। मैं कई दिन ले सोक करो। और परमेस्वर से उपवास के संग प्रार्थना करो, <verse eid="NEH 1:4" /><verse number="5" style="v" sid="NEH 1:5" />हे स्वर्ग के परमेस्वर प्रभु परमेस्वर! तू महान है, और हम तेरो डर मानथैं। तैं जो अपने प्रेम रखन बारेन और आग्या मानन बारेन से अपनी वाचा को सच्चे मन से पालन करथै, और उनके ऊपर करूड़ा करथै। <verse eid="NEH 1:5" /><verse number="6" style="v" sid="NEH 1:6" />हे प्रभु, मेरे घाँईं अपनी नजर गढ़ा, और मेरी प्रार्थना सुन, काहैकि मैं तेरो दास इस्राएल के लोगन ताहीं रात-दिन प्रार्थना करथौं। मैं मानथौं कि, इस्राएल के लोग पाप करीं हैं। मेरे पुरखा और मैं भी पाप करो हौं। <verse eid="NEH 1:6" /><verse number="7" style="v" sid="NEH 1:7" />हम तेरे खिलाप भौत बुराई करे और जो आग्या तू हमकै दौ रहै बौ न करे। जो नियम तू अपने दास मूसा के जरिया हमैं दौ, उन्हैं भी हम न माने। <verse eid="NEH 1:7" /><verse number="8" style="v" sid="NEH 1:8" />तौ अब याद कर कि तू मूसा से का कहो रहै: अगर इस्राएल के लोग मेरे खिलाप विस्वासघात करंगे, तौ मैं तुम्हैं देस-देस से तितर-बितर कर दुंगो। <verse eid="NEH 1:8" /><verse number="9" style="v" sid="NEH 1:9" />लेकिन अगर तुम मेरे घाँईं फिरथौ और जो आग्या मैं तुम्हैं देथौं बहे करौ, तौ मैं तुम्हैं बौ जघा मैं लौटार लांगो जोकै मैं आराधना के ताहीं चुन लौ हौं, चाँहे तुम पृथ्वी की छोर ले तितर-बितर ही जाबौ।<verse eid="NEH 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 1:10" />“प्रभु, जे तेरे सेवक हैं, तेरे अपने लोग हैं। तू अपनी महान ताकत से उन्हैं बचाओ। <verse eid="NEH 1:10" /><verse number="11" style="v" sid="NEH 1:11" />अब मेरी और अपने और भी सब सेवकन की प्रार्थना सुन जो प्रभु के नाओं को डर मानथैं, और आज मोकै कामयाबी दे और राजा कै मेरे ऊपर दया करन ताहीं बना।” मैं तौ राजा को पियाऊ रहौं।<verse eid="NEH 1:11" /></para>
  <chapter eid="NEH 1" />
  <chapter number="2" style="c" sid="NEH 2" />
  <para style="s">नहेम्याह को यरूसलेम मै जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 2:1" />बीस साल के बाद नीसान महेना मै, जब राजा अर्तछत्र खानु खात होथै, तौ मैं बाके झोने दाखरस लैकै गौ। जासे पहले बौ मोकै दुखी कहुए नाय देखी रहै, <verse eid="NEH 2:1" /><verse number="2" style="v" sid="NEH 2:2" />राजा तभई मोसे पूँछी, “तेरो चैहरा इतनो दुखी काहे कै है? तू बिमार तौ न दिखथै, लगथै जरूर तेरो मन उदास है।” तौ मैं डराए गौ।<verse eid="NEH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 2:3" />और मैं बाके सबाल को जबाब दौ, “महामहिम सदा अमर रहबै! मैं दुखी काहे न होमौं, जब बौ सहर जहाँ मेरे पुरखन कै दफनाओ गौ है, बौ जघा तौ खंडर ही चुको है और बाके मोहोट आगी से नास ही गै हैं, तौ मेरो चैहरा काहे उदास ना रहबै?”<verse eid="NEH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 2:4" />राजा मोसे पूँछी, “तू का चाहथै?” तौ मैं स्वर्ग के परमेस्वर से प्रार्थना करो,<verse eid="NEH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 2:5" />और फिर मैं राजा से कहो, “अगर महामहिम अपने दास के ऊपर मैहरबान है, और मेरी बिनती कै सुनथै, तौ मोकै यहूदा देस मै, बौ सहर मै जान की इजाजत दे जहाँ मेरे पुरखन कै दफनाओ गौ है, ताकी मैं सहर कै दुबारा बनाए सकौं।”<verse eid="NEH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 2:6" />तौ राजा जोके झोने रानी भी बैठी रहै, मोसे पूँछी, “तैं कितने दिन ले यात्रा मैं रहगो? और कब लौटैगो?” मैं बाकै एक सई समय बताओ, तौ राजा मोकै खुसी से भेजन ताहीं सहमत हुई गौ।<verse eid="NEH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 2:7" />फिर मैं राजा से बिनती करो, अगर राजा कै सई लगै, तौ फरात नदिया के पछार दिसा के देस के सब अधिपतियन कै चिट्ठी देन की किरपा कर, कि जब ले मैं यहूदा कै ना पहुँचौं, तौले बे मोकै अपने-अपने देस मैं से हुईकै जान देमैं। <verse eid="NEH 2:7" /><verse number="8" style="v" sid="NEH 2:8" />और का मैं राजभवन के रखबरिया आसाप के नाओं एक चिट्ठी लिख सकथौं, कि बौ मोकै भवन के झोने गढ़ के फाटकन, और नगर की दीवार, और मेरे के लिरहन के ताहीं, जे कड़ियाँ बनान के ताहीं कठिया देबै? और काहैकि मेरे परमेस्वर को अनुग्रहकारी हात मेरे ऊपर रहै, राजा मेरी विनती स्वीकार कर लई।<verse eid="NEH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 2:9" />तौ मैं फरात नदिया के पार के अधिपतियन के झोने जाएकै, उन्हैं राजा की चिट्ठी दौ। राजा मेरे संग सेनापति और घुड़सवार भी भेजी रहै।<verse eid="NEH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 2:10" />जौ सुनकै कि एक लोग इस्राएलियन के भलाई ताहीं तरकीब बतान कै आओ है, होरोनी सम्बल्लत और तोबियाह नाओं को कर्मचारी जो अम्मोनी रहै, बे दोनों कै बड़ा बुरो लगो।<verse eid="NEH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 2:11" />जब मैं यरूसलेम गौ, तौ मैं हुँआँ तीन दिन रुको। <verse eid="NEH 2:11" /><verse number="12" style="v" sid="NEH 2:12" />मैं कोईये कै नाय बताओ कि परमेस्वर मोकै यरूसलेम के ताहीं का करन ताहीं प्रेरित करी है। फिर आधी रात कै मैं उठो और अपने संग कुछ लोगन कै लैकै बाहर चले गौ। और मैं कोई कै कछु ना बताओ, मैं जो जानवर के ऊपर बैठो रहौ, बाकै छोड़कै मेरे संग कोई जानवर ना रहै। <verse eid="NEH 2:12" /><verse number="13" style="v" sid="NEH 2:13" />मैं रात कै तराई के फाटक से हुईकै निकरो और अजगर के सोता के घाँईं, और कूड़ा-फाटक के झोने गौ, और यरूसलेम की टूटी भई दीबार और जले फाटकन कै देखो। <verse eid="NEH 2:13" /><verse number="14" style="v" sid="NEH 2:14" />तौ मैं अग्गु बढ़कै सोता के फाटक और राजा के कुंड के झोने गौ; पर मेरी सवारी के जानवर के ताहीं अग्गु जान की जघा ना रहै। <verse eid="NEH 2:14" /><verse number="15" style="v" sid="NEH 2:15" />तौ मैं रातै रात घाटी से हुईकै दीबार कै देखत भई चढ़ गौ; फिर घूमकै तराई के फाटक से भीतर आओ, और ऐसे करकै सहर के घाँईं लौटियाओ।<verse eid="NEH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 2:16" />और अधिकारी नाय जानत रहैं, कि मैं कहाँ गौ, और का करत रहौं; और मैं तौले ना तौ यहूदियन कै और ना पुजारिन और नेता ना अधिकारी और ना दुसरे काम करन बारेन लोगन कै बताओ। <verse eid="NEH 2:16" /><verse number="17" style="v" sid="NEH 2:17" />तौ मैं उनसे कहो, “तुम तौ खुद देखथौ, कि हम कैसी हालत मैं हैं, कि यरूसलेम उजाड़ पड़ो है और बाके फाटक जले भै हैं। तौ आबौ, हम यरूसलेम की दीबार कै बनामैं, कि आन बारे समय मैं हमरी नाओंधराई ना रहबै।” <verse eid="NEH 2:17" /><verse number="18" style="v" sid="NEH 2:18" />फिर मैं उनकै बताओ, कि मेरे परमेस्वर की किरपा दृस्टि मेरे ऊपर कैसी भई, और राजा मोसे का-का बात कही रहै। तौ बे कहीं, “आबौ हम कमर बाँधकै बनान लगैं।” और बे जौ भले काम कै करन के ताहीं हियाब भाँद लईं।<verse eid="NEH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 2:19" />जौ सुनकै होरोनी सम्बल्लत और तोबियाह नाओं को कर्मचारी जो अम्मोनी रहै, और गेसेम नाओं को एक अरबी, हमरी मजाक उड़ान लगे; “जौ तुम का काम करथौ। का तुम राजा के बिरोध मैं बगावत करैगे?”<verse eid="NEH 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 2:20" />तौ मैं उनकै जबाब दैकै उनसे कहो, “स्वर्ग को परमेस्वर हमरो काम सफल करैगो, हम बाके दास हैं, और हम एक बार और दीबार कै बनान को काम सुरू करंगे।” लेकिन यरूसलेम मै न बनो रहने को और बामै कोई अधिकार न है।<verse eid="NEH 2:20" /></para>
  <chapter eid="NEH 2" />
  <chapter number="3" style="c" sid="NEH 3" />
  <para style="s">यरूसलेम की दीबार कै दुबारा बनानो</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 3:1" />बड़ो पुजारी एल्यासीब और बाके संग के पुजारी काम सुरुवात करीं, और भेंड़-फाटक कै फिर से बनाईं। बे जाकै समर्पित करीं और जाके फाटक लगाईं, और सौ गुम्मट ले बनाईं, जिनकै बे समर्पित करीं, और हननेल के गुम्मट ले बनाईं।<verse eid="NEH 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NEH 3:2" />बाके बाद यरीहो के लोग बनाईं, और जाके बाद इम्री को लौड़ा जक्कूर बनाई।<verse eid="NEH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 3:3" />फिर मच्छी फाटक कै हस्सना के लौड़ा बनाई; बौ बाकी कड़िया लगाई, और बाके पल्ला, तारो और बेड़ी लगाई।<verse eid="NEH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 3:4" />बाके बाद मरेमोत जो हक्कोस को धुईतो और ऊरिय्याह को लौड़ा रहै, मरम्मत करी। और जाके बाद मसुल्लाम जो मेसेजबेल को धुईतो, और बेरेक्याह को लौड़ा रहै, मरम्मत करी। जाके बाद बाना को लौड़ा सादोक मरम्मत करी।<verse eid="NEH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 3:5" />जाके बाद तकोअ नगर के रहन बारे दीबार की मरम्मत करीं; पर उनके नगर के नेता, अपने प्रभु की सेवा मैं हात ना बटाईं।<verse eid="NEH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 3:6" />फिर पुराने फाटक की मरम्मत पासेह के लौड़ा योयादा और बसोदयाह को लौड़ा मसुल्लाम करी; बे बाकी कड़िया लगाईं, और बाके पल्ला, ताला और बेड़ी लगाईं। <verse eid="NEH 3:6" /><verse number="7" style="v" sid="NEH 3:7" />और बाके बाद गिबोनी मलत्याह और मेरोनोतवासी यादोन और गिबोन और मिजपा अधिपतियन के लोग फरात नदिया के पार सिंहासन के महल के आसन के तरफ से मरम्मत करीं।<verse eid="NEH 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 3:8" />बाके बाद हर्हयाह को लौड़ा उज्जीएल और दुसरे सुनरा लोग मरम्मत करीं। बाके बाद हनन्याह, जो के समाज कै बनान बारो रहै, मरम्मत करी; और बे चौड़ी दीबार ले यरूसलेम को मजबूत करीं।<verse eid="NEH 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 3:9" />बाके बाद हूर को लौड़ा रपायाह, जो यरूसलेम के आधे जिला को अधिकारी रहै, मरम्मत करी।<verse eid="NEH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 3:10" />और बाके बाद हरुमप को लौड़ा यदायाह अपनेई घर से सामने मरम्मत करी; और बाके बाद हसब्नयाह को लौड़ा हत्तूस मरम्मत करी।<verse eid="NEH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 3:11" />हारीम को लौड़ा मल्किय्याह और पहत्मोआब को लौड़ा हस्सूब एक और हिस्सा की, और भट्टी के गुम्मट की मरम्मत करीं।<verse eid="NEH 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 3:12" />जाके बाद यरूसलेम के आधे जिला के अधिकारी हल्लोहेस को लौड़ा सल्लूम अपनी लौड़िया मिलकै मरम्मत करीं।<verse eid="NEH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 3:13" />तराई मोहोट की मरम्मत हानून और जानोह सहर के लोग भी करीं; बेड़ी और पल्ला लगाईं, और हजार हात की दीबार कै भी मतलब कूड़ा फाटक ले बनाईं।<verse eid="NEH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 3:14" />कूरा मोहोट की मरम्मत रेकाब को लौड़ा मल्किय्याह करी, जो बेथक्केरेम के जिला को अधिकारी रहै; बहे बाकै बनाई, और बाके ताला, बेड़ी और पल्ला लगाई।<verse eid="NEH 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 3:15" />सोता मोहोट की मरम्मत कोल्होजे को लौड़ा सल्लूम करी, जो मिजपा के जिला को अधिकारी रहै; बहे बाकै बनाई और पाटी, और बाके ताला, बेड़ी और पल्ला लगाई; और बहे राजा की बारी के झोने के सेलह नाओं के कुंड की दीबार कै भी दाऊदपुर से उतरन बारी सीढ़ी तक बनाई।<verse eid="NEH 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 3:16" />बाके बाद अजबूक को लौड़ा नहेम्याह जो बेतसूर के आधे जिला को अधिकारी रहै, दाऊद के कब्रिस्तान के सामने ले और बनाए भै जलकुंड ले, और वीरन के घर ले भी मरम्मत करी।<verse eid="NEH 3:16" /></para>
  <para style="s">लेवी दीबार मै काम करीं</para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 3:17" />जाके बाद बानी को लौड़ा रहूम तमान लेवियन समेत मरम्मत करीं। जाके बाद किला के आधे जिला के अधिकारी हसब्याह अपने जिला की मरम्मत करी।<verse eid="NEH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 3:18" />बाके बाद उनके भईय्यन समेत किला के आधे जिला को अधिकारी हेनादाद को लौड़ा बव्वै मरम्मत करी।<verse eid="NEH 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 3:19" />बाके बाद एक और हिस्सा की मरम्मत जो दीबार के मोड़ के झोने हत्यारघर की चढ़ाई के सामने है, ईसु को लौड़ा एजेर करी, जो मिजपा को अधिकारी रहै।<verse eid="NEH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 3:20" />फिर एक और हिस्सा की मतलब बहे मोड़ से लैकै एल्यासीब बड़े पुजारी के घर के फाटक ले मरम्मत, जब्बै को लौड़ा बारूक तन मन से करी।<verse eid="NEH 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 3:21" />जाके बाद एक और हिस्सा मतलब एल्यासीब के घर के फाटक से लैकै बहे घर के सिरा ले मरम्मत करी, मरेमोत करी, जो हक्कोस को धुईतो और ऊरिय्याह को लौड़ा रहै।<verse eid="NEH 3:21" /></para>
  <para style="s">पुजारी जो बे दीवार बनान मै काम करीं</para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 3:22" />बाके बाद बे पुजारी मरम्मत करीं जो तराई के लोग रहैं। <verse eid="NEH 3:22" /><verse number="23" style="v" sid="NEH 3:23" />उनके बाद बिन्यामीन और हस्सूब अपने घर के सामने मरम्मत करीं; और इनके पच्छू अजर्याह जो मासेयाह को लौड़ा और अनन्याह को धुईतो रहै, अपने घर के झोने मरम्मत करी।<verse eid="NEH 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 3:24" />तौ एक और हिस्सा की, मतलब अजर्याह के घर से लैकै दीबार के कोने ले और बाकी मरम्मत हेनादाद को लौड़ा बिन्नूई करी।<verse eid="NEH 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 3:25" />फिर बहे मोड़ के सामने जो ऊँचे गुम्मट राजभवन से बाहर निकरो भौ बंदीगृह के आँगन के झोने है, बाके सामने ऊजै को लौड़ा पालाल मरम्मत करी। जाके बाद परोस को लौड़ा पदायाह मरम्मत करी।<verse eid="NEH 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NEH 3:26" />नतीन लोग तौ ओपेल मैं अगार के घाँईं जलफाटक के सामने ले और बाहर निकरे भै गुम्मट ले रहत रहैं।<verse eid="NEH 3:26" /></para>
  <para style="s">दीबार की मरम्मत करनबारे दुसरे लोग</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 3:27" />पदायाह के बाद तकोअ एक और हिस्सा की मरम्मत करी, जो बाहर निकरे भै बड़े गुम्मट के सामने और ओपेल की दीबार ले है।<verse eid="NEH 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 3:28" />फिर घोड़ाफाटक के ऊपर पुजारी अपने-अपने घर के सामने मरम्मत करीं।<verse eid="NEH 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NEH 3:29" />जाके बाद इम्मेर को लौड़ा सादोक अपने घर के सामने मरम्मत करी; और फिर अगार दिसा फाटक के रखबरिया सकन्याह को लौड़ा समायाह मरम्मत करी।<verse eid="NEH 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 3:30" />जाके बाद सेलेम्याह को लौड़ा हनन्याह और सालाप को छठमों लौड़ा हानून एक और हिस्सा की मरम्मत करी। तौ बेरेक्याह को लौड़ा मसुल्लाम अपनी कोठरी के सामने मरम्मत करी।</para>
  <para style="p" vid="NEH 3:30">तभई बेरेक्या को लौड़ा मसुल्लाम अपने कुठरिया के सामने मरम्मत करी।<verse eid="NEH 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 3:31" />बाके बाद मल्किय्याह जो सुनरा रहै, नतिनन और ब्यापारियन के जघा ले ठहराए भै जघा मंदिर के फाटक के सामने और कोने के कोठा ले मरम्मत करी।<verse eid="NEH 3:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NEH 3:32" />और कोनेबारे कोठा से लैकै भेंड़फाटक ले सुनरा और व्यापारी मरम्मत करीं।<verse eid="NEH 3:32" /></para>
  <chapter eid="NEH 3" />
  <chapter number="4" style="c" sid="NEH 4" />
  <para style="s">नहेम्याह अपने काम मै जीत हासिल करी</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 4:1" />जब सम्बल्लत सुनी कि यहूदि लोग दीवार को दुबारा बनानो सुरु कर दईं हैं, तौ बौ रिसियान लग गौ और हमरो मजाक उड़ान लगो। <verse eid="NEH 4:1" /><verse number="2" style="v" sid="NEH 4:2" />बौ अपने भईय्यन के और सामरिया की सेना के सामने जौ कहन लगो, “बे कमजोर यहूदी का करनो चाहथैं? का बे अपने बल से काम करंगे? का बे अपनी जघा मजबूत करंगे? का बे हवन करंगे? का बे मट्टी के ढेरन मैं के जले भै पथरन कै फिर नया सिरा से बनांगे?”<verse eid="NEH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 4:3" />अम्मोन देस को तोबियाह बाके संग रहै, और बौ कहन लगो, “जो कछु बे बनाए रहे हैं, अगर कोई गीदड़ भी बामैं चढ़ जाबै, तौ बौ उनकी बनाई भई पथरा की दीबार कै तोड़ देगो।”<verse eid="NEH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 4:4" />हे हमारे परमेस्वर सुन ले, कि हमरो अपमान हुई रौ है; और उनको करो भौ अपमान उन्हईं की मुड़िया मैं लौटार दे, और उन्हैं बंधुवाई के देस से लुटवाए दे। <verse eid="NEH 4:4" /><verse number="5" style="v" sid="NEH 4:5" />और उनके दुस्टता के काम कै मत ढाँप, और ना उनको पाप तेरे सामने से मिटाओ जाए; काहैकि बे तोकै दीबार बनानबारेन के सामने गुस्सा दिबाई हैं।<verse eid="NEH 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 4:6" />हम लोग दीबार कै बनाए; और पूरी दीबार आधी ऊँचाई ले जुड़ गई। काहैकि लोगन को मन बौ काम मैं लगो रहो।<verse eid="NEH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 4:7" />जब सम्बल्लत और तोबियाह और अरबी, अम्मोन और असदोद के लोग सुनी, कि हम यरूसलेम की दीबार कै दुबारा बनान मैं अग्गु बढ़ रहै हैं, और दीबार मै दरार भी बंद करी जाए रही हैं, तौ बे भौत गुस्सा भै। <verse eid="NEH 4:7" /><verse number="8" style="v" sid="NEH 4:8" />फिर बे सब मिलकै यरूसलेम मै हमला करन और गड़बड़ी फैलान की योजना बनाईं, <verse eid="NEH 4:8" /><verse number="9" style="v" sid="NEH 4:9" />लेकिन हम लोग अपने परमेस्वर से प्रार्थना करे, और दुस्मन के हमला से बचन के ताहीं दिन-रात के ताहीं पहरुआ बैठाए दै।<verse eid="NEH 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 4:10" />यहूदा के लोग एक गीत गाईं:</para>
  <para style="q1" vid="NEH 4:10">“हम ताकत से बोझ उठान मै कमजोर ही जाथैं;</para>
  <para style="q1" vid="NEH 4:10">हटान के ताहीं भौत सारो मलबा है।</para>
  <para style="q1" vid="NEH 4:10">आज हम दीवार कैसे बनाए सकथैं?”<verse eid="NEH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 4:11" />और हमरे दुस्मन कहन लगे, “जबले हम उनके बीच मैं ना पहुँचे, और उन्हैं घात करकै बौ काम बंद ना करैं, तौले उनकै ना कछु पता चलैगो, और ना कछु दिखाई पड़ैगो।” <verse eid="NEH 4:11" /><verse number="12" style="v" sid="NEH 4:12" />फिर जो यहूदी उनके आस-पास रहत रहैं, बे सब जघा से दस बार आए-आएकै, हम लोगन से कहीं, “तुमकै हमरे झोने लौट आनो चाहिए।” <verse eid="NEH 4:12" /><verse number="13" style="v" sid="NEH 4:13" />जौ बजह से मैं सब लोगन कै तलवार, बर्छी और धनुस दैकै दीबार के पच्छू सबसे नीचे की खुली जघा मैं घर-घर के हिसाब से बैठार दईं।<verse eid="NEH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 4:14" />तौ मैं देखकै उठो, और नेता और अधिकारियन और सब लोगन से कहो, “उनसे मत डराबौ; प्रभु जो महान और भययोग्य है, बहे कै याद करकै, अपने भईय्या, लौड़ा-लौड़ियन, बईंय्यरैं और घरन के ताहीं लड़ाई लड़ियो।” <verse eid="NEH 4:14" /><verse number="15" style="v" sid="NEH 4:15" />जब हमरे दुस्मन सुनीं, कि जे बात हमकै पता चल गई है, और परमेस्वर उनकी योजना कै विफल करी है, तौ हम सब के सब दीबार के झोने अपने-अपने काम मैं लौट गै।<verse eid="NEH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 4:16" />और बौ दिन से मेरे आधे सेवक तौ बौ काम मैं लगे रहे, और आधे बर्छी, तलवार, तीर धनुस और कवज कै धारड़ करे रहत रहैं; और यहूदा के पूरे घराने के पच्छू, अधिकारी रहे करत रहैं। <verse eid="NEH 4:16" /><verse number="17" style="v" sid="NEH 4:17" />दीबार कै बनान बारे और बोझ कै ढोनबारे दोनों बोझ कै उठात रहैं, मतलब एक हात से काम करत रहैं, और दुसरे हात से हथियार पकड़े रहत रहैं। <verse eid="NEH 4:17" /><verse number="18" style="v" sid="NEH 4:18" />राजमिस्त्री अपनी-अपनी जाँघ मैं तलवार लटकाए कै दीबार बनान को काम करत रहैं। और लोगन कै चाहचीते करन ताहीं तुरहई कै फूँकन बारो मेरे झोने रहत रहै। <verse eid="NEH 4:18" /><verse number="19" style="v" sid="NEH 4:19" />जौ बजह से मैं नेता , अधिकारियन और सब लोगन से कहो, “काम तौ बढ़ा फैलो भौ है, और हम लोग दीबार मैं अलग-अलग एक दुसरे से दूर रहथैं। <verse eid="NEH 4:19" /><verse number="20" style="v" sid="NEH 4:20" />जौ बजह से जहाँ से तुरहई तुमकै सुनाई देबै, उतई हमरे झोने जुराए जईयो। हमरो परमेस्वर हमरे घाँईं से लड़ैगो।” <verse eid="NEH 4:20" /><verse number="21" style="v" sid="NEH 4:21" />और हम काम मैं लगे रहंगे, और उनमैं आधे, दिन निकरन से पहले और रात ले बर्छी लैकै पहरेदारी करत रहैं।<verse eid="NEH 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 4:22" />फिर बहे समय मैं लोगन से जौ भी कहो, “एक-एक इंसान अपने दास समेत यरूसलेम के भीतर रात बिताए करैं, कि बे रात कै तौ हमारी रखबारी करैं, और दिन के काम मैं लगे रहमैं।” <verse eid="NEH 4:22" /><verse number="23" style="v" sid="NEH 4:23" />ऐसे करकै हम सब, मैं मेरे हितुआ, मेरे सेवक, मेरे अंग रक्छक, इतने चाहचीते और व्यस्त रहैं कि हमैं लत्ता तक बदलन के ताहीं समय ना मिलत रहै। हर पल, हर समय, हर आदमी अपने हात मैं हथियार लै रहत रहै।<verse eid="NEH 4:23" /></para>
  <chapter eid="NEH 4" />
  <chapter number="5" style="c" sid="NEH 5" />
  <para style="s">गरीबन के ऊपर नहेम्याह की मदत</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 5:1" />तौ लोग और उनकी बईंय्यरन के घाँईं से उनके भईय्या यहूदियन के खिलाप बड़ी चिल्लाहट मची। <verse eid="NEH 5:1" /><verse number="2" style="v" sid="NEH 5:2" />कुछ तौ कहत रहैं, “हम अपने लौड़ा - लौड़ियन समेत भौत प्राड़ी हैं, जौ बजह से हमैं अन्न मिलनो चाहिए कि बाकै खाएकै जिंदे रहमैं।”<verse eid="NEH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 5:3" />“कुछ कहत रहैं, हम अपने खेतन, दाख की बारिन और घरन कै अकाल के बजे से गिरमी रखथैं, कि हमैं अन्न मिलै।”<verse eid="NEH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 5:4" />फिर कुछ जौ कहथैं, “हम राजा के चुंगी के ताहीं अपने-अपने खेतन और दाख मधु की बारिन कै गिरवी रखकै, रुपईया उधार लै।” <verse eid="NEH 5:4" /><verse number="5" style="v" sid="NEH 5:5" />पर हमरे और हमरे भईय्यन के सरीर और हमरे और उनके बालका एक जैसी हैं, तहुँओं हम अपने लौड़ा-लौड़ियन कै बेच दै हैं; बल्किन हमरी कोई लौड़िया दासी भी हुई चुकी है; और हमरो कछु बस ना चलथै, काहैकि हमरे खेत और दाख की बारी दूसरे के हात पड़ी हैं।<verse eid="NEH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 5:6" />जब मैं बाकी सिकायत सुनो तौ मोकै भौत गुस्सा आई। <verse eid="NEH 5:6" /><verse number="7" style="v" sid="NEH 5:7" />तौ अपने मन मैं सोच बिचार करकै, मैं नेता कै और अधिकारी कै घुड़कै कहो, “तुम अपने-अपने भईय्या से ब्याज लेथौ।”<verse eid="NEH 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 5:8" />और मैं उनसे कहो, “हम अपने सामर्थ्य के हिसाब से अपने यहूदी भईय्या-बहेनिया कै, जो गैरयहूदी जाति के हात बिक गै रहैं, दाम दैकै छुड़ाए हैं, फिर का तुम अपने भईय्यन कै बेचैगे? का बे हमरे हात बिकंगे?” तौ बे चुप रहे और कछु ना कह पाए। <verse eid="NEH 5:8" /><verse number="9" style="v" sid="NEH 5:9" />फिर मैं उनसे कहो, “जो काम तुम करथौ बौ अच्छो ना है; का तुमकै जौ बजह से हमरे परमेस्वर को भय मानकै ना चलनो चाहिए, कि हमरे दुस्मन जो गैर यहूदी जाति के हैं, बे हमारी नाओंधराई ना करैं? <verse eid="NEH 5:9" /><verse number="10" style="v" sid="NEH 5:10" />मैं भी और मेरे भईय्या और सेवक उनको रुपईया और अनाज उधार देथैं, पर हम जाको ब्याज छोड़ देमैं। <verse eid="NEH 5:10" /><verse number="11" style="v" sid="NEH 5:11" />आजै उनकै उनके खेत, और दाख, और जैतून की बारिन, और घर वापस दियौ; और जो रुपईया, अन्न, नया दाखमधु, और टटको तेल तुम उनसे लै लेथौ, बाको सौमौं हिस्सा वापस दियौ?”<verse eid="NEH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 5:12" />बे कहीं, हम उनकै वापस दै देंगे, और उनसे कछु ना लेंगे; जैसो तैं कहथै, बैसोई हम करंगे। तौ मैं पुजारिन कै बुलाएकै बे लोगन कै जौ कसम खबाओ कि बे जहे बादा के हिसाब से करंगे। <verse eid="NEH 5:12" /><verse number="13" style="v" sid="NEH 5:13" />फिर मैं अपने लत्ता के छोर कै झारकै कहो, जहे रीति से जो कोई जौ बादा कै पूरो ना करै, बाकै परमेस्वर झारकै, बाको घर और कमाई बासे छुड़ाबै, और जहे रीति से बौ झारो जाबै, और कंगाल हुई जाबै। तौ पूरी सभा कही, “आमीन!” और प्रभु परमेस्वर की स्तुति करीं। तौ लोग जौ बादा के हिसाब से काम करीं।<verse eid="NEH 5:13" /></para>
  <para style="s">नहेम्याह की निस्वार्थ सेवा</para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 5:14" />फिर जब से मैं यहूदा देस मैं उनको सासक ठहराओ गौ, मतलब राजा अर्तछत्र के बीसमें साल से लैकै बाके बत्तीसमें साल ले, मतलब बाहरै साल ले मैं और मेरे भईय्या सासक के हक को खानु ना खाईं। <verse eid="NEH 5:14" /><verse number="15" style="v" sid="NEH 5:15" />पर मोसे पहले के अधिपति, बे प्रजा के ऊपर भारी बोझ डारत रहैं, और उनसे रोटी, और दाखमधु, और जाके संग चालीस सिक्का चाँदी लेत रहैं, और उनके सेवक भी प्रजा के ऊपर हक जतात रहैं; पर मैं ऐसो ना करत रहौं, काहैकि मैं प्रभु परमेस्वर को भय मानत रहौं। <verse eid="NEH 5:15" /><verse number="16" style="v" sid="NEH 5:16" />फिर मैं दीबार के काम मैं लिपटो रहो, और हम लोग कुछ जमीन मोल न लै; और मेरे सब सेवक काम करन के ताहीं, हुँआँ जुराने रहत रहैं। <verse eid="NEH 5:16" /><verse number="17" style="v" sid="NEH 5:17" />फिर मेरी मेज मैं खान बारे एक सौ पचास यहूदी और अधिकारी और बे भी रहैं, जो चारौ घाँईं के गैर यहूदी जाति मैं से हमरे झोने आए रहैं। <verse eid="NEH 5:17" /><verse number="18" style="v" sid="NEH 5:18" />जो हर दिन के ताहीं तैयार करो जात रहै, बौ एक बरधा, छै अच्छी-अच्छी भेंड़ और बकरिया रहैं, और मेरे ताहीं मुर्गिया भी तैयार करी जात रहै; दस-दस दिन के बाद तमान तराहनी को दाखमधु भी तैयार करो जात रहै; पर तहुँओं मैं अधिपति के हक को भोज ना लौ,<verse eid="NEH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 5:19" />काहैकि काम को भार प्रजा के ऊपर भारी रहै। हे मेरे परमेस्वर! जो कछु मैं जौ प्रजा के ताहीं करो हौं, बाकै तैं मेरे हित के ताहीं याद रख।<verse eid="NEH 5:19" /></para>
  <chapter eid="NEH 5" />
  <chapter number="6" style="c" sid="NEH 6" />
  <para style="s">नहेम्याह के खिलाफ चाल</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 6:1" />जब सम्बल्लत, तोबियाह और अरबी गेसेम और हमरे दुसरे दुस्मन कै जौ खबर मिली, कि मैं दीबार कै बनबाए चुको; और बौ समय तक भी मैं फाटकन मै पल्ला नाय लगाए पाओ रहौं, और दीबार मैं कोई दरार नाय बची रहै। <verse eid="NEH 6:1" /><verse number="2" style="v" sid="NEH 6:2" />तौ सम्बल्लत और गेसेम मेरे झोने जौ खबर भेजीं, “आ, आपन ओनो के मैदान के कोई गाँव मैं एक दुसरे से भेंट करैं।” पर बे मेरो नुकसान करन की इच्छा करत रहैं। <verse eid="NEH 6:2" /><verse number="3" style="v" sid="NEH 6:3" />पर मैं उनके झोने दूत के जरिये जौ जबाब दौ, “मैं तौ भारी काम मैं लगो हौं, हुँआँ नाय जाए सकथौ; मेरे जाकै छोड़कै, तुमरे झोने जान से जौ काम काहे बंद रहै?”<verse eid="NEH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 6:4" />फिर बे चार बार मेरे झोने बैसिये खबर भेजीं, और मै उनकै बैसिये जबाब दौ।<verse eid="NEH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 6:5" />तौ पाँचमी बार सम्बल्लत अपने सेवक कै बिना मोहर बंद चिट्ठी दै कै मेरे झोने भेजी, <verse eid="NEH 6:5" /><verse number="6" style="v" sid="NEH 6:6" />जो मै जौ लिखो रहै, “जाति- जाति के लोगन मैं जौ कहो जाथै, और गेसेम भी जहे बात कहथै, कि तुमरी और यहूदियन की मनसा बगावत करन की है, और तभई तू बौ दीबार कै बनवाथै; और तू जे बातन के जैसी बाको राजा बननो चाहथै। <verse eid="NEH 6:6" /><verse number="7" style="v" sid="NEH 6:7" />तू यरूसलेम मैं नवी ठहरो है, जौ कहकै तेरे बारे मैं प्रचार करै, कि यहूदियन मैं एक राजा है। अब ऐसो ही समाचार राजा कै दौ जागो। तभई अब आ, हम एक संग सलाह करैं।”<verse eid="NEH 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 6:8" />तौ मैं अपने मालिक के झोने खबर भेजो, “जैसे तू कहथै, बैसे तौ कुछ भी नाय भौ, तैं जे बात अपने मन गढ़थै।”<verse eid="NEH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 6:9" />बे सब लोग जौ सोच कै हमैं डरानो चाहथै, “उनके हात ढीले पड़े, और काम बन्द ही जाए।” पर अब हे परमेस्वर, तू मोकै हिम्मत दे।<verse eid="NEH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 6:10" />फिर मैं समायाह के घरै गौ, तौ जो दलायाह को लौड़ा और महेटबेल को नतिया जे खुदकै घर मैं बंद करे होथैं, तौ बे मोसे कहीं, “आ, आपन परमेस्वर के मंदिर के भीतर आपस मै भेंट करैं, और मंदिर के मोहोट बन्द करैं; काहैकि बे लोग तोकै मारन कै आंगे, रात मै ही तोकै मारन कै आंगे।”<verse eid="NEH 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 6:11" />पर मैं कहो, “का मेरे जैसी आदमी कै भाजनो सई है? और मेरे जैसो कौन है जो अपनी जान बचान के ताहीं मंदिर मैं घुसैगो? ऐसो मैं न करंगो।”<verse eid="NEH 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 6:12" />फिर मैं जान लौ की बौ परमेस्वर को भेजो भौ नाय है, पर बौ सब बात परमेस्वर को वचन कहकै मेरो नुकसान के ताहीं कही, काहैकि तोबियाह और सम्बल्लत बाकै रूपईया दै रखाई रहै। <verse eid="NEH 6:12" /><verse number="13" style="v" sid="NEH 6:13" />बे जाके जौ बजह से रूपईया दै रखाई रहैं, कि मैं डराए जामौं, और बैसिये काम करकै पापी रहमौं, और उनकै दोस लगान को मौका मिलै, और बे मोए बदनाम कर सकैं।<verse eid="NEH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 6:14" />हे मेरे परमेस्वर! तोबियाह, सम्बल्लत, और नोअद्याह, नवी और दुसरे जित्ते नबी मोकै डरपानो चाहथैं, उनके सब ऐसे कामन की खबर रख।<verse eid="NEH 6:14" /></para>
  <para style="s">निर्माड़ के काम को समापन</para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 6:15" />एलूल महेना के पच्चीसवें दिन कै मतलब बावन दिन के भीतर दीबार बन गई। <verse eid="NEH 6:15" /><verse number="16" style="v" sid="NEH 6:16" />जब हमारे सब दुस्मन जौ सुनीं, तौ हमरे चारौ घाँईं रहनबारे सब गैरयहूदी जाति के डराएगै, और गजब बेजती महसूस करीं; काहैकि बे जान लईं कि जौ काम हमारे परमेस्वर की घाँईं से भौ।<verse eid="NEH 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 6:17" />बे दिनन मैं भी यहूदी नेता और तोबियाह के बीच चिट्ठी भौत आए-जाए करत रहै। <verse eid="NEH 6:17" /><verse number="18" style="v" sid="NEH 6:18" />काहैकि बौ आरह के लौड़ा सकन्याह को दमदा रहै, और बाके लौड़ा यहोहानान बेरेक्याह के लौड़ा मसुल्लाम की लौड़िया कै बिहाए लई रहै; जौ बजह से भौत से यहूदी बाको पक्छ लेन के ताहीं कसम खाए पड़े रहैं। <verse eid="NEH 6:18" /><verse number="19" style="v" sid="NEH 6:19" />बे मेरे होने मैं बाके भले कामन की चर्चा करे करते, और मेरी बातैं भी बाकै सुनाए करते। तोबियाह मोकै डरपान के ताहीं चिट्ठी भेजे करत रहै।<verse eid="NEH 6:19" /></para>
  <chapter eid="NEH 6" />
  <chapter number="7" style="c" sid="NEH 7" />
  <para style="p">
    <verse number="1" style="v" sid="NEH 7:1" />जब दीबार बन गई, और मैं बाके फाटक खड़ो करो, और द्वारपाल, और गवईय्या, और लेवी अधिकारी लोग ठहराए गै, <verse eid="NEH 7:1" /><verse number="2" style="v" sid="NEH 7:2" />तभई मैं अपने भईय्या हनानी और राजगढ़ के अधिकारी हनन्याह कै यरूसलेम को अधिकारी ठहराओ, काहैकि जौ सच्चो आदमी और निरेन से जाधे परमेस्वर को भय मानन बारो रहै। <verse eid="NEH 7:2" /><verse number="3" style="v" sid="NEH 7:3" />और मैं उनसे कहो, “जब ले घामों कड़ाके को न होबै, तौले यरूसलेम के फाटक नाय खोले जामैं और जब रखबरिया गस्त करत होमैं, तभई फाटक बंद करे जामैं और बेड़ी लगाईं जामैं। फिर यरूसलेम रहनबारे मैं से तू रखबरिया ठहरा, जो अपनो-अपनो गस्त अपने-अपने घर के अग्गु दे करैं।”<verse eid="NEH 7:3" /></para>
  <para style="s">निर्वासन से वापस लौटे लोगन की सूची</para>
  <para style="r">(<ref loc="EZR 2:1-70">एज्रा 2:1-70</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 7:4" />सहर तौ लम्बो चौंड़ो रहै, लेकिन बामैं लोग थोड़ी रहैं, और घर नाय बने रहैं। <verse eid="NEH 7:4" /><verse number="5" style="v" sid="NEH 7:5" />तौ मेरो परमेस्वर मेरो मन मै जौ उपजाओ कि नेता, बड़े अधिकारी और लोगन कै इसलै इकट्टो करौं, कि बे अपनी बंसावली के जरिया गिने जामैं। मोकै पहले यरूसलेम कै आए भै की बंसावली किताब मिली, और बामैं मैं ऐसो लिखो भौ पाओ।<verse eid="NEH 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 7:6" />जिनकै बेबीलोन को राजा, नबूकदनेस्सर बंदी बनाएकै करकै लै गौ रहै, उनमैं से देस के जो लोग बँधुवाई से छुटकै, यरूसलेम और यहूदा के अपने-अपने सहर कै आए। <verse eid="NEH 7:6" /><verse number="7" style="v" sid="NEH 7:7" />बे जरुब्बाबेल, ईसु, नहेम्याह, अजर्याह, राम्याह, नहमानी, मोर्दकै, बिलसान, मिस्पेरेत, बिगवै, नेहूम और बानाह के संग आए। इस्राएली प्रजा के लोगन की गिनती जौ है।<verse eid="NEH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 7:8" />परोस की संतान दुई हजार एक सौ बहात्तर,<verse eid="NEH 7:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NEH 7:9" />सपत्याह की संतान तीन सौ बहात्तर,<verse eid="NEH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NEH 7:10" />आरह की संतान छै। सौ बावन,<verse eid="NEH 7:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NEH 7:11" />पहत्मोआब की संतान याने ईसु और योआब की संतान, दुई हजार आठ सौ अट्ठारह,<verse eid="NEH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NEH 7:12" />एलाम की संतान बाहरै सौ चऊवन,<verse eid="NEH 7:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 7:13" />जत्तू की संतान आठ सौ पैंतालीस,<verse eid="NEH 7:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NEH 7:14" />जक्कई की संतान सात सौ साठ,<verse eid="NEH 7:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 7:15" />बिन्नूई की संतान छै सौ अड़तालीस,<verse eid="NEH 7:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 7:16" />बेबै की संतान छै सौ अट्ठाईस,<verse eid="NEH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 7:17" />अजगाद की संतान दुई हजार तीन सौ बाईस,<verse eid="NEH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 7:18" />अदोनीकाम की संतान छै सौ सड़सठ,<verse eid="NEH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 7:19" />बिगवै की संतान दुई हजार सड़सठ,<verse eid="NEH 7:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 7:20" />आदीन की संतान छै सौ पचपन,<verse eid="NEH 7:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 7:21" />हिजकिय्याह की संतान आतेर बंस से अट्ठानबै,<verse eid="NEH 7:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NEH 7:22" />हासूम की संतान तीन सौ अट्ठाईस,<verse eid="NEH 7:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NEH 7:23" />बेसई की संतान तीन सौ चौबीस,<verse eid="NEH 7:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NEH 7:24" />हारीप की संतान एक सौ बाहरै,<verse eid="NEH 7:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NEH 7:25" />गिबोन लोग पिचानबे,<verse eid="NEH 7:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NEH 7:26" />बैतलहम और नत्तोपा इंसान एक सौ अट्ठासी,<verse eid="NEH 7:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NEH 7:27" />अनातोत के इंसान एक सौ अट्ठाईस,<verse eid="NEH 7:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NEH 7:28" />बेतजमावत के इंसान बयालीस,<verse eid="NEH 7:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="NEH 7:29" />किर्यत्यारीम, कपीरा, और बेरोत के इंसान सात सौ तैंतालिस,<verse eid="NEH 7:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NEH 7:30" />रामा और गेबा इंसान के छै सौ इक्कीस,<verse eid="NEH 7:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="NEH 7:31" />मिकमास के इंसान एक सौ बाईस,<verse eid="NEH 7:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="NEH 7:32" />बेतेल और ए के इंसान एक सौ तेईस,<verse eid="NEH 7:32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="NEH 7:33" />दूसरो नेबो इंसान बावन,<verse eid="NEH 7:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NEH 7:34" />दूसरो एलाम औलाद बाहरै सौ चऊवन,<verse eid="NEH 7:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="NEH 7:35" />हारीम औलाद तीन सौ बीस,<verse eid="NEH 7:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="NEH 7:36" />यरीहो लोग तीन सौ पैंतालीस,<verse eid="NEH 7:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="NEH 7:37" />लोद हदीद और ओनो लोग सात सौ इक्कीस,<verse eid="NEH 7:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="NEH 7:38" />सनाआ का लोग तीन हजार नौ सौ तीस।<verse eid="NEH 7:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="NEH 7:39" />फिर पुजारी मतलब ईसु घराने से यदायाह की संतान नौ सौ तिहत्तर,<verse eid="NEH 7:39" /></para>
  <para style="q2">
    <verse number="40" style="v" sid="NEH 7:40" />इम्मेर की संतान एक हजार बावन,<verse eid="NEH 7:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="NEH 7:41" />पसहूर की संतान बाहरै सौ सैंतालिस,<verse eid="NEH 7:41" /></para>
  <para style="q2">
    <verse number="42" style="v" sid="NEH 7:42" />हारीम की संतान एक हजार सत्रह। <verse eid="NEH 7:42" /><verse number="43" style="v" sid="NEH 7:43" />फिर लेवी जे रहैं: होदवा बंस से कदमीएल की संतान ईसु की संतान चौहत्तर।<verse eid="NEH 7:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="NEH 7:44" />फिर गबईय्या जे रहैं: आसाप की संतान एक सौ अड़तालीस।<verse eid="NEH 7:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="NEH 7:45" />फिर द्वारपाल जे रहैं: सल्लूम की संतान, आतेर की संतान, तल्मोन संतान, अक्कूब की संतान, हतीता की संतान, और सोबई की संतान, जो सब मिलकै एक सौ अड़तीस भै। <verse eid="NEH 7:45" /><verse number="46" style="v" sid="NEH 7:46" />फिर मंदिर के नतीन मतलब सीहा की संतान, हसूपा की संतान, तब्बाओत।<verse eid="NEH 7:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="NEH 7:47" />तब्बाओत की संतान, केरोस की संतान, सीआ की संतान, पादोन की संतान,<verse eid="NEH 7:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="NEH 7:48" />लबाना की संतान, हगाब की संतान, समलई की संतान,<verse eid="NEH 7:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="NEH 7:49" />हानान की संतान, गिद्देल की संतान, गहर की संतान,<verse eid="NEH 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="NEH 7:50" />रायाह की संतान, रसीन की संतान, नकोदा की संतान,<verse eid="NEH 7:50" /></para>
  <para style="q2">
    <verse number="51" style="v" sid="NEH 7:51" />गज्जाम की संतान, उज्जा की संतान, पासेह की संतान,<verse eid="NEH 7:51" /></para>
  <para style="q2">
    <verse number="52" style="v" sid="NEH 7:52" />बेसई की संतान, मुनीम की संतान, नपूसस की संतान,<verse eid="NEH 7:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="NEH 7:53" />बकबूक की संतान, हकूपा की संतान, हर्हूर की संतान,<verse eid="NEH 7:53" /></para>
  <para style="q2">
    <verse number="54" style="v" sid="NEH 7:54" />बसलीत की संतान, महीदा की संतान, हर्सा की संतान,<verse eid="NEH 7:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="NEH 7:55" />बर्कोस की संतान, सीसरा की संतान, तेमह की संतान,<verse eid="NEH 7:55" /></para>
  <para style="q2">
    <verse number="56" style="v" sid="NEH 7:56" />नसीह की संतान, और हतीपा की संतान, <verse eid="NEH 7:56" /><verse number="57" style="v" sid="NEH 7:57" />फिर सुलेमान दासन औलाद सोतई की संतान, सोपेरेत की संतान, परीदा की संतान,<verse eid="NEH 7:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="NEH 7:58" />याला की संतान, दर्कोन की संतान, गिद्देल की संतान,<verse eid="NEH 7:58" /></para>
  <para style="q2">
    <verse number="59" style="v" sid="NEH 7:59" />सपत्याह की संतान, हत्तील की संतान, पोकरेत सवायीम की संतान, और आमोन की संतान।<verse eid="NEH 7:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="NEH 7:60" />ऐसे करकै मंदिर के नतीन सुलेमान के दासन की संतान मिलकै तीन सौ बयानबै रहैं।<verse eid="NEH 7:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="NEH 7:61" />और जे बे हैं, जो तेलमेलह, तेलहर्सा, करूब, अद्दोन, और इम्मेर यरूसलेम कै गै, लेकिन अपने-अपने पुरखा के घराने और बंसावली नाय बताए सके, कि इस्राएल के हैं या नाय। <verse eid="NEH 7:61" /><verse number="62" style="v" sid="NEH 7:62" />दलायाह की संतान, तोबियाह की संतान, और नकोदा की संतान, जो सब मिलकै छै सौ बयालीस रहैं।<verse eid="NEH 7:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NEH 7:63" />और पुजारिन मै से हबायाह की संतान, हक्कोस की संतान, और बर्जिल्लै की संतान, जो गिलादी बर्जिल्लै की लौड़ियन मैं से एक बिहा कर लई, और उन्हईं को नाओं रख लई रहै। <verse eid="NEH 7:63" /><verse number="64" style="v" sid="NEH 7:64" />जे अपनी-अपनी बंसावली की चिट्ठी दुसरे बंसावली की चिट्ठिन मैं ढूँड़ीं, लेकिन नाय पाईं, इसलै बे असुद्ध ठहरकै पुजारी पद से निकारे गै; <verse eid="NEH 7:64" /><verse number="65" style="v" sid="NEH 7:65" />और यहूदी राज्यपाल उनसे कही, कि जब ले ऊरीम और तुम्मीम धारड़ करनबारो कोई पुजारी ना उठै, तौ ले तुम कोई परमपवित्र चीज नाय खाए पागे।<verse eid="NEH 7:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="NEH 7:66" />पूरे झुंग के लोग मिलाएकै बयालीस हजार तीन सौ साठ ठहरे।<verse eid="NEH 7:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="NEH 7:67" />इनकै छोड़कै उनके सात हजार तीन सौ सैंतीस दास - दासी, और दुई सौ पैंतालीस गबईय्यन को झुंग रहै।<verse eid="NEH 7:67" /></para>
  <para style="q2">
    <verse number="68" style="v" sid="NEH 7:68" />उनके ऊँट और घोड़ा सात सौ छत्तीस, गधा दुई सौ पैंतालीस,<verse eid="NEH 7:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="NEH 7:69" />ऊँट चार सौ पैंतीस और गधा छै हजार सात सौ बीस रहै।<verse eid="NEH 7:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="NEH 7:70" />और पुरखन के घराने के निरे एक खास लोग काम के ताहीं दान दईं। राज्यपाल तौ चंदा मैं हजार दर्कमोन सोना, पचास कटोरा और पाँच सौ तीस पुजारिन के चोंगा दईं। <verse eid="NEH 7:70" /><verse number="71" style="v" sid="NEH 7:71" />और पुरखन के घराने के निरे खास लोग, बौ काम के चंदा मैं बीस हजार दर्कमोन और दुई हजार दुई सौ माना चाँदी दईं। <verse eid="NEH 7:71" /><verse number="72" style="v" sid="NEH 7:72" />बाकी प्रजा जो दईं, बौ बीस हजार दर्कमोन, दुई हजार माना चाँदी और सड़सठ पुजारिन के चोंगा दईं। <verse eid="NEH 7:72" /><verse number="73" style="v" sid="NEH 7:73" />ऐसे करकै पुजारी, लेवी, द्वारपाल, मोहड़ी, प्रजा के कुछ लोग और नतीन और सब इस्राएली अपने-अपने सहर मैं रहन लगे। जब सातमों महेना सुरू भौ, तौ ले इस्राएली लोग अपने-अपने नगर मैं बस चुके रहैं।<verse eid="NEH 7:73" /></para>
  <chapter eid="NEH 7" />
  <chapter number="8" style="c" sid="NEH 8" />
  <para style="s">एज्रा लोगन के ताहीं कानून पढ़थै</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 8:1" />जब सातमों महेना झोने आओ, बौ समय सब इस्राएली अपने-अपने सहर मैं रहैं, तभई बे सब लोग एक मन हुईकै, पानी फाटक के सामने के चौराह मैं इकट्टो हुई कै, एज्रा यहूदी नियम के सिक्छक से कही, कि मूसा की जो नियम कानून प्रभु परमेस्वर इस्राएलिन कै दई है, बौ किताब लै आ। <verse eid="NEH 8:1" /><verse number="2" style="v" sid="NEH 8:2" />तौ एज्रा पुजारी सातमों महेना के पहले दिन कै का बईय्यर, का लोग, जित्ते सुनकै समझ सकत रहैं, बे सबन के सामने कानून किताब कै लै आई। <verse eid="NEH 8:2" /><verse number="3" style="v" sid="NEH 8:3" />बे बाकी बात भोर से दुपारी ले बौ चौराह के अग्गु जो पानी फाटक के अग्गु रहै, का बईय्यर, का लोग और सब समझन बारेन कै पढ़कै सुनात रहो; और लोग व्यवस्था की किताब मैं कान लगाए कै ध्यान से सुनत रहैं।<verse eid="NEH 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 8:4" />एज्रा सास्त्री, काठ के एक मचान मै जो जहे काम के ताहीं बनो रहै, और खड़ो ही गौ; और बाकी दहने घाँईं मत्तित्याह, सेमा, अनायाह, ऊरिय्याह, हिल्किय्याह और मासेयाह; और बाईं घाँईं, पदायाह, मीसाएल, मल्किय्याह, हासूम, हस्बद्दाना, जकर्याह और मसुल्लाम खड़े भै।<verse eid="NEH 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 8:5" />तब एज्रा जौ सब लोगन से ऊँचे मैं रहै, सबकै देखत भै बौ किताब कै खोल दई; और जब बौ बाकै खोली, तौ सब लोग उठ खड़े ही गै।<verse eid="NEH 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 8:6" />तब एज्रा महान परमेस्वर प्रभु परमेस्वर कै धन्य कही; और सब लोग जहे रीति अपने-अपने हात उठाएकै आमीन, आमीन, कहीं; और मुड़िया झुकाएकै अपनो-अपनो घुटनो टिकाएकै प्रभु परमेस्वर कै दंडवत करीं।<verse eid="NEH 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 8:7" />येसुआ, बानी, सेरेब्याह, यामीन, अक्कूब, सब्बतै, होदिय्याह, मासेयाह, कलीता, अजर्याह, योजाबाद, हानान और पलायाह नामक लेवी, लोगन कै व्यवस्था समझात गै, और लोग अपने-अपने जघा मै खड़े रहे। <verse eid="NEH 8:7" /><verse number="8" style="v" sid="NEH 8:8" />बे परमेस्वर की व्यवस्था की किताब से पढ़कै मतलब समझा दई; और लोग पाठ कै समझ लईं।<verse eid="NEH 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 8:9" />तब नहेम्याह जो अधिपति रहै, और एज्रा जो पुजारी और सास्त्री रहै, और जो लेवी लोगन कै समझत रहैं, बे सब लोगन से कहीं, “आज को दिन तुमरे परमेस्वर प्रभु परमेस्वर के ताहीं पवित्र है; तभई विलाप मत करौ और नाय रोबौ।” काहैकि सब लोग व्यवस्था के वचन सुनकै रोत रहैं। <verse eid="NEH 8:9" /><verse number="10" style="v" sid="NEH 8:10" />फिर नहेम्याह उनसे कहीं, “जाएकै अच्छो-अच्छो खानु खाबौ और मीठो-मीठो रस पीबौ, और जोके ताहीं कुछ तैयार नाय भौ उनके झोने खानु की सामग्री भेजौ; काहैकि आज को दिन हमारे प्रभु के ताहीं पवित्र है; और उदास मत होबौ, काहैकि प्रभु परमेस्वर को आनन्द तुमरो दृढ़ गढ़ है।”<verse eid="NEH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 8:11" />फिर लेवियन सब लोगन कै जौ कहकै चुप कराए दई, “चुप रहबौ काहैकि आज को दिन पवित्र है; और उदास मत रहबौ।” <verse eid="NEH 8:11" /><verse number="12" style="v" sid="NEH 8:12" />तब सब लोग खानु, पीनो, खानु सामग्री भेजन और बड़ा आनन्द मनान कै चले गै, काहैकि जो वचन उनकै समझाए गै रहैं, और बे समझ गै रहैं।<verse eid="NEH 8:12" /></para>
  <para style="s">झोपड़ियन को त्योहार</para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 8:13" />दूसरे दिन भी पूरी प्रजा के पितरन के घराने के मुख्य-मुख्य आदमी और पुजारी और लेवी लोग, एज्रा सास्त्री के झोने व्यवस्था के वचन ध्यान से सुनन के ताहीं इकट्ठे भै। <verse eid="NEH 8:13" /><verse number="14" style="v" sid="NEH 8:14" />उनकै व्यवस्था मैं जौ लिखो भौ मिलो, कि प्रभु परमेस्वर मूसा कै जौ आग्या दई रहै, कि इस्राएली सातवें महेना के त्योहार के समय झोपड़ियन मैं रहै मैं, <verse eid="NEH 8:14" /><verse number="15" style="v" sid="NEH 8:15" />और अपने सब नगरन और यरूसलेम मैं जौ सुनाई और जौ प्रचार करो जाबै, “पहाड़ मै जाएकै जैतून, तैलवृक्ष, मेंहदी, देवदार, खजूर और घने-घने पेंड़न की हंगईय्यन कै लै आएकै झोपड़ियन कै बनबाबौ, जैसो कि लिखो है।”<verse eid="NEH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 8:16" />फिर सब लोग बाहर जाएकै हंगईय्यन कै लै आईं, और अपने-अपने घर के ऊपर मै , और अपने आँगन मैं, और परमेस्वर के भवन के आँगन मैं, और जलफाटक के चौक मैं, और एप्रेम के फाटक के चौक मैं, झोपड़ियन कै बनाए लईं। <verse eid="NEH 8:16" /><verse number="17" style="v" sid="NEH 8:17" />फिर सब मंडली के लोग जितने बँधुआई से छुटकै लौट आए रहैं, झोपड़ियन कै बनाएकै बामैं रहन लगे। नून के लौड़ा यहोसू के दिनन से लैकै बौ दिन तक इस्राएलियन ऐसो नाय करीं रहैं। बौ समय भौत बड़ो आनन्द भौ। <verse eid="NEH 8:17" /><verse number="18" style="v" sid="NEH 8:18" />फिर पहले दिन से अन्तिम दिन तक एज्रा हरदिन परमेस्वर की व्यवस्था की किताब मैं से पढ़ पढ़कै सुनाई। बे सात दिन तक त्योहार कै मानत रहे, और आठवें दिन नियम के जैसी महासभा भई।<verse eid="NEH 8:18" /></para>
  <chapter eid="NEH 8" />
  <chapter number="9" style="c" sid="NEH 9" />
  <para style="s">लोगन के पाप स्वीकार</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 9:1" />फिर बहे महेना के चौबीसमें दिन कै इस्राएली उपवास मै टाट पहने और मुड़िया मैं धुधर डारे भै इकट्ठो भै, बे ऐसो इसलै करथैं काहैकि जौ दुख और पस्चाताप जतान को एक तरीका है। <verse eid="NEH 9:1" /><verse number="2" style="v" sid="NEH 9:2" />तौ इस्राएल के बंस के लोग गैरयहूदी लोगन से अलग ही गै, और ठाड़कै अपने-अपने पापन और अपने पुरखन के अधर्म के कामन कै मान लईं। <verse eid="NEH 9:2" /><verse number="3" style="v" sid="NEH 9:3" />तौ बे अपनी-अपनी जघा मैं ठाड़कै दुपारी ले अपने परमेस्वर की व्यवस्था की किताब पढ़त रहैं, और संझाखिन के तीसरो पहर मै बे अपने पापन कै मानते, और अपने प्रभु परमेस्वर कै दंडवत करते।<verse eid="NEH 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 9:4" />और ईसु, बानी, कदमीएल, सबन्याह, सेरेब्याह, बानी और कनानी लेवियन की सीढ़ी मैं ठाड़कै ऊँची आबाज मैं अपने प्रभु परमेस्वर की दुहाई दई।<verse eid="NEH 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 9:5" />फिर येसुआ, कदमीएल, बानी, हसब्नयाह, सेरेब्याह, होदिय्याह, सबन्याह, और पतहाह नाओं लेवी कहीं,</para>
  <para style="q1" vid="NEH 9:5">“ठाड़ जाबौ, अपने प्रभु परमेस्वर</para>
  <para style="q2" vid="NEH 9:5">कै अनादिकाल से अनन्तकाल तक धन्य कहियो।</para>
  <para style="q1" vid="NEH 9:5">तेरो महीमायुक्त नाओं धन्य कहो जाबै,</para>
  <para style="q2" vid="NEH 9:5">जो सब आसीस और स्तुति से अलग है।”<verse eid="NEH 9:5" /></para>
  <para style="s">स्वीकार की प्रार्थना</para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 9:6" />तहीं एकै प्रभु है;</para>
  <para style="q1" vid="NEH 9:6">स्वर्ग और सबसे ऊँचे स्वर्ग और बाके सब गड़,</para>
  <para style="q2" vid="NEH 9:6">और पृथ्वी और जो कुछ बामैं है,</para>
  <para style="q1" vid="NEH 9:6">और समुंदर और जो कुछ बामैं है,</para>
  <para style="q2" vid="NEH 9:6">सब कुछ तुहीं बनाओ है,</para>
  <para style="q1" vid="NEH 9:6">और सब की रक्छा तुहीं करथै; स्वर्ग की पूरी सेना तुहीं कै दंडवत करथै।<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">व्यवस्थाविवरड़ 6:4, निर्गमन 20:11</char></note><verse eid="NEH 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NEH 9:7" />हे प्रभु! तू बहे परमेस्वर है, जो अब्राम कै चुनो</para>
  <para style="q2" vid="NEH 9:7">और कसदियन के देस से ऊर नगर मैं से निकार लाओ,</para>
  <para style="q2" vid="NEH 9:7">और बाको नाओं अब्राहम रखो;<verse eid="NEH 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NEH 9:8" />और बाके मन कै विस्वासयोग्य पाएकै,</para>
  <para style="q2" vid="NEH 9:8">बासे वाचा बाँधी,</para>
  <para style="q1" vid="NEH 9:8">कि मैं तेरे वंस कै कनानी,</para>
  <para style="q2" vid="NEH 9:8">हित्तियन, एमोरियन,</para>
  <para style="q2" vid="NEH 9:8">परिज्जियन, यबूसियन, और गिर्गासियन</para>
  <para style="q2" vid="NEH 9:8">को देस देमंगो;</para>
  <para style="q1" vid="NEH 9:8">और तू अपनो बौ वचन पूरो भी करो है, काहैकि तू धर्मी है।<verse eid="NEH 9:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NEH 9:9" />“फिर तू रेगिस्तान मिस्र मैं हमरे बड़े-बूढ़ेन के दुखन के ऊपर नजर करो;</para>
  <para style="q2" vid="NEH 9:9">और लाल समुंदर के घाट मैं उनको रोनो सुनो।”<verse eid="NEH 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NEH 9:10" />आयगुप्त को राजा और बाके सब कर्मचारी</para>
  <para style="q2" vid="NEH 9:10">और बाके देस के सब लोगन कै दंड देन के ताहीं चिन्ह और चमत्कार दिखाओ;</para>
  <para style="q2" vid="NEH 9:10">काहैकि तू जानत रहै कि बे उनसे अभिमान करत रहैं;</para>
  <para style="q1" vid="NEH 9:10">और तू अपनो ऐसो बड़ो नाओं करो, जैसो आज तक हबै ले है।<verse eid="NEH 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NEH 9:11" />और तू उनके अग्गू समुंदर के ऐसे दुई भाग करो,</para>
  <para style="q2" vid="NEH 9:11">कि बे समुंदर के बीच सूखी जमीन चलकै पार ही गै;</para>
  <para style="q1" vid="NEH 9:11">और जो उनके पिच्छू पड़े रहैं, उनकै तू गहरी जघन मैं डार दौ,</para>
  <para style="q2" vid="NEH 9:11">जैसे कि पत्थर समुंदर मैं डारो जाबै।<verse eid="NEH 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NEH 9:12" />फिर तू दिन कै बादर के खम्मा मैं हीकै और रात कै आगी के खम्मा मैं हीकै उनकी अगुवाई करो,</para>
  <para style="q2" vid="NEH 9:12">कि जो रस्ता मैं उनकै चलने रहै, बामैं उनकै उजयारो मिलै।<verse eid="NEH 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NEH 9:13" />फिर तू सीनै पहाड़ मैं उतरकै आसमान मैं से उनके संग बात करो, और उनकै सीधे नियम, सच्ची व्यवस्था, और अच्छी विधियन, और आग्या दौ।<verse eid="NEH 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NEH 9:14" />उनकै अपने पवित्र विस्राम दिन को ग्यान दौ, और अपने दास मूसा के हानी आग्या और नियमन कै और व्यवस्था दौ।<verse eid="NEH 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NEH 9:15" />और उनकी भूँख मिटान कै आकास से उनकै खानु दई और उनकी प्यास बुझान कै चट्टान मैं से उनके ताहीं पानी निकारी, और उनकै आग्या दई कि जो देस कै तुमकै देन की मैं हात उठाएकै कसम खाओ हौं बाके अधिकारी होन कै तुम बामैं जाबौ।<verse eid="NEH 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NEH 9:16" />फिर बे और हमारे पुर्खन मै अभिमान करी, और हठीले बने और तेरी आग्या नाय मानी;<verse eid="NEH 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NEH 9:17" />और आग्या मानन से मना करीं, और जो अचम्मे काम तू उनके बीच करो रहै, उनकै याद नाय करीं, फिर हठ करकै इतै तक बलवा करनबारे बने, कि एक प्रधान ठहराबौ, कि अपने दासत्व की दसा मैं लौटे। फिर तू छमा करनबारो अनुग्रहकारी और दयालु, देर से कोप करनबारो, और अति करूड़ामय परमेस्वर है, तू उनकै नाय त्यागो।<verse eid="NEH 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NEH 9:18" />फिर बे बछड़ा की मूर्ति बनाएकै कहीं,</para>
  <para style="q2" vid="NEH 9:18">तुमरो परमेस्वर जो तुमकै मिस्र देस से छुड़ाए कै लाई है बौ जहे है!</para>
  <para style="q1" vid="NEH 9:18">और बे प्रभु तेरो भौत तिरस्कार करीं!<verse eid="NEH 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NEH 9:19" />तौभी तू जो अति दयालु है, उनकै जंगल मैं नाय छोड़ो; नाय तौ दिन कै अगुवाई करनबारो बादर कै खम्मा बामैं से हटा, और नाय रात कै उजियारो देनबारो और उनकै मार्ग दिखानबारो आगी को खम्मा।<verse eid="NEH 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NEH 9:20" />फिर तू उनकै समझान के ताहीं अपनी आत्मा कै जो भलो है दई, और अपनो मन्ना उनकै खबान नाय छोड़ी, और उनकी प्यास बुझान कै पानी देत रहौ।<verse eid="NEH 9:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NEH 9:21" />चालीस साल तक तू जंगल मैं उनकै ऐसो पालन-पोसँड़ करत रहौ, कि उनकै कुछ घटी नाय भई; न तौ उनके लत्ता पुराने भै और न उनके पाँव मैं सूजन भई।<verse eid="NEH 9:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="NEH 9:22" />फिर तू राज्य-राज्य और देस-देस के लोगन कै उनके वश मैं कर दई, और दिसा-दिसा मैं उनकै बाँट दई; फिर बे हेसबोन के राजा सीहोन और बासान के राजा ओग दोनों के देसन के अधिकारी ही गै।<verse eid="NEH 9:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NEH 9:23" />फिर तू उनकी सन्तान कै आसमान के तारन के समान बढ़ाएकै बे बौ देस मै पहुँचाए दई, जोके बारे मैं तू उनके पुरखन से कहो रहै; कि बे बामैं जाएकै बाके अधिकारी ही जाँगे।<verse eid="NEH 9:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NEH 9:24" />उनके बंसज हुँआँ जाएकै उनके अधिकारी ही गै, और तू उनके जरिये देस के निवासी कनानी कै दबाई, और राजन और देस के लोगन समेत उनकै, उनके हात मैं सौंप दई, कि बे उनके संग मनचाहों व्यवहार करैं।<verse eid="NEH 9:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NEH 9:25" />बे गढ़बारे नगर और उपजाऊ जमीन लै लईं, और सब जैसी को अच्छे समान से भरे भै घरन के, और खुदै भै हौदन के, और दाख और जैतून की बारियन के, और खान के फलबारे भौत से पेंड़न के अधिकारी ही गै; बे बाकै खाए खाएकै मगन भै, और हस्ट-पुस्ट ही गै, और तेरी बड़ी भलाई के कारड़ सुख भोगत रहै।<verse eid="NEH 9:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="NEH 9:26" />फिर बे तोसे फिरकै बगावत करनबारे बन गै और तेरी व्यवस्था कै त्याग दईं, और तेरे जो नवी तेरे घाँईं उनकै फेरन के ताहीं उनकै चितात रहै उनकै बे घात करीं, और तेरो भौत तिरस्कार करीं।<verse eid="NEH 9:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="NEH 9:27" />फिर तू उनकै उनके दुस्मन के हात मैं कर दौ, और बे उनकै मुसीबत मैं डार दौ; तौ भी जब- जब बे मुसीबत मैं पड़कै तेरी दुहाई देत रहैं तब-तब तू स्वर्ग से उनकी सुनत रहौ; और तू जो अति दयालु है, तभई उनकै छुड़ानबारे कै भेजत रहौ जो उनकै दुस्मन के हातन से छुड़ात रहैं।<verse eid="NEH 9:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="NEH 9:28" />फिर जब-जब उनकै चैन मिलो, तब-तब बे फिर तेरे सामने बुराई करत रहैं, फिर तू उनकै दुस्मन के हात मैं कर देत रहै, और बे उन मै प्रभुता करत रहैं; तौ भी जब बे फिरकै रोएकै दोहाई देथैं, तब तू स्वर्ग से उनकी सुनते और तू जो दयालु है, तभई बार-बार उनकै छुड़ातो,<verse eid="NEH 9:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NEH 9:29" />और उनकै चितात रहौ कि उनकै फिर अपनी व्यवस्था के अधीन कर दे। फिर बे घमंड करत रहैं और तेरी आग्या नाय मानत रहैं, और तेरे नियम, जिनकै तुम लोग माने, तौ उनके जैसी जिन्दे रहे, उनके खिलाप पाप करते, और हठ करकै अपनो कंधा हटाते और नाय सुनत रहैं।<verse eid="NEH 9:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NEH 9:30" />तू तौ बड़ा साल तक उनकी सहत रहौ, और अपनी आत्मा से नवियन कै जैसी बे चितात रहौ, फिर बे कान नाय लगात रहैं, तभई तू बे देस-देस के लोगन के हात मैं सौंप दई।<verse eid="NEH 9:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="NEH 9:31" />तौ भी तू जो अति दयालु है, उनको अंत नाय कर डारौ और नाय उनकै त्याग दई, काहैकि तू अनुग्रहकारी और दयालु परमेस्वर है।<verse eid="NEH 9:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="NEH 9:32" />“अब तौ हे हमारे परमेस्वर! हे महान पराक्रमी और भययोग्य परमेस्वर! जो अपनी वाचा पालतो और करूड़ा करत रहौ है, जो बड़ा दुख, अस्सूर के राजन के दिनन से आज के दिन तक हमैं और हमारे राजन, अधिकारी, पुजारी, नवियन, पुर्खन, फिर तेरी पूरी प्रजा को भोगन पड़ो है, बे अपनी दृस्टि मैं कम नाय जानी!<verse eid="NEH 9:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="NEH 9:33" />तौ भी जो कुछ हम पर बीती है बाके बारे मैं तू तौ धर्मी है; तू तौ सच्चाई से काम करो है, हम तौ दुस्टता करे हैं।<verse eid="NEH 9:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NEH 9:34" />और हमरे राजन और अधिकारिन, पुजारी और पुरखन नाय तौ तेरी व्यवस्था कै मानी है और न तौ तेरी आग्या और चितौनियन के घाँईं ध्यान दई है जिनसे तू उनकै चिताथै।<verse eid="NEH 9:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="NEH 9:35" />बे अपने राज्य मैं, और बौ बड़े कल्याड़ के समय जो तू उनकै दौ रहै है, और जौ लम्बे चौड़े और उपजाऊ देस मैं तेरी सेवा नाय करी; और नाय अपने बुरे कामन से पश्चाताप करी।<verse eid="NEH 9:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="NEH 9:36" />देख, हम आजकल दास हैं; जो देस तू हमरे पितरन कै दौ रहै और बाकी उत्तम उपज खामैं, जहे मैं हम दास हैं।<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">एज्रा 9:9; व्यवस्थाविवरड़ 28:48 </char></note><verse eid="NEH 9:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="NEH 9:37" />जाकी उपज से बे राजन कै जिनकै तू हमरे पापन के कारँड़ हमरे ऊपर ठहराओ है, भौत धन मिलथै; और बे हमरे सरीरन और हमरे पसुअन मैं अपनी-अपनी इच्छा के अनुसार प्रभुता जताथैं, तभई हम बड़े संकट मैं पड़े हैं।”<verse eid="NEH 9:37" /></para>
  <para style="s">वाचा कै बाँधो जानो</para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 9:38" />जौ सब के कारँड़, हम सच्चाई के संग वाचा बाँधथैं, और लिख भी देथैं, और हमरे अधिकारी, लेवी और पुजारी बामैं छाप लगाथैं।<verse eid="NEH 9:38" /></para>
  <chapter eid="NEH 9" />
  <chapter number="10" style="c" sid="NEH 10" />
  <para style="p">
    <verse number="1" style="v" sid="NEH 10:1" />जो दस्तखत करीं बे जे हैं। हकल्याह को लौड़ा नहेम्याह जो राजा रहै, और सिदकिय्याह;<verse eid="NEH 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NEH 10:2" />सरायाह, अजर्याह, यिर्मयाह,<verse eid="NEH 10:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="NEH 10:3" />पसहूर, अमर्याह, मल्किय्याह;<verse eid="NEH 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NEH 10:4" />हत्तूस, सबन्याह, मल्लूक;<verse eid="NEH 10:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="NEH 10:5" />हारीम, मरेमोत, ओबघाह;<verse eid="NEH 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NEH 10:6" />दानिय्येल, गिन्नतोन, बारूक;<verse eid="NEH 10:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="NEH 10:7" />मसुल्लाम, अबिय्याह, मिय्यामीन;<verse eid="NEH 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NEH 10:8" />माज्याह, बिलगै और समायाह; जे तौ पुजारी रहैं।<verse eid="NEH 10:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="NEH 10:9" />लेवी जे रहैं: आजन्याह को लौड़ा ईसु, हेनादाद की सन्तान मैं से बिन्नूई और कदमीएल;<verse eid="NEH 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NEH 10:10" />और उनके भईय्या सबन्याह, होदिय्याह, कलीता, पलायाह, हानान;<verse eid="NEH 10:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="NEH 10:11" />मीका, रहोब, हसब्याह;<verse eid="NEH 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NEH 10:12" />जक्कूर, सेरेब्याह, सबन्याह;<verse eid="NEH 10:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="NEH 10:13" />होदिय्याह, बानी और बनीनू।<verse eid="NEH 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NEH 10:14" />लोगन के अगुवा जे रहैं: परोस, पहत्मोआब, एलाम, जत्तू, बानी;<verse eid="NEH 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NEH 10:15" />बुनी, अजगाद, बेबै;<verse eid="NEH 10:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="NEH 10:16" />अदोनिय्याह, बिगवै, आदीन;<verse eid="NEH 10:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="NEH 10:17" />आतेर, हिजकिय्याह, अज्जूर;<verse eid="NEH 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NEH 10:18" />होदिय्याह, हासूम, बेसई;<verse eid="NEH 10:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="NEH 10:19" />हारीप, अनातोत, नोबै;<verse eid="NEH 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NEH 10:20" />मग्पीआस, मसुल्लाम, हेजीर;<verse eid="NEH 10:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="NEH 10:21" />मेसेजबेल, सादोक, यदूद;<verse eid="NEH 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NEH 10:22" />पलत्याह, हानान, अनायाह;<verse eid="NEH 10:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="NEH 10:23" />होसे, हनन्याह, हस्सूब;<verse eid="NEH 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NEH 10:24" />हल्लोहेस, पिल्हा, सोबेक;<verse eid="NEH 10:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="NEH 10:25" />रहूम, हसब्ना, मासेयाह;<verse eid="NEH 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NEH 10:26" />अहिय्याह, हानान, आनान;<verse eid="NEH 10:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="NEH 10:27" />मल्लूक, हारीम और बाना।<verse eid="NEH 10:27" /></para>
  <para style="s">इस्राएलियन के जरिये कसम लेनो</para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 10:28" />बचे भै लोग मतलब पुजारी, लेवी, द्वारपाल, गबईय्यन और मन्दिर के सेवक, और जितने परमेस्वर की व्यवस्था कै मानन के ताहीं देस-देस के लोगन से अलग भै रहैं, बे सब अपनी बईंय्यरन और लौड़ा-लौड़ियन समेत जो समझन बारे रहैं, <verse eid="NEH 10:28" /><verse number="29" style="v" sid="NEH 10:29" />अपने भईय्या नेतन से मिलकै कसम खाई, कि हम परमेस्वर की बौ कानून के नियम मैं चलंगे जो बाके दास मूसा के जरिये से दई गई है, और अपने प्रभु परमेस्वर की सब आग्यन, नियमन, और बिधियन कै मानन मैं चौकसी करंगे।<verse eid="NEH 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 10:30" />हम ना तौ अपनी लौड़ियन कै जौ देस के लोगन कै बिहाए देंगे, और न लौड़न के ताहीं उनकी लौड़िया बिहाए लेंगे;<verse eid="NEH 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 10:31" />और जब जौ देस के लोग विस्राम दिन कै अन्न या कोई बिकाऊ चीज बेचन कै लैकै आंगे तौ हम उनसे ना तौ विस्रामदिन कै ना कोई पवित्र दिन कै कुछ लेंगे; और सातमें साल मैं जमीन पड़ी रहन देमंगे, और अपने-अपने लगान की वसूली छोड़ देमंगे।<verse eid="NEH 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NEH 10:32" />फिर हम सब जनी ऐसो नियम बाँध लै, जोसे हमकै अपने परमेस्वर के भवनकी सेवा करन के ताहीं हर साल एक-एक तिहाई सिक्का देने पड़ैगो।<verse eid="NEH 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NEH 10:33" />मतलब भेंट की रोटी नित्य अन्नबलि और नित्य होमबलि के ताहीं, और विस्राम दिनन, नये जोनी, और नियत त्योहारन के बलिदानन और दुसरी पवित्र भेंटन और इस्राएल के प्रास्चित के निमित्त पापबलियन के ताहीं, मतलब अपने परमेस्वर के भवन के सब कामन के ताहीं।<verse eid="NEH 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NEH 10:34" />फिर का पुजारी, का लेवी, का साधारँड़ लोग, हम सब भी जौ बात कै रोकन के ताहीं चिट्ठी डारे, कि अपने पूर्वजन के घरन के अनुसार हर साल ठहराए भै समय मैं कठिया की भेंट कानून की किताब मैं लिखी भई बात के अनुसार हम अपने प्रभु परमेस्वर की बेदी मैं जलान के ताहीं परमेस्वर के भवन मैं लाए करंगे।<verse eid="NEH 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NEH 10:35" />हम अपनी-अपनी जमीन की पहली उपज और सब अलग-अलग पेंड़ के पहले फल हर साल प्रभु के भवन मैं लै आमंगे।<verse eid="NEH 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NEH 10:36" />और कानून की किताब मैं लिखी भई बात के अनुसार, अपने-अपने पहले लौड़ा और जानवरन, मतलब पहले बरधा और मेम्नन कै अपने परमेस्वर के भवन मैं बे पुजारियन के झोने लाए करंगे, जो हमरे परमेस्वर के भवन मैं सेवा टहल करत हैं।<verse eid="NEH 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NEH 10:37" />हम अपनो पहलो मड़ो भौ चून, और उठाई भई भेंटन, और हर एक तराहनी के पेंड़न के फल, नया दाखमधु, ताजो तेल, अपने परमेस्वर के भवन की कुठरियन मैं पुजारियन के झोने, और अपनी-अपनी जमीन की उपज को दसमों हिस्सा लेवियन के झोने सेवा के ताहीं लाए करंगे; काहैकि बे लेवी हैं, जो हमरी खेती के सब नगरन मैं दसमांस लेथैं।<note caller="+" style="f"><char style="fr" closed="false">10:37 </char><char style="ft" closed="false">रोमियों 11:16; लैव्यवस्था 23:7</char></note><verse eid="NEH 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 10:38" />जब लेवी दसमांस लेमैं, तब-तब उनके संग हारून के लौड़न मैं से कोई पुजारी रहे करै; और लेवी दसमांसन को दसमांस हमरे परमेस्वर के भवन की कुठरियन मैं पहोंचाए करैं। <verse eid="NEH 10:38" /><verse number="39" style="v" sid="NEH 10:39" />काहैकि जो कुठरियन मैं पवित्र जघन के बर्तन और सेवा टलह करन बारे पुजारी, द्वारपाल, और गबईया रहत रहैं, बामैं इस्राएली लोग और लेवी अनाज, नये दाखमधु, ताजे तेल की उठाई भई भेंट पहोंचामंगे। जो तरहन से हम अपने परमेस्वर के भवन कै नाय छोड़ंगे।<verse eid="NEH 10:39" /></para>
  <chapter eid="NEH 10" />
  <chapter number="11" style="c" sid="NEH 11" />
  <para style="s">यरूसलेम मै रहनबारे लोग</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 11:1" />प्रजा के अधिकारी तौ यरूसलेम मैं रहत रहैं, और बचे भै लोग जौ ठहरान के ताहीं चिट्ठिन कै डारीं, कि दस मैं से एक इंसान यरूसलेम मैं, जो पवित्र नगर है, बस जामैं; और नौ इंसान दुसरे नगरन मैं बसैं। <verse eid="NEH 11:1" /><verse number="2" style="v" sid="NEH 11:2" />जो अपनिये इच्छा से यरूसलेम रहनो चाहीं बे सबन कै लोग आसीर्वाद दईं। <verse eid="NEH 11:2" /><verse number="3" style="v" sid="NEH 11:3" />बौ देस के मुख्य-मुख्य लोग जो यरूसलेम मैं रहत रहैं, बे जे हैं; पर यहूदा के नगरन मैं एक एक इंसान अपनी खुदकी जमीन मैं रहत रहै; मतलब इस्राएली, पुजारी, लेवी, नतीन और सुलेमान के दासन की औलाद।<verse eid="NEH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 11:4" />यरूसलेम मैं तौ कुछ यहूदी: और बिन्यामीन रहत रहै। यहूदिन मैं से तौ पेरेस के बंस को अतायाह जो उज्जियाह को लौड़ा रहै, जौ जकर्याह को लौड़ा, जौ अमर्याह को लौड़ा, जौ सपत्याह को लौड़ा, जौ महल्लेल को लौड़ा रहै।<verse eid="NEH 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 11:5" />मासेयाह जो बारूक को लौड़ा रहै, जौ कोल्होजे को लौड़ा, जौ हजायाह को लौड़ा, जौ अदायाह को लौड़ा, जौ योयारीब को लौड़ा, जौ जकर्याह को लौड़ा और जौ सीलोई को लौड़ा रहै।<verse eid="NEH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 11:6" />पेरेस के बंस के जो यरूसलेम मैं रहत रहैं, बे सब मिलाएकै चार सौ अड़सठ सूरवीर रहैं।<verse eid="NEH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 11:7" />बिन्यामीनियन मैं से सल्लू जो मसुल्लाम को लौड़ा रहै, जौ योएद को लौड़ा, जौ पदायाह को लौड़ा, जौ कोलायाह को लौड़ा, जौ मासेयाह को लौड़ा, जौ इतीएल को लौड़ा, जौ यसायाह को लौड़ा रहै।<verse eid="NEH 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 11:8" />बाके बाद गब्बै सल्लै जिनके झौने नौ सौ अट्ठाईस लोग रहैं। <verse eid="NEH 11:8" /><verse number="9" style="v" sid="NEH 11:9" />इनको प्रधान जिक्री को लौड़ा योएल रहै, और हस्सनूआ को लौड़ा यहूदा नगर के प्रधान को नायब रहै।<verse eid="NEH 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 11:10" />फिर पुजारिन मैं से योयारीब को लौड़ा यदायाह और याकीन,<verse eid="NEH 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 11:11" />और सरायाह जो परमेस्वर के भवन को प्रधान और हिल्किय्याह को लौड़ा रहै, जौ मसुल्लाम को लौड़ा, जौ सादोक को लौड़ा, जौ मरायोत को लौड़ा, जौ अहीतूब को लौड़ा रहै,<verse eid="NEH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 11:12" />इनके आठ सौ बाईस भईय्या जो बौ भवन को काम करत रहैं; और अदायाह, जो यरोहाम को लौड़ा रहै, जौ पलल्याह को लौड़ा, जौ अम्सी को लौड़ा, जौ जकर्याह को लौड़ा, जौ पसहूर को लौड़ा, जौ मल्किय्याह को लौड़ा रहै।<verse eid="NEH 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 11:13" />जाके दुई सौ बयालीस भईय्या जो पितरन के घरानन के प्रधान रहैं; और अमसै जो अजरेल को लौड़ा रहै, जौ अहजै को लौड़ा, जौ मसिल्लेमोत को लौड़ा, जौ इम्मेर को लौड़ा रहै। <verse eid="NEH 11:13" /><verse number="14" style="v" sid="NEH 11:14" />इनके एक सौ अट्ठाईस सूरवीर भईय्या रहैं और इनको प्रधान हग्गदोलीम को लौड़ा जब्दीएल रहै।<verse eid="NEH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 11:15" />फिर लेवियन मैं से समायाह जो हस्सूब को लौड़ा रहै, जौ अज्रीकाम को लौड़ा, जौ हसब्याह को लौड़ा, जौ बुन्नी को लौड़ा रहै।<verse eid="NEH 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 11:16" />सब्बतै और योजाबाद मुख्य लेवियन मैं से परमेस्वर के भवन के बाहरी काम मैं ठहरे रहैं।<verse eid="NEH 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 11:17" />मत्तन्याह जो मीका को लौड़ा और जब्दी को धुईतो, और आसाप को परपोता रहै; बौ प्रार्थना मैं धन्यवाद करन बारेन को मुखिया रहै, और बकबुक्याह अपने भईय्यन मैं दूसरो पद रखत रहै; और अब्दा जो सम्मू को लौड़ा, और गालाल को धुईतो, और यदूतून को परपोता रहै।<verse eid="NEH 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 11:18" />जो लेवी पवित्र नगर मैं रहत रहैं, बे सब मिलाएकै दुई सौ चौरासी रहैं।<verse eid="NEH 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 11:19" />द्वारपाल: अक्कूब और तल्मोन नाओं के फाटक खोलन बारे और उनके भईय्या जो फाटकन के रखबरिया रहैं, एक सौ बहात्तर रहैं।<verse eid="NEH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 11:20" />बचे भै इस्राएली पुजारी और लेवी, यहूदा के सब नगरन मैं अपने-अपने हिस्सा मैं रहत रहैं। <verse eid="NEH 11:20" /><verse number="21" style="v" sid="NEH 11:21" />पर मंदिर के सेवक ओपेल टीला मैं रहत रहैं; सीहा और गिस्पा उनके अध्यक्छ रहैं।<verse eid="NEH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 11:22" />जो लेवी यरूसलेम मैं रहकै परमेस्वर के भवन के काम मैं लगे रहत रहैं, उनको मुखिया आसाप के बंस के गबईय्यन मैं को उज्जी रहै, जो बानी को लौड़ा रहै, जौ हसब्याह को लौड़ा, जौ मत्तन्याह को दादो मीका और जौ हसब्याह को लौड़ा रहै। <verse eid="NEH 11:22" /><verse number="23" style="v" sid="NEH 11:23" />काहैकि उनके बारे मैं राजा की आग्या रहै, और गबईय्यन के हर दिन के इरादा के हिसाब से ठीक बंदोबस्त रहै।<verse eid="NEH 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 11:24" />प्रजा के सब काम के ताहीं मेसेजबेल को लौड़ा पतहाह जो यहूदा के लौड़ा जेरह के बंस मैं रहै, बौ राजा के झोने रहत रहै।<verse eid="NEH 11:24" /></para>
  <para style="s">दुसरे सहर और नगर के निवासी</para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 11:25" />बचे गाँओं और उनके खेत; और कुछ यहूदी किर्यतअर्बा, और उनके गाँओं मैं, कुछ दीबोन, और बाके गाँओं मैं, कुछ यकब्सेल और बाके गाँओं मैं रहत रहैं। <verse eid="NEH 11:25" /><verse number="26" style="v" sid="NEH 11:26" />फिर ईसु, मोलादा, बेत्पेलेत; <verse eid="NEH 11:26" /><verse number="27" style="v" sid="NEH 11:27" />हसर्सआल, और बेर्सेबा और बाके गाँओं मैं; <verse eid="NEH 11:27" /><verse number="28" style="v" sid="NEH 11:28" />और सिकलग और मकोना और उनके गाँओं मैं; <verse eid="NEH 11:28" /><verse number="29" style="v" sid="NEH 11:29" />एन्निम्मोन, जोरा, यर्मूत, <verse eid="NEH 11:29" /><verse number="30" style="v" sid="NEH 11:30" />जानोह और अदुल्लाम और उनके गाँओं मैं, लाकीस और बाके खेतन मैं, अजेका और बाके गाँओं मैं, बे बेर्सेबा से लैकै हिन्नोम की तराई ले डेरा डारे पड़े रहैं।<verse eid="NEH 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 11:31" />बिन्यामीन बंस के लोग गेबा नगर से लैकै मिकमास, अय्या और बेतेल और बाके गाँओं मैं; <verse eid="NEH 11:31" /><verse number="32" style="v" sid="NEH 11:32" />अनातोत, नोब, अनन्याह, <verse eid="NEH 11:32" /><verse number="33" style="v" sid="NEH 11:33" />हासोर, रामा, गित्तैम, <verse eid="NEH 11:33" /><verse number="34" style="v" sid="NEH 11:34" />हदीद, सबोईम, नबल्लत, <verse eid="NEH 11:34" /><verse number="35" style="v" sid="NEH 11:35" />लोद, ओनो और कारीगरन की तराई ले रहत रहैं। <verse eid="NEH 11:35" /><verse number="36" style="v" sid="NEH 11:36" />यहूदा के कुछ लेवियन के दल बिन्यामीन के देसन मैं बस गै।<verse eid="NEH 11:36" /></para>
  <chapter eid="NEH 11" />
  <chapter number="12" style="c" sid="NEH 12" />
  <para style="s">पुजारी और लेवियन की सूची</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 12:1" />जो पुजारी और लेवी सालतीएल के लौड़ा जरुब्बाबेल और ईसु के संग यरूसलेम कै गै रहैं, बे जे रहैं: सरायाह, यिर्मयाह, एज्रा,<verse eid="NEH 12:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="NEH 12:2" />अमर्याह, मल्लूक, हत्तूस, <verse eid="NEH 12:2" /><verse number="3" style="v" sid="NEH 12:3" />सकन्याह, रहूम, मरेमोत, <verse eid="NEH 12:3" /><verse number="4" style="v" sid="NEH 12:4" />इद्दो, गिन्नतोई, अबिय्याह, <verse eid="NEH 12:4" /><verse number="5" style="v" sid="NEH 12:5" />मिय्यामीन, माद्याह, बिलगा, <verse eid="NEH 12:5" /><verse number="6" style="v" sid="NEH 12:6" />समायाह, योयारीब, यदायाह, <verse eid="NEH 12:6" /><verse number="7" style="v" sid="NEH 12:7" />सल्लू, आमोक, हिल्किय्याह और यदायाह।</para>
  <para style="p" vid="NEH 12:7">ईसु के दिनन मैं पुजारिन और उनके भईय्यन के खास लोग, जेईं रहैं।<verse eid="NEH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 12:8" />फिर जे लेवी गै ईसु, बिन्नूई, कदमीएल, सेरेब्याह, यहूदा और बौ मत्तन्याह जो अपने भईय्यन समेत धन्यवाद के काम मैं ठहराओ गौ रहै।<verse eid="NEH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 12:9" />उनके भईय्या बकबुक्याह और उन्नो उनके सामने अपनी-अपनी सेवकाई मैं लगे रहत रहैं।<verse eid="NEH 12:9" /></para>
  <para style="s">येसुअ के बंसज</para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 12:10" />ईसु से योयाकीम पैदा भौ और योयाकीम से एल्यासीब और एल्यासीब से योयादा; <verse eid="NEH 12:10" /><verse number="11" style="v" sid="NEH 12:11" />और योयादा से योनातान और योनातान से यद्दू पैदा भौ।<verse eid="NEH 12:11" /></para>
  <para style="s">बड़े पुजारी के बंसज</para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 12:12" />योयाकीम के दिनन मैं जे पुजारी अपने-अपने पितरन के घरानन के खास लोग रहैं, मतलब सरायाह बंस को मरायाह, यिर्मयाह को हनन्याह; <verse eid="NEH 12:12" /><verse number="13" style="v" sid="NEH 12:13" />एज्रा को मसुल्लाम; अमर्याह को यहोहानान; <verse eid="NEH 12:13" /><verse number="14" style="v" sid="NEH 12:14" />मल्लूकी को योनातान; सबन्याह को योसेफ; <verse eid="NEH 12:14" /><verse number="15" style="v" sid="NEH 12:15" />हारीम को अदना; मरायोत को हेलकै; <verse eid="NEH 12:15" /><verse number="16" style="v" sid="NEH 12:16" />इद्दो को जकर्याह; गिन्नतोन को मसुल्लाम; <verse eid="NEH 12:16" /><verse number="17" style="v" sid="NEH 12:17" />अबिय्याह को जिक्री; मिन्यामीन के मोअद्याह को पिलतै; <verse eid="NEH 12:17" /><verse number="18" style="v" sid="NEH 12:18" />बिलगा को सम्मू; समायाह को यहोनातान; <verse eid="NEH 12:18" /><verse number="19" style="v" sid="NEH 12:19" />योयारीब को मत्तनै; यदायाह को उज्जी; <verse eid="NEH 12:19" /><verse number="20" style="v" sid="NEH 12:20" />सल्लू को कल्लै; आमोक को एबर; <verse eid="NEH 12:20" /><verse number="21" style="v" sid="NEH 12:21" />हिल्किय्याह को हसब्याह; और यदायाह को नतनेल मखिया रहै।<verse eid="NEH 12:21" /></para>
  <para style="s">पुजारी और लेवी के परिवार</para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 12:22" />एल्यासीब, योयादा, योहानान और यद्दू के दिनन मैं लेवी पितरन के बंस के मुख्य लोगन के नाओं लिखे जात रहैं, और फारस के राजा दारा के राज्य मैं पुजारिन के भी नाओं लिखे जात रहैं।<verse eid="NEH 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NEH 12:23" />जो लेवी पितरन के घरानन के मुख्य लोग रहैं, उनके नाओं एल्यासीब के लौड़ा योहानान के दिनन ले इतिहास की किताब मैं लिखे जात रहैं।<verse eid="NEH 12:23" /></para>
  <para style="s">परमेस्वर के भवन मैं काम करन बारे</para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 12:24" />लेवियन के मुख्य लोग जे रहैं: मतलब हसब्याह, सेरेब्याह और कदमीएल को लौड़ा ईसु; और उनके सामने उनके भईय्या परमेस्वर के भक्त दाऊद की आग्या के हिसाब से दल मैं बटकै उनके आमने-सामने स्तुति और धन्यवाद करन ताहीं चुने गै रहैं।<verse eid="NEH 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 12:25" />मत्तन्याह, बकबुक्याह, ओबघाह, मसुल्लाम, तल्मोन और अक्कूब फाटकन के झोने के भंडारन को पहरा देन बारो फाटक को रखबरिया रहै।<verse eid="NEH 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NEH 12:26" />योयाकीम के दिनन मैं जो योसादाक को धुईतो और ईसु को लौड़ा रहै, और नहेम्याह अधिपति और एज्रा पुजारी और यहूदी नियम के सिक्छकन के दिनन मैं जेईं रहैं।<verse eid="NEH 12:26" /></para>
  <para style="s">नहेम्याह के जरिये यरूसलेम की दीबार को समर्पड़</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 12:27" />यरूसलेम की दीबार समर्पड़ के समय लेवी अपने सब जघन मैं ढूँढ़े गै, कि यरूसलेम कै पहुँचाए जामैं, जोसे खुसी और धन्यवाद करकै और झाँझ, सारंगी और वीड़ा बजाएकै, और गाएकै बाको समर्पड़ करैं। <verse eid="NEH 12:27" /><verse number="28" style="v" sid="NEH 12:28" />तौ गबईय्यन की औलाद यरूसलेम के चारौ घाँईं के देस से और नतोपातियन के गाओं से, <verse eid="NEH 12:28" /><verse number="29" style="v" sid="NEH 12:29" />और बेतगिलगाल से, और गेबा और अजमावेत के खेतन से इकट्ठे भै; काहैकि गबईय्या यरूसलेम के आसपास के गाओं बसाए लई रहैं। <verse eid="NEH 12:29" /><verse number="30" style="v" sid="NEH 12:30" />तौ पुजारी और लेवी खुदकै सुद्ध करीं; और बे प्रजा कै, और फाटकन कै और दीबार कै भी सुद्ध करीं।<verse eid="NEH 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 12:31" />तौ राजा यहूदी नेता कै दीबार मैं चढ़ाएकै दुई बड़े दल ठहराओ, जो धन्यवाद करत भई धूमधाम के संग चलत रहैं। इनमैं से एक दल तौ तरिहाँए के घाँईं, मतलब कूड़ा-फाटक के घाँईं दीबार के ऊपर-ऊपर से चलो;<verse eid="NEH 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NEH 12:32" />और राजा पच्छू-पच्छू जे चले, मतलब होसायाह, और यहूदा के आधे नेता, <verse eid="NEH 12:32" /><verse number="33" style="v" sid="NEH 12:33" />और अजर्याह, एज्रा, मसुल्लाम, <verse eid="NEH 12:33" /><verse number="34" style="v" sid="NEH 12:34" />यहूदा, बिन्यामीन, समायाह, और यिर्मयाह, <verse eid="NEH 12:34" /><verse number="35" style="v" sid="NEH 12:35" />और पुजारिन के कितने लौड़ा तुरही लै भै: मतलब जकर्याह जो योनातान को लौड़ा रहै, जौ समायाह को लौड़ा , जौ मत्तन्याह को लौड़ा, जौ मीकायाह को लौड़ा, जौ जक्कूर को लौड़ा, जौ आसाप को लौड़ा रहै। <verse eid="NEH 12:35" /><verse number="36" style="v" sid="NEH 12:36" />और बाके भईय्या समायाह, अजरेल, मिललै, गिललै, माऐ, नतनेल, यहूदा और हनानी परमेस्वर के भक्त दाऊद को बाजा लै पड़े रहैं; और उनके अग्गु-अग्गु एज्रा यहूदी नियम को सिक्छक चलो। <verse eid="NEH 12:36" /><verse number="37" style="v" sid="NEH 12:37" />जौ सोताफाटक से हुईकै सीधे दाऊदपुर की सिड़ी मैं चढ़ो, दीबार की ऊँचाई से चलकै, दाऊद के भवन के ऊपर से हुईकै, अगार के घाँईं जलफाटक ले पहुँचे।<verse eid="NEH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 12:38" />धन्यवाद करन और धूमधाम से चलन बारेन को दूसरो दल, और उनके पच्छू-पच्छू मैं, और आधे लोग उनसे मिलन कै दीबार के ऊपर- ऊपर से भट्टन के गुम्मट के झोने से चौड़ी दीबार ले, <verse eid="NEH 12:38" /><verse number="39" style="v" sid="NEH 12:39" />और एप्रेम के फाटक और पुराने फाटक, और मच्छी फाटक, और हननेल के गुम्मट, और हम्मेआ नाओं के गुम्मट के झोने से हुई कै भेंड़ फाटक ले चले, और पहरुआ के फाटक के झोने ठाड़ गै।<verse eid="NEH 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NEH 12:40" />तौ धन्यवाद करन बारेन के दोनों दल और मैं और मेरे संग के आधे नेता परमेस्वर के भवन मैं ठाड़गै। <verse eid="NEH 12:40" /><verse number="41" style="v" sid="NEH 12:41" />और एल्याकीम, मासेयाह, मिन्यामीन, मीकायाह, एल्योएनै, जकर्याह और हनन्याह नाओं के पुजारी तुरही लै पड़े रहैं। <verse eid="NEH 12:41" /><verse number="42" style="v" sid="NEH 12:42" />मासेयाह, समायाह, एलीआजर, उज्जी, यहोहानान, मल्किय्याह, एलाम, और एजेर ठाड़े पड़े रहैं, और गबईय्या जिनको मुखिया यिज्रह्याह रहै, बे ऊँचे स्वर से गात बजात रहैं।<verse eid="NEH 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="NEH 12:43" />बहे दिन लोग बड़े-बड़े महाबलि चढ़ाईं, और खुसी मनाईं; काहैकि परमेस्वर उन्हैं भौत खुसी दई रहै; बईय्यरैं और बाल-बच्चे भी खुसी मनाईं। यरूसलेम के आनंद की आवाज दूर-दूर ले फैल गई।<verse eid="NEH 12:43" /></para>
  <para style="s">भवन मै आराधना के ताहीं तईयारी</para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 12:44" />उपासना और तमान चीजन की व्यवस्था बहे दिन खजानन के, उठाई भई भेंटन के, पहली-पहली उपज के, और दसमांसन की कुठरियन के अधिकारी ठहराए गै, कि उनमैं नगर-नगर के खेतन के हिसाब से बे चीजन कै जमा करैं, जो व्यवस्था के हिसाब से पुजारियन और लेवियन के हिस्सा मैं करी रहैं; काहैकि यहूदा के लोग हुँआँ के पुजारिन और लेवियन के बजह से खुस रहैं। <verse eid="NEH 12:44" /><verse number="45" style="v" sid="NEH 12:45" />जौ बजह से बे अपने परमेस्वर के काम और सुद्धता के बारे मैं चौकसी करते रहे; और गबईय्या और फाटक खोलन बारे भी दाऊद और बाके लौड़ा सुलेमान की आग्या के हिसाब से बैसोई करत रहे। <verse eid="NEH 12:45" /><verse number="46" style="v" sid="NEH 12:46" />पुराने जमाने मैं, मतलब दाऊद और आसाप के दिनन मैं तौ गबईय्यन के प्रधान रहैं, और परमेस्वर की स्तुति और धन्यवाद ले गीत गाए जात रहैं। <verse eid="NEH 12:46" /><verse number="47" style="v" sid="NEH 12:47" />जरुब्बाबेल और नहेम्याह के दिनन मैं सब इस्राएली, गबईय्या और द्वारपाल के हर दिन को हिस्सा देत रहैं; और बे लेबियन को हिस्सा पवित्र करकै देत रहैं; और लेवी हारून के लौड़न को हिस्सा पवित्र करकै देत रहै।<verse eid="NEH 12:47" /></para>
  <chapter eid="NEH 12" />
  <chapter number="13" style="c" sid="NEH 13" />
  <para style="s">विदेसियन से अलग होनो</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 13:1" />बहै दिन मूसा की किताब लोगन कै पढ़कै सुनाए दई; और बामै जौ लिखो भौ मिलो, कि कोई अम्मोनी और मोआबी लोग परमेस्वर की सभा मैं नाय आनो चाहिए।<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">व्यवस्थाविवरड़ 23:3-5; </char></note> <verse eid="NEH 13:1" /><verse number="2" style="v" sid="NEH 13:2" />काहैकि बे अन्न जल लैकै इस्राएली लोगन से भेंट नाय करीं, फिर बिलाम कै बे स्राप देन के ताहीं भेंट दैकै बुलबाईं रहैं- तौ भी हमरे परमेस्वर बौ स्राप कै आसीस मैं बदल दई।<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">गिनती 22:1-6</char></note> <verse eid="NEH 13:2" /><verse number="3" style="v" sid="NEH 13:3" />जौ व्यवस्था सुनकै, बे इस्राएली लोगन कै दुसरे देस के लोगन से अलग कर दई।<verse eid="NEH 13:3" /></para>
  <para style="s">नहेम्याह को सुधार</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 13:4" />जासे पहले एल्यासीब पुजारी जो हमरे परमेस्वर के भवन की कुठरियन को अधिकारी और तोबियाह को सम्बंधी रहै। <verse eid="NEH 13:4" /><verse number="5" style="v" sid="NEH 13:5" />बौ तोबियाह के ताहीं एक बड़ी कुठरिया तैयार करी रहै जोमैं पहले अन्नबलि को सामान और लोबान और बर्तन और अनाज, नया दाखमधु और टटके तेल के दसमांस, जिनकै लेवियन, गवईयन और द्वारपालन कै देन की आग्या रहै, रखी भई रहै; और पुजारियन के ताहीं उठी भई भेंट<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">पुजारी के लिये उठाई हुई भेंट। पुरोहितन के निर्वाह हेतु नियुक्त भेंटन का अंस।</char></note> भी रखी जात रहै। <verse eid="NEH 13:5" /><verse number="6" style="v" sid="NEH 13:6" />मैं बौ समय यरूसलेम मै नाय रहौं, काहैकि बेबीलोन को राजा अर्तछत्र के बत्तीसमें साल मै मैं राजा के झोने चले गौ। फिर कितने दिनन के बाद राजा से छुट्टी लैकै बापस आओ <verse eid="NEH 13:6" /><verse number="7" style="v" sid="NEH 13:7" />फिर मैं यरूसलेम आएकै, तब मैं जान लौ, कि एल्यासीब तोबियाह के ताहीं परमेस्वर के भवन के आँगन मैं की जघा मैं एक कुठरिया तैयार करकै, का बुराई करे हैं। <verse eid="NEH 13:7" /><verse number="8" style="v" sid="NEH 13:8" />मैं बड़ा गुस्सा ही गौ, और तोबियाह को पूरो घर को सामान बौ कुठरिया मैं से फेंक दई और खाली करबाए दौ। <verse eid="NEH 13:8" /><verse number="9" style="v" sid="NEH 13:9" />तब मेरी आग्या से बे कुठरियन कै सुद्ध करो गौ, और मैं परमेस्वर के भवन के बर्तन और भेंट को सामान और लोबान बामैं फिर से रखबाए दौ।<verse eid="NEH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 13:10" />फिर मोकै पता चलो कि लेवियन को भाग उनकै नाय दौ गौ है; और जाके काम करनबारे लेवी और गवैये अपने-अपने खेत कै भाज गै हैं। <verse eid="NEH 13:10" /><verse number="11" style="v" sid="NEH 13:11" />तब मैं अधिकारियन कै लक्कार कै कहो, “परमेस्वर को भवन काहे त्यागो गौ रहै?” फिर मैं उनको इकट्टो करकै<note caller="+" style="f"><char style="fr" closed="false">13:11</char><char style="ft" closed="false">मैं उनको इकट्ठा करकै: नहेम्याह ने लेवी को उनके स्थानों से बुलाया और अपनी-अपनी सेवा मैं उनको पुनर्स्थापन किया।</char></note>, एक-एक कै बाके जघा मै नियुक्त करी। <verse eid="NEH 13:11" /><verse number="12" style="v" sid="NEH 13:12" />तब से सब यहूदी अनाज, नया दाखमधु और टटके तेल के दसमांस भंडार मै लान लगे। <verse eid="NEH 13:12" /><verse number="13" style="v" sid="NEH 13:13" />मैं भंडारन के अधिकारी सेलेम्याह पुजारी और सादोक मुंसी कै, और लेवियन मै से पदायाह को, और उनके नीचे हानान को, जो मत्तन्याह को पोता और जक्कूर को लौड़ा रहै, नियुक्त करी; बे तौ विस्वासयोग्य गिने जात रहैं, और अपने भईय्यन के मध्य बाँटनो उनको काम रहै।<verse eid="NEH 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 13:14" />हे मेरो परमेस्वर! मेरो जौ काम मेरे प्रेम के ताहीं याद रख, और जो-जो सुकर्म मैं अपने परमेस्वर के भवन के ताहीं, तेरे भवन की आराधना के ताहीं करी है, उनकै मत भूलिये।<verse eid="NEH 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 13:15" />बे दिनन मै मैं यहूदा मै भौतन कै देखो जो विस्राम दिन कै हौदिया मैं दाख रौंदते, और पूलियन कै लै आते, और गधन मैं लादत रहैं; बैसिये बे दाखमधु, दाख, अंजीर और बड़ा प्रकार के बोझ विस्रामदिन कै यरूसलेम मै लात रहैं; तौ जो दिन बे खान की चीज बेचत रहैं, बहै दिन मैं उनकै चिताए दौ। <verse eid="NEH 13:15" /><verse number="16" style="v" sid="NEH 13:16" />फिर बामैं सोर देस के लोग रहकै मच्छी और निरे तराहनी को सामान लाएकै, यहूदियन के हात यरूसलेम मै विस्राम दिन कै बेचे करत रहैं। <verse eid="NEH 13:16" /><verse number="17" style="v" sid="NEH 13:17" />तब मैं यहूदा के नेतन कै डाँटकै कहो, “तुम लोग जौ का बुराई करत हौ, जौ विस्राम दिन कै अपवित्र करथौ? <verse eid="NEH 13:17" /><verse number="18" style="v" sid="NEH 13:18" />का तुमरे पुरखा ऐसो नाय करत रहैं? और का हमरे परमेस्वर जौ सब विपत्ति हमैं और जौ नगर मै नाय डारी? तौ भी तुम विस्राम दिन कै अपवित्र करन से इस्राएल मै परमेस्वर को गुस्सा और भी भड़कात जात हौ।”<verse eid="NEH 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 13:19" />फिर जब विस्राम दिन के पहले दिन कै यरूसलेम के फाटकन के आस-पास अंधियारो होन लगो, तब मैं आग्या दौ, कि उनके पल्ला बन्द करे जामैं, और जौ भी आग्या दई, कि बे विस्रामदिन के पूरे होन तक खोले नाय जामैं। तौ मैं अपने कुछ सेवकन को फाटकन को अधिकारी ठहराए दई, कि विस्रामदिन कै कोई बोझ भीतर आए नाय पाए। <verse eid="NEH 13:19" /><verse number="20" style="v" sid="NEH 13:20" />तभई व्यापारी और बड़ा प्रकार के सौदा कै बेचनबारे यरूसलेम दीबार के बाहर एक दुई बार रात मैं डेरा डारीं। <verse eid="NEH 13:20" /><verse number="21" style="v" sid="NEH 13:21" />तब मैं उनकै चिताएकै कहो, “तुम लोग दीबार के अग्गू रात काहे बिताए रहे हौ? अगर तुम फिर ऐसो करैगे तौ मैं तुमरे ऊपर हात बढ़ाँगों।” तभई बौ समय से बे फिर विस्राम बार कै नाय आए। <verse eid="NEH 13:21" /><verse number="22" style="v" sid="NEH 13:22" />तब मैं लेवियन कै आग्या दौ, कि अपने-अपने कै सुद्ध करकै फाटकन की रखबारी करन के ताहीं आए करौ, ताकि विस्राम दिन पवित्र मानो जाए। हे मेरे परमेस्वर! मेरे हित के ताहीं जौ भी याद रख और अपनी बड़ी करूड़ा के जैसे मेरे ऊपर तरस खा।<verse eid="NEH 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NEH 13:23" />फिर बे दिनन मैं मोकै ऐसे यहूदी लोग दिखाई पड़े, जो असदोदी, अम्मोनी और मोआबी देस की बईंय्यरन कै बिहा लाईं। <verse eid="NEH 13:23" /><verse number="24" style="v" sid="NEH 13:24" />उनके बालकन की आधी बोली असदोदी रहै, और बे यहूदी बोली न बोल सकत रहैं, हर एक अपनी कोम की भासा बोलत रहैं। <verse eid="NEH 13:24" /><verse number="25" style="v" sid="NEH 13:25" />तब मैं उनकै डाँटो और कोसो, और बामैं से कुछ कै पिटबाए दौ और उनके बार नुचवाए; और उनके परमेस्वर की जौ सपथ खबाईं, “हम अपनी लौड़ियन उनके लौड़न के संग बिहा मैं न देंगे और न अपने ताहीं और अपने बालकन के ताहीं उनकी लौड़ियन कै बिहा मैं लेंगे। <verse eid="NEH 13:25" /><verse number="26" style="v" sid="NEH 13:26" />का इस्राएल को राजा सुलेमान जौ प्रकार के पाप मैं नाय फसो रहै? बहोत जातियन मैं बाके जैसी कोई राजा नाय भौ, और बौ अपने परमेस्वर को प्यारो भी रहै, और परमेस्वर बौ सब इस्राएल के ऊपर राजा नियुक्त करी; फिर बाकै भी गैरयहूदी बईंय्यरन बाकै पाप मैं फसाईं। <verse eid="NEH 13:26" /><verse number="27" style="v" sid="NEH 13:27" />तौ का हम तुमरी सुनकै, ऐसी बड़ी बुराई करैं कि गैरयहूदी की बईंय्यरन से बिहा करकै अपने परमेस्वर के खिलाप विस्वासघात करैं?”<verse eid="NEH 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 13:28" />और एल्यासीब बड़ो पुजारी के लौड़ा योयादा को एक लौड़ा, होरोनी सम्बल्लत को दमदा रहै, तभई मैं बाकै अपने झोने से भजाए दौ। <verse eid="NEH 13:28" /><verse number="29" style="v" sid="NEH 13:29" />हे मेरे परमेस्वर, उनकै याद रख, काहैकि बे पुजारी पद और पुजारी और लेवियन की वाचा कै असुद्ध करी है।<verse eid="NEH 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 13:30" />जौ प्रकार मैं उनके सब गैरयहूदिन से सुद्ध करी, और एक-एक पुजारी और लेवी की बारी और काम कै ठहराए दई। <verse eid="NEH 13:30" /><verse number="31" style="v" sid="NEH 13:31" />फिर मैं कठिया की भेंट लै आन के खास समय कै ठहराए दै, और पहली उपज कै देन को बंदोबस्त भी करे। हे मेरे परमेस्वर! मेरे हित के ताहीं मोकै याद रख।<verse eid="NEH 13:31" /></para>
  <chapter eid="NEH 13" />
</usx>