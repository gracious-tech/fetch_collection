<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Rana Tharu</book>
  <para style="h">1 तीमुथियुस</para>
  <para style="toc3">1 तीमुथियुस</para>
  <para style="toc2">1 तीमुथियुस</para>
  <para style="toc1">तीमुथियुस कै लिखी भइ पौलुस की पहली चिट्ठी</para>
  <para style="mt2">तीमुथियुस को लिखी हुई पौलुस की पहली चिट्ठी</para>
  <para style="mt1">तीमुथियुस कै लिखी भइ पौलुस की पहली चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">1 तीमुथियुस की किताब प्रेरित पौलुस के जरिया अपने चेला तीमुथियुस कै लिखी गई एक चिट्ठी है। 1 तीमुथियुस संभवत: मसीह के जनम के लमसम 62-64 साल के बाद लिखी गई रहै। जौ पौलुस के जीवन को आखरी समय रहै। पौलुस को तीमुथियुस के संग गहरो संबंध रहै और बौ बाकै तमान बार लौड़ा के रूप मैं संबोधित करी। <char style="xt"><ref loc="PHP 2:22">फिलिप्पियों 2:22</ref></char>, <char style="xt"><ref loc="1TI 1:2">1 तीमुथियुस 1:2</ref></char>, <char style="xt"><ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">जौ पौलुस की चार चिट्ठिन मैं से एक है जो एक कलीसिया के बजाय एक आदमी कै संबोधित करी है। दुसरी तीन चिट्ठी 2 तीमुथियुस, तीतुस और फिलेमोन हैं। 1 तीमुथियुस मैं कलीसिया की आराधना <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char>, कलीसिया के अगुवन के ताहीं काबिलियत<char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char>, और झूठे सिक्छकन के खिलाप चितौनी <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref></char>,<char style="xt"><ref loc="1TI 4:1-5">4:1-5</ref></char>,<char style="xt"><ref loc="1TI 6:2-5">6:2-5</ref></char>। जौ दर्साथै कि कैसे पौलुस तीमुथियुस कै कलीसिया मैं अगुवा बनन के ताहीं प्रसिक्छड़ देत रहै। 1 तीमुथियुस मैं कई सिद्धांत हैं जो हमरे दिनन मैं कलीसिया के नेतन कै स्थानीय कलीसिया की सेवकाई को प्रबंधन करन मैं मदत कर सकथैं।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस तीमुथियुस कै नमस्ते करत भै सुरू करथै। <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. तौ बौ तीमुथियुस कै झूठे सिक्छकन के विरुद्ध चितौनी देथै। <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref></char></para>
  <para style="io1">3. पौलुस जौ बतात भै जारी रखथै कि बौ ईसु मसीह के ताहीं कितनो आभारी है। <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref></char></para>
  <para style="io1">4. जाके बाद बौ तीमुथियुस कै आराधना और कलीसिया के नेताओं के बारे मैं निर्देस देथै। <char style="ior"><ref loc="1TI 2-3">2–3</ref></char></para>
  <para style="io1">5. पौलुस तीमुथियुस कै कुछ आखरी निर्देस दैकै अपनी चिट्ठी खतम करी। <char style="ior"><ref loc="1TI 4-6">4–6</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1"/>पौलुस के घाँईं से जो हमरो उद्धारकर्ता परमेस्वर, और हमरी आसा की बुनियाद ईसु मसीह के हुकम से ईसु मसीह को प्रेरित है।<verse eid="1TI 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2"/>तीमुथियुस<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितो 16:1</ref> </char></note> को नाओं जो बिस्वास मैं मेरो सच्चो लौड़ा है: दऊवा परमेस्वर, और हमरे प्रभु ईसु मसीह के घाँईं से, तोकै अनुग्रह और दया, और सांति मिलत रहबै।<verse eid="1TI 1:2"/></para>
  <para style="s">झूठी सिक्छन के खिलाप चितौनी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3"/>जैसे मैं मकिदुनिया कै जान पोती तोकै समझाओ रहौं, कि इफिसुस मैं रहकै कुछ लोगन कै समझईये कि बे गलत सिक्छा ना देमैं। <verse eid="1TI 1:3"/><verse number="4" style="v" sid="1TI 1:4"/>और बे कहानियन और बड़े-बूढ़ेन की पुरानी बातन मैं मन ना लगाबौ, जो खाली तर्क पैदा करथैं; बे परमेस्वर की योजना कि सेवा नाय करथैं, जोकै बिस्वास से जानो जाथै। <verse eid="1TI 1:4"/><verse number="5" style="v" sid="1TI 1:5"/>जौ हुकम को लक्छ है, एक सुद्ध मन और अच्छो विवेक, और बिना कपट के बिस्वास के प्रेम कै जगाने है। <verse eid="1TI 1:5"/><verse number="6" style="v" sid="1TI 1:6"/>कुछ लोग इनसे दूर हुईगै हैं, और बेकार की बातन मैं खोए गै हैं। <verse eid="1TI 1:6"/><verse number="7" style="v" sid="1TI 1:7"/>बे परमेस्वर के नियम के सिक्छक बननो चाहथैं, लेकिन बे खुद के सब्दन कै या बे मामलेन कै नाय समझथैं, जिनके बारे मैं बे बड़ा बिस्वास के संग बोलथैं।<verse eid="1TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8"/>हम जानथैं कि नियम अच्छो है, अगर जाको इस्तमाल करो जाथै, जैसो कि जाको इस्तमाल करो जानो चाहिए। <verse eid="1TI 1:8"/><verse number="9" style="v" sid="1TI 1:9"/>जौ जरूर समके रहनो चाहिए, कि नियम अच्छे लोगन ताहीं नाय बनाए जाथैं, बल्किन नियम तोड़न बारेन ताहीं और अपराधिन के ताहीं, भक्तिहीन और पापिन के ताहीं, जो धार्मिक या आध्यात्मिक नाय हैं, और नियम उनके ताहीं बनाए जाथैं, जो अपने अईय्या दऊवा की हत्या करथैं, हत्यारेन ताहीं, <verse eid="1TI 1:9"/><verse number="10" style="v" sid="1TI 1:10"/>अनैतिक के ताहीं, पुरुसगामियन के ताहीं, अपहरनकर्ता<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">जो अगुवा करथैं</char></note> के ताहीं, और झूठी गभाई देन बारेन ताहीं, और इनकै छोड़कै खरे सिक्छा के सबै बिरोधिन के ताहीं ठहराई गई है। <verse eid="1TI 1:10"/><verse number="11" style="v" sid="1TI 1:11"/>जहे परमधन्य परमेस्वर की महिमा के बौ सुसमाचार के हिसाब से है, जो मोकै घोसित करन के ताहीं सौंपो गौ है।<verse eid="1TI 1:11"/></para>
  <para style="s">परमेस्वर की दया के ताहीं धन्यवाद</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12"/>मैं हमरे प्रभु ईसु मसीह को, जो मोकै ताकत और सामर्थ्य दई है, धन्यवाद करथौं; कि बौ मोकै भरोसेमंद समझकै अपनी महिमा और सेवा के ताहीं योग्य ठहराई। <verse eid="1TI 1:12"/><verse number="13" style="v" sid="1TI 1:13"/>पहले मैं बाकी बुराई करो, और सताओ, और बाकी बड़ा बेजती करो; लेकिन परमेस्वर मेरे ऊपर दया करी, काहैकि मोकै अभैले बिस्वास नाय रहै, और जहे बजे से मोकै मालुम नाय रहै, कि मैं का कर रौ हौं।<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितो 8:3</ref>; <ref loc="ACT 9:4">9:4</ref>,<ref loc="ACT 9:5">5</ref> </char></note> <verse eid="1TI 1:13"/><verse number="14" style="v" sid="1TI 1:14"/>और हमरो प्रभु मेरे ऊपर अपनो अनुग्रह और करी और मोकै बिस्वास और प्रेम दई, जैसी ईसु मसीह मैं एक होन के नाते हमरो है। <verse eid="1TI 1:14"/><verse number="15" style="v" sid="1TI 1:15"/>जौ एक सच्ची बात है, जोकै हमैं अपनानो चाहिए और बिस्वास करनो चाहिए: ईसु मसीह पापिन कै बचान के ताहीं दुनिया मैं आओ, मैं उनमैं से सबसे बड़ो पापी खराब हौं, <verse eid="1TI 1:15"/><verse number="16" style="v" sid="1TI 1:16"/>पर मेरे ऊपर इसलै दया भइ कि मेरे जैसे सबसे बड़ो पापी मैं ईसु मसीह अपनी पूरी सहनसीलता दिखाबै, कि जो लोग बाके ऊपर अनंत जिंदगी के ताहीं बिस्वास करंगे, उनके ताहीं मैं एक आदर्स बनौ। <verse eid="1TI 1:16"/><verse number="17" style="v" sid="1TI 1:17"/>सदा काल के राजा के ताहीं, अमर और अनदेखे, एकमात्र परमेस्वर बाके ताहीं हमेसा और हमेसा के ताहीं आदर और महिमा होबै! आमीन।<verse eid="1TI 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18"/>तीमुथियुस, मेरो बालका, मैं तोकै जौ हुकम सौंपथौं, जो तेरे बारे मैं अतीत मैं भविस्यवाँड़ी बोली गई रहैं, बे सब्दन के अनुसार, अच्छी तरह से लड़न के ताहीं बे सब्दन कै हथियार के हानी इस्तमाल कर, <verse eid="1TI 1:18"/><verse number="19" style="v" sid="1TI 1:19"/>और अपनो बिस्वास और अपनो अच्छो विवेक सपा रख। थोड़ी लोग उनके विवेक की अबाज नाय सुनीं और उनके बिस्वास कै बरबाद कर दई है। <verse eid="1TI 1:19"/><verse number="20" style="v" sid="1TI 1:20"/>उन्हईं मैं से हुमिनयुस और सिकन्दर हैं, जिनकै मैं सैतान के हाथ मैं सौंप दौ, कि बे बुराई करनो ना सीखैं।<verse eid="1TI 1:20"/></para>
  <chapter eid="1TI 1"/>
  <chapter number="2" style="c" sid="1TI 2"/>
  <para style="s">कलीसिया की आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1"/>अब मैं सबसे पहले जौ आग्रह करथौं, कि बिनती, प्रार्थना, निवेदन, धन्यवाद, सब जनी के ताहीं परमेस्वर कै सौंपो जाए; <verse eid="1TI 2:1"/><verse number="2" style="v" sid="1TI 2:2"/>सब राजा और सब ऊँचे पद बारेन के खातिर, हम परमेस्वर के प्रति सबै आदर और सई चाल-चलन के संग एक सांत और सांतिपूर्ड़ जिंदगी जी सकैं। <verse eid="1TI 2:2"/><verse number="3" style="v" sid="1TI 2:3"/>जौ हमरे उद्धारकर्ता परमेस्वर कै अच्छो लगथै, और बाकै खुसी भी मिलथै, <verse eid="1TI 2:3"/><verse number="4" style="v" sid="1TI 2:4"/>जो कि बौ चाहथै कि सब जनी कै बचाओ जाए सकै, और सच्चाई कै जान सकै। <verse eid="1TI 2:4"/><verse number="5" style="v" sid="1TI 2:5"/>काहैकि एकै परमेस्वर है, और एक जनी है जो परमेस्वर और इंसान कै एक संग लाथै, बौ ईसु मसीह है, <verse eid="1TI 2:5"/><verse number="6" style="v" sid="1TI 2:6"/>जो पूरी मानव जाति कै छुड़ान के ताहीं खुदकै दै दई। जौ सई समय मैं गभा रहै, कि परमेस्वर चाहथै, कि सबकै बचाओ जाए सकै, <verse eid="1TI 2:6"/><verse number="7" style="v" sid="1TI 2:7"/>और जहे बजे है कि मोकै बिस्वास और सच्चाई को उपदेसक के ताहीं प्रेरित और गैर यहूदिन के गुरु के रूप मैं भेजो गौ रहै। मैं झूठ नाय बोल रौ हौं; मैं सच्ची कहरौ हौं!<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 तीमुथियुस 1:11</ref></char></note><verse eid="1TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8"/>हर एक कलीसिया सेवा मैं होमैं मैं चाहथौं, बे आदमी जो परमेस्वर कै समर्पित हैं, बे आदमी हर जघा बिना गुस्सा और तर्क के पवित्र हातन कै उठाएकै प्रार्थना कर सकथैं। <verse eid="1TI 2:8"/><verse number="9" style="v" sid="1TI 2:9"/>मैं जौ भी चाहथौं कि बईंय्यरैं अपने लत्तन मैं ध्यान देमैं और समझदार बनै और ठीक से लत्ता पहन सकैं; न कि बार सुदारन मैं, और सोने के जेबर मैं, मोतियन मैं, और महंगे लत्तन मैं ध्यान देमैं,<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 पतरस 3:3</ref></char></note> <verse eid="1TI 2:9"/><verse number="10" style="v" sid="1TI 2:10"/>लेकिन अच्छे कामन के संग, जैसो कि बे बईंय्यरन के ताहीं सई है, जो धार्मिक होन को दाबा करथैं। <verse eid="1TI 2:10"/><verse number="11" style="v" sid="1TI 2:11"/>बईंय्यरन कै सांति से और सब कछु विनम्रता से सिकनो चाहिए। <verse eid="1TI 2:11"/><verse number="12" style="v" sid="1TI 2:12"/>मैं उनकै सिखान या आदमिन के ऊपर अधिकार चलान की इजाजत नाय देथौं; बईंय्यरन कै चुप रहनो चाहिए। <verse eid="1TI 2:12"/><verse number="13" style="v" sid="1TI 2:13"/>काहैकि पहले आदम आओ रहै, बाके बाद हव्वा आई रहै।<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="GEN 2:7">उत्पत्ति 2:7</ref>; <ref loc="GEN 2:21">2:21</ref>,<ref loc="GEN 2:22">22</ref></char></note> <verse eid="1TI 2:13"/><verse number="14" style="v" sid="1TI 2:14"/>और आदम नाय बहको, पर बईय्यर बहकाबे मैं आयकै, परमेस्वर को नियम तोड़ी और धोका खाई।<note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GEN 3:1-6">उत्पत्ति 3:1-6</ref></char></note> <verse eid="1TI 2:14"/><verse number="15" style="v" sid="1TI 2:15"/>तहुँओं बईय्यर बालका पैदा करन के जरिये उद्धार पागी, अगर बौ बिस्वास और प्रेम और पवित्रता के संग सालीनता के संग रहथै।<verse eid="1TI 2:15"/></para>
  <chapter eid="1TI 2"/>
  <chapter number="3" style="c" sid="1TI 3"/>
  <para style="s">कलीसिया मैं नेता</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1"/>जौ बात सच्ची है कि जो कलीसिया को नेता बननो चाहथै, बौ भले काम करन की इच्छा रखथै। <verse eid="1TI 3:1"/><verse number="2" style="v" sid="1TI 3:2"/>जहो जरूरी है कि नेता निर्दोस, और एकै बईय्यर को लोगा होनो चाहिए, सांतचित्त, खुद मैं नियंतरित और व्यवस्थित होबै; और हितुअन को आदर भाव करन बारो, और सिखान मैं अच्छो होनो चाहिए;<note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">तीतुस 1:6-9</ref></char></note> <verse eid="1TI 3:2"/><verse number="3" style="v" sid="1TI 3:3"/>बौ दरुहा या मारपीट करन बारो ना होबै; पर बौ कोमल होबै, ना कि लौड़ा, और ना पैसन को लालची होबै; <verse eid="1TI 3:3"/><verse number="4" style="v" sid="1TI 3:4"/>बौ अपने परिवार को अच्छी तरह से ख्याल रखन मैं सक्छम होनो चाहिए, और अपने बालकन कै पूरी गंभीरता से अपने अधीन रखत होबै। <verse eid="1TI 3:4"/><verse number="5" style="v" sid="1TI 3:5"/>अगर कोई आदमी अपने परिवार को ख्याल रखनो नाय जानथोबै, तौ बौ परमेस्वर कि कलीसिया की देखभार कैसे कर सकथै? <verse eid="1TI 3:5"/><verse number="6" style="v" sid="1TI 3:6"/>बाकै बिस्वास मैं मजबूत होनो चाहिए, ऐसो ना होबै कि घमंड करकै सैतान के हानी सजा पाबै। <verse eid="1TI 3:6"/><verse number="7" style="v" sid="1TI 3:7"/>बाकै एक ऐसो आदमी होनो चाहिए, जो कलीसिया के बाहर लोग बाकी इज्जत करथौ मैं, ताकी बौ बेईज्जत ना होबै और सैतान की चाल मैं ना पड़ै।<verse eid="1TI 3:7"/></para>
  <para style="s">कलीसिया मैं सहायक</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8"/>कलीसिया के सहायक सेवकन के पास एक अच्छो चरित्‌र और इमानदारी होनी चाहिए; उनकै जाधे दाखरस ना पीनो चाहिए, और पैसन को लालच ना करनो चाहिए; <verse eid="1TI 3:8"/><verse number="9" style="v" sid="1TI 3:9"/>उनकै साफ मन से बिस्वास और प्रकट सत्य कै पकड़े रहनों चाहिए। <verse eid="1TI 3:9"/><verse number="10" style="v" sid="1TI 3:10"/>उनकै पहले परखो जानो चाहिए, फिर जब बे परखे जानें मैं निर्दोस निकरैं, तौ बे सेवा करन के ताहीं हैं। <verse eid="1TI 3:10"/><verse number="11" style="v" sid="1TI 3:11"/>उनकी बईंय्यरैं भी अच्छी चरित्‌र और भरोसा के काबिल होनी चाहिए और एक दुसरेन की निंदा करन बारी न होनो चाहिए; उनकै हर चीज मैं सांत और इमानदार होनो चाहिए। <verse eid="1TI 3:11"/><verse number="12" style="v" sid="1TI 3:12"/>एक कलीसिया के सेवक के पास खाली एकै बईय्यर होनी चाहिए, और अपने बालकन और अपने परिवार कै अच्छी तरह से देखभार करन मैं सक्छम होनो चाहिए। <verse eid="1TI 3:12"/><verse number="13" style="v" sid="1TI 3:13"/>बे सेवक जो अपनो सेवा को काम अच्छे से करथैं, बे अपने ताहीं लोगन की नजर मैं अच्छो स्थान हासिल करंगे, और ईसु मसीह मैं अपने बिस्वास के बारे मैं, हिम्मत से बोलन मैं सक्छम होथैं।<verse eid="1TI 3:13"/></para>
  <para style="s">महान रहस्य</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14"/>मैं तेरे झोने जल्दी आन की आसा रखन पर भी जे बातैं तोकै इसलै लिखथौं। <verse eid="1TI 3:14"/><verse number="15" style="v" sid="1TI 3:15"/>कि अगर मेरे आन मैं देरी होगी, तौ जौ चिट्ठी तुमकै बतागी कि हमैं परमेस्वर के घर मैं खुदकै कैसे करकै चलते रहने है, तौ तू जान ले, कि परमेस्वर के घराने मैं जो जिंदे परमेस्वर कि कलीसिया है, और जो सच्चाई को खम्मा और बुनियाद है। <verse eid="1TI 3:15"/><verse number="16" style="v" sid="1TI 3:16"/>जौ बात से कोई मना ना कर सकथैं कि हमरी भक्ति को रहस्य कितनो महान और सई है:</para>
  <para style="q1" vid="1TI 3:16">बौ इंसान के रूप मैं आओ,</para>
  <para style="q2" vid="1TI 3:16">आत्मा मैं न्याई मानो गौ,</para>
  <para style="q2" vid="1TI 3:16">और स्वर्गदूतन कै दिखाई दई रहै,</para>
  <para style="q1" vid="1TI 3:16">दुसरे-दुसरे रास्ट्रन मैं बाको प्रचार भौ,</para>
  <para style="q2" vid="1TI 3:16">दुनिया भर के लोग बाके ऊपर स्वर्ग तक बिस्वास करीं,</para>
  <para style="q2" vid="1TI 3:16">और स्वर्ग तक लैजाओ गौ।<verse eid="1TI 3:16"/></para>
  <chapter eid="1TI 3"/>
  <chapter number="4" style="c" sid="1TI 4"/>
  <para style="s">झूठे सिक्छक</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1"/>आत्मा साफ-साफ कहथै, कि आनबारे समय मैं कुछ लोग बिस्वास कै छोड़ देंगे; बे झूठ बोलन बारी आत्मा की आग्यन कै मानकै प्रेत आत्मा की सिक्छा के अनुसार चलंगे। <verse eid="1TI 4:1"/><verse number="2" style="v" sid="1TI 4:2"/>जो झूठे और कपटी आदमी के जरियै फैलाओ जाथै, जिनको मन मर चुको है, जिनको मन मानौं जलत भै लोहो से भुज गौ होबै। <verse eid="1TI 4:2"/><verse number="3" style="v" sid="1TI 4:3"/>जो बिहा करन से रोकंगे, और खाने कि चीज मैं खान के ताहीं परेज करन ताहीं कहंगे; जिनकै परमेस्वर जौ ताहीं सिरजाई कि विस्वासी और सच्चाई कै जानन बारे उनकै धन्यवाद दैकै खामैं। <verse eid="1TI 4:3"/><verse number="4" style="v" sid="1TI 4:4"/>काहैकि परमेस्वर जो कछु भी बनाई है बौ हर चीज अच्छी है; और कछु चीज को निरादर नाय करने है, लेकिन सब कछु चीज धन्यवाद कि प्रार्थना के संग खाई जाए, <verse eid="1TI 4:4"/><verse number="5" style="v" sid="1TI 4:5"/>काहैकि परमेस्वर को बचन और प्रार्थना बाकै परमेस्वर कै समर्पित करन के योग्य बनाथै।<verse eid="1TI 4:5"/></para>
  <para style="s">ईसु मसीह को एक अच्छो सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6"/>अगर तू सब विस्वासी भईय्यन कै जे बातन की खबर देत रहगो, तौ ईसु मसीह को अच्छो सेवक मानो जागो; जो बिस्वास और अच्छी सिक्छा मैं बढ़ाओ गौ। <verse eid="1TI 4:6"/><verse number="7" style="v" sid="1TI 4:7"/>अभक्ति की खराब और बेकार की बातन से दूर रहबौ; जाके बजाय, खुदकै ईस्वरीय बनन के ताहीं प्रसिक्छित करैं। <verse eid="1TI 4:7"/><verse number="8" style="v" sid="1TI 4:8"/>सारीरिक व्यायाम को थोड़ी फायदा है, लेकिन भक्ति हर तरहन से फायदेमंद है, काहैकि जौ समय और आनबारे समय दोनों के ताहीं जिंदगी को वादा करथै। <verse eid="1TI 4:8"/><verse number="9" style="v" sid="1TI 4:9"/>जौ एक सच्ची कहाबत है, जोकै पूरी तरह से अपनाओ जाए और बिस्वास करो जाबै। <verse eid="1TI 4:9"/><verse number="10" style="v" sid="1TI 4:10"/>जोके ताहीं हम कड़ी मेहनत करथैं, काहैकि हम अपनी आस कै जिंदे परमेस्वर मैं रखे हैं, जो सबन को उद्धारकर्ता है और खासकर बे आदमिन को जो बिस्वास करथैं।<verse eid="1TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11"/>उनकै जौ हुकम दैकै और सिखात रहा। <verse eid="1TI 4:11"/><verse number="12" style="v" sid="1TI 4:12"/>कोई तेरी जवानी कै मामूली ना समझ पाबै; पर बचन, चाल चलन, प्रेम, बिस्वास, और पवित्रता मैं विस्वासिन के ताहीं आदर्स बन जा। <verse eid="1TI 4:12"/><verse number="13" style="v" sid="1TI 4:13"/>जबले मैं ना आमौं, तौले पढ़न और प्रोत्साहित की सिक्छा देन और सिखान मैं समर्पित रहा। <verse eid="1TI 4:13"/><verse number="14" style="v" sid="1TI 4:14"/>बौ वरदान को दुरप्रयोग मत कर, जो तेरे मैं है, जो तोकै तब दौ गौ रहै, जब भविस्यवाँड़ी करन बारे बोली रहैं और बड़े-बूढ़े तेरे ऊपर हाथ रखीं रहैं। <verse eid="1TI 4:14"/><verse number="15" style="v" sid="1TI 4:15"/>जे चीजन की अभ्यास कर और बाकै अपने आपकै सौंप दे, ताकी तेरी उन्नति सबन कै दिखाई देबै। <verse eid="1TI 4:15"/><verse number="16" style="v" sid="1TI 4:16"/>अपने आप मैं और अपनी सिक्छा मैं चहाचीतो रहा, जे बातैं करते रहीये, काहैकि अगर ऐसो करत रहगो, तौ तू अपने, और अपने सुनन बारेन ताहीं भी उद्धार को वजह बनैगो।<verse eid="1TI 4:16"/></para>
  <chapter eid="1TI 4"/>
  <chapter number="5" style="c" sid="1TI 5"/>
  <para style="s">विस्वासिन के ताहीं जिम्मेदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1"/>कोई बड़े-बूढ़े कै मत झुका; बाकै अपनो दऊवा समझकै समझायदे, और ज्वानन कै अपनो भईय्या समझ, <verse eid="1TI 5:1"/><verse number="2" style="v" sid="1TI 5:2"/>पूरी पवित्रता के संग बूढ़ी बईंय्यरन कै अईय्या के हानी, और ज्वान बईंय्यरन कै बहेनिया के हानी समझ।<verse eid="1TI 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3"/>बे बिधवन को जो सच्ची मैं बिधवा हैं आदर कर। <verse eid="1TI 5:3"/><verse number="4" style="v" sid="1TI 5:4"/>और अगर कोई बिधवा के बालका या नतिया-पोता हैं, तौ बे पहले अपने परिवार के प्रति अपने धार्मिक कर्तव्य को पालन करनो सीखनो चाहिए और ऐसे करकै अपने अईय्या-दऊवा और दादो-दादी को कर्जा चुकानो चाहिए, काहैकि जहे परमेस्वर कै खुस करथै। <verse eid="1TI 5:4"/><verse number="5" style="v" sid="1TI 5:5"/>एक बिधवा, जो अकेली है, बाकी देखभार करन बारो कोई नाय है, और बौ परमेस्वर मैं अपनी आस रखथै और रात-दिन बाकी मदत के ताहीं प्रार्थना करत रहथै। <verse eid="1TI 5:5"/><verse number="6" style="v" sid="1TI 5:6"/>पर जो बिधवा अपने आपकै मजा देथै, गलत काम करथै, तौ बौ जीते जी मर गई है। <verse eid="1TI 5:6"/><verse number="7" style="v" sid="1TI 5:7"/>लोगन कै जहो बातैं भी सिखाए कर ताकी बे निर्दोस रहामैं। <verse eid="1TI 5:7"/><verse number="8" style="v" sid="1TI 5:8"/>लेकिन अगर कोई भी अपने हितुअन, खासकर अपने खुद के परिवार के लोगन की देखभार नाय करै, तौ बौ बिस्वास से मुकर गौ है और एक अविस्वासी से भी बुरो बन गौ है। <verse eid="1TI 5:8"/><verse number="9" style="v" sid="1TI 5:9"/>कोई बिधवा को, बिधवन के नाओं मैं तौले मत जोड़ौ जबले कि बाकी उमर साठ साल से अगरी ना हुई जाबै। जाके अलावा, बौ एकै आदमी कि बईय्यर बनी होबै, <verse eid="1TI 5:9"/><verse number="10" style="v" sid="1TI 5:10"/>और अच्छे कामन के ताहीं एक इज्जत दार होबै: एक बईय्यर जो अपने बालकन कै अच्छी तरह से पाली, अपने घरै हितुअन कि सेवा आदर करी होबै, पवित्र लोगन के पाँव धोई होबै, और विस्वासिन की मेहमानदारी करी होबै, लोगन की परेसानी मैं मदत करी होबै, और उनके ताहीं अच्छो करन के ताहीं खुदकै सौंपी होबै।<verse eid="1TI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11"/>लेकिन ज्वान बिधवन के नाओं मत लिखियो, काहैकि जब बे मसीह से दूर जाएकै सुख और गलत कामन मैं पड़ जाथैं, तौ बे बिहा करनो चाहथैं, <verse eid="1TI 5:11"/><verse number="12" style="v" sid="1TI 5:12"/>और दोसी मानी जाथैं, काहैकि बे अपनो पहलो वादा कै छोड़ देथैं। <verse eid="1TI 5:12"/><verse number="13" style="v" sid="1TI 5:13"/>और जाके संग-संग बे घर-घर फिरकै आलसी होनो सिक जाथैं, और खाली आलसी नाय, और बक-बक करत रहथैं और दुसरेन के काम मैं हाथ डारथैं, और उल्टा सीधी बात बोलथैं। <verse eid="1TI 5:13"/><verse number="14" style="v" sid="1TI 5:14"/>इसलै मैं चाहंगे कि ज्वान बिधवन को बिहा होबै, उनके बालका होमैं और बे अपने घर कि देखभार करैं, ताकी हमरे दुस्मनन कै हमरी बुराई बतकान को मौका नाय मिलै। <verse eid="1TI 5:14"/><verse number="15" style="v" sid="1TI 5:15"/>एकाद तौ बहक कै सैतान के पच्छू हुई चुकी हैं। <verse eid="1TI 5:15"/><verse number="16" style="v" sid="1TI 5:16"/>अगर कोई भी विस्वासी के घरै बिधवा हैं, तौ घरबारेन कै बाकी देखभार करनो चाहिए और कलीसिया मैं बोझ नाय डारनो चाहिए, ताकी बौ उन बिधवन की देखभार कर सकै जो सच्ची मैं बिधवा और अकेली हैं।<verse eid="1TI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17"/>जो बड़ो-बूढ़ो अच्छो काम करथै, खासकर बे जो बचन सुनान और सिखान मैं मेहनत करथै, दुई गुना आदर के काबिल समझो जाबै। <verse eid="1TI 5:17"/><verse number="18" style="v" sid="1TI 5:18"/>काहैकि पवित्र सास्त्र कहथै, “दाव लगान बारे बरधा को मोहों मत भाँदियो, काहैकि मजदूर अपनी मजदूरी को हकदार है।”<note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="DEU 25:4">व्यवस्थाविवरन 25:4</ref>; <ref loc="MAT 10:10">मत्ती 10:10</ref> </char></note> <verse eid="1TI 5:18"/><verse number="19" style="v" sid="1TI 5:19"/>अगर कोई बड़े-बूढ़े ऊपर दोस लगाबै, तौ दुई या तीन गभन के बिना बाकै मत मानियो।<note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="DEU 19:15">व्यवस्थाविवरन 19:15</ref></char></note> <verse eid="1TI 5:19"/><verse number="20" style="v" sid="1TI 5:20"/>पाप करन बारेन कै सबके सामने समझाए दे, ताकी और लोग पाप करन से डरामैं।<verse eid="1TI 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21"/>परमेस्वर और ईसु मसीह, और चुने भै स्वर्गदूतन कै हिंयाँ मानकै मैं तोकै चितौनी देथौं, कि तू मन खोलकै जे बातन कै माने कर, और कोई काम भेदभाव से मत करे कर। <verse eid="1TI 5:21"/><verse number="22" style="v" sid="1TI 5:22"/>परमेस्वर की सेवा मैं उनकै सौंपन के ताहीं लोगन के ऊपर हाथ रखन कि कोई जल्दी नाय है। और दुसरेन के पापन मैं भागी मत हुइयो; अपने आपकै सुद्ध बनाए रखा।<verse eid="1TI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23"/>खाली पानी मत पीबै, अपने पाचन मैं मदत करन के ताहीं थोड़ी सी दाखरस ले, काहैकि तुम गजब बार बिमार पड़थौ।<verse eid="1TI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24"/>कुछ लोगन के पाप दिखाई दै जाथैं, और फैसला के ताहीं पहले से पुग जाथैं, लेकिन दुसरेन के पाप बाद मैं दिखाई देथैं। <verse eid="1TI 5:24"/><verse number="25" style="v" sid="1TI 5:25"/>बैसिये कुछ भले काम स्पस्ट दिखाइयौ दै जाथैं, और जो ऐसे नाय होथैं, बेऊँ लुक नाय सकथैं।<verse eid="1TI 5:25"/></para>
  <chapter eid="1TI 5"/>
  <chapter number="6" style="c" sid="1TI 6"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1"/>जो लोगन के ऊपर दास को जुआ रखो पड़ो हैं, उनकै अपने मालिक कै पूरे सम्मान के काबिल समझनो चाहिए, ताकी कोई भी परमेस्वर और हमरी सिक्छा के नाओं की बुराई न करै। <verse eid="1TI 6:1"/><verse number="2" style="v" sid="1TI 6:2"/>विस्वासी मालिकन से जुड़े भै नौकरन कै उनकी बेजती नाय करनो चाहिए, काहैकि बे विस्वासी भईय्या हैं। जाके बजाय, बे उनकै और अच्छी सेवा दै सकथैं, काहैकि जो लोग उनके काम से फायदा उठाथैं, बे विस्वासी होथैं, जिनकै बे प्रेम करथैं। तुमकै जे चीजन कै सिखानो और इनको प्रचार करनो चाहिए।<verse eid="1TI 6:2"/></para>
  <para style="s">झूठी सिक्छा और सच्चो धन</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3"/>जो कोई अलग सिद्धांत सिखाथै, और हमरे प्रभु ईसु मसीह की सच्ची बातन कै और हमरे धर्म कि सिक्छा के नाय मानथै, <verse eid="1TI 6:3"/><verse number="4" style="v" sid="1TI 6:4"/>तौ बौ घमंडी है और कछु नाय जानथै, उल्टा बाकै बखेड़ा करन की और बातन के ऊपर तर्क लगान कि बिमारी है, जो डाह, और लड़ाई, और बुराई कि बातैं, और बुरे-बुरे सक, <verse eid="1TI 6:4"/><verse number="5" style="v" sid="1TI 6:5"/>और बे लोगन से लगातार तर्क जिनके मन काम नाय करथैं, और जिनके पास अब सच्चाई नाय है। उनकै लगथै, कि धर्म सेठ बनन को एक तरीका है।<verse eid="1TI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6"/>ठीक है, धर्म हमैं गजब कामयाब बनाथै, अगर हमरे पास जो कछु है बासे संतुस्ट होमैं तौ। <verse eid="1TI 6:6"/><verse number="7" style="v" sid="1TI 6:7"/>हम जौ दुनिया मैं का लैकै आए? कछु नाय! हम जौ दुनिया से का लैकै जांगे? कछुए नाय! <verse eid="1TI 6:7"/><verse number="8" style="v" sid="1TI 6:8"/>इसलै, अगर हमरे पास खानु और लत्ता-कपड़ा हैं, तौ हमैं इतनेइ मैं खुस रहनो चाहिए। <verse eid="1TI 6:8"/><verse number="9" style="v" sid="1TI 6:9"/>लेकिन जो लोग सेठ बननो चाहथैं, बे लालच मैं पड़ जाथैं, और गजब मूर्ख और खराब इच्छा के जार मैं फस जाथैं, जो तुमकै बरबाद करन और सत्यानास करन के ताहीं खींचथै। <verse eid="1TI 6:9"/><verse number="10" style="v" sid="1TI 6:10"/>काहैकि रुपईया को प्रेम तुमकै जे चीजन कै सिखानो और इनको प्रचार करनो चाहिए। तमान तरहन कि बुराइयन कि जड़ है, जोकै पान ताहीं कितने जनी बिस्वास से भटक कै अपने आपकै गजब तरहन के दुखन से उनको दिल टूट गौ है।<verse eid="1TI 6:10"/></para>
  <para style="s">ब्यक्तिगत सूचना</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11"/>पर हे परमेस्वर के जन, तैं जे बातन से भाज; और न्यायीपन, भक्ति, बिस्वास, प्रेम, धीरज, और सोम्यता को पीछा कर। <verse eid="1TI 6:11"/><verse number="12" style="v" sid="1TI 6:12"/>बिस्वास की दौड़ मैं अपनो पहलो जघा बना, और अपने ताहीं अनंत जिंदगी जीत; जौ जिंदगी के ताहीं जौ रहै कि परमेस्वर तुमकै बुलाई, जब तुम भौत से गभन के सामने अपने बिस्वास कै मजबूती से अपनाय। <verse eid="1TI 6:12"/><verse number="13" style="v" sid="1TI 6:13"/>परमेस्वर की उपस्थिति मैं, जो सब चीजन के ताहीं जिंदगी देथै, और ईसु मसीह के उपस्थिति मैं, जो पुन्तियुस पिलातुस के सामने अपने बिस्वास कै मजबूती से अपनाई, मैं तुमकै आग्या देथौं<note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">यूहन्ना 18:37</ref></char></note> <verse eid="1TI 6:13"/><verse number="14" style="v" sid="1TI 6:14"/>जौ आग्या कै मानिये और बौ दिन ले बिस्वास करीये जबले हमरो निर्दोस प्रभु ईसु मसीह आए ना जाबै। <verse eid="1TI 6:14"/><verse number="15" style="v" sid="1TI 6:15"/>परमेस्वर जोकै बौ सई समय मैं दिखागो, जो परमधन्य और एकमात्र सासक और राजाओं को राजा, और प्रभुअन को प्रभु है, <verse eid="1TI 6:15"/><verse number="16" style="v" sid="1TI 6:16"/>बौ अकेलो अमर है; बौ ऐसे उजिते मैं रहथै कि कोई बासे मिल नाय सकथैं, बाकै कोई कहु ना देखो; कोई बाकै कहुए ना देख सकैगो। बाकी इमानदारी और अनंत ताकत है! आमीन।<verse eid="1TI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17"/>जौ युग की सम्पत्ति बारेन कै हुकम दे कि बे घमंडी ना होमैं और बेकार के पैसन के ऊपर आस नाय रखैं, पर परमेस्वर के ऊपर आस रखौ जो हमरे सुख दुख के ताहीं सब कछु खूबै करकै देथै। <verse eid="1TI 6:17"/><verse number="18" style="v" sid="1TI 6:18"/>उन्हैं हुकम दे कि भलाई करौ, भले कामन मैं सेठ बनौ, और दयालु बनौ और मदत करन ताहीं तैयार रहबौ, <verse eid="1TI 6:18"/><verse number="19" style="v" sid="1TI 6:19"/>ऐसे करकै बे अपने ताहीं एक खजाना जमा करंगे, जो आनबारे समय के ताहीं एक मजबूत बुनियाद होगी, तौ बे बौ जिंदगी कै जीतन के लायक होंगे जो सच्ची जिंदगी है।<verse eid="1TI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20"/>तीमुथियुस, जो तुमरी देखभार करन के ताहीं सौंपो गौ है, बाकी देखाभारी करे रखईयो, और अभक्ति और बुरी बातन से बचैं, और बेकार की बातन से बचैं जोकै कुछ लोग गलती से “ग्यान” समझथैं, उनसे बचैं। <verse eid="1TI 6:20"/><verse number="21" style="v" sid="1TI 6:21"/>कुछ लोग जाकै अपने पास रखन को दाबा करी हैं, और जबकी बे बिस्वास खोए दईं हैं। परमेस्वर को अनुग्रह और किरपा तुम सबन के ऊपर बनी रहबै।<verse eid="1TI 6:21"/></para>
  <chapter eid="1TI 6"/>
</usx>
