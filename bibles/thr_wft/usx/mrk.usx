<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Rana Tharu</book>
  <para style="h">मरकुस</para>
  <para style="toc3">मरकुस</para>
  <para style="toc2">मरकुस</para>
  <para style="toc1">मरकुस को लिखो भौ ईसु मसीह को सुसमाचार</para>
  <para style="mt2">मरकुस का लिखा हुआ ईसु मसीह का सुसमाचार</para>
  <para style="mt1">मरकुस को लिखो भौ ईसु मसीह को सुसमाचार</para>
  <para style="imt">परिचय</para>
  <para style="ip">मरकुस को लिखो भौ सुसमाचार कि किताब, बे चार नये नियम की किताब मैं से है, जोमैं ईसु मसीह के जिंदगी के बारे मैं बताओ गौ है। जे किताबन कै “गौस्पल” कहो जाथै। गौस्पल को मतलब “सुसमाचार” होथै। ईसु की मौत के बाद जे चार किताबन कै मत्ती, मरकुस, लूका, और यूहन्ना लिखीं। जे चारौ मैं से मरकुस को लिखो भौ सुसमाचार सबसे छोटी किताब है। ऐसो मानो जाथै कि जौ किताब सब सुसमाचारन से पहले मसीह के पैदा होन के 65-70 साल के बाद लिखी गई। और भौत से ईस्वर पंडितन को माननो है कि जौ रोम मैं रोमी मसीहियन कै प्रेरित करन ताहीं लिखी गई।</para>
  <para style="ip">मरकुस जोकै जौन मरकुस करकै जानो जाथै प्रेरित पौलुस और बरनबास को संग बारो रहै। बाके मान-मरयादा कै बौ समय ठेस लगी, जब बौ पहली मिसनरी सफर के बीच मैं पौलुस और बरनबास कै बीचै मैं छोड़ दई <char style="xt"><ref loc="ACT 13:13">प्रेरितो 13:13</ref></char>। लेकिन बाद मैं हम देखथैं कि मरकुस बरनबास के संग दुबारा से सफर करथै <char style="xt"><ref loc="ACT 15:37-39">प्रेरितो 15:37-39</ref></char>। मरकुस कै पतरस को नजदीकी दिलबर करकै जानो जाथै <char style="xt"><ref loc="1PE 5:13">1 पतरस 5:13</ref></char>। मरकुस ईसु की जिंदगी कै नाय देखी रहै। तहुँओं बौ पतरस की गभाई कै लिखे भै के बुनियाद मैं जौ किताब लिखी । जौ सुसमाचार मैं मरकुस चेलापन और ईसु की आखरी समय बारी सिक्छा मैं जोर देथै।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. मरकुस किताब को परिचय देथै। <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">2. मरकुस ईसु के गलील मैं करी सेवा के बारे मैं बताथै। <char style="ior"><ref loc="MRK 1:14-8:21">1:14–8:21</ref> </char></para>
  <para style="io1">3. जाके बाद बौ ईसु के यरूसलेम सफर के बारे मैं बताथै। <char style="ior"><ref loc="MRK 8:22-10:52">8:22–10:52</ref> </char></para>
  <para style="io1">4. ईसु को यरूसलेम मैं रहनो हुँआँ बाकी मौत और पुनरुत्थान होन के बारे मैं लिखकै किताब कै खतम करथै। <char style="ior"><ref loc="MRK 11:1-16:8">11:1–16:8</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">यूहन्ना बपतिस्मा देनबारे को, प्रचार</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती 3:1-12</ref>; <ref loc="LUK 3:1-18">लूका 3:1-18</ref>; <ref loc="JHN 1:19-28">यूहन्ना 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />परमेस्वर को लौड़ा ईसु मसीह के सुसमाचार की सुरुवात। <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />जैसो यसायाह भविस्यवक्ता<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">अग्गु की बात बतान बारो </char></note> भविस्यवाँड़ी करन बारे की किताब मैं लिखो है</para>
  <para style="q1" vid="MRK 1:2">“परमेस्वर कही, ‘देख मैं अपने दूत कै तेरे अग्गु पनारथौं,</para>
  <para style="q2" vid="MRK 1:2">जो तेरे ताहीं रहा सुधारैगो।’<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />बन मैं एक पुकारन बारे की अबाज सुनाई दई है,</para>
  <para style="q2" vid="MRK 1:3">‘कि प्रभु के ताहीं रहा बनाबौ;</para>
  <para style="q2" vid="MRK 1:3">और बाकी रहा सीधी करौ!’”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />यूहन्ना बन मैं आओ, और बौ प्रचार करकै आदमिन से कहेन लागो, “अपने पापन से मन फिराबौ और बपतिस्मा लेबौ तभईये परमेस्वर तुम्हारे पापन से तुमकै माफ करैगो।” <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />तौ यहूदिया देस के और यरूसलेम सहर के सबै रहेन बारे निकरकै बाके झोने आए, और अपने पापन कै मानकै यरदन नदिया मैं बासे बपतिस्मा लईं।<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />यूहन्ना ऊँट के खाल के लत्ता पहनत रहै और अपने करिहाँओं मैं चमड़ा को कमरबंद भाँदे रहेत रहै, और बौ टींड़ा और बन को सहद खाए करत रहै, <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />और जौ बात को प्रचार करत रहै, “कि मेरे बाद जो आनबारो है, बौ महुँ से ताकतवर है, मैं लोहोक्कै बाके जूता की तनी खोलनौ लायक नाय हौं। <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />मैं तौ तुमकै पानी से बपतिस्मा दौ हौं, पर बौ तुमकै पवित्र आत्मा से बपतिस्मा देबैगो।”<verse eid="MRK 1:8" /></para>
  <para style="s">ईसु को बपतिस्मा और बाकी परिक्छा</para>
  <para style="r">(<ref loc="MAT 3:13">मत्ती 3:13</ref>; <ref loc="MAT 4:11">4:11</ref>; <ref loc="LUK 3:21-22">लूका 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />बेईं दिनन ईसु गलील देस के नासरत नगर से आए कै, यरदन नदिया मैं यूहन्ना से बपतिस्मा लई। <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />और जब ईसु पानी से निकरकै ऊपर आओ, तौ बौ बहे समय कै स्वर्ग खुलत और आत्मा कै कबूतर के हानी अपने ऊपर उतरत भौ देखी। <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />और स्वर्ग<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">आसमान से अबाज आनो</char></note> से एक अबाज आई, “तू मेरो प्रिय लौड़ा है, तोसे मैं बड़ा खुस हौं।”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />तौ पवित्र आत्मा बाकै तुरंतै बन घाँईं पनार दई। <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />और बन मैं चालीस दिन ले, सैतान बाकै लालच देत रहो। और बौ बन के जानवरन के संग रहो, और स्वर्गदूत बाकी सेवा करत रहे।<verse eid="MRK 1:13" /></para>
  <para style="s">ईसु के सेवा करन की सुरुवात</para>
  <para style="r">(<ref loc="MAT 4:12-22">मत्ती 4:12-22</ref>; <ref loc="LUK 4:14-15">लूका 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />यूहन्ना के पकड़वाए जान के बाद ईसु गलील मैं आयकै परमेस्वर के राज्य को सुसमाचार को प्रचार करी, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />और कही, “समय पूरो हुई गौ है, और परमेस्वर को राज्य झोने आए चुको है; मन बदलौ और सुसमाचार मैं बिस्वास करौ।”<verse eid="MRK 1:15" /></para>
  <para style="s">ईसु चार मछरेयन कै मस्काई</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />ईसु गलील देस की झील के डींड़े-डींड़े जात भै, बौ सिमौन और बाके भईय्या अन्द्रियास कै झील मैं जार डारत देखी; काहैकि बे मछरेया रहैं। <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ईसु उनसे कही, “मेरे पच्छू आबौ; मैं तुमकै परमेस्वर के झोने कैसे आदमिन कै लाथैं बौ सिखांगो।” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />बे तुरंतै जार कै छोड़कै बाके पच्छू हुई लईं।<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />और जरा सो अग्गु पुगकै, ईसु जब्दी के लौड़ा याकूब, और बाके भईय्या यूहन्ना कै, अपनी नईंयाँ मैं जार कै सुरजात भै देखी। <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />बौ तुरंतै उनकै मस्काई; और बे अपने दऊवा जब्दी कै मजदूरन के संग नईंयाँ मैं छोड़कै, बाके पच्छू हुई लईं।<verse eid="MRK 1:20" /></para>
  <para style="s">भूत पकड़े भै आदमी कै अच्छो करनो</para>
  <para style="r">(<ref loc="LUK 4:31-37">लूका 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />तौ फिर ईसु और बाके चेला कफरनहूम सहर मैं आए, और बौ तुरंतै साबत के दिन सभाघर<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">यहूदियन को सभाघर</char></note> मैं जाएकै उपदेस देन लागो। <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />और लोग बाके उपदेस से चौहोंक गै; काहैकि बौ उनकै यहूदि नियम के सिक्छक के हानी नाय, बल्किन अपने अधिकार से उपदेस देत रहै।<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />और बहे समय, उनके सभाघर मैं एक आदमी रहै, जोके भीतर प्रेत आत्मा सटकी रहै। <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />बौ चिल्लाए कै कही, “हे ईसु नासरी, हमकै तोसे का काम? का तू हमकै नास करन कै आओ है? मैं तोकै जानथौं, तू कौन है? तू परमेस्वर को पवित्र आदमी है!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ईसु बाकै झुकाएकै कही, “चुप्पा रहे; और बाके भीतर से निकर जा।”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />तौ प्रेत आत्मा बाकै ऐंठाएकै, और बड़ा जोड़ से किक्याए कै बाके भीतर से निकर गौ। <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />जौ देखकै सब जनी चौहोंक गै, और सब आपस मैं बहस करन लग्गै, “कि जौ का बात है? जौ तौ अनोखो उपदेस है! बौ तौ अधिकार से प्रेत आत्मा कै आग्या देथै, और प्रेत आत्मा बाकी बात मानथैं।”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />और ईसु को नाओं तुरंतै गलील के आस-पास के सबै जघन मैं फैल गौ।<verse eid="MRK 1:28" /></para>
  <para style="s">ईसु निरे बिमार आदमिन कै अच्छो करी</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्ती 8:14-17</ref>; <ref loc="LUK 4:38-41">लूका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />और ईसु तुरंतै सभाघर मैं से निकरकै, याकूब और यूहन्ना के संग सिमौन और अन्द्रियास के घरै आओ। <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />और सिमौन की सास ततासेरी से बिमार रहै, और बे तुरंतै बासे, बाके बारे मैं कहीं। <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />तौ फिर ईसु बाके झोने जाएकै बाको हाथ पकड़कै उठाई; और बाको बुखार तुरंतै उतर गई, और बौ उनकी सेवा-खातिर करन लग्गई।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />संजा खिन जब दिन डूब गौ तौ लोग सब बिमारन कै और उनकै, जोके भीतर प्रेत आत्मा सटकी रहैं, ईसु के झोने लाईं। <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />और पूरो सहर बाके घर के दुआरे जुराएगौ। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />और बौ निरेन कै जो अलग-अलग तरहन की बिमारिन से परेसान रहैं, उनकै अच्छो करी, और निरे तरहन के भूतन कै निकारी, और प्रेत आत्मा कै मसकन तक नाय दई, काहैकि प्रेत आत्मा ईसु कै जानत रहैं।<verse eid="MRK 1:34" /></para>
  <para style="s">गलील सहर मैं ईसु को प्रचार</para>
  <para style="r">(<ref loc="LUK 4:42-44">लूका 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />और भुकभुको होन से भौत अग्गु, ईसु उठकै निकरो, और बन मैं गौ और बौ प्रार्थना करन लग्गौ। <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />तौ सिमौन और बाके संग बारे ईसु कै ढूँड़न गै। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />जब ईसु मिलगौ, तौ बे बासे कहीं, “सब जनी तोकै ढूँड़ रै हैं।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ईसु उनकै जबाब दई, “आबौ; आपन और कहूँ आसपास के गाँव मैं चलैं, मैं हुँओं प्रचार करंगो, काहैकि मैं जहे ताहीं निकरो हौं।”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />और ईसु पूरे गलील मैं उनके सभाघर मैं जाए-जाएकै प्रचार करतो, और प्रेत आत्मा कै निकारे करत रहै।<verse eid="MRK 1:39" /></para>
  <para style="s">ईसु एक कोहढ़ी कै अच्छो करी</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्ती 8:1-4</ref>; <ref loc="LUK 5:12-16">लूका 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />एक कोहढ़ी ईसु के झोने आयकै, बासे नहोरे करी, और बाके अग्गु घूँटे टेक कै बासे कही, “अगर तू चाहबैगो तौ मोकै सुद्ध कर सकथै।”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ईसु बाके ऊपर तरस खाएकै बाके ऊपर हाथ बढ़ाई, और बाकै छुइ कै कही, “मैं चाहथौं कि तू सुद्ध हुई जा।” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />और तुरंतै बाको कोहोढ़ चले गौ, और बौ सुद्ध हुई गौ। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />फिर ईसु बाकै समझाए कै तुरंत पनार दई, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />और बासे कही, “देख, कोई से कछु मत कहिये, और जाएकै अपने आपकै पुजारी<note caller="+" style="f"><char style="fr" closed="false">1:44 </char><char style="ft" closed="false">पुजारी, यहूदिन की भासा को सब्द है</char></note> कै दिखा, और अपने सुद्ध होन के बारे मैं, जो कछु मूसा के नियम हैं, बाकै भेंट चढ़ा ताकी तेरे अच्छे होन को तू गभा बनै।<note caller="+" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लैव्यवस्था 14:1-32</ref></char></note>”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />पर बौ हुँआँ से जाएकै जौ बात को गजब प्रचार करी और हिंयाँ तक की ऐसे बात फैलान लग्गौ की ईसु फिर खुल्लम-खुल्ला नगर मैं नाय जाए पाई, पर बौ बाहर अलग्याँओं जघा मैं रहेत रहै; और लोग सब घाँईं से बाके झोने आत रहैं।<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">फालिस मारे भै बिमार आदमी कै अच्छो करनो</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्ती 9:1-8</ref>; <ref loc="LUK 5:17-26">लूका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />थोड़ी दिन के बाद ईसु कफरनहूम सहर मैं आओ, और ऐसी खबर फैली की बौ अपने घर मैं है। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />फिर इत्ते जनी जुराए गै की दुआरे तक जघा नाय मिली; और बौ उनकै बचन सुनात रहै। <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />और चार जनी एक फालिस मारे भै बिमार आदमी कै उठाएकै बाके झोने लै आईं। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />जब बे भीड़ की बजह से बाके झोने नाय पुग पाईं, तौ बे बौ छत, जोके तरे ईसु रहै, उत्कार दईं; और बाकी खटिया कै जोमैं फालिस को बिमार आदमी लेटो रहै, बाकै हुँए से तरे उतार दईं। <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />ईसु उनको ऐसो बिस्वास देखकै बौ फालिस के बिमार आदमी से कही, “ओरे लौड़ा, तेरे पाप माफ हुईगै।”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />तौ जो हुँआँ पर कुछ यहूदि नियम के सिक्छक बैठे पड़े रहैं, बे अपने-अपने मन मैं सोचन लागे, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“कि जौ आदमी ऐसो कैसे कह सकथै? जौ तौ परमेस्वर की बुराई कर रहो है! परमेस्वर के अलावा और कौन पाप माफ कर सकथै?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ईसु तुरंतै अपने मन (आत्मा) मैं जानगौ, की बे अपने-अपने मन मैं ऐसो सोच रै हैं, और बौ उनसे कही, “तुम अपने मन मैं ऐसो काहेकै सोच रहे हौ? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />आसान का है? का फालिस के बिमार आदमी से ऐसो कहनो कि तेरे पाप माफ हुईगै, या फिर जौ कहनो, कि उठ अपनी खटिया उठा और नेंग? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />पर जासे तुम जानलेबौ की इंसान के लौड़ा कै दुनिया मैं पाप माफ करन को भी अधिकार है।” बौ फालिस के बिमार आदमी से कही, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“मैं तोसे कहथौं, उठ, अपनी खटिया उठाएकै अपने घरै चले जा।”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />और बौ उठो, और तुरंतै अपनी खटिया उठाएकै सबन के अग्गु से निकरकै चले गौ। ऐसो देखकै सब चौहोंक गै, और परमेस्वर की बड़ाँईं करन लागे, और कहेन लागे, “हम ऐसो होत भौ कहुए नाय देखे।”<verse eid="MRK 2:12" /></para>
  <para style="s">लेवी कै बुलाओ जानो</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती 9:9-13</ref>; <ref loc="LUK 5:27-32">लूका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ईसु फिर निकरकै गलील झील के टिकारे गौ, और पूरी भीड़ बाके झोने आई<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="MRK 1:45">मरकुस 1:45</ref>; <ref loc="LUK 5:15">लूका 5:15</ref>; <ref loc="JHN 6:2">यूहन्ना 6:2</ref></char></note>, और बौ उनकै उपदेस देन लगो। <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />बौ जात भौ हलफई के लौड़ा लेवी कै लगान की चौकी मैं बैठो भौ देखी, और बासे कही, “मेरे पच्छू हुई ले।” और बौ उठकै, बाके पच्छू हुई लई।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />जब ईसु लेवी के घरै खानु खान कै बैठो, तौ निरे जनी लगान लेन बारे और पापी, ईसु और बाके चेलन के संग खानु खान कै बैठे; और बे निरे जनी रहैं, और बाके पच्छू हुई लईं रहैं। <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />फरीसिन<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ACT 23:1">प्रेरितो 23:1</ref></char></note> मैं से और नियम की सिक्छा देनबारे भौत से यहूदि नियम के सिक्छक लोग जौ सब देखकै, कि बौ तौ पापी और लगान लेन बारेन संग खानु खाए रौ है, बाके चेलन से कहीं, “बौ काहे लगान लेन बारेन और पापिन के संग खानु खाथै!”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ईसु जौ सुनकै उनसे कही, “अच्छे भलेन कै बैध की जरूरत नाय होथै, लेकिन बिमारन कै होथै। मैं धर्मिन कै नाय, पर पापिन कै मस्कान आओ हौं।”<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="LUK 19:10">लूका 19:10</ref>; <ref loc="1TI 1:15">1 तीमुथियुस 1:15</ref></char></note><verse eid="MRK 2:17" /></para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्ती 9:14-17</ref>; <ref loc="LUK 5:33-39">लूका 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />यूहन्ना बपतिस्मा देनबारे के चेला, और फरीसी बर्त रखत रहैं, तौ कुछ लोग आयकै ईसु से कहीं, “ऐसो काहे है कि यूहन्ना के चेला और फरीसिन के चेला तौ बर्त रखथैं, पर तेरे चेला तौ बर्त नाय रखथैं?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ईसु उनकै जबाब दई, “एक बिहा बारे घर मैं जबले दुल्हा बरैतियन के संग रहथै, का बे बर्त रख सकथैं?” और जबले दुल्हा उनके संग है, तौले बे बर्त नाय रखथैं। <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />पर बे दिन आंगे, जब दुल्हा उनसे अलग करो जागो; बौ समय बे बर्त रखंगे।<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“कोरे लत्ता को थिगरा पुराने लत्ता मैं कोई नाय लगाथै; ना तौ बौ थिगरा सुकर कै बामै से पुराने लत्ता से खींच लेगो, और जो भार है बौ पहले से अगरो फट जाबैगो। <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />नई दाखरस कै पुराने मसकन<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">दाखरस रखन बारी खाल की थैलिया</char></note> मैं कोई नाय रखथै, ना तौ दाखरस<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">अंगूर को रसा</char></note> मसकन कै फाड़ देगी, और दाखरस और मसका दोनों बरबाद हुई जांगे, पर नई दाखरस कै नये मसकन मैं भरो जाथै।”<figure style="fig" alt="Wineskin bag" file="lb00145c.tif" size="col" copy="Horace Knowles ©" ref="2:22">अंगूर को रसा रखन बारो झोला</figure><verse eid="MRK 2:22" /></para>
  <para style="s">ईसु साबत<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">सप्ताह को आखरी दिन जोकै परमेस्वर आराम करन को दिन बनाई है</char></note> के दिन को प्रभु</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्ती 12:1-8</ref>; <ref loc="LUK 6:1-5">लूका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />ऐसो भौ कि ईसु साबत के दिन खेत से हुईकै जात रहै, और बाके चेला नेंगतै-नेंगत बाली तोड़न लग्गै। <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />तौ फरीसी ईसु से कहीं, “देख; साबत के दिन तेरे चेलन कै ऐसो करनो नियम के हिसाब से ठीक नाय है?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ईसु उनकै जबाब दई, “का तुम जौ कहुए ना पढ़े हौ कि जब दाऊद कै जरूरत पड़ी, और जब बौ और बाके संग के भूंके भै, तौ बौ का करी रहै? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />बौ कैसे अबियातार बड़ो पुजारी के समय<note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="1CH 24:6">1 इतिहास 24:6</ref>; <ref loc="2SA 8:17">2 समूएल 8:17</ref></char></note>, परमेस्वर के घर मैं भेंट करी भई रोटी खाईं, जो रोटी खानो नियम के हिसाब से बड़े पुजारी के अलावा कोई नाय खाए सक्त रहै, और बौ अपने संग बारेन कै दई?”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />तौ बौ उनसे कही, “साबत को दिन आदमिन के ताहीं बनाओ गौ है<note caller="+" style="x"><char style="xo" closed="false">2:27 </char><char style="xt" closed="false"><ref loc="EXO 23:12">निर्गमन 23:12</ref></char></note>, जौ न कि आदमी साबत के दिन ताहीं। <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />तभईये, इंसानन को लौड़ा साबत के दिन को भी मालिक है।”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">फालिस मारे भै आदमी के हात कै अच्छो करनो</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्ती 12:9-14</ref>; <ref loc="LUK 6:6-11">लूका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ईसु फिर सभाघर मैं गौ<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्ती 4:23</ref>; <ref loc="MRK 1:21">मरकुस 1:21</ref></char></note>, और हुँआँ एक आदमी रहै, जोके हात मैं फालिस मार दई रहै, <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />और कुछ लोग ईसु ऊपर इल्जाम लगान के ताहीं बाके ऊपर घात लगाएकै बैठे रहैं, कि देखैं तौ, बौ साबत के दिन बाकै अच्छो करथै की नाय। <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ईसु फालिस मारे भै आदमी से कही, “बीच मैं ठाड़ जा।” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />फिर बौ लोगन से पूँछी, “हमरो नियम साबत के दिन का कहथै? अच्छो करन ताहीं, कि बुरो करन ताहीं? कोई की ज्यान बचान ताहीं या मारन ताहीं?” पर बे सब चुप रहे।<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />ईसु उनको कर्‌रो मन देखकै उदास हुईकै, उनकै गुस्सा से सब घाँईं देखी, और बौ आदमी से कही, “अपनो हाथ अग्गु कर।” बौ अग्गु करी, और बाको हाथ फिर से अच्छो हुई गौ। <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />तौ फरीसी सभाघर से दुआरे जाएकै तुरंतै राजा हेरोद के संग ईसु मसीह के खिलाप मैं सलाह मस्वरा करन लागे कि बाको कैसे करकै नास करैं।<verse eid="MRK 3:6" /></para>
  <para style="s">गलील झील के किनारे भीड़</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ईसु अपने चेलन के संग गलील झील घाँईं चले गौ: और एक बड़ा बड़ी भीड़ बाके पच्छू हुई लई; जो कि गलील, यहूदिया, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />यरूसलेम नगर, इदूमिया परदेस से, और यरदन नदिया के अगार की जघा से, और सूर और सैदा नगरन के आस-पास से आए रहैं। कि ईसु कैसे-कैसे अचम्मे काम करथै, जौ सुनकै बाके झोने आए रहैं। <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />और ईसु अपने चेलन से कही, “मेरे ताहीं एक छोटी नईंयाँ समारे रखाबौ” ताकी मोकै भीड़ चिबदाए नाय पाबै। <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />काहैकि बौ निरेन कै अच्छो करी रहै; तभईये जित्ते जनी बिमारी से दुखी रहैं, ईसु कै छून ताहीं मरे जात रहैं। <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />और प्रेत आत्मा, जब ईसु कै देखत रहैं, तौ बाके अग्गु गिर पड़त रहैं, और चिल्लाए कै कहेत रहैं की “तू परमेस्वर को लौड़ा है!”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />और ईसु प्रेत आत्मा कै आग्या दैकै कही, कि जौ बात को जिकर कोई से नाय करै।<verse eid="MRK 3:12" /></para>
  <para style="s">ईसु बारह प्रेरितन<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">उद्देस्य के संग ईसु के जरिये भेजे भै आदमी</char></note> कै चुनी</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्ती 10:1-4</ref>; <ref loc="LUK 6:12-16">लूका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />फिर ईसु पहाड़ मैं चढ़गौ, और जोकै बौ चहात रहै उनकै अपने झोने बुलाई; और बे बाके झोने आए।<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="MAT 5:1">मत्ती 5:1</ref></char></note> <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />तौ बौ बारह आदमिन कै छाँटी और उनकै प्रेरित नाओं दई। और उनसे कही “मैं तुमकै मेरे संग रहेन ताहीं चुनो हौं, मैं तुमकै प्रचार करन ताहीं पनारंगो, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />और प्रेत आत्मा कै निकारन को अधिकार तुमरे पास होगो।”<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />बे बारह छाँटे भै प्रेरितन के नाओं जे रहैं: सिमौन जोको नाओं बौ पतरस रखी,<note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="JHN 1:42">यूहन्ना 1:42</ref></char></note> <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />और जब्दी को लौड़ा याकूब और याकूब को भईय्या यूहन्ना, इन भईय्यन को नाओं बौ बुअनरगिस मतलब “गरजन को लौड़ा” रखी; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />और अन्द्रियास, और फिलिप्पुस, और बरतुल्मै, और मत्ती, और थोमा, और हलफई को लौड़ा याकूब, और तद्दै, और सिमौन कनानी<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">देसभक्त</char></note>, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />और यहूदा इस्करियोती, जो ईसु कै बाद मैं पकड़बाई रहै।<verse eid="MRK 3:19" /></para>
  <para style="s">ईसु और बालजबूल<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">भूतन के मुखिया से कहथैं</char></note></para>
  <para style="r">(<ref loc="MAT 12:22-32">मत्ती 12:22-32</ref>; <ref loc="LUK 11:14-23">लूका 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />तौ फिर ईसु घरै आओ: और हूँना पर ऐसी भीड़ जुरानी, कि ईसु और बाके चेला खानु तक नाय खाए पाईं।<note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="MRK 6:31">मरकुस 6:31</ref></char></note> <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />जब ईसु के घर बारे जौ बात सुनीं, तौ बे बाकै लेन कै चल दईं; काहैकि लोग-बाग कहेन डटे रहैं कि, बाकी अकल खराब हुई गई है।<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />थोड़ी यहूदि नियम के सिक्छक जो यरूसलेम से आए रहैं, ऐसे कहेत रहैं, “की बाके भीतर बालजबूल है,” और बहे अपने अधिकार से प्रेत आत्मा कै निकारन के ताहीं ईसु कै ताकत देथै।<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />और ईसु उनकै अपने झोने बुलाएकै उनसे कहानी<note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false">जौ कहानी असली जिंदगी से ना है, जोकै दृस्टान्त कहथैं</char></note> के जरिये कहेन लगो:<note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="MRK 4:2">मरकुस 4:2</ref></char></note> “सैतान कै सैतान कैसे निकार सकथै?” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />और अगर कोई राज्य मैं फूट पड़ जाबै, तौ बौ राज्य कैसे टिको रह सकथै? <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />और अगर कोई के घर मैं फूट पड़ जाबै, तौ बौ घर कैसे टिको रह सकथै? <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />और अगर सैतान अपनेई खिलाप हुईकै और अपनेई मैं फूट डारै, तौ बौ कैसे टिको रह सकथै? बाको तौ नामो निसान खतम हुई जातो।<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“पर कोई इंसान, कोई तगड़े आदमी के घर मैं घुसकै बाको माल जेबर नाय लूट सकथै, जबले की पहले बौ तगड़े आदमी कै भाँद ना लेबै; तौ जाएकै बाको घर लूट पागो।”<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“मैं तुमसे सच्ची कहथौं कि इंसानन की औलादन के सब पाप और बुराई जो बे करथैं, बे माफ करे जांगे, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />पर जो कोई पवित्र आत्मा के खिलाप बुराई करैगो, बौ अनंतकाल तक माफ न करो जागो<note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लूका 12:10</ref></char></note>: और बौ कहु ना खतम होन बारो पाप को कसूरवार मानो जागो।” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />ईसु जौ कही, काहैकि बे जौ कहेत रहैं, कि “ईसु मैं प्रेत आत्मा है।”<verse eid="MRK 3:30" /></para>
  <para style="s">ईसु की अईय्या और बाके भईय्या</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती 12:46-50</ref>; <ref loc="LUK 8:19-21">लूका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />तभईये ईसु की अईय्या और बाके भईय्या आए, और दुआरे ठाड़कै ईसु कै मस्कान ताहीं एक जनी कै पनारीं। <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />भीड़ बाके आसपास बैठी रहै, और बे बासे कहीं, “देख तेरी अईय्या और तेरे भईय्या-बहेनिया तोकै दुआरे ढूँड़ रै हैं।”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />ईसु उनकै जबाब दई, “मेरी अईय्या और मेरो भईय्या कौन है?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />और जो ईसु के आसपास बैठे रहै, उनके घाँईं देखकै बौ कही, “देखौ, मेरी अईय्या और मेरे भईय्या जे हैं। <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />परमेस्वर जो कहथै बहे बौ करैगो, बहे मेरो भईय्या, मेरी बहेनिया, और मेरी अईय्या है।”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">बीज बोन बारे की कहानी</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्ती 13:1-9</ref>; <ref loc="LUK 8:4-8">लूका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />ईसु फिरौंकी, गलील झील के डींड़े से उपदेस देन लगो: और हुँआँ पर इत्ती भीड़ लागी कि बौ झील मैं एक नईंयाँ के ऊपर चढ़कै बैठगौ, और पूरी भीड़ झील के डींड़े मैं ठाड़ी रइ।<note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="MRK 2:13">मरकुस 2:13</ref>; <ref loc="LUK 5:1-3">लूका 5:1-3</ref></char></note> <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />और ईसु उनकै कहानी के जरिये भौत सी बात सिखान लग्गौ,<note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="MRK 3:23">मरकुस 3:23</ref></char></note> और अपने उपदेस के जरिये उनसे कही,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“सुनौ! एक बीज बोन बारो बीज बोन ताहीं निकरो। <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />बीज बोत पोती थोड़ी रहा किनारे गिरो और चिरईंयाँ आयकै बाकै चुग लईं। <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />थोड़ी पथरिया बारी जमीन मैं गिरो जहाँ बाकै अगरी मट्टी नाय मिलपाई, और गहरी मट्टी नाय मिलन से बीज जल्दी जमेंआओ, <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />और जब दिन निकरो तौ भुर्स गौ, और जड़ न पकड़न से सूख गौ। <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />थोड़ी झाड़ी मैं गिरे, और झाड़ी बड़ी हुईकै बीज कै दबाय दई, और बे फल-फूल नाय पाईं। <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />पर कुछ बीज अच्छी जमीन मैं गिरे, और बे जमें और खूबै फल लाईं; कोई तीस गुना, कोई साठ गुना और कोई सौ गुना फल लाईं।”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />तौ ईसु कही, “जोके कान होमैं, बौ सुन लेबै!”<verse eid="MRK 4:9" /></para>
  <para style="s">कहानी को मतलब</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्ती 13:10-17</ref>; <ref loc="LUK 8:9-10">लूका 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />जब ईसु अकेलो रहगौ, तौ बाके बारह प्रेरित बासे बौ कहानी के बारे मैं पूँछीं। <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />ईसु उनसे कही, “तुमकै तौ परमेस्वर के राज्य<note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्ती 3:2</ref></char></note> के भेद की समझ दई गई है,” पर बाहर बारेन कै कहानी के जरिये समझाओ जाथै, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />तभईये तौ,</para>
  <para style="q1" vid="MRK 4:12">“उनकै सुजात तौ है</para>
  <para style="q2" vid="MRK 4:12">लेकिन उनकै सुजाई ना देथै;</para>
  <para style="q1" vid="MRK 4:12">बे सुनत तौ हैं,</para>
  <para style="q2" vid="MRK 4:12">लेकिन कछुए समक ना पाथैं।</para>
  <para style="q1" vid="MRK 4:12">ऐसो ना होबै, कि बे फिरैं</para>
  <para style="q2" vid="MRK 4:12">और माफी पाए जामैं।”<verse eid="MRK 4:12" /></para>
  <para style="s">ईसु बीज बोन बारी कहानी कै समझाथै</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्ती 13:18-23</ref>; <ref loc="LUK 8:11-15">लूका 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />फिर ईसु उनसे कही, “का तुम जौ कहानी<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">कहानी</char></note> नाय समझपाए? तौ फिर और सबै कहानिन कै कैसे समझैगे? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />बोन बारो परमेस्वर के बचन कै बोथै।<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="MRK 16:20">मरकुस 16:20</ref></char></note> <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />जो रहा किनारे के हैं जहाँ बचन बोओ जाथै, जे बे हैं कि जब बे बचन कै सुनीं, तौ सैतान तुरंत आयकै बचन कै जो उनमैं बोए गौ रहैं, उठाए लै जाथै। <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />बैसिये जो पथरिया बारी जघा मैं बोए जाथै, जे बे हैं जो बचन कै सुनकै तुरंत खुसी से अपनाय लेथैं। <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />पर अपने भीतर टिकाउ जड़ ना होन की बजह से बे थोड़िये दिन के होथैं; जाके बाद जब बचन के बजह से उनमैं दुख और कलेस होथै, तौ बे तुरंतै पच्छू ओहोर जाथैं। <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />जो झाड़ी मैं बोए गै, जे बे हैं जो बचन कै सुनीं, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />और युग भर की फिकर, और धन को धोका,<note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="MRK 10:23">मरकुस 10:23</ref>,<ref loc="MRK 10:34">34</ref></char></note> और चीजन को लालच उनमैं समाएकै बचन कै दबाय देथैं और बौ (फल नाय देन बारो) रह जाथै। <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />और जो अच्छी जमीन मैं बोए गै, बे जे हैं जो बचन सुनकै अपनाथैं और फल लाथैं: कोई तीस गुना, कोई साठ गुना और कोई सौ गुना।”<verse eid="MRK 4:20" /></para>
  <para style="s">छपरिया तरे दिया</para>
  <para style="r">(<ref loc="LUK 8:16-18">लूका 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />ईसु उनसे कही, “का दिया कै जहे ताहीं लाथैं कि छपरिया या खटिया के तरे रखो जाबै? का जौ ताहीं नाय कि डीट मैं रखो जाबै? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />ऐसो कछु नाय है, जो लुको है और खुलो न जाबैगो और ना कछु लुको है, जो उजियारे मैं ना लाओ जागो। <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />अगर कोई के सुनन ताहीं कान होमैं, तौ बौ सुन लेबै।”<note caller="+" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 11:15">मत्ती 11:15</ref></char></note><verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />फिर बौ उनसे कही, “ध्यान से सुनौ! जो नपना से तुम नापथौ बहे से तुम्हऊँ कै नापो जागो, और तुमकै अगरो दौ जागो। <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />जोके झोने है, बाकै और दौ जागो; और जोके झोने नाय है, बासे बहो जो बाके झोने है, लै लौ जागो।”<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती 13:12</ref></char></note><verse eid="MRK 4:25" /></para>
  <para style="s">जमन बारे बीज की कहानी</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />फिर ईसु कही, “परमेस्वर को राज्य बौ आदमी के हानी है, जो जमीन मैं बीजन कै छिटक दई, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />और रात मैं जाएकै सोए गौ, सुबेरे बौ उठकै देखी कि बीज जमकै निकर रौ है, कैसे निकर रौ है, जौ बौ खुद नाय जानथै। <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />जमीन अपने आप जमाथै, सबसे पहले नकुवा, फिर बाली, और बाके बाद बालिन मैं दाने। <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />और जब दाने पक जाथैं, बौ बिना देरी करे दरांती से काट लेथै, काहैकि बाकी फसल तैयार है।”<note caller="+" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">योएल 3:13</ref>; <ref loc="REV 14:15">प्रकासितवाक्य 14:15</ref></char></note><verse eid="MRK 4:29" /></para>
  <para style="s">राया के गूदा की कहानी</para>
  <para style="r">(<ref loc="MAT 13:31-32">मत्ती 13:31-32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">लूका 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />फिर बौ कही, “परमेस्वर के राज्य की बराबरी कौन से करी जाए सकथै?” और कौनसी कहानी के जरिये जाकी बात बताई जाए सकथै? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />“बौ राया के गूदा के हानी है: जब जमीन मैं बोओ जाथै तौ जमीन के सबै गूदन से छोटो होथै, <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />लेकिन जब बोओ गौ, तौ जमकै बौ सब सागपातन से बड़ो हुई जाथै, और बाकी ऐसी बड़ी हँगईय्या निकरथैं कि आसमान की चिरईंयाँ बाकी छाँईं मैं घोसला बनाएकै रह सकथैं।”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ईसु निरेन कै कहानी बताए-बताए कै उनकै बचन सुनाए करत रहै,<note caller="+" style="x"><char style="xo" closed="false">4:33 </char><char style="xt" closed="false"><ref loc="JHN 16:12">यूहन्ना 16:12</ref></char></note> ताकी बे समझ पामैं। <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />और बिना कहानी के, बौ उनसे कछुए नाय कहेत रहै;<note caller="+" style="x"><char style="xo" closed="false">4:34 </char><char style="xt" closed="false"><ref loc="JHN 16:25">यूहन्ना 16:25</ref></char></note> पर बौ अलग्याँओं मैं अपने खुद के चेलन कै सब बातन को मतलब समझात रहै।<verse eid="MRK 4:34" /></para>
  <para style="s">ईसु आँधी कै सांत करी</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्ती 8:23-27</ref>; <ref loc="LUK 8:22-25">लूका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />बहे दिन जब संजा भइ, तौ बौ चेलन से कही, “आबौ, आपन झील के बौ पाँजर चलैं।” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />और बे भीड़ कै छोड़कै, ईसु कै नईंयाँ मैं संग लै चल दईं;<note caller="+" style="x"><char style="xo" closed="false">4:36 </char><char style="xt" closed="false"><ref loc="MRK 3:9">मरकुस 3:9</ref>; <ref loc="MRK 5:2">5:2</ref>,<ref loc="MRK 5:21">21</ref></char></note> और बाके संग औरौ नईंयाँ रहैं। <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />तौ अनकाचीति एक बड़ी आँधी आई, और लहरैं नईंयाँ मैं ऐसी टक्कर खामैं, कि पानी से नईंयाँ भरी जाबै। <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />पर ईसु नईंयाँ के पच्छू के सिरा मैं तकिया लगाएकै सोत रहै। तौ ईसु के चेला जाएकै कहीं, “गुरुजी, का तोकै फिकर नाय है कि हम डूबे जाए रै हैं?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />तौ फिर ईसु उठकै आँधी कै आग्या दई, और पानी से कही, “सांत हुई जा, रुक जा!” और आँधी रुक गई और सब घाँईं सांति छाए गई। <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />और बौ अपने चेलन से कही, “तुम काहे डराथौ? का तुमकै हबै तक बिस्वास नाय है?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />बे गजबै डराय गै और आपस मैं बतकाईं, “जौ कौन है कि आँधी और पानी की लहरैं जाकी बात मानथैं?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">प्रेत आत्मा पकड़े भै आदमी कै अच्छो करनो</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्ती 8:28-34</ref>; <ref loc="LUK 8:26-39">लूका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ईसु और बाके चेला गलील झील के पच्छू गिरासेनियों नाओं के देस मैं गै, <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />जब ईसु नईंयाँ मैं से उतरो तौ तुरंतै एक आदमी जोके अंदर प्रेत आत्मा रहै, कबर मैं से निकरो और ईसु से मिलो। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />बौ मरघटान मैं रहत रहै और बाकै साँकर से कोईये नाय भाँद पात रहै, <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />काहैकि बाकै निरे बार जंजीर और बेड़ियन से भाँदो गौ रहै, तहुँओं बौ साँकर और बेड़ियन कै कछुए नाय समझत रहै सब तोड़-ताड़ कै टुकड़ा-टुकड़ा कर देत रहै, और कोई के पास बाकै बस मैं करन ताहीं सक्ति नाय रहै। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />बौ दिन-रात कबर और पहाड़न मैं चिल्लात फिरत रहै, और अपने आपकै पथरन से चोट पहोंचात रहै।<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />बौ ईसु कै दूरै से देखकै दौड़ो, बाकै घुपटियाय कै नमस्ते करी, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />और खूब जोड़न से चिल्लाए कै कही, “ईसु, परमप्रधान परमेस्वर को लौड़ा, तोकै मोसे का काम? मैं तोकै परमेस्वर के नाओं से नहोरे करथौं कि मोकै सजा मत देबै।” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />काहैकि ईसु कही रहै, “प्रेत आत्मा, जौ आदमी मैं से निकर जा!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ईसु बासे पूँछी, “तेरो नाओं का है?” आदमी जबाब दई, “मेरो नाओं पलटन<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">सेना</char></note> है; काहैकि हम निरे हैं।” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />और बौ ईसु से बड़ा नहोरे करी, “हमकै जौ देस से जान मत कहबै।”<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />उतै पहाड़ मैं सोरन को बड़ा भारी झुंड चुगत रहै। <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />प्रेत आत्मा ईसु से नहोरे करकै कहीं, “हमकै सोरन के भीतर भेज दे।” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ईसु प्रेत आत्मा से कही और प्रेत आत्मा निकरकै सोरन के अंदर समाए गै और झुंड, जो करीब दुई हजार रहैं, ढाव से झिपटाए कै झील मैं जाए गिरे और डूबकै मर गै।<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />उनके बरदिया भाजत-भाजत नगर और गाँवन मैं सब किस्सा कह सुनाई, और जो भौ रहै, सब जनी देखन आए। <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />बे ईसु के झोने आयकै जोके भीतर प्रेत आत्मा की पलटन रहैं बाकै लत्ता पहने और सांत बैठे देखकै डराय गै। <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />जोकै प्रेत आत्मा पकड़ी रहैं और सोरन के संग जो कछु भौ रहै देखन बारे जौ सब देखकै हुँआँ के आदमिन कै सब कछु कह सुनाईं।<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />तौ बे सब जनी ईसु से नहोरे करकै कहीं की तैं हमरी हद से चलो जा।<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />जब बौ नईंयाँ मैं चढ़न लगो तौ जोके अंदर प्रेत आत्मा रहैं, ईसु से नहोरे करन लागो, “मोकै अपने झोने रहेन दे।”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />पर ईसु बाकै मना करी, और बासे कही, “अपने घरै जा और सब जनिन कै बता। कि तेरे ऊपर दया करकै प्रभु कितनो बड़ो काम करी है।”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />बौ जाएकै दिकापुलिस मैं जौ प्रचार कै फैलान लागो कि ईसु मेरे ताहीं कित्ते बड़े काम करी है; और सबै सुनकै अचम्मो करीं।<verse eid="MRK 5:20" /></para>
  <para style="s">याईर की लौड़िया और एक रोगी बईय्यर जो ईसु के लत्ता के कुंछ कै छुइ</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्ती 9:18-26</ref>; <ref loc="LUK 8:40-56">लूका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />जब ईसु नईंयाँ से झील के बौ पाँजर गौ, तौ झील के किनारे एक भारी भीड़ बाके झोने जुराए गई। <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />याईर नाओं को आदमी जो सभाघर को मुखिया मैं से एक रहै आओ, और बाकै देखकै बाके पाँव मैं गिर गौ, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />और जौ कहकै बासे नहोरे करी, “मेरी छोटी लौड़िया मरन पड़ी है; तैं आयकै बाके ऊपर हात रख कि बौ अच्छी हुईकै जिंदी रहाबै।”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />तौ, बौ बाके संग जान लगो और पूरी भीड़ बाके पच्छू हुई गई; हिंयाँ तक कि लोग बाके ऊपर गिरागिर करैं।<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />एक बईय्यर रहै, जोकै बारह साल से खून बहेन की बिमारी रहै। <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />बौ निरे बैधिन कै दिखाए डारी रहै, और अपनो सबै रुपईया-पैसा उठाए डारी रहै तहुँओं कछु आराम नाय मिलो, लेकिन औरौ जाधे बिमार हुई गई रहै। <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />बौ ईसु के बारे मैं सुनी रहै जहे बजह से भीड़ कै हटात भइ पच्छू से आयकै बाके लत्ता कै छुइ, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />काहैकि बौ अपने आपकै कहेत रहै, “अगर मैं बाके लत्ता कै छुइ लेंगो, तौ अच्छी ही जांगो।”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />और तुरंतै बाको खून बहनो बंद ही गौ, और बौ अपनी सरीर मैं महसूस कर लई की मैं बौ बिमारी से ठीक ही गौ हौं। <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />तुरंतै ईसु के भीतर से सामर्थ्य निकरी, तौ बाकै पता लग्गौ कि, कोई तौ मोकै छुओ है। और पच्छू घूमकै भीड़ से पूँछी, “मेरो लत्ता कौन छुओ है?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />बाके चेला जबाब दईं, “तैं तौ देखिये रौ है कि तेरे ऊपर भीड़ गिरी जाए रइ है, तहुँओं तू कहथै कि मोकै कौन छुओ?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />पर मेरे लत्ता कौन छुओ देखन ताहीं सब घाँईं देखन लगो। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />बौ बईय्यर सोची मेरे संग अच्छोई भौ है, तौ डरात और थरथरात भइ आई, और बाके गोड़े मैं गिरकै सब कछु उनकै सच-सच कह सुनाई। <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ईसु बासे कही, “मेरी लौड़िया, तेरो बिस्वास तोकै अच्छो करी है: सांति से जा, और जौ बिमारी से बची रहिये।”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />ईसु जौ कहतै रहै तभईये सभाघर को मुखिया के घर से कोई आदमी आयकै कही, “तेरी लौड़िया तौ मर गई, अब गुरुजी कै काहे दुख दे रौ है?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />जो बात बे कहेत रहैं, बौ बात कै ईसु ना सुनी, सभाघर के मुखिया से कही, “मत डराबै; सिरफ बिस्वास कर।” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />और बौ पतरस और याकूब और याकूब को भईय्या यूहन्ना कै छोड़, और कोईयन कै अपने संग नाय आन दई। <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />जब बौ मुखिया के घरै पहोंचो तौ हूँना बैठे भैन कै रोबा पिटाउ करत देखी। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />तौ बौ भीतर जाएकै उनसे कही, “तुम काहेकै रोत और हुल्ल गदड़ मचाथौ? लौड़िया तौ मरिये नाय है, बौ सोए रइ है।”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />लेकिन हूँना पर जो आदमी रहैं बाके ऊपर हसन लागे, तभईये बौ सबन कै दुआरे भजाए दई सिरफ लौड़िया के अईय्या-दऊवा और अपने तीन चेलन संग घर के भीतर जितै लौड़िया लेटी रहै, झोने गै। <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />और लौड़िया को हात पकड़कै कही, “तलीता कूमी!” जोको मतलब है, “ओ छोटी लौड़िया, मैं तोसे कहथौ, उठ!”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />और लौड़िया उठकै नेंगन लगी; बौ बारह साल की रहै। जौ देखकै सबै चौहोंक गै। <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />फिर बौ उनकै चहाचीतो करकै कही कि जौ बात कोईये कै नाय पता चलै और कही, “जाकै कछु-कछा खान कै दियौ।”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरत गाओं मैं ईसु कै ठुकरानो</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती 13:53-58</ref>; <ref loc="LUK 4:16-30">लूका 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />फिरौंकी ईसु बौ जघा कै छोड़कै अपने सहर कै चल पड़ो, बाके चेलौ बाके संग रहैं। <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />साबत के दिन सभाघर मैं उपदेस देन लगो, और भौत से आदमी सुनकै चोहोंक गै और कहेन लगे, “जाकै इत्ती बढ़िया-बढ़िया बात कितै से आए गईं?” जाकै इतनी अकल कहाँ से आए गई? जौ इतने सामर्थ्य के काम कैसे करकै करो? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />का जौ बहे बढ़ईया ना है, जो मरियम को लौड़ा, और याकूब, योसेस, यहूदा और सिमौन को भईय्या है? का बाकी बहेनिया आपनैं संग गाओं मैं नाय रहथैं? बे ईसु कै अपनाईये ना पामैं।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />फिर ईसु उनसे कही, “भविस्यवक्ता कै अपने घर, गाओं-सहर, और अपने हितुआ, और कुरमन कै छोड़कै और कहुए अनादर ना होथै।”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />ईसु हुँआँ जाधे सामर्थ्य के काम करिये ना पाई, कतई जराएक आदमिन के ऊपर हात रखकै बिमारिन से अच्छो कर पाई। <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />बौ उनको कतईये बिस्वास नाय देखकै बड़ा अचम्मो भौ। फिर बौ गाओं-गाओं मैं सिक्छा देत भै घूमन लगो।<verse eid="MRK 6:6" /></para>
  <para style="s">ईसु अपने बारह चेलन कै भेजथै</para>
  <para style="r">(<ref loc="MAT 10:5-15">मत्ती 10:5-15</ref>; <ref loc="LUK 9:1-6">लूका 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />ईसु अपने बारह चेलन कै अपने झोने बुलाई और दुई-दुई करकै भेजन लगो; बौ उनकै प्रेत आत्मा के ऊपर अधिकार दई, <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />और एक भौत जरूरी बात समझाई, “तुम अपने संग एक लठिया के अलावा कछु मत लियो। ना तौ रोटी लियो, ना झोला, ना गोझा मैं रुपईया-पैसा। <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />तुम चप्पल तौ पहेनियो पर दुई जोड़ी कुरता मत लियो।” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />और बौ उनसे कही, “चाँहे जोसे घर मैं तुम रहबौ, हूँना से ना जान तक हूँनै रहियो। <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />जो गाँव के आदमी तुमकै ना अपनामैं और तुमरी एकौ ना सुनैं, तौ तुम हुँआँ से नेंगतै खिना अपनी टाँग के तरबन से धूदर झार दियो, बौ उनके ताहीं चितौनी होगी।”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />फिर बे हूँना से चले गै। और बे पापन से मन बदलन ताहीं प्रचार करन लगे। <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />बे भौत आदमिन कै प्रेत आत्मा से छुड़ाईं और भौतन कै जो रोगी रहैं उन्हैं जैतून को तेल लगाएकै अभिसेक करकै अच्छो करी।<verse eid="MRK 6:13" /></para>
  <para style="s">बपतिस्मा देनबारे यूहन्ना की मौत</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्ती 14:1-12</ref>; <ref loc="LUK 9:7-9">लूका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />राजा हेरोद जब ईसु के बारे मैं सुनी; बौ समय ईसु को नाओं भौत फैल गौ रहै। कुछ जनी कहेत रहैं “बपतिस्मा देन बारो यूहन्ना मरे भैन मैं से जिंदो ही गौ है, तभईये बौ जे सामर्थ्य के काम करथै।”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />दुसरे आदमी कहेत रहैं, “कि बौ एलिय्याह भविस्यवक्ता है।” थोड़ी आदमी और कहमैं, कि ना! “जौ पुराने जमाने को कोई भविस्यवक्ता है।”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />इन सबन की बात जब राजा हेरोद सुनी, तौ बौ कही, “बपतिस्मा देन बारो यूहन्ना, जो की गरदन मैं कटबाओ रहौं, बहे जिंदो हुई गौ है!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />काहैकि हेरोद खुदै यूहन्ना कै बंधी बनान और कैदखाना मैं डारन ताहीं हुकम दई रहै। बौ अपने भईय्या फिलिप्पुस की बईय्यर जोको नाओं हेरोदियास रहै बहे की बजह से, बाकै आदमिन से पकड़बाई और कैदखाना मैं डरबाए दई रहै; हेरोद हेरोदियास कै बिहाए लई रहै। <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />काहैकि यूहन्ना हेरोद से कही रहै, “अपने भईय्या की बईय्यर तैं बिहाए तौ लौ है पर ठीक ना है।”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />तहीं के मारे हेरोदियास की बईय्यर यूहन्ना कै अच्छो ना मानत रहै और बौ जहे चहात रहै कि बौ बाकै मार डारै; पर राजा हेरोद के बजह से कहुए ना भौ, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />काहैकि हेरोद राजा यूहन्ना कै धर्मी और पवित्र आदमी मानकै बासे डरात रहै, बौ मर ना जाबै बाकै बचात रहेत रहै, और यूहन्ना की बात सुनकै गजबै परेसान रहै, लेकिन खुस हुईकै सुनतौ रहै।<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />एक दिन आओ जब हेरोद को जनम दिन रहै; बौ दिन ऊँचे और बड़े-बड़े अधिकारिन, सेनापतिन और गलील नगर के खास लोगन कै न्युतो दैकै खान-पीन को इंतजाम करी। <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />बौ जनम दिन के मौका मैं हेरोदियास की बईय्यर की लौड़िया हूँना जाएकै नाची और हूँना बैठे भै लोगन कै खुस कर दई। तौ राजा हेरोद बौ लौड़िया से कही, “तैं जो कछु आज मोसे माँगैगी मैं तोकै देंगो।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />और बाकै कसम दैकै कही, “तैं मोसे जो कछु भी माँगैगी तौ मैं तोकै दै दुंगो, हिंयाँ तक कि मैं तोकै आधो राज्य पाट दै दुंगो।”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />बौ रइ सो दुआरे गई और अपनी अईय्या हेरोदियास से पूँछी, “मैं का माँगौं?” बौ कही, “बपतिस्मा देनबारे यूहन्ना की मुड़िया।”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />बौ तुरंतै राजा झोने बापस आई और बासे नहोरे करी, “मैं चाहथौं कि तैं कतई अभईये यूहन्ना बपतिस्मा देनबारे की मुड़िया कटवाए कै एक थरिया मैं मंगवाए दे।”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />जौ सुनकै राजा को मोहों पुस्केयाए गौ, लेकिन अपना जो कसम हितुअन के अग्गु दई रहै बाकी बजह से मना ना कर पाई। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />राजा तुरंतै एक जल्लाद से कही कैदखाना मैं जा और यूहन्ना की मुड़िया काटकै लैयाबौ। <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />बौ ताराबास मैं जाएकै बाको मूड़ काटी, और एक थरिया मैं धर लाई और लौड़िया कै दई, और लौड़िया रइ सो अईय्या कै दै दई। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />जो भौ रहै सुनकै यूहन्ना के चेला आए, और यूहन्ना के सरीर कै लै जाएकै कबर मैं दफनाए दईं।<verse eid="MRK 6:29" /></para>
  <para style="s">ईसु हजारन कै खानु खबाई</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="LUK 9:10-17">लूका 9:10-17</ref>; <ref loc="JHN 6:1-14">यूहन्ना 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />प्रेरित लोग ईसु के झोने जुराए गै, जो कछु बे करीं और लोगन कै सिखाईं, सब कछु ईसु कै बताईं। <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />ईसु उनसे कही, “आबौ आपन एक अलग्याँओं जघा मैं जाएकै थोड़ी देर सैंताए लेमैं।” काहैकि हुँआँ भौत आदमी आन जान लग गै रहै, और उनकै तौ खानौ की संकता ना रहै। <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />तभई के मारे बे नईंयाँ से, अलग्याँओं सुनसान जघा मैं चले गै।<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />बहे समय निरे जनी उनकै जात देख डारीं और जानगै कि जे बेईं हैं, और सब नगरन से जुराए कै नेंगतै-नेंगत ईसु और बाके चेलन से पहलिये पौहौंच गै। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />ईसु नईंयाँ मैं से उतरिये पाई रहै कि बड़ा जोड़ भीड़ देखी, और बाकै भीड़ ऊपर बड़ा तरस आओ, काहैकि बे उन भेंड़न हानी रहैं, जिनकी देखाभारी करन बारो कोईये ना रहै: फिर बौ उनकै निरी बात सिखान लगो। <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />जब दिन जराएक बचो, तौ बाके चेला बासे कहेन लगे, “जौ बड़ा सूनी जघा है, और दिनौ जराएक बचो है। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />उनकै पनार दे कि बे इतै-उतै गाँव और बस्तियन मैं जाएकै कछु-कछा मोल लैकै खाएलेमैं।”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />ईसु उनकै जबाब दई, “तुम्हईं उनकै खान कै देबौ।” बे ईसु से कहीं, “का हम दुई सौ चाँदी के सिक्का कि रोटी मोल लैकै खान कै देमैं?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ईसु उनसे कही, “जाएकै देखौ तौ, तुमरे झोने कितका रोटी हैं?” फिरौंकी पूँछ-पाँछ कै बे कहीं “पाँचै रोटी और दुईये मच्छी हैं।”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />फिर ईसु चेलन से कही, “जौ हरी-हरी घाँस मैं सबन कै लैनबार से बैठार देबौ।” <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />तभईये बे सौ-सौ, पचास-पचास करकै लैनबार से बैठत गै। <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />बौ पाँच रोटी और दुई मच्छी कै लैकै, ऊपर स्वर्ग के घाँईं देखी और धन्यवाद करी, और रोटियन कै तोड़कै चेलन कै देत गौ, ताकी बे सब जनिन ताहीं परसा परसैं, और बे दुई मच्छी सबन कै बाँट दईं। <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />सब जनी खूबै छक कै खाए लईं। <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />और फिर बाके चेला मच्छी और रोटी की बहारै छपरिया बची भईं उठाईं। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />जित्ते जनी खाईं, उनमैं खाली लोगै-लोग पाँच हजार रहैं।<verse eid="MRK 6:44" /></para>
  <para style="s">ईसु पानी ऊपर नेंगी</para>
  <para style="r">(<ref loc="MAT 14:22-23">मत्ती 14:22-23</ref>; <ref loc="JHN 6:15-21">यूहन्ना 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />फिर ईसु चेलन से कही जल्दी-जल्दी नईंयाँ से तुम झील के बौ पाँजर बैतसैदा गाँव चले जाबौ, तौले मैं भीड़ पनार लेमौं। <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />उनकै पनारकै ईसु पहाड़ मैं प्रार्थना करन चले गौ। <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />जब संजा खिन ही गई तौ नईंयाँ झील के बीच-बाच रहै, खाली ईसु इकल्लो डींड़े मैं रहै। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />जब बौ देखी कि चेला पतवार चलात-चलात थक गै हैं, काहैकि ब्यार उल्टा उन्हईं घाँईं चलै, तौ तीन से छ: बजे के करीब मैं भुकभुको होन से पहले बौ पानी के ऊपर नेंगत भै चेलन के झोने आओ; और बौ चेलन से अग्गु जान ताहीं करै, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />लेकिन बे बाकै पानी ऊपर नेंगत देखकै डराय गै और चिल्लाए पड़े, उनकै लगो की भूत है।<verse eid="MRK 6:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 6:50" />बे सबै ईसु कै देखकै डराय गै रहैं, लेकिन ईसु जल्दी से उनसे बात करन लगो और कही, “हिम्मत भाँदौ: मैं हौं; डराबौ मति!” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />फिर ईसु उनके झोने नईंयाँ मैं आए गौ, और ब्यारौ रुक गई: और बे बड़ा अचम्मो करैं। <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />बे कुछ समय पहले की पाँच हजार लोगन कै रोटी खबान की बात ना समझ पाईं रहैं, काहैकि उनके मन कर्‌रे ही गै रहैं।<verse eid="MRK 6:52" /></para>
  <para style="s">गन्नेसरत परदेस मैं बिमारन कै अच्छो करनो</para>
  <para style="r">(<ref loc="MAT 14:34-36">मत्ती 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ईसु झील के बौ पाँजर जाएकै गन्नेसरत परदेस समुंदर के डींड़े मैं पुगे, और नईंयाँ कै डींड़े मैं करीं और भाँद दईं। <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />और जब बे नईंयाँ मैं से उतरे, तौ आदमी तुरंतै उनकै जानगै, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />बौ परदेस के सब घाँईं जाए-जाएकै, बे जितने बिमार रहैं; उनकै खटिया मैं लिटाए कै, जितै-जितै ईसु मसीह की खबर मिलै बे उतई-उतई लै-लै फिरैं। <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />और जितै कहूँ बौ गाँव, नगरन और बस्तियन मैं जात रहैं, तौ आदमी बिमारन कै बजारौ मैं लै चले जात रहैं और बासे नहोरे करकै कहेत रहैं कि तैं अपने लत्ता के कुंछ कै छून दे: जित्ते बाकै छूत रहैं, सबै अच्छे ही जात रहैं।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">बड़े-बूढ़ेन की सिक्छा</para>
  <para style="r">(<ref loc="MAT 15:1-9">मत्ती 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />तौ फरीसी और एक काद यहूदि नियम के सिक्छक जो यरूसलेम नगर से आए रहैं, ईसु झोने जुराए गै, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />और बे बाके कुछ चेलन कै रीत के हिसाब से छिया-पछारे हातन से खानु खात भइ देखीं, बे फरीसियन के कहेन के हिसाब से खान से अग्गु हात नाय धोईं रहैं।<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />काहैकि बे फरीसी और यहूदि जाति के लोग रहैं, बे अपने पुरखन की रीत रबईय्या मानकै ही चलत रहैं, बे जबले खूबै अच्छे से हात नाय धोए लेते तौले खानु ना खात रहैं। <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />बजार-घाट से आए कै, बिना हंदाए धोए तौ खानु खातै ना रहैं; औरौ दुसरी परम्परा माने करत रहैं, जैसे कटोरा, लोटा, फूल के बर्तन और खटिया कै माँजनो-धोनो।<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />तभई के मारे फरीसी और यहूदि नियम के सिक्छक ईसु से पूँछी, “तेरे चेला काहेकै पुरखन की रीत रबईय्या कै ना मानथैं, और रीत के हिसाब से छिया-पछारे हातन से खाए लेथैं?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />इतका कहतै खिना ईसु बोल उठो, “यसायाह भविस्यवक्ता जो रहै बौ तुम कपटियन ताहीं कतईये ठीकै-ठीक भविस्यवाँड़ी करी है” जैसे कि लिखो पड़ो है:</para>
  <para style="q1" vid="MRK 7:6">“जे आदमी, मोहों से तौ मेरो आदर करथैं,</para>
  <para style="q2" vid="MRK 7:6">लेकिन उनको मन तौ मोसे लगोई ना है।<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />उनकै मेरी उपासना करकै कोई फायदा ना है,</para>
  <para style="q2" vid="MRK 7:7">कैसे बे इंसानन की बनाई भइ बातन कै</para>
  <para style="q2" vid="MRK 7:7">परमेस्वर को नियम करकै सिखाथैं!”<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“काहैकि तुम तौ परमेस्वर के आग्या कै टालमटोल करकै इंसानन की रीत-रबईय्यन कै मानत रहथौ।”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />बौ दोहराए कै उनसे कही, “तुम तौ अपनी रीत मानन ताहीं परमेस्वर के आग्या कै एक घड़ी मैं टाल देथौ! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />जौ बात मूसा नाओं को भविस्यवक्ता हुकम दै रखाई है, ‘अपने अईय्या-दऊवा को आदर करिये,’ और ‘जो कोई अपनी अईय्या-दऊवा कै भलो-बुरो कहबै, बौ सच्ची मैं मरिये जाबै।’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />लेकिन तुम तौ कहथौ कि अगर कोई इंसान अपने अईय्या-दऊवा से कहबै कि तोकै मोसे जो मदत<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">मूल भासा मैं कुर्बान</char></note> होने रहै, बौ तौ दान है, मतलब जौ परमेस्वर को है। <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />तौ-तौ बे उनके अईय्या-दऊवा की सेवा साति करन ताहीं कतईये मनै कर देथैं। <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />जहे की बजह से तुम अपनेई रीत-रबईय्या से परमेस्वर की बात कै टाल देथौ। और ऐसियै तुम भौत कछु करथौ।”<verse eid="MRK 7:13" /></para>
  <para style="s">इंसानन कै असुद्ध करन बारी बातैं</para>
  <para style="r">(<ref loc="MAT 15:10-20">मत्ती 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />तौ ईसु सबन कै अपने झोने बुलाएकै कही, “तुम सब जनी मेरी सुनौ और समझौ। <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ऐसी कोई चीज हईये नाय जो इंसानन कै बाहर से भीतर जाएकै गंदो करै, बल्किन जो चीज इंसानन के भीतर से निकरथै, बहे बाकै गंदो करथै।” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />जो-जोके सुनन के कान हैं बौ सुन लियै।<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">एकाद हस्तलेखन मैं जौ पद नाय है।</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />जब बौ भीड़ छोड़कै घरै गौ, तौ बाके चेला बौ कहानी के बारे मैं पूँछन लगे। <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />तौ बौ उनसे कहेन लगो कि “तुम्हऊँ ना समझपाए का? का तुम ना जानथौ? कि जो चीज इंसान के भीतर जाथै, बासे बौ असुद्ध ना होथै। <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />काहैकि बौ तौ पेट मैं जाएकै सरीर से मल के जरिये निकर जाथै बौ मन मैं थोड़ी ना रहथै जौ सब कछु कहकै बौ सब खानबारी चीजन कै साफ बताई।”<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />फिर बौ कहेन लगो, “जो कछु इंसानन के भीतर से निकरथै, बहे से बौ गंदो, होथै। <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />काहैकि इंसानन के भीतर सेई मन मैं बुरी-बुरी सोच, छिनरइपना, चोरी करनो, मार डारनो, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />व्यभिचार, लालच, सबै तरहन के बुरे काम, छल-कपट, असलीलता, चिड़नो, बदनामी करनो, गुमान करनो, और मूर्खता की बात निकारनो। <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />जे बातैं मन के भीतर सेई निकरथैं और इंसानन कै असुद्ध करथैं।”<verse eid="MRK 7:23" /></para>
  <para style="s">बईय्यर को बिस्वास</para>
  <para style="r">(<ref loc="MAT 15:21-28">मत्ती 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />फिरौंकी ईसु उतै से सूर नाओं के देस मैं आओ; और एक घर मैं चले गौ, पर बौ ना चहात रहै कि कोई बाकै देखै; लेकिन बौ अपने आपकै लुकाईये ना पाई। <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />और तभई एक बईय्यर आई, जोकी छोटी लौड़िया के अंदर प्रेत आत्मा रहै, बौ ईसु के बारे मैं सुनकै बाके झोने आई, और पाँव लागी। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />बौ यूनानी और सुरुफिनीकी<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="ft" closed="false">गैर यहूदि</char></note> जाति की बईय्यर रहै। बौ बासे नहोरे करी कि मेरी लौड़िया के अंदर से प्रेत आत्मा निकार दे। <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />ईसु बौ बईय्यर से कही, “पहले बालकन कै तौ खाए लेन दे, काहैकि उनको परसो भौ परसा उनसे छीन कै कुत्तन कै देनो ठीक ना समझथौं।”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />पर बईय्यर कही, “सच्चियै बात है प्रभु, तहुँओं कुत्तौ तौ बालकन के नीचे को पड़ो-पड़ाव रोटी को करकूना खाईये लेथैं!”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ईसु बासे कही, “तैं अब जौ कहोई है तौ चली जा प्रेत आत्मा तेरी लौड़िया के अंदर से निकर गई है।”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />जब बौ घरै आयकै देखी तौ लौड़िया खटिया मैं लेटी है, और प्रेत आत्मा निकर गई।<verse eid="MRK 7:30" /></para>
  <para style="s">ईसु गूँगा-बैहरा आदमी कै अच्छो करी</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />फिरौंकी बौ सूर के देस से निकरकै सैदा से हुईकै दिकापुलिस से होत भौ गलील की झील झोने पुगो। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />और फिर निरे आदमी एक बैहरा कै लाईं जो गूँगौ रहै, ईसु के झोने लायकै बासे नहोरे करीं कि बौ अपनो हात बाके ऊपर रखै। <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />तौ ईसु बाकै भीड़ से अलग्याँओं लैगौ, और अपनी उँगरिया बाके कान मैं डारकै थूकी, और बाकी जीभ कै छुइ; <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />और स्वर्ग घाँईं देखकै आँह भरी, और बासे कही, “एफ्फाथा!” मतलब “खुल जा।”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />और बाके कान खुल गै, और बाकी जीभ की गाँठियौ खुल गई, और बौ सपा-सपा बोलन लगो। <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />तौ ईसु लोगन कै उपदेस दई और कही कतई कोई से मत कहियो; जो हिसाब से बौ बाकै हुकम दई रहै, बौ औरौ हुलगदड़ मचाई। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />हुँआँ के आदमी बड़ा अचम्मो करकै कहेन लगे, “बौ जो कछु करी है अच्छोई करी है; बौ बहरन कै जो पहले सुन ना पात रहैं सुनन लगे, और गूँगा जो बोल ना पात रहैं बोलन लगे।”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">ईसु चार हजार आदमिन कै खानु खबाई</para>
  <para style="r">(<ref loc="MAT 15:31-39">मत्ती 15:31-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />बे दिनन फिर से एक मौका आओ तौ बड़ा जोड़ भीड़ जुराए गई, और उनके झोने खान कै कछुए नाय रहै, तौ ईसु अपने चेलन कै झोने बुलाएकै कही, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“मोए जौ भीड़ के ऊपर बड़ा तरस आए रहो है, काहैकि निठाठौर जे तीन दिन से मेरे संगै हैं, और उनके झोने खानौ ताहीं कछु नाय है। <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />बौ कही मैं इन्हैं भूंको भेज दौ तौ, जे थक हार कै अधरस्ता मैं रह जांगे, और एक-काद तौ दूरौ के हैं।”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />बाके चेला बासे कहीं, “हिंयाँ बन मैं ढेर रोटी कोई कितै से लागो कि जे छक सकथैं?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ईसु उनसे पूँछी, “तुमरे झोने कितका रोटी हैं?” बे कहीं “सात।”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />फिर बौ सबन से कही, कि जमीन मैं बैठ जाबौ, और सात रोटी लैकै धन्यवाद दैकै तोड़ी, और अपने चेलन कै देत जाबै कि उनके अग्गु रखै, फिर चेला सबन अग्गु परस दईं। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />उनके झोने जराएक छोटी मच्छियौ रहैं: बौ धन्यवाद दैकै उन्हऊँ कै बाँटन कही। <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />बे भर पेट खाए लईं और चेला बचे कुचे टुकड़ा के सात बितौला भरे भै उठाईं। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />और हूँना चार हजार के लमसम आदमी रहैं। फिर बौ उनकै पनार दई, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />और बौ तुरंतै अपने चेलन संग नईंयाँ से दलमनूथा जिला मैं चलो गौ।<verse eid="MRK 8:10" /></para>
  <para style="s">फरीसियन को चमत्कार को निसान माँगनों</para>
  <para style="r">(<ref loc="MAT 16:1-4">मत्ती 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />कुछ फरीसी आयकै ईसु से बहस करन लगे, और बाकै अजमान ताहीं स्वर्ग को कोइसो भी चिन्ह माँगी। <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />पर बौ अपने मन मैं आँह भरी और कही, “जौ समय के आदमी पता नाय काहेकै, कोई चिन्ह ढूँड़त फिरथै? ईसु उनसे कही मैं तुमसे सच्ची कहथौं हबै के आदमिन कै कोईये निसानी नाय दई जागी।”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />और फिर ईसु उनकै हूँन छोड़कै नईंयाँ से झील के बौ पाँजर चले गौ।<verse eid="MRK 8:13" /></para>
  <para style="s">फरीसियन और राजा हेरोद को खमीर<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">जो रोटी कै फुलान मैं मदत करथै</char></note></para>
  <para style="r">(<ref loc="MAT 16:5-21">मत्ती 16:5-21</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />चेला खान ताहीं कम खानु लईं, और जब बे नईंयाँ मैं रहैं तौ उनके झोने एकै रोटी रहै। <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ईसु उनकै चिताए कै कही, “देखौ फरीसियन के खमीर और हेरोद राजा के खमीर से चौकन्ने रहियो।”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />बे आपस मैं बतकान लगे, तभई जौ ऐसो कहबै काहैकि “हमरे झोने रोटी नाय हैं।”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />जो बे कहेत रहैं बौ जानकै ईसु कही, “तुम काहे रोटी नाय होन मैं एक दुसरे से बतकाथौ? का तुम हबै तक नाय जान और समझपाए हौ? का तुमरो मन इत्तो कर्‌रो हुई गौ है? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />तुमरी आँखी होत भै तुम नाय देख पाथौ? और तुमरे कान होत भै भी नाय सुन पाथौ? तुमकै यादौ नाय है <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />कि जब मैं पाँच हजारन के ताहीं पाँचै रोटी तोड़ो तौ तुम कित्ते टुकड़ा भरी भई छपरिया उठाए?” बे बासे कहीं, “बारह छपरिया।”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“और जब चार हजारन के ताहीं सात रोटी रहैं, तौ तुम कित्ते टुकड़ा भरी भई छपरिया कै उठाए रहौ?” बे फिर बासे कहीं “सात छपरिया।”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />बौ उनसे कही, “का तुम हबै तक समझिए नाय पाए?”<verse eid="MRK 8:21" /></para>
  <para style="s">ईसु बैतसैदा मैं एक अंधरा कै अच्छो करथै</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />फिर बे बैतसैदा मैं आए; तौ आदमी एक अंधरा कै ईसु के झोने लैयाईं और बासे नहोरे करीं कि बाकै छुइबै। <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />बौ अंधरा को हात पकड़कै गाँव के दुआरे लैगौ, और बाकी आँखी मैं थूक कै बाके ऊपर हात धरकै, बासे पूँछी, “तू कछु देखथै कि नाय?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />बौ आँखी उठाएकै कही, “मैं लौड़ा कै तौ देखत जरूर हौ लेकिन बे मोकै नेंगत भै पेंड़ के तराहनी दिखाई देथैं।”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />फिरौंकी बौ दुबारा से बाकी आँखी मैं हात रखी, और अंधरा गौर से देखी। और का देखरौ है कि बौ अच्छो हुई गौ है, और सपा-सपा देखरौ है। <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />ईसु बासे जौ कहकै घरै भेजी, “जौ गाँव के भीतर दुबारा पाँव मत धरिये।”<verse eid="MRK 8:26" /></para>
  <para style="s">ईसु को चेला पतरस, ईसु कै मसीह मानी</para>
  <para style="r">(<ref loc="MAT 16:13-20">मत्ती 16:13-20</ref>; <ref loc="LUK 9:18-21">लूका 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ईसु और बाके चेला कैसरिया फिलिप्पी के गाँव मैं गै। जब बे रस्ता मैं रहैं तौ अपने चेलन से पूँछन लगो, “आदमी मोसे का कहथैं बताबौ?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />“बे बासे कहीं, एकाद यूहन्ना बपतिस्मा देन बारो; लेकिन एकाद-जनी एलिय्याह भविस्यवक्ता और दुसरे भविस्यवक्तन मैं से एक कहमैं।”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />“लेकिन ईसु उनसे पूँछी, तुम मोसे का कहथौ?” पतरस बासे कही, “तू मसीह है।”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />तौ ईसु उनकै आग्या दई, “मेरे बारे मैं जौ बात कोई से मत कहियो।”<verse eid="MRK 8:30" /></para>
  <para style="s">ईसु अपनेई दुख और मरन के बारे मैं बताथै</para>
  <para style="r">(<ref loc="MAT 16:21-28">मत्ती 16:21-28</ref>; <ref loc="LUK 9:22-27">लूका 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />तौ फिर ईसु उनकै सिखान लगो कि “इंसानन के लौड़ा के ताहीं जरूरी है कि बौ खूबै दुख उठाबैगो, और बड़े-बूढ़े और मुखिया पुजारी और यहूदि नियम के सिक्छक बाकै ठुकराए कै मार डारंगे, फिर बौ तीन दिन बाद फिर जिंदो हुई जाबैगो।” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />ईसु जौ बात कै उनसे सपा-सपा कह दई। जौ बात से पतरस ईसु कै अलग्याँओं लैजाय कै झुकान लगो, <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />लेकिन बौ मुरक्कै अपने चेलन घाँईं दुबारा से देखी, और पतरस कै झुकाएकै कही, “ए सैतान मेरे अग्गु से दूर हुई जा; काहैकि तैं परमेस्वर की बातन के ऊपर नाय, लेकिन इंसानन की बातन के ऊपर मन लगाथै।”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />बौ चेला समेत भीड़ कै अपने झोने बुलाई और कही, “जो मेरे पच्छू आनो चाहथै, बौ अपने आपकै इंकार करै और अपनो क्रूस उठाएकै, मेरे पच्छू आबै। <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />काहैकि जो अपनी ज्यान बचानो चहागो बौ बाकै गबागो, लेकिन जो अपनी ज्यान मेरे ताहीं और सुसमाचार के ताहीं खोबैगो, बौ बाकै बचाए लेगो। <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />अगर इंसान पूरी दुनिया कै पाए लेबै और अपनी ज्यान कै गबाबै, तौ बाकै का फायदा? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />इंसान अपनी ज्यान के बदले मैं का दै सकथै? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />जो कोई व्यभिचारी और पापी पीढ़ी के बीच मोसे और मेरी बातन से सर्मागो, तौ इंसान को लौड़ा भी जब बौ पवित्र दूतन के संग अपने दऊवा की महिमा समेत आगो, तौ बहो से सर्मागो।”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ईसु उनसे कही, “मैं तुमसे सच्ची कहथौं कि जित्ते भी इतै ठाड़े हैं, इनमैं से कित्ते ऐसे हैं, कि जब तक परमेस्वर के राज्य कै सामर्थ्य संगै आत भइ नाय देख लेमंगे, तब तक नाय मरंगे।”<verse eid="MRK 9:1" /></para>
  <para style="s">ईसु को रूप बदलनो</para>
  <para style="r">(<ref loc="MAT 17:1-13">मत्ती 17:1-13</ref>; <ref loc="LUK 9:28-36">लूका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />छै दिन बाद ईसु पतरस और याकूब और यूहन्ना कै संग लई, और ऊँचे पहाड़ मैं लैगौ। जहाँ बे इकल्ले रहैं, हुँआँ उनके अग्गु, देखतै-देखत बाकी सकल पूरिये बदल गई, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />और बाके लत्ता ऐसे चमकन लागे, कि दुनिया मैं लत्ता धोन बारूओ इतनो सेतो नाय कर पातो। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />तौ बे तीनौ चेलन कै मूसा के संग एलिय्याह दिखाई दई, बे ईसु के संग बतकात रहैं। <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />और पतरस ईसु से कही, “गुरुजी, जौ अच्छी बात है कि हम हिंयाँ रहमैं: तभईये हम तीन तम्बु बनाए; एक तेरे ताहीं, एक मूसा ताहीं, और एक एलिय्याह ताहीं।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />बे बड़ा जोड़ डराय गै रहैं, जहे बजह से पतरस नाय जानत रहै कि का जबाब देबै।<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />तौ एक बादर उनकै छाए लई, और बौ बादर मैं से जौ अबाज निकरी, “जौ मेरो प्रिय लौड़ा है, जाकी सुनौ।” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />तुरंतै बे सब घाँईं देखन लगे, और ईसु कै छोड़कै अपने संग और कोई कै नाय देखी।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />पहाड़ से उतरत पोती बौ उनकै हुकम दई, “जब तक इंसान को लौड़ा मरे भै मैं से जिंदो नाय ही जाबै, तब तक जो कछु तुम देखे हौ बौ कोई से मत कहियो।”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />बे जौ बात कै याद रखीं; और एक दुसरे से सोच बिचार करन लगे, “मरे भै मैं से जिंदो होन को का मतलब है?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />और बे बासे पूँछन लगे, “यहूदि नियम के सिक्छक काहे कहथै कि एलिय्याह को पहले आनो जरूरी है?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />बौ उनकै जबाब दई, “एलिय्याह सच्ची मैं पहले आयकै सब कछु सुधारैगो, पर इंसान के लौड़ा के बारे मैं सास्त्र कहथै कि बौ बड़ा दुख उठाबैगो, और ठुकराओ जागो? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />पर मैं तुमसे कहथौ, कि एलिय्याह तौ आए चुको, और जैसो सास्त्र मैं बाके बारे मैं लिखो है, लोग जैसो चाँहीं बाके संग करी।”<verse eid="MRK 9:13" /></para>
  <para style="s">प्रेत आत्मा पकड़े भै बालका कै अच्छो करी</para>
  <para style="r">(<ref loc="MAT 17:14-20">मत्ती 17:14-20</ref>; <ref loc="LUK 9:37-43">लूका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />जब बौ बचे भै चेलन के झोने आओ, तौ देखी की उनके चारौ घाँईं बड़ी भीड़ लगी है, और यहूदि नियम के सिक्छक उनके संग बहस कर रै हैं। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />लोग ईसु कै देखत खिना कि बड़ा चौहोंक गै, और बाके घाँईं दौड़कै बाकै नमस्ते करीं। <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />ईसु उनसे पूँछी, “तुम इनसे काहे बहस कर रै हौ?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />भीड़ मैं से एक जबाब दई, “गुरुजी, मैं अपने लौड़ा कै तेरे झोने लाओ रहौं, जोमैं प्रेत आत्मा समाई रहै और बौ बतकाए नाय पाथै। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />जहाँ कहूँ बौ बाकै पकड़थै, हुँए पद्द दिना गिराय देथै: और बाके मोहों मैं से बुजबुजा आन लगथै, और बाके दाँत मिस जाथैं, और बौ ऐंठ जाथै, मैं तेरे चेलन से कहो रहौं की बाकै निकार दे, लेकिन उनमैं निकारन की हिम्मत नाय रहै।”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />जौ सुनकै बौ उनकै जबाब दैकै कही, “हे अविस्वासी लोगौ, मैं कब तक तुमरे संग रहमंगो? और मैं कब तक तुमरी सकारंगो? लौड़ा कै मेरे झोने लाबौ।”<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />तौ बे बाकै बाके झोने लाईं: और जब बौ बाकै देखी, तौ प्रेत आत्मा बाकै तुरंत मरोड़ दई; और बौ जमीन मैं गिर गौ, और बाके मोहों मैं से बुजबुजा निकरै और बौ पल्टईंयाँ खान लग गौ।<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />बौ बाके दऊवा से पूँछन लगो, “जौ हालत जाकी कब से है?” बौ कही, “बचपन से।” <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />“जहे प्रेत आत्मा जाकै खतम करन ताहीं कहु आगी और कहु पानी मैं गिराई; अगर तू कछु कर सकै तौ हमरे ऊपर तरस खा और मदत कर।”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />“हाँ” ईसु उनकै जबाब दई, “बिस्वास करन बारे के ताहीं सब कछु ही सकथै।”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />लौड़ा को दऊवा तुरंतै गिड़गिड़ाए कै कही, “प्रभु, मैं बिस्वास तौ करथौं, और जद्धा बिस्वास करन ताहीं मेरी मदत कर।”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />तौ ईसु देखी कि लोग दौड़कै भीड़ लगाए रै हैं, तौ बौ प्रेत आत्मा कै जौ कहकै झुकाइ, गूँगी और बैहरी आत्मा मैं तोकै आग्या देथौं तू बाके भीतर से निकर जा। गूँगी और बैहरी आत्मा, “मैं तोकै आग्या देथौं, बामै से निकर जा, और फिर बामै कहुए मत घुसिये।”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />तौ बौ चिल्लाए कै और बाकै बड़ा जोड़ से मरोड़ कै, निकर आई; और सबै जनी कहेन लागे “बौ मर गौ है।” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />लेकिन ईसु बौ लौड़ा को हाथ पकड़कै उठाई, और बौ ठाड़गौ।<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />जब ईसु घरै आओ, तौ बाके चेला अकेले मैं पूँछी, “हम प्रेत आत्मा कै काहे नाय निकार पाए?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ईसु उनकै जबाब दई, “ऐसो भूत प्रार्थना के अलावा और कोई तरीका से नाय निकर सकथै।”<verse eid="MRK 9:29" /></para>
  <para style="s">ईसु अपने मरन के बारे मैं दुबारा से बताथै</para>
  <para style="r">(<ref loc="MAT 17:22-23">मत्ती 17:22-23</ref>; <ref loc="LUK 9:43-45">लूका 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />ईसु और बाके चेला हुँआँ से निकरकै गलील नगर होत भै जात रहैं। बौ नाय चहात रहै की बौ कहाँ हैं, कोई कै पता चलै, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />काहैकि बौ अपने चेलन कै उपदेस देत और उनसे कहेत रहै, “इंसान को लौड़ा आदमियन के हाथ मैं पकड़बाओ जागो, और बे बाकै मार डारंगे; और बौ मरन के तीन दिन बाद जिंदो हुई जाबैगो।”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />पर बौ जो उपदेस देत रहै बौ बात उनकी समझ मैं नाय आई, और बे बासे पूँछन से डरात रहैं।<verse eid="MRK 9:32" /></para>
  <para style="s">सबसे बड़ो कौन</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्ती 18:1-5</ref>; <ref loc="LUK 9:46-48">लूका 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ईसु और बाके चेला कफरनहूम मैं आए; और घर मैं आए कै बौ उनसे पूँछी, “रस्ता मैं तुम कौनछी बात मैं सोच-बिचार करत रहौ?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />बे चुप रहैं, काहैकि रहामैं बे हममैं से बड़ो कौन है बौ बात के बारे मैं सोच-बिचार करत रहैं। <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />बौ बैठकै बारहों कै बुलाई और उनसे कही, “अगर कोई बड़ो होनो चाहबै, तौ अग्गु सबसे छोटो और सबकी सेवा करन बारो सेवक बनै।” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />और बौ एक बालक कै लायकै उनके बीच मैं ठड़बाए दई, और बाकै गोदी मैं लैकै उनसे कही, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“जो कोई मेरे नाओं से ऐसे बालकन मैं से एक कै भी मानथै, बौ मोकै मानथै; और जो कोई मोकै मानथै, बौ मोकै नाय, बल्किन मेरे भेजन बारे कै मानथै।”<verse eid="MRK 9:37" /></para>
  <para style="s">जो खिलाप मैं नाय, बौ मेरे घाँईं है</para>
  <para style="r">(<ref loc="LUK 9:49-50">लूका 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />तौ यूहन्ना ईसु से कही, “गुरुजी, हम एक आदमी कै तेरे नाओं से प्रेत आत्मा कै निकारत देखे और हम बाकै मना करन लगे, काहैकि बौ हमरे झुंड को नाय रहै।”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ईसु कही, “बाकै मत मना करौ,” ऐसो कोई नाय है जो मेरे नाओं से सामर्थ्य को काम करै, और जल्दी से मोकै बुरो कह सकै, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />काहैकि जो हमरे खिलाप मैं नाय हैं, बे हमरे घाँईं हैं। <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />जो कोई एक कटोरा पानी तुमकै पिबाबै कि तुम मसीह के हौ तौ मैं तुमसे सच्ची कहथौं कि बौ अपनो इनाम नाय हरबाबैगो।<verse eid="MRK 9:41" /></para>
  <para style="s">ठोकर की बजह बननो</para>
  <para style="r">(<ref loc="MAT 18:6-9">मत्ती 18:6-9</ref>; <ref loc="LUK 17:1-2">लूका 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“जो कोई इन छोटे मैं से मेरे ऊपर बिस्वास करथै, अगर कोई बाके बिस्वास खोन को बजह बनै तौ बाके ताहीं अच्छो जौ है कि एक बड़ी चक्की को पटला बाकी घेंट मैं लटकाओ जाए और समुंदर मैं डार दौ जाए। <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />अगर तेरो हाथ तेरे बिस्वास खोन को बजह बनै तौ बाकै काट दे। टुन्डा हुईकै जिंदगी बितानो तेरे ताहीं अच्छो है कि दुई हाथ होत भइ तू नरक की आगी मैं डारो जाए जो कहुए बुतन की नाय है। <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />जहाँ पर बाको कीरा नाय मरथै और आगी भी नाय बुतथै।<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">जौ आयत कुछ दस्तावेजन मैं नाय मिलथै।</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />अगर तेरो पाँव तेरे बिस्वास कै खोन को बजह बनै तौ बाकै काट दे। लंगड़ा हुईकै जिंदगी बितानो तेरे ताहीं अच्छो है कहूँ दुई पाँव होन के बाबजूद भी तू नरक की आगी मैं खेंक दौ जाबै, <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />जहाँ पर उनको कीरा कहुए नाय मरथै और आगी भी कहुए नाय बुतथै। <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />अगर तेरी आँखी तेरे बिस्वास कै खोन को बजह बनै तौ बाकै निकार दे। काना हुईकै परमेस्वर के राज्य मैं आनो तेरे ताहीं अच्छो है। कहीं ऐसो नाय होबै दुई आँखी होन के बाबजूद तू नरक की आगी मैं खेंक दौ जाबै। <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />जहाँ पर बाको कीरा नाय मरथै और आगियौ नाय बुतथै।”<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />काहैकि हर एक आदमी कै आगी से सुद्ध करौ जाबैगो जैसे कि भेंट कै नून से सुद्ध करो जाथै।<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“नून अच्छो है; और अगर नून को नुनियानपन चले गौ तौ बाकै कासे नुनियान करैगे?”</para>
  <para style="p" vid="MRK 9:50">“अपने मैं दिलबराने को नुनियानपन रखौ, और एक दुसरे के संग सांति से रहबौ।”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">तलाक के बारे मैं ईसु की सिक्छा</para>
  <para style="r">(<ref loc="MAT 19:1-12">मत्ती 19:1-12</ref>; <ref loc="LUK 16:18">लूका 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />फिर ईसु हूँना से उठकै यहूदिया की सीमा से यरदन नदिया के पार आओ। लोगन की भीड़ फिर से बाके झोने आई और बौ हमेसा तराहनी सिखान लागो।<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />तौ फरीसी बाके झोने आए कै बाकै फसान की कोसिस करीं। “बे ईसु से पूँछीं,” हमकै बता, “का हमरो नियम एक आदमी कै बाकी अपनी बईय्यर कै छोड़न को अधिकार देथै?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />तौ बौ उनकै जबाब दई। “मूसा तोकै का नियम दई है?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />बे कहीं “मूसा अपनी बईय्यर कै नियम के जरिया एक चिट्ठी लिखकै छोड़न ताहीं इजाजत दई है।”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ईसु उनसे कही, “तुमरे कर्‌रे मन की बजह से जौ आग्या बौ तुमरे ताहीं लिखी। <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />सास्त्र ऐसो कहथै, जौ दुनिया की सुरुवात से परमेस्वर लोग और बईय्यर करकै उनकै बनाई है। <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />तौ जहे बजह से आदमी अपनी अईय्या और दऊवा से अलग हुईकै अपनी बईय्यर के संग रहागो, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />तौ बे दोनों एक तन हीकै एक संग रहमंगे; काहैकि अब बे दुई नाय बल्किन एक सरीर हैं। <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />काहैकि जोकै परमेस्वर जोड़ी है, उनकै आदमी अलग नाय करै।”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />घर मैं आयकै चेला जाके बारे मैं बासे फिर पूँछीं। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />बौ उनसे कही, “एक आदमी अपनी बईय्यर कै तलाक दैकै दुसरी से बिहा करथै तौ बौ पहली बारी के खिलाप व्यभिचार करथै; <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />जहे हानी अगर बईय्यर अपने लोगा कै तलाक दैकै दुसरे लोग से बिहा करथै तौ बौ भी व्यभिचार करथै।”<verse eid="MRK 10:12" /></para>
  <para style="s">ईसु बालकन कै आर्सिवाद दई</para>
  <para style="r">(<ref loc="MAT 19:13-15">मत्ती 19:13-15</ref>; <ref loc="LUK 18:15-17">लूका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />फिर लोग बालकन कै ईसु के झोने लान लगे की बौ उनके ऊपर हाथ धरै, तौ बाके चेला उनकै झुकाईं। <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ईसु जौ देखकै गुस्सा हुईकै चेलन से कही, “बालकन कै मेरे झोने आनदेयौ उनकै रोकौ मत्ती, काहैकि परमेस्वर को राज्य ऐसियनै को है। <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />मैं तोसे सच्ची कहथौं कि जो कोई परमेस्वर के राज्य कै बालकन जैसी नाय मानैगो, बौ परमेस्वर के राज्य मैं कहुए नाय पुगैगो।” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />फिरौंकी बौ बालकन कै गोदी मैं लई, और उनके ऊपर हाथ धरकै आर्सिवाद दई।<verse eid="MRK 10:16" /></para>
  <para style="s">सेठ आदमी</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्ती 19:16-30</ref>; <ref loc="LUK 18:18-30">लूका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />ईसु हुँआँ से निकरकै रहामैं जातै रहै, तौ एक आदमी भाजत भौ बाके झोने आओ, और बाके अग्गु घूँटे टेक कै बासे पूँछी, “अच्छो गुरुजी, अनंत जिंदगी पान ताहीं मैं का करौं?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ईसु बासे कही, “तू मोकै अच्छो काहे मानथै? कोई अच्छो नाय है, खाली परमेस्वर है। <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />तू आग्यन कै जानतै होगो: ‘हत्या मत करिये, व्यभिचार मत करिये, चोरी मत करिये, झूठी गभाई मत दिए, ठगिये मत्ती, अपने दऊवा और अईय्या को कहनो मानिये।’”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />बौ बासे कही, “गुरुजी, इन सबन कै मैं बचपन से मानत आओ हौं।”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ईसु बाकै प्यार से देखकै बासे कही, “तेरे मैं एक बात की कमी है। जा, जो कछु तेरो है बाकै बेंच कै कंगालन कै दैदे, और तोकै स्वर्ग मैं धन मिलैगो, और मेरे पच्छू हुई ले।” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />और जौ बात से बाको मोहों पुस्केयाए गौ, बौ दुखी हुईकै चले गौ, काहैकि बौ बड़ा सेठ रहै।<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ईसु सब घाँईं देखी और अपने चेलन से कही, “सेठ आदमी को परमेस्वर के राज्य मैं आनो बड़ा मुस्किल है।”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />चेला बाकी बात से अचम्मे भै। और फिर ईसु उनसे कही, “अरे बालकौ, जो धन के ऊपर भरोसो रखथै, उनको परमेस्वर के राज्य मैं जानो बड़ा मुस्किल है! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />सुईं के भार से ऊँट कै निकर जानो तौ आसान है पर परमेस्वर के राज्य मैं सेठ आदमी को घुसनों कतई मुस्किल है।”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />चेला बड़ा अचम्मे हुईकै आपस मैं कहेन लगे, “तौ फिर कौन, बचाओ जाओ सकथै?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ईसु उनके घाँईं देखकै कही, “आदमिन से तौ जौ नाय हुई सकथै, लेकिन परमेस्वर से हुई सकथै; काहैकि परमेस्वर से सब कछु हुई सकथै।” <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />पतरस उनसे कहेन लागो, “देख हम तौ सब कछु छोड़कै तेरे पच्छू हुई लै हैं।” <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />ईसु कही, “मैं तुमसे सच्ची कहथौं कि ऐसो कोई नाय है जो मेरे सुसमाचार के ताहीं घर या भईय्यन या बहेनियन या अईय्या-दऊवा या बाले-बच्चन या खेतन कै छोड़ दई होबै, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />बौ अब जौ समय खूबै पाबैगो। बौ सौ गुना अगरो घर, भईय्यन, बहेनियन, अईय्या, बाल-बच्चन, खेतन, सताव, और दुसरे युग मैं अनंत जिंदगी पाबैगो। <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />पर बे जो बड़ा जोड़ जनी पहले से हैं, पच्छू होमंगे; और जो पच्छू हैं, बे अग्गु होमंगे।”<figure style="fig" alt="Merchant leading a camel outside a city wall and gate" file="hk00041c.tif" size="col" copy="Horace Knowles ©" ref="10:25">सहर की दीवार और फाटक के बाहर बेचन बारो ऊँट कै दिखात भइ</figure><verse eid="MRK 10:31" /></para>
  <para style="s">ईसु तिसरी बार अपने मरन के बारे मैं बताथै</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती 20:17-19</ref>; <ref loc="LUK 18:31-34">लूका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />बे यरूसलेम कै जात भै रहामैं रहैं, और उनके अग्गु-अग्गु ईसु जात रहै: चेला अचम्मे होन लागे। बे जो बाके पच्छू-पच्छू आत रहैं बे डरात रहैं। तौ बौ फिरौंकी बारहों कै लैकै उनसे कहेन लागो, जो बाके ऊपर आनबारी रहै, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“देखौ हम यरूसलेम कै जानथैं, इंसान को लौड़ा कै पकड़वाए कै मुखिया पुजारिन और यहूदि नियम के सिक्छकन के हाथ मैं दै दौ जागो, और बे बाकै मारन ताहीं बाकी बुराई करंगे, और गैर यहूदि कै दै देंगे। <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />बे बाकी मजाक बनांगे, और बाके ऊपर थूकंगे, बाकै कोड़ा मारंगे और बाकै मार डारंगे और बौ तीन दिन बाद जिंदो हुई जागो।”<verse eid="MRK 10:34" /></para>
  <para style="s">याकूब और यूहन्ना की बिनती</para>
  <para style="r">(<ref loc="MAT 20:20-28">मत्ती 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />तौ जब्दी को लौड़ा याकूब और यूहन्ना बाके झोने आए कै कहीं, “गुरुजी, जो कुछ हम तोसे माँगै बौ तू हमरे ताहीं करै।”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />बौ उनसे कही, “तुम का चाहथौ?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />तौ बे बासे कहीं, “हमैं जौ दे कि तेरे राज्य के सिंघासन की महिमा मैं जब तैं बैठैगो तौ हममैं से एक तेरे दाँए और दुसरो तेरे बाँए बैठै।”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ईसु उनसे कही, “तुम नाय जानथौ की तुम का माँग रै हौ? जो कटोरा मैं, मैं पीन बारो हौं, का तुम पी सकथौ? और जो बपतिस्मा मैं लेन बारो हौं, का तुम लै सकथौ?”<note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">लूका 12:50</ref></char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />बे बासे कहीं, “हमसे हुई सकथै।” ईसु उनसे कही, “जो कटोरा मैं पीन बारो हौं, तुम पीबैगे; और जो बपतिस्मा मैं लेन बारो हौं, बाकै लेगे। <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />पर जौ अधिकार मेरो नाय है और दाँए-बाँए बैठारन को मेरो काम नाय है। जोके ताहीं जघा समारो गौ है, उनकै परमेस्वर खुद बैठारैगो।”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />जौ सुनकै बे दसौ चेला याकूब और यूहन्ना से खिसियान लगे। <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />तौ ईसु उनकै झोने बुलाएकै उनसे कही, “तुम जानथौ की गैर यहूदि के हाकिम माने जाथैं; और बे उनके ऊपर राज्य करत रहैं; और उनमैं जो बड़ो है, उनके ऊपर अधिकार दिखात रहै। <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />पर तेरे मैं ऐसो न है, जो कोई तुम मैं से बड़ो होनो चाहथै बौ तुमरी सेवा करन बारो सेवक बनै; <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />और जो कोई तुम मैं से मुखिया बननो चाहबै सबको दास बनै। <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />इंसान को लौड़ा जाके ताहीं नाय आओ है कि बाकी सेवा करी जाबै, बल्कि जाके ताहीं आओ कि बौ खुद सेवा करै, और दुसरेन कै छुड़ान ताहीं अपनी ज्यान देबै।”<verse eid="MRK 10:45" /></para>
  <para style="s">अंधरा बरतिमाई कै आँखी दई</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्ती 20:29-34</ref>; <ref loc="LUK 18:35-43">लूका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ईसु और बाके चेला यरीहो मैं आए, और बे एक बड़ी भीड़ संग यरीहो से निकरत रहैं, तौ तिमाही को लौड़ा बरतिमाई, एक अंधरा भिकमंगा रस्ता टिकारे बैठो रहै। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />बौ जौ सुनकै की ईसु नासरी है, तौ चिल्लाए-चिल्लाए कै कहेन लगो, “दाऊद को लौड़ा, ईसु मेरे ऊपर दया कर।”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />सबै जनी बाकै झुकाइ की चुप्पा रहा, बौ और चिल्लान लागो, “ए दाऊद को लौड़ा, मेरे ऊपर दया कर।”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />तौ ईसु रुक कै कही, “बाकै बुलाबौ।” और बे आदमी अंधरा कै बुलाएकै बासे कहीं, “हिम्मत भाँद! उठ! बौ तोकै बुलाए रौ है।”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />बौ अपनो लत्ता खेंक कै तुरंत उठो, और ईसु के झोने आओ।<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />तौ फिर ईसु बासे कही, “तू का चाहथै कि मैं तेरे ताहीं करौं?” अंधरा बासे कही, “गुरु, मैं फिर से देखन लगौं।”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ईसु बासे कही, “चले जा, तेरो बिस्वास तोकै अच्छो करी है।” बौ तुरंत देखन लगो, और रस्ता मैं बाके पच्छू हुई लई।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">यरूसलेम मैं जीत को सफर</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="LUK 19:28-40">लूका 19:28-40</ref>; <ref loc="JHN 12:12-19">यूहन्ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />जब ईसु और बाके चेला यरूसलेम झोने, जैतून पहाड़ के बैतफगे और बैतनिय्याह के झोने आओ, बौ अपने चेलन मैं से दुई कै जौ कहकै पनारी, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />“झोने के गाँव मैं जाबौ, हूँना पुगकै एक गधईया को बच्चा, जोके ऊपर कोई नाय बैठो है, बंधो भौ तुमकै मिलैगो। बाकै खोल लाबौ। <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />तुमसे कोई पूँछै जाको तुम का करैगे, तौ कहियो, ‘गुरु कै जरूरत है,’ और बौ तुरंतै बाकै हिंयाँ पनार देगो।”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />बे जाएकै बौ बच्चा कै दुआरे फाटक के झोने खुटी मैं बंधो भौ पाईं, तौ खोलन लगे। <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />बामै से जो हूँना ठाड़े रहैं, कोई-कोई कहेन लागे, “गधईया के बच्चा कै काहे खोल रै हौ?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />जैसी ईसु उनसे कही, बैसिये बे उनसे कह दईं; तौ लोग उनकै जान दईं। <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />बे बच्चा कै ईसु के झोने लाईं और बे बाके ऊपर लत्ता डारीं और बौ बाके ऊपर बैठगौ। <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />तौ निरे जनी अपने लत्ता रहामैं बिछाईं और दुसरे आदमी खेत मैं से हँगईय्या तोड़-तोड़कै रहामैं फैलाय दईं, <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />जो बाके अग्गु-अग्गु जात रहैं और जो बाके पच्छू-पच्छू आत रहैं, चिल्लाए-चिल्लाए कै कहेत जात रहैं, “होसन्ना! धन्य है बौ जो प्रभु के नाओं से आथै। <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />हमरो दऊवा राजा दाऊद को राज्य जो आए रौ है; धन्य है! होसन्ना<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">स्तुति</char></note>।”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />ईसु यरूसलेम पुगकै मंदिर मैं आओ, और सब चीज देखकै बारहों के संग बैतनिय्याह गौ, काहैकि संजा खिन हुई गई रहै।<verse eid="MRK 11:11" /></para>
  <para style="s">ईसु अंजीर के रूखा कै बद्‌दुआ देथै</para>
  <para style="r">(<ref loc="MAT 21:18-19">मत्ती 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />दुसरे दिन ईसु और बाके चेला बैतनिय्याह से निकरे तौ बाकै भूंक लगी। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />बौ दूर से अंजीर को एक हरो रूखा देखकै बाके झोने गौ की बामै कछु होबै: बामै पत्ता के अलावा कछुए नाय पाई; काहैकि बौ समय फरन की बेरा नाय रहै।<verse eid="MRK 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 11:14" />तौ बौ बासे कही, “अब से तेरो फरा कहुए कोई नाय खागो!” और बाके चेला सुनत रहैं।<verse eid="MRK 11:14" /></para>
  <para style="s">ईसु मंदिर गौ</para>
  <para style="r">(<ref loc="MAT 21:12-17">मत्ती 21:12-17</ref>; <ref loc="LUK 19:45-48">लूका 19:45-48</ref>; <ref loc="JHN 2:13-22">यूहन्ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />बे फिर यरूसलेम मैं आए, और बौ मंदिर मैं गौ; जो हूँना खरीदन और बेचन को काम करत रहैं उनकै दुआरे निकारन लागो, रुपईया-पैसन कै बदलन बारेन और कबूतर बेचन बारेन की मेज कै पलट दई। <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />और मंदिर मैं से हुईकै कछुए लैकै नाय आन-जान दई। <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />और उपदेस दैकै उनसे कही, “का जौ सास्त्र मैं नाय लिखो है कि मेरो घर सब देस के लोगन के ताहीं प्रार्थना को घर कहो जाबै? और तुम जाकै डकैतन की जघा बनाए दै हौ।”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />जौ सुनकै मुखिया पुजारी और यहूदि नियम के सिक्छक ईसु कै मार डारन की सोचन लागे; काहैकि बे बासे डरात रहैं, और बाके उपदेस से पूरो झुंड अचम्मो मानत रहैं।<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />संजा भौ तौ ईसु और बाके चेला सहर से दुआरे चले गै।<verse eid="MRK 11:19" /></para>
  <para style="s">सूखे अंजीर के रूखा से सिक्छा</para>
  <para style="r">(<ref loc="MAT 21:20-22">मत्ती 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />भोर भौ तौ ईसु और बाके चेला उतै से जात रहैं तौ बे अंजीर के रूखा कै जड़ तक सूखो भौ देखीं। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />पतरस कै बौ बात याद आई, और बौ उनसे कही, “गुरु, देख! जौ अंजीर को रूखा जोकै तू बद्‌दुआ दौ रहै, सूख गौ है।”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ईसु बाकै जबाब दई, “परमेस्वर के ऊपर बिस्वास रखौ। <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />मैं तोसे सच्ची कहथौं कि जो कोई जौ पहाड़ से कहबै, तू उखड़ जा, और समुंदर मैं गिर जा, और अपने मन मैं संका नाय करै, बल्किन जौ बिस्वास करै कि जो कहो हौं बौ हुई जाबैगो, तौ बाके ताहीं बहे होगो। <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />जहेमारे मैं तुमसे कहथौं कि जो कुछ तुम प्रार्थना करकै माँगौ, तौ भरोसो कर लेयौ कि तुमकै मिलगौ, और तुमरे ताहीं हुई जाबैगो। <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />जब कहूँ तुम ठाड़कै प्रार्थना करथौ, तुमरे मन मैं कोई के ताहीं गुस्सा होबै, तौ माफ कर दियौ: तभई तुमरो स्वर्ग को दऊवा जो बात तुम गलत करे हौ माफ करैगो। <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />अगर तुम माफ नाय करौ तौ तुमरो दऊवौ जो स्वर्ग मैं है, तुमरो पाप माफ नाय करैगो।”<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">कुछ दस्तावेजन मैं जौ आयत नाय मिलथै</char></note><verse eid="MRK 11:26" /></para>
  <para style="s">ईसु के अधिकार मैं सबाल</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्ती 21:23-27</ref>; <ref loc="LUK 20:1-8">लूका 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ईसु और बाके चेला फिरौंकी यरूसलेम मैं आए, और जब बे मंदिर मैं फिरत रहैं तौ मुखिया पुजारी और यहूदि नियम के सिक्छक और बड़े-बूढ़े बाके झोने आए कै पूँछन लगे, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />“तू जे काम कौन्छे अधिकार से करथै? और जौ अधिकार तोकै कौन दौ है?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ईसु उनसे कही, “महुँ तुमसे एक बात पूँछ थौं; मोकै जबाब देयौं तौ मैं तुमकै बतांगो कि जौ काम कौन्छे अधिकार से करथौं। <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />यूहन्ना को बपतिस्मा का स्वर्ग से रहै की आदमियन के घाँईं से रहै मोकै बताबौ?”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />तौ बे आपस मैं बातचीत करन लागे अगर हम कहमैं: “स्वर्ग की घाँईं से” तौ बौ कहगो, “तुम बाके ऊपर बिस्वास काहेकै नाय करे? <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />और अगर हम कहमैं, ‘आदमियन की घाँईं से, तौ उनकै लोगन को डर रहै, काहैकि सब जानत रहैं कि यूहन्ना सच मैं भविस्यवाँड़ी करन बारो रहै।’”<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />और बे ईसु कै जबाब दईं, “हम नाय जानथैं।” ईसु उनसे कही, “महुँ तुमकै नाय बतांगो की जौ काम कौन के अधिकार से करथौं।”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">अंगूर की बारी के किराय दारन की कहानी</para>
  <para style="r">(<ref loc="MAT 21:33-46">मत्ती 21:33-46</ref>; <ref loc="LUK 20:9-19">लूका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />फिर ईसु कहानी मैं उनसे बात करन लागो: “एक आदमी अंगूर की बारी लगाई, और बाके चारौ तरफ बेहड़ा लगाई, और रस के ताहीं गड्डा खोदी, और गुम्मट बनाई। और कमईंयन कै बाको ठेका दैकै दुसरे देस कै चलो गौ। <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />फिर फरा बारे महेना के बेरा मैं, बौ किसानन के झोने एक दास कै पनारी कि किसानन से अंगूर की बारी के फरा को हिस्सा लै आबै। <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />पर बे बाकै पकड़कै भौत मारीं और खाली हाथ लौटाय दईं। <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />फिर बौ एक और दास कै उनके झोने पनारी; बे बाको मूड़ फोड़ दईं और बाकी बेजती करीं। <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />फिर बौ एकौर कै पनारी, बाकै बे मारडारीं; तौ बौ निरे जनी कै पनारी, उनमैं से बे कुछ एक कै पीटीं, और कुछन कै मारडारीं। <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />अब एक रहगौ रहै, जो बाको प्रिय लौड़ा रहे। और आखरी मैं बाकै जौ सोचकै पनारी कि ‘बे मेरे लौड़ा की इज्जत’ करंगे। <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />बे कमईंयाँ आपस मैं कहीं, ‘जहे तौ बारिस है; आबौ हम जाकै मार डारैं, तौ जमीन हमरी हुई जाबैगी!’” <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />और बाकै पकड़कै मारडारीं और अंगूर की बारी के दुआरे फेंक दईं।<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />“तौ अब, अंगूर की बारी को मालिक का करैगो?” बौ आए कै बे कमईंयन कै बरबाद कर देगो, और अंगूर की बारी दुसरे कै दै देगो। <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />का तुम जौ बचन पवित्र सास्त्र मैं नाय पढ़े हौ?</para>
  <para style="q1" vid="MRK 12:10">“जो पथरा कै राजमिस्त्री ठुकराई</para>
  <para style="q2" vid="MRK 12:10">बहे मकान के कोहने को खास हिस्सा हुई गौ।<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />जौ प्रभु की मरजी से भौ;</para>
  <para style="q2" vid="MRK 12:11">और हमरी नजर मैं अचम्मो है!”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />तौ यहूदि नेता बाकै पकड़न ताहीं करीं; काहैकि बे समझ गै कि बौ उनसे कहानी मैं उनके खिलाप मैं कही है। पर बे लोगन से डरात रहैं, और बाकै छोड़कै चले गै।<verse eid="MRK 12:12" /></para>
  <para style="s">कैसर कै लगान देन के बारे मैं सबाल</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्ती 22:15-22</ref>; <ref loc="LUK 20:20-26">लूका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />तौ ईसु कै बातन मैं फसान ताहीं फरीसियन और हेरोदियन कै बाके झोने पनारी। <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />बे आयकै बासे कहीं, “गुरुजी हम जानथैं, कि तू सच्चो है, और कोई की परबाह नाय करथै; काहैकि तू आदमिन को मोहों देखकै बात नाय करथै, पर परमेस्वर की रहा अच्छे से बताथै। तौ का कैसर कै नियम से हिसाब से लगान देनो अच्छो है या नाय?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />हम देमैं, या नाय देमैं, “बौ उनको कपट जानकै उनसे कही, मोकै काहे परखथौ? एक चाँदी को सिक्का मेरे झोने लाबौ, कि मैं बाकै देखौं।”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />बे लै आईं, और बौ बासे कही, “जौ छापो और नाओं कौन को है?” तौ बे कहीं, “कैसर को।”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ईसु उनसे कही, “जो कैसर को है बौ कैसर कै, और जो परमेस्वर को है बौ परमेस्वर कै देबौ।” तौ बे बड़ा अचम्मो मानन लागे।<verse eid="MRK 12:17" /></para>
  <para style="s">पुनरुत्थान के बारे मैं सबाल</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्ती 22:23-33</ref>; <ref loc="LUK 20:27-40">लूका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />फिर कुछ सदूकी, जौ कहेत रहैं कि मरे भैन को जिंदो होनो हईये नाय, ईसु झोने आयकै बासे पूँछी, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“ओ गुरु, मूसा हमरे ताहीं लिखी है कि अगर बाको भईय्या बिना बालक के मर जाबै और बाकी बईय्यर रह जाबै तौ बाको भईय्या बासे बिहा कर लेबै और अपने भईय्या के ताहीं बालक पैदा करै। <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />सात भईय्या रहैं। सबसे बड़ो बारो बिहा करकै बिना बालक के मर गौ। <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />तौ दुसरो भईय्या बौ बईय्यर से बिहा कर लई और बिना बालक के मर गौ; और बैसिये तीसरो बारो भी करी। <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />और सातौ भईय्या से बालक नाय भै। और सबन के पच्छू बौ बईय्यर भी मर गई। <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />अच्छेया तौ जिंदो होन के बाद बौ कौनकी बईय्यर होगी? काहैकि बौ सातौ की बईय्यर बन चुकी रहै।”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ईसु उनसे कही, “का तुम जौ बजह से भूल मैं नाय पड़े हौ कि तुम पवित्र सास्त्र कै नाय जानथौ, और नाय परमेस्वर कि सामर्थ्य कै? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />काहैकि जब बे मरे भै मैं से जिंदे हुई जामंगे, तौ ना बे बिहा करंगे और ना बिहा कर सकंगे, और स्वर्ग मैं दूतन के हानी होंगे। <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />मरे भै के जिंदो होन के बारे मैं का तुम मूसा की किताब झाड़ी की कहानी मैं नाय पढ़े? कि परमेस्वर बासे कही, ‘मैं अब्राहम को परमेस्वर, और इसहाक को परमेस्वर, और याकूब को परमेस्वर हौं।’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />परमेस्वर मरे भैन को नाय बल्किन जिंदेन को परमेस्वर है; तुम बड़ा भूल मैं हौ।”<verse eid="MRK 12:27" /></para>
  <para style="s">सबसे बड़ी आग्या</para>
  <para style="r">(<ref loc="MAT 22:34-40">मत्ती 22:34-40</ref>; <ref loc="LUK 10:25-28">लूका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />यहूदि नियम के सिक्छकन मैं से एक आयकै उनकै लड़त भइ सुनी, और जौ जानकै कि ईसु उनकै सई-सई जबाब दई, बासे पूँछी, “सबसे बड़ी आग्या कौन सी है?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ईसु उनकै जबाब दई, “सब आग्यन मैं से जौ अच्छी है: ‘अरे इस्राएल सुन! प्रभु हमरो परमेस्वर एकै परमेस्वर है, <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />और प्रभु अपने परमेस्वर से अपने पूरे मन से, और अपनी पूरी ज्यान से, और अपनी पूरी अकल से, और अपनी पूरी ताकत से प्यार रखनो।’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />और दुसरी आग्या जौ है, ‘कि तू अपने पड़ोसी से अपने हानी प्यार रखिये।’ जासे बड़ी और कोई आग्या नाय है।”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />यहूदि नियम के सिक्छक बासे कही, “अरे गुरु बड़ा अच्छो! तू सच्ची कहो कि बौ एकै है, और बाकै छोड़ और कोई नाय। <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />और परमेस्वर से पूरे मन, और पूरी बुद्धि, और पूरी ज्यान से, और पूरी ताकत से प्यार रखनो; और पड़ोसी से अपने हानी प्यार रखनो, सारे पसु बलियन और सबै बलिदान से बढ़कै है।”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />तौ ईसु देखी कि बौ समझदारी से जबाब दई, तौ बासे कही, “तू परमेस्वर के राज्य से दूर नाय।” और कोई की भी बासे कछु पूँछन की हिम्मत नाय पुगी।<verse eid="MRK 12:34" /></para>
  <para style="s">मसीहा के बारे मैं सबाल</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्ती 22:41-46</ref>; <ref loc="LUK 20:41-44">लूका 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />फिर ईसु मंदिर मैं उपदेस देत भइ जौ कही, “यहूदि नियम के सिक्छक काहे कहथैं कि मसीह दाऊद को लौड़ा है?” <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />दाऊद खुद पवित्र आत्मा मैं हुईकै जौ कही है:</para>
  <para style="q1" vid="MRK 12:36">“प्रभु मेरे प्रभु से कही:</para>
  <para style="q2" vid="MRK 12:36">मेरे दहने बैठ</para>
  <para style="q2" vid="MRK 12:36">जब तक मैं तेरे बैरियन के बंस कै तेरे टाँग तरे नाय कर देयौं।”<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />दाऊद तौ खुद बाकै “प्रभु कहथै; फिर बौ बाको लौड़ा कहाँ से भौ? और भीड़ के आदमी बाकी मगन हीकै सुनत रहैं।”<verse eid="MRK 12:37" /></para>
  <para style="s">यहूदि नियम के सिक्छकन से बचे रहाबौ</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="LUK 20:45-47">लूका 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />बौ अपने उपदेस मैं बासे कही, “यहूदि नियम के सिक्छकन से चहाचीते रहबौ, जो लम्बे-लम्बे चोंगा पहनकै फिरथैं और बजारन मैं नमस्ते, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />और सभाघर मैं अच्छे-अच्छे आसन और हटकना मैं अच्छी-अच्छी जघा भी चाहथैं। <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />बे बिधवन के घरन कै खाए जाथैं, और दिखान ताहीं बड़ी देर तक प्रार्थना करत रहथैं। बे भौत सजा पांगे।”<verse eid="MRK 12:40" /></para>
  <para style="s">बिधवा को दान</para>
  <para style="r">(<ref loc="LUK 21:1-4">लूका 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ईसु मंदिर के भंडार के सामने बैठकै देखत रहै कि आदमी मंदिर के भंडार मैं कैसे पैसा डारथैं; और सेठ आदमी गजब-गजब डारीं। <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />इत्ते मैं एक कंगाल बिधवा आयकै दुई ताँबे के छोटे सिक्का डारी। <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />तौ बौ चेलन कै झोने मस्काए कै उनसे कही, “मैं तुमसे सच्ची कहथौं कि मंदिर के भंडार मैं डारन बारेन से जौ कंगाल बिधवा सबसे जाधा डारी है; <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />काहैकि सब अपनी जाधा सम्पत्ति मैं से डारी हैं, लेकिन जौ अपनी घटी मैं से जो कुछ बाको रहै, बौ सब डार दई है।”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">मंदिर उजड़न की बात</para>
  <para style="r">(<ref loc="MAT 24:1-2">मत्ती 24:1-2</ref>; <ref loc="LUK 21:5-6">लूका 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />जब ईसु से मंदिर से निकरत रहै, तौ बाके चेलन मैं से एक बासे कही, “ए गुरु, देख कैसे बड़े-बड़े पथरा और इमारत हैं!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />तौ ईसु बासे कही, “का बड़ी-बड़ी इमारत देखथौ: हींना पर एकौ पथरा नाय बचैगो जो गिराओ नाय जागो।”<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />ईसु मंदिर के अग्गु जैतून पहाड़ मैं बैठो रहै, तौ पतरस, याकूब, यूहन्ना और अन्द्रियास इकल्ले मैं बाके झोने आए। <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />बासे पूँछी, “हमकै बता जे बात कब होंगी? और जे जब सब बात पूरी होन बारी होंगी बौ समय को का चिन्ह होगो?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ईसु उनसे कहेन लागो, “चहाचीते रहियो कोई तुमकै भरमाबै ना। <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />निरे मेरो नाओं लैकै कहमंगे, ‘मैं बहे हौं!’ और निरेन कै बहकामंगे।” <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />जब तुम लड़ाई की बात सुनौ, तौ मत डरईयो; काहैकि इनको होनो जरूरी है, लेकिन बौ अंत ना होगो। <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />देस एक दुसरे से लड़ंगे, राज्य एक दुसरे ऊपर हमला करंगे और सब कहूँ हालाचाला होंगे, और सूखा पड़ैगो। जौ सब कछु बालका होन के अग्गु को पीर हानी होगो।<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />पर तुम चहाचीते रहियो; काहैकि आदमी तुमकै पंचायतन मैं सौंपंगे और सभाघरन मैं पीटे जांगे और सुसमाचार के बजह से तुमकै हाकिमन और राजाओं के अग्गु खड़ो करौ जागो, ताकी उनके ताहीं गभाई होबै। <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />और जौ जरूरी है कि अग्गु सुसमाचार को प्रचार सब आदमिन मैं करो जाबै। <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />जब बे तुमकै लै जाएकै सौंपैं, तौ अग्गु से चिंता मत करियो कि हम का बोलंगे; और तुमकै जैसो बताओ जाबै बैसोई कहियो; काहैकि बोलन बारे तुम ना बल्किन पवित्र आत्मा है। <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />भईय्या-भईय्या कै और दऊवा लौड़ा कै मरन के ताहीं सौंप देंगे, बालका अपने अईय्या-दऊवा के खिलाप मैं उठंगे और उनकै जान से मरबाए देंगे। <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />और मेरो नाओं की बजह से सब जनी तुमसे बुरो बर्ताव करंगे। लेकिन जो आखरी तक सबर रखैगो, बहे को उद्धार होगो।<verse eid="MRK 13:13" /></para>
  <para style="s">बरबाद करन बारी चीज</para>
  <para style="r">(<ref loc="MAT 24:15-28">मत्ती 24:15-28</ref>; <ref loc="LUK 21:20-24">लूका 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“जब तुम बौ ‘बरबाद करन बारी बुरी चीजन’ कै जहाँ ठीक नाय हूँना बाकै ठाड़ी देखौ।” पढ़न बारो समझ जाए: तौ जो यहूदिया मैं होमैं, बे पहाड़ मैं भाज जामैं! <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />जो कोई छत के ऊपर हैं, बौ अपने घर मैं से कछु लेन ताहीं तरे ना आमै और ना भीतर जामैं; <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />और जो खेत मैं हैं, बे अपनो लत्ता लेन पच्छू ना लौटैं। <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />बे दिनन मैं जो गरब से होंगी, और जो दूद पिबान बारी होंगी उनके ताहीं कित्तो भयानक होगो। <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />और प्रार्थना करौ कि ऐसो जाड़ो के समय ना होबै <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />काहैकि जे दिनन मैं ऐसो दुख आगो जो दुनिया की सुरुवात से परमेस्वर बनाई है, अब तक ना तौ भौ, और ना कहुए दोहराए कै होबैगो। <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />अगर प्रभु बे दिनन कै ना घटातो, तौ कोईये लोग ना बचते। लेकिन बे छटे भै की बजह से जिनकै बौ चुनी, तभई जौ समय कै घटाई।<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“बहे समय कोई भी तुमसे कहबै, देखौ, मसीह! हींना है, ‘देखौ, हूँना है!’ तौ भरोसा मत करियो।” <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />काहैकि झूठे मसीह और झूठे भविस्यवक्ता ठाड़ जामंगे। चिन्ह और तरह-तरह के चमत्कार दिखांगे ताकी चुने भै आदमिन कै भी भरमाए देमैं। <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />लेकिन तुम चहाचीते रहियो; देखौ जे सब बात होन से अग्गुए बताए देथौं।<verse eid="MRK 13:23" /></para>
  <para style="s">इंसान के लौड़ा को दुबारा आनो</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्ती 24:29-31</ref>; <ref loc="LUK 21:25-28">लूका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“बे दिनन मैं दुख के बाद दिन अंधियारो मैं बदल जागो, और जोनी उजियारो नाय देगी, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />और आसमान से तारा गिरन लगंगे, और आसमान की सक्तियन कै हलाओ जागो। <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />तौ आदमी इंसान के लौड़ा कै पूरी सामर्थ्य, और महिमा के संग बादर मैं आत देखंगे। <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />बहे समय बौ अपने स्वर्गदूतन कै पनारकै, दुनिया के एक छोर से दुसरे छोर तक, चारौ घाँईं से अपने चुने भै आदमिन कै जोरैगो।”<verse eid="MRK 13:27" /></para>
  <para style="s">अंजीर के रूखा से सीख</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्ती 24:32-35</ref>; <ref loc="LUK 21:29-33">लूका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“अंजीर के रूखा से जौ कहानी सिकौ: जब बाकी हँगईय्या मुलायम होथैं, और उनमैं से कन्ति निकरथैं; तौ तुम पता लगाए लेथौ कि गर्मी को मौसम आनबारो है। <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />अगर जे बात ऐसो होत भै देखैगे, तौ जान लियो, कि बौ झोने है बल्किन दुआरे है। <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />मैं तुमसे सच्ची बात कहथौं, ऐसो जब तक पूरो ना होगो, तब तक कोई पीढ़ी खतम नाय होबैगी। <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />दुनिया और आसमान मिट जागो, लेकिन मेरी बात कहुए नाय मिटंगी।”<verse eid="MRK 13:31" /></para>
  <para style="s">दिन और घड़ी कोई ना जानथै</para>
  <para style="r">(<ref loc="MAT 24:36-44">मत्ती 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“बाकई मैं बौ दिन या पल कब आगो ऐसो कोईये नाय जानथै, ना स्वर्ग के स्वर्गदूत ना लौड़ा; सिरफ दऊवा जानथै। <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />जगत रहियो, चहाचीते रहियो; तुमकै ना पता है बौ समय कब आए जागो। <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />जौ बौ आदमी के गत की तरह है जो परदेस जान पोती अपनो घर छोड़ जाबै, और अपने सेवक कै काम सौंपै, और सबन कै बाकी जिम्मेदारी देबै, और रखबरिया कै जगत रहेन कि आग्या देबै। <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />जहेमारे जगत रहियो, काहैकि तुम कछु नाय जानथौ कि घर को मालिक कब आए जाबै, संजा कै या आधी रात कै या मुर्गा के बास देन के समय या दिन निकरन से अग्गु। <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ऐसो ना होबै कि अनकाचीति आए कै, और तुमकै सोत भै पाबै। <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />और जो भी बात तुमकै बताओ, मैं सबसे कहथौं: जगत रहियो!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">ईसु के खिलाप योजना</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती 26:1-5</ref>; <ref loc="LUK 22:1-2">लूका 22:1-2</ref>; <ref loc="JHN 11:45-53">यूहन्ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />दुई दिन के बाद फसह<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">निर्गमन 12 अखमीरी रोटी को त्योहार</char></note> और अखमीरी रोटी को त्योहार आनबारो रहै। मुखिया पुजारी, यहूदि नियम के सिक्छक जौ ताक मैं रहैं कि ईसु कै कैसे धोका से पकड़कै जान से मार डारैं। <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />“फिर बे कहेन लागे त्योहार के दिन नाय,” कहीं ऐसो न होबै, “कि आदमिन मैं हुलगदड़ मच जाबै।”<verse eid="MRK 14:2" /></para>
  <para style="s">बैतनिय्याह मैं ईसु को अनादर</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती 26:6-13</ref>; <ref loc="JHN 12:1-8">यूहन्ना 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />जब ईसु बैतनिय्याह मैं सिमौन कोहढ़ी के घर मैं खानु खान बैठो तभई बाके झोने एक बईय्यर संगमरमर के बर्तन मैं जटामांसी की कीमती सुद्ध इत्तर संग लाई; और बाके मूड़ इत्तर अखनाए दई। <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />तौ कुछ आदमी गुस्सा करत भै कहेन लागे, “जौ इत्तर कै काहे बरबाद करो गौ? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />जबकी जौ इत्तर तीन सौ चाँदी के सिक्का से जाधे मैं बेचकै गरीबन मैं बाँट देते!” और बाके ऊपर गुस्सा होन लगे।<figure style="fig" alt="Jars with spikenard" file="hk00117c.tif" size="col" copy="Horace Knowles ©" ref="14:3">बर्तन मैं जटामांसी को इत्तर</figure><verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ईसु उनसे कही, “बाकै छोड़ देबौ! बाकै काहे सताथौ? बौ तौ मेरे संग भलो करी है। <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />गरीब तौ तुमरे संग हमेसा रहेंगे, और कहु भी उनके संग भलाई कर लेगे, लेकिन मैं तुमरे संग हमेसा ना रहेंगो। <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />बौ जो कुछ कर सकी, बौ करी, बौ मेरे दफन होन की तैयारी से अग्गु मेरे सरीर कै जटामांसी नाओं के तेल से अभिसेक करी है। <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />मैं सच्ची-सच्ची कहथौं पूरी दुनिया मैं कहूँ भी सुसमाचार बताओ जागो, बाके काम की बात की बड़ाँईं जरूर करी जाबैगी।”<verse eid="MRK 14:9" /></para>
  <para style="s">यहूदा इस्करियोती को ईसु कै पकड़वान ताहीं राजी होनो</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्ती 26:14-16</ref>; <ref loc="LUK 22:3-6">लूका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />और यहूदा इस्करियोती जो बारहों मैं से एक रहै, और बौ मुखिया पुजारिन के झोने गौ ताकी उनके हाथ ईसु कै पकड़वाए सकै। <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />जे बात बाकी सुनकै बे बड़ा खुस भै, और बाकै रुपईया देन के ताहीं वादा करीं; और बौ मौका ढूँड़न लागो कि ईसु कै कौन सी तरकीब से पकड़बामैं।<verse eid="MRK 14:11" /></para>
  <para style="s">ईसु चेलन संग फसह त्योहार को खानु खाईं</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्ती 26:17-25</ref>; <ref loc="LUK 22:7-14">लूका 22:7-14</ref>; <ref loc="LUK 22:21-23">लूका 22:21-23</ref>; <ref loc="JHN 13:21-30">यूहन्ना 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />अखमीरी रोटी त्योहार के पहले दिन, जामैं बे फसह त्योहार कै डंगर को यानी भेंड़ के बच्चा कै मारत रहैं, तौ ईसु के चेला बासे पूँछी, “तू कितै जानो चाहथै कि हम तेरे ताहीं फसह खानु को बंदोबस्त करैं?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ईसु अपने दुई चेलन कै जौ कहकै पनारी: “गाँव मैं जाबौ, और एक आदमी तुमकै पानी से भरो घल्ला उठात भै मिलैगो। तौ बाके पच्छू जात रहियो <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />और बौ जो घर मैं जाबै, बौ घर के मालिक से कहियो: ‘गुरु कही है, कि अलग से बैठन की जघा कहाँ है?’ जोमैं मैं अपने चेलन के संग फसह को खानु खाए सकौं। <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />बौ तुमकै एक सजी सजाई, और सब बंदोबस्त करी भइ ऊपर की एक कुठरिया बताए देगो, बामै हम सबन के ताहीं फसह के खानु की तैयारी करियो।”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />बाके कहेन के मुताबिक चेला नगर मैं आए, और जैसो ईसु कही रहै, बैसोई पाईं; और बौ जघा मैं फसह तैयार करीं।<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />जब संजा भइ, तौ हूँना बारहों चेलन कै लैकै आओ। <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />जब सब बे खानु खान बैठन लगे, तौ ईसु कहेन लागो, “मैं तुमसे सच्ची कहथौं, तुम मैं से एक, जो मेरे संग खानु खाए रौ है, मोकै पकड़बागो।”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />तभई सब चेला निरास हुईगै और पाली-पाली से बासे पूँछन लागे, “का बौ मैं हौं?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />ईसु उनकै जबाब दई, “बौ बारह मैं से एक है, जो मेरे संग थरिया मैं हात डारथै। <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />जैसो इंसान के लौड़ा के बारे मैं लिखो है, बौ हुईकै रहगो; लेकिन कित्तो भयानक बौ आदमी के ताहीं होगो जो मोकै पकड़बागो!”<verse eid="MRK 14:21" /></para>
  <para style="s">प्रभु भोज</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्ती 26:26-30</ref>; <ref loc="LUK 22:14-20">लूका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 कुरिन्थियों 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />जब बे खात रहैं, तौ ईसु रोटी लई, और धन्यवाद की प्रार्थना करकै रोटी तोड़ी, और उनसे कही। लेबौ, “जौ मेरी सरीर है।”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />तौ फिर बौ कटोरा लई और धन्यवाद करकै दई; और सब बामै से पीं। <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />और बौ उनसे कहेन लागो, जौ मेरो वाचा को बौ खून है, “जो सबन के ताहीं बहाओ जाथै। <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />मैं तुमसे सच्ची कहथौं, बौ दिन तक दाखरस नाय पीहौं, जबले परमेस्वर के राज्य मैं नई दाखरस नाय पियौं।”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />फिर बे गीत गात जैतून पहाड़ मैं चले गै।<verse eid="MRK 14:26" /></para>
  <para style="s">पतरस के मुकर जान की भविस्यवाँड़ी</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="LUK 22:31-34">लूका 22:31-34</ref>; <ref loc="JHN 13:36-38">यूहन्ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />तौ ईसु उनसे कही, “तुम सब मोकै छोड़कै भाज जाबैगे, ऐसो सास्त्र मैं लिखो है, ‘मैं बरदिया कै मारंगो, और भेंड़ तितर-बितर हुई जांगी।’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />लेकिन मैं अपने जिंदो होन के बाद तुमसे अग्गु गलील कै जांगो।”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पतरस बासे कहेन लागो, “सबै तोकै छोड़ देमैं लेकिन मैं नाय छोड़ंगो।”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />ईसु बासे कही, “मैं तोसे सच्ची कहथौं, आजै जहे रात मैं मुर्गा के दुई बार बासन के अग्गु, तू तीन बार मोसे मुकर जागो।”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />लेकिन बौ और जोर दैकै कहेन लागो, “अगर मोकै तेरे संग मरन भी पड़ै, तहुँओं कहुए नाय मुकरंगो!” और सबै चेला बासे ऐसिये कहीं।<verse eid="MRK 14:31" /></para>
  <para style="s">गतसमनी मैं ईसु की प्रार्थना</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्ती 26:36-46</ref>; <ref loc="LUK 22:39-46">लूका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />ईसु और बाके चेला गतसमनी नाओं की एक जघा मैं आए, और बौ अपने चेलन से कहेन लागो, “जहे जघा मैं बैठे रहियो जबले मैं प्रार्थना कर लेमौं।” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />और बौ पतरस, याकूब और यूहन्ना कै अपने संग लैकै गौ। फिर बौ बड़ा बेचैन और उदास होन लागो, <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />और बौ उनसे कहेन लागो, “मेरो मन बड़ा बेचैन है, हींना तक की मेरी जान निकरन कै है। तुम हीनैं रुकियो और चौकन्ने रहियो।”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />फिर बौ जरा अग्गु बढ़ो और हूँनै घुपटियाय कै जमीन मैं प्रार्थना करन लागो, कि हुई सकै तौ जौ दुख मेरे ऊपर से हट जाबै। <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />और ऐसे कहेन लागो, “हे परमपिता तोसे तौ सबै कछु हुई सकथै, जौ कटोरा मेरे अग्गु से हटाय दे। तहुँओं जैसो मैं चाहथौं बौ नाय लेकिन जो तू चाहथै बहे होबै।”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />बौ फिर बापस आओ और उनकै सोत भै देखी। और पतरस से कही, “अरे सिमौन, तू का सोए रौ है? तेरे मैं एक घड़ी भी जगन की हिम्मत नाय है? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />जगत और प्रार्थना करत रहियो ताकी तुम परिक्छा मैं ना फसौ। आत्मा तौ तैयार है, लेकिन सरीर तौ कमजोर है।”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />और दुबारा से फिर बापस गौ और बैसिये प्रार्थना करन लागो। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />फिर लौटकै देखी तौ उनकै सोत भै पाई काहैकि उनकी आँखी निंधानि भइ रहैं। तौ उनके पास कछु बोल ना बचे कि हम बाकै का जबाब देमैं।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />तौ तिसरी बार आयकै उनसे कही, “अब तुम सोत रहबौ और सैंतात रहबौ? काहैकि बौ समय आए गौ! देखौ इंसान को लौड़ा पापिन के हाथ पकड़बाओ जाथै। <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />अब उठौ, नेंगौ। देखौ, मेरो पकड़ान बारो मेरे झोने आए चुको है!”<verse eid="MRK 14:42" /></para>
  <para style="s">ईसु को पकड़ो जानो</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="LUK 22:47-53">लूका 22:47-53</ref>; <ref loc="JHN 18:3-12">यूहन्ना 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ईसु जौ कहेतै रहै कि तुरंतै यहूदा इस्करियोती जो बारह चेलन मैं से एक रहै, अपने संग मुखिया पुजारी, यहूदि नियम के सिक्छक और बड़े-बूढ़ेन के घाँईं से एक बड़ी भीड़ तलवार और लठिया लै तुरंतै आए पुगे। <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />बाको पकड़वान बारो उनकै जौ चिताए दई रहै, कि मैं “जो आदमी कै चूमौं बौ बहे होगो। बाकै पकड़कै अपने संग लै जाबौ।”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />और बाके झोने आयकै बासे कहेन लागो, “गुरुजी!” और बाकै प्यार से चूमन लागो। <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />तौ बे ईसु कै तुरंतै धर दबोचीं। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />पर ठाड़ें मैं से एक तुरंतै अपनी तलवार निकारी और बड़ो पुजारी के सेवक के ऊपर चलाई, और बाको एक कान काट दई। <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />ईसु उनसे कहेन लागो, “का तुम डकैत जानकै मोकै पकड़न के ताहीं तलवार और लठिया लैकै निकरे हौ? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />मैं तौ सब दिन मंदिर मैं तुमरे संग रहकै उपदेस देत रहौं, तौ तुम मोकै नाय पकड़े: काहैकि ऐसो जहे ताहीं भौ कि पवित्र सास्त्र की बात पूरी होबै।”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />तभईये बाके संग के सबै चेला बाकै छोड़कै भाज गै।<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />तौ एक ज्वान आदमी नंगी सरीर मैं चद्दर ओढ़े ईसु पच्छू हुई लई; तौ बे आदमी बाकै पकड़न ताहीं कोसिस करीं, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />लेकिन बौ चद्दर छोड़कै, नंगोई भाज पड़ो।<verse eid="MRK 14:52" /></para>
  <para style="s">पंचायत के अग्गु ईसु</para>
  <para style="r">(<ref loc="MAT 26:57-68">मत्ती 26:57-68</ref>; <ref loc="LUK 22:54-55">लूका 22:54-55</ref>; <ref loc="LUK 22:63-71">लूका 22:63-71</ref>; <ref loc="JHN 18:13-14">यूहन्ना 18:13-14</ref>; <ref loc="JHN 18:19-24">यूहन्ना 18:19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />फिर बे ईसु कै बड़ो पुजारी के झोने लैकै गै, और मुखिया पुजारी, यहूदि नियम के सिक्छक और बड़े-बूढ़े बाके दरबार मैं सब जुराए गै। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पतरस उनसे दूर-दूर और पच्छू-पच्छू बड़ो पुजारी के आँगन के भीतर तक चले गौ। और रखबरियन के संग बैठकै आगी तापन लगो। <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />मुखिया पुजारी और पूरी पंचायती ईसु कै मार डारन के ताहीं बाके खिलाप गभाई ढूँड़त रहैं, लेकिन नाय मिलो। <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />निरे बाके खिलाप मैं गलत गभाई देत रहैं, लेकिन उनकी गभाई एक दुसरे से मेल नाय खामैं।<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />तभई कुछ आदमी बाके खिलाप उठकै जौ गलत गभाई दईं। <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“हम जासे जौ बात कहेत सुने हैं, ‘कि मैं अपने हाथ के बनाए भै मंदिर कै उजाड़ दुंगो और तिसरे दिन मैं दुसरो बनाए दुंगो, बौ इंसानन के हाथ को बनो भौ नाय होगो।’” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />जामैं भी उनकी गभाई एक सी नाय बैठी।<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />तौ बड़ो पुजारी सबन के बीच मैं ठाड़कै ईसु से पूँछी; जे सब जनी जो तेरे ऊपर दोस लगाए रै हैं “तैं उनकै कोई जबाब काहे ना देथै?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />लेकिन बौ चुप्पा रहो, और कछु नाय जबाब दई। बड़ो पुजारी बासे फिर पूँछी, “का तू आसीसित परमेस्वर को लौड़ा मसीह है?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ईसु कही, “मैं हौं: और तुम सबै इंसान के लौड़ा कै सर्वसक्तिमान परमेस्वर के दाँए घाँईं बैठो, और आसमान के बादरन संग आत देखैगे।”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />तौ बड़ो पुजारी अपने लत्ता फाड़कै कही, “अब हमकै जाके खिलाप गभन की का जरूरत है?<verse eid="MRK 14:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MRK 14:64" />तुम जौ बदनामी सुने। तुम सबन की का सलाह है?” बे सब बाके खिलाप बोलीं और कहीं जौ तौ कसूरवार है और जाकै मौत की सजा मिलनो चाहिए।<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />तब कोई बाके ऊपर थूकन, और कोई बाको मोहों ढोकैं और बाकै घूँसा मारैं, और बासे कहमैं, “अगर तैं भविस्यवक्ता है तौ बता, तोए कौन मारो!” और रखबरिया भी बाकै पकड़कै चाँटा मारीं।<verse eid="MRK 14:65" /></para>
  <para style="s">पतरस ईसु को इंकार करनो</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />जब पतरस दुआरे आँगन मैं रहै, तौ बड़ो पुजारी की एक सेविका हूँना आई, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />और पतरस कै आगी तापत देखकै बाके घाँईं एक टक भाँदकै देखी और बासे कहेन लागी, “तहूँ तौ बहे ईसु नासरी के संग रहै।”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />लेकिन बौ मुकर गौ, और कहेन लागो, “मैं कछु नाय जानथौं की तू कौनके बारे मैं कह रइ है।” और बाके दुआरे डेहरी मैं आत खिना की मुर्गा बास दई।<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />सेविका बाकै देखकै झोने ठाड़े आदमिन से दुबारा कहेन लागी, जहो तौ उनके संग रहै।<verse eid="MRK 14:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MRK 14:70" />लेकिन पतरस फिर मुकर गौ, थोड़ी देर बाद बे जो बाके झोने ठाड़े रहैं फिर पतरस से कहेन लागे, “सच्ची तहूँ उनमैं से एक है; काहैकि तहूँ गलीली है।”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />लेकिन पतरस धिक्कारन और कसम खान लागो, “मैं बौ आदमी कै जोकी तुम बातचीत कर रै हौ, नाय जानथौं।”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />तभई तुरंतै मुर्गा बास दई। तौ पतरस कै बौ बात जो ईसु बासे कही रहै समक आई, “कि मुर्गा के दुई बार बास देन से अग्गु तैं तीन बार मेरो इंकार करैगो।” और बौ जोर-जोर से रोन लगो।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">ईसु कै पिलातुस के अग्गु ठड़वानो</para>
  <para style="r">(<ref loc="MAT 27:1">मत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">लूका 23:1-5</ref>; <ref loc="JHN 18:28-38">यूहन्ना 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />भोर होतै खिना मुखिया पुजारी, खास बड़े-बूढ़े, यहूदि नियम के सिक्छकन, और पूरी सभा आपस मैं फैसला करीं और ईसु कै बंधबाए कै पिलातुस के हात मैं सौंप दईं।<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />पिलातुस बासे पूँछी, “का तू यहूदिन को राजा है?” ईसु जबाब दई, “तू खुदै बताए रौ है।”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />और मुखिया पुजारी बाके ऊपर निरी बातन को दोस लगात रहे। <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलातुस बासे फिर पूँछी, “तू जबाब काहे ना देथै? देख जे तेरे ऊपर कित्ते बातन को दोस लगाए रै हैं।”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />ईसु फिर कछु जबाब नाय दई; तौ पिलातुस कै बड़ा अचम्मो भौ।<verse eid="MRK 15:5" /></para>
  <para style="s">ईसु कै मौत की सजा को आदेस</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्ती 27:15-26</ref>; <ref loc="LUK 23:13-25">लूका 23:13-25</ref>; <ref loc="JHN 18:39">यूहन्ना 18:39</ref>; <ref loc="JHN 19:16">यूहन्ना 19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />पिलातुस हर फसह के त्योहार मैं कोई एक कैदी कै जोकै लोग चहात रहैं, उनके ताहीं छोड़ देत रहै। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />बरअब्बा नाओं को एक आदमी बे दंगाईयन के संग कैदी रहै, जो दंगा मैं हत्या करी रहैं। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />तौ भीड़ ऊपर जाएकै बासे नहोरे करन लागी, जैसो तू हमरे ताहीं करत आओ है बैसोई कर दे। <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />तौ पिलातुस उनकै जबाब दई, “का तुम जौ चाहथौ कि तुमरे ताहीं यहूदियन के राजा कै छोड़ देयौं?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />काहैकि बौ सब जानत रहै, कि मुखिया पुजारी बाकै धोके से पकड़बाई है।<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />लेकिन मुखिया पुजारी आदमिन कै भड़काईं, और जौ बोलन कै कही कि बौ बरअब्बा कै उनके ताहीं छोड़ देबै। <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />जौ सुनकै पिलातुस उनसे फिर पूँछी, “तौ जोकै तुम यहूदिन को राजा कहथौ, बाको मैं का करौ?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />बे फिर चिल्लाईं, “बाकै क्रूस मैं टँगबाए दे!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />पिलातुस उनसे कही, “काहे? बौ का बुरो काम करी है?” लेकिन भीड़ और जोड़ से चिल्लाए उठी बाकै क्रूस मैं टाँगौ।<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />पिलातुस भीड़ कै सांत करन के ताहीं बरअब्बा कै उनके ताहीं छोड़ दई, और ईसु कै कोड़ा लगबाए कै क्रूस मैं टाँगन ताहीं सौंप दई।<verse eid="MRK 15:15" /></para>
  <para style="s">सिपईय्या ईसु को मजाक उड़ाईं</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />सिपईय्या ईसु कै राज्यपाल के महल के भीतर के आँगन मैं लैगै, और हूँना पूरी पलटन बुलाएकै इखट्टो करीं। <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />तौ बाकै बैंजनी लत्ता पहनाईं और कांटो को मुकुट बनाएकै बाके मूड़ मैं पैंधाय दईं। <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />और बासे जौ कहीं “ओ यहूदियन के राजा तेरी लम्बी उमर होबै!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />और बे बाके मूड़ मैं डंडा मारते, थूकते, और घुपटियाय कै बासे नमस्ते करतै रहे। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />जब बाको बे मजाक उड़ाए चुके, तौ बाके ऊपर से बैंजनी लत्ता उतारकै बहे के लत्ता पहनाए दईं; और फिर बाकै क्रूस मैं टँगलान ताहीं दुआरे लाए कै चल दईं।<verse eid="MRK 15:20" /></para>
  <para style="s">ईसु को क्रूस मैं टाँगो जानो</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="LUK 23:26-43">लूका 23:26-43</ref>; <ref loc="JHN 19:17-27">यूहन्ना 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />सिकन्दर और रूफुस को दऊवा सिमौन, जो एक कुरेनी आदमी रहै, बौ कोई गाँव से आत रहै और बौ बहे रस्ता से गुजरो; तौ बाकै आदमी जबरजत्ती पकड़ लईं ताकी बाको क्रूस उठाएकै पहुँचाए आबै। <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />बे ईसु कै गुलगुता (जाको मतलब खोपड़ी की जघा) मैं लैकै आए। <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />हूँना बे ईसु कै मुर्र मिली भइ दाखरस पिबामैं, लेकिन बौ नाय पी। <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />तौ बे बाकै क्रूस मैं चढ़ाईं, और बाके लत्ता ताहीं परची डारीं फिर आपस मैं बाँट लईं। <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />सुबेरे के नौ बजे रहैं, जब बे बाकै क्रूस मैं टाँगीं। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />और बाके दोसपत्‌र मैं जौ लिखकै बाके ऊपर टाँगो गौ “यहूदियन को राजा।” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />बे बाके संग दुई चुट्टन कै क्रूस मैं टाँगीं, एक कै दहने घाँईं और दुसरो बाके बाँए घाँईं। <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />जौ लेख कि “ईसु अपराधिन संग गिनों गौ” और पूरो भौ।<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">जौ आयत कुछ दस्तावेजन मैं नाय मिलथै </char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />रहामैं आन-जान बारे आदमी अपनो मूड़ हलाए-हलाए कै ईसु की बुराई करत भै जात रहैं, “देखौ! मंदिर कै गिरान बारो और तीन दिन मैं बनानबारो! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />क्रूस मैं से उतरकै अपने आपकै बचा!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />बैसिये मुखिया पुजारी यहूदि नियम के सिक्छक मिलकै बाको मजाक उड़ात भौ कहमैं; “जौ औरन कै बचाई लेकिन अपने आपकै काहे ना बचाए पाई। <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />अब इस्राएल को राजा मसीह क्रूस तरे उतर आबै तौ हम बाके ऊपर बिस्वास करैं।” जिनकै ईसु के संग टाँगीं रहैं, बेऊँ ईसु की बेजती करीं।<verse eid="MRK 15:32" /></para>
  <para style="s">ईसु की मौत</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>; <ref loc="JHN 19:28-30">यूहन्ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />और दुपारी मैं सबै देस मैं अंधियारो छाए गौ और तीन घंटा रहो। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />दुपारी के तीन बजे ईसु जोड़ से चिल्लाए कै कही, “इलोई, इलोई, लमा सबक्तनी?” जाको मतलब है “मेरे परमेस्वर, मेरे परमेस्वर, तू मोकै काहे छोड़ दौ?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />जो बाके झोने ठाड़े रहैं उनमैं से जौ सुनकै कोई कहीं, “देखौ बौ एलिय्याह कै पुकार रौ है।” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />तौ उनमैं से एक दौड़कै बरछा कै सिरका के सोकता मैं डुबाई, और डंडा के सिरा मैं भाँदकै बाकै चुसाय कै बासे कहन लागो, “देखैं, एलिय्याह जाकै क्रूस से तरे उतारन आथै कि ना।”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />तौ ईसु जोड़ से चिल्लाई और ज्यान त्याग दई।<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />मंदिर को परदा ऊपर से तरे ले फटकै दुई टुकड़ा हुई गौ। <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />हूँना बाके अग्गु ठाड़ो कप्तान ईसु कै चिल्लात और ज्यान छोड़त भै देखी, तौ बौ कही, “सच्ची मैं जौ आदमी, परमेस्वर को लौड़ा रहै।”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />बाकै तमान बईंय्यरैं दूर से देखत रहैं, बामै मरियम मगदलीनी, छोटो याकूब और योसेस की अईय्या मरियम और सलोमी रहैं। <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />जब बौ गलील मैं रहै तौ जे बाके पच्छू हुई लेत रहैं; और बाकी सेवा-टहल करत रहैं। औरौ निरी बईंय्यरैं रहैं; जो बाके संग यरूसलेम मैं आई रहैं।<verse eid="MRK 15:41" /></para>
  <para style="s">ईसु को गाड़ो जानो</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="LUK 23:50-56">लूका 23:50-56</ref>; <ref loc="JHN 19:38-42">यूहन्ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />जब संजा खिन हुई गई काहैकि जौ दिन तैयारी को रहै, जौ साबत के एक दिन के अग्गु को रहै। <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />अरिमतियाह को रहेन बारो यूसुफ आओ, और बौ महासभा को मानो भौ मनतरी रहै। और खुद बौ परमेस्वर के राज्य के इंतजार मैं रहै। बौ हिम्मत भाँदकै पिलातुस के झोने गौ और ईसु की लास माँगी। <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />पिलातुस कै अचम्मो भौ की बौ इत्ती जल्दी मर गौ; और बौ सूबेदार कै बुलाएकै पूँछी, कि बाके मरे कित्ती देर भइ है? <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />फिरौंकी बौ सूबेदार से सब खबर लैकै यूसुफ कै ईसु की लास दिबाए दई। <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />तौ बौ एक लीनन को चद्दर लई, और लास कै बामै लिपटाए दई, और एक कबर मैं जो चट्टान मैं खोदी गई रहै धरी, और कबर के मोहोंट मैं एक भारी पथरा ढुरकाय दईं। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />मरियम मगदलीनी और योसेस की अईय्या मरियम देखत रहैं कि बाकै कहाँ धरी हैं।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">ईसु को जिंदो होनो</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती 28:1-8</ref>; <ref loc="LUK 24:1-12">लूका 24:1-12</ref>; <ref loc="JHN 20:1-10">यूहन्ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />जब साबत को दिन बीत गौ, तौ मरियम मगदलीनी, और याकूब की अईय्या मरियम, और सलोमी महाकनबारी चीज मोल लैकै आईं कि आयकै ईसु के सरीर मैं मलकै अभिसेक करैं। <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />इतवार के दिन तड़के भोर, जब दिन निकरतै रहै, तौ बे कबर मैं आईं, <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />बे आपस मैं कहेत रहैं, “हमरे ताहीं कबर के मोहोंट मैं से पथरा कौन ढुरकाबैगो?” काहैकि पथरा निरो बड़ो रहै। <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />तौ हूँना पौहौंच कै देखीं कि पथरा तौ पहले सेई ढुरको भौ है! <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />तौ कबर के भीतर घुसतै, बे एक ज्वान आदमी कै सेतो चोंगा पहने भै दहने घाँईं बैठो भौ देखीं, और बड़ा अचम्मो मैं पड़ गईं।<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />बौ उनसे कही, “अचम्मो मत करौ, तुम ईसु नासरी कै, जो क्रूस मैं टाँगो गौ रहै, बाकै ढूँड़थौ। जिंदो हुई गौ है, हिंयाँ नाय है; जौ बहे ठिया है, जहाँ बाकै धरी रहैं। <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />अब जाबौ, बाके चेलन कै और पतरस कै बताबौ कि बौ तुमसे अग्गु गलील मैं जागो। जैसो बौ तुमसे कही रहै।”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />तौ बे ईसु की कबर से निकरतै भाज लईं; बे थर-थरान लागीं, बे कोईये से कछु नाय कहीं, काहैकि बे सच मैं बड़ा डराय गईं रहैं जाके बाद बे पतरस और सब चेलन कै अपनी गभाई बताईं।<verse eid="MRK 16:8" /></para>
  <para style="s">मरियम मगदलीनी कै ईसु दिखाई दई</para>
  <para style="r">(<ref loc="MAT 28:9-10">मत्ती 28:9-10</ref>; <ref loc="JHN 20:11-18">यूहन्ना 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />ईसु जिंदो होन के बाद इतवार बारे रोज भोर होत खिना, सबन से अग्गु मरियम मगदलीनी जोके भीतर से बौ सात प्रेत आत्मा कै निकारी रहै, बाकै दिखाई दई। <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />बौ जाएकै जौ खबर ईसु के संग बारेन कै सुनाई, जो सोक मैं डूबे रोत रहैं। <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />चेला जौ सुनकै कि बौ ईसु कै जिंदो देखी है, बे बाकी बात मैं बिस्वास नाय करीं।<verse eid="MRK 16:11" /></para>
  <para style="s">ईसु दुई चेलन कै दिखाई दई</para>
  <para style="r">(<ref loc="LUK 24:13-35">लूका 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />जाके बाद ईसु दुई जनी कै दुसरे तराहनी दिखाई दई। जब बे गाँव घाँईं जात रहैं। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />बेऊँ जौ खबर औरन कै बताईं, लेकिन उन्हऊँ को भरोसो नाय करीं।<verse eid="MRK 16:13" /></para>
  <para style="s">ईसु ग्यारह चेलन कै दिखाई देथै</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="LUK 24:36-49">लूका 24:36-49</ref>; <ref loc="JHN 20:19-23">यूहन्ना 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेरितो 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />आखरी मैं जब बे ग्यारह चेला खानु खान बैठे रहैं। तौ ईसु उनकै दिखाई दई, उनके अविस्वास और कर्‌रे मन होन पर समझाई कि बिस्वास करौ। जो बाकै जिंदो होन के बाद देखी रहै, बे उनके ऊपर भरोसो नाय करी रहैं। <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />ईसु उनसे कही, “जाएकै पूरी दुनिया के आदमिन कै जौ सुसमाचार प्रचार करौ। <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />जो बिस्वास करैगो और बपतिस्मा लेगो बाको उद्धार होगो, लेकिन जो बिस्वास नाय करैगो बाकी बुराई करी जागी। <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />बिस्वास करन बारेन मैं जौ चिन्ह होगो कि बे मेरे नाओं से प्रेत आत्मा कै निकारंगे, और नई-नई भासा बोलंगे; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />साँपन कै उठाए लेमंगे, और अगर जहरौ पी लेमैं तहुँओं कछु नुकसान नाय होगो; और बे बिमारन के ऊपर हाथ धरंगे और बे अच्छे हुई जांगे।”<verse eid="MRK 16:18" /></para>
  <para style="s">ईसु कै स्वर्ग मैं उठाओ लौ जाथै</para>
  <para style="r">(<ref loc="LUK 24:50-53">लूका 24:50-53</ref>; <ref loc="ACT 1:9-11">प्रेरितो 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />प्रभु ईसु उनसे बात करन के बाद स्वर्ग के ऊपर उठाए लौ गौ, और परमेस्वर के दहने घाँईं बैठगौ। <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />चेला निकरकै सब जघा ईसु को प्रचार करीं, और प्रभु उनके संग रहकै काम करत रहो, बे चिन्ह चमत्कार के जरिया जो चेलन संग होत रहै, बचन कै मजबूत करत रहो। आमीन।<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>