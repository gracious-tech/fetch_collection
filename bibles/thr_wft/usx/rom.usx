<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Rana Tharu</book>
  <para style="h">रोमियों</para>
  <para style="toc3">रोमियों</para>
  <para style="toc2">रोमियों</para>
  <para style="toc1">रोमियों कै पौलुस की चिट्ठी</para>
  <para style="mt2">रोमियों को कै की चिट्ठी</para>
  <para style="mt1">रोमियों कै पौलुस की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">रोमियों की किताब प्रेरित पौलुस लमसम 54-58 साल मैं ईसु के पैदा होन के बाद लिखी रहै। पौलुस अभैले रोम को दौरा नाय करी रहै, तभईये बौ जौ चिट्ठी मसीहियन कै निर्देस देन के ताहीं यहूदि और गैर-यहूदि कै पनारी। बौ कुरिन्थ सहर से चिट्ठी लिखी रहै, जहाँपै बौ, पहले रहेत रहै। पौलुस जहे ताहीं लिखी ताकी सबै देस ईसु मसीह मैं बिस्वास और आग्या पालन कर सकैं। <char style="xt"><ref loc="ROM 16:26">16:26</ref></char></para>
  <para style="ip">रोमियों की किताब हर जघा और हर समय मसीहियन के ताहीं भौत जरूरी किताब है, काहैकि पौलुस सपा-सपा और अच्छे तरीका से समझाथै कि आपन ईसु मसीह के उद्धार के बारे मैं बताए सकथैं। पौलुस ईसु मसीह के सुसमाचार कै पुराने नियम से भी जोड़ी। कई विद्वानन को कहनो है कि किताब मैं सबसे जरूरी किताब है जो कहथै, <char style="xt"><ref loc="ROM 1:16">1:16</ref> </char>“मोकै सुसमाचार से कोई सरम नाय है, काहैकि जौ सबन के ताहीं परमेस्वर की सक्ति है जो मानथै: पहले यहूदि के ताहीं, फिर गैर यहूदि के ताहीं। ” रोमियों को पहलो भाग<char style="xt"><ref loc="ROM 1-12">1–12</ref></char> गहरो धर्मसास्त्र है और दुसरो भाग<char style="xt"><ref loc="ROM 13-15">13–15</ref></char> मैं मसीह हुई जिंदगी के ताहीं निरे आग्या पालन के निर्देस हैं।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस अपनी चिट्ठी अपनिए बारे मैं बतात भै लिखी, कि बौ कौनकै लिखत रहै। 1:1-15</para>
  <para style="io1">2. जाके बाद बौ ईसु मसीह के जरिया से इंसानन कि हालत और उद्धार के बारे मैं लिखथै। <char style="ior"><ref loc="ROM 1:16-11:36">1:16–11:36</ref></char></para>
  <para style="io1">3. जाके बाद पौलुस मसीह जिंदगी जीन ताहीं कई आग्या पालन को निर्देस देथै। <char style="ior"><ref loc="ROM 12:1-15:13">12:1–15:13</ref></char></para>
  <para style="io1">4. बौ रोम की (16) कलीसिया मैं लोगन कै कई सुभकामनाय दैकै रोमियों कि किताब कै खतम करथै।</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />पौलुस के घाँईं से जो ईसु मसीह को सेवक है, और प्रेरित होन के ताहीं मस्काओ गौ, और परमेस्वर के बौ सुसमाचार के ताहीं अलग करो गौ है।<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />सुसमाचार की प्रतिग्या भौत पहले परमेस्वर अपने भविस्यवक्तन के जरिये करी रहै, जैसो कि पवित्र सास्त्र मैं लिखो है। <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />अपनेई लौड़ा हमरे प्रभु ईसु मसीह के बारे मैं वादा करी है बौ सरीर से तौ राजा दाऊद की पीढ़ी से भौ है। <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />और पवित्रता की आत्मा से भरकै मरे भौ से, जिंदो होन की बजह से सामर्थ्य के संग परमेस्वर को लौड़ा प्रभु ईसु मसीह ठहरो है। <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />बहे की बजह से हमकै दया और प्रेरिताई मिली की बाके नाओं से सबै जाति के लोग बिस्वास करकै बाकी मानैं, <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />जित्ते हैं उन्हऊँ मैं से तुम्हऊँ ईसु मसीह के होन के ताहीं बुलाए गै हौ।<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />बे सबन के जो रोम देस मैं परमेस्वर के प्रिय हैं और पवित्र होन के ताहीं मस्काए गै हैं: आपन के परम दऊवा परमेस्वर और प्रभु ईसु मसीह के घाँईं से तुमकै दया और सांति मिलत रहबै।<verse eid="ROM 1:7" /></para>
  <para style="s">धन्यवाद की प्रार्थना</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />सबसे पहले मैं तुम सबन के ताहीं ईसु मसीह के घाँईं से अपने परमेस्वर कै धन्यवाद करथौं, काहैकि तुमरे बिस्वास की बात पूरी दुनिया मैं हुई रइ है। <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />परमेस्वर जो की सेवा मैं अपनी आत्मा से बाके लौड़ा के सुसमाचार के बारे मैं कहथौं, बहे मेरो गभा है कि मैं तुमकै कैसे करकै हमेसा याद करत रहथौं, <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />और हमेसा अपनी प्रार्थना मैं नहोरे करथौं कि कैसियो करकै अब तुमरे झोने आन ताहीं मेरो सफर परमेस्वर की मरजी से पूरो होबै। <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />काहैकि मैं तुमसे मिलन की इच्छा करथौं, ताकी तुम्हैं ऐसो आध्यात्मिक वरदान को उपहार देमौं जोसे तुम मजबूती से बने रहाबौ; <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />मतलब की जब मैं तुमरे बीच मैं होमौं, तौ हम बौ बिस्वास से जो मेरे मैं है और तुम मैं है, एक दुसरे कै उकसात जामैं।<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />भईय्यौ और बहेनियौ, मैं नाय चाहथौं कि तुम जासे बेखबर रहबौ कि मैं, निरे बार तुमरे झोने आनो चाहो, कि जैसो मोकै दुसरे गैर यहूदि मैं बिस्वास रूपी फल मिलो, बैसिये तुम्हऊँ मैं मिलै, लेकिन हबै ले दिक्कतै आत गईं। <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />मैं यूनानियन और परदेसी, और अकल बारेन और बेअकलिन को कर्जदार हौं। <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />मैं तुम्हऊँ कै जो रोम देस मैं रहथौ, सुसमाचार सुनान के ताहीं कतई तैयार हौं।<verse eid="ROM 1:15" /></para>
  <para style="s">सुसमाचार की ताकत</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />काहैकि मैं सुसमाचार से नाय सरमाथौं,<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="2TI 1:8">2 तीमुथियुस 1:8</ref> </char></note> जहेमारे बौ सबै बिस्वास करन बारेन के ताहीं पहले तौ यहूदि<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">परमेस्वर की चुनी जाति</char></note> फिर यूनानी<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">गैरविस्वासी</char></note> के उद्धार के ताहीं परमेस्वर की सामर्थ्य है। <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />काहैकि सुसमाचार मैं परमेस्वर की धार्मिकता बिस्वास से और बिस्वास के ताहीं दिखाई देथै; जैसो कि लिखो है, “बिस्वास से धर्मी लोग जिंदे रहमंगे।”<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="GAL 3:11">गलातियों 3:11</ref> </char></note><verse eid="ROM 1:17" /></para>
  <para style="s">इंसान को पाप</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />परमेस्वर को गुस्सा उन लोगन की अभक्ति और अधर्म जो स्वर्ग से दिखाई देथै, जो सच्चाई कै अधर्म से दबाय कै रखथैं। <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />परमेस्वर उनकै सजा देगो, काहैकि परमेस्वर को ग्यान उनके मन मैं दिखाई दौ है, और परमेस्वर बाकै दिखाई है। <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />काहैकि परमेस्वर के अनदेखे गुन, मतलब बाकी अनंत सामर्थ्य, और परमेस्वरत्व दुनिया की उत्पत्ति के समय से बाके काम के जरिया देखन मैं आथैं, इसलै उनके झोने कोई उत्तर नाय है। <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" /><note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="EPH 4:17">इफिसियों 4:17</ref>,<ref loc="EPH 4:18">18</ref></char></note>जहे वजह से परमेस्वर कै जानत भै बाके काबिल कोई बड़ाँईं और धन्यवाद नाय करीं, पर बे बेकार बिचार करन लागे, हिंयाँ तक कि उनको र्निबुद्धि मन अंधियारो हुई गौ। <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />बे अपने आपकै अकल बारे जताथैं, पर बे मूर्ख हैं; <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />और अविनासी परमेस्वर की महिमा कै, नास होन बारे इंसान, चिरईंयाँ, जानवर और घिसटन बारे कीरा करमोला की मूर्ति के हानी बदल दईं।<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />जहे बजह से परमेस्वर उनकै उनकी मन की अभिलासा के जरिया असुद्धता ताहीं छोड़ दई कि बे आपस मैं अपनेई सरीर को बुरो करन लगे। <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />काहैकि बे परमेस्वर की सच्चाई कै बदलकै झूठ कर दईं, और जो कुछ परमेस्वर बनाई रहै; बहे की उपासना करीं, ना की बौ बनान बारे की जो हमेसा ताहीं धन्य है! आमीन।<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />तभई परमेस्वर उनकै बेकार इच्छा के वस मैं छोड़ दई; हिंयाँ ले की उनकी बईंय्यरौं जो अपने लोगा संग सम्बंध रखनो चाहिए रहै छोड़कै परायन के संग गलत सम्बंध रखन लागीं। <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />ऐसिये आदमियौं अपनी बईय्यर संग सम्बंध छोड़कै एक दुसरे संग इच्छा मैं जलन लागे। और आदमी-आदमी के संग गलत काम करन लागे। उनकै अपनेई बुरे काम की बजह से बुरो फल मिलन लागो।<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />जब बे परमेस्वर कै नाय पहेचाननो चाँहीं, तौ परमेस्वरौ उनकै उनके निठल्ले मन मैं छोड़ दई कि बे ना करन बारे भी काम करैं। <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />तभईये बे सबै तरहन के अधर्म, दुस्टता, लालच और एक दुसरे को बुरो करन बारे बन गै; और डहान बारे और मारन और लड़न और धोका, और जलन से भर गै। बे चुगल्या, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />और बदनामी करन बारे, परमेस्वर कै अच्छो ना मानन बारे, दुसरेन को आदर नाय करन बारे, अभिमानी, फोकिया, बुरी बात करन बारे, अपने अईय्या-बाबा को कहनो नाय मानन बारे; <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />बेअकली, भरोसो तोड़न बारे, प्यार ना करन बारे और दया ना करन बारे हुईगै हैं। <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />बे तौ परमेस्वर की जौ नियम जानथैं, कि ऐसे-ऐसे काम करन बारे मौत की सजा के लायक हैं, तहुँओं बे ऐसो काम करथैं, बल्किन करन बारेन कै बढ़ावा देथैं।<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">परमेस्वर को फैसला</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />मेरे भईय्यौ, का तुम दुसरेन के ऊपर दोस लगाथौ? तुमरे झोने कोईये बहाना नाय है, तुम चाँहे जो होबौ; जब तुम दुसरेन को फैसला, और फिर बहे काम करथौ, जो बे करथैं, तौ तुम खुद को तिरस्कार करथौ। <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />और हम जानथैं ऐसे-ऐसे काम करन बारेन के ऊपर परमेस्वर घाँईं से सच्चे सजा की आग्या होथै। <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />लेकिन तुम, मेरे भईय्यौ, बेईं चीजन कै करथौ जिनके ताहीं तुम दुसरेन ऊपर फैसला सुनाथौ, का तुमकै लगथै कि तुम परमेस्वर के फैसला से बच जागे? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" /><note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="ROM 11:23">11:23</ref></char></note>का तैं बाकी दया, और सकारन, और तसल्ली रूपी धन कै तुच्छ जानथै, का जौ नाय समझथै कि परमेस्वर की भलाई तेरो मन फिरान कै सिखाथै। <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />पर अपने हठीले और जिद्दी मन के बजह से, परमेस्वर के न्याय के दिन ताहीं, अपनी सजा कै और बढ़ात जायरै हौ। <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />परमेस्वर सबन कै उनके करमन के हिसाब से फल देगो। <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />जो अच्छे कामन मैं टिके रहकै इज्जत और आदर, और अमरता कै ढूँड़ रै हैं, उनकै बौ अनंत जिंदगी देबैगो; <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />लेकिन जो मतलबी हैं, और सच्चाई कै नाय मानकै अधर्म के पच्छू चलथैं, उनके ऊपर गुस्सा और परमेस्वर को परकोप पड़ैगो। <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />और कलेस और भीतरी परेसानी सब इंसान की ज्यान ऊपर आमंगी, अग्गु यहूदि ऊपर फिरौंकी यूनानी ऊपर; <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />पर महिमा और आदर और सांति सबन कै मिलैगी, जो भलाई करथैं, अग्गु यहूदि कै फिरौंकी यूनानिन कै। <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />काहैकि परमेस्वर कोई को भेद-भाव ना करथै।<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />तभईये जो बगैर नियम पाए पाप करीं, बे बिना नियम के खतमौं हुई जांगे और जो नियम पाएकै पाप करीं, उनकै सजा भी नियम से मिलैगी। <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />काहैकि परमेस्वर के झोने नियम के सुनन बारे धर्मी नाय हैं, लेकिन नियम कै मानन बारे धर्मी होमंगे। <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />फिर जब गैर यहूदि के लोग जिनके झोने नियम हइयें नाय, अपने आप से नियम की बातन कै मानथैं तौ बे अपने आप मैं नियम हैं। <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />बे नियम की बात अपने-अपने मन मैं लिखी भइ दिखाथै और उनके दिल गभाई देथैं, और उनकी सोच एक दुसरे ऊपर दोस लगाथैं या उन्हईं कै बेगुनाह ठहराथैं। <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />एक दिन आगो परमेस्वर मेरे सुसमाचार से ईसु मसीह के घाँईं से इंसान की लुकी बातन को फैसला करैगो।<verse eid="ROM 2:16" /></para>
  <para style="s">यहूदि लोग और उनके नियम</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />का तैं यहूदि है? और नियम मैं भरोसो रखथै, और परमेस्वर के बारे मैं गरब करथै, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />और परमेस्वर की इच्छा जानथै और नियम की सिक्छा की परख पाएकै अच्छी-अच्छी बातन कै प्रिय मानथै; <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />और अपने ऊपर भरोसो रखथै कि मैं तौ अंधरन कै चलान बारो, और अंधियारे मैं पड़े भैन कै, उजीतो देन बारो, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />और बगैर बुद्धि बारेन कै सिखान बारो, और बालकन को उपदेसक हौं; और ग्यान, और सच्चाई को नमूना जो नियम मैं है मोकै मिलो है। <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />तौ का तैं जो दुसरेन कै सिखाथै, अपने आपकै नाय सिखाथै? “कि चोरी मत करियो” को उपदेस देथै, खुदै चोरी करथै? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />तैं तौ ऐसियौ कहथै, “व्यभिचार मत करियो,” का खुदै व्यभिचार करथै? तैं जो मूर्तियन कै घिनौनाे मानथै, का खुदै मंदिरन कै लूटथै? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />तैं जो नियम मैं गुमान करथै, का नियम कै नाय मानकै परमेस्वर को अनादर करथै? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />“काहैकि तुमरे बजह से गैर यहूदि मैं परमेस्वर के नाओं कै बुरो-भलो कहो जाथै,” जैसो कि लिखो है।<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />अगर तैं नियम कै मानै तौ, खतना<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">लौड़ा बालका के मूतन बारी रस्ता के ऊपर की कुछ खाल काटकै हटानो “खतना” है और खतना यहूदि होन को निसान रहै</char></note> से फायदा तौ है; अगर तैं नियम कै नाय मानै, तौ तेरो खतना बगैर खतना सो है। <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />अगर दुसरी जाति जिनको खतना नाय भौ है, और नियम के आदेसन कै मानथै, का परमेस्वर बाको खतना ना करैगो काहैकि बाको खतना करो गौ रहै? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />और तभई तुम यहूदियन कै, दुसरी जाति के जरिया बुराई करबाई जागी काहैकि तुम नियम तोड़न को अपने आप मैं फैसला कर लेथौ, भलेई तुम जाकै लिखे होबौ और खतना करे होबौ; पर बे नियम को पालन करथैं, भलेई बे सारीरिक रूप से खतना नाय करी हैं। <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />आखिर असली यहूदि कौन है, सच्ची मैं खतना? जौ बौ इंसान नाय है जो बाहर से दिखावटी यहूदि हैं, जोको खतना एक सारीरिक चीज है। <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" /><note caller="+" style="x"><char style="xo" closed="false">2:29 </char><char style="xt" closed="false"><ref loc="DEU 30:6">व्यवस्थाविवरन 30:6</ref></char></note>बल्किन, सच्चो यहूदि बहे है जो भीतर से यहूदि है, बौ जोके दिल को खतना भौ है, और जौ परमेस्वर की आत्मा को काम है, लिखित नियम को नाय। ऐसो आदमी परमेस्वर से खुसी हासिल करथै, इंसान से नाय।<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />का यहूदियन कै गैर यहूदि से फायदा भौ है? या खतना को का मोल रहगौ? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />सब तरहन से भौत कुछ! सबसे पहले परमेस्वर को उपदेस बिस्वास करकै तौ उन्हईं कै सौंपो गौ रहै। <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />अगर उनमैं से एकाद वफादार ना होमैं तौ का होगो? का जाको मतलब जौ है कि परमेस्वर वफादार ना होगो? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />कतई नाय! पर परमेस्वर सच्चो है और सबै इंसान को न्याय होगो, जैसे कि लिखो है,</para>
  <para style="q1" vid="ROM 3:4">“जब तुम बोलथौ तौ तुमकै सई से बोलनो चहाईये;</para>
  <para style="q2" vid="ROM 3:4">और जब तुमरे ताहीं कोसिस करी जात होबै तौ तुमकै अपनो मुकदमा जीतनो चहाईये।”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />पर अगर हमरो अधर्म परमेस्वर की धार्मिकता होथै, तौ हम का कह सकथैं? का जौ कहमैं की परमेस्वर सजा देथै तभईये गुस्सा करथै? जौ तौ मैं इंसानन के जैसी कहथौं। <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />कतई नाय! नाय तौ परमेस्वर कैसे दुनिया को फैसला करैगो?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />पर का होगो अगर मेरो झूठ बाकी सच्चाई कै और जद्धे सपा तरीका से बनाये कै परमेस्वर की महिमा को काम करथै? तौ फिर काहे पापी के हानी मैं सजा के काबिल मानो जाथौं? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />“काहे ना कहे, तौ हमैं बुराई करन दियौ ताकी अच्छाई आबै?” कुछ लोग, सच्ची मैं मेरे ऊपर जौ बात कहेन को दोस लगाएकै मेरो अपमान करी हैं! उनकी बुराई करी जागी, जैसी उनके संग होनो चाहिए।<verse eid="ROM 3:8" /></para>
  <para style="s">कोईये आदमी धर्मी नाय हैं</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />तौ फिर का भौ? का हम यहूदि गैर यहूदियन से अच्छे हैं, नाय कतईये नाय! काहैकि हम जौ दिखाए दै हैं कि चाँहे यहूदि होमैं, चाँहे गैर यहूदि सबै पाप के वस मैं हैं। <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />जैसो सास्त्र मैं लिखो है:</para>
  <para style="q1" vid="ROM 3:10">“कोई धर्मी नाय हैं, एकौ नाय हैं।<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />कोई भी समझदार नाय हैं,</para>
  <para style="q2" vid="ROM 3:11">कोईये परमेस्वर कै ढूँड़न बारे नाय हैं।<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />सबै परमेस्वर से दूर हुईगै हैं; बे सब गलत हुईगै हैं;</para>
  <para style="q2" vid="ROM 3:12">कोई भलाई करन बारो नाय है।</para>
  <para style="q2" vid="ROM 3:12">कोइयो सई नाय है, एकौ नाय।<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />उनके बोल चोट पहोंचान बारे कपट से भरे कबर हैं;</para>
  <para style="q2" vid="ROM 3:13">बे अपनी जीभ से छल कपट करीं हैं,</para>
  <para style="q2" vid="ROM 3:13">उनके ओंठन मैं साँपन को जहर है।<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="PSA 5:9">भजन संहिता 5:9</ref>; <ref loc="PSA 140:3">140:3</ref></char></note><verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />उनको मोहों बद्‌दुअन और करुआंन बारी बातन से भरो है।<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="PSA 10:7">भजन संहिता 10:7</ref></char></note><verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />उनकी टाँग खून बहान ताहीं तैयार हैं,<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />उनके रस्ता मैं नास और कलेस है।<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />बे सांति को रस्ता नाय जानीं हैं,<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />उनकी आँखी अग्गु परमेस्वर को डर हईये नाय।”<note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="PSA 36:1">भजन संहिता 36:1</ref></char></note><verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />हम जानथैं कि नियम जो कछु कहथै उन्हईं से कहथै, जो नियम मैं चलथैं; तभईये कि सबन को मोहों बंद करो जाबै और पूरी दुनिया परमेस्वर की सजा पान कै ठहरै, <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />काहैकि कोई कै नियम की जरूरत के अनुसार कोई इंसान परमेस्वर की नजर मैं सई नाय रखो गौ है; नियम जो करथै बौ हमैं जौ बतान के ताहीं की हम पाप करे हैं।<note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 143:2">भजन संहिता 143:2</ref></char></note><verse eid="ROM 3:20" /></para>
  <para style="s">बिस्वास के जरिये धर्मी मानो जानो</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />लेकिन अब परमेस्वर की धार्मिकता के जरिया आदमिन कै अपने संग रखन को तरीका सामने आओ है। जाको नियम से कोई लेनो देनो नाय है, हालाकि मूसा को नियम और भविस्यवक्ता जाकी गभाई दईं हैं। <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" /><note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातियों 2:16</ref> </char></note>मतलब जौ कि, परमेस्वर की बौ धार्मिकता जो ईसु मसीह मैं बिस्वास करन से सबै बिस्वास करन बारेन ताहीं है, काहैकि कछु चीज को भेद-भाव हईये नाय: <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />तभईये सबै पाप करीं हैं और परमेस्वर की महिमा से दूर हैं, <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />लेकिन बाकी दया और बाके छुटकारा से जो ईसु मसीह मैं है, सेंत-मेंत मैं धर्मी हुई जाथैं, <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />बाकै परमेस्वर ईसु के खून के बजह से ऐसो पछताबा करबाई, जो बिस्वास करन सेई होथै, कि जो पाप पहले करे गै और जिनके ऊपर परमेस्वर बरदास करन की बजह से ध्यान नाय दई। उनके बारे मैं बौ अपनी धार्मिकता दिखाई है। <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />ऐसे करकै परमेस्वर दिखाथै कि बौ खुद धर्मी है और जो कोई ईसु पर बिस्वास करथै, बाकै बौ सई ठहराथै।<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />तौ घमंड करनो रहुए नाय? बाकी तौ जघा हईये नाय! कौन से नियम से? का करमन के नियमन से? नाय, बल्किन बिस्वास के नियम से। <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />काहैकि हम जौ नतीजा मैं पहोंचे हैं कि एक आदमी कै बिस्वास के जरिया परमेस्वर के संग धर्मी मानो जाथै, और ऐसो करन से नाय कि नियम का कहथै। <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />का परमेस्वर सिरफ यहूदियन को है? का गैर यहूदिन को नाय है? हाँ, गैर यहूदिन को भी है। <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" /><note caller="+" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="DEU 6:4">व्यवस्थाविवरन 6:4</ref>; <ref loc="GAL 3:20">गलातियों 3:20</ref></char></note>काहैकि एकै परमेस्वर है, और बौ अपने बिस्वास के आधार मैं खतना करान बारे यहूदियन कै अपने संग रखैगो, और गैर यहूदिन कै उनके बिस्वास के जरिया धर्मी ठहरागो। <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />का जाको मतलब जौ है कि जौ बिस्वास से हम नियम को पालन करथैं? नाय, कतई नाय; जाके अलावा, हम नियम कै बनाये रखाथैं। बल्किन नियम कै निठाठौर एकै जघा रखथैं।<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">अब्राहम को उदाहरड़</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />तौ हम का कहमैं, कि हमरे सारीरिक दऊवा अब्राहम? बाको अनुभव का रहै? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />अगर अब्राहम परमेस्वर के संग सई काम करथै, बाके पास घमंड के ताहीं कुछ होगो लेकिन परमेस्वर की नजर मैं नाय। <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" /><note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GEN 15:6">उत्पत्ति 15:6</ref>; <ref loc="GAL 3:6">गलातियों 3:6</ref></char></note>पवित्र सास्त्र का कहथै? जौ कि “अब्राहम परमेस्वर ऊपर बिस्वास करी, और बाके बिस्वास के बजह से परमेस्वर बाकै धर्मी के रूप मैं अपनाई।” <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />काम करन बारे आदमी कै दिहाड़ी देनो दान ना होथै, लेकिन बाको अधिकार होथै। <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />पर जो काम ना करथै बल्किन बिना काम के धर्मी ठहरान बारे ऊपर बिस्वास करथै, बाको बिस्वास बाके ताहीं धार्मिकता गिनो जाथै। <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />दाऊद को जौ मतलब है कि जब बौ आदमी कि खुसी की बात करथै जोकै परमेस्वर धर्मी के तराहनी अपनाथै, जाके अलावा बौ आदमी जो कुछ भी करथै:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“धन्य हैं बे जिनके अधर्म माफ हुईगै,</para>
  <para style="q2" vid="ROM 4:7">और जोके पाप ढोंक दै गै।<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />धन्य है बौ इंसान जोकै प्रभु पापी नाय मानै!”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />तौ जौ खुसी की दाऊद सिरफ खतना करन बारेन से जुड़े होन कि बात करी रहै? सच मैं नाय! जाको सम्बंध बे आदमिन से भी है जिनको खतना ना भौ है। काहैकि पवित्र सास्त्र मैं लिखो है “अब्राहम परमेस्वर के ऊपर बिस्वास करी और परमेस्वर बाकै धर्मी मानी।” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />तौ अब्राहम कैसे गिनो गौ? खतना हानी नाय लेकिन बगैर खतना हानी गिनो गौ। <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />बौ खतना को चिन्ह पाई कि बौ बिस्वास की धार्मिकता ऊपर मुहर हुई जाबै, जो बौ बगैर खतना के हानी रहै, जोसे बौ सबन को बाबा होबै जो बगैर खतना हानी बिस्वास करथैं ताकी बेऊँ धर्मी होमैं; <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />और बौ खतना करे भौ को बाबा होबै, जो नाय तौ सिरफ खतना करे भै हैं, पर हमरे बाबा अब्राहम के बौ बिस्वास की पटक मैं चलथैं जो बौ बगैर खतना के हानी करी रहै।<verse eid="ROM 4:12" /></para>
  <para style="s">परमेस्वर को वादा बिस्वास के जरिये मिलथै</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:13 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 17:4-6">उत्पत्ति 17:4-6</ref>; <ref loc="GEN 22:17">22:17</ref>,<ref loc="GEN 22:18">18</ref>; <ref loc="GAL 3:29">गलातियों 3:29</ref> </char>
    </note>परमेस्वर जो अब्राहम से वादा करी रहै कि दुनिया को वारिस होगो, ना तौ अब्राहम कै, ना तौ अब्राहम मूसा के नियम के मानन के जरिये, बल्किन बिस्वास के जरिये अब्राहम धर्मी मानो गौ रहै। <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" /><note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="GAL 3:18">गलातियों 3:18</ref></char></note>काहैकि अगर नियम बारे वारिस हैं, तौ बिस्वास बेकार और वादा बिना फल को है। <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />नियम परमेस्वर के गुस्सा कै कम करथै, पर जहाँ नियम नाय है, नियम की कोई आग्या ना मानथै।<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:16 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:7">गलातियों 3:7</ref>
      </char>
    </note>और जहे बजह से वादा बिस्वास और अनुग्रह मैं आधारित रहै, ताकी वादा कै अब्राहम के सबै बंसज के ताहीं परमेस्वर के मुफ्त उपहार के रूप मैं पक्को करनो चाहिए सिरफ बे आदमिन के ताहीं नाय जो नियम को पालन करथैं, पर बे आदमिन के ताहींयों जो अब्राहम के जैसी मानथैं काहैकि अब्राहम हम सबन को आत्मिक दऊवा है; <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" /><note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="GEN 17:5">उत्पत्ति 17:5</ref></char></note>जैसो कि सास्त्र मैं लिखो है, “मैं तोकै भौत से देसन को दऊवा बनाओ हौं।” परमेस्वर की नजर मैं अब्राहम हमारो दऊवा है। बे बौ परमेस्वर मैं बिस्वास करीं, जो मरे भैन कै जिंदो करथै और जोकी आग्या अस्तित्व मैं लाथै, जो की अस्तित्व मैं रहिये नाय। <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" /><note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="GEN 15:5">उत्पत्ति 15:5</ref> </char></note>अब्राहम निरासा मैं भी आसा धरकै बिस्वास करी, हिंयाँ ले कि जब उमीद के ताहीं कोई कारड़ नाय रहै, और तभईये “निरे देसन को बाबा बन गौ।” जैसी सास्त्र कहथै, “तेरो बंसज तारा जित्तो होगो।” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" /><note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="GEN 17:17">उत्पत्ति 17:17</ref></char></note>बौ जब सौ साल को रहै, पर बाको बिस्वास बौ समय कमजोर ना पड़ो जब बौ अपने सरीर के बारे मैं सोची, जो पहलिये से बहार से मरो भौ रहै, या जौ बात से कि सारा को बालका ना हुई सकथै। <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />और ना कहुए बगैर बिस्वास के बाके वादा ऊपर संका करी, लेकिन बिस्वास मैं टिको रहो; बाको बिस्वास बाकै सक्ति से भर दई, और बौ परमेस्वर की महिमा करी। <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />और बाकै पूरो यकीन रहै कि परमेस्वर जो वादा करी रहै, बौ पूरो करैगो। <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />जहे बजह है कि अब्राहम, बिस्वास से, “परमेस्वर के जरिया धर्मी हुईकै गिनो गौ।” <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />और जहे बचन, “बिस्वास बाके ताहीं धार्मिकता गिनो गौ,” ना सिरफ बहे के ताहीं लिखो गौ। <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />बेऊँ हमरे ताहीं लिखे गै रहैं जिनकै धर्मी के रूप मैं अपनाओ जाने है, जो बाके ऊपर बिस्वास करथै जो हमारे प्रभु ईसु कै मौत से जिंदो करी। <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />हमरे पापन के बजे से बाकै मरन कै दौ गौ रहै, और बौ हमैं जिंदगी देन के ताहीं उठाओ गौ रहै ताकी हम परमेस्वर के संग सई करे जामैं।<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">परमेस्वर के संग सई है</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />अब जब हमकै बिस्वास के जरिये परमेस्वर के संग सई से रखो गौ है, तौ हम अपने प्रभु ईसु मसीह के जरिया से परमेस्वर के संग सांति रखथैं। <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />जोके जरिया बिस्वास के बजह से बौ अनुग्रह तक, जोमैं हम बने हैं, हमरी पहोंचो भइ, परमेस्वर की महिमा! और आसा मैं घमंड करैं। <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />सिरफ जहे नाय, बल्किन हम कलेसनौं मैं गरब करैं, जौ जानकै की कलेस से धीरज, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />और धीरज से खरो निकरनो, और खरो होन से आसा मिलथै। <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />और जौ आसा हमकै उदास नाय करथै, काहैकि पवित्र आत्मा जो हमकै दई गौ है बासे परमेस्वर को प्यार हमरे मन मैं डार दौ गौ है।<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />जब हम हबऊ बगैर सहारा के रहैं, मसीह बौ समय पापिन के ताहीं मर गौ जोकै परमेस्वर चुनी रहै। <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />अगर कोई इंसान धर्मी के ताहीं मरै; जौ अनहोनो है। और कोई अच्छे इंसान ताहीं ऐसियौ तौ होबै जो मरन की हिम्मतौ करै। <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />लेकिन परमेस्वर अपने प्यार की भलाई ऐसे करकै दिखाथै कि जब हम पापियै रहैं तभई मसीह हमरे ताहीं मरो! <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />अब जब हम बाके खून से धर्मी हिये गै हैं, तौ बैसिये परमेस्वर के गुस्सौ से काहे नाय बचंगे! <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />हम परमेस्वर के दुस्मी रहैं, लेकिन बौ हमैं अपने बालक की मौत के जरिया अपनो दोस्त बनाई। अब जब हम परमेस्वर के दिलबर हैं, हम मसीह की जिंदगी से कित्तो बचंगे! <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />लेकिन ऐसो कतई नाय है; हमरे प्रभु ईसु मसीह के जरिया परमेस्वर जो कछु करी है, बाके बजह से हम खुस होथैं, जो अब हमैं परमेस्वर से मेल-मिलाप करबाई है।<verse eid="ROM 5:11" /></para>
  <para style="s">आदम<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">परमेस्वर को बनाओ भौ पहलो इंसान</char></note> और मसीह</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />ऐसिये जैसे एक इंसान से पाप जौ दुनिया मैं आओ, और पाप से मौत आई, और ऐसे करकै मौत सबै इंसानन मैं फैल गई, काहैकि सबै पाप करीं।<note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="GEN 3:6">उत्पत्ति 3:6</ref> </char></note> <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />हींना दुनिया मैं नियम दौ जान से पहले पाप रहै; लेकिन जहाँ नियम नाय है, कोई भी खाता पापन को नाय है। <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />पर आदम के समय से मूसा के समय ले, मौत सबै इंसानन ऊपर राज्य करी, हिंयाँ ले कि बे आदमिन ऊपर भी, जो आदम परमेस्वर की आग्या ना मानी रहै बैसिये पाप नाय करी। आदम जो आनबारो रहै बहो को एक आँकड़ा रहै। <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />लेकिन जो हाल गलतियन को है, बौ हाल अनुग्रह के वरदान को हईये नाय, काहैकि जब एक इंसान के अपराध से निरे इंसान मरे, तौ परमेस्वर की अनुग्रह और बाको जौ दान एक इंसान के, मतलब ईसु मसीह के, अनुग्रह से भौ, भौत से लोगन ऊपर सच्चियै मैं खूबै-खूब भौ। <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />और परमेस्वर के उपहार और एक आदमी के पाप के बीच अंतर है। एक पाप के बाद “दोसी” को न्याय के काम को फैसला आओ; पर इत्ते सारे पापन के बाद, “कोई दोसी नाय है उपहार आथै!” <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />जौ सच है कि एक इंसान के पाप के जरिये मौत बौ एक इंसान के बजह से राज्य करन लगी। लेकिन जो एक आदमी, ईसु मसीह करी, बाको फल कितनो बड़ो है! बे सबै जो परमेस्वर को गजब अनुग्रह कै पाथैं और बाके संग स्वतंत्‌र ऊपर से न्याय पाथैं, मसीह के जरिये जिंदगी मैं राज करंगे।<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />तभई, एक अपराध सब इंसानन के ताहीं सजा की आग्या को बजह बनो, बैसिये एक धर्म को काम सब आदमिन के जिंदगी के ताहीं, धर्मी को बजह बनो। <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />और जैसी सब आदमिन कै पापी बनाओ गौ रहै, बैसिये एक आदमी की आग्या के कारड़, बैसिये बे सबै एक आदमी के आग्या मानन के फलस्वरूप परमेस्वर के संग धर्मी हुई जांगे।<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />नियम जो रहै बीच मैं आए गौ कि अपराध भौत होबै, पर जितै पाप खूबै भौ हुँआँ परमेस्वर को अनुग्रह बहो से जाधे भौ, <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />तौ फिरौंकी, जैसी पाप मौत कै फैलात भै राज करी, बैसिये हमरे प्रभु ईसु मसीह से अनुग्रह भी अनंत जिंदगी के ताहीं धर्मी होत भै राज करै।<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">पाप के ताहीं मरनो और परमेस्वर के ताहीं जिंदो होनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />तौ हम का कहमैं? का हम पाप करत रहमैं, कि परमेस्वर को अनुग्रह खूबै होबै? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />कतईये नाय! हम जब पाप के ताहीं मर गै तौ फिर अग्गु कै बामै जिंदगी कैसे करकै बितामैं? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />का तुम नाय जानथौ, कि हम जित्ते ईसु मसीह को बपतिस्मा लै हैं, तौ बाके मरन को बपतिस्मा लै हैं। <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" /><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 2:12">कुलुस्सियों 2:12</ref> </char></note>सो बाके मौत को बपतिस्मा पाए लेन से हम बाके संग गड़ार दै गै, ताकी जैसे मसीह परमपिता की महिमा से मरे भै मैं से जिंदो करो गौ, बैसिये हमउँ नई जिंदगी की चाल चलैं।<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />काहैकि अगर हम बाके मौत से बाकी समानता मैं हुईगै हैं, तौ जैसे बौ जिंदो हुई गौ बैसिये हमउँ जिंदे हुई जांगे। <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />और हम जानथैं की हमरो पुरानो चाल-चलन बाके संग क्रूस मैं चढ़ाय दौ गौ, ताकी पाप को सरीर बरबाद हुई जाबै, और हम अग्गु कै पाप की गुलामी मैं नाय रहमैं। <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />काहैकि जो मर गौ, बौ पाप से छुटकै धर्मी ठहरो। <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />तौ अगर हम मसीह के संग मर गै, तौ हमरो बिस्वास जौ है कि बाके संग हम जीमंगे भी। <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />काहैकि हम जौ जानथैं मसीह मरे भै मैं से जिंदो भौ फिर दुबारा मरन बारो हईये नाय; बाके ऊपर मौत राज्य कहु नाय करैगी। <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />और तभई, काहैकि बौ मर गौ, पाप की बाके ऊपर कोई सक्ति नाय है; और अब जिंदो है तौ सिरफ परमेस्वर के ताहीं जिंदो है। <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />ऐसिये तुम्हऊँ अपने आपकै मरो भौ समझथौ, जहाँ ले पाप को सबाल है, लेकिन मसीह ईसु के जरिया परमेस्वर के संग संगती मैं जिंदे रहियो।<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />अब पाप तुमरे खतम होन बारे सरीर मैं राज्य ना करै, ताकी तुम अपने प्राकृतिक सरीर की इच्छन को पालन ना कर सकौ। <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />और ना अपने सरीर के कोई भी हिस्सा कै अधर्म को हथियार होन के ताहीं पाप कै सौपौं, पर खुदकै मरे भै मैं से जिंदो करो गौ जानकै परमेस्वर कै सौंपौ, और अपने सरीर के एक-एक हिस्सा कै धर्मी को हथियार होन के ताहीं परमेस्वर कै सौंपौ। <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />पाप तुमरो मालिक ना होनो चाहिए; काहैकि तुम नियम के तहत नाय; बल्किन परमेस्वर के अनुग्रह और किरपा के अधीन रहथौ।<verse eid="ROM 6:14" /></para>
  <para style="s">धर्म को गुलाम</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />तौ का भौ? का हम जहे के मारे पाप करैं कि हम नियम के अधीन नाय बल्किन अनुग्रह के अधीन हैं? कतईये नाय! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />का तुम ना जानथौ, कि जो कि आग्या मानन ताहीं तुम अपने आपकै दास के हानी सौंप देथौ बहे के दास हौ: और जोकी मानथौ, चाँहे पाप के, जोको अंत मौत है, या चाँहे आग्या मानन बारे होमैं जोको अंत धार्मिकता है, जोके फलस्वरूप परमेस्वर के संग सई करो जाएरौ है। <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />लेकिन परमेस्वर को धन्यवाद होबै! हालाकि एक समय तुम पाप के दास रहौ, तुम जो कछु पढ़ाए, बामै मिली सच्चाईयन कै अपने दिल से माने। <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />और पाप से छुड़ाय जाएकै धर्म के गुलाम हुईगै हौ। <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />मैं तुमरे सरीर की कमजोरी के बजह से इंसान की रीत मैं कहथौं। जैसे तुम अपने सरीर के अंग कै असुद्ध करन के ताहीं अधर्म के बजह से गुलाम बनाए दै रहौ, बैसिये अब अपने सरीर के हिस्सन कै पवित्रता के ताहीं धर्मी के दास करकै सौंप देबौ।<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />जब तुम पाप के दास रहौ, तौ बौ समय धार्मिकता से आजाद रहौ। <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />अब जो-जो बातन से तुम सर्माथौ, बौ समय उनसे का फल पात रहौ? काहैकि उनके अंत मैं तौ मरनोई लिखो है! <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />लेकिन अब तुम पाप से छुटकै और परमेस्वर के दास हौ। तुमरो फायदा पूरे तरीका से बाकै सौंपो भौ जीवन है, और जाको नतीजा अनंत जिंदगी है। <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />पाप कि मजदूरी तौ मौत है, लेकिन परमेस्वर को वरदान हमरे प्रभु मसीह ईसु मैं अनंत जिंदगी है।<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">सादी सुदा जिंदगी की कहानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />हे भईय्यौ और बहेनियौ, का तुम नाय जानथौ मैं नियम के जानन बारेन से कहथौं कि जबले इंसान जिंदो रहथै, तौले बाके ऊपर नियम को राज्य रहथै। <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />काहैकि सादी सुदा बईय्यर, नियम के आधार मैं अपने आदमी के जीते जी बासे भँदी है, पर अगर बाको आदमी खतम हुई जाबै, तौ बौ अपने लोगा के नियम से छुट गई। <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />तभई अगर, आदमी के जीते जी बौ कोई पराए आदमी की हुई जाबै, तौ बौ छिनरइ कही जाबैगी, लेकिन अगर आदमी खतम हुई जाबै, तौ बौ नियम से छुट गई, हिंयाँ तक कि अगर कोई पराए आदमी की हुई जाबै तौ तहुँओं छिनरइ नाय मानी जागी। <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />बैसिये मेरे भईय्यौ और बहेनियौ, तुम्हऊँ मसीह के सरीर से नियम के ताहीं मरे भै हुईगै, कि बे दुसरेन के हुई जाबौ, जो मरे भौ मैं से जिंदो हुई गौ: ताकी हम परमेस्वर के ताहीं फल लामैं। <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />काहैकि जब हम सारीरिक रहैं, तौ पापन की इच्छा जो नियम के जरिया रहै, मरन को फल देन ताहीं हमरे सरीर के अंगन मैं काम करत रहैं। <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />अब, हालाकि जोके बंधन मैं हम भँदे रहैं बाके ताहीं मर कै, अब नियम से ऐसे करकै छुट गै, कि लिखी भइ पुरानी रीत मैं नाय, बल्किन आत्मा की नई रीत से।<verse eid="ROM 7:6" /></para>
  <para style="s">नियम और पाप</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:17">निर्गमन 20:17</ref>; <ref loc="DEU 5:21">व्यवस्थाविवरन 5:21</ref></char>
    </note>तौ हम का कहमैं? फिरौंकी का नियमै पापी है? कतईये नाय! बल्किन बगैर नियम के मैं पाप कै जानिए ना सकथौं। अगर नियम कहतो कि “जो कोई और कोई को है बाकी इच्छा मत करै,” तौ मैं ऐसी इच्छा कै जानतोई नाय। <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />लेकिन बौ आग्या के जरिया पाप मेरे मैं सबै तरह की लालची इच्छन कै जगान को मौका पाई। काहैकि बगैर नियम के तौ पाप मरो भौ है। <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />मैं तौ पहले बगैर नियम के जिंदो रहौं लेकिन जब आग्या मिली, तौ पाप जी गौ, और मैं मर गौ। <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />और बहे आग्या जो मेरी जिंदगी के ताहीं रहै, मेरे ताहीं मरन की बजह बनी। <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" /><note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 3:13">उत्पत्ति 3:13</ref></char></note>काहैकि पाप मौका मारकै आग्या से मोकै फुसलाई, और बहे की बजह से मोकै मारियो डारी।<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />तभई के मारे नियम पवित्र है, और आग्या पवित्र, धर्मी और अच्छी है। <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />तौ का बौ जो अच्छो रहै, मेरे ताहीं मौत ठहरो? कतईये नाय! लेकिन पाप बौ अच्छी चीजन से मेरे ताहीं मौत कै पैदा करन बारो भौ, ताकी पाप को असली रूप सामने आए सकै। और तभई आग्या के जरिया पाप कै औरौ खतरनाक तरीका से पाप के रूप मैं दिखाओ गौ है।<verse eid="ROM 7:13" /></para>
  <para style="s">खुद मैं संघर्स</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />हम जानथैं कि नियम तौ आध्यात्मिक है, लेकिन मैं सारीरिक हौं और पाप के हात मैं बिको भौ हौं। <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" /><note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 5:17">उत्पत्ति 5:17</ref></char></note>मोकै समझ मैं नाय आए रौ है कि मैं का करौं; काहैकि मैं बौ ना करथौं जो मोकै करनो चाहिए, लेकिन जाके बजाय मैं बहे करथौं जोसे मैं नफरत करथौं। <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />काहैकि मैं जो कहथौं, बहे करथौं, जासे पता लगथै कि मैं मानथौं कि नियम ठीक है। <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />तौ ऐसे हालत मैं बाकै करन बारो मैं नाय, बल्किन बौ पाप है जो मेरे भीतर है। <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />मैं जानथौं, कि मेरे सरीर के भीतर कोई अच्छी चीज नाय बास करथै, मन तौ मेरो होथै, भलेई अच्छो करन की इच्छा मेरे मैं है, लेकिन भले काम मोसे होतै ना हैं। <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />काहैकि जो अच्छो काम करन को मेरो मन होथै, बौ तौ मैं करतै नाय हौं, लेकिन जो खराब काम के ताहीं मन नाय करथै, बहे काम करथौं। <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />अगर मैं बे काम करथौं जोको मेरो मन नाय करथै, जाको मतलब बे काम कै करन बारो मैं नाय रहौं, लेकिन पाप जो मेरे भीतर है बहे जे काम करथै।<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />तौ मोकै जो नियम मिलथै कि जब मैं भले काम करन की सोचथौं: जब मैं बौ करनो चाहथौं जो अच्छो है, तौ बुराई मेरे झोने आथै। <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />काहैकि मैं अपने अंदर की इंसानियत से तौ परमेस्वर के नियम से भौतै खुस रहथौं। <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />लेकिन मोकै मेरे सरीर के हिस्सन मैं कुछ अलगै जैसो नियम दिखाई देथैं, जो मेरे अकल के नियम से लड़थैं और मोकै पाप के नियम के भँदना मैं डरात रहथैं जो मेरे सरीर के हिस्सन मैं हैं। <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />मैं कैसो दुखी आदमी हौं! जौ सरीर से मोकै कौन छुड़ाबैगो जो मोकै मौत के घाट उतार रहो है?<verse eid="ROM 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 7:25" />हमरे प्रभु ईसु मसीह के जरिये, परमेस्वर को धन्यवाद होबै! जौ फिर मेरी स्थिति है: अपने दम पर मैं अपने मन से सिरफ परमेस्वर के नियम की सेवा करथौ, जबकी मेरो इंसान को स्वभाव पाप के नियम को काम करथै।<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">पवित्र आत्मा मैं जिंदगी</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />तौ अब मसीह ईसु के संग रहन बारेन के ताहीं कोई सजा नाय है। <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />आत्मा के नियम के ताहीं, जो हमैं मसीह ईसु के संग जिंदगी मैं लाथै, मोकै पाप और मौत के नियम से छुटकारो दै दई है। <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />काहैकि जो काम नियम सरीर की बजह से कमजोर हुईकै नाय कर पाई, बाकै परमेस्वर करी, मतलब अपनोई लौड़ा कै पाप बारे सरीर के हानी और पाप बलि होन के ताहीं भेजकै, सरीर मैं पाप ऊपर सजा की आग्या दई। <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />परमेस्वर ऐसो तभई करी ताकी नियम की धर्मी माँगैं पूरी तरीका से हम्मै तसल्ली कर सकैं जो आत्मा के अनुसार चलथैं, और इंसान की प्रकृति के हानी नाय। <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />काहैकि जो लोग सारीरिक होथैं बे सरीर की बातन मैं मन लगाथैं; जो लोग आत्मा के रूप मैं जीथैं उनकै, आत्मा जो चाहथै बहे के जरिया अपने मन कै नियंतरित करो जाथै। <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />सरीर मैं मन लगानो तौ मौत है, लेकिन पवित्र आत्मा मैं मन लगानो जिंदगी और सांति है। <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />और सरीर मैं मन लगानो तौ परमेस्वर से दुस्मनी रखनो है, काहैकि ना तौ हम परमेस्वर के नियम के भरोसे है और ना हुई सकथै; <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />और जो सरीर के प्रकृति के वस मैं है, बे परमेस्वर कै खुस नाय कर सकथैं।<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />पर जबकी परमेस्वर को आत्मा तुमरे भीतर रहथै, तौ तुम सारीरिक प्रकृति मैं नाय लेकिन आत्मा के हालत मैं होबौ। अगर कोई के भीतर मसीह की आत्मा नाय है तौ बौ बाको इंसान हईये नाय। <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />अगर मसीह तुमरे मैं है, तौ सरीर पाप की बजह से मरी भइ है; लेकिन आत्मा धर्म के बजह से जिंदी है। <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" /><note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरिन्थियों 3:16</ref></char></note>अगर बहे को आत्मा जो ईसु कै मरे भौ मैं से जिंदो करी, तुमरे भीतर बसो पड़ो है; तौ जो मसीह के मरे भौ मैं से जिंदो करी, बहे तुमरे नास होन बारे सरीर कै अपनी आत्मा से जो तुमरे मैं बसी भइ है, जिंदो करैगो।<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />भईय्यौ और बहेनियौ, हम सरीर के कर्जदार नाय हैं कि सरीर के हिसाब से जिंदगी काटैं, <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />काहैकि अगर तुम सरीर के हानी दिन काटैगे तौ मरैगे, अगर आत्मा से सरीर के कामन कै मारौगे तौ जिंदे रहाबैगे। <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />तभईये जित्ते आदमी परमेस्वर की आत्मा के चलाय चलथैं, बेईं परमेस्वर के बालका हैं। <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />परमेस्वर तुमकै जो आत्मा दई है, बौ तुमकै गुलाम नाय बनाथै, और ना तुमकै डरपाथै; बल्किन, उल्टा आत्मा तुमकै परमेस्वर को बालका बनाथै, और आत्मा के बल से हम परमेस्वर कै पुकारथैं, “परमपिता! मेरे परमपिता!” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />परमेस्वर की आत्मा खुदै हमरी आत्मा के संग गभाई देथै, कि हम परमेस्वर के बालका हैं। <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />और अगर बालका हैं तौ बाके वारिस हैं, बल्किन परमेस्वर के हकदार और मसीह के संगी हकदार हैं, कि जब हम बाके संग दुख उठामैं तौ बाके संग महिमा पांगे।<verse eid="ROM 8:17" /></para>
  <para style="s">आनबारे समय कि जै</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />मोकै लगथै कि जौ समय के दुख और कलेस बाकी महिमा के अग्गु, जो हमरे ऊपर दिखन बारी है, कछुए नाय है। <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />दुनिया खूबै आसा बारी नजर से परमेस्वर के बालकन के दिखाई देन की रहा निहार रइ है। <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" /><note caller="+" style="x"><char style="xo" closed="false">8:20 </char><char style="xt" closed="false"><ref loc="GEN 3:17-19">उत्पत्ति 3:17-19</ref> </char></note> सृस्टि अपनी मरजी से नाय पर अधीन करन बारे के घाँईं से, लेकिन परमेस्वर को ऐसो करन की इच्छा है। तहुँओं आसा रहै <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />कि सिरस्टी खुद एक दिन अपनी गुलामी से छुटकै खतम होन लगैगी और परमेस्वर के बालकन की महिमा की आजादी लेबैगी। <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />हम जानथैं कि पूरी दुनिया हबै तक मिलकै कांखथै और परेसानी मैं पड़ी भइ तड़पत रहथै। <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" /><note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2 कुरिन्थियों 5:2-4</ref> </char></note>और सिरफ बहे नाय लेकिन हमउँ बाके झोने आत्मा को फल हैं, अपने आपै मैं कांखथैं; और बालक होन ताहीं मतलब अपनी सरीर के छुटकारे की रहा तकथैं। <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />हमरो उद्धार जौ आसा से भौ है लेकिन जो चीज की आसा करी जाथै, जब बौ देखन मैं आथै तौ फिर आसा रहिये कहाँ? काहैकि जो चीजन कै कोई देखरौ है बाकी आसा कहाँ करंगे? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />पर जो चीज कै हम देखतै नाय हैं, अगर बाकी आसा रखथैं तौ, धीरज से बाकी रहा तकथैं।<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />ऐसियै आत्मौ हमरी कमजोरी मैं मदत करथै, काहैकि हम जानतै ना हैं, कि प्रार्थना कैसे करकै करनो चाहिए; आत्मा खुदै ऐसे आँह भर-भरकै जो बखान करन से परे है, हमरे ताहीं मिन्नत करथै। <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />और मन कै परखन बारो जानथै कि आत्मा की का मरजी है? काहैकि बौ पवित्र आदमिन के ताहीं परमेस्वर की इच्छा से बिनती करथै।<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />और हमउँ जानथैं, कि जो आदमी परमेस्वर से प्यार करथैं, उनके ताहीं सबै बात मिलकै भलाइये पैदा करथैं; मतलब उन्हईं के ताहीं जो बाकी इच्छा से बुलाए भै हैं। <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />काहैकि जिनकै बौ पहलिये से जान लई है उनकै पहलिये से ठहराए भी दई है कि बाके लौड़ै हानी होमैं जोसे बौ निरे भईय्यनौ मैं पहलोठो होबै। <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />फिरौंकी जिनकै बौ पहलिये से ठहराए दई है, उनकै मस्काई भी, और जिनकै मस्काइयो, उनकै धर्मी ठहराई, और जिनकै धर्मी ठहराई, उनकै महिमा भी दई है।<verse eid="ROM 8:30" /></para>
  <para style="s">मसीह मैं परमेस्वर को प्यार</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />तौ जे बातन के बारे मैं का कहमैं? अगर परमेस्वर हमरे घाँईं है, तौ हमरो बिरोधी कौन हुई सकथै? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />जो अपने खुदै के बालक कै नाय छोड़ी, लेकिन बौ ईसु कै हम सबन कै ताहीं सौंप दई, तौ बाके संग हमकै और सबै कछु काहे नाय देगो? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />परमेस्वर के चुने भै के ऊपर कौन दोस लगाए पागो? परमेस्वर बौ है जो उनकै धर्मी बनानबारो है! <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />फिर कौन है जो सजा की आग्या देगो? ईसु मसीह बौ है जो मर गौ बल्किन मरे भौ मैं से जिंदो भी हुई गौ, और परमेस्वर के दहने है, और हमरे ताहीं बिन्तिओ करथै! <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />कौन है जो हमकै मसीह के प्यार से अलग कर सकथै? का कलेस, या मुसीबत, या संकट, या अकाल, या कंगाली, या उपद्दर, या जोखिम, या तलवार या मौत? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />जैसे कि सास्त्र मैं लिखो है,</para>
  <para style="q1" vid="ROM 8:36">“तुमरे खातिर हमैं हर समय मौत को खतरा है;</para>
  <para style="q2" vid="ROM 8:36">हमरे संग मरन बारी भेंड़-बकरियन के जैसे बर्ताव करो जाएरौ है।”<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />नाय! इन सब चीजन मैं हमैं बाके जरिया से पूरी जीत मिली है जो हमसे प्यार करी है! <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />काहैकि मोकै पक्को बिस्वास है, कि ना तौ मौत ना जिंदगी, ना स्वर्गदूत, ना हुई प्रधानताऐं, ना समय जो चल रहो है, ना आनबारो समय, ना सामर्थ्य, ना ऊँचो, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />ना गहरो और ना सृस्टि, हमकै परमेस्वर के प्यार से, जो हमरे प्रभु ईसु मसीह मैं है, अलग कर पागो।<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">परमेस्वर और बाके लोग</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />मैं मसीह मैं सच्ची कहथौं, और झूठ नाय बोलथौं और मेरो मन पवित्र आत्मा मैं गभाई देथै। <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />जब मैं कहथौं कि मेरो दुख कितनो बड़ो है, मेरे दिल मैं कितनो दर्द है <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />काहैकि मैं हिंयाँ तक चाहथौं, कि मेरे लोगन के ताहीं जो सरीर के हिसाब से तौ मेरे कुरमा टब्बर हैं, बे अपने आपै मसीह से स्रापित और न्यारे हुई जाते। <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />बे परमेस्वर के लोग इस्राएली हैं; बौ उन्हैं अपनो बालका बनाई, और अपनी महिमा उनके ऊपर दिखाई; बौ उनके संग अपनी वाचा भाँदी और उन्हैं नियम दई; उनके पास सच्ची आराधना है; बे परमेस्वर की प्रतिग्यन कै पाईं हैं; <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />नामी इब्रानी पुरखा उन्हईं के हैं, मसीह सरीर के भाव से उन्हईं मैं से भौ। सबन के ऊपर परम परमेस्वर हमेसा-हमेसा धन्य होबै। आमीन।<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />लेकिन ऐसो ना है कि परमेस्वर को बचन टल गौ, तभईये कि जो इस्राएल के बंस हैं बे सब इस्राएली नाय हैं; <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />और ना अब्राहम के बंस होन के बजह से सबै बाके बालका भै, लेकिन लिखो है “इसहाक से तेरो बंस कहलाओ जागो।”<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 21:12">उत्पत्ति 21:12</ref> </char></note> <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />जाको मतलब सरीर से पैदा भै बालका परमेस्वर के बालका ना हैं; जाके बजाय, परमेस्वर के वादा के हिसाब से पैदा भै बालका सच्चे बंसज माने जाथैं। <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />परमेस्वर को वादा जे बचन से है: “मैं सई समय मैं दुबारा आंगो, और सारा को लौड़ा होगो।”<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />और जौ काफी ना है; रिबका के दुई लौड़न को बाबा एकै रहै, हमरे पुरखा इसहाक। <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />फिर भी, जासे पहले कि जुड़वा बालका पैदा होमैं या बे कछु अच्छो या बुरो करै, ताकी चुनन मैं परमेस्वर को उद्देस्य खड़ो हुई सकै: <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />काम से नाय, बल्किन बाके जरिये जो बुलाथै-बाकै बताओ गौ रहै, “बड़ो छोटे कि सेवा करै।” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />जैसो कि सास्त्र मैं लिखो पड़ो है, “मैं याकूब से प्यार करो, पर एसाव <note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">याकूब को भईय्या</char></note>कै नफरत करत रहौं।”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />तौ हम का कहमैं? का परमेस्वर के हिंयाँ अधर्म और अन्याय है? कतई नाय। <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />काहैकि बौ मूसा से कहथै,</para>
  <para style="q1" vid="ROM 9:15">“मैं जोके ऊपर दया करनो चाहमौं बाके ऊपर दया करंगो,</para>
  <para style="q2" vid="ROM 9:15">और जो कोई ऊपर किरपा करनो चाहमौं, बहे ऊपर किरपा करंगो।”<verse eid="ROM 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 9:16" />तौ फिर, जो इंसान चाहथै और जो करथै बाके ऊपर कछु निर्भर नाय करथै, लेकिन खाली परमेस्वर कि दया के ऊपर निर्भर करथै। <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />काहैकि पवित्र सास्त्र मिस्र के राजा फिरौन से कहो गौ, “मैं तोकै तभईये ठड़बाओ हौं कि तेरे मैं हुईकै अपनी सामर्थ्य दिखामौं, और मेरे नाओं को प्रचार पूरी दुनिया मैं होबै।” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />तभईये परमेस्वर जोकै चाहथै बहे के ऊपर दया करथै, और जोकै चाहथै बाको मन कर्‌रो कर देथै।<verse eid="ROM 9:18" /></para>
  <para style="s">परमेस्वर को गुस्सा और दया</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />अब तैं मोसे कहेगो, “बौ फिर से काहेकै इल्जाम लगाथै? कौन बाकी मरजी को सामना करथै?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />इंसान, तू भला कौन है जो परमेस्वर को सामना करथै? का गढ़ी भइ कोई चीज गढ़नबारे से कह सकथै, “तैं मोकै ऐसो काहे बनाओ है?” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />का कुम्हरा कै मट्टी मैं अधिकार ना है कि एकै लोंदा मैं से एक बर्तन आदर के ताहीं, और दुसरेन कै अनादर के ताहीं बनाबै?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />और परमेस्वर जो करी है बहे सच है; बौ अपने गुस्सा कै दिखानो चात रहै, और अपनी ताकत को परिचय देनो चात रहै; लेकिन बौ बे लोगन कै धीरज देन मैं भोतै धीरज रखत रहै, जो बाके गुस्सा होन कि चीज रहैं, जो बिनास के ताहीं बरबाद रहै। <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />और बौ अपनी प्रचुर महिमा कै दिखानो चात रहै, जोकै हमरे ऊपर डारो गौ रहै जो बाकी दया कि चीज है, हममैं से जिनकै बौ अपनी महिमा पान के ताहीं तैयार करी है। <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />मतलब हमरे ऊपर जिनकै बौ नाय सिरफ गैर यहूदियन मैं से, बल्किन गैर यहूदिन मैं से मस्काईं। <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />जैसे कि बौ होसे नाओं कि किताब मैं भी कहथै,</para>
  <para style="q1" vid="ROM 9:25">जो मेरे लोग ना रहैं,</para>
  <para style="q2" vid="ROM 9:25">उनकै मैं अपने लोग कहेंगो,</para>
  <para style="q1" vid="ROM 9:25">और जो लोगन से मैं प्यार नाय करथौं,</para>
  <para style="q2" vid="ROM 9:25">उनकै प्रिय कहेंगो।<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />और, “ऐसो होगो कि जो जघा मैं उनसे ऐसो कहो गौ रहै कि</para>
  <para style="q2" vid="ROM 9:26">तुम मेरे लोग नाय हौ, बहे जघा बे जिंदे परमेस्वर के बालका कहे जामंगे।”<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />और यसायाह भविस्यवक्ता इस्राएल देस के बारे मैं चिल्लाए कै कही है, “चाँहे इस्राएल के बालका की गिनती समुंदर के रेता के बराबर होबै, तहुँओं उनमैं से थोड़ी एक बचंगे। <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />काहैकि प्रभु अपनो बचन दुनिया मैं जल्दिये पूरो करैगो।” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />जैसे कि यसायाह भविस्यवक्ता पहले भी कही रहै,</para>
  <para style="q1" vid="ROM 9:29">“अगर सेना को प्रभु हमरे ताहीं एकौ बंस नाय छोड़तो,</para>
  <para style="q2" vid="ROM 9:29">तौ हम सदोम के हानी हुई जाते, और अमोरा के हानी होते।”<verse eid="ROM 9:29" /></para>
  <para style="s">इस्राएल के ताहीं पौलुस कि प्रार्थना</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />अब हम का कहमैं? कि गैर यहूदि जो धार्मिकता की खोज नाय करत रहैं, धार्मिकता कै लै लईं, यानी की बौ धार्मिकता कै जो बिस्वास से है; <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />लेकिन परमेस्वर के आदमी इस्राएली, जो धर्म के नियम की खोज करत रहैं बौ नियम तक नाय पुगे। <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />कौनके ताहीं? तभईये कि बे बिस्वास से नाय, लेकिन जैसे मानौ करमन से बाकी खोज करत रहैं। और इसलै बे बौ ठोकर के “पथरा से ठोकर खाईं” <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />जैसे कि सास्त्र मैं लिखो है,</para>
  <para style="q1" vid="ROM 9:33">“देखौ मैं सिय्योन पहाड़ मैं</para>
  <para style="q2" vid="ROM 9:33">एक ठेस लगन को पथरा,</para>
  <para style="q2" vid="ROM 9:33">और ठोकर खान की चट्टान रखथौं,</para>
  <para style="q1" vid="ROM 9:33">और जो बाके ऊपर बिस्वास करैगो बौ कहु उदास नाय होगो।”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />भईय्यौ और बहेनियौ, मेरे मन की इच्छा और मेरे लोगन के ताहीं परमेस्वर से मेरी प्रार्थना है, कि बे उद्धार पामैं! <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />का काहैकि मैं उनकी गभाई देथौं कि बे परमेस्वर की धुन मैं रहथैं, पर अकल के ताहीं नाय। <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />काहैकि बे परमेस्वर की धार्मिकता से अनजान हुईकै, और अपनी धार्मिकता बनान ताहीं खूबै कोसिस करकै, परमेस्वर की धार्मिकता के हवाले नाय भै। <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />काहैकि मसीह नियम कै खतम कर दई है, ताकी जो कोई बिस्वास करथै, बौ परमेस्वर के सामने धार्मिक ठहराओ जाथै।<verse eid="ROM 10:4" /></para>
  <para style="s">उद्धार सबन के ताहीं</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />काहैकि मूसा जौ लिखी है कि जो इंसान बौ धार्मिकता मैं जो नियम से है चलथै, बौ बहे से जिंदो रहबैगो। <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />लेकिन जो धार्मिकता बिस्वास से है, बौ ऐसे कहथै, “तैं अपने मन मैं जौ मत कहिये कि स्वर्ग मैं कौन जागो?” मतलब मसीह कै उतार लान ताहीं! <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />या अधोलोक मैं कौन आगो? मतलब कि ईसु मसीह कै मरे भौ मैं से जिंदो करकै ऊपर लान ताहीं। <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />लेकिन बौ का कहथै? जौ कि “बचन तेरे झोने है, तेरे मोहों और मन मैं है,” जौ बहे बिस्वास को बचन है, जोको हम प्रचार करथैं। <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />कि अगर तैं अपने मोहों से ईसु कै प्रभु मानकै अंगीकार<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">कोई इंसान कै या चीज कै अपनानो</char></note> करै मतलब ईसु कै प्रभु मानिये लेबै और अपने मन मैं बिस्वास करकै कि परमेस्वर बाकै मरे भैन मैं से जिंदो करी है, तौ तू सच्ची मैं उद्धार पायगो। <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />काहैकि धार्मिकता के ताहीं मन से बिस्वास करो जाथै, और उद्धार के ताहीं मोहों से अंगीकार करो जाथै। <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />पवित्र सास्त्र ऐसो कहथै कि, “जो भी चाँहे जो होबै ईसु मैं बिस्वास करैगो बौ कहु सर्मिंदा ना होगो।” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />यहूदियन और यूनानिन मैं कछु भेद हईये नाय, तभई तौ बौ सबन को प्रभु है और अपने सब नाओं लेन बारेन के ताहीं इमानदार है। <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />जैसो कि पवित्र सास्त्र कहथै, “जो कोई भी मदत के ताहीं प्रभु कै पुकारैगो, बौ बच जाबैगो।”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />पर जोके ऊपर बिस्वास नाय करीं, बे बाको नाओं काहेकै लेमैं? और जोके बारे मैं सुनिये नाय बाके ऊपर कैसे करकै बिस्वास करैं? और प्रचार करन बारे के बिना कैसे सुनैं? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />और अगर भेजे ना जामैं, तौ कैसे प्रचार करैं? जैसे कि सास्त्र कहथै, “उनकी टाँग कैसी सुहानी हैं, जो अच्छी बातन को सुसमाचार सुनाथैं।” <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />लेकिन जितने हैं सुसमाचार मैं कान नाय लगाईं: यसायाह भविस्यवक्ता कहथै, “प्रभु, कौन है जो हमरे समाचार मैं बिस्वास करी है?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />अब बिस्वास सुनन से और सुननो मसीह ईसु के बचन से होथै।<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />लेकिन मैं कहथौं, का बे नाय सुनीं? सुनीं तौ जरूरै हैं, काहैकि सास्त्र मैं लिखो है,</para>
  <para style="q1" vid="ROM 10:18">“उनकी अबाज पूरी पृथ्वी मैं,</para>
  <para style="q2" vid="ROM 10:18">और बाके बचन दुनिया की छोर ले पुग गै हैं।”<verse eid="ROM 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 10:19" />मैं फिर पूछथौं: का इस्राएल के लोग नाय समझथैं? पहले तौ मूसा भविस्यवक्ता कहथै,</para>
  <para style="q1" vid="ROM 10:19">“मैं उनसे जो जाति मेरी ना है,</para>
  <para style="q2" vid="ROM 10:19">तुमरे मन मैं जलन भरंगो;</para>
  <para style="q1" vid="ROM 10:19">और मूर्खन के देस के जरिये</para>
  <para style="q2" vid="ROM 10:19">मैं मूढ़ी लोगन से तुमकै खिजरबांगो।”<verse eid="ROM 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 10:20" />फिरौंकी यसायाह भविस्यवक्ता खूब हिम्मत दैकै कहथै,</para>
  <para style="q1" vid="ROM 10:20">“जो मोकै ना ढूँड़त रहैं, बे मोकै पायलईं;</para>
  <para style="q2" vid="ROM 10:20">और जो मोकै पूँछत तक नाय रहैं, उनके ऊपर मैं दिखाई दौ।”<verse eid="ROM 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21" />लेकिन इस्राएल के बारे मैं बौ ऐसो कहथै,</para>
  <para style="q1" vid="ROM 10:21">“मैं अपनो हात पूरे दिन एक आग्या ना मानन बारी और बहस करन बारे लोगन के घाँईं फैलाय रखाओ।”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">इस्राएल देस मैं परमेस्वर की दया</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:5">फिलिप्पियों 3:5</ref>
      </char>
    </note>मैं पूछथौं, तौ: का परमेस्वर अपने लोगन कै ना अपनाई? कतईये नाय! मैं खुद एक इस्राएल हौं अब्राहम को बंस और बिन्यामीन<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">इसहाक के लौड़ा याकूब के बहारै लौड़ा रहैं, जिनमैं बिन्यामीन सबसे छोटो बारो रहै।</char></note> के बंस को एक सदस्य हौं। <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />परमेस्वर अपने लोगन कै नाय छोड़ी है, जोकै बौ पहलिये से चुनी। तुम जानथौ कि पवित्र सास्त्र एलिय्याह भविस्यवक्ता के बारे मैं का कहथै, जितै बौ इस्राएल के बिरोध मैं परमेस्वर से प्रार्थना करी: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" /><note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="1KI 19:10">1 राजा 19:10</ref>,<ref loc="1KI 19:14">14</ref></char></note>“हे प्रभु, बे तेरे भविस्यवक्तन कै मार डारी हैं और तेरी बेदियन कै गिराय दईं हैं; मैं सिरफ एकै बचो हौं, और बे मेरी ज्यान लेन की कोसिस कर्‌रै हैं।” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" /><note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="1KI 19:18">1 राजा 19:18</ref></char></note>परमेस्वर बाकै का जबाब दई? “मैं अपने ताहीं सात हजार आदमियन को ख्याल लौ हौं जो झूठे बाल देवतन की पूजा नाय करी हैं।” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />जौ अब बहे तरह है: बे लोगन की एक छोटी संख्या बची है जिनकै परमेस्वर उनके अनुग्रह और किरपा के कारड़ चुनी है। <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />उनकी पसंद अनुग्रह मैं आधारित है, बे जो करी हैं बामै नाय। अगर परमेस्वर की पसंद मैं लोग का करथैं, जाके आधार मैं, तौ उनकी किरपा सच्ची की किरपा नाय होगी।<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />तौ का? इस्राएली लोग जोकै ढूँड़त रहैं, बौ उनकै नाय मिलो, जौ एक छोटो झुंड रहै जोकै परमेस्वर चुनी, जो जाकै पाई; बाकी परमेस्वर के बुलान मैं बैहरा हुईगै। <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" /><note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="DEU 29:4">व्यवस्थाविवरन 29:4</ref>; <ref loc="ISA 29:10">यसायाह 29:10</ref></char></note>जैसे कि सास्त्र मैं लिखो है, “परमेस्वर उनके मन और दिलन कै मंद बनाये दई; जौ दिन बे देख और सुन नाय सकथैं।” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" /><note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 69:22">भजन संहिता 69:22</ref>,<ref loc="PSA 69:23">23</ref></char></note>और राजा दाऊद कहथै,</para>
  <para style="q1" vid="ROM 11:9">“उनको खानु उनके ताहीं जार है; बे गिर सकथैं, उनकै सजा दौ जाए सकथै!<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />उनकी आँखिन कै अंधो कर दौ जाबै ताकी बे देखिये नाय पामैं;</para>
  <para style="q2" vid="ROM 11:10">और तैं हमेसा उनकै परेसानी के ताहीं नीचे झुकाए रखाबै।”<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />मैं पूँछथौ, तौ: जब यहूदि लड़खड़ाय गै, तौ का बे अपने खंडर मैं गिर गै? कैसियौ नाय! बे पाप करीं, गैर यहूदि लोगन के ताहीं उद्धार आओ है, तही के मारे यहूदियन कै उनसे जलन होथै। <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />यहूदियन को पाप दुनिया कै खूब आर्सिवाद दई, और उनकी आध्यात्मिक गरीबी गैर यहूदियन कै खूब आर्सिवाद दई। फिरौंकी, यहूदियन की पूरी संख्या मैं सामिल होन से आर्सिवाद कित्तो बड़ो होगो!<verse eid="ROM 11:12" /></para>
  <para style="s">गैर यहूदियन को उद्धार</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />गैर यहूदियौ मैं तुमसे अब बात कर रहो हौं: जबले मैं गैर यहूदियन के ताहीं प्रेरित हौं, मैं अपने सेवा के बड़ाँईं के काम मैं गरब करंगो। <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />सायद मैं अपनी जाति के लोगन के अंदर जलन पैदा कर सकथौं, और तभई उनमैं से कुछन कै बचान मैं काबिल हौं। <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />जब उनकै नाय अपनाओ गौ, तौ दुनिया के सबै लोग परमेस्वर के दुस्मन से दोस्त मैं बदल गै। तौ का होगो जब उनकै अपनाय लौ जागो। जौ मरे भैन के ताहीं जिंदगी होगी!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />अगर पवित्र रोटी को पहलो टुकड़ा परमेस्वर के दौ जाथै, तौ पूरी पवित्र रोटी बहे की है; और अगर रूखन की जड़ैं परमेस्वर कै चढ़ाई जाथैं, तौ हँगईय्यौ बहे की हैं। <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />खेती करी भइ जैतून के पेंड़ की एकाद हँगईय्या कै तोड़ दौ गौ है, और बन के जैतून के जड़ की एक हँगईय्या जामैं मिल गई है। तुम गैर यहूदि जंगली जैतून के पेंड़ के हानी हैं, और अब तुम यहूदियन के भागीदार भै। <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />तौ तुमकै बे लोगन से नफरत नाय करनो चाहिए जो डंघईय्यन के जैसी टूट गै रहैं। तुम कैसे घमंड कर सकथौ? तुम सिरफ एक डंघा हौ; तुम जड़न कै नाय पकड़े हौ पर जड़ैं तुमकै पकड़े हैं।<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />पर तैं कहबैगो, “हाँ, पर मेरे ताहीं जघा बनान के ताहीं हँगईय्यन कै तोड़ दौ गौ रहै।” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />सई है, बिस्वास ना होन की बजह से बे टूट गै; जब तुम जघा मैं बने रैहथौ काहैकि तुम बिस्वास करथौ। लेकिन तैं घमंडी मत बनै, पर जाके बजाय डर मान। <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />परमेस्वर यहूदियन कै नाय छोड़ी, जो प्राकृतिक डंघईय्यन के हानी हैं; का तोकै लगथै कि बौ तोए छोड़ देगो? <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />हींना हम देखथैं कि परमेस्वर कित्ते दयालु और गंभीर हैं। बौ बे लोगन के ताहीं गंभीर है जो गिर गै हैं लेकिन तुमरे ऊपर दया करथै अगर तुम बाकी दयालुता बनाये रखाथौ तौ। लेकिन अगर तुम नाय करथौ, तौ तुम्हऊँ टूट जागे। <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />और अगर यहूदि उनके अविस्वास कै छोड़ दईं, उनकै फिरौंकी से बहे जघा रखो जागो जितै बे रहैं; काहैकि परमेस्वर ऐसो करन के काबिल है। <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />तुम गैर यहूदियौ एक जंगली जैतून के पेंड़ की डंघईय्यन के जैसी होथौ जो टूट जाथै और फिरौंकी, प्रकृति से हटकै, एक खेती जैतून के रूखा मैं मिलगौ है। यहूदि जौ खेती के रूखा के जैसी हैं; और परमेस्वर के ताहीं जे टूटी-फूटी डंघईय्यन कै फिरसे अपने रूखा के संग जोड़न के ताहीं सरल हुई जागो।<verse eid="ROM 11:24" /></para>
  <para style="s">सबन के ऊपर परमेस्वर कि दया</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />भईय्यौ और बहेनियौ, एक लुकी भइ सच्चाई है, जोमैं तुमकै बतानो चाहथौं, ऐसो है जौ तुमकै ऐसे करकै सोचन से बचागो कि तुम कित्ते ग्यानवान हौ। ऐसो है कि इस्राएल देस के लोगन की जिद टिकी भइ नाय है, पर इनकी जिद तौले चलैगी जबले गैर यहूदि की पूरी संख्या परमेस्वर के झोने ना आए जाबै। <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" /><note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ISA 59:20">यसायाह 59:20</ref>,<ref loc="ISA 59:21">21</ref> </char></note>और ऐसो करकै पूरो इस्राएल कै बचाओ जागो। जैसे कि सास्त्र मैं लिखो है,</para>
  <para style="q1" vid="ROM 11:26">“उद्धारकर्ता सिय्योन पहाड़ से आगो,</para>
  <para style="q2" vid="ROM 11:26">और याकूब<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">इसहाक को लौड़ा अब्राहम को नतिया और परमेस्वर को दास </char></note> के बंसज से बुरी बात दूर करैगो।<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:27 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 27:9">यसायाह 27:9</ref>
      </char>
    </note>और उनके संग मेरो जहे वाचा होगो,</para>
  <para style="q2" vid="ROM 11:27">जब खिन मैं उनके पापन कै दूर कर देंगो।”<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />काहैकि बे सुसमाचार कै नकारथैं, यहूदि तुम मैं गैर यहूदि ताहीं परमेस्वर के दुस्मीं हैं। लेकिन परमेस्वर के चुनन के बजह से, बे अपने परखन के बजह से प्रिय हैं। <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />परमेस्वर अपनो मन नाय बदलथै, जोकै बौ चुनथै और आर्सिवाद को उपहार देथै। <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />जैसी की तुम गैर यहूदियन के ताहीं, तुम पहले परमेस्वर की आग्या नाय माने रहौ; लेकिन हबै उनके आग्या नाय मानन से तुमरे ऊपर दया भइ। <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />बैसिये दया की बजह से जो तुमकै मिलो है, यहूदि अब परमेस्वर की आग्या ना मानथैं, ताकी अब बेऊँ परमेस्वर की दया पाय सकैं। <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />परमेस्वर सबन कै आग्या नाय मानन के बजह से भाँद लई है, ताकी बौ सबन के ऊपर दया करै।<verse eid="ROM 11:32" /></para>
  <para style="s">परमेस्वर की महिमा</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:33 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 55:8">यसायाह 55:8</ref> </char>
    </note>परमेस्वर को धन कित्तो महान है! बाकी बुद्धि और ग्यान कैसो गहरो है! बाके फैसलन को बखान कौन कर सकथै? बाके तरीका कौन समझ सकथै? <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" /><note caller="+" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="ISA 40:13">यसायाह 40:13</ref> </char></note>जैसे कि सास्त्र मैं लिखो है:</para>
  <para style="q1" vid="ROM 11:34">“प्रभु के मन कै कौन जानथै?</para>
  <para style="q2" vid="ROM 11:34">कौन बाकै सलाह देन मैं काबिल है?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:35 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:11">अय्यूब 41:11</ref>
      </char>
    </note> कौन बाकै कहु कछु दई है, ताकी बाकै बापस भुगतान करन पड़ै?”<verse eid="ROM 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:36 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 8:6">1 कुरिन्थियों 8:6</ref> </char>
    </note>काहैकि बहे के घाँईं से, और बहे से, और बहे के ताहीं सब कछु है। सच मैं बाकी महिमा हमेसा-हमेसा होत रहबै! आमीन।<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">परमेस्वर कि सेवा मैं जिंदगी</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />तभईये, भईय्यौ और बहेनियौ, मैं तुमसे परमेस्वर की दया याद करबाय कै नहोरे करथौं कि अपने सरीर कै जिंदो, और पवित्र, और परमेस्वर कै मन से लगन बारो बलिदान करकै चढ़ाबौ। जहे तुमरी आत्मिक सेवा है। <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />जौ युग के जैसे मत बनौ; लेकिन तुमरे मन के नये हुई जान से तुमरो चालचलनौ बदलत जाबै, जोसे तुम परमेस्वर कै अच्छी, और बाकै भान बारी, और परख की सिद्ध इच्छा अनुभव से मालुम करत रहबौ।<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />काहैकि मैं बहे अनुग्रह के बजह से जो मोकै मिलो है, तुम जितने हौ सबन से कहथौं, कि जैसो समझनो चाहिए, बासे जाधे कोई अपने आपकै नाय समझै; जाके अलावा अपनी सोच मैं विनम्र बनौ, लेकिन जैसे परमेस्वर सबन कै बिस्वास से नाप तौल से बाँट दई है, बैसिये सई बुद्धि के संग अपने आपकै आकैं। <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" /><note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1CO 12:12">1 कुरिन्थियों 12:12</ref></char></note>जैसे हमरे सरीर मैं भौत से अंग हैं, और सब अंगन को एक सो काम नाय है। <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />बैसिये हमउँ निरे हैं, मसीह मैं एक सरीर हुईकै आपसै मैं एक सरीर के अलग-अलग अंग हैं। <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" /><note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="1CO 12:4-11">1 कुरिन्थियों 12:4-11</ref> </char></note>इसलै हम अपने अलग-अलग उपहार को इस्तमाल बौ अनुग्रह के हिसाब से करथैं, जो परमेस्वर हमकै दई है; अगर हमरो उपहार परमेस्वर के संदेस कै बोलनो है, तौ हमकै बौ बिस्वास के हिसाब से करनो चाहिए जो हमरे पास है; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />अगर सेवा करन को दान मिलो है, तौ बौ सेवा करत रहबै, अगर कोई सिखान बारो है, तौ सिखातै रहबै; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />जो हौंसला देथै, बे हौंसला देत रहमैं; और दान देनबारे इच्छा से देमैं, जो अगुवाई करै, बौ कड़ी मेहनत से करै, जो कोई दया दिखाथै, बौ खुसी से दया दिखाबै।<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />प्यार पूरी तरह से इमानदारी से होने चाहिए, जो बुराई है बासे नफरत करौ, जो अच्छो है बाकै पकड़ौ। <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />एक दुसरे से मसीह भईय्यौ और बहेनियन के हानी प्यार करैं; एक दुसरे को आदर करन मैं एक दुसरे से बढ़त चले जाबौ। <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />कड़ी मेहनत करैं और आलसी ना बनै; आत्मिक धुन और हौंसला से भरे रहबौ प्रभु की सेवा करत रहबौ। <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />आसा मैं खुस रहबौ; कलेस मैं टिके रहबौ; प्रार्थना हमेसा करत रहबौ। <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />परमेस्वर के पवित्र लोगन कै जो-जो चीजन की जरूरत होबै, बामै उन सबन की मदत करौ; खातिरदारी करत रहबौ।<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:44">मत्ती 5:44</ref>; <ref loc="LUK 6:28">लूका 6:28</ref> </char>
    </note>अपने सतान बारेन कै आसीस देबौ; हाँ, आसीस देबौ बद्‌दुआ मत देबौ। <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />खुसी मनान बारेन के संग खुसी मनाबौ, और रोन बारेन के संग रोबौ। <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" /><note caller="+" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="ROM 3:7">3:7</ref> </char></note>आपस मैं एकै सो मन और सोच रखाबौ; घमंडी मत होबौ, लेकिन गरीबन के संग भी संगती रखन को मन रखौ; खुद की नजर मैं ग्यानी मत बनौ।<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />बुराई के बदला मैं बुराई मत करौ; जो-जो बात सबन के ताहीं भली हैं, उनकी चिंता करौ। <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />जित्तो हुई सकै, तुम सब आदमिन के संग मेल करकै रहबौ। <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" /><note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 32:35">व्यवस्थाविवरन 32:35</ref></char></note>मेरे प्रिय भईय्यौ, बहेनियौ, बदला मत लियो, लेकिन परमेस्वर के गुस्सा कै मौका देबौ, काहैकि सास्त्र मैं लिखो है, “बदला लेनो मेरो काम है, प्रभु कहथै महीं बदला लेंगो।” <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" /><note caller="+" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="PRO 25:21">नीतिवचन 25:21</ref>,<ref loc="PRO 25:22">22</ref> </char></note>लेकिन “अगर तेरो बैरी भूंको होबै तौ बाकै खानु खबा, और अगर प्यासो होबै तौ बाकै पानी पिबा; काहैकि ऐसो करन से तू बाकी मुड़िया मैं आगी के अंगरन की ढ़ेरी लगागो।” <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />बुराई से मत हारियो, पर भले काम करकै बुराई कै जीत लियो।<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">राज्य के अधिकारिन ताहीं जिम्मेदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />सबै आदमी अपने आप सासकीय अधिकारियन के सुपर्त रहमैं, काहैकि कोई को अधिकार ऐसो हईये नाय जो परमेस्वर के घाँईं से ना होबै; और जो अधिकार हैं, बे परमेस्वर के बनाये भै हैं। <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />तभईये जो भी कोई अधिकार को बिरोध करथै, बौ परमेस्वर के नियम को सामना करथै, और सामना करन बारे सजा पामंगे। <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />पर सासक अच्छे काम के ताहीं नाय, पर बुरे काम के ताहीं डर को कारड़ हैं; अगर तुम अधिकारिन से डरानो नाय चाहथौ तौ अच्छे काम करौ। और जो ताहीं है बहे करौ, तौ बे तुमरी बड़ाँईं करंगे, <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />काहैकि बौ तेरी भलाई ताहीं परमेस्वर को सेवा करन बारो है। लेकिन अगर तैं बुरे काम करथै तौ-तौ डरा, काहैकि बे तलवार खालिमूलि मैं नाय लै हैं; और परमेस्वर की सेवा करन बारे सेवक हैं कि बाके गुस्सा से बुरे काम करन बारेन कै सजा देबै। <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />तभईये अधिकारिन के सुपर्त मैं रहनो नाय सिरफ बाके गुस्सा के डर से जरूरी है, बल्किन विवेक भी जहे गभाई देथै।<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />तभईये चुंगी<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false">टैक्स</char></note> भी देबौ काहैकि सासन करन बारे परमेस्वर की सेवा करन बारे हैं और हमेसा जहे काम करत रहथैं। <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />जहे बजह से उनको कर्तव्य उनकै दे करौ; जोकै चुंगी चहाईये बाकै, चुंगी देबौ; जोसे डरानो चहाईये, बासे डराबौ; जोको आदर करनो चहाईये, बाको आदर करौ।<verse eid="ROM 13:7" /></para>
  <para style="s">एक दुसरे के ताहीं कर्तव्य</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />आपस के प्यार कै छोड़ और कोई सी बात मैं कोई के कर्जदार मत हुइयो; काहैकि जो दूसरेन से प्यार करथै, बहे नियम कै मानी है। <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />काहैकि “व्यभिचार मत करियो, हत्या मत करियो, चोरी मत करियो, लालचौ मत करियो,” और इनकै छोड़कै औरौ कोई सी आग्या होबै तौ जौ पूरे को तोड़ जौ बात मैं मिलथै, कि “अपने पड़ोसियन से अपनेई हानी प्यार करियो।” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />प्यारै है जो पड़ोसियन की कछु बुराई नाय करथै, तभईये प्यार रखनो तौ नियम कै माननो है।<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />समय कै देखभार कै ऐसियै करौ, तभई कि अब तुमरे ताहीं नींद से जगन की बेरा आए गई है; काहैकि जो घड़ी हम बिस्वास करे रहैं, बौ समय की सोच से अब आपन को उद्धार झोने है। <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />रात बीतन बारी है, और दिन निकरन बारो है; तभई हम अंधियारे के कामन कै छोड़कै उजीतो के हथियार भाँद लेमैं। <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />जो-जो दिन जैसे-जैसे सोभा देथैं, बैसिये हम सई ढंग से चलैं, ना कि मौज मस्ती और पीन-पान मैं, ना व्यभिचार, और ना घटिया काम करन मैं, और लड़ाई और नफरत से दूर रहमैं। <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />बल्किन प्रभु ईसु मसीह कै पहन लेबौ, और सरीर की इच्छन कै पूरो करन को मत सोचौ।<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">एक दुसरे कै दोस मत देबौ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />जो बिस्वास मैं कमजोर हैं, उनकै अपने अच्छे विवेक के चाल-चलन मैं मिलाए लेबौ, लेकिन उनकी राय मैं बहस करन के ताहीं नाय। <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />कोई कै बिस्वास है कि सब कछु खानो सई है, लेकिन जो बिस्वास मैं कमजोर हैं सागपात खाथैं। <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />सब कछु खान बारो ना खान बारे के ऊपर दोस लगान को फैसला ना करे और ना खान बारो सब कछु खान बारे के ऊपर दोस ना लगाबै; काहैकि परमेस्वर बाकै अपनाय लई है। <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />तू कौन है जो दुसरेन की सेवा करन बारेन के ऊपर दोस लगाथै? बाको बनो रहनो या गिर जानो बाके मालिक से रिस्ता रखथै; बल्किन बौ एकै जघा कर दौ जागो; काहैकि न्याई प्रभु बाकै टिकाय सकथै। <verse eid="ROM 14:4" /><verse number="5" style="v" sid="ROM 14:5" />कोई तौ एक दिन कै दुसरे दिन से बढ़कै मानथैं और कोई तौ सबै दिनन कै एक जैसो मानथैं। सबै अपने-अपने दिमाक मैं का बिस्वास करने है बाकै जानन ताहीं फैसला करनो जरूरी है। <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />जो, जे दिन कै मानथैं; बौ प्रभु के ताहीं मानथैं। जो मन से खाथैं, बे प्रभु के ताहीं खाथैं, काहैकि बे परमेस्वर को धन्यवाद करथैं, और जो नाय खाथैं बेऊँ प्रभु के ताहीं नाय खाथैं और परमेस्वर को धन्यवाद करथैं। <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />काहैकि हममैं से ना तौ कोई अपने ताहीं जीथै और ना कोई अपने ताहीं मरथै। <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />अगर हम जिंदे हैं तौ प्रभु के ताहीं जिंदे हैं; और अगर मरथैं तौ, प्रभु के ताहीं मरथैं; अब चाँहे हम मरैं या जीमैं प्रभुए के हैं। <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />काहैकि मसीह तभई मरो और जिंदो भी भौ कि बौ मरे भैन और जिंदेन दोनों को प्रभु होबै। <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />फिर तुम, जो खाली साग सब्जी खाथैं, तुम दुसरेन के ताहीं फैसला काहे सुनाथौ? और तुम जो कुछ भी खाथौ, तुम दुसरे विस्वासी भईय्यन को तिरस्कार काहेकै करथौ? हम सब परमेस्वर के सामने खड़े होंगे कि बाके जरिये न्याय करो जाबै। <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />काहैकि सास्त्र मैं लिखो है,</para>
  <para style="q1" vid="ROM 14:11">प्रभु कहथै, “जैसे मैं हमेसा से जिंदो परमेस्वर हौं, सबै मेरे अग्गु घूँटे टेक देंगे,</para>
  <para style="q2" vid="ROM 14:11">और सबन की जीब परमेस्वर को अंगीकार<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">कोई बात या कोई कै अपनानो</char></note> करैगी कि महीं परमेस्वर हौं।”<verse eid="ROM 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 14:12" />तभईये हम सबन मैं से सबै परमेस्वर कै अपनो-अपनो हिसाब देमंगे।<verse eid="ROM 14:12" /></para>
  <para style="s">एक दुसरेन के गिरन की बजह मत बनौ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />अब हम एक दुसरे के ऊपर दोस ना लगामैं, लेकिन तुम जौ ठान लेबौ कि खुद से कहु ऐसो करन को फैसला नाय करनो चाहिए, जोसे दुसरे भईय्यन कै ठोकर लगै या बे पाप मैं गिरैं। <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />मैं जानथौं और प्रभु ईसु को चेला होन के नाते मेरो बिस्वास है कि कोई चीज अपने आप से असुद्ध ना है, लेकिन जो बाकै असुद्ध समझथै बाके ताहीं असुद्ध है। <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />अगर तुमरे कोई चीज के खान से तुम दुसरे भईय्यन कै ठेस पहोंचाथौ, तौ तुम प्यार से नाय चलथौ। अगर कोई कै बुरो लगथै तौ बौ चीज खान कै मत देबौ नाय तौ तुम बौ आदमी कै बरबाद करथौ, जोके ताहीं ईसु मसीह मर गौ रहै। <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />अब जो तुमरे ताहीं भलो है बाकी बुराई मत करौ। <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />काहैकि परमेस्वर को राज्य खान-पीन को ना है, लेकिन धर्म और मेल-मिलाप और बौ खुसी सांति को है जो पवित्र आत्मा से मिलथै। <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />जो ऐसे करकै मसीह ईसु की सेवा करथै बौ परमेस्वर कै भाथै और इंसानन के बीच मैं अपनाओ जाथै।<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />इसलै हम उन बातन मैं लगे रहमैं, जोसे सांति कै बढ़ावा मिलथै और जिनके जरिये हम एक-दूसरे को निर्माड़ कर सकैं। <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />खान-पीन के ताहीं परमेस्वर को काम मत बिगाड़ै। सब कछु सुद्ध तौ है, लेकिन ऐसो कछु नाय खानो चाहिए जो कोई और कै पाप मैं डार देबै। <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />ठीक तौ जौ है कि तू ना तौ सिकार खा और ना दाखरस पी, और नाय कछु ऐसो कर जोसे तेरो भईय्या और बहेनिया ठोकर खाबै। <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />तेरो जो बिस्वास होबै, बाकै परमेस्वर के अग्गु अपनेई मन मैं धर। धन्य है बौ जो बौ बात मैं, जोकै बौ सई समझथै, और बाके परखे जाने मैं गलत ना बताथै! <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />पर जो संका करकै खाथै, बौ सजा देन ताहीं हुई चुको, काहैकि बौ बिस्वास से नाय खाथै; और जो कछु बिस्वास से नाय है, बौ पाप है।<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">दुसरेन कै बढ़ाबौ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />हम जो बिस्वास मैं मजबूत हैं उनकै अपनो बोझ ढोन के ताहीं मदत करनो चाहिए। हमैं खुदकै खुस नाय करनो चाहिए। <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />जाके अलावा हम सब भईय्या और बहेनियन कै बिस्वास मैं बढ़ान के ताहीं उनकी भलाई के लै दुसरे विस्वासियन कै खुस करनो चाहिए। <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" /><note caller="+" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="PSA 69:9">भजन संहिता 69:9</ref> </char></note> काहैकि मसीह महिमा के ताहीं खुस नाय करी, जाके बजाय, जैसो सास्त्र मैं लिखो है: “जो अनादर तेरो भौ है, बौ मेरे ऊपर भौ है।” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />सास्त्र मैं लिखी हर बात हमैं पढ़ान के ताहीं लिखी गई है, कि आदेस मैं हम धीरज और प्रोत्साहन के जरिया से आसा कर सकथैं जो सास्त्र हमैं देथै। <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />और परमेस्वर धीरज और प्रोत्साहन कै देन बारो है, ईसु मसीह के उदाहरड़ कै अपनाय कै आपस मैं एक जैसी सोच के जरिया देखन मैं काबिल होबौ, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />जोसे तुम सब मिलकै और एक सुर मैं हमरे प्रभु ईसु मसीह और परमपिता परमेस्वर की महिमा करौ।<verse eid="ROM 15:6" /></para>
  <para style="s">गैर यहूदिन के ताहीं सुसमाचार</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />फिरौंकी, परमेस्वर की महिमा के ताहीं, एक दुसरे कै अपनाय लियौ, जैसे मसीह भी तुमकै अपनाई है। <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />काहैकि मैं तुमसे कहथौं, कि परमेस्वर की सच्चाई के घाँईं से मसीह यहूदिन को सेवक बनो, कि पुरखन से करे गै वादा कै पूरो करो जाबै, <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />और गैर यहूदियन कै भी बाकी दया के ताहीं परमेस्वर की महिमा करन के काबिल बनाने है। जैसी कि सास्त्रन मैं लिखो है:</para>
  <para style="q1" vid="ROM 15:9">“तभईये मैं गैर यहूदियन मैं तुमरी बड़ाँईं करंगो;</para>
  <para style="q2" vid="ROM 15:9">और तेरे नाओं को गीत गांगो।”<verse eid="ROM 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 15:10" />फिर से कही है,</para>
  <para style="q1" vid="ROM 15:10">“गैर यहूदियौ, परमेस्वर के संग खुसी मनाबौ!”<verse eid="ROM 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 15:11" />और फिर</para>
  <para style="q1" vid="ROM 15:11">“गैर यहूदियौ, प्रभु की स्तुति करौ;</para>
  <para style="q2" vid="ROM 15:11">सब जनी बाकी प्रसंसा करौ!”<verse eid="ROM 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 15:12" />और फिरौंकी यसायाह भविस्यवक्तौ कहथै,</para>
  <para style="q1" vid="ROM 15:12">“यिसै<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false">राजा दाऊद को बाबा</char></note> के घराने की जड़ दिखाई देबैगी,</para>
  <para style="q2" vid="ROM 15:12">और गैर यहूदियन को सासन होन के ताहीं एक उठैगो, बाके ऊपर बे आस लगाए रखांगे।”<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />परमेस्वर जो आसा को देन बारो है तुमकै बिस्वास करन मैं सब हानी खुसी और सांति से भरै, कि पवित्र आत्मा की सामर्थ्य से तुमरी आसा बढ़त चली जाबै।<verse eid="ROM 15:13" /></para>
  <para style="s">हिम्मत से लिखन की बजह</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />मेरे भईय्यौ और बहेनियौ; मैं पक्को बिस्वास है कि तुम लोग भलाई से भरे हौ, और तुमरियौ पास ग्यान है, और तुम एक दुसरे कै सिखान ताहीं समझाए सकथौ। <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />तहुँओं मैं कहु-कभार याद दिबान ताहीं तुमकै जौ खूबै हिम्मत करकै लिखो हौं, जौ बौ अनुग्रह के कारड़ भौ, जो परमेस्वर मोकै सामर्थ्य दई है। <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />कि मैं गैर यहूदि के ताहीं मसीह ईसु को सेवक हुईकै परमेस्वर के सुसमाचार की सेवा पुजारी के हानी करौं; कि गैर यहूदि पवित्र आत्मा के जरिये बाकै समर्पित करी गई भेंट होमैं, जो परमेस्वर के भाँति है। <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />तभईये बे बातन के बारे मैं जो परमेस्वर से जुड़ी हैं, मैं मसीह ईसु मैं बड़ाँईं कर सकथौं। <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />मैं निडर रैहंगो और खाली बाके बारे मैं बोलंगो जो मसीह परमेस्वर के हुकम को पालन करन के ताहीं गैर यहूदियन के अगुवाई मैं करी है। मसीह सब्दन और करमन के जरिये ऐसो करी है, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />और चिन्ह, अचम्मे कामन से और परमेस्वर के आत्मा के सामर्थ्य से पूरे करे गै हैं। हिंयाँ तक मैं यरूसलेम से लैकै सबै घाँईं इल्लुरिकुम तक मसीह के सुसमाचार कै पूरो फैलाओ। <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />पर मेरो मन जौ है, कि जितै-जितै मसीह को नाओं नाय लौ गौ, हूँनै सुसमाचार सुनामौ; ऐसो ना होबै, कि दुसरेन की बुनियाद मैं घर बनामौं। <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />लेकिन जैसो सास्त्र मैं लिखो है:</para>
  <para style="q1" vid="ROM 15:21">“जोके बारे मैं नाय बताओ गौ रहै, बे देखंगे,</para>
  <para style="q2" vid="ROM 15:21">और जो नाय सुनीं बेईं समझंगे।”<verse eid="ROM 15:21" /></para>
  <para style="s">रोम देस जान की पौलुस की योजना</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />और तभईये मोकै निरे दाँव तुमरे झोने आन से रोक रखाईं रहैं। <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />लेकिन अब जे देसन मैं मेरे काम के ताहीं जघा ना रइ, और निरे सालन से मेरो तुमरे झोने आन को मन रहै, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />और बौ अभई करन कि आसा रखथौं। तभईये जब मैं स्पेन देस जांगो तौ तुमरे झोने होत भौ जांगो, काहैकि मोकै आसा है कि सफर मैं तुमसे भेंटा करंगो, और जब तुमरी संगती से थोड़ी सो मेरी इच्छा भर जागी, तौ तुम्हईं मोकै थोड़ी दूर अग्गु पनार दियो। <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />लेकिन हबै तौ पवित्र आदमिन की सेवा करन ताहीं यरूसलेम नगर कै जाथौं। <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />काहैकि मकिदुनिया और अखाया कलीसिया के आदमिन कै अच्छो लगो, कि यरूसलेम नगर के परमेस्वर के पवित्र लोगन के कंगालन की सहभागिता मैं कछु चन्दा देमैं। <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />बे अपने मन से जौ करीं; पर बे उनके कर्जदार भी हैं, काहैकि अगर गैर यहूदि उनकी आत्मिक बातन मैं मिले भै हैं, तौ उन्हऊँ के ताहीं सई है, कि सरीर की बातन मैं उनकी सेवा करैं। <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />तभईये जौ छाप और काम मैं पूरो करकै और उनको जौ चन्दा दैकै तुमरे घाँईं से होत भौ स्पेन कै चलो जांगो। <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />और मैं जानथौं, कि जब मैं तुमरे झोने आंगो, तौ मसीह की पूरी आसीस के संग आंगो।<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />और भईय्यौ और बहेनियौ, मैं ईसु मसीह कै जो हमरो प्रभु है और पवित्र आत्मा के प्यार कै याद दिबाए कै, तुमसे नहोरे करथौं: कि मेरे ताहीं परमेस्वर से प्रार्थना करन मैं मेरे संग मिलकै डटे रहाबौ। <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />प्रार्थना करैं कि मैं यहूदिया देस के अविस्वासियन से बचो रहामौ, और मेरी बौ सेवा जो यरूसलेम के ताहीं है, पवित्र आदमी अपनाय लेमैं। <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />और मैं परमेस्वर की इच्छा से तुमरे झोने खुसी से आयकै तुमरे झोने सस्तामौं। <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />सांति को परमेस्वर सच्ची मैं तुम सबन के संग रहबै। आमीन।<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">अपने घाँईं से बहेनिया फीबे कै आदर देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />मैं तुमकै हमरी बहेनिया फीबे कै सौंपथौं, जो किंख्रिया मैं कलीसिया की सेवकी है। <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />जैसी तुम पवित्र आदमिन कै अपनाथौ, बैसिये प्रभु मैं बाकै अपनाबौ; और जो-जो बात मैं बाकै तुमरी जरूरत होबै, बाकी मदत करौ, काहैकि बहो निरेन की बल्किन मेरियौ मदत करी रहै।<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />प्रिस्किल्ला<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">प्रिसका अक्विला की बईय्यर रहै जे सादी सुदा जोड़ा रहैं और बिस्वास मैं खूबै मजबूत रहैं</char></note> और अक्विला<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">जौ पौलुस हानी टैंट बनात रहै अपनो गुजर बसर करन ताहीं</char></note> कै जो ईसु मसीह मैं मेरे संग काम करन बारे हैं, नमस्ते। <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />बे मेरे ताहीं अपनी ज्यान कै खतरा मैं डारथैं, मैं उनको बड़ा एहसान मंद हौं, और नाय सिरफ महीं, बल्किन गैर यहूदि की सबै कलीसियौ उनको धन्यवाद करथैं। <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />और बहो कलीसिया कै नमस्ते जो उनके घर मैं बनी हैं। मेरे प्रिय दिलबर इपैनितुस (इफिसुस) कै जो मसीह के ताहीं आसिया को पहलो फल है, नमस्ते। <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />मरियम कै जो तुमरे ताहीं खूबै मेहनत करी, नमस्ते। <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />अन्द्रुनीकुस और यूनियास कै जो मेरे हितुआ-नातेदार हैं, और मेरे संग कैदखाना मैं गै रहैं, प्रेरित होन मैं खूब नाओं बारे हैं, और मोसे पहले मसीह बन गै रहैं, उनकै नमस्ते।<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />अम्पलियातुस कै, जो प्रभु मैं मेरो प्रिय है, नमस्ते। <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />उरबानुस कै, जो मसीह मैं हमरे संगै कामन मैं चलन बारो है, और मेरो प्रिय इस्तखुस कै नमस्ते। <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />अपिल्लेस जो मसीह मैं खरो निकरो, उनको नमस्ते, बे लोगन के नमस्ते जो एरिस्टोबुलस के परिवार से सम्बधित हैं। <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />मेरे संग के यहूदि हेरोदियोन कै नमस्ते। नरकिस्सुस के घराने कै जो लोग प्रभु मैं हैं, उन्हऊँ कै नमस्ते।<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />बहेनिया तुरुफैना और बहेनिया तुरुफोसा कै जो प्रभु मैं मेहनत करथैं, नमस्ते। प्रिय पिरसिस कै जो प्रभु मैं खूब मेहनत करीं, नमस्ते। <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />रूफुस कै जो प्रभु मैं चुनो भौ है, और बाकी अईय्या कै भी नमस्ते, जो हमेसा मोकै अपनो बेटा हानी मानी। <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />असुंक्रितुस और फिलगोन और हर्मास, पत्‌रुबास, हिरमेस और उनके संग के दुसरे मसीह भईय्या और बहेनियन कै नमस्ते। <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />फिलुलुगुस और यूलिया और नेरेउस और बाकी बहेनिया, और उलुंपास और उनके संग के सब परमेस्वर के पवित्र लोगन कै नमस्ते। <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />आपस मैं पवित्र चुम्मी से नमस्ते करौ: तुम्हऊँ कै मसीह की पूरी कलीसियन की तरफ से नमस्ते।<verse eid="ROM 16:16" /></para>
  <para style="s">आखरी उपदेस</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />अब मेरे भईय्यौ और बहेनियौ; मैं तुमसे नहोरे करथौं, कि तुम बे आदमिन से सावधान रहाबौ, जो फूट डारथैं और दूसरेन के ताहीं पाप को बजह बनथैं। ऐसो व्यवहार बौ सिक्छा से मेल ना खाथै, जो तुमकै मिली है, तुम ऐसे लोगन से दूर रहबौ। <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />काहैकि ऐसे आदमी हमरे प्रभु मसीह कि नाय, लेकिन अपने पेट की सेवा करथैं; और चिकनी चुपड़ी बातन से सीधे-सादे मन बारे लोगन कै बहकाये देथैं। <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />सबै तुमरे सुसमाचार की इमानदारी के बारे मैं सुन लईं हैं, जौ मेरे ताहीं खुसी की बात है, तहुँओं मेरी जहे इच्छा है कि तुम भलाई के ताहीं अकलदार और बुराई के ताहीं भोले बने रहबौ। <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />सांति को परमेस्वर जल्दियै सैतान कै तुमरी टाँग के तरे कुचल देगो, हमरे प्रभु ईसु मसीह की दया तुमरे ऊपर बनी रहबै।<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />मेरे संगी तीमुथियुस को और मेरे साथी यहूदि लूकियुस, यासोन और सोसिपत्‌रुस को तुमकै नमस्ते।<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />जौ लेख को लिखन बारो, तिरतियुस को तुमकै प्रभु मैं नमस्ते।<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />गयुस को, जोके हिंयाँ मैं हितुआ हौं और जोके घर मैं कलीसिया के लोग आराधना करथैं, तुम्हऊँ कै नमस्ते। सहर के कोसाध्यक्छ एरास्तुस और हमरे भईय्या क्वार्तुस को तुमकै नमस्ते। <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />हमरे प्रभु ईसु मसीह को अनुग्रह तुमरे ऊपर हमेसा रहबै आमीन।<verse eid="ROM 16:24" /></para>
  <para style="s">स्तुति की प्रार्थना</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />अब जो तुमकै मेरे सुसमाचार मतलब ईसु मसीह के बारे मैं उपदेस के अनुसार निठाठौर कर सकथै, बौ भेद के उजियारे के अनुसार जो अनंत से लुको रहो। इसलै आबौ आपन परमेस्वर कि महिमा करैं! <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />लेकिन अब दिखाई दौ है कि अनंत परमेस्वर की आग्या से भविस्यवक्तन के सास्त्रन के जरिया सब जाति कै बताओ गौ है, कि बे बिस्वास से आग्या मानन बारे हुई जामैं।<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />बहे इकल्लो परमेस्वर जो बुद्धिमान है, की ईसु मसीह के जरिये सच मैं हमेसा-हमेसा महिमा होत रहबै। आमीन।<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>