<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Rana Tharu</book>
  <para style="h">उत्पत्ति</para>
  <para style="toc3">उत्पत्ति</para>
  <para style="toc2">उत्पत्ति</para>
  <para style="toc1">उत्पत्ति</para>
  <para style="mt2">सिरजन की कहानी</para>
  <para style="mt1">उत्पत्ति</para>
  <para style="imt">परिचय</para>
  <para style="ip">उत्पत्ति नाओं को मतलब है सुरूवात। जगत की सृस्टि, मानव जाति की उत्पत्ति, जौ संसार मैं पाप और दु:ख की सुरूवात, और परमेस्वर को मानव जाति के संग व्यवहार को वर्ड़न जौ किताब में मिलथै। उत्पत्ति कै दुईं प्रमुख भागन मैं अगल करो जाए सकथै।</para>
  <para style="ip">1. <char style="bd">अध्याय 1-11</char> दुनिया की सृस्टि और मानव जाति को सुरूवात को इतिहास। जामैं आदम और हव्वा, कैन और हाबिल, नूह और जल प्रलय, और बेबीलोन के गुम्मट को वर्ड़न मिलथै।</para>
  <para style="ip">2. <char style="bd">अध्याय 12-50</char> इस्राएलियन के सुरूवाती पूर्वजन को इतिहास। जामैं पहलो अब्राहम है, जो परमेश्‍वर के ऊपर अपनो विस्वास और बाके प्रति अपनी आग्याकारिता के वजह से प्रसिद्ध रहै। जाके बाद बाको लौड़ा इसहाक, और धुईतो याकूब (जो इस्राएल भी कहो जाथै) को वर्ड़न है; तौ याकूब के बारह लौड़न को वर्ड़न है, जो इस्राएल के बारह गोत्रन के संस्थापक भै। जामैं बाको एक लौड़ा, यूसुफ, और बे घटना के बारे मैं ध्यान दौ गौ है, जोके जरिये याकूब और बाके दुसरे लौड़ा अपने परिवारन सुंदा मिस्र मैं रहन के ताहीं आएगै रहैं। और जौ किताब लोगन के बारे मैं बताथै, फिर भी मुख्यत: जौ परमेस्वर के कामन को वर्ड़न करथै। जाकी सुरूवात जौ स्वीकृति से होथै कि परमेस्वर जगत की सृस्टि करी, और अंत जौ प्रतिग्या से होथै कि परमेस्वर निरंतर अपने लोगन की चिन्ता करत रहेगो। किताब की सुरूवात से अंत ले मुख्य पात्र परमेस्वर है, जो बुराई करनेबारेन कै दोसी ठहराथै और उन्हैं दंड देथै; बौ अपने लोगन की अगुवाई और मदत करथै, और उनके इतिहास कै व्यवस्थित करथै। जौ प्राचीन किताब एक जाति के विस्वास को वर्ड़न करन और बौ विस्वास कै बनाए रखन में मदत के ताहीं लिखी गई रहै।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">जगत और मानव जाति की सृस्टि<char style="ior"><ref loc="GEN 1:1-2:25">1:1–2:25</ref> </char></para>
  <para style="io1">पाप और दु:ख की सुरूवात <char style="ior"><ref loc="GEN 3:1-24">3:1-24</ref></char></para>
  <para style="io1">आदम से नूह तक <char style="ior"><ref loc="GEN 4:1-5:32">4:1–5:32</ref> </char></para>
  <para style="io1">नूह और जल प्रलय <char style="ior"><ref loc="GEN 6:1-10:32">6:1–10:32</ref> </char></para>
  <para style="io1">बेबीलोन का गुम्मट <char style="ior"><ref loc="GEN 11:1-9">11:1-9</ref></char></para>
  <para style="io1">सेम से अब्राम तक <char style="ior"><ref loc="GEN 11:10-32">11:10-32</ref></char></para>
  <para style="io1">कुलपति अब्राहम, इसहाक, याकूब <char style="ior"><ref loc="GEN 12:1-35:29">12:1–35:29</ref></char></para>
  <para style="io1">एसाव की वंसावली <char style="ior"><ref loc="GEN 36:1-43">36:1-43</ref> </char></para>
  <para style="io1">यूसुफ और बाके भईय्या <char style="ior"><ref loc="GEN 37:1-45:28">37:1–45:28</ref> </char></para>
  <para style="io1">मिस्र देस मैं इस्राएली <char style="ior"><ref loc="GEN 46:1-50:26">46:1–50:26</ref></char></para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">सिरजन की कहानी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />सुरुवात मैं, जब परमेस्वर स्वर्ग और पृथ्वी<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">दुनिया</char></note> कै बनाई, <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />पृथ्वी सुनसान और उजाड़ पड़ी रहै। और अथा गहरे पानी के ऊपर अंधियारो रहै, और परमेस्वर को आत्मा पानी के ऊपर मँडरात रहत रहै। <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" /><note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">2 कुर 4:6</char></note>तौ परमेस्वर आग्या दई, “उजियारो हो” और उजियारो ही गौ। <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />परमेस्वर उजियारे कै देखी और बौ अच्छो रहै। फिर बौ उजियारे कै अंधियारो से अलग करी, <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />और प्रभु उजियारे कै “दिन” और अंधियारे कै “रात” नाओं दई। संजाखिन को समय बीतो और भोर भौ-ऐसे करकै पहलो दिन पूरो हुई गौ।<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />फिर परमेस्वर आग्या दई, “कि पानी के बीच मैं दुई हिस्सा बनकै वायुमंडल बन जाबै, ताकि पानी से अलग हुई सकै।” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />तौ परमेस्वर पानी कै पानी से अलग करी और बीच मैं वायुमंडल बनाई और ऐसोई हुई गौ। <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />प्रभु वायुमंडल को नाओं “आसमान” रखी। संजाखिन को समय बीतो और भोर भौ-ऐसे करकै दुसरो दिन पूरो हुई गौ।<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />परमेस्वर आग्या दई, “आसमान के नीचे को पानी सब एक जघा मै जुराए जाबै, कि सूखी जमीन दिखाई देबै” और बैसिये हुई गौ। <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />बौ जौ सूखी जमीन को नाओं “पृथ्वी” रखी, और जो पानी जुरानो भौ रहै बाको नाओं “समुंदर” रखी। और परमेस्वर देखी, कि बौ अच्छो है। <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />तौ परमेस्वर आग्या दई, “पृथ्वी” से सब तराहनी के पेंड़-पौधा जमैं, चाँहे अन्न पैदा करन बारे होमैं, चाहें फल लान बारे होमैं और बैसोई ही गौ। <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />फिर पृथ्वी मैं सब तराहनी के पेंड़-पौधा जमें, जो बीजधारी पौधे फलदायक पेंड़ जो अपने-अपने जाति के हिसाब से जमें, परमेस्वर देखी कि जौ अच्छो है। <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />संजा बीती भोर भौ-ऐसे करकै तीसरो दिन हुई गौ।<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />तौ परमेस्वर आग्या दई, “दिन कै रात से अलग करन के ताहीं आसमान के वायुमंडल मैं जोती होमैं, और मौसम, दिन और साल के चिन्ह बनै। <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />बे पृथ्वी मैं उजियारो देन के ताहीं आसमान मैं चमकंगे और ऐसोई भौ।” <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />तौ परमेस्वर प्रभुता करन के ताहीं दुई जोती बनाई दिन के ताहीं सूरज, और रात मैं प्रभुता करन के ताहीं जोनी; और तारा भी बनाई। <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />प्रभु पृथ्वी मैं उजियारो देन के ताहीं आसमान मैं जोतियन कै रखी, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />दिन और रात के ऊपर प्रभुता करन के ताहीं उजियारे कै अंधियारे से अलग कर दई। परमेस्वर देखी कि अच्छो है। <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />संजा बीती भोर भौ, ऐसे करकै चौथो दिन हुई गौ।<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />परमेस्वर फिर कही, “पानी, कई तराहनी के जिंदे प्राड़िन से भर जाबै, और आसमान तमान तरहन के पक्छिन से भर जाबै।” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />ऐसे करकै परमेस्वर बड़े-बड़े पानी के जन्तुन कै बनाई, और पानी मैं हर तरहन के रहनबारे प्राड़ी और हर तरहन के पक्छिन कै बनाई। और ऐसो होत सब देखकै परमेस्वर कहथै कि अच्छो है। <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />और प्रभु जौ कहकै सबन कै आसीस दई कि पानी मैं रहनबारे सब प्राड़ी समुंदर मैं भर जाबौ, और पक्छी अनगिनत गिनती मैं बढ़ैं। <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />संजा बीती और भोर भौ-ऐसे करकै पाँचमों दिन हुई गौ।<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />तौ परमेस्वर फिर आग्या दई, पृथ्वी के जीव जन्तुन कै अपनी जाति के हिसाब से सब तराहनी के पैदा हुई जामैं मतलब पालतू जानवर, नेंगनबारे जन्तु और जंगली जन्तु पैदा होमैं - और बैसोई भौ। <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />परमेस्वर हर तराहनी के जंगली जानवर और हर तराहनी के पालतू जानवर और हर तराहनी के नेंगन बारे जानवरन कै बनाई, और परमेस्वर जौ देखी कि अच्छो है।<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />फिर परमेस्वर कही, “आबौ हम इंसान कै अपने स्वरूप और समानता के हिसाब बनामैं; ताकि बे समुद्र की मच्छिन, और आसमान के पक्छिन, और पालतू जानवर, और बन जानवर, और पूरी पृथ्वी मैं सब नेंगनबारे जन्तुन मैं, उनके ऊपर अधिकार रखैं।” <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />तौ परमेस्वर अपने स्वरूप इंसान जाति कै बनाई, और परमेस्वर के स्वरूप मैं बौ इंसान कै बनाई, परमेस्वर उनकै नर और नारी के रूप मैं बनाई।<note caller="+" style="f"><char style="fr" closed="false">1:27 </char><char style="ft" closed="false">मत्ती 19:4, मरकुस 10:6, प्रेरितों के काम 17:29, 1 कुरिन्थियों 11:7, कुलिस्सियों 3:10, 1 तीमुथियुस 2:13</char></note> <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />और परमेस्वर उनकै आसीस दई, और उनसे कही, “तुम फूलौ-फलौ, और पृथ्वी मैं भर जाबौ, और उनकै अपने अधिकार मैं कर लेबौ; और समुद्र कि मच्छियन, आसमान के पक्छिन, और पृथ्वी मैं नेंगन बारे सब जन्तुन के ऊपर तुमरो अधिकार हो।” <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />और परमेस्वर उनसे कही, देखौ मैं तुमकै सब बीज बारे पेंड़ पौधा और सब फलन बारे पेंड़ दौ हौं, जे फल तुम्हारे खानू के ताहीं होगो।<note caller="+" style="f"><char style="fr" closed="false">1:29 </char><char style="ft" closed="false">रोमियो 14:2</char></note> <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />और जितने पृथ्वी के जानवर, और आसमान के पक्छी, और धरती मैं नेंगन बारे जन्तु, हर एक प्राड़िन जिनमैं जिंदगी की साँस हैं, मैं उनकै हरे पौधा आहार के ताहीं दौ हौं। <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />परमेस्वर जो सब कुछ बनाई रहै, और बौ जौ देखकै कहथै कि अच्छो है। संजा बीती और भोर भौ-ऐसे करकै छठमों दिन बीत गौ।<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />और ऐसिये करकै स्वर्ग और पृथ्वी और हर एक चीजन की रचना पूरी भई। <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />और परमेस्वर अपनो काम जो बौ करत रहै सातमें दिन खतम करी, और बौ अपने करे भै पूरे काम से सातमें दिन विस्राम करी। <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />बौ सातमों दिन कै आसीस दई, बाकै पवित्र और बाकै एक खास दिन ठहराई, काहैकि परमेस्वर बौ दिन पृथ्वी के सब काम से विस्राम करी। <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />स्वर्ग और पृथ्वी की रचना को इतिहास जहे है, इंसान की उत्पत्ति को दुसरे वर्ड़न, प्रभु परमेस्वर स्वर्ग और पृथ्वी कै सिरजाई।<verse eid="GEN 2:4" /></para>
  <para style="s">अदन की बगिया</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 2:5" />तौ पृथ्वी मैं कोई तराहनी के पेंड़-पौधा ना रहैं, और न कोई बीज जमे रहैं काहैकि प्रभु मेंहें न बरसाई रहै, और जमीन मैं खेती करन बारो भी कोईये इंसान न रहै; <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />लेकिन पानी ऊपर जाएकै कोहरा बन कै गिरत रहै तौ पूरी जमीन ओस से छिंछ जात रहै।<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />फिर प्रभु परमेस्वर जमीन से थोड़ी मट्टी लई, और बासे एक आदमी बनाई; और बौ बाकी नाक मैं जिंदगी की साँस फूँकी और बौ जिंदो प्राड़ी बन गौ।<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />फिर प्रभु परमेस्वर अगार की दिसा मैं अदन मैं एक बगिया लगाई, और हूँना पर बौ इंसान कै रखी जो बौ बाकै बनाई रहै। <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />प्रभु हूँना सब तराहनी के सुगड़ पेंड़ जमाईं और उनके फल खान मैं अच्छे रहैं। बगिया के बीच मैं भले-बुरे को ग्यान देन बारो एक पेंड़ भी रहै।<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">प्रकासितवाक्य 2:7; 22:14</char></note><verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />अदन मै एक नदिया की धारा बहत रहै जो बगिया कै छींचन के ताहीं बनी रहै; जहे नदिया अदन से अग्गु जाएकै चार नदियन मैं बट जाथै। <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />पहली नदिया को नाओं पीसोन है; जौ हवीला देस के चारौ घाँईं बहथै, जहाँ सोना पाओ जाथै। <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />बौ देस मैं सुद्ध सोनो और कीमती जवाहरात इत्र, मोती और कीमती पत्थर भी पाए जाथैं। <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />दुसरी नदिया गिहोन है; और जौ कूस के सब देसन के चारौ घाँईं बहथै। <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />तीसरी नदिया हिद्देकेल है, जो अस्सूर के अगार मै बहथै, और चौथी नदिया फरात है।<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />तौ प्रभु परमेस्वर इंसान कै अदन की बगिया मैं खेती करन और बाकी देखरेख करन के ताहीं रखी। <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />और परमेस्वर इंसान कै आग्या दई, “तैं बगिया के कोई से भी पेंड़ को फल खाए सकथै; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />लेकिन बौ पेंड़ को फल जो भले-बुरे के ग्यान को है। तैं बौ पेंड़ के फल कै कहुए मत खइये। और अगर ऐसो करैगो तौ तू बहे दिन पक्का मर जागो।”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />फिर प्रभु परमेस्वर कही, “आदमी को अकेलो रहनो अच्छो नाय है। मैं बाके ताहीं एक ऐसो सहायक बनांगो जो बाके ताहीं सई होबै।” <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />और प्रभु परमेस्वर जमीन से थोड़ी मट्टी लई और जहे से सब तराहनी के जंगली जानवर और आसमान के पक्छिन कै बनाई। और जे सबन जीव जन्तुन कै इंसान के सामने लाओ गौ और इंसान हर एक को नाओं रखी। <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />बौ आदमी सब तरहन के पालतू जानवरन, और आसमान के पक्छिन, और सबै तराहनी के जंगली जानवरन को नाओं रखी; लेकिन इंसान कै उनमैं से कोईये भी अपने ताहीं सहायक नाय मिलो जोसे बौ मेल खाए सकै।<verse eid="GEN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21" />तौ प्रभु परमेस्वर बौ आदमी कै गहरी नींद मैं सुबाए दई, और जब बौ आदमी सोत रहै, तौ परमेस्वर बौ आदमी की एक पुसरिया निकारी और बाकी जघा मैं बामैं माँस भर दई।<note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="ft" closed="false">1 कुरिन्थियों 11:8</char></note> <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />प्रभु परमेस्वर बौ पुसरिया से जो बौ आदमी से निकारी रहै, बासे एक बईय्यर बनाई; और बौ बाके झोने लै आई।<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">1 तीमुथियुस 2:13</char></note> <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />फिर बौ आदमी कहथै,</para>
  <para style="q1" vid="GEN 2:23">“आखिरकार, जौ मेरिये तराहनी है -</para>
  <para style="q1" vid="GEN 2:23">जौ मेरी हड्डी मैं की हड्डी है, और मेरे माँस मैं को माँस है,</para>
  <para style="q1" vid="GEN 2:23">और जहे बजे से जाको नाओं ‘बईय्यर’ होगो, काहैकि जाकै लोग मैं से निकारो गौ है।”<verse eid="GEN 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24" />जहे बजह से आदमी अपने अईय्या-दऊवा कै छोड़कै अपनी बईय्यर से मिलो रहेगो, और बे एक तन मैं बने रहेंगे।<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />लोग और बईय्यर दोनों नंगे रहैं, लेकिन बे एक दुसरे से सरमात नाय रहैं।<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">इंसान के पाप की सुरुवात</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />सब बन जानवरन मैं साँप भौत चालाँक जानवर रहै जोकै परमेस्वर बनाई रहै। साँप बईय्यर से पूँछी, “का परमेस्वर सच्ची मैं कही रहै, कि तुम बगिया के कोई भी पेंड़ के फल मत खईयो?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />बईय्यर साँप कै जबाब देथै, “हम बगिया के कोई भी पेंड़ के फल खाए सकथैं, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />पर परमेस्वर हमसे कही है, ‘कि तुम जौ बगिया के बीच बारे पेंड़ को फल मत खईयो, बाकै छुईयो भी मति, अगर तुम ऐसो करैगे तौ तुम मर जागे।’”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />तौ साँप बईय्यर कै जबाब देथै, “जौ सच नाय है; तुमरी मौत नाय होगी। <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />काहैकि परमेस्वर जानथै कि अगर तुम जाकै खागे तौ तुमरी आँखी खुल जागी, और तुम भले-बुरे को ग्यान पाएकै परमेस्वर के तराहनी बन जागे।”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />बईय्यर देखी कि पेंड़ कित्तो सुगड़ है और बाको फल खान मैं कित्तो अच्छो होगो, और बौ सोची कि बुध्दिमान बननो कित्तो बढ़िया होगो। फिर बौ कुछ फल कै तोड़ी और बाकै खाई, और कुछ फल बौ अपने लोगा कै भी दई, और बौ भी खाई।<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">1 तीमुथियुस 2:14</char></note> <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />तौ उन दोनों की आँखी खुल गई, और बे जान गै कि बे नंगे हैं; तौ बे अंजीर के पत्ता को नघोटा बनाए कै खुदकै ढोंक लईं।<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />तौ लोगा-बईय्यर बहे संजाखिन कै प्रभु परमेस्वर कै बारी मैं चलत भई सुनीं, और बे पेंड़न के पच्छू प्रभु परमेस्वर से लुक गै। <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />लेकिन प्रभु परमेस्वर बौ आदमी कै चिल्लात भई कही, तू कहाँ है?<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />बौ जबाब दई, “मैं बगिया मैं तेरी अबाज सुनो; और मैं डराएकै तोसे लुक गौ, काहैकि मैं नंगो रहौं।” <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />प्रभु परमेस्वर बासे पूँछी, “तोसे कौन कहो कि तू नंगो है? का तुम बौ फल कै खाए जो मैं तुम्हैं खान से मना करो रहौं?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />आदमी जबाब दई, “जो बईय्यर कै तू मेरे संग रहन कै दौ रहै बहे मोकै बौ पेंड़ को फल खान कै दई, और मैं बाकै खाओ।”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />प्रभु परमेस्वर बौ बईय्यर से कही, तू ऐसो काहे करो? बौ जबाब दई, “साँप मोकै बहकाई तभईये मैं खाओ।”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">रोमी 7:11; 2 कुरि 11:3; 1 तीमुथियुस 2:14 </char></note><verse eid="GEN 3:13" /></para>
  <para style="s">परमेस्वर को न्याय</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />तौ प्रभु परमेस्वर साँप से कही, “तैं जो जौ करो है जौ बजह से तैं सब पालतू जानवर, और सब जंगली जानवरन से जाधे स्रापित है; तैं पेट के बल घिसटैगो, और जिंदगी भर मट्टी चाटत रहगो। <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />मैं तेरे और बौ बईय्यर के बीच और बाकी वंस और तेरी वंस के बीच बैर करांगो। बाके वंस तेरी मुड़िया कै कुचल डारंगे, और तू बाके वंस की एड़ी कै डसैगो।”<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />और प्रभु परमेस्वर बईय्यर से कही, “मैं तेरे गर्भवती होन मैं तेरी पीर और दर्द कै भौत बढ़ांगो, और बहे दर्द के संग तै बालका पैदा करैगी, और तेरे लोगा की लालसा तेरे ऊपर रहबैगी, और तैं बाके आधीन रहबैगी।”<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">1कुरि 11:3; इफि 5:22; कुलि 3:18</char></note> <verse eid="GEN 3:16" /><verse number="17" style="v" sid="GEN 3:17" />और प्रभु परमेस्वर बौ आदमी से कही, “तैं अपनी बईय्यर की बात मानकै बौ फल खाओ, जो फल खान से मैं तोकै मना करो रहौं, तैं जो करो है, बाके बजह से जमीन स्रापित ही गई है। तोकै अपनी जरुरत के ताहीं अन्न पैदा करन के ताहीं जिंदगी भर कड़ी मेहनत करन पड़ैगी।<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">इब्रानियो 6:8</char></note> <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />और बौ तेरे ताहीं काँटे और जंगली पौधा जमागी, और तैं खेत की उपज खागो। <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />तुमकै मट्टी से कुछ भी पैदा करन के ताहीं कड़ी मेहनत और पसीना बहान पड़ेगो, जब तक कि तुम मट्टी मैं नाय मिल जाबौ काहैकि तुम मट्टी से निकरे हौ और फिर मट्टी मैं मिल जागे।”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />आदम अपनी बईय्यर को नाओं हव्वा रखी, काहैकि बौ सब जिंदे लोगन की मूलअईय्या बनी। <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />और प्रभु परमेस्वर आदम और बाकी बईय्यर के ताहीं जानवर की खाल के लत्ता बनाएकै उनकै पहनाए दई।<verse eid="GEN 3:21" /></para>
  <para style="s">आदम और हव्वा कै बगिया से बाहर कर दौ गौ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />तौ प्रभु परमेस्वर कही, “अब इंसान भले-बुरे को ग्यान पाएकै हम मैं से एक ही गौ है। तौ अब ऐसो ना होबै कि जिंदगी देनबारे पेंड़ को फल तोड़कै खाए लेबै और हमेसा जिंदो रहबै।”<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">प्रकासितवाक्य 2:7; प्रकासितवाक्य 22:2,14,19; उत्पत्ति 3:24; प्रकासितवाक्य 3:24</char></note> <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />जौ बजह से प्रभु परमेस्वर बाकै अदन की बगिया से बाहर निकार दई, और जो मट्टी से बौ बनाओ गौ रहै बहे मैं खेती कराई। <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />जौ बजह से बौ इंसान कै निकार दई, और जिंदगी देन बारे पेंड़ के रस्ता मैं पहरा देन के ताहीं अदन की बगिया के अगार के घाँईं करूब<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">जो पंख बारे अदभुत प्राड़ी रहैं,</char></note> कै, और चारौ तरफ घूमन बारी अग्निमय तलवार कै भी ठहराए दई।<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">कैन और हाबिल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />फिर आदम अपनी बईय्यर हव्वा से संबंध बनाई, और फिर बौ गर्भवती भई। बाको एक लौड़ा पैदा भौ, और बौ कही, “प्रभु की मदत से मोकै एक लौड़ा मिलो है।” इसलै बौ बाको नाओं कैन रखी। <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />जाके बाद बौ एक और लौड़ा कै जनम दई। हाबिल एक बरदिया बनो, लेकिन कैन एक किसान बनो। <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />कुछ समय के बाद, कैन प्रभु के झोने अपनी फसल मैं से कुछ भेंट लैकै आओ। <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />तौ हाबिल अपनी भेंड़ को पहलोठो मेमना बाकै भेंट करन के ताहीं लाई और बाकै मारकै चर्बी बारे मास कै भेंट करी। प्रभु हाबिल की भेंट से भौत खुस भौ।<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">इब्रानियो 11:4</char></note> <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />लेकिन बौ कैन की भेंट कै ठुकराए दई। जौ बजह से कैन के मोहों मैं उदासी छाए गई, और बौ गुस्सा से भर गौ। <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />तौ प्रभु कैन से कही, “तू गुस्सा काहे होथै? तेरे चैहरा मैं उदासी काहे है? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />अगर तू सई काम करतो, तौ का मैं तेरी भेंट ना अपनाओ होतो? लेकिन तू तौ गलत करो है, और पाप तेरे मोहोट मैं बैठो है। जौ तेरे ऊपर सासन करनो चाहथै, लेकिन तोकै जाके ऊपर बिजय पाने होगो।”<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">उत 3:16</char></note><verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />तौ कैन अपने भईय्या हाबिल से कही, “आ आपन मैदान मैं चलथैं।” और जब बे मैदान मैं रहैं, कैन अपने भईय्या ऊपर हमला कर देथै और बाकै मार डारथै।<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">मत 23:35; 1 यो 3:12;</char></note><verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />प्रभु कैन से पूँछी, तेरो भईय्या हाबिल कहाँ है? बौ जबाब दई, “मोए न पता है, मैं का अपने भईय्या की देखरेख करन बारो हौं?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />तौ प्रभु कही, तैं जौ का करो है? सुन; तेरो भईय्या को खून जमीन से मेरे घाँईं चिल्लाए कै मोए पुकार रौ है।<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">इब्र 12:24</char></note> <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />इसलै अब मट्टी तेरे भईय्या को खून पीन ताहीं अपनो मोहो खोली है, और अब जौ मट्टी मैं तू खेती नाय कर पागो काहैकि तैं अपने भईय्या कै मारन की बजह से तू स्रापित है। <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />तैं पूरी ताकत से खेती करन की कोसिस करैगो, तौ भी तोकै पूरी फसल नाय मिलैगी; और तोकै पृथ्वी मैं घर ना मिलैगो और भटकन बारो रहगो।<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />तौ कैन प्रभु से कही, “जौ सजा मेरे सहन से बाहर है। <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />तू मोए जमीन और अपनी मौजूदगी से दूर कर दौ है। मैं पृथ्वी मैं बेघर भटकत फिरंगो, और जो कोई मोए पागो बौ मोए मार डारैगो।”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />लेकिन प्रभु जबाब दई, “न। अगर कोई तोकै मार डारैगो तौ बासे सात गुना बदला लौ जागो।” और प्रभु कैन के ताहीं एक चिन्ह ठहराई, ऐसो ना होबै कि कोई बाकै पाएकै मार डारै। <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />और कैन प्रभु के सामने से दूर ही गौ और “नोद” नाओं के देस मैं रहन लगो, जो अदन के अगार दिसा मैं है।<verse eid="GEN 4:16" /></para>
  <para style="s">कैन के बंस</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />कैन अपनी बईय्यर के संग संबंध बनाई, और बौ गर्भवती भई और बौ हनोक कै जनम दई; फिर कैन एक नगर बसाई और बाको नाओं अपने लौड़ा के नाओं के ऊपर “हनोक नगर” रखी। <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />हनोक को लौड़ा इराद और इराद को लौड़ा महूयाएल और महूयाएल को लौड़ा मातुसाएल और मातुसाएल को लौड़ा लेमेक को जनम भौ। <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />लेमेक दुई बईंय्यरन से बिहा करी, एक को नाओं आदा और दुसरी को नाओं सिल्ला रहै। <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />आदा याबाल कै जनम दई, याबाल बे लोगन को पुरखा बनो जो तम्बून मैं रहथै और जानवरन को पालन करकै जिंदगी चलाथैं। <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />उनके भईय्या को नाओं यूबाल रहै, जो बुसली बजान बारे सब संगीतकारन को पुरखा रहै। <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />सिल्ला जो तूबल कैन कै जनम दई, जो पहलो पीतर और लोहो से सब तराहनी के औजार बनान बारो रहै। तूबल की बहेनिया को नाओं नामाह रहै।<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />लेमेक अपनी बईंय्यरन से कही,</para>
  <para style="q1" vid="GEN 4:23">“अरे आदा और सिल्ला मेरी सुनौ:</para>
  <para style="q1" vid="GEN 4:23">मैं एक जुआन आदमी कै मार डारो हौं काहैकि बौ मोकै चोट पहोंचाई रहै।<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />अगर लेमेक कै मारन के ताहीं सात की ज्यान लई जाथै,</para>
  <para style="q1" vid="GEN 4:24">तौ अगर कोई मोए मारैगो तौ सत्तर गुना लोगन की ज्यान लै जागी।”<verse eid="GEN 4:24" /></para>
  <para style="s">सेत और एनोस</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />आदम और अपनी बईय्यर के संग फिर से संबंध बनाई; और बौ एक और लौड़ा कै जनम दई और बाको नाओं जौ कहकै सेत रखी कि “परमेस्वर मेरे ताहीं हाबिल के बदले, जोकै कैन मार डारी रहै।” एक और लौड़ा दई है। <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />सेत को एक लौड़ा भौ, जोको नाओं एनोस रखी। और तभई से लोग आराधना मैं परमेस्वर को पवित्र नाओं कै लेनो सुरु कर दईं।<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">आदम की वंसावली</para>
  <para style="r">(<ref loc="1CH 1:14">1 इतिहास 1:14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />जौ आदम की वंसावली है। जब परमेस्वर इंसान कै बनाई, तौ बौ उन्हैं अपने तराहनी बनाई।<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">मत्ती 1:1; 1 कुरिन्थियों 11:17</char></note> <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />बौ उन्हैं नर और नारी करकै बनाई, जब बौ उन दोनों कै बनाई, तौ बौ उन्हैं “इंसान” नाओं दई, और आसीस दई। <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />जब आदम एक सौ तीस साल को भौ, तौ बाको एक लौड़ा पैदा भौ, बौ बाके ही तराहनी दिखात रहै, और बौ बाको नाओं सेत रखी। <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />और सेत के जनम के बाद, आदम आठ सौ साल ले जिंदो रहो। और बाके और भी बालका पैदा भै <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />फिर आदम नौ सौ साल की उमर पूरी होन के बाद मर गौ।<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />जब सेत एक सौ पाँच साल को भौ, तौ एनोस पैदा भौ। <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />एनोस के पैदा होन के बाद सेत आठ सौ सात साल ले और जिंदो रहो। बाके और भी बालका भै <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />तौ सेत की उमर नौ सौ बारह साल की ही गई बाके बाद बौ मर गौ।<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />जब एनोस नब्बै साल को भौ, तौ बासे केनान पैदा भौ, <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />केनान के पैदा होन के बाद एनोस आठ सौ पन्द्रह साल ले जिंदो रहो। बाके और भी बालका पैदा भै। <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />और फिर एनोस नौ सौ पाँच साल और जिंदो रहो फिर बाकी मौत ही गई।<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />जब केनान सत्तर साल को भौ, तौ बाको एक लौड़ा महल्लेल पैदा भौ। <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />और फिर केनान आठ सौ चालीस साल ले और जिंदो रहो। जाके बाद महल्लेल और भी बालका पैदा भै। <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />और केनान कुल नौ सौ दस साल जिंदो रहो फिर बाकी मौत ही गई।<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />जब महल्लेल पैंसठ साल को रहै, तौ येरेद कै जनम दई, <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />येरेद के जनम के बाद महल्लेल आठ सौ तीस साल और जिंदो रहो। और बाके और भी बालका पैदा भै <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />महल्लेल कुल आठ सौ पिचानबे साल और जिंदो रहो, फिर बाकी मौत ही गई।<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />जब येरेद एक सौ बासठ साल को रहै, तौ हनोक को जनम भौ, <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />हनोक के जनम के बाद येरेद आठ सौ साल और जिंदो रहो। बाके बाद और भी बालका भै <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />येरेद नौ सौ बासठ साल और जिंदो रहो, बाके बाद बाकी मौत ही गई।<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />जब हनोक पैंसठ साल को रहै, तौ बौ मातुसाएल कै जनम दई। <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />मातुसाएल के जनम के बाद, हनोक तीन सौ साल तक परमेस्वर के संग-सोवत मैं रहौ और बाके और भी बालका पैदा भै। <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />हनोक कुल तीन सौ पैंसठ साल ले जिंदो रहो। <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />हनोक अपनी जिंदगी परमेस्वर की संग-सोवत मैं बिताई, और फिर बौ गायब ही गौ, काहैकि परमेस्वर बाकै उठाए लई।<note caller="+" style="f"><char style="fr" closed="false">5:24 </char><char style="ft" closed="false">इब्र 11:5; यहू 14;</char></note><verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />जब मातुसाएल एक सौ सतासी साल को भौ, तौ बौ लेमेक कै जनम दई। <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />लेमेक के जनम के बाद मातुसाएल सात सौ बयासी साल और जिंदो रहौ। बाके और भी बालका पैदा भै <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />मातुसाएल कुल नौ सौ उनहत्तर साल जिंदो रहो बाके बाद बाकी मौत ही गई।<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />जब लेमेक एक सौ बयासी साल को रहै, तौ बाको एक लौड़ा भौ, <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />बौ बाको नाओं नूह रखी और कही, जो जमीन कै प्रभु स्राप दई है, जहे जमीन मै जौ बालका हमरे काम मैं, जोमैं हम कड़ी मेहनत करथैं, जामैं छुटकारा देगो। <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />नूह के जनम के बाद लेमेक पाँच सौ पिचानबे साल और जिंदो रहो। बाके और भी बालका पैदा भै <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />लेमेक कुछ सात सौ सत्तर साल तक और जिंदो रहो, बाके बाद बाकी मौत ही गई।<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />जब नूह पाँच सौ साल को भौ तौ बौ सेम, हाम और येपेत कै जनम दई।<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">इंसान को पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />जब इंसानी जाति पूरी दुनिया मैं फैल गई रहै, और उनकी लौड़िया भी जनम लेत रहैं, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />तौ कुछ परमेस्वर के लौड़ा, इंसान की लौड़ियन कै देखीं कि बे सुगड़ है। <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />फिर प्रभु कही, “मेरी आत्मा इंसान के भीतर हमेसा के ताहीं बास ना करंगो; काहैकि इंसान एक मात्र सरीर है। अब से बे एक सौ बीस साल से जाधे जिंदगी ना जींगे।” <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />बे दिनन मैं पृथ्वी मैं दानव रहैं, बे तहुँओं रहैं, जब परमेस्वर के लौड़ा इंसान की लौड़ियन के झोने गै तौ उनके जरिये जो बालका पैदा भै, बे पुराने जमाने के सक्तिसाली और सुप्रसिद्ध वीर रहैं।<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />जब प्रभु देखी, कि पृथ्वी मैं सब रहन बारे लोग कित्ते दुस्ट हैं, और उनके मन बिचार हर समय बुराई के घाँईंये रहथै, <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />और प्रभु पृथ्वी मैं इंसान कै बनाएकै बड़ा पछतानो। बौ अपने मन मैं भौत दुखी भौ। <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />प्रभु कही, “मैं इंसान कै पालतू जानवरन कै नेंगन बारे, और आसमान के पक्छियन कै मिटाए दुंगो, काहैकि मोकै जौ बात को दुख कि मैं उनकै बनाओ हौं।” <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />लेकिन प्रभु को कृपा नूह के ऊपर रहै।<verse eid="GEN 6:8" /></para>
  <para style="s">नूह के बारे मैं</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />जौ कहानी नूह के परिवार की है, नूह एक धर्मी आदमी रहै और बौ अपने समय मैं इकल्लो निर्दोस रहै। और बौ हर समय परमेस्वर के संग - सोवत मैं रहत रहै। <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />नूह के तीन लौड़ा रहैं, सेम, हाम, और येपेत। <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />परमेस्वर की नजर मैं पृथ्वी भ्रस्ट और हिंसा से गई रहै। <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />परमेस्वर पृथ्वी ऊपर नजर डारी और पाई कि सब दुस्टता से भर गै हैं काहैकि सब लोग दुस्टता की जिंदगी जीत रहैं।<verse eid="GEN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 6:13" />परमेस्वर नूह से कही मैं सब प्राड़िन कै नास कर दुंगो और पृथ्वी इंसान से भ्रस्ट हुई चुकी है। निस्चय मैं पृथ्वी और बे लोगन सुंदा नास कर दुँगो। <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />तैं गोपेर पेंड़ की अच्छी कठिया से अपने ताहीं एक बड़ी नईंय्याँ बना; जामैं कमरा बना और जाके अंदर-बाहर कोलतार को लेप लगइये। <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />ऐसे करकै तुम जाकै बनाबौ, जहाज एक सौ तैंतीस मीटर लम्बो, बाईस मीटर चौंड़ो और तेरह मीटर ऊँचो बनइये। <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />जहाज मैं एक खिड़की बनइये और आधे मीटर ऊपर छत बनईयो, और जहाज मैं एक और फाटक बनईयो, और जहाज मैं तीन मंजिल बनईये, ऊपर, बीच और नीचे को मंजिल। <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />मैं आसमान के नीचे बे सब जिंदे प्राड़िन कै, जिनमैं जिंदगी की साँस है, नास करन के ताहीं पृथ्वी के ऊपर जल-प्रलय करंगो। जासे पृथ्वी के सब प्राड़ी मर जाँगे। <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />लेकिन मैं तेरे संग वाचा भाँदंगो। तैं अपनी बईय्यर, अपने लौड़ा और उनकी बईंय्यरन कै संग लैकै जहाज मैं जा। <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />सब जिंदे प्राड़िन मैं से दुई-दुई, एक नर और एक मादा कै अपने संग जहाज मैं ले जा, ताकी बे तेरे संग जिंदे रहमैं। <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />सब तराहनी के पक्छी, और पालतू जानवर मैं से दुई-दुई तेरे झोने आंगे, कि तै उनकै जिंदो रखै। <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />हर तराहनी को खान बारो खाना, जो खाओ जागो, इखट्टो कर लिये। बौ तेरे और उनके खान के ताहीं होगो। <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />नूह ऐसोई करी। बौ परमेस्वर की आग्या के हिसाब से सब कछु करी।<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">पूरी पृथ्वी मैं बाढ़</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />प्रभु नूह से कही, अपने पूरे परिवार समेत जहाज मैं जा; काहैकि मैं जौ पीढ़ी मैं सिरफ तहीं कै अपनी नजर मैं धर्मी पाओ हौं। <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />तैं सब सुद्ध जानवरन मैं से नर और नारी के सात जोड़ा अपने संग लै जईये, और असुद्ध जानवरन मैं से नर और नारी कै एक-एक जोड़ा लै जइये। <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />और भी पक्छिन मैं से सात जोड़ा लै जइये। ताकी हर तराहनी के पक्छी और जानवर पृथ्वी मैं दुबारा से जनन करन के ताहीं जिंदो रखो जा सकै। <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />अब से सात दिन बाद मैं ऐसो मेंहें बरसामंगो जो चालीस दिन और चालीस रात ले होतै रहगी, और पृथ्वी के जित्ते जिंदे प्राँड़ी कै मैं बनाओ हौं बे सबन कै नास कर दुंगो। <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />और नूह बौ सब कुछ करी जो प्रभु आग्या दई रहै।<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />जब पृथ्वी मैं बाढ़ आई तौ नूह की उमर छ: सौ साल की रहै। <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />नूह और बाकी बईय्यर, और बाके लौड़ा और बहु बाढ़ से बचन के ताहीं नईंय्याँ मैं चले गै।<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">मत्ती 24:38,39; लूका 17:27</char></note> <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />सुद्ध और असुद्ध जानवरन के, पक्छियन के, जमीन मैं नेंगन बारे सब जन्तुअन के, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />दुई-दुई, मतलब नर और नारी, नूह के संग जहाज मैं गै, जैसे परमेस्वर नूह कै आग्या दई रहै। <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />सात दिन बाद पृथ्वी मैं बाढ़ आए गई।<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />जब नूह छ: सौ साल को भौ, बाके दुसरे महेना के सत्तरमें दिन कै पृथ्वी के नीचे के सब सोता खुल गै, और आसमान के भी सब झरोका फूट गै<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">2 पतरस 3:6</char></note> <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />और चालीस दिन और चालीस रात ले पृथ्वी मैं मेंहें बरसत रहो। <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />बहे दिन नूह और अपनी बईय्यर और अपने तीनौ लौड़ा सेम, हाम और येपेत और तीनौ बहु के संग जहाज मैं चले गौ। <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />उनके संग हर जाति के जानवर, पालतू जानवर और जंगली जानवर, पृथ्वी मैं नेंगनबारे जन्तु और जाति-जाति के पक्छि, और सब तराहनी के पखमा बारे कीट पतंगे भी गै। <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />सब प्राड़ियन मैं से दुई-दुई प्राड़ी, जिनमैं जिंदगी की साँस रहै, नूह के संग जहाज मैं गै। <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />सब प्राड़ियन मैं से नर और नारी जहाज मैं गै, जैसी परमेस्वर आग्या दई रहै। फिर प्रभु नूह कै जहाज के भीतर बंद कर दई। रहै।<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />पृथ्वी मैं चालीस दिन ले बारिस होन की बजह से बाढ़ रही, और पानी इत्तो गहरो ही गौ कि जहाज तैर सकै। <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />पानी गजब बड़न लग्गौ। बौ बढ़ते-बढ़ते पूरी पृथ्वी मैं फैल गौ, और जहाज पानी के ऊपर तैरन लग्गौ। <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />पृथ्वी मैं पानी इत्तो जाधे बढ़ गौ कि आसमान के नीचे के जित्ते ऊँचे-ऊँचे पहाड़ रहैं, बे पानी मैं सब डूब गै; <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />पानी इतनो बढ़गौ कि पहाड़ भी सात मीटर ले डूब गौ। <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />पृथ्वी मैं सब जिंदे प्राँड़ी, का पक्छी, का जानवर और का इंसान सब मर गै। <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />सब सूखी जमीन मैं सांस लेन बारे प्राड़ी सब मर गै। <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />प्रभु पृथ्वी मैं सब जिंदे रहन बारे प्राड़िन कै, इंसान और जानवरन कै, नेंगन बारे जन्तुन कै, आसमान के पक्छिन कै मिटाए डारी। बे पृथ्वी से मिटाए डारे गै। सिरफ नूह और जित्ते लोग बाके संग जहाज मैं रहैं बेईं बचे। <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />और पानी पृथ्वी मैं एक सौ पचास दिन ले कम ना भौ।<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">बाढ़ को अंत</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />परमेस्वर नूह और बाके संग जहाज मैं जित्ते जानवर मौजूद रहैं उन सबन की सुधि लई; फिर बौ पृथ्वी मैं ब्यार चलाई और पानी कम होन लगो। <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />पृथ्वी के नीचे के सोता और आसमानी झरोका बंद ही गै। और आसमान से मेंहें रुक गौ, <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />और एक सौ पचास दिन ले पृथ्वी मैं धीरे-धीरे पानी कम होत गौ। <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />सातमों महेना के सत्तरमें दिन जहाज अरारत नाओं के पहाड़ मैं टिक गौ। <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />पानी घटत गौ और दसमें महेना के पहले दिन कै पहाड़ की चुटिया दिखाई देन लग गईं।<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />चालीस दिन बाद नूह अपनी बनाई भई खिड़की खोली <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />और एक कउवा को भेजी। और जब ले पृथ्वी मैं को पानी सूख ना गौ, तौले कउवा इतै-उतै उड़त रहो। <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />तौ फिर से, नूह जौ देखन के ताहीं एक कबूतर कै भेजी कि पानी जमीन से घटो है कि नाय। <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />लेकिन पानी हबै भी पूरी जमीन मैं भरो रहै, और कबूतर कै उतरन के ताहीं कोईये जघा नाय मिली। बौ बापिस जहाज मैं लौट आई, और नूह अपनो हात बढ़ाए कै बाकै भीतर लै लई। <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />बौ सात दिन इंतजार करकै और फिर से कबूतर कै छोड़ी। <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />और कबूतर संजाखिन कै अपनी टोठन मैं जैतून के पेंड़ को ताजो पत्ता लैकै बाके झोने लौट आओ। तौ नूह कै पता चल गौ कि पृथ्वी से पानी घट रहो है। <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />तौ फिर से बौ और सात दिन ठहर कै बहे कबूतर कै छोड़ी; और जौ बार बौ बापस नाय आई।<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />जब नूह छ: सौ एक साल को भौ, तौ पहले महेना के पहले दिन पृथ्वी मै पानी खतम ही गौ। और तभई नूह जहाज के ऊपर की छत हटाय दई, और चारौ तरफ देखथै कि जमीन सूख रही है। <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />और दुसरे महेना के सत्ताईसमें दिन मैं पृथ्वी पूरी तराहनी से सूख गई।<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />परमेस्वर नूह से कहथै, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“अपनी बईय्यर, अपने लौड़ा और उनकी बईंय्यरन कै संग लैकै जहाज मैं से बाहर निकर आ। <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />सब पक्छी और जानवरन और रेंगन बारे जानवरन कै अपने संग लै आ, कि उनसे भौत बच्चा पैदा हुई कै पूरी पृथ्वी मैं फैल जामैं।” <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />नूह अपनी बईय्यर, लौड़न और सब बहु समेत जहाज से दुआरे निकर आओ। <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />सब जानवर और सब पक्छी और सब रेंगन बारे जानवर अपने जोड़ा के संग जहाज से बाहर निकर आए।<verse eid="GEN 8:19" /></para>
  <para style="s">नूह की होमबलि</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />नूह प्रभु के ताहीं एक बेदी बनाई; बौ सब तराहनी के सुद्ध जानवर और पक्छी मैं से एक-एक लई, और उन्हैं बेदी मैं बलि के रूप मैं होमबलि<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">होमबलि मैं एक जानवर की खाल निकारकै पुजारी कै दौ जात रहै, और बचे भै मास कै यग्य बेदी मैं चढ़ाएकै जलाओ जात रहै, जोसे परमेस्वर खुस होत रहै। जौ सब यहूदी लोग करे करत रहैं।</char></note> करी। <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />होमबलि की सुखद खुसबू से प्रभु खुस होथै, और बौ अपने मन मैं कहथै, “लोगन के काम की बजह से मैं पृथ्वी कै फिर कभी स्रापित नाय करंगो; मैं जानथौं कि जब बे जवान होथैं और तभई से उनके ख्याल बुरे होथैं। मैं फिर कहुए जिंदे प्राड़िन कै नास नाय करंगो, जैसो मैं हबै करो हौं। <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />जब ले दुनिया बनी रहेगी, बोन को समय और फसल काटन को समय होत रहगो। ठंड, गर्मी, ग्रीस्म और सीत, के मौसम और दिन और रात हमेसा होत रहमंगे।”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">नूह के संग परमेस्वर की वाचा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />फिर परमेस्वर नूह और बाके लौड़न कै आसीस देत भै कही, “फूलौ-फलौ और पूरी पृथ्वी मैं भर जाबौ। <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />पृथ्वी के सब जानवर, आसमान के पक्छी, जमीन मैं नेंगन बारे जन्तु, और समुद्र की मच्छी, बे सब के सब तुमसे डरांगे। बे सब तुमरे बस मैं रहंगे, मैं उनकै तुमरे हाथ मैं सौपथौं। <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />अब से सब जीव- जन्तु तुमरो आहार होगो। खाए सकथौ, संग मैं हरे छोटे पौधन कै भी; मैं बे सब तुम्हैं खान कै देथौं। <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />लेकिन एक चीज मत खईयो मतलब खून लगो भौ मास; मैं जाकै खान से मना करो हौं काहैकि खून मैं ज्यान होथै, <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />काहैकि मैं पक्का तुमरे खून को बदला लुंगो। मैं हर एक जानवर से, हर एक इंसान से बाको प्रतिसोध लुंगो। मैं हर एक इंसान से बाके भईय्या-बहेनिया के खून को बदला लुंगो। <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />जो कोई इंसान को खून बहागो, बहो को खून इंसान के जरिये बहाओ जागो; काहैकि परमेस्वर इंसान कै अपने स्वरूप बनाई है।<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">लैव्यवस्था 24:17 </char></note> <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />तुम फूलौ-फलौ, और पृथ्वी मैं गजब बढ़ जाबौ और असंख्य हुई जाबौ।”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />फिर परमेस्वर नूह और बाके लौड़न से कहथै, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />मैं तुमरे और तुमरे बाद होन बारे औलादन के संग वाचा, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />और तुमरे झोने के हर एक जिंदे प्राड़ी मतलब पक्छि, पालतू जानवर, पृथ्वी के सब बन- जानवर और जहाज से बाहर निकरन बारे सब जीव- जन्तुअन के संग अपनी वाचा बाँधथौं। <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />जे सब्दन के संग मैं तुमरे संग वाचा बाँधथौं: मैं वादा करथौं कि फिर कहूवे जिंदे प्राड़ी बाढ़ से नास ना होंगे; और फिर कहू पृथ्वी कै बाढ़ नास नाय करैगी। <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />परमेस्वर फिर एक बार कही, मैं तुमरे संग और सबै जिंदे प्राड़िन के संग युगानायुग की पीढ़ी के ताहीं एक वाचा बाँधथौं, बाको जौ चिन्ह है, <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />मैं बादर मैं अपनी धनुस रखथौं। जौ मेरे और पृथ्वी के बीच करे गै वाचा को चिन्ह होगो। <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />और जब मैं आसमान कै बादर से तोप लेथौं तौ मेघधनुस दिखाई देगो, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />मैं तुमसे और सब जानवरन से करो वाचा याद रखंगो, कि बाढ़ फिर कहुए सबै जिंदे प्राड़िन कै नास नाय करैगी। <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />जब बादर मैं इंद्र-धनुस दिखाई देगो, तौ मैं बाकै देखकै पृथ्वी मैं सब जिंदे प्राड़िन के बीच परमेस्वर की चिरस्थायी वाचा कै याद करंगो। <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />तौ परमेस्वर नूह से कही, जो वाचा मैं अपने और पृथ्वी के सब प्राड़ियन के बीच मैं करो हौं, बाको जहे चिन्ह है।<verse eid="GEN 9:17" /></para>
  <para style="s">नूह और बाके लौड़ा</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />नूह के लौड़ा जो जहाज से दुआरे निकरे बे सेम, हाम और येपेत रहैं। हाम कनान को दऊवा बनो। <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />जेईं तीन नूह के लौड़ा रहैं, और उनके जरिये पृथ्वी इंसानन से भर गई।<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />नूह, जो एक किसान बनो, और खेती करनो सुरू करी और बौ दाख की बारी लगाई। <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />जब बौ जरासो दाखरस पी लई, तौ बाकै इतने मैं नसा चढ़ गई, और खुद के लत्ता उतारकै अपने तम्बू मैं बिना लत्ता लेट गौ। <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />जब कनान को दऊवा हाम देखी कि बाको दऊवा बिना लत्ता के है, तौ बौ दुआरे गौ और अपने दोनों भईय्यन कै बताई। <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />फिर सेम और येपेत एक लत्ता लईं, और बाके अपने कंधा मैं धरकै उल्टे पाँव नेंगकै तम्बू भीतर गै और अपने दऊवा के बिना लत्ता सरीर कै तोप दईं। बे अपनो मोहों पच्छू करे पड़े रहैं। ताकि बे बाके सरीर कै बिना लत्ता के न देख पामैं। <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />जब नूह की नसा उतरी और बाकै पता चलो कि बाको सबसे छोटो लौड़ा बाके संग का करी है, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />नूह बाकै स्राप दई,</para>
  <para style="q1" vid="GEN 9:25">“कनान स्रापित होबै!</para>
  <para style="q1" vid="GEN 9:25">बौ अपने भईय्यन को दास होगो।<verse eid="GEN 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 9:26" />नूह फिर से कही, सेम को प्रभु परमेस्वर धन्य है!</para>
  <para style="q1" vid="GEN 9:26">कनान सेम को दास होगो।<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />परमेस्वर येपेत कै बढ़ाबै!</para>
  <para style="q1" vid="GEN 9:27">और याफत सेम के तम्बुन मैं वास करै,</para>
  <para style="q1" vid="GEN 9:27">और कनान येपेत को दास बने।”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />बाढ़ के बाद नूह तीन सौ पचास साल और जिंदो रहो <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />ऐसे करकै नूह की नौ सौ पचास साल की उमर मैं बाकी मौत ही गई।<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">नूह की वंसावली</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />नूह के लौड़ा सेम, हाम और येपेत रहैं। बाढ़ के बाद जे तीनौ के लौड़ा भै। और इनकी वंसावली जौ हैं। <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />येपेत के लौड़ा - गोमेर, मादी, यावन, तूबल मेसेक और तीरस भै - इनके नाओं इनके पुरखन के नाओं के जरिया मिले। <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />गोमेर के लौड़ा- अस्कनज, रीपत और तोगर्मा रहैं। <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />यावन के लौड़ा- एलीसा, तर्सीस, कित्ती और दोदानी रहैं; <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />जे लोगन के पुरखा जो समुंदर के किनारे के देसन मैं बस गै रहैं। जे येपेत के वंस के हैं, जो अलग-अलग जाति मैं बटकै हर एक गुट अपनी भासा बोलथैं।<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />हाम के लौड़ा - कूस, मिस्र, लीबिया और कनान रहैं। जे नाओं उनके पुरखन के नाओं मैं रखे गै रहैं। <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />कूस के लौड़ा- सेबा, हवीला, सबता, रमा, और सब्तका रहैं। रमा के लौड़ा सबा और ददान रहैं। <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />कूस को निम्रोद नाओं को एक लौड़ा रहै, जो पृथ्वी को पहलो महान सक्तिसाली आदमी रहै। <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />बौ प्रभु की नजर मैं एक महान सिकारी रहै, जौ बजह से लोगन की एक कहावत रहै, “प्रभु तुमकै निम्रोद के तराहनी महान सिकारी बनाबै!” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />सबसे पहले बाके राज्य मैं बेबीलोन, एरेख, कलने और अक्कद सामिल रहैं, जे तीनौ सिनार देस मैं हैं। <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />बौ देस से निकरकै बौ अस्सूर देस कै गौ, और नीनवे, रहोबोतीर और कालह नाओं के सहर बसाई। <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />रसन नगर, जो नीनवे और कालह दोनो बड़े सहर के बीच मैं बसाओ गौ है। <verse eid="GEN 10:12" /><verse number="13" style="v" sid="GEN 10:13" />मिस्र के बंस मैं लूदी, अनामी, लहाबी, नप्तूही, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />पत्रूसी, कसलूही, और कप्तोरी कै पैदा करी। कसलूही से पलिस्ती के बंस निकरे।<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">पलिस्ती लोग कसलूही मैं से निकर कै आए।</char></note><verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />कनान अपनो पहलोठे लौड़ा सीदोन कै जन्माई, बाके बाद हेत, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />यबूसी, एमोरी, और गिर्गासिन, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />हिव्वी, अर्की, सीनी, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />अर्वदी, समारी और हमाती भै। अलग- अलग जघन मैं कनानी वंस के लोग फैल गै। <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />कनानी की सरहद सीदोन से गाजा के झोने गरार ले, और फिर सदोम, गमोरा, अदमा और सबोयीम के झोने लासा तक रहै। <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />हाम अपने कुलन, वंस और भासा, देस-प्रदेस के हिसाब से बट गौ।<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />सेम कै भी लौड़ा भै, बौ सबै एबर-वंसियन को मूल-आदमी और येपेत को बड़ो ददा रहै। <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />सेम के लौड़ा - एलाम, अस्सूर, अर्पछद, लूद और अराम रहैं, जे नाओं इनके पुरखन के नाओं ऊपर रखे गै रहैं। <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />अराम के लौड़ा ऊस, हूल, गेतेर और मसेक रहै। <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />अर्पछद सेलह कै, और सेलह एबर कै जन्माई। <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />एबर के दुई लौड़ा भै: एक को नाओं पेलेग रखो गौ,<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">पेलेग को मतलब बाँटनो </char></note> काहैकि बाके समय मैं लोग पृथ्वी मैं बट गै रहैं; और दुसरे को नाओं योक्तान रहै। <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />योक्तान को वंस अल्मोदाद, सेलेप, हसर्मावेत, येरेह, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />हदोराम, ऊजाल, दिक्ला, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ओबाल, अबीमाएल, सेबा, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />योक्तान ओपीर, हवीला, और योबाब रहैं। <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />जे जो जमीन मैं रहत रहैं अगार पहाड़ के देसन मैं मेसा से लैकै सपारा ले फैले रहैं। <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />जे सेम के वंस हैं, जो अपनी अलग-अलग जाति और देसन मैं रहथैं, और हर जाति अपनी भासा बोलथै। <verse eid="GEN 10:31" /><verse number="32" style="v" sid="GEN 10:32" />जे सब लोग, अपनी अलग-अलग वंसावली के जरिया, नूह के वंस से हैं। बाढ़ के बाद जे सब जेईं परिवार से निकरकै पृथ्वी मैं भर गै।<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">बेबीलोन को गढ़</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />पहले पूरी पृथ्वी के लोगन की एकै भासा रहै और बे एकै सब्द को इस्तमाल करत रहैं। <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />बौ समय लोग अगार दिसा के घाँईं से घूमत-घामत, बे बेबीलोन के सिनार देस के एक मैदान मैं आएकै हूँनै बस गै। <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />बे एक दुसरे से कहीं, “चलौ! अब ईंट बनामैं और इनकै आगी मैं अच्छे से पकामैं।” और फिर इमारत बनान ताहीं जे पत्थर की जघा मैं ईंट और चूना की जघा मैं कोलतार को इस्तमाल करन लगे। <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />बे फिर कहीं, “आबौ हम एक ऐसो सहर बनाँगे, जोके गुम्मट की चुटिया स्वर्ग ले पहोंचत होए, ताकि हम अपनो नाओं कर सकैं और हम पूरी पृथ्वी मैं तितर-बितर न होमैं।”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />लेकिन प्रभु बौ सहर और गुम्मट कै देखन ताहीं नीचे आओ, जो बे लोग बनात रहैं। <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />और प्रभु कही, “देखौ, जे एकै जाति के लोग है। जे सबन की भासा भी एकै है। जौ तौ उनके आन बारे समय के कामन की सुरुवात है। जो काम बे अग्गु करनो चाहंगे, बौ उनके ताहीं नामुमकिन ना होगो! <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />तौ आबौ आपन नीचे जाएकै उनकी भासा मैं ऐसी गड़बड़ी करैं कि बे एक दुसरेन कै नाय समझ पामैं।” <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />ऐसिये करकै प्रभु उनकै पूरी पृथ्वी मैं तितर-बितर कर दई, और बे सहर बनानो छोड़ दईं। <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />बौ सहर को नाओं बेबीलोन रखो गौ, काहैकि हूँना परमेस्वर सब लोगन की भासा मैं गड़बड़ी कर दई, और हूँनै से बौ उनकै पूरी पृथ्वी मैं तितर-बितर कर दई।<verse eid="GEN 11:9" /></para>
  <para style="s">सेम की वंसावली</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />जे सेम के बंसज हैं। बाढ़ के दुई साल बाद, जब सेम सौ साल को भौ, तौ बाको एक लौड़ा अर्पछद को जनम भौ। <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />और अर्पछद के जनम के बाद सेम पाँच सौ साल और जिंदो रहो और बाके और भी बालका पैदा भै।<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />जब अर्पछद पैंतीस साल को भौ, तौ बाको सेलह नाओं के एक लौड़ा को जनम भौ; <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />और सेलह के जनम के बाद अर्पछद चार सौ तीन साल और जिंदो रहो और बाके और भी बालका भै। <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />जब सेलह तीस साल को भौ, तौ बाके जरिया एबर नाओं के एक लौड़ा को जनम भौ; <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />एबर के बाद, सेलह चार सौ तीन साल और जिंदो रहो और बाके और बालका पैदा भै।<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />जब एबर चौंतीस साल को भौ, तौ बौ जरिया पेलेग नाओं के लौड़ा को जनम भौ; <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />पेलेग के बाद एबर चार सौ तीस साल और जिंदो रहो। बाके और भी बालका भै।<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />जब पेलेग तीस साल को भौ, तौ बाको एक लौड़ा रऊ पैदा भौ; <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />रऊ बाद, पेलेग दुई सौ नौ साल और जी और बाके और बालका पैदा भै। <verse eid="GEN 11:19" /><verse number="20" style="v" sid="GEN 11:20" />जब रऊ बत्तीस साल को भौ, तौ बाको एक लौड़ा सरूग को जनम भौ; <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />सरूग के बाद, रऊ दुई सौ सात साल और जिंदो रहो, बाके और भी बालका भै।<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />जब सरूग तीस साल को भौ, तौ बाको नाहोर नाओं को एक लौड़ा को जनम भौ; <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />नाहोर के बाद, सरूग दुई सौ साल और जिंदो रहो। बाके और भी बालका भै।<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />जब नाहोर उन्नीस साल को भौ, तौ बाको एक लौड़ा, तेरह को जनम भौ; <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />तेरह के बाद, नाहोर एक सौ उन्नीस साल और जिंदो रहो। बाके और भी बालका भै।<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />जब तेरह सत्तर साल को भौ, तौ बासे अब्राम, नाहोर और हारान को जनम भौ।<verse eid="GEN 11:26" /></para>
  <para style="s">तेरह की वंसावली</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />जे तेरह के बंस के हैं, जो अब्राहम, नाहोर और हारान कै जन्माई रहै। और हारान लूत कै जन्माई रहै, <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />हारान की मौत बाके दऊवा तेरह के जीवन काल मैं ही कसदी जाति के ऊर नाओं के नगर मैं भई, जो बाकी जनम जघा रहै। <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />अब्राम और नाहोर दोनों बिहा करीं, अब्राम की बईय्यर को नाओं सारा रहै और नाहोर की बईय्यर को नाओं मिल्का रहै, मिल्का हारान कि लौड़िया रहै, और हारान मिल्का और यिस्का जे दोनों को दऊवा रहै। <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />सारा निसंतान रहै काहैकि बौ गर्वधारड़ करन मैं असमर्थ रहै। <verse eid="GEN 11:30" /><verse number="31" style="v" sid="GEN 11:31" />तेरह अपने लौड़ा अब्राम, और नतिया लूत, जो हारान को लौड़ा रहै, और अपनी बहु सारा, जो अब्राम की बईय्यर रहै, जे सबन कै लैकै कनान देस मैं बेबीलोन के कसदी जाति के ऊर सहर मैं जान ताहीं निकर गै। बे हारान देस पौहोंचन के बाद हूँनै बस गै। <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />तेरह की पूरी उमर दुई सौ पाँच साल की रहै। फिर बाकी मौत हारान देस मैं भई।<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">अब्राम की बुलाहट</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />प्रभु अब्राम से कही, “अपने देस, रिस्तेदार, और अपने दऊवा को घरबार छोड़कै बौ देस की जमीन मैं चले जा, जो मैं दिखांगो। <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />मैं तोसे एक बड़ो रास्ट्र बनांगो, मैं तोकै आसीस दुंगो, और तेरे नाओं कै महान बनांगो कि तू इंसानियत जाति के ताहीं आसीस को जरिया बे।<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />और जो तोकै आसीस देंगे, उनकै मैं आसीस दुंगो,</para>
  <para style="q1" vid="GEN 12:3">और जो तोकै स्राप देंगे मैं उन्हैं स्राप दुंगो।</para>
  <para style="q1" vid="GEN 12:3">और तेरे जरिया सब पृथ्वी के लोग आसीस पामंगे।”<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />जब अब्राम पचहत्तर साल को भौ, तौ प्रभु के कहने मैं बौ हारान देस कै चल पड़ो; और संग मैं लूत भी बाके संग चल पड़ो। <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />अब्राहम अपनी बईय्यर सारा, और भतीजो लूत, और जो बे धन कमाई रहैं इकट्ठो करकै, और अपने सबै नौकर कै लैकै बे हारान देस के घाँईं चल पड़े। जब बे कनान देस मैं पहोंचे, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />तौ अब्राम पूरे देस मैं फिरत रहो और जितै ममरे को पवित्र पेंड़ रहै, बौ हूँनै पहोंचो, जो सेकेम नाओं की पवित्र जघा रहै। बौ समय कनानी लोग बौ जघा मैं रहत रहैं। <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />प्रभु अब्राहम कै दर्सन दैकै कहथै, “जौ बौ देस है जो मैं तेरे बंस कै दुंगो।” फिर अब्राहम हूँना प्रभु के ताहीं जो बाकै दर्सन दई रहै, एक बेदी बनाई। <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />जाके बाद बौ तरिहाँए घाँईं, बेतेल सहर के अगार घाँईं के पहाड़ी प्रदेस घाँईं चलो गौ। और पछार दिसा मैं बेतेल और अगार मैं ए के बीच मैं बौ अपनो डेरा रखी। और हूँना बौ एक बेदी बनाई और प्रभु की आराधना करी। <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />अब्राम यात्रा करत रहो, बौ नेगेब कनान के तरिहाँए के घाँईं बढ़त भै एक जघा से दुसरे जघा मैं चले गौ।<verse eid="GEN 12:9" /></para>
  <para style="s">मिस्र देस मैं अब्राम</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />जब कनान के देस मैं सूखा पड़ो, और बौ इत्तो भयानक रहै कि अब्राम थोड़ी समय बितान के ताहीं तरिहाँए कै मिस्र देस मैं चले गौ। <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />जब बौ मिस्र की सरहद पार करन बारो रहै, तौ बौ अपनी बईय्यर सारा से कही, “तू एक सुगड़ बईय्यर है। <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />और जब मिस्री लोग तोकै देखंगे, तौ समझ जांगे कि तू मेरी बईय्यर है, और बे मोकै मार डारंगे, और तोकै जिंदो छोड़ देंगे। <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />लेकिन तैं उनसे जौ कहिये कि मैं जाकी बहेनिया हौं; तौ जौ बजह से मोकै जिंदो छोड़ देंगे और मेरे संग अच्छो बर्ताव करंगे।” <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />फिर जब अब्राहम मिस्र की सरहद पार करी, तौ मिस्री लोग देखीं कि बाकी बईय्यर भौत सुगड़ है। <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />जब मिस्र के अधिकारी बाकै देखीं तौ बे फिरौन राजा के सामने बाकी बड़ाँईं करीं; और सारा कै राजा के महल मैं पहोंचाओ गौ। <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />और बाकी बजह से राजा अब्राम के संग अच्छो बर्ताव करी, बाकै निरे जानवर भेड़-बकरिया, गईंय्या-बरधा, गधा-गधईया, नौकर-नौकरानी और निरे ऊँट दई। <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />काहैकि अब्राहम के बदले राजा सारा कै रख लई रहै, और जौ बजह से प्रभु फिरौन राजा के ऊपर और बाके घर के लोगन ऊपर भयानक बिमारी पनारी। <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />तौ फिरौन अब्राहम कै बुलबाई और बासे पूँछी, “तैं मेरे संग का करो है? तैं मोकै जौ काहे ना बताओ कि बौ तेरी बईय्यर है? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />तैं जौ काहे कहो कि बौ मेरी बहेनिया है, और मोकै जाकै अपनी बईय्यर बनान दौ? जौ तौ तेरी बईय्यर है; जाकै लै जा और हिंयाँ से चले जा!” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />फिरौन अपने आदमिन कै हुकम दई, और बे अब्राम कै पकड़ लईं और बाकी बईय्यर और बाकी पूरी जायदाद समेत बौ देस से बिदाई कर दईं।<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">अब्राम और लूत को अलग होनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />अब्राम अपनी बईय्यर और अपनी पूरी जायदाद समेत मिस्र देस छोड़ कै अगार घाँईं से आए कै कनान देस के तरहाएँ के हिस्सा मैं नेगेब जघा मैं गै, और लूत भी बाके संग गौ। <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />अब्राम अपने जानवर भेड़-बकरिया और मवेसिन और सोनो-चाँदी के बजह से भौत सेठ हुई गौ। <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />फिर बौ नेगेब से चले गौ, और बेतेल नगर घाँईं से एक जघा से दुसरे जघा मैं चले गौ। बौ बेतेल और ए नगर के बीच बहे जघा मैं पहोंचो जहाँ बौ अग्गु डेरा डारी रहै। <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />और जहाँ पहली बार बेदी बनाई रहै। अब्राम हूँनै प्रभु के नाओं से आराधना करी।<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />लूत के झोने भी जो अब्राहम को सहकर्मी रहै भेड़-बकरिया, गईंय्या-बरधा, और बाको अपनो परिवार और नौकर-नौकरानी रहैं। <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />जे दोनों के एक संग रहन के ताहीं, उनके हिसाब के मुताबिक चुगा-चुगान की जघा नाय रहै, काहैकि इनके झोने भौत जाधे जानवर रहैं। <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />तौ जो लोग अब्राम के जानवर और लूत के जानवरन की देखरेख करत रहैं, उनके बीच मैं लड़ाई होन लगी। बौ समय कनानी और परिज्जी हबै भी जौ देस मैं रहत रहैं।<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />फिर अब्राहम लूत से कही, आपन हितुआ हैं, और तेरे बर्दियन और मेरे बर्दियन के बीच लड़ाई ना होनी चाहिए। <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />देख, पूरो देस तुम्हारे सामने है, तुम मोसे अलग हुई जाबौ। अगर तुम बाँए घाँईं जागो तौ मैं दहने घाँईं जांगो। अगर तैं दहने जागो तौ मैं बाँए घाँईं जांगो।<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />लूत चारौ घाँईं नजर करकै देखी, बौ देखी कि, पूरी यरदन नदिया मै, सोअर सहर ले भौत एक पानी है। प्रभु की वाटिका या मिस्र देस के तराहनी भौत जाधे पानी है। जौ तौ की बात है जब प्रभु सदोम और गमोरा के नगर कै नास कर दई रहै। <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />फिर लूत पूरी घाटी कै अपने ताहीं यरदन चुन लई और अगार दिसा मैं चले गौ। और ऐसिये करकै बे एक दुसरे से अलग ही गै। <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />अब्राहम कनान देस मैं बस गौ, और लूत तराई के सहरन मैं बसो, बौ सदोम नगर के झोने अपनो डेरा डारी, <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />प्रभु की नजर मैं सदोम नगर के लोग भौत दुस्ट और पापी रहैं।<verse eid="GEN 13:13" /></para>
  <para style="s">अब्राहम हेब्रोन सहर कै जाथै</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />लूत के जान के बाद प्रभु अब्राहम से कही, “तैं जहाँ है, हूँनै से अपनी नजर चारौ घाँईं घुमा और ध्यान से देख। <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />काहैकि मैं तोकै और तेरे बंस कै बौ सब जमीन जो तू देखथै, देन जाए रौ हौं, और बौ हमेसा तुमरी रैहगी। <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />मैं तेरे वंसज कै पृथ्वी के कनकी के समान करंगो, हिंयाँ तक कि जो कोई पृथ्वी के धूधर की कनकी कै गिन सकैगो बहे तेरे बंस कै भी गिन सकैगो! <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />उठ, जौ पूरे देस मैं घूम-फिर; काहैकि मैं जौ देस तोकै दुंगो।” <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />फिर अब्राम अपनो डेरा हटाएकै हेब्रोन के ममरे के पवित्र पेंड़ के झोने बस गौ, और हूँना बौ प्रभु के ताहीं एक बेदी बनाई।<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">अब्राम लूत कै बचाई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />जे चार राजा, बेबीलोन को राजा अम्रापेल, एल्लासार को राजा अर्योक, और एलाम को राजा कदार्लाओमर, और गोयीम को राजा तिदाल, सिनार के जे राजा जौ समय मैं सासन करत रहैं, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />जे पाँच और दुसरेन राजा से लड़ाई करन गै: सदोम को बेरा, गमोरा को बिरसा, और अदमा को राजा सिनाब, और सबोयीम को राजा सेमेबेर, और बेला (सोअर) को राजा। <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />जे राजा मिलकै एक गठजोड़ करीं और सिद्दीम की घाटी मतलब मृतसागर मैं जुराने। <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />बे बाहरै साल ले कदार्लाओमर के काबू मैं रहे, लेकिन तेरहमों साल मैं जे बाके खिलाफ बगावत कर दईं। <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />चौहदमें साल मैं कदार्लाओमर और बाके संग के राजा अपनी सेना के संग मिलकै अस्तारोत्कनम मैं रापाईन कै, और हाम मैं जूजिन कै, और किर्यातैम के मैदान मैं एमियन कै हराईं। <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />और एदोम के पहाड़ ले होरी लोग बंजर जमीन के किनारे एल्पारान ले उनको पीछा करत गै। <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />फिर बे लौटे और कादेस मैं बापिस आए गै (जौ एन्मिसपात के नाओं से जानो जात रहै)। बे अमालेकियन की सब जमीन जघा कै जीत लईं और हसासोरन्तामार मैं रहन बारे एमोरियन कै भी हराए दईं।<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />तौ सदोम, गमोरा, अदमा, सबोयीम, सोअर और बेला के निरे राजा सिद्दीम की घाटी मैं लड़ाई के ताहीं अपनी सेना जोरीं, और लड़ीं। <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />अम्रापेल, एलाम, कदार्लाओमर, गोयीम, बेबीलोन और अर्योक, तिदाल, एल्लासार जे सिनार के राजन के खिलाफ बे पाँचौ राजा, चारौ घाँईं से घेरा बनाईं। <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />घाटी कोलतार के गड्डन से भर गईं रहैं, और जब सदोम और गमोरा के राजा लड़ाई के मैदान से भाजन की कोसिस करीं, तौ बे बेईं गड्डन मैं गिर गै; लेकिन तीन राजा बचकै पहाड़ मैं भाज गै। <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />चारौ राजा सदोम और गमोरा मैं खानबारी चीज समेत सब कछु लूटकै चले गै। <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />लूत, अब्राहम को भतीजो, सदोम मैं रहत रहै, और बाकी पूरी सम्पत्ति समेत बहो कै लै गै।<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />एक इंसान, जो भाजकै बचगौ रहै, इब्रानी जाति के अब्राम के झोने आओ, और उन्हैं जौ खबर दई। अब्राम ममरे पेंड़ के जंगल मैं रहथै, जौ जंगल एमोरी जाति के ममरे नाओं के आदमी को रहै। और बे बासे वाचा बाँधी रहैं, बौ एसकोल और आनेर को भईय्या रहै। जे तीनौं अब्राम के बड़ा गहरे दिलबर रहैं। <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />जब अब्राम सुनी कि बाके भतीजे लोट कै पकड़ लईं हैं, तौ बौ अपने संग के सब लड़ाकू सिपईय्यन कै लैकै, जो कुल मिलाएकै तीन सौ अट्ठारह होंगे, उनकै समेटी और दान नगर ले बे चारौ राजा को पीछा करी। <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />बौ अपने आदमिन कै अलग-अलग हिस्सा मैं बाँट दई, और रात मैं दुस्मन ऊपर हमला करी और उन्हैं हराए दई। और दमिस्क नगर के सीरे की दिसा मैं होबा सहर ले उनको पीछा करी, <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />और उनको लूटो भौ माल जप्त कर लई। बौ अपने भतीजो लूत और बाकी संपत्ति, बईय्यरैं और सब कैदियन कै भी बापिस लै आई।<verse eid="GEN 14:16" /></para>
  <para style="s">अब्राम कै मलकीसेदेक की आसीस</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />जब अब्राम कदार्लाओमर और दुसरे राजा के ऊपर जीत हासिल करकै बापिस लौटत रहैं, तौ सदोम को राजा सावे नाओं की घाटी जोकै राजा की घाटी भी कहत रहैं, मैं बासे मिलन के ताहीं आओ। <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />और सालेम को राजा मलिकिसिदेक अब्राहम के झोने रोटी और दाखरस लै आओ, बौ परमप्रधान परमेस्वर को पुजारी रहै। <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />और अब्राम कै जौ कहकै आसिर्वाद दई, “परमप्रधान परमेस्वर, स्वर्ग और पृथ्वी को रचना करन बारो, अब्राम कै आसीस देबै! <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />परमप्रधान परमेस्वर, जो तुमकै आसीस करकै तुमरे दुस्मन ऊपर जीत दिबाई, बाकी स्तुति करौ!” और फिर अब्राम मलकीसेदेक कै सारे लूट के धन मैं से दसमों हिस्सा दई जो बौ लूटी रहै।<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />सदोम को राजा अब्राम से कही, “लूट को धन तैं अपने झोने रख ले, लेकिन मेरे सब लोगन कै मोकै लौटार दे।” <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />अब्राहम सदोम के राजा कै जबाब दई, मैं स्वर्ग और पृथ्वी को रचन बारो परमप्रधान परमेस्वर प्रभु की हाथ उठाएकै कसम खाएकै कहथौं, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />कि मैं तेरो कछु नाय रखंगो, हिंयाँ तक कि एक सूत डोरा और चप्पल को पट्टा भी नाय। तौ तुम जौ भी नाय कह पागे, कि मेरे बजह से अब्राम सेठ भौ है। <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />पर जो कछु जे आदमी खाई हैं, और जो आदमी मेरे संग गै रहैं, उनके हिस्सा के अलावा, मैं कछु ना लुंगो। लेकिन मेरे गहरे दिलबर-आनेर एसकोल और ममरे अपनो-अपनो हिस्सा लै लियैं।<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">अब्राम के संग परमेस्वर की वाचा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />जे घटना के बाद अब्राम एक दर्सन देखी। उन्हैं प्रभु को जौ संदेस मिलो, “अब्राम मत डराबै। मैं तेरी ढाल हौं तोकै हर खतरा से बचांगो और तोकै भौत बड़ो इनाम दुंगो।”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />तौ अब्राम जबाब दई, “प्रभु, मैं तौ बिन औलाद हौं और अब तेरे इनाम से मोकै का फायदा है? मेरे परिवार को एकै वारिस दमिस्क नगर को एलीएजेर आदमी होगो।<note caller="+" style="f"><char style="fr" closed="false">15:2 </char></note> <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />अब्राहम कही तू मोकै कोई औलाद नाय दौ, और जौ बजह से मेरे घर मै जनमो दासन मैं से कोई एक मेरी सम्पत्ति को वारिस होगो।”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />फिर बौ प्रभु कै फिर जौ कहत सुनी, “जौ दास एलीएजेर तेरी सम्पत्ति को वारिस नाय होगो; बल्कि तेरो अपनो लौड़ा तेरो वारिस होगो।” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />प्रभु बाकै दुआरे लै जाएकै कही, “आसमान के घाँईं देख और तारन कै गिनन की कोसिस कर; तेरो बंस ऐसोई होगो।”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />अब्राम प्रभु ऊपर भरोसा करी, और प्रभु बाके विस्वास कै देखकै बाकै धार्मिक बोली।<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />फिर प्रभु बासे कही, “मैं प्रभु हौं, जो तोए कसदियन के ऊर नगर से निकार कै लाओ, कि जौ देस कै तेरे अधिकार मैं देमौं।”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />लेकिन अब्राहम पूँछी, “प्रभु, मैं कैसे जानंगो कि जौ देस मैं मेरो ही अधिकार होगो?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />बौ अब्राम कै जबाब दई, “मेरे ताहीं एक बछिया, एक बकरिया और एक भेंड़, जो सब तीन-तीन साल के होमैं, और एक धौंरिया और एक कबूतर लै आ।” <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />और अब्राम जे सब जानवरन कै परमेस्वर के झोने लाई, और इनकै बीच से दुई टुकड़ा मैं बाँट दई और जे टुकड़न कै एक दुसरे के सामने धर दई; लेकिन पक्छिन के टुकड़ा नाय करी। <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />जब मांसाहारी पक्छी इनके ऊपर झपेटा मारी, तौ अब्राम इनके झुंग कै भजाए दई।<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />जब दिन ढलन लग्गौ, तौ अब्राम गहरी नींद मैं सोए गौ, और तभई बाकै घोर अंधकार और डर की दहसत छाए गई। <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />प्रभु बासे कही, “अब्राहम तेरो बंस परदेस मैं परदेसी रहेगो; बे हुँआँ दास रहमंगे और चार सौ साल ले उनके संग बे बुरो बर्ताव करंगे। <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />फिर जो देस के बे दास होंगे उनकै मैं सजा दुंगो, और जाके बाद बे भौत सेठ हीकै हूँना से निकरंगे। <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />तौ अब्राहम अपने पुर्खन के संग सांतिपूर्ड़ जागो, और तोकै तेरे बुढ़ापे मैं मट्टी देंगे। <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />लेकिन बे चौथी पीढ़ी मैं हिंयाँ दुबारा से आंगे, काहैकि अब तक एमोरी जाति को अधर्म पूरो न भौ है।”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />जब दिन मुंद गौ और घोर अंधियारो छाए गौ, तौ एक धुआँ और एक आगी को खम्मा और एक जलत भई मसाल बे मरे भै जानवरन के टुकड़न के बीच से हुईकै गई। <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />बहे दिन प्रभु अब्राम के संग वाचा भाँदी, और बासे कही, “मिस्र देस की नदिया से लैकै फरात नाओं की बड़ी महानद ले जित्ते देस है बे मैं तेरे बंस कै देथौं, <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />मतलब केनिया, कनिज्जिया, कदमोनिया <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />हित्ती, परिज्जी, रापाईन, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />एमोरिया, कनानी, गिर्गासिया और यबूसियन देस, मैं जौ सब तेरे बंस कै दै दौ हौं।”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">हाजिरा और इस्माएल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />अब्राम की बईय्यर सारा की औलाद नाय रहै। लेकिन बाके झोने हाजिरा नाओं की एक मिस्री दासी रहै, <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />सारा अब्राम से कही, “प्रभु मोकै कोई औलाद नाय दई है, जौ बजह से मैं तोसे बिनती करथौं कि तू मेरी दासी के झोने जा; और ऐसो करकै बाके जरिया मैं बालका बारी बन जामौं।” सारा की बात अब्राम मान लई। <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />जब अब्राम कै कनान देस मैं रहत दस साल गुजर चुके। तौ बाकी बईय्यर सारा अपनी मिस्री दासी हाजिरा कै लैकै अपने लोगा अब्राम कै दै दई, कि बाकी बईय्यर बन सकै। <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />अब्राम हाजिरा के झोने गौ और बौ गर्भवती भई; जब बाकै लगो कि मैं गर्भवती हौं तौ बौ अपनी मालकिन सारा कै अपनी नजर मै तुच्छ समझन लागी।<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />तौ सारा अब्राम से कहथै, “जो मेरे संग गलत भौ है बौ तेरे संग नाय होबै। मैं तौ अपनी दासी कै तेरी बईय्यर बनाए दौ; लेकिन जब बाकै पता चलो कि मैं गर्भवती हौं, तौ बौ मोकै तुच्छ समझन लगी, जौ बजह से प्रभु मेरे और तेरे बीच मैं फैसला करै!” <verse eid="GEN 16:5" /><verse number="6" style="v" sid="GEN 16:6" />अब्राम सारा से कही, “देख तेरी दासी तेरे काबू मैं है; जैसो तोए अच्छो लगै बैसिये बाके संग कर।” तौ सारा हाजिरा कै परेसान करन लगी और हाजिरा बाके झोने से भाज गई।<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />सूर की रस्ता मैं, बन मैं एक झरना के झोने प्रभु को स्वर्गदूत हाजिरा से बोली <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />और कहथै, “हाजिरा, सारा की दासी, तैं कितै से आथै और कहाँ कै जाथै?” बौ जबाब दई, “मैं अपनी मालकिन की सेवा से भाजयाओ हौं।”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />तौ स्वर्गदूत कही, “अपनी मालकिन के झोने लौट जा और बहे की आधीन मैं रहा।” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />और प्रभु को स्वर्गदूत बासे जहो कही, “मैं तेरे बंस कै भौत बढ़ांगो, हिंयाँ ले कि इनकी गिनती तक न हुई पागी।” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />फिर प्रभु को स्वर्गदूत हाजिरा से कही, “देख, तू पेट से होगी। तैं एक लौड़ा कै जनम देगी, और तैं बाको नाओं इस्माएल रखिये, काहैकि प्रभु तेरो दुख को हाल सुनी है। <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />लेकिन बौ इंसान एक जंगली गधा के तराहनी होगो; बाको हात सबके खिलाप उठैगो, और बे सब बाके विरुध्द होमंगे बौ अपने करीबी भाई-बंधुवन के बीच मै दुस्मनन के हानी रहेगो।”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />हाजिरा खुद से पूँछथै, “का मैं सच्ची मैं परमेस्वर कै देखो हौं, और जाके बारे मैं बतान ताहीं जिंदो हौं?” जौ बजह से बौ प्रभु कै, जो बासे बात करी रहै, देखन बारो परमेस्वर कही। <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />जौ बजह से बौ कुआँ को नाओं “बएर-लहई-रोई” रखो गौ। जौ कुआँ कादेस और बेरेद के बीच मैं है। <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />हाजिरा से अब्राम को एक लौड़ा पैदा भौ, और बौ बाको नाओं इस्माएल रखी। <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />जब हाजिरा अब्राम के जरिये इस्माएल कै जन्माई रहै, बौ समय अब्राम छियासी साल को रहै।<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">खतना और वाचा को चिन्ह</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />जब अब्राम निन्यानबै साल को भौ, तभई प्रभु बाकै दर्सन मैं कही, “मैं सर्वसक्तिमान परमेस्वर हौं, मेरी मौजूदगी मैं चल और निर्दोस आचरड़ को ही जा। <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />मैं तेरे संग वाचा बाँधंगो, और तेरे वंस कै भौत बढ़ांगो।” <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />तौ अब्राम लोहोक्कै परमेस्वर कै प्रड़ाम करी, और परमेस्वर बासे बात करी, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />देख, मैं तेरे संग वाचा बाँधे रहेंगो: तैं सब रास्ट्रन को मूलपिता कहो जागो। <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />जौ बजह से अब से तेरो नाओं अब्राम न रहेगो लेकिन तेरो नाओं अब्राहम होगो; काहैकि मैं तोए सब रास्ट्रन को मूलपिता ठहराए दौ हौं। <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />मैं तोए भौत फलवन्त करंगो, और तोकै सब रास्ट्रन को मूल बनाए दुँगो, और तेरे वंस मैं तमान राजा जनम लेंगे।<verse eid="GEN 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 17:7" />“और मैं तेरे संग और तेरे बाद पीढ़ी-पीढ़ी ले, तेरे वंस के संग हमेसा ताहीं वाचा बाँधथौं, कि मैं तेरो और तेरे बाद को भी परमेस्वर रहेंगो। <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />और मैं तोकै और तेरे बाद तेरे वंस कै भी, जौ सारो कनान देस, जोमैं तू परदेसी हीकै रहथै, तोकै हमेसा के ताहीं जौ जमीन दुंगो, और मैं बे सबन को परमेस्वर रहंगो।”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />फिर परमेस्वर अब्राहम से कही, मेरे संग बाँधी भई वाचा को पालन करिये, तैं और तेरे बाद को वंस भी मेरी वाचा को पालन पीढ़ी दर पीढ़ी करत रहबै। <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />मेरे संग बाँधी भई वाचा जोको पालन तोकै और तेरे वंस कै करने पड़ैगो बौ जौ है तुम मैं से हर एक खतना करो जाबै। <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />तुम अपनो-अपनो खतना करबाए लिओ, जो वाचा मेरे और तुमरे बीच मैं है, बाको जहे चिन्ह होगो। <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />तुमरे हर एक बालका को खतना बाके जनम के आठवें दिन करो जाबै। और हर एक पीढ़ी के आदमी को खतना होनो चाहिए, चाहे बौ तुमरे घर मै जन्में भै नौकर होमैं, मतलब विदेसी से रुपईया दैकै खरीदे गै होमैं, जो तेरे बंस के ना होमैं। <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />जो तेरे घर मैं पैदा होमैं, या तेरे रुपईया से मोल लौ जाबै, बाको खतना जरूरी है; जौ मेरी वाचा जोको निसान तुमरी सरीर मै होगो, बौ हमेसा-हमेसा रहबैगो। <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />जो आदमी बिन खतना को होगो, मतलब जोकी खाल को खतना न होगो, बौ इंसान अपने लोगन मै से नास करो जाबै, काहैकि बौ मेरे संग बाँधी भई वाचा कै तोड़ दई।<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />फिर परमेस्वर अब्राहम से कही, “तेरी जो बईय्यर सारै है; बाकै तैं अब सारै मत कहिये, अब से बाको नाओं सारा होगो।<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">सारा को मतलब “राजकुमारी।” </char></note> <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />मैं बाकै आसीस दुँगो, और तोकै बाके जरिया एक लौड़ा दुँगो। और मैं बाकै ऐसी आसीस दुँगो कि बौ रास्ट्रन की मूलअईय्या बन जागी; और बाके वंस मैं राज्य-राज्य के राजा जनम लेंगे।”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />तौ अब्राहम मोहों के बल गिरकै हँस पड़ो, और मन ही मन कहन लगो, “का सौ साल के आदमी से बालक पैदा होगो और का सारा जो नब्बे साल की है बौ बालकन कै जनम देगी?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />अब्राहम परमेस्वर से कहथै, इस्माएल तेरी निगाह मैं बनो रहबै जहे भौत है। <verse eid="GEN 17:18" /><verse number="19" style="v" sid="GEN 17:19" />तौ परमेस्वर कही, जरूर तेरी बईय्यर सारा को तोसे एक बालका पैदा होगो; और तू बाको नाओं इसहाक रखिये; और मैं बाके संग ऐसी वाचा बाँधंगो जो बाके बाद बाके वंस के संग हमेसा-हमेसा की वाचा होगी। <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />मैं इस्माएल की प्रार्थना कै सुनो हौं, देख, मैं बहो कै भी आसीस दुँगो, और बाकै फलवन्त करंगो बासे बारह सासक पैदा होंगे, और मैं बासे एक महान रास्ट्र बनांगो। <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />लेकिन मैं अपनी वाचा इसहाक के संग बाँधंगो जो सारा से अगले साल जहे समय मै पैदा होगो। <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />जब परमेस्वर अब्राहम से बात कर चुको, तौ बौ अब्राहम के झोने से ऊपर चले गौ।<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />तौ अब्राहम अपने लौड़ा इस्माएल कै लई और बाके घर मैं जित्ते पैदा भै रहैं, और जित्ते बाके रुपईया से मोल लै भै दासन को, मतलब बाके घर मैं जित्ते लोग रहैं, बे सबन को बहे दिन खतना करी कैसे परमेस्वर बासे कही रहै। <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />जब अब्राहम को खतना भौ, तौ बौ निन्यानबै साल को रहै। <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />और जब बाके लौड़ा इस्माएल को खतना भौ, तौ बौ तेरह साल को रहै। <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />अब्राहम और बाके लौड़ा इस्माएल दोनो को खतना एकै संग और एकै दिन कै भौ। <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />और बाके घर मै जित्ते आदमी रहैं जो घर मैं पैदा भै, जो इनकै विदेसी के हात से रुपईया दैकै मोल लै गै रहैं जे सबन को खतना बाके संगै भौ।<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">अब्राहम कै लौड़ा देन की प्रतिग्या</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />अब्राहम ममरे के बांज के पेंड़ के बीच दुपारी के समय तम्बू के मोहोट मै बैठो भौ रहै, तभई प्रभु बाकै दर्सन दई, <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />बौ अपनी आँखी उठाएकै देखी तौ का देखी, कि तीन आदमी बाके सामने ठाड़े हैं। जब बौ उनकै देखी तौ बौ उनसे भेंटा करन के ताहीं तम्बू के मोहोट से दौड़ पड़ो, और जमीन मैं घुपटियाए कै नमस्कार करी, <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />और कहन लगो “मेरे प्रभु, अगर मेरे ऊपर तुमरो अनुग्रह है तौ मैं विनती करथौं कि अपने दास के झोने से चले मत जइयो थोड़ी देर मेरे झोने रुक जाबौ। <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />मैं अभई पानी लाथौं, और तुम अपने पाँव धोएकै जौ पेंड़ के तरे आराम करियो। <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />तौले मैं रोटिन को टुकड़ा लै आमौं, कि तुमकै बाकै खाएकै आराम मिले। बाके बाद सफर के ताहीं अग्गू जले जईयो, काहैकि तुम अपने दास के झोने आए हौ, बे कहीं, जैसो तू कहथै बैसो ही कर।”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />तौ अब्राहम तुरन्तै तम्बू मैं सारा के झोने गौ और कही, “तीन बड़े माना मैदा जल्दी से गूँथ, और रोटी बना।” <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />फिर अब्राहम गईंय्या-बरधा के झुंग के पच्छू दौड़ो और एक अच्छो बछरा लाएकै अपने नौकर कै दई, और बौ जल्दिये से बाकै पकान लग्गौ। <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />तौ बौ दही, दूध और जानवर को माँस जो बौ पकाई रहै, लैकै उनके अग्गु परस दई; और खुद बौ पेंड़ के तरे ठाड़ो रहो, और बे खानू खान लगे।<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />बे बासे पूँछी “तेरी बईय्यर सारा कहाँ है?” बौ जबाब देथै, बौ तौ तम्बू मैं है। <verse eid="GEN 18:9" /><verse number="10" style="v" sid="GEN 18:10" />फिर बामैं से एक जनी कहथै, “मैं पारसाल जहे समय तुमरे झोने फिर आंगो; और तेरी बईय्यर सारा को एक बालका पैदा होगो।” सारा तम्बू के मोहोट से सब सुनत रहै। <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />अब्राहम और सारा दोनो बुढ़े ही चुके रहैं, और सारा को महेना आनो बंद ही गौ रहै। <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />तभई सारा अपने मन मै हँस कै प्रभु से कहन लगी, “मैं तौ बूढ़ी हौं और मेरो लोगा भी बुड्डा पड़ गौ है, तौ का मोकै जौ सारीरिक संबंध को सुख मिलैगो?” <verse eid="GEN 18:12" /><verse number="13" style="v" sid="GEN 18:13" />तौ प्रभु अब्राहम से कही, “सारा ऐसे कहकै काहे हँसी, ‘कि मैं जो बुढ़िया पड़ गौ हौं, का बूढ़ेकाल मैं सच्ची मैं मेरो एक लौड़ा पैदा होगो?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />का प्रभु के ताहीं कोई काम कठिन है? समय के हिसाब से, मतलब नौ महेना मैं तेरे झोने मैं फिर आंगो, और सारा की गोदी मै एक लौड़ा होगो।”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />तौ सारा डर के मारे जौ कहकै मुकर गई, “मैं ना हँसो रहों,” बौ कही।</para>
  <para style="p" vid="GEN 18:15">“हाँ तू सच्ची को हँसी रहै” बौ कहथै।<verse eid="GEN 18:15" /></para>
  <para style="s">अब्राहम को सदोम के ताहीं गुजारिस</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />फिर बे आदमी हूँना से उठे, और बे सदोम नगर के घाँईं निगाह करीं; और अब्राहम उनकै बिदा करन के ताहीं उनके संग-संग गौ। <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />तौ प्रभु कही, “जो काम मैं करन जाए रौ हौं, का बौ अब्राहम से लुकाए रखौं। <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />अब्राहम से तौ जरूर एक सक्तिसाली रास्ट्र बनैगो, और पृथ्वी की सब रास्ट्र बाके जरिया आसीस पांगे। <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />मैं बाकै चुनो हौं कि बौ अपने लौड़न और परिवार कै, जो बाके बाद रहमंगे, सिक्छा दे कि बे धार्मिकता और न्याय के काम करैं और मुझ-प्रभु के रस्ता मैं चलते रहमैं। तौ मैं बौ वचन कै पूरो करंगो जो मैं अब्राहम कै दौ हौं।”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />फिर प्रभु अब्राहम से कही, “सदोम और गमोरा के खिलाफ बुराई को आरोप भौत बढ़ गौ है, और उनको पाप भौत बड़ गौ है। <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />मैं उतरकै देखंगो, कि बाकी जैसी दुहाई मेरे कान ले पहोंची है, बे ठीक बैसो ही काम करी हैं कि नाय; जो मेरे तक पहुँची है, अगर न करीं तौ मैं बाकै जान जांगो।”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />फिर बे आदमी हूँना से घूमकै सदोम के घाँईं जान लगे, लेकिन अब्राहम प्रभु के अग्गू ठाड़ गौ। <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />तौ अब्राहम बाके करीब जाएकै कहन लगो, “प्रभु, का तू सच्ची मैं दुस्ट के संग धर्मीन कै भी नास करैगो? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />अगर बौ सहर मै पचास धर्मी भी होमैं तौ का तू सच मैं उनकै छमा नाय करन की बजह उनकै नास करैगो? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />जौ तराहनी को काम करनो तोसे दूर रहबै, कि दुस्ट के संग धर्मी भी मारे जामैं। धर्मी और दुस्ट दोनों की दसा एकै होबै, जौ काम तोसे कहू ना होबै। का पूरी पृथ्वी को न्यायी सही न्याय न करैगो?” <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />प्रभु कही, “अगर सदोम मै पचास धर्मी मिलैं तौ उनकी बजह से बौ उनकै छमा करी और बौ सब सहर कै खतम नाय करी।”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />फिर अब्राहम कही, “प्रभु, सुन मैं तौ मट्टी और राख जैसी आदमी हौं; फिर भी मैं तोसे इतनी बेतुकी भरी बात करो, बाके ताहीं मोकै माफ करिये। <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />अगर उन मै से पचास धर्मी मै से पाँच भी कम ही जामैं; तौ का तू पाँच के कम होन की बजह से बौ पूरे सहर कै नास करैगो?”</para>
  <para style="p" vid="GEN 18:28">बौ कही, “अगर बामै पैंतालीस धर्मी लोग भी मिलैं तौ भी बाकै नास न करंगो।”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />फिर अब्राहम बासे कहथै, मान ले, अगर हूँना चालीस मिलैं? प्रभु जबाब देथै, “तौ मैं चालीस की बजह से बौ सहर कै नास न करंगो।”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />फिर बौ कहथै, प्रभु गुस्सा मत हुइये, तौ मैं कुछ और कहमौं; अगर हूँना तीस धर्मी आदमी भी मिलैं। तौ भी ऐसो न करंगो।<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />फिर बौ कही, “प्रभु सुन, मैं तोसे दोहराए कै फिर से कहथौं।” अगर बामै से बीस धर्मी भी मिले, तौ भी मैं बौ सहर कै नास न करंगो।<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />फिर अब्राहम कही, प्रभु गुस्सा मत हुइये, और एक बात कहथौं, अगर उनमैं से दस मिलैं? बौ फिर जबाब देथै, “तौ मैं दस के ताहीं भी बाकै नास न करंगो।” <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />जब प्रभु अब्राहम बात कर चुको, तौ बौ चले गौ, और अब्राहम अपने घरै लौट गौ।<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">पापी सदोम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />जब संजाखिन दुई स्वर्गदूत सदोम नगर मैं आए, तौ लूत सदोम नगर के मोहोट मैं बैठो रहै। उनकै देखकै बौ उनसे भेंटा करन के ताहीं उठो। और मोखरा के बल लोहोक्कै बाको नमस्कार करी <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />और कही, मेरे स्वामियौं, मैं तुमसे बिनती करथौं। तुम अपने दास के घरै पधारौ और अपने पैर धुईयो। और हीनै रात रुकियो। फिर भोर होत खिना कि उठकै अपने रस्ता नेंग जइयो। लेकिन बे कहथैं, “न, हम नगर के चौराहे मैं ही रात काटंगे।” <verse eid="GEN 19:2" /><verse number="3" style="v" sid="GEN 19:3" />और बौ उनकै भौत विनती करकै मनाई; तभई बे बाके संग चलकै बाके घर मैं आए; और बौ उनके ताहीं खानू की व्यवस्था करी, और बेखमीर की रोटी बनाएकै उनकै खबाई।<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />उनके सोन से पहले, सदोम सहर के लोग जुआन से लैकै बुढ़े ले, बल्कि चारौ घाँईं के सब लोग आएकै बौ घर कै घेर लईं। <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />और लूत कै आबाज दैकै कहन लगे, जो लोग आज रात कै तेरे झोने आए हैं बे कहाँ हैं? उनकै हमरे झोने बाहर लै आ, कि हम उनसे छिनरई करैं। <verse eid="GEN 19:5" /><verse number="6" style="v" sid="GEN 19:6" />तौ लूत उनके झोने फाटक के बाहर गौ, और फाटक की किलिया कै अपने पच्छू बन्द करकै कही, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />बौ कही, मैं तुम लोगन कै हात जोड़थौं, भईय्यौ, ऐसो मत करियो। <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />सुनौ, मेरी दुई लौड़िया हैं जिनकै अब तक कोई आदमी इनको मोहों तक नाय देखी है, तुमरी इच्छा होए तौ मैं उन्हैं तुमरे झोने लै आमौं, और तुमकै जैसो अच्छो लगै उनके संग बैसो बर्ताव करियो। लेकिन जे लोगन कै संग कछु मत करियो, काहैकि जे मेरी छत तरे आए हैं।<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />बे कहीं हट जा, फिर बे कहन लागे, तू एक परदेसी हीकै हिंयाँ रहन के ताहीं आओ है पर अब न्यायी बन बैठो है, तभई अब हम उनके संग भी बुरो करंगे, और लोग लूत कै धकेल कै फाटक तोड़न ताहीं आए गै। <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />पर बे दोनों आदमी हाथ बढ़ाएकै लूत कै अपने झोने भीतर खींच लईं, और फाटक बंद कर दईं। <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />और बाके बाद बे दोनों आदमी बड़े-छोटे सब आदमिन कै जो घर के मोहोंट मैं रहैं, अंधरा बनाए दई। और बे फाटक कै टपटोरत-टपटोरत थक गै।<verse eid="GEN 19:11" /></para>
  <para style="s">लूत को सदोम से निकरनो</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />फिर बे दोनो लूत से पूँछी, “हिंयाँ तेरो और कौन-कौन हैं - दमदा, लौड़ा, लौड़िया और तेरो जो कोई भी तेरो नातेदार होबै इन सब कै लैकै जौ सहर से निकर जा, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />हम जौ जघा कै नास करन बारे हैं। जाके खिलाप लोगन की बड़ी दुहाई प्रभु के झोने पहुँची है। प्रभु हमकै जाको विनास करन कै पनारी है।”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />तौ लूत निकरकै अपने दमदन के झोने गौ, जिनके संग बाकी लौड़ियन को बिहा होन बारो रहै। बौ उनसे कही, “उठौ, और जघा से निकर चलौ; काहैकि प्रभु जौ नगर कै नास करन बारो है।” पर बाके दमदा समझी कि बौ मजाक कर रहो है।<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />जब भोर होन लगो तौ स्वर्गदूत लूत से जल्दी करन कै कहीं और बोलीं, “जल्दी कर” अपनी बईय्यर और दोनो लौड़ियन कै हिंयाँ से लै जा, “ना तौ तहूँ जौ सहर के अधर्म मैं भसम ही जागो।” <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />लेकिन बौ देरादारी करी, लेकिन हूँना के लोग बाको और बाकी बईय्यर, दोनो लौड़िया को हात पकड़ कै सहर के बाहर कर दई। काहैकि प्रभु लूत के प्रति दयालु रहै। <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />और फिर ऐसो भौ जब बे निकरत रहैं तौ उनमैं से एक कही, पच्छू कै मत मुड़ियो और तराई मैं मत ठहरियो; बल्कि पहाड़ मैं चले जइयो नाय तौ तुम सब भी भसम ही जागे। <verse eid="GEN 19:17" /><verse number="18" style="v" sid="GEN 19:18" />लूत बासे कही, “प्रभु ऐसो मत कर। <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />देख तेरे दास ऊपर तेरो अनुग्रह है, और तू जामैं तैं बड़ी कृपा दिखाओ, कि मेरी ज्यान कै बचाओ; लेकिन मैं पहाड़ मैं नाय भाज सकथौं; कहीं ऐसो ना होबै, कि कोई बिपत्ति मेरे ऊपर आए पड़ै, और मैं मर जामौं। <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />देख, ऊपर एक नगर है। बौ मेरे ताहीं झोने है। बौ कस्बा है। मोकै हुँआँ भाजकै जान दे। का बौ छोटो नगर ना है? तौ मेरी जान बच जागी।” <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />बौ लूत से कही, मै जौ नगर के बारे मैं तुमरी बिनती स्वीकार कर, जो सहर की चर्चा तैं कर रहो है, बाकै मैं नास नहीं करंगो। <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />तू हिंयाँ से जल्दी निकर जा, काहैकि जब ले तैं निकर ना जाबै तौ ले मैं कुछ ना करंगो। और जौ बजह से जौ सहर को नाओं सोअर पड़ो।<verse eid="GEN 19:22" /></para>
  <para style="s">सदोम और गमोरा को नास</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />लूत सोअर के करीब पहोंचत ही पृथ्वी मैं सूरज निकर आओ। <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />प्रभु तुरन्तै सदोम और गमोरा ऊपर स्वर्ग से गन्धक और आगी बरसाई। <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />बौ बे नगरन और पूरी घाटी कै, और सब रहन बारेन कै, और जमीन मैं जमन बारे पेंड़-पौधा का नस्ट कर दई। <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />लूत की बईय्यर जो बाके पच्छू रहै पलट कै देखी, और बौ नून को खम्मा बन गई।<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />भोर कै अब्राहम उठकै बौ एक ऊँची जघा मैं गौ, जितै बौ प्रभु के सामने ठाड़ो रहै। <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />और सदोम और गमोरा और तराई के सब देस के घाँईं अपनी आँखी उठाएकै का देखी कि बे सहरन मै धधकत भौ धुआँ मट्टी से निकरकै ऊपर उठ रहो है। <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />ऐसो भौ कि जब परमेस्वर घाटी के नगरन कै नस्ट करी, तौ बौ अब्राहम कै याद करी, जब बौ बे नगरन कै उलट-पुलट दई, जहाँ लूत रहत रहै, तौ विनास के बीच से लूत कै बचाए लाई।<verse eid="GEN 19:29" /></para>
  <para style="s">लूत और बाकी लौड़िया</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />लूत सोअर कै छोड़ दई, और पहाड़ मैं अपनी दोनो लौड़िया समेत रहन लगो; काहैकि बौ सोअर मैं रहन से डरात रहै। और बौ और बाकी दोनो लौड़िया एक गुफा मैं रहन लगे। <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />तौ बाकी बड़ी लौड़िया अपनी छोटी बहेनिया से कही, “आपन को दऊवा बुढ्ढा है, और पृथ्वी मै कोई ऐसो आदमी नाय है जो संसार की रीति के हिसाब से हमरे झोने आबै और आपन सन्तान दै सकै। <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />आ, और आपन अपने बाबा कै दाखरस पिबाएकै बाके संग सारीरिक संबंध बनामैं, जोसे कि आपन अपने बाबा के वंस कै बचाए रखामैं।” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />तौ बे बहे रात के समय अपने बाबा कै दाखरस पिबाईं, और तभई बाकी बड़ी लौड़िया अपने बाबा के संग सारीरिक संबंध के ताहीं गई। लेकिन बाको दऊवा नाय जान पाई, कि बौ कब संबंध बनाई, और उठकै चले गई।<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />और फिर ऐसो भौ कि दुसरे दिन बाकी बड़ी लौड़िया अपनी छोटी बहेनिया से कही, “देख, मैं कल रात कै अपने दऊवा संग सोउ रहौं; हम आज रात कै आपन बाकै दाखरस पिबामैं; तभई जाएकै बाके संग सारीरिक संबंध के ताहीं जइये ताकि आपन अपने बाबा को वंस बढ़ाए सकैं।” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />बे बौ रात के समय अपने दऊवा कै दाखरस पिबाईं, और छोटी लौड़िया जाएकै बाके संग सारीरिक संबंध बनाई, लेकिन बाके दऊवा कै सोन को और उठन को पता नाय चलो। <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />ऐसिये करकै लूत की दोनो लौड़िया अपने दऊवा से गर्भवती भईं। <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />बाकी बड़ी लौड़िया एक लौड़ा कै जनम दई और बाको नाओं मोआब रखी; बौ मोआब जाति को मूलपिता भौ। <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />और छोटी लौड़िया भी एक लौड़ा कै जनम दई, और बौ बाको नाओं बेनम्मी रखी; बौ अम्मोन वंस को मूलपिता भौ जो आज तक ले भी है।<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">अब्राहम और अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />फिर अब्राहम हूँना से तरिहाँए नेगेब के इलाका के घाँईं आएकै कादेस और सूर के बीच मैं ठहरो, और गरार सहर मैं रहन लगो, <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />और अब्राहम अपनी बईय्यर सारा के बारे मै कहन लगो, बौ मेरी बहेनिया है, तौ गरार को राजा अबीमेलेक अपने आदमिन कै भेजकै सारा कै बुलबाए लई। <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />रात कै परमेस्वर सपने मै अबीमेलेक से कही, “सुन, जो बईय्यर कै तैं रखो है, बाके बजह से तू मर जागो, काहैकि बौ सादीसुदा है और बाको लोगा है।”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />लेकिन अबीमेलेक अबले सारा के झोने नाय गौ रहै; तौ बौ कहथै, “प्रभु, का तू देस के निर्दोस आदमी कै भी मार डारैगो? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />का बौ खुद मोसे ना कही, कि बौ मेरी बहेनिया है और बौ बईय्यर भी खुद कही, कि बौ मेरो भईय्या है, मैं तौ अपने निस्कपट मन और निर्दोस हाथ से जौ काम करो।”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />परमेस्वर बासे सपने मै कही, “मैं जानथौं कि तू निस्कपट मन से जौ काम करो है, और मैं तोकै रोके भी रखो कि तैं मेरे खिलाफ पाप ना करै; जहे बजह से मैं तोकै बाकै छून तक नाय दौ। <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />अब बौ लोग की बईय्यर लौटा। काहैकि बौ भविस्यवक्ता है, और तेरे ताहीं प्रार्थना करैगो, और तू जीत रहगो, लेकिन अगर तू बाकै नाय लौटागो तौ याद रख कि, तू और तेरे जित्ते लोग हैं बे सब मर जांगे।”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />तड़के सुबेरे उठकै अबीमेलेक अपने सब कर्मचारिन कै बुलबाएकै जे सब बात उनकै सुनाईं, और बे लोग गजब डराए गै। <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />तौ अबीमेलेक अब्राहम कै बुलबाए कही, “तैं हमरे संग जौ का करो है? मैं तेरे प्रति कौन सो पाप करो रहौं कि तैं मोसे और मेरे राज्य के रहन बारेन से इतनो बड़ो पाप करवाओ? तैं मेरे संग जो व्यवहार करो है, बौ तोकै ना करनो चाहिए रहै।” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />फिर अबीमेलेक अब्राहम से पूँछी, “तैं का समझकै जौ काम करो?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />अब्राहम कही, मैं जौ काम जौ बजह से करो: कि मैं सोचत रहौं कि जौ जघा मै परमेस्वर को कोई भय कोई कै न है। जौ बजह से बे मोकै मेरी बईय्यर के बजह से मार डारंगे। <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />जासे जाधा, सच मै जौ मेरी बहेनिया है, जौ मेरी दऊवा की लौड़िया तौ है लेकिन मेरी अईय्या की लौड़िया नाय है; फिर जौ मेरी बईय्यर बन गई। <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />और ऐसो भौ कि जब परमेस्वर मोए अपने दऊवा को घर छोड़कै निकरन की आग्या दई, तौ मैं सारा से कहो कि “तैं मेरे ऊपर जौ कृपा करिये कि हर जघा मैं, आपन जहाँ-जहाँ जांगे हूँना-हूँना तू मेरे बारे मै बतइये कि जौ मेरो भईय्या है।”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />तौ अबीमेलेक अपनी भेंड़, बकरिया, गईंय्या-बरधा और दास, दासिन कै लैकै अब्राहम कै दई, और बाकी बईय्यर सारा कै भी बाकै लौटाए दई। <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />और अबीमेलेक कही, “देख, मेरो देस तेरे सामने है, जहाँ तोए भाबै हूँना तैं रह सकथै।” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />अबीमेलेक सारा से कही, “देख, मैं तेरे भईय्या कै एक हजार चाँदी के सिक्का दौ हौं। जो लोग तुम्हारे संग हैं, बे सब लोगन की नजर मैं जौ तुमरी निर्दोसता को सबूत है कि तुम निर्दोस हौ। सब लोगन के सामने, तुमरे संग न्याय भौ है।”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />अब्राहम प्रभु से प्रार्थना करी, और प्रभु अबीमेलेक और बाकी बईय्यर और दासिन कै चंगो करी ताकि बे फिर से बालकन कै पैदा कर सकैं। <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />काहैकि प्रभु अब्राहम की बईय्यर सारा की बजह से अबीमेलेक की बईय्यर और बाके घर की सब बईंय्यरन की कोक कै पूरी तरह से बंद कर दई रहै।<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">इसहाक को जनम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />प्रभु सारा से जो कही रहै बैसिये करी और सारा कै आसीस दैकै अपनो वादा कै पूरो करी, <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />सारा अब्राहम से गर्भवती भई, बौ बहे निर्धारित समय मैं, जोके बारे मैं परमेस्वर कही रहै, अब्राहम से बाके बुढ़ापे मैं लौड़ा कै जनम दई। <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />अब्राहम अपने लौड़ा को नाओं जो सारा से पैदा भौ रहै, इसहाक रखी, <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />और जब अब्राहम लौड़ा इसहाक आठ दिन को भौ, तौ बौ परमेस्वर की आग्या के जरिया बाको खतना करी। <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />जब अब्राहम को लौड़ा इसहाक पैदा भौ रहै तौ बाकी उम्र सौ साल की रहै। <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />और सारा कहथै, “परमेस्वर मोकै हसाई है, तौ सब सुननबारे भी मेरे संग हसंगे।” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />फिर सारा जौ भी कहथै, “कौन अब्राहम से कह सकथै, कि सारा बालकन कै दूध पिबागी। फिर भी देखौ मैं अब्राहम के बुढ़ापा मै एक लौड़ा कै जनम दौ।” <verse eid="GEN 21:7" /><verse number="8" style="v" sid="GEN 21:8" />और बौ बालका बड़ो भौ, और बाको दूध छुड़ाओ गौ; जिस दिन इसहाक को दूध छुटाओ गौ, बहे दिन अब्राहम एक बड़ो भोज दई।<verse eid="GEN 21:8" /></para>
  <para style="s">हाजिरा और इस्माएल कै भेजनो</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />एक दिन सारा मिस्री हाजिरा के लौड़ा कै, जोकै हाजिरा अब्राहम से पैदा करी रहै, अपने लौड़ा इसहाक के मजाक करत देखी। <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />जौ बजह से बौ अब्राहम से कहथै, “जौ दासी को लौड़ा सहित निकार दे; काहैकि जौ दासी को लौड़ा मेरे लौड़ा इसहाक के संग भागीदार न होगो।” <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />अपने लौड़ा इस्माएल के बारे मैं ऐसी बात अब्राहम कै भौत बुरी लगी। <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />तौ परमेस्वर अब्राहम से कहथै, “तैं बालक और अपनी दासी के बजह से बुरो मत मान। जो बात सारा तोसे कहथै, उनकै सुन। काहैकि इसहाक के जरिये तेरो वंसजन मैं तेरो नाओं बनो रहगो। <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />मैं दासी के लौड़ा से भी एक रास्ट्र पैदा करंगो; काहैकि बौ तेरी औलाद है।”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />अब्राहम तड़के सुबेरे उठकै रोटी और पानी से भरी चमड़ा की थैलिया हाजिरा कै दई, और बाके कंधा मै रखी, और बाके लौड़ा संग बाकै बिदा कर दई। हाजिरा चले जाथै, और बेर्सेबा के जंगल मैं भटकन लगी। <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />जब थैलिया को पानी खतम ही गौ, तौ बौ अपने लौड़ा कै एक झोंगड़ के नीचे छोड़ दई। <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />बौ बालका के सामने सौ मीटर की दूरी मैं बैठ गई; काहैकि बौ सोचत रहै, मैं अपने बालका की मौत अपनी आँखिन से नाय देख सकथौं। जब बौ बाके सामने से दूर बैठी तौ बालक चीख मार-मारकै रोन लगो।<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />परमेस्वर बौ लौड़ा की रोन की अबाज सुनी, और परमेस्वर स्वर्गदूत स्वर्ग से हाजिरा कै पुकारकै कहथैं, हाजिरा, तोकै का भौ है? मत डराबै; जहाँ तेरो लौड़ा पड़ो है हूँना से परमेस्वर बाकी अबाज सुनी है। <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />उठ अपने लौड़ा कै उठा और अपने हात मै पकड़। काहैकि मैं बाके जरिया एक बड़ो रास्ट्र बनामंगो। <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />तौ परमेस्वर बाकी आँखी खोल दई, और बाकै एक कुआँ दिखाई दई; तौ बौ जाएकै मसक कै पानी से भरकै अपने लौड़ा कै पिबाई। <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />और परमेस्वर बौ लौड़ा के संग रहो; जब बौ बड़ो भौ तौ जंगल मै रहत-रहत एक अच्छो धनुस धारी बन गौ। <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />जब बे पारन के जंगल मैं रहत रहैं। तौ बाकी अईय्या बाके ताहीं एक लौड़िया ढूँड़ी जो मिस्र देस की रहन बारी रहै, और बाके संग बाको बिहा कर दई।<verse eid="GEN 21:21" /></para>
  <para style="s">अबीमेलेक के संग अब्राहम की वाचा</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />बेईं दिनन मै एसो भौ कि अबीमेलेक अपने सेनापति पीकोल कै संग लैकै अब्राहम से कहन लगो, “जो कछू तू करथै बामै परमेस्वर की आसीस होथै। <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />तौ अब मोकै हिंयाँ जौ बारे मै परमेस्वर की कसम खा, कि तैं ना मोसे, ना मेरे बालकन और ना मेरे वंस से छल-कपट करैगो, लेकिन जैसी कृपा मैं तेरे ऊपर करो हौं, बैसिये तैं मेरे और मेरे देस के संग, जहाँ तैं रहथै, बैसिये व्यवहार करिये।”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />अब्राहम कही, “मैं कसम खाथौं।”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />और अब्राहम अबीमेलेक कै एक कुआँ के बारे मैं जो अबीमेलेक के दास अपनी ताकत से कब्जा कर लईं रहैं, सिकायत करी। <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />तौ अबीमेलेक कही, “मैं नाय जानथौं कि कौन जौ काम करी है; और तू भी मोकै ना बताओ, ले मैं जाके बारे मैं सुनो।” <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />अब्राहम भेंड़-बकरिया और गईंय्या-बरधा अबीमेलेक कै दई और बे दोनो आपस मै वाचा बाँधी। <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />अब्राहम सात मादा मेम्ना कै झुंग से अलग करकै रखी। <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />तौ अबीमेलेक अब्राहम से पूँछी, “जे सात मेम्ना के बच्चन कै अलग करो है बाको का मतलब है?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />अब्राहम कहथै, तू जे सात मेम्ना कै जौ बात के ताहीं गभा जानकै मेरे हात से ले, कि मैं जौ कुआँ खोदो हौं। <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />और बे दोनो बौ जघा मै कसम खाथैं, जौ बजह से बाको नाओं बेर्सेबा पड़ो। <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />जब बे बेर्सेबा मैं वाचा भाँदी तौ अबीमेलेक और बाको सेनापति पीकोल उठकै पलिस्तिन के देस मै लौट गौ। <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />फिर अब्राहम बेर्सेबा मै झाऊ को एक पेंड़ लगाई, और हूँना प्रभु से जो अन्नंत परमेस्वर है, प्रार्थना करी। <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />अब्राहम पलिस्तिन के लोगन के देस मै भौत दिन ले रहो।<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">अब्राहम की परिक्छा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />जे सब बात होन के बाद एसो भौ कि परमेस्वर अब्राहम कै आजमाथै; और बासे कहथै “अब्राहम!” और बौ जबाब देथै, “हाँ, देख मैं हिंयाँ हौं!”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />परमेस्वर कही, “अपने इकलौते लौड़ा इसहाक कै जोसे तू प्यार करथै, संग लैकै मोरिय्याह देस मै चले जा, और हूँना बाकै एक पहाड़ के ऊपर जो मैं तोए बतांगो और तैं अपने लौड़ा कै अग्नि-बलि मैं चढ़ा।”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />अब्राहम दुसरे दिन तड़के सुबेरे उठो और अपने सफर के ताहीं गधा कै तैयार करी, और अपने दुई सेवकन और अपने लौड़ा इसहाक कै संग लई, और अग्नि-बलि के ताहीं कठिया काटी और बौ जघा कै निकर पड़ो जोकि चर्चा परमेस्वर बासे करी रहै। <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />फिर तिसरे दिन अब्राहम आँखी उठाएकै बौ जघा कै दूर से देखी। <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />और अब्राहम अपने नौकरन से कही, “गधन के झोने हीनै ठहरे रहबौ; मैं और मेरो लौड़ा हूँना ले जाएकै और आराधना करकै, फिर तुमरे झोने लौट आंगे।” <verse eid="GEN 22:5" /><verse number="6" style="v" sid="GEN 22:6" />अब्राहम अग्नि-बलि की कठिया अपने लौड़ा इसहाक ऊपर लाद दई, और आगी और छुरिया कै अपने हात मै लई, और बे दोनो एक संग चल पड़े। <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />इसहाक अपने दऊवा अब्राहम से कही, “मेरे दऊवा, बौ कहथै हाँ, मेरे लौड़ा का बात है?” इसहाक कही, “देख, आगी और कठिया तौ हैं; लेकिन बलि के ताहीं भेंड़ कितै है?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />अब्राहम जबाब दई, “मेरे लौड़ा, परमेस्वर अग्नि-बलि के ताहीं मेम्ना को इंतजाम खुद कर लेगो।” और बे दोनो संग-संग अग्गु चलत गै।<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />जब बे लोग परमेस्वर के कहे गै जघा मैं पहोंचे, तौ अब्राहम हूँना वेदी बनाएकै कठिया कै सजाएकै रखी, और अपने लौड़ा इसहाक कै भाँदकै कठियन से बनी वेदी के ऊपर रख दई। <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />फिर अब्राहम हात मै छुरिया लई कि अपने लौड़ा की अग्नि-बलि करै। <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />पर परमेस्वर को स्वर्गदूत स्वर्ग से पुकारकै कही, “अब्राहम, अब्राहम!” बौ जबाब दी, “हाँ मैं हिंयाँ हौं।”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />फिर बौ कही, “जौ लौड़ा के ऊपर हात मत बढ़ा, और ना जाकै कछू कर; काहैकि तू मोसे अपने लौड़ा बल्कि अपनो इकलौतो लौड़ा कै भी ना रख छोड़ो; जासे मैं अब जान गौ कि तू परमेस्वर को भय मानथै।”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />अब्राहम अपने चारौ घाँईं देखथै, कि बाके पच्छू एक भेड़ा अपने सींगन से एक झोंगड़ मैं फसो भौ है, तौ अब्राहम जाएकै बौ भेंड़ा कै लई, और अपने लौड़ा की जघा मै अग्नि-बलि करकै चढ़ाई। <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />अब्राहम बौ जघा को नाओं “प्रभु यीरे रखी।” इसलै आज ले कहो जाथै, “प्रभु के पहाड़ मैं प्रबंध होगो।”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />फिर प्रभु के स्वर्गदूत दुसरी बार स्वर्ग से अब्राहम कै पुकारकै कही, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />“प्रभु कहथै: तैं जौ काम करो है; तैं मेरे ताहीं अपने लौड़ा, अपने इकलौते लौड़ा कै भी नाय रख छोड़ो। जौ बजह से मैं खुद अपनी सपथ खाथौं कि, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />मैं जरूर तोकै आसीस दुंगो, और तेरे वंस कै आसमान के तारन, और समुन्दर तट के रेत-कड़ के तराहनी अनगिनत बनांगो। तेरो वंस अपने दुस्मन के सहरन पर अधिकार करंगे।<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">हिब 6:13,14</char></note> <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />और पृथ्वी की सब जाति खुद कै तेरे वंस की बजह से आसीस पामंगे- काहैकि तू मेरी बात मानो है।”<note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">प्रेरि 3:25 </char></note> <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />तौ अब्राहम अपने सेवकन के झोने लौट आया, और बे बाके संग बेर्सेबा चले गै, और अब्राहम हूँना बस गौ।<verse eid="GEN 22:19" /></para>
  <para style="s">नाहोर के वंस</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />जे बात होन के बाद ऐसो भौ कि अब्राहम कै जौ सन्देस मिलो, तेरे भईय्या नाहोर से बाकी बईय्यर मिल्का कै आठ लौड़ा पैदा भै। <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />बाको पहलोठो लौड़ा ऊस भौ, और ऊस को भईय्या बूज और कामुएल, जो अराम को दऊवा भौ, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />फिर केसेद, हजो, पल्दास, यिद्लाप और बतूएल, <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />जे आठौ लौड़न कै मिल्का अब्राहम के भईय्या नाहोर के जरिया जन्माई। बतूएल रिबका को दऊवा बनो। <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />नाहोर कि उपबईय्यर रूमा नाओं की रहै; जोसे तेबह, गहम, तहस, और माका नाओं के लौड़न कै जनम दई।<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">सारा की मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />सारा एक सौ सत्ताईस साल तक जीथै। <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />बौ कनान देस के किर्यतअर्बा मतलब हेब्रोन मैं मर गई, और अब्राहम सारा के ताहीं सोक मनान और विलाप करन के ताहीं आओ।<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />अब्राहम मरे भै सरीर के सामने से उठकै बौ देस के रहन बारे हित्तियन से कही, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“मैं परदेसी हौं, हिंयाँ तुमरे बीच मैं रहथौं; मोकै कुछ जमीन बेंच देबौ, ताकि मैं अपनी बईय्यर कै दफनाए सकौं।”<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">हिब 13:9, प्रेरि 7:16</char></note> <verse eid="GEN 23:4" /><verse number="5" style="v" sid="GEN 23:5" />हित्ती अब्राहम कै जबाब दईं, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“हे राजा, हमारी बात सुन। हम तोकै एक सर्वसक्तिमान परमेस्वर के रूप मैं देखथैं; तैं हमरी सबसे अच्छी कबर मैं अपनी बईय्यर कै दफनाए दे। हम मैं से हमरे झोने जो सबसे अच्छी कब्र है बामैं दफना। हम मैं से कोई भी तोकै कब्र दैकै खुस होगो, ताकि तू बाकै दफनाए सकै।”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />अब्राहम हित्तियन के लोगन कै लोहोक्कै नमस्कार करी <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />और बौ उनसे कही, “अगर तुम मोकै मेरी बईय्यर कै हीनै दफनान देनो चाहथौ, तौ मेरी बात सुनौ, तुम सोहर के लौड़ा एप्रोन से नौहरे करौ। <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />ताकि बौ मकपेला की गुफा मोकै दै दियै। जो बाके खेत के किनारे मैं है। बौ तुम लोगन कि हाजरी मैं मोसे पूरी रुपईया लै लियै, और बाकै मोकै बेंच दियै, ताकि मैं अपने परिवार के ताहीं बाकै कब्रिस्तान बनाए सकौं।”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />एप्रोन खुद हित्तियन के बीच बैठो रहै; बौ नगर-द्वार मैं आन बारे सब हित्तियन कै सुनत भई, अब्राहम कै जबाब देथै, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“ना मेरे प्रभु, मेरी बात सुन। मैं तोकै ना खाली अपनी जमीन दुंगो, बल्किन कबर की गुफा भी, जो बामैं है। मैं अपने लोगन की हाजरी मैं अपनी जमीन तोकै देथौं। तैं अपनी मरी भई बईय्यर कै गुफा मैं दफनाए दिये।”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />और अब्राहम देस के रहन बारे हित्तियन के सामने लोहोक्कै अभिवादन करी। <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />और एप्रोन से कही, ताकि सब सुन सकैं, का मैं तोसे विनती कर सकथौं, कि सुन। मैं पूरो खेत रुपईयन से मोल ले लूँगो। मेरो भुगतान स्वीकार करौ, और मैं अपनी बईय्यर कै हूँनै दफनाए दुंगो।<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />एप्रोन अब्राहम कै जबाब देथै, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“हे मेरे प्रभु, मेरी बात सुन। बौ जमीन के टुकड़ा की कीमत सिरफ चार सौ चाँदी के सिक्का है। पर बौ तेरे और मेरे बीच मैं का है? तैं अपनी बईय्यर कै जामैं दफनाए दे।” <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />अब्राहम सहमत ही गौ, एप्रोन जितनो मूल्य हित्तियन कै सुनात भई बताई रहै, अब्राहम व्यापारीन के जरिया इस्तेमाल करी जानबारी मानक बजन के हिसाब से, एप्रोन कै चार सौ चाँदी के सिक्का तौलकै दई।<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />तौ ममरे के अगार की दिसा मैं मकपेला मैं जो संपत्ति एप्रोन की रहै, बौ अब्राहम की ही गई। जामैं खेत, मौजूद गुफा और संपत्ति के मैदान के सबै पेंड़ सामिल रहैं। <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />नगर-द्वार मैं आन बारे सब हित्तियन की हाजरी मैं अब्राहम के अधिकार मैं कर दै गै।<verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />बाके बाद, अब्राहम अपनी बईय्यर सारा कै मकपेला बारी जमीन की गुफा मैं दफनाए दई, जो कनान देस के ममरे मतलब हेब्रोन नगर है। <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />और ऐसे करकै बौ खेत जो हित्तिन को रहै, और हूँना की गुफा जो कब्रिस्तान रहै अब्राहम की संपत्ति बन गई।<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">इसहाक के ताहीं बईय्यर ढूँड़नो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />अब्राहम अब भौत बूढ़ो ही गौ रहै, और प्रभु बाके सब कामौं मै बाकै आसीस दई रहै। <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />अब्राहम अपने सबसे बड़े सेवक से, जो बाकी सारी सम्पत्ति को अधिकारी रहै, कही, अपनो हात मेरी जाँघ मैं रखकै वादा कर। <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />मैं चाहथौं कि तुम स्वर्ग और पृथ्वी के परमेस्वर प्रभु के नाओं पर जौ वादा करौ, कि तुम कनानी जाति की लौड़ियन मैं से, जिनके देस मैं रहथौं, बईय्यर ना लागे। <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />तुम्हैं बौ देस मैं वापस जाने होगो जहाँ मैं पैदा भौ रहौं और मेरे रिस्तेदार मैं से मेरो लौड़ा इसहाक के ताहीं एक बईय्यर लाने होगो।<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />लेकिन सेवक बासे पूँछी, “का होगो अगर बौ बईय्यर मेरे संग जौ देस मैं आन के ताहीं घरकै नाय छोड़ैगी? का मैं तेरे बेटे कै बौ देस मैं वापस भेज देमौं जहाँ से तू आओ है?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />अब्राहम जबाब दई, “ध्यान रखा, तैं मेरे लौड़ा कै हूँना कहू मत लैजईये! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />स्वर्ग को परमेस्वर प्रभु मोकै और मेरे दऊवा के परिवार से और मेरे भईय्यन के देस से ले आओ, और बौ मोसे पक्को वादा करी, कि बौ जौ देस मेरे वंस कै देगो। बौ अपनो स्वर्गदूत तेरे अग्गु भेजैगो, कि तू हूँना मेरे लौड़ा के ताहीं एक बईय्यर ले आबै। <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />अगर लौड़िया तेरे संग आन कै तैयार नाय है तौ तैं जौ वादा से आजाद ही जागो। लेकिन तैं कोई भी हालत मैं मेरे बेटा कै हुँआँ कसम नाय ले जइयो।” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />तौ सेवक अपने मालिक अब्राहम की जाँघन के बीच अपनो हात रखी, और अब्राहम जो कही रहै बाकै करन को वादा करी।<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />सेवक, अपने मालिक अब्राहम के ऊँटन मैं से दस ऊँट और सबसे अच्छे भेंट लैकै उनके भईय्या नाहोर के नगर कै चलो, जो सीरे-मेसोपोटामिया के आराम नाहरिम नगर मै गौ। <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />जब हूँना पहोंचो, तौ बौ ऊँट कै सहर के बाहर कुआँ के झोने घूँटो के बल बैठारी। संजा को समय रहै, बहे समय बईय्यरैं पानी लेन के ताहीं बाहर निकरीं रहैं। <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />तौ बौ प्रार्थना करी, प्रभु, मेरे मालिक अब्राहम के परमेस्वर, आज मेरे काम कै सिध्द कर और मेरे मालिक के ऊपर करूड़ा कर। <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />मैं हिंयाँ बौ कुआँ पर हौं जहाँ सहर की लौड़िया पानी लेन कै आत रहैं। <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />मैं उनमैं से एक से कहमंगो, महरबानी करकै अपनो घल्ला नीचे कर और मोए पानी पीन दे। अगर बौ कहगी, पी ले, और मैं तेरे सब ऊँट के ताहीं भी पानी लाँगो, “तौ बौ बहे लौड़िया होबै जोकै तैं अपने सेवक इसहाक के ताहीं चुनो है। जासे मैं जान लूँगो कि तैं मेरे प्रभु से करो अपनो वादा पूरो कर दौ है।”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />जासे पहले कि बौ प्रार्थना खतम करथै, रिबका अपने कंधा मै पानी को घल्ला लैकै बाहर आई। बौ अब्राहम के भइय्या नाहोर और बाकी बईय्यर मिल्का के लौड़ा बतूएल की लौड़िया रहै। <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />बौ भौत सुगड़ ज्वान लौड़िया रहै और हबै तक कुँवारी रहै, और बाको बिहा ना भौ रहै। बौ कुआँ के अंदर गई, और अपनो घल्ला भरकै तुरन्तै वापस आए गई। <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />सेवक दौड़कै बासे मिलो और बोलो, “महरबानी करकै मोकै अपने घल्ला से पानी पिबाए दे।”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />बौ राजा से कही, “पी ले, महोदय और जल्दी से अपनो घल्ला अपने कंधा से नीचे उतारी और पानी पिबाई। <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />जब बौ बाकै पानी पिबाए चुकी तौ बोली, जब ले तेरे ऊँट पानी ना पी लेमैं, मैं उनके ताहीं पानी भरंगो।” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />बौ जल्दी से अपनो घल्ला जानवरन के पीनबारे नाँद मैं खाली कर दई और जाधे पानी लाने के ताहीं कुआँ के घाँईं भाजी, जब तक कि बौ सबै ऊँट कै पानी नाय पिलाए दई तौ ले बौ पानी ढोत रही। <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />बौ आदमी चुपचाप बाकै देखत रहो, जौ देखन के बाद बौ सोचै कि का प्रभु बाकै कामयाबी दई है।<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />जब सब ऊँट पानी पी चुके, तौ सेवक छै ग्राम सोने की लौंगी, और बाके हातन के ताहीं एक सौ बीस ग्राम के दुई सोने के कंगन लैकै बाकै पहनाए दई। <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />और बौ बासे पूँछी, “कृपया, मोए बता कि तैं कौन की लौड़िया है? का तेरे दऊवा के घर मैं हमरे रुकन के ताहीं जघा है?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />बौ जबाब दई, “मैं नाहोर और मिल्का के लौड़ा बतूएल की लौड़िया हौं।” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />“हमारे घर मैं खूब भूसा और चारौ है और तुमरे रहन के ताहीं भी जघा है।”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />तौ बौ आदमी मुड़िया झुकाएकै प्रभु की आराधना करी। <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />बौ कही, मेरे मालिक अब्राहम को प्रभु परमेस्वर तू धन्य है, तैं अपनी करूड़ा और सच्चाई मेरे स्वामी से नाय हटाओ। प्रभु, तैं मेरे स्वामी के हितुवन के घर ले रस्ता मैं मेरी अगुवाई करो।<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />लौड़िया भाजकै अपनी अईय्या के घर पहुंची और पूरी कहानी बताई। <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />रिबका को लाबान नाओं को एक भईय्या रहै, और बौ बाहर बहे कुएँ के झोने जान के ताहीं दौड़ौ जहाँ अब्राहम को दास रहै। <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />जब लाबान लौंगी और रिबका के हातन मैं कंगन देखी और बाकी जौ बात सुनी, कि बौ आदमी मोसे ऐसी बात कही, तौ बौ बाहर कुआँ के घाँईं सेवक के झोने दौड़कै गौ। बौ बाकै कुआँ के झोने अपने ऊँट के झोने ठाड़ो देखी। <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />और कही, “मेरे संग घरै चल, तुम बौ इंसान हौ जोकै प्रभु आसीस दई है। तुम हिंयाँ बाहर काहे ठाड़े हौ? मेरे घर मैं तुमरे ताहीं एक कमरा तैयार है, और हुँआँ तुमरे ऊँटन के ताहीं भी जघा है।”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />अब्राहम को सेबक घर मैं आओ, लाबान ऊँटन को सामान खोलकै उन्हैं भुसा और चारौ दई। बौ सेवक और बाके संग बारेन की टाँग धोन के ताहीम पानी दई। <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />जब सेवकन अग्गु खान के सामान रखो गौ तौ बौ सेवक कहा, “जब तक मैं अपनी बात नाय कह लेथौं, तब तक खानू नाय खामंगो।” लाबान कही, “बोलौ।”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />फिर बौ कही “मैं अब्राहम को सेवक हौं।” <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />“प्रभु मेरे मालिक कै भौत आसीस दई है, और बाकै सेठ बनाए दई है। बहे बाकै भेड़-बकरिया, गईंय्या-बरधा, चाँदी, सोना, दास-दासियन, ऊँट और गधा दई। <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />मेरे मालिक की बईय्यर सारा के बुढ़ापा मैं बाको एक लौड़ा पैदा भौ, और मेरे मालिक अपनो सब कुछ बाकै दै दई है। <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />मेरो मालिक मोकै बाकी आग्या को पालन करन को कसम दई है। बौ कही, ‘कनानी देस की लौड़ियन मैं से मेरे लौड़ा के ताहीं बईय्यर मत चुनिये। <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />जाके बजाय, मेरे बाप-दादा के लोग, मेरे हितुवन के झोने जाबौ और बाके ताहीं एक बईय्यर चुनौ।’ <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />और मैं अपने मालिक से पूँछो, ‘का होगो अगर बौ मेरे संग नाय आबैगी?’ <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />तौ बौ मोसे कही, ‘प्रभु, जोकि मैं हमेसा आग्या मानत आओ हौं, अपनो स्वर्गदूत तुमरे संग भेजकै तुमरो सफर सफलता करंगो। और तैं मेरे लौड़ा के ताहीं मेरे अपने हितुवन और मेरे दऊवा के घराने मैं से एक बईय्यर लै आगो।’ <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />अगर तैं मेरे हितुवन के झोने पहुँचै और बे तोकै कोई लौड़िया ना देमैं, तौ तैं मेरी कसम से आजाद हुई जागो। ऐसी बात होन पर ही तैं मेरी कसम से आजाज हुई सकैगो।”<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />“आज जब मैं कुआँ मै आओ, तौ मैं प्रार्थना करो, ‘प्रभु, मेरे स्वामी अब्राहम को परमेस्वर, महरबानी करकै मोए जो मैं कर रहो हौं बामै तू कामयाबी दे। <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />मैं हिंयाँ कुआँ मैं हौं। जब कोई लौड़िया पानी लेन के ताहीं बाहर आबैगी, तौ मैं बासे कहमंगो कि बौ मोए अपनो घल्ला से पानी पिबाए दियै। <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />अगर बौ कहबै पीलियौ, और मेरे ऊँटन के ताहीं पानी लान के ताहीं मान जाबै, तौ बौ बहे होए जोकै प्रभु मेरे स्वामी के लौड़ा के ताहीं बईय्यर के रूप मैं चुनो है।’ <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />जासे पहले कि मैं अपनी मन मैं प्रार्थना पूरी कर पातो, रिबका अपने कंधा मै से पानी को घल्ला लैकै आई और पानी लेन के ताहीं कुआँ मैं उतर गई। मैं बासे कहो, ‘महरबानी करकै मोकै पानी पिबाए दे।’ <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />बौ तुरन्तै अपनो घल्ला कंधा से नीचे उतारी और कही, ‘पी ले, मैं तेरे ऊँटन कै भी पानी पिबाए देंगो।’ सो मैं तौ पी लौ, और बौ ऊँटन कै भी पानी पिबाई। <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />मैं बासे पूँछो, ‘तैं कौन की लौड़िया है?’ और बौ जबाब दी, ‘मैं नाहोर और मिल्का के लौड़ा बतूएल की लौड़िया हौं।’ फिर मैं बाकी नाक मै लौंगी, और हातन मै कंगन पहनाए दौ। <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />और मैं घुपटियाए कै प्रभु की आराधना करो। मैं अपने स्वामी अब्राहम के परमेस्वर प्रभु कै धन्य कहो, जो मेरे स्वामी के लौड़ा के ताहीं बाके हितुवन की लौड़िया पान के ताहीं सच्चाई के संग मेरो मार्ग-दर्सन करी। <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />अब, अगर तुम मेरे स्वामी से प्रेम पूर्ड़ और सच्चाई को अच्छो व्यवहार करनो चाहथौ, तौ महरबानी करकै मोए बताबौ; अगर नाय, तौ कहबौ, और मैं फैसला करंगो कि का करने है।”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />लाबान और बतूएल जबाब दईं, जौ मामला प्रभु के तरफ से आओ है, तौ फैसला लेनो हमरो काम न है। <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />रिबका तुमरे सामने है। जाकै ले जाबौ। जैसो प्रभु कही है, बैसोई जौ तुमरे स्वामी के लौड़ा की बईय्यर बनै। <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />जब अब्राहम को सेवक जौ सुनी, तौ बौ जमीन मैं लोहोक्कै प्रभु की आराधना करी। <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />तौ सेवक लत्ता, सोना-चाँदी के जेवरात निकारकै रिबका कै दई। बौ बाके भईय्या और बाकी अईय्या कै भी महँगे उपहार दई।<verse eid="GEN 24:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54" />तौ अब्राहम को सेबक और बाके संग के आदमी खाईं पी, और हूँनै रात बिताईं। भोर कै जब बे उठे, तौ सेवक कहा, मोकै अपने स्वामी के झोने लौट जान देबौ।<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />लेकिन रिबका को भईय्या और बाकी अईय्या कहीं, “बाकै कम से कम दस दिन हमारे संग रहन देबौ, और फिर बौ जाए सकथै।”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />लेकिन सेवक कही, “जब प्रभु मेरीहमै मत रोको। प्रभु मेरो सफर सफल करी है; मोकै अपने स्वामी के झोने वापस जान देबौ।”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />बे जबाब दईं, “चलौ लौड़िया बात करकै पूँछथैं कि बाकै का कहने है।” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />तौ बे रिबका कैबुलाईं और पूँछी, “का तुम जौ आदमी के संग जानो चाहथै?”</para>
  <para style="p" vid="GEN 24:58">“हाँ,” बौ जबाब मैं दई।<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />तौ बे रिबका और बाके परिवार के पुराने सेवकन कै और अब्राहम के सेवकन कै बाके साथियन के संग जान दई। <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />और बे रिबका कै जे सब्दन मैं आसीस दई:</para>
  <para style="q1" vid="GEN 24:60">“हे हमरी बहेनिया, तैं हजारौ-लाखौं लौड़ा-लौड़िया की अईय्या बनै!</para>
  <para style="q1" vid="GEN 24:60">तेरे वंसज अपने बैरिन के सहरन मैं जीत हांसिल करैं!”<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />तौ रिबका और बाकी संगन तैयार ही गईं, और अब्राहम के दास के संग चलन कै तैयार ऊँटन के ऊपर चढ़ गईं, और बे सब निकर पड़े। <verse eid="GEN 24:61" /><verse number="62" style="v" sid="GEN 24:62" />इसहाक नेगेब कनान के तरिहाँए के छेत्र मैं रहत रहै। बौ लहई-रोई नाओं के कुआँ मतलब “जिन्दो कुआँ जो मोए देखथै” के निर्जन प्रदेस मैं आओ। <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />इसहाक संजाखिन के समय खेत मैं टहलन के ताहीं निकरो और बौ ऊँटन कै आत देखी। <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />जब रिबका इसहाक कै देखी, तौ बौ अपने ऊँट से उतर गई <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />और अब्राहम के सेवक से पूँछी, “जौ आदमी कौन है जो मैदान मैं हमरे घाँईं आए रहो है?” सेवक जबाब देथै “बौ मेरो स्वामी है।” तभई बौ अपनो अरघना लई और अपनो चैहरा ढ़ोंक लई।<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />सेवक इसहाक कै बौ सब कुछ बताई जो बौ करी रहै। <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />इसहाक सारा कै अपनी अईय्या के तम्बू मैं लै गौ। बौ रिबका कै अपनाई, और बौ बाकी बईय्यर बन गई। इसहाक रिबका से प्रेम करी। ऐसे करकै इसहाक कै अपनी अईय्या की मौत के बाद तसल्ली मिली।<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">अब्राहम के और भी वंस</para>
  <para style="r">(<ref loc="1CH 1:32">1 इतिहास 1:32</ref>,<ref loc="1CH 1:33">33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />अब्राहम दुसरी बईय्यर से बिहा करी, जोको नाओं कतूरा रहै। <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />और बासे जिम्रान, योछान, मेदान, मिद्यान, यिसबक, और सूआ पैदा भै। <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />योछान सेबा और ददान को दऊवा रहै, और ददान के वंस असूरीम, लेतुसिम और लुम्मी रहै। <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />मिद्यान को लौड़ा एपा, एपेर, हनोक, अबीदा और एल्दा भै। जे सब कतूरा के वंस के रहैं।<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />अब्राहम अपनो सब कुछ इसहाक कै सौंप दई; <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />लेकिन जब तक अब्राहम जिंदो रहो, तब तक बौ अपनी दुसरी उपबईय्यर से पैदा भै लौड़न कै भेंट दई। बौ जे बालकन कै अपने लौड़ा इसहाक से दूर अगार दिसा के इलाका मैं भेज दई।<verse eid="GEN 25:6" /></para>
  <para style="s">अब्राहम की मौत और दफन</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />जब अब्राहम की कुल आयु एक सौ पिचत्तर साल भई। <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />तौ अब्राहम आखरी सांस लई, बौ बुढ़डो और लम्बी उमर को रहै। बाको अच्छी पकी उमर मैं मौत भई और बौ अपने पूर्वजन मैं जाएकै मिल गौ। <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />बाको लौड़ा इसहाक और इस्माएल बाकै ममरे के अगार दिसा मैं मकपेला गुफा मैं, जो हित्ती सोहर के लौड़ा एप्रोन को खेत रहै, मट्टी दई। <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />जौ बौ खेत रहै जोकै अब्राहम हित्तिन से मोल लई रहै; अब्राहम और बाकी बईय्यर सारा दोनों कै हूँनै दफन करो गौ। <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />परमेस्वर अब्राहम की मौत के बाद, बाके लौड़ा इसहाक कै आसीस दई, इसहाक वीर लहई-रोई नाओं मतलब “कुआँ जो जीवित प्रभु मोए देखथै” बहे के झोने रहत रहै।<verse eid="GEN 25:11" /></para>
  <para style="s">इस्माएल के वंस <char style="xt" closed="false"><ref loc="1CH 1:28-31">1 इतिहास 1:28-31</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />अब्राहम के लौड़ा इस्माएल की वंसावली, जोको सारा की मिस्री दासी हाजिरा अब्राहम से जनम दई रहै, <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />इस्माएल के लौड़न के नाओं, उनके जनम के क्रम के हिसाब से ऐसे करकै हैं, इस्माएल को जेठो लौड़ा नबायोत रहै। बाके बाद: केदार, अदबएल, मिबसाम, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />मस्सा, दूमा, मस्सा, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />हदद, तेमा, यतूर, नापीस और केदमा। <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />जेईं इस्माएल के लौड़ा रहैं। इनके नाओं के हिसाब से इनके गांवों और पहाड़न कै नाओं भी रखे गै। और जेईं बाहरै अपने-अपने जनजातियन के सासक बने। <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />जब इस्माएल की कुल उमर एक सौ सैंतीस साल भई, तौ बौ आखरी सांस लई, और अपनी ज्यान छोड़ दई। बौ अपने मरे भै पूर्वजन मैं जाएकै मिल गौ। <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />बाके बंसज हवीला से सूर ले, जो मिस्र देस के अगार मैं और अस्सूर के रास्ता मै है, रहत रहैं। हर एक अपने भाई-बंधु के खिलाप बसो भौ रहै।<verse eid="GEN 25:18" /></para>
  <para style="s">एसाव और याकूब को जनम</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />अब्राहम इसहाक कै जनम दई है, <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />जब इसहाक चालीस साल को भौ, तौ बौ पद्दन-अराम के रहन बारे अराम वंस के बतूएल की लौड़िया और लाबान की बहेनिया रिबका से बिहा करी। <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />काहैकि रिबका की कोई औलाद नाय रहै, इसहाक बाके ताहीं प्रभु से प्रार्थना करी। और प्रभु बाकी प्रार्थना सुन लई, और रिबका पेट से ही गई। <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />बाके जुड़वा बच्चा होन बारे रहैं और बच्चा पैदा होन से पहले, बे बाके गर्भ मैं एक-दूसरे से मार-पिटाई करत रहैं। रिबका कहीं, “अगर ऐसिये होत रहो तौ मैं काहे जीमौं?” जौ बजह से बौ प्रभु से जबाब माँगन गई।<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />प्रभु बासे कही,</para>
  <para style="q1" vid="GEN 25:23">तेरे कोक मैं दुई जाति हैं;</para>
  <para style="q1" vid="GEN 25:23">तोसे जनम लेत खिना कि दुई जाति अगल हुई जांगी;</para>
  <para style="q1" vid="GEN 25:23">एक रास्ट्र दुसरे रास्ट्र से ताकतवर होगो,</para>
  <para style="q1" vid="GEN 25:23">बड़ो, छोटे की सेवा करैगो।<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />जब बाको जनम देन को समय आए गौ, तौ बाके जुड़वा लौड़ा भै। <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />पहले को रंग लाल रहै, और बाकी खाल रुआदार कम्मर की तराहनी की रहै, जौ बजह से बाको नाओं एसाव रखो गौ। <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />बाके तुरंत बाद बाको भईय्या कोक से बाहर आओ। बौ अपने हात मैं एसाव की एड़ी कसकै पकड़े रहै, जौ बजह से बाको नाओं याकूब रखो गौ।<note caller="+" style="f"><char style="fr" closed="false">25:26 </char></note> जब रिबका उनकै जनम दई, तौ इसहाक की उमर साठ साल रहै।<verse eid="GEN 25:26" /></para>
  <para style="s">एसाव सबसे बड़े लौड़ा होन के अधिकार कै बेंची</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />जब दोनो लौड़ा बड़े ही गै, तौ एसाव जंगल मैं रहन बारो एक अच्छो सिकारी बनो, लेकिन याकूब एक सांत आदमी रहै जो घर मै ही रहत रहै। <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />इसहाक एसाव कै प्यार करत रहै, काहैकि बौ एसाव के मारे गै सिकार को मास खात रहै, लेकिन रिबका छोटे लौड़ा याकूब कै प्यार करत रहै।<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />एक दिन जब याकूब दार पकात रहै, तौ एसाव जंगल से आओ। बौ भूंको रहै। <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />और एसाव याकूब से कही, मैं भूंको मर रौ हौं; जो तू बनाओ है मोए बौ लाल चीज मैं से कुछ दे। जौ बजह से बाको नाओं एदोम कहो गौ।<note caller="+" style="f"><char style="fr" closed="false">25:30 </char></note><verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />याकूब जबाब देथै, “अगर तैं मोकै पहलोठे लौड़ा के तराहनी अपनो अधिकार देगो तौ मैं जाकै तोए दै दुंगो।”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />एसाव कही, “देख! मैं मरनबारो हौं; जौ अधिकार को मेरे ताहीं का फायदा?” <verse eid="GEN 25:32" /><verse number="33" style="v" sid="GEN 25:33" />याकूब बाकै जबाब दई, “पहले मोसे कसम खा। और एसाव कसम खाई, और बाकै अपने जेठो होन को अधिकार बेंच दई।” <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />तौ याकूब बाकै कुछ रोटी और कुछ मसूर की दार दई। बौ फिर खाई-पी और फिर उठकै चले गौ। ऐसे करकै एसाव अपने बड़े लौड़ा होन के अधिकार कै तुच्छ समझी।<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">इसहाक गरार मैं रहथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />अब्राहम के समय अकाल के अलावा देस मैं एक और अलग अकाल पड़ो। इसहाक गरार मैं पलिस्तियन को राजा अबीमेलेक के झोने गौ। <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />प्रभु इसहाक कै दर्सन दैकै कही, “मिस्र मैं मत जइये; जौ देस मैं रहा, जहाँ मैं तोसे रहन कै कहमौं, बहे देस मैं तू रहिये। <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />हीनै रहिये, और मैं तेरे संग रहेंगो और तोए आसीस दुंगो। मैं जौ पूरो प्रदेस तोकै और तेरे वंस कै देथौं। मैं तेरे पिता अब्राहम से करो भौ वादा निभांगो।<note caller="+" style="f"><char style="fr" closed="false">26:3 </char><char style="ft" closed="false">उत्पत्ति 22.16-18 </char></note> <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />मैं तेरे वंस कै आसमान के तारन के तराहनी असंख्य बनांगो, और उन्हैं जे सब देस दुंगो। पृथ्वी के सब रास्ट्र तेरे वंस के जरिये मोसे आसीस पांगे। <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />काहैकि अब्राहम मेरी बात सुनी और बौ मेरी आग्यन, मेरी विधियन और व्यवस्था को पालन करी।”<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />तौ इसहाक गरार नगर मैं रहन लगो। <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />जब बौ जघा के लोग बाकी बईय्यर रिबका के बारे मैं बासे पूँछी तौ बौ कही, जौ मेरी बहेनिया है। इसहाक मेरी बईय्यर कहन से डरात रहै। बौ सोचत रहै: ऐसो ना होबै कि रिबका के बजह से जौ जघा के लोग मोकै मार डारैं, काहैकि रिबका देखन मैं बड़ा सुगड़ रहै।<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="ft" closed="false">उत्पत्ति 12.13 </char><char style="fp" closed="false">उत्पत्ति 20.2</char></note> <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />जब इसहाक कै हूँना कुछ समय हुई गौ, तौ एक दिन पलिस्तियन को राजा अबीमेलेक खिड़की से झाँक कै देखी, कि इसहाक और रिबका दोनों प्यार कर रै हैं। <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />अबीमेलेक इसहाक कै बुलबाई और बासे कहथै, “सचमुच बौ तेरी बईय्यर है! तू ऐसे काहे बताओ कि बौ तेरी बहेनिया रहै?” बौ जबाब दई, “मोकै लगो कि अगर मैं कहंगो कि बौ मेरी बईय्यर है तौ जौ बजह से मोकै मार दौ जागो।”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />अबीमेलेक कही, “तैं हमरे संग जौ का करो? हम लोगन मैं से कोई भी आदमी तेरी बईय्यर के संग कूकर्म कर सकत रहै और तैं हमरे ऊपर दोस मढ़तो।” <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />अबीमेलेक सब लोगन कै आग्या दई: “जो कोई जौ आदमी और बाकी बईय्यर के संग बुरो बर्ताव करैगो, बाकै मार दौ जाएगो।”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />इसहाक बौ देस मैं जमीन जोतकै बीज बोई, और बौ साल जित्तो बौ बोई रहै, बासे सौ गुना फसल पाई, काहैकि प्रभु बाकै आसीस दई। <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />बौ लगातार तरक्की मैं बढ़त गौ और भौत सेठ आदमी बन गौ। <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />काहैकि बाके झोने भेंड़-बकरिया और जानवरन के भौत से झुंग और निरे नौकर-चाकर रहैं, तौ पलिस्तियन कै बासे जलन होन लगी। <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />तौ बे हूँना के सब कुआँ कै पलिस्ती मट्टी से पाट दईं जो बाके पिता अब्राहम के सेवक अब्राहम के जिन्दे रहते खोदी रहैं।<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />तौ अबीमेलेक इसहाक से कही, “हमरे देस से निकर जा। तैं हमसे भी जाधे ताकतवर ही गौ है।” <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />तौ इसहाक हूँना से चले जाथै और गरार की घाटी मैं अपनो डेरा डारथै, जहाँ बौ कुछ समय ले रहथै। <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />फिर बौ बे कुआँ कै एक बार फिर से खोदथै जो अब्राहम के समय मैं खोदे गै रहैं, और जिन्हैं पलिस्ती के लोग अब्राहम की मौत के बाद बंद कर दईं रहैं। इसहाक बे सब कुआँ कै बहे नाओं देथै जो बाके पिता उन्हैं दई रहै।<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />इसहाक के सेवक घाटी मैं एक कुआँ खोदीं और हूँना उन्हैं एक पानी को सोता मिलो। <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />तौ गरार के बरदिया इसहाक के बरदियन से लड़ाई करन लगे, और बे कह लगे, जौ पानी हमरो है। जौ बजह से इसहाक बौ कुआँ को नाओं “एसक” रख दई। काहैकि बे इसहाक से लड़ाई करी रहैं।<verse eid="GEN 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21" />इसहाक के सेवक एक और कुआँ खोदीं, और बाके ऊपर भी लड़ाई भई, जौ बजह से इसहाक बाको नाओं “सिटना” रखी। मतलब दुस्मन। <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />फिर बौ हूँना से चले गौ और दुसरो कुआँ खुदबाई। जाके ऊपर कोई लड़ाई ना भई और जौ बजह से बौ बाको नाओं “रहोबोत” रख दई। फिर बौ कही, “अब प्रभु हमैं खुली जघा दई है, और हम जहे जमीन मैं फूलंगे-फलंगे।”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />इसहाक हूँना से बेर्सेबा कै चले गौ। <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />प्रभु बहे रात बाकै दर्सन दैकै कही, मैं तेरे पिता अब्राहम को परमेस्वर हौं। मत डराबै, काहैकि मैं तेरे संग हौं। मैं तोकै आसीस दुंगो, और अपने सेवक अब्राहम के बजह से तेरे वंस की असंख्य बढ़ांगो। <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />इसहाक हूँना एक वेदी बनाई और प्रभु की आराधना करी। तौ बौ हूँनै अपनो डेरा खड़ो करी, और बाके सेवक हूनौं एक कुआँ खोदीं।<verse eid="GEN 26:25" /></para>
  <para style="s">इसहाक और अबीमेलेक के बीच समझौता</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />अबीमेलेक अपने सलाहकार अहुज्जत और अपने सेनापति पीकोल के संग इसहाक से मिलन के ताहीं गरार नगर से आओ। <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />इसहाक उनसे कही, “तुम लोग मेरे झोने काहे आए हौ? तैं तौ मोकै अपनो दुस्मन मानथै। तैं तौ मोकै अपने देस से निकार दौ रहै।”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />बे जबाब दईं, “अब हम जान गै हैं, कि प्रभु तुमरे संग है, और हम सोचथैं कि हमरे बीच एक वाचा होनी चाहिए। हम चाहथैं कि तैं एक वचन दे <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />कि जैसे हम तोकै कोई नुकसान नाय पहोंचाए, बैसिये तैं भी हमैं कोई नुकसान नाय पहोंचागो। हम तुमरे ताहीं दयालु रहैं और तुमकै सांति से जान दै। अब जौ साफ ही गौ है, कि प्रभु तुम्हैं आसीस दई है।” <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />तौ इसहाक उनके ताहीं खास भोज को परबंध करी, और बे फिर खाईं-पीं। <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />बे सुबेरे उठे, बे आपस मैं वादा करीं, जाके बाद इसहाक उनकै बिदा करी। बे उनके झोने से सांति से चले गै।<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />बहे दिन इसहाक के सेवक आथैं, और बे बौ कुआँ के बारे मैं बताथैं, जो बे पहले खोदी रहैं। बे कहथैं, “हमैं पानी मिल गौ है।” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />तौ इसहाक बौ कुआँ को नाओं “सिबा” रखीं, मतलब वादा। इसलै बौ सहर को नाओं बेर्सेबा पड़ गौ।<verse eid="GEN 26:33" /></para>
  <para style="s">एसाव की परदेसी बईंय्यरैं</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />जब एसाव चालीस साल को भौ, तौ बौ दुई हित्ती जाति की बईंय्यरन से, मतलब बेरी की लौड़िया यहूदीत, और एलोन की लौड़िया बसमत से बिहा करी। <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />दोनों बहुअन की बजह से इसहाक और रिबका के मन कै ठेस लगी।<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">इसहाक याकूब कै आसीर्वाद दई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />इसहाक अब बूढ़ो ही गौ रहै, और बाकी आँखी इतनी धुंधरी हुई गई रहैं कि बौ देख नाय सकत रहै, तौ बौ अपने बड़े लौड़ा एसाव कै बुलाई और बासे कही, “मेरे लौड़ा एसाव!” बौ जबाब दई “हाँ मैं इतै हौं।”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />इसहाक कही, “तैं देखरौ है, कि मैं बुढ्ढो ही गौ हौं, और जल्दिये मर सकथौं।” <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />अपनो धनुस-तीर और हथियार लैकै जंगल कै जा, हुँआँ से तैं मेरे ताहीं जानवर मार कै ला। <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />जो स्वादिस्ट खानू मोए पसंद है, बामै से कुछ पकाए कै मेरे झोने लै आ। जाकै खान के बाद, मेरे मरन से पहले मैं तोकै आसीर्वाद दुंगो।<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />जब इसहाक एसाव से बात करत रहै, तौ रिबका सुनत रहै। जब एसाव सिकार करन कै जंगल मैं निकरो, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />रिबका अपने लौड़ा याकूब से कही, मैं तेरे दऊवा कै एसाव से जौ कहत सुनो हौं, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />मेरे ताहीं एक जानवर मारकै ला और बाकै मेरे ताहीं स्वादिस्ट खानु पका। जाकै खान के बाद, मैं मरन से पहले प्रभु की हजूरी मैं तोकै आसीर्वाद दुंगो। <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />रिबका कहथै, “मेरे लौड़ा” अब मेरी बात सुन और जो मैं कहमौं बहे कर। <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />तैं बकरियन के बीच मैं से दुई मोटे-मोटे अच्छे बच्चा लैआ, मैं उनसे तेरे दऊवा के ताहीं बाकी पसंद के हिसाब से स्वादिस्ट खानु पकांगो। <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />तौ तैं जाकै खान के ताहीं अपने दऊवा के झोने लै जईये, और बौ जाकै खाएकै मरन से पहले तोकै अपनो आसीर्वाद देगो।<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />लेकिन याकूब अपनी अईय्या रिबका से कहथै, “तू जानथै कि एसाव तौ बार बारो आदमी है, लेकिन मेरी खाल मुलायम है। <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />कतई मेरो दऊवा मोए छुई कै जान जागो, तौ मैं बाकी नजर मैं बाके अंधेपन को मजाक उड़ानबारो ठहरंगो, और ऐसे करकै, मैं आसीर्वाद के बजाय अपने ऊपर स्राप पांगो।”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />बाकी अईय्या जबाब दई, मेरे लौड़ा, तेरो जो भी स्राप होबै बौ मेरे ऊपर पड़ै; जैसी मैं कहथौं, बैसिये तैं कर, और जाएकै मेरे ताहीं बकरिया लै आ। <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />तौ बौ उन्हैं लेन गौ और उन्हैं अपनी अईय्या झोने लै आई, और बौ खानू बनाथै, जो बाके दऊवा के पसंद को रहै। <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />तौ रिबका जेठे लौड़ा एसाव के सब अच्छे लत्ता लई जो बौ घर मैं रखी रहै, लैकै याकूब को पहनाई। <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />बौ बकरियन के बच्चन की खाल बाकी बाँह मैं और बाकी घेंट के चिकने हिस्सा मैं लपेट दई। <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />और बौ बाकै स्वादिस्ट खानू, और अपनी पकाई भई रोटी भी अपने लौड़ा याकूब के हाथ मैं दै दई।<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />तौ याकूब अपने दऊवा के झोने गौ और कही, “दऊवा!” बौ जबाब दई, “हाँ, तैं मेरो कौन सो लौड़ा है?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />याकूब जबाब दई, “मैं तेरो बड़ो लौड़ा एसाव हौं; जैसे तैं मोसे कहो रहै, मैं बैसिये ही करो हौं। तैं बैठ और जो माँस मैं तेरे ताहीं लाओ हौं, बामै से कुछ खा, ताकि तू मोकै आसीस देबै।”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />इसहाक अपने लौड़ा से कही, “मेरे लौड़ा, तोए जौ इत्ती जल्दी कैसे मिलगौ?” याकूब जबाब दई, “तेरो परमेस्वर प्रभु जाकै ढूँड़न मैं मेरी मदद करी।”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />इसहाक याकूब से कही, “जरा मेरे झोने तौ आ ताकि मैं तोए टपटोर सकौं। का तैं सचमुच मैं एसावै है?” <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />याकूब अपने दऊवा इसहाक के झोने आथै, और बौ बाकै महसूस करकै कही, “तेरी आबाज याकूब की आबाज जैसिये लगथै, लेकिन तेरे हात एसाव की हाथ के जैसी लगथैं।” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />बौ याकूब कै नाय पहचान पाथै, काहैकि बाके बाँह एसाव के तराहानी बार बारे रहैं। बौ बाकै अपनो आसीर्वाद देनबारोई रहै, <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />फिर पूँछथै, “का तू सचमुच एसाव है?”</para>
  <para style="p" vid="GEN 27:24">बौ जबाब देथै, “हाँ, मैं हौं।”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />इसहाक कही, तौ मेरे ताहीं खानु परस ला। मैं अपने लौड़ा के खानु कै खांगो, जोसे मैं अपनी आत्मा से तोकै आसीर्वाद दुंगो। बौ खानु परसी। इसहाक खानु खाई। बौ बाके ताहीं अंगूर को रस भी लाई, और बौ बाकै पी। <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />तौ बाको दऊवा इसहाक से कही, “मेरे लौड़ा, झोने आएकै मोए चूम।” <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" /><note caller="+" style="f"><char style="fr" closed="false">27:27 </char><char style="ft" closed="false">हिब्रू 11:20</char></note>जैसिये बौ बाकै चूमन के ताहीं अग्गु आओ, इसहाक बाके लत्तन कै सूँघी - तौ बौ बाकै आसीर्वाद दई। बौ कही, “मेरे लौड़ा की सुखद गंध बौ खेत की गंध के तराहनी है जोकै परमेस्वर आसीर्वाद दई है। <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />परमेस्वर तोए स्वर्ग से ओस देबै और तेरे खेत कै खूब उपजाऊ बनाबै! बौ तोकै खूबै अन्न और अंगूर की फसल देबै! <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />जाति-जाति के लोग तेरे दास बनै, और देस-देस के लोग तेरे अग्गु झुकैं। तू अपने सब भईय्यन को स्वामी बनै, और तेरी अईय्या के वंस तेरे अग्गु झुकैं। जो तोकै स्राप देमैं बे स्रापित होमैं, और जो तोकै आसीर्वाद देथैं, बे आसीस पामैं।”<verse eid="GEN 27:29" /></para>
  <para style="s">एसाव इसहाक से आसीर्वाद माँगथै</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />इसहाक याकूब कै आसीर्वाद दै चुको, और जैसिये याकूब चले जाथै, बाको भईय्या एसाव सिकार से भीतर आए जाथै। <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />बौ कुछ स्वादिस्ट खानू बनाई और अपने दऊवा के झोने लै जाथै। बौ कही, “दऊवा, उठकै बैठ और जो मास मैं तेरे ताहीं लाओ हौं, बामै से कुछ खा, ताकि तैं मोए आसीर्वाद दै सकै।”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />बाको दऊवा इसहाक बासे पूँछी, “तैं कौन है?”</para>
  <para style="p" vid="GEN 27:32">एसाव जबाब दई, “मैं तेरो लौड़ा, तेरो बड़ो लौड़ा एसाव हौं।”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />इसहाक काँपत भै और थरथरात भै बासे पूँछी, “तौ बौ कौन रहै, जो मेरे झोने सिकार लाई रहै? मैं तेरे आन से पहले बाको परसो भौ खानु खाओ, और बाकै आसीर्वाद दौ, अब बहे आसिर्वाद बाके ऊपर बनो रहगो।”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />जब एसाव जौ सुनी, तौ बौ ऊँची अबाज से और बड़ा दुखी हीकै चिल्लाएकै कही, “दऊवा, महूँ कै भी अपनो आसीर्वाद दे!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />इसहाक जबाब दई, “तेरो भईय्या आएकै मोए धोखा दई। बौ तेरो आसीर्वाद छीन लई है।”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />एसाव कही, “बाको नाओं याकूब ठीकै रखो गौ रहै। बौ दुई बार मोकै धोखा दई है। पहले तौ मेरो जेठो लौड़ा हो को अधिकार लै लई, और अब मेरो आसीर्वाद भी छीन लई। एसाव पूँछी, का तैं मेरे ताहीं कोई आसीर्वाद नाय बचाएकै रखो है?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />इसहाक एसाव कै जबाब दई, “मैं बाकै तेरो स्वामी बनाओ हौं। मैं बाके सब भईय्यन कै बाको सेवक बनन के ताहीं दै दौ हौं। मैं अनाज और अंगूर से बाकै सम्पन्न बनाए दौ हौ। अब मेरे लौड़ा, मैं तेरे ताहीं का कर सकथौं?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />एसाव अपने दऊवा से विनती करत रहो: “मेरे दऊवा, का तेरे झोने सिरफ एकै आसीर्वाद है? मोकै भी आसीर्वाद दे!” बौ फूट-फूट कै रोन लागो।<note caller="+" style="f"><char style="fr" closed="false">27:38 </char><char style="ft" closed="false">हिब्रू 12:17</char></note><verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />तौ इसहाक बासे कही,</para>
  <para style="q1" vid="GEN 27:39">“तेरे ताहीं स्वर्ग से ओस नाय है,</para>
  <para style="q1" vid="GEN 27:39">तेरे ताहीं उपजाऊ खेत नाय है,<note caller="+" style="f"><char style="fr" closed="false">27:39 </char><char style="ft" closed="false">हिब्रू 11:20</char></note><verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />तैं अपनी तलवार के बल से जिंदो रहेगो,</para>
  <para style="q1" vid="GEN 27:40">लेकिन अपने भईय्या को दास बनो रहेगो।</para>
  <para style="q1" vid="GEN 27:40">फिर भी जब तू खिलाफत करथै,</para>
  <para style="q1" vid="GEN 27:40">तौ तैं बाके काबू से दूर ही जागो।”<note caller="+" style="f"><char style="fr" closed="false">27:40 </char><char style="ft" closed="false">उत्पत्ति 36:8; 2 राजा 8:20</char></note><verse eid="GEN 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />एसाव अपने भईय्या से बाके दऊवा के दै भै आसीर्वाद के बजह से बैर रखन लगो। बौ सोची, “मेरे दऊवा की मौत मैं सोक मनान को समय झोने आए गौ है; फिर मैं अपने भईय्या याकूब कै मार डारंगो।”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />लेकिन जब रिबका कै बाके बड़े लौड़ा एसाव की जे बात बताई गई, “तौ बौ सेवक कै भेजकै अपने छोटे लौड़ा याकूब कै बुलाई। रिबका बासे कही, देख, तेरो भईय्या एसाव तोकै मार डारन की योजना बनाए रौ है। <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />अब मेरे लौड़ा, मेरी बात सुन। तैं मेरे भईय्या, लाबान के झोने हारान नगर मैं चलो जा। <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />और कुछ दिन बाके झोने रहा, जब तक तेरे भईय्या को गुस्सा सांत ना ही जाबै <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />और बौ भूल जाबै कि तू बाके संग का करो है। तौ मैं तोकै वापस लान के ताहीं कोई कै भेजंगो। मोए अपने दोनों लौड़ा कै एकै दिन मैं काहे खोने है?”<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />तौ रिबका इसहाक से कही, “हित्ती जाति की बहुअन के बजह से जिंदगी से ऊब गौ हौं। अगर याकूब भी जे बहुअन के हानी जौ देस की कोई हित्ती जाति की लौड़िया से बिहा कर लेगो तौ मोकै अपनी जिंदगी से का फायदा? मैं मर जांगो।”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="s">याकूब कै लाबान के झोने भेजो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />तौ इसहाक याकूब कै बुलाए कै आसीर्वाद दई, और आग्या दई, “तू कोई कनानी लौड़िया के संग बिहा मत करिये। <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />उठ, और पद्दन-अराम के इलाका मैं अपने नना बतूएल के घरै जा। हुँआँ अपने मुमा लाबान की लौड़ियन मैं से कोई एक के संग बिहा करिये। <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />सर्वसक्तिमान परमेस्वर तोए आसीस देबै, तोए इतनो फलवन्त और असंख्य बनाबै कि तैं तमान रास्ट्रन को एक समुदाय बन जाबै। <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />बौ तोकै और तेरे संग तेरे वंसज कै अब्राहम की आसीस देबै, जोसे तैं अपने रहन बारे बौ देस के ऊपर अधिकार करै, जोकै परमेस्वर अब्राहम कै दई रहै।”<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="ft" closed="false">उत्प 17:4,8 </char></note> <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />तौ इसहाक याकूब कै बिदा करी, और बौ पद्दन-अराम के इलाका मैं लाबना के झोने चले गौ। लाबान अराम वंस को बतूएल को लौड़ा रहै। बौ याकूब और एसाव की अईय्या रिबका को भईय्या रहै।<verse eid="GEN 28:5" /></para>
  <para style="s">एसाव को एक और बिहा</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />तौ एसाव कै पता चलो की इसहाक याकूब कै आसीर्वाद दैकै पद्दन-अराम भेज दई, कि बौ उतई की लौड़िया से बिहा करै, और बाकै आसीर्वाद देन के समय जौ आग्या भी दई, “कि तू कोई कनानी लौड़िया कै बिहाए कै मत लईये,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />और याकूब अईय्या- दऊवा की मानकै पद्दन-अराम के इलाका कै चल दई। <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />तौ एसाव जौ सब देखकै समझी कि कनानी लौड़ियाँ मेरे दऊवा इसहाक कै बुरी लगथैं, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />तौ एसाव अब्राहम के लौड़ा इस्माएल के झोने गौ, बौ अपनी दुसरी बईय्यर के होत भई भी इस्माएल की लौड़िया और नबायोत की बहेनिया महलत से बिहा कर लई।<verse eid="GEN 28:9" /></para>
  <para style="s">बेतेल मैं याकूब को सपनो</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />याकूब बेर्सेबा से निकर कै हारान नगर के घाँईं चले गौ। <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />और बौ कोई जघा मैं पहोंच कै रात हूँनै बिताई, काहैकि सूरज मुंद गौ रहै; तौ बौ बौ जघा के पत्थरन मैं से एक पत्थर लैकै अपनी तकिया बनाए कै रखी, और बहे जघा मैं सोएगौ। <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />फिर बौ सपने मै का देखी, कि एक सीढ़ी धरती मैं खड़ी है, और बाको सिरा स्वर्ग तक पहुँचो है; और परमेस्वर के स्वर्गदूत बामैं चढ़त-उतरत हैं। <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />यहोवा बाके झोने ठाड़कै कहथै, “मैं यहोवा, तेरो दादो अब्राहम को परमेस्वर, और इसहाक को भी परमेस्वर हौं” जो धरती मैं तू लेटो है, बौ मैं तोकै और तेरे वंस कै दुंगो।<note caller="+" style="f"><char style="fr" closed="false">28:13 </char><char style="ft" closed="false">उत्प 13:14,15</char></note> <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />और तेरे वंस धरती के धूधर के तिनका के हानी अनगिनत होंगे, और पछार, अगार, सीरे, तरहाँए, चारौ घाँईं फैलत जागो; और तेरे और तेरे वंस के जैसी धरती के सब गाँओं आसीस पांगे। <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />और सुन, मैं तेरे संग रहांगो, और जहाँ कहूँ तू जागो उतै तेरी रक्छा करंगो, और तोकै जौ देस मैं लौटाए लामंगो; जो बात मैं तोसे कहो हौं, जबले उनकै पूरो ना कर लेंगो तौले तोकै ना छोड़ंगो।<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">यसा 41:10</char></note> <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />फिर याकूब जग उठो, और कहन लगो, “सच्ची जौ जघा मैं प्रभु है; और मैं जौ बात कै नाय जानत रहौं।” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />और डराए कै बौ बोली, “जौ जघा का भयानक है! जौ तौ परमेस्वर के भवन कै छोड़ और कुछ नाय ही सकथै; फिर जौ स्वर्ग को फाटक होगो।”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />याकूब सुबेरे उठो, और अपनी तकिया को पत्थर लैकै बाको खम्मा खड़ो करी, और बाके ऊपर के सिरा मै तेल डार दई। <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />और बौ बहै जघा को नाओं बेतेल रखी; पर बौ जघा को नाओं पहले लूज रहै। <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />याकूब जौ मन्नत माँगी, “अगर परमेस्वर मेरे संग रहकै जौ यात्रा मै मेरी रक्छा करै, और मोकै खान के ताहीं रोटी, और पहनन के ताहीं लत्ता देबै, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />और मैं अपने दऊवा के घरै अच्छे से लौट आमौं; तौ प्रभु मेरो परमेस्वर ठहरैगो। <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />और जौ पत्थर, जोको मैं खम्मा खड़ो करो हौं, परमेस्वर को भवन ठहरैगो: और जो कछु तू मोकै देगो बाको दसमांस मै जरुरै तोकै दे करंगो।”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">याकूब लाबान के घर पहोंचो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />याकूब अपने रास्ता मैं चलतै रहो और अगार देस के लोगन के घाँईं चले गौ। <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />अचानक बाकी निगाह मैदान मैं एक कुआँ मैं पड़ी, जोके चारौ घाँईं भेड़न को तीन झुंग लेटे पड़े रहैं। जौ कुआँ से भेड़-बकरियन कै पानी पिबाओ जात रहै, कुआँ के मोहों मैं एक बड़ो पथरा रखो रहत रहै। <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />जब सबै भेंड़-बकरियन को झुंग हूँना जुरत रहैं, तौ बरदिया मिलकै पथरा कै पच्छू के घाँईं घुमात रहैं, और उन्हैं पानी पिबात रहैं। फिर बे पथरा कै बापस बाकी जघा मैं रख देत रहैं।<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />याकूब बरदियन से पूँछी, “मेरे दोस्तौ, तुम कहाँ से हौ?”</para>
  <para style="p" vid="GEN 29:4">बे जबाब दईं, “हारान नगर से।”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />बौ फिर पूँछी, “का तुम नाहोर के पोता लाबान कै जानथौ?”</para>
  <para style="p" vid="GEN 29:5">बे बाकै जबाब दईं, “हाँ, हम जानथैं।”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />फिर बौ उनसे पूँछी, “का बौ ठीक है?” बे जबाब दईं, “बौ ठीक है,”</para>
  <para style="p" vid="GEN 29:6">“देखौ, बाकी लौड़िया राहेल भेंड़-बकरियन के झुंग के संग आए रई है।”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />याकूब कहथै, “अभै तौ दिन बीतन मैं बड़ा समय बचो है। जौ जानवरन कै एकट्ठो करो जान को समय ना है। भेड़-बकरियन कै पानी पबाबौ और जाबौ, उन्हैं फिर से चुगाबौ।”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />बे जबाब दईं, “हम ऐसो तौले नाय कर सकथैं जबले कि सब भेड़-बकरिया हिंयाँ आए ना जामैं, जब सब झुंग जुराथै, तौ पथरा कुआँ के मोहों से लुढ़काओ जाथै, और तौ हम भेड़-बकरियन कै पानी पिबाथैं।”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />जब याकूब उनसे बात करतै रहै, तभई राहेल अपने दऊवा की भेड़-बकरियन के संग आए पहोंची, बौ भेड़-बकरिया चुगाए करत रहै। <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />जब याकूब राहेल कै, अपने चाचा लाबान की भेड़-बकरियन के संग देखी, तौ बौ कुआँ के झोने गौ, बौ बाके मोहों मैं रखे पथरा कै ढुरकाए दई और अपने मामा लाबान की भेंड़न कै पानी पिबाई। <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />फिर याकूब राहेल कै चूम्मी लई और बौ फूट-फूट कै रोन लगो। <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />याकूब राहेल से कही, “मैं तेरे दऊवा को हितुआ, और रिबका को लौड़ा हौं।” और बौ अपने दऊवा कै बतान ताहीं के दौड़ी; <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />और जब बौ अपने भतीजे याकूब की खबर सुनी, तौ बासे भेंटा करन के ताहीं दौड़ पड़ो, और बाकै गले लगाएकै चूमी, और बाकै अपने घरै लै आई। और याकूब लाबान कै सब कुछ बताए दई, <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />लाबान कही, “हाँ, सचमुच, तू मेरो ही माँस और खून है।” और याकूब पूरे एक महेना ले हुँआँ ठहरो।<verse eid="GEN 29:14" /></para>
  <para style="s">याकूब राहेल और लिआ के ताहीं लाबान की सेवा करथै</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />लाबान याकूब से कही, “का तैं मेरो हितुआ होन के बजह से बिना मजदूरी लै मेरी सेवा करत रहगो? मोकै बता कि तेरी मजदूरी का है?” <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />लाबान की दुई लौड़िया रहैं; बड़ी को नाओं लिआ और छोटी को राहेल रहै। <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />लिआ की आँखी कमजोर होथैं, लेकिन राहेल कटिली और सुगड़ भी होथै।<verse eid="GEN 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18" />याकूब राहेल से प्यार करत रहै, बौ कही, “मैं तेरी छोटी लौड़िया राहेल के ताहीं सात साल ले तेरी सेवा करंगो।”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />लाबान जबाब दई, “मैं राहेल कै पराए आदमी कै देन से अच्छो है कि मैं बाकै तहीं कै सौंप देमौं। तू मेरे संग रहा।” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />याकूब राहेल कै पान के ताहीं सात साल ले काम करी, और जौ समय बाकै कुछ दिन के हानी लगो, काहैकि बौ बासे प्यार करत रहै।<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />फिर याकूब लाबान से कही, “समय पूरो ही गौ है; मोकै अपनी लौड़िया से बिहा करा।” <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />तौ लाबान बौ जघा के लोगन कै इखट्टो करकै एक बड़ो भोज तैयार करी। <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />लेकिन बौ रात, बौ राहेल के बदले लिआ कै याकूब के झोने लै गौ, और याकूब बाके संग सारीरिक संबंध रखी। <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />लाबान अपनी दासी जिल्पा कै अपनी लौड़िया लिआ की दासी होन के ताहीं दै दई। <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />अगले भोर कै याकूब कै पता चलो, कि जौ लिआ रहै। बौ लाबान के झोने गौ और कही, “तैं मेरे संग ऐसो काहे करो? मैं राहेल कै पान ताहीं इत्तो काम करो। तैं मोकै धोखा काहे दौ?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />लाबान जबाब दई, “हिंयाँ बड़ी लौड़िया से पहले छोटी लौड़िया को बिहा करन को रिवाज नाय है। <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />हप्ता के बिहा को समारोह खतम होन ले असियाएले, और अगर तैं मेरे हिंयाँ सात साल और काम करैगो तौ मैं तोकै राहेल कै दै दुंगो।”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />याकूब राजी ही जाथै, और जब बिहा को समारोह को हप्ता खतम ही जाथै, तौ लाबान बाकै अपनी लौड़िया राहेल कै बाकी बईय्यर होन ताहीं दै दई। <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />लाबान अपनी नौकरानी बिल्हा कै अपनी लौड़िया राहेल के ताहीं नौकरानी जैसी देथै। <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />तौ याकूब राहेल के झोनें भी गौ, और बाको प्यार लिआ से जाधा बहे के ऊपर भौ, और बौ लाबान के संग रहकै सात साल और बाकी सेवा करी।<verse eid="GEN 29:30" /></para>
  <para style="s">याकूब से जन्में भै बालका</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />जब प्रभु देखी कि लिआ कै राहेल से कम प्यार मिल रौ है, तौ बौ बाके बालका पैदा करनो आसान कर दई, लेकिन राहेल बाँझ रह गई। <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />लिआ पेट से ही गई, और बौ एक लौड़ा कै जनम दई। बौ कहथै, “प्रभु मेरी परेसानी कै देखी है, और अब मेरो आदमी मोसे प्यार करैगो” जौ बजह से बौ बाको नाओं रूबेन रखी। <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />बौ फिर से पेट से भई और बौ एक और लौड़ा कै जनम दई। बौ फिर कहथै, “प्रभु मोकै जौ लौड़ा और दई है, काहैकि बौ मेरे बारे मैं सुनी है कि मोसे कोई प्यार नाय करथै।” तौ बौ बाको नाओं सिमौन रखी। <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />एक बार फिर से बौ पेट से भई और बौ एक और बालका कै जनम दई। बौ फिर कहथै, “अब मेरो आदमी मोसे और जाधे मजबूती से जुड़ो रहगो, काहैकि मोसे बाके तीन लौड़ा पैदा भै हैं” जौ बजह से बौ बाको नाओं लेवी रखी। <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />फिर से बौ पेट से भई और बौ एक और लौड़ा कै जनम दई। बौ कही, “जौ बार मैं प्रभु की स्तुति करंगो।” जौ बजह से बौ बाको नाओं यहूदा रखी। और फिर बाकी कोख बालका पैदा करनो बंद कर दई।<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />जब राहेल देखी कि बाके और याकूब से कोई बालका नाय हुई रै हैं, तौ बाकै अपनी बहेनिया से जलन होन लगी। तौ बौ याकूब से कही, “मोकै औलाद दे, ना तौ मैं मर जांगो।”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />याकूब राहेल ऊपर गुस्सा भौ और कही, “का मैं परमेस्वर की जघा मैं हौं, जो तोए बालका पैदा करन से रोक दौ हौं?”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />तौ राहेल बासे कही, “हिंयाँ मेरी दासी बिल्हा है। बाके संग सो ताकी बौ मेरे ताहीं बालका पैदा कर सकै, और मैं भी बाके जरिया एक परिवार खड़ो कर सकौं।”<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />तौ बौ बाकै अपनी दासी बिल्हा कै बईय्यर होन के ताहीं दै दई। याकूब बाके संग सारीरिक संबंध रखी, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />और बिल्हा याकूब से पेट से भई और बासे एक लौड़ा पैदा भौ। <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />तौ राहेल कहथै, परमेस्वर मेरे पक्छ मैं न्याय करी है; बौ मेरी प्रार्थना सुनी और मोए एक लौड़ा दई। जौ बजह से बौ बाको नाओं दान रखी। <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />राहेल की सेविका बिल्हा फिर से पेट से भई और याकूब से बाको दूसरो लौड़ा पैदा भौ। <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />राहेल कहथै, मैं अपनी बहेनिया के संग कड़ी लड़ाई लड़ो हौं, लेकिन मैं जीत गौ हौं; जौ बजह प्रभु बाको नाओं नप्ताली रखी।<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />जब लिआ कै एहसास भौ कि बाके बालका अब ना ही सकथैं, तौ बौ अपनी दासी जिल्पा कै याकूब की बईय्यर होन ताहीं दई। <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />फिर लिआ की दासी जिल्पा भी याकूब से एक लौड़ा कै जनम दई। <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />लिआ कहथै, “मैं भाग्यवान हौं” जौ बजह से बौ बाको नाओं गाद रखी। <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />फिर लिआ की दासी जिल्पा से याकूब को एक और लौड़ा को जनम भौ, <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />और लिआ कहथै, “मैं भौत खुस हौं! अब बईय्यरैं मोकै खुसनसीब कहमंगी” जौ बजह से बौ बाको नाओं आसेर रखी।<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />गेहूँ की कटाई के दिनन मैं रूबेन खेत मैं गौ, और बाकै दूदाफल मिले, जिनकै बौ अपनी अईय्या लिआ के झोने लै जाथै। राहेल लिआ से कही, “महरबानी करकै अपने लौड़ा के दूदाफल मैं से कुछ मोए दे।”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />लिआ जबाब दई, “का जौ काफी नाय है कि तैं मेरे आदमी कै छीन लौ है? अब तैं मेरे लौड़ा के दूदाफल भी छीनन की कोसिस कर रई है।” राहेल कहथै, “अगर तैं मोकै अपने लौड़ा से दूदाफल दिबागी, तौ तैं आज रात याकूब के संग सोए सकथै।”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />संजाखिन कै जब याकूब खेत से आथै, तौ लिआ बासे भेंट करन कै निकरथै, लिआ कहथै, तोकै मेरे झोने आज रात आनेई होगो, काहैकि मैं तेरे लौड़ा के दूदाफल से तेरी कीमत भर दौ हौं। फिर बौ बहे रात बाके संग संबंध बनाई।<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />परमेस्वर लिआ की प्रार्थना सुनी, और बौ गर्भवती भई और याकूब से पाँचमें लौड़ा कै जनम दई। <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />लिआ कहथै, “मैं अपनी दासी कै अपने आदमी कै दौ, जौ बजह से परमेस्वर मोकै बाको इनाम दई है” जौ बजह से बौ अपने लौड़ा को नाओं इस्साकार रखी। <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />लिआ फिर पेट से भई और याकूब से छटमों लौड़ा पैदा भौ। <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />लिआ कहथै, “परमेस्वर मोकै एक और अच्छो इनाम दई है। अब मेरो आदमी मोकै अपनाय लेगो, काहैकि मोसे बाके छै लौड़ा पैदा भै हैं।” जौ बजह से बौ बाको नाओं जबूलून रखी। <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />बाद मैं बाकी एक लौड़िया भई, जोको नाओं बौ दीना रखी।<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />तौ परमेस्वर राहेल कै याद करी; बौ बाकी प्रार्थना को जबाब दई और बाकी कोक खोली। <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />बौ पेट से भई और बौ एक लौड़ा कै जनम दई। बौ कही, “परमेस्वर मोए एक लौड़ा दैकै मेरी निंदा दूर कर दई। <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />प्रभु मोकै एक और लौड़ा दे” जौ बजह से बौ बाको नाओं यूसुफ रखी।<verse eid="GEN 30:24" /></para>
  <para style="s">लाबान के संग याकूब को सौदा</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />जब राहेल से यूसुफ के जनम के बाद याकूब लाबान से कही, “मोकै बिदा करदे, कि मैं अपने घर अपने देस लौट जामौं। <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />मोकै मेरी बईय्यर और बालका दै दियौ, जो मैं तेरे ताहीं काम करकै कमाओ हौं, और मैं चले जांगो। तैं जानथै कि मैं तेरी कित्ती अच्छी सेवा करो हौं।”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />लाबान बासे कही, “अगर तैं मेरो कृपा करथै तौ मोकै जौ कहन दे। मोकै अनुभव से पता चलो है कि प्रभु तेरे बजह से मोए आसीस दई है। <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />अपनी मजदूरी बता, मैं बाकै चुकांगो।”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />याकूब जबाब दई, “तैं जानथै कि मैं तेरे ताहीं कैसे काम करो हौं, और तेरे जानवर तेरी भेड़-बकरिया मेरी देखरेख मै कैसे फली-फूली हैं। <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />मेरे आन से पहले तेरे पास थोड़ी सी सम्पत्ति रहै, पर अब बौ कितनी बढ़ गई! जहाँ-जहाँ मेरे पैर पड़े, प्रभु तोकै आसीस दई। पर मैं अपनी घर-गृहस्थी के ताहीं कब काम करंगो?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />लाबान बासे पूँछथै, “मैं तोकै का भुगतान करौं?” याकूब जबाब दई, “मोए कोई मजदूरी नाय चाहिए। अगर तैं जौ सुझाव से सहमत है तौ मैं तेरे झुंग की देखरेख करत रहेंगो: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />आज मोकै तेरी सब भेड़-बकरियन के बीच से जान दे, मैं हर एक चित्तीदार भेंड़ और कारे मेमना कै और भेंड़-बकरियन मैं से सब चित्तीदार बकरियन कै अलग करंगो। जहे मेरी मजदूरी है। <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />आनबारे समय मैं, तैं आसानी से पता लगाए लेगो कि मैं इमानदार हौं कि नाय। जब तैं मेरी मजदूरी देखन आगो, और अगर मेरे झोने कोई बकरिया होमैं जो धब्बेदार या चित्तीदार न होमैं, या कोई भेंड़ होमैं जो कारी न होमैं, तौ तैं जान लेगो कि बौ चोरी की हैं।”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />लाबान जबाब दई, “तेरो कहनो सई है।” तैं जैसो सुझाव देगो हम बैसिये करंगे। <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />लेकिन बौ दिन लाबान, जित्ते नर बकरा मैं लकीर या धब्बा रहैं, और जित्ती मादा बकरियन मैं धब्बा और या जिनके सरीर मैं सफेदी रहैं, सबन कै अलग कर दई; बौ सब कारी भेंड़न कै भी हटाए दई। और बौ अपने लौड़न कै उनको अधिकारी बनाई, <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />और लाबान भेंड़-बकरियन कै लैकै याकूब के झोने से तीन दिन के सफर के अंतर की दूरी करकै दूर चले गौ। याकूब लाबान की बची भेंड़-बकरियन की देखरेख करी।<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />याकूब चिनार, बादाम और अमोन के पेंड़ की हरी हंगइया लई। और कुछ की छाल उतार दई, ताकि हंगईयन मैं सेती लकीर दिखाई देमैं। <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />बौ जे हंगईयन कै भेंड़-बकरियन के अग्गु पानी पीन की जघा मै रख दई। और जब बे पानी पीन के ताहीं आईं तौ गाभन हुई गई। <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />जौ बजह से जब बकरिया हंगईया के झोने बच्चा पैदा करतीं, तौ बे लकीरबारे, कारेकबरे, और चितकबरे बच्चा पैदा करत रहैं।<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />याकूब भेंड़न कै बकरियन से अलग रखी और उनको मोहों लाबान के झुंग के चितकबरे और कारे बच्चन के घाँईं कर दई। ऐसो करकै बौ अपनो झुंग बनाई और इनकै लाबान के झुंग से अलग रखी।<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />जब हस्टपुस्ट भेड़-बकरिया गाभन होत रहैं, तौ याकूब हंगईयन कै उनके अग्गु पीन बारे नाँदन मैं रख देत रहै, ताकि बे हंगईया के बीच मैं बच्चा पैदा करैं। <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />लेकिन जब कमजोर भेड़-बकरिया गाभन होत रहैं, तौ बौ हंगईयन कै उनके अग्गु नाय रखत रहै। जल्दिये लाबान के झोने सब कमजोर-कमजोर भेड़-बकरिया ही गईं, और याकूब के झोने सब हस्टपुस्ट हुई गईं। <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />और ऐसिये करकै याकूब भौत फलवंत ही गौ। बाके भौत भेड़-बकरिया, दास, ऊँट और गधा ही गै।<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">याकूब को लाबान के झोने से भाजनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />याकूब कै सुनन मैं आओ, कि लाबान के लौड़ा कहै रै हैं कि, “याकूब हमरे दऊवा को सब कछु छीन लई है। बाकै सब रुतबा संपत्ति हमरे दऊवा की संपत्ति से मिली है।” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />याकूब जौ भी देखी कि लाबान अब पहले जैसी मिलनसार नाय रहो। <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />तौ प्रभु याकूब से कही, “अपने पुरखन और रिस्तेदारन के देस मै लौट जा। और मैं तेरे संग रहेंगो।”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />जौ बजह से याकूब राहेल और लिआ कै, बौ मैदान मै जहाँ बाकी भेड़-बकरिया रहैं, मिलन कै बुलाई। <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />उनसे कही, मै तुमरे दऊवा के मोहों कै देखकै महसूस करो हौं, कि तुमरो दऊवा मेरे ताहीं पहले जैसी मिलनसार ना रहो; पर मेरे दऊवा को परमेस्वर मेरे संग है। <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />तुम दोनो जानथौ कि मै तुमरे दऊवा के ताहीं अपनी पूरी ताकत से काम करो हौं। <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />फिर भी बौ मोकै धोखा दई और मेरी मजदूरी दस बार बदली। पर परमेस्वर बासे मोकै नुकसान नाय होन दई। <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />जब लाबान कही, “चितकबरे बालका तेरी मजदूरी ठहरंगे, तौ सब भेंड़-बकरिया के बालका चितकबरे बारे पैदा भै। जब बौ कही, धारीदार बारे बालका तेरी मजदूरी ठहरंगे, तौ सब भेड़-बकरिया के बालका धारीबारे पैदा भै।” <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />परमेस्वर तुमरे दऊवा से पालतू जानवर भेड़-बकरियन कै छीनकै मोकै दै दई।<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />“प्रजनन के मौसम मैं आँखी ऊपर उठाएकै एक सपनो देखो, और मैं देखो कि जो बकरा बकरियन के ऊपर चढ़त रहैं बे धारीदार, चितकबरे और धब्बेदार हैं। <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />परमेस्वर को स्वर्गदूत सपनो मैं मोसे बात करकै कही, ‘याकूब!’ मैं जबाब दौ ‘मैं हिंयाँ हौं।’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />बौ फिर कही, ‘देख जो नर बकरा बकरिया के ऊपर चढ़ रौ है बे सब धारीदार, चित्तीदार और धब्बेदार हैं। मैं ऐसो जहेमारे कर रौ हौं, काहैकि मैं बौ सब देखो हौं जो लाबान तेरे संग करत रहै।’ <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />मैं बौ बेतेल जघा को परमेस्वर हौं, जहाँ तैं जैतून को तेल पथरा मैं डारो रहै, और हूँना तैं मोसे मन्नत माँगो रहै। अब उठ, और अपने परिवार के संग बहे देस मैं बापस लौट जा जहाँ तैं पैदा भै रहौ।” <note caller="+" style="f"><char style="fr" closed="false">31:13 </char><char style="ft" closed="false">उत्पत्ति 28:18-22 </char></note><verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />तौ राहेल और लिआ याकूब से कहीं, “का हमरे दऊवा के घरै हमरो हिस्सा, हमारी विरासत की संपत्ति बची है? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />का दऊवा हमकै पराओ नाय समझी? हमैं बेंच दई, और हमरो धन के रूप मैं जो कछु मिलो, बाकै खुदै खाए गौ। <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />जौ सब सम्पत्ति जो परमेस्वर हमरे दऊवा से ले लई है, बौ हमरी और हमरी औलादन की है। अब जो कछु परमेस्वर तोसे कही है बहे कर।”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />तौ याकूब अपने बालका और बईंय्यरन कै ऊँट मैं बैठाई, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />बौ अपने सब जानवरन कै, अपने सब जानवरन कै जोकै बौ कमाई रहै, जो जानवर पद्दन-अराम इलाका मैं बाके पास रहैं, उनकै कनान देस मैं अपने दऊवा इसहाक के झोने लै जान के ताहीं हाँकी। <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />लाबान अपनी भेंड़न को ऊन कतरन गौ रहै, और बाकी गैरमौजूदगी के दौरान राहेल अपने दऊवा के घरेलू दुईतन कै चुराए लई। <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />ऐसे करकै याकूब चतुराई से अराम वंसिय लाबान कै धोखा दई। बौ लाबान कै ना बताई कि बौ भाजन बारो है। <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />बौ अपनो सब कुछ लै लई और जल्दी से चले गौ। बौ फरात नदिया कै पार करी और गिलाद के पहाड़ी प्रदेस के घाँईं चल पड़ो।<verse eid="GEN 31:21" /></para>
  <para style="s">लाबान याकूब को पीछा करी</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />तीन दिन बाद लाबान कै बताओ गौ कि याकूब भाजगौ है। <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />बौ अपने लोगन कै अपने संग लई और याकूब कै सात दिन तक पीछा करी, जबले कि बौ बाकै गिलाद के पहाड़ी देस मैं पकड़ नाय लई। <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />बौ रात सपने मैं परमेस्वर अराम के वंस लाबान के झोने सपने मैं आओ और बासे से कही, सतर्क रहा, याकूब कै कोई तरहन से भलो बुरो मत कहिये। <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />याकूब अपनो तम्बू एक पहाड़ मैं बनाई, और लाबान अपने हितुवन के संग गिलाद के पहाड़ी प्रदेस मैं अपनो डेरा रखी।<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />लाबान याकूब से कही, “तैं मोकै काहे धोखा दौ, और मेरी लौड़ियन कै तैं लड़ाई मैं पकड़ी भई बईय्यरैं समझकै लै गौ? <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />तैं मोकै धोखा काहे दौ और बिना बताये चले गौ? तैं मोकै काहे ना बताओ? मैं तुम्हैं खुसी के संग गीत गात, और डफली, सितार और बाजा बजात भै विदा कर देतो। <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />तैं तौ मोकै मेरे धुईतो-धुईतन और मेरी लौड़ियन कै चूमकै अलविदा करन तक नाय दौ। ऐसो करनो एक मूर्खता को काम रहै! <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />याकूब कही मेरे मैं तुम्हैं नुकसान पहोंचान की ताकत है, लेकिन कल रात तुमरे दऊवा को परमेस्वर मोकै चितौनी दई, कि मैं तुमकै कैसियौ भलो-बुरो नाय कहमौं। <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />मोकै मालूम है कि तुम चले आए काहैकि तुम घरै बापस आन के ताहीं भौत उत्सुक रहौ, लेकिन तुम मेरे घरेलू दुईता कै काहे चुराएलै?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />याकूब लाबान कै जबाब दई, “मैं डर गौ, काहैकि मैं सोचो, कि कहीं तैं अपनी लौड़ियन कै मोसे छीन ना लेबै। <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />अगर तैं पाबै, कि हिंयाँ कोई के झोने तेरो प्रभु हैं, तौ बाकै मार डारो जागो। हिंयाँ हमरे आदमिन कै गभा बनाएकै, जो कुछ भी तेरो है, बाकै देख और बाकै लै ले।” याकूब ना जानत रहै, कि राहेल लाबान के दुईतन कै चुराए लाई है।<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />लाबान जाएकै याकूब के तम्बू की तलासी लई; फिर बौ लिआ के तम्बू मैं गौ, और दोनों दासियन के तम्बू मैं गौ, लेकिन बाकै अपने दुईता ना मिले। फिर बौ राहेल के तम्बू मैं गौ। <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />राहेल घरेलू दुईतन कै लै जाएकै ऊँट की काठी मैं रख लई होथै और बाके ऊपर बैठी रहैं। लाबान सब तम्बू मैं तलासी, लेकिन उन्हैं ना पाई। <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />राहेल अपने दऊवा से कही, “प्रभु, मेरे ऊपर गुस्सा मत हुईये, लेकिन मैं तेरे सामने ठाड़ नाय हो सकथौं; मेरे महेना चल रै हैं। लाबान भौत ढूँड़ी लेकिन अपने घरेलू दुईतन कै ना पाई।”<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />फिर याकूब अपनो आपा खोए दई, बौ गुस्सा से लाबान से पूँछी। “मैं कौन सो पाप करो हौं? मैं कौन सो कानून तोड़ो हौं जो तोकै मेरो पीछा करन को अधिकार देथै?” <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />अब जब तैं मेरो सब सामान टटोलकै देखो, तौ तोकै कौन सो घरेलू सामान मिलो है जो तेरो है? कुछ मिलो तौ बाकै हिंयाँ अपने और मेरे लोगन के सामने रखदे, और उन्हैं फैसला लेन दे कि हम मैं से कौन सई है। <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />मैं बीस साल से तेरे संग हौं; इनमैं ना तौ तेरी भेड़-बकरियन के गर्भ गिरे, और ना तेरे झुंग के भेंड़न को मास, मैं कहू खाओ। <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />जौ जानवर कै जंगली जानवर मार डारत रहै, बाकै मैं तेरे झोने ना लात रहौं और मैं खुद बौ नुकसान की भरपाई करत रहौं। जानवर की चोरी चाहे रात कै होबै, या दिन कै, तैं मुहीं से बाकी भरपाई करवात रहै। <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />मेरी ऐसी दसा रहै: दिन को घामों और रात कि ठंड से मैं मरो जात रहौं। मेरी नींद तक नाय आत रहै। <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />पूरे बीस साल तक मैं तुमरे संग ऐसिये रहो। चौदह साल तक मैं तेरी दुई लौड़ियन कै जीतन के ताहीं काम करो और छै साल ले तेरी भेड़-बकरियन की सेवा करो। और मेरी मजदूरी कै तैं दस बार बदलो। <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />अगर मेरे पुरखन को परमेस्वर, अब्राहम और इसहाक को परमेस्वर, मेरे संग न होतो, तौ तू मोकै खाली हाथ भेज दौ होतो। लेकिन परमेस्वर मेरी परेसानी और मेरे हातन के कामन<note caller="+" style="f"><char style="fr" closed="false">31:42 </char></note> कै देखी और कल रात बौ अपनो फैसला सुनाई।<verse eid="GEN 31:42" /></para>
  <para style="s">याकूब और लाबान के बीच समझौता</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />लाबान याकूब कै जबाब दई, “जे बईय्यरैं मेरी लौड़िया हैं; उनके बालका मेरे हैं, और जे भेड़-बकरिया मेरी हैं। सच्ची मैं, तैं हिंयाँ जो कुछ भी देख रौ है बौ मेरो है। लेकिन अब मैं अपनी लौड़िया और उनके बालकन को कुछ नाय कर सकथौं, <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />मैं तेरे संग वाचा बाँधन कै तैयार हौं। तौ आ आपन समझौता कै यादगार बनान ताहीं पथरन की ढेरी बनामै।”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />तौ याकूब एक पथरा लई और बाकै स्मारक के रूप मैं खड़ो करी। <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />याकूब अपने आदमिन से कही कि बे कुछ चट्टान इकट्ठो करैं, और उनकी ढेरी लगाए देमैं। जौ सुनकै बे चट्टान कै इकट्ठो करकै एक ढेरी बनाईं और बहे के झोने बैठ कै खानू खाईं। <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />बौ ढेरी को नाओं लाबान जेगर सहदुता रखी, और याकूब बाको नाओं गलीद रखी। <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />लाबान याकूब से कही, “चट्टान की जौ ढेरी आपन दोनों के ताहीं गभा ठहरैगी।” जौ बजह से बौ जघा को नाओं गलीद रखो गौ। <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />लाबान जौ भी कही, जब तक आपन दोनों एक दुसरे से अलग रहथैं तब तक प्रभु आपन दोनो की देखरेख करै। जौ बजह से बौ जघा को नाओं मिजपा भी रखो गौ। <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />लाबान जाके और भी अग्गु कही, अगर तैं मेरी लौड़ियन के संग बुरो बर्ताव करो या अगर कोई और बईंय्यरन से बिहा करो, तौ देख, हुई सकथै कोई आदमी हमरे संग ना रहगो, लेकिन मेरे और तेरे बीच परमेस्वर साक्छी रहगो। <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />लाबान याकूब से कही, “जौ ढेर और जौ पत्थर कै देख, जोकै मैं अपने और तेरे बीच ठड़बाओ हौं। <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />जौ ढेरी और पथरा दोनों ही यादगार ताहीं हैं। मैं तेरे ऊपर हमला करन के ताहीं जौ ढेरी से अग्गु कहुए नाय जांगो, और तू भी मेरे ऊपर हमला करन के ताहीं जाके अग्गु न बढ़ैगो जाके गभा ढेरी और पत्थर है। <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />अब्राहम को परमेस्वर और नाहोर को परमेस्वर हमरे दोनो के बीच न्याय करैगो।” फिर याकूब परमेस्वर के नाओं की, जो बाको दऊवा इसहाक जोकी आराधना करत रहै, जौ बादा पूरो करन के ताहीं कसम खाई। <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />याकूब पहाड़ मैं बलि चढ़ाई और रोटी खान के ताहीं अपने हितुवन कै बुलाई। बे रोटी खाईं और पहाड़ मैं रात बिताईं। <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />सुबेरे लाबान उठो और अपने लौड़ा-लौड़ियन कै आसीर्वाद दैकै चल दई, और अपनी जघा कै चल दई।<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">याकूब को एसाव से मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />अगली सुबेरे लाबान अपने धुईतो-धुईतन और लौड़ियन कै चूमकै अलविदा कही और अपने घरै बापस जान के ताहीं लौट गौ। जैसिये याकूब अपने राह मैं चलो, परमेस्वर के कुछ स्वर्गदूत बासे मिले। <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />जब याकूब उनकै देखी तौ बौ बोली “जौ तौ परमेस्वर की सेना है”, तौ बौ बौ जघा को नाओं महनईम रखी।<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />जब याकूब सेईर कै देखी तौ कही, जे तौ परमेस्वर की सेना है। जौ बजह से बौ बौ जघा को नाओं महनईम रखी। एदोम देस मैं अपने भईय्या एसाव के झोने अपने अग्गु दूत भेजी। <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />याकूब घरै पहोंचन से पहले अपने स्वामी एसाव से जौ कहियो कि तेरो दास याकूब तोसे जौ कहथै कि मैं लाबान के हुँआँ परदेसी हिकै अब तक रहो। <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />मेरे झोने गईंय्या-बरधा, गधा भेंड़ बकरिया और दास-दासी हैं और मैं अपने प्रभु के झोने जहे ताहीं भेजो हौं कि तेरे अनुग्रह कि नजर मोमैं होबै।<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />बे दूत याकूब के झोने कहेन लगे, हम तेरे भईय्या एसाव के झोने गै रहैं, और बौ भी तोसे भेंट करन कै चार सौ आदमी संग लै भै चलो आथै। <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />तौ याकूब बड़ा डराए गौ और चिंता करथै। और बौ अपने संग के लोगन कै, और अपनी भेड़-बकरिया, गईंय्या-बरधा, और ऊँटन कै भी दुई हिस्सा मैं बाँट दई। <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />कि अगर एसाव पहले आएकै पहले दल कै मारन लगै, तौ दुसरो दल भाजकै बच जाबैगो।<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />याकूब परमेस्वर से प्रार्थना करी, “मेरे दादो अब्राहम के परमेस्वर, और मेरे दऊवा इसहाक के परमेस्वर! तू मोसे कहो रहै, अपने देस अपने जनम स्थान कै अपने परिवार के संग लौट जा मैं तेरे संग भलाई करंगो।” <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />तू जो-जो काम अपनी करूड़ा और सच्चाई से अपने दास के संग करो है कि मैं अपनी छड़ी कै लैकै जौ यरदन नदिया के पार उतर आओ, और अब मेरे दुई दल ही है हैं तेरे ऐसे-ऐसे कामन मैं से मैं एक के भी योग्य नाय हौं। <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />मैं प्रार्थना करथौं, मोकै मेरे भईय्या एसाव से बचा। मोकै डर है कि बौ हमरे ऊपर हमला करन और हम सबकै नास करन कै आए रौ है, हिंयाँ ले कि बईंय्यरन और बालकन कै भी नाय छोड़ैगो। <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />मैं बौ सब दयालुता और बफादारी के लायक नाय हौं, जो तैं अपने सेवक ऊपर दिखाओ। मैं यरदन नदिया कै सिरफ एक लठिया के सहारे पार करो और अब मेरे इतनो सेठ हुई गौ हौं कि बाकै दुई दल मैं बाँटकै लै जाए रौ हौं। <verse eid="GEN 32:12" /><verse number="13" style="v" sid="GEN 32:13" />याकूब हूँना रात बितान के बाद, और जो कुछ याकूब के पास रहै, बौ अपने भईय्या एसाव कै भेंट देन के ताहीं अपने जानवर मैं से भेंड़न कै छाँट-छाँटकै निकारी।<verse eid="GEN 32:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 32:14" />दुई सौ बकरिया और बीस बकरा और दुई सौ भेंड़ और बीस मेढ़े, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />तीस दूद देन बारी ऊँटनी और उनके बच्चा, चालीस गईंय्या, और दस बरधा, बीस गधईय्या, और दस गधा। <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />तीस दूद देन बारी ऊँटनी और उनके बच्चा, चालीस गईंय्या, और दस बरधा, बीस गधईय्या, और दस गधा।<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />बौ उन्हैं झुंग मै हिस्सा बनाएकै, अपने सेवकन कै सौंपकै उनसे कही, जब मेरो भईय्या एसाव तोकै मिलै, और पूँछन लगै, कि तू कोन को दास है, और कहाँ जाथै, और जो तेरे अग्गू-अग्गू हैं, बे कोन के है? <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />तौ कहियो, जे तेरे दास याकूब के हैं। हे मेरे प्रभु एसाव जे भेंट के ताहीं तेरे झोने भेजे गै हैं और बौ खुद भी हमारे पच्छू-पच्छू आए रौ है।<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />तौ तैं जबाब दिये, जे तेरे नौकर याकूब के हैं। बौ इन्हैं अपने मालिक एसाव कै भेंट भेजी है और याकूब भी खुदै हमरे ठीक पच्छू-पच्छू आए रौ है। <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />और याकूब दुसरे, तीसरे और भी सब रखबरियन कै जो झुंग के अधिकारी रहैं, उन्हऊँ कै बैसिये आदेस दई: जब तुम एसाव से मिलौ तौ तुम्हैं जौ भेंट देने और बासे जहे कहने है तौ बौ तुमसे खुस ही जागो। <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />तुम जौ भी कहियो, हाँ, तेरो सेवक याकूब हमरे ठीक पच्छू-पच्छू आए रौ है। याकूब सोचत रहै, “मैं बाकै भेंट के जरिया बाकै जीत लुंगो, और जब मैं बासे मिलंगो, तौ सायद बौ मोकै माफ करकै अपनाए लेगो।” <verse eid="GEN 32:21" /><verse number="22" style="v" sid="GEN 32:22" />याकूब बहे रात उठो। बौ अपनी दोनो बईय्यर और दोनो दासी और ग्यारह लौड़न कै लैकै यब्बोक नदिया को घाट पार करी।<verse eid="GEN 32:22" /></para>
  <para style="s">परमेस्वर के संग कुस्ती</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 32:23" />बहे रात याकूब उठो, और अपनी दोनों बईय्यर, दोनों दासी, और अपने ग्यारह लौड़न कै संग लैकै यब्बोक नदिया कै पार करी। <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />याकूब उन्हैं नदिया के पार भेजन के बाद, बौ अपनो सब कुछ समान नदिया के पार भेज दई, <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />लेकिन याकूब इकल्लो, पच्छू रह गौ। फिर एक आदमी आथै और भुकभुको होन से पहले बासे कुस्ती लड़थै।<verse eid="GEN 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 32:26" />तौ बौ कही “मोकै जान दे; काहैकि सुबेरे होन बारी है।” याकूब कही, “जब तक तू मोकै आसीर्वाद नाय देगो,” तब तक मैं तोकै जान नाय देंगो।<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />फिर बौ आदमी कही, मोकै जाने दे; दिन को उजियारो होन बारो है। याकूब जबाब दई, “जब ले तैं मोकै आसीस नाय देगो, मैं तोकै जान ना दुंगो।”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />बौ आदमी कही, “तेरो नाओं अब याकूब नाय रहगो। काहैकि तैं परमेस्वर और इंसान से लड़ो, और तैं जीत गौ है: जौ बजह से अब से तेरो नाओं इस्राएल होगो।”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />याकूब कही, “मैं विनती करथौं, मोकै अपनो नाओं बता।” बौ कही, “तू मेरो नाओं काहे पूँछथै?” तौ बौ बाकै हुनै आसीर्वाद दई।<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />याकूब कही, “मैं परमेस्वर कै अपने आमने-सामने देखो हौं, और मैं हबै ले जिंदो हौं” जौ बजह से बौ जौ जघा को नाओं पनीएल रखो गौ। <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />जब याकूब पनीएल से जात होथै, तौ बौ अपनी जाँघ के बजह से लंगड़ात रहै, और सूरज बाके ऊपर चमकन लगो रहै। <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />इस्राएल जाति के लोग आज ले जानवर के जाँघ की नस कै, जो जाँघ के जोड़न मैं होथै, नाय खाथैं; काहैकि बौ इंसान याकूब की जाँघ के गदरा कै छुई रहै।<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">याकूब को एसाव से मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />याकूब एसाव कै अपने चार सौ आदमी समेत आत भै देखी, तौ बौ बालकन कै लिआ, राहेल, और दोनों दासी मैं सौंप दईं। <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />बौ सबसे अग्गु दोनो दासिन और उनके बालकन कै, उनके पच्छू लिआ कै बाके बालकन के संग, और सबसे पच्छू राहेल और यूसुफ कै खड़ो करी। <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />याकूब उनके अग्गु-अग्गु चलत गौ, जब ले बौ अपने भईय्या के झोने नाय पहोंच गौ, तौले बौ जमीन मैं लोहोक्कै अभिवादन करी। <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />लेकिन एसाव याकूब से गले मिलन के ताहीं दौड़ौ, और बाकै गले लगाई, बाकै चूमी। और बे दोनों एक संग खूबै रोईं। <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />जब एसाव चारौ घाँईं नजर करकै बईंय्यरन और बालकन कै देखीं, तौ बौ याकूब से पूँछी, “जे तेरे संग कौन हैं?” याकूब जबाब दई, परमेस्वर मेरे ऊपर दया करी और बौ मोकै जे बालका दई है। जे तेरे सेवक के बालका हैं।<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />तौ दोनों दासी अपने बालकन सुंदा आएकै लोहोक्कै नमस्कार करीं; <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />तौ लिआ और बाके बालका आए, आखरी मैं राहेल और यूसुफ झोने आए। बे एसाव कै लोहोक्कै नमस्कार करीं।<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />एसाव पूँछी, जो जानवरन के झुंग मोकै रस्ता मैं मिले, बासे तेरो का मतलब है? याकूब जबाब दई, “मेरे स्वामी, तेरी कृपादृस्टि पानो।<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />लेकिन एसाव कही, मेरे भईय्या, मेरे झोने भौत हैं; जो तुम्हारो है बाकै अपने पास रखौ।”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />याकूब कही, “न, महरबानी करकै, अगर मोकै तेरो अनुग्रह मिलो है, तौ मेरी भेंट अपना। जामैं कोई सक ना है कि तेरी सकल देखनो मेरे ताहीं परमेस्वर की सकल देखन जैसी है, काहैकि तैं मोकै अपनाओ है। <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />गुजारिस करकै जौ भेंट अपना जो मैं तेरे ताहीं लाओ हौं; परमेस्वर तेरे ऊपर आसीस बनाए रहबै और बौ मोकै सबै कुछ दई है जोकी मोए जरूरत है।” याकूब बासे तौ ले खुसामत करत रहौ जब ले एसाव बाकी भेंट कै अपनाय ना लई।<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />एसाव कही आ, “आपन अपने रस्ता मैं बढ़त चलैं। मैं तेरे अग्गु जांगो।”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />याकूब जबाब दई, “हे मेरे स्वामी तू जानथै कि बालका छोटे हैं, और मोए भेड़-बकरियन और उनके बच्चन के बारे मैं सोचनो चाहिए। अगर ऐसे जानवरन कै एक दिन के ताहीं भी जाधे हांको जाबै, तौ जे सब मर जांगे। <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />मेरे स्वामी अपने सेवक के अग्गु बढ़ जाबै। जो जानवर मेरे अग्गु-अग्गु हैं, उनकी चाल और अपने बच्चन की चाल के हिसाब से मैं धीरे-धीरे अग्गु बढ़ौं। जब ले सेईर नगर मैं अपने स्वामी के झोने ना पहोंच जामौं।”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />एसाव कही, “तौ फिर मैं अपने कुछ लोगन कै तेरे झोने छोड़ देथौं।” लेकिन याकूब जबाब दई, “बाकी कोई जरुरत ना है, सिरफ मेरे स्वामी को अनुग्रह मेरे ऊपर बनो रहबै।” <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />तौ बौ दिन एसाव सेईर नगर के घाँईं बापस जान के ताहीं चल पड़ो। <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />लेकिन याकूब सुक्कोत कै गौ, और हुँआँ बौ अपने ताहीं एक घर और जानवरन की सार बनाई। बौ जौ बजह से बौ जघा को नाओं सुक्कोत रखो गौ।<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />पद्दन-अराम के इलाका से लौटन के बाद याकूब कनान देस के सेकेम नगर मैं सई सलामत पहोंच गौ, और सहर के झोने एक मैदान मैं तंबू बनाई। <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />और बौ एक खेत को टुकड़ा सेकेम के दऊवा हमोर के लौड़न से सौ चाँदी के सिक्का से मोल लई। <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />बौ हुँआँ एक बेदी बनाई और बाको नाओं एल एलोहे मतलब इस्राएल को परमेस्वर नाओं रखी।<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">दीना के संग कुकर्म</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />एक दिन लिआ की लौड़िया दीना जो याकूब से पैदा भई रहै, कुछ कनानी बईंय्यरन से मिलन गई। <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />हमोर नाओं को सासक बाके लौड़ा को नाओं सेकेम, जो हिव्वी जाति को रहै, जब सकेम दीना कै देखी तौ बाकै पकड़ लई, और बौ बाके संग कुकर्म करी। <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />लेकिन याकूब की लौड़िया दीना बाकै इत्ती भाए गई, कि बासे प्यार ही गौ और बौ बाको दिल जीतन कोसिस करथै। <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />सेकेम अपने दऊवा हमोर से कही, “मैं चाहथौं कि तैं बाकै मेरी बईय्यर बनाए दे।”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />जब याकूब कै पता चलो कि बौ बाकी लौड़िया दीना के संग कुकर्म करी है, लेकिन काहैकि बाके लौड़ा अपने जानवरन के संग खेतन मैं गै होथैं, जौ बजह से बौ उनके बापस आन तक कछु ना करी। <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />सेकेम को दऊवा हमोर बात-चीत करन के ताहीं याकूब के झोने गौ, <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />जैसिये याकूब को लौड़ा खेत से आए। जब बे बाके बारे मैं सुनी, तौ बे भौचक्के ही गै और गुस्सा भै कि सेकेम ऐसो काम करी है और याकूब की लौड़िया के संग कुकर्म करकै इस्राएल के लोगन को अपमान करी है। ऐसो काम नाय करनो चाहिए। <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />हमोर उनसे कही, मेरे लौड़ा सेकेम कै तेरी लौड़िया से प्रेम ही गौ है; महरबानी करकै बासे बिहा करन दे। <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />अब चल और आपन एक समझौता करैं कि अपनी लौड़िया हमैं देबौ, हमरी लौड़िया तुम लेबौ। <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />तौ तुम हमरे देस मैं हमरे संग रह पागे; तुम अपनी इच्छा से कहीं भी रह सकथौ, और हिंयाँ रहबै और पूरे आजादी से कारोबार करौ। खूब धन-सम्पत्ति कमाबौ।<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />तौ सेकेम दीना के दऊवा और भईय्यन से कही, मेरे ऊपर जौ अनुग्रह करौ, और तुम जो चाहबौ मैं तुमकै दुंगो। <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />तुम जितनो भी अगरो दहेज और भेंट माँगैगे, मैं तुमकै वचन के हिसाब से दुँगो, तुम खाली मोकै अपनी लौड़िया से बिहा करवाए दियौ।<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />याकूब के लौड़ा, सेकेम और बाके दऊवा हमोर कै कपटी हुईकै जबाब दईं; काहैकि सकेम उनकी बहेनिया दीना के संग छल से कुकर्म करी रहै। <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />बे बासे कही, “हम अपनी बहेनिया को बिहा ऐसे आदमी से नाय कर सकथैं जोको खतना ना भौ होबै; जौ हमरे ताहीं अपमान की बात होगी। <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />हम सिरफ जौ सर्त मैं सहमत ही सकथैं कि तुम अपने सब आदमियन को खतना करकै हमरे जैसे बन जाबौ। <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />तौ हम अपनी लौड़िया तुम लोगन कै देंगे और तुमरी लौड़िया हम लेंगे। हम तुमरे संग रहंगे और हम सब एकै जाति के बन जांगे। <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />लेकिन अगर तुम हमरी सर्त नाय अपनागे और खतना भी ना करैगे, तौ हम बाकै लै लेंगे और फिर चले जामंगे।”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />उनकी बातन से हमोर और बाको लौड़ा सेकेम खुस भै। <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />ज्वान सकेम बाकी माँग पूरी करन मैं कतई देरी ना करी; काहैकि बौ याकूब की लौड़िया कै भौत मन से लगात रहै। बौ अपने दऊवा के सब परिवार मैं सबसे सम्मानित आदमी रहै।<verse eid="GEN 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 34:20" />हमोर और बाको लौड़ा सेकेम सहर के फाटक पर सभा के झोने गै, और नगर के लोगन से कहीं, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />जे आदमी हमरे संग मिलनसार व्यवहार करथैं। इनकै जौ देस मैं रहन और ब्यापार करन देबै। देखौ, इनके ताहीं भी जौ देस भौत बड़ो है। आबौ, हम इनकी लौड़ियन से बिहा करैं, और अपनी लौड़िया इनकै देमैं। <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />जे जौ सर्त मैं हमरे संग रहन कै और एकै जाति बनन कै सहमत हैं, कि जैसे इनको खतना भौ है बैसिये हममैं से हर के आदमी को खतना करो जाबै। <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />तौ इनकै पालतू जानवर, इनकी धन-सम्पत्ति और जंगली जानवर हमरे हुई जांगे। हक खाली इनकी सर्त कै मान लेमैं। तौ जे हमरे संग रहन लगंगे। <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />नगर के भीतर आन बारे फाटक मैं आए सब लोग हमोर और बाके लौड़ा सेकेम की बात मानीं। और हर एक आदमी जो नगर के फाटक मैं आओ रहै, अपनो खतना करवाई।<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />जब तीसरे दिन बे सब पीड़ित रहैं, तौ दीना के भईय्या, मतलब याकूब के दुई लौड़ा सिमौन और लेवी, तलवार लैकै नगर मैं अचानक चढ़ बैठै, बे सब आदमिन कै मार डारीं। <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />बे हमोर और बाके लौड़ा सेकेम कै भी तलवार से मार डारीं, बे सकेम के घर से दीना कै लैकै चले गै। <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />याकूब के दुसरे लौड़ा मरेन भै के झोने गै। बे नगर कै लूट लईं; काहैकि उनकी बहेनिया के संग कुकर्म करो गौ रहै। <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />याकूब के लौड़ा उनकी भेड़-बकरिया, गईंय्या-बरधा, गधा, मतलब जो कछु नगर और मैदान मैं रहै, सब लूट लईं। <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />उनकी धन-सम्पत्ति, उनके बाल-बच्चे, उनकी बईय्यरैं और जो कछु उनके घरन मैं रहै, सबकै लूटकै कब्जियाए लईं।<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />याकूब सिमौन और लेवी से कही, “तुम मोकै संकट मैं डार दौ है; अब कनानी, परिज्जी, और देस के सब लोग मोसे बैर करंगे। मेरे झोने भौत आदमी नाय हैं; अगर बे सब मेरे खिलाप एकजुट हुईकै मेरे ऊपर हमला करैं, तौ हमरो पूरो परिवार नास ही जागो।”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />लेकिन बे जबाब दईं, “का सकेम कै हमरी बहेनिया के संग बैस्या के हानी बर्ताव करनो चाहिए रहै?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">बेतेल मैं याकूब कै परमेस्वर की आसीस</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />परमेस्वर याकूब से कही, “तुरंतै बेतेल जा, और हूँनै रह। हुँआँ मेरे ताहीं एक बेदी बना, जो परमेस्वर तोए बौ समय दर्सन दई रहै जब तैं अपने भईय्या एसाव के झोने से भाजो रहै।”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />याकूब अपने परिवार और बे सब लोगन से जो बाके संग रहैं, कही, “तुमरे बीच मैं दूसरी जातिन के दुईतन की मूर्ती हैं। उनकै हटाए दियौ और अपने आपकै सुद्ध करौ। अपने लत्तन कै बदल डारौ। <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />आपन हिंयाँ से निकरकै बेतेल जाए रै हैं, जहाँ मैं परमेस्वर के ताहीं एक बेदी बनांगो जो मेरी मुसीबत के समय मेरी मदत करी और मैं जहाँ भी गौ, बौ मेरे संग रहो।” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />तौ बे याकूब कै बे सब पराए दुईता दै दईं जो उनके पास रहैं, और बे कान के कुँडल भी सौंप दईं; याकूब सेकेम नगर के झोने सिंदूर पेंड़ के तरे उनकै गाड़ दई।<verse eid="GEN 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5" />जब याकूब और बाको लौड़ा जान लगो, तौ आस-पास के सहर के लोगन मैं परमेस्वर को डर छाए गौ, और बे उनको पीछा नाय करीं। <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />याकूब अपने सब लोगन के संग लूज नगर मैं आओ, जो अब कनान देस मैं बेतेल के नाओं से जानो जाथै। <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />बौ हूँना एक बेदी बनाई और बौ जघा को नाओं बेतेल<note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="ft" closed="false">मतलब परमेस्वर को घर</char></note> रखी, काहैकि जब बौ अपने भईय्या के झोने से भाजत होथै, तौ परमेस्वर खुदकै बाके ऊपर प्रकट करी। <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />रिबका की दैबुढ़िया दबोरा की मौत ही गई और बाकै बेतेल के तरिहाँए सिन्दूर पेंड़ के नीचे दफनाओ गौ। तौ बाको नाओं “अल्लोनबक्कूत” रखो गौ।<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />जब याकूब पद्दन-अराम इलाका से लौटो, तौ परमेस्वर बाकै फिर से दर्सन दई और बाकै आसीस दई। <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />परमेस्वर बासे कही, तेरो नाओं याकूब है, लेकिन अब से जाको नाओं इस्राएल होगो। तौ परमेस्वर बाको नाओं इस्राएल रखी।<note caller="+" style="f"><char style="fr" closed="false">35:10 </char><char style="ft" closed="false">उत्प 32:28</char></note> <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />परमेस्वर बासे फिर से कही, मैं सर्वसक्तिमान परमेस्वर हौं। फलौ-फूलौ और अनगिनत हुई जाबौ। रास्ट्र और रास्ट्रन को समूह तोसे निकरैं। तमान राजा तोसे निकरंगे।<note caller="+" style="f"><char style="fr" closed="false">35:11 </char><char style="ft" closed="false">उत्प 17:4,8 </char></note> <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />मैं बौ देस जो अब्राहम और इसहाक कै दौ, तोकै दुंगो, और तुमरे बाद तुमरे बंस कै भी दुंगो। <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />तौ परमेस्वर बौ जघा से जहाँ बौ याकूब से बतकाई रहै, ऊपर चले गौ। <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />याकूब बौ जघा मैं, जहाँ परमेस्वर बासे बात करी रहै, पत्थर को एक खम्मा ठड़बाई, और बामै दाखरस और जैतून को तेल डारकै बाकै पवित्र करी।<note caller="+" style="f"><char style="fr" closed="false">35:14 </char><char style="ft" closed="false">उत्प 28:18,19</char></note> <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />जो जघा मैं परमेस्वर याकूब से बतकाई रहै, बौ बौ जघा को नाओं बेतेल रखी।<verse eid="GEN 35:15" /></para>
  <para style="s">राहेल की मौत</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />याकूब और बाके परिवार बेतेल कै छोड़ देथैं, और जब बे एप्राता नगर से कुछै दूरी मैं रहैं, तौ राहेल को बालका होन को समय आए गौ रहै, और बाकै प्रसव को पीर होन लगथै। <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />जब बाकी पीर प्रसव दर्द चरम मैं रहै, तौ बासे दैबुढ़िया कही, “डराबै मति, राहेल; अबकियो बार तेरो लौड़ै होगो।” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />जब बाकी जान निकरत रहै, तौ बौ अपने लौड़ा को नाओं बेन-ओनी रखी, पर बाको दऊवा बाको नाओं बिन्यामीन रखी।<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />जब राहेल की मौत भई, तौ बाकै एप्राता की सड़क के किनारे दफनाओ गौ, जोकै अब बैतलहम के नाओं से जानो जाथै। <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />याकूब हुँआँ एक पथरा के खम्मा की खड़ो करी, और जौ आज भी राहेल की कबर की निसानी है। <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />याकूब अग्गु बढ़कै एदेर के मीनार अग्गु अपनो तम्बू डारी।<verse eid="GEN 35:21" /></para>
  <para style="s">याकूब को लौड़ा</para>
  <para style="r">(<ref loc="1CH 2:1-2">1 इतिहास 2:1-2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />जब याकूब बौ देस मैं रहत रहै, तौ रूबेन अपने दऊवा की उपबईय्यर बिल्हा के झोने गौ और बाके संग कूकर्म करी। याकूब जाके बारे मै सुनी और गुस्सा भौ। याकूब के बारह लौड़ा रहैं।<note caller="+" style="f"><char style="fr" closed="false">35:22 </char><char style="ft" closed="false">उत्प 49:4 </char></note> <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />लिआ को लौड़ा रूबेन याकूब को सबसे बड़ो लौड़ा होथै, सिमौन, लेवी, यहूदा, इस्साकार और जबूलून रहैं। <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />राहेल को लौड़ा यूसुफ और बिन्यामीन रहै। <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />राहेल की सेविका बिल्हा के लौड़ा रहैं: दान और नप्ताली। <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />जे लिआ कि सेविका जिल्पा के लौड़ा रहैं: गाद और आसेर। जेईं याकूब के लौड़ा हैं, जो पद्दन-अरान इलाका मैं पैदा भै रहैं।<verse eid="GEN 35:26" /></para>
  <para style="s">इसहाक की मौत</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />याकूब अपने दऊवा के झोने ममरे नगर मतलब की किर्यतअर्बा हेब्रोन नगर मैं आओ, जहाँ अब्राहम और इसहाक रहत रहैं। <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />इसहाक एक सौ अस्सी साल जिंदो रहो, <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />तौ इसहाक आखरी सांस लई, और जान छोड़ दई। बौ बूढ़ो और पूरी उमर भोगकै अपने मरे भै पूर्वजन मैं जाएकै मिल गौ। और बाके लौड़ा एसाव और याकूब बाकै मट्टी दईं।<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">एसाव के वंसज <char style="xt" closed="false"><ref loc="1CH 1:34-37">1 इतिहास 1:34-37</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />जे एसाव के वंसज हैं, जोकै एदोम भी कहो जाथै। <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />एसाव कनानी बईंय्यरन से बिहा करी: जे बाकी बईय्यरैं रहैं: हित्ती जाति एलोन की लौड़िया आदा; आना की लौड़िया और हिव्वी जाति सिबओन की नतनिया आहलीबामा, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />और बसमत, जो इस्माएल की लौड़िया और नबायोत की बहेनिया रहै। <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />आदा एसाव से एलीपज कै और बसमत रूएल कै जनम दई; <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />और आहलीबामा से यूस, यालाम, और कोरह पैदा भै। जे सब लौड़ा कनान देस मैं एसाव से पैदा भै रहैं।<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />तौ एसाव अपनी सब बईय्यर, लौड़ा, लौड़िया, और अपने घर के सब लोग, और अपने पालतू जानवर और दुसरे जानवर, और अपनी सब संपत्ति जो बौ कनान देस मैं कमाई रहै, सब चीज लैकै अपने भइय्या याकूब के झोने से दुसरे देस मैं चले गौ। <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />बौ जहेमारे चले गौ काहैकि जो जमीन मैं बौ और याकूब रहत रहैं बामै इनको पेट नाय पलतो; उनके झोने भौत धन-संपत्ति ही गई रहै और बे अब एक संग नाय रह पात रहैं। <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />तौ एसाव पहाड़ी प्रदेस सेईर मैं रहन लगो। एसाव कै एदोम भी कहो जाथै।<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />पहाड़ी प्रदेस सेईर मैं रहन बारे एदोम वंसन के पुरखा एसाव की वंसावली जौ है: <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />जे एसाव के लौड़न के नाओं हैं: एसाव की बईय्यर आदा को लौड़ा एलीपज, एसाव की बईय्यर बसमत को लौड़ा रूएल। <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />जे एलीपज के लौड़ा हैं: तेमान, ओमर, सपो, गताम और केनाज। <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />एसाव के लौड़ा एलीपज की तिम्नाह नाओं की उपबईय्यर रहै। बौ एलीपज से अमालेक कै जनम दई। एसाव की बईय्यर आदा के जेईं लौड़ा हैं। <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />रूएल के चार लौड़ा रहैं: नहत, जेरह, सम्मा और मिज्जा। एसाव की बईय्यर बसमत के जेईं लौड़ा हैं।<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />एसाव की बईय्यर आहलीबामा के, जो सिबओन की नतनिया और आना की लौड़िया रहै, बासे तीन लौड़ा पैदा भै: यूस, यालाम और कोरह।<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />जे एसाव के बंसज के मुखिया भै: एसाव को जेठो लौड़ा एलीपज के बंस मैं जे मुखिया बने: तेमान, ओमर, सपो, केनाज, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />कोरह, गताम, और अमालेक। जेईं एदोम देस मैं एलीपज के बंस मैं मुखिया बने। जेईं आदा के बंसज हैं।<verse eid="GEN 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17" />एसाव के लौड़ा रूएल के बंस मैं जे मुखिया बने: नहत, जेरह, सम्मा और मिज्जा। जेईं एदोम देस मैं रूल के बंस मैं मुखिया बने। जेईं एसाव की बईय्यर बसमत के बंसज हैं। <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />जे एसाव की बईय्यर आहलीबामा के बंसज हैं, जो मुखिया बने: यूस, यालाम और कोरह। एसाव की बईय्यर और आना की लौड़िया आहलीबामा से जेईं मुखिया बने। <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />जेईं एसाव मलतब एदोम के वंसज और उनके मुखिया हैं।<verse eid="GEN 36:19" /></para>
  <para style="s">सेईर के बंसज <char style="xt" closed="false"><ref loc="1CH 1:38-42">1 इतिहास 1:38-42</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />जे होरी जाति के सेईर के लौड़ा हैं। जे एदोम देस के मूल निवासी हैं: लोटन, सोबल, सिबओन, आना, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />दीसोन, एसर और दीसान। जेईं एदोम देस मैं सेईर के लौड़ा होरी जाति के मुखिया बने।<verse eid="GEN 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22" />लोटन को लौड़ा होरी और हेमन रहै। लोटन की बहेनिया तिम्नाह रहै।<verse eid="GEN 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23" />जे सोबल के लौड़ा हैं: अल्वान, मानहत, एबल, सपो और ओनम।<verse eid="GEN 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24" />जे सिबओन के दुई लौड़ा रहैं: अईय्या और अना। जे बहे अना है जो अपने दऊवा सिबओन के गधा चुगात समय निर्जन प्रदेस मैं गरम पानी के झरना पाई रहै। <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />जे आना के बालका हैं: लौड़ा दीसोन और लौड़िया आहलीबामा। <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />जे दीसोन के लौड़ा हैं: हेमदाम, एसबान, यित्रान और करान।<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />ये एसर के लौड़ा हैं: बिल्हान, जावन और अकान। <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />जे दीस के लौड़ा हैं: ऊस और अरान।<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29" />जे होरी जाति के मुखिया बने: लोटन, सोबल, सिबओन, आना, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />दीसोन, एसर और दीसन। जे एदोम देस मैं अपने-अपने झुंग के हिसाब से होरी जाति के मुखिया बने।<verse eid="GEN 36:30" /></para>
  <para style="s">एदोम के राजा</para>
  <para style="r">(<ref loc="1CH 1:43-54">1 इतिहास 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />इस्राएलियन के ऊपर राज्य करन बारे राजन के पहले एदोम देस मैं जे राजा राज्य करीं।<verse eid="GEN 36:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="GEN 36:32" />बोर को लौड़ा बेला एदोम देस मैं राज्य करी। बाके सहर को नाओं दिन्हाबा रहै।<verse eid="GEN 36:32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="GEN 36:33" />बेला की मौत भई। बोस्रा नगर के रहन बारे जेरह को लौड़ा योबाब बाकी जघा मैं राजा बनो।<verse eid="GEN 36:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="GEN 36:34" />योबाब की मौत भई। तेमानी जाति के देस को रहन बारो हूसम बाकी जघा मैं राज्य करी।<verse eid="GEN 36:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="GEN 36:35" />हूसम की मौत भई। बदद को लौड़ा हदद, जो मोआब के देस मैं मिद्यान जाति कै हराई रहै, बाकी जघा मैं राज्य करी। बाके सहर के नाओं अबीत है।<verse eid="GEN 36:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="GEN 36:36" />हदद की मौत भई। मसरेका नगर के रहन बारे सम्ला मैं बाकी जघा मैं सासन करी।<verse eid="GEN 36:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="GEN 36:37" />सम्ला की मौत भई, फरात नदिया के किनारे के रोहबोत नगर को रहन बारो साऊल बाकी जघा मैं राजा बनो।<verse eid="GEN 36:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="GEN 36:38" />साऊल की मौत भई। कबर को लौड़ा बालहानन बाकी जघा मैं राजा बनो।<verse eid="GEN 36:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="GEN 36:39" />कबर के लौड़ा बालहानन की मौत भई। हदर बाकी जघा मैं राजा बनो। बाके सहर के नाओं पाऊ है। बाकी बईय्यर को नाओं महेटबेल रहै। बौ मेजाहब की नतनिया और मटरेद की लौड़िया रहै।<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />एसाव के वंसजन के मुखियन के नाओं उनके कुल और रहन बारेन की जघा के हिसाब से जे हैं: तिम्नाह, अल्बा, यतेत, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />आहलीबामा, एला, पीनोन, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />कनज, तेमान, मिबसार, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />मग्दीएल, और ईराम। जो देस एदोम बंस के अपने अधिकार मैं कर लई रहैं, बाके रहन बारे जघा के हिसाब से जेईं एदोम के वंसजन के मुखिया एसाव हैं।<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">यूसुफ और बाके भईय्या</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />याकूब कनान देस मै रहत रहै जितै बाको दऊवा रहत रहै। <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />जौ याकूब की वंसावली को लेखा-जोखा है। यूसुफ सत्रै साल को रहै। बौ अपने भईय्या के संग भेड़-बकरिया चुगात रहै। बौ ज्वान रहै। बौ अपने दऊवा की दूसरी बईंय्यरन, बिल्हा और जिल्पा के लौड़न के संग रहत रहै। बौ अपने बे भईय्यन की बुरी बातन की खबर अपने दऊवा के झोने लाए करत रहै।<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />याकूब अपने सब लौड़न से जाधे यूसुफ से प्यार रखत रहै, काहैकि बौ बाके बूढ़ो के समय मैं पैदा भौ रहै। और बौ बाके ताहीं रंग बिरंगो पूरी बाँह बारो एक लम्बो अंगरखा बनबाई। <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />जब यूसुफ के भईय्या देखीं कि बाको दऊवा यूसुफ कै उनसे जाधे प्यार करथै, तौ बे अपने भईय्या से इत्ती बैर करन लगे, कि बासे ढंग से बात भी नाय करत रहैं।<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />एक बार यूसुफ सपनो देखी, और जब बौ अपने भईय्यन कै जाके बारे मैं बताई, तौ बे बासे और भी जाधे नफरत करन लगे। <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />बौ फिर कहथै, “मैं जो सपनो देखा रहौं बाकै तुम सुनौ। <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />हम सब खेत मैं गेहूँ के पुरा बाँधत होथैं, तभई मेरो पूरा उठकै सीध ठाड़ गौ। और तुमरे चारौ घाँईं से एक घेरा बनो और बाके अग्गु झुक गौ।”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />बाके भईय्या यूसुफ से कहीं, “का तैं हमरे ऊपर सासन करैगो? का तैं सई मैं हमरे ऊपर राज्य करैगो?” जौ बजह से बे यूसुफ के सपनो और बाकी बातन की बजह से बासे और जाधे नफरत करन लगे।<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />तौ यूसुफ एक और सपनो देखी, और अपने भईय्यन से कही, मैं आज एक और सपनो देखो हौं, सूरज, जोनी और ग्यारह तारा लोहोक्कै मोकै नमस्कार कर रै हैं।<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />जब बौ अपनो सपनो अपने दऊवा और भईय्यन कै जौ सपनो बताई। तौ बाको दऊवा बाकै झुकाई और बासे कही, “जो सपनो तैं देखो है, बाको मतलब का है? का सचमुच मैं और तेरी अईय्या और तेरे भईय्या तेरे झोने ठाड़ंगे और जमीन के घाँईं लोहोक्कै तोसे नमस्कार करंगे।” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />यूसुफ के भईय्या बासे जलन करन लगे, लेकिन बाको दऊवा जे बातन कै याद रखी।<verse eid="GEN 37:11" /></para>
  <para style="s">यूसुफ कै बेंचो जानो</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />एक दिन यूसुफ के भईय्या अपने दऊवा की भेंड़-बकरिया चुगान के ताहीं सेकेम नगर कै गै। <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />याकूब यूसुफ से कही, तेरे भईय्या सेकेम नगर के मैदान मैं भेंड़-बकरिया चुगाए रै हैं। आ, मैं तोकै उनके पास भेजंगो। यूसुफ अपने दऊवा से कही, मैं तैयार हौं।<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />बौ यूसुफ से कही, “जाएकै देख कि तेरे भईय्या और भेड़-बकरिया ठीक-ठाक हैं की नाय।” उनकी खबर मेरे झोने लईये। याकूब बाकै हेब्रोन की घाटी से भेज दई। जब यूसुफ सेकेम नगर मैं आओ, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />एक आदमी बाकै मैदान मैं भटकत भई पाई। बौ आदमी यूसुफ से पूँछी, तैं का ढूँड़ रौ है?<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />यूसुफ जबाब दई, “मैं अपने भईय्यन की ढूँड़ रौ हौं, जो अपनी भेंड़-बकरियन कै चुगाए रै हैं।” “का तैं मोकै बताए सकथै कि बे कहाँ हैं?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />बौ आदमी कही, “बे तौ पहलिये हिंयाँ से जाए चुके हैं। मैं उन्हैं जौ कहत सुनो रहौं कि बे दोतान जाए रहै हैं।” तौ यूसुफ अपने भईय्यन के पिच्छू गौ और उन्हैं दोतान मैं पाई।<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />भईय्या बाकै दूर से देखी, और जासे पहले कि बौ उनके झोने ले पहोंच पातो, बे बाके खिलाप साजिस बनाई और बाकै मार डारन को मन बनाईं। <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />बे एक दुसरे से कहीं, “बौ सपनो कै देखन बारो हिंयाँ आएरौ है। <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />अब आबौ, हम बाकै मारकै कोई गड्डा मैं फेंक देमैं। हम घर जाएकै कह देंगे कि बाकै जंगली जानवर खाएगौ। तौ हम देखंगे कि बाके सपनो भविस्य मैं कैसे पूरे होथैं।”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />रूबेन जब उनकी बात सुनी तौ बौ यूसुफ कै बचान की कोसिस करथै। बौ उनसे कहथैं, “आबौ आपन बाकै ना मारैं।” <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />“रूबेन उनसे कही, खून मत बहाबौ, पर बाकै निर्जन प्रदेस के जौ गड्डा मैं फेंक दियौ। बाकै चोट मत पहुचाबौ।” बौ उनके हाथ से यूसुफ कै छुड़ाएकै दऊवा के झोने पहुचानो चात रहै। <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />जब यूसुफ अपने भईय्यन के झोने पहोंचो, तौ बे बाको रंग बिरंगे पूरी बाँह को लम्बो चोंगा फाड़ दईं। <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />तौ बे बाकै लै जाएकै सूखे कुआँ मैं फेंक दईं।<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />जब बे खानु खान कै बैठे, जब बे अपनी आँखी ऊपर उठाईं तौ उनकै इस्माएली को एक झुंग दिखाई दई, जो गिलाद के घाँईं से आत रहै। बे अपने ऊँटन मैं मसाला, बाम और गंधरस लदे भै मिस्र देस मैं जात रहैं। <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />यहूदा अपने भईय्यन से कही, “अगर आपन अपने भईय्या कै मार डारैं, और बाकी हत्या कै लुकामैं, तौ हमैं का फायदा होगो? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />आबौ, आपन जाकै जे इस्माएली लोगन कै बेंच देथैं। तौ आपन कै बाकै चोट पहोंचान ना पड़ैगो; काहैकि, बौ हमरो भईय्या है, हमारो अपनो माँस है।” तौ बाके भईय्या जौ बात मैं राजी ही गै। <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />और जब कुछ मिद्दानी ब्यापारी हूँना आथैं, तौ बाके भईय्या यूसुफ कै कुआँ से बाहर निकारीं और बाकै इस्माएली कै बीस चाँदी के सिक्का मैं बेंच देथैं, जो फिर बाकै बे मिस्र मैं लै चले जाथैं।<note caller="+" style="f"><char style="fr" closed="false">37:28 </char><char style="ft" closed="false">प्रेरि 7:9</char></note><verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />जब रूबेन कुआँ के झोने बापस आओ और देखी कि यूसुफ हूँना नाय है, तौ बाकै भौत दुख होथै और जहे बजह से बौ अपने लत्ता फाड़थै। <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />रूबेन अपने भईय्यन के झोने लौटौ। और उनसे कही, “लौड़ा तौ हूँना नाय है! मैं अब कहाँ जामौं?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />तौ बे एक बकरा कै मारकै और बाके खून मैं यूसुफ के लत्ता डुबोईं। <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />बाके बाद, बे जौ रंग बिरंगे चोंगा कै अपने दऊवा के झोने भेजीं और कहीं, “हमैं जौ मिलो। का जौ तेरे लौड़ा को तौ नाय है?”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />बौ जे लत्ता कै पहचान लई और कही, “हाँ, जौ बहे को है!” कोई जंगली जानवर बाकै मार डारी है, और मेरे लौड़ा यूसुफ के टुकड़ा- टुकड़ा कर दई होगो! <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />याकूब अपने लत्ता फाड़ी, और बौ कमर मैं चमड़ा को लत्ता लपेटी, और भौत दिल ले अपने लौड़ा के ताहीं सोक मनाई। <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />बाके सब लौड़ा और लौड़िया बाकै दिलासा देन की कोसिस करथैं, लेकिन उनके दिलासा देन से भी बाको मन सांत नाय होथै और उनसे कहथै, “मैं अपने लौड़ा के ताहीं सोक करत भै मरे लोगन की दुनिया मैं चले जांगो।” और तौ बौ अपने लौड़ा यूसुफ के ताहीं सोक करत रहथै।<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />उतै, मिस्र मैं मिद्दानी ब्यापारी यूसुफ कै मिस्र देस मैं राजा फिरौन पोतीपर नाओं के एक अधिकारी कै बेंच दई, पोतीपर अंगरक्छकन को सरदार रहै।<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">यहूदा और तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />बहे समय मै यहूदा अपने भईय्यन कै छोड़कै हीरा नाओं के एक आदमी के झोने रहन चले गौ, जो बौ अदुल्लाम सहर को होथै। <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />हुँआँ यहूदा एक कनानी आदमी की लौड़िया कै देखी। बौ आदमी को नाओं सूआ रहै। यहूदा सूआ की लौड़िया से बिहा कर लई। फिर बौ बाके संग सारीरिक संबंध बनाई। <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />और बासे एक लौड़ा पैदा भौ, और बौ बाको नाओं एर रखी। <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />बौ फिर गर्भवती भई और बौ एक और लौड़ा कै जनम दई और बौ बाको नाओं ओनन रखी। <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />बाको फिर एक और लौड़ा पैदा भौ बौ बाको नाओं सेला रखी। जब बाके लौड़ा को जनम भौ तौ बौ समय यहूदा कजीब सहर मैं रहत रहै।<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />तौ यहूदा अपनो पहलो लौड़ा एर को तामार नाओं की बईय्यर से बाको बिहा कर दई। <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />यहूदा के लौड़ा एर को चाल-चलन भौत बुरो रहै, तौ प्रभु बासे ना खुस भौ, जौ बजह से प्रभु बाकै मार डारथै। <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />तौ यहूदा एर के भईय्या ओनन से कही, “जा और अपने भईय्या की बिधवा के झोने सारीरिक संबंध बना। और दुईरा होन को कर्म पूरो कर, तू अपने भईय्या के ताहीं बंस पैदा कर।” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />लेकिन ओनन जौ ताब जानत रहै, कि तामार से पैदा भै वंस बाको अपनो का कहो जागो। जौ बजह से बौ अपने भईय्या की बईय्यर के संग सारीरिक संबंध बनाई, और बाकै गर्भ धारड़ ना करी, जोसे बौ अपने मरे भै भईय्या को वंस नाय बढ़ाए सकै। <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />बाके ऐसो काम करन से प्रभु बासे खुस ना भौ, और प्रभु बाकै भी मार डारथै। <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />तौ यहूदा अपनी बहु तामार से कही, अपने दऊवा के घरै लौट जा, और जब ले मेरो लौड़ा सेला बड़ो न ही जाबै तौ ले तैं बिधवा बनी रहै। बौ ऐसो जहेमारे कही, काहैकि बाकै डर रहै कि सेला भी बाके भईय्यन के तराहनी मार दौ जागो। तौ तामार घरै बापस चले गौ।<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />कुछ समय बीतन के बाद, सूआ की लौड़िया मतलब यहूदा की बईय्यर मर गई। बौ अपनी बईय्यर को सोक मनाई। जब सोक के दिन खतम भै और बाकै आराम मिलो, तौ बौ अपने अदुल्लामी दोस्त हीरा के संग तिम्नाह नगर गौ, जहाँ बाकी भेंड़-बकरियन के ऊरन कतरन बारे रहत रहैं। <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />और कोई तामार कै बताई, कि तेरो सुसर अपनी भेंड़-बकरियन को ऊन कतरन के ताहीं तिम्नाह नगर जाए रौ है। <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />तामार बिधवा के लत्ता उतार दई। बौ दुसरे लत्ता पहनी और अपनो मोहों घुँघटा से तोप लई, और बौ तिम्नाह के रस्ता मैं एनैम नगर के अंदर घुसन बारे फाटक मैं बैठ गई। तामार देखी कि बाको दुईरा सेला ज्वान हुई गौ है; पर बाके संग बाको बिहा नाय करो गौ।<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />जब यहूदा बाकै देखी, तौ बौ सोची कि बौ एक छिनरईया है, काहैकि बौ अपनी सकल लुकाए होथै। <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />बौ रस्ता किनारे बाके झोने गौ, बौ तामार से कही, “मोकै अपने संग सारीरिक संबंध बनान दे।” यहूदा नाय जानत रहै कि बौ बाकी बहू है। तामार बोली, “अगर मैं तोकै अपने संग सारीरिक संबंध बनान दियौं, तौ तैं मोकै का देगो?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />यहूदा जबाब दई, “मैं तोकै अपने झुंग मैं से एक बकरिया को बच्चा पनार देंगो।” तामार कहथै, “ठीक है, जबले तैं बाकै भेजैगो, तौले तैं का मोकै गिरमी के तौर मैं कुछ दै सकथै?”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />यहूदा पूँछी, “मैं तोए गिरवी के रूप मैं का देमौं?” तामार जबाब दई, तेरी मुहर, गले की डोरी और तेरे हाथ को डंडा। यहूदा जे सब चीज बाकै दै दई। और फिर बौ बाके संग सारीरिक संबंध बनाई। और तामार बारे पेट से भई। <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />तामार घरै जाएकै अपनो घुँघटा उतार दई, और फिर से बिधवा के लत्ता पहन लई।<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />यहूदा अपने अदुल्लामी दोस्त हीरा के हाथ बकरिया को बच्चा भेजी कि बौ वैस्या के हाथ से गिरवी बारी चीज छुड़ाए लाबै। पर बौ बाकै ना मिली। <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />तौ हीरा हुँआँ के लोगन से पूँछी, “एक वेस्या एनैम जो सड़क के टिकारे रहथै कितै है?” बे जबाब दई, “हिंयाँ तौ कोई वेस्या न रहथै।”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />तौ बौ यहूदा के झोने लौटकै कही, “मोकै बौ ना मिली। और बौ जघा के लोग भी कहीं, हिंयाँ तौ कोई वेस्या ना रहथै।”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />फिर यहूदा कही, जे सब गिरवी छुटान बारी चीज अपने पास रखले। ना तौ हिंयाँ के लोग हमरो मजाक उड़ंगे। मैं बाको हिसाब करनो चाहथौं। जौ बजह से मैं जौ बकरिया को बच्चा भेजो रहौं, पर बौ तोकै ना मिली।<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />लगभग तीन महेना के बाद यहूदा कै जौ खबर मिली, “तेरी बहु तामार व्यभिचार करी है और जहे के जरिया बौ गर्भवती हुई है।” यहूदा आग्या देथै, “बाकै बाहर निकारौ और जलाए कै मार डारौ।”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />जब बाकै बाहर निकारो जात रहै, तौ बौ अपने सुसर कै खबर भेजी: “मैं बौ आदमी से गर्भवती भौ हौं, जोके झोने जे चीज हैं। उन्हैं देखौ और पहेचानौ कि बे कौन की हैं - डोरी समेत मुहर और जौ लठिया।”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />यहूदा इन्हैं पहचान लई और कही, “बौ सई कह रही है, मैं अपनो कर्तव्य पूरो करन मैं असफल रहो हौं - मोकै बाको बिहा अपने लौड़ा सेला से कर देने रहै।” और यहूदा बाके संग फिर कहुए संबंध नाय बनाई।<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />जब बाके बालका को जनम देन को समय आओ तौ पता चलो कि बाके जुड़वा बालका होन बारे हैं। <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />जब बौ बालका कै जनम देत रहै, तौ तक बालका हाथ बाहर निकारी। दैबुढ़िया बाको हाथ पकड़ी और बामैं एक लाल डोरा बाँधकै कही, “जौ कोक से पहले बाहर निकरो।” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />लेकिन जब बालका अपनो हाथ भीतर कर लई तौ बाको भईय्या बाहर निकरो। दैबुढ़िया कही, “अरे! तैं तौ खुदै निकरन की रहा बनाएलौ। जौ बजह से बाको नाओं ‘पेरेस’ रखो गौ।” <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />फिर बाके जनम के बाद बाके भईय्या जोकै हाथ मैं लाल डोरा बंधो रहै, कोक से बाहर निकरो। बाको नाओं जेरह रखो गौ।<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">यूसुफ और पोतीपर की बईय्यर</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />इस्माएली लोग यूसुफ कै मिस्री मैं लै जाएकै पोतीपर कै जो फिरौन राजा को अधिकारी होथै, और जो महल के सिपईयन को सरदार होथै, बाके हात बेंच दईं। <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />प्रभु यूसुफ के संग रहै और बौ बाकै कामयाब बनाईं। बौ अपने मिस्री मालिक के घरै रहत रहै,<note caller="+" style="f"><char style="fr" closed="false">39:2 </char><char style="ft" closed="false">प्रेरि 7:9</char></note> <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />जो भी देखी, कि प्रभु यूसुफ के संग है, और जो कुछ बाके संग करथै बामै बाकै कामयाब करी है। <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />पोतीपर खुस भौ और बाकै अपनो निजी सेवक बनाए लई; तौ बौ यूसुफ कै अपनो घर को और अपनी सब जायदाद को अधिकारी ठहराई। <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />जो दिन से पोतीपर बाकै अपने घर को देखा-भारी करन बारो अधिकारी बनाई, और बाके हाथ मैं सब कछु अपनो सौंपी, बौ समय से प्रभु यूसुफ के बजह से बौ मिस्री के घर कै आसीस दई। बाके घर और खेत की हर एक चीज मैं आसीस होन लगी। <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />तौ पोतीपर अपनो सब कुछ देखरेख के ताहीं यूसुफ कै सौंप दई और अपने खान की चीज के अलावा कोई और चीज मैं चिंता नाय करी। यूसुफ तंदुरूस्त और सुगड़ रहै। <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />और कुछ समय के बाद बाके मालिक की बईय्यर यूसुफ कै मन से लगान लगथै, और बासे बिनती करन लगी, कि बौ मेरे संग सारीरिक संबंध बनाबै। <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />यूसुफ मना करत भई अपने मालिक की बईय्यर से कही, “देख, मेरे मालिक घर के बारे मैं कछु नाय जानथै। जो कछु बाके पास है, बौ बाकै मेरे हाथ मैं सौंप दई है। <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />जौ घर मैं मेरो उत्तो ही अधिकार है जित्तो कि बाको, और बौ तेरे अलावा मोसे ऐसी बात कहुए नाय करी। फिर मैं परमेस्वर के खिलाप कैसे पाप कर सकथौं?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />फिर बौ हर दिन यूसुफ से पूँछत रहती, कि बौ बाके संग सोबै, बाके संग रहबै, लेकिन यूसुफ बाकी बात ना सुनी।<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />लेकिन एक दिन जब यूसुफ अपनो काम करन के ताहीं घरै गौ, तौ घर को कोई भी आदमी हूँना नाय होथै। <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />तौ पोतीपर की बईय्यर यूसुफ के लत्ता पकड़ लई और बासे कही, मेरे संग सो। पर यूसुफ अपनो लत्ता बाके हाथ से छुड़ाएकै भाजो और घर से बाहर निकर गौ। <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />जब पोतीपर की बईय्यर देखी कि यूसुफ अपने लत्ता बाके हाथ से छुटाएकै घर से बाहर निकर गौ है, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />तौ बौ अपने घर के आदमियन कै बुलाई और उनसे कही, “इब्रानी सेवक कै देखौ। बाकै मेरो स्वामी हमरी बेजती करन ताहीं लाई है। बौ इब्रानी मेरे संग सारीरिक संबंध बनान के ताहीं मेरे झोने आओ रहै। पर मैं ऊँची आवाज मैं चिल्लान लगो। <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />जब बौ मेरी चीख सुनी तौ बौ अपनो चोंगा मेरे झोने छोड़कै घर से दुआरे भाज गौ।”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />जब ले यूसुफ को मालिक घरै नाय आओ तौ ले बौ बाको लत्ता अपने झोने रखे रही। <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />बौ अपने स्वामी से भी जहे कही: “जो इब्रानी सेवक कै तैं हिंयाँ लाओ रहै, बहे मेरे कमरा मैं आओ और मेरो निरादर करी।” <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />लेकिन जब मैं चिल्लाओ तौ बौ अपनो चोंगा मेरे झोने छोड़कै भाज पड़ो।<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />जब यूसुफ को स्वामी अपनी बईय्यर के जे सब बात सुनी, तेरो सेवक मेरे संग ऐसो बर्ताव करी है, तौ बौ भड़क उठो। <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />और यूसुफ कै पकड़ बाए कै बाकै कैदखाना मैं डरबाए दई, जितै राजा के कैदी बन्द रहैं, और बौ बहे मैं रहन लगो। <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />लेकिन प्रभु यूसुफ के संग रहै और बाकै करूड़ा करी, हिंयाँ ले कि कैदखाना को अधिकारी बासे खुस भौ। <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />बौ यूसुफ कै हूँना को प्रभारी बनाई और कैदखाना मैं जो भी काम होतो बाकी जिम्मेदारी बाके झोने रहै। <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />कैदखाना की देखरेख करन बारे कै ऐसी कोई भी चीज की देखरेख नाय करन पड़त रहै, बाकी जिम्मेदारी यूसुफ के झोने होथै, काहैकि प्रभु यूसुफ के संग रहै और बौ बाकै सब काम मैं कामयाबी दई।<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">यूसुफ को सपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />कुछ समय बाद मिस्र के राजा कै दाखरस को भंडारी और बाको खास खानु को भंडारी राजा के विरोध मैं पाप कर दई। <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />राजा जे दोनों अधिकारिन से गुस्सा होथै <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />और प्रधानअधिकारी इनकै कैदखाना मैं डरबाए दई, जहाँ यूसुफ होथै। <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />बे कुछ दिन कैदखाना मैं गुजारीं और कप्तान यूसुफ कै उनको नौकर के काम ताहीं अधिकारी चुनीं।<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />एक रात मिस्र देस के राजा के कैदखाना मैं दाखरस को भंडारी और खानु को भंडारी दोनों एक सपनो देखीं, और सपनो को अलग-अलग मतलब होथै। <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />भोर कै जब यूसुफ उनके झोने आओ, तौ का देखथै, कि बे दोनों उदास हैं। <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />राजा अधिकारी उनसे पूँछी, “आज तुम इत्ते उदास काहे हौ?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />बे जबाब दईं, “आज रात हम दोनों एक सपनो देखे, और हिंयाँ कोई जौ बतान बारो नाय है कि सपनो को मतलब का है।”</para>
  <para style="p" vid="GEN 40:8">यूसुफ कही, का जौ सच नाय है कि सपने को मतलब समझनो केबल परमेस्वर को काम है? दयाकरकै “मोकै अपने सपनो के बारे मैं बताबौ।”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />तौ दाखरस को भंडारी यूसुफ से कही, “मेरे सपनो मैं मेरे अग्गु एक अंगूर की लार रहै <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />जोमैं तीन लार हैं जैसिये बामै से कन्ति निकरीं, फूला आए और बाके गुच्छा मैं अंगूर लगकै पक गै। <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />मेरे हात मैं राजा को प्यालो रहै; तभई मैं अंगूर लौ, और प्यालो मैं निचोड़कै बाकै हात मैं दै दई।”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />यूसुफ कही, “जाको मतलब जौ है: तीन लार तीन दिन हैं। <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />तीन दिन मैं राजा तुम्हैं रिहा कर देगो, तुमकै माफ कर देगो और तुमरे पद लौटाए देगो। तुम बाकै बाको प्यालो बैसिये बनाएकै देगे जैसे तुम पहले देत रहौ जब तुम बाके दाखरस के भंडारी रहौ। <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />लेकिन जब तुमरे संग सब कुछ अच्छो पहलिये तराहनी चलन लग जाबै तौ महरबानी करकै मोकै जरूर याद करियो, और महरबानी करकै राजा के अग्गु मेरो जिकर करियो और मोकै जौ कैदखाना से बाहर निकारन मैं मेरी मदत करियो। <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />काहैकि, मोकै इब्रानी देस से अगवा करकै लाईं हैं, और हिंयाँ मिस्र मैं ऐसो काम भी नाय करो जिस बजह से मोकै कैदखाना मैं डारो जातो।”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />जब खानू पकान को मुखिया देखी, कि दाखरस के भंडारी के सपनो को फल अच्छो निकरो है, तौ बौ यूसुफ से कही, मैं भी एक सपनो देखो हौं; कि मेरी मुड़िया मैं तीन रोटी की छपरिया हैं। <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />ऊपर की छपरिया मैं राजा के ताहीं सब तराहनी की पकी भई चीज रहैं, और पक्छी उनकै खात होथैं।<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />यूसुफ जबाब दई, “जाको मतलब जौ है: तीन छपरिया तीन दिन हैं। <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />तीन दिन मैं राजा तुम्हैं रिहा कर देगो और तुमरी मुड़िया काट देगो! और बौ तेरे सरीर कै खम्मा मैं लटकाए देगो, और पक्छी तेरो माँस नोचकै खामंगे।”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />तीन दिन बाद राजा अपने जनमदिन मैं अपने सब अधिकारियन कै पनार दई; और बौ अपने दाखरस के भंडारी और खास खानू पकान बारे कै रिहा कर दई, और उन्हैं अपने कर्मचारियन के सामने लाई। <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />राजा दाखरस के प्रधान कै बाको पहले को पद दै दिया, ताकि बौ देन लगै। <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />लेकिन बौ खास खानू पकान बारे कै मारकै टंगवाए दई। जौ सब बैसिये भौ जैसो यूसुफ कही रहै। <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />लेकिन दाखरस को प्रधान यूसुफ के बारे मैं कुछ याद नाय रखी - बौ बाके बारे मैं सब कुछ भूल गौ।<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">यूसुफ को फिरौन राजा के सपनो को मतलब बतानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />दुई साल बीतन के बाद मिस्र को राजा एक सपने मैं देखी, कि बौ नील नदिया के किनारे खड़ो है। <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />जब सात मोटी-ताजी गईंय्या नील नदिया से निकरकै घाँस चुगन लगथैं। <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />उनके पच्छू सात दुबली और देखन मैं हड्डीदार गईंय्या नील नदिया से बाहर निकरीं। बे नदिया के घाट मैं दुसरी गईंय्यन के किनारे ठाड़ गईं। <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />और कमजोर गईंय्या मोटी-ताजी गईंय्यन कै खाए लईं। तभई राजा की नींद खुल गई। <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />बौ फिर सोए गौ और एक और सपनो देखी। एक डंठर मैं अनाज की सात भरी भई और पकी भई बाली निकरीं। <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />फिर सात और पतरी अनाज की बाली निकरीं, जो पुर्वईया ब्यार से भुरसी भई रहैं, <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />और अनाज की पतरी बाली, मोटी और भरी बाली अनाज की बालिन कै निगल गईं। फिर राजा जग जाथै और बाकै एहसास भौ कि बौ सपनो देखरौ है। <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />सुबेरे कै बौ चिंता मैं पड़ जाथै, और तभई राजा मिस्र के सब जादूगर और पंडितन कै बुलबाई। फिर बौ उन्हैं अपने सपनो के बारे मैं बताई, लेकिन कोई भी बाकै नाय बताए सको।<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />फिर दाखरस को भंडारी राजा से कही, “मैं आज अंगीकार करथौं कि मैं पाप करो हौं। <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />बौ राजा से कही तू भंडारी के प्रधान और मेरे ऊपर गुस्सा करो, और हमैं जल्लाद के प्रधान के घरै कैदखाना मैं डरबाए दौ रहै। <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />एक रात हम दोनो एक-एक सपनो देखे, और सपनो को अलग-अलग मतलब रहै। <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />और हूँनै हमरे संग एक जुआन इब्रानी रहै, जो जल्लाद के प्रधान को सेवक रहै। हम बाकै अपनो सपनो बताए और बौ हमैं सपनो को मतलब बताई। <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />जैसो बौ कही रहै बैसिये ही भौ: तू मोकै मेरे पद मैं बहाल करदौ, लेकिन तैं मोकै मेरे पद मैं बहाल करदौ, लेकिन तैं भंडारी कै लटकाए दौ।”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />तौ फिरौन राजा दूत कै पनारकै यूसुफ कै बुलबाई, और बाकै तुरन्तै कैदखाना से निकारो जाथै। और बौ दाढ़ी बनाई और अपने लत्ता बदली, फिर तभई बौ राजा के सामने आओ। <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />राजा बासे कही, “मैं एक सपनो देखो हौं और बाको मतलब मोकै कोईये नाय बता पाओ। मोकै बताओ गौ है कि यूसुफ तैं सपनो को मतलब बताए सकथै।”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />यूसुफ जबाब दई, “मैं ना जानथौं, महाराज! लेकिन परमेस्वर के झोने तेरे मुताबिक बाको जबाब है।”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />फिरौन<note caller="+" style="f"><char style="fr" closed="false">41:17 </char><char style="ft" closed="false">मिस्र के सब राजन कै फिरौन नाओं से पुकारो जात रहै</char></note> यूसुफ से कही, मैं एक सपनो मैं देखो, कि मैं नील नदिया के टिकारे ठाड़ो हौं। <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />जब सात मोटी और ताजी गईंय्या नील नदिया से निकरकै घाँस चुगन लगीं। <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />फिर सात और भी गईंय्या निकरीं जो हड्डीदार और पतरी रहैं। बे सबसे कुरूप गईंय्या रहैं जो मैं मिस्र मैं कहुए नाय देखो रहौं। <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />दुबली और हड्डीदार गईंय्या पहले की सात मोटी-ताजी गईंय्यन कै खाए लईं, <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />पर जब बे उनकै खाए चुकीं, तौ कोई कै ऐसो ना लगत रहै कि बे उनकै खाई हैं; काहैकि जैसी बे पहले दिखात रहैं; बे अभईयो बैसिये रहैं। तौ मैं जग्गौ। <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />मैं एक और सपनो देखो, कि मैं एकै ड़ुंठर मैं सात भरी और पकी भई अनाज की बाली निकरत भै देखो। <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />फिर अनाज की सातौ बाली पतरी और पुर्वईया ब्यार से भुरसी भई निकरीं, <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />और अनाज की पतरी बाली पूरे अनाज कै निगल गईं। मैं जादूगरन कै सपनो के बारे मैं बताओ, लेकिन उनमैं से कोई भी मोकै जाको मतलब नाय बताए पाई।<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />तौ यूसुफ राजा से कही, “दोनों सपनो को मतलब एकै है; परमेस्वर तोए बताए दई है कि बौ का करनो चाहथै। <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />सात अच्छी गईंय्या सात साल की हैं, और सात अच्छी बाली सात साल की हैं; जौ एकै सपनो को मतलब है। <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />जाके बाद जो सात दुबली-पतरी गईंय्या निकरीं, बे सात साल की रहैं, और बे बुरी गईंय्या जो रेगिस्तानी ब्यार से भुर्स गईं रहैं बे भी अकाल के सात साल हैं।<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />राजा कही जौ बैसिये है जैसो मैं तोसे कहो रहौं-परमेस्वर तुम्हैं दिखाई है कि बौ अग्गु का करन बारो है। <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />पूरे मिस्र देस मैं सात साल ले भौत अगरो अन्न पैदा होगो, <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />लेकिन उनके पच्छू सात साल को अकाल पड़ैगो। और मिस्र देस के अच्छे दिन की उपज को भुलाए दौ जागो। अकाल देस कै खाए जागो। <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />बहो तेरो समय पूरी तरह भुलाओ दौ जागो, काहैकि बाके बाद आन बारो अकाल भौत भयानक होगो। <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />फिरौन को सपनो दुई बार आन की बजह जौ है कि परमेस्वर अपनो इरादा पक्को कर लई है, और जाकै जल्दिये करैगो।<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />और अब फिरौन एक समझदार और बुद्धिमान इंसान ढूंढकै बाकै मिस्र देस मैं अधिकारी चुनै। <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />फिरौन राजा तुरन्त अधिकारिन कै चुनै। ताकि बे मिस्र देस के बहोतेरी के सात साल की उपज मैं से पाँचमों भाग लेमैं। <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />और आन बारे अच्छे साल के चलते सारो खानू इकट्ठो करन को राजा हुकम देबै, और सहर मैं अनाज जमा और बाकी रक्छा करन को अधिकार देबै। <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />मिस्र मैं आन बारे सात साल के अकाल के चलते खानू देस के ताहीं कम नाय पड़ैगो, ऐसे करकै लोग भूंक से न मरंगे।”<verse eid="GEN 41:36" /></para>
  <para style="s">यूसुफ कै मिस्र को राज्यपाल बनाओ जानो</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />राजा और बाके अधिकारी जौ योजना कै मंजूरी दै दईं। <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />और राजा बासे कही, “हम कै यूसुफ से अच्छो इंसान, मतलब जोमैं परमेस्वर को आत्मा है, बाके अलावा हमैं कोई आदमी नाय मिलैगो।” <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />राजा यूसुफ से कही, “परमेस्वर तोए जौ सब दिखाई है, तभई जौ साफ होथै कि तेरे पास कोई और की तुलना मैं जाधे समझदार, बुद्धिमान और सर्व ग्यानी है। <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />मैं तोकै अपने देस को अधिकारी बनांगो, और मेरे सब लोग तेरी आग्या कै मानंगे। और खाली राजगद्दी के सिंहासन मैं तोसे बड़ो रहेंगो। <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />फिर फिरौन राजा यूसुफ से कही, देख, मैं तोकै पूरे मिस्र को राज्यपाल घोसित करथौं।” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />तौ राजा अपनी उँगरिया से पुसतैनी मोहर लगी अंगूठी निकारी और यूसुफ की उँगरिया ऊपर रख दई। बौ बाकै बढ़िया मलमल को चोंगा पहनाईं, और बाके गले मैं सोने की माला डार दई।<note caller="+" style="f"><char style="fr" closed="false">41:42 </char><char style="ft" closed="false">दानी 5:29</char></note> <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />बौ बाकै सबारी करन के ताहीं दुसरो पुसतैनी रथ दई, और बाको सम्मान करन ताहीं सिपईय्या अग्गु जाएकै चिल्लात गौ, “रस्ता बनाबौ!” और ऐसे करकै पूरे मिस्र को राज्यपाल चुनो गौ। <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />फिरौन यूसुफ से कही, मैं मिस्र देस को राजा फिरौन न हौं, और पूरे मिस्र मैं तेरी आग्या के बगैर तेरे ऊपर कोई हात नाय छोड़ैगो। <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />फिरौन राजा यूसुफ कै मिस्री नाओं साफनत पानेह रखी, और बौ बाकै एक बईय्यर दई, जोको नाओं आसनत था, जो ओन नगर के पुजारी पोतीपर की लौड़िया होथै।<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />जब यूसुफ मिस्र के राजा फिरौन की सेवा करन लगो, तौ बौ तीस साल को रहै। फिर बौ राजा को दरबार छोड़कै पूरे देस मैं घूमन लगो। <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />और फिर अच्छे दिन के सात सालन मैं जमीन बहोतेरी मात्रा मैं अन्न पैदा होन लगो, <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />और सब अन्न यूसुफ इकट्ठो करकै मिस्र सहर मैं रखबाए दई। और हर एक सहर के चारौ घाँईं के खेतन से अनाज जमा करन लगो। <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />हूँना इत्तो अनाज ही गौ कि यूसुफ बाकै मापनो बंद कर दई - जौ समुद्र की रेता के जैसो रहै।<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />ओन नगर मैं अकाल को साल आन से पहले, पुजारी पोतीपर की लौड़िया आसनत से यूसुफ के दुई लौड़ा भै। <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />यूसुफ कही, “परमेस्वर मेरे सब कस्ट और मेरे दऊवा के पूरे परिवार कै भुलबाए दई है” तभई बौ अपने पहले लौड़ा को नाओं मनस्से रखी। <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />बौ जौ कही, “परमेस्वर मोकै बिपत्ति की जमीन मैं फलवंत करी है” जौ बजह से बौ अपने दुसरे लौड़ा को नाओं एप्रेम रखी।<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />मिस्र देस के सात साल के अच्छे दिन खतम ही जाथै। <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />और यूसुफ के कहने के मुताबिक सात साल को अकाल सुरु भौ। और भी देस मैं अकाल होथै, लेकिन पूरे मिस्र मैं खानू की कोई कमी न रहै। <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" /><note caller="+" style="f"><char style="fr" closed="false">41:55 </char><char style="ft" closed="false">प्रेरि 7:11 यहु 2:5</char></note>जब मिस्र देस मैं भी अकाल पड़ो, तौ प्रजा अन्न के ताहीं फिरौन राजा कै दोहाई दईं। फिरौन राजा मिस्र मैं रहन बारेन से कही, यूसुफ के झोने जाबौ। जो कछु बौ तुमसे कहबै, बहे करियो। <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />अकाल पूरे देस मैं फैल जाथै, तौ यूसुफ सब भंडार खोल दई और मिस्रियन कै अनाज बेंच दई। <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />यूसुफ से अनाज मोल लेन के ताहीं पूरी दुनिया से लोग मिस्र आत रहैं, काहैकि सब जघा मैं भयंकर अकाल पड़ो रहै।<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">यूसुफ के भईय्यन को मिस्र मैं आनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />जब याकूब कै पता चलो कि मिस्र मैं अनाज है, तौ बौ अपने लौड़न से कही, “तुम कुछ काहे न करथौ? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />मैं सुनो हौं, कि मिस्र देस मैं अनाज है। तुम हुँआँ जाबौ, और आपन ताहीं अनाज मोल लै आबौ, जोसे आपन भूँख से मरैं नाय बल्किन जिंदे रहमैं।” <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />जौ बजह से यूसुफ के दस सौतेलो भईय्या मिस्र मैं अनाज मोल लेन कै गै। <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />पर यूसुफ के भईय्या बिन्यामीन कै याकूब जौ सोचकै बाके भईय्यन के संग ना भेजी, काहैकि बाकै डर रहै कि कहीं बाकै कुछ ही ना जाबै।<verse eid="GEN 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 42:5" />याकूब को लौड़ा और भी लोगन के संग अनाज मोल लेन कै आओ रहै, काहैकि कनान देस मैं अकाल पड़ो रहै। <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />यूसुफ, मिस्र देस को राज्यपाल रहै, बौ दुनिया भर के लोगन कै अनाज बेंचत होथै। तौ यूसुफ के भईय्या आए, और जमीन मैं मोहो के बल गिरकै बाके अग्गु नमस्कार करीं। <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />जब यूसुफ अपने भईय्यन कै देखी, तौ बौ उन्हैं पहचान लई, लेकिन उनके संग ऐसो बर्ताव करी कि बौ उन्हैं नाय जानथै। बौ उनसे कर्रो दिल करकै पूँछी, “तुम कहाँ से आए हौ?” बे जबाब दईं, “हम कनान से अजान खरीदन आए हैं।”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />जहाँ पर यूसुफ अपने भईय्यन कै पहचान लेथै, लेकिन बे बाकै नाय पहचान पाथैं। <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" /><note caller="+" style="f"><char style="fr" closed="false">42:9 </char><char style="ft" closed="false">उत्प 37:5,10</char></note>यूसुफ कै बहे सपनो याद आथै जो बौ उनके बारे मैं देखी रहै और कही, “तुम मुखबिर हौ; तुम जौ पता लगान कै आए हौ कि हमरो देस कहाँ से कमजोर है।”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />“बे बासे कहीं नाय, स्वामी,” जबाब मै दईं। “हम तेरे सेवक अनाज मोल लेन आए हैं। <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />हम सबै एकै दऊवा के लौड़ा हैं। हम मुखबिर नाय हैं स्वामी, हम इमानदार आदमी हैं।”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />यूसुफ उनसे कही, “न! तुम जौ पता लगान आए हौ कि हमरो देस कहाँ से कमजोर है।”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />बे कहीं, “स्वामी, हम सब बारह भईय्या रहैं, और कनान देस मैं एकै आदमी के लौड़ा हैं। हमरो एक भईय्या मर चुको है, और हबै अब सबसे छोटो भईय्या हमरे दऊवा के झोने है।”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />यूसुफ उन्हैं जबाब दई, “मैं तुम्हैं अग्गु से ही बताए दौ रहौं कि तुम मुखबिर हौ।” <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />अब तुमरो इम्तिहान होगो: मैं राजा फिरौन की कसम खाएकै कहथौं कि जब ले तुमरो सबसे छोटो भईय्या हिंयाँ नाय आए जाथै, तुम हिंयाँ से न जाए सकथौ। <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />तुम मैं से कोई एक जाएकै बाकै लै आबौ। बाकी तुम सब बचे लोगन कि निगरानी, तौ ले रखी जागी जबले कि जो तुम बताए बाकी सच्चाई की जाँच न ही जाबै। न तौ, राजा फिरौन की जिन्दगी की कसम तुम मुखबिर हौ। <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />और बौ उनकै तीन दिन के ताहीं कैदखाना मैं डार दई।<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />तिसरे दिन यूसुफ उनसे कही, “मैं परमेस्वर को डर मानन बारो आदमी हौं, और एक सर्त मैं तुमरी ज्यान बच सकथै। <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />जौ साबित करन के ताहीं कि तुम इमानदार हौ, तुम मैं से एक कै बहे कैदखाना मैं रहन होगो जहाँ तुम हौ; तुम मैं से बाकी लोग जाए सकथौ और जो अनाज तुम खरीदे हौ बाकै अपने भूंके परिवार के झोने लैजाए सकथौ। <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />फिर तुम्हैं अपने सबसे छोटो भईय्या कै मेरे झोने लानो होगो। जासे साबित ही जागो कि तुम सच बोलरै हौ, और मैं तुम्हैं मौत की सजा नाय दुंगो।” तौ बे बैसोई करीं। <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />और एक दुसरे से कहन लगे, हाँ, सचमुच जो कछु हम अपने भईय्या के संग करे, बाको फल अब हम भुगत रै हैं; हम देखे कि बौ कित्ती बड़ी मुसीबत मैं रहै, जब बौ दया की भीख माँगी, तौ आपन बाकी एक नाय सुने। जौ बजह से आपन अब जौ मुसीबत मैं हैं।<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />रूबेन कही, “मैं तुमसे कहो रहो कि लौड़ा कै नुकसान मत पहोंचाबौ, लेकिन तुम नाय सुने। और अब हमैं बाकी मौत को बदला चुकान पड़रौ है।” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />यूसुफ समझ गौ कि बे का कहरै हैं, लेकिन बे नाय जानत रहैं, काहैकि बे अनुवादक के जरिया बासे बात करत रहैं। <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />यूसुफ उनके झोने से चले जाथै और रोन लगथै। बौ फिर दुबारा से उनसे बातचीत करन कै आथै, और सिमौन कै चुनथै, और बौ बाकै उनके सामने भाँद दई।<verse eid="GEN 42:24" /></para>
  <para style="s">यूसुफ के भईय्यन को मिस्र देस मैं लौटनो</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />यूसुफ आदेस दई कि बाके भईय्यन की बोरी अनाज से भर दियैं, और सबन कै चाँदी के पैसन से भरी बोरी दई जामैं, और सफर के ताहीं उन्हैं खान बारी जरूरत की चीज दौ जाबै। उनके ताहीं ऐसो ही करो गौ। <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />सब भईय्या अपने गधन मैं बे अनाज कै लादीं जो बे खरीदी रहैं, और फिर बे चले गै। <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />जो जघा मैं बे रात गुजारीं, उनमैं से एक अपने गधा कै खबान के ताहीं जैसिये अपनी बोरी खोली, तौ बौ बोरी के मोहों के ऊपर चाँदी के पैसा रखे भै देखी। <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />तौ बौ अपने भईय्यन से कही, “मेरो धन मोकै लौटाय दौ गौ है।” “देखौ जौ हिंयाँ मेरी बोरी मैं है!” तौ उन्हैं बड़ा अचम्मो भौ, और डर के मारे बे एक दुसरे से पूँछन लागे, “परमेस्वर हमरे संग जौ का करी?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />जब बे कनान देस मैं अपने दऊवा याकूब के झोने आथैं, तौ उनके ऊपर जो कछु बीतो रहै, बाकै सब बात बताईं: <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“कि मिस्र को राज्यपाल हमसे कर्रे मन से बात करी और हमरे ऊपर अपने देस के खिलाप मुखबरी करन को आरोप लगाई। <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />हम मुखबिर नाय हैं, हम जबाब दै, ‘हम इमानदार आदमी हैं। <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />हम कुल मिलाएकै बारह भईय्या हैं, और एकै दऊवा के लौड़ा हैं। हमरो एक भईय्या मर चुको है, और सबसे छोटो हबै भी हमरे दऊवा के संग कनान देस मैं है।’ <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />तौ बौ देस को स्वामी जबाब दई, ‘ऐसे करकै मैं पता लगांगो कि तुम इमानदार लोग हौ: तुम मैं से एक मेरे संग रहगो; बाकी लोग तुमरे भूंके परिवार के ताहीं अनाज लैकै जामंगे। <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />अपनो सबसे छोटो भईय्या मेरे झोने लाबौ। तभई मैं जान लुंगो कि तुम मुखबिर नाय हौ, बल्कि इमानदार आदमी हौ; मैं तेरे सब भईय्या तुम्हैं लौटाय दुंगो, और तुम हिंयाँ रहकै कारोबार कर सकथौ।’”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />बे अनाज की बोरी खोलीं तौ देखी कि हर एक आदमी की चाँदी के पैसन की थैलिया उनके बोरन मैं हैं। जब बे और उनको दऊवा याकूब जौ सब देखी, तौ बे डराए गै। <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />तौ उनको दऊवा याकूब उनसे कहीं, “का तुम मेरे सब बालकन कै खोए देनो चाहथौ? यूसुफ भी चले गौ; सिमौन चले गौ है; और अब तुम बिन्यामीन कै छीन लेनो चाहथौ। महीं हौं जो बिपत्ति मेरे ऊपर आई!” <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />रूबेन अपने दऊवा से कही, “अगर मैं बिन्यामीन कै तेरे झोने लौटार कै न लाए पामौ, तौ तू मेरे दोनों लौड़न कै मार डारिये। बाकै मेरे देखरेख मैं छोड़ दे, और मैं बाकै बापस लैकै आमंगो।”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />लेकिन याकूब कही, “मैं अपने लौड़ा कै तेरे संग नाय जान देंगो; बाको भईय्या मर चुको है, और बौ इकल्लो है। राह मैं बाके संग कछु भी ही सकथै। मैं एक बूढ़ो आदमी हौं, और जो दुख तुम मेरे जिंदगी मैं देगे, बौ दुख मोकै मार डारैगो।”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">मिस्र देस मैं बिन्यामीन को आनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />कनान देस मैं अकाल भौत भयानक से फैल गौ, <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />और जब याकूब के परिवार के बौ सब अनाज खाएकै खतम कर दईं, जो बे मिस्र से लाईं रहैं, तौ याकूब अपने लौड़न से कही, दुबारा से फिर जाएकै, और हमरे ताहीं अनाज मोल लै आबौ।<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />यहूदा अपने दऊवा से कही, “बौ आदमी हमैं कड़ी चितौनी दई, कि जबले हमरो भईय्या हमरे संग न होगो, तौले तुम मेरो दर्सन ना कर पागे।” <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />अगर तैं हमरे भईय्या कै हमरे संग पनारन कै तैयार है, तौ हम जाएकै बाके ताहीं अनाज मोल लैआंगे। <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />पर अगर तैं बिन्यामीन कै नाय भेजैगो, तौ हम मिस्र देस ना जामंगे; काहैकि मिस्र देस को स्वामी हमैं गम्भीर चितौनी दई है, “जबले तुमरे संग तुमरो भईय्या ना होगो, तुम मेरो दर्सन ना कर सकथौ।”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />याकूब कही, “तैं बौ आदमी कै जौ बात बताएकै कि तेरो एक और भईय्या है, मोकै इत्तो दुख काहे पहोंचाओ?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />बे फिर जबाब दईं, “बौ आदमी हमरे और हमरे परिवार के बारे मैं पूँछत रहो, ‘का तुमरो दऊवा हबै भी जिन्दो है? और भी कोई भईय्या है?’ हमैं बाके जे सबालन को जबाब देने रहै। फिर हम का जानत रहैं कि बौ कहैगो कि अपने संग अपने भईय्या कै हिंयाँ लैकै आबौ?”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />यहूदा अपने दऊवा इस्राएल से कही, “बौ लौड़ा कै मेरे संग पनार दियै, ताकी हम तुरंतै चले जामैं। तौ हम और तैं और हमारे छोटे-छोटे बालका भूँख से ना मरैं, बल्किन जिंदे रहमैं। <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />मैं बिन्यामीन की सुरक्छा की जिम्मेदारी लेथौं। तैं मेरे हाथ से बाकै वापस लेगो। अगर मैं बाकै तेरे झोने वापस लाएकै तेरे झोने ना ठड़बामौं, तौ मैं तेरे प्रति हमेसा के ताहीं दोसी बनो रहमंगो। <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />अगर हम इत्ती देर ले असियात न होते तौ अब ले दुई बार हुँआँ पहोंच चुके होते और बापस भी आए चुकते।”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />तौ उनको दऊवा याकूब उनसे कही, “अगर ऐसिये बात है, तौ ऐसो करौ: अपने बोरन मैं कनान देस की अच्छी पैदावार अपने-अपने झोला मैं मुखियन ताहीं भेंट के ताहीं लै जाबौ, मतलब जरासी राल, जरासो सहद, मसाला, पिस्ता, और बदाम। <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />अपने संग दुगनो धन भी लै जाबौ, काहैकि जो धन तुमरी बोरियन की ऊपर परत मैं लौटाए दौ गौ रहै, बाकै तुम बापस लै जईयो। काहैकि जौ गलती से भौ होगो। <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />अपने भइय्या बिन्यामीन कै भी अपने संग लेबौ, और मिस्र के स्वामी के झोने फिरसे लौट जाबौ। <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />सर्वसक्तिमान परमेस्वर बौ आदमी कै तुमरे ऊपर दया करै ताकि बौ बिन्यामीन और तुमरे दुसरे भईय्या कै तुम्हैं लौटाए दियै। जहाँ ले मेरी बात है, अगर मोकै अपने बालका कै खोनो है, तौ मोकै खोनो ही होगो।” <verse eid="GEN 43:14" /><verse number="15" style="v" sid="GEN 43:15" />तौ बे भेंट कै और चाँदी के पैसन कै दुगनो करकै लईं, और बिन्यामीन के संग मिस्र के घाँईं चल पड़े। और हुँआँ पहोंच कै बे यूसुफ के सामने हाजिर भौ। <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />जब यूसुफ बिन्यामीन कै उनके संग देखी, तौ बौ अपने घरै के सेवक से कही, “जे आदमिन कै मेरे घरै लै आ। बे दुपाहरी को खानू मेरे संग करन बारे हैं, जौ बजह से एक जानवर मारकै पकाबौ।” <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />सेवक बैसिये करीं जैसो बौ आदेस दई रहै और बौ बे सब भईय्यन कै यूसुफ के घरै लै गौ।<verse eid="GEN 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 43:18" />जब बे यूसुफ के घर मैं जान लगे, तौ बे डराए गै और सोचन लगे, “जो चाँदी के पैसन कै पहली बार हमरी बोरियन मैं भरकै हमैं लौटाए दियौ गौ रहै, बहे की बजह से हमकै हिंयाँ लाओ जाए रहो है। सायद बे अनकाचीति से हमरे ऊपर हमला करंगे, और हमरे गधन कै छीन लेंगे, और हमैं अपनो गुलाम बनाए लेंगे।” <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />जौ बजह से बे घर पहोंचकै यूसुफ के रखबरिया नौकर से ऐसे करकै कहीं, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />बे कहीं, “हे स्वामी, हम पहेले भी एक बार अनाज मोल लेन के ताहीं हिंयाँ आए हैं। <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />जब हम अपने घरै जात समय रास्ता मैं डेरा डारे, तभई हम अपनी बोरी खोले, तौ हमैं हर एक आदमिन की बोरन के ऊपर हिस्सा मैं चाँदी के पैसन से भरी पोटरी मिली। और तभई हम जाकै तेरे झोने बापस लाए हैं। <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />हम जाधा से जाधा अनाज मोल लेन के ताहीं कुछ और भी चाँदी के पैसा लाए हैं। हम नाय जानथैं कि कौन रहै जो हमरे चाँदी के पैसा हमरी बोरियन मैं बापस धर दई।”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />सेवक कही, “चिंता मत करौ। और मत डराबौ। तुमरो परमेस्वर, और तुमरे दऊवा को परमेस्वर तुमरे ताहीं तुमरी बोरियन मैं चाँदी के पैसन कै रखी होगो। मोए तुमसे पूरी बसूली मिल गई।” तौ बौ सिमौन कै निकारकै उनके झोने लै आई।<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />फिर सेवक बे सब भईय्यन कै यूसुफ के घरै लै जाथै। बौ उनकै पानी दई ताकि बे अपने पाँव धोए सकैं, और बौ उनके गधन कै पानी भी पिबाई। <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />बे यूसुफ के आन से अग्गु मतलब दुपारी को खानू मैं बाकै देन ताहीं अपनी भेंट तैयार कर लईं, काहैकि उनसे कहो गौ रहै कि उनकै बाके संग खानु खाने है। <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />जब यूसुफ घरै आओ, तौ बे बाकै भेंट जो बे घर मैं लाईं होथैं, बे बाकै दईं, और जमीन के घाँईं लोहोक्कै नमस्ते करीं। <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />यूसुफ उनके कुसल-मंगल के बारे मैं पूँछी, “का तुमरो दऊवा, बौ बूढ़ो आदमी जोके बारे मैं तुम कहे रहौ, सब ठीक है? का बौ अभईय्यो जिंदो है?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />बे बाकै जबाब दईं, “हाँ तेरो दयालू सेवक, हमरो दऊवा, हबै भी जिन्दो है और बाकी तबियत ठीक है।” और बे मुड़िया झुकाएकै बाकै नमस्कार करीं।<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />जब यूसुफ अपने सगे भईय्या बिन्यामीन कै देखी, तौ कही, “तौ जौ तुमरो सबसे छोटो भईय्या है, जोके बारे मैं तुम मोकै बताए रहौ। मेरे लौड़ा परमेस्वर तोए आसीस दियै।” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />तौ यूसुफ तुरंतै हुँआँ से चले गौ, काहैकि बाको मन अपने भईय्यन के ताहीं कोमल भावना से भरो भौ होथै। बौ टूटनै बारो ही होथै, तभई बौ अपने कमरा मैं जाएकै रोन लग जाथै। <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />अपनो मोहों धुलन के बाद बौ दुआरे आओ और खुद कै काबू करत भै बौ उनके ताहीं खानू परसन को आदेस दई। <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />यूसुफ कै एक मेज मैं और बाके भईय्यन कै दुसरी मेज मैं खानू परसो गौ। जो मिस्री लोग हुँआँ खानू खात रहैं उनके ताहीं अलग से परसा परसो गौ, मिस्र के रहन बारे इब्रानियन के संग खानु नाय खात रहैं; काहैकि मिस्री ऐसो करनो घिनौनो समझत रहैं। <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />सबै भईय्यन कै सबसे बड़े से लैकै सबसे छोटे ले उनकी उमर के हिसाब से, यूसुफ की मेज अग्गु बैठाओ गौ। जब बौ देखथै कि बे कौन हिसाब से बैठे हैं, तौ बे भौचक्के हीकै एक दुसरे के घाँईं देखन लगथैं। <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />यूसुफ की मेज से उन्हैं खानू परसो गौ, और बिन्यामीन कै सबकी तुलना से पाँच गुना जाधे खानू परसो गौ। तौ बे यूसुफ के संग तौ ले खात-पीत रहे जबले बे मतरभंग ही ना गै।<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">हरानो भौ प्यालो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />यूसुफ अपने घर के अधिकारिन कै आदेस दई, “जे आदमिन कै बोरी मैं इतनो अनाज भर दियौ जितनो बे लै जाए सकथैं। हर आदमी के चाँदी के पैसन कै भी बाके बोरी के मोहों मैं रख दियौ। <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />मेरे चाँदी के कटोरा के उनके अनाज के पैसन के संग सबसे छोटे भईय्या की बोरी के ऊपर रख दियौ।” बौ बैसिये करी जैसो यूसुफ बासे कही रहै। <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />तड़के भोर भईय्यन कै उनके गधन के संग बिदा करो गौ। <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />जब बे सहर से थोड़ी दूर पुग पाईं, तौ यूसुफ अपने घर के रखबरिया से कही, बे आदमिन के पच्छू जल्दी जाबौ। जब तुम उनसे भेंटा करौ, तौ उनसे पूँछियो, “तुम भलाई के बदले बुराई काहे करे? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />तुम मेरे मालिक को चाँदी को प्याला काहे चुराए? जौ बहे है जो से बौ पीथै, और जहे से बौ भविस्यवाड़ीं करथै। तुम गंभीर अपराध करे हौ!”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />जब सेवक उनकै पकड़ लईं, तौ बे जौ बात दोहराईं। <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />बे बाकै जबाब दईं, “हे स्वामी, काहे तैं ऐसी बात कहरौ है? तेरे सेवकन से ऐसो काम दूरै रहबै। <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />तुम जानथौ, कि जो पैसा हमकै हमारे बोरी मै मिलो, बौ हम कनान देस से तुमरे झोने बापस लै आए हैं। फिर हम तेरे मालिक के घर से चाँदी और सोनो काहे चुरांगे? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />हे स्वामी, अगर हम मैं से कोई के झोने बौ मिलै तौ बाकै मौत की सजा दौ जाबौ, और हम मैं से बाकी लोग तेरे स्वामी के दास बन जांगे।”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />बौ कही, “मैं राजी हौं; लेकिन जो कटोरा लई है बस बहे मेरो दास बनैगो, और तुम मै से बाकी लोग आजाद ही कै जाए सकंगे।” <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />जौ बजह से बे तुरन्त अपनी बोरी जमीन मै उतार दईं, और हर एक आदमी अपनी बोरी खोलीं। <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />यूसुफ को दास बड़े से लैकै छोटे तक खूब अच्छे से बोरन मैं ढूँडी, और कटोरा बिन्यामीन के बोरी मै मिलो। <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />सब भईय्या दुख के मारे अपने-अपने लत्ता फाड़ी, और अपने गधा मैं बोरा लादकै, और अपने सहर कै लौटगै।<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />जब यहूदा और बाके भईय्या यूसुफ के घरै आथैं, तौ भी बौ हूँनै होथै। तौ बे बाके अग्गु झुके, <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />और यूसुफ उनसे कही, “तुम कैसो काम करे? का तुम नाय जानत रहौ कि मेरो दर्जा देखकै कोई भी आदमी करकै तुमरो विचार करकै पता लगाए सकथै?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />यहूदा जबाब दई, “हम तोसे का कह सकथैं स्वामी?” हम कैसे बहस कर सकथैं? और हम खुदकै कैसे निर्दोस कर सकथैं? परमेस्वर हमरे अपराध और पाप कै उजागर कर दई है। अब हम सब तेरे दास हैं, सिरफ बाकै छोड़कै जोके झोने प्यालो मिलो रहै।<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />यूसुफ उनसे कही, “अरे, नाय! मैं ऐसो कहुए नाय करंगो! सिरफ बहे मेरो दास होगो जोके झोने प्यालो है। तुम मैं से बाकी लोग कुसल और अच्छे हुई कै अपने दऊवा के झोने बापस जाए सकथौ।”<verse eid="GEN 44:17" /></para>
  <para style="s">यहूदा बिन्यामीन के ताहीं प्रार्थना करी</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />यहूदा यूसुफ के झोने गौ और कही, “स्वामी, महरबानी करकै मोकै तेरे अग्गु खुलकै बात करन की इजाजत दे। मोसे गुस्सा मत करिये; तैं तौ खुद राजा फिरौन के तराहनी है।” <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />स्वामी, तैं हमसे पूंँछो, का तेरो दऊवा या और दुसरो कोई भईय्या है? <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />हम अपने स्वामी कै जबाब दै, हमरो एक बूढ़ो दऊवा है और एक छोटो भईय्या है, और बौ हमरे दऊवा के बुढ़ापो मै जनम भौ रहै। और बौ भईय्या अब मर चुको है, मैं अपनी अईय्या को इकल्लो लौड़ा रह गौ; और मेरो दऊवा मोसे भौत प्यार करथै। <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />तौ तैं हमैं अपने सेवक कै, आदेस दौ रहै, “बाकै मेरे झोने लाबौ जोसे कि मैं अपनी आँखिन से बाकै देख सकौं।” <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />और हे स्वामी हम तोकै जबाब दै रहैं, कि लौड़ा अपने दऊवा कै नाय छोड़ सकथै; अगर बौ ऐसो करी तौ बाको दऊवा मर जागो। <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />तैं हमसे दुबारा से कहो, कि जब तक तुमरो सबसे छोटो भईय्या तुमरे संग न आबै, तुम्हैं मेरे सामने आन न दौ जागो।<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />“हे स्वामी जब हम अपने दऊवा के झोने बापस गै, तौ हम बाकै बताए कि तैं का कहो रहै। <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />फिर बौ हमकै बापस लौटन और थोड़ी सो अनाज मोल लान के ताहीं कही। <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />हम जबाब मै दै, ‘हम ऐसे नाय जा सकथैं; जबले हमरो सबसे छोटो भईय्या हमरे संग ना होगो, हमैं बौ आदमी की मौजूदगी मैं घुसन नाय मिलैगो। हम तभई जाए सकथैं जब हमरो सबसे छोटो भईय्या भी हमरे संग जाबै।’ <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />तेरो दास हमरो दऊवा हमसे कही है, तैं जानत भी है, कि मेरी बईय्यर राहेल से मोसे दुई लौड़ा पैदा भै। <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />उनमैं से एक मोए पहलिये छोड़ चुको है। बाकै जंगली जानवर टुकड़ा-टुकड़ा कर डारी होंगे, काहैकि बाके जान के बाद से, मैं बाकै कहुए नाय देखो। <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />अगर तैं हबइ जाकै मोसे लै लेगो, और जाकै कुछ ही जाबै तौ जो दुख तैं देगो, बौ मेरे बुढ़ापो मै सोक को दुख मोए मार डारैगो।<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />अब अगर मैं अपने दऊवा, तेरे सेवक, के झोने जामौं और लौड़ा हमरे संग नाय होबै, और बौ देखै कि लौड़ा हमरे संग नाय है, तौ बौ मर जाबैगो; <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />काहैकि बाकी जान तौ लौड़ा मैं अटकी है। और हम अपने बूढ़े दऊवा को दुख अधोलोक दसा मैं पहुँचाए देंगे। <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />जासे भी जाधा करकै, मैं लौड़ा के ताहीं अपने दऊवा कै अपनी जिंदगी गिरमी रख दौ। मैं बासे कहो कि अगर मैं तेरे लौड़ा कै तेरे झोने बापस नाय लाए पांगो, तौ मैं पूरी जिंदगी भर जाको दोस झेलत रहेंगो। <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />इसलै अब कृप्या इजाजत दे, कि जौ लौड़ा की जघा मैं तेरो जौ सेवक अपने स्वामी को गुलाम बनकै रहबै, और लौड़ा अपने भईय्यन के संग लौट जाबै। <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />काहैकि लौड़ा के बगैर मैं कैसे अपने दऊवा के झोने बापस जाए सकथौं? मैं अपने दऊवा ऊपर जौ दुख आत भै नाय देख सकथौं।”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">यूसुफ अपने भईय्यन कै बताथै कि बौ कौन है</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />यूसुफ अब अपने नौकरन के सामने अपनी चेतना कै काबू करन मै असफल रहौ, तभई बौ बे सबन कै कमरा से दुआरे जान को आदेस दई। और यूसुफ अपने भईय्यन कै बताई कि बौ कौन है बौ समय उनके अलावा हूँना पर कोईये नाय होथै। <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />बौ ईत्ती जोर से किल्लारी मारकै रोई कि मिस्र के लोग जाकै सुन लईं, और जौ खबर राजा के दरबार मै पहोंचाए देथै। <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />यूसुफ अपने भईय्यन से कही, “मैं यूसुफ हौं। मेरो दऊवा का हबै भी जिन्दो है?” लेकिन जब बाके भईय्या जौ सुनी, तौ बे इत्तो घबड़ाए गै कि बाको जबाब भी नाय दे पाईं। <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />तौ यूसुफ उनसे कही, “महरबानी करकै मेरे झोने आबौ।” फिर बे बाके झोने आए, और फिर बौ उनसे कही, मैं तुमरो भईय्या यूसुफ हौं, जोकै तुम मिस्र मैं आनबारे ब्यापारियन कै बेंच दै रहौ। <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />अब तुम निरास मत होबौ, और ना खुद कै दोसी ठहराबौ, काहैकि तुम मोकै हिंयाँ बेंच डारे। जौ सच्ची बात है कि परमेस्वर मोकै तुमरे झोने तुमरी ज्यान बचान के ताहीं पनार दई। <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />जौ देस मै सूखा को सिरफ दुसरो साल है; पाँच साल और होन के बाद बामैं ना तौ हर से जुताई होगी और ना ही फसल काटी जागी। <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />परमेस्वर मोकै जौ अदभुत तरीका से तुम्हैं बचान और जौ तय करन के ताहीं तुमरे अग्गु भेजो कि तुम और तुमरे बंसज पृथ्वी मैं जिन्दे रहमैं और उनकी रक्छा करी जाबै। <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />तौ बाकई मै तुम जो नाय रहौ जो मोकै हिंयाँ पनारे, बल्कि परमेस्वर है। बौ मोकै राजा को सबसे ऊँचे पद मै को अधिकारी बनाए दई है। बौ मोकै पूरे देस को चाल-चलता सौंप दई है; मैं पूरे मिस्र को सासक हौं।<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />“तौ अब जल्दी से मेरे दऊवा के झोने लौट आबौ और बासे कहबौ कि बाको लौड़ा यूसुफ जौ कही है: परमेस्वर मोए पूरे मिस्र देस को स्वामी बनाए दई है; बिना कछु देरी करे मेरे झोने आए जाबौ। <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />और तैं गोसेन प्रदेस की सीमा मै रह सकथै, ताकी तू मेरे झोने रह सकै - और तू, तेरे बालका तेरे नतिया- नुतकर, तेरी भेंड़ और बकरिया, तेरे जानवर और तेरे सबै कुछ चीज समेत मेरे झोने रहगो। <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />अगर तैं गोसेन मै होगो, तौ मैं देखरेख कर सकथौं। काहैकि हुँआँ हबै भी पाँच साल ले सूखा पड़ैगो; और मैं नाय चाहथौं कि तू, तेरो परिवार, और तेरे जानवर भूंके मरैं।”<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />यूसुफ जासे अग्गु और कही, “अब तुम सब, और तैं, और बिन्यामीन भी, देख सकथौ कि मैं सच मै यूसुफ हौं। <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />मेरे दऊवा कै बताए दियौ कि मैं हिंयाँ मिस्र देस मै कित्तो सानसोकत बारो हौं और मेरो रुतबा कितनो है बाकै बौ सब कुछ बताबौ जो तुम देखे हौ। और अब तुरंतै बाकै हिंयाँ लै आबौ।”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />और बौ अपने भईय्या बिन्यामीन के अग्गु पूरी बाँह फैलाई और रोन लगो; बिन्यामीन भी बासे गले लगकै रोन लगथै। <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />फिर, रोत भै, बौ अपने हर एक भईय्या कै गले लगाई और उन्हैं चूमी। बाके बाद बाके भईय्या बासे बात करन लगे।<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />जब महल मै खबर पहोंची कि यूसुफ के भईय्या आए हैं, तौ बाको राजा और अधिकारी भौत खुस भै। <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />तभई राजा यूसुफ से कही, “अपने भईय्यन से कह कि बे अपने जानवरन कै भरकै कनान देस कै लौट जामैं। <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />ताकी जे सब अपने दऊवा और अपने परिवार के लै सकै और हिंयाँ सबन कै लैकै बापस आन दियौ। मैं उन्हैं मिस्र मै बढ़िया से बढ़िया जमीन दुंगो, और उनके झोने रहन के ताहीं भौत कुछ होगो। <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />बौ उनकै आग्या दई कि बे अपनी बईयरैं और छोटे बालकन कै लान ताहीं मिस्र से लड़िया लै जामैं और संग मै अपने दऊवा कै भी लैकै आमै। <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />उनकै अपनी सब चीजन की चिंता नाय करने है और उनकै हिंयाँ लाने भी नाय है; काहैकि पूरे मिस्र देस मै जो बढ़िया जमीन होगी बौ उन्हईं की होगी।”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />याकूब के लौड़ा बैसिये करीं जैसो उनसे कहो गौ रहै। राजा की आग्या के जरिया यूसुफ उन्हैं लड़िया और सफर के ताहीं रासन दई। <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />बौ उन्हैं सबन कै बदलन ताहीं एक-एक जोड़ी लत्ता भी दई, लेकिन बौ बिन्यामीन कै तीन सौ चाँदी के सिक्का और पाँच जोड़ा लत्ता भी दई। <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />बौ अपने दऊवा कै सफर के ताहीं सबसे अच्छे मिस्र के सामान से लदे भै दस गधा और अनाज, रोटी और भी चीजन से लदे भै दस गधी पनारी। <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />जब बे रास्ता मैं जात रहैं बौ फिर अपने भईय्यन कै पनारी, और जब बे चले गै, तौ उनसे कही, रस्ता मै लड़ियो मत।<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />बे फिर मिस्र छोड़कै और कनान मै अपने दऊवा याकूब के घरै बापस लौट आए। <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />“यूसुफ हबै भी जिन्दो रहै!” बौ अपने भईय्यन से कही। “बौ पूरे मिस्र को सासक है!” याकूब कै हैरान भौ और बौ बाके बात ऊपर कतई विस्वास नाय करी, और बौ सुन पड़ गौ।<verse eid="GEN 45:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 45:27" />लेकिन जब याकूब बाकै बौ सबै कुछ बताई जो यूसुफ उनसे कही होथै, और जब बौ बे लड़िया देखी जो यूसुफ बाकै मिस्र मै लान के ताहीं पनारी रहै, बाकै देखकै बाकी ज्यान मैं ज्यान आए गई। <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />याकूब कही, बस इतनोई काफी है कि “मेरो लौड़ा यूसुफ हबै भी जिन्दो है!” मैं तौ बस जहे माँग सकथौं! मरन से पहले मोकै जाएकै बाकै देखने है।<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">याकूब को मिस्र मै जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />याकूब अपनो सब कुछ समटेई और बेर्सेबा कै गौ, जहाँ बौ अपने दऊवा इसहाक को परमेस्वर कै बलि चढ़ाई। <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />रात कै परमेस्वर दर्सन मै बासे बात करी, और पुकारकै कही, “याकूब, याकूब!”</para>
  <para style="p" vid="GEN 46:2">“हाँ, मैं हिंयाँ हौं,” बौ जबाब दई।<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />बौ कही, “मैं परमेस्वर हौं, और तुमरे दऊवा को परमेस्वर हौं।” “मिस्र मै जान से मत डराबौ; मैं तुमरे वंस कै हुँआँ एक महान रास्टृ बनांगो। <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />मैं तुमरे संग मिस्र जांगो, और तुमरे वंस कै जौ देस मै बापस लै आंगो। जब तैं मरैगो तौ यूसुफ तेरे संग मै होगो।”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />याकूब बेर्सेबा से चलो। बाके लौड़ा दऊवा कै, अपने छोटे बालकन संग, और अपनी बईंय्यरैं कै मिस्र के राजा के जरिया जो लड़िया लान कै पनारी रहै बे उनमैं बैठकै चल दईं। <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />बे अपने पले जानवर और कनान मै जुरो धन-दौलत कै लैकै मिस्र चले गै। याकूब अपने सब वंस कै अपने संग ले चले गौ: <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />बाके लौड़ा, बाके नतिया-नतनिया, बाकी लौड़िया, अपने संग मिस्र लै गौ।<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />याकूब के परिवार के जो सदस्य बाके संग मिस्र गै रहैं, बौ बाको सबसे बड़ो लौड़ा रूबेन रहै। <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />और रूबेन को लौड़ा: हनोक, पल्लू, हेस्रोन, और कर्मी रहै। <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />सिमौन और बाके लौड़ा: यमूएल, यामीन, ओहद, याकीन, सोहर, और एक कनानी बईय्यर को लौड़ा साऊल। <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />लेवी और बाके लौड़ा: गेर्सोन, कहात और मरारी। <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />यहूदा और बाके लौड़ा: एर, ओनन, सेला, पेरेस, और जेरह रहैं। पर एर और ओनन, कनान देस मै मर गै रहैं। पेरेज के लौड़ा हेस्रोन और हामुल रहैं। <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />इस्साकार और बाके लौड़ा: तोला, पूआ, यासूब और सिम्रोन। <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />जबूलून और बाके लौड़ा: सेरेद, एलोन, और यहलेल। <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />मेसोपोटामिया के पद्दन-अराम मैं याकूब से लिआ के जेईं लौड़ा पैदा भै, और एक बाकी लौड़िया दीना भी। लिआ के जरिया बाके बंस की गिनती कुल मिलाएकै तैंतीस भई।<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />गाद और बाके लौड़ा: सपोन, हाग्गी, सूनी, एस्बोन, एरी, अरोदी, और अरेली। <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />आसेर और बाके लौड़ा: यिम्ना, इस्वा, इसवी, बरीआ, और उनकी बहेनिया सेरह। बरीआ के लौड़ा हेबेर और मल्कीएल रहै। <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />जिल्पा नाओं की दासी से, जोकै लाबान अपनी लौड़िया लिआ कै दई होथै। जे कुल सोलह जनी याकूब से पैदा भै रहैं।<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />याकूब की बईय्यर राहेल से बाके दुई लौड़ा पैदा भै: यूसुफ और बिन्यामीन। <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />यूसुफ कै मिस्र देस मैं मनस्से और एप्रेम नाओं के लौड़ा पैदा भै। उनकै ओन नगर के एक पुजारी पोतीपर की लौड़िया आसनत जन्माई रहै। <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />बिन्यामीन के लौड़ा बेला, बेकर, असबेल, गेरा, नामान, एही, रोस, मुप्पीम, हुप्पीम और अर्द रहैं। <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />जे चौदह राहेल के जरिया याकूब के बंसज हैं।<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />दान को लौड़ा हूसीम रहै। <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />नप्ताली के लौड़ा: यहसएल, गूनी, सेसेर, और सिल्लेम। <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />जे सातौ बिल्हा नाओं की दासी से याकूब के बंसज हैं, जोकै लाबान अपनी लौड़िया राहेल कै दई रहै।<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />याकूब के बंस के सब प्राड़ी, जो उनके संग मिस्र मैं आए रहैं, याकूब की बहुअन कै छोड़कै, कुछ छियासठ आदमी रहैं। <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />यूसुफ के दुई लौड़ा, जो बाकै मिस्र देस मैं पैदा भै रहैं, ऐसे करकै हुँआँ जान बारे याकूब के परिवार की कुल संख्या सत्तर ही गई।<verse eid="GEN 46:27" /></para>
  <para style="s">मिस्र मै याकूब और बाको परिवार</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />याकूब यहूदा कै यूसुफ से गोसेन प्रदेस मै मिलन कै कहन ताहीं अग्गु पनारी। जब बे गोसेन प्रदेस मैं पहोंचे, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />यूसुफ अपने रथ मै चढ़थै और अपने दऊवा इस्राएल से मिलन के ताहीं गोसेन प्रदेस कै गै। जब बे मिले, तौ यूसुफ अपने दऊवा के गले मै अपनी बाँहे डार कै भौत देर ले रोत रहो। <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />याकूब यूसुफ से कही, मैं मरन बारो हौं, काहैकि मैं तोए देख लौ हौं और जासे खुस हौं कि तैं हबैले जिंदो है।<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />फिर यूसुफ अपने सब भईय्या और अपने दऊवा के परिवार के बाकी के लोगन से कही, “मोए जाएकै राजा कै बतानो चाहिए कि मेरे भईय्या और मेरे दऊवा को पूरो परिवार, जो कनान मै रहत रहैं, मेरे झोने आएगै। <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />मैं बासे कहमंगो, कि तुम बरदिया हौ और जानवरन की देख-रेख करथौं, और तुम अपनी भेड़-बकरिया, गईंय्या-बरधा, और जो कुछ तुमरो है बौ सब लै आए हौ। <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />जब राजा तुम्हैं बुलाए कै पूँछी कि तुमरो कारोबार का है, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />बाकै जरूर बतामैं कि तुम जिन्दगी भर जानवरन की देख-रेख करे हौ, जैसे तुमरे पुरखा करी रहैं। तभई बौ तुम्हैं गोसेन प्रदेस की सीमा मै रहन देगो।” यूसुफ जौ जहेमारे कही कि मिस्री लोगन बरदियन से कोई मतलब ना पड़ै।<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />तौ यूसुफ अपने पाँच भईय्यन कै लैकै राजा के झोने गौ। बौ बासे कही, “मेरे दऊवा और मेरे भईया अपनी भेड़-बकरिया, गईंय्या-बरधा और अपनो सब कछु लैकै कनान से आए हैं। बे अब गोसेन प्रदेस मैं हैं।” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />फिर बौ अपने भईय्यन मैं से पाँच आदमिन कै चुनकै फिरौन राजा के सामने खड़ो कर दई। <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />फिरौन राजा उनसे पूँछी, “तुमरो का काम है?” हम बरदिया हैं, जैसे हमरे पुरखा रहैं, बे जबाब दईं। <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />बे फिरौन राजा से जौ कहीं, हम मिस्र देस मैं रहन कै आए हैं, कनान देस मै भैंकर अकाल पड़ो है। इसलै तेरे सेवकन कै भेड़-बकरियन के ताहीं चुगा नाय रहो। अब कृपा करकै अपने सेवकन कै गोसेन प्रदेस मै रहन की इजाजत दे। <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />राजा यूसुफ से कही, “अब जब कि तेरो दऊवा और तेरो भईय्या आए गौ हैं, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />मिस्र की जमीन तेरे सामने पड़ी है, गोसेन के सहर मै जो जमीन को सबसे अच्छो हिस्सा है, बामैं अपने दऊवा और भईय्यन कै बसाए दे। और अगर बामै से कोई अच्छी आदमी जानवरन की अच्छे से देख-रेख करन बारो होबै, तौ बाकै जानवरन को अधिकारी बनाएदे।”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />तौ यूसुफ अपने दऊवा कै लैकै राजा के अग्गु गौ। याकूब राजा कै आसीस दई, <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />और राजा फिरौन याकूब से पूँछी, तेरी उमर कित्ती है?<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />याकूब फिरौन कै जबाब दई, “मैं तौ एक सौ तीस साल परदेसी हुईकै अपनी जिंदगी बिताए चुको हौं। मेरी जिंदगी के दिन थोड़ी और दुख से भरे पड़े रहैं, और मेरे बापदादो परदेसी हुईकै जितने दिन ले जिंदे रहे उतने दिन को मैं अभै ना भौ हौं।” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />याकूब राजा कै आसीस दई और चले गौ। <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />तौ यूसुफ अपने दऊवा और भईय्या कै मिस्र मै बसाए दई, और बौ फिरौन राजा की आग्या के हिसाब से कनान देस के रामसेस प्रदेस मैं अच्छी जमीन दई। <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />यूसुफ अपने दऊवा, अपने भईय्या और अपने दऊवा के परिवार के बाकी सब लोगन कै, जोमैं सबसे छोटो बच्चा भी सामिल रहै, खानु खबाई।<verse eid="GEN 47:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />अकाल इत्तो भयानक रहै कि कैसियो भी खानु नाय रहै, और मिस्र और कनान के लोग भूंक से कमजोर हुई गै। <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />जो पैसा मिस्र देस और कनान देस मैं लेन-देन मैं जुराने रहैं, और जोसे लोग अनाज खरीदत रहैं, बाकै यूसुफ जोड़कै फिरौन राजा के महल मैं जमा कर दई। <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />जब मिस्र और कनान देस को सब पैसा खतम ही गौ, तौ मिस्री यूसुफ के झोने जाएकै कहन लगो, “हम कै खानु दे! हम मरन मत देबै, कछु कर! हमरो सब पैसा खतम ही गौ है।”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />यूसुफ जबाब दई, “अपने जानवर लै आबौ; अगर तुमरो सब पैसा खतम ही जाबै तौ मैं तुम्हैं जाके बदले मै रासन दुंगो।” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />तौ बे अपने जानवरन कै यूसुफ के झोने लै आईं, और बौ उनके घोड़ा, भेड़-बकरिया, गईंय्या-बरधा, और गधन के बदले मै उनकै रासन दई। बहे साल बौ सबै जानवर के बदले उन्हैं रासन दई।<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />अगले साल बे बाके झोने आए और कहीं, “स्वामी, हम तोसे जौ माजरा नाय छिपांगे कि हमारो सारो धन खतम ही गौ है और हमरे पालतू जानवर तेरे हैं। हमरे सरीर और हमरी जमीन के अलावा तोए देने के ताहीं कुछ भी नाय बचो है। <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />हमकै मरन मत दे। कुछ भी करकै! हमरे खेत बंजर मत होन दे। रासन के बदले मै हमैं और हमरी जमीन खरीद ले। हम राजा के दास बन जांगे, और बौ हमरी जमीन को मालिक होगो। हमैं जिंदो रखन के ताहीं अनाज और बीज दै दे ताकी हम अपने खेतन कै बोए सकैं।”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />यूसुफ राजा के ताहीं मिस्र की सब जमीन मोल लै लई। और हर एक मिस्रवासिन कै अपनी जमीन बेचन के ताहीं बेबस होन पड़ो, काहैकि अकाल उनकै भयानक तरीका से प्रभावित करी रहै; और फिर सब जमीन फिरौन राजा की संपत्ति बन गई। <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />यूसुफ मिस्र देस के एक छोर से दुसरे छोर ले लोगन कै दास बनाई। <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />सिरफ बहे जमीन कै नाय मोल लई, जो हूँनै के पुजारिन की होथै। उन्हैं अपनी जमीन कै नाय बेचन पड़ो, काहैकि राजा उन्हैं गुजर-बसर के ताहीं खरेक देत रहै। <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />यूसुफ लोगन से कही, “देखौ, मैं तुम्हैं और तुमरी जमीन कै राजा के ताहीं मोल लै लौ हौं। हिंयाँ तुमरे ताहीं अपने खेत मै बोन के ताहीं बीज है। <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />फसल के समय तुम्हैं राजा कै पाँचमों हिस्सा देने होगो। बचो भौ चार हिस्सा तुमरो होगो। मतलब हर एक हिस्सा खेत के बीज के ताहीं, तुमरे और परिवार के सदस्यन के ताहीं और छोटे बालकन के आहार के ताहीं होगो।”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />बे जबाब दईं, “तैं हमरी ज्यान बचाओ है; तू हमरे ऊपर अनुग्रह करो, प्रभु, और हम राजा के दास बने रहमंगे।” <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />तौ यूसुफ मिस्र देस के ताहीं नियम बनाई, कि पैदावार को पाँचमों हिस्सा राजा को होगो। और जौ नियम आज कै भी लागू है। सिरफ पुजारिन की जमीन ही राजा की संपत्ति नाय बन सकथै।<verse eid="GEN 47:26" /></para>
  <para style="s">याकूब की आखरी बिनती</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />इस्राएली मिस्र मै गोसेन प्रदेस की सीमा मै रहत रहैं, जहाँ बे सेठ ही गै और उनके तमान बालका भै। <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />याकूब मिस्र देस मैं सत्रह साल रहो, ऐसे करकै बाकी पूरी उमर एक सौ सैंतालिस साल की भई। <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />जब इस्राएल के मरन को समय झोने होथै, तभई बौ अपने लौड़ा यूसुफ कै बुलाएकै बासे कही, अपनो हात मेरी जाँघ ऊपर रखकै कसम खा, कि प्रेम के संग अनुग्रह से व्यवहार करैगो। तैं मोकै मिस्र मै मत दफनईये। <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />और जब मैं अपने मरे भै पुरखन के संग सोमौं तौ मोकै मिस्र देस से लै जईये और मेरे पुरखन के कब्रिस्तान मैं दफनईये। यूसुफ जबाब दई, “मैं तेरे कहे के हिसाब से करंगो।”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />याकूब कही, “तैं कसम खा।” तौ यूसुफ कसम खाई, और याकूब हूँनै अपने बिछौना मै धन्यवाद करी।<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">याकूब एप्रेम और मनस्से कै आसीस दई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />कुछ समय बाद यूसुफ कै बताओ जाथै कि बाको दऊवा बिमार है। तभई बौ अपने दोनों लौड़ा मनस्से और एप्रेम कै संग लैकै याकूब से मिलन कै गौ। <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />जब याकूब कै खबर दईं कि बाको लौड़ा यूसुफ बासे मिलन आओ है, तौ बौ हिम्मत जोरी और बिस्तर मै बैठ गौ। <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />याकूब यूसुफ से कही, “सर्वसक्तिमान परमेस्वर कनान देस के लूज नगर मै मोए दर्सन दई और मोकै आसीस दई। <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />बौ मोसे कही, मैं तोए भौत सन्तान दुंगो, और तेरे बंस से भौत सी जाति निकरंगी; मैं जौ जमीन तुमरे बंस कै सदा के ताहीं उनके अधिकार मै कर दुंगो।”<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />याकूब जासे अग्गु और कहथै, “यूसुफ, तेरे दोनों लौड़ा, जो मेरे हिंयाँ आन से पहले मिस्र मै तोसे पैदा भै हैं, बे मेरे हैं; एप्रेम और मनस्से, रूबेन और सिमौन के तराहनी ही मेरे लौड़ा हैं। <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />अगर तेरे और भी लौड़ा होमैं, तौ बे मेरे परिवार के ना माने जामंगे; उन्हैं जो हिस्सा मिलैगो बौ एप्रेम और मनस्से के जरिया मिलैगो। <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />मैं जौ तुमरी अईय्या राहेल के बजह से कर रहो हौं। मोकै भौत दुख भौ कि जब मैं पददान मेसोपोटामिया से लौटत रहौं, तभई एप्राता से कुछ दूर कनान देस मै बाकी मौत ही गई। मैं बाकै एप्राता की सड़क के किनारे दफनाए दौ।” एप्राता अब बैतलहम के नाओं से जानो जाथै।<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />जब इस्राएल अर्थात याकूब जब यूसुफ के लौड़न कै देखी, तौ पूँछी, “जे कौन के लौड़ा हैं?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />यूसुफ जबाब दई, “जे मेरे लौड़ा हैं, जिन्हैं परमेस्वर मोकै हिंयाँ मिस्र मै दई है।”</para>
  <para style="p" vid="GEN 48:9">याकूब कही, “उन्हैं मेरे झोने ला कि मैं उन्हैं आसीर्वाद देमौं।” <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />उमर की बजह से याकूब नजर कमजोर ही गई रहै और बौ सई से देख भी नाय पात रहै। यूसुफ लौड़ा कै झोने लाई, और बौ उनकै गले से लगाई, और चूमी। <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />याकूब यूसुफ से कही, मैं कभी तोकै दुबारा देखन की आसा नाय करो रहौं, और अब परमेस्वर मोकै तेरे बालकन कै भी देखन की इजाजत दई है। <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />फिर यूसुफ उन्हैं याकूब की गोदी से लै लई, और जमीन मैं घुटने के बल आए कै और मुड़िया झुकाए कै बाके सामने दंडवत करी।<verse eid="GEN 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13" />बाके बाद युसुफ बे दोनो कै लैकै दऊवा के झोने आओ। तौ यूसुफ एप्रेम कै याकूब कै बाँए घाँईं और मनस्से कै दहने घाँईं रखी। <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />लेकिन याकूब हात जोड़कै अपनो दहनो हात एप्रेम के मुड़िया ऊपर रखी, काहैकि बौ छोटो होथै, और अपनो बाँया हात मनस्से की मुड़िया ऊपर रखी, जो बड़ो रहै। <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />तौ बौ यूसुफ कै आसीस दई और कही:</para>
  <para style="q1" vid="GEN 48:15">“परमेस्वर, जोकी मेरो दऊवा अब्राहम और इसहाक सेवा करी, जे लौड़न कै आसीस देबै!</para>
  <para style="q2" vid="GEN 48:15">परमेस्वर, जो मोकै हबै ले समारी है, उन्हैं आसीस देबै!<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />स्वर्गदूत, मोकै सब परेसानी से बचाई है, उन्हैं आसीस देबै!</para>
  <para style="q2" vid="GEN 48:16">मेरो नाओं और मेरो दऊवा अब्राहम और इसहाक को नाओं जे लौड़न के जरिया अटल रहबै!</para>
  <para style="q1" vid="GEN 48:16">उनके भौत से बालका होमैं, और जे पृथ्वी मैं अनगिनित ही जामैं और इनको बंस बड़ै!”<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />जब यूसुफ देखी, कि बाको दऊवा अपनो दहनो हात एप्रेम के मुड़िया ऊपर रखी है, तौ बाकै बुरो लगो; जौ बजह से बौ अपने दऊवा को हात पकड़कै एप्रेम की मुड़िया से उठाएकै मनस्से की मुड़िया ऊपर रख दई। <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />यूसुफ फिर अपने दऊवा से कही, “दऊवा, ऐसो नाय है। जौ बड़ो लौड़ा है; अपनो दहने हात बाकी मुड़िया ऊपर रख।”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />बाको दऊवा जौ कहत भै बाकै मना कर दई, “कि मोए मालुम है, मेरे लौड़ा, मोए मालुम है। मनस्से बंसज भी महान लोग बनंगे। लेकिन बाको छोटो भईय्या बासे भी महान होगो, और बाके बंसज महान रास्ट्र बनंगे।”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />जौ बजह से बौ बहे दिन कै उनकै आसीस दई, और कही, इस्राएली आसीस देत समय तुमरे नाओं को इस्तमाल करंगे। बे कहमंगे, परमेस्वर तुम्हैं एप्रेम और मनस्से के तराहनी बनाबै। ऐसे करकै याकूब एप्रेम कै मनस्से से पहले रखी।<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />फिर याकूब यूसुफ से कही, जैसो तू देख रौ है, मैं मरन मै हौं, लेकिन परमेस्वर तेरे संग रहगो, और तोए तेरे पुरखन के देस मै लौटाए लै जागो। <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />मैं तुमरे भईय्यन कै नाय, लेकिन तुम्हैं ढलुआ पहाड़ी छेत्र सेकेम दे रौ हौं, बौ उपजाऊ जघा जो मैं अपनी तलवार और धनुस से एमोरियन से छीन लौ रहौं।<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">याकूब के आखरी सब्द</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />याकूब अपने लौड़न कै बुलाएकै कही, अब जुराए जाबौ, और मैं तुम्हैं बतांगो कि भविस्य मै तुमरे संग का होगो:<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />“याकूब के सब लौड़ा, आबौ और सुनौ।</para>
  <para style="q1" vid="GEN 49:2">अपने दऊवा इस्राएल की सुनौ।”<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“रूबेन, मेरी पहली औलाद, तुम मेरी ताकत हौ</para>
  <para style="q1" vid="GEN 49:3">और मेरी सक्ति को पहलो बच्चा,</para>
  <para style="q1" vid="GEN 49:3">मेरे सब लौड़न मै सबसे गौरबसाली और ताकतबर है।”<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />तुम भयानक बाढ़ की तराहनी हौ,</para>
  <para style="q1" vid="GEN 49:4">लेकिन तुम सबसे खास नाय होगे,</para>
  <para style="q1" vid="GEN 49:4">काहैकि तू मेरी प्रेमिका के संग सोए।</para>
  <para style="q1" vid="GEN 49:4">काहैकि तू मेरे दऊवा के बिछौना को अपवित्र करो।<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“सिमौन और लेवी भईय्या हैं।</para>
  <para style="q1" vid="GEN 49:5">बे हिंसा करन के ताहीं अपने हथियारन को इस्तमाल करथैं।”<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />मैं उनकी गुप्त बातन मै सामिल नाय होंगो,</para>
  <para style="q1" vid="GEN 49:6">ना मैं उनकी बैठक मै हिस्सा लुंगो,</para>
  <para style="q1" vid="GEN 49:6">काहैकि बे क्रोध मै आए कै लोगन कै मार डारीं</para>
  <para style="q1" vid="GEN 49:6">और बे अपनी इच्छा के ताहीं बरधन कै अपंग बनाए दईं।<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />उनके क्रोध ऊपर स्राप होबै, काहैकि याकूब भौत गुस्सा बारो है,</para>
  <para style="q1" vid="GEN 49:7">और उनके क्रोध मै, काहैकि जौ भौत भयानक है।</para>
  <para style="q1" vid="GEN 49:7">मैं उन्हैं इस्राएल के सब देस मै तितर-बितर कर दुंगो।</para>
  <para style="q1" vid="GEN 49:7">मैं उन्हैं हुँआँ के लोगन के बीच तितर-बितर कर दुंगो।<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“यहूदा, तेरे भईय्या तेरी स्तुति करंगे।</para>
  <para style="q1" vid="GEN 49:8">तू अपने दुस्मन की घेंट पकड़कै धरैगो।</para>
  <para style="q1" vid="GEN 49:8">तेरे भईय्या तुमरे सामने झुकंगे।”<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />यहूदा बक्टा के तराहनी है,</para>
  <para style="q1" vid="GEN 49:9">अपने सिकार कै मारकै अपनी मांद मै लौट आओ,</para>
  <para style="q1" vid="GEN 49:9">पैर फैलाएकै बैठ गौ;</para>
  <para style="q1" vid="GEN 49:9">कोई भी बाकै परेसान करन की हिम्मत नाय करैगो।<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />जब तक सीलो नाय आबै</para>
  <para style="q2" vid="GEN 49:10">यहूदा राजदंड को डंडा पकड़ैगो।</para>
  <para style="q1" vid="GEN 49:10">वास्तविक सासक के आन से पहले खतम ना होगो।</para>
  <para style="q1" vid="GEN 49:10">सब जाति बाकी आग्या को पालन करैगी।<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />बौ अपने ज्वान गधा कै अंगूर की लार से भाँदैगो,</para>
  <para style="q1" vid="GEN 49:11">और बढ़िया लार मै गधन के बच्चा कै भाँदैगो।</para>
  <para style="q1" vid="GEN 49:11">बौ अपने लत्ता दाखरस मै धोथै।<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />दाखरस पीन से बाकी आँखी लाल ही गई हैं,</para>
  <para style="q1" vid="GEN 49:12">बाके दाँत दूद पीन से सफेद ही गै।<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“जबूलून समुंदर के घाट मैं रहगो।</para>
  <para style="q1" vid="GEN 49:13">बाको बन्दरगाह जहाजन के ताहीं स्वर्ग को रस्ता होगो।</para>
  <para style="q1" vid="GEN 49:13">बाकी राज्य हद सीदोन देस ले पहोंचैगी।”<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“इस्साकार एक ताकतबर गधा है; जो भेंड़ की सार के बीच लेटथै।”<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />लेकिन बौ देखथै कि आराम करन की जघा अच्छी है</para>
  <para style="q1" vid="GEN 49:15">और देखथै कि जमीन भौत सुगड़ है।</para>
  <para style="q1" vid="GEN 49:15">लेकिन बौ बोझ उठान के ताहीं अपनी पिट्ठा झुकाथै</para>
  <para style="q1" vid="GEN 49:15">और गुलाम की तराहनी काम करन के ताहीं मजबूर करो जाथै।<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“दान, इस्राएल के कुलन मैं एक कुल,</para>
  <para style="q1" vid="GEN 49:16">अपने कुल के लोगन को न्याय करैगो।”<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />दान सड़क के किनारे को साँप होगो,</para>
  <para style="q1" vid="GEN 49:17">रस्ता के किनारे एक बिस बारो साँप,</para>
  <para style="q1" vid="GEN 49:17">बौ घोड़ा की ऐंड़ी मै हमला करथै,</para>
  <para style="q1" vid="GEN 49:17">जोसे सवार पच्छू के घाँईं गिर जाथै।<verse eid="GEN 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />हे प्रभु, मैं तेरे उद्धार के ताहीं इंतजार करथौं।<verse eid="GEN 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“गाद मै चुट्टा को एक दल हमला करैगो,</para>
  <para style="q1" vid="GEN 49:19">लेकिन बौ पल्टैगो और उनको पीछा करैगो।”<verse eid="GEN 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“आसेर की जमीन से भरपूर अन्न उपजैगो।</para>
  <para style="q1" vid="GEN 49:20">बौ राजा के ताहीं काबिल अन्न बंदोबस्त करैगो।”<verse eid="GEN 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />नप्ताली एक हिरन है जो आजाद हुईकै दौड़थै,</para>
  <para style="q1" vid="GEN 49:21">बाकी बोली बालकन के हानी मीठी है।<verse eid="GEN 49:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“यूसुफ फलवन्त हँगईय्या है,</para>
  <para style="q1" vid="GEN 49:22">झरना के किनारे लगी फलवन्त हँगईय्या,</para>
  <para style="q1" vid="GEN 49:22">बाकी हँगईय्या दीवार मैं फैली है।”<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />धनुर्धारी बाके ऊपर भयानक हमला करीं;</para>
  <para style="q1" vid="GEN 49:23">बाके ऊपर तीर छोड़ीं; बाकै गजब सताईं।<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />लेकिन बाको धनुस ठौंड़ रहो,</para>
  <para style="q1" vid="GEN 49:24">और बाकी भुजा मजबूत ही जाथैं</para>
  <para style="q1" vid="GEN 49:24">याकूब कै सक्तिसाली परमेस्वर की ताकत से,</para>
  <para style="q1" vid="GEN 49:24">बरदिया के जरिया, इस्राएल को रखबरिया।<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />तेरे दऊवा को परमेस्वर ही तेरी मदत करथै</para>
  <para style="q1" vid="GEN 49:25">सर्वसक्तिमान परमेस्वर जो तोकै आसीस देथै</para>
  <para style="q1" vid="GEN 49:25">ऊपर से बारिस कै आसीस के संग</para>
  <para style="q1" vid="GEN 49:25">और पृथ्वी के नीचे गहरे पानी की आसीस,</para>
  <para style="q1" vid="GEN 49:25">अनगिनत स्तन और गर्भासय की आसीस देगो।<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />तेरे दऊवा के आसीर्वाद,</para>
  <para style="q1" vid="GEN 49:26">हमेसा पर्वतन के आसिर्वादन के अपेक्छा,</para>
  <para style="q1" vid="GEN 49:26">सनातन पहाड़ियन के वरदानन से जाधा महान हुई गै हैं।</para>
  <para style="q1" vid="GEN 49:26">बे यूसुफ के मुड़िया मैं ठहरैं, और बाके मुकुट मैं ठहरैं,</para>
  <para style="q1" vid="GEN 49:26">जो अपने भईय्यन से बिछड़ गौ रहै।<verse eid="GEN 49:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“बिन्यामीन एक खतरनाक भेड़िया के तराहनी है।</para>
  <para style="q1" vid="GEN 49:27">बौ संजा-सुबेरे घात करैगो और खा जागो।”<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />जे इस्राएल के बारह कुल हैं, और इनको दऊवा जो-जो वचन से आसीर्वाद दई रहै जे बेईं हैं और एक-एक कै इनके काबिल के हिसाब से आसीर्वाद दई।<verse eid="GEN 49:28" /></para>
  <para style="s">याकूब की मौत और दफनानो</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />फिर याकूब अपने लौड़न कै आग्या दई, कि अब मैं अपने लोगन के संग मरन मै हौं, जहे ताहीं मोकै हित्ती एप्रोन के खेत की गुफा मै मेरे पुरखन झोने मट्टी दियो। <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />मोकै बौ गुफा मैं गाड़िये जो कनान देस मैं ममरे के अगार की दिसा मैं मकपेला की हमीन मैं है, जोकै अब्राहम निजी कब्रिस्तान बनान के ताहीं हित्ती जाति के एप्रोन से जमीन सुंदा मोल लई रहै। <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />हूँनै पर अब्राहम और बाकी बईय्यर सारा कै दफनाओ गौ रहै; “हूँनै इसहाक और बाकी बईय्यर रिबका कै दफनाओ गौ रहै; और हूँनै पर मैं लिआ कै दफनाओ। <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />बौ खेत और बहे मै की गुफा हित्तियन से धन दैकै मोल लई गई रहै। मोकै हूँनै दफनाए दियो।” <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />जब याकूब अपने लौड़न कै सूचना दै चुको, तभई बौ खटिया मै अपने पाँव पसारी और अपनी ज्यान छोड़ दई।<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />यूसुफ अपने दऊवा के पाँव मै गिर गौ, तौ रोन लगो और बाको चैहरा कै चूमन लगो। <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />फिर यूसुफ वैधन कै अपने दऊवा की लास कै खुसबूदार करन के ताहीं आदेस दई, तौ इस्राएल के वैध लास मैं खुसबूदार द्रव्य भर दईं। <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />यूसुफ अपने बेदन कै आदेस दई कि खुसबूदार लेप लगामैं, और बेद लास मै लेप लगाईं, और लास कै लेप लगान मैं, चालीस दिन को समय लगो। मिस्री लोग बाके ताहीं सत्तर दिन ले विलाप करीं।<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />जब सोक को समय खतम ही गौ, तौ यूसुफ राजा के अधिकारी से कही, “महरबानी करकै जौ खबर फिरौन राजा ले पहुँचाओ: <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />जब मेरो दऊवा मरन बारो रहै, तौ बौ मोसे वादा करबाई कि मैं बौ कबर मै दफन करंगो जो बौ कनान देस मैं तैयार करी रहै। तौ महरबानी करकै मोकै जान दे और मोकै मेरे दऊवा कै दफनान दे, और फिर मैं बापस आमंगो।”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />राजा फिरौन जबाब दई, “जा और अपने दऊवा कै दफनाए आ, जैसो तुम वादा करे रहौ।”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />जौ बजह से यूसुफ अपने दऊवा कै दफनान गौ। राजा के सब अधिकारी, और दरबार के बड़े पदाधिकारी लोग और मिस्र के सब बड़े-बूढ़े और खास लोग यूसुफ के संग गै। <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />यूसुफ को पूरो परिवार, सब भईय्या और बाके दऊवा के पूरे परिवार के इनके संग गै। सिरफ इनके छोटे बालका और भेड़-बकरिया और जानवर गोसेन देस की सीमा मै रहगै। <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />बाके संग रथ मै सवार और घोड़ा मै सवार लोग भी गै; जौ एक भौत बड़ो झुंग रहै।<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />जब बे यरदन नदिया के अगार आताद के खलिहान मै पुगे, तौ बे भौत देर ले ऊँची आवाज मै विलाप करत रहे, और यूसुफ सात दिन ले सोक की बरसी मनाईं। <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />जब कनानी के रहन बारे आताद मै इनकै विलाप करत देखीं, तौ बे कहीं, “मिस्री लोग सोक की कैसे गंभीर बरसी मनाएरै हैं!” जहे बजह से बौ जघा को नाओं आबेलमिस्रैम पड़ो, और बौ यरदन नदिया के पार है।<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />तौ याकूब के लौड़ा बैसिये करीं जैसो बौ उनकै आग्या दई रहै; <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />बे बाकी लास कै कनान लै गै और ममरे के अगार मकपेला की गुफा मै दफनाए दईं, जो अब्राहम कबरिस्तान के ताहीं हित्ती एप्रोन से खरीदी रहै। <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />यूसुफ अपने दऊवा कै दफनान के बाद, और अपने सब भईय्या और बे सबन के संग मै मिस्र लौट आओ जो बाके संग मैजल मै गै रहैं।<verse eid="GEN 50:14" /></para>
  <para style="s">यूसुफ अपने भईय्यन कै आस्वासन दई</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />अपने दऊवा की मौत के बाद, यूसुफ के भईय्या आपस मै कहमैं, “का होगो अगर यूसुफ हबै भी हमसे नफरत करत होगो और हम सब बाकै जो नुकसान पहोंचाय हैं बाको बदला हमसे लेन की योजना बनात होगो?” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />जौ बजह से बे यूसुफ कै संदेस भेजीं: हमरो दऊवा मरने से पहले, हमैं जौ आग्या दई रहै, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />“यूसुफ से कहिये कि बौ कृपा करकै अपने भईय्यन के अपराध और पाप कै छमा करै; काहैकि बे बाके संग बुराई करी रहैं।” अब कृपा करकै अपने दऊवा के परमेस्वर के सेवकन के अपराध माफ करदे। जब बे जौ बात यूसुफ से कहीं तौ बौ रोए पड़ो।<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />फिर बाके भईय्या खुदै आए कै बाके सामने दंड़वत करीं। बे कहीं, “हिंयाँ हम सब तेरे सामने तेरे सेवक हैं।”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />लेकिन यूसुफ उनसे कही, मत डराबौ; मैं खुद कै परमेस्वर की जघा मै नाय रख सकथौं। <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />तुम मेरे खिलाप बुराई की साजिस बनाए, लेकिन परमेस्वर जाकै अच्छाई मै बदल दई, ताकी तमान लोग जिंदे बचैं, जैसे बे आज भी जिंदे हैं। <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />तुम मत डराबौ। मैं तुमरो और तुमरे बालकन को ख्याल रखंगो। तौ बौ दयालु सब्दन से उन्हैं समझाए-बुझाएकै सांती दई।<verse eid="GEN 50:21" /></para>
  <para style="s">यूसुफ की मौत</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />यूसुफ अपने परिवार के संग मिस्र मै रहन लगो; और जब बौ मरो तौ बाकी उमर एक सौ दस साल की होथै। <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />यूसुफ एप्रेम के बालका और नतिया-नतनिया कै देखन तक जिंदो रहो। बौ मनस्से के लौड़ा माकीर के बालकन के परिवार तक जिंदो रहो। <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />यूसुफ अपने भईय्यन से कही, “मैं मरन बारो हौं, लेकिन परमेस्वर जरूर तुमरी परवाह करैगो, और तुम्हैं जौ देस से बौ देस मै लै जागो जो वादा बौ अब्राहम, इसहाक, और याकूब कै दई रहै।” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />फिर यूसुफ इस्राएलियन से जौ कहकै कि परमेस्वर जरूर तुमरी सुधि लेगो, उनकै जौ बारे मैं कसम खबाई, “हम तेरी हड्डियन कै हिंयाँ से बौ देस ले लै जांगे।”<note caller="+" style="f"><char style="fr" closed="false">50:25 </char><char style="ft" closed="false">इब्रानियों 11:22</char></note> <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />यूसुफ एक सौ दस साल की उमर मै मिस्र मै मर गौ। बे बाकी लास मै लेप लगाएकै और बाकै ताबूत मै धर दईं।<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>