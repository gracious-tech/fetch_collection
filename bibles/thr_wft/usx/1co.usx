<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Rana Tharu</book>
  <para style="h">1 कुरिन्थियों</para>
  <para style="toc3">1 कुरिन्थियों</para>
  <para style="toc2">1 कुरिन्थियों</para>
  <para style="toc1">कुरिन्थियों कै पौलुस की पहली चिट्ठी</para>
  <para style="mt2">कुरिन्थियों को पौलुस की पहली चिट्ठी</para>
  <para style="mt1">कुरिन्थियों कै पौलुस की पहली चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">1 कुरिन्थियन कै प्रेरित पौलुस ईसु के पैदा होन के लमसम 55 साल बाद लिखी रहै। जौ दुई अक्छरन मैं से पहलो है जो पौलुस कुरिन्थ सहर की कलीसिया कै लिखी रहै। हुई सकथै बौ: इफिसुस सहर मैं रहेन पोती कुरिन्थ सहर के सफर से पहले मकिदुनिया के रस्ता मैं अपनी चिट्ठी लिखी होबै<char style="xt"><ref loc="1CO 16:5-9">16:5-9</ref></char>। जौ चिट्ठी लिखो होन के अनुसार बुनियाद को जबाब है, जो कलीसिया के कुछ जनिन से, कलीसिया मैं निरी अनैतिक प्रथा के बारे मैं मिली रहैं, जिनमैं न्यारे होनो और यौन अनैतिकता सामिल रहै। कुरिन्थ सहर अपनी लैंगिक अनैतिकता के ताहीं अच्छे तरीका से जानो जात रहै। तही जौ, अचम्मो मानन की बात नाय है कि हूँना कलीसिया जे सब मुद्दन को सामना करत रहैं। 1 कुरिन्थियन मैं मानो जान बारो <char style="xt"><ref loc="1CO 13">13</ref> </char>मो अध्याय प्यार है।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. परिचय। <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">2. कलीसिया मैं कारक। <char style="ior"><ref loc="1CO 1:10-4:21">1:10–4:21</ref></char></para>
  <para style="io1">3. यौन नैतिकता और पारिवारिक जिंदगी। <char style="ior"><ref loc="1CO 5:1-7:40">5:1–7:40</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">नमस्ते</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />पौलुस के घाँईं से जोकै परमेस्वर की मरजी से ईसु मसीह को प्रेरित कहो गौ रहै, और भईय्या जोको नाओं सोस्थिनेस है के तरफ से।<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:1">प्रेरितो 18:1</ref>
      </char>
    </note>परमेस्वर की बौ कलीसिया जो कुरिन्थुस नगर मैं है, बे सब जो मसीह मैं पवित्र लोग कहे जाथैं, और हर जघा जो हमरे प्रभु ईसु मसीह के नाओं से प्रार्थना करथैं:<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />हमरे परम दऊवा परमेस्वर और प्रभु ईसु मसीह के घाँईं से तुमकै दया और सांति मिलत रहबै।<verse eid="1CO 1:3" /></para>
  <para style="s">मसीह मैं आर्सिवाद</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />मैं तुमरे बारे मैं अपने परमेस्वर को धन्यवाद हमेसा करथौं, जहे बजह से परमेस्वर को जौ दया तुमरे ऊपर ईसु मसीह मैं भौ। <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />कि बामै हुईकै तुम सबै बातन मैं मतलब सबै बचन और सबै ग्यान मैं सेठ करे गै। <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />कि मसीह को संदेस तुमरे मैं पक्को हुई गौ है <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />हिंयाँ ले कि कोई आध्यात्मिक उपहार मैं तुमकै कमी नाय भइ, और तुम हमरे प्रभु ईसु मसीह के दिखाई देन कै असियात रहथौ। <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />बौ तुमकै आखरी ले कसे रखागो, कि तुम हमरे प्रभु ईसु मसीह के दिनन मैं बिना गलती के माने जाबौ। <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />परमेस्वर भरोसेमंद है; जो तुमकै अपने लौड़ा हमरे प्रभु ईसु मसीह की संगती मैं मस्काई है।<verse eid="1CO 1:9" /></para>
  <para style="s">कलीसिया मैं फूट</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />भईय्यौ और बहेनियौ, मैं तुमसे ईसु मसीह जो हमरो प्रभु है बाके नाओं से नहोरे करथौं, कि तुम सब एकै बात कहबौ और तुम मैं फूट ना पड़ै, लेकिन एकै मन और एकै मकसद मैं रहकै मेल-जोल से रहबौ। <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />काहैकि मेरे भईय्यौ, खलोए नाओं की बईय्यर के घराने के आदमी मोकै तुमरे बारे मैं बताईं हैं, कि तुमरे बीच मैं लड़ाई होथैं। <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />मेरो जौ कहनो है, कि तुम मैं से कोई तौ अपने आपकै कहथै कि मैं “पौलुस को पछलगुआ हौं,” कोई कहथै मैं “अपुल्लोस को पछलगुआ हौं,” कोई कहथै “कैफा<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">पतरस</char></note>को पछलगुआ हौं,” और कोई दुसरे कहथैं कि मैं “मसीह को पछलगुआ हौं।” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />का मसीह कै झुंड मैं बाँटो गौ है? का पौलुस तुमरे ताहीं क्रूस मैं चढ़ाओ गौ? या तौ तुम पौलुस के चेला हौ या बाके नाओं से बपतिस्मा मिलो है?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />मैं परमेस्वर को धन्यवाद करथौं, कि क्रिस्पुस<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">कुरिन्थुस के यहूदि सभाघर को अधिकारी रहै</char></note> और गयुस<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ROM 16:23">रोमियों 16:23</ref></char></note> नाओं के आदमी कै छोड़कै, मैं तुम मैं से कोई कै बपतिस्मा नाय दौ हौं। <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />कहूँ ऐसो ना होबै, कि कोई कहबै, कि तुमकै मेरे नाओं से बपतिस्मा दौ गौ है और तुम मेरे चेला हौ। <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" /><note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 कुरिन्थियों 16:15</ref></char></note>ओ हाँ, मैं स्तिफनास के घराने कै भी बपतिस्मा दौ हौं; लेकिन मोकै याद ना है कि इनकै छोड़कै मैं कोई कै बपतिस्मा दौ कि ना। <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />काहैकि मसीह मोकै बपतिस्मा देन ताहीं नाय, बल्किन सुसमाचार सुनान कै भेजी है, और जहो इंसानन के बोल के ग्यान के हानी नाय, ऐसो ना होबै कि मसीह को क्रूस बेकार मानो जाबै।<verse eid="1CO 1:17" /></para>
  <para style="s">परमेस्वर कि सक्ति और ग्यान मसीह है</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />क्रूस की कहानी नास होन बारेन के ताहीं मूर्खता है; लेकिन हमरे ताहीं जो हम बचाए भै हैं, परमेस्वर की सामर्थ्य है। <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" /><note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">यसायाह 29:14</ref></char></note>सास्त्र कहथै:</para>
  <para style="q1" vid="1CO 1:19">“मैं अकल बारेन के अकल कै खतम करंगो,</para>
  <para style="q2" vid="1CO 1:19">और समझदारन की समझकै बेकार कर देंगो।”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:20 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 12:17">अय्यूब 12:17</ref>
      </char>
    </note>कितै गौ जौ दुनिया को ग्यानी? कितै गौ यहूदि नियम के सिक्छक? कितै गौ जौ युग को बहस करन बारो? का परमेस्वर युग के ग्यान कै बेबकूफी की बात ना बताई!<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />जब परमेस्वर के ग्यान के हानी, दुनिया ग्यान से परमेस्वर कै नाय जानी तौ परमेस्वर कै जौ अच्छो लगो, कि जौ उपदेस की “बेवकूफ” बात से बिस्वास करन बारेन कै बचाबै। <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />यहूदि तौ सबूत के ताहीं चिन्ह माँगथैं, और यूनानी ग्यान कै ढूँड़ रै हैं। <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />लेकिन हम तौ बौ क्रूस मैं चढ़ाय भै मसीह को प्रचार करथैं जो यहूदियन के झोने ठोकर की बजह, और गैर यहूदि के झोने बकवास की बात है; <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />पर जो मस्काए गै हैं का यहूदि, का यूनानी, उनके झोने मसीह परमेस्वर की सामर्थ्य, और परमेस्वर को ग्यान है। <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />काहैकि परमेस्वर की मूर्खता इंसानन के ग्यान से कहीं ग्यानवान है; और परमेस्वर की निर्बलता इंसानन के बल से भौत बलबान है।<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />भईय्यौ और बहेनियौ, खुद के मस्काए जान के बारे मैं सोचौ, कि नाय तौ सरीर से भौत ग्यान बारे, और नाय भौत सामर्थी, और ना भौत समाज मैं नाओं बारे मस्काए गै रहौ। <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />लेकिन परमेस्वर दुनिया के मूर्खन कै चुन लई है, कि ग्यान बारेन कै सरम बामै; और परमेस्वर दुनिया के निर्बलन कै चुन लई है, कि बलबानन कै सरम बामै। <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />और परमेस्वर दुनिया के गिरे भै और बेकारन कै, बल्किन उन्हऊँ कै जो ना के बराबर हैं, चुन लई है, जिनकै खतम करन के ताहीं दुनिया सोचथै। <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />जोसे कोई इंसान परमेस्वर के सामने घमंड ना दिखाबै। <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />लेकिन परमेस्वर तुमकै मसीह मैं धार्मिकता के संग जोड़कै सौंप दई है, और परमेस्वर मसीह ईसु कै हमरो ग्यान बनाये दई है। बहे के लिहाज से हम परमेस्वर के संग सई माने गै हैं, कि हम परमेस्वर के पवित्र जन और छुटकारा पामैं। <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" /><note caller="+" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JER 9:24">यिर्मयाह 9:24</ref></char></note>ताकी जैसो सास्त्र कहथै “जो घमंड करै तौ बौ प्रभु मैं घमंड करै।”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">सूली मैं चढ़े भै मसीह के बारे मैं सन्देस</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />भईय्यौ और बहेनियौ, जब मैं परमेस्वर को भेद सुनात भौ तुमरे झोने आओ, तौ बचन या ग्यान की अच्छाई के संग नाय आओ। <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />मैं जौ ठान लौ रहौं, कि तुमरे बीच ईसु मसीह, बल्किन क्रूस मैं चढ़ाय भै मसीह कै परखौ और कोई बात कै नाय जानौ। <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" /><note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">प्रेरितो 18:9</ref></char></note>तभई जब मैं तुमरे झोने आओ, मैं कमजोर रहौं और डर से कपकपात रहौं, <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />और मेरो प्रचार और संदेस कै इंसानी ग्यान के कुसल सब्दन के संग नाय दौ गौ, लेकिन परमेस्वर की आत्मा के सामर्थ्य के संग। <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />जहे बजह से कि तुमरो बिस्वास इंसानन के ग्यान मैं नाय, लेकिन परमेस्वर की सामर्थ्य के ऊपर आसरो होबै।<verse eid="1CO 2:5" /></para>
  <para style="s">परमेस्वर को ग्यान</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />फिर भी मैं बे लोगन कै ग्यान को संदेस देथौं जो आत्मिक रूप से मजबूत है। लेकिन जौ ग्यान ना है जो जौ युग से संबंधित है या बे सक्तियन से जो जौ दुनिया के मुखिया राज करथैं, ऐसी सक्तियैं जो अपनी सक्ति खोए रइ हैं। <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />जो ग्यान की मैं घोसड़ाँ करथौं, बौ परमेस्वर की लुकी भइ बुद्धि है, जो इंसानन से लुको भौ है, लेकिन जोकै बौ युग बनान से पहलिये हमारी महिमा के ताहीं चुनी रहै। <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />जोकै जौ युग के मुखियन मैं से कोईये बाकी महिमा ना जानी, काहैकि अगर जानते, तौ बे प्रकासमान प्रभु कै क्रूस मैं ना चढ़ाते। <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />हालाकि, जैसो सास्त्र कहथै,</para>
  <para style="q1" vid="1CO 2:9">“जो आँखी नाय देखीं<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">यसायाह 64:4</ref></char></note>, और जो कान नाय सुनीं, और जो बात इंसान के मन मैं नाय चढ़ी, बेईं हैं,</para>
  <para style="q1" vid="1CO 2:9">जो परमेस्वर अपने प्यार करन बारे के ताहीं समारीं हैं।”<verse eid="1CO 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10" />लेकिन परमेस्वर उनकै अपनी आत्मा से हममैं दिखाई; आत्मा सबै बातन, बल्किन परमेस्वर की गहरी बातन कै भी परखथै। <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />इंसानन मैं से कौन इंसान की बातन कै जानथै, सिरफ इंसान की आत्मा जो बामै है? बैसिये परमेस्वर की बातन कै भी कोई नाय जानथै, सिरफ परमेस्वर की आत्मा जानथै। <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />हमैं जौ दुनिया की आत्मा नाय मिली है; जाके बजाय, हमैं परमेस्वर के जरिया भेजी भइ आत्मा मिली है, ताकी हम बौ सब जान सकैं, जो परमेस्वर हमकै सौंपी है।<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />तौ फिर, जिनकै हम इंसानन के ग्यान की सिखाई भइ बातन मैं नाय, लेकिन पवित्र आत्मा की सिखाई भइ बातन मैं, आत्मा, आत्मिक ग्यान से आत्मिक सच्चाई के बारे मैं बताथै। <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />जो इंसान पास आत्मा नाय है, बौ परमेस्वर की आत्मा से आनबारे वरदानन कै नाय पाय सकथै। ऐसो आदमी हकीकत मैं उनकै नाय समझथै, और बे बकबास कर रै हैं, बे बहे की नजर मैं बेकार की बातैं हैं, और ना बौ उनकै जान सकथै काहैकि बाकी परिक्छा आत्मिक तरहन से होथै। <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />हालाकि, जो भी आत्मिक है, सब चीज कै परखन मैं काबिल है, लेकिन कोई भी बाको परिक्छा करन मैं काबिल नाय है। <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />जैसे की सास्त्र कहथै:</para>
  <para style="q1" vid="1CO 2:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:16 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:13">यसायाह 40:13</ref>
      </char>
    </note>“प्रभु के मन कै कौन जानथै?</para>
  <para style="q2" vid="1CO 2:16">प्रभु कै कौन सलाह दै सकथै?”</para>
  <para style="m" vid="1CO 2:16">हालाकि, हम मसीह को दिमाक रखथैं।<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">परमेस्वर के सेवा करन बारे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />मेरे भईय्यौ और बहेनियौ, हकीकत मैं, मैं तुमसे बात नाय कर सकथौं मैं बे आदमिन से बतकाथौं जो आत्मिक है; जैसी तुम जौ सरीर से हौ, बैसिये मोए तुमसे बात करने रहै, और उनसे जो मसीह मैं बालका हैं। <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" /><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12">इब्रानियों 5:12</ref>,<ref loc="HEB 5:13">13</ref></char></note>मैं तुमकै दूद पिबाओ हौं, खानु नाय खबाओ हौं; काहैकि तुम बाकै नाय खाए पाते; बल्किन हबै ले नाय खाए पाथौ, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />काहैकि तुम अभैले अपने सरीर के स्वभाव से काबू मैं हौ। तुम एक दूसरे से नफरत करथौ और एक दूसरे से लड़थौ। का जौ साबित ना होथै कि तुम अपने सरीर के स्वभाव से काबू मैं हौ? का तुम दुनिया के लोगन के हानी नाय जी रै हौ? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" /><note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 कुरिन्थियों 1:12</ref></char></note>जब एक कहथै, “मैं पौलुस को हौं,” और दुसरो, “मैं अपुल्लोस को हौं,” का तुम दुनिया के लोगन के हानी बर्ताव ना कर्‌रै हौ?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />अपुल्लोस कौन है? और पौलुस कौन है? सिरफ सेवा करन बारे सेवक हैं, जोसे तुम बिस्वास करे, जैसे कि सबन कै प्रभु दई: <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" /><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">प्रेरितो 18:4-11</ref></char></note>मैं बीज लगाओ, अपुल्लोस छींची, लेकिन परमेस्वर बढ़ाई। <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />तभईये ना तौ लगान बारो कछु है और ना छींचन बारो, लेकिन परमेस्वरै सब कछु है जो बढ़ान बारो है। <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />लगान बारो और छींचन बारो एक है; लेकिन सबै आदमी अपनी मेहनत से अपनिए कमाई पामंगे। <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />हम परमेस्वर के सहकर्मी हैं।</para>
  <para style="p" vid="1CO 3:9">तुम परमेस्वर की खेती और परमेस्वर के बनाये भै इमारत हौ। <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />परमेस्वर जो मेरे ऊपर दया करी, बाको इस्तमाल करकै, मैं एक अच्छे मिस्त्री को काम करो और बुनियाद डारो, और कोई अब बाके ऊपर काम कर रौ है। लेकिन हर कै सावधान रहनो चाहिए कि बौ कैसे बनाथै। <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />बौ बुनियाद कै छोड़कै जो पड़ी है, और बौ ईसु मसीह है, दुसरो कोई बौ बुनियाद नाय डार सकथै।<verse eid="1CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 3:12" />अगर कोई जौ बुनियाद मैं सोनो या चाँदी या खूबै कीमती पथरा या कठिया या घाँस-फूस को रद्दा रखै। <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />तौ सबन को काम दिखाई दै जागो; काहैकि बौ दिन बाकै बतागो, तभईये कि आगी के संग दिखाई देगो और बौ आगी सबन को काम परखैगी कि कैसो है। <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />जो-जोको काम बामै बनो भौ टिको रहागो, बौ दिहाड़ी पागो। <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />अगर कोई को करम बाकी आगी मैं जर जागो, तौ बाको नुकसान उठान पड़ैगो; लेकिन फिरौंकी बौ खुदै बैयसिये बच जागो जैसे कि कोई आगी लगे भै घर मैं से भाज कै निकर जाथै।<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:16 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:19">1 कुरिन्थियों 6:19</ref>
      </char>
    </note>का तुम ना जानथौ, कि तुम खुदै परमेस्वर को मंदिर हौ, और परमेस्वर को आत्मा तुमरे मैं रहथै! <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />अगर कोई परमेस्वर के मंदिर कै खतम कर देगो तौ परमेस्वर बाकै खतम कर देगो; परमेस्वर को मंदिर पवित्र है, और बौ तुम हौ।<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />कोई अपने आपकै धोका ना देबै। अगर तुम मैं से कोई जौ युग मैं अपने आपकै ग्यानी समझै, तौ मूर्ख बनै कि ग्यानी हुई जाबै। <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" /><note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">अय्यूब 5:13</ref></char></note>जौ दुनिया को ग्यान परमेस्वर के झोने मूर्खता की बात है, जैसो सास्त्र कहथै, “बौ ग्यानियन कै उनकी चलाँकी मैं फसाए देथै” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" /><note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">भजन संहिता 94:11</ref></char></note>और फिर, “प्रभु ग्यानियन के मन की बातन कै जानथै, कि बे मन की बात बेकार हैं।” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />तभईये इंसानन के ऊपर कोई घमंड ना करै, काहैकि सबै कछु तुमरो है: <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />का पौलुस, का अपुल्लोस, का कैफा<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">पतरस</char></note>, का दुनिया, का जिंदगी, का मौत, का हबै को समय, का गुजरो समय, सबै कछु तुमरो है, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />और तुम ईसु मसीह के हौ, और मसीह परमेस्वर को है।<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">मसीह के प्रेरित</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />तुमकै हमैं मसीह को सेवक के रूप मैं सोचनो चाहिए, जिनकै परमेस्वर कि गुप्त सच्चाईयन को प्रबंधक बनाओ गौ है। <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />ऐसे सेवकन के ताहीं एक बात जरूरी है कि बे अपने प्रबंधक के प्रति भरोसेमंद रहमैं। <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />अब, मैं तुमरे जरिये या कोई भी मानवीय मानक के बारे मैं चिंतित ना हौं; मैं खुद की भी नाय परिक्छा करथौं। <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />मेरो मन मोकै दोसमुक्त ठहराथै, काहैकि मेरो प्रभु मोकै अजमाथै। <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />इसलै तुमकै सई समय आन से पहले कोई के ऊपर फैसला लागू ना करनो चाहिए। आखरी फैसला प्रभु के आन तक असियानो चाहिए; बौ अंधियारे रहस्यन कै उजिते मैं लागो और लोगन के मन के छिपे उद्देस्यन कै उजागर करैगो। और तौ सब परमेस्वर से बे बड़ाँईं पांगे जिनके बे हकदार हैं।<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />भईय्यौ और बहेनियौ, मैं जे बातन मैं तुमरे ताहीं अपनी और अपुल्लोस की बात-चीत कहानी के जैसी करो हौं, तभईये कि तुम हमसे जौ सीखौ, “कि सास्त्र मैं जो लिखो है बासे अग्गु मत बढ़ौ,” और एक के घाँईं से और दुसरे के बिरोध मैं घमंड मत करियो। <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />तुमकै दूसरे से बड़ो कौन बनाओ? का परमेस्वर तुमकै बौ सब कछु ना दई जो तुमरे पास है? ठीक है, तौ, तुम कैसे भेद-भाव कर सकथौ, जैसे कि तुमरे पास कोई उपहार नाय है?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />का तुमरे झोने पहले से सब कछु है जो तुमकै चाहिए? का तुम पहलेई से सेठ हौ? का तुम राजा ना हौ, भलेई हम ना हैं? खैर, मेरी इच्छा है कि तुम बास्तव मैं राजा रहो, ताकी हम तुमरे संग मिलकै राजा बन सकैं। <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />मेरी समझ से परमेस्वर हम प्रेरितन कै सबन के बाद बे आदमिन के हानी मानी है, जो-जो कि मौत की आग्या हुई चुकी है; काहैकि हम दुनिया और स्वर्गदूतन और इंसानन के ताहीं एक खिलबाड़ बन गै हैं। <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />हम मसीह मैं बेअकली हैं; लेकिन तुम मसीह के संग समझदार हौ! हम कमजोर हैं, लेकिन तुम मजबूत हौ! तुम आदर पाथौ लेकिन हमरो आदर नाय होथै! <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />हम आज तक भूंके-प्यासे हैं; और नंगे हैं, और घूँसा खाथैं और मारे-बितारे फिरथैं; <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">प्रेरितो 18:3</ref></char></note>और अपनेई हातन के काम करकै मेहनत करथैं, आदमी बुरो कहथैं, हम आसीस देथैं; बे सताथैं, हम सकार लेथैं; <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />जब हमरी बेजती होथै, तौ हम दयालु सब्दन के संग नहोरे करथैं। हम दुनिया के मैल हैं और बन गै हैं। हम कछुए नाय हैं!<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />मैं तुमकै सर्मबान ताहीं जे बातन कै नाय लिखथौं, लेकिन अपने प्रिय बालका जानकै तुमकै चिताथौं। <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />अगर मसीह मैं तुमरे सिखान बारे दसौ हजार होते, तहुँओं तुमरे बाबा भौत से नाय होते, तभई ईसु मसीह मैं सुसमाचार के जरिया मैं तुमरो बाबा बन गौ हौं। <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" /><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 कुरिन्थियों 11:1</ref>; <ref loc="PHP 3:17">फिलिप्पियों 3:17</ref></char></note>मैं तुमसे नहोरे करथौं, कि मेरे हानी चाल चलौ। <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />तभईये मैं जोको नाओं तीमुथियुस है, और जो मेरो प्रिय और भरोसा बारो लौड़ा है, तुमरे झोने पनारो हौं, और बौ तुमकै प्रभु ईसु मसीह मैं मेरे बर्ताव कै याद दिबागो, जैसे कि मैं सबै जघा सब कलीसियन मैं उपदेस देथौं।<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />तुम मैं से कुछ लोग गरब महसूस करथैं काहैकि तुम सोचे हौ कि मैं तुमसे मिलन ना आंगो। <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />अगर प्रभु तैयार है, हालाकि, मैं जल्दिये तुमरे झोने आंगो, और फिर मैं अपने ताहीं बौ सामर्थ्य को पता लगांगो जो जे गरब करन बारे लोगन के पास है, और ना कि सिरफ बे जो कहथैं। <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />परमेस्वर को राज्य बातन मैं नाय है, लेकिन सामर्थ्य मैं है। <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />तुम का पसंद करैगे? का मैं लठिया लैकै तुमरे झोने आमौं या प्यार और नमरता की आत्मा के संग आमौं?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">कलीसिया के अनुसासन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 22:30">व्यवस्थाविवरन 22:30</ref>
      </char>
    </note>अब हिंयाँ ले सुनन मैं आओ है, कि तुम मैं व्यभिचार होथै, बल्किन ऐसो व्यभिचार जो गैर यहूदि मैं भी नाय होथै, कि एक लोग अपनी सौतेली अईय्या के संग सोथै! <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />फिर, का तुम गरब कर सकथौ? जाके उल्टा, तुमकै उदासी से भरो होनो चाहिए, और जो आदमी ऐसो करी है बाकै तुमरी संगती से बाहर निकार देनो चाहिए। <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />भलेई मैं सरीर मैं तुमरे सामने नाय हौं, मैं आत्मा मैं तुमरे संग हौं। लेकिन जब हुँआँ रहौं, तौ मैं जौ आदमी के ताहीं पहलेई से फैसला लागू कर चुको हौं <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />प्रभु ईसु के नाओं मैं तुम कलीसिया कि एक बैठक बुलाए सकथौ। मैं आत्मा मैं तुमरे संग मौजूद रहेंगो, और ऐसिये हमरे प्रभु ईसु कि सामर्थ्य होगी। <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />इंसान के सरीर के बिनास के ताहीं सैतान कै सौंपो जाबै, ताकी बाकी आत्मा प्रभु ईसु के दिन बच पाबै।<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 5:9">गलातियों 5:9</ref>
      </char>
    </note>तुमरो घमंड करनो अच्छो नाय है! का तुम नाय जानथौ, “की जरा सो खमीर पूरे मड़े भै चून कै खमीर कर देथै।” <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" /><note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">निर्गमन 12:5</ref></char></note>तुमकै पाप के पुराने खमीर कै निकारने होगो ताकी तुम पूरी तरह सुद्ध हुई जाबौ। फिर तुम बिना कोई खमीर के चून को नै घना के हानी होगो, जैसो कि मैं जानथौं कि तुम बास्तव मैं हौ। हमरे फसह के त्योहार के ताहीं तैयार है, अब जब कि मसीह, हमरे फसह को मेमना, बलिदान करो गौ है। <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" /><note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">निर्गमन 13:7</ref>; <ref loc="DEU 16:3">व्यवस्थाविवरन 16:3</ref></char></note>सो तुम आबौ हम परव मैं खुसी मनामैं, नाय तौ पुराने खमीर से और नाय बुराई और दुस्टता के खमीर से, बल्किन सीदे और सच्चाई की अखमीरी रोटी से।<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />मैं अपनी चिट्ठी मैं तुमकै लिखो हौं, की व्यभिचारियन की संगती मत रखियो। <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />जौ नाय, कि तुम कतईये जौ दुनिया के व्यभिचारियन, लालचिन, अंधेर करन बारे, या मूर्ति पूजा करन बारेन की संगती करन कै बाध्य बनौ; काहैकि जौ हाल मैं तौ तुमकै दुनिया मैं से निकर जानो चाहिए। <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />मेरो जौ कहनो है की; अगर कोई भईय्या कहवाएकै, व्यभिचारी, लालची, मूर्ति पूजा करन बारो, गारी देन बारो, पियक्कड़, या अंधेर करन बारो होबै, तौ बाके संग संगती मत रखियो; बल्किन ऐसे इंसानन के संग खानुओ मत खईयो।<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 13:5">व्यवस्थाविवरन 13:5</ref>; <ref loc="DEU 17:7">17:7</ref></char>
    </note>मोकै बहार बारेन को फैसला करन से का मतलब? का तुम भीतर बारेन को हिसाब ना करथौ? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />लेकिन बहार बारेन को फैसला परमेस्वर करथै, “तभईये बौ बुरे काम करन बारे कै अपने झुंड मैं से निकार देबौ।”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">मसीहियन के बीच मुकदमा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />का तुम मैं से कोई के पास इतनी हिम्मत है, की जब दुसरे संग लड़ाई होबै, तौ फैसला करन के ताहीं अधर्मियन के झोने जाबै; और पवित्र लोगन के झोने नाय जाबै? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />का तुम नाय जानथौ, की पवित्र लोग दुनिया को फैसला करंगे? और जब तुमकै दुनिया को हिसाब करने है, तौ का तुम छोटी से छोटी लड़ाई को भी मुकदमा करन के भी काबिल नाय हौ? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />का तुम नाय जानथौ, कि हम स्वर्गदूतन को हिसाब करंगे? तौ का दुनिया की बातन को फैसला नाय कर सकथैं! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />अगर तुमकै दुनिया की बातन को मुकदमा करने होबै, तौ का उन्हईं कै बैठागे जो कलीसिया मैं कछु नाय समझे जाथैं? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />मैं तुमकै लज्जित करन ताहीं जौ कहथौं! का तुम मैं से एकौ अकल बारे नाय हैं, जो अपने मसीह भईय्यन के बीच फैसला कर सकै। <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />बल्किन भईय्या-भईय्या मैं फैसला होथै, और बहो गैरविस्वासियन के सामने!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />सच्ची को तुम मैं बड़ो दोस तौ जौ है, कि आपस मैं मुकदमा करथौ, बल्किन अन्याय काहे नाय सहथौ? अपनो नुकसान काहे नाय उठाथौ? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />बल्किन अन्याय करथौ और नुकसान पहोंचाथौ, और बहो भईय्यन और बहेनियन कै! <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />का तुम नाय जानथौ, की अधर्मी परमेस्वर के राज्य के बारिस ना होंगे? धोका मत खाबौ, नाय व्यभिचारी, नाय मूर्ति पूजा करन बारे, नाय दुसरेन की बईय्यर कै अपनो बनाये लेन बारे, नाय लुच्चे, नाय कोई आदमी कै अपनो बनान बारे बनौ <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />नाय चुट्टा, ना लालची, ना पियक्कड़, ना गारी देनबारे, ना अंधेर करन बारे परमेस्वर के राज्य के बारिस होमंगे। <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />और तुम मैं से कित्ते समर्पित रहैं, लेकिन तुम प्रभु ईसु मसीह के नाओं से और हमरे परमेस्वर की आत्मा से धोए गै हौ, और पवित्र भै और धर्मी बने।<verse eid="1CO 6:11" /></para>
  <para style="s">सरीर और आत्मा मैं परमेस्वर की महिमा</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:12 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:23">1 कुरिन्थियों 10:23</ref>
      </char>
    </note>सबै चीज की मेरे ताहीं इजाजत है, हाँ; लेकिन सब चीज सई नाय हैं, और “मैं कोई बात के सुपर्त नाय होंगो।” <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />“खानु पेट के ताहीं, और पेट खानु के ताहीं है,” हाँ; लेकिन परमेस्वर जाकै और बाकै दोनों कै खतम करैगो, लेकिन सरीर व्यभिचार के ताहीं नाय, बल्किन प्रभु के ताहीं है; और प्रभु सरीर के ताहीं है। <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />और परमेस्वर अपनी सामर्थ्य से प्रभु कै मरे मैं से जिंदो करी, और हमउँ कै जिंदो करी।<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />का तुम नाय जानथौ, की तुमरो सरीर मसीह को अंग है? तौ का मैं मसीह के सरीर को अंग लैकै उनकै वेस्या को अंग बनामौं? कतई नाय! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" /><note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्पत्ति 2:24</ref></char></note>का तुम नाय जानथौ की जो कोई वेस्या से संगती रखथै, बौ बाके संग एक सरीर हुई जाथै सास्त्र कहथै, “बे दोनों एक तन होंगे।” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />और जो प्रभु की संगती मैं रहथै, बौ बाके संग एक आत्मा हुई जाथै।<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />व्यभिचार से बचे रहबौ और जित्ते पाप इंसान करथैं, बे सरीर के बहार हैं, लेकिन व्यभिचार करन बारो अपनेई सरीर के खिलाप पाप करथै। <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" /><note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरिन्थियों 3:16</ref>; <ref loc="2CO 6:16">2 कुरिन्थियों 6:16</ref></char></note>का तुम नाय जानथौ, कि तुमरो सरीर पवित्र आत्मा को मंदिर है, जो तुम मैं बसो भौ है और तुमकै परमेस्वर के घाँईं से मिलो है? और तुम अपने नाय हौ, लेकिन परमेस्वर हौ; <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />परमेस्वर तुमकै दाम दैकै मोल लई है, तभईये अपने सरीर से परमेस्वर की महिमा करौ।<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">बिहा के बारे मैं सबाल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />बे जे बातन के बारे मैं जो तुम लिखे हौ, जौ अच्छो है।</para>
  <para style="p" vid="1CO 7:1">की लोग बईय्यर कै ना छुइबै। <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />लेकिन व्यभिचार के डर से सब लोगन की अपनी बईय्यर, और सब बईय्यर के अपने लोगा होनो चाहिए। <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />लोगा अपनी बईय्यर को कर्तव्य पूरो करै; और बैसिये बईंय्यरैं अपने लोगा को। <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />बईय्यर कै अपनी सरीर मैं अधिकार नाय है पर बाके लोगा को अधिकार है; बैसिये लोगा कै भी अपने सरीर मैं अधिकार नाय है, लेकिन बईय्यर कै है। <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />जबले तुम पहली बार प्रार्थना मैं अपनो समय बितान के ताहीं थोड़ी समय के लै ऐसो करन के ताहीं सहमत नाय होथौ, तौले एक दूसरे से खुदकै इंकार ना करैं; लेकिन फिर सामान्य सादी सुदा रिस्ता कै फिर से सुरु करैं। ऐसे करकै तुमकै अपने आत्मनियंत्रड़ कि कमी कि बजह से सैतान के लालच मैं देन से रखो जागो।<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />लेकिन मैं जो जौ कहथौं बौ मेरो कहनो है, नाय कि आग्या है। <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />मैं जौ चाहथौं, की जैसो मैं हौं, बैसिये सब इंसान होमैं; लेकिन सबन कै परमेस्वर के घाँईं से जरूरी उपहार मिले हैं; कोई कै कैसियौ, और कोई कै कोई और जैसी को।<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />अब मैं बिना बिहा बारिन और बिधवन के बारे मैं कहथौं, कि उनके ताहीं ऐसिये रहनो अच्छो है, जैसो मैं हौं। <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />लेकिन अगर बे खुदकै ना रोक सकैं, तौ बिहा कर लेमैं; काहैकि बिहा करनो रहन से अच्छो है।<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">मत्ती 5:32</ref>; <ref loc="MAT 19:9">19:9</ref>; <ref loc="MRK 10:11">मरकुस 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">लूका 16:18</ref></char>
    </note>जिनको बिहा हुई गौ है, उनकै मैं नाय, बल्किन प्रभु आग्या देथै, की बईय्यर अपने लोगा से न्यारे ना होबै; <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />और अगर समझौता हियो जाबै, तौ दुसरो बिहा करे बगैर रहबै; या अपने लोगा से फिर से मिल जाबै और नाय लोगा अपनी बईय्यर कै तलाक दैकै छोड़ै।<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />दुसरेन से तौ प्रभु नाय, लेकिन महीं, कहथौं, अगर कोई मसीह भईय्या की बईय्यर बिस्वास नाय करत होबै, और बाके संग रहेन ताहीं खुस होबै, तौ बौ बाकै नाय छोड़ै। <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />और जो मसीह बईय्यर को लोगा अविस्वास होबै, और बाके संग रहेन ताहीं खुस होबै; बौ लोगा कै नाय छोड़ै। <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />ऐसो लोगा जो अविस्वासी है, बौ समर्पित बईय्यर के बजह से पवित्र मानो जाथै, और ऐसी बईय्यर जो बिस्वास नाय करथै, विस्वासी भईय्या के बजह से पवित्र मानी जाथै; नाय तौ तुमरे बालका असुद्ध होते, लेकिन अब तौ पवित्र हैं। <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />लेकिन जो आदमी अविस्वासी है, और बौ न्यारे होबै, तौ न्यारे होन देबौ, ऐसे हालात मैं कोई भईय्या या बहेनिया, बंधे भै गुलाम नाय हैं; लेकिन परमेस्वर तौ हमकै सांति के ताहीं बुलाई है। <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />हे मसीह बईय्यर, का तैं जानथै, की तू अपने लोगा को उद्धार करबाय लेगी? और आदमी, तहूँ जानथै का, कि अपनी बईय्यर कै बचा लेगो?<verse eid="1CO 7:16" /></para>
  <para style="s">जियौ बैसे जैसी परमेस्वर कही है</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />पर जैसे प्रभु सबन कै बाँटी है, और जैसे परमेस्वर सबन कै बुलाई है; बैसिये बर्ताव चलै: और मैं सब कलीसियन मैं ऐसिये ठहरातौ हौं। <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />जो खतना करो भौ बुलाओ गौ है, बौ बिना खतना जैसो नाय बनै: जो बिना खतना के बुलाए गै हैं, बे खतना नाय करामै। <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />ना खतना कछु है, और ना ही बगैर खतना करो भौ, लेकिन परमेस्वर की आग्या कै माननो सब कछु है। <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />सबै जनी जो जैसे हाल मैं परमेस्वर बुलाए गै हैं, बहे मैं रहामैं। <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />अगर तैं दास के हाल मैं बुलाओ गौ है तौ फिकर मत करै; और अगर तैं आजाद हुई सकै, तौ ऐसिये काम कर। <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />जो दास के हाल मैं बुलाओ गौ है, बौ प्रभु को आजाद करो भौ है, और बैसिये जो आजाद के हाल मैं बुलाओ गौ है, बौ मसीह को दास है। <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />तुम कीमत दाम दैकै मोल लै भै हौ, इंसानन के दास मत बनौ। <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />हे भईय्यौ और बहेनियौ, जो कोई जैसे हाल मैं बुलाओ गौ है, बौ बहे मैं परमेस्वर के संग रहबै।<verse eid="1CO 7:24" /></para>
  <para style="s">बगैर बिहा बारी और बिधवन के बारे मैं सबाल</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />कुवाँरिन के बारे मैं प्रभु से मोकै कोई आग्या नाय मिली है, पर भरोसेमंद होन के ताहीं जैसी दया प्रभु मेरे ऊपर करी है, बहे भरोसे सलाह देथौं।<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />सो मेरी समझ से जौ अच्छो है, की आज कल कलेस की बजह से इंसान जैसी है बैसिये रहबै। <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />अगर तेरी बईय्यर है तौ, अलग होन की कोसिस मत करै: और अगर तेरी बईय्यर नाय है, तौ बईय्यर की खोज मत करै। <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />और अगर तैं बिहा करै, तौ पाप नाय है; अगर कुवाँरी बिहाई जाए तौ कोई पाप नाय है; पर ऐसेन कै सारीरिक दुख होगो, और मैं बचानो चाहथौं।<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />भईय्यौ मैं जौ कहथौं, कि समय कम करो गौ है, तभई चहाईये कि जोकी बईंय्यरैं हैं, बे ऐसे होमैं मानौं उनकी बईंय्यरैं नाय हैं। <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />और रोन बारे ऐसे होमैं, मानौ बे रोतै नाय हैं; और आनन्द करन बारे ऐसे होमैं, मानौ आनन्द नाय करथैं; और मोल लेन बारे ऐसे होमैं, कि मानौ उनके झोने कछु हईये नाय। <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />और जौ दुनिया के संग रबईय्या करन बारे ऐसे होमैं, कि दुनिया के नाय हुई लेमैं; जौ दुनिया की रीत और रबईय्या बदलत जाथैं।<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />मैं जौ चाहथौं, कि तुमकै चिंता नाय होबै। बिना बिहा के आदमी प्रभु की बातन की चिंता मैं रहथैं, कि प्रभु कै कैसे करकै खुस रखै। <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />लेकिन बिहा बारे आदमी दुनिया की बात की चिंता मैं रहथै, कि अपनी बईय्यर कै कौन सी रीति से खुस रखै। <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />बिहा बारी और कुवाँरी मैं भी फरक है: बिना बिहा बारी प्रभु की चिंता मैं रहथै, की बौ सरीर और आत्मा दोनों मैं पवित्र होबै, लेकिन बिहा बारी दुनिया की चिंता मैं रहथै, की अपने लोगा कै खुस रखै।<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />जौ बात तुमरियै फायदे के ताहीं कहथौं, नाय की तुमकै फसान के ताहीं, बल्कि जैसो सुहाथै बैसिये करो जाए; की तुम एक चित्त हुईकै प्रभु की सेवा मैं लगे रहबौ।<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />और अगर कोई जौ समझै, कि मैं अपनो कुवाँरीपन को हक मार रहो हौं, जोकी जवानी ढल रइ है, और जोको इरादो होबै, तौ बौ बाध्य नाय है उनके ताहीं सई है, जामैं कोई पाप नाय है, बौ बाको बिहा होन देबै। <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />पर जो मन मैं फैसला करथै, और बौ अपने अधिकारन कै मार सकथै, तौ बौ कुवाँरी रहे कै अच्छो करथै। <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />तौ जो अपनी कुवाँरी को बिहा कर देथै, बौ अच्छो करथै और जो बिहा ना कर पाथै, बौ औरौ अच्छो करथै।<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />जब तक कोई बईय्यर को लोगा जिंदो रहथै, तब तक बौ बासे बंधी भइ है, लेकिन जब बाको लोगा मर जाए तौ, जोसे चाहबै बिहा कर सकथै, लेकिन सिरफ प्रभु मसीह मैं। <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />और जैसी है अगर बैसिये रहाबै, तौ मेरी समझ से औरौ धन्य है, और मैं समझथौं, की परमेस्वर को आत्मा महुँ मैं है।<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">मूर्तियन कै चढ़ाओ भौ खान के बारे मैं सबाल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />अब मूर्तियन के अग्गु चढ़ाई भइ बलि के बारे मैं हम जानथैं।</para>
  <para style="p" vid="1CO 8:1">की हम सबन कै ग्यान है: ग्यान घमंड पैदा करथै, लेकिन प्यार से उन्नति होथै। <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />अगर कोई समझै, कि मैं कछु जानथौं, तौ जैसो जाननो चहाईये बैसो अब तक नाय जानीं। <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />अगर कोई परमेस्वर कै प्यार करथै, तौ बाकै परमेस्वर जानथै।<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />तौ मूर्तियन के अग्गु चढ़ाई बलि कै खान के बारे मैं हम जानथैं, की मूर्ति दुनिया मैं कोई चीज नाय है, और एक कै छोड़कै कोई परमेस्वर हईये नाय। <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />अगर स्वर्ग और धरती मैं निरे ईस्वर कहे जाथैं, जैसे कि निरे ईस्वर और निरे प्रभु हैं, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />तहुँओं हमरे झोने तौ एकै परमेस्वर है, मतलब; दऊवा परमेस्वर जोके घाँईं से सबै चीज हैं, और हमउँ बहे के ताहीं हैं, और एकै प्रभु है, मतलब ईसु मसीह जोसे सब चीज हैं और हमउँ बहे से हैं।<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />लेकिन सबन कै जौ ग्यान नाय है; पर कित्ते तौ अब तक मूरत कै मन मैं कछु समझथैं, मूर्तियन के अग्गु बलि करी भइ चीजन कै समझकै खाथैं। उनके ऐसो करन से उनकी आत्मा कमजोर होन के बजह से असुद्ध हुई जाथै। <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />खानु हमकै परमेस्वर के झोने नाय लै जागो, अगर हम बाकै नाय खाथैं तौ कछु नुकसान नाय, और अगर खांए तौ कछु फायदा नाय।<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />पर चौकन्ने रहबौ, ऐसो ना होबै कि, तुमरो जौ अधिकार कहूँ बिस्वास मैं कमजोरन के ताहीं ठोकर ना हुई जाए। <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />अगर तैं “अग्यानी” कै मूर्ति के मंदिर मैं बलि खात देखै, और बौ बिस्वास मैं कमजोर है, तौ का बाके मन मैं मूर्ति के अग्गु चढ़ाई भइ चीज कै खान की हिम्मत नाय हुई जागी? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />ऐसे तेरे ग्यान के बजह से बौ कमजोर भईय्या जोके ताहीं मसीह मरो, अपने ग्यान के ताहीं नास हुई जागो! <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />तौ मसीह भईय्यन के गलती करन से और बाके कमजोर मन कै चोट लगान से तुम मसीह के ताहीं पाप करथौ। <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />जौ बजह से अगर खानु मेरे भईय्या और बहेनिया कै ठोकर खबाबै, तौ मैं कहु कैसियौ रीति से सिकार नाय खांगो, ऐसो ना होबै कि मैं अपने भईय्या के ताहीं ठोकर को बजह बनौ।<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">एक प्रेरित को हक और फर्ज</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />का मैं आजाद ना हौं? का मैं प्रेरित ना हौं? का मैं ईसु को जो हमरो प्रभु है, ना देखो? का तुम प्रभु मैं मेरे बनाये भै ना हौ? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />अगर मैं औरन के ताहीं प्रेरित नाय हौं, तहुँओं तुमरे ताहीं तौ हौं! काहैकि तुम प्रभु मैं मेरे प्रेरित होन को प्रमाड़ रहौ।<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />जो मोकै अजमाथैं, उनके ताहीं मेरो जहे जबाब है: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />का हमकै खान-पीन को अधिकार नाय है? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />का हमकै जौ अधिकार नाय है, की कोई मसीह बहेनिया कै बिहा करकै संग लैकै घूमैं, जैसे की दुसरे प्रेरित और प्रभु के भईय्या और कैफा करथैं? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />या सिरफ मोकै और बरनबास कै जौ अधिकार नाय कि कमाई करनो छोड़ै? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />कौन कहु अपनी झुंड से खाएकै सिपईय्या को काम करथै? कौन अंगूर की बारी लगाएकै बाको फरा ना खाथै? कौन भेंड़न की रखबारी करकै उनको दूद ना पीथै?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />मोकै अपने आपकै जे रोज मर्‌रा के उदाहरड़ ले सीमित ना रखने है, काहैकि नियम एकै बात कहथै। <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" /><note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 24:4">व्यवस्थाविवरन 24:4</ref>; <ref loc="1TI 5:18">1 तीमुथियुस 5:18</ref></char></note>का नियम जौ नाय कहथै? कि मूसा के नियम मैं जौ लिखो है “दाँए लगात पोती बरधन के मोहों मैं मुसीका मत भाँदिये।” का परमेस्वर बरधनौं की फिकर करथै? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />या जरूरी करकै हमरे ताहीं कहथै। हाँ, हमारियै ताहीं लिखो गौ है, ठीक है, कि जोतन बारो आसा से जोतै, और दाँए लगान बारो भागीदार होन की आसा से दाँए लगावै। <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" /><note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">रोमियों 15:27</ref></char></note>अगर हम तुमरे ताहीं आत्मिक चीज कै बोए हैं, तौ का जौ बड़ी बात है? की तुमरी सरीर के चीजन की फसल काटैं। <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />जब औरन को तुमरे ऊपर जौ भागीदारी और अधिकार है, तौ हमरो जासे जाधे ना होगो? लेकिन जौ हक हम काम मैं नाय लाए; पर सबै कछु सकारथैं, कि हमसे मसीह के सुसमाचार की कछु रोक-टोक ना होबै। <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" /><note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 18:1">व्यवस्थाविवरन 18:1</ref></char></note>का तुम ना जानथौ की जो मंदिर मैं सेवा करथैं; बे मंदिर से खाथैं: और बेदी मैं चढ़ावा चढ़ान बारेन कै बलि को हिस्सा मिलथै। <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" /><note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्ती 10:10</ref>; <ref loc="LUK 10:7">लूका 10:7</ref></char></note>जहे रीति से प्रभु भी ठहराई है, कि जो आदमी सुसमाचार सुनाथैं, उनकी जीविका सुसमाचार से होबै।<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />लेकिन मैं इनमैं से एकौ बात काम ना लाओ! और जे बेकार की बातन कै मैं जहे के मारे ना लिखो, कि मेरे ताहीं ऐसो होबै, काहैकि जासे तौ मेरो मरनोई भलो है; कि कोई मेरो घमंड खाली मूली ठहराबै। <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />अगर मैं सुसमाचार सुनामौ, तौ मेरो कछु घमंड नाय है; जौ मेरे ताहीं जरूरी है; और अगर मैं सुसमाचार ना सुनामौ, तौ मेरे ताहीं कितनो भयानक है! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />काहैकि अगर अपनी मरजी से जौ करथौं, तौ दिहाड़ी मोकै मिलथै, और अगर अपनी मरजी से ना करतो, तहुँओं बिस्वास से भंडारी पन मोकै सौंपो गौ है। <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />तौ फिर मेरी कौन सी दिहाड़ी? जौ की सुसमाचार सुनान मैं, मैं मसीह को सुसमाचार सेंत मेंत कर देओं; हिंयाँ ले की सुसमाचार मैं जो मेरो अधिकार है, बाकै मैं पूरी तरहन से काम मैं लामौं।<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />सबसे आजाद होन मैं भी मैं अपने आपकै सबन को गुलाम बनाये दौ हौं; कि जाधे आदमिन कै जीत लामौं। <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />मैं यहूदिन के ताहीं यहूदि बनो कि यहूदियन कै खींच लामौं, जो आदमी नियम के अधीन हैं उनके ताहीं मैं नियम के अधीन नाय होन मैं भी नियम के अधीन बनो, कि उनकै जो नियम के अधीन हैं, जीत लामौं। <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />बैसिये, जब गैर यहूदियन के संग काम करत समय, मैं अधर्मी गैर यहूदियन कै जीतन के ताहीं, यहूदि नियम के बाहर गैर यहूदियन के तराहनी रहथौं। जाको मतलब जौ ना है कि मैं परमेस्वर के नियम को पालन ना करथौं; मैं बास्तव मैं मसीह के नियम के अधीन हौं। <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />मैं बिना बल बारेन के ताहीं बिना बल को सो बनो, की बिना बल बारेन कै खींच लामौं, मैं सबै इंसानन के ताहीं सबै कछु बनो हौं, कि कैसियो ना कैसियो करकै निरेन के बचामौं।<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />और मैं सब कछु सुसमाचार के ताहीं करथौं, कि मैं औरन के ताहीं भागीदार हुई जामौं। <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />का तुम नाय जानथौ, की दौड़ मैं दौड़त सबै हैं, लेकिन इनाम एकै लै जाथै। तुम बैसिये करकै दौड़ौ, की जीत जाबौ। <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />और सबै खिलाड़ी सबै तरहान को संयम रखथै, बे तौ एक मुरझान बारे मुकुट कै पान ताहीं जौ सब करथैं, लेकिन हम तौ बौ मुकुट के ताहीं करथैं, जो अमर है। <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />तभई मैं तौ ऐसेई करकै दौड़थौं, लेकिन बगैर ठिकाने को नाय, महुँ ऐसियै करकै मुक्कन से लड़थौं, लेकिन बाके हानी नाय जो ब्यार मैं मुक्का चलाथै। <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />लेकिन मैं अपनी सरीर कै मारत कूटत, और बस मैं लाथौं; ऐसो ना होबै की औरन कै प्रचार करकै, मैं अपने आपै कोई रीति से निकम्मो ठहरौं।<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">मूर्तियन के खिलाप चितौनी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:12">निर्गमन 13:12</ref>,<ref loc="EXO 13:22">22</ref>; <ref loc="EXO 14:22-29">निर्गमन 14:22-29</ref></char>
    </note>भईय्यौ और बहेनियौ, मैं नाय चाहथौं, कि तुम जौ बात से अनजान रहबौ, कि हमरे सब पुरखा जो मूसा के पच्छू हुई लई रहैं बादर की छाँईं मैं सफर करत रहैं, और लाल समुंदर के बीच से बौ पाँजर चले गै। <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />और बे सब बादर मैं, और समुंदर मैं मूसा से बपतिस्मा लेत रहैं। <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" /><note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">निर्गमन 16:35</ref></char></note>और सबै एकै आत्मिक खानु खाईं हैं <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" /><note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">निर्गमन 17:6</ref>; <ref loc="NUM 20:11">गिनती 20:11</ref></char></note>सबै एकै आत्मिक पानी पीं, काहैकि बे बौ आत्मिक चट्टान से पीत रहैं, जो उनके संगै-संग चलत रहै; और बौ चट्टान ईसु मसीह रहै। <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" /><note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29">गिनती 14:29</ref>,<ref loc="NUM 14:30">30</ref></char></note>लेकिन परमेस्वर उनमैं से निरेन से खुस नाय रहै, तभईये बे बन मैं मर कै ढेर हुईगै।<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />जे बातैं हमरे ताहीं उदाहरड़<note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">गिनती 11:4</ref></char></note> बनी, कि जैसे बे लालच करीं, बैसिये हम बुरी चीजन को लालच नाय करैं। <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" /><note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">निर्गमन 32:6</ref></char></note>तुम मूर्ति पूजा करन बारे मत बनौ; जैसे कि उनमैं से कित्ते बन गै रहैं, जैसे कि सास्त्र कहथै, “आदमी खान-पीन कै एक दावत मैं बैठगै, जो पीन-पान और व्यभिचार को खुल्लो नाच बन गौ।” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" /><note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">गिनती 25:1-18</ref></char></note>हम व्यभिचार नाय करैं, जैसी उनमैं से कित्ते ऐसो करीं और एकै दिन मैं तेइस हजार मर गै। <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" /><note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5">गिनती 21:5</ref>,<ref loc="NUM 21:6">6</ref></char></note>हम मसीह कै आजमामैं भी नाय, जैसे उनमैं से कितने करीं, और साँपन के काटन से बे मर गै। <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />हमैं सिकायत ना करनो चाहिए, जैसो कि उनमैं से कुछ करी रहैं, और उनकै मौत के दूत के जरिये खतम कर दौ गौ रहै।<note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">गिनती 16:41-49</ref></char></note><verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />लेकिन जे सबै बात, जो उनके ऊपर भईं, उदाहरड़ के हानी रहैं; और बे चितौनी हमरे ताहीं हैं जो युग के आखरी समय मैं रहथैं लिखी गईं हैं।<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />तभई बौ, जो ऐसो समझथै कि बौ निठाठौर टिको है, चौकन्नो रहबै कि कहीं गिर ना पड़ै। <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />तुम कोई ऐसी परिक्छा मैं नाय पड़े, जो इंसान के झेलन से बहार है: और परमेस्वर भरोसे बारो है: बौ तुमकै सामर्थ्य से बहार परिक्छा मैं नाय पड़न देगो, बल्कि परिक्छा के संग बहार भी निकारैगो; कि तुम सकार सकौ।<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />जहे बजह से, हे मेरे प्रिय जनौं, मूर्ति पूजा से बचे रहबौ। <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />मैं तुमकै दिमाकदार जानकै, तुमसे कहथौं, जोमैं कहथौं: बाकै तुम परखौ। <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" /><note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">मत्ती 26:26-28</ref>; <ref loc="MRK 14:22-24">मरकुस 14:22-24</ref>; <ref loc="LUK 22:19">लूका 22:19</ref>,<ref loc="LUK 22:20">20</ref></char></note>हम प्रभु के संगती मैं जोकै प्यालो को इस्तमाल करथैं और जोके ताहीं हम परमेस्वर को धन्यवाद देथैं: जब हम जाकै पीथैं, तौ हम मसीह के खून मैं साझा होथैं। और रोटी हम तोड़थैं: और खाथैं, तौ हम मसीह के सरीर मैं साझा कर रै हैं। <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />हम सबै रोटी के भागीदार हैं, हालाकि, तमान सरीर हैं, हम सबै एकै टुकड़ा बाटथैं।<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:18 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 7:6">लैव्यवस्था 7:6</ref>
      </char>
    </note> जो सरीर के भाव से इस्राएली हैं, उनकै देखौ, जो बेदी मैं चढ़ी भइ बलि खाथैं, का बलिदान कै खान बारे बेदी के भागीदार ना हुई जाथैं। <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />फिर मैं का कहथौं? का मूर्ति कै दौ भौ बलि कछु है, या मूरत कछु है? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" /><note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">व्यवस्थाविवरन 32:17</ref></char></note>कतई ना! पर मेरो माननो जौ है कि बलिदान दुसरे जाति के चढ़ाथैं, बे उनकै परमेस्वर कै नाय प्रेत आत्मा कै चढ़ाथैं। मैं नाय चाहथौं की तुम उनके संग भागीदार बनौ। <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />तुम प्रभु के कटोरा, और प्रेत आत्मा के कटोरा दोनों मैं से नाय पी सकथौ। तुम प्रभु की मेज और प्रेत आत्मन की मेज मैं भागीदार नाय हुई सकथौ। <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" /><note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">व्यवस्थाविवरन 32:21</ref></char></note>का हम प्रभु कै गुस्सा दिबान के ताहीं कर रै हैं? का हम प्रभु से जाधे सक्ति बारे हैं?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:23 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:12">1 कुरिन्थियों 6:12</ref>
      </char>
    </note>“मेरे ताहीं सब चीजन की इजाजत तौ हैं,” लेकिन सब कछु फायदा की नाय है, “सब चीज ठीक तौ है” लेकिन सब कछु फायदेमंद ना है। <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />तुम अपनो भलो करन को मत सोचौ, पर दुसरेन को भलो करन को ख्याल रखौ।<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />तुम आजाद हौ, जो कुछ सिकार बाजार मैं बिकथै, बौ खाबौ, और अपने मन के कारड़ कछु मत अजमाऔं <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" /><note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">भजन संहिता 24:1</ref></char></note>“काहैकि सास्त्र कहथै, धरती मैं जो कछु है, सबै कछु प्रभु की भरपूरी है।”<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />और गैरविस्वासी तुमकै आदर करकै हटकना करै, और तू जानो चाहबै, तौ जो कछु तुमरे अग्गु परसो जाए, बहे खईयो; और मन के कारड़ कछु मत अजमावौ। <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />लेकिन अगर कोई तुमसे कहबै, “जौ तौ मूर्तियन कै चढ़ाई भइ चीज है,” तौ बहे बतान बारे के बजह से, और अपने मन की बजह से मत खाबौ। <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />बौ है, अपनो मन नाय, बल्कि दूसरे आदमी को मन “ठीक है, फिर,” कोई पूँछथै, “मेरी आजादी के ताहीं काम कोई दूसरे आदमी के विवेक से काहेकै परखनो चाहिए?” <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />“अगर मैं धन्यवाद दैकै बौ चीज मैं भागीदार होथौं, तौ जोके ताहीं मैं धन्यवाद करथौं, बहे कि बजह से मेरी बुराई काहेकै होथै?”<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />तभई तुम चाँहे खाबौ, चाँहे पीबौ, चाँहे जो कछु करने होबै करौ, सबै कछु परमेस्वर की महिमा के ताहीं करौ। <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />तुम नाय तौ यहूदि, नाय यूनानि, और नाय परमेस्वर की कलीसिया के ताहीं ठोकर को कारड़ बनौ। <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />जैसे कि महुँ सबै बातन मैं सबन कै खुस रखथौं, और अपनो नाय, लेकिन निरेन को फायदा होबै ऐसो कछु ढूँड़थौं, कि बे बच जामैं।<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="s">आराधना करन पोती मूड़ ढोंकनों</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 कुरिन्थियों 4:16</ref>; <ref loc="PHP 3:17">फिलिप्पियों 3:17</ref></char>
    </note>जैसे मैं मसीह के हानी चलथौं बैसिये तुम्हऊँ मेरे हानी चलौ। <verse eid="1CO 11:1" /><verse number="2" style="v" sid="1CO 11:2" />मैं तुमरी बड़ाँईं करथौं, कि तुम सबै बातन मैं मोकै याद करथौ; और जो रीत रबईय्या मैं तुमकै सौंप दौ हौं, उनकै माने करथौ। <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />लेकिन मैं जौ चाहथौं कि तुम जौ जानलेबौ कि सब लोगन को मूड़ मसीह है, और बईय्यर को मूड़ लोग है और मसीह को मूड़ परमेस्वर है। <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />जो लोग मूड़ ढोंककै प्रार्थना या भविस्यवाँड़ी करथै, बौ अपने मूड़ मसीह की बदनामी करथै। <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />और जो बईय्यर अपनो मूड़ उत्कार कै सार्वजनिक प्रार्थना मैं भविस्यवाँड़ी करथै, बौ अपने मूड़ की बेजती करथै, बौ टकली होन के बराबर है। <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />अगर बईय्यर अर्घना नाय ओहोड़ै, तौ उस्तरा लगबाए लेबै; अगर बईय्यर के ताहीं बार कटबानो या फिर उस्तरा धरबानो सरम की बात है, तौ अर्घना ओहोड़ै। <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" /><note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26">उत्पत्ति 1:26</ref>,<ref loc="GEN 1:27">27</ref></char></note>लेकिन लोग कै अपनो मूड़ जरूरी ढोंकनों सई नाय है, बौ परमेस्वर को स्वरूप और महिमा कै दिखाथै, लेकिन बईय्यर लोग की छाप है; <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" /><note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">उत्पत्ति 2:18-23</ref></char></note>लोग बईय्यर से नाय भौ है, पर बईय्यर लोग से भइ है। <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />और लोग बईय्यर के ताहीं नाय सिरजो गौ है पर बईय्यर लोग के ताहीं सिरजी गई है। <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />तभईये स्वर्गदूतन के कारड़ बईंय्यरन को अच्छो है, कि अपने लोगा के अधिकार मैं रहकै, अपने मूड़ कै तोप कै रखैं। <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />प्रभु मैं हमरे जीवन मैं, हालाकि, बईंय्यरैं आदमी से आजाद ना हैं, और ना हि आदमी बईंय्यरन से आजाद हैं। <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />जैसे बईय्यर आदमी से बनी रहै, बैसिये बईय्यर से आदमी पैदा होथै; और जौ परमेस्वर है जो सब कछु अस्तित्व मैं लाथै।<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />अब तुम्हईं अजमावौ: का बईय्यर कै मूड़ उत्कार कै परमेस्वर से प्रार्थना करनो सोभा देथै? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />का प्रकृति अपने आपै जौ नाय बताथै कि लम्बे बार रखानो लोगन के ताहीं सरम की बात है, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />जाके बाबजूद बईंय्यरन के लम्बे बार उनकी महिमा हैं काहैकि जे बाकै ओढ़नी के ताहीं दै गै हैं। <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />लेकिन अगर जौ बारे मैं कोई और है जो जिरहबाजी करनो चाहथै तौ, बौ जौ समझ लेबै कि परमेस्वर की कलीसिया मैं ऐसियै रीत है।<verse eid="1CO 11:16" /></para>
  <para style="s">प्रभु भोज के बारे मैं</para>
  <para style="r">(<ref loc="MAT 26:26-29">मत्ती 26:26-29</ref>; <ref loc="MRK 14:22-25">मरकुस 14:22-25</ref>; <ref loc="LUK 22:14-20">लूका 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />लेकिन जौ आग्या देत भौ मैं तुम्हारी बड़ाँईं नाय कर्‌रौ हौं: सभाघरन मैं तुमरे जुरान से भलाई नाय लेकिन बुराइये होथै। <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />सबसे पहली बात तौ जौ है कि मैं सुनों हौं तुम जो आपस मैं कलीसिया मैं जब जुराथौ तौ तुमरे बीच मैं लड़ाई होथैं ऐसो मेरे सुनन मैं आओ है और मोकै थोड़ी सो विस्वासौ है। <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />काहैकि जौ बात सच्ची है कि तुमरे बीच मैं बटबारो होनो जरूरी है कि बे, जो परमेस्वर मैं खरे निकरे हैं, उजीतो मैं आए जामैं। <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />सो तुम जो एक जघा मैं इखट्टे होथौ, तौ प्रभु भोज खान के ताहीं नाय। <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />खानु खान की बेरा एक दूसरे से पहले अपनो खानु खाए लेथौ, सो कोई तौ भूंको रह जाथै और कोई मतवारो हुई जाथै। <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />का खान पीन के ताहीं तुमरे अपने घर नाय हैं? या परमेस्वर की कलीसिया कै तुच्छ जानथौ और जिनके पास कछुए नाय है उनकै सर्मिंदा करथौ, मैं तुमसे का कहमौं? का जौ बात मैं तुम्हारी बड़ाँईं करौं? कतईये नाय!<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />मोकै जो सिक्छा प्रभु से मिली रहै, बौ मैं पहलिये से तुमकै दै दौ: जो रात ईसु कै पकड़बाओ गौ रहै, मसीह रोटी लई, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />धन्यवाद दई और बाकै तोड़ी और कही, “तुमरे ताहीं मेरो जौ सरीर है, ऐसो मेरी याद के ताहीं करे करियो।” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />ऐसियै रीति से खानु खान के बाद बौ कटोरा लईं और कहीं, “जौ कटोरा मेरे खून मैं नई वाचा है, जब कहु तुम जाकै पीबौ तौ मेरी याद मैं ऐसोई करे करियो।”<note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:8">निर्गमन 24:8</ref>; <ref loc="JER 31:31-34">यिर्मयाह 31:31-34</ref>; <ref loc="EXO 24:6-8">निर्गमन 24:6-8</ref></char></note><figure style="fig" alt="Jesus eating the Passover meal with his disciples" file="lb00320c.tif" size="span" copy="Horace Knowles ©" ref="11:23">ईसु अपने चेलन के संग फसह को खानु खात भइ</figure><verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />जब कभई तुम जौ रोटी खाथौ, और जौ कटोरा मैं से पीथौ, तौ तुम प्रभु की मौत को जब तक बौ नाय आए, प्रचार करथौ। <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />तभई जो कोई गलत तरीका से प्रभु की रोटी खाथै, या बाके कटोरा मैं से पीयै, बौ प्रभु की सरीर और खून को अपराधी होगो। <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />सो पहले अपने आपकै परखौ, और जहे रीति से रोटी मैं से खाबै और कटोरा मैं से पियै। <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />जो प्रभु की सरीर कै खात-पीत फैसला नाय करै, तौ बौ खान और पीन से अपने ऊपर मुकदमा लाथै। <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />जहे बजह से तुम मैं कित्ते बिमार और कमजोर हैं, और निरे मरियो गै। <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />अगर हम पहलियै अपने आपकै आजमा लेते तौ, फैसला नाय होतो। <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />लेकिन प्रभु हमैं आजमाय कै हमारी ताड़ना करथै ताकी हम दुनिया के संग सजा के हकदार नाय ठहरैं।<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />तभईये, मेरे प्रिय भईय्यौ जब तुम प्रभु भोज खान ताहीं जुराथौ, तौ एक दुसरे कै असियाय करौ। <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />और अगर तुम मैं से कोई भी भूंको होबै, तौ तुमकै घरईये खानु खानो चहाईये, जोसे तुम एक संग मिलथौ तौ सजा की वजह नाय होबै। और बाकी बातन कै मैं खुद आयकै ठीक कर देंगो।<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">पवित्र आत्मा के वरदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />भईय्यौ और बहेनियौ, मैं नाय चाहथौं कि तुम आत्मिक वरदानन के बारे मैं अनजान रहबौ। <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />तुम जानथौ कि जब तुम गैर यहूदि रहौ, तौ जो मूर्ति बोलतै नाय हैं तुम उन्हईं के रहामैं चलत रहौ। <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />तभई मैं तुमसे जौ कहथौं कि कोई आदमी जो परमेस्वर की आत्मा के घाँईं है, बौ ऐसो कहु नाय कहथै कि “ईसु स्रापित है!” और पवित्र आत्मा के बगैर कोई ऐसियो नाय कह सकथै कि “ईसु प्रभु है।”<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:6-8">रोमियों 12:6-8</ref>
      </char>
    </note>निरे तरहन के वरदान हैं, लेकिन आत्मा तौ एकै है। <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />और सेवकाई भी निरे तरहन की हैं, लेकिन एकै प्रभु कि सेवा करी जाथै। <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />और प्रभावसाली काम निरे तरहन के हैं, लेकिन परमेस्वर एकै है, जो सब मैं सबै तरहन को प्रभाव पैदा करथै। <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />सबन की भलाई के ताहीं सबै आदमिन मैं आत्मा कि उपस्थिति कैसियो करकै दिखाई दै जाथै। <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />एक कै आत्मा जरिये बुद्धि से भरो संदेस दौ जाथै, जबकी दुसरे कै बहे आत्मा अनुसार ग्यान से भरो संदेस देथै। <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />और एकै आत्मा एक आदमी कै बिस्वास देथै, जबकी दुसरे आदमी कै बहे आत्मा चंगो करन को वरदान देथै। <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />आत्मा एक आदमी कै सामर्थी काम करन की सक्ति देथै; तौ हूँनै दुसरे आदमी कै प्रभु को संदेसो बोलन को वरदान देथै; और कोई-कोई कै तौ भली-बुरी आत्मन के बीच मैं अंतर जानन की सक्ति देथै; कोई-कोई कै अलग-अलग हानी की भासा बोलन की सक्ति देथै, तौ कोई कै भासा के भेद को मतलब बतान की सक्ति देथै। <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />लेकिन जौ बहे आत्मा है जो, जो-जोकै जैसो-जैसो समझथै, बौ सबै आदमिन कै एक अलग वरदान देथै।<verse eid="1CO 12:11" /></para>
  <para style="s">एक सरीर के निरे हिस्सा</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:12 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:4">रोमियों 12:4</ref>,<ref loc="ROM 12:5">5</ref> </char>
    </note>जैसे सरीर एक है, और बाके अंग निरे हैं, पर अंग भौत होत भै भी बासे सरीर एकै बनथै, बैसिये मसीह है। <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />हम सबै का यहूदि होमैं, या का यूनानी, का दास, का छुटबग्गर एकै आत्मा से एक सरीर होन के ताहीं बपतिस्मा लै, और हम सबन कै एकै आत्मा कै पीन के ताहीं दौ गौ है।<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />सरीर खाली एक हिस्सा से ना, बल्कि कई हिस्सन से बनो है। <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />अगर टाँग कहबै, “मैं एक हात नाय हौं, मैं सरीर से जुड़ो ना हौं,” जो जाकै सरीर को हिस्सा होन से नाय रखैगो। <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />और अगर कान कहबै, “मैं आँखी नाय हौं, तौ का बौ सरीर को ना है,” तौ का बौ जौ बजह से सरीर को ना है। <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />अगर पूरो सरीर आँखी होती तौ, जौ कैसे सुन सकथै? और अगर जौ खाली एक कान होतो, तौ जौ कैसे सूंग सकत रहै? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />हालाकि, जौ है कि परमेस्वर कै जैसो ठीक लागो, बैसिये सब अंगन कै सरीर मैं बैसोई रखी जैसी बौ चात रहै। <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />तौ अगर सब अंग एकै होते तौ सरीर ना होती! <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />लेकिन अब अंग तौ निरे हैं, पर सरीर एकै है।<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />आँखी हात से नाय कह सकथै, कि मोकै तेरी जरूरत नाय है! “और फिर ऐसियै मूड़, टाँग से नाय कह सकथै, कि मोकै तेरी जरूरत नाय है!” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />लेकिन सरीर के बे अंग जो दुसरेन से कमजोर मालुम पड़थैं, बेईं भौतै जरूरी हैं; <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />और सरीर के बे अंग को हम आदर करनो नाय समझथैं उन्हईं कै हम जद्धे आदर देथैं; और हमरे सोभाहींन अंग औरौ सोभाएमान हुई जाथैं, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />तहुँओं हमरे सुगड़ अंगन कै जाकी जरूरत ना है। परमेस्वर खुद सरीर कै ऐसे करकै एक संग रखी है कि बे हिस्सन कै जाधे से जाधे सम्मान दौ जाए सकै जिनकै जाकी जरूरत है। <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />जोसे सरीर मैं फूट नाय पड़ै, लेकिन जाके सबै अलग-अलग अंगन मैं एक दुसरे के ताहीं बराबर चिंता है। <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />तभई अगर एक अंग कै चोट लगथै; तौ सब अंग चोट खाथैं; और अगर एक अंग की बड़ाँईं करी जाथै, तौ बाके संग सब अंग खुसी मनाथैं।<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />ऐसियै तुम सब मिलकै मसीह की सरीर हौ, और बटे भै अंग हौ। <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" /><note caller="+" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">इफिसियों 4:11</ref></char></note>परमेस्वर कलीसिया मैं सबन कै रखी है: पहली जघा मैं प्रेरितन कै, दुसरी जघा मैं भविस्यवक्ता कै, तिसरी जघा मैं सिक्छा देनबारे कै, फिर जो लोग सामर्थी काम करथैं, उनके बाद जो उनकै चंगो करनो या दुसरेन कि मदत करनो या उनकै सई रहा दिखानो या अजीब जीभ मैं बोलन के वरदान दई जाथै। <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />का सबै प्रेरित या भविस्यवक्ता या सिक्छक हैं? का हर कोई सामर्थी काम करथैं? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />का सबन कै बिमारियन कै ठीक करन को वरदान है? का सबै अजीब भासा मैं बोलथैं? का सबै अनुवाद करथैं? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />इसलै तुमकै इमानदारी से सबसे उपयोगी वरदान कि इच्छा करनी चाहिए। लेकिन अब मैं तुमकै जिंदगी को एक रस्ता दिखाथौं जो सबसे अच्छो है।<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">प्यार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />मैं इंसानन और हिंयाँ तक कि स्वर्गदूतन कि भासा बोलन मैं सक्छम हुई सकथौं, लेकिन मन मैं प्यार ना है, तौ मैं गूँजत भौ घंटा या झनझनात भइ मंजीरा सो हौं। <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" /><note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्ती 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">मरकुस 11:23</ref></char></note>अगर मैं भविस्यवाँड़ी कर लेमौं, और सबै तरहन के भेद की बात और निरे तरहन के ग्यान कै समझ लेमौं, और तौ और मोकै हिंनौ ले बिस्वास होबै कि मैं पहाड़न कै हटाय देमौं, और लेकिन मैं प्यार नाय रखौं, तौ मैं कछु नाय हौं। <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />अगर मैं अपनी पूरी सम्पत्ति कंगालन कै बाँट देमौं, या अपनी सरीर जलान कै दै देमौं, और मन मैं प्यार नाय रखौं, तौ मोकै कछु फायदा नाय है।<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />प्यार धीरज और दयालु है, प्यार डाह ना करथै; प्यार अपने बारे मैं बड़ाँईं नाय करथै, और गरब ना है; <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />प्यार असभ्य या स्वार्थी या चिड़चिड़ो ना है; प्यार गलतियन को हिसाब ना रखथै; <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />बौ अधर्म से खुस नाय होथै बल्कि जब सच्चाई की जीत होथै तौ खुस होथै। <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />प्यार कहु हार ना मानथै; और जाको बिस्वास, उमीद, और धीरज कहु असफल ना होथै।<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />प्यार अमर है; भविस्यवाँड़ी तौ खतम हुई जांगी, भासा कै बोलन बारी जीबैं एक दिना चुप्पा हुई जांगी, और जो ग्यान है बहो मिट जागो। <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />हमरो ग्यान अधूरो है, और हमरी भविस्यवाँड़ियौ अधूरी है। <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />लेकिन जब सर्व सिद्ध आगो, तौ अधूरोपन मिट जागो।<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />जब मैं बालका रहौं, तौ मेरी बोली, भावना और बिचार सबै एक बालका कि रहै; अब जब मैं बड़ो भौ, तौ मैं बचकानोपन छोड़ दौ। <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />अब हमैं दरपन मैं धुंधरो सो दिखाई देथै, पर जब सर्व सिद्ध आगो तौ हम पूरे तरीका से आमने-सामने देखंगे। अब जोमैं जानथौं बौ खाली थोड़ी भौत है; तौ जौ पूरो होगो, जैसो कि प्रभु को मोकै ग्यान है।<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />पर अब बिस्वास, आसा, प्यार जे तीनौ स्थाई हैं, और जे तीनौ मैं सबसे बड़ो प्यार है।<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">आत्मा के वरदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />प्यार कि रहामैं चलत रहबौ, और आत्मिक वरदानन कि लौ मैं रहबौ; ताकि तुम खासकर भविस्यवाँड़ी करौ। <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />जो दुसरी भासा मैं बतकाथैं, बे इंसानन से नाय पर परमेस्वर से बतकाथैं, काहैकि कोई भी उनकै ना समझथै। बे आत्मा कि सक्ति से गुप्त सच्चाई बोल रै हैं। <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />लेकिन जो भविस्यवाँड़ी करथैं, बे इंसानन की बढ़ोतरी और सीख और सांति के बढ़ावा की बात करथै। <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />जो दुसरी भासा मैं बतकाथै, बौ अपनिए बढ़ोतरी करथै; पर जो भविस्यवाँड़ी करथै, बौ पूरी कलीसिया की मदत करथैं।<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />मैं चाहथौं कि तुम सबै जनी अजीब जबान मैं बोलौ; लेकिन और जाधे कि तुमरे पास भविस्यवाँड़ी करन को वरदान होबै। जो भविस्यवाँड़ी करथै, बौ अजीब जबान मैं बोलन बारे कि तुलना मैं जाधे मतलब रखथै, जब तक कि कोई ऐसो आदमी मौजूद ना होबै जो समझाए जान बारे कि ब्याख्या कर सकै, ताकी पूरी कलीसिया कि बढ़ोतरी हुई सकै। <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />भईय्यौ और बहेनियौ तभईये, अगर मैं तुमरे झोने आयकै दुसरी भासा मैं बतकामौं और उजीतो या ग्यान या फिर भविस्यवाँड़ी या सीख की बातन कै तुमसे नाय कहमौं, तौ मोसे तुमकै का फायदा होगो?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />ऐसियै अगर बगैर ज्यान की चीजैं, जिनमैं से अबाज निकरथै, जैसे कि बुसली या बीन, अगर उनके स्वर मैं भेद ना होबै तौ, जब बामै फूँको या बाकै बजाओ जाथै, बौ कैसे करकै पहचान मैं आगो? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />और अगर तुरहई को बोल सपा नाय होबै, तौ कौन लड़ाई के ताहीं समरैगो? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />बैसिये, कोई भी कैसे समझैगो कि तुम काके बारे मैं बात कर रै हौ अगर तुमरो संदेस अजीबो गरीब भासा मैं दौ गौ है, स्राप ना है तौ तुमरे सब्द ब्यार मैं गायब हुई जांगे! <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />दुनिया मैं कित्तेउ तरहन की भासा काहे ना होमैं, लेकिन उनमैं से बगैर मतलब की कोई होमंगिये नाय। <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />तभई अगर मैं कोई भासा को मतलब नाय समझौं, तौ बोलन बारे की नजर मैं परदेसी मानो जांगो और बौ बोलन बारो मेरी नजर मैं परदेसी मानो जागो। <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />तभई तुम्हऊँ जब आत्मा के वरदानन की धुन मैं होबौ, तौ ऐसो जोर दैकै कोसिस करौ कि तुमरे वरदानन की मदत से कलीसिया की बढ़ोतरी होबै।<figure style="fig" alt="musical instruments" file="hk00188c.tif" size="col" copy="Horace Knowles ©" ref="14:7">संगती मैं गान बजान को सामान</figure><verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />जौ आदमी अजीब जीभ मैं बौलथै, बाके बरदान के ताहीं प्रार्थना करनो चाहिए कि बौ का कहरौ है। <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />अगर मैं ऐसे करकै दुसरी भासा मैं प्रार्थना करथौं, तौ मेरी आत्मा बास्तव मैं प्रार्थना करथै, लेकिन मेरे दिमाक को जामैं कोई हिस्सा ना है। <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />तौ अब का करनो चहाईये? मैं आत्मा मैं भरकै प्रार्थना करंगो, और दिमाकौ मैं हुईकै प्रार्थना करंगो, मैं आत्मा से गांगो, और दिमाक से भी गांगो। <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />नाय तौ अगर तैं आत्मा से ही धन्यवाद करैगो, तौ फिर बगैर आसीस को आदमी तेरे धन्यवाद मैं “आमीन” कैसे कहेगो? काहैकि बौ तौ जानतै नाय है कि सच मैं तैं का कहरौ है। <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />हिंयाँ तक कि अगर परमेस्वर के ताहीं धन्यवाद कि तुमरी प्रार्थना काफी अच्छी है, तौ दुसरे लोगन कि मदत नाय करी जाथै।<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />मैं अपने परमेस्वर को धन्यवाद करथौं, कि मैं तुम सबन मैं से सबसे जद्धे दुसरी भासा मैं बोलथौं। <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />लेकिन कलीसिया मैं दुसरी भासा मैं दस हजार बातैं कहेन से तौ मोकै जौ औरौ अच्छो मालुम पड़थै, कि दुसरेन कै सिखान के ताहीं अपनी बुद्धि से पाँचै बात कहमौं।<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />भईय्यौ और बहेनियौ, तुम समझ मैं बालका मत बनौ: पर बुराई के मामला मैं बालका बने रहबौ, और समझ मैं स्याने बनौ। <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" /><note caller="+" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11">यसायाह 28:11</ref>,<ref loc="ISA 28:12">12</ref> </char></note>जौ नियम मैं लिखो है: कि प्रभु कहथै</para>
  <para style="q1" vid="1CO 14:21">“मैं दुसरी भासा बोलन बारेन के जरिया,</para>
  <para style="q2" vid="1CO 14:21">और दुसरे मोहों से, जे आदमिन से बात करंगो भी,</para>
  <para style="q1" vid="1CO 14:21">तहुँओं बे मेरी नाय सुनंगे।”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />तभई दुसरी भासा जो है विस्वासियन के ताहीं नाय है, लेकिन अविस्वासियन के ताहीं चिन्ह हैं; और परमेस्वर के संदेस को ऐलान करनो अविस्वासिन के ताहीं नाय हैं, लेकिन विस्वासियन के ताहीं चिन्ह हैं।<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />अगर कलीसिया एक जघा जुराए जाबै, और सबै दुसरी भासा बोलैं, और बहार के अनपढ़ अविस्वासी आदमी भीतर आए जामैं तौ का बे तुमकै ऐसे देखकै पागल ना समझंगे? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />लेकिन अगर सबै भविस्यवाँड़ी करन लगैं, और कोई अविस्वासी या आम आदमी इंसान भीतर आए पहोंचै, तौ सब बाकै कसूरवार ठहराए देंगे, और अजमाय लेंगे, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />और बाके मन को भेद पकड़ मैं आए जागो, तौ फिर बौ मोखरा गिरकै परमेस्वर की आराधना करैगो, और मान लेगो “कि सच्ची मैं परमेस्वर तुमरे बीच मैं है!”<verse eid="1CO 14:25" /></para>
  <para style="s">कलीसिया मैं नियम</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />भईय्यौ और बहेनियौ, बताबौ का करनो चहाईये? जब तुम कलीसिया मैं जुराथौ, तौ सबन के मन मैं भजन संहिता या उपदेस या दुसरे भासा या उजियारो या तौ दुसरी भासा को मतलब बताने होथै। सबै कछु आत्मिक बढ़ोतरी के ताहीं होनो चहाईये। <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />अगर दुसरी भासा मैं बात करने होबै तौ दुई जनी या फिर निरे जनी होमैं तौ तीन जनी पाली-पाली से बोलैं, और एक आदमी सब बातन को मतलब बताबै। <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />लेकिन अगर मतलब बतान बारो नाय होबै तौ, जो-जो दुसरी भासा बोलथैं बे कलीसिया मैं चुप्पा रहमैं। और खाली अपने आप से और परमेस्वर से बात करनो चाहिए। <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />और भविस्यवक्ता मैं से भी दुई या तीन जनी बोलैं, बाकी के आदमी उनके बचन को फैसला करैं। <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />लेकिन अगर और कोई भी जो बैठो पड़ो है, परमेस्वर के घाँईं से बाकै ईस्वरीय उजीतो होबै तौ, पहलो बारो चुप हुई जाबै। <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />तुम सबै एक-एक करकै भविस्यवाँड़ी कर सकथौ जोसे सबै सीख जामैं और सब सांति पामैं। <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />आत्मा को वरदान भविस्यवक्ता के बस मैं होनो चाहिए, <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />परमेस्वर गड़बड़ी को नाय, लेकिन सांति को कर्ता है। जैसे कि पवित्र आदमिन की सबै कलीसियन मैं है, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />बईंय्यरैं कलीसिया की सभा मैं चुप बैठी रहमैं, उनकै बोलन को हक नाय है, लेकिन अदब मैं रहेन को नियम है, जैसे कि यहूदि सास्त्र मैं लिखोउ है। <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />अगर बे कुछ सिखनो चहामैं, तौ घरै अपने-अपने लोगा से पूँछै, बईंय्यरन को कलीसिया मैं बोलनो सरम की बात है।<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />का परमेस्वर को बचन तुमरे भीतर से निकरो है? या सिरफ तुमरेई झोने ले पुगो है? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />अगर कोई इंसान अपने आपकै भविस्यवक्ता या आत्मिक जन समझै, तौ जौ जान लेबै कि जो बातन कै मैं तुमकै लिखरौ हौं, बे प्रभु की आग्या हैं। <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />लेकिन अगर बौ जाके ऊपर ध्यान ना देथै, तौ बाकै नाय जानैं तौ, ना जानैं।<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />सो हे भईय्यौ और बहेनियौ, भविस्यवाँड़ी करन की लौ मैं रहौ और दुसरे भासा बोलन से मना मत करौ। <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />पर सब बातन कै सई तरीका और नियम से करो जाबै।<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">ईसु मसीह को पुनरुत्थान<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">दुबारो जिंदो होनो</char></note></para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />हे भईय्यौ और बहेनियौ, अब मैं तुमकै बहे सुसमाचार बताथौं जो पहलियै सुनाए चुको हौं, जोकै तुम अंगीकार<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">अपनानो</char></note> भी करे रहौ, और जोमैं तुम टिकेउ हौ। <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />बहे से तुमरो उद्धार भी होथै, अगर बौ सुसमाचार कै जोमैं तुमकै सुनाओं रहौं याद रखाथौ तौ, नाय तौ तुमरो बिस्वास करनो बेकार है।<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 53:5-12">यसायाह 53:5-12</ref> </char>
    </note>जहे बजह से मैं तुमकै सबसे पहले जहे बात पहुँचाए दौ रहौं, जो मोकै पहुंची रहै कि पवित्र सास्त्र के बचन के अनुसार ईसु मसीह हमरे पापन के ताहीं मर गौ; <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" /><note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">भजन संहिता 16:8-10</ref>; <ref loc="MAT 12:40">मत्ती 12:40</ref>; <ref loc="ACT 2:24-32">प्रेरितो 2:24-32</ref></char></note>और गड़ारो गौ, और पवित्र सास्त्र के अनुसार तिसरे दिन जिंदो हुई गौ; <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />फिर बौ कैफा कै दिखाई दई और फिर बाके बाद बारहौ चेलन कै बौ दिखाई दई। <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />फिरौंकी बौ पाँच सौ से जद्धे भईय्यन कै एक संग दिखाई दई, जिनमैं से निरे तौ हबै ले जिंदे हैं पर कुछ मर चुके हैं। <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />फिरौंकी बौ याकूब कै दिखाई दई बाके बाद सब प्रेरितन कै दिखाई दई।<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />सबन के बाद महुँ कै दिखाई दई, जो मानौं अधूरे दिनन को जनमो हौं। <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" /><note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितो 8:3</ref></char></note> मैं तौ प्रेरितन मैं सबसे छोटो हौं। हिंयाँ ले कि मैं प्रेरित कहबान के लायक भी नाय हौं काहैकि मैं तौ परमेस्वर की कलीसिया कै सताए करत रहौं। <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />लेकिन मैं जो कछु भी हौं, परमेस्वर की दया से हौं, बाकी दया जो मेरे ऊपर है बौ बेकार नाय गई; लेकिन मैं बे सब बातन से बढ़कै मेहनत करो हौं: तहुँओं जौ मेरी तरफ से नाय भौ लेकिन परमेस्वर की दया से भौ जो मेरे ऊपर रहै। <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />तभई चाँहे मैं होमौं, चाँहे बे होमैं, हम जहे प्रचार करथैं, और जहे से तुम बिस्वास भी करे।<verse eid="1CO 15:11" /></para>
  <para style="s">हमरो पुनरुत्थान</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />तभई मसीह को जौ प्रचार करो जाथै कि बौ मरे भै मैं से जिंदो हुई गौ, तौ तुम मैं से कित्ते ऐसे कह लेथैं कि मरे भैन को पुनरुत्थान हईये नाय? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />अगर मरे भैन को पुनरुत्थान नाय है, तौ मसीह भी जिंदो नाय उठो; <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />और अगर मसीह मरे भैन मैं से जिंदो नाय भौ है, तौ हमरो प्रचार करनो बेकार है, और तुमरो विस्वासौ बेकार है। <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />बल्किन हम परमेस्वर के झूठे गभा ठहरे; हम परमेस्वर के बारे मैं जौ गभाई दै कि बौ परमेस्वर ईसु मसीह कै जिंदो करी। <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />और अगर मरे भै जिंदे नाय होते तौ, ईसु मसीह भी जिंदो नाय होतो। <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />और अगर ईसु मसीह जिंदो नाय भौ है, तौ तुमरो बिस्वास करनो बेकार है, और तुम हबै ले पापन मैं फसे पड़े हौ। <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />बल्किन जो मसीह मैं रहैं अब हमरे बीच मैं नाय रहे, बेऊँ मर गै। <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />अगर हम सिरफ जहे जिंदगी मैं मसीह मैं उमीद लगाथैं तौ, हम सब जनी सारे इंसानन से जद्धे, अभागे हैं।<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />लेकिन सच्ची मैं मसीह मरे भै मैं से जिंदो भौ है, काहैकि पक्को है कि जो लोग मौत कि नींद सोथैं उनकै भी उठाओ जागो। <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />जैसे इंसान के जरिये से मौत आई, बैसिये पुनरुत्थान इंसान के जरिये से होथै। <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />और जैसे आदम के मरन के बजह से सब मरथैं, बैसिये ईसु मसीह मैं जिंदे करे जांगे। <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />लेकिन हर एक कै सई लैन बारी से उठाओ जागो: मसीह, सबसे पहले; फिर, बाके आन पोती, जो लोग बाके हैं। <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />जाके बाद सब अंत होगो; बौ समय बौ सब सासकन कै, और सब हक और सामर्थ्य कै खतम करकै राज्य कै परमेस्वर दऊवा के हात मैं सौंप देगो। <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" /><note caller="+" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन संहिता 110:1</ref> </char></note> जबले परमेस्वर अपने बैरियन कै अपने टाँगन तरे नाय लैयाबै, तौले मसीह को राज्य करनो जरूरी है। <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />सबसे आखरी बैरी जो खतम करो जागो, बौ मौत है। <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" /><note caller="+" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन संहिता 8:6</ref> </char></note>“काहैकि सास्त्र कहथै, परमेस्वर अपने पैर के तरे जौ सब कछु करी।” जौ सपा है कि पक्के रूप से, “सब बातैं” बाके हक मैं कर दौ गौ है, तौ जरूर है कि जो सबै कछु बाके हक मैं कर दई, बौ खुदै अलग रहो। <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />लेकिन जब सबै बातैं बाके हक मैं कर दौ जागो तौ, बाको लौड़ा खुदै बाके हक मैं हुई जागो, जो सबै बातन कै बाके हात मैं कर दई; जोसे सब मैं परमेस्वरै सब कछु है।<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />अब नाय तौ जो आदमी मरे भैन के ताहीं बपतिस्मा लेथैं बे का करंगे? अगर मुर्दा जिंदे होतिये नाय तौ फिर काहेकै उनके ताहीं बपतिस्मा लेथैं? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />और हमउँ काहे हर घड़ी जोखिम मैं पड़े रहथैं? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />अरे भईय्यौ और बहेनियौ, मैं घमंड करथौं उनके ताहीं जो प्रभु ईसु मसीह मैं बिस्वास करथैं, मैं सैंदे कहथौं कि उनके ताहीं मैं रोज मरथौं। <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" /><note caller="+" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">यसायाह 22:13</ref></char></note>मैं उन आदमिन के ताहीं इफिसुस मैं जंगली जानवर से लड़ो, अगर मरे भै नाय जिंदे होमंगे, तौ मोकै का फायदा भौ “तौ आबौ खाए-पी लेमैं, कल तौ मरिये जामंगे।”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />धोका मत खईयो, “बुरी संगत अच्छे चरित्‌र कै बिगाड़ देथै।” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />होस मैं आबौ। पाप करनो बंद करौ, तुमरे मैं से तमान तौ ऐसे हैं, जो परमेस्वर के बारे मैं कछुए नाय जानथैं, मैं तुमकै सई मैं लज्जित करन ताहीं जौ करथौं।<verse eid="1CO 15:34" /></para>
  <para style="s">पुनरुत्थान बारी सरीर</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />अब कोई जौ कहेगो, “कि मुर्दा कौन सी रीति से जी उठथैं? और कौन सी सरीर के संग आथैं?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />अरे बेअकली! जो कछु तू बोथै, बहे दानो जबले नाय मरै जिंदो नाय होथै। <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />और जो तैं बोथै, जौ बौ सरीर नाय जो पैदा होन बारी है, पर सिरफ गूदा है, तुम जमीन मैं पौधा नाय दानोंई बोथौ, चाँहे गेंहूँ को, चाँहे कछु और अनाज को। <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />लेकिन परमेस्वर जैसो चाहथै, बैसिये रूप बाकै दै देथै। सबै बीज कै बौ उनकै उनकोई सरीर दै देथै।<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />सबै सरीर एक हानी के नाय हैं। इंसानन की सरीर और है, जानवरन की सरीर और है; चिरईंयाँ की सरीर और है; मच्छियन की सरीर और है।<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />और स्वर्गिय सरीर है, और मरी भइ सरीर है: लेकिन स्वर्गिय सरीर को तेज औरै है, और मरी को औरै। <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />सूरज की चमक औरै है, और जोनी की चमक औरै है, और तारन की औरै है, एक तारा से दुसरो तारा के तेज मैं फरक है।<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />मुर्दा को पुनरुत्थान हुई जानो ऐसोई है। सरीर जो है नासवान की हालत मैं बोई जाथै और अविनासी रूप मैं जी उठथै। <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />बौ अनादर के संग बोई जाथै, और महिमा मैं जी उठथै; बिना बल के संग बोई जाथै; और सामर्थ्य के संग जी उठथै। <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />जब इंसान दफन करो जाथै, तौ एक भौतिक सरीर है; जब जी उठाओ जागो, तौ जौ एक आत्मिक सरीर होगो। बेसक, एक भौतिक सरीर है, इसलै आत्मिक सरीरौ है। <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" /><note caller="+" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">उत्पत्ति 2:7</ref></char></note>सास्त्र कहथै: “पहलो इंसान अपने आप नाय आओ मतलब आदम और जिंदो आदमी बनो।” और आखरी आदम (ईसु मसीह) जीवन देन बारो आत्मा बनो। <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />सुरू इंसान आत्मिक ना रहै, पर स्वाभाविक रहै, जाके बाद आत्मिक भौ। <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />धरती की धूल से आओ पहलो आदम; दुसरो आदम स्वर्ग से आओ। <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />जैसे बौ इंसान कै मट्टी से बनाओ गौ, बैसिये सबै आदमी मट्टी से बने; और जैसो बौ स्वर्गिय है, बैसिये औरौ स्वर्गिय हैं। <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />और जैसे हम बाको रूप जो मट्टी को रहै धारड़ करै, बैसिये बौ स्वर्गिय को रूप धारड़ करंगे।<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />भईय्यौ और बहेनियौ, मेरो मतलब है; कि मास और खून परमेस्वर के राज्य के हकदार नाय होंगे। और ना बिनास अविनासी के अधिकारी हुई सकथैं।<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:51 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">1 थिस्सलुनीकियों 4:15-17</ref> </char>
    </note>सुनौ; मैं तुमकै सैंदे को एक राज की बात बताथौं: हम सब नाय मरंगे, बल्किन हम सब बदल जामंगे। <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />जब सबसे बाद की तुरहई बजैगी तौ पलक झपकतै खिना एक घड़ी मैं ऐसो हुई जागो, काहैकि तुरहई बजैगी और मरे भै अमर हुईकै जी उठंगे और हम जो हबै जिंदे हैं, बदल जांगे। <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />जरूरी है कि जौ नासवान सरीर अविनासी सरीर कै पहन ले, और जौ मरनहार सरीर अमरता कै पहन लेयै। <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" /><note caller="+" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">यसायाह 25:8</ref></char></note>और जब जौ नासवान सरीर अविनास कै पहन लेगो, और जौ मरनहार अमरता कै पहन लेगो, तौ सास्त्र मैं लिखो भौ बचन पूरो हुई जागो: “मौत खतम हुई जाथै; जीत पूरी हुई गई है!”<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:55 </char>
      <char style="xt" closed="false">
        <ref loc="HOS 13:14">होसे 13:14</ref>
      </char>
    </note>“ओ मौत तेरी जीत कितै गई?</para>
  <para style="q2" vid="1CO 15:55">ओ मौत तेरो डंक कहाँ रहो?”<verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />मौत को डंक पाप है; और पाप को सामर्थ्य नियम है। <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />लेकिन परमेस्वर को धन्यवाद होबै जो कि प्रभु ईसु मसीह के बजह से हमकै जीत मिलथै!<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />तौ मेरे प्रिय भईय्यौ और बहेनियौ, मजबूत रहकै अटल रहबौ, प्रभु के काम मैं सदा बढ़ते जाबौ, तुम जानथौ कि तुमरी मेहनत प्रभु मैं बेकार नाय है।<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">विस्वासियन के ताहीं दान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:25">रोमियों 15:25</ref>,<ref loc="ROM 15:26">26</ref> </char>
    </note>अब, बौ चन्दा के बारे मैं जो यहूदा के पवित्र लोगन के ताहीं इखट्टो करो जाथै, जो आग्या मैं गलातिया की कलीसियन कै दौ, बैसिये तुम्हऊँ करौ। <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />तुम मैं से हर सप्ताह के पहले रोज कै अपनी कमाई मैं से कुछ अपने पास धरनो चाहिए और बाकै इखट्टो करनो चाहिए, ताकी मेरे आन मैं धन इखट्टो करन कि जरूरत ना रहबै। <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />जब मैं आंगो, तौ जिनकै तुम परखैगे, उन्हैं मैं चिट्ठी दैकै पनार देंगो, कि तुमरो भेंट यरूसलेम पहुँचाए देमैं। <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />और अगर मेरो जानो ठीक रहो, तौ बे मेरे संगै चले जांगे।<verse eid="1CO 16:4" /></para>
  <para style="s">पौलुस की योजना</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />और मैं मकिदुनिया<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">उत्तरी ग्रीस यूनान को एक प्रमुख देस रहै। प्रेरितो 19:21 </char></note> होत भौ तुमरे झोने आंगो; काहैकि मोकै मकिदुनिया हुईकै जानेई है। <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />हुई सकथै कि तुमरे हींना रुक जामौं और सर्दी को मौसम तुमरे हिंयाँ गुजारौं, तौ जितै मोकै जाने होबै, उतै तुम मोकै पनार सकौ। <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />मैं अब रहामैं तुमसे भेंट करनो नाय चाहथौं; पर मोकै जौ उमीद है, कि अगर प्रभु चाही तौ मैं थोड़ी समय तुमरे संगै रहेंगो।<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:8 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 23:15-21">लैव्यवस्था 23:15-21</ref>; <ref loc="DEU 16:9-11">व्यवस्थाविवरन 16:9-11</ref> </char>
    </note>मैं पिन्तेकुस्त<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">पिन्तेकुस्त को दिन, फसल के त्योहार के खतम होन बारे दिन के बाद पचासमों दिन पड़थै।</char></note> के दिन तक इफिसुस मैं रैहंगो। <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />मेरे ताहीं एक बड़ो और उपयोगी फाटक खुलो है, और बिरोधियो तमान हैं।<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:17">1 कुरिन्थियों 4:17</ref>
      </char>
    </note>अगर तीमुथियुस<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">पौलुस के संग काम करन बारो रहै।</char></note> आए जाबै, तौ देखियो बौ तुमरे झोने बगैर डराय रैहबै; बौ मेरिये हानी प्रभु को काम करथै। <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />तभई बाकै कोई तुच्छ नाय जानै, लेकिन बाकै सांति और कुसल से जौ पाँजर पनार दियो, कि मेरे झोने आए जाए; मैं बाकी रहा निहार रौ हौं, कि बौ भईय्यन और बहेनियन के संग आबै।<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />अब, भईय्या अपुल्लोस से मैं बड़ा नहोरे करो हौं कि तुमरे झोने दूसरे विस्वासियन के संग जाबै; लेकिन बौ जौ घड़ी जान की इच्छा नाय करी, पर जब मौका पाएगो तौ आए जागो।<verse eid="1CO 16:12" /></para>
  <para style="s">आखरी सब्द</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />जगते रहबौ, बिस्वास मैं मजबूत रहबौ, हिम्मती बनौ, बलवन्त होबौ। <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />जो कछु करथौ प्यार से करौ।<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />मैं तुमसे, मेरे भईय्यौ और बहेनियौ, नहोरे करथौं की <note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 1:16">1 कुरिन्थियों 1:16</ref></char></note>तुम स्तिफनास<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="ft" closed="false">सुरु-सुरु मैं नया नियम के समय, एकै बार मैं पूरो घरानो मसीह मैं बिस्वास करत रहै। स्तिफनास के घराने के संग ऐसोई भौ रहै।</char></note> के घराने कै तौ जानतै हौ, कि बे अखाया की फसल के पहले फरा हैं, और पवित्र लोग की सेवकाई के ताहीं समरे रहथैं। <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />कि ऐसेन के अधीन मैं रहबौ, बल्किन हर एक कै जो जौ काम मैं मेहनती और संग देनबारे हैं।<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />और मैं स्तिफनास और फूरतूनातुस और अखईकुस के आन से खुस हौं, बे तीनौ तुमरी घटी कै पूरो करीं हैं <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />और बे मेरी और तुमरी आत्मा कै चैन दईं हैं, इसलै ऐसियनों की मानौ।<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितो 18:2</ref>
      </char>
    </note>आसिया की कलीसिया के घाँईं से तुमकै नमस्ते; अक्विला और प्रिस्किल्ला को और उनके घर की कलीसिया को भी तुमकै प्रभु मैं भौत-भौत नमस्ते। <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />सब भईय्यन को तुमकै नमस्ते।</para>
  <para style="p" vid="1CO 16:20">पवित्र चुम्मी से आपस मैं नमस्ते करे करौ।<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />मैं पौलुस अपने हातन से नमस्ते लिखरौ हौं।<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />अगर कोई तुम मैं से प्रभु से प्यार नाय करथै, तौ बौ स्रापित है। प्रभु! आ!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />प्रभु ईसु की दया तुमरे संग है।<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />मेरो प्यार ईसु मसीह मैं तुम सबन के संग रहबै।<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>