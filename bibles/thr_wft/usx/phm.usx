<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Rana Tharu</book>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन कै लिखी भइ पौलुस की चिट्ठी</para>
  <para style="mt2">फिलेमोन को लिखी हुई पौलुस की चिट्ठी</para>
  <para style="mt1">फिलेमोन कै लिखी भइ पौलुस की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">फिलेमोन की छोटी किताब प्रेरित पौलुस के जरिया लिखी गई रहै <char style="xt"><ref loc="PHM 1:1">1:1</ref></char>। जाकै लिखत समय पौलुस जेल मैं रहै, जोको मतलब है कि बौ सायद जाकै रोम से लिखत रहै। अगर बौ रोम मैं रहत होतो तौ ईसु के जनम के लमसम 61 साल बाद लिखी होतो, जो बहे समय होतो जब बौ कुलुस्सियों कै लिखी रहै। बौ जौ चिट्ठी फिलेमोन नाओं के एक आदमी कै लिखी रहै। फिलेमोन कलीसिया को सदस्य रहै और गुलाम को मालिक भी रहै। पौलुस बाकै जौ पूँछन के ताहीं लिखी कि बौ अपने दास उनेसिमुस कै सजा ना देगो जो फिलेमोन से भाज गौ रहै। रोमन कानून के अनुसार फिलेमोन कै उनेसिमुस कै मौत की सजा माँगन को अधिकार रहै। उनेसिमुस कै एक मसीह भईय्या के रूप मैं अपनान के ताहीं फिलेमोन कै प्रोत्साहित करन के ताहीं पौलुस धारदार तर्क को इस्तमाल करथै और हींना तक कि सुझाव देथै कि उनेसिमुस कै पौलुस के संग सेवा करन की अनुमति दई जाबै। <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref> </char></para>
  <para style="iot">रूपरेखा:</para>
  <para style="io1">1. पौलुस मैं फिलेमोन कै नमस्ते करथै। <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. तौ पौलुस उनेसिमुस के घाँईं से पूँछथै कि फिलेमोन बाकै एक मसीह भईय्या के रूप मैं अपनागो। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref> </char></para>
  <para style="io1">3. पौलुस सफर करन के अपने इरादा की घोसड़ाँ करकै खतम करथै और नमस्ते भेजथै। <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>पौलुस के घाँईं से जो ईसु मसीह को कैदी रहै, और भईय्या तीमुथियुस के घाँईं से हमरे प्रिय सहकर्मी फिलेमोन, <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>और बहेनिया अफफिया, हमरे संग को सिपईय्या अरखिप्पुस और फिलेमोन के घर मिलन बारी की कलीसिया के नाओं:<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>हमरे दऊवा परमेस्वर और प्रभु ईसु मसीह के घाँईं से अनुग्रह और सांति तुमकै मिलत रहबै।<verse eid="PHM 1:3"/></para>
  <para style="s">फिलेमोन को प्रेम और बिस्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>भईय्या फिलेमोन, जब भी मैं प्रार्थना करथौं, मैं हमेसा परमेस्वर को धन्यवाद देथौं और तोकै याद करथौं। <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>तेरो बिस्वास जो प्रभु ईसु मैं है और तेरो प्रेम परमेस्वर के पवित्र लोगन मैं है बाके बारे मैं सुन रौ हौं। <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>मैं प्रार्थना करथौं कि, बिस्वास मैं तुमरी सहभागिता हर अच्छी बात के ग्यान के ताहीं असरदार होबै जो मसीह मैं हमरे पास है। <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>काहैकि भईय्या मोकै तेरे प्यार से भौत खुसी और बढ़ावा मिलो है! जहे बजह से तोसे परमेस्वर के पवित्र लोगन के मन हरे भरे हुईगै हैं।<verse eid="PHM 1:7"/></para>
  <para style="s">उनेसिमुस के ताहीं बिनती</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>काहैकि मोकै मसीह मैं भाई होन के नाते बड़ो साहस है कि मैं सई बात करन के ताहीं मैं तोकै आग्या दै सकथौं। <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>लेकिन मैं तोकै प्रेम करथौं इसलै मैं तोसे नहोरे करथौं। जौ मैं बिनती कर रौ हौं जाके बावजूद कि मैं पौलुस मसीह ईसु को राजदूत हौं और बाके ताहीं हालात मैं मौजुदा कैदी भी हौं। <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>उनेसिमुस जो मसीह मैं मेरो लौड़ा है, बाके ताहीं मैं जौ नहोरे तोसे कर रौ हौ; काहैकि जब मैं कैदखाना के बंधन मैं रहौं तभई मैं बाको आत्मिक दऊवा बनो। <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>बौ तौ अग्गु तेरे कोई काम को ना रहै, पर अब बौ तेरे और मेरे दोनों काम को है।<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">उनेसिमुस नाओं ग्रीक को सब्द को मतलब भी “काम” को होथै</char></note><verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>बहेकै जो दिल को टुकड़ा है, मैं तोकै लौटाय दौ हौं। <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>बाकै मैं अपने झोने रखनो चाहत रहौं कि बौ तेरे घाँईं से जब तक कैदखाना के बंधन मैं सुसमाचार की बजह से है, मेरी मदत करै। <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>पर मैं तेरी इच्छा के बिना कुछ भी करनो नाय चाहो, ताकी जौ तेरो अच्छो काम दबाब से नाय पर दिल से होबै।<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>काहैकि का पता जहे बजह से उनेसिमुस कुछ समय के ताहीं अलग भौ कि बौ फिर अनंतकाल के ताहीं तेरे झोने रहबै। <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>काहैकि अब बौ सिरफ दास नाय बल्कि दास से भी अच्छो मसीह मैं प्रिय भईय्या है। इंसान होन के नाते और प्रभु मैं भईय्या होन के नाते बौ तेरो और जाधे मायने रखैगो।<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>और अगर तू मोकै सहभागी समझथै, तौ बाकै ऐसे अपनाय ले जैसे मोकै। <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>अगर बौ तेरे संग कुछ अन्याय करी है, या तेरो कुछ कर्जा है, तौ बाकै मेरे नाओं मैं लिख लिये। <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>मैं पौलुस अपने हाथ से लिखथौं कि मैं अपने आप भर देंगो: और जासे कहेन की जरूरत नाय है कि जोके ऊपर मेरो कर्जा है बौ तहीं है। <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>तौ हे मेरे प्रिय भईय्या, प्रभु के ताहीं और मसीह मैं तेरो भईय्या होन के नाते किरपा करकै जे अच्छी बातैं मेरे ताहीं कर, और मेरे दिल कै हरो भरो कर दे।<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>मोकै यकीन है, जैसो कि मैं जौ लिखथौं, कि तुम बहे करैगे जोमैं पूछथौं, सच्ची मैं मोकै यकीन है, कि तुम और भी बासे जाधे करैगे। <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>और मेरे रहेन की जघा तैयार रख मोकै आसा है कि तुमरी प्रार्थना से मैं तुमकै सौंप जामंगो।<verse eid="PHM 1:22"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>इपफ्रास जो ईसु मसीह ताहीं मेरे संग कैदी है, तोकै अपनो नमस्ते भेजथै, <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>मरकुस और अरिस्तर्खुस, देमास और लूका जो मेरे सहकर्मी हैं। <verse eid="PHM 1:24"/><verse number="25" style="v" sid="PHM 1:25"/>हमरे प्रभु ईसु मसीह को अनुग्रह तुम सबन के ऊपर बनो रहबै।<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
