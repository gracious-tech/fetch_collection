<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Rana Tharu</book>
  <para style="h">लूका</para>
  <para style="toc3">लूका</para>
  <para style="toc2">लूका</para>
  <para style="toc1">लूका को लिखो भौ ईसु मसीह को सुसमाचार</para>
  <para style="mt2">लूका का लिखा हुआ ईसु मसीह का सुसमाचार</para>
  <para style="mt1">लूका को लिखो भौ ईसु मसीह को सुसमाचार</para>
  <para style="imt">परिचय</para>
  <para style="ip">लूका के अनुसार सुसमाचार नये कानून की चार किताबन मैं से एक है जो ईसु मसीह के जिंदगी को वर्ड़न करथै। उनमैं से हर एक कै “सुसमाचार” कहो जाथै, जोको मतलब है “अच्छी खबर।” बे मत्ती मरकुस लूका और यूहन्ना के जरिये ईसु की मौत के बाद लिखी गईं रहैं। लूका ना खाली ईसु के जिंदगी की कहानी लिखी, बल्कि बौ बे चीजन के बारे मैं भी लिखी, जो ईसु के चेला बाकी मौत और पुनरुत्थान के बाद करी, जो प्रेरितो के काम नाओं की किताब है। कोई ना जानथै लूका के अनुसार सुसमाचार कौन से समय लिखो गौ रहै या कहाँ लिखो गौ रहै, लेकिन जाधेतर विद्धवान जौ बात से सहमत हैं कि जौ हुई सकथै ईसु के जनम के लमसम 70 साल बाद लिखो गौ रहै।</para>
  <para style="ip">लेखक लूका, जो एक बैध रहै। बाकी लिखावट और भासा को इस्तमाल करन को तरीका बताथै कि बौ एक सिक्छित आदमी रहै। लूका ईसु की जिंदगी को एक सई विवरड़ लिखनो चहात रहै, घटनन कै उनके घटित होन के तरीका से बतात रहै, ताकी दूसरे लोग जाकै पढ़न से फायदा उठाए सकैं। बौ यहूदि ना रहै और बौ जौ तरीका से लिखी कि गैर यहूदि लोग समझ सकैं। <char style="xt"><ref loc="COL 4:10-14">कुलुस्सियों 4:10-14</ref></char> जौ यहूदि रीति-रिवाजन की ब्याख्या करन के तरीका से स्पस्ट रूप से देखो जाथै <char style="xt"><ref loc="LUK 1:8">1:8</ref></char>।</para>
  <para style="ip">लूका के हिसाब से सुसमाचार ईसु कै इस्राएल के प्रतिग्या उद्धारकर्ता और पूरी मानव जाति के उद्धारकर्ता दोनों के रूप मैं प्रस्तुत करथै। लूका लिखी है कि ईसु कै प्रभु की आत्मा के जरिये “गरीबन कै सुसमाचार सुनान” के ताहीं बुलाओ गौ रहै <char style="xt"><ref loc="LUK 4:18">4:18</ref></char>, और जौ सुसमाचार सब तरहन की जरूरतमंद लोगन के ताहीं चिंता से भरो भौ है।</para>
  <para style="ip">लूका के हिसाब से सुसमाचार भौत हद तक मत्ती और मरकुस की किताबन से मिलथै-जुलथै, काहैकि बे एक जैसी चीजन को वर्ड़न करथैं और ऐसे करकै। तीन किताबन मैं, लूका, यूहन्ना बपतिस्मा देनबारे के जनम के बारे मैं सबसे जाधे विवरड़ देथै। लूका माफ के ऊपर भी जोर देथै <char style="xt" closed="false"><ref loc="LUK 3:3">3:3</ref></char><char style="xt"><ref loc="LUK 11:4">11:4</ref></char> <char style="xt"><ref loc="LUK 17:3-4">17:3-4</ref></char> <char style="xt"><ref loc="LUK 23:34">23:34</ref></char><char style="xt"><ref loc="LUK 24:47">24:47</ref></char> और प्रार्थना <char style="xt"><ref loc="LUK 3:21">3:21</ref></char> <char style="xt"><ref loc="LUK 5:16">5:16</ref></char> <char style="xt"><ref loc="LUK 6:12">6:12</ref></char> <char style="xt"><ref loc="LUK 11:1-12">11:1-12</ref></char> <char style="xt"><ref loc="LUK 22:32">22:32</ref></char>।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. लूका अपने सुसमाचार को परिचय देथै और बताथै कि बौ जाकै काहे लिखी। <char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">2. फिर बौ ईसु के जनम को वर्ड़न करथै और कैसे बौ सेवकाई के ताहीं तैयार भौ। <char style="ior"><ref loc="LUK 1:5-4:13">1:5–4:13</ref></char></para>
  <para style="io1">3. बचे भै सुसमाचार के सबसे बड़े भाग के ताहीं, लूका बौ काम के बारे मैं बताथै जो ईसु करी रहै, खासकर बाके जरिये करे गै चमत्कार और जो बातैं बौ सिखाई रहै। <char style="ior"><ref loc="LUK 4:14-21:38">4:14–21:38</ref> </char></para>
  <para style="io1">4. आखरी मैं, बौ वर्ड़न करथै कि कैसे ईसु की मौत भइ, बाकै दफनाओ गौ, और मरे भैन मैं से जी उठो। <char style="ior"><ref loc="LUK 23:1-24:1">23:1–24:1-53</ref> </char></para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">परिचय</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />प्रिय थियुफिलुस: भौत जनी बे बातन कै जो हमरे बीच मैं बीती हैं लिखन कि पूरी कोसिस करीं हैं। <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />बे लिखी हैं कि हम बे सेवकन से का कहे हैं जो परमेस्वर के चेला सुरुवात से जे चीजन कै देखीं और जौ खबर को प्रचार करीं। <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />और इसलै, थियुफिलुस, काहैकि महुँ सुरु सेई जे सब मामलेन कै चौकन्नो हुईकै परखो हौं, मैं सोचो कि तेरे ताहीं एक लैनबार से खाता मैं लिखनो अच्छो होगो। <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />मैं ऐसो इसलै करथौं ताकी तोकै हर बौ यकीन चीज के बारे मैं पूरी सच्चाई पता चल जाबै जो तोकै सिखाओ गौ है।<verse eid="LUK 1:4" /></para>
  <para style="s">यूहन्ना बपतिस्मा देनबारे कि जनम कि घोसड़ाँ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />यहूदिया के राजा हेरोद के समय अबिय्याह के दल मैं जकर्याह नाओं को एक पुजारी<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">पुजारी</char></note> रहै, और बाकी बईय्यर हारून के बंस की रहै, जोको नाओं एलिसिबा रहै। <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />और बे दोनों जनी परमेस्वर के सामने सिरफ धर्मी रहैं, और प्रभु की सबै आग्या और कानून मैं निर्दोस चलन बारे रहैं। <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />उनकी कोई औलाद ना रहै, काहैकि एलिसिबा बाँझ रहै, और बे दोनों बुढ्‌ढे रहैं।<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />एक दिन जकर्याह मंदिर मैं परमेस्वर के अग्गु पुजारी के रूप मैं सेवा करत रहै, रोजाना सेवा मैं अपनी बारी लेत रहै। <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />पुजारी पंचायत के रीत के हिसाब से बाके नाओं से चिट्ठी निकरी, कि प्रभु के मंदिर मैं जाएकै धूप बत्ती जलाबै,<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="EXO 30:7">निर्गमन 30:7</ref></char></note> <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />और धूप बत्ती जलान पोती लोगन की पूरी मन्डली दुआरे प्रार्थना करत रहै। <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />इत्ते मैं प्रभु को एक स्वर्गदूत बेदी की धूप बत्ती के दहने घाँईं ठाड़ो भौ बाकै दिखाई दई। <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />और जकर्याह देखकै डराएगौ और बाकै बड़ा डर बैठगौ। <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />लेकिन स्वर्गदूत बासे कही, “हे जकर्याह, डराबै मत्ती काहैकि तेरी प्रार्थना सुन लई गई है और तेरी बईय्यर एलिसिबा से तेरे ताहीं एक लौड़ा पैदा होगो, और तू बाको नाओं यूहन्ना रखिये। <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />और तोकै खुसी होगी, और भौत जनी बाके जनम लेन कि बजह से खुस होंगे! <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />काहैकि बौ प्रभु के सामने महान होगो। और दाखरस और दारु कहु ना पीगो। और बौ अपने जनम से ही पवित्र आत्मा से भर जागो,<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EPH 5:18">इफिसियों 5:18</ref>; <ref loc="JDG 13:4-5">न्यायियों 13:4-5</ref> </char></note> <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />और इस्राएल के लोगन मैं से भौतन कै उनके प्रभु परमेस्वर के घाँईं करैगो। <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />बौ एलिय्याह भविस्यवक्ता की आत्मा और सामर्थ्य मैं हुईकै बाके अग्गु-अग्गु चलैगो, कि दउवन को मन बाल-बच्चन के घाँईं फेर दे; और नियम ना मानन बारेन कै धर्मी कि समझ मैं लाबै; और प्रभु के ताहीं सिरफ काबिल आदमी कै तैयार करै।”<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">मलाकी 4:5-6</ref></char></note><verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />जकर्याह स्वर्गदूत से पूँछी, “जौ मैं कैसे जानौ? काहैकि मैं तौ बुढ़रा हौं; और मेरी बईंय्यरौं बुढ़िया हुई गई है।”<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />स्वर्गदूत बाकै जबाब दई, “मैं जिब्राईल<note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">दानिय्येल 8:16</ref>; <ref loc="DAN 9:21">दानिय्येल 9:21</ref></char></note> हौं, मैं परमेस्वर के सामने ठाड़ो रहथौ; और मैं तोसे बतकान और तोकै जौ सुसमाचार सुनान के ताहीं भेजो गौ हौं। <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />और देख, जो दिन ले जे बातैं पूरी ना हुई लेमैं, बौ दिन ले तू अपनो मोहों बंद रखागो, और बोल ना पागो, इसलै कि तैं मेरी बातन कै जो अपने समय मैं पूरी होमंगी, उनके ऊपर तैं बिस्वास ना करो।”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />लोग जकर्याह कै असियात रहैं और अचम्मो मानन लागे, कि बाकै मंदिर मैं इतनी देर काहेकै लग रइ है? <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />जब जकर्याह दुआरे आओ, तौ बौ कछु बोल ना पाई और आखरी मैं बे जानगै, कि जकर्याह कै मंदिर मैं कछु दर्सन मिलो है; जकर्याह उनसे इसारन मैं बतान की कोसिस करत रहो, लेकिन बौ गूँगा बनो रहगौ।<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />जब जकर्याह को मंदिर मैं सेवा करन को पूरो समय हुई गौ, तौ बौ अपने घरै चले गौ। <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />थोड़ी दिनन के बाद बाकी बईय्यर एलिसिबा पेट से हुई गई; और पाँच महेना ले अपने आपकै जौ कहकै लुकाए रखाई। <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />कि “इंसानन मैं मेरी बेजती दूर करन के ताहीं प्रभु जे दिनन मैं किरपा करकै मेरे ताहीं ऐसो करी है!”<note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="GEN 30:23">उत्पत्ति 30:23</ref></char></note><verse eid="LUK 1:25" /></para>
  <para style="s">ईसु की जनम की घोसड़ाँ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />एलिसिबा के गरब के छठमें महेना मैं परमेस्वर की तरफ से जिब्राईल नाओं को स्वर्गदूत गलील के नासरत नगर मैं, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />एक कुवाँरी के झोने भेजो गौ। जोको नाओं मरियम रहै बाकी दिखनौरी यूसुफ नाओं दाऊद के बंस के एक आदमी से भइ रहै। <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />और स्वर्गदूत बाके झोने आयकै कही, “तोकै सांति मिलै! प्रभु तेरे संग है और बौ तेरे ऊपर दया करी है!”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />मरियम स्वर्गदूत के संदेस से बड़ा परेसान रहै, और बौ सोचत रहै कि बाकी बातन को का मतलब है। <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />स्वर्गदूत बासे कही, “हे मरियम; डराबै मति, काहैकि परमेस्वर की अनुग्रह तेरे ऊपर भइ है। <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />और देख, तैं पेट से होबैगी, और एक लौड़ा कै जनम देगी, तैं बाको नाओं ईसु रखिये।<note caller="+" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यसायाह 7:14</ref> </char></note> <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />बौ महान होगो; और परमप्रधान परमेस्वर को बालका कहो जागो। और प्रभु परमेस्वर बाके दऊवा दाऊद की सिंहासन बाकै देगो,<note caller="+" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="PSA 132:11">भजन संहिता 132:11</ref>; <ref loc="ISA 9:6-7">यसायाह 9:6-7</ref></char></note> <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />और बौ याकूब के बंस मैं हमेसा राज्य करैगो; और बाको राज कहुए खतम नाय होगो!”<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />मरियम स्वर्गदूत से कही, “मैं एक कुवाँरी हौं। फिर ऐसे कैसे हुई सकथै?”<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />स्वर्गदूत बाकै जबाब दई, “पवित्र आत्मा तेरे ऊपर उतरैगी, और परमप्रधान परमेस्वर की सामर्थ्य तेरे ऊपर आबैगी; जौ बजह से पवित्र बालका कै परमेस्वर को लौड़ा कहो जागो। <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />अपनी हितुनिया एलिसिबा कै समक। जौ कहो जात रहै कि बाकै बालका नाय हुई सकथैं, लेकिन बौ अब छै महेना पेट से है, भलेई बौ बड़ा बुढ़िया होबै। <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />काहैकि ऐसो कुछ भी ना है जो बात परमेस्वर ना कर सकथै।”<note caller="+" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="MAT 19:26">मत्ती 19:26</ref>; <ref loc="JER 32:27">यिर्मयाह 32:27</ref></char></note><verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />मरियम कही, “देख, मैं प्रभु की दासी हौं, जैसो तैं बात कहो है, बैसोई मेरे संग होबै।” फिर स्वर्गदूत बाके झोने से चले गौ।<verse eid="LUK 1:38" /></para>
  <para style="s">मरियम एलिसिबा के झोने जाथै</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />कुछ समय बाद मरियम तैयार भइ और जल्दी से पहाड़ी देस मैं यहूदा के एक सहर मैं चली गई। <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />बौ जकर्याह के घरै जाएकै एलिसिबा कै नमस्ते करी। <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />जब एलिसिबा मरियम को नमस्ते सुनीं, तुरंतै एलिसिबा को बालका बाके पेट मैं उछलो, और एलिसिबा पवित्र आत्मा से भर गई <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />और एलिसिबा जोड़न से चिल्लाए कै कही, “तैं बईंय्यरन मैं परमधन्य है, और आसीसित है बौ बालका जोकै तैं जनम देगी! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />और जौ दया मेरे ऊपर कहाँ से भइ, कि मेरे प्रभु की अईय्या मेरे झोने मिलन कै आई? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />काहैकि जैसी मैं तेरो नमस्ते सुनों, मेरे भीतर को बालका खुसी से उछल पड़ो। <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />तोकै जौ बिस्वास करन मैं कितनी खुसी है कि प्रभु को संदेस तेरे ताहीं सच होगो!”<verse eid="LUK 1:45" /></para>
  <para style="s">मरियम की स्तुति को गीत</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />मरियम कही,</para>
  <para style="q1" vid="LUK 1:46">“अपने आप मेरो मन प्रभु की स्तुति करथै;<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />मेरी आत्मा मेरो उद्धार करन बारे परमेस्वर से खुस भइ है,<verse eid="LUK 1:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="LUK 1:48" />काहैकि बौ अपनी दीन दासी कै याद करी है!</para>
  <para style="q1" vid="LUK 1:48">अब से सब लोग मोकै धन्य कहमंगे,<note caller="+" style="x"><char style="xo" closed="false">1:48 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1 समूएल 1:11</ref>; <ref loc="LUK 1:42">लूका 1:42</ref>; <ref loc="MAL 3:12">मलाकी 3:12</ref></char></note><verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />काहैकि परमेस्वर मेरे ताहीं महान काम करी है।</para>
  <para style="q1" vid="LUK 1:49">बाको नाओं पवित्र है;<verse eid="LUK 1:49" /></para>
  <para style="q2">
    <verse number="50" style="v" sid="LUK 1:50" />और बाकी दया उनके ऊपर</para>
  <para style="q2" vid="LUK 1:50">जो बासे डरथैं, पीढ़ी से पीढ़ी तक बनी रहथै।<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />बौ अपने हातन की ताकत दिखाई</para>
  <para style="q2" vid="LUK 1:51">और जो अपने मन मैं घमंड करथै, उनकै बिखेर दई।<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />बौ सक्तिसाली सासकन कै उनके सिंहासन से नीचे उतारी,</para>
  <para style="q2" vid="LUK 1:52">और दीन कै ऊपर उठाई।<note caller="+" style="x"><char style="xo" closed="false">1:52 </char><char style="xt" closed="false"><ref loc="1SA 2:7">1 समूएल 2:7</ref>; <ref loc="JOB 5:11">अय्यूब 5:11</ref>; <ref loc="PSA 113:7-8">भजन संहिता 113:7-8</ref></char></note><verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />बौ भूंके कै अच्छी चीजन से भर दई,</para>
  <para style="q2" vid="LUK 1:53">और सेठन कै खाली हाथ भेज दई।<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />बौ हमरे बड़े-बूढ़ेन से करो भौ वादा निभाई,</para>
  <para style="q2" vid="LUK 1:54">और बौ अपने सेवक इस्राएल के ऊपर दया और मदत करन आओ है।<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />बौ अब्राहम और बाके पूरे बंस के ऊपर दया करनो</para>
  <para style="q2" vid="LUK 1:55">हमेसा याद रखी है!”<note caller="+" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="GEN 22:17">उत्पत्ति 22:17</ref>; <ref loc="MIC 7:20">मीका 7:20</ref></char></note><verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />मरियम लमसम तीन महेना एलिसिबा के संग रहकै अपने घरै बापस चली गई।<verse eid="LUK 1:56" /></para>
  <para style="s">यूहन्ना बपतिस्मा देनबारे को जनम</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />एलिसिबा के बालका को जनम लेन को समय आए गौ और बौ एक लौड़ा कै जनम दई। <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />बाके पड़ोसी और हितुआ जौ सुनकै, कि प्रभु बाकै ऊपर बड़ा दया करी है, एलिसिबा के संग बड़ा खुस भै।<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />जब बालका एक सप्ताह को रहै, तौ बे बाको खतना करन कै आए और बाको नाओं बाके दऊवा के नाओं मैं जकर्याह रखनो चहात रहैं।<note caller="+" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="GEN 17:12">उत्पत्ति 17:12</ref>; <ref loc="LEV 12:3">लैव्यवस्था 12:3</ref></char></note> <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />लेकिन बाकी अईय्या कही, “न! बाको नाओं यूहन्ना रखो जाबै।”<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />बे एलिसिबा से कहीं, “तेरे हितुअन मैं कोई को जौ नाओं ना है!” <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />फिर बे बाके दऊवा घाँईं इसारा करकै पूँछीं, कि तैं लौड़ा को नाओं का रखनो चाहथै।<verse eid="LUK 1:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63" />जकर्याह लिखन बारी पटिया माँग कै लिख दई, “बाको नाओं यूहन्ना है,” और सब बड़ा हैरान भै! <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />बहे समय जकर्याह फिर से बोलन मैं सक्छम भौ, और बौ आसीसित परमेस्वर को धन्यवाद करन लागो। <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />बाके पड़ोसी सब बड़ा डराएगै; और बे सब बात की खबर यहूदिया के पूरे पहाड़ी देस मैं फैल गई। <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />जो भी जाके बारे मैं सुनीं, बौ जाके बारे मैं मन मैं सोचीं और पूँछीं, “जौ बालका को का होन बारो है?” काहैकि जौ स्पस्ट रहै कि प्रभु की सक्ति बाके ऊपर रहै।<verse eid="LUK 1:66" /></para>
  <para style="s">जकर्याह की भविस्यवाँड़ी</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />यूहन्ना को दऊवा जकर्याह पवित्र आत्मा से भरो पड़ो रहै, और बौ परमेस्वर की भविस्यवाँड़ी सुनाई:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“आबौ हम इस्राएल के परमेस्वर प्रभु की स्तुति करैं!</para>
  <para style="q2" vid="LUK 1:68">बौ अपने लोगन को छुटकारा और आसीस देन ताहीं आओ है, और उनकै आजाद करी है।<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />बौ हमरे ताहीं एक सक्तिसाली उद्धारकर्ता,</para>
  <para style="q2" vid="LUK 1:69">अपने सेवक दाऊद की पीढ़ी दई है।<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />बौ सुरुवातै से अपने पवित्र भविस्यवक्ता के जरिये वादा करी रहै<verse eid="LUK 1:70" /></para>
  <para style="q2">
    <verse number="71" style="v" sid="LUK 1:71" />कि बौ हमैं हमरे बैरियन से बचागो,</para>
  <para style="q2" vid="LUK 1:71">बे सबन की ताकत से जो हमसे बैर रखथैं उनके हात से हमरो उद्धार करी है।<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />बौ कही कि बौ हमरे पुरखन के ऊपर दया करैगो</para>
  <para style="q2" vid="LUK 1:72">और अपनी पवित्र वाचा कै याद रखैगो।<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />हमरे पुरखा अब्राहम के ताहीं एक गंभीर कसम के संग<verse eid="LUK 1:73" /></para>
  <para style="q2">
    <verse number="74" style="v" sid="LUK 1:74" />बौ हमैं हमरे बैरियन से बचान को वादा करी</para>
  <para style="q2" vid="LUK 1:74">और हमैं बिना कोई डर के बाकी आराधना करन की इजाजत दई,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />ताकी हम जिंदगी भर बाके सामने पवित्रता</para>
  <para style="q2" vid="LUK 1:75">और धार्मिकता से बाकी सेवा करत रहमैं।<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />हे मेरे बालका, परमप्रधान परमेस्वर को भविस्यवक्ता कहो जागो।<note caller="+" style="x"><char style="xo" closed="false">1:76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकी 3:1</ref>; <ref loc="ISA 40:3">यसायाह 40:3</ref></char></note></para>
  <para style="q2" vid="LUK 1:76">काहैकि तैं प्रभु को रहा बनान</para>
  <para style="q2" vid="LUK 1:76">के ताहीं बाके अग्गु-अग्गु चलैगो,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />अपने लोगन कै उद्धार को ग्यान दे,</para>
  <para style="q2" vid="LUK 1:77">कि उनके पापन कै माफ करन से बे बच जांगे।<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />हमरो परमेस्वर दया और प्यार से भरो और कोमल है।</para>
  <para style="q1" vid="LUK 1:78">बौ हमरे ऊपर उद्धार को उजितो बारो भोर निकारैगो।<verse eid="LUK 1:78" /></para>
  <para style="q2">
    <verse number="79" style="v" sid="LUK 1:79" />और बे सबन के ऊपर जो मौत के अंधकारमै छाया मैं रहथैं, स्वर्ग से चमकन के ताहीं,</para>
  <para style="q2" vid="LUK 1:79">सांति के रहामैं हमरे कदम को मार्गदर्सन करै।”<note caller="+" style="x"><char style="xo" closed="false">1:79 </char><char style="xt" closed="false"><ref loc="ISA 60:1-2">यसायाह 60:1-2</ref>; <ref loc="ISA 9:2">यसायाह 9:2</ref></char></note><verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />और बौ बालक यूहन्ना, बढ़त और आत्मा मैं ताकतबर होत गौ। यूहन्ना बौ दिन ले जंगल मैं रहो, जब तक कि बौ इस्राएल के आदमी के सामने सार्वजनिक रूप से सामने ना आओ।<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">ईसु को जनम</para>
  <para style="r">(<ref loc="MAT 1:18-25">मत्ती 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />बौ समय कैसर सम्राट औगुस्तुस के हात पूरी जग के साम्राज्य मैं जनगड़ना पंजिका करन को आदेस दई रहै। <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />जौ पहली जनगड़ना<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">जनगड़ना</char></note> बौ समय भइ, जब किरिनियुस सीरिया को राज्यपाल रहै। <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />और सब जनी अपनो नाओं जनगड़ना मैं लिखवान ताहीं अपने-अपने सहर कै गै।<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />यूसुफ जौ बजह से कि बौ राजा दाऊद के घराने और बंस को रहै, गलील के नासरत सहर से यहूदिया मैं दाऊद के सहर बैतलहम कै गौ। <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />बौ मरियम के संग जनगड़ना करवान गै, जोसे बाकी दिखनौरी भइ रहै। और बौ पेट से रहै। <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />और जब बे बैतलहम मैं रहैं, तौ मरियम के बालका को जनम लेन के पूरो समय हुई गौ। <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />मरियम अपनो पहलोठो बालका कै जनम दई, और बाकै लत्ता मैं लपटे कै खुड़ली मैं लिटाए दई काहैकि उनके ताहीं सराय मैं जघा ना रहै।<verse eid="LUK 2:7" /></para>
  <para style="s">बरदिया और स्वर्गदूत</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />बौ देस मैं कुछ बरदिया रहैं, जो रात मैं मैदान मैं रहकै अपने भेंड़-बकरियन के झुंड की रखबारी करत भइ खेतन मैं रात बितात रहैं। <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />उन्हैं परमेस्वर को एक दूत दिखाई दई, और प्रभु की महिमा को तेज उनके ऊपर चमको, बरदिया गजब डराय गै रहैं, <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />पर स्वर्गदूत उनसे कहीं, “मत डराबौ! मैं हिंयाँ तुमरे ताहीं सुसमाचार लैकै आओ हौं, जोसे सब लोगन बड़ा खुसी होगी। <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />आजै के दिन दाऊद के सहर मैं तुमरे ताहीं एक उद्धारकर्ता जनमो है, और बहे प्रभु मसीह है! <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />और जाको तुमरे ताहीं जौ चिन्ह है, कि तुम एक बालका कै लत्ता मैं लिपटो भौ और खुड़ली मैं लेटो भौ पाबैगे।”<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />अनकाचीति एक स्वर्गिय सेना स्वर्गदूत के संग दिखाई दईं, जो परमेस्वर की स्तुति गात रहैं:<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />“परमेस्वर की महिमा ऊँचे स्वर्ग मैं,</para>
  <para style="q2" vid="LUK 2:14">और पृथ्वी मैं सांति बे लोगन के ताहीं है जिनसे बौ खुस है!”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />जब स्वर्गदूत बरदियन के झोने से बापस स्वर्ग मैं चले गै, तौ बरदिया आपस मैं बतकाईं, “आबौ, आपन बैतलहम जाएकै जौ बात जो भईं हैं, और जोके बारे मैं प्रभु हमैं बताई है, देखथैं।”<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />और बे तुरंत फुर्ती से जाएकै मरियम और यूसुफ कै पाईं, और बौ बालक कै खुड़ली मैं पड़ो भौ देखीं। <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />जब बरदिया बाकै देखीं, तौ बे उन्हैं बात बताईं कि स्वर्गदूत बालका के बारे मैं का कहीं रहैं। <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />और सब सुनन बारे, बे बातन कै जो बरदिया उनसे कहीं रहैं, अचम्मे भै। <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />मरियम जे सब बात कै याद करी और उनके बारे मैं से मन सोची। <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />जो कुछ बे सुनीं और देखी रहैं, बौ सबके बजह से बरदिया परमेस्वर के बड़ाँईं को गाना गात भै लौट गै; जौ बैसोई भौ जैसो स्वर्गदूत उन्हैं बताईं रहैं।<verse eid="LUK 2:20" /></para>
  <para style="s">ईसु को नामकरड़</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />एक सप्ताह बाद, जब बालका को खतना करन को समय आओ, तौ बाको नाओं ईसु रखो गौ, जो स्वर्गदूत बाके कोक मैं आन से पहले बाकै दई रहै।<note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 17:12">उत्पत्ति 17:12</ref>; <ref loc="LEV 12:3">लैव्यवस्था 12:3</ref></char></note><verse eid="LUK 2:21" /></para>
  <para style="s">ईसु कै मंदिर मैं लाओ गौ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />जब मूसा की नियम के हिसाब से मरियम के सुद्ध होन को समय आए गौ, तौ यूसुफ और मरियम बौ बालका कै प्रभु के सामने यरूसलेम मैं लैगै, <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />जैसो कि प्रभु के नियम मैं लिखो है: “हर एक पहलोठो पुरुस प्रभु के ताहीं पवित्र सौंपो जाए।”<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">निर्गमन 13:2</ref>,<ref loc="EXO 13:12">12</ref></char></note> <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />बे प्रभु की नियम के हिसाब से एक जोड़ी कछुआ या कबूतर के दुई बच्चन की बलि चढ़ान गै।<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />बौ समय यरूसलेम मैं सिमौन नाओं को सिरफ एक धर्मी आदमी रहै, सिमौन एक अच्छो और साहसी भक्त रहै और इस्राएल कि सांति के ताहीं असियात रहै, और पवित्र आत्मा बाके संग रहै। <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />पवित्र आत्मा के जरिये सिमौन कै भरोसो दौ गौ रहै कि जबले तैं प्रभु मसीह कै देख ना लेगो, तौले तैं ना मरैगो। <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />पवित्र आत्मा के सिखाने मैं, सिमौन मंदिर मैं आओ; जब अईय्या-दऊवा बालका ईसु कै मंदिर मैं लाईं, कि ईसु के ताहीं नियम के हिसाब से करैं, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />सिमौन बालका कै गोदी मैं लई और परमेस्वर को धन्यवाद करकै आसीस दई:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“अब, हे प्रभु, तैं अपनी बात के जरिया अपनो वादा पूरो करो है,</para>
  <para style="q2" vid="LUK 2:29">और तैं अपने सेवक कै सांति से बिदा कर दे;<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />काहैकि मेरी आँखी तेरे उद्धार कै देख लईं हैं,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />जोकै तैं सब लोग के सामने तैयार करो है:<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />गैर यहूदि के ऊपर अपनी इच्छा दिखान के ताहीं एक जोती</para>
  <para style="q2" vid="LUK 2:32">और तेरे खुद के लोगन ताहीं इस्राएल की महिमा होबै।”<note caller="+" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ISA 42:6">यसायाह 42:6</ref>; <ref loc="ISA 49:6">49:6</ref></char></note><verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />सिमौन बाके बारे मैं जो कछु कही बासे बालका के अईय्या और दऊवा अचम्मे रहगै। <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />फिर सिमौन उनकै आसीस और आर्सिवाद दई और मरियम, ईसु की अईय्या से कही, “जौ बालका कै परमेस्वर इस्राएल मैं भौत लोगन को गिरन और जी उठन के ताहीं चुनी है। बौ परमेस्वर की तरफ से एक चिन्ह होगो, जोके खिलाप भौत जनी बोलंगे <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />और इसलै उनकी लुकी भइ सोच सामने आमंगी। और दुख, एक धारदार तलवार के हानी तेरो अपनो मन अपने आप तोड़ डारैगो।”<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />असेर के गोत्र मैं से हन्ना नाओं कि फनूएल की लौड़िया एक भविस्यवक्ता रहै: बौ बड़ा बूढ़ी रहै, और बिहा होन के बाद अपने लोगा के संग सात साल जिंदगी बिता पाई रहै। <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />हन्ना चौरासी साल की हुई चुकी रहै: बौ मंदिर कहु नाय छोड़त रहै; दिन-रात बौ परमेस्वर की आराधना करत रहै, बर्त रखत रहै और प्रार्थना करत रहै। <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />हन्ना बहे समय हुँआँ आयकै परमेस्वर को धन्यवाद देन लागी, और बे सबन से, जो यरूसलेम के छुटकारा ताहीं असियात रहैं, बौ बालका ईसु के बारे मैं उनसे बतकान लागी।<note caller="+" style="x"><char style="xo" closed="false">2:38 </char><char style="xt" closed="false"><ref loc="ISA 52:9">यसायाह 52:9</ref></char></note><verse eid="LUK 2:38" /></para>
  <para style="s">यूसुफ और मरियम को नासरत बापस घरै लौटनो</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />और जब यूसुफ और मरियम प्रभु के नियम के हिसाब से सब निपटाए चुके तौ बे गलील मैं नासरत सहर अपने घरै बापस चले गै। <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />बालका बड़ो होत गौ, और मजबूत हुई गौ; बौ ग्यान से भरो रहै, और बाके ऊपर परमेस्वर को अनुग्रह रहै।<verse eid="LUK 2:40" /></para>
  <para style="s">लौड़ा ईसु मंदिर मैं</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />हर साल ईसु के अईय्या-दऊवा फसह को त्योहार के ताहीं यरूसलेम कै जाए करत रहैं।<note caller="+" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:24-27">निर्गमन 12:24-27</ref>; <ref loc="DEU 16:1-8">व्यवस्थाविवरन 16:1-8</ref></char></note> <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />जब ईसु बारह साल को रहै, तौ बे हमेसा की तरह त्योहार मैं यरूसलेम कै गै। <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />जब त्योहार खतम हुई गौ, तौ बे घरै बापस लौट गै, लेकिन बालक ईसु यरूसलेम मैं रहगौ। बाके अईय्या-दऊवा कै जौ पता नाय रहै; <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />बे सोचीं कि बौ भीड़ के संग है, इसलै बे पूरे दिन सफर करीं और फिर अपने हितुअन और अपने पहचान बारेन के बीच बाकै ढूँड़न लगे। <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />ईसु जब उनकै नाय मिलो, तौ बे बाकै ढूँड़त-ढूँड़त बापस यरूसलेम कै चले गै। <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />और तीन दिन के बाद बे ईसु कै मंदिर मैं यहूदि सिक्छकन के संग बैठो, उनकी बातन कै सुनत और सवाल पूँछत भइ पाईं। <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />और जो बाकै सुनत रहैं, बे बाके बुद्धिमान जबाब से बड़ा हैरान हुई जात रहैं। <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />जब बाके अईय्या-दऊवा अपने बालका कै देखीं तौ बे हैरान ही गै, और ईसु की अईय्या बासे कही, “बेटा, तैं हमरे संग ऐसो काहे करो? तेरो दऊवा और मैं तोकै ढूँड़न की कोसिस मैं गजब परेसान भै।”<figure style="fig" alt="Temple in Jerusalem" file="lb00250c.tif" size="span" copy="Horace Knowles ©" ref="2:41">यरूसलेम मैं मंदिर</figure><verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />ईसु जबाब दई, “तुम मोकै काहेकै ढूँड़ रै हौ? का ना जानत रहौ, कि मोकै अपने दऊवा के घरै होनो जरूरी है?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />लेकिन उन्हैं बाकी बात समझ मैं ना आई।<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />इसलै ईसु उनके संग बापस नासरत मैं चले गौ, जहाँ बौ उनकी बात माने करतो। और उनके वस मैं रहो; बाकी अईय्या जे सब बातन कै अपने मन मैं संजोए कै धरे रखाई। <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />ईसु सरीर और बुद्धि दोनों मैं खूब बढ़त गौ, परमेस्वर और लोगन के अनुग्रह मैं बढ़तो चलो गौ।<note caller="+" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 समूएल 2:26</ref>; <ref loc="PRO 3:4">नीतिवचन 3:4</ref></char></note><verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">यूहन्ना बपतिस्मा देनबारे को सन्देस</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती 3:1-12</ref>; <ref loc="MRK 1:1-8">मरकुस 1:1-8</ref>; <ref loc="JHN 1:19-28">यूहन्ना 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />जौ सम्राट तिबिरियुस के सासन को पन्द्रमों साल रहै; पुन्तियुस पिलातुस यहूदिया को राज्यपाल रहै, हेरोद अंतिपास गलील देस को सासक रहै, और बाको भईय्या फिलिप्पुस इतूरैया और तरखोनीतिस के इलाका को सासक रहै; लिसानियास अबिलेने इलाका को सासक रहै, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />और हन्ना और कैफा बड़ो पुजारी<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">बड़ो पुजारी</char></note> रहै, बौ समय परमेस्वर को बचन जकर्याह को लौड़ा यूहन्ना के झोने पुगो जो रेगिस्तान मैं रहत रहै। <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />जौ बजह से यूहन्ना यरदन नदिया के आस-पास पूरे इलाका मैं गौ, प्रचार करी, “अपने पापन से मन फिराबौ और बपतिस्मा लेबौ, और परमेस्वर तुमरे पापन कै माफ कर देगो।” <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />जैसो कि यसायाह भविस्यवक्ता<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">आनबारे समय के बारे मैं बतान बारो</char></note> कि किताब मैं लिखो गौ है:</para>
  <para style="q1" vid="LUK 3:4">“कोई रेगिस्तान मैं पुकार रौ है:</para>
  <para style="q2" vid="LUK 3:4">कि प्रभु के ताहीं रहा सूदी करौ;</para>
  <para style="q2" vid="LUK 3:4">सफर के लै प्रभु के ताहीं एक सीधी रहा बनाबौ!<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />हर एक घाट कै भर दई जागी,</para>
  <para style="q2" vid="LUK 3:5">हर पहाड़ी और पहाड़ कै नीचो कर दौ जागो;</para>
  <para style="q1" vid="LUK 3:5">और जो टेहड़ी रहा है बाकै सीधी करो जानो चाहिए,</para>
  <para style="q2" vid="LUK 3:5">और ऊबड़-खाबड़ रहा मुलायम बनैगो।<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />पूरी इंसान की जाति परमेस्वर के उद्धार कै देखैगी!”<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />बड़ी भीड़ यूहन्ना से बपतिस्मा लेन के ताहीं निकरकै आत रहै, उनसे यूहन्ना कहत रहै, “साँप के बालकौ, तुमकै कौन चिताओ, कि आनबारे गुस्सा से भाजौ? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />बे कामन कै करौ जिनसे पता चलै कि तुम अपने पापन से मन फिराए लै हौ। और आपस मैं जौ ना कहियो कि अब्राहम तुमरो पुरखा है। मैं तुमसे कहथौं कि परमेस्वर जे चट्टानन कै लैकै अब्राहम को बंसज बनाए सकथै! <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />और अब कुल्हाड़ी पेंड़ कै जड़ से काटन के ताहीं तैयार है; अच्छो फल ना देनबारे हर पेंड़ कै काटकै आगी मैं डार दौ जागो।”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />और लोग बासे पूँछीं, “तौ हम का करैं?”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />यूहन्ना जबाब दई, “जोके पास दुई कुरता होमैं, बौ बाकै एक कुरता देबै जोके पास ना है, और जोके पास खानु है बहो बाँटनों चाहिए।”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />और कुछ लगान<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">चुंगी</char></note> लेन बारे भी बपतिस्मा लेन आए, और बे यूहन्ना से कहीं, “गुरु, हम का करैं?”<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />यूहन्ना उनसे कही, “जित्तो तुमरे ताहीं तैं करो गौ है, बासे जद्धे मत लियो।”<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />और कुछ सिपईय्या यूहन्ना से पूँछीं, “हमैं का करनो चाहिए?”</para>
  <para style="p" vid="LUK 3:14">यूहन्ना उनसे कही, “कोई के ताकत दिखाए कै बासे पैसा मत लियो या फिर कोई के ऊपर झूठो इल्जाम मत लगइयो, अपनी तनखा से सन्तुस्ट रहबौ।”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />लोगन की उमीद बढ़न लगी और बे अचम्मे और मन मैं सोचन लगे कि कहीं सायद यूहन्ना मसीह तौ ना है। <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />फिर यूहन्ना बे सबन के जबाब मैं कही, “मैं तौ तुमकै पानी से बपतिस्मा देथौं, लेकिन बौ आनबारो है, जो मोसे ताकतबर है; मैं तौ जहो काबिल ना हौं, कि बाके जूतन की तनी खोल सकौं, बौ तुमकै पवित्र आत्मा और आगी से बपतिस्मा देगो। <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />बाके पास अपनो खुद को सूपो है, और बौ अपनो खेत खलियान कै अच्छे से साफ करैगो; और गेंहूँ कै अपने खाते मैं इखट्टो करैगो, लेकिन गेंहूँ छान कै बौ भूसा कै अलग करकै आगी मैं जलागो जो कहु बुझत ना है।”<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />यूहन्ना भौत सी सिक्छा दै दैकै लोगन कै सुसमाचार सुनात भइ मन फिरान के ताहीं नहोरे करत रहै। <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />लेकिन यूहन्ना गवर्नर हेरोद कै फटकार लगाई, काहैकि हेरोद अपने भईय्या फिलिप्पुस की बईय्यर हेरोदियास से बिहा करी रहै, और भी भौत से बुरे काम करी रहै। <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />तौ हेरोद यूहन्ना कै कैदखाना मैं डारकै औरौ बड़ो काम करी।<verse eid="LUK 3:20" /></para>
  <para style="s">ईसु को बपतिस्मा</para>
  <para style="r">(<ref loc="MAT 3:13-17">मत्ती 3:13-17</ref>; <ref loc="MRK 1:9-11">मरकुस 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />सब जनी के बपतिस्मा लेन के बाद, ईसु भी बपतिस्मा लई। जब बौ प्रार्थना करत रहै, तौ स्वर्ग खुल गौ, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />और पवित्र आत्मा सारीरिक रूप मैं कबूतर के हानी ईसु के ऊपर उतरो, और स्वर्ग से जौ आकासवाड़ी भइ, “तैं मेरो प्रिय लौड़ा है, मैं तोसे खुस हौं।”<verse eid="LUK 3:22" /></para>
  <para style="s">ईसु के पुरखा</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />जब ईसु अपनो काम सुरु करी तौ बौ लमसम तीस साल को रहै और जैसी लोग समझत रहैं कि बौ यूसुफ को लौड़ा रहै; जो कि यूसुफ एली को लौड़ा रहै, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />और एली मत्तान को, और मत्तान लेवी को, और लेवी मलाकी को, और मलाकी यन्नाई को, और बौ यूसुफ को, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />और यूसुफ मत्तित्याह को, और बौ आमोस को, और बौ नहूम को, और नहूम असल्याह को, और असल्याह नोगह को, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />और नोगह मात को, और मात मत्तित्याह को, और बौ सिमी को, और बौ योसेख को, और योसेख योदाह को, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />और योदाह यूहन्ना को, और यूहन्ना रेसा को, और रेसा जरूब्बाबेल को, जरूब्बाबेल सालतियेल को, और सालतियेल नेरी को, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />और नेरी मलकी को, और मलकी अद्दी को, और अद्दी कोसाम को, और कोसाम इलमोदाम को, और इलमोदाम एर को, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />और एर जोस्वा को, जोस्वा एलीएजेर को, और एलीएजेर योरीम को, और योरीम मत्तात को, और मत्तात लेवी को, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />और लेवी सिमौन को, और सिमौन यहूदा को, और यहूदा यूसुफ को, और यूसुफ योनान को, और योनान एलयाकीम को, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />और एलयाकीम मलेआह को, और मलेआह मिन्नाह को, और मिन्नाह मत्तता को, और मत्तता नातान को, और नातान दाऊद को, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />और दाऊद यिसै को, और यिसै ओबेद को, और ओबेद बोअज को, और बोअज सलमोन को, और सलमोन नहसोन को, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />और नहसोन अम्मीनादाब को, और अम्मीनादाब आदमिन को, आदमिन अरनी को, और अरनी हेस्रोन को, और हेस्रोन पेरेस को, और पेरेस यहूदा को, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />और यहूदा याकूब को, और याकूब इसहाक को, और इसहाक अब्राहम को, और अब्राहम तेरह को, और तेरह नाहोर को, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />और नाहोर सरूग को, और सरूग रऊ को, और रऊ पेलेग को, और पेलेग एबिर को, और एबिर सिलह को, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />और सिलह केनान को, और केनान अरफक्छद को, और अरफक्छद सेम को, और सेम नूह को, और नूह लेमेक को, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />और लेमेक मथूसिलह को, और मथूसिलह हनोक को, और हनोक यिरिद को, और यिरिद महललेल को, महललेल केनान को, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />और केनान एनोस को, और एनोस सेत को, और सेत आदम को, और आदम परमेस्वर को लौड़ा रहै।<note caller="+" style="x"><char style="xo" closed="false">3:38 </char><char style="xt" closed="false"><ref loc="GEN 5:1-3">उत्पत्ति 5:1-3</ref>; <ref loc="1CH 1:1-4">1 इतिहास 1:1-4</ref></char></note><verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">ईसु की परिक्छा</para>
  <para style="r">(<ref loc="MAT 4:1-11">मत्ती 4:1-11</ref>; <ref loc="MRK 1:12">मरकुस 1:12</ref>,<ref loc="MRK 1:13">13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />ईसु पवित्र आत्मा से भरो भौ, यरदन नदिया से लौटो; और आत्मा कि अगुवाई मैं रेगिस्तान मैं फिरत रहो, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />और चालीस दिन ले सैतान ईसु की परिक्छा लेत रहो।<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />सैतान ईसु से कही, “अगर तैं परमेस्वर को लौड़ा है, तौ जौ पथरा से कह, कि रोटी बन जा।”<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />ईसु जबाब दई, “सास्त्र मैं लिखो है, ‘इंसान खाली रोटी से जिंदो ना रह सकथै।’”<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">व्यवस्थाविवरन 8:3</ref></char></note><verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />तौ सैतान ईसु कै उठाएकै लैगौ और ईसु कै दुनिया भर के राज्य दिखाई। <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />और सैतान ईसु से कही, “मैं जौ सब अधिकार और जौ सब धन-दौलत और महिमा तोकै दुंगो,” काहैकि “जौ सब मोकै सौंप दौ गौ है, और जोकै चाहथौं, बाकै दै सकथौं। <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />अगर तैं मेरी आराधना करैगो, तौ जौ सब तेरो होगो।”<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />ईसु जबाब दई, “सास्त्र कहथै, ‘कि तू प्रभु अपने परमेस्वर की आराधना कर और सिरफ बहे की सेवा कर!’”<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />तौ सैतान ईसु कै यरूसलेम मैं लैगौ और ईसु कै मंदिर के सबसे ऊँची जघा मैं ठड़बाए दई, और ईसु से कही, “अगर तैं परमेस्वर को लौड़ा है, तौ अपने आपकै हिंयाँ से तरे फेंक दे। <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />काहैकि सास्त्र मैं लिखो है, ‘कि परमेस्वर अपने दूतन कै आग्या देगो, कि बे तेरी रक्छा करैं।’ <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />और जहो कहो गौ है, ‘बे तोकै हातो-हाथ उठाए लेंगे ताकी तेरे पाँव मैं पथरन से चोट ना लगै।’”<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />ईसु सैतान कै जबाब दई, “सास्त्र जहो कहथै, ‘प्रभु अपने परमेस्वर कै परिक्छा मैं मत डारियो।’”<note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">व्यवस्थाविवरन 6:16</ref></char></note><verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />जब सैतान सब परिक्छा लै चुको, तौ थोड़ी समय ताहीं ईसु झोने से चले गौ।<verse eid="LUK 4:13" /></para>
  <para style="s">गलील मैं ईसु की सेवकाई और काम</para>
  <para style="r">(<ref loc="MAT 4:12-17">मत्ती 4:12-17</ref>; <ref loc="MRK 1:14">मरकुस 1:14</ref>,<ref loc="MRK 1:15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />फिर ईसु गलील मैं लौटियाओ, और पवित्र आत्मा की सामर्थ्य बाके संग रहै, ईसु के बारे मैं खबर पूरे आस-पास के इलाका मैं फैल गई। <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />ईसु सभाघरन मैं पढ़ाई और सब ईसु की बड़ाँईं करे करते।<verse eid="LUK 4:15" /></para>
  <para style="s">ईसु कै नासरत मैं ना अपनाईं</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती 13:53-58</ref>; <ref loc="MRK 6:1-6">मरकुस 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />फिर ईसु नासरत मैं आओ; जहाँ बाको पालन-पोसँड़ भौ रहै, और हमेसा की तरह साबत के दिन सभाघर मैं गौ। ईसु सास्त्र पढ़न के ताहीं ठाड़गौ <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />और यसायाह भविस्यवक्ता की किताब बाकै दई गई, और ईसु चिट्ठी खोलकै, बौ जघा निकारी जहाँ जौ लिखो रहै,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“प्रभु की आत्मा मेरे मैं है,</para>
  <para style="q2" vid="LUK 4:18">काहैकि बौ कंगालन कै सुसमाचार सुनान के ताहीं मेरो अभिसेक करी है।</para>
  <para style="q1" vid="LUK 4:18">और मोकै जौ ताहीं भेजी है, कि मैं बंधुवन कै छुटकारा को प्रचार</para>
  <para style="q2" vid="LUK 4:18">और अंधरन कै उजीते,</para>
  <para style="q1" vid="LUK 4:18">और दुखियारेन कै आजाद करौं,<note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="ISA 58:6">यसायाह 58:6</ref>; <ref loc="ISA 61:1">61:1</ref>,<ref loc="ISA 61:2">2</ref></char></note><verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />और खबर को प्रचार फैलाय दियौ कि बौ समय आयगौ है</para>
  <para style="q2" vid="LUK 4:19">जब प्रभु अपने लोगन कै बचागो।”<figure style="fig" alt="Scroll" file="hk00150c.tif" size="col" copy="Horace Knowles ©" ref="4:16">लपेटी भइ किताब</figure><verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />फिर ईसु किताब कै बन्द करकै बापस सेवक कै दै दई, और बैठगौ। और सभाघर मैं सब जनी की नजर ईसु के ऊपर टिकी रहैं, <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />फिर ईसु उनसे कही, “पवित्र सास्त्र को जौ लिखो भौ तुमरे सामने आज सच हुई गौ है, जैसो कि तुमरे सामने पढ़ो जाएरौ है।”<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />और बे सब ईसु कै सराहीं, और जो अनुग्रह की बात ईसु के मोहों से निकरत रहैं, उनसे बे अचम्मे भै; और कहेन लागे, “का जौ यूसुफ को लौड़ा ना है?”<note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="LUK 2:42">लूका 2:42</ref>; <ref loc="PSA 45:2">भजन संहिता 45:2</ref> </char></note><verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />ईसु उनसे कही, “तुम मेरे ऊपर जौ कहानी जरूर कहबैगे, ‘कि बैध, अपने आपकै अच्छो कर!’ जो कुछ तुम सुने हौ कि जो कफरनहूम मैं भौ रहै, बाकै तुम मोकै हिंयाँ अपने देस मैं भी करन ताहीं कहगे।” <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />ईसु कही, मैं तुमसे सच्ची कहथौं, “कोई भविस्यवक्ता कै अपने देस मैं मान-सम्मान नाय मिलथै। <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />मेरी बात सुनों: जौ सच है कि एलिय्याह के समय मैं जब साढ़े तीन साल ले आसमान से मेंहें ना बरसो और पूरे देस मैं भैंकर आकाल पड़ो रहै, तौ इस्राएल मैं भौत एक बिधवा रहैं।<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 राजा 17:1</ref>; <ref loc="1KI 18:1">18:1</ref></char></note> <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />पर एलिय्याह कै उनमैं से कोई के झोने नाय भेजो गौ, खाली सैदा के जारफत मैं एक बिधवा कै छोड़कै।<note caller="+" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:9">1 राजा 17:9</ref></char></note> <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />और एलीसा भविस्यवक्ता के समय इस्राएल मैं भौत से कोहढ़ी रहैं, पर सीरिया वासी नामान कै छोड़कै उनमैं से कोई सुद्ध ना करो गौ रहै।”<note caller="+" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2 राजा 5:1-14</ref></char></note><verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />सभाघर के आदमी जौ सुनकै, सब बड़ा गुस्सा मैं आयगै। <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />और बे उठकै ईसु कै सहर से बाहर निकारीं, और बौ पहाड़ी की चुटिया मैं लैगै, जोमैं उनको सहर बसो रहै, बे ईसु कै नीचे चट्टान मैं फेंकन ताहीं लैगै रहैं, <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />पर बौ भीड़ के बीच से निकरकै अपने रहा चले गौ।<verse eid="LUK 4:30" /></para>
  <para style="s">बुरी आत्मा कै एक आदमी के भीतर से निकारी</para>
  <para style="r">(<ref loc="MRK 1:21-28">मरकुस 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />फिर ईसु गलील के एक कफरनहूम सहर मैं गौ, और बौ लोगन कै साबत के रोज यहूदियन के सभाघर मैं उपदेस दई। <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />बे ईसु के उपदेस से अचम्मे भै, काहैकि ईसु बचन कै सबके अधिकार से बात करी रहै। <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />सभाघर मैं एक आदमी रहै, जोके अंदर एक असुद्ध प्रेत आत्मा घुसी रहै; बौ बड़ा जोड़ से चिल्लाई, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“आँह! हमकै तोसे का काम, नासरत के ईसु? का तैं हमैं नास करन कै आओ है? मोकै पता है कि तैं कौन है: तैं परमेस्वर को पवित्र दूत है!”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />ईसु भूत कै आग्या दई, “चुप रहा और आदमी के भीतर से बाहर निकर जा!” प्रेत आत्मा आदमी कै उनके सामने नीचे फेंक दई और बिना कोई नुकसान करे बाके अंदर से निकर गौ।<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />जौ सब देखकै सब जनी अचम्मे भै, और बे आपस मैं एक-दुसरेन से कहेन लागे, “जे कैसे सब्द हैं? अधिकार और सामर्थ्य के संग जौ आदमी प्रेत आत्मा कै हुकम देथै, और बे बाहर निकर जाथैं!” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />और ईसु के बारे मैं सब गाँव मैं खबर फैल गई।<verse eid="LUK 4:37" /></para>
  <para style="s">ईसु भौत जनी कै अच्छो करथै</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्ती 8:14-17</ref>; <ref loc="MRK 1:29-34">मरकुस 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />ईसु सभाघर छोड़कै सिमौन के घरै चले गौ। सिमौन की सास तेज बुखार से बिमार रहै, और बे ईसु से बाके बारे मैं पूँछीं। <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />ईसु बाकी सास झोने ठाड़कै बुखार कै बाकै छोड़न को आग्या दई और बुखार बाके अंदर से उतर गौ, और बौ एकै बार मैं उठ गई और उनकी सेवा करन लग्गई।<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />दिन मुदन के बाद, जो-जोके हिंयाँ लोग भौत तरहन की बिमारी से बिमार रहैं, बे सब उनकै ईसु के झोने लै आईं, और ईसु एक-एक के ऊपर हाथ रखकै उनकै अच्छो करी। <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />और प्रेत आत्मा चिल्लाए-चिल्लाए कै कहेन डटे पड़े, “तैं परमेस्वर को लौड़ा है,” भौतन मैं से प्रेत आत्मा निकर गई, और ईसु उनकै आग्या देतो और उनकै बोलन तक ना देत रहै, काहैकि भूत जानत रहैं, कि जौ मसीह है।<verse eid="LUK 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />जब दिन भौ तौ ईसु निकरकै एक एकांत जघा मैं गौ, लोग ईसु कै ढूँड़न लग्गै, और जब ईसु कै ढूँड़ डारीं, तौ बे ईसु कै रोकन लग्गै, कि तैं हमरे झोने से मत जाबै। <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />लेकिन ईसु उनसे कही, “मोकै दुसरे सहरन मैं भी परमेस्वर के राज्य को सुसमाचार प्रचार करनो जरूरी है, काहैकि परमेस्वर मोकै जहे ताहीं भेजी है।”<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />और बौ पूरे गलील देस मैं यहूदिया के सभाघरन मैं प्रचार करी।<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">ईसु पहलो चेला कै बुलाई</para>
  <para style="r">(<ref loc="MAT 4:18-22">मत्ती 4:18-22</ref>; <ref loc="MRK 1:16-20">मरकुस 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />एक दिन ईसु गन्नेसरत की झील के किनारे ठाड़ो रहै, और लोग परमेस्वर को बचन सुनन के ताहीं ईसु के ऊपर भीड़ गिरी जात रहै, <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />ईसु झील के किनारे दुई नईंयाँ लगी भइ देखी, बे नईंयाँ मैं से उतरकै मछरिया जार धोत रहैं। <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />बे नईंयाँ मैं से एक के ऊपर चढ़कै, जो सिमौन की रहै, ईसु बासे डींड़े से थोड़ी भीतर कै धक्का देन ताहीं पूँछी, फिर ईसु नईंयाँ मैं बैठकै भीड़ कै उपदेस दई।<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />जब ईसु बोलनो बंद करी, तौ बौ सिमौन से कही, “नईंयाँ गहरे मैं लै चल, और तैं और तेरे संग के मच्छी मारन ताहीं अपने जार डारौ।”<figure style="fig" alt="Fishermen in boat and catch fish" file="hk00208c.tif" size="span" copy="Horace Knowles ©" ref="5:4">नईंयाँ मैं चढ़कै मछबारे मच्छी पकड़त भइ</figure><verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />सिमौन ईसु कै जबाब दई, “गुरुजी, हम पूरी रात मेहनत करे और कछु ना पकड़पाए; लेकिन तैं ऐसो कहरौ है, तौ मैं जार कै डारंगो।” <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />जब बे जार डारीं, तौ इतनी मच्छी आए गईं कि जार फटन लग्गौ। <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />इसलै बे अपने सहभागी के जो दुसरी नईंयाँ मैं रहैं, उनकै इसारा करीं, कि आयकै हमरी मदत करौ: और बे आयकै दोनों नईंयाँ कै मच्छी से इत्तो भर दईं कि नईंयाँ तक डूबा-डूब करैं। <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />जौ सब देखकै सिमौन पतरस ईसु के घूँटो मैं गिर गौ, और कही, “प्रभु, मेरे झोने से चले जा, मैं एक पापी आदमी हौं!”<verse eid="LUK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9" />सिमौन और बाके संग के इतनी जाधे मच्छी पकड़कै हैरान रहैं। <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />और बैसिये जब्दी को लौड़ा याकूब और यूहन्ना कै भी, जो सिमौन के सहभागी रहैं, हैरान भै फिर ईसु सिमौन से कही, “मत डराबै, अब से तैं लोगन कै परमेस्वर के झोने लागो।”<verse eid="LUK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11" />और बे नईंयाँ कै झील के डींड़े लै आईं और सब कछु छोड़-छाड़ कै ईसु के पच्छू ही लईं।<verse eid="LUK 5:11" /></para>
  <para style="s">ईसु एक कोहढ़ी आदमी कै अच्छो करी</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्ती 8:1-4</ref>; <ref loc="MRK 1:40-45">मरकुस 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />जब ईसु एक सहर मैं रहै, तौ हुँआँ कोढ़ से भरो भौ एक आदमी आओ, और बौ ईसु कै देखकै मोहों के बल गिरो, और नहोरे करी, “प्रभु अगर तैं चाहबै तौ मोकै सुद्ध कर सकथै!”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />ईसु हाथ बढ़ायकै बाकै छुइ और कही, “मैं चाहथौं, तैं कोहोढ़ से सुद्ध हुई जा।” और एक बार मैं बिमारी बौ आदमी कै छोड़ दई। <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />फिर ईसु बाकै हुकम दई, “कोई कै मत बतइये, लेकिन तैं सूदे पुजारी के झोने जा और अपने-आपकै दिखा; और अपने सुद्ध होन के बारे जो कछु मूसा चढ़ावा चढ़ाई है बाकै चढ़ा कि उनके ऊपर गभाई होबै; सबन कै साबित करन के ताहीं कि तैं ठीक हुई गौ है, तौ जैसो मूसा हुकम दई है” बैसिये भेंट चढ़ा।<note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 13:49">लैव्यवस्था 13:49</ref>; <ref loc="LEV 14:2-32">14:2-32</ref></char></note><verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />लेकिन ईसु के बारे मैं खबर और जोर-सोर से फैल गई, और लोगन की भीड़ बाकै सुनन ताहीं और अपनी बिमारिन से अच्छो होन के ताहीं जुरानी। <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />लेकिन ईसु अकेली जघा मैं जाएकै प्रार्थना करे करतो।<verse eid="LUK 5:16" /></para>
  <para style="s">ईसु एक फालिस की बिमारी बारे आदमी कै अच्छो करथै</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्ती 9:1-8</ref>; <ref loc="MRK 2:1-12">मरकुस 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />एक दिन ऐसो भौ जब ईसु उपदेस देत रहै, तौ कुछ फरीसी और नियम के सिक्छक हुँआँ बैठे रहैं, जो गलील और यहूदिया के हर एक सहर से और यरूसलेम से आए रहै; और बिमारन कै अच्छो करन की प्रभु की सामर्थ्य ईसु के पास रहै। <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />कुछ आदमी एक फालिस मारे भै आदमी कै खटिया मैं लाईं, और बे ईसु के सामने घर के भीतर लै जान की बड़ा कोसिस करीं। <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />जब बे भीड़ के बजह से बाकै भीतर ना ला पाईं तौ बे बाकै छप्पर मैं लै जाएकै छप्पर हटाएकै, बाकै खटिया समेत बीच मैं ईसु के सामने उतार दईं। <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />जब ईसु देखी कि उनमैं कितनो बिस्वास है, तौ ईसु बौ आदमी से कही, “तेरे पाप माफ हुईगै, मेरे दोस्त।”<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />फिर यहूदि नियम के सिक्छक और फरीसी अपने मैं कहेन लागे, “जौ कौन आदमी है, जो परमेस्वर की बुराई कर्‌रौ है! खाली एकै परमेस्वर है जो पापन की माफी दै सकथै!”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />ईसु उनकी मन की बात जानकै, उनसे कही, “तुम ऐसी बात काहे सोच रै हौ? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />सई का है? का जौ कहनो, कि ‘तेरे पाप माफ हुईगै,’ या जौ कहनो कि ‘उठ और चल फिर?’ <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />मैं तुमकै जौ साबित कर दुंगो कि आदमी के लौड़ा कै पृथ्वी मैं पाप माफ करन को भी अधिकार है।” ईसु बौ फालिस मारे भै आदमी से कही, “मैं तोसे कहथौं, उठ और अपनी खटिया उठा और घरै चले जा!”<verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />बौ मोहोंट से उनके सामने उठो, और जोमैं बौ लेटो रहै बाकै उठाएकै, परमेस्वर की बड़ाँईं करत भइ अपने घर कै चलो गौ। <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />बे सब बड़ा चकाएगै और परमेस्वर की बड़ाँईं करन लागे, और बड़ा डराएकै कहेन लगे, “आज हम अनोखी चीज देखे हैं!”<verse eid="LUK 5:26" /></para>
  <para style="s">ईसु लेवी कै बुलाथै</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती 9:9-13</ref>; <ref loc="MRK 2:13-17">मरकुस 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />जाके बाद, ईसु बाहर गौ और लेवी नाओं के एक आदमी कै लगान लेन बारी चौकी मैं बैठो देखी, और बासे कही, “मेरे पच्छू आ।” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />लेवी सब कछु छोड़कै उठो, और ईसु के पच्छू हुई लई।<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />और लेवी अपने घरै ईसु के ताहीं बड़ो हटकना करी; और लगान लेन बारेन कि और दुसरे लोगन कि जो ईसु के संग खानु खान बैठे रहै उनकी भीड़ रहै। <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />कुछ फरीसी घाँईं यहूदि नियम के सिक्छक ईसु के चेलन से सिकायत करीं, “तुम लगान लेन बारेन और पापिन के संग काहेकै खाथौ-पीथौ?”<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />ईसु उनकै जबाब दई, “बैध भले अच्छेन के ताहीं नाय, लेकिन बिमारन के ताहीं जरूरी है। <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />मैं धर्मी कै नाय, बल्कि पापिन को मन फिरान के ताहीं बुलान आओ हौं।”<verse eid="LUK 5:32" /></para>
  <para style="s">बर्त के बारे मैं सबाल</para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्ती 9:14-17</ref>; <ref loc="MRK 2:18-22">मरकुस 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />कुछ लोग ईसु से कहीं, “यूहन्ना के चेला तौ बार-बार बर्त रखथैं और प्रार्थना करथैं, और बैसिये फरीसियन के चेला करथै; पर तेरे चेला तौ खाथैं।”<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />ईसु उनसे कही, “का तुम बिहा बारे घरै बरैतियन से जबले दुल्हा उनके संग है, बर्त रखबाये सकथौ? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />लेकिन बौ दिन आगो, जब दुल्हा उनसे दूर लैजाओ जागो, और फिर बे बर्त रखंगे।”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />ईसु उनकै जौ कहानी<note caller="+" style="f"><char style="fr" closed="false">5:36 </char><char style="ft" closed="false">दृस्टान्त</char></note> भी सुनाई, “कोई आदमी एक नया कोट या झगिया मैं पुराने लत्ता को थिगरा ना लगागो, ना तौ नया लत्ता फट जागो और बाको थिगरा पुराने कोट मैं मेल ना खागो। <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />और न कोई नई दाखरस कै पुराने इस्तमाल करे भै मसकन मैं भरथै, ना तौ नई दाखरस मसकन कै फाड़कै पुही जागी, और मसक नास ही जांगे। <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />जाके बदले दाखरस कै नया मसकन मैं भरनो चाहिए। <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />कोई आदमी पुरानी दाखरस पीकै नई दाखरस नाय मांगथै, काहैकि बौ कहथै कि पुरानिए अच्छी है।”<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">साबत के बारे मैं सबाल</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्ती 12:1-8</ref>; <ref loc="MRK 2:23-28">मरकुस 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />ईसु साबत के रोज गेंहूँ के खेतन से होत भइ जात रहै, और ईसु के चेला बाली तोड़-तोड़कै हातन से मिजलकै खात भइ जान डटे पड़े।<note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">व्यवस्थाविवरन 23:25</ref></char></note> <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />कुछ फरीसी पूँछीं, “तुम ऐसो काहे कर्‌रै हौ जो हमरे नियम के हिसाब से साबत के दिन करनो सई ना है?”<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />ईसु उनकै जबाब दई, “का तुम नाय पढ़े हौ, कि जब दाऊद और बाके संग के लोग भूंके रहैं, तौ बौ का करी रहै? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />बौ कैसे करकै परमेस्वर के घर मैं गौ, और परमेस्वर कै दै भइ रोटी उठाएकै खाई, और अपने संग बारेन कै भी खबाई। जबकी जौ नियम के हिसाब से पुजारी कै छोड़ और कोई कै जौ खानो सई ना रहै।”<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:5-9">लैव्यवस्था 24:5-9</ref>; <ref loc="1SA 21:6">1 समूएल 21:6</ref></char></note><verse eid="LUK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5" />और ईसु हल निकारकै उनसे कही, “इंसान को लौड़ा साबत के दिन को प्रभु है।”<verse eid="LUK 6:5" /></para>
  <para style="s">एक आदमी जोके हात मैं फालिस मार गई रहै</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्ती 12:9-14</ref>; <ref loc="MRK 3:1-6">मरकुस 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />एकोर साबत के रोज ईसु सभाघर मैं जाएकै उपदेस दई; और हुँआँ एक आदमी रहै, जोके दहने हात मैं फालिस मार गई रहै। <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />कुछ यहूदि नियम के सिक्छक और फरीसी ईसु के ऊपर गलत इल्जाम लगान के ताहीं मौका ढूँड़त रहैं, इसलै बे ईसु कै ध्यान से देखीं कि का बौ साबत के रोज अच्छो करैगो। <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />लेकिन ईसु उनकी मन की बात जानत रहै; इसलै ईसु जोके हाथ मैं फालिस मारी रहै, बौ आदमी से कही, “उठ, ठाड़कै अग्गु आ।” बौ आदमी उठकै हुँआँ ठाड़गौ। <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />ईसु उनसे कही, “मैं तुमसे जौ पूछथौं: कि हमरे नियम के हिसाब से साबत के रोज का करनो चाहिए? भलो करन ताहीं या बुरो करन ताहीं? कोई की ज्यान बचान ताहीं या खतम करन के ताहीं?” <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />और ईसु सब घाँईं बे सबन कै देखी; फिर बौ आदमी से कही जोके हात मैं फालिस मार गई रहै, “अपनो हात बड़ा।” बौ एसोई करी, और बाको हात फिर से ठीक हुई गौ।<verse eid="LUK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11" />बे बड़ा गुस्सा मैं आए गै और आपस मैं बतकान लागे कि हम ईसु के संग का कर सकथैं।<verse eid="LUK 6:11" /></para>
  <para style="s">ईसु बारह प्रेरितन कै चुनथै</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्ती 10:1-4</ref>; <ref loc="MRK 3:13-19">मरकुस 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />बौ समय ईसु प्रार्थना करन के ताहीं एक पहाड़ी मैं चढ़गौ, और पूरी रात परमेस्वर से प्रार्थना मैं बिताई। <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />जब दिन भौ, तौ ईसु अपने चेलन कै बुलाई और उनमैं से बारह कै चुनी, जिनकै ईसु प्रेरित को नाओं दई: <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />और बे जे रहैं, सिमौन जोको नाओं बौ पतरस रखी; और बाको भईय्या अन्द्रियास, याकूब, यूहन्ना, फिलिप्पुस, और बरतुल्मै, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />और मत्ती, और थोमा, हलफई को लौड़ा याकूब, और सिमौन जो जेलोतेस कहो जात रहै, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />और याकूब को लौड़ा यहूदा, और यहूदा इस्करियोती, जो ईसु कै पकड़वान बारो बनो।<verse eid="LUK 6:16" /></para>
  <para style="s">ईसु लोगन कै सिखाथै और अच्छो करथै</para>
  <para style="r">(<ref loc="MAT 4:23-25">मत्ती 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />जब ईसु प्रेरितन के संग पहाड़ी से उतरकै नीचे बराबर बारी जघा मैं आओ, हुँआँ बाके चेलन की बड़ी भीड़, और पूरे यहूदिया, और यरूसलेम, और सूर और सैदा के किनारे के लोगन की बड़ा बड़ी भीड़ जुरानी रहै; <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />बे ईसु कै सुनन कै और अपनी बिमारिन से अच्छो होन के ताहीं बाके झोने आए रहैं, जो लोग प्रेत आत्मा से परेसान रहैं, बेऊँ आए और ठीक हुईगै। <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />सब जनी ईसु कै छूनो चाहत रहैं, काहैकि ईसु मैं से सामर्थ्य निकरकै सबकै अच्छो करत रहै।<verse eid="LUK 6:19" /></para>
  <para style="s">सुख और दुख</para>
  <para style="r">(<ref loc="MAT 5:1-12">मत्ती 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />फिर ईसु अपने चेलन के घाँईं देखी और कही,</para>
  <para style="q1" vid="LUK 6:20">खुसनसीब हौ तुम, जो दीन हौ,</para>
  <para style="q2" vid="LUK 6:20">काहैकि परमेस्वर को राज्य तुम्हारो है!<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />खुसनसीब हौ तुम, जो हबै भूंके हौ;</para>
  <para style="q2" vid="LUK 6:21">तुम छके जाबैगे!</para>
  <para style="q1" vid="LUK 6:21">खुसनसीब हौ तुम, जो अभै रोय रै हौ;</para>
  <para style="q2" vid="LUK 6:21">तुम हँसैगे!<verse eid="LUK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22" />खुसनसीब हौ तुम, जब इंसान के लौड़ा के बजे से लोग तुमसे बैर रखंगे, और तुमकै निकार देंगे, और तुमरी बुराई करंगे, और तुमरो नाओं बुरो मानकै काट देंगे।<note caller="+" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 पतरस 4:14</ref></char></note> <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />जब ऐसो होबै, तौ खुस रहियो और खुसी के मारे नाचियो, काहैकि स्वर्ग मैं तुमरे ताहीं एक बड़ो इनाम रखो गौ है। उनके पुरखा भविस्यवक्ता के संग बैसोई करे करत रहैं।<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />कितनो भयानक है तुमरे ऊपर जो सेठ हौ,</para>
  <para style="q2" vid="LUK 6:24">काहैकि तुम अपनी सांति पाए चुके!<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />“हाय तुमरे ऊपर जो अब तुम छके हौ,</para>
  <para style="q2" vid="LUK 6:25">तुम भूंके होगे!”</para>
  <para style="q1" vid="LUK 6:25">“तुमरे ताहीं कितनो भयानक है, जो हबै हँस रै हौ,</para>
  <para style="q2" vid="LUK 6:25">काहैकि तुम रोबैगे!”<verse eid="LUK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26" />“जब सब जनी तुमरे बारे मैं अच्छो बोलथैं, तौ कितनो भयानक होथै; काहैकि उनके पुरखा झूठा भविस्यवक्ता के बारे मैं भौत कछु कहीं।”<verse eid="LUK 6:26" /></para>
  <para style="s">बैरियों से भी प्यार करियो</para>
  <para style="r">(<ref loc="MAT 5:38-48">मत्ती 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />“पर मैं तुम सुनन बारेन से कहथौ, कि अपने बैरी से प्यार करौ; जो तुमसे बैर करैं, उनको भलो करौ,” <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />जो तुमकै बद्‌दुआ देबै, तुम उनकै आसीस दियो; जो तुमरी बेजती करैं, उनके ताहीं प्रार्थना करौ। <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />अगर कोई तुमकै एक गलऊवा मैं चाँटा मारै, तौ बाके घाँईं दुसरो गलऊवा रोक लियो; अगर कोई तुमरो कोट लेथै, तौ बाकै अपनो कुरता पहनन देमैं। <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />जो कोई तुमसे कछु मांगथै, बाकै देमैं; और जो तुमरी चीज छीन लेबै, बाकै दुबारा मत माँगियो। <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />दुसरेन ताहीं बहे करैं, जैसो अपने ताहीं चाहथौ, और तुम्हऊँ उनके संग बैसोई करियो।<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />“अगर तुम खाली बे लोगन से प्यार करथौ, जो तुमसे प्यार-भाव रखथैं, तौ तुमकै दुआ काहे मिलनो चाहिए? काहैकि पापी अपने प्रेम-भाव रखन बारेन से प्यार करथैं।” <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />अगर तुम बे लोगन को भलो करथौ, जो तुमरो भलो करथैं, तौ तुमकै दुआ काहेकै मिलनो चाहिए? काहैकि पापी ऐसोई करथैं! <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />और अगर तुम खाली बे लोगन कै उधार देथौ, जिनसे तुम बापस पान की आसा करथौ, तौ तुमकै दुआ काहे मिलनो चाहिए? पापी भी पापिन कै उधार देथैं, ताकी उतनोई पैसा बापस पामैं! <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />न! अपने बैरी से प्यार करौ और उनको भलो करौ; उधार और बापस लेन की कछु उमीद मत करौ, तौ तुमरे पास एक बड़ो इनाम होगो; और तुम परमप्रधान के बालका माने जागे, काहैकि बौ उनके ताहीं जो धन्यवाद नाय देथैं और बुरेन के ताहीं अच्छो है।<note caller="+" style="x"><char style="xo" closed="false">6:35 </char><char style="xt" closed="false"><ref loc="LEV 25:35-36">लैव्यवस्था 25:35-36</ref>; <ref loc="MAT 5:44-45">मत्ती 5:44-45</ref></char></note> <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />दयालु बनौ जैसो तुमरो दऊवा दयालु है।<verse eid="LUK 6:36" /></para>
  <para style="s">दुसरेन को न्याय</para>
  <para style="r">(<ref loc="MAT 7:1-5">मत्ती 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />“दुसरेन को न्याय मत करौ, और परमेस्वर तुमरो न्याय ना करैगो; दुसरेन की बुराई मत करौ, और परमेस्वर तुमरी बुराई ना करैगो; दुसरेन कै माफ करौ, और परमेस्वर तुमकै माफ करैगो। <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />दुसरेन कै दे करौ, और परमेस्वर तुमकै देगो; सई मैं, तुमकै एक पूरो तरीका मिलैगो, खूब एक मदत, तुमरे हाथ मैं दई जागी, जो तुम पकड़ सकथौ; दुसरेन ताहीं तुमरे जरिये इस्तमाल करो जान बारो तरीका बौ है जो परमेस्वर तुमरे ताहीं इस्तमाल करैगो।”<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />फिर ईसु उनकै एक कहानी<note caller="+" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">मत्ती 15:14</ref>; <ref loc="MAT 23:16">23:16</ref>,<ref loc="MAT 23:24">24</ref></char></note> सुनाई: “एक अंधरा आदमी दूसरे आदमी कै रस्ता ना बताए सकथै; अगर बौ रस्ता बतात भइ अग्गु जागो, तौ दोनों जनी एक खाई मैं गिर जांगे।” <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />कोई भी चेला अपने गुरु से बड़ो नाय होथै; सब चेला जब बे अपनी पूरी तैयारी कर लेंगे, तौ बे अपने गुरु के बराबर हुई जांगे।<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />“तैं अपने भईय्या की आँखी मैं को धब्बा या कूरा काहेकै देखथै, और अपनिए आँखी को लट्ठा तोकै नाय सुजाथै? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />और जब तैं अपनिए आँखी को लट्ठा नाय देखथै, तौ अपने भईय्या से कैसे कह सकथै, ‘कि भईय्या, रुक जा ला तेरी आँखी से धब्बा, कूरा साफ कर देमौं?’ तुम ढोंगी, पहले अपनी आँखी से लट्ठा निकारौ, तौ जो कूरा तेरे भईय्या की आँखी मैं है, खूब अच्छे से देखकै निकार सकथै।”<verse eid="LUK 6:42" /></para>
  <para style="s">एक पेंड़ और बाको फल</para>
  <para style="r">(<ref loc="MAT 7:16-20">मत्ती 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />“अच्छो पेंड़ कहु खराब फल ना देथै, और एक खराब पेंड़ कहु अच्छो फल ना देथै। <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />हर एक पेंड़ अपने फल से जानो जाथै: काहैकि लोग कांटे बारी झाड़ी से अंजीर नाय तोड़थैं, और ना कटबंजर बारी झाड़िन से अंगूर तोड़थैं।<note caller="+" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती 12:33</ref></char></note> <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />एक अच्छो आदमी अपने दिल मैं अच्छी चीज के खजाना के भंडार मैं से अच्छी बात निकारथै; और एक बुरो आदमी अपने बुरे मन के खजाना के भंडार मैं से बुरी बात निकारथै; काहैकि जो मन मैं भरो है बहे बाके मोहों मैं आथै।”<note caller="+" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्ती 12:34</ref> </char></note><verse eid="LUK 6:45" /></para>
  <para style="s">घर बनान बारे दुई आदमी</para>
  <para style="r">(<ref loc="MAT 7:24-27">मत्ती 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />“जब तुम मेरो कहनो नाय मानथौ, तौ काहेकै मोसे ‘हे प्रभु,’ हे प्रभु कहथौ? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />जो कोई मेरे झोने आथै, और मेरी बात सुनकै मानथै, मैं तुमकै बताथौं कि बौ कौनके हानी है। <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />बौ आदमी बाके हानी है, जो घर बनान पोती गहरी मट्टी खोदकै चट्टान मैं बुनियाद डारी, और जब बाढ़ आई तौ धार बाके घर मैं टकरानी, लेकिन बाकै हिलाय न पाई; काहैकि बौ अच्छी तरह से पक्को बनो गौ रहै। <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />लेकिन जो कोई भी मेरी बातन कै सुनकै मेरी बात नाय मानथै, बौ आदमी बाके हानी है, जो अपनो घर जमीन मैं बिन चट्टान के ऊपर बनाई; जब बाढ़ की धार बाके घर मैं टक्कर मारी तौ बौ तुरंत गिर पड़ो, और बौ गिरकै सत्यानास हुई गौ!” का अपने फल से जानो जाथै: काहैकि लोग कांटे बारी झाड़ी से अंजीर नाय तोड़थैं, और ना कटबंजर बारी झाड़िन से दाख तोड़थैं।<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">ईसु एक रोमन अधिकारी के नौकर कै अच्छो करी</para>
  <para style="r">(<ref loc="MAT 8:5-13">मत्ती 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />जब ईसु लोगन कै अपनी पूरी बात सुनाए चुको, तौ कफरनहूम मैं गौ। <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />और एक रोमन अधिकारी को सेवक जो बाको बड़ा प्रिय रहै, बिमारी से मरन मैं रहै। <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />जब अधिकारी ईसु के बारे मैं सुनी, तौ बौ कुछ बचे भै यहूदि बड़े-बूढ़ेन कै ईसु के झोने पनारी, कि बे जाएकै बाके सेवक कै ठीक करन के ताहीं ईसु कै आन के ताहीं पूँछै। <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />बे ईसु के झोने आयकै बासे नहोरे करकै कहेन लगे, “बौ अधिकारी जौ काबिल है, कि तैं बाकी मदत करै। <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />बौ हमरे देस के लोगन से प्यार करथै, और बौ खुद हमरे ताहीं एक सभाघर बनाई है।”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />इसलै ईसु उनके संग गौ, ईसु बौ घर से जाधे दूर नाय रहै, तौ अधिकारी अपने दोस्तन कै ईसु झोने जौ कहकै भेजी, “कि प्रभु तैं परेसान मत होबै, काहैकि मैं जौ काबिल ना हौं, कि तैं मेरे छत के तरे आबै, <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />जहे बजे से मैं खुदकै जौ काबिल ना समझो, कि तेरे झोने आमौं, तैं खाली बस कहदे, तौ मेरो सेवक ठीक हुई जागो। <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />महुँ बड़े अधिकारी के नीचे काम करथौं; और सिपईय्या मेरे अधिकार मैं काम करथैं, और जब मैं एक से कहथौं, ‘जा,’ तौ बौ जाथै, और दुसरे से कहथौं कि ‘आ,’ तौ आथै; और जब मैं अपने सेवक से कहथौं कि ‘जौ कर,’ तौ बौ करथै।”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />जौ सुनकै ईसु चौहोंक गौ, और ईसु मोहों घुमाएकै बौ भीड़ से जो बाके पच्छू आत रहै उनसे कही, “मैं तुमसे कहथौं, मोकै जाके हानी को बिस्वास कहु नाय मिलो, इस्राएल मैं भी ना पाओ!”<verse eid="LUK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10" />और अधिकारी के भेजे भै आदमी घरै लौटकै गै, और देखीं कि सेवक अच्छो है।<verse eid="LUK 7:10" /></para>
  <para style="s">ईसु बिधवा के लौड़ा कै जिंदो करी</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />जाके तुरंत बाद ईसु अपने चेलन और एक बड़ी भीड़ के संग नाईन नाओं के सहर मैं गौ। <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />जैसी बौ सहर के फाटक के झोने पहुँचो, तौ देखी, कि लोग एक मुर्दा कै बाहर लै जाए रै हैं; मरो भौ आदमी अपनी अईय्या को इकलौतो लौड़ा रहै, और बौ बिधवा रहै, और सहर की एक बड़ी भीड़ बाके संग रहै। <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />जब प्रभु ईसु बौ बिधवा अईय्या कै रोत भइ देखी, तौ बाको दिल दया से भरगौ, और ईसु बासे कही, “मत रोबै।” <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />फिर ईसु झोने जाएकै ताबूत कै छुइ, और बाकै लै जान बारे लोग रुक गै, ईसु कही, “ज्वान आदमी! मैं तोसे कहथौं, उठ!” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />बौ मरो भौ आदमी उठकै बैठगौ, और बोलन लग्गौ, ईसु बाकै बाकी अईय्या कै बापस सौंप दई।<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />जौ सब देखकै बे सब जनी बड़ा डराय गै; बे परमेस्वर की बड़ाँईं करकै कहेन लागे, “हमरे बीच मैं एक बड़ो भविस्यवक्ता दिखाई दई है!” और बे कहीं; “परमेस्वर अपने लोगन कै बचान के ताहीं आओ है!”<verse eid="LUK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17" />ईसु के बारे मैं जे सब बात पूरे यहूदिया देस और आस-पास के इलाका मैं फैल गई।<verse eid="LUK 7:17" /></para>
  <para style="s">ईसु और बपतिस्मा देन बारो यूहन्ना</para>
  <para style="r">(<ref loc="MAT 11:2-19">मत्ती 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />जब यूहन्ना के चेला यूहन्ना कै जे सब बातन के बारे मैं बताईं, तौ बौ अपने चेलन मैं से दुई कै बुलाई <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />और उनकै प्रभु झोने जौ पूँछन ताहीं भेजी कि, “का आनबारो तहीं है, या हमकै कोई और दुसरे से उमीद करनो चाहिए?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />जब बे ईसु के झोने आए, तौ बे कहीं, “यूहन्ना बपतिस्मा देन बारो हमकै तेरे झोने जौ पूँछन ताहीं भेजी है, कि का आनबारो तहीं है, या हमकै कोई और से उमीद रखनो चाहिए?”<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />बहे समय ईसु भौत जनी कै बिमारी और प्रेत आत्मा से बचाई; और भौत से अंधरन की आँखी अच्छी करी। <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />ईसु यूहन्ना के भेजे भैन कै जबाब दई, “जो कछु तुम देखे और सुने हौ, जाएकै यूहन्ना से कह दियौ; कि अंधरा देखरै हैं, लंगड़ा चल-फिर रै हैं, कोहढ़ी सुद्ध करे जाए रै हैं, बहरा सुनरै हैं, और मरे भै जी उठ रै हैं, और सुसमाचार प्रचार गरीबन कै सुनाओ जाथै।<note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">यसायाह 35:5-6</ref>; <ref loc="ISA 61:1">यसायाह 61:1</ref></char></note> <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />बे कितने खुस हैं जिनकै मेरे ऊपर सक नाय है!”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />यूहन्ना के भेजे भै लोगन के जान के बाद, ईसु यूहन्ना के बारे मैं कहनो सुरू करी: “जब तुम रेगिस्तान मैं यूहन्ना के ताहीं निकरे, तौ तुमकै का देखन की उमीद रहै? तेज ब्यार से हालत भै सरकंडा कै? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />तौ तुम का देखन गै रहो? फैंसी लत्ता पहने भै महान आदमी कै? जो लोग ऐसे लत्ता पहनथैं, और ऐसो आराम से रहथैं, बे महल मैं रहथैं। <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />बताबौ, तौ फिर तुम का देखन गै रहौ? एक भविस्यवक्ता कै? हाँ सई मैं, लेकिन तुम एक भविस्यवक्ता कि तुलना मैं भौत कछु देखे। <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />यूहन्ना बहे है, जोके बारे मैं सास्त्र मैं लिखो है: जो परमेस्वर कही,</para>
  <para style="q1" vid="LUK 7:27">‘देख, मैं अपने खबरेया कै तेरे अग्गु-अग्गु भेजथौं, जो तेरे ताहीं रहा सीधी करैगो।’”<note caller="+" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकी 3:1</ref>; <ref loc="ISA 40:3">यसायाह 40:3</ref></char></note><verse eid="LUK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28" />ईसु उनसे कही, मैं तुमकै बताथौं, “यूहन्ना जिंदेन मैं से सबसे बड़ो है, बासे बड़ो कोई ना है, लेकिन जो परमेस्वर के राज्य मैं सबसे छोटो है, बौ यूहन्ना से भी बड़ो है।”<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />सब जनी ईसु कै सुनीं, और लगान<note caller="+" style="f"><char style="fr" closed="false">7:29 </char><char style="ft" closed="false">चुंगी</char></note> लेन बारे यूहन्ना से बपतिस्मा लैकै परमेस्वर कै धर्मी मान लईं। <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />लेकिन फरीसियैं और नियम के सिक्छक अपने ताहीं परमेस्वर के उद्देस्य कै नाय अपनाईं और यूहन्ना से बपतिस्मा लेन से मना कर दईं।<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />ईसु कही, “अब मैं आज कल के लोगन की तुलना कौन से कर सकथौं? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />बे बजार मैं बैठे बालकन के हानी हैं, जो एक दुसरेन से चिल्लाए कै कहथैं, ‘कि हम तुमरे ताहीं बिहा मैं बुसली बजाओ, और तुम ना नाचे, हम रोटी के गीत गाये, लेकिन तुम ना रोए!’ <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />यूहन्ना बपतिस्मा देन बारो आओ, और बौ बर्त रखी और दाखरस भी ना पिये, और तुम कहथौ, ‘बाके भीतर प्रेत आत्मा है!’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />इंसान को लौड़ा आओ, और बौ खाई भी लई और पीयो लई, और तुम कहथौ, ‘जौ आदमी कै देखौ! पेटू और पियक्कड़ आदमी, लगान लेन बारेन को और पापिन को दोस्त।’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />हालाकि, परमेस्वर की अकल कै सब जनी के जरिये सच्ची और सई ठहराओ जाथैं, जाकै जो अपनाथैं।”<verse eid="LUK 7:35" /></para>
  <para style="s">सिमौन फरीसी के घरै ईसु</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />एक फरीसी ईसु कै अपने घरै खानु खान पूँछी; और ईसु बाके घरै गौ और खानु खान कै बैठगौ। <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />बौ सहर मैं एक बईय्यर रहै जो पाप भरी जिंदगी जीत रहै, बौ सुनी कि ईसु फरीसी के घरै खानु खाए रौ है, इसलै संगमरमर की सीसी मैं भरकै इत्तर<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">महाकनबारी</char></note> लै आई। <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />और बौ ईसु पच्छू ठाड़कै, रोत भइ, ईसु के पाँव कै आँसु से भिजाये दई, और अपनी मुड़िया के बारन से पछोनन लग्गई और बाके पाँव बार-बार चूमकै उनमैं इत्तर डारकै अभिसेक करी। <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />जब फरीसी जौ सब देखी, तौ बौ अपने मन मैं सोचन लगो, “अगर जौ आदमी सच्ची मैं एक भविस्यवक्ता होतो तौ जान जातो, कि जो बईय्यर जाकै छुइ रइ है, जौ कैसी है? काहैकि जौ तौ पाप भरी जिंदगी जीथै!”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />ईसु बाके मन कि बात सुनकै बासे कही, “सिमौन, तोकै मोसे कछु कहने है। हाँ, गुरुजी, ईसु कही, बता मोकै।”<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />“दुई आदमी रहैं, दोनों को बकाया मुन्सी झोने रहै, एक जनी मुन्सी कै पाँच सौ चाँदी को सिक्का देतो, और दुसरो पचास चाँदी के सिक्का देतो। <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />जबकी दोनों के पास बापस करन ताहीं कछु ना रहै, इसलै मुन्सी दोनों जनी को कर्जा माफ कर दई। अब बता कौन सो बारो बासे जाधे प्यार करैगो?”<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />सिमौन जबाब दई, “मोकै लगथै,” जोको बौ जाधे कर्जा, माफ ईसु सिमौन से कही, “तैं सई न्याय करो है।” <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />फिर बौ बईय्यर के घाँईं मुड़कै सिमौन से कही, “का तैं जौ बईय्यर कै देखरौ है? मैं तेरे घरै आओ, लेकिन तैं मेरे पाँव धोन के ताहीं पानी नाय दौ, पर जौ मेरे पाँव आँसु से भिजाये कै, अपने बारन से पछोनी।”<note caller="+" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="GEN 18:4">उत्पत्ति 18:4</ref></char></note> <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />तैं मोकै ना चूमो, पर जब से मैं आओ हौं, तौ से जौ मेरे पाँव कै चूम रइ है। <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />तैं तौ मेरे अभिसेक के ताहीं जैतून तेल तक नाय दौ, बल्किन बौ मेरे पाँव कै इत्तर से ढोंक दई। <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />“मैं तोसे कहथौं; कि जाके पाप जो भौत रहैं, माफ ही गै है, काहैकि जौ भौत प्यार दिखाई है; लेकिन जिनकै माफी मिल गई है बौ थोड़ी सो प्यार दिखाथै।”<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />फिर ईसु बौ बईय्यर से कही, “तेरे पाप माफ ही गै।”<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />जो लोग मेज मैं बैठे रहैं, बे खुद से कहेन लगे, “जौ कौन है, जो पापन कै भी माफी देथै?”<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />लेकिन ईसु बौ बईय्यर से कही, “तेरो बिस्वास तोकै बचाई है; तैं सांति से चली जा।”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">ईसु के संग की बईंय्यरैं</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />जाके बाद ईसु सहर-सहर और गाँव-गाँव परमेस्वर के राज्य को सुसमाचार प्रचार करत भइ, फिरन लगो, और बारह चेला बाके संग रहैं, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />और थोड़ी बईंय्यरैं रहैं जो प्रेत आत्मा से और बिमारिन से अच्छी भइ रहैं, और बे जे रहैं, मरियम जो मगदलीनी कही जात रहै, जोके भीतर से सात प्रेत आत्मा निकरी रहैं, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />योअन्ना, जोको आदमी खोजा हेरोद के दरबार मैं एक अधिकारी रहै; और सुसन्नाह, और भौत सी बईंय्यरैं, जो ईसु और बाके प्रेरितन कि मदत करन के ताहीं अपने खुद की सम्पत्ति से उनकी सेवा करत रहैं।<verse eid="LUK 8:3" /></para>
  <para style="s">बीज बोन बारे की कहानी</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्ती 13:1-9</ref>; <ref loc="MRK 4:1-9">मरकुस 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />लोग एक के बाद एक सहर से ईसु के झोने आत जामैं; और जब एक बड़ी भीड़ जुराए गई, तौ ईसु जौ कहानी<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">दृस्टान्त</char></note> बताई:<verse eid="LUK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5" />“एक बार कि बात रहै, एक आदमी रहै, जो कि बौ बीज बोन के ताहीं निकरो रहै, जब बौ खेत मैं बीज बोत रहै, बामै से कुछ रहामैं गिरो, जो पाँव से कुचल गौ, और बाकै आसमान के पक्छी चुग लईं। <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />बामै से कुछ चट्टान बारी जमीन मैं गिरे, और जब पौधा जमयाए, तौ बे सूख गै काहैकि मट्टी मैं नमी ना रहै। <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />कुछ बीज कांटे की झाड़िन के बीच मैं गिरे, और कांटे की झाड़ी पौधन के संग-संग बढ़कै उनकै दबाय दईं।<verse eid="LUK 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 8:8" />और कुछ बीज अच्छी जमीन मैं गिरे, और जमकै सौ गुना दाने लाईं।” जौ सब कहकै ईसु जोड़न से कही, “जोके पास सुनन ताहीं कान होमैं बौ सुन लेबै!”<verse eid="LUK 8:8" /></para>
  <para style="s">कहानी<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">दृस्टान्त</char></note> को मतलब</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्ती 13:10-17</ref>; <ref loc="MRK 4:10-12">मरकुस 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />ईसु के चेला ईसु से पूँछीं, “जौ कहानी को मतलब का है?” <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />ईसु जबाब दई, “तुमकै परमेस्वर के राज्य के रहस्य की समझ दई गई है, लेकिन दुसरेन कै कहानी के जरिये सुनाओ जाथै, इसलै कि बे दिखात भौ भी ना देखैं, और सुनैं लेकिन समझ मैं ना आबै।”<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="MAT 4:11">मत्ती 4:11</ref>; <ref loc="ISA 6:9-10">यसायाह 6:9-10</ref></char></note><verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />“जौ कहानी को मतलब है: बीज परमेस्वर को बचन है।” <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />रहा के किनारे के बे हैं, जो बचन सुनीं; फिर सैतान आयकै उनके मन मैं से बचन उठाए लै जाथै, कि कहूँ ऐसो ना होबै कि बे बिस्वास करकै बचाए जामैं। <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />चट्टान मैं के बीज बे हैं, कि जब बे सुनथैं, तौ खुसी से बचन कै अपनाथैं, पर जड़ ना पकड़न से बे थोड़ी देर ले बिस्वास रखथैं, जब परिक्छा को समय आथैं, तौ बे बहक जाथैं। <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />जो बीज कांटे की झाड़ी मैं गिरो, जे बे हैं, जो सुनथैं, पर अग्गु चलकै चिंता और जायदाद और रोज मर्‌रा की जिंदगी के सुख-दुख मैं फस जाथैं, और उनको फल कहु नाय पकथै। <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />अच्छी जमीन मैं के गिरे भै बे बीज हैं, जो कि बचन सुनकै अच्छे मन मैं समारे रखाथैं, और बे तौले बने रहथैं जबले कि बे फल ना लामैं।<verse eid="LUK 8:15" /></para>
  <para style="s">दिया की कहानी</para>
  <para style="r">(<ref loc="MRK 4:21-25">मरकुस 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />“कोई भी दिया जलायकै, कटोरा तरे या खटिया के तरे नाय रखथै, जाके बदले, दिया कै डीट मैं रखथैं, ताकी लोग भीतर आन पोती उजितो पामैं।”<verse eid="LUK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17" />“जो कछु लुको भौ है, बाकै बाहर खुले मैं लाओ जागो, और जो कछु है लुको बाकै ढूँड़कै उजिते मैं लाओ जागो।<note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">मत्ती 10:26</ref>; <ref loc="LUK 12:2">लूका 12:2</ref></char></note><verse eid="LUK 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18" />तुम चौकन्ने रहाबौ, न तौ तुम कैसे सुनैगे; काहैकि जोके पास थोड़ी भौत है, उनकै और जाधे दौ जागो, और जोके पास नाय है, बासे बहो लै लौ जागो, जोकै बौ अपनो समझथै।”<verse eid="LUK 8:18" /></para>
  <para style="s">ईसु की अईय्या और भईय्या</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती 12:46-50</ref>; <ref loc="MRK 3:31-35">मरकुस 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />ईसु की अईय्या और भईय्या बाके झोने आए, पर भीड़ कि बजे से बासे भेंटा ना कर पाईं। <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />कोई ईसु से कही, “तेरी अईय्या और भईय्या बाहर ठाड़े हैं और तोकै देखनो चाहथैं।”<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />ईसु उन सबन से कही, “मेरी अईय्या और भईय्या बे हैं जो परमेस्वर को बचन सुनथैं और मानथैं।”<verse eid="LUK 8:21" /></para>
  <para style="s">ईसु एक आँधी कै सांत करी</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्ती 8:23-27</ref>; <ref loc="MRK 4:35-41">मरकुस 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />एक रोज ईसु अपने चेलन संग एक नईंयाँ मैं चढ़ो, और ईसु उनसे कही, “आबौ, आपन झील के बौ पाँजर चलैं।” और बे नईंयाँ खोल दई। <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />जब नईंयाँ चलत रहै, तौ ईसु सोए गौ: अनकाचीति झील मैं एक तेज आँधी चली और नईंयाँ पानी से भरन लगी, जोसे बे सब बड़ा खतरा मैं पड़ गै।<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />चेला ईसु के झोने गै और बाकै जगाएकै कहीं, “गुरुजी, गुरुजी! हम मरन बारे हैं!” ईसु उठकै आँधी और पानी की लहरन कै आग्या दई; और बे सांत ही गै, और सब घाँईं एक दम सांत वातावरड़ बन गौ।<verse eid="LUK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 8:25" />फिर ईसु चेलन से कही, “तुमरो बिस्वास कहाँ है?” पर बे हैरान और डराने भै रहैं, और एक दुसरे से आपस मैं बतकान लगे, “जौ आदमी कौन है? बौ आँधी और पानी कै हुकम देथै, और बे बाकी मानतौ हैं!”<verse eid="LUK 8:25" /></para>
  <para style="s">ईसु एक आदमी के भीतर से भूतन कै निकारथै</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्ती 8:28-34</ref>; <ref loc="MRK 5:1-20">मरकुस 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />ईसु और बाके चेला गिरासेनियों के देस मैं पुगे, जो कि गलील झील के दुसरे पाँजर रहै। <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />जब बे डींड़े मैं उतरे, तौ बौ सहर को आदमी ईसु कै मिलो, जोके अंदर प्रेत आत्मा रहैं। और बड़ा दिन से बिन कोट, लत्ता पहने रहत रहै और घरौ ना रहत रहै, बौ कबर मैं रहे करत रहै। <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />जब बौ ईसु कै देखी, तौ बौ जोड़न से चिल्लाई, और अपने आपकै ईसु के टाँगन मैं गिरकै जोड़न से कही, “ईसु, परमप्रधान परमेस्वर को लौड़ा! तैं मोसे का चाहथै? मैं तोसे नहोरे करथौं, मोकै सजा मत दे!” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />बौ ऐसो इसलै कहत रहै कि ईसु प्रेत आत्मा कै बाके अंदर से निकरन को आग्या देत रहै, बौ आदमी कै प्रेत आत्मा बार-बार पकड़ लेत रहै, बाके हात और टाँग साँकर से भाँद देत रहैं, तहुँओं बौ तोड़ डारत रहै, और भूत बाकै रेगिस्तान मैं भजाए करतो।<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />ईसु बासे पूँछी, “तेरो नाओं का है?” प्रेत आत्मा जबाब दईं, “हमरो नाओं, पलटन है,” काहैकि बाके अंदर गजब भूत रहैं। <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />भूत ईसु से नहोरे करीं कि, “हमैं अधोलोक मैं मत भेजै।”<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />झोनेई सोरन को एक बड़ो झुंड रहै, जो एक पहाड़ी मैं चुगत रहैं, इसलै भूत ईसु से नहोरे करीं कि हमकै सोरन के भीतर जान दे, और ईसु उनकै जान दई। <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />प्रेत आत्मा बौ आदमी से निकरकै सोरन के भीतर समाए गै और बौ झुंड चट्टान से झिपटकै नीचे झील मैं जाए गिरे और डूब गै।<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />जो लोग सोरन की देखाभारी करन बारे रहैं, बे जौ सब देखकै कही जौ का भौ, और भाज पड़े और सहर मैं, और गाँव मैं जाएकै बाके बारे मैं खबर फैलाय दईं। <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />और लोग बाकै देखन ताहीं निकरे, जो कछु भौ रहै, और जब बे ईसु के झोने आए, तौ आयकै जो आदमी के अंदर से प्रेत आत्मा निकरी रहैं, बाकै ईसु के पाँव झोने लत्ता पहने और चुप-चाप बैठो भौ देखकै, सब बड़ा डराय गै। <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />और देखन बारे उनकै बताईं, कि बौ आदमी प्रेत आत्मा से सताव भौ कैसे अच्छो हुई गौ। <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />तौ गिरासेनियों के आस-पास के सब लोग आपस मैं एक दुसरे से पूँछीं और ईसु से दूर जान ताहीं कहीं, काहैकि बे बड़ा डराय गै रहैं। फिर ईसु नईंयाँ मैं चढ़कै चले गौ। <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />जो आदमी के भीतर से प्रेत आत्मा निकरो रहै बौ ईसु से नहोरे करन लगो कि, “मोकै अपने संग रहन दे।” लेकिन ईसु बासे जौ कहकै बिदा करी, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“अपने घर मैं लौट जा और लोगन के बीच प्रचार, कि परमेस्वर तेरे ताहीं का करी है।” बौ आदमी सहर से छिरकै, सबन कै बताई कि ईसु बाके ताहीं का करी है।<verse eid="LUK 8:39" /></para>
  <para style="s">याईर की लौड़िया और ईसु कै छून बारी बईय्यर</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्ती 9:18-26</ref>; <ref loc="MRK 5:21-43">मरकुस 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />जब ईसु झील के दूसरे घाँईं लौटो, तौ लोग बाको स्वागत करीं, काहैकि बे सब बाकै असियात रहैं। <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />फिर याईर नाओं को एक आदमी आओ, बौ सभाघर को अधिकारी रहै, बौ ईसु के पाँव मैं गिरकै बासे नहोरे करन लगो कि, मेरे घरै चल, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />काहैकि बाकी बारह साल की एक इकलौती लौड़िया रहै, और बौ मरन मैं रहै। ईसु बाके संग जब जात रहै, तौ लोग ईसु के ऊपर गिरे जात रहैं, इत्ती भीड़ रहै। <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />बहे भीड़ मैं एक बईय्यर रहै जोकै बारह साल से खून बहन कि बिमारी रहै, पूरी जिंदगी की जमा पूँजी इलाज मैं खर्च कर चुकी रहै तहुँओं बौ अच्छी होन मैं कामयाब ना भइ। <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />बौ ईसु के पच्छू से आई और बाके कोट के लत्ता के छोर के कुंछ कै छुइ लई, और तुरंत बाको खून बहनो बंद ही गौ। <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />ईसु पूँछी, “मोकै कौन छुओ?” सब जनी मना करीं, फिर पतरस कही, “गुरुजी, लोग सब घाँईं से चढ़े जाए रै हैं और तेरे ऊपर गिरे जाए रै हैं।”<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />लेकिन ईसु कही, “कोई मोकै छुओ है, काहैकि मैं जानगौ रहौं कि मेरे मैं से सामर्थ्य निकरी है।” <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />बईय्यर देखी कि ईसु कै पता चल गौ है, तौ बौ काँपत भइ आई, और ईसु के पाँव मैं गिरकै सब जनी के सामने बताई, कि मैं कौन से बजह से ईसु कै छुओ रहों, और कैसे तुरंत एकै बार मैं ठीक ही गौ। <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />ईसु बासे कही, “मेरी लौड़िया, तेरो बिस्वास तोकै अच्छो करी है, सांति से चली जा।”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />जब ईसु जौ कहतै रहै, कि मुखिया के घर से एक जनी आयकै कही, “तेरी लौड़िया मर गई है, अब गुरुजी कै परेसान मत करै।”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />ईसु जौ सब सुनी और याईर से कही, “मत डराबै; खाली बिस्वास कर, तौ बौ अच्छी ही जागी।”<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />जब बे याईर के घरै पुगे, तौ ईसु पतरस, और यूहन्ना, याकूब, और बच्ची के अईय्या-दऊवा कै छोड़कै और कोई कै अपने संग भीतर ना आन दई। <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />हूँना हर कोई बालका के ताहीं रोत रहैं, ईसु उनसे कही, “मत रोबौ; बौ मरी ना है, बौ खाली सोए रइ है!”<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />बे सब ईसु को मजाक बनान लग्गै, काहैकि बे जानत रहैं कि लौड़िया मर चुकी है। <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />लेकिन ईसु बाको हात पकड़ी, और पुकारी, “उठ बच्ची!” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />बौ लौड़िया की आत्मा लौट आई, और बौ एकै बार कहेन मैं उठ गई, ईसु हुकम दई, कि जाकै कछु खान कै देबौ। <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />बाके अईय्या-दऊवा हैरान रहैं, जौ सब देखकै, लेकिन ईसु उनकै चितौनी दई, कि बे कोई कै भी जौ ना बतामैं कि हिंयाँ का भौ रहै।<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">ईसु बारह चेलन कै बाहर भेजी</para>
  <para style="r">(<ref loc="MAT 10:5-15">मत्ती 10:5-15</ref>; <ref loc="MRK 6:7-13">मरकुस 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />फिर ईसु बारह चेलन कै एक संग बुलाई और उनकै सब प्रेत आत्मा कै और बिमारियन से अच्छो करन की सामर्थ्य और अधिकार दई। <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />और उनकै परमेस्वर के राज्य को प्रचार करन, और बिमारन कै अच्छो करन के ताहीं भेजी, <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />और ईसु उनसे कही, “रहा के ताहीं कछु मत लै जईयो: ना लठिया, ना झोला, ना रोटी, ना रुपईया और ना अगरे कुरता। <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />जहाँ तुमरो आदर करो जाथै, तुम बहे घर मैं रहियो, जबले तुम बौ सहर कै नाय छोड़कै जाबौ; <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />जहाँ लोग तुमरो आदर नाय करथैं, बौ सहर कै छोड़ दियो और अपने पाँव के धूदर कै उनके लै चितौनी समझकै झार दियो, कि उनके ऊपर गभाई होबै।”<verse eid="LUK 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6" />और ईसु के चेला निकरकै गाँव-गाँव घूमकै हर जघा सुसमाचार सुनाईं, और लोगन कै अच्छो करीं।<verse eid="LUK 9:6" /></para>
  <para style="s">हेरोद घबराएगौ</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्ती 14:1-12</ref>; <ref loc="MRK 6:14-29">मरकुस 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />जब गलील को राजा हेरोद जौ सब सुनकै घबराएगौ, काहैकि कुछ लोग कहत रहैं कि यूहन्ना बपतिस्मा देन बारो मरे भै मैं से जी उठो है। <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />और कितने ऐसे कहत रहैं, कि एलिय्याह दिखाई दई है: और कोई कहत रहैं, कि पुराने भविस्यवक्ता मैं से कोई जी उठो है। <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />हेरोद कही, “मैं तौ यूहन्ना कि मूड़ कटवाए दौ रहौं; लेकिन जौ आदमी कौन है जोके बारे मैं जो बात सुनों हौं?” और बौ ईसु कै देखन कि इच्छा करी।<verse eid="LUK 9:9" /></para>
  <para style="s">ईसु पाँच हजार लोगन कै खबाई</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="JHN 6:1-14">यूहन्ना 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />फिर प्रेरितैं लौटकै जो कछु बे करी रहैं, बौ सब कछु ईसु कै बताईं, और ईसु उनके अपने संग बैतसैदा नाओं के एक सहर मैं लैकै गौ। <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />जब भीड़ जाके बारे मैं सुनीं, तौ बे बाके पच्छू ही लई, और ईसु उनसे परमेस्वर के राज्य की बात करन लगो, और जिनकै चंगाई की जरूरत रहैं, उनकै अच्छो करी।<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />जब दिन मुद चुको, तौ बारह चेला ईसु के झोने आयकै कहीं, “भीड़ कै अब भेज दे ताकी बे गाँव और बस्तियन मैं जाएकै अपने ताहीं रहन कि जघा, और खानु को जुगाड़ कर सकैं, बौ इसलै कि हम हिंयाँ सुनसान जघा मैं हैं।”<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />लेकिन ईसु उनसे कही, “तुम खुद उनकै कछु खान ताहीं देबौ।” बे जबाब दईं, “हमरे पास पाँच रोटी और दुई मच्छी हैं। का तैं चाहथै कि हम जौ पूरी भीड़ के ताहीं खानु मोल लामैं?”<verse eid="LUK 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 9:14" />हुँआँ लमसम पाँच हजार आदमी रहैं। ईसु अपने चेलन से कही, “उनकै पचास-पचास करकै समूह मैं बैठारौ।”<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />चेला ऐसोई करीं, और सबन कै बैठार दईं, बाके बाद, <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />ईसु बे पाँच रोटी और दुई मच्छी लई, और स्वर्ग घाँईं देखकै परमेस्वर से आसीस माँग कै धन्यवाद करी, और रोटी तोड़-तोड़कै चेलन कै देत गौ ताकी बे लोगन कै बाँटें। <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />और बे सब खाएकै पेट भर लईं, और चेला बची भइ बारह छपरिया उठाए लईं।<note caller="+" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="2KI 4:44">2 राजा 4:44</ref></char></note><verse eid="LUK 9:17" /></para>
  <para style="s">ईसु कै पतरस मसीह मानी</para>
  <para style="r">(<ref loc="MAT 16:13-19">मत्ती 16:13-19</ref>; <ref loc="MRK 8:27-29">मरकुस 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />एक दिन जब ईसु अकेले मैं प्रार्थना करत रहै, चेला बाके झोने आए। तौ ईसु उनसे पूँछी, “लोग मोसे का कहथैं?”<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />बे जबाब दईं, “कुछ लोग तोसे यूहन्ना बपतिस्मा देन बारो कहथैं, और कोई-कोई एलिय्याह, और कोई जौ कहथै कि पुराने भविस्यवक्ता मैं से कोई जिंदो ही गौ है।”<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />ईसु उनसे पूँछी, “पर तुम मोसे का कहथौ?” पतरस जबाब दई, “तैं परमेस्वर को मसीहा है।”<verse eid="LUK 9:20" /></para>
  <para style="s">ईसु अपनी मौत के बारे मैं बात करी</para>
  <para style="r">(<ref loc="MAT 16:20-28">मत्ती 16:20-28</ref>; <ref loc="MRK 8:30">मरकुस 8:30</ref>; <ref loc="MRK 9:1">9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />फिर ईसु उनकै सक्ति से आग्या दई कि जौ बात तुम कोई से मत कहियो। <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />और ईसु जहो कही, “इंसान के लौड़ा के ताहीं जरूरी है, कि बौ गजब दुख उठाबै, और बड़े-बूढ़े और पुजारी और यहूदि नियम के सिक्छक बाकै ठुकराए कै मार डारंगे, और बौ तिसरे दिन जी उठैगो।”<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />और ईसु बे सबन से कही, “अगर कोई मेरे पच्छू आनो चाहथै, तौ तुमकै अपने आपकै इंकार करियो, और रोजाना अपनो क्रूस उठईयो और मेरे पच्छू हुई लियो।<note caller="+" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ती 10:38</ref>; <ref loc="LUK 14:27">लूका 14:27</ref></char></note> <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />अगर कोई अपनी ज्यान बचानो चाहगो, तौ बौ बाकै खोए देगो, पर जो कोई मेरे ताहीं अपनी जान गबागो, बहे जाकै बचाबैगो।<note caller="+" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती 10:39</ref>; <ref loc="LUK 17:33">लूका 17:33</ref>; <ref loc="JHN 12:25">यूहन्ना 12:25</ref></char></note> <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />अगर तुम पूरी दुनिया कै जीतथौ, और अपनी जान खोए देयौं, या बाको नुकसान उठाबै, तौ बासे का फायदा होगो! <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />जो कोई मोसे और मेरी बातन से सरमागो; इंसान को लौड़ा भी जब अपनी, और अपने दऊवा की, और पवित्र स्वर्गदूतन की महिमा सुंदा आगो, तौ तुमसे सरम आगी। <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />मैं तुमसे सच कहथौं, कि कुछ लोग हिंयाँ पर ऐसे हैं जो तौले नाय मरंगे, जबले कि बे परमेस्वर को राज्य ना देखलेमैं।”<verse eid="LUK 9:27" /></para>
  <para style="s">ईसु को रूपान्तरड़</para>
  <para style="r">(<ref loc="MAT 17:1-8">मत्ती 17:1-8</ref>; <ref loc="MRK 9:2-8">मरकुस 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />इन बातन के लमसम एक सप्ताह बाद पतरस, और यूहन्ना, और याकूब कै ईसु अपने संग लैकै प्रार्थना करन के ताहीं पहाड़ी मैं चले गौ। <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />जब ईसु प्रार्थना करत रहै, तौ बाको चैहरा को रूप बदल गौ, और बाके लत्ता सेतो हुईकै चमकन लगे। <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />अनकाचीति दुई आदमी बासे बतकात रहैं; बे मूसा और एलिय्याह रहैं, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />जे स्वर्गिय महिमा मैं दिखाई दईं और बाके मरन के बारे मैं बतकात रहैं, जो यरूसलेम मैं होन बारो रहै। <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />पतरस और बाके संग के सोत रहैं, जब उनकी नींद खुल गई, तौ बाकी महिमा; और बे दोनों आदमिन कै, जो ईसु के संग ठाड़े रहैं, देखी। <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />जब बे ईसु के झोने से जान लगे, तौ पतरस ईसु से कही, “गुरुजी, हमरो हिंयाँ रहनो भलो है: हम तीन तम्बु बनांगे, एक तेरे ताहीं, एक मूसा के ताहीं, और एक एलिय्याह के ताहीं” बौ सई मैं ना जानत रहै कि बौ का कहरौ है।<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />जब बौ बोलतै रहै, तौ एक बादर दिखाई दई और उनकै अपनी छाया से तोप लई; जब बादर उनके ऊपर आओ, तौ चेला डराएगै। <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />बादर से एक अबाज निकरी, “जौ मेरो लौड़ा है, जोकै मैं चुनो हौं। जाकी सुनौ!”<note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">यसायाह 42:1</ref>; <ref loc="LUK 3:22">लूका 3:22</ref> </char></note><verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />जब अबाज बंद भइ, तौ हुँआँ ईसु अकेलो रहै; चेला जौ सबके बारे मैं चुप रहे और बे बौ समय कोई कै भी कछु ना बताईं, जो बे देखी रहैं।<verse eid="LUK 9:36" /></para>
  <para style="s">ईसु एक लौड़ा कै प्रेत आत्मा से छुड़ाई</para>
  <para style="r">(<ref loc="MAT 17:14-18">मत्ती 17:14-18</ref>; <ref loc="MRK 9:14-27">मरकुस 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />दुसरे दिन जब ईसु और तीन चेला पहाड़ से नीचे उतरे, तौ एक बड़ी भीड़ ईसु से मिली। <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />एक आदमी भीड़ मैं से चिल्लाए कै कही, “गुरुजी! मैं तोसे बिनती करथौं, मेरे लौड़ा कै देख। जौ मेरो इकलौतो लौड़ा है। <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />एक आत्मा बाकै अनकाचीति से चिल्लाए कै पकड़ लेथै, और बाकै एक फिट मैं फेंक देत रहै, और ऐसो ऐंठात रहैं कि मोहों मैं से झाग निकर जात रहै; और बाकै कुचलकै बड़ा मुस्किल से छोड़थै। <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />और मैं तेरे चेलन से नहोरे करो, कि जाकै निकारैं; पर बे ना निकार पाईं।”<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />ईसु जबाब दई, “तुम लोग कितने अविस्वासी और गलत हौ! मैं कबले तुमरे संग रहांगो, और कबले तुमरी सहमंगो?” फिर बौ आदमी से कही, “अपने लौड़ा कै हिंयाँ लैया।”<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />बौ बच्चा आतै रहै कि इत्ते मैं प्रेत आत्मा बाकै जमीन मैं गिराय दई, और बाकै एक फिट दूर फेंक दई; ईसु प्रेत आत्मा कै निकरन की आग्या दई, और लौड़ा कै अच्छो करकै बाके दऊवा कै सौंप दई। <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />सब जनी परमेस्वर कि सक्तिसाली ताकत देखकै चौहोंक पड़े रहैं।</para>
  <para style="s" vid="LUK 9:43">ईसु अपनी मौत के बारे मैं फिरसे बतकाई</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22">मत्ती 17:22</ref>; <ref loc="MAT 23">23</ref>; <ref loc="MRK 9:30-32">मरकुस 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">जब हर कोई जो कुछ ईसु करत रहै, बे सब बातन से चौहोंक रहै, ईसु अपने चेलन से कही, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“जे बातैं तुमरे कानन मैं पड़ी रहाबै, काहैकि इंसान को लौड़ा इंसान के हात मैं पकड़बाओ जान बारो है।” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />पर चेला जे बातन कै नाय समझत रहैं, और जौ उनसे छिपाओ गौ रहै; ताकी बे बाकै जान ना पामैं, और बे जौ बात के बारे मैं बासे पूँछन से डरात रहैं।<verse eid="LUK 9:45" /></para>
  <para style="s">सबसे बड़ो कौन है?</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्ती 18:1-5</ref>; <ref loc="MRK 9:33-37">मरकुस 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />चेलन कि जौ बात मैं बहस छिड़ गई कि हममैं से बड़ो कौन है। <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />ईसु कै पता रहै कि बे मन मैं का सोच रै हैं, इसलै ईसु एक बालका कै लैकै अपने झोने ठड़बाई, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />और उनसे कही, “जो कोई भी मेरे नाओं से जौ बालका को स्वागत करथै, बौ मेरो स्वागत करथै; और जो मेरो स्वागत करथै, बौ मोकै भेजन बारे को स्वागत करथै, जो तुम मैं से सबसे छोटो से छोटो है, बहे बड़ो है।”<verse eid="LUK 9:48" /></para>
  <para style="s">जो कोई तुमरे खिलाप ना है, बौ तुमरे घाँईं है</para>
  <para style="r">(<ref loc="MRK 9:38-40">मरकुस 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />फिर यूहन्ना कही, “गुरुजी, हम एक आदमी कै तेरे नाओं से प्रेत आत्मा कै निकारत भइ देखे है, और हम बाकै मना करे, काहैकि बौ हमरे संग को ना रहै।”<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />ईसु बासे और दुसरे चेलन से कही, “बाकै रोकन की कोसिस मत करौ; काहैकि जो तुमरे खिलाप ना है बौ तुमरे घाँईं है।”<verse eid="LUK 9:50" /></para>
  <para style="s">एक गाँव जो सामरियन को रहै बे ईसु कै अपनान से मना कर दईं</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />जब ईसु स्वर्ग जानकै भौ, तौ बौ यरूसलेम कै जान ताहीं निकर पड़ो। <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />बौ अपने अग्गु दूत भेजी, जो सामरियन के एक गाँव मैं जाएकै बाके ताहीं सब कछु तैयार कर दईं। <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />पर बे लोग बाकै ना अपनाईं, काहैकि बौ यरूसलेम कै जात रहै। <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />जौ सब देखकै बाके चेला याकूब और यूहन्ना कहीं, “प्रभु; का तैं चाहथै, कि स्वर्ग से आगी गिरकै उनकै भसम कर देबै?”<verse eid="LUK 9:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55" />ईसु मुड़कै उनकै झुकाइ। <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />फिर ईसु और बाके चेला दुसरे गाँव गै।<verse eid="LUK 9:56" /></para>
  <para style="s">ईसु के पच्छू चलन को मतलब</para>
  <para style="r">(<ref loc="MAT 8:19-22">मत्ती 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />जब बे अपने रहा जात रहैं, तौ एक आदमी ईसु से कही, “जहाँ भी तैं जागो मैं तुमरे पच्छू आंगो।”<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />ईसु बासे कही, “लोमड़ियन के मांद हैं, और आसमान के पक्छिन के घोसला होथैं, लेकिन इंसान के लौड़ा के पास लेटन और सस्तान के ताहीं कोई जघा ना है।”<figure style="fig" alt="Fox with kits in a hole" file="bk00051c.tif" size="col" copy="Horace Knowles ©" ref="9:58">मांद मैं बालकन के संग लोमड़ी</figure><verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />ईसु दूसरे आदमी से कही, “मेरे पच्छू आ।” लेकिन बौ आदमी कही, “प्रभु, पहले मोकै बापस जान दे ताकी मैं अपने दऊवा कै दफनाए दियौं।”<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />ईसु जबाब दई, “मरे भैन कै अपनेई मुर्दन कै दफनान दे, तैं जा और परमेस्वर के राज्य को ऐलान कर।”<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />एकौर आदमी कही, “प्रभु, मैं तेरो पीछा करंगो; पर पहले मोकै जान दे कि अपने घरबारेन से बिदा हुई आमौं।”<note caller="+" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1 राजा 19:20</ref></char></note><verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />ईसु बासे कही, “जो कोई अपनो हाथ हर मैं रखकै पच्छू देखथै, बौ परमेस्वर के राज्य के काबिल ना है।”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">ईसु बहात्तर चेलन कै बाहर भेजी</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />जाके बाद प्रभु बहात्तर आदमिन कै चुनी और उनकै दुई-दुई करकै बाहर पनारी, ताकी बे हर सहर और बौ जघा मैं जामैं जहाँ बौ खुद जान बारो रहै। <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />ईसु उनसे कही, “गजब एक खेती है, लेकिन लेबर बड़ा कम हैं; इसलै खेत के प्रभु से प्रार्थना करौ, कि बौ अपने खेत काटन ताहीं लेबर भेज देबै।<note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 10:16">मत्ती 10:16</ref></char></note> <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />जाबौ! भेंड़ियन के बीच मैं तुमकै मेमना के हानी भेज रौ हौं। <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />इसलै बटुआ, झोला, जूता मत लियो; और ना रहामैं कोई से नमस्ते करियो।<note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="MAT 10:9">मत्ती 10:9</ref></char></note> <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />जब भी तुम कोई के घर मैं जाथौ, तौ पहले कहियो, ‘जौ घर मैं सांति बनी रहाबै।’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />अगर हुँआँ कोई सांतिप्रिय होगो; तौ तुमरो आर्सिवाद बाके ऊपर बनो रहगो, अगर ना है, तौ सांति बने रहन को आर्सिवाद बापस लै लियो। <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />बहे घर मैं रहबौ, और जो कछु उनसे मिलै, बहे खाबौ-पीबौ, काहैकि लेबर कै अपनी दिहाड़ी मिलनी चाहिए; घर-घर मत फिरियो। <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />जब भी तुम कोई सहर मैं जाबौ, और हुँआँ के लोग तुमरो स्वागत करैं, तौ जो कछु तुमरे सामने रखो जाबै बहे खईयो, <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />बौ सहर के बिमारन कै अच्छो करौ, और हुँआँ के लोगन से कहबौ, ‘परमेस्वर को राज्य तुमरे झोने आए चुको है।’ <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />लेकिन जब भी तुम एक सहर मैं जाबौ, और हुँआँ के लोग तुमरो स्वागत ना करैं, तौ रहा से निकर जईयो और कहियो, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />‘तुमरे सहर को धूदर जो हमरे पाँव मैं लगो है, हम तुमरे सामने झार देथैं, लेकिन जौ याद रखियो कि परमेस्वर को राज्य तुमरे झोने आए चुको है!’ <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />मैं तुमकै बिस्वास दिलाथौं कि परमेस्वर न्याय के दिन बौ सहर से जाधे सदोम के ऊपर दया दिखागो!”<verse eid="LUK 10:12" /></para>
  <para style="s">अविस्वासी सहर</para>
  <para style="r">(<ref loc="MAT 11:20-24">मत्ती 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />“जौ तुमरे ताहीं कितनो भयानक होगो खुराजीन! जौ तुमरे ताहीं कितनो भयानक होगो बैतसैदा! जो सामर्थ्य के काम तुमरे ऊपर भै हैं, अगर बे सूर और सैदा मैं करे जाते, तौ टाट<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">बोरी </char></note> ओढ़कै और राख मैं बैठकै बे कबके अपने पाप से मन बदल लेते! <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />पर न्याय के रोज तुमरी दसा से सूर और सैदा की दसा जाधे सहन के काबिल होगी।<note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="JOL 3:4-8">योएल 3:4-8</ref>; <ref loc="ZEC 9:2-4">जकर्याह 9:2-4</ref></char></note> <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />और हे कफरनहूम! का तैं स्वर्ग ले ऊँचो करो जागो? तैं तौ मरे भै के नरक मैं फेंको जागो!”<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />ईसु अपने चेलन से कही, “जो कोई तुमरी बात सुनथै, बौ मेरी बात सुनथै, जो तुमकै ना अपनाथै, बौ मोकै ना अपनाथै; और जो मोकै ना अपनाथै, बौ मोकै भेजन बारे कै ना अपनाथै।”<verse eid="LUK 10:16" /></para>
  <para style="s">बहात्तर चेलन को बापस लौटकै आनो</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />बहात्तर आदमी बड़ा खुसी से लौटकै आयकै कहीं, “प्रभु, हिंयाँ तक कि प्रेत आत्मा हमरी बात मानी जब हम उनकै तेरे नाओं को हुकम दै!”<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />ईसु उनकै जबाब दई, “मैं सैतान कै स्वर्ग से बिजली के हानी गिरत भइ देखो। <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />बात सुनौ! मैं तुमकै साँप और बीछी कै कुचलन को अधिकार दौ हौं और तुम अपने बैरी की पूरी सामर्थ्य के ऊपर जीत सकथौ, और तुमकै कोई नुकसान ना होगो। <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />तहुँओं जासे खुस मत होबौ, कि बुरी आत्मा तुमरी बात मानथैं; पर तुम जासे खुस रहबौ कि तुमरो नाओं स्वर्ग मैं लिखे गै हैं।”<verse eid="LUK 10:20" /></para>
  <para style="s">ईसु को खुस होनो</para>
  <para style="r">(<ref loc="MAT 11:25-27">मत्ती 11:25-27</ref>; <ref loc="MAT 13:16">13:16</ref>,<ref loc="MAT 13:17">17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />बहे समय ईसु पवित्र आत्मा के जरिये खुसी से भरगौ, और कही, “दऊवा, स्वर्ग और पृथ्वी को प्रभु! मैं तोकै धन्यवाद देथौं, कि तैं जे बातन कै ग्यानिन और समझदारन से लुकाए रखो, हाँ, दऊवा जी, तोकै ऐसो होन से खुसी मिली।<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />मेरो दऊवा मोकै सब कछु दई है; कोई ना जानथै कि लौड़ा दऊवा कै छोड़कै कौन है, और कोई ना जानथै कि दऊवा लौड़ा कै छोड़कै कौन है और लौड़ा कौनके चुनथै।”<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />फिर ईसु चेलन के घाँईं मुड़कै अकेले मैं कही, “तुम कितने खुसनसीब हौ कि तुम जे चीजैं देखरै हौ! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />मैं तुमकै बताथौं, कि भौत से भविस्यवक्ता और राजा चाँहीं, कि जो तुम देखरै हौ, बौ बे देखैं; पर बे ना देख पाईं और जो तुम सुनथौ, बौ बे सुनैं, पर बे ना सुन सके।”<verse eid="LUK 10:24" /></para>
  <para style="s">एक अच्छे सामरी की कहानी<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">दृस्टान्त</char></note></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />फिर एक कानून को सिक्छक ईसु कै फसान की कोसिस करी; और कही, “गुरुजी, मोकै अनंत जिंदगी पान के ताहीं का करने पड़ैगो?”<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />ईसु बाकै जबाब दई, “नियम मैं का लिखो है? तैं कैसे पढ़थै?”<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />बौ आदमी जबाब दई, “अपने पूरे मन से, अपनी पूरी ताकत से, और अपने प्रभु और परमेस्वर से प्यार करौ। और अपने पड़ोसी से बैसोई प्यार करौ जैसो तुम अपने आप से करथौ।”<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />ईसु बासे कही, “तैं ठीक जबाब दौ, जहे कर तौ तू जिंदो रैहगो।”<note caller="+" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">लैव्यवस्था 18:5</ref></char></note><verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />लेकिन कानून को सिक्छक खुदकै सई ठहरानो चहात रहै, इसलै बौ ईसु से पूँछी, “मेरो पड़ोसी कौन है?”<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />ईसु जबाब दई, “एक बार एक आदमी रहै, जो यरूसलेम से यरीहो कै जात रहै, इत्ते मैं डाँकू बाकै घेर कै बाके लत्ता उतार लईं, और मार पीटकै बाकै अधमरा छोड़कै चले गै। <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />और ऐसो भौ कि बहे रहा से एक पुजारी जात रहै, लेकिन जब बौ आदमी कै देखी, तौ बौ कतराएकै चले गौ। <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />बैसिये एक लेवी बौ जघा आओ, बहो बाकै देखकै कतराएकै चले गौ। <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />पर एक सामरी बौ रहा से सफर करत रहै, बौ बाके झोने आओ जो अधमरा पड़ो रहै, बौ बाकै देखी, तौ बाको दिल दया से भरगौ। <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />बौ बाके झोने गौ, और बाके घाव मैं जैतून तेल और दाखरस डारकै पट्टी भाँदी; फिर बौ अधमरा आदमी कै अपने जानवर मैं चढ़ायकै सराय मैं लैगौ, और बाकी सेवा संती करी। <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />दुसरे रोज बौ दुई चाँदी के सिक्का निकारकै सराय के मालिक कै दै दई, और कही, ‘जाकी सेवा संती करिये, और जो कछु तेरो और लगैगो, बौ मैं लौटन पोती तोकै दै दुंगो।’<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />अब तेरी समझ मैं जो डाकुन मैं घिर गौ रहै, जे तीनौ मैं से बाको पड़ोसी कौन है?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />कानून को सिक्छक जबाब दई, “बहे जो बाके ऊपर दया तरस खाई रहै।” ईसु फिर बासे कही, “तैं जा, तहूँ ऐसोई कर।”<verse eid="LUK 10:37" /></para>
  <para style="s">ईसु मार्था और मरियम से मिलो</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />जब ईसु और बाके चेला अपने रहा जात रहैं, तौ बौ एक गाँव मैं आओ, जहाँ मार्था नाओं की एक बईय्यर अपने घरै बाको स्वागत करी। <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />बाकी एक बहेनिया रहै, जोको नाओं मरियम रहै, बौ प्रभु के पाँव मैं बैठकै बाकी सिक्छा कै सुनत रहै। <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />पर मार्था सेवा करत-करत तंग हुई गई और बाके झोने आयकै कहेन लगी, “प्रभु, का तोकै कछु चिंता ना है कि मेरी बहेनिया मोकै सेवकाई करन के ताहीं इकल्ली छोड़ दई है? इसलै बासे कह, कि मेरी मदत करै!”<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />प्रभु बाकै जबाब दई, “मार्था, मार्था! तैं भौत बातन की चिंता करथै और परेसान है, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />लेकिन एक बात जरूर है; मरियम अच्छी चीज चुनी है, जो बासे छीनो ना जागो।”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">प्रार्थना के ऊपर ईसु की सिक्छा</para>
  <para style="r">(<ref loc="MAT 6:9-13">मत्ती 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />एक रोज ईसु एक जघा मैं प्रार्थना करत रहै। जब बौ प्रार्थना कर चुको, तौ बाके चेलन मैं से एक चेला ईसु से कही, “प्रभु, जैसे यूहन्ना अपने चेलन कै प्रार्थना करनो सिखाई है बैसिये हमउँ कै तैं प्रार्थना सिखाए दे।”<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />ईसु उनसे कही, “जब तुम प्रार्थना करथौ, तौ जौ कहियो:</para>
  <para style="q1" vid="LUK 11:2">‘दऊवा:</para>
  <para style="q2" vid="LUK 11:2">तेरो नाओं पवित्र मानो जाबै;</para>
  <para style="q2" vid="LUK 11:2">तेरो राज्य आबै।<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />हमरी दिन भर की रोटी हर रोज हमकै दे कर।<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />और हमरे पापन कै माफ कर,</para>
  <para style="q2" vid="LUK 11:4">काहैकि हम भी अपने हर एक कसूरवार कै माफ करथैं,</para>
  <para style="q1" vid="LUK 11:4">और हमकै कठिन परिक्छा मैं मत ला।’”<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />और ईसु अपने चेलन से कही, “मान लियौ तुम मैं से बाको एक दोस्त होबै, और बौ आधी रात कै बाके झोने जाएकै बासे कहबै, ‘दोस्त; मोकै तीन रोटी उधार दैदे। <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />काहैकि मेरो एक दोस्त सफर करकै मेरे घरै आओ है, और मेरे पास बाके ताहीं कछु खान ताहीं ना है!’ <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />और मान लेबौ कि तुमरो दोस्त अंदर से जबाब देबै, ‘मोकै परेसान मत करै! अब तौ फाटकौ बंद है, और मेरे बालका मेरे संग बिस्तर मैं हैं, मैं उठकै तोकै कछु ना दै सकथौं।’ <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />खैर, फिर का? मैं तुमसे कहथौं, कि भलेई बाको दोस्त उठकै रोटी ना दई, तहुँओं बौ उठैगो और तुमकै तुम्हारी जरूरत की हर चीज देगो काहैकि तुमकै मांगत रहन मैं ना सरमानो चाहिए। <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />और इसलै मैं तुमसे कहथौं: माँगौ, तौ तुमकै दौ जागो; ढूँड़ौ तौ तुम पाबैगे; खटखटाबौ, तौ तुमरे ताहीं मोहोंट खोलो जागो। <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />काहैकि जो कोई मांगथै, बाकै मिलथै; और जो ढूँड़थै, बौ पाथै; और जो खटखटाथै, बाके ताहीं मोहोंट खोलो जागो। <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />का तुम मैं से ऐसो कोई दऊवा होगो, कि जब बाको लौड़ा मच्छी माँगै, तौ बाको दऊवा बाकै मच्छी के बदले साँप देबै? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />या जब बौ अंडा माँगै, तौ का तुम बाकै बीछी देगे? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />तुम चाँहे जित्ते बुरे होबौ, तुम अपने बालका कै अच्छी चीज देनो जानथौ, तौ तुमरो स्वर्गिय दऊवा अपने माँगन बारे कै पवित्र आत्मा काहेकै ना देगो!”<verse eid="LUK 11:13" /></para>
  <para style="s">ईसु और बालजबूल</para>
  <para style="r">(<ref loc="MAT 12:22-30">मत्ती 12:22-30</ref>; <ref loc="MRK 3:20-27">मरकुस 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />फिर ईसु एक गूँगी प्रेत आत्मा कै निकारी; जब प्रेत आत्मा निकर गई, तौ बौ आदमी बोलन लगो; और भीड़ हैरान रहै, <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />लेकिन कुछ लोग कहीं, “जौ तौ प्रेत आत्मा को अधिकारी बालजबूल कि मदत से प्रेत आत्मा कै निकारथै।”<verse eid="LUK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16" />और लोग ईसु कै फसानो चहात रहैं, इसलै उनके ऊपर परमेस्वर की मंजूरी है जौ साबित करन के ताहीं बाकै स्वर्ग से एक चिन्ह दिखान के ताहीं कहीं। <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />लेकिन ईसु जानत रहै कि बे का सोचत रहैं, इसलै ईसु उनसे कही, “जो-जो देस मैं फूट पड़थै, बौ देस राज्य कभी न कर पाथै; और जो घर मैं फूट पड़थै, बौ परिवार अलग ही जाथै।” <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />इसलै अगर सैतान अपनोई बिरोधी ही जाबै, तौ बाको राज्य कैसे बनो रहगो? तुम तौ मेरे बारे मैं कहथौ, कि जौ प्रेत आत्मा के मुखिया बालजबूल की मदत से प्रेत आत्मा कै निकारथै। <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />अगर मैं बालजबूल की मदत से प्रेत आत्मा कै निकारथौं, तौ तुमरे चेला उनकै कैसे बाहर निकारथैं? तुमरे खुद के चेला न्याय करथैं कि तुम गलत हौ! <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />ना, मैं जौ परमेस्वर कि सक्ति के जरिये प्रेत आत्मा कै बाहर निकारथौं, और जौ साबित करथैं कि परमेस्वर को राज्य पहलेई तुमरे पास आए चुको है।<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />“जब एक तगड़ो आदमी, अपने पूरे हथियार के संग अपने घर आँगन की रखबारी सांति से करथै, तौ बाको पूरो सामान सुरक्छित रहथै।” <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />पर जब बासे तगड़ो कोई बाके ऊपर हमला करथै और बासे जीत जाथै, तौ बाके बे हथियार जोके ऊपर बाको भरोसो रहै, छीन लेथै और बाकी सम्पत्ति लूटकै बाँट देथै।<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />“जो मेरे संग ना है बौ मेरे बिरोध मैं है, और जो मेरे संग ना बटोरथै बौ बिखेरथै।”<verse eid="LUK 11:23" /></para>
  <para style="s">प्रेत आत्मा की बापसी</para>
  <para style="r">(<ref loc="MAT 12:43-45">मत्ती 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />“जब प्रेत आत्मा कोई आदमी के भीतर से निकर जाथै, तौ बौ सूखे देस मैं आराम करन ताहीं जघा ढूँड़त फिरथै, और जब ना मिलथै तौ खुदकै कहथै, ‘कि मैं अपने बहे घर मैं जहाँ से निकरो रहौं बापस जांगो।’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />और बापस आयकै बाकै साफ-सुथरो और सजो-सजाओ मिलथै। <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />फिर बौ आयकै अपने से और जाधे बुरी सात आत्मा कै अपने संग लै आथै, और बे बामै समाएकै बास करथैं, बौ आदमी की दसा पहले कि दसा से और बुरी ही जाथै।”<verse eid="LUK 11:26" /></para>
  <para style="s">सच्ची खुसी</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />जब ईसु जे बात कहतै रहै तौ भीड़ मैं से एक बईय्यर जोड़न से ईसु से कही, “बौ बईय्यर कितनी खुसनसीब है जो तैं बाकी कोक मैं रहो, और तेरो पालन पोसँड़ करी!”<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />लेकिन ईसु जबाब दई, “बल्किन, बे कितने खुसनसीब हैं जो परमेस्वर को बचन सुनथैं और बाकै मानथैं!”<verse eid="LUK 11:28" /></para>
  <para style="s">एक चमत्कार की माँग</para>
  <para style="r">(<ref loc="MAT 12:38-42">मत्ती 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />जैसे-जैसे लोगन की भीड़ ईसु के चारौ तरफ जमा भइ, ईसु कही, “आज-कल के लोग कितने बुरे हैं! बे चिन्ह कै पूँछथैं, लेकिन योना के चिन्ह के अलावा उनकै कोई और चिन्ह उनकै ना दौ जागो। <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />जैसे योना नीनवे के लोगन के ताहीं चिन्ह रहै, बैसिये इंसान को लौड़ा आज-कल के लोगन के ताहीं एक चिन्ह होगो। <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />न्याय के दिन तरिहाँए सीबा की रानी उठ खड़ी होगी और आज के लोगन के ऊपर इल्जाम लगागी, काहैकि बौ राजा सुलैमान की अकल को ग्यान सुनन के ताहीं अपने देस से पूरी पृथ्वी को रहा सफर करी; मैं तुमसे कहथौं, कि हिंयाँ कछु है, जो राजा सुलैमान से भी बड़ो है।<note caller="+" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 राजा 10:1-10</ref>; <ref loc="2CH 9:1">2 इतिहास 9:1</ref> </char></note> <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />नीनवे के लोगन के घोसड़ाँ बारे दिन आज-कल के लोगन के संग ठाड़कै, और तुमरे ऊपर दोस लगांगे; काहैकि बे योना को उपदेस सुनकै मन बदलीं और देखौ, हिंयाँ बौ है, जो योना से भी बड़ो न्याय करन बारो है।”<note caller="+" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JON 3:5-10">योना 3:5-10</ref></char></note><verse eid="LUK 11:32" /></para>
  <para style="s">सरीर को उजियारो</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />“कोई आदमी दिया जलायकै लुकात ना है या छपरिया के नीचे ना रखथै; बल्किन बाकै डीट मैं रखथै, ताकी लोग उजिते मैं देख सकैं और भीतर आए सकैं। <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />तुमरी सरीर को दिया तुमरी आँखी है, इसलै जब तुमरी आँखी अच्छी है, तौ तुमरो पूरो सरीर उजिते से भरो होथै; लेकिन जब तुमरी आँखी अच्छी ना होंगी, तौ तुमरो पूरो सरीर अंधियारे मैं होगो। <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />पक्को करैं, कि कहूँ जो उजियारे तुमरे मैं है बौ अंधियारे मैं ना हुई जाबै। <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />अगर तुमरो पूरो सरीर उजिते से भरो है, और तेरो कोई भी हिस्सा अंधियारे मैं ना होबै, तौ सब जघा ऐसो उजितो होगो, जैसे एक दिया अपनी चमक से तोकै उजितो देथै।”<verse eid="LUK 11:36" /></para>
  <para style="s">ईसु फरीसियन और कानून के सिक्छकन के ऊपर इल्जाम लगाथै</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="MRK 12:38-40">मरकुस 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />जब ईसु बोलनो बंद करी, तौ एक फरीसी बासे अपने संग खानु खान ताहीं पूँछी; इसलै बौ भीतर जाएकै खानु खान कै बैठगौ। <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />फरीसी हैरान ही गौ, जब बौ देखी कि ईसु खानु खान से पहले हात ना धोई है। <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />तौ प्रभु बासे कही, “फरीसियौ, तुम कप और थरिया कै बाहर से सुद्ध करथौ, लेकिन तुमरे भीतर हिंसा और बुराई भरी भइ है। <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />मूर्ख! परमेस्वर जो बाहर को हिस्सा बनाई, का बौ भीतर को हिस्सा ना बनाई? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />लेकिन अपने कप और प्लेटन मैं जो कछु है, बाकै गरीबन के दै देबौ और सब कछु तुमरे ताहीं विधि पूर्वक सुद्ध ही जागो।”<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />“फरीसियौ तुमरे ताहीं कितनो भयानक है! तुम परमेस्वर कै मसाला और पुदीना और भौत सी जड़ी बूटिन के पौध जैसे मौसमी जड़ी बूटिन को दसमों हिस्सा देथौ, लेकिन तुम परमेस्वर के प्यार कै टाल देथौ; जौ तुमकै दुसरेन कि उपेक्छा के बिना कोसिस के न्याय करनो चाहिए।”<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />“तुम फरीसियन के ताहीं कितनो भयानक है! तुम सभाघरन मैं खास-खास आसन से प्यार करथौ और बजार मैं नमस्ते चाहथौ। <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />तुमरे ताहीं कितनो भयानक है! काहैकि तुम बिना निसानी के कबर के हानी हौ, जिनके ऊपर लोग चलथै, पर ना जानथैं।”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />कानून के सिक्छकन मैं से एक ईसु से कही, “गुरुजी, जब तैं जौ कहरौ है, तौ तैं हमरी भी बेजती कर रौ है!”<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />ईसु जबाब दई, “तुम्हऊँ कानून के सिक्छकन के ताहीं कितनो भयानक है! तुम ऐसे बोझ जिनकै उठानो मुस्किल है, इंसानन के ऊपर लादथौ पर तुम खुद बे बोझन कै उठान मैं मदत करन के ताहीं एक उँगरिया तक ना लगाथौ। <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />तुमरे ताहीं कितनो भयानक है! तुम बे भविस्यवक्ता कि कबर बनाथौ, जिनकै तुमरे पुरखा मारडारीं रहैं। <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />तुम गभा हौ, और अपने पुरखन के कामन से सहमत हौ; काहैकि बे भविस्यवक्ता कि हत्या करीं और तुम उनकी कबर बनाथौ। <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />इसलै परमेस्वर कि बुद्धि कही, ‘कि मैं उनके झोने भविस्यवक्ता और प्रेरितन कै भेजंगो; और बे उनमैं से कुछ कै मार देंगे और कुछ कै सतांगे।’ <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />दुनिया कि उत्पत्ति के बाद से मारे गै सबै भविस्यवक्ता कि हत्या के ताहीं जौ समय के लोगन कै खून की सजा दई जागी, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />हाबिल कि हत्या से लैकै जकर्याह कि हत्या तक जो बेदी और पवित्र जघा के बीच मारे गै हैं: हाँ, मैं तुमकै बताथौं, जौ समय के लोगन कै उन सबन कै परमेस्वर के घर मैं खून की सजा दी जागी!<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />तुम कानून के सिक्छकन के ताहीं कितनो भयानक है! तुम ग्यान कि कुंजी रख तौ लै हौ जो ग्यान के घर को फाटक खोलथै; पर तुम खुद ना गै, और जो अंदर जान कि कोसिस करत रहैं, उनकै भी रोक दै!”<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />जब ईसु बौ जघा से चले गौ, तौ यहूदि नियम के सिक्छक और फरीसी बाकी बुराई करीं और ईसु से गजब सवाल पूँछीं, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />और बाकै फसान के ताहीं घात मैं लगे रहे, ताकी बाके कछु गलत कहेन मैं पकड़ सकैं।<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">पाखंड के खिलाप चितौनी</para>
  <para style="r">(<ref loc="MAT 10:26">मत्ती 10:26</ref>; <ref loc="MAT 27">27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />इतने मैं जब हजारो जनी एक संग भीड़ लगाईं, हिंयाँ तक कि एक दुसरेन के ऊपर गिरे जामैं, तौ ईसु सबसे पहले अपने चेलन से कही, “फरीसियन के खमीर के खिलाप रहबौ, मेरो मतलब पाखंड से है। <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />जो कछु लुकाओ गौ है, बाकै उजागर करो जागो, और हर रहस्य को पता करो जागो। <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />इसलै जो कछु तुम अंधियारे मैं कहे हौ, बौ उजिते मैं सुनो जागो; और जो तुम बंद कमरा मैं कानाफूसी को प्रचार करे हौ, बौ मकान कि छत से चिल्लाओ जागो।”<verse eid="LUK 12:3" /></para>
  <para style="s">कौन से डरानो चाहिए</para>
  <para style="r">(<ref loc="MAT 10:28-31">मत्ती 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />“मैं तुमकै बताथौं, मेरे दोस्तौ, सरीर कै मारन बारेन से मत डराबौ, काहैकि बासे जाधा और कछु ना कर सकथैं। <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />मैं तुमकै दिखांगो कि कौन से डराने है: परमेस्वर से डराबौ, जो मारन के बाद नरक मैं फेंकन को अधिकार रखथै, मेरो बिस्वास करौ, बौ बहे है जोसे तुमकै डरानो चाहिए!”<verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />“का दुई पैसा के सिक्का की पाँच गौरैया ना बिकथैं? फिर भी परमेस्वर उनमैं से एक कै भी ना भूलथै। <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />हिंयाँ तक कि तुमरी मुड़िया के बार भी गिने जा चुके हैं, इसलै डराबौ मत; तुम भौत गौरैयन से जाधा बढ़कै हौ!”<verse eid="LUK 12:7" /></para>
  <para style="s">मसीह कै अपनानो और ना अपनानो</para>
  <para style="r">(<ref loc="MAT 10:32-33">मत्ती 10:32-33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19">10:19</ref>; <ref loc="MAT 20">20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />“मैं तुमकै बिस्वास दिलाथौं कि जो लोग सबन के सामने मोकै मान लेंगे, कि बे मेरे हैं, इंसान को लौड़ा भी परमेस्वर के स्वर्गदूतन के सामने ऐसोई करैगो। <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />लेकिन जो लोग मोकै सबन के सामने ना अपनाथैं, इंसान को लौड़ा भी परमेस्वर के स्वर्गदूतन के सामने उनकै अपनान से मना कर देगो।”<verse eid="LUK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10" />“जो कोई भी इंसान के लौड़ा के खिलाप एक सब्द कहथै उनकै माफ करो जा सकथै; लेकिन जो कोई भी पवित्र आत्मा के खिलाप बुराई करथै, बाकै कहुए माफ ना करो जा सकथै।”<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">मत्ती 12:32</ref>; <ref loc="MRK 3:29">मरकुस 3:29</ref></char></note><verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />“जब बे तुमकै सभाघरन मैं या राज्यपालन या सासक अधिकारिन के सामने लामैं, तौ जौ बात कि चिंता मत करियो कि तुम खुद को बचाव कैसे करैगे या तुम अपने मैं अधिकार का कहबैगे। <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />पवित्र आत्मा तुमकै बौ समय सिखाए देगी, जो तुमकै कहनो चाहिए।”<verse eid="LUK 12:12" /></para>
  <para style="s">मूर्ख सेठ आदमी कि कहानी<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false">दृस्टान्त</char></note></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />फिर भीड़ मैं से एक आदमी ईसु से कही, “गुरुजी, मेरे भईय्या से कह, कि दऊवा कि सम्पत्ति मोकै बाँट दे जो हमरो दऊवा हमरे ताहीं छोड़ी है।”<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />ईसु बाकै जबाब दई, “दोस्त, कौन मोकै दुई के बीच कि सम्पत्ति को न्याय करन या हिस्सा डारन को अधिकार दई है?” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />और बौ बे सबन से कहत गौ, “देखौ और हर तरहन के लालच से खुद के बचाबौ; काहैकि तुमरी सच्ची जिंदगी बे चीजन से ना बनथै, जो तुमरी खुद कि हैं, चाहे तुम कितने सेठ क्यों ना होबौ।”<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />तौ ईसु उनकै जौ कहानी सुनाई: “एक सेठ आदमी रहै जोके पास जमीन रहै, और बाकी बड़ा अच्छी फसल भइ रहै। <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />तौ बौ अपने मन मैं सोचन लगो, मेरे पास अपनी फसल रखन के ताहीं जघा ना है: मैं का कर सकथौं? <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />और बौ कही, ‘मैं जौ करंगो: मैं अपनी बखारी तोड़कै उनसे बड़ी बनांगो; और बामै अपनो सब खलियान को अन्न और गेंहूँ रखंगे। <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />तौ मैं अपने आप से कहेंगो, भाग्यसाली आदमी! तेरे पास गजब सालन के ताहीं सम्पत्ति और जरूरी सब अच्छी चीजैं हैं; चैन से रहा, खा, पी, सुख से रहा!’ <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />लेकिन परमेस्वर बासे कही, तैं मूर्ख है! जहे रात तेरी जान तोसे लै लई जागी; तौ जो कछु तैं अपने आप इखट्टो करो है, बौ कौन को होगो?”<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />और ईसु उपाय निकारी, “ऐसोई बौ आदमी भी है जो अपने ताहीं धन बटोरथैं, पर परमेस्वर कि नजर मैं सेठ ना हैं।”<verse eid="LUK 12:21" /></para>
  <para style="s">परमेस्वर मैं बिस्वास रखौ</para>
  <para style="r">(<ref loc="MAT 6:25-34">मत्ती 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />तौ ईसु अपने चेलन से कही, “और इसलै मैं तुमसे कहथौं, अपनी ज्यान के ताहीं खानु के बारे मैं या सरीर के ताहीं जरूरी लत्तन के बारे मैं चिंता मत करौ। <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />काहैकि ज्यान खानु से, और सरीर लत्तन से जाधे जरूरी है। <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />कउवा कै देखौ: बे बीज ना लगाथै और ना फसल कै इखट्टो करथैं; उनके पास भंडार को घर या खेत खलियान ना हैं; फिर भी परमेस्वर उनकै खबाथै! तुमरो मूल्य पक्छिन की तुलना मैं भौत है! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />का तुम मैं से कोई भी जिंदगी के बारे मैं चिंता करकै थोड़ी सो लम्बो जी सकथै? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />अगर तुम इत्ती छोटी चीज ना कर सकथौ, तौ और दुसरी चीजन के बारे मैं काहे चिंता करथौ? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />देखौ जंगली फूल मेरी महिमा के जरिया कैसे बढ़थैं: बे काम ना करथैं और ना अपने ताहीं लत्ता बनाथैं; लेकिन मैं तुमकै बताथौं, कि राजा सुलैमान भी अपनी पूरी सम्पत्ति मैं से एकौ फूल के हानी सुगड़ लत्ता ना पहनी रहै। <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />अगर परमेस्वर मैदान कि घाँस कै जो आज है, और कल भट्टी मैं झोंकी जागी, ऐसो पहनाथै; तौ कम बिस्वास करन बारे, बौ तुमकै और जाधे काहे ना पहनागो?”<verse eid="LUK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29" />“और तुम जौ बात की परेसानी मैं मत रहबौ, कि का खांगे और का पींगे। <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />काहैकि दुनिया के गैर यहूदि जे सब चीजन कै ढूँड़न मैं रहथैं और तुमरो दऊवा जानथै, कि तुमकै जे चीजन कि जरूरत है। <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />जाके बदले, बाके राज्य कै ढूँड़न मैं लगे रहबौ, तौ जे चीजैं भी तुमकै मिल जांगी।”<verse eid="LUK 12:31" /></para>
  <para style="s">स्वर्ग मैं धन</para>
  <para style="r">(<ref loc="MAT 6:19-21">मत्ती 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />“छोटो झुंड, मत डराबै; काहैकि तुमरे दऊवा कै जौ अच्छो लगो है, कि तुमकै राज्य देबै। <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />अपनो सब हानी बेचकै गरीबन कै पैसा दै देबौ; और अपने ताहीं ऐसो बटुआ बनाबौ, जो पुराने ना होथैं, मतलब स्वर्ग मैं ऐसो धन इखट्टो करौ जो घटत ना है, जोके झोने चुट्टा ना जाए सकथै, और कीरा करमोला नास ना कर सकथैं। <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />काहैकि जहाँ तुमरो धन है, हूँनै तुमरो मन भी लगो रहबैगो।”<verse eid="LUK 12:34" /></para>
  <para style="s">चौकन्नो नौकर</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />“जो भी आथै बाके ताहीं तैयार रहबौ, कारवाई के ताहीं लत्ता पहनै और अपने दिया जलाए रखाबौ,<note caller="+" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">मत्ती 25:1-13</ref> </char></note> <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />और तुम बे नौकरन के हानी बनौ, जो बिहा की दावत से अपने प्रभु के बापस आन के ताहीं असियाय रै हैं; जब बौ आगो और फाटक खटखटागो, तौ तुरंत बाके ताहीं फाटक खोल देंगे। <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />खुसनसीब हैं बे सेवक, जिनके प्रभु बापस आन मैं उनकै जगत भइ और सेवा करत भै पाथै! मैं तुमसे सच्ची कहथौं, बौ अपनो कोट उतारकै, उनके झोने बैठ जागो, और उनके संग असियागो। <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />अगर बौ आधी रात कै या बाके बाद आयकै उनकै जगत भइ पाबै, तौ बे नौकर कितने खुस होंगे! <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />और तुम जौ पक्को कर सकथौ कि अगर कोई घर के मालिक कै पता होतो कि चुट्टा कौन से समय आगो, तौ बौ जगत रहतो, और चुट्टा कै अपने घर मैं ना घुसन देतो।<note caller="+" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">मत्ती 24:43-44</ref></char></note> <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />तुम्हऊँ तैयार रहबौ; काहैकि जो समय तुम सोचैगे भी ना, बहे समय इंसान को लौड़ा आ जागो।”<verse eid="LUK 12:40" /></para>
  <para style="s">बफादार और बेईमान नौकर</para>
  <para style="r">(<ref loc="MAT 24:45-51">मत्ती 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />पतरस कही, “प्रभु, का जौ कहानी हमरे ताहीं लागू होथै, या तैं जौ सबन के ताहीं कहरौ है?”<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />प्रभु जबाब दई, “बौ बफादार, अकलदार और भरोसेमंद प्रबंधक कौन है? जोकै बाको मालिक, घर चलान के ताहीं और सेवक के झुंड मैं से एक कै सई समय मैं खानु देन ताहीं सरदार बनाबै। <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />खुसनसीब है बौ सेवक, जोकै बाको प्रभु आयकै ऐसोई करत पाबै। <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />सच मैं, मैं तुमकै बताथौं, मालिक बौ नौकर कै अपनी पूरी सम्पत्ति को अधिकारी बनाए देगो। <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />पर अगर बौ सेवक अपने मन मैं सोचन लगै, कि मेरो प्रभु आन मैं देरी कर रौ है, और दुसरे दास और दासियन कै मारनो-पीटनो सुरू कर देबै, और खाए-पीकै नसा मैं होन लगै, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />तौ बौ सेवक को प्रभु ऐसे रोज आगो, जब नौकर बाकै ना असियागो, और ऐसे समय जोकै बौ ना जानत होगो, आगो और बाकै गजब दुख दैकै बाको हिस्सा अविस्वासी के संग ठहरागो।”<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />और बौ सेवक जो जानत रहै कि बाको प्रभु बासे का चाहथै, और बौ तैयार ना रहै ना बाकी इच्छा के हिसाब से चलो, बाकै सजा दई जागी। <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />लेकिन जो नौकर जौ ना जानथै कि बाको मालिक का चाहथै, और फिर भी कुछ ऐसो करथै जोके ताहीं बौ कोड़े खान को हकदार है, बाकै हल्के कोड़े से सजा दई जागी। जो आदमी कै भौत कछु दौ जाथै, बासे भौत माँगो जागो; और जोकै भौत सौंपो गौ है, बासे भौत लौ जागो।<verse eid="LUK 12:48" /></para>
  <para style="s">ईसु अलग होन को बजह है</para>
  <para style="r">(<ref loc="MAT 10:34-36">मत्ती 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />“मैं धरती कै आगी लगान कै आओ रहौं, और मैं कैसे चहात रहौं कि जौ पहले सेई जल जाबै! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />मोकै तौ एक बपतिस्मा लेने है; और जबले बौ ना हुई लेबै तौले मैं कैसी हालत मैं रहेंगो!<note caller="+" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">मरकुस 10:38</ref></char></note> <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />का तुमकै लगथै कि मैं धरती मैं सांति लान के ताहीं आओ हौं? ना, सांति ना, बल्कि अलग करन आओ हौं। <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />काहैकि अब से एक परिवार मैं पाँच जनी आपस मैं बिरोध रखंगे, तीन दुई से और दुई तीन से। <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />दऊवा लौड़ा से, और लौड़ा दऊवा से बिरोध रखैगो, और अईय्या अपनी लौड़िया के खिलाप होंगी, और लौड़ियैं अपनी अईय्यन के खिलाप होंगी; सास अपनी बहु के और बहु अपनी सास के खिलाप होंगी।”<verse eid="LUK 12:53" /></para>
  <para style="s">समय कै समझनो</para>
  <para style="r">(<ref loc="MAT 16:2">मत्ती 16:2</ref>,<ref loc="MAT 16:3">3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />और ईसु लोगन से जहो कही, “जब बादर कै पछार से उठत भइ देखथौ, तौ तुरंत कहथौ, कि मेंहें बरसैगो; और ऐसोई होथै। <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />और जब तरिहाँए कि ब्यार चलत देखथौ, तौ कहथौ, कि लुहू चलैगी, और ऐसोई होथै। <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />अरे ढोंगियौ! तुम धरती और आसमान कै देखकै मौसम कै परख सकथौ; फिरौंकी, तुम जौ अभै जो चल रौ है बाको मतलब काहेकै ना समझथौ?”<verse eid="LUK 12:56" /></para>
  <para style="s">अपने विपक्छि के संग समझौता करैं</para>
  <para style="r">(<ref loc="MAT 5:25">मत्ती 5:25</ref>,<ref loc="MAT 5:26">26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />“तुम अपने आपै परख करकै न्याय काहेकै ना कर लेथौ, कि धर्मी कौन है? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />अगर कोई अधिकारी तुमरे खिलाप मुकदमा करथै और तुमकै अदालत मैं लै जाथै, तौ तुम अदालत मैं जान से पहलेई खुदकै छुड़ान की पूरी कोसिस करौ; अगर तुम ना निपटागे, तौ तुमकै न्याई के सामने खींच लौ जागो, जो तुमकै सिपईय्या कै सौंप देगो, और तुमकै कैदखाना मैं डार दौ जागो। <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />मैं तुमकै बताथौं, कि जबले तुम अपनो जुर्माना पाई-पाई ना चुकाए देगे तौले हुँआँ से छुट ना पागे।”<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">अपने पापन से मन फिराबौ ना तौ मरैगे</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />बौ समय कुछ लोग हुँआँ रहैं, जो ईसु कै बे गलीली के बारे मैं बताईं, जिनकै पिलातुस तौ मारी रहै जब बौ परमेस्वर कै खून की बलि करत रहैं। <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />जौ सुनकै ईसु उनकै जबाब दई, “का तुम समझथौ, कि बे गलीली दुसरे गलीली से जाधे पापी रहैं कि उनकै ऐसे मार दौ गौ? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />बास्तव मैं नाय! और मैं तुमसे कहथौं कि अगर तुम अपने पापन से मन ना बदलैगे, तौ तुम्हऊँ उनके हानी मर जागे। <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />सिलोह मैं बे अठारै जनी के बारे मैं का है उनके ऊपर गुम्मट गिरो, और बे मारे गै रहैं? का तुमकै लगथै कि जौ साबित होथै कि बे यरूसलेम मैं रहेन बारे दुसरे सब जनी कि तुलना मैं पापी रहैं? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />बास्तव मैं न! और मैं तुमसे कहथौं, कि अगर तुम अपने पापन से ना मन बदलैगे, तौ तुम सब मर जाबैगे, जैसो बे करी रहैं।”<verse eid="LUK 13:5" /></para>
  <para style="s">बगैर फल बारे अंजीर के पेंड़ कि कहानी</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />फिर ईसु उनकै जौ कहानी सुनाई, “एक बार एक आदमी रहै, जोके अंगूर की बारी मैं एक अंजीर को पेंड़ रहै: बौ बामै अंजीर कै ढूँड़न कै गौ, लेकिन कछु ना मिलो। <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />तौ बौ अपनी बारी के रखबरिया से कही, रखबरिया ‘देख, तीन साल से मैं जौ अंजीर के पेंड़ मैं अंजीर ढूँड़त आयरौ हौं, और मोकै कछु न मिलो; जाकै काट दे! कि जौ जमीन कै भी काहे रोके रहमैं?’ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />लेकिन रखबरिया जबाब दई, ‘प्रभु जाकै जौ साल तौ और छोड़ दे; मैं जाके चारौ घाँईं से खोदकै खाद डारंगो। <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />फिर अगर अगले साल अंजीर को पेंड़ फरो तौ भलो, अगर ना फरो तौ जाकै काट देंगे।’”<verse eid="LUK 13:9" /></para>
  <para style="s">ईसु साबत के रोज एक अपंग बईय्यर कै अच्छो करी</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />साबत के रोज ईसु एक सभाघर मैं सिक्छा देत रहै। <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />हुँआँ एक बईय्यर रहै, जोकै अठारै साल से एक कमजोर करन बारी प्रेत आत्मा पकड़े रहै, बौ कतई लोहोक गई रहै और कतईये सीधी ना हुई पात रहै। <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />जब ईसु बाकै देखी, तौ ईसु बासे बोली, “बईय्यर, तैं अपनी बिमारी से आजाद है!” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />ईसु बाके ऊपर हाथ धरी, और बौ तुरंतै सीधी हुई गई, और परमेस्वर कि बड़ाँईं करन लग गई।<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />सभाघर के मुखिया गुस्सा मैं रहै बौ जौ ताहीं कि ईसु साबत के रोज बाकै अच्छो करी रहै, सभाघर के अधिकारी खिसियाए कै लोगन से कहेन लगे, “छै रोज हैं, जोमैं काम करनो चाहिए, और बेईं दिनन मैं आयकै अच्छे होबौ; पर साबत के रोज ना!”<note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">निर्गमन 20:9-10</ref>; <ref loc="DEU 5:13-14">व्यवस्थाविवरन 5:13-14</ref></char></note><verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />प्रभु बाकै जबाब दई, “तुम ढोंगी हौ! का साबत के रोज तुम मैं से कोई भी अपने बरधा या गधा कै सार से खोलकै पानी नाय पिबागो। <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />हिंयाँ अब अब्राहम को बंस है, जोकै सैतान अठारै साल ले कब्जा मैं करे रखाई रहै; का बाकै साबत के रोज बंधन से आजाद ना करो जानो चाहिए?” <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />ईसु को जबाब बाके दुस्मनन कै खुदकै सरम बाए दई, जबकी लोग बे सब अचम्मे चीजन मैं खुसी मनाईं जो बौ महान काम करी रहै।<verse eid="LUK 13:17" /></para>
  <para style="s">राई के बीज कि कहानी</para>
  <para style="r">(<ref loc="MAT 13:31">मत्ती 13:31</ref>; <ref loc="MRK 4:30-32">मरकुस 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />ईसु पूँछी, “परमेस्वर को राज्य कैसो है? मैं जाके संग का कि तुलना करौं? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />बौ राया के एक गूदा के हानी है, जोकै एक आदमी लैकै अपनी बारी मैं बोई: और बौ बढ़कै पेंड़ बन गौ; और आसमान के पक्छी बाकी हँगईय्या मैं अपनो घोसला बनाईं।”<verse eid="LUK 13:19" /></para>
  <para style="s">खमीर कि कहानी</para>
  <para style="r">(<ref loc="MAT 13:33">मत्ती 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />ईसु फिर से पूँछी, “मैं परमेस्वर के राज्य कि तुलना कासे करौं? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />जौ जाके हानी है: कि एक बईय्यर थोड़ी खमीर लैकै तीन नाप चून मैं मिलाथै, तौले मिलाथै जबले कि चून खमीर मैं अच्छे से मिलत ना है।”<verse eid="LUK 13:21" /></para>
  <para style="s">पतरो रस्ता</para>
  <para style="r">(<ref loc="MAT 7:13">मत्ती 7:13</ref>; <ref loc="MAT 14">14</ref>; <ref loc="MAT 21">21</ref>; <ref loc="MAT 22">22</ref>; <ref loc="MAT 23">23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />ईसु सहर-सहर, और गाँव-गाँव से गुजरो, और लोगन कै पढ़ातो और यरूसलेम के घाँईं अपनो रहा बनात रहै। <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />कोई बासे पूँछी, “प्रभु जी, कुछ लोगन कै बचाओ जागो?”<verse eid="LUK 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 13:24" />ईसु उनकै जबाब दई, “पतरे फाटक से भीतर जान कि पूरी कोसिस करौ; काहैकि भौत से लोग जरूर करकै भीतर जान कि कोसिस करंगे, लेकिन जाए ना पांगे। <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />जब घर को मालिक उठकै फाटक बंद कर देगो, और तुम बाहर ठाड़कै फाटक खटखटाए कै कहगे, ‘हमरे ताहीं फाटक खोल दे, प्रभु!’ बौ तुमकै जबाब देगो, ‘मोकै न पता है कि तुम कहाँ से आथौ!’ <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />तौ तुम जबाब देगे, ‘हम तेरे संग खाए और पिये; तैं हमरे सहर मैं पढ़ाओ है!’ <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />लेकिन बौ फिर से कहेगो, ‘मोकै ना पता है कि तुम कहाँ से आथौ; मोसे दूर हुई जाबौ, तुम सब जनी अधर्मी हौ!’ <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />हुँआँ रोनो और दाँत पीसनो होगो, जब तुम अब्राहम और इसहाक और याकूब और सब भविस्यवक्ता कै परमेस्वर के राज्य मैं बैठे भै देखैगे, और अपने आपकै बाहर निकारे भै देखैगे!<note caller="+" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 22:13">मत्ती 22:13</ref>; <ref loc="MAT 25:30">25:30</ref> </char></note><note caller="+" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 8:11">मत्ती 8:11</ref>; <ref loc="MAT 12">12</ref> </char></note> <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />लोग अगार और पछार से, सीरे और तरिहाँए से आंगे, और परमेस्वर के राज्य मैं खानु खान कै बैठंगे। <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />फिर जो अभै आखरी मैं हैं बे पहले होंगे, और जो अभै पहले हैं बे आखरी मैं होंगे।”<note caller="+" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्ती 19:30</ref>; <ref loc="MAT 20:16">20:16</ref>; <ref loc="MRK 10:31">मरकुस 10:31</ref> </char></note><verse eid="LUK 13:30" /></para>
  <para style="s">यरूसलेम के ताहीं ईसु को प्यार</para>
  <para style="r">(<ref loc="MAT 13:37-39">मत्ती 13:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />बहे समय कुछ फरीसी ईसु के झोने आए और बासे कहीं, “तोकै हिंयाँ से निकरकै कहूँ और जाने होगो, काहैकि हेरोद तोकै मारनो चाहथै।”<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />ईसु उनकै जबाब दई, “जाएकै बौ लोमड़ी से कहदे, कि देख मैं आज और कल प्रेत आत्मा कै निकर रौ हौं और चंगो कर रहो हौं, और तिसरे रोज अपनो काम पूरो करंगो।” <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />फिर भी मोकै आज और कल और परसौं अपने रहा जानो जरूरी है, काहैकि हुई ना सकथै कि कोई भविस्यवक्ता यरूसलेम के बाहर मारो जाबै।<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />“यरूसलेम! यरूसलेम! तैं भविस्यवक्ता कै मारथै, तैं बे खबरिन कै पथरा मारथै जिनकै परमेस्वर तुमरे ताहीं भेजी है! कित्ती बार मैं चाहो, कि जैसे पक्छी मुर्गिया अपने चूजन कै अपने पखमन के तरे इखट्टो करथै, बैसिये महुँ तेरे बालकन कै इखट्टो करौं, पर तैं मोकै जौ ना करन देथै! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />और जौ बजे से तुमरे मंदिर कै छोड़ दौ जागो, और मैं तुमकै बिस्वास दिलाथौं कि जबले तुम कहगे न कि, ‘आसीसित है बौ जो प्रभु के नाओं से आथै,’ तौले तुम मोकै फिर कहु ना देखैगे।”<note caller="+" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">भजन संहिता 118:26</ref>; <ref loc="JER 12:7">यिर्मयाह 12:7</ref></char></note><verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">ईसु एक बिमार आदमी कै अच्छो करी</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />ईसु एक साबत के रोज फरीसियन के अधिकारी मैं से कोई के घरै खानु खान गौ: और लोग ईसु कै झोने से देखत रहैं। <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />एक आदमी जोके पाँव और हाथ सूज गै रहैं, ईसु के झोने आओ, <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />और ईसु कानून और फरीसियन के सिक्छकन से बात करी और पूँछी, “का हमरे नियम के हिसाब से साबत के रोज अच्छो करन कि इजाजत है या ना है?”<verse eid="LUK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4" />लेकिन बे एक बार कछु न कहीं; ईसु बौ आदमी कै हाथ लगाएकै अच्छो करी, और बाकै बिदा करी। <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />फिर ईसु उनसे कही, “तुम मैं से ऐसो कौन है, अगर तुमरो बालका या बरधा कुआँ मैं गिर जाबै तौ का तुम साबत के रोज बाकै बाहर ना निकारैगे?”<verse eid="LUK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6" />लेकिन उनकै ईसु कै जौ बारे मैं जबाब देन कि हिम्मत ना रहै।<verse eid="LUK 14:6" /></para>
  <para style="s">हितुअन को आदर</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />ईसु देखी कि कैसे कुछ हितुआ अच्छी जघा कै चुन रै हैं, जौ बजे से ईसु बे सबन के ताहीं जौ कहानी बताई: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“जब कोई तोकै बिहा मैं बुलाबै, तौ सबसे अच्छी जघा मैं मत बैठिये; ऐसो भी हुई सकथै कि बौ तोसे भी कोई भौत जरूरी आदमी कै न्युतो दई होबै, <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />और जो तोकै और बाकै दोनों कै न्युतो दई है, बौ आयकै तोसे कहबै, ‘कि जाकै जघा दे,’ तौ तोकै सर्मिंदा होन पड़ैगो और सबसे नीची जघा मैं बैठन पड़ैगो। <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />जाके बदले, जब तोकै बुलाओ जाबै, तौ सबसे नीची जघा मैं बैठ, ताकी तेरे झोने न्युतो देन बारो आबै, तौ तोसे कहबै, ‘मेरे दोस्त, एक अच्छी जघा मैं बैठ,’ तौ तेरे संग बैठन बारेन के सामने तेरी बड़ाँईं और महिमा होगी।<note caller="+" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="PRO 25:6-7">नीतिवचन 25:6-7</ref> </char></note> <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />काहैकि जो कोई अपने आपकै बड़ो बनागो, बौ छोटो करो जागो; और जो कोई अपने आपकै छोटो बनागो, बौ बड़ो करो जागो।”<note caller="+" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">मत्ती 23:12</ref>; <ref loc="LUK 18:14">लूका 18:14</ref></char></note><verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />तौ ईसु अपने न्युतो देनबारे से भी कही, “जब तैं दिन को या रात को हटकना करै, तौ अपने दोस्तन कै या भईय्यन कै या अपने हितुअन कै या अपने सेठ पड़ोसिन कै मत बुलाबै, कहूँ ऐसो ना होबै, कि बेऊँ तोकै न्युतो देमैं, और तेरो बदलो ही जाबै। <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />पर जब तैं हटकना करै, तौ गरीबन कै, अपंगन कै, लंगड़न कै और अंधरन कै बुला; <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />और तैं खुसनसीब हुई जागो, काहैकि उनके पास तोकै बदले मैं देन कै कछु ना है, जो दिन धर्मी लोग जी उठंगे होन लगंगे, परमेस्वर तुमकै बापस प्रतिफल देगो।”<verse eid="LUK 14:14" /></para>
  <para style="s">महान खानु खान कि कहानी</para>
  <para style="r">(<ref loc="MAT 22:1-10">मत्ती 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />जब मेज मैं बैठे भै हितुअन मैं से एक जौ सुनी, तौ बौ ईसु से कही, “बे कितने खुसनसीब हैं, जो परमेस्वर के राज्य मैं खानु खान बैठंगे!”<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />ईसु बासे कही, “एक बार एक आदमी रहै जो एक बड़ो हटकना करी रहै, जोमैं बौ भौत जनी कै हटकि रहै। <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />जब खानु तैयार ही गौ, तौ बौ अपने सेवक के हात जौ बतान के ताहीं पनारी, ‘कि आबौ; सब कछु तैयार है!’ <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />लेकिन बे सबके सब माफी माँगन लगे, पहलो नौकर कही, ‘मैं एक खेत मोल लौ हौं, और जरूरी है कि बाकै देखौं; मैं तोसे पूछथौं, मोकै माफ कर दे।’ <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />दुसरो कही, ‘मैं पाँच जोड़ी बरधा मोल लौ हौं, और उनकै समझन और परखन जाएरौ हौं; मैं तोसे पूछथौं, मोकै माफ कर दे।’ <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />और एक दुसरो कही, ‘मैं कतई-अभई बिहा करो हौं, और जौ बजे से मैं ना आए सकथौं।’ <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />बौ सेवक आयकै अपने प्रभु कै जे बात सुनान लगो। तौ घर को प्रभु गुस्सा मैं आयकै अपने सेवक से कही, ‘नगर के बजारन और गलियन मैं तुरंतै जाएकै कंगालन, टुन्डन, लंगड़न और अंधरन कै हिंयाँ लै आबौ।’ <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />सेवक फिर कही, ‘अरे प्रभु, जैसो तू कहो रहे, बैसिये कहो गौ है; फिर भी जघा है।’ <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />प्रभु सेवक से कही, ‘सड़कन मैं और बेहड़ा के घाँईं जाएकै लोगन कै बरबस लइये आ ताकी मेरो घर भर जाबै। <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />काहैकि मैं तुमसे कहथौं, कि बे आमन्तिरित लोगन मैं से कोईये मेरे भोज कै न चखैगो!’”<verse eid="LUK 14:24" /></para>
  <para style="s">कौन ईसु को चेला हुई सकथै</para>
  <para style="r">(<ref loc="MAT 10:37-38">मत्ती 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />और बड़ी भीड़ बाके संग जात रहे, तौ बौ पच्छू घूमकै उनसे कही। <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“अगर कोई मेरे झोने आबै, और मोकै अपने अईय्या-दऊवा, घरबारी, बालकन, भईय्या-बहेनिया और अपने ज्यान से भी जाधे प्यारो नाय मानै, तौ बौ मेरो चेला नाय ही सकथै; <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />और जो कोई अपनो क्रूस नाय उठाबै; और मेरे पच्छू नाय आबै; तौ बहो मेरो चेला नाय ही सकथै। <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />तुम मैं से कौन है कि गुम्मट बनानो चहात होबै, और अग्गु बैठकै खर्च नाय जोड़ै, कि पूरो करन कि हिम्मत मेरे झोने है कि नाय? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />कहीं ऐसो ना होबै, कि नीव चट्टान के ऊपर डारकै तैयार नाय कर सकै, तौ सब देखन बारे जो भौ है बाको मजाक बनांगे। <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />बे कहमंगे, ‘जौ आदमी बनान तौ लगो, लेकिन बनाये ना पाई।’ <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />या कौन ऐसो राजा है, कि दुसरे से युद्ध करन कै जात होबै, और अग्गु बैठकै बिचार नाय कर लेबै कि जो बीस हजार आदमी लैकै मेरे घाँईं चढ़ो आथै, का मैं दस हजार आदमी लैकै बाको सामना कर सकथौं, कि नाय? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />नाय तौ बाके दूर रहतै खिना कि, बौ खबरेया कै भेजकै सांति से भेंटा करनो चाहबैगो। <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />जहे रीति से तुम मैं से जो कोई अपनो सब कछु त्याग नाय देबै, तौ बौ मेरो चेला नाय ही सकथै।”<verse eid="LUK 14:33" /></para>
  <para style="s">बिना सुआद को नून</para>
  <para style="r">(<ref loc="MAT 5:13">मत्ती 5:13</ref>; <ref loc="MRK 9:50">मरकुस 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />“नून तौ अच्छो है, पर अगर नून को नुनियानपन खतम हुई जाबै, तौ बौ का चीज से नुनियान करो जाबैगो। <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />बौ नाय तौ जमीन के और न खाद के काम मैं आथै: बाकै लोग दुआरे फेंक देथैं। जोके सुनन के कान हैं सुन लेबै।”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">हराई भइ भेंड़</para>
  <para style="r">(<ref loc="MAT 18:12-14">मत्ती 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />एक दिन कई लगान लेन बारे और पापी बाके झोने आए करत रहैं ताकी ईसु की सुनैं। <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />फरीसी और यहूदि नियम के सिक्छक बड़-बड़ान, “जौ तौ पापिन से मिलथै और उनके संग खात भी है।” <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />तौ बौ उनसे जौ कहानी कही:<verse eid="LUK 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4" />“तुम मैं से कौन है जोकी सौ भेंड़ होमैं, और एक हराए जाबै तौ निन्यानवे कै मैदान मैं छोड़कै, बौ हराई भइ कै जब तक मिल नाय जाबै ढूँड़त रहबै? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />और जब मिल जाथै, तौ बड़ा खुस हीकै बाकै कंधा मैं उठाए लेथै। <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />और घरै आयकै दोस्त और परोसियन कै इखट्टो करकै कहथै, ‘मेरे संग खुसी मनाबौ, काहैकि मेरी हराई भइ भेंड़ मिल गई है!’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />मैं तुमसे कहथौं; जहे रीति से एक मन फिरान बारे पापी के बारे मैं भी स्वर्ग मैं इतनी ही खुसी होगी, जितनो की निन्यानवे ऐसे धर्मी के बारे मैं नाय होथै, जिनकै मन बदलन की जरूरत नाय।”<verse eid="LUK 15:7" /></para>
  <para style="s">हराओ भौ सिक्का</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />“या मान लेबौ कि एक घर की एक ऐसी बईय्यर होगी, जोके झोने दस चाँदी के सिक्का होमैं, और उनमैं से एक हराए जाबै; तौ बौ दिया जलाए कै और झाड़ बुड़ार कै जब तक मिल नाय जाबै, मन लगाएकै ढूँड़त नाय रहबै? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />और जब मिल जाथै, तौ बौ अपने दोस्त और परोसियन कै इखट्टो करकै कहथै, कि ‘मेरे संग खुसी मनाबौ, काहैकि मेरो हराओ भौ चाँदी को सिक्का मिलगौ है।’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />जहे रीति से मैं तुमसे कहथौं, कि एक मन बदलन बारे पापी के बजह से परमेस्वर के दूत खुस होथैं।”<verse eid="LUK 15:10" /></para>
  <para style="s">हरानो भौ बेटा</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />ईसु अग्गु कही, “एक आदमी रहै जोके दुई बेटा रहैं। <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />उनमैं से छोटो बारो दऊवा से कही ‘हे दऊवा, दौलत मैं से जो हिस्सा मेरो होबै, बौ मोकै दैदे।’ इसलै बौ आदमी अपनी सम्पत्ति कै अपने दुई बेटा के बीच मैं बाँट दई। <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />और जाधा दिन नाय बीते रहैं कि छोटो बेटा सब कछु इखट्टो करकै एक दुसरे देस कै चलो गौ और हुँआँ कुकर्म की जिंदगी मैं अपनी पूरी सम्पत्ति उड़ाए दई। <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />जब बौ सब कछु खर्च कर चुको, तौ बौ देस मैं बड़ा आकाल पड़ो, और बौ कंगाल ही गौ। <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />और बौ बौ देस के रहन बारेन के हुँआँ गौ, बौ बाकै अपने खेतन मैं सोरा चुगान कै भेजी। <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />और बौ चहात रहै, कि बे फलियन मैं जिनकै सोरा खात रहैं अपनो पेट भरै; काहैकि बाकै कोई कछु नाय देत रहे। <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />आखरी मैं बाकै होस आओ और बौ कही, ‘मेरे दऊवा के कितने मजदूरन के पास जितनो बे खाए सकथैं बासे जाधे है, और हिंयाँ मैं भूंको मर रौ हौं। <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />मैं अब उठकै अपने दऊवा के झोने जामंगो और बासे कहमंगो, हे दऊवा, मैं स्वर्ग और तेरी नजर मैं पाप करो हौं। <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />अब जौ लायक नाय रहो कि तेरो बेटा कहलामौ, मोकै अपने एक मजदूर के हानी रख ले।’”<verse eid="LUK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 15:20" />तौ बौ उठो और अपने दऊवा के झोने बापस चले गौ। “बौ अभै दूरै रहे, कि बाको दऊवा बाके ऊपर दया से भरकै दौड़ो बाकै लगे लगाई, और बड़ा जोड़ चूमी। <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />बेटा बासे कही, ‘दऊवा, मैं स्वर्ग के बिरोध मैं और तेरी नजर मैं पाप करो हौ, और अब जौ लायक नाय रहो कि तेरो बेटा कहलामौ।’ <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />लेकिन दऊवा अपने सेवकन से कही, ‘जल्दी से अच्छो से अच्छो चोंगा निकारकै जाकै पहनाबौ, बाके हाथ मैं अंगूठी, और पाओं मैं जूती पहनाबौ। <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />तौ जाएकै इनाम को बछड़ा ले आबौ और बाकै मार डारौ, और हम एक दावत के संग मनामैं! <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />काहैकि मेरो जौ बेटा मर गौ रहै, फिर जिंदो ही गौ है: जौ हराए गौ रहै, अब मिलगौ है।’ और ऐसे करकै दावत सुरु भइ।”<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />“इतने मैं बाको जेठो लौड़ा खेत मैं रहे। और जब बौ आत भै घर के झोने पहोंचो, तौ बौ गान-बजान और नाचन की अबाज सुनी। <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />तौ बौ एक सेवक कै बुलबाए कै पूँछीं, ‘कि जौ का ही रहो है?’ <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />नौकर जबाब दई, ‘तेरो भईय्या घरै बापस आए गौ है,’ और ‘तेरो दऊवा इनामी बछड़ा कै मार डारी है, काहैकि बौ बाकै सुरक्छित और स्वस्थ पाई है।’ <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />बौ बड़ा गुस्सा से भरगौ और घर के भीतर नाय जानो चाही: पर बाको दऊवा दुआरे आयकै बासे नहोरे करी, की बौ भीतर आबै। <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />पर बौ दऊवा कै जबाब दई, ‘देख; मैं इतने साल से तेरी सेवा कर रहो हौं, और कभी भी तेरो आग्या नाय टालो, फिर तू मोकै आज तक एक बकरिया को बच्चा तक नाय दौ, कि मैं अपने दोस्तनौ के संग खुसी मनामौ! <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />पर जब जौ तेरो बेटा, जो वैसियन मैं अपनी सम्पत्ति उड़ाए दई है, आओ, तौ बाके ताहीं बछड़ा मारकै बड़ो भोज बनबाओ!’ <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />दऊवा बासे कही, ‘बेटा, तू हमेसा मेरे संग है; और जो कछु मेरो है बौ सब तेरो ही है। <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />पर अब खुसी मनानो और खुस रहनो चाहिए काहैकि जौ तेरो भईय्या मर गौ रहे फिर जिंदी हुई गौ है; हराए गौ रहे, अब मिलगौ है।’”<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">चालाँक भंडारी</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />ईसु अपने चेलन से कही, “एक सेठ आदमी के झोने एक नौकर रहै जो बाकी जायदाद को प्रबन्ध करत रहै। सेठ आदमी कै कोई के जरिया बताओ गौ रहै कि भंडारी अपने मालिक को पैसा उड़ाथै, <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />तभईये बौ बाकै भीतर बुलाएकै कहथै, ‘जौ मैं तेरे बारे मैं का सुन रहों हौं? मेरी जायदाद को हिसाब दे, काहैकि अब तू मेरो भंडारी नाय रह सकथै।’ <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />भंडारी सोचन लगो, ‘मेरो मालिक मोकै काम से निकार देगो। अब मैं का करौं? मेरे भीतर इतनी ताकत भी ना है कि मट्टी खोद सकौं, और मोकै तौ भीख माँगन मैं भी सरम आथै। <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />अब मोकै मालुम है कि मोए का करने है! ताकी जब मैं भंडारी के काम से निकारो जामौं, तौ मेरे ऐसे दोस्त होंगे जो मेरे घर मैं मेरो स्वागत करंगे।’ <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />तभई बौ बे सबै लोगन कै बुलबाई जो अपने प्रभु के कर्जा मैं रहैं। बौ पहलो से पूँछी, ‘मेरे मालिक के झोने कित्तो बकाया है?’ <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />बौ जबाब दई, ‘सौ मन जैतून को तेल,’ तौ प्रबंधक बासे कही, ‘बैठ और अपनो खाता-बहे ले और बामै पचास लिख।’ <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />फिरौंकी बौ एक और से पूँछी, ‘और तेरो कित्तो बकाया है?’ बौ जबाब दई, ‘एक हजार बोरी गेंहूँ,’ तौ प्रबंधक बासे कही, ‘अपनो खाता-बहे मैं आठ सौ लिख।’<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />मालिक बौ दुस्ट अधर्मी भंडारी की चतुराई भरी बात सुनकै बाकी बड़ाँईं करी; काहैकि जौ युग के लोग जोती से जुड़ी लोगन की तुलना मैं भौत चालाँक हैं।”<verse eid="LUK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9" />और ईसु उनसे कही, अधर्मी की कमाई दौलत से अपने ताहीं दोस्त बनाबौ, ताकी जब जे दुआरे निकरैं तौ तुमरो अनंत घर मैं तुमरो स्वागत करो जागो। <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />जो छोटी बातन मैं बिस्वास योग्य है, बौ बड़ी बातन मैं भी भरोसेमंद रहगो; जो छोटे-छोटे मामलेन मैं अधर्मी है, बौ बड़े मामलेन मैं अधर्मी होगो। <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />अगर, तुम अधर्मी की दौलत कै संभालन मैं भरोसेमंद नाय हौ, तौ तुमरे ऊपर सच्ची दौलत मैं कैसे भरोसो करो जाबै? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />और अगर तुम पराए की दौलत मैं भरोसेमंद नाय हौ, तौ जो तुमरो है बौ तुम्हैं कौन देगो?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />“कोई भी सेवक दुई प्रभु को सेवक नाय हुई सकथै; काहैकि बौ एक से नफरत दुसरे से प्यार करैगो या मिलो रैहगो और दुसरे से नफरत करैगो। तुम परमेस्वर और दौलत दोनों की सेवा नाय कर सकथौ।”<verse eid="LUK 16:13" /></para>
  <para style="s">ईसु की कुछ बात</para>
  <para style="r">(<ref loc="MAT 11:12">मत्ती 11:12</ref>,<ref loc="MAT 11:13">13</ref>; <ref loc="MAT 5:31">5:31</ref>,<ref loc="MAT 5:32">32</ref>; <ref loc="MRK 10:11">मरकुस 10:11</ref>,<ref loc="MRK 10:12">12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />फरीसी जब जे सब बात सुनी, तौ बे ईसु मसीह ऊपर उल्झ पड़े, काहैकि उन्हैं पैसा से भौत प्यार रहै। <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />ईसु उनसे कहथै, तुम बे हौ जो खुदकै दुसरे लोगन की नजर मैं सई ठहराथौ, लेकिन परमेस्वर तुमरे नफरत भरे मन कै जानथै। और चीज परमेस्वर की नजर मैं खास है, बौ चीज परमेस्वर की नजर मैं कुछ न है।<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />“मूसा के नियम और भविस्यवक्ता के लेख बपतिस्मा देनबारे यूहन्ना के समय ले सरदार रहैं; और तभई से परमेस्वर के राज्य को सुसमाचार सुनाए जाए रहो है, और हर कोई अपने ढंग सेई रहा बनाथै।” <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />लेकिन नियम के छोटे से छोटे विवरड़ कै खतम करन की तुलना मैं स्वर्ग और धरती को गायब होनो आसान है।<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />“जो आदमी अपनी बईय्यर कै तलाक दैकै दुसरी बईय्यर से बिहा करै, बौ व्यभिचार करथै; और जो कोई तलाकसुदा बईय्यर से बिहा करथै बौ भी छिनरइ करथै।”<verse eid="LUK 16:18" /></para>
  <para style="s">सेठ आदमी और लाजर</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />“एक बार एक सेठ आदमी रहै जो बैंजनी लत्ता पहनतो और हर-रोज भौत ठाट से रहतो। <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />और हुँआँ लाजर नाओं को भी एक कंगाल आदमी रहै, जो घाव से ढको रहै, और सेठ आदमी की डेहरी मैं लायकै छोड़ दौ जातो <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />और बौ सेठ आदमी के मेज से गिरे जूठो से पेट भरन की आस मैं रहतो। और हिंयाँ तक कि बाके घाव कै कुत्ता चाटत रहैं।<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />एक दिन ऐसो भौ कंगाल आदमी मर जाथै और स्वर्गदूतन के जरिया स्वर्ग मैं अब्राहम के झोने लै जाओ जाथै। और एक दिन सेठ आदमी भी मर जाथै और बाकै गाड़ो गौ, <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />और बौ नरक मैं, खुदकै बौ भौत दर्द मैं पाथै, जब बौ ऊपर कै देखथै तौ लाजर कै अब्राहम के संग बैठो देखी। <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />तभई बौ चिल्लाए कै कहथै, ‘दऊवा अब्राहम! मेरे ऊपर दया कर, और लाजर कै मेरे झोने पनार दे, ताकी बौ अपनी उँगरिया के पोरा पानी मैं डुबो कै मेरी जीभ कै सांत करै, काहैकि मैं जो आगी मैं दर्द से मरो जाए रहो हौं!’<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />लेकिन अब्राहम कहथै, ‘याद कर, मेरे लौड़ा, तोकै जिंदगी मैं जे सब अच्छी चीज मिल चुकी रहैं, और लाजर कै खराब। लेकिन अब बौ हिंयाँ सांति मैं है, और तैं दर्द मैं है। <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />जे सब बातन कै छोड़, हमरे बीच एक बड़ी गहरी खईया बनी है, ताकी जो लोग तुमरे झोने जानो चाँहे बे नाय जा सकैं, और न हूँना से जौ पार मेरे झोने आए सकथै।’ <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />तभई सेठ आदमी कहथै, ‘मैं तोसे नहोरे करथौं, दऊवा अब्राहम, मेरे दऊवा के घरै लाजर कै पनार दे, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />हूँना मेरे पाँच भईय्या हैं। उनके अग्गु जे सब बात की चितौनी दैकै बाकै पनार दे, ताकी बे जौ दर्द भरी जघा मैं न आमै।’<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />अब्राहम कहथै, ‘तेरे भईय्यन के झोने चितौनी देन ताहीं मूसा और भविस्यवक्ता के कानून हैं; तुमरे भईय्यन कै उनकी बात सुननो चाहिए कि बे का कहथैं।’ <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />तौ सेठ आदमी जबाब देथै, ‘जौ काफी नाय है, दऊवा अब्राहम! लेकिन अगर कोई मौत से उठकै उनके झोने जाबै, तौ बे अपने पापन से मन बदलथै।’ <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />अब्राहम कहथै, ‘जब बे मूसा और भविस्यवक्ता की बात नाय सुनंगे, तौ मौत से जिंदो होन की बात कैसे मानंगे।’”<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">पाप</para>
  <para style="r">(<ref loc="MAT 18:6">मत्ती 18:6</ref>,<ref loc="MAT 18:7">7</ref>,<ref loc="MAT 18:21">21</ref>,<ref loc="MAT 18:22">22</ref>; <ref loc="MRK 9:42">मरकुस 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />ईसु अपने चेलन से कही, “जो बातन से लोग पाप मैं पड़ जाथैं, बौ जरूरै होथैं, लेकिन जो उनकै करथै बाके ताहीं का भयानक है! ईसु अपने चेलन से कही: जिन बातन के कारड़ लोग ठोकर खाथैं, बे जरूरै आथैं, लेकिन जोके जरिया बे आथैं बाके ऊपर हाय। एक दिन ईसु अपने चेलन से कही, पाप के ताहीं परिक्छा हमेसा होत रहमंगी, लेकिन परिक्छा करन बारे कै का दुख होगो! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />जो जे छोटेन मैं से कोई एक कै ठोकर खबाथै, बाके ताहीं जौ भलो होतो कि चक्की को हिस्सा बाके गले मैं लटकाओ जातो, और बाकै समुंदर मैं डार दौ जातो।”<verse eid="LUK 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 17:3" />तौ तुम का करैगे! “अगर तुमरो भईय्या पाप करथै, तौ बाकै झुकाए, और अगर बौ मन बदलथै तौ बाकै माफ कर दे। <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />अगर बौ दिन भर मैं सात बार तेरे खिलाप पाप करै, और हर बार तेरे झोने आयकै कहबै, ‘मैं मन बदल लौ हौं,’ तौ तू बाकै माफ कर दे।”<verse eid="LUK 17:4" /></para>
  <para style="s">बिस्वास</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />प्रेरित प्रभु से कहथैं, “हमरे बिस्वास कै बड़ा।”<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />तौ प्रभु जबाब देथै, “अगर तुम्हैं राया के गूदा के बराबर बिस्वास है, तौ तुम जौ सहतूत के पेंड़ से कहबौ, ‘कि जर से उखड़कै समुंदर मैं लग जाबै!’ तौ बौ तुमरी बात मान लेगो।”<verse eid="LUK 17:6" /></para>
  <para style="s">एक नौकर को काम</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />“मान लियो कि तुम मैं से एक झोने एक सेवक है जो खेत की जुताई या भेंड़न की देख-रेख करथै। जब बौ खेत से आथै, तौ का तुरंतै तुम बासे जौ कहथौ आबौ खानु खान कै बैठौ? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />कतई नाय! जाके उल्टा, तुम जौ कहगे, ‘रात की सेवा के काम के ताहीं तैयारी करौ, और मेरे खान-पीन के पोती मेरो इंतजार करौ; जाके बाद तुम खाए सकथौ।’ <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />का सेवक आग्या कै मानन के ताहीं धन्यवाद को हकदार है? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />तुमरे संग भी ऐसोई होतो, जब तुम बे सब कामन कै कर रहै हौ जोकी आग्या तुमकै दई गई रहै, तौ कहबौ, ‘हम निकम्मे सेवक हैं; कि जो हमैं करनो चाहिए रहै बौ करे हैं।’”<verse eid="LUK 17:10" /></para>
  <para style="s">ईसु दस आदमिन कै अच्छो करी</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />जब ईसु यरूसलेम के घाँईं जानो सुरू करी, तौ बौ सामरिया और गलील की सीमा के किनारे चले गौ। <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />और जब बौ हुँआँ के गाँव से निकरो जात रहै तौ बाको भेंटा दस कोहढ़ी आदमी से भइ। बे थोड़ी दूरी मैं ठाड़े रहैं <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />और हूँनै से चिल्लाईं, “ईसु! गुरुजी! हमरे ऊपर दया कर!”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />ईसु उनकै देखकै उनसे कही, “जाबौ और पुजारी कै अपने आपकै दिखाबौ।” और बे नेंगत-नेंगत कोढ़ से सुद्ध होत चले गै। <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />तभई उनमैं से एक खुदकै देखी कि बौ अच्छो ही गौ है, तौ बौ ऊँची अबाज मैं परमेस्वर की बड़ाँईं करत भै लौटकै आओ। <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />और बौ ईसु के पाओं मैं घुपटियाय कै बाको धन्यवाद करी। और बौ एक सामरी आदमी रहै। <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />ईसु बासे कही, “दस आदमी जो सुद्ध भै रहैं; बाकी नौ कितै गै? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />जौ परदेसी कै छोड़ और कोई नाय है जो परमेस्वर कै धन्यवाद और महिमा देन के ताहीं आओ है?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />और ईसु बासे कहथै, “उठ और जा; तोकै तेरो ही बिस्वास अच्छो करी है।”<verse eid="LUK 17:19" /></para>
  <para style="s">परमेस्वर को राज्य आयरौ है</para>
  <para style="r">(<ref loc="MAT 24:23-28">मत्ती 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />कुछ फरीसी ईसु से पूँछी कि परमेस्वर को राज्य कब आगो। तौ बाको जबाब रहै, “परमेस्वर को राज्य जौ हानी नाय आगो जैसो तुम देख रहे हौ। <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />जौ कोई नाय कहेगो, ‘देखौ, हिंयाँ है!’ या ‘हुँआँ है!’ काहैकि परमेस्वर को राज्य तुमरे बीच मैं है।”<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />फिर बौ चेलन से कही, “बौ समय आगो तभई तुम चाहगे कि इंसान के लौड़ा कै एक दिन देख सकैं, लेकिन तुम बाकै नाय देख पागे। <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />बेईं होंगे जो तुमसे कहंगे, ‘देखौ, हिंयाँ है! या हुँआँ है!’ लेकिन तुम उनके पच्छू मत जईयो।” <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />जैसे आसमान मैं बिजली चमकत है और एक छोर दुसरे छोर उजियारो होथै, बैसिये इंसान को लौड़ा अपने दिनन मैं दिखाई देगो। <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />लेकिन बाके ताहीं जौ जरूरी है, कि बौ भौत दुख उठागो, और जौ दिन के लोग बाकै ठुकरामंगे। <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />जैसो नूह के समय मैं भौ रहै, बैसोई इंसान के लौड़ा के दिनन मैं भी होगो। <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />जो दिन ले नूह जहाज मैं नाय चढ़ो, बौ दिन ले लोग खात-पीत रहैं, और उनमैं बिहा होत रहैं; तभई जल-प्रलय आयकै बे सबन कै नास कर दई। <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />और जैसो लूत के दिनन मैं भौ रहै, कि लोग खाते-पीते, खरीदते-बेंचते, काम करते और घर बनाते। <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />लेकिन जो दिन लूत सदोम देस से निकरो, बौ दिन आगी और गंधक आसमान से बरसी और सबकै नास कर दई। <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />इंसान के लौड़ा के आन के दिनन मैं ऐसेई होगो।<verse eid="LUK 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31" />“बौ दिन जो कोई छत मैं होबै और बाको हानी घर के भीतर होबै, बौ बाकै लेन ताहीं तरे नाय उतरै, और बैसिये जो खेत मैं होमैं बे घरै ना लौटैं। <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />लूत की बईय्यर कै याद करौ! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />जो कोई अपनी ज्यान बचानो चाहगो बौ बाकै खोबैगो; लेकिन जो कोई जिंदगी खोबैगो बौ बाकै बचागो। <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />मैं तुमसे कहथौं, बौ रात दुई लोग एक खटिया मैं सोत होंगे, एक कै लै लौ जागो, और दुसरे कै छोड़ दौ जागो। <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />दुई बईय्यर एक संग चक्की पीसत होंगी, एक कै उठाए लै जागी, और दुसरी कै हूँनै छोड़ दई जागी। <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />दुई आदमी खेत मैं होंगे एक कै उठाए लौ जागो और दुसरे कै छोड़ दौ जागो।”<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />जौ सुनकै चेला बासे पूँछी, “कितै, प्रभु?” ईसु उनकै जबाब दई, “जितै सरीर होगी, हूँनै गिद्धा जुरांगे।”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">बिधवा बईय्यर और न्याई</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />तौ ईसु अपने चेलन कै जौ सिखान के ताहीं एक कहानी बताई कि उनकै हमेसा प्रार्थना करनो चाहिए और कहु निरास ना होनो चाहिए। <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />“कोई सहर मैं एक न्याई रहत रहै बौ ना परमेस्वर से डरात रहै, और नाय कोई आदमिन को आदर करतो। <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />और कोई सहर मैं एक बिधवा बईय्यर भी रहत रहै, जो बाके झोने आयकै कहती मेरो न्याय करकै, ‘मोए दलालन से बचा!’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />कुछ समय ले तौ बौ नाय मानो लेकिन आखरी मैं मन मैं सोच बिचार करकै कही, ‘ना मैं तौ परमेस्वर से डराथौं और ना लोगन को आदर करथौं, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />फिर भी जौ बईय्यर मोए सतात रहथै, तभई मैं जाको न्याय करंगो, कहीं ऐसो नाय होबै कि घड़ी-घड़ी आयकै मोए परेसान कर देबै!’”<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />तौ प्रभु कही, “सुनौ बौ अधर्मी न्याई का कही। <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />का परमेस्वर अपने चुने भै को न्याय करैगो, जो दिन-रात गिड़-गिड़ात रहथैं, और का बौ उनके बारे मैं देर करैगो? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />मैं तुमसे कहथौं, बौ तुरंतै उनको न्याय करैगो। लेकिन इंसान को लौड़ा जब आगो तौ का बौ धरती मैं बिस्वास पाएगो?”<verse eid="LUK 18:8" /></para>
  <para style="s">फरीसी और कर लेन बारे की कहानी</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />और बौ उनसे जो अपने ऊपर भरोसा रखत रहैं, कि हम धर्मी हैं, और दुसरेन कै तुच्छ जानत रहैं, जौ कहानी कही: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />एक बार “दुई आदमी मंदिर मैं प्रार्थना करन कै गै, एक फरीसी रहै और दुसरो लगान लेन बारो।<verse eid="LUK 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 18:11" />फरीसी अपने आप से अलग ठाड़गौ और प्रार्थना करी, ‘मैं तोए धन्यवाद देथौं, परमेस्वर, कि मैं लालची, अधर्मी या व्यभिचारी नाय हौं, जैसो कि सबै कोई करी है। मैं तोए धन्यवाद देथौं कि मैं हूँना बौ लगान लेन बारे के तराहनी नाय हौं। <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />मैं सप्ताह मैं दुई बार बर्त रखथौं, और मैं अपनी कमाई को दसमों भाग भी देथौं।’ <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />लेकिन लगान लेन बारो दूरै से ठाड़कै, स्वर्ग के घाँईं अपनी सकल भी नाय करी, बल्किन अपनी छाती पीट-पीटकै कहथै, ‘परमेस्वर मैं तौ पापी हौं मेरे ऊपर दया कर!’” <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />ईसु कही, मैं तुमसे कहथौं, “कर लेन बारो आदमी ना कि फरीसी परमेस्वर के हिंयाँ जागो। काहैकि जो कोई खुदकै बड़ो बनागो बौ छोटो करो जागो, और जो खुदकै छोटो बनागो बौ बड़ो करो जागो।”<verse eid="LUK 18:14" /></para>
  <para style="s">ईसु एक छोटे बालका कै आसीस देथै</para>
  <para style="r">(<ref loc="MAT 19:13-15">मत्ती 19:13-15</ref>; <ref loc="MRK 10:13-16">मरकुस 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />तौ लोग अपने बालकन कै ईसु के झोने लान लगे कि बौ उनके ऊपर हात धरै। तौ चेला उन्हैं देखकै झुकाईं, <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />लेकिन ईसु बालकन कै झोने मस्काए कै कहथै, “बालकन कै मेरे झोने आन दियौ, और उन्हैं मना मत करौ, काहैकि परमेस्वर को राज्य ऐसियन को है। <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />मैं तुमसे सच्ची मैं कहथौं, कोई भी परमेस्वर को राज्य जे बालकन के हानी नाय अपनागो बौ स्वर्ग के राज्य मैं कहुए घुस नाय पागो।”<verse eid="LUK 18:17" /></para>
  <para style="s">एक सेठ आदमी</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्ती 19:16-30</ref>; <ref loc="MRK 10:17-31">मरकुस 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />एक यहूदिन को अधिकारी ईसु से पूँछथै, “अच्छो गुरुजी, अनंत जिंदगी पान के ताहीं मैं का करौं?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />ईसु बासे कहथै, “तू मोए अच्छो काहे कहथै? कोई अच्छो नाय है, परमेस्वर के अलावा। <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />तू कानून और आग्या कै तौ जानतै है, ‘व्यभिचार मत करीये; हत्या मत करीये, चोरी मत करीये, और अपने अईय्या-बाबा को आदर करीये।’”<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />बौ आदमी जबाब दई, “मैं तौ जे सब आग्या छोटे से मानत आओ हौं।”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />जौ सुनकै ईसु, बासे कहथै, तेरे भीतर अभै भी एक कमी की बात है, “तू अपनो सबै कुछ बेंच कै गरीबन मैं बाँट दे, और तोए स्वर्ग मैं धन मिल जागो, और आयकै मेरे पच्छू हुई ले।” <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />लेकिन जौ सुनकै बौ आदमी को मन दुखी हुई गौ, काहैकि बौ आदमी भौत सेठ रहै।<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />ईसु बाकै दुखी देखकै कही, “सेठ और पैसा बारे आदमी को परमेस्वर के राज्य मैं जानो कठिन है! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />एक ऊँट को सुईं के भार मैं से निकर जानो सहज है लेकिन एक सेठ आदमी को परमेस्वर के राज्य मैं जानो भौत कठिन है।”<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />उनकै सुनन बारे लोग बासे पूँछथैं, “तौ फिर कौनकै बचाओ जाए सकथै?”<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />जो चीज इंसान से नाय हुई सकथै बौ चीज परमेस्वर से हुई सकथै।<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />तभई पतरस कहथै, “देख! हम तौ घर-बार छोड़कै तेरे पच्छू हुई लै हैं।”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />ईसु उनसे कहथै, “हाँ, और मैं तुमसे सच्ची कहथौं, कि जो परमेस्वर के राज्य के ताहीं घर-बार, बईय्यर और अईय्या-दऊवा, भईय्या और बालकन कै परमेस्वर के राज्य के ताहीं छोड़ी हैं, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />बौ जहे समय मैं कई गुना आसीस पागो, और आनबारे समय के युग मैं अनंत जिंदगी।”<verse eid="LUK 18:30" /></para>
  <para style="s">ईसु अपनी मौत के बारे मैं बताथै</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती 20:17-19</ref>; <ref loc="MRK 10:32-34">मरकुस 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />ईसु बारह चेलन कै बाजू मैं लै जाएकै कही, “सुनौ! आपन यरूसलेम कै जांगे, और जित्ती बात इंसान के लौड़ा के ताहीं भविस्यवक्ता के जरिया लिखी गईं हैं बे सबै सच्ची होंगी। <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />बाकै गैर यहूदि कै सौंप दौ जागो, जो बाको मजाक उड़ांगे, बाकी बेजती करंगे और बाके ऊपर थूकंगे। <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />बे बाकै कोड़ा मारंगे और बाकै मार डारंगे, लेकिन बौ तीन दिन बाद जिंदो हुई जागो।”<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />लेकिन चेला जे बातन मैं से कछु नाय समझीं; सब्दन को मतलब उनसे लुको पड़ो रहै, और बे ना जानत रहैं कि ईसु काके बारे मैं बात करत रहै।<verse eid="LUK 18:34" /></para>
  <para style="s">ईसु एक अंधरा भिकमंगा कै अच्छो करी</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्ती 20:29-34</ref>; <ref loc="MRK 10:46-52">मरकुस 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />जब ईसु यरीहो के झोने आए चुको रहै, तौ हुँआँ एक अंधरा आदमी रस्ता मैं बैठकै भीख मांगत रहै। <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />जब बौ झोने से छिरत भइ भीड़ कै सुनी, तौ बौ पूँछी, “जौ का ही रौ है?”<verse eid="LUK 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37" />बे बाकै बताईं, “नासरत को ईसु झोने से छिर रौ है।”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />बौ पुकारी, “ईसु! दाऊद को लौड़ा! मेरे ऊपर दया कर!”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />अग्गु के लोग बाकै झुकाईं और सांत होन के ताहीं कहीं। लेकिन बौ औरौ जोड़न से चिल्लाई, “दाऊद को लौड़ा! मेरे ऊपर दया कर!”<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />इसलै ईसु रुक गौ और बौ अंधरा आदमी कै अपने झोने लान को हुकम दई। जब बौ झोने आओ, तौ ईसु बासे पूँछी, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />तैं मोसे का चाहथै, “मैं तेरे ताहीं का कर सकथौ?” बौ जबाब दई, “प्रभु, मैं फिर से देखनो चाहथौं।”<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />ईसु बासे कही, “तौ देखन लग! तेरो बिस्वास तोकै अच्छो करी है।”<verse eid="LUK 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43" />बौ तुरंतै देखन लागो, और ईसु को अनुसरँड़ करी, और परमेस्वर कै धन्यवाद दई। जब भीड़ जाकै देखी, तौ बेऊँ सब परमेस्वर कि बड़ाँईं करीं।<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">ईसु और जक्कई</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />ईसु यरीहो मैं घुसो और हुँआँ से छिरत रहै। <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />हुँआँ एक मुख्य लगान को अधिकारी रहै, जोको नाओं जक्कई रहै, और बौ सेठ रहै। <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />बौ जौ देखन कि कोसिस करत रहै कि ईसु कौन है, लेकिन बौ एक गंठो आदमी रहै और भीड़ कि बजह से ईसु कै नाय देख सकत रहै। <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />इसलै बौ ईसु कै देखन के ताहीं अग्गु दौड़कै एक गूलर के पेंड़ मैं चढ़गौ, काहैकि ईसु बहे रस्ता से जान बारो रहै। <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />जब ईसु बौ जघा पौहोंचो, तौ ऊपर नजर करकै जक्कई से कही, “जल्दी उतर जक्कई, काहैकि मोकै आज तेरे घर मैं रहने होगो।”<verse eid="LUK 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6" />जक्कई तुरंत उतरो और बाको बड़ा खुसी से स्वागत करी। <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />जाकै देखन बारे सब जनी बड़बड़ात भइ कहेन लागे, “जौ आदमी पापी के घरै हितुआ बनकै गौ है!”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />जक्कई ठाड़कै प्रभु से कही, “सुन, गुरुजी! मैं अपनी आधी सम्पत्ति कंगालन कै दै दुंगो, और अगर मैं कोई कै धोका दैकै कछु लौ हौं, तौ बाकै चौगुना जाधे दुंगो।”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />ईसु बासे कही, “आज जौ घर मैं उद्धार आओ है, इसलै कि जहो भी अब्राहम को लौड़ा है। <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />काहैकि इंसान को लौड़ा खोए भैन कै ढूँड़न और उनकै बचान के ताहीं आओ रहै।”<verse eid="LUK 19:10" /></para>
  <para style="s">सोने के सिक्कन कि कहानी<note caller="+" style="f"><char style="fr" closed="false">19:11 </char><char style="ft" closed="false">दृस्टान्त</char></note></para>
  <para style="r">(<ref loc="MAT 25:14-30">मत्ती 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />जब लोग जौ सुनत रहैं, ईसु जारी रखी और उनकै एक कहानी बताई। बौ अब लमसम यरूसलेम मैं रहै, और बे मानत रहैं कि परमेस्वर को राज्य बस अब दिखन बारो है। <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />तौ ईसु कही, “एक समय एक बड़े पद को आदमी दूर देस कै चलो ताकी राजा बनकै राज्य करन लौट आबै। <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />बाके जान से पहले, बौ अपने सेवकन कै बुलाई और उनकै एक-एक सोने को सिक्का दई और उनसे कही, ‘देखथैं, मेरे जान के बाद तुम जासे का कमाए सकथौ।’ <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />अब बाके अपने लोग बासे नफरत करत रहैं, और बाके पच्छू खबरेया के जरिये कहकै भेजीं, ‘कि हम नाय चाहथैं, कि जौ आदमी हमरो राजा बनै।’”<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />“जब बौ आदमी बापस राजा को राज्य पद लैकै आओ। तौ एक बार बौ अपने सेवकन कै बाके सामने हाजिर होन को हुकम दई, ताकी जौ पता लगाओ जा सकै कि बे कितनो कमाई रहैं। <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />पहलो बारो आयकै कही, ‘प्रभु, तैं जो मोकै दौ रहै, बाके संग मैं दस सोने के सिक्का कमाओ हौं।’ <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />बौ कही, ‘भौत बढ़िया, तैं एक अच्छो सेवक है! काहैकि तैं छोटे-मोटे मामलेन मैं बफादार और भरोसेमंद रहै, इसलै मैं तोकै दस सहरन के अधिकार को वारिस बनांगो।’ <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />दुसरो नौकर आओ और बोली, ‘प्रभु, तैं जो मोकै दौ रहै, बाके संग मैं पाँच सोने के सिक्का कमाओ हौं।’ <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />जाके ताहीं बौ कही, ‘तैं पाँच सहरन को अधिकारी होगो।’ <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />तीसरो नौकर आयकै कही, ‘प्रभु, हिंयाँ तेरो सोने को सिक्का है; मैं बाकै एक रुमाल मैं लुकाएकै रखो रहौं। <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />काहैकि मैं तोसे डरात रहौं, तैं एक कठोर इंसान है। तैं बौ लै लेथै जो तेरो ना है और जो तैं ना बोथै बाकै काटथै।’ <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />बाको मालिक जबाब दई, ‘हे दुस्ट सेवक, मैं तेरिये बचनन से तेरो न्याय करंगो! तैं जानत रहै कि मैं एक सक्त आदमी हौं, जो मेरो ना है बाकै लै लेथौं और जोमैं ना बोथौं बाकै काट लेथौं। <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />अच्छेया, फिर, तैं मेरे पैसा बैंक मैं काहेकै ना डारो? जब मैं लौटतो तौ मोकै ब्याज समेत बापस मिल जातो।’ <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />फिर बौ बे लोगन से कही जो हुँआँ ठाड़े रहैं, ‘सोने को सिक्का बासे लै लेबौ, और बौ नौकर कै दै दियौ जोके पास दस सोने के सिक्का हैं।’ <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />लेकिन बे बासे कहीं, ‘प्रभु, बाके पास पहलेई से दस सिक्का हैं!’ <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />‘मैं तुमकै बताथौं,’ बौ जबाब दई, ‘बे सबन के ताहीं जिनके पास कछु है, उनकै औरौ अगरो दौ जागो; लेकिन जिनके पास कछुए ना है, हिंयाँ ले कि उनके पास जो कछु भी होगो, बहो उनसे छीन लौ जागो। <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />अब, मेरे बे बैरी के ताहीं जो ना चहात रहैं कि मैं उनको राजा बनौ, उनकै हिंयाँ लाबौ और मेरे सामने मार देबौ!’”<verse eid="LUK 19:27" /></para>
  <para style="s">ईसु यरूसलेम मैं राजा के रूप मैं आथै</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="JHN 12:12-19">यूहन्ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />ईसु के जौ सब कहेन के बाद, बौ उनके अग्गु-अग्गु यरूसलेम कै गौ। <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />जब बौ जैतून नाओं कै पहाड़ मैं बैतफगे और बैतनिय्याह के झोने पौहोंचो, तौ बौ अपने चेलन मैं से दुई कै जौ कहकै पनारी <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />“सामने के गाँव मैं जाबौ, जैसेई तुम अंदर जाबैगे, तुम एक गधईया को बच्चा जोके ऊपर कोई कहु सवार ना भौ, भँदो भौ तुमकै मिलैगो, बाकै खोलकै लै आबौ। <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />अगर कोई तुमसे पूँछै कि तुम जाकै काहे खोल रै हौ, तौ बासे कहियो कि प्रभु कै जाकी जरूरत है।”<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />बे अपने रस्ता मैं चले गै और सब कछु बैसो पाईं जैसो ईसु उनकै बताई रहै। <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />जैसो कि बे गधा के बच्चा कै खोलत रहैं, तौ बाको प्रभु उनसे कही, “तुम जाकै काहेकै खोल रै हौ?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />बे जबाब दईं, “प्रभु कै जाकी जरूरत है,” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />बे गधा के बच्चा कै ईसु के झोने लैगै और अपने लत्ता बौ बच्चा के ऊपर डारकै ईसु कै बाके ऊपर चढ़न मैं मदत करीं। <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />जब बौ अग्गु बढ़ो, तौ लोग अपने लत्ता सड़क मैं बिछात जात रहैं।<figure style="fig" alt="Jesus’ Triumphant entry to Jerusalem" file="lb00315c.tif" size="span" copy="Horace Knowles ©" ref="19:36">यरूसलेम मैं ईसु को जीत कै आनो</figure><verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />जब बे यरूसलेम के झोने आए चुके, तौ जो जघा मैं सड़क जैतून पहाड़ के तरे चली गई रहै, जब बे हुँआँ पहुँचे, तौ चेलन कि बड़ा बड़ी भीड़ परमेस्वर को धन्यवाद करन लग्गै और बे सब महान सामर्थी काम के ताहीं जोड़न से स्तुति करीं, जो बे देखी रहैं: <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />“परमेस्वर बौ राजा कै आसीस देबै जो प्रभु के नाओं से आथै! स्वर्ग मैं सांति और परमेस्वर कि महिमा होबै!”<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />तौ भीड़ मैं से कुछ फरीसी ईसु से बात करीं। बे कहीं, “गुरुजी, अपने चेलन कै झुकाए, कि बे सांत रहमैं!”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />ईसु जबाब दई, “मैं तुमसे कहथौं कि अगर बे चुप हुईगै, तौ पथरा खुदै चिल्लान लगंगे।”<verse eid="LUK 19:40" /></para>
  <para style="s">ईसु यरूसलेम के ताहीं रोथै</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />ईसु सहर के झोने आओ, और जब बौ देखी, तौ बौ बाके ऊपर रोए पड़ो, <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />जौ कहत भै, “अगर तुम सिरफ आजै जानते कि सांति के ताहीं का जरूरी है! लेकिन अब तुम जाकै नाय देख सकथौ! <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />समय आगो जब तुमरे बैरी तुमकै घेर लेंगे, तुमरो नाकाबंदी करंगे, और सब घाँईं से तुम बंद हुई जागे। <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />बे तुमकै और तुमरी दिवारन के भीतर के लोगन कै पूरी तरहन से खतम कर देंगे; एकौ पथरा ना होंगे जो बे अपनी जघा मैं छोड़ंगे, काहैकि तुम बौ समय कै नाय पहचान पाए जब परमेस्वर तुमकै बचान कै आओ रहै!”<verse eid="LUK 19:44" /></para>
  <para style="s">ईसु मंदिर जाथै</para>
  <para style="r">(<ref loc="MAT 21:12-17">मत्ती 21:12-17</ref>; <ref loc="MRK 11:15-19">मरकुस 11:15-19</ref>; <ref loc="JHN 2:13-22">यूहन्ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />तौ ईसु मंदिर मैं गौ और ब्यापारियन कै भजान लगो, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />उनसे कहरौ है, “जौ सास्त्र मैं लिखो है कि परमेस्वर कही है, ‘मेरो मंदिर परमेस्वर के घर प्रार्थना को घर होगो।’ लेकिन तुम जाकै चुट्टन के ठिकाना मैं बदल दै हौ!”<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />हर दिन ईसु मंदिर मैं सिक्छा देत रहै। बड़ो पुजारी, यहूदि नियम के सिक्छक और लोगन के नेता बाकै मारनो चहात रहैं, <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />लेकिन उनकै ऐसो करन को कोई तरीका ना मिलो, काहैकि सब जनी बाकै सुने करत रहैं, और कोई भी बाकी बात कै छोड़नो ना चहात रहैं।<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">ईसु के अधिकार के बारे मैं सवाल</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्ती 21:23-27</ref>; <ref loc="MRK 11:27-33">मरकुस 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />एक दिन जब ईसु मंदिर मैं लोगन कै सिखात रहै और सुसमाचार सुनात रहै, तौ बड़ो पुजारी और यहूदि नियम के सिक्छक, बड़े-बूढ़ेन के संग, आयकै ठाड़गै <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />और बासे कहीं, “हमकै जौ बता, तोकै जे सब करन को का अधिकार है? तोकै जो अधिकार कौन दौ है?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />ईसु उनकै जबाब दई, “अब महुँ कै एक सवाल पूँछने है। मोकै बताबौ, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />का यूहन्ना कै बपतिस्मा देन को अधिकार स्वर्ग से रहै या इंसानन से रहै?”<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />बे आपस मैं बहस करन लगे, “हम का कहंगे? अगर हम कहथैं, ‘कि स्वर्ग के घाँईं से,’ तौ बौ कहेगो, ‘तौ तुम यूहन्ना के ऊपर बिस्वास काहेकै ना करे?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />लेकिन अगर हम कहंगे, ‘इंसानन से,’ तौ हिंयाँ पूरी भीड़ हमकै पथरा मारेगी, काहैकि उनकै भरोसा है कि यूहन्ना एक भविस्यवक्ता रहै।” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />तौ बे जबाब दई, “हम ना जानथैं कि बौ कहाँ से आओ है।”<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />और ईसु उनसे कही, “तौ मैं भी तुमकै ना बतांगो कि मैं जे काम कौन से अधिकार से करथौं।”<verse eid="LUK 20:8" /></para>
  <para style="s">अंगूर की बारी मैं किसानन कि कहानी</para>
  <para style="r">(<ref loc="MAT 21:33-46">मत्ती 21:33-46</ref>; <ref loc="MRK 12:1-12">मरकुस 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />तौ ईसु लोगन कै जौ कहानी बताई: “एक बार एक आदमी रहै जो अंगूर की बारी लगाई रहै, और किसानन कै दै दई, और फिर लंबे समय तक घर छोड़ दई। <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />जब दाखन कै इखट्टो करन को समय आओ, तौ बौ किसानन के झोने एक सेवक कै पनारी, कि बे अंगूर की बारी मैं से मेरो थोड़ी हिस्सा देमैं, लेकिन किसान बाकै पीटीं और बाकै खाली हात बापस पनार दई। <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />इसलै बौ एक और सेवक कै पनारी; लेकिन किसान बहो कै पीटीं, बाके संग सर्मनाक व्यवहार करीं, और बाकै खाली हात बापस पनार दईं। <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />फिर बौ तीसरे नौकर कै पनारी; किसान बहो कै घायल कर दईं, और बाकै बाहर फेंक दईं। <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />तौ अंगूर की बारी को प्रभु कहीं, ‘मैं का करौं? मैं अपने प्रिय लौड़ा कै भेजंगो; बे पक्का बाको आदर करंगे!’ <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />लेकिन जब किसान बाकै देखीं, तौ बे एक दूसरे से कहीं, ‘जौ मालिक को लौड़ा है। चलौ बाकै मार डारैं, और बाकी जायदाद हमारी हुई जागी!’”<verse eid="LUK 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 20:15" />इसलै बे बाकै अंगूर की बारी से बाहर निकारकै मारडारीं। फिर ईसु पूँछी, “अंगूर की बारी को प्रभु बे किसानन के संग का करैगो?” <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />“बौ आयकै बे लोगन कै मार देगो, और अंगूर की बारी कै दुसरे किसानन कै सौंप देगो।” जब लोग जौ सुनीं, तौ बे कहीं, “सच मैं नाय!”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />ईसु उनके घाँईं देखी और पूँछी, “का, तौ, जौ सास्त्र को मतलब है?</para>
  <para style="q1" vid="LUK 20:17">‘जो पथरा कै राजमिस्त्री ठुकराई रहैं</para>
  <para style="q2" vid="LUK 20:17">बहे सबन के ताहीं सबसे जरूरी निकरो।’<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />जो कोई बौ पथरा मैं गिरैगो बौ चकनाचूर हुई जागो; और अगर बौ पथरा कोई के ऊपर गिरैगो, तौ बौ बाकै धूदर मैं कुचल देगो।”<verse eid="LUK 20:18" /></para>
  <para style="s">लगान देन मैं सवाल</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्ती 22:15-22</ref>; <ref loc="MRK 12:13-17">मरकुस 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />यहूदि नियम के सिक्छक और बड़ो पुजारी ईसु कै मौका मैं गिरफ्तार करन कि कोसिस करीं, काहैकि बे जानत रहैं कि बौ उनके खिलाप जौ कहानी बताई है; लेकिन बे लोगन से डरात रहैं। <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />इसलै बे मौका कि तलास करीं। बे कुछ लोगन कै धर्मी, इमानदार बनन को दिखावा करन के ताहीं रिस्वत दईं, और बे उनकै ईसु कै सवालन के संग फसान के ताहीं पनारीं, ताकी बे बाकै रोमन सासक के अधिकार से और सक्ति कै सौंप सकैं। <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />जे जासूस ईसु से कहीं, “गुरुजी, हम जानथैं कि तैं जो कहथै और सिखाथै बौ ठीक है। हम जानथैं कि तैं कोई कि हालत मैं ध्यान ना देथै, लेकिन लोगन के परमेस्वर कि इच्छा के बारे मैं सच्चाई से सिखाथै। <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />हमकै बता, का हमकै रोमन सम्राट कैसर कै लगान देनो नियम के हिसाब से बाके खिलाप है, या नाय?”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />लेकिन ईसु उनकी चाल कै देखी और उनसे कही, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“मोकै एक चाँदी को सिक्का दिखाबौ। जामैं कौन को छाप और नाओं है?” बे जबाब दई, “सम्राट कैसर को।”<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />तौ ईसु कही, “ठीक है, सम्राट कैसर को भुगतान करैं जो सम्राट कैसर को है, और परमेस्वर को भुगतान करैं जो परमेस्वर को है।”<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />हुँआँ बे लोगन के सामने बौ बात कै पकड़ ना पाईं, इसलै बाके जबाब से अचम्मे हुईकै चुप रहगै।<verse eid="LUK 20:26" /></para>
  <para style="s">मौत से उठन के बारे मैं सवाल</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्ती 22:23-33</ref>; <ref loc="MRK 12:18-27">मरकुस 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />फिर कुछ सदूकी, जो कहथैं, कि लोग मरकै नाय जी उठंगे, ईसु के झोने आयकै कहीं, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />“गुरुजी, मूसा हमरे ताहीं जौ कानून लिखी है, ‘अगर कोई आदमी मर जाबै और अपनी बईय्यर कै छोड़ जाबै, लेकिन बाकी कोई औलाद ना होबै, तौ आदमी के भईय्या कै बौ बिधवा के संग बिहा कर लेनो चाहिए ताकी उनके बालका हुई सकैं जिनकै मरे भै आदमी के बालका मानो जागो।’ <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />एक बार सात ददा-भईय्या रहैं; सबसे बड़े को बिहा हुई गौ और बिना बालका भै बाकी मौत हुई गई। <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />फिर दुसरो बौ बईय्यर से बिहा करी, <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />और फिर तीसरो। सबै सात ददा-भईय्यन के संग एकै बात भइ, बे बालका पैदा करे बिना मर गै। <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />आखिरकार, बौ बईय्यर कि मौत हुई गई। <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />अब, जो रोज मरे भै जिंदे जी उठंगे, तौ बौ कौन कि बईय्यर होगी, काहैकि बे सातौ बाके संग बिहा करी रहैं।”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />ईसु उनकै जबाब दई, “जौ युग मैं आदमी और बईंय्यरैं बिहा करथैं, <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />लेकिन बे आदमी और बईंय्यरैं जो मौत से जिंदे जी उठन और आनबारी जग के युग मैं जीन के काबिल हैं फिर उनमैं बिहा ना होगो। <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />बे स्वर्गदूतन के हानी होंगे और मर नाय सकथैं। बे परमेस्वर के बालका है, काहैकि बे मौत से जी उठे हैं। <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />और मूसा साफ तरीका से साबित करथै कि मरे भैन कै जी उठन ताहीं उठाओ जाथै। जलत भइ झाड़ी के बारे मैं रहामैं बौ प्रभु कै ‘अब्राहम को परमेस्वर, इसहाक को परमेस्वर, और याकूब को परमेस्वर कहथै।’ <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />बौ जिंदो परमेस्वर है, मरे भै को नाय, काहैकि बाके ताहीं सब जिंदे हैं।”<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />तौ जौ सुनकै कुछ यहूदि नियम के सिक्छक कहीं, “गुरुजी, तैं अच्छो जबाब दौ!” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />और उनकै बासे फिर कछु और पूँछन कि हिम्मत न भइ।<verse eid="LUK 20:40" /></para>
  <para style="s">मसीहा के बारे मैं सबाल</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्ती 22:41-46</ref>; <ref loc="MRK 12:35-37">मरकुस 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />ईसु उनसे पूँछी, “जौ कैसे कहो जाए सकथै कि मसीह दाऊद को बंसज होगो? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />काहैकि दाऊद खुद भजन संहिता कि किताब मैं कहथै,</para>
  <para style="q1" vid="LUK 20:42">‘प्रभु मेरे प्रभु से कही:</para>
  <para style="q2" vid="LUK 20:42">मेरे झोने दाँए घाँईं बैठ<verse eid="LUK 20:42" /></para>
  <para style="q2">
    <verse number="43" style="v" sid="LUK 20:43" />जब तक मैं तेरे बैरियन कै तेरे पाँव के तरे कि चौकी न कर देयौं।’<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />दाऊद तौ बाकै ‘प्रभु’ कहथै; तौ फिर, मसीहा दाऊद को बंसज कैसे हुई सकथै?”<verse eid="LUK 20:44" /></para>
  <para style="s">ईसु नियम के सिक्छन के चितौनी दई है</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="MRK 12:38-40">मरकुस 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />जैसो कि सब जनी ईसु की बात सुनत रहैं, तभई बौ अपने चेलन से कही, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“यहूदि नियम के सिक्छकन से सावधान रहबौ, जिनकै लम्बे-लम्बे चोंगा पहने भै फिरनो अच्छो लगथै, और जिनकै बजार मैं सम्मान के संग नमस्ते, और सभाघरन मैं अच्छी जघा और हटकना मैं अच्छी से अच्छी जघा प्रिय लगथै; <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />जो बिधवन को फायदा उठाथैं और उनके घरन कै लूटथैं, फिर दिखान के ताहीं बड़ा देर ले प्रार्थना करथैं! उनको न्याय भौत खराब होगो!”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">बिधवा को दान</para>
  <para style="r">(<ref loc="MRK 12:41-44">मरकुस 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />फिर ईसु नजर उठाएकै देखी और सेठन कै अपनो-अपनो दान मंदिर के दान पेटी मैं डारत भइ देखी, <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />और बौ एक गजब गरीब बिधवा कै भी दुई ताँबे के छोटे सिक्का कै डारत भै देखी। <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />तौ बौ कही, “मैं तुमकै सच बताथौं कि जौ गरीब बिधवा सबन से अगरो डारी है। <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />काहैकि बे दूसरे सब अपनी-अपनी सम्पत्ति मैं से दान मैं कुछ डारी हैं, लेकिन बौ गरीब है, और बौ सब कछु दै दई जोसे बाकै रहने रहै।”<verse eid="LUK 21:4" /></para>
  <para style="s">ईसु मंदिर के बिनास कि बात करथै</para>
  <para style="r">(<ref loc="MAT 24:1-2">मत्ती 24:1-2</ref>; <ref loc="MRK 13:1-2">मरकुस 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />एकाद चेला मंदिर के बारे मैं बात करत रहैं, कि बौ सुगड़ पथरन और परमेस्वर कै चढ़ाय गै दान से कितनो सुगड़ लग रौ है। लेकिन ईसु उनकै कही, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“जौ सब जो तुम देखरै हौ, बौ समय आगो जब हिंयाँ एकौ पथरा अपनी जघा मैं ना छोड़ो जागो; हर एक कै नीचे फेंक दौ जागो।”<verse eid="LUK 21:6" /></para>
  <para style="s">मुसीबत और अत्याचार</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्ती 24:3-14</ref>; <ref loc="MRK 13:3-13">मरकुस 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />बे पूँछीं, “गुरुजी, जौ कब होगो? जे बातैं जब होन बारी होंगी, और जब जे बातैं पूरी होमंगी तौ बौ समय को का चिन्ह होगो?”<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />ईसु कही, “पहरा मैं रहबौ; धोका मत खाबौ। भौत से मेरे नाओं से आयकै कहंगे, ‘कि मैं बहे हौं!’ और जहो भी, ‘कि समय झोने आए चुको है!’ लेकिन तुम उनके पच्छू मत जईयो। <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />जब तुम लड़ाई और क्रांति के बारे मैं सुनथौ तौ डराबौ मत; ऐसी चीजैं होनो जरूरी है, लेकिन उनको मतलब जौ ना है कि अंत झोने है।”<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />तौ बौ कही, “देस आपस मैं लड़ंगे; राज्य एक दुसरे के ऊपर हमला करंगे। <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />हर जघा भयानक भूकंप, आकाल और आफत आमंगी; आसमान से बड़े-बड़े चिन्ह दिखाई देंगे। <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />जे सब बातन से पहले बे मेरे नाओं के बजह से तुमकै पकड़ंगे, और सतांगे, तुम सभाघरन मैं परखे जान के ताहीं सौंपे जागे; तुमकै कैदखाना मैं डार देंगे; और तुमकै मेरी बजह से राजाओं और सासकन के सामने लाओ जागो। <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />पर जौ तुमरे ताहीं सुसमाचार की गभाई देन को मौका होगो। <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />पहलेई से अपने मन मैं चिंता मत करियो कि तुम कैसे करकै अपनी रक्छा करैगे, <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />काहैकि मैं तुमकै ऐसो बोल और बुद्धि दुंगो, कि तुमरो कोई भी दुस्मन तुमरे कहे को खंडन या बिरोध नाय कर पागो। <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />तुमरे अईय्या-दऊवा, भईय्या, हितुआ और तुमरे दोस्तन के जरिया तुमकै सौंप दौ जागो; और तुम्मैं से कितने कै मौत के घाट उतार दौ जागो। <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />मेरे नाओं की बजह से तुमकै भौत नफरत मिलैगी। <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />लेकिन तुमरी मुड़िया से एक बार भी बाँका ना होगो। <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />धीरज धरौ, और तुम अपने आपकै बचाए लेगे।<verse eid="LUK 21:19" /></para>
  <para style="s">ईसु यरूसलेम के नास के बारे मैं बात करथै</para>
  <para style="r">(<ref loc="MAT 24:15-21">मत्ती 24:15-21</ref>; <ref loc="MRK 13:14-19">मरकुस 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />जब तुम यरूसलेम कै सेना से घिरो भौ देखौ, तौ तुम जान लियो कि बौ जल्दिये उजड़ जागो। <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />फिरौंकी जो लोग यहूदिया मैं हैं उनकै पहाड़ियन के घाँईं भाजनो चाहिए; जो लोग सहर मैं हैं उनकै छोड़ने होगो, और जो लोग देस से बाहर हैं उनकै सहर मैं ना जानो चाहिए। <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />काहैकि बे ‘न्याय के दिन’ होंगे, जो पवित्र सास्त्र मैं कही गई बातन कै सच करन के ताहीं होंगे। <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />बे बईंय्यरन के ताहीं जो पेट से होंगी और छोटे बालकन कि अईय्या होंगी उनके ताहीं कितनो भयानक होगो! जौ धरती मैं भयानक आफत आगी, और परमेस्वर कि सजा जे लोगन के ऊपर पड़ैगी। <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />कुछन कै तलवार से मार दौ जागो, और दुसरेन कै सबै देसन मैं कैदियन के हानी लैजाओ जागो; और जब तक गैर यहूदि को समय पूरो ना होगो तौले बे यरूसलेम के ऊपर रहंगे।<verse eid="LUK 21:24" /></para>
  <para style="s">इंसान को लौड़ा</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्ती 24:29-31</ref>; <ref loc="MRK 13:24-27">मरकुस 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />सूरज, चंद्रमा और तारेन मैं चिन्ह दिखाई देंगे। धरती और पूरे देस निरासा मैं होंगे, समुंदर कि गरजन और ऊँची लहरन से डरांगे। <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />लोग डर के मारे बेहोस हुई जांगे काहैकि बे असियाय रै हैं कि पूरी दुनिया मैं का ही रौ है, काहैकि आसमान मैं रहन बारी सामर्थी काम की सक्ति हिलाई जांगी। <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />तौ बे इंसान के लौड़ा कै सामर्थ्य और महिमा के संग बादर मैं आत भइ देखंगे। <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />जब जे चीज होन लगैं, तौ ठाड़कै अपनी मुड़िया कै ऊपर उठईयो, काहैकि तुमरो उद्धार और छुटकारा झोने होगो।”<verse eid="LUK 21:28" /></para>
  <para style="s">अंजीर के पेंड़ को पाठ</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्ती 24:32-35</ref>; <ref loc="MRK 13:28-31">मरकुस 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />तौ ईसु उनकै जो कहानी बताई: “अंजीर के पेंड़ और दूसरे सबै पेंड़न के बारे मैं सोचौ। <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />जब तुम देखथौ कि उनके पत्ता दिखाई देन लगे हैं, तौ तुम जान जाथौ कि गर्मी झोने आए चुकी है। <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />बैसिये, जब तुम जे चीजन कै होत भइ देखैगे, तौ तुम जान जागे कि परमेस्वर को राज्य आनबारो है।”<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />“मैं तुमसे सच्ची मैं कहथौं कि जे सब चीजैं लोगन के सामने होंगी, जहाँ अभै सब जिंदे हैं। <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />स्वर्ग और पृथ्वी टल जागी, लेकिन मेरी बात कहु ना टलैगी।”<verse eid="LUK 21:33" /></para>
  <para style="s">चहाचीते रहबौ</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />“तुम चहाचीते रहबौ! अपने आपकै भौत जाधा दावत और पीन के सामान संग और जौ दुनिया की बात कै मन मैं चिंता के संग कब्जा मत करन दियौ, या बौ दिन अनकाचीति तुमकै पकड़ लेबै। <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />काहैकि जौ जार के तराहनी धरती मैं हर जघा सबै लोगन के ऊपर आए पड़ैगो। <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />चहाचीते रहाबौ और हमेसा प्रार्थना करत रहबौ कि तुम जे सब आनबारी घटनन से सई सलामत निकरन, और इंसान के लौड़ा के सामने ठाड़न की सक्ति मिलै।”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />ईसु बे दिनन मंदिर मैं उपदेस देत भइ बिताई, और जब संजा होती, तौ बौ बाहर निकर जातो और रात जैतून नाओं के पहाड़ मैं बितातो। <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />रोजाना सुबेरे सब जनी मंदिर मैं बाकी बात सुनन कै जाए करत रहैं।<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">ईसु के खिलाप साजिस</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती 26:1-5</ref>; <ref loc="MRK 14:1-2">मरकुस 14:1-2</ref>; <ref loc="JHN 11:45-53">यूहन्ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />बौ समय अखमीरी रोटी को त्योहार जो फसह कहो जाथै, झोने रहै। <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />बड़ो पुजारी और यहूदि नियम के सिक्छक कोई बीच से ईसु कै चुपके से मौत के घाट उतारन कि कोसिस करत रहैं, पर बे लोगन से डरात रहैं।<verse eid="LUK 22:2" /></para>
  <para style="s">यहूदा इस्करियोती ईसु कै धोका देन के ताहीं तैयार ही गौ</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्ती 26:14-16</ref>; <ref loc="MRK 14:10-11">मरकुस 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />तौ सैतान यहूदा के अंदर घुस गौ, जोकै इस्करियोती कहो जात रहै, और बौ बारह चेलन मैं से एक रहै। <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />तौ यहूदा जाएकै बड़े पुजारी और मंदिर के पहरेदारन से कही, कि बौ ईसु कै उनके हाथ कैसे पकड़वाए सकथै। <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />बे खुस हुईगै और बाकै पैसा देन को वादा करीं। <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />यहूदा जाके ताहीं राजी ही गौ और ईसु कै जानन बारे लोगन कै बिना पता चलाय उनकै सौंपन को एक अच्छो मौका ढूँड़न लगो।<verse eid="LUK 22:6" /></para>
  <para style="s">ईसु फसह के खानु कै तैयार करथै</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्ती 26:17-25</ref>; <ref loc="MRK 14:12-21">मरकुस 14:12-21</ref>; <ref loc="JHN 13:21-30">यूहन्ना 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />बौ दिन अखमीरी रोटी के त्योहार के समय आओ जब फसह के खानु के ताहीं भेंड़ के बच्चा कै बलिदान हुई जाने रहैं। <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />ईसु पतरस और यूहन्ना कै जौ कहकै भेजी, “कि जाबौ और फसह को खानु हमरे खान के ताहीं तैयार करौ।”<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />बे बासे पूँछीं, “तैं कहाँ चाहथै, कि हम जाकै तैयार करैं?”<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />ईसु जबाब दई, “जब तुम सहर मैं जागे, तौ एक आदमी तुमकै पानी को एक घल्ला लै मिल जागो। जो घर मैं बौ जाबै तुम बाके पच्छू चले जईयो, <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />और बौ घर के मालिक से कहियो, ‘गुरु तोसे कहथै, कि बौ कमरा कहाँ है जहाँ मैं और मेरे चेला फसह को खानु खांगे?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />बौ तुमकै एक बड़ी सजी-सजाई कुठरिया दिखागो, जहाँ तुमकै सब कछु तैयार मिलैगो।”<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />बे चले गै, और बे सब कछु बैसिये पाईं जैसी ईसु उनसे कही रहै, और बे फसह को खानु तैयार करीं।<verse eid="LUK 22:13" /></para>
  <para style="s">प्रभु भोज</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्ती 26:26-30</ref>; <ref loc="MRK 14:22-26">मरकुस 14:22-26</ref>; <ref loc="1CO 11:23-25">1 कुरिन्थियों 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />जब समय आओ, तौ ईसु प्रेरितन के संग खानु खान कै मेज मैं अपनी जघा बैठो। <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />ईसु उनसे कही, “मैं चहात रहौं, कि मैं दुख भोगन से पहले जौ फसह को खानु तुमरे संग खामौं! <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />काहैकि मैं तुमकै बताथौं, मैं जाकै तौले ना खामंगो, जब तक कि परमेस्वर के राज्य मैं जाको पूरो मतलब ना दौ जागो।”<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />तौ ईसु एक प्यालो लई, और परमेस्वर को धन्यवाद दई, और कही, “जाकै लियौ और आपस मैं बाँट लेबौ। <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />मैं तुमसे कहथौं, कि जब तक परमेस्वर को राज्य ना आगो तब तक मैं जौ दाखरस कै ना पींगो।”<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />फिर ईसु रोटी को एक टुकड़ा लई, और परमेस्वर कै धन्यवाद दई, बाकै तोड़ी, और जौ कहत भइ उनकै दै दई, “जौ मेरी सरीर है, जो तुमरे ताहीं दई गई है। जौ मोकै याद करन के ताहीं करे करियो।” <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />बैसिये, बौ उनकै खानु खान के बाद प्यालो जौ कहकै दई, “जौ प्यालो परमेस्वर कि नई वाचा है जोके ऊपर मेरे बौ खून से मुहर लगाई गई है, जो तुमरे ताहीं बहाओ जाथै।”<verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />“लेकिन देखौ! जो मोकै धोका देगो बौ हिंयाँ मेरे संग मेज मैं बैठो है! <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />इंसान को लौड़ा मर जागो जैसो कि परमेस्वर ठानी है, लेकिन बौ आदमी के ताहीं कितनो भयानक होगो जो बाके संग विस्वासघात करथै!”<verse eid="LUK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23" />फिर बे आपस मैं पूँछन लगे कि उनमैं से कौन ऐसो हुई सकथै जो ऐसो करन बारो है।<verse eid="LUK 22:23" /></para>
  <para style="s">महानता के बारे मैं तर्क</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />चेलन मैं एक बहस छिड़ गई कि उनमैं से कौन सबसे बड़ो और महान मानो जानो चाहिए।<note caller="+" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">मत्ती 18:1</ref>; <ref loc="MRK 9:34">मरकुस 9:34</ref>; <ref loc="LUK 9:46">लूका 9:46</ref> </char></note> <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />ईसु उनसे कही, “गैर यहूदि के राजा को अपने लोगन के ऊपर अधिकार है, और सासक ‘लोगन के दोस्त’ उपाधि को दाबा करथैं।” <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />लेकिन जौ तुमरे संग ऐसो ना है; बल्कि, तुमरे बीच को सबसे बड़ो आदमी सबसे छोटो होनो चाहिए, और नेता कै सेवा करन बारे सेवक के हानी होनो चाहिए।<note caller="+" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती 23:11</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref> </char></note> <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />कौन बड़ो है, जो खान के ताहीं बैठो है या जो सेवा करथै? जरूर बौ जो नीचे बैठथै। लेकिन मैं तुमरे बीच मैं हौं जो सेवा करथै।<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />“तुम मेरी सबै परिक्छन मैं मेरे संग रहे; <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />और जैसे मेरो दऊवा मोकै राज्य करन को अधिकार दई है, बैसिये महुँ तुमकै बहे अधिकार दुंगो। <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />तुम मेरे राज्य मैं मेरी मेज मैं खागे पीगे, और तुम इस्राएल के बारह गोत्रन के ऊपर राज करन के ताहीं सिंहासन मैं बैठैगो।”<verse eid="LUK 22:30" /></para>
  <para style="s">ईसु पतरस के इंकार करन कि भविस्यवाँड़ी करी</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="JHN 13:36-38">यूहन्ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />“सिमौन, सिमौन! बात सुन! सैतान तुम सबन कि परिक्छा लेन की, अच्छाई कै बुराई से अलग करन के ताहीं इजाजत लै लई है, जैसे एक किसान गेंहूँ कै भूसा से अलग करथै। <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />लेकिन हे सिमौन, मैं तेरे ताहीं प्रार्थना करो हौं, कि तेरो बिस्वास कम ना होबै। और जब तैं मेरे पास लौटेगो, तौ तोकै अपने भईय्यन कै मजबूत करने होगो।”<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />पतरस जबाब दई, “प्रभु, मैं तेरे संग कैदखाना जान और तेरे संग मरन के ताहीं तैयार हौं!”<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />ईसु कही, “मैं तोसे कहथौं, पतरस, जब तक तैं तीन बार ना कहगो कि तैं मोकै ना जानथै, तौले मुर्गा आज रात ना बासैगो।”<verse eid="LUK 22:34" /></para>
  <para style="s">बटुआ, थैला, और तलवार</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />फिर ईसु अपने चेलन से पूँछी, “जब मैं तुमकै बटुआ, झोला, और जूतन के बिना भेजो रहौं, तौ का तुमकै कछु चीज कि कमी भइ रहै।”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />ईसु उनसे कही, “लेकिन अब, जोके पास कोई बटुआ या झोला होबै बौ लेबै; और जोके पास तलवार ना है, बाकै अपनो कोट बेचकै एक खरीदने होगो। <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />काहैकि मैं तुमसे कहथौं कि जो व्यवस्था की किताब मैं लिखो है, ‘बौ अपराधिन के संग गिनो गौ,’ मेरे बारे मैं सच होनो चाहिए, काहैकि मेरे बारे मैं जो लिखो गौ रहै बौ सच हुई रौ है।”<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />चेला कहीं, “प्रभु देख! हिंयाँ दुई तलवार हैं!”</para>
  <para style="p" vid="LUK 22:38">बौ जबाब दई, “जे काफी हैं!”<verse eid="LUK 22:38" /></para>
  <para style="s">ईसु जैतून के पहाड़ मैं प्रार्थना करथै</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्ती 26:36-46</ref>; <ref loc="MRK 14:32-42">मरकुस 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />ईसु सहर छोड़ दई और जैतून के पहाड़ मैं चले गौ, जैसो कि बौ आमतौर मैं करत रहै, और चेला बाके संग गै। <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />जब बे बौ जघा मैं पौहोंचे, तौ ईसु उनसे कही, “प्रार्थना करौ कि तुम परिक्छा मैं ना पड़ौ।”<verse eid="LUK 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41" />फिर ईसु एक पथरा फेंकन भरे कि दूरी मैं चले गौ और घूँटे टेक कै प्रार्थना करन लगो। <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />ईसु कही, “दऊवा, अगर तैं चाहबै तौ जौ दुख के प्यालो कै मोसे दूर लै जा। फिर भी मेरी इच्छा ना, लेकिन तेरी इच्छा पूरी होबै।” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />तौ स्वर्ग को एक दूत बाकै दिखाई दई और बाकै ताकत दई। <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />बौ बड़ा दर्द मैं और भी जोस के संग प्रार्थना करी; बाको पसीना जमीन मैं मानौ खून कि बूंद के हानी गिरत रहै।<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />अपनी प्रार्थना से उठकै, बौ चेलन के झोने बापस गौ और उन्हैं उनके दुख से थके भै पाई। <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />ईसु उनसे कही, “तुम सोए काहे रै हौ? उठौ और प्रार्थना करौ कि तुम परिक्छा मैं ना पड़ौ।”<verse eid="LUK 22:46" /></para>
  <para style="s">ईसु कि गिरफ्तारी</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="JHN 18:3-11">यूहन्ना 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />ईसु अभै बोलतै रहै की जबले यहूदा के पच्छू-पच्छू एक भीड़ आई, जो बारह चेलन मैं से एक रहै। बौ ईसु कै चूमन के ताहीं ईसु के झोने आओ। <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />लेकिन ईसु कही, “यहूदा, का तैं चूमकै इंसान के लौड़ा कै पकड़वाए रौ है?”<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />जब ईसु के संग गै भै चेला जौ सब देखीं कि का होन बारो है, तौ बे ईसु से पूँछीं, “प्रभु, का हम अपनी तलवारन को इस्तमाल करैं?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />और उनमैं से एक बड़े पुजारी के सेवक के ऊपर तलवार चलाय दई और बाको दहने कान कै काट दई।<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />लेकिन ईसु कही, “अब बस ही गौ!” बौ आदमी के कान के छुइ और बाकै अच्छो करी।<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />तौ ईसु बड़ो पुजारी और मंदिर के अधिकारिन और बे बड़े-बूढ़ेन से कही जो बाकै लेन आए रहैं, “का तुम मोकै डाँकू समझकै तलवार और लठिया लैकै निकरे हौ? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />मैं हर रोज मंदिर मैं तुमरे संग रहौं, और तुम मोकै गिरफ्तार करन कि कोसिस ना करे। लेकिन जौ तुमरे काम करन को समय है, जब अंधियारे कि सक्ति अधिकार रखथै।”<verse eid="LUK 22:53" /></para>
  <para style="s">पतरस ईसु कै इंकार करी</para>
  <para style="r">(<ref loc="MAT 26:57-58">मत्ती 26:57-58</ref>; <ref loc="MRK 14:53-54">मरकुस 14:53-54</ref>; <ref loc="MRK 14:66-72">मरकुस 14:66-72</ref>; <ref loc="JHN 18:12-18">यूहन्ना 18:12-18</ref>; <ref loc="JHN 18:25-27">यूहन्ना 18:25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />बे ईसु कै गिरफ्तार करीं और बाकै बड़े पुजारी के घर मैं लैगै; और पतरस थोड़ी दूर हुईकै पीछा करी। <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />और जब बे आँगन के बीच मैं आगी सुलगाए कै बैठै, तौ पतरस बे लोगन बीच मैं बैठगौ, जो गोल घेरा बनाएकै बैठै रहैं। <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />जब एक सेविका बाकै हुँआँ आगी के किनारे बैठो देखी, तौ बौ सीधे बाके घाँईं देखकै कही, “जौ आदमी भी ईसु के संग रहै!”<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />लेकिन पतरस जौ कहकै इंकार कर दई, “बईय्यर, मैं बाकै ना जानथौं!”<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />थोड़ी देर बाद एक आदमी और पतरस कै देखकै कही, “तहूँ तौ उन्हईं मैं से एक है!” लेकिन पतरस जबाब दई, “हे इंसान, मैं ना हौं!”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />और लमसम एक घंटा बाद एक दुसरो आदमी जोर दैकै कही, “जामैं कोई सच ना है कि जौ आदमी ईसु के संग रहै, काहैकि जहो एक गलीली है!”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />लेकिन पतरस जबाब दई, “हे इंसान, मोकै पता ना है कि तुम कौनके बारे मैं बात कर रै हौ!” जब बौ कहतै रहै कि तुरंत मुर्गा बास दई। <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />प्रभु ईसु घूमकै सीधे पतरस घाँईं देखी, और पतरस कै याद आओ कि प्रभु बासे कही रहै, “आज रात मुर्गा बासन से पहले, तैं तीन बार कहगो कि तैं मोकै ना जानथै।” <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />पतरस बाहर चले गौ और फूट-फूट कै रोन लागो।<verse eid="LUK 22:62" /></para>
  <para style="s">ईसु को मजाक उड़ाईं और पीटो गौ</para>
  <para style="r">(<ref loc="MAT 26:67-68">मत्ती 26:67-68</ref>; <ref loc="MRK 14:65">मरकुस 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />जो लोग ईसु कि रखबारी करत रहै, बे बाकी मजाक बनाईं और बाकै मारीं। <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />बे बाकी आँखिन मैं पट्टी भाँदकै और बासे पूँछीं, “अब भविस्यवाँड़ी करकै बता तोकै कौन मारो!” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />और बे बड़ा बुराई करन बारी बात कहीं।<verse eid="LUK 22:65" /></para>
  <para style="s">ईसु कै महासभा के सामने लाओ गौ</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती 26:59-66</ref>; <ref loc="MRK 14:55-64">मरकुस 14:55-64</ref>; <ref loc="JHN 18:19-24">यूहन्ना 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />जब दिन भौ, तौ बड़े-बूढ़े, और बड़ो पुजारी और यहूदि नियम के सिक्छक इखट्टे भै, और ईसु कै पंचायत घर मैं लाईं। <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />बे कहीं, “हमैं बता, का तैं मसीह है?” ईसु जबाब दई, “अगर मैं तुमसे कहेंगो, तौ तुम मेरे ऊपर बिस्वास ना करैगे; <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />और अगर मैं तुमसे एक सवाल पूँछंगो, तौ तुम जबाब ना देगे। <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />लेकिन अब से इंसान के लौड़ा कै सर्वसक्तिमान सामर्थ्य को परमेस्वर के अधिकार मैं बैठाए दौ जागो।”<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />बे सब जनी कहीं, “फिर का तैं, परमेस्वर को लौड़ा है?” ईसु उनकै जबाब दई, “तुम खुदै कहथौ, कि मैं हौं।”<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />और बे कहीं, “हमैं कोई गभाई कि जरूरत ना है! हम खुदै सुने हैं कि बौ का कही!”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">पिलातुस के सामने ईसु</para>
  <para style="r">(<ref loc="MAT 27:1-2">मत्ती 27:1-2</ref>; <ref loc="MRK 15:1-5">मरकुस 15:1-5</ref>; <ref loc="JHN 18:28-38">यूहन्ना 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />पूरो समूह उठकै ईसु कै पिलातुस के सामने लैगै, <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />जहाँ बे बाके ऊपर दोस लगानो सुरु करीं: “हम जौ आदमी कै हमरे देस के लोगन कै गुमराह करत भइ पकड़े, और सम्राट कैसर कै लगान देन से मना करत, अपने आपकै मसीहा, राजा कहत भइ सुने हैं।”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />पिलातुस ईसु से पूँछी, “का तैं यहूदियन को राजा है?” ईसु जबाब दई, “तैं खुदै कहरौ है।”<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />तौ पिलातुस बड़े पुजारी और भीड़ से कही, “मोकै जौ आदमी मैं कोई दोस ना मिलो।”<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />लेकिन बे और जोर दैकै कहीं, “जौ गलील से लैकै हिंयाँ तक पूरे यहूदिया मैं उपदेस दै दैकै लोगन कै भड़काथै।”<verse eid="LUK 23:5" /></para>
  <para style="s">ईसु कै हेरोद के झोने भेजो गौ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />जब पिलातुस जौ सुनी, तौ उनसे पूँछी, “का जौ आदमी गलीली है?” <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />जब बाकै पता चलो कि ईसु हेरोद के इलाका को है, तौ बौ बाकै हेरोद के अधिकार के झोने पनार दई, काहैकि बे दिनन बौ भी यरूसलेम मैं रहै। <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />ईसु कै देखकै हेरोद बड़ा खुस भौ, काहैकि बौ बाके बारे मैं सुनी रहै, और भौत दिनन से बाकै देखनो चहात रहै। बौ ईसु कै कछु चिन्ह करत भइ देखन कि उमीद करत रहै। <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />इसलै हेरोद ईसु से गजब सबाल पूँछी, लेकिन ईसु कोई जबाब ना दई। <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />और बड़ो पुजारी और यहूदि नियम के सिक्छक अग्गु कदम बढ़ाई और ईसु के खिलाप मजबूत आरोप लगाईं। <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />तौ हेरोद और बाके सैनिक ईसु को मजाक बनाईं और बाको अपमान करीं; और बे ईसु कै एक अच्छो लत्ता पहनाए कै बाकै बापस पिलातुस के झोने पनार दई। <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />बहे रोज से हेरोद और पिलातुस दोस्त बन गै; जासे पहले बे दुस्मन रहैं।<verse eid="LUK 23:12" /></para>
  <para style="s">ईसु कै मौत कि सजा दई गई</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्ती 27:15-26</ref>; <ref loc="MRK 15:6-15">मरकुस 15:6-15</ref>; <ref loc="JHN 18:39">यूहन्ना 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />पिलातुस बड़े पुजारी, अधिकारी और लोगन कै एक संग बुलाई, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />और बौ कही, “तुम जौ आदमी कै मेरे झोने लैकै आए और कहे कि जौ लोगन कै भरमाए रौ है। अब, मैं तेरे सामने बाकी परिक्छा करो हौं, और जो अपराध तैं बाके ऊपर करो है, बे बातन के बारे मैं मैं बामै कोई दोस नाय पाओ हौं। <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />और न तौ हेरोद जाकै दोसी पाई, काहैकि बौ जाकै हमरे झोने बापस पनार दई है। जौ आदमी मौत के लायक कुछ न करी है। <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />इसलै मैं जाकै कोड़ा मरवाएकै जान दुंगो।”<verse eid="LUK 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 23:17" />पिलातुस त्योहार के समय उनके ताहीं एक बंधी कै छोड़न ताहीं बेबस रहै।<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />तौ पूरी भीड़ चिल्लाए उठी, “जाकै मार डारौ! और हमरे ताहीं बरअब्बा कै आजाद कर दे।” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />सहर मैं होन बारे दंगा के ताहीं और खून करन मैं बरअब्बा कै कैदखाना मैं डार दौ गौ रहै।<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />पर पिलातुस ईसु कै छोड़नो चहात रहै, इसलै बौ भीड़ कै फिर से समझाई। <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />लेकिन बे चिल्लाईं, “बाकै क्रूस मैं चढ़ाबौ! बाकै क्रूस मैं चढ़ाओ!”<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />पिलातुस तिसरी बार उनसे कही, “लेकिन बौ का गुनाह करी है? मोकै ऐसो कछु नाय मिलो जोसे बौ मौत के लायक होबै! इसलै मैं बाकै कोड़ा मरवाएकै छोड़ देथौं।”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />लेकिन बे अपनी अबाज मैं जोड़न से चिल्लात रहे कि ईसु कै क्रूस मैं चढ़ाओ जानो चाहिए, और आखिरकार उनको चिल्लानो कामयाब हुई गौ। <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />जौ बजह से पिलातुस ईसु कै सजा को फैसला दई जो बे अधिकार से मांगत रहैं। <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />पिलातुस बौ आदमी कै छोड़ दई, जो दंगा और हत्या के आरोप मैं कैदखाना मैं डार दौ गौ रहै, और ईसु कै उनकी इच्छा के हिसाब से सौंप दई।<verse eid="LUK 23:25" /></para>
  <para style="s">ईसु कै क्रूस मैं चढ़ाओ गौ</para>
  <para style="r">(<ref loc="MAT 27:32">मत्ती 27:32</ref>; <ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="JHN 19:17-27">यूहन्ना 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />सिपईय्या जब ईसु कै क्रूस के संग लैकै जात रहैं, तौ बे सिमौन नाओं को एक कुरेनी कै जो सहर मैं आत रहै, बे बाकै पकड़ लईं, और बाकै ईसु के पच्छू-पच्छू लै चले गै।<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />लोगन कि एक बड़ी भीड़ ईसु के पच्छू ही लई; उनमैं से कुछ बईंय्यरैं तौ छाती पीट-पीटकै रोत रहैं। <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />ईसु उनके घाँईं मुड़कै कही, “यरूसलेम कि बईंय्यरौं! मेरे ताहीं मत रोबौ, बल्किन अपने और अपने बालकन के ताहीं रोबौ। <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />काहैकि बे दिन आए रै हैं जब लोग कहंगे, ‘कितनी खुसनसीब हैं बे बईंय्यरैं जिनके कहु बालका ना भै, जो कहु बालका पैदा ना करीं, जो कहु उनको पालन पोसँड़ ना करीं!’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />जहे बौ समय होगो जब लोग पहाड़न से कहंगे, ‘हमरे ऊपर गिर!’ और चुटिया से, ‘हमकै ढोंक ले!’ <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />काहैकि अगर ऐसे काम कठिया के हरे होन मैं करे जाथैं, तौ जब जौ सूख जागी तौ का होगो?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />बे दुई आदमिन कै भी जो अपराधी रहैं ईसु के संग मौत के घाट उतारन दौ गौ। <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />जब बे खोपड़ी नाओं कि जघा मैं पौहोंचे, तौ बे हुँआँ ईसु कै क्रूस मैं चढ़ाईं, और बे दोनों अपराधिन कै भी, एक ईसु के दहने और दुसरो ईसु के बाँए घाँईं। <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />तौ ईसु कही, “दऊवा! इनकै माफ कर दे, काहैकि जे ना जानथैं कि जे का कर रै हैं।” बे पासा डारकै बाके लत्ता आपस मैं बाँट लईं। <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />यहूदि अधिकारी बाके ऊपर झपटत भइ हुँआँ ठाड़े भै लोगन कै देखत रहैं: और कहीं, “बौ दुसरेन कै बचाई है; अगर बौ मसीहा है जोकै परमेस्वर चुनी है तौ अपने आपकै बचाए ले!”<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />सिपईय्या ईसु को मजाक बनाईं: बे बाके झोने आए और बाकै घटिया दाखरस पीन कै दई, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />और कहीं, “अगर तैं यहूदियन को राजा है तौ अपने आपकै बचाए ले!”<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />ईसु के ऊपर जे सब्द लिखे गै रहैं: कि “जौ यहूदियन को राजा है।”<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />हुँआँ लटके भै अपराधिन मैं से एक जनी बाकी बुराई करीं: “का तैं मसीहा ना है? अपने आपकै और हमकै बचा!”<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />लेकिन दुसरो जनी बाकै झुकात भै कही, “का तैं परमेस्वर के न्याय से ना डराथै? तहूँ तौ बहे सजा पाए रौ है। <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />हमरो, खाली ठीक है, काहैकि हमैं बहे मिल रौ है जोके हम सई रूप मैं हकदार हैं, जो हम करे; लेकिन बौ कोई गलत काम ना करी।” <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />और बौ ईसु से कही, “ईसु, जब तैं अपने राज्य मैं राजा के रूप मैं आबै, तौ मोकै याद करीये!”<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />ईसु बासे कही, “मैं तोसे सच्ची मैं कहथौं कि आज तैं मेरे संग स्वर्गलोक मैं होगो।”<verse eid="LUK 23:43" /></para>
  <para style="s">ईसु कि मौत</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="JHN 19:28-30">यूहन्ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />और लमसम दिन के बारह बजे रहैं जब सूरज चमकनो बंद होन लग्गौ और दुपारी के तीन बजे ले पूरे देस मैं बुराई मैं अंधियारो छाए गौ; <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />और मंदिर मैं लटको भौ परदा बीच से फटकै दुई टुकड़ा हुई गौ। <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />ईसु ऊँची अबाज मैं पुकारी, “दऊवा! मैं अपनी आत्मा तेरे हातन मैं सौंपथौं।” बौ ऐसे कही और मरकुस गौ।<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />सेना को अधिकारी जौ सब देखकै जो सब भौ रहै, बौ परमेस्वर कि बड़ाँईं करत भइ कही, “ठीक मैं जौ एक धर्मी आदमी रहै!”<verse eid="LUK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48" />जब तमासा देखन बारे जो हुँआँ जुराने रहैं बे लोग देखीं कि का भौ है, तौ बे सब दुख मैं अपनी छाती पीटत भइ घरै बापस लौट गै। <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />बे सब ईसु के जान पहचान के, और जो बईंय्यरैं गलील से बाके संग आई रहैं, दूर ठाड़कै जौ सब देखत रहैं।<verse eid="LUK 23:49" /></para>
  <para style="s">ईसु कै दफनानो</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="JHN 19:38-42">यूहन्ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />और हुँआँ, यहूदिया के सहर अरिमतियाह से यूसुफ नाओं को एक आदमी रहै। बौ एक अच्छो और धर्मी आदमी रहै, जो सिरफ परमेस्वर के राज्य के आन को इंतजार करत रहै। <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />हालाकि बौ महासभा और अरिमतियाह सहर को एक यहूदि सदस्य और परमेस्वर के राज्य की बाट जोहनबारो रहै, लेकिन बौ उनके न्याय और कारवाई से सहमत ना रहै। <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />बौ पिलातुस के झोने जाएकै ईसु कि सरीर कै माँगी। <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />फिर बौ ईसु कि सरीर कै नीचे उतारकै एक चद्दर मैं लपेट दई, और एक कबर मैं रखी जो ठोस चट्टान मैं खुदी गई रहै और जोको कहु इस्तमाल ना करो गौ रहै। <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />जौ सुक्कर को दिन रहै, और साबत को दिन सुरु होन बारो रहै।<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />और बे बईंय्यरैं जो बाके संग गलील से आई रहैं, बे यूसुफ के संग जाएकै कबर कै देखीं और जहो कि ईसु के सरीर कै कैसे करकै रखो गौ है।<verse eid="LUK 23:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 23:56" />आग्या लैकै फिर बे साबत के दिन बापस घरै गै और ईसु कि सरीर के ताहीं महाकनबारी चीज मसाल और इत्तर तैयार करीं। और साबत के रोज तौ बे कानून के हिसाब से आराम करीं।<note caller="+" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">निर्गमन 20:10</ref>; <ref loc="DEU 5:14">व्यवस्थाविवरन 5:14</ref></char></note><verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">ईसु को जी उठनो</para>
  <para style="r">(<ref loc="MAT 28:1-10">मत्ती 28:1-10</ref>; <ref loc="MRK 16:1-8">मरकुस 16:1-8</ref>; <ref loc="JHN 20:1-10">यूहन्ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />सप्ताह के पहलो दिन के सुबेरे बड़ा जल्दी बे इत्तर और महाकनबारी चीज और मसाले जो बे बईंय्यरैं तैयार करी रहैं लैकै कबर मैं गईं। <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />बे देखीं कि पथरा कबर से लुढ़को भौ है, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />इसलै बे अंदर गै; लेकिन उनकै प्रभु ईसु को सरीर नाय मिलो। <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />बे जौ बात सोचकै हैरान रहैं, कि अनकाचीति चमकीले चमकदार लत्तन मैं दुई आदमी उनके झोने आयकै ठाड़गै। <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />और जो उनके ऊपर जो बीतो बे डर के मारे बईंय्यरैं जमीन मैं गिर पड़ीं, बे आदमी उनसे कहीं, “तुम जिंदे कै मरे भैन मैं काहेकै ढूँड़ रै हौ? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />बौ हिंयाँ ना है; बौ जी उठो है। याद करौ कि गलील मैं रहत भइ बौ तुमसे का कही रहै: <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />‘इंसान को लौड़ा पापिन के हात पकड़बाओ जागो, क्रूस मैं चढ़ाओ जागो, और तीसरे दिन जिंदो हुई जागो।’”<verse eid="LUK 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />तौ बईंय्यरन कै ईसु कि बात याद आई, <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />और कबर से लौटकै, जे सब बातन कै ग्यारह चेला और बाकी लोगन कै बताईं। <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />बईंय्यरन मैं मरियम मगदलीनी, योअन्ना और याकूब कि अईय्या मरियम रहै; बे और उनके संग कि दुसरी बईंय्यरैं प्रेरितन कै जे सब बात बताईं। <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />लेकिन प्रेरितैं सोचीं कि बईंय्यरैं जो बात कह रइ हैं बौ सब बकवास है, और बे उनके ऊपर बिस्वास ना करीं। <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />लेकिन पतरस उठकै कबर के घाँईं भाजत गौ; और तरे झुककै खाली लत्ता पड़े भै देखी और कछु ना देखी। फिर बौ जो भौ रहै, बाके ऊपर ताजुब भइ घरै बापस चले गौ।<verse eid="LUK 24:12" /></para>
  <para style="s">इम्माऊस गाँव कै चलौ</para>
  <para style="r">(<ref loc="MRK 16:12-13">मरकुस 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />बहे रोज ईसु के ऊपर बिस्वास करन बारे दुई जनी इम्माऊस नाओं के एक गाँव मैं जात रहैं, जो यरूसलेम से लमसम ग्यारह किलो मीटर दूर रहै, <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />और जो कछु भौ रहै, बौ सबके बारे मैं आपस मैं बात करत रहैं। <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />जैसो कि बे बातचीत और पूँछ-तांछ करत रहैं, तौ ईसु खुद उनके झोने आयकै और उनके संग चल दई; <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />बे बाकै देखीं, लेकिन कैसियो बाकै पहचान ना पाईं। <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />ईसु उनसे कही, “तुम नेंगत-नेंगत आपस मैं का बतकाए रै हौ?” बे उदास चैहरा लैकै ठाड़े रहगै।<verse eid="LUK 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 24:18" />उनमैं से एक, जोको नाओं क्लियुपास रहै, बौ पूँछी, “का तैं यरूसलेम मैं इकलौतो परदेसी है जो बे चीजन कै ना जानथै जो पिछले कुछ दिनन से हुँआँ हुई रौ है?”<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />ईसु उनसे पूँछी, “कौन सी बातैं?” बे जबाब दई, “ईसु नासरत के संग भइ बातैं, जौ आदमी एक भविस्यवक्ता रहै और परमेस्वर और सबै लोगन के जरिये उनके जरिये कहे गै और करे गै हर काम मैं सक्तिसाली होन के ताहीं मानो जात रहै। <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />हमरे बड़े पुजारी कानून और न्याय के अधिकारी बाकै मौत कि सजा के ताहीं सौंप दई, और बाकै क्रूस मैं चढ़ाय दौ गौ। <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />और हमकै उमीद रहै कि बौ बहे होगो जो इस्राएल कै छुड़ाय कै आजाद करन बारो है! इन सबके अलावा, जौ घटना कै भै जौ तीसरो दिन है। <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />हमरे समूह कि कुछ बईंय्यरैं तौ हमकै अचम्मो मैं डार दई; बे भोर कै कबर मैं गईं, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />लेकिन ईसु कि सरीर ना मिली। बे जौ कहत भइ बापस आई कि हम स्वर्गदूतन को दर्सन देखीं जो हमकै बताईं कि बौ जिंदो है। <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />हमरे संग के कुछ लोग कबर मैं गै और जैसो बईंय्यरैं कहीं रहैं, बैसो पाईं लेकिन बे ईसु कै ना देखीं।”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />तौ ईसु उनसे कही, “तुम कितने मूर्ख हौ, भविस्यवक्ता कि हर बात के ऊपर मन मैं बिस्वास करन मैं कितने धीमे हौ! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />का मसीहा के ताहीं जौ जरूरी नाय रहै कि बौ जे दुखन कै उठाबै और अपनी महिमा मैं आबै?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />और ईसु मूसा कि किताब से लैकै सब भविस्यवक्ता जो बाके बारे मैं सास्त्र मैं लिखी रहैं उनकै समझाई।<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />तौ बे बौ गाँव के झोने आए जितै बे जात रहैं, ईसु ऐसो व्यवहार करी कि मानौ बौ अग्गु जात रहै; <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />लेकिन बे कै जौ कहकै रोक लईं कि “हमरे संग रहा; दिन लमसम खतम हुई गौ है और अंधियारो हुई रौ है।” इसलै बौ उनके संग रहन कै चले गौ। <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />बौ उनके संग खानु खान कै बैठगौ, रोटी लई, और आसीस माँग कै धन्यवाद करी; तौ बौ रोटी तोड़कै उनकै दई। <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />तौ उनकी आँखी खुली और बे बाकै पहचान लईं, लेकिन बौ उनकी नजर से गायब हुई गौ। <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />बे आपस मैं कहीं, “का जौ बौ आगी के हानी नाय जो हमरे मन मैं पजरत रहै, जब बौ रस्ता मैं हमसे बतकात रहै, और सास्त्र को मतलब समझात रहै?”<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />बे तुरंतै उठकै यरूसलेम कै लौट गै, और जितै पाईं की बे ग्यारह चेला औरन के संग जुराए गै हैं <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />और कहीं, “प्रभु सचमुच मैं जी उठो है! बौ सिमौन कै दिखाई दई!”<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />फिर दोनों उनकै समझाईं कि सड़क मैं का भौ रहै, और जब बे रोटी तोड़ीं तौ बे प्रभु कै कैसे पहचानी।<verse eid="LUK 24:35" /></para>
  <para style="s">ईसु अपने चेलन कै दिखाई दई</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="JHN 20:19-23">यूहन्ना 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेरितो 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />जब बे दोनों उनसे जौ कहतै रहैं, अनकाचीति प्रभु खुद उनके बीच मैं ठाड़गौ और उनसे कही, “तुमकै सांति मिलै।”<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />पर जौ सोचकै कि हम एक भूत कै देखरै हैं, बे घबराय गै। <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />लेकिन ईसु उनसे कही, “तुम काहेकै घबराय रै हौ? तुमरे मन मैं जौ संका काहेकै आए रौ है? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />मेरे हातन कै और मेरे पाँवन कै देखौ, कि जौ मैं खुद हौं। मोकै महसूस करौ, और तुम जान जागे, काहैकि भूत के पास मास और हड्डी ना होथैं, जैसो कि तुम देख सकथौ कि मेरे पास हैं।”<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />बौ ऐसे कही और उनकै अपने हात और पाँव दिखाई। <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />उनकै दोस्तौ खुसी के मारे बिस्वास ना होत रहै, बे बड़ा अचम्मे से भरे भै रहैं; और बौ उनसे पूँछी, “का तुमरे पास खान के ताहीं कछु है?” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />बे बाकै पकी भइ मच्छी को एक टुकड़ा दई, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />जोकै बौ लई और उनके अग्गु खाई।<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />फिर बौ उनसे कही, “जे मेरी बे बातैं हैं, जोमैं तुमरे संग रहत भइ, तुमसे कहो रहौं, कि जरूरी है, कि जितनी बात मूसा के नियम और भविस्यवक्ता और भजन संहिता कि किताबन मैं, मेरे बारे मैं लिखी हैं, सब पूरी होमैं।”<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />तौ बौ सास्त्र कै समझन के ताहीं उनके दिमाक कै खोली, <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />और बौ कही, “जौ लिखो है, की मसीहा दुख उठागो, और तीन दिन बाद मौत से जी उठैगो, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />और यरूसलेम देस से सुरुवात करकै सब जातिन मैं मन फिरान और पापन की माफी को प्रचार बहे के नाओं से सुनाओ जाबै। <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />तुम जे सब बातन के गभा हौ। <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />और जो कुछ मेरो दऊवा वादा करी है मैं हूँनै तुमकै पनारंगो। लेकिन जबले ऊपर से सामर्थ्य तुमरे ऊपर ना उतरै तौले तुम नगर मैं असियाबौ।”<verse eid="LUK 24:49" /></para>
  <para style="s">ईसु कै स्वर्ग तक लैजाओ गौ</para>
  <para style="r">(<ref loc="MRK 16:19-20">मरकुस 16:19-20</ref>; <ref loc="ACT 1:9-11">प्रेरितो 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />तौ बौ उनकै बैतनिय्याह सहर से बाहर लैगौ, और बौ अपने हात उठाएकै उनकै आसीस दियो। <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />और उनकै आसीस देत भइ बौ उनसे अलग हुई गौ और स्वर्ग मैं लैजाओ गौ।<note caller="+" style="x"><char style="xo" closed="false">24:51 </char><char style="xt" closed="false"><ref loc="ACT 1:9">प्रेरितो 1:9</ref>; <ref loc="PSA 47:5">भजन संहिता 47:5</ref></char></note> <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />बे बाकी आराधना करीं और बड़े खुसी से भरकै यरूसलेम कै लौट गै। <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />और अपनो पूरो समय मंदिर मैं परमेस्वर कै धन्यवाद देन और आसीस माँगन मैं बिताई।<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>