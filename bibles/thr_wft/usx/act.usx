<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Rana Tharu</book>
  <para style="h">प्रेरितो के काम</para>
  <para style="toc3">प्रेरितो</para>
  <para style="toc2">प्रेरितो</para>
  <para style="toc1">प्रेरितो के काम पौलुस को लिखो भौ ईसु मसीह को सुसमाचार</para>
  <para style="mt2">प्रेरितो के काम पौलुस का लिखा हुँआँ ईसु मसीह का सुसमाचार</para>
  <para style="mt1">प्रेरितो के काम पौलुस को लिखो भौ ईसु मसीह को सुसमाचार</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रेरितन कि किताब कलीसिया के सुरु होन कि कहानी है और जौ यरूसलेम से यहूदिया, सामरिया और बासे अग्गु तक फैल गई, जैसे ईसु अपने चेलन कै स्वर्ग मैं जान से पहले बताई<char style="xt"><ref loc="ACT 1:8">1:8</ref></char>। जाकै लूका लिखी रहै, जो लूका के हिसाब से सुसमाचार भी लिखी रहै। बौ एक बैध भी रहै और एक सटीक खाता हिसाब किताब करन के ताहीं बड़ा चौकन्नो रहै। बौ अपने सुसमाचार और अधिनियम कि किताब थियोफिलस कै सम्बोधित करी, जो एक ग्रीक रहै, लेकिन किताब को उद्देस्य सायद मसीह समुदाय के ताहीं भी रहै जोमैं ग्रीक और यहूदि दोनों सामिल रहैं<char style="xt"><ref loc="ACT 1:1">1:1</ref></char>। प्रेरित लमसम ईसु मसीह के जनम के बाद 60-64 सालन के बीच मैं लिखी गई रहै काहैकि किताब पौलुस के कैदखाना से छुटन से पहले खतम होथै। लूका भी पौलुस के संग सफर करी और सायद एंटीओक सहर मैं अधिनियम लिखी। प्रेरितैं लूका के सुसमाचार कै जारी रखाईं जो ईसु के स्वर्ग मैं जान के संग सुरु होथै। लिखन मैं लूका को उद्देस्य उनके सुसमाचार के हानी है। बौ थियोफिलस चहात रहै, संग-संग मसीहियन कि बढ़ती संख्या से पक्को है कि उनकै का सिखाओ गौ रहै और इसलै बे ईसु कि जिंदगी और मसीह धर्म कै फैलान को एक सटीक लेख लिखी। प्रेरितन कि किताब हमरे ताहीं कलीसिया के सुरुवात को उदाहरड़ बताथै और ईसु मैं बिस्वास से जीन के ताहीं कैसो दिखात रहै। प्रेरितन के उदाहरड़ हमकै दिखाथै कि दुसरेन कै सुसमाचार संदेस फैलान मैं पवित्र आत्मा कि सक्ति मैं कैसे भरोसो करो जाबै।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पहले पवित्र आत्मा चेलन के ऊपर आथै और कलीसिया बढ़न लगथै। <char style="ior"><ref loc="ACT 1:1-8:1">1:1–8:1</ref></char></para>
  <para style="io1">2. जाके बाद कलीसिया कै सताओ जाथै और यरूसलेम के दुआरे फैलन लगथै। <char style="ior"><ref loc="ACT 8:2-12:23">8:2–12:23</ref> </char></para>
  <para style="io1">3. जाके बाद पौलुस अपनी पहली मिसनरी सफर कै जाथै। <char style="ior"><ref loc="ACT 12:24-14:28">12:24–14:28</ref> </char></para>
  <para style="io1">4. जाके बाद परिसद यरूसलेम मैं बैठक करकै जौ तैं करी कि नये विस्वासियन कि जरूरत का है। <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref></char></para>
  <para style="io1">5. फिरौंकी पौलुस अपनी दुसरी मिसनरी सफर कै जाथै। <char style="ior"><ref loc="ACT 15:36-18:22">15:36–18:22</ref></char></para>
  <para style="io1">6. बाके बाद बौ अपनी तिसरी मिसनरी सफर कै जाथै। <char style="ior"><ref loc="ACT 18:23-20:38">18:23–20:38</ref> </char></para>
  <para style="io1">7. तौ पौलुस कै यरूसलेम मैं पकड़ लौ गौ। <char style="ior"><ref loc="ACT 21-26">21–26</ref> </char></para>
  <para style="io1">8. आखरी मैं बाकै रोम मैं पहुँचाओ गौ। <char style="ior"><ref loc="ACT 27-28">27–28</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:1-4">लूका 1:1-4</ref> </char>
    </note>प्रिय थियुफिलुस: मैं अपनी पहली किताब मैं बे सब चीजन के बारे मैं लिखो जो ईसु करी रहै और बौ समय से सिखाओ रहौं जब बौ अपनो काम सुरू करी रहै <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>बौ दिन तक बौ स्वर्ग मैं लैजाओ गौ रहै। जासे पहले कि बौ उठाओ लौ जातो, बौ पवित्र आत्मा की सक्ति के जरिये अपने प्रेरितन के रूप मैं चुने गै लोगन कै निर्देस दई। <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>अपनी मौत के बाद चालीस दिन ले बौ भौत बार दिखाई दौ जासे साबित भौ कि बौ जिंदो है। बे बाकै देखीं, और बौ उनके संग परमेस्वर के राज्य के बारे मैं बात करी। <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>और जब बे सब एक संग आए, तौ बौ उनकै जौ आदेस दई: “यरूसलेम कै मत छोड़ौ, लेकिन जो उपहार के बारे मैं मैं तुम्हैं बताओ हौं, बाकै असियाबौ, बौ उपहार जोको मेरो दऊवा वादा करी रहै। <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/>यूहन्ना पानी से बपतिस्मा लई, लेकिन कुछै दिनन मैं तुम पवित्र आत्मा के संग बपतिस्मा लेगे।”<verse eid="ACT 1:5"/></para>
  <para style="s">ईसु स्वर्ग मैं लैजाओ गौ</para>
  <para style="r">(<ref loc="MRK 16:19-20">मरकुस 16:19-20</ref>; <ref loc="LUK 24:50-53">लूका 24:50-53</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>जब प्रेरित ईसु के संग मिले, तौ बे बासे पूँछीं, “हे प्रभु, का तैं जौ समय राज्य कै बापस इस्राएल कै देगो?”<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>ईसु उनसे कही, “समय और मौका मेरे दऊवा के अपने अधिकार के जरिये तैं करो गौ है, और जौ जाननो तुमरे ताहीं नाय है कि बे कब होमंगे। <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/>लेकिन जब पवित्र आत्मा तुमरे ऊपर आगो तौ तुम सामर्थ्य से भर जागे, और तुम यरूसलेम मैं, यहूदिया, सामरिया और पृथ्वी के छोर तक मेरे ताहीं गभा बनैगे।”<note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">मत्ती 28:19</ref>; <ref loc="MRK 16:15">मरकुस 16:15</ref>; <ref loc="LUK 24:47-48">लूका 24:47-48</ref></char></note> <verse eid="ACT 1:8"/><verse number="9" style="v" sid="ACT 1:9"/>जौ कहेन के बाद, बाकै स्वर्ग मैं लैजाओ गौ काहैकि बे बाकै देखत रहैं, और एक बादर उनकै अपनी नजर से लुकाए दई।<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">मरकुस 16:19</ref>; <ref loc="LUK 24:50-51">लूका 24:50-51</ref></char></note><verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>जब बे चले गै, तहुँओं उनकी निघा आसमान मैं टिकी रइ, जब सेतो लत्ता पहने दुई आदमी अनकाचीति उनके झोने ठाड़े रहैं <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>और कही, “गलील, तुम हूँना ठाड़कै आसमान के घाँईं काहे देखरै हौ? जौ ईसु, जो तुमरे झोने से स्वर्ग मैं लैजाओ गौ रहै, बहे तरीका बापस आबैगो जो तरीका से तुम बाकै स्वर्ग जात भइ देखे रहौ।”<verse eid="ACT 1:11"/></para>
  <para style="s">यहूदा को वारिस</para>
  <para style="r">(<ref loc="MAT 27:3-10">मत्ती 27:3-10</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>तौ प्रेरित जैतून नाओं के पहाड़ से यरूसलेम के घाँईं गै, यरूसलेम सहर से लमसम आधी मील की दूरी मैं है। <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>बे सहर मैं आत खिना कि बौ कमरा मैं गै, जहाँ बे रुके भै रहैं: पतरस, यूहन्ना, याकूब और अन्द्रियास, फिलिप्पुस और थोमा, बरतुल्मै और मत्ती, हलफई का लौड़ा याकूब, देसभक्त सिमौन, और याकूब का लौड़ा यहूदा। <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>जे सब तमान बईंय्यरैं और ईसु की अईय्या मरियम और बाके भईय्यन के संग झुंड मैं प्रार्थना करन के ताहीं इखट्टे होबै करत रहैं।<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>कुछ दिनन के बाद पतरस सब विस्वासी भईय्यन के बीच मैं, जो एक सौ बीस आदमी के लमसम रहैं, बौ हूँना ठाड़कै कहेन लागो। <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>बौ कहीं, “मेरे भईय्यौ, पवित्र सास्त्र कै सच होनो जरूरी रहै, जोमैं पवित्र आत्मा, दाऊद के जरिये बोलत भै यहूदा के बारे मैं एक भविस्यवाँड़ी करी रहै, जो ईसु कै पकड़वान बारेन के ताहीं अगुवन रहै। <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>यहूदा हमरे झुंड को सदस्य रहै, काहैकि बाकै हमरे काम मैं सेवकाई मैं हिस्सा लेन के ताहीं चुनो गौ रहै।”<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>यहूदा कै अपने अधर्म के कामन के ताहीं जो पैसा मिलो, बासे बौ एक खेत खरीदी जितै बाकी मौत ही गई; बाको पेट फट गौ और बाकी पूरी भीतर की आँती बाहर निकर आई। <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>यरूसलेम मैं रहन बारे सबै आदमी जाके बारे मैं सुनीं, और इसलै उनकी अपनी भासा मैं बे बौ जघा कै हकलदमा कहीं, जो मतलब है “खून को खेत।”<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>“जाके ताहीं भजन संहिता की किताब मैं लिखो गौ है,</para>
  <para style="q1" vid="ACT 1:20">‘बाको घर खाली हुई जाबै;</para>
  <para style="q2" vid="ACT 1:20">कोई भी जामैं नाय रह सकथै।’</para>
  <para style="m" vid="ACT 1:20">जहो लिखो है:</para>
  <para style="q1" vid="ACT 1:20">‘कोई और भी बाकी सेवा लै सकथै।’”<verse eid="ACT 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21"/>“इसलै जितने दिन ले प्रभु ईसु हमरे संग आत जात रहो, ठीक जौ है कि उनमैं से एक आदमी बाके जी उठन को गभा ही जाबै, <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>मतलब यूहन्ना के बपतिस्मा से लैकै बाके हमरे झोने से जी उठाए जान तक, जो लोग बराबर हमरे संग रहे।”<verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>तौ बे दुई आदमी कै ठड़बाईं: एक यूसुफ जो बरसब्बास कहो जात रहै बाको उपनाओं यूस्तुस है, और दुसरो मत्तियाह कहो जात रहै। <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>फिर बे प्रार्थना करीं, “प्रभु, तैं सबन के बिचारन कै जानथै, इसलै हमकै दिखा कि इन दोनों मैं से कौनकै चुनो है <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>कि बाकै जौ सेवकाई और प्रेरित को पद मिलै, जो यहूदा छोड़कै अपने जघा कै चले गौ है।” <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>तौ बे दोनों आदमिन कै छाँटन के ताहीं उनके बीच भौत कुछ मुहान कि कोसिस करीं, और एक चुने भौ मत्तियाह रहै, जोकै ग्यारह प्रेरितन के झुंड मैं जोड़ो गौ रहै।<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s">पवित्र आत्मा को उतरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>जब पिन्तेकुस्त को दिन आओ तौ सबै विस्वासी एक जघा जुराने। <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>अनकाचीति आसमान से बड़ा तगड़ी आँधी की सनसनाहट जैसी अबाज सुनन मैं आई, और बासे पूरो घर जहाँ बे बैठे रहैं, झन्नाए पड़ो। <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>फिर बे देखीं कि आगी की जीभ कैसी दिखाए रइ है जो फैल गई और हुँआँ सबै आदमी कै छुइ लई। <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>और बे सब पवित्र आत्मा से भर गै, और पवित्र आत्मा उनकै बोलन की सामर्थ्य दई, और बे अलग-अलग भासा बोलन लगे।<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>यरूसलेम मैं रहन बारे यहूदि रहैं, धार्मिक लोग जो दुनिया के हर देस से आए रहैं। <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>जब बे जौ गलु सुनीं बड़ा जोड़ भीड़ इखट्टी हुई गई। बे सबै उत्साहित रहैं, काहैकि सबै विस्वासिन कै अपनी भासा मैं बात करत भइ सुनीं। <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>बे सब चकाय गै और अचम्मो हुईकै कहीं, “जे लोग जो जे तरहन की बात कर रै हैं जे गलीली हैं! <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>तौ फिर काहेकै, हममैं से हर एक अपनी-अपनी जलमत की भासा कै नाय सुनथैं? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>हम पारथी, और मेदी, एलामी से हैं; मेसोपोटामिया, यहूदिया और कप्पदूकिया से; पुन्तुस और आसिया से, <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>फ्रूगिया और पंफूलिया से, मिस्र से और साइरेन के झोने लीबिया के इलाका से। हममैं से कुछ रोम से हैं, <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>और दोनों यहूदि धर्म मैं बदल गै, और हममैं से कुछ क्रेती और अरब से हैं, फिर भी हम सबै उनकै अपनी-अपनी भाँसड़ मैं बे महान चीजन के बारे मैं बोलत भै सुने, जो परमेस्वर करी है!” <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>और बे सब चकित भै और डराय कै एक दुसरे से कहेन लगे, “जाको का मतलब है?”<verse eid="ACT 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13"/>लेकिन दुसरे विस्वासियन को मजाक उड़ाए कै कहीं, “बे लोग नसा मैं हैं!”<verse eid="ACT 2:13"/></para>
  <para style="s">पतरस को भाँसड़</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>तौ पतरस दूसरे ग्यारह प्रेरितन के संग ठाड़ो और खूब जोड़ से भीड़ से कहेन लागो: “मूर्ख यहूदियो और तुम सब जो यरूसलेम मैं रहथौ, मेरी बात सुनौ और मोकै बताबौ कि जाको का मतलब है। <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>आदमी नसा मैं नाय हैं जैसो तुम समझ रै हौ; जे आदमी नसा मैं नाय हैं, काहैकि हबै तौ सुबेरे के नौवें बजे हैं। <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>जाके अलावा, जौ बौ बात है, जो योएल भविस्यवक्ता कही रहै:<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>‘परमेस्वर कहथै: जौ बहे है जोमैं आखरी दिनन मैं करंगो,</para>
  <para style="q2" vid="ACT 2:17">कि मैं अपनी आत्मा सब इंसानन मैं अखनांगो।</para>
  <para style="q1" vid="ACT 2:17">तुमरे लौड़ा और लौड़िया मेरे संदेस की भविस्यवाँड़ी करंगे;</para>
  <para style="q2" vid="ACT 2:17">तुमरे ज्वानन कै दर्सन दिखाई देंगे,</para>
  <para style="q2" vid="ACT 2:17">और तुमरे बड़े-बूढ़े सपनो देखंगे।<verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>हाँ, मेरे सेवकन मैं, हींना तक कि लोग और बईंय्यरैं दोनों मैं,</para>
  <para style="q2" vid="ACT 2:18">मैं बे दिनन मैं अपनी आत्मा कै बहार निकारंगो,</para>
  <para style="q2" vid="ACT 2:18">और बे मेरे संदेस को ऐलान करंगे।<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>मैं ऊपर आसमान मैं चिन्ह चमत्कार करंगो,</para>
  <para style="q2" vid="ACT 2:19">और तरे धरती मैं चिन्ह चमत्कार करंगो।</para>
  <para style="q1" vid="ACT 2:19">खून, आगी और घनों धुआँ होगो;<verse eid="ACT 2:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20"/>सूरज अंधियारो हुई जाबैगो,</para>
  <para style="q2" vid="ACT 2:20">और जोनी खून हानी लाल हुई जाबैगी</para>
  <para style="q2" vid="ACT 2:20">प्रभु को महान और गौरवसाली दिन आन से पहले<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>और फिरौंकी जो कोई भी मदत के ताहीं प्रभु कै पुकारैगो बाकै बचाओ जागो।’”<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>“इस्राएलियौ! जे सब्दन कै सुनौ, नासरत को ईसु एक ऐसो इंसान रहै जोको ईस्वरीय अधिकार तुमकै बे सबै सामर्थ्य और चिन्ह चमत्कारन से सपा तरीका से सिद्ध भौ, जो परमेस्वर बाके जरिये करी रहै, जौ तुम खुद जानथौ, काहैकि हींना तुमरे बीच ऐसो भौ रहै। <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>अपनी योजना के अनुसार परमेस्वर पहलिये तैं कर लई रहै की ईसु कै तुमकै सौंप दौ जागो; और तुम पापियन के हात से क्रूस मैं चढ़ायकै बाकै मार डारे। <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>पर परमेस्वर बाकै मौत से उठाई, बाकै अपनी सक्ति से आजाद करी, काहैकि जौ मुम्किम नाय रहै कि मौत बाकै कैदी बनाये कै रखाबै। <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>दाऊद बाके बारे मैं कहथै,</para>
  <para style="q1" vid="ACT 2:25">‘मैं प्रभु कै हमेसा अपने अग्गु देखत रहथौं;</para>
  <para style="q2" vid="ACT 2:25">बौ मेरे झोने है, और मैं परेसान नाय होमंगो।<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>और इसलै मैं मन मैं खुसी से भरगौ,</para>
  <para style="q2" vid="ACT 2:26">और मेरे बचन खुसी से भरे हैं</para>
  <para style="q1" vid="ACT 2:26">और हालाकि मैं सारीरिक हौं,</para>
  <para style="q2" vid="ACT 2:26">आसा मैं हिम्मत दई जागी,<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>काहैकि तुम मोकै नरक के भीतर नाय छोड़ैगे;</para>
  <para style="q2" vid="ACT 2:27">तुम अपने वफादार दास कै सड़न ना देबैगे।<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>तैं तौ मोए जिंदगी की रहा बताओ है।</para>
  <para style="q2" vid="ACT 2:28">और तेरी मौजूदगी मोकै खुसी से भर देबैगी।’”<verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>“मेरे दोस्तौ, मोकै तुमसे हमरे प्रसिद्ध बड़े-बूढ़े राजा दाऊद के बारे मैं सपा तरीका से बात करनी चाहिए। बौ मर गौ और बाकै दफनाए दौ गौ, और बाकी कबर आज भी हमरे पास है। <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>बौ एक भविस्यवक्ता रहै, और बौ जानत रहै कि परमेस्वर बासे का वादा करी रहै: परमेस्वर एक प्रतिग्या दई रहै कि बौ दाऊद के बंस मैं से एक कै सिंहासन मैं बैठारैगो, जैसो कि दाऊद रहै। <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>दाऊद देखी कि आनबारे समय मैं परमेस्वर का करन जाएरौ है, और तभई बौ जब मसीहा के पुनरुत्थान के बारे मैं बात करी, तौ बौ कही,</para>
  <para style="q1" vid="ACT 2:31">‘बाकै नरक मैं नाय छोड़ो गौ रहै;</para>
  <para style="q2" vid="ACT 2:31">बाको सरीर कबर मैं नाय सड़त रहै।’<verse eid="ACT 2:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32"/>जहे ईसु कै परमेस्वर मौत से उठाई है, और हम सबै जौ बात के गभा हैं। <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>बौ परमेस्वर, बाके दऊवा के दहने घाँईं उठो भौ है, और बासे पवित्र आत्मा लई है, जैसो बौ वादा करी रहै। अब तुम जो देख और सुनरै हौ, बौ बाको उपहार है जो बौ हमरे ऊपर डारी है। <verse eid="ACT 2:33"/><verse number="34" style="v" sid="ACT 2:34"/>काहैकि बौ दाऊद नाय रहै जो स्वर्ग मैं गौ रहै; बल्किन बौ अपने आप बताथै।</para>
  <para style="q1" vid="ACT 2:34">‘प्रभु मेरे प्रभु से कही:</para>
  <para style="q2" vid="ACT 2:34">मेरे दहने बैठ<verse eid="ACT 2:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35"/>जबले कि मैं तेरे दुस्मन कै तेरे टाँग तरे की पुटली नाय कर दियौं।’”<verse eid="ACT 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>“इस्राएल के सबै लोग, जौ सुनिस्चित करन के ताहीं जानथैं कि जौ ईसु, जोकै तुम क्रूस मैं चढ़ाय रहौ बौ बहे है जोकै परमेस्वर प्रभु और मसीहा बनाई है!”<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>जब लोग जौ सुनीं, तौ परेसान भै और बे पतरस और दुसरे प्रेरितन से कहीं, “हम का करंगे भईय्यौ?”<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>पतरस उनसे कही, “पछताबौ और तुम सब अपने पापन की माफी के ताहीं ईसु मसीह के नाओं से बपतिस्मा लेयौ, तौ तुम पवित्र आत्मा को दान पाबैगे। <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>काहैकि तुम और तुमरे बाले-बच्चन के ताहीं परमेस्वर वादा करी रहै, और बे सब जो भौत दूर हैं, जिनकै हमरो प्रभु और परमेस्वर बुलाथै।”<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>पतरस निरी बातन से उनकै गभाई बताए कै समझाई भी “कि खुदकै हठेली जातिन से बचइयो!” <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>उनमैं से तमान लोग उनके संदेस कै मन से मानत रहैं और बपतिस्मा लेत रहैं, और बौ दिन समूह मैं लमसम तीन हजार लोगन को जोड़ा गौ रहै। बचन कै अपनाओ बौ बपतिस्मा <verse eid="ACT 2:41"/><verse number="42" style="v" sid="ACT 2:42"/>बे प्रेरितन की सिक्छा पान ताहीं, और संगती रखन ताहीं, रोटी तोड़न (प्रभु भोज) और प्रार्थना करन मैं मगन रहैं।<verse eid="ACT 2:42"/></para>
  <para style="s">विस्वासियन की जिंदगी</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43"/>प्रेरितन के जरिया निरे चिन्ह चमत्कार होत रहैं, और कोई के मन मैं डर बैठगौ रहै। <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>सबै विस्वासी करीबी संगती मैं संग-संग चलत रहैं और एक दूसरे के संग अपने सामान कै साझा करीं। <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>बे अपनी-अपनी धन-दौलत और समान बेंच-बेचकै जोकै जो चीज की जरूरत होत रहै बाकै बौ चीज दै देत रहैं। <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>और बे हर दिन एक मन हुईकै मंदिर मैं एक समूह के रूप मैं मिले, और बे अपने घरन मैं एक संग खुसी और विनम्र मन से खानु खाईं, <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>परमेस्वर की बड़ाँईं करनो, और सबै लोगन ऊपर दया की इच्छा रखनो। और जिनकै बचाओ जात रहै हर दिन प्रभु अपने झुंड मैं मिलाय देत रहै।<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s">लंगड़ा भिकमंगा को अच्छो होनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>एक दिन पतरस और यूहन्ना दुपारी के बाद तीन बजे प्रार्थना करन कै मंदिर मैं गै। <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>और लोग एक जनम के लंगड़ा कै लात रहैं, बाकै बे रोजाना मंदिर के फाटक जो सुगड़ कहो जात रहै, बैठार देत रहैं, कि मंदिर मैं जान बारेन से भीख माँगै। <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>जब बौ पतरस और यूहन्ना कै मंदिर भीतर जात देखी, तौ बौ उनसे कछु पान ताहीं नहोरे करी। <verse eid="ACT 3:3"/><verse number="4" style="v" sid="ACT 3:4"/>बे सीधे बाकै देखीं, और पतरस और यूहन्ना कही, “हमैं देख!” <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>तभई बौ उनके घाँईं देखी, बौ कछु पान की आसा करी। <verse eid="ACT 3:5"/><verse number="6" style="v" sid="ACT 3:6"/>लेकिन पतरस बासे कही, “मेरे झोने पैसा, सोनो नाय है, लेकिन मैं तोकै बहे देथौं जो मेरे झोने है: नासरत के ईसु मसीह के नाओं मैं, मैं तोकै उठन और नेंगन को आदेस देथौं!” <verse eid="ACT 3:6"/><verse number="7" style="v" sid="ACT 3:7"/>फिरौंकी बौ बाको दहनो हात पकड़कै बाकै उठाई। तुरंतै बाके पाँव और घूँटेन मैं ताकत आए गई; <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>और बौ तुरंतै कूदकै ठाड़गौ, फिर बौ चलन-फिरन लगो, और कूदत-फाँदत परमेस्वर की स्तुति करत भौ उनके संग मंदिर मैं गौ। <verse eid="ACT 3:8"/><verse number="9" style="v" sid="ACT 3:9"/>सब जनी बाकै चलत-फिरत और परमेस्वर की स्तुति करत भौ देखीं, <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>और जब बे बाकै बौ भिखारी के रूप मैं पहचानी, जो मंदिर के सुगड़ दुआर मैं बैठो रहै, तौ बे सबै अचम्मो करीं और बाके संग जो भौ बौ देखकै हक्का-बक्का रहगै।<verse eid="ACT 3:10"/></para>
  <para style="s">मंदिर मैं पतरस को भाँसड़</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>तौ लंगड़ा भिकमंगा कै पतरस और यूहन्ना के पच्छू-पच्छू नेंगत देखकै, सब आदमी इत्तो अचम्मो करीं कि जोकै सुलैमान की डेहरी कहत रहैं, उनके झोने दौड़त भै आए। <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>जब पतरस लोगन कै देखी, तौ बौ उनसे कही, “इस्राएल के लोगौ, तुम जौ बात मैं चकित काहे हौ, और तुम हमैं काहे घूरथौ? का तुमकै जौ लगथै कि जौ हमरी सामर्थ्य या परमेस्वर की भक्ति के जरिये रहै कि हम जौ आदमी कै बनाए? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>अब्राहम, इसहाक और याकूब को परमेस्वर, हमरो पुरखन को परमेस्वर अपने सेवक ईसु की महिमा करी है, जोकै तुम पकड़वान को फैसला करे पर पिलातुस बाकै छोड़न बारो रहे। <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>बौ पवित्र और धर्मी रहै, लेकिन तुम बाकै ना अपनाय, और जाके बजाय तुम पिलातुस कै सौंप दै और कहे कि बौ बाकै एक कातिल के रूप मैं बदल दियै। <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>तुम जिंदगी के घाँईं लै जान बारे कै मार डारे, लेकिन परमेस्वर बाकै मौत से उठाई और जौ बात के हम गभा हैं। <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>जौ बाके नाओं की सक्ति रहै कि लंगड़ा आदमी कै ताकत दई। जो तुम देखथौ और जानथौ बहे के नाओं मैं बिस्वास के जरिया भौ; जो ईसु मैं बिस्वास करन से अच्छो भौ, और जौ तुम सब देख सकथौ।”<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>“अब मेरे दोस्तौ, मोकै पता है कि तुम और तुमरे मुखिया ईसु के संग जो करीं बौ तुमरी अग्यानता के कारड़ रहै। <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>बहोत पहले जे बातन कै परमेस्वर सब भविस्यवक्तन से अग्गुए बताए दई रहे, कि बाको मसीह दुख भोगैगो, तौ ऐसे करकै बौ भविस्यवक्ता पूरी करी। <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>जहेमारे, परमेस्वर के झोने लौट आबौ कि बौ तुमरे पाप माफ करै अगर तुम पछताबौ, <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>प्रभु की सक्ति बहे के समय से आगी, और बौ ईसु कै पनारैगो, जो तुमरे ताहीं मसीहा ठहराव गौ है जोकै बौ तुमरे ताहीं पहलेई चुनी है। <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>जबले सबै चीजन कै नया बनान को ऐलान नाय करी जाबै, तौले स्वर्ग मैं रहने चाहिए, काहैकि परमेस्वर अपने पवित्र भविस्यवक्ता के जरिया ऐलान करी रहै। <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>काहैकि मूसा कही ‘तुमरो प्रभु तुमरो परमेस्वर तुमरे ताहीं एक भविस्यवक्ता भेज देगो, जैसी बौ मोकै भेजी रहै, और बौ तुमरेई लोगन मैं से एक होगो। तुम बौ सब कछु मानन बारे हौ जो बौ तुमकै करन कै कहथै। <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>जो कोई भी बौ भविस्यवक्ता को पालन नाय करथै, बौ परमेस्वर के लोगन से अलग हुई जाबैगो और अपने आप मैं खतम हुई जागो।’ <verse eid="ACT 3:23"/><verse number="24" style="v" sid="ACT 3:24"/>और समूएल से लैकै बाके बाद के सब भविस्यवक्ता जोभी संदेस बोली रहैं, बे सब जेईं दिनन की भविस्यवाँड़ी करीं रहैं कि जे दिनन का ही रौ है। <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>अपने भविस्यवक्तन के जरिये परमेस्वर के वादा तुमरे ताहीं हैं, और तुम बौ वाचा मैं भागी बनथौ जोकै परमेस्वर तुमरे परखन के संग बनाई रहै। जैसो कि बे अब्राहम से कहीं, ‘तुमरे बंसज के जरिये मैं धरती मैं सबै लोगन कै आर्सिवाद दुंगो।’ <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>और जहे ताहीं परमेस्वर अपने सेवक कै चुनी और तुमरे झोने पनारी, ताकी तुम सबन के ऊपर से बुराई खतम करकै आसीस देबै।”<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s">पंचायत के बीच पतरस और यूहन्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>जब पतरस और यूहन्ना लोगन से बात करत रहैं, तौ कुछ पुजारी, मंदिर के पहरेदारन के प्रभारी अधिकारी, और कुछ सदूकी पहोंचे। <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>बे गुस्सा रहैं काहैकि दुई प्रेरित लोगन कै सिखात रहैं कि ईसु मौत से जी उठ गौ रहै, जोसे जौ साबित हुई गौ कि मरो भौ आदमी जिंदगी मैं आगो। <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>तौ बे उनकै पकड़कै दुसरे दिन तक कैदखाना मैं बंद कर दईं, काहैकि पहलेई देर हुई चुकी रहै। <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>लेकिन उनको जौ संदेस सुनकै, उनमैं से निरे आदमी बिस्वास करीं; और जिनको आँकड़ा पाँच हजार के लमसम हुई गौ।<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>दुसरे दिन यहूदि मुखिया, बड़े-बूढ़े और यहूदि नियम के सिक्छा देनबारे यरूसलेम मैं जुराने। <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>बे बड़े पुजारी हन्ना और कैफा, यूहन्ना, सिकन्दर के संग, और जितने बड़े पुजारी के परिवार के रहैं उनसे मिले। <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>बे प्रेरितन कै सबके सामने ठड़बाए कै और उनसे पूँछीं, “तुम जौ काम कौनकी सामर्थ्य और कौनके नाओं से करथौ?”<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>तौ पतरस पवित्र आत्मा से भरकै उनकै जबाब दई, “लोगौ और बड़े-बूढ़े के मुखिया: <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>आदमिन के मुखियौ और बड़े-बूढ़े जौ लंगड़ा आदमी के संग तौ अच्छो करो गौ है, लेकिन आज हमसे जाके बारे मैं सवाल करथौ कि बौ कैसे अच्छो भौ है, <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>तौ तुम सब और पूरे इस्राएली आदमी जान लियो कि मसीह ईसु नासरी के नाओं से जोकै तुम सब क्रूस के ऊपर टाँगे, और परमेस्वर बाकै मरो भौ मैं से जिंदो कर दई, जौ बहे आदमी है तुमरे अग्गु अच्छो-भलो ठाड़ो है। <verse eid="ACT 4:10"/><verse number="11" style="v" sid="ACT 4:11"/>ईसु ही बौ है जोके बारे मैं धर्मग्रंथ करथै,</para>
  <para style="q1" vid="ACT 4:11">जौ बहे पथरा है जोकै राजमिस्त्री बेकार समझी,</para>
  <para style="q2" vid="ACT 4:11">‘बौ सबन के ताहीं कोहने को खास पथरा बन गौ।’<verse eid="ACT 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12"/>उद्धार कोई दुसरे के जरिया नाय है; काहैकि स्वर्ग के तरे आदमिन मैं और कोई दुसरो नाओं ही नाय दौ गौ है, जोके जरिया हम मुक्ति पाये सकथैं।”<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>जब पंचायत के आदमी देखीं तौ बे अचम्मे मैं पड़ गै, पतरस और यूहन्ना की हिम्मत देखकै जानगै कि जे अनपढ़ और साधारँड़ से आदमी हैं बे बड़ा ताजुब करीं; फिर उनकै पता चल गौ, कि जे ईसु के संग रहत रहैं। <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>लेकिन ऐसो कछु नाय रहै जो बे कह सकत रहैं, काहैकि बे बौ अच्छो आदमी कै देखी रहैं जो पतरस और यूहन्ना के संग हुँआँ ठाड़ो रहै। <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>जहे बजे से बे उन्हैं पंचायत घर कै छोड़न के ताहीं कहीं, और फिर बे आपस मैं चर्चा करन लगे। <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>“हम जे आदमिन के संग का करंगे?” बे पूँछीं। “यरूसलेम मैं हर कोई जानथै कि जौ असाधारड़ चिन्ह चमत्कार उनके जरिये करो गौ है और, हम बाकै नकार भी नाय सकथैं। <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>लेकिन जौ बात आदमिन के बीच फैलन से रोकन के ताहीं, आबौ हम जे लोगन कै चितौनी देमैं कि ईसु के नाओं से कहु कोई से बात ना करै।”<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>तौ पतरस और यूहन्ना कै बुलाएकै और चितौनी देत भै जौ कहीं, ईसु के नाओं से ना कछु बोलियो और ना कछु सिखईयो। <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>लेकिन पतरस और यूहन्ना उनकै जबाब दईं, “तुम्हईं न्याय करौ, ठीक काहैकि परमेस्वर की बात नाय मानकै तुमरी बात मान लेमैं। <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>ऐसो तौ हम नाय कर पांगे, कि जो हम देखे और सुने, बौ ना सिखामैं।” <verse eid="ACT 4:20"/><verse number="21" style="v" sid="ACT 4:21"/>तौ बे उनकै और कड़ी चितौनी दैकै छोड़ दईं, बे देखीं कि उनकै सजा देनो नामुमकिन रहै, काहैकि जो कछु हुँआँ रहै, बाके ताहीं सब जनी परमेस्वर की बड़ाँईं करत रहैं। <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>जो आदमी के ऊपर अच्छो करन को चिन्ह चमत्कार दिखाओ गौ रहै, बौ चालीस साल की उमर से भी जाधे को रहै।<verse eid="ACT 4:22"/></para>
  <para style="s">विस्वासियन के साहस के ताहीं प्रार्थना</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>पतरस और यूहन्ना छुटकै अपने साथियन के झोने आए, और जो कछु मुखिया पुजारिन और बड़े-बूढ़े कही रहैं, उनकै सुनाए दईं। <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>जौ सुनकै बे सब विस्वासी परमेस्वर से प्रार्थना करन लगे: “हे स्वर्ग, धरती, और समुंदर के मालिक और सब कछु बनान बारे, जौ सब बामै है! <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>तैं पवित्र आत्मा के जरिया अपने सेवक हमरे पुरखा दाऊद के मोहों से बोलो, जब बौ कही,</para>
  <para style="q1" vid="ACT 4:25">‘गैर यहूदि हुलगदड़ काहे मचाथैं;</para>
  <para style="q2" vid="ACT 4:25">और देस-देस के आदमी काहे बेकार की बात सोचथैं?<verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>पृथ्वी के राजा अपने आपकै तैयार करीं,</para>
  <para style="q2" vid="ACT 4:26">और सासक आपस मैं मिल गै</para>
  <para style="q2" vid="ACT 4:26">प्रभु और उनके मसीह के खिलाप।’<verse eid="ACT 4:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27"/>काहैकि सच्ची मैं तेरे पवित्र सेवक ईसु के खिलाप मैं, जोकै तू अभिसेक करो, हेरोद और पुन्तियुस, पिलातुस, गैर यहूदि और इस्राएलियौ के संग जहे सहर मैं जुराए गै। <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>ताकी जो कछु अग्गुए से ठहराओ रहै, तेरी ताकत और इच्छा से बैसो ही होबै। <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>और अब प्रभु, उनकी धमकियन मैं ख्याल कर और अपने सेवकन कै बिना डराय तेरो बचन पूरी हिम्मत से सुनाए सकैं। <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>अच्छो करन के ताहीं तैं अपनो हात हमरे अग्गु कर, ताकी चिन्ह चमत्कार और अनोखे काम तेरे पवित्र सेवक ईसु के नाओं से करे जामैं।”<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>जब बे पूरी प्रार्थना कर डारीं, जो जघा मैं सब जुराए रहैं, तौ सबके भीतर पवित्र आत्मा समाए गई, और बे बिना डरे परमेस्वर को बचन सुनात रहैं।<verse eid="ACT 4:31"/></para>
  <para style="s">विस्वासी अपने हिस्सा कै एक दुसरे कै बाटीं</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>बिस्वास करन बारेन को एक बड़ो झुंड रहै, जोकी एक मनसा और एक मन के रहैं। कोइयो जौ नाय कहत रहै की बाकी चीज खुद की हैं। उनके झोने जो कछु रहे, बौ चीज कै आपस मैं साझा लेत रहैं। <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>बड़ी सामर्थ्य के संग प्रेरित प्रभु ईसु के मौत से जी उठन की गभाई दईं, और परमेस्वर उन सबन के ऊपर भरपूर अनुग्रह डारी। <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>समूह मैं ऐसो कोईये नाय रहै जो जरूरतमंद होबै। जो लोग खेतन कै या घरन के मालिक रहैं, बे उनकै बेंच देते और बासे जो भी पैसा मिलत रहै बाकै बे लायकै, <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>प्रेरितन कै सौंप देत रहैं; और लोगन की जरूरतन के हिसाब से पैसा बाँट दौ जात रहै।<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>यूसुफ नाओं को एक लेवी जो साइप्रस मैं पैदा भौ रहै, लेकिन प्रेरित बाको नाओं बरनबास जोको मतलब है “हौंसला देन बारो,” <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>बौ अपने खेत कै बेंच दई और पैसा लायकै, प्रेरितन कै सौंप दई।<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s">हनन्याह और सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>हनन्याह नाओं को एक आदमी रहै, और बाकी बईय्यर को नाओं सफीरा रहै, तौ बे जमीन को एक हिस्सा बेचीं। <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>बौ अपनी बईय्यर के संग मिलकै बामै से कुछ पैसा धर लई और बचे भै पैसा प्रेरितन कै दै दई। <verse eid="ACT 5:2"/><verse number="3" style="v" sid="ACT 5:3"/>तौ पतरस कही, “हनन्याह, तू सैतान कै अपने मन मैं काहे घुसन दौ कि तू पवित्र आत्मा के अग्गु झूठ बोलो और जमीन बेचकै मिले भै पैसन मैं से धर लौ? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>जब तक सम्पत्ति तेरे झोने रहै, का बाको अधिकार तेरो नाय रहै? और जब तू बेंचो बौ पैसा का तेरे अधिकार मैं नाय रहै? तैं जौ बात अपने मन मैं काहे सोचो? तैं आदमिन से नाय, बल्किन परमेस्वर से झूठ बोलो है!” <verse eid="ACT 5:4"/><verse number="5" style="v" sid="ACT 5:5"/>जौ बात सुनकै हनन्याह जमीन मैं मोखरा गिर गौ और तुरंतै बाकी ज्यान निकर गई। तौ सब सुनन बारेन कै बड़ा डर छाए गौ। <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>तौ ज्वान आदमी उठकै बाकी अर्थी बनाईं और दुआरे लै जाएकै दफनाए दईं।<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>लमसम तीन घंटा बाद, जो कुछ हूँना भौ रहै, बाकी बईय्यर कै कछुए पता नाय रहै और बौ सीधे भीतर आई। <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>तौ पतरस बासे कही, “मोकै बता का तुम बौ जमीन कै इत्ते मैं बेंचे रहौ?” बौ कही, “हाँ, इत्तेई मैं।”<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>तौ पतरस बासे कही, “तुम दोनों प्रभु की आत्मा की इम्तिहान लेन के ताहीं कैसे राजी ही गै? देख तेरे लोगा कै दफनान बारेन के पाँव फाटक तक आए चुके हैं और बे तहूँ कै उठाएकै लै जामंगे!” <verse eid="ACT 5:9"/><verse number="10" style="v" sid="ACT 5:10"/>और बौ तुरंतै उनके पाँव मैं गिर पड़ी और बौ खतम हुई गई, तौ ज्वान आदमी भीतर आए कै बाकै मरी भइ पाईं, और दुआरे लै जाएकै बहे के लोगा झोने बाकै दफनाए दईं। <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>तौ पूरी कलीसिया मैं जे बात सब सुनन बारेन के ऊपर बड़ा डर छाए गौ।<verse eid="ACT 5:11"/></para>
  <para style="s">निसान और चमत्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>प्रेरितन के हात से निरे चिन्ह और अनोखे काम आदमिन के बीच मैं दिखाए जात रहैं, और बे सब एक मन हुईकै सुलैमान की डेहरी मैं जुरात रहैं। <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>लेकिन औरन मैं से कोई की हिम्मत नाय होत रहै कि, उनमैं मिल जामैं; तहुँओं आदमी उनकी बड़ा बात करत रहैं। <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>लेकिन बिस्वास करन बारे निरे आदमी और बईंय्यरैं प्रभु की कलीसिया मैं बड़तै जात रहैं। <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>प्रेरितन के कामन के हिसाब से आदमी बिमारन कै सड़कन मैं लाए लायकै, खटिया और मुंदरा मैं लिटाए देत रहैं, कि जब पतरस आबै, तौ बाकी छाँईं उनके ऊपर पड़ जाबै। <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>और यरूसलेम के आस-पास के सहरन मैं से आदमिन की बड़ी भीड़, जो बिमार और प्रेत आत्मा के सताए भैन कै लात रहैं; और सबन कै अच्छो कर दौ जात रहै।<verse eid="ACT 5:16"/></para>
  <para style="s">प्रेरितन कै सताओ जानो</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>तौ बड़ो पुजारी और बाके सब संग के जो सदूकी स्थानीय दल के सदस्य रहैं, बे जलन से भरकै प्रेरितन के बिरोध मैं सलाह करीं और फैसला लईं। <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>और प्रेरितन कै पकड़कै उन्हैं सार्वजनिक कैदखाना मैं डार दईं। <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>लेकिन रात कै प्रभु को एक स्वर्गदूत कैदखाना के फाटक खोलकै, प्रेरितन कै दुआरे निकारी, और उनसे कही, <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>“जाबौ मंदिर मैं ठाड़े रहाबौ, और लोगन कै जौ नई जिंदगी की बातन कै बताबौ।”<verse eid="ACT 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21"/>प्रेरित आग्या को पालन करीं, और भोर होतै खिना मंदिर मैं जाएकै सिक्छा देन लागे। तौ बड़ो पुजारी और बाके सब संग बारे आयकै बड़ी पंचायत मैं इस्राएलियन के सब बड़े-बूढ़ेन कै एक संग बुलाई; तौ बे प्रेरितन कै कैदखाना से लान को आदेस दईं। <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>लेकिन जब अधिकारी पहुँचे तौ प्रेरितन कै कैदखाना मैं नाय पाईं, और लौटकै पंचायत मैं खबर दईं, <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>“हम कैदखाना के चौकीदारन के और फाटक कै सई-सलामत बंद पाए; लेकिन जब खोले, तौ भीतर कोईये नाय मिलो!” <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>जब मंदिर के मुखिया पुजारी और चौकीदार के अधिकारी जे बात सुनीं, तौ बड़ा सोच मैं पड़ गै कि प्रेरितन को का भौ। <verse eid="ACT 5:24"/><verse number="25" style="v" sid="ACT 5:25"/>तभईये एक आदमी आओ और उनसे कही, “सुनौ! जिनकै तुम कैदखाना मैं डारे रहौ, बे लोगन कै मंदिर मैं उपदेस दे रै हैं!” <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>तभईये अधिकारी, सिपईय्यन के संग जाएकै, प्रेरितन कै लै आईं लेकिन जबरजत्ती से नाय, काहैकि बे आदमिन से डरात रहैं कि उनके ऊपर पथराव नाय कर देमैं।<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>बे प्रेरितन कै लायकै बड़ी पंचायत के अग्गु ठड़बाए दईं; और बड़ो पुजारी उनसे पूँछताछ करी। <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>बे कहीं, “का हम तुमकै कड़ो आदेस ना दै रहैं कि तुम जौ आदमी के नाओं से उपदेस मत दियो; लेकिन देखौ तुम का करे हौ! तुम पूरे यरूसलेम मैं अपने उपदेसन कै फैलाय दै हौ, और तुम बाके खून को इल्जाम हमरे ऊपर लगानो चाहथौ!”<verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>पतरस और दुसरे प्रेरित उनकै जबाब दईं, “हमैं परमेस्वर कै माननो चाहिए, ना कि आदमिन कै। <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>हमरे परखन को परमेस्वर ईसु कै जिंदो करी, जोकै तुम क्रूस मैं टँगाए कै मार डारे रहौ। <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>परमेस्वर बाकै अपने दहने हाथ को नेता और उद्धारकर्ता के रूप मैं उठाई, ताकी इस्राएलियन कै पछतान को मौका दौ जाए सकै और पापन कै माफ कर देबै। <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>हम जे बातन के गभा हैं, और बैसिये पवित्र आत्मा भी जोकै उपहार के रूप मैं परमेस्वर उनकै दई है जो बाकी आग्या मानथैं।”<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>जब पंचायत के सदस्य जौ सुनीं, तौ बे इतने गुस्सा मैं रहैं कि बे चहात रहैं कि प्रेरितन कै मौत के घाट उतार दौ जाबै। <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>लेकिन गमलीएल नाओं को एक फरीसी जो नियम के सिक्छकन और सब आदमिन मैं बड़ा पहोंचो भौ रहै, पंचायत मैं ठाड़कै प्रेरितन कै जरा देर दुआरे जान ताहीं कही। <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>तौ बौ पंचायत से कही “हे इस्राएलियौ, जो कछु तुम जे आदमिन के संग करनो चाहथौं, सोच समझकै करियो। <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>तुमकै याद है कुछ समय पहले थियूदासौ कहत भौ उठो, कि महुँ कछु हौं<note caller="+" style="f"><char style="fr" closed="false">5:36 </char><char style="ft" closed="false">महान हौं</char></note>; और बाके संग कम से कम चार सौ आदमी ही गै, लेकिन बौ मारो गौ, और जित्ते आदमी बाकै मानत रहैं तितर-बितर ही गै और बाको आन्दोलन खतम हुई गौ। <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>बाके बाद गलीलियन जनगड़ना के समय मैं यहूदा दिखाई दई, बौ बाके बाद एक भीड़ कै अपने घाँईं कर लई; लेकिन बहो खतम हुई गौ, और जित्ते आदमी बाकै मानत रहैं बे सब तितर-बितर ही गै। <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>और जहे ताहीं जौ मामले मैं, मैं तुमसे कहथौं, इनसे कोई मतलब भी मत रखियो; और इनकै अकेलो छोड़ देयौं! अगर जौ योजना आदमिन घाँईं से होगी तौ अपने आपै खतम हुई जागी, <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>लेकिन अगर परमेस्वर के घाँईं से है तौ तुम उनकै कहुए नाय रोक पाबैगे। कहूँ ऐसो नाय होबै कि तुम अपने आपकै परमेस्वर के खिलाप लड़त भइ पाबौ!” तौ पंचायत गमलीएल की सलाह मान लईं।<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>फिर बे प्रेरितन कै भीतर बुलबाईं, और कोड़ा लगवाईं, और आदेस दईं, कि बे फिर ईसु के नाओं से फिर कहुए बात ना करैं; और फिर बे उन्हैं आजाद कर दईं। <verse eid="ACT 5:40"/><verse number="41" style="v" sid="ACT 5:41"/>प्रेरित जौ बात से खुस हुईकै पंचायत के अग्गु से निकर गै, कि हम ईसु के नाओं के ताहीं बेईज्जत होन के लायक तौ बने। <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>जाके बाद हर रोज मंदिर मैं और लोगन के घरन मैं जाए-जाएकै ईसु मसीह के बारे मैं सुसमाचार सुनाते और प्रचार करनो जारी रखत रहैं।<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s">सात सेवक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>कुछ समय बाद, जैसे-जैसे सेवकाई मैं चेलन की गिनती बढ़त रहै, यूनानी भासा बोलन बारे यहूदिन के बीच और इब्रानी यहूदियन के बीच लड़ाई होन लगी। यूनानी भासा बोलन बारे यहूदि दाबा करीं, कि खान-पीन मैं उनकी बिधवन की खैर-खबर नाय लई जाए रइ है। <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>तौ बे बारह चेलन के विस्वासी समूह कै एक संग बुलाई और कही, “जौ तौ अच्छो नाय है कि आपन परमेस्वर के बचन को प्रचार छोड़ खबान-पिबान की सेवा मैं रहमैं। <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>जहे बजह से भईय्यौ, आपन मैं से सात भले आदमिन कै जो पवित्र आत्मा और बुद्धि से भरे होमैं, छाँट लेबौ, कि हम उनकै जौ काम मैं लगाए देमैं। <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>तौ हम खुद, अपनो पूरो समय प्रार्थना और प्रचार के काम मैं देंगे।”<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>जौ राय पूरे समूह कै अच्छी लागी, तौ बे स्तिफनुस नाओं के एक आदमी कै जो बिस्वास और पवित्र आत्मा से भरो रहै, और फिलिप्पुस, प्रुखुरुस, नीकानोर, तीमोन, परमिनास और अन्ताकिया मैं रहेन बारे नीकुलाउस जो यहूदि धर्म मैं बदल गै रहैं, चुन लई। <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>समूह उन्हैं प्रेरितन के अग्गु ठड़बाईं और प्रार्थना करकै उनके ऊपर हात धरी।<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>और परमेस्वर को बचन फैलत गौ। और यरूसलेम मैं चेलन की गिनती बड़ा बढ़त गई, और पुजारी को एक बड़ो समाज जौ बिस्वास कै मानन बारो ही गौ।<verse eid="ACT 6:7"/></para>
  <para style="s">स्तिफनुस को पकड़ो जानो</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>स्तिफनुस, एक आदमी जो परमेस्वर के अनुग्रह पाओ भौ रहै और सामर्थ्य से भरपूर भरो रहै, बौ लोगन के बीच बड़े-बड़े अचम्मे काम और चिन्ह दिखात रहै। <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>लेकिन बौ कुछ आदमिन के जरिये बिरोध करो गौ रहै जो आजाद करन बारेन<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">जे यहूदि रहैं, जो गुलाम रहैं, लेकिन खरीदे गै रहैं या उनकै उनकी आजादी दई गई रहै।</char></note> के सभाघरन के सदस्य रहैं, जैसो कि जाकै कहो जाथै, जोमैं कुरेनी और सिकन्दरिया के यहूदि सामिल रहैं। बे और दूसरे आदमी किलिकिया और आसिया के देसन से स्तिफनुस के संग बहस कर लागे। <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>लेकिन आत्मा स्तिफनुस कै ऐसो ग्यान दई कि जब बौ बोलो, तौ बे बाके अग्गु टिक ना पाईं। <verse eid="ACT 6:10"/><verse number="11" style="v" sid="ACT 6:11"/>तौ बे कई लोगन कै घूस दईं जो कहेन लगे, “हम जाकै मूसा और परमेस्वर के खिलाप बुरो-भलो कहत सुने हैं।” <verse eid="ACT 6:11"/><verse number="12" style="v" sid="ACT 6:12"/>ऐसे करकै बे आदमिन कै, बड़े-बूढ़ेन और यहूदि नियम के सिक्छकन कै हलाए दईं। बे स्तिफनुस कै पकड़कै पंचायत मैं लै आए। <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>फिर बे कुछ आदमिन कै बाके बारे मैं झूठ गभन के ताहीं लै आए। बे कहीं, “जौ आदमी, हमेसा हमरे पवित्र मंदिर और मूसा के नियम के खिलाप बोलथै। <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>हम बासे जौ कहत सुने हैं कि जहे ईसु नासरी जौ मंदिर कै उजाड़ देगो, और बे रीतियन कै बदल देगो जोकी मूसा हमकै दई है!” <verse eid="ACT 6:14"/><verse number="15" style="v" sid="ACT 6:15"/>तौ सब आदमी जो पंचायत मैं बैठे रहैं, स्तिफनुस कै निहारकै देखीं कि बाको मोहों एक स्वर्गदूत के मोहों के हानी दिखात रहै।<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s">स्तिफनुस को भाँसड़</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>बड़ो पुजारी स्तिफनुस से पूँछी, “का जौ सच्ची है?”<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>स्तिफनुस जबाब दई, “भईय्यौ और बड़े-बूढ़े सुनौ! हमरो पुरखा अब्राहम हारान सहर मैं बसन से अग्गु जब मेसोपोटामिया मैं रहै; तौ महिमा मैं परमेस्वर बाकै दर्सन दई <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>और बासे कही, ‘अपने देस और अपने परिवार कै छोड़कै तू बौ जघा मैं चले जा, जो तोकै मैं दिखांगो।’ <verse eid="ACT 7:3"/><verse number="4" style="v" sid="ACT 7:4"/>और जहे बजह से बौ कसदियों के देस कै छोड़कै हारान मैं रहन चले गौ। अब्राहम के दऊवा के खतम होन के बाद, परमेस्वर बाकै हूँना से जौ जघा मैं लाई जहाँ अब तुम रहथौ। <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>परमेस्वर अब्राहम कै कोई हिस्सा नाय दई, हिंयाँ तक कि बाके पास जमीन को एक मीटर तक नाय रहै, लेकिन परमेस्वर बाकै देन को वादा करी रहै, और जौ कि बौ बाके और बाके बंसज को होगो। जो समय परमेस्वर जौ बचन दई, बौ समय अब्राहम की कोई औलाद नाय रहै। <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>परमेस्वर बासे ऐसो वादा करी: ‘तेरी औलाद दुसरे देस मैं परदेसी होमंगे, और बे गुलाम बनंगे, और 400 साल तक बे दुख उठामंगे। <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>तौ मैं परमेस्वर कमईंयन के मालिकन के ऊपर फैसला लेंगो और तुमरे बंसज बौ देस से निकरकै जहे जघा मैं मेरी महिमा करंगे।’ <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>तौ परमेस्वर अब्राहम से खतना की वाचा भाँदी। जहे बजह से अब्राहम इसहाक के पैदा होन के एक सप्ताह के बाद बाको खतना करी; इसहाक अपने लौड़ा याकूब को खतना करी, और याकूब अपने बारह लौड़न को खतना करी, हमरी जाति के प्रसिद्ध परखन को खतना भौ।”<verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>“याकूब के लौड़ा अपने भईय्या यूसुफ से जलन लगे और बाकै मिस्र देस मैं गुलाम बनन के ताहीं बेंच दई। लेकिन परमेस्वर बाके संग रहै” <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>और परमेस्वर यूसुफ की सब परेसानी से छुड़ाय कै मिस्र के राजा फिरौन के सामने आओ, तौ परमेस्वर बाकै खुस करन के तरीका अनुग्रह और ग्यान दई, और राजा बाकै मिस्र को और अपने पूरे घराने को राज्यधिकारी बनाई। <verse eid="ACT 7:10"/><verse number="11" style="v" sid="ACT 7:11"/>तौ मिस्र और कनान मैं आकाल पड़ो; और बड़ो संकट आओ, और हमरे बड़े-बूढ़ेन कै अन्न नाय मिलन लगो। <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>जब याकूब जौ सुनी, कि मिस्र मैं अन्न हैं, तौ बौ अपने लौड़न कै, और हमरे परखन कै पहली बार हूँना पनारी। <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>दुसरी बार यूसुफ अपने आपकै अपने ददा-भईय्यन के सामने लै आई, तौ यूसुफ के परिवार के बारे मैं फिरौन राजा कै पता चलो। <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>जहे बजह से यूसुफ अपने आप से अपने दऊवा याकूब और अपने पूरे परिवार कै, जो 75 जनी रहैं, मिस्र मैं आन की खबर पनारी। <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>तौ याकूब मिस्र गौ, और हूँना पर बौ और बाके लौड़ा हूँनै खतम ही गै। <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>उनकी लास सेकेम मैं लै जाएकै, कबर मैं दफनाओ गौ रहै जोकै अब्राहम पैसा दैकै हामोर जाति से खरीदी रहै।<verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>जब परमेस्वर को वादा अब्राहम से पूरो करन को समय आओ तौ मिस्र मैं हमरे लोगन की गिनती निरी बढ़ गई रहे। <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>आखरी मैं एक राजा जो यूसुफ कै नाय जानत रहै, मिस्र मैं राज करन लगो। <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>बौ हमरे लोगन के संग विस्वासघात करी और हमरे पुरखन कै उनके नवजात बालकन कै बाहर फेंकन के ताहीं बेबस करी ताकी बे मर जामैं। <verse eid="ACT 7:19"/><verse number="20" style="v" sid="ACT 7:20"/>बहे समय मूसा को जनम भौ; और बौ परमेस्वर की नजर मैं भौत सुगड़ रहै। और बौ तीन महेना ले अपने घर मैं पालो पोसो गौ, <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>और जब बाकै अपने घर से बाहर कर दौ गौ, तौ फिरौन राजा की लौड़िया बाकै उठाए लाई और अपनो लौड़ा करकै पाली। <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>और मूसा कै मिस्रियन की सब सिक्छा दई गईं, और बौ सब्दन मैं और कामन मैं एक महान आदमी बन गौ।<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>“जब मूसा चालीस साल को भौ, तौ बाके मन मैं जौ बात पता लगान को फैसला करी कि बाके संग के इस्राएलियन के संग कैसो बर्ताव कर रै हैं। <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>बौ देखी कि उनमैं से एक मिस्र के लोगन के संग अन्याय कर रौ है, जहे बजह से बौ बाकी मदत के ताहीं गौ और मिस्रियन कै मारकै बाको बदला लई। <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>मूसा सोची की बाके अपने लोग जौ समझंगे कि परमेस्वर बाके हातन से उनको उद्धार करैगो लेकिन बे नाय समझ पाईं। <verse eid="ACT 7:25"/><verse number="26" style="v" sid="ACT 7:26"/>दुसरे दिन मूसा दुई इस्राएली आदमिन कै लड़त भइ देखी, बौ उनके बीच सांति बनान की कोसिस करी। और बौ कही, ‘सुनौ, तुम एक संग के इस्राएली हौ; तुम एक दुसरे ऊपर काहे अन्याय करथौ?’ <verse eid="ACT 7:26"/><verse number="27" style="v" sid="ACT 7:27"/>लेकिन जो दूसरे के संग अन्याय करत रहै, बौ मूसा कै एक घाँईं धकियाए दई। बौ पूँछी, ‘कौन तोकै सासक बनाओ और हमरो फैसला करन कै कही?’ <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>‘तू जैसे कल मिस्री कै मारो रहै, का महुँ कै मार डारनो चाहथै?’ <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>जब मूसा जौ सुनी, तौ बौ मिस्र से भाज गौ और मिद्दान देस मैं रहेन चले गौ। और हूँना बाके दुई लौड़ा पैदा भै।”<verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>“जब पूरे चालीस साल गुजर गै, तौ एक स्वर्गदूत सीनै पहाड़ के झोने रेगिस्तान मैं बाकै जलत भइ झाड़ी की लपट मैं दिखाई दई। <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>मूसा जौ देखकै अचम्मो भौ, और देखन ताहीं जब बौ झाड़ी के झोने गौ, तौ प्रभु की अबाज सुनाई दई: <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>‘मैं तेरे पुरखा अब्राहम, इसहाक और याकूब को परमेस्वर हौं।’ तौ मूसा कपकपाए गौ, हींना तक की बाकै देखन की हिम्मत नाय रही। <verse eid="ACT 7:32"/><verse number="33" style="v" sid="ACT 7:33"/>प्रभु बासे कही, ‘अपनी चप्पल खोल दे, जो जघा मैं तू ठाड़ो है, बौ पवित्र जघा है। <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>मैं मिस्र मैं अपने आदमिन की हालत कै देखो हौं; और उनको कराहनो सुनो हौं, और उनकै छुड़ान के ताहीं उतरो हौं। अब आबौ; मैं तुमकै मिस्र पनारंगो।’”<verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>“मूसा बहे है जोकै इस्राएल के लोग जौ कहकै नकारी रहैं, बे पूँछीं, ‘कौन तोकै सासक बनाओ और हमरो फैसला करन कै कही?’ मूसा बौ है जोकै परमेस्वर लोगन के ऊपर सासन करन के ताहीं पनारी है और उनकै स्वर्गदूत की मदत से आजाद करी जो जलत भइ झाड़ी मैं दिखाई दई रहै। <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>जहे मूसा मिस्र देस के लोगन कै मिस्र और लाल समुंदर मैं और रेगिस्तान मैं चालीस साल तक चमत्कार और चिन्ह दिखाए-दिखाए कै उनकै निकार लाई। <verse eid="ACT 7:36"/><verse number="37" style="v" sid="ACT 7:37"/>मूसा बहे है, जो इस्राएल के लोगन से कही रहै, ‘परमेस्वर तुमरे ताहीं एक भविस्यवक्ता भेजैगो, जैसे बौ मोकै भेजी, और बौ तुमरेई लोगन मैं से एक होगो।’ <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>जौ बहे है, जोकै जो रेगिस्तान मैं जुराने इस्राएल के लोगन के संग रहै; बहे स्वर्गदूत के संग सीनै पहाड़ मैं बासे बात करी रहै, और आपन के परखन के संग रहै, और बौ हमरे झोने जान के तहीं परमेस्वर के जिंदे संदेस लई।”<verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>“लेकिन हमरे पुरखा बाकी बात मानन से मना कर दईं; बे बाकै एक घाँईं धकयाईं और चाँहीं कि बे मिस्र बापस जाए सकथैं। <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>तौ बे हारून से कहीं, ‘हमरे ताहीं ऐसो दुईता बनाए दे जो हमरे अग्गु-अग्गु नेंगै, काहैकि जहे मूसा जो हमकै मिस्र देस से निकारकै लाई, हमकै नाय मालुम है कि बाको का भौ।’ <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>बे दिनन मैं बे एक बछड़ा की मूर्ति बनाएकै बाके अग्गु बलि चढ़ाईं, बाके आदर मैं खानु खाईं। <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>तौ परमेस्वर उनसे दूर हुई गौ, और स्वर्ग के तारामंडल कै पूजत रहामैं, जैसो कि भविस्यवक्ता की किताब मैं लिखो है:</para>
  <para style="q1" vid="ACT 7:42">‘इस्राएल के लोगौ! जौ मेरे ताहीं ना रहै</para>
  <para style="q2" vid="ACT 7:42">कि तुम रेगिस्तान मैं चालीस साल तक जानवरन को</para>
  <para style="q2" vid="ACT 7:42">मारे और बलि करत रहे।<verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>जौ बौ दुईता मोलेक को तम्बु रहै जोकै तुम ढ़ोए रहौ,</para>
  <para style="q2" vid="ACT 7:43">और रिफान की छवी, तुमरो तारा दुईता;</para>
  <para style="q2" vid="ACT 7:43">बे मूर्ति रहैं जिनकै तुम पूजा करन के ताहीं बनाए रहौ।</para>
  <para style="q1" vid="ACT 7:43">और तभईये मैं तुमकै बेबीलोन से भी दूर भजाए दुंगो।’”<verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>“परमेस्वर को तम्बु रेगिस्तान मैं हमरे पुरखन के बीच मैं साक्छी रहै। और बौ ऐसो बनो रहे जैसो परमेस्वर मूसा से चहात रहे, जैसो ढाँचो मूसा देखी रहे। <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>बाद मैं, हमरे पुरखा अपने बाप-दादोन से तम्बु पाईं, जब बे यहोसू के संग गै और देसन से जमीन मैं कब्जा कर लईं जोकै परमेस्वर अग्गु बढ़ाई। और दाऊद के समय तक बौ हूँनै रहो। <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>और परमेस्वर बाके ऊपर दया करी; फिर परमेस्वर बाकै इजाजत दई, कि बौ याकूब के परमेस्वर के तम्बु ताहीं बसन की जघा बनाबै। <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>लेकिन जौ सुलैमान रहै जो बाके ताहीं एक घर बनाई।”<verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>“लेकिन परमप्रधान दऊवा परमेस्वर इंसान के हात को बनो भौ घर मैं नाय बास करथै; जैसो कि भविस्यवक्ता कहथै:<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>‘प्रभु कहथै, स्वर्ग मेरो सिंहासन है,</para>
  <para style="q2" vid="ACT 7:49">और पृथ्वी मेरे पाँवों तरे की चौकी है।</para>
  <para style="q1" vid="ACT 7:49">तुम मेरे ताहीं कैसो घर बनाबैगे?</para>
  <para style="q2" vid="ACT 7:49">और मेरे ताहीं रहन की जघा कहाँ है?<verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>का जे सब चीज मेरे हात की बनाई भइ नाय हैं?’”<verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>“तुम कित्ते जिद्दी हौ!” कहनै मैं स्तिफनुस चले गौ। “तुम अपने मन कै कित्तो पवित्र करथौ, तुम परमेस्वर के संदेस मैं कित्ते ध्यान देनबारे हौ! तुम अपने पुरखन के हानी हौ: तुम हमेसा पवित्र आत्मा को बिरोध करे हौ! <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>भविस्यवक्ता मैं से कौनकै तुमरे पुरखा नाय सताईं रहैं? बे परमेस्वर के दूतन कै मारडारीं, जो भौत पहले अपने धर्मी सेवक के आन के बारे मैं घोसड़ाँ करी रहैं। और अब तैं बाकै धोका दैकै मार डारो है। <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>तुम बहे हौ जो परमेस्वर के नियम पाईं जो स्वर्गदूतन के जरिया दौ गौ रहै, फिर भी तुम जाको पालन ना करे!”<verse eid="ACT 7:53"/></para>
  <para style="s">स्तिफनुस के ऊपर पथराव</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>जब पंचायत के सदस्य स्तिफनुस की बात सुनीं तौ बे गुस्साय गै और बाके ऊपर दाँत मीसन लागे। <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>लेकिन स्तिफनुस पवित्र आत्मा से भरकै स्वर्ग के घाँईं देखी और परमेस्वर की महिमा और ईसु कै परमेस्वर के दहने घाँईं ठाड़ो देखकै <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>कही, “देखौ! मैं स्वर्ग कै खुलो भौ और आदमी के लौड़ा कै परमेस्वर के दहने घाँईं ठाड़ो भौ देखथौं!”<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>जोर से रोन के संग पंचायत के सदस्य अपने कानन कै हातन से मूंद लईं और जुराए कै बाके ऊपर चढ़ बैठे, <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>और बाकै सहर के बहार निकारकै पथराव करन लागे। और जो गभा रहैं अपने लत्ता उतारकै साऊल नाओं को एक ज्वान कै देखाभारी के ताहीं छोड़ दईं। <verse eid="ACT 7:58"/><verse number="59" style="v" sid="ACT 7:59"/>बे स्तिफनुस के ऊपर पथरा मारतै रहै, और बौ प्रभु कै पुकारकै कही, “प्रभु ईसु, मेरी आत्मा कै लै ले!” <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>फिरौंकी घुपटियाय कै ऊँची अबाज मैं चिल्लाई, “प्रभु! जौ पाप इनके ऊपर मत लगईये!” और जौ कहतै मर गौ।<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="s">साऊल कलीसिया कै सताथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>और साऊल बाकै मारन की सहमति दई। बहे दिन से यरूसलेम की कलीसिया के ऊपर बड़ा सताव होन लगो। और प्रेरितन कै छोड़ सब विस्वासी यहूदिया और सामरिया के देसन मैं तितर-बितर हुईगै। <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>कुछ धर्मप्रेमी लोग स्तिफनुस कै दफन कर दईं और बड़ा रोईं।<verse eid="ACT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3"/>पर साऊल कलीसिया कै उजाड़त गौ; बौ घर-घर जाएकै विस्वासियन कै, और आदमिन कै और बईंय्यरन कै घसीट कै कैदखाना मैं डार देत रहै।<verse eid="ACT 8:3"/></para>
  <para style="s">सामरिया मैं सुसमाचार को प्रचार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>जो विस्वासी बिखरे भै रहैं, बे हर जघा जाएकै सुसमाचार देत रहैं। <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>फिलिप्पुस सामरिया सहर मैं जाएकै और हुँआँ लोगन कै मसीह को उपदेस दई। <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>जो फिलिप्पुस कही, बामै भीड़ पूरो ध्यान दई, काहैकि बे बाकी बात सुनीं और बाके जरिये करे गै चिन्ह चमत्कार कै देखीं। <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>निरे जनिन मैं से बुरी आत्मा निकारी गईं, और निरे फालिस की बिमारी और लंगड़न कै अच्छो करो गौ। <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>जहे बजह से बौ सहर बड़ा खुस रहै।<verse eid="ACT 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>सिमौन नाओं को एक आदमी रहै, जो जादू-टोना से सामरिया के आदमिन कै अचम्मो करतो और खुदकै महान आदमी बतातो, <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>और सहर के सब जनी, समाज के सबै वर्गन से, बाके ऊपर पूरो ध्यान दईं। बे कहीं, “कि परमेस्वर की सामर्थ्य ‘महान सामर्थ्य’ के रूप मैं जानी जाथै।” <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>बौ निरे दिनन से उनकै अपने जादू के कामन से चकित करत रहो, तभईये बे बाकै बड़ा ध्यान देत रहैं। <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>लेकिन जब बे फिलिप्पुस को बिस्वास करीं जो परमेस्वर के राज्य और ईसु मसीह के नाओं को सुसमाचार सुनात रहै, तौ आदमी का बईय्यर बपतिस्मा लेन लगे। <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>तौ सिमौन भी बिस्वास करी और बपतिस्मा लैकै फिलिप्पुस के संग रहेन लगो और चिन्ह चमत्कार और बड़े-बड़े सामर्थ्य के काम होत भै देखकै बड़ा अचम्मो करतो।<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>जब यरूसलेम मैं प्रेरित सुनीं, कि सामरिया के लोग परमेस्वर को बचन अपनाय लईं हैं तौ पतरस और यूहन्ना कै उनके झोने पनारी। <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>जब बे हूँना पुगे, तौ विस्वासिन के ताहीं प्रार्थना करीं ताकी बे पवित्र आत्मा पामैं। <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>काहैकि पवित्र आत्मा अबले उनमैं से कोईये ऊपर नाय उतरी रहै; बे सिरफ प्रभु ईसु के नाओं से बपतिस्मा लईं रहैं। <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>तौ पतरस और यूहन्ना उनके ऊपर हात धरी और बे पवित्र आत्मा पाईं।<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>जब सिमौन देखी कि प्रेरितन के हात धरन से पवित्र आत्मा दौ जाथै, तौ पतरस और यूहन्ना कै पैसन की घूस देन की कोसिस करी, <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>और कही, “जहे अधिकार मोकै भी देबौ, कि जो कोई के ऊपर मैं हात धरौं, तौ बौ पवित्र आत्मा पाबै।”<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>लेकिन पतरस बाकै जबाब दई, “तेरे पैसा तेरे संग नरक मैं जामैं, जौ सोचन के ताहीं कि तैं पैसन से परमेस्वर को वरदान मोल लै सकथै! <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>जौ काम मैं ना तेरो कोई हिस्सा है और ना बाँट है, काहैकि तेरो मन परमेस्वर कि नजर मैं सई ना है। <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>पस्चाताप कर, फिर, अपनी जौ योजना ताहीं प्रभु से प्रार्थना कर कि बौ तोकै जौ तरहन की बात मन मैं सोचन के ताहीं माफ कर देबै। <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>काहैकि मैं देखरौ हौं कि तुम कटु ईर्सा से भरो भौ है और अधर्म को कैदी है।”<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>तौ सिमौन पतरस और यूहन्ना से कही, “किरपा करकै मेरे ताहीं प्रभु से प्रार्थना करौ, ताकी तुमरे जरिये कही गई जे बातन मैं से कोई भी मेरे ताहीं ना होबै।”<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>फिरौंकी पतरस और यूहन्ना गभाई दैकै, सामरिया और निरे गाँवन मैं प्रभु को सुसमाचार सुनात भै यरूसलेम कै लौट गै।<verse eid="ACT 8:25"/></para>
  <para style="s">फिलिप्पुस और कूस को अधिकारी</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>प्रभु को एक दूत फिलिप्पुस से कही, “तैयार हुई जा और तरिहाँए के घाँईं जा रस्ता जो यरूसलेम से गाजा कै जाथै।” जौ रेगिस्तान बारो रस्ता है। <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>इसलै फिलिप्पुस तैयार हुई गौ और चले गौ। तभई कूस देस को एक खोजा<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">हिजड़ा</char></note> आत रहै, जो कूसियन की रानी के भंडार को एक खास अधिकारी रहै। बौ आराधना करन के ताहीं यरूसलेम मैं आओ रहै। <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>बौ अपनी रथ मैं घरै बापस जात रहै। जैसे-जैसे बौ अग्गु बढ़ै, बौ यसायाह भविस्यवक्ता की किताब पड़त भै जाबै। <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>तौ पवित्र आत्मा फिलिप्पुस से कही, “बाके झोने जाएकै जौ रथ के संग हुई ले।” <verse eid="ACT 8:29"/><verse number="30" style="v" sid="ACT 8:30"/>फिलिप्पुस दौड़कै यसायाह भविस्यवक्ता की किताब से पढ़त भै सुनी तौ बासे पूँछी, “तू जो पढ़ रहो है, का तू बाकै समझतौ है?”<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>अधिकारी जबाब दई, “जबले कोई मोकै नाय समझागो तौ मैं बाकै कैसे समझंगो?” और बौ फिलिप्पुस बासे बिनती करी की बौ चढ़कै बाके संग बैठे। <verse eid="ACT 8:31"/><verse number="32" style="v" sid="ACT 8:32"/>सास्त्र को जौ अध्याय बौ पढ़त रहै, बौ जौ कहत रहै:</para>
  <para style="q1" vid="ACT 8:32">“बौ एक भेंड़ के हानी रहै जोकै मारन के ताहीं लैजाओ जाथै,</para>
  <para style="q2" vid="ACT 8:32">एक भेंड़ के मेम्ना के हानी जो कोई अबाज ना करथै जब बाको ऊन काट दौ जाथै।</para>
  <para style="q2" vid="ACT 8:32">बौ एक सब्द ना कही।<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>बाकै बेईज्जत करो गौ, और बाकै न्याय से वंचित कर दौ गौ।</para>
  <para style="q2" vid="ACT 8:33">कोइयो बाके बंसज के बारे मैं नाय बताए पाओ।</para>
  <para style="q2" vid="ACT 8:33">काहैकि पृथ्वी मैं बाकी जिंदगी खतम हुई गई।”<verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>तौ अधिकारी फिलिप्पुस से पूँछी, “मैं तोसे बिनती करथौं, बता, जौ भविस्यवक्ता कौनके बारे मैं कहरौ है? अपने बारे मैं या कोई दुसरे के बारे मैं?” <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>तौ फिलिप्पुस कहेन लागो; और सास्त्र के जौ अंस से सुरू हुईकै, बौ बाकै ईसु को सुसमाचार सुनाई। <verse eid="ACT 8:35"/><verse number="36" style="v" sid="ACT 8:36"/>जब बे रस्ता मैं जातै रहैं, तौ बे एक जघा मैं आए जहाँ पानी रहै, तौ अधिकारी कही, “देख हिंयाँ पानी है। और अब मोकै बपतिस्मा लेन मैं का कोई रुकावट है?”<verse eid="ACT 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37"/>फिलिप्पुस कही, “अगर तू पूरे मन से बिस्वास करथै तौ लै सकथै।” बौ कही “मैं बिस्वास करथौं।”<verse eid="ACT 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38"/>तौ अधिकारी रथ रोकन को आदेस दई, और फिलिप्पुस और अधिकारी दोनों पानी मैं उतर गै, और फिलिप्पुस बाकै बपतिस्मा दई। <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>जब बे पानी से बहार निकरकै आए, तौ प्रभु की आत्मा फिलिप्पुस कै दूर लै गई। अधिकारी बाकै फिर से नाय देखी, लेकिन खुसी से अपने रस्ता मैं चलत रहो। <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>फिलिप्पुस अपने आपकै अस्दोद मैं पाई; बौ कैसरिया गौ, और रस्ता मैं बौ हर सहर मैं सुसमाचार को प्रचार करी।<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s">साऊल को धर्म परिवर्तन</para>
  <para style="r">(<ref loc="ACT 22:6-16">प्रेरितो 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>साऊल अपने चेला जो प्रभु के चेलन के खिलाप मार डारन की धमकी दई। जौ बीच बौ बड़ो पुजारी के झोने गौ धमकान और घात करन के ताक मैं रहत रहै। <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>और बासे दमिस्क नाओं के सभाघर से जौ अधिकार को दस्तावेज माँगी कि आदमी का बईय्यर, जिनकै बौ परमेस्वर के रहामैं पाबै तौ उनकै पकड़कै यरूसलेम मैं लै आबै।<verse eid="ACT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3"/>जैसे-जैसे साऊल दमिस्क सहर के झोने आत गौ, अनकाचीति आसमान से बाके ऊपर एक उजियारो चमको। <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>बौ जमीन मैं गिर गौ और बाकै एक अबाज सुनाई दई, “साऊल, साऊल! तू मोकै काहेकै सताथै?”<verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>बौ पूँछी, “प्रभु तैं कौन है?” अबाज कही, “मैं ईसु हौं; जोकै तू सताथौ।” <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/>“लेकिन अब उठकै और सहर मैं जा, जहाँ तोकै बताओ जागो कि तोकै का करनो चाहिए।”<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>जो आदमी साऊल के संग सफर करत रहैं, बे चकाय गै, काहैकि बे अबाज कै सुनत तौ रहैं, लेकिन कोई कै देख नाय पात रहै। <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>तौ साऊल जमीन मैं से उठो, लेकिन जब आँखी खोली तौ बाकै कछु सुजान ना लगो। जहे बजह से बे बाको हात पकड़कै दमिस्क मैं लैगै। <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>बौ तीन दिन ले नाय देख सको, और बौ समय साऊल कछु ना खाए पी पाई।<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>दमिस्क मैं हनन्याह नाओं को एक चेला रहै, बासे प्रभु दर्सन मैं कही, “ए हनन्याह!” बौ जबाब दई, “परमेस्वर मैं हिंयाँ हौं।”<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>प्रभु बासे कही, “तैयार हुई जा और बौ गली मैं जा, जो सीधी कही जाथै, और यहूदा के घर मैं साऊल नाओं को एक तरसुस बासिन्दा कै पूँछ; बौ प्रार्थना कर रौ है, <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/>और बौ सपने मैं देखी कि हनन्याह नाओं को एक आदमी बाके झोने आयकै बाके ऊपर हात रख रौ है, ताकी बौ फिर से देख सकै।”<verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>हनन्याह जबाब दई, “प्रभु, मैं जहे आदमी के बारे मैं निरेन से सुनो हौं कि जौ यरूसलेम मैं तेरे पवित्र आदमिन के ताहीं करो गौ सबै भयानक कामन के बारे मैं बताई है। <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>और बौ बड़े पुजारिन के अधिकार के संग दमिस्क नाओं की जघा आए गौ है, जो तुमरी पूजा करथैं।”<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>प्रभु बासे कही, “तू जा, काहैकि बौ तौ गैर यहूदि और राजन और इस्राएलिन के अग्गु मेरो नाओं उजागर करन के ताहीं, मेरो चुनो भौ जन है। <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/>और मैं खुद बाकै बौ सब दिखांगो, जो बाकै मेरे नाओं खातिर भुकतने होगो।”<verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>तौ हनन्याह उठकै बहे घर मैं गौ जोमैं साऊल रहे, और बाके ऊपर हात धरकै कही, “भईय्या साऊल, जो रस्ता मैं ईसु तोकै सुजाई दई रहै, बहे प्रभु मोकै पनारी है कि तैं दुबारा देख पाबै और पवित्र आत्मा से भर जाबै।” <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>तुरंतै बाकी आँखी से मच्छी के सिन्नो जैसी पपड़ी झरी, और बाकै सुजाई देन लगो। तौ बौ उठकै बपतिस्मा लई; <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>बौ खानु खाई, तौ बाकी ताकत बापस आई।</para>
  <para style="s" vid="ACT 9:19">साऊल को उपदेस दमिस्क मैं</para>
  <para style="p" vid="ACT 9:19">फिर साऊल कुछ दिन ले चेलन संग दमिस्क मैं रहो। <verse eid="ACT 9:19"/><verse number="20" style="v" sid="ACT 9:20"/>बौ तुरंतै सभाघर मैं ईसु को उपदेस देन लगो, कि बौ परमेस्वर को लौड़ा है।<verse eid="ACT 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21"/>सब सुनन बारे अचम्मे भै और पूँछीं, “का जौ बहे नाय है जो यरूसलेम मैं रहै, जो बे आदमिन कै मारत रहै जो ईसु कै पूजत रहैं? और का बौ हिंयाँ इसलै ना आओ कि बे लोगन कै बंधी बनाएकै बड़े पुजारिन के झोने लै जाबै?”<verse eid="ACT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22"/>लेकिन साऊल को उपदेस और सक्तिसाली ही गै, बौ प्रमाड़ देत रहो की ईसु मसीहा रहै, बौ इतनो आस्वस्त रहै कि दमिस्क मैं रहेन बारे यहूदि बाको उत्तर नाय दै सकत रहैं।<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>जब निरे दिन गुजर गै, तौ यहूदिया के मिलकै साऊल कै खतम करन की साजिस बनाईं, <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>लेकिन उनकी साजिस की खबर साऊल कै बताई गई। बे तौ बाकै खतम करन के ताहीं रात-दिन फाटकन घाँईं देखत रहेत रहैं। <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>लेकिन एक रात साऊल के चेला बाकै लै लई बाकै बितौला मैं बैठाईं और दीवार मैं से लटकाए कै उतार दईं।<verse eid="ACT 9:25"/></para>
  <para style="s">यरूसलेम मैं साऊल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>साऊल यरूसलेम गौ बौ चेलन से मिलन की कोसिस करी। लेकिन बे बिस्वास नाय करंगे कि बौ एक दास रहे, और बे सब बासे डरात रहैं। <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>तौ बरनबास बाकी मदत के ताहीं आओ और बाकै प्रेरितन के झोने लैगौ। बौ उनकै समझाई कि कैसे साऊल सड़क मैं प्रभु कै देखी रहै और प्रभु बासे बात करी रहै। बौ जौ भी बताई रहै कि दमिस्क मैं ईसु के नाओं मैं साऊल कितनी हिम्मत से प्रचार करी रहै। <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>तब साऊल उनके संग यरूसलेम मैं रहो और बेधड़क हुईकै प्रभु के नाओं से प्रचार करत रहो। <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>बौ यूनानी भासा बोलन बारे यहूदियन के संग बोलचाल और बाद-विवाद करी, लेकिन बे बाकै मारन की कोसिस करीं। <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>जब विस्वासी भईय्यन कै जौ पता चलो, तौ बे साऊल कै कैसरिया मैं लैगै और बाकै तरसुस कै पनार दईं।<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>जौ बजह से पूरे यहूदिया, गलील और सामरिया की कलीसिया मैं सांति को समय रहै। पवित्र आत्मा की मदत से हौंसला पाईं और संख्या मैं बढ़ोतरी भइ, जो प्रभु के ताहीं सृद्धा रखत रहै।<verse eid="ACT 9:31"/></para>
  <para style="s">पतरस और लुद्दा याफा मैं</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>पतरस सब जघा को सफर करी, और एक मौका मैं बौ परमेस्वर के पवित्र लोगन से मिलन कै गौ, जो लुद्दा मैं रहेत रहैं। <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>हूँना बाकै ऐनियास नाओं फालिस को मारो एक आदमी मिलो, जो आठ साल से खटिया मैं पड़ो रहै। <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>पतरस कही। “ऐनियास, उठ और अपनी सितरी उठा; ईसु मसीह तोकै ठीक करी है।” <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>तौ लुद्दा और सारोन के सब रहन बारे बाकै देखकै प्रभु के घाँईं मुरक गै।<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>याफा मैं तबीता नाओं की एक बईय्यर रहै, जो एक विस्वासन रहै। ग्रीक मैं बाको नाओं दोरकास है, जोको मतलब है “एक हीरन।” बौ अपनो सारो समय अच्छो करन और गरीबन की मदत करन मैं बिताई। <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>बहे दिनन मैं बौ बिमार पड़कै मर गई; और आदमी बाकै हंदबाय कै ऊपर एक आँटी मैं धर दईं। <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>लुद्दा याफा से जद्धा दूर नाय रहै, जब लुद्दा मैं चेला सुनी की पतरस याफा मैं है, तौ बे दुई जनी कै खबर के संग पनारकै नहोरे करीं, “कि जल्दी हमरे झोने आए जा।” <verse eid="ACT 9:38"/><verse number="39" style="v" sid="ACT 9:39"/>जौ बजह से पतरस तैयार हुई गौ और उनके संग चले गौ। जब बे पहुँचे, तौ उनकै ऊपर कमरा मैं लैजाओ गौ, जहाँ सब बिधवैं उनकै गोल घेर लईं, और जो कुरता और लत्ता दोरकास उनके संग जीते जी रहेत भै बनाई रहै, बे दिखान लगी। <verse eid="ACT 9:39"/><verse number="40" style="v" sid="ACT 9:40"/>तौ पतरस सबकै दुआरे कर दई, और घुपटियाय कै प्रार्थना करी और बौ सरीर के घाँईं मुड़कै देखकै कही, “ए तबीता, उठ!” तभई बौ अपनी आँखी खोल दई, और पतरस कै देखकै उठकै बैठ गई। <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>पतरस जाएकै बाकै उठन मैं मदत करी, और पवित्र विस्वासिन और बिधवन कै बुलाएकै बाकै जिंदो कर दई। <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>जौ खबर पूरे याफा मैं फैल गई, और निरे आदमी प्रभु के ऊपर बिस्वास करीं। <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>पतरस याफा मैं कोई सिमौन नाओं के चमड़ा को कारोबार करन बारे के हींना निरे दिन तक रहो।<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s">कुरनेलियुस और पतरस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>कैसरिया मैं कुरनेलियुस नाओं को एक आदमी रहै, जो रोमन सेना-दल मैं एक कप्तान रहै, जोकै “इटालियन सेना-दल” कहो जात रहै। <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>बौ एक धार्मिक आदमी रहै; बौ और बाको पूरो परिवार परमेस्वर की आराधना करी। बौ गरीब यहूदि आदमिन की मदत करन के ताहीं भौत कुछ करी और लगातार परमेस्वर से प्रार्थना करतो। <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>बौ दिन के तीन बजे के आस-पास एक दर्सन देखी, कि परमेस्वर को एक स्वर्गदूत बाके झोने अंदर आए कै कही, “कुरनेलियुस!”<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>तौ बौ स्वर्गदूत कै निहारकै देखी और डरात भौ कही, “गुरु, जौ का है?” स्‍वर्गदूत जबाब दई, “परमेस्वर तेरी प्रार्थना और दान के कामन से खुस है, और तेरो जबाब देन के ताहीं तैयार है। <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>और अब याफा मैं कोई आदमी कै पनार दियौ जो सिमौन नाओं के एक आदमी कै बापस लै आबै जोकै जो पतरस कहो जाथै। <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>बौ चमड़ा को कारोबार करन बारे सिमौन, के हींना हितुआ है, जोको घर समुंदर टिकारे है।” <verse eid="ACT 10:6"/><verse number="7" style="v" sid="ACT 10:7"/>जब स्वर्गदूत चले गौ, और कुरनेलियुस अपने दुई घर के सेवक और एक सिपईय्या कै बुलाई, एक धार्मिक आदमी जो उनके सबसे अच्छे सहयोगिन मैं से एक रहै। <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>और उनकै सब बात बताए कै याफा कै पनारी।<verse eid="ACT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>दुसरे दिन जब बे अपने रहा मैं रहैं और याफा सहर के झोने पुगे, तौ दुपारी मैं पतरस छत ऊपर प्रार्थना करन चढ़ो। <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>बाकै भूंक लागी और कछु खानो चहात रहै; लेकिन जब बे खानु बनान की तैयारी करत रहैं तौ बौ एक दर्सन देखी। <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>बौ देखी कि आसमान खुल गौ है और कुछ नीचे आए रौ है, जो एक बड़ी चद्दर हानी दिखाए रौ है जो पृथ्वी के चारौ कोहने से उतारो जाएरौ है। <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>जोमैं पृथ्वी के सब हानी के जानवर, नेंगन बारे जानवर कीरा करमोला और आसमान के पक्छी रहैं। <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>आसमान से एक अबाज बासे कही, “उठ, पतरस; मार और खा!”<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>लेकिन पतरस कही, “ना प्रभु, कहुए नाय! मैं कहुए कोईये असुद्ध या छिया-पछारे चीज ना खाओ हौं।”<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>फिर दुसरी बार बाकै अबाज सुनाई दई, “जो कछु परमेस्वर सुद्ध ठहराई है, बाकै तू असुद्ध मत बोलै।” <verse eid="ACT 10:15"/><verse number="16" style="v" sid="ACT 10:16"/>ऐसो तीन बार भौ; और फिर जौ चीज कै बापस आसमान मैं लैजाओ गौ।<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>जब पतरस दर्सन के मतलब के बारे मैं सोचत रहै, कुरनेलियुस के जरिये पनारे गै आदमिन कै पता रहै कि सिमौन को घर कहाँ है, बे मोहोंट अग्गु जाएकै ठाड़गै। <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>और बे अबाज दैकै पूँछन लगे, “का सिमौन पतरस नाओं से हिंयाँ कोई हितुआ है?”<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>पतरस अभईयो समझन की कोसिस करत रहै कि दर्सन को का मतलब है, जब आत्मा कही, “सुन! तीन आदमी हिंयाँ तोकै ढूँड़ रै हैं। <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>इसलै तैयार हुईकै नीचे जाबौ, और उनके संग जान मैं संका मत करियो, काहैकि मैं उनकै भेजो हौं।” <verse eid="ACT 10:20"/><verse number="21" style="v" sid="ACT 10:21"/>तौ पतरस तरे उतरकै बे आदमिन से कही, “देखौ, जोकै तुम ढूँड़ रै हौ, बौ महीं हौं; तुम काहेकै आए हौ?”<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>बे जबाब दईं, “कुरनेलियुस कप्तान हमैं भेजी है। बौ एक धर्मी आदमी है और परमेस्वर की आराधना करथै और पूरी यहूदि जाति मैं भलो है। परमेस्वर को पवित्र स्वर्गदूत बासे कही कि तैं बाकै अपने घरै बुलबा, ताकी बौ सुन सकै कि तोकै का बोलने है।”<verse eid="ACT 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 10:23"/>तौ पतरस बे आदमिन कै अंदर बुलाई और उन्हैं रात रुकन ताहीं कही। दुसरे दिन बौ समर गौ और उनके संग चले गौ; और याफा के कुछ विस्वासी भईय्या बाके संग गै। <verse eid="ACT 10:23"/><verse number="24" style="v" sid="ACT 10:24"/>दुसरे दिन बे कैसरिया सहर मैं पुगे, हूँन कुरनेलियुस अपने कुरमा-टब्बर और साथियन कै जोर कै उनकै असियात रहो। <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>जैसी पतरस भीतर घुसो, तौ कुरनेलियुस बासे मिलो, और लोहोक्कै बाके पाँव मैं गिर गौ। <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>तौ पतरस बाकै उठात भइ कही। “ठाड़ जा,” और कही; “मैं खुद सिरफ एक आदमी हौं।” <verse eid="ACT 10:26"/><verse number="27" style="v" sid="ACT 10:27"/>फिर पतरस बाके संग बात करत भइ घरै गौ, जहाँ बौ पाई कि निरे आदमी जुराने पड़े हैं। <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>पतरस उनसे कही, “तुम खुद अच्छी तरह से जानथौ, कि कोई यहूदि कै उनके धर्म मैं जान से या गैर यहूदिन के संग जुड़न की इजाजत ना है। लेकिन परमेस्वर मोकै दिखाई है कि कोई भी आदमी कै छिया-पछारे या असुद्ध ना समझनो चाहिए। <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>और जब मैं बुलाओ गौ, तौ मैं बिना कोई दिक्कत करे चले आओ। मैं तुमसे पूछथौं, कि मोकै कौन से काम के ताहीं बुलाओ गौ है?”<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>तौ कुरनेलियुस कही, “जौ तीन दिन पहले की बात है जब मैं अपने घरै दुपारी के तीन बजे प्रार्थना करत रहौं। अनकाचीति एक आदमी चमकीले लत्ता पहने भै, मेरे अग्गु आए कै ठाड़गौ। <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>और कही, ‘कुरनेलियुस! परमेस्वर तेरी प्रार्थना सुन लई है और तेरे दान के कामन मैं ध्यान दई है। <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>जहेमारे कोई कै याफा पनार जो सिमौन पतरस नाओं के आदमी कै बुलाबै। बौ सिमौन के घरै, जो चमड़ा को कारोबार करन बारे को हितुआ है, जो समुंदर के टिकारे रहथै।’ <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>तौ मैं तुरंतै तोकै बुलबाओ, और तैं जौ अच्छो करो कि आए गौ। अब हम सब हींना परमेस्वर की मौजूदगी मैं हैं, ताकी जो कछु प्रभु तोसे कही है बाकै सुनैं।”<verse eid="ACT 10:33"/></para>
  <para style="s">पतरस को भाँसड़</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>तौ पतरस बोलनो सुरू करी: “मोकै अब एहसास भौ है कि जौ सच है कि परमेस्वर सबन के संग एक जैसो बर्ताव करथै। <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>जो बासे डराथैं और धार्मिक काम करथैं, बौ बाकै भाथै, चाँहे बे कोई भी जाति के होमैं। <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>तुम ईसु मसीह के जरिये सांति के सुसमाचार को ऐलान करत भइ इस्राएल के लोगन कै भेजे गै संदेस कै जानथौ, जो सबन को प्रभु है। <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>तुम यहूदिया की बौ महान घटना के बारे मैं जानतै हौ जो यूहन्ना के बपतिस्मा के बचन को प्रचार के बाद गलील मैं सुरू भइ, जो इस्राएल की धरती मैं भइ रहै। <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>तुम ईसु नासरी के बारे मैं जानथौ और परमेस्वर बाके ऊपर पवित्र आत्मा और सामर्थ्य कैसे अभिसेक करी। बौ सब जघा जातो, और जो सैतान के सताए भै रहैं, अच्छो करत फिरतो, काहैकि परमेस्वर बाके संग रहै। <verse eid="ACT 10:38"/><verse number="39" style="v" sid="ACT 10:39"/>हम बे सब बातन के गभा हैं; जो बौ यहूदा और यरूसलेम मैं करी, और बे बाकै क्रूस मैं टाँग कै मारडारीं। <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>लेकिन परमेस्वर बाकै तिसरे दिन बाद मरे से जिंदो करी, और उजागर भी करी, <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>सब लोगन कै नाय बल्कि उन गभन कै जिन्हैं परमेस्वर पहले से चुन लई रहै, मतलब हमकै जो बाके मरे भैन मैं से जी उठन के बाद बाके संग खाईं पीं। <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>और बौ हमकै हुकम दई कि आदमिन मैं सुसमाचार प्रचार करौ और गभाई देबौ, कि जौ बहे है जोकै परमेस्वर जिंदे और मरे भै को न्याय करन बारो ठहराई है। <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>सब भविस्यवक्ता गभाई देथैं जो भी बाके ऊपर बिस्वास करैगो, बहेकै बाके सामर्थी नाओं के जरिये पापन से माफी मिलैगी।”<verse eid="ACT 10:43"/></para>
  <para style="s">गैर यहूदिन कै पवित्र आत्मा मिलथै</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>पतरस जे बात करतै रहै, कि जो-जो बाको संदेस सुनत रहै बाके ऊपर पवित्र आत्मा उतर आई। <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>और जित्ते खतना करे भै विस्वासी पतरस के संग याफा से आए रहैं, बे सब अचम्मे मैं पड़ गै कि गैर यहूदिन के ऊपर पवित्र आत्मा को दान अखनाओ गौ है। <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>काहैकि बे उनकै तरह-तरह की भासा बोलत और परमेस्वर की महानता की तारिफी करत सुनी, जहे ऊपर पतरस कही: <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>“का अब कोई इनकै पानी को बपतिस्मा लेन से कोई रोक सकथै, जेऊँ हमरे हानी पवित्र आत्मा पाईं हैं?” <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>और बौ हुकम दई कि बे ईसु मसीह के नाओं मैं बपतिस्मा लेमैं। तौ बे बासे नहोरे करीं कि बौ कुछ दिन और उनके संग रहाबै।<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s">यरूसलेम की कलीसिया मैं पतरस को व्योरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>यहूदिया मैं रहन बारे जो निरे प्रेरित और विस्वासी भईय्या रहैं सुनीं, कि गैर यहूदि के भी परमेस्वर को बचन अपनाय लईं हैं। <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>और जब पतरस यरूसलेम गौ, तौ हूँन के लोग गैर यहूदि को खतना करन बारेन के घाँईं रहैं, बे बाकी बुराई करत भै कहीं, <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>“तैं बिना खतना यहूदि के घरै एक हितुआ रहै, और तैं उनके संग भी खाओ!” <verse eid="ACT 11:3"/><verse number="4" style="v" sid="ACT 11:4"/>तभई पतरस उन्हैं सुरु से जो कुछ भौ रहै, बाको पूरो हिसाब दई:<verse eid="ACT 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5"/>“जब मैं याफा सहर मैं प्रार्थना करत रहौं, तौ मैं एक दर्सन मैं देखो कि आसमान से कछु नीचे आए रौ है, जो स्वर्ग के चारौ कोने से एक बड़ी चद्दर के तराहनी उतारी जाए रइ है, और बौ मेरे झोने आयकै ठहर गई। <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>जब बाकै झोने से देखो तौ मैं बामै पृथ्वी के तमान पालतू, नेंगन बारे जानवर, कीरा-करमोला और आसमान के पक्छी देखो। <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>तभई मोए एक अबाज सुनाई दई, ‘उठ, पतरस; मार और खा!’ <verse eid="ACT 11:7"/><verse number="8" style="v" sid="ACT 11:8"/>लेकिन मैं कहो, ‘हरगिज नाय प्रभु! कैसो भी असुद्ध और छिया-पछारे खानु मेरे मोहों मैं नाय गौ है।’ <verse eid="ACT 11:8"/><verse number="9" style="v" sid="ACT 11:9"/>तौ आसमान से फिर से अबाज आई, ‘जो कछु परमेस्वर सुद्ध ठहराई है, बाकै असुद्ध मत कह।’ <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>तीन बार ऐसो ही भौ, और आखरी मैं सारो सामान आसमान मैं खींच लौ गौ। <verse eid="ACT 11:10"/><verse number="11" style="v" sid="ACT 11:11"/>बहे घड़ी कैसरिया से मेरे झोने पनारे गै तीन आदमी बहे घर पहुँचे जितै मैं रुको रहौं। <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>तौ आत्मा मोसे बिना हिचकिचाय उनके संग जानकै कही और याफा के जे छ: विस्वासी भईय्या मेरे संग कैसरिया गै, और हम सब कुर्नेलियुस के घर मैं गै। <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>और कुर्नेलियुस हमकै बताई कि कैसे एक दिन बौ अपनेई घरै एक स्वर्गदूत कै देखी रहै, जो बासे कही, ‘याफा के ताहीं कोई ऐसो आदमी कै पनारै जोको पूरो नाओं सिमौन पतरस है। <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>बौ तोसे ऐसी बात कहेगो, जोके बजह से तैं और तेरो पूरो परिवार बच जागो।’ <verse eid="ACT 11:14"/><verse number="15" style="v" sid="ACT 11:15"/>जब मैं बोलनो सुरु करो, तौ पवित्र आत्मा उनके ऊपर बैसिये उतरो, जैसो सुरु मैं हमरे ऊपर उतरो रहै। <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>तौ मोए प्रभु को बात याद आओ कि बौ का कही रहै: ‘यूहन्ना तौ पानी से बपतिस्मा लई लेकिन तुमकै पवित्र आत्मा को बपतिस्मा दिओ जागो।’ <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>जौ सपा है कि परमेस्वर बे गैर यहूदिन कै बहे दान दई है जो बौ आपन कै दई रहै जब आपन प्रभु ईसु मसीह मैं बिस्वास करत रहैं; तौ मैं कौन होथौं, जो, परमेस्वर कै रोक सकत रहौं!”<verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>जब बे ऐसो सुनी, तौ बे बुराई करनो बंद कर दईं और परमेस्वर की बड़ाँईं करत भै कहीं, “तभई तौ परमेस्वर गैर यहूदिन कै मन फिरान और जिंदगी जीन को मौका दई है!”<verse eid="ACT 11:18"/></para>
  <para style="s">अन्ताकिया की कलीसिया</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>कुछ विस्वासी सताव के बजह से तितर-बितर भै रहैं जब स्तिफनुस कै मार डारो गौ रहै, तभई फीनीके, साइप्रस और अन्ताकिया की जघा मैं साऊल और बरनबास गै। जो सिरफ यहूदिन कै संदेस देत रहैं। <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>लेकिन गैरविस्वासी, जो साइप्रस और कुरेनी के रहैं, अन्ताकिया गै और यूनानी भासा बोलन बारेन कै भी संदेस, और उन्हैं प्रभु ईसु मसीह को सुसमाचार सुनाईं। <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>और प्रभु की ताकत उनके संग रहै, और तादात मैं लोग बिस्वास करीं और प्रभु के घाँईं मुड़ गै।<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>तौ उनकी खबर यरूसलेम की कलीसिया मैं पौहौंच गई, और तभई बे बरनबास कै अन्ताकिया मैं पनार दईं। <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>जब बौ आयकै देखी कि परमेस्वर लोगन कै कैसी सामर्थ्य और अनुग्रह दई है, तौ बौ मन मैं भौत खुस भौ और सबसे पूरे दिल से प्रभु के ताहीं बफादार और सच्चो होन की नहोरे करी। <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>काहैकि बरनबास एक अच्छो आदमी रहै; बौ पवित्र आत्मा और बिस्वास मैं भरो भौ रहै, और निरे लोगन कै प्रभु के झोने लाई रहै।<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>तौ बरनबास साऊल कै देखन के ताहीं तरसुस कै निकर गौ। <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>जब बासे भेंटा भौ, तौ बाकै अन्ताकिया मैं लैगौ, और पूरो एक साल तक दोनों कलीसिया के लोगन संग मिले और एक बड़े झुंड कै पढ़ाई। ऐसो अन्ताकिया मैं रहै कि चेलन कै पहले मसीह कहो जात रहै।<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>बहे समय मैं कुछ भविस्यवक्ता यरूसलेम से अन्ताकिया आए रहैं। <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>उनमैं से एक, अगबुस नाओं को उठ खड़ो भौ और पवित्र आत्मा की ताकत से भविस्यवाँड़ी करी कि पृथ्वी मैं भैंकर सूखा पड़ैगो। जौ ऐसो जब क्लौदियुस महाराजा के समय आओ रहै। <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>तौ चेला सलाह करीं कि बे हर एक विस्वासिन भईय्यन की सेवा करन के ताहीं उत्तो ही पनारंगे, जित्तो कि बे यहूदिया मैं रहत रहैं। <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>बे ऐसो ही करीं, और बरनबास और साऊल के हात कलीसिया मैं बड़े-बूढ़ेन कै पैसा भेजीं।<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s">जाधे जुलम</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>बेईं दिनन हेरोद राजा कलीसिया के कुछ सदस्यन कै सतानो सुरू कर दई। <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>बौ यूहन्ना के भईय्या याकूब कै तलवार से मार डारी रहै। <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>जब बौ देखी, कि जासे यहूदि खुस हैं, तौ बौ अग्गु बढ़ो और पतरस कै पकड़ लई। बे दिन अखमीरी रोटी के दिन रहैं। <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>बाकै पकड़वान के बाद पतरस कै कैदखाना मैं डार दौ गौ, जितै उनकै चार सैनिकन के चार झुंडन के जरिया हर एक कै बचान के ताहीं सौंप दौ गौ रहै। हेरोद फसह के बाद बाकै जनता के मुकदमा मैं डारन की योजना बनाई।<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">निर्गमन 12:1-27</ref></char></note> <verse eid="ACT 12:4"/><verse number="5" style="v" sid="ACT 12:5"/>तभई पतरस कै कैदखाना मैं रखो गौ, लेकिन कलीसिया के लोग बाके ताहीं परमेस्वर से प्रार्थना करत रहैं।<verse eid="ACT 12:5"/></para>
  <para style="s">पतरस कैदखाना से आजाद भौ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>जो रात हेरोद बाके लोगन के अग्गु लान बारो रहै, बासे पहले की रात पतरस दुई रखबरिया के बीच सोत रहै। बौ दुई जंजीर से भँदो भौ रहै, और कैदखाना के मोहोंट मैं रखबारी करत रहैं। <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>अनकाचीति प्रभु को एक स्वर्गदूत आयकै ठाड़ो रहै, और कुठरिया मैं एक रौसनी चमकत रहै। स्वर्गदूत पतरस कै कंधा पकड़कै हलाई, बाकै जगाई और कही, “फटाफट कर! उठ जा!” बाके हात से जंजीर खुलकै गिर गईं। <verse eid="ACT 12:7"/><verse number="8" style="v" sid="ACT 12:8"/>तौ स्वर्गदूत बासे कही, “करिहाँओं कस और अपनी चप्पल रख ले।” और पतरस बैसोई करी, और स्वर्गदूत बासे कही, “अपने लत्ता अपने चारौ तरफ धर और मेरे पच्छू हुई ले।” <verse eid="ACT 12:8"/><verse number="9" style="v" sid="ACT 12:9"/>पतरस निकरकै बाके पच्छू हुई लई; लेकिन जौ नाय जानत रहै कि जो कछु स्वर्गदूत कह रहो है, बौ सच्ची है, बल्किन जौ समझी कि मैं दर्सन देख रहो हौं। <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>तौ बे पहलो और दुसरो पहरा से निकरकै बौ लोहे के फाटक मैं पुगे, जो सहर के घाँईं रहै। तौ उनके ताहीं अपने आप फाटक खुल गौ, और बे एक गलियारे हुईकै दुआरे निकर गै। और तुरंतै स्वर्गदूत पतरस कै छोड़कै चले गौ।<figure style="fig" alt="Chains embedded in prison wall" file="hk00204c.tif" size="col" copy="Horace Knowles ©" ref="12:7">कैदखाना की दीवार मैं साँकर जकड़ी भइ</figure><verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>तौ पतरस होस मैं आयकै कही, “अब मैं सच्ची मैं जानगौ कि प्रभु अपनो स्वर्गदूत पनारकै मोकै हेरोद के हाथ से छुड़ाय लई, और यहूदियन की सबै उमीद तोड़ दई।”<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>अपनी हालत जानकै, बौ पतरस यूहन्ना की अईय्या मरियम के घर मैं आओ जो मरकुस नाओं से जानो जात रहै। हूँना निरे आदमी जुराए कै प्रार्थना करत रहैं। <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>पतरस मोहोंट को फाटक खटखटाई, और जाको जबाब देन के ताहीं रोडा नाओं की एक सेविका आई। <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>बौ पतरस की अबाज पहचान लई और बौ भौत खुसी के मारे फाटक नाय खोली; बौ दौड़कै भीतर गई और बताई कि पतरस मोहोंट मैं ठाड़ो है। <verse eid="ACT 12:14"/><verse number="15" style="v" sid="ACT 12:15"/>बे बासे कहीं, “तू पागल है!” लेकिन बौ और जोर दैकै बोली कि ऐसो ही है। तौ बे कहीं, “बाको स्वर्गदूत होगो।”<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>लेकिन पतरस खटखटात रहो तौ बे फाटक खोलीं, और जब बे बाकै देखीं तौ दंग रहगै। <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>तभई बौ उनकै हात से इसारा करी की बे चुप रहमैं; और उनकै बताई कि प्रभु कौन तरीका से मोकै कैदखाना से निकार लाई है। फिर कही, “जौ याकूब और उनके विस्वासी भईय्यन कै बताए दियो।” तौ निकरकै दुसरी जघा चले गौ।<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>भोर कै सिपईय्यन मैं बड़ा खलबली मच गई कि पतरस कितै गौ? <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>जब हेरोद बाकै ढुँड़बाई और नाय पाई, तौ रखबरियन कै हुकम दई कि, बे पतरस कै मार डारैं और हेरोद यहूदिया कै छोड़कै कैसरिया मैं रहेन लगो।<verse eid="ACT 12:19"/></para>
  <para style="s">हेरोद की मौत</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20"/>हेरोद सूर और सैदा के आदमिन से कतई सांति नाय रहै। तभई बे एक मन हुईकै बाके झोने आए और बलास्तुस कै जो राजा को एक करमचारी रहै, बाकै राजी करकै मेल करनो चाही; काहैकि राजा के देस से उनके देस को पालन-पोसँड़ होत रहै।<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>ठहराओ भौ दिन मैं हेरोद, राजा बारे लत्ता पहनकै न्याय करन बारी जघा मैं बैठो; और उनकै बखान करन लागो। <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>और आदमी चिल्लाए उठे, “जौ तौ आदमी को नाय परमेस्वर को बोल है।” <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>बहे घड़ी प्रभु को एक स्वर्गदूत तुरंतै चोट मारी, काहैकि हेरोद परमेस्वर की आदर नाय करी रहै; और बौ कीरा पड़कै मरो।<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>लेकिन परमेस्वर को बचन बढ़त और फैलत गौ।<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>जब बरनबास और साऊल अपनी सेवा पूरी कर चुके तौ यूहन्ना कै जो मरकुस कहलात रहै, बाकै संग लैकै यरूसलेम लौट आओ।<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s">बरनबास और साऊल कै चुननो और पनारो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>अन्ताकिया की कलीसिया मैं कुछ भविस्यवक्ता और सिक्छक रहैं; उनमैं बरनबास, समौन जो नीगर कहो जाथै, लूकियुस कुरेनी, मनाहेम जोकै हेरोद राजा के संग लाओ गौ रहै, और साऊल। <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>जब बे बर्त रखकै प्रभु की प्रार्थना करत रहैं, तौ पवित्र आत्मा उनसे कही, “मेरी सेवा ताहीं बरनबास और साऊल कै बौ काम के ताहीं अलग करौ जोके ताहीं मैं उनकै बुलाओ हौं।”<verse eid="ACT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3"/>तौ बे बर्त रखीं और प्रार्थना करकै उनके ऊपर हात धरकै उनकै बिदा करीं।<verse eid="ACT 13:3"/></para>
  <para style="s">साइप्रस मैं पौलुस</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>तौ बरनबास और साऊल पवित्र आत्मा से भरकै सिलुकिया कै गै; और हूँना से पानी के जहाज मैं साइप्रस जान के ताहीं चढ़े। <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>जब बे सलमीस मैं पहुँचे, तौ बे यहूदि सभाघरन मैं अधिकार से परमेस्वर के बचन को प्रचार करीं। उनके काम करन मैं मदत करन के ताहीं यूहन्ना उनके संग रहै।<figure style="fig" alt="Front view of a synagogue" file="lb00246c.tif" size="col" copy="Horace Knowles ©" ref="13:5">एक आराधनालय के सामने को दृस्य</figure><verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>और बे सब टापू मैं से होत भै, पाफुस तक पुगे। हूँना उनकै बार-ईसु नाओं को एक जादूगर मिलो, जो यहूदि और झूठो भविस्यवक्ता रहै। <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>बौ टापू को राज्यपाल सर्जियस पौलुस को दोस्त रहै, जो एक बुद्धिमान आदमी रहै। राज्यपाल उनके सामने बरनबास और साऊल कै बुलाई काहैकि बौ परमेस्वर को बचन सुननो चहात रहै। <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>लेकिन जादूगर एलीमास, ग्रीक भासा मैं बाको नाओं है के जरिये बिरोध करो गौ, जो राज्यपाल कै बिस्वास से दूर करन की कोसिस करी। <verse eid="ACT 13:8"/><verse number="9" style="v" sid="ACT 13:9"/>तौ साऊल जोको नाओं पौलुस भी है, पवित्र आत्मा से भरो भौ; बौ जादूगर घाँईं देखी <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>और कही, “तैं सैतान को बालका है! तैं धार्मिकता को दुस्मन है। तैं सब तरहन की बुरी चालन से भरो भौ है, और तैं हमेसा प्रभु के सच्चाई कै झूठ मैं बदलन की कोसिस करत रहथै!<verse eid="ACT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 13:11"/>प्रभु को हाथ अब तेरे ऊपर आगो; तैं अंधरा हुई जागो और कुछ समय के ताहीं दिन की उजीतो ना देख पागो।” एक बार के ताहीं एलीमास कै लगो कि बाकी आँखी मैं अंधियारो छाए गौ है, और बाको हाथ पकड़कै नेतृत्व करन के ताहीं कोई कै ढूँड़न की कोसिस करन लगो। <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>जब राज्यपाल देखी कि का भौ रहै, तौ बौ बिस्वास करी; काहैकि बौ प्रभु के बारे मैं पढ़कै भौत चकित भौ रहै।<verse eid="ACT 13:12"/></para>
  <para style="s">पिसिदिया के अन्ताकिया मैं पौलुस को उपदेस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>पौलुस और बाके संग के पाफुस से रवाना भै और पंफूलिया के एक सहर पिरगा मैं आए, जहाँ यूहन्ना उनकै छोड़कै बापस यरूसलेम मैं चले गौ। <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>बे पिरगा से चले गै और पिसिदिया के अन्ताकिया मैं पहुँचे, और साबत के दिन सभाघर मैं जाएकै बैठगै। <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>तौ मूसा के नियम और भविस्यवक्ता को सास्त्र पढ़न के बाद सभाघर के मुखिया उनके झोने एक खबर भेजीं, “भईय्यौ और बहेनियौ, अगर तुमरे पास जे लोगन कै हौंसला देन ताहीं संदेस है तौ तुम कहबौ।”<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>तौ पौलुस ठाड़गौ, और अपने हात से इसारा करकै, कहेन लगो: “इस्राएलियौ और हिंयाँ के सब दूसरे लोग जो परमेस्वर की आराधना करथैं: मोकै सुन लेबौ! <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>इस्राएल के लोगन को परमेस्वर हमरे बड़े-बूढ़ेन कै चुनी, और मिस्र देस मैं परदेसी हुईकै रहन के दौरान लोगन कै एक महान रास्ट्र बनाई। परमेस्वर उन्हैं अपनी महान सक्ति से मिस्र से बाहर निकारी, <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>और चालीस साल तक बौ रेगिस्तान मैं उनकी सहत रहो। <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>बौ कनान मैं सात देसन कै नास कर दई और अपने जाति लोगन कै जघा को मालिक बनाए दई।<verse eid="ACT 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20"/>जौ सब मैं लमसम 450 साल लगे। जाके बाद समूएल भविस्यवक्ता के समय ले बौ उनके ऊपर न्याय करन बारो ठहराई। <verse eid="ACT 13:20"/><verse number="21" style="v" sid="ACT 13:21"/>बाके बाद बे एक राजा माँगी; तौ परमेस्वर चालीस साल के ताहीं बिन्यामीन के खानदान मैं से एक आदमी मतलब कीस के लौड़ा साऊल कै उनके ऊपर राजा ठहराई। <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>बाकै हटान के बाद, परमेस्वर दाऊद कै उनको राजा बनाई। परमेस्वर बाके बारे मैं गभाई दई: ‘मोकै एक आदमी, यिसै को लौड़ा दाऊद, मेरे मन के हिसाब से मिलगौ है। बहे मेरी सब इच्छा पूरी करैगो।’ <verse eid="ACT 13:22"/><verse number="23" style="v" sid="ACT 13:23"/>दाऊद की पीढ़ी मैं से परमेस्वर अपने वादा के मुताबिक इस्राएलिन के झोने एक उद्धारकर्ता, यानी ईसु कै पनारी। <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>ईसु को काम सुरू करन से पहले, यूहन्ना इस्राएल के सब लोगन कै उपदेस दई कि उन्हैं अपने पापन से मन फिरान और बपतिस्मा लेनो चाहिए। <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>और जब यूहन्ना अपनी सेवा पूरी करन बारो रहै, तौ बौ कही, ‘तुम मोकै का समझथौ? मैं बौ नाय हौं! जोको तुम इंतजार कर रै हौ। लेकिन सुनौ! मेरे बाद एक आनबारो है, और जोके मैं पाँव के जूतन की तनी भी खोलन के लायक ना हौं।’”<verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>“मेरे साथी इस्राएलियौ, अब्राहम के बंसज और हिंयाँ के सब गैर यहूदि, जो परमेस्वर की आराधना को मान रखथैं: जौ हमरे ताहीं है कि जौ उद्धार को संदेस भेजो गौ है! <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>यरूसलेम मैं रहन बारे और उनके सासक कै जौ पता ना रहै कि बौ उद्धारकर्ता है, और ना बे भविस्यवक्ता की बे न्याय की बातन कै समझत रहैं जो हर साबत के दिन पढ़ी जात रहैं। फिर भी बे ईसु की बुराई करकै भविस्यवक्तन की बातन कै सच कर दईं। <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>बे बाकै मार डारन को ऐसो कोई दोस बामै नाय पाईं, तहुँओं बे पिलातुस से कहीं कि बौ बाकै मौत के घाट उतार देबै। <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>और जब बे बाके बारे मैं पवित्र सास्त्र मैं लिखी भइ सब बात पूरी करीं, तौ बे बाकै क्रूस से नीचे उतारकै कबर मैं रखीं। <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>लेकिन परमेस्वर बाकै मरे भै मैं से जिंदो करी, <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>और बौ उनकै जो बाके संग गलील से यरूसलेम आए रहैं, निरे दिन तक बे लोगन कै दिखाई देत रहो। बे अब इस्राएल के लोगन के ताहीं बाके गभा हैं। <verse eid="ACT 13:31"/><verse number="32" style="v" sid="ACT 13:32"/>और हम तुम्हैं बौ वादा के बारे मैं जो बड़े-बूढ़ेन से करी गई रहै, जौ सुसमाचार सुनाथैं, <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/><note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भजन संहिता 2:7</ref></char></note>कि परमेस्वर ईसु कै जिंदो करकै, बहे प्रतिग्या हमारी औलाद के ताहीं पूरी करी; जैसो कि दूसरे भजन संहिता मैं लिखो गौ है:</para>
  <para style="q1" vid="ACT 13:33">‘तू मेरो बालका है;</para>
  <para style="q2" vid="ACT 13:33">आज मैं तेरो दऊवा बन गौ हौं।’<verse eid="ACT 13:33"/></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34"/>और परमेस्वर बाकै मरे भैन मैं ऊपर उठन के बारे मैं कही, कहुए कबर मैं सड़न के ताहीं नाय:</para>
  <para style="q1" vid="ACT 13:34">‘मैं तुम्हैं पवित्र आर्सिवाद दुंगो</para>
  <para style="q2" vid="ACT 13:34">मैं दाऊद से वादा करो रहौं।’<verse eid="ACT 13:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35"/>जैसो कि बास्तव मैं बौ एक और भजन संहिता मैं कहथै:</para>
  <para style="q1" vid="ACT 13:35">‘तैं अपने वफादार जन कै कबर मैं सड़न ना देगो।’<verse eid="ACT 13:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36"/>काहैकि दाऊद अपने समय मैं परमेस्वर के उद्देस्यन की सेबा करी, और फिर बौ मर गौ, अपने पुरखन के संग दफनाओ गौ, और बाके सरीर कै कबर मैं रखो गौ। <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>पर जौ बाके संग ना भौ जोकै परमेस्वर मौत मैं से जिंदो। <verse eid="ACT 13:37"/><verse number="38" style="v" sid="ACT 13:38"/>हम तुमकै जाननो चाहथैं, मेरे साथी इस्राएलियौ, कि जौ ईसु के जरिये से है कि पापन की माफी के बारे मैं संदेस तुमकै प्रचारित करो जाथै; जिनसे मूसा को नियम तुम्हैं माफ नाय कर सकथै। <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>और जो कोई बाके ऊपर बिस्वास करथै बौ बे उन सब पापन से मुक्त हुई जाथै। <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>ध्यान रखियो, फिर, ताकी भविस्यवक्ता जो कछु कही हैं बौ तुमरे संग ना होबै:<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>‘देखौ, तुम बदमासौ! चकित हुई जाबौ और मर जाबौ!</para>
  <para style="q1" vid="ACT 13:41">आज मैं जो कछु कर रौ हौं</para>
  <para style="q2" vid="ACT 13:41">बौ कुछ ऐसो है जब कोई जाकै तुमकै समझागो,</para>
  <para style="q2" vid="ACT 13:41">तौ तुम बाके ऊपर बिस्वास ना करैगे!’”<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>जैसो कि पौलुस और बरनबास सभाघर से निकरत रहैं, लोग उन्हैं अगले साबत के रोज बापस आन और अपनी बातन के बारे मैं और जाधे बतान के ताहीं नहोरे करीं। <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>लोगन के सभाघर से आराधना खतम होन के बाद, पौलुस और बरनबास के पच्छू तमान यहूदि और तमान गैर यहूदि रहैं जो यहूदि धर्म मैं बदल गै रहैं। प्रेरित उनसे बात करकै समझाईं, कि परमेस्वर के अनुग्रह और किरपा मैं बने रहाबौ।<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>अगले साबत के दिन सहर के लमसम सब आदमी प्रभु को बचन सुनन के ताहीं आए। <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>लेकिन यहूदि भीड़ कै देखकै नफरत से भर गै, और बुराई करत भै पौलुस की बातन के खिलाप मैं बोलन लागे। <verse eid="ACT 13:45"/><verse number="46" style="v" sid="ACT 13:46"/>लेकिन पौलुस और बरनबास और भी निडर हुईकै कहीं: “जरूरी रहे, कि परमेस्वर को बचन अग्गु तुमकै सुनाओ जाए। लेकिन जब तुम जाकै ना अपनाथौ और अपने आपकै अनंत जिंदगी के ताहीं नाय परखथौ, तौ हम तुमकै छोड़ देंगे और गैर यहूदिन मैं जांगे। <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>काहैकि प्रभु हमकै जौ आग्या दई है, बौ जौ है:</para>
  <para style="q1" vid="ACT 13:47">‘मैं तोकै गैर यहूदिन के ताहीं जोती ठहराओ हौं,</para>
  <para style="q2" vid="ACT 13:47">कि तैं पृथ्वी के छोर ले उद्धार पहोंचाबै और सब बच जामैं।’”<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>जौ सुनकै गैर यहूदि खुस भै, और प्रभु के बचन की बड़ाँईं करन लगे, और जित्ते अनंत जिंदगी के ताहीं ठहराए गै रहैं, बे सब बिस्वास करीं।<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>तौ प्रभु को बचन बौ पूरे छेत्र मैं फैल गौ। <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>लेकिन यहूदि आदमी ऊँचे कुल की भक्त बईंय्यरन कै और सहर के जाने-माने आदमिन कै भड़काईं, जो परमेस्वर की आराधना करत रहैं, और पौलुस और बरनबास के खिलाप मैं करबाय कै उनकै अपने छेत्र से बाहर निकार दईं। <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>प्रेरित उनके बिरोध मैं अपने पाँव के धूदर कै झारकै इकुनियुम कै चले गै। <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>और चेला अन्ताकिया मैं खुसी और पवित्र आत्मा से भरत गै।<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s">पौलुस और बरनबास इकुनियुम मैं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>इकुनियुम मैं भी जहे बात भइ: कि पौलुस और बरनबास यहूदियन के सभाघर मैं गै, और ऐसी बात करीं, कि यहूदि और गैर यहूदि लोग विस्वासी बन गै। <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>लेकिन जो यहूदि बिस्वास ना करी रहैं, बे गैर यहूदिन कै भड़काए कै उन्हैं विस्वासी भईय्यन के खिलाप कर दईं और उनके मन मैं जहर भर दईं। <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>और बे प्रेरित लंबे समय तक हूँना रुके रहे, प्रभु के बारे मैं निडर हुईकै बात करत भै, जो बे साबित करीं कि उनकी किरपा के बारे मैं उनको अनुग्रह को संदेस उन्हैं चिन्ह चमत्कार और अचम्मे काम करन की सक्ति देन के ताहीं गभाई देथै। <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>लेकिन सहर के आदमिन के बीच मैं फूट पड़ गई रहै; और जासे कित्ते तौ यहूदिन के घाँईं, और कित्ते प्रेरितन के घाँईं हुईगै।<verse eid="ACT 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5"/>तौ कुछ गैर यहूदि और यहूदि अपने मुखियन के संग मिलकै प्रेरितन के संग बुरो बर्ताव करन के ताहीं और उन्हैं पथरा मारन को फैसला करीं। <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>जब प्रेरितन कै जाके बारे मैं पता चलो, तौ बे लुकाओनिया मैं लुस्त्रा और दिरबे के सहरन और आसपास के छेत्र मैं भाज गै। <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>हूँना बे सुसमाचार को प्रचार करीं।<verse eid="ACT 14:7"/></para>
  <para style="s">लुस्त्रा और डरबा मैं</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>लुस्त्रा सहर मैं एक आदमी रहै, बौ जनम से लंगड़ा रहै, और कहुए नाय नेंगी रहै। <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>बौ हूँना बैठकै पौलुस की बात सुनी। पौलुस बाकै देखी कि बौ बिस्वास करथै और अच्छो हुई सकथै, जौ बजह से बौ बाकै एक टक भाँदकै देखी <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>और बासे ऊँचे बोल मैं कही, “अपनी टाँग के बल सीध ठाड़ जा।” तौ बौ कूदकै चलन फिरन लगो। <verse eid="ACT 14:10"/><verse number="11" style="v" sid="ACT 14:11"/>जब भीड़ पौलुस को जौ काम देखी, तौ बे अपनी लुकाओनियाई भासा मैं चिल्लानो सुरू कर दईं, “दुईता आदमिन के तराहनी ही गै हैं और हमरे झोने आए गै हैं!” <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>और बे बरनबास कै ज्यूस, और पौलुस कै हिरमेस नाओं दईं, काहैकि बे मुख्य वक्ता रहैं। <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>और ज्यूस दुईता को बौ पुजारी रहै, जोको मंदिर सहर के बाहर खड़ो रहै, बौ बरधा और फूलन की माला कै सहर के मोहोंट मैं लाईं, काहैकि बौ और भीड़ प्रेरितन के ताहीं बलिदान देनो चहात रहैं।<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>जब बरनबास और पौलुस प्रेरित ऐसो सुनीं, तौ बे अपने लत्ता फाड़ीं और भीड़ के बीच मैं भाजत भै चिल्लाईं, <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>“तुम जौ काहे कर रै हौ? हमउँ तौ तुमरे जैसी इंसान हैं! हम हिंयाँ तुमकै सुसमाचार सुनाथैं, कि तुम जे बेकार चीजन से अलग हुईकै जिंदे परमेस्वर के घाँईं फिरौ, जो स्वर्ग और धरती और समुंदर और जो कछु बामै है बनाई। <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>बीते समय मैं बे सब लोगन कै अपने तरीका से जान दई। <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>लेकिन बौ हमेसा अपनी मौजूदगी को सबूत दई है कि बौ जो अच्छो काम करथै: बौ तुमकै सई समय मैं स्वर्ग से मेंहें, और फसल दई है; बौ तुमकै खानु देथै और तुमरे मन कै सांति और खुसी से भर देथै।” <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>जे सब्दन के संग प्रेरित सायद भीड़ कै उनके ताहीं बलिदान देन से रोक सकैं।<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>कुछ यहूदि अन्ताकिया और इकुनियुम से आए रहैं; आदमिन कै अपने घाँईं कर लईं, और पौलुस के ऊपर पथराव करीं, और बाकै मरो भौ समझकै सहर के दुआरे घसीटत लैगै। <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>लेकिन जब चेला बाके घाँईं आयकै ठाड़गै, तौ बौ उठकै सहर मैं गौ और दुसरे दिन बरनबास के संग दिरबे के घाँईं चले गौ।<verse eid="ACT 14:20"/></para>
  <para style="s">सीरिया के अन्ताकिया मैं लौटनो</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>और बे दिरबे सहर के आदमिन कै सुसमाचार सुनाए कै, और निरे चेला बनाएकै, लुस्त्रा, इकुनियुम से अन्ताकिया कै लौट आए। <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>बे चेलन कै मजबूत करत रहैं और उनकै जौ सुसमाचार देत रहैं कि बिस्वास के ताहीं सच्चे मन से रहाबौ; और जौ कहत रहैं, हमकै बड़ा कलेस सह कै परमेस्वर के राज्य मैं घुसन होगो <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>और बे हर एक कलीसिया मैं उनके ताहीं बड़े-बूढ़े चुनत रहैं, और बर्त के संग प्रार्थना करकै उनके प्रभु की बड़ाँईं करीं, जोमैं बे अपनो बिस्वास रखी रहैं।<verse eid="ACT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24"/>और पिसिदिया परदेस से होत भै बे पंफूलिया परदेस मैं पुगे। <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>और पिरगा नगर मैं बचन सुनाए कै अत्तालिया नगर मैं आए। <verse eid="ACT 14:25"/><verse number="26" style="v" sid="ACT 14:26"/>और हूँना से बे अन्ताकिया लौट आए, जो जघा बे परमेस्वर के अनुग्रह और किरपा की देखाभारी करन के ताहीं सराहे गै रहैं जो अब बे पूरो कर चुके हैं।<verse eid="ACT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27"/>जब बे अन्ताकिया पुगे, तौ बे कलीसिया के लोगन कै एक संग इखट्टो करीं और उनकै बे सबन के बारे मैं बताईं जो परमेस्वर उनके संग करी रहै और कैसे बे गैर यहूदि के बिस्वास करन को फाटक खोल दईं। <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>और बे चेलन के संग लंबे समय ले हूँना रहे।<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s">यरूसलेम मैं सभा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>फिर यहूदिया से कुछ आदमी अन्ताकिया आयकै विस्वासी भईय्यन कै जौ सिखान लगे; “अगर तुमरो खतना मूसा के नियम से नाय होथै तौले तुम उद्धार नाय पाए सकथौ।” <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>जब पौलुस और बरनबास की उनसे खूबै लड़ाई और बहेस भइ तौ जहे ठहराओ गौ, कि पौलुस और बरनबास, और अन्ताकिया से कुछ आदमी जौ बात के बारे मैं प्रेरितन और बड़े-बूढ़ेन के झोने यरूसलेम कै जाएकै पता करैं।<verse eid="ACT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3"/>तौ कलीसिया उनकै कुछ दूर ले छोड़न आई; और बे फीनीके और सामरिया से होत भै गुजरे, तौ बे बताईं कि कैसे गैर यहूदि परमेस्वर के घाँईं फिरे हैं; जौ खबर सुनकै सब विस्वासी भईय्यन कै बड़ा खुसी भइ। <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>जब बे यरूसलेम मैं पुगे, तौ कलीसिया और प्रेरित और बड़े-बूढ़े उनसे खुसी के संग भेंटा करीं, और बे बताईं कि परमेस्वर उनके संग हुईकै कैसे-कैसे काम करी रहै। <verse eid="ACT 15:4"/><verse number="5" style="v" sid="ACT 15:5"/>लेकिन फरीसिन के झुंड मैं से कुछ विस्वासी ठाड़गै और कहीं, “गैर यहूदिन कै खतना करनो चाहिए और मूसा के नियम को पालन करनो चाहिए।”<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>तौ प्रेरित और बड़े-बूढ़े मिलकै जौ सवाल मैं बिचार करीं। <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>बड़ा बहस के बाद पतरस ठाड़कै कही, “मेरे भईय्यौ और बहेनियौ, तुम जानथौ कि भौत समय पहले परमेस्वर मोकै तुम मैं से चुनी रहै कि हम गैर यहूदिन कै सुसमाचार सुनामैं, ताकी बे सुन सकैं और बिस्वास कर सकैं। <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>और परमेस्वर, जो सबन के बिचारन कै जानथै, गैर यहूदिन कै अपनी पवित्र आत्मा दैकै उन्हैं अपनाय लई, जैसो बौ हमरे संग करी। <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>बौ हमरे और उनके बीच कोई भेद-भाव ना करी; काहैकि बौ बिस्वास से उनके मन कै सुद्ध करी। <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>तौ अब तुम परमेस्वर की काहे इम्तिहान लेथौ। कि चेलन की घेंट मैं ऐसो जुआ धरौ, जोकै ना हमरे बड़े-बूढ़े ठड़बाए सक्त रहैं और ना हम ठड़बाए सकथैं। <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>न! हम बिस्वास करथै और प्रभु ईसु के अनुग्रह और किरपा से बच जाथैं, जैसे बे हैं।”<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>तौ पूरी सभा चुप्पेचाप‍ से बरनबास और पौलुस की बात सुनन लागी, जो कि परमेस्वर गैर यहूदिन मैं उनके जरिये कैसे-कैसे चिन्ह दिखाई, और अचम्मे काम करी रहै। <verse eid="ACT 15:12"/><verse number="13" style="v" sid="ACT 15:13"/>जब बे बोलनो बंद कर दईं, तौ याकूब बोलो: “मेरे भईय्यौ और बहेनियौ, मेरी सुनौ। <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>सिमौन बताई, कि परमेस्वर पहली बार गैर यहूदि मैं कैसे किरपा दृस्टि करी, उनमैं से अपने नाओं के ताहीं उनकै अपनो बनाए लई। <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>भविस्यवक्तन के बचन जासे पूरी तरह सहमत हैं। जैसो कि सास्त्र कहथै,<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>‘प्रभु कहथै, जाके बाद मैं लौटंगो,</para>
  <para style="q2" vid="ACT 15:16">और दाऊद को मिलाप बारो तम्बु फिर से बनांगो।</para>
  <para style="q1" vid="ACT 15:16">और मैं जाके खंडर कै</para>
  <para style="q2" vid="ACT 15:16">फिर से मजबूत बनांगो।<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>कि बची भइ मानव जाति प्रभु कै ढूँड़ैं, और सब गैर यहूदि जो मेरो नाओं लेथैं,</para>
  <para style="q2" vid="ACT 15:17">यहोवा की जहे वाँड़ी है, जो जे कामन कै करथैं।<verse eid="ACT 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18"/>तौ परमेस्वर कहथै, जो सुरुवातै से जान लई रहै।’”<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>यूहन्ना की, “जौ मेरी राय है, हमैं गैर यहूदियन कै परेसान नाय करनो चाहिए जो न्याई परमेस्वर के घाँईं मुड़ रै हैं। <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>पर उनकै चिट्ठी लिखकै पनारैं कि बे मूर्तिन के चढ़ाय भै असुद्ध खानु होन से और व्यभिचार और घेंट अमेठे भै जानवर के मास से और बाके खून से दूर रहामैं। <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>काहैकि पुराने समय से सहर-सहर मैं मूसा की नियम को प्रचार करन बारे होत चले आए हैं, और बौ हर साबत के दिन सभाघर मैं पढ़ो जात रहै।”<verse eid="ACT 15:21"/></para>
  <para style="s">बिना यहूदि विस्वासिन कै चिट्ठी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>तौ प्रेरित और बड़े-बूढ़े पूरी कलीसिया के संग मिलकै कलीसिया के कुछ लोगन कै चुनन और उनकै पौलुस और बरनबास के संग अन्ताकिया मैं भेजन को फैसला करीं। बे दुई आदमिन कै चुनीं, जो विस्वासियन, यहूदा जोकै बरसब्बास कहो जाथै, और सीलास कै चुनीं, जो भईय्यन मैं प्रमुख रहैं। <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>और बे उनके जरिया जे चिट्ठी भेजीं:</para>
  <para style="pi" vid="ACT 15:23">“अन्ताकिया, सीरिया और किलिकिया देस के रहन बारे, हम प्रेरित और बड़े-बूढ़े तुमरे भईय्यन कै जो गैर यहूदि हैं जनम-जनम के ताहीं सुभकामना भेजथैं। <verse eid="ACT 15:23"/><verse number="24" style="v" sid="ACT 15:24"/>हम सुने हैं कि कुछ लोग हमरी आग्या के बिना हमसे बाहर चले गै और बे तुमकै परेसान करीं, बे तुमरे मन कै परेसान करीं। <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>और तभई हम एक संग मिले हैं और सब कुछ दूत चुनन और उनकै तुमकै भेजन के ताहीं सहमति उजागर करी है। बे हमरे प्रिय दोस्त बरनबास और पौलुस के संग जांगे। <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>जो अपनी ज्यान हमरे प्रभु ईसु मसीह के नाओं की सेवा के ताहीं खतरा मैं डारीं हैं। <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>तभईये हम यहूदा और सीलास कै बहै बात कहेन ताहीं पनारे हैं, जो हम लिखे हैं। <verse eid="ACT 15:27"/><verse number="28" style="v" sid="ACT 15:28"/>पवित्र आत्मा, और जरूरी बातन के अलावा; हम तुमरे ऊपर कोई और बोझ नाय डारे हैं। <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>कि जो मूर्तिन कै चढ़ाओ गौ होबै और घेंट अमेठो भौ जानवर के खून; मास कै नाय खामैं, और छिनरइपना से दूर रहामैं; इनसे दूर रैहगे तौ तुम्हारो भलो होगो। तुमरे ताहीं अच्छी कामना के संग।”<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>दूतन कै भेज दौ गौ और अन्ताकिया चले गै, जितै बे विस्वासियन के पूरे झुंड कै जोरीं और उनकै चिट्ठी दईं। <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>और जब आदमी जाए पढ़ीं, तौ बे प्रोत्साहित से भरो संदेस से खुसी से भर गै। <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>और यहूदा और सीलास जो खुद भविस्यवक्ता रहैं, बे भईय्यन से निरी लम्बी बात करीं जोसे बे हौंसला और ताकत से भर गै। <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>कुछ समय हूँना बितान के बाद, उनकै भईय्यन के जरिया सांति के संग पनार दौ गौ, और जो लोग उनकै भेज डारीं रहैं, बे बापस चले गै। <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/>लेकिन सीलास कै हूँना रहनों अच्छो लगो।<verse eid="ACT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35"/>पौलुस और बरनबास कुछ समय अन्ताकिया मैं बिताईं; और कइयो लोगन के संग मैं बे प्रभु को सुसमाचार सुनात और प्रचार करत रहे।<verse eid="ACT 15:35"/></para>
  <para style="s">पौलुस और बरनबास को बिछड़नो</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>कुछ समय बाद पौलुस बरनबास से कही, “जो-जो सहरन मैं हम जो प्रभु को बचन सुनाए रहैं, आबौ, उनके झोने जाएकै बे भईय्यन और बहेनियन को हाल-खबर लेमैं।” <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>बरनबास की इच्छा रहै कि बौ यूहन्ना जोको दुसरो नाओं मरकुस है कै भी अपने संग लै चले, <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/><note caller="+" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">प्रेरितो 13:13</ref></char></note>लेकिन पौलुस बाकै अपने संग लै जानो सई ना समझी, काहैकि बौ उनके मिसन के संग आखरी ले ना रुको रहै, बल्कि उनकै पंफूलिया मैं छोड़ दई रहै। <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>और जे दोनों के बीच मैं ऐसी बहस भइ कि बे एक दुसरे से अलग हुईगै; तौ बरनबास, मरकुस कै लैकै साइप्रस कै चले गै। <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>जबकी पौलुस सीलास कै छाँटी, और प्रभु को अनुग्रह और किरपा भईय्यन की देखाभारी करन के ताहीं सराहना करी। <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>सीरिया और किलिकिया से होत भै निकरो, जोसे कलीसियन कै मजबूती मिली।<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s">तीमुथियुस पौलुस और सीलास के संग जाथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>पौलुस दिरबे और लुस्त्रा मैं भी गौ, और हूँना तीमुथियुस नाओं को एक चेला रहै। बाकी अईय्या यहूदि विस्वासी रहै, लेकिन बाको दऊवा यूनानी रहै। <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>लुस्त्रा और इकुनियुम मैं सबै विस्वासी भईय्यन तीमुथियुस की अच्छी बात करीं। <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>पौलुस तीमुथियुस कै अपने संग लै जानो चहात रहै, जहे बजह से बौ बाको खतना करी काहैकि बे जघा रहेन बारे सबै यहूदि जानत रहै कि तीमुथियुस को बाबा यूनानी रहै। <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>और सहर-सहर जात भै बे उन नियम कै जो यरूसलेम के प्रेरित और बड़े-बूढ़े ठहराईं रहैं, मानन और परखन के ताहीं उनकै झोने जात रहै। <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>जौ बजह से कलीसियन कै बिस्वास मैं मजबूत बनाओ गौ और रोजाना संख्या मैं बढ़त भइ।<verse eid="ACT 16:5"/></para>
  <para style="s">तरोआस मैं पौलुस कै दर्सन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>बे फ्रूगिया और गलातिया देसन मैं से हुईकै गै, काहैकि पवित्र आत्मा उनकै आसिया के देसन मैं बचन सुनान से मना कर दई। <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>बे मूसिया की सीमा मैं पुगकै बितूनिया मैं जान की कोसिस करीं, लेकिन ईसु की आत्मा उनकै जान की इजाजत ना दई। <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>जौ बजह से बे मूसिया से हुईकै तरोआस मैं आए। <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>हूँना पौलुस रात कै एक दर्सन देखी कि एक मकिदुनी आदमी ठाड़ो भौ, बासे नहोरे करकै कहथै, “मकिदुनिया मैं आ और हमरी मदद कर!” <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>बाके जौ दर्सन देखतै हम तुरंतै मकिदुनिया रवाना होन के ताहीं तैयार हुईगै, काहैकि हम तैं करे कि परमेस्वर हमैं हूँना के लोगन कै सुसमाचार सुनान के ताहीं बुलाई है।<verse eid="ACT 16:10"/></para>
  <para style="s">फिलिप्पी मैं: लुदिया को बिस्वास करनो</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>हम तरोआस से जहाज के जरिया सीधे समुथ्राके रवाना भै और दुसरे दिन कै नियापुलिस मैं आए। <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>हूँना से हम फिलिप्पी मैं गै, जो मकिदुनिया जिला को खास सहर, और रोमन की बस्ती रहै; हम बौ सहर मैं कुछ दिन तक रहे; <verse eid="ACT 16:12"/><verse number="13" style="v" sid="ACT 16:13"/>साबत के दिन हम सहर के दुआरे नदिया के टिकारे जौ समझकै गै कि हूँना प्रार्थना करन की जघा होगी; और बे हूँना बैठी भइ बईंय्यरन से बात करन लगे। <verse eid="ACT 16:13"/><verse number="14" style="v" sid="ACT 16:14"/>जो बईंय्यरैं हमैं सुनीं, उनमैं से एक थुआतीरा सरह मैं की लुदिया नाओं की बईय्यर रहै, जो बैंगनी लत्तन को ब्यापार करत रहै। बौ एक बईय्यर रहै जो परमेस्वर की आराधना करे करत रहै, और प्रभु बाको मन खोली, ताकी पौलुस की बातन मैं ध्यान लगाबै। <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>और बाके बाद बाके घर के लोग बपतिस्मा लईं, बौ हमकै बुलबाई, “आबौ और मेरे घर मैं रहबौ अगर तुम फैसला करे हौ कि मैं प्रभु मैं सच्चो बिस्वास रखथौं।” और बौ हमकै नहोरे करकै जान के ताहीं मनाए लई।<verse eid="ACT 16:15"/></para>
  <para style="s">पौलुस और सीलास कैदखाना मैं</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>एक दिन जब हम प्रार्थना करन बारी जघा मैं जात रहैं, तौ हमरो भेंटा एक ज्वान सेविका बईय्यर से भइ, जोमैं एक प्रेत आत्मा रहै, जो बाकै भविस्य की भविस्यवाँड़ी करन मैं माहिर बनाई। बौ अपने मालिकन कै भाग्य बताए कै बड़ा पैसा कमाई। <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>बौ पौलुस और हमरे पच्छू आत भै कही, “जे आदमी परमप्रधान दऊवा परमेस्वर के सेवक हैं! बे तुमरी घोसड़ाँ करत हैं कि तुमरो कैसे उद्धार हुई सकथै!” <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>बौ निरे दिन तक ऐसो करी, जबले की पौलुस इत्तो परेसान नाय भौ कि बौ चक्कर लगाई और आत्मा से कही, “ईसु मसीह के नाओं मैं, मैं तुमकै बासे बहार आन कै कहथौं!” आत्मा बहे घड़ी निकरकै चली गई।<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>“जब बाके मालिकन कै पता लगो कि हमरी कमाई की आसा खतम हुई जाए रहो है, तौ पौलुस और सीलास कै पकड़कै चौराहे मैं मुखिया के झोने खींचत भै लैगै। <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>बे उनकै रोमन अधिकारिन के झोने लाए और कहीं, जे आदमी यहूदि हैं, और जे हमरे सहर मैं बखेड़ो खड़ो कर रै हैं। <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>और बे ऐसी रीति रिवाज सिखाए रै हैं जो हमरे नियम के खिलाप है; हम रोमन नागरिक हैं, और हम जे रीति रिवाजन कै नाय अपनाय सकथैं या उनकै नाय पढ़ सकथैं।” <verse eid="ACT 16:21"/><verse number="22" style="v" sid="ACT 16:22"/>और भीड़ पौलुस और सीलास के खिलाप जुराए कै उनके ऊपर चढ़ गई।</para>
  <para style="p" vid="ACT 16:22">तौ हाकिम पौलुस और सीलास के लत्ता फाड़ दईं, और उनकै बेंथ से मारन कै कहीं। <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>खूब पिटाई के बाद, उनकै कैदखाना मैं डरबाए दईं और दरोगा से कहीं कि उनकै तंग करकै रखियो। <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>उनके कहनो के मुताबिक दरोगा उनकै भीतर की कुठरिया मैं लैजाय कै और उनकी टाँग कट्ठा के खपचा मैं कस दईं।<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>करीबन आधी रात कै पौलुस और सीलास प्रार्थना करत भै परमेस्वर के भजन संहिता गात रहैं और दुसरे कैदी उनकी बातैं सुनत रहैं। <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>कि इत्ते मैं अनकाचीति एक बड़ो हालाचाला आओ, जो कैदखाना की बुनियाद को पथरा तक हलाए दई। एक बार सब फाटक खुल गै, और सबन की साँकर खुल गईं। <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>दरोगा जग गौ, और जब बौ कैदखाना के फाटक खुले देखकै समझी कि कैदी भाज गै हैं, तभईये बौ अपनी तलवार से खुदकै मारनो चाही। <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>लेकिन पौलुस तेज अबाज से चिल्लाए कै कही, “अपने कै कछु नुकसान मत करै, काहैकि हम सब हीनैं हैं!”<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>तभई दरोगा दिया मंगवाए कै भीतर आओ और कपकपात भौ पौलुस और सीलास के पाँव मैं गिर गौ। <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>फिरौंकी उनकै दुआरे लाए कै कही, “हे मालिक उद्धार पान ताहीं मैं का करौं?”<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>बे जबाब दईं, “प्रभु ईसु के ऊपर बिस्वास कर, तौ तैं और तेरो पूरो परिवार उद्धार पागो।” <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>तौ बे बाके पूरे घर के आदमिन कै प्रभु को बचन सुनाईं। <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>और रात कै बहे समय बौ उनकै लै जाएकै उनके घाव कै धोई, और बौ अपने सब आदमी समेत तुरंतै बपतिस्मा लई। <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>फिर बौ पौलुस सीलास कै अपने घर मैं लै जाएकै कुछ उनकै खानु खान कै दई। और बाको पूरो परिवार परमेस्वर ऊपर बिस्वास करकै खुसी मनाईं।<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>अगले भोर रोमन अधिकारी पुलिस अधिकारिन कै आदेस दैकै भेजी, “कि बे आदमिन कै छोड़ देबौ।”<verse eid="ACT 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36"/>फिर कैदखाना को अधिकारी पौलुस से कही, “अधिकारियैं तोकै और सीलास कै छोड़ देन को आदेस दई हैं। अब तुम छोड़कै सांति से जाए सकथौ।”<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>लेकिन पौलुस पुलिस अधिकारी से कही, “हमैं कोई भी गुनाह को कसूरवार नाय पाईं, फिर भी बे हमैं सबन के सामने मारीं, हम रोमन नागरिक हैं! फिर भी बे हमैं कैदखाना मैं डार दईं। और अब बे हमैं चुपके से भेजनो चाहथैं। ऐसो ना हुई सकथै! रोमन अधिकारिन कै खुद हींना आनो चाहिए और हमैं बाहर लैकै जामैं।”<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>पुलिस अधिकारी जे बातन की खबर रोमन अधिकारिन कै दईं; और जब बे सुनीं कि पौलुस और सीलास रोमन नागरिक हैं, तौ बे डराय गै। <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>जौ बजह से बे जाएकै उनसे नहोरे करी और माफी माँगी; और बे उन्हैं कैदखाना से बाहर निकारीं और उनसे सहर छोड़न के ताहीं कहीं। <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>पौलुस और सीलास कैदखाना से निकरकै लुदिया के घरै गै। हूँना बे विस्वासी भईय्यन से मिलकै उनकै हौंसला दईं, और चले गै।<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s">थिस्सलुनीके सहर मैं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>पौलुस और सीलास अम्फिपुलिस और अपुल्लोनिया से होत भै थिस्सलुनीके मैं आए, जितै यहूदियन को एक सभाघर रहै। <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>पौलुस साधारँड़ चाल-चलन के जरिया उनके झोने गौ, और हूँना तीन साबत दिन के दौरान आदमिन से सास्त्र की बातचीत करी। <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>और उनकै सास्त्र से फोड़-फोड़कै मतलब समझात रहै, और साबित करी कि “मसीह को दुख उठानो, और मरे भै मैं से जिंदो होनो जरूरी रहै,” पौलुस कही, “जहे ईसु की जोकी मैं बात सुनाथौं, मसीह है।” <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>उनमैं से कुछ यहूदिन कै राजी कर लौ गौ, और भक्त यूनानिन मैं से निरे और निरी सारी बईंय्यरैं परमेस्वर कै अपनाईं, और पौलुस और सीलास के संग सामिल हुईगै और परमेस्वर की आराधना करीं।<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>लेकिन यहूदि जलन से भर गै और फालतू आदमी जुराए कै एक बड़ी भीड़ बनाएकै सहर मैं हुलगदड़ मचान लागे। और पौलुस और सीलास कै ढूँड़न लगे ताकी और लोगन कै बहार लाय सकैं, जहे कोसिस मैं यासोन नाओं के एक आदमी के घर मैं हमला कर उनकै आदमिन के बीच लानो चाँहीं। <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>लेकिन जब उनकै हूँना नाय पाईं तौ बे चिल्लात भै सहर के हाकिम झोने यासोन और कुछ विस्वासी भईय्यन कै खींच लाईं, “जे लोग दुनिया मैं गलत माहौल बनाए दईं हैं! और अब हिंयाँ भी आए गै हैं, <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>और यासोन उनकै अपने घर मैं रखी है। बे सबै कैसर के नियम कै तोड़ी रै हैं कि एक और राजा है, जोको नाओं ईसु है।” <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>जब भीड़ नगर और हाकिम जे बात सुनी, तौ बे बाकी बात मैं आए गै। <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>हाकिम यासोन और बाकी आदमिन कै जमानत के ताहीं पैसन को भुगतान करीं, और फिरौंकी उनकै छोड़ दईं।<verse eid="ACT 17:9"/></para>
  <para style="s">बेरीया नगर मैं</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>तौ भईय्या तुरंतै रातौ-रात पौलुस और सीलास कै बेरीया मैं पनार दईं। जब बे हूँना पुगकै, यहूदिन के सभाघर मैं गै। <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>जे आदमी थिस्सलुनीके के यहूदिन से समझदार रहैं तभईये बे पूरी लगन से बचन अपनाईं, और रोजाना पवित्र सास्त्रन मैं ढूँड़ते कि जे बात पौलुस सच कही है कि नाय। <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>उनमैं से निरे लोग बिस्वास करीं; और ऊँची खानदान की निरी यूनानी बईंय्यरैं और निरे आदमी भी बिस्वास करीं। <verse eid="ACT 17:12"/><verse number="13" style="v" sid="ACT 17:13"/>लेकिन जब थिस्सलुनीके के यहूदि जानगै कि पौलुस बेरीया मैं भी परमेस्वर को बचन सुनाई है, तौ बे हूँना आयकै भीड़ कै भड़कान लागे। <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>तभई भईय्या पौलुस कै समुंदर के टिकारे पनार दईं; लेकिन सीलास और तीमुथियुस बेरीया मैं लौट गै। <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>पौलुस कै भेजन बारे बाकै एथेंस ले लैगै, और फिर पौलुस से आग्या लैकै बेरीया लौटे कि सीलास और तीमुथियुस जल्दिये बाके संग मिल जामैं।<verse eid="ACT 17:15"/></para>
  <para style="s">एथेंस नगर मैं</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>जब पौलुस एथेंस मैं सीलास और तीमुथियुस कै असियात रहै, तौ नगर कै मूर्तिन से भरो भौ देखकै बौ मन से भौत परेसान भौ। <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>तभई बे यहूदि और यहूदि सभाघर मैं बतकाईं की, हर दिन बे नगर की चौक मैं आनबारेन के संग परमेस्वर की आराधना करीं।<verse eid="ACT 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18"/>कुछ इपिकूरी और स्तोईकी गुरु बासे बहस करन लगे। उनमैं से कुछ कहीं, “जौ अग्यानी का कहनो चाहथै?” लेकिन दुसरे लोग जबाब दईं, “बौ दुसरे विदेसी दुईतन के बारे मैं बात कर रौ है।” बे जौ इसलै कहीं काहैकि पौलुस ईसु और बाके दुबारा जी उठन और सुसमाचार को<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="ft" closed="false">पुनरुत्थान</char></note> प्रचार करत रहै। <verse eid="ACT 17:18"/><verse number="19" style="v" sid="ACT 17:19"/>जौ बजह से बे पौलुस कै अपने संग अरियुपगुस सहर के घेरा की एक बैठक मैं लै आई, जहाँ बे बासे कहीं, “का हम जानथै की जौ नया सिक्छड़ का है जो तुम दिखाए रहे हौ? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>काहैकि तू अनोखी बात हमैं सुनाए रहो है, तभईये हम जाननो चाहथैं कि इनको मतलब का होथै।” <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>तभईये सबै एथेंस नगर बारे और बाहर के जो हूँना रहेत रहैं, अपनो समय बितान के अलावा और कछु नाय करत रहैं और नये बिचारन कै सुनत रहैं।<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>पौलुस अरियुपगुस सहर परिसद के सामने ठाड़कै कही, “एथेंस मैं रहन बारेयौ, मैं देखथौं कि तुम सब बड़ा धर्मी हौ। <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>काहैकि मैं तुमरे नगर से चलत भौ आत रहौं, और बे जघन कै देखो, जितै तुम आराधना करथौ, तौ मोकै एक बेदी मिली, जोमैं लिखो रहै, ‘अनजानो परमेस्वर।’ तभई मैं तुमकै बाके बारे मैं बतानो चाहथौं जोकै तुम बिना जाने पूजथौ। <verse eid="ACT 17:23"/><verse number="24" style="v" sid="ACT 17:24"/>परमेस्वर, जो धरती और बामै सब कछु बनाई है, बौ स्वर्ग और दुनिया को प्रभु है और इंसान के हातन से बने भै मंदिरन मैं नाय रहथै। <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>ना बाकै कोई ऐसी चीज की जरूरत है जोकै हम बाके ताहीं काम करकै पूरो कर सकैं, काहैकि बौ तौ खुदै जिंदगी और सांस और सब कछु देथै। <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>बौ एकै इंसान से धरती मैं सब तरह की जाति बनाई और उनकै पूरी पृथ्वी रहेन ताहीं दई। और जघन की सीमा तैं करीं, जितै बे रहेत रहैं। <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>बौ ऐसो जहेमारे करी ताकी बे बाकै ढूँड़ैं, और सायद बे बाकै पाए लेमैं जैसो कि बे बाके बारे मैं महसूस करीं रहैं। फिर भी परमेस्वर बास्तव मैं हममैं से कोई से दूर ना है; <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>जैसो कि कोई कहो है,</para>
  <para style="q1" vid="ACT 17:28">‘बामै हम जीथैं और अग्गु बढ़थैं और मौजूद रहथैं।’</para>
  <para style="m" vid="ACT 17:28">जैसो कि तुमरे कुछ कवि कहीं हैं,</para>
  <para style="q1" vid="ACT 17:28">‘हमउँ उनके बालका हैं।’<verse eid="ACT 17:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29"/>काहैकि हम परमेस्वर के बालक हैं, हमकै जौ नाय माननो चाहिए कि बाको स्वभाव सोनो या चाँदी या पथरा की छवी जैसो है, जोकै इंसान की कला और सोच से बनाओ गौ है। <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>परमेस्वर बौ समय कै अनदेखो कर दई जब लोग बाकै नाय जानत रहैं, लेकिन अब बौ उन सबन कै हर जघा आग्या देथै कि बे अपनी बुरी रहा से मुड़ैं। <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>काहैकि बौ एक दिन ठहराई है जोमैं बौ बहे धार्मिकता से दुनिया को न्याय करैगो, जो आदमी कै बौ ठहराई है और बाकै मरे भैन मैं से जिंदो करकै जौ बात सबन के बीच मैं साबित कर दई है!”<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>जब बे पौलुस कै पुनरुत्थान के बारे मैं बोलत सुनी, तौ उनमैं से कित्ते बाकी मजाक उड़ाईं, लेकिन दुसरे लोग कहीं, “हम तोकै बाके बारे मैं फिर से बोलत भौ सुननो चाहथैं।” <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>और पौलुस उनकी बैठक छोड़कै उनके बीच से चले गौ। <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>लेकिन कुछ आदमी बाके संग जुड़ गै, और बिस्वास करीं, जिनमैं से दियुनुसियुस, जो परिसद<note caller="+" style="f"><char style="fr" closed="false">17:34 </char><char style="ft" closed="false">जोकै अरियुपगुस भी कहो जाथै।</char></note> को सदस्य रहै; एक बईय्यर रहै, जोको नाओं दमरिस रहै, और कुछ दुसरे लोग भी रहै।<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s">कुरिन्थुस मैं पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>जाके बाद पौलुस एथेंस कै छोड़कै कुरिन्थुस मैं चले गौ। <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>हूँना बाकै अक्विला नाओं को एक यहूदि मिलो, जोको जनम पुन्तुस मैं भौ रहै, बौ अपनी बईय्यर प्रिस्किल्ला के संग हाल ही मैं इटली से आओ रहै, काहैकि सम्राट क्लौदियुस सब यहूदिन कै रोम से निकर जान को आदेस दई रहै। जहे बजह से पौलुस उनकै देखन गौ, <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>और बाको और उनको एकै काम रहै; जहे बजह से बौ उनके संग रहो, और बे काम करन लगे, उनको काम तम्बु बनान को रहै। <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>और बौ हर साबत के दिन सभाघर मैं बात-चीत करकै यहूदि और यूनानि दोनों कै समझान की कोसिस करत रहै।<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>जब सीलास और तीमुथियुस मकिदुनिया से आए, तौ पौलुस अपनो पूरो समय संदेस प्रचार करन के ताहीं दई, यहूदिन कै गभाई देत भइ कि ईसु ही मसीह है। <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>जब बे बाको बिरोध करीं और बाके बारे मैं बुराई करीं, तौ बौ अपने लत्तन से धूदर झारकै बिरोध करी और उनसे कही, तुमरो खून तुमरेई मुड़ियन मैं होबै! “अगर तुम हराए गै हौ, तौ तुमकै जाके ताहीं खुदकै दोसी माननो चाहिए! मैं जिम्मेदार ना हौं। अब से मैं गैर यहूदिन मैं जांगो।” <verse eid="ACT 18:6"/><verse number="7" style="v" sid="ACT 18:7"/>जौ बजह से बौ उन्हैं छोड़ दई और तीतुस यूस्तुस नाओं के एक गैर यहूदि के घर मैं रहन लगो, जो परमेस्वर की आराधना करे करत रहै; बाको घर सभाघर के बगल मैं रहै। <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>क्रिस्पुस, जो सभाघर को मुखिया रहै, अपने पूरे घरबारेन समेत प्रभु मैं बिस्वास करीं; और निरे कुरिन्थवासी भी सुनकै बिस्वास करीं और बपतिस्मा लईं।<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>एक रात प्रभु दर्सन के जरिया पौलुस से कही, “मत डराबै, बल्कि बोलत रहा और हार मत मानै, <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/>काहैकि मैं तेरे संग हौं, और कोई भी तोकै नुकसान नाय पहुँचाए सकथै, काहैकि जौ सहर मैं मेरे भौत से आदमी हैं।” <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>जौ बजह से पौलुस उनकै परमेस्वर को बचन सिखात भै डेढ़ साल ले रहो।<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>जब गल्लियो कै अखाया देस को राज्यपाल बनाओ गौ, तौ हुँआँ के यहूदि जुराने, और पौलुस कै पकड़ लईं और बाकै न्याय करन बारी जघा मैं लैगै। <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>और बे कहीं, “जौ आदमी, लोगन कै जो नियम के खिलाप है बौ तरीका से परमेस्वर की आराधना करन के ताहीं कहथै!”<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>जब पौलुस बोलन बारो रहै, तौ गल्लियो यहूदिन से कही, “अगर जौ कोई बुरे अपराध या गलत काम की बात रहै, तौ यहूदिन के संग रहनो मेरे ताहीं सई होगो। <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>लेकिन अगर जौ सब्दन और नाओं और तुमरे अपने नियम के बारे मैं एक तर्क है, जहे बजह से जाकै तुमकै खुदै निपटाने होगो। मैं ऐसी चीजन को न्याय ना करनो चाहथौं!” <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>और बौ उनकै न्याय करन बारी जघा से निकार दई। <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>तौ सब जनी सभाघर के मुखिया सोस्थिनेस कै पकड़कै न्याय करन बारी जघा के अग्गु मारीं। लेकिन गल्लियो जे बातन की कछु फिकर ना करी।<verse eid="ACT 18:17"/></para>
  <para style="s">अन्ताकिया कै लौटनो</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>पौलुस कुरिन्थ भईय्यन के संग निरे दिन ले हूँना रहो, फिर उनकै छोड़ दई और सीरिया के ताहीं प्रिस्किल्ला, और अक्विला के संग रवाना भै। किंख्रिया से नईंयाँ मैं चढ़न से पहले बौ अपनो मूड़ मुड़बाय लई रहै काहैकि बौ जो बर्त लई रहै। <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>बे इफिसुस पहोंचे, जहाँ पौलुस प्रिस्किल्ला और अक्विला कै छोड़ दई। बौ सभाघर मैं जाएकै यहूदियन के संग सलाह-मसौराह करन लगो। <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>लोग जब बासे लम्बे समय ताहीं रहेन कै कहीं, लेकिन बौ राजी नाय भौ। <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>लेकिन जौ कहकै, बौ उनकै छोड़ दई, जैसो बौ कही, “अगर परमेस्वर की इच्छा भइ तौ मैं तुमरे झोने आंगो।” और बौ इफिसुस से रवाना भौ।<verse eid="ACT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22"/>जब बौ कैसरिया पहुँचो, तौ बौ यरूसलेम कै गौ और कलीसिया कै नमस्ते करी, और फिर अन्ताकिया मैं गौ। <verse eid="ACT 18:22"/><verse number="23" style="v" sid="ACT 18:23"/>हूँना कुछ समय बितान के बाद। बौ सबै चेलन कै मजबूत करत भै, गलातिया और फ्रूगिया छेत्र से चले गौ, सबै विस्वासियन कै मजबूत करत रहो।<verse eid="ACT 18:23"/></para>
  <para style="s">इफिसुस और कुरिन्थ मैं अपुल्लोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>बौ समय अपुल्लोस नाओं को एक यहूदि जोको जनम सिकन्दरिया मैं भौ रहै, इफिसुस मैं आओ रहै। जो एक ग्यानी आदमी रहै और पवित्र सास्त्र को अच्छो जानकार रहै। <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>बाकै प्रभु के रहा को निर्देस दौ गौ रहै, और बड़े उत्साह के संग बौ ईसु के बारे मैं तथ्यन कै ढंग से बताई और सिखाई। काहैकि बौ सिरफ यूहन्ना के बपतिस्मा कै जानत रहै। <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>बौ सभाघर मैं बेखौफ हुईकै बोलन लगो। जब प्रिस्किल्ला और अक्विला बाकै सुनी, तौ बे बाकै अपने संग घरै लैगै और बाकै और सई ढंग से समझाई कि परमेस्वर की रहा है। <verse eid="ACT 18:26"/><verse number="27" style="v" sid="ACT 18:27"/>तौ अपुल्लोस अखाया के झोने जान को फैसला करी, जहे बजह से इफिसुस के भईय्या अखाया मैं चेलन कै लिखकै मदत करीं, उनको स्वागत करन को बड़ाबा करीं। जब बौ आओ, तौ बौ बे लोगन के ताहीं एक बड़ो मदतगार रहै, जो परमेस्वर के अनुग्रह और किरपा से बिस्वास करन बारे रहैं। <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>अपने मजबूत तर्कन के संग बौ सार्वजनिक बहस मैं यहूदियन कै सास्त्रन जौ साबित कर दई कि ईसु ही मसीह है।<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s">इफिसुस मैं पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>जब अपुल्लोस कुरिन्थुस मैं रहै, तौ पौलुस ऊपर के सबै देस से होत भौ इफिसुस मैं पहुँचो। और हूँना कुछ चेला मिले,<verse eid="ACT 19:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 19:2"/>और उनसे पूँछी, “का तुम बिस्वास करन पोती पवित्र आत्मा पाए?” बे जबाब दईं, “हम तौ पवित्र आत्मा के बारे मैं सुने तक नाय हैं।”<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>पौलुस पूँछी, “तौ फिर तुम कैसो बपतिस्मा लै?” बे जबाब दईं, “यूहन्ना को बपतिस्मा।”<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>पौलुस कही, “यूहन्ना को बपतिस्मा बे लोगन के ताहीं रहै जो अपने पापन से मुकर गै; और बौ इस्राएल के लोगन से कही कि जो मेरे बाद आनबारो है, बहै ईसु मैं बिस्वास करियो।”<verse eid="ACT 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5"/>जब बे जौ सुनीं, तौ उनकै प्रभु ईसु के नाओं को बपतिस्मा दौ गौ। <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>जब पौलुस उनके ऊपर हाथ धरी, तौ उनके ऊपर पवित्र आत्मा उतरी; और बे अलग-अलग जबान मैं ऐलान करीं और परमेस्वर को संदेस भी सुनाईं। <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>बे सब करीबन बारह आदमी रहैं।<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>पौलुस सभाघर मैं गौ और तीन महेना के दौरान लोगन के संग बेखौफ बात करी, बौ परमेस्वर के राज्य के बारे मैं बात करतो और समझान की कोसिस करत रहो। <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>लेकिन उनमैं से कुछ जिद्दी रहैं और बिस्वास ना करत रहैं, पूरे समूह से बे प्रभु के रहा के बारे मैं बुरी बात कहीं। जौ बजह से पौलुस उनकै छोड़ दई और चेलन कै अपने संग लैगौ, और रोजाना बौ तुरन्नुस की स्कूल मैं बात-चीत करतो। <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>जौ दुई साल ले चलो, ताकी जो लोग जो कि आसिया के देसन मैं रहेत रहै, यहूदि और गैर यहूदि दोनों प्रभु के बचन कै सुनी।<verse eid="ACT 19:10"/></para>
  <para style="s">इफिसुस मैं सामर्थ्य के काम</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>परमेस्वर पौलुस के जरिया सामर्थ्य के अचम्मे काम करत रहै। <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>हिंयाँ ले कि रुमाल और अंगोछा जो बौ पहने रहै, उनकै बिमारन के झोने लैजाओ गौ रहै, और उनकी बिमारियन कै ठीक करो गौ रहै, और प्रेत आत्मा उनसे बाहर निकर जांगी। <verse eid="ACT 19:12"/><verse number="13" style="v" sid="ACT 19:13"/>बुरी सफर करन बारे और प्रेत आत्मा कै भजान बारे कुछ यहूदि ऐसो करन के ताहीं प्रभु ईसु के नाओं को उपयोग करन को भी हिम्मत करीं, बे बुरी आत्मा से कहीं, “मैं तुमकै ईसु के नाओं से आग्या देथौं, जोकै पौलुस प्रचार करथै।” <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>सात भईय्या, जो स्क्किवा नाओं के एक यहूदि बड़े पुजारी के लौड़ा रहैं, जो ऐसो करत रहैं।<verse eid="ACT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15"/>लेकिन प्रेत आत्मा कही ईसु कै मैं जानथौं और पौलुस कै भी जानथौ, पर तुम कौन हौ?<verse eid="ACT 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16"/>जो आदमी मैं प्रेत आत्मा रहै, बौ उनकै झपटी और काबू मैं करकै ऐसो परेसान करी कि बे नंगे और चोट खाएकै बौ घर से निकरकै भाजे। <verse eid="ACT 19:16"/><verse number="17" style="v" sid="ACT 19:17"/>इफिसुस के रहन बारे सब यहूदि और गैर यहूदि जौ बात सुनीं; बे सबन के ऊपर डर छाए गौ, और प्रभु ईसु के नाओं की बड़ाँईं भइ। <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>विस्वासिन मैं से कई, सबन के सामने स्वीकार करथैं और खुलासा करथैं कि बे का करी रहैं। <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>जादू कै सिकन बारेन मैं से तमान अपनी किताबन कै एक संग लाईं और उन्हैं सबके सामने जलाए दईं। बे किताबन की कीमत कै जोड़ीं, और सब मिलाएकै पचास हजार चाँदी के सिक्का भै। <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>जौ तरीका से प्रभु को बचन सामर्थ्य से फैलत गौ और मजबूत होत गौ।<verse eid="ACT 19:20"/></para>
  <para style="s">इफिसुस मैं दंगा</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>जे बात होन के बाद, पौलुस मन मैं ठान लई कि मकिदुनिया और अखाया से हुईकै यरूसलेम कै जामौं। और कही, “हूँना जान के बाद मोकै रोम कै भी देखनो चाहिए।” <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>इसलै बौ अपने दुई सेवा करन बारेन मैं से तीमुथियुस और एरास्तुस कै मकिदुनिया मैं भेजी, जबकी बौ आसिया के सहर मैं जाधे समय बिताई।<verse eid="ACT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>जौ बौ समय रहै कि प्रभु के रहा की बजह से इफिसुस मैं गंभीर संकट रहै। <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>दिमेतिरियुस नाओं को एक चाँदी को कारीगर रहै, जो अरतिमिस देवी के मंदिर चाँदी के बनाए करत रहै, जोसे कारीगरन को एक बड़ो काम चले करत रहै। <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>इसलै बौ बे सबन कै दुसरेन के संग बुलाई, जिनको काम उनके जैसो रहै और उनसे कही, “आदमियौं, तुम जानथौ कि जौ काम से हमरी समृद्धि आथै। <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>अब, तुम खुद देख सकथौ और सुन सकथौ कि जौ पौलुस का कहरौ है। बौ कहथै कि हाथ से बने भै देवता बिल्कुल भी देवता ना हैं, और बौ इफिसुस और आसिया के लमसम पूरे देसन मैं, कई लोगन कै समझान मैं कामयाब रहो है। <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>तौ खतरा है, अब सिरफ जहे एक बात को डर नाय है कि हमरे जौ कारोबार को मान-सम्मान चले जागो बल्कि जौ महान देबी अरतिमिस को मंदिर बेकार समझो जागो और बाकी महानता खतम हुई जागी। जोकै आसिया और पूरी दुनिया पूजथै!”<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>जैसी भीड़ जे सब्दन कै सुनीं, बे गुस्सा से भर गै और चिल्लान लगे, “महान तौ इफिसुस की देवी अरतिमिस है!” <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>और पूरे सहर मैं हंगामा फैल गौ। भीड़ मकिदुनिया परदेस से आए पौलुस के साथी गयुस और अरिस्तर्खुस कै पकड़ लईं, और उनके संग रंगसाला मैं पहुँचे। <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>पौलुस खुद भीड़ के सामने जानो चहात रहै, लेकिन चेला बाकै जान ना दईं। <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>कुछ आसिया के देसन के अधिकारी, जो उनके दोस्त रहैं, बे उन्हऊँ कै खबर भेजीं नहोरे करीं कि रंगसाला मैं नाय आमै। <verse eid="ACT 19:31"/><verse number="32" style="v" sid="ACT 19:32"/>जौ बीच पूरी बैठक हंगामा मैं रहै: कोई कुछ चिल्लातो, दुसरो कुछ और चिल्लातो, काहैकि उनमैं से निरेन कै तौ जहो नाय पता रहैं की बे काहे ताहीं जुराने हैं। <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>कुछ लोग निस्कर्स निकारीं कि सिकन्दर जिम्मेदार है, काहैकि यहूदि बाकै मोर्चा मैं जान के ताहीं बनाई रहैं। तौ सिकन्दर लोगन कै चुप रहन के ताहीं अपने हाथ से इसारा करी, और बौ बचाव के ताहीं भाँसड़ देन की कोसिस करी। <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>लेकिन जब बे जानगै कि बौ यहूदि है तौ सबके सब एकै अबाज मैं करीब दुई घंटा तक चिल्लात रहे, “इफिसुस की देवी अरतिमिस, महान है!”<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>आखिरकार सहर को संत्री भीड़ कै सांत करन मैं कामयाब रहो। बौ कही, “साथी इफिसियों! हर कोई जानथै कि इफिसियों सहर महान देवी अरतिमिस के मंदिर और पवित्र पथरा जो स्वर्ग से नीचे गिर गौ है बाको रक्छक है। <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>कोई भी जे बातन कै नकार नाय सकथै। तौ फिर, तुमकै सांत हुई जानो चाहिए और लापरवाही कछु ना करनो चाहिए। <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>तुम जे आदमिन कै हिंयाँ लै आए हौ, जो जे मंदिर कै ना लूटी हैं और ना हमरी देवी के बारे मैं बुराई करीं हैं। <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>अगर दिमेतिरियुस और बाके संग बारे कारीगरन कै कोई के खिलाप आरोप है। तौ हमरे पास अधिकारी और अदालत के नियमित दिन हैं; हुँआँ आरोप लगाए जा सकथैं। <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>लेकिन अगर तुम कुछ और चाहथौ तौ जाकै नगरन की एक नियम की बैठक मैं तैं करने होगो। <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>आज जो कुछ भी भौ है, बाके बाद हमरे ऊपर दंगा करन को आरोप लगाओ जागो। जौ सब हंगामा के ताहीं को बहाना ना है, और हम जाके ताहीं एक अच्छो बजह ना दै पांगे।” <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>जौ कहेन के बाद, बौ बैठक कै बिदा कर दई।<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s">मकिदुनिया और यूनान मै पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>हंगामा खतम होन के बाद, पौलुस चेलन कै एक संग बुलबाए कै समझाई और उनसे बिदाई लई। फिर बौ मकिदुनिया कै चले गौ। <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>बौ सब परदेसन से होत भौ छिरो और लोगन कै संदेस के संग हौंसला दई। फिर बौ यूनान मैं आओ। <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>जहाँ बौ तीन महेना रहो। बौ सीरिया कै जान के ताहीं तैयार होत रहै जब बाकै पता चलो कि हुँआँ तौ यहूदि बाके खिलाप साजिस रच रै हैं; जौ बजह से बौ मकिदुनिया से हुईकै बापस चले जान को फैसला करी। <verse eid="ACT 20:3"/><verse number="4" style="v" sid="ACT 20:4"/>बिरीया को रहन बारो पुरूर्स को लौड़ा सोपत्‌रुस; और थिस्सलुनीकियों को रहन बारो अरिस्तर्खुस और सिकुन्दुस; और दिरबे को गयुस; और तीमुथियुस और आसिया के देस को तुखिकुस और तुरुफिमुस; बाके संग हुई लईं। <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>बे अग्गु जाएकै तरोआस मैं हमैं असियान लगे। <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>और हम अखमीरी रोटी के त्योहार के बाद फिलिप्पी से रवाना भै, और पाँच दिन बाद हम उन्हैं तरोआस मैं मिले, जहाँ हम एक सप्ताह बिताए।<verse eid="ACT 20:6"/></para>
  <para style="s">पौलुस को तरोआस मैं आखरी सफर</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>सप्ताह के पहले दिन हम रोटी तोड़न के ताहीं एक संग आए। तौ पौलुस जो दुसरे दिन कै जान बारो रहै, उनसे बात करी और आधी रात तक बात करत रहो। <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>जो ऊपर के कमरा मैं हम जुराने रहैं, बामै निरे दिया जलत रहैं। <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>यूतुखुस नाओं को एक ज्वान आदमी खिड़की मैं बैठो भौ नींद से उँघात रहै, और पौलुस जब बात करत रहै तौ बौ नींद आन से तिसरे मंजिला से गिर पड़ो, और जब बे बाकै उठाईं तौ बौ खतम हुई चुको रहै। <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>लेकिन पौलुस तरे आयकै बाकै अकौरी मैं भर लई, और कही, “फिकर मत करौ; बौ अभऊ जिंदो है!” <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>फिरौंकी बौ ऊपर जाएकै, रोटी तोड़ी, और खाएकै। इत्ती देर तक उनसे बात करत रहो कि भुकभुको हुई गौ; फिर बौ चले गौ। <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>और बे बौ ज्वान आदमी कै जिंदो घरै लैगै, और भौत सांति पाई।<verse eid="ACT 20:12"/></para>
  <para style="s">तरोआस से लैकै मीलेतुस तक</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>हम पहले से जहाज मैं चढ़कै अस्सुस के झोने जौ सोचकै रवाना भै, कि हूँना से हम पौलुस कै चढ़ाय लेमैं। बौ हमसे ऐसिये करन ताहीं कही रहै, काहैकि अपना पैदल जात रहै। <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>जब बासे हमरो अस्सुस मैं भेंटा भौ तौ हम बाकै जहाज मैं चढ़ायकै और मितुलेने मैं चले गै। <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>हम हूँना से रवाना भै और अगले दिन खियुस पहुँचे। और एक दिन बाद हम सामुस पहुँचे, फिर दुसरे दिन हम मीलेतुस मैं पहुँचे। <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>पौलुस इफिसुस के झोने से हुईकै जान को फैसला करी रहै, कि कहूँ ऐसो न होबै, कि बाकै आसिया मैं देर लगै। बौ जल्दी मैं रहै, कि अगर हुई सकै, तौ बौ पिन्तेकुस्त के दिन ले यरूसलेम मैं रहबै।<verse eid="ACT 20:16"/></para>
  <para style="s">इफिसुस के बुजुर्गन के ताहीं पौलुस को बिदाई बारो भाँसड़</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>पौलुस मीलेतुस से इफिसुस मैं खबर भेजी, जोमैं कलीसिया के बड़े-बूढ़े से मिलन के ताहीं कही। <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>जब बे बाके झोने आए, तौ बौ उनसे कही, “तुम जानथौ कि मैं पहलिये दिन से जब मैं आसिया मैं पुगो, मैं तुमरे संग हर समय कैसे रहो। <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>मैं पूरी नमरता से और आँसु बहाए-बहाएकै, और बे इम्तिहान मैं जो यहूदियन की साजिस के बजह से जो समय मेरे ऊपर आओ, प्रभु के सेवक के रूप मैं मैं अपनो काम करो। <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>तुम जानथौ कि जो-जो बात तुमरे फायदा की रहैं उनकै सबन कै बतान से और घर-घर प्रचार करन से मैं कहु संकोच ना करो। <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>यहूदि और गैर यहूदिन कै एक हानी चितौनी देत रहौं कि परमेस्वर के घाँईं मन फिराबौ, और हमरे प्रभु ईसु मसीह मैं बिस्वास करौ। <verse eid="ACT 20:21"/><verse number="22" style="v" sid="ACT 20:22"/>और अब, मैं पवित्र आत्मा के कहेन मैं यरूसलेम कै जाएरौ हौं, ना जानै हूँना मेरे संग का होगो। <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>मैं सिरफ इतनो जानथौं कि पवित्र आत्मा हर सहर मैं मोकै चितौनी दई है कि कैदखाना की साँकर और मुसीबतैं मेरो इंतजार कर रइ हैं। <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>लेकिन मैं अपनी खुद की जिंदगी के ताहीं मेरो कुछ भी प्रिय ना है; मैं सिरफ अपने काम कै पूरो करनो चाहथौं और बौ सेवा पूरो करनो चाहथौं जो प्रभु ईसु मोकै चितौनी के जरिया करन के ताहीं दई रहै, जो कि परमेस्वर के अनुग्रह और किरपा के बारे मैं सुसमाचार की घोसड़ाँ करनो है।”<verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>मैं तुमरे सबन के बीच मैं परमेस्वर के राज्य को प्रचार सुनात फिरो हौं। और अब मोकै पता है कि तुम मैं से कोई भी मोकै फिर ना देख पागे। <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>जौ बजह से मैं पूरी तरह से तुमकै आज के दिन ऐलान करथौं: अगर तुम मैं से कोई भी भटक जाबै, तौ मैं बाके खून से निर्दोस हौं। <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>काहैकि मैं तुमकै परमेस्वर के पूरे उद्देस्य की घोसड़ाँ करन से नाय झिझको। <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>तभईये अपनी और पूरे झुंड की देखा-भारी करौ; जोमैं पवित्र आत्मा तुमकै अगुवा ठहराई है कि तुम परमेस्वर की कलीसिया की रखबारी करौ, जो बौ अपने खून के जरिये अपनो बनाई। <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>मैं जानथौं, कि मेरे जान के बाद फाड़न बारे भेंड़िया तुमरे बीच मैं आंगे, और बे झुंड कै नाय छोड़ंगे। <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>बौ समय आगो जब तुमरे खुद के झुंड के आदमी चेलन कै अपने पच्छू लान ताहीं झूठ कहमंगे। <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>देखौ, और याद करौ कि मैं तीन साल तक आँसु बहाए-बहाएकै, रात-दिन हर एक कै सिक्छा देनो नाय छोड़ो।<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>“और अब मैं तुमकै परमेस्वर की दया को बचन सौंप देथौं; जो तुमकै बढ़ाए सकथै, और परमेस्वर तुम्हैं बे सब आदमिन कै पवित्र करथै। <verse eid="ACT 20:32"/><verse number="33" style="v" sid="ACT 20:33"/>मोकै कोई को चाँदी या सोनो या लत्ता नाय चाहिए रहै। <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>तुम खुदै जानथौ कि जहे हाथ मेरो और मेरे संग बारेन की जरूरतन कै पूरो करी। <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>मैं तुमकै सब कछु करकै दिखाओ, कि जौ तरीका से मेहनत करकै कमजोरन की मदत करैं, और प्रभु ईसु की बातन कै याद धरनो जरूरी है, जो बौ खुद कही रहै: ‘लेन से जाधे देन मैं खुसी मिलथै।’”<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>जब पौलुस कहनो बंद करी, तौ बौ उनके संग घूँटे टेक कै प्रार्थना करी। <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>तौ बे सब रोन लगे और पौलुस के गले से लग कै बाकै चूमी और पनार दईं। <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>बे खासकर कै जौ बात को दुखी रहैं कि बौ कही रहै, कि तुम फिर कहु मोकै नाय देखैगे। जौ बजह से बे बाकै जहाज ले पुगान गै।<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s">पौलुस यरूसलेम कै जाथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>हम उनसे न्यारे हुईकै रवाना भै। सीधे रहा से कोस मैं आए; दुसरे दिन रूदुस मैं, और हूँना से पतरा मैं। <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>और एक जहाज फीनीके कै जात भै मिलो, तभई हम बाके ऊपर चढ़कै चले गै। <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>जब साइप्रस दिखाई दई, तौ हम बाकै उल्टा छोड़कै, सीरिया कै चलकै सूर मैं उतरे। काहैकि हूँना जहाज को समान उतारने रहै। <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>हम हूँना कुछ चेलन से मिले और उनके संग सात दिन ले रहे। बे आत्मा के सिखे भै पौलुस से कहीं कि यरूसलेम मैं मत जईये। <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>लेकिन जब उनके संग हमरो समय खतम हुई गौ, तौ हम हूँना से अपनी रहामैं नेंग दै। और बे सब बईंय्यरन और बालकन समेत, हमैं नगर के दुआरे तक छोड़न आए और हम समुंदर टिकारे घुपटियाय कै प्रार्थना करे। <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>तौ एक दुसरे से बिदाई लैकै, हम जहाज मैं चढ़ गै, और बे अपने-अपने घर लौट गै।<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>फिरौंकी हम लगातार सफर करकै सूर से पतुलिमयिस मैं पुगे, और भईय्यन कै नमस्ते करकै उनके संग एक दिन ठहरे। <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>दुसरे दिन हम हूँना से नेंग कै कैसरिया मैं आए, और फिलिप्पुस प्रचारक के घर मैं जो सातन मैं से एक जोकै यरूसलेम मैं सहायकन के रूप मैं चुनो गौ रहै, जाएकै बाके हींना रहे। <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>बाकी चार कुवाँरी लौड़िया रहैं; जो परमेस्वर के संदेसो को ऐलान करीं। <verse eid="ACT 21:9"/><verse number="10" style="v" sid="ACT 21:10"/>जब हम हूँना कुछ दिन रह लै, तौ यहूदिया से अगबुस नाओं को एक भविस्यवक्ता आओ। <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>बौ हमरे झोने आए कै पौलुस की कमरबंद लई, और अपने हाथ पायें भाँदकै कही, “पवित्र आत्मा जौ कहथै: कि जो आदमी कि जौ कमरबंद है, बाकै यरूसलेम मैं यहूदि ऐसिये भाँदंगे, और गैर यहूदिन के हाथ मैं दै देंगे।”<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>जब हम जे बात सुने, तौ हम और हूँना के आदमी बासे नहोरे करे, कि यरूसलेम कै मत जाबै। <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>लेकिन पौलुस जबाब दई, “तुम का कर रहै हौ, कि तुम ऐसे रोए रहे हौ, और मेरो मन तोड़ रहै हौ? मैं तौ प्रभु ईसु के नाओं के ताहीं यरूसलेम मैं ना सिरफ बंधन ताहीं बल्किन मरनौ ताहीं तैयार हौं।”<verse eid="ACT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14"/>जब बौ नाय मानो तौ हम जौ कहकै चुप हुईगै, “कि प्रभु की मरजी पूरी होबै।”<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>हूँना कुछ समय बितान के बाद हम अपनी चीजैं तैयारी करे और यरूसलेम कै चल दै। <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>कैसरिया के भी कुछ चेला हमरे संग हुई लईं, और मनासोन नाओं के साइप्रस के एक पुराने चेला कै संग लै आए, कि हम बाके घरै रुकैं।<verse eid="ACT 21:16"/></para>
  <para style="s">पौलुस याकूब से मिलन जाथै</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>जब हम यरूसलेम मैं पुगे, तौ हूँना के भईय्या बड़ा खुसी से हमरो स्वागत करीं। <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>दुसरे दिन पौलुस हमैं लैकै याकूब के झोने गौ: जितै कलीसिया के सब बड़े-बूढ़े जुरे रहैं। <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>तौ बौ उनकै नमस्ते करकै, जो-जो काम परमेस्वर बाकी सेवकाई के जरिया गैर यहूदि मैं करी रहै, एक-एक करकै सब बताई। <verse eid="ACT 21:19"/><verse number="20" style="v" sid="ACT 21:20"/>जौ सुनकै बे परमेस्वर की बड़ाँईं करीं और बे कहीं, “भईय्या पौलुस, तैं तौ देखो कि यहूदिन मैं हजारौ आदमी हैं, जो बे बिस्वास करीं हैं। और सब नियमन के ताहीं जोसीले हैं। <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>और उनकै तेरे बारे मैं बताओ गौ है कि तैं गैर यहूदिन के बीच मैं रहन बारे यहूदिन कै जौ सिखाथै कि मूसा कि सिक्छा कै छोड़ दिऔ और कहथै, कि न तौ बालकन को खतना करौ और नाय पुरानी रीतियन के हिसाब से चलौ। <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>तौ फिर का करो जाबै? बे तौ जरूर सुनंगे कि तैं हींना आओ है। <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>तभईये जो हम तोसे कहथैं, बौ कर। हमरे हींना चार आदमी हैं, जो बर्त रखी रहैं। <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>उनकै संग लैजाय कै उनसे अपने आपकै सुद्ध कर; और उनको खर्चा दे, कि बे मूड़ मुड़बाय लेमैं। तौ सब जान जांगे, कि जो बात उनकै तेरे बारे मैं बताईं हैं, बे सच नाय हैं बल्कि तैं खुदै मूसा के नियम कै मानत भै चलथै। <verse eid="ACT 21:24"/><verse number="25" style="v" sid="ACT 21:25"/>लेकिन बे गैर यहूदिन के बारे मैं जो बिस्वास करीं हैं, हम जौ फैसला करकै लिखकै पनारे हैं कि बे मूर्तिन के अग्गु चढ़ाय भै मास से, और खून से, और घेंट अमेठे भैन के मास से, और छिनरइपना से, बचे रहाबौ।”<verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>तौ पौलुस बे आदमिन कै लैकै, और दुसरे दिन उनके संग सुद्ध हुईकै मंदिर मैं गौ, और हूँना बताये दई, सुद्ध होन के दिन, मतलब उनमैं से सबन के ताहीं चढ़ावा चढ़ाय जान के दिन कब पूरे होंगे।<verse eid="ACT 21:26"/></para>
  <para style="s">मंदिर मैं पौलुस को पकड़ो जानो</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>जब सात दिन पूरे होन बारे रहैं, तौ आसिया के कुछ यहूदि लोग पौलुस कै मंदिर मैं देखकै सब आदमिन कै भड़काईं। और ऐसे चिल्लाए-चिल्लाए कै बाकै पकड़ लईं, <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>बे लोग चिल्लाईं। “इस्राएल के लोगौ!” मदत करौ! “जौ बहे आदमी है, जो सब जघा इस्राएल के लोगन मैं, मूसा को नियमन और जौ मंदिर के खिलाप हर कोई कै पढ़ाथै। हींना तक कि बौ यूनानिन कै भी मंदिर मैं लाए कै जौ पवित्र जघा कै अपवित्र कर दई है!” <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>काहैकि जासे अग्गु बे तुरुफिमुस नाओं के इफिसुस कै बाके संग नगर मैं देखी रहैं, और जौ समझीं कि पौलुस बाकै मंदिर मैं लाई है।<verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>तौ पूरे सहर मैं कोहराम मच गौ, और लोग दौड़कै जुराए गै, और पौलुस कै पकड़कै मंदिर के दुआरे घसीटत लाईं, और तुरंतै फाटक बन्द कर दईं। <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>जब बे बाकै मार डारनो चहात रहैं, तौ सिपईय्यन के सरदार के झोने खबर पुगी कि पूरे यरूसलेम मैं कोहराम मच गौ है। <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>एक सिपईय्या कुछ सुबेदारन कै लैकै भीड़ के झोने पुग गौ। जब लोग बाकै सैनिकन के संग देखी, तौ बे पौलुस कै पीटनो बन्द कर दईं। <verse eid="ACT 21:32"/><verse number="33" style="v" sid="ACT 21:33"/>सरदार झोने आयकै पौलुस कै पकड़ लई, और दुई जंजीर से भाँदन को आदेस दई। फिरौंकी बौ पूँछन लागो, “जौ आदमी कौन है, और बौ का करी है?” <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>लेकिन भीड़ मैं से कोई कछु और कोई कछु चिल्लात रहे और जब हुलगदड़ के बजह से सई सच ना जान सको, तौ पौलुस कै किला मैं लै जान को हुकम दई। <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>जब बौ सिड़ी मैं पुगो, तौ ऐसो भौ कि भीड़ के दाब की बजह से सिपईय्यन कै बाकै उठाएकै लै जान पड़ो। <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>लोगन की भीड़ जौ चिल्लात भै बाके पच्छू पड़ी, “बाकै खतम कर दिऔ!”<verse eid="ACT 21:36"/></para>
  <para style="s">पौलुस को खुदकै बचानो</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>जब सिपईय्या पौलुस कै किला मैं लै जान बारे रहैं, बौ सेना के सरदार से कही: “का मोकै इजाजत है कि मैं तोसे कछु कहमौं?”</para>
  <para style="p" vid="ACT 21:37">बौ पूँछी, का तैं यूनानी भासा जानथै? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>“का तैं बौ मिस्री नाय है, जो जेईं दिनन से अग्गु क्रांति सुरू करकै रेगिस्तान मैं चार हजार हथियारबन्द आतंकबादी लोगन कै लैगौ रहै?”<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>पौलुस जबाब दई, “मैं तौ तरसुस को यहूदि इंसान हौं किलिकिया के जाने-माने नगर को निवासी हौं। और मैं तोसे बिनती करथौं, कि मोकै लोगन से बात करन दे।”<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>सेनापति बाकै हुकम दई, तौ पौलुस सिड़ी मैं ठाड़कै लोगन कै चुप रहन कै ताहीं अपने हात से इसारा करी। जब बे चुप हुईगै, तौ पौलुस इब्रानी भासा मैं उनसे बात करी:<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1"/>“मेरे यहूदिया देस के दोस्तौ, मेरी बात सुनौ काहैकि मैं तुमरे सामने अपनो बचाव करथौं!” <verse eid="ACT 22:1"/><verse number="2" style="v" sid="ACT 22:2"/>बे जौ सुनकै कि बौ उनसे इब्रानी भासा मैं बोल रहो है, बे सांत ही गै; तभई पौलुस ऐसे कहकै चले गौ:<verse eid="ACT 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3"/>“मैं तौ यहूदि हौं, किलिकिया के तरसुस मैं पैदा भौ, लेकिन यरूसलेम मैं गमलीएल के छात्‌र के भेस मैं आओ। और मोकै बड़े-बूढ़ेन के नियम मैं सक्त हिदायत मिली रहै और परमेस्वर के ताहीं ऐसी धुन लगाओ रहौं जैसी तुम सब आज लगाए हौ। <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>मैं जौ रहामैं चलन बारे लोगन कै मौत के घाट उतारो। मैं ही लोग और बईंय्यरन कै पकड़ौ और कैदखाना मैं डारो। <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>खुद बड़े पुजारी और पूरी पंचायत गभा हैं कि मैं सई कर रहो हौं। मोए उनसे दमिस्क मैं यहूदिन के दोस्तन की लिखी भई चिट्ठी मिली, जहेमारे मैं जे लोगन कै पकड़न ताहीं साँकर मैं भाँदकै सजा देन के ताहीं यरूसलेम गौ।”<verse eid="ACT 22:5"/></para>
  <para style="s">पौलुस अपने परिवर्तन के बारे मैं बताई</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितो 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>“जब मैं सफर करकै दमिस्क के झोने पहोंचो, तौ ऐसो भौ कि दुपारी मैं अनकाचीति से एक बड़ो उजियारो आसमान से मेरे चारौ घाँईं चमको। <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>और मैं जमीन मैं गिर गौ और मोकै एक अबाज सुनाई दई, ‘साऊल, साऊल! तैं मोकै काहे सताथै?’ <verse eid="ACT 22:7"/><verse number="8" style="v" sid="ACT 22:8"/>मैं पूँछो, ‘तैं कौन है प्रभु? मैं नासरत को ईसु हौं, जोकै तू सताथै,’ बौ मोसे कही। <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>और मेरे संग बारे उजियारो तौ देखीं, लेकिन जो मोसे बोलत रहै बाकी अबाज नाय सुनी। <verse eid="ACT 22:9"/><verse number="10" style="v" sid="ACT 22:10"/>मैं पूँछो, ‘प्रभु, मैं का करौं?’ प्रभु मोसे कही, ‘उठ और दमिस्क मैं जा, और हूँना तोकै बौ सब कुछ बताए दौ जागो जो परमेस्वर तोए करन ताहीं ठहराई है।’ <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>जब मैं तेज चमक के बजह से अंधरा हुई गौ, तभई मेरे संग बारे मेरो हात पकड़कै दमिस्क मैं लै आईं।”<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>“बहे सहर मैं हनन्याह नाओं को एक भलो आदमी रहै, जो हमरे नियम को पालन करत रहै और हूँना के रहन बारे यहूदियन को भौत आदर करत रहै। <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>बौ मेरे झोने आयकै, मेरे झोने ठाड़गौ, और मोसे कही, ‘भईय्या साऊल, फिर से देख!’ बहे घड़ी मेरी आँखी खुली और मैं बाकै देखो। <verse eid="ACT 22:13"/><verse number="14" style="v" sid="ACT 22:14"/>तौ बौ कही, हमरे पुरखा को परमेस्वर तोकै जहेमारे चुनी है कि तैं बाकी मरजी कै जानैं, और बौ धर्मी कै देखै, और बाके मोहों की बात सुनै। <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>काहैकि तैं बाके घाँईं से सब आदमिन के अग्गु बे बातन को गभा होगो, जो तैं देखो और सुनो है। <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>और अब, का को आसरो करथै? उठ बपतिस्मा ले, और बाको नाओं लैकै अपने पापन कै धोय डार।”<verse eid="ACT 22:16"/></para>
  <para style="s">गैर यहूदिन के बीच प्रचार करन के ताहीं पौलुस को बुलावा</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>“मैं यरूसलेम मैं बापस गौ, और जब मैं मंदिर मैं प्रार्थना करत रहौं, तौ मोए एक दर्सन मिलो, <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>जोमैं मैं प्रभु कै देखो, जैसो कि बौ मोसे कही रहै, ‘जल्दिये यरूसलेम से निकर जा; काहैकि बे मेरे बारे मैं तेरी गभाई नाय मानंगे।’ <verse eid="ACT 22:18"/><verse number="19" style="v" sid="ACT 22:19"/>मैं कहो, ‘प्रभु, बे तौ अच्छी तरह से जानथैं कि मैं तेरे ऊपर बिस्वास करन बारेन कै कालकोठरी मैं डारत रहौं और जघा-जघा सभाघर मैं पिटवात रहौं। <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>और जब तेरो गभा स्तिफनुस को खून बहाओ गौ, तौ मैं खुद हूँनै रहौं, और बाकी हत्या की मंजूरी होत रहै तौ बाके हत्यारेन के लत्तन को ध्यान धरत रहौं।’ <verse eid="ACT 22:20"/><verse number="21" style="v" sid="ACT 22:21"/>तौ प्रभु मोसे कही, ‘जा,’ काहैकि मैं तोकै गैर यहूदि मैं दूर पनारंगो।”<verse eid="ACT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>लोग पौलुस की बात सुनी जबले जौ बात न सुनी; फिरौंकी बे तेज अबाज मैं चिल्लान लागे, “बासे दूर रहाबौ! जाए मार देबौ! जाकै धरती से मिटाए दियौ, जौ जिंदो रहन के लायक नाय है!” <verse eid="ACT 22:22"/><verse number="23" style="v" sid="ACT 22:23"/>बे चिल्लात रहैं, और अपने लत्ता लहरात रहैं और ब्यार मैं धूदर उड़ात रहैं। <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>तौ रोमी सेना को सरदार अपने आदमिन संग पौलुस कै किला मैं लै जान को आदेस दई, और जाकै कोड़ा मारकै उन्हैं परखौ, कि लोग का बजह से बाके खिलाप मैं चिल्लाए रहे हैं। <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>जब बे बाकै कोड़ा मारन के ताहीं भाँद दईं, तौ पौलुस हूँना ठाड़े अधिकारी से कही, “का तेरे ताहीं रोमी वासी कै कोड़ा मारनो सई है, और बौ भी बिना दोस को?”<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>तभई सेनापति पौलुस के झोने गौ और बासे पूँछी, “मोकै बता, का तैं रोमी वासी है?”<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>तभई सेना को सरदार बाके झोने आयकै कही, “मोकै बता, का तैं रोमी है?”</para>
  <para style="p" vid="ACT 22:27">“हाँ,” पौलुस जबाब दई।<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>जौ सुनकै सेनापति कही, “मैं रोमी होन को पद भौत रुपईया दैकै पाओ हौं।” पौलुस कही, “लेकिन मैं तौ जनम से रोमी हौं।”<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>तौ जो आदमी बाकी जाँच करन बारे रहैं, बे तुरंतै बाके झोने से हट गै; और सेनापति भी जौ जानकै कि पौलुस रोमी वासी है, और बौ बाकै साँकरन से भाँदी है, डराय गौ।<verse eid="ACT 22:29"/></para>
  <para style="s">पंचायत के अग्गु पौलुस</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>सेनापति जौ मालुम करनो चहात रहै कि यहूदि पौलुस के ऊपर का आरोप लगात रहैं; तभई दुसरे दिन पौलुस की साँकर खोल दई और मुख्य बड़े पुजारी और पूरे पंचन कै मिलन को आदेस दई। और फिर पौलुस कै लै जाएकै उनके सामने ठड़बाए दईं।<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>पौलुस सीधे बड़ी सभा के घाँईं देखी और कही, “मेरे संगी इस्राएलियौ! मैं आज तक परमेस्वर के ताहीं कतई सच्चे मन से और अच्छे से जिंदगी गुजारो हौं।” <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>हनन्याह बड़ो पुजारी बे लोगन कै आदेस दई, जो मोहों मैं हमला करन के ताहीं पौलुस के झोने ठाड़े रहैं। <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>तौ पौलुस बासे कही, “चूना पुति भइ दीवार, परमेस्वर पक्का तेरे ऊपर हमला करैगो! तैं नियम के हिसाब से मेरो फैसला करन ताहीं बैठो है, फिर काहे नियम के खिलाप मोकै मारन ताहीं कहरौ है!”<verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>पौलुस के करीबी लोग बासे कहीं, “तैं परमेस्वर के बड़े पुजारी को अपमान कर रौ है!”<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>पौलुस जबाब दई, “मेरे इस्राएल के संगी, मैं नाय जानत रहौं, कि बौ बड़ो पुजारी रहै। सास्त्र कहथै, ‘अपने लोगन के मुखिया की बुराई ना करनो चाहिए।’<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>तौ पौलुस जौ जानकै, कि एक गुट सदूकियन को और दुसरो फरीसियन को है, महासभा मैं चिल्लाए कै कही, संगी इस्राएलियौ! मैं फरीसी और फरीसियन के पीढ़ी को हौं, मरे भैन की आसा और दुबारा जी उठन के बारे मैं मेरो फैसला हुई रहौ है!”<verse eid="ACT 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7"/>जैसिये बौ जौ कही, तौ फरीसी और सदूकियन मैं लड़ाई होन लागी; और सभा मैं फूट पड़ गई। <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>सदूकी तौ जौ कहथैं, कि न कोई पुनरुत्थान होथै, और नाय स्वर्गदूत होथैं और नाय आत्मा होथै; लेकिन फरीसी इन सब मै बिस्वास करथैं। <verse eid="ACT 23:8"/><verse number="9" style="v" sid="ACT 23:9"/>तौ बड़ा हल्ला मचो और कुछ यहूदि नियम के सिक्छक जो फरीसिन के गुट के रहैं, उठकै जोरदार बिरोध करीं: “हम जौ आदमी मैं कछु बुरो ना पाये! सायद एक आत्मा या स्वर्गदूत सच मैं बासे बोली है!”<verse eid="ACT 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10"/>जब भौत लड़ाई भइ, तौ सेना को सरदार जौ डर से कि बे पौलुस के टुकड़ा-टुकड़ा न कर डारैं, सेना के दल कै आदेस दई कि उतरकै बाकै उनके बीच मैं से जबरजत्ती निकारौ, और किला मैं लैजाओ।<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>बहे रात प्रभु पौलुस कै ठड़बाए कै कही, “हिम्मत भाँद! काहैकि जैसी तैं यरूसलेम मैं गभाई दौ, बैसिये तोकै रोम मैं भी गभाई देने होगो।”<verse eid="ACT 23:11"/></para>
  <para style="s">पौलुस की जिंदगी के खिलाप पिलातुस</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>अगले सुबेरे कुछ यहूदि मिलकै योजना बनाईं। और कसम खाईं कि जबले हम पौलुस कै खतम न कर डारैं, तौले खामैं या पीमंगे नाय। <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>जो जौ योजना बनाईं रहैं, बे चालीस आदमी से जद्धा रहैं। <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>बे बड़ो पुजारी और बड़े-बूढ़ेन के झोने आयकै कहीं, “हम एक पवित्र कसम खाए हैं कि हम पौलुस कै खतम न कर डारैं, तौले कछु भी ना खामैं, ना पीमैं। <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>तभईये अब सभा समेत सेना के सरदार कै समझाबौ, कि बाकै तुमरे झोने लै आबै, समझ लियो कि तुम बाके बारे मैं और भी सई से जाँच करनो चाहथौ। और हम बाके पुगन से अग्गु बाकै मार डारन के ताहीं तैयार रहंगे।”<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>तौ पौलुस की बहेनिया को लौड़ा सुनी कि बे बाकी घात मैं हैं; तौ किला मैं जाएकै पौलुस कै खबर दई। <verse eid="ACT 23:16"/><verse number="17" style="v" sid="ACT 23:17"/>पौलुस कप्तानन कै अपने झोने बुलाएकै कही, “जौ ज्वान आदमी कै सेना के सरदार के झोने लै जाबौ, जौ बासे कछु कहनो चाहथै।” <verse eid="ACT 23:17"/><verse number="18" style="v" sid="ACT 23:18"/>तभई अधिकारी बाकै सेना के सरदार के झोने लै जाएकै कही, “कैदी पौलुस मोकै बुलाएकै नहोरे करी, कि जौ ज्वान आदमी सेना के सरदार से कछु कहनो चाहथै; जाकै बाके झोने लै जा।”<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>सेना को सरदार बाको हाथ पकड़कै, और बाकै अलग लै जाएकै पूँछी, “तू मोसे का कहनो चाहथै?”<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>बौ कही, यहूदि अधिकारी तोसे जौ नहोरे करन के ताहीं एक मत ही गै हैं कि तू कल पौलुस कै बड़ी सभा के अग्गु लाबै, कि मानौ बे बाकी और भी जाधा जानकारी लेनो चाहथैं। <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>लेकिन तू उनकी मत सुनिये, काहैकि उनमैं से चालीस से जाधा आदमी बाकी घात मैं हैं, बे जौ ठान लईं हैं कि जबले बे पौलुस कै खतम ना कर लेमैं, तब तक ना खांगे ना पींगे, और अब बे तैयार हैं और तेरे कहेन कै असियाय रहै हैं।<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>तौ सेना को सरदार ज्वान आदमी कै जौ संकेत दैकै बिदाई करी, “कोईये से मत कहिये कि तैं मोकै जे बात बताओ है।”<verse eid="ACT 23:22"/></para>
  <para style="s">पौलुस कै कैसरिया के झोने पनारो गौ है</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>तभई सेनापति अपने दुई सरदारन कै बुलाएकै कही, “दुई सौ सिपईय्या, सत्तर घुड़सवार कै और दुई सौ सैनिक कैसरिया जान ताहीं तैयार रख, तैं आज रात नौ बजे ले निकर जान के ताहीं समरो रहिये। <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>और पौलुस की सवारी के ताहीं घोड़ा तैयार रखौ और बाकै फेलिक्स राज्यपाल के झोने सबसे बचाए कै सई सलामत पुगाए दियौ।” <verse eid="ACT 23:24"/><verse number="25" style="v" sid="ACT 23:25"/>तौ सेनापति एक चिट्ठी लिखी जो ऐसे करकै रहै:<verse eid="ACT 23:25"/></para>
  <para style="pi">
    <verse number="26" style="v" sid="ACT 23:26"/>“महाप्रतापी, फेलिक्स लिसियास: राज्यपाल कै क्लौदियुस को नमस्ते। <verse eid="ACT 23:26"/><verse number="27" style="v" sid="ACT 23:27"/>जौ आदमी कै यहूदि लोग पकड़कै मार डारनों चाँहीं, मोकै पता चलो कि बौ रोमी नागरिक है, तौ सिपईय्यन कै लै जाएकै छुड़बाए लाओ। <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>और मैं जाननो चहात रहौं, कि बे बाके ऊपर कौनसी बजह से दोस लगाथैं, तभईये बाकै उनकी बड़ी सभा मैं लैगौ। <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>तभई मैं जान लौ, कि बे खुदै अपने नियम के झमेला मैं बाके ऊपर दोस लगाथैं, लेकिन बाकै मार डारन हानी या भाँदे जाने जैसो कोईये दोस नाय है। <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>और जब मोकै बताओ गौ, कि बे जौ आदमी की घात मैं लगे हैं, तौ मैं तुरंतै बाकै तेरे झोने पनारन को फैसला करो। और दोस लगान बारेन कै भी हुकम दौ, कि, तेरे अग्गु बाके ऊपर दोस लगामैं।”<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>तभई जैसे सिपईय्यन कै हुकम दौ गौ। बैसिये पौलुस कै लैकै रातौ-रात अंतिपतरिस मैं लाईं। <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>दुसरे दिन सैनिक घुड़सवारन कै बाके संग जान के ताहीं छोड़कै बे किला मैं लौट आए। <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>बे कैसरिया मैं पुगकै राज्यपाल कै चिट्ठी दईं, और पौलुस कै बाके हवाले कर दईं। <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>गवर्नर चिट्ठी पढ़कै पौलुस से पूँछी, तैं कौन परदेस को है। जब बे जान लई कि किलिकिया को है, <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>बौ कही, “जब तेरे इल्जाम लगान बारे आंगे, तभई मैं तेरो फैसला करंगो।” तौ बौ पौलुस कै हेरोद गवर्नर के महल मैं रखबारी करन को हुकम दई।<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s">फेलिक्स के सामने पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>पाँच दिन बाद हनन्याह बड़ो पुजारी कुछ बड़े-बूढ़े और तिरतुल्लुस नाओं के एक वकील के संग कैसरिया गै। बे राज्यपाल के अग्गु पौलुस के ऊपर इल्जाम लगाईं।<verse eid="ACT 24:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 24:2"/>तौ पौलुस बुलाओ गौ, और तिरतुल्लुस बाके ऊपर इल्जाम लगाएकै कहेन लगो, जो ऐसे करकै है: “महामहिम! तेरे बुद्धिमान नेतृत्व हमैं सांति लंबे समय दई है, और हमरी जाति की भलाई के ताहीं कई जरूरी सुधार करे जाए रै हैं। <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>हम हर जघा और हर समय फेलिक्स स्वागत करथैं, और हम तेरे प्रति भौत आभारी हैं। <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>अब मैं तेरो और जाधा समय खराब नाय करकै, तोसे दयालु होन और हमरे दुई बोल सुनन के ताहीं नहोरे करथौं। <verse eid="ACT 24:4"/><verse number="5" style="v" sid="ACT 24:5"/>हम जौ आदमी कै खतरनाक उधम्मी पाए; जौ दुनिया भर मैं यहूदिन के बीच दंगा की सुरुवात करथै और नासरियन के झुंड को नेता है। <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>जौ मंदिर कै अपवित्र करन की भी कोसिस करी, और हम जाकै गिरफ्तार कर लै। <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/>लेकिन सेना को सरदार लूसियास आयकै बाकै जबरजत्ती हमरे हात से छीन लई। <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>अगर तैं जौ आदमी के ऊपर सवाल उठाथै, जे सब बातन कै जिनके बारे मैं हम जाके ऊपर इल्जाम लगाथैं, तैं खुदै बाके बारे मैं पता करकै जान लेगो।” <verse eid="ACT 24:8"/><verse number="9" style="v" sid="ACT 24:9"/>यहूदि भी आरोप मैं सामिल हुईगै और कहीं कि जौ सब सच रहै।<verse eid="ACT 24:9"/></para>
  <para style="s">फेलिक्स से पहले पौलुस कि रक्छा</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>राज्यपाल पौलुस कै बोलन को मौका दई, और पौलुस कही, “मोकै पता है कि तैं भौत सालन से जौ जाति को न्यायधीस रहो है, और जौ बजह से मैं तेरे सामने अपनो बचाव करन के ताहीं खुस हौं। <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>तैं खुदै जान सकथै, कि जब से मैं यरूसलेम मैं आराधना करन आओ हौं, मोकै बारह दिन से जद्धा नाय भै हैं। <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>यहूदि मोकै ना तौ मंदिर मैं ना सभाघरन मैं और ना तौ सहर मैं बहस करत भइ पाईं, और ना ही भीड़ लगात भै पाईं। <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>ना बे तोकै बे आरोपन को सबूत दे सकथैं जो बे मेरे खिलाप कहथैं। <verse eid="ACT 24:13"/><verse number="14" style="v" sid="ACT 24:14"/>जौ मैं तेरे अग्गु मानथौं: मैं अपने पुर्खन के परमेस्वर की आराधना बौ तरीका से करथौं जो बे कहथैं कि जौ गलत है। लेकिन मैं मूसा के नियम और भविस्यवक्तन की किताबन मैं लिखी हर बातन के ऊपर बिस्वास करथौं। <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>परमेस्वर से मेरी जहे आसा है कि जे खुदै, मतलब, गैरविस्वासी, धर्मी और अधर्मी दोनों, मौत से जी उठंगे। <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>और जौ बजह से मैं हमेसा परमेस्वर और लोगन के सामने साफ मन रखन की पूरी कोसिस करथौं।”<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>“निरे सालन तक यरूसलेम से दूर रहन के बाद, मैं अपने लोगन के ताहीं दान पुगान और भेंट चढ़ान आओ रहौं। <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>जब मैं ऐसो करत रहौं, तौ बे मोकै मंदिर मैं, सुद्ध करन बारी रसम पूरी होन के बाद देखीं। मेरे संग कोई भीड़ ना रहै और ना कैसियो गड़बड़ी रहै। <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>लेकिन आसिया के देस के कुछ यहूदि हुँआँ रहैं; अगर बे मेरे खिलाप कुछ भी करथैं, तौ बे खुद तेरे सामने आयकै मेरे ऊपर आरोप लगाथैं। <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>या जे खुदै कहमैं, कि जब मैं महासभा के अग्गु ठाड़ो रहों, तौ बे मेरे मैं कौन सो अपराध को दोसी पाईं रहैं। <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>एक बात कै छोड़कै जोमैं उनके बीच मैं ठाड़कै चिल्लाए कै कहो रहों: जौ पुनरुत्थान के बारे मैं आज मेरो तुमरे अग्गु फैसला ही रहो है।”<verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>तौ फेलिक्स, जोकै रहा के बारे मैं अच्छी जानकारी रहै, बौ सुनवाई रोक कै कही, “जब सेनापति लिसियास आए जागो, तौ मैं तुमरे मुकदमा को फैसला सुनांगो।” <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>और प्रभारी अधिकारी से कही, कि पौलुस कै पूरी छूट दैकै रखबारी करन कै कहिये, और बाके संग बारेन मैं से कोई कै भी बाकी सेबा करन से मत रोकिये।<verse eid="ACT 24:23"/></para>
  <para style="s">पौलुस की फेलिक्स और बाकी बईय्यर द्रुसिल्ला से बातचीत</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>थोड़ी दिनन के बाद फेलिक्स अपनी बईय्यर द्रुसिल्ला कै, जो यहूदि रहै, संग लैकै आओ और पौलुस कै बुलबाए कै बौ ईसु मसीह के बिस्वास के बारे मैं बासे सुनी। <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>लेकिन जैसे-जैसे पौलुस धार्मिकता, संयम और आनबारे न्याय की बात करन लागो, तौ फेलिक्स डराय गौ और कही, “हबै तैं जा। मौका मिलैगो तौ मैं तोकै फिर बुलांगो।” <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>बहे समय बौ उमीद करत रहै कि पौलुस बाकै थोड़ी भौत पैसा देगो; और जौ बजह से बौ जद्धेतर बुलाए-बुलाएकै बासे बात करत रहै।<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>दुई साल बीत जान के बाद, पुरकियुस फेस्तुस, फेलिक्स की जघा मैं राज्यपाल बनकै आओ। फेलिक्स यहूदियन ऊपर दया देन के इरादा से पौलुस कै कैदखाना मैं छोड़ गौ।<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s">पौलुस सम्राट से अपील करी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>फेस्तुस बौ देस मैं पुगकै तीन दिन के बाद कैसरिया से यरूसलेम कै गौ, <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>जहाँ बड़ो पुजारी और यहूदि नेता पौलुस के खिलाप अपने आरोप लगाईं। बे फेस्तुस से नहोरे करीं <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>कि पौलुस के यरूसलेम मैं आन को दया उनके ऊपर करो जाबै, काहैकि बे रास्तै मैं बाकै खतम करन ताहीं घात लगाए भै रहैं। <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>फेस्तुस जबाब दई, “पौलुस कैसरिया मैं कैदी है, और मैं खुद जल्दी हूँना जांगो। <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>अपने नेतन कै मेरे संग कैसरिया भेजौ और बौ आदमी के ऊपर इल्जाम लगाबौ।”<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>फेस्तुस उनके झोने लमसम आठ-दस दिन रहकै कैसरिया गौ। और दुसरे दिन न्याय करन बारी जघा मैं बैठगौ और पौलुस कै लान को आदेस दई। <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>जब पौलुस आओ, तौ जो यहूदि यरूसलेम से रहैं, बे आस-पास ठाड़कै बाके ऊपर निरे इल्जाम लगामैं, जिनकै बे साबित ना कर पात रहैं। <verse eid="ACT 25:7"/><verse number="8" style="v" sid="ACT 25:8"/>लेकिन पौलुस खुद को बचाव करी: “मैं यहूदिन के नियम या मंदिर या रोमन सम्राट के खिलाप कछु गलत ना करो हौं।”<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>लेकिन फेस्तुस यहूदिन ऊपर दया करनो चहात रहै तौ पौलुस से पूँछी, “का तैं चाहथै कि मैं जे दोस लगान बारेन को फैसला यरूसलेम मैं करौं?”<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>पौलुस कही, “मैं सम्राट कैसर के न्याय करन बारी जघा के अग्गु ठाड़ो हौं, मेरे मुकदमा को फैसला हीनैं होनो चहाईये। जैसे तैं अच्छी तरहन से जानथै, यहूदिन को मैं कछु अन्याय नाय करो। <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>अगर मैं कानून तोड़ो हौं और कछु करो हौं, तौ जाके ताहीं मैं मौत की सजा के लायक हौं, और मैं जासे बचन के ताहीं ना कहथौं। लेकिन जो बातन को जे मेरे ऊपर इल्जाम लगाथैं, अगर उनमैं से कोईये की बात एक सी नाय बैठी, तौ कोई मोकै उनके हात मैं नाय सौंप सकथै। मैं सम्राट कैसर से अपील करथौं।”<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>तौ फेस्तुस अपने सलाहकारन के संग बैठक करन के बाद जबाब दई, “तैं सम्राट कैसर से अपील करो है, जौ बजह से तैं सम्राट कैसर के झोने जागो।”<verse eid="ACT 25:12"/></para>
  <para style="s">अग्रिप्पा और बिरनीके से पहले पौलुस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>कुछ समय बाद राजा अग्रिप्पा और बिरनीके कैसरिया मैं आयकै फेस्तुस से भेंटा करीं। <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>उनके निरे दिन हुँआँ रहन के बाद, फेस्तुस पौलुस के बारे मैं राजा कै समझाई: “हिंयाँ एक आदमी है, जोकै फेलिक्स कैदी छोड़ दई रहै; <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>और जब मैं यरूसलेम मैं रहौं, तौ बड़ो पुजारी और यहूदि और बड़े-बूढ़े बाके खिलाप आरोप लगाईं और मोकै बाकी बुराई करन के ताहीं कहीं। <verse eid="ACT 25:15"/><verse number="16" style="v" sid="ACT 25:16"/>लेकिन मैं उनसे कहो कि जौ रोमियन को रिवाज नाय है, कि कोई भी आदमी कै सजा देन के ताहीं सौंप देबै, जब तक मुजरिम कै इल्जाम लगान बारेन के अग्गु ठड़बाए कै खुद के बचाव मैं जबाब देन को मौका ना मिलै। <verse eid="ACT 25:16"/><verse number="17" style="v" sid="ACT 25:17"/>जब बे हिंयाँ आए, तौ, मैं कुछ देरा दारी नाय करो, बल्किन दुसरे दिन न्याय करन बारी जघा मैं बैठकै बौ आदमी कै लान ताहीं कहो। <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>जब बाके बिरोधी खड़े भै, तौ बे बाके ऊपर कोई भी बुरो अपराध को इल्जाम ना लगाईं, जैसो मोकै लगत रहै कि बे कहंगे। <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>लेकिन बे खुद के तर्क, और ईसु नाओं के कोई इंसान के बारे मैं जो मर चुको रहै; और पौलुस बाकै जिंदो होन को दाबा करत रहै, बहस करत रहैं। <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>मैं ऐसी उलझन मैं रहौं, कि जे बातन को पता कैसे लगामौं? जौ बजह से मैं पौलुस से पूँछो का तैं यरूसलेम जान ताहीं तैयार होगो जहाँ हुँआँ जे बातन को फैसला करो जागो। <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>लेकिन पौलुस अपील करी; कि मेरो मुकदमा को फैसला सम्राट के हिंयाँ होबै। जौ बजह से बाकै सम्राट कैसर के झोने भेजन को आदेस दौ, जब तक मैं बाकै सम्राट के झोने ना भेज दियौं तब तक बाकी रखबारी करी जाबै।”<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>अग्रिप्पा फेस्तुस से कही, “महुँ बौ इंसान की सुननो चाहथौं। फेस्तुस जबाब दई, तैं कल सुन लेगो।”<verse eid="ACT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>दुसरे दिन अग्रिप्पा और बिरनीके भौत धूमधाम से आयकै सेना के सरदारन और सहर के खास आदमिन के संग दरबार मैं अंदर आओ। फेस्तुस आदेस दई, कि पौलुस कै अंदर लामैं। <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>फेस्तुस कही, “राजा अग्रिप्पा, और सब आदमी जो हिंयाँ हमरे संग हौ: तुम जौ आदमी कै देखथौ, जोके खिलाप पूरे यहूदि लोग, यरूसलेम मैं और हींनौं चिल्लाए-चिल्लाए कै मेरे झोने सिकायत लाई हैं। कि जाको जिंदो रहनो ठीक नाय है। <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>लेकिन मैं जान लौ कि बौ ऐसो कुछ नाय करी कि बाकै मार डारो जाबै। और जब कि बौ खुदै सम्राट से एक अपील करी, तौ मैं बाकै पनारन को फैसला करो। <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>लेकिन मैं बाके बारे मैं कोईये ऐसी बात नाय पाओ कि सम्राट कै लिखौं। जौ बजह से मैं बाकै तुमरे सामने और खासकर कै राजा अग्रिप्पा तेरे अग्गु लाओ हौं! जाके अलावा, बाके मामले कि जाँच-पड़ताल के बाद, मेरे पास कछु लिखन ताहीं हुई सकथै। <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>जाके ताहीं मोकै साफ तरीका से बाके खिलाप आरोपन कै संकेत दै बिना एक कैदी कै भेजनो सई ना लगथै।”<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="s">पौलुस अग्रिप्पा से पहले खुद को बचाओ करथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>अग्रिप्पा पौलुस से कही, “तोकै खुद के बचाओ मैं बोलन की अनुमति है।” तौ पौलुस अपनो हाथ बढ़ाई और अपनो बचाव ऐसे करकै करी:<verse eid="ACT 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2"/>“राजा अग्रिप्पा! जित्ती बातन को यहूदि मेरे ऊपर इल्जाम लगाथैं, आज तेरे अग्गु उनकै जबाब देन मैं खुदकै भाग्यसाली मानथौं, <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>खासकर जब से तैं सबै यहूदि रीति-रिवाज और बहेस कै अच्छी तरह से जानथै। मैं तोसे धीरज के संग मेरी बात सुनन के ताहीं कहथौं।”<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>“सब यहूदि जानथैं कि जब मैं छोटो रहौं तौ मैं कैसो रहत रहौं। बे जानथैं कि मैं अपनी पूरी जिंदगी कैसे बिताओ, पहले अपने देस मैं और फिर यरूसलेम मैं। <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>बे हमेसा से मोकै पहचानथैं अगर बे गभाई देनो चाहथैं, कि मैं पहले से हमरे धर्म, फरीसियन के सबसे सक्त समूह को सदस्य रह चुको हौं। <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>और अब बौ वादा की आसा के बजह से जो परमेस्वर हमरे बड़े-बूढ़ेन से करी रहैं की आज मेरो फैसला ही रौ है। <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>बहे वादा के पूरे होन की आसा करत भै, हमरे बारह जनजाति अपने पूरे मन से रात-दिन परमेस्वर की आराधना करथैं। हे राजा, जहे की बजे से यहूदि मेरे ऊपर दोस लगाए रै हैं! <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>तुम हिंयाँ काहे हौ, जौ बिस्वास करनो नामुमकिन है कि न्याई परमेस्वर मरे भै कै जिंदो करथै?”<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>“महुँ सोचो रहों कि ईसु नासरी के नाओं के खिलाप मोकै भौत कुछ करनो चाहिए। <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>जहे मैं यरूसलेम मैं करो। मैं बड़ो पुजारी से अधिकार लैकै परमेस्वर के निरे पवित्र आदमिन कै कैदखाना मैं डार दौ; और जब उन्हैं मौत की सजा सुनाई गई, तौ महुँ उनके खिलाप बोट डारो। <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>तमान बार मैं उन्हैं सभाघर मैं सजा देत रहौं और मैं उनकै प्रभु की बुराई करन के ताहीं मजबूर करन की कोसिस करत रहौं। मैं उनसे इतनो भड़को भौ रहौं की मैं बाहर के सहरन मैं भी जाएकै उन्हैं सतात रहों।”<verse eid="ACT 26:11"/></para>
  <para style="s">पौलुस अपने आपकै बदलन के बारे मैं बताई</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितो 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>“जौ सब जौ उद्देस्य के ताहीं रहै कि मैं बड़े पुजारिन से अधिकार और आदेस लैकै दमिस्क गौ। <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>तौ राजा, रस्ता मैं दुपारी के समय आसमान से सूरज की तुलना से उजियारो, अपने और अपने संग बारेन के चारौ तरफ चमकत भै देखो। <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>और जब हम सब जमीन मैं गिर पड़े, तौ मैं इब्रानी भासा मैं, मोसे कहत भै जौ अबाज सुनो, ‘साऊल, साऊल, तैं मोकै काहे सताथै? पैंना मैं लात मारनो तेरे ताहीं मुस्किल है।’ <verse eid="ACT 26:14"/><verse number="15" style="v" sid="ACT 26:15"/>मैं कहो, ‘प्रभु, तैं कौन है?’ प्रभु कही, ‘मैं ईसु हौं, जोकै तैं सताथै। <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/>लेकिन तैं उठ, अपनी टाँग के बल ठाड़ जा; काहैकि मैं तोकै जहे ताहीं दर्सन दौ हौं कि तोकै बे बातन को भी सेवक और गभा ठहरामौ, जो तैं देखो है, और उनको भी जोमैं तोकै दर्सन दिखांगो। <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/>मैं तोकै इस्राएलियन और गैर यहूदियन के हात से छुड़ांगो जिनके झोने मैं तोकै पनारंगो। <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/>कि तैं उनकी आँखी खोलै, कि बे अंधियारे से उजियारे के घाँईं, और सैतान के अधिकार से परमेस्वर के घाँईं लौटैं; कि पापन की माफी, और बे लोगन के संग जो मेरे ऊपर बिस्वास करन से पवित्र करे गै हैं, बिस्वास पामैं।’ <verse eid="ACT 26:18"/><verse number="19" style="v" sid="ACT 26:19"/>तभईये राजा अग्रिप्पा, मैं बौ स्वर्गिय दर्सन की बात नाय टालो, <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>लेकिन पहले दमिस्क के, फिर यरूसलेम के रहन बारेन कै, फिर यहूदिया के पूरे देस मैं और गैर यहूदियन कै समझात रहो, कि मन फिराबौ और परमेस्वर के घाँईं लौटकै मन फिरन के जैसे काम करौ। <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>जेईं बातन के बजह से यहूदि मोकै मंदिर मैं पकड़कै मार डारन की कोसिस करत रहैं। <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>लेकिन परमेस्वर की मदद से हबै ले बनो हौं और छोटे-बड़े सबन के अग्गु गभाई देथौं, और बे बातन के अलावा कुछ ना कहथौं, जो भविस्यवक्ता और मूसा भी कही, कि होन बारी हैं, <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>कि मसीह कै दुख उठाने होगो, और बहे सबसे अग्गु मरे भैन मैं से जी उठकै हमरे लोगन मैं और गैर यहूदियन मैं जोती को प्रचार करैगो।”<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>जब बौ जौ तरह से जबाब देत रहै, तौ फेस्तुस तेज अबाज से कही, “पौलुस तैं पागल है। भौत विद्या तोकै पागल कर दई है।”<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>लेकिन पौलुस कही, महाप्रतापी फेस्तुस, “मैं पागल नाय हौं, लेकिन सच्ची और सिक्छा की बात करथौं।”<verse eid="ACT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 26:26"/>“राजा भी जोके अग्गु मैं बिना डरे बोल रौ हौं, जे बात जानथै, और मोकै बिस्वास है, कि जे बातन मैं से कोई बासे लुकी नाय है, काहैकि बौ बात कोई कोहने मैं नाय भइ है।<verse eid="ACT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 26:27"/>राजा अग्रिप्पा, का तैं भविस्यवक्तन मैं बिस्वास करथै? हाँ, मैं जानथौं, कि तैं बिस्वास करथै।” <verse eid="ACT 26:27"/><verse number="28" style="v" sid="ACT 26:28"/>अब अग्रिप्पा पौलुस से कही, “का तैं जरा सो समझाए कै मोकै मसीह बनानो चाहथै?”<verse eid="ACT 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29"/>पौलुस कही, “परमेस्वर से मेरी प्रार्थना जौ है कि जरा से मैं, का भौत मैं, सिरफ तहीं नाय, लेकिन जितने लोग आज मेरी सुनथैं, मेरे जे बेड़ियन कै छोड़कै बे मेरे जैसी हुई जामैं।”<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>तौ राजा और राज्यपाल और बिरनीके और उनके संग बैठन बारे ठाड़गै; <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>और अलग जाएकै आपसै मैं कहेन लागे, “जौ आदमी ऐसो तौ कछु ना करथै, जो मौत की सजा या कैदखाना के बंधन मैं डारो जाबै।” <verse eid="ACT 26:31"/><verse number="32" style="v" sid="ACT 26:32"/>अग्रिप्पा फेस्तुस से कही, “अगर जौ आदमी कैसर की अपील न देतो, तौ छुट सकत रहै।”<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s">पौलुस कै रोम मैं पनारो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>जब जौ उनको पक्को फैसला ही गौ कि हम इटली जामैं, तौ बे पौलुस और थोड़ी और कैदियन कै भी यूलियुस नाओं के औगुस्तुस की सेना के एक कप्तान कै सौंप दई, जो रोमन सेना-दल को एक अधिकारी रहै, जिनकै “सम्राट को सेना-दल कहो जाथै।” <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>हम आसिया परदेस के बन्दरगाहन कै जान बारे अद्रमुत्तियुम नगर के एक जहाज मैं सवार हुईकै रवाना हुईगै। मकिदुनिया देस के थिस्सलुनीके नगर को रहन बारो अरिस्तर्खुस नाओं को एक विस्वासी भी हमरे संग रहै। <verse eid="ACT 27:2"/><verse number="3" style="v" sid="ACT 27:3"/>दुसरे दिन हम सैदा पुगे। यूलियुस पौलुस के ऊपर दया करकै बाकै अपने दोस्तन के झोने जान को हुकम दई, जोकी उनकै जरूरत रहै। <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>हूँना से हम साइप्रस द्वीप की आड़ मैं हुईकै अग्गु बढ़े काहैकि ब्यार हमरे खिलाप रहे। <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>और किलिकिया और पंफूलिया के समुंदर पार करकै लूसिया मैं मायरा आए। <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>हूँना कप्तान कै सिकन्दरिया को एक जहाज मिलो जो इटली के ताहीं जान बारो रहै, तभईये बौ हमैं बहे मैं चढ़ाय दई।<verse eid="ACT 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7"/>हम भौत दिन तक धीरे-धीरे नेंग कै मुस्किल से कनिदुस सहर पुगे। तौ जहेमारे कि ब्यार हमैं अग्गु न बढ़न देत रहे, हम सलमोने के अग्गु से हुईकै क्रेते द्वीप की आड़ मैं नीचे मोहोंकै निंगे। <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>और बाके टिकारे-टिकारे मुस्किल से नेंगत भै सुभलंगरबारी नाओं की एक जघा मैं पुगे, जितै से लसया नगर झोने रहे।<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>हम हूँना भौत समय गुजारे, जबले कि सफर जारी रखनो खतरनाक ना हुई गौ, काहैकि अबले बर्त को दिन पहलेई बीत चुको रहै। तभई पौलुस उनकै जौ सलाह दई: <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>“भईय्यौ, मोकै ऐसो लग रहो है कि जौ सफर मैं परेसानी और भौत नुकसान, खाली समान और जहाज को नाय बल्कि आपन की ज्यान को भी है।” <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>लेकिन कप्तान और जहाज के मालिक की बातन कै पौलुस की बातन से जद्धा मानी। <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>बन्दरगाह जाड़ो काटन ताहीं अच्छो ना रहे; जहेमारे लमसम सबै लोग समुंदर से बहार निकरन और फीनिक्स मैं पुगन की कोसिस करत रहैं, अगर हुई सकै, तौ सर्दियन कै बीतन के ताहीं। फीनिक्स क्रेते को एक बन्दरगाह है जो तरिहाँए-पछार और सीरे-पछार को सामना करथै।<verse eid="ACT 27:12"/></para>
  <para style="s">समुंदर मैं आँधी</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>जब तरिहाँए की ब्यार धीरे-धीरे चलन लागी, तौ आदमी सोचीं कि उनकै अपनी योजना कै पुरो कर सकथैं, तभईये लंगर उठाईं और टिकारे-टिकारे क्रेते के झोने से होत भै जान लगे। <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>लेकिन जल्दिये एक भौत तेज ब्यार उठी, जोकै “यूरकुलीन” कहथैं, द्वीप से नीचे गिरन लगी। <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>जब आँधी जहाज से टकराई, तौ जहाज ब्यार के अग्गु रुक न पाओ, तौ हम जहाज कै ब्यार के संग पुहिन दै, और कोसिस करनो छोड़ दै। <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>तौ कौदा नाओं के एक छोटे से टापू की आड़ मैं हमैं कुछ आसरो मिलो। हूँना, कुछ मुस्किल के संग हम जहाज की छोटी नईंयाँ कै सई सलामत बनान मैं कामयाब रहे। <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>फिर जहाज चलान बारे डोंगी कै उठाईं और जहाज कै रस्सन से तरे से ऊपर तक कसकै भाँदी और सुरतिस टापू के उथले जघा मैं फसन के डर से पाल और समान कै उतारकै ब्यार से पुहात भै चले गै। <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>भयानक आँधी चलतै रइ, तभई दुसरे दिन बे कुछ समान जो जाधे रहै फेंकन लागे, <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>और तीसरे दिन कै बे जहाज को समान भी फेंक दईं। <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>और जब भौत दिनन तक नाय सूरज नाय तारा दिखाई दै, और भौत आँधी चलत रहे। तौ आखरी मैं हमरे बचन की सब आसा जान लगी। <figure style="fig" alt="Ship being wrecked in a storm" file="lb00219c.tif" size="col" copy="Horace Knowles ©" ref="27:18">आँधी मैं जहाज टूट गौ</figure><verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>जब बे भौत दिन तक भूंके रह डारीं, तौ पौलुस उनके बीच मैं ठाड़कै कही, “लोगौ, ठीक तौ जौ रहे की तुम मेरी बात मानकै, क्रेते से जौ जहाज नाय खोलते; नाय जौ परेसानी आती और नाय जौ नुकसान उठाने पड़तो। <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>लेकिन अब मैं तुमकै समझाथौं कि हिम्मत भाँदौ! काहैकि तुम मैं से कोई की ज्यान कै नुकसान न होगो; बस खाली जहाज कै। <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>काहैकि जो परमेस्वर को मैं हौं और जोकी सेवा करथौं बाको स्वर्गदूत आज रात मेरे झोने आयकै <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>और कही पौलुस, मत डराय! तोकै कैसर के अग्गु ठाड़ने जरूर है। और देख, परमेस्वर सबन कै जो तेरे संग सफर कर रहे हैं, तोकै सौंपी है। <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>तभईये, भईय्यौ! हिम्मत भाँदौ; काहैकि मैं परमेस्वर मैं बिस्वास रखथौं, कि जैसो मोसे कही है, बैसिये होगो। <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>लेकिन हमैं कोई टीला मैं आसरो मिलैगो।”<verse eid="ACT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>जब चौदहमीं रात भइ, और हम अद्रिया समुंदर मैं भटकत रहैं, तौ आधी रात के करीब मल्लाह अन्दाजे से जानी की हम कोई देस के झोने पुग रहे हैं। <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>जब थाह लईं तौ पानी एक सौ बीस फिट गहरो पाईं; और थोड़ी अग्गु बढ़कै फिर थाह लईं, तौ नब्बै फिट गहरो पाईं। <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>तौ पथरा बारी जघा मैं टकरान की डर से बे जहाज के पच्छू चार लंगर डारीं, और भोर होन के ताहीं प्रार्थना करत रहै। <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>तौ मल्लाह नईंयाँ से भाजन की कोसिस करत रहैं; और अग्गु बारे हिस्सा से लंगर डारन के बहाना से ढोंगा कै समुंदर मैं उतार दईं। <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>लेकिन पौलुस कप्तान और सिपईय्यन से कही, “अगर जे आदमी जहाज मैं न रहैं, तौ तुम भी न बच सकथौ।” <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>तौ सिपईय्या रस्सी कै काटकै छोटी नईंयाँ कै जान दईं।<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>जब भोर होन बारो रहे, तौ पौलुस जौ कहकै सबन कै खानु खान ताहीं नहोरे करी: “आज के चौदह दिन हुईगै हैं कि तुम आसरो देखत-देखत भूंके रहे, और कछु न खाए। <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>जहे ताहीं मैं तुमसे नहोरे करथौं कि कछु खाए लियौ, जोसे तुमरी ज्यान बच जाए; काहैकि तुमरे मूड़ से एक बार भी न गिरैगो।” <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>और जौ कहकै बौ रोटी लैकै सबन के अग्गु परमेस्वर को धन्यवाद करी और खान लागो। <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>जासे सबन कै हिम्मत मिली और बे भी खानु खाईं। <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>हम सब मिलाय कै जहाज के भीतर दुई सौ छियत्तर जनी बैठे रहैं। <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>जब बे खानु खाएकै तृप्त भै, तौ गेंहूँ कै समुंदर मैं फेंक कै जहाज कै हलको करन लगे।<verse eid="ACT 27:38"/></para>
  <para style="s">जहाज को डूबनो</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>जब दिन निकरो, तौ बे बौ देस कै नाय पहचानी, लेकिन एक खाड़ी देखीं जोको बरोबर किनारो रहे, और सोची कि अगर हुई सकै तौ हीनैं पर जहाज टिकेमैं। <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>तौ बे लंगरन कै खोलकै समुंदर मैं डार दईं और बहे समय पतवारन कै पकड़नबारी रस्सी खोल दईं और ब्यार के अग्गु बारो पाल चढ़ायकै डींड़े घाँईं निगैं। <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>लेकिन दुई समुंदर के मिलन की जघा पड़कै बे जहाज कै टिकाईं, और लंगर तौ झटका खाएकै अंद गौ, और हाल ना सको; लेकिन पच्छू जहाज लहरन की बजह से टूटन लगो।<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>तौ सिपईय्या जौ सोची की कैदियन कै मार डारैं; ऐसो न होबै कि कोई पैर कै भाज जाबै। <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>लेकिन कप्तान पौलुस कै बचान के बिचार से रोकी, और जौ कही, कि जो पैर लेथैं, पहले कूदकै डींड़े कै निकर जामैं; <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>और बचे भै कोई पटरन मैं, और कोई जहाज की और दुसरी चीजन के मदद से निकर डींड़े कै निकर जामैं, और जौ तरीका से सब कोई बच निकरे।<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s">माल्टा टापू</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>जब हम सई सलामत बच निकरे, तौ पता चलो कि जौ टापू कै माल्टा कहथैं। <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>और हुँआँ के परदेसी हमसे अच्छे ढंग से पेस आए। मेंहें बरसन लगो और ठंड रहै, तभई बे आगी पजार कै हम सबन को आदर करीं। <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>जब पौलुस कठिया को गट्ठा इखट्टो करी और बाकै आगी मैं डारत रहे तौ एक साँप आँच लगन के बजह से बाहर आओ और बौ बाके हात मैं लिपट गौ। <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>जब हुँआँ के परदेसी साँप कै बाके हात मैं लिपटो भौ देखी तौ आपस मैं कहीं, “सच्ची मैं जौ आदमी खूनी है, लेकिन जाको भाग्य जाकै जिंदो रहेन नाय देगो, भले बौ समुंदर के जोखिम से बच निकरो है।” <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>तौ पौलुस साँप कै बिना नुकसान पहुँचाए आगी मैं झटक दई। <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>लेकिन बे असियात रहैं कि बौ सूज जागो, या अनकाचीति गिरकै मर जागो, लेकिन जब बे भौत देर तक देखत रहे और देखीं कि बाको कछु भी नाय भौ, तौ बे अपने मन कै बदल दईं और कहीं, “जौ तौ कोई प्रभु है!”<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>बौ जघा से बड़ा दूर कुछ खेत रहैं जो दीप के प्रमुख पुब्लियुस नाओं के आदमी के रहैं बे हमरो स्वागत करीं और तीन दिन तक हम उनके हितुआ रहैं। <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>पुब्लियुस को दऊवा तेज बुखार और पेंचिस से बिमार पड़ो रहे। पौलुस कमरा मैं गौ, प्रार्थना करी, बाके ऊपर हात धरी और बाकै अच्छो करी। <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>जब ऐसो भौ, तौ बौ टापू के और भी दुसरे बिमार पहुँचे और बे भी अच्छे ही गै। <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>बे हमकै भौत उपहार दई, और जब हम नेंगन लागे, तौ जो कछु हमरे ताहीं जरूरी रहे, जहाज मैं धर दईं।<verse eid="ACT 28:10"/></para>
  <para style="s">माल्टा टापू से रोम तक</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>तीन महेना के बाद हम “जुड़वा देवता” कहे जान बारे सिकन्दरिया के एक जहाज मैं रवाना भै, जो बौ टापू मैं ठंड को समय बिताई रहै। <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>हम सुरकूसा सहर मैं पहोंचे और हूँना तीन दिन रहे। <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>हूँना से हम रवाना भै और रेगियुम सहर पहुँचे। अगले दिन तरिहाँए की ब्यार चलनो सुरु भई तौ दुई दिन मैं हम पुतियुली सहर मैं आए। <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>हूँना हमकै कुछ विस्वासी भईय्या मिले जो हमसे एक सप्ताह संग रहेन के ताहीं नहोरे करीं। और जहेमारे हम रोम मैं आए। <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>रोम के विस्वासी भईय्या हमरे बारे मैं सुनी और हमसे भेंटा के ताहीं अप्पियुस के चौहराय और तीन सराय लै आए। जब पौलुस उनकै देखी, तौ परमेस्वर कै धन्यवाद दई और बड़ा बढ़ावा दई।<verse eid="ACT 28:15"/></para>
  <para style="s">रोम मैं</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16"/>जब हम रोम मैं पुगे, तौ पौलुस कै एक सिपईय्या के संग जो बाकी रखबारी करत रहै, खुदै रहेन को आदेस मिलो। <figure style="fig" alt="Street scene of The Roman city" file="hk00242c.tif" size="span" copy="Horace Knowles ©" ref="28:16">रोमन सहर की सड़क को दृस्य</figure><verse eid="ACT 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>तीन दिन के बाद बौ हुँआँ के रहेन बारे यहूदिन के नेतन कै एक बैठक मैं बुलाई। जब बे जुराए, तौ उनसे कही, “मेरे संग के इस्राएलियो, भले मैं अपने लोगन कै या बड़े-बूढ़ेन के रीति-रिवाज के खिलाप मैं कुछ भी नाय करो, मोकै यरूसलेम मैं कैदी बनाए दौ गौ और रोमियों के हात सौंप दौ गौ। <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>मोसे सवाल करन के बाद रोमियों मोकै छोड़नो चाँहीं, काहैकि बे पाई मैं कछु नाय करो, जोके ताहीं मैं मरन के लायक रहौ। <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>लेकिन जब यहूदि जाको बिरोध करीं, तौ मोकै कैसर से अपील करन के ताहीं बेबस होन पड़ो, भले मोकै अपने लोगन के खिलाप बनान को कोई आरोप नाय रहे। <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>जहेमारे मैं तुमकै देखो और तुमसे बातचीत करन के ताहीं कहो। बास्तव मैं, मैं बाके ताहीं जौ तरहन से जंजीर मैं बंधो भौ हौ, जोके ताहीं इस्राएल के लोग आसा करथैं।”<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>बे बासे कहीं, “हम तेरे बारे मैं यहूदियन से कोई चिट्ठी नाय पाए हैं, और ना हमरे कोई आदमिन के झोने तुमरे बारे मैं कहेन के ताहीं कोई खबर या कोई बुरी बात है। <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>लेकिन हम तुमरे बिचारन कै सुननो चाहमंगे, काहैकि हम जानथै कि सब जघा लोग जौ दल के खिलाप बोलथैं जोसे तुम बंधे भै हौ।”<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>तौ बे पौलुस के ताहीं एक तारीक छाँटी, और बौ दिन बड़ी संख्या मैं लोग बौ जघा मैं आए जहाँ पौलुस रहेत रहै। भोर से लैकै रात तक बौ उनकै परमेस्वर के राज्य के बारे मैं अपनो संदेस समझाई, बौ मूसा के नियम और भविस्यवक्तन की किताबन से उनकै ईसु के बारे समझान की कोसिस करी। <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>उनमैं से कुछ लोग पौलुस की बाकी बातन कै मान लईं, लेकिन कुछ लोग अविस्वासी बने रहे। <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>काहैकि पौलुस जब उनसे जौ बात कही तौ बे आपस मैं असहमत हीकै चले गै: “पवित्र आत्मा यसायाह भविस्यवक्ता के जरिये तुमरे बुजर्गन से कितने अच्छे से बात करी रहै! <verse eid="ACT 28:25"/><verse number="26" style="v" sid="ACT 28:26"/>काहैकि बे कहीं,</para>
  <para style="q1" vid="ACT 28:26">‘जाबौ और जे लोगन से कहबौ:</para>
  <para style="q1" vid="ACT 28:26">तुम सुनैगे और सुनैगे, लेकिन समझ मैं नाय आगो;</para>
  <para style="q2" vid="ACT 28:26">तुम देखौ और देखौ, लेकिन नाय देखैगे,<verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>काहैकि जे लोगन को दिमाक सुस्त है,</para>
  <para style="q2" vid="ACT 28:27">और बे अपने कान बन्द कर लईं</para>
  <para style="q2" vid="ACT 28:27">और बे अपनी आँखी मूंद लईं।</para>
  <para style="q1" vid="ACT 28:27">नाय तौ उनकी आँखी देख लेमंगी,</para>
  <para style="q2" vid="ACT 28:27">उनके कान सुनंगे,</para>
  <para style="q2" vid="ACT 28:27">उनको दिमाक समझ जाबैगो,</para>
  <para style="q1" vid="ACT 28:27">और बे मोसे कहमंगे, प्रभु कहथै,</para>
  <para style="q2" vid="ACT 28:27">और मैं उनकै अच्छो कर दुंगो।’”<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>और पौलुस बाको मतलब निकारी: “तुम जौ जाननो चाहथौ कि, परमेस्वर के उद्धार को संदेस गैर यहूदियन कै भेजो गौ है। बे सुनंगे!”<verse eid="ACT 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29"/>जब बौ जौ कही तौ यहूदि आपस मैं गजब विवाद करन लगे और हुँआँ से चले गै।<verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>पौलुस पूरे दुई साल अपने किराय के घर मैं रहो, और हुँआँ बौ बे सबन को स्वागत करी जो बासे मिलन आए रहैं। <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>बौ परमेस्वर के राज्य के बारे मैं प्रचार करी और प्रभु ईसु मसीह के बारे मैं सिखाई, जो बेझिजक और आजादी के संग बोलत रहै।<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
