<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Rana Tharu</book>
  <para style="h">एज्रा</para>
  <para style="toc3">एज्रा</para>
  <para style="toc2">एज्रा</para>
  <para style="toc1">एज्रा</para>
  <para style="mt2">एज्रा की किताब</para>
  <para style="mt1">एज्रा</para>
  <para style="imt">परिचय</para>
  <para style="ip">एज्रा और नहेम्याह की किताब बताथै कि कैसे फारस राजा और बेबीलोनियन की कैद मै ले जान के बाद इस्राएलिन लोगन कै इस्राएल लौटन की इजाजत दई रहै। एज्रा जौ बात मै धियान देन मै जोर देथै कि बे यरुसलेम मै परमेस्वर के मंदिर को दुबारा निर्माड़ कैसे करी। कई ग्यानी लोगन को माननो है कि एज्रा और 2 इतिहास के संग-संग एज्रा और नहेम्याह की किताबन कै भी लिखी और संकलित करी। अगर एज्रा नाय तौ जौ जरूर है कि एकै आदमी जेईं किताबन को संकलन करी होए। एज्रा की किताब 440 ईसा पूर्व के आसपास संकलित करी गई होगी, लेकिन किताब के कुछ हिस्सा और भी समय मै लिखे गै होंगे।</para>
  <para style="ip">एज्रा की किताब दिखाथै कि कैसे परमेस्वर फारस को राजा कुस्रू और इस्राएलियन कै अपनी जमीन मै लौटन और मंदिर को दुबारा निर्माड़ करन की इजाजत देन के ताहीं प्रेरित करी। जौ यिर्मयाह की भविस्यवाँड़ी</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">पहले निर्वासन से लौटनों <char style="ior"><ref loc="EZR 1:1-2:70">1:1–2:70</ref> </char></para>
  <para style="io1">मंदिर को फिर से बननों और समर्पड़ <char style="ior"><ref loc="EZR 3:1-6:22">3:1–6:22</ref></char></para>
  <para style="io1">एज्रा को दुसरे निर्वासितन के संग लौटनों <char style="ior"><ref loc="EZR 7:1-10:44">7:1–10:44</ref> </char></para>
  <chapter number="1" style="c" sid="EZR 1" />
  <para style="s">कुस्रू यहूदियन कै लौटन की आग्या दई</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1" />फारस देस के राजा कुस्रू के पहले साल मैं प्रभु फारस के राजा कुस्रू को मन उभारी कि प्रभु को जो बचन यिर्मयाह के मोहों से निकरो रहै, बौ पूरो हुई जाबै, जौ बजह से बौ अपने सब राज्यन मैं जौ प्रचार करबाई और लिखबाए भी दई:<verse eid="EZR 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 1:2" />फारस को राजा कुस्रू जौ कहथै स्वर्ग को परमेस्वर प्रभु परमेस्वर पृथ्वी भर को राज्य मोकै दई है, और बौ मोकै आग्या दई कि यहूदा के यरूसलेम मैं मेरो एक भवन बनवा। <verse eid="EZR 1:2" /><verse number="3" style="v" sid="EZR 1:3" />बाके सब लोगन मैं से तुमरे बीच जो कोई होबै, बाको परमेस्वर बाके संग रहबै, बौ यहूदा के यरूसलेम कै जाएकै इस्राएल के परमेस्वर प्रभु परमेस्वर को भवन बनाबै - जो यरूसलेम मैं है बहे परमेस्वर है; <verse eid="EZR 1:3" /><verse number="4" style="v" sid="EZR 1:4" />और कोई भी बौ जो भी जघा मैं रह गौ होबै, जहाँ बौ रहत होबै बौ जघा के लोग चाँदी, सोना, धन और जानवर दैकै बाकी मदत करैं और जासे जाधे यरूसलेम रहन बारे परमेस्वर के भवन के ताहीं अपनी इच्छा से भी भेंट चढ़ाबै।<verse eid="EZR 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5" />तौ यहूदा और बिन्यामीन के जितने पितरन के घरानन के खास लोग और पुजारिन और लेवियन को मन परमेस्वर उभारी रहै कि जाएकै यरूसलेम मैं प्रभु परमेस्वर के भवन कै बनामैं, बे सब उठ खड़े भै; <verse eid="EZR 1:5" /><verse number="6" style="v" sid="EZR 1:6" />और बाके आसपास के सब रहनबारे चाँदी के बर्तन, सोना, धन, जानवर और अनमोल चीजन कै दैकै, उनकी मदत करीं; जौ बे सबन से जाधे रहै जो लोग अपनी-अपनी इच्छा से दईं।<verse eid="EZR 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7" />फिर राजा कुस्रू प्रभु परमेस्वर के भवन के जो बर्तन नबूकदनेस्सर यरूसलेम से निकारकै अपने देवता के भवन मैं रखी रहै।<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">2 राजा 25:8-17</char></note> <verse eid="EZR 1:7" /><verse number="8" style="v" sid="EZR 1:8" />उनकै फारस को कुस्रू राजा, मिथ्रदाथ खजांची से निकरबाएकै, यहूदिन के सेसबस्सर नाओं के सासक कै गिनकै सौंप दई। <verse eid="EZR 1:8" /><verse number="9" style="v" sid="EZR 1:9" />उनकी गिनती जौ रहै, मतलब सोने के तीस और चाँदी के एक हजार बर्तन और उनतीस छुरिया, <verse eid="EZR 1:9" /><verse number="10" style="v" sid="EZR 1:10" />सोने के तीस और बीच हानी की चाँदी के चार सौ दस कटोरा और दुसरे तराहनी के बर्तन एक हजार। <verse eid="EZR 1:10" /><verse number="11" style="v" sid="EZR 1:11" />सोने चाँदी के बर्तन सब मिलाएकै पाँच हजार चार सौ रहैं। जे सबन कै सेसबस्सर बौ समय लै आई, जब बन्धुए बेबीलोन से यरूसलेम कै आए।<verse eid="EZR 1:11" /></para>
  <chapter eid="EZR 1" />
  <chapter number="2" style="c" sid="EZR 2" />
  <para style="s">देस से निकारे भै यहूदियन की सूची</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1" />जे बौ प्रान्त के बे आदमी हैं जो बन्धुवाई से छुटकै आए रहैं, और जिनकै बेबीलोन को राजा नबूकदनेस्सर बंधी बनाएकै बेबीलोन कै लै गौ रहै; बे यरूसलेम और यहूदा कै अपने-अपने नगर लौट गै।<verse eid="EZR 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 2:2" />उनके अगुवा जरुब्बाबेल, यहोसू, नहेम्याह, सरायाह, रीलैया, मोर्दकै, बिलसान, मिस्पार, बिगवै, रहूम और बाना रहैं। इस्राएल के कुलन की सूची ऐसे करकै है, और प्रत्येक कुल मै से जो लोग बन्धुवाई से लौट आए, उनकी गिनती जे हैं: इस्राएल के कुलन की सूची ऐसे है, और हर कुल मैं से जो बन्धुवाई लौट आए, उनकी गिनती जौ है:<verse eid="EZR 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZR 2:3" />परोस के वंसज दुई हजार एक सौ बहात्तर,<verse eid="EZR 2:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="EZR 2:4" />सपत्याह के वंसज तीन सौ बहात्तर,<verse eid="EZR 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZR 2:5" />आरह के वंसज सात सौ पिचत्तर,<verse eid="EZR 2:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="EZR 2:6" />पहत्मोआब के लौड़ा ईसु और योआब के वंसज दुई हजार आठ सौ बाहरै,<verse eid="EZR 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZR 2:7" />एलाम के वंसज बाहरै सौ चऊवन,<verse eid="EZR 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="EZR 2:8" />जत्तू के वंसज नौ सौ पैंतालीस,<verse eid="EZR 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZR 2:9" />जक्कई के वंसज सात सौ साठ,<verse eid="EZR 2:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="EZR 2:10" />बानी के वंसज छै सौ बयालीस,<verse eid="EZR 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZR 2:11" />बेबई के वंसज छै सौ तेईस,<verse eid="EZR 2:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="EZR 2:12" />अजगाद के वंसज बाहरै सौ बाईस,<verse eid="EZR 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZR 2:13" />अदोनीकाम के वंसज छै सौ छियासठ,<verse eid="EZR 2:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="EZR 2:14" />बिग्वई के वंसज दुई हजार छप्पन,<verse eid="EZR 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZR 2:15" />आदीन के वंसज चार सौ चऊवन,<verse eid="EZR 2:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="EZR 2:16" />हिजकिय्याह के वंसज, आतेर की वंसज मैं से अट्ठानबै,<verse eid="EZR 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZR 2:17" />बेसई के वंसज तीन सौ तेईस,<verse eid="EZR 2:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="EZR 2:18" />योरा के वंसज एक सौ बाहरै,<verse eid="EZR 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZR 2:19" />हासूम के वंसज दुई सौ तेईस,<verse eid="EZR 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="EZR 2:20" />गिब्बार के वंसज पिचानबे।<verse eid="EZR 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 2:21" />बे लोग जिनके पूर्वज नीचे लिखे भै नगरन मैं रहत रहैं, बे भी लौटियाए:</para>
  <para style="q1" vid="EZR 2:21">बैतलहम नगर के रहन बारे एक सौ तेईस,<verse eid="EZR 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="EZR 2:22" />नत्तोपा नगर के लोग छप्पन,<verse eid="EZR 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="EZR 2:23" />अनातोत नगर के लोग एक सौ अट्ठाईस,<verse eid="EZR 2:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="EZR 2:24" />अजमावेत के रहन बारे बयालीस,<verse eid="EZR 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZR 2:25" />किर्यत्यारीम, कपीरा, और बेरोत नगर मैं रहन बारे सात सौ तैंतालिस,<verse eid="EZR 2:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="EZR 2:26" />रामा और गेबा नगरन के रहन बारे छै सौ इक्कीस,<verse eid="EZR 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZR 2:27" />मिकमास नगर के लोग एक सौ बाईस,<verse eid="EZR 2:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="EZR 2:28" />बेतेल और ए नगरन के लोग दुई सौ तेईस,<verse eid="EZR 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZR 2:29" />नेबो नगर के रहन बारे बावन,<verse eid="EZR 2:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="EZR 2:30" />मग्बीस नगर के रहन बारे एक सौ छप्पन,<verse eid="EZR 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZR 2:31" />दुसरे एलाम नगर के रहन बारे बाहरै सौ चऊवन,<verse eid="EZR 2:31" /></para>
  <para style="q2">
    <verse number="32" style="v" sid="EZR 2:32" />हारीम नगर के रहन बारे तीन सौ बीस,<verse eid="EZR 2:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZR 2:33" />लोद, हदीद, और ओनो नगरन के रहन बारे सात सौ पच्चीस,<verse eid="EZR 2:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="EZR 2:34" />यरीहो नगर के रहन बारे तीन सौ पैंतालीस,<verse eid="EZR 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZR 2:35" />सनाआ नगर के रहन बारे तीन हजार छै सौ तीस। जौ बे पुरोहितन की वंसज की सूची है जो देस निकाला से लौटे रहैं।<verse eid="EZR 2:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="EZR 2:36" />पुजारी मतलब ईसु के घराने मैं से यदायाह के वंसज नौ सौ तिहत्तर,<verse eid="EZR 2:36" /></para>
  <para style="q2">
    <verse number="37" style="v" sid="EZR 2:37" />इम्मेर के वंसज एक हजार बावन,<verse eid="EZR 2:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="EZR 2:38" />पसहूर के वंसज बाहरै सौ सैंतालिस,<verse eid="EZR 2:38" /></para>
  <para style="q2">
    <verse number="39" style="v" sid="EZR 2:39" />हारीम के वंसज एक हजार सत्रै। देस निकाला से लौटे लेवियन के वंसज। <verse eid="EZR 2:39" /><verse number="40" style="v" sid="EZR 2:40" />लेवी येसुआ और कदमीएल के वंसज, मतलब होदव्याह के वंसज, चौहत्तर,<verse eid="EZR 2:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="EZR 2:41" />मंदिर के गायकार: आसाप के वंसज एक सौ अट्ठाईस,<verse eid="EZR 2:41" /></para>
  <para style="q2">
    <verse number="42" style="v" sid="EZR 2:42" />मंदिर के फाटक की रक्छा करन बारे: सल्लूम, आतेर, तल्मोन, अक्कूब, हतीता और सोबई के वंसज एक सौ उन्तालीस।</para>
  <para style="p" vid="EZR 2:42">देस निकाला से लौटे मंदिर के सेवकन के वंसज:<verse eid="EZR 2:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="EZR 2:43" />सीहा, हसूपा, तब्बाओत,<verse eid="EZR 2:43" /></para>
  <para style="q2">
    <verse number="44" style="v" sid="EZR 2:44" />केरोस, सीअहा, पादोन,<verse eid="EZR 2:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="EZR 2:45" />लबाना, हगाब, अक्कूब,<verse eid="EZR 2:45" /></para>
  <para style="q2">
    <verse number="46" style="v" sid="EZR 2:46" />हागाब, समलई, हानान,<verse eid="EZR 2:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="EZR 2:47" />गिद्देल, गहर, रायाह,<verse eid="EZR 2:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="EZR 2:48" />रसीन, नकोदा, गज्जाम,<verse eid="EZR 2:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="EZR 2:49" />उज्जा, पासेह, बेसई,<verse eid="EZR 2:49" /></para>
  <para style="q2">
    <verse number="50" style="v" sid="EZR 2:50" />अस्ना, मुनीम, नपीसीम,<verse eid="EZR 2:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="EZR 2:51" />बकबूक, हकूपा, हर्हूर,<verse eid="EZR 2:51" /></para>
  <para style="q2">
    <verse number="52" style="v" sid="EZR 2:52" />बसलूत, महीदा, हर्सा,<verse eid="EZR 2:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="EZR 2:53" />बर्कोस, सीसरा, तेमह,<verse eid="EZR 2:53" /></para>
  <para style="q2">
    <verse number="54" style="v" sid="EZR 2:54" />नसीह और हतीपा के वंसज रहैं। <verse eid="EZR 2:54" /><verse number="55" style="v" sid="EZR 2:55" />देस निकाला से लौटे सुलेमान के सेवकन के वंसज सोतई, सोपेरेत, परूदा,<verse eid="EZR 2:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="EZR 2:56" />याला, दर्कोन, गिद्देल,<verse eid="EZR 2:56" /></para>
  <para style="q2">
    <verse number="57" style="v" sid="EZR 2:57" />सपत्याह, हत्तील, पोकरेत-हसबायीम, और आमी के वंसज रहैं।<verse eid="EZR 2:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="EZR 2:58" />ऐसे करकै मंदिर के सेवकन की और सुलेमान के सेवकन के वंसजन की संख्या तीन सौ बयानबै रहै।<verse eid="EZR 2:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59" />जे सब जनी तेलमेलह, तेलहर्सा, करूब, अद्दान और इम्मेर नगरन से आए रहैं, पर बे अपने पूर्वजन के नाओं नाय बताए पाईं, कि उनके परिवार इस्राएली वंसज के हैं: <verse eid="EZR 2:59" /><verse number="60" style="v" sid="EZR 2:60" />दलायाह, तोबियाह और नकोदा के वंसज, जे सब मिलकै छै सौ बावन रहैं।<verse eid="EZR 2:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="EZR 2:61" />जे पुजारिन के वंसज रहैं: हबायाह, हक्कोस और बर्जिल्लई के वंसज, बर्जिल्लई गिलआद नगर के रहन बारे बर्जिल्लई की लौड़िया से बिहा करी रहै, और बाको नाओं अपनाए लई रहै।<note caller="+" style="f"><char style="fr" closed="false">2:61 </char><char style="ft" closed="false">1 राजा 2:7</char></note> <verse eid="EZR 2:61" /><verse number="62" style="v" sid="EZR 2:62" />जे लोग अपनो नाओं वंसावली के सूचीपत्र मैं ढूँड़ीं, पर हुँआँ ना मिलो। और उनकै असुद्ध घोसित करो गौ, और बे पुजारी के पदन से हटाए दै गै। <verse eid="EZR 2:62" /><verse number="63" style="v" sid="EZR 2:63" />यहूदी राज्यपाल उनसे कही, जबले पुजारी ऊरीम और तुम्मीम के जरिये परमेस्वर की इच्छा ना जान लेमैं, तौले तुम लोग मंदिर मै को चढ़ो भौ पवित्र खानु ना खागे।<note caller="+" style="f"><char style="fr" closed="false">2:63 </char><char style="ft" closed="false">गिनती 27:21 </char></note><verse eid="EZR 2:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="EZR 2:64" />सब इस्राएली जन समुदाय की जनसंख्या बयालीस हजार तीन सौ साठ रहै।<verse eid="EZR 2:64" /></para>
  <para style="q2">
    <verse number="65" style="v" sid="EZR 2:65" />इनके अलावा उनके नौकर-चाकरन की संख्या सात हजार तीन सौ सैंतीस,</para>
  <para style="q1" vid="EZR 2:65">और मंदिर के गबईय्यन की संख्या दुई सौ रहै।<verse eid="EZR 2:65" /></para>
  <para style="q2">
    <verse number="66" style="v" sid="EZR 2:66" />उनके पास सात सौ छत्तीस घोड़ा,</para>
  <para style="q1" vid="EZR 2:66">दुई सौ पैंतालीस खच्चर,<verse eid="EZR 2:66" /></para>
  <para style="q2">
    <verse number="67" style="v" sid="EZR 2:67" />चार सौ पैंतीस ऊँट,</para>
  <para style="q1" vid="EZR 2:67">और छै हजार सात सौ बीस गधा रहैं।<verse eid="EZR 2:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68" />जब इस्राएली वंसज के मुखिया यरूसलेम प्रभु के मंदिर मैं आए, तौ वंसज के कुछ नेता मंदिर कै बाके पुरानी जघा मैं फिर से बनान मैं मदत करन के ताहीं अपनी इच्छा से दान दईं। <verse eid="EZR 2:68" /><verse number="69" style="v" sid="EZR 2:69" />बे जौ काम के ताहीं पूरी ताकत से उनसे जितनो हुई सको उतनो दईं, और कुल मिलाएकै इकसठ हजार सोने की रुपईया, पाँच हजार चाँदी के सिक्का और पुजारिन के ताहीं सौ लत्ता दईं।<verse eid="EZR 2:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70" />पुजारी,<note caller="+" style="f"><char style="fr" closed="false">2:70 </char><char style="ft" closed="false">याजक</char></note> लेवी और कुछ लोग यरूसलेम नगर मैं और बाके आस-पास के इलाके मैं बस गै; संगीतकार, मंदिर के रक्छक, और मंदिर के कर्मचारी, झोने के नगरन मैं बस गै; और इस्राएल के बचे भै लोग बे नगरन मैं बस गै जहाँ उनके पुरखा रहत रहैं।<verse eid="EZR 2:70" /></para>
  <chapter eid="EZR 2" />
  <chapter number="3" style="c" sid="EZR 3" />
  <para style="s">फिर से परमेस्वर की आराधना सुरु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1" />5 सातमें महेना तक इस्राएल के सबै लोग अपने नगर मै बस गै। फिर बे इकट्ठो हुई कै सातमें महेना मैं यरूसलेम मै इकट्ठे भै, <verse eid="EZR 3:1" /><verse number="2" style="v" sid="EZR 3:2" />और योसादाक को लौड़ा यहोसू, बाके संग के पुजारियन, और सालतीएल को लौड़ा जरुब्बाबेल अपने भईय्यन के संग मिलकै, इस्राएल के परमेस्वर की बेदी कै फिर बनाईं, ताकी बे मूसा के व्यवस्था मै लिखे निर्देसन के जरिया परमेस्वर की बेदी मैं बलि चढ़ाए सकैं।<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">मत्ती 1:12; लूका 3:27</char></note> <verse eid="EZR 3:2" /><verse number="3" style="v" sid="EZR 3:3" />भलेई हुँआँ से निकारे भै लोग बौ देस मैं रहन बारे लोगन से डरात रहैं, बे बेदी कै हुनै बनाईं जहाँ बौ पहले ठाड़ी रहै। तौ बे एक बार फिर से बामैं सुबेरे और संजाखिन कै प्रभु परमेस्वर के ताहीं बलि चढ़ानो सुरु कर दईं। <verse eid="EZR 3:3" /><verse number="4" style="v" sid="EZR 3:4" />बे झोपड़ियन के त्योहार कै मानीं, जैसे कि लिखो है, और हर दिन के होमबलि एक-एक दिन की गिनती और नियम के हिसाब से चढ़ाई;<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">नि 23:16; गिनती 29:12</char></note> <verse eid="EZR 3:4" /><verse number="5" style="v" sid="EZR 3:5" />और जाके अलावा बे हर दिन अग्नि-बलि, नये जोनी के त्योहार की बलि, तै करी भई प्रभु-त्योहारन मैं चढ़ाई जान बारी बलि, और प्रभु कै अपनी इच्छा से चढ़ाई जान बारी बलि देन लगे।<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">नि 29:38; गिनती 28:3 </char></note> <verse eid="EZR 3:5" /><verse number="6" style="v" sid="EZR 3:6" />पर लोग हबै ले मंदिर को काम दुबारा से सुरू नाय करी रहैं, फिर भी बे सातमे महेना के पहले दिन से प्रभु के ताहीं अग्नि-बलि चढ़ानो सुरु कर दईं रहैं।<verse eid="EZR 3:6" /></para>
  <para style="s">मंदिर दुबारा से बननो सुरु</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7" />बे सब राजमिस्त्रिन और बढ़ईया कै रुपईया दईं, बे सीदोन और सोर देस के रहन बारेन कै खान-पीन को सामान और तेल दईं, ताकी बे देवदार की कठिया कै लबानेन देस से समुंदर की रस्ता, याफा नगर ले पुगाए दियैं, जौ सब फारस के राजा कुस्रू के जरिये इजाजत मिली रहै। <verse eid="EZR 3:7" /><verse number="8" style="v" sid="EZR 3:8" />यरूसलेम मै परमेस्वर के मंदिर की जघा मैं वापस आन के बाद, साल के दुसरे महेना मैं बे काम सुरू करीं। जरुब्बाबेल, सालतीएल, योसादाक के लौड़ा यहोसू, और बाकी प्रजा, पुजारी, और लेवी, हिंयाँ तक कि जित्ते भईय्या-बंधु रहैं, यरूसलेम कै लौटियाए रहैं, सब काम मै लग्गै। बीस साल या बासे जाधे उमर के सब लेवियन कै मंदिर कै बनान के काम को अधिकारी बनाओ गौ। <verse eid="EZR 3:8" /><verse number="9" style="v" sid="EZR 3:9" />येसु, बाके लौड़ा और भईय्या-बंधु और कदमीएल, हेनादाद और बाके लौड़ा, जो यहूदा गोत्र के लेवी वंसज रहैं, जे सब परमेस्वर के भवन मै काम करन बारे मजदूरन के काम की देखरेख करन बारे रहैं।<verse eid="EZR 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10" />जब राजमिस्त्री मंदिर की बुनियाद डारन लागे, तौ पुजारी अपने लत्ता पहने और अपने हात मै तुरहिया लैकै आए, उनके संग आसाप के वंसज लेवी झाँझ लैकै हुँआँ आए। बे इस्राएल देस के राजा दाऊद के निर्देसन के हिसाब से प्रभु की स्तुति करीं। <verse eid="EZR 3:10" /><verse number="11" style="v" sid="EZR 3:11" />बे जौ पंक्ति कै दोहरात भई प्रभु की स्तुति गाईं: “प्रभु भला है, और इस्राएल के प्रति बाको प्रेम अनंत है।”</para>
  <para style="p" vid="EZR 3:11">सब जनी अपनी पूरी ताकत से जय-जयजयकार करत भई प्रभु परमेस्वर की स्तुति करन लागे, काहैकि मंदिर की बुनियाद को काम सुरू हुई चुको रहै।<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">2 इत 7:3; भज 136:1</char></note> <verse eid="EZR 3:11" /><verse number="12" style="v" sid="EZR 3:12" />तमान बड़े-बूढ़े पुजारी, लेवी और पुरखन के परिवारन के मुखिया पहले को मंदिर देखी रहैं, और जब बे जौ नया मंदिर की बुनियाद पड़त भई देखीं, तौ बे रोय पड़े और सोक करीं। लेकिन हुँआँ मौजूद दुसरे लोग खुसी से जय-जयजयकार करन लगे। <verse eid="EZR 3:12" /><verse number="13" style="v" sid="EZR 3:13" />जय-जयजयकार और रोन को सुर दोनों एकै मै मिल गै। लोग अंतर ना जान पाईं कि जौ रोन को स्वर है कि जय-जयजयकार को, काहैकि बे जो जय-जयजयकार करीं बौ इत्ते जोड़न से करी रहैं कि जाकै मीलों दूर तक सुनो जाए सकत रहै।<verse eid="EZR 3:13" /></para>
  <chapter eid="EZR 3" />
  <chapter number="4" style="c" sid="EZR 4" />
  <para style="s">परमेस्वर के मंदिर कै फिर से बनान मैं विरोध</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1" />जब यहूदा और बिन्यामीन कुल के लोगन के दुस्मन जौ सुनीं कि जो लोग बंधुवाई से लौट आए हैं, बे इस्राएल के परमेस्वर प्रभु परमेस्वर को मंदिर फिर से बनाए रै हैं। <verse eid="EZR 4:1" /><verse number="2" style="v" sid="EZR 4:2" />जौ बजह से बे जरुब्बाबेल और कुलन के मुखियन से मिलन गै, और कहीं, अपने संग हमैं भी मंदिर बनान दियौ। हम भी तुमरे हानी तुमरे परमेस्वर की आराधना करथैं, और जब से अस्सूर को राजा एसरहद्दोन हमैं हिंयाँ भेजी है तौ से हम तुमरे परमेस्वर कै बलिदान चढ़ात आए रै हैं।<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">2 राजा 17:24 </char></note><verse eid="EZR 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3" />जरुब्बाबेल, यहोसू और इस्राएली कुल के परिवारन के मुखिया उनसे कहीं, “हमैं अपने परमेस्वर प्रभु परमेस्वर के ताहीं मंदिर बनान मैं तुमरी मदत की जरूरत ना है। हम अकेलो इस्राएल के परमेस्वर, प्रभु के ताहीं मंदिर बनांगे, जैसो हमैं फारस को राजा कुस्रू आदेस दई है।”<verse eid="EZR 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4" />तौ बौ देस के रहनबारे सामरी लोग यहूदियन कै डराए-धमकाए कै परेसान करन लागे, और उनकै काम करन से रोकन लागे। <verse eid="EZR 4:4" /><verse number="5" style="v" sid="EZR 4:5" />बे जरूब्बाबेल, यहोसू और कुलन के मुखियन के कामन कै विफल करन के ताहीं फारसी सरकारी अधिकारिन कै घूस भी दईं। और बे राजा कुस्रू के सासनकाल और राजा दारा के सासनकाल ले ऐसोई करत रहे, काम होनै ना दईं।<verse eid="EZR 4:5" /></para>
  <para style="s">यरूसलेम कै फिर से बनान मैं विरोध</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6" />राजा छयर्स के सासनकाल की सुरूवात मैं, यहूदा और यरूसलेम मैं रहन बारे लोगन कै दुस्मन उनके खिलाप लिखित आरोप लिखकै भेजीं।<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">एस 1:1 </char></note><verse eid="EZR 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7" />फिर फारस के राजा अर्तछत्र के सासनकाल मैं बिसलाम, मिथ्रदाथ, ताबेल और उनकी मदत करन बारे सम्राट अर्तछत्र कै एक चिट्ठी लिखीं। चिट्ठी अरामी भासा मैं लिखी गई रहै और बाकी लिपि अरामी भासा रहै।<verse eid="EZR 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8" />रहूम राज्यपाल और सिमसै अधिकारी यरूसलेम के खिलाप राजा अर्तछत्र कै चिट्ठी लिखी रहैं:<verse eid="EZR 4:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="EZR 4:9" />इनके अलावा चिट्ठी लिखन मैं जे लोग भी सामिल रहैं, रहूम राज्यपाल, सिमसै, जो प्रदेस को अधिकारी रहै, और उनके संग बारे, मतलब दीनी, अपर्सतकी, तर्पकी, अफारसी, एरेकी, बाबेली, सूसनी, देहवी, एलामी देस के, <verse eid="EZR 4:9" /><verse number="10" style="v" sid="EZR 4:10" />इनके अलावा चिट्ठी लिखन मैं बे कौम के लोग भी सामिल रहैं, जिनके महान और ताकतवर राजा ओस्नप्पर उनके देस से निकारकै, सामरिया प्रदेस के नगरन मैं और फरात नदिया के पछार के इलाके के प्रदेसन मैं बसाई रहै।<verse eid="EZR 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11" />जो चिट्ठी कै बे अर्तछत्र राजा कै लिखी, बाकी जौ नकल है, राजा अर्तछत्र की सेवा मैं तेरे सेवक जो फरात नदिया के पार के लोग हैं, तोकै नमस्ते भेजथैं।<verse eid="EZR 4:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="EZR 4:12" />“राजा को जौ मालुम होबै, कि जो यहूदी तेरे झोने से चले आए, बे हमरे झोने यरूसलेम कै पहोंचे। बे बौ दंगैत और घिनौनो सहर कै बसाए रहे हैं; बल्किन बाकी सहरी दीवार कै खड़ो कर चुके हैं और बाकी बुनियाद बनाए चुके हैं। <verse eid="EZR 4:12" /><verse number="13" style="v" sid="EZR 4:13" />अब राजा कै मालुम भौ कि अगर बौ सहर बस गौ और बाकी सहरी दीबार बन गई, तब तौ बे लोग चुंगी और रंगदारी फिर नाय देंगे, और आखरी मै सब राजन कै नुकसान उठान पड़ैगो। <verse eid="EZR 4:13" /><verse number="14" style="v" sid="EZR 4:14" />हम लोग तौ राजघर को नून खाथैं, और सई भी नाय है कि हम राजा कै अनादर होत भै देख सकैं, और हम तुम्हैं चिताए देत हैं जौ चिट्ठी भेजकै। <verse eid="EZR 4:14" /><verse number="15" style="v" sid="EZR 4:15" />तेरे पुरखन की इतिहास की किताब मैं खोजबीन करी जाबै; तभई इतिहास की किताब मैं तू जौ पाएकै जान लेगो, कि बौ सहर बलवा करनबारे और सब राजा और प्रदेसन को नुकसान भौ रहै। <verse eid="EZR 4:15" /><verse number="16" style="v" sid="EZR 4:16" />हम राजा कै पक्को कराए देथैं कि अगर बौ सहर बसाओ जाबै और बाकी सहरी दीबार बन चुकै, तभई जौ बजह से फरात नदिया के जौ पाँजर तेरो कोई भी हिस्सा ना रहेगो।”<verse eid="EZR 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17" />तौ राजा रहूम राजमंत्री और सिमसै मंत्री और सामरिया फरात नदिया के पाँजर रहनबारे उनके संगबारेन के झोने जौ जबाब भेजी,</para>
  <para style="pi" vid="EZR 4:17">“आसिर्वाद, सबन कै!<verse eid="EZR 4:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="EZR 4:18" />जो चिट्ठी तुम मेरे झोने भेजे बाकै मेरे सामने सई से पढ़ीं और अनुवाद करीं। <verse eid="EZR 4:18" /><verse number="19" style="v" sid="EZR 4:19" />मेरी आग्या के जरिया तलास करे जान मैं पता चलो है, कि बौ सहर पुराने समय से राजन के खिलाप मुड़िया उठात आओ है और बामैं दंगा और बलवा होत आओ है। <verse eid="EZR 4:19" /><verse number="20" style="v" sid="EZR 4:20" />यरूसलेम मैं सामर्थी राजा भी रहैं, जो फरात नदिया के पाँजर से सबै देस मैं राज्य करत रहैं, और चुंगी और रंगदारी उनकै दई जात रहै। <verse eid="EZR 4:20" /><verse number="21" style="v" sid="EZR 4:21" />तभई अब जे आग्यन को प्रचार कर कि बे लोग रुक जामैं, और जब ले मेरे घाँईं से आग्या ना मिलै, तब ले बौ सहर बसाओ ना जाबै। <verse eid="EZR 4:21" /><verse number="22" style="v" sid="EZR 4:22" />और चाहचीते रहियो, और जौ बात मै ढीले मत हुइयो; और राजन कै नुकसान पहोंचान बारे काम कै अग्गु मत बढ़न दियो।”<verse eid="EZR 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23" />जब राजा अर्तछत्र की जौ चिट्ठी रहूम और सिमसै मंत्री और उनके मदतगारन कै पढ़कै सुनाओ गौ, तौ बे उतावलो हुईकै यरूसलेम कै यहूदिन के झोने गै, और पूरे बल से काम कै रोक दौ गौ।<verse eid="EZR 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24" />तौ परमेस्वर के मंदिर को काम यरूसलेम मैं रुक गौ; और फारस के राजा दारा के राज्य के दुसरे साल ले रुको रहो।<verse eid="EZR 4:24" /></para>
  <chapter eid="EZR 4" />
  <chapter number="5" style="c" sid="EZR 5" />
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1" />तौ हाग्गै नाओं को नबी और इद्दो को धुईतो जकर्याह यहूदा और यरूसलेम के यहूदिन कै प्रचार करन लगे, बे इस्राएल के परमेस्वर के नाओं से उनसे प्रचार करीं। <verse eid="EZR 5:1" /><verse number="2" style="v" sid="EZR 5:2" />तौ सालतीएल को लौड़ा जरुब्बाबेल और योसादाक को लौड़ा ईसु, कमर भाँदकै परमेस्वर के भवन कै जो यरूसलेम मैं है बनान लगे और परमेस्वर के बे नबी उनकी मदत करत रहैं।<verse eid="EZR 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3" />बहे समय फरात नदिया के जौ पाँजर को तत्तनै नाओं को सासक और सतर्बोजनै अपने मदत करन बारेन समेत उनके झोने जाएकै जौ पूँछन लगे, जौ भवन कै बनान और जौ सहरपनाह कै ठड़बान की कौन तुमकै आग्या दौ? <verse eid="EZR 5:3" /><verse number="4" style="v" sid="EZR 5:4" />बे लोगन से जहो भी कहीं, जौ भवन कै बनान बारेन के का नाओं हैं? <verse eid="EZR 5:4" /><verse number="5" style="v" sid="EZR 5:5" />पर यहूदियन के बड़े-बूढ़ेन के परमेस्वर की नजर उनके ऊपर रहै, इसलै जब ले जौ बात की चर्चा दारा से ना करी गई और जाके बारे मैं चिट्ठी के जरिये जबाब ना मिलो, तौ ले बे उनकै ना रोकीं। <verse eid="EZR 5:5" /><verse number="6" style="v" sid="EZR 5:6" />जो चिट्ठी फरात नदिया के जौ पाँजर के सासक तत्तनै और सतर्बोजनै और फरात नदिया के जौ पाँजर के उनके मदत करन बारेन अपार्सकियन राजा दारा के झोने भेजी बाकी नकल जौ है; <verse eid="EZR 5:6" /><verse number="7" style="v" sid="EZR 5:7" />बे बाकै जो चिट्ठी लिखी, बामैं जौ लिखो रहै राजा दारा को कुसल छेम सब तरहन से होबै। <verse eid="EZR 5:7" /><verse number="8" style="v" sid="EZR 5:8" />राजा कै विदित होबै कि हम लोग यहूदा नाओं के देस मैं महान परमेस्वर के भवन के झोने गै रहैं, बौ बड़े-बड़े पथरन से बन रौ है, और बाकी दीवारन मैं कड़िया जुड़ रईं हैं; और जौ काम बे लोगन के जरिये फुर्ती के संग हुई रौ है, और सफल भी होत जाएरौ है। <verse eid="EZR 5:8" /><verse number="9" style="v" sid="EZR 5:9" />जौ बजह से हम बे पुरनियन से ऐसे पूँछे, जौ भवन बनान, और जौ सहरपनाह फिर से बनान की आग्या तुमकै कौन दौ? <verse eid="EZR 5:9" /><verse number="10" style="v" sid="EZR 5:10" />और हम उनके नाओं भी पूछे, कि हम उनके मुख्य आदमिन के नाओं लिखकै तोकै बताए सकैं।<verse eid="EZR 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 5:11" />बे हमकै जौ जबाब दईं, हम तौ आसमान और पृथ्वी के परमेस्वर के दास हैं, और जौ भवन कै भौत साल पहले इस्राएलियन को एक बड़ो राजा बनाएकै तैयार करी रहै, बहे कै हम बनाए रै हैं। <verse eid="EZR 5:11" /><verse number="12" style="v" sid="EZR 5:12" />जब हमरे पुरखा स्वर्ग के परमेस्वर कै गुस्सा दिबाईं, तौ बौ उनकै बेबीलोन के कसदी राजा नबूकदनेस्सर के हात मैं कर दई रहै, और बौ जौ भवन कै खतम करी और लोगन कै बंदी बनाएकै बेबीलोन कै लै गौ। <verse eid="EZR 5:12" /><verse number="13" style="v" sid="EZR 5:13" />पर बेबीलोन को राजा कुस्रू के पहले साल मैं बहे कुस्रू राजा परमेस्वर के जौ भवन कै बनान की आग्या दई। <verse eid="EZR 5:13" /><verse number="14" style="v" sid="EZR 5:14" />परमेस्वर के भवन के जो सोने और चाँदी के बर्तन नबूकदनेस्सर यरूसलेम के मंदिर मैं से निकरबाएकै बेबीलोन के मंदिर मैं लै गौ रहै, बाकै राजा कुस्रू बेबीलोन के मंदिर मैं से निकरबाएकै सेसबस्सर नाओं एक लोग कै जोकै बौ सासक ठहराए दई रहै, सौंप दई। <verse eid="EZR 5:14" /><verse number="15" style="v" sid="EZR 5:15" />बौ बासे कही, “जौ बर्तन लै जाएकै यरूसलेम के मंदिर मैं रख, और परमेस्वर को बौ भवन अपनी जघा मैं बनाओ जाए।” <verse eid="EZR 5:15" /><verse number="16" style="v" sid="EZR 5:16" />तौ बहे सेसबस्सर आएकै परमेस्वर के भवन की जो यरूसलेम मैं है बुनियाद डारी; और तौ से अब ले जौ बन रौ है, पर अब ले ना बन पाओ।<verse eid="EZR 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 5:17" />“अब अगर राजा कै अच्छो लगै तौ बेबीलोन के राजभंडार मैं जौ बात की खोज करी जाबै, कि राजा कुस्रू सचमुच परमेस्वर के भवन कै, जो यरूसलेम मैं है, बनवान की आग्या दई रहै कि नाय। तौ राजा जौ बारे मैं अपनी इच्छा हमकै बताबै।”<verse eid="EZR 5:17" /></para>
  <chapter eid="EZR 5" />
  <chapter number="6" style="c" sid="EZR 6" />
  <para style="s">राजा दारा को आदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1" />तभईये राजा दारा की आग्या से बेबीलोन के पुस्तकालय मैं जहाँ खजाना भी रखो रहै, खोज करी गई। <verse eid="EZR 6:1" /><verse number="2" style="v" sid="EZR 6:2" />मादे नाओं देस के अहमता नगर के राजगढ़ मैं एक किताब मिली, जोमैं जौ याद रखन ताहीं लिखो रहै:<verse eid="EZR 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 6:3" />“राजा कुस्रू के पहले साल मैं बहे कुस्रू राजा जौ आग्या दई, कि परमेस्वर के भवन के बारे मैं जो यरूसलेम मैं है, मतलब बौ भवन जोमैं बलिदान करे जात रहैं, बौ बनाओ जाए और बाकी बुनियाद मजबूती से डारी जाबै, बाकी ऊँचाई और चौंड़ाईं साठ हात की होबै; <verse eid="EZR 6:3" /><verse number="4" style="v" sid="EZR 6:4" />बामैं तीन रद्दा भारी पथरन के होमैं, और एक परत नई कठिया की होबै; और इनकी लागत राजभवन मैं से दई जाबै। <verse eid="EZR 6:4" /><verse number="5" style="v" sid="EZR 6:5" />परमेस्वर के भवन के जो सोने और चाँदी के बर्तन नबूकदनेस्सर यरूसलेम के मंदिर मैं से निकरबाएकै बेबीलोन कै पहोंचाए दई रहैं बौ लौटाएकै यरूसलेम के मंदिर मैं अपनी-अपनी जघा मैं पहोंचाए जामैं, और तैं उन्हैं परमेस्वर के भवन मैं रख दिये।”<verse eid="EZR 6:5" /></para>
  <para style="s">राजा दारा काम जारी रखन को आदेस दई</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6" />राजा दारा को आदेस भेजनो:</para>
  <para style="pi" vid="EZR 6:6">अब हे फरात नदिया के पार के राज्यपाल तत्तनै, हे सतर्बोजनै, तुम अपने मदत करन बारे महानद के पार के अपार्सकियन।</para>
  <para style="pi" vid="EZR 6:6">हुँआँ के मंदिर से दूर रहबौ <verse eid="EZR 6:6" /><verse number="7" style="v" sid="EZR 6:7" />और परमेस्वर के बौ भवन के काम कै रहन दियौ; यहूदिन को सासक और यहूदिन के पुरनिया परमेस्वर के बौ भवन कै बहे के जघा मैं बनामैं। <verse eid="EZR 6:7" /><verse number="8" style="v" sid="EZR 6:8" />बल्किन मैं आग्या देथौं कि तुमकै यहूदिन के बे पुरनियन से ऐसो बर्ताव करने होगे, कि परमेस्वर को बौ भवन बनाओ जाए; मतलब राजा के धन मैं से, फरात नदिया के पार के कर मैं से, बे लोगन कै फुर्ती के संग खर्चा दौ जाबै; ऐसो ना होबै कि उनकै रुकने पड़ै। <verse eid="EZR 6:8" /><verse number="9" style="v" sid="EZR 6:9" />का बरधा! का मेढ़ा! का मेम्ना! स्वर्ग के परमेस्वर के होमबलियन के ताहीं जो जो चीजन को उनकै चाहिए, और जितनो गेहूँ, नून, दाखमधु, और तेल यरूसलेम के पुजारी कहमैं, बौ सब उनकै बिना भूल-चूक हर दिन दौ जाबै। <verse eid="EZR 6:9" /><verse number="10" style="v" sid="EZR 6:10" />इसलै कि बे स्वर्ग के परमेस्वर कै सुखदायक महाखनबारी बलि चढ़ाएकै, राजा और राजकुमारन के अच्छी जिंदगी के ताहीं प्रार्थना करे करैं। <verse eid="EZR 6:10" /><verse number="11" style="v" sid="EZR 6:11" />फिर मैं आग्या दौ, कि जो कोई जौ आग्या टालै, बाके घर मैं से कड़ी निकारी जाबै, और बाके ऊपर बौ खुद चढ़ाएकै जकड़ो जाबै, और बाको घर जौ गुनाह के बजह से मांद बनाओ जाए। <verse eid="EZR 6:11" /><verse number="12" style="v" sid="EZR 6:12" />परमेस्वर जो हुँआँ अपने नाओं की रहन बारी जघा ठहराई रहै, बौ का राजा का प्रजा, बे सबन कै जो जौ आग्या टालन और परमेस्वर के भवन कै जो यरूसलेम मैं है, नास करन के ताहीं हात बढ़ामैं, नास करै। मैं दारा जौ आग्या दौ हौं फुर्ती से ऐसोई करियो।<verse eid="EZR 6:12" /></para>
  <para style="s">भवन समर्पित</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13" />तौ फरात नदिया के जौ पाँजर के राज्यपाल तत्तनै और सतर्बोजनै और उनकै मदत करन बारे, दारा राजा चिट्ठी भेजन के बजह से, बहे के हिसाब से फुर्ती से काम करीं। <verse eid="EZR 6:13" /><verse number="14" style="v" sid="EZR 6:14" />तौ यहूदी नेता, हाग्गै नबी और इद्दो को धुईतो जकर्याह नबी के नबूवत करन से भवन बनात रहे, और सफल भी हुई गै। बे इस्राएल के परमेस्वर की आग्या के हिसाब से और फारस को राजा कुस्रू, दारा, और अर्तछत्र की आग्यन के हिसाब से बनाते बाकै पूरो कर दईं। <verse eid="EZR 6:14" /><verse number="15" style="v" sid="EZR 6:15" />ऐसे करकै बौ भवन राजा दारा के राज्य के छठमें साल मैं अदार महेना के तिसरे दिन कै बनकै खतम भौ। <verse eid="EZR 6:15" /><verse number="16" style="v" sid="EZR 6:16" />इस्राएली, मतलब पुजारी, लेवी और दुसरे जितने बँधुवाई से आए रहैं बे परमेस्वर के बौ भवन समर्पित को त्योहार, खुसी के संग मनाईं। <verse eid="EZR 6:16" /><verse number="17" style="v" sid="EZR 6:17" />बौ भवन समर्पित मैं बे एक सौ पसु, और दुई सौ भेंड़, और चार सौ मेम्ना, और फिर सब इस्राएल निमित्त पापबलि करकै इस्राएल के गोत्रन कि गिनती के हिसाब से बाहरै बकरा कै चढ़ाईं। <verse eid="EZR 6:17" /><verse number="18" style="v" sid="EZR 6:18" />तौ जैसो मूसा की किताब मैं लिखो है, बैसिये बे परमेस्वर की आराधना के ताहीं जो यरूसलेम मैं है, बारी से पुजारिन और दल के लेवियन कै ठहराई दई।<verse eid="EZR 6:18" /></para>
  <para style="s">फसह को त्योहार</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19" />फसह को त्योहार फिर पहले महेना के चौदहमें दिन बँधुवाई से आए भै लोग फसह त्योहार मानाईं। <verse eid="EZR 6:19" /><verse number="20" style="v" sid="EZR 6:20" />काहैकि पुजारी और लेवी एक मन हुईकै, अपने कै सुद्ध करीं; जौ बजह से बे सब के सब सुद्ध रहैं। बे बँधुवाई से आए भै सब लोगन और अपने भईय्या पुजारिन के ताहीं और अपने ताहीं फसह मैं पसुबलि चढ़ाईं। <verse eid="EZR 6:20" /><verse number="21" style="v" sid="EZR 6:21" />तौ बँधुआई से लौटे भै इस्राएली और जितने और देस की दुसरी जाति असुद्धता से इसलै अलग हुई गै रहैं कि इस्राएल के परमेस्वर प्रभु परमेस्वर की खोज करैं, बे सब मिलकै खानु खाईं। <verse eid="EZR 6:21" /><verse number="22" style="v" sid="EZR 6:22" />बे अखमीरी रोटी को त्योहार सात दिन ले खुसी के संग मनाते रहे; काहैकि प्रभु परमेस्वर उनकै खुसी दई रहै, और अस्सूर के राजा को मन उनके घाँईं ऐसो फेर दई कि बौ परमेस्वर मतलब इस्राएल के परमेस्वर के भवन के काम मैं उनकी मदत करै।<verse eid="EZR 6:22" /></para>
  <chapter eid="EZR 6" />
  <chapter number="7" style="c" sid="EZR 7" />
  <para style="s">एज्रा को यरूसलेम मैं भेजो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1" />जे बातन के बाद मतलब फारस के राजा अर्तछत्र के दिनन मैं, एज्रा बेबीलोन से यरूसलेम कै गौ। बौ सरायाह अजर्याह को लौड़ा रहै, अजर्याह हिल्किय्याह को, <verse eid="EZR 7:1" /><verse number="2" style="v" sid="EZR 7:2" />हिल्किय्याह सल्लूम को, सल्लूम सादोक को, सादोक अहीतूब को, <verse eid="EZR 7:2" /><verse number="3" style="v" sid="EZR 7:3" />अहीतूब अमर्याह को, अमर्याह अजर्याह को, अजर्याह मरायोत को, <verse eid="EZR 7:3" /><verse number="4" style="v" sid="EZR 7:4" />मरायोत जरह्याह को, जरह्याह उज्जी को, उज्जी बुक्की को, <verse eid="EZR 7:4" /><verse number="5" style="v" sid="EZR 7:5" />बुक्की अबीसू को, अबीसू पीनहास को, पीनहास एलीआजर को और एलीआजर हारून बड़े पुजारी को लौड़ा रहै।<verse eid="EZR 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 7:6" />जहे एज्रा मूसा की व्यवस्था, जोकै बेबीलोन को परमेस्वर प्रभु परमेस्वर दई रहै, जो निपुड़ यहूदि नियम को सिक्छक रहै। बाके इस्राएल को प्रभु परमेस्वर की कृपादृस्टि जो बाके ऊपर रही, जाके बजह से राजा बाकै मोहों माँगो वर दै दई। <verse eid="EZR 7:6" /><verse number="7" style="v" sid="EZR 7:7" />कुछ इस्राएली, और पुजारी, लेवी, गबईय्यन, और द्वारपाल, और मंदिर के सेवकन मैं से कुछ लोग अर्तछत्र राजा के सातमें साल मैं यरूसलेम कै गै। <verse eid="EZR 7:7" /><verse number="8" style="v" sid="EZR 7:8" />बौ राजा के सातमें साल के पाँचमें महेना मैं यरूसलेम कै पौहोंचो। <verse eid="EZR 7:8" /><verse number="9" style="v" sid="EZR 7:9" />पहले महेना के पहले दिन बौ बेबीलोन से यात्रा कै चल दई, और बाके परमेस्वर की कृपादृस्टि बाके ऊपर रही, जौ बजह से पाँचमें महेना के पहले दिन बौ यरूसलेम कै पौहोंचो। <verse eid="EZR 7:9" /><verse number="10" style="v" sid="EZR 7:10" />काहैकि एज्रा प्रभु परमेस्वर की व्यवस्था को मतलब जान लेन, और बाके हिसाब से चलन, और इस्राएल मैं विधि और नियम सिखान के ताहीं अपनो मन लगाई रहै।<verse eid="EZR 7:10" /></para>
  <para style="s">राजा अर्तछत्र एज्रा कै चिट्ठी दई</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11" />जो चिट्ठी राजा अर्तछत्र एज्रा पुजारी और यहूदि नियम के सिक्छक कै दई रहै जो प्रभु परमेस्वर की आग्यन के बचन को, और बाकी इस्राएलियन मैं चलाई भई विधियन को यहूदि नियम को सिक्छक रहै, बाकी नकल जौ है;<verse eid="EZR 7:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="EZR 7:12" />एज्रा पुजारी के नाओं जो स्वर्ग के परमेस्वर की व्यवस्था को पूरो यहूदि नियम को सिक्छक है, अर्तछत्र राजा के घाँईं से।<verse eid="EZR 7:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="EZR 7:13" />मैं जौ आग्या देथौं, कि मेरे राज्य मैं जितने इस्राएली और उनके पुजारी और लेवी अपनी इच्छा से यरूसलेम जानो चाहें, बे तेरे संग जाए सकथैं।<verse eid="EZR 7:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="EZR 7:14" />तैं तौ राजा और बाके सातौ मंत्री के घाँईं से जौ बजह से भेजो जाथै, कि अपने परमेस्वर की व्यवस्था के बारे मैं जो तेरे पास है, यहूदा और यरूसलेम की हालत जान ले। <verse eid="EZR 7:14" /><verse number="15" style="v" sid="EZR 7:15" />और जो चाँदी - सोना, राजा और बाके मंत्री इस्राएल के परमेस्वर कै जोकी रहन बारी जघा यरूसलेम मैं है, अपनी मर्जी से दई है, <verse eid="EZR 7:15" /><verse number="16" style="v" sid="EZR 7:16" />और जितनो सोना-चाँदी पूरे बेबीलोन देस मैं तोकै मिलैगो, और जो कुछ लोग और पुजारी अपनी इच्छा से अपने परमेस्वर के भवन के ताहीं जो यरूसलेम मैं है देंगे, बाकै लै जाबै।<verse eid="EZR 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 7:17" />जौ बजह से तैं बौ रुपईय्यन से फुर्ती के संग पसु, मेढ़ा और मेम्ना बाके योग्य अन्नबलि और अर्घ की चीजन समेत मोल लैकै और बाकै वेदी मैं चढ़ईये, जो तुमरे परमेस्वर के यरूसलेम बारे भवन मैं है। <verse eid="EZR 7:17" /><verse number="18" style="v" sid="EZR 7:18" />जो चाँदी - सोनो बचो रहबै, बासे जो कछु तोकै और तेरे भईय्यन कै सई जान पड़ै, बहे अपने परमेस्वर की इच्छा के हिसाब से करिये। <verse eid="EZR 7:18" /><verse number="19" style="v" sid="EZR 7:19" />तेरे परमेस्वर के भवन की उपासना के ताहीं जो बर्तन तोकै सौंपे जाथैं, उन्हैं यरूसलेम के परमेस्वर अग्गु दै दिये। <verse eid="EZR 7:19" /><verse number="20" style="v" sid="EZR 7:20" />इनसे जाधे जो कछु तोकै अपने परमेस्वर के भवन के ताहीं जरूरी जानकै देन पड़ै, बौ राज खजाने मैं से दै दिये।<verse eid="EZR 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 7:21" />मैं अर्तछत्र राजा जौ आग्या देथौं, कि तुम महानद के पार के सब खजांचिन से जो कुछ एज्रा पुजारी, जो स्वर्ग के परमेस्वर की व्यवस्था को यहूदि नियम को सिक्छक है, तुम लोगन से चाहबै, बौ फुर्ती के संग करो जाबै। <verse eid="EZR 7:21" /><verse number="22" style="v" sid="EZR 7:22" />मतलब सौ किक्कार ले चाँदी, सौ कोर ले गेहूँ, सौ बत ले दाखमधु, सौ बत ले तेल, और नून जितनो चाहईये उतनो दौ जाबै। <verse eid="EZR 7:22" /><verse number="23" style="v" sid="EZR 7:23" />जो जो आग्या स्वर्ग के परमेस्वर के घाँईं से मिलै, ठीक बहे के हिसाब से स्वर्ग के परमेस्वर के भवन के ताहीं करो जाबै, राजा और राजकुमारन के राज्य मैं परमेस्वर को गुस्सा काहे भड़कन पाबै। <verse eid="EZR 7:23" /><verse number="24" style="v" sid="EZR 7:24" />फिर हम तुमकै चिताए देथैं, कि परमेस्वर के बौ भवन के कोई पुजारी, लेवी, गबईय्या, द्वारपाल, नतीनया और कोई सेवक से कर, चुंगी, और राहदारी लेन की आग्या ना है।<verse eid="EZR 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 7:25" />फिर हे एज्रा! “तेरे परमेस्वर से मिली भई बुद्धि के हिसाब से जो तेरे मैं है, न्यायिन और बिचार करनबारेन कै ठहराएकै जो फरात नदिया के पार रहन बारे बे सब लोगन मैं जो तेरे परमेस्वर की व्यवस्था जानत होमैं, न्याय करे करैं; और जो-जो उनकै ना जानत होमैं, उनकै तुम सिखाए करे करौ। <verse eid="EZR 7:25" /><verse number="26" style="v" sid="EZR 7:26" />जो कोई तेरे परमेस्वर की व्यवस्था और राजा की व्यवस्था ना मानै, बाकै फुर्ती से दंड दौ जाबै, चाहे प्राड़दंड, चाहे देस निकाला, चाहे माल जप्त करो जानो, चाहे कैद करनो।”<verse eid="EZR 7:26" /></para>
  <para style="s">एज्रा परमेस्वर की स्तुति करथै</para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27" />एज्रा के जरिये परमेस्वर की स्तुति धन्य है हमरे पितरन को परमेस्वर प्रभु परमेस्वर, जो ऐसी मनसा राजा के मन मैं पैदा करी है, कि यरूसलेम स्थित प्रभु परमेस्वर के भवन कै समारै। <verse eid="EZR 7:27" /><verse number="28" style="v" sid="EZR 7:28" />और मेरे ऊपर राजा और बाके मंत्रिन और राजा के सब बड़े वैधन कै दयालु करी। मेरे परमेस्वर प्रभु परमेस्वर की कृपादृस्टि जो मेरे ऊपर भई, जाके हिसाब से मैं हियाब भाँदो, और इस्राएल मैं से खास लोगन कै इखट्टो करो, कि बे मेरे संग चलैं।<verse eid="EZR 7:28" /></para>
  <chapter eid="EZR 7" />
  <chapter number="8" style="c" sid="EZR 8" />
  <para style="s">एज्रा के सहयोगी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1" />उनके पूर्वजन के घराने के मुख्य लोग जे हैं, और जो लोग राजा अर्तछत्र के राज्य मैं बेबीलोन से मेरे संग यरूसलेम कै गै उनकी वंसावली जौ है:<verse eid="EZR 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EZR 8:2" />मतलब पीनहास के वंस मैं से गेर्सोम, ईतामार के वंस मैं से दानिय्येल, दाऊद के वंस मैं से हत्तूस,<verse eid="EZR 8:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="EZR 8:3" />सकन्याह के वंस के परोस के गोत्र मैं से जकर्याह, जोके संग डेढ़ सौ लोगन की वंसावली भई।<verse eid="EZR 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZR 8:4" />पहत्मोआब के वंस मैं से जरह्याह को लौड़ा एल्यहोएनै, जोके संग दुई सौ लोग रहैं।<verse eid="EZR 8:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="EZR 8:5" />सकन्याह के वंस मैं से यहजीएल को लौड़ा, जोके संग तीन सौ लोग रहैं।<verse eid="EZR 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZR 8:6" />आदीन के वंस मैं से योनातान को लौड़ा एबेद, जोके संग पचास लोग रहैं।<verse eid="EZR 8:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="EZR 8:7" />एलाम के वंस मैं से अतल्याह को लौड़ा यसायाह, जोके संग सत्तर लोग रहैं।<verse eid="EZR 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZR 8:8" />सपत्याह के वंस मैं से मीकाएल को लौड़ा जबद्याह, जोके संग अस्सी लोग रहैं।<verse eid="EZR 8:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="EZR 8:9" />योआब वंस से यहीएल को लौड़ा ओबघाह, जो के संग दुई सौ अठ्ठारह लोग रहै।<verse eid="EZR 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZR 8:10" />सलोमीत के वंस मैं से योसिव्याह को लौड़ा, जोके संग एक सौ साठ लोग रहैं।<verse eid="EZR 8:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="EZR 8:11" />बेबै के वंस मैं से बेबै को लौड़ा जकर्याह, जोके संग अट्ठाईस लोग रहैं।<verse eid="EZR 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZR 8:12" />अजगाद के वंस मैं से हक्कातान को लौड़ा योहानान, जोके संग एक सौ दस लोग रहैं।<verse eid="EZR 8:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="EZR 8:13" />अदोनीकाम के वंस मैं से जो पच्छू गै उनके जे नाओं हैं: मतलब एलीपेलेत, यीएल, और समायाह, और उनके संग साठ लोग रहैं।<verse eid="EZR 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZR 8:14" />और बिगवै के वंस मैं से उतै और जब्बूद रहैं, और उनके संग सत्तर लोग रहैं।<verse eid="EZR 8:14" /></para>
  <para style="s">एज्रा भवन के ताहीं लेवियन कै ढूँड़ी</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15" />मैं सेवाकार्य के ताहीं लेवी इनकै मैं बौ नदिया के झोने जो अहवा के घाँईं बहथै, इकट्टो कर लौ, और हुँआँ हम लोग बौ जघा मैं तीन दिन डेरा डारे रखाए, और मैं हुँआँ लोगन और पुजारिन कै देख लौ, पर कोई लेवी कै ना पाओ। <verse eid="EZR 8:15" /><verse number="16" style="v" sid="EZR 8:16" />मैं एलीआजर, अरीएल, समायाह, एलनातान, यारीब, एलनातान, नातान, जकर्याह और मसुल्लाम नाओं के जो मुख्य लोग रहैं, और योयारीब और एलनातान कै जो दुई सिक्छक जो समझदार रहैं, उनकै बुलाओ। <verse eid="EZR 8:16" /><verse number="17" style="v" sid="EZR 8:17" />इद्दो के झोने जो कासिप्या नाओं की जघा को प्रधान रहै, भेज दौ; और उनकै समझाए दौ कि कासिप्या जघा मैं इद्दो और बाके भईय्या नतीन लोगन से का का कहने है ताकि बे हमरे झोने परमेस्वर के भवन के ताहीं सेवा टहल करन बारेन कै लै आमैं। <verse eid="EZR 8:17" /><verse number="18" style="v" sid="EZR 8:18" />हमारे परमेस्वर की कृपादृस्टि जो हमरे ऊपर भई बाके हिसाब से बे हमरे झोने ईस्सेकेल कै जो इस्राएल के धुईते और लेवी के धुईते महली के वंस मैं से रहै, और सेरेब्याह कै और बाके लौड़न और भईय्यन कै, मतलब अठ्ठारह जनिन कै; <verse eid="EZR 8:18" /><verse number="19" style="v" sid="EZR 8:19" />और हसब्याह कै, और बाके संग मरारी के वंस मैं से यसायाह कै, और बाके लौड़न और भईय्यन कै, मतलब बीस जनिन कै; <verse eid="EZR 8:19" /><verse number="20" style="v" sid="EZR 8:20" />और नतीन लोगन मैं से जिनकै दाऊद और बैध पुजारियन की सेवा करन ताहीं ठहराई रहै, दुई सौ बीस नतीन लोगन कै लै आए। जे सबन के नाओं लिखे पड़े रहैं।<verse eid="EZR 8:20" /></para>
  <para style="s">उपवास और प्रार्थना</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21" />तौ मैं हुँआँ मतलब अहवा नदिया के किनारे बर्त को प्रचार जौ उम्मीद से करो कि हम परमेस्वर के अग्गु दीन होमैं; और बासे अपने और अपने बाल-बच्चन और अपनी पूरी संपत्ति के ताहीं सफल यात्रा माँगैं। <verse eid="EZR 8:21" /><verse number="22" style="v" sid="EZR 8:22" />काहैकि मैं रास्ता के दुस्मनन से बचन के ताहीं सिपईय्यन को दल और सवार, राजा से माँगन मैं सर्मात रहौं, काहैकि हम राजा से जौ कह चुके रहैं, हमरो परमेस्वर अपने सब खोजिन पर, भलाई के ताहीं कृपादृस्टि रखथै और जो बाकै छोड़ देथैं, बाको बल और कोप उनके खिलाप है। <verse eid="EZR 8:22" /><verse number="23" style="v" sid="EZR 8:23" />जहे बारे मैं हम बर्त रखकै अपने परमेस्वर से प्रार्थना करे, और बौ हमरी सुनी।<verse eid="EZR 8:23" /></para>
  <para style="s">भवन के लिए उपहार</para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24" />तौ मैं मुख्य पुजारिन मैं से बाहरै लोगन कै, मतलब सेरेब्याह, हसब्याह और जाके दस भईय्यन कै अलग करकै, जो चाँदी सोनो और बर्तन, <verse eid="EZR 8:24" /><verse number="25" style="v" sid="EZR 8:25" />राजा और बाके मंत्रिन और बाके वैधन और जितने इस्राएली मौजूद रहैं बे हमरे परमेस्वर के भवन के ताहीं चाँदी, सोना और बर्तन, भेंट के रूप मैं तौलकै उनकै दईं। <verse eid="EZR 8:25" /><verse number="26" style="v" sid="EZR 8:26" />मैं उनके हात मैं</para>
  <para style="q1" vid="EZR 8:26">साढ़े छै सौ किक्कार चाँदी, सौ किक्कार चाँदी के बर्तन, सौ किक्कार सोना,<verse eid="EZR 8:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="EZR 8:27" />हजार दर्कमोन सोनो के बीस कटोरा, और सोनो सरीखा अनमोल चमकन बारे पीतल दुई बर्तन तौलकै दै दौ।<verse eid="EZR 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28" />मैं उनसे कहो, तुम तौ प्रभु परमेस्वर के ताहीं पवित्र हौ, और जे बर्तन भी पवित्र हैं; और जौ चाँदी और सोना भेंट को है, जो तुमरे पितरन के परमेस्वर प्रभु परमेस्वर के ताहीं खुसी से दई गई। <verse eid="EZR 8:28" /><verse number="29" style="v" sid="EZR 8:29" />जौ बजह से जगत रहबौ, और जबले तुम इन्हैं यरूसलेम मैं प्रधान पुजारिन और लेवियन और इस्राएल के पितरन के घराने के प्रधानन के अग्गु प्रभु परमेस्वर के भवन की कुठरियन मैं तौलकै ना दियौ, तौ ले इनकी रक्छा करत रहबौ। <verse eid="EZR 8:29" /><verse number="30" style="v" sid="EZR 8:30" />तौ पुजारी और लेवी चाँदी, सोना, और बर्तनन कै तौलकै लै लई कि उनकै यरूसलेम कै हमारे परमेस्वर के भवन मैं पहोंचाबै।<verse eid="EZR 8:30" /></para>
  <para style="s">यरूसलेम मैं वापसी</para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31" />पहले महेना के बाहरमें दिन हम अहवा नदिया से कूच करकै यरूसलेम को रास्ता लै, और हमारे परमेस्वर की कृपादृस्टि हमरे ऊपर रही; और बौ हमकै दुस्मन और रास्ता मैं घात लगान बारेन के हात से बचाई। <verse eid="EZR 8:31" /><verse number="32" style="v" sid="EZR 8:32" />आखरी मैं हम यरूसलेम पौहोंचे और हुँआँ तीन दिन रहे। <verse eid="EZR 8:32" /><verse number="33" style="v" sid="EZR 8:33" />फिर चौथे दिन बौ चाँदी - सोना और बर्तन हमरे परमेस्वर के भवन मैं ऊरिय्याह के लौड़ा मरेमोत पुजारी के हात मैं तौलकै दै गै। बाके संग पीनहास को लौड़ा एलीआजर रहै, और उनके संग ईसु को लौड़ा योजाबाद लेवी और बिन्नूई को लौड़ा नोअद्याह लेवी रहै। <verse eid="EZR 8:33" /><verse number="34" style="v" sid="EZR 8:34" />बे सब चीज गिनी और तौली गईं, और उनको तौल बहे समय लिखो गौ।<verse eid="EZR 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35" />जो बँधुआई से आए रहैं, बे इस्राएल के परमेस्वर के ताहीं होमबलि चढ़ाई; मतलब सब इस्राएल के निमित्त बाहरै बरधा, छियानबे भेंड़ और सत्तर मेम्ना, और पापबलि के ताहीं बाहरै बकरा; जौ सब प्रभु परमेस्वर के ताहीं होमबलि रहै। <verse eid="EZR 8:35" /><verse number="36" style="v" sid="EZR 8:36" />तौ बे राजा कि आग्यन कै महानद के जौ पार अधिकारियन और सासकन कै दईं; और बे इस्राएली लोगन और परमेस्वर के भवन के काम मैं मदत करीं।<verse eid="EZR 8:36" /></para>
  <chapter eid="EZR 8" />
  <chapter number="9" style="c" sid="EZR 9" />
  <para style="s">गैर-यहूदियन के संग बिहा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1" />जब जे काम ही चुके, तौ बड़ो अधिकारी झोने आएकै कहन लागो, न तौ इस्राएली लोग न पुजारी न लेवी जौ घाँईं के देस के लोगन से अलग भै; पर उनके जैसी मतलब कनानी, हित्ती, परिज्जी, यबूसी, अम्मोनी, मोआबी, मिस्री और एमोरि के तराहनी घिनौनो काम करथैं। <verse eid="EZR 9:1" /><verse number="2" style="v" sid="EZR 9:2" />काहैकि बे पुजारियन कि लौड़ियन मै से अपने लौड़न के ताहीं बईय्यर बनाए लईं हैं; और पवित्र वंस जौ घाँईं के देस के लोगन मै मिल गौ है। और हाकिम और सरदार जौ विस्वासघात मैं सबसे अग्गु हैं। <verse eid="EZR 9:2" /><verse number="3" style="v" sid="EZR 9:3" />जौ बात सुनकै मैं अपने लत्ता और चोंगा कै फाड़ो, और अपनी मुड़िया और दाढ़ी के बार नोचो, और चाहचीते ही कै बैठो रहो।<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">मत्ती 26:65; अय्यूब 1:20</char></note> <verse eid="EZR 9:3" /><verse number="4" style="v" sid="EZR 9:4" />तौ जित्ते लोग इस्राएल के परमेस्वर के बचन सुनकै गुलामी से आए भै, लोगन के विस्वासघात की बजह से कपकपात रहैं, बे सब मेरे झोने जुराने, और मैं संजा की भेंट के समय ले सहमौं भौ बैठो रहो।<verse eid="EZR 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5" />पर संजा की भेंट के समय मैं फटे भै लत्ता और बागा फाड़े भै उपवास की दसा मैं उठो, फिर घूँटेन के बल लोहोको, और अपने हात अपने परमेस्वर प्रभु परमेस्वर के घाँईं फैलाएकै कहो। <verse eid="EZR 9:5" /><verse number="6" style="v" sid="EZR 9:6" />हे मेरे परमेस्वर! मोकै तेरे घाँईं अपनो मोहों उठता भई सरम आथै, और हे मेरे परमेस्वर! मेरो मोहों कारो है; काहैकि हम लोगन के अधर्म के काम हमरी मुड़िया ऊपर बढ़ गै हैं, और हमरो दोस बढ़ते आसमान ले पहोंच गौ है।<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">दानिय्येल 9:7,8</char></note> <verse eid="EZR 9:6" /><verse number="7" style="v" sid="EZR 9:7" />अपने पुरखन के दिनन से लैकै आज के दिन ले हम बड़े दोसी हैं, और अपने अधर्म के कामन के बजह से हम अपने राजा और पुजारिन समेत देस के राजन के हात मैं करे गै तलवार, गुलामी, लूटे जान, और मोहों कारो हुई जान की विपत्तियन मैं पड़े, जैसे कि आज हमरी दसा है। <verse eid="EZR 9:7" /><verse number="8" style="v" sid="EZR 9:8" />पर अब थोड़ी दिन से हमरे प्रभु परमेस्वर को अनुग्रह हमरे ऊपर भौ है, कि हम मैं से कोई बच निकरै, और हमकै बाकी पवित्र जघा मैं एक खुटी मिलै, और हमरो परमेस्वर हमरी प्रार्थना से आँखिन मैं जोती आन दियै, और गुलामी मैं हमकै कुछ आराम दियै। <verse eid="EZR 9:8" /><verse number="9" style="v" sid="EZR 9:9" />हम दास तौ हँईंये, पर हमरे गुलामी मैं हमरो परमेस्वर हमकै ना छोड़ी, काहैकि फारस को राजा हमरे ऊपर ऐसी कृपा करी, कि हम नई जिंदगी पाएकै अपने परमेस्वर के भवन कै उठान, और जाके खंडरन कै सुधार पाए, और हमैं यहूदा और यरूसलेम मैं आड़ मिली।<verse eid="EZR 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 9:10" />अब हे हमरे परमेस्वर, जाके बाद मै हम का कहमैं, जहे कि हम तेरी बे आग्यन कै तोड़ दै हैं,<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">दानिय्येल 9:5,10,11</char></note> <verse eid="EZR 9:10" /><verse number="11" style="v" sid="EZR 9:11" />जो तू जौ कह कै अपने दास भविस्यवक्तन के जरिया दईं , जो देस के अधिकारी बनन कै तुम जाए रै हौ, बौ तौ देस के लोगन की असुद्धता के बजह से और उनके घिनौने कामन के बजह से असुद्ध देस है, बे बाकै एक सीमा से दुसरी सीमा ले अपनी असुद्धता से भर दई हैं। <verse eid="EZR 9:11" /><verse number="12" style="v" sid="EZR 9:12" />बे हमैं बताईं कि अगर हम बौ जमीन को मजा लेनो चाहथैं, और बाकै अपने वंसजन कै हमेसा के ताहीं सौंपनो चाहथैं, तौ हमैं बे लोगन के संग कहू बिहा ना करनो चाहिए, और ना उनकी समृद्धि या सफलता मैं कहू मदत करनो चाहिए। <verse eid="EZR 9:12" /><verse number="13" style="v" sid="EZR 9:13" />“बौ सब के बाद जो हमरे बुरे कामन और बड़े दोस के बजह से हमरे ऊपर बीतो है, जबकि हे हमरे परमेस्वर, तैं हमरे अधर्म के बराबर हमकै दंड ना दौ, लेकिन हम मैं से कितनेन कै बचाए रखाओ है। <verse eid="EZR 9:13" /><verse number="14" style="v" sid="EZR 9:14" />तौ का हम तेरी आग्यन को फिर से उल्लंघन करकै जे घिनौने काम करनबारे लोगन से समधियानो बारो रिस्ता करैं? का तैं हमरे ऊपर हिंयाँ ले कोप ना करैगो जो से हम मिट जामैं और ना तौ कोई बचै और ना कोई रह जाबै? <verse eid="EZR 9:14" /><verse number="15" style="v" sid="EZR 9:15" />हे इस्राएल के परमेस्वर प्रभु परमेस्वर! तैं धर्मी है, हम बचकै आजाद भै हैं जैसे कि आज हबै हैं। देख, हम तेरे सामने दोसी हैं, जौ बजह से कोई तेरे सामने खड़ो ना रह सकथैं।”<verse eid="EZR 9:15" /></para>
  <chapter eid="EZR 9" />
  <chapter number="10" style="c" sid="EZR 10" />
  <para style="s">मिस्रित बिहा कै खतम करन की योजना</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1" />जब एज्रा परमेस्वर के भवन के अग्गु पड़ो, रोत भई प्रार्थना और पाप को माने करत रहै, तौ इस्राएल मैं से लोग, बईंय्यरन और बालकन की एक भौत बड़ी मंडली बाके झोने इकट्ठी भई; और लोग बिलख-बिलख कै रोत रहैं। <verse eid="EZR 10:1" /><verse number="2" style="v" sid="EZR 10:2" />तौ यहीएल को लौड़ा सकन्याह जो एलाम के वंस को रहै, एज्रा से कहन लगो, “हम लोग जौ देस के लोगन मैं से गैर यहूदी बईंय्यरन बिहाए कै अपने परमेस्वर को विस्वासघात तौ करे हैं, पर जौ हालत मैं भी इस्राएल के ताहीं आसा है। <verse eid="EZR 10:2" /><verse number="3" style="v" sid="EZR 10:3" />अब हम अपने परमेस्वर से जौ वाचा भाँदे, कि हम अपने प्रभु की सम्मति और अपने परमेस्वर की आग्या सुनकै थरथरान बारे की सम्मति के हिसाब से ऐसी सब बईंय्यरन कै और उनके बालकन कै दूर करे; और व्यवस्था के हिसाब से काम करो जाबै। <verse eid="EZR 10:3" /><verse number="4" style="v" sid="EZR 10:4" />तैं उठ, काहैकि जौ काम तेरोई है, और हम तेरे संग हैं; इसलै हियाब भाँदकै जौ काम मैं लगजा।”<verse eid="EZR 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5" />तौ एज्रा उठो, और पुजारिन, लेवियन और सब इस्राएलियन के प्रधानन कै जौ कसम खबाई कि हम जहे बचन के हिसाब से करंगे; और बे बैसिये कसम खाईं। <verse eid="EZR 10:5" /><verse number="6" style="v" sid="EZR 10:6" />तौ एज्रा परमेस्वर के भवन के सामने से उठो, और एल्यासीब के लौड़ा यहोहानान की कोठरी मैं गौ, और हुँआँ पहोंचकै न रोटी खाई, ना पानी पी, काहैकि बौ बँधुआई मैं से निकर आए भै के विस्वासघात के बजह से सोक करत रहो।<verse eid="EZR 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7" />तौ बे यहूदा और यरूसलेम मैं रहनबारे बँधुआई मैं से आए भै सब लोगन मैं जौ प्रचार करबाईं, कि तुम यरूसलेम मैं इकट्टो होबौ; <verse eid="EZR 10:7" /><verse number="8" style="v" sid="EZR 10:8" />और जो कोई बड़े-बूढ़े और पुजारियन अगुवान की सम्मति ना मानैगो और तीन दिन के भीतर ना आगो, बाकी सब धन - सम्पत्ति नास करी जाबैगी और बौ खुद बँधुआई से आए भै की सभा से अलग करो जाबैगे। <verse eid="EZR 10:8" /><verse number="9" style="v" sid="EZR 10:9" />तौ यहूदा और बिन्यामीन के सब इंसान तीन दिन के भीतर यरूसलेम मैं जुराने; जौ नौवे महेना के बीसमें दिन मैं भौ; और सब लोग परमेस्वर के भवन के चौक मैं बौ विसय के बजह से और गजब मेंहें बरसन के बजह से काँपत भई बैठे रहे।<verse eid="EZR 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 10:10" />तौ एज्रा पुजारी ठाड़कै उनसे कहन लगो, तुम लोग सच्चाई की आग्या कै ना मानकै विस्वासघात करकै गैरयहूदी बईय्यर बिहाए लै, और जासे इस्राएल को दोस बढ़ गौ है। <verse eid="EZR 10:10" /><verse number="11" style="v" sid="EZR 10:11" />जौ बजह से अब अपने पितरन के प्रभु परमेस्वर के अग्गु अपनो पाप मान लेयौ, और बाको धन्यवाद करौ बाकी इच्छा पूरी करौ, और जौ देस के लोगन से और गैरयहूदी-बईंय्यरन से अलग हुई जाबौ।<verse eid="EZR 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12" />तौ पूरे समाज के लोग ऊँचे सब्द से कहीं, जैसो तैं कहो है, बैसिये हमैं करनो सई है। <verse eid="EZR 10:12" /><verse number="13" style="v" sid="EZR 10:13" />पर लोग भौत हैं, और मेंहें को समय है, और हम बाहर ना ठाड़े रह सकथैं, और जौ दुई एक दिन को काम ना है, काहैकि हम जौ बात मैं बड़ा अपराध करे हैं। <verse eid="EZR 10:13" /><verse number="14" style="v" sid="EZR 10:14" />पूरी सभाघर के घाँईं से हमरे पुजारियन और वैधन कै नियुक्त करे जामैं; और जब ले हमरे परमेस्वर को भड़को भौ कोप हम से दूर ना होबै, और जौ काम पूरो ना हुई जाबै, तौ ले हमरे नगरन के जितने रहन बारे गैरयहूदी बईय्यरैं बिहाए लई होमैं, बे नियत समय पर आए करैं, और उनके संग एक नगर के बड़े-बूढ़े और न्यायी आमैं। <verse eid="EZR 10:14" /><verse number="15" style="v" sid="EZR 10:15" />जाके खिलाप खाली असाहेल को लौड़ा योनातान और तिकवा को लौड़ा यहजयाह ठाड़े, और मसुल्लाम और सब्बतै लेवी उनकी मदत करीं।<verse eid="EZR 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16" />पर बँधुआई से आए भै लोग बैसोई करीं। तौ एज्रा पुजारी और पितरन के घराने के कितने मुख्य लोग अपने पितरन के घराने के हिसाब से अपने सब नाओं लिखाएकै अलग करे गै, और दसमें महेना के पहले दिन कै जौ बात की तहकीकात के ताहीं बैठे; <verse eid="EZR 10:16" /><verse number="17" style="v" sid="EZR 10:17" />और पहले महेना के पहले दिन ले बे सब लोगन की जाँच पूरी कर लईं, जो गैर-यहूदी - बईंय्यरन से बिहा कर लई रहैं।<verse eid="EZR 10:17" /></para>
  <para style="s">जिन लोगन की बईंय्यरैं विदेसी रहैं</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18" />पुजारिन की औलादन मैं से जे जन पाए गै जो गैरयहूदी - बईंय्यरन से बिहा कर लई रहैं ईसु को लौड़ा, योसादाक को लौड़ा, और बाके भईय्या मासेयाह, एलीआजर, यारीब और गदल्याह। <verse eid="EZR 10:18" /><verse number="19" style="v" sid="EZR 10:19" />जे हात जोड़कै बचन दईं, कि हम अपनी बईंय्यरन कै निकार देंगे, और बे दोसी ठहरकै, अपने दोस के बजह से एक एक भेंड़ा बलि करीं।<verse eid="EZR 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZR 10:20" />इम्मेर की औलाद मैं से हनानी और जबद्याह।<verse eid="EZR 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 10:21" />हारीम की औलाद मैं से मासेयाह, एलीयाह, समायाह, यहीएल और उज्जियाह।<verse eid="EZR 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZR 10:22" />पसहूर की औलाद मैं से एल्योएनै, मासेयाह, इस्माएल, नतनेल, योजाबाद और एलासा।<verse eid="EZR 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 10:23" />फिर लेवियन मैं से योजाबाद, सिमी, केलायाह जो कलीता कहो जात रहै, पतहाह, यहूदा, योजाबाद और एलीआजर।<verse eid="EZR 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 10:24" />गबईय्यन मैं से एल्यासीब; और द्वारपालन मैं से सल्लूम, तेलेम, और ऊरी।<verse eid="EZR 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 10:25" />इस्राएल मैं से परोस की औलाद मैं रम्याह, यिज्जियाह, मल्किय्याह, मिय्यामीन, एलीआजर, मल्किय्याह और बनायाह।<verse eid="EZR 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 10:26" />एलाम की औलाद मैं से मत्तन्याह, जकर्याह, यहीएल, अब्दी, यरेमोत और एलीयाह।<verse eid="EZR 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 10:27" />जत्तू की औलाद मैं से एल्योएनै, एल्यासीब, मत्तन्याह, यरेमोत, जाबाद, और अजीजा।<verse eid="EZR 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 10:28" />बेबै की औलाद मैं से यहोहानान, हनन्याह, जब्बै और अतलै।<verse eid="EZR 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZR 10:29" />बानी की औलाद मैं से मसुल्लाम, मल्लूक, अदायाह, यासूब, साल और यरामोत।<verse eid="EZR 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 10:30" />पहत्मोआब की औलाद मैं से अदना, कलाल, बनायाह, मासेयाह, मत्तन्याह, बसलेल, बिन्नूई और मनस्से।<verse eid="EZR 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 10:31" />हारीम की औलाद मैं से एलीआजर, यिस्सियाह, मल्किय्याह, समायाह, सिमोन; <verse eid="EZR 10:31" /><verse number="32" style="v" sid="EZR 10:32" />बिन्यामीन, मल्लूक और समर्याह।<verse eid="EZR 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 10:33" />हासूम की औलाद मैं से मत्तनै, मत्तत्ताह, जाबाद, एलीपेलेत, यरेमै, मनस्से, और सिमी।<verse eid="EZR 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="EZR 10:34" />बानी की औलाद मैं से मादै, अम्राम, ऊएल; <verse eid="EZR 10:34" /><verse number="35" style="v" sid="EZR 10:35" />बनायाह, बेदयाह, कलूही; <verse eid="EZR 10:35" /><verse number="36" style="v" sid="EZR 10:36" />बन्याह, मरेमोत, एल्यासीब; <verse eid="EZR 10:36" /><verse number="37" style="v" sid="EZR 10:37" />मत्तन्याह, मत्तनै, यासू;<verse eid="EZR 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="EZR 10:38" />बानी, बिन्नूई, सिमी; <verse eid="EZR 10:38" /><verse number="39" style="v" sid="EZR 10:39" />सेलेम्याह, नातान, अदायाह; <verse eid="EZR 10:39" /><verse number="40" style="v" sid="EZR 10:40" />मक्नदबै, सासै, सारै; <verse eid="EZR 10:40" /><verse number="41" style="v" sid="EZR 10:41" />अजरेल, सेलेम्याह, समर्याह; <verse eid="EZR 10:41" /><verse number="42" style="v" sid="EZR 10:42" />सल्लूम, अमर्याह और योसेफ।<verse eid="EZR 10:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 10:43" />नेबो की औलाद मैं से यीएल, मत्तित्याह, जाबाद, जबीना, यद्दो, योएल, और बनायाह।<verse eid="EZR 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44" />जे सब गैरयहूदी बईंय्यरन से बिहा करी रहैं, और भौतन की बईंय्यरन से लौड़ा भी पैदा भै रहैं।<verse eid="EZR 10:44" /></para>
  <chapter eid="EZR 10" />
</usx>