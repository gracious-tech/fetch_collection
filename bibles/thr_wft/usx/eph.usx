<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Rana Tharu</book>
  <para style="h">इफिसियों</para>
  <para style="toc3">इफिसियों</para>
  <para style="toc2">इफिसियों</para>
  <para style="toc1">इफिसियों कै लिखी भइ पौलुस की चिट्ठी</para>
  <para style="mt2">इफिसियों को लिखी हुई पौलुस की चिट्ठी</para>
  <para style="mt1">इफिसियों कै लिखी भइ पौलुस की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">इफिसियों सहर कै चिट्ठी बहे समय के आस-पास लिखी गई रहै जब ईसु मसीह के पैदा होन के 60 साल बाद कुलुसियन कै चिट्ठी लिखी गई रहै। लेखक खुदकै प्रेरित पौलुस के रूप मैं पहचानथै <char style="xt"><ref loc="EPH 1:1">1:1</ref></char>। जाधेतर विद्वान जौ बात से सहमत हैं कि पौलुस कै इफिसियों की पत्‌री मैं कुलुसियन की पत्‌री की बराबरी मैं मिलन बारे निजी बधाई की कमी होगी। ऐसो लगथै कि पौलुस ही लिखी है। जहे बजह से जाकै देस की निरी कलीसियन मैं फैलान को इरादा करो गौ होगो। पौलुस जहो के बारे मैं बताई है कि जब बौ चिट्ठी और लिखी रहै तौ बौ कैदखाना मैं रहै <char style="xt"><ref loc="EPH 3:1">3:1</ref></char>,<char style="xt"><ref loc="EPH 4:1">4:1</ref></char>,<char style="xt"><ref loc="EPH 6:20">6:20</ref></char>। पौलुस तीतुस के हाथ चिट्ठी भेजी जब बौ इफिसुस जात रहै<char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref></char>। इफिसुस सहर आसिया प्रांत को बड़ो सहर और रोमी राजधानी रहै, इफिसुस अपने मंदिर के ताहीं जानो जात रहै जो ग्रीक देवी आर्टेमिस कै समर्पित रहै<char style="xt"><ref loc="ACT 19:23-31">प्रेरितो 19:23-31</ref></char>। इफिसुस की कलीसिया एक मजबूत सुरुवात करी रहै, लेकिन बाद मैं कमजोर हुई गई <char style="xt"><ref loc="REV 2:1-7">प्रकासितवाक्य 2:1-7</ref></char>। पौलुस जौ चिट्ठी के पहले भाग मैं बताई है कि कैसे परमेस्वर अपने लोगन कै चुनी है और उनकै ईसु मसीह के जरिया उन्हईं के पापन से बचाई है। कलीसिया की बराबरी एक सरीर के संग करी गई है जोको मूड़ मसीह है एक इमारत के समान है जोको कोहने को पथरा मसीह है। किताब के दुसरे हिस्सा मैं पौलुस मसीह जिंदगी जीन के बारे मैं कहथै।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस अपनो परिचय दई और इफिसियों को स्वागत करी। <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. फिर बौ मसीह के संग जो कलीसिया के संबंध के बारे मैं बताथै। <char style="ior"><ref loc="EPH 1:3-3:21">1:3–3:21</ref></char></para>
  <para style="io1">3. तौ पौलुस लिखी है कि कौन से तरीका से मसीहियन कै जीनो चाहिए। <char style="ior"><ref loc="EPH 4:1-6:20">4:1–6:20</ref></char></para>
  <para style="io1">4. आखरी मैं पौलुस कुछ समापन बात की राय देथै। <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref> </char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:19-21">प्रेरितो 18:19-21</ref>
      </char>
    </note>पौलुस के घाँईं से जो परमेस्वर की मरजी से ईसु मसीह को प्रेरित है, बे पवित्र और ईसु मसीह मैं विस्वासी आदमिन के नाओं जो इफिसुस मैं हैं: जो ईसु मसीह के संग मिलकै अपनी जिंदगी मैं परमेस्वर के जो लोग हैं उनकै लिखी हैं।<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />हमरे परम दऊवा परमेस्वर और प्रभु ईसु मसीह के घाँईं से तुमकै अनुग्रह और सांति मिलथै।<verse eid="EPH 1:2" /></para>
  <para style="s">मसीह मैं सबै तरहन की आत्मिक आसीस</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />हमरे प्रभु ईसु मसीह के परमेस्वर और दऊवा को धन्यवाद होबै कि बौ हमकै मसीह मैं स्वर्गिय जघा मैं कि सबै तराहनी की आत्मिक आसीस दई है। <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />जैसे कि बौ हमकै दुनिया बनन से पहलिये से बामै चुन लई कि हम बाके संग एक होन के बजह से पवित्र और निर्दोस होमैं।<verse eid="EPH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 1:5" />प्रेम के बजह से और अपनी मरजी से, अच्छे मन से हमैं अपने ताहीं पहलिये से बनाई कि ईसु मसीह के जरिया हम बाके <note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">गोदी लै भै</char></note>गोद लै भै बालका होमैं, जहे बाकी खुसी और मरजी रहै। <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />कि बाके बौ दया की महिमा की स्तुति करन के ताहीं, जो बौ हमैं अपने प्रेम मैं आजादी से दई है। <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" /><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">कुलुस्सियों 1:14</ref></char></note>बामै हमकै बाके खून से छुटकारा, मतलब गल्तियन की माफी, बाके बौ अनुग्रह के धन के तराहनी मिलो है, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />जोकै बौ पूरे ग्यान और समझ समेत हमरे ऊपर खूबै करी। <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />काहैकि परमेस्वर बहे करी जो बौ खुदकै ही बनाई रहै, और हमकै बौ लुकी भइ बात कै जताई जो बौ पहलिये से मसीह के जरिया पूरो करन को फैसला लई रहै। <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />की समय के पूरो होन को ऐसो बंदोबस्त होबै कि जो कछु स्वर्ग मैं है और जो कछु पृथ्वी मैं है, सबै कुछ बौ मसीह मैं जोड़ै।<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />सबै कुछ परमेस्वर सोचथै बहे होथै; और परमेस्वर अपने खुद के वजह से हमकै मसीह के संग अपने खुद के लोगन के रूप मैं चुनी, जो बात कै बौ सुरुए से ठान लई रहै। <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />फिरौंकी जो-जो मसीह मैं आस लगाए रहैं, परमेस्वर की महिमा कै करथैं।<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />और बहे मैं तुम्हऊँ, परमेस्वर के बालका बन गै जब तुम सच्चो बचन सुने, जो तुमरे उद्धार को सुसमाचार है और जोके ऊपर तुम बिस्वास करे, और परमेस्वर तुमरे जरिया बौ पवित्र आत्मा जो मालिकाना हक को छाप है देन की ठानी, और जहे ताहीं बौ जौ बात को वादा करी रहै। <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />आत्मा जौ कहथै कि हमकै बौ सब मिलैगो जो परमेस्वर अपने लोगन से वादा करी है, और हमकै जौ बिस्वास दिलाथैं कि परमेस्वर बे आदमिन कै पूरी आजादी देगो जो बाके हैं। हम बाकी महिमा की गामैं।<verse eid="EPH 1:14" /></para>
  <para style="s">पौलुस की प्रार्थना</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />जौ बजह से, जब से मैं प्रभु ईसु मैं तुमरे बिस्वास और परमेस्वर के सबै पवित्र लोगन के ताहीं तुमरे प्रेम के बारे मैं सुनो हौं, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />मैं तुमरे ताहीं परमेस्वर कै धन्यवाद देनो नाय छोड़ो हौं। मैं तुमकै अपनी प्रार्थना मैं याद करत रहथौं। <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />और, कि हमरे प्रभु ईसु मसीह को परमेस्वर जो महिमा को परम दऊवा है, तुमकै ऐसी आत्मा देगो जो तुमकै ग्यानी बनाए और परमेस्वर को प्रगट करे ताकी तुम अच्छे तरह से पहचान सकौ। <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />बौ तुम लोगन के मन की आँखिन कै जोती देबै, जोसे तुम जौ देख सकौ कि बाके जरिये बुलाए जान के बजह से तुम लोगन की आसा कितनी महान है और सन्तन के संग तुम लोगन कै जो बिरासत मिली है, बौ कितनी अदभुत और महिमामय है, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />हम जो बिस्वास रखथै बाकी सक्ति जो हममैं काम कर रइ है बौ कितनी महान है! जौ जो सक्ति जो हममैं काम करथै; बौ बाको महान बल के नाई है। <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />जोकै जरिये बौ मसीह कै मौत से जिंदो करी और बाकै स्वर्गिय जघा मैं अपने दहने और बैठारी।<note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन संहिता 110:1</ref></char></note> <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />हुँआँ मसीह सब स्वर्गिय सासक, अधिकारी, सामर्थ्य और सेठन के ऊपर राज करथै; बाको ऐसो नाओं है बाके पास जौ युग मैं और आनबारी युग मैं अधिकार के सबै खिताब से स्रेस्ठ एक उपाधि है। <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />और सबै कछु बाकी पाँव तरे कर दई;<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन संहिता 8:6</ref>; <ref loc="COL 2:10">कुलुस्सियों 2:10</ref></char></note> और बाकै सबै चीजन ऊपर मूड़ बनाये कै कलीसिया कै दै दई। <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />कलीसिया मसीह की सरीर है, और बहे की भरपूरी है जो सबै मैं सब कछु पूरो करथै।<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">मौत से जिंदगी तक</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:13">कुलुस्सियों 2:13</ref>
      </char>
    </note>बीते भै समय मैं तुम आग्या को उलंघन के बजह से आत्मिक तरीका से पाप मैं मर गै रहौ। <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />बौ समय तू दुनिया की बुरी चाल पर चलो; तैं आकास मैं आध्यात्मिक सक्तियन की आग्या मानो, बौ आत्मा जो अब बे लोगन कै वस मैं करथै जो परमेस्वर के बिरोधिन मैं चलथैं। <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />सच्ची मैं हम सबै उन्हईं के तराहनी रहैं और अपनी सरीर की इच्छा के हानी रहेत रहैं। बहे स्वभाव के मन की इच्छा के अनुसार चलत रहैं और दुसरेन के हानी स्वभाविक रीति से परमेस्वर के क्रोध के सिकार बने भै रहैं।<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />लेकिन परमेस्वर की दया इत्तो जद्धे है, और हमरे ताहीं बाको प्रेम इत्तो महान है, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />कि बौ समय हम अपनी आग्या उलंघन की बजह से मर गै रहैं तौ हमकै मसीह के अनुग्रह से जिंदो करो गौ,<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">अनुग्रह सेई तुमरो उद्धार भौ है</char></note> <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />और मसीह ईसु मैं बाके संग उठाई, और स्वर्गिय जघा मैं बहे के संग बैठाए दई ताकी बाके संग राज्य करन के ताहीं। <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />प्रभु ईसु मसीह मैं हमसे प्रेम करी बौ प्रेम की दया की महानता कितनी है जौ दिखान ताहीं के बौ पूरे आनबारे युग मैं बौ ऐसो करी। <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />काहैकि बिस्वास के अनुग्रह सेई तुमरो उद्धार भौ है; और जौ तुमरे करमन से नाय है, बल्किन परमेस्वर को दान है, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />और ना करमन के बजह से, काहैकि ऐसो नाय होबै कि कोई गुमान करै। <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />परमेस्वर हमकै बौ बनाई है जो हम हैं, और मसीह ईसु के संग हमरे मिलन से बौ हमकै अच्छे करमन की जिंदगी के ताहीं बनाई है, जो बौ हमकै करन के ताहीं पहलिये से समारी।<verse eid="EPH 2:10" /></para>
  <para style="s">मसीह मैं एक</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />तुम जो जनम से गैर यहूदि और खतना<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">खतना बौ है जो मनुस्य के हाथ के जरिये सरीर की करी जाथै</char></note> करे भै यहूदि लोगन के जरिये खतना हीन कहे जाथौ; याद करौ तुम कि बीते दिनन मैं तुम कौन रहौ, <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />बौ समय तुम मसीह से अलग रहौ, तुम दुसरे देस के रहौ और परमेस्वर के चुने भै इस्राएली आदमिन से जुड़े भै ना रहौ। जो वादा को वाचा परमेस्वर बाके लोगन के संग करी रहै बामै तुमरो कोई भी हिस्सा नाय रहै, तुम ऐसी दुनिया मैं रहत रहौ जो आसाहीन और परमेस्वर हीन रहै। <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />लेकिन अब, मसीह ईसु के संग, जोसे तुम निरी दूर रहेत रहौ, तुमकै मसीह के खून के झोने लाओ गौ है। <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />ईसु मसीह खुद यहूदियन और गैर यहूदि कै एक आदमी बनाये कै हमकै सांति दई है। अपने खुद के सरीर के संग बौ भितिया कै तोड़ दई जो बाकै न्यारे कर दई दुई लोग कै एक करकै एक नया लोग बनाई। <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" /><note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="COL 2:14">कुलुस्सियों 2:14</ref> </char></note>बौ सांति बनान ताहीं ऐसे करकै दुई नया आदमिन कै आपस मैं एक करन ताहीं यहूदि कानून कै अपनी आग्यन और नियमन के संग खतम कर दई। <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" /><note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">कुलुस्सियों 1:20</ref></char></note>क्रूस मैं उनके मरन से मसीह ईसु उनकी दुस्मनी कै खतम कर दई; क्रूस के जरिया बौ दोनों तरफा बारेन कै एक सरीर मैं एकजुट करी और उनकै परमेस्वर के झोने लौटाय लाई। <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" /><note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">यसायाह 57:19</ref></char></note>तभईये ईसु मसीह आयकै आपन सबन कै सांति के अच्छे सुसमाचार को उपदेस दई तुम गैर यहूदि कै जो परमेस्वर से दूर रहैं, और यहूदिन से जो उनके झोने रहैं। <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />जौ सब ईसु मसीह के बजह से भौ कि हम सबै, यहूदि और दुसरी जाति, एक आत्मा मैं हुईकै परम दऊवा की मौजूदगी मैं आन ताहीं काबिल हैं।<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />तौ अब तुम दुसरी जाति दुसरे देस के या अनपहचान नाय हौ; अब तुम परमेस्वर के पवित्र लोग और प्रभु के परिवार के आदमी हुईकै एक परिवार हौ। <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />बैसे तौ प्रेरितन और भविस्यवक्तन के जरिया चुनी भइ बुनियाद के ऊपर बनाओ गौ है, पर फिर भी सब चीजन की नीव को पथरा खुद ईसु मसीह है। <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />एक बहे है जो पूरी इमारत कै एक संग जोड़कै रखाथै और जाकै प्रभु कै सौंप कै एक पवित्र मंदिर मैं ढ़ाल देथै। <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />बाके संग एक होन के बजह से तुम्हऊँ दुसरे आदमिन के संग मिलकै एक ऐसी रहन की जघा होन के ताहीं जहाँ परमेस्वर बाकी आत्मा के दुआर रहथै।<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">गैर यहूदि के ताहीं पौलुस को काम</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />जौ बजह से, मैं पौलुस, मसीह ईसु को कैदी, तुम गैर यहूदि के खातिर, परमेस्वर से प्रार्थना करथौं। <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />सच मैं तुम सुने हौ कि परमेस्वर मोकै उनके अनुग्रह और किरपा से जौ काम दई है कि मैं तुमरे भले के ताहीं काम करौं। <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />परमेस्वर अपनी लुकी भइ बातन कै खोल दई है और मोकै जाके बारे मैं बताई मैं जाके बारे मैं छोटो सो <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">कुलुस्सियों 1:26-27</ref> </char></note>लिखो हौं। <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />और अगर तुम जो लिखे हौ बाकै पढ़ैगे तौ, तुम मसीह के राज के बारे मैं मेरी सोच का है जान सकथौ। <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />बीते भै समय मैं इंसानन कै जौ राज नाय बताओ गौ रहै, लेकिन परमेस्वर पवित्र आत्मा के जरिया अब अपने पवित्र प्रेरितन और भविस्यवक्तन के अग्गु जाकै दिखाए दई है। <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />जौ राज की बात सुसमाचार के जरिया से गैर यहूदि मैं परमेस्वर की आसीस मैं यहूदियन के संग एक हिस्सा हैं और बौ प्रतिग्या के भागी हैं जो परमेस्वर ईसु मसीह के जरिया से करी रहै।<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />मोकै परमेस्वर को अनुग्रह के बौ दान के जरिया सुसमाचार देन को सेवक बनाओ गौ, जो बौ मोकै अपनी सामर्थ्य के काम के जरिया से दई रहै। <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />मैं परमेस्वर के सब पवित्र लोगन मैं से छोटो से छोटो हौं; तहुँओं परमेस्वर मोकै जौ हक दई कि हम गैर यहूदि कै मसीह के कहु खतम नाय होन बारे धन के अनुग्रह के बारे मैं सुसमाचार सुनाउँ, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />और सबै पवित्र लोगन कै जौ देखन ताहीं की परमेस्वर की लुकी भइ योजना कै कैसे चलाओ जाबै। परमेस्वर जो सबै चीजन कै बनाई है, बौ बीते भै सबै युगन मैं से अपने भेद कै लुकाए रखाई, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />ताकी अब कलीसिया के जरिया से परमेस्वर के तमान तरहान को ग्यान, उन प्रधानन और सक्तिन मैं जो स्वर्गिय जघा मैं हैं, उन पर प्रगट करो जाए <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />परमेस्वर अपने अनंत मकसद के अनुसार ऐसो करी, जो बौ मसीह ईसु हमरे प्रभु के जरिया से हासिल करी। <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />मसीह के संग मिल जान से और बाके बिस्वास के जरिया से हममैं पूरे धीरज के संग परमेस्वर के अग्गु जान की हिम्मत है। <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />मैं तुमसे नहोरे करथौं, तौ उदास मत होबौ काहैकि मैं तुमरे ताहीं जौ कलेस सह रौ हौ; जौ सब तुमरे फायदे के ताहीं है।<verse eid="EPH 3:13" /></para>
  <para style="s">मसीह को प्रेम</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />मैं जहे बजह से दऊवा के अग्गु घूँटो टेकथौं, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />जोसे स्वर्ग और पृथ्वी मैं सबै परिवारन को असली नाओं धरो जाथै। <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />कि बौ अपनी आत्मा के जरिये तुम लोगन कै अपनी महिमा मैं धन अनुसार तुमकै सक्ति और सामर्थ्य देबै, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />और मैं प्रार्थना करथौं कि मसीह बिस्वास के जरिया से तुमरे मन मैं अपनो घर बनाबै। मैं प्रार्थना करथौं कि तुम अपनी जरन और प्रेम की बुनियाद रख सकौ, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />ताकी तुम सबै परमेस्वर के पवित्र लोगन के संग मिलकै जौ समझन की सक्ति रख सकौ कि, मसीह के प्रेम की चौड़ाई और लम्बाई, ऊचाई और कित्तो गहरो है। <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />हाँ, का तुम मसीह के प्रेम कै जान सकौ-हालाकि जौ कहुए पूरी तरीका से जान नाय सकथैं-और जबले पूरे तरहन से परमेस्वर के स्वभाव से भरपूर हुई जाए।<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />अब, जो ऐसो सामर्थी है जो की सक्ति हमरे भीतर इत्तो जाधे काम कर सकथै, जित्तो हम कहु भी सोच तक नाय सकथैं: <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />परमेस्वर की हर समय और हमेसा के ताहीं कलीसिया मैं ईसु मसीह मैं बाकी महिमा पीढ़ी से पीढ़ी तक युगानुयुग होत रहबै! आमीन।<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">सरीर की एकता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />मैं जो प्रभु मैं कैदी हौं तुमसे नहोरे करथौं, काहैकि मैं प्रभु की सेवा करथौं: कि जो बुलाहट से तुम बुलाए गै रहो, बहे के योग्य चाल चलौ। <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" /><note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12">कुलुस्सियों 3:12</ref></char></note>हमेसा विनम्र, कोमल और धीर धरन बारे बनौ। एक दुसरे के संग सब कुछ सहत भै अपने प्रेम कै जताबौ। <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />आत्मा की सांति से एकता कै बनाये रखन के ताहीं अपनो सबसे अच्छो से अच्छो चाल-चलन दिखाबौ। <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />एकै सरीर है, और एकै आत्मा; जैसे कि जो आसा के ताहीं परमेस्वर तुमकै बुलाई है बौ भी एक है। <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />एक प्रभु है, एक बिस्वास, और एक बपतिस्मा है; <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />सबै लोगन को एकै परमेस्वर और दऊवा है; जो सबन को प्रभु है, बौ सबन के जरिया से काम करथै, और सबन मैं है।<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />हम्मै से हर एक कै मसीह जो बौ दई है, बाके नपना मैं एक खास अनुग्रह और दान मिलो है। <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" /><note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">भजन संहिता 68:18</ref></char></note>जैसे सास्त्र कहथै,</para>
  <para style="q1" vid="EPH 4:8">“जब ईसु खूब उचाई ले गौ,</para>
  <para style="q1" vid="EPH 4:8">तौ बौ अपने संग निरे कैदियन<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">मौत, पाप और सैतान</char></note> कै लैगौ;</para>
  <para style="q1" vid="EPH 4:8">बौ आदमिन कै दान दई।”<verse eid="EPH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />अब, “ईसु ऊपर गौ” को का मतलब है? जाको मतलब जौ है कि पहले बौ पृथ्वी की सबसे तरे की गहराई ले उतर गौ रहै। <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />तौ जो तरे गौ बौ ईसु है जो ऊपर और आसमान से ऊपर गौ, पूरी दुनिया कै अपनी मौजूदगी से भरन के ताहीं। <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />जौ बहे रहै जो “आदमिन कै दान दई” बौ कुछन कै प्रेरित ठहराई, दुसरेन कै भविस्यवक्ता, औरन कै प्रचारक, कोई कै रखबारे और सिक्छक बनन के ताहीं चुनी। <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />बौ मसीह की सेवा के काम के ताहीं परमेस्वर के सबै पवित्र लोगन कै समारन के ताहीं, जोसे मसीह के सरीर कै बनाओ जाए सकै। <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />और तभई हम सब जनी मिलकै बौ बिस्वास और परमेस्वर के लौड़ा के बारे मैं अपने ग्यान कै पाए लेंगे; हम मसीह के पूरे कद के भौत ऊँचे ले पहोंचन बारे मजबूत आदमी बनंगे। <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />तौ हम अग्गु कै बालका नाय रहमैं जो इंसान की ठगी और चलाँकी से, उनकी गलतफैमि की चालन के और उपदेस के सब झोंकन से उछालो और इतै-उतै घुमाओ जाथै। <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />जाके बजाय, प्यार की आत्मा मैं सच बोलकै, हमकै हर तरह से मसीह के ताहीं बढ़नो चाहिए, जो मुड़िया है। <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />बाके बस मैं सरीर के सबै अलग-अलग हिस्सा एक संग ठीक तरीका से बैठे होथैं, और पूरे सरीर कै एक संग हर जोर गाँठ से रखो जाथै, जैसे कि होनो चाहिए तभई जब हर अलग हिस्सा काम करथै तौ पूरो सरीर बढ़थै, कि बौ प्रेम मैं उन्नति करत जाए।<verse eid="EPH 4:16" /></para>
  <para style="s">मसीह मैं नई जिंदगी</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />प्रभु के नाओं से, मैं तुमकै चितौनी देथौं: कि जैसे गैर यहूदि जो बेकार बिचार करथैं, बैसो तुम मत चलौ। <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />और उनकी बुद्धि अंधियारी हुई गई है। उनकी जिंदगी मैं कोई हिस्सा नाय है जो परमेस्वर देथै, काहैकि बे पूरे तरीका से बिना दिमाक के और जिद्दी हैं। <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />बे सरम कै महसूस नाय करन लगे हैं; बे खुदै बड़े बनकै असुद्धता और अनुसासन के बिना सब तरह के असलील हरकत के काम करथैं।<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />पर तुम तौ मसीह की ऐसी सिक्छा ना पाए! <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />पर तुम सच्ची मैं बहे की सुने, और बाके चेला होन के नाते जो ईसु की सच्चाई है, बहे मैं सिखईयो गै। <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />जहे बजह से अपने पुराने चाल-चलन से छुटकै, जो तुमकै बौ तरीका से जिंदो करी जैसे कि तुम बौ पुराने चाल-चलन मैं चलत रहौ जो अपने धोकेबाज इच्छन से खतम होत रहै। <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />और अपने मन और दिमाक कै पूरे तरीका से नया बनाबौ, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />और नये इंसानियत कै पहन लेबौ, जो परमेस्वर के ही तराहनी सच्ची धार्मिकता और सई जिंदगी मैं खुदकै दिखाथै जो इमानदार और पवित्र है।<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />जौ बजह से झूठ बोलनो छोड़कै सब अपने परोसिन से सच्ची बोलौ, काहैकि हम आपस मैं एक दुसरे के अंग हैं। <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />अगर तुम गुस्सा हुई जाथौ, तौ अपने गुस्सा मैं आयकै पाप मत करौ, दिन मुदन तक तुमरे गुस्सा न रहबै। <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />सैतान कै मौका कतई मत दियौ। <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />अगर तुम चोरी करत रहौ, तौ तुमकै चोरी करनो छोड़ देनो चाहिए और भले काम करनो सुरु कर देनो चाहिए, ताकी तुम अपने ताहीं इमानदारी को जीवन जी सकौ और गरीबन की मदत कर सकौ। <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />कोई गंदे बोल तुमरे मोहों से ना निकरैं लेकिन भलाई की बात निकरै, पर सिरफ अनुग्रह की बढ़ोतरी के हिसाब से बहे बोल निकरै जो तुमरे सुनन बारे को भलो कर सकै, जोसे तुमरे सुनन बारेन कै फायदा होबै। <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />और परमेस्वर की पवित्र आत्मा कै दुखी मत करौ; काहैकि आत्मा तुमरे ऊपर परमेस्वर के गुरुजी होन की छाप है, और बौ जौ बात कै पक्को करथै कि बौ दिन आगो जब परमेस्वर तुमकै छुटकारा देगो। <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />सब तराहनी की कड़वाहट, और राग और गुस्सा से छुटकारा पाबौ, और कोई बदनामी करन बारी बात, कोई तरहन की जद्धे खराब सोच मत पालौ। <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" /><note caller="+" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">कुलुस्सियों 3:13</ref></char></note>जाके अलावा एक दुसरे के ताहीं दया करन बारे और कोमल मन के रहबौ, और एक दुसरे कै माफ कर दियौ, काहैकि परमेस्वर तुमकै मसीह के जरिये माफ करी है।<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">उजीते मैं रहनो</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />जब तुम परमेस्वर के प्रिय बालका हौ, तौ तुमकै बाके जैसो बनन की कोसिस करनो चाहिए। <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" /><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">निर्गमन 29:18</ref>; <ref loc="PSA 40:6">भजन संहिता 40:6</ref> </char></note>तुमरी जिंदगी कै प्रेम से रस्ता मैं लाओ जानो चाहिए, जैसी मसीह हमकै प्रेम करी है और हमरे ताहीं अपनी जिंदगी एक प्यारी महाकनबारी भेंट के रूप मैं दई और अपने आपकै भेंट दई, जौ सब परमेस्वर कै खुस करथै।<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />जब तुम परमेस्वर के पवित्र लोग हौ तौ, तुम मैं छिनरइ और कोई तरहन के असुद्ध काम या लालच की बातचीत भी ना होनी चाहिए। <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />ना निर्जलता, ना मूर्खता की बात, तुमकै ऐसो बोलनो ठीक नाय है जो बगैर सरम को, और अयोग्य है। बल्किन तुमकै परमेस्वर कै धन्यवाद देनो चाहिए। <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />तुम जौ जानथौ कि, कोई भी दुराचारी, असुद्ध या लालची आदमी, काहैकि लालच मूर्ति पूजन के बराबर है मसीह और परमेस्वर के राज्य मैं भागीदार नाय होगो।<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />कोई भी तुमकै बेकार की बातन से धोका ना देबै; काहैकि जेईं कामन के करड़ परमेस्वर को गुस्सा आग्या ना मानन बारेन के ऊपर भड़कथै। <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />जहे बजह से ऐसे आदमिन के सहभागी मत बनौ। <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />तुम खुदै अंधियारे मैं चलतै रहौ, लेकिन जब से तुम प्रभु के आदमी बने हौ, तुम उजीते मैं हौ। तभई से तुमकै ऐसे आदमिन कै जैसो रहनो चाहिए, जो उजीते के हैं, <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />जौ बौ उजीतो है, जो सबै तरहन की भलाई, न्यायपन और सच्चाई को एक पूरो फल लाथै। <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />और जौ परख कै सीखौ कि प्रभु कै का भाथै। <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />लोगन कै बेकार की चीजन से कोई लेनो देनो नाय है, जे सब भागीदारी के अलावा जो चीज अंधियारे से जुड़ी है, उनकै उजीते मैं लाबौ। <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />काहैकि उनके लुके छिपे कामन की बात करनो भी सरम की बात हैं। <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />और जब सबै चीजन कै उजीतो मैं लाओ जाथै। तौ उनकी असलियत सच मैं दिखाई देथै; <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />जो कछु ठीक तरीका से दिखाई देथै, बौ प्रगट हुई जाथै। तभई कहो जाथै,<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">जो कछु भी ठीक तरीका से दिखाई देथै बौ हलको हुई जाथै; या जौ उजीतो है जो सब कुछ सपा तरीका के दिखबाथै।</char></note></para>
  <para style="q2" vid="EPH 5:14">“सोन बारे जगौ,</para>
  <para style="q2" vid="EPH 5:14">और मुर्दन मैं से जिंदे हुई जाबौ,</para>
  <para style="q2" vid="EPH 5:14">तौ मसीह तुमरे ऊपर जगमगाय उठैगो।”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />तौ चहाचीते रहबौ कि तुम कैसे चलथौ, बिना ग्यान के आदमी हानी मत रहबौ, बल्किन दिमाकदारन के हानी रहबौ। <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" /><note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">कुलुस्सियों 4:5</ref> </char></note>तुमसे जितनो हुई सकै समय को अच्छो इस्तमाल करौ, काहैकि जे दिन बुरे हैं। <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />फिर बेअकली मत बनौ, लेकिन जौ पता निकारन की कोसिस करौ कि प्रभु का करनो चाहथै।<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />दाखरस पीकै नसा मत करौ, जौ तुमकै सिरफ बरबादै करैगो; जाके अलावा, आत्मा से भर जाबौ। <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" /><note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 3:16">कुलुस्सियों 3:16</ref>,<ref loc="COL 3:17">17</ref> </char></note>पवित्र और आत्मिक गीत कै एक दुसरे के संग गाबौ; अपने मन मैं स्तुति के संग प्रभु के गीतन और स्तुति कै गाबौ। <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />हमरे प्रभु ईसु मसीह के नाओं से, हमेसा दऊवा परमेस्वर के हर बातन के ताहीं धन्यवाद देबौ।<verse eid="EPH 5:20" /></para>
  <para style="s">लोगा और बईय्यर</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />और मसीह के डर मैं एक दूसरे के अधीन रहबौ।<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:22 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:18">कुलुस्सियों 3:18</ref>
      </char>
    </note> हे बईंय्यरौं, अपने आपकै अपने लोगा के अधीन करौ, जैसे की प्रभु के। <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />एक लोगा को अपनी बईय्यर ऊपर हक होथै जैसे कि मसीह को कलीसिया ऊपर हक होथै; और मसीह खुदै सरीर मतलब कलीसिया को उद्धारकर्ता है। <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />और बईंय्यरन कै खुदकै पूरे तरीका से अपने लोगा कै सौंप देनो चाहिए जैसे कलीसिया खुदकै मसीह के अधीन करथै।<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:25 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:19">कुलुस्सियों 3:19</ref>
      </char>
    </note>लोगा अपनी बईय्यर कै बहे तराहनी प्रेम करै जैसी मसीह कलीसिया से प्रेम करी और बाके ताहीं अपनी ज्यान दै दई। <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />बौ कलीसिया कै अपने बचन से पानी से हंदबाय कै सुद्ध करन के बाद परमेस्वर कै समर्पित करन के ताहीं, जौ सब करी रहै। <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />और बाकै एक ऐसी? कलीसिया बनाये कै अपने झोने ठड़बाबै, जोमैं ना कलंक, ना झुर्री, ना कोई और ऐसी चीज होबै, बल्कि पवित्र और निर्दोस होबै। <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />अपनी बईय्यर से ऐसो प्रेम करनो चाहिए जैसो अपने सरीर से करथौ। एक आदमी जो अपनी बईय्यर से प्रेम करथै बौ अपने आप से प्रेम करथै। <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />हममैं से कोईये अपने सरीर कै कहुओ घिनौनाे नाय मानथै। जाके अलावा हम बाकै खबाथैं, और बाकी देखाभारी करथैं; जैसो मसीह कलीसिया की करथै। <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />हम बाके सरीर के हिस्सा हैं। <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" /><note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="EXO 2:24">निर्गमन 2:24</ref></char></note>जैसे कि सास्त्र कहथै, “जौ बजह से लोग अपने बाबा और अईय्या के घर कै छोड़ देंगे और अपनी बईय्यर के संग एक हुईकै मिलो रहगो, और दोनों एक हुई जांगे।” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />जौ लुकी भइ बात गहरी और सच्ची है, जो सास्त्र मैं प्रकट करी गई है और बौ मेरे अनुसार मसीह और कलीसिया के बारे मैं है। <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />लेकिन जौ तुमरे ऊपर लागू है: सब लोगन कै अपनी बईय्यर से प्रेम करनो चाहिए, और सब बईंय्यरन कै अपने लोगा को आदर करनो चाहिए।<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">अईय्या-बाबा और बालका</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />बालकौ, जौ तुमरो प्रभु मैं कर्तव्य है कि तुम अपने अईय्या-बाबा को कहनो मानौ, ऐसो करन के ताहीं ठीक काम करने है। <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“और अईय्या-बाबा को आदर करौ” जौ पहली आग्या है जोमैं एक वादा कै जोड़ो गौ है: <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“ताकी सबै तुमरे संग अच्छे से चल सकैं; और तुम धरती मैं लंबे समय ले रह सकौ।” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" /><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 3:21">कुलुस्सियों 3:21</ref></char></note>अईय्या-बाबा, अपने बालकन के संग ऐसो बर्ताव नाय करैं; जोसे उनकै गुस्सा आबै। जाके अलावा, उनकै प्रभु ईसु मसीह को अनुसासन और समझाए कै अग्गु बढ़ाबौ।<verse eid="EPH 6:4" /></para>
  <para style="s">गुलाम और गुरुजी</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:22-25">कुलुस्सियों 3:22-25</ref>
      </char>
    </note>हे दासौ, जो लोग सरीर के आधार से तुमरे मालिक हैं, अपने मन की सिधाई से डरात भै और काँपत भै, जैसे मसीह की, बैसिये उन्हईं की बात मानैं। <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />इंसानन कै खुस करन के ताहीं दिखाबे की सेवा मत करौ, पर मसीह के दास के तराहनी मन से परमेस्वर की मरजी से चलौ। <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />अपने काम कै गुलाम के रूप मैं खुसी से करौ, जैसे तुम प्रभु की सेवा करे, ना कि सिरफ इंसानन की। <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />जौ याद रखाबौ कि प्रभु हम्मै से सबन कै, चाँहे बौ दास होबै या छुटो भौ, हम जो भी अच्छो काम करंगे, बाके ताहीं इनाम पांगे।<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:9 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 10:17">व्यवस्थाविवरन 10:17</ref>; <ref loc="COL 3:25">कुलुस्सियों 3:25</ref></char>
    </note> और हे स्वामियों, अपने गुलाम कै बिना धमकी दै बैसिये बर्ताव करौ; काहैकि तुम जानथौ कि उनको और तुमरो दोनों को गुरुजी स्वर्ग मैं है, और बौ कोई को भेद-भाव नाय करथै।<verse eid="EPH 6:9" /></para>
  <para style="s">परमेस्वर के लड़ाई के हथियार</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />तभई प्रभु की एकता मैं और बाकी सक्ति के प्रभाव मैं ताकतबर बनौ। <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />परमेस्वर जो भी हथियार दई है, बे सब भाँद लेबौ, जोसे तुम सैतान की बुरी चालन के खिलाप ठाड़े रह सकौ। <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />काहैकि हमारी हर लड़ाई इंसानन से ना है, बल्किन प्रधानन से अधिकारियन से और जौ अंधकारमै दुनिया की ताकतन से, और स्वर्गिय जघा के बे दुस्ट आत्मिक फौज के खिलाप हैं जो अंतरिक्छ मैं हैं। <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />तौ अब परमेस्वर के सबै हथियार भाँद लेयौ, कि तुम बुरे दिनन मैं दुस्मन को सामना कर सकौ, और सब कछु पूरो करकै टिके रह सकौ। <figure style="fig" alt="Roman soldier" file="lb00196c.tif" size="col" copy="Horace Knowles ©" ref="6:10">रोमन सिपईय्या</figure><verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />तौ सच्चाई से अपनो करिहाँओं कसकै, और न्यायपन की झिलम पहनकै,<note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="ISA 11:5">यसायाह 11:5</ref>; <ref loc="ISA 59:17">59:17</ref>; <ref loc="ISA 59:17">यसायाह 59:17</ref></char></note> <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" /><note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">यसायाह 52:7</ref>; <ref loc="ISA 40:9">40:9</ref>; <ref loc="NUM 1:15">गिनती 1:15</ref></char></note>और पाँव मैं सांति के सुसमाचार की तैयारी के जूता पहनकै; <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />और हमेसा बिस्वास की ढाल लैकै स्थिर रैहबौ; जहे के ताहीं तुम बौ दुस्ट के सब जलत भै तीरन कै बुताय सकौ। <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" /><note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 11:4">यसायाह 11:4</ref>; <ref loc="ISA 49:2">49:2</ref>; <ref loc="ISA 51:16">51:16</ref></char></note>और उद्धार को टोप, और आत्मा की तलवार जो परमेस्वर को बचन है, लै लेबौ। <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />और हर समय और सब तरहन से आत्मा मैं प्रार्थना, और बिनती करत रहबौ, और जगत रैहबौ, कि सब पवित्र लोगन के ताहीं लगातार बिनती करे करौ। <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />और मेरियौ ताहीं प्रार्थना करौ, कि जब मैं बोलन ताहीं समरंगो, तौ परमेस्वर मोकै एक संदेसो देगो, ताकी मैं हिम्मत के संग बोल सकौं और सुसमाचार को भेद जाहिर कर सकौं। <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />जो सुसमाचार के खातिर मैं जंजीर से भँदो भौ एक राजदूत कैदखाना मैं हौं, प्रार्थना करौ, कि मैं जितनो हुई सकै, सुसमाचार सुनान के बारे मैं मजबूत हुई सकौं।<verse eid="EPH 6:20" /></para>
  <para style="s">आखरी नमस्ते</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:21 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितो 20:4</ref>; <ref loc="2TI 4:12">2 तीमुथियुस 4:12</ref> </char>
    </note>तुखिकुस, हमरो प्रिय भईय्या और प्रभु के काम को वफादार सेवक, तुमकै मेरे बारे मैं सब खबर देगो, ताकी तुम जान सकौ कि मैं कैसो हौं। <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />मैं बाकै इसलै तुम लोगन के झोने भेज रौ हौं कि तुम मेरे बारे मैं पूरो समाचार जान जाबौ और इसलै भी कि बौ तुमरे मन कै प्रोत्साहित करै।<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />परमेस्वर दऊवा और प्रभु ईसु मसीह सब मसीह भईय्यन कै सांति और बिस्वास के संग प्रेम देबै। <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />परमेस्वर को अनुग्रह और किरपा बे सबन के संग होबै, जो हमरे प्रभु ईसु मसीह से लगातार प्रेम करथैं।<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>