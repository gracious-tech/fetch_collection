<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Rana Tharu</book>
  <para style="h">प्रकासितवाक्य</para>
  <para style="toc3">प्रकासितवाक्य</para>
  <para style="toc2">प्रकासितवाक्य</para>
  <para style="toc1">प्रकासितवाक्य यूहन्ना के जरिये</para>
  <para style="mt2">प्रकासितवाक्य यूहन्ना के जरिये</para>
  <para style="mt1">प्रकासितवाक्य यूहन्ना के जरिये</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रकासितवाक्य की किताब नये नियम की आखरी किताब है। जहो ईसु के जनम के लमसम 95 साल बाद प्रेरित यूहन्ना के जरिये लिखी गई रहै <char style="xt"><ref loc="REV 1:1">1:1</ref></char>। बौ गौस्पल यूहन्ना के हिसाब से और तीन किताब 1 यूहन्ना, 2 यूहन्ना और 3 यूहन्ना भी लिखी। यूहन्ना कै “जोसे ईसु प्यार करत रहै” ऐसियौ करकै भी जानो जात रहै <char style="xt"><ref loc="JHN 13:23">यूहन्ना 13:23</ref></char>। बौ पतमुस द्वीप मैं प्रकासितवाक्य की किताब जौ बजह से लिखी काहैकि बाकै ईसु मसीह के सुसमाचार को प्रचार करन के ताहीं निर्वासित<note caller="+" style="f"><char style="fr" closed="false">1:0 </char><char style="ft" closed="false">कैद</char></note> करो गौ रहै। <char style="xt"><ref loc="REV 1:9">प्रकासितवाक्य 1:9</ref></char></para>
  <para style="ip">प्रकासितवाक्य की किताब लिखन मैं, यूहन्ना को उद्देस्य, पढ़न बारेन कै ईसु मसीह के प्रति भरोसेमंद बने रहन और उन्हैं आसा देन के ताहीं प्रोत्साहित करनो है काहैकि ईसु के लौटन को समय झोने है<char style="xt"><ref loc="REV 1:3">1:3</ref></char>, <char style="xt"><ref loc="REV 22:7">22:7</ref></char>। बौ सब विस्वासिन कै आमतौर मैं और सात खास कलीसियन कै <char style="xt"><ref loc="REV 2-3">2–3</ref></char> मैं लिखी रहै। यूहन्ना अपने खुद के लेखन कै भविस्यवाँड़ी <char style="xt"><ref loc="REV 1:3">1:3</ref></char> के रूप मैं नामपत्‌र करथै और जो कछु बौ देखी बाको वर्ड़न करन के ताहीं पूरी किताब मैं कई चित्तरन को इस्तमाल करथै। जौ किताब पुराने नियम के कुछ भाग के हानी है, खासकर <char style="xt"><ref loc="ZEC 6:1-8">जकर्याह 6:1-8</ref></char>। सात तुरहई और सात कटोरा बे आफत के हानी हैं जिनकै परमेस्वर मिस्र कै सजा देन के ताहीं भेजी रहै<char style="xt"><ref loc="EXO 7-9">निर्गमन 7–9</ref></char>। प्रकासितवाक्य की किताब समय के अंत के बारे मैं बात करथै, कि ईसु जीतैगो, और बे सब जो बाके ऊपर भरोसा करथैं, हमेसा के ताहीं बाके संग रहंगे। जौ किताब तुमकै चितौनी देबै और तुमकै आसा देबै कि ईसु जल्दिये बापस आयरौ है।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यूहन्ना जौ कहने से सुरू करथै कि बौ कौन है और बौ जौ भविस्यसूचक दर्सन कै कैसे पाई। <char style="ior"><ref loc="REV 1:1-20">1:1–1:20</ref></char></para>
  <para style="io1">2. बौ सीधे ईसु के घाँईं से सात कलीसियन कै संदेस देथै। <char style="ior"><ref loc="REV 1:1-3:22">1:1–3:22</ref> </char></para>
  <para style="io1">3. फिर बौ सात मुहर <char style="ior"><ref loc="REV 4:1-8:5">4:1–8:5</ref></char> और सात तुरहई के बारे मैं बताथै। <char style="ior"><ref loc="REV 8:6-11:19">8:6–11:19</ref></char></para>
  <para style="io1">4. जाके बाद यूहन्ना सात मुड़ियन के संग अजगर के खिलाप नर बालकन की लड़ाई को वर्ड़न करथै। <char style="ior"><ref loc="REV 12:1-14:20">12:1–14:20</ref> </char></para>
  <para style="io1">5. फिर बौ गुस्सा के सात कटोरन के बारे मैं लिखथै। <char style="ior"><ref loc="REV 15:1-16:18">15:1–16:18</ref> </char></para>
  <para style="io1">6. अग्गु यूहन्ना बताथै कि कैसे परमेस्वर स्वर्ग मैं अपने दुस्मनन से जीतथै। <char style="ior"><ref loc="REV 17:1-20:15">17:1–20:15</ref> </char></para>
  <para style="io1">7. आखरी मैं बौ नये स्वर्ग और नई पृथ्वी के बारे मैं बताथै जो आखरी मैं आबैगी। <char style="ior"><ref loc="REV 21:1-22:21">21:1–22:21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />जौ किताब बे घटना के बारे मैं है जो ईसु मसीह प्रकट करी रहै। परमेस्वर अपने सेवकन कै जौ दिखान के ताहीं जौ प्रकासन दई कि भौत जल्दी का होन बारो है। मसीह अपने स्‍वर्गदूत कै पनारकै बाके जरिया अपने सेवक यूहन्ना कै बताई, <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />और जो कछु बौ देखी बौ सब यूहन्ना बताए दई। जौ पूरो परमेस्वर के संदेस और ईसु मसीह के प्रकासन की गभाई के जरिया करे गै सच्चाई के बारे मैं बाको लेखा जोखा है। <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />खुसनसीब है बौ जो कोई जौ किताब कै पढ़थै, और धन्य हैं बे जो जे भविस्यवाँड़ी संदेस के सब्दन कै सुनथैं और जौ किताब मैं लिखी गई बातन कै मानथैं! काहैकि बौ समय करीब है जब जे चीज होंगी।<verse eid="REV 1:3" /></para>
  <para style="s">सात कलीसियन को स्वागत</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />यूहन्ना के घाँईं से आसिया की सात कलीसियन के ताहीं: परमेस्वर के घाँईं से, जो है, जो रहै, और जो आनबारो है, और बाके सिंहासन के सामने सात आत्मा के घाँईं से अनुग्रह और सांति मिलत रहबै। <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />और ईसु मसीह के घाँईं से, भरोसा के काबिल गभा है, जो मौत से पहलिये जिलाओ गौ, और जो दुनिया के सब राजन को मुखिया भी है। बौ हमसे प्यार करथै, और अपने खून के जरिया बौ हमैं हमरे पापन से आजाद करी है। <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />और हमैं एक राज्य और अपने परमेस्वर दऊवा की सेवा करन के ताहीं पुजारी भी बनाये दई। ईसु मसीह के ताहीं महिमा और सामर्थ्य हमेसा और हमेसा के ताहीं बनी रहबै! आमीन।<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />देखौ, बौ बादर मैं आए रहो है! और हर कोई बाकै देखैगो, जो बाकै बेधी रहैं। पृथ्वी के सब जाति के लोग बाके ताहीं सोक करंगे। ऐसो होनो चाहिए! आमीन।<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानिय्येल 7:13</ref>; <ref loc="MAT 24:30">मत्ती 24:30</ref>; <ref loc="MRK 13:26">मरकुस 13:26</ref>; <ref loc="LUK 21:27">लूका 21:27</ref></char></note><verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />सर्वसक्तिमान प्रभु परमेस्वर कहथै, “मैं पहलो और आखरी हौं,” जो है, जो रहै, और जो आनबारो है।<verse eid="REV 1:8" /></para>
  <para style="s">मसीह को दर्सन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />मैं तुमरो भईय्या यूहन्ना हौं, और ईसु के पिछलगुआ के हानी मैं बे लोगन के ताहीं दुख को धीरज से सहन करन मैं तुमरो भागीदार हौं, जो बाके राज्य से मेल खाथैं। मोए पतमुस टीला मैं रखो गौ रहै काहैकि मैं परमेस्वर के बचन और ईसु के जरिया बताई गई सच्ची गभाई दौ रहौं। <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />प्रभु के दिन मैं पवित्र आत्मा मोए काबू कर लई, और मैं एक बड़ा जोड़न से अबाज सुनो, जो एक तुरहई की अबाज के तराहनी लगत रहै, जो मेरे पच्छू बोलत रहै। <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />बौ कही, “जो कछु तुम देखथौ बाकै लिख लियौ, और सात सहर की कलीसियन कै जौ किताब भेज दे: इफिसुस, स्मुरना, पिरगमुन, थुआतीरा, सरदीस, फिलदिलफिया और लौदीकिया।”<figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="span" copy="Horace Knowles ©" ref="1:11">एसिया मैं सात कलीसियन को नक्सा</figure><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />और मैं जौ मुड़क कै देखो, कि मोसे कौन बात कर रौ है, और मैं सात सोने की डीट देखो, <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />और डीटन के बीच मैं से एक इंसान के लौड़ा तराहनी दिखात रहै, बौ एक चोंगा पहने पड़े रहै जो बाके पाँव ले आत रहै, और छाती मैं एक सोने की कमरबंद पहने पड़े रहै। <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />बाके बार सफेद ऊन के तराहनी और बरफ के जैसे सफेद रहैं, और बाकी आँखी आगी के जैसी धधकत रहैं; <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />बाके पाँव ऐसे चमकीले पीतर के तराहनी रहैं जो भट्टी मैं तपाए कै चमकाय गै होमैं, और बाकी अबाज गरजत भै झरना के तराहनी रहै। <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />बाके सामर्थी दहने हात मैं सात तारा रहैं, और बाके मोहों मैं से एक तेज दुईधारी तलवार निकरी भइ रहैं। और बाको मोहो दुपारी के दिन के हानी चमकदार रहै। <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />जब मैं बाकै देखो, तौ एक मरे भै आदमी के हानी मैं बाके पाँव मैं गिर गौ। बौ अपनो दहनो हात मेरे ऊपर धरी और कही, “डराबै मत! मैं पहलो और आखरी हौं। <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />महीं जिंदो हौं! मैं मर गौ रहौं, लेकिन अब मैं हमेसा के ताहीं जिंदो हौं। मोए मौत और नरक की चाबी मेरे अधिकार मैं है। <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />लिखौ, फिर, तुम जो चीज देखथौ, दोनों चीज जो अभै हैं जे सब बाद मैं होंगी। <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />जो सात तारा तुम मेरे दहने हात मैं देखथौ, उनको और सोने की सात डीट को भेद जौ है: सात तारा सात कलीसिया के दूत हैं, और सात डीट सात कलीसिया हैं।”<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">इफिसुस की कलीसिया कै संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />“इफिसुस की कलीसिया के दूत कै जौ लिख: कि जोके दहने हात मैं सात तारा हैं, और जो सात सोने के डीट के बीच मैं चलथै, बाके घाँईं से जौ संदेस है। <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />मोकै पता है कि तुम का करे हौ; मोकै पता है कि तुम कितनी मेहनत करे हौ और तुम कितनो धीरज रखथौ। मोकै पता है कि तुम बुरे लोगन कै बरदास नाय कर सकथौ और तुम बे लोगन कै परखे हौ कि बे जौ कहथैं कि बे प्रेरित हैं, लेकिन ना हैं, और पता चलो है कि बे झूठे हैं। <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तुम धीरज रखथौ, तुम लोग मेरे नाओं से कितनो दुख उठाए हौ, और तुम हार नाय माने हौ। <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />लेकिन मैं तुमरे खिलाप जौ कहथौं: तुम अब मोसे बैसो प्रेम नाय रखथौ जैसो कि तुम पहले करे करत रहौ। <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />सोचौ कि तुम कितनी दूर गिर गै हौ! अपने पापन से मन फिराबौ और बहे करौ जो तुम पहले करे रहौ। अगर तुम अपने पापन से मन न फिरागे, तौ मैं तुमरे झोने आए कै तुमरो डीट बाके जघा से उठाए लुंगो। <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />लेकिन जौ बहे है जो तुमरे पक्छ मैं हैं: तुम जो करथौ, नीकुलइयों बारे नफरत करथैं, जितनो मैं करथौं।”<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />“अगर तुमरे कान हैं, तौ सुनौ, पवित्र आत्मा कलीसियन से का कहथै! जो जीत हासिल करथैं, उन्हैं मैं परमेस्वर की स्वर्गिय बगिया मैं जमन बारे जिंदगी के पेंड़ के फल कै खान को अधिकार दुंगो।”<verse eid="REV 2:7" /></para>
  <para style="s">स्मुरना की कलीसिया के ताहीं संदेस</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />“स्मुरना की कलीसिया के दूत कै जौ लिख: जो पहलो और आखरी है, जो मर गौ रहै और अब जिंदो हुई गौ है, बाको संदेस जौ है। <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />मैं तुमरी परेसानी कै जानथौं; मोकै पता है कि तुम गरीब हौ, लेकिन बास्तव मैं तुम सेठ हौ! मोकै पता है कि जो लोग यहूदि होन को दाबा करथैं, उनके खिलाप तुमरे जरिये कही गई बुराई की बातैं मैं जानथौं, लेकिन न; बे एक सैतान के सभाघर हैं! <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />कोई भी चीज से मत डराबौ जो तुम भुगतन बारे हौ। सुनौ! तुम मैं से कितने कै कैदखाना मैं डारकै सैतान तुमरी परिक्छा लेगो, और तुमरी परेसानी दस दिन तक बनी रैहंगी। मेरे प्रति बिस्वास योग्य रहबौ, भले ही जाको मतलब मौत ही क्यों ना होबै, और मैं तुमकै अपनी जीत के इनाम के रूप मैं जिंदगी दुंगो।”<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />“अगर तुमरे पास कान हैं, तौ सुनौ, कि पवित्र आत्मा कलीसियन से का कहथै! जीतन बारेन कै दूसरी मौत से नुकसान ना होगो।”<verse eid="REV 2:11" /></para>
  <para style="s">पिरगमुन की कलीसिया कै संदेस</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />“पिरगमुन की कलीसिया के दूत कै जौ लिख: जौ बहे के घाँईं से संदेस है जोके झोने चोखी दुईधारी तलवार है। <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />मोकै पता है कि तुम कहाँ रहथौ, हूँना जहाँ सैतान को सिंहासन है। फिर भी तुम मेरे नाओं के प्रति सच्चे रहे, और तुम बौ समय भी मेरे ऊपर अपनो बिस्वास नाय छोड़ै, जब मेरो बिस्वास योग्य गभा अन्तिपास के समय मैं कुछ लोगन कै हूँना मारो गौ रहै जहाँ सैतान रहथै। <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />लेकिन कुछ बात हैं जो तेरे विरुद्ध कहने है: तुम मैं से कित्ते हैं जो बिलाम की सिक्छा मैं चलथैं, जो राजा बालक के अग्गु ठोकर खानो सिखाई, कि कैसे करकै इस्राएलियन की मूर्तियन मैं बलि चढ़ाई गई चीज खामैं, और छिनरइपना की राह मैं चलैं।<note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="NUM 31:16">गिनती 31:16</ref></char></note> <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />बैसिये तुमरे बीच ऐसे भी लोग हैं जो नीकुलइयों की सिक्छा मैं चलथैं। <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />अब अपने पापन से मन फिराबौ! मैं तुमरे झोने जल्दिये आमंगो और बे लोगन के खिलाप मेरे मोहों से निकरन बारी तलवार से लड़ंगो।<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />अगर तुमरे कान हैं, तौ सुनौ, कि पवित्र आत्मा कलीसियन से का कहथै! जो जीत जाथैं उनकै मैं छिपो मन्ना दुंगो, और उनमैं से सबन कै एक सफेद पथरा भी दुंगो; और बौ पथरा मैं एक नया नाओं लिखो भौ होगो, जोकै पानबारे के अलावा और कोई ना जानथै।”<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="REV 2:7">प्रकासितवाक्य 2:7</ref> </char></note><verse eid="REV 2:17" /></para>
  <para style="s">थुआतीरा की कलीसिया के ताहीं संदेस</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />“थुआतीरा की कलीसिया के दूत कै जौ लिख: परमेस्वर के बालक को जौ संदेस है, जोकी आँखी आगी के तराहनी धधकथैं, और जोके पाँव घोटे गै पीतल के तराहनी चमकथैं।<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="DAN 10:6">दानिय्येल 10:6</ref> </char></note> <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />मोए मालुम है तुम का करथौ। मैं तुमरे प्रेम, तुमरे बिस्वास और काबिलियत, और तुमरी सेवा, और तुमरे धीरज कै जानथौं। मोए मालुम है कि तुम पहले की तुलना मैं और जाधे काम कर रै हौ। <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />लेकिन मैं तुमरे खिलाप जौ कहथौं: तुम बौ बईय्यर इजेबेल कै सहन करथौ, जो खुदकै परमेस्वर की भविस्यवक्तनी कहथै। और अपने उपदेस से मेरे दास कै छिनरइ करन, और मूर्तियन के अग्गु बलि चढ़ी भइ चीजन कै खान ताहीं भरमाथै। <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />मैं बाकै मन फिरान के ताहीं मौका दौ, पर बौ अपनी छिनरइपना से मन फिरानो नाय चाहथै। <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />और तभई मैं बाकै बिमारी की खटिया ऊपर लिटाए दुंगो, और उन्हैं जो बाके संग व्यभिचार करन मैं लीन हैं भौत दुख मैं डार दुंगो। अगर बे बाके संग के दुस्ट कामन से मन फिरात न हैं। <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />मैं बाके अनुसरँड़ करन बारेन कै मार डारंगो, तौ सब कलीसिया जानंगी कि मैं बहे हौं जो सबन के मन और इच्छा कै जानथौं। और मैं ही तुमकै बाके कामन के हिसाब से बदला दुंगो।<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="PSA 7:9">भजन संहिता 7:9</ref></char></note><verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />लेकिन थुआतीरा मैं से बाकी के लोग जे गलत सिक्छा को पालन नाय करीं; तुम बौ नाय सीखे हौ जो दुसरे ‘सैतान की रहस्य की बातैं कहथैं।’ मैं तुमसे कहथौं कि मैं तुमरे ऊपर और कोई बोझ ना डारंगो। <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />लेकिन जबले मैं ना आमौं, तब ले जो कुछ तुम्हारे पास है बाकै मेरे आन तक थामें रहियो। <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />जो जय पाबै, और मेरे कामन के हिसाब से आखरी तक करत रहबै, मैं उनकै बे देसन को अधिकार दुंगो जो मोकै मेरो दऊवा दई रहै। <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />और बौ लोहो की छड़ी को राजदंड लै भै उनके ऊपर राज्य करैगो, जैसे कुम्हरा के मट्टी के बर्तन चकनाचूर हुई जाथैं: <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />महुँ ऐसे अधिकार अपने दऊवा से पाओ हौं। और मैं बाकै भोर को तारा दुंगो।”<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />“अगर जोके कान होमैं, बौ सुन लेबै कि पवित्र आत्मा कलीसियन से का कहथै!”<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">सरदीस की कलीसिया के ताहीं संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />“सरदीस नाओं की कलीसिया के दूत कै जौ लिख: जोके पास परमेस्वर की सात आत्मा और सात तारा हैं, बाके घाँईं से जौ संदेस है। मोकै मालुम है कि तुम का कर रै हौ; मैं जानथौं कि तुम मरे भै होत भै भी जिंदो होन की सोच रखथौ! <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />तौ जागो, और जो तुमरे झोने हबै जो भी है बाकै पूरी तरह से मजबूत करौ। काहैकि मैं जो तोसे पाओ हौं कि जो कुछ तू जो करो है हबै ले परमेस्वर की नजर मैं सिद्ध ना भौ है। <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />तभई याद रखौ, कि तुम्हैं का सिखाओ गौ रहै और तुम का सुनें रहौ; बाको पालन करौ और अपने पापन से मन फिराबौ। और अगर तुम ना जगैगे, तौ मैं चुट्टा के तराहनी तुमरे झोने आंगो, कि मैं कोनसे समय तेरे ऊपर आए पड़ंगो। <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />लेकिन हुँआँ सरदीस मैं तुम मैं से कुछ लोग अपने लत्ता असुद्ध नाय करीं बल्कि करकै साफ रखी हैं। तुम मेरे संग सफेद लत्ता पहने भै चलैगे, काहैकि तुम ऐसो करन के काबिल हौ। <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />जो बिजय होंगे जहे तरीका से सफेद लत्ता पहनाओ जागो, और मैं बाको नाओं जिंदगी की किताब मैं से ना हटांगो। मैं अपने दऊवा और बाके स्वर्गदूतन के सामने ऐलान करंगो की बे मेरे हैं।”<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />“अगर तुमरे कान होमैं, बौ सुन लेबै कि पवित्र आत्मा कलीसियन से का कहथै!”<verse eid="REV 3:6" /></para>
  <para style="s">फिलदिलफिया की कलीसिया के ताहीं संदेस</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“फिलदिलफिया की कलीसिया के दूत कै जौ लिख: पवित्र और सच्चाई के घाँईं से जौ संदेस है। बाके झोने बौ चाबी है जो दाऊद की है, और जब बौ फाटक खोलथै, तौ कोई बाकै बंद नाय कर सकथै, और जब बौ बंद कर देथै, तौ कोई बाकै खोल नाय सकथै।<note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="JOB 12:14">अय्यूब 12:14</ref>; <ref loc="ISA 22:22">यसायाह 22:22</ref></char></note> <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />मोए मालुम है कि तुम का करथौ; मैं जानथौं कि तुमरे भीतर थोड़ी सामर्थ्य है; तू जो मेरी सिक्छा को पालन करो है और मेरे नाओं कै मना नाय करो है। मैं तेरे सामने एक फाटक खोल दौ हौं, जोकै कोई बंद नाय कर सकथै। <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />बात सुनौ! जहाँ ले बौ सभाघर को सबाल है जो सैतान को है, बे झूठे जो दाबा करथैं कि बे यहूदि हैं लेकिन नाय हैं, मैं आयकै तुमरे पाओं मैं झुकांगो। बे सब जानंगे कि मैं तुम सबन से प्रेम करथौं। <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />काहैकि तू धीरज धरकै मेरी आग्या कै मानो है, मैं तोकै बौ संकट के समय से बचाए रखंगो, जो दुनिया मैं सब लोगन की परिक्छा लेन के ताहीं आनबारो है। <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />मैं जल्दिये आनबारो हौं। तुमरे झोने जो कुछ भी बाकै समार कै रखैं, ताकी कोई भी तुमरे जीत के इनाम कै छीन ना पाबै। <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />जो जय पाबै, बाकै मैं अपने परमेस्वर के मंदिर मैं एक खम्मा बनांगो; और बौ फिर कहु बाहर ना निकरैगो; और मैं अपने परमेस्वर को नाओं, और अपने परमेस्वर के नगर मतलब नये यरूसलेम को नाओं, जो मेरे परमेस्वर के पास से स्वर्ग मैं से उतरन बारो है और अपनो नया नाओं भी बामै लिखंगो।”<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 21:2">प्रकासितवाक्य 21:2</ref>; <ref loc="ISA 65:15">यसायाह 65:15</ref>; <ref loc="EZK 48:35">यहेजकेल 48:35</ref></char></note><verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />“अगर तुमरे कान होमैं, बौ सुन लेबै कि पवित्र आत्मा कलीसियन से का कहथै!”<verse eid="REV 3:13" /></para>
  <para style="s">लौदीकिया की कलीसिया के ताहीं संदेस</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />“लौदीकिया की कलीसिया के दूत कै जौ लिख: जो आमीन को संदेस है, जो बिस्वास के काबिल और सच्चो गभा है, जो परमेस्वर की सृस्टि को आधार<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">सासक</char></note> है। <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />मोए मालुम है कि तुम का करे हौ; मोए मालुम है कि ना तुम ठंडे हौ और ना गरम। कास तुम ठंडे ही होते या गरमैं होते! <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />लेकिन काहैकि तू गुनगुनो है, और ना ठंडो है और न गरम, मैं तोकै अपने मोहों से उगलन बारो हौं। <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />तुम कहथौ, ‘मैं सेठ हौं; मेरे झोने बौ सब है जो मोए चाहिए।’ लेकिन तुम नाय जानथौ कि तुम कित्ते दुखी और अभागे हौ! तुम गरीब, नंगे और अंधरा हौ।<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="HOS 12:8">होसे 12:8</ref> </char></note> <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />इसलै मैं तोकै सलाह देथौं, कि सेठ होन के ताहीं मोसे सुद्ध सोना मोल लेबौ। और खुदकै तैयार करन के ताहीं सेतो लत्ता भी मोल लेबौ ताकी अपनी सर्मनाक नंगेपन कै ढकौ। और अपनी आँखी मैं लगान के ताहीं मलहम ले ताकी तुम देखन लगौ <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />मैं जिनसे प्यार करथौं उन सबन कै झुकाथौं और सजा देथौं। इसलै गंभीरता से रहबौ, और अपने पापन से मन फिराबौ। <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />सुनौ! मैं फाटक के झोने ठाड़ो भौ खटखटाथौं; अगर कोई मेरी अबाज सुनकै फाटक खोलैगो, तौ मैं बाके झोने भीतर आयकै बाके संग खानु खांगो, और बे मेरे संग खानु खांगे। <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />जो बिजय होंगे, मैं बाकै अपने संग अपने सिंहासन मैं बैठन को हक दुंगो, जैसो मैं बिजय भौ हौं और अब अपने दऊवा के झोने बाके सिंहासन मैं बैठो हौं।”<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />“अगर जोके कान होमैं, बौ सुन लेबै कि पवित्र आत्मा कलीसियन से का कहथै।”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">स्वर्ग मैं आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />जे बातन के बाद मोए एक और दर्सन भौ और मैं स्वर्ग मैं एक खुलो फाटक देखो। और बौ अबाज जो तुरहई जैसो बजत रहै, जो मोसे बोलत भै सुनो, बौ कही, “हिंयाँ ऊपर चढ़या, और मैं तोकै दिखांगो कि जाके बाद का होगो।”<note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="REV 22:6">प्रकासितवाक्य 22:6</ref></char></note> <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />तुरंत आत्मा मोकै अपने वस मैं कर लई। हुँआँ स्वर्ग मैं एक सिंहासन रहै जोमैं कोई बैठो है। <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />बाको चैहरा हरे रंग और लाल रंग के कीमती पथरा के तराहनी चमकत रहै, और सिंहासन के चारौ घाँईं एक मरकत के रंग को एक मेघधनुस रहै।<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="1KI 22:19">1 राजा 22:19</ref></char></note> <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />बौ सिंहासन के चारौ घाँईं के घेरा मैं चौबीस सिंहासन रहैं, जिनमैं चौबीस बड़े-बूढ़े सफेद लत्ता पहने और सोने के मुकुट पहने बैठे रहैं।<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="REV 11:16">प्रकासितवाक्य 11:16</ref></char></note> <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />बौ सिंहासन से बिजली की चमक, गड़गड़ात भइ आई। सिंहासन के सामने आगी के सात मसाल जलत रहैं, जो परमेस्वर की सात आत्मा हैं।<note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="ZEC 4:2">जकर्याह 4:2</ref></char></note> <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />और संग मैं सिंहासन के सामने मानौं बिल्लौर के हानी दरपन के जैसो समुंदर है, और सिंहासन के बीच मैं और सिंहासन के चारौ घाँईं चार जीव हैं, जिनके अग्गु और पच्छू आँखिये आँखी हैं।<note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="EZK 10:12">यहेजकेल 10:12</ref></char></note> <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पहलो जीव सेरा के तराहनी दिखत रहै; और दुसरो जीव बछड़ा के तराहनी लगत रहै; तीसरो को चैहरा इंसान जैसो रहै; और चौथो उड़त भै गिद्धा के जैसो लगत रहै।<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="EZK 1:10">यहेजकेल 1:10</ref>; <ref loc="EZK 10:14">10:14</ref></char></note> <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />और चारौ जीव के छै-छै पंख हैं, चारौ तरफ और भीतर आँखी ही आँखी हैं; और बे रात-दिन बगैर सैंताए जौ कहते रहथैं,</para>
  <para style="q1" vid="REV 4:8">“पवित्र, पवित्र, पवित्र, सर्वसक्तिमान प्रभु परमेस्वर,</para>
  <para style="q2" vid="REV 4:8">जो रहै, और जो है, और जो आनबारो है।”<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="ISA 6:2-3">यसायाह 6:2-3</ref></char></note><verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />चार जिंदे जीव महिमा सम्मान और धन्यवाद के गीत गाथैं और सिंहासन मैं बैठन बारेन को धन्यवाद करथैं, जो हमेसा और हमेसा के ताहीं रहथै। जब बे ऐसो करथैं,<note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="DAN 12:7">दानिय्येल 12:7</ref></char></note> <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />तौ चौबीसो बड़े-बूढ़े सिंहासन पर बैठन बारे के सामने गिरकै हमेसा और हमेसा जिंदे रहन बारेन कै दन्डवत करथैं। बे अपने मुकुट सिंहासन के सामने नीचे डारंगे और आराधना करत भै कहंगे:<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 47:8">भजन संहिता 47:8</ref></char></note><verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“हे हमरे प्रभु, और परमेस्वर, तहीं महिमा,</para>
  <para style="q2" vid="REV 4:11">और आदर, और सामर्थ्य के योग्य है;</para>
  <para style="q1" vid="REV 4:11">काहैकि तहीं सब चीज सृजाओ</para>
  <para style="q2" vid="REV 4:11">और तेरिये इच्छा से, बे अस्तित्व मैं रहैं और सृजे गै।”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">मुहरबन्द किताब और मेम्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />और जो सिंहासन मैं बैठो रहै, मैं बाके दहने हात मैं एक किताब देखो, जो भीतर और बाहर से लिखी भइ रहै, और बौ सात मुहर लगाएकै बन्द करी गई रहै।<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="EZK 2:9-10">यहेजकेल 2:9-10</ref></char></note> <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />फिर मैं एक सामर्थी स्वर्गदूत कै देखो, जो ऊँची अबाज से जौ प्रचार करत रहै, “जौ किताब कै खोलन और बाकी मुहरैं तोड़न के योग्य कौन है?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />और न स्वर्ग मैं, न पृथ्वी मैं, न पृथ्वी के नीचे<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">मरे भैन की दुनिया</char></note> कोई बौ किताब कै खोलन या बामै नजर डारन के काबिल निकरो। <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />मैं फूट-फूट कै रोन लगो काहैकि बौ किताब कै खोलन, या बामै नजर करन के काबिल कोई ना मिलो। <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />फिर बड़े-बूढ़ेन मैं से एक मोसे कही, “मत रो। देख! यहूदा के बंस को सेरा, जो दाऊद को महान मूल है, जो बिजय पाए चुको है, और बौ सात मुहरन कै तोड़कै किताब कै खोल सकथै।”<note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">उत्पत्ति 49:9</ref>; <ref loc="ISA 11:1">यसायाह 11:1</ref>; <ref loc="ISA 11:10">यसायाह 11:10</ref></char></note><verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />फिर मैं एक मेम्‍ना कै सिंहासन के बीच मैं ठाड़ो देखो, जो चारौ जीव और बड़े-बूढ़ेन से घिरो भौ रहै। ऐसो लगत रहै कि मेम्ना मारो गौ रहै। बाके सात सींग और सात आँखी रहैं, जो परमेस्वर की सात आत्मा हैं जो पूरी पृथ्वी मैं भेजी गई हैं।<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ZEC 4:10">जकर्याह 4:10</ref></char></note> <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />मेम्ना जाएकै सिंहासन मैं बैठन बारे के दहने हात से किताब कै लई। <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />जैसिये बौ किताब लई, चारौ जिंदे जीव और चौबीस बड़े-बूढ़े मेम्ना के अग्गु गिर पड़े। हर एक के हात मैं वीड़ाँ और लोहबान धूप से भरे सोने के कटोरा रहैं, जो परमेस्वर के पवित्र लोगन की प्रार्थना है।<note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="REV 5:14">प्रकासितवाक्य 5:14</ref>; <ref loc="REV 19:4">19:4</ref></char></note> <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />और बे जौ नया गीत गान लगे:</para>
  <para style="q1" vid="REV 5:9">“तू जौ जिंदगी की किताब कै लेन</para>
  <para style="q2" vid="REV 5:9">और बाकी मुहरैं खोलन के काबिल है;</para>
  <para style="q1" vid="REV 5:9">काहैकि तैं वध हुईकै अपने खून से हर एक कुल, रास्ट्र, भासा, लोग, और जाति मैं से</para>
  <para style="q1" vid="REV 5:9">परमेस्वर के ताहीं लोगन कै मोल लौ है।”<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />“और तू उन्हैं हमरे परमेस्वर की महिमा करन के ताहीं पुजारी<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">पुजारी</char></note> को राज्य ठहराओ है,</para>
  <para style="q2" vid="REV 5:10">और बे पृथ्वी मैं राज्य करंगे।”<note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="REV 1:6">प्रकासितवाक्य 1:6</ref></char></note><verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />फिर मैं जब देखो, और मैं स्वर्गदूतन कै सुनो, उनमैं से हजारौ और लाखौ! सिंहासन के चारौ तरफ ठाड़े रहैं, चार जिंदे जीव, और चार बड़े-बूढ़े लोग, <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />और बे ऊँचे सुर मैं गाथैं:</para>
  <para style="q1" vid="REV 5:12">“जो मेम्ना मारो गौ बौ सामर्थ्य,</para>
  <para style="q2" vid="REV 5:12">और धन, और बुद्धि, सक्ति, और आदर,</para>
  <para style="q2" vid="REV 5:12">और महिमा, और स्तुति के काबिल है!”<verse eid="REV 5:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="REV 5:13" />और मैं स्वर्ग मैं, और पृथ्वी मैं, और पृथ्वी के नीचे की दुनिया मैं, और समुंदर के सब जिंदे जीव कै जौ गात भइ सुनो:</para>
  <para style="q1" vid="REV 5:13">“जो सिंहासन मैं बैठो है, बाकी, और मेम्ना कि स्तुति,</para>
  <para style="q2" vid="REV 5:13">और आदर, और महिमा, और राज्य,</para>
  <para style="q1" vid="REV 5:13">हमेसा<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">हमेसा और हमेसा</char></note> रहबै<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">हमेसा और हमेसा रहबै</char></note>!”<verse eid="REV 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />और चारौ जिंदे जीव जबाब दईं, “आमीन!” और बड़े-बूढ़े गिरकै आराधना करीं।<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">मुहरैं</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />फिर मैं देखो कि मेम्ना बे सात मुहर मैं से पहली मुहर कै तोड़ी है, और मैं चार जिंदे जीव मैं से एक कै गड़गड़ाहट की अबाज मैं जौ कहत सुनो, “आ!” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />मैं देखो, एक सफेद घोड़ा है, और बामै सवार धनुस लै भै है, और बाकै एक मुकुट दौ गौ। और बौ जीतन के ताहीं एक विजेता के हानी बाहर निकरो है।<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />जब मेम्ना दूसरी मुहर तोड़ी, तौ मैं दूसरे जीव कै जौ कहत भइ सुनो, “आ!” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />फिर एक और घोड़ा निकरो, जो लाल रंग को रहै; बाके सवार कै पृथ्वी मैं से सांति उठाए लेन की आग्या दई गई, ताकी लोग एक दूसरे कै मार डारैं। बाकै एक बड़ी तलवार दई गई।<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />जब मेम्‍ना तीसरी मुहर कै तोड़ी, तौ मैं तीसरे जीव कै जौ कहत सुनो, “आ।” और मैं देखो, एक कारो घोड़ा है; और बाके सवार के हात मैं एक तखरी है।<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">जकर्याह 6:2</ref>,<ref loc="ZEC 6:6">6</ref></char></note> <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />मैं सुनो कि चारौ जिंदे जीव के बीच मैं से एक अबाज आए रइ है, “एक दिन की मजदूरी के ताहीं एक किलो गेंहूँ, और एक दिन की मजदूरी के ताहीं तीन किलो जई। लेकिन तेल और दाखरस की बारिन कै नुकसान मत पहोंचाबौ!”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />और तौ मेम्ना चौथी मुहर तोड़ी; तौ मैं चौथे जीव को सब्द जौ कहत सुनो, “आ!” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />मैं देखो, कि एक पेरो घोड़ा है; और बाकी सवारी करन बारे को नाओं मौत है; और नरक<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">मरे भै की दुनिया</char></note> बाके पच्छू-पच्छू है और बाकै पृथ्वी की एक चौथाई मैं जौ अधिकार दौ गौ, कि तलवार, और अकाल, और रोग, और पृथ्वी के जानवर के जरिये लोगन कै मार डारैं।<note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="JER 15:2-3">यिर्मयाह 15:2-3</ref></char></note><verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />तौ मेम्ना पाँचवी मुहर कै तोड़ी। मैं बेदी के नीचे बे लोगन की जान देखो जो मारे गै रहैं काहैकि बे परमेस्वर को बचन पूरे मन से सुनाई रहैं और अपनी गभाई मैं भरोसेमंद रहैं। <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />बे बड़े ऊँची अबाज से चिल्लाए कै कहीं, “सर्वक्तिमान प्रभु, पवित्र और सच्चो! तू कबले पृथ्वी के लोगन को न्याय करैगो और हमरे खून को बदला लेगो?”<note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="REV 16:5-6">प्रकासितवाक्य 16:5-6</ref></char></note> <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />और उनमैं से हर एक कै सफेद चोंगा दौ गौ रहै, और उनसे कहो गौ कि और थोड़ी देर ले इंतजार करौ, जबले कि तुमरे संगी दास और भईय्या जो तुमरे हानी मरन बारे हैं, उनकी भी गिनती पूरी ना हुई लेबै।<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />और मैं मेम्ना कै छठमीं मुहर खोलत भै देखो। तौ एक बड़ो हालाचाला आओ, और सूरज कम्मर के तराहनी कारो हुई गौ, और जोनी पूरी खून के तराहनी लाल हुई गई। <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />और आसमान के तारा पृथ्वी मैं गिर पड़े, जैसे बड़ी आँधी से हिलकै अंजीर के पेंड़ मैं से कच्चे फल झरथैं।<note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="ISA 34:4">यसायाह 34:4</ref></char></note> <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />आसमान एक जिंदगी की किताब के तराहनी लुढ़काओ गौ, और हर एक पहाड़ और टापू, अपने-अपने जघा से सरक गै। <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />तब पृथ्वी के राजा, और प्रधान, और सरदार, और धनवान और सामर्थी लोग, और हर एक दास, और हर एक स्वतंत्‌र, पहाड़न की गुफा और चट्टानन मैं जाएकै लुक गै। <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />और पहाड़न, और चट्टानन से पुकारकै कहेन लागे, “हमरे ऊपर गिर पड़ौ; और हमैं बाके सिंहासन मैं बैठन बारे की आँखी से और मेम्ना के प्रकोप से लुकाए लियौ! <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />काहैकि उनके प्रकोप को भयानक दिन आए पहुँचो है, अब बाको सामना कौन कर सकथै?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">इस्राएल के एक लाख चौवालीस हजार लोग</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />जाके बाद मैं पृथ्वी के चारौ कोने मैं चार स्वर्गदूत ठाड़े भै देखो, बे पृथ्वी की चारौ ब्यार कै रोके पड़े रहैं कि न तौ ब्यार पृथ्वी मैं, और न समुंदर मैं, और न कोई पेंड़ से टकराबै। <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />और मैं एक स्वर्गदूत कै जीवते परमेस्वर कि मुहर के संग अगार घाँईं से आत देखो। बौ बे चारौ स्वर्गदूतन कै ऊँची अबाज मैं पुकारी जिन्हैं परमेस्वर पृथ्वी और समुंदर कै नुकसान पहोंचान की सक्ति दई रहै। <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“जबले हम अपने परमेस्वर के सब दास के माथे मैं मुहर ना लगाए देमैं, तौले पृथ्वी, समुंदर या पेंड़न कै नुकसान मत पहुँचइयो।” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />और मोकै बताओ गौ जिन लोगन के माथे मैं परमेस्वर की मुहर लगी भइ है, उनकी गिनती एक लाख चौवालीस हजार है। बे इस्राएल के बारह गोत्र मैं से रहैं, <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />यहूदा के गोत्र मैं से बारह हजार मैं मुहर दई गई, रूबेन के गोत्र मैं से बारह हजार मैं, गाद के गोत्र मैं से बारह हजार मैं, <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />असेर के गोत्र मैं से बारह हजार मैं, नप्ताली के गोत्र मैं से बारह हजार मैं; मनस्से के गोत्र मैं से बारह हजार मैं, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />सिमौन के गोत्र मैं से बारह हजार मैं, लेवी के गोत्र मैं से बारह हजार मैं, इस्साकार के गोत्र मैं से बारह हजार मैं मुहर दई गई, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />जबूलून के गोत्र मैं से बारह हजार मैं, यूसुफ के गोत्र मैं से बारह हजार मैं, और बिन्यामीन के गोत्र मैं से बारह हजार मैं मुहर दई गई।<verse eid="REV 7:8" /></para>
  <para style="s">बड़ी भीड़</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />जाके बाद मैं देखो, हूँना एक बड़ा बड़ी भीड़ रहै, कोई भी सब लोगन की गिनती नाय कर सकत रहै! सब जाति, कुल, देस और भासा के रहैं, और बे सिंहासन और मेम्ना के सामने सफेद चोंगा पहने भै और हातन मैं खजूर कि हँगईय्या पकड़े भै ठाड़े रहैं। <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />बे ऊँची अबाज से पुकारीं: “उद्धार हमरे परमेस्वर के घाँईं से, जो सिंहासन मैं बैठो है, और मेम्ना के घाँईं से है!” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />सब स्वर्गदूत सिंहासन के चारौ तरफ ठाड़े रहै, बड़े-बूढ़े और चार जिंदे जीव। तौ बे सिंहासन के सामने अपनो मोहों नीचे करीं, और परमेस्वर की आराधना करी, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />कहीं, “आमीन! हमरे परमेस्वर की स्तुति, महिमा, ग्यान, धन्यवाद, आदर, सामर्थ्य और सक्ति हमेसा और हमेसा के ताहीं बनी रहबै! आमीन!”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />बड़े-बूढ़ेन मैं से एक मोसे पूँछी, “सफेद चोंगा पहने भै जे लोग कौन हैं, और कहाँ से आए हैं?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />मैं जबाब दौ, मालिक, “मोए नाय मालुम, तहीं जानथै।” बौ मोसे कही, “जे बे लोग हैं जो भयानक जुलम से सई सलामत निकर आए हैं। जे अपने चोंगा मेम्ना के खून मैं धोएकै सफेद करी हैं। <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />जौ बजह से बे परमेस्वर के सिंहासन के सामने ठाड़कै बाके मंदिर मैं रात-दिन बाकी आराधना करथैं। जो सिंहासन मैं बैठो है, बौ अपनी हजूरी से उनकी रक्छा करैगो। <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />बे फिर कहुए भूंके या प्यासे ना होंगे; न तौ सूरज और न कड़कती गर्मी उनकै जलागी। <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />काहैकि मेम्ना जौ सिंहासन के बीच मैं है, उनको बरदिया होगो, और बौ उनकै जिंदगी देनबारे पानी के सोता के झोने लैजाबैगो। और परमेस्वर उनकी आँखी से सब आँसु पोंछ डारैगो।”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">सातवी मुहर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जब मेम्ना सातवी मुहर खोली, तौ स्वर्ग मैं लमसम आधे घंटा ले सन्नाटा पसरो रहो। <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />और मैं बे सातौ स्वर्गदूतन कै देखो जो परमेस्वर के सामने ठाड़े रहैं, और उनकै सात तुरहियाँ दई गईं।<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />फिर एक और स्वर्गदूत सोने को धूपदान लै भौ आओ, और बेदी मैं ठाड़गौ। बाकै परमेस्वर के सब पवित्र लोगन की प्रार्थना मैं जोड़न के ताहीं और सिंहासन के सामने सोने की बेदी ऊपर चढ़ान के ताहीं भौत धूप दई गई रहैं। <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />और बौ धूप को धुआँ पवित्र लोगन की प्रार्थना समेत स्वर्गदूत के हात से परमेस्वर के सामने पौहौंच गौ।<note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="PSA 141:2">भजन संहिता 141:2</ref></char></note> <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />तौ स्वर्गदूत धूपदान<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">जोसे धुआँ निकरथै</char></note> लैकै बेदी की आगी से भर दईं, और धरती मैं फेंक दई। जोसे बादर गड़गड़ान लागो और बिजली की चमक और हालाचाला होन लागो।<verse eid="REV 8:5" /></para>
  <para style="s">तुरहियाँ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />तभई सातौ स्वर्गदूत जिनके झोने सात तुरहई रहैं फूँकन के ताहीं तैयार भै।<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />पहलो स्वर्गदूत तुरहई फूँकी। खून से सने ओला और आगी पृथ्वी मैं बरसन लगे। और एक तिहाई पृथ्वी जल गई, और एक तिहाई पेंड़ और हरी घाँस एका एक जल गई।<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />फिर दुसरो स्वर्गदूत तुरहई फूँकी। तौ मानौ आगी के हानी जलत भौ एक बड़ो पहाड़ समुंदर मैं फेंक दौ गौ। और समुंदर भी एक तिहाई खून मैं बदल गौ, <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />और समुंदर के एक तिहाई भीतरी जिंदे जीव मर गै, और एक तिहाई जहाज नास हुईगै।<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />फिर तीसरो स्वर्गदूत तुरहई फूँकी। और एक बड़ो तारा जो मसाल के तराहनी जलत भौ स्वर्ग से टूटो और नदिया के एक तिहाई पानी के झरना मैं गिर पड़ो। <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />बौ तारा को नाओं “कड़वा” है। और एक तिहाई पानी कड़वा जैसो कड़वो हुई गौ, और भौत से इंसान बौ पानी पीन से मर गै।<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />फिर चौथो स्वर्गदूत तुरहई फूँकी। और सूरज को एक तिहाई, और जोनी को एक तिहाई, और तारन को एक तिहाई हिस्सा अंधियारे मैं हुई गौ, और एक तिहाई चमक उजियारो की चली गई; दिन को एक तिहाई और रात की एक तिहाई के चलते कोई उजियारो नाय रहो।<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />जब मैं फिर देखो, तौ आसमान के बीच मैं एक गिद्धा कै उड़त और ऊँची अबाज से जौ कहत सुनो, “बे तीन स्वर्गदूतन की तुरहई के सब्दन के कारड़ जिनको फूँकनो हबै बाकी है, जौ उनके ताहीं कितनो भयानक, भयानक और भयानक होगो जो पृथ्वी मैं रहथैं!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />बाके बाद पाँचमों स्वर्गदूत तुरहई फूँकी। तौ मैं आसमान से पृथ्वी मैं एक तारा गिरत भइ देखो, और बाकै अधोलोक<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">जो जघा धरती के भीतर है हुँआँ दुस्टआत्मा कै बंधी बनाए के रखो जाथै</char></note> की चाबी दई गई रहै। <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />तारा अधोलोक कै खोल दई, और कुंड मैं से बड़ी भट्टी के हानी धुआँ उठो, और कुंड के धुआँ से सूरज की चमक और ब्यार कारी हुई गौ।<note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JOL 2:10">योएल 2:10</ref>; <ref loc="JOL 2:30">2:30</ref></char></note> <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />बौ धुआँ मैं से टींड़ा धरती मैं उतरे, और उनकै बैसिये ताकत दई जैसे सब बीछी मैं होथै। <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />उनसे कहो गौ कि बे पृथ्वी की घाँस या पेंड़ या पौधन कै नुकसान न पहोंचामैं; बे सिरफ बे लोगन कै नुकसान पहोंचाय सकथैं जिनके माथे मैं परमेस्वर की मुहर को चिन्ह ना है। <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />टींड़न कै उन लोगन कै मारन की इजाजत नाय रहै, बल्कि उन्हैं सिरफ पाँच महेना ले सतान की इजाजत रहै। और उनको दर्द ऐसो रह, जैसे बीछी के डंक मारन से इंसान कै दर्द होथै। <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />पाँच महेना के दौरान बे मौत कै ढूँड़ंगे, लेकिन बाकै ना पामंगे; बे मरनो तौ चाहंगे, लेकिन उनके झोने से मौत भाज जाबैगी।<note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">अय्यूब 3:21</ref>; <ref loc="JER 8:3">यिर्मयाह 8:3</ref></char></note><verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />टींड़ा लड़ाई के ताहीं तैयार घोड़न के तराहनी दिखत रहैं; उनकी मुड़िया मैं सोने के मुकुट रहैं, और उनके चैहरा इंसान के जैसे रहैं। <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />उनके बार बईंय्यरन के बार जैसे रहैं, और उनके दाँत सेरा के दाँत जैसे रहैं। <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />उनकी छाती लोहे की कवच से ढकी भइ रहै, और उनके पखमा की अबाज ऐसी रहै जैसे रथ और भौत से घोड़ा लड़ाई मैं भाजत होमैं।<note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="JOL 1:6">योएल 1:6</ref></char></note> <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />उनकी बीछी तराहनी पूँछ और डंक रहैं, और उन्हैं पाँच महेना ले लोगन कै नुकसान पहोंचान की सक्ति मिली रहै। <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />उनको एक राजा उनके ऊपर राज करथै, जो अधोलोक को दूत है। बाको नाओं इब्रानी मैं अबद्दोन; और यूनानी मैं अपुल्लयोन है, जाको मतलब है “विनासक।”<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पहलो आतंक खतम हुई गौ है; जाके बाद दुई और भयानक आतंक आनबारे हैं।<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />फिर छठमों स्वर्गदूत तुरहई फूँकी। मैं परमेस्वर के सामने ठाड़ी सोने की बेदी के चारौ कोने से जौ अबाज सुनो। <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />और अबाज के जरिया छठमें स्वर्गदूत से तुरहई फूँक कै कही, “बे चार स्वर्गदूतन कै छोड़ जो बड़ी नदिया फरात के पास बंधे भै हैं!” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />बे चारौ स्वर्गदूतन कै छोड़ दौ गौ है; जो बौ घड़ी, और महेना, और साल के ताहीं इंसानन की एक तिहाई कै मार डारन कै तैयार करे गै रहैं। <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />मोए घुड़सवार फौज की गिनती बताओ गौ: जो बीस करोड़ रहै। <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />और अपने दर्सन मैं घोड़ा और उनके सवारन कै देखो: जिनके कवच आगी के तराहनी लाल, नीलम के तराहनी नीलो, और गंधक के तराहनी पेरे रहैं। और बे घोड़न की मुड़िया सेरा की मुड़िया के तराहनी रहैं, और उनके मोहों से आगी, धुआँ और गंधक निकरत रहै। <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />जे तीनौ महामारियन: मतलब आगी, धुआँ, गंधक जो घोड़न के मोहों से निकरत रहै, बासे इंसान एक तिहाई मर गै। <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />काहैकि बे घोड़न की ताकत उनके मोहों मैं और उनकी पूँछन मैं भी रहै। और उनकी पूँछ साँपन की मुड़िया के तराहनी रहैं, और बे लोगन कै नुकसान पहोंचान के ताहीं बाको इस्तमाल करत रहैं।<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />बाकी के बचे भै इंसान, जो बे सब महामारी से न मरे रहैं, बे अपने हात के कामन से न मन फिराईं। बे ना तौ प्रेत आत्मा की आराधना करनो छोड़ीं, और ना सोने, चाँदी, पीतल, पथरा, और कठिया की मूर्तियन की पूजा करनो छोड़ीं, जो ना तौ देख, ना सुन, ना चल सकथैं। <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />और बे जो हत्या, और टोना, और व्यभिचार, और चोरी, करी रहैं, उनसे मन ना फिराईं।<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">स्वर्गदूत और छोटी किताब</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />फिर मैं एक और सक्तिसाली स्वर्गदूत कै स्वर्ग से उतरत भै देखो। बौ एक बादर मैं लिपटो भौ रहै और बाकी मुड़िया के चारौ तरफ एक मेंहें धनुस रहै; और बाको मोहों सूरज के हानी और बाके पाँव आगी के खम्मा के हानी रहैं। <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />और बाके हात मैं एक छोटी किताब खुली रहै। बौ अपनो दहनो पाँव समुंदर मैं और बौ पृथ्वी मैं रखी, <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />और बड़े ऊँचे अबाज मैं चिल्लाई जैसो सेरा गरजथै। बाके चिल्लान के बाद, तौ गरजन के संग मैं सात जबाब मिले। <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />उनके बोलतै खिना मैं लिखत रहौं। लेकिन स्वर्ग से मैं जौ अबाज सुनो, “कि जो बातैं गरजन के बे सात अबाज कै सुनो है, उनकै मुहरबन्द करकै रखिये; और जाकै मत लिखिये!”<note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DAN 8:26">दानिय्येल 8:26</ref>; <ref loc="DAN 12:4">दानिय्येल 12:4</ref></char></note><verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />फिर जो स्वर्गदूत कै मैं समुंदर और जमीन मैं ठाड़ो देखो, बौ अपने दहने हात कै स्वर्ग के घाँईं उठाई<note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="DEU 32:40">व्यवस्थाविवरन 32:40</ref></char></note> <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />और परमेस्वर के नाओं से मन्नत माँग कै कह, जो हमेसा जिंदो है, जो आकास, पृथ्वी और समुंदर और बामै जो कछु है, सबकै जन्माई है! स्वर्गदूत कही, “अब और देर न होगी!”<note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="REV 4:11">प्रकासितवाक्य 4:11</ref></char></note> <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />“लेकिन जब सातमों स्वर्गदूत अपनी तुरहई फूँकैगो, तौ परमेस्वर अपनी गुप्त मैं लुकी योजना कै पूरी करैगो, जैसो बौ अपने दास भविस्यवक्तन कै सुसमाचार देन कै कही रहै।”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />फिर बौ अबाज जोमैं स्वर्ग से बोलत भै सुनो रहौं, बौ फिर मोसे कही, “जा, जो स्वर्गदूत समुंदर और पृथ्वी मैं ठाड़ो है, बाके हात मैं की खुली भइ किताब लै ले।”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />मैं स्वर्गदूत के झोने जाएकै बासे कहो कि जौ छोटी किताब मोकै दैदे। और बौ मोसे कही, “जाकै ले, और खाए ले; जौ तेरे पेट कै कड़वो तौ करैगी, पर तेरो मोहों सहद जैसो मीठो लगैगो।”<note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="EZK 3:1-3">यहेजकेल 3:1-3</ref></char></note><verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />और मैं बौ छोटी किताब बौ स्वर्गदूत के हात से लैकै खाए लौ, और बाको स्वाद मेरे मोहों मैं सहद के जैसो मीठो लगो। लेकिन जब मैं बाकै निगल लौ, तौ बौ मेरे पेट मैं कड़वो हुई गौ। <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />तौ मोसे कहो गौ, “जौ जरूरी है कि तैं दुबारा तमान प्रजाति, देस, भासा और राजन के बारे मैं परमेस्वर के घाँईं से भविस्यवाँड़ी कर।”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">दुई गभा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />फिर मोकै एक छड़ी दई गई, जो नापन की छड़ी के तराहनी दिखत रहै, और कोई कही, “जा और परमेस्वर के मंदिर और बेदी नाप ले, और बे लोगन की गिनती कर जो मंदिर मैं आराधना करथैं। <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />लेकिन मंदिर के बाहर के आँगन कै मत नाप, काहैकि बौ गैर यहूदिन कै दौ गौ है, और बे पवित्र सहर कै बयालिस महेना ले रौंदंगे। <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />मैं टाट ओढ़े भै अपने दुई गभा कै भेजंगो, और बे एक हजार दुई सौ साठ दिन ले परमेस्वर के संदेस की भविस्यवाँड़ी करंगे।”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />बे दुई गभा हैं, दुई जैतून के पेंड़ और दुई डीट जो पृथ्वी के प्रभु के सामने ठाड़े रहथैं।<note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">जकर्याह 4:3</ref></char></note> <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />और अगर कोई उनकै नुकसान पहोंचान की कोसिस करै, तौ उनके मोहों से आगी निकरकै उनके बैरियन कै नास करथै; और जो कोई उनकै नुकसान पहोंचान की कोसिस करैगो, बौ मार डारो जागो।<note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="JER 5:14">यिर्मयाह 5:14</ref></char></note> <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />उनके झोने आसमान कै बंद करन को हक है, ताकी जब बे परमेस्वर को संदेस सुनामैं, बौ समय मेंहें ना बरसै। बे पानी के सोता मैं भी अधिकार रखथैं, कि उन्हैं खून भी बनाये देमैं; उन्हैं जौ भी अधिकार है कि बे जित्ती बार चाँहे पृथ्वी मैं सब तरह की महामारी की मार करैं।<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />जब बे अपनी गभाई को संदेस सुनानो खतम कर लेंगे, तौ बौ जानवर जो अधोलोक मैं से निकरैगो, बौ उनसे लड़ैगो। बौ उनकै हराए कै उन्हैं मार डारैगो,<note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="REV 13:7">प्रकासितवाक्य 13:7</ref></char></note> <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />और उनकी लास बौ बड़े नगर के चौहराय मैं पड़ी रैहंगी, जो आत्मिक रीति से सदोम और मिस्र कहो जाथै, जहाँ उनको प्रभु भी क्रूस मैं चढ़ाओ गौ रहै। <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />और सब देस, कुलन, भासन, और जातिन के लोग बे लासन कै साढ़े तीन दिन ले देखत रहंगे और कबर मैं दफनान को आदेस ना देंगे। <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />इन दोनों की मौत से पृथ्वी के लोग खुस होंगे। बे जस्न मनांगे और एक-दूसरे कै भेंट भेजंगे, काहैकि बे दोनों भविस्यवक्ता पूरी मानव जाति कै बड़ा सताई रहैं। <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />साढ़े तीन दिन के बाद परमेस्वर कि तरफ से जिंदगी देन बारी आत्मा निकरी, और उनके भीतर घुस गई, और बे अपने पाँव के बल ठाड़गै, और उनके देखन बारेन के ऊपर बड़ा डर छाए गौ। <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />और बे दोनों भविस्यवक्ता स्वर्ग से एक ऊँची अबाज से जौ कहत सुनी, “हिंयाँ ऊपर आओ!” जब उनके बैरी उनकै देखीं, तौ बे बादर ऊपर चढ़कै स्वर्ग मैं चले गै। <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />बहे समय एक भैंकर हालाचाला आओ; और नगर को दसमों हिस्सा नास हुई गौ, और सात हजार लोग मारे गै। और बचे भै लोग डराय गै, और स्वर्ग के परमेस्वर की महिमा करीं।<note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="REV 14:7">प्रकासितवाक्य 14:7</ref></char></note><verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />दूसरी आफत बीत चुकी है लेकिन तीसरी भयानक आफत जल्दिये आनबारी है!<verse eid="REV 11:14" /></para>
  <para style="s">सातवी तुरहई</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />तौ सातमों स्वर्गदूत तुरहई फूँकी, तौ स्वर्ग मैं जौ बारे मैं ऊँची-ऊँची अबाज आन लगी, “अब दुनिया को राज्य हमरे प्रभु को और बाके मसीह को हुई गौ, और बौ हमेसा<note caller="+" style="f"><char style="fr" closed="false">11:15 </char><char style="ft" closed="false">हमेसा और हमेसा</char></note> राज्य करैगो।”<note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="DAN 7:27">दानिय्येल 7:27</ref>; <ref loc="ZEC 14:9">जकर्याह 14:9</ref></char></note> <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />तब चौबीस बड़े-बूढ़े जो परमेस्वर के सामने अपने-अपने सिंहासन मैं बैठे रहैं, मोहों के बल गिरकै परमेस्वर की आराधना करकै, <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />जौ कहेन लगे:</para>
  <para style="q1" vid="REV 11:17">“हे सर्वसक्तिमान प्रभु परमेस्वर, जो है और जो रहै!</para>
  <para style="q1" vid="REV 11:17">हम तेरो धन्यवाद करथैं कि</para>
  <para style="q2" vid="REV 11:17">तैं अपनी बड़ी सामर्थ्य लैकै राज्य करनो सुरु कर दौ है!<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />गैर यहूदि गुस्सा से भर गै,</para>
  <para style="q2" vid="REV 11:18">काहैकि तुमरे ऊपर गुस्सा करन को समय आए गौ है,</para>
  <para style="q2" vid="REV 11:18">मरे भैन को न्याय करन को समय आए गौ है।</para>
  <para style="q1" vid="REV 11:18">अपने सेवक, भविस्यवक्तन और पवित्र लोगन कै इनाम देन को समय आए गौ है,</para>
  <para style="q2" vid="REV 11:18">जो तेरे ताहीं आदर रखथै चाँहे बे छोटे-बड़े के जैसे होमैं।</para>
  <para style="q2" vid="REV 11:18">पृथ्वी कै नास करन बारेन कै नास करन को समय आए गौ है!”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />स्वर्ग मैं परमेस्वर को मंदिर खोलो गौ, और वाचा को बक्सा हुँआँ देखो गौ। फिर बिजली चमकी, और ऊँचे अबाज से गड़गड़ाहट भइ और हालाचाला भौ, और बड़ा ओला पड़े।<note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="REV 15:5">प्रकासितवाक्य 15:5</ref></char></note><verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">औरत और विसालकाय अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />फिर स्वर्ग मैं एक बड़ो और रहस्यमयी चिन्ह दिखाई दई। एक औरत जोको पहनावा सूरज रहै, और बाके पाँव तरे जोनी रहै, और बाके मुड़िया मैं बारह तारन को मुकुट रहै। <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />बौ जल्दिये जनम देन बारी रहै, काहैकि प्रसव को दर्द और पीड़ा बाकै रुबाए दई।<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />आसमान मैं एक और रहस्यमयी चिन्ह दिखाई दई। हूँना सात खुपड़िया और दस सींगन बारो एक बड़ो लाल अजगर रहै और बाकी हर खुपड़िया ऊपर मुकुट रहै। <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />बौ अपनी पूँछ से आसमान से एक तिहाई तारन कै खींचकै पृथ्वी मैं फेंक दई, और बौ अजगर बौ औरत के सामने ठाड़गौ, कि जब बौ बालका पैदा करै तौ बौ बालका कै निगल जाबै। <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />तभई बौ एक बेटा कै जनम दई, जो लोहे की छड़ी से सब देस की जाति के ऊपर राज्य करैगो। लेकिन बच्चा कै छीन कै परमेस्वर के सिंहासन के झोने लैजाओ गौ। <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />और बौ औरत बौ जंगल मैं भाज गई, जहाँ परमेस्वर के घाँईं से बाके ताहीं एक जघा तैयार करी गई रहै, ताकी हुँआँ बाकी देखरेख तीन साल चार महेना ले करी जाबैगी।<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />फिर स्वर्ग मैं लड़ाई छिड़ गई, मीकाईल और बाके दूत अजगर से और बाके दूतन से लड़ीं; <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />लेकिन अजगर हार गौ, और बाकै और बाके दूतन कै फिर स्वर्ग मैं रहन कि इजाजत नाय दई गई। <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />विसाल अजगर कै बाहर फेंक दौ गौ, बौ पुरानो साँप, जोको नाओं इब्लीस या सैतान रहै, जो पूरी दुनिया कै धोका दई रहै। बौ और बाके सब दूतन कै बाके संग पृथ्वी मैं फेंक दौ गौ।<note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="JHN 12:31">यूहन्ना 12:31</ref></char></note><verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />तभई मैं स्वर्ग मैं एक ऊँची अबाज सुनो, “अब परमेस्वर को उद्धार और राज्य आए गौ है! अब परमेस्वर राजा के रूप मैं अपनी सामर्थ्य दिखाई है! अब बाको मसीहा अपनो अधिकार दिखाई है! काहैकि जो हमरे परमेस्वर के सामने ठाड़ो रहै, और रात-दिन हमरे भईय्यन के ऊपर दोस लगात रहो, बाकै स्वर्ग से निकार दौ गौ।<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 11:15">प्रकासितवाक्य 11:15</ref></char></note> <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />बौ मेम्ना के खून और सत्य की गभाई के जरिया जोको प्रचार करी रहै, बामै जय पाई; और बे अपनी ज्यान से इतनो प्रेम नाय करीं कि बे मरन कै तैयार नाय होमैं। <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />और हे स्वर्ग, और हूँना सब रहन बारेयौ खुसी मनाबौ! लेकिन पृथ्वी और समुंदर के ताहीं कितनो भयानक है! काहैकि सैतान तुम्हारे झोने उतर आओ है, और बौ गुस्सा से भरगौ है, काहैकि बौ जानथै, कि बाके पास थोड़िये समय है।”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />जब अजगर कै पता चलो कि बाकै पृथ्वी मैं फेंक दौ गौ है, तौ बौ औरत को पीछा करनो सुरु कर दई जो बौ बालक कै जनम दई रहै। <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />बाकै रेगिस्तान मैं अपनी जघा मैं उड़न के ताहीं एक बड़े गिद्धा के दुई पंख दै गै रहै, जहाँ अजगर के हमला से बाकी साढ़े तीन साल ले देखरेख करी जागी, <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />तौ अजगर अपने मोहों से बौ औरत के पिच्छू पानी की धार बहाई, कि बौ बाकै बहाए लै जाए। <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />लेकिन पृथ्वी बौ औरत की मदत करी, बौ अपनो मोहों खोली और बौ पानी कै निगल लई जो अजगर के मोहों से निकरो रहे। <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />तौ अजगर बौ औरत के ऊपर गुस्सा भौ, और बाकी बची भइ सन्तान से लड़न कै चले गौ, जो परमेस्वर कि आग्यन कै मानथैं और ईसु की गभाई देन ताहीं वफादार है। <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />और बौ अजगर समुंदर के किनारे ठाड़गौ।<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">दुई जानवर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />तभई मैं एक जानवर कै समुंदर मैं से बाहर आत भइ देखो। बाकी दस सींग और सात खोपड़ी रहैं; बाके हर एक सींग मैं एक मुकुट रहै, और बाके हर एक खोपड़ी मैं एक नाओं रहै जो परमेस्वर की बुराई करत रहै।<note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">दानिय्येल 7:3</ref>; <ref loc="REV 12:3">प्रकासितवाक्य 12:3</ref></char></note> <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />बौ जानवर एक तेंदुआ के हानी दिखात रहै, बाके पाँव भलुआ के तराहनी और मोहों सेरा के तराहनी रहै। और अजगर बौ जानवर कै अपनी सामर्थ्य, और सिंहासन और बड़ो अधिकार दै दई। <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />ऐसो लगत रहै कि जानवर की एक मुड़िया मैं गहरो घाव है, लेकिन घाव ठीक ही गौ रहै। पूरी पृथ्वी अचम्भित भइ और बौ जानवर के पच्छू हुई लईं। <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />सब जनी बौ अजगर की आराधना करीं, काहैकि बौ बौ जानवर कै अपनो अधिकार दई रहै। बे बहो जानवर की भी आराधना करीं, और कहीं, “जानवर के जैसी कौन है? जाके खिलाप कौन लड़ सकथै?”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />जानवर कै गरब करन को अधिकार दौ गौ रहै जो परमेस्वर को बुराई करत रहैं, और बाकै बयालिस महेना के ताहीं अधिकार रखन की इजाजत दई गई रहै। <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />बौ परमेस्वर कै, बाके नाओं कै, बाके रहन की जघा मतलब तम्बु कै, और बे सबन कै जो स्वर्ग मैं रहत रहैं, स्राप देन लगो। <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />बाकै परमेस्वर के पवित्र लोगन के खिलाप लड़ाई करन और उन्हैं हरान की इजाजत दई गई रहै, और हर एक गोत्र, देस, भासा और जाति ऊपर अधिकार दौ गौ रहै।<note caller="+" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">दानिय्येल 7:21</ref></char></note> <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />पृथ्वी मैं रहन बारे सब लोग बाकी आराधना करंगे, सिवाय बे लोगन के जिनके नाओं दुनिया की रचना से पहले बौ जिंदगी की किताब मैं लिखे गै रहैं, जो बौ मेम्ना को है जो घात करो गौ रहै।<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />“सुनौ, जोके पास कान होमैं बौ सुन लेबै! <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />जो भी पकड़ो जाने है बौ जरूर पकड़ो जागो; जो कोई तलवार से मारो जाने है बौ जरूर तलवार से मारो जागो। जौ परमेस्वर के पवित्र लोगन के घाँईं से धीरज और बिस्वास की माँग करथै।”<verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />फिर मैं एक और जानवर देखो, जो पृथ्वी मैं से बाहर निकरो। बामै मेम्ना के जैसी दुई सींग रहैं, और बौ अजगर के हानी बोलत रहै। <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />बौ अपनी उपस्थिति मैं पहले जानवर के बड़े अधिकार को इस्तमाल करी। बौ पृथ्वी और बामै रहेन बारे सब लोगन कै बौ पहले जानवर की आराधना करन के ताहीं मजबूर करी, जोको घाव ठीक हुई गौ रहै। <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />जौ दुसरो जानवर बड़े चिन्ह चमत्कार करी; बौ सबके सामने आगी कै स्वर्ग से पृथ्वी मैं उतारी।<note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="1KI 18:24-29">1 राजा 18:24-29</ref></char></note> <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />और बौ पृथ्वी मैं रहन बारे सब लोगन कै बे चिन्ह चमत्कार के जरिया धोका दई, जिनकै पहले जानवर की उपस्थिति मैं करन की इजाजत दई गई रहै। जानवर उनकै बौ जानवर के सम्मान मैं एक मूर्ति बनान ताहीं कही जो तलवार से घायल हुई गौ रहै और फिर भी जिंदो रहै। <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />दूसरे जानवर कै पहले जानवर की मूर्ति मैं जान डारन की इजाजत दई गई, ताकी मूर्ति बात कर सकै और बे सबन कै मार डारै जो बाकी आराधना नाय करथैं।<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="DAN 3:5-6">दानिय्येल 3:5-6</ref></char></note> <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />और बौ जानवर, छोटे और बड़े, सेठ और गरीब, आजाद और दास सब लोगन के दहने हात मैं छाप लगाए दई। <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />कि बाकै छोड़ जोके ऊपर छाप मतलब बौ जानवर को नाओं, या बाके नाओं को नम्बर होबै, और दुसरो कोई बेचनों और खरीदनों न कर सकै।<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />जाके ताहीं ग्यान की जरुरत होथै। जो बुद्धिमान है, बौ जौ जानवर के नम्बर को मतलब समझ सकथै, काहैकि नम्बर कोई के नाओं के ताहीं है। जाको नम्बर छ सौ छियासठ है।<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">मेम्ना और एक लाख चौवालीस हजार लोग</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />फिर मैं देखो, बौ मेम्ना सिय्योन पहाड़ मैं ठाड़ो रहै; और बाके संग एक लाख चौवालीस हजार लोग रहैं जिनके माथे मैं बाको और बाके दऊवा को नाओं लिखो भौ रहै। <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />और मैं स्वर्ग से एक अबाज सुनो, जो गरजत भइ झरना, और गड़गड़ाहट के ऊँचे स्वर के हानी रहै। ऐसो लगत रहै जैसे वीड़ाँ बजान बारे अपनी वीड़ाँ बजाएकै संगीत बनाई होमैं। <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />एक लाख चौवालीस हजार लोग सिंहासन के सामने खड़े भै, और बे चारौ जीव, और बड़े-बूढ़े; बे एक नया गीत गात रहैं, जोकै खाली बेईं सीख सकत रहैं। जो पृथ्वी की पूरी मानव जाति मैं से सिरफ बेईं हैं जिन्हैं मोल लौ गौ है। <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />जे बे आदमी हैं जो बईंय्यरन के संग गलत सम्बंध न रखकै अपने आपकै असुद्धता से पवित्र रखीं हैं; बे कुँवारे हैं। बे मेम्ना को अनुसरँड़ करथैं। जहाँ भी बे जाथैं उन्हैं बचे भै इंसान की जाति से मोल लौ गौ है और बे परमेस्वर और मेम्ना कै सौंपे जान बारे पहले लोग हैं। <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />उन्हैं झूठ बोलन के ताहीं कहुए नाय जानो गौ है; बे निर्दोस हैं।<verse eid="REV 14:5" /></para>
  <para style="s">तीन स्वर्गदूत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />फिर मैं एक स्‍वर्गदूत कै आसमान के बीच ब्यार मैं ऊँची उड़ान भरत भै देखो, जामैं पृथ्वी के लोग, हर एक जाति, जनजाति, भासा, देस और रास्ट्र के ताहीं सुसमाचार को अनंत संदेस रहै। <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />और बौ बड़ी ऊँची अबाज मैं कही, “परमेस्वर को आदर करौ और बाकी महानता की महिमा करौ! काहैकि बौ समय आए गौ है कि बौ सब लोगन को न्याय करै। जो स्वर्ग, पृथ्वी, समुंदर और पानी के सोता बनाई है बाकी आराधना करौ!”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />फिर जाके बाद एक और दुसरो स्वर्गदूत पहले बारे को पीछा करत भै कही, “बौ गिर पड़ो है, बौ बड़ो बेबीलोन भी गिर पड़ो है जो सब देस कै अपने व्यभिचार की मधहोसी को दाखरस पिबाई।”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />फिर जाके बाद एक और तीसरो स्वर्गदूत पहले दुई को पीछा करत भै बड़ी ऊँची अबाज मैं कहत भै आओ, “जो कोई बौ जानवर और बाकी मूर्ति कि आराधना करथै और अपने माथे या अपने हाथ मैं बाकी छाप पाथैं। <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />परमेस्वर को दाखमधु, बाके जलजलाहट की दाखमधु, जोकै बौ अपने गुस्सा के प्यालो मैं पूरी ताकत से उड़ेल दई है, पीमंगे! जो ऐसो करंगे, बे पवित्र स्वर्गदूत और मेम्ना के सामने आगी की गंधक मैं तड़पंगे।<note caller="+" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">यसायाह 51:17</ref></char></note> <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />आगी को धुआँ जो उनके सताथै, बौ हमेसा के ताहीं ऊपर उठ जाथै। जो बौ जानवर और बाकी मूर्ति की आराधना करथैं, और जो बाके नाओं की छाप लेथैं, उनकै दिन-रात चैन न मिलैगो।”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />जौ परमेस्वर के पवित्र लोगन के घाँईं से धीरज धरन कि माँग करथै, जो परमेस्वर की आग्यन कै मानथै, और ईसु के प्रति भरोसेमंद हैं।<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />तौ मैं स्वर्ग से जौ अबाज सुनो, कि जौ लिख, कि धन्य हैं बे जो अब से प्रभु की सेवा मैं मरथैं! “हाँ बास्तव मैं!” आत्मा जबाब देथै। “बे अपनी कड़ी मेहनत से आराम को मजा लेंगे, काहैकि उनकी सेवा को फल उनके संग जाथै।”<verse eid="REV 14:13" /></para>
  <para style="s">पृथ्वी की फसल</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />फिर मैं देखो, एक सफेद बादर रहै, और बौ बादर मैं इंसान के लौड़ा तराहनी बैठो दिखात रहै, जोकी मुड़िया मैं सोने को मुकुट और हात मैं पैनी दरांती रहै।<note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DAN 10:16">दानिय्येल 10:16</ref></char></note> <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />तौ एक और स्वर्गदूत मंदिर मैं से निकरो, और जो बादर मैं बैठो रहै, बासे बड़ी ऊँची अबाज मैं पुकारकै कही, “अपनी दरांती को इस्तमाल कर और फसल काट, काहैकि समय आए गौ है; पृथ्वी की फसल पक चुकी है!” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />तौ जो बादर मैं बैठो रहै, बौ पृथ्वी मैं अपनी दरांती चलाई, और पृथ्वी की फसल कट गई।<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />तौ मैं एक और स्वर्गदूत कै स्वर्ग के मंदिर से निकरत भइ देखो, और बाके पास एक पैनी दरांती भी रहै।<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />फिर एक और स्वर्गदूत, जोकै जौ आगी के ऊपर अधिकार रहै, बेदी मैं से आओ, और जोके पास पैनी दरांती रहै, बाकै तेज अबाज से पुकारी, “अपनी पैनी दरांती को उपयोग कर, और अंगूर की लार कै पृथ्वी की दाखरस की बारी से काट ले, काहैकि अंगूर पक गै हैं!” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />तौ बौ स्वर्गदूत पृथ्वी मैं अपनी दरांती चलाय कै, अंगूर की लार मैं से अंगूर कै काट दई और उनकै परमेस्वर के प्रकोप के दाखरस कुंड मैं डार दई। <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />सहर के बाहर, अंगूर कै दाखरस के कुंड मैं निचोड़ो गौ, और दाखमधु के कुंड से इतनो खून निकरो, कि लमसम पाँच फिट गहरो और तीन सौ किलो मीटर ले लम्बो और घोड़न की लगाम ले पुहिगौ।<note caller="+" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">यसायाह 63:3</ref></char></note><verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">आखरी बिपत्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />फिर मैं आसमान मैं एक महान और अदभुत रहस्यमयी चिन्ह देखो, मतलब सात स्वर्गदूत जिनके पास सातौ आखरी बिपत्ति रहैं, काहैकि उनके हुई जान मैं परमेस्वर के गुस्सा को अंत है।<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />फिर मैं आगी से मिलो भै सीसा के जैसो एक समुंदर देखो, मैं बे लोगन कै भी देखो जो बे जानवर और बाकी मूर्ति मैं जीत हासिल करी रहैं, और जोको नाओं एक नम्बर से दिखाओ गौ रहै। बे सीसा के समुंदर के किनारे परमेस्वर की वीड़ाँ पकड़े भै ठाड़े रहैं, जो परमेस्वर उनकै दई रहै <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />और बे परमेस्वर के सेवक मूसा, मेम्ना को गीत गात भै कहत रहैं:</para>
  <para style="q1" vid="REV 15:3">“हे सर्वसक्तिमान प्रभु परमेस्वर,</para>
  <para style="q2" vid="REV 15:3">तेरे काम महान, और अदभुत है!</para>
  <para style="q1" vid="REV 15:3">हे देसन के राजा,</para>
  <para style="q2" vid="REV 15:3">तेरो रस्ता कित्तो धर्मी और सच्चो है!”<note caller="+" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="PSA 111:2">भजन संहिता 111:2</ref>; <ref loc="PSA 139:14">139:14</ref>; <ref loc="PSA 145:17">145:17</ref></char></note><verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />“हे प्रभु, कौन तोसे ना डरागो?</para>
  <para style="q2" vid="REV 15:4">और तेरे नाओं की महिमा ना करैगो?</para>
  <para style="q2" vid="REV 15:4">काहैकि सिरफ तू ही पवित्र है।</para>
  <para style="q1" vid="REV 15:4">और सब जाति आयकै</para>
  <para style="q2" vid="REV 15:4">तेरी आराधना करंगे,</para>
  <para style="q2" vid="REV 15:4">काहैकि तेरे न्याय के काम सब देखरै हैं।”</para>
  <para style="p" vid="REV 15:4">काहैकि तू ही एक पवित्र है जो सब देस तेरो धन्यवाद करंगे। <verse eid="REV 15:4" /><verse number="5" style="v" sid="REV 15:5" />जाके बाद मैं स्वर्ग मैं मंदिर कै खुलो देखो, जामैं साक्छी को पवित्र तम्बु रहै। <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />बे सातौ स्वर्गदूत जिनके पास सातौ बिपत्ति रहैं, बे साफ चमकदार मलमल के लत्ता पहने भै और अपनी छाती मैं सोने की कमरबंद पहने भै मंदिर मैं से निकरे। <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />फिर चार जिंदे जीव मैं से एक, बे सात स्वर्गदूतन कै परमेस्वर के गुस्सा से भरे भै, सोना के सात कटोरा दई, जो हमेसा जिंदे हैं। <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />मंदिर परमेस्वर की महिमा और बाकी सामर्थ्य के धुआँ से भरगौ रहै, और जबले बे सातौ स्वर्गदूत की सातौ आफत खतम न भईं, तौले कोई मंदिर मैं ना जाए सको।<note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ISA 6:4">यसायाह 6:4</ref></char></note><verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">परमेस्वर के गुस्सा को कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />फिर मैं मंदिर मैं से सातौ स्वर्गदूतन से ऊँची अबाज मैं जौ कहत सुनो; “जाबौ परमेस्वर के गुस्सा के सातौ कटोरा पृथ्वी मैं उड़ेल दियौ!”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />पहलो स्वर्गदूत जाएकै अपनो कटोरा पृथ्वी मैं उड़ेल दई। और जो इंसानन के ऊपर जानवर की छाप रहैं, और जो बाकी मूर्ति की आराधना करत रहैं, उनके ऊपर भयानक और दुखदाई फोड़ा दिखाई दईं।<note caller="+" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="REV 16:11">प्रकासितवाक्य 16:11</ref></char></note><verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />फिर दुसरो स्वर्गदूत अपनो कटोरा समुंदर मैं उड़ेल दई। और पानी मरे भै लोगन के खून जैसो ही गौ, और समुंदर मैं के हर एक भीतरी जिंदे जीव मर गै।<note caller="+" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="REV 8:8">प्रकासितवाक्य 8:8</ref></char></note><verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />तौ तीसरो स्वर्गदूत अपनो कटोरा नदियन, और पानी के झरनन मैं उड़ेल दई, और बे खून मैं बदल गै। <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />और मैं पानी के अधिकारी स्वर्गदूत कै जौ कहत सुनो, “हे पवित्र, तू जो है और जो रहैं, तैं धर्मी है और तैं न्याय करो है!<note caller="+" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="REV 11:17">प्रकासितवाक्य 11:17</ref></char></note> <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />काहैकि बे परमेस्वर के पवित्र लोगन और भविस्यवक्तन को खून बहाईं हैं, और तुम उन्हैं पीन के ताहीं खून दै हौ। जोके बे हकदार हैं!”<note caller="+" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="ISA 49:26">यसायाह 49:26</ref>; <ref loc="PSA 79:3">भजन संहिता 79:3</ref></char></note> <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />फिर मैं बेदी से एक अबाज सुनो, “हे सर्वसक्तिमान प्रभु परमेस्वर! तेरो न्याय सच्चो और न्याई हैं!”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />तौ चौथो स्वर्गदूत अपनो कटोरा सूरज मैं उड़ेल दई, और लोगन कै तेज घामो से जलन दौ गौ। <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />बे तेज घामो से जल गै रहै, और बे परमेस्वर के नाओं कै स्राप दई, जोके झोने जे बिपत्ति को अधिकार है। लेकिन बे अपने पापन से न मन फिराईं और ना बाकी महिमा करीं।<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />फिर पाँचमों स्वर्गदूत अपनो कटोरा जानवर के सिंहासन मैं उड़ेल दई। बौ जानवर के राज्य मैं अंधियारो छाए गौ, और लोग अपने दर्द के मारे अपनी जीभ काटन लगे,<note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 13:42">मत्ती 13:42</ref> </char></note> <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />और बे अपने दर्द और घाव की बजह से स्वर्ग के परमेस्वर कै स्राप दईं। लेकिन बे अपने बुरे काम से न मन फिराईं।<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />फिर छठमों स्वर्गदूत अपनो कटोरा महान फरात नदिया मैं उड़ेल दई। और बाको पानी सूख गौ, कि अगार दिसा के राजन के ताहीं रस्ता तैयार हुई जाबै।<note caller="+" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="ISA 44:27">यसायाह 44:27</ref></char></note> <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />और मैं बौ अजगर के मोहों से, और बौ जानवर के मोहों से और बौ झूठे भविस्यवक्ता के मोहों से तीन असुद्ध आत्मा कै मुढ़कन के रूप मैं निकरत भइ देखो। <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />बे प्रेत आत्मा की आत्मा हैं जो चिन्ह चमत्कार करथैं। जे तीन आत्मा दुनिया के सब राजा के झोने जाथैं, ताकी उन्हैं सर्वसक्तिमान परमेस्वर के महान दिन की लड़ाई के ताहीं एक संग लाओ जाए सकै।<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />“सुनौ! मैं चुट्टा के तराहनी आए रहो हौं! धन्य है बौ जो जगत रहथै, और अपने लत्तन की रखबारी करथै, ताकी बौ नंगो नाय चलै और सब लोगन के सामने बाकी बेजती ना होबै!”<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />फिर आत्मा बे राजन कै बौ जघा मैं एक संग इखट्टो करी जोकै इब्रानी मैं हरमगिदोन कहो जाथै।<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />फिर सातमों स्वर्गदूत अपनो कटोरा ब्यार मैं उड़ेल दई। और मंदिर मैं सिंहासन से एक ऊँची अबाज मैं जौ कहो गौ, “हुई गौ!” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />फिर बिजली चमकी, गड़गड़ाहट और गड़गड़ाहट की गड़गड़ाहट, एक भयानक हालाचाला रहे, इंसान की बनावट के बाद से ऐसो हालाचाला कहुए ना आओ; जौ सबसे भयानक हालाचाला रहै!<note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 24:21">मत्ती 24:21</ref> </char></note> <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />बौ महान सहर कै तीन हिस्सा मैं बाँट दौ गौ, और सब देसन के सहर खतम हुईगै। परमेस्वर बड़े बेबीलोन कै याद करी, और बाकै अपने गुस्सा से भरे भै प्याले मैं से दाखमधु पिबाई। <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />सबै टापू और पहाड़ अपनी जघा से गायब हुईगै। <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />और आसमान से पचास किलोग्राम बजन के बड़े-बड़े ओला बे लोगन के ऊपर गिरे, काहैकि जौ आफत बड़ा भयानक महामारी रहै, लोग ओला की महामारी के बजह से परमेस्वर की बुराई करीं।<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">नामी वैस्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />फिर सात स्वर्गदूतन के पास बे सात कटोरा रहैं, उनमैं से एक मेरे झोने आओ और मोसे जौ कही, “इतै आ, मैं तोकै दिखांगो कि नामी वैस्या को न्याय कैसे होगो, बौ महान सहर जो कई नदियन के किनारे बनो हैं।<note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="REV 15:1">प्रकासितवाक्य 15:1</ref>; <ref loc="JER 51:13">यिर्मयाह 51:13</ref></char></note> <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />पृथ्वी के राजा बाके संग व्यभिचार करीं, और पृथ्वी के लोग बाके व्यभिचार की दाखरस पीन से मतवाले हुईगै रहैं।”<note caller="+" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">यसायाह 23:17</ref>; <ref loc="REV 14:8">प्रकासितवाक्य 14:8</ref>; <ref loc="REV 18:3">18:3</ref></char></note><verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />फिर आत्मा मोकै काबू मैं कर लई, और स्वर्गदूत मोकै जंगल मैं लैगौ। हूँना मैं एक लाल रंग के जानवर ऊपर एक बईय्यर कै बैठो देखो, जोमैं परमेस्वर की बुराई करन बारेन के नाओं लिखे भै रहैं; बौ जानवर की सात मुड़िया और दस सींग रहैं।<note caller="+" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">दानिय्येल 7:7</ref>; <ref loc="REV 13:1">प्रकासितवाक्य 13:1</ref></char></note> <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />बौ बईय्यर बैंगनी और लाल रंग के लत्ता पहने रहै, और सोने के जेबर, कीमती मड़ी और मोतियन से सजी भइ रहै, और बाके हाथ मैं व्यभिचार और असुद्ध चीजन से भरो एक सोने को कटोरा रहै।<note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="EZK 28:13">यहेजकेल 28:13</ref>,<ref loc="EZK 28:16">16</ref>; <ref loc="JER 51:7">यिर्मयाह 51:7</ref></char></note> <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />और बाके माथे मैं एक ऐसो नाओं लिखो रहै जोको एक छिपो भौ मतलब है: “महान बेबीलोन, दुनिया की सब वैस्यन और असुद्ध चीजन की अईय्या।” <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />और मैं देखो कि बौ बईय्यर परमेस्वर के पवित्र लोगन के खून और ईसु के निरे गभा को खून पीत नसा मैं धुत देखो, जब मैं बाकै देखो तौ मैं पूरी तरह से दंग रहगौ। <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />बौ स्वर्गदूत मोसे कही। “काहे दंग हौ?” मैं तोकै बौ बईय्यर और बौ जानवर को जोके सात मुड़िया और दस सींग हैं, भेद बतांगो। <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />बौ जानवर कहु जिंदो रहै, लेकिन अब जिंदो ना है; बौ अथाह कुंड से निकरकै बिनास मैं पड़ैगो, और पृथ्वी मैं रहन बारे जिनके नाओं जीवितन कि किताब मैं दुनिया बनान से पहले नाय लिखे गै हैं, बे सब जानवर कै देखकै अचम्भित होमंगे। जौ अब जिंदो नाय है, लेकिन जौ फिर से आबैगो।<note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="REV 17:1">प्रकासितवाक्य 17:1</ref></char></note><verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />जौ ग्यान और समझ की माँग करथै। बे सातौ मुड़िया सात पहाड़ हैं, जिनमैं बौ बईय्यर बैठी है। बे भी सात राजा हैं: <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />उनमैं से पाँच गिर गै हैं, एक अभऊ सासन करथै, और दुसरो अभै तक ना आओ है; जब बौ आबै, तौ बाकै कुछ समय ले ही सासन करनो चाहिए। <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />और बौ जानवर जो कभी जिंदो रहै, लेकिन अब नाय है, बौ खुदै आठमों राजा है, जो सात मैं से एक है, और बौ बिनास मैं पड़ेगो।<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“जो दस सींग तैं देखो बे दस राजा हैं, जो अबले राज्य करनो सुरु नाय करीं हैं, लेकिन उनकै बौ जानवर के संग एक घंटा के ताहीं राज्य करन को अधिकार दौ जागो।<note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">दानिय्येल 7:24</ref></char></note> <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />जे दसौ को एकै लक्छ है, और बे अपनी सामर्थ्य और अधिकार जानवर कै देथैं। <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />बे मेम्ना के बिरोध मैं लड़ंगे; मेम्ना अपने बुलाए भै, चुने भै, और भरोसेमंद लोगन के संग मिलकै उनकै पराजित करैगो, काहैकि बौ प्रभुअन को प्रभु, और राजाओं को राजा है।”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />स्वर्गदूत मोसे जौ भी कही, “जो पानी तैं देखो, जोमैं वैस्या बैठी है, बौ देस, लोग, जाति और भासा हैं। <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />जो दस सींग और जानवर कै तैं देखो है, बे वैस्या से बैर रखंगे; बे बाको सब कछु छीन लेंगे और बाकै नंगो छोड़ देंगे; बे बाको मास खांगे, और बाकै आगी मैं जलाए कै खतम कर देंगे। <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />काहैकि परमेस्वर उनके मन मैं जौ डारैगो कि बे बाकी मनसा पूरी करैं; और जबले परमेस्वर के बचन पूरे ना हुई लेमैं, तब तक एक मन हुईकै अपनो-अपनो राज्य जानवर कै दे दियैं।”<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“जो बईय्यर कै तुम देखे बौ बड़ो नगर है जो पृथ्वी के राजन ऊपर राज्य करथै।”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">बेबीलोन को बिनास</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />जाके बाद मैं एक और स्वर्गदूत कै स्वर्ग से उतरत भइ देखो। जोकै बड़ो अधिकार मिलो रहै, और बाके तेज से पूरी पृथ्वी चमक उठी। <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />बौ बड़ा जोड़ से चिल्लाई: “बौ गिर गौ है! महान बेबीलोन गिर गौ है! अब बौ भूत और हर एक प्रेत आत्मा को अड्डा, और सब तराहनी के असुद्ध पक्छिन और जानवरन को अड्डा हुई गौ है।<note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="ISA 13:21">यसायाह 13:21</ref>; <ref loc="JER 50:39">यिर्मयाह 50:39</ref>; <ref loc="JER 51:37">यिर्मयाह 51:37</ref></char></note> <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />काहैकि देस की सब जाति बाको दाखमधु पी लईं हैं, जो बाके व्यभिचार अभिलासा की सामर्थी दाखमधु है। पृथ्वी के तमान राजा बाके संग व्यभिचार करीं, और दुनिया के ब्यापारी बाके बेसब्र अभिलासा से सेठ हुईगै।”<note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="JER 51:7">यिर्मयाह 51:7</ref></char></note><verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />फिर मैं स्वर्ग से एक और अबाज सुनो, जो कहेत रहै,</para>
  <para style="q1" vid="REV 18:4">“बाहर आबौ, मेरे लोगौ! बामै से बाहर आबौ!</para>
  <para style="q2" vid="REV 18:4">तुमकै बाके पापन मैं भागीदार ना होनो चाहिए;</para>
  <para style="q2" vid="REV 18:4">तुमकै बाकी सजा मैं हिस्सा ना लेनो चाहिए!<note caller="+" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="ISA 52:11">यसायाह 52:11</ref>; <ref loc="JER 50:8">यिर्मयाह 50:8</ref>; <ref loc="JER 51:45">यिर्मयाह 51:45</ref></char></note><verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />बाके पाप स्वर्ग के हानी ऊँचे ढेर हुईगै हैं,</para>
  <para style="q2" vid="REV 18:5">और परमेस्वर बाके बुरे कामन कै याद करथै।<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />बाके संग बैसोई व्यवहार करौ जैसो बौ तुमरे संग करी;</para>
  <para style="q2" vid="REV 18:6">बौ जो कछु भी करी होबै बदले मैं बाकै दुई गुना देबौ।</para>
  <para style="q1" vid="REV 18:6">जो कटोरा मैं बौ भर दई रहै</para>
  <para style="q2" vid="REV 18:6">बहे मैं बाके ताहीं दुई गुना भर दियौ।<note caller="+" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">भजन संहिता 137:8</ref></char></note><verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />जितनी बौ अपनी बड़ाँईं करी और सुख-विलास करी</para>
  <para style="q2" vid="REV 18:7">उतनिये बाकै दर्द, और दुख देबौ।</para>
  <para style="q1" vid="REV 18:7">काहैकि बौ अपने मन मैं कहथै:</para>
  <para style="q2" vid="REV 18:7">‘हिंयाँ बैठी मैं एक रानी हौं!</para>
  <para style="q2" vid="REV 18:7">मैं बिधवा नहीं हूँ,</para>
  <para style="q1" vid="REV 18:7">और दुख मैं कभी नाय पड़ंगो!’<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />जौ बजह से एकै दिन मैं बाके ऊपर आफत आए पड़ैगी,</para>
  <para style="q2" vid="REV 18:8">मतलब बिमारी, दुख और अकाल।</para>
  <para style="q1" vid="REV 18:8">और बौ आगी मैं भसम कर दई जागी,</para>
  <para style="q2" vid="REV 18:8">काहैकि प्रभु परमेस्वर जो बाको न्याय करथै, महान है।”<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />और पृथ्वी के राजा जो बाके संग व्यभिचार, और सुख-विलास मैं सहभागी रहैं, जब बाके जलन को धुआँ देखंगे, तौ बाके ताहीं रोमंगे, और छाती पीटंगे।<note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="JER 50:46">यिर्मयाह 50:46</ref></char></note> <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />बे बड़ा दूर ठाड़े हैं, काहैकि बे बाके दुख मैं हिस्सा लेन से डराथैं। बे कहथैं, “कितनो भयानक है! कितनो भयानक है! जौ महान और ताकतबर सहर बेबीलोन! एक घंटा मैं तोकै न्याय मिलगौ है!”<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />पृथ्वी के ब्यापारी बाके ताहीं रोमंगे और विलाप करंगे, काहैकि अब कोई उनको माल मोल ना लेगो; <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />कोई भी उनको सोनो, चाँदी, कीमती पथरा, और मोती नाय खरिदथै; उनके मलमल, बैंजनी लत्ता, रेस्मी और लाल रंग के लत्ता; सब तरहन की निराली कठिया और हथिया के दाँत और महंगी कठिया, काँसो, लोहो और संगमरमर से बनी सबै तरहन की चीजैं; <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />और दालचीनी, मसाला, धूप, गन्धरस, लोबान, दाखमधु, तेल, चून, और गेंहूँ, जानवर और भेंड़, घोड़ा, रथ, दास, और हिंयाँ तक कि भीतरी इंसानी जिंदगी भी। <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />ब्यापारी बासे कहीं, “जित्ते अच्छे मन भान बारे फल तुम चाहथौ, बे गायब ही गई हैं, और तुमरी सम्पत्ति और चमक चली गई है, और तुम उनकै फिर कहु ना पागे!” <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />जो ब्यापारी बौ सहर मैं ब्यापार करकै सेठ हुईगै रहैं, बे बड़ा दूर ठाड़ंगे, काहैकि बे बाके दुख मैं हिस्सा लेन से डराथैं। बे रोंगे और विलाप करंगे, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />और कहमंगे, “कित्तो भयानक है! महान सहर के ताहीं कित्तो भयानक! जो मलमल, बैंजनी, लाल रंग के लत्ता पहनत रहै, और खुदकै सोने के जेबर, कीमती पथरा और मोतियन से तोप लेत रहै! <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />और एक घंटा मैं बौ जे पूरी सम्पत्ति खोए दई! सब जहाजन के कप्तान और यात्‌री, नाविक और दूसरे सब जो समुंदर मैं अपनी जिंदगी जीत रहैं, बड़ा दूर ठाड़े रहैं!”<verse eid="REV 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 18:18" />और जब बे आगी की लपटन से धुआँ देखीं, जो बाकै भसम करत रहै, तौ बे चिल्लाए उठे: “जौ महान सहर के हानी कोई दुसरो सहर कहु नाय भौ!”<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="JER 51:37">यिर्मयाह 51:37</ref></char></note> <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />बे अपनी मुड़ियन मैं धूदर डारीं, और रोत भइ और विलाप करत भइ कहीं, “कित्तो भयानक है! महान सहर के ताहीं कित्तो भयानक! जौ बड़ो सहर जोकी सम्पत्ति के जरिये समुंदर के सब जहाज बारे सेठ हुईगै रहैं, एक घंटा मैं बौ सब कछु खोए दई!”<note caller="+" style="x"><char style="xo" closed="false">18:19 </char><char style="xt" closed="false"><ref loc="EZK 27:30">यहेजकेल 27:30</ref></char></note><verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />हे स्वर्ग, बाके बिनास के बजह से खुस हो! हे परमेस्वर के पवित्र लोगौ और प्रेरितौ और भविस्यवक्ता भी खुस रहबौ! काहैकि जो कछु बौ तुमरे संग करी बाके ताहीं परमेस्वर बाको न्याय करी है!<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />फिर एक सक्तिसाली स्वर्गदूत चक्की के पाट के आकार को एक पथरा उठाएकै समुंदर मैं फेंक दई, और कही, “बड़े सहर बेबीलोन कै ऐसिये गिराओ जागो और बौ फिर कहु दिखाई ना देगो।<note caller="+" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="JER 51:63-64">यिर्मयाह 51:63-64</ref>; <ref loc="EZK 26:21">यहेजकेल 26:21</ref></char></note> <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />वीड़ाँ बजान बारे, गायक, बुसली बजान बारे, और तुरहई फूँकन बारेन को गीत, फिर तेरे मैं कहु न सुनाई देगो! कोई भी ब्यापार मैं कोई भी काम करन बारो तेरे मैं कहु ना मिलैगो; और चक्की के हिस्सा की अबाज फिर सुनाई न देगी! <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />फिर कभी तुम मैं दिया की जोती न दिखाई देगी; फिर तेरे मैं दुल्हा और दुल्हेन की अबाज ना सुनाई देगी। तेरे सौदागर पूरे दुनिया मैं सबसे सक्तिसाली रहैं, और तैं अपने झूठे जादू से देस के सब लोगन कै धोका दौ!”<verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />बेबीलोन कै सजा दौ गौ काहैकि बौ सहर मैं भविस्यवक्ता और परमेस्वर के पवित्र लोगन को खून पाओ गौ रहै; हाँ, बे सबन को खून जो पृथ्वी मैं मर गै हैं।<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />जाके बाद मैं स्वर्ग मैं लोगन की एक बड़ा बड़ी भीड़ को गरजन की अबाज के तराहनी सुनो, जो कहत रहै, “परमेस्वर की स्तुति करौ! उद्धार, महिमा, और सामर्थ्य हमरे परमेस्वर के हैं! <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />सच्चाई और न्याय के काम बाके खुद के है! बौ बे वेस्या की बुराई करी जो व्यभिचार से धरती कै भ्रस्ट करत रहै, परमेस्वर बाकै सजा दई है काहैकि बौ बाके सेवकन को खून करी रहै।”<note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">व्यवस्थाविवरन 32:43</ref></char></note> <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />बे फिर चिल्लाईं, “परमेस्वर की स्तुति करौ! आगी की लपट को धुआँ जो बौ बड़े से बड़े सहर कै सुहा कर देथै जो बौ हमेसा और हमेसा ऊपर उठत रहथै!”<note caller="+" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="PSA 106:48">भजन संहिता 106:48</ref></char></note> <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />चौबीस बड़े-बूढ़े और चारौ जीव गिरकै परमेस्वर की आराधना करन लगे। जो सिंहासन मैं बैठो रहै, बे कहीं, “आमीन! परमेस्वर की स्तुति होबै!”<verse eid="REV 19:4" /></para>
  <para style="s">मेमना के बिहा की दावत</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />फिर सिंहासन मैं से जौ अबाज निकरी, “हमरे परमेस्वर की स्तुति करौ, बाके सब डरान बारे सेवकौ और सब लोग, का छोटे, का बड़े, जो बाको आदर करथैं!”<note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="PSA 135:1">भजन संहिता 135:1</ref></char></note> <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />फिर मैं सुनो एक बड़ी भीड़ की अबाज जैसी, एक गरजन बारे झरना की अबाज के तराहनी, और गड़गड़ाहट की तेज अबाज के तराहनी। मैं उन्हैं जौ कहत सुनो, “परमेस्वर की स्तुति करौ! काहैकि हमरो प्रभु, सर्वसक्तिमान परमेस्वर राजा है!<note caller="+" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="PSA 99:1">भजन संहिता 99:1</ref>; <ref loc="PSA 93:1">93:1</ref></char></note> <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />आबौ हम आनन्दित और मगन होमैं; आबौ हम बाकी महानता की महिमा करैं! काहैकि मेम्ना के बिहा को समय आए पहोंचो है, और बाकी दुल्हेन बाके ताहीं अपने आपकै तैयार कर लई है। <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />बहे उनकै पहनन के ताहीं साफ चमकीलो मलमल पहनन दौ गौ है” मलमल परमेस्वर के पवित्र लोगन के न्याय के काम हैं।<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />फिर स्वर्गदूत मोसे कही, जौ लिख: खुसनसीब हैं बे, जिन्हैं मेम्ना के बिहा के खाने मैं न्युतो दौ गौ है। और स्वर्गदूत जासे अग्गु भी कही, “जे परमेस्वर के सच्चे बचन हैं।”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />मैं बाकी आराधना करन के ताहीं बाके पाँव झोने गिर पड़ो, लेकिन बौ मोसे कही, “ऐसो मत कर! मैं तुमरे संग और दुसरे विस्वासी भईय्यन को संगी दास हौं, काहैकि ईसु की गभाई भविस्यवाँड़ी की आत्मा है। परमेस्वर की आराधना करौ!”<verse eid="REV 19:10" /></para>
  <para style="s">सफेद घोड़ा मैं सवार</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />फिर मैं स्वर्ग कै खुलो देखो, और एक सफेद घोड़ा रहै। जाके सवार कै बिस्वास योग्य और सच्चो कहो जाथै; जौ न्याय के संग है कि बौ न्याय करथै और अपनी लड़ाई लड़थै। <note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="PSA 96:13">भजन संहिता 96:13</ref></char></note> <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />बाकी आँखी आगी की लपट के तराहनी रहैं, और बाकी मुड़िया मैं भौत से राजमुकुट रहैं। और बामै एक नाओं लिखो रहै, लेकिन बाकै छोड़ और कोई नाय जानत रहै बौ का है।<note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="REV 19:16">प्रकासितवाक्य 19:16</ref> </char></note> <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />बौ खून मैं डूबो भौ लत्ता पहने रहै, बाको नाओं “परमेस्वर को बचन” है। <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />स्वर्ग की सेना सफेद घोड़न मैं सवार और सुद्ध सफेद मलमल के लत्ता पहने बाके पच्छू हुई लईं। <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />बाके मोहों से एक चोखी तलवार निकरी, जोसे बौ सब देसन कै हराबैगो। बौ लोहे की छड़ी से उनके ऊपर राज्य करैगो, और बौ सर्वसक्तिमान परमेस्वर के प्रकोप के कुंड मैं दाखरस रौंदैगो।<note caller="+" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="REV 2:27">प्रकासितवाक्य 2:27</ref></char></note> <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />बाके लत्ता और जाँघ मैं जौ नाओं लिखो रहै: “राजाओं को राजा और प्रभुअन को प्रभु।”<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />फिर मैं एक स्वर्गदूत कै सूरज के ऊपर ठाड़ो भौ देखो। बौ बड़े ऊँची अबाज मैं आसमान के बीच मैं से सब उड़न बारे पक्छी से कही: “आबौ और परमेस्वर की महान दावत के ताहीं इखट्टे हुई जाबौ! <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />आबौ और राजाओं, सेनापतियों और सरदारन को मास, घोड़न को और उनमैं सवारन को मास, सब लोगन को मास और का स्वतंत्‌र का दास, का छोटे का बड़े, सब लोगन को मास खाबौ!”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />फिर मैं बौ जानवर और पृथ्वी के राजन और उनकी सेना कै बे घोड़ा के सवार और बाकी सेना से लड़न के ताहीं इखट्टे देखो। <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />बौ झूठो भविस्यवक्ता जो बाकी मौजूदगी मैं चिन्ह चमत्कार के काम करी रहै, जानवर कै बंधी बनाये लौ गौ रहै, जौ बे चमत्कार से रहै कि बौ बे लोगन कै धोका दई रहै जिनके पास जानवर को छाप रहै और जो कोई जानवर की मूर्ति की आराधना करी रहै। जानवर और झूठे भविस्यवक्ता दोनों कै जिंदोई गंधक से जलत भै आगी मैं फेंक दौ गौ।<note caller="+" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="REV 13:1-8">प्रकासितवाक्य 13:1-8</ref></char></note> <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />उनके गुट बौ तलवार से मारे गै जो घुड़सवार के मोहों से निकरथै; और सब पक्छी उनके मास खाएकै सन्तुस्ट हुईगै।<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">एक हजार साल</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />फिर मैं एक स्वर्गदूत कै स्वर्ग से उतरत देखो, जोके हाथ मैं अधोलोक की चाबी, और एक बड़ी जंजीर रहै। <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />बौ अजगर, मतलब पुराने साँप कै, जो प्रेत आत्मा या सैतान है; और बाकै पकड़कै एक हजार साल तक जंजीरन मैं भाँदे रखाई। <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />स्वर्गदूत बाकै अधोलोक मैं फेंक दई, और बामै तारो लगाए दई, फिर बामै मुहर लगाए दई, कि बौ हजार साल के बीतन तक देस के सब गैर यहूदियौ कै फिर से भरमाए न सकै। जाके बाद बाकै जरा देर के ताहीं ढीलो छोड़ देनो चाहिए।<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />फिर मैं सिंहासन देखो, और जो बामै बैठे रहैं, उन्हैं न्याय करन को हक दौ गौ। मैं बे लोगन की आत्मन कै भी देखो जोकी ईसु की गभाई और परमेस्वर के बचन देन की बजह से मार डारो गौ रहै। बे बौ जानवर या बाकी मूर्ति की आराधना मन से नाय करी रहैं, और न बे अपने माथे या अपने हात मैं बाकी छाप लईं रहैं। बे जिंदे भै और एक हजार साल ले मसीह के संग राजा के रूप मैं राज्य करी। <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />जबले जे हजार साल पूरे ना भै तब तक बचे मरे भै जिंदे न होंगे। जौ तौ पहलो पुनरुत्थान है। <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />धन्य और पवित्र बौ है, जो जौ पहले जी उठन को भागी है, ऐसेई मैं दुसरी मौत को कुछ भी अधिकार ना, पर बे परमेस्वर और मसीह के पुजारी होंगे, और बाके संग एक हजार साल तक राज्य करंगे।<verse eid="REV 20:6" /></para>
  <para style="s">सैतान की हार</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />हजार साल पूरे होन के बाद, सैतान कै बाके कैदखाना से छोड़ दौ जागो, <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />और अब बौ सारी दुनिया के देस मैं बिखरी भइ जाति कै भरमान के ताहीं निकरैगो जो गोग और मागोग है। सैतान बे सबन कै लड़ाई के ताहीं इखट्टो करैगो, जित्ते समुंदर तट मैं रेता के कड़ हैं। <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />बे पूरी पृथ्वी मैं फैल गै और परमेस्वर के पवित्र लोगन को डेरा और बौ सहर कै जोसे बौ प्रेम करथै घेर लई। और आगी स्वर्ग से उतरी और उन्हैं नास कर दई। <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />फिर सैतान कै, जो उन्हैं धोका दई रहैं, आगी और गंधक की बौ झील मैं डार दौ गौ, जहाँ बौ जानवर और झूठे भविस्यवक्ता पहलिये से फेंको जाए चुको रहैं; और बे रात-दिन हमेसा<note caller="+" style="f"><char style="fr" closed="false">20:10 </char><char style="ft" closed="false">हमेसा के ताहीं</char></note> तड़पत रहेंगे।<verse eid="REV 20:10" /></para>
  <para style="s">आखरी फैसला</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />फिर मैं एक बड़ो सफेद सिंहासन और बामै बैठन बारे कै देखो, पृथ्वी और स्वर्ग बाकी गैरहाजरी से भाज गै हैं और अब नाय देखे गै।<note caller="+" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती 25:31</ref>; <ref loc="PSA 47:8">भजन संहिता 47:8</ref> </char></note> <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />और मैं छोटे-बड़े सब मरे भैन कै सिंहासन के सामने ठाड़े भै देखो। और किताब खोली गईं; और फिर एक और किताब खोली गई, मतलब जिंदगी की किताब। मरे भैन को न्याय बाके जरिया करे गै काम के अनुसार करो गौ, जैसो कि किताब मैं लिखो है। <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />फिर समुंदर मरे भैन कै छोड़ दई, मौत और नरक भी अपने झोने रखे मरे भैन कै छोड़ दई। और जो कुछ बे करीं रहैं बाके हिसाब से सबको न्याय करो गौ। <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />फिर मौत और नरक कै आगी की झील मैं डार दौ गौ, जौ आगी की झील तौ दुसरी मौत है। <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />जिन लोगन को नाओं जिंदगी की किताब मैं नाय लिखो भौ मिलो, उन्हैं आगी की झील मैं डारो गौ।<note caller="+" style="x"><char style="xo" closed="false">20:15 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानिय्येल 12:1</ref>; <ref loc="MAT 25:41">मत्ती 25:41</ref></char></note><verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">नया स्वर्ग और नई पृथ्वी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />फिर मैं एक नया स्वर्ग और एक नई पृथ्वी देखो, काहैकि पहलो स्वर्ग और पहली पृथ्वी गायब हुई गई, और समुंदर भी गायब हुई गौ।<note caller="+" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="ISA 66:22">यसायाह 66:22</ref></char></note> <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />फिर मैं पवित्र सहर, नया यरूसलेम कै परमेस्वर के झोने से स्वर्ग से उतरत देखो, जो एक दुल्हेन के हानी रहै, जो अपने दुल्हा से मिलन के ताहीं तैयार और तैयार रहै। <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />मैं सिंहासन से ऊँची अबाज से बोलत भइ सुनो: “परमेस्वर के घर मैं रहन बारी जघा अब लोगन के बीच है! बौ उनके संग रैहगो, और बे बाके लोग होंगे, और परमेस्वर खुद उनके संग रहगो; और बौ उनको परमेस्वर होगो।<note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LEV 26:11-12">लैव्यवस्था 26:11-12</ref>; <ref loc="EZK 37:27">यहेजकेल 37:27</ref></char></note> <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />बौ उनकी आँखी से सब आँसु पोंछ डारैगो। फिर न मौत रैहगी, और ना सोक, ना विलाप, ना पीड़ा रैहगी पुरानी बात बीत गई हैं।”<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />फिर जो सिंहासन मैं बैठो रहै, बौ कही, “अब मैं सब कछु नया कर देथौं!” फिर बौ मोसे जहो कही, “जाकै लिख, काहैकि जे बचन सच्चे हैं और इनमैं बिस्वास करो जाए सकथै।” <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />फिर बौ मोसे कही, “हुई गौ! मैं पहलो और आखरी, आदि और अंत हौं। जो कोई प्यासो होगो बाकै मैं जिंदगी के पानी के सोता मैं से सेंत-मेंत पीन को अधिकार दूँगो। <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जो बिजय होमंगे, बे मोसे जौ पामंगे; मैं उनको परमेस्वर होमंगो, बे मेरी सन्तान होमंगे। <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />लेकिन डरपोक, अविस्वासी, लुटेरा, हत्यारे, जादू टोना करन बारे, मूर्ति की पूजा करन बारे, और सब झूटेन के ताहीं जघा आगी और गंधक से जलत भइ झील है, जौ दूसरी मौत है।”<verse eid="REV 21:8" /></para>
  <para style="s">नया यरूसलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />बे सात स्वर्गदूत मैं से जिनके झोने सात आखरी बिपत्ति से भरे भै सात कटोरा रहैं, उनमैं से एक मेरे झोने आओ और कही, “आबौ, मैं तुमकै दुल्हेन मतलब मेम्ना की बईय्यर दिखांगो।” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />आत्मा मोकै काबू मैं कर लई, स्वर्गदूत मोकै एक भौत बड़े पहाड़ की चुटिया मैं लैगौ। बौ मोकै पवित्र सहर यरूसलेम कै स्वर्ग से परमेस्वर के झोने से उतरत भै दिखाई <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />और परमेस्वर की महिमा के संग चमक रौ है। सहर एक कीमती पथरा के तराहनी चमकत रहै, एक सूरजमड़ी के हानी और यसब के हानी साफ रहै। <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />बाकी एक बड़ा ऊँची दीवार रहै, बाके बारह मोहोंट और मोहोंट मैं बारह स्वर्गदूत रहैं; और बे मोहोंट मैं इस्राएलियन के बारह गोत्रन के नाओं लिखे रहैं। <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />हर एक तरफ तीन मोहोंट रहैं, तीन अगार के घाँईं, तीन पछार के घाँईं, तीन सीरे के घाँईं, तीन तरिहाँए के घाँईं रहैं। <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />सहर की दीवार बारह बुनियाद के पथरा पर बनी रहै, उनके ऊपर मेम्ना के बारह प्रेरितन के नाओं लिखे रहैं। <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />जो स्वर्गदूत मोसे बात करी, बाके झोने सहर, मोहोंट और सहर की दीवार नापन के ताहीं सोने की छड़ी रहै।<note caller="+" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="ZEC 2:1">जकर्याह 2:1</ref></char></note> <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />सहर पूरी तरहन से चौकोर रहै, जित्तो लम्बो रहै उतनोई चौंहड़ो रहै। स्वर्गदूत अपनी नापन बारी छड़ी से सहर कै नापी: बौ चौबीस सौ किलो मीटर लम्बो रहै, जित्तो चौंहड़ो रहै उतनोई ऊँचो भी रहै। <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />स्वर्गदूत दीवार कै नापी, और बौ दुई सौ सोलह फीट ऊँची रहै, जो बौ नाप की मानक ईकाई के जरिया रहै, जोको बौ इस्तमाल करत रहै। <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />दीवार यसब<note caller="+" style="f"><char style="fr" closed="false">21:18 </char><char style="ft" closed="false">हरो पथरा</char></note> से बनी रहै, और सहर अपने आप मैं सीसा के तराहनी सुद्ध सोने को बनो रहै। <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />बौ सहर की दीवार की बुनियाद हर तरहन के कीमती पथरन से सजाओ गौ रहै, पहलो सिलान्यास रहै, दुसरो नीलम, तीसरो स्फटिक, चौथो पन्ना, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पाँचमों गोमेदक, छठमों लाल माड़िक्य, सातमों पीतमड़ि, आठमीं पेरो माड़िक्य, नौमो पुखराज, दसमों लहसनिए, ग्यारहमो धुम्रकान्त, बारहमो नीलम। <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />और बारह मोहोंट, बारह मोतियन के रहैं; हर एक मोहोंट एक मोती से बनाओ गौ रहै। और सहर की गली सुद्ध सोने की रहै, और सीसा के तराहनी पारदर्सी रहै।<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />मैं सहर मैं कोई मंदिर ना देखो, काहैकि बाको मंदिर सर्वसक्तिमान प्रभु परमेस्वर और मेम्ना है। <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />बौ सहर मैं न तौ सूरज की जरुरत है और न जोनी की, कि बामै चमकै, काहैकि परमेस्वर की महिमा को तेज बामै चमकथै, और मेम्ना बाको दिया है।<note caller="+" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="ISA 60:19">यसायाह 60:19</ref></char></note> <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />दुनिया के लोग बाकी महिमा की जोती मैं चलंगे, और पृथ्वी के राजा अपनो तेज धन बाके झोने लामंगे। <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />सहर के मोहोंट दिन भर खुले रहेंगे; बे कहुए बंद न होंगे, काहैकि हुँआँ रात ना होगी।<note caller="+" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 60:11">यसायाह 60:11</ref>; <ref loc="ZEC 14:7">जकर्याह 14:7</ref></char></note> <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />देस की महानता और धन देस मैं लाओ जागो। <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />लेकिन कोई असुद्ध चीज सहर मैं न घुस पाबैगी, और न लज्जित करन बारो और न झूठ बोलन बारो। सिरफ बे इंसान जिनके नाओं मेम्ना के जिंदगी की किताब मैं लिखे हैं, बे ही सहर मैं प्रवेस करंगे।<note caller="+" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">यसायाह 52:1</ref></char></note><verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />जाके बाद स्वर्गदूत मोकै जिंदगी के पानी की नदिया दिखाई, जो बिल्लौर के तराहनी जगमगाथै, जो परमेस्वर और मेम्ना के सिंहासन से निकरकै <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />बौ सहर के सड़क के बीचौ बीच बहत रहै। नदिया के दोनों पाँजर जिंदगी को पेंड़ रहै, बामै बारह तरहन को फल लगत रहै, और बौ हर महेना फरत रहै; और बौ पेंड़ के पत्तन से जाति-जाति के लोग चंगे होत रहैं।<note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="EZK 47:7">यहेजकेल 47:7</ref></char></note> <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />जो कुछ परमेस्वर के अभिस्राप के अधीन हैं, बौ सहर मैं न मिलैगो। परमेस्वर और मेम्ना को सिंहासन सहर मैं होगो, और बाके सेवक बाकी आराधना करंगे। <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />बे बाको मोहों देखंगे, और बाको नाओं उनके माथे मैं लिखो भौ होगो। <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />और फिर रात ना होगी, और उन्हैं दिया या धूप की जरूरत ना होगी, काहैकि प्रभु परमेस्वर उनको उजितो होगो, और बे हमेसा और हमेसा के ताहीं राज्य करंगे।<note caller="+" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">यसायाह 60:19</ref>; <ref loc="DAN 7:27">दानिय्येल 7:27</ref></char></note><verse eid="REV 22:5" /></para>
  <para style="s">ईसु को आनो</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />फिर स्वर्गदूत मोसे कही, “जे बचन सच्चे हैं और इनमैं बिस्वास करो जा सकथै। और प्रभु परमेस्वर, जो भविस्यवक्तन की आत्मन को परमेस्वर है, अपने स्वर्गदूत कै इसलै भेजी कि अपने सब सेवकन कै बे बातैं, जिनको जल्दिये पूरो होनो जरूरी है दिखाबै।”<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />“सुनौ! ईसु कहथै। मैं जल्दिये आए रहो हौं! धन्य हैं बे जो जौ किताब की भविस्यवाँड़ी की बात मानथै!”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />मैं बहे यूहन्ना हौं, जो जे सब बात सुनत और देखत रहौं। और जब मैं सुनो और देखो, तौ जो स्वर्गदूत मोकै जे बातैं दिखात रहै, मैं बाके पाँव मैं आराधना करन के ताहीं गिर पड़ो, और मैं बाकी उपासना करन बारो रहौं। <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />लेकिन बौ मोसे कही, “ऐसो मत कर! काहैकि मैं तेरो और तेरे भईय्यन भविस्यवक्तन और जौ किताब की बातन कै मानन बारेन को संगी दास हौं, परमेस्वर की ही आराधना कर!” <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />और बौ मोसे कही, “जौ किताब की भविस्यवाँड़ी की बात मैं मुहर मत लगईये, काहैकि बौ समय झोने है जब ऐसो सब होगो। <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />जो अन्यायी है बौ अन्याय करत रहबै, और जो मलच्छ है, बौ मलच्छ बनो रहबै; जो धार्मिक है बौ धर्मी बनो रहबै, और जो पवित्र है, बौ पवित्र बनो रहबै।”<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />“सुन!” ईसु कहथै। “मैं जल्दिये आए रहो हौं! मैं अपनो प्रतिफल अपने संग लांगो, कि हर एक कै बाके काम के हिसाब से देमौं।<note caller="+" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="MAT 16:27">मत्ती 16:27</ref></char></note> <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />मैं ही पहलो और आखरी, आदि और अंत हौं।”<note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="ISA 44:6">यसायाह 44:6</ref>; <ref loc="ISA 48:12">यसायाह 48:12</ref></char></note><verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />धन्य हैं बे जो अपने चोंगा कै धोए लेथैं, काहैकि उन्हैं जिंदगी के पेंड़ को फल खान को, और बे मोहोंट से हुईकै सहर मैं जान को अधिकार है। <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />लेकिन सहर के बाहर लुटेरे और टोना, व्यभिचारी, हत्यारे, मूर्ति की पूजा करन बारे, और बचन और करम दोनों कै चाहन बारे लोग हैं।<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“मोकै ईसु, अपने स्वर्गदूत कै जौ ताहीं भेजी, कि तुमरे अग्गु कलीसियन के बारे मैं जे बातन की गभाई दियौं। मैं दाऊद के कुल को मूल बंस हौं; और भोर को चमकीलो तारा हौं।”<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">यसायाह 11:1</ref></char></note><verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />आत्मा और दुल्हेन दोनों कहथैं, “आ!” और जो कोई जौ सुनथै, बौ भी जौ कहबै, “आ!” और जो प्यासो होबै, बौ आबै और जो कोई चाहे बौ जिंदगी को पानी सेंत-मेंत लेबै।<note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="ISA 55:1">यसायाह 55:1</ref></char></note><verse eid="REV 22:17" /></para>
  <para style="s">चितौनी</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />मैं, यूहन्ना, जौ किताब की भविस्यवाँड़ी की बातन कै गंभीरता से सब सुनन बारेन कै चितौनी और गभाई देथौं: अगर कोई जामैं कुछ जोड़थै, तौ परमेस्वर बे बिपत्ति कै जो जे किताब मैं लिखी हैं बाके सजा मैं जोड़ देगो।<note caller="+" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="DEU 12:32">व्यवस्थाविवरन 12:32</ref></char></note> <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />और अगर कोई जौ किताब की भविस्यवाँड़ी के बचन मैं से कछु निकारथै, तौ परमेस्वर जिंदगी के पेंड़ और पवित्र सहर के फल मैं से भाग, जो जौ किताब मैं लिखो है, बाको भाग निकार देगो।<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />जो जे बातन की गभाई देथै, बौ जौ कहथै, “हाँ, मैं जल्दिये आनबारो हौं।” आमीन। हे प्रभु ईसु आ!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />प्रभु ईसु को अनुग्रह पवित्र लोगन के संग बनो रहबै।<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>