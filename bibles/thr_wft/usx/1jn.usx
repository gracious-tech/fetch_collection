<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Rana Tharu</book>
  <para style="h">1 यूहन्ना</para>
  <para style="toc3">1 यूहन्ना</para>
  <para style="toc2">1 यूहन्ना</para>
  <para style="toc1">यूहन्ना की पहली चिट्ठी</para>
  <para style="mt2">यूहन्ना की पहली चिट्ठी</para>
  <para style="mt1">यूहन्ना की पहली चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">1 यूहन्ना की चिट्ठी प्रेरित यूहन्ना के जरिया मसीह के जनम के 50 से 100 सालन के बीच लिखी गई रहै। यूहन्ना खुदकै लेखक के रूप मैं नाय पहचानथै, लेकिन पहलो अध्याय दिखाथै कि बौ ईसु के जीवन और पुनरुत्थान को एक देखन बारो है<char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char>। 1 यूहन्ना मैं लेखन सैली भी यूहन्ना के अनुसार सुसमाचार मैं मिली लेखन सैली से काफी मिलती-जुलती है। ऐसो मानो जाथै कि यूहन्ना इफिसुस मैं रहत भै यूहन्ना के सुसमाचार के अनुसार जे तीन पत्‌री 1 यूहन्ना, 2 यूहन्ना और 3 यूहन्ना लिखी रहै। यूहन्ना जौ चिट्ठी सबै मसीहियन कै ऐसे समय मैं लिखी रहै जब कलीसिया कै “नोस्टिक्स” नामक लोगन के एक समूह से परेसानी होत रहै। इन लोगन को माननो रहै कि ईसु पूरी तरह से परमेस्वर रहै लेकिन पिरथबी पर रहत भै बौ बास्तव मैं मास और खून के सरीर बारो इंसान नाय रहै। जौ बजह से यूहन्ना ईसु के जीवन कै देखन के बारे मैं लिखथै और जौ कि बाके अपने हात ईसु कै छुइं<char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char>। जौ चिट्ठी कै लिखन मैं यूहन्ना को उद्देस्य बाकी खुसी कै पूरो करनो रहै <char style="xt"><ref loc="1JN 1:4">1 यूहन्ना 1:4</ref></char>, विस्वासिन कै पाप करन से रोकनो <char style="xt"><ref loc="1JN 2:1">1 यूहन्ना 2:1</ref></char>, विस्वासिन कै झूठी सिक्छा से बचानो <char style="xt"><ref loc="1JN 2:26">1 यूहन्ना 2:26</ref></char>, और विस्वासिन कै बतामैं कि बे सच-मुच बचाए गै हैं। <char style="xt"><ref loc="1JN 5:13">5:13</ref> </char></para>
  <para style="iot">रूपरेखा:</para>
  <para style="io1">1. यूहन्ना अपनी चिट्ठी को परिचय देथै और जाकै लिखन को एक उद्देस्य देथै। <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">2. फिर बौ बताथै कि परमेस्वर कैसे उजीतो है और हमैं ईसु की तरह जीनो चाहिए। <char style="ior"><ref loc="1JN 1:5-3:10">1:5–3:10</ref> </char></para>
  <para style="io1">3. जाके बाद बौ हमैं एक दूसरे से प्रेम करन की आग्या की याद दिलाथै। <char style="ior"><ref loc="1JN 3:11-5:12">3:11–5:12</ref></char></para>
  <para style="io1">4. बौ अपनी चिट्ठी कै खतम करथै। <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">जिंदगी को सब्द</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:1">यूहन्ना 1:1</ref> </char>
    </note>हम तुमकै जिंदगी के सब्द के बारे मैं लिखथैं, जो सुरुए से अस्तित्व मैं है। हम जाकै सुने हैं, और अपनी आँखी से देखे हैं; हाँ, हम जाकै देखे हैं, और हमरे हात जाकै छुइ हैं। <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">यूहन्ना 1:14</ref></char></note>जब जौ जिंदगी दिखाई दई, तौ हम जाकै देखे; तभईये हम जाके बारे मैं गभाई देथैं और तुमकै बौ अनंत जिंदगी के बारे मैं बताथैं जो दऊवा के संग रहै और हमैं दिखाई दई है। <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />हम जो देखे और सुनें हैं, बौ हम तुम्हऊँ कै बताथैं, ताकी तुम हमरे संग बौ संगती मैं सामिल होबौ, जो हमरे दऊवा के संग है और बाके लौड़ा ईसु मसीह के संग है। <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />हम जाकै इसलै लिखथैं कि हमरी खुसी पूरी हुई सकै।<verse eid="1JN 1:4" /></para>
  <para style="s">परमेस्वर उजीतो है</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />अब जो संदेसो हम बाके लौड़ा से सुने और ऐलान करे जौ बौ है: परमेस्वर उजीतो है, और बाके भीतर एकौ अंधियारो नाय है। <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />अगर, हम कहथैं कि हमरे झोने बाके संग संगती है, फिर भी अंधकार मैं चलैं, तौ हम झूठ बोलथैं और सच्चाई मैं ना चलथैं। <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />लेकिन अगर हम उजीते मैं रहथैं, जैसी बौ उजीते मैं है, तौ हमरे झोने एक दुसरे के संग संगती है, और ईसु बाके लौड़ा को खून, हमैं हर पाप की जिंदगी से सुद्ध करथै।<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />अगर हम कहथैं कि हमरे झोने कोई पाप नाय है, तौ हम अपने आपकै धोका देथैं, और हम मैं कोई सच्चाई नाय है। <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />लेकिन अगर हम अपने पाप कै परमेस्वर के अग्गु मान लेथैं, तौ बौ अपनो वादा निभाबैगो और जो सई है बौ करैगो: बौ हमरे पापन कै माफी देगो और हमरे सबै अधर्म के कामन से सुद्ध करन मैं भरोसेमंद और धर्मी है। <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />अगर हम कहथैं कि हम पाप नाय करे हैं, तौ हम परमेस्वर कै झूठो ठहराथैं, और बाको बचन हम्मै नाय है।<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">मसीह हमरो सहायक</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />मैं जौ तुमकै, मेरे बालकौ लिखरौ हौं, ताकी तुम पाप नाय करौ; लेकिन अगर कोई पाप करथै, तौ हमरे झोने कोई है जो हमरो मदतेया है, जो हमरे घाँईं से दऊवा से प्रार्थना करथै। जौ आदमी ईसु मसीह है जो न्याई है। <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />और मसीह खुद बौ जरिया है जोके बजह से हमरे पाप माफ करे जाथैं, और सिरफ हमरे पाप ना, बल्किन पूरी दुनिया के पाप भी।<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />अगर हम परमेस्वर की आग्या मानथैं, तौ हमैं यकीन है कि हम बाकै जानथैं। <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />अगर हम कहथैं कि हम बाकै जानथैं, लेकिन बाकी आग्या कै नाय मानथैं, तौ हम झूठे हैं और हम्मै कोई सच्चाई नाय है। <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />लेकिन अगर हम बाकी बात मानैं, तौ हम बेईं हैं जिनमैं प्रेम परमेस्वर के ताहीं सच्ची मैं पूरो है। जौ तरीका से हम मान सकथैं कि हम परमेस्वर के संग एक हैं: <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />अगर हम कहथैं कि हम परमेस्वर के संग एक हुईकै रहथैं, तौ हमैं बहे की जिंदगी के तराहनी चलनो चाहिए जैसे ईसु मसीह चलो।<verse eid="1JN 2:6" /></para>
  <para style="s">नई आग्या</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />मेरे प्रिय दोस्तौ, जौ आग्या जोमैं तुमकै लिखरौ हौं बौ कोई नई बात नाय है; जौ पुरानी आग्या है, जो सुरू से तुम्हैं दई गई है। पुरानी आग्या बौ संदेसो है जोकै तुम पहलिये से सुने हौ। <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />हालाकि, अब मैं तुमकै जो आग्या लिखरौ हौं बौ नया है, काहैकि जाकी सच्चाई मसीह मैं और तुम्हऊँ मैं देखी जाथै। अंधियारो दूर हुई रौ है, और सच्ची को उजीतो पहलिये से चमक रौ है।<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />अगर हम कहथैं कि हम उजीते मैं हैं, तहुँओं अपने भईय्या से नफरत करथैं, हबऊ हम अंधियारे मैं हैं। <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />अगर हम अपने भईय्या से प्रेम करथैं, तौ हम उजीते मैं रहथैं, और तभई हममैं ऐसो कुछ नाय है जो कोई और कै पाप के ताहीं बढ़ावा देगो। <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />लेकिन अगर हम अपने भईय्या से नफरत करथैं, तौ हम अंधियारे मैं हैं; हम जामैं चलथैं और नाय जानथैं कि हम कहाँ जाए रै हैं, काहैकि अंधियारो हमैं अंधौ बनाये दई है।<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />मेरे बालकौ, मैं तुमकै इसलै लिखरौ हौं, काहैकि तुमरे पाप मसीह के नाओं से माफ भै हैं। <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />हे दऊवा, मैं तुम्हैं इसलै लिखथौं, कि जो आदि से है, तुम बाकै जानथौ, हे ज्वानौं, मैं तुमकै इसलै लिखथौ, कि तुम बौ दुस्ट पर जय पाए हौ: हे लौड़ौ, मैं तुमकै इसलै लिखो हौं, कि तुम दऊवा कै जानगै हौ।<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />मैं तुमकै लिखरौ हौं, मेरे बालकौ, काहैकि तुम दऊवा कै जानथौ। मैं तुमकै लिखरौ हौं दऊवा, काहैकि तुम बाकै जानथौ जो सुरुए से अस्तित्व मैं है। मैं तुमकै लिखरौ हौं, ज्वान लोगौ काहैकि तुम मजबूत हौ; परमेस्वर को बचन तुम्मैं रैहथै, और तुम बुराई कै हराए दै हौ।<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />दुनिया या ऐसी कोई चीज से प्रेम मत करौ जो दुनिया से मतलब रखथैं। अगर तुम दुनिया से प्रेम करथौ, तौ तुम दऊवा से प्रेम ना करथौ। <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />काहैकि जो कुछ दुनिया मैं है, मतलब सरीर की इच्छा, और आँखिन की इच्छा और सम्पत्ति को इतनो घमंड जो जे लोगन के ऊपर है, बौ सब दऊवा के घाँईं से ना, बल्कि दुनिया के घाँईं से आथै। <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />दुनिया और बामै सब कछु जो लोग चाहथैं बौ गुजर रौ है; लेकिन जो लोग परमेस्वर की इच्छा पूरी करथैं बे हमेसा के ताहीं जीथैं।<verse eid="1JN 2:17" /></para>
  <para style="s">मसीह को दुस्मन</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />मेरे बालकौ, अंत झोने है! तुमकै बताओ गौ रहै कि मसीह के दुस्मन आमंगे; और अब मसीह के निरे दुस्मन पहलिये दिखाई दै चुके हैं, और तभईये हम जानथैं कि अंत झोने है। <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />जे आदमी सच्ची मैं हमरी संगती से जुड़े नाय रहैं, और तभईये बे हमैं छोड़ दईं; अगर बे हमरी संगती के रहैं, बे हमरे संग रहैं। पर बे छोड़ दईं ताकी जौ सपा हुई सकै कि उनमैं से सच्ची मैं कोई हमरो नाय रहै।<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />लेकिन तुम मसीह के जरिया तुमरे ऊपर पवित्र आत्मा को अभिसेक भौ है, और तभई तुम सबन कै सच्चाई पता है। <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />मैं तुमकै लिखरौ हौं, तौ नाय, काहैकि तुम सच्चाई कै नाय जानथौ; जाके बजाय, जौ तभईये है काहैकि तुम जाकै जानथौ, और तुम जहो जानथौ कि सच से कहु झूठ नाय निकरथै।<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />फिरौंकी, झूठो कौन है? जे बे हैं जो कहथैं कि ईसु मसीहा नाय है। ऐसे आदमी मसीह के दुस्मन हैं, बे दऊवा और लौड़ा दोनों कै नाय अपनाथैं। <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />बे सबन के ताहीं जो लौड़ा कै नाय अपनाथैं, दऊवा कै भी नाय अपनाथैं; लौड़ा कै भी अपनान बारेन के दऊवा होथैं।<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />तौ फिर, बौ संदेस कै अपने दिल मैं रखन ताहीं ठानौ, जो तुम सुरु से सुने हौ। अगर तुम बौ संदेस देथौ, तौ तुम हमेसा लौड़ा और दऊवा के संग रैहगे। <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />और जौ बहे है जो खुद मसीह हमैं देन को वादा करी रहै, अनंत जिंदगी।<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />जौ मैं तुमकै उनके बारे मैं लिखरौ हौं जो तुमकै धोका देन की कोसिस कर रै हैं। <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />लेकिन जैसी की तुमरे ताहीं, मसीह अपनी आत्मा को अभिसेक करी है। जबले बाकी आत्मा तुम्मैं बनी रहथै, कोई कै तुमकै सिखान की जरूरत नाय है। काहैकि बाकी आत्मा तुमकै हर चीज के बारे मैं सिखाथै, और जो बौ सिखाथै बौ सच्ची है, गलत नाय। आत्मा की सिक्छा को पालन करैं, और फिरौंकी मसीह के संग एक रहमैं।<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />हाँ, मेरे बालकौ, बाके संग बने रहथैं, ताकी जब बौ दिखाई देबै तौ हम साहस से भरे होमैं और बाके आनबारे दिनन मैं बासे सरमामैं नाय। <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />तुम जानथौ कि मसीह न्याय है; तुमकै पता होनो चाहिए कि, जो कोई भी सई करथै बौ परमेस्वर को बालका है।<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">परमेस्वर के बालका</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />देखौ, दऊवा हमसे कित्तो प्रेम करी है! बाको प्रेम इत्तो महान है कि हम बाके बालका कहे जाथैं, और तभईये, सच्ची मैं हम हैं। जहे कारड़ है कि दुनिया हमैं नाय जानथै: जो परमेस्वर कै जानी नाय। <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />मेरे प्रिय दोस्तौ, अब हम परमेस्वर के बालका हैं, लेकिन हबै ले जौ सपा ना है कि हम का बनंगे। लेकिन हम जानथैं कि जब मसीह दिखाई देथै, तौ हम बहे के हानी होंगे, काहैकि हम बाकै बैसिये देखंगे जैसी बौ सच्ची को है। <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />हर एक आदमी जो मसीह मैं जौ आसा रखथै बौ खुदकै बैसिये सुद्ध रखथै, जैसे मसीह सुद्ध है।<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />जो कोई पाप करथै बौ परमेस्वर के नियम कै तोड़न को दोसी है, काहैकि पाप अधर्म के बराबर है। <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />तुम जानथौ कि मसीह पापन कै दूर करन के ताहीं दिखाई दई, एक और जौ कि उनमैं कोई पाप नाय है। <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />तभईये हर कोई जो मसीह के संग एक रहथै, पाप करतै नाय रहथै है; लेकिन जो कोई पाप करतै रहथै, बौ कहु बाकै देखी या जानी नाय।<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />कोई तुमकै धोका ना देबै, मेरे बालकौ! जो कोई सई करथै बौ न्याय है, जैसी कि मसीह न्याई है। <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />जो कोई पाप करतै रहथै बौ सैतान को है, काहैकि सैतान सुरू सेई पाप करी है। परमेस्वर को लौड़ा जौ कारड़ से दिखाई दई, जो कि सैतान करी रहै बाको नास करै।<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />जो लोग परमेस्वर के बालका हैं, उनमैं से कोई भी पाप करनो सुरू ना करथै, काहैकि परमेस्वर को स्वभाव उनमैं है; और परमेस्वर उनके दऊवा हैं, बे पाप करतै नाय रहंगे। <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />हींना परमेस्वर के बालकन और सैतान के बालकन के बीच सपा अंतर है: जो लोग न्याय नाय करथैं जो सई हैं या अपने भईय्या से प्रेम नाय करथैं बे परमेस्वर के बालका नाय हैं।<verse eid="1JN 3:10" /></para>
  <para style="s">एक दुसरे से प्रेम</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />तुमरे जरिया सुरू से सुनो गौ संदेस जौ है: हमैं एक दुसरे से प्रेम करनो चाहिए। <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />हमैं कैन के जैसी नाय होनो चाहिए; बौ दुस्ट को रहै और अपनेई भईय्या हाबिल कै मार दई। कैन बाकै काहे मारी? बाके जरिया करी गई बातैं गलत रहैं, और बाको भईय्या जो बातैं करी, बे धार्मिक रहैं।<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />तभईये मेरे भईय्यौ, अगर दुनिया के लोग तुमसे नफरत करथैं, तौ अच्चमो मत करौ। <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />हम जानथैं कि हम मौत कै छोड़ दै हैं और जिंदगी मैं आए गै हैं; हम जाकै जानथैं काहैकि हम दुसरे भईय्यन से प्रेम करथैं। जो प्रेम नाय करथैं बे हबऊओ मौत की सक्ति के अधीन हैं। <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />जो लोग दुसरेन से नफरत करथैं बे हत्यारे हैं, और तुम जानथौ कि हत्यारन कै अनंत जिंदगी नाय मिली है। <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />जौ है कि हम जानथैं कि प्रेम का है: मसीह हमरे ताहीं अपनी जिंदगी दई। हमउँ कै भईय्यन के ताहीं अपनी ज्यान देनो चाहथैं! <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />पर जो कोई के पास दुनिया की सम्पत्ति होबै और बौ अपने भईय्या कै जरूरत मैं देखकै बाके ऊपर तरस ना खानो चाहबै, तौ बामै परमेस्वर को प्रेम कैसे बनो रह सकथै? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />मेरे बालका, हमरो प्रेम सिरफ सब्द और बात नाय होनो चाहिए; जौ सच्चो प्रेम होनो चाहिए, जो खुदकै काम मैं दिखाथै।<verse eid="1JN 3:18" /></para>
  <para style="s">परमेस्वर के अग्गु साहस</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />जौ, तौ, ऐसो है हम ऐसे जानंगे कि हम सच्चाई के हैं; और जौ तरीका से हम परमेस्वर की मौजुदगी मैं हमरे मन कै खुस रखंगे। <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />अगर हमरो मन हमारी बुराई करथै, तौ हम जानथैं कि परमेस्वर हमरे मन से बड़ो है और बौ सब कछु जानथै। <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />और तभईये, मेरे प्रिय दोस्तौ, अगर हमरो मन हमरी बुराई नाय करथै, तौ हममैं परमेस्वर की मौजुदगी के ताहीं साहस है। <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />हम जो कछु भी माँगथैं, हम बाकै पाय लेथैं, काहैकि हम बाकी आग्या मानथैं और बाकै खुस करथैं। <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />बाकी आग्या जौ है कि हम बाके लौड़ा ईसु मसीह के नाओं के ऊपर बिस्वास करथैं और एक दुसरे से प्रेम करथैं, ठीक जैसी मसीह हमैं आग्या दई रहै। <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />जो परमेस्वर की आग्यन को पालन करथैं बे परमेस्वर के संग एक रहथैं और परमेस्वर उनके संग एक रहथै। और बौ आत्मा के कारड़ जो परमेस्वर हमैं दई है हम जानथैं कि परमेस्वर हमरे संग एक रहथै।<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">सच्ची आत्मा और झूठी आत्मा</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />मेरे प्रिय दोस्तौ, बे सबन ऊपर बिस्वास मत करौ जो आत्मा होन को दाबा करथैं, लेकिन उन्हैं जौ पता लगान के ताहीं परखथैं कि का बे आत्मा परमेस्वर के घाँईं से आईं हैं कि ना; काहैकि तमान झूठे भविस्यवक्ता दुनिया मैं निकर खड़े भै हैं। <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />जौ तुम कैसे जान पागे कि का जौ परमेस्वर की आत्मा है: जो कोई भी जौ मानथै कि ईसु मसीह सरीर मैं हुईकै आओ है, बाके पास बौ आत्मा है जो परमेस्वर से आथै। <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />लेकिन जो कोई भी ईसु के बारे मैं जासे मना करथै, बाके झोने परमेस्वर की आत्मा नाय है। बौ जो आत्मा है बौ मसीह के दुस्मन से है; तुम सुने कि जौ आगो, और अब जौ दुनिया मैं आए चुको है।<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />लेकिन तुम, मेरे बालकौ परमेस्वर के हौ, और झूठे भविस्यवक्तन कै हराए हौ, काहैकि जो आत्मा तुम्मैं है बौ आत्मा से जो दुनिया से जुड़े भै लोगन मैं है जाधे सक्तिसाली है। <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />बे झूठे भविस्यवक्ता दुनिया के मामलन के बारे मैं बोलथैं, और दुनिया उनकै सुनथै काहैकि बे दुनिया के हैं। <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />लेकिन हम परमेस्वर के हैं। जो कोई भी परमेस्वर कै जानथै बौ हमैं सुनथै; जो कोई परमेस्वर से सम्बंध नाय रखथै, बौ हमरी बात नाय मानथै। फिरौंकी, जौ है कि हम सच्चाई की आत्मा और भरमान की आत्मा के बीच अंतर कैसे बताए सकथैं।<verse eid="1JN 4:6" /></para>
  <para style="s">परमेस्वर प्रेम है</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />प्रिय दोस्तौ, हम एक दुसरे से प्रेम करथैं, काहैकि प्रेम परमेस्वर से आथै। जो प्रेम करथै बौ परमेस्वर को बालका है और परमेस्वर कै जानथै। <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />जो प्रेम नाय करथै बौ परमेस्वर कै नाय जानथै, काहैकि परमेस्वर प्रेम है। <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />और परमेस्वर अपने इकलौते लौड़ा कै दुनिया मैं भेजकै हमरे ताहीं अपनो प्रेम दिखाई, ताकी हम बाके जरिया से जिंदगी पाय सकैं। <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />जहे बौ प्रेम है: ऐसो नाय है कि हम परमेस्वर से प्रेम करे हैं, बल्किन जौ कि बौ हमसे प्रेम करी और अपने लौड़ा कै बौ साधन बनाये कै भेजी, जोसे हमरे पाप माफ हुई जाथैं।<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />प्रिय दोस्तौ, अगर परमेस्वर हमसे ऐसो प्रेम करथै, तौ हमकै एक दुसरे से प्रेम करनो चाहिए। <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />कोई भी परमेस्वर कै नाय देखी है, लेकिन अगर हम एक दुसरे से प्रेम करथैं, तौ परमेस्वर हमरे संग एक हुईकै रहथै, और बाको प्रेम हममैं पूरो करो गौ है।<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />हमकै यकीन है कि हम परमेस्वर के संग एक रहथैं और बौ हमरे संग एक रहथै, काहैकि बौ हमकै अपनी आत्मा दई है। <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />और हम देखे हैं और दुसरेन कै गभाई देथैं कि दऊवा अपने लौड़ा कै दुनिया को उद्धारकर्ता बनन के ताहीं भेजी रहै। <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />अगर हम ऐलान करथैं कि ईसु परमेस्वर को लौड़ा है, तौ हम परमेस्वर के एक संग रहथै और परमेस्वर हमरे संग रहथै। <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />जो प्रेम परमेस्वर हमसे करथै बौ हम खुद जानथैं और बिस्वास करथैं। परमेस्वर प्रेम है, और जो प्रेम मैं रहथैं बे परमेस्वर के संग रहथैं और परमेस्वर उनके संग रहथै। <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />प्रेम हमकै पूरो बनाथै कि हम न्याय के दिन मैं हिम्मत कर सकैं; और हमरे झोने जौ होगो काहैकि जौ दुनिया मैं हमरी जिंदगी मसीह के हानी है। <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />प्रेम मैं कोई डर नाय है; पूरो प्रेम सबै भै कै दूर करथै। तौ फिरौंकी, प्रेम डरान बारे कोई भी आदमी मैं पूरो नाय मानो गौ है, काहैकि डर को सजा से का लेनो देनो है।<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />हम प्रेम करथैं काहैकि परमेस्वर पहले हमसे प्रेम करथै। <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />अगर कोई कहबै, “मैं परमेस्वर से प्रेम करथौं,” और अपने भईय्या से बैर रखै; तौ बौ झूठो है; काहैकि जो अपने भईय्या से, जोकै बौ देखी है, प्रेम ना करथै, तौ बौ परमेस्वर से भी जोकै बौ ना देखी, प्रेम ना कर सकथै। <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />मसीह हमकै जो आग्या दई है बौ जौ है: जो कोई परमेस्वर से प्रेम करथै बाकै अपने भईय्या से भी प्रेम करनो चाहिए।<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">दुनिया मैं हमरी जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />जोको जौ बिस्वास है कि ईसु मसीहा है, बौ परमेस्वर के बालका हैं; और जो कोई दऊवा से प्रेम करथै बौ बाके बालकन से भी प्रेम करथै। <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />ऐसिये हम जानथैं कि हम परमेस्वर के बालकन से प्रेम करथैं: जौ परमेस्वर से प्रेम करन और बाकी आग्यन को पालन करन से है। <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />परमेस्वर के ताहीं हमरो जो प्रेम है जाको मतलब है कि हम बाकी आग्या को पालन करथैं। और बाको आदेस हमरे ताहीं भौत कठिन नाय है, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />काहैकि परमेस्वर को हर बालका दुनिया कै हरान के काबिल है। और हम अपने बिस्वास के जरिया दुनिया मैं जीत हासिल करथैं। <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />दुनिया कै कौन हराए सकथै? सिरफ बौ आदमी जो बिस्वास करथै, कि ईसु परमेस्वर को लौड़ा है।<verse eid="1JN 5:5" /></para>
  <para style="s">ईसु मसीह के बारे मैं गभाई</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />ईसु मसीह बौ है जो अपने बपतिस्मा के पानी और अपनी मौत के खून के संग आओ रहै। बौ नाय सिरफ पानी के संग, बल्किन पानी और खून दोनों के संग आओ रहै। और आत्मा खुद गभाई देथै कि जौ सत्य है, काहैकि आत्मा सच्ची है। <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />तीन गभा हैं: <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />आत्मा, पानी और खून; और तीनौ एकै गभाई देथैं। <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />हम इंसान की गभाई मानथैं; लेकिन परमेस्वर की गभाई भौत मजबूत है, और बौ अपने लौड़ा के बारे मैं जौ गभाई दई है। <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />तभईये परमेस्वर के लौड़ा ऊपर बिस्वास करन बारे सबै लोग के दिलन मैं जौ गभाई है; लेकिन जो लोग परमेस्वर कै नाय मानथैं, बे बाकै झूठो बनाये दईं हैं, बे जौ नाय मानीं हैं कि परमेस्वर उनके लौड़ा के बारे मैं का कही है। <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />गभाई जौ है: परमेस्वर हमैं अनंत जिंदगी दई है, और जौ जिंदगी बाके लौड़ा मैं जाको स्रोत है। <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />जोके पास भी लौड़ा है बाकी जिंदगी है; जोके पास परमेस्वर को लौड़ा नाय है बाके पास जिंदगी नाय है।<verse eid="1JN 5:12" /></para>
  <para style="s">हमेसा की जिंदगी</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />मैं जौ तुमकै तभईये लिखरौ हौं ताकी तुम जान सकौ कि तुमरे पास अनंत जिंदगी है, तुम जो परमेस्वर के लौड़ा के नाओं के ऊपर बिस्वास करथौ। <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />हमरे पास परमेस्वर की मौजूदगी मैं हिम्मत है, काहैकि हमैं यकीन है कि बौ हमैं सुनथै अगर हम बासे बाकी इच्छा के अनुसार कुछ भी माँगथैं। <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />जब भी हम बासे पूँछथैं तौ बौ हमैं सुनथै; और जब से हम जानथैं कि जौ सच है, हम जहो जानथैं कि बौ हमैं बहे देथै जो हम बासे माँगथैं।<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />अगर तुम विस्वासी भईय्या कै पाप करत भौ देखथौ जो मौत को कारड़ नाय बनथै, तौ तुमकै परमेस्वर से प्रार्थना करनो चाहिए, जो बौ आदमी कै जिंदगी देगो। जौ उन लोगन ऊपर लागू होथै जिनके पापन से मौत नाय होथै। लेकिन बौ पाप है जो मौत के घाँईं लै जाथै, और मैं जौ नाय कहथौं कि तुमकै जाके बारे मैं परमेस्वर से प्रार्थना करनो चाहिए। <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />सब अधर्म पाप है, लेकिन ऐसो पाप है जोसे मौत नाय होथै।<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />हम जानथैं कि जो कोई परमेस्वर से जनमो है, बौ पाप नाय करथै; पर जो परमेस्वर से जनमो है, बाकै परमेस्वर को लौड़ा बचाए कै रखथै: और बौ दुस्ट बाकै छुइ ना पाथै।<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />हम जानथैं कि हम परमेस्वर के हैं, भलेई पूरी दुनिया दुस्ट के सासन मैं है।<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />हम जानथैं कि परमेस्वर को लौड़ा आओ है और बौ हमैं समझ दई है, ताकी हम सच्चे परमेस्वर कै जान सकैं। हम सच्चे परमेस्वर के संग और बाके लौड़ा ईसु मसीह के संग एक हुईकै रहथैं। जहे सच्चो परमेस्वर है, और जहे अनंत जिंदगी है।<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />मेरे बालकौ, अपने आपकै झूठे मूर्ति देवतन से बचाए कै रखौ!<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>