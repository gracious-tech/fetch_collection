<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Rana Tharu</book>
  <para style="h">इब्रानियों</para>
  <para style="toc3">इब्रानियों</para>
  <para style="toc2">इब्रानियों</para>
  <para style="toc1">इब्रानियों की चिट्ठी</para>
  <para style="mt2">इब्रानियों की चिट्ठी</para>
  <para style="mt1">इब्रानियों की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">इब्रानियों की किताब एक बढ़ावा देन बारी चिट्ठी है जो दर्साथै कि कैसे ईसु पुराने नियम की तमान भविस्यवाँड़ियन कै पूरो करी। जौ एक उपदेस के जैसे लिखी गई रहै। इब्रानियों मैं पुराने नियम के 60 से जाधे संदर्भ हैं जो सपा रूप से दिखाथै कि कैसे ईसु भविस्यवाँड़ी और यहूदि बड़े पुजारी के कर्तव्य कै पूरो करी। जौ बजह से जौ किताब यहूदि मसीहियन कै बढ़ावा देन बारी रहै। इब्रानी दिखाईं कि कैसे ईसु नियम कै पूरो करी ताकी पुजारिन कै फिर कहु कुरबानी ना देने पड़ै। ईसु सबै पापन के ताहीं एक बार और हमेसा के ताहीं कुरबानी दई।</para>
  <para style="ip">इब्रानियों कै कौन लिखो, जौ कोई नाय जानथै, लेकिन विद्वान, प्रेरित पौलुस, लूका या बरनबास जैसे सुझाव दईं हैं। लिखन की तारीक भी पता नाय है लेकिन भौतन को माननो है कि जौ ईसु के जनम के 70 साल पहले लिखी गई रहै। यरूसलेम सहर कै सन 70 मैं नास कर दौ गौ रहै, लेकिन जौ चिट्ठी के लेखक यरूसलेम के बारे मैं बात करथैं जैसे कि जौ हबऊ ले नास नाय भौ रहै। इब्रानियों की किताब कै रोम सहर मैं लिखो गौ रहै और हुई सकथै निरी कलीसियन मैं प्रसारित करो गौ रहै। <char style="xt"><ref loc="HEB 13:24">13:24</ref> </char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. लेखक दिखाथै कि ईसु परमेस्वर के भविस्यवक्तन और स्वर्गदूतन से स्रेस्ठ है। <char style="ior"><ref loc="HEB 1:1-4:13">1:1–4:13</ref> </char></para>
  <para style="io1">2. फिर बौ दिखाथै कि ईसु बे पुजारिन से स्रेस्ठ है जो यरूसलेम मैं परमेस्वर के मंदिर मैं सेवा करथैं। <char style="ior"><ref loc="HEB 4:14-7:28">4:14–7:28</ref></char></para>
  <para style="io1">3. संगै ईसु की सेवकाई बौ पुरानी वाचा से भी स्रेस्ठ है जो परमेस्वर अपने लोगन के संग बौ नियम के जरिया करी जो बौ मूसा कै दई रहै। <char style="ior"><ref loc="HEB 8:1-10:31">8:1–10:31</ref></char></para>
  <para style="io1">4. जौ समझान के बाद कि ईसु हर तरहन से स्रेस्ठ है, लेखक कई व्यवहारिक निर्देस देथै। <char style="ior"><ref loc="HEB 10:32-13:17">10:32–13:17</ref> </char></para>
  <para style="io1">5. अंत मैं लेखक कुछ बढ़ावा और अभिवादन के संग चिट्ठी कै खतम करथै। <char style="ior"><ref loc="HEB 13:18-25">13:18-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">अपने लौड़ा के जरिये परमेस्वर को बचन</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />पुराने समय मैं परमेस्वर पुरखन से निरे दाँव और अलग-अलग तरीकन से भविस्यवक्तन के जरिया बात करी, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />पर आखरी दिनन मैं बौ हमसे लौड़ा के जरिया बात करी है, जोकै परमेस्वर सबै चीजन को वारिस होन के ताहीं चुनी है। और बौ सब चीजन को वारिस ठहराई, बहे के जरिया बौ पूरो युग भी बनाई। <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />बौ परमेस्वर की महिमा को उजियारो और बाके तत्व की छाप है, और सब चीजन कै अपनी सामर्थ्य के बचन से सम्भालथै: बौ पापन कै धोएकै महान परमेस्वर के दहने जाए बैठो।<verse eid="HEB 1:3" /></para>
  <para style="s">परमेस्वर के लौड़ा की महानता</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />लौड़ा कै स्वर्गदूतन से उतनोई महान ठहराओ गौ, जितनो बौ उनसे बड़े पद को वारिस हुईकै महान नाओं पाई। <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />काहैकि स्वर्गदूतन मैं से परमेस्वर कब कोई से कही,</para>
  <para style="q1" vid="HEB 1:5">“तू मेरो लौड़ा है;</para>
  <para style="q1" vid="HEB 1:5">आजै मैं तोकै जन्माओं हौं।”</para>
  <para style="p" vid="HEB 1:5">और न ही परमेस्वर कोई स्वर्गदूत के बारे मैं जौ कही,</para>
  <para style="q1" vid="HEB 1:5">“मैं बाको दऊवा होंगो,</para>
  <para style="q1" vid="HEB 1:5">और बौ मेरो लौड़ा होगो?”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />और जब परमेस्वर पहलोठे कै दुनिया मैं लाथै, तौ कहथै,</para>
  <para style="q1" vid="HEB 1:6">“परमेस्वर के सब स्वर्गदूत बाकी आराधना करैं।”<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />और स्वर्गदूतन के बारे मैं परमेस्वर जौ कहथै,</para>
  <para style="q1" vid="HEB 1:7">“परमेस्वर अपने स्वर्गदूतन कै आत्मा,</para>
  <para style="q1" vid="HEB 1:7">और अपने सेवकन कै धधकत भइ आगी बनाथै।”<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />लेकिन लौड़ा के बारे मैं परमेस्वर कहथै,</para>
  <para style="q1" vid="HEB 1:8">“हे धर्मी परमेस्वर, तेरो सिंहासन हमेसा रैहगो,</para>
  <para style="q1" vid="HEB 1:8">तेरे राज्य को राजदंड न्याय को राजदंड है।<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />तू धार्मिकता से प्रेम और अधर्म से बैर रखो;</para>
  <para style="q1" vid="HEB 1:9">जहे के मारे परमेस्वर, तेरो परमेस्वर,</para>
  <para style="q1" vid="HEB 1:9">तेरे संग बारेन से बढ़ाये कै खुसी रूपी तेल से तेरो अभिसेक करी।”<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />और जौ कि,</para>
  <para style="q1" vid="HEB 1:10">“हे प्रभु, सुरुवात मैं तू पृथ्वी की बुनियाद डारो,</para>
  <para style="q1" vid="HEB 1:10">और स्वर्ग तेरे हातन की कलाकारी है।<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />बे तौ खतम हुई जामंगे;</para>
  <para style="q1" vid="HEB 1:11">लेकिन तैं हमेसा रैहगो और</para>
  <para style="q1" vid="HEB 1:11">बे सब लत्ता के हानी पुराने हुई जामंगे।<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />और तू उनकै चद्दर के हानी लपेटैगो,</para>
  <para style="q1" vid="HEB 1:12">और बे लत्ता के हानी बदल जामंगे;</para>
  <para style="q1" vid="HEB 1:12">पर तैं बहे है</para>
  <para style="q1" vid="HEB 1:12">और तेरी जिंदगी कहु खतम नाय होथै।”<verse eid="HEB 1:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />परमेस्वर अपने स्वर्गदूतन मैं से कोई से कहु भी कही होबै,</para>
  <para style="q1" vid="HEB 1:13">“तू मेरे दहने बैठ,</para>
  <para style="q1" vid="HEB 1:13">जब तक कि मैं तेरे बैरियन कै तेरे पाँव के तरे की चौकी न कर दियौं?”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />का बे सब परमेस्वर की सेवा करन बारे स्वर्गदूत की आत्मा नाय हैं; जो उद्धार पानबारे की सेवकाई करन के ताहीं पनारे जाथैं?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">महान उद्धार</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />जहेमारे जो सच्चाई हम सुने हैं, कि हम बे बातन मैं जाधे ध्यान दियैं, ऐसो न होबै कि बहक कै उनसे दूर चले जामैं। <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />काहैकि जो बचन स्वर्गदूतन के जरिया कहो गौ रहे, जब बौ टिको रहो और हर एक गलत काम और आग्या न मानन को सई-सई बदला मिलो जोके बे लायक हैं। <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />तौ आपन सब जनी ऐसे बड़े उद्धार से बिना खटके कैसे रह सकथैं? जोकी बातचीत पहले-पहलान प्रभु के जरिया भइ, और सुनन बारेन के जरिया हमकै बिस्वास भौ। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />और संगै परमेस्वर भी अपनी इच्छा के अनुसार चिन्ह चमत्कार के अचम्मे काम, निरे तरह के सामर्थ्य के काम और पवित्र आत्मा के वरदानन कै बाँटन के जरिया जाकी गभाई देत रहो।<verse eid="HEB 2:4" /></para>
  <para style="s">बौ जो हमैं उद्धार के घाँईं लै जाथै</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />परमेस्वर, बौ आनबारी दुनिया कै जोकी बात हम कर रै हैं, स्वर्गदूतन के हात न करी। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />जाके बजाय जैसो की सास्त्र मैं कहूँ पर कहो गौ है,</para>
  <para style="q1" vid="HEB 2:6">“इंसान का है, कि तू बाकी खबर लेथै?</para>
  <para style="q1" vid="HEB 2:6">या इंसान को लौड़ा का है, कि तू बाके ऊपर नजर करथै?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />तू बाकै स्वर्गदूतन से थोड़िये कम करो;</para>
  <para style="q1" vid="HEB 2:7">तू बाके ऊपर महिमा और आदर को मुकुट रखो और बाकै अपने हातन के कामन मैं अधिकार दौ।<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />तू सब कछु बाके पाँए तरे कर दौ।”</para>
  <para style="m" vid="HEB 2:8">जहेमारे जब कि बौ सब कछु बाके अधीन कर दई, तौ बौ कुछ भी न रख छोड़ी, जो बाके अधीन न है। पर हम अब तक सब कछु बाके अधीन नाय देखथैं। <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पर हम ईसु कै जो स्वर्गदूतन से थोड़िये कम करो गौ है, मौत को दुख उठान के बजह से महिमा और आदर को मुकुट पहने भै देखथैं; ताकी परमेस्वर के अनुग्रह से बौ हर एक इंसान के ताहीं मौत को स्वाद चखै। <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />काहैकि जोके ताहीं सब कछु है, और जोके जरिया सब कछु है, बाकै जहे अच्छो लगो कि जब बौ भौत से लौड़न कै महिमा मैं पहोंचाबै, तौ उनके उद्धार करन बारे कै दुख उठान के जरिये सिद्ध करै। <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />काहैकि पवित्र करन बारो और जो पवित्र करे जाथैं, सब एकै मूल से है, मतलब परमेस्वर, जहे के मारे ईसु उनकै भईय्या कहेन से नाय सरमाथै। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />लेकिन बौ परमेस्वर से कहथै,</para>
  <para style="q1" vid="HEB 2:12">“मैं तेरो नाओं अपने भईय्यन कै सुनांगो,</para>
  <para style="q2" vid="HEB 2:12">मैं सभा के बीच मैं तेरो गाना गामंगो।”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />बौ जहो कहथै,</para>
  <para style="q1" vid="HEB 2:13">“मैं बाके ऊपर भरोसा रखंगो।”</para>
  <para style="p" vid="HEB 2:13">और बौ जहो कहथै,</para>
  <para style="q1" vid="HEB 2:13">“देख, मैं बे बालकन के संग हौं जोकै परमेस्वर मोकै दई है।”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />जहेमारे जब कि बालका मास और खून के भागीदार हैं, तौ ईसु खुद भी उनके तरह उनको सहभागी हुई गौ; ताकी मौत के जरिया बाकै जोकै मौत ऊपर सक्ति मिली रहै, मतलब सैतान कै निकम्मो कर देबै, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />और जितने मौत के डर के मारे जिंदगी भर दास बने भै रहे, उनकै छुड़ाय लेबै। <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />काहैकि बौ तौ स्वर्गदूतन कै नाय बल्कि अब्राहम के बंस कै संभालथै। <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />जहेमारे बाकै जरूरी रहै, कि सब बातन मैं अपने भईय्या-बहेनियन के जैसे बनै; जोसे बौ बे बातन मैं जो परमेस्वर से जुड़ी भइ है, एक दयालु और बिस्वास के लायक बड़ो पुजारी बनै ताकी लोगन के पापन के ताहीं पछताबै। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />काहैकि जब बौ परिक्छा की घड़ी मैं भी दुख उठाई, तौ बौ उनकी भी मदत कर सकथै, जिनकी परिक्छा होथै।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">ईसु मूसा से महान</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />जहेमारे, हे पवित्र भईय्यौ और बहेनियौ, तुम जो स्वर्गिय बुलावा के भागीदार हौ, बौ प्रेरित और बड़े पुजारी ईसु के ऊपर ध्यान करौ। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />बौ अपने परमेस्वर के प्रति भरोसेमंद रहे, जो बाकै जौ काम करन के ताहीं चुनी रहै, ठीक बैसोई जैसो मूसा भी परमेस्वर के घर मैं अपने काम मैं भरोसेमंद रहै। <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />काहैकि ईसु मूसा से इतनो बढ़कै महिमा के लायक समझो गौ है, जितनो की घर बनानबारो घर से बढ़कै आदर पाथै। <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />काहैकि हर एक घर कै कोई न कोई बनानबारो होथै, लेकिन जो सब कछु बनाई बौ परमेस्वर है। <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />मूसा तौ परमेस्वर के पूरे घर मैं सेवक के तरह भरोसेमंद रहो, कि जिन बातन को वर्ड़न आनबारे समय मैं हीन बारो रहै, उनकी गभाई दियै। <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />लेकिन मसीह लौड़ा के जैसी परमेस्वर के घर को अधिकारी है, और बाको घर हम हैं, अगर हम हिम्मत मैं, और अपनी आसा के घमंड मैं आखरी तक मजबूती से बिस्वास मैं टिके रहे।<verse eid="HEB 3:6" /></para>
  <para style="s">परमेस्वर के लोगन ताहीं आराम</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />जहेमारे जैसो पवित्र आत्मा कहथै,</para>
  <para style="q1" vid="HEB 3:7">“अगर आज तुम बाकी अबाज सुनौ,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />तौ अपने मन कै कठोर मत करौ,</para>
  <para style="q2" vid="HEB 3:8">जैसो कि तुमरे बड़े-बूढ़े परमेस्वर से बलवा करन के समय करीं रहैं,</para>
  <para style="q2" vid="HEB 3:8">जैसी जब बौ दिन बे बन मैं रहैं, जब बे बाकी परिक्छा लईं।<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />परमेस्वर कहथै जितै बे मोकै जाँची और परखीं</para>
  <para style="q2" vid="HEB 3:9">और चालीस साल ले मेरे काम देखीं।<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />जहे के मारे मैं बे लोगन से गुस्सा रहौं,</para>
  <para style="q2" vid="HEB 3:10">और कहो, ‘इनके मन हमेसा भटकत रहथैं,</para>
  <para style="q2" vid="HEB 3:10">और जे मेरे रहा और मेरी आग्या कै नाय मानीं।’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />तौ मैं गुस्सा मैं आए कै कसम खाओ,</para>
  <para style="q2" vid="HEB 3:11">‘बे बौ जघा मैं कहु ना पौहौंच पांगे, जितै मैं उनकै आराम दौ।’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />हे भईय्यौ, चहाचीते रहबौ, कि तुम मैं ऐसो बुरो और अविस्वासी मन न होबै, जो जिंदे परमेस्वर से दूर हुई जाबौ। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />बल्कि पवित्र सास्त्र मैं जो दिन आज को दिन कहो जाथै, हर दिन एक दूसरे के समझानो चाहिए, ऐसो नाय होबै, कि तुम मैं से कोई आदमी पाप के धोका मैं आए कै कठोर हुई जाबै। <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />काहैकि हम मसीह के भागीदार भै हैं, अगर हम अपने पहले बिस्वास मैं आखरी ले मजबूती से टिके रहमैं।<verse eid="HEB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HEB 3:15" />जैसो सास्त्र कहथै,</para>
  <para style="q1" vid="HEB 3:15">“अगर आज तुम परमेस्वर की अबाज सुनौ,</para>
  <para style="q1" vid="HEB 3:15">तौ अपने मन कै कठोर मत करौ, जैसो कि तुमरे पुरखा परमेस्वर से बलवा करन के समय करीं रहैं।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />बे लोग कौन रहैं जो परमेस्वर की अबाज सुनीं और बाके विरुद्ध बलवा करीं? का बे सब नाय जो मूसा के जरिया मिस्र से निकरे रहैं। <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />और बौ चालीस साल तक कौन लोगन से गुस्सा रहो? का उन्हईं से नाय, जो पाप करीं, और उनके सरीर बन मैं पड़े रहे? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />और बौ कौन से कसम खाई, कि तुम मेरे आराम मैं नाय घुस पागे: खाली उनसे जो-जो आग्या न मानी? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />जौ तरह हम देखथैं, कि बे अविस्वास के बजह से बौ देस मैं घुस नाय सकै।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />तभई जबकी बाके विसराम मैं घुसन को वादा अब तक है, तौ हमकै डरनो चाहिए; ऐसो नाय होबै, कि तुम मैं से कोई आदमी बासे अलग रह जामैं। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />काहैकि हमैं उन्हईं के जैसी सुसमाचार सुनाओ गौ है, लेकिन सुने भै बचन से उनकै कछु फायदा न भौ; काहैकि सुनन बारेन के मन मैं बिस्वास के संग नाय बैठो। <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />और हम जितने बिस्वास करे हैं, बौ आराम कै पाथैं;</para>
  <para style="q1" vid="HEB 4:3">जैसो बौ कही, “मैं अपने गुस्सा मैं कसम खाओ,</para>
  <para style="q2" vid="HEB 4:3">कि बे मेरे आराम मैं घुस नाय पांगे।”</para>
  <para style="m" vid="HEB 4:3">बे जहो कहीं कि दुनिया की उत्पत्ति के समय से बाके काम हुई चुके हैं। <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />काहैकि सातवें दिन के बारे मैं बौ कहूँ पर ऐसो कही है, “परमेस्वर सातवें दिन अपने सब कामन कै निपटाए कै आराम करी।”<verse eid="HEB 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 4:5" />और जौ जघा फिर ऐसो कहथै,</para>
  <para style="q1" vid="HEB 4:5">“बे मेरे आराम मैं घुस नाय पांगे।”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />तौ जब जौ बात बाकी है कि कितने और हैं जो बौ आराम मैं घुसैं, और इस्राएलिन कै, जिनकै बाको सुसमाचार पहले सुनाओ गौ, बे आग्या न मानन के बजह से बामै घुस नाय पाईं। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />तभई परमेस्वर एक दिन मतलब “आज को दिन” ठहराएकै दाऊद की किताब मैं, जैसो कहो गौ है,</para>
  <para style="q1" vid="HEB 4:7">“अगर आज को दिन बाको सब्द सुनौ,</para>
  <para style="q1" vid="HEB 4:7">तौ अपने मन कै कठोर मत करौ।”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />अगर यहोसू उनकै आराम करन बारी जघा मैं लै जातो, तौ दुसरे दिन की कोई बातचीत न होती। <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />तभईये जान लियौ कि परमेस्वर के लोगन ताहीं साबत को दिन बाकी है। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />जो कोई भी बाके विसराम मैं गौ है, बौ भी परमेस्वर के अग्गु अपने काम कै पूरो करकै विसराम करी है। <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />जहे ताहीं हम बौ विसराम मैं घुसन के ताहीं कोसिस करैं, ऐसो न होबै, कि कोई उनके हानी आग्या न मानकै गिरै।<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />परमेस्वर को बचन जिंदो, मजबूत, और दुईधारी तलवार जो प्राँड़, आत्मा, गाँठी-गाँठी और गूदा-गूदा कै अलग करकै सबै तरहन से काटथै, और जहाँ मन, आत्मा मिलथै बौ मन की इच्छा और बिचारन कै जाँचन मैं सक्छम है। <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />ऐसो कुछ भी न है जो परमेस्वर से छिपाओ जाए सकथै; पूरी दुनिया मैं सब कुछ उजागर है, और बाकी आँखी के अग्गु सबै चीज खुली हैं। और जौ बहे के ताहीं है जो हमैं सबन कै अपनो-अपनो हिसाब देने है।<verse eid="HEB 4:13" /></para>
  <para style="s">ईसु महान बड़ो पुजारी</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />तौ हम बौ बिस्वास कै मजबूत से पकड़थैं जोकै हम मानथैं। काहैकि हमरे झोने एक महान बड़ो पुजारी है जो परमेस्वर के झोने स्वर्ग मैं गौ है, परमेस्वर को लौड़ा ईसु। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />हमरो महान बड़ो पुजारी बौ ना है जो हमारी कमजोरी मैं सहानुभूति महसूस कर पाबै। इनकी जघा मैं हमरे झोने एक महान बड़ो पुजारी है, जोकी हर तरहन से परिक्छा भइ लेकिन बौ पाप नाय करी। <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />तभई आबौ, हम अनुग्रह के सिंहासन के झोने हिम्मत भाँदकै चलैं, कि हमरे ऊपर दया होबै, और बौ अनुग्रह पामैं, जो जरूरत के समय हमरी मदत करै।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />हर एक बड़ो पुजारी अपने संगी लोगन मैं से चुनो जाथै, और बाकै परमेस्वर से जुड़े भै मामलेन मैं लोगन को प्रतिनिधित्व करन के ताहीं, पापन के ताहीं भेंट और बलिदान चढ़ान के ताहीं चुनो जाथै। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />बौ अग्यानी और भूले भटकन के संग नर्मी से पेस आन मैं सक्छम है, काहैकि बौ खुदै कई मायनेन मैं कमजोर है। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />जहे बजह से जौ जरूरी हुई जाथै कि बौ लोगन के ताहीं बल्कि अपने ताहीं भी पापन को बलिदान चढ़ाय करै। <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />कोई भी अपने आप बड़ो पुजारी होन को सम्मान नाय चुनथै। सिरफ परमेस्वर के बुलावे सेई एक आदमी कै बड़ो पुजारी बनाओ जाथै, जैसे हारून रहै। <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />बैसिये मसीह भी बड़ो पुजारी बनन को सम्मान अपने ऊपर नाय लई, जाके बजाय, परमेस्वर बासे कही,</para>
  <para style="q1" vid="HEB 5:5">“तू मेरो लौड़ा है;</para>
  <para style="q2" vid="HEB 5:5">आज मैं ही तोकै जन्माओं हौं।”<figure style="fig" alt="High priest with his priestly clothes and censer" file="hk00267c.tif" size="col" copy="Horace Knowles ©" ref="5:5">बड़ो पुजारी अपने पुरोहित लत्ता और धूपदानी के संग</figure><verse eid="HEB 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6" />ऐसिये बौ दुसरी जघा मैं कहथै,</para>
  <para style="q1" vid="HEB 5:6">“तू मेलिकिसिदक की रीति मैं</para>
  <para style="q2" vid="HEB 5:6">हमेसा के ताहीं पुजारी है।”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />जब ईसु पृथ्वी मैं सरीर की अवस्था मैं रहै, बौ अपनी जिंदगी मैं परमेस्वर से प्रार्थना और बिनती आँसु बहाएकै करी, जो बाकै मौत से बचाए सकत रहै। लेकिन बौ विनम्र और समर्पित रहै, तभई परमेस्वर बाकै सुनी। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />लौड़ा होने के बाबजूद भी बौ दुख उठाए-उठाएकै आग्या मानन सीखो। <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />और सिद्ध बनकै अपने सब आग्या मानन बारेन के ताहीं अनंत उद्धार को सोता बन गौ। <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />और बाकै परमेस्वर के घाँईं से मेलिकिसिदक की रीति मैं बड़ो पुजारी को पद मिलो।<verse eid="HEB 5:10" /></para>
  <para style="s">बिस्वास छोड़न के खिलाप चितौनी</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />हमैं बाके बारे मैं भौत बातैं कहनी है, लेकिन तुमकै समझनो मुस्किल है; काहैकि तुम ऊँचो सुनन लागे हौ। <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />तुमकै अबले तौ गुरुजी बन जानो चाहिए रहै। फिर भी जौ जरूरी ही गौ है कि कोई तुमकै परमेस्वर को बचन की सुरुवाती सिक्छा दुबारा से सिखाए। तुम तौ ऐसे बन गै हौ कि अन्न के बदले दूद की जरूरत है। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />जो कोई भी दूद पीथै, बौ हबै भी बालक है बाकै न्याय के मामले की कोई पहचान ना है। <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पर अन्न स्यानो के ताहीं है, जिनकी इन्द्रियाँ अभ्यास के जरिया भले-बुरे की पहचान करन मैं सक्छम है।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />तौ आबौ हम अग्गु बढ़ै, परिपक्क सिक्छा के ताहीं और मसीह संदेस के पहले पाठन कै छोड़ देमैं। हमैं फिर से बेकार के कामन से मन फिरनो और परमेस्वर के ऊपर बिस्वास करन की बुनियाद ना रखनो चाहिए; <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />बपतिस्मा और हात रखन की, और मरे भैन के पुनरुत्थान और अनंत न्याय के बारे मैं सिक्छा मत दियौ। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />चलौ अग्गु बढ़थैं! अगर परमेस्वर जैसो चाहगो तौ हम बैसिये करंगे।<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />जो लोग अपने बिस्वास कै छोड़ देथैं, उनकै दुबारा पस्चाताप करन के ताहीं कैसे लाओ जाए? बे पहले परमेस्वर के उजीते मैं रहैं; बे स्वर्गिय दान को सुआद चखीं और पवित्र आत्मा के भागीदार बने। <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />बे अनुभव से जानत रहैं कि परमेस्वर को बचन अच्छो है, और बे आनबारे युग के अचम्मे काम कै महसूस करी रहैं। <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />और फिर बे अपनो बिस्वास छोड़ दईं। उन्हैं मन फिरान के ताहीं दुबारा से नया बनानो नामुमकिन है, काहैकि बे अपने ताहीं परमेस्वर के लौड़ा कै दुबारा क्रूस मैं टाँगथै, और खुलेआम बाकी बेजती करथैं। <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />जो जमीन बार-बार होन बारी बरखा को पानी पीथै और जोतन-बोन बारेन के ताहीं साग-पात उपजाथै, बौ परमेस्वर की आसीस पाथै। <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />पर अगर बौ कांटेदार झाड़ी और ऊँटकटार उपजाबै तौ बौ निकम्मी और स्रापित होन की कगार मैं है, और बाकै आखरी मैं जलाओ जाने है।<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />लेकिन प्रिय दोस्तौ, भलेई हम जौ तरीका से बोलथैं, तहुँओं हम तुम्हारे बारे मैं पक्का जानथैं कि तुम्हारे झोने अच्छी आसीस है, जो तुम्हारे उद्धार से जुड़ी बातन मैं भरोसा करथैं। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />परमेस्वर अधर्मी नाय है। जो तुम करे रहौ या तुमरे जरिया करी गई सेवा मैं तुम बाके ताहीं जो प्रेम दिखाए रहौ और अभऊ पवित्र लोगन कै दे रै हौ, बौ बे कामन कै नाय भूलैगो। <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />हमारी भौत इच्छा है कि तुम मैं से हर एक आखरी ले बढ़ावा से रहियो, ताकी जिन बातन की तुम आसा करथौ बे पूरी होमैं। <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />हम ना चाहथैं कि तुम आलसी बनौ, बल्कि उन लोगन के हानी बनौ जो बिस्वास करथैं और धीरज धरन बारे हैं, और ऐसे करकै परमेस्वर जो वादा करी है बाकै पाबौ।<verse eid="HEB 6:12" /></para>
  <para style="s">परमेस्वर को पक्को वादा</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />परमेस्वर जब अब्राहम से वादा करी तौ कसम खान के ताहीं बाके सामने खुद से बड़ो और कोई न रहै, इसलै बौ अपनिए नाओं से जौ कसम खाई, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />बौ कही, “मैं तोसे वादा करथौं, कि मैं तोकै आसीस देंगो, और तेरे बंस कै बढ़ात जांगो।” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />अब्राहम धीरज धरन बारो रहै, इसलै बौ, बौ सब पाय लई जो परमेस्वर बासे वादा करी रहै। <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />जब लोग कोई कसम खाथैं, तौ अपने से बड़े कोई को नाओं लैकै कसम खाथैं, और कसम खान से पूरी बहस बाजी सुलझ जाथै। <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />परमेस्वर भी खुदकै एक कसम के संग भाँदी, ताकी जो लोग वादा कै पाईं हैं बे पूरी तरहन से संतुस्ट हुई सकैं कि बौ अपनो मन कहु ना बदलैगो। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />इसलै परमेस्वर अपनो वादा और अपनी कसम दोनों दई है। जे दुई चीजैं कहु ना बदलन बारी हैं काहैकि परमेस्वर के ताहीं झूठ बोलनो असंभव है। इसलै हम जो बाके संग सुरक्छा पाए हैं, हमरे सामने रखी आसा कै मजबूती से पकड़न के ताहीं भौत उत्साहित होथैं। <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />हमरे पास जौ आसा हमारी जिंदगी के ताहीं एक लंगर के रूप मैं है। बौ सुरक्छित और पक्को है, और स्वर्गिय मंदिर के परदा से होत भै भीतरी पवित्र स्थान मैं जाथै। <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />हमारे घाँईं से ईसु हमसे पहले हुँआँ गौ, और मेलिकिसिदक की रीति से हमेसा के ताहीं बड़ो पुजारी बनो।<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मेलिकिसिदक पुजारी<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">पुजारी</char></note></para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />जौ मेलिकिसिदक सालेम को राजा, और परमप्रधान परमेस्वर को पुजारी<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">पुजारी</char></note> रहै, जब अब्राहम बौ लड़ाई से लौटत रहै जामैं बौ चार राजन कै हराई रहै, बासे मेलिकिसिदक मिलो और बाकै आसीस दई, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />और अब्राहम जो कछु लई रहै बाको दसमों भाग बाकै दई। मेलिकिसिदक नाओं को पहलो मतलब “धार्मिकता को राजा” है; और बौ सालेम को राजा रहै, बाके नाओं को मतलब “सांति को राजा” भी है। <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />मेलिकिसिदक की अईय्या-बाबा या बाके बुजुर्गन मैं से कोई के बारे मैं नाय लिखो है; बाके जनम या बाकी मौत को कोई लेखा नाय है। बौ परमेस्वर के लौड़ा के जैसो है; बौ हमेसा के ताहीं पुजारी ठहरो है। <verse eid="HEB 7:3" /><verse number="4" style="v" sid="HEB 7:4" />तौ तुम देखौ, बौ कितनो महान रहै। अब्राहम, हमरो प्रसिद्ध पुरखा, बाकै युद्ध मैं मिले सबको दसमों भाग दई। <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />लेवी के बालकन मैं से जो पुजारी को पद पाथैं, उनकै आग्या मिली है, कि लोगन, मतलब अपने भईय्यौ से चाहे, बे अब्राहम के ही सरीर से काहे न जनमें होमैं, नियम के अनुसार दसमों भाग लियैं। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />मेलिकिसिदक लेवी को बंसज नाय रहै, लेकिन बौ अब्राहम से दसमों भाग इखट्टो करी और बाकै आसीस दई, जो परमेस्वर के वादा कै पाई रहै। <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />जामैं कोई संका ना है कि जो आसीस देथै बौ आसीस लेन बारे से बड़ो होथै। <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />पुजारी<note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="ft" closed="false">पुजारी</char></note> के मामले मैं दसमों भाग मरन बारे लोगन के जरिये इखट्टो करो जाथै; पर मेलिकिसिदक के बारे मैं दसमों भाग बाके जिंदे रहेन बारे के जरिये गभाई दई गई, जैसो पवित्र सास्त्र मैं कहो गौ है। <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />तौ हम जहो कह सकथैं, कि लेवी भी, जो दसमों भाग लेथैं, अब्राहम के जरिये दसमों भाग भुगतान करी। <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />काहैकि लेवी हबै जनमो ना रहै, पर जब मेलिकिसिदक बासे मिलो, तौ बौ अपने पुरखा अब्राहम के सरीर मैं रहै।<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />तौ अगर लेवी पुजारी पद के जरिया सिद्ध हुई सकथै (जोके सहारे से लोगन कै नियम मिली रहै) तौ फिर का जरूरत रहै, कि दुसरो पुजारी मेलिकिसिदक की रीति मैं ठाड़ै, और हारून की रीति को न कहलाबै? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />काहैकि जब पुजारी को पद बदलो जाथै? तौ नियम को भी बदलनो जरूरी है। <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />जोके बारे मैं जे बातैं कही गई हैं, बौ दूसरे गोत्र को रहै, और बौ गोत्र मैं से कोई भी पुजारी बनकै बेदी की सेवा मैं भाग ना लई। <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />तौ साफ है, कि हमरो प्रभु यहूदा के गोत्र मैं से निकरो है और जौ गोत्र के बारे मैं मूसा पुजारी पद की कछु बात ना करी।<verse eid="HEB 7:14" /></para>
  <para style="s">मेलिकिसिदक के हानी एक और पुजारी</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />हमरो दाबा और भी अच्छे से दिखाई दै जाथै, जब मेलिकिसिदक के जैसो एक और पुजारी जनम लेन बारो रहै। <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />बौ इंसानी नियमन और विनियमन आग्या के जरिया नाय बल्कि अविनासी जिंदगी की सक्ति के आधार पर पुजारी बन गौ है। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />काहैकि पवित्र सास्त्र मैं बाके बारे मैं जौ गभाई दई गई है, “तैं मेलिकिसिदक के रीत के अनुसार हमेसा के ताहीं पुजारी ठहरैगो।”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />तौ पुराने नियम की आग्या कै छोड़ दौ जाथै, काहैकि जौ कमजोर और बेकार रहै। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />मूसा को नियम भी साबित नाय कर सक्त रहै। इसलै बाकी जघा मैं एक बहेतर आसा दई गई है जोके जरिया हम परमेस्वर के झोने आथैं।<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />जाके अलावा, परमेस्वर की कसम भी है। जब दूसरेन कै पुजारी बनाओ गौ रहै तौ ऐसी कोई कसम ना रहै। <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />पर ईसु कसम के जरिया पुजारी बन गौ, जब परमेस्वर बासे कही,</para>
  <para style="q1" vid="HEB 7:21">“प्रभु कसम खाई है</para>
  <para style="q2" vid="HEB 7:21">और बौ अपनो मन ना बदलैगो:</para>
  <para style="q1" vid="HEB 7:21">‘तैं हमेसा के ताहीं पुजारी है।’”<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />इसलै जौ अंतर, ईसु कै एक बहेतर वाचा की गारंटी भी देथै।<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />बे तौ भौत से पुजारी बनत आए, जाकी वजह जौ रहै कि मौत उन्हैं रहेन ना देत रहै। <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />लेकिन ईसु हमेसा जिंदो रहथै; जौ बजह से बाको पुजारी को पद अटल है।<verse eid="HEB 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 7:25" />जौ बजह से बाके जरिया परमेस्वर के झोने आथैं, बौ उनको पूरो-पूरो उद्धार कर सकथै, काहैकि बौ उनके ताहीं प्रार्थना करन ताहीं हर हमेसा जिंदो है। <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />काहैकि ऐसोई बड़ो पुजारी हमरे लायक रहै, जो पवित्र, और कपट न करन बारो और निरमल, और पापिन से अलग, और स्वर्ग से भी ऊँचो करो गौ होबै। <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />और बे बड़े पुजारिन<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="ft" closed="false">बड़ो पुजारी</char></note> के जैसी बाकै जरूरी नाय है कि रोजाना पहले अपने पापन कै और फिर लोगन के पापन के ताहीं बलिदान चढ़ाबै; काहैकि बौ अपने आपकै बलिदान चढ़ायकै बाकै एकै बार निपटाए दई। <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />काहैकि मूसा को नियम तौ कमजोर आदमिन कै बड़ो पुजारी बनाथै; लेकिन बौ कसम को बचन जो नियम के बाद खाई गई, बौ लौड़ा कै चुनथै जो हमेसा के ताहीं सिद्ध करो गौ है।<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">ईसु हमरो बड़ो पुजारी</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />हम जो कह रै हैं, बाको पूरो मतलब जौ है कि हमरे झोने एक ऐसो बड़ो पुजारी है, जो स्वर्ग मैं महान परमेस्वर के सिंहासन के दहने घाँईं बैठथै। <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />बौ पवित्र जघा मैं बड़े पुजारी सेवक के रूप मैं काम करथै, मतलब बौ सच्चे तम्बु कै जोकै कोई आदमी नाय, बल्कि प्रभु ठड़बाई रहै।<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />हर एक बड़े पुजारी कै भेंट और जानवर की बलि चढ़ान के ताहीं चुनो जाथै, जौ बजह से जरूरी है, कि बड़े पुजारी के झोने भी कछु चढ़ान के ताहीं होनो चाहिए। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />और अगर मसीह पृथ्वी मैं होतो, तौ कहुए पुजारी नाय होतो, काहैकि ऐसे पुजारी तौ हैं जो यहूदि नियम के हिसाब से भेंट चढ़ाथैं। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />बे एक ऐसे पुजारी के रूप मैं आराधना करथैं बौ बास्तव मैं स्वर्ग मैं जो कुछ है बाकी एक नकल और खाली छाया है। जौ बैसोई है जैसो मूसा के संग रहै। जब बौ पवित्र तम्बु कै बनानबारो रहै, तौ परमेस्वर बासे कही, “सब कछु बौ नमूना के हिसाब से बनइये जो तोकै पहाड़ मैं दिखाओ गौ रहै।” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पर अब, ईसु कै पुजारिन से बढ़कै सेवा मिली है, ठीक बैसिये जैसे बौ वाचा जो बौ परमेस्वर और बाके लोगन के बिचवई मैं भाँदी गई रहै बौ एक बहेतर वाचा है, काहैकि जौ बहेतर नियम की वाचा पर आधारित है।<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />अगर बौ पहली वाचा बेकसूर होती, तौ दुसरी वाचा की कोई जरुरत नाय होती।<verse eid="HEB 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 8:8" />लेकिन परमेस्वर अपने लोगन मैं गलती पाथै तौ बौ कहथै,</para>
  <para style="q1" vid="HEB 8:8">“प्रभु कहथै, बे दिन आए रै हैं,</para>
  <para style="q1" vid="HEB 8:8">जब मैं इस्राएलियन और यहूदियन के लोगन के संग एक नई वाचा भाँदंगो।<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />जौ बौ वाचा के जैसी ना होगी जोमैं उनके पुरखन के संग भाँदो रहों</para>
  <para style="q1" vid="HEB 8:9">जब मैं उनको हाथ पकड़कै उनकै मिस्र देस से बाहर निकार लाओ।</para>
  <para style="q1" vid="HEB 8:9">बे बौ वाचा के ताहीं बिस्वास के काबिल न रहैं, जोमैं उनके संग करो रहों,</para>
  <para style="q2" vid="HEB 8:9">और जौ बजह से मैं उनसे दूर हुई गौ, प्रभु को जहे कहनो है।<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />फिर प्रभु कहथै,</para>
  <para style="q2" vid="HEB 8:10">कि जो वाचा मैं बे दिनन के बाद इस्राएल के लोगन से भाँदंगो, बौ जौ है,</para>
  <para style="q1" vid="HEB 8:10">कि मैं अपनी नियम कै उनके मन मैं डारंगो</para>
  <para style="q2" vid="HEB 8:10">और बाकै उनके दिलन मैं लिखंगों।</para>
  <para style="q1" vid="HEB 8:10">और मैं उनको परमेस्वर बनंगो,</para>
  <para style="q2" vid="HEB 8:10">और बे मेरे लोग होंगे।<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />और उनमैं से कोई कै भी अपने दोस्तन कै सिखान या</para>
  <para style="q2" vid="HEB 8:11">अपने पड़ोसियन कै बतान की जरुरत ना पड़ैगी,</para>
  <para style="q2" vid="HEB 8:11">कि तुम ‘प्रभु कै जानौ।’</para>
  <para style="q1" vid="HEB 8:11">काहैकि छोटे से लैकै बड़े तक सब मोकै जान लेंगे।<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />काहैकि मैं उनके अधर्म के बारे मैं दयावान होंगो,</para>
  <para style="q2" vid="HEB 8:12">और उनके पापन कै फिर याद नाय करंगो।”<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />परमेस्वर नई वाचा की बात करकै पहली वाचा कै पुरानो करी; और जो कुछ भी पुरानो और घिसो-पिटो हुई जातै, बौ जल्दिये मिट जाथै।<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">सांसारिक और स्वर्गिय आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />पहली वाचा मैं भी सेवा के नियम रहैं; और आराधना के ताहीं पृथ्वी मैं पवित्र जघा भी रहै। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />काहैकि एक तम्बु बनाओ गौ, पहले तम्बु मैं डीट, मेज, और भेंट की रोटी परमेस्वर कै चढ़ाई गई रहैं और बौ पवित्र जघा के नाओं से जानो जात रहे। <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />और दूसरे परदा के पिच्छू बौ तम्बु रहै, जो परम पवित्र जघा के नाओं से जानो जात रहे। <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />बामै सोने की धूपदान, और पूरो सोने से मढ़ो भौ वाचा को बक्सा और जामैं मन्ना से भरो भौ सोने को घड़ा और हारून की छड़ी जामैं फल फूल आए गै रहैं और उनमैं लिखी आग्यन के संग पथरा की दुई पट्टी रहैं। <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />बक्सा के ऊपर परमेस्वर की मौजूदगी मैं महिमा करन बारे प्राँड़ी जिनके पखमा रहैं, उनके पखमा बौ माफी की जघा ले फैले रहैं, जितै पाप माफ करे जात रहैं। लेकिन हबै इनके बारे मैं एक-एक करकै बतान को समय ना है।<figure style="fig" alt="Interior of tabernacle" file="bk00278c.tif" size="span" copy="Horace Knowles ©" ref="9:2">आराधनालय के तम्बु के अंदर को भाग</figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />जे चीज जौ तरीका से तैयार हुई चुकी, बौ पहले तम्बु मैं तौ पुजारी हर समय घुसकै सेवा के काम पूरे करथैं, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />लेकिन दुसरे मैं बस बड़ो पुजारी साल भर मैं ऐकै बार जाथै; और बिना खून लैकै नाय जाथै; जोकै बौ अपने ताहीं और लोगन की भूल चूक के ताहीं चढाथै। <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />जासे पवित्र आत्मा जहे दिखाथै, कि जब तक पहलो तम्बु ठाड़ो है, तब ले पवित्र जघा को रस्ता साफ नाय भौ है। <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />और जौ तम्बु तौ आज के समय के ताहीं एक कहानी है; जामैं ऐसी भेंट और बलिदान चढ़ाय जाथैं, जिनसे आराधना करन बारेन के मन सिद्ध नाय होबै सकथैं। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />काहैकि जे खाली खान-पीन बारी चीज, और तरह-तरह के हंदान के नियम के मुताबिक सरीर के नियम हैं, जो सुधार के समय तक के ताहीं ठहराए गै हैं।<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />लेकिन जब मसीह आनबारी अच्छी-अच्छी चीजन को बड़ो-पुजारी हुईकै आओ, तौ बौ औरौ बड़े और सिद्ध तम्बु से हुईकै जो हाथ को बनाओ भौ नाय है, मतलब दुनिया नाय है। <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />और बकरन और बछड़न के खून के जरिया नाय, लेकिन अपने ही खून के जरिया एकै बार पवित्र जघा मैं घुसो, और अनंत छुटकारा पाबौ। <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />काहैकि जब बकरन और बरधन के खून और कलोर की राख अपवित्र लोगन के ऊपर छिड़कन से सरीर की सुद्धता के ताहीं पवित्र करथै। <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />तौ मसीह को खून जो अपने आपकै अनंत आत्मा के जरिया परमेस्वर के अग्गु निर्दोस चढ़ाई, तुम्हारे मन कै मरे भै कामन से काहे नाय सुद्ध करैगो, ताकी तुम जिंदे परमेस्वर की आराधना करौ।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />और जहे बजह से बौ नई वाचा को बिचवई है, ताकी बौ मौत के जरिया जो पहली वाचा के समय की गलतियन से छुटकारा पान ताहीं भइ है, बुलाए भै लोग वादा के जरिया अनंत बिरासत कै पामैं।<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />काहैकि जितै वाचा भाँदी गई है हूँना वाचा भाँदन बारे की मौत कै समझ लेनो भी जरूरी है। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />काहैकि ऐसी वाचा मरन के बाद पक्की होथै, और जब तक वाचा बाँधन बारो जिंदो रहथै, तब तक वाचा काम की नाय होथै।<verse eid="HEB 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18" />जहेमारे पहली बाचौ बिना खून के नाय भाँदी गई। <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />काहैकि जब मूसा सब लोगन कै नियम की एका एक आग्या सुनाए चुको, तौ बौ बछड़न और बकरन को खून लैकै, पानी और लाल ऊन, और जूफा के संग, बौ किताब मैं और सब लोगन मैं छिड़क दई। <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />और कही, “जौ बौ वाचा को खून है, जोकी आग्या परमेस्वर तुम्हारे ताहीं दई रहै।” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />और जहे तरीका से बौ तम्बु और सेवा के सब सामानन के ऊपर खून छिड़की। <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />और नियम के हिसाब से हमेसा सब चीज खून के जरिया सुद्ध करी जाथैं; और बिना खून बहाए माफी नाय मिलथै।<verse eid="HEB 9:22" /></para>
  <para style="s">मसीह को बलिदान पापन कै दूर करथै</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />इसलै जरूरी है, कि स्वर्ग मैं की चीजन के प्रतिरूप जे बलिदानन के जरिया सुद्ध करे जामैं; लेकिन स्वर्ग मैं की चीज खुद इनसे अच्छे बलिदानन के जरिया सुद्ध करीं जाथैं। <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />काहैकि मसीह तौ बौ हाथ के बनाए भै पवित्र जघा मैं जो सच्चे पवित्र स्थान को नमूना है, नाय घुसो, लेकिन स्वर्ग मैं ही घुसो, ताकी हमरे ताहीं अब परमेस्वर के अग्गु दिखाई देबै।<verse eid="HEB 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 9:25" />जौ ना कि बौ अपने आपकै बार-बार चढ़ाबै, जैसो कि बड़ो-पुजारी हर साल जानवर को खून लैकै पवित्र जघा मैं घुसथै। <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />नाय तौ दुनिया के बनन से लैकै बाकै बार-बार दुख उठाने पड़तो; लेकिन अब युग के अंत मैं बौ एक बार प्रगट भौ है, ताकी अपनिए बलिदान के जरिया पाप कै दूर कर दियै। <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />और जैसी इंसानन के ताहीं एक बार मरनो और बाके बाद न्याय को होनो ठहराओ गौ है। <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />बैसिये मसीह भी भौतन के पापन के ताहीं एक बार बलिदान चढ़ाओ गौ और जो लोग बाको इंतजार करथैं, उनके उद्धार के ताहीं दुसरी बार बिना पाप के दिखाई देगो।<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />काहैकि नियम को विधान तौ आनबारी अच्छी बातन की छाया मात्र देथै, लेकिन उनको असली स्वरूप नाय है, जहेमारे बे एकै जैसे बलिदानन के जरिया, जो हर साल चढ़ाय जाथैं, झोने आनबारेन कै कभी सिद्ध नाय कर सकथै। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />नाय तौ उनको चढ़ानो बन्द काहे नाय ही जाथै? काहैकि जब आराधना करन बारे एकै बार मैं सुद्ध हुई जाते, तौ फिर उनको मन उनकै पापी ना ठहरातो। <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />लेकिन उनके जरिया हर साल पापन कै याद दिबान को काम करथै। <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />काहैकि ऐसो कभी ना हुई सकथै, कि बरधन और बकरन को खून पापन कै दूर करै। <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />जहे बजह से मसीह जौ दुनिया मैं आओ तौ कही,</para>
  <para style="q1" vid="HEB 10:5">“बलिदान और भेंट तैं नाय चाहो,</para>
  <para style="q1" vid="HEB 10:5">लेकिन मेरे ताहीं एक सरीर बनाओ।<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />होमबलियन और पापबलियन से तैं खुस नाय भौ।<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />तौ मैं कहो, ‘देख, मैं आए गौ हौं, पवित्र सास्त्र मैं मेरे बारे मैं लिखो भौ है ताकी हे मेरे परमेस्वर मैं तेरी इच्छा पूरी करौं।’”<verse eid="HEB 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 10:8" />पहले तौ बौ कही, “न तैं बलिदान और भेंट और होमबलियन और पापबलियन कै चाहो, और नाय उनसे खुस भौ,” बल्कि जे बलिदान तौ नियम के मुताबिक चढ़ाय जाथैं।<verse eid="HEB 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 10:9" />फिर जहो कहथै, “देख, मैं आए गौ हौं, ताकी तेरी इच्छा पूरी करौं,” बौ पहले कै हटाय देथै, ताकी मसीह के बलिदान कै रख सकै।<verse eid="HEB 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 10:10" />तौ परमेस्वर की इच्छा से हम ईसु मसीह के सरीर के एकै बार बलिदान चढ़ाय जान के जरिया पवित्र करे गै हैं।<figure style="fig" alt="Burnt offering on an altar" file="hk00256c.tif" size="col" copy="Horace Knowles ©" ref="10:10">बेदी मैं होमबलि</figure><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />हर एक पुजारी और सेवक तौ ठाड़कै हर दिन सेवा करथै, और एकै तरह के बलिदान कै जो पापन कै कभी दूर नाय कर सकथै; बार-बार चढ़ाथै। <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />लेकिन मसीह हमरे पापन के बदले एकै बार बलिदान हुईकै हमेसा के ताहीं चढ़गौ और परमेस्वर के दहने जाए बैठो। <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />और बहे समय से परमेस्वर उनकी रहा देख रहो है, कि बाके बैरी बाके पाँए तरे कि चौकी बनै।<verse eid="HEB 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 10:14" />काहैकि बौ एकै बलिदान के जरिया उनकै जो पवित्र करे जाथैं, हमेसा के ताहीं सिद्ध कर दई। <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />और पवित्र आत्मा हमैं जहे गभाई देथै; काहैकि बौ पहले कही रहे<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“प्रभु कहथै; कि जो वाचा मैं</para>
  <para style="q2" vid="HEB 10:16">बे दिनन के बाद उनसे भाँदंगो बौ जौ है कि</para>
  <para style="q1" vid="HEB 10:16">मैं अपने नियमन कै उनके मन मैं लिखंगो</para>
  <para style="q2" vid="HEB 10:16">और उनके मन मैं डारंगो।”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />फिर बौ जौ कहथै, “मैं उनके पापन कै, और उनके अधर्म के कामन कै फिर कहुए याद नाय करंगो।” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />और जब इनकी माफी मिल गई है, तौ फिर पाप को बलिदान नाय रहो।<verse eid="HEB 10:18" /></para>
  <para style="s">आबौ आपन परमेस्वर के झोने जामैं</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />तौ भईय्यौ और बहेनियौ, जब हमैं ईसु के खून के जरिया पवित्र जघा मैं जान की पूरी आजादी है, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />बौ हमरे ताहीं एक नई राह बनाये कै देगो, एक जिंदगी की राह, परदा के जरिया मतलब अपने सरीर के जरिया हमरे ताहीं खोल दई है। <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />हमरे झोने परमेस्वर के मंदिर को एक महान बड़ो पुजारी है। <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />तौ आबौ हम, सच्चे मन और पूरे बिस्वास के संग, और मन के दोस दूर करन के ताहीं दिल मैं छिड़काव लैकै, और सरीर कै साफ पानी से धोएकै परमेस्वर के झोने आमै। <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />और अपनी आसा के अंगीकार कै मजबूती से पकड़े रहमैं; काहैकि जो वादा करो है, बौ बिस्वास लायक है। <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />और प्रेम, और भले कामन मैं बढ़ान के ताहीं एक दुसरे की चिंता करे करैं। <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />और एक दुसरे के संग इखट्टो होनो नाय छोड़ैं, जैसे कि कितनेन कि आदत है, पर एक दुसरे कै समझात रहमैं; और जैसी-जैसी बौ दिन कै झोने आत देखैं, बैसिये-बैसिये औरौ जाधा जौ करे करौ।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />काहैकि सच्चाई जानन के बादौ अगर हम जान बूझकै पाप करत रहे, तौ पापन के ताहीं फिर कोई बलिदान बाकी नाय है। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />जाके बाद जो कुछ बचो है बौ आनबारे न्याय और भयानक आगी को जलनो बचो है जो बिरोध करन बारेन कै कतई जलाए देगो। <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />जब मूसा के नियमन कै नाय मानन बारो दुई या तीन जनी की गभाई मैं, बिना दया के मार दौ जाथै। <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />तौ सोच लियौ कि बौ कितने औरौ कितने बड़े दन्ड के लायक ठहरैगो, जो परमेस्वर के लौड़ा कै पाँव से रौंदो, और वाचा के खून कै जोके जरिया बौ पवित्र ठहराओ गौ रहे, अपवित्र जानी है, और अनुग्रह की आत्मा की बेजती करी। <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />काहैकि हम बाकै जानथैं, जो कही, “बदलो लेनो मेरो काम है, महीं बदलो देंगो।” और फिरौंकी जौ, कि “प्रभु अपने लोगन को न्याय करैगो।” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />जिंदे परमेस्वर के हात मैं पड़नो एक भयानक बात है।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />लेकिन तुम पुराने दिन कै याद करौ, जो तुम जोती पाएकै और दुख के संघर्स मैं निठाठौर रहै। <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />कुछ तौ जौ, कि तुम बुराई, और कलेस सहत भै तमासा बने, और कुछ जौ, कि तुम उनके संगी बने जिनकी दुर्दसा करी जात रहे। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />काहैकि तुम कैदियन के दुखन मैं भी दुखी भै, और अपनी जायदाद भी खुसी से लुटन दै; जौ जानकै, कि तुम्हारे झोने एक औरौ अच्छी और हर हमेसा ठहरन बारी जायदाद है। <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />तभईये, अपनी हिम्मत मत छोड़ौ काहैकि बाको प्रतिफल बड़ो है। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />काहैकि तुमकै धीरज धरनो जरूरी है, ताकी परमेस्वर की इच्छा पूरी करकै तुम वादा बारो फल पाबौ।<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“काहैकि अब थोड़िये समय रहगौ है</para>
  <para style="q2" vid="HEB 10:37">जब कि आनबारो आबैगो,</para>
  <para style="q2" vid="HEB 10:37">और देर नाय करैगो।<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />मेरो धर्मी जन बिस्वास से जिंदो रैहगो,</para>
  <para style="q2" vid="HEB 10:38">और अगर बौ पिच्छू हट जाबै</para>
  <para style="q2" vid="HEB 10:38">तौ मेरो मन बासे खुस नाय होगो।”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />लेकिन हम हटन बारे नाय हैं, कि खतम हुई जाए बल्कि पूरे मन से बिस्वास करन बारे हैं, कि ज्यान कै बचायें।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">बिस्वास</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />बिस्वास रखन के ताहीं बे सब चीज होमैं जोकी हम आसा रखथैं, बे चीजन के बारे मैं जो हम नाय देख पाथैं। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />जौ उनके बिस्वास के जरिया गभाई रहै, कि पुराने समय के लोग परमेस्वर की इच्छा से जीत रहैं। <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />बिस्वास से आपन जानथैं कि परमेस्वर के बचन के जरिया युग की रचना ऐसी करी गई जो कुछ देखन मैं आथै, बौ दिखाई देन बारी चीजन से नाय बनाओ गौ रहै। <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />बिस्वास से हाबिल परमेस्वर के ताहीं कैन से अच्छो बलिदान चढ़ाई, जोके जरिया बाके धर्मी होन की गभाई भी दई गई: काहैकि परमेस्वर बाकी भेंट के बारे मैं गभाई दई; और बहे जरिया बौ मरन के बादौ अब तक बात करथै।<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />बिस्वास से हनोक उठाओ गौ, कि मौत कै नाय देखै, और बाको पता नाय लगो; काहैकि परमेस्वर बाकै उठाए लई रहे, और बाके उठाए जान से पहले बाकी गभाई दई गई रहे, कि बौ परमेस्वर कै खुस करी है। <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />और बिस्वास बिना बाकै खुस करनो मुस्किल है, काहैकि परमेस्वर के झोने आनबारे कै बिस्वास करनो चाहिए, कि बौ है; और अपने ढूँड़न बारेन कै प्रतिफल देथै।<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />बिस्वास से नूह बे बातन के बारे मैं जो बौ समय दिखाई नाय पड़त रहैं, चितौनी पाएकै भक्ति के संग अपने परिवार के बचाव के ताहीं जहाज बनाई, और बाके जरिया परमेस्वर पूरे दुनिया कै दोसी ठहराई; और बौ धार्मिकता को बारिस भौ, जो बिस्वास से होथै।<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />बिस्वास से अब्राहम जब बुलाओ गौ तौ आग्या मानकै ऐसी जघा निकर गौ जोकै बौ अपने हक मैं लेन बारो रहे, और जौ नाय जानत रहे, कि मैं कितै जाथौं; तहुँओं निकर गौ। <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />बिस्वास से बौ वादा करे भै देस मैं परदेसी रहकै इसहाक और याकूब समेत जो बाके संग बहे वादा के वारिस रहैं, तम्बुन मैं बसेरा करी। <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />काहैकि अब्राहम बौ मजबूत बुनियाद बारे नगर को इंतजार करत रहे, जोको रचन बारो और बनानबारो परमेस्वर है।<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />बिस्वास से सारा खुद बूढ़ी होन पर भी गरब धारड़ करन की सामर्थ्य पाई; काहैकि बौ वादा करन बारे कै सच्चो जानी रहे। <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />जौ बजह से एकै जनी से जो मरो भौ सो रहे, आसमान के तारन और समुंदर किनारे के रेता के जैसी, अनगिनत बंस उत्पन्न भै।<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />जे सब बिस्वास की दसा मैं मरे; और बे वादा करी भइ चीज नाय पाईं; लेकिन उनकै दूरै से देखकै खुसी भै और मान लईं, कि हम धरती मैं परदेसी और बाहरी है। <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />जो ऐसी-ऐसी बात कहथैं, बे जाहिर करथैं, कि स्वदेस की तलास मैं है। <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />और जो देस से बे निकर आए रहैं, अगर बाके बारे मैं सोचते तौ उन्हैं लौटन को मौका रहे। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />लेकिन बे एक उत्तम मतलब स्वर्गिय देस के अभिलासी रहैं, जहेमारे परमेस्वर उनको परमेस्वर कहबान मैं नाय सरमाथै, काहैकि बौ उनके ताहीं एक सहर तैयार करी है।<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />बिस्वास से अब्राहम, परखे जान के समय अपने इकलौते लौड़ा इसहाक कै बलिदान चढ़ान कै तैयार ही गौ रहे, जो बाके वादा कै सच मानी रहे। <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />और परमेस्वर बासे कही रहे, “इसहाक ही से तेरे झोने ऐसे बंसज होमंगे जिनकी मैं प्रतिग्या करो रहौं।” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />काहैकि बौ मान लई, कि परमेस्वर सामर्थी है, कि बाकै मरे भयन मैं से जियाबै, जौ तरह उन्हईं मैं से कहानी की रीत मैं बौ बाकै फिर मिलो।<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />बिस्वास से इसहाक याकूब और एसाव कै आनबारी बातन के बारे मैं आसीस दई।<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />बिस्वास से याकूब मरत समय यूसुफ के दोनों लौड़न मैं से एक-एक कै आसीस दई, और छड़ी को सहारो लैकै परमेस्वर की आराधना करी।<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />बिस्वास से यूसुफ जो बौ मरन मैं रहै, तौ इस्राएल की संतान कै निकर जान की बात करी, और अपने सरीर के बारे मैं भी आग्या दई।<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />बिस्वास से मूसा के अईय्या दऊवा बाके पैदा होन के तीन महेना तक लुकाए रखाईं; काहैकि बालका सुगड़ रहे, और बे राजा की आग्या से नाय डरे।<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />बिस्वास से मूसा स्यानो हुईकै फिरौन की लौड़िया को लौड़ा होन से मना कर दई। <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />काहैकि बाकै पाप मैं थोड़ी दिन सुख भोगन से परमेस्वर के लोगन के संग दुख भोगनो औरौ अच्छो लगो। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />और मसीह के ताहीं निन्दित होन कै मिस्र के खजाना से बड़ो धन समझी काहैकि बाकी आँखी फल पान के घाँईं लगी रहैं।<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />बिस्वास से राजा के गुस्सा से नाय डराय कै बौ मिस्र कै छोड़ दई, काहैकि बौ अनदेखे कै मानौ देखत भै मजबूत रहो। <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />बिस्वास से बौ फसह और खून छिड़कन की विधि मानी, कि पहलोठेन कै खतम करन बारो इस्राएलिन के ऊपर हाथ नाय डारै।<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />बिस्वास से बे लाल समुंदर के पार ऐसे उतर गै, जैसी सूखी धरती मैं से; और जब मिस्रिऔ बैसिये करनो चाँहीं, तौ सब डूब मरे। <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />बिस्वास से यरीहो की दीवार, जब सात दिन तक बाको चक्कर लगाए चुके तौ बौ टूट गई। <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />बिस्वास से राहाब वेस्या आग्या नाय मानन बारेन के संग खतम नाय भइ; जहे बजह से कि बौ इस्राएली भेदियन कै ठीक सांति से रखी रहे।<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />अब और का कहमौं? काहैकि समय नाय बचो है, कि गिदोन की, और बाराक की, और सिमसोन की, और यिफतह की, और दाऊद की, और समूएल की, और भविस्यवक्तन की बात करौं। <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />जे बिस्वास के जरिया राज्य जीतीं; धार्मिकता के काम करीं; वादा करी भइ चीज पाई, सेरन को मोहों बन्द करीं, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />आगी की गर्मी कै ठंडो करी; तलवार की धार से बच निकरे, कमजोरी मैं तगड़े भै; लड़ाई मैं ताकतबर निकरे; विदेसी सिपईय्यन के डेरा कै मार भजाईं।<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />बईंय्यरैं अपने मरे भैन कै फिर जिंदो पाईं; कितने तौ मार खात-खात मर गै; और छुटकारा नाय चाँहीं; काहैकि अच्छी जिंदगी कै पानबारे बनै। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />दूसरे लोग तौ मजाक मैं उड़ाए जान; और कोड़ा खान; बल्कि भाँदे जान; और कैद मैं पड़न के जरिया परखे गै। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />पथरा से मारे गै; आरे से चीरे गै; उनकी परिक्छा करी गई; तलवार से मारे गै; बे कंगाली मैं और कलेस मैं और दुख भुगतत भै भेंड़न और बकरियन की खाल ओढ़े भै, इतै-उतै मारे-मारे फिरैं। <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />और जंगलन, पहाड़न, गुफन, और धरती की दरारन मैं भटकत फिरे।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />दुनिया उनके लायक नाय रहै और बिस्वास के जरिया जे सबन के बारेन मैं अच्छी गभाई दई गई! तहुँओं उनकै बौ चीज नाय मिली जोकी परमेस्वर उनसे वादा करी रहे। <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />काहैकि परमेस्वर हमरे ताहीं पहले से एक अच्छी योजना बनाई रहे। बाको मकसद रहे कि बौ हमरे संग मिलकै उनकै और सिद्ध बनाबै।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">परमेस्वर हमरो दऊवा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />जहाँ ले हमारी बात है, हमरे आस-पास गभा की इतनी बड़ी भीड़ है, कि हम रस्ता मैं आनबारी सबै चीजन से छुटकारा पामैं, और बौ पाप से छुटकारा पामैं जो हमकै इतनी कसकै पकड़थै, और हमकै बिस्वास के संग भाजनो चाहिए। <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />और बिस्वास के कर्ता और सिद्ध करन बारे ईसु के घाँईं ताकते रहमैं; जो बौ खुसी के ताहीं जो बाके अग्गु धरी रहे, सरम की कोई चिंता नाय करकै, क्रूस को दुख सई; और परमेस्वर के सिंहासन के दहने जाए बैठो।<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />जहेमारे बाके ऊपर पूरे मन से ध्यान करौ, जो अपने खिलाप पापिन को इतनो बिरोध सह लई कि तुम निरास हुईकै हिम्मत ना छोड़ दियौ। <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />तुम पाप से लड़त भै बासे इतनो मुटभेंट नाय करे हौ, कि तुम्हारो खून बहो होबै। <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />और बौ जो तुमकै लौड़न के हानी उत्साहित करन के ताहीं परमेस्वर बचन दई है का तुम भूल गै हौ?</para>
  <para style="q1" vid="HEB 12:5">“मेरो लौड़ा, प्रभु की ताड़ना कै हल्की बात मत समझिए,</para>
  <para style="q1" vid="HEB 12:5">और जब बौ तोकै घुड़कै तौ हिम्मत मत छोड़िये।<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />काहैकि प्रभु जोसे प्रेम करथै, बाकै सुधारथै;</para>
  <para style="q1" vid="HEB 12:6">और जोकै लौड़ा बनाए लेथै, बाकै कोड़ौ लगाथै।”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />तुम दुख कै सजा समझकै सह लेबौ; परमेस्वर तुमकै लौड़ा समझकै तुम्हारे संग बर्ताव करथै, बौ कौन सो लौड़ा है, जोकी सजा दऊवा नाय करथै? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />अगर बौ सजा जोके भागीदार सब होथैं, तुम्हारी नाय भइ, तौ तुम लौड़ा नाय, बल्किन व्यभिचार के बालका ठहरै!<verse eid="HEB 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 12:9" />फिर जबकी हमरे इंसानी दऊवा भी हमारी सजा करत रहैं और हम उनको आदर करे, तौ का आत्मन के दऊवा के औरौ संग नाय रहमैं जोसे हम जिंदे रहमैं। <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />बे तौ अपनी-अपनी समझ के मुताबिक थोड़ी दिनन के ताहीं सजा करत रहैं, पर जौ तौ हमरे फायदा के ताहीं करथै, कि हमउँ बाकी पवित्रता के भागी हुई जामैं। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />और आज के समय मैं हर तरह की सजा खुसी की नाय, बल्किन दुखै की बात सुजाई पड़थै, तहुँओं जो बाकै सहत-सहत पक्के हुईगै है, बाद मैं उनकै चैन के संग धार्मिकता को प्रतिफल मिलथै।<verse eid="HEB 12:11" /></para>
  <para style="s">निर्देस और चितौनी</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />जहेमारे ढीले हातन और कमजोर घटनन कै मजबूत करौ। <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />और अपने पाँव के ताहीं सूदे रस्ता बनाबौ, कि लंगड़ा भटक नाय जाबै, बल्किन भलो चंगो हुई जाबै।<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />सबके संग सांति और निस्ठा से रहन की कोसिस करौ, और पवित्र जिंदगी जीन की कोसिस करौ, काहैकि जाके बिना कोई भी प्रभु कै नाय देख पागो। <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />और ध्यान से देखत रहबौ, ऐसो नाय होबै, कि कोई परमेस्वर के अनुग्रह पान से छूट जाबै, या कोई कड़वी जड़ फूट कै दुख देबै, और बाके जरिया निरे लोग असुद्ध हुई जामैं। <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />ऐसो नाय होबै, कि कोई आदमी व्यभिचारी, या एसाव के जैसी भक्तिहीन होबै, जो एक बार के भात के बदले अपनो पहलोठो होन को अधिकार बेंच डारी। <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />तुम जानथौ, कि बाद मैं जब बौ आसीस पानो चाही, तौ बौ बेकार पाओ गौ, और आँसु बहाए बहाएकै ढूँड़न पर भी बाकै मन फिरान को मौका नाय मिलो।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तुम तौ बौ पहाड़ के झोने जो छुओ जाए सकत रहै और आगी से धधकत रहे, और कारे बादर, और अंधियारो, और आँधी के झोने। <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />और तुरहई की अबाज, और बोलन बारे के ऐसे सब्द के झोने नाय आए, जोके सुनन बारे बिनती करीं, कि अब हमसे और बात नाय करी जामैं। <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />काहैकि बे बौ आग्या कै नाय सह पाईं “अगर कोई जानवरौ पहाड़ कै छूबै, तौ पथराव से मार दौ जाबै।” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />और बौ नजारा ऐसो डराबनो रहे, कि मूसा कही, “मैं भौत डराय रौ हौं और काँप रौ हौं।”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />लेकिन तुम सिय्योन के पहाड़ के झोने, और जिंदे परमेस्वर के नगर स्वर्गिय यरूसलेम के झोने हजारौ स्वर्गदूतन के संग आए हौ। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />और बे पहलोठेन की सूदी सभा और कलीसिया जिनके नाओं स्वर्ग मैं लिखे भै है। तुम जो परमेस्वर के झोने आए हौ, जो सबको न्याई है, और धर्मी लोगन की आत्मन कै सिद्ध बनाओ गौ है। <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />और नई वाचा को बिचवई ईसु, और छिड़काव के बौ खून के झोने आए हौ, जो हाबिल के खून से अच्छी बात कहथै।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />चहाचीते रहबौ, और बौ कहनबारे से मोहों मत मुरकाबौ, काहैकि लोग जब धरती मैं के चितौनी देनबारे से मोहों मुरकाए कै नाय बच सके, तौ आपन स्वर्ग मैं से चितौनी देनबारे से कैसे बच पांगे? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />बौ समय तौ बाके बोल धरती कै हलाए दईं लेकिन अब बौ वादा करी है, “एक बार फिर मैं बस पृथ्वी कै नाय बल्किन आसमान कै भी हलाए देंगो।”<verse eid="HEB 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 12:27" />और जौ बोल “एक बार फिर” जौ बात कै दिखाथै, कि जो चीज हलाई जाए सकथै, बे बनाई भइ चीज होन के बजह से खतम ही जांगी; ताकी जो चीज हलाई नाय जाथैं, बे हमेसा बनी रहमैं। <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />जौ बजह से हमकै ऐसो राज्य मिलो है जो हलन बारो नाय है, आपन सब आभारी है। आबौ आपन बौ परमेस्वर की आराधना बड़ी सृद्धा और बिस्वास के संग करैं, जोसे बौ खुस होथै। <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />काहैकि हमरो परमेस्वर भसम करन बारी आगी है।<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">परमेस्वर कै कैसे खुस करैं</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />एक-दुसरे से मसीह भईय्यन-बहेनियन के जैसी प्यार करत रहबौ। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />अनजान लोगन को आदर-सम्मान करन मत भूलियो, काहैकि जाके जरिया कितने लोग बिना जाने स्वर्गदूतन को आदर-सम्मान करीं हैं। <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />कैदियन की ऐसी खबर लियौ, कि मानौ उनके संग तुम्हऊँ कैद हौ; और जिनके संग बुरो बर्ताव करो जाथै, उनकियौ जौ समझकै खबर सुद्ध लियौ, कि हमारुओ सरीर है। <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />बिहा सबमै आदर की बात समझी जाबै, और बिहा बिछौना पवित्र होनो चाहिए; काहैकि परमेस्वर व्यभिचारियन, और छिनरेयन को न्याय करैगो।<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />तुम्हारी जिंदगी मैं पैसन को लालच नाय होबै, और जो तुम्हारे पास होबै बहे मैं राजी रहबौ; काहैकि बौ अपने आपै कही है, “मैं तोकै कभी नाय छोड़ंगो, और नाय कभी त्यागंगो।” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />जहेमारे हम बेधड़क हुईकै कहथैं,</para>
  <para style="q1" vid="HEB 13:6">“प्रभु, मेरी मदत करन बारो है;</para>
  <para style="q2" vid="HEB 13:6">मैं नाय डरांगो;</para>
  <para style="q1" vid="HEB 13:6">इंसान मेरो का कर सकथैं?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />जो तुम्हारे अगुवा रहैं, और जो तुम्हैं परमेस्वर को बचन सुनाईं हैं, उन्हैं याद रखौ; और ध्यान से उनके चाल-चलन कै देखौ कि बे कैसे जिये और कैसे मर गै उनके जैसी बिस्वास की नकल करौ। <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />ईसु मसीह कल और आज और हर हमेसा एक जैसो है। <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />कई तरहन की बाहरी सिक्छन से मत भरमाए जईयो, काहैकि मन से जिंदगी जीन के अनुग्रह से मजबूत रहनो अच्छो है, न कि बे खानबारी चीजन से जिनसे मतलब रखन बारेन कै कछुए फायदा नाय भौ।<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />हमरे तम्बु मैं एक ऐसी बेदी है, जो याजकन कै यहूदि के आराधना करन बारी जघा की चीज खान को अधिकार नाय है, जो बेदी की आराधना करथैं। <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />यहूदि बड़ो पुजारी जिन जानवरन के खून की पाप बलि चढ़ान के ताहीं पवित्र जघा मैं लात रहैं, उनको सरीर अपने सिपईय्यन के डेरा से दूर लै जाएकै जलाए देत रहैं। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />ऐसेई ईसु की मौत सहर के दुआरे भइ रहै ताकी लोगन कै अपने खून के जरिया उनके पाप से पवित्र करो जा सकै। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />जौ बजे से ईसु भी पड़ाव के बाहर मर गौ, कि लोगन को अपनेई खून के पाप से सुद्ध करै। <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />काहैकि हिंयाँ हमरो हमेसा के रहन को कोईये सहर नाय है, बल्किन हम एक आनबारे सहर की तलास मैं हैं। <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />तौ आबौ हम हमेसा ईसु के महिमा के बलिदान के जरिया परमेस्वर के नाओं की महिमा करैं, और अपने होटन से अंगीकार करत भै परमेस्वर की महिमा करैं। <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />और भलाई, सहभागिता करनो ना भूलैं; काहैकि परमेस्वर ऐसेई बलिदान से खुस होथै।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />अपने अगुवन को कहनो मानौ; और पूरे मन से उनकी आग्या को पालन करैं, काहैकि बे आराम करे बिना तुम्हारी आत्मन के ऊपर अपनी नजर गढ़ाये रहथैं, काहैकि परमेस्वर कै अपनी सेवा को हिसाब देने पड़ैगो, अगर तुम उनकै भरोसा करकै मानथौ, तौ बे अपनो जौ काम खुस हुईकै करंगे और ना तौ बे जहे काम कै उदासी से करंगे, और जासे तुमकै कोई फायदा नाय होगो।<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />हमरे ताहीं प्रार्थना करत रहबौ, हमैं यकीन से भरोसा है कि हमरो सपा मन है, काहैकि हम हर समय सई चाल-चलन के जरिया काम करनो चाहथैं। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />मैं और इमानदारी से नहोरे करथौं कि परमेस्वर मोकै जल्दिये तुमरे झोने पनार देबै।<verse eid="HEB 13:19" /></para>
  <para style="s">आखरी प्रार्थना</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />सांति को परमेस्वर जो हमरे प्रभु ईसु भेंड़न को बरदिया है, अनंत वाचा के खून के जरिया बाकै मौत से जिलाएकै लै आई, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तुमकै सब अच्छी बातन मैं सिद्ध करै, जोसे तुम बाकी इच्छा पूरी करौ, और जो कुछ बाकै भाथै, बाकै ईसु मसीह के जरिया हममैं बौ करै जो बाकै पसंद है और बाकी महिमा और आदर हमेसा बनो रहबै! आमीन।<verse eid="HEB 13:21" /></para>
  <para style="s">आखरी सब्द</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />मैं तुमसे, मेरे भईय्यौ और बहेनियौ नहोरे करथौं कि बढ़ावा को जौ संदेस सबर से सुनैं, मैं जौ चिट्ठी कै तुमरे ताहीं लम्बी ना लिखो। <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />तुम जौ जान लियौ कि तीमुथियुस हमरो भईय्या छूट गौ है और अगर बौ जल्दिये आए गौ तौ मैं बाके संग तुमसे भेंटा करंगो।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />अपने सब अगुवन और सब पवित्र लोगन कै सुभकामना देबौ। और इटली के विस्वासी तुम्हैं सुभकामना भेजथै।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />परमेस्वर को अनुग्रह तुमरे ऊपर बनो रहबै।<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>