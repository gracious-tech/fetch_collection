<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Rana Tharu</book>
  <para style="h">फिलिप्पियों</para>
  <para style="toc3">फिलिप्पियों</para>
  <para style="toc2">फिलिप्पियों</para>
  <para style="toc1">फिलिप्पियों कै लिखी भइ पौलुस की चिट्ठी</para>
  <para style="mt2">फिलिप्पियों को लिखी हुई पौलुस की चिट्ठी</para>
  <para style="mt1">फिलिपियों कै लिखी भइ पौलुस की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">ईसु के जनम के करीबन 61 साल बाद पौलुस जौ चिट्ठी फिलिप्पियन वासी विस्वासिन कै लिखी। बौ समय हुँआँ रोम सहर मैं कैद मैं रहै<char style="xt"><ref loc="PHP 1:13">1:13</ref></char>। जौ पत्‌री फिलिप्पियन सहर के कलीसिया कै लिखी गई। प्रेरितो के काम नामक किताब से हम फिलिप्पै सहर के बारे मैं कुछ जानकारी हासिल कर सकथैं। मैसिडोनिया प्रांत की फिलिप्पै एक राजधानी रहै। मैसिडोनिया मैं स्थापित करी गई कलीसिया मैं से हुँआँ पहली कलीसिया रहै। जौ कलीसिया पौलुस और सीलास जे मिलकै सुरू करीं। जब बे हुँआँ रहैं तौ एक रात के ताहीं उन्हैं कैद मैं भी रखो गौ <char style="xt"><ref loc="ACT 16">प्रेरितो 16</ref></char>।</para>
  <para style="ip">जौ पत्‌री लिखन के पच्छू पौलुस के भौत उद्देस्य रहैं। जब बौ कैद मैं रहै तौ कलीसिया बाकै दान भेजी रहैं <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char>। पौलुस जौ मौका को इस्तमाल करकै उनकै धन्यवाद देथै। कैद मैं बाके कैसे हालात रहैं जाके बारे मैं भी उन्हैं हुँआँ जानकारी देथै बौ जहो सिफारिस करथै कि तीमोथी और ऐपाफ्रदित को स्वागत करै और उनके नेतृत्व कै इज्जत देबै<char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref></char>।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुस फिलिप्पै वासी कलीसिया कै नमस्ते करकै चिट्ठी की सुरुवात करथै। <char style="ior"><ref loc="PHP 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. जाके बाद मैं बाके हालात के बारे मैं और कुछ सवालन के बारे मैं बताथै। <char style="ior"><ref loc="PHP 1:3-2:30">1:3–2:30</ref> </char></para>
  <para style="io1">3. बाद मैं मसीह जीवन के ताहीं हुँआँ व्यवहारिक खबर देथै। <char style="ior"><ref loc="PHP 3:1-4:9">3:1–4:9</ref> </char></para>
  <para style="io1">4. फिलिप्पै कलीसियन कै नमस्ते करत भै और बे बाकै जो दान दईं रहैं बाके ताहीं उनको धन्यवाद करत भइ बौ जौ चिट्ठी कै खतम करथै। <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref> </char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />ईसु मसीह को दास पौलुस और तीमुथियुस के घाँईं से सब पवित्र लोगन के नाओं, जो ईसु मसीह मैं हुईकै फिलिप्पी मैं रहथैं, कलीसिया के अगुवा और सेवक समेत: <figure style="fig" alt="City of Philippi" file="HK00363C.TIF" size="span" copy="Horace Knowles ©" ref="1:1">फिलिप्पियों का सहर</figure><verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />हमरे दऊवा परमेस्वर और प्रभु ईसु मसीह के घाँईं से तुमकै अनुग्रह और सांति मिलत रहबै।<verse eid="PHP 1:2" /></para>
  <para style="s">पौलुस अपने पढ़न बारेन के ताहीं प्रार्थना करथै,</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />मैं हर बार तुमरे बारे मैं सोचन ताहीं अपने परमेस्वर कै धन्यवाद करथौं; <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />और हर बार मैं तुम सबन ताहीं, मैं खुसी के संग प्रार्थना करथौं, <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />जैसो तुम पहले दिन से अबले सुसमाचार के काम मैं मेरी मदद करे हौ। <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />और तभई मोकै यकीन है कि परमेस्वर, जो तुम मैं जौ अच्छो काम सुरू करी है, बहे बाकै मसीह ईसु के दिन ले खतम करैगो। <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />तुम हमेसा मेरे दिल मैं हौ! और तभई मैं खाली जौ सोचथौं कि मैं तुमरे ताहीं मैं का करौं। काहैकि तुम सब मेरे संग जौ विसेसाधिकार के अनुग्रह मैं भागीदार भै हौ जो न्याई परमेस्वर मोकै सामर्थ्य दई है, अब मैं जेल मैं हौं और संगै-संग मैं सुसमाचार की रक्छा करन और जाकै मजबूती से समर्पित करन ताहीं बंधन से आजाद रहौं। <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />परमेस्वर मेरो गभा है कि मैं सच्ची कहथौं जब मैं कहथौं कि तुम सबन ताहीं मेरी गहरी भावना खुद ईसु मसीह के दिल से आथै।<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />मैं प्रार्थना करथौं कि तुमरो प्रेम जाधे से जाधे बढ़त रहबै और तुम सई ग्यान का है जौ जानौ और पूरी तरह से सई न्याय कर सकौ, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />ताकी तुम चुन सकौ कि सबसे अच्छो का है। फिर तुम मसीह के परखे जाने के दिन सब असुद्धता और दोस से मुक्त होगे। <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />तुमरी जिंदगी बास्तव मैं धार्मिकता के अच्छे गुड़न से भरो होगो जो खाली ईसु मसीह पैदा कर सकथै, परमेस्वर की महिमा और बड़ाँईं के ताहीं।<verse eid="PHP 1:11" /></para>
  <para style="s">जीन ताहीं मसीह है</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />मैं तुमकै जाननो चाहथौं, मेरे भईय्यौ, कि जो चीजैं मेरे संग भइ हैं, बे बास्तव मैं सुसमाचार कै बढ़न मैं मदत करी है। <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />हिंयाँ तक कि, कैसर के पूरे महल के पहरेदार और हिंयाँ के बचे भै सब जनी जानथैं कि मैं कैदखाना के बंधन मैं हौं काहैकि मैं मसीह को सेवक हौं। <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />और मेरे कैदखाना के बंधन मैं रहन से भौत से विस्वासी भईय्या कै प्रभु के ऊपर जाधे बिस्वास हुई गौ है, जोसे बे हमेसा के ताहीं निडर हुईकै उपदेस देथैं।<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />उनमैं से कुछ मसीह को प्रचार करथैं काहैकि बे जलन बारे और झगड़ालू होथैं, लेकिन असली और अच्छे इरादे से दुसरे। <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />जे प्रेम से ऐसो करथैं, काहैकि बे जानथैं कि परमेस्वर मोकै सुसमाचार को बचाव करन को काम दई है। <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />दूसरे लोग इमानदारी से मसीह को ऐलान नाय करथैं, लेकिन स्वार्थी इच्छा की भावना से; उनकै लगथै कि कैदखाना के बंधन मैं रहत भै बे मेरे ताहीं और मुसीबत खड़ी कर देंगे।<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />जौ मायने ना रखथै! मैं जाके बारे मैं खुस हौं। बस इसलै मसीह हर तरहन से संभव है, चाँहे गलत या सच्चे काम से। और मैं खुस रहेंगो, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />काहैकि मोकै पता है कि तुमरी प्रार्थना और ईसु मसीह की आत्मा की मदत से जो कछु भौ है, मैं बच जांगो। <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />मेरी गहरी इच्छा और आसा है कि मैं अपने काम मैं कहु असफल नाय होमंगो, लेकिन हर समय और खासकर अभै, मैं पूरी हिम्मत से भरो रहमंगो, ताकी मैं अपने पूरे पहचान के संग मसीह को सम्मान दिबामौं, चाँहे मैं जिंदो रहमौं या मेरो सरीर मर क्यू ना जाबै। <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />काहैकि मेरे ताहीं जिंदो रहनो मसीह है, और मर जानो फायदा है। <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />पर अगर सरीर मैं जिंदो रहनोई मेरे काम के ताहीं फायदेमंद है तौ मैं नाय जानथौं कि कौनकै चुनौं। <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />मोकै दुई तरफ खींचो गौ है। मैं जौ जिंदगी कै छोड़नो चाहथौं और मसीह के संग रहनो चाहथौं, जो कि भौत अच्छी बात है; <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />लेकिन तुम लोगन के ताहीं जौ भौत जरूरी है कि मैं सरीर मैं जिंदो रहमौं। <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />मोकै जाके ऊपर भरोसो है, और इसलै मोकै पता है कि मैं रहमंगो। मैं तुम सबके संग रहेंगो, बिस्वास मैं अपनी प्रगति और खुसी कै जोड़न के ताहीं, <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />ताकी जब मैं तुमरे संग फिर से रहमौं, तौ तुमरे पास ईसु मसीह के संग अपनी जिंदगी मैं मेरे ऊपर गरब करन की और भी बजह होगी।<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />खाली इतनो करौ, कि तुमरो चाल-चलन मसीह के सुसमाचार के काबिल होबै, कि चाँहे मैं तुमकै खुद आए कै देखौं, चाँहे ना भी आमौं, तुमरे बारे मैं जौ सुनौ कि तुम एकै आत्मा मैं टिके हौ, और एक चित्त हुईकै सुसमाचार के बिस्वास के ताहीं मेहनत करत रहथौ। <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />अपने दुस्मियन से मत डराबौ; हमेसा हिम्मत बारे बनौ, और जौ उनके ताहीं साबित होगो, कि बे हार जांगे और तुम जीत जाबैगे, काहैकि बौ परमेस्वर है जो तुमकै बचाए देथै। <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काहैकि न सिरफ बाके ऊपर बिस्वास करन से, वरन बाके ताहीं दुख उठान के बजह से भी तोकै मसीह की सेवा करन और खुदकै सौंपन को सौभाग्य मिलो है। <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />अब तुम मेरे संग लड़ाई मैं भाग ले सकथौ। जौ बहे लड़ाई है जो तुम मोकै अतीत मैं लड़त भइ देखे रहौ, और जैसो कि तुम सुने हौ, मैं अभईयो लड़ रौ हौं।<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">मसीह की विनम्रता और महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />मसीह मैं तुमरी जिंदगी तुमकै मजबूत बनाथै, और बाको प्यार तुमकै दिलासा देथै। तुमरे झोने आत्मा के संग संगती है, और तुमरे झोने एक दुसरे के ताहीं दया और करुना है। <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />मैं तुमसे आग्रह करथौं, जो मोकै पूरी तरह से खुस करैगो, एकै बिचार रखौ, बहे प्रेम कै बाटौ, और आत्मा, मन मैं एक होबौ <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />स्वार्थी इच्छा से या घमंड करन की सस्ती इच्छा से कछु मत करौ, लेकिन एक दुसरे के प्रति विनम्र रहबौ, हमेसा दुसरेन कै अपने आप से अच्छो मानौं। <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />और एक दुसरेन के हित की सोचैं, ना कि खाली अपने बारे मैं। <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />जैसो ईसु मसीह को स्वभाव रहै बैसिये तुमरो भी स्वभाव और सोच होबै:<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />बाके पास हमेसा परमेस्वर को स्वरूप रहै,</para>
  <para style="q2" vid="PHP 2:6">लेकिन बौ जौ नाय सोची रहै कि जबरजत्ती बाकै परमेस्वर के बराबर रहन की कोसिस करनो चाहिए।<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />जाके बजाय, बौ अपनी मरजी से अपनो सब कछु छोड़ दई,</para>
  <para style="q2" vid="PHP 2:7">और एक दास को स्वरूप ले लई।</para>
  <para style="q1" vid="PHP 2:7">बौ एक इंसान की तरह बन गौ</para>
  <para style="q2" vid="PHP 2:7">और इंसान की बराबरी मैं दिखाई दई।<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />बौ विनम्र रहै और आग्याकारिता के रहामैं चलत भौ मौत तक पौहौंच गौ,</para>
  <para style="q2" vid="PHP 2:8">क्रूस की मौत।<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />जौ बजह से परमेस्वर बाकै सबसे ऊँची जघा मैं</para>
  <para style="q2" vid="PHP 2:9">से ऊपर उठाई और बाकै बौ नाओं सौंप दई जो सब नाओं से बड़ो है।<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />और इसलै, जो स्वर्ग मैं और पृथ्वी मैं और जो पृथ्वी के तरे हैं;</para>
  <para style="q2" vid="PHP 2:10">बे सब ईसु के नाओं मैं घूँटो टेकैं,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />और परमेस्वर दऊवा की महिमा के ताहीं</para>
  <para style="q2" vid="PHP 2:11">और सब खुलेआम ऐलान करंगे कि ईसु मसीह ही प्रभु है।<verse eid="PHP 2:11" /></para>
  <para style="s">पूरी दुनिया मैं उजीते के हानी चमक रौ है</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />इसलै, प्रिय दोस्तौ, जैसो कि तुम हमेसा मेरी आग्या माने जब मैं तुमरे संग रहौं, तौ जौ और भी जरूरी है कि तुम मोसे दूर रहकै अब मेरी बात मानौ। अपने उद्धार कै पूरो करन के ताहीं डर और काँपत भै काम करत रहबौ, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काहैकि परमेस्वर हमेसा तुमरे मैं काम करन ताहीं तैयार है ताकी तुम अपने उद्देस्य कै मान सकौ।<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />सब कछु बिना सिकायत या बहस के करौ, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />ताकी तुम निर्दोस और सुद्ध बन सकौ परमेस्वर के पूरी औलाद के रूप मैं, जो भ्रस्ट और पापी लोगन की दुनिया मैं रहथैं। तुम उनके बीच चमकते रहबौ, जैसे आसमान मैं चमकन बारे तारा, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />जैसो कि तुम उनकै जिंदगी कै संदेस देथौ। अगर तुम ऐसो करथौ, तौ मेरे पास मसीह के दिन मैं गरब करन की बजह होगी, काहैकि जौ दिखागो कि मेरी पूरी कोसिस और काम बेकार नाय भौ है।<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />अगर मोकै तुमरे बिस्वास के बलिदान और सेवा के संग अपनो खूनौं बहान पड़ै तौभी मैं खुस हौं, और तुम सबके संग खुस रहथौं। <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />बैसिये, तुम्हऊँ खुस रहबौ और अपनी खुसी मेरे संग बाटौ।<verse eid="PHP 2:18" /></para>
  <para style="s">तीमुथियुस और इपफ्रुदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />अगर जौ प्रभु की इच्छा है, तौ मोकै आसा है कि मैं जल्दिये तीमुथियुस कै तुमरे झोने भेज सकंगो, ताकी मोकै तुमरे बारे मैं खबर मिलै तौ मोकै बढ़ावा मिलै। <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />बहे एकमात्र आदमी है जो मेरे मन की बात समझथै। और जो बास्तव मैं तुमरी परवाह करथै। <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काहैकि सब अपने फायदा कै ढूँड़त रहथैं, ना कि ईसु मसीह कै। <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पर बाकै तौ तुम जानियो लै हौ, कि अपनी काबिलियत कै कैसे सिद्ध करी है, कि जैसो लौड़ा दऊवा के संग करथै, बैसिये बौ सुसमाचार कै फैलान मैं मेरे संग सेवा करी। <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />इसलै मोकै उमीद है कि जैसिये मोकै पता चलैगो, कि मेरे ताहीं चीजैं कैसे बदल जांगी, मौका मिलतै मैं बाकै भेजंगो। <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />और मोए प्रभु के ऊपर भरोसो है कि मैं खुद जल्दिये तुमरे झोने आए सकंगो।<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />मैं सोचो हौं कि तुमरे झोने मेरो भईय्या इपफ्रुदीतुस कै भेजनो जरूरी है, जो मेरी तरफ से काम करी है, और जो मेरी सेवा करन मैं तुमरे खबरेया के रूप मैं काम करी है। <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />काहैकि बाको मन तुम सब मैं लगो रहथै, जौ बजह से बौ बेचैन उतावलो रहथै, काहैकि तुम सुने रहौ कि बौ बिमार रहै। <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />बात जौ रहै कि बौ बिमार रहै, और लमसम मरिये गौ रहै। लेकिन परमेस्वर बाके ऊपर दया करी, और ना खाली बाके ऊपर बल्किन मेरियौ ऊपर दया करी, ताकी मेरे ऊपर दुख मैं दुख नाय पड़ै। <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />मैं भौत बेचैन हौं, फिरसे, बाकै तुमरे झोने भेजन के ताहीं, ताकी तुम बाकै देखन के बाद फिर से खुस हुई जाबौ, और मेरियौ दुख खतम हुई जांगे। <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />इसलै तुम प्रभु मैं बासे भौत खुसी के संग मिलियो, और ऐसेन को आदर करियो, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काहैकि बौ अपनी जिंदगी कै खतरा मैं डार दई और लमसम मसीह के कामन ताहीं मर गौ रहै, ताकी मोकै बौ मदत मिल सकै जो तुम खुद नाय दै सकत रहौ।<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">सच्चो न्यायीपन</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />आखरी मैं, मेरे भईय्यौ, प्रभु के संग खुस रहबौ। मैं जो पहले लिखो हौं बाकै दुबारा लिक्खन मैं मोकै कोई दिक्कत ना है, और अगर मैं ऐसो करथौं, तौ तुमरिये भलाई है। <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />कुत्तन से चौकन्ने रहबौ, बे बुरे काम करन बारेन से चौकन्ने रहबौ, बे काटा-कूटी करन बारेन से चौकन्ने रहबौ। <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काहैकि सच्चे खतना बारे तौ हम हैं जो परमेस्वर की आत्मा की अगुवाई से उपासना करथैं, और ईसु मसीह के ऊपर घमंड करथैं और सरीर के ऊपर भरोसा नाय रखथैं। <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />मैं सई मैं सरीर मैं अपनो भरोसा रख सकथौं, अगर तुम मैं से कोई कै लगथै कि तुम सरीर मैं भरोसा रख सकथौ, तौ मेरे झोने ऐसे महसूस करन की और भी बजह हैं। <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />जब मैं एक सप्ताह को रहौं, तौ मेरो खतना करो गौ रहै। मैं जनम सेई इस्राएल को हौं, बिन्यामीन गोत्र को हौं, जो सुद्ध खून बारो इब्रानी हौं, जहाँ ले यहूदि नियम कै बनाए रखन की बात है, मैं एक फरीसी रहौं।<verse eid="PHP 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PHP 3:6" />और मैं इतनो जोस मैं रहौं, कि मैं कलीसिया कै सताओ; जहाँ ले एक आदमी बेबस रहै की नियमन को पालन करकै न्याई हुई सकथै, मैं निर्दोस रहौं। <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />लेकिन बे सब चीजैं जिनकै मैं फायदा के रूप मैं गिनाए सकत रहौं, अब मैं मसीह के ताहीं नुकसान के रूप मैं मानथौं। <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />खाली बे चीजन कै नाय; मोकै सब कछु के ताहीं पूरो नुकसान के रूप मैं लगथै, कि का इतनो अगरो कीमती है, ईसु मसीह मेरे प्रभु को ग्यान, बाके खातिर मैं सब कछु फेंक दौ हौं; मैं जाकै खाली कचड़ा मानथौं, ताकी मैं मसीह कै पाए सकौं। <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />और जाके संग पूरी तरह से एकजुट रहबौ, मेरे पास अब खुद की न्यायीपन नाय है, जो नियम कै मानन से मिलथै; अब मेरे पास न्यायीपन है जो मसीह मैं बिस्वास के जरिये से दई गई है, न्यायीपन जो परमेस्वर से आथै, और बिस्वास से मिलथै। <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />मैं बस जहे चाहथौं, कि मसीह कै जानैं और बाके पुनरुत्थान की सामर्थ्य कै महसूस करैं, बाके दुखन मैं भागीदार होमैं और बाकी मौत मैं बाके जैसो बनै, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />जौ आसा मैं कि मैं खुद मौत से जिलाओ जांगो।<verse eid="PHP 3:11" /></para>
  <para style="s">लक्छ के घाँईं दौड़नो</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />मैं जौ दाबा नाय करथौं, कि मैं अग्गुए कामयाब हुई चुको हौं या पहलेई से परिपूर्ड़ हुई गौ हौं; मैं बौ इनाम कै जीतन के ताहीं कोसिस करत रहथौं जोके ताहीं ईसु मसीह मोकै पहले सेई खुदकै जीती है। <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />बेसक, मेरे भईय्यौ, मैं बास्तव मैं जौ नाय सोचथौं कि मैं पहलेई जाकै जीत लौं हौं; हालाकि, एक बात जो मोकै याद है, बौ जौ है कि मेरे पिच्छू जो है, बाकै भूल जाबौ और जो अग्गु है, हुँआँ पौहोंचन की पूरी कोसिस करौ। <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />इसलै मैं इनाम जीतन के ताहीं सीधे लक्छ के घाँईं दौड़थौं, जोके ताहीं परमेस्वर मोकै ईसु मसीह मैं ऊपर बुलाई है।<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />हम सब जो आध्यात्मिक रूप से मजबूत हैं, उनकै जहे रबईय्या होनो चाहिए; लेकिन अगर तुम मैं से कोई कै रबईय्या अलग है, तौ परमेस्वर तुमरे बिचारन कै प्रकट कर देगो। <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />हालाकि, हम अबले बेईं नियमन के हिसाब से अग्गु बढ़े, जिनकै हम पालन करथैं।<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />मेरे भईय्यौ, मेरी नकल करते रहबौ बे लोगन के ऊपर ध्यान देबौ जो हमरे जरिये तुमरे ताहीं निर्धारित सई उदाहरड़ को पालन करथैं। <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />मैं तुमकै पहलेऊ तमान बार जौ बताओ हौं, और अब मैं जाकै आँसु के संग दोहराथौं: ऐसे भौत से लोग हैं जिनकी जिंदगी उनकै क्रूस मैं मसीह की मौत कै दुस्मन बनाए दई। <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />बे नरक मैं बिनास होन कै जाए रै हैं, काहैकि उनकै परमेस्वर उनकी सारीरिक इच्छाएं हैं; उनकै जौ बात को गर्व है कि उनकै काहैकि सरम आनी चाहिए, और बे खाली बे चीजन के बारे मैं सोचथैं जो जौ दुनिया से मिलत-जुलत हैं। <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />हालाकि, हम स्वर्ग के नागरिक हैं, और हम बेसबरी से अपने उद्धारकर्ता, प्रभु ईसु मसीह को इंतजार करथैं। <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />बौ हमरे कमजोर खतम होन बारी सरीर कै बदल देगो, और उनकै अपनी महिमामय सरीर के हानी बनाए देगो, बौ सक्ति कै इस्तमाल करकै जोके जरिये बौ सबै चीजन कै अपने अधीन मैं करन मैं सक्छम है।<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">पौलुस की सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />तौ, मेरे प्रिय भईय्यौ, तुम मोकै कितने प्रिय लगथौ, और मैं तुमकै कैसे याद करथौं! तुम मोकै कितनो खुस करथौ, और मोकै तुमरे ऊपर कितनो गरब है! मेरे प्रिय दोस्तौ, तुमकै प्रभु मैं मुकुट के ताहीं अपनी जिंदगी मैं मजबूत रहनो चाहिए।<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />यहूदिया और सुन्तुखे, किरपा, मैं तुमसे नहोरे करथौं, प्रभु मैं बहेनियन के हानी एक बात मैं सहमत होन की कोसिस करौ। <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />और तुम्हऊँ, मेरे दूसरे सहकर्मी हैं उनके संग भौत मेहनत करीं हैं मैं चाहथौं कि तुम इन बईंय्यरन की मदत करौ; काहैकि बे मेरे संग सुसमाचार कै फैलान के ताहीं बड़ा मेहनत करीं हैं, संग मैं क्लेमैस और मेरे संग के मेहनत करीं, जिनके नाओं परमेस्वर के पास जिंदेन की किताब मैं लिखे हैं।<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />प्रभु मैं हमेसा खुस रहबौ; मैं फिर से कहथौं, खुस रहबौ।<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />सबके ताहीं अपनो रबईय्या अच्छो बनाए रखैं; प्रभु जल्दिये आए रहो है।<verse eid="PHP 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PHP 4:6" />कछु चीज की चिंता मत करौ, तुमरे हर प्रार्थना मैं जो चाहिए बौ धन्यवाद के संग परमेस्वर से माँगौ। <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />तौ परमेस्वर की सांति, जो इंसानन की समझ से परे है, ईसु मसीह मैं एक होन के बजह से तुमरे दिल और दिमाक कै ठीक रखैगो।<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />आखरी मैं, मेरे भईय्यौ, अपने दिमाक कै बे चीजन से भरौ, जो धार्मिक हैं, अच्छी हैं और जो बड़ाँईं के काबिल है: ऐसी चीजैं जो सच्ची, महान, सई, सुद्ध, प्यारी और आदर के काबिल हैं। <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />मेरे बातन से और मेरे कामन से, तुम जो सीखे और जो पाए, बाकै अपने चाल-चलन मैं लाबौ; और जो परमेस्वर हमैं सांति देगो, बौ तुमरे संग रहागी।<verse eid="PHP 4:9" /></para>
  <para style="s">दान के ताहीं धन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />प्रभु के संग मेरी जिंदगी मैं जौ मेरे ताहीं बड़ा खुसी की बात है, कि इतने लंबे समय के बाद एक बार फिर तुमकै जौ दिखान कै मौका मिलो, कि तुम मेरी देखभार करथौ; मेरो मतलब जौ नाय है कि तुम मेरी देखभार करनो बंद कर दै हौ, तुमरे झोने जाकै दिखान कै कोई मौका नाय रहै। <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />और मैं जौ नाय कहरौ हौं, काहैकि मैं खुदकै कमी महसूस कर्‌रौ हौं, काहैकि मैं जो कुछ भी हौं बामै संतुस्ट रहनो सीख लौ हौं। <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />मोकै पता है कि जरूरत मैं कैसे रहनो चाहिए और भरपूरी मैं कैसे रहनो चाहिए। और जरूरत से जद्धा जोड़नो का है, मैं जौ राज कै सिको हौं, कि कहीं भी, कभी संतुस्ट कैसे रहने है चाहे मैं तृप्त होमैं या भूंको होमौं, चाँहे मेरे पास भौत कछु होबै या कुछ ना होबै। <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जो मोकै ताकत देथै बौ मसीह के जरिये मैं सब परिस्थियन को सामना कर सकथौं।<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />लेकिन मेरी परेसानी मैं भागीदारी करनो तुमरे ताहीं भौत अच्छो रहै। <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />तुम फिलिप्पियन कै अच्छी तरह से पता है, कि जब मैं सुसमाचार<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">अंग्रेजी बाईबिल</char></note> के प्रचार के सुरुवाती दिनन मैं मकिदुनिया छोड़ दौ रहौं, तौ तुम मेरी मदत करन बारे इकलौती कलीसिया रहौ; तुम्हईं मेरे फायदा और नुकसान कै साझा करन बारे रहौ। <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />ऐसिये जब मैं थिस्सलुनीके मैं रहौं; तहुँओं तुम मेरी घटी पूरी करन के ताहीं एक बार का दुई बार कछु भेजे रहौ। <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />ऐसो ना है कि मैं सिरफ दान लेनो चाहथौं; बल्किन, मैं तुमरे खाता मैं जुड़े भै फायदा देनो चाहथौं। <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />मैं सब कछु पाओ हौं, बल्किन अगरो करकै पाओ हौं; जो चीजैं तुम इपफ्रुदीतुस के हाथ से भेजे रहौ, बे चीजन कै पाएकै मैं भरपूर हुई गौ हौं, बाकी खुसबू तौ सुकून देन बारी और अपनान के काबिल बलिदान है, जो कि परमेस्वर कै अच्छो लगथै।<note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="HEB 13:16">इब्रानियों 13:16</ref></char></note> <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />और मेरो परमेस्वर भी अपने बौ महिमामय धन के हिसाब से जो महिमा समेत मसीह ईसु मैं है, तुमरी हर एक घटी कै पूरो करैगो। <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />हमरे परमेस्वर और दऊवा की महिमा सदा सर्वदा होत रहबै! आमीन।<verse eid="PHP 4:20" /></para>
  <para style="s">आखरी नमस्ते</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />सब परमेस्वर के पवित्र लोगौ जो मसीह ईसु मैं है, नमस्ते। जो भईय्या मेरे संग है तुमकै नमस्ते कहथैं। <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />परमेस्वर के सब पवित्र लोगौ, खासकर जो कैसर के घराने के हैं तुमकै नमस्ते कहथैं।<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />प्रभु ईसु मसीह कै अनुग्रह तुमरी आत्मा के संग रहबै। आमीन।<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">कुछ हस्तलेखों मैं आमीन सब्द नहीं है </char></note><verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>