<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">– Tsakhur</book>
  <para style="toc3">Yunus</para>
  <para style="toc2">Yunus</para>
  <para style="toc1">Yunus peyğambarın kitab</para>
  <para style="mt1">Yunus peyğambarın kitab</para>
  <para style="ip">İne kitabee otk'uninbı yişde eerayle ögil VIII-esde asiree ıxha. Allahee Yunus peyğambarık'le İzraileençe Nineva eyhene şahareeqa, Assiriye imperiyeyne paytaxteeqa, hak'neva eyhe. Allahee mana Ninevalqa maane insanaaşik'le cokun cone bınahbışil-alla ha'asınva eyhes g'ıxele. Assiriye imperiyeyn hiqiy-allane milletbışilqa yiğbı exa ıxha, manbı geeb eb deşin karbı vuxha. Mançil-allar Yunus peyğambarıs cune milletne duşmanaaşisqa ı'qqəs ıkkan ıxha deş. Mang'us Allahne cuvabıke qığeç'u, hixvas ıkkiykan. Qiyğa ıxhaynbı şok'le ats'axhxhes ıkkanxhee, şosse ine kitabee qətqəs əxə.</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">Yunusun Allahıke hixvuy</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />Rəbbee Amitayne dixek'le Yunusuk'le inəxdun cuvab eyhe:<verse eid="JON 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JON 1:2" />– Oza qıxha Nineva eyhene xənne şahareeqa hark'ın maabınbışilqa hixhar he'e: co ha'an nyaayid deşin karbı Zak'le ats'a vodunbı.<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />Yunususmee oza qıxha, Rəbbile hixu menne suralqa, Tarşişeeqa əlyhəəs ıkkiykan. Mana ghal-k'ena Yafeeqa qarayle. Ma'ad mang'vee Tarşişeeqa əlyhəən gamı t'abal ha'a. Yəqqı'na hək'ib quvu, Rəbbile hixvasva mana manbışika gameeqa giy'ar.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />Rəbbeeme mane gahıl deryahılqa məxübna it'umna mıts g'uxoole, gamı haq'varasınçil qexhe. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />Gameebınbı qəpq'ı'n cone allahbışilqa ona'a giviyğal. Gamı sibık qa'asva manbışe gırgın kar deryaheeqa dağa'a.</para>
  <para style="p" vid="JON 1:5">Yunusmee mane gahılqasse gamıyne avudne cigeeqa giç'u it'umra g'alirxhu eyxhe. <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />Gamıyna xərna mang'usqa qarı eyhen:</para>
  <para style="p" vid="JON 1:6">– Ğu nya'a g'alirxhu? Oza qıxha yiğne Allahılqa one'e. Sayid Mang'vee şas kumag ha'a, hapt'ıyke g'attivxhan haa'a.<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />Gameebınbışe sana-sang'uk'le eyhen:</para>
  <para style="p" vid="JON 1:7">– Qudoora çöp k'eççu ilyaakas şavul-allayiy şalqa in yiğbı ı'qqə.</para>
  <para style="p" vid="JON 1:7">Çöp k'eççumee, man Yunusulqa g'e'exha.<verse eid="JON 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JON 1:8" />Manbışe mang'uke qiyghanan:</para>
  <para style="p" vid="JON 1:8">– Həşde ğu şak'le eyhelan, in şak qitxhuyn divan şavul-allane vod? Ğu hucoonexhe ha'an? Nençene qöö? Vatan nyaa'ane vob? Nene milletnane vor?<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />Mang'vee eyhen:</para>
  <para style="p" vid="JON 1:9">– Zı cühüt' vorna. Zı ç'iyeyiy deryah itxhıning'us, xəybışde Allahıs, Rəbbis, ı'bəədat ha'a.<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />Mang'vee manbışik'le eyhen, vuc Rəbbile hexvava. Manbı it'umba qəpq'ı'n qiyghanan:</para>
  <para style="p" vid="JON 1:10">– Ğu in hı'iyn hucoone?<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />Deryaheena mıts it'um qooxhe g'avcu, manbışe mang'uke qiyghanan:</para>
  <para style="p" vid="JON 1:11">– Mana mıts huvoracenva şi vak hucoone ha'as?<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />Yunusee manbışik'le eyhen:</para>
  <para style="p" vid="JON 1:12">– Zı alyart'u deryaheeqa huvoxhre. Manke mıts ulyoozarasda. Zak'le ats'an, məxübne it'umne mıtseeqa şu zal-alla gyapk'ı.<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />Gameebınbışis avarbı it'umda alik'arı'ı xhyan g'ıttiyxhane cigeeqana əlyhəəs vukkiykıneeyib, geeb g'ooxhene mıtsın əlyhəəs havaasar deş. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />Manke manbı giviyğalanbı Rəbbilqa ona'a:</para>
  <para style="p" vid="JON 1:14">– Hucoone ixhes, Rəbb, mane insanın şi tan ileşşeva şi gimabat'a. Bınah deşung'un hı'sab şake qımeqqa. Ğu, Rəbb, Vas ıkkanəxüd hı'ı.<verse eid="JON 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JON 1:15" />Manbışe Yunus aqqı deryaheeqa g'uvorxhulymee, mıtsıb ulyoozarna. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />Gameebınbı it'umba qəpq'ı'n, Rəbbis cuvab huvu q'urban ablyaa'a.<verse eid="JON 1:16" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">Yunusna düə</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />Rəbbee geed xədın baluğ qali'ı Yunus k'öğəs ilekka. Yunus baluğne vuxhnee xhebılle yiğnayiy xheyible xəmna axva. <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />Yunusee baluğne vuxhnenang'a cune Rəbbis Allahıs inəxübna düə haa'a:<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />Rəbb, zı dağamiyvalenang'a Valqa onu'u,</para>
  <para style="q2" vid="JON 2:3">Ğunad alidghıniy quvuyn.</para>
  <para style="q1" vid="JON 2:3">Zı ahaleençe ts'ir hav'u,</para>
  <para style="q2" vid="JON 2:3">Vak'le yizda ts'ir g'avxhuna.<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />Ğu zı deryahne k'oralybışeeqa g'uvorxhul,</para>
  <para style="q2" vid="JON 2:4">Zı xhyanbışde yı'q'nee axu,</para>
  <para style="q1" vid="JON 2:4">Yiğın gırgın xhyanbıyiy dalğabı</para>
  <para style="q2" vid="JON 2:4">Zal ooğançe ılğeeç'u.<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />Manke zı uvhiyn: «Ğu zı Vake əq'əna qı'ı,</para>
  <para style="q2" vid="JON 2:5">Meed zak'le Yiğın muq'addasın xav İyerusalimee g'acesıncad».<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />Nafas əlyhəəsme xhyanbı zalqa qadı,</para>
  <para style="q2" vid="JON 2:6">K'oralybışeeqa qıkkı,</para>
  <para style="q1" vid="JON 2:6">Vuk'lelqad xavsiy alitk'ır.<verse eid="JON 2:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="JON 2:7" />Suvabışde avqamee zı giç'una,</para>
  <para style="q1" vid="JON 2:7">İttehesu Ğu dyunyeyn akkabı zal oğa it'umetxha.</para>
  <para style="q2" vid="JON 2:7">Ğumee yizda Rəbb Allah</para>
  <para style="q1" vid="JON 2:7">Yizın tan k'oralybışeençe g'attixhan hı'iyn.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />Yizda ı'mı'r k'yabat'amee,</para>
  <para style="q2" vid="JON 2:8">Zı Rəbb yik'el qali'ı,</para>
  <para style="q1" vid="JON 2:8">Yizda düə Valqa,</para>
  <para style="q2" vid="JON 2:8">Yiğne muq'addas xaalqa hipxhırna.<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />Şavaayiy nişiscad karaı'dəəne byutbışis ı'bəədat ha'a,</para>
  <para style="q2" vid="JON 2:9">Manbışe Ğu yik'el hixan ha'a,</para>
  <para style="q2" vid="JON 2:9">Colqana rəhı'm avaak'an haa'a.<verse eid="JON 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JON 2:10" />Zımee şukur haa'ane mə'niybışika</para>
  <para style="q2" vid="JON 2:10">Vas q'urbanbı allya'as.</para>
  <para style="q1" vid="JON 2:10">Zı huvuyn cuvab cigeeqa qalya'asın.</para>
  <para style="q2" vid="JON 2:10">G'attivxhan haa'ana sa Rəbb Vuc vorna!<verse eid="JON 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 2:11" />Rəbbee baluğuk'le uvhiyng'a, mançin Yunus ghalençe xhyan deşde cigeeqa qığayhe.<verse eid="JON 2:11" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">Yunus Nineveeqa arayle</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />Rəbbee Yunusuk'le q'ö'es inəxdun cuvab eyhe:<verse eid="JON 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JON 3:2" />– Oza qıxha Nineva eyhene xənne şahareeqa hark'ın, Zı uvhiynbı maabınbışilqa hixhare'e.<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />Rəbbee uvhiynçil k'ırı gyaqqı, Yunus Ninevalqa ayk'an. Nineva geeb xəbna şahar vuxha, mançe ılğeç'esdemee xhebılle yiğniyxhe ıkkiykanan. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />Yunus giyğalna şaharvolle iykar. Ts'ettiyne yiğıl ı'qqəs əxənemene cigabışeeqa hark'ın, mang'vee eyhen:</para>
  <para style="p" vid="JON 3:4">– Yoq'ts'alyne (40) yiğıle Nineva kunfa-yakun haa'asda!<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />Ninevağançenbışe Allahılqa inyam hı'ı, siv aqqeva ses qığayhe. Manbışe xərıng'ule otçu k'ıning'ulqamee palanbı alya'a.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />Mana xabar Ninevayne paççahılqa hipxhırmee, mana cune taxtıle giç'u, paççahaaşin tanalinbı g'ayşu, palan ali'ı, yı'qqı'l giy'ar. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />Paççahee əmr haa'a cuneyiy ağsaqqalaaşine doyule Nineval inəxüd eyhecenva:</para>
  <para style="pmo" vid="JON 3:7">«İnsanaaşe, həyvanaaşe, çavra-vəq'əyn vuççud umoyxhancen, xhyanbı ulymoğacen, uxhiyxhanasıd hımayk'ancen. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />İnsanaaşilqa, həyvanaaşilqa palanbı ale'ecen. Gırgıng'vee Allahıs geeb düə he'e. Havaasre manbışe karaı'dəəne işbışikeyiy insanaaşis haa'ane pisvalike xıl ts'ıts'ee'ecen. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />Şavuk'lene ats'a, Allahee sayıb şalqana qəl rəhı'mılqa savaak'alav'u, şi hapt'ıyke g'attivxhan haa'a».<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />Allahık'le manbı karaı'dəəne işbışile sapk'ıl g'avcumee, manbışilqa rəhı'm haa'a. Manbışilqa ablyaa'asva uvhuna ver, ablyaa'a deş.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">Yunusee qəl haa'a</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />Yunusus man diykın, qəlın qoxa eyxhe. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />Mang'vee Rəbbis inəxübna düə haa'a:</para>
  <para style="p" vid="JON 4:2">– Ya Rəbb, zı hamanva nya'a xaanang'acar dişdiy uvhu? Mançil-allar zı Tarşişeeqaniy hixu. Zak'le ats'anniy Yiğna yugvalla avayk'an deş, Ğu rəhı'mnana, xədın sabırnana, ablyaa'asva uvhuna ver, ablyaa'as devkanna Allah vor. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />Rəbb, hucoone ixhes, həşdiyle yizın can alişşe, zas ı'mı'r haa'as vukkan deş, qik'as ıkkan.<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />Rəbbee mang'uk'le eyhen:</para>
  <para style="p" vid="JON 4:4">– Deşxhee, vas mançike geebne qəl vuxha?<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />Yunus qığeç'u şaharne şargne sural giy'ar. Ma'ad mang'vee cusun verığ qıdyoot'asın xhinnen cigad ali'ı, şaharık hucooyiy ixhesva ilyakka giy'arna. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />Rəbb Allahee, Yunusus yugda ixhecenva, maa'ad əq gyaahasın sa ala aleylya'a. Yunus man ala g'acu geer şadexhena. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />Qinne yiğıl miç'eeqana mane alalqa Allahee mı'q g'ıxoolee. Mane mı'qən ala adğançe otxhunmee, ala qeqqvan. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />Verığ ılqevç'umee, Allahee maqa kar qeqqva'ana g'ümana mıts g'ıxoole. Verığın mang'una vuk'ul gyooxhanav'u, mana sa curay qa'a girğılymee, mang'vee cus qik'uy heqqa:</para>
  <para style="p" vid="JON 4:8">– Zas ı'mı'r haa'as vukkan deş, qik'as ıkkan!<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />Allaheeme Yunusuk'le eyhen:</para>
  <para style="p" vid="JON 4:9">– Deşxhee, vas alayl-alla geebne qəl vuxha?</para>
  <para style="p" vid="JON 4:9">Yunusee eyhen:</para>
  <para style="p" vid="JON 4:9">– Ho'o! Zas qik'asda xhinnena qəl vuxha!<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />Rəbbee mang'uk'le eyhen:</para>
  <para style="p" vid="JON 4:10">– Ğu idezuyn, ğu ilydyakkıyn sa xəmne əəre alyadı-qeqquyn ala vas qiykkan! <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />Nəxübne Zas qidivkvanas manimee xəbna Nineva eyhena şahar, maadın vəşşe g'alle aazır (120 000) sağıy sol dyats'an milletiy manimeen çavra-vəq'ə?<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>