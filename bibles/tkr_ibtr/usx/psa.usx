<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">– Tsakhur</book>
  <para style="toc3">Zab.</para>
  <para style="toc2">Zabur</para>
  <para style="toc1">Zabur</para>
  <para style="mt1">Zabur</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="cl">Q'öble yəq</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Pisınbışde mı'sləhətıka</para>
  <para style="q2" vid="PSA 1:1">yəq idyaak'anna,</para>
  <para style="q1" vid="PSA 1:1">bınahnanbışika</para>
  <para style="q2" vid="PSA 1:1">gyu'ur oza qidexhena,</para>
  <para style="q1" vid="PSA 1:1">matsxar haa'anbışika</para>
  <para style="q2" vid="PSA 1:1">gidiy'arna</para>
  <para style="q1" vid="PSA 1:1">insan nimeecar baxtivariy!<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>Mang'uname şadvalla saccu</para>
  <para style="q2" vid="PSA 1:2">Rəbbine Q'aanunee vobna.</para>
  <para style="q1" vid="PSA 1:2">Xəmbına-yiğbına mang'vee</para>
  <para style="q2" vid="PSA 1:2">mana qəbəqqə,</para>
  <para style="q2" vid="PSA 1:2">mançina haa'a.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Mana xhyanbışde</para>
  <para style="q2" vid="PSA 1:3">mıglek oozuna,</para>
  <para style="q3" vid="PSA 1:3">şagav çine gahıl helena,</para>
  <para style="q3" vid="PSA 1:3">çin t'eled hı'ç'diyğənna</para>
  <para style="q2" vid="PSA 1:3">yiv xhinnee ixhes.</para>
  <para style="q1" vid="PSA 1:3">Mang'vee ha'ane gırgıne karee</para>
  <para style="q2" vid="PSA 1:3">barakat vuxhes.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Pisın insanarmee</para>
  <para style="q2" vid="PSA 1:4">məxbınbı deş vob,</para>
  <para style="q1" vid="PSA 1:4">manbı mıtsın alixa'an</para>
  <para style="q2" vid="PSA 1:4">balybiy xhinnee vooxhe.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Mançil-allab pisınbışisse</para>
  <para style="q2" vid="PSA 1:5">məhkamee,</para>
  <para style="q1" vid="PSA 1:5">bınahnanbışisseb</para>
  <para style="q2" vid="PSA 1:5">qopkuyn insanarnane maclisee</para>
  <para style="q1" vid="PSA 1:5">ulyoozaras vəəxəs deş.<verse eid="PSA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Nya'a, Rəbbee qopkuynbışda yəq</para>
  <para style="q2" vid="PSA 1:6">dişde havaace?!</para>
  <para style="q1" vid="PSA 1:6">Pisınbışde yəqqı'nıb</para>
  <para style="q2" vid="PSA 1:6">manbı gyapt'as hoot'al.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">Allahee gixhxhına paççah</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Nişil-allane milletbı g'elil qeedaxhe?</para>
  <para style="q2" vid="PSA 2:1">Nişil-allane manbışe cosse dəxəsde karbışda haa'a?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Ç'iyene aq'valin paççahar, vuk'lek vukkekkanbı,</para>
  <para style="q2" vid="PSA 2:2">Rəbbilqayiy</para>
  <para style="q2" vid="PSA 2:2">Mang'vee g'əyxı'ng'ulqa, paççahılqa,</para>
  <para style="q3" vid="PSA 2:2">g'elil qeebaxhe.<verse eid="PSA 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 2:3"/>Manbışe eyhen:</para>
  <para style="q1" vid="PSA 2:3">«Qudoora, Manbışda xamut qakkyaahas,</para>
  <para style="q1" vid="PSA 2:3">şalin Manbışin zincirbı qoda'as!»<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Xəybışee taxtıl Gyu'uriyng'vee əqəna ha'as,</para>
  <para style="q1" vid="PSA 2:4">Xudaavandee manbı matsxara haa'as.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Qiyğa Mang'vee qəlın eyhesın.</para>
  <para style="q1" vid="PSA 2:5">Manbıb Mang'une it'umne qəlıle qəvəəq'ənasınbı.<verse eid="PSA 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 2:6"/>Mang'vee eyhen:</para>
  <para style="q1" vid="PSA 2:6">«Zı Yizda paççah</para>
  <para style="q2" vid="PSA 2:6">muq'addasne suval Sionul<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">Sion: </char><char style="ft" closed="false">İyerusalim alyav'una tepa vobna. İzrailyne paççahın xan-saray maaniy vod.</char></note> gi'ı».<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>[Paççahee eyhen:]</para>
  <para style="q1" vid="PSA 2:7">Rəbbee uvhuyn zı şolqa hixhar ha'asın.</para>
  <para style="q1" vid="PSA 2:7">Rəbbee zak'le uvhuyn:</para>
  <para style="q2" vid="PSA 2:7">«Ğu Yizda dix vor,</para>
  <para style="q2" vid="PSA 2:7">Zake g'iyna Vas dek ıxha.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Zake heqqe,</para>
  <para style="q2" vid="PSA 2:8">Zı vas gırgıne gahbışis milletbıyiy</para>
  <para style="q2" vid="PSA 2:8">ç'iyeyn aq'va ç'əvxhesmeen gırgın cigabı</para>
  <para style="q3" vid="PSA 2:8">Vas heles.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Ğu manbışikın yivayne əsaaka ha'as,</para>
  <para style="q1" vid="PSA 2:9">G'ı'bı'ne nyuq'vneke hı'iyn g'ab xhinnee</para>
  <para style="q2" vid="PSA 2:9">xüvə-xüvəna qaa'as».<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Həşdiyle, paççahar, ək'elika vuxhe!</para>
  <para style="q2" vid="PSA 2:10">Ç'iyene aq'valin haakimar, dars aleet'e!<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Rəbbile qəpq'ı'n Mang'us g'ullux hee'e!</para>
  <para style="q2" vid="PSA 2:11">Qəvəq'neb, şadeepxheb.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Allahne dixes, paççahıs,</para>
  <para style="q2" vid="PSA 2:12">qəl mooxhecenva hı'rmat givxhe.</para>
  <para style="q1" vid="PSA 2:12">Deşxheene, mang'una qəl</para>
  <para style="q2" vid="PSA 2:12">zarabacab ts'ayılqa sapk'ıl,</para>
  <para style="q2" vid="PSA 2:12">şokunud şu avquyne yəqqə ixhesın.</para>
  <para style="q1" vid="PSA 2:12">Mang'ulqa yı'q' qizzıriynbı</para>
  <para style="q2" vid="PSA 2:12">nimee baxtivarbayiy!<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">«Rəbbik'le zı geşşe g'ayxhiyn»</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 6:1"/>Maq'amne xərıng'us. Molyne simnane instrumentıkana Davudna mə'niy.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Rəbb, qəl vuxha zas cazaa humoole,</para>
  <para style="q1" vid="PSA 6:2">qəlın qoyxharmee, zake qəl qığmaaha.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Rəbb, zas rəhı'm hee'e,</para>
  <para style="q2" vid="PSA 6:3">Zaqa taq'at axu deş.</para>
  <para style="q1" vid="PSA 6:3">Rəbb, zı yug qe'e,</para>
  <para style="q2" vid="PSA 6:3">uts'uruke bark'vbışeeqa zeze aypxhı.<verse eid="PSA 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Caneeqa it'umna zeze aypxhı.</para>
  <para style="q1" vid="PSA 6:4">Rəbb, man mısılqameene ts'ıts'xhes?<verse eid="PSA 6:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Rəbb, qora zas kumag he'e,</para>
  <para style="q1" vid="PSA 6:5">Yiğne ç'əvcab dyooxhene yugvalika</para>
  <para style="q2" vid="PSA 6:5">zı g'attixhan he'e!<verse eid="PSA 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Qik'u ark'ınne insanee</para>
  <para style="q2" vid="PSA 6:6">Ğu deş yik'el qalya'as.</para>
  <para style="q1" vid="PSA 6:6">Şavaane qik'uyne cigeençe</para>
  <para style="q2" vid="PSA 6:6">Vas şukur haa'as?<verse eid="PSA 6:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Zı yizdecar hülöörxüyke orzulyna,</para>
  <para style="q1" vid="PSA 6:7">yiğıscad xəmde geşşuyke</para>
  <para style="q2" vid="PSA 6:7">zı g'ılexhan ciga çüvəda eyxhe,</para>
  <para style="q1" vid="PSA 6:7">ulene nağıke</para>
  <para style="q2" vid="PSA 6:7">yizın tyulyu çüvə qexhe.<verse eid="PSA 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Uts'uruke yizın uleppı qeqqu.</para>
  <para style="q1" vid="PSA 6:8">Duşmanaaşe zı geşşes ilekkançil-alla</para>
  <para style="q2" vid="PSA 6:8">yizın uleppı ozzur.<verse eid="PSA 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>Rəbbik'le zı geşşe g'ayxhiyn!</para>
  <para style="q1" vid="PSA 6:9">Pisın işbı g'ecenbı, zake əq'əna qeepxhe!<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Rəbbik'le, zı rəhı'm hee'eva eyhen, g'ayxhiyn,</para>
  <para style="q1" vid="PSA 6:10">Rəbbee yizda düə q'abıl hav'una!<verse eid="PSA 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 6:11"/>Yizın gırgın duşmanar</para>
  <para style="q2" vid="PSA 6:11">k'ap'ik'ıle avqa qeepxhes,</para>
  <para style="q1" vid="PSA 6:11">Manbı qəpq'ı'n,</para>
  <para style="q2" vid="PSA 6:11">manbışde caneeqa it'umna zeze avxhas,</para>
  <para style="q2" vid="PSA 6:11">Matsxareepxha, manbı zaraba heepxasınbı.<verse eid="PSA 6:11"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">«Nimee axtıdayiy Yiğın do ç'iyene aq'val!»</para>
  <para style="d">Maq'amne xərıng'us. Davudna Gittitne instrumentıkana mə'niy.</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 8:1-2"/>Ay Xudaavanda, yişda Rəbb,</para>
  <para style="q2" vid="PSA 8:1-2">nimee axtıdayiy Yiğın do ç'iyene aq'val!</para>
  <para style="q1" vid="PSA 8:1-2">Yiğna xəbvalla xəybışileb axtıba vob.<verse eid="PSA 8:1-2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Gyooqanbışded, uşaxaaşineb gyaaşuyle ğana</para>
  <para style="q2" vid="PSA 8:3">Ğu guc haagvas,</para>
  <para style="q1" vid="PSA 8:3">qəl qığaahane duşmanee</para>
  <para style="q2" vid="PSA 8:3">nıq' aqqecenva.<verse eid="PSA 8:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>Yiğne xıleppışde işiqa: xəybışiqa,</para>
  <para style="q1" vid="PSA 8:4">Ğu gyuvxhuyne vuzaqa,</para>
  <para style="q2" vid="PSA 8:4">Ğu gitk'ınne xənebışiqa, ilyakkamee,<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Zı eyhen: «İnsan vuşune vor,</para>
  <para style="q2" vid="PSA 8:5">Ğu mana yik'el aqqı?</para>
  <para style="q1" vid="PSA 8:5">İnsanıke g'abiynbı hucoo eyxhen karne,</para>
  <para style="q2" vid="PSA 8:5">Ğu manbışda haa'a?»<verse eid="PSA 8:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Ğu insan malaaikıle</para>
  <para style="q2" vid="PSA 8:6">sık'ırra avqana hı'ı.</para>
  <para style="q1" vid="PSA 8:6">İnsan axtı qı'ı,</para>
  <para style="q2" vid="PSA 8:6">tac xhineyid şöhrat huvu,<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7-9" style="v" sid="PSA 8:7-9"/>İt'xhınne karalqa mana paççah gixhxhı.</para>
  <para style="q1" vid="PSA 8:7-9">İn gırgın: çavra-vəq'ə, çolun həyvanar,</para>
  <para style="q2" vid="PSA 8:7-9">Xəədın şit'yar, deryahbışeedın baluğar,</para>
  <para style="q2" vid="PSA 8:7-9">Deryahbışeedın gırgıncad,</para>
  <para style="q1" vid="PSA 8:7-9">Ğu mang'une g'elybışiqqa huvu.<verse eid="PSA 8:7-9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 8:10"/>Ay Xudaavanda, yişda Rəbb,</para>
  <para style="q2" vid="PSA 8:10">nimee axtıdayiy Yiğın do ç'iyene aq'val!<verse eid="PSA 8:10"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">Ğu zı mısacar g'alerçes deş</para>
  <para style="d">Davudna düə</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>Allah, zı havace,</para>
  <para style="q2" vid="PSA 15:1">Zı dyugulexhen ciga Vasnee vod.<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Zı Rəbbik'le uvhuyn: «Yizda Xudaavanda Ğu vorna.</para>
  <para style="q2" vid="PSA 15:2">Vale ğayrı zaqa xoşbaxtıyvalla deşda».<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>Ç'iyene aq'valin Rəbbina yəq avquyn insanar nimeecab yugunbıyiy!</para>
  <para style="q2" vid="PSA 15:3">Saccu manbışe zı şad ha'a!<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>Menne allahaaşiqab qihna əlyhəənbışde</para>
  <para style="q2" vid="PSA 15:4">hasre vuk'lelqa geed yiğbı allecen.</para>
  <para style="q1" vid="PSA 15:4">Zı mane allahaaşinemee q'urbanna eb k'yaa'as deş,</para>
  <para style="q2" vid="PSA 15:4">Manbışin dobı ghalyaqa alyaat'as deş.<verse eid="PSA 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>Rəbb, zas ıkkanna saccu Ğu vorna,</para>
  <para style="q2" vid="PSA 15:5">Yizda ı'mı'r nəxübiy ı'lğəə Vake vod.<verse eid="PSA 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 15:6"/>İnekke yugun cigabı Ğu zas huvu,</para>
  <para style="q2" vid="PSA 15:6">Hək'ebab, zalqa gipxhına pay uftanna vuxha!<verse eid="PSA 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 15:7"/>Zas yəq haagvana Rəbb zı axtı qa'as,</para>
  <para style="q2" vid="PSA 15:7">Xəmdeb zı fıkır ooxhan,</para>
  <para style="q2" vid="PSA 15:7">nəxübna Ğu eyhəxüb ı'mı'r haa'as.<verse eid="PSA 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 15:8"/>Rəbb yizde k'ane ıxhay, zı mısacad yik'el hixan ha'a deş,</para>
  <para style="q2" vid="PSA 15:8">Zı mançil-allar mısacar qaçaxaras deş.<verse eid="PSA 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 15:9"/>Zı yik'eençe şadexhe vor,</para>
  <para style="q2" vid="PSA 15:9">Zı şadvalin xəybışeena xhinne ilexa vor,</para>
  <para style="q2" vid="PSA 15:9">Zasse qı'dərq'ı'n manzil haa'as vəəxə.<verse eid="PSA 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 15:10"/>Ğu zı ahalee g'alerçes deş,</para>
  <para style="q2" vid="PSA 15:10">Yiğna mu'mun Ğu nyuq'vnee qı'çes hassaras deş.<verse eid="PSA 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 15:11"/>Ğu zak'le ı'mı'r hoolena yəq haagu,</para>
  <para style="q2" vid="PSA 15:11">Yiğne k'ane zı geer şadra vor,</para>
  <para style="q2" vid="PSA 15:11">Yiğne xılen hammaşe zas yugun hele.<verse eid="PSA 15:11"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 17:1"/>Maq'amne xərıng'us. Rəbbine g'uluna, Davudna mə'niy. Rəbbee Davud gırgıne cune duşmanaaşineyiy Şaulne xılençe g'attixhan hı'ımee, Davudee Rəbbis ina mə'niy qəbəqqə:<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Rəbb, zas Ğu ıkkanna!</para>
  <para style="q2" vid="PSA 17:2">Ğu yizda guc vob.<verse eid="PSA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Rəbb yizda suva vobna,</para>
  <para style="q2" vid="PSA 17:3">yizda g'ala, zı g'attixhan ha'ana vorna.</para>
  <para style="q1" vid="PSA 17:3">Allah yizın ganz vodun,</para>
  <para style="q2" vid="PSA 17:3">Mang'usne zı dyugul ixhes.</para>
  <para style="q1" vid="PSA 17:3">Yizın g'alxan, zı g'attixhana'asda guc,</para>
  <para style="q2" vid="PSA 17:3">it'umun ciga Mana vor.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Şukur gyooxhane Rəbbilqa ona'as,</para>
  <para style="q2" vid="PSA 17:4">yizde duşmanaaşine xılençer g'attixhanasda.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Yizde hiqiy-alla gyabat'an torbı ıxha,</para>
  <para style="q2" vid="PSA 17:5">zı gek'ane damabışile zı qəyq'ən ıxha.<verse eid="PSA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Ahalın t'ü'bı zalqa alitk'ır ıxha,</para>
  <para style="q2" vid="PSA 17:6">gyapt'asde gugubışeqar zı girxhu ıxha.<verse eid="PSA 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Dağamiyvalee zı Rəbbilqa onuiyn,</para>
  <para style="q2" vid="PSA 17:7">Allah kumagıs qort'ul.</para>
  <para style="q1" vid="PSA 17:7">Mang'uk'le yizın ses Cune Xaa g'ayxhiyn,</para>
  <para style="q2" vid="PSA 17:7">yizın uts'ur Mang'une k'ıriysqa hitxhıriyn.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Mang'us qəl vuxhal-alla</para>
  <para style="q2" vid="PSA 17:8">ç'iye oyt'al, ı'ğiykaran,</para>
  <para style="q2" vid="PSA 17:8">suvabışin xhebbı ı'ğiykar, manbı hoyharanbı.<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>Mang'une quşeençe kuma qığeç'u,</para>
  <para style="q2" vid="PSA 17:9">ghalençe gyooxhan haa'an ts'a ı'xiyxə.</para>
  <para style="q2" vid="PSA 17:9">Mançikeb gyopxhanna ghadır k'yoohar.<verse eid="PSA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Mang'vee xəybı qaxı, ç'iyelqamee geç'ena.</para>
  <para style="q2" vid="PSA 17:10">Miç'axiyvalla Mang'une g'elybışik avub vuxha.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Sa keruvulil<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="fq" closed="false">Keruv: </char><char style="ft" closed="false">xılibınana malaaik vor.</char></note> alixı,</para>
  <para style="q2" vid="PSA 17:11">mıtsıne xılibışil ilexa.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Hiqiy-allan ciga xəmdilqa sak'al ha'a,</para>
  <para style="q2" vid="PSA 17:12">xhineka gyatsts'ıyne k'aarıne buludbışike Culqa aççesın kar ha'a.<verse eid="PSA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Mang'une nuruke buludbı ileedaxva,</para>
  <para style="q2" vid="PSA 17:13">Mang'uke dolu, gyotxhanan ts'a qı'ğəə ıxha.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>Rəbbee xəybı g'əhətqə'ə,</para>
  <para style="q2" vid="PSA 17:14">Haq'-Ta'aalee ses gyayhe,</para>
  <para style="q1" vid="PSA 17:14">dolu, gyotxhanan ts'a g'ıxele.<verse eid="PSA 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Vukbı avhu, duşmanar ehevkaa'anbı,</para>
  <para style="q2" vid="PSA 17:15">ts'ayılpan ı'xı'ı', manbı oot'al-ooxal haa'anbı.<verse eid="PSA 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 17:16"/>Ya Rəbb, Yiğne qəvəəq'ənasde sesıke,</para>
  <para style="q2" vid="PSA 17:16">quşeençene qı'ğəəne it'umne nafasıke,</para>
  <para style="q1" vid="PSA 17:16">deryahın k'oralybı g'ece giyğal,</para>
  <para style="q2" vid="PSA 17:16">dyunyeyn xhebbı g'ece giyğal.<verse eid="PSA 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 17:17"/>Mang'vee xəybışeençe xıl hotku, zı aqqı,</para>
  <para style="q2" vid="PSA 17:17">zı k'orane xhyanbışeençe qığavhu.<verse eid="PSA 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 17:18"/>Zı gucnane duşmanıke Mang'vee g'attixhan hı'ı,</para>
  <para style="q2" vid="PSA 17:18">zı g'ımece eyxhenbışike,</para>
  <para style="q2" vid="PSA 17:18">yizdemee geeb gucnanbışike g'attixhan hı'ı.<verse eid="PSA 17:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 17:19"/>Yizde pisde yiğıl manbı yizde ögiylqa qığeepç'ı,</para>
  <para style="q2" vid="PSA 17:19">Rəbbeeme zı aqqı.<verse eid="PSA 17:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 17:20"/>Mang'vee zı dağamiyvalike hixu'u,</para>
  <para style="q2" vid="PSA 17:20">zı ıkkiykın, zı g'attixhan hı'ı.<verse eid="PSA 17:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 17:21"/>Yizde qopkuvalis sik'ı Rəbbee zas huvu,</para>
  <para style="q2" vid="PSA 17:21">yizde xılene məttıvalis sik'ı huvu.<verse eid="PSA 17:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 17:22"/>Mang'vee məxüd hı'iyn, zı Rəbbina yəq' avquva,</para>
  <para style="q2" vid="PSA 17:22">pisda ıxha Allahılqa yı'q' sak'al hidi'ıva.<verse eid="PSA 17:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 17:23"/>Mang'un gırgın q'aanunbı yizde ögiyl vod,</para>
  <para style="q2" vid="PSA 17:23">Mang'une g'aydabışiler hixu deş.<verse eid="PSA 17:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 17:24"/>Zı Mang'une ögiyl məttıne yik'eka ıxha,</para>
  <para style="q2" vid="PSA 17:24">zıcar zı bınahıke havacına.<verse eid="PSA 17:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 17:25"/>Rəbbee yizde qopkuvalis sik'ı huvu,</para>
  <para style="q2" vid="PSA 17:25">Cune ulene ögiyl yizde məttıne işbışis sik'ı huvu.<verse eid="PSA 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 17:26"/>Ğu saadik'ranang'uka saadik'ra eyxhe,</para>
  <para style="q2" vid="PSA 17:26">kaamilinbışika kaamilyra vor.<verse eid="PSA 17:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 17:27"/>Məttınbışika məttıra,</para>
  <para style="q2" vid="PSA 17:27">quç'opkuriynbışika, cone quç'opkuriys sik'ı eyxhe.<verse eid="PSA 17:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 17:28"/>Hooç'an-g'ooç'ananbı Ğu g'attivxhan haa'a,</para>
  <para style="q2" vid="PSA 17:28">cocab-co axtıba vukkekanbışilqab Ğu ul giviyxhe,</para>
  <para style="q2" vid="PSA 17:28">manbı k'ap'ik'ıle avqa qaa'a.<verse eid="PSA 17:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 17:29"/>Rəbb, Ğu yizın işix qayhe,</para>
  <para style="q2" vid="PSA 17:29">Ğu yizda miç'axiyvalla nurulqa savaak'al haa'a.<verse eid="PSA 17:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 17:30"/>Zı Vakasana duşmanaaşikın ha'a,</para>
  <para style="q2" vid="PSA 17:30">yizde Allahıka şaharbı aqqaqqa.<verse eid="PSA 17:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 17:31"/>Allahna yəq kaamilyba vob,</para>
  <para style="q2" vid="PSA 17:31">Rəbbin cuvab məttıda vod!</para>
  <para style="q1" vid="PSA 17:31">Mang'ulqa yı'q' qizzırna gırgına,</para>
  <para style="q2" vid="PSA 17:31">Mang'vee g'attixhan ha'ana.<verse eid="PSA 17:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 17:32"/>Rəbbile ğayrı, Allah vuşune vor?</para>
  <para style="q2" vid="PSA 17:32">Yişde Allahıle ğayrı, medın ganz nenne vod?<verse eid="PSA 17:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 17:33"/>Allahee zas dəv'ee guc hoole,</para>
  <para style="q2" vid="PSA 17:33">Mang'vee yizda yəq qopku qaa'a.<verse eid="PSA 17:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 17:34"/>Mang'vee yizın g'elybı maralın g'elybı xhinne ek' qa'a,</para>
  <para style="q2" vid="PSA 17:34">Zı axtıvalee it'umra aqqaqqa.<verse eid="PSA 17:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 17:35"/>Mang'vee yizın xıleppı dəv'əysın xhinne qa'a,</para>
  <para style="q2" vid="PSA 17:35">zasse tuncıke hı'iyn vuk quç'okara'as əxən.<verse eid="PSA 17:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 17:36"/>Ğu zas g'attixhana'asın g'alxan huvu,</para>
  <para style="q2" vid="PSA 17:36">Yiğne sağne xılen zı aqqaqqana.</para>
  <para style="q1" vid="PSA 17:36">Ğu hı'iyne kumaagıka zı axtı qı'ı.<verse eid="PSA 17:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 17:37"/>Zasse saccu Vaka əq'ra iykaras əxə,</para>
  <para style="q2" vid="PSA 17:37">zı məxür qaçayxarır deş.<verse eid="PSA 17:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 17:38"/>Zı duşmanaaşiqa qihna girxhu, manbışiqa avarq'ılyna,</para>
  <para style="q2" vid="PSA 17:38">manbışikın ixhesmee yı'q'əlqar sak'ı deş.<verse eid="PSA 17:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 17:39"/>Zı manbı hööq'əv'u ç'əvxhana,</para>
  <para style="q2" vid="PSA 17:39">manbışisse suğoots'asıb vəvxü deş.<verse eid="PSA 17:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 17:40"/>Dəv'əynemee Ğu zalqa guc alipk'ır,</para>
  <para style="q2" vid="PSA 17:40">zalqa g'elil qeepxhaynbı Ğu yizde g'eliqqa huvu.<verse eid="PSA 17:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 17:41"/>Duşmanar zale heepxasınbı xhinne qaa'a,</para>
  <para style="q2" vid="PSA 17:41">zı g'ımecenanbışikınıd zı hı'iyn.<verse eid="PSA 17:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 17:42"/>Manbışe kumagıs qopt'uleeyib,</para>
  <para style="q2" vid="PSA 17:42">manbı g'attivxhan haa'anbı vuxha deş,</para>
  <para style="q1" vid="PSA 17:42">Rəbbilqa onu'eeyid, Mang'vee alidghıniy quvu deş.<verse eid="PSA 17:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 17:43"/>Zı manbı k'ööq'ü, tooz xhinne qav'u,</para>
  <para style="q2" vid="PSA 17:43">mıtsınıb manbı inyaqa-şaqa dağav'u.</para>
  <para style="q2" vid="PSA 17:43">Zı manbı şahrabışeedın battağ xhinneeyib hööq'üynbı.<verse eid="PSA 17:43"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 17:44"/>Ğu zı, yizde milletne g'elil qeepxhayke g'attixhan hı'ı,</para>
  <para style="q2" vid="PSA 17:44">zake milletbışda xərna hı'ı,</para>
  <para style="q2" vid="PSA 17:44">zak'le dyats'ancad milletbı yizde xılyaqa quvu.<verse eid="PSA 17:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 17:45"/>Menne cigeençenbı yizde ögiyl k'yoozarav'uynbı,</para>
  <para style="q2" vid="PSA 17:45">yizın do g'ayxhımee, eyhen ha'a.<verse eid="PSA 17:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 17:46"/>Menne cigeençenbı yizde ögiyl hapq'ıriynbı.</para>
  <para style="q2" vid="PSA 17:46">Qəpq'ı'n zezebı atk'u,</para>
  <para style="q2" vid="PSA 17:46">dyuguleepxhayne cigeençe qığeepç'iynbı.<verse eid="PSA 17:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 17:47"/>Rəbb vorna! Yizde Ganzıs şukur vuxhena!</para>
  <para style="q2" vid="PSA 17:47">Zı g'attixhan hı'iyn Ganz, Allah, axtı qe'e!<verse eid="PSA 17:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 17:48"/>Allahee zal-alla qəl qığaaha,</para>
  <para style="q2" vid="PSA 17:48">milletbı yizde xılyaqa qele.<verse eid="PSA 17:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 17:49"/>Mang'vee zı yizde duşmanaaşine xılençe g'attixhan ha'a,</para>
  <para style="q2" vid="PSA 17:49">Mang'vee zı yizde duşmanaaşile ooqana ha'a,</para>
  <para style="q2" vid="PSA 17:49">Zı eb ulyooğanbışde xılençe g'attixhan hı'ı.<verse eid="PSA 17:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 17:50"/>Rəbb, mançil-alla zı Ğu menne milletbışde yı'q'nee axtı qa'as,</para>
  <para style="q2" vid="PSA 17:50">zı Yiğne doyus şukur haa'as!<verse eid="PSA 17:50"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 17:51"/>Allahee Cune paççahıs xədın ğamxhaybı heles,</para>
  <para style="q2" vid="PSA 17:51">g'əyxı'yne Davudne nasıles gırgıne gahbışilycab yugvalla haagvas.<verse eid="PSA 17:51"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">Allahee havacena</para>
  <para style="d">Maskil<note caller="+" style="f"><char style="fr" closed="false">31:0 </char><char style="fq">Maskil:</char> İne cuvabın cühüt'yaaşine mizel in mə'nabıd hele eyxhe: «ats'al, mı'sləhət», «uftanba gipk'ınna mə'niy».</note>, Davudna mə'niy.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>Şavunbıyiy bınahbı Rəbbe yik'elixanı'ı,</para>
  <para style="q2" vid="PSA 31:1">Şavunbıyiy qotkuda hidi'iyn harakatbı hakkal hı'ı, nimee baxtivariy!<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Cuna bınah dyugulydyaa'ana,</para>
  <para style="q2" vid="PSA 31:2">Rəbb bınahılee ilheç'una insan, nimee baxtivariy!<verse eid="PSA 31:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 31:3-4"/>Gardanaqa alyat'asmee zı əvəray hav'u.</para>
  <para style="q2" vid="PSA 31:3-4">Yiğbına, xəmbına Yiğna yı'q'na xıl zal oğa vuxha.</para>
  <para style="q1" vid="PSA 31:3-4">Yizda guç g'apt'ına g'ı'liyne pırane yiğıl qəhətxhayn çiy xhinne.</para>
  <para style="q2" vid="PSA 31:3-4">Ik'arang'an xhineyid yizın bark'vbıd rı'hı'le g'a'atk'u.<verse eid="PSA 31:3-4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Manke zı bınah Yiğne ögiyl gardanaqa alyapt'ına,</para>
  <para style="q2" vid="PSA 31:5">Yizın qotkuda hidi'iy Vale dyugul hı'ı deş.</para>
  <para style="q1" vid="PSA 31:5">Qiyğa zı uvhuyn: «Zı bınahbı Rəbbine ögiyl gardanaqa alyat'anbı»,</para>
  <para style="q2" vid="PSA 31:5">Ğunar yizde bınahıle ilheç'una.<verse eid="PSA 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Mançil-allab Yiğna yəq avquyng've,</para>
  <para style="q2" vid="PSA 31:6">Ğu iveekemee Valqa düə hee'ecen.</para>
  <para style="q1" vid="PSA 31:6">Məhrıng'uk xədın xhyanbıd qadıyng'a set'as deş.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Zı dyugulexhen ciga Ğu vorna,</para>
  <para style="q2" vid="PSA 31:7">Ğu zı dağamiyvalike g'attixhan ha'as,</para>
  <para style="q2" vid="PSA 31:7">Ğamxhayn şadvalin mə'niybı, Ğu yizde hiqiy-alla alik'ara'a.<verse eid="PSA 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 31:8-9"/>Ğu eyhen: «Balkaniy g'atir xhinne ək'el kamba mexhe,</para>
  <para style="q2" vid="PSA 31:8-9">Manbı salbaniy g'antarağa dena</para>
  <para style="q2" vid="PSA 31:8-9">Ğu eyhençilqa qalya'as əxə deş.</para>
  <para style="q1" vid="PSA 31:8-9">Zı vas ək'el hevles,</para>
  <para style="q2" vid="PSA 31:8-9">Ğu əlyhəəsda yəq haagvas.</para>
  <para style="q1" vid="PSA 31:8-9">Zı ğu hot'alasda,</para>
  <para style="q2" vid="PSA 31:8-9">Yizda ul val vobna».<verse eid="PSA 31:8-9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Yəq avguynbışde vuk'lelqa xətta divanbı adaylenbı,</para>
  <para style="q2" vid="PSA 31:10">Rəbbir culqa umud ha'anbışiqa</para>
  <para style="q2" vid="PSA 31:10">Hammaşee yugra eyxhena.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Qopkuyn insanar, vuşda şadvalla Rəbbil-alla vuxhecen.</para>
  <para style="q2" vid="PSA 31:11">Yik' məttınbı, şadvalina mə'niy Rəbbinimee qəpqe.<verse eid="PSA 31:11"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">89</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 89:1"/>Allahne insanna Mısayna düə<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Nimee nasılbı badaledxheyid,</para>
  <para style="q2" vid="PSA 89:2">Xudaavanda, şi Valqa yı'q' qizzır.<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Suvabıyiy ç'iyeyn aq'va, dyunye ixhanassecad Ğu Allah ıxha,</para>
  <para style="q2" vid="PSA 89:3">Gırgıne gahbışilır Allahcar ixhes.<verse eid="PSA 89:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>Ğu insanar nyuq'nelqa savaak'al haa'a.</para>
  <para style="q2" vid="PSA 89:4">Ğu manbışik'le eyhen: «Aadamın dixbı, nyuq'nelqa savk'le».<verse eid="PSA 89:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>Yiğne ulesqa aazır sen, sa ılğeç'uyn yiğ xhinne,</para>
  <para style="q2" vid="PSA 89:5">Xəmdiyna sa-q'öble sə'ət xhinne qadayle.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Selin xhinne Ğu insanar vukkeka,</para>
  <para style="q2" vid="PSA 89:6">Manbı nyak' xhinne qabı avayk'an.</para>
  <para style="q1" vid="PSA 89:6">Manbı miç'eeb alyabıyne ok'uk akar:</para>
  <para style="q2" vid="PSA 89:6">miç'eeb k'atele qooxhe t'et'-t'ele g'ayhe,</para>
  <para style="q2" vid="PSA 89:6">xəmdemee hı'ç'ı'bğı'n, qooqqana.<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Yiğne qəlan şi gyabat'anbı,</para>
  <para style="q2" vid="PSA 89:7">Vaqa qəlnang'a şi nyaqame vuxhesınbı aaxva.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>Yişin taxsirbı Vak'le ats'a,</para>
  <para style="q2" vid="PSA 89:8">Yişde dyugulene bınahbışilqa Yiğne aq'vayn nur gexha.<verse eid="PSA 89:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Ğu qəllamışxheene yişda ı'mı'r cit'a qooxhe.</para>
  <para style="q2" vid="PSA 89:9">Yişin senbı ul gyapxı aaqasse ılğeeç'enbı.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Şi yights'al (70) sennana ı'mı'r haa'a,</para>
  <para style="q2" vid="PSA 89:10">Vuk'diyk'ıree molyts'aleeqab (80) hiviyxharanbı.</para>
  <para style="q1" vid="PSA 89:10">Mane senbışin g'ellesınbıd dağamiyvalee, ı'k'aree ı'lğəə,</para>
  <para style="q2" vid="PSA 89:10">Yişda ı'mı'r zarabacab ç'əvooxhena, alivxu avayk'an.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Şavuk'lene Yiğne qəlına guc vaats'a?</para>
  <para style="q2" vid="PSA 89:11">Vale nimeeyiy qəvəyq'ən,</para>
  <para style="q2" vid="PSA 89:11">Vaqa manimeenab qəl vob.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>I'mı'r cit'aba vuxhay şas yik'el qale'e,</para>
  <para style="q2" vid="PSA 89:12">Şi ək'elika vuxhes.<verse eid="PSA 89:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Ya Rəbb, şasqa sak'le! Nimeene gahnane inəxüd ixhes?</para>
  <para style="q2" vid="PSA 89:13">Yiğne g'ulaaşis rəhı'm hee'e!<verse eid="PSA 89:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Şi gırgıne gahbışil şadba vuxhecenva,</para>
  <para style="q2" vid="PSA 89:14">Miç'eeb şalqa Yiğna yugvalla gyooğee'e.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Şalqa ver ablyav'uyn yiğbımee,</para>
  <para style="q2" vid="PSA 89:15">Balyaa ablyav'uyn senbımee, şi şad hee'e.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Ğu hı'iynbı Yiğne g'ulaaşik'le,</para>
  <para style="q2" vid="PSA 89:16">Yiğna xəbvallab cone uşaxaaşik'le g'avcecen.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Ay Xudaavanda yişda Allah, şaqa yugra ixhe,</para>
  <para style="q2" vid="PSA 89:17">Yişde xılen hı'iynçis baraka hevle,</para>
  <para style="q2" vid="PSA 89:17">Hucoone ixhes, yişde xılen hı'iynçis baraka hevle.<verse eid="PSA 89:17"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">Allahee qopkuyne insanaaşis xayir-düə hoole</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Rəbbilqa şukur hee'e!</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">Nimee baxtivariy Rəbbile qəyq'ənna,</para>
  <para style="q2" vid="PSA 111:1">Mang'un əmrbı yik'eençe ha'ana!<verse eid="PSA 111:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>Qəyq'anang'un uşaxar ç'iyeyne aq'val gucuka vuxhes,</para>
  <para style="q2" vid="PSA 111:2">Qopkuyng'unbışde uşaxaaşeeb xayir-düə alyapt'as.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Qopkuynbı karnanbı, barakatnanbı vuxhes,</para>
  <para style="q2" vid="PSA 111:3">Manbışda qopkuvalla, mısacab aagvales deş.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Miç'axiyvaleeyid qopkuynbışdemee nur ixhes,</para>
  <para style="q2" vid="PSA 111:4">Manbı yugun, rəhı'mıkan, qopkuyn insanar vob.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Qidiykkın borcbı helenbışiqayiy horbı hidya'anbışiqa</para>
  <para style="q2" vid="PSA 111:5">yugna ı'mı'r vuxhes.<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Məxbın insanar mısacab qaçaaxaras deş,</para>
  <para style="q2" vid="PSA 111:6">Qopkuyn insanar hammaşe yik'bışee aaxvas.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Manbı pisde xabarıle qəvəəq'ənas deş,</para>
  <para style="q2" vid="PSA 111:7">Rəbbilqa qibzırva manbışin yik'bı it'umda ixhes.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Manbışin yik'bı it'umda vod, manbı qəvəəq'ənas deş,</para>
  <para style="q2" vid="PSA 111:8">Manbışik'le con duşmanar avub aaxva g'avces.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Manbışe con var-devlet, kar deşinbışis qidiykkın bit'al hı'ı,</para>
  <para style="q2" vid="PSA 111:9">Manbışda qopkuvallab hammaşiys aaxvas,</para>
  <para style="q1" vid="PSA 111:9">Manbışde gucus geeb hı'rmat gyuvxhes.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>Karaı'dəəne insanık'le man g'acu qəl vuxhes,</para>
  <para style="q2" vid="PSA 111:10">Manbışe mizyar ats'ak'vanas, əəq'əsınbı.</para>
  <para style="q1" vid="PSA 111:10">Manbışis ıkkananbı ixhes deş.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">Rəbbik Allahık akarna vornane?</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Rəbbilqa şukur hee'e!</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">Rəbbin nukarar, şukur hee'e,</para>
  <para style="q2" vid="PSA 112:1">Rəbbine doyus şukur hee'e!<verse eid="PSA 112:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>G'iyniyke şaqa, gırgıne gahbışis</para>
  <para style="q2" vid="PSA 112:2">Rəbbin do axtı qe'e!<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Şargıle garbılqamee</para>
  <para style="q2" vid="PSA 112:3">Rəbbine doyus şukur hee'e!<verse eid="PSA 112:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Rəbb gırgıne milletbışile axtıra vor,</para>
  <para style="q2" vid="PSA 112:4">Mang'una xəbvallab xəybışileb axtıba vob!<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Axtıne xəybışeene taxtıl gyu'urne,</para>
  <para style="q2" vid="PSA 112:5">Yişde Rəbbik Allahık akarna vornane?<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Xəəqə, ç'iyeyqa</para>
  <para style="q2" vid="PSA 112:6">K'yorzul ilyakkana Mana vor.<verse eid="PSA 112:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Mang'vee vuççud deşda, toozençe suğoots'a'a,</para>
  <para style="q2" vid="PSA 112:7">Goreençena fağırır axtı qa'a,<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Manbı cone milletne ç'ak'ınbışika,</para>
  <para style="q2" vid="PSA 112:8">Sacigee gyuv'ar haa'asva.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Mang'vee uşax dexhene xhunaşşeys uşaxar hoole,</para>
  <para style="q2" vid="PSA 112:9">Məxür məng'ı'ke baxtivarna yed hee'e.</para>
  <para style="b" vid="PSA 112:9"/>
  <para style="q1" vid="PSA 112:9">Rəbbilqa şukur hee'e!<verse eid="PSA 112:9"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">Rəbbis şukur hee'e!</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Rəbbis şukur hee'e!</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">Muq'addasne Cune cigee</para>
  <para style="q2" vid="PSA 150:1">Allahıs şukur hee'e!</para>
  <para style="q1" vid="PSA 150:1">Mang'vee Cuna guc</para>
  <para style="q2" vid="PSA 150:1">xəybışeene taxtıl haagva.</para>
  <para style="q2" vid="PSA 150:1">Mang'us şukur hee'e!<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Ç'ak'ıne işbışil-alla</para>
  <para style="q2" vid="PSA 150:2">Mang'us şukur hee'e!</para>
  <para style="q1" vid="PSA 150:2">Ç'əvcab dyooxhene Mang'une xəbvalis sik'ı</para>
  <para style="q2" vid="PSA 150:2">Mang'us şukur hee'e!<verse eid="PSA 150:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Gaçeençe<note caller="+" style="f"><char style="fr" closed="false">150:3 </char><char style="fq" closed="false">Gaç: </char><char style="ft" closed="false">İzrail ts'erna paççah taxtıl gyu'urva, gaçeençe syuty haa'a vuxha.</char></note> qı'ğəəne seseka</para>
  <para style="q2" vid="PSA 150:3">Mang'us şukur hee'e!</para>
  <para style="q1" vid="PSA 150:3">Arfaykayiy, lirayka</para>
  <para style="q2" vid="PSA 150:3">Mang'us şukur hee'e!<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>Dafıka, mık'ar ha'a-ha'a,</para>
  <para style="q2" vid="PSA 150:4">Mang'us şukur hee'e!</para>
  <para style="q1" vid="PSA 150:4">Sazıka, dyuttyak'ıka</para>
  <para style="q2" vid="PSA 150:4">Mang'us şukur hee'e!<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>İt'umda ses qı'ğəəne</para>
  <para style="q2" vid="PSA 150:5">naq'rabışde seseka</para>
  <para style="q2" vid="PSA 150:5">Mang'us şukur hee'e!</para>
  <para style="q1" vid="PSA 150:5">G'avayghane sesnane naq'rabışika</para>
  <para style="q2" vid="PSA 150:5">Mang'us şukur hee'e!<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Nafas hıxelen gırgınbı</para>
  <para style="q2" vid="PSA 150:6">Rəbbis şukur hee'e!</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">Rəbbis şukur hee'e!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
