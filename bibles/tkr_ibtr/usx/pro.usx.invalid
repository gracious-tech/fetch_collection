<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">– Tsakhur</book>
  <para style="toc3">Sıl.</para>
  <para style="toc2">Sıleymanın uvhiybı</para>
  <para style="toc1">Sıleyman peyğambarın k'oran uvhiybı</para>
  <para style="mt1">Sıleyman peyğambarın k'oran uvhiybı</para>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>Hikmətılqa hirxhılyna,</para>
  <para style="q2" vid="PRO 3:13">K'orana ək'el avaykına insan nimee baxtivariy!<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>Mançiken xayir nuk'rayle geed vod,</para>
  <para style="q2" vid="PRO 3:14">İn g'azanc məttıne k'ınəəğəyle q'iymatıka vod.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Mana gıranne ekebışileb gıranba vob,</para>
  <para style="q2" vid="PRO 3:15">Mançika vas ıkkanan nencad kar sa aqqas dexhe.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Mançine sağne xılen xıliyna ı'mı'r,</para>
  <para style="q2" vid="PRO 3:16">Solne xılenıd var-devletiy şöhrat hele ıxha.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Mançin yəqbı q'abıledaxhenbı vod,</para>
  <para style="q2" vid="PRO 3:17">Gırgın yəqbı əmin-amanınbı<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fq">Əmin-amanınbı:</char> yiqsumul in cuvab «nübəhı'nbı» vod.</note> vod.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>At'ipq'ı'ninbışdemee mana ı'mrena yivobna,</para>
  <para style="q2" vid="PRO 3:18">Mançike it'umba alyt'ipq'ıninbı nimee baxtivarariy!<verse eid="PRO 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>Rəbbee dyunye hikmətıka itxhın,</para>
  <para style="q2" vid="PRO 3:19">K'orane ək'elika xəybı hı'ı,<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>Ats'aalika k'oralybışençe xhyan alqavhu,</para>
  <para style="q2" vid="PRO 3:20">Xəybışençe çiy gyuarı'ı.<verse eid="PRO 3:20"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Sirkayn silibışik, kumayn uleppışik ha'an,</para>
  <para style="q2" vid="PRO 10:26">Tambalee iş hooleng'uk ha'a.<verse eid="PRO 10:26"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Var-devletılqa umudeepxhaynbı k'yooçesınbı,</para>
  <para style="q2" vid="PRO 11:28">Qopkıynbıb t'et'-t'ele g'ayhene yivaaşik akaraba vuxhes.<verse eid="PRO 11:28"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Yugna xhunaşşe adamiyn tac vodun,</para>
  <para style="q2" vid="PRO 12:4">Tesser ha'anar vuk'arne bark'uk akar.<verse eid="PRO 12:4"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Bəç'əree qəl zaraba h'aagva,</para>
  <para style="q2" vid="PRO 12:16">Ək'elikang'un rı'h tsimis qexhen deş.<verse eid="PRO 12:16"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Nəxüd qadıy uvhuynçin ç'ik'ayn xhinne g'ats'ayk'van,</para>
  <para style="q2" vid="PRO 12:18">K'orane ək'elika uvhuynçinıd yug qaa'a.<verse eid="PRO 12:18"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Ghal sı'ına geer axhvas,</para>
  <para style="q2" vid="PRO 13:3">Sidi'ınar ek'ra haq'varas.<verse eid="PRO 13:3"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Yats deşdang'a axur məttıba vooxhe,</para>
  <para style="q2" vid="PRO 14:4">Yugun g'ıkıd yatsbışde taq'atınxhe helen.<verse eid="PRO 14:4"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>G'üvənana miz ı'mrena yiv vobna,</para>
  <para style="q2" vid="PRO 15:4">Horarlynançinıd yik' haq'vara'an.<verse eid="PRO 15:4"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Mühübbatıka xhınakın ala otxhuniy,</para>
  <para style="q2" vid="PRO 15:17">Qəlıka boğayn çuru otxhuniyle yugda vod.<verse eid="PRO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Qəlnang'vee g'almag'al haa'a,</para>
  <para style="q2" vid="PRO 15:18">Sabırnang'vee ç'əv haa'a.<verse eid="PRO 15:18"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>T'ap'anedın itv xhinne uftanna yuşe,</para>
  <para style="q2" vid="PRO 16:24">Canas yugba, rı'hı's ittuba.<verse eid="PRO 16:24"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Gucnang'ule sabırnana yugra,</para>
  <para style="q2" vid="PRO 16:32">Şaharbı alyaat'ang'uler vuc aqqaqqana yugra.<verse eid="PRO 16:32"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Saç'uvkiy deşda qit'ipk'ınna xüvə,</para>
  <para style="q2" vid="PRO 17:1">Saç'uvkiynane otxhun-ulyodğuyle ittuba vob.<verse eid="PRO 17:1"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Hambaz ıkkanang'vee qəl yik'elivxanaa'ana,</para>
  <para style="q2" vid="PRO 17:9">Yik'el qavaalya'ang'vee hambaz agval ha'ana.<verse eid="PRO 17:9"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Hambazıs hammaşe ıkkiykanna,</para>
  <para style="q2" vid="PRO 17:17">Çocur dağamne yiğıs iyxhanna.<verse eid="PRO 17:17"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Karnanbışisqa həməxüd q'öö, con kar axtıne barugbışika</para>
  <para style="q2" vid="PRO 18:11">alyav'una g'alaniyxan.<verse eid="PRO 18:11"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Tsimisna çoc – alyapt'as dyooxhene g'alayk akar,</para>
  <para style="q2" vid="PRO 18:19">Aldapxhıniybıd – akkalne rızayk.<verse eid="PRO 18:19"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Xaviy var-devlet dekkına miras vobna,</para>
  <para style="q2" vid="PRO 19:14">Ək'elikana xhunaşşer Rəbbikena.<verse eid="PRO 19:14"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Tambale ezang'a ezu deş,</para>
  <para style="q2" vid="PRO 20:4">Sa'anang'ad avaykı deş.<verse eid="PRO 20:4"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Siç'eekvane xhunaşşeyka sa xaa axvasse,</para>
  <para style="q2" vid="PRO 21:9">Daxayne vuttul axvee yugda eyxhe.<verse eid="PRO 21:9"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Hı'rmat nuk'rayleyiy-k'ınəəğəyle geeb vukkiykne,</para>
  <para style="q2" vid="PRO 22:1">Yugun doyud xənne var-devletıle geed ikkiykne.<verse eid="PRO 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Karnanayiy kar deşda sana-sang'uk akar -</para>
  <para style="q2" vid="PRO 22:2">Q'öyursanar Rəbbee ipxhın.<verse eid="PRO 22:2"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Ts'eppacab uşaxık'le qopkuna yəq haagve,</para>
  <para style="q2" vid="PRO 22:6">Q'əsvaleyir mana mançile sak'alas deş.<verse eid="PRO 22:6"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Kar kılydanang'uka gucub kı'lybava g'ımeşşe,</para>
  <para style="q2" vid="PRO 22:22">Kasibrava məhkamee himeşşe.<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>Rəbb alikkas manbışil-alla,</para>
  <para style="q2" vid="PRO 22:23">Manbı g'yootuynbı, hivşuynbı Rəbbee ı'mreke haa'as.<verse eid="PRO 22:23"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Xətta kar ha'asva ğucar ğu gimek'a.</para>
  <para style="q2" vid="PRO 23:4">Ək'elika ixhe, mane fıkrele ılğeç'e.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Var-devlet ul gyapxasse deşxhesın,</para>
  <para style="q2" vid="PRO 23:5">Q'acır xhinne xılibı aaqı xəybışeeqa alixasın.<verse eid="PRO 23:5"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Tambalne ekıneençe</para>
  <para style="q2" vid="PRO 24:30">G'anmazne t'ımıllığeençe ılğeç'u.<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>G'acuyn gırgın sura zazaanıd aalyat'u,</para>
  <para style="q2" vid="PRO 24:31">Mağaanıd aqqı, cabırbıd hı'ğətkırıd.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Mançika ilyakkı fıkır opxhun,</para>
  <para style="q2" vid="PRO 24:32">Mançike ı'brat aalyat'u:<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>Sık'ırra qorku mırg he'ee,</para>
  <para style="q2" vid="PRO 24:33">G'el-xıl hotku g'alirxhvee,<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>Kasibiyvalla soyğunçiy xhinne,</para>
  <para style="q2" vid="PRO 24:34">Ehtiyaccıb g'uldur xhinne sayangaba ooqa hophur ables.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Cigal uvhuyn cuvab,</para>
  <para style="q2" vid="PRO 25:11">nuk'rayne g'abılyne k'ınəəğəyne eçeeşik akar.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Paççahnab fıkır sabırnang'vee badal haa'ana,</para>
  <para style="q2" vid="PRO 25:15">İttune mizen bark'ub g'üvana qaa'ana.<verse eid="PRO 25:15"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Xıl hudyoolena dağamne yiğıl</para>
  <para style="q2" vid="PRO 25:19">Qiçiyne siliykiy k'aane g'elik akar.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Duşman mıssıraxhee, oxhanasın hele,</para>
  <para style="q2" vid="PRO 25:21">Xhyan ıkkanxhee, ulyoğasın hele.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Məxüd ğu mang'us naş qa'as,</para>
  <para style="q2" vid="PRO 25:22">Yiğna yugvallab Rəbbee savaak'al haa'as.<verse eid="PRO 25:22"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Qəl avqas dəxəna insan,</para>
  <para style="q2" vid="PRO 25:28">Cabırbı hı'ğətkırne şaharık akar.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Nəxüdiy osake ts'a eyxhe,</para>
  <para style="q2" vid="PRO 26:21">Ğiybatnang'ukeb g'almag'al vooxhe.<verse eid="PRO 26:21"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Hambazın yik' aliq'alı'iy,</para>
  <para style="q2" vid="PRO 27:6">Duşmanne geedne ubbabışile yugun vodun.<verse eid="PRO 27:6"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="rem">Lemuel donane paççahee uvhuynbı</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Lemuel donane paççahee uvhuynbı, yedee mang'us xət qıiyn cuvab. <verse eid="PRO 31:1"/><verse number="2" style="v" sid="PRO 31:2"/>Hucoona zı eyhes dix, zı uxuna dix, Düəbışika heeqqına dix? <verse eid="PRO 31:2"/><verse number="3" style="v" sid="PRO 31:3"/>Guc zəiyfabışis hımoole, Yiğın yəqbı paççahaaşikın ha'anbışik'le hımagva. <verse eid="PRO 31:3"/><verse number="4" style="v" sid="PRO 31:4"/>Lemuel, çaxır ulyoduy paççahaaşik avaakı deş, P'iyan haa'an ulyodğuy ıkkiykıniy vuk'lek vukkekkanbışik avaak'ı deş. <verse eid="PRO 31:4"/><verse number="5" style="v" sid="PRO 31:5"/>Ulyodğumee q'aanunxhe yik'el hiviyxan, Manbışe kar deşinbı hək' dena g'alyaa'as. <verse eid="PRO 31:5"/><verse number="6" style="v" sid="PRO 31:6"/>P'iyan haa'an ulyodğuy mançika qek'ang'us , Çaxırıd ver abıyng'us hele. <verse eid="PRO 31:6"/><verse number="7" style="v" sid="PRO 31:7"/>Hasre ulyodğu kar deşiyvalla yik'el hivxan hee'ecen, Culqa abına ver sayıb yik'el qavaal hımaa'acen. <verse eid="PRO 31:7"/><verse number="8" style="v" sid="PRO 31:8"/>Miz deşing'ul-alla ghal eeqe, Guc deşinbışda hək' avqe. <verse eid="PRO 31:8"/><verse number="9" style="v" sid="PRO 31:9"/>Ghal eeqe, qotkuyn eyhe, Kar deşinbışda, fağıraaşina hək' qevle. (Yugun ha'ana xhunaşşe) <verse eid="PRO 31:9"/><verse number="10" style="v" sid="PRO 31:10"/>Yugna xhunaşşe aveekına vuşune? Gıranne g'ayebışile mana gıranna vor. <verse eid="PRO 31:10"/><verse number="11" style="v" sid="PRO 31:11"/>Adamiyn yik' məng'ı'le arxayında vod, Mana məng'ı'ka barakat dena axvas deş. <verse eid="PRO 31:11"/><verse number="12" style="v" sid="PRO 31:12"/>I'mı'r volle adamiys pisın deş, yugun ha'as, <verse eid="PRO 31:12"/><verse number="13" style="v" sid="PRO 31:13"/>Xhayiy katan məng'ee g'əyxə, Xılençe yugda gırgın qöö. <verse eid="PRO 31:13"/><verse number="14" style="v" sid="PRO 31:14"/>Kar alişşu-massa helene gamibışik akar, Cesın oxhanasın kar əq'ənançe adayle. <verse eid="PRO 31:14"/><verse number="15" style="v" sid="PRO 31:15"/>Miç'axdanang'acar mana muğur qeexhe, Xizanısın oxhanasın otxhuniy ha'a, Həmbalaaşisda iş hoole. <verse eid="PRO 31:15"/><verse number="16" style="v" sid="PRO 31:16"/>Çoluka ilyakkiyle qiyğa çol ileşşe, Xılene əq'übayka bağ adaççe. <verse eid="PRO 31:16"/><verse number="17" style="v" sid="PRO 31:17"/>İş məng'ee geeb haa'a, Məng'ı'na guc cene işis g'iviyxharna. <verse eid="PRO 31:17"/><verse number="18" style="v" sid="PRO 31:18"/>Məng'ı'lqa kar alişşu-massa huvuyna ittulla hipxhırna, Xəmdeb məng'ı'na bazir k'əbəqqə deş. <verse eid="PRO 31:18"/><verse number="19" style="v" sid="PRO 31:19"/>Xıleka xha g'oodan kar iliyk'ar,)) <verse eid="PRO 31:19"/><verse number="20" style="v" sid="PRO 31:20"/>Kar deşing'unemee məng'ee xıl aaqa, Fağıraaşis xıl avqaaqqa. <verse eid="PRO 31:20"/><verse number="21" style="v" sid="PRO 31:21"/>Yiz gyuoğang'ad mana cune xizannemee q'əyq'ən deş, Məng'ı'ne xizanne gırgınbışe ç'əran kar ali'ı. <verse eid="PRO 31:21"/><verse number="22" style="v" sid="PRO 31:22"/>Yic g'ileexhane tyuliys aq'vabı iyxhva, Məng'ee yicee k'ışşeyn ç'əran katanın kar alya'a. <verse eid="PRO 31:22"/><verse number="23" style="v" sid="PRO 31:23"/>Adamiy məng'ı'na şaharne akkabışisnee yugra ats'a, Milletne ağsaqqalaaşika gyu'ur-oza qexhe. <verse eid="PRO 31:23"/><verse number="24" style="v" sid="PRO 31:24"/>Məng'ee zəiyfabışis ts'irabı, Yicee iyxuyn katanıken tanalinbı massa hele. <verse eid="PRO 31:24"/><verse number="25" style="v" sid="PRO 31:25"/>(--) <verse eid="PRO 31:25"/><verse number="26" style="v" sid="PRO 31:26"/>Mana k'orane ək'elika yuşan hee'e, Məng'ı'ne mizel vukkiykıniy yugvalla vob. <verse eid="PRO 31:26"/><verse number="27" style="v" sid="PRO 31:27"/>Xizanne işbışika mana ileeka, Tanbalıs avaak'iyn gıney oyxhan deş. <verse eid="PRO 31:27"/><verse number="28" style="v" sid="PRO 31:28"/>Uşaxar oza qeepxha məng'ı's gappar ha'a, Adameeyib məng'ı'na yugna gaf haa'a: <verse eid="PRO 31:28"/><verse number="29" style="v" sid="PRO 31:29"/>"Yugun zəiyfabı geeb vob, Vaka sa ayqasdame deşda". <verse eid="PRO 31:29"/><verse number="30" style="v" sid="PRO 31:30"/>Zəiyfayna yugvallayiy micagiyvalla horbışikan kar vod, Saccu Rəbbile qiyeeq'ənne zəiyfayk'le yugun eyhes eyxhe. <verse eid="PRO 31:30"/><verse number="31" style="v" sid="PRO 31:31"/>Məng'ı's gyooxhana hək' qevle, Hasre məng'ı'n işbı şaharne akkabışisnee ələtqecen.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
