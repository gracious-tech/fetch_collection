<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id">– Tsakhur</book>
  <para style="toc3">Mə'əll.</para>
  <para style="toc2">Mə'əllim</para>
  <para style="toc1">Mə'əllimın kitab</para>
  <para style="mt1">Mə'əllimın kitab</para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s">Gırgın q'əran vuççud deşin kar vodun</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1"/>İna gaf Mə'əllimee, İyerusalimee paççahiyvalla hav'uyne, Davudne dixee hav'u.<verse eid="ECC 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 1:2"/>Mə'əllimee eyhen:</para>
  <para style="q1" vid="ECC 1:2">– Q'əran vuççud deşin kar!</para>
  <para style="q1" vid="ECC 1:2">Q'əran vuççud deşin kar!</para>
  <para style="q1" vid="ECC 1:2">Gırgın ıxha-ayk'anne booğak akar vod!<verse eid="ECC 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3"/>İnsanıs verığne avur qorxuyke</para>
  <para style="q2" vid="ECC 1:3">hucoona hiyxhar?<verse eid="ECC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4"/>İnsanar qabı-avayk'ananbı,</para>
  <para style="q2" vid="ECC 1:4">dyunyemee gırgıne gahbışilycad çine cigee axva.<verse eid="ECC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5"/>Verığ k'yooçena, ılqooç'ena,</para>
  <para style="q2" vid="ECC 1:5">qiyğa meeb ılqevç'esva</para>
  <para style="q2" vid="ECC 1:5">çine cigeeqa zaraba g'adaaxhvan.<verse eid="ECC 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6"/>Mıts cənubulqa,</para>
  <para style="q2" vid="ECC 1:6">qiyğa şimalılqa aa'a.</para>
  <para style="q1" vid="ECC 1:6">İlyviyk'ar-ilyviyk'arıb</para>
  <para style="q2" vid="ECC 1:6">çine yəqqı'lqa siviyk'al.<verse eid="ECC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7"/>Gırgın damabı deryaheeqa gyodatstse,</para>
  <para style="q2" vid="ECC 1:7">deryahme gyaats'e deş.</para>
  <para style="q1" vid="ECC 1:7">Damabı gyodatstsene cigeeqacad</para>
  <para style="q2" vid="ECC 1:7">meed gyotstses.<verse eid="ECC 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8"/>İnsanısse gırgıne karan</para>
  <para style="q2" vid="ECC 1:8">vuc nimeeyiy ozar ha'a,</para>
  <para style="q2" vid="ECC 1:8">eyhes əxə deş –</para>
  <para style="q1" vid="ECC 1:8">ul, ilyaakıyke idyaats'e,</para>
  <para style="q2" vid="ECC 1:8">k'ırıd, k'ırı alixhxhiyke gidyayts'e.<verse eid="ECC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9"/>Hucooyiy ıxha meed ixhesın,</para>
  <para style="q2" vid="ECC 1:9">hucooyiy həşdilqamee hı'ı, meed ha'asın.</para>
  <para style="q1" vid="ECC 1:9">Xəək avud ts'edın kar deşin.<verse eid="ECC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10"/>Sassa yəqqees eyhen:</para>
  <para style="q2" vid="ECC 1:10">«İlekke, in ts'edın karıd!»</para>
  <para style="q1" vid="ECC 1:10">Man ögiylid ıxhayn,</para>
  <para style="q2" vid="ECC 1:10">yişde dyovrule ögiyl.<verse eid="ECC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11"/>Şenke vuxhaynbı</para>
  <para style="q2" vid="ECC 1:11">şavuscab yik'el avxu deş.</para>
  <para style="q1" vid="ECC 1:11">Qiyğa qavaalesınbıb,</para>
  <para style="q2" vid="ECC 1:11">cole qiyğiynbışe yik'el avqas deş.<verse eid="ECC 1:11"/></para>
  <para style="s">K'orana ək'elib q'əran vuççud deşin kar vodun</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12"/>Zı, Mə'əllim, İyerusalimee İzrailyna paççahniy vor. <verse eid="ECC 1:12"/><verse number="13" style="v" sid="ECC 1:13"/>Zıcar zı g'aysırna xəək avud eyxhen işbı k'orane ək'elika xət qeetxhesva. Man yı'q'ı'n işbı Allahee insanaaşine gardanaqa gixhxhı. <verse eid="ECC 1:13"/><verse number="14" style="v" sid="ECC 1:14"/>Zak'le xəək avud ha'an gırgın işbı g'acuynbı. Man gırgın q'əran vuççud deşin kar vodun. Man mıtsıqa qihna g'adarxhuniyk<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">mıtsıqa qihna g'adarxhuniy: </char><char style="ft" closed="false">inçina sa mebna mə'na «rı'hı'n ts'ıts'aa'ana əq'üba» vob.</char></note> akar.<verse eid="ECC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15"/>Quç'otkuriyn qotku qa'as,</para>
  <para style="q2" vid="ECC 1:15">deşinıd hı'sab ha'as dexhe.<verse eid="ECC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>Zı zascad uvhuyn: «Zake xərna insan ıxha, zaqa zale ögee İyerusalimıs paççahiyvalla haa'ane paççahaaşile k'orana ək'el vob. Yizda k'orana ək'eliy ats'al geeb quvxha».<verse eid="ECC 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 1:17"/>Zıcar zı g'aysırna k'orana ək'eliy ats'al xət qıxha, bəç'əriyvallayiy beynyavavalla nəxdın kariyva ats'a ixhes. Zak'le manıd mıtsıqa qihna g'adarxhuniyk akaran kar ıxhay ats'axhxhayn.<verse eid="ECC 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18"/>K'orana ək'el geeb vuxhaylette</para>
  <para style="q2" vid="ECC 1:18">aq'va havaxan hı'iyid geed qexhe.</para>
  <para style="q1" vid="ECC 1:18">Geed ats'al alyaat'ang'vee</para>
  <para style="q2" vid="ECC 1:18">cuna derdıb geeb qa'a.<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s">Yik'eençe ıkkanan karıd q'əran vuççud deşin kar vodun</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>Zı zak'lecad uvhuyn: «Qoralan, zas yik'eençe ıkkanan karbı hı'ı, gırgınçike kef qığahas». Manıd q'əran vuççud deşin kar vodun.<verse eid="ECC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 2:2"/>Əqənayne hək'ee zı uvhuyn:</para>
  <para style="q2" vid="ECC 2:2">«Bəç'əriyvalla!»</para>
  <para style="q1" vid="ECC 2:2">Yik'eençe ıkkanne karbışded hək'ee zı uvhuyn:</para>
  <para style="q2" vid="ECC 2:2">«Mançike hucoona hiyxhar?»<verse eid="ECC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 2:3"/>Zas ıkkiykınin yizda ək'el zalynang'a çaxır ulyodğu, bəç'əriyvallabı ats'axhxhes. Məxüd zas ats'axhxhesniy ıkkan, xəək avub sık'ınne gahıs huvuyne ı'mree, nişiniy insanaaşin yik'bı aaqa.<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>Zı ç'ak'ın işbı g'acu:</para>
  <para style="q2" vid="ECC 2:4">zas xaybı ali'ı, t'ımıllığbı ezu,<verse eid="ECC 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 2:5"/>bağbı, park'bı atçu,</para>
  <para style="q2" vid="ECC 2:5">caa'ad gırgın meyvabı ezu.<verse eid="ECC 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 2:6"/>Park'bışeene yivaaşis</para>
  <para style="q2" vid="ECC 2:6">xhyan heles ixhecenva</para>
  <para style="q1" vid="ECC 2:6">xhinen golerıd hı'ı.<verse eid="ECC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 2:7"/>Həmbal adameriy həmbal zəiyfabı alivşu,</para>
  <para style="q2" vid="ECC 2:7">zaqa, manbışileb ğayrı,</para>
  <para style="q2" vid="ECC 2:7">yizde xaa yedike vuxhayn həmbalarıb vuxhaynbı.</para>
  <para style="q1" vid="ECC 2:7">Çavra-vəq'əd zaqa zale ögee</para>
  <para style="q2" vid="ECC 2:7">İyerusalimee vuxhayne gırgıng'ule geedniy vod.<verse eid="ECC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 2:8"/>Zasın k'ınəəğəyiy nuk'ra</para>
  <para style="q2" vid="ECC 2:8">paççahaaşineyiy vilayatbışde xazinaabışeençe sı'ı.</para>
  <para style="q1" vid="ECC 2:8">Zas mə'niybı qətqəsın adameriy zəiyfabı ablyav'u.</para>
  <para style="q1" vid="ECC 2:8">Adameeşis vukkiykanan</para>
  <para style="q2" vid="ECC 2:8">nekke micagın zəiyfabıb geeb qav'u.<verse eid="ECC 2:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9"/>Zı məxür zale ögiyl İyerusalim vuxhaynbışiler karnana, qıvaats'ına ıxha. Mane gahılib yizda k'orana ək'el zalycab vuxha.<verse eid="ECC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10"/>Yizde ules ıkkiykınin</para>
  <para style="q2" vid="ECC 2:10">zı zale qiykkın deş.</para>
  <para style="q1" vid="ECC 2:10">Yizde yik'es ıkkanan</para>
  <para style="q2" vid="ECC 2:10">zı gırgın hı'iyn.</para>
  <para style="q1" vid="ECC 2:10">Man ha'an gırgın</para>
  <para style="q2" vid="ECC 2:10">yizde yik'eençe ıxha.</para>
  <para style="q1" vid="ECC 2:10">Mana zı qorxuna</para>
  <para style="q2" vid="ECC 2:10">hək' vuxha.<verse eid="ECC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11"/>Zı qorxunne,</para>
  <para style="q2" vid="ECC 2:11">yizde xılen g'acuyne işbışiqa sak'ı ilyakkımee,</para>
  <para style="q1" vid="ECC 2:11">man gırgın q'əran vuççud deşin kar vodva</para>
  <para style="q2" vid="ECC 2:11">zak'le ats'axhxhayn.</para>
  <para style="q1" vid="ECC 2:11">Man mıtsıqa qihna g'adarxhuniyk<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">mıtsıqa qihna g'adarxhuniy: </char><char style="ft" closed="false">inçina sa mebna mə'na «rı'hı'n ts'ıts'aa'ana əq'üba» vob.</char></note> akar.</para>
  <para style="q2" vid="ECC 2:11">Xəək avud nişikecad vuççud hiyxhar deş.<verse eid="ECC 2:11"/></para>
  <para style="s">«K'orana ək'elynanar bəç'ər xhinnecar qek'anacar»</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12"/>Qiyğa zı k'orane ək'eline, bəç'əriyvaline,</para>
  <para style="q2" vid="ECC 2:12">beynyavaline hək'ee fıkır opxhun.</para>
  <para style="q1" vid="ECC 2:12">Menne qalesde paççahısse nen medın</para>
  <para style="q2" vid="ECC 2:12">ine paççahee hidi'iyn işbı g'aces əxəyee?<verse eid="ECC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13"/>Zalqa hitxhıriyn, nəxüdiy işix miç'axiyvalile yugda,</para>
  <para style="q2" vid="ECC 2:13">məxbıb k'orana ək'el beynavavalile yugba vob.<verse eid="ECC 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14"/>K'orana ək'elynang'uk'le</para>
  <para style="q2" vid="ECC 2:14">vuc nyaqa ark'ıniy yugda g'ece,</para>
  <para style="q1" vid="ECC 2:14">bəç'ərme miç'axiyvalee</para>
  <para style="q2" vid="ECC 2:14">iliyk'ar axva.</para>
  <para style="q1" vid="ECC 2:14">Zak'leme q'öng'ünesanad</para>
  <para style="q2" vid="ECC 2:14">vuk'lelqa sa kar qales ıxhay ats'an.<verse eid="ECC 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15"/>Zı zak'lecad uvhuyn:</para>
  <para style="q1" vid="ECC 2:15">«Yizded vuk'lelqa bəç'ərne vuk'lelqa qöön qales.</para>
  <para style="q2" vid="ECC 2:15">Manke zas nişistannane yizda k'orana ək'el?»</para>
  <para style="q1" vid="ECC 2:15">Mançil-allad, zı zaled-alqa uvhuyn:</para>
  <para style="q2" vid="ECC 2:15">«Manıd q'əran vuççud deşin kar vodun».<verse eid="ECC 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16"/>K'orana ək'elynanar, bəç'ər xhinne</para>
  <para style="q2" vid="ECC 2:16">geer gahna yik'el aqqas deş.</para>
  <para style="q1" vid="ECC 2:16">Manbışda q'öyursana</para>
  <para style="q2" vid="ECC 2:16">zarabacab yik'el hivxanasınbı.</para>
  <para style="q1" vid="ECC 2:16">K'orana ək'elynanar</para>
  <para style="q2" vid="ECC 2:16">bəç'ər xhinnecar qek'anacar!<verse eid="ECC 2:16"/></para>
  <para style="s">İnsanee ha'an gırgın q'əran vuççud deşin kar vod</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>I'mırıb zas g'umooce quvxha. Xəək avud ha'an gırgın kar zas qəla qıxha. Man gırgın q'əran vuççud deşin kar vodun. Man mıtsıqa qihna g'adarxhuniyk akar. <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>Zı verığık avud qorxu hı'iyn gırgın kar zas g'ımece qıxha. Zı hı'iyn gırgın kar zale qiyğa qalesıng'us axvas. <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>Şavuk'lene ats'a, mana ək'elikaname, bəç'ərme ixhes? Zı verığık avud k'orane ək'elikayiy qorxuyka hı'iyn karbı mang'une xılyaqa ılğeeç'es. Manıd q'əran vuççud deşin kar vodun.<verse eid="ECC 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 2:20"/>Mançil-allad verığık avud qorxuyka ha'ane gırgıne karbışike zı mık'a qıxha. <verse eid="ECC 2:20"/><verse number="21" style="v" sid="ECC 2:21"/>Sang'vee k'orane ək'elika, ats'alika, yik'eençe hı'iyn kar, nekke qiyğa t'ubcab ı'ğviykar hidyav'une insanıs g'aleççes gexha. Manıd q'əran vuççud deşin kariy xəbna ver vobna! <verse eid="ECC 2:21"/><verse number="22" style="v" sid="ECC 2:22"/>İnsanıs verığık avur qorxuyke, yik' gyotxhuniyke hucoona hiyxhar? <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>Gırgıne gahbışil mang'vee aq'va qa'a, derd ts'ıts'aa'a. Xəmder fıkren mana arğançe orxhan eyxhe. Manıd q'əran vuççud deşin kar vodun.<verse eid="ECC 2:23"/></para>
  <para style="s">Şadvalla Allahıke vob</para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>İnsannemee inekke yugun otxhun-ulyodğuyiy sayid cune qorxuyke kef qığavhiy vodun. Zak'le g'acuyn man gırgın helenar Allah vorna. <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>Mana dena şavusse oxhanas, yik' cigeeqa qalya'as əxəyee? <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>Allahee Cune ulen aqqıyng'us k'orana ək'el, ats'al, şadvalla hoole. Bınahbınang'usme kar sa'asda əq'üba hoole, qiyğale xhinne Cune ulen aqqıyng'us helesva. Manıd q'əran vuççud deşin kar vodun, mıtsıqab qihna g'adapxhıniyk akar.<verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s">Gırgınçiqa çina gah vob</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1"/>Gırgınçiqa çina gah vob,</para>
  <para style="q2" vid="ECC 3:1">xəək avudne gırgıne karaqa çina gah vob.<verse eid="ECC 3:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2"/>Yedike ıxhayqab çina gah,</para>
  <para style="q2" vid="ECC 3:2">qik'uyqab çina gah.</para>
  <para style="q1" vid="ECC 3:2">Ezuyqab çina gah,</para>
  <para style="q2" vid="ECC 3:2">ezuyn hı'ttitxı'yqab çina gah.<verse eid="ECC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3"/>Gyapt'ıyqab çina gah,</para>
  <para style="q2" vid="ECC 3:3">yug qav'uyqab çina gah.</para>
  <para style="q1" vid="ECC 3:3">Qottulıyqab çina gah,</para>
  <para style="q2" vid="ECC 3:3">ali'iyqab çina gah.<verse eid="ECC 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4"/>Gyaaşuyqab çina gah,</para>
  <para style="q2" vid="ECC 3:4">əqəna hı'iyqab çina gah.</para>
  <para style="q1" vid="ECC 3:4">Ak' avquyqab çina gah,</para>
  <para style="q2" vid="ECC 3:4">mık'ar hı'iyqab çina gah.<verse eid="ECC 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5"/>G'aye avhuyqab çina gah,</para>
  <para style="q2" vid="ECC 3:5">g'aye sav'uyqab çina gah.</para>
  <para style="q1" vid="ECC 3:5">Xüvə apk'iyqab çina gah,</para>
  <para style="q2" vid="ECC 3:5">xüvə idyapk'iyqab çina gah.<verse eid="ECC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6"/>T'abal hav'uyqab çina gah,</para>
  <para style="q2" vid="ECC 3:6">aagval hav'uyqab çina gah.</para>
  <para style="q1" vid="ECC 3:6">Havaacıyqab çina gah,</para>
  <para style="q2" vid="ECC 3:6">dağetçuyqab çina gah.<verse eid="ECC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7"/>Qıtt'axı'iyqab çina gah,</para>
  <para style="q2" vid="ECC 3:7">man iyxhuyqab çina gah.</para>
  <para style="q1" vid="ECC 3:7">Ghal sı'iyqab çina gah,</para>
  <para style="q2" vid="ECC 3:7">yuşan hı'iyqab çina gah.<verse eid="ECC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8"/>Vukkiykıniyqab çina gah,</para>
  <para style="q2" vid="ECC 3:8">g'umooce qepxhayqab çina gah.</para>
  <para style="q1" vid="ECC 3:8">Dəv'əyqab çina gah,</para>
  <para style="q2" vid="ECC 3:8">sülyhuqab çina gah vob.<verse eid="ECC 3:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>Qorxu kar ha'ang'us mançike hucoona hiyxhar? <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>Zak'le Allahee man yı'q'ı'n işbı insanaaşine gardanaqa gixhxhı g'acu. <verse eid="ECC 3:10"/><verse number="11" style="v" sid="ECC 3:11"/>Allahee gırgın kar micagda çine gahıl hı'ı. Mang'vee insanne yik'eeqa ç'əv dyooxhene gahıne hək'ee atçu. İnsanılqad Allahee hı'iyn kar q'omançe-k'anyaqqamee hiyxhar deş. <verse eid="ECC 3:11"/><verse number="12" style="v" sid="ECC 3:12"/>Zalqa hitxhıriyn, insannemee şadra ıxha ı'mı'rvolle ı'mı'rıke kef qığavhuyle yugun kar deşin. <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>Şavaayiy otxhanançike, ulyoğançike, qorxuyke kef qığayhee, mana Allahna pay vobna. <verse eid="ECC 3:13"/><verse number="14" style="v" sid="ECC 3:14"/>Zalqa hitxhıriyn, Allahee hav'una iş gırgıne gahbışisda vobna. Mançik vuççudud hexxa'as eyxhe deş, mançike vuççudud g'ats'ak'vanas eyxhe deş. Allahee məxüd ha'a, insanarıb Cule qəvəyq'ənanbı.<verse eid="ECC 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15"/>Həşde hucooyiy vod,</para>
  <para style="q2" vid="ECC 3:15">şenked ıxhayn,</para>
  <para style="q1" vid="ECC 3:15">hucooyiy ixhesıd,</para>
  <para style="q2" vid="ECC 3:15">avaalad ıxhayn.</para>
  <para style="q" vid="ECC 3:15">Allahee şenke ıxhaynçin</para>
  <para style="q2" vid="ECC 3:15">hı'sab qeqqas.<verse eid="ECC 3:15"/></para>
  <para style="s">Gırgınbı nyuq'vnelqa savk'alas</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16"/>Xəək avud zak'le inıd g'acuyn:</para>
  <para style="q1" vid="ECC 3:16">Qotkune məhkamayne cigee horbı,</para>
  <para style="q1" vid="ECC 3:16">qopkuvaline cigeeyib pisvalla.<verse eid="ECC 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 3:17"/>Zı zak'lecad uvhuyn:</para>
  <para style="q1" vid="ECC 3:17">«Allahee qorkung'unud,</para>
  <para style="q1" vid="ECC 3:17">pisıng'unud məhkama alğahas.</para>
  <para style="q1" vid="ECC 3:17">Mang'vee gırgıne karas,</para>
  <para style="q1" vid="ECC 3:17">gırgıne işis çina gah gyuvxhu».<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>Zı zak'lecad uvhuyn: «Allahee insanar siliys üvxiyxə, co həyvanaaşik akaraba vuxhay g'avcecenva». <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>Həyvanne vuk'lelqa qaylen insanned vuk'lelqa qaylen. Həyvanıb, insanır qek'ana. Həyvanınıd, insaneeyid sa nafas ileşşe. İnsan həyvanıle ooqana deş vor. Man gırgın q'əran vuççud deşin kar vodun.<verse eid="ECC 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 3:20"/>İnbıb, şenbıd</para>
  <para style="q2" vid="ECC 3:20">çine cigeeqa siyk'al:</para>
  <para style="q1" vid="ECC 3:20">inbıb, şenbıd</para>
  <para style="q2" vid="ECC 3:20">nyuq'vnekenbı vod,</para>
  <para style="q2" vid="ECC 3:20">nyuq'vnelqad sak'alasınbı.<verse eid="ECC 3:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="ECC 3:21"/>Şavuk'lene ats'a, insanaaşin rı'h xəəqə ılqeç'emme deşme, həyvanaaşinıd rı'h avqa, nyuq'vneeqa əlyhəə ıxhay?<verse eid="ECC 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22"/>Zak'le g'acuyn, insanısqa vucee haa'ana iş yugba qööxhee, mang'unemee mançile yugun kar deşin. I'mreke mang'us axuyn man vod. Şavusse mang'uk'le cule qiyğa eyxhenbı hagvas əxəye?<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s">Dyunyeyn əq'übabı</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1"/>Zak'le meed xəək avud helen, gırgın əq'übabı g'acu:</para>
  <para style="q1" vid="ECC 4:1">k'yats'apxıliynbışin gyaaşuybı g'acu,</para>
  <para style="q1" vid="ECC 4:1">manbışis yik'bı helena vuşucar deşiy.</para>
  <para style="q1" vid="ECC 4:1">Guc əq'üba hoolenbışde xıleyiy,</para>
  <para style="q1" vid="ECC 4:1">k'yats'apxıliynbışis yik'bı helenbı deşiy.<verse eid="ECC 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2"/>Zasqa ögiyl hapt'ıynbı,</para>
  <para style="q2" vid="ECC 4:2">üç'übınbışile baxtivarba qabı.<verse eid="ECC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3"/>Mane q'önbışileb yugunbı,</para>
  <para style="q2" vid="ECC 4:3">ine dyunyelqa qidyabıynbıcab vob.</para>
  <para style="q1" vid="ECC 4:3">Manbı xəək avud ha'an pisın karbı g'ıdecuynbı vob.<verse eid="ECC 4:3"/></para>
  <para style="s">İşine hek'ee</para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4"/>Zak'le insanaaşe iş yı'q'ba haa'amee, manbışda iş yugba əlyhəə g'avcuna. Mançil-allab mebınbışe manbışde karalqa ul giviyxhe. Manıd q'əran vuççud deşin kar vodun, mıtsıqab qihna g'adapxhıniyk akar.<verse eid="ECC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5"/>Şak'le ats'an bəç'əree xıl-xılelqa gixhxhı,</para>
  <para style="q2" vid="ECC 4:5">mıssıra axu, cukun ha'an.<verse eid="ECC 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6"/>Sa xhaxheedın vaxxariynme,</para>
  <para style="q2" vid="ECC 4:6">q'öne xhaxheene qoxa ha'ane karaleyiy</para>
  <para style="q2" vid="ECC 4:6">mıtsıqa qihna g'adarxhuniyle yugda vod.<verse eid="ECC 4:6"/></para>
  <para style="s">«Sa insanıle q'öyre yugra»</para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7"/>Zak'le meed xəək avud q'əran vuççud deşin kar g'acu:<verse eid="ECC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8"/>sa vuşucar deşda insanniy vor,</para>
  <para style="q2" vid="ECC 4:8">mang'uqa dixır, çocur deşdaniy.</para>
  <para style="q1" vid="ECC 4:8">Mang'una iş ç'əvcab vooxhena deşdiy,</para>
  <para style="q2" vid="ECC 4:8">mang'un uleppıd karan ayts'e deşdiy.</para>
  <para style="q1" vid="ECC 4:8">Mang'vee cuke qiyğan deşdiy, «Zı şavnemeene inimeena qoxa?</para>
  <para style="q2" vid="ECC 4:8">Şavusvane zıcar zı kefıke ha'a?»</para>
  <para style="q1" vid="ECC 4:8">Manıd q'əran vuççud deşin kariy yı'q'na iş vobna.<verse eid="ECC 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9"/>Sa insanıle q'öyre yugra,</para>
  <para style="q1" vid="ECC 4:9">manbı qopxu hav'uyne işike</para>
  <para style="q2" vid="ECC 4:9">yugna hək' vuxhes.<verse eid="ECC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10"/>Sa qukkyork'ule,</para>
  <para style="q2" vid="ECC 4:10">mang'une hambazee mana oza qa'asda.</para>
  <para style="q1" vid="ECC 4:10">Vuccar əlyhəəname qukkyork'ulee,</para>
  <para style="q2" vid="ECC 4:10">mana oza qa'asda ixhes deş.<verse eid="ECC 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11"/>Məxrür q'öyre insan sacigee g'alyapk'ee,</para>
  <para style="q2" vid="ECC 4:11">manbışis g'üməda ixhes.</para>
  <para style="q1" vid="ECC 4:11">Vuccar g'alirxhuna nəxür arak'vayee?<verse eid="ECC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12"/>Sang'ule ğamxhay vaxxariyda vod,</para>
  <para style="q2" vid="ECC 4:12">q'öng'uleme ğameepxhay dağamda ixhes.</para>
  <para style="q1" vid="ECC 4:12">Xhebılle g'atnana tü'ı'b</para>
  <para style="q2" vid="ECC 4:12">zaaraba qooxas deş.<verse eid="ECC 4:12"/></para>
  <para style="s">Milletıs ıkkiykıniyıd q'əran kar vodun</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>Kar deşda, k'orana ək'elynana mek'vna, bəç'ərne, mı'sləhət g'idiyxhene q'əsde paççahıle yugra vor. <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>Mana mek'vna ine ölkee kar deşde xizanee yedike ixheeyir, zindaneeqa girxheeyir, mang'usse mançe qığeç'u paççah ixhes əxəsda. <verse eid="ECC 4:14"/><verse number="15" style="v" sid="ECC 4:15"/>Zak'le g'acuyn, xəək avub iviykaran gırgınbı paççah ıxhayne mek'vung'uqab qihna vob əlyhəə. <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>Mang'une vuk'lelqa sadıyn millet qətqəs-ələtqəs eyxhe deşiy. Qiyğiyne nasılbışis mana yik'eençe ixhes deş. Manıd q'əran vuççud deşin kar vodun, mıtsıqab qihna g'adapxhıniyk akar.<verse eid="ECC 4:16"/></para>
  <para style="s">K'oran mı'sləhətbı</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 4:17"/>Allahne Xaaqa ı'qqəmee, ğu ha'an ats'axhxhe. Beynyavabışik'le co ha'an dyats'a, cone beynyavalis sik'ı q'urban ablyaa'a. Manbışik'le co haa'ana pisvalla vaats'a deş. Ğu manbışe ha'an xhinne hıma'a, man ha'amee, Allahne cuvabıl k'ırı alixhxhe.<verse eid="ECC 4:17"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 5:1"/>Allahne ögiyl cuvab eyhesse fıkır ooxhne,</para>
  <para style="q2" vid="ECC 5:1">zarada ghal ımaaqa.</para>
  <para style="q1" vid="ECC 5:1">Allah xəə, ğume ç'iyel vor.</para>
  <para style="q2" vid="ECC 5:1">Mançil-alla k'ırra yuşan he'e.<verse eid="ECC 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2"/>İnsanee geeb fıkır opxhanxhee,</para>
  <para style="q2" vid="ECC 5:2">mang'us alikkı-gikkiyn nyak'bı g'yagva.</para>
  <para style="q1" vid="ECC 5:2">Həməxdıd geer yuşan ha'ang'vee</para>
  <para style="q2" vid="ECC 5:2">cuna bəç'əriyvalla aq'valqa qığaaha.<verse eid="ECC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 5:3"/>Allahıs cuvab huvuyng'a, man çine gahıl he'e. Mang'us bəç'ərar vukkiykananbı deş, cuvab huvuyn kar he'e. <verse eid="ECC 5:3"/><verse number="4" style="v" sid="ECC 5:4"/>Cuvab hidevuy, cuvab huvu hidi'iyle yugda vod. <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>Hımaysar yiğne ghalen ğu bınaheeqa arçes. Vasqa g'axuvuyng'uk'le immeyhe: «Zı cuvab huvu, qotkuda deş hı'ı». Vas nişisınne Allahna yiğne cuvabılqa qəl avqu, ğu yiğne xıleka hı'iynçıkın he'ecen? <verse eid="ECC 5:5"/><verse number="6" style="v" sid="ECC 5:6"/>Geed nyak'bı g'acuy, geeb yuşan hav'iy q'əran vuççud deşin kar vod. Ğumee Allahıle qəq'ne.<verse eid="ECC 5:6"/></para>
  <para style="s">Geed karne hək'ee</para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 5:7"/>Vak'le nyaamecad karnang'vee kar deşda hoyç'an, qopkuvallayiy qotkuyn məhkama g'eliqqa huvu g'acveene, ghal aaqı ımaxva, məxdın kar eyxhenxhe. Sa xərıng'ul oo, mang'vee ha'ançiqa ilyakkana sa merna xərna vor. Manbışde vuk'lel ooyur manbışile xərna vor. <verse eid="ECC 5:7"/><verse number="8" style="v" sid="ECC 5:8"/>Manbışde gırgınbışe ç'iyene aq'vayn hixhara'an kar alyaat'a, nyuq'vnen paççahır ats'ya'ana.<verse eid="ECC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 5:9"/>K'aarın ıkkanna</para>
  <para style="q2" vid="ECC 5:9">mançike ayts'ena deş.</para>
  <para style="q1" vid="ECC 5:9">Kar ıkkannar</para>
  <para style="q2" vid="ECC 5:9">g'azançıle idyayts'e.</para>
  <para style="q1" vid="ECC 5:9">Manıd q'əran vuççud deşin kar vodun.<verse eid="ECC 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10"/>Kar geed qıxaylette,</para>
  <para style="q2" vid="ECC 5:10">man otxhananbıb geeb qeebaxhe.</para>
  <para style="q1" vid="ECC 5:10">Uleppışik'le g'acuyle ğayrı,</para>
  <para style="q2" vid="ECC 5:10">iyesiys medın hucoona axva?<verse eid="ECC 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11"/>Xıleppışika iş g'ooceng'vee geedıd, k'ıldad otxhunee,</para>
  <para style="q2" vid="ECC 5:11">mang'un nyak' ittuda eyxhe.</para>
  <para style="q1" vid="ECC 5:11">Vuxhun gyavts'una karnanamee,</para>
  <para style="q2" vid="ECC 5:11">tyulee ittiyk'al axvana.<verse eid="ECC 5:11"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="12" style="v" sid="ECC 5:12"/>Zak'le xəək avud insanılqa ı'qqən sa xədın divanıd g'acuyn:</para>
  <para style="q1" vid="ECC 5:12">iyesee kar se'eeyid, mang'ulqa ver abayle –<verse eid="ECC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 5:13"/>sa devxhesde işen mang'un kar ak'an ha'a.</para>
  <para style="q1" vid="ECC 5:13">Mane karane iyesiys dix ıxhamee,</para>
  <para style="q2" vid="ECC 5:13">mang'us helesın kar axva deş.<verse eid="ECC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 5:14"/>Nəxüriy mana yedike ts'eler ıxha,</para>
  <para style="q2" vid="ECC 5:14">həməxürur ine dyunyeençe əlyhəəs.</para>
  <para style="q1" vid="ECC 5:14">Mana geer qorxveeyir,</para>
  <para style="q2" vid="ECC 5:14">cuka vuççud qıkkees əxəs deş.<verse eid="ECC 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 5:15"/>Manıd insanılqa ı'qqən sa xədın divan vod:</para>
  <para style="q1" vid="ECC 5:15">insan dyunyelqa nəxüriy qarayle,</para>
  <para style="q2" vid="ECC 5:15">həməxürur ayk'anna.</para>
  <para style="q1" vid="ECC 5:15">Mıtsıs hav'uyne işike</para>
  <para style="q2" vid="ECC 5:15">mang'us hucoona?<verse eid="ECC 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 5:16"/>Gırgıne gahbışilycad cun g'ık,</para>
  <para style="q1" vid="ECC 5:16">miç'axiyvalee, dağamiyvalee,</para>
  <para style="q2" vid="ECC 5:16">ık'arbışee, qəlıka oyxhan.<verse eid="ECC 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 5:17"/>Qiyğa zalqa hitxhıriyn, insannemee otxhun-ulyodğuy yugda, qotkuda eyxheyiy. Allahee sa-q'öne yiğıs huvuyne ı'mree, xəək avur qorxuyke kef qığehecen. Mang'us axvasın man vod. <verse eid="ECC 5:17"/><verse number="18" style="v" sid="ECC 5:18"/>Allahee şavusmecad geed kar huvuxhee, man oxhanas, cuna pay alyapt'as, cune qorxuyke kef ts'ıts'a'as hassırxhee, mana Allahna pay vobna. <verse eid="ECC 5:18"/><verse number="19" style="v" sid="ECC 5:19"/>Məxrıne insanın yik' Allahee şad ha'ava, mang'vee cune ı'mrena k'ılyba haa'a.<verse eid="ECC 5:19"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="s">I'mı'r vuççud deşin kar vodun</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>Zak'le xəək avud sa medınıd insanaaşilqa ı'qqən divan g'acuyn. Man insanaaşik qitxhuyn divan geed yı'q'ı'n vodun: <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>məxrına insan vorna Allahee mang'us kar, xəbvalla, ules ıkkanan gırgın helen. Saccu mane karake mang'us otxhun-ulyoğas haysar deş. Sa dyats'anecad insanee mang'un kar oyxhan. Manıd q'əran vuççud deşin kara idyalesın, vuk'lelqa adıyn divan vodun.<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>Sa insanıqa vəş uşax ıxha, mang'vee xıliyna ı'mı'rıb hav'una. Mang'vee nimeena ı'mı'r hav'eeyib, mang'uk'le mısacad yiğ g'acu deş, mana k'eyxhır deş. Məxrıng'une hək'ee zı invaniy eyhes: qik'u yedike ıxhayn uşax mang'ule yugda eyxheyiy.<verse eid="ECC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 6:4"/>Mang'un yedike ıxhay</para>
  <para style="q2" vid="ECC 6:4">ıxha-ayk'anne booğak akar vod.</para>
  <para style="q1" vid="ECC 6:4">Mana miç'axiyvalee agu ayk'anna,</para>
  <para style="q2" vid="ECC 6:4">mang'un doyud ağmiş ha'a deş.<verse eid="ECC 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 6:5"/>Mang'uk'le verığın aq'vad g'ece deş, vuççudud ats'axhxhe deş. Məxdıne uşaxna vaxxariyvalla şene insanıle geeb vooxhe. <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>Mane insanee q'öne yəqqees aazır sennana ı'mı'r hav'eeyib, mang'uk'le yiğ g'ıdecuxheene, mang'us mançike hucoona? Nekke qiyğa manbışin gırgınbı sa cigeeqa əlyhəəs.<verse eid="ECC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7"/>İnsan cune vuxhnenemee qoxa,</para>
  <para style="q2" vid="ECC 6:7">meeb mang'una ul aats'e deş.<verse eid="ECC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8"/>K'orane ək'elynang'un,</para>
  <para style="q2" vid="ECC 6:8">bəç'ərıle ooqan ciga hucoone?</para>
  <para style="q1" vid="ECC 6:8">Kar deşing'usse vuceecar vuc</para>
  <para style="q2" vid="ECC 6:8">mebınbışde ögiyl ıkkees əxəxhee,</para>
  <para style="q1" vid="ECC 6:8">mang'us mançike hucoona hixharas?<verse eid="ECC 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9"/>Vodunçis şadxhay,</para>
  <para style="q2" vid="ECC 6:9">deşin t'abal hı'iyle yugda vod.</para>
  <para style="q1" vid="ECC 6:9">Manıd q'əran vuççud deşin kar vodun,</para>
  <para style="q2" vid="ECC 6:9">mıtsıqab qihna g'adapxhıniyk akar.<verse eid="ECC 6:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10"/>Vonne gırgınçis, doyud huvu vodun.</para>
  <para style="q2" vid="ECC 6:10">İnsanır hucoo ıxhay ögiylycad ats'a.</para>
  <para style="q1" vid="ECC 6:10">İnsanısse cule Gucnang'uka</para>
  <para style="q2" vid="ECC 6:10">xıliyn ha'as əxə deş.<verse eid="ECC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11"/>Nimee geer yuşan he'ee,</para>
  <para style="q2" vid="ECC 6:11">manimeeyid q'əran cuvab ixhes.</para>
  <para style="q1" vid="ECC 6:11">Mançike insanıs hucoona hixharas?<verse eid="ECC 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12"/>Şavuk'lene ats'a, əq' xhinne ı'lğəəne, cit'ane, q'ərane ı'mree insannemee yugun hucooniyxan? Şavusse insanık'le eyhes əxəyee, cule qiyğa xəək avud hucoobıniyxan ixhes?<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s">I'mren yəq'bı</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1"/>Yugun do yugne ətriyatıle,</para>
  <para style="q2" vid="ECC 7:1">qek'an yiğıd, yedike ıxhayne yiğıle yugda vod.<verse eid="ECC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2"/>Ak'nane xaaqa hark'ıniy,</para>
  <para style="q2" vid="ECC 7:2">otxhun-ulyodğuynane xaaqa hark'ıniyle yugda vod.</para>
  <para style="q1" vid="ECC 7:2">Qik'uy gırgıng'une vuk'lel vodun,</para>
  <para style="q2" vid="ECC 7:2">hasre üç'ürung'vee man yik'el aqqecen.<verse eid="ECC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3"/>Aq'va qı'iy, əqəna hı'iyle yugda vod.</para>
  <para style="q2" vid="ECC 7:3">Aq'va qı'iy insanne yik'enemee yugda vod.<verse eid="ECC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4"/>K'orane ək'elynang'un yik' ak'nane xaa axva.</para>
  <para style="q2" vid="ECC 7:4">Beynyavaynme yik' otxhan-ulyoğane xaa.<verse eid="ECC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5"/>K'orane ək'elynang'une güxül k'ırı alixhxhiy,</para>
  <para style="q2" vid="ECC 7:5">beynyavayn ğu yug hı'iyle yugda vod.<verse eid="ECC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6"/>Beynyavayn əqəna,</para>
  <para style="q2" vid="ECC 7:6">k'umk'umuk avud gyotxhanne zazane sesık akar.</para>
  <para style="q1" vid="ECC 7:6">Manıd q'əran vuççud deşin kar vodun.<verse eid="ECC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7"/>K'orane ək'elynang'vee insanaaşike gucuka kar alyaat'axhee,</para>
  <para style="q2" vid="ECC 7:7">manar beynyavalqa siyk'al.</para>
  <para style="q1" vid="ECC 7:7">Rüşvatınır insan yəqqı'le qığayhe.<verse eid="ECC 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8"/>Sa karan ç'əvxhay, mançine gidğılıyle yugda vod.</para>
  <para style="q2" vid="ECC 7:8">Sabırıkana insan vuceecar-vuc hagvang'ule yugna vor.<verse eid="ECC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9"/>Zaraba qəl hımaa'a,</para>
  <para style="q2" vid="ECC 7:9">qəl beynyavabışde yik'eexhe vooxhena.<verse eid="ECC 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10"/>«Nya'a ılğeeç'uyn yiğbı inçile yugda ıxhava?» qimiyghan.</para>
  <para style="q2" vid="ECC 7:10">K'orana ək'el vuxhayke məxdın kar qiyghan deş.<verse eid="ECC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11"/>K'orane ək'elynane insanıqa</para>
  <para style="q2" vid="ECC 7:11">kar geednang'a sık'ıldad yugda eyxhe.</para>
  <para style="q1" vid="ECC 7:11">Mançin q'öyüd sana ıxhay</para>
  <para style="q2" vid="ECC 7:11">verığ g'oocene gırgıng'uneme yugda vod.<verse eid="ECC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12"/>K'orane ək'elinır,</para>
  <para style="q2" vid="ECC 7:12">pılın xhinne insan havacena.</para>
  <para style="q1" vid="ECC 7:12">Ats'aalike insanıs in hiyxhar:</para>
  <para style="q2" vid="ECC 7:12">k'orane ək'elin çine iyesiyna ı'mı'r havaace.<verse eid="ECC 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13"/>Allahne işiqa ilyakke:</para>
  <para style="q1" vid="ECC 7:13">Mang'vee k'yoç'an hı'iyn</para>
  <para style="q2" vid="ECC 7:13">şavusse qotku qa'as əxəyee?<verse eid="ECC 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14"/>Yugne yiğbışee şadra ixhe,</para>
  <para style="q2" vid="ECC 7:14">pisde yiğbışilid in ats'axhxhe:</para>
  <para style="q1" vid="ECC 7:14">inıd, şenıd Allahee itxhın,</para>
  <para style="q2" vid="ECC 7:14">insanık'le cule qiyğa ixhesınbı mats'axhxhecenva.<verse eid="ECC 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 7:15"/>Yizde q'ərane ı'mree zak'le geed kar g'acu:</para>
  <para style="q1" vid="ECC 7:15">qorkuna insan,</para>
  <para style="q2" vid="ECC 7:15">cune qorkuvaliqa ilydyakkı, qek'ana,</para>
  <para style="q1" vid="ECC 7:15">pisde insannab,</para>
  <para style="q2" vid="ECC 7:15">cune pisvaliqa ilydyakkı, ı'mı'r xıliy qooxhe.<verse eid="ECC 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16"/>Geerır qorkura mexhe,</para>
  <para style="q2" vid="ECC 7:16">ğucar ğu geerır k'orane ək'elika hımagva.</para>
  <para style="q2" vid="ECC 7:16">Nişil-allane ğucad vakın ha'as?<verse eid="ECC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17"/>Geerır pisra mexhe,</para>
  <para style="q1" vid="ECC 7:17">bəç'ərra mexhe.</para>
  <para style="q2" vid="ECC 7:17">Nişil-allane ğu gah qidyabıcar qik'as?<verse eid="ECC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18"/>İna mı'sləhət yik'el avqee yugba vob,</para>
  <para style="q2" vid="ECC 7:18">manasab yik'el hivxan hımaa'a.</para>
  <para style="q1" vid="ECC 7:18">Allahıle qəyq'ənang'vee q'önçulysana k'ırı iliyxhen.<verse eid="ECC 7:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19"/>K'orane ək'elin, ək'elynane insanıs,</para>
  <para style="q2" vid="ECC 7:19">şaharee vooxhene yits'ne xərıng'ule geeb gucxhe hoolena.<verse eid="ECC 7:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20"/>Məxrına qorkuna insan deşda,</para>
  <para style="q2" vid="ECC 7:20">mang'vee saccu yugvallacab hee'ecen,</para>
  <para style="q2" vid="ECC 7:20">bınah hımaa'acen.<verse eid="ECC 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21"/>İnsanaaşe eyhene gırgınçilqa fıkır hımoole.</para>
  <para style="q2" vid="ECC 7:21">Manke vak'le yiğne nukaree vaqa hokanıd g'ayxhes deş.<verse eid="ECC 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22"/>Vak'le yugda ats'a vod,</para>
  <para style="q2" vid="ECC 7:22">ğunad menne insanaaşiqa geed hoku.<verse eid="ECC 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23"/>Man gırgın zı k'orane ək'elika siliys ı'xı'.</para>
  <para style="q1" vid="ECC 7:23">«Zı k'orane ək'elikana ixhesva» uvhu.</para>
  <para style="q2" vid="ECC 7:23">K'orana ək'elyme zake əq'əna vuxha.<verse eid="ECC 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24"/>Ixha atk'ıniyn karbı şake əq'əna,</para>
  <para style="q2" vid="ECC 7:24">geed k'orada vod.</para>
  <para style="q1" vid="ECC 7:24">Manbı şavuk'le iveekeyiy?<verse eid="ECC 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25"/>Zas k'orana ək'eliy ats'al</para>
  <para style="q2" vid="ECC 7:25">t'abal ha'as, xət qıxhes, ats'axhxhes ıkkan.</para>
  <para style="q1" vid="ECC 7:25">Zas pisde insanaaşina beynyavallayiy</para>
  <para style="q2" vid="ECC 7:25">ək'el deşinbışda bəç'əriyvalla vaats'a vuxhes vukkan.<verse eid="ECC 7:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26"/>Zak'le ats'axhxhayn,</para>
  <para style="q2" vid="ECC 7:26">merıng'us gugu hav'una zəiyfa</para>
  <para style="q2" vid="ECC 7:26">qik'uyle q'ap'ıra vor.</para>
  <para style="q1" vid="ECC 7:26">Məng'ı'n yik' torak,</para>
  <para style="q2" vid="ECC 7:26">xıleppıd zincirık akar.</para>
  <para style="q1" vid="ECC 7:26">Allahne ulesqa yugra qarına insan</para>
  <para style="q2" vid="ECC 7:26">məng'ı'le hexvana.</para>
  <para style="q1" vid="ECC 7:26">Bınahnaname insan</para>
  <para style="q2" vid="ECC 7:26">məng'ı'sqa gixhasda.<verse eid="ECC 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27"/>Mə'əllimee eyhen: zı gırgınçiqa sassadna ilyakkımee, manke ats'axhxha.<verse eid="ECC 7:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ECC 7:28"/>Zı t'abal he'eeyid, aveykı deş:</para>
  <para style="q1" vid="ECC 7:28">aazır adamiyne yı'q'nee</para>
  <para style="q2" vid="ECC 7:28">sa qorkuna aveykı,</para>
  <para style="q1" vid="ECC 7:28">manimeene zəiyfayne yı'q'neeme –</para>
  <para style="q2" vid="ECC 7:28">sa qorkuna aveykı deş.<verse eid="ECC 7:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29"/>Zalqa saccu sa kar hitxhır:</para>
  <para style="q2" vid="ECC 7:29">Allahee insanar qopkuba ipxhın,</para>
  <para style="q2" vid="ECC 7:29">manbımee alytipk'ılıynbı.<verse eid="ECC 7:29"/></para>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1"/>Şavusse k'orane ək'elynane insanıka sa ixhes əxəyee?</para>
  <para style="q2" vid="ECC 8:1">Eyxhene karbışda mə'na şavuk'lene vaats'a?</para>
  <para style="q1" vid="ECC 8:1">K'orane ək'elin insanne aq'vays nur hele,</para>
  <para style="q2" vid="ECC 8:1">kışşin aq'va g'üvəna qa'a.<verse eid="ECC 8:1"/></para>
  <para style="s">Paççahee eyhen he'e</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2"/>Zı vak'le eyhen: ğu Allahıs k'ın g'assırva, paççahee eyhen he'e. <verse eid="ECC 8:2"/><verse number="3" style="v" sid="ECC 8:3"/>Paççahısse cus ıkkanan gırgın ha'as əxən. Mançil-allar zaara mang'une uleke agvle. Mane dağamne cigee ımaxva. <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>Paççahne cuvabee guc vob. Şavusse mang'uk'le «Ğu ha'an hucooneva» eyhes əxəyee?<verse eid="ECC 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5"/>Mang'vee uvhuyn hı'iyng'ulqa</para>
  <para style="q2" vid="ECC 8:5">ver ables deş.</para>
  <para style="q1" vid="ECC 8:5">K'orane ək'elynane insanık'le</para>
  <para style="q2" vid="ECC 8:5">qopkuna gahıb, nəxüd hı'iyid ats'an.<verse eid="ECC 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6"/>Gırgıne karaqa çina gah,</para>
  <para style="q2" vid="ECC 8:6">çina qopkuna yəq vob.</para>
  <para style="q1" vid="ECC 8:6">İnsannemee vuk'lelqa</para>
  <para style="q2" vid="ECC 8:6">geed verbı adayle.<verse eid="ECC 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7"/>İnsanık'le vuk'lelqa</para>
  <para style="q2" vid="ECC 8:7">hucoome qales ats'a deş,</para>
  <para style="q1" vid="ECC 8:7">şavusse mang'uk'le eyhes əxəyee,</para>
  <para style="q2" vid="ECC 8:7">hucooyiy ixhesva?<verse eid="ECC 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8"/>Nəxbiy mıts insanısse avqas dəəxə,</para>
  <para style="q2" vid="ECC 8:8">həməxüdud qik'asın yiğ əq'əna qa'as əxə deş.</para>
  <para style="q1" vid="ECC 8:8">Esker dəv'eençe xaaqa g'ıdekkan xhinne,</para>
  <para style="q2" vid="ECC 8:8">pisvalisser pisda insan g'attixhana'as əxə deş.<verse eid="ECC 8:8"/></para>
  <para style="s">Yugnayiy pisda insan</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9"/>Man gırgın zak'le g'acuyn, xəək avud g'ecene gırgıne işbışiqa yugra ilyakkına: sa insanee manesa insanaaşis xəbvalla haa'amee, mane insanaaşilqa ver abayle. <verse eid="ECC 8:9"/><verse number="10" style="v" sid="ECC 8:10"/>Qiyğa zak'le hapt'ıyn pisın insanar k'eebaxhe g'avcu. Man insanar muq'addasne cigeeqa abı-avayk'an vuxha. Mane şaharee manbışik'le yugunbıva eyhe ıxha. Manıd q'əran vuççud deşin kar vodun.<verse eid="ECC 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11"/>Pisvalla hav'uyng'us cazaa cigeecab g'its'dyaak'vanang'a, insanaaşis sık'ılbab geeb pisvalla haa'as vukkiykan. <verse eid="ECC 8:11"/><verse number="12" style="v" sid="ECC 8:12"/>Pisde insanee vəşne yəqqee pisın hı'ı, xıliyna ı'mı'r haa'a. Zak'leme ats'an, Allahıle qəvəyq'ənanbışik'le yugvalla g'avcesva. <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>Pisde insanık'le yugvalla g'avces deş. Mana Allahıle qı'dəyq'ənva, mang'una əqqı'k akarana ı'mı'rıb xıliy qaa'as deş.<verse eid="ECC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>İnəxdınıd ç'iyene aq'val q'əran vuççud deşin kar vodun: qopkune insanaaşis gexhan karbı pisde insanaaşis eyxhe, pisde insanaaşis gexhan karbıd qopkune insanaaşis eyxhe. Zı uvhuyn: «Manıd q'əran vuççud deşin kar vodun!» <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>Məxüb zı xoşbaxtıyvalla gırgınçile ooqa avqu. Xəək avud insannemee otxhun-ulyodğuyleyiy xoşbaxtiyvalile yugun kar deşin. Allahee xəək avub insanıs ı'mı'r huvu. Mane ı'mree qorxuyiy xoşbaxtıyvalla alivkasda.<verse eid="ECC 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16"/>Zıcar zı g'aysırna k'orana ək'eliy insanaaşe ha'an işbı xət qeetxhes. Xəm-yiğ yizde ulyaqa nyak' idyatk'ın, zı mane işbışiqa ilyakkı. <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>Manke zak'le Allahın gırgın işbı g'acuynbı. Zak'le ats'axhxhayn, şavulqacad xəək avud g'ecen işbı hixharas deş. Nimeecar mana qorxveeyir, mang'ulqa meed hixharas deş. K'orane ək'elynane insanee man cuk'le ats'anva uvheeyid, meed man mang'ulqa hiyxhar deş.<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s">Gırgın Allahne xıle vod</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>Mane gırgınçina zı hav'u, ine fıkrelqa qarı: qopkuynbı, k'oran ək'elynanbıyiy manbışe ha'an gırgın işbı Allahne xıle vod. İnsanık'le vuc ıkkiykanasdame, g'ımeceme ixhes ats'a deş. <verse eid="ECC 9:1"/><verse number="2" style="v" sid="ECC 9:2"/>Gırgıng'une vuk'lelqa sa kar qales:</para>
  <para style="q1" vid="ECC 9:2">qopkuynbışde, pisınbışde,</para>
  <para style="q2" vid="ECC 9:2">yugunbışde,</para>
  <para style="q1" vid="ECC 9:2">məttınbışde, gicərxı'y deşinbışde,</para>
  <para style="q2" vid="ECC 9:2">q'urban ablyaa'anbışde, q'urban g'idyook'anbışde.</para>
  <para style="q1" vid="ECC 9:2">Yugne insanık eyxhen, bınahnang'ukud eyxhen.</para>
  <para style="q2" vid="ECC 9:2">K'ın g'iysarang'uk eyxhen, k'ın g'aysaras qəyq'əng'ukud eyxhen.<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>Xəək avub vooxhene gırgıng'une vuk'lelqa in pisın divan qadayle. Hək'edad, insanaaşin yik'bı pisvalika gyatsts'ı vod. Nimeena ı'mı'riy haa'a, manimeeyib manbışe bəç'əriyvalla haa'a. Qiyğaleb hapt'ı avayk'ananbı. <verse eid="ECC 9:3"/><verse number="4" style="v" sid="ECC 9:4"/>İnsanee nimeena ı'mı'r hav'ee, mang'unemee umud vobna. Üç'übna xvaa qik'uyne şirıle yugba dişde vob?<verse eid="ECC 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5"/>Üç'übınbışik'le hapt'asva ats'an,</para>
  <para style="q2" vid="ECC 9:5">hapt'ıynbışik'leme vuççud ats'a deş.</para>
  <para style="q1" vid="ECC 9:5">Manbışis helen-qelenıd ixhes deş,</para>
  <para style="q2" vid="ECC 9:5">manbı yik'el hipxınva.<verse eid="ECC 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6"/>Hapt'ıynbışin vukkiykın vuxhayib,</para>
  <para style="q2" vid="ECC 9:6">g'umooce vuxhayib,</para>
  <para style="q2" vid="ECC 9:6">manbışiqa naps ıxhayid deşxhayn xhinnee atk'ınin.</para>
  <para style="q1" vid="ECC 9:6">Xəək avud g'ecene işbışee,</para>
  <para style="q2" vid="ECC 9:6">manbışda xıl mısacab vuxhes deş.<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>Gıney xoşbaxtda oxhne, çaxırıd şadne yik'eka ulyoğe. Man Allahne yik'eençe vod. <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>Hasre yiğne tanalin gırgıne gahbışil cagvarada ixhecen, vuk'lelin ətriyyatıd k'ıl qimexhecen. <verse eid="ECC 9:8"/><verse number="9" style="v" sid="ECC 9:9"/>Xəək avud Allahee vas huvuyn gırgın yiğbı yikkanne xhunaşşeyka yugda alğehe. Yiğna ı'mı'r sık'ınne gahıs ıxha-ayk'anne booğak akar. I'mreke, xəək avur qorxuyke vas axvasın man vod. <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>Vasse əxən gırgın he'e. Ğu əəsde ahalee işniy, fıkırniy, ats'alyniy, k'orana ək'elyniy vuxhes deş.<verse eid="ECC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11"/>Xəək avud zak'le sa medın karıd g'acuyn:</para>
  <para style="q1" vid="ECC 9:11">G'adapxhınee hammaşe yugra g'adayxhvanna deş ğamexhe.</para>
  <para style="q2" vid="ECC 9:11">Dəv'eeyib hammaşe igidyar deş ğameebaxhe.</para>
  <para style="q1" vid="ECC 9:11">Gıney hammaşe k'orane ək'elynanbışiqa geed deş eyxhe,</para>
  <para style="q2" vid="ECC 9:11">karıd ək'elynanbışiqa hammaşe geed eyxhen deş.</para>
  <para style="q1" vid="ECC 9:11">Hı'rmatıb aalimaaşis deş haa'a.</para>
  <para style="q2" vid="ECC 9:11">Gırgın vaxtıkeyiy xıleqa gipxhıyne imkanıke eyxhe.<verse eid="ECC 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12"/>İnsanık'le cuna gah mısa qavaales vuxhay ats'a deş.</para>
  <para style="q1" vid="ECC 9:12">Baluğar g'ıttidiyxhanasde toreeqa,</para>
  <para style="q2" vid="ECC 9:12">şit'yarıd gugeeqa gyadak'van xhinne,</para>
  <para style="q1" vid="ECC 9:12">insanılqab ver abıyn yiğxhe eyxhe,</para>
  <para style="q2" vid="ECC 9:12">sayangada vuk'lelqa qadaylen.<verse eid="ECC 9:12"/></para>
  <para style="s">K'orane ək'elyneyiy bəç'əriyvaline hək'ee</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>Zak'le xəək avud medınıd k'orane ək'elika hı'iyn xədın kar g'acuyn. <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>İnsanar k'ılyba vooxhena şahariy. Sa gucnana paççah mane şaharılqa arı, mana hiqiy-allançe avqaaqqana. Mana avqas vuxhecenva mane şaharne hiqiy-alla xılece işbıd g'ecenbı. <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>Maa'ar kar deşda, k'orane ək'elikana insan eyxhe ıxha. Mang'vee cune k'orane ək'elika şahar g'attivxhan haa'a. Mançile qiyğa mana şavuscar yik'el qarayle deş. <verse eid="ECC 9:15"/><verse number="16" style="v" sid="ECC 9:16"/>Mane gahıl zı uvhuyn: «K'orana ək'el gucule yugba vob». K'orane ək'eliqane kar deşde insanıqa ooğançe avqa ilyaaka, mang'vee eyhen cuvab neng'veecad qizar ha'a deş.<verse eid="ECC 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17"/>G'idiyxhe eyhen k'orane ək'elikang'un cuvab,</para>
  <para style="q2" vid="ECC 9:17">bəç'əraaşine xərıng'une ts'irıle yugda g'iyxhe.<verse eid="ECC 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18"/>K'orana ək'el silahıle yugba vob,</para>
  <para style="q2" vid="ECC 9:18">sa bınahınmee geed yugun agval ha'a.<verse eid="ECC 9:18"/></para>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="s">K'orane ək'elikan uvhiybı</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1"/>Sa qivk'uyne xı'nit'iyn</para>
  <para style="q2" vid="ECC 10:1">yugne ətirıkın ha'an.</para>
  <para style="q1" vid="ECC 10:1">Həməxdıd k'ınne bəç'əriyvalin</para>
  <para style="q2" vid="ECC 10:1">k'orane ək'elikıniy hı'rmatıkın ha'an.<verse eid="ECC 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2"/>K'orane ək'elynane insanne yik'en qorkune suralqa ts'ıts'a'a,</para>
  <para style="q2" vid="ECC 10:2">bəç'ər insanneme yik'en quç'orkune.<verse eid="ECC 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3"/>Mang'una bəç'əriyvalla</para>
  <para style="q2" vid="ECC 10:3">yəq' əlyhəəng'əb vaats'a vooxhena.</para>
  <para style="q2" vid="ECC 10:3">Gırgıng'uk'le mana nimee bəç'ər ıxhay g'ecen.<verse eid="ECC 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4"/>Xərıng'una valqa qəl avqee, himexva.</para>
  <para style="q1" vid="ECC 10:4">Cusse vuc aqqas əxəng'une</para>
  <para style="q2" vid="ECC 10:4">geebne bınahbışike ılyheebaç'enbı.<verse eid="ECC 10:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5"/>Xəək avub zak'le sa mebna verıb g'avcuna: qotkuda hidi'iyn kar cuke paççahıke vodun.<verse eid="ECC 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6"/>Ək'el deşinbı ç'ak'ıne işbışilqa giviyxhe,</para>
  <para style="q2" vid="ECC 10:6">karnanbışeme avudun cigabı aqqaqqa.<verse eid="ECC 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7"/>Zak'le nukarar balkanıl oo,</para>
  <para style="q2" vid="ECC 10:7">ç'ak'ınbıb nukarar xhinne iviykar əlyhəə g'avcu.<verse eid="ECC 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8"/>Xandak' ilyviyk'arna</para>
  <para style="q2" vid="ECC 10:8">xandak'eeqa k'eyxhas əxə.</para>
  <para style="q1" vid="ECC 10:8">Çabır qoytalang'ukub</para>
  <para style="q2" vid="ECC 10:8">xoçe üvxəs vəəxə.<verse eid="ECC 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9"/>G'aye gyabaxanar</para>
  <para style="q2" vid="ECC 10:9">g'ayeysse qoxa'as əxə.</para>
  <para style="q1" vid="ECC 10:9">Os qaxanar</para>
  <para style="q2" vid="ECC 10:9">osasse qoxa'as əxə.<verse eid="ECC 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10"/>Yak'v ek'da deşxhee,</para>
  <para style="q2" vid="ECC 10:10">man ek'a'asıd hidevuxheene,</para>
  <para style="q2" vid="ECC 10:10">mançis geeb guc əlyhəəs.</para>
  <para style="q1" vid="ECC 10:10">K'orane ək'elisseme</para>
  <para style="q2" vid="ECC 10:10">man kar qa'as əxə.<verse eid="ECC 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11"/>Xoçe avqas vəəxəna ayresse xoçe üvxee,</para>
  <para style="q2" vid="ECC 10:11">mana nişiscarne qoyt'al.<verse eid="ECC 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12"/>K'orane ək'elynane insanne ghalençe</para>
  <para style="q2" vid="ECC 10:12">yugun cuvabxhe qığeç'en.</para>
  <para style="q1" vid="ECC 10:12">Ək'el deşing'une mizenmee</para>
  <para style="q2" vid="ECC 10:12">mang'ukun ha'anxhe.<verse eid="ECC 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13"/>Mang'un yuşan hı'iyid</para>
  <para style="q2" vid="ECC 10:13">ək'el deşvalika giyğal.</para>
  <para style="q1" vid="ECC 10:13">Yuşan hı'iyid</para>
  <para style="q2" vid="ECC 10:13">xənne bəç'əriyvalika ç'əvexhe.<verse eid="ECC 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 10:14"/>Ək'el deşda insan</para>
  <para style="q2" vid="ECC 10:14">geerxhe yuşan ha'ana.</para>
  <para style="q1" vid="ECC 10:14">Şavuk'lecadıd vuk'lelqa qalesın ats'a deş.</para>
  <para style="q1" vid="ECC 10:14">Şavusse cule qiyğa</para>
  <para style="q2" vid="ECC 10:14">hucoo ixhesınçina eyhes əxəyee?<verse eid="ECC 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15"/>Ək'el deşinbışe ts'ıts'av'uyne əq'übayn,</para>
  <para style="q2" vid="ECC 10:15">cocab oozar haa'a.</para>
  <para style="q1" vid="ECC 10:15">Manbışik'le şaharılqa əlyhəəna yəqı'b</para>
  <para style="q2" vid="ECC 10:15">vaats'a deş.<verse eid="ECC 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16"/>Yiğna paççah nukaraaşine nasılınaxheene,</para>
  <para style="q2" vid="ECC 10:16">ç'ak'ınbıb miç'eeb çakba, otxhan-ulyoğa giviyğalxhee,</para>
  <para style="q2" vid="ECC 10:16">ölka, vay vak ixhesın!<verse eid="ECC 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17"/>Yiğna paççah qıvaats'ıyne nasılınaxheene,</para>
  <para style="q2" vid="ECC 10:17">ç'ak'ınbışed çine gahıl,</para>
  <para style="q2" vid="ECC 10:17">ulyoğasva deş, guc saa'asva otxhanxhee,</para>
  <para style="q1" vid="ECC 10:17">ölka, vaqa yugun yiğbı ixhes!<verse eid="ECC 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18"/>İnsan tambalraxhee,</para>
  <para style="q2" vid="ECC 10:18">mang'una daxaxhe giviy'arna.</para>
  <para style="q1" vid="ECC 10:18">Nenacab iş g'idevceene,</para>
  <para style="q2" vid="ECC 10:18">xaane daxayle xhyan k'yak'anas.<verse eid="ECC 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19"/>Otxhun-ulyodğuy yik'es ıkkanva ha'a,</para>
  <para style="q2" vid="ECC 10:19">çaxıren ı'mı'res rang hele.</para>
  <para style="q1" vid="ECC 10:19">Pılınmee vas ıkkanan gırgın ha'an.<verse eid="ECC 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20"/>Paççahıqa yik'eeyid humoka,</para>
  <para style="q2" vid="ECC 10:20">karnane insanne hək'ee</para>
  <para style="q2" vid="ECC 10:20">ğu g'ılexhane cigeeyid pisın immeyhe.</para>
  <para style="q1" vid="ECC 10:20">Xəə ileedaxvane şit'yaaşe xabar vukkees,</para>
  <para style="q2" vid="ECC 10:20">mançisse ğu uvhuyn cuvab hixhar ha'as əxə.<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s">İnsanaaşik'le vuk'lelqa qalesın ats'a deş</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1"/>Yiğın gıney xhinel ooqa g'aykke,</para>
  <para style="q1" vid="ECC 11:1">xılece gah ılğevç'uyle qiyğa,</para>
  <para style="q2" vid="ECC 11:1">vak'le man meed aveykesın.<verse eid="ECC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2"/>Yighneyee, molyneyee</para>
  <para style="q2" vid="ECC 11:2">insanıs vaqa vodunçike pay hevle.</para>
  <para style="q1" vid="ECC 11:2">Vak'le ölkayne vuk'lelqa ablesda</para>
  <para style="q2" vid="ECC 11:2">verıb vaats'a deş.<verse eid="ECC 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3"/>Buludbı xhineka gyatsts'ı ixhee,</para>
  <para style="q2" vid="ECC 11:3">mançin ç'iyene aq'valqa gyoğiy gikkas.</para>
  <para style="q1" vid="ECC 11:3">Yiv canubulqayee, şimalılqayee hı'ğəpkıree,</para>
  <para style="q2" vid="ECC 11:3">mane qukk'yopk'ulne cigeeyib aaxvasda.<verse eid="ECC 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4"/>Mıtsıqa ilyakkang'vee toxum üvxüyxəna deş.</para>
  <para style="q1" vid="ECC 11:4">Buludbışiqa ilyakkang'ussed ezuyn qiyşalas əxəs deş.<verse eid="ECC 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5"/>Vak'le mıtsın yəqbı ats'a deş,</para>
  <para style="q1" vid="ECC 11:5">vuxhnene zəiyfayne vuxhne</para>
  <para style="q2" vid="ECC 11:5">nəxüdiy bark'vbıd ç'ak'ı qeetxhay</para>
  <para style="q3" vid="ECC 11:5">şavuk'lecad ats'a deş.</para>
  <para style="q1" vid="ECC 11:5">Məxı'dıd vas gırgın itxhınne Allahne işbışike xabar deş.<verse eid="ECC 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6"/>Toxum miç'eeb üvxe,</para>
  <para style="q2" vid="ECC 11:6">exhalilqameeyid xıleppı iş dena g'ılyma'a.</para>
  <para style="q1" vid="ECC 11:6">Vak'le ats'a deş inme, şenme</para>
  <para style="q2" vid="ECC 11:6">şagav yugda ixhes,</para>
  <para style="q2" vid="ECC 11:6">deşxheene, q'öyudsaname yugda ixhes.<verse eid="ECC 11:6"/></para>
  <para style="s">Ğu İrxhınna yik'el hixan hıma'a</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7"/>Hək'edad işix micagda vod,</para>
  <para style="q2" vid="ECC 11:7">verığ g'avciy uleppışisqa yugba qöö.<verse eid="ECC 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8"/>İnsanee xıliyna ı'mı'r haa'axhee,</para>
  <para style="q2" vid="ECC 11:8">hasre şadba hee'ecen.</para>
  <para style="q1" vid="ECC 11:8">Pisın yiğbı ıxhayid yik'el hixan hıma'acen,</para>
  <para style="q2" vid="ECC 11:8">pisın yiğbı geedbı ixhes.</para>
  <para style="q1" vid="ECC 11:8">Vuk'lelqa qalesın gırgın kar</para>
  <para style="q2" vid="ECC 11:8">q'əran vuççud deşin kar vod.<verse eid="ECC 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9"/>Şadxhe mek'vna, nimeeletteyiy mek'vra.</para>
  <para style="q2" vid="ECC 11:9">Mek'vranang'a yiğın yik' şade'e.</para>
  <para style="q1" vid="ECC 11:9">Yik'es ıkkanne, uleppışik'le g'ecene</para>
  <para style="q2" vid="ECC 11:9">cigeeqa hoora.</para>
  <para style="q1" vid="ECC 11:9">Vak'le manıd ats'axhxhe,</para>
  <para style="q2" vid="ECC 11:9">mane gırgınçil-alla Allahee</para>
  <para style="q3" vid="ECC 11:9">ğu məhkameeqa ts'ıts'a'as.<verse eid="ECC 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10"/>Mançil-allad aq'va qıma'a,</para>
  <para style="q2" vid="ECC 11:10">ık'arbı vake əq'əna hee'e.</para>
  <para style="q1" vid="ECC 11:10">Mek'vallab, mek'valeena gucub</para>
  <para style="q2" vid="ECC 11:10">ıxha-ayk'anne booğak akar.<verse eid="ECC 11:10"/></para>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1"/>Mek'vranang'a ğu İrxhınna yik'el qale'e.</para>
  <para style="q2" vid="ECC 12:1">Qiyğa pisın yiğbı qadımee, ğu eyhesın:</para>
  <para style="q1" vid="ECC 12:1">«Həşde yizın kef nişikecad ooqa qexhe deş».<verse eid="ECC 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2"/>Manke verığın, vazın,</para>
  <para style="q2" vid="ECC 12:2">xənebışin işix yiğnemee k'ətqəsın,</para>
  <para style="q1" vid="ECC 12:2">gyoğiyle qiyğa, meed buludbı sak'alas.<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">İne cigee (12:2-6) curayne-curayne misaalabışika insanne vuk'lelqa q'əsvalee qalesın hagva.</char></note><verse eid="ECC 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3"/>Man yiğ qadımee,</para>
  <para style="q2" vid="ECC 12:3">xaaka ilyaakanbışik zeze avkkas,</para>
  <para style="q1" vid="ECC 12:3">gucnanbı k'yooç'anasınbı,</para>
  <para style="q1" vid="ECC 12:3">giviyxəranbışisse co k'ılybava</para>
  <para style="q2" vid="ECC 12:3">suk giviyxəras vəəxəs deş,</para>
  <para style="q1" vid="ECC 12:3">g'uleppışile ilyaakanbışik'le</para>
  <para style="q2" vid="ECC 12:3">miç'axda g'aces.<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">İnyaa «xaaka ilyaakanbıyiy gucnanbıva» xıleppışik'leyiy g'elybışik'le eyhe, «giviyxəranbıva» silibışik'le, «g'uleppışile ilyaakanbıvad» uleppışik'le eyhe.</char></note><verse eid="ECC 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4"/>G'aqa aaqan akkabı it'umeedxhesınbı,</para>
  <para style="q2" vid="ECC 12:4">yöxxəbışin sesbı k'ıl qeetxhes.</para>
  <para style="q1" vid="ECC 12:4">Ğu şit'yaaşine sesbışikar çikana muğur qıxhes,</para>
  <para style="q2" vid="ECC 12:4">mə'niybı qədəqqəne içeeşin k'ılda g'ayxhes.<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">İnyaa «g'aqa aaqan akkabıva» k'ırıbışik'le eyhe. İnyaa sayid q'əsınbışik'le pisda g'iyxhe, manbı pisba g'alyabak'ava eyhe.</char></note><verse eid="ECC 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5"/>Ğu manke axtıne cigabışile qəq'ənasda,</para>
  <para style="q2" vid="ECC 12:5">yəq əlyhəəsır qəq'ənasda.</para>
  <para style="q1" vid="ECC 12:5">Badamne yiven t'et' g'ayhe,</para>
  <para style="q2" vid="ECC 12:5">ts'irtyar yı'q' qeetxhes<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">İnyaa «badamne yiven t'et' g'ayheva» vuk'lelyne cagvarane ç'ərbışik'le eyhe, «ts'irtyar yı'q' qetxhesvad» q'əs qıxha, ek'ra ı'ğviykaras dəvxüyle eyhe.</char></note>,</para>
  <para style="q2" vid="ECC 12:5">naps k'ıl qixhes.</para>
  <para style="q1" vid="ECC 12:5">Məxür insan cune gırgıne gahbışilyne xaaqa əlyhəə,</para>
  <para style="q2" vid="ECC 12:5">ak' avquynbı şahrabışeeqa k'yoohar.<verse eid="ECC 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6"/>Nuk'rayn baağar qudyodu,</para>
  <para style="q2" vid="ECC 12:6">k'ınəəğəyna kasa hidyapq'ır,</para>
  <para style="q1" vid="ECC 12:6">xhyan ı'lqəəne cigaysneedın</para>
  <para style="q2" vid="ECC 12:6">parç xüvə-xüvəna qıdexha,</para>
  <para style="q2" vid="ECC 12:6">kahrızılin çarx hidyatq'ur<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">İnyaa qik'uyne hək'ee eyhe.</char></note></para>
  <para style="q1" vid="ECC 12:6">ğu İrxhınna yik'el qale'e.<verse eid="ECC 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7"/>Manke nyuq'vneke hıiyn tan</para>
  <para style="q2" vid="ECC 12:7">nyuq'vnelqa sak'alas,</para>
  <para style="q1" vid="ECC 12:7">ı'mren nafasıd</para>
  <para style="q2" vid="ECC 12:7">yic huvuyne Allahısqa sak'alas.<verse eid="ECC 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="ECC 12:8"/>Mə'əllimee eyhen:</para>
  <para style="q1" vid="ECC 12:8">– Q'əran vuççud deşin kar!</para>
  <para style="q1" vid="ECC 12:8">Gırgın ıxha-ayk'anne booğak akar vod!<verse eid="ECC 12:8"/></para>
  <para style="s">Nekke qiyğiyn cuvab</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>Mə'əllim k'orana ək'elynana insan ıxha, mang'vee milletıs ats'aalid hele ıxha. Mang'vee geeb fıkır opxhun, geed ək'elikan kar qiyghın, geed misaalabı sı'ı, otk'un. <verse eid="ECC 12:9"/><verse number="10" style="v" sid="ECC 12:10"/>Mə'əllimıs micagın uvhiybı t'abal ha'as ıkkiykın. Mang'vee otk'uninbı qotkuda hək'eda vod.<verse eid="ECC 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11"/>K'orane ək'elynanbışe eyhenbı çobanna çümq xhinne, manbışe sı'iyn cuvabbıd it'umda ı'xiyn g'adaxbı xhinne vod. Man eyhen cuvabbı sa çobanee uvhuynbı vod. <verse eid="ECC 12:11"/><verse number="12" style="v" sid="ECC 12:12"/>Mançile ğayrı, dix, ğu inçilqa fıkır hevle: nimeen ıxhay kitabbı ok'anas eyxhe, geed qətqiynır insan ozarxhe ha'ana.<verse eid="ECC 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13"/>Həşde ğu nekke qiyğiyne cuvabıl k'ırı alixhxhe:</para>
  <para style="q1" vid="ECC 12:13">Allahıle qəq'ne, Mang'vee eyhen he'e.</para>
  <para style="q2" vid="ECC 12:13">İnsanee ts'etta ha'asın man vod.<verse eid="ECC 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14"/>Allahee gırgın işbı,</para>
  <para style="q2" vid="ECC 12:14">dyugulenın gırgın kar</para>
  <para style="q2" vid="ECC 12:14">– yugun ixheeyid, pisın ixheeyid –</para>
  <para style="q1" vid="ECC 12:14">məhkameençe alğahas.<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
