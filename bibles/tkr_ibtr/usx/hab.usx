<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">– Tsakhur</book>
  <para style="toc3">Habaquq</para>
  <para style="toc2">Habaquq</para>
  <para style="toc1">Habaquq peyğambarın kitab</para>
  <para style="mt1">Habaquq peyğambarın kitab</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />Allahee Cus ıkkanan Habaquq peyğambarıs gyagva'a.<verse eid="HAB 1:1" /></para>
  <para style="s">Habaquqna ts'eppiyna şikayat</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />Mısılqameene Rəbb zı Ğu kumagıs qot'alas,</para>
  <para style="q2" vid="HAB 1:2">Vak'leme man g'iyxhe deş?</para>
  <para style="q1" vid="HAB 1:2">«Hopç'un-g'opç'uniy vodva» zı Valqa ts'ir haa'a,</para>
  <para style="q2" vid="HAB 1:2">Ğume şi g'attivxhan haa'a deş.<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />Nya'a Ğu zak'le verbı hagva?</para>
  <para style="q2" vid="HAB 1:3">Nəxürne Ğu pisde karas öörəxə?</para>
  <para style="q1" vid="HAB 1:3">Nyaqa ilyakkee, hopç'un-g'opç'uniy, hı'ğəkkar hı'iy vod,</para>
  <para style="q2" vid="HAB 1:3">saç'uvkiyiy uğoodiy ç'əvexhecad deş.<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />Mançil-allab Q'aanunuqa guc avxu deş,</para>
  <para style="q2" vid="HAB 1:4">qopkuvallab apk'ınna.</para>
  <para style="q1" vid="HAB 1:4">Pisınbışe qopkuynbı xuda avqu,</para>
  <para style="q2" vid="HAB 1:4">mançil-allad qotkuyn məhkamabı eyxhe deş.<verse eid="HAB 1:4" /></para>
  <para style="s">Rəbbin alidghıniy</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />Menne milletbışiqa ilyaake,</para>
  <para style="q2" vid="HAB 1:5">g'acuynçike ghalybı aaqı aaxve.</para>
  <para style="q1" vid="HAB 1:5">Vuşde gahıl Zı məxdın işbı g'aces,</para>
  <para style="q2" vid="HAB 1:5">man şos yuşan he'eeyid, şu hayeepxhes deş.<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />Haane, Zı Baabil eyhene ölkeençe</para>
  <para style="q2" vid="HAB 1:6">Xaldeyarva eyhen millet g'elil qaa'a.</para>
  <para style="q1" vid="HAB 1:6">Man dyunyeyn aq'vavolle hoyharan,</para>
  <para style="q2" vid="HAB 1:6">menne milletbışin cigabı aqqaqqan,</para>
  <para style="q2" vid="HAB 1:6">g'ayeyn yik'nan, gissara'as dexhen millet vod.<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />Gırgınbıcab manbışile qəvəyq'ənanbı,</para>
  <para style="q2" vid="HAB 1:7">qopkuvallayiy q'aanun co eyhena vob.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />Manbışin balkanar bahalın umulybıyiy</para>
  <para style="q2" vid="HAB 1:8">gepardbı xhinne zarada g'adayxhvan,</para>
  <para style="q1" vid="HAB 1:8">Manbışin balkanaaşil aleepxıynbı əq'ənançe qöö,</para>
  <para style="q2" vid="HAB 1:8">q'aacir çis aqqas ıkkanne karalqa zaraba qöön xhinne, qöö vob.<verse eid="HAB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 1:9" />Manbı g'ayşes, q'əra qaa'asva qöö.</para>
  <para style="q2" vid="HAB 1:9">Manbı sahreençe aa'ana it'umna mıts xhinne inyaqa qöö vobunbı.</para>
  <para style="q2" vid="HAB 1:9">Əsirna avquynbı manbışe g'um xhinne saa'a.<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />Paççahaaşile manbışe əqənabı ha'a,</para>
  <para style="q2" vid="HAB 1:10">ç'ak'ınbı manbışe demalqa giviyxhe.</para>
  <para style="q1" vid="HAB 1:10">G'alabınan şaharbı matsxar ha'a,</para>
  <para style="q2" vid="HAB 1:10">mançine hiqiy-alla nyaq'v k'yav'u, manbı aqqaqqanbı.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />Manbı mıts xhinne qabı-ılğeepç'ı avayk'an.</para>
  <para style="q2" vid="HAB 1:11">Manbışe cone gucuk'le allahva eyhe.</para>
  <para style="q2" vid="HAB 1:11">Mançil-alla mane milletıl bınah aaxvas.<verse eid="HAB 1:11" /></para>
  <para style="s">Habaquqna q'öb'esda şikayat</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />Rəbb, yizda Allah, gırgıne gahbışil vorna Ğu dişde vor?</para>
  <para style="q2" vid="HAB 1:12">Yizda Muq'addasna, Ğu gırgıne gahbışilycar ixhesda.</para>
  <para style="q1" vid="HAB 1:12">Rəbb, şas cazaa hevlesva, Ğu manbı g'əvxü.</para>
  <para style="q2" vid="HAB 1:12">Yişin Ganz, Ğu manbı şalqa g'uxoole.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />Yiğın uleppı geed məttıda vod, Vak'le pisın g'ımece vod.</para>
  <para style="q2" vid="HAB 1:13">Pisde karas Vasse öörxəs əxə deş.</para>
  <para style="q1" vid="HAB 1:13">Xayaanat ha'anbışiqa Ğu nəxürna ilyakka?</para>
  <para style="q2" vid="HAB 1:13">Pisınbışe cole yugunbışda vuk'ul opxhanmee,</para>
  <para style="q2" vid="HAB 1:13">nya'a Ğu nıq' qığdyayhe?<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />Ğu insanar deryahbışeene baluğaaşik akar qav'u.</para>
  <para style="q2" vid="HAB 1:14">Ç'ak'ınbı deşde hadağvane karbışik akar hav'u.<verse eid="HAB 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />Duşmanaaşe manbışin gırgınbı baluğar xhinee g'armaxıka ts'ıts'aa'a,</para>
  <para style="q2" vid="HAB 1:15">toreeqa sav'u, alqaa'a.</para>
  <para style="q2" vid="HAB 1:15">Manbı mançile şadeebaxhenbı.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />Mançil-allab manbışe cone torbışis q'urban ablyaa'a,</para>
  <para style="q2" vid="HAB 1:16">ətirbı gyoxhxhan ha'a.</para>
  <para style="q1" vid="HAB 1:16">Mane torbışil-alla manbışiqa geed otxhuniy eyxhe,</para>
  <para style="q2" vid="HAB 1:16">coyub gyavts'u-gyuvxhu vooxhe.<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />Manbışe tor mısılqameene haç'a'as,</para>
  <para style="q2" vid="HAB 1:17">milletbı rəhı'm dena gılıncıke alğaa'as?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />G'aravulyçiy xhinne ulyozarasda,</para>
  <para style="q2" vid="HAB 2:1">g'aleeqa ılqeç'u, ulyozarasda.</para>
  <para style="q1" vid="HAB 2:1">İlyakkas, Rəbbee zak'le hucooyiy eyhes,</para>
  <para style="q2" vid="HAB 2:1">ilyakkas, yizde şikayatbışis nen alidghıniyiy qeles?<verse eid="HAB 2:1" /></para>
  <para style="s">Rəbbin q'öd'esın alidghıniy</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />Rəbbee zas inəxdın alidghıniy quvu:</para>
  <para style="q1" vid="HAB 2:2">«Vas dyaguyn ok'ne, yugda g'ayebışil ok'ne.</para>
  <para style="q2" vid="HAB 2:2">Hasre gırgıng'usse man vaxxariyda qətqəs əxecen.<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />İn vas dyaguyn sabara gahıle ixhes.</para>
  <para style="q2" vid="HAB 2:3">Mançin gırgın kar nəxüdiy ç'əvxhesva eyhe,</para>
  <para style="q2" vid="HAB 2:3">mançin hor deş ha'a.</para>
  <para style="q1" vid="HAB 2:3">Man sabara gahna dexheeyid, gozet he'e,</para>
  <para style="q2" vid="HAB 2:3">man qıdyadı axvas deş,</para>
  <para style="q2" vid="HAB 2:3">man çine gahıl qalesın.<verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />İne ooğançe-avqa ilyaakanbışiqa ilyaake:</para>
  <para style="q2" vid="HAB 2:4">manbışin rı'h qotkuyn deş vod,</para>
  <para style="q2" vid="HAB 2:4">qorkung'veeme cune imanıl-alla ı'mı'r haa'as.<verse eid="HAB 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />Mane ooğançe-avqa ilyaakanbışis çaxıren horbı ha'a,</para>
  <para style="q2" vid="HAB 2:5">man insanar vuççud hidi'ı ulyoozaras deş.</para>
  <para style="q1" vid="HAB 2:5">Manbışde mıssıne ules ıkkanan ahal xhinne xət qexhe,</para>
  <para style="q2" vid="HAB 2:5">hapt'ıy xhinne ayts'e deş.</para>
  <para style="q1" vid="HAB 2:5">Manbışe gırgın milletbı col k'ırı alixhxhes ilekka,</para>
  <para style="q2" vid="HAB 2:5">gırgın milletbı əsirna alyaat'a.<verse eid="HAB 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="HAB 2:6" />Əsirna alyapt'ıynbışe manbı demalqa gyuvxhes,</para>
  <para style="q2" vid="HAB 2:6">manbışde hək'ee yik'ek qetan anekdotbı eyhes:</para>
  <para style="q1" vid="HAB 2:6">„Con deşin, cone xılelqa alğayhenbışik,</para>
  <para style="q2" vid="HAB 2:6">şib alyaat'u, karanbı vooxhenbışik vay ixhesınbı!“</para>
  <para style="q2" vid="HAB 2:6">Man mısılqameene ixhes?<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />Şos şib helenbı sa yiğıl g'elil qeepxhes dişde?</para>
  <para style="q2" vid="HAB 2:7">Muğur qeepxha, şu qəvəəq'ən haa'as dişde?</para>
  <para style="q2" vid="HAB 2:7">Mane gahıl şu manbışde k'onalqa savaak'alas.<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />Şu geed milletbı q'əra qı'ı,</para>
  <para style="q2" vid="HAB 2:8">şu insanaaşina eb k'yav'u,</para>
  <para style="q2" vid="HAB 2:8">ölkabışilqayiy şaharbışilqa, maa'ab vooxhenbışilqa geed yiğbı alli'ı.</para>
  <para style="q1" vid="HAB 2:8">Mançil-allab milletbışike üç'übba avxuynbışeb şu q'əra qaa'as.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />Xaybı haramne karaka gyatsts'ı'iynbışik,</para>
  <para style="q2" vid="HAB 2:9">ver ımmalecenva, akvaa axtıne cigabışee ali'iynbışik vay ixhesınbı!<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />Şu geed milletbı gyatxıyka vuşun xav k'ap'ik'ıle avqa qı'ı.</para>
  <para style="q2" vid="HAB 2:10">Şu mançina bınah ı'mreka qevles.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />Çabırbışeene g'ayebışe mançil-alla ts'ir haa'as,</para>
  <para style="q2" vid="HAB 2:11">alaxaraaşe mançis alidghıniy qeles!<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />Şahar ebal alyav'uynbışik,</para>
  <para style="q2" vid="HAB 2:12">mana pisvalika it'um qav'uynbışik vay ixhesınbı!<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />İnsanaaşe q'ərane cigee cocab-co oozar haa'as.</para>
  <para style="q2" vid="HAB 2:13">Milletbışe hı'iyn gırgın ts'ayee gyoxhxhanas.</para>
  <para style="q1" vid="HAB 2:13">Man gırgın Xəəne G'oşunbışde Xərıng'vee, Rəbbee ixhesva uvhu!<verse eid="HAB 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />Deryahbışee xhyan geednan xhinne,</para>
  <para style="q2" vid="HAB 2:14">insanaaşik'led gırgınəəng'ə Rəbbine xəbvaline hək'ee geed ats'axhxhes.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />Mebınbışin ts'elen tanbı g'acesva,</para>
  <para style="q2" vid="HAB 2:15">manbışis qəlın çaxır ulyoğu'ı,</para>
  <para style="q2" vid="HAB 2:15">p'iyan haa'anbışik vay ixhesınbı.<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />Hı'rmatne cigee, şu k'ap'ik'ıle avqa qeepxhes,</para>
  <para style="q2" vid="HAB 2:16">həşde şunad ulyoğe, ts'elen cigabı hagve.</para>
  <para style="q1" vid="HAB 2:16">Rəbbine sağne xılen qəlın gyatsts'ıyn k'ola, şolqad hixharasın.</para>
  <para style="q2" vid="HAB 2:16">Vuşun aq'va-xhane gyotxhuniy, qıvaats'ıyvaliled geed qixhes.<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />Şu Livanee zulum huvu, həyvanar gyat'u,</para>
  <para style="q2" vid="HAB 2:17">insanaaşinab eb k'yav'u, ölkabışilqayiy şaharbışilqa,</para>
  <para style="q2" vid="HAB 2:17">maa'ab vooxhene gırgıng'ulqa ver ablyav'u.</para>
  <para style="q1" vid="HAB 2:17">Man vuşded vuk'lelqa qalesın, şu mançile qəvəəq'ənasınbı.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />Ustadee hoots'une, k'yav'uyne byutuke, hucoo xayirne?</para>
  <para style="q2" vid="HAB 2:18">Mançin horcad xət qa'a.</para>
  <para style="q1" vid="HAB 2:18">Byut hav'une ustadee çilqa umud haa'a,</para>
  <para style="q2" vid="HAB 2:18">yicme miz deşin kar vod.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />Q'uvayk'le „Muğur qixhe!“</para>
  <para style="q2" vid="HAB 2:19">miz deşde g'ayeyk'le „Oza!“</para>
  <para style="q2" vid="HAB 2:19">eyhene insanık vay ixhesın!</para>
  <para style="q1" vid="HAB 2:19">Byutusse yəq haagvas vəəxəye?</para>
  <para style="q2" vid="HAB 2:19">Haane mançil oğa k'ınəəğəyiy nuk'ra ixheeyid,</para>
  <para style="q2" vid="HAB 2:19">çine adme ı'mren nafasıd deşin.<verse eid="HAB 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />Rəbbme Cune muq'addasne Xaa vor,</para>
  <para style="q2" vid="HAB 2:20">hasre dyunyeyncad Mang'une ögil nıq'bı aqqecen!»<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">Habaquqna düə</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1" />Peyğambar Habaquqna düə, «Şig'yonot» xhinne mə'niy qəpqəsdemee.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />Rəbb, zak'le Yiğne xəbvaline hək'ee g'ayxhı,</para>
  <para style="q2" vid="HAB 3:2">Ğu hı'iyne işbışil-alla qərq'ı'n.</para>
  <para style="q1" vid="HAB 3:2">Yişde gahılid məxdın işbı g'ace,</para>
  <para style="q2" vid="HAB 3:2">hucoon ixhes, yişde gahılid manbı hagve!</para>
  <para style="q2" vid="HAB 3:2">Yiğna şalqa qəl avqeeyib, şas rəhı'm hee'e!<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />Muq'addasna Allah canubıle,</para>
  <para style="q2" vid="HAB 3:3">Teman eyhene cigeençe,</para>
  <para style="q2" vid="HAB 3:3">Paran eyhene suvayle qöö. <char style="qs">(Sela<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">Sela: </char><char style="ft" closed="false">ine cühüt'yaaşine mizelyne cuvabna mə'na şak'le vaats'a deş. Man muzık'ayn termin vod.</char></note>)</char></para>
  <para style="q1" vid="HAB 3:3">Mang'une xəbvalin xəybı aqqı,</para>
  <para style="q2" vid="HAB 3:3">ç'iyeyne aq'val gırgınəəng'ə Mang'un do axtı qa'a.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />Mang'un hits'arghıliy verığık akar,</para>
  <para style="q2" vid="HAB 3:4">xılençe nur k'əə,</para>
  <para style="q2" vid="HAB 3:4">Mang'vee gucub xıle dyugulenba avqu.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />Hapt'asın ık'arbı Mang'une ögil əə,</para>
  <para style="q2" vid="HAB 3:5">vəbaayib Mang'une qihna qöö.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />Mana suğotsu, ç'iye ı'ğiykar hı'ı,</para>
  <para style="q2" vid="HAB 3:6">Mana ilyakkımee, milletbışin yik'bı qodasse axu.</para>
  <para style="q1" vid="HAB 3:6">Avaalıyn suvabı Mang'une ögil qukkyotk'ulıynbı,</para>
  <para style="q2" vid="HAB 3:6">şenkiyle axuyn tepabıd hı'ğətkıriynbı.</para>
  <para style="q2" vid="HAB 3:6">Allahın yəqbıme gırgıne gahbışisınbı vod.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />Zak'le g'acuyn Kuşanbışin çadırbı əq'übee vod,</para>
  <para style="q2" vid="HAB 3:7">Midyanbışdeb xaybışilqa verıb vüqqə.<verse eid="HAB 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />Rəbb, Yiğna qəl şavulqane avqu?</para>
  <para style="q2" vid="HAB 3:8">Damabışilqane? Aragbışilqane?</para>
  <para style="q2" vid="HAB 3:8">Deryahilqane? Şavulqane?</para>
  <para style="q1" vid="HAB 3:8">Ğu Yiğne balkanaaşilqa alixı,</para>
  <para style="q2" vid="HAB 3:8">Yiğın dəv'əyn daşk'abı sı'ı-qı'ı.</para>
  <para style="q2" vid="HAB 3:8">Ğu Yiğne duşmanaaşile ğamxhesva ı'qqə.<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />Ğu Yiğın vuk qığavhu,</para>
  <para style="q2" vid="HAB 3:9">çin q'ak vukbışika gyatsts'ı'ı. <char style="qs">(Sela)</char></para>
  <para style="q1" vid="HAB 3:9">Ç'iyeyn aq'va Ğu damabışika qaxı.<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />Ğu g'acu, suvabı sattitxhın,</para>
  <para style="q2" vid="HAB 3:10">xəybışeençe xhyanbı k'yatk'ın,</para>
  <para style="q1" vid="HAB 3:10">k'orane deryahın ts'ir hav'u,</para>
  <para style="q2" vid="HAB 3:10">çin mırtar xəybışeeqa alyavhu.<verse eid="HAB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />Yiğne hits'ayghar ileedaxvane vukbışike,</para>
  <para style="q2" vid="HAB 3:11">işix gyayhene nizebı xhinnene ts'ayilpanbışike,</para>
  <para style="q2" vid="HAB 3:11">verığıy vaz cigee ulyozzur.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />K'yabı Ğu ç'iyene aq'valqa g'el gixhxhı,</para>
  <para style="q2" vid="HAB 3:12">milletbı qəlıka k'öq'ü.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />Ğu, Yiğın millet g'attixhan ha'asdemee,</para>
  <para style="q2" vid="HAB 3:13">Ğu g'əyxı'na paççah g'attixhan ha'asdemee, qığeç'u.</para>
  <para style="q1" vid="HAB 3:13">Pisde nasılena xərna gik'u,</para>
  <para style="q2" vid="HAB 3:13">mana q'omançe k'anyaqqamee ts'ele qı'ı. <char style="qs">(Sela)</char><verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />Mang'une cehilyaaşis şi q'əra qaa'as vukkiykın.</para>
  <para style="q2" vid="HAB 3:14">Manbı dyuguleepxhayn mağmuler q'əra qa'an xhinneyiy şadeebaxhe.</para>
  <para style="q1" vid="HAB 3:14">Manbı mıts xhinne şi oot'al-ooxas qöömee,</para>
  <para style="q2" vid="HAB 3:14">Ğu mang'une vuk'lek nizeyka q'əç'ür hav'u.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />Ğu Yiğne balkanaaşil deryaheençe ılğeç'u,</para>
  <para style="q2" vid="HAB 3:15">mançin ç'ak'ın xhyanbı k'öq'ü, mırtar hı'ı.<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />Zak'le man g'ayxhı, yik' it'umda ı'xiyxə gidğıl,</para>
  <para style="q2" vid="HAB 3:16">Yiğne seseke pışnebı zeze atk'u.</para>
  <para style="q1" vid="HAB 3:16">Tan həlale g'a'aytxhu,</para>
  <para style="q2" vid="HAB 3:16">g'elybışeedın rı'h atk'ın.</para>
  <para style="q1" vid="HAB 3:16">İn gırgın yişde vuk'lelqa qadeeyid,</para>
  <para style="q2" vid="HAB 3:16">zı meer şalqa k'yothurne milletılqa</para>
  <para style="q2" vid="HAB 3:16">ver ablesın yiğ qalesmee sabırıka öörxəsda.<verse eid="HAB 3:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />İnciliyne yiven t'et' g'ıdyavheeyid,</para>
  <para style="q2" vid="HAB 3:17">t'ımılen şagav hideveeyid,</para>
  <para style="q2" vid="HAB 3:17">zeytunne yivel zeytun dexheeyid,</para>
  <para style="q2" vid="HAB 3:17">çolbışee vuççud ilydyadeeyid,</para>
  <para style="q2" vid="HAB 3:17">çavra-vəq'ə ağılbışee,</para>
  <para style="q2" vid="HAB 3:17">yatsbıd yits'abışee idyaxveeyid,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />zı meer Rəbbis şadxhesda,</para>
  <para style="q2" vid="HAB 3:18">zı g'attixhan ha'asde Allahıka şadxhesda.<verse eid="HAB 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />Xudaavanda Rəbb yizda guc vobna,</para>
  <para style="q2" vid="HAB 3:19">Mang'vee yizın g'elybı maralınbı xhinne ek'ınbı ha'a,</para>
  <para style="q2" vid="HAB 3:19">axtıne cigabışee zı iykar ha'a.</para>
  <para style="b" vid="HAB 3:19" />
  <para style="d" vid="HAB 3:19">Maq'amne xərıng'us. Simnane instrumentıkana mə'niy.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>