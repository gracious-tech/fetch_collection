<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">– Tsakhur</book>
  <para style="toc3">Uvh.</para>
  <para style="toc2">Sıleymanın uvhiybı</para>
  <para style="toc1">Sıleyman peyğambarın uvhiybı</para>
  <para style="mt1">Sıleyman peyğambarın k'oran uvhiybı</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">Ts'ettiyn cuvab</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />İzrailyne paççahne, Davudne dixen, Sıleymanın k'oran uvhiybı.<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Mançin k'orana ək'eliy terbiye heles,</para>
  <para style="q2" vid="PRO 1:2">k'orane ats'aalika uvhiyn cuvab alyaat'as kumag ha'as.<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Mançin ək'elikana ı'mı'r haa'as xət qa'as.</para>
  <para style="q2" vid="PRO 1:3">Manke ğu qopkuna, adaletnana ı'mı'r haa'as.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Mançin caahilyaaşis k'oraba ı'mı'r g'avces xət qa'as,</para>
  <para style="q2" vid="PRO 1:4">mek'vunbışis ats'aaliy darraka heles.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Hasre hikmatnang'vee k'ırı alixhxhı, ats'al xət qixhecen,</para>
  <para style="q2" vid="PRO 1:5">hasre ək'elikang'vee yugna mısləhət alept'ecen.<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />Məxüd insanaaşilqa dekkaaşe uvhiynbı, misaalabı,</para>
  <para style="q2" vid="PRO 1:6">hikmatnanbışe eyhenbıyiy manbışin dağamın cuvabbı hixharasınbı.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Rəbbile qəpq'ı'niy ats'alyne q'oma ulyozzur,</para>
  <para style="q2" vid="PRO 1:7">saccu bəç'əraaşik'le k'orana ək'eliy terbiye g'umooce vob.<verse eid="PRO 1:7" /></para>
  <para style="s">Bınahnanbışile əq'əna ulyobzuriy</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Yizda dix, dekkee helene terbiyel k'ırı alixhxhe,</para>
  <para style="q2" vid="PRO 1:8">yedee xət qa'anbıd yik'el hixan hıma'a.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Man yiğne vuk'lel micagın tac xhinne g'aces,</para>
  <para style="q2" vid="PRO 1:9">gardanılib gıranın t'exa xhinne ixhes.<verse eid="PRO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Yizda dix, hımaysar bınahnanbışe</para>
  <para style="q2" vid="PRO 1:10">ğu yəqqı'le qığehecen.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Manbışe vak'le eyhesın: «Qora, şaka gugu hav'u, eb k'yaa'as,</para>
  <para style="q2" vid="PRO 1:11">həməxübcab taxsir deşinbışilqa k'yooharas.<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Qora, manbı ahalın xhinne üç'übba k'ööğəs,</para>
  <para style="q2" vid="PRO 1:12">manbı bıkırba nyuq'vneeqa əlyhəənbışik akaraba vuxhecen.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Manke şi manbışike curayn-curayn gıranın karbı alyaat'as,</para>
  <para style="q2" vid="PRO 1:13">yişin xaybıd ing'une-şeng'une karaka gyatsts'a'as.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Şaka sarçe,</para>
  <para style="q2" vid="PRO 1:14">havasre şaqa sa boxçe vuxhecen!»<verse eid="PRO 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Yizda dix, manbışika sımaraççe,</para>
  <para style="q2" vid="PRO 1:15">manbışde yəqqı'n ımayk'an.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Manbışin g'elybı pisde suraqqa,</para>
  <para style="q2" vid="PRO 1:16">eb k'yaa'as g'adayxhvan.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Şit'yaaşine ulene ögil gugu haa'axhee,</para>
  <para style="q2" vid="PRO 1:17">manbı maqa gyatk'vas deş.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Mane insanaaşeme höö-qöö gugu conemeecab haa'a,</para>
  <para style="q1" vid="PRO 1:18">manbışe conacab eb k'yaa'a.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Mıssıne ulynanbışda yəq gırgıne gahbışil həməxüb vooxhe,</para>
  <para style="q2" vid="PRO 1:19">Mıssıne uleka merıng'uke alyaat'uyne karan manbışin can ileşşe.<verse eid="PRO 1:19" /></para>
  <para style="s">K'orane ək'elin qoot'al</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />K'orane ək'elin g'ad axtıda ona'a,</para>
  <para style="q2" vid="PRO 1:20">maydambışee mançin nıq' axtı qexhe.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Şahrabışee, geeb insanarnane cigabışee, mançin ona'an,</para>
  <para style="q2" vid="PRO 1:21">şaharne akkabışisnee eyhen:<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />«Mısılqameene şos, caahilyaaşis,</para>
  <para style="q2" vid="PRO 1:22">əvəmiyvalla vukkiykanas?</para>
  <para style="q1" vid="PRO 1:22">Mısılqameene matsxara haa'anbışe</para>
  <para style="q2" vid="PRO 1:22">matsxaravalike kef ts'ıts'a'as?</para>
  <para style="q1" vid="PRO 1:22">Mısılqameene beynyavabışik'led ats'al g'ımece ixhes?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Şu aq'veeqa uvhiyne yizde cuvabıl k'ırı alixhxhinxhiy,</para>
  <para style="q2" vid="PRO 1:23">zı şu yizde fıkırbışikaniy gyavts'aa'as,</para>
  <para style="q2" vid="PRO 1:23">yizın k'oran cuvabniy şolqa hixhara'as.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Zı şolqa onuiyng'a, şu zal k'ırı gidyaqqiyn,</para>
  <para style="q2" vid="PRO 1:24">zı şolqa xıl hotk'umeeyid, şu zalqa sapk'ıl deş.<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Şu yizde mısləhətbışiqa ilyaakı deş,</para>
  <para style="q2" vid="PRO 1:25">aq'veeqa uvhiyn yizın cuvabıd əq'əna qı'ı.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Mançil-allab şolqa ver vüqqəmee, zı əqəna ha'as,</para>
  <para style="q2" vid="PRO 1:26">qəpq'ı'niyn şu alyapt'ımee, zı şadxhesda.<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />Mane gahıl t'ufan xhinne qəpq'ı'niy şolqa k'yooharas,</para>
  <para style="q2" vid="PRO 1:27">it'umna mıts xhinnen divan şolqa alles,</para>
  <para style="q2" vid="PRO 1:27">şu dağamiyvaleeqa, əq'übeeqa gyapk'as.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />Şu manke zalqa ona'amee, şos zı alidghıniy qeles deş,</para>
  <para style="q2" vid="PRO 1:28">şu nimee zı t'abal he'ee, aveykes deş.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Şos ats'al dekkan ıxhayke,</para>
  <para style="q2" vid="PRO 1:29">Rəbbile qı'dəəq'ən vuxhayke,<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />yizda mısləhət g'umooce vob,</para>
  <para style="q2" vid="PRO 1:30">yizın cuvabıd ıkkan deş.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Mançil-allab şu vuşde yəqqı'n q'ap'ın şagav oxhanas,</para>
  <para style="q2" vid="PRO 1:31">vuşde pisde mısləhətbışika aats'es.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Caahilyar zake sapk'ılva manbı hapt'asınbı,</para>
  <para style="q2" vid="PRO 1:32">beynyavabışeb nişinacab hidyaa'ava, manbışikın ixhesın.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Zal k'ırı alixhxhıynbışeme vaxxariyna ı'mı'r haa'as,</para>
  <para style="q2" vid="PRO 1:33">manbı pisınçileb qəvəəq'ənas deş».<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">K'orane ək'elin haa'ana yugvalla</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Yizda dix, vak'le zı uvhiyn g'ayxhe,</para>
  <para style="q2" vid="PRO 2:1">yizın əmrbı, gıranın kar xhinne havace.<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />K'ırıbıd k'orane ək'elyne suralqa aqqe,</para>
  <para style="q2" vid="PRO 2:2">mana yugba vaats'a vuxha, yik'eeqa vukkee.<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />Ək'el qoot'le,</para>
  <para style="q2" vid="PRO 2:3">axtıba mana hevqe.<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />Mana nuk'ra xhinne,</para>
  <para style="q2" vid="PRO 2:4">dyugulenna xaziyna xhinne t'abal hee'e.<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />Manke Rəbbile qəpq'ı'niy valqa hixharasın,</para>
  <para style="q2" vid="PRO 2:5">Allahne hək'eedın ats'aalid alyaat'asın.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />K'orana ək'el hoolena Rəbb vor,</para>
  <para style="q2" vid="PRO 2:6">Mang'vee ats'aaliy ı'mı'r vaats'a vuxhay hele.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Mang'vee qopkuynbışis ğameepxhay hele,</para>
  <para style="q2" vid="PRO 2:7">məttına ı'mı'r haa'nbışdar g'alxan vor Mana.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Mang'vee qopkuynbışin,</para>
  <para style="q2" vid="PRO 2:8">mu'munaaşin yəqbı havace.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Manke valqa qopkuvallab, ədaalatıb hivxharasda,</para>
  <para style="q2" vid="PRO 2:9">gırgın məttın, yugun yəqbıd vak'le ats'axhxhesınbı.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />K'orana ək'elib yiğne yik'eeqa gyavts'es,</para>
  <para style="q2" vid="PRO 2:10">ats'aalid yiğnemee ittu qixhes.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Darrakayn ğu havacesda,</para>
  <para style="q2" vid="PRO 2:11">ək'elinır ğu aqqasda.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />K'orane ək'elin ğu pisınbışde yəqqı'leyiy</para>
  <para style="q2" vid="PRO 2:12">hor ha'ane insanaaşile havacesda.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Manbışe qotkuyn yəqbı g'ali'ı,</para>
  <para style="q2" vid="PRO 2:13">miç'axne yəqbışil alycaaxva,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />pisda iş g'ooceme şadeebaxhenbı,</para>
  <para style="q2" vid="PRO 2:14">horbışikeyiy pisvalike kef qığayhe.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Mane insanaaşin yəqbı quç'otkur vod,</para>
  <para style="q2" vid="PRO 2:15">manbı alikkı-gikkiyne yəqbışin əlyhəə.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />K'orane ək'elin ğu abır deşde,</para>
  <para style="q2" vid="PRO 2:16">ittune miznane zəiyfayle g'attixhan ha'as.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Mane zəiyfee mek'vranang'a hark'ınna adamiy g'alerçu,</para>
  <para style="q2" vid="PRO 2:17">Allahıs huvuyn cuvab yik'el hixan hı'iyn.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Mane zəiyfayne xaan insan qik'as hoyt'al,</para>
  <para style="q2" vid="PRO 2:18">məng'ı'ne yəqbışinır nyaq'vbışeeqa qıkkekka.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Məng'ı'sqa arına vuşucar yı'q'əlqa siyk'al deş,</para>
  <para style="q2" vid="PRO 2:19">məxrına üç'ürra axvas deş.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Mançil-alla ğu yugunbışde yəqqı'n hoora,</para>
  <para style="q2" vid="PRO 2:20">qopkuynbışda yəq avqe.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Qopkuynbışe ç'iyene aq'val ı'mı'r haa'as,</para>
  <para style="q2" vid="PRO 2:21">məttın yik'nanbı inyaa aaxvas.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Pisın insanar ç'iyene aq'vale dağaa'asınbı,</para>
  <para style="q2" vid="PRO 2:22">cuvab ıqdyaqqanbışikınıd ha'asın.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">Rəbbilqa yı'q' qizre</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Yizda dix, zı vas xət qı'iyn yik'elixan hıma'a,</para>
  <para style="q2" vid="PRO 3:1">yik'eeyid yizın əmrbı aqqe.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Mançin yiğna ı'mı'r xıliy qaa'as,</para>
  <para style="q2" vid="PRO 3:2">vas gyavts'u-gyuvxhuna ı'mı'r hevles.<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Hasre vake yugvallayiy qopkuvalla ımaak'ancen,</para>
  <para style="q2" vid="PRO 3:3">manbı gardanançe givaxne, yik'eeqa ok'ne.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Manke Allahısır, insanaaşisır ğu ıkkiykanasda,</para>
  <para style="q2" vid="PRO 3:4">vaqad yugun do ixhes.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Yik'eençe Rəbbilqa yı'q' qizre,</para>
  <para style="q2" vid="PRO 3:5">yiğne ək'lelqa yı'q' qimiyzar.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Haa'ane gırgıne işee Rəbb qıvaats'e,</para>
  <para style="q2" vid="PRO 3:6">Mang'vee yiğın yəqbı qa'asınbı.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Yiğnecar ulesqa ğu k'orana ək'elynana xhinne qımayle,</para>
  <para style="q2" vid="PRO 3:7">Rəbbile qəq'ne, pisde karake əq'əna ixhe.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Mançin yiğın tan yug qa'as,</para>
  <para style="q2" vid="PRO 3:8">yiğın bark'vbıd it'uma'asınbı.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Rəbb yik'el qali'ı, yiğne karake,</para>
  <para style="q2" vid="PRO 3:9">şagavne ts'ettiynçike Mang'us hele.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Manke yiğın anbarbı karaka gyatsts'es,</para>
  <para style="q2" vid="PRO 3:10">çaxıren kuppıd qakkyak'anasınbı.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Yizda dix, Rəbbine terbiyeyka ooğançe avqa ilymakka,</para>
  <para style="q2" vid="PRO 3:11">Mang'vee cazaa hoolemee, yik' dena qımexhe.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Dekkee geer ıkkanne uşaxıs cazaa hoolen xhinne,</para>
  <para style="q2" vid="PRO 3:12">Rəbbeeyib ıkkanang'us cazaa hoole.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Hikmətılqa hirxhılyna,</para>
  <para style="q2" vid="PRO 3:13">k'orana ək'el avaykına insan nimee baxtivariy!<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Mançiken xayir nuk'rayle geed vod,</para>
  <para style="q2" vid="PRO 3:14">in g'azanc məttıne k'ınəəğəyle q'iymatıka vod.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Mana gıranne ekebışileb gıranba vob,</para>
  <para style="q2" vid="PRO 3:15">mançika vas ıkkanan nencad kar sa aqqas dexhe.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Mançine sağne xılen xıliyna ı'mı'r,</para>
  <para style="q2" vid="PRO 3:16">solne xılenıd kariy axtıvalla hele ıxha.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Mançin yəqbı yik'es ıkkananbı vod,</para>
  <para style="q2" vid="PRO 3:17">gırgın yəqbı barakatnanbı vod.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Mançike alyt'ipq'ı'ninbışdemee mana ı'mrena yiv<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fq" closed="false">ı'mrena yiv: </char><char style="ft" closed="false">k'orana ək'el Allahee Edenne bağee oozuyne yivek akar. Mançine hək'ee «Ts'etta ıxhaynbı» donane kitabee ilyaakas vəəxə (2:9). Ts'eppiyne insanaaşe mançina meyva opxhunmee, habat'a vuxha deş. Mançine hək'ee ine kitabne menne cigabışeeyid qətqəs əxə (11:30, 13:12, 15:4)</char></note> vobna,</para>
  <para style="q2" vid="PRO 3:18">mançike it'umba alyt'ipq'ıninbı nimee baxtivarariy!<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Rəbbee dyunye hikmətıka itxhın,</para>
  <para style="q2" vid="PRO 3:19">k'orane ək'elika xəybı hı'ı,<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />ats'aalika k'oralybışeençe xhyan alqavhu,</para>
  <para style="q2" vid="PRO 3:20">xəybışeençe çiy gyuarı'ı.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Yizda dix, yugne darrakayka, şu'urıka ixhe,</para>
  <para style="q2" vid="PRO 3:21">manbı uleke ak'an hıma'a.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Yiğnemee manbı yiğna ı'mı'r vuxhes,</para>
  <para style="q2" vid="PRO 3:22">micagın kar xhinne gardanaqa qa'as.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Manke yiğne yəqqı'n vaxxariyra ayk'an,</para>
  <para style="q2" vid="PRO 3:23">g'elybıd qıçdyayxar.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Qı'dərq'ı'n g'ılexha,</para>
  <para style="q2" vid="PRO 3:24">ittun nyak' hayle.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Sayangada vuk'lelqa qadıynçile,</para>
  <para style="q2" vid="PRO 3:25">pisınbışilqa vüqqəne verıle ğu qəq'ənas deş.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Ğu yı'q' qizzırna Rəbb ıxhayke,</para>
  <para style="q2" vid="PRO 3:26">Mang'vee ğu gugeeqa gixhas hassaras deş.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Xılençe yugvalla qööxhee,</para>
  <para style="q2" vid="PRO 3:27">mançis avaak'ıne insanaaşike mana qivmiykkan.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Vaqa vodxhee, merıng'uk'le immeyhe:</para>
  <para style="q2" vid="PRO 3:28">«Qiyğa ayre, g'iyqa heles».<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Hexxan hidya'ang'us,</para>
  <para style="q2" vid="PRO 3:29">pisın hıma'a.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Vas pisın hidi'iyng'uka,</para>
  <para style="q2" vid="PRO 3:30">məxüdcad xıliyn hıma'a.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Xılençe g'eşşeng'us paxılıyvalla hımaa'a,</para>
  <para style="q2" vid="PRO 3:31">mang'une yəqbışda nenacab ımaak'an.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Rəbbik'le yəqqı'le qıtteepç'iynbı g'umooce vooxhe,</para>
  <para style="q2" vid="PRO 3:32">Mana qotkuyn ha'anbışda hambaz eyxhe.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Rəbbina bed-düə pisınbışde xaal vooxhe,</para>
  <para style="q2" vid="PRO 3:33">qopkuynbışde xaasme Mang'vee xayir-düə hoole.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Mang'vee matsxara haa'anbışile əqəna ha'a,</para>
  <para style="q2" vid="PRO 3:34">cocab-co ögilqa hudyoolenbıb Mang'une ulen avqaaqqanbı.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />K'oran ək'elynanbı axtı qaa'as,</para>
  <para style="q2" vid="PRO 3:35">beynyavabıme k'ap'ik'ıle avqa qaa'as.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">K'orana ək'el gırgıne karale ooqa vob</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Dixbı, dekkee helene terbiyel k'ırı alixhxhe,</para>
  <para style="q2" vid="PRO 4:1">man şolqa hixhrecenva fıkır hevle.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Zı şos yugun ats'al hele,</para>
  <para style="q2" vid="PRO 4:2">zı xət qı'iyn g'ılymadaççe.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Zı yizde dekkıne xaa uşaxranang'a,</para>
  <para style="q2" vid="PRO 4:3">yedis geer ıkkanna sa uşaxnang'a,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />dekkee zas xət qa'a-qa'a uvhiyn:</para>
  <para style="q2" vid="PRO 4:4">«Hasre yiğne yik'en zı eyhenbı yik'el aqqecen,</para>
  <para style="q2" vid="PRO 4:4">zı eyhenbı he'e, ı'mı'r xıliyba vuxhecen.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />K'orane ək'elynayiy ats'alyna ixhe,</para>
  <para style="q2" vid="PRO 4:5">zı eyhenbı yik'el hixan hıma'a, yizde cuvabeençe qığmeç'e.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Ğu k'orana ək'el g'ılydepçee, mançin ğu havacesda,</para>
  <para style="q2" vid="PRO 4:6">mana vukkiykınee, mançin ğu aqqasda.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />K'orana ək'el gırgıne karale ooqa vob, ğu ts'eppa mana t'abal hee'e.</para>
  <para style="q2" vid="PRO 4:7">Vaqa vodun gırgın kar heles girxhveeyir, hele, k'orana ək'el alept'e.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Mana yiğnemee inekke gıranna vuxhee, mançin ğu axtı qa'as,</para>
  <para style="q2" vid="PRO 4:8">ğu mançik at'irq'ınee, mançin ğu qıvaats'a'asda.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Mana yiğne vuk'lelyne t'et'-t'elelqa savk'alas,</para>
  <para style="q2" vid="PRO 4:9">mançin yiğne vuk'lelqa micagın tac gixhxhes».<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Yizda dix, zal k'ırı alixhxhe,</para>
  <para style="q2" vid="PRO 4:10">ğu zı eyhenbı he'eene, yiğna ı'mı'r xıliy quvxhes.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Zı ğu k'orane ək'elin haagvane yəqqı'lqa gyayhe,</para>
  <para style="q2" vid="PRO 4:11">qorkune yəqqə iykar ha'a.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />İykarmee yiğın g'elybı qaçaxaras deş,</para>
  <para style="q2" vid="PRO 4:12">g'adayxhvanmeeyir hittighanas deş.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Alyaat'uyn terbiye aqqe, curmexhe,</para>
  <para style="q2" vid="PRO 4:13">man aqqe, mançee yiğna ı'mı'r vob.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Pisınbışde yəqqı'lqa g'el gimiyxhe,</para>
  <para style="q2" vid="PRO 4:14">qəlnanbışde yəqqı'n imiykar.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Ts'ıts'xhe, mane yəqqı'sqa k'anecar qımexhe,</para>
  <para style="q2" vid="PRO 4:15">əq'əna ulyozre, menne cigeençe hoora.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Mane insanaaşe pisın hide'ee, g'alyapk'as deş.</para>
  <para style="q2" vid="PRO 4:16">Şavukunmecad hide'eened, manbışin nyak'bı hixvas.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Manbışe pisvalla gıney xhinne opxhan,</para>
  <para style="q2" vid="PRO 4:17">yiğbı alli'iyid manbışe çaxır xhinne ulyoğa.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Qopkuynbışda yəqmee miç'eediyn işix xhinne vob.</para>
  <para style="q2" vid="PRO 4:18">Atk'ıniylette, işix geed qexhe-qexhe, yiğ eyxhe.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Pisınbışda yəqmee miç'axiyvalla vob,</para>
  <para style="q2" vid="PRO 4:19">manbışik'le co nişil-alla qaçapxıriy ats'a deş.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Yizda dix, yizde cuvabılqa fıkır hevle,</para>
  <para style="q2" vid="PRO 4:20">eyhençil k'ırı alixhxhe.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Manbı uleke ak'an hıma'a,</para>
  <para style="q2" vid="PRO 4:21">yik'ee aqqe.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Man eyhenbı yiğnemee ı'mı'riy</para>
  <para style="q2" vid="PRO 4:22">yug qıxhay ixhes.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Yik'en vas ı'mı'r hoole,</para>
  <para style="q2" vid="PRO 4:23">mançil-alla ts'etta man havace.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Horbı ghalençe ak'an he'e,</para>
  <para style="q2" vid="PRO 4:24">qopkuvalla deşin cuvab yuşan hıma'a.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Uleppı hiqa ilyakkecen,</para>
  <para style="q2" vid="PRO 4:25">qorkura yiğne hiqa ilekke.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Ğu əlyhəəna yəq qopku qee'e,</para>
  <para style="q2" vid="PRO 4:26">yiğne g'elik avudun cigad it'umda ixhecen.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Sağılqa, solulqa simiyk'al,</para>
  <para style="q2" vid="PRO 4:27">g'el pisvaleeqa humoodakke.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">Zinaake ğucar ğu havace</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Yizda dix, yizde k'orane ək'lelqa, ats'aalilqa fıkır hevle,</para>
  <para style="q2" vid="PRO 5:1">zı eyhençil yugda k'ırı alixhxhe.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Manke vaqa darraka aaxvasda,</para>
  <para style="q2" vid="PRO 5:2">mizib ats'aalika yuşan haa'as.<verse eid="PRO 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Yəqqı'le qığeyç'uyne zəiyfayne ghalençe itteyhesğu itv k'əə,</para>
  <para style="q2" vid="PRO 5:3">məng'ı'na miz xhınyaalileb g'üvənaba vob.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Nekke qiyğa mana yiğnemee q'ap'ıne yəvşanne ok'ulqa,</para>
  <para style="q2" vid="PRO 5:4">q'öne suraka gyadaxane gılıncılqa sayk'alas.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Məng'ı'ne yəqbışe ğu gik'asda,</para>
  <para style="q2" vid="PRO 5:5">məng'ı'qa qihna ark'ınee, yiğna ciga nyaq'vbışee vuxhes.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Məng'ı'ne yəqqı'n ğu ark'ınee, üç'ürra axvas deş.</para>
  <para style="q2" vid="PRO 5:6">Məng'ı'n yəqbı alikkı-gikkı ixheeyid, cek'le man ats'a deş.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Dixbı, zal həşde şu k'ırı alixhxhe,</para>
  <para style="q2" vid="PRO 5:7">zı eyhen cuvab hixuma'a.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Məxrıne zəiyfayle əq'əna ixhe,</para>
  <para style="q2" vid="PRO 5:8">məng'ı'ne xaane akkaysqa k'ane qımexhe.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Deşxheene, ğu yiğna guc merıng'us hevles,</para>
  <para style="q2" vid="PRO 5:9">yiğne ı'mren senbıd yiğbı allya'ang'une xılyaqa qeles.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Vaqa vodun-deşin merıng'vee oxhanas,</para>
  <para style="q2" vid="PRO 5:10">ğu hı'iyn kar merıng'une xaaqa əlyhəəs.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />I'mı'r ç'əvooxhemee,</para>
  <para style="q2" vid="PRO 5:11">tanee taq'at idyaxumee, ğu uts'uruke ts'ir haa'as.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Ğu inəxüd eyhes: «Nişil-allaniy zak'le terbiye g'ımece vod?</para>
  <para style="q2" vid="PRO 5:12">Nişil-allaniy zı zak'le aq'veeqa uvhiyne cuvabılqa yı'q' sak'ala'a?<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Mə'əllimaaşine cuvabılid k'ırı huvu deş,</para>
  <para style="q2" vid="PRO 5:13">terbiye helenbışilid k'ırı alixhxhı deş.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Gırgınecad milletık'le</para>
  <para style="q2" vid="PRO 5:14">zı nimeeyiy k'ap'ik'ıle avqa qıxhava g'ecen».<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Yiğne anbareençe xhyan ulyoğe,</para>
  <para style="q2" vid="PRO 5:15">yiğne kahrızeençe ılqəəne xhineke ulyoğe.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Nişil-allane yiğne kahrızın xhyanbı şahrabışeeqa,</para>
  <para style="q2" vid="PRO 5:16">yiğın arxbıd maydambışeeqa gyotstses?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Hasre yiğın xhyanbı saccu yiğınbı ixhecen,</para>
  <para style="q2" vid="PRO 5:17">mebınbışis bit'al hıma'a.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Yiğne xhyan ı'lqəəne cigayn hasre ğu şad he'ecen,</para>
  <para style="q2" vid="PRO 5:18">mek'vranang'a hey'iyne xhunaşşeykad vas yugda ixhecen!<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Mana geer micagna ceyran xhinne vor.</para>
  <para style="q2" vid="PRO 5:19">Məng'ı'ne ğu ıkkiykıniyn hasre ğu pete'ecen.</para>
  <para style="q2" vid="PRO 5:19">Hasre vas məng'ı'ne k'ane gırgıne gahbışil ixhes ıkkiyknecen.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Yizda dix, ğu yəqqı'le qığeyç'uyne zəiyfee humoyt'alcen,</para>
  <para style="q2" vid="PRO 5:20">merna xhunaşşe xhılibışeeqa sımee'e.<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Gırgın insanaaşin yəqbı Rəbbine ulene ögil vod.</para>
  <para style="q2" vid="PRO 5:21">Mana insanaaşe ha'ane gırgınçiqa ilyakkana.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Pisde insannamee cuna bınah cusda gugu vobna,</para>
  <para style="q2" vid="PRO 5:22">mang'une bınahın mana zincirbışe xhinne it'umra iyt'al.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Terbiye ılydyaat'uva mana qik'as,</para>
  <para style="q2" vid="PRO 5:23">beynyavavalla geebvad mang'ukun ixhesın.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">Beynyavavalla hımaa'a</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Yizda dix, merıng'ul-alla cuvab himele,</para>
  <para style="q2" vid="PRO 6:1">ghalyaqa merıng'un şib qelesva ılymaat'a.<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />Deşxheene, ğu zibileeqa ayxhas,</para>
  <para style="q2" vid="PRO 6:2">yiğne cuvabıka ğu gugeeqa gixhas.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Yizda dix, ğu merıng'une xılyaqa girxhuxheene,</para>
  <para style="q2" vid="PRO 6:3">hoora, ğucar-ğu g'attixhan he'e,</para>
  <para style="q2" vid="PRO 6:3">mang'une ghalik avqa qixhe, miz k'ee'e.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Yiğne ulyaqa nyak' qımaylecen,</para>
  <para style="q2" vid="PRO 6:4">k'ak'bıd yı'q' qımeedaxhecen.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Ğucar ğu k'onayne xılençe ceyran xhinne,</para>
  <para style="q2" vid="PRO 6:5">şit' xhinne g'attixhan he'e.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Ğu tanbal, nətsxüreeşisqa hak'ne,</para>
  <para style="q2" vid="PRO 6:6">mançin g'oocene işika ilekke, ək'elika ixhe.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Mançiqa ç'ak'ınbı, ilyaakanbı,</para>
  <para style="q2" vid="PRO 6:7">vuk'lek vukkekkanbıb devxheeyib,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Mançin kar g'ı'lı'na haqqa,</para>
  <para style="q2" vid="PRO 6:8">çisın oxhanasın kar qiyşalang'a sa'a.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Tanbal, ğu nimeene g'alixhas?</para>
  <para style="q2" vid="PRO 6:9">Mısane nik'eençe oza qixhes?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Ğu sık'ırrar horku mırg he'ee,</para>
  <para style="q2" vid="PRO 6:10">g'el-xıl hotku g'alirxhvee,<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />kar deşiyvalla valqa ğu q'əra qa'as ı'qqəna xhinne,</para>
  <para style="q2" vid="PRO 6:11">kar g'idiyxhıriyvallab valqa g'uldur xhinne k'yophur ables.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Karaı'dəəna pisda insan,</para>
  <para style="q2" vid="PRO 6:12">horbı ha'a, iykar.<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />Mang'vee ul giviyxə,</para>
  <para style="q2" vid="PRO 6:13">g'elybışika işaarabı ha'a,</para>
  <para style="q2" vid="PRO 6:13">t'ubaaşika haagva.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Mang'une fıkreençe gırgıne gahbışil hor ı'lğəə,</para>
  <para style="q2" vid="PRO 6:14">mang'vee insanaaşine yı'q'nee gaf abaççe.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Mançil-allab mang'une vuk'lelqa sayangaba ver ables,</para>
  <para style="q2" vid="PRO 6:15">sayangara qukkyork'ul, ık'arıke yug qixhes dəxə axvas.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Rəbbis yixhılle kar g'ımece vod,</para>
  <para style="q2" vid="PRO 6:16">yighılled eyhes eyxhe:<verse eid="PRO 6:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 6:17" />merıng'uka ooğançe avqa ilyakkan uleppı,</para>
  <para style="q2" vid="PRO 6:17">horbı ha'ana miz,</para>
  <para style="q2" vid="PRO 6:17">nişilycab-alla eb k'yav'uyn xıleppı,<verse eid="PRO 6:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 6:18" />qəlasın ha'as fıkreençe ı'lğəən yik',</para>
  <para style="q2" vid="PRO 6:18">pisın ha'as zarada g'adayxhvanan g'elybı,<verse eid="PRO 6:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 6:19" />hor ha'ana şahad,</para>
  <para style="q2" vid="PRO 6:19">çocaaşine yı'q'nee aldatxhuniy adaççena insan.<verse eid="PRO 6:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Yizda dix, dekkın əmrbı havace,</para>
  <para style="q2" vid="PRO 6:20">yedee xət qı'iynbıd g'ılyma'a.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Manbışe uvhiynbı gırgıne gahbışil yik'el aqqe,</para>
  <para style="q2" vid="PRO 6:21">manbı gardanık qe'e.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />İykarmee, mançin vas yəq haagvas,</para>
  <para style="q2" vid="PRO 6:22">g'ılexhamee, mançin ğu havacesda,</para>
  <para style="q2" vid="PRO 6:22">muğur qıxhameeyir, mançin vaka gaf haa'as.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />İn əmrbı bazir xhinne vodunbı,</para>
  <para style="q2" vid="PRO 6:23">in vas xət qı'iynbı işix vodun.</para>
  <para style="q2" vid="PRO 6:23">Terbiyeyniy aq'veeqa uvhiyne cuvabın ı'mı'r xıliy qaa'a.<verse eid="PRO 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Mançin ğu yəqqı'le qığeyç'uyne,</para>
  <para style="q2" vid="PRO 6:24">ittune miznane zəiyfayke havaces.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Yik'ee məng'ı'na micagiyvalla vukmiykan,</para>
  <para style="q2" vid="PRO 6:25">məng'ı'ne k'ak'bışe ğu hot'alas hımaysar.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Yəqqı'le qığeyç'uyne zəiyfal-alla insan gıneyna xüvə dena axva,</para>
  <para style="q2" vid="PRO 6:26">şavneme zina ha'ane xhunaşşee insan ı'mreke ha'a.<verse eid="PRO 6:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />T'ap'anbışil ts'anang'un,</para>
  <para style="q2" vid="PRO 6:27">tanalinbı gidyoyxhanee?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Ts'ayıl oğa iykarang'un,</para>
  <para style="q2" vid="PRO 6:28">g'elybı gidyoyxhanee?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Merıng'une xhunaşşeysqa ikkeç'unar məxür vor,</para>
  <para style="q2" vid="PRO 6:29">məxrıne zəiyfayk qet'unar cazaa dena axvas deş.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Sixnaree xhal qek'ava qöqəxhee,</para>
  <para style="q2" vid="PRO 6:30">mana k'ap'ik'ıle avqa qa'a deş.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Nəxürcar, məxrına insan xılyaqa arxhvee,</para>
  <para style="q2" vid="PRO 6:31">mang'vee yighnəqqees geed sak'al ha'as ıkkan,</para>
  <para style="q2" vid="PRO 6:31">xaa'ad vodun-deşin qeles ıkkan.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Zəiyfaykamee zina ha'ana ək'el deşda vor,</para>
  <para style="q2" vid="PRO 6:32">man ha'ang'vee cukun ha'an.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Məxrına k'ap'ik'ıle avqa qa'as, getasda,</para>
  <para style="q2" vid="PRO 6:33">mang'una bey'abıriyvallab nişincab hooğalas deş.<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Məng'ı'na adamiy qəlın bahal qa'as,</para>
  <para style="q2" vid="PRO 6:34">məxrıng'uke adamee qəl qığaahamee, nişiqacar ilyakkas deş.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Nenecab payın mang'un ögü ı'xəs deş,</para>
  <para style="q2" vid="PRO 6:35">nen huveeyid, mana aqqas əxəs deş.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s">Zina ha'ane zəiyfayke ğucar ğu havace</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Yizda dix, zı eyhençil yugda k'ırı alixhxhe,</para>
  <para style="q2" vid="PRO 7:1">yizın əmrbıd yik'el aqqe.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Yizın əmrbı ğu g'ılyde'eene, ı'mı'r haa'asda,</para>
  <para style="q1" vid="PRO 7:2">zı xət qı'iyn ulen işix xhinne havace.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Manbı ı'm xhinne t'ubeyk qe'e,</para>
  <para style="q2" vid="PRO 7:3">yik'ek ok'ne.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />K'orane ək'elik'le: «Ğu yizda yiçuva»,</para>
  <para style="q2" vid="PRO 7:4">hikmətık'led «Ğu yizda k'anena hambazva» eyhe.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Mançin ğu yəqqı'le qığeyç'uyne zəiyfayle,</para>
  <para style="q2" vid="PRO 7:5">ittune miznane merıng'une xhunaşşeyle havacesda.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6-7" style="v" sid="PRO 7:6-7" />Zı yizde xaane g'ulele</para>
  <para style="q2" vid="PRO 7:6-7">g'aqa horzuling'a,</para>
  <para style="q1" vid="PRO 7:6-7">caahilyaaşineyiy mek'vunbışde yı'q'nee,</para>
  <para style="q2" vid="PRO 7:6-7">zak'le sa ək'el deşda g'acu.<verse eid="PRO 7:6-7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Mana, mane zəiyfayne xaane vuttus k'anene yəqqı'leyiy ı'lğəə,</para>
  <para style="q2" vid="PRO 7:8">məng'ı'n xavnane yəqqı'sqanayiy qöö.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Exha qexhemee, verığ k'yooçemee,</para>
  <para style="q2" vid="PRO 7:9">ooğançe xəm qöömee, miç'ax qexhemee</para>
  <para style="q2" vid="PRO 7:9">mana maqa qöö eyxhe.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Pisın yik'nana, yəqqı'le qığeyç'uyne zəiyfee xhinne tanalinbı ali'ına zəiyfa</para>
  <para style="q2" vid="PRO 7:10">zaara mang'une ögilqa qığeeç'e.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Məng'ee ts'ir-ts'yank' haa'a,</para>
  <para style="q2" vid="PRO 7:11">məng'ee şavuscab hı'rmat giviyxhe deş,</para>
  <para style="q2" vid="PRO 7:11">mana xaa gidiy'arna vorna.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Yəqqı'lqa, maydamaqa mana qığeeç'e,</para>
  <para style="q2" vid="PRO 7:12">gırgıne xhoşşebışee gugu məng'ee giviyxhe.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Məng'ee mana gade aqqı, ubba hı'ı,</para>
  <para style="q2" vid="PRO 7:13">naş qıdexhad uvhiyn:<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />«Zı q'urban ablyav'u, zaqa həşde çuru vodun,</para>
  <para style="q2" vid="PRO 7:14">Allahıs huvuyn cuvab zı g'iyna hı'iyn.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Mançil-allar ğu g'acesva zı yiğne ögilqa qığeyç'u,</para>
  <para style="q2" vid="PRO 7:15">zı ğu t'abal hı'ı, həşde aveykı.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Zı yizde g'ıleexhane tyulyulqa</para>
  <para style="q2" vid="PRO 7:16">Misirğançe adıyn micagın parçebı atçu.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Zı yizde g'ıleexhane cigeeqa</para>
  <para style="q2" vid="PRO 7:17">mirrayn, aloeyn, darçının evabı hı'ı.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Qora, miç'eebilqamee avts'esınmee sanab vuxhes,</para>
  <para style="q2" vid="PRO 7:18">sana-sang'vee pet haa'as.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Yizda adamiy xaa deş vor,</para>
  <para style="q2" vid="PRO 7:19">əq'ənane cigeeqa ark'ın.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Pılnan yut'elid alyaat'u, mana ark'ın,</para>
  <para style="q2" vid="PRO 7:20">mana xaaqa vaz bıkıruvxhamee sak'alas».<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Miz k'yav'u, məng'ee mana celqa sa'ana,</para>
  <para style="q2" vid="PRO 7:21">ittuna miz hav'u, yəqqı'le qığayhena.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Givk'as vukkekana conga xhinne,</para>
  <para style="q2" vid="PRO 7:22">mana gader mankecar məng'ı'ka qihna ayk'an.</para>
  <para style="q2" vid="PRO 7:22">Maral xhinneyir mana gugeeqa gexha.<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />Nekke qiyğad mang'une k'ılyk'ameeqa ox hiyxə.</para>
  <para style="q2" vid="PRO 7:23">Alivxu zarabacab toreeqa ooxhana şit' xhinne,</para>
  <para style="q2" vid="PRO 7:23">mane gadeyk'led vuc ı'mrıkena ixhesva ats'a deşdiy.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Dixbı, həşde zal k'ırı hele,</para>
  <para style="q2" vid="PRO 7:24">zı eyhençil yugda k'ırı alixhxhe.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Hımaysar ğu məng'ı'ne yəqqı'lqa gixhas,</para>
  <para style="q2" vid="PRO 7:25">məng'ı'ne yəqqı'n əlyhəəs.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Məxürne zəiyfee geebınbışikın hı'ı,</para>
  <para style="q2" vid="PRO 7:26">nimeen insanarne gyapt'ı.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Məng'ı'ne xaasqa əlyhəəne yəqbışe ahaleeqa quvkekka,</para>
  <para style="q2" vid="PRO 7:27">qik'as qıkkekka.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">K'orane ək'elin qoyt'al</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Haane, k'orane ək'elin qoyt'al,</para>
  <para style="q2" vid="PRO 8:1">hikmətın axtıda ona'a.<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Axtıne cigabışee, yəqqı'ne mıglek,</para>
  <para style="q2" vid="PRO 8:2">yəqbı cureedaxhene cigee ulyobzur.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Şaharne akkabışisnee,</para>
  <para style="q2" vid="PRO 8:3">ı'kkəəne cigabışee axtıra qoyt'al:<verse eid="PRO 8:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />«İnsanar, zı şolqa ona'a,</para>
  <para style="q2" vid="PRO 8:4">vuşde gırgıng'ulqa zı ghal aaqa.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Caahilyar, ı'mreqa k'oraba ilyaake,</para>
  <para style="q2" vid="PRO 8:5">beynyavabı, ək'eleeqa qudoora.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />K'ırı alixhxhe, zı geed ıkkanne karane hək'ee eyhe,</para>
  <para style="q2" vid="PRO 8:6">zı qotkuyn eyhesva ghal aaqa.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Yizde ghalen hək'en eyhe,</para>
  <para style="q2" vid="PRO 8:7">yizda miz pisınçile həlyvəəq'ənna.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Yizde ghalençe qı'ğəən gırgın qotkuyn vod,</para>
  <para style="q2" vid="PRO 8:8">yizde cuvabee quç'otkuriyvallayiy hor deşin.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Zı uvhiyn gırgın ək'elynanbışilqa hiyxharan,</para>
  <para style="q2" vid="PRO 8:9">ats'al aveykiynbışdemee, man qotkuyn vodun.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Nuk'rayle ooqa yizın terbiye aqqe,</para>
  <para style="q2" vid="PRO 8:10">məttıne k'ınəəğəyle ooqad ats'al aqqe.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />K'orana ək'el, gıranne g'ayebışile gıranba vob,</para>
  <para style="q2" vid="PRO 8:11">yik'es ıkkanan nencad mançika sa aqqas dexhe.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Zaqa, hikmətıqa, ats'aliy şu'ur vob,</para>
  <para style="q2" vid="PRO 8:12">yizda k'anena hambaz k'orana ək'el vob.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Rəbbile qəyq'ənang'uk'le pisın g'ımece vod.</para>
  <para style="q2" vid="PRO 8:13">Vuceecar vuc xərra, axtıra ıkkiy, pisda yəq apk'ıniy,</para>
  <para style="q2" vid="PRO 8:13">horana miz hav'uy zak'le g'ımece vod.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Mısləhətiy şu'ur yizda vob,</para>
  <para style="q2" vid="PRO 8:14">zaqa k'orana ək'el, guc vob.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Zaleğana paççahaaşe xəbvalla haa'a,</para>
  <para style="q2" vid="PRO 8:15">vuk'lek vukkekkanbışe qotkuyn q'aanunbı oyk'an.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Qopkuba vuk'lek vukkekkane gırgıne ç'ak'ınbışe</para>
  <para style="q2" vid="PRO 8:16">zaleğana xəbvalla haa'a.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Zı ıkkananbı zasıb vukkananbı,</para>
  <para style="q2" vid="PRO 8:17">zı t'abal ha'anbışik'le zı aveykesda.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Kariy qıvaats'iyvalla,</para>
  <para style="q2" vid="PRO 8:18">gyatsts'ı-gixhxhiyvalla, qopkuvalla yizde k'ane vod.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Yizın şagav məttıne k'ınəəğəyle,</para>
  <para style="q2" vid="PRO 8:19">zaken xayir g'əyxiyne nuk'rayle gıranda vod.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Zı qopkuvaline yəqqə,</para>
  <para style="q2" vid="PRO 8:20">adaaletne yəqqə iykar.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Zı ıkkananbı karalqa hivxhar haa'a,</para>
  <para style="q2" vid="PRO 8:21">xaazinabı gyatsts'a'a.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />Rəbbee zı Cune işbışde q'oma irxhın,</para>
  <para style="q2" vid="PRO 8:22">gırgıne itxhınne karbışile ögee zı ıxha.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Gırgın ixhanassecad,</para>
  <para style="q2" vid="PRO 8:23">dyunye ixhanassecad zı vornaniy.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />K'oran deryahbı ixhessecad,</para>
  <para style="q2" vid="PRO 8:24">xhyanıka gyatsts'ıyn xhyan ı'lqəən cigabı ixhessecad zı ıxhana.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Suvabı çine cigeeqa gixhxhessecad,</para>
  <para style="q2" vid="PRO 8:25">tepabı ixhessecad zı vornaniy.<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Allahee ç'iyeyn aq'va, qadaalybı,</para>
  <para style="q2" vid="PRO 8:26">ts'ettiyn tooz itxhıning'a,<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />xəybı çine cigeeqa giyxheng'a, zı maa'ar ıxhana.</para>
  <para style="q2" vid="PRO 8:27">K'orane xhinel oğa gırgale ts'ıts'aamee,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />buludbı xəəqə giyxhemee,</para>
  <para style="q2" vid="PRO 8:28">k'oralybışeedın xhyan ı'lqəən cigabı it'um hı'ımee,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />xhyanbı Cune əmreençe qığmeeç'ecenva deryahıs sarhad ts'ıts'aamee,</para>
  <para style="q2" vid="PRO 8:29">ç'iyeys xhebbı giyxheng'a,<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />zı Allahne k'ane işniy g'ooce.</para>
  <para style="q2" vid="PRO 8:30">Yiğıs zı Mang'una ulyniy şadaa'a,</para>
  <para style="q2" vid="PRO 8:30">Mang'une ögiylir şadexhenaniy.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Zı dyunyeynemeeyiy</para>
  <para style="q2" vid="PRO 8:31">insanaaşinemee şadexhenaniy.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />Həşde, dixbı, zal k'ırı alixhxhe.</para>
  <para style="q2" vid="PRO 8:32">Yizda yəq avquynbı nimee baxtivarariy!<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Zı helene terbiyel k'ırı alixhxhe, man g'ılymadaççe</para>
  <para style="q2" vid="PRO 8:33">k'orana ək'elynanbı vuxhe.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Zal k'ırı iliyxhena, yiğıs yizde xaasne,</para>
  <para style="q2" vid="PRO 8:34">yizde akkayne ögil ulyorzulyna nimee baxtivariy!<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Zı aveykıng'uk'le ı'mı'r iveeke,</para>
  <para style="q2" vid="PRO 8:35">Rəbbir mang'uka yugra ixhes.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Zı xılençe g'aykkiyng'vee cukun ha'a,</para>
  <para style="q2" vid="PRO 8:36">zı şavuk'leyiy g'ımece mang'us qik'as ıkkiykan».<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">K'orane ək'elin çisqa qoyt'al</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />K'orane ək'elin çisın xav ali'ı,</para>
  <para style="q2" vid="PRO 9:1">yighıble çisda g'ayeyna dirak hoots'a.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Həyvanar gyat'u, çaxır qı'ı,</para>
  <para style="q2" vid="PRO 9:2">sufranılqad giyk'an.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />K'orane ək'elin g'axuvuyne həmbalaaşe,</para>
  <para style="q2" vid="PRO 9:3">şaharne axtıne cigabışeençe ts'ir haa'a:<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />«İnyaqa qudoora, caahilyar!»</para>
  <para style="q2" vid="PRO 9:4">Mançin ək'el hivdiyxharanbışik'le inəxüdud eyhe:<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />«Qudoora, yizde gıneyke oxhne,</para>
  <para style="q2" vid="PRO 9:5">zı qı'iyne çaxırıke ulyoğe.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Xıliyna ı'mı'r haa'asva, ats'alydeşvalla g'alepçe,</para>
  <para style="q2" vid="PRO 9:6">ək'elyne yəqqı'ka qopkuba hudoora».<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Matsxara haa'ang'uk'le aq'veeqa cuvab uvhuna k'ap'ik'ıle avqa qixhes,</para>
  <para style="q2" vid="PRO 9:7">pisde insanık'le vucee ha'an uvhunar bey'abırxhesda.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Matsxara haa'ang'uk'le aq'veeqa cuvab immeyhe.</para>
  <para style="q2" vid="PRO 9:8">Deşxhee, mang'uk'le ğu g'ımece qixhes.</para>
  <para style="q1" vid="PRO 9:8">K'orane ək'elynang'uk'le cuvab eyhe,</para>
  <para style="q2" vid="PRO 9:8">mang'us ğu ıkkiykanasda.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />K'orane ək'elynang'us kar xət qe'eene,</para>
  <para style="q2" vid="PRO 9:9">mang'una k'orana ək'el sık'ılbab geeb quvxhes,</para>
  <para style="q1" vid="PRO 9:9">qorkung'us ats'al huveene,</para>
  <para style="q2" vid="PRO 9:9">mang'un ats'al sık'ıldad hexxaxhes.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Rəbbile qəpq'ı'niy ats'alyne q'oma ulyozzur,</para>
  <para style="q2" vid="PRO 9:10">Muq'addasna qıvaats'ıyid ək'elika ıxhay vodun.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />K'orane ək'elika yiğna ı'mı'r hexxavxhes,</para>
  <para style="q2" vid="PRO 9:11">ı'mren yiğbı geed qixhes.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />K'orane ək'elyna ixheene, ğu vas xayir ha'as.</para>
  <para style="q2" vid="PRO 9:12">De'eş, matsxara ha'ana ixheene, mançina əq'üba saccu ğu ooxhanas.<verse eid="PRO 9:12" /></para>
  <para style="s">Beynyavavalin çisqa qoyt'al</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Beynyavavalla ts'ir-ts'yank' haa'ana zəiyfa xhinne vobna.</para>
  <para style="q2" vid="PRO 9:13">Mana caahilyra vorna, məng'ı'k'le vuççud ats'a deş.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Mana cene xaane akkayne ögiliy</para>
  <para style="q2" vid="PRO 9:14">şaharne axtıne cigabışee giy'ar.<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />Məng'ee yəqqı'le ı'lğəəmbışilqa,</para>
  <para style="q2" vid="PRO 9:15">qopkune yəqqı'nbışilqa ona'a:<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />«İnyaqa qudoora, caahilyar!»</para>
  <para style="q2" vid="PRO 9:16">Məng'ee ək'el hivdiyxharanbışik'le inəxüdud eyhe:<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />«Qöqüyn xhyan ittuda eyxhen,</para>
  <para style="q2" vid="PRO 9:17">dyugulenda otxhuniyn gıneyid, yugda qaylen».<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Məng'ı'sqa abıynbışik'le ats'a deş, co hapt'ıynbı xhinne vob,</para>
  <para style="q2" vid="PRO 9:18">mane zəiyfee qopt'uluynbı ahalne k'oralybışee vobunbı.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">Sıleymanın misaalabı</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Sıleymanın misaalabı.</para>
  <para style="b" vid="PRO 10:1" />
  <para style="q1" vid="PRO 10:1">K'orane ək'elynane dixee dek şada'a,</para>
  <para style="q2" vid="PRO 10:1">beynyava dixeeme yedis derd hoole.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Haramda sı'iyne karake kar eyxhen deşxhe,</para>
  <para style="q2" vid="PRO 10:2">qopkuvalinme insan qik'uyke g'attixhan ha'a.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Rəbbee qorkuna insan mıssıra g'alyaraççe deş,</para>
  <para style="q2" vid="PRO 10:3">mıssına ulynan pisınbıb Mang'vee avts'aa'a deş.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Tanbalne xılen mana karake ha'a,</para>
  <para style="q2" vid="PRO 10:4">ek'ıng'une xılen mana karana ha'a.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Ək'elikane dixee g'ı'lı'na şagav sa'a,</para>
  <para style="q2" vid="PRO 10:5">kar qiyşalne gahıl g'alirxhuyne dixeeyib xizan k'ap'ik'ıle avqa qexhe.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Qorkung'une vuk'lelqa xayir-düə gyooğa,</para>
  <para style="q2" vid="PRO 10:6">pisıng'vee yuşan ha'ançee zulum dyugulyooxhe.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Qopkuynbışde ı'mreqa ilyaakımee xayir-düə haa'a,</para>
  <para style="q2" vid="PRO 10:7">pisde insanın domee qeçen.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />K'orane ək'elynang'vee əmrbışil k'ırı iliyxhen,</para>
  <para style="q2" vid="PRO 10:8">nen qadiy eyhene bəç'ərılqamee yiğbı alles.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Məttıne yik'eka ı'ğiykarna qəyq'ən deş,</para>
  <para style="q2" vid="PRO 10:9">yəq quç'opkurba əlyhəəname aq'valqa qığeç'ena.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Horaka ul üvxiyxəng'vee ver abaylena,</para>
  <para style="q2" vid="PRO 10:10">nen qadiy eyhene bəç'ərılqamee yiğbı alles.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Qorkung'un cuvab ı'mı'r hoolene xhinek akar,</para>
  <para style="q2" vid="PRO 10:11">pisıng'vee yuşan ha'ançee zulum dyugulyooxhe.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />G'umooce vuxhayn uğoodıybı ha'a,</para>
  <para style="q2" vid="PRO 10:12">vukkiykıniynme gırgın bınahbı yik'elixan ha'a.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />K'orane ək'elynanbışde mizele hikmət gyobatstse,</para>
  <para style="q2" vid="PRO 10:13">beynyavayneme yı'q'əs çümqüka ı'xiyxən.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />K'orane ək'elynanbışe ats'aalyxhe sa'an,</para>
  <para style="q2" vid="PRO 10:14">bəç'ərneme mizen zarada mang'ukun ha'an.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Karnang'un kar, mang'unemee hiqiy-alla cabırnana şahar xhinne vobna,</para>
  <para style="q2" vid="PRO 10:15">kar deşing'une kar deşvalinıd mang'ukun ha'an.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Qorkung'un mukaafat ı'mı'r vobna,</para>
  <para style="q2" vid="PRO 10:16">pisıng'un g'azancıd mang'une bınahna cazaa vobna.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Terbiye alyaat'ang'vee xıliyna ı'mı'r alyabat'a,</para>
  <para style="q2" vid="PRO 10:17">aq'veeqa uvhiyne cuvabılqa yı'q' sak'al hı'ına yəqqı'le qıkkeç'ena.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Horalyne ghalen g'umooce vuxhay dyugul ha'an,</para>
  <para style="q2" vid="PRO 10:18">beynyavaynıb gırgıne surabışilqa mizyar ekka.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Geer yuşan ha'axhee, bınah dena axvas deş,</para>
  <para style="q2" vid="PRO 10:19">ghal sı'ına ək'elikana vorna.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Qorkune insanna miz yugne nuk'rayk akar,</para>
  <para style="q2" vid="PRO 10:20">pisde insanne yik'ena q'iymat k'ap'ik' vobna.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Qorkung'vee cune mizeka geer insan ats'ya'a,</para>
  <para style="q2" vid="PRO 10:21">beynyavaykınıd cune ək'el deşvalin ha'a.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Rəbbine xayir-düəyn insan karnana ha'a,</para>
  <para style="q2" vid="PRO 10:22">mançin valqa ver ablyaa'as deş.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Beynyava pisde işin,</para>
  <para style="q2" vid="PRO 10:23">ək'elynanar hikmətın şada'ana.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Pisda insan nişile qərq'ı'nee, mang'une vuk'lelqa man qayle,</para>
  <para style="q2" vid="PRO 10:24">qorkune insanısıd cune yik'eedın heles.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />T'ufanın pisda qıkkekkana,</para>
  <para style="q2" vid="PRO 10:25">qorkung'un xhebbıme gırgıne gahbışis axvas.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Sirkayn silibışikın, kumayn uleppışikın ha'an,</para>
  <para style="q2" vid="PRO 10:26">tanbalee iş hooleng'uk ha'a.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Rəbbile qəpq'ı'niyn ı'mı'r xıliy qaa'a,</para>
  <para style="q2" vid="PRO 10:27">pisde insanaaşinme ı'mı'ren senbı k'ıl qeedaxhe.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Qopkuynbışde umudun şadvalla hoole,</para>
  <para style="q2" vid="PRO 10:28">pisınbışe umud haa'anme mısacad ixhes deş.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Şavaayiy məttına ı'mı'r haa'a, mang'unemee Rəbbina yəq' g'ala vobna,</para>
  <para style="q2" vid="PRO 10:29">pisın ha'anbışikınıd ixhesın.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Qorkuna gırgıne gahbışil it'umra ulyozarasda,</para>
  <para style="q2" vid="PRO 10:30">pisınbıb ç'iyene aq'val aaxvas deş.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Qorkung'une ghalen k'orane ək'elikan kar eyhe,</para>
  <para style="q2" vid="PRO 10:31">alytik'al hı'ı yuşan ha'ana mizib g'ats'aak'vanasda.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Qorkune insanne mizesse ittunçil avqas vəəxənbı,</para>
  <para style="q2" vid="PRO 10:32">pisde insaneeme alytik'al hı'ı yuşan ha'a.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Horbışikane g'apanıle Rəbb həlyvəyq'ənna,</para>
  <para style="q2" vid="PRO 11:1">Rəbbis qotkuyn terezyugun g'ayebı ıkkiykan.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Vuceecar-vuc axtıra ıkkekkana k'ap'ik'ıle avqa qexhena,</para>
  <para style="q2" vid="PRO 11:2">k'orana ək'elib vuceecar-vuc axtıra ıkdekkang'uqa vooxhena.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Məttıne yik'en qopkuynbışis yəq haagvas,</para>
  <para style="q2" vid="PRO 11:3">xayaanat ha'ang'uk cune quç'orkuyvalin ha'a.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Allahee cazaa hoolene yiğıl şavnecad karan mana g'attixhana'as deş,</para>
  <para style="q2" vid="PRO 11:4">qopkuvalinme insan qik'uyke g'attixhan ha'a.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Məttın yik'nane insanna yəq, cune qopkuvalin qopku qaa'a,</para>
  <para style="q2" vid="PRO 11:5">pisde insanıkınıd cune pisvalin ha'a.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Əməlybı qotkuna cune qorkuvalin g'attixhan ha'a,</para>
  <para style="q2" vid="PRO 11:6">xaainır cune mıssıne ulen toreeqa arçes.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Pisda insan qek'amee cuna umudub qook'ana,</para>
  <para style="q2" vid="PRO 11:7">cune karana gucub hexxavxhes deş.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Qorkung'ulqa ver abımee, mana g'ittiyxhanna,</para>
  <para style="q2" vid="PRO 11:8">mang'une cigee pisıng'ulqa ver abayle.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Allah deşing'une mizen merıng'ukınıd ha'an,</para>
  <para style="q2" vid="PRO 11:9">ats'aalinır qorkuna g'attixhan ha'a.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Qopkuynbışin xıl barakalqa hitxhırmee, şaharcab şadooxhe,</para>
  <para style="q2" vid="PRO 11:10">pisda insan qik'umee, şadvaline ts'irın şahar alyabat'a.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Qopkuynbışde xayir-düəyka şahar axtı qooxhe,</para>
  <para style="q2" vid="PRO 11:11">pisınbışde ghalybışeme şaharıkın ha'an.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Merna k'ap'ik'ıle avqa qa'ana beynyava vor,</para>
  <para style="q2" vid="PRO 11:12">ək'elynang'veeme ghal sa'a.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Miz iviykar haa'ang'vee, sirbı hixhar ha'a,</para>
  <para style="q2" vid="PRO 11:13">cuvab aqqaqqane insaneeme cuvab hixhar ha'a deş.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Qopkuna mısləhət g'udyoocexhee, milletıkın eyxhen,</para>
  <para style="q2" vid="PRO 11:14">qopkuba mısləhət g'oocenbı geebxheene, millet g'ıttiyxhanan.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Merıng'us zaaminna ulyorzulyung'vee culqa ver ablyaa'a,</para>
  <para style="q2" vid="PRO 11:15">zaaminiyvalla haa'as g'umooceng'ulqamee divan adayle deş.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Yik' yugne zəiyfayna hı'rmat geeb qooxhe.</para>
  <para style="q2" vid="PRO 11:16">Zulum hoolene adameeşe karcad sa'a.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Yugun ha'ang'vee cuscad xayir ha'a,</para>
  <para style="q2" vid="PRO 11:17">yiğbı allya'ang'veeme culqa yiğ ıkkekka.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Pisde insanee horana payxhe alyabat'ana,</para>
  <para style="q2" vid="PRO 11:18">qopkuvalla qeyheneme insanee hək'ena mukaafat alyapt'as.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Qopkuvalla avquyng'vee ı'mı'r haa'asda,</para>
  <para style="q2" vid="PRO 11:19">pisınçiqar qihna girxhuname qik'asda.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Yik'ee bicvallanana insan Rəbbik'le g'ımece eyxhe,</para>
  <para style="q2" vid="PRO 11:20">Mang'us yik' məttınbı vukkiykan.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Vak'le ats'axhxhe, pisda cazaa dena axvas deş,</para>
  <para style="q2" vid="PRO 11:21">qopkuynbışke g'abıynbıb g'attivxhanasınbı.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Ək'el deşde zəiyfayna micagiyvalla</para>
  <para style="q2" vid="PRO 11:22">vokkanee quşelyne k'ınəəğəyne ı'mık akar.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Qopkuynbışis ıkkanan yugun vodun,</para>
  <para style="q2" vid="PRO 11:23">pisde insanaaşilqab gyooxhana Allahna qəl vobna.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Sang'vee bit'al hı'iylette, hexxaxhen,</para>
  <para style="q2" vid="PRO 11:24">mansang'usme qiykkıniylette, ayk'anan.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Yik'eençe bit'al ha'ana gyatsts'ı-gixhxhı ixhes,</para>
  <para style="q2" vid="PRO 11:25">merna xhineka ats'yı'ına, vucur ayts'ena.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Suk dyugul haa'ang'us milletın bed-düə haa'a,</para>
  <para style="q2" vid="PRO 11:26">mana massa huvuyng'unemee vuk'lelqa xayir-düə gyooğa.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Yik'eençe yugvaliqar qihna əlyhəəng'uk'le yugun iveeke,</para>
  <para style="q2" vid="PRO 11:27">pisınçiqar qihna girxhung'ulqamee ver abaylena.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Var-devletılqa umudeepxhaynbı k'yooçesınbı,</para>
  <para style="q2" vid="PRO 11:28">qopkuynbıb t'et'-t'ele g'ayhene yivaaşik akaraba vuxhes.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Xizanılqa ver ablyav'ing'un kar mıtsıs ixhes,</para>
  <para style="q2" vid="PRO 11:29">beynyavar k'orane ək'elynang'us həmbal ixhes.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Qopkuyg'un şagav ı'mrena yiv<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="fq" closed="false">ı'mrena yiv: </char><char style="ft" closed="false">k'orana ək'el Allahee Edenne bağee oozuyne yivek akar. Mançine hək'ee «Ts'etta ıxhaynbı» donane kitabee ilyaakas vəəxə (2:9). Ts'eppiyne insanaaşe mançina meyva opxhunmee, habat'a vuxha deş.</char></note> vobna,</para>
  <para style="q2" vid="PRO 11:30">k'orane ək'elynang'vee culqa ts'ıts'aa'a.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Qorkung'us dyunyel mukaafat qoolexheene,</para>
  <para style="q2" vid="PRO 11:31">pisıng'uk, bınahnang'uk ilekke ğu hucooyiy ixhes!<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Terbiye ıkkanang'us ats'aalid ıkkiykananxhe,</para>
  <para style="q2" vid="PRO 12:1">aq'veeqa eyhen cuvab g'ayxhes dekkanname bıdaala vor.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Yugna insan Rəbbine ulen aqqaqqana,</para>
  <para style="q2" vid="PRO 12:2">yik'eençe pisın ı'lğəəname, Mang'vee muhaakima ha'as.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />İnsan pisınçil it'umra ulyozaras deş,</para>
  <para style="q2" vid="PRO 12:3">qorkung'una kokub ı'ğviykarna deş.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Yugna xhunaşşe adamiyn tac vodun,</para>
  <para style="q2" vid="PRO 12:4">tesser ha'anar vuk'arne bark'uk akar.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Qopkuynbışde fıkree qotkuyn məhkama hı'iy vod,</para>
  <para style="q2" vid="PRO 12:5">pisınbışde fıkreeyid hor hı'iy vod.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Pisınbışin cuvab hapt'asda gugu vobna,</para>
  <para style="q2" vid="PRO 12:6">qopkuynbıme cone mizeka g'ittiviyxhan.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Pisınbı qukkyopk'ul cokun eyxhen,</para>
  <para style="q2" vid="PRO 12:7">qorkung'un xav hı'ğəykaran deş.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />İnsanık'le cune ək'elis sik'ı vuc yugnava eyhe,</para>
  <para style="q2" vid="PRO 12:8">yik'ee hornanamee k'ap'ik'ıle avqa qa'a.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Qıvdyaats'ana, cuqa g'ulnana insan,</para>
  <para style="q2" vid="PRO 12:9">vuceecar-vuc xərra ıkkekkane, gıney dena axuyne insanıle yugra vor.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Qorkune insanıs cuna həyvanıb qiviykkanna,</para>
  <para style="q2" vid="PRO 12:10">pisde insanna yugvallab zaalımiyvalla vob.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Cun ciga ezu-qiyşalang'vee ats'esınmeen gıneyxhe oyxhanan,</para>
  <para style="q2" vid="PRO 12:11">bəç'ərme q'ərane karbışde qihnaxhe ayk'anna.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Pisıng'us menne pisınbışe g'ayşuyn kar ıkkiykan,</para>
  <para style="q2" vid="PRO 12:12">qorkung'une kokunub şagav heles.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Pisda insan cune bınahnane cuvabıl-alla gugeeqa gexha,</para>
  <para style="q2" vid="PRO 12:13">qorkuna dağamiyvalike hexvana.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Yugun cuvab uvhiyng'vee mançike yugun alyaat'as,</para>
  <para style="q2" vid="PRO 12:14">cune xıleka iş g'ooceng'veeyib çine cigeena hək' alyapt'asda.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Beynyavaysqa cuna yəq qopkuba qavayle,</para>
  <para style="q2" vid="PRO 12:15">k'orane ək'elikang'vee mısləhətıl k'ırı iliyxhen.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Beynyavee qəl zaraba haagva,</para>
  <para style="q2" vid="PRO 12:16">ək'elynang'veeme cuk'le uvhiyne pisde cuvabılqa fıkır hoole deş.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Qorkune şahadee hək'enxhe yuşan ha'an,</para>
  <para style="q2" vid="PRO 12:17">horalay şahadeeme mısacad qotkuyn eyhe deş.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Nəxüd qadiy uvhiynçin ç'ikayn xhinne g'ats'ayk'van,</para>
  <para style="q2" vid="PRO 12:18">k'orane ək'elika uvhiynçinıd yug qaa'a.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Hək'en cuvab gırgıne gahbışis axva,</para>
  <para style="q2" vid="PRO 12:19">horanab ı'mı'r cit'aba vooxhe.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Pisın fıkreençe ı'lğəəng'une yik'ee hor eyxhen,</para>
  <para style="q2" vid="PRO 12:20">aldapxhıniy ak'an ha'ang'uneme yik'ee şadvalla vooxhena.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Qorkung'une vuk'lelqa ver abaylena deş,</para>
  <para style="q2" vid="PRO 12:21">pisınbışde vuk'leleme balyaa avayk'anna deş.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Rəbbik'le hor ha'ana miz g'umooce vooxhe,</para>
  <para style="q2" vid="PRO 12:22">hək'en eyhenbıme Mang'une ulen avqaaqqanbı.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Ək'elynang'vee ats'al dyugulyxhe ha'an,</para>
  <para style="q2" vid="PRO 12:23">beynyaveeme cuna beynyavavalla hagvana.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />İş g'avces vukkanna xərna ixhes,</para>
  <para style="q2" vid="PRO 12:24">tanbalır həmbal ixhes.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />İnsan arğançe orxhanna fıkır mang'unemee yı'q'ı'n yuk vodun,</para>
  <para style="q2" vid="PRO 12:25">yugne cuvabın yik' şada'an.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Qorkune insanee hambazıs yəq haagva,</para>
  <para style="q2" vid="PRO 12:26">pisde insanname yəq alivku-givku vooxhe.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Tanbalne xılelqa k'on aypxheeyib, mang'vee mana ç'əra qaa'a deş,</para>
  <para style="q2" vid="PRO 12:27">iş g'avces vukkanname gıranne karalqa hiyxharna.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Qopkuvaline yəqbışee ı'mı'r vob,</para>
  <para style="q2" vid="PRO 12:28">vuşu mane yəqbışin ark'ınee qik'as deş.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />K'orane ək'elikane dixee dekkıne terbiyel k'ırı iliyxhen,</para>
  <para style="q2" vid="PRO 13:1">matsxara ha'ang'veeme aq'veeqa eyhene cuvabıl k'ırı iliyxhe deş.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Yugun cuvab uvhiyng'vee, mançike yugun alyaat'as,</para>
  <para style="q2" vid="PRO 13:2">xaainısme mebınbışilqa yiğbı allya'as ıkkiykan.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Ghal sı'ına geer axvas,</para>
  <para style="q2" vid="PRO 13:3">sidi'ınar ek'ra haq'varas.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Tanbalıs hucoomecad geed ıkkan ixheeyid, mana mançilqa hiyxhar deş,</para>
  <para style="q2" vid="PRO 13:4">kar ha'anar gyatsts'ı-gixhxhı eyxhe.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Qorkung'uk'le hor g'ımece eyxhe,</para>
  <para style="q2" vid="PRO 13:5">pisıng'veeme k'ap'ik'ıle avqa qaa'a, naş qa'a.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Məttına ı'mı'r haa'ana qorkuvalin havacena,</para>
  <para style="q2" vid="PRO 13:6">bınahnanar pisvalin yəqqı'le qığayhena.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />İnsan vorna, cuqa vuççud dexheeyid, vuceecar-vuc karnana xhinne ıkkekka.</para>
  <para style="q2" vid="PRO 13:7">İnsanır vorna, cuqa kar geed ixheeyid, vuceecar-vuc kar deşda xhinne ıkkekka.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Karnang'ulqa ı'mı'r pılıka g'attixhanasın yiğ alles əxə,</para>
  <para style="q2" vid="PRO 13:8">kar deşing'uqa məxbına derd deşda.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Qopkuynbışde işixın yik' şada'a,</para>
  <para style="q2" vid="PRO 13:9">pisınbışda bazirıb k'əbəqqəna.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Vuceecar-vuc axtıra ıkkiyke aldatxhuniy gexha,</para>
  <para style="q2" vid="PRO 13:10">mısləhətıl k'ırı iliyxhena k'orana ək'elynana vor.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Xıl sidet'u hı'iyn kar ayk'anan,</para>
  <para style="q2" vid="PRO 13:11">dağamda hı'iyn karme hexxaxhen.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Ts'ıts'ooxhene umudun yik' ık'iyk'ar ha'a,</para>
  <para style="q2" vid="PRO 13:12">yik'eedınçilqa hirxhıliyid ı'mrene yivena<note caller="+" style="f"><char style="fr" closed="false">13:12 </char><char style="fq" closed="false">ı'mrena yiv: </char><char style="ft" closed="false">mançine hək'ee ine kitabee q'oma qətqe (3:18, 11:30).</char></note> meyva opxhuniyk akar vod.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Mısləhət k'ane qıdyaa'ang'vee cukun ha'a,</para>
  <para style="q2" vid="PRO 13:13">əmr axtıba avqaaqang'usub mukaafat hele.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />K'orane ək'elynanbışin xət qı'iy, ı'mı'r hoolene xhinek akar.</para>
  <para style="q2" vid="PRO 13:14">Mançin insan qik'uyne xhımıç'bışike sak'al ha'a.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />K'orane ək'elynang'us hı'rmat giviyxhe</para>
  <para style="q2" vid="PRO 13:15">xaainna yəqı'b yı'q'ba vob.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Ək'elynang'vee ats'aalika iş g'ooce,</para>
  <para style="q2" vid="PRO 13:16">bəç'əree cuna beynyavavalla haagva.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Ts'om deşde xabar vukkekang'ulqa ver abaylena,</para>
  <para style="q2" vid="PRO 13:17">ts'omnane xabar vukkekang'vee yug qaa'a.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Terbiye ilydyaat'ana kar dena axva, k'ap'ik'ıle avqa qexhe,</para>
  <para style="q2" vid="PRO 13:18">aq'veeqa uvhiyne cuvabıl k'ırı iliyxhename hı'rmatıka eyxhena.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Yik'es ıkkanançilqa hirxhılyxhee, man yugda qadayle.</para>
  <para style="q2" vid="PRO 13:19">Beynyavayk'le pisınçile sapk'ılıy g'ımece eyxhe.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />K'orane ək'elikang'uka hambaziyvalla haa'ana, vucur ək'elikana eyxhena,</para>
  <para style="q2" vid="PRO 13:20">beynyavayka axuyng'ulqab verxhe abaylena.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Bınahnana dağamiyvalla dena axva deş,</para>
  <para style="q2" vid="PRO 13:21">qorkung'una payıb barakat vobna.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Yugne insanee nevabışisınıd karxhe g'alyadaççen,</para>
  <para style="q2" vid="PRO 13:22">bınahnang'vee sı'iyn kar qorkung'us axvan.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Kar deşing'une çolun geed şagav huveeyid,</para>
  <para style="q2" vid="PRO 13:23">q'aanunun eyhenbı hidya'ane insanaaşike man axva deş.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Dixes çümq üvxəs qiviykkanne dekkıs, dix ıkkiykan deş.</para>
  <para style="q2" vid="PRO 13:24">Dix ıkkanang'vee dixes qotkuyn terbiye hele.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Qorkuna otxhun ayts'ena,</para>
  <para style="q2" vid="PRO 13:25">pisdame mıssıra axva.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />K'orana ək'elynane zəiyfee, ces xavxhe ha'an,</para>
  <para style="q2" vid="PRO 14:1">beynyava zəiyfeeme cen xav cene xıleka hı'ğəkkar ha'an.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Qopkuna yəq avquna Rəbbile qəyq'ən,</para>
  <para style="q2" vid="PRO 14:2">yəqqı'le qıtteç'uyng'veeme Mang'us hı'rmat giviyxhe deş.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Beynyavee, yuşan ha'amee, vucecar-vuc hagvava, çümqxhe qiviyxharna,</para>
  <para style="q2" vid="PRO 14:3">k'orana ək'elynang'une gafınme mana g'attixhan ha'ana.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Yats deşdang'a, axur məttıba vooxhe,</para>
  <para style="q2" vid="PRO 14:4">yugun g'ıkıd yatsbışde taq'atınxhe helen.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Ts'omnane şahadee hor ha'a deş,</para>
  <para style="q2" vid="PRO 14:5">hor ha'aneme şahadın nafasıd hor eyxhe.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Matsxara haa'ang'vee k'orana ək'el t'abal hav'eeyib, mana iveeke deş.</para>
  <para style="q2" vid="PRO 14:6">Ək'elikane insanısme ats'al alyaat'uy vaxxariyda vod.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Beynyavayne ögiyle agvle,</para>
  <para style="q2" vid="PRO 14:7">mang'une ghalençe ats'al qığeç'es deş.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />K'orane ək'elikang'uk'le cuna yəq vaats'ana,</para>
  <para style="q2" vid="PRO 14:8">beynyaveeme cuscad hor ha'a.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Beynyavabışe bınahbışil-alla allya'an q'urbanbı matsxara ha'a,</para>
  <para style="q2" vid="PRO 14:9">Allahna ulyub qopkuynbışil vob.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Yik'ek'le çin uts'ur ats'an,</para>
  <para style="q2" vid="PRO 14:10">mançina şadvallab merıng'uka bit'al haa'as vooxhe deş.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Pisınbışin xav hı'ğəkkarasın,</para>
  <para style="q2" vid="PRO 14:11">qopkuynbışda çadırme t'et'-t'elee vuxhes.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Məxbına yəq vobna, insanık'le qopkuba g'ooce,</para>
  <para style="q2" vid="PRO 14:12">mana ç'əvooxhen cigame qik'uy vod.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Sassa yəqqees insanee əqəna ha'ameeyid, mang'une yik'ee derd vooxhe.</para>
  <para style="q2" vid="PRO 14:13">Sassa yəqqeesıb şadvallab derdıka ç'əvooxhe.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Yəqqı'le qığeç'uyng'veeyid, yugung'veeyid</para>
  <para style="q2" vid="PRO 14:14">co hı'iynçil-allana pay alyapt'asda.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Caahil uvhiyne gırgıne cuvabıl hayexhena,</para>
  <para style="q2" vid="PRO 14:15">ək'elynang'veeme vucee ha'ane gırgıne karana fıkır haa'ana.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />K'orana ək'elikana pisvalike qərq'ı'n mançile siyk'alna,</para>
  <para style="q2" vid="PRO 14:16">beynyavayqame qərq'ı'niy deşin, mang'vee fıkır udyopxhun nen qadiy ha'an.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Zaraba qəl vooxheng'vee beynyavavalla haa'a.</para>
  <para style="q2" vid="PRO 14:17">Yik'eençe pisın fıkırbı ı'lğəənar insanaaşik'le g'ımece eyxhe.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Caahilyaaşina pay beynyavavalla vobna,</para>
  <para style="q2" vid="PRO 14:18">ək'elynanbışinıd tac ats'al vodun.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Pisınbı yugunbışde ögil,</para>
  <para style="q2" vid="PRO 14:19">bınahnanbıb qopkuynbışde akkayne ögil k'yoozaras.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Kar deşda cone delesınbışisır ıkkiykan deş,</para>
  <para style="q2" vid="PRO 14:20">karnane insanıqame geeb hambazar vooxhe.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Merıng'uqa ooğançe avqa ilyakkana bınaheeqa k'exha,</para>
  <para style="q2" vid="PRO 14:21">kar deşing'uka yugra eyxhena baxtivar vorna.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Yik'eençe pisın fıkırbı ı'lğəənbı yəqqı'le qıtteepç'ı dişee?</para>
  <para style="q2" vid="PRO 14:22">Ək'leençe yugun hı'iy ı'lğəənbışik'le yugvallayiy qopkuvalla iveeke.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Gırgıne dağamne işee xayir vod,</para>
  <para style="q2" vid="PRO 14:23">vuççud hidya'a yuşancar ha'axhee, q'ərar axvas.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />K'orane ək'elynanbışin kar manbışin mukaafat vodun,</para>
  <para style="q2" vid="PRO 14:24">beynyavabıme cone ək'elydeşvalika qıvaats'a.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Ts'omnane şahadee canbı g'attixhan ha'a,</para>
  <para style="q2" vid="PRO 14:25">horalay şahadınme horxhe ha'an.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Rəbbile qəyq'ənna alyapt'as dəəxəne g'alee xhinne vor,</para>
  <para style="q2" vid="PRO 14:26">Rəbbee mang'un uşaxarıb g'attivxhan haa'asınbı.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Rəbbile qərq'ı'niy ı'mı'r hoolen xhyan xhinne vod,</para>
  <para style="q2" vid="PRO 14:27">mançin insan qik'uyne xhımıç'bışike sak'al ha'a.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Paççahna xəbvalla milletne geedvalika vaats'a vooxhe,</para>
  <para style="q2" vid="PRO 14:28">millet deşxhee, paççahıkınıd ixhesın.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Sabırnang'uqa xəbna ək'el vob,</para>
  <para style="q2" vid="PRO 14:29">sabır deşing'veeyib cuna beynyavavalla haagva.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Yik' adğançe otxhanan fıkırbı deşxhee, mançin canıs ı'mı'r hoole,</para>
  <para style="q2" vid="PRO 14:30">paxılıyvalinıd bark'vbı qı'ça'a.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Kar deşing'us əq'üba hooleng'vee, mana İrxıning'uk'le cuvab eyhen xhinne eyxhe.</para>
  <para style="q2" vid="PRO 14:31">Mang'us hı'rmat giviyxhenar kar deşing'uka yugra eyxhe.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Pisde insanıkın cune pisvalincad ha'a,</para>
  <para style="q2" vid="PRO 14:32">qorkung'uqa qek'ang'ar g'attixhanasın ciga vodun.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />K'orana ək'el, ək'elynanbışde yik'ee aaxva,</para>
  <para style="q2" vid="PRO 14:33">beynyavabışik'leb çikana mana g'oocena.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Qopkuvalin millet axtı qa'a,</para>
  <para style="q2" vid="PRO 14:34">bınahınme milletıs naş qa'a.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Paççahne ulen ək'elynana həmbal aqqaqqana,</para>
  <para style="q2" vid="PRO 14:35">naş qixhesın karbı ha'ang'ulqame mang'una qəl avqaaqqa.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />G'üvənane alidghıniyn qəl avaak'an haa'a,</para>
  <para style="q2" vid="PRO 15:1">aq'veeqa sark'ıliynme qəl sık'ılbab geeb qaa'a.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />K'orane ək'elynang'une mizen ats'al axtı qa'a,</para>
  <para style="q2" vid="PRO 15:2">beynyavayneme ghalençe beynyavavalla k'əə.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Rəbb gırgınəəng'ə ilyakkana,</para>
  <para style="q2" vid="PRO 15:3">pisdar, yugnar Mang'ule dyugulexhe deş.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />G'üvənana miz ı'mrena yiv<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="fq" closed="false">ı'mrena yiv: </char><char style="ft" closed="false">mançine hək'ee ine kitabee q'oma qətqe (3:18, 11:30).</char></note> vobna,</para>
  <para style="q2" vid="PRO 15:4">hor ha'ançinıd yik' haq'vara'an.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Beynyavee dekkın terbiye demalqa giyxhe,</para>
  <para style="q2" vid="PRO 15:5">aq'veeqa uvhiyne cuvabıl k'ırı iliyxhename ək'elikana vor.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Qorkung'une xaa xəbna xaziyna vob,</para>
  <para style="q2" vid="PRO 15:6">pisınbışde karanme manbışilqa yiğ allya'a.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />K'orane ək'elikang'une mizen ats'al hixhar ha'a,</para>
  <para style="q2" vid="PRO 15:7">beynyavabışde yik'bışisse man ha'as əxə deş.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Rəbb pisde insanee ablyav'uyne q'urbanıle həlyvəyq'ənna,</para>
  <para style="q2" vid="PRO 15:8">qopkuynbışda düəme Mang'une yik'eençe vooxhe.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Rəbbik'le pisde insanna yəq g'umooce vooxhe,</para>
  <para style="q2" vid="PRO 15:9">qopkuvaliqab qihna əlyhəənbıme vukkiykananbı.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Qopkuna yəq g'alepçiyng'us it'umun dars heles,</para>
  <para style="q2" vid="PRO 15:10">aq'veeqa uvhiyn cuvab dekkanang'ukunud ixhesın.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Ahal Rəbbile dygulyda deş vod,</para>
  <para style="q2" vid="PRO 15:11">insanaaşin yik'bıd Mang'uk'le g'ecenbı.<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Matsxara ha'ang'uk'le aq'veeqa cuvab uvhumee ıkkiykan deş,</para>
  <para style="q2" vid="PRO 15:12">k'orane ək'elynanbışde k'anyaqar araylena deş.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Yik' şaddanang'a aq'vad hits'aygharan,</para>
  <para style="q2" vid="PRO 15:13">yik' hatq'urme rı'h dena qexhe.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Ək'elikang'vee ats'al alyaat'a,</para>
  <para style="q2" vid="PRO 15:14">beynyavar beynyavavalin gyatsts'ı eyxhe.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Kar deşing'un gırgın yiğbı k'aarıda vod,</para>
  <para style="q2" vid="PRO 15:15">yik' şadnar itteyhesğu otxhan-ulyoğacar eyxhe.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Rəbbile qəyq'ənang'un k'ılda kar,</para>
  <para style="q2" vid="PRO 15:16">fıkren arğançe orxhanang'une geedne karale yugda vod.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Mühübbatıka xhınakın ala otxhuniy,</para>
  <para style="q2" vid="PRO 15:17">qəlıka geed boğayn çuru otxhuniyle yugda vod.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Qəlnang'vee aldapxhıniy ha'a,</para>
  <para style="q2" vid="PRO 15:18">sabırnang'veeyid ç'əv ha'a.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Tanbalne yəqqə ğı'ç'iy aleyle,</para>
  <para style="q2" vid="PRO 15:19">qopkuynbışda yəqme əq'ba vooxhe.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />K'orane ək'elynane dixee dek şada'ana,</para>
  <para style="q2" vid="PRO 15:20">beynyaveeme yed k'ap'ik'ıle avqa qee'e.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Ək'el deşda beynyavavalile şadexhe,</para>
  <para style="q2" vid="PRO 15:21">ə'kelynaname qorkune yəqqı'n ayk'anna.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Mısləhət devxhee, ha'an kar ixhes deş,</para>
  <para style="q2" vid="PRO 15:22">mısləhət hoolenbı geebxheene, man kar ixhesın.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />İnsanıs kara'əəda cuvab quvuna şadexhena,</para>
  <para style="q2" vid="PRO 15:23">cigee uvhiyn cuvab nimee yugdayiy!<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Ək'elikana insan avqa ahaleeqa g'ı'mexhacenva,</para>
  <para style="q2" vid="PRO 15:24">ı'mrena yəq avqu, ooqa ts'ıts'exhe.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Cocab-co axtıba vukkekkanbışin xav Rəbbee hı'ğəkkar ha'asın,</para>
  <para style="q2" vid="PRO 15:25">sip'ıriy zəiyfayne cigayna sarhad havaacesda.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Rəbbik'le pisınbışin fıkırbı g'ımece eyxhe,</para>
  <para style="q2" vid="PRO 15:26">uftanın cuvabme Mang'usqa məttıda qadayle.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Mıssıne ulynang'vee xizanılqa əzaab ablyaa'a,</para>
  <para style="q2" vid="PRO 15:27">ruşvat g'ımece insanna ı'mı'r xıliyba vooxhe.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Qorkune insanee cuvab qelesse fıkır ooxhan,</para>
  <para style="q2" vid="PRO 15:28">pisde insanneme mizele pisvalla k'əə.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Rəbb pisde insanaaşile əq'əna eyxhena,</para>
  <para style="q2" vid="PRO 15:29">qopkune insanaaşineme düəl k'ırı iliyxhe.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Nurukane uleppışe yik' şada'a,</para>
  <para style="q2" vid="PRO 15:30">yugne xabarbışed bark'vbı yug qa'a.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Aq'veeqa uvhiyne cuvabıl k'ırı iliyxheng'vee xıliyna ı'mı'r ha'as,</para>
  <para style="q2" vid="PRO 15:31">k'orane ək'elynanbışde yı'q'nee axvas.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Terbiye əq'əna qa'ang'uk'le cuk'le-vuc g'ımece eyxhe,</para>
  <para style="q2" vid="PRO 15:32">aq'veeqa uvhiyne cuvabıl k'ırı iliyxheng'uname ək'el geeb qooxhe.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Rəbbile qəpq'ı'niyn k'orana ək'eliy terbiye hele.</para>
  <para style="q2" vid="PRO 15:33">Vuceecar-vuc xərra ıkdekkanar hı'rmatıka eyxhe.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Yik'eedın fıkırbı insanıkenbı,</para>
  <para style="q2" vid="PRO 16:1">mizen qelen cuvabıd Rəbbiken vod.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />İnsanın gırgın yəqbı cune ulesqa məttıda qöö,</para>
  <para style="q2" vid="PRO 16:2">Rəbbeeme yik'bı siliys ı'xiyxə.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Ğu ha'asın işbı Rəbbisqa qele,</para>
  <para style="q2" vid="PRO 16:3">manke yiğne yik'eedın ixhesın.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Rəbbee gırgın kar çine cigee itxhın,</para>
  <para style="q2" vid="PRO 16:4">Mang'vee pisda insanır dağamne yiğınemee iyxhan.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Cocab-co axtıba vukkekkanbı Rəbbik'le g'umooce vooxhe,</para>
  <para style="q2" vid="PRO 16:5">vak'le ats'axhxhe, manbı cazaa dena aaxvas deş.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Yugvaliniy qopkuvalin bınah hooğalna,</para>
  <para style="q2" vid="PRO 16:6">insanır Rəbbile qərq'ı'niyke bınahıle siyk'alna.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Rəbbis insanna ı'mı'r yugba qööxhee,</para>
  <para style="q2" vid="PRO 16:7">Mang'vee duşmanarıb hambazar haa'a.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Qopkuvalika hı'iyn k'ılda kar,</para>
  <para style="q2" vid="PRO 16:8">qopkuda hidi'iyne geedne karale yugda vod.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />İnsanee yik'ee cunemee yəq haa'a,</para>
  <para style="q2" vid="PRO 16:9">Rəbbeeme mana Cus ıkkanne cigeeqa qıkkekka.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Paççahee xəənçe vuk'leeqa k'eççuyn eyhe,</para>
  <para style="q2" vid="PRO 16:10">mang'une mizen qotkuyn eyhes ıkkan.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Qotkuyn g'apan Rəbbina q'aanun vobna,</para>
  <para style="q2" vid="PRO 16:11">q'oç'eedın gırgın terezyugun g'ayebıd Cuke vodunbı.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Paççahaaşik'le pisın işbı g'ımece eyxhe,</para>
  <para style="q2" vid="PRO 16:12">qopkuvallanang'a manbışda taxt it'umba ulyoozar.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Paççahaaşis ıkkanan kar qopkuna miz vob,</para>
  <para style="q2" vid="PRO 16:13">manbışisqa qotkuyn eyhenbı yugba qavayle.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Paççahna qəl qik'uyva eyhen vodun,</para>
  <para style="q2" vid="PRO 16:14">k'orane ək'elikang'veeme mana dissara'ana.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Paççahne aq'vayn əqəna ha'axhee, mana ı'mı'r vobna,</para>
  <para style="q2" vid="PRO 16:15">mang'une ulen ğu aqqıxhee, man yuxhxhaniyne gyoğiyk akar.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />K'orane ək'elyna ıxhay, k'ınəəğəyna ıxhayle yugda vod.</para>
  <para style="q2" vid="PRO 16:16">Nuk'ra sı'iyled ək'el sav'iy ooqa vod.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Qopkuynbışde yəqqı'n pisınçike aqqaqqa,</para>
  <para style="q2" vid="PRO 16:17">cuna yəq avquyng'vee, cuna ı'mı'r havaace.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Ğucar-ğu axtıra ıkkekaxhee, vakın ha'asın,</para>
  <para style="q2" vid="PRO 16:18">vuceecar-vuc axtı qı'ing'ulqab balyaaxhe abaylena.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Kar deşinbışde yı'q'nee vucecar-vuc xərra ıkdekkana ıxhay,</para>
  <para style="q2" vid="PRO 16:19">cocab-co axtıba vukkekanbışika mebınbışin kar g'ayşuyle yugda vod.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Cuvabıke ats'al alyaat'ang'uk'le yugun aveykesın,</para>
  <para style="q2" vid="PRO 16:20">Rəbbilqa yı'q' qizzırna nimee baxtivariy!<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />K'orane ək'elynang'uk'le ats'alynanava eyhe,</para>
  <para style="q2" vid="PRO 16:21">ittune miznang'ussed geed xət qa'as əxə.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Ək'el vobnang'unemee, ək'el ı'mı'r hoolene xhinek akar vob,</para>
  <para style="q2" vid="PRO 16:22">beynyavays terbiye huviy bəç'əriyvalla vob.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />K'orana ək'elynang'une mizen ats'al hele,</para>
  <para style="q2" vid="PRO 16:23">mang'usse geed kar xət qa'as əxə.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Uftanın cuvab t'ap'aneedın itv xhinne vod,</para>
  <para style="q2" vid="PRO 16:24">canas yugda, rı'hı's ittuda.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Məxbına yəq vobna insanık'le qopkuba g'ooce,</para>
  <para style="q2" vid="PRO 16:25">mana ç'əvooxhen cigame qik'uy vod.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />İnsanee cune vuxhnel-alla iş g'ooce,</para>
  <para style="q2" vid="PRO 16:26">mıssıvalin mana ilekka.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Karaı'dəəng'une fıkreençe pisın hı'iy ılğeç'e,</para>
  <para style="q2" vid="PRO 16:27">mang'une mizen ts'ayın xhinne gyooxhan haa'a.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Hor ha'ang'vee dəv'ə abaççe,</para>
  <para style="q2" vid="PRO 16:28">ing'una-şeng'una haa'ang'vee yugun hambazar curaa'a.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Pisın ha'ang'vee mernar yəqqı'le qığayhena,</para>
  <para style="q2" vid="PRO 16:29">mana karaı'dəəne yəqqı'lqa ts'ıts'aa'a.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Yik'eençe hor ı'lğəəng'vee ulyxhe giviyxəna,</para>
  <para style="q2" vid="PRO 16:30">pışnebı ats'ayk'van, pisınxhe ha'an.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Cagvaran ç'ərbı uftanın tac vod,</para>
  <para style="q2" vid="PRO 16:31">manab qopkune yəqqı'na hək' vob.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Gucnang'ule sabırnana yugra,</para>
  <para style="q2" vid="PRO 16:32">şaharbı alyaat'ang'uler vuc aqqaqqana yugra.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />İnsanaaşe çöp k'eçveeyid,</para>
  <para style="q2" vid="PRO 16:33">mançin Rəbbis ıkkanan hagva.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Saç'uvkiy deşda qit'ipk'ınna xüvə,</para>
  <para style="q2" vid="PRO 17:1">aldapxhıniynane otxhun-ulyodğuyle ittuba vob.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Ək'elikane həmbalee, karaı'dəəne iyesiyne dixes xəbvalla haa'as,</para>
  <para style="q2" vid="PRO 17:2">iyesiyne uşaxaaşikab mang'vee mirasna pay alyapt'as.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />K'ınəəğəynayiy nuk'rayna yugvalla ts'ayika vaats'a vooxhe,</para>
  <para style="q2" vid="PRO 17:3">Rəbbeeyid insanın yik' siliys ı'xiyxə.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Karaı'dəəna insan pisıng'une ghaliqa ilyakka,</para>
  <para style="q2" vid="PRO 17:4">horalayeeyid ver ablyaa'ane mizel k'ırı iliyxhe.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Kar deşing'ule əqəna ha'ana, mana İrxıning'uk'le cuvab eyhen xhinne eyxhe.</para>
  <para style="q2" vid="PRO 17:5">Merıng'une vuk'lelqa qadıynçile şadexhena, cazaa dena axva deş.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Nevabı q'əsınbışin tac vodun,</para>
  <para style="q2" vid="PRO 17:6">dixbışis hı'rmat cone dekkaaşil-alla giviyxhe.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Uftanna gaf beynyavayk idyvaak'an xhinne,</para>
  <para style="q2" vid="PRO 17:7">xərıng'ukıd horbı avaak'a deş.<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Ruşvat heleng'une ulesqa man cadu xhinne qöö:</para>
  <para style="q2" vid="PRO 17:8">mana nyaqa ark'ınee, iş qooxhena.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Hambaz ıkkanang'vee bınah yik'el hivxan haa'a,</para>
  <para style="q2" vid="PRO 17:9">yik'el qavaalya'ang'vee hambaz agval ha'a.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Aq'veeqa uvhiyne cuvabın ək'elikane insanın aq'va-xhane,</para>
  <para style="q2" vid="PRO 17:10">beynyavays üvxüyne vəşne çümqüle geed gyoxhxhan ha'a.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Alikkı-gikkiy adaççene insanee pisın kar t'abal ha'a,</para>
  <para style="q2" vid="PRO 17:11">mang'ulqa it'umna cazaa g'axuvles<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="fq" closed="false">mang'ulqa it'umna cazaa g'axuvles: </char><char style="ft" closed="false">mane cühüt'yaaşine mizelyne cuvabıka inəxübnab mə'na vobna: «mang'ulqa rəhı'm deşda malaaik g'axıles».</char></note>.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Balabı dena avxuna syo qızaaxiy,</para>
  <para style="q2" vid="PRO 17:12">beynyavavalika gyatsts'ıyne beynyava qızaxxiyle yugda vod.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Şavaayiy merıng'us yugun hı'inçil-alla pisın he'ee,</para>
  <para style="q2" vid="PRO 17:13">məxrıng'une xaançe pisvalla əlyhəəs deş.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Saç'uvkiyn gidğılıy bendık ciga hı'iyk akar.</para>
  <para style="q2" vid="PRO 17:14">Saç'uvkiy giğalasse, man ç'əv he'e.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Bınahnana, bınah deşda xhinne haguy,</para>
  <para style="q2" vid="PRO 17:15">bınah deşing'ulqab, bınah qav'uy –</para>
  <para style="q2" vid="PRO 17:15">man q'öyudsana kar Rəbbik'le g'ımece vod.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Beynyavayqa pıl ixheeyid,</para>
  <para style="q2" vid="PRO 17:16">mang'usse mançika k'orana ək'el alivşes vəəxəs deş.<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Hambazıs hammaşe ıkkiykanna,</para>
  <para style="q2" vid="PRO 17:17">çocur dağamne yiğıs iyxhanna.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Saccu beynyavee, merıng'un şib</para>
  <para style="q2" vid="PRO 17:18">cune gardanaqa alyaat'a.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Aldatxhuniy ıkkanang'us, bınahıb vukkiykanna.</para>
  <para style="q2" vid="PRO 17:19">Şavaayiy cus ç'ak'ın, axtın akkabı giyxhe, mang'vee culqa balyaa hoot'al.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Yik'ee bicvallanag'uk'le xayir aveekes deş,</para>
  <para style="q2" vid="PRO 17:20">hor ha'ane miznang'vee culqa ver ablyaa'a.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Bəç'ərne dekkee cune vuk'lelqa ver ablyaa'a,</para>
  <para style="q2" vid="PRO 17:21">beynyavayna dek şadexhena deş.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Şadne yik'en darmanın xhinne yug qaa'a,</para>
  <para style="q2" vid="PRO 17:22">hatq'urne yik'enme bark'vbıd qı'ç'a'anbı.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Pisıng'vee qotkuyn məhkama alikka'asva,</para>
  <para style="q2" vid="PRO 17:23">ruşvat xhıtyxhalis ı'xiyxə.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Kar ats'ane insanın uleppı k'orane ək'eliqa ilyakka,</para>
  <para style="q2" vid="PRO 17:24">beynyavaynme uleppı, nyaqa qadiy ilyakka.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Beynyava dixee, dekkıs derd hoole,</para>
  <para style="q2" vid="PRO 17:25">yedilqad divan allya'a.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Qorkune insanıs cazaa huvuy yugun deş vod,</para>
  <para style="q2" vid="PRO 17:26">xərıng'usub qotkuda hı'iyne karal-alla çümq üvxiy yugun deş vod.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Geed ats'ana k'ırra yuşan ha'ana,</para>
  <para style="q2" vid="PRO 17:27">ək'elikang'usub zaraba qəl vooxhe deş.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Beynyava yuşan hidya'amee, ək'elynana xhinne g'ece,</para>
  <para style="q2" vid="PRO 17:28">mang'vee ghal idyaaqee, ats'alynana xhinne ixhes.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Cus irxhınna insan cus ıkkanançiqa qihna gexhana,</para>
  <para style="q2" vid="PRO 18:1">məxrıng'vee ək'elikane cuvabısıd ghalybı qa'a.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Beynyavays fıkır ooxhanas vukkiykan deş,</para>
  <para style="q2" vid="PRO 18:2">mang'vee yik'eedıncad eyhe.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Pisde insanıka sacigee hı'rmat deşiyvalla,</para>
  <para style="q2" vid="PRO 18:3">naş qıxhayka sacigeeyid k'ap'ik'ıle avqa qıxhay qadayle.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Mizelin cuvab k'oran xhyan xhinne vod.</para>
  <para style="q2" vid="PRO 18:4">K'orana ək'el xhyan ı'lqəən, xhyan qoyxharan ciga xhinne vod.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Məhkamee qorkung'ulqa bınah qa'asva,</para>
  <para style="q2" vid="PRO 18:5">pisıng'un sura aqqiy yugda deş vod.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Beynyavayne mizen aldatxhuniy ha'a,</para>
  <para style="q2" vid="PRO 18:6">ghalinır vuc geta'a.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Beynyavayne mizen mang'ukun ha'an,</para>
  <para style="q2" vid="PRO 18:7">mang'une ghalinıb cus gugu haa'a.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />İng'una-şeng'una haa'ang'un cuvab ittune xüvəyk akar,</para>
  <para style="q2" vid="PRO 18:8">man yik'ene k'oralybışeeqa g'e'exhxha.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Tanbalba iş g'oocena</para>
  <para style="q2" vid="PRO 18:9">hı'ğəkkar ha'ang'uk akar.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Rəbbin do it'umna g'ala vob,</para>
  <para style="q2" vid="PRO 18:10">qorkuna maqa hixu, g'ittiyxhanna.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Karnang'usqa həməxüd qöö,</para>
  <para style="q2" vid="PRO 18:11">con kar axtıne barugbışika alyav'una g'alaniyxan.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Yik'ee insanee vuceecar-vuc axtıra ıkkekaxhee, mang'ukun ixhesın.</para>
  <para style="q2" vid="PRO 18:12">Vuceecar-vuc xərra ıkdekkanar hı'rmatıka eyxhe.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />K'ırı ilydiyxhı cuvab quvuy</para>
  <para style="q2" vid="PRO 18:13">man naş qixhesın kar vod, beynyavavalla vob.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />İnsanın yik' gırgıne ık'arbışis öödəxən,</para>
  <para style="q2" vid="PRO 18:14">yik' hatq'urxhee, şavusse mançis öörxəs əxəyiy?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Ək'elikang'vee ats'al alyaat'a,</para>
  <para style="q2" vid="PRO 18:15">k'orane ək'elikang'une k'ırıynıd man t'abal ha'a.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Payın insanıs yəq aaqa,</para>
  <para style="q2" vid="PRO 18:16">ç'ak'ıne insanaaşisqa hixhar ha'a.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Merna arı, qidghınbı ha'asmee,</para>
  <para style="q2" vid="PRO 18:17">ts'erra yuşan hı'ına qorkura eyxhe.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Çöp k'eççuyn saç'uvkiy ulyozar ha'a,</para>
  <para style="q2" vid="PRO 18:18">it'umba aldaaxhvananbıb curaa'a.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Tsimisna çoc alyapt'as dyooxhene g'alayk akar,</para>
  <para style="q2" vid="PRO 18:19">aldapxhıniybıd akkalyne rızayk.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />İttune mizeka insanee cuna vuxhun avts'yaa'a,</para>
  <para style="q2" vid="PRO 18:20">cune cuvabıka ı'mresın kar ha'a.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Qik'uyir, axuyir mizene xıle vod,</para>
  <para style="q2" vid="PRO 18:21">mana vukkananbışe mançin şagav oxhanas.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Xhunaşşe hey'ing'uk'le yugun iveeke.</para>
  <para style="q2" vid="PRO 18:22">Mana Rəbbine ulen aqqıva eyhen vodun.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Kar deşing'vee rəhı'm hee'eva miz k'yaa'a,</para>
  <para style="q2" vid="PRO 18:23">karnang'veeme mang'us yı'q'ı'n alidghıniy qele.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Hambazar geeb qaa'ang'vee, cukun ha'a.</para>
  <para style="q2" vid="PRO 18:24">Hək'ena hambazme çocule k'ane eyxhe.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Kar deşda, məttına yik'nana insan,</para>
  <para style="q2" vid="PRO 19:1">hor ha'ane beynyavayle yugra vor.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Hucoomecad ha'as ıkkanxhee, man nəxüd hı'iy dyats'axhee, man yugda ixhes deş.</para>
  <para style="q2" vid="PRO 19:2">Ek'ra hoyharna, yəqqı'le qığeç'ena.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />İnsanee cune beynyavavalika, cune ı'mrekın ha'a,</para>
  <para style="q2" vid="PRO 19:3">yik'eeyib Rəbbilqa qəl haa'a.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Karan geeb hambazar saa'a,</para>
  <para style="q2" vid="PRO 19:4">kar deşdame gırgıne hambazaaşe g'alyaraççena.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Horalay şahad cazaa dena axvas deş,</para>
  <para style="q2" vid="PRO 19:5">horbışika aq'val ulyorzulynar, cazaale g'attixhanas deş.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Geebınbışis ç'ak'ınbışde ulyaqa eepç'es vukkiykan,</para>
  <para style="q2" vid="PRO 19:6">paybı heleng'uqab gırgınbı hambazar vooxhe.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Kar deşda çocaaşik'ler g'ımece eyxhe,</para>
  <para style="q2" vid="PRO 19:7">hambazarıb mang'ule əq'əna qooxhe,</para>
  <para style="q2" vid="PRO 19:7">mang'vee manbı qoot'almee, nyaacab iveeke deş.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Cus yugun ıkkanang'vee ək'el hexxaa'a,</para>
  <para style="q2" vid="PRO 19:8">ək'el havaacınar gırgınçina eyxhena.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Horalay şahad cazaa dena axvas deş,</para>
  <para style="q2" vid="PRO 19:9">horbışika aq'val ulyorzulynar qik'asda.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Beynyavays karnana ı'mı'r idyvaak'an xhinne,</para>
  <para style="q2" vid="PRO 19:10">həmbalısıb ç'ak'ınbışis xəbvalla hav'uy avaak'a deş.<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Ək'elikane insanıs qəl zaraba vooxhe deş,</para>
  <para style="q2" vid="PRO 19:11">merıng'une bınahıke ılheç'uyn insan xərra hagva.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Paççahna qəl aslanne ts'irık akar,</para>
  <para style="q2" vid="PRO 19:12">mang'un ulen aqqıyid çolulqa g'e'exhxhane çiyik akar.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Beynyava dixee dekkılqa ver ablyaa'a,</para>
  <para style="q2" vid="PRO 19:13">siç'eekvana xhunaşşer ç'əvcab dyooxhene t'yank'ık akar.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Xaviy var-devlet dekkına miras vobna,</para>
  <para style="q2" vid="PRO 19:14">ək'elikana xhunaşşer Rəbbikena pay vobna.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Tanbalıyvalin insanıs k'oran nyak' halya'a,</para>
  <para style="q2" vid="PRO 19:15">iş hidyav'iynır insan mıssıra g'alyaraççe.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Əmrın uvhiyn ha'ang'vee ı'mı'r havaace,</para>
  <para style="q2" vid="PRO 19:16">cune yəqqı'qa yugra ilydyakkanar qik'asda.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Kar deşing'uka yugra eyxheng'vee itteyhesğu Rəbbis şib hele,</para>
  <para style="q2" vid="PRO 19:17">mançine cigeen Rəbbike qales.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Umud vobna, dixes terbiye hele,</para>
  <para style="q2" vid="PRO 19:18">mang'une qik'vee yiğnab xıl mooxhecen.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Geer qəlıkanang'us cazaa hevles vukkan,</para>
  <para style="q2" vid="PRO 19:19">vas mana qiykınee, mang'vee man meed ha'asın.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Mısləhətıl k'ırı alixhxhe, terbiye aleet'e.</para>
  <para style="q2" vid="PRO 19:20">Məxüd he'ee, sabara gahıle k'orane ək'elyna ixhes.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />İnsanne yik'ee geed kar vod,</para>
  <para style="q2" vid="PRO 19:21">ı'mree eyxhenbıme saccu Rəbbis ıkkananbı vod.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />İdyayts'ene ulen insan g'eliqqa hele,</para>
  <para style="q2" vid="PRO 19:22">kar deşda insanır horalayre yugra vor.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Rəbbile qərq'ı'niyn ı'mı'r xıliy qaa'a.</para>
  <para style="q2" vid="PRO 19:23">Rəbbile qəyq'ənna ittura g'ılexhana,</para>
  <para style="q2" vid="PRO 19:23">pisınıd mang'uk set'a deş.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Tanbalee xıl g'abeeqa hiyxə,</para>
  <para style="q2" vid="PRO 19:24">mançe xıl ghalyaqa ıkkekka deş.<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Matsxara haa'ang'us cazaa hevle, manke caahilyarıb ək'eleeqa qavaales.</para>
  <para style="q2" vid="PRO 19:25">Ək'elikang'uk'le aq'veeqa cuvab uvhee, mang'un ats'al hexxaxhes.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Şavaayiy dek q'əra qı'ı yed g'e'eyşu,</para>
  <para style="q2" vid="PRO 19:26">mana naş qa'ana dix vor.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Dix, terbiyel k'ırı alixhxhiyle xıl ts'ıts'av'ee,</para>
  <para style="q2" vid="PRO 19:27">ats'al helene yəqqı'ler qığeç'esda.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Karaı'dəəne şahadee qopkuvalla matsxara haa'a,</para>
  <para style="q2" vid="PRO 19:28">pisıng'une ghalen bınah opxhan.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Matsxara haa'anbı cazaa dena aaxvas deş,</para>
  <para style="q2" vid="PRO 19:29">beynyavabışde yı'q'əsıb çümq üvxəs.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Çaxıriy eraq'iy ulyodğu, insanaaşe mebınbı matsxar haa'a, aldaaxhvan haa'a.</para>
  <para style="q2" vid="PRO 20:1">P'iyanna insan k'orana ək'elyna eyxhe deş.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Paççahna qəl aslanne ts'irık akar,</para>
  <para style="q2" vid="PRO 20:2">mang'us qəl huvuna canıke eyxhe.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Aldapxhıniyke əq'əna qexhena axtı qexhe,</para>
  <para style="q2" vid="PRO 20:3">gırgın beynyavabıme saç'ivkuybışil ulyookka.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Tanbalee ezang'a ezu deş,</para>
  <para style="q2" vid="PRO 20:4">sa'anang'ad avaykı deş.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />İnsanne yik'eedınbı k'orane xhyanbışik akar,</para>
  <para style="q2" vid="PRO 20:5">ək'elikane insanılqame merıng'une yik'eedın hiyxharan.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Geebınbışe manbışilqa yı'q' qizaras eyxheva eyhe,</para>
  <para style="q2" vid="PRO 20:6">ts'omnana insanme nençene aveykes?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Qorkung'vee məttına ı'mı'r haa'a,</para>
  <para style="q2" vid="PRO 20:7">mang'uke g'abıynbı baxtivarar vuxhes.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Mısayiy paççah məhkama ha'asva taxtılqa ılqeç'e,</para>
  <para style="q2" vid="PRO 20:8">mang'usse uleppışika gırgına pisvalla curaa'as vəəxə.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />«Zı yik' məttı'iyn,</para>
  <para style="q2" vid="PRO 20:9">zal nişinacab bınah deşda!»</para>
  <para style="q2" vid="PRO 20:9">Şavusse məxüd eyhes əxəye?<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Horbışikan ulyoopkiyiy gyoopkiy –</para>
  <para style="q2" vid="PRO 20:10">man q'öyudsana Rəbbik'le g'ımece vod.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Uşaxır cune işbışike qıvaats'a.</para>
  <para style="q2" vid="PRO 20:11">Vucee ha'ane işbışe hagvasın, mana məttırayee, qorkurayee.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />G'iyxhen k'ırıbı, g'ecen uleppı –</para>
  <para style="q2" vid="PRO 20:12">mançin q'öyudsana Rəbbee itxhın.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Geer g'alirxhuy ıkkiykınee, kar dena axvas.</para>
  <para style="q2" vid="PRO 20:13">Muğurra ixhee, ats'esınmeen kar oxhanas.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Kar ileşşeng'vee eyhen: «Pisdavud, pisınıd kar!»</para>
  <para style="q2" vid="PRO 20:14">Alişşu, əlyhəəmeeme, vuceecar-vuc hagva.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />K'ınəəğəyiy geed gıranın g'ayebı vod,</para>
  <para style="q2" vid="PRO 20:15">ək'elikan cuvab yuşan ha'an ghalyme çile gıranda vod.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Dyats'ang'us zaaminra ulyorzulyung'un tanalin aleet'e,</para>
  <para style="q2" vid="PRO 20:16">mebınbışil-alla cuvab huvuyng'unud kar aqqe.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Horbışika hı'iyn kar insanısqa ts'etta ittuda qadayle,</para>
  <para style="q2" vid="PRO 20:17">mançile qiyğa ghal k'ak'alıka gyatsts'es.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Cuvabıl k'ırı alixhxheene, vasse yik'eedın ha'as əxəsın.</para>
  <para style="q2" vid="PRO 20:18">Muhaariba vukkekaxhee, yugna mısləhət t'abal hee'e.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Miz ookang'vee dyugulenın cuvab yuşan ha'a.</para>
  <para style="q2" vid="PRO 20:19">Geer yuşan ha'ang'uke hixve.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Şavaayiy dekkıqayiy yediqa bed-düə haa'a,</para>
  <para style="q2" vid="PRO 20:20">mang'un işix k'ətqəsın, mana miç'axiyvaleeqa gixhas.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Q'omançe zarabacab alyapt'ıyne mirasın</para>
  <para style="q2" vid="PRO 20:21">qiyğa xayir heles deş.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />«İnçina qəl zı qığaahasda!» immeyhe.</para>
  <para style="q2" vid="PRO 20:22">Rəbbilqa yı'q' qizre, Mang'vee ğu g'attixhan ha'asda.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Horbışikan terezyugun g'ayebı Rəbbik'le g'ımece vod.</para>
  <para style="q2" vid="PRO 20:23">Horbışikan g'apanıd yugun deş vod.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />İnsanık'le əlyhəəsın ciga hagvana Rəbb vor.</para>
  <para style="q2" vid="PRO 20:24">İnsanık'le vucee avquna yəq' nəxübna vaats'a vuxhes?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Ts'etta Allahıs g'assır,</para>
  <para style="q2" vid="PRO 20:25">qiyğa mançina fıkır opxhanang'vee cuscab gugu giviyxhe.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />K'orane ək'elynane paççahee pisınbı curaa'anbı,</para>
  <para style="q2" vid="PRO 20:26">qiyğab manbı yöxxəyne g'ayeyn xhinne giviyxəranbı.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />İnsanın rı'h Rəbbina bazir vobna,</para>
  <para style="q2" vid="PRO 20:27">mançin yik'en k'oralybı hagva.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Yugvaliniy qopkuvalin paççah havace,</para>
  <para style="q2" vid="PRO 20:28">mang'una taxt yugvalin it'umba avqaaqqa.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Mek'vunbışda guc manbışda uftaniyvalla vob,</para>
  <para style="q2" vid="PRO 20:29">cagvaran ç'ərbı q'əsvalina micagiyvalla vobna.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Cigabı ha'ane ı'xiybışe insanar qaa'anbı,</para>
  <para style="q2" vid="PRO 20:30">getuyn yik'en k'oralybı pisvalike mətta'a.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Paççahın yik' Rəbbine xıle vod,</para>
  <para style="q2" vid="PRO 21:1">Cus nyaqayiy ıkkan mana dama xhinne maqar sak'al ha'ana.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />İnsanna yəq cune ulesqa qopkuba qavayle,</para>
  <para style="q2" vid="PRO 21:2">Rəbbeeme yik'bı gyoodakke.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Rəbb Cus allya'ane q'urbanbışile geer,</para>
  <para style="q2" vid="PRO 21:3">qopkuvalika, kara'əən karbı hı'iyqa ilyakka.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Ooğançe avqa ilyakkane, çincad-yic axtıda ıkkekkane yik'en</para>
  <para style="q2" vid="PRO 21:4">işixıle yugba pisınbışda bınah haagva.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />İş g'avces vukkanna karana eyxhe,</para>
  <para style="q2" vid="PRO 21:5">zaraba-zaraba g'oocename kar dena axva.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Horaka sav'una anbar, iygvalyne booğak akar.</para>
  <para style="q2" vid="PRO 21:6">Məxbınbışe cos hapt'ıy t'abal ha'a.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Pisınbışis qotkuyn ha'as ıkkan deş.</para>
  <para style="q2" vid="PRO 21:7">Manbışe hı'iyne pisde işbışe cokun ha'asın.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Bınahnang'una yəq alivku-givku vooxhe,</para>
  <para style="q2" vid="PRO 21:8">yik' məttıng'una yəqı'b qopkuba vooxhe.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Aldeexhvanne xhunaşşeyka sa xaa axvasse,</para>
  <para style="q2" vid="PRO 21:9">daxayne vuttul axvee yugda eyxhe.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Pisde insanee karaı'dəənçilqa can ayhe,</para>
  <para style="q2" vid="PRO 21:10">mang'us mebınbıb qiviykkan deş.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Matsxar ha'ang'us cazaa huvee, caahilyaaşe mançike dars alyaat'as.</para>
  <para style="q2" vid="PRO 21:11">K'orane ək'elynang'vee darsıke ats'al alyaat'a.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Allah Qorkuna vor. Mana pisınbışde xaaqa ilyakkı,</para>
  <para style="q2" vid="PRO 21:12">manbışilqa ver salat' haa'a.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Şavaayiy kar deşing'une ts'irıke k'ırıbı aqqaqqa,</para>
  <para style="q2" vid="PRO 21:13">sa yiğılib mang'vee mana ts'ir haa'as, mang'una ts'irıb g'avxhes deş.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Dyugulenba huvuyne payın,</para>
  <para style="q2" vid="PRO 21:14">xhıtyxhaleene ruşvatın, qəl avaak'an haa'a.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Qopkuvalla vuxhamee, qorkuna şadexhena,</para>
  <para style="q2" vid="PRO 21:15">pisda iş g'ooceng'ukunud eyxhen.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Vuşuyiy ək'elyne yəqqı'le qığeç'u,</para>
  <para style="q2" vid="PRO 21:16">mang'una ciga gah qidyabıcab hapt'ıynbışde k'ane vuxhes.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Otxhun-ulyodğuy geed ıkkanna kar dena axvas,</para>
  <para style="q2" vid="PRO 21:17">çaxıriy gıranın ətirbı ıkkannar karana ixhes deş.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Qorkung'une cigee pisıng'vee,</para>
  <para style="q2" vid="PRO 21:18">yugung'une cigeeyib xaainee cazaa ts'ıts'aa'as.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Aldeexhvanne, ghal sidya'ane xhunaşşeyka axvasse,</para>
  <para style="q2" vid="PRO 21:19">q'ərane çolee axvee yugda eyxhe.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />K'orane ək'elikang'une xaa geed ıkkanan gıranın karbı vod,</para>
  <para style="q2" vid="PRO 21:20">beynyaveeme cuqa vodun gırgın otxhun g'att'a'an.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Yugunçilqayiy qopkuvalilqa can ayheng'uk'le,</para>
  <para style="q2" vid="PRO 21:21">ı'mı'rıb, qopkuvallab, xəbvallab aveekesda.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Sa k'orane ək'elynang'usse cehilyaaşe gyavts'una şahar avqas vəəxə.</para>
  <para style="q2" vid="PRO 21:22">Manbı it'um hav'uyne şaharee vuxheeyib, məxrıng'usse mana hı'ğəkkar haa'as vəəxə.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ghal aqqaqqang'vee, miz saa'ang'vee</para>
  <para style="q2" vid="PRO 21:23">vuc, culqa vüqqəne verıke havace.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Vuceecar-vuc xərra ıkkekkang'un, ooğançe-avqa ilyakkang'un do «Matsxara Ha'ana» vod.</para>
  <para style="q2" vid="PRO 21:24">Mang'vee vuc haguylette hagvana.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Tanbalne xıleppışis iş haa'as devkanançil-alla,</para>
  <para style="q2" vid="PRO 21:25">mana mıssınçin qek'ana.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Mang'us qiqiylette geed kar ıkkiykan,</para>
  <para style="q2" vid="PRO 21:26">qorkung'veeme qidiykkın kar bit'al ha'a.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Pisde insanee ablyav'uyne q'urbanıle Allah həlyvəyq'ənna.</para>
  <para style="q2" vid="PRO 21:27">Məxrıng'vee q'urban pisde fıkırıka ablyav'uxhee, mana sık'ılbab pisba vob.<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Horalay şahad qik'asda,</para>
  <para style="q2" vid="PRO 21:28">yugda k'ırı alixhxhing'unab şahadiyvalla gırgıne gahbışis vuxhes.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Pisde insanee aq'va it'umda aqqaqqa,</para>
  <para style="q2" vid="PRO 21:29">qorkung'veeme vucee avquyne yəqqı'na fıkır ooxhan.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Nəxbınecab k'orane ək'elisse, fıkrısse,</para>
  <para style="q2" vid="PRO 21:30">Rəbbine ögil ulyoozaras vəəxəs deş.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Balkanar dəv'əyne yiğıs sa'a-qa'a,</para>
  <para style="q2" vid="PRO 21:31">ğamepxhayme Rəbbee hele.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Ulesqa yugra qariy nuk'rayleyiy k'ınəəğəyle yugda vob,</para>
  <para style="q2" vid="PRO 22:1">yugun doyud xənne var-devletıle yugda vod.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Karnanayiy kar deşda sana-sang'uk akar –</para>
  <para style="q2" vid="PRO 22:2">q'öyursanar Rəbbee ipxhın.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Ək'elynang'uk'le dağamiyvalla g'avcu, mançile hexvana,</para>
  <para style="q2" vid="PRO 22:3">caahilyme ögeeqa qığeç'e, mançike uts'ur iveyke.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Vuceecar-vuc xərra ıkdekkang'us, Rəbbile qəyq'ənang'us,</para>
  <para style="q2" vid="PRO 22:4">geed kar, hı'rmat, ı'mı'r hoole.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Quç'opkurne yəqqı'l əlyhəəng'us zazaabıyiy gugubı qızaxxa,</para>
  <para style="q2" vid="PRO 22:5">can havacenar mançile hexvana.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Ts'eppacab uşaxık'le qopkuna yəq haagve,</para>
  <para style="q2" vid="PRO 22:6">q'əsvaleeyir mana mançile sak'alas deş.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Karnana, kar deşing'una xərna vor.</para>
  <para style="q2" vid="PRO 22:7">Şib alyaat'una insanır, şib huvuyng'una həmbal eyxhe.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Qəlasın ha'ang'ulqa ver abayle,</para>
  <para style="q2" vid="PRO 22:8">zulum hooleng'una xəbvallab xılençe g'ooşena.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Cun gıney kar deşing'us qidiykkın helena</para>
  <para style="q2" vid="PRO 22:9">barakatnana ixhes.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Matsxara haa'ana g'e'eşvee, saç'ivkuyid əlyhəəsın,</para>
  <para style="q2" vid="PRO 22:10">aldapxhıniyid, k'ap'ik'ıle avqa qeepxhayid deşxhesın.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Yik' məttına, miz ittuna,</para>
  <para style="q2" vid="PRO 22:11">paççahna hambazxhe eyxhena.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Rəbb geed ats'ang'uqa ilyakkı, mana havacena.</para>
  <para style="q2" vid="PRO 22:12">Xainne cuvabıkeme Mang'vee q'əran kar ha'a.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Tanbalee eyhen: «G'ad şir vod,</para>
  <para style="q2" vid="PRO 22:13">şahreeqa qığeç'vee, mançin zı qodu-sodasda!»<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Merıng'une xhunaşşeyn ghal hapt'asde guguyk akar,</para>
  <para style="q2" vid="PRO 22:14">Rəbbis qəl huvuna mançeeqa gixhas.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Bəç'əriyvalla uşaxne yik'ek atipq'ın vooxhe,</para>
  <para style="q2" vid="PRO 22:15">terbiye helene t'at'aakame mana avaak'an haa'as vooxhena.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Karnana ixhesdemee, kar deşda hoyç'an-g'oyç'annayiy</para>
  <para style="q2" vid="PRO 22:16">karnang'us paybı helena vuççud dena axvas.<verse eid="PRO 22:16" /></para>
  <para style="s">K'orane ək'elynanbışe uvhiynbı</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />K'orane ək'elynanbışe eyhençil yugda k'ırı alixhxhe,</para>
  <para style="q2" vid="PRO 22:17">yik' yizde ats'aalis hele.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Man eyhenbı ğu yik'el aqqee,</para>
  <para style="q2" vid="PRO 22:18">manbı mizel havacee, yugda eyxhe.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Ğu Rəbbilqa umud hee'ecenva,</para>
  <para style="q2" vid="PRO 22:19">g'iyna zı vak'le manbı eyhe.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Zı yiğnemee ats'aliy kar xət qa'an</para>
  <para style="q2" vid="PRO 22:20">xhebts'al (30) uvhiy otk'un.<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Məxüd vas hək'en cuvab xət qixhes,</para>
  <para style="q2" vid="PRO 22:21">ğu zasqa g'axuvuynbışis qotkuyn cuvab qeles əxəs.<verse eid="PRO 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Kar kılydanang'uqa gucub k'ılybava g'ımeşşe,</para>
  <para style="q2" vid="PRO 22:22">kasibna məhkamee k'ümööq'ə.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Rəbb alikkas manbışil-alla,</para>
  <para style="q2" vid="PRO 22:23">manbı hivşuynbı Rəbbee ı'mreke haa'as.<verse eid="PRO 22:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Zaraba qəl avqaaqang'uka hambaz mexhe,</para>
  <para style="q2" vid="PRO 22:24">sabır k'ıldanang'uka yəqqı'lqa qığmeç'e.<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Deşxheene, mang'une yəqqı'n hoharas,</para>
  <para style="q2" vid="PRO 22:25">ğucar-ğu gugeeqa arçes.<verse eid="PRO 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Merıng'une şibıs zaaminna ulyorzuliyke,</para>
  <para style="q2" vid="PRO 22:26">ğucar-ğu aqqe.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Qelesın pıl dexhee,</para>
  <para style="q2" vid="PRO 22:27">vak avudun tyulyu hadğu qıkkees.<verse eid="PRO 22:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Dekkaaşile avxuyne,</para>
  <para style="q2" vid="PRO 22:28">yisseyne sarhadne g'ayeyn ciga badal hıma'a.<verse eid="PRO 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />İş yugba vəəxəna g'eceyee?</para>
  <para style="q2" vid="PRO 22:29">Mang'vee paççahaaşis iş haa'as,</para>
  <para style="q2" vid="PRO 22:29">məxbınecab insanaaşis deş.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Paççahıka sufranıl gyu'urmee,</para>
  <para style="q2" vid="PRO 23:1">ögiylinçika yugra ilekke.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Ğu vuxhnat'ayxhee,</para>
  <para style="q2" vid="PRO 23:2">boğazılqa ç'ika gixhxhe.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Mang'une yugne otxhuniybışin ğu gugeeqa harağva,</para>
  <para style="q2" vid="PRO 23:3">mançil-allab mançilqa ul hımaa'a.<verse eid="PRO 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Xətta kar ha'asva ğucar ğu gimek'a.</para>
  <para style="q2" vid="PRO 23:4">Ək'elika ixhe, mane fıkrele ılğeç'e.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Var-devlet ul gyapxasse deşxhesın,</para>
  <para style="q2" vid="PRO 23:5">q'aacir xhinne, xılibı aaqı, xəybışeeqa alixasın.<verse eid="PRO 23:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Q'ı'rq'ı't'iyn gıney umotxhan,</para>
  <para style="q2" vid="PRO 23:6">mang'une yugne otxhuniybışilqa ul hımaa'a.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Mang'vee yik'ee gırgınçin hı'sab ıkkekka.</para>
  <para style="q2" vid="PRO 23:7">Mang'vee mizeka vak'le «oxhne, ulyoğeva» uvheeyid,</para>
  <para style="q2" vid="PRO 23:7">ək'lee mang'une medıncad kar eyxhe.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Mang'usne opxhunna xüvə ğu halyaa'asda,</para>
  <para style="q2" vid="PRO 23:8">ğu mang'uk'le uvhiyn yugun cuvab hexxada ixhes.<verse eid="PRO 23:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Beynyavayk'le cuvab immeyhe,</para>
  <para style="q2" vid="PRO 23:9">mana yiğne ək'elikane cuvabıqa ooğançe-avqa ilyakkas.<verse eid="PRO 23:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Yisseyne sarhadne g'ayeyn ciga badal hıma'a,</para>
  <para style="q2" vid="PRO 23:10">dek dena avxuynbışin ezuyn ciga g'ımeşşe.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Manbı g'attivxhan Haa'ana geer gucuka vor,</para>
  <para style="q2" vid="PRO 23:11">Mang'vee manbışin sura aqqas, yiğın deş.<verse eid="PRO 23:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Yik'ıs terbiye hele,</para>
  <para style="q2" vid="PRO 23:12">k'ırıd ats'aalilqa aqqe.<verse eid="PRO 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Uşaxıs terbiye heles yik'elixan hıma'a,</para>
  <para style="q2" vid="PRO 23:13">ğu mana t'übəəka getuyke qik'as deş.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Ğu mana t'übəəka getvee,</para>
  <para style="q2" vid="PRO 23:14">qik'uyke g'attixhan ha'as.<verse eid="PRO 23:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Dix, yiğın yik' k'orane ək'elika ixhee,</para>
  <para style="q2" vid="PRO 23:15">yizınıd yik' şadxhesın.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Yiğne mizen qotkuyn cuvab uvhee,</para>
  <para style="q2" vid="PRO 23:16">yizın rı'hcad g'otk'ul-ulyok'alasın.<verse eid="PRO 23:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Yiğna ul bınahnanbışde karal mooxhecen,</para>
  <para style="q2" vid="PRO 23:17">ğu gırgıne gahbışilycar Rəbbile qəyq'ən ixhe.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Valqad yugun yiğbı qalesınbı,</para>
  <para style="q2" vid="PRO 23:18">yiğna umud g'ats'aak'vanas deş.<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Dix, k'ırı alixhxhe, k'orana ək'elikana ixhe,</para>
  <para style="q2" vid="PRO 23:19">yik' qotkune yəqqə aqqe.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Çaxıreqa qek'anbışda,</para>
  <para style="q2" vid="PRO 23:20">çurunuka qoxanbışda mexhe.<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Geed ulyoğanbışiniy geed otxhananbışin kar k'ıl qexhe.</para>
  <para style="q2" vid="PRO 23:21">Manbı otxhun-ulyodğu, peteepxha, qıt'axxıyne tanalinçee axvas.<verse eid="PRO 23:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Vas ı'mı'r huvuyne dekkıl k'ırı alixhxhe,</para>
  <para style="q2" vid="PRO 23:22">yed q'əs qiyxhamee, ooğançe-avqa ilymakka.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Qotkuyn aqqe, man ak'an hıma'a,</para>
  <para style="q2" vid="PRO 23:23">k'orana ək'el, terbiye, vas xət qı'iyn aqqe.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Qorkung'una dek ats'esınmee g'ork'ul-ulyok'alasda,</para>
  <para style="q2" vid="PRO 23:24">k'orane ək'elynang'una dekme şadxhesda.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Havasre dekkiy yed şadeepxhecen,</para>
  <para style="q2" vid="PRO 23:25">ğu uxuna g'ork'ul-ileek'vlecen.<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Dix, zalqa fıkır hevle,</para>
  <para style="q2" vid="PRO 23:26">hasre yiğın uleppı yizde yəqbışika ilekkecen.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Yəqqı'le qığeyç'una zəiyfa k'orana, adamer hööğəna g'uyu vob,</para>
  <para style="q2" vid="PRO 23:27">merıng'una xhunaşşer muğne, qığeç'es dəxəsde kahrızık akar vor.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Məng'ee, g'ulduree xhinne, gugu haa'a,</para>
  <para style="q2" vid="PRO 23:28">məng'ı'l-alla xayaanat ha'anbı geeb qeebaxhe.<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Şavuqayiy derd? Şavulqayiy ver abı?</para>
  <para style="q2" vid="PRO 23:29">Şavuqayiy saç'ivkuy? Şavuqayiy şikayatbı?</para>
  <para style="q2" vid="PRO 23:29">Şavuqayiy dexhesın goşbı? Şavuniy uleppı ç'əra qeedaxhe?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Çaxır ulyoğas gyu'ur-oza qidexhena,</para>
  <para style="q2" vid="PRO 23:30">ark'ın, geedne çaxırbışde dadbışiqa ilyakkana!<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Çaxırne ç'ərəxəlika,</para>
  <para style="q2" vid="PRO 23:31">k'oleene hits'aygharvalika</para>
  <para style="q2" vid="PRO 23:31">mançine micagda k'yatk'ıniyka ilymakka.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Nekke qiyğa man çaxır xoçe xhinne üvxiyxə,</para>
  <para style="q2" vid="PRO 23:32">gyurzayn xhinne zəhər hoole.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Uleppışik'le curayn-curayn karbı g'ece,</para>
  <para style="q2" vid="PRO 23:33">yik'eeqa alikkiyn fıkırbı qadayle.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Vasqa ğu deryahne yı'q'neerın xhinne qales,</para>
  <para style="q2" vid="PRO 23:34">itteyhesğu ğu gamıyne q'oma g'alirxhuyn xhinne ixhes.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Ğu eyhesın: «Zas ı'xı'vud, ık'ar qı'ı deşud,</para>
  <para style="q2" vid="PRO 23:35">zı getuvur, zak'le ats'axhxha deşud.</para>
  <para style="q1" vid="PRO 23:35">Meed ulyoğasdemee mısaniyxan zalqa qales?»<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Pisde insanaaşiqa vodunçilqa ul givmiyxhe,</para>
  <para style="q2" vid="PRO 24:1">manbışika hambaziyvalla hıma'a.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Manbışde yik'eençe zaalımiyvalla ı'lğəə,</para>
  <para style="q2" vid="PRO 24:2">manbışde mizen ver ablyaa'a.<verse eid="PRO 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />K'orana ək'el dena xav alya'as ixhes deş,</para>
  <para style="q2" vid="PRO 24:3">ək'el devxhee, man hiqiy-allançed it'uma'as ixhes deş.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Ats'aalin mane xaan goozyar,</para>
  <para style="q2" vid="PRO 24:4">gırgıne gıranne, yugne karbışika gyatsts'a'as.<verse eid="PRO 24:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />K'orana ək'elikana insan gucuka eyxhe,</para>
  <para style="q2" vid="PRO 24:5">ats'aalikane insanee cuna guc hexxaa'a.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Qopkune mısləhətın dəv'ee vak'le yəq' haagvas,</para>
  <para style="q2" vid="PRO 24:6">yugun mısləhətbı helenbı geebxhee, ğu ğamxhesda.<verse eid="PRO 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Beynyava k'orane ək'elilqa hiyxhar deş,</para>
  <para style="q2" vid="PRO 24:7">iclasee ghal aaqı eyhesın cuvab mang'uqa eyxhe deş.<verse eid="PRO 24:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Yik'eençe pisın kar ı'lğəəng'uk'le</para>
  <para style="q2" vid="PRO 24:8">«yik' aliq'ala'anava» eyhe.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Beynyavayn fıkırbı bınahcab vob,</para>
  <para style="q2" vid="PRO 24:9">matsxara karbı ha'ang'uleb həlyvəyq'ənanbı.<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Dağamne yiğıl rı'hı'le g'a'arxhuxhee,</para>
  <para style="q2" vid="PRO 24:10">vaqa nimeecab k'ınna guciy!<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Gyapt'as quvkekkanbı g'attivxhan hee'e,</para>
  <para style="q2" vid="PRO 24:11">gyapxas quvkekkanbışiler simiyk'al.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Ğu «mançike zas xabar deşdava» uvheene,</para>
  <para style="q2" vid="PRO 24:12">yik'bı Gyoodakkeng'uk'le nya'a man ats'axhxhes dişde?</para>
  <para style="q2" vid="PRO 24:12">Nya'a yiğın can Havaceng'ulqa man hixharas dişde?</para>
  <para style="q2" vid="PRO 24:12">Nya'a Mang'vee gırgıng'us cune işbışil-alla hək' qevles dişde?<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Dix, itv otxhuniy vasqa yugda qöö dişee?</para>
  <para style="q2" vid="PRO 24:13">Man yiğne ghalesqa ittuda qöö dişee?<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Ats'axhxhe, k'orana ək'elib yik'enemee məxüb vob,</para>
  <para style="q2" vid="PRO 24:14">vak'le mana aveykee, vaqa yugun yiğbı ixhes,</para>
  <para style="q2" vid="PRO 24:14">yiğna umudub əəs deş.<verse eid="PRO 24:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Pisıng'vee xhinne qorkung'une cigaysne gugu givmiyxhe,</para>
  <para style="q2" vid="PRO 24:15">mang'un xav q'əra qıma'a.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Qorkuna yighne yəqqeesır qukkyork'ulee, meer oza qixhesda,</para>
  <para style="q2" vid="PRO 24:16">pisıng'ulqame ver ables, mana hı'ğəkkarasda.<verse eid="PRO 24:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Duşman qukkyork'ulyva şadmexhe,</para>
  <para style="q2" vid="PRO 24:17">mana qaçarxılirva yiğın yik' şadmexhecen.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Deşxheene, Rəbbik'le g'acesın, Mang'us man ıkkiykanas deş,</para>
  <para style="q2" vid="PRO 24:18">yiğne duşmanıle Cuna qəl alyapt'asda.<verse eid="PRO 24:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Pisınbışil-alla qəl hımaa'a,</para>
  <para style="q2" vid="PRO 24:19">karaı'dəəng'uqa ilyakkı, ghalen xhyan gimekka.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Pisıng'ulqa yugun yiğbı qales deş,</para>
  <para style="q2" vid="PRO 24:20">karaı'dəəng'un işixıd k'ətqəsın.<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Dix, Rəbbileyiy paççahıle qəq'ne,</para>
  <para style="q2" vid="PRO 24:21">g'elil qeebaxhenbışikar hambaz mexhe.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Manbışilqa ver sayangaba abayle.</para>
  <para style="q2" vid="PRO 24:22">Rəbbeeyiy paççahee manbışis nəxbına cazaayiy hevlesva şavuk'lecad ats'a deş.<verse eid="PRO 24:22" /></para>
  <para style="s">K'orane ək'elynanbışin medın uvhiybı</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />İn uvhiybıd k'orane ək'elynanbışe uvhu:</para>
  <para style="b" vid="PRO 24:23" />
  <para style="q1" vid="PRO 24:23">Məhkamee sang'un sura aqqiy yugda deşin.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Pisıng'uk'le «ğu qorkuna vor» uvhuyng'uk'le</para>
  <para style="q2" vid="PRO 24:24">milletbışecad cuvabbı eyhes, xalq'bışe bed-düəbı ha'as.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Pisıng'us cazaa hoolenbışemee yugun alyaat'asın,</para>
  <para style="q2" vid="PRO 24:25">vuk'lelqa barakat gyooğas.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />İnsanıs qotkuyn cuvab quvuyng'vee,</para>
  <para style="q2" vid="PRO 24:26">itteyhesğu mang'une aq'vays ubba hı'ı.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Ts'eppee g'abna iş ç'əvee'e, çol se'e-qe'e,</para>
  <para style="q2" vid="PRO 24:27">qiyğa xav ale'e.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Merıng'une aq'val horbışika ulymoyzar,</para>
  <para style="q2" vid="PRO 24:28">ghalençe horakan cuvab qığmayhe.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />İmmeyhe: «Zı mang'uk vucee hı'iyn ha'as,</para>
  <para style="q2" vid="PRO 24:29">vucee hı'iyn, cus sak'al ha'as».<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Tanbalne ezane cigabışeençe,</para>
  <para style="q2" vid="PRO 24:30">ine ək'el hivdiyxharang'une t'ımıllığeençe ılğeç'u.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />G'acuyn gırgın surabı zazaanıd alyaat'u,</para>
  <para style="q2" vid="PRO 24:31">mağaanıd aqqı, cabırbıd hı'ğətkırıd.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Mançiqa ilyakkı, zı fıkır opxhun,</para>
  <para style="q2" vid="PRO 24:32">mançike ı'brat alyaat'u:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />ğu sık'ırra qorku mırg he'ee,</para>
  <para style="q2" vid="PRO 24:33">g'el-xıl hotku g'alirxhvee,<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />kasibiyvalla soyğunçiy xhinne,</para>
  <para style="q2" vid="PRO 24:34">kar g'idiyxhıriyvallab valqa g'uldur xhinne k'yophur ables.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">Paççah Sıleymanın medın k'oran uvhiybı</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />İnbıd Sıleymanee uvhiynbı vod. İn uvhiybı Yahudayne paççahne Xizqiyanne insanaaşe sı'ı.<verse eid="PRO 25:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Allahna xəbvalla Cun işbı dyuguli'iy vod,</para>
  <para style="q2" vid="PRO 25:2">paççahaaşina xəbvallab man işbı ats'axhxhay vod.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Xəəna axtıvalla, ç'iyena k'oraalla,</para>
  <para style="q2" vid="PRO 25:3">paççahaaşined yik'eençe ı'lğəənbı ats'axhxhes dexhe.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Nuk'rayke hexxan kar ts'ayika cure'eene,</para>
  <para style="q2" vid="PRO 25:4">mançike it'umun k'ola ixhes.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Məxürur, pisda paççahıke cure'eene,</para>
  <para style="q2" vid="PRO 25:5">mang'una taxt qopkuvalika it'umuvxhesda.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Paççahne ögee ğucar-ğu axtı qıma'a,</para>
  <para style="q2" vid="PRO 25:6">doyukanbışde yı'q'nee ciga uvqumaaqqa.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Hasre mang'vee vak'le eyhecen: «İnyaqa ılqeç'e»,</para>
  <para style="q2" vid="PRO 25:7">doyukanbışde ögee g'eliqqa helesse.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">Vak'le g'acuyne karbışde hək'ee,<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />zaradacad məhkamee xıliynbı hıma'a.</para>
  <para style="q1" vid="PRO 25:8">Deşxheene, merıng'vee qiyğa vas naş qa'as.<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Yiğın merıng'ukan məhkama ı'lğəəxhee,</para>
  <para style="q2" vid="PRO 25:9">merıng'un sir ımaaqa.<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Deşxheene, g'ayxhing'vee vas naş qa'as,</para>
  <para style="q2" vid="PRO 25:10">mançin ğu gırgıne gahbışis hı'rmatıle g'a'arçes.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Cigal uvhiyn cuvab,</para>
  <para style="q2" vid="PRO 25:11">nuk'rayne g'abılyne k'ınəəğəyne eçeeşik akar.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />K'orane ək'elikang'vee aq'val uvhiyne cuvabıl k'ırı iliyxheng'unemee,</para>
  <para style="q2" vid="PRO 25:12">man k'ınəəğəykena tene xhinne vob.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />I'htibarıkana insan vuc g'axuvuyng'unemee</para>
  <para style="q2" vid="PRO 25:13">pırane gahılin mık'an xhyan xhinne vor.</para>
  <para style="q2" vid="PRO 25:13">Mang'vee cune xərıng'un yik' cigeeqa qalya'a.<verse eid="PRO 25:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Vuşuyiy vucee hidevuyne paybışil-alla, huvuyn xhinne xərra yuşan ha'a,</para>
  <para style="q2" vid="PRO 25:14">mana gyoğiy deşde bılıdbışik, mıtsık akar.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Paççahnab fıkır sabırnang'vee badal haa'a,</para>
  <para style="q2" vid="PRO 25:15">ittune mizen bark'ub g'üvəna qaa'a.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />İtv aveykee, man hexxada umoyxhan,</para>
  <para style="q2" vid="PRO 25:16">deşxheene, halya'asda.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Hambazne xaaqa k'ırra hak'ne,</para>
  <para style="q2" vid="PRO 25:17">deşxheene, mana vale orzul, ğu g'ımece qixhes.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Merıng'une məhkamee aq'val horaka ulyorzulyna,</para>
  <para style="q2" vid="PRO 25:18">nizeyk, gılıncık, ek'ne vukuk akar.<verse eid="PRO 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Xaainılqa dağamne yiğıl yı'q' qizzıriy</para>
  <para style="q2" vid="PRO 25:19">qiçiyne siliyka kar otxhuniykiy k'aane g'elika iykıriyk akar.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Yik'ee derdnang'us mə'niy qəpqiy,</para>
  <para style="q2" vid="PRO 25:20">mık'adanang'a ts'eler g'alerçuyk,</para>
  <para style="q2" vid="PRO 25:20">soodalqa sirka k'i'iyk akar.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Duşman mıssıraxhee, oxhanasın hele,</para>
  <para style="q2" vid="PRO 25:21">xhyan ıkkanxhee, ulyoğasın hele.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Məxüd ğu mang'us naş qa'as<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="fq" closed="false">ğu mang'us naş qa'as: </char><char style="ft" closed="false">cühüt'yaaşine mizel ine cigee «ğu mang'une vuk'lelqa gyopxhanna ghadır gyuvxhesva» otk'un vod.</char></note>,</para>
  <para style="q2" vid="PRO 25:22">yiğna yugvallab Rəbbee savaak'al haa'as.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Şimalıle aa'ane mıtsın gyoğiy adayle,</para>
  <para style="q2" vid="PRO 25:23">ing'ulena-şeng'ulena haa'ane mizenıb qəl abayle.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Aldeexhvanne xhunaşşeyka sa xaa axvasse,</para>
  <para style="q2" vid="PRO 25:24">daxayne vuttul axuy çile yugda vod.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Xhyanıka gyorxhanang'us mık'an xhyan nəxüdiy,</para>
  <para style="q2" vid="PRO 25:25">əq'ənane cigeençena yugna gafıb həməxüb vob.<verse eid="PRO 25:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Qorkuna pisıng'vee eyhençilqa qööxhee,</para>
  <para style="q2" vid="PRO 25:26">mana alitq'ılıyn xhyan ı'lqəəne cigayk,</para>
  <para style="q2" vid="PRO 25:26">mı'q'ı'n gyavts'uyne kahrızık akar qexhe.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Hexxada itv otxhuniy yugda deşin xhinne,</para>
  <para style="q2" vid="PRO 25:27">cuna axtıvallacab t'abal hav'iyid yugda deş vod.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Cuna qəl avqas dəəxəna insan,</para>
  <para style="q2" vid="PRO 25:28">cabırbı hı'ğətkırne şaharık akar.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />G'ı'liys yiz, qiyşalne gahısıb gyoğiy idyvaak'an xhinne,</para>
  <para style="q2" vid="PRO 26:1">beynyavaysıb hı'rmat avaak'a deş.<verse eid="PRO 26:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Maççareriy bebeçuler ileedaxvan xhinne,</para>
  <para style="q2" vid="PRO 26:2">hexxan g'arğışıd vak set'as deş, alixı əlyhəəsın.<verse eid="PRO 26:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Balkanıs çümq, əməleysıb g'antarağa avaak'an xhinne,</para>
  <para style="q2" vid="PRO 26:3">beynyavayne yı'q'əsıd həməxüd t'at'aa avaak'a.<verse eid="PRO 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Beynyavaysıd beynyavays sik'ı cuvab qımele.</para>
  <para style="q2" vid="PRO 26:4">Deşxhee, mang'uk akara qixhes.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Beynyavays beynyavays sik'ı cuvab qele.</para>
  <para style="q2" vid="PRO 26:5">Deşxhee, mang'usqa vuc k'orana ək'elynana xhinne qales.<verse eid="PRO 26:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Şavaayiy beynyavayka xabar g'axuvu,</para>
  <para style="q2" vid="PRO 26:6">cun g'elybı g'ats'atk'un, zulum ts'ıts'aa'ang'uk akar.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />K'aang'vee g'el giyxhen xhinne,</para>
  <para style="q2" vid="PRO 26:7">beynyaveeyib misaala həməxüb ts'ıts'aa'a.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Beynyavays hı'rmat gyuvxhiy</para>
  <para style="q2" vid="PRO 26:8">sapandeena g'aye avt'ulıyk akar.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Ulyodğuyng'vee zazaakan bıtağ xıle aqqıyn xhinne,</para>
  <para style="q2" vid="PRO 26:9">beynyaveeyib misaala həməxüb ts'ıts'aa'a.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Vuk ayheng'vee, vukuka nena qariy ı'xı'yxən xhinne,</para>
  <para style="q2" vid="PRO 26:10">həməxürur beynyavayiy ögilqa qarına işilqa alyarat'ana vor.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Hali'iynçilqa siviyk'alna xvaa xhinne,</para>
  <para style="q2" vid="PRO 26:11">beynyaveeyib vucee hav'una beynyavavalla meeb haa'ana.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Cunecar ulesqa vuc k'orana ək'elikana xhinne qööna g'acunane?</para>
  <para style="q2" vid="PRO 26:12">Beynyavalqa mang'ule geeb umud vob.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Tanbalee eyhen: «Yəqqə aslan vod,</para>
  <para style="q2" vid="PRO 26:13">şahrabışee şir ı'ğiykar!»<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Akka çine oxul nəxüdiy iliyk'ar,</para>
  <para style="q2" vid="PRO 26:14">tanbalır həməxür vuc g'alirxhuyne cigee iliyk'ar.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Tanbalee xıl g'abeedınçeeqa k'yoq'u,</para>
  <para style="q2" vid="PRO 26:15">man ghalyaqa ıkkeesse oyzarna.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Tanbalne ulesqa vuc,</para>
  <para style="q2" vid="PRO 26:16">yighne ək'elikan cuvab quvuynbışile ooqana xhinne qöö.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Merıng'une palğatuneeqa ilekkang'vee,</para>
  <para style="q2" vid="PRO 26:17">itteyhesğu şahreena xvaa k'ırıbışike avqaaqqa.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Ts'ayikan, gyabat'an vukbı ayhena bəç'ər nəxüriy,<verse eid="PRO 26:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 26:19" />merıng'us horbı hı'ı, «Zarafatniy hı'ıva» uvhunar həməxür vor.<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Osbı ç'əveedaxhemee, ts'a k'ədəqqən.</para>
  <para style="q2" vid="PRO 26:20">İng'ulena-şeng'ulena haa'ana deşde cigee, saç'ivkuyid ç'əvexhen.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Nəxüdiy osakeyiy ghadırıke ts'a eyxhe,</para>
  <para style="q2" vid="PRO 26:21">sıç'ekvang'ukeb aldatxhuniy vooxhe.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />İng'una-şeng'una haa'ang'un cuvab ittune xüvəyk akar,</para>
  <para style="q2" vid="PRO 26:22">man yik'ene k'oralybışeeqa g'e'exhxha.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />İttuna miznana, pisınçika gyatsts'ıyn yik'nana insan,</para>
  <para style="q2" vid="PRO 26:23">ooğançe nuk'ra qadğuyne g'ı'bı'ne nyuq'vneke hı'iyne g'abık akar.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Duşmanee ittuna miz haa'a,</para>
  <para style="q2" vid="PRO 26:24">yik'eeme bicvalla avqaaqqa.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Mana g'üvənara yuşan ha'axhee, man k'anyaqa qıma'a,</para>
  <para style="q2" vid="PRO 26:25">mang'un yik' kara ı'dəəne karaka gyatsts'ı vod.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Mang'vee g'ımece ıxhay horaka dyugul he'eeyid,</para>
  <para style="q2" vid="PRO 26:26">mang'una qəl milletne ögee aq'valqa qığevç'es.<verse eid="PRO 26:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />G'uyu ilyviyk'arang'usser caqa g'a'ayxhas əxə.</para>
  <para style="q2" vid="PRO 26:27">G'ayeb vuc qavaak'an hav'uyng'ulqa g'a'avxhas vəəxə.<verse eid="PRO 26:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Hor ha'ane mizek'le, şavukuniy vucee ha'a, mana g'ımece eyxhe.</para>
  <para style="q2" vid="PRO 26:28">Miz haa'ang'veeyib ver abaççe.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />G'iyqiyn yiğ k'imaqqa,</para>
  <para style="q2" vid="PRO 27:1">g'iyqa hucooyiy ixhesva vak'le ats'a deş.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Hasre ğu yugnava, ğu deş, mebınbışe eyhecen,</para>
  <para style="q2" vid="PRO 27:2">ğu yugnava yiğne ghalen deş, merıng'vee eyhecen.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />G'ayeb, g'umıb yı'q'ba vob,</para>
  <para style="q2" vid="PRO 27:3">beynyavayke vuxhana qəlme, mançine q'önçulesana yı'q'ba vob.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Qəlnana insan q'ıfrımık akar vor, mana şavussecar aqqas-dissara'as əxə deş.</para>
  <para style="q2" vid="PRO 27:4">Gısganmışexhena mang'ule pisra vor, mang'une ögil şavusse ulyozaras əxəyiy?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Aq'veeqa eyhena,</para>
  <para style="q2" vid="PRO 27:5">yiğın bınahbı vak'le itteyhene hambazıle yugna vor.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Hambazee aq'val uvhiyne cuvabın ık'ar qe'eeyid,</para>
  <para style="q2" vid="PRO 27:6">man duşmanne geedne ubbabışile yugun vodun.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Q'at xhinne qıxhayng'vee itvud k'öq'ən,</para>
  <para style="q2" vid="PRO 27:7">mısıng'usqa qap'ınıd ittuda qadayle.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Xaake əq'əna girxhuna insanır,</para>
  <para style="q2" vid="PRO 27:8">akvaake əq'ənaqa gipxhına şit' xhinne vor.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Ətiriniy zeytunne xhınyaalin micagın eva insanne yik'esqa yugda qöön xhinne,</para>
  <para style="q2" vid="PRO 27:9">hambazna mısləhətıb insanısqa yugba qavayle.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Yiğnar, dekkınar hambaz g'ılymaraççe.</para>
  <para style="q2" vid="PRO 27:10">Dağamiyvaleeqa girxhumee, k'ane hambaz vorxhee,</para>
  <para style="q2" vid="PRO 27:10">çocune xaaqa ı'qqəs gixhas deş.</para>
  <para style="q1" vid="PRO 27:10">K'anena insan əq'ənane xınıyle yugra vor.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Dix, ək'elika ixhe, yizın yik' şade'e.</para>
  <para style="q2" vid="PRO 27:11">Manke zas naş qa'ang'us zasse alidghıniy qeles əxəsın.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Ək'elynang'uk'le dağamiyvalla g'avcu, mançile hexvana,</para>
  <para style="q2" vid="PRO 27:12">caahilyme ögeeqa qığeç'e, mançike uts'ur iveyke.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Dyats'ang'us zaaminra ulyorzulyung'un tanalin aleet'e,</para>
  <para style="q2" vid="PRO 27:13">mebınbışil-alla cuvab huvuyng'unud kar aqqe.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Şavaayiy miç'eeb çakba axtıba ul idyaaqiyng'us salam hoole,</para>
  <para style="q2" vid="PRO 27:14">məxbına salam hokiy xhinne vooxhe.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Aldeexhvanna xhunaşşe,</para>
  <para style="q2" vid="PRO 27:15">gyoğiynane yiğıl ç'əvcab dyooxhene gyobatstsene gyoğiyne t'yank'ık akar.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Mana mıts xhinne ulyoozar haa'as vooxhe deş,</para>
  <para style="q2" vid="PRO 27:16">zeytunun q'ış xhinne xuda aqqas eyxhe deş.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Yivan yiva ek' ha'an xhinne,</para>
  <para style="q2" vid="PRO 27:17">həməxübıb insanee insanna ək'el ek' haa'a.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />İnciliys g'ullux ha'ang'vee, inciliyxhee ooxhanna,</para>
  <para style="q2" vid="PRO 27:18">cune xərıng'us yugba g'ullux haa'anar, hı'rmatnana ixhes.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Xhinee aq'va g'ecen xhinne,</para>
  <para style="q2" vid="PRO 27:19">insanne yik'ınır vuc həməxür hagva.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Ahalıy nyaq'vbı gidyayts'en xhinne,</para>
  <para style="q2" vid="PRO 27:20">həməxübıb insanna ul idyaats'e.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />K'ınəəğəynayiy nuk'rayna yugvalla ts'ayika vaats'a vooxhe,</para>
  <para style="q2" vid="PRO 27:21">insanır, mang'une hək'ee yugda yuşan haa'amee, ats'a eyxhe.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Suk t'at'aaka gyootee, kapak qığeç'es,</para>
  <para style="q2" vid="PRO 27:22">beynyavame nimee getvee, mang'una beynyavavalla qığevç'es deş.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23-24" style="v" sid="PRO 27:23-24" />Kar gırgıne gahıs deş vod,</para>
  <para style="q2" vid="PRO 27:23-24">tacıd nasılıle-nasılıqa ılğeç'e deş,</para>
  <para style="q1" vid="PRO 27:23-24">mançil-alla syurunuqa yugra ilekke,</para>
  <para style="q2" vid="PRO 27:23-24">çavrad uleke g'ımekka.<verse eid="PRO 27:23-24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Ok' sav'u quvkiyle qiyğa, medın ok'bı alyadıyng'a,</para>
  <para style="q2" vid="PRO 27:25">suvabışee ok'bı qiyşalang'a,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />yiğne urgbışe tanalqan kar heles,</para>
  <para style="q2" vid="PRO 27:26">q'ınabıd massa huvu, çol vasse alişşes əxə.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Vaqa ts'e'bışda nyak geeb vuxhes,</para>
  <para style="q2" vid="PRO 27:27">vasda, yiğne xizanısda, yiğne həmbalaaşisda.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Pisda insan hexvana, mang'uqa qihna gexhana dexheeyir,</para>
  <para style="q2" vid="PRO 28:1">qorkuname, aslan xhinne yik'eka eyxhe.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Ölka g'elil quvxhamee, vuk'lek vukkekkanbı geeb qeebaxhe.</para>
  <para style="q2" vid="PRO 28:2">K'orana ək'elikana, iş vaats'ana insan ixhee, ölka geeb gahna it'umba avqas.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Kar deşing'vee, mebın kasibar hooç'an-g'ooç'anxhee,</para>
  <para style="q2" vid="PRO 28:3">man ezuyn ıkkekkane gyoğiyk akar.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Xət qı'iyn yik'el hixan ha'anbışe, pisda axtı qa'a.</para>
  <para style="q2" vid="PRO 28:4">Xət qı'iyn ha'anbıme, mang'une ögiyl ulyoozar.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Pisınbışilqa qopkuvalla nəxdın kar ıxhay hiyxhar deş,</para>
  <para style="q2" vid="PRO 28:5">Rəbb t'abal ha'anbışilqa gırgın hiyxharan.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Məttına ı'mı'r haa'ana kar deşda,</para>
  <para style="q2" vid="PRO 28:6">quç'opkurne yəqbışika ı'ğiykarne karnang'ule yugra vor.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Ək'elikane dixee xət qı'iyn ha'an,</para>
  <para style="q2" vid="PRO 28:7">vuxhnat'ayka hambaziyvalla haa'ang'vee, dekkıs naş qa'an.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Xənne faizıka cus kar sa'ang'un kar,</para>
  <para style="q2" vid="PRO 28:8">inekke qiyğa kar deşinbışika yugra eyxheng'us hixharas.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Xət qa'an g'idiyxhesdemee k'ırıbı aqqaqqang'un düəbıd</para>
  <para style="q2" vid="PRO 28:9">Allahnemee həlyvəq'ənasınbı vod.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Qopkuynbı quç'opkurne yəqqı'lqa ts'ıts'aa'ana vucee alipk'ırne g'uyeeqa g'a'ayxhas.</para>
  <para style="q2" vid="PRO 28:10">Məttıne yik'nanbışis yugun karbı axvas.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Karnang'uk'le vuc k'orana ək'elynana xhinne ats'a,</para>
  <para style="q2" vid="PRO 28:11">kar deşde k'orane ək'elynang'uk'leme mana ul üvxümeecar ats'a eyxhena.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Qopkuynbı ğameepxhamee, gırgınbı şadeebaxhenbı.</para>
  <para style="q2" vid="PRO 28:12">Pisınbı ç'ak'ınbı vuxhamee, insanar dyuguleebaxhenbı.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Bınahbı dyugulya'ang'uqa barakat vuxhes deş.</para>
  <para style="q2" vid="PRO 28:13">Bınahbı gardanaqa alyaat'u, manbı g'aletçiyng'us rəhı'm haa'as.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Gırgıne gahbışilycar qopkune yəqqı'le qıtteç'es qəyq'ənna baxtivar vorna,</para>
  <para style="q2" vid="PRO 28:14">hı't'ilqame ver abayle.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Kar deşde milletna pisda xərna,</para>
  <para style="q2" vid="PRO 28:15">hooghane aslanık, mıssıne syoyuk akar.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Ək'el deşde xərıng'vee geeb hooç'an-g'ooç'an,</para>
  <para style="q2" vid="PRO 28:16">haramın kar dekkanang'una ı'mı'r xıliy qooxhe.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Eb k'yoohar haa'ana, nyuq'vneeqa hixharasmee, g'adaxhvanasda.</para>
  <para style="q2" vid="PRO 28:17">Hasre şavaacad mang'us kumag hıma'acen.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Qorkune yəqqı'n hoyharna g'attixhanasda,</para>
  <para style="q2" vid="PRO 28:18">quç'opkurna yəq əlyhəəname sayangara qukk'yok'alasda.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Cun ciga ezu-qiyşalng'vee ats'esınmeen gıney oxhanas,</para>
  <para style="q2" vid="PRO 28:19">q'ərane karbışde qihna girxhuname, vuççud dena axvas.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Yı'q' qizaras eyxhene insanıqa barakat geeb vuxhes,</para>
  <para style="q2" vid="PRO 28:20">zaara karana ixhes ıkkanname, cazaa dena axvas deş.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Sang'un sura aqqiy yugda deşin,</para>
  <para style="q2" vid="PRO 28:21">sabaranbışeme sa xüvə gıneynemeeyib bınah haa'ana.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Q'ı'rq'ı't'iy karana ixhesva g'adayxhvan,</para>
  <para style="q2" vid="PRO 28:22">mang'uk'le culqa kar deşiyvalla qöö vuxhay ats'a deş.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Şavaayiy merıng'une aq'veeqa cuvab eyhe,</para>
  <para style="q2" vid="PRO 28:23">mana, ittune mizeka hor ha'ang'ule yugra g'aces.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Dekkiy-yed q'əra qav'u, «man bınah deşva» eyhena</para>
  <para style="q2" vid="PRO 28:24">g'ulduraaşina hambaz vor.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Mıssıne ulen uğoodıybı ha'a,</para>
  <para style="q2" vid="PRO 28:25">Rəbbilqa umud haa'ana gyatsts'ı-gixhxhıne cigeeqa gexha.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Culqacab umud haa'ana beynyava vor,</para>
  <para style="q2" vid="PRO 28:26">k'orane ək'elika ı'ğı'ykarname g'ittiyxhanna.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Kar deşing'us xıl avquna, mısacar kar dena axvas deş,</para>
  <para style="q2" vid="PRO 28:27">məxbınbışilqa ul gyapxıyng'veeme geeb bed-düə alyapt'as.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Pisınbı ç'ak'ınbı vuxhamee, insanar dyuguleebaxhenbı.</para>
  <para style="q2" vid="PRO 28:28">Manbı habat'ang'a, qopkuynbı geeb qeebaxhe.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Aq'veeqa uvhiyne cuvabıke vuşuyiy hı't'iy qexhe,</para>
  <para style="q2" vid="PRO 29:1">məxrına sayangara haq'varasda, mısacarır yug qixhes deş.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Qopkuynbı geeb qeebaxhemee, millet şadexhen,</para>
  <para style="q2" vid="PRO 29:2">pisda xərna qarımeeme, millet heghan.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />K'orana ək'el vukkanang'vee dek şada'a,</para>
  <para style="q2" vid="PRO 29:3">yəqqı'le qığeepç'iyne zəiyfabışika hambaziyvalla haa'ana vuççud dena axvas.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Paççahee ölka qopkuvalika it'umaa'a,</para>
  <para style="q2" vid="PRO 29:4">geed ruşvat alyaat'ang'veeme ölka q'əra qaa'a.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Şavaayiy merıng'us ittune mizeka hor ha'a,</para>
  <para style="q2" vid="PRO 29:5">mang'une g'elybışeeqa tor ayhe.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Pisıng'una bınah cusdacab gugu vobna,</para>
  <para style="q2" vid="PRO 29:6">qorkung'vee şadvalin ts'ir haa'a.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Qorkuna məhkamee kar deşing'une sural ulyoyzar,</para>
  <para style="q2" vid="PRO 29:7">pisıng'ulqa man hiyxhar deş.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Matsxarabışe şahar alivku-givkaa'ana,</para>
  <para style="q2" vid="PRO 29:8">k'orane ək'elynanbışeme qəl avaak'an haa'a.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />K'orane ək'elynang'vee beynyava məhkameeqa huvee,</para>
  <para style="q2" vid="PRO 29:9">beynyaveeme qəlın mana demalqa gixhxhes, ghal sa'as deş.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Eb k'yaa'ang'uk'le məttın yik'nanbı g'umooce vooxhe,</para>
  <para style="q2" vid="PRO 29:10">mang'us qopkuynbıb gyapt'as vukkiykan.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Beynyavayn qəlın nen-qadiy ha'an,</para>
  <para style="q2" vid="PRO 29:11">k'orane ək'elynang'veeme, vuceecar-vuc aqqaqqana.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Xərıng'vee horal k'ırı iliyxhexhee,</para>
  <para style="q2" vid="PRO 29:12">mang'un gırgın insanar pisınbı vuxhes.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Kar deşdayiy mebınbı hooç'an-g'ooç'anna sa karee akar –</para>
  <para style="q2" vid="PRO 29:13">Rəbbee q'öng'unesana ules işix huvu.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Paççahee kar deşinbışis qotkuyn məhkama huveene,</para>
  <para style="q2" vid="PRO 29:14">mang'una taxt gırgıne gahbışil it'umba vuxhes.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Çümqı'niy aq'veeqa uvhiyne cuvabın k'orana ək'el hoole,</para>
  <para style="q2" vid="PRO 29:15">yik'es ıkkanan ha'as hassırne uşaxee yed k'ap'ik'ıle avqa qee'es.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Pisınbı geeb qeepxhamee, bınahbıd geed qeedaxhe,</para>
  <para style="q2" vid="PRO 29:16">qopkuynbışik'leme manbışin hapt'ıy g'acesın.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Dixes terbiye hele, vas vaxxariyda ixhecen,</para>
  <para style="q2" vid="PRO 29:17">mançin yiğın yik' şada'as.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Xəənçen cuvab deşdang'a, millet yəqqı'le qığeç'en.</para>
  <para style="q2" vid="PRO 29:18">Q'aanunul k'ırı iliyxhena nimee baxtivariy!<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Həmbalıs saccu cuvabıka terbiye heles eyxhe deş,</para>
  <para style="q2" vid="PRO 29:19">mang'ulqa man hitxhıreeyid, k'ırı alixhxhes deş.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Ghalyaqa qadıyn eyhena insan vak'le g'acunane?</para>
  <para style="q2" vid="PRO 29:20">Beynyavalqa mang'ule geeb umud vob.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />K'ırranançile otçu həmbalıs ıkkanan-ıkkanan huveene,</para>
  <para style="q2" vid="PRO 29:21">qiyğa man yugdacad ixhes deş.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Qəlnang'vee saç'ivkuy adaççe,</para>
  <para style="q2" vid="PRO 29:22">zara qoyxharang'veeyib geeb bınah haa'a.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Vuceecar-vuc xərra ıkkiyn avqana qa'a,</para>
  <para style="q2" vid="PRO 29:23">vuk'ul avqa avquynme hı'rmatnana ha'a.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Sixnariyka sarçuna cunacar duşman vorna,</para>
  <para style="q2" vid="PRO 29:24">məhkamee k'ın g'aysıreeyid, qotkuyn eyhe deş.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />İnsanaaşile qəyq'ənang'vee cusdacab gugu haa'a,</para>
  <para style="q2" vid="PRO 29:25">Rəbbilqa yı'q' qizzırname xıl hidiyxharne suvaylin xhinne ixhes.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Geebınbışis paççahısqa gyapk'as vukkiykan,</para>
  <para style="q2" vid="PRO 29:26">qotkuyn məhkamame insanık'le saccu Rəbbisnee iveeke.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Qopkuynbı quç'opkurne yəqqı'nbışile həlyvəəq'ən,</para>
  <para style="q2" vid="PRO 29:27">pisınbıb – qopkuyne yəqqı'nbışile.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">Agurun uvhiybı</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Yaqeyna dix eyxhene Aguree xət qı'iynbı hixhar ha'a. İne insanee uvhuyn:</para>
  <para style="q1" vid="PRO 30:1">«Allah, zı orzulyna, zı k'yart'una.<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Zı insanaaşina inekke ək'el deşda vor,</para>
  <para style="q2" vid="PRO 30:2">zaqa insanna ək'el deşda.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />K'orana ək'el deş zas xəp quvxha,</para>
  <para style="q2" vid="PRO 30:3">Muq'addasne Allahıkeb zas xabar deşda.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Vuşune xəəqə ılqeç'u-giç'u?</para>
  <para style="q2" vid="PRO 30:4">Şavaane mıts xhaxheeqa sav'u?</para>
  <para style="q1" vid="PRO 30:4">Şavaane deryah p'laşil alipk'ır?</para>
  <para style="q2" vid="PRO 30:4">Şavaane ç'iyeyn aq'va ç'əvexhen sarhadbı gixhxhı?</para>
  <para style="q1" vid="PRO 30:4">Mang'un do hucoona? Mang'une dixen do hucoona?</para>
  <para style="q2" vid="PRO 30:4">Vak'le ats'axhee, zak'le eyhe.<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Allahee eyhen gırgın kar məttın k'ınəəğə vodun,</para>
  <para style="q2" vid="PRO 30:5">Culqa yı'q' qizzıriynbışda Mana suva vobna.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Mang'une cuvabıs vuççud hexxı hıma'a.</para>
  <para style="q2" vid="PRO 30:6">Deşxheene, Mang'vee yiğna bınah haagvasda,</para>
  <para style="q2" vid="PRO 30:6">horud aq'valqa qığahasın.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Allah, Vake q'ölle kar heqqa,</para>
  <para style="q2" vid="PRO 30:7">zı qik'asmee, zake manbı qımiykkan:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />q'əraniy horan karbı zake əq'əna qe'e,</para>
  <para style="q2" vid="PRO 30:8">zı kar deşdayiy geer karnana hıma'a.</para>
  <para style="q2" vid="PRO 30:8">Zas zalqa gexhan yiğısiysın gıney hele.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Kar geed ixhee, zı Valqa yı'q' sak'al hı'ı, „Rəbb vuşuneva?“ eyhes.</para>
  <para style="q2" vid="PRO 30:9">Kar deşda ixhee, zı kar qöqü, yizde Allahın do qəla qa'as.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Həmbalne hək'ee mang'une iyesiysne pisın cuvab immeyhe.</para>
  <para style="q2" vid="PRO 30:10">Deşxhee, həmbalee vas g'arğış ha'as, bınahıb val aaxvas.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Məxbınbı vobunbı dekkıs g'arğış ha'a,</para>
  <para style="q2" vid="PRO 30:11">yedis xayir-düə haa'a deş.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Məxbınbı vobunbı cocab-co cone ulesqa məttıba qöö,</para>
  <para style="q2" vid="PRO 30:12">come mı'q'ı'ke mətteepxha vooxhe deş.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Məxbınbı vobunbı ooğançe avqa ilyaaka,</para>
  <para style="q2" vid="PRO 30:13">cocab-co ç'ak'ıba haagvasdemee, uleppı ooqa qa'a.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Məxbınbı vobunbı silibı gılıncık akar,</para>
  <para style="q2" vid="PRO 30:14">itteyhesğu ghale ç'ikabı gitk'ın,</para>
  <para style="q1" vid="PRO 30:14">ç'iyene aq'valin kar deşinbı k'ööğə,</para>
  <para style="q2" vid="PRO 30:14">insanaaşine yı'q'neene fağıraaşikın ha'a.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Zeleyqa q'öyre yiş vor,</para>
  <para style="q2" vid="PRO 30:15">ts'erriyng'un do „Zas-hele“,</para>
  <para style="q2" vid="PRO 30:15">q'ör'esıng'ı'nıd do „Zas-heleva“ vod.</para>
  <para style="q1" vid="PRO 30:15">Xhebılle kar vodun, mısacad ayts'e deş,</para>
  <para style="q2" vid="PRO 30:15">yoq'ullevad eyhes eyxhe,</para>
  <para style="q2" vid="PRO 30:15">mançin „ç'əvva“ eyhe deş:<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />ahalıy, vuxhne eexvas deyxiy,</para>
  <para style="q2" vid="PRO 30:16">xhineka idyayts'en ç'iye, „ç'əvva“ itteyhen ts'a.<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Dek demalqa giyxheng'un mayit</para>
  <para style="q2" vid="PRO 30:17">q'aaciraaşe oxhanas.</para>
  <para style="q1" vid="PRO 30:17">Yedine terbiyeyqa ooğançe avqa ilyaakana ul</para>
  <para style="q2" vid="PRO 30:17">derabışeene qənaaşe alqaahas.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Yizde ək'len g'ıts'dyayk'vanan xhebılle kar vod,</para>
  <para style="q2" vid="PRO 30:18">zalqa hidiyxharanıd yoq'ulle kar vodva eyhes eyxhe:<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />xəəb q'aacirna yəq, ganzıl xoçeyna yəq,</para>
  <para style="q2" vid="PRO 30:19">deryahee gamıyna yəq, gadeyna içiyne yik'eeqana yəq.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Yəqqı'le qığeyç'uyne xhunaşşeyna yəq inəxüb vob:</para>
  <para style="q2" vid="PRO 30:20">otxhun, ghal məttı'ı, eyhen: „Zı pisın vuççud hı'ı deş“.<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Xhebne karak avud ç'iye ı'ğiykar,</para>
  <para style="q2" vid="PRO 30:21">yoq'ullevad eyhes eyxhe, mançis öödəxə deş:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />həmbalıke paççah ıxhay,</para>
  <para style="q2" vid="PRO 30:22">beynyavee ats'esınmeen gıney otxhuniy,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />deykanna zəiyfa hey'iy,</para>
  <para style="q2" vid="PRO 30:23">həmbal zəiyfayn iyesiy zəiyfayne cigeeqa ılğeyç'uy.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Ç'iyeyne aq'val yoq'uble həyvan vob,</para>
  <para style="q2" vid="PRO 30:24">xuruda ixheeyid, mançiqa ək'el geeb vob:<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />nətsxürer gucuka dexheeyid,</para>
  <para style="q2" vid="PRO 30:25">çisın otxhuniy mançin g'ı'lı'na sa'a;<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />damanbıva<note caller="+" style="f"><char style="fr" closed="false">30:26 </char><char style="fq" closed="false">damanbı: </char><char style="ft" closed="false">manbı İzrail eyxhen ok' ooxhanan həyvanar vodunbı. Manbı pırsıq'aaşik akar.</char></note> eyhen həyvanar geed gucuka dexheeyid,</para>
  <para style="q2" vid="PRO 30:26">xaybı ganzbışde yı'q'nee alya'a;<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />ts'irtyaaşiqa paççah dexheeyir,</para>
  <para style="q2" vid="PRO 30:27">manbı ı'ğiykarmee, gırgınbı sacigee g'oşun xhinne ı'ğiykar;<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />bənük' xıleka aqqas ıxheeyid,</para>
  <para style="q2" vid="PRO 30:28">man paççahaaşine xan-saraybışilqa ı'lqəə.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Xheyible həyvan vob,</para>
  <para style="q2" vid="PRO 30:29">yoq'ublevad eyhes eyxhe,</para>
  <para style="q1" vid="PRO 30:29">mançin iykıriy micagda vod,</para>
  <para style="q2" vid="PRO 30:29">g'el g'aççuyid uftanda vod:<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />həyvanaaşina inekke gucnana,</para>
  <para style="q2" vid="PRO 30:30">nişinecab ögil çina yəq badal hidya'an şir vod,<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />q'ına, vuk'ul axtıba avquna dadal,</para>
  <para style="q2" vid="PRO 30:31">g'oşunne vuk'lel ulyorzulyna paççah.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32-33" style="v" sid="PRO 30:32-33" />Nyak geeb ı'ğviykar hav'iyng'a, xhınyaal qı'ğəən xhinne,</para>
  <para style="q2" vid="PRO 30:32-33">quşes ı'xiyng'a, eb qı'ğəən xhinne,</para>
  <para style="q2" vid="PRO 30:32-33">qəl geeb quvxhayng'ab, aldatxhuniy qı'ğəə.</para>
  <para style="q1" vid="PRO 30:32-33">Mançil-allar ğucar-ğu xərra hagvasva, beynyavavalla hav'uxhee,</para>
  <para style="q2" vid="PRO 30:32-33">fıkreençe pisın karbı ı'lğəəxhee, ghal xıleka aqqe».<verse eid="PRO 30:32-33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">Paççahıs huviyn mısləhətbı</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Lemuel donane paççahee uvhiynbı. Yedee mang'us xət qı'iynbı:<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />«Ay yizda dix,</para>
  <para style="q2" vid="PRO 31:2">zı uxuna dix, düəbışika heqqına dix!<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Yiğna guc, yiğna ı'mı'r zəiyfabışis humoole.</para>
  <para style="q2" vid="PRO 31:3">Manbışe paççahaaşikın ha'a.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Lemuel, çaxır ulyodğuy paççahaaşik avaak'ı deş,</para>
  <para style="q2" vid="PRO 31:4">p'iyan haa'an ulyodğuy ıkkiykıniy</para>
  <para style="q2" vid="PRO 31:4">vuk'lek vukkekkanbışik avaak'ı deş.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Deşxheene, ulyodğumee q'aanun yik'el hivxan haa'a,</para>
  <para style="q2" vid="PRO 31:5">kar deşinbı qotkuyn məhkama dena g'alyaa'a.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />P'iyan haa'an ulyodğuy qek'ang'us,</para>
  <para style="q2" vid="PRO 31:6">çaxırıd ver abıyng'us hele.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Hasre ulyodğu, kar deşiyvalla yik'el hivxan hee'ecen,</para>
  <para style="q2" vid="PRO 31:7">culqa abına ver sayıb yik'el qavaalymaa'acen.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Miz deşing'ul-alla ghal eeqe,</para>
  <para style="q2" vid="PRO 31:8">məhkameeyid guc deşinbışin sura aqqe.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Məhkamee ghal eeqe, qotkuyn eyhe,</para>
  <para style="q2" vid="PRO 31:9">kar deşinbışin, fağıraaşin sura aqqe».<verse eid="PRO 31:9" /></para>
  <para style="s">Yugna xhunaşşe<note caller="+" style="f"><char style="fr" closed="false">31:10-31 </char><char style="ft" closed="false">İn ayatbı akrostix xhinne otk'un: manbı cühüt'yaaşine alifbaane çiçiqad qihna qööne hərfbışika giyğal.</char></note></para>
  <para style="qa">Alef</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Şavuk'leyiy yugna xhunaşşe aveykı,</para>
  <para style="q2" vid="PRO 31:10">mana gıranne g'ayebışile gıranna vor.<verse eid="PRO 31:10" /></para>
  <para style="qa">Bet</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Adamee məng'ı'lqa yı'q' qiyzar,</para>
  <para style="q2" vid="PRO 31:11">mana məng'ı'ka g'azanc dena axvas deş.<verse eid="PRO 31:11" /></para>
  <para style="qa">Gimel</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Məng'ee adamiys ı'mı'rvolle pisın deş,</para>
  <para style="q2" vid="PRO 31:12">yugun ha'as.<verse eid="PRO 31:12" /></para>
  <para style="qa">Dalet</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Xhayiy katan məng'ee cesqa alyaat'u,</para>
  <para style="q2" vid="PRO 31:13">iş cene xıleka, şadba haa'a.<verse eid="PRO 31:13" /></para>
  <para style="qa">He</para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Kar alişşu-massa helene gamibışik akar,</para>
  <para style="q2" vid="PRO 31:14">cesın oxhanasın kar əq'ənançe adayle.<verse eid="PRO 31:14" /></para>
  <para style="qa">Vav</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Miç'axdanang'acar mana muğur qeexhe,</para>
  <para style="q2" vid="PRO 31:15">xizanısın oxhanasın otxhuniy ha'a,</para>
  <para style="q2" vid="PRO 31:15">həmbal zəiyfabışisıb iş bit'al ha'a.<verse eid="PRO 31:15" /></para>
  <para style="qa">Zayin</para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Çoluqa ilyakkiyle qiyğa ileşşe.</para>
  <para style="q2" vid="PRO 31:16">Məng'ee cene xılene əq'übayka hı'iyne pılıka, t'ımılen bağ adaççe.<verse eid="PRO 31:16" /></para>
  <para style="qa">Xet</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Mana işile qı'yeeq'ən deş,</para>
  <para style="q2" vid="PRO 31:17">məng'ı'ne xılena guc cene gırgıne işbışis g'iviyxharna.<verse eid="PRO 31:17" /></para>
  <para style="qa">Tet</para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Məng'ı'k'le cen kar alişşu-massa huviy yugda əəva g'ecen.</para>
  <para style="q2" vid="PRO 31:18">Xəmdeb məng'ı'na bazir k'əbəqqə deş.<verse eid="PRO 31:18" /></para>
  <para style="qa">Yod</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Məng'ee xhayıke uxara haa'a,</para>
  <para style="q2" vid="PRO 31:19">qiyğad tanalinbı ha'a.<note caller="+" style="f"><char style="fr" closed="false">31:19 </char><char style="ft" closed="false">Cühüt'yaaşine mizel inəxüdud otk'un vod: «Məng'ee cehra alivk'ar haa'a-haa'a, t'ıbıç' aqqı, uxara haa'a». </char></note><verse eid="PRO 31:19" /></para>
  <para style="qa">Kaf</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Kar deşing'unemee məng'ee xıl aaqa,</para>
  <para style="q2" vid="PRO 31:20">fağıraaşis xıl avqaaqqa.<verse eid="PRO 31:20" /></para>
  <para style="qa">Lamed</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Yiz gyoğang'ad, mana cune xizannemee qiyeeq'ən deş,</para>
  <para style="q2" vid="PRO 31:21">məng'ı'ne xizanne gırgınbışe g'ümən kar ali'ı.<verse eid="PRO 31:21" /></para>
  <para style="qa">Mem</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Yic g'ıleexhane tyuliys aq'vabı iyxhva,</para>
  <para style="q2" vid="PRO 31:22">məng'ee yicee micagın, gıranın kar alya'a.<verse eid="PRO 31:22" /></para>
  <para style="qa">Nun</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Adamiy məng'ı'na şaharne akkabışisnee yugra ats'a,</para>
  <para style="q2" vid="PRO 31:23">milletne ağsaqqalaaşika gyu'ur-oza qexhe.<verse eid="PRO 31:23" /></para>
  <para style="qa">Samex</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Məng'ee yicee iyxhuyn katanıken tanalinbı,</para>
  <para style="q2" vid="PRO 31:24">ts'irabı menne milletbışis massa hele.<verse eid="PRO 31:24" /></para>
  <para style="qa">Əyin</para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Mana gucuka, micagra vor,</para>
  <para style="q2" vid="PRO 31:25">ögiyle qööne ı'mreqar şadra ileeka.<verse eid="PRO 31:25" /></para>
  <para style="qa">Pe</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Mana k'orane ək'elika yuşan hee'e,</para>
  <para style="q2" vid="PRO 31:26">məng'ı'qa yugna mı'sləhət vob.<verse eid="PRO 31:26" /></para>
  <para style="qa">Tsade</para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Xizanne işbışiqa mana ileeka,</para>
  <para style="q2" vid="PRO 31:27">məng'ee mısacab tanbalıyvalla haa'a deş.<verse eid="PRO 31:27" /></para>
  <para style="qa">Qof</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Uşaxar oza qeepxha, məng'ı'k'le baxtivarva eyhe,</para>
  <para style="q2" vid="PRO 31:28">adameeyir mana axtı qee'e:<verse eid="PRO 31:28" /></para>
  <para style="qa">Reş</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />«Yugun zəiyfabı geeb vob,</para>
  <para style="q2" vid="PRO 31:29">vaka sa ayqasdame deşda».<verse eid="PRO 31:29" /></para>
  <para style="qa">Şin</para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Zəiyfayna uftaniyvalla horbışikan kar vod,</para>
  <para style="q2" vid="PRO 31:30">micagiyvallab geeb deş aaxvas,</para>
  <para style="q1" vid="PRO 31:30">Rəbbile qiyeeq'ənna zəiyfar axtı qee'es.<verse eid="PRO 31:30" /></para>
  <para style="qa">Tav</para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Məng'ı's gyooxhana hək' qevle,</para>
  <para style="q2" vid="PRO 31:31">hasre məng'ı'n işbıd şaharne akkabışisnee axtı qe'ecen.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>