  <para style="mt">Hosea</para>
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 11:1" />Ana Yawe yegl dugwa, Israel yoba gak kebra ta moglmere yegl meglko, na dena muduna teiga. Dena muduna tedre, na wana dumo Isip kide kodidre, unabedi agle die dugwa.<verse eid="HOS 11:1" /></para>
  <chapter eid="HOS 11" />
