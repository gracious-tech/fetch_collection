  <para style="toc1">Maika</para>
  <para style="mt">Maika</para>
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="p">
    <verse number="2" style="v" sid="MIC 5:2" />Yawe yegl dugwa, Dumo Betlehem we dimara, distrik Efrata mina, yagl Juda gawama meglmara suna yogwa i, dumo kebra kaima yogwa. Kebra kaima yogwa ba dumo i mina Yagl Kade ta unan, na kagna mina Israel yoba sugl morabuka. Yagl Kade ta unabuka i, ye okna kaima ibo moglkwa okuo dumo i unabiwe dugwa.<verse eid="MIC 5:2" /></para>
  <chapter eid="MIC 5" />
</usx>