<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CH" style="id" />
  <para style="h">Ka Denbi, Buk 2</para>
  <para style="toc2">Ka Denbi, Buk 2</para>
  <para style="toc1">Ka Denbi, Buk 2</para>
  <para style="mt">Ka Denbi, Buk 2</para>
  <chapter number="2" style="c" sid="2CH 2" />
  <para style="s">Solomon Yawe yugumo kei tenagledi prukwa <figure style="fig" alt="Solomon's Temple" file="Map_Solomon's Temple_Kuman.jpg" size="span" copy="ESV Crossway" ref="2.0" /></para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1" />Ana Solomon ere mogl, ye nomane mina yegl di prukwa, Na yugu ta yoba Yawe kamage ere tedre, tawa tenaiglmara kedre, te na king yugu wakai ta kipanagledi ama kenagle di, yegl di prukwa.<verse eid="2CH 2:1" /></para>
  <chapter eid="2CH 2" />
  <chapter number="5" style="c" sid="2CH 5" />
  <para style="s">Yugu kei kodigwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1" />Ana yegl mere Solomon Yawe yugu kei tenagledi kogon erukwa i, mudu ere kodugwa. Ere kodidre, ye nem Devit okna taragl silva ya gol ya taragl kane kane ye God togwa i, ye i pi God yugumo taragl bona simara dumo edugwa.<verse eid="2CH 5:1" /></para>
  <chapter eid="2CH 5" />
</usx>