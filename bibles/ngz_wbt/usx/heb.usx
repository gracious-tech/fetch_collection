<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">EBE Engungwel</book>
  <para style="h">EBEL</para>
  <para style="toc1">Ɔ̃nkaan wu Ebel</para>
  <para style="toc2">Ebel</para>
  <para style="toc3">Ebe</para>
  <para style="mt1">Ɔ̃nkaan wu Ebel</para>
  <para style="imt1">Obɛɛn b'ɔ̃nkaan</para>
  <para style="ip">Ɔ̃nkaan wu, wu áswɛn Afi-Ebel sua mvel wu ãku-ãsɛɛn ye wu ãku-ãsɛɛn y'ãnã. Ndɛ oli ngɔmɔ̃ onse ɛ̃nkaan mi ɛ̃nduru ola onse ɛ̃nkaan mi Ondoo b'Alili, bvool oli wu onduru ɔ̃bvɛn.</para>
  <para style="ip">Mbuul wu áswɛn ɔ̃nkaan wu, baal k'ayɛɛ ndɛ wɛ. Ekoo k'eyɛɛn wɛn mbuul ondɛ áli ɔ̃kiool wu Ɔ̃yuda (<char style="xt"><ref loc="HEB 1:1">1.1</ref></char>), bvool áli y'oyɛɛ b'ãndɔɔ m'Ondoo bo Tsɔɔn, bvel-bvel m'ãndɔɔ m'ãli onse ɔ̃nkaan wa Lebvitike. Ndɛ onge wu áyɔɔ Nsia yi Ngesɛ me nkuul amwɛn b'ɛ̃kwel (<char style="xt"><ref loc="HEB 2:3">2.3</ref></char>).</para>
  <para style="ip">Ndɛ áyuɔɔl ɔ̃nkaan wu ol'Ayuda b'ákaal ɛ̃kwal onge ndɛ bvool ál'áyii baal b'Ebvɔɔn li émeenam ndɛ onse lɔ (<char style="xt"><ref loc="HEB 13:19">13.19</ref>,<ref loc="HEB 13:23">23</ref></char>). Anga-ãyal bibi b'ayio ãndɔɔ ã Nziã atsam ndiri ɔ̃nkaan wu aywɔɔl ndɛ ol'akiool ba bviil li Lɔm (<char style="xt"><ref loc="HEB 13:24">13.24</ref></char>).</para>
  <para style="ip">Ɔ̃swɛn-ɔ̃nkaan wu asuo kwɛn ndɛ oswɛn ndɛ me ndɔɔ yi «awɛɛl baal» (<char style="xt"><ref loc="HEB 13:22">13.22</ref></char>), me ndɔɔ yɛn baal b'éswɛn ndɛ ndɛ, ombio bibi ósam onse bɔ. Bɔ ál'ayii abii k'ayɔɔl okiool me Yeso Mãsia kwɛn bɔ abvool onse k'onkɔɔ b'Ayuda (<char style="xt"><ref loc="HEB 2:1-4">2.1-4</ref>; <ref loc="HEB 4:1-11">4.1-11</ref>; <ref loc="HEB 6:4-6">6.4-6</ref>; <ref loc="HEB 10:26-31">10.26-31</ref></char>).</para>
  <para style="ip">Onse ɔ̃nkaan wu, ndɛ bvool asuo bɔ kwɛn Yeso Mãsia wu Muaan a Nziã onduru ãnzwel (<char style="xt"><ref loc="HEB 1:1-2:18">1.1–2.18</ref></char>), onduru Moyize ye Dzodzue (<char style="xt"><ref loc="HEB 3:1-4:13">3.1–4.13</ref></char>), bvool onduru anga-a-Nziã b'Ondoo bo Tsɔɔn (<char style="xt"><ref loc="HEB 4:14-8:13">4.14–8.13</ref></char>). Ɔ̃swɛn asuo kwɛn mpɔɔ yi éwi Mãsia kɛn a sa ngemɔ ɔ̃bu enduru m'ákewa kɛn onge owa onse Ondoo bo Tsɔɔn (<char style="xt"><ref loc="HEB 9:1-10:18">9.1–10.18</ref></char>).</para>
  <para style="ip">Me ndɔɔ yi awɛɛl bɔ, ɔ̃swɛn asuo bɔ baal b'áli y'okiool onse Ondoo bo Tsɔɔn, kwɛn bɔ anɔɔn a kuul e bɔ (<char style="xt"><ref loc="HEB 11:1-40">11.1-40</ref></char>). Ndɛ atam bɔ «k'atal Yeso» (<char style="xt"><ref loc="HEB 12:2">12.2</ref></char>), nga-osɛ-mwiĩ wu obvaan kwɛn baal anɔɔn a kuul e ndɛ onse ɔ̃mbio.</para>
  <para style="ip">Ɔ̃nkaan wu oli y'ɔ̃bvɛn bibi, me ndɔɔ yɛn ndɛ awuaal a baal k'akwaal otsɛn b'ãndɔɔ m'ãtal obuɛɛn o Nziã onse Ondoo bo Tsɔɔn, bvel-bvel ãmpɔɔ m'ã́li edzel-a-edzel a empɔɔ-a-mpɔɔ yi éwi Mãsia sa ngelemɔ̃ ɔ̃bu (<char style="xt"><ref loc="HEB 8-10">8–10</ref></char>).</para>
  <para style="ip">Ndɛ hɛ̃ oli y'ãyɛɛn bibi m'ɔ̃bvɛn m'ãwɛɛl okiool o baal ba lio li, bvool m'ãsa kwɛn baal adzuul onse onsensal (<char style="xt"><ref loc="HEB 11-13">11–13</ref></char>).</para>
  <para style="ip">Ndɛ osɛɛl ɔ̃nkaan a ndɛ m'ãyɛɛn m'ondɔɔl o kuɔɔl ye m'olɛɛl (<char style="xt"><ref loc="HEB 13:24-25">13.24-25</ref></char>).</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Nziã oyɛɛn ye baal m'ɔ̃nywã a Muaan a ndɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Me lio li tsɔɔn, Nziã áyɛɛn ãnsa bibi bvool m'emfa bibi, y'ankiɔɔn a bia-byɛ, m'ɛ̃nywã mi aliaal-ɛ̃kiɛɛn a ndɛ. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Kɛn a meba m'ãtsoo mã ntɔ mã, Nziã oyɛɛn ye bia-byɛ m'ɔ̃nywã a Muaan a ndɛ. Ndɛ ási ywel ye nsie me nkuul a Muaan ondɛ, bvool osuul ndɛ wu awal ɛ̃swal mi eluɔ bvieel. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Muaan ondɛ wu asuo emfa ki engal lweel e Nziã. Ndɛ oli emfa kyam ki eli Nziã bvool abesuo okwɛn o ndɛ nkal eluɔ bvieel me waan li Endɔɔ e ndɛ. Ke mbee a ŋ'esuɔɔl ndɛ baal m'ãbi ã bɔ, ndɛ oyebva nsɛn ke ywel, ke kuɔɔl ki elam ki Nziã-Nga-Waan.<verse eid="HEB 1:3" /></para>
  <para style="s">Muaan a Nziã onduru ãnzwel</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Muaan onduru ãnzwel bvɛɛ, nzal a ŋɛn Nziã owi ndɛ mpu yi enduru yi mɔ̃. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Ke ngwel wɛ, lɔɔ-okal, Nziã kɛn ayɛɛn ãnzwel ngamɔ̃ ndiri:</para>
  <para style="q1" vid="HEB 1:5">«Yɛ li muaan a mɛ̃,</para>
  <para style="q2" vid="HEB 1:5">nonɔ̃, mɛ̃ wu nsi kwɛn yɛ kal.»</para>
  <para style="m" vid="HEB 1:5">Ndɛ bvool lɔɔ-okal kɛn ayɛɛn ãnzwel ndiri:</para>
  <para style="q1" vid="HEB 1:5">«Mɛ̃, mɛ̃ èkal Tal me ndɔɔ a mɔ̃,</para>
  <para style="q2" vid="HEB 1:5">mɔ̃ ãkal muaan me ndɔɔ a mɛ̃<note caller="-" style="x"><char style="xo" closed="false">1.5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Ãnz 2.7</ref>; <ref loc="2SA 7:14">2Sa 7.14</ref></char></note>.»<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Kɛn a ŋ'ékeswɛɛl Nziã Muaan a ndɛ wu ɛ̃kwel onse ɔ̃kiri, ndɛ áyɛɛn ndiri:</para>
  <para style="q1" vid="HEB 1:6">«Yɔɔl kwɛn ãnzwel ã Nziã mbueel ãbva ãbuo ke nkwel a ndɛ,</para>
  <para style="q2" vid="HEB 1:6">m'olweel o ndɛ<note caller="-" style="x"><char style="xo" closed="false">1.6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Det 32.43</ref>; <ref loc="PSA 96:7">Ãnz 96.7</ref></char></note>.»<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Me ndɔɔ ãnzwel, ndɛ áyɛɛn ndiri:</para>
  <para style="q1" vid="HEB 1:7">«Nziã ásuul ãnzwel ã ndɛ onge amfel,</para>
  <para style="q2" vid="HEB 1:7">ásuul asal a ndɛ onge elam e mbaa<note caller="-" style="x"><char style="xo" closed="false">1.7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">Ãnz 104.4</ref></char></note>.»<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Kɛn a me ndɔɔ a Muaan, Nziã áyɛɛn ndiri:</para>
  <para style="q1" vid="HEB 1:8">«Ee Nziã, kiri e yɛ li okwɛn eli li ɔ̃bu nzal ɔ̃bu,</para>
  <para style="q2" vid="HEB 1:8">yɛ abebiri omfam o yɛ m'emfa ki dzu.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Yɛ dzii ãndɔɔ mã dzu bvool byel obi,</para>
  <para style="q2" vid="HEB 1:9">obɔ otsɛn bɛn, ee Nziã,</para>
  <para style="q2" vid="HEB 1:9">Nziã a yɛ oyiri yɛ mbaal m'esɛ,</para>
  <para style="q2" vid="HEB 1:9">mbaal mã ngel m'ãsuo kwɛn yɛ li ɔ̃kwɛn,</para>
  <para style="q2" vid="HEB 1:9">wu esueel ndɛ yɛ, k'andoo a yɛ wɛ!<note caller="-" style="x"><char style="xo" closed="false">1.9 </char><char style="xt" closed="false"><ref loc="PSA 45:7-8">Ãnz 45.7-8</ref></char></note>»<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Bvool Nziã áyɛɛn ndiri:</para>
  <para style="q1" vid="HEB 1:10">«Mfam, k'obɛɛn wu ábuo ɔ̃kiri mpii yɛ.</para>
  <para style="q2" vid="HEB 1:10">Ywel mpii li ési mviɔɔl ɛ̃ yɛ.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Bvɛ ekieel edziɔɔn,</para>
  <para style="q2" vid="HEB 1:11">kɛn a yɛ, yɛ àkal ɔ̃bu.</para>
  <para style="q1" vid="HEB 1:11">Bvɛ bvieel ekieel efool onge ekɔ.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Yɛ akieel afuru bvɛ onge ekɔ,</para>
  <para style="q2" vid="HEB 1:12">bvool akieel aswɛɛl bvɛ onge ekɔ.</para>
  <para style="q1" vid="HEB 1:12">Kɛn a yɛ àkal m'emfa ki eli yɛ,</para>
  <para style="q2" vid="HEB 1:12">ɛ̃bvu ɛ̃ yɛ k'ɛ̃kieel ɛ̃kal ye ntɔ wɛ.<note caller="-" style="x"><char style="xo" closed="false">1.12 </char><char style="xt" closed="false"><ref loc="PSA 102:26-28">Ãnz 102.26-28</ref></char></note>»<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Bvool Nziã lɔɔ-okal kɛn ayɛɛn ãnzwel ngamɔ̃ ndiri:</para>
  <para style="q1" vid="HEB 1:13">«Ya bva nsɛn me kuɔɔl e mɛ̃ ki elam,</para>
  <para style="q2" vid="HEB 1:13">tiil ye k'esuul mɛ̃ ataal a yɛ ke nsɛn a ntaã e yɛ wɛ<note caller="-" style="x"><char style="xo" closed="false">1.13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Ãnz 110.1</ref></char></note>.»<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Ãnzwel anã ãli? Mɔ̃ ãli ɛ̃fel mi ɛ̃besal me ndɔɔ a Nziã, bvool ndɛ abeyuɔɔl mɔ̃ me ndɔɔ yi awuaal a bɛn ebvaan abɔɔ ɔ̃swal wu obvuul.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Obvuul bam b'onɛn</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Obɔ otsɛn bɛn, bia-byɛ ebvaan ekuru nzuru ye mpɛn m'ãndɔɔ m'éyoo bia-byɛ, kwɛn bia-byɛ ebee odziɔɔn. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Ke ngwel wɛ, Endɔɔ li élieel Nziã me nkuul a ãnzwel esuo kwɛn lɔ eli taa-taa. Kɛn a baal bakyɛ áfel ngel a lɔ bvool áywɛn k'alweel lɔ. Obobɔ, bɔ ábɔɔ etumbu m'emfa ki ébvaan me bɔ. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Oŋɔ̃, emfa emã kyɛn Nziã ol'okwɛɛn k'awa bia-byɛ etumbu, okɛɛn bia-byɛ ewel obvuul b'onɛn bo bubu ngwel? Ŋ'ɛ̃kwel Mfam Yeso ndyam mbuul wu áwi bia-byɛ nsia yi obvuul obɔ. Ke mbee oŋɔ̃, baal b'áyoo yɔ ásuo bia-byɛ otaa-taa o yɔ. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Nziã hɛ̃ ákesuo otaa-taa o nsia a bɔ m'eliĩ, m'ɛ̃sal mi ɛ̃nɛn, m'emvieel bvi emfa bwɛn emfa bvool m'ãkab m'Ɔ̃fel wu Ɔ̃nsensal, m'éwi ndɛ bɔ m'emfa ki edzii ndɛ.<verse eid="HEB 2:4" /></para>
  <para style="s">Ãndɔɔ mbueel ãli ke nsɛn a okwɛn o Muaan</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Nziã mpii okwɛn nkal ɔ̃kiri wu àya wu ebeyɛɛn bia-byɛ, ke m'ãnzwel awi wɛ. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Kɛn a mbuul ngɔmɔ̃ áyɛɛn onse Ɔ̃nkaan a Nziã ndiri:</para>
  <para style="q1" vid="HEB 2:6">«Mbuul nã ali,</para>
  <para style="q2" vid="HEB 2:6">kwɛn yɛ tsam me ndɔɔ a ndɛ?</para>
  <para style="q1" vid="HEB 2:6">Muaan a mbuul nã ali,</para>
  <para style="q2" vid="HEB 2:6">kwɛn yɛ kɛɛ ndɛ nguo?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Me muaan lio etsi-tsiri,</para>
  <para style="q2" vid="HEB 2:7">yɛ suul ndɛ ke nsɛn ãnzwel.</para>
  <para style="q1" vid="HEB 2:7">Yɛ laal ndɛ ekɔrɔ ki okwɛn ki lweel ye dzuun,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />yɛ suul eluɔ bvieel ke nsɛn okwɛn o ndɛ<note caller="-" style="x"><char style="xo" closed="false">2.8 </char><char style="xt" closed="false"><ref loc="PSA 8:5-7">Ãnz 8.5-7</ref></char></note>.»</para>
  <para style="m" vid="HEB 2:8">Ŋ'esuul Nziã eluɔ bvieel ke nsɛn okwɛn o ndɛ, k'eli y'eluɔ ki ésiil ndɛ kyɛn k'eli ke nsɛn a okwɛn o ndɛ wɛ. Ŋ'esa oŋɔ̃, eli taa-taa kwɛn meba ŋã, bia-byɛ kɛn k'emwɛn kwɛn eluɔ bvieel eli ke nsɛn okwɛn o ndɛ wɛ. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Kɛn a Yeso wɛn me muaan-lio etsi-tsiri áli ke nsɛn ãnzwel, bia-byɛ emwɛn kwɛn alaal ndɛ ekɔrɔ ki okwɛn ki lweel ye dzuun, me ndɔɔ epfu li émwɛn ndɛ fool. Obobɔ, me nyiĩ a Nziã, Yeso ákwi me ndɔɔ a baal bueel.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Eli ngesɛ kwɛn Nziã wu ási eluɔ bvieel bvool kwɛn eluɔ obvɛ eli me ndɔɔ a ndɛ, osi kwɛn Yeso amwɛn ãmpal omɔ̃, me ndɔɔ yi asuul ndɛ ɔ̃koo. Ndɛ osi obobɔ, kwɛn baan bibi abvɔɔn ye ndɛ onse lweel e ndɛ. Ke ngwel wɛ, Yeso wɛn obvuul o bɔ ofi ola ndɛ. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Yeso wu asuul baal akal ba ngel ye baal b'esuul ndɛ ayii ba ngel, bɔ bueel ali Tal ngɔmɔ̃. Obɔ otsɛn bɛn, ndɛ k'ali y'opfuru b'ata bɔ me baan-ngoo a ndɛ wɛ. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Ndɛ álieel ndiri:</para>
  <para style="q1" vid="HEB 2:12">«Mɛ̃ ekieel eyɛɛn me nkuũ a yɛ ola baan-ngoo a mɛ̃,</para>
  <para style="q1" vid="HEB 2:12">mɛ̃ ekieel elweel yɛ m'ãnziĩ onse obvɔɔn<note caller="-" style="x"><char style="xo" closed="false">2.12 </char><char style="xt" closed="false"><ref loc="PSA 22:23">Ãnz 22.23</ref></char></note>.»<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Ndɛ bvool olieel ndiri:</para>
  <para style="q1" vid="HEB 2:13">«Mɛ̃, mɛ̃ ekieel elɔ okiool o mɛ̃ onse ndɛ.»</para>
  <para style="m" vid="HEB 2:13">Ndɛ olweel ndiri:</para>
  <para style="q1" vid="HEB 2:13">«Mɛ̃ bu, mɛ̃ ye baan b'ewi Nziã mɛ̃.<note caller="-" style="x"><char style="xo" closed="false">2.13 </char><char style="xt" closed="false"><ref loc="ISA 8:17">Edz 8.17</ref>,<ref loc="ISA 8:18">18</ref></char></note>»<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Obobɔ, onge bɛn, baan obɔ ali ye nzuru y'ãkel, Yeso ábvɔɔn mboo ngamɔ̃ y'ombuul o bɔ, me ndɔɔ yɛn ndɛ hɛ̃ áli ye nzuru yi ombuul. Ndɛ ási obobɔ, me ndɔɔ yɛn, m'epfu e ndɛ, ndɛ amɛn waan e wu ákesiin mpɛn a epfu, ndɛ ondɛ ɔ̃pfu. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />Ndɛ okwi me ndɔɔ yi abvuul baal bueel bɛn, m'omwiĩ o bɔ bueel, áli m'owɔɔl onse onkyal, me ndɔɔ a buɔ b'epfu. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Ke ngwel wɛ, eli taa-taa kwɛn Yeso k'áyi me ndɔɔ yi ayebvuul ãnzwel wɛ, ndɛ yam li Abalayam áyebvuul. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Obɔ otsɛn bɛn, ál'ebvaan ndɛ akal emfa ngemɔ̃ ye baan-ngoo a ndɛ m'ãndɔɔ mbueel, kwɛn ndɛ akal Ngaa-a-Nziã wu ɔ̃nɛn, wu oluul me nyiĩ bvool wɛn akoo k'alɔ okiool onse ndɛ, onse ɔ̃sal a Nziã, kwɛn adzeel ãbi ã baal. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Ke ngwel wɛ, onge bɛn ndyam ámwɛn fool ŋ'ébwel ndɛ onse ɔ̃mbio, ndɛ hɛ̃ okoo k'awuaal a baal b'abwel onse ɔ̃mbio.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Yeso onduru Moyize</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Andoo ba ngel, obɔ otsɛn bɛn byɛ b'éti Nziã mbel me ndɔɔ yi ebɔɔ opfel bo ywel, etal kɛn a Yeso wu ebekiool bia-byɛ ke kwel a baal bueel onge ntam bvool ngaa-a-Nziã wu ɔ̃nɛn. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Ndɛ áli wu obvaan m'olɔ b'okiool onse ndɛ, ke mviil ã Nziã wu ásueel ndɛ, onge b'éli Moyize nkal a yam e Nziã lueel<note caller="-" style="x"><char style="xo" closed="false">3.2 </char><char style="xt" closed="false"><ref loc="NUM 12:7">Ɛ̃bv 12.7</ref></char></note>. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Kɛn a Yeso ábɔɔ dzuun li enduru li éli a Moyize. Nzal a ŋɛn mbuul wu atuu nzɔ oli ye dzuun li enduru li nzɔ yam. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Ke ngwel wɛ, nzɔ yueel, wu abetuu yɔ mbuul. Kɛn a wu átuu bvieel Nziã. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Me b'otal Moyize, ndɛ áli wu obvaan m'olɔ b'okiool onse nzɔ a Nziã yueel, onge ɔ̃sal, me ndɔɔ yi atsweel ãndɔɔ m'ékeeyɛɛn Nziã ke mbee. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Kɛn a Mãsia oli wu obvaan m'olɔ b'okiool onge Muaan nkal a nzɔ a Nziã. Ŋ'esa oŋɔ̃, nzɔ a ndɛ eli bia-byɛ, okɛɛn bia-byɛ esɛn ãnã tiil ntɔ onse ãŋã ye kaã bvi eli bia-byɛ y'esɛ me bvɛ.<verse eid="HEB 3:6" /></para>
  <para style="s">Ãnkunkwa me ndɔɔ yi akiool owuun b'ewa Nziã</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Obɔ otsɛn bɛn, Ɔ̃fel wu Ɔ̃nsensal oyɛɛn ndiri:</para>
  <para style="q1" vid="HEB 3:7">«Okɛɛn nonɔ̃ byɛ eyoo nkii a ndɛ,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />ebee y'ɛ̃tswɛ mpɛn okal,</para>
  <para style="q1" vid="HEB 3:8">onge me tsoo li ébee bɔ Nziã olweel,</para>
  <para style="q1" vid="HEB 3:8">bvool ámbio ndɛ,</para>
  <para style="q1" vid="HEB 3:8">onse ɔ̃baan wa kɛɛ-kɛɛ.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Okɔ, ankiɔɔn a byɛ ápwee mɛ̃ ŋ'ékeywɛɛn bɔ mɛ̃ k'esa ndɔɔ,</para>
  <para style="q1" vid="HEB 3:9">onkyam ŋɛn, bɔ ámwɛn ɛ̃sal ɛ̃ mɛ̃,<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />mvel ãku-ãnã (40).</para>
  <para style="q1" vid="HEB 3:10">Obɔ otsɛn bɛn, mɛ̃ éyoo nkye ye baal ba lio olɔ bvool élieel bɔ wɛn:</para>
  <para style="q1" vid="HEB 3:10">“Ɛ̃kwal ɛ̃ bɔ ɛ̃bebii kɛn onge obii,</para>
  <para style="q1" vid="HEB 3:10">bvool bɔ k'ayɛɛ ãnkuul ã mɛ̃ wɛ.”<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Onse mpuru a mɛ̃, mɛ̃ ndab ɔ̃kyel wɛn:</para>
  <para style="q1" vid="HEB 3:11">“Bɔ kieel k'asam bam onse owuun o mɛ̃ wɛ!”<note caller="-" style="x"><char style="xo" closed="false">3.11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">Ãnz 95.7-11</ref></char></note>»<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Andoo, ekal y'onkyab! Mbuul ngɔmɔ̃ onse byɛ abee y'ɔ̃kwal wu ɔ̃bi okal, abee okiool oywɛn, bvool abee lala ye Nzia wa mwiĩ osyal. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Kɛn ewa bakyɛ mpɛn tsoo bwɛn a tsoo, me lio lam lueel lɛn akoo k'ata me: «Nonɔ̃», kwɛn mbuul si ngɔmɔ̃ onse byɛ abee y'ɔ̃tswɛ mpɛn okal, me pfuru li obi. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Ke ngwel wɛ, bia-byɛ eyii bvoo ye Mãsia, okɛɛn bia-byɛ esɛn ãnã tiil ntɔ onge b'éli bia-byɛ fa obɛɛn.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Obobɔ, ákel bubu:</para>
  <para style="q1" vid="HEB 3:15">«Okɛɛn nonɔ̃, byɛ eyoo nkii a ndɛ,</para>
  <para style="q1" vid="HEB 3:15">ebee y'ɛ̃tswɛ mpɛn okal,</para>
  <para style="q1" vid="HEB 3:15">onge me tsoo li ébee bɔ Nziã olweel.<note caller="-" style="x"><char style="xo" closed="false">3.15 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">Ãnz 95.7-8</ref></char></note>»<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Ke mbee a ŋ'éyoo bɔ nkii a Nzia, b'áywɛɛn ndɛ k'asa ndɔɔ anã? Eli baal bueel b'épaal Moyize k'Edzipito<note caller="-" style="x"><char style="xo" closed="false">3.16 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">Ɛ̃bv 14.1-35</ref></char></note>. <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />B'éyi Nziã mpuru ye bɔ mvel ãnku-anã (40) anã? Eli ye baal b'ási ãbi, bɛn ebiĩ e bɔ élaal abɔ-bɔ k'ɔ̃baan wa kɛɛ-kɛɛ. <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Ŋ'élab Nziã ɔ̃kyel ndiri: «Bɔ kieel k'asam onse owuun b'éyɛɛl mɛ̃ me ndɔɔ a bɔ wɛ», ndɛ y'anã ákeyɛɛn? Eli ye b'ábee ndɛ olweel<note caller="-" style="x"><char style="xo" closed="false">3.18 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">Ɛ̃bv 14.1-35</ref></char></note>.<verse eid="HEB 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 3:19" />Obobɔ, bia-byɛ emwɛn kwɛn bɔ k'ákoo k'asam wɛ, me ndɔɔ yɛn bɔ áywɛn a okiool.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Obobɔ, onge bɛn Nziã áwi bia-byɛ lɔɔ li esam onse owuun b'éyɛɛl ndɛ, yɔɔl kwɛn mbuul si ngɔmɔ̃ onse byɛ abee mpwee yi asam onse bɔ oywɛn. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Ke ngwel wɛ, átee bia-byɛ Endɔɔ e Nziã, emfa kiki hɛ̃ átee bɔ lɔ. Kɛn Endɔɔ li éyoo bɔ k'ési bɔ ndɔɔ si ngamɔ̃ wɛ, me ndɔɔ yɛn bɔ k'áyɔɔɔ lɔ y'okiool wɛ. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Taa-taa, bia-byɛ b'ekiool, esam onse owuun b'éyɛɛl Nziã, ŋ'élieel ndɛ ndiri:</para>
  <para style="q1" vid="HEB 4:3">«Onse mpuru a mɛ̃,</para>
  <para style="q1" vid="HEB 4:3">mɛ̃ ndab ɔ̃kyel wɛn:</para>
  <para style="q1" vid="HEB 4:3">“Bɔ bam kieel k'asam onse owuun b'éyɛɛl mɛ̃ wɛ!”<note caller="-" style="x"><char style="xo" closed="false">4.3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Ãnz 95.11</ref></char></note>»</para>
  <para style="m" vid="HEB 4:3">Kwɛn ŋɛn, Nziã áman ɛ̃sal ɛ̃ ndɛ fa ŋ'ési ndɛ ɔ̃kiri. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Ke ngwel wɛ, ke mboo ngamɔ̃ áyɛɛn me ndɔɔ a tsoo li nsiaan bubu: «Me tsoo li nsiaan, Nziã owuun m'ɛ̃sal ɛ̃ ndɛ mvieel<note caller="-" style="x"><char style="xo" closed="false">4.4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Obɛ 2.2</ref></char></note>.» <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Bvool ke mboo yiyi, álieel bubu: «Bɔ bam kieel k'asam onse owuun b'éyɛɛl mɛ̃ wɛ.» <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Obobɔ, b'áyoo Endɔɔ e Nziã ɛ̃kwel k'ásam onse owuun b'éyɛɛl Nziã wɛ, me ndɔɔ yɛn bɔ ábee k'álweel Nziã. Ŋɛn eli ye b'ali ye mpwee yi asam onse bɔ. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Nziã bvool osuul tsoo ngelemɔ̃, li eti ndɛ me «nonɔ̃». Ke mbee ãlio bibi, ndɛ áyɛɛn me ndɔɔ a tsoo olɔ m'ɔ̃nywã a David, onge b'ayɛɛn ãyu-ywel ndiri:</para>
  <para style="q1" vid="HEB 4:7">«Okɛɛn nonɔ̃, byɛ eyoo nkii a ndɛ,</para>
  <para style="q1" vid="HEB 4:7">ebee y'ɔ̃tswɛ mpɛn okal!<note caller="-" style="x"><char style="xo" closed="false">4.7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">Ãnz 95.7-8</ref></char></note>»<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Ke ngwel wɛ, okɛɛn Dzodzue ábiri bɔ k'owuun b'éyɛɛl Nziã, ke mbee oŋɔ̃, Nziã kɛn k'ákaayɛɛn me ndɔɔ a tsoo ekyam li owuun wɛ. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Obobɔ, eli y'owuun bo saba b'eyɛɛl Nziã me ndɔɔ a yam a ndɛ. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Ke ngwel wɛ, mbuul wu osam onse owuun o Nziã, owuun hɛ̃ m'ɛ̃sal ɛ̃ ndɛ, onge b'éwuun Nziã m'ɛ̃sal mi ndɛ. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Obobɔ, bia-byɛ esa mpɛn yi esam onse owuun obɔ, kwɛn mbuul si ngɔmɔ̃ abee obva emfa kiki onge ábee olweel.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Ke ngwel wɛ, Endɔɔ e Nziã eli y'omwiĩ, bvool ebesal. Lɔ eli y'otɔ enduru epwel. Lɔ ebesam onse mbuul tiil k'ekab lɔ ɔ̃kwal y'ɔ̃fel, ekab amboo m'emwɛɛn ɛ̃ywee ye nsɔɔl. Lɔ ebebwɛɛl efua y'ãtsam. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />K'eli y'eluɔ si ngemɔ̃ ki ési Nziã ki eli m'odziɔɔn ke nkwel a ndɛ wɛ: Bvieel eli odzuũ bvool eli kal-a-kal ke nkwel a ndɛ wɛn ola ndɛ ebvaan bia-byɛ eyeliaal ãbuu.<verse eid="HEB 4:13" /></para>
  <para style="s1">Yeso oli Ngaa-a-Nziã wu ɔ̃nɛn</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Obobɔ, onge bɛn bia-byɛ eli ye Ngaa-a-Nziã wu ɔ̃nɛn, wu oyɛn bam tiil ke mboo yi eli Nziã, ndɛ wu Yeso wu Muaan a Nziã, yɔɔl kwɛn bia-byɛ esɛn ãnã onse okiool b'ebeyɛɛn bia-byɛ me bɔ ke nkwel a baal bueel. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Ke ngwel wɛ, bia-byɛ eli ye Ngaa-a-Nziã wu ɔ̃nɛn wu okoo k'amwɛn mpal bvoo ye bia-byɛ onse okwal o bia-byɛ. Ámbio ndɛ m'emfa bvieel onge bia-byɛ, kɛn a ndɛ k'ási obi wɛ. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Obobɔ, esyal tsotsoo a kiri li okwɛn y'aŋã mbueel, kwɛn Nziã àyoo bia-byɛ ãwua, àsio bia-byɛ nyiĩ, bvool àwuaal a bia-byɛ me lio li ngesɛ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Ngaa-a-Nziã wu ɔ̃nɛn wueel abesuaal ndɛ onse baal, bvool abesuul ndɛ abesa ɔ̃sal a Nziã me ndɔɔ a baal obɔ, kwɛn ndɛ awa Nziã ãkab m'emfa bwɛn emfa me ndɔɔ odzeel b'ãbi ã baal. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Ndɛ okoo k'akwaal baal b'ali onse odzɛɛn bvool b'adzɛɛn nkuul otsɛn, me ndɔɔ yɛn ndyam hɛ̃ oli y'okwal bibi. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Obɔ otsɛn bɛn, me ndɔɔ a okwal obɔ, ebvaan ndɛ abewa ãkab m'emfa bwɛn emfa, me ndɔɔ odzeel b'ãbi ã ndyam ye mã baal.<note caller="-" style="x"><char style="xo" closed="false">5.3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Lev 9.7</ref></char></note> <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Mbuul si ngɔmɔ̃ k'akoo k'ayebii dzuun li akal Ngaa-a-Nziã wu ɔ̃nɛn me ndyam wɛ. Nziã ndyam wu asuaal ndɛ, onge b'ésueel ndɛ Alona<note caller="-" style="x"><char style="xo" closed="false">5.4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">Opa 28.1</ref></char></note>.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Emfa kiki hɛ̃, Mãsia k'ábii lweel li akal Ngaa-a-Nziã wu ɔ̃nɛn me ndyam wɛ, kɛn a Nziã wu álieel ndɛ ndiri:</para>
  <para style="q1" vid="HEB 5:5">«Yɛ li Muaan a mɛ̃,</para>
  <para style="q2" vid="HEB 5:5">nonɔ̃, mɛ̃ wu nsi kwɛn yɛ kal<note caller="-" style="x"><char style="xo" closed="false">5.5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Ãnz 2.7</ref></char></note>.»<verse eid="HEB 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 5:6" />Ke mboo nkyam, ndɛ bvool álieel ndiri: «Yɛ li Ngaa-a-Nziã wu ɔ̃bu, m'ɔ̃luo wa Melikisedek<note caller="-" style="x"><char style="xo" closed="false">5.6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Ãnz 110.4</ref></char></note>.»<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />M'omwiĩ o Yeso me nsie ŋã, ndɛ ákebuɛɛn Nziã wu ákoo k'abvuul ndɛ m'epfu, ákeluɔɔn ndɛ me nkii ye kɔkɔ, ákelel ãnsia me mviil. Obobɔ, Nziã áyoo ndɛ me ndɔɔ yɛn ndɛ áli ye lweel e ndɛ.<note caller="-" style="x"><char style="xo" closed="false">5.7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">Mat 26.36-46</ref>; <ref loc="MRK 14:32-42">Mak 14.32-42</ref>; <ref loc="LUK 22:39-46">Luk 22.39-46</ref></char></note> <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Onkyam ŋɛn ndɛ Muaan a Nziã, ndɛ áyio lweel me nkuul a fool lueel li émwɛn ndɛ. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Ŋ'asuul ndɛ oyii ndɛ ɔ̃koo, ndɛ oyii wɛn baal bueel b'alweel ndɛ, obvuul o bɔ b'ɔ̃bu nzal ɔ̃bu ofa ola ndɛ. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Ke ngwel wɛ, Nziã osuul ndɛ Ngaa-a-Nziã wu ɔ̃nɛn m'ɔ̃luo wa Melikisedek.<verse eid="HEB 5:10" /></para>
  <para style="s">K'ebvaan ayɔɔl okiool wɛ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Me ndɔɔ a ndɔɔ oyɔ, bee eli ye m'eyɛɛn bibi, kɛn eli ye mpal k'abɛɛl ãndɔɔ omɔ̃, ke ngwel wɛ byɛ k'ekwaal ãndɔɔ otsɛn tswa-a-tswa wɛ. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Byɛ bɛn bɛɛn kal-kal ekeekal ayiool a bakyɛ, byɛ kɛn edzii kwɛn ayiool byɛ endɔ-ndɔɔ bvi etsi-etsi bvi ɛ̃kwel bvi etal Endɔɔ e Nziã. Byɛ k'edzii k'edza eluɔ bvi ye mpɛn wɛ, byɛ edzii k'enywã ãbiaal!<note caller="-" style="x"><char style="xo" closed="false">5.12 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1Ko 3.2</ref></char></note> <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Kwɛn ŋɛn, mbuul wu abenywã ãbiaal kɛn oli muaan wu ɔ̃bwe, ndɛ ki ayɛɛ m'ãndɔɔ mã dzu pyɛ. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Kɛn a bvi-odza bvi ye mpɛn eli kɛn a bvi baal b'amaayal, bɛn onse emfa ki ekal bɔ, ayɛɛ k'asuaal obi y'obvɛ.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Obɔbɔ, bia-byɛ eyɔɔl endɔ-ndɔɔ bvi etsi-etsi bvi ɛ̃kwel bvi etal Endɔɔ e Mãsia, enɔɔn ãtee m'ãbvaan me baal b'amaayal onse okiool. Bia-byɛ ebee obvool k'ãtee m'obɛɛn m'ãtal okaal b'ɛ̃kwal, m'ãtal oyɔɔl b'ãndɔɔ m'ãbiri k'epfu, m'ãtal okiool o Nziã, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />m'ãtal ãtee m'opongo, m'ãtal ondɔɔl o baal mviɔɔl, m'ãtal osiool o b'ákwi-ákwi bvool m'ãtal otsiil b'ãndɔɔ ã baal ɔ̃bu. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Omɔ̃ ãndɔɔ m'ekieel esa bia-byɛ, okɛɛn Nziã owi bia-byɛ mpwee.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Me b'otal baal b'émeeyɛɛl Nziã, b'ámaambio ãkab ã Nziã, b'ámaayɔɔ Ɔ̃fel wu Ɔ̃nsensal, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />b'ámaayoo esɛ ki Endɔɔ e Nziã li ebvɛ-ebvɛ, ye waan li ɔ̃kiri wu àya, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ŋɛn bɔ abvi, k'akoo bam bvool k'abiri bɔ k'okaal b'ɔ̃kwal wɛ. Ke ngwel wɛ, bɔ bvool ŋ'abebɛɛl Muaan a Nziã m'enkulusu, me ndɔɔ a bam, bvool abewa ndɛ opfuru ke mviil ã baal bueel.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Ŋɛn nsie yi ébueel ébueel amvel eburu ɛ̃ti mi ɛ̃bvɛ-ɛ̃bvɛ me ndɔɔ a bɛn asal yɔ me ndɔɔ a bɔ, Nziã abendɔɔl yɔ kuɔɔl. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Kɛn a ŋɛn yɔ epaal ãngɔ-ngɔɔ̃ y'ɛ̃ti mi ãnsiɛɛn mikyɛ, yɔ k'ebekal y'otsɛn wɛ. Oyiil wɛ, Nziã àbwel yɔ enkɛɛ, ntɔ a yɔ kɛn odzio o mbaa<note caller="-" style="x"><char style="xo" closed="false">6.8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">Obɛ 3.17-18</ref></char></note>.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Andoo a dzii, onkyam ŋɛn bee eyɛɛn obobɔ, bee ekiool bam wɛn, eluɔ ki enduru obvie ebekiaal byɛ, eluɔ okyɛ obvuul. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Ke ngwel wɛ, Nziã k'akwɛɛn k'akal dzu wɛ, ndɛ k'adzɛɛn ɔ̃sal a byɛ wɛ, k'adzɛɛn hɛ̃ dzii li esuo byɛ me ndɔɔ a nkuũ a ndɛ wɛ, y'emfa ki éwueel a byɛ bvool ki ebewuaal a byɛ baal a Nziã kɛn onge owuaal wɛ. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Bee edzii kwɛn mbuul bwɛn a mbuul onse byɛ asuo ɔ̃kwal mbaa awuwu tiil ntɔ, kwɛn oŋɔ̃ ãndɔɔ m'ebeta byɛ kaã ãkal ɔ̃koo, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />me ndɔɔ yɛn, byɛ ebee y'obwal okal, kɛn a byɛ ekal b'anɔɔn a kuul e baal bɛn m'okiool y'osɛ-mwiĩ, abɔɔ ɔ̃swal wu éwi Nziã lɔɔ.<verse eid="HEB 6:12" /></para>
  <para style="s">Ãndɔɔ m'élieel Nziã ndiri asa k'ãswɛɛl emfa</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Ŋ'éwi Nziã Abalayam lɔɔ, Nziã álab ɔ̃nkyel me nkuũ a ndyam, ke ngwel wɛ, k'eli ye mbuul wu onduru Nziã wɛ, kwɛn Nziã alab ɔ̃kyel me nkuũ ã ndɛ. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Ndɛ áyɛɛn bubu:</para>
  <para style="q1" vid="HEB 6:14">«Mɛ̃ ekieel endɔɔl yɛ kuɔɔl ngamfɛn, bvool mɛ̃ ekieel ewa yɛ ãyam boo-boo<note caller="-" style="x"><char style="xo" closed="false">6.14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">Obɛ 22.16-17</ref></char></note>.»<verse eid="HEB 6:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="HEB 6:15" />Obɔ otsɛn bɛn Abalayam áli y'osɛ-mwiĩ, bu abɔɔ eluɔ ki éwi Nziã ndɛ lɔɔ. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Ke ngwel wɛ, baal abelab ɔ̃kyel me nkuũ a mbuul wu onduru bɔ. Ɔ̃kyel wu asuo kwɛn ndɔɔ yi ayɛɛn eli taa-taa, enkyam k'ebekal wɛ. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Emfa kiki, Nziã ádzii k'ásuo kal-a-kal kwɛn ndɛ k'akoo k'aswɛɛl ndɔɔ yi éwɛɛ ndɛ bam wɛ. Obɔ otsɛn b'élab ndɛ ɔ̃kyel, kwɛn enkyam ebee okal ola baal b'abɔɔ eluɔ ki éwi Nziã bɔ lɔɔ. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Obobɔ, eli y'ãndɔɔ mbuaal mɛn k'akoo k'aswɛɛl wɛ. Me mɔ̃ Nziã k'akoo k'apfuru bam wɛ. M'emfa okyɛ, bia-byɛ b'emeedziɔɔn onse ndɛ, emeebɔɔ mpɛn yi bibi, yi esiin y'ɔ̃tɛɛ̃ wueel kaã li élieel ndɛ ndiri bia-byɛ eta me ndɛ. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Me ndɔɔ a bia-byɛ, kaã olɔ eli onge longo li omwiĩ o bia-byɛ. Lɔ k'ekoo k'ebii wɛ bvool eli mpɛn-mpɛn. Lɔ ebwel ongwel ekɔ ki enɛn ki onse Nzɔ a Nziã yi ke ywel, tiil ke mboo a Nziã yi enduru ɔ̃nsensal<note caller="-" style="x"><char style="xo" closed="false">6.19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">Lev 16.2</ref></char></note>. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Yeso ámaatsɔɔn nkwel a bia-byɛ okɔ bvool ásam okɔ me ndɔɔ a bia-byɛ. Ke ngwel wɛ, ndɛ oyii Ngaa-a-Nziã wu ɔ̃nɛn wu ɔ̃bu m'ɔ̃luo wa Melikisedek.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Melikisedek, ɔ̃kwɛn bvool ngaa-a-Nziã</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Melikisedek ondɛ wu áli ɔ̃kwɛn wa Salɛm bvool ngaa-a-Nziã-a-Mpuu. Ŋ'éfi Abalayam eta odzwaan y'akwɛn, bvool ábvel bɔ mpɛn, Melikisedek wu áyemwɛɛn ye ndɛ, bvool andɔɔl ndɛ kuɔɔl<note caller="-" style="x"><char style="xo" closed="false">7.1 </char><char style="xt" closed="false"><ref loc="GEN 14:17-20">Obɛ 14.17-20</ref></char></note>. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Obobɔ, Abalayam áwi ndɛ boo ngemɔ̃ onse ãboo kuun m'eluɔ bvieel bvi ébɔɔ ndɛ ke mvel. Nkuũ a Melikisedek edzii k'eyɛɛn ŋ'ɛ̃kwel ndiri: «Ɔ̃kwɛn wu ãndɔɔ mã dzu». Ndɛ hɛ̃ áli ɔ̃kwɛn wa Salɛm, ŋ'ayɛɛn ndiri: «Ɔ̃kwɛn wu opi». <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Ndɛ tal pyɛ, ngoo pyɛ, nkiɔɔn hɛ̃ pyɛ, tsoo li áburu ndɛ pyɛ, li ékwi ndɛ hɛ̃ pyɛ. Ndɛ ofɛɛn onge Muaan a Nziã bvool oli Ngaa-a-Nziã wu ɔ̃bu.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Emeetal emfa ki éli Melikisedek mbuul wu ɔ̃nɛn! Abalayam wu nkiɔɔn a bia-byɛ áwi ndɛ boo ngelemɔ̃ onse ãboo kuun m'eluɔ bvi ébɔɔ ndɛ ke mvel. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Ngel etam baan ba yam li Lebvi, b'ali angaa-a-Nziã, k'awal boo ngelemɔ̃ onse ãboo kuun m'eluɔ e baan-ngoo a bɔ, baal b'Isalayel, onkyam ŋɛn bɔ hɛ̃ ali atiɔɔl b'Abalayam<note caller="-" style="x"><char style="xo" closed="false">7.5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">Ɛ̃bv 18.21</ref></char></note>. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Kɛn a Melikisedek wɛn k'áli wa yam li Lebvi wɛ, áyɔɔ boo ngelemɔ̃ onse ãboo kuun m'eluɔ bvi Abalayam. Melikisedek bvool ándɔɔl mbuul wu éwi Nziã ãlɔɔ kuɔɔl. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Kɛn enkyam pyɛ: Wu onduru wukyɛ wu abendɔɔl wu obvool mbee kuɔɔl. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Emeetsam bvool: Angaa-a-Nziã b'abewal boo ngelemɔ̃ onse ãboo kuun m'eluɔ ali kɛn a baal b'akwa. Kɛn a me b'otal Melikisedek, ákel ndiri ndɛ oli mwiĩ. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Obobɔ, ekoo k'eyɛɛn wɛn, Lebvi wu abeyɔɔ boo ngelemɔ̃ onse ãboo kuun, ŋ'áwi lɔ hɛ̃ me nkuul a Abalayam. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Ke ngwel wɛ, Lebvi áli kɛn onse mwiĩ a nkiɔɔn m'Abalayam, ŋ'éyemwɛɛn Melikisedek ye ndɛ.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />M'emfa ki etam ngel yi áwi baal b'Isalayel, abesuaal angaa-a-Nziã onse yam e Lebvi m'emfa ki ongaa-o-Nziã b'Alona. K'okɛɛn angaa-a-Nziã ba yam li Lebvi ási ɔ̃sal wu ɔ̃koo, otsɛn omã bvool b'álɔ ongaa-o-Nziã okyam, m'emfa ki Melekisekek, ke m'emfa ki Alona wɛ? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Ke ngwel wɛ, okɛɛn aswɛɛl ongaa-o-Nziã, ngel hɛ̃ ebvaan aswɛɛl. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Ke ngwel wɛ, ãyɛɛn omɔ̃ ãtal mbuul wa yam ekyam, lɛn mbuul si ngɔmɔ̃ onse lɔ mwɛn-éndɛɛl kɛn asal ke nkiin yi awa Nziã ãkab wɛ. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Nzal-a-ŋɛn bia-byɛ eyɛɛ ngesɛ wɛn, Mfam a bia-byɛ oli wa yam li Yuda, yam lɛn Moyize yi áyɛɛn pyɛ me b'otal angaa-a-Nziã.<verse eid="HEB 7:14" /></para>
  <para style="s">Yeso wu Ngaa-a-Nziã wa m'emfa ki Melikisedeki</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Ndɔɔ yi ebeyɛɛn yi eyii bam kal-a-kal, ŋ'emɔɔn Ngaa-a-Nziã ɔ̃kyam wu ofɛɛn onge Melikisedek. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Ndɛ k'ayii Ngaa-a-Nziã me nkuul ãngel m'ãtal esii e baal wɛ, kɛn a me nkuul a waan li elaã lɛn ntɔ pyɛ. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Ke ngwel wɛ, ákel me ndɔɔ a ndɛ bubu:</para>
  <para style="q1" vid="HEB 7:17">«Yɛ li Ngaa-a-Nziã wu ɔ̃bu,</para>
  <para style="q1" vid="HEB 7:17">m'emfa ki Melikisedek<note caller="-" style="x"><char style="xo" closed="false">7.17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Ãnz 110.4</ref></char></note>.»<verse eid="HEB 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 7:18" />Obobɔ, Nziã ombaal Ngel yi tsɔɔn, me ndɔɔ yɛn yɔ éli y'okwal bvool k'éli y'otsɛn wɛ. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Ke ngwel wɛ, Ngel k'esi kwɛn eluɔ si ngemɔ̃ ekal ɔ̃koo wɛ. Kɛn a bia-byɛ ebɔɔ kaã li enduru obvie, lɛn me nkuul a lɔ bia-byɛ esyal tsotsoo a Nziã.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Ási obobɔ m'ɔ̃kyel wu élab Nziã. Kɛn a Nziã k'álab ɔ̃kyel wɛ, ŋ'eyii bakyɛ angaa-a-Nziã. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Kɛn a Yeso oyii Ngaa-a-Nziã me ndɔɔ yɛn Nziã álab ɔ̃kyel, ndiri:</para>
  <para style="q1" vid="HEB 7:21">«Mfam Nziã olab ɔ̃kyel,</para>
  <para style="q1" vid="HEB 7:21">ndɛ k'aswɛɛl ãtsam ã ndɛ wɛ:</para>
  <para style="q1" vid="HEB 7:21">“Yɛ li Ngaa-a-Nziã wu ɔ̃bu.<note caller="-" style="x"><char style="xo" closed="false">7.21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Ãnz 110.4</ref></char></note>”»<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Me ndɔɔ ɔ̃kyel ondɛ, Yeso oyii nsoo a ondoo b'onduru obvie.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Ndɔɔ yinkyɛ bvool yɛn angaa-a-Nziã ákekiri ke mboo a bakyɛ bibi, me ndɔɔ yɛn epfu ékekii bɔ k'asa ɔ̃sal a bɔ ɔ̃bu. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Kɛn a Yeso oli mwiĩ ɔ̃bu nzal ɔ̃bu, ongaa-o-Nziã o ndɛ oli b'ɔ̃bu nzal ɔ̃bu. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Obɔ otsɛn bɛn, ndɛ okoo k'abvuul m'emfa ki ɔ̃koo baal b'asyal tsotsoo a Nziã me nkuul a ndɛ, me ndɔɔ yɛn ndɛ oli mwiĩ ɔ̃bu, me ndɔɔ yi abebuɛɛn Nziã me ndɔɔ a bɔ.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Obobɔ, Yeso oli Ngaa-a-Nziã wu ɔ̃nɛn wa m'emfa okyɛ wu obvaan me ndɔɔ a bia-byɛ: Ndɛ oli Ɔ̃nsensal, ɔ̃nkinkyam, wu oywɛn a mbiin, Nziã ákab ndɛ y'anga-ãbi, bvool ándɛɛl ndɛ bam onduru ywel. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Onge angaa-a-Nziã b'anɛn bakyɛ, Yeso k'áli ye kɔɔ li awa ãkab tsoo bwɛn a tsoo wɛ, ŋ'ɛ̃kwel kɛn me ndɔɔ ãbi ã ndyam, ke mbee, me ndɔɔ a mã baal. Ndɛ ámaawa kab olɔ sa ngemɔ̃ ɔ̃bu, ŋ'éwi ndɛ elaã e ndɛ me ndyam onge kab<note caller="-" style="x"><char style="xo" closed="false">7.27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Lev 9.7</ref></char></note>. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Ke ngwel wɛ, Ngel ebesuul baal onge angaa-a-Nziã b'anɛn baal b'ali y'okwal. Kɛn ɔ̃kyel wu élab Nziã ke mbee a Ngel, ásuul Muaan Ngaa-a-Nziã wu ɔ̃nɛn, wu ésuul ndɛ ɔ̃koo ɔ̃bu.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Yeso oli Ngaa-a-Nziã a bia-byɛ wu ɔ̃nɛn</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Ngo-ngoo a ndɔɔ onse ãyɛɛn m'ebeyɛɛn bee ndɛ bu: Bia-byɛ eli ye Ngaa-a-Nziã wu ɔ̃nɛn wa m'emfa okyɛ. Ndɛ ábvi nsɛn ke ywel me kuɔɔl ki elam ki kiri li Okwɛn e Nziã, waan li enɛn<note caller="-" style="x"><char style="xo" closed="false">8.1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Ãnz 110.1</ref></char></note>. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Okɔ, ndɛ abesa ɔ̃sal onse mboo yi enduru ɔ̃nsensal, ŋ'ayɛɛn ndiri onse sɛɛ wa taa-taa, wu étuu Mfam, ke baal wɛ.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Ke ngwel wɛ, ngaa-a-Nziã wu ɔ̃nɛn wueel, abesuul ndɛ onse ɔ̃sal a Nziã me ndɔɔ yi abewa Nziã ãkab ye mpɔɔ. Obobɔ, ebvaan hɛ̃ Yeso akal y'eluɔ ki awa Nziã ãkab. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Okɛɛn ndɛ áli me nsie, kɛn ndɛ k'ákaakal si ekal Ngaa-a-Nziã wɛ. Ke ngwel wɛ, me nsie ŋã angaa-a-Nziã ali, b'abewa Nziã ãkab m'emfa ki etam Ngel. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Ɔ̃sal wu ebesa bɔ oli edzel-a-dzel bvool oli emfa ki ãndɔɔ m'ãli ke ywel. Obɔ otsɛn bɛn, ŋ'éketuu Moyize sɛɛ, Nziã áwi ndɛ ãnkunkwa ndiri: «Tal ngesɛ, bvool sa ɔ̃sal wueel, luɛɛn emfa ki nsuo mɛ̃ yɛ ke ywel a nkio<note caller="-" style="x"><char style="xo" closed="false">8.5 </char><char style="xt" closed="false"><ref loc="EXO 25:40">Opa 25.40</ref></char></note>.»<verse eid="HEB 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 8:6" />Kɛn a meba, Yeso oli y'ɔ̃sal wu onduru ɔ̃bvɛn. Ke ngwel wɛ, ndɛ oli mbuul wu abveel ondoo onse Ondoo b'onduru obvie, Ondoo b'átuu ke ywel ãlɔɔ m'ãnduru obvie.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Ke ngwel wɛ, okɛɛn Ondoo b'ɛ̃kwel óywɛn elyal, kɛn Nziã k'ákaaswɛɛl bɔ me bo buaal wɛ. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Ke ngwel wɛ, Nziã áyɛɛn ye baal a ndɛ m'emfa ki owa o mbyel, ŋ'élieel ndɛ ndiri:</para>
  <para style="q1" vid="HEB 8:8">«Mfam olieel ndiri: M'ãtsoo m'ãya,</para>
  <para style="q1" vid="HEB 8:8">mɛ̃ ekieel etɛn Ondoo b'alili</para>
  <para style="q1" vid="HEB 8:8">ye baal b'Isalayel ye ba Yuda.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Bɔ k'òkal onge ondoo b'étɛn mɛ̃ y'ankiɔɔn a bɔ wɛ,</para>
  <para style="q1" vid="HEB 8:9">ŋ'ésiin mɛ̃ bɔ me kuɔɔl me ndɔɔ yi epaal bɔ k'Edzipito,</para>
  <para style="q1" vid="HEB 8:9">me ndɔɔ yɛn bam k'ákuru nzuru m'ondoo o mɛ̃ wɛ,</para>
  <para style="q1" vid="HEB 8:9">mɛ̃ hɛ̃ bu ngiri bɔ, wu ayɛɛn mɛ̃ wu Mfam.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Tal Ondoo b'ekieel etɛn mɛ̃ ye baal b'Isalayel,</para>
  <para style="q1" vid="HEB 8:10">ke mbee ãtsoo omɔ̃, wu ayɛɛn mɛ̃ wu Mfam:</para>
  <para style="q1" vid="HEB 8:10">mɛ̃ ekieel elɔ ãngel ã mɛ̃ onse ãtsam ã bɔ,</para>
  <para style="q1" vid="HEB 8:10">mɛ̃ ekieel epuul mɔ̃ onse ɛ̃kwal ɛ̃ bɔ.</para>
  <para style="q1" vid="HEB 8:10">Mɛ̃ ekieel ekal Nziã a bɔ,</para>
  <para style="q1" vid="HEB 8:10">bvool bɔ akieel akal baal a mɛ̃.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Mbuul si ngɔmɔ̃ bvool kieel k'abetee wumɔ̃ wu ɔ̃kiri a ndɛ wɛ,</para>
  <para style="q1" vid="HEB 8:11">wuo mbuul si ngɔmɔ̃ kieel k'abetee muaan-ngoo a ndɛ wɛ ndiri: “Yio k'ayɛɛ Mfam!”</para>
  <para style="q1" vid="HEB 8:11">Ke ngwel wɛ, bɔ bueel akieel ayɛɛ mɛ̃,</para>
  <para style="q1" vid="HEB 8:11">bɛɛn me wu onduru obwee tiil wu onduru oyal.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Me ndɔɔ yɛn mɛ̃ ekieel edzeel elyal e bɔ, mɛ̃ bvool kieel k'ebeyeel ãbi ã bɔ wɛ<note caller="-" style="x"><char style="xo" closed="false">8.12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Dze 31.31-34</ref></char></note>.»<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />Ŋ'eyɛɛn Nziã me ndɔɔ Ondoo ba m'Ondoo b'«alili», ŋɛn b'ɛ̃kwel oyii bo tsɔɔn. Eluɔ ki eyii ki tsɔɔn bvool ki emeeyal, ŋ'eyii eyi k'odziɔɔn.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">Obuɛɛn onse ondoo b'ɛ̃kwel ye b'alili</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Ondoo b'ɛ̃kwel óli y'ãngel m'ãtal obuɛɛn. Bɔ hɛ̃ óli ye mboo yi ɔ̃nsensal yi me nsie ŋã. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Ke ngwel wɛ, átuu sɛɛ. Onse etswi e ndɛ ki ɛ̃kwel, ki ata me «mboo yi ɔnsensal», éli y'eluɔ ki abendɔɔl ambunda, ye misa, y'amampa b'ákewa Nziã ãkab<note caller="-" style="x"><char style="xo" closed="false">9.2 </char><char style="xt" closed="false"><ref loc="EXO 26:1-30">Opa 26.1-30</ref>; <ref loc="EXO 25:23-40">25.23-40</ref></char></note>. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Ke mbee ekɔ ki enɛn ki bviaal, éli y'etswi ki kikyɛ, ki ata me «mboo yi enduru ɔ̃nsensal»<note caller="-" style="x"><char style="xo" closed="false">9.3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Opa 26.31-33</ref></char></note>. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Onse okɔ, éli ye nkiin yi me ɔɔl yi abetsoo ɔ̃ywiri, ye nkab a ondoo yi ápwɛɛ ɔɔl me yɔ yam yueel. Onse nkab oyɔ, éli ye saan li ɔɔl li álɔ mane<note caller="-" style="x"><char style="xo" closed="false">9.4 </char><char style="xt" closed="false"><ref loc="JHN 6:31">Dzã 6.31</ref>,<ref loc="JHN 6:49">49</ref></char></note>, y'ɔ̃mpaã wu Alona wu ápaal ãnyuɔ̃, y'ãnkɔɔn m'ápuul ãngel m'ondoo<note caller="-" style="x"><char style="xo" closed="false">9.4 </char><char style="xt" closed="false"><ref loc="EXO 16:33">Opa 16.33</ref>; <ref loc="EXO 25:10-16">25.10-16</ref>; <ref loc="EXO 30:1-6">30.1-6</ref>; <ref loc="NUM 17:8-10">Ɛ̃bv 17.8-10</ref>; <ref loc="DEU 10:3-5">Det 10.3-5</ref></char></note>. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Ke ywel a nkab a ondoo, éli y'etiɔ bvi ãnzwel m'ata m'Aswelebɛ̃ ba lweel b'ákesuo kwɛn Nziã áli oŋɔ̃. Edzuun ki ãpab ã mɔ̃ éfoo mboo yi abenzɔɔ ãkel me ndɔɔ odzeel b'ãbi. Kɛn a li ke lio li abɛɛl ãndɔɔ omɔ̃ mbueel wɛ<note caller="-" style="x"><char style="xo" closed="false">9.5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">Opa 25.18-22</ref></char></note>.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Obobɔ, ŋ'ayɛɛl eluɔ obvɛ bvieel, angaa-a-Nziã abvi osam ãlio mbueel onse etswi ki ɛ̃kwel ki sɛɛ, me ndɔɔ yi asa ɛ̃kiri m'obuɛɛn<note caller="-" style="x"><char style="xo" closed="false">9.6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">Ɛ̃bv 18.2-6</ref></char></note>. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Kɛn a ngaa-a-Nziã wu ɔ̃nɛn mbuul wu ákesam k'etswi ki bviaal, sa ngemɔ̃ me mvel. Ŋ'ékesam ndɛ onse okɔ, ndɛ k'ákeywɛn k'abiri ãkel m'anywam m'ékewa ndɛ kab ola Nziã me ndɔɔ elyal e ndyam ye bvi baal wɛ<note caller="-" style="x"><char style="xo" closed="false">9.7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">Lev 16.2-34</ref></char></note>. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Oŋɔ̃ Ɔ̃fel wu Ɔ̃nsensal ŋ'asuo kal-a-kal ndiri, nkuul yi asam onse mboo yi enduru Ɔ̃nsensal ále k'ekoo k'edzweel nzuru kɛn wɛ, ŋ'éli sɛɛ wu ɛ̃kwel kɛn oŋɔ̃. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Ndɔɔ oyɔ eli mboo yi esuo emfa ki ãndɔɔ mã meba. Yɔ esuo kwɛn ãkab y'ãmpɔɔ m'áwi Nziã k'ãkoo k'ãsuul ɛ̃kwal ɛ̃ baal b'abuɛɛn Nziã m'emfa okyɛ ɔ̃koo wɛ. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Omɔ̃ mbueel, eli kɛn ãngel m'ombuul, m'ãtal eluɔ bvi adza, ye bvi anywã, y'ɛ̃kiri mi osuɔɔl o nzuru mi emfa bwɛn emfa. Ɛ̃kiri omyɛ̃ ɛ̃́li y'otsɛn tiil lio li éfaal Nziã ãndɔɔ mbueel.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Kɛn a Mãsia áyi onge Ngaa-a-Nziã wu ɔ̃nɛn me ndɔɔ yi awa bia-byɛ eluɔ bvi émeebɔɔ ndɛ bia-byɛ. Ndɛ ábwel onse sɛɛ wu enduru ɔ̃bvɛn bvool wu enduru k'ali ɔ̃koo, wɛn ke wu átuu me mviɔɔl ɛ̃ baal wɛ, ke wu ɔ̃kiri wu hɛ̃ wɛ. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Ndɛ ásam sa ngemɔ̃ ɔ̃bu onse mboo yi enduru ɔ̃nsensal. Okɔ, ndɛ k'áwi ãkel m'atab wuo m'angwɛmbɛ wɛ, kɛn a ndɛ áwi ãkel ã ndyam. M'emfa okyɛ ki ébɔɔ ndɛ bia-byɛ obvuul b'ɔ̃bu. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Okɛɛn mbuul oyii ye mbiin, angaa-a-Nziã ákenzɔɔ ndɛ ãkel m'antab ye m'angwɛmbɛ b'alam, y'efuru li ɔ̃kal a ngwɛmbɛ wu adziool. M'emfa okyɛ, bɔ ákesuul ndɛ tsɛtsɛ m'otsɛtsɛ bo nzuru.<note caller="-" style="x"><char style="xo" closed="false">9.13 </char><char style="xt" closed="false"><ref loc="LEV 16:15-16">Lev 16.15-16</ref>; <ref loc="NUM 19:9">Ɛ̃bv 19.9</ref>,<ref loc="NUM 19:17-19">17-19</ref></char></note> <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Okɛɛn ãndɔɔ ãli m'emfa okyɛ, bvel-bvel Mãsia me nkuul a Ɔ̃fel wu ɔ̃bu nzal a ɔ̃bu, áwi nzuru a ndɛ ola Nziã me ndyam, onge kab li eywɛn a elyal. Obobɔ, ãkel ã ndɛ ãkieel ãsuɔɔl ɛ̃kwal ɛ̃ bia-byɛ m'ɛ̃sal mi ɛ̃biri k'epfu, kwɛn bia-byɛ ekoo k'esa ɔ̃sal a Nziã wa mwiĩ.<verse eid="HEB 9:14" /></para>
  <para style="s1">Ondoo b'alili b'atɛn m'ãkel ã Mãsia</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Obɔ otsɛn bɛn, Mãsia oli Ɔ̃mveel-Ondoo b'alili. Epfu e ndɛ éyi a baal obvuul m'ãbi m'ési bɔ me lio li éli bɔ ke nsɛn ondoo b'ɛ̃kwel. Obobɔ, bɔ b'éti Nziã mbel akoo k'abɔɔ ɔ̃swal wu ɔ̃bu wu éwi Nziã lɔɔ. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Ke ngwel wɛ, ŋɛn mbuul okel ɔ̃nkaan ndiri mfungetie kieel wu asiil y'ɔ̃swal a ndɛ, ye k'ewal mfungetie ondɛ ɔ̃swal a ndɛ, obvie kɛn wu ákel ɔ̃nkaan okwi. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Ɔ̃nkaan wu esiil mbuul ɛ̃swal akal ye mpɛn kɛn a ŋ'ekwa wu ákel ndɛ. Kɛn a ŋɛn, wu ákel ndɛ kɛn oli mwiĩ, ɔ̃nkaan ondɛ k'akal ye mpɛn wɛ. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Obɔ otsɛn bɛn, ondoo b'ɛ̃kwel ále k'ókoo k'okal ye mpɛn wɛ, okɛɛn ãkel k'átsɔɔn wɛ. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Ke ngwel wɛ, ŋ'éman Moyize k'atsiɔ baal ndɔɔ bwɛn a ndɔɔ yi etam Ngel osa, ndɛ áwel ãkel ã baan b'angwɛmbɛ, ye b'antab y'ãdza, ánzɔɔ mɔ̃ nkal Ɔ̃nkaan ye baal bueel, me nkuul a epuun bvi edzɔpe, y'ekɔ ki lɛ̃ ki bɛ. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Obobɔ, ndɛ áyɛɛn ndiri: «Mã ãkel m'ondoo b'etam Nziã byɛ olweel<note caller="-" style="x"><char style="xo" closed="false">9.20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">Opa 24.6-8</ref></char></note>.» <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Emfa ngemɔ̃ hɛ̃, Moyize ánzɔɔ ãkel omɔ̃ me sɛɛ y'eluɔ bvieel bvi ákesal me bvɛ me ndɔɔ yi abuɛɛn Nziã<note caller="-" style="x"><char style="xo" closed="false">9.21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">Lev 8.15</ref></char></note>. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Ke ngwel wɛ, m'emfa ki etam Ngel, mbiin yueel ambaal yɔ m'ãkel. Okɛɛn ãkel k'ãtsɔɔn wɛ, odzeel hɛ̃ k'oli wɛ<note caller="-" style="x"><char style="xo" closed="false">9.22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">Lev 17.11</ref></char></note>.<verse eid="HEB 9:22" /></para>
  <para style="s">Mãsia ambaal ãbi me kab e ndɛ</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Obobɔ, eluɔ bvi eli edzel-a-dzel e bvi eli ke ywel, ákesuul bvɛ tsɛtsɛ m'ɛ̃kiri omyɛ̃. Emfa kiki hɛ̃ ebvaan kwɛn eluɔ bvam bvi eli ke ywel ekal tsɛtsɛ m'ãmpɔɔ m'ãnduru ɔ̃bvɛn. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Ke ngwel wɛ, Mãsia k'ásam onse mboo yi ɔ̃nsensal yi ási me mviɔɔl ɛ̃ baal wɛ, yi éli kɛn edzel-a-dzel e yɔ-a-yɔ. Kɛn a ndɛ ásam ywel lam, me ndɔɔ yi atɛɛn meba ke nkwel a Nziã me ndɔɔ a bia-byɛ. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Ngaa-a-Nziã wu ɔ̃nɛn ákesam mvel bwɛn mvel onse mboo yi enduru ɔ̃nsensal y'ãkel m'anyam. Kɛn a Mãsia K'asam onse yɔ me ndɔɔ yi awa nzuru a ndɛ me ndyam onge kab nsa bibi wɛ. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Okɛɛn ale k'obobɔ wɛ, kɛn Mãsia ákaamwɛn fool nsa bibi fa obɛɛn b'ɔ̃kiri. Kɛn a meba, me lio li ntɔ, ndɛ omɔɔn sa kɛn a ngemɔ̃, me ndɔɔ yi ambaal ãbi ã baal me kab e ndɛ. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Mbuul ndyam wueel ebvaan akwa sa ngemɔ̃, ke mbee oŋɔ̃, ndɛ abwel k'otsiil b'etsiil Nziã ãndɔɔ ã baal. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Emfa kiki hɛ̃, Mãsia áwi nzuru a ndɛ me ndyam onge kab me ndɔɔ yi ambaal ãbi m'ɔ̃bɔbɔ a baal. Ndɛ akieel amɔɔn li nsa yuaal, ke me ndɔɔ obi wɛ, kɛn a me ndɔɔ yi abvuul b'abekiaal ndɛ.<note caller="-" style="x"><char style="xo" closed="false">9.28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Edz 53.12</ref></char></note><verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Ngel eli kɛn a edzel-a-dzel bvi eluɔ bvi ekieel eya, ke mɔ̃-a-mɔ̃ wɛ. Obɔ otsɛn bɛn, yɔ k'ekoo bam k'esuul baal b'asyal tsotsoo a Nziã akal ɔ̃koo wɛ, onkyam ŋɛn mvel bwɛn a mvel ákewa ãmpɔɔ m'emfa kiki ãlio mbueel. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Okɛɛn Ngel al'ekoo k'esuul baal ɔ̃koo, kɛn etel-nziil, baal b'abewa ãmpɔɔ omɔ̃ ámaayɔɔl mɔ̃ owa, me ndɔɔ yɛn bɔ ol'áyii tsɛtsɛ sa ngelemɔ ɔ̃bu, bvool k'abekal y'ãtsam m'ãbi ã bɔ wɛ. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Ke yam, ãmpɔɔ mã mvel bwɛn a mvel omɔ̃, ákeyeel bɔ ãbi ã bɔ. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Ke ngwel wɛ, ãkel m'alam b'angwɛmbɛ ye m'alam b'antab k'ãkoo bam k'ãmbaal ãbi wɛ.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Obɔ otsɛn bɛn, ŋ'eyi Mãsia m'ɔ̃kiri wu, ndɛ olieel Nziã ndiri:</para>
  <para style="q1" vid="HEB 10:5">«Ãmpɔɔ y'ãkab,</para>
  <para style="q2" vid="HEB 10:5">yɛ k'ádzii mɔ̃ wɛ!</para>
  <para style="q1" vid="HEB 10:5">Ke mboo a mɔ̃,</para>
  <para style="q2" vid="HEB 10:5">yɛ buo mɛ̃ nzuru!<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Onkyam ãmpɔɔ m'ãbedziool mam mbueel y'ãmpɔɔ m'odzeel b'ãbi,</para>
  <para style="q2" vid="HEB 10:6">yɛ hɛ̃ k'ásia mpaa me mɔ̃ wɛ!<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Obobɔ, mɛ̃ ndieel wɛn:</para>
  <para style="q1" vid="HEB 10:7">“Ee Nziã, mɛ̃ bu, mɛ̃ ngyii,</para>
  <para style="q1" vid="HEB 10:7">mɛ̃ ngyii me ndɔɔ yi esa ãndɔɔ m'edzii yɛ,</para>
  <para style="q1" vid="HEB 10:7">m'emfa ki ákel me ndɔɔ a mɛ̃,</para>
  <para style="q1" vid="HEB 10:7">onse Ɔ̃nkaan wa ngel<note caller="-" style="x"><char style="xo" closed="false">10.7 </char><char style="xt" closed="false"><ref loc="PSA 40:7-9">Ãnz 40.7-9</ref></char></note>.”»<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Ŋ'ɛ̃kwel kɛn ndɛ olieel ndiri: «Yɛ ke dzii bvool ke sia mpaa m'ãmpɔɔ y'ãkab wɛ, m'ãmpɔɔ m'ãbedziool mam mbueel wɛ, m'ãmpɔɔ m'odzeel b'ãbi wɛ.» Kwɛn ŋɛn ákewa mɔ̃ m'emfa ki etam Ngel. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Ndɛ bvool olweel ndiri: «Mɛ̃ bu, mɛ̃ ngyi me ndɔɔ yi esa b'edzii yɛ». Ŋɛn ndɛ ombaal emfa ki ɛ̃kwel ki obuɛɛn, bu akiil ki bviaal ke mboo a kyɛ. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Yeso Mãsia osi b'edzii Nziã: Ndɛ owi nzuru a ndɛ me ndyam sa ngemɔ̃ ɔ̃bu. M'emfa okyɛ, bia-byɛ eyii ba ngel.<verse eid="HEB 10:10" /></para>
  <para style="s1">Okal ɔ̃koo me bvoo ye Mãsia</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Ngaa-a-Nziã wueel áketɛɛn tsoo bwɛn a tsoo me ndɔɔ yi asa ɔ̃sal a ndɛ. Ndɛ ákewa ãmpɔɔ mamã nsa bibi, mɛn k'ãkoo bam k'ãmbaal ãbi wɛ<note caller="-" style="x"><char style="xo" closed="false">10.11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">Opa 29.38</ref></char></note>. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Kɛn a Mãsia, ke mbee a ŋ'éwi ndɛ mpɔɔ sa ngemɔ̃ ɔ̃bu me ndɔɔ ãbi, ndɛ ábvi nsɛn me kuɔɔl e Nziã ki elam. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Oŋɔ̃, ndɛ abekiaal tiil tsoo li èsuul Nziã ataal a ndɛ ke nsɛn a ntaã e ndɛ<note caller="-" style="x"><char style="xo" closed="false">10.13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Ãnz 110.1</ref></char></note>. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Ke ngwel wɛ, me mpɔɔ kɛn a ngamɔ̃, Mãsia ámaasuul baal ɔ̃koo ɔ̃bu nzal ɔ̃bu, baal obɔ b'émeesuul ndɛ áyii ba ngel.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Ɔ̃fel wu Ɔ̃nsensal hɛ̃ atsweel bia-byɛ yɔ. Ke ngwel wɛ, ndɛ ŋ'ɛ̃kwel álieel ndiri: <verse eid="HEB 10:15" /><verse number="16" style="v" sid="HEB 10:16" />Mɛ̃ wu Mfam ndieel bubu: «Tal Ondoo b'ekieel etɛn mɛ̃ ye bɔ ke mbee ãtsoo omɔ̃. Mɛ̃ ekieel elɔ ãngel ã mɛ̃ onse ɛ̃kwal ɛ̃ bɔ, mɛ̃ hɛ̃ ekieel epuul mɔ̃ onse ãtsam ã bɔ<note caller="-" style="x"><char style="xo" closed="false">10.16 </char><char style="xt" closed="false"><ref loc="JER 31:33">Dze 31.33</ref></char></note>. <verse eid="HEB 10:16" /><verse number="17" style="v" sid="HEB 10:17" />Mɛ̃ bvool kieel k'ebeyeel ãbi ã bɔ y'elyal e bɔ wɛ<note caller="-" style="x"><char style="xo" closed="false">10.17 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Dze 31.31-34</ref></char></note>.» <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Onge bɛn Nziã odzeel ãbi ã baal ɔ̃bu, otsɛn bvool b'awa ãmpɔɔ me ndɔɔ a ãbi k'obekal wɛ.<verse eid="HEB 10:18" /></para>
  <para style="s">Okal y'osɛ-mwiĩ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Obobɔ, andoo a dzii, bia-byɛ eli y'ãŋã m'esam ɔ̃kwɛɛl pyɛ onse mboo yi enduru ɔ̃nsensal me nkuul a ãkel ã Yeso. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Ndɛ ámaadzweel bia-byɛ nkuul yi enyiɔɔn bvool yi ebiri k'elaã. Ndyam ábwel me yɔ, me nkuul a lido li onse mboo yi enduru ɔ̃nsensal, ŋ'ayɛɛn ndiri nzuru a ndyam. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Bia-byɛ bvool eli ye Ngaa-a-Nziã wu ɔ̃nɛn wu ásuul Mfam a Nzɔ a Nziã. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Obobɔ, esyal tsotsoo a Nziã ɔ̃kwal kal, y'okiool b'ɔ̃koo, y'ɔ̃kwal wa amaasuɔɔl m'ãtsam mbueel m'ãbi-ãbi, ye nzuru yi amaasuɔɔl m'ãdza mã tsɛtsɛ<note caller="-" style="x"><char style="xo" closed="false">10.22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">Lev 8.30</ref>; <ref loc="EZK 36:25">Ezk 36.25</ref></char></note>. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Enɔɔn k'eta kaã e bia-byɛ ke nkwel a Nziã, owɔɔl wɛ, ke ngwel wɛ, Nziã wu áwi bia-byɛ lɔɔ, oli wu obvaan m'okiool. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Bia-byɛ ewuaal a bakyɛ, ewa bakyɛ mpɛn k'ekal onse dzii bvool k'esa ɛ̃sal mi ngesɛ. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Ebee ãbvɔɔn ã bia-byɛ obal, onge b'emeenam bakyɛ obesa. Kɛn bia-byɛ ewɛɛl bakyɛ, onge b'emwɛn byɛ kwɛn tsoo e Mfam eyii tsotsoo.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Ke ngwel wɛ, ke mbee a ŋ'emeeyɛɛ bia-byɛ otaa-taa, okɛɛn bia-byɛ ebesa obi kɛn osa me nkoo, mpɔɔ nkyam bvool k'ebekal wɛ yi embaal ãbi. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Esiil kɛn a k'ekiaal y'ongɛɛ bueel otsiil b'ekieel etsiil Nziã ãndɔɔ ã baal ye mbaa yi kɔɔ-kɔɔ yi ekieel edziool baal b'abee k'alweel ndɛ<note caller="-" style="x"><char style="xo" closed="false">10.27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">Edz 26.11</ref></char></note>. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Okɛɛn mbuul ofel Ngel a Moyize, abebam ndɛ nyiĩ pyɛ, ŋɛn amwɛn buaal wuo atyel atsweel ndiri ndɛ osi obi<note caller="-" style="x"><char style="xo" closed="false">10.28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">Det 17.6</ref>; <ref loc="DEU 19:15">19.15</ref></char></note>. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Oŋɔ̃ etumbu ol'ekal bwɛn ki akieel awa mbuul wu omwɛn Muaan a Nziã ngwel, wu opfiɔɔl ãkel m'ondoo m'ã́mbaal ãbi ã ndɛ, bvool wu otoo Ɔ̃fel wu áyi a ndɛ nyiĩ a Nziã<note caller="-" style="x"><char style="xo" closed="false">10.29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Opa 24.8</ref></char></note>? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Ke ngwel wɛ, bia-byɛ eyɛɛ wu álieel ndiri:</para>
  <para style="q1" vid="HEB 10:30">«Mɛ̃ wu ebveel obi m'obi, mɛ̃ wu èwa furu e ndɔɔ yueel», bvool ndiri:</para>
  <para style="q1" vid="HEB 10:30">«Mfam akieel atsiil ãndɔɔ ã baal a ndɛ<note caller="-" style="x"><char style="xo" closed="false">10.30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">Det 32.35-36</ref></char></note>.»<verse eid="HEB 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 10:31" />Eli ndɔɔ yi ongɛɛ bibi k'abva me mviɔɔl ɛ̃ Nziã wa mwiĩ.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Emeetsam m'ãtsoo m'obɛɛn, mɛn ŋ'édzw eel Nziã byɛ mviil, byɛ ékuru ɛ̃kwal onse ãmpal bibi m'édzwaan a byɛ. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Ke ngwel wɛ, lio likyɛ, áketoo bvool áketuaal byɛ mpal ke mviil ã baal. Lio likyɛ hɛ̃, byɛ ékemwɛn fool bvoo ye baal bakyɛ bɛn áketuaal bɔ mpal yi emfa kiki. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Ke ngwel wɛ, byɛ émwɛn fool bvoo ye baal a bwal, bvool byɛ ékiool kwɛn awɛɛl eluɔ e byɛ y'esɛ kieel, me ndɔɔ yɛn byɛ eyɛɛ wɛn byɛ eli y'opfel b'onduru obvɛn bvool b'ɔ̃bu. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Obobɔ, ebee ãŋã e byɛ oyɔɔl, ke ngwel wɛ furu li enɛn ekuru nzuru me mɔ̃. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Ke ngwel wɛ, ebvaan byɛ ekal y'osɛ-mwiĩ, kwɛn ke mbee a ŋ'esi byɛ b'edzii Nziã, byɛ ebɔɔ ki éwi ndɛ lɔɔ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Ke ngwel wɛ, ákel bubu:</para>
  <para style="q1" vid="HEB 10:37">«Esiil kɛn etsi-tsiri, kyam kɛn etsi-tsiri,</para>
  <para style="q1" vid="HEB 10:37">mbuul wɛn ebvaan aya, àya,</para>
  <para style="q1" vid="HEB 10:37">ndɛ kieel k'ayiil wɛ.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Kɛn a mbuul a mɛ̃ wa dzu akieel akal y'elaã m'okiool.</para>
  <para style="q1" vid="HEB 10:38">Kɛn a ndɛ abvool mbee, mɛ̃ k'èbesia mpaa me ndɛ wɛ<note caller="-" style="x"><char style="xo" closed="false">10.38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">Aba 2.3-4</ref></char></note>.»<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Bia-byɛ, bia-byɛ k'eli m'ɔ̃luo a baal b'abvool mbee kwɛn edziɔɔn wɛ. Kɛn a bia-byɛ eli m'ɔ̃luo a baal b'ali y'okiool, me ndɔɔ yi ebvuul omwiĩ o bia-byɛ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">Okiool o baal ba tsɔɔn-tsɔɔn</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Okiool ŋ'etsam mbuul bam wɛn ndɛ amaabɔɔ eluɔ bvi ebeta ndɛ kaã, eli otsweel b'eluɔ bvɛn k'amwɛn wɛ. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Eli me nkuul a okiool kwɛn Nziã átsweel baal ba tsɔɔn-tsɔɔn.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Eli me nkuul a okiool kwɛn bia-byɛ ekwaal otsɛn wɛn Nziã ási ɔ̃kiri m'Endɔɔ e ndɛ. Obobɔ, eluɔ bvi abemwɛn, ási bvɛ me nkuul a bvɛn k'abemwɛn wɛ<note caller="-" style="x"><char style="xo" closed="false">11.3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Obɛ 1.1</ref>; <ref loc="PSA 33:6">Ãnz 33.6</ref>,<ref loc="PSA 33:9">9</ref></char></note>.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Eli me nkuul a okiool kwɛn Abɛl áwi Nziã mpɔɔ yi enduru yi éwi Kayiin m'ɔ̃bvɛn. M'okiool o ndɛ, Nziã átsweel ndiri ndɛ oli mbuul wa dzu, ke ngwel wɛ Nziã ndyam átsweel kab e ndɛ. M'okiool, Abɛl abeyɛɛn kɛn, onkyam ŋɛn ndɛ ámaakwa<note caller="-" style="x"><char style="xo" closed="false">11.4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">Obɛ 4.3-10</ref></char></note>.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Eli me nkuul a okiool kwɛn Nziã ábiri Enok ola ndɛ wu Nziã, kwɛn ndɛ abee epfu omwɛn. M'emfa okyɛ, k'ámwɛn ndɛ bvool wɛ, me ndɔɔ yɛn Nziã ábiri ndɛ ola ndɛ. Ke ngwel wɛ, ŋ'ɛ̃kwel ye k'ebiri Nziã ndɛ, ndɛ átsweel me ndɔɔ a ndɛ ndiri ndɛ wu Enok ákewa ndɛ esɛ<note caller="-" style="x"><char style="xo" closed="false">11.5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">Obɛ 5.21-24</ref></char></note>. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Kɛn okɛɛn mbuul k'ali y'okiool wɛ, ndɛ k'akoo bam k'awa Nziã esɛ wɛ. Ke ngwel wɛ, mbuul wu asyal tsotsoo a Nziã, ebvaan ndɛ akiool ndiri Nziã oli, bvool ndiri ndɛ abewa baal b'abebii ndɛ furu.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Eli me nkuul a okiool kwɛn, Nowa áyoo ãnkunkwa m'éwi Nziã ndɛ me ndɔɔ a ndɔɔ yi èkeya yɛn ále kɛn amwɛn wɛ. Ndɛ okiool bam ndiri m'ékeyɛɛn Nziã ã́li mã taa-taa. Ndɛ bu atuu ãsua mɛn me mɔ̃ ndɛ obvuul ye yam e ndɛ lueel. M'emfa okyɛ, m'okiool o ndɛ, Nowa ásuo kwɛn baal b'ɔ̃kiri áli onse obi. Bvool m'okiool o ndɛ, Nziã áwel ndɛ onge mbuul wa dzu<note caller="-" style="x"><char style="xo" closed="false">11.7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">Obɛ 6.13-22</ref></char></note>.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Eli me nkuul a okiool kwɛn Abalayam álweel mbel yi éti Nziã ndɛ, ŋ'éyɛn ndɛ ɔ̃kiri wu éwi Nziã ndɛ kwɛn akal wa ndɛ. Ndɛ áyɛn, kwɛn ŋɛn ndɛ k'áyɛɛ ku ékeyi ndɛ wɛ<note caller="-" style="x"><char style="xo" closed="false">11.8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-5">Obɛ 12.1-5</ref></char></note>. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Eli me nkuul a okiool kwɛn ndɛ okal onge ɔ̃nzii onse ɔ̃kiri wu éwi Nziã ndɛ lɔɔ. Ndɛ ákekal onse asɛɛ. Emfa kiki hɛ̃ Isak ye Dzakab ákekal onse asɛɛ onge ndɛ. Bɔ ange-buaal b'áwel ɔ̃swal wa lɔɔ lili li éwi Nziã bɔ<note caller="-" style="x"><char style="xo" closed="false">11.9 </char><char style="xt" closed="false"><ref loc="GEN 35:27">Obɛ 35.27</ref></char></note>. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Ke ngwel wɛ, Abalayam ákebviil bviil li átuu nkal ãnkɔɔn mɛn k'ãtsiɔ̃ wɛ, lɛn Nziã ndyam wu átsam me ndɔɔ emfa ki atuu lɔ, bvool átuu lɔ.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Me nkuul a okiool hɛ̃ Sala ákoo k'abɔɔ ãyam, onkyam ŋɛn ndɛ áli empi, bvool onkyam ŋɛn mvel yɛn ndɛ álekoo k'abva yam álemeebwel. Ke ngwel wɛ, ndɛ ákiool ndiri Nziã wu áwi ndɛ lɔɔ, wu obvaan m'okiool.<note caller="-" style="x"><char style="xo" closed="false">11.11 </char><char style="xt" closed="false"><ref loc="GEN 18:11-14">Obɛ 18.11-14</ref>; <ref loc="GEN 21:2">21.2</ref></char></note> <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Obɔ otsɛn bɛn, me mbuul ngɔmɔ̃, wɛn áleyii ekukwel, swa epfu, áburu ãyam bibi onge angam-a-ngam b'áli ke ywel, onge esɛɛ bvi eli nku-a-nku ãdza m'ɔ̃ngwa, bvɛn k'akoo k'atsiɔ wɛ<note caller="-" style="x"><char style="xo" closed="false">11.12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">Obɛ 15.5</ref>; <ref loc="GEN 22:17">22.17</ref>; <ref loc="GEN 32:12">32.12</ref></char></note>.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Eli onse okiool ku ékwi baal obɔ bueel. Bɔ k'ábɔɔ eluɔ bvi éwi Nziã bɔ lɔɔ wɛ, bɔ ámwɛn bvɛ kɛn a lala, bu esi bɔ esɛ. Bɔ ákiool ke nkwel a baal bueel ndiri bɔ ali anzii bvool ali ɛ̃mbwel-nkuul me nsie ŋã<note caller="-" style="x"><char style="xo" closed="false">11.13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">Obɛ 23.4</ref>; <ref loc="1CH 29:15">1Ãl 29.15</ref>; <ref loc="PSA 39:13">Ãnz 39.13</ref></char></note>. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Ke ngwel wɛ, baal b'abeyɛɛn obobɔ, abesuo kal-a-kal ndiri bɔ abebii ɔ̃kiri a bɔ. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Okɛɛn bɔ b'ákesɛɛn ɔ̃kiri wu éfi bɔ, kɛn bɔ ákaabɔɔ mpwee yi abvool okɔ. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Kɛn a bɔ ákebii ɔ̃kiri wu onduru obvie, ŋ'ayɛɛn ndiri ɔ̃kiri wa ke ywel. Obɔ otsɛn bɛn, Nziã k'ayoo opfuru okɛɛn baal ata ndɛ me «Nziã a bɔ» wɛ, ke ngwel wɛ, ndɛ ámaayɛɛl bɔ bviil.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Eli me nkuul a okiool kwɛn Abalayam áwi Isak onge mpɔɔ, ŋ'ékie Nziã ndɛ. Wu ékewa ndɛ mpɔɔ éli ensuu e ndɛ muaan ngɔ̃mɔ̃ wu bɔɔl, wu éwi Nziã ndɛ lɔɔ<note caller="-" style="x"><char style="xo" closed="false">11.17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Obɛ 22.1-14</ref></char></note>. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Nziã álieel ndɛ ndiri: «Me nkuul a Isak yɛ akieel abɔɔ atiɔɔl<note caller="-" style="x"><char style="xo" closed="false">11.18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">Obɛ 21.12</ref></char></note>.» <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Abalayam áketa kaã ndiri Nziã okoo k'aseel mbuul m'epfu. Obɔ otsɛn bɛn, Nziã ábveel ndɛ muaan: Ndɔɔ oyɔ eli mboo.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Eli me nkuul a okiool kwɛn Isak ándɔɔl Dzakab y'Edzau kuɔɔl me ndɔɔ ãndɔɔ m'ã̀keya ke nkwel<note caller="-" style="x"><char style="xo" closed="false">11.20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">Obɛ 27.27-29</ref>,<ref loc="GEN 27:39-40">39-40</ref></char></note>.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Eli me nkuul a okiool kwɛn Dzakab ándɔɔl baan a Dzedzef ngɔmɔ̃ ngɔmɔ̃ kuɔɔl, ŋ'eyii ekwa ndɛ. Ndɛ ápfɔɔn nkal a nswɛɛ a ɔ̃mpaã a ndɛ<note caller="-" style="x"><char style="xo" closed="false">11.21 </char><char style="xt" closed="false"><ref loc="GEN 47:31-48:20">Obɛ 47.31–48.20</ref></char></note>.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Eli me nkuul a okiool kwɛn Dzedzef, ŋ'eyii ekwa ndɛ, álieel me ndɔɔ a opal o baan b'Isalayel k'Edzipito, bvool átam mɛn ebvaan kieel asa me ndɔɔ ɛ̃ywee ɛ̃ ndɛ<note caller="-" style="x"><char style="xo" closed="false">11.22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">Obɛ 50.24-25</ref>; <ref loc="EXO 13:19">Opa 13.19</ref></char></note>.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Eli me nkuul a okiool kwɛn amburu a Moyize álwɔɔn ndɛ nswii tyel, ke mbee a ŋ'áburu ndɛ. Ke ngwel wɛ, bɔ ámwɛn kwɛn muaan a bɔ áli y'ompal, bvool bɔ k'áyoo buɔ b'afel ngel yi éwi ɔ̃kwɛn wɛ<note caller="-" style="x"><char style="xo" closed="false">11.23 </char><char style="xt" closed="false"><ref loc="EXO 2:2">Opa 2.2</ref>; <ref loc="EXO 1:22">1.22</ref></char></note>.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Eli me nkuul a okiool kwɛn Moyize, ŋ'ékwel ndɛ, ábee kwɛn ata ndɛ me muaan wu bɔɔl a muaan a Falahɔ̃ wu ɔ̃kaal<note caller="-" style="x"><char style="xo" closed="false">11.24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">Opa 2.10-12</ref></char></note>. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Kɛn a ndɛ ásueel kwɛn atuaal ndɛ mpal bvoo ye baal a Nziã, ye k'ekal ndɛ onse osia mpaa b'ãbi bo lio etsi-tsiri. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Ke ngwel wɛ, ndɛ ámwɛn kwɛn, ŋ'apfiɔɔl ndɛ onge b'ápfiɔɔl Mãsia enduru obvie ye k'ebii ndɛ opfel b'Edzipito. Ke ngwel wɛ, ndɛ áketaal furu li ékeya.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Eli me nkuul a okiool kwɛn Moyize ámbal Edzipito, k'ábal mpuru a ɔ̃kwɛn wɛ. Ke ngwel wɛ, ndɛ ásɛn ãnã olɔ yɛɛn wɛn mbuul wu ákemwɛn Nziã wɛn k'abemwɛn wɛ<note caller="-" style="x"><char style="xo" closed="false">11.27 </char><char style="xt" closed="false"><ref loc="EXO 2:15">Opa 2.15</ref></char></note>. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Eli me nkuul a okiool kwɛn ndɛ átam baan b'Isalayel k'abɛɛl pfuun li Onduru bvool k'anzɔɔ ãkel m'ɔ̃nywã a nzɔ, kwɛn ãnzwel m'ãbam ãbee baan b'abɔɔl b'ɛ̃kwel b'Afi-Isalayel obam<note caller="-" style="x"><char style="xo" closed="false">11.28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-30">Opa 12.21-30</ref></char></note>.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Eli me nkuul a okiool kwɛn baal b'Isalayel átsiil ãdza m'ɔ̃ngwa mã bɛ onge nsie yi kɛɛ-kɛɛ. Kɛn a ŋ'ékie baal b'Edzipito k'atsiil onge bɔ, bɔ ádziin<note caller="-" style="x"><char style="xo" closed="false">11.29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">Opa 14.21-31</ref></char></note>.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Eli me nkuul a okiool kwɛn ebɔɔ e bviil e Dzeliko ébvi ke mbee a ŋ'édziɔɔn baan b'Isalayel bviil olɔ ãtsoo nsiaan<note caller="-" style="x"><char style="xo" closed="false">11.30 </char><char style="xt" closed="false"><ref loc="JOS 6:12-21">Dzo 6.12-21</ref></char></note>. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Eli me nkuul a okiool kwɛn, Laab, ɔ̃kaal-nga-esio, k'ákwi bvoo ye baal b'ábee Nziã olweel wɛ. Ke ngwel wɛ, ndɛ áyɔɔ baal b'áyetal Dzeliko m'edziɔɔn ngesɛ<note caller="-" style="x"><char style="xo" closed="false">11.31 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Dzo 2.1-21</ref>; <ref loc="JOS 6:22-25">6.22-25</ref></char></note>.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />B'èyɛɛn mɛ̃ bvool omã? Ke ngwel wɛ, mɛ̃ lio ol'eywɛn li eyɛɛn me ndɔɔ a baal ba m'ɔ̃mɔ̃-ɔ̃mɔ̃: Dzedehɔ̃, ye Balak, ye Samesɔ̃, ye Dzefete, ye David, ye Samuɛɛn, y'aliaal-ɛ̃kiɛɛn a Nziã<note caller="-" style="x"><char style="xo" closed="false">11.32 </char><char style="xt" closed="false"><ref loc="JDG 6:11-8:32">Amb 6.11–8.32</ref>; <ref loc="JDG 4:6-5:31">4.6–5.31</ref>; <ref loc="JDG 13:2-16:31">13.2–16.31</ref>; <ref loc="JDG 11:1-12:7">11.1–12.7</ref>; <ref loc="1SA 16">1Sa 16</ref>; <ref loc="1KI 1:1-2:11">1Ak 1.1–2.11</ref></char></note>. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Eli me nkuul a okiool kwɛn bɔ ábvel eta ke nkwel ãkwɛn bibi. Bɔ ási ãndɔɔ mã dzu, bɔ ábɔɔ eluɔ bvi éwi Nziã bɔ lɔɔ, bɔ ákuru ebob ɛ̃nywã<note caller="-" style="x"><char style="xo" closed="false">11.33 </char><char style="xt" closed="false"><ref loc="DAN 6:1-27">Dan 6.1-27</ref></char></note>. <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />Bɔ ádzeel mbaa yi ékekaan kokɔ, k'ákwi m'epwel wɛ. B'áli y'ãluu, ãnzuru ã bɔ ã́l'ãyii kɛɛ-kɛɛ. Bɔ ásuo mpɛn ŋ'ékedzwaan bɔ eta, bvool ásuul ambwel-mbwel b'anzii ál'áyii abal otsa-otsa ke nkwel a bɔ<note caller="-" style="x"><char style="xo" closed="false">11.34 </char><char style="xt" closed="false"><ref loc="DAN 3:1-30">Dan 3.1-30</ref></char></note>. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Me nkuul a okiool, akaal ámwɛn baal a bɔ b'ámaakwa asiool.</para>
  <para style="p" vid="HEB 11:35">Kɛn átueel baal bakyɛ mpal, bvool bɔ ábee kwɛn abvuul bɔ, me ndɔɔ yɛn bɔ áyɛɛ ndiri bɔ akieel asiool bvool kieel akal y'elaã li enduru obvie<note caller="-" style="x"><char style="xo" closed="false">11.35 </char><char style="xt" closed="false"><ref loc="1KI 17:17-24">1Ak 17.17-24</ref>; <ref loc="2KI 4:25-37">2Ak 4.25-37</ref></char></note>. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Ákesyob bakyɛ, áyuul bɔ asikɔrɔ, ákuru bɔ ebwal bvool áywɛɛn bɔ me bwal.<note caller="-" style="x"><char style="xo" closed="false">11.36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1Ak 22.26-27</ref>; <ref loc="2CH 18:25-26">2Ãl 18.25-26</ref>; <ref loc="JER 20:2">Dze 20.2</ref>; <ref loc="JER 37:15">37.15</ref>; <ref loc="JER 38:6">38.6</ref></char></note> <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Ábam bakyɛ m'ãnkɔɔn, átsiil bakyɛ etswel bviaal me sii, ábam bakyɛ m'epwel. Bɔ ákefa ku ákebwel ku, ákelaal ebaan bvi emɛmɛɛ̃ ye bvi antab, bɔ áywɛn a bvieel, áketuaal bɔ mpal bvool ási kwɛn bɔ amwɛn fool<note caller="-" style="x"><char style="xo" closed="false">11.37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2Ãl 24.21</ref></char></note>. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Ɔ̃kiri k'ábvaan me ndɔɔ a bɔ wɛ. Bɔ ákefa ku ákebwel ku onse ɛ̃baan mi kɛɛ-kɛɛ, onse ãnkio, onse ãywɛn m'onse ãnkɔɔn y'ãmbie.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Bɔ obɔ bueel, onkyam ŋɛn Nziã átsweel bɔ, me ndɔɔ okiool o bɔ, bɔ k'ábɔɔ ki éwi Nziã bɔ lɔɔ wɛ. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Ke ngwel wɛ, Nziã áli y'ɔ̃yɛɛl wu onduru obvie me ndɔɔ a bia-byɛ. Ndɛ ádzii kwɛn bɔ akal ɔ̃koo nkuul mɔ̃ ye bia-byɛ.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Okal y'osɛ-mwiĩ onse ɛ̃mbio</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Me b'otal bia-byɛ, ɔ̃bɔbɔ wu amwɛn adzii bia-byɛ. Bia-byɛ eta eluɔ kieel ki elyam nkal a bia-byɛ pfɛɛ, bvel-bvel obi b'odzii bia-byɛ ɔ̃kwɛɛl pyɛ. M'emfa okyɛ, y'osɛ-mwiĩ bueel tiil ntɔ, bia-byɛ etsuu ntiin yi atam bia-byɛ otsuu, me ndɔɔ yi ebɔɔ ebvakab ki eli ke nkwel a bia-byɛ. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Bia-byɛ ekaal mviil ã bia-byɛ nkal a Yeso. Ndɛ wu odzweel bia-byɛ nkuul a okiool bvool wu asuul bɔ okal ɔ̃koo. Ke mboo yi akiool esɛ ki ásuul ke nkwel a ndɛ, ndɛ okiool epfu li m'enkulusu, k'asiɔɔl opfuru b'epfu li m'emfa okyɛ wɛ. Obɔ otsɛn bɛn meba ŋã, ndɛ obvi nsɛn me kuɔɔl ki elam ki kiri li Okwɛn e Nziã.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Ke ngwel wɛ, emeetsam emfa ki ékuru ndɛ ɔ̃kwal me mpal yi obobɔ yi étueel anga-ãbi ndɛ, kwɛn byɛ ɛ̃furu ɛ̃bee ofa, nzuru ebee osool. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Onse mvel yi ebedzwaan byɛ y'obi, byɛ kɛn edzwaan tiil k'ekiool epfu wɛ. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Byɛ bvool emeedzɛɛn ãyɛɛn m'owɛɛl m'élieel Nziã byɛ onge baan a ndɛ, ndiri:</para>
  <para style="q1" vid="HEB 12:5">«Muaan a mɛ̃, bee etumbu ki ewa Mfam yɛ ngwel owal,</para>
  <para style="q1" vid="HEB 12:5">bvool bee owɔɔl ŋ'ewa ndɛ yɛ mbyel.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Ke ngwel wɛ, Mfam abewa mbuul wu edzii ndɛ etumbu,</para>
  <para style="q1" vid="HEB 12:6">bvool ndɛ abebɛɛl mbuul wueel wu eyɛɛ ndɛ onge muaan a ndɛ<note caller="-" style="x"><char style="xo" closed="false">12.6 </char><char style="xt" closed="false"><ref loc="PRO 3:11-12">Ãmb 3.11-12</ref></char></note>.»<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Fool li ebemwɛn byɛ, me ndɔɔ yɛn abeseel byɛ nkuul. Nziã abewal byɛ onge baan a ndɛ. Ke ngwel wɛ, ondɛ muaan nã wɛn tal k'abeseel nkuul wɛ? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Okɛɛn k'aseel byɛ nkuul onge b'abeseel baan bueel nkuul wɛ, ŋɛn byɛ k'eli baan ba nzɔ wɛ, ŋ'eli ba bal-bal.<verse eid="HEB 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 12:9" />Atal a bia-byɛ me nsie ŋã hɛ̃ ákeseel bia-byɛ nkuul, bvool bia-byɛ ékelweel bɔ. Oŋɔ̃ bvel-bvel ebvaan bia-byɛ elweel Tal a bia-byɛ wa ke ywel, kwɛn bia-byɛ ebɔɔ elaã. <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Ke ngwel wɛ, atal a bia-byɛ ákeseel bia-byɛ nkuul me lio etsi-tsiri, m'emfa ki edzii ɛ̃kwal ɛ̃ bɔ. Kɛn a Nziã abeseel bia-byɛ me ndɔɔ a bvel e bia-byɛ, kwɛn bia-byɛ ekal ansensal onge ndɛ. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Mbuul wu oli y'esɛ ŋ'aseel ndɛ nkuul k'ali wɛ. Ke ngwel wɛ, oseel o nkuul oli ndɔɔ yi ãwua. Kɛn a ke mbee, bɔ osa kwɛn baal b'abɔɔ bɔ akal dzu bvool abɔɔ opi.<verse eid="HEB 12:11" /></para>
  <para style="s">Epfuũ bvi ebvaan me baal a Nziã</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Obɔ otsɛn bɛn, endɛɛl mviɔɔl ɛ̃ byɛ mi ɛ̃mɛɛwɔɔl, bvool ewɛɛl ãbuo ã byɛ m'ãyii ãtiɔɔl<note caller="-" style="x"><char style="xo" closed="false">12.12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">Edz 35.3</ref></char></note>. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Esuul ãnkuul dzu me ndɔɔ a ntaã e byɛ, kwɛn kuul ki edzuu tetɔɔ̃ ebee onyuɔɔn, kɛn a kyɛ ebvuul<note caller="-" style="x"><char style="xo" closed="false">12.13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">Ãmb 4.26</ref></char></note>.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Esa mpɛn k'ekal onse opi ye baal bueel, bvool k'ekal onse onsensal bɛn, bɔ oywɛn, mbuul si ɔ̃mɔ̃ k'àmwɛn Mfam wɛ. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Ekyab kwɛn mbuul si ɔ̃mɔ̃ abee nyiĩ a Nziã oywɛn, bvool kwɛn mbuul si ɔ̃mɔ̃ abee okal onge ɔ̃ti wu ɔ̃bi wa y'ɔ̃twɔɔ, wu amɛn bvool abii ɔ̃bobɔ a baal m'ɔ̃twɔɔ ondɛ<note caller="-" style="x"><char style="xo" closed="false">12.15 </char><char style="xt" closed="false"><ref loc="DEU 29:17">Det 29.17</ref></char></note>.<verse eid="HEB 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 12:16" />Mbuul si ɔ̃mɔ̃ abee ãndɔɔ m'esio osa, wuo abee ãndɔɔ ã Nziã osiaan onge b'ési Edzahu wu átiɔ omfam o ndɛ bo muaan wu ɛ̃kwel me ndɔɔ a bvi-odza bvi lio ngelemɔ̃<note caller="-" style="x"><char style="xo" closed="false">12.16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">Obɛ 25.29-34</ref></char></note>. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Byɛ eyɛɛ ngesɛ wɛn ke mbee oŋɔ̃, ŋ'édzii ndɛ k'abɔɔ ondɔɔl o kuɔɔl o tal, aluo ndɛ bɔ. Ke ngwel wɛ, ndɛ bvool k'ábɔɔ mpwee yi aswɛɛl ãtsam ã tal wɛ, onkyam ŋɛn ndɛ ákebii ondɔɔl o kuɔɔl obɔ y'ãnsia me mviil<note caller="-" style="x"><char style="xo" closed="false">12.17 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">Obɛ 25.29-34</ref>; <ref loc="GEN 27:30-40">27.30-40</ref> </char></note>.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Ke ngwel wɛ, byɛ k'ésyel tsotsoo y'eluɔ kyɛn akoo k'akwaal wɛ, ekal mbaa yi edzio, ekal empeel, ekal tsia, ekal mfel a mpuru<note caller="-" style="x"><char style="xo" closed="false">12.18 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">Opa 19.16-22</ref>; <ref loc="EXO 20:18-21">20.18-21</ref>; <ref loc="DEU 4:11-12">Det 4.11-12</ref>; <ref loc="DEU 5:22-27">5.22-27</ref></char></note>, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ekal obel o mvel-a-mvel, ekal nkii yi eyɛɛn. Ŋ'éyoo baal b'Isalayel nkii oyɔ, bɔ áluɔɔn kwɛn abee bɔ bvool ndɔɔ nkyam obeyɛɛn<note caller="-" style="x"><char style="xo" closed="false">12.19 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">Opa 19.16-22</ref></char></note>. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Ke ngwel wɛ, bɔ ákebal ndɔɔ yi átam osa yi: «Wu anywɛn me nkio, onkyam nyam, abam ndɛ m'ãnkɔɔn<note caller="-" style="x"><char style="xo" closed="false">12.20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">Opa 19.12-13</ref></char></note>.» <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Ãndɔɔ m'émwɛn bɔ anduru ongɛɛ, Moyize bu alieel ndiri: «Mɛ̃ ndi ye buɔ y'etiɔɔl lueel<note caller="-" style="x"><char style="xo" closed="false">12.21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">Det 9.19</ref></char></note>.»<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Kɛn a byɛ esyel tsotsoo ye nkio yi Siɔ̃, bviil e Nziã wa mwiĩ, Yelusalem wa ywel, y'ɔ̃bobɔ wu ãnzwel ã ndɛ m'ãli onse obvɔɔn bo pfuun. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Byɛ esyel tsotsoo y'obvɔɔn bo pfuun bo baan a Nziã b'ɛ̃kwel bɛn ãnkuũ ã bɔ ámaaswɛn ke ywel. Byɛ esyel tsotsoo ye Nziã, Ntwel wu atsiil ãndɔɔ ã baal bueel, y'ɛ̃fel ɛ̃ baal ba dzu b'ayii ɔ̃koo. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Byɛ esyel tsotsoo a Yeso wu oli ɔmveel-Ondoo b'alili, bvool tsotsoo y'ãkel ã ndɛ m'ã́tsɔɔn, ãkel m'ãbeyɛɛn ngesɛ ãnduru m'Abɛl<note caller="-" style="x"><char style="xo" closed="false">12.24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">Obɛ 4.10</ref></char></note>.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Ekyab kwɛn wu ayɛɛn ye byɛ, byɛ ebee ãndɔɔ ã ndɛ obee! Ke ngwel wɛ, okɛɛn bɔ obɔ k'áywɛn a k'abɔɔ etumbu ŋ'ébee bɔ k'ayoo ndɛ wu ákewa bɔ ãnkunkwa me nsie wɛ, emfa emã kyɛn bia-byɛ ol'eywɛn etumbu okɛɛn bia-byɛ ebee k'eyoo ndɛ wu awa bia-byɛ ãnkunkwa fa ywel<note caller="-" style="x"><char style="xo" closed="false">12.25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">Opa 20.22</ref></char></note>? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Ndɛ wɛn ete-nziil nkii a ndɛ énziool nsie, meba ŋã ndɛ awa lɔɔ li: «Sa ngemɔ̃ bvool, mɛ̃ kieel bvool k'enziool kɛn a nsie wɛ, mɛ̃ kieel enziool ywel hɛ̃<note caller="-" style="x"><char style="xo" closed="false">12.26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Adz 2.6</ref> </char></note>.» <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Ãyɛɛn mã, «sa ngemɔ̃ bvool», ŋ'esuo kal-a-kal wɛn eluɔ bvi ɔ̃kiri bvi ábuo bvɛn ekoo k'enziool ekieel edziɔɔn, kwɛn bvɛn k'enziool wɛ ekal ɔ̃bu.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Obɔbɔ, oŋɔ̃ bɛn bia-byɛ ebɔɔ Okwɛn bɛn k'onziool wɛ, ebveel Nziã ãtuɛɛn bvool esa ɔ̃sal a ndɛ m'emfa ki edzii ndɛ, ye dzuun y'okuru o nzuru me ndɛ. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Ke ngwel wɛ, Nziã a bia-byɛ oli mbaa yi edziool eluɔ<note caller="-" style="x"><char style="xo" closed="false">12.29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">Det 4.24</ref></char></note>.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Ãluo m'emfa bwɛn a emfa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Yɔɔl kwɛn dzii li baan a Nziã ekal kɛn okal onse byɛ! <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Ebee odzɛɛn k'eyɔɔ baal b'aya ola byɛ ngesɛ. Ke ngwel wɛ, baal b'ási obobɔ áyɔɔ ãnzwel ola bɔ, kɛn a bɔ k'áyɛɛ wɛn éli ãnzwel wɛ<note caller="-" style="x"><char style="xo" closed="false">13.2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">Obɛ 18.1-8</ref>; <ref loc="GEN 19:1-3">19.1-3</ref></char></note>. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Etsam me baal b'ali onse bwal, olɔ yɛɛn wɛn byɛ hɛ̃ eli onse bwal onge bɔ. Etsam hɛ̃ me baal b'abetuaal mpal, ke ngwel wɛ byam hɛ̃ eli ye nzuru yɛn ekoo k'emwɛn fool.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Yɔɔl kwɛn mbuul wueel awal bal ye dzuun! Yɔɔl kwɛn ɔ̃kal y'ɔ̃lam akuru nzuru me bakyɛ. Ke ngwel wɛ, Nziã àwa etumbu me baal b'asa ãndɔɔ m'esio ye b'adzuu y'anga-akal wuo anga-alam.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Yɔɔl kwɛn nzal o nzi obee y'okwɛn okal nkal a byɛ. Ekal y'esɛ m'eluɔ bvi eli a byɛ. Ke ngwel wɛ, Nziã ndyam álieel ndiri: «Mɛ̃ k'èsiil yɛ bam wɛ, mɛ̃ hɛ̃ k'èyiri yɛ bam wɛ<note caller="-" style="x"><char style="xo" closed="false">13.5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Det 31.6</ref>,<ref loc="DEU 31:8">8</ref>; <ref loc="JOS 1:5">Dzo 1.5</ref></char></note>.» <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Obɔ otsɛn bɛn, bia-byɛ ekoo k'eyɛɛn y'ãŋã mbueel ndiri:</para>
  <para style="q1" vid="HEB 13:6">«Mfam oli ɔ̃wuaal a mɛ̃,</para>
  <para style="q1" vid="HEB 13:6">mɛ̃ ke ndi ye ndɔɔ yi ebal wɛ.</para>
  <para style="q1" vid="HEB 13:6">Yi èsa mbuul mɛ̃ mã<note caller="-" style="x"><char style="xo" closed="false">13.6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">Ãnz 118.6</ref></char></note>?»<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Etsam m'ambiri a byɛ, b'átee byɛ Endɔɔ e Nziã. Etsam epfuũ bvi éli a bɔ y'emfa ki ésɛn bɔ. Obobɔ, enɔɔn a okiool o bɔ. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yeso Mãsia oli ndɛ wuwu, ãtsio, nonɔ̃ bvool ɔ̃bu. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Baal abee byɛ opfuru m'ãtee ãkyam m'emfa bwɛn emfa m'ãkam y'okiool o bia-byɛ. Ke ngwel wɛ, eli ngesɛ kwɛn ɛ̃kwal ɛ̃ bia-byɛ ɛ̃wam me nkuul a nyiĩ a Nzia, ke m'olweel b'ãngel m'ãtal bvi-odza wɛ, ãngel mɛn bvel pyɛ me b'abekiaal mɔ̃<note caller="-" style="x"><char style="xo" closed="false">13.9 </char><char style="xt" closed="false"><ref loc="ROM 14:2-23">Lom 14.2-23</ref>; <ref loc="1CO 8:8">1Ko 8.8</ref></char></note>.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Bia-byɛ eli ye nkiin yi awa Nziã ãmpɔɔ yɛn angaa-a-Nziã b'asal onse sɛɛ k'akoo k'adza bvi-odza e yɔ wɛ. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Ke ngwel wɛ, ãkel m'anyam m'abewa ãmpɔɔ me ndɔɔ odzeel b'ãbi, ngaa-a-Nziã wu ɔ̃nɛn abebiri mɔ̃ onse mboo yi enduru ɔ̃nsensal. Kɛn tuo li anyam obɔ, ákepaal lɔ onse bviil, bu atsoo lɔ mbaa<note caller="-" style="x"><char style="xo" closed="false">13.11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">Lev 16.27</ref></char></note>. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Obɔ otsɛn bɛn, Yeso hɛ̃ apal ye ndɛ onse bviil, bu ayebam ndɛ, kwɛn baal akal ba ngel m'ãkel ã ndyam. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Obobɔ, bia-byɛ hɛ̃ epal onse bviil, eyi ola ndɛ, ekiool k'eyoo opfuru b'éyoo ndɛ. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Ke ngwel wɛ, bia-byɛ k'eli y'ola b'ɔ̃bu me nsie ŋã wɛ. Kɛn a bia-byɛ ebebii ola b'òya. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Obobɔ, yɔɔl kwɛn, me nkuul a Yeso, lio lam lueel, bia-byɛ ewa Nziã mpɔɔ yi elweel ndɛ, ŋ'ayɛɛn ndiri, eyam ãnziĩ m'ãlweel nkuũ a ndɛ ke nkwel a baal bueel. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Kɛn ebee odzɛɛn k'esa ãndɔɔ mã ngesɛ ye k'ewuaal a bakyɛ. Ke ngwel wɛ, omɔ̃ eli ãmpɔɔ m'ãsa Nziã esɛ.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Elweel ambiri a byɛ bvool esa ãndɔɔ m'etam bɔ byɛ osa. Ke ngwel wɛ, bɔ abekyab nkal ɛ̃fel ɛ̃ byɛ, bvool ebvaan bɔ asuo Nziã emfa ki esi bɔ ɔ̃sal a bɔ. Esa kwɛn bɔ asa ɔ̃sal ondɛ y'esɛ, k'onse ɛ̃nduɔɔl wɛ. Okɛɛn k'obobɔ wɛ, ndɛ k'akal ye bvel si ngemɔ̃ me ndɔɔ a byɛ wɛ.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Ebuɛɛn me ndɔɔ a bee. Ke ngwel wɛ, bee ekiool bam wɛn, ãtsam ã bee ãli tsɛtsɛ, bvool bee edzii k'ekal y'epfuũ bvi ngesɛ m'ãndɔɔ mbueel. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Mɛ̃ eluɔɔn byɛ bam k'esa obobɔ, kwɛn Nziã awa mɛ̃ nkuul yi ebvool mɛ̃ ola byɛ tswa-a-tswa.<verse eid="HEB 13:19" /></para>
  <para style="s">Ebuɛɛn</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Yɔɔl kwɛn Nziã-Nga-Opi wu áseel onse b'ákwi-ákwi Ɔ̃nkiaal a emɛmɛ̃ wu ɔ̃nɛn, Mfam a bia-byɛ Yeso, m'ãkel m'Ondoo b'ɔ̃bu, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />asuul byɛ ekoo k'esa ãndɔɔ mbueel mã ngesɛ, kwɛn byɛ esa b'edzii ndɛ. Yɔɔl kwɛn ndɛ bvool asa onse bia-byɛ ãndɔɔ mbueel m'ãsa ndɛ esɛ me nkuul a Yeso Mãsia. Yɔɔl kwɛn lweel ekal li ndɛ ɔ̃bu nzal ɔ̃bu! Amɛn!<verse eid="HEB 13:21" /></para>
  <para style="s1">Ɔ̃lɛɛl y'ãndɔɔ mã ntɔ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Andoo, mɛ̃ nswɛn byɛ ãndɔɔ mã me ndɔɔ yi ewɛɛl byɛ. Mɛ̃ nduɔɔn byɛ k'ekuru ɛ̃kwal me ndɔɔ a mɔ̃. Mɔ̃ k'ãli bibi wɛ. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Eyɛɛ wɛn ndoo a bia-byɛ Timote amaapal onse bwal. Ŋɛn ndɛ otɔ ŋã tswa-a-tswa, mɛ̃ èyetal byɛ ye ndɛ.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Ebio ambiri a byɛ bueel ye baal ba ngel bueel. Andoo b'afi ɔ̃kiri wu Itali abio byɛ hɛ̃.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Yɔɔl kwɛn Nziã asio byɛ bueel nyiĩ!<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>