<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id" />
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">श्रेष्ठगीत</para>
  <para style="toc1">श्रेष्ठगीत</para>
  <para style="toc2">श्रेष्ठगीत</para>
  <para style="toc3">श्रेष्ठ.</para>
  <para style="mt">श्रेष्ठगीत</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">श्रेष्ठगीत किताबरे पेइले वचन सेइं पतो च़लते कि इन गीत कौन ज़ोते। “श्रेष्ठगीत ज़ैन सुलैमानेरू आहे” (<char style="xt"><ref loc="SNG 1:1">श्रेष्ठ. 1:1</ref></char>) इस किताबरे विषयन मां सुलैमानेरू नवं मैलते किजोकि पूरी किताबी मां तैसेरे नंव्वेरे बारे मां ज़िक्र आहे।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग 971-965 ई. पू.</para>
  <para style="ip">ई किताब सुलैमाने इस्राएले पुड़ अपने राज़ केरनेरे वक्ते मां लिखोरी थी। विद्वान सुलैमाने इस किताबरो लिखने बालो मनतन कि इन गीत तैसेरे राज़ केरनेरे वक्तेरे शुरू मां लिखोरू थियूं। कविता मां ज़ै जोश आहे तैसेरे हिस्सेरे वजाई सेइं नईं पन एल्हेरेलेइ भी कि लिखनेबाले मुल्खेरे उत्तरी ते दक्षिणी दूईये पासेरे ठारां केरां नंव्वां केरो ज़िक्र कियो जेवरोए ते लबानोन ते मिस्रेरे नंव्वां केरि चर्चा की जेवरीए।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">ज़ैना ड्लाहेरे बारे मां सोचतन चाहे ज़ैनेईं ड्लाह बनेवरो भोए या न भोए बनेवरो।</para>
  <para style="is">मकसद</para>
  <para style="ip">श्रेष्ठगीत अक कविता आहे ज़ै प्यारे सेइं भलियाई ते बडीयाई केरतीए ते साफ तरीके ड्लाहे परमेशरेरो कानून मनतीए। कौन्श ते मड़दे ड्लाहेरी हद्दी मां रानू ज़रूरीए ते एक्‍की होरि सेइं साथी आत्मिक ते जिसमानी प्यार रखनोए।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">प्यार ते ड्लाह</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. लाड़ी सुलैमानेरे बारे मां सोचतीए <char style="ior"><ref loc="SNG 1:1-3:5">1:1—3:5</ref> </char></para>
  <para style="io1">2. लाड़ी बन्धू कबूल केरतां ड्लाहेरे इंतज़ारे मां आहे <char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref></char></para>
  <para style="io1">3. लाड़ी लाड़े करां बेपरवाह भोनेरो खियाल केरतीए <char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref> </char></para>
  <para style="io1">4. लाड़ो ते लाड़ी एक्‍की होरेरी तारीफ़ केरतन <char style="ior"><ref loc="SNG 6:4-8:14">6:4—8:14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />सुलैमानेरां गीतां इना आन।</para>
  <para style="s" vid="SNG 1:1">पेइलू गीत</para>
  <para style="p" vid="SNG 1:1">
    <char style="k">लाड़ी</char><verse eid="SNG 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />अपने ओठन सेइं तू मीं फुम्मड़ी दे!</para>
  <para style="q" vid="SNG 1:2">किजोकि तेरो प्यार दाछ़रे रस्से करां जादे रोड़ोए।<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />तेरे किसमां-किसमां केरे इत्रेरी खुशबू बड़ी रोड़ीए।</para>
  <para style="q" vid="SNG 1:3">तेरू नवं<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">नवं </char><char style="ft" closed="false">आदर</char></note> उलटावरे इत्रेरू ज़ेरू आहे,</para>
  <para style="q" vid="SNG 1:3">एल्हेरेलेइ कुइयां तीं सेइं प्यार केरतिन।<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />मीं एप्पु सेइं साथी ने, अस अकोट्ठे तीं पत्ती दौड़मेले,</para>
  <para style="q" vid="SNG 1:4">राज़े अवं अपने मेहले मां आनोरी आईं,</para>
  <para style="q" vid="SNG 1:4">अस तीं मां खुश ते मघन भोल्हे;</para>
  <para style="q" vid="SNG 1:4">असां दाछ़रे रस्से करां जादे तेरे प्यारेरी चर्चा केरमेली।</para>
  <para style="q" vid="SNG 1:4">तैना ठीक तींए सेइं प्यार केरचन।<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="HOS 11:4">होश. 11:4</ref>;<ref loc="PHP 3:1-12">फिल. 3:1-12</ref>;<ref loc="PSA 45:14">भज. 45:14</ref>. </char></note><verse eid="SNG 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />हे यरूशलेम नगरेरी कुइयव,</para>
  <para style="q" vid="SNG 1:5">अवं काली त आईं पन हेरनी रोड़ी आईं,</para>
  <para style="q" vid="SNG 1:5">केदारेरे तेम्बु केरि ज़ेरि</para>
  <para style="q" vid="SNG 1:5">ते सुलैमानेरे पड़दां केरि ज़ेरि आईं।<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />मीं एल्हेरेलेइ न तक कि अवं काली आईं,</para>
  <para style="q" vid="SNG 1:6">किजोकि अवं धुप्पी सेइं फुकोई जेवरी आईं।</para>
  <para style="q" vid="SNG 1:6">मेरे ढ्ला मीं पुड़ खुशी न थिये,</para>
  <para style="q" vid="SNG 1:6">तैनेईं अवं दाछ़री बागां केरि रखवाली केरनेबाली बनेवरी आईं।</para>
  <para style="q" vid="SNG 1:6">पन मीं अपने दाछ़री बागरी हेरगेश न की।<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />अवं तीं सेइं प्यार केरचां मीं सेइं ज़ो,</para>
  <para style="q" vid="SNG 1:7">कि तू अपना गब्बां कोड़ि च़ारतस,</para>
  <para style="q" vid="SNG 1:7">ते तैन दुपहरां केरे मौके कोड़ि बिशालतस;</para>
  <para style="q" vid="SNG 1:7">अवं तेरे सैथी केरे गब्बन कां</para>
  <para style="q" vid="SNG 1:7">झुन्ढ छ़ेडतां किजो भेटकी।</para>
  <para style="s" vid="SNG 1:7">ट्लारेरी बिनती</para>
  <para style="p" vid="SNG 1:7">
    <char style="k">लाड़ो</char><verse eid="SNG 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />हे कौन्शन मां खूबसूरत, अगर तू न ज़ानती भोस</para>
  <para style="q" vid="SNG 1:8">त तू गब्बां केरे रौन्ने केरे निशानन पुड़ च़ल,</para>
  <para style="q" vid="SNG 1:8">ते पुहालां केरे डेरन कां, अपने छ़ेल्‍ली केरे बच्‍चे च़ार।<verse eid="SNG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />हे मेरी ट्लारी मीं तेरी तुलना</para>
  <para style="q" vid="SNG 1:9">फ़िरौनेरे रथ्थन सेइं जोट्लोरे घोड़ी सेइं कियोरीए।<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2CH 1:16">2 इति. 1:16</ref>.</char></note><verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />तेरी खैखोड़ी बालन मां खूब रोड़ी लेइहोतिन,</para>
  <para style="q" vid="SNG 1:10">ते तेरू गल हीरां केरे लेड़ी केरे दरमियान।</para>
  <para style="p" vid="SNG 1:10">
    <char style="k">लाड़ी</char><verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />असां तेरे लेई सोन्नेरे हार बनामेले, ते तैन मां चैंदरां फूड़ू लामेले।<verse eid="SNG 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />ज़ैखन राज़ो अपने मेज़े कां बिशोरो थियो,</para>
  <para style="q" vid="SNG 1:12">मेरे जटामासी एरी खुशबू फैली राहोरी थी।<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />मेरो प्यार केरनेबालो मेरे लेई लोबानेरे थेलारो ज़ेरोए,</para>
  <para style="q" vid="SNG 1:13">ज़ै मेरी छैती मां बस्सोरो रहते।<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />मेरो ट्लारो मेरे लेई मींधरे फूड़ू केरे गुच्छेरो ज़ेरोए,</para>
  <para style="q" vid="SNG 1:14">ज़ै एनगदी नंव्वेरे बागी मां भोते।</para>
  <para style="p" vid="SNG 1:14">
    <char style="k">लाड़ो</char><verse eid="SNG 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />हे मेरी ट्लारी, तू केत्री खूबसूरत आस, हेर तू केत्री खूबसूरत आस</para>
  <para style="q" vid="SNG 1:15">तेरी एछ़्छ़ी कबूतरेरी ज़ेरिन।</para>
  <para style="p" vid="SNG 1:15">
    <char style="k">लाड़ी</char><verse eid="SNG 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />हे मेरे ट्लारा तू केत्रो मने पसंद एजनेबालो आस,</para>
  <para style="q" vid="SNG 1:16">ते इश्शू बिछ़ान भी सब्ज़ आहे;<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />इश्शे घरेरे पट्टे गैइड़ेरे आन,</para>
  <para style="q" vid="SNG 1:17">ते इश्शी घरेरी छतरी केड़ी सनोवर बुट्टेरी आन।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />अवं शारोनेरो गुलाब आईं,</para>
  <para style="q" vid="SNG 2:1">ते वैदी केरे सोसनेरू फूड़ोंव आईं।</para>
  <para style="p" vid="SNG 2:1">
    <char style="k">लाड़ो</char><verse eid="SNG 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />ज़ेन्च़रे सोसनेरू फूड़ोंव कंटन मां,</para>
  <para style="q" vid="SNG 2:2">तेन्च़रे मेरी ट्लारी जुवाना केरे दरमियाने मांए।</para>
  <para style="p" vid="SNG 2:2">
    <char style="k">लाड़ी</char><verse eid="SNG 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />ज़ेन्च़रे च़ोइयां केरो बुट जंगलेरे बुट्टन मांए,</para>
  <para style="q" vid="SNG 2:3">तेन्च़रे मेरो ट्लारो जुवाना केरे दरमियाने,</para>
  <para style="q" vid="SNG 2:3">अवं तैसेरी छावी मां बिशतां खुश भोइतां बिश्शी,</para>
  <para style="q" vid="SNG 2:3">ते तैसेरो फल मीं खाने मां मिट्ठो लग्गो।<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="REV 22:1-2">प्रका. 22:1-2</ref>.</char></note><verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />तैनी अवं धांमरे घरे मां आनी,</para>
  <para style="q" vid="SNG 2:4">ते तैसेरे प्यारेरो झण्डो मेरे दोग्गे पुड़ फिरतो थियो।<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />मीं किशमिश खुवेइतां सम्भाला, च़ोइयां खुवेइतां ताज़गी देथ:</para>
  <para style="q" vid="SNG 2:5">किजोकि मीं प्यारेरो रोग लगोरोए।<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />कधी एरू भोथू, तैसेरो बांओ हथ मेरे क्रोड़ी करां बुन,</para>
  <para style="q" vid="SNG 2:6">ते तैसेरो देइने हथ मीं गले लाए।<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />हे यरूशलेमेरी कौन्शव, अवं तुसन सेइं चिकारी</para>
  <para style="q" vid="SNG 2:7">ते मैइदानेरी हिरनी केरि कसम देइतां ज़ोतीं,</para>
  <para style="q" vid="SNG 2:7">कि ज़ांतगर तै एप्पु न उठनू चाए, तांतगर तैस न उकसाथ ते न बींझ़ाथ?</para>
  <para style="q" vid="SNG 2:7">ज़ांतगर तै एप्पु उठनू न चाहे।</para>
  <para style="s" vid="SNG 2:7">दूइयोवं गीत</para>
  <para style="p" vid="SNG 2:7">
    <char style="k">लाड़ी</char><verse eid="SNG 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />मेरे ट्लारेरी आवाज़ शुनोतीए!</para>
  <para style="q" vid="SNG 2:8">हेरा, तै पहाड़न पुड़ दौड़तो ते छालां मारतो एइते।<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />मेरो ट्लारो चिकारे या जुवान हिरनेरो ज़ेरोए,</para>
  <para style="q" vid="SNG 2:9">हेरा, तै इश्शे दिवारी पत्र खड़ोए,</para>
  <para style="q" vid="SNG 2:9">तै दैरी केरे पासे तेक्‍की राहोरोए,</para>
  <para style="q" vid="SNG 2:9">ते तै दैरन मरां तकने लगोरोए।<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />मेरो ट्लारो मीं सेइं ज़ोई राहोरोए,</para>
  <para style="p" vid="SNG 2:10">
    <char style="k">लाड़ो</char></para>
  <para style="q" vid="SNG 2:10">“हे मेरी ट्लारी, हे मेरी खूबसूरत खड़ी उठतां च़ली एई:<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />किजोकि हेर, ठंढारो मौसम खतम भोवरोए;</para>
  <para style="q" vid="SNG 2:11">झ़ड़ी भी खेड़ोरीए, ते बरसांतरो मौसम भी खतम भोवरोए।<verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />ज़मीनी पुड़ फूड़ू केरी बहारे, ते</para>
  <para style="q" vid="SNG 2:12">च़ुड़ोलू केरो गीतां ज़ोनेरो मौसम भी एज्जी राहोरोए,</para>
  <para style="q" vid="SNG 2:12">ते इश्शी ज़मीनी मां कबूतरां केरि आवाज़ शुनोने लगोरीए।<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />फैगू केरे बुट्टन पुड़ फैगू केरे दाने पकने लगोरेन,</para>
  <para style="q" vid="SNG 2:13">ते दाछ़ां फुल्‍लने लेगोरिन;</para>
  <para style="q" vid="SNG 2:13">तैना खुशबू देने लेवरिन</para>
  <para style="q" vid="SNG 2:13">हे मेरी ट्लारी, हे मेरी खूबसूरत, उट्ठतां च़ली एई।<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />हे मेरी कबूतरी, पहाड़ां केरि दरज़न मां ते शफड़ां केरि आड़ी मां मीं अपनि शकल हिरा,</para>
  <para style="q" vid="SNG 2:14">ते मीं अपनि आवाज़ शुन्ने दे</para>
  <para style="q" vid="SNG 2:14">किजोकि तेरी आवाज़ मिट्ठी आहे, ते तेरू तुत्तर खूब रोड़ू आहे।<verse eid="SNG 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />इश्शे लेई तैना निक्‍की लोई ट्लाथ ज़ैना बागन बरबाद केरतिन,</para>
  <para style="q" vid="SNG 2:15">किजोकि इश्शे बागन मां फूड़ू फुलोरन।”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="PSA 80:8-13">भज. 80:8-13</ref>;<ref loc="EZK 13:4">यहे. 13:4</ref>.</char></note></para>
  <para style="p" vid="SNG 2:15">
    <char style="k">लाड़ी</char><verse eid="SNG 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />मेरो ट्लारो मेरोए, ते अवं तैसेरी आईं,</para>
  <para style="q" vid="SNG 2:16">तै सोसनेरे फूड़न मां अपना गब्बां च़ारते।<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />ज़ांतगर दिहाड़ी न डुब्बे ते छाव लम्मी भोते-भोते मिटी न गाए,</para>
  <para style="q" vid="SNG 2:17">तांतगर हे मेरा ट्लारा तैस चिकारे या जुवान हिरनेरो ज़ेरो बन।</para>
  <para style="q" vid="SNG 2:17">ज़ै बेतेरेरे पहाड़न पुड़ फिरते।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="s">बेचैनी बाली रात</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />मीं सैरी राती तै अपने बिछ़ाने पुड़ तोप्पो ज़ैस सेइं मेरो दिल प्यार केरते,</para>
  <para style="q" vid="SNG 3:1">मीं तैसेरी</para>
  <para style="q" vid="SNG 3:1">तलाश की पन तै न मैल्हो;<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="ISA 3:1">यशा. 3:1</ref>. </char></note><verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />“मीं ज़ोवं, हुनी अवं झ़ेझ़ां उठतां नगरे मां गेइतां हेंठतां फिरतां तोप्पेली।”</para>
  <para style="q" vid="SNG 3:2">बज़ारां केरि गेलन मां अवं तैस तोप्पेली ज़ैस सेइं मेरो दिल प्यार केरते,</para>
  <para style="q" vid="SNG 3:2">मीं तै तोप्पो पन तै न मैल्हो।<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />पहरदार ज़ैना नगरे मां घुमते थिये, तैना मीं मैल्हे,</para>
  <para style="q" vid="SNG 3:3">मीं तैन पुछ़ू, “कुन तुसेईं तै लाहोरोए, ज़ैस सेइं मेरो दिल प्यार केरते?”<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />मीं तैन करां अग्रोवं च़लोरे थोड़ू च़िर भोवरू थियूं,</para>
  <para style="q" vid="SNG 3:4">ते तै, ज़ैस सेइं मेरो दिल प्यार केरते, मीं मैल्ही जेव,</para>
  <para style="q" vid="SNG 3:4">मीं तै ट्लातो ते नशने न दित्तो</para>
  <para style="q" vid="SNG 3:4">ज़ांतगर मीं तै एपनी अम्मरे घरे यानी ज़ैड़ी अवं ज़र्मोरी थी।<verse eid="SNG 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />हे यरूशलेमेरी कुइयव, अवं तुसन चिकारी</para>
  <para style="q" vid="SNG 3:5">ते मैइदानेरी हिरनी केरि कसम देचाईं,</para>
  <para style="q" vid="SNG 3:5">कि ज़ैखन तगर प्यार एप्पु न उट्ठे,</para>
  <para style="q" vid="SNG 3:5">तांतगर तै एप्पु न उकसाथ ते न बींझ़ाथ।</para>
  <para style="s" vid="SNG 3:5">ट्लेइयोवं गीत</para>
  <para style="p" vid="SNG 3:5">
    <char style="k">लाड़ी</char><verse eid="SNG 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />एन कुने ज़ैन तूएरे खम्भेरू ज़ेरू,</para>
  <para style="q" vid="SNG 3:6">गन्धरस ते लोबाने सेइं खुशबूदार,</para>
  <para style="q" vid="SNG 3:6">ते बुपैरेरी सब किसमां केरि लेप लेइतां</para>
  <para style="q" vid="SNG 3:6">जंगले मरां निस्तां एइतिन?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />हेरा, ऐह सुलैमानेरी पालके!</para>
  <para style="q" vid="SNG 3:7">तैसारे च़ेवरे पासन इस्राएलेरे जंगी मड़दन मरां शठ जुवान साथीन।<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />तैना सब तलवार च़लानेबाले, ते सब जंगी मां माहिरन।</para>
  <para style="q" vid="SNG 3:8">राती हमलेरे डरे सेइं हर मड़देरे ज़ंघी पुड़ तलवार लटकावरी आहे।<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />सुलैमान राज़े अपने लेई अक पालक बनावाई, तैनी तै लबानोनेरी लेकड़री बनेवरी थी।<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />तैसारे डण्डे चैंदरे थिये, ते तैसारो शिरहानो सोन्नेरो थियो,</para>
  <para style="q" vid="SNG 3:10">ते तैसारी गद्दी बैंगनी रंगेरी बनावाई,</para>
  <para style="q" vid="SNG 3:10">ते तैसारो एन्त्रियों हिस्सो</para>
  <para style="q" vid="SNG 3:10">यरूशलेमेरी कुइयां केरि तरफां</para>
  <para style="q" vid="SNG 3:10">प्यारेरो तोफो थियो।<verse eid="SNG 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />हे सिय्योनेरी कौन्शव, बेइर निस्तां सुलैमान राज़े पुड़ नज़र देथ,</para>
  <para style="q" vid="SNG 3:11">हेरा तैनी तैन्ने ताज लेवरूए,</para>
  <para style="q" vid="SNG 3:11">ज़ैन तैसेरी अम्मा तैसेरे ड्लाहेरे दिहाड़े</para>
  <para style="q" vid="SNG 3:11">ते तैसेरे मनेरे खुशरे दिहाड़े तैसेरे दोग्गे पुड़ रखेरू थियूं।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="p">
    <char style="k">लाड़ो</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />हे मेरी ट्लारी तू खूबसूरत आस, तू खूबसूरत आस,</para>
  <para style="q" vid="SNG 4:1">तेरी एछ़्छ़ी तेरे निकाबे हैठ दूई कबूतरां</para>
  <para style="q" vid="SNG 4:1">केरे ज़ेरि आन,</para>
  <para style="q" vid="SNG 4:1">ते तेरो दोग छ़ेल्‍ली केरो ज़ेरोए,</para>
  <para style="q" vid="SNG 4:1">ज़ैना गिलाद पहाड़ेरे ढलाने पुड़ झ़ुलोरिन।<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="PRO 5:19">कह. 5:19</ref>.</char></note><verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />तेरे दंत भैड्डां केरि केन्नी केरे ज़ेरेन, ज़ैन केरि उन्ना बरधेवरिन,</para>
  <para style="q" vid="SNG 4:2">ज़ैना निहानेरे बाद तालाबे मरां बेइर निसने लेगोरिन, ते हर एक्‍की भैड्डी जोड़ी बच्‍चेन,</para>
  <para style="q" vid="SNG 4:2">ते तैन मरां केन्चेरो साथी नईं मरोरो।<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />तेरे ओठ लाल रंगेरी डोरारे ज़ेरेन,</para>
  <para style="q" vid="SNG 4:3">ते तेरू आशी भी रोड़ूए,</para>
  <para style="q" vid="SNG 4:3">ते तेरी कनपेट्टी तेरे निकाबे हैठ</para>
  <para style="q" vid="SNG 4:3">अनारेरे अध्धे-अध्धे टुक्डां केरे ज़ेरिन।<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />तेरू गल दाऊदेरे मीनारेरू ज़ेरूए,</para>
  <para style="q" vid="SNG 4:4">ज़ै हथियारां केरे लेई बनोरो भोए, ज़ैस पुड़ हज़ार ढालां टेंगोरी भोन,</para>
  <para style="q" vid="SNG 4:4">ते तैना सब जंगी मड़दां केरि ढालन।<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />तेरी दूईये छैती हिरनरे जोड़ी बच्‍चां केरे ज़ेरिन,</para>
  <para style="q" vid="SNG 4:5">ज़ैना सोसनेरे फूड़न मां च़रते भोन।<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />ज़ांतगर दिहाड़ी न डुब्बे, ते छाव लम्मी भोती-भोती मिटी न गाए,</para>
  <para style="q" vid="SNG 4:6">तांतगर अवं जल्दी गन्धरसेरे पहाड़े ते लोबानेरे पहैड़ी पुड़ च़लो गेइलो।<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />हे मेरी ट्लारी, तू बड़ी खूबसूरत आस,</para>
  <para style="q" vid="SNG 4:7">ते तीं मां कोई नुक्स नईं।<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="EPH 5:27">इफि. 5:27</ref>.</char></note><verse eid="SNG 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />हे मेरी दुल्हन, तू मीं सेइं साथी लबानोनेरां,</para>
  <para style="q" vid="SNG 4:8">तू मीं सेइं साथी लबानोनेरां च़ली एई,</para>
  <para style="q" vid="SNG 4:8">तू अमानारी च़ोटी पुड़ेरां</para>
  <para style="q" vid="SNG 4:8">सनीर ते हेर्मोनेरी च़ोटी पुड़ेरां,</para>
  <para style="q" vid="SNG 4:8">शेरां केरि कुढन मरां, ते चीतां केरे पहाड़न पुड़ां नज़र केर।<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />हे मेरी बेइन, हे मेरी दुल्हन, तीं मेरो दिल च़ोरी छ़डोरोए,</para>
  <para style="q" vid="SNG 4:9">एपनी एछ़्छ़री एक्‍की नज़री सेइं</para>
  <para style="q" vid="SNG 4:9">ते अपने गलेरे एक्‍की हीरे सेइं मेरो दिल घिन्नी छ़डोरोए।<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />हे मेरी बेइन, हे मेरी दुल्हन तेरो प्यार केत्रो रोड़ोए,</para>
  <para style="q" vid="SNG 4:10">तेरो प्यार दाछ़रे रस्से करां भी जादे रोड़ोए,</para>
  <para style="q" vid="SNG 4:10">ते तेरे इत्रां केरि खुशबू सेब्भी मसालन करां भी जादे खुश्बूदारे।<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="JHN 4:10">यूह. 4:10</ref>;<ref loc="ISA 12:3">यशा. 12:3</ref>.</char></note><verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />हे मेरी दुल्हन, तेरे ओठन पुड़ेरां माछ़ी झ़ड़ते,</para>
  <para style="q" vid="SNG 4:11">तेरी ज़िभी हैठ माछ़ी ते दुद्ध भोते;</para>
  <para style="q" vid="SNG 4:11">ते तेरे लिगड़ां केरि खुशबू लबानोनेरी ज़ेरिए।<verse eid="SNG 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />हे मेरी बेइन, हे मेरी लाड़ी, तू अक दार बन्द कियोरी बाग आस,</para>
  <para style="q" vid="SNG 4:12">ते दार बन्द कियो नाग आस, ते छाप लेवरो झरनो आस।<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />तेरे मुन्केरे रोड़े अनारां केरे फलदार बागरे ज़ेरे आन,</para>
  <para style="q" vid="SNG 4:13">ज़ैस मां मींधी ते जटामासी,<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />जटामासी ते केसर,</para>
  <para style="q" vid="SNG 4:14">लोबानेरे सब किसमां केरे बुट, मुश्क ते दालचीनी,</para>
  <para style="q" vid="SNG 4:14">गन्धरस, अगर, इना सब खास-खास खुशबूदार चीज़ां भोतिन।<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />तू बागां केरो नाग आस,</para>
  <para style="q" vid="SNG 4:15">ते ज़िन्दगरे पैनेरो चशमो आस,</para>
  <para style="q" vid="SNG 4:15">ते लबानोनेरां उन्ढे बगने लेगोरी गड्डन।</para>
  <para style="p" vid="SNG 4:15">
    <char style="k">लाड़ी</char><verse eid="SNG 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />हे उत्तरेरी हवा बींझ़, हे दक्षिणेरी हवा तू च़ली एई!</para>
  <para style="q" vid="SNG 4:16">मेरे बागी मांमेइं एई, ज़ैस सेइं तेरी खुशबू फैले।</para>
  <para style="q" vid="SNG 4:16">मेरो ट्लारो अपने बागी मां एज्जे,</para>
  <para style="q" vid="SNG 4:16">ते तैसेरे रोड़े-रोड़े फल खाए।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="p">
    <char style="k">लाड़ो</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />हे मेरी ट्लारी, हे मेरी दुल्हन,</para>
  <para style="q" vid="SNG 5:1">अवं एपनी बागी मां एवरोईं,</para>
  <para style="q" vid="SNG 5:1">मीं अपनो गन्धरस ते बलसान च़ुनो,</para>
  <para style="q" vid="SNG 5:1">मीं कश्शे सने माछ़ी खेवरूए,</para>
  <para style="q" vid="SNG 5:1">मीं अपने दाछ़रो रस ते दुद्ध पियोरूए।</para>
  <para style="p" vid="SNG 5:1">
    <char style="k">सहेली</char></para>
  <para style="q" vid="SNG 5:1">हे दोस्तव, तुस भी खाथ,</para>
  <para style="q" vid="SNG 5:1">हे ट्लारव, पीया, खूब रेज़्ज़तां पीया।</para>
  <para style="s" vid="SNG 5:1">च़ेवरोवं गीत</para>
  <para style="p" vid="SNG 5:1">
    <char style="k">लाड़ी</char><verse eid="SNG 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />अवं झ़ुलती थी, पन मेरो मन बींझ़ो थियो।</para>
  <para style="q" vid="SNG 5:2">शुना! मेरो ट्लारो दार गुड़काते, ते तै ज़ोते,</para>
  <para style="q" vid="SNG 5:2">“हे मेरी साथी, हे मेरी ट्लारी, हे मेरी कबूतरी</para>
  <para style="q" vid="SNG 5:2">हे मेरी निर्मल मेरे लेई दार खोल्‍ल;</para>
  <para style="q" vid="SNG 5:2">किजोकि मेरी क्रोड़ी ओशी सेइं भरोरीए,</para>
  <para style="q" vid="SNG 5:2">ते मेरे दोग्गेरे बाल रातरे ट्लेली सेइं सिज़तन।”<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="REV 3:20">प्रका. 3:20</ref>.</char></note><verse eid="SNG 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />मीं त लिगड़ां खोलोरां थियां अवं तैन केन्च़रे फिरी लेईं?</para>
  <para style="q" vid="SNG 5:3">मीं त अपने पव धोई छ़डोरेन, हुनी अवं तैन फिरी केन्च़रे मेले केरीं?<verse eid="SNG 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />मेरे ट्लारे अपनो हथ किवाड़ेरे गत्तेरां बत्तां बेइर कढोरोए,</para>
  <para style="q" vid="SNG 5:4">ते मेरो दिल तैसेरेलेइ धड़कने लगोरोए।<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />अवं खड़ी उठी, कि अपने ट्लारेरे लेई दार खोल्‍ली,</para>
  <para style="q" vid="SNG 5:5">ते मेरे हथ्थन सेइं गन्धरस झ़ड़ने लगो,</para>
  <para style="q" vid="SNG 5:5">ते मेरी एंगलोई सेइं मेहलेरे दसतन उन्ढो गन्धरस पेव।<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />मीं त अपने ट्लारेरे लेई दार त खोल्‍लू,</para>
  <para style="q" vid="SNG 5:6">पन मेरो ट्लारो तैड़ी न थियो, तै च़लो जेवरो थियो।</para>
  <para style="q" vid="SNG 5:6">ज़ैखन तै ज़ोने लेवरो थियो, तैखन मेरे प्राण डेरि जेवरे थिये।</para>
  <para style="q" vid="SNG 5:6">मीं त तै तोप्पो, पन तै मीं न मैल्हो;</para>
  <para style="q" vid="SNG 5:6">मीं तैस जो हक दित्ती, पन तैनी किछ जुवाब न दित्तो।<verse eid="SNG 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />पहरदार ज़ैना नगरे मां घुमते थिये, तैना मीं मैल्हे,</para>
  <para style="q" vid="SNG 5:7">तैनेईं मीं मार दित्ती ते ज़खमी की;</para>
  <para style="q" vid="SNG 5:7">ते शहरपनाहरे पहरदारेईं मेरी च़ादर मीं करां थसोड़ी।<verse eid="SNG 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />हे यरूशलेमेरी कौन्शव, अवं तुसन कसम देइतां ज़ोचां, अगर मेरो ट्लारो तुसन मैल्ही गाए,</para>
  <para style="q" vid="SNG 5:8">त तैस ज़ोइयथ कि अवं प्यारेरी रोगी आईं।</para>
  <para style="p" vid="SNG 5:8">
    <char style="k">सहेली</char><verse eid="SNG 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />हे कौन्शन मां बड़ी खूबसूरत</para>
  <para style="q" vid="SNG 5:9">तेरो ट्लारो होरि ट्लारन मां कोस गल्‍ली मां रोड़ोए?</para>
  <para style="q" vid="SNG 5:9">तू किजो असन एरी कसम देतिस?</para>
  <para style="p" vid="SNG 5:9">
    <char style="k">लाड़ी</char><verse eid="SNG 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />मेरो ट्लारो छ़ित्तो ते लाल ज़ेरोए,</para>
  <para style="q" vid="SNG 5:10">ते दश हज़ारन मां भी जादे रोड़ोए।<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />ते तैसेरी क्रोड़ी खालिस सोन्नेरीए; ते तैसेरे दोग्गेरे बाल घुंघरन बालेन,</para>
  <para style="q" vid="SNG 5:11">ते तैसेरे बाल कंव्वेरे ज़ेरे कालेन।<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />ते तैसेरी एछ़्छ़ी तैन कबूतरां केरि ज़ेरि आन ज़ैना</para>
  <para style="q" vid="SNG 5:12">दुद्धे मां निहेइतां दरियाएरे बन्ने</para>
  <para style="q" vid="SNG 5:12">अपने झुण्डे मां बारां सेइं बिशोरेन।<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />तैसेरी खैखोड़ी फूड़ू केरि फुलवारी ते बलसानेरी</para>
  <para style="q" vid="SNG 5:13">उभरोरी कियैरी आन।</para>
  <para style="q" vid="SNG 5:13">तैसेरे ओठ सोसनेरां फूड़ू आन ज़ैन सेइं गलतो गन्धरस ट्लिशड़ते।<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />तैसेरे हथ फीरोज़ै सेइं पलैटोरे ते सोन्नेरे कड़ेन।</para>
  <para style="q" vid="SNG 5:14">तैसेरो जिसम टपकते हाथी दंतां केरो ज़ेरोए, ज़ैना नीलमरे फूड़ू ते हाथी दंतां केरू कम्मे।<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />तैन केरे पव संगमरमरेरे ज़ेरे खम्भेन ज़ैना खालिस सोन्नेरे पेइड़न पुड़ कायम कियोरेन।</para>
  <para style="q" vid="SNG 5:15">तैना हेरने मां लबानोन ते खूबसूरती मां गैइड़ेरे बुट्टां केरे ज़ेरे रोड़े आन।<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />तैन केरि ज़बान मैछ़ेरी ज़ेरि मिट्ठी आहे, हाँ तै बड़ी रोड़ीए।</para>
  <para style="q" vid="SNG 5:16">हे यरूशलेमेरी कौन्शव, ईए मेरो ट्लारो ते ईए मेरो दोस्ते।<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="p">
    <char style="k">सहेली</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />हे कौन्शन मां बड़ी खूबसूरत,</para>
  <para style="q" vid="SNG 6:1">तेरो ट्लारो कोड़िए?</para>
  <para style="q" vid="SNG 6:1">तेरो ट्लारो कोरहां च़लो जेव</para>
  <para style="q" vid="SNG 6:1">कि अस तीं सेइं साथी तैस तोप्पने च़लम?</para>
  <para style="p" vid="SNG 6:1">
    <char style="k">लाड़ी</char><verse eid="SNG 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />मेरो ट्लारो अपने बागी मां मतलब बलसानेरी</para>
  <para style="q" vid="SNG 6:2">कियैरी केरे पासे जेवरोए,</para>
  <para style="q" vid="SNG 6:2">ताके एपनी बागी मां अपना गब्बां च़ारे ते,</para>
  <para style="q" vid="SNG 6:2">सोसनेरां फूड़ू अकोट्ठां केरे।<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />अवं अपने ट्लारेरी आईं ते मेरो ट्लारो मेरोए,</para>
  <para style="q" vid="SNG 6:3">तै सोसनेरे फूड़न मां अपना गब्बां च़ारते।</para>
  <para style="s" vid="SNG 6:3">पंच़ोंव गीत</para>
  <para style="p" vid="SNG 6:3">
    <char style="k">लाड़ो</char><verse eid="SNG 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />हे मेरी ट्लारी, तू तिर्सेरी ज़ेरि खूबसूरत आस,</para>
  <para style="q" vid="SNG 6:4">तू यरूशलेमेरी ज़ेरि रूपे बाली आस,</para>
  <para style="q" vid="SNG 6:4">ते झण्डो लहराती सेनारी ज़ेरि खतरनाक आस।<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />एपनी एछ़्छ़ी मेरे पासेरां उरां फिरा,</para>
  <para style="q" vid="SNG 6:5">किजोकि अवं तैन करां घबराताईं;</para>
  <para style="q" vid="SNG 6:5">तेरे दोग्गेरे बाल छ़ेल्‍ली केरि केन्नी केरे ज़ेरेन,</para>
  <para style="q" vid="SNG 6:5">ज़ैना गिलादेरे पहाड़े पुड़ेरां उन्ढी ढेलोरी भोन।<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />तेरे दंत एरे भैड्डां केरि केन्नी केरे ज़ेरेन,</para>
  <para style="q" vid="SNG 6:6">ज़ैना निहेवरी भोन,</para>
  <para style="q" vid="SNG 6:6">ज़ैन मां हर अक भैड जोड़ी बच्‍चे देती भोए,</para>
  <para style="q" vid="SNG 6:6">ते ज़ैन मरां केन्चेरो साथी नईं मरोरो।<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />तेरी कनपट्टी तेरे निकाबे हैठ</para>
  <para style="q" vid="SNG 6:7">अनारेरे टुक्ड़े सेइं लेइहोतन।<verse eid="SNG 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />तैड़ी 60 रैनी ते 80 रखैलां,</para>
  <para style="q" vid="SNG 6:8">ते बेशुमार कुइयां भी आन।<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />पन मेरी कबूतरी मेरी निर्मल, अनोखी आहे</para>
  <para style="q" vid="SNG 6:9">तै एपनी अम्मरी अक्‍के,</para>
  <para style="q" vid="SNG 6:9">ते अपने अम्मरी ट्लारीए।</para>
  <para style="q" vid="SNG 6:9">कुइयेईं तै लाई ते तैस जो धन ज़ोवं;</para>
  <para style="q" vid="SNG 6:9">रैनी ते रखैलां तैस लेइतां तैसेरी तारीफ़ केरने लेग्गी।<verse eid="SNG 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />ई कौने, ज़ेसेरी शोभा झ़ेझ़री ज़ेरिए,</para>
  <para style="q" vid="SNG 6:10">ज़ै चैंदनरी ज़ेरि खूबसूरत</para>
  <para style="q" vid="SNG 6:10">ते दिहाड़ेरे ज़ेरि चमकने बाली,</para>
  <para style="q" vid="SNG 6:10">ते झण्डो फैराने बाले सेनारो ज़ेरो</para>
  <para style="q" vid="SNG 6:10">खतरनाक लेइहोते?<verse eid="SNG 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />अवं आखोड़ां केरि बागी मां जेई,</para>
  <para style="q" vid="SNG 6:11">ताके तैड़ी खूबसूरत फूड़ू हेरी,</para>
  <para style="q" vid="SNG 6:11">ते हेरी कि दाछ़री बागी मां गुड्डी लेगोरिन</para>
  <para style="q" vid="SNG 6:11">ते अनारेरां फूड़ू लगोरन कि नईं।<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />मीं पतो भी न थियो कि मेरे खियाले</para>
  <para style="q" vid="SNG 6:12">अवं अपने राजकुमारेरे रथे पुड़ च़ाढ़ी।</para>
  <para style="p" vid="SNG 6:12">
    <char style="k">सहेली</char><verse eid="SNG 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />वापस एई, वापस एई, हे शूलेम्मिन<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">शूलेम्मिन </char><char style="ft" closed="false">इस शब्देरो मतलबे बिलकुल सिद्ध </char></note> वापस एई,</para>
  <para style="q" vid="SNG 6:13">वापस एई कि असां तीं पुड़ नज़र केरम।</para>
  <para style="p" vid="SNG 6:13">
    <char style="k">लाड़ी</char></para>
  <para style="q" vid="SNG 6:13">कुन तुस शूलेम्मिन एस तरीके सेइं तकेले,</para>
  <para style="q" vid="SNG 6:13">ज़ेन्च़रे महनैमेरे नाच़े हेरतन?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="p">
    <char style="k">लाड़ो</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />हे राजकुमारी, जुट्टन मां तेरे पव</para>
  <para style="q" vid="SNG 7:1">केत्रे खूबसूरत लेइहोतन!</para>
  <para style="q" vid="SNG 7:1">ते ज़ंघां केरि गोलाई एरे गेहनेरी ज़ेरिए,</para>
  <para style="q" vid="SNG 7:1">ज़ै कोन्ची माहिर कारीगिरे बनावरो भोए।<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />तेरी नाही गोल कुटोरेरी ज़ेरिए,</para>
  <para style="q" vid="SNG 7:2">ज़ै मसालो मिलोरे दाछ़रे रस्से सेइं भेरतां भोए,</para>
  <para style="q" vid="SNG 7:2">तेरू पेट गेहुं केरे ढेरेरू ज़ेरूए ज़ेसेरे</para>
  <para style="q" vid="SNG 7:2">च़ेवरे पासन सोसनेरां फूड़ू भोन।<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />तेरी दूईये छैती</para>
  <para style="q" vid="SNG 7:3">हिरनरे जोड़ी बच्‍चां केरि ज़ेरि आन,<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />तेरू गल ज़ेन्च़रे हाथी दंतेरो मीनारे।</para>
  <para style="q" vid="SNG 7:4">ते तेरी एछ़्छ़ी हेशबोनेरे तैन कुण्डां केरि ज़ेरिन,</para>
  <para style="q" vid="SNG 7:4">ज़ैना बत्रब्बीमेरे फाटकन कां आन।</para>
  <para style="q" vid="SNG 7:4">तेरू नक लबानोनेरे मीनारेरू ज़ेरूए।</para>
  <para style="q" vid="SNG 7:4">ज़ेसेरू तुत्तर दमिश्केरे पासे आहे।<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />तेरी क्रोड़ी तीं पुड़ कर्मेलेरी ज़ेरि शोभने बालीए,</para>
  <para style="q" vid="SNG 7:5">ते तेरे दोग्गेरे बाल बैंगनी रंगेरे लिगड़ां केरे ज़ेरेन;</para>
  <para style="q" vid="SNG 7:5">ते राज़ो तेरे बालां केरो कैदी भोवरोए।<verse eid="SNG 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />हे ट्लारी, मेरी मन पसंद कुमारी,</para>
  <para style="q" vid="SNG 7:6">तू केत्री खूबसूरत ते रोड़ी आस!<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />तेरू कद-काठी खजूरेरू ज़ेरू शानदारे,</para>
  <para style="q" vid="SNG 7:7">ते तेरी छाती दाछ़रे घोन्छ़ां केरि ज़ेरिए।<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />मीं ज़ोवं, “अवं इस खजूरे पुड़ गुस्तां एसेरी डैलड़ी ट्लेइलो।”</para>
  <para style="q" vid="SNG 7:8">तेरी छाती दाछ़रे घोन्छ़े भोन,</para>
  <para style="q" vid="SNG 7:8">ते तेरे सांसां केरी खुशबू ज़ेन्च़रे च़ोइयां केरि ज़ेरि भोए,<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />ते तेरू आशी खूब रोड़े दाछ़रे रस्सेरू ज़ेरूए,</para>
  <para style="p" vid="SNG 7:9">
    <char style="k">लाड़ी</char></para>
  <para style="q" vid="SNG 7:9">ज़ै आसैनी सेइं बल्हे-बल्हे ओठन पुड़ बेगि गातीए।<verse eid="SNG 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />अवं अपने ट्लारेरी आईं।</para>
  <para style="q" vid="SNG 7:10">ते तैसेरी खुवैइश मेरे पासे बनोरी रहतीए।<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />हे मेरा ट्लारा, एई, असां उडारे मां गाम</para>
  <para style="q" vid="SNG 7:11">ते ड्लाव्वें मां रहम;<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />ते झ़ेझ़ां उठतां अस दाछ़री बागी मां गाम,</para>
  <para style="q" vid="SNG 7:12">ते हेरम कि दाछ़री बागी मां गुड्डी लेगोरिन कि नईं या दाछ़रां फूड़ू लगोरन कि नईं</para>
  <para style="q" vid="SNG 7:12">ते अनार फुलोरेन कि नईं।</para>
  <para style="q" vid="SNG 7:12">तैड़ी अवं तीं अपनो प्यार हरेइली।<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />दूदाफलन सेइं खुशबू फैली राहोरीए,</para>
  <para style="q" vid="SNG 7:13">ते इश्शे दारन पुड़ हर किसमेरे रोड़े फल आन, नंव्वे ते पुराने भी,</para>
  <para style="q" vid="SNG 7:13">हे मेरा ट्लारा, ज़ैना मीं तेरे लेई अकोट्ठां केरतां रखोरेन।<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />रोड़ू भोथू कि तू मेरे ढ्लाएरो ज़ेरो भोथो,</para>
  <para style="q" vid="SNG 8:1">ज़ैनी मेरी अम्मरे छैती केरू दुद्ध पियूं!</para>
  <para style="q" vid="SNG 8:1">तैखन अगर तू मीं बेइर मैलेथो त अवं तीं फुम्मड़ी देथी,</para>
  <para style="q" vid="SNG 8:1">ते कोई मेरी निन्दा न केरेथो।<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />ते अवं तीं एपनी अम्मरे घरे नेथी,</para>
  <para style="q" vid="SNG 8:2">ते तै मीं शिखालेथी,</para>
  <para style="q" vid="SNG 8:2">ते अवं तीं मसालो मिलोरो दाछ़रो रस,</para>
  <para style="q" vid="SNG 8:2">ते अनारां केरो रस पियाथी।<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />कधे एरू भोथू, कि तैसारो बांओ हथ मेरे दोग्गे हैठ भोथो,</para>
  <para style="q" vid="SNG 8:3">ते तैसारो देइने हथ मीं गले लाथो।<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />हे यरूशलेमेरी कौन्शव, अवं तुसन कसम देचांई,</para>
  <para style="q" vid="SNG 8:4">कि तुस मेरे ट्लारे न बींझ़ेइयथ,</para>
  <para style="q" vid="SNG 8:4">ज़ांतगर तै एप्पु न बींझ़े।</para>
  <para style="s" vid="SNG 8:4">शेइयोवं गीत</para>
  <para style="p" vid="SNG 8:4">
    <char style="k">सहेली</char><verse eid="SNG 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />ऐह कौने ज़ैसां अपने ट्लारे पुड़ टेक लेवरोए</para>
  <para style="q" vid="SNG 8:5">जंगले मरां च़ली एइतीए?</para>
  <para style="p" vid="SNG 8:5">
    <char style="k">लाड़ी</char></para>
  <para style="q" vid="SNG 8:5">च़ोइयां केरे बुट्टे हैठ मीं तू बींझ़ाव।</para>
  <para style="q" vid="SNG 8:5">तैड़ी तेरी अम्मा तीं ज़र्म दित्तोरू थियूं,</para>
  <para style="q" vid="SNG 8:5">तैड़ी तेरी अम्मा तकलीफ भुई।<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />मीं नगीनेरे ज़ेरे अपने दिले सेइं लेइतां रख,</para>
  <para style="q" vid="SNG 8:6">ते जंत्रेरे ज़ेरे तू एपनी पैखड़ी पुड़ बेन्धतां रख,</para>
  <para style="q" vid="SNG 8:6">किजोकि प्यार मौतरो ज़ेरो ताकतबरे,</para>
  <para style="q" vid="SNG 8:6">ते तैसेरी जलन कब्रारी ज़ेरि बेरहमे</para>
  <para style="q" vid="SNG 8:6">तैसेरी ज्वाला अग्गरी ज़ेरि भड़कोरीए।</para>
  <para style="q" vid="SNG 8:6">बल्के परमेशरेरी अग आहे।<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="ISA 49:16">यशा. 49:16</ref>.</char></note><verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />पैनेरी हड़ैई सेइं भी प्यार न हिश्शे,</para>
  <para style="q" vid="SNG 8:7">ते न समुन्दरे मां डुबी सके,</para>
  <para style="q" vid="SNG 8:7">अगर कोई अपने घरेरी सारी जाईदात प्यारेरे</para>
  <para style="q" vid="SNG 8:7">बदले दे फिर भी तै बड़ो घटिया समझ़ो गालो।</para>
  <para style="p" vid="SNG 8:7">
    <char style="k">लैड़रो ढ्ला</char><verse eid="SNG 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />इश्शी अक निकड़ी बेइन आहे,</para>
  <para style="q" vid="SNG 8:8">ज़ैसारी छाती हेजू नईं बेडोरी।</para>
  <para style="q" vid="SNG 8:8">ज़ेइस तैसारी ड्लाहेरी गल भोल्ही</para>
  <para style="q" vid="SNG 8:8">तेइस असां तैसारे लेई कुन केरम?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />अगर तै अक शहरपनाह भोथी</para>
  <para style="q" vid="SNG 8:9">त असां तैस पुड़ चैंदरे गुम्मट बनाथे,</para>
  <para style="q" vid="SNG 8:9">ते अगर तैन अक दार भोथू,</para>
  <para style="q" vid="SNG 8:9">त असां तैस पुड़ गैइड़ेरे तखते लामेथे।</para>
  <para style="p" vid="SNG 8:9">
    <char style="k">लाड़ी</char><verse eid="SNG 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />अवं अक शहरपनाह थी ते मेरी छाती तैसेरे गुम्मट;</para>
  <para style="q" vid="SNG 8:10">तैखन अवं अपने ट्लारेरे नज़री मां शान्ति आन्ने बालेरी ज़ेरि थी।<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="PSA 45:11">भज. 45:11</ref>. </char></note></para>
  <para style="p" vid="SNG 8:10">
    <char style="k">लाड़ो</char><verse eid="SNG 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />अक ठार ज़ैस जो बाल्हामोन ज़ोते थिये तैस मां सुलैमानेरी अक दाछ़री बाग थी;</para>
  <para style="q" vid="SNG 8:11">तैनी अपनि बाग बागबानन सौंफी;</para>
  <para style="q" vid="SNG 8:11">ताके तैस मरां हर एक्‍की बागबाने</para>
  <para style="q" vid="SNG 8:11">तैस फलेरे बदले अक हज़ार चैंदरे टुक्ड़े तैस देने थिये।<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 21:33">मत. 21:33</ref>.</char></note><verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />पन ज़ै बाग मेरी अपनि आहे तै मेरे लेई आहे;</para>
  <para style="q" vid="SNG 8:12">हे सुलैमान, 1000 तेरे लेइए, ते 200 चैंदरे टुक्ड़े</para>
  <para style="q" vid="SNG 8:12">तैन केरे लेई आन, ज़ैना बागरी हेरगेश केरतन।<verse eid="SNG 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />तू ज़ै बागी मां रहतिस,</para>
  <para style="q" vid="SNG 8:13">मेरे दोस्त तेरी आवाज़ शुन्नी चातन;</para>
  <para style="q" vid="SNG 8:13">तैस मीं भी शुन्ने दे।</para>
  <para style="p" vid="SNG 8:13">
    <char style="k">लाड़ी</char><verse eid="SNG 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />हे मेरा ट्लारा लूश केर,</para>
  <para style="q" vid="SNG 8:14">ते खुशबूदार पहाड़न पुड़</para>
  <para style="q" vid="SNG 8:14">चिकारे या जुवान हिरनेरो ज़ेरो बन।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>