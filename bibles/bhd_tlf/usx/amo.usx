  <para style="h">आमोस</para>
  <para style="toc1">आमोस</para>
  <para style="toc2">आमोस</para>
  <para style="toc3">आम.</para>
  <para style="mt">आमोस</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">अमोस 1:1 लिखने बालेरे रूपे मां आमोस नबी पिशान केरते। आमोस नबी तकोआ झ़ल्‍लोवें मां पुहालन सेइं साथी रहतो थियो। आमोस इस गल्‍ली साफ केरते कि तै नेबी केरे परिवारे मरां नईं ते न तै अपने आपे जो नबी मन्तो थियो। परमेशरे टिट्टां ते अग्गरे ज़िरिये सज़ाह देनेरी खबरदारी दित्तोरी थी पन आमोस नेबेरी प्राथना इस्राएल बच़ावरो थियो।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग 760-750 ई. पू.</para>
  <para style="ip">आमोस बेतेल ते सामरियारे-उत्तरी रियासती मां प्रचार केरतो थियो।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">उत्तरी रियासत इस्राएलेरे लोक ते एजने बाले वक्ते मां पवित्रशास्त्र पढ़नेबाले लोकां केरे लेई ई किताब लिखी जेई।</para>
  <para style="is">मकसद</para>
  <para style="ip">परमेशर घमण्ड केरनेबालन सेइं नफरत केरते। तैना लोक अपने आपे पुड़ निर्भर थिये, ते तैनेईं परमेशरे करां मैल्होरी हर अक गल बिसरोरी थी। परमेशर सेभी केरो खियाल रखते, ते गरीबन सेइं बुरे बरतावेरे खलाफे खबरदारी देते। आखरकार, परमेशरे सच़्च़ी आराधना लोड़े ज़ैस सेइं तैसेरे लेई आदर भोए। आमोसेरे ज़िरिये परमेशरेरू वचन इस्राएलेरे खास अधिकार हासिल लोकां केरे खलाफ अऊं, तैन मां अपने पड़ोसी केरे लेई प्यार न थियो। तैना होरन करां फैइदो उठाते थिये ते सिर्फ अपनो मतलब कढते थिये।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">न्याय</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. गैर कौमां केरो नाश <char style="ior"><ref loc="AMO 1:1-2:16">1:1—2:16</ref> </char></para>
  <para style="io1">2. नेबी केरि बुलाहट <char style="ior"><ref loc="AMO 3:1-8">3:1-8</ref> </char></para>
  <para style="io1">3. इस्राएलेरी सज़ाह <char style="ior"><ref loc="AMO 3:9-9:10">3:9—9:10</ref> </char></para>
  <para style="io1">4. दुबारां आबाद भोनू <char style="ior"><ref loc="AMO 9:11-15">9:11-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />आमोस तकोआ नगरेरो रानेबालो थियो ज़ै पुहालन मरां थियो, तैसेरे इना वचन आन ज़ैना तैनी यहूदा प्रदेशेरे राज़े उज्जियाहेरे ते योआशेरे मट्ठे इस्राएलेरे राज़े यारोबामेरे राज़ केरनेरे वक्ते मां भुंज़ले करां दूई साल पेइले, इस्राएलेरे बारे मां परमेशरे करां दर्शन मैलतां ज़ोए;<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />“यहोवा सिय्योने मरां गरज़ेलो ते यरूशलेमे मरां अपनि आवाज़ शुनालो; तैखन पुहालां केरि चरागां मातम केरेली, ते कर्मेल पहाड़ेरी च़ोट फुकोई गाली।”<verse eid="AMO 1:2" /></para>
  <para style="s">इस्राएलेरे पड़ोसी रियासतां केरो न्याय</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा एन ज़ोते: “दमिश्क नगरेरे ट्लाई नईं बल्के च़ेवर पापां केरि वजाई सेइं अवं तैस ज़रूर सज़ाह देइलो; किजोकि तैनेईं गिलाद प्रदेश फसल मडनेरे लोंहेरे हथियारन सेइं ढ्लन्च़ो। <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />एल्हेरेलेइ अवं हजाएल राज़ेरे मेहले मां अग लेइलो, ते तैस सेइं बेन्हदद राज़ेरे क़िले भी फुकोइतां भस्म भोइ गाले। <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />अवं दमिश्केरे फाटक ट्लोड़ी छ़डेलो, ते आवेन वैदरे रानेबालन ते बेतएदेन नगरेरे घरन मां रानेबाले राज़ केरनेबालन नष्ट केरतां छ़डेलो; ते अराम मुल्खेरे लोक गुलाम बेनतां कीर प्रदेशे जो गाले, यहोवा एन ज़ोते।”<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />यहोवा एन भी ज़ोते, “गाज़ा नगरेरे ट्लाई नईं बल्के च़ेवर पापां केरि वजाई सेइं अवं तैस ज़रूर सज़ाह देइलो; किजोकि तैनेईं सब लोक नौकर बनेइतां नियोरेन कि तैन्न एदोम मुल्खेरे कब्ज़े मां केरन। <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />एल्हेरेलेइ अवं गाज़ा नगरेरी शहरपनाही मां अग लेइलो, तैस सेइं तैसेरे क़िले भी भस्म भोइ गाले। <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />अवं अश्दोद नगरेरे रानेबालन ते अश्कलोन नगरे पुड़ राज़ केरनेबालन भी नष्ट केरतां छ़डेलो; अवं अपनो हथ एक्रोन नगरेरे खलाफ खड़ो केरेलो, ते बाकी पलिश्ती लोक नष्ट भोइ गाले,” परमेशर यहोवा एन ज़ोते।<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />यहोवा एन ज़ोते: “सोर नगरेरे ट्लाई बल्के च़ेवर पापां केरे वजाई सेइं अवं तैस ज़रूर सज़ाह देइलो; किजोकि तैनेईं सब लोक गुलाम बनेइतां एदोमेरे अधीन किये ते ढ्लाएरो ज़ेरो करार याद न कियो। <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />एल्हेरेलेइ अवं सोर नगरेरे शहरपनाही पुड़ अग लेइलो, ते तैस सेइं तैसेरे क़िले भी भस्म भोइ गाले।”<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="MAT 11:21-22">मत. 11:21-22</ref>;<ref loc="LUK 10:13-14">लूक. 10:13-14</ref>.</char></note><verse eid="AMO 1:10" /></para>
  <para style="s">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />यहोवा एन ज़ोते: “एदोमेरे ट्लाई बल्के च़ेवर पापां केरे वजाई अवं तैस ज़रूर सज़ाह देइलो; किजोकि तैनी अपनो भियाल इस्राएल तलवार घिन्तां निशानोरोए ते किछ भी दया न की, पन क्रोधे सेइं तैन दलतो राव, ते अपनो क्रोध हमेशारे लेई बनोरो रख्खो। <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />एल्हेरेलेइ अवं तेमान नगरे मां अग लेइलो, ते तैस सेइं बोस्रा नगरेरे क़िले भस्म भोइ गाले।”<verse eid="AMO 1:12" /></para>
  <para style="s">अम्मोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />यहोवा एन ज़ोते: “अम्मोनेरे ट्लाई बल्के च़ेवर पापां केरे वजाई सेइं अवं तैस ज़रूर सज़ाह देइलो; किजोकि तैनी अपनि हदबन्दी बधानेरे लेई गिलाद मुल्खेरी दोज़ींती कौन्शां केरां पेटां कटोरन। <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />एल्हेरेलेइ अवं रब्बाह नगरेरे शहरपनाही मां अग लेइलो, ते तैस अग्गी सेइं तैसेरे क़िले भी भस्म भोइ गाले। तैस जंगरे दिहाड़न मां ललकार भोल्ही। तै आँधी बल्के बवण्डरेरी दिहाड़ी भोल्ही। <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />ते तैन केरो राज़ो अपने हाकिमन समेत गुलैमी मां च़लो गालो, यहोवा एन ज़ोते।”<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">मोआब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा एन ज़ोते: “मोआबेरे ट्लाई बल्के च़ेवर पापां केरे वजाई सेइं अवं तैस ज़रूर सज़ाह देइलो; किजोकि तैनी एदोमेरे राज़ेरी हेड्डी फुकतां भस्म की। <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />एल्हेरेलेइ अवं मोआब मुल्खे मां अग लेइलो, ते तैस सेइं करिय्योत नगरेरे क़िले भस्म भोइ गाले; ते मोआबे मां शोर ते ललकार ते नरशिंगेरी आवाज़ शुन्ते-शुन्ते मेरि गालो। <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />अवं तैसेरे दरमियान न्यायी नाश केरेलो, ते साथी-साथी तैसेरे सब हाकिमन भी मारेलो,” यहोवा एन्ने ज़ोते।<verse eid="AMO 2:3" /></para>
  <para style="s">यहूदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />यहोवा एन ज़ोते: “यहूदारे ट्लाई बल्के च़ेवर पापां केरे वजाई सेइं अवं तैस ज़रूर सज़ाह देइलो। किजोकि तैनेईं यहोवारो कानून निकम्मो समझ़ो ते मेरी विधि न मेन्नी; ते अपने झूठे देबतां केरे वजाई सेइं ज़ैन केरि तैन केरे दादे पड़दादे पूज़ा केरते थिये, तैना भी भेटकी जेवरेन। <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />एल्हेरेलेइ अवं यहूदा प्रदेशे मां अग लेइलो, ते तैस सेइं यरूशलेम नगरेरे क़िले भी भस्म भोइ गाले।”<verse eid="AMO 2:5" /></para>
  <para style="s">इस्राएल मुल्खेरो न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />यहोवा एन ज़ोते: “इस्राएलेरे ट्लाई बल्के च़ेवर पापां केरे वजाई सेइं अवं तैस ज़रूर सज़ाह देइलो; किजोकि तैनेईं बेकसूर रुपेइयां केरे लेई ते गरीब अक ज़ोड़ी जुट्टी केरे लेई बेच़ी छ़डे।<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">इस्राएली न्यायी या कर्ज़ो देनेबाले एन्च़रे केरते थिये।</char></note> <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />तैना कंगालां केरे दोग्गे पुड़ धूड़रू भी लालच़ केरतन, ते हलीम लोकन बत्ती करां भी दूर केरतन। ते बाजी ते मट्ठू एक्‍की गुलाम कुइये कां गातन, ज़ैस सेइं मेरू पवित्र नवं अपवित्र भोते। <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />तैना हर एक्‍की वेदी कां बन्धे रखोरे लिगड़न पुड़ झ़ुलतन, ते सज़ाहरे रुपेइये सेइं घिन्तां दाछ़रो रस अपने देबतेरे मन्दरे मां पीतन।<verse eid="AMO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9" />“मीं अपने इस्राएली लोकां केरे सामनेरां एमोरी लोकां केरो नाश कियोरोए, ज़ैन केरि लम्बाई गैइड़ेरे बुट्टां केरि ज़ेरि थी, ते ज़ैन केरि ताकत बंज़ेरे बुट्टां केरि ज़ेरि थी। फिरी भी मीं बह तैसेरे फल, ते बुन्ना तैसेरू ज़ील भी खतम केरतां छ़डू। <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />ते मीं तुसां मिस्र मुल्खेरां केढतां आनोरेथ, ते सुनसान ठैरी मां 40 सालन तगर फिरतो राव, कि तुस एमोरी लोकां केरे मुल्खेरे मालिक भोइ गाथ। <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />ते मीं तुश्शे मट्ठन मरां नबी भोनेरे लेई ते तुश्शे किछ जुवानन मरां नाज़ीर<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xq" closed="false">नाज़ीर </char><char style="xt" closed="false"><ref loc="NUM 6:1-21">गिन. 6:1-21</ref>.</char></note> भोनेरे लेई ठहरावरेन। हे इस्राएली लोकव, कुन इन सब सच़ नईं?” यहोवा एन ज़ोते।<verse eid="AMO 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 2:12" />पन तुसेईं नाज़ीरन दाछ़रो रस पियाव, ते नबी लोकन हुक्म दित्तो कि नबूवत न केरन।<verse eid="AMO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 2:13" />“एल्हेरेलेइ हेरा, अवं तुसन एरहो दबेइलो, ज़ेन्च़रे फेक्‍कन सेइं गड्डी ज़ेन्च़रे ऊँढी दबेइ गैतिन। <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />एल्हेरेलेइ तेज़ दौड़ने बाले नशनेरे लेई बत न मैल्हेली, ते ताकतबरेरी ताकत भी किछ कम्मे न एज्जेली; ते न जंगी सिपाही अपने प्राण बच़ेइ सकेलो; <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />तीर च़लनेबालो खड़ो न रेई बटेलो, ते जल्दी दौड़ने बालो न बच़ेलो: घुड़सवार भी अपने प्राण न बच़ेइ सकेलो; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />ते ज़ै शूरबीरन मां सेभन करां ताकती बालो भोए, तै भी तैस दिहाड़े नग्गो नेश्शी गालो<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">नग्गो नेश्शी गालो </char><char style="ft" closed="false">मतलब अपने हथियार शैरतां नेश्शी गालो।</char></note>,” यहोवा एन ज़ोते।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />हे इस्राएली लोकव, इन सज़ाहरू वचन शुना ज़ैन यहोवा तुश्शे बारे मां मतलब तैस कुलेरे बारे मां ज़ोवरूए ज़ैन मीं मिस्र मुल्खे मरां आनोरूए। <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“धेरतरे सैरी कुलन मरां सिर्फ मीं तुसने पुड़ मन लेवरोए, एल्हेरेलेइ अवं तुसन तुश्शे सैरी अधर्मेरे कम्मां केरि सज़ाह देइलो।”<verse eid="AMO 3:2" /></para>
  <para style="s">नेबेरां कम्मां</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />आमोस फिरी ज़ोते, “अगर दूई मैन्हु एक्‍की गल्‍ली पुड़ राज़ी न भोन, त कुन तैना साथी च़ेलि बटेले? <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />कुन शेर बगैर शिकार मैल्हने जंगले मां गरज़ेलो? कुन जुवान शेर बगैर किछ ट्लानेरे एपनी कुढी मरां गरज़ेलो? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />कुन च़ुड़ोलोवं फंदो लाने बगैर फसेलू? कुन शिकारे बगैर फंदो फसेइ सकते? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />कुन कोन्ची नगरे मां जंगरे लेई नरशिंगो बज़ाने पुड़ लोक न थरकेले? कुन यहोवारे भेज़ने बगैर कोन्ची नगरे मां कोई मुसीबत पेली? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />एस्से तरीके प्रभु यहोवा अपने दास नेबन पुड़ अपनि योजना बांदी केरनेरे बगैर किछ भी न केरेलो।<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="REV 10:7">प्रका. 10:7</ref>;<ref loc="PSA 25:14">भज. 25:14</ref>;<ref loc="JHN 15:15">यूह. 15:15</ref>.</char></note> <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />ज़ैखन शेर गरज़े, तैखन कौन न डरेलो? प्रभु यहोवा ज़ोवं: कौन नबूवत न केरेलो?”<verse eid="AMO 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />अश्दोद नगरेरे क़िले ते मिस्र मुल्खेरे क़िलन मां प्रचार केरतां ज़ोथ: “सामरियारे पहाड़न पुड़ अकोट्ठे भोइतां हेरा कि तैस मां केत्री शौर ते तैस मां केत्रां ज़ुलमेरां कम्मां भोइ राहोरेन!” <verse eid="AMO 3:9" /><verse number="10" style="v" sid="AMO 3:10" />यहोवारू एन ज़ोनूए, “ज़ैना मेरे लोक अपने क़िलन मां ज़ुलम ते च़ोरी कियोरू धन अकोट्ठू केरतन, तैना सच़्च़ैई सेइं कम केरनू न ज़ानन।” <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />एल्हेरेलेइ प्रभु यहोवा एन ज़ोते: “मुल्खे घेरने बालो अक दुश्मन भोल्हो, ते तैए तेरी ताकत ट्लोड़ेलो, ते तेरे क़िले भी लुट्टे गाले।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />यहोवा एन ज़ोते: “ज़ैस तरीके सेइं पुहाल शेरेरे ऐशी मरां दूई खुरैड़ू ते कनेरो अक टुक्ड़ो छुटाते, तेन्च़रे इस्राएली लोक, ज़ैना सामरिया मां बिछ़ानेरे एक्‍की कूने या रेशमेरी गेद्दी पुड़ बिशतन, तैना भी छुटाए गाले।”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />सेना केरो परमेशर, प्रभु यहोवा एन ज़ोते, “हेरा, ते याकूबेरे खानदाने सेइं ऐह गल खबरदार केरतां ज़ोथ: <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />ज़ैस मौके अवं इस्राएली लोकन तैन केरे पापां केरि सज़ाह देलो, तैस मौके अवं बेतेल नगरेरे वेदन भी नाश केरेलो, ते वेदरां शिंगां ट्लुटतां ज़मीनी पुड़ बिछ़ड़ी गालां। <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />ते अवं ते हिवंतड़ेरे ते रितरे दूईये मेहलन बिछ़ोड़ेलो। ते हाथी दांतां केरे बनोरे मेहल भी नाश भोल्हे, ते बड्डां-बड्डां घरां भी नाश भोल्हां,” यहोवा एन ज़ोते।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />“हे सामरिया पहाड़ेरी कौन्शव तुस ज़ैना बाशानेरी बेछ़ी केरि ज़ेरि आथ, एन वचन शुना, तुस ज़ैना सामरियारे पहाड़े पुड़ आथ, ज़ैना कंगालन पुड़ आंधरे केरतिथ, ते गरीबन ढ्लेंच़तीथ, ते अपने-अपने मुन्शे सेइं ज़ोतिथ, ‘पीनेरे लेई दाछ़रो रस आनां!’ <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />परमेशर यहोवा अपनि पवित्रतारी कसम खेइतां ज़ोते, हेरा, तुसन पुड़ एरी दिहाड़ी एजने बालीए, कि तुसां कंटन सेइं, ते तुश्शी औलाद मेछ़लरे कंटन सेइं गुलैमी मांजो खिची गाली। <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />ते तुसां नगरेरे दिवारां केरे गत्तन मांमेइं सिद्धी निस्तां गैली ते हेर्मोने मां छ़ेडी गैली,” यहोवा एन ज़ोते।<verse eid="AMO 4:3" /></para>
  <para style="s">सज़ाह मैल्हने पुड़ भी इस्राएल न सुधरे</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />यहोवा ज़ोते, “बेतेल नगरे मां एइतां पाप केरा; ते गिलगाल नगरे मां एइतां बड़े पाप केरा; अपनि च़ढ़तल झ़ेझ़ां, ते अपने फसलरो दशोवं हिस्सो ट्लेइयोवं दिहाड़े आनां; <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />शुक्रेरी च़ढ़तल खमीर मिलेइतां च़ाढ़ा, ते अपने मेर्ज़ी सेइं दित्तोरे बलिदानेरी चर्चा च़लेइतां तैसेरो प्रचार केरा; किजोकि हे इस्राएली लोकव, एरू केरनू तुसन पसंदे,” परमेशर यहोवा एन ज़ोते।<verse eid="AMO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6" />“मीं तुश्शे सेभी नगरन मां काल भेज़ो, ते तुश्शे सैरी ठारन पुड़ मीं रोट्टरो घाटो कियोरोए, फिर भी तुसां मेरे पासे मुड़तां न आए,” यहोवा एन ज़ोते।<verse eid="AMO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 4:7" />“ते ज़ैखन फसल कटनेरे लेई ट्लाई महीने बाकी राए, तैखन मीं तुश्शे लेई झ़ड़ी न भेज़ी; मीं एक्‍की नगरे पुड़ झ़ड़ी दित्ती ते होरि पुड़ न्ना; एक्‍की उडारे पुड़ झ़ड़ी बख्खी, ते होरि उडारे पुड़ न्ना; तैन शुक्‍की जेवं। <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />एल्हेरेलेइ दूई-ट्लाई नगरां केरे लोक पानी पीनेरे लेई दरबदर फिरते एक्‍की नगरे मां आए, पन रज़्ज़े न; फिर भी तुसां मेरे पासे न फिरे,” यहोवा एन ज़ोते।<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />“मीं तुसन लूह ते गेरूई सेइं सज़ाह दित्ती; ते ज़ैखन तुश्शी बागां ते दाछ़री बागां, ते फैगेरे ते ज़ैतूनेरे बड़े बुट भोइ जे, तैखन टिट्टां तैन खेइ जेआं फिरी भी तुस मेरे पासे न फिरे,” यहोवा एन ज़ोते।<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />“मीं तुश्शे दरमियान मिस्र मुल्खेरी ज़ेरि महामारी फैलाई; मीं तुश्शे घोड़े थुसोड़तां तुश्शे जुवान जंगी मां तलवारी सेइं माराए; ते तुश्शे डेरां केरि मुशक तुसन कां पुज़्ज़ी; फिर भी तुसां मेरे पासे मुड़तां न आए,” यहोवा एन ज़ोते।<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />“मीं तुसन मरां किछ एन्च़रे उलटाए, ज़ेन्च़रे सदोम ते गमोरा नगरां उलटेवरां थियां। तुसां तैस अग्गी मरां निस्सोरां मोछ़ू केरे ज़ेरे भोए; फिर भी तुसां मेरे पासे न फिरे,” यहोवा एन ज़ोते।<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 19:24-25">उत्प. 19:24-25</ref>.</char></note><verse eid="AMO 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 4:12" />“एल्हेरेलेइ, हे इस्राएल अवं तीं सेइं एरू केरेलो, ते एल्हेरेलेइ कि अवं तीं सज़ाह देने बालोईं, हे इस्राएल, अपने परमेशरेरे सामने एजनेरे लेई तियार भोइ गा!”<verse eid="AMO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 4:13" />हेर, पहाड़ां केरो बनानेबालो ते हवा बनानेबालो, ते मैन्हु तैसेरो मनेरो विचार ज़ोने बालो ते झ़ेझ़ां अंधकार केरनेबालो, ते उच्‍चे ठैरन पुड़ च़लने बालोए, तैसेरू नवं सेना केरो परमेशर यहोवाए!<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="2CO 6:18">2 कुरि. 6:18</ref>.</char></note><verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">मन फिरानेरे लेई ज़ोनू</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />आमोस ज़ोते, हे इस्राएली लोकव, इस मातमेरे गीतेरे वचन शुना ज़ैना अवं तुश्शे बारे मां ज़ोताईं: <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />“इस्राएलेरी कुवारी कुई<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="fq" closed="false">इस्राएलेरी कुवारी कुई </char><char style="ft" closed="false">मतलब इस्राएली लोक।</char></note> बिछ़ड़ी जेई, ते फिरी उठी न बटेली; तै अपने ज़मीनी पुड़ तलवारी सेइं मारी जेई, ते तैस खड़ो केरनेबालो कोई नईं।”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />किजोकि परमेशर यहोवा एन ज़ोते, “ज़ैस नगरे मरां 1000 सिपाही निस्ते थिये, तैस मरां इस्राएलेरे 100 सिपाही बच़ेले, ते ज़ैस मरां 100 निस्ते थिये, तैस मरां 10 बच़ेले।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />यहोवा इस्राएली लोकन सेइं एन ज़ोते, मीं कां वापस एज्जा, तैखन ज़ींते राले। <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />बेतेल नगरे मां गेइतां मरां मद्दत न तोप्पा, गिलगाल ते बेर्शेबा नगरन मां आराधना केरनेरे लेई न गाथ; किजोकि गिलगाल पक्‍कू गुलैमी मां गालू, ते बेतेल खाली भोइ गालू।<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />यहोवा कां वापस एज्जा, तैखन ज़ींते राले, नईं त तै यूसुफेरे लोकन पुड़ अग्गरो ज़ेरो भड़केलो, ते अग तैस भस्म केरेली, ते बेतेले मां तैस कोई हिशाने बालो न भोल्हो। <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />हे न्याय बिगाड़ने बालाव ते धार्मिकताई मित्ती मां मिलाने बालाव!<verse eid="AMO 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 5:8" />यहोवा ज़ै हर किसमेरे तारे बनानेबालोए, तै बड़े आंधरे झ़ेझ़री लौई मां बदलते, तै दिहैड़ी आंधरे मां बेदलतां रात बनाते, तै समुन्दरेरू पानी हिलाते, ते ज़मीनी पुड़ बरसाते, तैसेरू नवं यहोवाए। <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />तै ताकतबरे लूशी नाश केरतां छ़डते, ते क़िले भी सत्यानाश केरतां छ़डते।<verse eid="AMO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />ज़ै मैन्हु सभाई मां सच़्च़ैई सेइं नगरेरे फाटके मां न्याय केरते, तुसां तैस सेइं बैर रखतथ, ते सेच़्च़ी गल्‍लन सेइं नफरत केरतथ।<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="GAL 4:16">गल. 4:16</ref>.</char></note> <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तुसां ज़ैना गरीबन पुड़ ज़ुलम केरतथ, ते भेंटरे नंव्वे पुड़ अन्न नेतथ, एल्हेरेलेइ ज़ैना घरां तुसेईं तराशोरे घोड़न सेइं बनेवरेन, तैन मां रेई न बटेले। ते ज़ैना खूबसूरत दाछ़री बागां तुसेईं लेवरिन, तैन केरे दाछ़रो रस पी न बटेले। <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />किजोकि अवं ज़ानताईं कि तुश्शे पाप भरी आन। तुस धर्मी लोकन सतातथ ते रिश्पत नेतथ, ते फाटकन मां गरीब लोकन सेइं अन्याय केरतथ। <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />एल्हेरेलेइ ज़ै अक्लमन्द भोए, तै एरे वक्ते च़ुप राए, किजोकि वक्त बुरोए।<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="EPH 5:16">इफि. 5:16</ref>.</char></note><verse eid="AMO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14" />हे लोकव, बुराई नईं, बल्के भलियाई तोप्पा, ताके तुस ज़ींते राथ; ते तुश्शू इन ज़ोनू सच़ भोए कि सेना केरो परमेशर यहोवा तुसन सेइं साथी आहे। <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुरैई सेइं बैर ते भलियाई सेइं प्यार रखा, ते फाटकन मां न्याय कायम केरा; भोइ सकते सेना केरो यहोवा यूसुफेरे खानदानेरे बच़ोरे लोकन पुड़ अनुग्रह केरे।<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="ROM 12:9">रोम. 12:9</ref>.</char></note><verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />एल्हेरेलेइ सेना केरो परमेशर, प्रभु यहोवा एन ज़ोते: “सब चौकन मां लेरां ते शोर भोनीए; ते सेभी सड़कन मां लोक हाय, हाय केरेले! तैना ज़मीनदारन मातम केरेनेरे लेई, ते ज़ैना लोक मातम केरने मां माहिरन, तैन लेरां देनेरे लेई कुजाले। <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />ते सेभी दाछ़री बागन मां लेरां केरि शोर भोल्ही,” किजोकि यहोवा एन ज़ोते, “अवं तुश्शे मझ़मेइं निस्तां गालो।”<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />फिरी आमोस ज़ोते, हाय तुसन पुड़, ज़ैना यहोवारे दिहाड़ां केरि इच्छा रखते भोन! यहोवारे न्यायेरे दिहाड़े तुश्शो कुन फैइदो भोल्हो? तै त लौअरी नईं बल्के आंधरेरी दिहाड़ी भोल्ही। <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />ज़ेरो कोई शेरे करां नश्शे ते तैस इछ़ मैल्हे; या घरे मां एइतां कंथी पुड़ हथ लाए ते तैस सप खाए। <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />कुन एन सच़ नईं कि यहोवारी न्यायेरे दिहाड़ी लौअरी नईं, बल्के आंधरेरी भोल्ही? हाँ, एरू आंधरेरू ज़ैस मां किछ भी चमक न भोल्ही।<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />“अवं तुश्शे तिहारन सेइं बैर रखताईं, ते तैन निकम्मे समझ़ताईं, ते तुश्शी महासभान सेइं अवं खुश नईं। <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />चाए तुस मेरे लेई होमबलि ते अन्नबलि च़ाढ़थ, फिरी भी अवं खुश न भोल्हो, ते तुश्शे पालोरे जानबरां केरि मेलबलि केरे पासे न तकेलो। <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />अपने गीतां केरि शोर मीं करां दूर केरा; तुश्शे सारेंगी केरो सुर अवं न शुनेलो। <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पन न्याय दरियाएरो ज़ेरो, ते धार्मिकता बड्डे दरियाएरो ज़ेरो बगने देइयथ।<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“हे इस्राएली लोकव, तुसां सुनसान ठैरी मां 40 सालन तगर जानबरां केरि बलि ते अन्नबलि कुन मेरे लेई च़ाढ़ते राए? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />नईं, तुसां त अपने राज़ेरो तेम्बु, ते एपनी मूरती, ते अपने देबतां केरो तारो साथी नेइतां फिरते राए, ज़ैना तुसेईं अपने लेई बनेवरेन<note caller="-" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false"><ref loc="ACT 7:42-43">प्रेरित. 7:42-43</ref>.</char></note>। <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />एल्हेरेलेइ अवं तुसन दमिश्क नगरेरे उस पासे गुलैमी मां पुज़ेइलो, सेना केरो परमेशर यहोवा एन ज़ोते।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />“हाय तैन पुड़ ज़ैना सिय्योने मां सुखे सेइं रहतन, ते तैन पुड़ ज़ैना सामरिया नगरेरे पहाड़न पुड़ बे फिक्र रहतन, ते ज़ैना महान कौमी मां मुशूर आन, ज़ैन कां इस्राएली लोक एइतन! <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने नगरे मां गेइतां हेरा, ते तैट्ठां बड्डे हमात नगरे जो गाथ; फिरी पलिश्ती केरे गत नगरे जो गाथ। कुन तैना इन रियासतन करां रोड़ेन? कुन तैन केरो मुल्ख तुश्शे मुल्खे करां बड्डोए? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />तुस बुरे दिहाड़न दूर केरथ, ते ज़ुलमेरी गद्दी नेड़े आनतथ।<verse eid="AMO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 6:4" />“तुस हाथी दांतां केरे पलंघन पुड़ लेटतथ, ते अपने-अपने बिछ़ाने पुड़ पव खिलैरतां झ़ुलतथ, ते बाड़े मरां गबड़ां ते गाल्ही मरां बछ़ड़ां खातथ। <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />तुस सैन्गी सेइं साथी गीतां ज़ोतथ, ते दाऊदेरे ज़ेरे किसमे-किसमां केरे बाज़े अक्ली सेइं कढतथ; <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />ते कटोरन मां दाछ़रो रास पीतथ, ते रोड़ो-रोड़ो तेल लातथ, पन यूसुफे पुड़ एजनेबाली मुसीबतरो हाल शुन्तां हैरान न भोथ। <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />एल्हेरेलेइ तैना हुनी गुलैमी मां पेइले गाले, ते ज़ैना पव खिलैरतां झ़ुलतन, तैन केरि आयाशी हुनी खतम भोइ गैली।”<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />सेना केरो परमेशर यहोवा एन ज़ोते, (परमेशरे यहोवा अपनि कसम खेइतां ज़ोवं) “ज़ैस पुड़ याकूब घमण्ड केरते, तैस सेइं अवं नफरत ते तैसेरे मेहलन सेइं बैर रखताईं; ते अवं एस नगरे ज़ैन तैस मांए, दुश्मना केरे हथ्थे मां केरेलो।”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />अगर कोन्ची घरे मां कोई दश मड़द बच़ोरे रान, फिरी भी तैना तेन्च़रे मेरि गाले। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />ज़ैखन केन्चेरो चाचो, ज़ै तैसेरो फुकने बालो भोए, तैसेरी हेड्डी घरेरां कढनेरे लेई सलेलो, ते ज़ै घरेरे कूने पुड़ बिशोरो भोए तैस सेइं ज़ोलो, “कुन तीं कां कोई होरो भी आहे?” तैखन तै ज़ोलो, “कोई नईं;” फिरी तै ज़ोलो, “च़ुप रा! असेईं यहोवारू नवं न लोड़े घिन्नोरू।”<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />किजोकि यहोवारे हुक्मे सेइं बड्डे घरे मां गत, ते निकड़े घरे मां दर्ज़ भोइ गाली। <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />कुन घोड़े चट्टानी पुड़ दौड़न? कुन तैड़ी दांत लाए ज़ैड़ी तुसेईं न्याय सेइं, ते धार्मिकतारे फल ट्लिठे फले मां बदले? <verse eid="AMO 6:12" /><verse number="13" style="v" sid="AMO 6:13" />तुस एरी चीज़री वजाई सेइं खुशी केरतथ ज़ै बेकारे; ते ज़ोतथ, “कुन अस अपने कोशिशी सेइं सामर्थी नईं भोवरे?” <verse eid="AMO 6:13" /><verse number="14" style="v" sid="AMO 6:14" />एल्हेरेलेइ सेना केरो परमेशर यहोवा एन ज़ोते, “हे इस्राएली लोकव, हेरा, अवं तुश्शे खलाफे एरी कौम खड़ी केरेलो, ज़ै हमातेरे वैदी करां देंती अराबारे दरियाए तगर तुसन मुसीबत मां छ़डेली।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">टिट्टां केरू दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />एक्सां परमेशर यहोवा मीं एन हिरावं: ते मीं कुन हेरू ज़ैखन राज़ेरे हिस्सेरी फसल कटोरी थी ते बाकी फसल एजनेबाली थी तैखन टिट्टां पैदा भोआं। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />ज़ैखन तैनेईं सब घास खाव, तैखन मीं बिनती की, “परमेशर यहोवा, अपने लोकन माफ़ केर! नईं त याकूब केन्च़रे कायम रेई सकेलो? तै केत्रो कमज़ोरे!” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />इसेरे बारे मां यहोवा अपने मन बदलो, ते तैस सेइं ज़ोवं, “एरी गल हुनी न भोल्ही।”<verse eid="AMO 7:3" /></para>
  <para style="s">अग्गरू दर्शन</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />परमेशर यहोवा मीं अक होरू दर्शन हिरावं: ते मीं कुन हेरू कि परमेशर यहोवा अग्गरे ज़िरिये मुकदमो लड़नेरे लेई ज़ोवं, ते तैस अग्गी सेइं महासागर शुक्‍की जेव, ते मुल्ख भी भस्म भोने लगोरो थियो। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तैखन मीं बिनती की, “हे परमेशर यहोवा, रुकी गा! नईं त याकूब केन्च़रे कायम रेई सकेलो? तै केत्रो कमज़ोरे।” <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />एसेरे बारे मां भी यहोवा मन बदलो; ते परमेशर यहोवाए ज़ोवं, “एरी गल हुनी न भोल्ही।”<verse eid="AMO 7:6" /></para>
  <para style="s">सालहरू दर्शन</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />तैनी मीं अक होरू दर्शन हिरावं: मीं हेरू कि प्रभु साहल लेइतां बनेवरी कोन्ची दिवारी पुड़ खड़ोए, ते तैसेरे हथ्थे मां साहले। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />ते यहोवाए मीं पुछ़ू, “हे आमोस, तीं कुन लेइहोते?” मीं जुवाब दित्तो, “अक साहल।” तैखन परमेशरे ज़ोवं, “हेर, अवं अपने इस्राएली लोकां केरे दरमियान परखनेरे लेई साहल लेइलो। <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />अवं तैन हुनी न छ़डेलो। इसहाकेरे खानदानेरी पूज़ा केरनेरी उच्‍ची ठारां, ते इस्राएलेरी पवित्र ठारां बेरान भोइ गैली, ते अवं यारोबाम राज़ेरे घराने पुड़ तलवार खिचतां चढ़ाई केरेलो।”<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस ते अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />तैखन बेतेलेरे महायाजक अमस्याह, इस्राएलेरे राज़े यारोबामे कां समाद भेज़ो, “आमोसे इस्राएली लोकां केरे दरमियान बगावतरी साज़िश कियोरीए; तैसेरे सारे वचन मुल्ख न झ़ेल्‍ली सखे। <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />किजोकि आमोस एन ज़ोते, ‘यारोबाम जंगी मां तलवारी सेइं मारो गालो, ते इस्राएल अपने मुल्खे मरां पक्‍को गुलैमी मां च़लो गालो।’”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />तैखन अमस्याहे आमोसे सेइं ज़ोवं “हे दर्शी, इट्ठां नश ते यहूदा प्रदेशे मांजो गा, ते तैड़ी रोट्टी खा, ते तैड़ी नबूवत भी केर; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पन बेतेले मां फिरी कधी नबूवत न केरां, किजोकि ऐह राज़ेरी पवित्र ठारे ते आराधना केरनेरू नगरे।” <verse eid="AMO 7:13" /><verse number="14" style="v" sid="AMO 7:14" />आमोसे जुवाब दित्तो अमस्याह सेइं ज़ो, “अवं न त नबी थियो, ते न नेबेरू मट्ठू, अवं गोरू-गब्बां च़ारने बालो थियो, ते गूलरेरे बुट्टां केरो बागबान थियो, <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />ते यहोवा अवं गब्बन पत्पती च़लनेरे करां कुजेइतां मीं हुक्म दित्तो, ‘गा मेरे इस्राएली लोकन सेइं नबूवत केर।’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />एल्हेरेलेइ हुनी तू यहोवारू वचन शुन, तू ज़ोतस, ‘इस्राएलेरे खलाफ नबूवत न केर; ते इसहाकेरे घरानेरे खलाफ बार-बार वचन न शुना।’ <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />एल्हेरेलेइ यहोवा एन ज़ोते: ‘तेरी कौन्श नगरे मां वेश्या भोल्ही, ते तेरां मट्ठां-कुइयां जंगी मां तलवारी सेइं मारां गालां, ते तेरी ज़मीन रेस्सी लेइतां बंटी गाली; ते तू एप्पु अशुद्ध मुल्खे मां मेरि गालो, ते इस्राएल अपनि ज़मीनी पुड़ेरां ज़रूर गुलैमी मां च़लो गालो।’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फलन सेइं भेरतां टोकरारू दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />फिरी परमेशर यहोवाए मीं एन भी हिरावं: कि, रितरे फलन सेइं भेरतां अक टोकरीए। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />ते तैनी पुछ़ू, “हे आमोस, तीं कुन लेइहोते?” मीं जुवाब दित्तो, “रितरे फलन सेइं भेरतां अक टोकरीए।” तैखन यहोवाए मीं सेइं ज़ोवं, “मेरे इस्राएली लोकां केरो अन्त एवरोए; अवं हुनी तैस न छ़डेलो।” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />परमेशर यहोवा एन ज़ोते, “तैस दिहाड़े राज़ मन्दरेरां गीतां हाहाकारे मां बेदलोई गालां, ते लाशां केरो बड़ो ढेर लग्गेलो; ते सब जगान मां तैना च़ुपच़ारे शारे गाले।”<verse eid="AMO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />एन शुना, तुस ज़ैना गरीबन पुड़ ज़ुलम केरतथ ते मुल्खेरे हलीम लोकन नाश केरने चातथ, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />ज़ैन ज़ोतथ, “नंव्वो चाँद केइस बीतेलो कि अस अन्न बेच़ी सखम? ते थैकरी दिहाड़ी केइस बीते, कि असां अन्नेरे कोठार खोल्‍लम ते एपा घट ते शेकेल भारी केरम, ते बेइमैनरी ट्लेकड़ी सेइं धोखो देम, <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />कि अस कंगालन रुपेइये देइतां, ते गरीबन अक ज़ोड़ी जुट्टी देइतां तैन गुलाम बनाम, ते खराब अन्न बेच़म?”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />यहोवा, ज़ैस पुड़ याकूबे घमण्ड केरनू जाइज़े, तै अपनि कसम खेइतां ज़ोते, “अवं तुश्शे कोन्ची भी बुरे कम्मे कधी न बिसरेलो। <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />कुन एस वजाई सेइं ज़मीन न हिल्‍लेली? कुन तैस पुड़ रानेबाले सब मातम न केरेले? ई सारो मुल्ख मिस्रेरे नील दरियारे ज़ेरो भोल्हो, ज़ै बद्धते, ते फिरी छ़ेल्ही मारते, ते फिरी घेटी गाते।”<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />परमेशर यहोवा एन ज़ोते, “तैस मौके दिहाड़ो दुपहरेईं डुबी गालो, ते एस मुल्खे मां दीसां केरे दुपहरेईं आंधरू बनेइलो।<note caller="-" style="x"><char style="xo" closed="false">8:9 </char><char style="xt" closed="false"><ref loc="MAT 27:45">मत. 27:45</ref>;<ref loc="MRK 15:33">मरक. 15:33</ref>;<ref loc="LUK 23:44-45">लूक. 23:44-45</ref>.</char></note> <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />अवं तुश्शे दादा पड़दादां केरां तिहारां दूर केरतां मातम करेइलो, ते तुश्शां सारा गीतां दूर केरतां मातमेरां गीतां ज़ुवेइलो; अवं तुश्शे सैरी केरे मझ़े मां टाट बन्धेइलो, ते तुश्शे सैरी केरे दोग्गेरे बाल कटेइलो; ते एरहो मातम करेइलो ज़ेरो कोई एकलौते मट्ठेरे लेई केरते, ते तैसेरो अन्त सखत दुखेरे दिहाड़ेरो ज़ेरो भोल्हो।”<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />परमेशर यहोवा एन ज़ोते, “हेर, एरे दिहाड़े एइतन, ज़ैखन अवं इस मुल्खे मां काल छ़डेलो; तैस मां न त अन्नेरी ढ्लुख भोल्ही ते न पैनेरी ट्लिश भोल्ही, पन यहोवारू वचन शुन्नेरी ढ्लुख ट्लिश भोल्ही। <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />ते लोक यहोवारे वचनेरी तोपी मां एक्‍की समुन्दरे करां होरि समुन्दरे तगर ते उत्तरे करां पूरबे तगर दरबदर फिरेले, पन तैन न मैल्ही बटेलु।<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“तैस मौके खूबसूरत कुइयां ते जुवान मड़द दूईये ट्लिशी सेइं बेहोश भोइ गाले। <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />ज़ैना लोक सामरियारे दोष देबतेरी कसम खातन, ते ज़ैना ज़ोतन, दान नगरेरे देबतेरी कसम, ते बेर्शेबा नगरेरे पन्थेरी कसम, तैना सब बिछ़ड़ी गाले, ते फिरी न उठी बटेले।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">परमेशरेरो न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />मीं दर्शने मां परमेशर वेदी पुड़ खड़ो लाव, ते तैनी ज़ोवं, “भवनेरे खम्भेरी केंगनी पुड़ बह ज़ैस सेइं डेवढी हिलन, ते तैना सेभी लोकां केरि क्रोड़ी पुड़ बुछ़ोड़तां टुक्ड़े-टुक्ड़े केर; ते ज़ैना नाश भोने करां बच़न, तैन अवं जंगी मां तलवारी सेइं मारेलो; तैन मरां अक भी नेश्शी न बटेलो, ते ज़ै अपनो आप बच़ालो, तै बेंच़ी न बटेलो।<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="PSA 68:21">भज. 68:21</ref>.</char></note><verse eid="AMO 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 9:2" />“किजोकि चाहे तैना गत घेड़तां अधलोके मां गान, त तैट्ठां अवं हथ अग्रोवं केरतां तैन आनेलो; ते चाहे तैना तैट्ठां अम्बरे मां च़ैढ़ी गान अवं तैन ओसैलतां आनेलो। <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />चाहे तैना कर्मेल पहाड़े पुड़ छ़ेप्पी गान, पन तैट्ठां भी अवं तोपी-तोपी ट्लेइतां आनेलो, ते चाहे तैना समुन्दरेरे थले मेरी नज़री करां दूर भोन तैड़ी भी अवं समुन्दरी सप्पे तैन डसनेरो हुक्म देइलो। <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />चाहे दुश्मन तैन खदेड़तां गुलैमी मां नेन, तैड़ी भी अवं हुक्म देइतां तैन तलवारी सेइं मारेइलो; अवं तैन पुड़ भलियाई केरनेरे लेई नईं, बुराई केरनेरे लेई नज़र रखेलो।”<verse eid="AMO 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 9:5" />सेना केरे परमेशर यहोवारे हुरने सेइं धरती गेली गातीए, ते तैसेरे सारे रानेबाले मातम केरतन; ते तै सारी धरती मिस्रेरे नील दरियारे ज़ेरि भोतीए, ज़ै बद्धते ते छ़ेल्‍ली मारते ते फिरी घटते। <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />ज़ै अम्बरे मां अपनो मेहल बनाते, ते अम्बरेरी मुनीयाद धेरती पुड़ रखते, ते समुन्दरेरू पानी धेरती पुड़ बगाते, तैसेरू नवं यहोवाए।<verse eid="AMO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />हे इस्राएली लोकव, “यहोवा एन ज़ोते, कुन तुस मेरे लेई कूश<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="fq" closed="false">कूश </char><char style="ft" closed="false">एथोपिया</char></note> मुल्खेरे लोकां केरे ज़ेरे नईं? कुन मीं इस्राएली लोक मिस्र मुल्खे मरां ते पलिश्ती केरे कप्तोरेरां<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="fq" closed="false">कप्तोरेरां </char><char style="ft" closed="false">कीर मुल्ख</char></note> नईं केढतां आनोरे? ते अरामी लोकां केरे कीर नगरे मरां केढतां नईं कढोरे? <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />हेरा, परमेशर यहोवारी नज़र इस पापे बाले रियासती पुड़ लगोरीए, ते तैस अवं धेरती पुड़ेरां खतम केरेलो; फिरी भी अवं याकूबेरे खानदानेरे लोकन नाश न केरेलो,” यहोवा एन ज़ोते।<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />“मेरे हुक्मे सेइं इस्राएली लोक सब कौमन मां एरे छ़ाने गाले ज़ेन्च़रे अन्न बुडोरने मां छ़ानतन, पन तैसेरो अक भी गलेव ज़मीनी पुड़ न बिछ़ड़ेलो। <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />मेरे लोकन मरां सब पापी ज़ैना ज़ोतन, ‘तै मुसीबत असन पुड़ न एज्जेली, ते न असन घेरेली,’ तैना सब तलवारी सेइं मारे गाले।”<verse eid="AMO 9:10" /></para>
  <para style="s">इस्राएलेरी बहाली</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />यहोवा ज़ोते, “तैस मौके अवं दाऊदेरू बिछ़ड़ोरू राज़ दुबारां आबाद केरेलो, ते तैसेरे बाड़ेरे नाके सुधारेलो, ते तैसेरे खण्डर फिरी बनेइलो, ज़ेन्च़रे पेइलू थियूं, तेन्च़रे बनेइलो। <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />ज़ैस सेइं तैना बच़ोरे एदोमी लोक बल्के सब कौमां ज़ैन जो मेरी ज़ोतन, तैन अपने अधिकारे मां नेथ,” यहोवा ज़ै एन कम पूरू केरते, तैन्नी एन ज़ोवरूए।<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">प्रेरित. 15:16-18</ref>.</char></note><verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />यहोवा एन भी ज़ोते, “हेरा, एरे दिहाड़े एजने बालेन, कि दांत लानेबालो फसल कटनेबाले, ते दाछ़रो रस कढने बालो बीज़ बेने बाले च़िकेलो, ते पहाड़न पुड़ेरां नंव्वो दाछ़रो रस टपकेलो, ते सारे पहाड़न पुड़ेरां रस बगेलो। <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />अवं अपनि कौम इस्राएली लोकन गुलैमी मरां फिरी वापस आनेलो, ते तैना उज़ड़ोरे नगरन फिरी आबाद केरतां तैन मां फिरी आबाद भोल्हे। तैना दाछ़री बागां लेइतां तैन केरो रस पीले, तैना बागां लाएले ते तैन केरो फल खाएले। <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />अवं इस्राएली लोकन, तैन्ना केरे मुल्खे मां बसेइलो, तैना फिरी कधी अपने धेरती मरां ज़ै मीं तैन दित्तोरी कढे न गाले।” तुश्शो परमेशर यहोवा एन ज़ोते।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>