  <para style="h">1 इतिहास</para>
  <para style="toc1">इतिहासेरी पेइली किताब</para>
  <para style="toc2">1 इतिहास</para>
  <para style="toc3">1 इति.</para>
  <para style="mt">इतिहासेरी पेइली किताब</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">पेइले ते दूइयोवं इतिहासेरी किताबी मां लिखने बालेरू नवं पतो नईं, यहूदी परम्परारे मुताबिक एज्रा इसेरो लिखने बालोए। इस किताबरी शुरुआत इस्राएली केरे परिवारां केरे नंव्वन सेइं शुरू भोतीए। ते ज़ेइस इस्राएले पुड़ दाऊद राज़ो राज़ केरतो थियो तैस वक्तेरो ज़िक्र कियोरोए।</para>
  <para style="ip">ई किताब दाऊद राज़ेरी कहानी नेड़ेरी अक झलके। ज़ै पुराने नियमेरो अक महान नायक थियो। इस किताबी मां पुराने इस्राएलेरो राजनीतिक ते धार्मिक इतिहासे।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग 450-400 ई. पू. मां ई किताब लिखी जेई।</para>
  <para style="ip">इन साफे कि इस किताबरो लिखनेरो वक्त बाबेलेरी गुलैमी मरां वापस एजनेरो आहे। (<char style="xt"><ref loc="1CH 3:19-24">1 इति. 3:19-24</ref></char>) मां दाऊदेरे खानदाने जरुब्बाबेलेरे बादे तगर, शेइयोवं पीढ़ी तगर ज़िक्र कियो जेवरोए।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">यहूदी लोक ते सब पवित्रशास्त्र पढ़ने बालां केरे लेई ई किताब लिखी जेई।</para>
  <para style="is">मकसद</para>
  <para style="ip">इतिहासेरी पेइली किताब गुलैमी मरां वापस एजनेबालां केरे लेई लिखोरी थी कि तैना परमेशरेरी सेवा केन्च़रे केरन। इसेरो इतिहास यहूदा प्रदेश ते बिन्यामीन ते लेवी गोट्लां केरे बारे मां आहे। इनां गोट्ल परमेशरेरे लेई वफादार थी। परमेशरे दाऊदेरे परिवार या हुकूमत हमेशारे लेई कायम रखनेरो करार कियोरो थियो। ज़ेसेरे लेई परमेशर वफादार राव। दाऊद ते सुलैमानेरे ज़िरिये परमेशरे अपनो भवन बनावव ज़ैड़ी लोक परमेशरेरी आराधना केरनेरे लेई एज्जी सकते थिये। बादे मां सुलैमानेरे ज़िरिये बनेवरो परमेशरेरो भवन बाबेलेरी सेना नष्ट कियोरो थियो।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">इस्राएलेरो इतिहास</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. वंशावली <char style="ior"><ref loc="1CH 1:1-9:44">1:1—9:44</ref> </char></para>
  <para style="io1">2. शाऊल राज़ेरी मौत <char style="ior"><ref loc="1CH 10:1-14">10:1-14</ref> </char></para>
  <para style="io1">3. दाऊदेरू राज़ो बन्नेरे लेई अभिषेक ते राज़ <char style="ior"><ref loc="1CH 11:1-29:30">11:1—29:30</ref> </char></para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">आदमे करां अब्राहमे तगर वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />आदमेरू मट्ठू शेत थियूं ते शेतेरू एनोश;<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">लिखने बालो आदमेरे पेइले दूई मट्ठां कैन ते हाबिलेरे बारे मां ज़िक्र न केरे। सिर्फ तैन केरां नंव्वां लिखोरन ज़ैन केरि खानदानी इस्राएले सेइं मिलतीए।</char></note> <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />एनोशेरू केनान, केनानेरू महललेल, महललेलेरू येरेद, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />येरेदेरू हनोक, हनोकेरू मतूशेलह, मतूशेलहेरू लेमेक, <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />लेमेकेरू मट्ठू नूह थियूं। नूहेरां मट्ठां शेम, हाम ते येपेत थियां।<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 3:36-38">लूक. 3:36-38</ref>.</char></note><verse eid="1CH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />येपेतेरां मट्ठां इनां थियां: गोमेर, मागोग, मादै, यावान, तूबल, मेशेक ते तीरास। <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />गोमेरेरां मट्ठां इनां थियां: अश्कनज, दीपत ते तोगर्मा। <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />यावानेरां मट्ठां इनां थियां: एलीशा, तर्शीश, कित्ती ते रोदानी लोक।<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />हामेरां मट्ठां इनां थियां: कूश, मिस्र, पूत ते कनान। <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />कूशेरां मट्ठां इनां थियां: सबा, हवीला, सबता, रामाह ते सब्तका। रामाहेरां मट्ठां शेबा ते ददान थियां। <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />ते कूशेरू मट्ठू निम्रोद भी थियूं। धेरती पुड़ पेइलो बहादर निम्रोद भोव।<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="GEN 10:8-12">उत्प. 10:8-12</ref>;<ref loc="MIC 5:6">मीक. 5:6</ref>.</char></note><verse eid="1CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 1:11" />मिस्रेरां मट्ठां इना थियां, लूदी, अनामी, लहाबी, नप्तूही, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />पत्रूसी, कसलूही (ज़ैन सेइं पलिश्ती पैदा भोए) ते कप्तोरी पैदा भोए।<verse eid="1CH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 1:13" />कनाने सेइं तैसेरू बड्डू मट्ठू सीदोन ते हित्त, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />ते यबूसी, एमोरी, गिर्गाशी, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />हिब्बी, अर्की, सीनी, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />अर्वदी, समारी ते हमाती लोक पैदा भोए।<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />शेमेरां मट्ठां इनां थियां: एलाम, अश्शूर, अर्पक्षद, लूद, अराम, ऊस, हूल, गेतेर ते मेशेक थियां। <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />ते अर्पक्षदे सेइं शेलह ते शेलहे सेइं एबेर पैदा भोव। <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />एबेरां दूई मट्ठां भोआं, एक्‍केरू नवं पेलेग एस वजाई सेइं रख्खू जेवं कि तैसेरे दिहाड़न मां दुनियारे लोक अलग-अलग भाषारे लोकन मां बेन्टोई जेई। ते तैसेरे निकड़े ढ्लाएरू नवं योक्तान थियूं। <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />ते योक्तानेरां मट्ठां इनां थियां: अल्मोदाद, शेलेप, हसर्मावेत, येरह, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />हदोराम, ऊजाल, दिक्ला, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />एबाल, अबीमाएल, शेबा, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ओपीर, हवीला ते योबाब। इन्ना सब योक्तानेरां मट्ठां भोआं।<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />शेमेरे खानदाने मरां इनां थिये: अर्पक्षद, शेलह, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />एबेर, पेलेग, रू, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />सरूग, नाहोर, तेरह, <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />अब्राम, ज़ैस जो अब्राहम भी ज़ोतन। <verse eid="1CH 1:27" /><verse number="28" style="v" sid="1CH 1:28" />अब्राहमेरां मट्ठां इसहाक ते इश्माएल<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="fq" closed="false">इसहाक ते इश्माएल </char><char style="ft" closed="false">चाए इसहाक निकड़ो थियो, फिरी भी तैसेरू नवं एल्हेरेलेइ पेइलू लिखो कि किजोकि तै जाइज़ औलाद थी, किजोकि तैसेरी अम्मा अब्राहमेरी असली कौन्श थी। </char></note> थियां।<verse eid="1CH 1:28" /></para>
  <para style="s">इश्माएलेरू खानदान</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 1:29" />इश्माएलेरां मट्ठां इनां थियां: तैसेरू बड्डू मट्ठू नबायोत, फिरी केदार, अदबएल, मिबसाम, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />मिश्मा, दूमा, मस्सा, हदद, तेमा, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />यतूर, नापीश, केदमा।<verse eid="1CH 1:31" /></para>
  <para style="s">कतूरारां मट्ठां</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />कतूरा ज़ै अब्राहमेरी रखैल थी, तैसारां इनां मट्ठां थियां: जिम्रान, योक्षान, मदान, मिद्यान, यिशबाक ते शूह। योक्षानेरां मट्ठां शेबा ते ददान थियां। <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />ते मिद्यानेरां मट्ठां इनां थियां: एपा, एपेर, हनोक, अबीदा ते एल्दा, इना सब कतूरारे खानदाने मरां आन।<verse eid="1CH 1:33" /></para>
  <para style="s">इसहाकेरि खानदानी</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />अब्राहमेरू मट्ठू इसहाक थियूं। इसहाकेरां मट्ठां एसाव ते इस्राएल थियां।<note caller="-" style="x"><char style="xo" closed="false">1:34 </char><char style="xt" closed="false"><ref loc="MAT 1:2">मत. 1:2</ref>.</char></note> <verse eid="1CH 1:34" /><verse number="35" style="v" sid="1CH 1:35" />एसावेरां मट्ठां इनां थियां: एलीपज, रूएल, यूश, यालाम ते कोरह। <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />एलीपजेरां इनां मट्ठां थियां: तेमान, ओमार, सपी, गाताम, कनज, तिम्ना ते अमालेक। <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />रूएलेरां मट्ठां इनां थियां: नहत, जेरह, शम्मा ते मिज्जा।<verse eid="1CH 1:37" /></para>
  <para style="s">सेईर एरी खानदानी</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />फिरी सेईरेरां मट्ठां इनां थियां: लोतान, शोबाल, सिबोन, अना, दीशोन, एसेर ते दीशान। <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />ते लोतानेरां मट्ठां इनां थियां: होरी ते होमाम, ते लोतानेरी बेइन तिम्ना थी। <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />शोबालेरां मट्ठां इनां थियां: अल्यान, मानहत, एबाल, शपी ते ओनाम। ते सिबोनेरां मट्ठां अय्या ते अना थियां। <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />अनारू मट्ठू दीशोन थियूं। ते दीशोनेरां मट्ठां हम्रान, एशबान, यित्रान ते करान थियां। <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />एसेरेरां मट्ठां बिल्हान, जावान ते याकान थियां। ते दीशानेरां मट्ठां ऊस ते अरान थियां।<verse eid="1CH 1:42" /></para>
  <para style="s">एदोमी लोकां केरे राज़े</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />ज़ैस वक्त कोन्ची भी राज़े इस्राएली लोकन पुड़ राज़ न थियूं कियोरू, तैस वक्त एदोम मुल्खे मां इना राज़े भोए: बोरेरू मट्ठे बेला दिन्हाबा नंव्वेरे राजधैनी मरां एदोमे पुड़ राज़ कियूं। <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />बेलारे मरनेरां बाद, बोस्राई जेरहेरू मट्ठू योबाब, तैसेरी ठैरी राज़ो बनो। <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />ते योबाबेरे मरनेरे बाद, तेमानी लोकां केरे मुल्खेरो राज़ो हूशाम तैसेरी ठैरी पुड़ राज़ो बनो। <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />फिरी हूशामेरे मरनेरे बाद, बददेरू मट्ठू हदद तैसेरी ठैरी पुड़ राज़ो बनू: ई तैए ज़ैनी मिद्यानी लोक मोआब मुल्खे मां मारे; ते तैनी अबीत नगरे मरां राज़ कियूं। <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />ते हददेरे मरनेरां बाद, मस्रेका नगरेरे सम्ला तैसेरे ठैरी पुड़ राज़ो बनो। <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />फिरी सम्लारे मरनेरां बाद शाऊल, ज़ै फरात दरियारे बन्ने पुड़ ज़ै रहोबोत नगरेरो थियो, तै तैसेरी ठैरी पुड़ राज़ो बनो। <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />ते शाऊलेरे मरनेरां बाद अकबोरेरू मट्ठू बाल्हानान तैसेरी ठैरी राज़ो बनू। <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />ते बाल्हानानेरे मरनेरां बाद, हदद तैसेरी ठैरी पुड़ राज़ो बनो; ते तैनी पाऊ नगरे मरां राज़ कियूं, ते तैसेरी कौन्शरू नवं महेतबेल थियूं ज़ै मेज़ाहाबेरी धिहोड़ी ते मत्रेदेरी कुई थी।<verse eid="1CH 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CH 1:51" />ते हदद मेरि जेव। फिरी एदोम मुल्खेरे अधिपति इनां थिये: तिम्ना, अल्वा, यतेत, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />ओहोलीबामा, एला, पीनोन, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />कनज, तेमान, मिबसार, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />मग्दीएल, ईराम।<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />इस्राएलेरां इना 12 मट्ठां थियां; रूबेन, शिमोन, लेवी, यहूदा, इस्साकार, जबूलून, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />दान, यूसुफ, बिन्यामीन, नप्ताली, गाद ते आशेर।<verse eid="1CH 2:2" /></para>
  <para style="s">यहूदा करां दाऊदे तगर पीढ़ी</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />यहूदेरां मट्ठां, एर, ओनान ते शेला, तैसेरां इना ट्लाई मट्ठां, शूआ नंव्वेरे एक्‍की कनानी कौन्शरे कुइये सेइं पैदा भोआं। ते यहूदारू मट्ठू एर, यहोवारी नज़री मां बुरू थियूं, इस वजाई सेइं यहोवा तैन मारू। <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />ते यहूदारी नुश तामार थी ते यहूदारां तामारी सेइं दूई मट्ठां पेरेस ते जेरह पैदा भोआं। ते यहूदारां कुल पंच़ मट्ठां थियां।<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />पेरेसेरां मट्ठां हेस्रोन ते हामूल थियां। <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />ते जेरहेरां मट्ठां: जिम्री, एतान, हेमान, कलकोल ते दारा सारे मिलतां पंच़ मट्ठां भोआं। <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />फिरी कर्मी<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">कर्मी </char><char style="ft" closed="false">एनी परमेशरे जो अर्पण कियोरी चीज़ां रेखी ते एस वजाई सेइं इस्राएले पुड़ आफत अई, यहोशू सत अध्याय मां इस बारे मां लिखेरूए।</char></note> एरू मट्ठू आकार थियूं, ज़ै अर्पण कियोरी चीज़ां केरे बारे मां धोखेबाज़ी केरतां इस्राएली लोकन दुख देनेबालो भोव। <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />ते एतानेरू मट्ठू अजर्याह थियूं। <verse eid="1CH 2:8" /><verse number="9" style="v" sid="1CH 2:9" />हेस्रोनेरां ज़ैना मट्ठां भोआं तैना इनां थियां, यरहमेल, राम, ते कलूबै।<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 1:3">मत. 1:3</ref>.</char></note> <verse eid="1CH 2:9" /><verse number="10" style="v" sid="1CH 2:10" />ते रामेरू मट्ठू अम्मीनादाब ते अम्मीनादाबेरू मट्ठू नहशोन थियूं, नहशोन यहूदा खानदानेरो प्रधान बनो। <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />ते नहशोनेरू मट्ठू सल्मा ते सल्मारू मट्ठू बोअज थियूं। <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />बोअजेरू मट्ठू ओबेद ते ओबेदेरू मट्ठू यिशै थियूं।<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 1:4-5">मत. 1:4-5</ref>.</char></note> <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />ते यिशैरू बड्डू मट्ठू एलीआब ते दूइयोवं अबीनादाब ट्लेइयोवं शिमा, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />च़ेवरोवं नतनेल ते पंच़ोंव रद्दैं। <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />शेइयोवं ओसेम ते सत्तोवं मट्ठू दाऊद थियूं।<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="LUK 3:31-32">लूक. 3:31-32</ref>.</char></note> <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />एन केरि बेइनां सरूयाह ते अबीगैल थी। ते सरूयाहेरां ट्लाई मट्ठां इनां थियां: अबीशै, योआब ते असाहेल। <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />ते अबीगैलरू मट्ठू अमासा थियूं, ते अमासारो बाजी इश्माएली येतेर थियो।<verse eid="1CH 2:17" /></para>
  <para style="s">हेस्रोनेरे खानदानेरे लोक</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />हेस्रोनेरे मट्ठे कालेबेरी अजूबा ते यरीओती नंव्वेरी कौन्शन सेइं मट्ठां भोआं। तैना मट्ठां इनां आन: येशेर, शोबाब ते अर्दोन। <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />ज़ैखन अजूबा मेरि जेई, तैखन कालेबे एप्राता सेइं ड्लाह बनाव, ते ज़ैस सेइं हूर नंव्वेरू मट्ठू भोवं। <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />ते हूरेरू मट्ठू ऊरी ते ऊरी एरू मट्ठू बसलेल थियूं।<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />एसेरां बाद हेस्रोने 60 सालां केरि उमरी मां माकीरेरे कुइये सेइं ड्लाह बनाव। हेस्रोन तैस कां जेव ते तैसां सगूबे ज़र्म दित्तू। माकीरे गिलाद प्रदेश बसावरू थियूं। <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />ते सगूबेरू मट्ठू याईर थियूं, ज़ैस कां गिलाद प्रदेशे मां 23 नगर थिये। <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />पन गशूर ते अराम नगरां केरि सेना याईरेरी बेस्तन ते ड्लाव्वन समेत कनात ते आसे पासेरे नगरन पुड़ कब्ज़ो कियो। इना सब नगर मिलेइतां 60 थिये। इना सब गिलादेरे बाजी माकीरेरे खानदाने मरां थिये। <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />ते ज़ैखन हेस्रोन कालेब एप्राता मां मेरि जेव, तैखन तैसेरी अबिय्याह नंव्वेरी कौन्शरो अशहूर पैदा भोव ज़ैनी तकोआ नगर बसाव।<verse eid="1CH 2:24" /></para>
  <para style="s">यरहमेलेरे खानदानेरे लोक</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />हेस्रोनेरे बड्डे मट्ठे यरहमेलेरां इनां मट्ठां भोआं: राम ज़ैन तैसेरू बड्डू मट्ठू थियूं, ते बूना, ओरेन, ओसेम ते अहिय्याह। <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />ते यरहमेलेरी अक होरि कौन्श थी, ज़ैसारू नवं अतारा थियूं। तै ओनामेरी अम्मा थी। <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />ते यरहमेलेरे बड्डे मट्ठे रामेरां मट्ठां मास, यामीन ते एकेर थियां। <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />ते ओनामेरां मट्ठां शम्मै ते यादा थियां। ते शम्मैरां मट्ठां नादाब ते अबीशूर थियां। <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />ते अबीशूरेरी कौन्शरू नवं अबीहैल थियूं, ते तैस सेइं अहबान ते मोलीद पैदा भोए। <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />ते नादाबेरां मट्ठां सेलेद ते अप्पैम थियां। सेलेद त बेऔलाद मेरि जेव ते अप्पैमेरू मट्ठू यिशी थियूं। <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />ते यिशी एरू मट्ठू शेशान ते शेशानेरू मट्ठू अहलै थियूं। <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />फिरी शम्मैरे ढ्ला यादारां मट्ठां येतेर ते योनातान थियां। येतेर त बेऔलाद मेरि जेव। <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />योनातानेरां मट्ठां पेलेत ते जाजा थियां। यरहमेलेरे खानदाने मरां ऐनां भोए। <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />शेशाने त मट्ठां न भोआं, सिर्फ कुइयां भोइ। शेशाने कां यर्हा नंव्वेरो अक मिस्री गुलाम थियो। <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />ते शेशाने अपने कुइयरो ड्लाह तैस सेइं बनाव, ते तैस सेइं अत्तै नंव्वेरू मट्ठू भोवं। <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />ते अत्तैरू मट्ठू नातान ते नातानेरू जाबाद, <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />जाबादेरू एपलाल, एपलालेरू ओबेद, <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />ते ओबेदेरू येहू, येहूएरू अजर्याह, <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />अजर्याहेरू हेलेस, हेलेसेरू एलासा, <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />एलासारू सिस्मै, सिस्मैरू शल्‍लूम, <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />शल्‍लूमेरू यकम्याह ते यकम्याहेरू मट्ठू एलीशामा थियूं।<verse eid="1CH 2:41" /></para>
  <para style="s">कालेबेरू खानदान</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />फिरी यरहमेलेरे ढ्ला कालेबेरां इनां मट्ठां भोआं, तैसेरू बड्डू मट्ठू मेशा ज़ै जीपेरो बाजी भोव। ते मारेशारू मट्ठू हेब्रोन भी तैसेरे खानदाने मरां भोवं। <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />ते हेब्रोनेरां मट्ठां कोरह, तप्पूह, रेकेम ते शेमा थियां। <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />ते शेमारू मट्ठू रहम थियूं। योर्कामेरो बाजी रहम थियो। ते रेकेमेरू मट्ठू शम्मै थियूं। <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />ते शम्मैरू मट्ठू माओन थियूं। ते माओने बेतसूर नगर बसाव। <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />फिरी एपा ज़ै कालेबेरी रखैल थी, तैस सेइं हारान, मोसा ते गाजेज पैदा भोए। ते हाराने अक मट्ठू भोवं तैनी अपने ढ्लाएरे नंव्वे पुड़ तैसेरू नवं गाजेज रख्खू। <verse eid="1CH 2:46" /><verse number="47" style="v" sid="1CH 2:47" />फिरी याहदैरां मट्ठां रेगेम, योताम, गेशान, पेलेत, एपा ते शाप थियां। <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />ते माका ज़ै कालेबेरी रखैल थी, तैसेरां मट्ठां शेबेर ते तिर्हाना थियां। <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />फिरी तैस शाप ते शवा नंव्वेरां दूई होरां मट्ठां भोआं, शाप, ज़ैनी मदमन्ना नगर बसाव, ते शवा, ज़ैनी मकबेना ते गिबा नगरां बसां। ते कालेबेरी कुई अकसा थी। <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />कालेबेरे खानदाने मां इनां भोए। एप्रातारे बड्डे मट्ठे हूरेरे मट्ठे शोबाले किर्यत्यारीम नगर बसाव, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />सल्मा बैतलहम नगर बसाव ते हारेपे बेतगादेर नगर बसाव। <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />ते किर्यत्यारीम नगर बसाने बाले शोबालेरे खानदाने मां हारोए अध्धे मनुहोत नगरेरे रानेबाले, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />ते किर्यत्यारीमेरे कुले मरां येतेरी, पूती, शूमाती ते मिश्राई ते एन सेइं सोराई ते एश्ताओली निस्से। <verse eid="1CH 2:53" /><verse number="54" style="v" sid="1CH 2:54" />बैतलहम नगर बसाने बाले सल्मारे खानदाने मां नतोपाई, अत्रोतबेत्योआब ते अधे मानहती, सोरी। <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />याबेस नगरेरे मां रानेबाले लिखनेबालां केरे कुले मरां तिराती, शिमाती ते सूकाती भोए। इनां रेकाबेरे घरानेरे पूर्वज हम्मतेरे खानदानेरे केनी कुलेरे लोकन।<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">दाऊद राज़ेरी खानदानी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />दाऊदेरां मट्ठां ज़ैना हेब्रोन नगरे मां तैस भोआं तैना इना आन: तैसेरू बड्डू मट्ठू अम्नोन ज़ैन यिज्रेल नगरेरे अहीनोअमी सेइं पैदा भोव, ते दूइयोवं दानिय्येल ज़ैन कर्मेल नगरेरे अबीगैली सेइं पैदा भोव। <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />ट्लेइयोवं अबशालोम ज़ैन गशूर नगरेरे राज़े तल्मैरी कुई माकारू मट्ठू थियूं, च़ेवरोवं अदोनिय्याह ज़ैन हग्गीतरू मट्ठू थियूं। <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />पंच़ोंव शपत्याह ज़ैन अबीतली सेइं पैदा भोवं, ते शेइयोवं यित्राम ज़ैन तैसेरी कौन्श एग्ला सेइं पैदा भोवं। <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" />दाऊदेरां हेब्रोन नगरे मां शा मट्ठां पैदा भोआं, ते तैनी तैड़ी सड़े सत साल हुकूमत की। ते यरूशलेम नगरे मां तैनी 33 साल हुकूमत की। <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />यरूशलेम नगरे मां तैस इनां मट्ठां भोआं: शिमा, शोबाब, नातान ते सुलैमान, इनां च़ेवरे अम्मीएलेरी कुई बतशेबा सेइं पैदा भोआं। <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />बाकी मट्ठां इनां थियां, यिभार, एलीशामा एलीपेलेत, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />नोगह, नेपेग, यापी, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />एलीशामा, एल्यादा ते एलीपेलेत, इनां 9 मट्ठां थियां। <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />इनां सब दाऊदेरां मट्ठां थियां। ते इन केरे अलावा रखैलां केरां भी मट्ठां थियां, ते तैन केरि बेइन तामार थी।<verse eid="1CH 3:9" /></para>
  <para style="s">सुलैमानेरू खानदान</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />फिरी सुलैमानेरू मट्ठू रहबाम थियूं; ते रहबामेरू मट्ठू अबिय्याह, अबिय्याहेरू आसा, आसारू यहोशापात, <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />यहोशापातेरू योराम, योरामेरू अहज्याह, अहज्याहेरू योआश; <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />ते योआशेरू अमस्याह, अमस्याहेरू अजर्याह, अजर्याहेरू योताम; <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />ते योतामेरू आहाज, आहाजेरू हिजकिय्याह, हिजकिय्याहेरू मनश्शे; <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />मनश्शेरू आमोन, आमोनेरू मट्ठू योशिय्याह थियूं।<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 1:7-10">मत. 1:7-10</ref>.</char></note> <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" />ते योशिय्याहेरां मट्ठां इनां थियां: तैसेरू बड्डू मट्ठू योहानान, दूइयोवं यहोयाकीम; ट्लेइयोवं सिदकिय्याह, च़ेवरोवं शल्‍लूम। <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" />यहोयाकीमेरू मट्ठू यकोन्याह, ते यकोन्याहेरू मट्ठू सिदकिय्याह थियूं।<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="MAT 1:11">मत. 1:11</ref>.</char></note> <verse eid="1CH 3:16" /><verse number="17" style="v" sid="1CH 3:17" />ते यकोन्याह ज़ै बाबेले मां कैदी बनेइतां नेवरो थियो तैसेरां इनां मट्ठां थियां: शालतीएल,<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 1:12">मत. 1:12</ref>;<ref loc="LUK 3:27">लूक. 3:27</ref>.</char></note> <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />मल्कीराम, पदायाह, शेनस्सर, यकम्याह, होशामा ते नदब्याह। <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />ते पदायाहेरां मट्ठां जरुब्बाबेल ते शिमी थियां। ते जरुब्बाबेलेरां मट्ठां मशुल्‍लाम ते हनन्याह भोआं, ज़ैन केरि बेइन शलोमीत थी। <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />ते जरुब्बाबेलेरां पंच़ मट्ठां होरां भी थियां, हशूबा, ओहेल, बेरेक्याह, हसद्याह ते यूशब-हेसेद। <verse eid="1CH 3:20" /><verse number="21" style="v" sid="1CH 3:21" />ते हनन्याहेरां मट्ठां पलत्याह ते यशायाह थियां। यशायाहेरू मट्ठू रपायाह, ते तैसेरू मट्ठू अर्नान, अर्नानोनेरू मट्ठू ओबद्याह, ते ओबद्याहेरू मट्ठू शकन्याह थियूं। <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />ते शकन्याहेरू मट्ठू शमायाह, ते शमायाहेरां मट्ठां हत्तूश ते यिगाल, बारीह, नार्याह ते शापात, इन शा शकन्याहेरे खानदाने मरां थिये। <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />ते नार्याहेरां ट्लाई मट्ठां इनां थियां, एल्योएनै, हिजकिय्याह ते अज्रीकाम। <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />ते एल्योएनैरां सत मट्ठां इनां थियां, होदव्याह, एल्याशीब, पलायाह, अक्‍कूब, योहानान, दलायाह ते अनानी।<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">यहूदारी वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />यहूदारे खानदाने मरां इनां थिये: पेरेस<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">पेरेस </char><char style="ft" closed="false">सिर्फ पेरेस यहूदारू मट्ठू थियूं, बाकी यहूदारे खानदाने मरां थिये।</char></note>, हेस्रोन, कर्मी, हूर ते शोबाल। <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />ते शोबालेरू रायाह थियूं, रायाहेरू मट्ठू यहत थियूं ते यहतेरां मट्ठां अहूमै ते लहद थियां, एना सोराई कुल आन। <verse eid="1CH 4:2" /><verse number="3" style="v" sid="1CH 4:3" />एतामेरां मट्ठां इनां थियां: यिज्रेल, यिश्मा, ते यिद्वाश, ज़ैन केरि बेइनरू नवं हस्सलेलपोनी थियूं। <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />ते पनूएले गदोर नगरे बसाव, ते एजेरे हूशाह नगर बसाव। इनां एप्रातारे बड्डे मट्ठेरी हूरेरी औलाद थी, एप्राता बैतलहम नगर बसावरू थियूं। <verse eid="1CH 4:4" /><verse number="5" style="v" sid="1CH 4:5" />ते तकोआ नगरेरे बसाने बाले अशहूरेरी हेला ते नारा, नंव्वेरी दूई कौन्शां थी। <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />नारारां मट्ठां इनां थियां: अहुज्जाम, हेपेर, तेमनी ते हाहशतारी। <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />ते हेलारां मट्ठां इनां थियां: सेरेत, यिसहर ते एत्नान। <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />कोसेरां मट्ठां आनूब ते सोबेबा थियां ते तैसेरे खानदाने मरां हारूमेरू मट्ठू अहर्हेलेरू कुल भी थियूं। <verse eid="1CH 4:8" /><verse number="9" style="v" sid="1CH 4:9" />ते याबेस अपने ढ्लान करां जादे इज़्ज़त मैल्ही, ते तैसेरी अम्मा एन ज़ोइतां तैसेरू नवं याबेस रख्खू, “कि मीं एस बड़े तकलीफी सेइं ज़र्म दित्तोरूए।” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />एक्सां याबेसे इस्राएलेरे परमेशरे कां एन ज़ोइतां प्राथना की, “रोड़ू भोथू, कि तू मीं सच़्च़े बरकत देथो, ते मेरी हद बद्धातो, ते तेरो हथ मीं पुड़ राथो, ते तू मीं बुरैई करां एन्च़रे बच़ेइतां रखेथो कि अवं तैस करां दुखी न भोथो!” ते ज़ैन किछ तैनी मग्गु, तैन परमेशरे तैस दित्तू। <verse eid="1CH 4:10" /><verse number="11" style="v" sid="1CH 4:11" />फिरी शूहारे ढ्ला कलूबे सेइं महीर पैदा भोव ज़ै एशतोनेरो बाजी थियो। <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />एशतोनेरे मट्ठां बेतरापा, पासेह ते तहिन्ना थियां। तहिन्ना ईर्नाहाश नगर बसाव, पन तैन केरे घरानेरे लोक रेका नगरे मां रहते थिये। <verse eid="1CH 4:12" /><verse number="13" style="v" sid="1CH 4:13" />कनजेरां मट्ठां इनां थियां: ओत्नीएल ते सरायाह, ते ओत्नीएलेरां मट्ठां हतत ते मोनोतै थियां। <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />मोनोतैरू मट्ठू ओप्रा थियूं। ते सरायाहेरू मट्ठू योआब थियूं ज़ैनी गेहराशीम वादी बसाई; किजोकि तैट्ठेरे लोक कारीगिर थिये। <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" />ते यपुन्नेरे मट्ठे कालेबेरां मट्ठां इनां थियां: ईरू, एला ते नाम। ते एलारू मट्ठू कनज थियूं। <verse eid="1CH 4:15" /><verse number="16" style="v" sid="1CH 4:16" />यहलेलेरां मट्ठां जीप, जीपा, तीरया ते असरेल थियां। <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />ते एज्रारां मट्ठां: येतेर, मेरेद, एपेर ते यालोन, ते मेरेदेरी कौन्श बित्या ज़ै मिस्रेरे राज़ेरे कुई थी तैसेरां मट्ठां इनां थियां, मिर्याम, शम्मै ते यिशबह। यिशबहे एश्तमो नगर बसाव। <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />मेरेदेरी एक्‍की होरी यहूदी कौन्शां येरेद, हेबेर ते यकूतीएले ज़र्म दित्तू। येरेदे गदोर नगर बसाव, हेबेरे सोको नगर बसाव, यकूतीएले जानोह नगर बसाव। <verse eid="1CH 4:18" /><verse number="19" style="v" sid="1CH 4:19" />ते होदिय्याहरी कौन्श ज़ै नहमेरी बेइन थी, तैसेरां दूई मट्ठां थियां, तैन सेइं गेरेमी ते माकाई कुल च़ले। गेरेमी कीला नगरे मां रहते थिये ते माकाई एश्तमो नगरे मां रहते थिये। <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />ते शिमोनेरां मट्ठां अम्नोन, रिन्ना, बेन्हानान ते तोलोन थियां। ते यिशीएरां मट्ठां जोहेत ते बेनजोहेत थियां। <verse eid="1CH 4:20" /><verse number="21" style="v" sid="1CH 4:21" />यहूदारां मट्ठे शेलारां मट्ठां इनां थियां: एर, ज़ैनी लेका नगर बसाव, लादा, ज़ैनी मारेशा नगर बसाव, ते इसेरे अलावा तैसेरे खानदानेरे लोक बेत-अशब नगरे मां रहते थिये, ज़ैना सनेरां लिगड़ां बुन्नेरू कम केरते थिये। <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />ते योकीम ते कोजेबा नगरेरे लोक ते योआश ते साराप ज़ैना मोआबे मां हुकूमत केरते थिये ते तैना याशूब-लेहेम नगरे मां राने लगे। ई पुरानो इतिहासे। <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />इन मरां किछ लोक कुम्हार थिये, ते नताईम ते गदेरा नगरन मां रहते थिये ज़ैड़ी तैना राज़े कां रहते थिये ते तैसेरू कम काज़ केरते थिये।<verse eid="1CH 4:23" /></para>
  <para style="s">शिमोनेरू खानदान</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />शिमोनेरां मट्ठां नमूएल, यामीन, यारीब, जेरह ते शाऊल थियां। <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />शाऊलेरू मट्ठू शल्‍लूम, शल्‍लूमेरू मट्ठू मिबसाम ते मिबसामेरू मट्ठू मिश्मा थियूं। <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />ते मिश्मारू मट्ठू हम्मूएल, तैसेरू मट्ठू जक्‍कूर, ते तैसेरू मट्ठू शिमी थियूं। <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" />शिमीएरां 16 मट्ठां ते 6 कुइयां भोइ, पन तैसेरे ढ्लां केरे जादे बच्‍चे न भोए। ते तैन केरू सारू कुल यहूदी केरू ज़ेरू न बधु। <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />तैना इन नगरन मां रहते थिये: बेर्शेबा, मोलादा, हसर्शूआल, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />बिल्हा, एसेम, तोलाद, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />बतूएल, होर्मा, सिकलग, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />बेत्मर्काबोत, हसर्सूसीम, बेतबिरी ते शारैम। दाऊदेरे राज़ो बन्नेरे वक्ते तगर तैना इन नगरन मां राने लगे। <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />ते तैन नगरां केरां ड्लाव्वां एताम, ऐन, रिम्मोन, तोकेन ते आशान नंव्वेरां पंच़ नगरां। <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />ते बाल नगरे तगर ज़ेत्रां ड्लाव्वां, इन्ना नगरां केरे आसे-पासे थियां, तैन केरि बस्सनेरी ठारां इन्ना थी, ते ई तैन केरि खानदानी आहे।<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />फिरी मशोबाब, यम्लेक, अमस्याहेरू मट्ठू योशा। <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />योएल, योशिब्याहरू मट्ठू येहू, ज़ैन सरायाहेरू पोट्लड़ू, ते असीएलेरू पड़पोट्लड़ू थियूं, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />ते एल्योएनै, याकोबा, यशोहायाह, असायाह, अदीएल, यसीमीएल, बनायाह, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />ते शिपी एरू मट्ठू जीजा ज़ैन अल्‍लोनेरू मट्ठू, इन यदायाहेरू मट्ठू, इन शिम्री एरू मट्ठू, इन शमायाहेरू मट्ठू थियूं। <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />इना ज़ैन केरां नंव्वां लिखोरन, अपने-अपने कुले मां प्रधान थिये; ते तैन केरे पूर्वजां केरे घराने बड़े बेधी जे। <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />एना लोक अपने गब्बां केरे लेई च़ारनेरी ठार तोपनेरे लेई गदोर नगरेरे पूर्वेरे पासे तगर जे। <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />ते तैन रोड़े करां रोड़ी च़ारनेरी ठार मैल्ही, ते मुल्ख लम्मो-चौड़ो, ते आरामेरी जगाह थी। किजोकि तैड़ी पेइले रानेबाले हामेरे खानदानेरे लोक थिये। <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />ते ज़ैन केरां नंव्वां बह लिखोरन, तैनेईं यहूदारे राज़े हिजकिय्याहेरे राज़ केरनेरे वक्ते मां एइतां ज़ैना मूनी कौमरे लोक तैड़ी मैल्हे, तैना डेरन सने मैरतां एरहो सत्यानाश केरतां छ़डू कि अज़ तगर तैन केरो पतो नईं, ते तैना तैन केरे ठारी मां राने लगे, किजोकि तैड़ी तैन केरे गब्बां केरे लेई च़ारनेरी ठार थी। <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />शिमोनी लोकन मरां 500 मड़द एप्पु पुड़, पलत्याह, नार्याह, रपायाह ते उज्जीएल नंव्वेरे यिशीएरां मट्ठां अपने लेई प्रधान बनाए। <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />तैखन तैना पहाड़े पुड़ जो जे, ते ज़ैना अमालेकी बेंच़तां रेई जेवरे थिये तैना मारे, ते तैना अज़्ज़ेरे दिहाड़न तगर तैड़ी रहतन।<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">रूबेनेरू खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />इस्राएलेरू बड्डू मट्ठू त रूबेन थियूं, पन तैनी अपने बाजी केरि रखैली सेइं कुकर्म कियो, तैस वजाई सेइं बड्डे भोनेरू हक इस्राएले यूसुफेरे मट्ठन दित्तोरू थियूं। एल्हेरेलेइ वंशावली बड्डे भोनेरे मुताबिक न भोइ। <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />यहूदा अपने ढ्लान करां ताकतबर भोइ जेव, ते प्रधान तैसेरे खानदाने मरां भोव, पन बड्डे भोनेरू हक यूसुफेरू थियूं। <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />इस्राएलेरे बड्डे मट्ठे रूबेनेरां मट्ठां इनां थियां: हनोक, पल्‍लू, हेस्रोन ते कर्मी। <verse eid="1CH 5:3" /><verse number="4" style="v" sid="1CH 5:4" />योएलेरू मट्ठू शमायाह, शमायाहेरू गोग, गोगेरू शिमी, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />शिमीएरू मीका, मीकारू रायाह, रायाहेरू बाल, <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />बालेरू बएराह, ते तै रूबेनी लोकां केरो प्रधान थियो। पन अश्शूरेरे राज़े तिग्लत्पिलेसेरे तै गुलाम बनेइतां अपने मुल्खे जो नेव। <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" />ते तैसेरे ढ्लां केरि खानदानी लिखनेरे मौके तैना अपने-अपने कुलां केरे मुताबिक इना भोए, प्रधान त यीएल थियो, फिरी जकर्याह, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />ते अजाजेरू मट्ठू बेला ज़ैन शेमारू पोट्लड़ू ते योएलेरू पड़पोट्लड़ू थियूं, तैना अरोएर नगरे मां नबो पहाड़े ते बालमोन नगरे तगर रहते थिये। <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />ते पूर्वेरे पासे तै तैस सुनसान ठैरारे बन्ने तगर राव ज़ै फरात दरिया तगर पुज़ते, किजोकि तैन केरे जानबर गिलाद प्रदेशे मां बेधी जेवरे थिये। <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />ज़ैस वक्ते शाऊल राज़ो थियो तैस वक्त रूबेन गोट्लेरे लोकेईं हग्री लोकन सेइं जंग की, ते तैनेईं हग्री हाराए; तैखन तैना गिलाद प्रदेशेरे पूर्वेरे पासे अपने डेरन मां राने लगे।<verse eid="1CH 5:10" /></para>
  <para style="s">गादेरू खानदान</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />गादी लोक तैन केरे नेड़े सल्का नगरे तगर बाशान प्रदेशे मां रहते थिये। <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />प्रधान त योएल थियो, ते दूइयोवं शापाम, फिरी यानै, ते शापात, इनां बाशाने मां रहते थिये। <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />ते तैन केरे सत ढ्ला अपने-अपने पूर्वजां केरे घराना केरे मुताबिक मीकाएल, मशुल्‍लाम, शेबा, योरै, याकान, जीअ, ते एबेर थिये। <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />इन अबीहैलेरू खानदान थियूं। अबीहैल हूरीएरू मट्ठू थियूं, हूरी योराहेरू मट्ठू, योराह गिलादेरू मट्ठू, गिलाद मीकाएलेरू मट्ठू, मीकाएल यशीशैरू मट्ठू, यशीशै यहदोएरू मट्ठू, यहदो बूजेरू मट्ठू थियूं। <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />एन केरे पूर्वजां केरे घरानेरो प्रधान अब्दीएलेरू मट्ठू, ते गूनी एरू पोट्लड़ू अही थियूं। <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />एना गादी लोक बाशाने मां, गिलाद प्रदेश ते तैसेरे ड्लाव्वन मां, ते शारोनेरे सारे चरागान मां तैसेरे होरि पासे तगर रहते थिये। <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />ई सारी वंशावली ज़ैस वक्ते लिखी जेई, तैस वक्ते यहूदा प्रदेशे पुड़ योताम राज़ो राज़ केरतो थियो ते इस्राएल मुल्खे पुड़ यारोबाम राज़ो राज़ केरतो थियो। <verse eid="1CH 5:17" /><verse number="18" style="v" sid="1CH 5:18" />रूबेनी ते गादी ते मनश्शेरे अधे गोट्लेरे जंग लड़नेबाले सिपाही ज़ैना ढाल बन्धने, तलवार च़लाने, ते धनुषे सेइं तीर मारनेरे काबल ते ज़ैनेईं जंग केरनी शिखोरी थी, तैना 44760 थिये, ज़ैना जंगी मां गांनेरे काबल थिये। <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />तैनेईं हग्री लोकन सेइं ते यतूर, नापीश ते नोदाब नगरां केरे लोकन सेइं जंग कियोरी थी। <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />ते तैन केरे खलाफ एन मद्दत मैल्ही, ते हग्री तैन सेभन समेत ज़ैना तैस सेइं थिये, तैन केरे हथ्थे मां दित्ते जे, किजोकि जंगी मां तैनेईं परमेशरे करां मद्दतरे लेई बिनती कियोरी थी, ते तैनी तैन केरि बिनती एल्हेरेलेइ शुनी, कि तैनेईं तैस पुड़ भरोसो कियो। <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />ते इस्राएली लोकेईं हग्री लोकां केरे इनां जानबर भी ने, ऊँट त 50000, गब्बां 250000, गधे 2000, ते लोक 100000 गुलाम बनेइतां नीए। <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />पन बड़े हग्री दुश्मन मरोरे थिये किजोकि तै लड़ाई परमेशरेरी तरफां भोवरी थी। ते रूबेन, गाद ते मनश्शेरे अधे गोट्लां केरे लोक तैन केरि जगाई मां गुलैमरे वक्ते तगर बस्सोरे राए।<verse eid="1CH 5:22" /></para>
  <para style="s">मनश्शेरे खानदान</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />फिरी मनश्शेरे अधे गोट्लेरे लोक तैस मुल्खे मां बेस्सी जे, ते तैना बाशाने करां लेइतां बालहेर्मोन ते सनीर ते हेर्मोन पहाड़े तगर फैली जे। <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />ते तैन केरे पूर्वजां केरे घराना केरे प्रधान इनां थिये: एपेर, यिशी, एलीएल, अज्रीएल, यिर्मयाह, होदव्याह ते यहदीएल, इनां बड़े बहादर जंग लड़नेबाले ते नामी ते अपने पूर्वजां केरे घरानेरे प्रधान थिये। <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />पन तैना अपने पूर्वजां केरे घराना केरे परमेशरे सेइं वफादार न राए, ते तैस मुल्खेरे कनानी लोक ज़ैना परमेशरे तैन केरे सामने नाश कियोरे थिये, तैन केरे देबतन पत्ती बदचलन कौन्शरे ज़ेरे च़लने लगे। <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />एल्हेरेलेइ इस्राएलेरे परमेशरे अश्शूरेरे राज़ो पूल ते अश्शूरेरे राज़े तिग्लत्पिलेसेरेरो मन भड़कव, ते तैनेईं रूबेनी, गादी ते मनश्शेरे अधे गोट्लेरे लोक गुलाम बनेइतां हलह नगर, हाबोर दरिया ते हारा नगर ते गोजान दरियारे बन्ने पुड़ पुज़ाए। ते तैना अज़ तगर तैड़ी रहतन।<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">लेवेरी खानदानी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />लेवेरां ट्लाई मट्ठां गेर्शोन, कहात ते मरारी थियां। <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" />ते कहातेरां मट्ठां अम्राम, यिसहार, हेब्रोन ते उज्जीएल थियां। <verse eid="1CH 6:2" /><verse number="3" style="v" sid="1CH 6:3" />ते अम्रामेरां मट्ठां हारून, मूसा थियां, ते मिर्याम तैसेरी कुई थी। ते हारूनेरां मट्ठां नादाब, अबीहू, एलीआजर ते ईतामार थियां। <verse eid="1CH 6:3" /><verse number="4" style="v" sid="1CH 6:4" />एलीआजरेरू मट्ठू पीनहास, पीनहासेरू अबीशू, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />अबीशूएरू बुक्‍की, बुक्‍कीएरू उज्जी, <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />उज्जीएरू जरहयाह, जरहयाहेरू मरायोत, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />मरायोतेरू अमर्याह, अमर्याहेरू अहीतूब, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />अहीतूबेरू सादोक, सादोकेरू अहीमास, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />ते अहीमासेरू अजर्याह, अजर्याहेरू योहानान, <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />योहानानेरू मट्ठू अजर्याह थियूं (ज़ै सुलैमानेरे यरूशलेम नगरे मां बनेवरे भवने मां याजकेरू कम केरतो थियो)। <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />अजर्याहेरू मट्ठू अमर्याह, अमर्याहेरू अहीतूब, <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />अहीतूबेरू सादोक, ते सादोकेरू शल्‍लूम, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />शल्‍लूमेरू हिल्किय्याह, हिल्किय्याहेरू अजर्याह, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />अजर्याहेरू सरायाह, ते सरायाहेरू मट्ठू यहोसादाक थियूं। <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />ते ज़ैखन यहोवा, यहूदा ते यरूशलेमेरे लोक बाबेलेरे राज़े नबूकदनेस्सरे गुलाम बनेइतां निये, तैखन यहोसादाक भी गुलाम बेनतां जेव। <verse eid="1CH 6:15" /><verse number="16" style="v" sid="1CH 6:16" />लेवरां मट्ठां गेर्शोम, कहात ते मरारी थियां। <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" />ते गेर्शोमेरां मट्ठां केरां नंव्वां इनां थियां, लिब्नी ते शिमी। <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" />ते कहातेरां मट्ठां अम्राम, यिसहार, हेब्रोन ते उज्जीएल थियां। <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" />ते मरारी एरां मट्ठां महली ते मूशी थियां। अपने-अपने पूर्वजां केरे घरानेरे मुताबिक लेवी केरां कुल इनां आन। <verse eid="1CH 6:19" /><verse number="20" style="v" sid="1CH 6:20" />गेर्शोमेरू मट्ठू लिब्नी थियूं, लिब्नी एरू यहत, यहतेरू जिम्मा, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />ते जिम्मारू मट्ठू योआह, ते योआहरू मट्ठू इद्दो, इद्दोरू मट्ठू जेरह, ते जेरहेरू मट्ठू यातरै थियूं। <verse eid="1CH 6:21" /><verse number="22" style="v" sid="1CH 6:22" />फिरी कहातेरू मट्ठू अम्मीनादाब थियूं, अम्मीनादाबेरू मट्ठू कोरह, कोरहेरू अस्सीर, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />अस्सीरेरू एल्काना, एल्कानारू एब्यासाप भोव, एब्यासापेरू अस्सीर, <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />अस्सीरेरू तहत, तहतेरू ऊरीएल, ऊरीएलेरू उज्जियाह, उज्जियाहेरू मट्ठू शाऊल थियूं। <verse eid="1CH 6:24" /><verse number="25" style="v" sid="1CH 6:25" />फिरी एल्कानारां मट्ठां अमासै ते अहीमोत थियां। <verse eid="1CH 6:25" /><verse number="26" style="v" sid="1CH 6:26" />अहीमोतेरू मट्ठू एल्काना एल्कानारू मट्ठू सोपै, सोपैरू नहत, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />नहतेरू एलीआब, एलीआबेरू यरोहाम, ते यरोहामेरू मट्ठू एल्काना थियूं। <verse eid="1CH 6:27" /><verse number="28" style="v" sid="1CH 6:28" />शमूएलेरां मट्ठां इनां थियां: तैसेरू बड्डू मट्ठू योएल ते दूइयोवं अबिय्याह थियूं। <verse eid="1CH 6:28" /><verse number="29" style="v" sid="1CH 6:29" />फिरी मरारीएरू मट्ठू महली, महलीएरू लिब्नी, लिब्नी एरू शिमी, शिमीएरू उज्जा। <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />उज्जारू शिमा; ते शिमारू हग्गिय्याह ते हग्गिय्याहेरू मट्ठू असायाह थियूं।<verse eid="1CH 6:30" /></para>
  <para style="s">परमेशरेरे भवनेरे संगीतकार</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />फिरी ज़ैना दाऊद राज़े सन्दूखेरे भवने मां रखनेरां बाद, यहोवारे भवने मां ज़ैना गीतां ज़ोनेबाले केरे प्रधान रखोरे थिये तैना इनां थिये। <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />ज़ैखन तगर सुलैमाने यरूशलेम नगरे मां यहोवारो भवन न बनाव, तैखन तगर तैना मिलापे बाले तेम्बेरी रानेरी ठारारे सामने गीतां ज़ोनेरे ज़िरिये सेवा केरते थिये। ते एस सेवाई मां नियमेरे मुताबिक हाज़र भोते थिये। <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />ज़ैना अपने-अपने मट्ठन सने हाज़र भोते थिये तैना इना आन: कहाती लोकन मरां हेमान गीतां ज़ोने बालो ज़ैन योएलेरू मट्ठू थियूं, योएल शमूएलेरू मट्ठू थियूं, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />शमूएल एल्कानारू, एल्काना यरोहामेरू, यरोहाम एलीएलेरू, एलीएल तोहेरू, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />तोह सूफेरू, सूफ एल्कानारू, एल्काना महतेरू, महत अमासैरू, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />अमासै एल्कानारू, एल्काना योएलेरू, योएल अजर्याहेरू, अजर्याह सपन्याहेरू, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />सपन्याह तहतेरू, तहत अस्सीरेरू, अस्सीर एब्यासापेरू, एब्यासाप कोरहेरू, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />कोरह यिसहारेरू, यिसहार कहातेरू, ते कहात लेवेरू ते लेवी इस्राएलेरू मट्ठू थियूं। <verse eid="1CH 6:38" /><verse number="39" style="v" sid="1CH 6:39" />ते तैसेरो ढ्ला आसाप ज़ै तैसेरे देइने पासे खड़ो रहतो थियो तैन बेरेक्याहेरू मट्ठू थियूं, ते बेरेक्याह शिमाएरू, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />शिमा मीकाएलेरू, मीकाएल बासेयाहेरू, बासेयाह मल्किय्याहेरू, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />मल्किय्याह एत्नीएरू, एत्नी जेरहेरू, जेरह अदायाहेरू, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />अदायाह एतानेरू, एतान जिम्मारू, जिम्मा शिमीएरू, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />शिमी यहतेरू, यहत गेर्शोमेरू, गेर्शोम लेवेरू मट्ठू थियूं। <verse eid="1CH 6:43" /><verse number="44" style="v" sid="1CH 6:44" />ते बांए पासे तैन केरे भियाल मरारी लोक खड़े भोते थिये, एतान ज़ैन कीशी एरू मट्ठू थियूं, कीशी अब्दी एरू, अब्दी मल्‍लूकेरू, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />मल्‍लूक हशब्याहेरू, हशब्याह अमस्याहेरू, अमस्याह हिल्किय्याहेरू, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />हिल्किय्याह अमसी एरू, अमसी बानीएरू, बानी शेमेरू, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />शेमेर महलीएरू, महली मूशीएरू, मूशी मरारीएरू, मरारी लेवेरू मट्ठू थियूं। <verse eid="1CH 6:47" /><verse number="48" style="v" sid="1CH 6:48" />ते इन केरे ढ्ला ज़ैना लेवी थिये तैना परमेशरेरे भवनेरी रानेरी ठारारे हर किसमेरी सेवारे लेई च़ुनोरे थिये।<verse eid="1CH 6:48" /></para>
  <para style="s">हारूनेरां मट्ठां</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />पन हारून ते तैसेरां मट्ठां होमबेलरी वेदी ते धूपेरी वेदी दूईने पुड़ बलिदान च़ाढ़ते, ते परमपवित्र ठारारू सारू कम केरते थिये, ते इस्राएली केरे लेई प्रायश्चित केरते थिये, ज़ेन्च़रे कि परमेशरेरे दास मूसा हुक्म दित्तोरो थियो। <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />ते हारूनेरे खानदाने मां इनां भोए: तैसेरू मट्ठू एलीआजर थियूं, ते एलीआजरेरू पीनहास, पीनहासेरू अबीशू, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />अबीशूएरू बुक्‍की, बुक्‍कीएरू उज्जी, उज्जीएरू जरहयाह, <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />जरहयाहेरू मरायोत, मरायोतेरू मट्ठू अमर्याह, अमर्याहेरू अहीतूब, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />अहीतूबेरू सादोक ते सादोकेरू मट्ठू अहीमास थियूं।<verse eid="1CH 6:53" /></para>
  <para style="s">लेवी लोकां केरि ठहरेवरी रानेरी ठारां</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />तैन केरे हिस्सन मां तैन केरे डेरां केरे मुताबिक बेसती इनां आन, कहातेरे कुलन मां पेइली चिट्ठी ज़ै हारूनेरे खानदानेरे नंव्वे पुड़ निस्सी। <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />च़ेवरे पासां केरि चरागान समेत यहूदा प्रदेश ते हेब्रोन नगर तैन मैल्हू। <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />पन तैस नगरेरां ऊडारां ते ड्लाव्वां यपुन्नेरे मट्ठे कालेबे दित्तां जेआं। <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />ते हारूनेरे खानदाने शरणनगर हेब्रोन, ते चरागान समेत लिब्ना, यत्तीर, एश्तमो, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />हीलेन, दबीर, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />आशान ते बेतशेमेश नगरां दित्तां। <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />ते बिन्यामीनेरे गोट्ले अपने-अपने चरागान समेत गेबा, आलेमेत ते अनातोत नगरां दित्तां जेआं। तैन केरे घराना केरे सारे 13 नगर थिये।<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />ते बाकी कहाती लोकां केरे गोट्लेरे कुल, मनश्शेरे अधे गोट्ले चिट्ठी छ़ेडतां 10 नगर दित्ते जे। <verse eid="1CH 6:61" /><verse number="62" style="v" sid="1CH 6:62" />ते गेर्शोमी लोकां केरे खानदानेरे मुताबिक इस्साकार, आशेर, ते नप्ताली एरे गोट्ल, ते बाशान प्रदेशे मां रानेबाले मनश्शेरे गोट्ले 13 नगर मैल्हे। <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" />मरारी गोट्लेरे कुलां केरे मुताबिक तैन रूबेन, गाद ते जबूलूनेरे गोट्ले मरां चिट्ठी छ़ेडतां 12 नगर दित्ते जे। <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />इस्राएली लोकेईं लेवी लोकन इनां नगरां चरागान समेत दित्तां। <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />तैनेईं यहूदी, शिमोनी, ते बिन्यामीनी लोकां केरे गोट्लन मरां तैना नगर दित्तां, ज़ैन केरां नंव्वां बह लिखोरन।<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />ते कहाती लोकां केरे बड़े कुलन तैन केरे नगर एप्रैमेरे गोट्ले मरां मैल्हे। <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />तैन अपने-अपने चरागान समेत एप्रैमेरो पहाड़ी प्रदेश ते शेकेम ज़ैन शरणनगर थियूं, ते फिरी गेजेर, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />योकमाम, बेथोरोन, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />अय्यालोन ते गत्रिम्मोन, <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />ते मनश्शेरे अधे गोट्ले मरां अपने-अपने चरागान समेत आनेर ते बिलाम नगरां बाकी कहाती लोकां केरे कुले मैल्हां। <verse eid="1CH 6:70" /><verse number="71" style="v" sid="1CH 6:71" />फिरी गेर्शोमी लोकन मनश्शेरे अधे गोट्ले मरां अपने-अपने चरागान समेत बाशानेरू गोलन ते अश्तारोत। <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />ते इस्साकारेरे गोट्ले मरां अपने-अपने चरागान समेत केदेश, दाबरात, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />रामोत ते आनेम, <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />ते आशेरेरे गोट्ले मरां अपने-अपने चरागान समेत माशाल, अब्दोन, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />हूकोक ते रहोब। <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />ते नप्ताली केरे गोट्ले मरां अपने-अपने चरागान समेत गलील प्रदेशेरू केदेश नगर, ते हम्मोन, किर्यातैम नगरां मैल्हां। <verse eid="1CH 6:76" /><verse number="77" style="v" sid="1CH 6:77" />फिरी बाकी लेवी खानदानेरे मरारी लोकन जबूलूनेरे गोट्ले मरां अपने-अपने चरागान समेत रिम्मोन ते ताबोर। <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />ते यरीहो नगरे कां यरदन दरियाएरे पूर्वेरे पासे रूबेनेरे गोट्ले मरां अपने-अपने चरागान समेत सुनसान ठारारू बेसेर, यहस, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />कदेमोत ते मेपात। <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />ते गादेरे गोट्ले मरां अपने-अपने चरागान समेत गिलाद प्रदेशेरां रामोत महनैम, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />हेशबोन, ते याजेर नगरां दित्तां जेआं।<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">इस्साकारेरू खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />इस्साकारेरां च़ेवर मट्ठां इनां थियां: तोला, पूआ, याशूब ते शिम्रोन। <verse eid="1CH 7:1" /><verse number="2" style="v" sid="1CH 7:2" />ते तोलारां मट्ठां इनां थियां: उज्जी, रपायाह, यरीएल, यहमै, यिबसाम ते शमूएल, इनां अपने-अपने पूर्वजां केरे घराने मतलब तोलाएरे खानदानेरे प्रधान ते बड़े बहादर थिये, ते ज़ैस वक्त दाऊद राज़ो राज़ केरतो थियो तैस वक्त तैन केरि गिनती 22600 थी। <verse eid="1CH 7:2" /><verse number="3" style="v" sid="1CH 7:3" />ते उज्जीएरू मट्ठू यिज्रह्याह, ते यिज्रह्याहेरां च़ेवर मट्ठां इनां थियां, मीकाएल, ओबद्याह, योएल, ते यिश्शिय्याह। इना सब अपने घरानेरे प्रधान थिये। <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />ते तैन सेइं साथी तैन केरे वंशावली ते पूर्वजां केरे घरानेरे मुताबिक सेनारे टोली केरे 36000 सिपाही थी। किजोकि तैन केरि बेड़ि कौन्शां ते मट्ठां थियां। <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />ते तैन केरे भियाल ज़ैना इस्साकारेरे कुलन मरां थिये, तैना 87000 बड़े बहादर थिये, ज़ैना अपने-अपने खानदानेरे मुताबिक गने जे।<verse eid="1CH 7:5" /></para>
  <para style="s">बिन्यामीनी ते नप्ताली एरी खानदानी</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />बिन्यामीनेरां ट्लाई मट्ठां इनां थियां: बेला, बेकेर ते यदीएल। <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />बेलारां पंच़ मट्ठां इनां थियां: एसबोन, उज्जी, उज्जीएल, यरीमोत, ते ईरी। इनां अपने-अपने पूर्वजां केरे खानदानेरे प्रधान ते बड़े बहादर थिये, ते अपने-अपने खानदानेरे मुताबिक तैन केरि गिनती 22034 थी। <verse eid="1CH 7:7" /><verse number="8" style="v" sid="1CH 7:8" />ते बेकेरेरां नौ मट्ठां इनां थियां: जमीरा, योआश, एलीएजेर, एल्योएनै, ओम्री, यरेमोत, अबिय्याह, अनातोत ते आलेमेत। <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />इनां ज़ैना अपने-अपने पूर्वजां केरे घरानेरे प्रधान ते बड़े बहादर थिये, एन केरे खानदानेरी गिनती एपनी-एपनी वंशावली एरे मुताबिक 20200 थी। <verse eid="1CH 7:9" /><verse number="10" style="v" sid="1CH 7:10" />ते यदीएलेरू मट्ठू बिल्हान, ते बिल्हानेरां मट्ठां, यूश, बिन्यामीन, एहूद, कनाना, जेतान, तर्शीश ते अहीशहर थियां। <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />इनां सब ज़ैना यदीएलेरे खानदाने मरां ते अपने-अपने पूर्वजां केरे घरानेरे प्रधान ते बड़े बहादर थिये, एन केरे खानदाने मरां सेना मां जंग केरनेरे काबल 17200 सिपाही थिये। <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />ते ईरेरां मट्ठां शुप्पीम ते हुप्पीम ते अहेरेरू मट्ठू हूशीम थियूं। <verse eid="1CH 7:12" /><verse number="13" style="v" sid="1CH 7:13" />नप्तालीएरां मट्ठां, यहसेल, गूनी, येसेर ते शिल्‍लेम थियां, एना बिल्हारे पोट्लड़े थिये।<verse eid="1CH 7:13" /></para>
  <para style="s">मनश्शेरू खानदान</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />मनश्शेरां मट्ठां: अस्रीएल ज़ैन तैसेरी अरामी रखैली सेइं पैदा भोवरू थियूं। ते तैस अरामी कौन्शरू मट्ठू गिलादेरो बाजी माकीर भी थियूं। <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />ते माकीर (ज़ेसेरी बेइनरू नवं माका थियूं) तैनी हुप्पीम ते शुप्पीमेरे लेई कौन्शां ड्लेइतां एन्हीं, ते दूइयोंवेरू नवं सलोफाद थियूं, ते सलोफादे कुइयां भोइ। <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />फिरी माकीरेरी कौन्शी माका दूई मट्ठां भोआं, एक्‍केरू नवं पेरेश ते होरेरू नवं शेरेश थियूं। ते शेरेशेरां मट्ठां ऊलाम ते राकेम थियां। <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />ते ऊलामेरू मट्ठू बदान थियूं। इन गिलादेरू मट्ठू थियूं ज़ैन माकीरेरू मट्ठू ते मनश्शेरू पोट्लड़ू थियूं। <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />गिलादेरी बेइन हम्मोलेकेत थी, तैसारां मट्ठां ईशहोद, अबीएजेर ते महला थियां। <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />शमीदारां मट्ठां अहिअन, शेकेम, लिखी ते अनीआम थियां।<verse eid="1CH 7:19" /></para>
  <para style="s">एप्रैमेरू खानदान</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />एप्रैमेरू मट्ठू शूतेलह, शूतेलहेरू बेरेद, बेरेदेरू तहत, तहतेरू एलादा, एलादारू तहत, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />तहतेरू जाबाद, जाबादेरू मट्ठू शूतेलह थियूं, ते एजेर ते एलाद भी ज़ैना गत्तेरे मैन्हेइं ज़ैना तैस्से मुल्खे मां पैदा भोवरे थिये एल्हेरेलेइ मारे, कि तैना तैन केरे जानबर नेने एवरे थिये। <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />तैन केरो बाजी एप्रैम तैन केरे लेई बड़े दिहाड़न तगर गम केरतो राव, ते तैसेरे भियाल तैस तसल्‍ली देने आए। <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />ते किछ वक्तेरां बाद एप्रैम एपनी कौन्शी कां जेव, ते तै दोज़ींती भोइ ते तैस अक मट्ठू भोवं ते एप्रैमे तैसेरू नवं एस वजाई सेइं बरीआ रख्खू, कि तैसेरे घराने पुड़ मुसीबत पेवरी थी। <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />एप्रैमेरी कुई शेरां थी, ज़ैसां बुनीयें ते बेइहे दूईये बेथोरोन नंव्वेरे नगरां ते उज्जेनशेरा नगर भी बनेवरू थियूं। <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />एप्रैमेरू अक होरू मट्ठू रेपा थियूं, ते रेपारू मट्ठू रेशेप थियूं, ते रेशेपेरू मट्ठू तेलह, तेलहरू तहन, तहनेरू लादान, <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />लादानेरू अम्मीहूद, अम्मीहूदेरू एलीशामा, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />एलीशामारू नून, नूनेरू मट्ठू यहोशू थियूं। <verse eid="1CH 7:27" /><verse number="28" style="v" sid="1CH 7:28" />तै एप्रैमेरे खानदानेरी अपनि ज़मीन ते बेस्तन ड्लाव्वन समेत बेतेल ते पूर्वेरे पासे नारान नगर ते पश्चिमेरे पासे ड्लाव्वन समेत गेजेर नगर, फिरी ड्लाव्वन समेत शेकेम नगर, ते ड्लाव्वन समेत अय्या नगर। <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />ते मनश्शेरी हद बेन्दी कां अपने-अपने ड्लाव्वन समेत बेतशान, तानाक, मगिद्दो ते दोर। इन नगरन मां इस्राएलेरे मट्ठे यूसुफेरी खानदानेरे लोक रहते थिये।<verse eid="1CH 7:29" /></para>
  <para style="s">आशेरेरू खानदान</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />आशेरेरां मट्ठां: यिम्ना, यिश्वा, यिश्वी ते बरीआ, ते तैन केरि बेइन सेरह थी। <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />ते बरीआरां मट्ठां: हेबेर ते मल्कीएल ते मल्कीएले बिर्जोत नगर बसाव। <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />हेबेरेरां मट्ठां इनां थियां: यपलेत, शोमेर, होताम ते तैन केरि बेइन शूआ थी। <verse eid="1CH 7:32" /><verse number="33" style="v" sid="1CH 7:33" />ते यपलेतेरां मट्ठां इनां थिये, पासक, बिम्हाल, ते अश्‍वात। यपलेतेरां एना मट्ठां थियां। <verse eid="1CH 7:33" /><verse number="34" style="v" sid="1CH 7:34" />शेमेरां मट्ठां अही, रोहगा, यहुब्बा ते अराम थियां। <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />यपलेतेरे ढ्ला हेलेमेरां मट्ठां सोपह, यिम्ना, शेलेश ते आमाल। <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />सोपहेरां मट्ठां, सूह, हर्नेपेर, शूआल, बेरी, इम्रा। <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />बेसेर, होद, शम्मा, शिलसा, यित्रान ते बेरा। <verse eid="1CH 7:37" /><verse number="38" style="v" sid="1CH 7:38" />येतेरां मट्ठां यपुन्ने, पिस्पा ते अरा थियां। <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />उल्‍लारां मट्ठां आरह, हन्नीएल ते रिस्या थियां। <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />इन सब आशेरेरे खानदाने मरां थिये, ते अपने-अपने पूर्वजां केरे घरानेरे प्रधान ते बड़े बहादर थिये ते प्रधान्न मां भी खास थिये। इनां ज़ैना अपने-अपने खानदानेरे मुताबिक सेनाई मां जंग केरनेरे लेई गने जे, इन केरि गिनती 26000 थी।<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">बिन्यामीनेरी वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />बिन्यामीनेरू बड्डू मट्ठू बेला, दूइयोवं अश्बेल, ट्लेइयोवं अहृह, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />च़ेवरोवं नोहा, ते पंच़ोंव रापा थियूं। <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />बेलारां मट्ठां अद्दार, गेरा, अबीहूद, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />अबीशू, नामान, अहोह, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />गेरा, शपूपान ते हूराम थियां। <verse eid="1CH 8:5" /><verse number="6" style="v" sid="1CH 8:6" />एहूदेरां मट्ठां इनां थियां गेबा नगरेरे रानेबालां घराना केरे प्रधान इनां थिये, ज़ैना गुलाम बनेइतां मानहत नगरे जो नेवरे थिये। <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />ते नामान, अहिय्याह ते गेरा, एना भी गुलाम बनेइतां मानहत नगरे जो नियोरे थिये, गेरारां मट्ठां उज्जा ते अहीहूद थियां। <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />ते शहरैमे अपने दूईये कौन्शां हूशीम ते बारा शारनेरां बाद, मोआब मुल्खे मां मट्ठां भोआं। <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />तैसेरी कौन्श होदेशा सेइं इनां मट्ठां भोआं: योबाब, सिब्या, मेशा, मल्काम, यूस, सोक्या, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />ते मिर्मा। तैसेरां इनां मट्ठां अपने-अपने पूर्वजां केरे घराने मां प्रधान थिये। <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />ते हूशीमेरां मट्ठां अबीतूब ते एल्पाल थियां। <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" />एल्पालेरां मट्ठां एबेर, मिशाम ते शामेद। शामेदे ओनो नगर ते ड्लाव्वन समेत लोद नगर भी बसाव। <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />फिरी बरीआ ते शेमा ज़ैना अय्यालोन नगरे मां रानेबाले पूर्वजां केरे घराना केरे प्रधान थिये, ते ज़ैनेईं गत<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="fq" closed="false">गत </char><char style="ft" closed="false">इन पलिश्ती केरू नगर नईं बल्के इन नगर यहूदा प्रादेशे मांए।</char></note> नगरेरे रानेबाले कढोरे थिये। <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />ते अह्यो, शाशक, यरेमोत, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />जबद्याह, अराद, एदेर, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />मीकाएल, यिस्पा, योहा, ज़ैना बरीआरां मट्ठां थियां, <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />जबद्याह, मशुल्‍लाम, हिजकी, हेबेर, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />यिशमरै, यिजलीआ, योबाब ज़ैना एल्पालेरां मट्ठां थियां। <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />ते याकीम, जिक्री, जब्दी, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />एलीएनै, सिल्‍लतै, एलीएल, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />अदायाह, बरायाह ते शिम्रात ज़ैना शिमीएरां मट्ठां थियां। <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />यिशपान, एबेर, एलीएल, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />अब्दोन, जिक्री, हानान, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />हनन्याह, एलाम, अन्तोतिय्याह, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />यिपदयाह ते पनूएल ज़ैना शाशकेरां मट्ठां थियां। <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />ते शमशरै, शहर्याह, अतल्याह, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />योरेश्याह, एलिय्याह ते जिक्री ज़ैना यरोहामेरां मट्ठां थियां। <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />इनां एपनी-एपनी पीढ़ी मां अपने-अपने पूर्वजां केरे घरान्न मां खास ते प्रधान थिये, एना यरूशलेम नगरे मां रहते थिये। <verse eid="1CH 8:28" /><verse number="29" style="v" sid="1CH 8:29" />गिबोन नगरे मां यईएल रहतो थियो ते ज़ैना तैड़ी रहते थिये तै तैन केरो प्रधान थियो तैसेरी कौन्शरू नवं माका थियूं। <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />तैसेरू बड्डू मट्ठू अब्दोन थियूं, फिरी सूर, कीश, बाल, नादाब, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />गदोर, अह्यो ते जेकेर इनां मट्ठां भोआं। <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />मिक्लोतेरू मट्ठू शिमआह थियूं। ते इनां भी अपने भियालन सेइं साथी यरूशलेम नगरे मां रहते थिये। <verse eid="1CH 8:32" /><verse number="33" style="v" sid="1CH 8:33" />नेरेरू मट्ठू कीश थियूं, कीशेरू शाऊल, ते शाऊलेरां मट्ठां योनातान, मल्कीशूअ, अबीनादाब ते एशबाल थियां। <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />ते योनातानेरू मट्ठू मरीब्बाल थियूं, ते मरीब्बालेरू मट्ठू मीका थियूं। <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />ते मीकारां मट्ठां पीतोन, मेलेक, तारे ते आहाज थियां। <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />आहाजेरू मट्ठू यहोअद्दा, यहोअद्दारां मट्ठां आलेमेत, अज्मावेत ते जिम्री थियां। ते जिम्री एरू मट्ठू मोसा। <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />मिस्पेरू मट्ठू बिना थियूं, ते तैसेरू मट्ठू रापा थियूं, रापारू एलासा ते एलासारू मट्ठू आसेल थियूं। <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />ते आसेले शा मट्ठां भोआं ज़ैन केरां नंव्वां इना थियां, अज्रीकाम, बोकरू, इश्माएल, शरायाह, ओबद्याह ते हानान। इना सब आसेलेरां मट्ठां थियां। <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />आसेलेरे ढ्ला एशेकेरां मट्ठां इनां थियां, तैसेरू बड्डू मट्ठू ऊलाम, दूइयोवं यूश, ट्लेइयोवं एलीपेलेत। <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />ऊलामेरां मट्ठां बहादर ते तीर च़लानेबाले थियां, ते तैन केरां 150 मट्ठां-पोट्लड़ां थियां। इनां सब बिन्यामीनेरे खानदाने मरां थिये।<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s">यरूशलेम नगरे मां रानेबालां केरो इंतज़ाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />एन्च़रे सेइं सारे इस्राएली एपनी-एपनी वंशावेलरे मुताबिक, ज़ै इस्राएलेरे राज़ां केरि किताबरी मां लिखोरीए, गिनती कीजेई। ते यहूदी लोक बाबेल मुल्खेरे गुलैमी मां पुज़ाए जे किजोकि तैनेईं परमेशरेरे खलाफ पाप कियो। <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />गुलैमी मरां वापस एइतां ज़ैना लोक अपने नगरन मां बस्सोरे थिये, तैना इस्राएली, याजक, लेवी ते भवनेरे सेवक थिये। <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />यरूशलेम नगरे मां किछ यहूदी; किछ बिन्यामीनी, ते किछ एप्रैमी, ते किछ मनश्शेई लोक रहते थिये। <verse eid="1CH 9:3" /><verse number="4" style="v" sid="1CH 9:4" />तैना इनां आन, यहूदारे मट्ठे पेरेसेरे खानदाने मरां अम्मीहूदेरू मट्ठू ऊतै, ज़ैन ओम्रीएरू मट्ठू, ते इम्री एरू पोट्लड़ू ते बानीएरू पड़पोट्लड़ू थियूं। <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />ते शीलोई लोकन मरां तैसेरू बड्डू मट्ठू असायाह ते तैसेरां मट्ठां। <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />जेरहेरे खानदाने मरां यूएल, ते तैन केरे भियाल, ज़ैना 690 थिये। <verse eid="1CH 9:6" /><verse number="7" style="v" sid="1CH 9:7" />फिरी बिन्यामीनेरे खानदाने मरां सल्‍लू ज़ैन मशुल्‍लामेरू मट्ठू, होदव्याहेरू पोट्लड़ू, ते हस्सनूआरू पड़पोट्लड़ू थियूं। <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />यिबनायाह ज़ैन यरोहामेरू मट्ठू थियूं, ते एला ज़ैन उज्जीएरू मट्ठू, ते मिक्री एरू पोट्लड़ू थियूं, ते मशुल्‍लाम ज़ैन शपत्याहेरू मट्ठू थियूं, रूएलेरू पोट्लड़ू, ते यिब्निय्याहेरू पड़पोट्लड़ू थियूं। <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />ते इन केरे भियाल ज़ैना अपने-अपने खानदानेरे मुताबिक 956 मड़द थिये ज़ैना अपने-अपने पूर्वजां केरे घरानेरे प्रधान थिये।<verse eid="1CH 9:9" /></para>
  <para style="s">यरूशलेम नगरे मां रानेबाले याजक</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />याजकन मरां यदायाह, यहोयारीब ते याकीन, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />ते अजर्याह ज़ै परमेशरेरे भवनेरो प्रधान ते हिल्किय्याहेरू मट्ठू थियूं, हिल्किय्याह मशुल्‍लामेरू मट्ठू थियूं, मशुल्‍लाम सादोकेरू, सादोक मरायोतेरू, मरायोत अहीतूबेरू मट्ठू थियूं।<verse eid="1CH 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 9:12" />ते अदायाह ज़ैन यरोहामेरू मट्ठू थियूं, यरोहाम पशहूरेरू, पशहूर मल्किय्याहेरू, मल्किय्याह मासैरू, मासै अदीएलेरू, अदीएल यहजेरारू, यहजेरा मशुल्‍लामेरू, मशुल्‍लाम मशिल्‍लीतेरू, मशिल्‍लीत इम्मेरू मट्ठू थियूं। <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />ते एन केरे भियाल थिये ज़ैना अपने-अपने पूर्वजां केरे घरान्न मां 1760 प्रधान थिये, तैना परमेशरेरे भवनेरे सेवारे कम्मे मां बड़े काबल थिये। <verse eid="1CH 9:13" /><verse number="14" style="v" sid="1CH 9:14" />फिरी लेवी केरे मरारी खानदाने मरां शमायाह ज़ैन हश्शूबेरू मट्ठू, ते अज्रीकामेरू पोट्लड़ू, ते हशब्याहेरू पड़पोट्लड़ू थियूं। <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />ते बकबक्‍कर, हेरेश ते गालाल ते आसापेरे खानदाने मरां मत्तन्याह ज़ैन मीकारू मट्ठू, ते जिक्री एरू पोट्लड़ू थियूं। <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />ते ओबद्याह ज़ैन शमायाहेरू मट्ठू, ते गालालेरू पोट्लड़ू ते यदूतूनेरू पड़पोट्लड़ू थियूं। ते बेरेक्याह ज़ैन आसारू मट्ठू, ते एल्कानारू पोट्लड़ू थियूं, ज़ै नतोपाई लोकां केरे ड्लाव्वन मां रहतो थियो।<verse eid="1CH 9:16" /></para>
  <para style="s">लेवी ज़ैना भवनेरे पहरदार थिये</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />लेवेरे खानदाने मरां ज़ैना भवनेरे पहरदार थिये तैना इना थिये, शल्‍लूम, अक्‍कूब, तल्मोन ते अहीमन, इन मां प्रधान त शल्‍लूम थियो। <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />ते तै अज़ तगर नगरेरे पूर्वेरे पासे राज़ेरे फाटके पुड़ पहरदारी केरतो थियो। लेवी केरे पहरदार इनां थिये। <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />ते शल्‍लूम ज़ैन कोरेरू मट्ठू थियूं, एब्यासापेरू पोट्लड़ू, ते कोरहेरू पड़पोट्लड़ू थियूं, ते तैसेरे ढ्ला ज़ैना कोरही थिये, तैना इस कम्मेरे अधिकारी थिये कि तैना यहोवारे तेम्बेरे पहरदार भोन। तैन केरे खास त यहोवारे डेरां केरे अधिकारी ते फाटकेरे पहरदार थिये। <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />पुराने ज़माने मां एलीआजरेरू मट्ठू पीनहास, ज़ैस सेइं साथी यहोवा रहतो थियो, तै तैन केरो प्रधान थियो। <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />मशेलेम्याहेरू मट्ठू जकर्याह मिलापे बाले तेम्बेरो पहरदार थियो। <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" />इन सब ज़ैना भवनेरी पहरदारी केरनेरे लेई च़ुने जेवरे थिये, तैना 212 थिये। इनां ज़ैन केरे पूर्वजन दाऊद ते शमूएल नेबे वफादार ज़ैनतां रखोरे थिये, तैना अपने-अपने ड्लाव्वन मां एपनी-एपनी वंशावेलरे मुताबिक गने जे। <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />तैना ते तैन केरू खानदान यहोवारे भवनेरे फाटकन पुड़ पहरदारी बैरी-बैरी सेइं केरते थिये। <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />पहरदार भवनेरे पूर्व, पश्चिम, उत्तर, दक्षिण, च़ेवरे पासां केरि पहरदारी केरते थिये। <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />ते तैन केरे भियाल ज़ैना ड्लाव्वन मां रहते थिये, तैन्न सत-सत दिहैड़ना बाद पहरदारी केरनेरे लेई तैन सेइं साथी पहरदारी केरनेरे लेई एजनू पेतू थियूं। <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />किजोकि च़ेवरे प्रधान पहरदार ज़ैना लेवी थिये, तैना वफादार सेमझ़तां परमेशरेरे भवनेरे कमरां ते भण्डारां केरे अधिकारी रख्खे जेवरे थिये। <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />तैना परमेशरेरे भवनेरे आसे-पासे एल्हेरेलेइ राती पहरदारी केरते थिये कि तैसेरी रखवाली तैन सौंफोरी थी, ते रोज़ झ़ेझ़ां खोलनू तैन केरू कम थियूं।<verse eid="1CH 9:27" /></para>
  <para style="s">लेवी लोकां केरि बाकी ज़िमेवारी</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />तैन मां किछ यहोवारे भवने मां इस्तेमाल भोनेबाले चीज़ां केरे अधिकारी थिये, इनां चीज़ां गेनतां केढी गैती थी ते गेनतां रेखी गैती थी। <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />ते तैन मरां किछ सामानेरे, ते पवित्र ठारारे भांडां केरे, ते मैदे, दाछ़रो रस, तेल, लोबान ते खुशबूदार चीज़ां केरे अधिकारी रख्खे जे। <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />पन याजकां केरे मट्ठन मरां किछ खुशबूदार चीज़ां तियार केरनेरू कम केरते थिये। <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />ते मत्तित्याह नंव्वेरो अक लेवी ज़ैन कोरही शल्‍लूमेरू बड्डू मट्ठू थियूं तैन वफादार सेमझ़तां तव्वन पुड़ बनेवरी च़ाढ़नेरे लेई रोट्टी केरू अधिकारी रख्खू जेवं। <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />कहात कुले मरां किछ लेवी त च़ैढ़ोरी रोट्टी केरे अधिकारी थिये, कि हर आरामेरे दिहाड़े तैस तियार केरन।<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />इनां गीतां ज़ोनेबाले थिये ज़ैना लेवी पूर्वजां केरे घरानेरे प्रधान थिये, ते भवनेरे कमरन मां रहते थिये, ते बाकी सेवारे कम्मे करां छुटोरे थिये। किजोकि तैना रात दिहैड़ी अपने कम्मे मां लगोरे रहते थिये। <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />एना एपनी-एपनी पीढ़ी मां लेवी लोकां केरे पूर्वजां केरे घरानेरे प्रधान थिये, एना यरूशलेम नगरे मां रहते थिये।<verse eid="1CH 9:34" /></para>
  <para style="s">शाऊल राज़ेरी खानदानी</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />यीएल गिबोन नगर बसाने बालो थियो ते तै गिबोन नगरे मां रहतो थियो, तैसेरी कौन्शरू नवं माका थियूं। <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />तैसेरू बड्डू मट्ठू अब्दोन थियूं, फिरी सूर, कीश, बाल, नेर, नादाब, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />गदोर, अह्यो, जकर्याह ते मिक्लोत; <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />ते मिक्लोतेरू मट्ठू शिमाम थियूं, तैना अपने भियालन सेइं साथी यरूशलेम नगरे मां रहते थिये। <verse eid="1CH 9:38" /><verse number="39" style="v" sid="1CH 9:39" />नेरेरू मट्ठू कीश, कीशेरू मट्ठू शाऊल, शाऊलेरां मट्ठां योनातान, मल्कीशूअ, अबीनादाब ते एशबाल थियां। <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />ते योनातानेरू मट्ठू मरीब्बाल थियूं, ते मरीब्बालेरू मट्ठू मीका थियूं। <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />ते मीकारां मट्ठां पीतोन, मेलेक, तह्रे ते आहाज थियां। <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />ते आहाजेरू मट्ठू यारा, ते यारारां मट्ठां आलेमेत, अज्मावेत ते जिम्री थियां, ते जिम्री एरू मट्ठू मोसा, <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />ते मोसारू मट्ठू बिना, ते बिनारू मट्ठू रपायाह, रपायाहेरू मट्ठू एलासा ते एलासारू मट्ठू आसेल थियूं। <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />ते आसेलेरां शा मट्ठां भोआं तैन केरां नंव्वां इनां आन: अज्रीकाम, बोकरू, इश्माएल, शरायाह, ओबद्याह ते हानान।<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">शाऊलेरी मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />एक्सां पलिश्ती सेना इस्राएली सेना सेइं लड़ी; ते इस्राएली पलिश्ती सेनारे सामनेरां नश्शे, ते बड़े इस्राएली सिपाही गिलबो पहाड़े पुड़ मारे जे। <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />पन पलिश्ती शाऊल ते तैसेरे मट्ठन पत्ती लगोरे राए, ते पलिश्ती सेना शाऊलेरां मट्ठां योनातान, अबीनादाब, ते मल्कीशूअ मारां। <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />शाऊले सेइं बड़ी भारी जंग भोती राई ते तीर च़लाने बालेईं शाऊल बुरे तरीके सेइं ज़खमी कियो। <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />तैखन शाऊले अपने हथियार च़लानेबाले सेइं ज़ोवं, “अपनि तलवार खिचतां मीं मार, कोन्च एरू न भोए कि ज़ैन केरो खतनो नईं भोवरो तैना एइतां मेरो मज़ाक बनान।” पन तैसेरे हथियार च़लानेबाले डेरतां एन कम केरने करां इन्कार कियो। तैखन शाऊले अपनि तलवार खड़ी केरतां तैस पुड़ बिछ़ड़ी जेव। <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />एन हेरतां कि शाऊल मेरि जेवरोए तैसेरो हथियार च़लानेबालो भी एपनी तलवारी पुड़ बिछ़ड़तां मेरि जेव। <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />एन्च़रां सेइं शाऊल ते तैसेरां ट्लाईए मट्ठां, ते तैसेरे घरानेरे सारे मड़द एक्सां मेरि जे। <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />एन हेरतां कि इस्राएली नेश्शी जेवरेन, ते शाऊल ते तैसेरां मट्ठां मेरि जेआं, तैस वैदी मां रानेबाले सारे इस्राएली अपने-अपने नगर शैरतां नेश्शी जे। ते पलिश्ती एइतां तैन मां राने लगे।<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />जंगरे होरसां ज़ैखन पलिश्ती सेना मरोरे सेनारी कीमती चीज़ां लुटने एवरी थी, तैखन तैन शाऊल ते तैसेरां मट्ठां केरि लाशा गिलबो पहाड़े पुड़ मैल्ही। <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />तैखन तैनेईं शाऊलेरां लिगड़ां खोलतां तैसेरी क्रोड़ी ते हथियार ने ते पलिश्ती केरे मुल्खेरे सैरी जगान मैन्हु एल्हेरेलेइ भेज़े कि आम लोकन मां ई खुशरी खबर देते गान ते देबतां केरू शुक्र केरन। <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />तैखन पलिश्ती सिपैहेईं तैसेरे हथियार अपने मन्दरे मां रख्खे, ते तैसेरी क्रोड़ी दागोन देबतेरे मन्दरे मां टंगी। <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />ज़ैखन गिलाद प्रदेशेरे याबेश नगरेरे सारे लोकेईं एन शुनू कि पलिश्ती सेना शाऊले सेइं कुन-कुन कियूं। <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />तैखन सब बहादर सिपाही च़ले ते शाऊल ते तैसेरां मट्ठां केरि लाशां छ़ुइतां याबेश नगरे मां एन्हीं, ते तैना लाशा याबेशे मां एक्‍की बंज़ेरे बुट्टे हैठ देब्बी ते सत दिहाड़े अफ़सोस केरनेरे लेई बरत रख्खू।<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />एन्च़रां सेइं इस धोखेरे वजाई सेइं शाऊल मारो जेव किजोकि तै यहोवा सेइं वफादार न थियो राहोरो, किजोकि तैनी यहोवारो हुक्म न थियो मन्नोरो, इड़ी तगर कि तैनी भूत साधने बाले कौन्शी करां सलाह नेवरी थी। <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />तैनी यहोवाए करां न थियूं पुछ़ोरू, एल्हेरेलेइ यहोवा तै मैरतां राज़ यिशैरे मट्ठे दाऊदे दित्तू।<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">दाऊद सारे इस्राएलेरो राज़ो बनाव जेव</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />तैखन सारे इस्राएली दाऊदे कां हेब्रोन नगरे मां अकोट्ठे भोइतां ज़ोने लगे, “शुन, तू ते अस लोक भियाल अहम। <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />बीतोरे वक्ते मां ज़ैखन शाऊल राज़ो थियो, तैखन भी इस्राएली लोकां केरो अगुवो तूए थियो, ते तेरे परमेशर यहोवा तीं सेइं ज़ोवं, ‘मेरे लोक इस्राएलेरो पुहाल, ते मेरे लोक इस्राएली केरो प्रधान, तूए भोल्हो।’”<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="MAT 2:6">मत. 2:6</ref>;<ref loc="PSA 78:71">भज. 78:71</ref>.</char></note> <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" />एल्हेरेलेइ सारे इस्राएली प्रधान हेब्रोन नगरे मां दाऊद राज़े कां आए, ते तैनी तैन सेइं हेब्रोन नगरे मां यहोवारे सामने करार कियो। ते तैनेईं यहोवारे वचनेरे मुताबिक, ज़ैन तैनी शमूएल नेबी सेइं ज़ोवरू थियूं, इस्राएलेरो राज़ो बन्नेरे लेई दाऊदेरू अभिषेक कियूं।<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />तैखन सारे इस्राएली सेना समेत दाऊद यरूशलेम नगरे मां जेव, ज़ैस जो यबूस भी ज़ोते थिये, ते तैड़ी यबूसी लोक तैस मुल्खे मां रहते थिये। <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />तैखन यबूसेरे रानेबालेईं दाऊदे सेइं ज़ोवं, “तू इड़ी एज्जी न बटेलो।” फिरी भी दाऊदे सिय्योन नंव्वेरे क़िले पुड़ कब्ज़ो कियो, तैखन करां तैस जो दाऊदपुर भी ज़ोतन। <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />तैसेरां बाद दाऊदे ज़ोवं, “ज़ै कोई यबूसी लोकन सेभन करां पेइले हमलो केरेलो, तैए सेनारो प्रधान सेनापति भोल्हो,” तैखन सरूयाहेरे मट्ठे योआबे सेभन करां पेइलो हमलो कियो ते सेनापति बेनि जेव। <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />तैखन दाऊद तैस क़िले मां राने लगो, एल्हेरेलेइ तैस क़िलेरू नवं दाऊदपुर पेवं। <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />ते तैसेरां बाद तैनी नगरेरे च़ेवरे पासन, मतलब मिल्‍लो करां लेइतां च़ेवरे पासन अक दिवार खड़ी कराई, ते योआबे बाकी उज़ड़ोरे नगरेरी मरम्मत कराई। <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />ते दाऊद मज़बूत भोतो जेव, ते सेनां केरो यहोवा तैस सेइं साथी थियो।<verse eid="1CH 11:9" /></para>
  <para style="s">दाऊदेरे बहादर सिपाही</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />यहोवा इस्राएलेरे बारे मां ज़ैन वचन ज़ोवरू थियूं, तैसेरे मुताबिक दाऊदेरे ज़ैन शूरबीरेईं सारे इस्राएलन समेत तैसेरे राज़े मां तैसेरे हक्‍के मां भोइतां, तैस राज़ो बनानेरे लेई ज़ोर दित्तो, तैन मां प्रधान इना आन। <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />दाऊदेरे शूरबीरां केरां नंव्वां इनां आन, अक हक्मोनी एरू मट्ठू याशोबाम ज़ै 30 सिपेही केरो प्रधान थियो, तैनी एक्‍की जंगी मां 300 दुश्मन भाले सेइं मारे।<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />तैसेरां बाद अहोही दोदोएरू मट्ठू एलीआजर ज़ैन ट्लाई महान शूरबीरन मरां अक थियूं। <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />तै पसदम्मीम नंव्वेरी ठैरी ज़ैड़ी जौआं केरू अक ऊडार थियूं, दाऊदे सेइं साथी राव ज़ैड़ी पलिश्ती जंग केरनेरे लेई अकोट्ठे भोवरे थिये, ते इस्राएली सेना पलिश्ती सेनारे सामनेरां नेश्शी जेवरी थी। <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />तैखन एलीआजर ते दाऊद तैस उडारेरे मझ़ाटे खड़े भोइतां तैसेरी हिफाज़त की, ते पलिश्ती मारे, ते यहोवा तैन ज़ींत दित्ती।<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />एक्‍की बार 30 खास शूरबीरन मरां ट्लाई ज़ने दाऊदे कां चट्टानी कां अदुल्‍लाम कुढी मां आए, ते पलिश्ती केरे डेरे तैस वक्त रपाईम नंव्वेरे वैदी मां लगोरे थिये। <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />तैस वक्ते दाऊद क़िले मां थियो, ते पलिश्ती केरि अक चौवकी बैतलहम नगरे मां थी। <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />एक्सां दाऊदे बड़ी ट्लिश लग्गी ते तैने ज़ोवं, “कौन मीं बैतलहम नगरेरे फाटकेरे खुहेरू पानी पियालो।” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />एल्हेरेलेइ तैना ट्लाईए शूरबीर पलिश्ती केरे डेरन पुड़ ट्लुटी जे ते बैतलहम नगरेरे फाटकेरे खुहे मरां पानी भेरतां दाऊदे कां आए। पन दाऊदे पीने करां इन्कार कियो ते यहोवारे सामने च़ढ़तल केरतां उलटाव। <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />ते तैनी ज़ोवं, “मेरो परमेशर मीं करां ऐन केरनू दूर रख्खे। इन पानी इन मैन्हु केरे खूनेरू ज़ेरू कीमतीए।” एल्हेरेलेइ तैनी तैन पानी पीने करां इन्कार कियो। इन ट्लाईए बहादरेईं एन बड्डू कम कियूं।<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />अबीशै ज़ै योआबेरो ढ्ला थियो, तै ट्लाई शूरबीरन मरां प्रधान थियो। तैनी अपने भाले सेइं 300 दुश्मन मारे ते ट्लाई शूरबीरन मां मुशूर भोइ जेव। <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />दूइयोवं तैन ट्लिहन मां तै बड़ो इज़्ज़तदार थियो, ते तैन केरो प्रधान भोइ जेव, पन पेइले खास माहिर ट्लेइयां केरे पदे कां न पुज़्ज़ो।<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />यहोयादारू मट्ठू बनायाह थियूं, ज़ैन कबसेल नगरेरे एक्‍की बहादरेरू मट्ठू थियूं, ज़ैनी बडां-बडां कम्मां कियोरां थियां, तैनी शेरेरे ज़ेरे दूई मोआबी मारोरे थिये, ते एक्सां शेजाई मां एक्‍की खड्डे मां गेइतां अक शेर मारो। <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />फिरी तैनी अक पंच़ हथ लम्मो झम्मो मिस्री मैन्हु मारो, ते तैस मिस्री मैन्हेरे हथ्थे मां ज़ुलाहेरे डण्डेरो ज़ेरो भालो थियो, पन बनायाह अक सोटी ट्लेइतां तैस कां जेव, ते मिस्री मैन्हेरे हथ्थे मरां भालो थुसोड़तां तैस्से भाले सेइं तै मारो। <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />एरां-एरां कम्मां केरतां यहोयादारू मट्ठू बनायाह तैन ट्लाईए शूरबीरन मां नामी भोइ जेव। <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />तै त 30 मां बड़ो मुशूर थियो, पन तै ट्लेइयां केरे दर्जे तगर न पुज़्ज़ो। तै दाऊदे अपने अंगरक्षकां केरो प्रधान बनाव।<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />फिरी दाऊदेरे सेनारे दलां केरे शूरबीर इनां थिये, योआबेरो ढ्ला असाहेल, बैतलहम नगरेरे रानेबाले दोदोएरू मट्ठू एल्हनान, <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />हरोरी शम्मोत, पलोनी हेलेस, <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />तकोई इक्‍केशेरू मट्ठू ईरा, अनातोती अबीएजेर, <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />सिब्बकै हूशाई, अहोही ईलै, <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />महरै नतोपाई, अक होरो नतोपाई बानाहरू मट्ठू हेलेद, <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />बिन्यामीनी केरे गिबा नगरेरे रानेबाले रीबैरू मट्ठू इत्तै, पिरातोनी बनायाह, <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />गाशेरे नालन कां रानेबाले हूरै, अराबा मां रानेबालो अबीएल, <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />बहूरीमी अज्मावेत, शालबोनी एल्यहबा, <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />गीजोई हाशेमेरां मट्ठां, फिरी हरारी शागेरू मट्ठू योनातान, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />हरारी साकारेरू मट्ठू अहीआम, ऊरेरू मट्ठू एलीपाल, <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />मकेराई हेपेर, पलोनी अहिय्याह, <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />कर्मेली हेस्रो, एज्बैरू मट्ठू नारै, <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />नातानेरो ढ्ला योएल, हग्री एरू मट्ठू मिभार, <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />अम्मोनी सेलेक, बेरोती नहरै ज़ैन सरूयाहेरू मट्ठू योआबेरे हथियार च़लानेबालू थियूं, <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />येतेरी ईरा ते गारेब, <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />हित्ती ऊरिय्याह, अहलैरू मट्ठू जाबाद, <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />शूरबीर 30 समेत रूबेनी शीजारू मट्ठू अदीना ज़ै रूबेनी केरो प्रधान थियो। <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />माकारू मट्ठू हानान, मेतेनी योशापात, <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />अश्तारोत नगरेरे उज्जियाह, अरोएर नगरेरे होतामेरू मट्ठू शामा ते यीएल, <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />शिम्री एरू मट्ठू यदीएल ते तैसेरो ढ्ला तीसी, योहा, <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />महवीमी एलीएल, एलनामेरू मट्ठू यरीबै ते योशव्याह, <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />मोआबी यित्मा, एलीएल, ओबेद ते मसोबाई यासीएल।<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">दाऊदेरे बिन्यामीनी मद्दतगार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />ज़ैस वक्ते दाऊद सिकलग नगरे मां कीशेरे मट्ठे शाऊल राज़े करां डेरतां छ़पोरो रहतो थियो, तैखन इनां सिपाही तैड़ी आए, ते इनां तैन शूरबीर बहादरन मरां थिये ज़ैना जंगी मां तैसेरी मद्दत केरनेबाले थिये। <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />इनां तीर च़लानेबाले थिये, ज़ैना देइने-बांए, दूईये हथेइं सेइं छ़िंगलोटे सेइं घोड़ ते धनुषे सेइं तीर च़लेइ सखते थिये। ते एना शाऊलेरे भियालन मरां बिन्यामीनी थिये, <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />प्रधान त अहीएजेर ते दूइयोवं योआश थियो ज़ैन गिबा नगरेरे रानेबाले शमाआरू मट्ठू थियूं। फिरी अज्मावेतेरां मट्ठां यजीएल ते पेलेत, फिरी बराका ते अनातोती येहू, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />ते गिबोनी यिशमायाह ज़ै 30 बहादरन सिपेहिन मरां अक थियो ते तैन केरो प्रधान भी थियो। फिरी यिर्मयाह, यहजीएल, योहानान, गदेरा नगरेरो रानेबालो योजाबाद, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />एलूजै, यरीमोत, बाल्याह, शेमर्याह, हारूपी शपत्याह, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />एल्काना, यिश्शिय्याह, अजरेल, योएजेर, याशोबाम, ज़ैना सारे कोरह खानदाने मरां थिये, <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />ते गदोर नगरेरे यरोहामेरां मट्ठां योएला ते जबद्याह। <verse eid="1CH 12:7" /><verse number="8" style="v" sid="1CH 12:8" />ज़ैखन दाऊद सुनसान ठारारे क़िले मां रहतो थियो, तैखन इनां गाद गोट्ले मरां ज़ैना शूरबीर बहादर थिये, ते जंग केरनी शिखतां ते ढाल ते बलम इस्तेमाल केरनेबाले थिये, ते तैन केरां तुत्तरां शेरां केरां ज़ेरां थियां ते तैना पहाड़ी हिरनां केरे ज़ेरे तेज़ दौड़ने बाले थिये, इनां ते गादी लोकन अलग भोइतां तैस कां आए। <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />प्रधान त एजेर, दूइयोवं ओबद्याह, ट्लेइयोवं एलीआब, <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />च़ेवरोवं मिश्मन्ना, पंच़ोंव यिर्मयाह, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />शेइयोवं अत्तै, सत्तोवं एलीएल, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />अठोवं योहानान, नंव्वोवं एलजाबाद, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />दशोवं यिर्मयाह ते यारोवं मकबन्नै थियो, <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" />इनां गादी प्रधान शूरबीर बहादर थिये, तैन मरां ज़ै सेभन करां निकड़ो थियो तै 100 सिपेही केरो, ते ज़ै सेभन करां बड्डो थियो, तै 1000 सिपेही केरो सेनापति थियो। <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />इना तैना आन, ज़ैना पेइले महीने मां ज़ैखन यरदन दरिया भरपूर बहावे पुड़ बगतो थियो, तैखन तैसेरे पार जे। ते पूर्व ते पश्चिम दूईये पासां केरे रानेबाले कढे। <verse eid="1CH 12:15" /><verse number="16" style="v" sid="1CH 12:16" />किछ बिन्यामीनी ते यहूदी भी दाऊदे कां क़िले मां आए। <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />तैन सेइं मिलनेरे लेई दाऊद निस्सो ते तैन सेइं ज़ोवं, “अगर तुस मीं कां दोस्तेरे ज़ेरे मेरी मद्दत केरने एवरेथ, त मेरो मन तुसन सेइं लगोरो रालो। पन अगर तुस मीं धोखे सेइं दुश्मन्न करां ट्लुवांने एवरेथ, त इश्शे पूर्वजां केरो परमेशर इस पुड़ नज़र केरतां सज़ाह दे, किजोकि मीं कोई बुराई न कियोरी।” <verse eid="1CH 12:17" /><verse number="18" style="v" sid="1CH 12:18" />तैखन परमेशरेरो आत्मा अमासै पुड़ अव, ज़ै 30 बहादरां केरो प्रधान थियो, ते तैनी ज़ोवं,</para>
  <para style="q" vid="1CH 12:18">“हे दाऊद! असां तेरे अहम।</para>
  <para style="q" vid="1CH 12:18">हे यिशैरे मट्ठा! असां तेरे पासे अहम,</para>
  <para style="q" vid="1CH 12:18">तीं सुखे सुख भोए, ते तेरे मद्दत केरनेबालन भी सुख भोए,</para>
  <para style="q" vid="1CH 12:18">किजोकि तेरो परमेशर तेरी मद्दत केरि राहोरोए।”</para>
  <para style="p" vid="1CH 12:18">एल्हेरेलेइ दाऊदे तै रख्खो, ते एपनी सेनारे सेनापति बनाए। <verse eid="1CH 12:18" /><verse number="19" style="v" sid="1CH 12:19" />फिरी किछ मनश्शेई भी तैस मौके दाऊदे कां नेशतां आए, ज़ैखन तै पलिश्तन सेइं साथी भोइतां शाऊले सेइं जंग केरने जेव, पन तै तैसेरी किछ मद्दत न केरि सको, किजोकि पलिश्ती केरे राज़ेईं सलाह मुशोरो केरतां तै वापस भेज़ोरो थियो, “तै इश्शी क्रोड़ी कटेइतां अपने मालिक शाऊले सेइं फिरी मिलेलो।” <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />ज़ैखन दाऊद सिकलग नगरे जो गेइ राहोरो थियो, तैखन इनां मनश्शेई तैस कां नेशतां एवरे थिये: अदनह, योजाबाद, यदीएल, मीकाएल, योजाबाद, एलीहू ते सिल्‍लतै ज़ैना मनश्शेई केरे हज़ार सिपेही केरे सेनापति थी। <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />तैनेईं लुटेरां केरे टोली केरे खलाफ दाऊदेरी मद्दत कियोरी थी, किजोकि इना सब शूरबीर थिये, एल्हेरेलेइ तैना दाऊदेरे सेनारे प्रधान भी बेनि जे। <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />एन्च़रे सेइं रोज़ लोक दाऊदेरी मद्दत केरनेरे लेई तैस कां एइते राए, इड़ी तगर कि परमेशरेरी सेनारी ज़ेरि अक बड़ी सेना बेनि जेई।<verse eid="1CH 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />फिरी लोक लड़नेरे लेई हथियार बेन्धतां हेब्रोन नगरे मां दाऊदे कां एल्हेरेलेइ आए कि यहोवारे वचनेरे मुताबिक शाऊलेरू राज़ तैसेरे सुपुर्द केरन। तैन केरे प्रधानां केरि गिनती ई आहे। <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />यहूदारे गोट्ले मरां ढाल ते भाले नेइतां 6800 हथियारन बाले लड़नेरे लेई आए। <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />शिमोनेरे गोट्ले मरां 7100 तियार शूरबीर लड़ने जो आए। <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />लेवी गोट्ले मरां 4600 आए। <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />ते हारूनेरे घरानेरो प्रधान यहोयादा थियो, ते तैस सेइं साथी 3700 सिपाही आए। <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />ते सादोक नंव्वेरो अक जुवान बहादर भी अव, ते तैसेरे बाजी केरे घरानेरे 22 प्रधान आए। <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" />ते शाऊलेरे भियाल बिन्यामीन गोट्लेरे सिपेहिन मरां 3000 आए, किजोकि तैस मौके तगर अधे बिन्यामीनी सिपेहिन करां जादे शाऊलेरे घरानेरे वफादार थिये। <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />फिरी एप्रैम गोट्लेरे सिपेहिन मरां बड़े बहादर अपने-अपने पूर्वजां केरे घराने मां मुशूर 20800 जंग लड़नेबाले आए। <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" />मनश्शेरे अधे गोट्ले मरां दाऊद राज़ो बनानेरे लेई 18000 सिपाही आए, ज़ैन केरां नंव्वां ज़ोआं जेवरां थियां। <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />इस्साकार गोट्लेरे सिपेहिन मरां ज़ैना वक्ते पिशानते थिये, कि इस्राएले कुन केरनू ठीके, तैन केरे प्रधान 200 थिये। ते तैन केरे सारे भियाल तैन केरो हुक्म मन्ते थिये। <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />फिरी जबूलूनेरे गोट्ले मरां जंग केरनेरे लेई हर किसमेरे हथियार नेइतां ते जंग लड़नेरे लेई तिहार शूरबीर बहादर 50000 आए, तैना मुकाबलो केरनेबाले थिये ते चंचल न थिये। <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />फिरी नप्ताली गोट्ले मरां 1000 सेनापति, ते तैन सेइं साथी ढाल ते भाले ट्लेइतां 37000 सिपाही आए। <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" />दानेरे गोट्ले मरां 28600 जंग लड़नेरे लेई तियार सिपाही आए। <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />ते आशेरेरे गोट्ले मरां 40000 जंग लड़नेरे लेई तियार सिपाही आए। <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />ते यरदन दरियारे पार रानेबाले रूबेन, गाद गोट्लन ते मनश्शेरे अधे गोट्ले मरां जंग केरनेरे हर किसमेरे हथियार ट्लेइतां 120000 सिपाही आए।<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />इन सब जंग केरनेरे लेई तियार दाऊदे सारे इस्राएली लोकां केरो राज़ो बनानेरे लेई हेब्रोन नगरे मां अपने मेर्ज़ी सेइं आए, ते बाकी सब इस्राएली भी दाऊदे राज़ो बनानेरे लेई राज़ी थिये। <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />सिपाही तैड़ी ट्लाई दिहाड़े दाऊदे सेइं साथी खाते पीते राए, किजोकि तैन केरे भियालेईं तैन केरे लेई रोट्टरी तियार कियोरी थी। <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />ते ज़ैना तैन केरे नेड़े बल्के इस्साकार, जबूलून ते नप्ताली प्रादेशन तगर रहते थिये, तैनेईं भी गधन, ऊँटन, खचरन ते दांतन पुड़ मैदो, फैगू ते किशमिशेरी टिकी, दाछ़रो रस, तेल ते खानेरी चीज़ां लेदतां एन्हीं, ते बड़े दांत ते बड़ां गब्बां आनां। किजोकि इस्राएल मुल्खे मां आनन्द मनाने लगोरे थिये।<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">पवित्र सन्दूख यरूशलेम नगरे मां पुज़व गानो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />किछ वक्तेरां बाद दाऊद राज़े अपने सारे सेनापेतन ज़ैना 100 सिपेही ते 1000 सिपेही केरे सेनापति थिये ते सब प्रधान्न सेइं सलाह की। <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />तैखन दाऊदे सारे इस्राएली लोकन सेइं ज़ोवं, “अगर एन तुसन रोड़ू लग्गे त इश्शे परमेशरेरी मर्ज़ी भोए, त इस्राएलेरे सारे इलाकन मां ज़ैना इश्शे भियाल राहोरे भोन ते तैन सेइं ज़ैना याजक ते लेवी अपने-अपने चरागान बाले नगरन मां रहते भोन, तैन जो भी ऐह समाद भेज़म कि असन कां अकोट्ठे भोथ, <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />ते अस अपने परमेशरेरे करारेरो सन्दूख वापस आनम। किजोकि ज़ैस वक्ते शाऊल राज़ो थियो तैस वक्ते अस परमेशरे करां पुछ़नेरे लेई सन्दूखेरे नेड़े न थिये गाते।” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />ते सारे लोकेईं ज़ोवं, कि तैना एरू केरेले, किजोकि ऐह गल तैन सेभी लोकन ठीक लग्गी।<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />तैखन दाऊदे मिस्र मुल्खेरे शीहोर दरियाए करां लेइतां हमात नगरेरी वैदी तगर रानेबाले सारे इस्राएली एल्हेरेलेइ अकोट्ठे किये, कि परमेशरेरो सन्दूख किर्यत्यारीम नगरे मरां यरूशलेम नगरे मां आनम। <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />तैखन दाऊद सारे इस्राएली लोकन साथी नेइतां बाला नगरे मां जेव, ज़ैस जो किर्यत्यारीम भी ज़ोते थिये, ते तै ठार यहूदा प्रदेशे मां थी, कि यहोवा परमेशरेरो सन्दूख तैट्ठां आनम। यहोवा त करूबन पुड़ बिशने बालोए, ते तैसेरू नवं भी एन्ने घिन्नू गाते। <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />तैखन तैनेईं परमेशरेरो सन्दूख अबीनादाबेरे घरे मरां कढो ते एक्‍की नेव्वीं गेड्डी पुड़ च़ाढ़ो, ते उज्जा ते अह्यो तैस गेड्डी च़लाने लगे। <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />दाऊद ते सारे इस्राएली परमेशरेरे सामने तने मने सेइं गीतां ज़ोते ते सितार, सैन्गी, डफली, झ़ेल्‍ली ते नरशिंगो बज़ाते थिये।<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />ज़ैखन तैना किदोन नंव्वेरी ठारारे खलाड़ी तगर आए, तैखन दांतन तैड़ी ठोकर लग्गी ते उज्जा अपनो हथ सन्दूख ठमनेरे लेई अग्रोवं कियो। <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />तैखन यहोवारो क्रोध उज्जा पुड़ भड़को। ते यहोवा तै मारो किजोकि तैनी सन्दूखे सेइं हथ लेवरो थियो। तै तैट्ठी परमेशरे सामने मेरि जेव। <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />तैखन दाऊदे बड़ी सरक अई, एल्हेरेलेइ कि यहोवा उज्जा मारोरो थियो। ते तैनी तैस ठारारू नवं पेरेसुज्जा<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="fq" closed="false">पेरेसुज्जा </char><char style="ft" closed="false">मतलब उज्जारी सज़ाह</char></note> रख्खू, इन नवं अज़ तगर आहे। <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />तैस दिहाड़े दाऊद परमेशरे करां डेरतां ज़ोने लगो, “अवं परमेशरेरो सन्दूख अपने कां इड़ी केन्च़रे एन्हीं?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />तैखन दाऊदे सन्दूख अपने नगर दाऊदपुरे मां न आनो, पन ओबेदेदोम नंव्वेरे गत नगरेरे राने बालेरे कां नेव। <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />ते परमेशरेरो सन्दूख ओबेदेदोमेरे घरे मां ट्लाई महीने तगर राव, ते तैस दौरान यहोवा ओबेदेदोमेरे घराने पुड़ ते ज़ैन किछ तैसेरू थियूं तैस पुड़ भी बरकत दित्ती।<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">दाऊद यरूशलेम नगरे मां मज़बूत भोते</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />एक्सां सोर नगरेरे राज़े हीरामे दाऊदे कां अपनो दूत भेज़े, ते तैसेरो मेहल बनानेरे लेई गैइड़ेरी लकड़ी ते बड़े चनाई केरनेबाले मिस्त्री ते ट्लखान भेज़े। <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />तैखन दाऊदे याकीन भोइ जेवं कि यहोवा तै इस्राएलेरो राज़ो बनेवरोए, किजोकि तैसेरे इस्राएली लोकां केरे खातर तैसेरू राज़ बड़ू बधोरू थियूं।<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />यरूशलेम नगरे मां दाऊदे होरे भी ड्लाह बनाए, ते तैन सेइं होरां भी मट्ठां-कुइयां भोआं। <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />तैसेरे ज़ैना बच्‍चे यरूशलेम नगरे मां भोए, तैन केरां नंव्वां इना आन: शम्मू, शोबाब, नातान, सुलैमान, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />यिभार, एलीशू, एलपेलेत, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />नोगह, नेपेग, यापी, एलीशामा, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />बेल्यादा ते एलीपेलेत।<verse eid="1CH 14:7" /></para>
  <para style="s">पलिश्ती केरि हार</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />ज़ैखन पलिश्ती सेना शुनू कि पूरे इस्राएलेरो राज़ो बनानेरे लेई दाऊदेरू अभिषेक भोवरूए, तैखन सारे पलिश्ती सेना दाऊदे तोपतां ट्लानेरे लेई चढ़ाई की, पन दाऊद एन शुन्तां तैन केरो मुकाबलो केरनेरे लेई निस्सी जेव। <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />पलिश्ती सेना रपाईम नंव्वेरी वैदी मां आई ते तैड़ी हमलो कियो। <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />तैखन दाऊदे परमेशरे पुछ़ू, “कुन अवं पलिश्तन पुड़ हमलो केरि? कुन तू तैन मेरे हथ्थे मां केरेलो?” यहोवा तैस जुवाब दित्तो, “हमलो केर, किजोकि अवं तैन तेरे हथ्थे मां केरेलो।” <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />एल्हेरेलेइ ज़ैना इस्राएली बालपरासीम<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="fq" closed="false">बालपरासीम </char><char style="ft" closed="false">मतलब ज़ेन्च़रे बिदलार फटतीए तेन्च़रे यहोवा कियूं। </char></note> नगरे मां आए, तैखन दाऊदे तैना तैट्ठी मारे; तैखन दाऊदे ज़ोवं, “परमेशर मेरे दुश्मन्न पुड़ पैनेरी गड्डां केरो ज़ेरो ट्लुटी जेव।” एस वजाई सेइं तैस ठारारू नवं बालपरासीम रख्खू जेवं। <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />तैड़ी पलिश्ती सिपैहेईं अपने देबतां केरि मूरती शैरी, ते दाऊदेरे हुक्मेरे मुताबिक तैना मूरती अग लेइतां फुक्‍की छ़ेडी।<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />किछ दिहाड़ना बाद फिरी होरी फेरे पलिश्ती सिपैहेईं तैस्से वैदी मां हमलो कियो। <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />तैखन दाऊदे अपने परमेशरे फिरी पुछ़ू, ते परमेशरे तैस सेइं ज़ोवं, “तू तैन पुड़ सामनेरां वार न केरां, बल्के तैट्ठां मुड़तां तूतां केरे बुट्टां केरे सामनेरां तैन पुड़ हमलो केर। <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />ते ज़ैखन तूतेरे बुट्टन मांमेइं च़लनेरी छ़ेड़ शुनोए, तैखन एन सेमझ़ां कि जंग केरनेरे लेई निस्सां, कि परमेशर पलिश्ती केरि सेना मारनेरे लेई तेरे अग्री-अग्री च़लोरोए।” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />परमेशरेरे इस हुक्मेरे मुताबिक दाऊदे तैन्ने कियूं, ते इस्राएली सेना पलिश्ती सेना गिबोन नगरे करां लेइतां गेजेर नगरे तगर हाराई। <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" />तैखन दाऊदेरी चर्चा सारे मुल्खन मां फैली जेई, ते यहोवा सैरी कौमां केरे दिलन मां तैसेरो डर भेरि दित्तो।<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">पवित्र सन्दूखेरी यरूशलेम नगरे मां वापसी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />दाऊद राज़े दाऊदपुरे<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="fq" closed="false">दाऊदपुरे </char><char style="ft" closed="false">यरूशलेम</char></note> मां अपने लेई मेहल बनाए, ते परमेशरे सन्दूखेरे लेई अक ठार तियार केरतां अक तेम्बु खड़ो कियो। <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />तैखन दाऊदे हुक्म दित्तो, “लेवी केरे अलावा होरि कोन्चे परमेशरेरो सन्दूख छ़ूनेरी अज़ाज़त नईं, किजोकि यहोवा तैना एल्हेरेलेइ च़ुनोरेन कि तैना परमेशरेरो सन्दूख छ़ून ते तैसेरी सेवा हमेशा केरते रान।”<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="NUM 1:50">गिन. 1:50</ref>;<ref loc="DEU 10:8">व्यव. 10:8</ref>.</char></note> <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />तैखन दाऊदे सारे इस्राएली यरूशलेम नगरे मां एल्हेरेलेइ अकोट्ठे किये कि यहोवारो सन्दूख तैस जगाई पुड़ पुज़ान ज़ै तैनी तैसेरे लेई तियार कियोरी थी। <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />एल्हेरेलेइ दाऊदे हारूनेरे खानदानेरे लोक ते लेवी अकोट्ठे किये। <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />कहाती लोकन मरां ऊरीएल नंव्वेरो प्रधान ते तैसेरे 120 भियाल च़ुन्ने। <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />मरारी लोकन मरां असायाह नंव्वेरो प्रधान ते तैसेरे 220 भियाल। <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />गेर्शोमी लोकन मरां योएल नंव्वेरो प्रधान ते तैसेरे 130 भियाल। <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />एलीसापानी लोकन मरां शमायाह नंव्वेरो प्रधान ते तैसेरे 200 भियाल। <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />हेब्रोनी लोकन मरां एलीएल नंव्वेरो प्रधान ते तैसेरे 80 भियाल। <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />ते उज्जीएली लोकन मरां अम्मीनादाब नंव्वेरो प्रधान ते तैसेरे 112 भियाल। <verse eid="1CH 15:10" /><verse number="11" style="v" sid="1CH 15:11" />दाऊदे सादोक ते एब्यातार नंव्वेरे याजक, ते ऊरीएल, असायाह, योएल, शमायाह, एलीएल ते अम्मीनादाब नंव्वेरे लेवी कुजेइतां तैन सेइं ज़ोवं, <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />“तुस त लेवी पूर्वजां केरे घरानेरे प्रधान आथ। एल्हेरेलेइ अपने भियालन समेत अपने-आपे पवित्र केरा, कि तुस इस्राएलेरे परमेशर यहोवारो सन्दूख तैस जगाई पुड़ पुज़ेई सकतथ ज़ै मीं तैसेरे लेई तियार कियोरीए। <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />किजोकि पेइले फेरे तुसेईं तै न थियो छ़ूवरो, एस वजाई सेइं इश्शो परमेशर यहोवा असन पुड़ सेरकोव, किजोकि अस तैसेरी तलाशी मां कानूनेरे मुताबिक न थिये लगोरे।” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />तैखन याजकेईं ते लेवी लोकेईं अपनो-आप पवित्र कियो, कि इस्राएलेरो परमेशर यहोवारो सन्दूख नेइ सकन। <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />तैखन तैस हुक्मेरे मुताबिक ज़ै मूसा यहोवारो वचन शुनेइतां दित्तोरो थियो, लेवी लोकेईं सन्दूख डण्डां केरि ताकती सेइं अपने कंधन पुड़ छ़ुइतां च़लाव।<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />तैखन दाऊदे लेवी प्रधान्न हुक्म दित्तो कि अपने भियालन गीतां ज़ोनेबालन च़ुना ताके तैना सैन्गी, सितार ते झ़ेल्‍ली देइतां बज़ानेरे लेई ते आनन्दे सेइं उच्‍ची आवाज़ी मां गीतां ज़ोन। <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />तैखन लेवी लोकेईं योएलेरू मट्ठू हेमान, ते तैसेरे भियालन मरां बेरेक्याहेरू मट्ठू आसाप, ते अपने भियालन मरां मरारी लोकन मरां कूशायाहेरू मट्ठू एतान च़ुनू। <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />तैन सेइं तैनेईं दूइयोवं पदेरे अपने भियाल जकर्याह, बेन, याजीएल, शमीरामोत, यहीएल, उन्नी, एलीआब, बनायाह, मासेयाह, मत्तित्याह, एलीपलेह, मिकनेयाह ते ओबेदेदोम ते यीएल ज़ैना भवनेरे पहरदार थिये च़ुने। <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />ते हेमान, आसाप ते एतान नंव्वेरे गीतां ज़ोनेबाले त पितलरी झ़ेल्‍ली बज़ेई-बज़ेइतां राग च़लानेरे लेई; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />ते जकर्याह, अजीएल, शमीरामोत, यहीएल, उन्नी, एलीआब, मासेयाह ते बनायाह, अलामोत नंव्वेरे रागे मां सैन्गी बज़ानेरे लेई; <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />ते मत्तित्याह, एलीपलेह, मिकनेयाह ओबेदेदोम, यीएल ते अजज्याह सितार ते खेन्जरी बज़ानेरे लेई रख्खे जे। <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />ते राग उठानेरो अधिकारी कनन्याह नंव्वेरो लेवी केरो प्रधान थियो, तै राग उठानेरे बारे मां शिखालतो थियो, किजोकि तै माहिर थियो। <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />ते बेरेक्याह ते एल्काना सन्दूखेरे पहरदार थिये। <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />ते शबन्याह, योशापात, नतनेल, अमासै, जकर्याह, बनायाह ते एलीएजेर नंव्वेरे याजक परमेशरेरे सन्दूखेरे अग्री-अग्री नरशिंगो बज़ाते च़ले ते ओबेदेदोम ते यहिय्याह तैसेरे पहरदार थिये। <verse eid="1CH 15:24" /><verse number="25" style="v" sid="1CH 15:25" />दाऊद ते इस्राएली केरे बुज़ुर्ग ते 1000 सिपेही केरे सेनापति ते सारे मिलतां यहोवारे करारेरो सन्दूख ओबेदेदोमेरे घरे मरां आनन्दे सेइं आन्नेरे लेई जे। <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />ज़ैखन परमेशरे लेवी केरि मद्दत की ज़ैना यहोवारे करारेरो सन्दूख छ़ूनेबाले थिये, तैखन तैनेईं सत दांत ते सत हुड़ बलि किये। <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />दाऊद ते यहोवारे करारेरो सन्दूख छ़ूनेबाले सारे लेवी ते गीतां ज़ोनेबाले ते तैन सेइं साथी राग उठाने बालां केरो प्रधान कनन्याह, इन सेभेइं सनेरे कपड़ेरे चोगे लेवरे थिये, ते दाऊदे सनेरे कपड़ेरो एपोद लेवरो थियो। <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />एन्च़रां सेइं सारे इस्राएली यहोवारे करारेरे सन्दूखे जयजयकार केरते, ते नरशिंगे, तुरही ते झ़ेल्‍ली बज़ाते ते सैन्गी ते सितार बज़ाते च़ले। <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />ज़ैखन यहोवारे करारेरो सन्दूख दाऊदपुरे मां पुज़्ज़ो तैखन शाऊलेरी कुई मीकल<note caller="+" style="f"><char style="fr" closed="false">15:29 </char><char style="fq" closed="false">मीकल </char><char style="ft" closed="false">दाऊदेरी अक कौन्श मीकल भी थी। 1 शमू. 18:17-30</char></note> दैरी मरां तेकतां दाऊद राज़ो छालां मारतो ते उछ़ड़तो लाव, ते तैसां तै अपने दिले मां घटिया समझ़ो।<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s">सन्दूख तेम्बु मां रख्खो गानो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />ज़ैखन लेवी लोकेईं परमेशरेरे करारेरो सन्दूख एन्हतां तैस तेम्बु मां रख्खो ज़ै दाऊदे तैसेरे लेई बनेवरो थियो। ते परमेशरेरे सामने होमबलि ते मेलबलि च़ैढ़ी जेई। <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />ज़ैखन दाऊद होमबलि ते मेलबलि च़ाढ़ी तैखन तैनी यहोवारे नंव्वे सेइं लोकन आशिर्वाद दित्तो। <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />ते तैनी कौन्शन मड़दन सारे इस्राएली लोकन अक-अक रोट्टी ते अक-अक ट्लाड़ोरो टुक्ड़ो मास<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="fq" closed="false">ट्लाड़ोरो टुक्ड़ो मास </char><char style="ft" closed="false">इसेरो मतलब खजूरां केरो केक भी भोइ सकते</char></note> ते किशमिशेरी अक-अक टिकी बेंटतां दुवाई।<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />तैखन दाऊदे किछ लेवी एल्हेरेलेइ च़ुने, कि यहोवारे सन्दूखेरे सामने सेवा केरते रान, ते इस्राएलेरे परमेशर यहोवारी चर्चा ते तैसेरू शुक्र ते आराधना केरते रान। <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />तैन केरि टोलरो प्रधान त आसाप थियो, ते तैसेरे बाद जकर्याह थियो, फिरी यीएल, शमीरामोत, यहीएल, मत्तित्याह, एलीआब, बनायाह, ओबेदेदोम ते यीएल थिये। ऐन कां त सैन्गी ते सितार बज़ानेबाले थी, ते आसाप झ़ैल्‍लन पुड़ राग बज़ातो थियो। <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />बनायाह ते यहजीएल याजक परमेशरेरे करारेरे सन्दूखेरे सामने रोज़ तुरही बज़ानेरे लेई च़ुने जे।<verse eid="1CH 16:6" /></para>
  <para style="s">दाऊदेरे ज़िरिये शुक्रेरू गीत</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />तैखन तैस्से दिहाड़े दाऊदे यहोवारू शुक्र केरनेरू गीत ज़ोनू आसाप ते बाकी लेवी लोकन दित्तू।<verse eid="1CH 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="1CH 16:8" />यहोवारू शुक्र केरा, तैस कां प्राथना केरा।</para>
  <para style="q" vid="1CH 16:8">मुल्खे-मुल्खे मां तैसेरे कम्मां केरो प्रचार केरा।<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />तैसेरां गीतां ज़ोथ, तैसेरी तारीफ़ केरा,</para>
  <para style="q" vid="1CH 16:9">तैसेरे सारे चमत्कारेरे कम्मन पुड़ ध्यान केरा।<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />तैसेरे पवित्र नंव्वे पुड़ घमण्ड केरा।</para>
  <para style="q" vid="1CH 16:10">ज़ैना यहोवारे तोप्पने बालेन तैन केरो दिल खुश भोए।<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />यहोवा ते तैसेरी शक्ति तोप्पा;</para>
  <para style="q" vid="1CH 16:11">तैसेरे दर्शनेरे लेई लगातार तलाश केरा।<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1CH 16:12" />तैसेरे कियोरां बड्डां कम्मां</para>
  <para style="q" vid="1CH 16:12">ते कियोरे चमत्कार याद केरा।<verse eid="1CH 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1CH 16:13" />हे तैसेरे दास इस्राएलेरे खानदानेरे लोकव,</para>
  <para style="q" vid="1CH 16:13">हे याकूबेरे घरानेरे लोक तुस ज़ैना तैसेरे च़ुनोरेथ!<verse eid="1CH 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />तैए इश्शो परमेशर यहोवा आहे,</para>
  <para style="q" vid="1CH 16:14">तैसेरां न्यायेरां कम्मां सैरी धेरती पुड़ भोतन।<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />तैसेरो करार हमेशा याद रखा,</para>
  <para style="q" vid="1CH 16:15">ई तैए वचने ज़ै तैनी हज़ार पीढ़ी केरे लेई ठहरावरोए।<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />तै करार तैनी अब्राहमे सेइं कियो</para>
  <para style="q" vid="1CH 16:16">ते तैसेरे बारे मां तैनी इसहाके सेइं कसम खाई,<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />ते तैए तैनी याकूबेरे लेई विधि</para>
  <para style="q" vid="1CH 16:17">केरतां ते इस्राएलेरे लेई हमेशारे लेई करार केरतां एन ज़ोइतां मज़बूत कियो,<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />तैनी ज़ोवं, “अवं कनान मुल्ख तीं देइलो,</para>
  <para style="q" vid="1CH 16:18">तै बन्टने मां तुश्शो अपनो हिस्सो भोल्हो।”<verse eid="1CH 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />तैस मौके त तुस परमेशरेरे लोक गिनती मां थोड़े थिये,</para>
  <para style="q" vid="1CH 16:19">बल्के बड़े घट थिये ते तैस मुल्खे मां परदेशी थिये।<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />ते तैना एक्‍की कौमी मरां होरी कौमी मां,</para>
  <para style="q" vid="1CH 16:20">ते एक्‍की रियासती मरां होरी रियासती मां फिरते राए,<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />पन परमेशरे कोन्ची मैन्हु तैन पुड़ ज़ुलम केरने न दित्तो।</para>
  <para style="q" vid="1CH 16:21">बल्के अपने लोकां केरे लेई तैन राज़न ई धमकी देतो थियो,<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />“ज़ैना मीं च़ुनोरेन तैन सेइं न हुरा,</para>
  <para style="q" vid="1CH 16:22">ते न मेरे नेबी केरो नुकसान केरा।”<verse eid="1CH 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />हे सारे दुनियारे लोक यहोवारू गीत ज़ोथ।</para>
  <para style="q" vid="1CH 16:23">रोज़ तैसेरे कियोरे छुटकारेरी खुशखबरी शुनाते राथ।<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />गैर कौमन मां तैसेरी महिमा केरा,</para>
  <para style="q" vid="1CH 16:24">ते मुल्खां-मुल्खां केरे लोकन मां तैसेरे कियोरे चमत्कारां केरे बारे मां बियान केरा।<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />किजोकि यहोवा बड़ो महान ते तारीफ़रे काबले,</para>
  <para style="q" vid="1CH 16:25">ते सारे देबतन करां जादे तैसेरो डर मन्ना।<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />किजोकि मुल्खां-मुल्खां केरे सारे देबते सिर्फ मूरती आन।</para>
  <para style="q" vid="1CH 16:26">पन यहोवा सुर्ग बनेवरूए।<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />तैसेरे च़ेवरे पासन वैभव ते ऐश्वर्य आहे;</para>
  <para style="q" vid="1CH 16:27">तैसेरे ठारी पुड़ सामर्थ ते आनन्दे।<verse eid="1CH 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />हे मुल्खां-मुल्खां केरे कुलां केरे लोकव, यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="1CH 16:28">यहोवारी महिमा ते शक्ति मन्ना।<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />यहोवारे नंव्वेरी एरी महिमा मन्ना ज़ै तैसेरे नंव्वेरे काबले।</para>
  <para style="q" vid="1CH 16:29">च़ढ़तल घिन्तां तैसेरे सामने एज्जा,</para>
  <para style="q" vid="1CH 16:29">पवित्र भोइतां सेज़तां यहोवारे सामने मथ्थो टेका।<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />हे सैरी धेरतरे लोकव तैसेरे सामने थरकां!</para>
  <para style="q" vid="1CH 16:30">संसार एन्च़रे टिकोरूए, कि तैन हिलनेरू नईं।<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />अम्बर खुशी मनाए ते धरती मघन भोए,</para>
  <para style="q" vid="1CH 16:31">ते कौमी-कौमी मां लोक ज़ोन, “यहोवा राज़ोए।”<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />समुन्दर ते तैस मां ज़ैन आहे गरज़े,</para>
  <para style="q" vid="1CH 16:32">मैइदान ते ज़ैन किछ तैस मांए खुश भोन।<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />तैस्से वक्ते जंगलेरे बुट यहोवारे सामने जयजयकार केरन,</para>
  <para style="q" vid="1CH 16:33">किजोकि तै धेरतरो न्याय केरने एजनेबालोए।<verse eid="1CH 16:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />यहोवारू शुक्र केरा, किजोकि तै भलोए।</para>
  <para style="q" vid="1CH 16:34">ते तैसेरी दया हमेशारीए।<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />ते इन ज़ोथ, “हे असन मुक्ति देनेबाले परमेशर असन छुटकारो दे,</para>
  <para style="q" vid="1CH 16:35">ते असन अकोट्ठे केर ते गैर कौमन करां छुटा,</para>
  <para style="q" vid="1CH 16:35">कि अस तेरे पवित्र नंव्वेरू शुक्र केरम,</para>
  <para style="q" vid="1CH 16:35">ते तेरी तारीफ़ केरते तेरे बारे मां बडीयाई केरम।<note caller="-" style="x"><char style="xo" closed="false">16:35 </char><char style="xt" closed="false"><ref loc="PSA 106:47">भज. 106:47</ref>.</char></note><verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />शुरू करां लेइतां हमेशा तगर इस्राएलेरे</para>
  <para style="q" vid="1CH 16:36">परमेशर यहोवारी तारीफ़ भोए।”</para>
  <para style="m" vid="1CH 16:36">दाऊदेरे ज़ोनेरे बाद सारे लोकेईं “आमीन” ज़ोवं, ते यहोवारी तारीफ़ की। <verse eid="1CH 16:36" /><verse number="37" style="v" sid="1CH 16:37" />तैखन दाऊदे यहोवारे करारेरे सन्दूखेरे सामने आसाप ते तैसेरे भियाल रख्खे, कि तैना रोज़ेरे ज़रूरतरे मुताबिक तैस सन्दूखेरे सामने रोज़ सेवा केरते रान, <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />ते 68 लेवी खानदानेरे लोकन समेत ओबेदेदोम, ते पहरेदारां केरे लेई यदूतूनेरू मट्ठू ओबेदेदोम, ते होसा च़ुने। <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />फिरी तैनी सादोक याजक ते बाकी याजक यहोवारे तेम्बेरे सामने, ज़ै गिबोन नगरेरे उच्‍ची ठारी रहतो थियो च़ुनो, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />कि तैना रोज़ झ़ेझ़ां ड्लवझ़ां होमबलि च़ाढ़नेरी वेदी पुड़ यहोवा कां होमबलि च़ाढ़ते रान, ते तैन सेभी केरे मुताबिक केरन, ज़ैन यहोवारे कानूने मां लिखेरूए, ज़ै तैनी इस्राएली लोकन दित्तोरो थियो। <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />ते तैन सेइं साथी तैनी हेमान ते यदूतून ते होरे भी ज़ैना नवं घिन्तां च़ुनोरे थिये ठहराए, कि यहोवारी हमेशा दयारे वजाई सेइं तैसेरू शुक्र केरन। <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />ते तैन सेइं साथी तैनी हेमान ते यदूतून बज़ानेबालां केरे लेई तुरही ते झ़ेल्‍ली ते परमेशरेरां गीतां ज़ोनेरे लेई बाज़े दित्ते, ते यदूतूनेरां मट्ठां फाटकेरी रखवाली केरनेरे लेई च़ुना।<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />तैखन सारे लोक अपने-अपने घरे जो च़ले जे, ते दाऊद अपने घराने आशिर्वाद देनेरे लेई अपने घरे जो वापस च़लो जेव।<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">दाऊद राज़े सेइं परमेशरेरो करार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />ज़ैखन दाऊद राज़ो अपने मेहले मां राने लगो, तैखन दाऊदे नातान नेबी सेइं ज़ोवं, “हेर, अवं त गैइड़ेरी लेकड़रे बनोरे मेहले मां रहताईं, पन यहोवारे करारेरो सन्दूख तेम्बु मां आहे।” <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />नातान नेबे दाऊद राज़े सेइं ज़ोवं, “ज़ैन किछ तेरे दिले मांए तैन्ने केर, किजोकि परमेशर तीं सेइं साथीए।”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />तैस्से राती परमेशरे नातान नेबी सेइं ज़ोवं, “गेइतां मेरे दास दाऊदे सेइं ज़ो, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />‘यहोवा इन ज़ोते: मेरे लेई भवन तू न बनेई बटेलो ज़ैड़ी अवं रेईं। <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />किजोकि ज़ैस दिहाड़े मीं इस्राएली लोक मिस्र मुल्खे मरां आनोरे थिये, अज़ तगर अवं कोन्ची घरे मां नईं राहोरो। पन एक्‍की तेम्बु मरां होरि तेम्बु मां ते एक्‍की रानेरी ठारी पुड़ेरां होरि रानेरी ठारी पुड़ एज्जां गेइयां केरताईं। <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />ज़ैड़ी-ज़ैड़ी अवं सारे इस्राएली लोकां केरे मझ़ाटे एज्जां गेइयां केरताईं, कुन मीं इस्राएलेरे प्रधान ज़ैना मीं अपने लोकां केरि पुहाली केरनेरे लेई रखोरे थिये, कोन्ची सेइं एरी गल ज़ोई कि तुसेईं मेरे लेई गैइड़ेरी लेकड़रू घर कि न बनावं? <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />एल्हेरेलेइ, तू मेरे सेवक दाऊदे सेइं एन्च़रे ज़ो, कि सेनां केरो यहोवा इन ज़ोते, कि मीं तू गब्बां केरे गोठे ते गब्बन पत्ती-पत्ती फिरने करां इस इरादे सेइं कुजव, कि तू मेरे इस्राएली लोकां केरो प्रधान भोस। <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />ते ज़ैड़ी-ज़ैड़ी तू अव ते जेव, तैड़ी अवं तीं सेइं साथी राव, ते तेरे सारे दुश्मन तेरे सामनेरां नष्ट कियोरेन। हुनी अवं तेरू नवं बड्डे-बड्डे प्रधानां केरे नंव्वां केरू ज़ेरू महान केरेलो। <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />ते अवं अपने इस्राएली लोकां केरे लेई अक ठार च़ुनेलो, ते तैन मज़बूत केरेलो कि तैन अपने ठारी पुड़ बस्सोरे रान ते कधी इरां उरां घुमने बाले न भोन। ते बुरे लोक तैन नाश न केरि बटेले, ज़ेन्च़रे कि पेइले ज़ैखन करां मीं न्याय केरनेरे बाले अपने इस्राएली लोकन पुड़ च़ुनोरे थिये केरते थिये, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />बल्के तैस मौके भी ज़ैखन अवं अपने इस्राएली लोकन पुड़ न्याय केरनेबालो ठहरातो थियो। ते अवं तेरे सारे दुश्मन्न दबेइ छ़डेलो। फिरी अवं तीं इन भी ज़ोताईं, कि यहोवा तेरे खानदाने मरां राज़ो बनातो रालो। <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />ज़ैखन तेरी उमर पूरी भोइ गाली ते तीं भी अपने दादे-पड़दादां केरू ज़ेरू मरनू पेलू, तैखन अवं तेरे मट्ठन मरां अक राज़ो बनेइतां तैसेरू राज़ कायम केरेलो।<note caller="-" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="1KI 2:10-11">1 राज़. 2:10-11</ref>;<ref loc="2SA 7:12">2 शमू. 7:12</ref>.</char></note> <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />मेरे लेई अक भवन तैए बनालो, ते अवं तैसेरो तखत हमेशा मज़बूत केरेलो। <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />ते अवं तैसेरो बाजी भोल्हो ते तैन मेरू मट्ठू भोल्हु। ते ज़ेन्च़रे मीं अपनि दया तैस पुड़ेरां ज़ै तीं करां पेइलो राज़ो थियो हटाई, तेन्च़रे अवं तैस पुड़ेरां न हटेइलो,<note caller="-" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 शमू. 7:14</ref>.</char></note> <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />बल्के अवं तैस अपने भवन ते अपने राज़े मां हमेशारे लेई कायम केरेलो ते तैसेरो तखत हमेशा अटल रालो।’” <verse eid="1CH 17:14" /><verse number="15" style="v" sid="1CH 17:15" />इन सब गल्‍लां ते एस दर्शनेरे मुताबिक नातान नेबे दाऊदे सेइं ज़ोवं।<verse eid="1CH 17:15" /></para>
  <para style="s">दाऊद राज़ेरी शुक्रेरी प्राथना</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />तैखन दाऊद राज़ो यहोवारे तेम्बु मां अन्तर गेइतां करारेरे सन्दूखेरे सामने बिशतां प्राथना केरने लगो, “हे यहोवा परमेशर! अवं कुन आईं? ते मेरो घरानेरो कुने? कि तीं अवं इड़ी तगर पुज़ोरोईं? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />हे परमेशर! ई तेरी नज़री मां निकड़ी ज़ेरि गल भोइ, किजोकि तीं अपने दासेरे घरानेरे बारे मां एजने बाले बड़े दिहाड़ां केरि चर्चा कियोरीए, ते हे यहोवा परमेशर! तीं मीं सेइं एरहो बर्ताव कियोरोए कि ज़ेरो अवं खास मैन्हु आईं। <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />ज़ै आदर तीं अपने दास मीं पुड़ हिराई, तैसेरे बारे मां दाऊद तीं सेइं होरू कुन ज़ोई सकते? तू त अपने दासे ज़ानतस। <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />हे यहोवा! तीं अपने दासेरे खातर ते अपने मनेरे मुताबिक इन बड्डू कम कियोरूए, कि तेरो दास तैस सेमझ़ी सखे। <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />हे यहोवा! ज़ैन किछ असेईं तेरे बारे अपने कन्नेईं सेइं शुनेरूए, तैसेरे मुताबिक तेरे बराबर कोई नईं, ते न तेरे अलावा होरो कोई परमेशरे। <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />फिरी तेरे इस्राएली लोकां केरो ज़ेरो भी कौने? तै त सैरी धेरती पुड़ अक्‍के कौमे, तैना परमेशरे गेइतां अपने खास लोक बन्नेरे लेई छुटाए, एल्हेरेलेइ कि तू बड़ां डरानेबालां कम्मां केरतां अपनु नवं महान केरस, ते अपने लोकां केरे सामने ज़ैना तीं मिस्र मुल्खे मरां छुटेइतां आनोरे थिये, कौमां-कौमां केरे लोक कढे। <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />किजोकि तीं अपने इस्राएली लोक हमेशारे लेई अपने लोक भोनेरे लेई च़ुने, ते हे यहोवा! तू एप्पु भी तैन केरो परमेशर बनो। <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />एल्हेरेलेइ, हुनी हे यहोवा, तीं ज़ै वाधो अपने दासेरे घरानेरे बारे मां कियोरोए, तै हमेशा अटल राए, ते अपने वाधेरे मुताबिक केर। <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />ते तेरू नवं हमेशा अटल राए, ते एन ज़ोइतां तेरी तारीफ़ हमेशा भोती राए, कि सेनां केरो यहोवा इस्राएलेरो परमेशरे, बल्के तै इस्राएलेरे लेई परमेशरे, ते तेरे दास दाऊदेरो घरानो तेरे सामने अटल राए। <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />किजोकि हे मेरे परमेशर, तीं एन ज़ोइतां अपने दासे पुड़ बांदू कियूं कि अवं तेरू घरानो बनेइतां रखेलो, एस वजाई सेइं तेरे दासे तेरे सामने प्राथना केरनेरी हिम्मत भोवरीए। <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />ते हुनी हे यहोवा तूए परमेशरस, ते तीं अपने दासे सेइं ई भलियाई केरनेरो वाधो कियोरोए। <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />ते हुनी तीं खुशी भोइतां, अपने दास मेरे घराने पुड़ ई बरकत दित्तोरीए, कि तै तीं कां हमेशा बनोरो राए, किजोकि हे यहोवा तीं बरकत दित्तोरीए, एल्हेरेलेइ तै हमेशा बरकत देतो रालो।”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">दाऊदेरी हमेशा ज़ीत भोनेरे बारे मां ज़िक्र</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />किछ वक्तेरां बाद दाऊद राज़े पलिश्ती ज़ींतां अपने कब्ज़े मां किये, ते ड्लाव्वन समेत गत नगर भी पलिश्ती केरे हथ्थेरां थुसोड़तां अपने कब्ज़े मां कियूं। <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />फिरी तैनी मोआबी लोक भी ज़ींते, ते मोआबी दाऊदेरे अधीन भोइतां दाऊदे जो लगान देने लगे।<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />फिरी ज़ैखन सोबा प्रदेशेरो राज़ो हदादेजेर फरात दरियाए तगर राज़ केरनू चातो थियो, तैखन दाऊदे तै हमात नगरे कां हाराव। <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />दाऊदे तैस करां 1000 रथ, 7000 सुवार, ते 20000 पैदल सिपाही ज़ींते, ते दाऊदे सब रथे बाले घोड़ां केरि ज़ैधू केरि पेत्री नस कटाई, पन 100 रथे बाले घोड़े केरि नस न कटाई। <verse eid="1CH 18:4" /><verse number="5" style="v" sid="1CH 18:5" />ज़ैखन दमिश्क रियासतरे अरामी सिपाही, सोबारे राज़े हदादेजेरी मद्दत केरनेरे लेई आए, तैखन दाऊदे 22000 अरामी सिपाही मारे। <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />तैखन दाऊदे दमिश्केरे अरामे मां सेनारी चौकी बिशैली। एल्हेरेलेइ अरामी दाऊदेरे अधीन भोइतां लगान देने लगे। ते ज़ैड़ी-ज़ैड़ी दाऊद गातो थियो, तैड़ी यहोवा तैस ज़ींत देतो थियो। <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />ते हदादेजेर राज़ेरे सेनारे अधिकैरन कां ज़ैना सोन्नेरी ढालां थी, तैना दाऊदे यरूशलेम नगरे मां ऐनी। <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />ते हदादेजेरेरे तिभत ते कून नंव्वेरे नगरन मरां दाऊदे बड़ी पितल आनी। ते तैस्से सेइं सुलैमाने पितलरां कुण्डां ते खम्भे ते पितलरां भांडां बनावां।<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />ज़ैखन हमात रियासतरे राज़े तोऊए शुनू कि दाऊदे सोबारे राज़े हदादेजेरेरी सारी सेना ज़ींतोरीए, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />तैखन तैनी हदोराम नंव्वेरू अपनु मट्ठू दाऊद राज़े कां तैसेरो हाल चाल पुछ़ने ते मुबारक देनेरे लेई भेज़ू, एल्हेरेलेइ कि तैनी हदादेजेरे सेइं लेड़तां तै ज़ींतोरो थियो। (किजोकि हदादेजेर तोऊए सेइं लड़तो रहतो थियो) ते हदोरामे सोन्नू चाँदी ते पितल ते हर किसमेरां भांडां आनोरां थियां। <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />तैना दाऊद राज़े यहोवारे लेई पवित्र केरतां रखां, ते तेन्च़रे तैस सोन्ने-चाँदी सेइं भी कियूं, ज़ैन एदोमी, मोआबी, अम्मोनी, पलिश्ती ते अमालेकी लोकन करां नेवरू थियूं।<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />फिरी सरूयाहेरे मट्ठे अबीशै लूनेरी वैदी मां 18000 एदोमी सिपाही मारे। <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />तैखन दाऊदे एदोम प्रदेशे मां सेनारी चौकी बिशैली। ते सारे एदोमी दाऊदेरे अधीन भोइ जे। ते दाऊद ज़ैड़ी भी गातो थियो तैड़ी यहोवा तैस ज़ींत देतो थियो। <verse eid="1CH 18:13" /><verse number="14" style="v" sid="1CH 18:14" />दाऊद सारे इस्राएले पुड़ राज़ केरतो थियो, ते तै अपने सारे लोकन सेइं न्याय ते धार्मिकतारां कम्मां केरतो थियो। <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />प्रधान सेनापति सरूयाहेरू मट्ठू योआब थियूं। इतिहास लिखने बालो अहीलूदेरू मट्ठू यहोशापात थियूं। <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />प्रधान याजक, अहीतूबेरू मट्ठू सादोक, ते एब्यातारेरू मट्ठू अबीमेलेक थियूं, आदालतरो सचिव<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="fq" closed="false">आदालतरो सचिव </char><char style="ft" closed="false">राज़ेरो लिखने बालो</char></note> शबशा थियो। <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />करेती ते पलेती लोकां केरो प्रधान यहोयादारू मट्ठू बनायाह थियूं। ते दाऊदेरां बडां मट्ठां तैसेरे खास अधिकारी थिये।<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">अम्मोनी सेना पुड़ ज़ीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />किछ वक्तेरां बाद अम्मोनी केरो राज़ो नाहाश मेरि जेव, ते तैसेरू मट्ठू तैसेरे जगाई पुड़ राज़ो बनो। <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />ज़ैखन दाऊद राज़े इस बारे मां शुनू त तैने एन सोचू, “हानूनेरे बाजी नाहाशे ज़ै हमदरदी मीं सेइं कियोरी थी, एल्हेरेलेइ अवं भी तैस सेइं हमदरदी केरतां हरेइलो।” तैखन दाऊदे तैसेरे बाजी केरे बारे मां शान्ति देनेरे लेई अधिकारी भेज़े। ते दाऊदेरे अधिकारी अम्मोनी केरे मुल्खे मां हानूने कां तैस शान्ति देने जे। <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />पन अम्मोनी केरे हाकिम हानूने सेइं ज़ोने लगे, “दाऊदे ज़ैना तीं कां शान्ति देनेबाले भेज़ोरेन, तैना कुन तेरी समझ़ी मां तेरे बाजी केरि आदर केरनेरे इरादे सेइं तीं कां भेज़ोरेन? कुन तैसेरे अधिकारी एस इरादे सेइं तीं कां नईं एवरे, कि तेरे मुल्खेरो हाल पतो केरन ते नाश केरन ते भेद घिन्तां गान?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />एल्हेरेलेइ हानूने दाऊदेरे अधिकारी ट्लाते, ते तैन केरे बाल कट्टाए, ते तैन केरे लिगड़ां केरो बुनियों हिस्सो केटतां गाने दित्ते। <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />तैखन किछ लोकेईं गेइतां दाऊदे सेइं ज़ोवं कि तैन मड़दन सेइं केरो बर्ताव कियो जेव, ते तैनी तैस सेइं मिलनेरे लेई भेज़े किजोकि तैना मैन्हु बड़े शरमिन्दा थिये, ते दाऊद राज़े तैन जो बिस्तार भेज़ो, “ज़ांतगर तुश्शी दैढ़ी न बेडोन, तांतगर यरीहो नगरे मां रुकोरे राथ, ते बादे मां वापस एज्जा।”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />ज़ैखन अम्मोनी लोकेईं हेरू, कि दाऊद ई दुश्मन बनेवरोए, तैखन हानूने ते अम्मोनी लोकेईं लगभग 35000 किल्‍लो चाँदी, अरम्नहरैम ते अरम्माका ते सोबा जो भेज़ी, ते रथ ते सुवार किरैइये पुड़<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="fq" closed="false">रथ ते सुवार किरैइये पुड़ </char><char style="ft" closed="false">पुराने वक्ते मां रथ ते सिपाही लड़नेरे लेई किरैइये पुड़ आने गाते थिये।</char></note> कुजाए। <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />ते तैनेईं 32000 रथ, ते माका मुल्खेरो राज़ो ते तैसेरी सेना किरैइये पुड़ कुजाई, ते तैनेईं एइतां मेदबा नगरेरे सामने अपने डेरे खड़े किये। ते अम्मोनी अपने-अपने नगरन मरां अकोट्ठे भोइतां लड़ने जो आए। <verse eid="1CH 19:7" /><verse number="8" style="v" sid="1CH 19:8" />एन शुन्तां दाऊदे योआब ते शूरबीरां केरि पूरी सेना लड़नेरे लेई भेज़ी। <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />तैखन अम्मोनी निस्से ते रब्बाह नगरेरे फाटके कां लड़नेरे लेई तियार भोए, ते ज़ैना राज़े एवरे थिये, तैना तैन करां अलग मैइदाने मां लड़नेरे लेई तियार थिये।<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />एन हेरतां कि अग्रोवं पत्रोवं दूईये पासन इश्शे खलाफ लड़नेरे लेई तियारी कियोरीए, योआबे सारे माहिर इस्राएली शूरबीरन मरां किछ तैलतां अरामी केरे सामने तैना लड़नेरे तियार रख्खे। <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />ते बाकी सिपाही अपने ढ्ला अबीशैरे हथ्थे मां सौंफे, ते तैना अम्मोनी केरे सामने लड़नेरे लेई तियार किये। <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />योआबे ज़ोवं, “अगर अरामी मीं पुड़ भारी भोइ गान, त तू मेरी मद्दत केरां। ते अगर अम्मोनी तीं पुड़ भारी भोन, त अवं तेरी मद्दत केरेलो। <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />तू हिम्मत रख ते अस सारे अपने लोकन ते अपने परमेशरेरे नगरां केरे लेई खातर हिम्मत केरतां लड़म। ते यहोवा ज़ैन तैस रोड़ू लगे तै तैन्ने केरेलो।” <verse eid="1CH 19:13" /><verse number="14" style="v" sid="1CH 19:14" />एल्हेरेलेइ योआब ते ज़ैना सिपाही तैस सेइं साथी थिये, अरामी सेना सेइं जंग केरनेरे लेई तैन केरे सामने जे, पन अरामी सेना तैन केरे सामनेरां नश्शी। <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />एन हेरतां कि अरामी नेश्शी जेवरेन, अम्मोनी भी तैसेरे ढ्ला अबीशैरे सामनेरां नेशतां अपने नगरे मांजो च़ले जे। तैखन योआब यरूशलेम नगरे जो वापस अव।<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />फिरी एन हेरतां कि तैना इस्राएली सेना करां हारे, अरामी लोकेईं दूत भेज़तां फरात दरियाएरे पार अरामी सिपाही कुजाए, ते हदादेजेर राज़ेरो सेनापति शोपक अपनो प्रधान बनाव। <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />एसेरी खबर शुन्तां दाऊदे सारे इस्राएली अकोट्ठे किये, ते यरदन दरियारे पार गेइतां तैन पुड़ हमलो कियो, ते तैन केरो मुकाबलो केरनेरे लेई तियार भोए, ते तैखन तैना तैन सेइं लड़ने लगे। <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />पन अरामी इस्राएली सेना करां नेश्शी जे, ते दाऊदे तैन मरां 7000 रथ च़लानेबाले ते 40000 पैदल सिपाही मारे, ते शोपक अरामी सेनापति भी मारो। <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />एन हेरतां कि तैना इस्राएली सेना हारोरेन, हदादेजेरेरे अधिकैरेईं दाऊद राज़े सेइं समझोतो कियो ते तैसेरे अधीन भोइ जे। एल्हेरेलेइ अरामी सेना अम्मोनी केरि मद्दत फिरी न की।<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">रब्बाह नगरे पुड़ ज़ीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />फिरी नंव्वे सालेरी शुरुआती मां ज़ैखन राज़े जंग केरनेरे लेई गाते थिये, तैखन योआबे बड़ी भारी सेना साथी नेइतां अम्मोनी केरो मुल्ख उज़ाड़ो ते एइतां रब्बाह नगर भी घेरू। पन दाऊद यरूशलेम नगरे मां राव। ते योआबे रब्बाह नगर ज़ींतू ते तबाह कियूं।<note caller="-" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="2SA 11:1">2 शमू. 11:1</ref>.</char></note> <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />तैखन दाऊद राज़े तैन केरे राज़ेरू सोन्नेरू ताज तैसेरे क्रोड़ी पुड़ेरां<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fq" closed="false">क्रोड़ी पुड़ेरां </char><char style="ft" closed="false">भोइ सकते कि आमोनी केरे देबते मूरती पुड़ां उसालेरू भोए। </char></note> उसालू, ज़ेसेरो वज़न लगभग 35 किल्‍लो थियो, ते तैस मां मणि भी लेवरी थी। ते तैन दाऊदे लुवावं जेवं। फिरी तैस नगरे मां बड़ू सामान तैन लुटी मां मैल्हू। <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />तैनी तैस नगरे मां रानेबाले लोक केढतां आरन सेइं ते लोंहेरे फने सेइं ते मैक्‍कन सेइं कटाए। ते अम्मोनी केरे सारे नगरन सेइं भी दाऊदे तैन्ने कियूं। तैखन दाऊद सारे लोकन सेइं साथी यरूशलेम नगरे जो वापस जेव।<verse eid="1CH 20:3" /></para>
  <para style="s">पलिश्ती बहादरां केरो नाश</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />इसेरे बाद गेजेर नगरे मां पलिश्ती सेना सेइं जंग भोइ। तैस मौके हूशाई सिब्बकै, सिप्पै मारो, ज़ै रपारे खानदाने मरां थियो। ते पलिश्ती हारे। <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />किछ वक्तेरां बाद पलिश्तन सेइं फिरी जंग भोइ। तैस मां याईरेरे मट्ठे एल्हनाने पलिश्ती केरे गत नगरेरे गोलियतेरो ढ्ला लहमी मारो, ज़ेसेरो भालो ज़ुलाहेरे डण्डे बराबर लम्मो थियो। <verse eid="1CH 20:5" /><verse number="6" style="v" sid="1CH 20:6" />फिरी गत नगरे मां भी जंग भोइ, ते तैड़ी अक मैन्हु थियो ज़ै बड़ो लम्मो थियो, ज़ै रापारी खानदाने मरां थियो, ते तैसेरे हथ्थन ते पव्वन शा-शा एंगलोई थी मतलब सैरी मिलेइतां 24 एंगलोई थी। <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />ज़ैखन तैनी इस्राएली ललकारे, तैखन दाऊदेरे ढ्ला शिमारे मट्ठे योनाताने तै मारो। <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />एन्ना गत नगरे मां रापारे खानदाने मरां थिये, ते तैना दाऊद ते तैसेरे सिपैहेईं मारे।<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">दाऊद राज़ेरे ज़िरिये इस्राएलेरी केरि गिनती</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />एक्सां शैताने इस्राएलेरे खलाफ उठतां, दाऊद उकसव कि इस्राएली केरि गिनती केरे। <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />तैखन दाऊदे योआब ते इस्राएली केरे प्रधान्न हुक्म दित्तो, “तुस गेइतां बेर्शेबा नगरे करां लेइतां दान नगरे तगर इस्राएली केरि गिनती केरतां मीं सेइं ज़ोथ, ते मीं पतो च़ले कि तैना केत्रे आन।” <verse eid="1CH 21:2" /><verse number="3" style="v" sid="1CH 21:3" />पन योआबे ज़ोवं, “यहोवारे लोक चाए केत्रे किना भोन, तै तैन शौ गुणा बधाए। पन हे मेरे मालिक! हे राज़ा! कुन तैना सारे राज़ेरे अधीन नईं? मेरो मालिक एरी गल किजो चाते? तै इस्राएले पुड़ दोष लगनेरी वजा किजो बने?” <verse eid="1CH 21:3" /><verse number="4" style="v" sid="1CH 21:4" />फिरी भी राज़ेरो हुक्म योआबे मन्नो पेव। तैखन योआबे गेइतां सारे इस्राएल मुल्खे मां गेइतां गिनती की ते यरूशलेम नगरे जो वापस अव। <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />तैखन योआबे लोकां केरि गिनती दाऊदे शुनाई ते सारे तलवार च़लनेबाले सिपाही इस्राएलेरे 1100000, ते यहूदारे 470000 निस्से। <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />पन तैन मां योआबे लेवी ते बिन्यामीनी न गने, किजोकि योआब राज़ेरो हुक्म मन्ने सेइं राज़ी न थियो।<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />ते दाऊदेरो ऐह हुक्म परमेशरे बुरो लग्गो, एल्हेरेलेइ तैनी इस्राएले सज़ाह दित्ती। <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />ते दाऊदे परमेशरे कां प्राथना की, “इन कम ज़ैन मीं कियूं, तै बड़ो पापे। पन हुनी अपने दासेरो अधर्म माफ़ केर। मीं त बड़ी बेवकूफी कियोरीए।” <verse eid="1CH 21:8" /><verse number="9" style="v" sid="1CH 21:9" />तैखन यहोवा दाऊदेरे नेबी गादे सेइं ज़ोवं, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“गेइतां दाऊदे सेइं ज़ो, ‘यहोवा इन ज़ोते कि अवं तीं ट्लाई आफतां हिराताईं, तैन मरां अक च़ुन, कि अवं तैस तीं पुड़ छ़ेडी।’” <verse eid="1CH 21:10" /><verse number="11" style="v" sid="1CH 21:11" />तैखन गादे दाऊदे कां गेइतां तैस सेइं ज़ोवं, “यहोवा इन ज़ोते, कि इन ट्लाई आफतन मरां ज़ैस तू चास तैस च़ुन: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />या त ट्लाई साल काल पे; या ट्लाई महीन्न तगर तेरे दुश्मन तेरो पीछो केरते रान, ते तेरे दुश्मना केरि तलवार तीं पुड़ च़लती राए। या ट्लाई दिहाड़न तगर यहोवारी तलवार च़ले, मतलब तेरे मुल्खे मां मरी फैले ते यहोवारो दूत इस्राएलेरे च़ेवरे पासन नाश केरतो राए। हुनी सोच, कि अवं अपने भेज़ने बाले यहोवा कुन जुवाब देईं।” <verse eid="1CH 21:12" /><verse number="13" style="v" sid="1CH 21:13" />तैखन दाऊदे गादे सेइं ज़ोवं, “अवं बड़े मुसीबती मां फसोरोइं। अवं यहोवारे हथ्थे मां पेलो। किजोकि तैसेरी दया बड़ीए; पन मैन्हेरे हथ्थे मां न पेनू पे।”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />तैखन यहोवा इस्राएले मां मरी फैलाई, ते 70000 इस्राएली मरे। <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />फिरी यहोवा अक दूत यरूशलेम नगरेरो नाश केरनेरे लेई भी भेज़ो; ते तै नाश केरने पुड़ थियो, कि यहोवा तैस दुख देने करां अफ़सोस भोव, ते तैनी नाश केरनेबाले दूते सेइं ज़ोवं, “बस केर; हुनी अपनो हथ पत्रोवं केर।” ते यहोवारो दूत यबूसी ओर्नानेरे खलाड़ी मां खड़ो थियो। <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" />ते दाऊदे हेरू कि यहोवारो दूत अम्बर ते धेरतरे मझ़ाटे खड़ोए ते अक नग्गी तलवार तैसेरे हथ्थे मांए, ते यरूशलेम नगरेरे पासे रख्खोरीए, तैखन दाऊद ते इस्राएली बुज़ुर्ग टाट<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="fq" closed="false">टाट </char><char style="ft" closed="false">टाट छ़ेल्‍ली केरे ज़ड़न सेइं बनाते थिये, तैस लानेरो ई मतलब थियो कि मातम या दुख बांदो केरनेरो निशान थियो।</char></note> पलेटतां तुत्तरेरे भारे तल्‍ले मां झुके। <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />तैखन दाऊदे परमेशरे कां प्राथना की, “ज़ैनी लोकां केरि गिनती केरनेरो हुक्म दित्तोरो थियो, तै कुन अवं नईं? हाँ, ज़ैनी पाप कियो ते बड़ी बुराई कियोरीए, तै त अवं आईं। पन एन बेकसूर लोकेईं कुन कियोरूए ज़ैना गब्बां केरे ज़ेरे आन? एल्हेरेलेइ हे मेरे परमेशर यहोवा! तेरो हथ मेरे बाजी केरे घरानेरे खलाफ भोए, पन तेरे लोकां केरे खलाफ न भोए, कि तैना मारे गान।”<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />तैखन यहोवारे दूते गाद नेबी दाऊदे सेइं एन ज़ोनेरो हुक्म दित्तो कि दाऊद यबूसी ओर्नानेरे खलाड़ी मां यहोवारे लेई अक वेदी बनाए। <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />गादेरे इस वचनेरे मुताबिक ज़ै तैनी यहोवारे नंव्वे सेइं ज़ोवरो थियो, दाऊद उबरे जेव। <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />तैखन ओर्नाने पत्रोवं मुड़तां तक्‍कू ते दूत लाव ते तैसेरां च़ेवरे मट्ठां ज़ैना तैस सेइं साथी थियां छ़ेप्पी जेआं, ओर्नान त गेहुं मडनेरे लगोरो थियो। <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />ज़ैखन दाऊद ओर्नाने कां पुज़्ज़ो, तैखन ओर्नाने दाऊद लाव ते खलाड़ी करां बेइर गेइतां ज़मीनी पुड़ दाऊदे कां झुको। <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />तैखन दाऊदे ओर्नाने सेइं ज़ोवं, “ई खलाड़ मीं मुल्‍ले दे, कि अवं इड़ी यहोवारे लेई अक वेदी बनेइं, तैसेरी पूरी कीमत नेइतां मीं दे, कि ई आफत लोकन पुड़ेरां दूर की गाए।” <verse eid="1CH 21:22" /><verse number="23" style="v" sid="1CH 21:23" />ओर्नाने दाऊदे सेइं ज़ोवं, “एस ने, ते मेरे मालिक राज़े ज़ैन किछ ठीक लगते तैन्ने केरे। शुन, अवं तीं होमबलि देनेरे लेई दांत ते कैड़ु ते मडनेरे लेई संदरां ते अन्नबलि देनेरे लेई गेहुं, इन सारू अवं तीं देताईं।” <verse eid="1CH 21:23" /><verse number="24" style="v" sid="1CH 21:24" />पन दाऊद राज़े ओर्नाने सेइं ज़ोवं, “नईं, अवं ज़रूर इसेरी पूरी कीमत देइतां नेइलो। ज़ैन तेरूए, तैस अवं यहोवारे लेई न नेइलो, ते मुफते मां होमबलि न च़ैढ़ेलो।” <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />तैखन दाऊदे तैस जगारे लेई ओर्नाने लगभग सत किल्‍लो सोन्नू तुलतां दित्तू। <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />तैखन दाऊदे तैड़ी यहोवारे लेई अक वेदी बनाई ते होमबलि ते मेलबलि च़ैढ़तां यहोवा कां प्राथना की, ते होमबलि देनेरे वेदी पुड़ सुर्गेरां अग उतैरतां तैसेरी प्राथना शुनी। <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />तैखन यहोवा दूते हुक्म दित्तो। ते तैनी अपनि तलवार फिरी म्याने मां रख्खी।<verse eid="1CH 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 21:28" />एन हेरतां कि यहोवा यबूसी ओर्नानेरे खलाड़ी मां मेरी प्राथना शुनोरीए, दाऊदे तैस्से वक्ते तैड़ी बलिदान कियूं। <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />यहोवारो तेम्बु ज़ै मूसा सुनसान ठैरी मां बनेवरो थियो, ते होमबलि देनेरी वेदी, इनां दूईये तैस मौके गिबोन नगरेरे उच्‍ची जगाई पुड़ थी। <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />पन दाऊद परमेशरे कां तैसेरे सामने न गेइ बटो, किजोकि तै यहोवारे दूतेरी तलवारी करां डेरि जेवरो थियो।<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />तैखन दाऊद ज़ोने लगो, “यहोवा परमेशरेरो भवन ईए आहे, ते इस्राएलेरे लेई होमबलि देनेरी वेदी ई आहे।”<verse eid="1CH 22:1" /></para>
  <para style="s">भवन बनानेरी तियारी</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />तैखन दाऊद राज़े इस्राएलेरे मुल्खे मां ज़ैना परदेशी थिये तैना यरूशलेम नगरे मां अकोट्ठे केरनेरो हुक्म दित्तो, ते परमेशरेरो भवन बनानेरे लेई किछ घोड़ तराशने बाले च़ुने। <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />फिरी दाऊदे फाटकां केरे दारां केरे किल्‍लां ते कब्ज़ां केरे लेई बड़ू लोंह, ते तोले करां जादे पितल, <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />ते गिनती करां बेइर गैइड़ेरे बुट्टेरी लकड़ी अकोट्ठी की; किजोकि सीदोन ते सोर नगरेरे लोकेईं दाऊदे कां बड़े गैइड़ेरे बुट्टां केरि लकड़ी आनोरी थी। <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />ते दाऊदे सोचू, “मेरू मट्ठू सुलैमान निकड़ू ते तैस कोई अनुभव नईं, ते ज़ै भवन यहोवारे लेई बनानो आहे, तै बड़ो शानदार ते सारे मुल्खन मां मुशूर ते शोभने बालो लोड़े। एल्हेरेलेइ अवं तैसेरे लेई तियारी केरेलो।” ते दाऊदे मरने करां पेइले भवन बनानेरे लेई बड़ू सामान अकोट्ठू कियूं।<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />फिरी एक्सां तैनी अपनु मट्ठू सुलैमान कुजेइतां इस्राएलेरे परमेशर यहोवारे लेई भवन बनानेरो हुक्म दित्तो। <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />दाऊदे अपने मट्ठे सुलैमाने सेइं ज़ोवं, “मेरो इरादो त थियो कि अपने परमेशर यहोवारो अक भवन बनेइं। <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />पन यहोवा मीं सेइं ज़ोवं, ‘तीं बड़ो खून बगेवरोए ते बेड़ी-बेड़ी जंगां लेड़ोरीन, एल्हेरेलेइ तू मेरो भवन न बनेई सकेलो, किजोकि तीं ज़मीनी पुड़ मेरी नज़री मां बड़ो खून बगेवरोए। <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />हेर, तेरू अक मट्ठू भोल्हु, ज़ै शान्त मड़द भोल्हो। ते अवं तैस च़ेवरे पासां केरे दुश्मन्न करां आराम देइलो। तैसेरू नवं त सुलैमान भोल्हु, ते तैसेरे राज़ केरनेरे दिहाड़न मां अवं इस्राएले शान्ति ते आराम देइलो। <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />तैए मेरो भवन बनालो। ते तैन्ने मेरू मट्ठू भोल्हु ते अवं तैसेरो बाजी भोल्हो, ते तैसेरो तखत अवं इस्राएले मां हमेशारे लेई कायम केरेलो।’ <verse eid="1CH 22:10" /><verse number="11" style="v" sid="1CH 22:11" />दाऊदे इन भी ज़ोवं, हुनी हे मेरा मट्ठा, यहोवा तीं सेइं साथी राए, ते तू तैस वचनेरे मुताबिक ज़ैन तेरे परमेशर यहोवा तेरे बारे मां ज़ोवरूए, तैसेरो भवन बनाने मां कामयाब भोस। <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />हुनी यहोवा तीं अक्ल ते समझ़ दे ते इस्राएलेरो अधिकारी भोस, ते तू अपने परमेशर यहोवारो कानून मन्तो रास। <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />ज़ैखन तू तैन विधन ते नियमन पुड़ च़लनेरी एहतियात केरेलो तैखन तू कामयाब भोल्हो, ज़ैन केरो हुक्म यहोवा इस्राएली लोकां केरे लेई मूसा दित्तोरो थियो। हिम्मत रख ते मज़बूत भो। डर न, ते तेरो मन उदास न भोए। <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />शुन, मीं अपनि मेहनतरे वक्त यहोवारे भवनेरे लेई 35 लख किल्‍लो सोन्नू, ते ट्लाई करोड़ किल्‍लो चाँदी, ते पितल ते लोंह एत्रू अकोट्ठू कियूं, कि जादे भोनेरे वजाई सेइं तोले करां बेइरे; ते लकड़ी ते घोड़ मीं अकोट्ठे कियोरेन, ते तू होरे भी अकोट्ठे केरां। <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />ते तीं कां बड़े कारीगिरन, मतलब घोड़ ते लकड़ी कटनेबाले ते तराशने बाले ते हर किसमेरे कम्मेरे लेई माहिर कारीगिर। <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />सोन्नू, चाँदी, पितल ते लोंहेरी कोई गिनती नईं, त तू तैस कम्मे मां लेग्गी गा! यहोवा तीं सेइं साथी हर वक्त राए।”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />फिरी दाऊदे इस्राएलेरे सारे प्रधान्न अपने मट्ठे सुलैमानेरी मद्दत केरनेरे लेई हुक्म एन ज़ोइतां दित्तो, <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />“कुन तुश्शो परमेशर यहोवा तुसन सेइं साथी नईं? कुन तैनी तुसन च़ेवरे पासना अराम नईं दित्तोरो? तैनी त मुल्खेरे रानेबाले मेरे कब्ज़े मां कियोरेन। ते मुल्ख यहोवा ते तैसेरे लोकां केरे सामने दब्बो जेवरोए। <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />हुनी तने मने सेइं अपने परमेशर यहोवा कां गांते राथ, ते मन लेइतां यहोवा परमेशरेरो पवित्र भवन बनानो, कि तुस यहोवारे करारेरो सन्दूख ते परमेशरेरां पवित्र भांडां तैस भवने मां आनां ज़ै भवन यहोवारे लेई बन्ने बालोए।”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s">लेवी लोकन ज़िमेवारी बेंटतां दित्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />दाऊद राज़ो त बड़ो बुढो भोइ जेवरो थियो, एल्हेरेलेइ तैनी अपनु मट्ठू सुलैमान इस्राएल मुल्खेरो राज़ो बनाव। <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" />बादे मां दाऊद राज़े इस्राएलेरे सारे प्रधान ते याजक ते लेवी अकोट्ठे किये। <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />ते ज़ेत्रे लेवी 30 साल ते तैस करां जादे उमरारे थिये, तैन केरि गिनती की, ते तैना 38000 थी।<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="NUM 4:3">गिन. 4:3</ref>,<ref loc="NUM 4:23">23</ref>,<ref loc="NUM 4:30">30</ref>.</char></note> <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />तैन मरां 24000 त यहोवारे भवने मां कम च़लानेरे लेई च़ुन्ने जे, ते 6000 अधिकारी ते न्यायी च़ुने। <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />ते 4000 भवनेरे पहरदार च़ुने, ते 4000 तैना बाज़े बज़ेइतां यहोवारी आराधना केरनेरे लेई च़ुने, ज़ैना दाऊदे आराधना केरनेरे लेई बनेवरे थिये।<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 18:3-4">निर्ग. 18:3-4</ref>.</char></note> <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" />फिरी दाऊदे तैना गेर्शोन, कहात ते मरारी नंव्वेरे लेवी एरे मट्ठां केरे मुताबिक टोलन मां अलग-अलग किये।<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />गेर्शोनी लोकन मरां त लादान ते शिमी थिये। <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />ते लादानेरां मट्ठां: बड्डो यहीएल, फिरी जेताम ते योएल, इना ट्लाई थियां। <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />शिमीएरां मट्ठां: शलोमीत, हजीएल ते हारान, इनां ट्लाई थियां। लादानेरे कुलां केरे पूर्वजां केरे घरानेरे प्रधान इनां थिये। <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />फिरी शिमीएरां मट्ठां: यहत, जीना, यूश, ते बरीआ, शिमीएरां इन्ना च़ेवर मट्ठां थियां। <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />यहत बड्डो थियो, ते दूइयोवं जीजा। यूश ते बरीआरां हछां मट्ठां न भोआं, एस वजाई सेइं तैना सारे मिलेइतां पूर्वजां केरो अक घरानेरो भोव।<verse eid="1CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />कहातेरां च़ेवर मट्ठां, अम्राम, यिसहार, हेब्रोन ते उज्जीएल थियां। अम्रामेरां मट्ठां हारून ते मूसा थिये। <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />हारून त एल्हेरेलेइ अलग कियोरो थियो, कि तै ते तैसेरी औलाद हमेशा परमपवित्र चीज़ां च़ाढ़न, ते हमेशा यहोवारे सामने गुग्गल बालनेरे लेई ते तैसेरी सेवा केरन, ते तैसेरे नंव्वें सेइं बरकत देते रान। <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />पन परमेशरेरे भक्त मूसेरां मट्ठां केरां नंव्वां लेवी केरे गोट्ले मां गना जेआं। <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />मूसेरां मट्ठां, गेर्शोम ते एलीएजेर। <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" />ते गेर्शोमेरू मट्ठू शबूएल प्रधान थियूं। <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />एलीएजेरेरां मट्ठां: रहब्याह प्रधान थियो। ते एलीएजेरू होरू कोई मट्ठू न भोवं, पन रहब्याहेरां बड़ां मट्ठां भोआं। <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />यिसहारे मट्ठन मरां शलोमीत प्रधान थियो। <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />हेब्रोनेरां मट्ठां: यरिय्याह प्रधान, दूइयोवं अमर्याह, ट्लेइयोवं यहजीएल ते च़ेवरोवं यकमाम। <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />उज्जीएलेरां मट्ठन मरां प्रधान त मीका ते दूइयोवं यिश्शिय्याह थियो।<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />मरारी एरां मट्ठां, महली ते मूशी थियां। महली एरां मट्ठां एलीआजर ते कीश थियां। <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />एलीआजर मेरि जेव, तैस कोई मट्ठू न भोवं सिर्फ कुइयां भोइ। ते कीशेरे मट्ठेईं ज़ैना तैन केरे रिश्तेदार थिये तैनेईं तैन कुइयन सेइं ड्लाह बनाव। <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />मूशीएरां मट्ठां: महली, एदेर, ते यरेमोत, इनां ट्लाई थियां।<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />लेवी पूर्वजां केरे घराना केरे प्रधान मड़द एना थिये, इनां नंव्वां घिन्तां, हर एक्‍की मड़देरी गिनती की, ज़ैना 20 साल ते तैस करां जादे उमरारे थिये, ते यहोवारे भवने मां सेवा केरते थिये। <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />किजोकि दाऊदे ज़ोवं, “इस्राएलेरे परमेशर यहोवा अपने लोकन आराम दित्तोरोए, कि तैना यरूशलेम नगरे मां हमेशा रेई बटन। <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />ते लेवी लोकन तेम्बु ते तैसेरे सेवारू सामान फिरी छ़ूनू न पेलू।”<note caller="-" style="x"><char style="xo" closed="false">23:26 </char><char style="xt" closed="false"><ref loc="NUM 1:50-53">गिन. 1:50-53</ref>;<ref loc="NUM 3:21-37">3:21-37</ref>;<ref loc="NUM 4:15">4:15</ref>;<ref loc="DEU 10:8">व्यव. 10:8</ref>.</char></note> <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />किजोकि दाऊदेरे पेइले हुक्मेरे मुताबिक 20 साल या तैस करां जादे उमरारे लेवी केरि गिनती कियोरी थी। <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />किजोकि तैन केरू कम त हारूनेरे खानदानेरी मद्दत केरनी थी, मतलब इन कि तैना अंगने मां ते कमरन मां, ते सारे पवित्र चीज़ां शुद्ध केरने ते परमेशरेरे भवनेरी सेवारे सारां कम्मां ते सेवा केरन। <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />ते च़ाढ़नेरे रोट्टी केरि, अन्नबेलरे मैदेरो, ते बगैर खमीरेरी पैपड़ी केरि, ते तव्वे पुड़ पकानेरू ते सन्नोरू, ते नापनेरू ते तुलनेरू ते हर किसमेरू कम केरन। <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />ते रोज़ झ़ेझ़ां ते ड्लवझ़ां यहोवारे सामने शुक्र ते तारीफ़ केरनेरे लेई खड़े रान। <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />ते आरामेरे दिहाड़े ते नंव्वें चाँदेरे दिहाड़े, ते तिहारां केरि गिनतरे मुताबिक रोज़ यहोवारे लेई सब होमबलि च़ाढ़ते रान। <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />ते यहोवारे भवनेरी सेवारे बारे मां मिलापे बाले तेम्बु ते पवित्र ठारारी हिफाज़त केरन, ते अपने ढ्लाए हारूनेरे खानदानेरे लोकन दित्तोरे कम्मे ध्याने सेइं केरन।<note caller="-" style="x"><char style="xo" closed="false">23:32 </char><char style="xt" closed="false"><ref loc="NUM 18:3-5">गिन. 18:3-5</ref>.</char></note><verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">याजकां केरि ज़िमेवारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />हारूनेरे खानदाने मरां टोली इनां थी। हारूनेरां मट्ठां त नादाब, अबीहू, एलीआजर ते ईतामार थिये। <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />पन नादाब ते अबीहू अपने बाजी हारूने करां पेइले मरे तैन मट्ठां न थियां, एल्हेरेलेइ याजकेरू कम एलीआजर ते ईतामार केरते थिये।<note caller="-" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="LEV 10:1-2">लैव्य. 10:1-2</ref>;<ref loc="NUM 3:4">गिन. 3:4</ref>.</char></note> <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />ते दाऊद राज़े एलीआजरेरे खानदाने मरां सादोक ते ईतामारेरे खानदाने मरां अहीमेलेकेरी मद्दती सेइं तैन अपनि-अपनि सेवारे मुताबिक टोली-टोली केरतां बन्टे।<note caller="-" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="LUK 1:5">लूक. 1:5</ref>.</char></note> <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />एलीआजरेरे खानदाने मां प्रधान मड़द, ईतामारेरे खानदानेरे प्रधान मड़दन करां जादे थिये। ते तैना एन्च़रे बन्टे जे: मतलब एलीआजरेरे खानदानेरे पूर्वजां केरे घरानेरे 16, ते ईतामारेरे पूर्वजां केरे घरानेरे अठ खास प्रधान थिये। <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />तैखन तैना चिट्ठी छ़ेडतां बराबर-बराबर बन्टे जे, किजोकि एलीआजर ते ईतामार दूईयां केरे खानदाने मां पवित्र ठारारे हाकिम ते परमेशरे हाकिम च़ुने जेवरे थिये। <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />ते नतनेलेरू मट्ठू शमायाह ज़ैन शास्त्री ते लेवी थियूं, तैन केरे नंव्वे राज़े ते हाकिमन ते सादोक याजक, ते एब्यातारे मट्ठे अहीमेलेक ते याजकां ते लेवी केरे पूर्वजां केरे घरानेरे प्रधानां केरे सामने लिखां। मतलब पूर्वजां केरो अक घरानो त एलीआजरेरे खानदाने मरां ते अक ईतामारेरे खानदाने मरां नेव जेव।<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />पेइली चिट्ठी त यहोयारीबेरे नंव्वेरे, ते दूइयोवं यदायाह, <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />ट्लेइयोवं हारीमेरे, च़ेवरोवं सोरीमेरे, <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />पंच़ोंव मल्किय्याहेरे, शेइयोवं मिय्यामीनेरे, <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" />सत्तोवं हक्‍कोसेरे, अठोवं अबिय्याहेरे, <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />नोवोवं येशुअरे, दशोवं शकन्याहेरे, <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />यारोवं एल्याशीबेरे, बारोवं याकीमेरे, <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />तेरहोवं हुप्पारे, च़ेवधोवं येसेबाबेरे, <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />परहनोवं बिल्गारे, शोड़ोवं इम्मेरेरे, <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />सत्तहरोवं हेजीरेरे, अठारोवं हप्पित्सेसेरे, <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />उनियों पतह्याहरे, बिहोवं यहेजकेलेरे, <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />इकियोवं याकीनेरे, बैहियोवं गामूलेरे, <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />ट्लेबीयोवं दलायाहेरे, ते च़ौबियोवं माज्याहरे नंव्वे पुड़ निस्सी। <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" />तैन केरि सेवारे लेई तैन केरो ऐह नियम रख्खो जेव कि तैना अपने तैस कानूनेरे मुताबिक ज़ै इस्राएलेरे परमेशर यहोवारे हुक्मेरे मुताबिक तैन केरे पूर्वज हारूने च़लेवरो थियो, यहोवारे भवने मां गाते रान।<verse eid="1CH 24:19" /></para>
  <para style="s">बाकी लेवी</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />बच़ोरे लेवी लोकन मरां अम्रामेरे खानदाने मरां शूबाएल, ते शूबाएलेरे खानदाने मरां येहदयाह। <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />बच़ोरे रहब्याह, रहब्याहेरे खानदाने मरां यिश्शिय्याह खास थियो। <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />यिसहारी लोकन मरां शलोमोत ते शलोमोतेरे खानदाने मरां यहत। <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />हेब्रोनेरे खानदाने मरां त प्रधान यरिय्याह, दूइयोवं अमर्याह, ट्लेइयोवं यहजीएल ते च़ेवरोवं यकमाम। <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />उज्जीएलेरे खानदाने मरां मीका ते मीकारे खानदाने मरां शामीर थियो। <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />मीकारो ढ्ला यिश्शिय्याह, यिश्शिय्याहेरे खानदाने मरां जकर्याह थियो। <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />मरारी एरां मट्ठां महली ते मूशी, ते याजिय्याहेरू मट्ठू बिनो थियूं। <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />मरारी एरे मट्ठे याजिय्याहेरू बिनो ते शोहम, जक्‍कूर ते इब्रि थिये। <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />महलीएरू मट्ठू एलीआजर थियूं, ज़ैस कोई मट्ठू न थियूं। <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />कीशेरे खानदाने मां यरहमेल थियो। <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />ते मूशीएरां मट्ठां, महली, एदेर ते यरीमोत थियां। अपने-अपने पूर्वजां केरे घरानेरे मुताबिक इनां लेवी खानदाने मरां थिये। <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />तैनेईं भी अपने ढ्ला हारूनेरे खानदानेरी ज़ेरि दाऊद राज़े ते सादोक ते अहीमेलेक ते याजक ते लेवी केरे पूर्वजां केरे घरानेरे प्रधानां केरे सामने चिट्ठी छ़ेडी, मतलब प्रधानां केरे घरानेरे तैसेरे निकड़े ढ्लाएरे पूर्वजेरे घरानेरे बराबर भोव।<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">दाऊदेरे संगीतकार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />फिरी दाऊद राज़े ते सेनापति लोकेईं आसाप, हेमान ते यदूतूनेरां किछ मट्ठां सेवकाई केरनेरे लेई अलग कियां कि तैना सितार, सैन्गी ते झ़ेल्‍ली बज़ेई-बज़ेइतां नबूवत केरन। ते एस सेवकाई केरनेरू कम केरनेबाले मैन्हु केरि गिनती ईए थी: <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />आसापेरे मट्ठन मरां जक्‍कूर, यूसुफ, नतन्याह ते अशरेला, आसापेरां इनां च़ेवर मट्ठां आसापेरे हुक्मे पुड़ च़लतां थियां, ज़ै दाऊद राज़ेरे हुक्मेरे मुताबिक नबूवत केरतो थियो। <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />फिरी यदूतूनेरे मट्ठन मरां गदल्याह, सरी, यशायाह, शिमी, हशब्याह, मत्तित्याह, एना शा अपने बाजी यदूतूनेरे हुक्मेरे मुताबिक ज़ै यहोवारू शुक्र ते तारीफ़ केरि-केरि नबूवत केरतो थियो, सितार बज़ाते थिये। <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />हेमानेरे मट्ठन मरां, बुक्‍किय्याह, मत्तन्याह, उज्जीएल, शबूएल, यरीमोत, हनन्याह, हनानी, एलीआता, गिद्दलती, रोममतीएजेर, योशबकाशा, मल्‍लोती, होतीर ते महजीओत। <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />परमेशरेरे वाधेरे मुताबिक ज़ै तैसेरू नवं उच्‍चु केरनेरे लेई थियो, इना सब हेमानेरां मट्ठां थियां ज़ै राज़ेरो दर्शी थियो। किजोकि परमेशरे हेमाने च़ेवधे मट्ठां ते ट्लाई कुइयां दित्तोरी थी। <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />इन सब तैसेरां मट्ठां यहोवारे घरे मां गीतां ज़ोनेरे लेई ते अपने-अपने बाजी केरे अधीन रेइतां, परमेशरेरे भवनेरी सेवकाई मां झ़ेल्‍ली, सैन्गी ते सितार बज़ाते थिये। आसाप, यदूतून ते हेमान राज़ेरे अधीन रहते थिये। <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />इन सेभी केरि गिनती तैन केरे भियालन सने ज़ैना यहोवारां गीतां शिखोरां थियां ते हर किसमे सेइं पूरे ज़ानकार थिये, 228 थिये। <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />तैनेईं कुन बड्डो, कुन निकड़ो, कुन गुरू, कुन चेलो, अपनि-अपनि बारी लानेरे लेई चिट्ठी छ़डी।<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 25:9" />पेइली चिट्ठी आसापेरे मट्ठन मरां यूसुफेरे नंव्वे पुड़ निस्सी ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। दूइयोवं गदल्याहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />ट्लेइयोवं जक्‍कूरेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैन समेत 12 थिये। <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />च़ेवरोवं यिस्री एरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />पंच़ोंव नतन्याहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />शेइयोवं बुक्‍किय्याहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />सत्तोवं यसरेलारे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />अठोवं यशायाहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />नंवोवं मत्तन्याहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />दशोवं शिमी एरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />यारोवं अजरेलेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />बारोवं हशब्याहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />तेरहोवं शूबाएलेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />च़ेवधोवं मत्तित्याहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />परहनोवं यरेमोतेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />शोड़ोवं हनन्याहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />सत्तहरोवं योशबकाशारे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />अठारोवं हनानी एरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />उनियों मल्‍लोती एरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />बिहोवं एलियातहेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />इकियोवं होतीरेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />बाइयोवं गिद्दलती एरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />ट्लेबीयोवं महजीओतेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये। <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />च़ौबियोवं चिट्ठी रोममतीएजेरे नंव्वे पुड़ निस्सी, ज़ैसेरां मट्ठां ते भियाल तैस समेत 12 थिये।<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">भवनेरे पहरदार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />भवनेरे पहरेदारां केरि टोली इना थी: कोरह खानदाने मरां मशेलेम्याह ज़ैन कोरेरू मट्ठू ते आसापेरे खानदाने मरां थियूं। <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />ते मशेलेम्याहेरां मट्ठां इनां भोआं, तैसेरू बड्डू मट्ठू जकर्याह, दूइयोवं यदीएल, ट्लेइयोवं जबद्याह, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />च़ेवरोवं यातनीएल, पंच़ोंव एलाम, शेइयोवं यहोहानान ते सत्तोवं एल्यहोएनै। <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" />फिरी ओबेदेदोमेरां भी मट्ठां थियां: तैसेरू बड्डू मट्ठू शमायाह, दूइयोवं यहोजाबाद, ट्लेइयोवं योआह, च़ेवरोवं साकार, पंच़ोंव नतनेल, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />शेइयोवं अम्मीएल, सत्तोवं इस्साकार ते अठोवं पुल्‍लतै, किजोकि परमेशरे तैस बरकत दित्तोरी थी। <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />ते ओबेद एदोमेरे बड्डे मट्ठे शमायाहे भी मट्ठां भोआं, ज़ैना शूरबीर ते बहादर भोनेरी वजाई सेइं अपने बाजी केरे घराने पुड़ प्रधान थिये। <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />शमायाहेरां मट्ठां इन्ना थियां, ओतनी, रपाएल, ओबेद, एलजाबाद ते तैन केरे ढ्ला एलीहू ते समक्याह ताकतबर थिये। <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />इना सब ओबेदेदोमेरे खानदाने मरां थिये, तैना ते तैन केरां मट्ठां ते भियाल इस सेवकाई केरनेरे लेई ताकतबर ते शक्तिमान थिये। इनां ओबेदेदोमी 62 थिये। <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />मशेलेम्याहेरां मट्ठां ते भियाल 18 थिये, ज़ैना ताकतबर थिये। <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" />फिरी मरारी एरे खानदाने मरां होसारां भी मट्ठां थियां, प्रधान त शिम्री थियो (तै बड्डो न भोनेरे वजाई सेइं भी तैसेरे बाजे प्रधान ठहरावरो थियो), <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />दूइयोवं हिल्किय्याह, ट्लेइयोवं तबल्याह ते च़ेवरोवं जकर्याह थियो। होसारां सारां मट्ठां ते भियाल मिलेइतां 13 ज़ने थिये।<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />भवनेरे पहरेदारां केरि टोली इनां प्रधानां केरि थी, इनां अपने बाकी भियालां केरे बराबर यहोवारे भवने मां सेवा केरते थिये। <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />तैनेईं कुन निकड़े, ते कुन बड्डे, अपने-अपने पूर्वजां केरे घरानेरे मुताबिक हर एक्‍की फाटकेरे लेई चिट्ठी छ़डी। <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />पूर्वेरे पासेरी चिट्ठी शेलेम्याहेरे नंव्वे पुड़ निस्सी। फिरी तैनेईं तैसेरे मट्ठे जकर्याहेरे नंव्वे पुड़ चिट्ठी छ़डी (तै समझ़दार सलाहकार थियो) ते चिट्ठी उत्तरेरे पासे निस्सी। <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />दक्षिणेरे पासेरे लेई ओबेदेदोमेरे नंव्वे पुड़ चिट्ठी निस्सी, ते तैसेरे मट्ठां केरे नंव्वे पुड़ भवनेरे खज़ानेरे कमरेरे लेई निस्सी। <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />फिरी शुप्पीम ते होसारे नंव्वेरी चिट्ठी पश्चिमेरे पासेरी निस्सी, कि तैना शल्‍लेकेत नंव्वेरे फाटके कां चढ़ेइयरे सड़की पुड़ आमने-सामने पहरदारी केरते रान। <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />पूर्वेरे पासे त शा लेवी थिये, ते उत्तरेरे पासे रोज़ च़ेवर, दक्षिणेरे पासे रोज़ च़ेवर, ते खज़ानेरे कमरे कां दूई पहरदार रख्खे। <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />पश्चिमेरे पासे पर्बार नंव्वेरी जगाई पुड़ उच्‍ची सड़की कां त च़ेवर ते पर्बारे कां दूई पहरदार रख्खे। <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />इनां भवनेरे पहरेदारां केरि टोली थी, ज़ैन मरां किछ त कोरह ते किछ मरारी एरे खानदाने मरां थिये।<verse eid="1CH 26:19" /></para>
  <para style="s">भवनेरे भण्डारी ते अलग-अलग सेवा</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />फिरी लेवी लोकन मरां अहिय्याह परमेशरेरे भवन ते च़ाढ़ोरी चीज़ां, दूईयां केरे भण्डारां केरो अधिकारी च़ुनो। <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />लादान गेर्शोनेरे खानदाने मरां थियो, ते पूर्वजां केरे घराना केरो पूर्वज थियो। लादानेरू मट्ठू यहोएली भी प्रधान थियो।<verse eid="1CH 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 26:22" />यहोएली एरां मट्ठां इनां थियां, जेताम ते तैसेरो ढ्ला योएल, ज़ैना यहोवारे भवने मां खज़ानां केरे अधिकारी थिये। <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" />बाकी इनां थियां, अम्रामी, यिसहारी, हेब्रोनी ते उज्जीएली लोकन मरां, <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />शबूएल ज़ै मूसेरे मट्ठे गेर्शोमेरे खानदाने मरां थियो, तै खज़ानां केरो प्रधान अधिकारी थियो। <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />ते तैसेरे भियाल इनां थिये: एलीएजेरे कुले मरां तैसेरू मट्ठू रहब्याह, ते रहब्याहेरू मट्ठू यशायाह, ते यशायाहेरू मट्ठू योराम, ते योरामेरू मट्ठू जिक्री, ते जिक्री एरू मट्ठू शलोमोत थियूं। <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />ईए शलोमोत अपने भियालन समेत तैन सब च़ैढ़ोरी चीज़ां ते भण्डारां केरो अधिकारी थियो, ज़ैना चीज़ां दाऊद राज़े ते पूर्वजां केरे घरानेरे खास-खास मैन्हु ते हज़ारां ते शौवां केरे सेनापतिएईं शुद्ध कियोरी थी। <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />ज़ै लूटरो माल जंगन मां मैल्होरो थियो, तैस मरां तैनेईं यहोवारे भवनेरी मरम्मत केरनेरे लेई किछ चीज़ां च़ैढ़ी। <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />ज़ेत्री चीज़ां शमूएल नेबे, कीशेरे मट्ठे शाऊल राज़े, नेरेरे मट्ठे अब्नेर, ते सरूयाहेरे मट्ठे योआबे च़ैढ़ोरी थी, ते ज़ैन किछ केन्चे भवन बनानेरे लेई अर्पण कियोरू थियूं, तैन सब शलोमोत ते तैसेरे भियालां केरे अधिकारे मां थियूं। <verse eid="1CH 26:28" /><verse number="29" style="v" sid="1CH 26:29" />यिसहारी लोकन मरां कनन्याह ते तैसेरां मट्ठां, इस्राएल मुल्खेरे अधिकारी ते न्यायी एरू कम केरनेरे लेई च़ुनोरे। <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" />ते हेब्रोनी लोकन मरां हशब्याह ते तैसेरे भियाल ज़ैना 1700 शूरबीर ताकतबर थिये, तैना यहोवारे सारे कम्मे ते राज़ेरी सेवारे बारे मां यरदन दरियारे पश्चिमेरे रानेबाले इस्राएली लोकां केरे अधिकारी भोए। <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />हेब्रोनी लोकन मरां यरिय्याह प्रधान थियो, मतलब हेब्रोनी लोकां केरि पीढ़ी-पीढ़ी पूर्वजां केरे घरानेरे मुताबिक दाऊद राज़ेरे राज़ केरनेरे च़ैलीयोवं साले मां तैना तोप्पे जे, ते तैन मरां किछ शूरबीर गिलाद प्रदेशेरे याजेर नगरे मां रहते थिये। <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />यरिय्याहेरे भियाल ज़ैना शूरबीर बहादर थिये, पूर्वजां केरे घरानेरे प्रधान 2700 थिये, तैना दाऊद राज़े परमेशरेरे सेभी विषयन मां ते राज़ेरे बारे मां रूबेनी, गादी ते मनश्शेरे अधे गोट्लेरे अधिकारी बनाए।<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">मुल्खेरो इंतज़ाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />इस्राएली लोकां केरि गिनती, पूर्वजां केरे घरानेरे प्रधान ते हज़ार ते शौव सिपाही केरे सेनापति ते तैन केरे प्रधानां केरि गिनती ज़ैना पूरे साल ते महीने-महीने हज़ार भोनेरे ते छुट्टी मैल्हने बाले टोली केरे थिये ते हर किसमेरी राज़ेरी सेवा केरते थिये, हर एक्‍की टोली मां 24000 सिपाही थिये।<verse eid="1CH 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2" />पेइले महीनेरे लेई पेइले टोलरो अधिकारी जब्दीएलेरू मट्ठू याशोबाम च़ुनू। ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />तै पेरेसेरे खानदाने मरां थियो ते पेइले महीने मां सारे सेनापति लोकां केरो अधिकारी थियो। <verse eid="1CH 27:3" /><verse number="4" style="v" sid="1CH 27:4" />दूइयोवं महीनेरे टोलरो अधिकारी दोदै नंव्वेरो अक अहोही थियो, ते तैसेरे टोलरो प्रधान मिक्लोत थियो, ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:4" /><verse number="5" style="v" sid="1CH 27:5" />ट्लेइयोवं महीनेरे ट्लेइयोवं सेनापति यहोयादा याजकेरू मट्ठू बनायाह थियो ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />ई तैए बनायाहे, ज़ै ट्लीहे शूरबीरन मां बहादर थियो, ते ट्लीहे बहादरां केरो प्रधान थियो। ते तैसेरे टोली मां तैसेरू मट्ठू अम्मीजाबाद थियूं। <verse eid="1CH 27:6" /><verse number="7" style="v" sid="1CH 27:7" />च़ेवरोवं महीनेरे लेई च़ेवरोवं सेनापति योआबेरो ढ्ला असाहेल थियो, ते तैसेरां बाद तैसेरू मट्ठू जबद्याह थियूं ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:7" /><verse number="8" style="v" sid="1CH 27:8" />पंच़ोंव महीनेरे लेई पंच़ोंव सेनापति यिज्राही शम्हूत थियो ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:8" /><verse number="9" style="v" sid="1CH 27:9" />शेइयोवं महीनेरे लेई शेइयोवं सेनापति तकोई इक्‍केशेरू मट्ठू ईरा थियूं, ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:9" /><verse number="10" style="v" sid="1CH 27:10" />सत्तोवं महीनेरे लेई सत्तोवं सेनापति एप्रैमेरे खानदानेरो हेलेस पलोनी थियो ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:10" /><verse number="11" style="v" sid="1CH 27:11" />अठोवं महीनेरे लेई अठोवं सेनापति जेरहेरे खानदाने मरां हूशाई सिब्बकै थियो ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:11" /><verse number="12" style="v" sid="1CH 27:12" />नोवोवं महीनेरे लेई नोवोवं सेनापति बिन्यामीनी अबीएजेर अनातोत नगरेरो थियो ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:12" /><verse number="13" style="v" sid="1CH 27:13" />दशोवं महीनेरे लेई दशोवं सेनापति जेरही महरै, नतोपा नगरेरो ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:13" /><verse number="14" style="v" sid="1CH 27:14" />यारोवं महीनेरे लेई यारोवं सेनापति एप्रैमेरे खानदाने मरां बनायाह, पिरातोन नगरेरो थियो, ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:14" /><verse number="15" style="v" sid="1CH 27:15" />बारोवं महीनेरे लेई बारोवं सेनापति ओत्नीएलेरे खानदानेरो हेल्दै नतोपा नगरेरो थियो ते तैसेरे टोली मां 24000 सिपाही थिये। <verse eid="1CH 27:15" /><verse number="16" style="v" sid="1CH 27:16" />फिरी इस्राएली गोट्लां केरे इनां अधिकारी थिये: रूबेनी लोकां केरो प्रधान जिक्री एरू मट्ठू एलीएजेर। ते शिमोनी लोकन मरां माकारू मट्ठू शपत्याह थियूं। <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />लेवी लोकन मरां कमूएलेरू मट्ठू हशब्याह। हारूनेरे खानदाने मरां सादोक। <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />यहूदारो एलीहू नंव्वेरो दाऊदेरो अक ढ्ला, इस्साकारी लोकन मरां मीकाएलेरू मट्ठू ओम्री। <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />जबूलूनेरे खानदाने मरां ओबद्याहेरू मट्ठू यिशमायाह, ते नप्ताली खानदाने मरां अज्रीएलेरू मट्ठू यरीमोत। <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />एप्रैमे मरां अजज्याहेरू मट्ठू होशे, मनश्शेरे अधे गोट्लेरू, पदायाहेरू मट्ठू योएल। <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />गिलादे मरां अधे गोट्ले मनश्शेरे मरां जकर्याहेरू मट्ठू इद्दो, बिन्यामीने मरां अब्नेरेरू मट्ठू यासीएल। <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />ते दाने मरां यरोहामेरू मट्ठू अजरेल प्रधान थियूं। इन्ना इस्राएलेरे गोट्लां केरे प्रधान थिये। <verse eid="1CH 27:22" /><verse number="23" style="v" sid="1CH 27:23" />पन दाऊदे तैन केरि गिनती न की ज़ैना 20 सालन करां घट थिये, किजोकि यहोवा इस्राएलेरी गिनती अम्बरेरे तारां केरे बराबर बधानेरे लेई ज़ोवरू थियूं।<note caller="-" style="x"><char style="xo" closed="false">27:23 </char><char style="xt" closed="false"><ref loc="GEN 15:5">उत्प. 15:5</ref>;<ref loc="GEN 22:17">22:17</ref>;<ref loc="GEN 26:4">26:4</ref>.</char></note> <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />सरूयाहेरू मट्ठू योआब गिनती केरने जेव, पन खतम न केरि सको किजोकि परमेशरेरो क्रोध इस्राएले पुड़ भड़को, ते ई गिनती दाऊदेरे राज़ेरे इतिहासे मां नईं लिखी जेवरी। <verse eid="1CH 27:24" /><verse number="25" style="v" sid="1CH 27:25" />फिरी अदीएलेरू मट्ठू अज्मावेत राज़ेरे भण्डारां केरो अधिकारी थियो, ते देहात ते नगरां ते ड्लाव्वां ते क़िलन ते भण्डारां केरो अधिकारी उज्जियाहेरू मट्ठू यहोनातान थियो। <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />ते ज़ै ज़मीन आबाद केरतां ज़मीनदारी केरते थिये, तैन केरो अधिकारी कलूबेरू मट्ठू एज्री थियूं। <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />ते दाछ़री बागां केरो अधिकारी रामाह नगरेरो शिमी ते दाछ़री बागां केरि पैदावार ज़ै दाछ़रो रस भण्डारन मां रखनेरे लेई थियो, तैसेरो अधिकारी शापाम नगरेरो जब्दी थियो। <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" />ते बुनीयें मुल्खेरे ज़ैतून ते गूलरेरे बुट्टां केरो अधिकारी गदेर नगरेरो बाल्हानान थियो ते तेलेरे भण्डारां केरो अधिकारी योआश थियो। <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />ते शारोने मां च़ारने बालां केरो अधिकारी शारोनी शित्रै थियो ते वैदी केरो ते गोरू केरो अधिकारी अदलैरू मट्ठू शापात थियूं। <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />ते ऊँटां केरो अधिकारी इश्माएली ओबील<note caller="+" style="f"><char style="fr" closed="false">27:30 </char><char style="fq" closed="false">ओबील </char><char style="ft" closed="false">इब्रानी नवं “ओबील” मतलब ऊँट च़लानेबालो।</char></note> ते गेधी केरो अधिकारी मेरोनोत नगरेरो येहदयाह थियो। <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />ते गब्बां केरो अधिकारी हग्री याजीज थियो। इनां सारे दाऊद राज़ेरे धन दौलतरे अधिकारी थिये। <verse eid="1CH 27:31" /><verse number="32" style="v" sid="1CH 27:32" />ते दाऊद राज़ेरो चाचो योनातान अक समझ़दार सलाहकार ते शास्त्री थियूं, ते अक हक्मोनी एरू मट्ठू यहीएल राज़ेरे मट्ठन सेइं रेइयां केरतो थियूं। <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />ते अहीतोपेल राज़ेरो सलाहकार थियो, ते एरेकी हूशै राज़ेरो दोस्त थियो। <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />ते अहीतोपेलेरे मरनेरे बाद बनायाहेरू मट्ठू यहोयादा ते एब्यातार मंत्री रख्खे जे। ते राज़ेरो प्रधान सेनापति योआब थियो।<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">भवन बनानेरे लेई दाऊद सुलैमाने निर्देश देते</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />दाऊद राज़े इस्राएलेरे सब गोट्लां केरे हाकिम ते राज़ेरी सेवा केरनेबाले टोली केरे हाकिम ते हज़ारां ते शौवां केरे सेनापति ते राज़े तैसेरे मट्ठां केरे जानबर भी सारे धन दौलतरे अधिकारी, प्रधान ते सारे बहादर यरूशलेम नगरे मां कुजाए। <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" />तैखन दाऊद राज़ो खड़ो भोइतां ज़ोने लगो, “हे मेरे ढ्लाव! ते हे मेरे लोकव! मेरी शुना, मेरो इरादो त थियो कि यहोवारे करारेरे सन्दूखेरे लेई ते इश्शे लोकां केरे परमेशरे पव्वां केरि चेवकरे लेई आरामेरे लेई अक भवन बनेइं, ते मीं तैसेरे बनानेरी तियारी भी कियोरी थी। <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />पन परमेशरे मीं सेइं ज़ोवं, ‘तू मेरे लेई भवन न बनेई बटेलो, किजोकि तू जंग केरने बालोस ते तीं जंगी मां खून बगेवरोए।’ <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />फिरी भी इस्राएलेरे परमेशर यहोवा मेरे बाजी केरे सारे घराने मरां अवं च़ुनो, कि इस्राएलेरो राज़ो हमेशा बनोरो रेईं मतलब तैनी यहूदा त प्रधान भोनेरे लेई ते यहूदारे घराने मरां मेरे बाजी केरो घरानो च़ुनो ते मेरे ढ्लान मरां अवें सारे इस्राएलेरो राज़ो बनानेरे लेई खुशी भोव। <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />ते मेरे सब मट्ठन मरां (यहोवा त मीं बड़ां मट्ठां दित्तोरन) तैनी मेरे सैरी मट्ठन मरां सुलैमान इस्राएले पुड़ यहोवारे लोकन पुड़ राज़ केरनेरे लेई च़ुनोरोए। <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />ते यहोवा मीं सेइं ज़ोवं, ‘तेरू मट्ठू सुलैमान मेरे भवन ते अंगना बनालू, किजोकि मीं तैन च़ुनोरूए कि तैन मेरू मट्ठू भोल्हु, ते अवं तैसेरो बाजी भोल्हो। <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />ते अगर तै मेरे हुक्मन ते नियमन मन्ने मां अज़्ज़ेरो ज़ेरो मज़बूत राए, त अवं तैसेरू राज़ हमेशा मज़बूत रखेलो।’ <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />एल्हेरेलेइ हुनी इस्राएलेरे हेरते मतलब यहोवारे लोकां केरे हेरते, ते अपने परमेशरेरे सामने, अपने परमेशर यहोवारे सारे हुक्म मन्ने ते तैन पुड़ ध्यान केरतो राए। ताके तुस इस रोड़े मुल्खेरे मालिक बनोरे राथ, ते इस अपने बाद अपने खानदाने हमेशारो हिस्सो भोनेरे लेई छ़ेडी गाथ।”<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />दाऊदे सुलैमाने सेइं ज़ोवं, “हे मेरा मट्ठां सुलैमान! तू अपने बाजी केरे परमेशरे याद रख, ते साफ मने सेइं ते खुशी सेइं तैसेरी सेवा केरतो रा। किजोकि यहोवा मने परखते ते सोचने मां ज़ैन किछ पैदा भोते, तै तैन समझ़ते। अगर तू तैसेरी तलाशी मां रालो, त तै तीं मैल्हेलो। पन अगर तू तैस शारस त तै हमेशारे लेई तीं शारेलो। <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />हुनी होशियार रा, यहोवाए तू अक एरहो भवन बनानेरे लेई च़ुनोरोस, ज़ै पवित्र ठार भोल्ही, हिम्मत रेखतां इस कम्मे मां लेग्गी गा।”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />तैखन दाऊदे अपने मट्ठे सुलैमाने भवनेरे ओसारे, कमरे, भण्डार बेइयें छतरे कमरे, एंत्रीं कमरे, ते प्रायश्चित ढकनेरे लेई ठारारो नमूनो, <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />ते यहोवारे भवनेरां अंगना ते च़ेवरे पासां केरे कमरे, ते परमेशरेरे भवनेरे भण्डार ते च़ैढ़ोरी चीज़ां केरे भण्डार, ते ज़ै-ज़ै नमूनो परमेशरेरे आत्मारे ज़िरिये सेइं तैस मैल्होरो थियो, तैना सारे तैनी सुलैमाने दित्ते। <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />फिरी दाऊदे याजक ते लेवी केरि टोली, ते यहोवारे भवनेरे सेवारू सारू कम, ते यहोवारे भवनेरे सेवारू सारू सामान, <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />मतलब दाऊदे सुलैमाने हदायत दित्ती कि हर किसमेरी सेवारे लेई सोन्नेरां भांडां केरे लेई सोन्नू तुलतां, ते हर किसमेरे सेवारे लेई चैंदरां भांडां केरे लेई चाँदी तुलतां, <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />ते सोन्नेरे दीवटां केरे लेई, ते तैन केरे हर एक्‍की दीयेरे लेई अक-अक धूपदान, ते तैसेरे दीयां केरू सोन्नू तुलतां ते चैंदरे दीयां केरे लेई अक-अक धूपदान, ते तैसेरे दीयां केरि चाँदी, हर एक्‍की दीवटेरे सब कम्मां केरे मुताबिक तुलतां, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />ते च़ैढ़ोरी रोट्टी केरे मेज़ां केरे लेई हर एक्‍की मेज़ेरे ते तैसेरू सोन्नू तुलतां, ते चैंदरे मेज़ां केरे लेई चाँदी, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />ते शुद्ध सोन्नेरे कंटे, कुटोरे ते प्यालां ते सोन्नेरी कटोरी केरे लेई एक्‍की-एक्‍की कटोरारू सोन्नू तुलतां, ते चैंदरी कटोरी केरे लेई हर एक्‍की कुटोरेरी चाँदी तुलतां, <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />ते धूपेरी वेदरे लेई तेवरू सोन्नू तुलतां, ते रथ मतलब यहोवारे करारेरो सन्दूख ढकने बाले ते फंघां फैलवरे करूबां केरे नमूनेरे लेई सोन्नू दित्तू। <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />दाऊदे तैखन सुलैमाने सेइं ज़ोवं, “मीं यहोवारी योजना सेइं ज़ै मीं मैल्ही, इन सब किछ सेमझ़तां लिखेरूए।”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />फिरी दाऊदे अपने मट्ठे सुलैमाने सेइं ज़ोवं, “हिम्मत रख ते मज़बूत भोइतां इस कम्मे मां लगोरो रा। डर न, ते तू हिम्मत न हार किजोकि यहोवा परमेशर ज़ै मेरो परमेशरे, तै तीं सेइं साथीए। ते ज़ांतगर यहोवारे घरे मां ज़ेत्रू कम केरनू भोल्हु तैन पूरू न भोए, तांतगर तै तीं न धोखो देलो ते न तीं शारेलो। <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />ते हेर परमेशरेरे भवनेरे सारे कम्मेरे लेई याजक ते लेवी केरि टोली च़ुनी, ते हर किसमेरे सेवारे लेई हर किसमेरू कम खुशी सेइं केरनेबाले माहिर कारीगिर भी तेरू साथ देले। ते हाकिम ते सारे लोक भी ज़ैन किछ तू ज़ोलो तैन्ने केरेले।”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">भवन बनानेरे लेई भेंट</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />दाऊद राज़े सारे सभारे लोकां केरे पासे फिरो ते तैन सेइं ज़ोवं, “मेरू मट्ठू सुलैमान हेजू मट्ठू आहे ते तैस हेजू अनुभव नईं, ते सिर्फ तैए परमेशरे च़ुनोरोए। कम त बड़ू बड्डू आहे, किजोकि ई भवन मैन्हु केरे लेई नईं, पन यहोवा परमेशरेरे लेई बनेलो। <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />अवं त अपने पूरे ज़ोरे सेइं, अपने परमेशरेरे भवनेरे लेई सोन्नेरी चीज़ां केरे लेई सोन्नू, चैंदरी चीज़ां केरे लेई चाँदी, पितलरी चीज़ां केरे लेई पितल, लोंहेरी चीज़ां केरे लेई लोंह, ते लेकड़री चीज़ां केरे लेई लकड़ी, ते सुलैमानी घोड़, ते मढ़नेरे लेई मणि, ते पच्‍चीकारी केरनेरे लेई अलग-अलग रंगां केरे नग, ते सेभी किसमेरी मणि ते बड़े संगमरमर अकोट्ठो कियो। <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />मेरो मन अपने परमेशरेरे भवने मां लगोरोए, एल्हेरेलेइ ज़ैन किछ मीं पवित्र भवनेरे लेई अकोट्ठू कियोरूए, तैन सेभन करां जादे अवं अपनु धन भी ज़ैना सोन्नेरे चैंदरे रुपेइये मीं कां आन, अपने परमेशरेरे भवनेरे लेई देताईं। <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />मतलब अक लख किल्‍लो ओपीरेरू सोन्नू, ढाई लख तपेवरी चाँदी, ज़ै भवनेरी दिवारन सेइं लाई गाए। <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />ते सोन्नेरी चीज़ां केरे लेई सोन्नू, ते चैंदरी चीज़ां केरे लेई चाँदी, ते कारीगिरन करां बनानेबाले हर किसमेरे कम्मेरे लेई अवं तैस देताईं। ते कौन अपनि इच्छाई सेइं यहोवारे लेई दान देते?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />तैखन पूर्वजां केरे घरानेरे प्रधानेईं ते इस्राएलेरे गोट्लां केरे हाकिमेईं ते हज़ार ते शौवां केरे सेनापतिएईं ते राज़ेरे कम्मेरे अधिकैरेईं अपने-अपने इच्छाई सेइं, <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />परमेशरेरे भवनेरे कम केरनेरे लेई पौने दूई लख किल्‍लो सोन्नू ते दश हज़ार सोन्नेरे सिक्‍के, सड़े ट्लाई लख चाँदी, शा लख किल्‍लो पितल, ते पेनती लख किल्‍लो लोंह दित्तू। <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />ते ज़ैन कां मणि थिये, तैनेईं तैना यहोवारे भवनेरे खज़ानेरे लेई गेर्शोन कुलेरे यहीएल लेवेरे हथ्थे मां दित्ते। <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />तैखन लोक खुश भोए, किजोकि हाकिमेईं खुशी भोइतां सच़्च़े मने सेइं ते एपनी-एपनी इच्छाई सेइं यहोवारे लेई भेंट दित्तोरी थी। ते दाऊद राज़ो बड़ो खुश भोव।<verse eid="1CH 29:9" /></para>
  <para style="s">दाऊद यहोवारू शुक्र केरते</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />तैखन दाऊद राज़े सारे लोकां केरे सामने यहोवारी तारीफ़ की, ते दाऊदे ज़ोवं, “हे यहोवा! हे इश्शे पूर्वज इस्राएलेरे परमेशर! अनादिकाले करां हमेशा तगर तूए धन आस। <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />हे यहोवा! महिमा, पराक्रम, शोभा, सामर्थ ते वैभव तेरूए। किजोकि अम्बरे ते धेरती पुड़ ज़ैन किछ आहे, तैन तेरूए। हे यहोवा! राज़ तेरूए, ते तू सेभन पुड़ प्रधान ते महान आस।<note caller="-" style="x"><char style="xo" closed="false">29:11 </char><char style="xt" closed="false"><ref loc="REV 5:12-13">प्रका. 5:12-13</ref>.</char></note> <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />दौलत ते आदर तेरी तरफां मैलचे, ते तू सेभन पुड़ हुकूमत केरतस। ते तेरे हथ्थे मां कुदरत ते पराक्रम आहे, ते सब लोक बधाने ते शक्ति देनी तेरे हथ्थे मां आहे। <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />एल्हेरेलेइ हुनी हे इश्शे परमेशर! अस तेरू शुक्र ते तेरे महान नंव्वेरी तारीफ़ केरतम।<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“पन अवं कुन आईं ते मेरे लोक कुन आन? कि असन इस तरीके एपनी इच्छाई सेइं तीं कां भेंट देनेरी शक्ति मैल्हे? तीं करां त सब किछ मैलते, ते असेईं तेरे हथ्थेरां मैलतां तीं दित्तोरूए। <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />तेरी नज़री मां अस त अपने सारे पूर्वजां केरे ज़ेरे बखले ते परदेशी अहम। धेरती पुड़ इश्शे दिहाड़े छावरे ज़ेरे बीती गातन, ते इश्शो कोई ठिकानो नईं।<note caller="-" style="x"><char style="xo" closed="false">29:15 </char><char style="xt" closed="false"><ref loc="HEB 11:13">इब्रा. 11:13</ref>;<ref loc="PSA 39:12">भज. 39:12</ref>;<ref loc="PSA 114:4">114:4</ref>.</char></note> <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />हे इश्शे परमेशर यहोवा! इन सब ज़ैन असेईं अकोट्ठो कियोरोए तेरे लेई अक भवन बनानेरे कियोरूए, तै तेरे तरफां असन मैल्होरो थियो, ते एन सब तेरूए। <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />ते हे मेरे परमेशर! अवं ज़ानताईं कि तू मने परखतस ते सच़्च़ैई सेइं खुश रहतस। मीं त एन सब किछ मनेरी इच्छाई सेइं दित्तोरूए। ते इन लेइतां अवं खुश भोवं, कि तेरे लोक ज़ैना इड़ी हाज़र आन, तैना एपनी इच्छाई सेइं तेरे लेई भेंट देतन। <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />हे यहोवा! हे इश्शे पूर्वज अब्राहम, इसहाक ते इस्राएलेरे परमेशर! अपने लोकां केरे मनेरे खियालन मां ऐह गल बनेइतां रेखां ते तैन केरे मन अपने पासे लगोरे रख। <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />ते मेरे मट्ठे सुलैमानेरो मन एरहो सच़्च़ो केरां कि तै तेरे हुक्म, हदायतां ते विधन मनतो राए ते इन सब केरतो राए, ते तैस भवने बनाए, ज़ेसेरी तियारी मीं कियोरीए।”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />तैखन दाऊदे सैरी सभाई सेइं ज़ोवं, “तुस अपने परमेशर यहोवारू शुक्र केरा।” तैखन सभारे सेभी लोकेईं अपने पूर्वजां केरे परमेशर यहोवारू शुक्र कियूं, ते अपने-अपने क्रोड़ी झुकेइतां यहोवा ते दाऊद राज़े कां झुके।<verse eid="1CH 29:20" /></para>
  <para style="s">राज़ो बन्नेरे लेई सुलैमानेरू अभिषेक</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />होरसां तैनेईं यहोवारे लेई बलिदान कियूं, मतलब पीनेरी च़ढ़तलन सने 1000 दांत, 1000 हुड़ ते 1000 गबड़ां होमबलि केरतां च़ाढ़ां, ते सारे इस्राएलेरे लेई बेड़ी होमबेलि च़ैढ़ी। <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />तैस्से दिहाड़े यहोवारे सामने तैनेईं बड़े आनन्दे सेइं खावं पीवं।</para>
  <para style="p" vid="1CH 29:22">फिरी तैनेईं दाऊदेरू मट्ठू सुलैमान दूइयोवं बार राज़ो बनेइतां यहोवारी तरफां प्रधान भोनेरे लेई तैसेरू ते याजक भोनेरे लेई सादोकेरू अभिषेक कियूं। <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />तैखन सुलैमान अपने बाजी दाऊदेरी जगाई पुड़ राज़ो बेनतां यहोवारे लोकन पुड़ राज़ केरने लगो ते कामयाब भोव, ते सारे इस्राएली तैसेरो हुक्म मन्ते थिये। <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />ते सब हाकिमेईं ते शूरबीरेईं ते इड़ी तगर कि दाऊद राज़ेरे सारे मट्ठेईं सुलैमान राज़ेरे अधीन भोनेरे लेई इकरार कियो। <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />ते यहोवा सुलैमाने सारे इस्राएली केरे हेरते बड़ो कामयाब कियो, ते तैस ऐरी शान-ओ-शोकत दित्ती, ज़ै तैस करां पेइले इस्राएलेरे कोन्ची राज़े न थी मैल्होरीए।<verse eid="1CH 29:25" /></para>
  <para style="s">दाऊद राज़ेरी मौत</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />एन्च़रां सेइं यिशैरे मट्ठे दाऊद राज़े सारे इस्राएले पुड़ राज़ कियूं। <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />ते तैनी 40 साल इस्राएले पुड़ राज़ कियूं। तैनी 7 साल हेब्रोन नगरे मां ते 33 साल यरूशलेम नगरे मां राज़ कियूं। <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />ते तै पूरे बुढापेरी हालती मां लेम्मी उमरारो भोइतां ते दौलतमन्द भोइतां ते वैभव, ते रेज़्ज़तां मेरि जेव। ते तैसेरू मट्ठू सुलैमान तैसेरे जगाई पुड़ राज़ो बनू। <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />शुरू करां आखरी तगर दाऊद राज़ेरे सारे कम्मां केरे बारे मां, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />ते तैसेरी सारी हुकूमत ते शक्ति, तैस पुड़ ते इस्राएले पुड़, बल्के मुल्खे-मुल्खेरे सारे राज़न पुड़ ज़ैन किछ बीतू, तैसेरे भी बारे मां शमूएल नबी ते नातान नबी ते गाद नेबेरे किताबन मां सब लिखेरूए।<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>