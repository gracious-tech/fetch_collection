  <para style="h">विलापगीत</para>
  <para style="toc1">विलापगीत</para>
  <para style="toc2">विलापगीत</para>
  <para style="toc3">विल.</para>
  <para style="mt">विलापगीत</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">इस किताबी मां लिखने बालेरू नवं नईं। यहूदी ते मसीह रीति रुवाज़ेरे मुताबिक दूईये यिर्मयाह नबी एस किताबरे लिखनेबाले मनतन। इस किताबरे लिखनेबाले यरूशलेम नगरेरे विनाशेरे बारे मां लाहेरू थियूं। इस सेइं इन बांदू भोते कि तैनी एप्पु दुश्मन सेनारो हमलो लाहेरो थियो। (<char style="xt"><ref loc="LAM 1:13-15">विल. 1:13-15</ref></char>)। यिर्मयाह दूईये घटना केरे मौके तैड़ी थियो, यहूदी लोकेईं परमेशरे सेइं बगावत केरतां करार ट्लोड़ोरो थियो। परमेशरे तैना सुधारनेरे लेई बाबेलेरो इस्तेमाल कियो। इस किताबी बड़े दुखां केरे बावजूद भी उमीदरो वाधोए। यिर्मयाह परमेशरेरी भलियाई याद केरते, तै परमेशरेरे सच़्च़ैई अरे ज़िरिये तैन्न हिम्मत देते, तै इस किताबी पढ़ने बालन परमेशरेरी दया प्यारेरे बारे ज़ोते।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग 586-584 ई. पू.</para>
  <para style="ip">यिर्मयाह इड़ी बाबेलेरी सेनारे ज़िरिये यरूशलेम नगरेरो घेराव ते विनाशेरो ज़िक्र केरते।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">गुलैमी मां बच़ोरे बाकी यहूदी ज़ैना वापस आए ते सब पवित्रशास्त्र पढ़ने बालां केरे लेई ई किताब लिखी जेई।</para>
  <para style="is">मकसद</para>
  <para style="ip">पाप चाहे अकैल्‍लो मैन्हु केरे या जादे लोक, तैसेरो नितीजो भुगतनो पेते। परमेशर अपने लोकन वापस आन्नेरे लेई मैन्हु ते हालातां केरो इस्तेमाल केरते। उमीद सिर्फ परमेशरे करां भोतीए, ज़ैस तरीके परमेशरे गुलैमी मां किछ यहूदी बच़ेइतां रखोरे थिये। तैस्से तरीके तैनी अपनु मट्ठू यीशु मुक्ति देनेबालो बनेइतां दित्तो। पाप आखरी मौत आनते, पन फिर भी परमेशर अपने मुक्तरे योजनारे ज़िरिये हमेशारी ज़िन्दगी देते। विलाप गीतेरी किताब साफ-साफ ज़ोतीए, कि पाप ते बगावत परमेशरे क्रोध आनतीए।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">विलाप</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यिर्मयाह यरूशलेम नगरेरे लोकां लेई विलाप केरते <char style="ior"><ref loc="LAM 1:1-22">1:1-22</ref> </char></para>
  <para style="io1">2. पाप परमेशरेरे क्रोध आनते <char style="ior"><ref loc="LAM 2:1-22">2:1-22</ref> </char></para>
  <para style="io1">3. परमेशर अपने लोकन कधे न शारे <char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref> </char></para>
  <para style="io1">4. यरूशलेमेरी महिमारो अन्त <char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref> </char></para>
  <para style="io1">5. यिर्मयाह अपने लोकां केरे लेई बिचवाई केरते <char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref> </char></para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s">यरूशलेम नगरे पुड़ ज़ुलम</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1" />यरूशलेम नगरी ज़ै लोकन सेइं भेरतां थी तै हुनी केन्च़रे खालीए!</para>
  <para style="q" vid="LAM 1:1">तै किजो विधवारी ज़ेरि बेनि जेई?</para>
  <para style="q" vid="LAM 1:1">तै ज़ै कौमां केरे नज़री मां महान ते प्रादेशन मां रानी थी,</para>
  <para style="q" vid="LAM 1:1">हुनी किजो लगान देनेबाली भोइ जेवरीए।<verse eid="LAM 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2" />राती तै बेड़ी लेरां देचे, तैसेरां ऐंखरू खैखोड़न पुड़ पेतन।</para>
  <para style="q" vid="LAM 1:2">तैसेरे पेइले यार तैस तसल्‍ली न देन;</para>
  <para style="q" vid="LAM 1:2">तैसेरे सारे दोस्तेईं तैस धोखो दित्तो,</para>
  <para style="q" vid="LAM 1:2">ते तैसेरे दुश्मन बेनि जेवरेन।<verse eid="LAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3" />यहूदा दुख ते सखत गुलैमरे वजाई सेइं प्रदेशे जो च़ली जेई,</para>
  <para style="q" vid="LAM 1:3">पन गैर कौमन मां रेइतां तैस चैन न मैल्हे,</para>
  <para style="q" vid="LAM 1:3">तैसेरे सब निशान्ने बालेईं तैसेरे तंग हालती मां तै ट्लाई।<verse eid="LAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4" />सिय्योनेरे भवनेरे बत्तां मातम केरने लेवरिन,</para>
  <para style="q" vid="LAM 1:4">किजोकि ठहरावरे तिहारन मां कोई न एज्जे;</para>
  <para style="q" vid="LAM 1:4">तैसेरे सब फाटक सुनसान पेवरेन, तैसेरे याजक ट्लासतन;</para>
  <para style="q" vid="LAM 1:4">तैसेरी कुइयां दुखी आन,</para>
  <para style="q" vid="LAM 1:4">ते तै एप्पु बड़े दुख झ़ैलने लगोरीए।<verse eid="LAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5" />तैसेरे दुश्मन प्रधान भोइ जे, ते तैना तरक्‍की केरि राहोरेन,</para>
  <para style="q" vid="LAM 1:5">किजोकि तैसेरे बड़े पापां केरि वजाई सेइं यहोवा तैस दुख दित्तोरोए,</para>
  <para style="q" vid="LAM 1:5">दुश्मनेईं तैसेरे बच्‍चे गुलैमी मां ने।<verse eid="LAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6" />सिय्योनेरी कुइअरी शान-ओ-शोकत च़ली जेई।</para>
  <para style="q" vid="LAM 1:6">तैसेरे हाकिम एरे हिरनां केरे ज़ेरे भेवरेन ज़ैन कोई चरागा न मैल्हे।<verse eid="LAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7" />यरूशलेमे इन दुखे सेइं भेरतां दिहाड़न मां,</para>
  <para style="q" vid="LAM 1:7">ज़ैखन तैसेरे लोक दुश्मना केरे हथ्थे मां पे ते तैसेरी कोई मद्दत केरनेबालो न राव,</para>
  <para style="q" vid="LAM 1:7">एपनी सैरी कीमती चीज़ां ज़ैना पुराने ज़माने करां तैसेरी थी, याद कियोरिन।</para>
  <para style="q" vid="LAM 1:7">तैसेरे दुश्मनेईं तै उज़ड़ोरी लेइतां तैसेरो मज़ाक बनेवरोए।<verse eid="LAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8" />यरूशलेमे बड़ो पाप कियो, एल्हेरेलेइ तै अशुद्ध कौन्शरी ज़ेरि भोवरीए;</para>
  <para style="q" vid="LAM 1:8">ज़ेत्रे तैसेरी आदर केरते थिये तैना तैसेरी निरादर केरतन,</para>
  <para style="q" vid="LAM 1:8">किजोकि तैनेईं तैसेरू नग्गू पन लाहेरूए,</para>
  <para style="q" vid="LAM 1:8">हाँ, तै ट्लसती तुत्तर फिरातीए।<verse eid="LAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9" />तैसेरी अशुद्धता तैसेरे लिगड़े पुड़े।</para>
  <para style="q" vid="LAM 1:9">तैसां अपनो अन्त याद न रख्खो।</para>
  <para style="q" vid="LAM 1:9">एल्हेरेलेइ तै बड़े बुरे तरीके सेइं बिछ़ोड़ी जेवरीए,</para>
  <para style="q" vid="LAM 1:9">ते कोई तैस तसल्‍ली न दे।</para>
  <para style="q" vid="LAM 1:9">तै दयारे लेई बिनती केरतीए, हे यहोवा मेरे दुखे पुड़ नज़र केर,</para>
  <para style="q" vid="LAM 1:9">किजोकि दुश्मन मेरे खलाफ कामयाब भोवरोए!<verse eid="LAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10" />दुश्मनेईं तैसेरी सब कीमती चीज़ां लुटोरिन;</para>
  <para style="q" vid="LAM 1:10">हाँ, गैर कौमन, ज़ैन केरे बारे मां तीं हुक्म दित्तोरो थियो कि तैना तेरे सभाई मां शामल न भोइ सकेले,</para>
  <para style="q" vid="LAM 1:10">तैना तैसां तेरे पवित्र ठैरी मां एवरे लाहोरेन।<verse eid="LAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11" />तैस मां रानेबाले सारे ट्लासते खानेरी चीज़ां तोप्पने लगोरेन।</para>
  <para style="q" vid="LAM 1:11">तैनेईं अपनो प्राण बच़ानेरे लेई अपनि कीमती चीज़ां बेच़तां खाने जो घिन्नू।</para>
  <para style="q" vid="LAM 1:11">तै मद्दतरे लेई बिनती केरतीए, हे यहोवा, नज़र केर ते ध्यान सेइं तक,</para>
  <para style="q" vid="LAM 1:11">किजोकि अवं घटिया भोइ जेवरीं।<verse eid="LAM 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12" />तै ज़ोतीए, हे सब एजने गाने बालव, कुन तुसन इस गल्‍लरो कोई फिक्र नईं?</para>
  <para style="q" vid="LAM 1:12">नज़र केरतां हेरा, कुन मेरे दुखे करां बेद्धतां होरि कोई तकलीफे ज़ै यहोवा क्रोधेरे दिहाड़े मीं पुड़ छ़डोरीए?<verse eid="LAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13" />तैने बैंधोरां मेरे हेड्डन मां अग लाई,</para>
  <para style="q" vid="LAM 1:13">ते तैना तैस सेइं भस्म भोइ जे।</para>
  <para style="q" vid="LAM 1:13">तैनी मेरे पव्वां केरे लेई जाल बिछ़ाव, ते अवं उलटव।</para>
  <para style="q" vid="LAM 1:13">तैनी एन्च़रे कियूं कि अवं शारोरी ज़ेरि ते रोगे सेइं लगातार कमज़ोर रहतीं।<verse eid="LAM 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14" />तैनी जुऊं एरे रेस्सी केरे ज़ेरे मेरे पाप अपने हथ्थे सेइं कस्सोरेन।</para>
  <para style="q" vid="LAM 1:14">तैनी तैना बेंटतां मेरे मेट्टू पुड़ च़ैढ़ी, ते मेरो ज़ोर घटाव;</para>
  <para style="q" vid="LAM 1:14">ज़ैन केरो अवं मुकाबलो भी न केरि सकेई, यहोवा अवं तैन केरे कब्ज़े मां की।<verse eid="LAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15" />यहोवा मेरे सब बहादर मड़द घटिया समझ़े।</para>
  <para style="q" vid="LAM 1:15">तैनी ठहरावरे तिहारेरां केरे बारे मां प्रचार केरतां सेना मेरे खलाफ कुजाई कि मेरे जुवानन पीहन;</para>
  <para style="q" vid="LAM 1:15">यहूदा प्रदेशेरी कुई यहोवा ज़ेन्च़रे कुण्डे मां ढ्लेन्च़ोरी भोए।<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="REV 14:20">प्रका. 14:20</ref>;<ref loc="REV 19:15">19:15</ref>.</char></note><verse eid="LAM 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16" />इन गल्‍लां केरे वजाई सेइं अवं लेरां देती।</para>
  <para style="q" vid="LAM 1:16">ते मेरी एछ़्छ़न सेइं पैनेरी गड्डां बेगती रैतिन।</para>
  <para style="q" vid="LAM 1:16">किजोकि ज़ैस तसल्‍ली देनेबालेरे वजाई सेइं मेरे दिले तसल्‍ली मैलती थी, तै मीं करां दूर भोव;</para>
  <para style="q" vid="LAM 1:16">मेरे लोक अकैल्‍ले भोइ जे, किजोकि दुश्मन प्रबल भोइ जे।<verse eid="LAM 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17" />सिय्योने हथ फैलावरेन, तैस कोई तसल्‍ली न दे,</para>
  <para style="q" vid="LAM 1:17">यहोवा याकूबेरे बारे मां ई हुक्म दित्तोरोए कि तैसेरे च़ेवरे पासेरे रानेबाले दुश्मन भोइ गान;</para>
  <para style="q" vid="LAM 1:17">यरूशलेम तैन केरे दरमियान अशुद्ध कौन्शरी ज़ेरि भोइ जेई।<verse eid="LAM 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18" />यहोवा सच़्च़ो, किजोकि मीं तैसेरो हुक्म ट्लोड़ोरोए।</para>
  <para style="q" vid="LAM 1:18">हे सारे लोकव, शुना, मेरी तकलीफ हेरा! मेरां जुवान मट्ठां ते कुइयां गुलैमी मां च़ेलि जेआं।<verse eid="LAM 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />मीं अपने यारन कां मद्दत मग्गी पन तैनेईं भी मीं धोखो दित्तो।</para>
  <para style="q" vid="LAM 1:19">ज़ैखन मेरे याजक ते बुज़ुर्ग एल्हेरेलेइ खानेरी चीज़ां तोप्पने लगोरे थिये कि तैना ज़ींते रान,</para>
  <para style="q" vid="LAM 1:19">तैखन नगरे मां तैना मेरि जे।<verse eid="LAM 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20" />हे यहोवा, ध्यान दे, किजोकि अवं मुसीबती मां आईं,</para>
  <para style="q" vid="LAM 1:20">मेरी आंट्लां शुक्‍की जेई, मेरो दिल उदास भोइ जेव, किजोकि मीं बड़ी बगावत कियोरीए।</para>
  <para style="q" vid="LAM 1:20">बेइर त अवं त तलवारी सेइं बेऔलाद भोती;</para>
  <para style="q" vid="LAM 1:20">ते घरे मां मौत बास केरतीए।<verse eid="LAM 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21" />तैनेईं शुनोरू कि अवं ट्लासतीं,</para>
  <para style="q" vid="LAM 1:21">पन मीं कोई तसल्‍ली न दे।</para>
  <para style="q" vid="LAM 1:21">मेरे सब दुश्मनेईं मेरी मुसीबतरी खबर शुनोरीए;</para>
  <para style="q" vid="LAM 1:21">तैना इस सेइं खुश भोए कि तींए एन कियोरूए।</para>
  <para style="q" vid="LAM 1:21">पन ज़ैस सज़ारे दिहाड़ेरे बारे मां तीं प्रचार केरतां ज़ोवरूए तैस तू हिरा।</para>
  <para style="q" vid="LAM 1:21">तैखन तैना भी मेरे ज़ेरे दुख झ़ैल्‍लन।<verse eid="LAM 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22" />तैन केरि सारी दुष्टतारे पासे नज़र केर;</para>
  <para style="q" vid="LAM 1:22">ते ज़ेन्च़रे मेरे सारे पापां केरे वजाई सेइं तीं मीं सज़ाह दित्ती, तेन्च़रे तैन भी सज़ाह दे;</para>
  <para style="q" vid="LAM 1:22">किजोकि अवं बड़े मुसीबती मां आईं,</para>
  <para style="q" vid="LAM 1:22">ते मेरो दिल रोगे सेइं कमज़ोर भोइ जेवरोए।<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s">यरूशलेम नगरे पुड़ परमेशरेरो क्रोध</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1" />यहोवा सिय्योनेरे लोक केन्च़रे सेइं अपने क्रोधेरे बिदलारी सेइं ढक्‍के!</para>
  <para style="q" vid="LAM 2:1">तैनी इस्राएलेरी शोभा अम्बरे मरां धेरती पुड़ जो शारी;</para>
  <para style="q" vid="LAM 2:1">ते क्रोधेरे दिहाड़े अपने पव्वां केरि चौवकी<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">पव्वां केरि चौवकी </char><char style="ft" closed="false">मतलब यरूशलेम नगरेरो भवन।</char></note> याद न की।<verse eid="LAM 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2" />यहोवा याकूबेरी सब बेसती दया न केरतां नाश की;</para>
  <para style="q" vid="LAM 2:2">तैनी सेरकोइतां यहूदारी कुइअरे मज़बूत क़िले मित्ती मां मिलाए;</para>
  <para style="q" vid="LAM 2:2">तैनी हाकिमन समेत रियासत अपवित्र ठहराई।<verse eid="LAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3" />तैनी क्रोधे मां इस्राएलेरू शिंग<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fq" closed="false">शिंग </char><char style="ft" closed="false">शक्ति</char></note> ज़ीले करां कटोरूए;</para>
  <para style="q" vid="LAM 2:3">तैनी दुश्मनेरे सामने तैन केरि मद्दत केरने करां अपनो देइनो हथ पत्रोवं कियोरोए;</para>
  <para style="q" vid="LAM 2:3">तैनी च़ेवरे पासन भस्म केरती लप्परे ज़ेरे याकूब फुकोरोए।<verse eid="LAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4" />तैनी दुश्मन बेनतां धनुष च़ाढ़ू, ते बैरी बेनतां देइनो हथ अग्रोवं केरतां खड़ोए;</para>
  <para style="q" vid="LAM 2:4">ते ज़ेत्रे हेरने खूबसूरत थिये, तैना सारे तैनी मारे;</para>
  <para style="q" vid="LAM 2:4">सिय्योनेरी कुइअरे<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="fq" closed="false">सिय्योनेरी कुइअरे </char><char style="ft" closed="false">यरूशलेम</char></note> तेम्बु पुड़ तैनी अग्गरे ज़ेरो अपनो क्रोध भड़कव।<verse eid="LAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5" />यहोवा दुश्मन बनो, तैनी इस्राएल निगलो;</para>
  <para style="q" vid="LAM 2:5">तैसेरे सारे भवन तैनी मिटाए, ते तैसेरे मज़बूत क़िले तबाह किये;</para>
  <para style="q" vid="LAM 2:5">ते यहूदारे कुइअरी लेरां बेड़ी बधेवरिन।<verse eid="LAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6" />तैनी अपनो तेम्बु बागरे झोपड़ारो ज़ेरो अचानक बिछ़ोड़ो,</para>
  <para style="q" vid="LAM 2:6">अपने मिलापेरे ठैरी तैनी नाश कियोरोए;</para>
  <para style="q" vid="LAM 2:6">यहोवा सिय्योने मां ठहरावरे तिहार ते आरामेरी दिहैड़ी बिसरेवरिन।</para>
  <para style="q" vid="LAM 2:6">ते अपने भड़कोरे क्रोधे सेइं राज़ो ते याजक दूईये रद कियोरेन।<verse eid="LAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7" />यहोवा अपनि वेदी मने मरां कढी,</para>
  <para style="q" vid="LAM 2:7">ते अपनि पवित्र ठार शारी,</para>
  <para style="q" vid="LAM 2:7">तैसेरे भवनेरी दिवारां तैनी दुश्मना केरे कब्ज़े मां की;</para>
  <para style="q" vid="LAM 2:7">यहोवारे भवने मां ज़ींतरे खुशी मां तैनेईं एरी शौर मच़ाई कि ज़ेन्च़रे ठहरावरे तिहारेरी दिहाड़ी भोए।<verse eid="LAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8" />यहोवा सिय्योनेरे कुइअरे शहरपनाह ट्लोड़नेरे बारे मां थापेरू थियूं:</para>
  <para style="q" vid="LAM 2:8">तैनी डोरी छ़डी ते अपनो हथ तैस नाश केरने करां न पत्रोवं कियो;</para>
  <para style="q" vid="LAM 2:8">तैनी क़िले ते शहरपनाह दूईयन करां मातम कराव, तैना दूईये साथी बिछ़ोड़े जे।<verse eid="LAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9" />सिय्योन नगरेरे फाटक ज़मीनी मां डुब्बे, तैसेरे अड्डे तैनी ट्लोड़तां नाश किये।</para>
  <para style="q" vid="LAM 2:9">तैसेरे राज़े ते हाकिम गैर कौमन मां रानेरे वजाई सेइं बगैर कानूने भोइ जे,</para>
  <para style="q" vid="LAM 2:9">तैसेरे नेबन यहोवारू दर्शन न मैल्हे।<verse eid="LAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10" />सिय्योनेरी कुइअरे बुज़ुर्ग च़ुपच़ाप बिश्शोरे आन;</para>
  <para style="q" vid="LAM 2:10">तैनेईं अपने दोग्गे पुड़ धूड़ उडारी ते टाट बन्धू;</para>
  <para style="q" vid="LAM 2:10">यरूशलेमेरे कुइयेईं अपनि-अपनि क्रोड़ी ज़मीनी तगर झुकाई।<verse eid="LAM 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11" />लेरां देइ-देइ मेरी एछ़्छ़ी केरू पानी शुक्‍की जेवं;</para>
  <para style="q" vid="LAM 2:11">मेरी आंट्लां शुक्‍की गैतिन;</para>
  <para style="q" vid="LAM 2:11">मेरे लोकां केरि कुइयां केरे नाशेरे वजाई सेइं मेरो कलैज़ो फेटी जेवरोए,</para>
  <para style="q" vid="LAM 2:11">किजोकि बच्‍चे बल्के दुद्ध पीते बच्‍चे भी नगरेरे चौके मां बेहोश पेवरेन।<verse eid="LAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12" />तैना लेरां देइतां एपनी अम्मा सेइं ज़ोतन,</para>
  <para style="q" vid="LAM 2:12">अन्न ते दाछ़रो रस कोड़िए?</para>
  <para style="q" vid="LAM 2:12">तैना नगरेरे चौके मां ज़खमी कियोरे मैन्हु केरे ज़ेरे बेहोश पेवरे</para>
  <para style="q" vid="LAM 2:12">अपने प्राण अपने-अपने अम्मरे कुम्मे मां बल्हे-बल्हे देतन।<verse eid="LAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13" />हे यरूशलेमेरे कुइये, अवं तीं सेइं कुन ज़ोईं?</para>
  <para style="q" vid="LAM 2:13">अवं तेरू ऊपाम कैस सेइं देईं?</para>
  <para style="q" vid="LAM 2:13">हे सिय्योनेरे कुइये, अवं कौ ज़ेरि चीज़ तेरी ज़ेरि बनेइतां तीं तसल्‍ली देईं?</para>
  <para style="q" vid="LAM 2:13">किजोकि तेरो दुख सुमन्दरेरो ज़ेरो बड़ोए;</para>
  <para style="q" vid="LAM 2:13">तीं कौन बझ़ेइं सकते?<verse eid="LAM 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14" />तेरे नेबेईं दर्शनेरी गल्‍लां केरो दावो केरतां तीं सेइं फुज़ूल ते बेवकूफरी गल्‍लां ज़ोवरिन;</para>
  <para style="q" vid="LAM 2:14">तैनेईं तेरो अधर्म बांदो न कियो, न त तू गुलाम न भोथो;</para>
  <para style="q" vid="LAM 2:14">पन तैनेईं तीं सेइं बेकार ते झूठे वचन ज़ोए।</para>
  <para style="q" vid="LAM 2:14">ज़ैना तेरे लेई मुल्खे मरां कढे गानेरी वजा भोए।<verse eid="LAM 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15" />सब मुसाफर तीं पुड़ च़ैड़ी बज़ातन;</para>
  <para style="q" vid="LAM 2:15">तैना यरूशलेमेरी कुइये पुड़ इन ज़ोइतां च़ैड़ी बज़ातन ते क्रोड़ी हिलातन,</para>
  <para style="q" vid="LAM 2:15">कुन ई तैए नगरीए ज़ैस जो बड़ी खूबसूरत</para>
  <para style="q" vid="LAM 2:15">ते सारे धेरतरे खुशरी वजा ज़ोते थिये?<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="MAT 27:39">मत. 27:39</ref>.</char></note><verse eid="LAM 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16" />तेरे सारे दुश्मनेईं तीं पुड़ आशी खोलोरूए,</para>
  <para style="q" vid="LAM 2:16">तैना च़ैड़ी देतन ते दंत कटतन, तैना ज़ोतन, असेईं तै निगली!</para>
  <para style="q" vid="LAM 2:16">ज़ैस दिहैड़ी अस बलगते थिये तै ई आए,</para>
  <para style="q" vid="LAM 2:16">तै असन मैल्ही, असेईं तै लाई!<verse eid="LAM 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17" />यहोवा ज़ैन किछ थापेरू थियूं तैन्ने कियोरू भी आए,</para>
  <para style="q" vid="LAM 2:17">ज़ै वचन तै पुराने ज़माने करां ज़ोतो एवरोए तैए तैनी पूरो भी कियो;</para>
  <para style="q" vid="LAM 2:17">तैनी दया केरने बगैर तू बिछ़ोड़ोरोस, तैनी दुश्मन तीं पुड़ खुश किये,</para>
  <para style="q" vid="LAM 2:17">ते तेरे दुश्मना केरि शक्ति बधाई।<verse eid="LAM 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18" />तैना प्रभुएरे पासे तने मने सेइं फरियाद केरतन!</para>
  <para style="q" vid="LAM 2:18">हे सिय्योनेरी कुइयरी शहरपनाह,</para>
  <para style="q" vid="LAM 2:18">अपना ऐंखरू रात दिहैड़ी दरियारे ज़ेरि बगाती रा!</para>
  <para style="q" vid="LAM 2:18">थोड़ो ज़ेरो भी आराम न केर, न तेरी अछ़री पुतली चैन ने!<verse eid="LAM 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19" />रातरे हर पहरे करां पेइले उठतां चिन्डां मार!</para>
  <para style="q" vid="LAM 2:19">प्रभुएरे सामने अपने मनेरी गल्‍लां पैनेरी ज़ेरि उलटा!</para>
  <para style="q" vid="LAM 2:19">तेरे बाल बच्‍चे ज़ैना हर एक्‍की सड़करे ड्लेखी ढ्लुखरे वजाई सेइं बेहोश पेने लगोरेन,</para>
  <para style="q" vid="LAM 2:19">तैन केरे प्राणेरे खातर अपने हथ तैसेरे पासे खिलार।<verse eid="LAM 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20" />हे यहोवा नज़र केर, ते ध्याने सेइं हेर कि तीं इना सब दुख कैस दित्तोरेन?</para>
  <para style="q" vid="LAM 2:20">कुन कौन्शां अपने फल मतलब अपने कुम्मेरे बच्‍चन खान?</para>
  <para style="q" vid="LAM 2:20">हे प्रभु कुन याजक ते नबी तेरे पवित्र ठैरी मां मारे गान?<verse eid="LAM 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21" />सड़कन मां मट्ठां ते बुढे दूईये ज़मीनी पुड़ पेवरेन;</para>
  <para style="q" vid="LAM 2:21">मेरी कुइयां ते जुवान लोक तलवारी सेइं मारे जेवरेन;</para>
  <para style="q" vid="LAM 2:21">तीं क्रोध केरनेरे दिहाड़े तैना मारे;</para>
  <para style="q" vid="LAM 2:21">तीं दया न केरतां तैना मारोरेन।<verse eid="LAM 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22" />मेरे डरेरे वजा तीं ठहरावरे तिहारेरी भीड़रे ज़ेरे च़ेवरे पासना कुजेवरेन;</para>
  <para style="q" vid="LAM 2:22">ते यहोवारे क्रोधेरे दिहाड़े न त कोई हिस्सो निस्सो ते न कोई बच़ोरो राहोरोए;</para>
  <para style="q" vid="LAM 2:22">ज़ैना बच्‍चे मीं कुम्मे मां ट्लाए ते पालोरे थिये, मेरे दुश्मनेईं तैना मारे।<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s">नेबेरे दुख ते तैसेरी उमीद</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1" />अवं इन लिखने बालो यहोवारे क्रोधेरे लट्ठी सेइं दुख झ़ैलने बालो मैन्हु आईं;<verse eid="LAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2" />तै मीं नेइतां लौई मां नईं, आंधरे मां च़लाते;<verse eid="LAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3" />तैसेरो हथ पूरे दिहैड़ी मेरे खलाफ उठतो रहते।<verse eid="LAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4" />तैनी मेरू मास ते चमड़ो गालोरोए,</para>
  <para style="q" vid="LAM 3:4">ते मेरी हेड्डी ट्लोड़ोरिन;<verse eid="LAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5" />तैनी मीं रोकनेरे लेई क़िलो बनाव,</para>
  <para style="q" vid="LAM 3:5">ते अवं सखत दुख ते मुसीबती सेइं घेरोरोईं;<verse eid="LAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6" />तैनी अवं बड़े च़िरेरे मेरे मरोरे लोकां केरो ज़ेरो आंधरेरे ठैरन मां बस्सनेरे लेई मजबूर कियो।<verse eid="LAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7" />मेरे च़ेवरे पासन तैनी बाड़ बन्धोरोए कि अवं निस्सी न सेखी;</para>
  <para style="q" vid="LAM 3:7">तैनी अवं भारी शंगली सेइं बन्धोरोईं।<verse eid="LAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8" />अवं ज़ोरे-ज़ोरे सेइं फरियाद केरताईं,</para>
  <para style="q" vid="LAM 3:8">फिरी भी तै मेरी प्राथना न शुने;<verse eid="LAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9" />मेरी बत्तां तैनी घोड़ां केरि दिवारन सेइं रोकतां रेखोरिन,</para>
  <para style="q" vid="LAM 3:9">मेरी बत्तां तैनी टैरी कियोरिन।<verse eid="LAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10" />तै मेरे लेई ढोक लेइतां बिश्शोरे इछ़ ते ढोक लेइतां शेरेरो ज़ेरोए;<verse eid="LAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11" />तैनी अवं मेरे बत्तन करां बिसराव,</para>
  <para style="q" vid="LAM 3:11">ते अवं छ़िन्दो; तैनी अवं उज़ाड़ो।<verse eid="LAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12" />परमेशरे अपनु धनुष खिचतां अवं अपने तीरे सेइं निशानो बनाव।<verse eid="LAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13" />तैनी अपने तीरन सेइं मेरो दिल ज़खमी कियो;<verse eid="LAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14" />सारे लोक मीं पुड़ हसतन ते पूरे दिहैड़ी मेरो गीतां ज़ोइतां मज़ाक बनातन।<verse eid="LAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15" />तैनी अवं सखत दुखे सेइं भरो,</para>
  <para style="q" vid="LAM 3:15">ते नागदौना पियेइतां रज़ानो।<verse eid="LAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16" />तैनी मेरे दंत सिक्‍कन सेइं ट्लोड़े,</para>
  <para style="q" vid="LAM 3:16">ते अवं मांज़नी सेइं ढक्‍को;<verse eid="LAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17" />ते अवं मने मरां केढतां सुखे करां दूर कियो;</para>
  <para style="q" vid="LAM 3:17">मीं सुख बिसरोरोए;<verse eid="LAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18" />एल्हेरेलेइ मीं अपने आपे सेइं ज़ोवं, “मेरी शक्ति च़ली जेई,</para>
  <para style="q" vid="LAM 3:18">ते मेरी उमीद ज़ै यहोवा पुड़ थी, तै ट्लुटी जेई।”<verse eid="LAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19" />मेरो दुख ते दरबदर फिरनू, मेरू नागदौने</para>
  <para style="q" vid="LAM 3:19">ते बिषेरू पीनू याद केर!<verse eid="LAM 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20" />अवं तैन्ने पुड़ सोचतो रहताईं,</para>
  <para style="q" vid="LAM 3:20">इस सेइं मेरो प्राण ढेली गाते।<verse eid="LAM 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21" />पन अवं इन याद केरताईं, एल्हेरेलेइ मीं उमीदे:<verse eid="LAM 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22" />असां मिटी न जे; ई यहोवारी महाकरुणारो फले, किजोकि तैसेरी दया कधे खतम न भोए।<verse eid="LAM 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23" />रोज़ झ़ेझ़ां तैसेरी करुणा ते दया नंव्वी भोती रैतिन; तेरी सच़्च़ाई महाने।<verse eid="LAM 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24" />मेरे मने ज़ोवं, “यहोवा मेरो हिस्सोए, इस वजाई सेइं अवं तैस मां उमीद रखेलो।”<verse eid="LAM 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25" />ज़ैना यहोवारो इंतज़ार केरतन ते तैस कां गातन, तैन केरे लेई यहोवा भलोए।<verse eid="LAM 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26" />यहोवा करां छुटकारेरी उमीद रेखतां च़ुपच़ाप रानू ठीके।<verse eid="LAM 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27" />मड़देरे लेई जुवैनी मां सबरारू जुऊं छ़ूनू भलूए।<verse eid="LAM 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28" />तै इन ज़ैनतां च़ुपच़ाप राए, कि परमेशरे तैस पुड़ इन जुऊं छ़डोरूए;<verse eid="LAM 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29" />तै अपनु तुत्तर धूड़ी मां रख्खे, कुन पतो किछ उमीद भोए;<verse eid="LAM 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30" />तै अपनि खाखोड़ी अपने बाने बालेरे पासे केरे, ते बदनामी झ़ैलतो राए।<verse eid="LAM 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31" />किजोकि प्रभु असन हमेशा न शारेलो,<verse eid="LAM 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32" />चाए तै दुख भी दे, फिरी भी अपने बड़े करुणारे वजाई सेइं तै दया भी केरते;<verse eid="LAM 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33" />किजोकि तै मैन्हु अपने मने सेइं न त दबाते ते न दुख देते।<verse eid="LAM 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34" />धेरतरे कैदन पव्वन हैठ ढ्लेन्च़नेरे लेई,<verse eid="LAM 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35" />कोन्ची मैन्हेरू हक मारनू परमप्रधान परमेशरेरे सामने मारनू,<verse eid="LAM 3:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36" />ते कोन्ची मैन्हेरो मुकदमो बिगाड़नो,</para>
  <para style="q" vid="LAM 3:36">इना ट्लाई कम्मन यहोवा हेरी न सके।<verse eid="LAM 3:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37" />अगर यहोवा हुक्म न दित्तोरो भोए, तैखन कौने</para>
  <para style="q" vid="LAM 3:37">कि वचन ज़ोए ते तैन पूरू भोए?<verse eid="LAM 3:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38" />आफत ते भलियाई, कुन दूईये परमप्रधान परमेशरेरे हुक्मे सेइं न भोए?<verse eid="LAM 3:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39" />एल्हेरेलेइ ज़ींते मैन्हु किजो कुड़कुड़ातन?</para>
  <para style="q" vid="LAM 3:39">ते मड़द अपने पापेरे सज़ाही किजो बुरू मन्ने?<verse eid="LAM 3:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40" />अस चाल चलने ध्याने सेइं परखम,</para>
  <para style="q" vid="LAM 3:40">ते यहोवारे पासे फिरम!<verse eid="LAM 3:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41" />असां सुर्गे मां रानेबाले परमेशरेरे पासे मन लाम</para>
  <para style="q" vid="LAM 3:41">ते हथ फैलाम ते ज़ोम:<verse eid="LAM 3:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42" />“हे यहोवा असेईं त पाप ते बगावत कियोरीए,</para>
  <para style="q" vid="LAM 3:42">ते तीं माफ़ न कियूं।<verse eid="LAM 3:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43" />तेरो क्रोध असन पुड़े, तू असन पत्ती पेवरोस,</para>
  <para style="q" vid="LAM 3:43">तीं तरस खाने बगैर मारे।<verse eid="LAM 3:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44" />तीं अपनो आप बिदलारी सेइं घेरो कि तीं तगर प्राथना न पुज़्ज़ी सके।<verse eid="LAM 3:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45" />तीं असां कौमां-कौमां केरे लोकां केरे दरमियाने मां कूड़ेरे ज़ेरे बनाए।<note caller="-" style="x"><char style="xo" closed="false">3:45 </char><char style="xt" closed="false"><ref loc="1CO 4:13">1 कुरि. 4:13</ref>.</char></note><verse eid="LAM 3:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46" />इश्शे सारे दुश्मनेईं असन पुड़ अपनु-अपनु आशी खोल्‍लू;<verse eid="LAM 3:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47" />डर ते खड्डो, उज़ाड़ ते विनाश, असन पुड़ पेवरेन;<verse eid="LAM 3:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48" />मेरी एछ़्छ़ी मेरे लोकां केरे कुइअरे विनाशेरे वजाई सेइं पैनेरी गड्डां बगाने लेगोरिन।<verse eid="LAM 3:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49" />मेरी एछ़्छ़न सेइं लगातार ऐंखरू बगतां रालां,<verse eid="LAM 3:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50" />ज़ैखन करां यहोवा सुर्गे मरां इश्शे पासे न तक्‍के;<verse eid="LAM 3:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51" />अपने नेगरी मां रानेबाले सब जुवान कौन्शां केरो हाल हेरने पुड़ मेरो दुख बड़ो बधो।<verse eid="LAM 3:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52" />ज़ैना बगैर वजां मेरे दुश्मन बनोरेन, तैनेईं बेरहमी सेइं च़ुड़ोलवेरो ज़ेरो मेरो शिकार कियोरोए;<note caller="-" style="x"><char style="xo" closed="false">3:52 </char><char style="xt" closed="false"><ref loc="PSA 35:7">भज. 35:7</ref>.</char></note><verse eid="LAM 3:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53" />तैनेईं अवं खड्डे मां छ़ेडतां मेरे ज़िन्दगरो अन्त केरनेरे लेई मीं पुड़ घोड़ शारे<note caller="+" style="f"><char style="fr" closed="false">3:53 </char><char style="fq" closed="false">घोड़ शारे </char><char style="ft" closed="false">इसेरो मतलब ई भी भोइ सकते, खड्डे पुड़ घोड़ छ़डे।</char></note>;<verse eid="LAM 3:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54" />मेरे क्रोड़ी पुड़ां पानी बगू, मीं ज़ोवं, ‘अवं हुनी नाश भोइ जेव।’<verse eid="LAM 3:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55" />हे यहोवा, मीं डुग्घे गढे मरां तीं कां प्राथना की;<verse eid="LAM 3:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56" />तीं मेरी शुनी कि ज़ै फरियाद अवं ज़ोरे सेइं केरताईं तैस तू अनशुनी न केर!<verse eid="LAM 3:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57" />ज़ैखन मीं तीं कां प्राथना की, तैखन तीं मीं सेइं ज़ोवं, ‘न डर!’<verse eid="LAM 3:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58" />हे यहोवा, तीं मेरो मुकदमो लेड़तां मेरे प्राण बच़ाए।<verse eid="LAM 3:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59" />हे यहोवा, ज़ै अन्याय मीं पुड़ भोवरोए तै तीं लाहोरोए; तू मेरो न्याय केर।<verse eid="LAM 3:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60" />ज़ै बदलो मेरे दुश्मनेईं मीं सेइं नेव, ते ज़ैना योजना मेरे खलाफ बनेई, तैना भी तीं लेवरिन।<verse eid="LAM 3:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61" />हे यहोवा, ज़ैना योजना ते निन्दा तैना मेरे खलाफ केरतन, तैना भी तीं शुनोरिन।<verse eid="LAM 3:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62" />मेरे दुश्मना केरि गल्‍लां, ते ज़ैन किछ भी तैना मेरे खलाफ लगातार सोचतन, तैन्न तू ज़ानतस।<verse eid="LAM 3:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63" />तैन केरू उठनू बिशनू ध्याने सेइं हेर;</para>
  <para style="q" vid="LAM 3:63">तैना मीं पुड़ मज़ाकेरू गीत ज़ोतन।<verse eid="LAM 3:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64" />हे यहोवा, तू मेरे दुश्मना केरे कम्मां केरे मुताबिक तैन्न बदलो देलो।<verse eid="LAM 3:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65" />तू तैन केरो मन सुन्न केरेलो; तेरी लानत तैन पुड़ भोल्ही।<verse eid="LAM 3:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66" />हे यहोवा, तू अपने क्रोधे सेइं तैन निशैनी-निशैनी दुनियाई मरां नाश केरेलो।”<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s">सिय्योने पुड़ हमलेरो डर</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1" />सोन्नू केन्च़रे खोट्टू भोइ जेवं, खालिस सोन्नू केन्च़रे बेदलोव?</para>
  <para style="q" vid="LAM 4:1">पवित्र ठारारे कीमती घोड़ त हर एक्‍की सड़करे बन्ने पुड़ शारे गातन।<verse eid="LAM 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2" />सिय्योनेरां कीमती मट्ठां ज़ैना कुन्देरां ज़ेरां थियां,</para>
  <para style="q" vid="LAM 4:2">तैना कुम्हारेरे बनेवरे मित्तरे घड़ां केरे ज़ेरे केरहे घटिया गने जेवरन।<verse eid="LAM 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3" />गिदनी भी अपने बच्‍चन दुद्ध पियातीए,</para>
  <para style="q" vid="LAM 4:3">पन मेरे लोकां केरि कुई जंगलेरे शुतुर्मुर्गां केरि ज़ेरि बेरहम भोवरीए।<verse eid="LAM 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4" />दुद्ध पीते बच्‍चां केरि ज़िभ ट्लिशारे मारे तैलू सेइं खतोरीए;</para>
  <para style="q" vid="LAM 4:4">बाल बच्‍चे रोट्टी मघन, पन कोई तैन न दे।<verse eid="LAM 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5" />ज़ैना सुवादे बाली रोट्टी खाते थिये, तैना हुनी सड़कन मां परेशान फिरतन;</para>
  <para style="q" vid="LAM 4:5">ज़ैना मखमलेरे लिगड़न मां पलोरे थिये हुनी कूड़ेरे ढेरन पुड़ लेटतन।<verse eid="LAM 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6" />मेरे लोकां केरि नेगरारो पाप सदोमेरे पापे करां भी जादे भोइ जेव</para>
  <para style="q" vid="LAM 4:6">ज़ै केन्चेरे हथ लानेरे बगैर एक्‍की पले मां उलटोरो थियो।<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="GEN 19:24-25">उत्प. 19:24-25</ref>.</char></note><verse eid="LAM 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7" />यरूशलेम नगरेरे राजकुमार हिंवेरे करां साफ ते दुद्धे करां भी छ़ित्ते थिये;</para>
  <para style="q" vid="LAM 4:7">तैन केरि जान मूँगन करां लाल, ते तैन केरि खूबसूरती नीलमणि केरि ज़ेरि थी।<verse eid="LAM 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8" />पन हुनी केरू रूप आंधरे करां भी कालू आहे, तैन केरि सड़कन मां पिशान न एज्जे;</para>
  <para style="q" vid="LAM 4:8">तैनी केरि चमड़ी हेड्डन सेइं खत्ती, ते लेकड़री ज़ेरि शुक्‍की जेई।<verse eid="LAM 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9" />जंगी मां तलवारारे मारे ढ्लोखोरन करां जादे रोड़े राए</para>
  <para style="q" vid="LAM 4:9">ज़ैन केरे प्राण ऊडारां केरि फसलरे बगैर ढ्लुखी सेइं शुक्‍की गातन।<verse eid="LAM 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10" />दया केरनेबैली कौन्शेइं अपने हथ्थन सेइं अपने बच्‍चे पकाए:</para>
  <para style="q" vid="LAM 4:10">मेरे लोकां केरे विनाशेरे वक्ते तैन केरि खूराक बेनि जे।<verse eid="LAM 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11" />यहोवा अपनो पूरो क्रोध बांदो कियोरोए,</para>
  <para style="q" vid="LAM 4:11">तैने अपनि सरक बड़ी बधाई;</para>
  <para style="q" vid="LAM 4:11">ते सिय्योने मां एरी अग लाई ज़ैस सेइं</para>
  <para style="q" vid="LAM 4:11">तैसेरी बुनीयाद भी भस्म भोइ जेवरीए।<verse eid="LAM 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12" />धेरतरो कोई राज़ो या दुनियारो कोई रानेबालो</para>
  <para style="q" vid="LAM 4:12">इसेरो कोई भी विश्वास न थियो केरि सकतो,</para>
  <para style="q" vid="LAM 4:12">कि बगावत केरनेबाले ते दुश्मन यरूशलेम नगरेरे फाटकां केरे अन्तर एज्जी सकेले।<verse eid="LAM 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13" />इन तैसेरे नेबी केरे पापां ते तैसेरे याजकां केरे अधर्मेरे कम्मां केरे वजाई सेइं भोवरूए;</para>
  <para style="q" vid="LAM 4:13">किजोकि तैना तैसेरे मझ़ाटे धेर्मी केरो कत्ल केरते एवरेन।<verse eid="LAM 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14" />तैना हुनी सड़कन मां काना केरे ज़ेरे दरबदर फिरतन।</para>
  <para style="q" vid="LAM 4:14">ते ज़ेन्च़रे खूनेरी छ़िड़कन सेइं इड़ी तगर अशुद्ध आन</para>
  <para style="q" vid="LAM 4:14">कि कोई तैन केरे लिगड़न सेइं हुरी न सके।<verse eid="LAM 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15" />लोक तैन जो हक देइतां ज़ोतन, “हे अशुद्ध लोकव, दूर भोथ! दूर भोथ! असन सेइं न हुरा।”</para>
  <para style="q" vid="LAM 4:15">ज़ैखन तैना नेशतां दरबदर फिरने लगे,</para>
  <para style="q" vid="LAM 4:15">तैखन गैर कौमां केरे लोकेईं ज़ोवं, “एजने बाले वक्ते मां इड़ी रुकी न बटेले।”<verse eid="LAM 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16" />यहोवा अपने क्रोधे सेइं तैना तितर-बितर किये, तै फिरी तैन पुड़ सिद्धी नज़र न केरेलो;</para>
  <para style="q" vid="LAM 4:16">न त याजकां केरि आदर भोइ, ते न बुज़ुर्गन पुड़ किछ दया कीजेई।<verse eid="LAM 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17" />इश्शी एछ़्छ़ी बेकारे मां मद्दत मगते-मगते कैनी भोइ जेवरिन,</para>
  <para style="q" vid="LAM 4:17">अस लगातार अक एरी कौमरे पासे तकते राए ज़ै बच़ेइ न सके।<verse eid="LAM 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18" />लोकन असन पत्ती एरे पे कि अस अपने नगरेरे चौकन मां भी च़ेलि न सके;</para>
  <para style="q" vid="LAM 4:18">इश्शो अन्त नेड़े एवरोए; इश्शी उमर पूरी भोइ; किजोकि इश्शो अन्त एज्जी जेवरोए थियो।<verse eid="LAM 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19" />असन निशान्ने बाले अम्बरे मां उडरने बाले उकाबन करां भी जादे तेज़ च़लते थिये।</para>
  <para style="q" vid="LAM 4:19">तैना पहाड़न पुड़ असन पत्ती पे ते जंगले मां असन मारनेरे लेई बिश्शे।<verse eid="LAM 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20" />यहोवारो अभिषिक्त राज़ो ज़ै इश्शो प्राण थियो,</para>
  <para style="q" vid="LAM 4:20">ते ज़ेसेरे बारे मां असेईं सोचोरू थियूं कि गैर कौमां केरे दरमियान अस तैसेरे शरणी मां ज़ींते रामेले,</para>
  <para style="q" vid="LAM 4:20">तै तैन केरे घड़ोरे गत्तन मां ट्लाव जेव।<verse eid="LAM 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21" />हे एदोमेरी कुई, तू ज़ै ऊस मुल्खे मां रातिस, खुश ते मघन भो;</para>
  <para style="q" vid="LAM 4:21">पन ई दुखेरो कुटोरो तीं तगर भी पुज़ेलो, ते तू मसत भोइतां अपने आपे नग्गी केरेली।<verse eid="LAM 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22" />हे सिय्योनेरी कुई, तेरे अधर्मेरी सज़ाह खतम भोइ, तै फिरी तीं गुलैमी मां न नेलो।</para>
  <para style="q" vid="LAM 4:22">पन हे एदोमेरी कुई, तेरे अधर्मेरी सज़ाह तै तीं देलो, तै तेरे पाप बांदे केरेलो।<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s">दयारे लेई प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1" />हे यहोवा, याद केर कि असन पुड़ कुन-कुन बीतोरूए;</para>
  <para style="q" vid="LAM 5:1">इश्शे पासे नज़र केरतां इश्शी बदनामी हेर!<verse eid="LAM 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2" />इश्शी विरासत परदेशी केरि भोइ ते इश्शां घरां बखले लोकां केरां भोआं।<verse eid="LAM 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3" />अस अनाथ ते बाजी बगैर भोए;</para>
  <para style="q" vid="LAM 5:3">इश्शी अम्मा विधवा भोइ जेई।<verse eid="LAM 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4" />अस पानी मुल्‍ले घिन्तां पीतम,</para>
  <para style="q" vid="LAM 5:4">असन कैड़ु भी मुल्‍ले मैलतन।<verse eid="LAM 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5" />इश्शे मेट्टन पुड़ जुऊं रेखतां असन करां सखत मेहनत कराई गाती;</para>
  <para style="q" vid="LAM 5:5">अस थेकी जेवरेम, असन आराम न मैल्हे।<verse eid="LAM 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6" />असां एप्पु मिस्रेरे अधीन भोइ जे,</para>
  <para style="q" vid="LAM 5:6">ते अश्शूरेरे भी अधीन भोए, ताके पेट भेरतां रोट्टी खाम।<verse eid="LAM 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7" />इश्शे दादे-पड़दादेईं पाप कियो, ते मेरि जेवरेन;</para>
  <para style="q" vid="LAM 5:7">पन तैन केरे अधर्मेरां कम्मां केरि सज़ाह असां झ़ैल्‍लने लगोरेम।<verse eid="LAM 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8" />असन पुड़ गुलाम अधिकार रखतन;</para>
  <para style="q" vid="LAM 5:8">तैन केरे हथ्थे करां कोई असन न छुटाए।<verse eid="LAM 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9" />जंगले मां तलवारारी वजाई सेइं अस अपने प्राण खतरे मां छ़ेडतां खानेरी चीज़ां आनतम।<verse eid="LAM 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10" />ढ्लुखरे अग्गरे वजाई सेइं,</para>
  <para style="q" vid="LAM 5:10">इश्शी चमड़ी तंदूरेरी ज़ेरि काली भोइ जेवरीए।<verse eid="LAM 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11" />सिय्योने मां कौन्शां,</para>
  <para style="q" vid="LAM 5:11">ते यहूदा प्रदेशेरे नगरन मां दुश्मनेईं कुइयां भ्रष्ट की।<verse eid="LAM 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12" />हाकिम हथ्थां केरे ताकती पुड़ टंगे;</para>
  <para style="q" vid="LAM 5:12">ते बुज़ुर्गां केरि कोई भी आदर न कीजेई।<verse eid="LAM 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13" />इश्शे जुवानन गुलामां केरि ज़ेरि चक्‍की च़लानी पेतीए;</para>
  <para style="q" vid="LAM 5:13">ते बाल बच्‍चे लेकड़रो बोझ छ़ुइतां थरकतन।<verse eid="LAM 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14" />हुनी नगरेरे फाटकन पुड़ बुज़ुर्ग मुकदमां केरो फैसलो केरनेरे लेई न बिश्शन,</para>
  <para style="q" vid="LAM 5:14">न जुवाना केरू गीत शुनोए।<verse eid="LAM 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15" />इश्शे मनेरी खुशी च़ली जेई,</para>
  <para style="q" vid="LAM 5:15">इश्शू नच़नू मातमे मां बेदलोव।<verse eid="LAM 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16" />इश्शे दोग्गे पुड़ेरू ताज झ़ेड़ी जेवं;</para>
  <para style="q" vid="LAM 5:16">असन पुड़ अफ़सोस, किजोकि असेईं पाप कियोरोए!<verse eid="LAM 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17" />इस वजाई सेइं इश्शो दिल कमज़ोर भोइ जेव,</para>
  <para style="q" vid="LAM 5:17">इन्ने गल्‍लन सेइं इश्शी एछ़्छ़ी कैनी भोइ जेई,<verse eid="LAM 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18" />किजोकि सिय्योन पहाड़ उज़ड़ी जेवरूए;</para>
  <para style="q" vid="LAM 5:18">तैस मां गिद्दां घुमतन।<verse eid="LAM 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19" />पन हे यहोवा, तू त हमेशा तगर तखते पुड़ बिशोरो रालो।</para>
  <para style="q" vid="LAM 5:19">तेरू राज़ पीढ़ी-पीढ़ी बनोरू रालू।<verse eid="LAM 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20" />तीं किजो अस हमेशारे लेई बिसरे,</para>
  <para style="q" vid="LAM 5:20">ते किजो बड़े च़िरेरे लेई असां शारे?<verse eid="LAM 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21" />हे यहोवा, असन अपने पासे फेर, तैखन अस फिरी सुधर्मेले।</para>
  <para style="q" vid="LAM 5:21">पुराने ज़मानेरे ज़ेरे इश्शे दिहाड़े बेदलतां ज़ेरे पेइले थिये त तेरहे केर!<verse eid="LAM 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22" />कुन तीं अस बिलकुल शारे?</para>
  <para style="q" vid="LAM 5:22">कुन तू असन सेइं बड़ो क्रोधे आस?<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>