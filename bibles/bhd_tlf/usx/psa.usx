<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id" />
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">भजन संहिता</para>
  <para style="toc1">भजन संहिता</para>
  <para style="toc2">भजन संहिता</para>
  <para style="toc3">भज.</para>
  <para style="mt">भजन संहिता</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">इस किताबी मां बड़ा भजना आन, भजन केरि किताब पुराने नियमेरी किताबन मरां अक्‍के, ज़ैस मां बडे लिखनेबालां केरां भजना आन। इस किताबरे लिखनेबालां केरां नंव्वां इना आन: दाऊद, आसाप, कोरहेरे खानदानेरे लोक, सुलैमान, एतान, हेमान, मूसा ते किछ लिखनेबालां केरां नंव्वां केरो पतो नईं। सुलैमान ते मूसेरे अलावा सब भजनां केरे लिखने बालन मरां या त याजक थी या लेवी थी ज़ैना दाऊद राज़ेरे राज़ केरनेरे वक्ते मां मन्दरे मां आराधनारे लेई संगीतेरे ज़िरिये सेवा केरते थिये।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग 1440-430 ई. पू.</para>
  <para style="ip">व्यक्तिगत भजना इतिहासे मां मूसेरे वक्ते तगर आन ते दाऊद, आसाप, सुलैमान ते एज्रा पंथेरे लोकन तगर आन। इसेरो मतलब ईए कि इस किताबी मां लगभग अक हज़ार सालां केरां भजना आन।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">इस्राएली लोक ते एजने बाले वक्ते मां पवित्रशास्त्र पढ़नेबाले लोकां केरे लेई इन भजना लिखोरन।</para>
  <para style="is">मकसद</para>
  <para style="ip">भजना केरे इना विषय राहोरेन: परमेशर ते तैसेरी सृष्टि, जंग, आराधना, अक्ल, पाप ते बुराई, सज़ाह, न्याय ते मसीहेरू एजनू। भजना पढ़ने बालां केरि हिम्मत बद्धातन कि तैना परमेशर ते तैसेरे कम्मां केरि तारीफ़ केरन। भजना इश्शे परमेशरेरे महान भोनेरे बारे मां ज़ोतन। मुसीबतरे वक्ते तैसेरी वफादारी साबत केरतन ते असन तैसेरे वचने पुड़ ध्यान लानेरे बारे मां याद करातन।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">परमेशरेरी तारीफ़</para>
  <para style="iot">रूपरेखा</para>
  <para style="ip">इस किताबरे पंच़ हिस्से एन्च़रे सेइं आन:</para>
  <para style="io1">पेइलो हिस्सो <char style="ior"><ref loc="PSA 1:1-41:13">1:1—41:13</ref> </char></para>
  <para style="io1">दूइयोवं हिस्सो <char style="ior"><ref loc="PSA 42:1-72:20">42:1—72:20</ref> </char></para>
  <para style="io1">ट्लेइयोवं हिस्सो <char style="ior"><ref loc="PSA 73:1-89:52">73:1—89:52</ref> </char></para>
  <para style="io1">च़ेवरोवं हिस्सो <char style="ior"><ref loc="PSA 90:1-106:48">90:1—106:48</ref> </char></para>
  <para style="io1">पंच़ोंव हिस्सो <char style="ior"><ref loc="PSA 107:1-150:6">107:1—150:6</ref> </char></para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">पेइलो हिस्सो</para>
  <para style="mr">
    <ref loc="PSA 1-41">भज. 1—41</ref></para>
  <para style="s">परमेशरेरे कानूने मां सच़्च़ू सुख</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />केत्रो धने तै मैन्हु ज़ै दुष्ट लोकां केरे सलाही पुड़ न च़ले,</para>
  <para style="q" vid="PSA 1:1">ते न पापी लोकां केरि बत्तन मां खड़ो भोए;</para>
  <para style="q" vid="PSA 1:1">ते मज़ाक बनाने बालां केरि सेंगती मां न बिश्शे!<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />पन तै त यहोवारे कानूने सेइं खुशी भोते;</para>
  <para style="q" vid="PSA 1:2">ते तैसेरे कानूने पुड़ रात दिहैड़ी ध्यान केरतो रहते।<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOS 1:8">यहो. 1:8</ref>.</char></note><verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />तै मैन्हु तैस बुट्टेरो ज़ेरोए, ज़ै बगते पैनेरे गड्डां केरे बन्ने पुड़ लेवरोए</para>
  <para style="q" vid="PSA 1:3">ज़ैस अपने ठीक वक्ते पुड़ फल लगते,</para>
  <para style="q" vid="PSA 1:3">ते ज़ैसेरां पट्लां कधी न शुक्‍कन।</para>
  <para style="q" vid="PSA 1:3">ते ज़ैन किछ तै मैन्हु केरे तैन कामयाब भोते।<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 17:8">यिर्म. 17:8</ref>;<ref loc="PSA 92:12-14">भज. 92:12-14</ref>.</char></note><verse eid="PSA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />दुष्ट लोक एरे न भोन,</para>
  <para style="q" vid="PSA 1:4">पन तैना तैस झ़ाझ़रे ज़ेरे भोतन, ज़ै बात च़लते उडारी गातीए।<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />एल्हेरेलेइ दुष्ट लोक न्यायेरे वक्ते खड़े न रेइ बटेले,</para>
  <para style="q" vid="PSA 1:5">ते न पापी लोक धर्मी लोकां केरे सेंगती मां रेइ सकेले;<verse eid="PSA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />किजोकि यहोवा धर्मी लोकां केरि बत ज़ानते,</para>
  <para style="q" vid="PSA 1:6">पन दुष्ट लोकां केरि बत नाश भोइ गाली।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="PSA 68:2">भज. 68:2</ref>;<ref loc="PSA 73:27">73:27</ref>;<ref loc="PSA 92:9">92:9</ref>.</char></note><verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">परमेशरेरो च़ुनोरो राज़ो</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />कौमां-कौमां केरे लोक<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">कौमां-कौमां केरे लोक </char><char style="ft" closed="false">ज़ैना लोक परमेशरे न ज़ानन</char></note> किजो क्रोधे मां आन,</para>
  <para style="q" vid="PSA 2:1">ते मुल्खां-मुल्खां केरे लोक किजो बुरी योजना बनातन?<verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />यहोवा ते ज़ै तैनी च़ुनोरोए तैसेरे खलाफ दुनियारे राज़े मिलतां,</para>
  <para style="q" vid="PSA 2:2">ते हाकिम एप्पु मांमेइं बुरी योजना बनेइतां ज़ोतन,<verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />एज्जा असां तैन केरे बन्धन ट्लोड़म,</para>
  <para style="q" vid="PSA 2:3">ते तैन केरि रेस्सी एप्पु पुड़ेरां ओसैलतां शारम।<verse eid="PSA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />ते ज़ै सुर्गे मां तखते पुड़ बिशोरोए, तैन केरि नाकाम योजनान पुड़ हस्सेलो,</para>
  <para style="q" vid="PSA 2:4">ते प्रभु तैन केरो मज़ाक बनालो।<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />तैखन तै अपने क्रोधे मां तैन सेइं गल्‍लां केरेलो,</para>
  <para style="q" vid="PSA 2:5">ते एपनी बेड़ी सरकी सेइं तैन डरालो,<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />परमेशर ज़ोते, “मीं त अपनो च़ुनोरो राज़ो,</para>
  <para style="q" vid="PSA 2:6">अपने पवित्र पहाड़ सिय्योनेरे राज़गेद्दी पुड़ ठहरावरोए।”<verse eid="PSA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />अवं तैस वचने बियान केरेलो:</para>
  <para style="q" vid="PSA 2:7">ज़ैन यहोवा मीं सेइं ज़ोवं, “तू मेरू मट्ठू आस,</para>
  <para style="q" vid="PSA 2:7">अज़ मीं तू पैदा कियूं।<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत. 3:17</ref>;<ref loc="MAT 17:5">17:5</ref>;<ref loc="MRK 1:11">मरक. 1:11</ref>;<ref loc="MRK 9:7">9:7</ref>;<ref loc="LUK 9:35">लूक. 9:35</ref>;<ref loc="JHN 1:49">यूह. 1:49</ref>;<ref loc="ACT 13:33">प्रेरित. 13:33</ref>;<ref loc="HEB 1:5">इब्रा. 1:5</ref>;<ref loc="HEB 5:5">5:5</ref>;<ref loc="2PE 1:17">2 पत. 1:17</ref>.</char></note><verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />मीं करां मग, अवं कौमां-कौमां केरे लोकन तेरी विरासत भोनेरे लेई,</para>
  <para style="q" vid="PSA 2:8">ते दूर-दूरेरे मुल्खन तेरी मलकीत बन्नेरे लेई देइलो।<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="HEB 1:2">इब्रा. 1:2</ref>.</char></note><verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />तू तैन लोंहेरे सोटे सेइं टुक्ड़े-टुक्ड़े केरेलो।</para>
  <para style="q" vid="PSA 2:9">कुम्हारेरे भांडां केरो ज़ेरो तू तैन चूर-चूर केरेलो।”<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:27">प्रका. 2:27</ref>;<ref loc="REV 12:5">12:5</ref>;<ref loc="REV 19:15">19:15</ref>.</char></note><verse eid="PSA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />एल्हेरेलेइ हुनी, हे राज़व, अक्लमन्द बना;</para>
  <para style="q" vid="PSA 2:10">हे धेरती पुड़ हुकूमत केरनेबालव, खबरदार राथ।<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />डरते-डरते यहोवारी सेवा केरा,</para>
  <para style="q" vid="PSA 2:11">ते थरकते-थरकते खुशी मनाथ।<verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />तैसेरे मट्ठे कां झुका, एरू न भोए, कि तैस सरक एज्जे,</para>
  <para style="q" vid="PSA 2:12">ते तुस बत्ती मां नाश भोइ गाथ,</para>
  <para style="q" vid="PSA 2:12">किजोकि परमेशरेरो क्रोध लूशी भड़कने बालोए,</para>
  <para style="q" vid="PSA 2:12">धन तैना आन ज़ैना तैसेरी शरण नेतन।<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">मुसीबतरे वक्ते भरोसो</para>
  <para style="d">दाऊदेरू भजन ज़ैखन तै अपने मट्ठे अबशालोमेरे सामनेरां नश्शोरो थियो,</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1" />हे यहोवा मेरे सतानेबाले केत्रे बेधी जेवरेन!</para>
  <para style="q" vid="PSA 3:1">तैना ज़ैना मेरे खलाफ खड़े भोतन तैना हछ्छे आन।<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2" />बड़े ज़ने मेरे बारे मां ज़ोतन,</para>
  <para style="q" vid="PSA 3:2">कि तैसेरी रक्षा परमेशरेरी तरफां न भोइ सके। (सेला<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">सेला </char><char style="ft" closed="false">संगीत विराम</char></note>)<verse eid="PSA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3" />पन हे यहोवा, तू त मेरे च़ेवरे पासन मेरी ढाल आस,</para>
  <para style="q" vid="PSA 3:3">मेरी महिमा ते मेरी क्रोड़ी उच्‍ची केरने बालोस।<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4" />अवं बड़े ज़ोरे सेइं यहोवा कां बिनती केरताईं,</para>
  <para style="q" vid="PSA 3:4">ते तै मीं अपने पवित्र पहाड़े<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="fq" closed="false">पवित्र पहाड़े </char><char style="ft" closed="false">सिय्योन</char></note> पुड़ेरां जुवाब देते। (सेला)<verse eid="PSA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5" />अवं राती लेटतां झ़ुल्‍ली जेव;</para>
  <para style="q" vid="PSA 3:5">ते फिरी झ़ेझ़ां बींझ़ी जेव, किजोकि यहोवा मीं सम्भालते।<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6" />अवं तैन हज़ारेईं दुश्मन्न करां न डेरि,</para>
  <para style="q" vid="PSA 3:6">ज़ैना च़ेवरे पासना मेरे खलाफ खड़े भोतन।<verse eid="PSA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7" />उठ, हे यहोवा! हे मेरे परमेशर मीं बच़ा!</para>
  <para style="q" vid="PSA 3:7">किजोकि तीं मेरे सब दुश्मना केरे ज़ैमोड़ी पुड़ बावरीए।</para>
  <para style="q" vid="PSA 3:7">ते तीं दुष्टां केरे दंत ट्लोड़ोरेन।<verse eid="PSA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8" />मुक्ति<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fq" closed="false">मुक्ति </char><char style="ft" closed="false">ज़ींत</char></note> यहोवारी तरफां भोचे;</para>
  <para style="q" vid="PSA 3:8">हे यहोवा तेरे लोकन पुड़ तेरी बरकत बनोरी राए!<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">परमेशरे पुड़ भरोसो</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई: तारीबाले बाज़न सेइं साथी। दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1" />हे मेरे धर्मी परमेशर, ज़ैखन अवं तीं कां बिनती केरीं, त तू मीं जुवाब दे;</para>
  <para style="q" vid="PSA 4:1">ज़ैखन अवं तेंगी मां पेव तैखन तीं मीं सहारो दित्तो।</para>
  <para style="q" vid="PSA 4:1">मीं पुड़ दया केर ते मेरी प्राथना शुन।<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2" />हे मैन्हव, तुस केइस तगर मेरी महिमारे बदले बेइज़्ज़ती केरेले?</para>
  <para style="q" vid="PSA 4:2">तुस केइस तगर बेकार गल्‍लन सेइं प्यार केरेले, ते झूठे योजना<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="fq" closed="false">झूठे योजना </char><char style="ft" closed="false">झूठे ईश्वर</char></note> केरि तलाशी मां राले। <char style="qs">(सेला)</char><verse eid="PSA 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3" />याद रखा कि यहोवा वफादार दास अपने लेई अलग केरतां रखोरोए;</para>
  <para style="q" vid="PSA 4:3">ज़ैखन अवं यहोवा कां प्राथना केरि तैखन तै शुनेलो।<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4" />डरे सेइं थरकते राथ ते पाप न केरा;</para>
  <para style="q" vid="PSA 4:4">अपने-अपने बिछ़ाने पुड़ मने मां सोचा ते च़ुपच़ाप राथ।<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">इफि. 4:26</ref>.</char></note> <char style="qs">(सेला) </char><verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5" />धार्मिकतारू बलिदान च़ाढ़ा,</para>
  <para style="q" vid="PSA 4:5">ते यहोवा पुड़ भरोसो रखा।<verse eid="PSA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6" />बड़े आन ज़ैना ज़ोतन, “कौन असन किछ भलियाई हिरालो?”</para>
  <para style="q" vid="PSA 4:6">हे यहोवा, तू अपने तुत्तरेरी लौ असन पुड़ चमका!<verse eid="PSA 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7" />तीं मेरे दिले मां तैस करां जादे खुशी भरोरीए,</para>
  <para style="q" vid="PSA 4:7">ज़ै तैन्न अन्न ते दाछ़रे रस बड़े जादे भोने सेइं भोतीए।<verse eid="PSA 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8" />अवं सुखे सेइं लेटी गालो ते झ़ुल्‍ली गालो;</para>
  <para style="q" vid="PSA 4:8">किजोकि, हे यहोवा, सिर्फ तूए मीं सुरक्षित ते बे फिक्र राने देतस।<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">बत हिरानेरी प्राथना</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई: बेंशोई बज़ेइतां दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1" />हे यहोवा, मेरी गल्‍लन पुड़ ध्यान दे;</para>
  <para style="q" vid="PSA 5:1">मेरे करलाने पुड़ ध्यान दे।<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2" />हे मेरे परमेशर राज़ा, मेरी बिनती पुड़ ध्यान दे,</para>
  <para style="q" vid="PSA 5:2">किजोकि अवं तींए कां प्राथना केरताईं।<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3" />हे यहोवा, तू झ़ेज़्झ़ां मेरी प्राथनारी आवाज़ शुनेलो,</para>
  <para style="q" vid="PSA 5:3">अवं झ़ेज़्झ़ां तीं कां प्राथना केरतां बलगतो रालो।<verse eid="PSA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4" />किजोकि तू एरहो परमेशर आस, कि ज़ै बुरैई सेइं खुशी न भोस;</para>
  <para style="q" vid="PSA 5:4">बुरे लोक तीं सेइं साथी न रेइ सखन।<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5" />घमण्डी तेरे सामने खड़े न भोइ सकेले;</para>
  <para style="q" vid="PSA 5:5">तीं सेभी बुरे लोकन सेइं नफरते।<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6" />तू तैन नाश केरेलो ज़ैना झूठ ज़ोतन;</para>
  <para style="q" vid="PSA 5:6">यहोवा खून केरनेबालन ते धोखो देनेबालन सेइं नफरत केरते।<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7" />पन अवं त तेरी बड़ी दयारे वजाई सेइं तेरे भवने मां एज्जेलो,</para>
  <para style="q" vid="PSA 5:7">अवं तेरो डर मेनतां तेरे पवित्र मन्दरेरे पासे मथ्थो टेकेलो।<verse eid="PSA 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8" />हे यहोवा, मेरे दुश्मना केरे वजाई सेइं, एपनी धार्मिकतारे बत्तां मीं च़ला;</para>
  <para style="q" vid="PSA 5:8">मीं अग्री-अग्री अपनि सिद्धी बत हिरा।<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9" />किजोकि तैन केरे ऐशी मां किछ भी सच़ नईं;</para>
  <para style="q" vid="PSA 5:9">तैन केरे मने मां सिर्फ दुष्टे।</para>
  <para style="q" vid="PSA 5:9">तैन केरू गल खुल्‍ली कब्रे,</para>
  <para style="q" vid="PSA 5:9">तैना अपने ज़बानी सेइं मिट्ठी-मिट्ठी गल्‍लां केरतन।<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 3:13">रोम. 3:13</ref>.</char></note><verse eid="PSA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10" />हे परमेशर, तू तैन दोषी ठहरा;</para>
  <para style="q" vid="PSA 5:10">तैना अपने योजनान सेइं एप्पु बिछ़ड़न;</para>
  <para style="q" vid="PSA 5:10">तैन केरे पापां केरे वजाई सेइं तैन बेइर केढी छ़ड,</para>
  <para style="q" vid="PSA 5:10">किजोकि तैनेईं तेरे खलाफ बगावत कियोरीए।<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11" />पन तैना सब, ज़ैना तीं मां शरण नेतन, तैना सब खुश भोन,</para>
  <para style="q" vid="PSA 5:11">तैना सदा ज़ोरे-ज़ोरे सेइं गीतां ज़ोंते रान; किजोकि तू तैन बच़ेइतां रखतस,</para>
  <para style="q" vid="PSA 5:11">ते ज़ैना तेरे नंव्वे सेइं प्यार रखतन तीं मां खुश भोल्हे।<verse eid="PSA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12" />किजोकि तू सच़्च़े लोकन बरकत देलो; हे यहोवा,</para>
  <para style="q" vid="PSA 5:12">तू तैस ढालरो ज़ेरो अपने कृपाई सेइं घेरतां रखतस।<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">दयारे लेई प्राथना</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई: तारीबाले बाज़े सेइं। खर्ज रागे मां, दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1" />हे यहोवा, तू मीं अपने क्रोधे मां न डांट,</para>
  <para style="q" vid="PSA 6:1">ते न बड़े सरकी मां मीं सज़ाह दे।<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2" />हे यहोवा, मीं पुड़ दया केर, किजोकि अवं अधमरो भोइ जेवरोईं,</para>
  <para style="q" vid="PSA 6:2">हे यहोवा, मीं बज़्झ़ा, किजोकि मेरी हेड्डन मां चैन नईं।<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3" />मेरो प्राण भी बड़ो दुखी आहे,</para>
  <para style="q" vid="PSA 6:3">ते हे यहोवा, केइस तगर अवं मद्दतरे लेई इंतज़ार केरि?<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">यूह. 12:27.</char></note><verse eid="PSA 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4" />वापस एई, हे यहोवा, मेरे प्राण बच़ा;</para>
  <para style="q" vid="PSA 6:4">अपने दयारे खातर मीं छुटकारो दे।<verse eid="PSA 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5" />किजोकि मरनेरे बाद कोन्ची भी तेरी याद न भोए,</para>
  <para style="q" vid="PSA 6:5">कब्री मां कौन तेरी शुक्रगुज़ारी केरेलो?<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6" />अवं करलाते-करलाते थेकी जेव;</para>
  <para style="q" vid="PSA 6:6">अवं अपनि खट ऐंखरेईं सेइं सेलताईं;</para>
  <para style="q" vid="PSA 6:6">हर राती मेरू बिछ़ान सिज़ते।<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7" />मेरी एछ़्छ़ी दुखेरे मारे बिश्शी गेइचन,</para>
  <para style="q" vid="PSA 6:7">ते मेरे सब सताने बालां केरे वजाई सेइं कमज़ोर भोइ जेई।<verse eid="PSA 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8" />हे सब अनर्थ केरने बालाव, मीं करां दूर भोथ;</para>
  <para style="q" vid="PSA 6:8">किजोकि यहोवा मेरी लेरां केरि आवाज़ शुनोरीए।<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">मत. 7:23</ref>;<ref loc="LUK 13:27">लूक. 13:27</ref>.</char></note><verse eid="PSA 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9" />यहोवाए मेरी बिनती शुनोरीए,</para>
  <para style="q" vid="PSA 6:9">यहोवा मेरी प्राथना कबूल भी केरेलो।<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10" />मेरे सब दुश्मन सते बड़े जादे घबराले;</para>
  <para style="q" vid="PSA 6:10">तैना हारेले ते वापस गाले, ते अचानक शरमिन्दा भोल्हे।<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">न्यायेरे लेई प्राथना</para>
  <para style="d">दाऊदेरू शिग्गोन नंव्वेरू भजन ज़ैन बिन्यामीनी कूशेरे गल्‍लां केरे वजाई सेइं यहोवारे सामने ज़ोवं</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1" />हे मेरे यहोवा परमेशर, मेरो भरोसो तीं पुड़े,</para>
  <para style="q" vid="PSA 7:1">सब पीछो केरनेबालन करां तू मीं बच़ा ते छुटकारो दे,<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2" />एरू न भोए कि तैना शेरेरे ज़ेरे,</para>
  <para style="q" vid="PSA 7:2">मीं छ़िन्दतां टुक्ड़े-टुक्ड़े केरन;</para>
  <para style="q" vid="PSA 7:2">ते कोई मीं छुटानेबालो न भोए।<verse eid="PSA 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3" />हे मेरे परमेशर यहोवा, अगर मीं एन कियोरू भोए,</para>
  <para style="q" vid="PSA 7:3">ते अगर मेरे हथ्थन सेइं बुराई भोवरी भोए।<verse eid="PSA 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4" />अगर मीं अपने मेल रखनेबालन सेइं भलियाई केरनेरे बदले बुराई कियोरी भोए,</para>
  <para style="q" vid="PSA 7:4">बल्के ज़ै बगैर वजा मेरो दुश्मने लुटोरो भोए।<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5" />त दुश्मन मेरी जानरो पीछो केरतां मीं ट्लाए,</para>
  <para style="q" vid="PSA 7:5">ते मेरे प्राण मित्ती पुड़ ढ्लेन्च़े,</para>
  <para style="q" vid="PSA 7:5">ते मीं बेइज़्ज़त केरतां मित्ती मां मिलाए। <char style="qs">(सेला) </char><verse eid="PSA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6" />हे यहोवा अपने क्रोधे मां उठ;</para>
  <para style="q" vid="PSA 7:6">क्रोधे सेइं भेरतां मेरे सताने बालां केरे खलाफ तू खड़ो भो;</para>
  <para style="q" vid="PSA 7:6">ते मेरे लेई बींझ़! तीं न्यायेरो हुक्म दित्तोरोए।<verse eid="PSA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7" />च़ेवरे पासन मुल्खां-मुल्खां केरे लोक अकोट्ठे भोन;</para>
  <para style="q" vid="PSA 7:7">तू फिरी तैन पुड़ उच्‍चे पुड़ेरां राज़ केर।<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8" />यहोवा कौमां-कौमां केरे लोकां केरो न्याय केरते;</para>
  <para style="q" vid="PSA 7:8">हे यहोवा मेरी धार्मिकता ते सच़्च़ेरे मुताबिक मेरो न्याय केर।<verse eid="PSA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9" />कधे एरू भोए कि दुष्टां केरि बुरैइयरो खातमो भोए, पन धेर्मी तू बच़ेइतां रख;</para>
  <para style="q" vid="PSA 7:9">किजोकि धर्मी परमेशर मन ते दिलेरो परखने बालोए।<verse eid="PSA 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10" />मेरी ढाल परमेशरेरे हथ्थे मांए,</para>
  <para style="q" vid="PSA 7:10">तै सच़्च़े मने बालन बच़ाते।<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11" />परमेशर धर्मी ते न्याय केरनेबालोए,</para>
  <para style="q" vid="PSA 7:11">बल्के एरहो परमेशरे, ज़ै रोज़ क्रोध केरते।<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12" />अगर मैन्हु बाज़ न एज्जे त तै अपनि तलवार पलेइतां रखेलो;</para>
  <para style="q" vid="PSA 7:12">ते जंगरे लेई अपनु धनुष तियार केरेलो।<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 13:3-5">लूक. 13:3-5</ref>.</char></note><verse eid="PSA 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13" />ते तैस मैन्हेरे लेई मौतरे हथियार भी तियार केरतां रखोरेन:</para>
  <para style="q" vid="PSA 7:13">तै अपने तीरन अग्गरे बनाते।<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14" />हेरा तैस दुष्टे बुरे कम्मेरी तकलीफ भोइ राहोरीए,</para>
  <para style="q" vid="PSA 7:14">तैस बुरैइारू गर्भे, ते तैस करां झूठ पैदा भोवं।<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15" />तैनी होरि केरे लेई गत घेड़तां डुग्घू कियोरूए,</para>
  <para style="q" vid="PSA 7:15">ते ज़ै खाई तैने बनेवरी थी तैस मां तै एप्पु बिछ़ड़ो।<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16" />तैसेरी बुराई उलटी तैसेरे दोग्गे पुड़ एज्जेली,</para>
  <para style="q" vid="PSA 7:16">तैसेरो ज़ुलम तैस्सेरे कुपाए पुड़ पेलो।<verse eid="PSA 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17" />अवं यहोवारे धार्मिकतारे मुताबिक तैसेरू शुक्र केरेलो,</para>
  <para style="q" vid="PSA 7:17">ते परमप्रधान यहोवारे नंव्वेरू भजन ज़ोइलो।<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">परमेशरेरी महिमा ते मैन्हेरी इज़्ज़त</para>
  <para style="d">प्रधान बज़ानेबालां केरे लेई गित्तीतेरे रागे पुड़ दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1" />हे यहोवा इश्शे प्रभु, तेरू नवं सारे ज़मीनी पुड़ बड़ू महाने!</para>
  <para style="q" vid="PSA 8:1">तीं अपनि महिमा सुर्गे मां हिरेवरीए।<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2" />तीं अपने दुशमनां केरे वजाई सेइं बच्‍चे ते दुद्ध पीते बच्‍चां केरे ज़िरिये अपनि तारीफ़ करावरीए,</para>
  <para style="q" vid="PSA 8:2">ताके तू दुश्मन्न ते बदलो नेनेबालन रोकी सकस।<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">मत. 21:16</ref>.</char></note><verse eid="PSA 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3" />ज़ैखन अवं अम्बरे, ज़ैन तीं अपने हथ्थन सेइं बनेवरूए,</para>
  <para style="q" vid="PSA 8:3">ते चाँदनी ते तारे हेरताईं ज़ैना तीं ठहराए;<verse eid="PSA 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4" />त फिरी मैन्हु कुने कि तू तैस याद रख्खस,</para>
  <para style="q" vid="PSA 8:4">ते मैन्हु कुने कि तू तैसेरी खबर नेस?<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="PSA 144:3">भज. 144:3</ref>;<ref loc="JOB 7:17-18">अय्यू. 7:17-18</ref>.</char></note><verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5" />किजोकि तीं तै परमेशरे करां थोड़ो ज़ेरो घट बनेवरोए,</para>
  <para style="q" vid="PSA 8:5">ते महिमा ते इज़्ज़तरू मुकुट तैसेरे दोग्गे पुड़ रखोरूए।<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6" />तीं इन्सानेरे हथ्थां केरे कम्मन पुड़ अधिकार दित्तोरोए;</para>
  <para style="q" vid="PSA 8:6">तीं सब किछ तैसेरे पव्वन हैठ कियोरूए।<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="1CO 15:27">1 कुरि. 15:27</ref>;<ref loc="EPH 1:22">इफि. 1:22</ref>;<ref loc="HEB 2:6-8">इब्रा. 2:6-8</ref>;<ref loc="ACT 17:31">प्रेरित. 17:31</ref>.</char></note><verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7" />सब भैड्डां-छ़ेल्‍ली ते बेछ़ी-दांत</para>
  <para style="q" vid="PSA 8:7">ते ज़ेत्रे जंगलेरे जानबर आन,<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8" />अम्बरेरां च़ुड़ोलू ते समुन्दरेरी मेछ़ली,</para>
  <para style="q" vid="PSA 8:8">ते ज़ेत्रे जीप-जन्तू समुन्दरन मां च़लते फिरतन।<verse eid="PSA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9" />हे यहोवा, हे इश्शे प्रभु,</para>
  <para style="q" vid="PSA 8:9">तेरू नवं सारे धेतरी पुड़ बड़ू महाने।<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">ज़ींत देनेरे लेई शुक्र</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई मुतलबैयनेरे रागे पुड़ दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1" />हे यहोवा अवं पूरे दिले सेइं तेरू शुक्र केरेलो;</para>
  <para style="q" vid="PSA 9:1">ते अवं तेरे सब चमत्कारेरे कम्मां केरे बारे मां ज़ोइलो।<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2" />अवं तेरे वजाई सेइं खुश ते मघन भोल्हो,</para>
  <para style="q" vid="PSA 9:2">हे परमप्रधान परमेशर, अवं तेरे नंव्वेरू भजन ज़ोइलो।<verse eid="PSA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3" />मेरे दुश्मन हैरतां पत्रोवं बेदलोले,</para>
  <para style="q" vid="PSA 9:3">तैना तेरे सामनेरां ठोकर खेइतां नाश भोतन।<verse eid="PSA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4" />किजोकि तीं मेरे मुकदमेरो फैसलो मेरे हक्‍के मां कियोरोए;</para>
  <para style="q" vid="PSA 9:4">ते अपने तखते पुड़ बिशतां धार्मिकतारे मुताबिक मेरो न्याय कियोरोए।<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5" />तीं अक-अक कौम<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="fq" closed="false">अक-अक कौम </char><char style="ft" closed="false">तैना कौमां ज़ैना परमेशरेरे न ज़ानन</char></note> झ़िड़की ते बुरे लोक नाश कियोरेन;</para>
  <para style="q" vid="PSA 9:5">तीं तैन केरू नवं हमेशारे लेई मिटेइतां छ़डेरूए।<verse eid="PSA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6" />दुश्मन हमेशारे लेई बरबाद भोए;</para>
  <para style="q" vid="PSA 9:6">ते तैन केरां नगरां तीं बुछ़ोड़ां,</para>
  <para style="q" vid="PSA 9:6">ते तैन केरू नवं ते निशान मिटी जेवरूए।<verse eid="PSA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7" />पन यहोवा हमेशारे लेई अपनो तखत तियार कियोरोए,</para>
  <para style="q" vid="PSA 9:7">तैनी अपनो तखत न्यायेरे लेई तियार कियोरोए;<verse eid="PSA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8" />ते तै सच़्च़ैई सेइं दुनियारो न्याय केरेलो,</para>
  <para style="q" vid="PSA 9:8">ते सच़्च़ैई सेइं मुल्खां-मुल्खां केरे लोकां केरो न्याय केरेलो।<verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9" />यहोवा तैन लोकां केरे लेई अक उच्‍चो क़िलो ठहरेलो ज़ैन पुड़ ज़ुलम भोते,</para>
  <para style="q" vid="PSA 9:9">तै मुसीबतरे वक्ते मां उच्‍चो क़िलो ठहरेलो।<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10" />ते ज़ैना तेरू नवं ज़ानतन, तीं पुड़ भरोसो रखेले,</para>
  <para style="q" vid="PSA 9:10">किजोकि हे यहोवा, तीं एप्पु कां एजने बाले कधी नईं शारोरे।<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11" />यहोवा ज़ै सिय्योने मां तखते पुड़ बिशोरोए, तैसेरू भजन ज़ोथ!</para>
  <para style="q" vid="PSA 9:11">कौमां-कौमां केरे लोकन मां तैसेरे बड्डे-बड्डे कम्मां केरो प्रचार केरा।<verse eid="PSA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12" />किजोकि खूनेरो बदलो नेनेबालो तैस याद रखते;</para>
  <para style="q" vid="PSA 9:12">तै गरीबां केरि बिनती कधे न बिसरे।<verse eid="PSA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13" />हे यहोवा, मीं पुड़ दया केर। हेर, मेरे दुश्मन मीं पुड़ ज़ुलम केरने लगोरेन,</para>
  <para style="q" vid="PSA 9:13">तूए मौतरे फाटकन मरां मीं बच़ेइ सकतस।<verse eid="PSA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14" />ताके अवं सिय्योनेरे फाटके<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="fq" closed="false">सिय्योनेरे फाटके </char><char style="ft" closed="false">यरूशलेमेरे लोकां केरे सामने</char></note> कां तेरे गुणा केरू बियान केरीं,</para>
  <para style="q" vid="PSA 9:14">ते तेरे दित्तोरे छुटकारे सेइं मघन भोईं।<verse eid="PSA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15" />गैर कौमेईं ज़ै खड्डो घड़ोरो थियो, तैस्से मां तैना एप्पु बिछ़ड़न;</para>
  <para style="q" vid="PSA 9:15">ज़ैन ज़ाल तैनेईं लेवरू थियूं, तैस मां तैन्ना केरो पव फेसी जेव।<verse eid="PSA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16" />यहोवा अपनो आप बांदो कियो, तैने न्याय कियो;</para>
  <para style="q" vid="PSA 9:16">दुष्ट अपने कियोरे कम्मन मां फेसी गाते। (हिग्गायोन <note caller="+" style="f"><char style="fr" closed="false">9:16 </char><char style="fq" closed="false">हिग्गायोन </char><char style="ft" closed="false">ध्यान</char></note> <char style="qs">सेला) </char><verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17" />दुष्ट पाताले मां वापस गालो,</para>
  <para style="q" vid="PSA 9:17">ते कने तैना सब कौमां भी ज़ैना परमेशरे बिसरी गैतिन।<verse eid="PSA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18" />किजोकि ज़रूरतमन्द लोक हमेशा तगर बिसरोरोए न राले,</para>
  <para style="q" vid="PSA 9:18">ते न त हलीम लोकां केरि उमीद हमेशारे लेई नाश भोए।<verse eid="PSA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19" />हे यहोवा उठ, मैन्हु प्रबल न भोइ सके!</para>
  <para style="q" vid="PSA 9:19">कौमां केरो न्याय तेरे सामने कियो गाए।<verse eid="PSA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20" />हे यहोवा, तैन डरा!</para>
  <para style="q" vid="PSA 9:20">कौमां अपने आपे सिर्फ मैन्हु समझ़न। <char style="qs">(सेला) </char><verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">न्यायेरे लेई प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />हे यहोवा, तू किजो दूर खड़ो रहतस?</para>
  <para style="q" vid="PSA 10:1">मेरे मुसीबतरे दिहाड़े तू किजो छ़ेप्पी गातस?<verse eid="PSA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />दुष्टां केरे ते घमण्डेरे वजाई सेइं हलीम मैन्हु पुड़ ज़ुलम भोतन;</para>
  <para style="q" vid="PSA 10:2">तैना अपने बनेवरे योजनान मां फेसी गान।<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />किजोकि दुष्ट एपनी इच्छाई पुड़ घमण्ड केरते,</para>
  <para style="q" vid="PSA 10:3">ते लालच़ी मैन्हु यहोवा शैरी देते ते तैसेरी निन्दा केरते।<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />दुष्ट अपने घमण्डे मां परमेशरे न तोप्पे;</para>
  <para style="q" vid="PSA 10:4">तैसेरो पूरो खियाल ईए आहे कि कोई परमेशर अथ्थी नईं।<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />तै दुष्ट एपनी बत्ती पुड़ पक्‍को टिकोरो रहते;</para>
  <para style="q" vid="PSA 10:5">तेरे धार्मिकतारे नियम तैसेरी नज़री करां बड़े दूर उच्‍चे पुड़न,</para>
  <para style="q" vid="PSA 10:5">ज़ेत्रे तैसेरी बगावत केरनेबालेन तैन पुड़ तै हसते।<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />दुष्ट अपने दिले मां ज़ोते कि “अवं कधे न हेटी;</para>
  <para style="q" vid="PSA 10:6">पीढ़ी करां पीढ़ी तगर कधे दुख मीं पुड़ न एज्जेलो।”<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />तैसेरू आशी लानती ते दगे बैज़ी ते ज़ुलमे सेइं भेरतांए;</para>
  <para style="q" vid="PSA 10:7">शरारत ते बुराई तैसेरे ज़बानी पुड़े।<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">रोम. 3:14</ref>.</char></note><verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />तै ड्लाव्वन मां छ़ेपतां मारनेरे लेई बिशते,</para>
  <para style="q" vid="PSA 10:8">ते छ़ेपोरी ठारन मां बेकसूरन मारते,</para>
  <para style="q" vid="PSA 10:8">तैसेरी एछ़्छ़ी मजबूर मैन्हु मारनेरे लेई लेगोरी रैतिन।<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />तै शेरेरो ज़ेरो झ़ैल्‍ले मां छ़ेपतां मारनेरे लेई बिशते;</para>
  <para style="q" vid="PSA 10:9">तै गरीबे ट्लानेरे लेई मारनेरे लेई बिशते,</para>
  <para style="q" vid="PSA 10:9">तै गरीबे जाले मां फसेइतां ट्लाते।<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />तै लाचार लोकन ढ्लन्च़ते ते झ़ुसतो गाते।</para>
  <para style="q" vid="PSA 10:10">तै तैसेरे मज़बूत जाले मां बिछ़ड़तो गाते।<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />तै अपने मने मां सोचते, “परमेशरे बिसरोरूए,</para>
  <para style="q" vid="PSA 10:11">तै अपनु तुत्तर छ़ुपाते; तै कधी न लाहेलो।”<verse eid="PSA 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />उठ, हे यहोवा; हे परमेशर, अपनो हथ खड़ो केर ते न्याय केर;</para>
  <para style="q" vid="PSA 10:12">ते ढ्लेन्च़ोरे लोकन न बिस्सर।<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />परमेशरे दुष्ट किजो घटिया समझ़ते,</para>
  <para style="q" vid="PSA 10:13">ते अपने दिले मां ज़ोते, “तू हिसाब न नेलो?”<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />तीं हेरोरूए, ज़रूर तीं दुखन ते तकलीफन पुड़ ध्यान दित्तोरूए, ताके अपने हथेइं सेइं बदलो देस;</para>
  <para style="q" vid="PSA 10:14">बे सहारो अपने आपे तेरे सुपुर्द केरते;</para>
  <para style="q" vid="PSA 10:14">अनाथां केरो तूए मद्दत केरनेबालो आस।<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />बुरे ते दुष्टेरी पाखड़ ट्लोड़ी छ़ड;</para>
  <para style="q" vid="PSA 10:15">तैन केरे बुरैइयरो लेखो ने, ज़ैखन तगर कि सब बुराई तैस मरां दूर न भोइ गाए।<verse eid="PSA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />यहोवा हमेशारे लेई महाराज़ोए;</para>
  <para style="q" vid="PSA 10:16">यहोवारे मुल्खे मां दुष्ट लोक नाश भोतन।<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ROM 11:26-27">रोम. 11:26-27</ref>.</char></note><verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />हे यहोवा, तीं हलीम लोकां केरि इच्छा<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="fq" closed="false">इच्छा </char><char style="ft" closed="false">प्राथना</char></note> शुनोरीए</para>
  <para style="q" vid="PSA 10:17">तू तैन केरो दिल तियार केरेलो, ते तू ध्याने सेइं शुनेलो।<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />कि अनाथ ते ढ्लन्च़ोरां केरो न्याय केरस,</para>
  <para style="q" vid="PSA 10:18">ताके मैन्हु ज़ै मित्ती सेइं बनोरोए फिरी होरन न डरेई बटे।<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">परमेशरे पुड़ भरोसो</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1" />मीं सुरक्षारे लेई यहोवा पुड़ भरोसोए;</para>
  <para style="q" vid="PSA 11:1">तुस किजो मीं सेइं ज़ोतथ, कि</para>
  <para style="q" vid="PSA 11:1">“च़ुड़ोलोवेरो ज़ेरो अपने पहाड़े पुड़ जो उडरी गा;”<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />किजोकि हेरा, दुष्ट धनुषे पुड़ तीर च़ाढ़तन,</para>
  <para style="q" vid="PSA 11:2">ते तैना तीर धनुषेरे डोरी पुड़ रखतन,</para>
  <para style="q" vid="PSA 11:2">ताके आंधरे मां सच़्च़े लोकन पुड़ च़लान।<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />अगर मुनीयादां पुट्टी<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">मुनीयादां पुट्टी </char><char style="ft" closed="false">समाजे मां कानूनेरी बुनीयाद</char></note> गान</para>
  <para style="q" vid="PSA 11:3">त धर्मी कुन केरि सकते?<verse eid="PSA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />यहोवा अपने पवित्र भवने मांए;</para>
  <para style="q" vid="PSA 11:4">यहोवारो तखत सुर्गे मांए;</para>
  <para style="q" vid="PSA 11:4">तै हर एक्‍की मैन्हु लगातार तकते</para>
  <para style="q" vid="PSA 11:4">ते तैसेरी एछ़्छ़ी तैन पेरखितन।<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />यहोवा धर्मी ते दुष्टे दूईयन परखते,</para>
  <para style="q" vid="PSA 11:5">पन ज़ैना ज़ुलमे सेइं प्यार रखतन</para>
  <para style="q" vid="PSA 11:5">तैन सेइं तै नफरत केरते।<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />तै दुष्टन पुड़ अग ते गन्धक बखालो;</para>
  <para style="q" vid="PSA 11:6">ते बड़ी लूह तैन केरे कुटोरे मां बंटी गाली।<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />किजोकि यहोवा धर्मीए,</para>
  <para style="q" vid="PSA 11:7">तै धार्मिकतारे कम्मन पसंद केरते;</para>
  <para style="q" vid="PSA 11:7">ते धर्मी मैन्हु तैसेरू दर्शन केरेले।<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">दुष्टेरे ज़िरिये ज़ुलम ते परमेशरेरे ज़िरिये कायम कियूं गानू</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई खर्ज रागे पुड़ दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1" />हे यहोवा, इश्शी मद्दत केर, किजोकि कोई भी भक्त नईं राहोरो;</para>
  <para style="q" vid="PSA 12:1">ते ईमानदार लोक गाईब भोइ जेवरेन।<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2" />हर मैन्हु अपने-अपने पुड़ोसन सेइं झूठी गल्‍लां ज़ोते;</para>
  <para style="q" vid="PSA 12:2">तैना ओठन सेइं चापलूसी ते दोगली गल्‍लां केरतन।<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3" />यहोवा सेभी झूठी ज़िभन</para>
  <para style="q" vid="PSA 12:3">ज़ैन सेइं बेड़ि-बेड़ि गल्‍लां निस्चन केट्टी छ़डेलो।<verse eid="PSA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4" />तैना ज़ोतन, “असां अपने ज़िभी सेइं ज़ींतमेले,</para>
  <para style="q" vid="PSA 12:4">इश्शे ओठ इश्शे बस्से मां आन; इश्शो मालिक कौने?”<verse eid="PSA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5" />गरीबां केरे लुट्टोने ते गरीबां केरे कर लानेरे वजाई सेइं,</para>
  <para style="q" vid="PSA 12:5">यहोवा ज़ोते, “हुनी अवं खड़ो भोइलो, ते ज़ैस जो</para>
  <para style="q" vid="PSA 12:5">तैना ज़ोतन तैस चैन ते आराम देलो।”<verse eid="PSA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6" />यहोवारू वचन पवित्रे,</para>
  <para style="q" vid="PSA 12:6">तैस चैंदरे बराबर ज़ै भेट्ठरी मित्ती मां तेवरी भोए</para>
  <para style="q" vid="PSA 12:6">ते सत्ते फेरेईं साफ कियोरी भोए।<verse eid="PSA 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7" />हे यहोवा तूए तैन केरि<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="fq" closed="false">तैन केरि </char><char style="ft" closed="false">इश्शी </char></note> हिफाज़त केरेलो,</para>
  <para style="q" vid="PSA 12:7">ते तूए तैन बुरे लोकन करां हमेशा तगर बच़ेइतां रखेलो।<verse eid="PSA 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8" />ज़ैखन मैन्हन मां बुरैइअरी आदर भोचे,</para>
  <para style="q" vid="PSA 12:8">त बुरे लोक ठाठी सेइं च़लतन फिरतन।<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">मुक्तरे लेई प्राथना</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1" />हे परमेशर, तू केइस तगर? कुन तू मीं हमेशा बिसरी गालो?</para>
  <para style="q" vid="PSA 13:1">तू केइस तगर अपनु तुत्तर मीं करां छ़ुपेइतां रखेलो?<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2" />अवं केइस तगर अपने मने मां सोचतो रेइलो,</para>
  <para style="q" vid="PSA 13:2">ते सैरी दिहैड़ी अपने दिले मां दुखी भोतो रेइलो,</para>
  <para style="q" vid="PSA 13:2">ते केइस तगर मेरो दुश्मन मीं पुड़ हावी भोतो रालो?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3" />हे मेरे परमेशर यहोवा, मेरे पासे ध्यान दे ते मीं जुवाब दे,</para>
  <para style="q" vid="PSA 13:3">मेरी एछ़्छ़न मां लौ एजने दे, एरू न भोए कि अवं मौतरी निड्ली मां झ़ुल्‍ली गेईं;<verse eid="PSA 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4" />एरू न भोए कि मेरो दुश्मन ज़ोए, “अवं एस पुड़ ज़ींतोरोईं;”</para>
  <para style="q" vid="PSA 13:4">ते एरू न भोए कि ज़ैखन अवं बिछ़ड़ने लेग्गी, ते मेरे दुश्मन खुशी भोन।<verse eid="PSA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5" />मीं त तेरी करुणाई पुड़ भरोसो कियोरोए;</para>
  <para style="q" vid="PSA 13:5">मेरो दिल तेरे दित्तोरो छुटकारे मां मघन भोल्हो।<verse eid="PSA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6" />अवं यहोवारे नंव्वेरू भजन ज़ोइलो,</para>
  <para style="q" vid="PSA 13:6">किजोकि तैनी मेरी भलियाई कियोरीए।<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">पापी लोकां केरो चाल चलन</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1" />बेवकूफे अपने मने मां ज़ोवं, “कि कोई परमेशर नईं।”</para>
  <para style="q" vid="PSA 14:1">तैना बिगड़ी जे, तैनेईं नफरतरां कम्मां कियोरन,</para>
  <para style="q" vid="PSA 14:1">कोई भलां कम्मां केरनेबालो नईं।<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />यहोवा सुर्गे मरां मैन्हन पुड़ नज़र दित्ती</para>
  <para style="q" vid="PSA 14:2">कि हेरे कि कोई अक्लमन्दे,</para>
  <para style="q" vid="PSA 14:2">कोई यहोवा तोप्पने बालोए कि नईं।<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />तैना सब टेपलोइ जेवरेन, तैना सब भ्रष्ट भेवरेन;</para>
  <para style="q" vid="PSA 14:3">कोई भलियाई केरनेबालो नईं अक भी नईं<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-11">रोम. 3:10-11</ref>.</char></note>।<verse eid="PSA 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />कुन तैन बुरे लोकन किछ भी ज्ञान नईं,</para>
  <para style="q" vid="PSA 14:4">ज़ैना मेरे लोकन एन्च़रे खातन ज़ेन्च़रे रोट्टी,</para>
  <para style="q" vid="PSA 14:4">ते यहोवा कां कधे प्राथना न केरन?<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />तैड़ी तैन पुड़ बड़ो डर पेव,</para>
  <para style="q" vid="PSA 14:5">किजोकि परमेशर धेर्मी लोकां केरे मझ़ाटे लगातार रहते।<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />तुसां गरीबां केरे योजना केरि हासी बनातथ</para>
  <para style="q" vid="PSA 14:6">पन यहोवा परमेशर तैन केरि छ़पनेरी ठारे।<verse eid="PSA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />ते भलू भोए कि इस्राएलेरी मुक्ति सिय्योने मरां बांदी भोथी ज़ैड़ी यहोवा रहते,</para>
  <para style="q" vid="PSA 14:7">ज़ैखन यहोवा अपने लोकन गुलैमी मरां वापस आनेलो</para>
  <para style="q" vid="PSA 14:7">त याकूब मघन ते इस्राएल खुश भोल्हो<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="PSA 53:6">भज. 53:6</ref>;<ref loc="LUK 1:69">लूक. 1:69</ref>.</char></note>।<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">धर्मी मैन्हेरू बियान</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1" />हे यहोवा तेरे डेरे मां कौन रालो?<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">यरूशलेमेरे मन्दरे मां एजने बाले ई सवाल पुछ़तन। डेरेरो मतलब परमेशरेरी हज़ूरी।</char></note></para>
  <para style="q" vid="PSA 15:1">ते तेरे पवित्र पहाड़ सिय्योने पुड़ कौन रालो?<verse eid="PSA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />तैए ज़ै सच़्च़ेरी बत्ती पुड़ च़लते ते धार्मिकतारां कम्मां केरते</para>
  <para style="q" vid="PSA 15:2">ते दिले सेइं सच़ ज़ोते।<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />कने तै ज़ै एपनी ज़बानी सेइं केन्चेरी तुहीन न केरे,</para>
  <para style="q" vid="PSA 15:3">ते अपने दोस्ते सेइं बुराई न केरे,</para>
  <para style="q" vid="PSA 15:3">ते अपने पड़ोसेरी बदनामी न शुने।<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />कने तै ज़ेसेरी नज़री मां अधर्मी मैन्हु बिलकुल घटियाए,</para>
  <para style="q" vid="PSA 15:4">पन ज़ैना यहोवा करां डरतन, तैन केरि इज़्ज़त केरते,</para>
  <para style="q" vid="PSA 15:4">कने तै ज़ै कसम केरतां न बेदलोए चाए तैस नुकसान की न भोए।<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />ते कने तै ज़ै अपने रुपेइये सूते पुड़ न दे,</para>
  <para style="q" vid="PSA 15:5">ते बेकसूरेरो नुकसान केरनेरे लेई रिश्पत न ने:</para>
  <para style="q" vid="PSA 15:5">ज़ै कोई एरू केरते तै कधी न बिछ़ड़ेलो।<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">परमेशर मेरो हिस्सोए</para>
  <para style="d">दाऊदेरू मुक्तरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1" />हे परमेशर मेरी रक्षा केर,</para>
  <para style="q" vid="PSA 16:1">किजोकि अवं तेरी शरणी मां एवरोईं।<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />मीं यहोवा सेइं ज़ोवं, “कि तूए मेरो प्रभु आस;</para>
  <para style="q" vid="PSA 16:2">तेरे बगैर मेरी कोन्ची भलियाई नईं।”<note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="fq" closed="false">मेरी कोन्ची भलियाई नईं </char><char style="ft" closed="false">मेरी सारी भलियाई तीं करां एइतीए</char></note><verse eid="PSA 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />धेरती पुड़ ज़ैना पवित्र लोकन,</para>
  <para style="q" vid="PSA 16:3">तैन्ना आदरारे काबलन,</para>
  <para style="q" vid="PSA 16:3">ते तैन्ने सेइं अवं खुशी आईं।<verse eid="PSA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />देबते पूज़ने ते तैन पत्ती च़लनेबालां केरो दुख बद्धतो गालो;</para>
  <para style="q" vid="PSA 16:4">अवं तैन केरि ज़ेरि खूने बाली च़ढ़तल न च़ाढ़ेलो,</para>
  <para style="q" vid="PSA 16:4">ते अपने ऐशी सेइं तैन केरू नवं भी न घिन्नेलो।<verse eid="PSA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />यहोवा तू मेरो च़ुनोरो हिस्सो ते मेरो कुटोरो आस;</para>
  <para style="q" vid="PSA 16:5">तूए मेरो हिस्सो हिफाज़ती सेइं रखतस।<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />मेरे लेई नापरी डोरी मन पसंद ठैरी पुड़ राई,</para>
  <para style="q" vid="PSA 16:6">बल्के मेरी विरासत मने पसंद एजनेबाली आहे।<verse eid="PSA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />अवं यहोवारी तारीफ़ केरताईं,</para>
  <para style="q" vid="PSA 16:7">किजोकि तैने मीं सलाह दित्ती;</para>
  <para style="q" vid="PSA 16:7">बल्के मेरो दिल राती भी मीं शिक्षा देते।<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />मीं यहोवा हमेशा अपने सामने रखोरोए;</para>
  <para style="q" vid="PSA 16:8">एल्हेरेलेइ कि तै मेरे देइने पासे रहते अवं कधे न हिलेलो।<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />एस्से वजाई सेइं मेरो दिल खुशी</para>
  <para style="q" vid="PSA 16:9">ते मेरी आत्माई भी आरामे;</para>
  <para style="q" vid="PSA 16:9">ते मेरी जान सुरक्षित राली।<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />किजोकि तू न त मेरी जान पाताले मां राने देलो,</para>
  <para style="q" vid="PSA 16:10">ते न अपने पवित्र भक्ते<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="fq" closed="false">पवित्र भक्ते </char><char style="ft" closed="false">यानी यीशु मसीह</char></note> कब्री मां शड़ने देलो।<verse eid="PSA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />तू मीं ज़िन्दगरी बत हरालो;</para>
  <para style="q" vid="PSA 16:11">तेरे नेड़े बड़ो आनन्दे,</para>
  <para style="q" vid="PSA 16:11">ते तेरे देइने हथ्थे मां सुख हमेशारे लेई बनेरू रहते<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">आयत 8-11 बिलकुल एन्च़रे प्रेरितां केरां कम्मन मां 2:25-28 मां लिखी जेवरिन</char></note>।<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">रक्षारे लेई प्राथना</para>
  <para style="d">दाऊदेरी प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1" />हे यहोवा परमेशर सेच़्च़ी गल्‍लां शुन, ते मेरी बिनती पुड़ ध्यान दे,</para>
  <para style="q" vid="PSA 17:1">मेरी प्राथना पुड़ ज़ै मेरे बगैर खोटे ऐशेरां निसचे, ध्यान दे!<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />मेरे मुकदमेरो फैसलो तेरे सामने भोए!</para>
  <para style="q" vid="PSA 17:2">तेरी एछ़्छ़ी न्याय पुड़ लेगोरी रान!<verse eid="PSA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />अगर तू मेरो दिल अज़माथो; अगर राती तू मीं परखेथो,</para>
  <para style="q" vid="PSA 17:3">अगर तू मीं अज़माथो त तीं किछ भी खोट न मैलेथू;</para>
  <para style="q" vid="PSA 17:3">मेरे ऐशी मरां पापेरी कोई गल न निसेली।<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />मैन्हेरे कम्मन मां तेरे ज़बानरी गल्‍लां केरि ज़िरिये सेइं</para>
  <para style="q" vid="PSA 17:4">अधर्मी लोकां केरे बत्ती करां अपनो आप बच़ेइतां रख्खो।<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />मेरे पव तेरी बत्ती पुड़ टिकोरे राहोरेन, मेरे पव घिशकोरे नईं।<verse eid="PSA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />हे परमेशर, मीं तीं कां प्राथना कियोरीए, किजोकि तू मीं जुवाब देलो,</para>
  <para style="q" vid="PSA 17:6">मेरे पासे अपनो कन ला ते मेरी बिनती शुन।<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />तू ज़ै अपने देइने हथ्थे सेइं एप्पु पुड़</para>
  <para style="q" vid="PSA 17:7">भरोसो केरनेबालन तैन केरे मुखालफन करां बच़ेइतां रखतस,</para>
  <para style="q" vid="PSA 17:7">अपनि बड़ी करुणा हिरा।<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />मीं अपने अछ़रे पुतलरे ज़ेरि बच़ेइतां रख;</para>
  <para style="q" vid="PSA 17:8">मीं अपने फंघन हैठ छ़ुपेइतां रख,<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />तैन दुष्टन करां ज़ैना मीं तबाह केरतन,</para>
  <para style="q" vid="PSA 17:9">मेरी जानरे दुश्मन करां ज़ैनेईं अवं घेरतां रखोरोइं।<verse eid="PSA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />तैनेईं अपने दिल सखत कियोरेन;</para>
  <para style="q" vid="PSA 17:10">तैन केरे ऐशी मरां घमण्डेरी गल्‍लां निस्चन।<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />तैनेईं पेऊरू-पेऊरू पुड़ घेरतां रखोरोइं;</para>
  <para style="q" vid="PSA 17:11">तैना छ़ेपतां बिशोरेन कि मीं तल्‍ले</para>
  <para style="q" vid="PSA 17:11">मांजो बिछ़ोड़ी देन।<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />तैना तैस शेरेरे ज़ेरेन ज़ै अपने शिकारेरी इच्छा केरते,</para>
  <para style="q" vid="PSA 17:12">ते जुवान शेरेरे ज़ेरे छ़ेपतां ढोक देइतां मारनेरे लेई बिशोरेन।<verse eid="PSA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />खड़ो उठ, हे यहोवा!</para>
  <para style="q" vid="PSA 17:13">तैसेरो मुकाबलो केर ते तैस दब दे!</para>
  <para style="q" vid="PSA 17:13">एपनी तलवारी सेइं मेरी जान दुष्टे करां बच़ा।<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />हे यहोवा अपने हथ्थे सेइं, मीं लोकन करां बच़ा,</para>
  <para style="q" vid="PSA 17:14">यानी दुनियारे लोकन करां ते ज़ैन केरो हिस्सो इस्से दुनियाई मांए,</para>
  <para style="q" vid="PSA 17:14">ते ज़ैन केरू पेट तू अपने भण्डारे सेइं भरतस।</para>
  <para style="q" vid="PSA 17:14">त तैना औलादी सेइं रज़्ज़ोरेन, बल्के एत्रू भी आहे कि तैना भी बाकी जाईदात अपने बच्‍चां केरे लेई छ़ेडतां गातन।<verse eid="PSA 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />पन अवं त धर्मी भोइतां तेरे तुत्तरेरू दर्शन केरेलो,</para>
  <para style="q" vid="PSA 17:15">ज़ैखन अवं बींझ़ेलो, तैखन अवं तेरे दर्शने सेइं खुशी भोल्हो।<note caller="-" style="x"><char style="xo" closed="false">17:15 </char><char style="xt" closed="false"><ref loc="PSA 4:6-7">भज. 4:6-7</ref>;<ref loc="1JN 3:2">1 यूह. 3:2</ref>.</char></note><verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">दाऊदेरू मुक्तरू गीत</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई। यहोवारे दास दाऊदेरू गीत, ज़ेसेरे वचन तैने यहोवारे लेई तैस वक्ते ज़ोए ज़ैखन यहोवा तै तैसेरे सारे दुश्मना केरे हथ्थे करां, ते शाऊलेरे हथ्थे करां बच़ावरो थियो, तैने ज़ोवं</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1" />हे यहोवा, हे मेरी ताकत, अवं तीं सेइं प्यार केरताईं।<verse eid="PSA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2" />यहोवा मेरी चट्टान, ते मेरो क़िलो ते मेरो छुटानेबालोए;</para>
  <para style="q" vid="PSA 18:2">मेरो परमेशर, मेरी चट्टाने, ज़ैस पुड़ अवं भरोसो रखताईं।</para>
  <para style="q" vid="PSA 18:2">तै मेरी ढाल ते मेरी मुक्तरू शिंग,</para>
  <para style="q" vid="PSA 18:2">ते मेरो उच्‍चो क़िलोए।<note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="HEB 2:13">इब्रा. 2:13</ref>.</char></note><verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3" />अवं यहोवा ज़ै तारीफ़रे काबले तैस्से पुकारेलो,</para>
  <para style="q" vid="PSA 18:3">एन्च़रे अवं अपने दुश्मन्न करां बच़ाव गालो।<verse eid="PSA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4" />मौतरी रेस्सन सेइं अवं च़ेवरे पासन घिरोरोईं,</para>
  <para style="q" vid="PSA 18:4">ते अधर्मेरे सैलाबे सेइं मेरो दिल डेरि जेवरोए;<note caller="-" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="PSA 116:3">भज. 116:3</ref>.</char></note><verse eid="PSA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5" />पातालेरी रेस्सी मेरे च़ेवरे पासन थी,</para>
  <para style="q" vid="PSA 18:5">ते मौतरे फंदे मीं पुड़ एवरे थिये।<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6" />एपनी मुसीबती मां मीं यहोवा परमेशर पुकारो;</para>
  <para style="q" vid="PSA 18:6">ते अपने परमेशरे कां मद्दतरे लेई मीं बिनती की।</para>
  <para style="q" vid="PSA 18:6">तैनी अपने मन्दरे मां मेरी आवाज़ शुनी।</para>
  <para style="q" vid="PSA 18:6">ते मेरी बिनती ज़ै तैस कां थी, तैसेरे कन्ने मां पुज़्ज़ी।<verse eid="PSA 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7" />तैखन धरती हिल्‍ली जेई, ते थरथराने लगी,</para>
  <para style="q" vid="PSA 18:7">ते पहाड़ां केरि मुनीयादां भी हिल्‍ली जेई,</para>
  <para style="q" vid="PSA 18:7">किजोकि तै बड़ो क्रोधे भोवरो थियो।<verse eid="PSA 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8" />तैसेरे नक्‍के मरां तू लगो निसने,</para>
  <para style="q" vid="PSA 18:8">ते तैसेरे ऐशी मरां अग निस्तां भस्म केरने लगी;</para>
  <para style="q" vid="PSA 18:8">ज़ैस सेइं मूरां धुखी जेआं।<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9" />अम्बरे झुकेइतां तै बांदो भोव, ज़ैखन तै उन्ढो ओस्सो;</para>
  <para style="q" vid="PSA 18:9">त तैसेरे पव्वन हैठ बड़ू आंधरू थियूं।<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10" />तै करूबे<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="fq" closed="false">करूबे </char><char style="ft" closed="false">इना फंघन बाले प्राणी आन ज़ैना सुर्गे मां परमेशरेरे तखतेरी रखवाली केरतन। यहे. 1:5-14</char></note> पुड़ सुवार भोइतां उडरो,</para>
  <para style="q" vid="PSA 18:10">बल्के तै हवारे फंघेई सेइं उडरने लगो।<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11" />तैनी आंधरू अपनि छ़पनेरी ठार बनाई,</para>
  <para style="q" vid="PSA 18:11">ते अपने च़ेवरे पासन अम्बरेरी कैली बिदलारां केरो डेरो बनाव।<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12" />तैसेरे अगरां बिजली सेइं,</para>
  <para style="q" vid="PSA 18:12">आण ते अंगारां बिछ़ड़ां।<verse eid="PSA 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13" />तैखन यहोवा अम्बरे मां गरज़ो,</para>
  <para style="q" vid="PSA 18:13">ते परमप्रधान परमेशरेरी आवाज़ शुनोई ते आण ते मूरां भेज़ां।<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14" />तैनी अपने तीर च़लेइ-च़लेइ दुश्मन तितर-बितर किये;</para>
  <para style="q" vid="PSA 18:14">ते अम्बरेरी बिजली बिछ़ोड़ी-बिछ़ोड़ी तैना हाराए।<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15" />तैखन पैनेरो थलो लेइहोव, ते दुनियारी बुनियादां बैंदी भोइ,</para>
  <para style="q" vid="PSA 18:15">ई त यहोवा तेरी डांटी सेइं,</para>
  <para style="q" vid="PSA 18:15">ते तेरे नक्‍केरे शाहेरे झोंकी सेइं भोवं।<verse eid="PSA 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16" />तै उच्‍ची ठारारां उन्ढो अव, ते अवं ट्लेइ छ़डो,</para>
  <para style="q" vid="PSA 18:16">अवं डुग्घे पैनी मरां केढतां बेइर आनो।<verse eid="PSA 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17" />तैनी अवं मेरे ताकतबर दुश्मने करां,</para>
  <para style="q" vid="PSA 18:17">ते तैन करां ज़ैना मीं सेइं नफरत केरतन,</para>
  <para style="q" vid="PSA 18:17">अवं बच़ाव ज़ैन सेइं मेरी पेश न थी गाथी।<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18" />ज़ैस दिहैड़ी अवं मुसीबती मां फेसी जेव, तैस दिहैड़ी तैनेईं मीं पुड़ हमलो कमाव,</para>
  <para style="q" vid="PSA 18:18">पन यहोवा मेरो सहारो थियो।<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19" />तैने अवं तंग ठारारां केढतां खुल्‍ली ठैरी मां पुज़व,</para>
  <para style="q" vid="PSA 18:19">तैनी अवं छुटाव, किजोकि तै मीं पुड़ खुशी थियो।<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20" />यहोवा मीं सेइं मेरे धार्मिकतारे मुताबिक बर्ताव कियोरोए;</para>
  <para style="q" vid="PSA 18:20">ते तैनी मेरे हथ्थां केरि शुद्धतारे मुताबिक</para>
  <para style="q" vid="PSA 18:20">मीं बदलो दित्तोरोए।<verse eid="PSA 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21" />किजोकि अवं यहोवारे बत्तन पुड़ च़लतो राव,</para>
  <para style="q" vid="PSA 18:21">ते बुरैइारे वजाई सेइं अवं अपने परमेशरे करां दूर न भोव।<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22" />किजोकि तैसेरे सारे फैसले मेरे सामने बनोरो राए,</para>
  <para style="q" vid="PSA 18:22">ते अवं तैसेरे नियमन करां दूर न भोव।<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23" />अवं तैसेरे सामने सच़्च़ो बनोरो राव,</para>
  <para style="q" vid="PSA 18:23">ते अपनो आप अधर्मे करां बच़ेइतां रख्खो।<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24" />यहोवा मेरे धार्मिकतारे मुताबिक बदलो दित्तो,</para>
  <para style="q" vid="PSA 18:24">ते मेरे हथ्थां केरि शुद्धतारे मुताबिक ज़ै तैसेरे सामने थी।<verse eid="PSA 18:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25" />वफादारे सेइं साथी तू वफादार भोल्हो;</para>
  <para style="q" vid="PSA 18:25">ते सच़्च़े मैन्हु सेइं साथी तू सच़्च़ो लेइहोतस।<verse eid="PSA 18:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26" />शुद्धे सेइं तू अपनो आप शुद्ध हिरातस;</para>
  <para style="q" vid="PSA 18:26">ते टारे मैन्हु सेइं साथी तू टारो बनतस।<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27" />किजोकि ज़ैना मुसीबतरे मारे आन, तू तैन बच़ातस;</para>
  <para style="q" vid="PSA 18:27">पन घमण्डी लोकां केरि एछ़्छ़ी उन्ढी केरतस।<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28" />एल्हेरेलेइ कि तू मेरो दीयो बालतस;</para>
  <para style="q" vid="PSA 18:28">मेरो परमेशर यहोवा मेरे आंधरे</para>
  <para style="q" vid="PSA 18:28">ट्लेकड़ार बनाते।<note caller="-" style="x"><char style="xo" closed="false">18:28 </char><char style="xt" closed="false"><ref loc="2SA 22:29">2 शमू. 22:29</ref>. </char></note><verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29" />किजोकि अवं तेरी मद्दती सेइं सेनाई पुड़ हमलो केरताईं;</para>
  <para style="q" vid="PSA 18:29">ते अपने परमेशरेरी मद्दती सेइं अवं बेड़ि-बेड़ि दिवारां पार केरताईं।<verse eid="PSA 18:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30" />परमेशरेरी बत सिद्धे;</para>
  <para style="q" vid="PSA 18:30">यहोवारू वचन तेवरूए;</para>
  <para style="q" vid="PSA 18:30">तै तैन सेभी केरि ढाले, ज़ैना तैस पुड़ भरोसो रखतन।<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31" />किजोकि यहोवारे अलावा होरो कौन परमेशरे?</para>
  <para style="q" vid="PSA 18:31">ते इश्शे परमेशरेरे अलावा होरि कोई चट्टाने?<verse eid="PSA 18:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32" />ई तैए परमेशरे, ज़ै शेक्ति सेइं मेरो कमरबन्ध बन्धते,</para>
  <para style="q" vid="PSA 18:32">ते मेरी बत भी सिद्ध बनाते।<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33" />तैए मेरे पव हिरनरे ज़ेरे तेज़ बनाते;</para>
  <para style="q" vid="PSA 18:33">ते मीं मेरी उच्‍ची-उच्‍ची ठैरन पुड़ पुज़ाते।<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34" />तै मेरे हथ्थन सेइं मीं जंग केरनी शिखालते;</para>
  <para style="q" vid="PSA 18:34">एल्हेरेलेइ मेरी पाखड़न सेइं पितलरू धनुष झुकी गाते।<verse eid="PSA 18:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35" />तीं मीं मेरी मुक्तरी ढाल दित्तोरीए,</para>
  <para style="q" vid="PSA 18:35">ते तीं अपने देइने हथ्थे सेइं अवं सम्भालोरोईं;</para>
  <para style="q" vid="PSA 18:35">ते तेरो अनुग्रह मीं महान बनाते।<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36" />तीं मेरे पव्वां केरे लेई ठार खुल्‍ली बनेवरीए;</para>
  <para style="q" vid="PSA 18:36">ते मेरे पव नईं घिशकोरे।<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37" />अवं अपने दुश्मन्न पत्ती खेत्तां तैन ट्लालो;</para>
  <para style="q" vid="PSA 18:37">ते ज़ांतगर तैना नाश न भोन वापस न एज्जेलो।<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38" />अवं तैन एरहो कोशेलो, कि तैना खड़े न उठी बटेले;</para>
  <para style="q" vid="PSA 18:38">तैना मेरे पव्वन हैठ ढ्लेन्च़ोले।<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39" />किजोकि तीं जंगरे लेई मेरी कमरी मां</para>
  <para style="q" vid="PSA 18:39">शेक्तरो पटको बन्धोरोए;</para>
  <para style="q" vid="PSA 18:39">ते मेरे दुश्मन मेरे सामने तीं पस्त कियोरन।<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40" />तीं मेरे दुश्मना केरि पिठ मेरे पासे कियोरीए;</para>
  <para style="q" vid="PSA 18:40">ताके अवं एप्पु सेइं बैर रखनेबालन नाश केरि सेखी।<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41" />तैन दुश्मनेईं मद्दतरे लेई बड़ी बिनती त की पन तैन कोई बच़ानेबालो न मैल्हो,</para>
  <para style="q" vid="PSA 18:41">तैनेईं यहोवा कां भी बिनती की,</para>
  <para style="q" vid="PSA 18:41">पन तैने भी तैन जुवाब न दित्तो।<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42" />तैखन मीं तैना मेड्डी-मेड्डी बाते सेइं</para>
  <para style="q" vid="PSA 18:42">उडारेरी धूड़रे ज़ेरे किये;</para>
  <para style="q" vid="PSA 18:42">मीं तैना बत्तरे च़िकरारे ज़ेरे केढतां शारे।<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43" />तीं अवं कौमां केरि लड़ैइन करां भी बच़ेइतां रख्खो;</para>
  <para style="q" vid="PSA 18:43">ते तीं अवं गैर कौमां केरो प्रधान बनेइतां रख्खो;</para>
  <para style="q" vid="PSA 18:43">ज़ैन लोकन अवं ज़ानतो भी न थियो</para>
  <para style="q" vid="PSA 18:43">हुनी तैना मेरी सेवा केरतन<verse eid="PSA 18:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44" />ज़ैना मेरू नवं शुन्तन तैना मेरो हुक्म मन्नेले;</para>
  <para style="q" vid="PSA 18:44">परदेशी मेरे बस्से मां भोइ गाले।<note caller="-" style="x"><char style="xo" closed="false">18:44 </char><char style="xt" closed="false"><ref loc="2SA 8:9-12">2 शमू. 8:9-12</ref>.</char></note><verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45" />परदेशी भी ढिल्‍ले भोइ गाले;</para>
  <para style="q" vid="PSA 18:45">ते अपने क़िलन मरां थरकते निस्सन।<verse eid="PSA 18:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46" />यहोवा परमेशर ज़ींतोए; मेरी चट्टान धने;</para>
  <para style="q" vid="PSA 18:46">ते मेरे मुक्ति देनेबाले परमेशरेरू शुक्र भोए।<verse eid="PSA 18:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47" />धने मेरो बदलो नेनेबालो परमेशर!</para>
  <para style="q" vid="PSA 18:47">ज़ैनी मुल्खे-मुल्खेरे लोक मेरे कब्ज़े मां कियोरेन;<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48" />ते अवं मेरे दुश्मन्न करां छुटेइतां रखोरोइं;</para>
  <para style="q" vid="PSA 18:48">तू मीं मेरे दुश्मन्न करां उच्‍चो केरतस,</para>
  <para style="q" vid="PSA 18:48">ते ज़ालम मैन्हन करां बच़ाते।<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49" />एल्हेरेलेइ अवं कौमां-कौमां केरे सामने तेरू शुक्र केरेलो,</para>
  <para style="q" vid="PSA 18:49">ते तेरे नंव्वेरू भजन ज़ोइलो।<note caller="-" style="x"><char style="xo" closed="false">18:49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">रोम. 15:9</ref>.</char></note><verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50" />तै अपने ठहरावरे राज़े महान ज़ींत देते,</para>
  <para style="q" vid="PSA 18:50">तै अपने अभिषेक कियोरे दाऊदे पुड़</para>
  <para style="q" vid="PSA 18:50">ते तैसेरे खानदाने पुड़ हमेशा दया केरतो रालो।<note caller="-" style="x"><char style="xo" closed="false">18:50 </char><char style="xt" closed="false"><ref loc="2SA 7:16">2 शमू. 7:16</ref>.</char></note><verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">सृष्टरे ज़िरिये सृष्टि बनाने बालेरी महिमारू बियान</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1" />अम्बर परमेशरेरी महिमारे बारे मां बियान केरते;</para>
  <para style="q" vid="PSA 19:1">ते आकाशमण्डल तैसेरे हथ्थां केरि कारीगिरी हिराते।<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2" />दिहैड़ी सेइं दिहाड़ी गल्‍लां केरचे,</para>
  <para style="q" vid="PSA 19:2">ते रात राती ज्ञान शिखालतीए।<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3" />न कोई बोलीए, ते न कोई भाषा;</para>
  <para style="q" vid="PSA 19:3">ज़ैड़ी तैन केरो शब्द न भोए शुनोतो।<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4" />फिरी भी तैन केरि आवाज़ सैरी धेरती पुड़ शुनोरीए,</para>
  <para style="q" vid="PSA 19:4">ते तैन केरो शब्द दुनियारे आखरी कूने तगर पुज़ोरोए।</para>
  <para style="q" vid="PSA 19:4">तैनी दिहाड़ेरे लेई तैन मां अक तेम्बु लेवरोए।<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">आयत 4 पौलुसे रोमियो 10 आयत 18 मां भी इस्तेमाल कियोरोए कि मसीह सन्देश फैलाए।</char></note><verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5" />ज़ै लाड़ेरो ज़ेरो अपने मेहले मरां निस्ते।</para>
  <para style="q" vid="PSA 19:5">ते पहलवानेरो<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="fq" closed="false">पहलवानेरो </char><char style="ft" closed="false">खलाड़ी</char></note> ज़ेरो अपनि दौड़ दौड़नेरे लेई खुशी भोते।<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6" />तै अम्बरेरे एक्‍की पासेरां निसते,</para>
  <para style="q" vid="PSA 19:6">ते तैसेरे होरि पासे तगर चक्‍कर मारते;</para>
  <para style="q" vid="PSA 19:6">ते तैसेरी गेर्मी सेइं किछ भी बेच़ी न सके।<verse eid="PSA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7" />यहोवारो कानून सही आहे, तै जानी बहाल केरते;</para>
  <para style="q" vid="PSA 19:7">यहोवारे नियम भरोसेरे काबलन;</para>
  <para style="q" vid="PSA 19:7">ते सिद्धे सादे लोकन अक्लमन्द बनातन;<verse eid="PSA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8" />यहोवारे उपदेश सिद्धन, तैन सेइं दिल खुश भोते;</para>
  <para style="q" vid="PSA 19:8">यहोवारो हुक्म सही आहे;</para>
  <para style="q" vid="PSA 19:8">तैस सेइं एछ़्छ़न लौ मैलचे।<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9" />यहोवारो डर बिलकुल पवित्रे, तै हमेशा तगर बनोरो रहते;</para>
  <para style="q" vid="PSA 19:9">यहोवारे नियम बिलकुल सच़्च़े ते पूरे तरीके सेइं सही आन।<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10" />तैना नियम सोन्नेरे ते खालिस सोन्ने करां जादे मने पसंद एजने बाले आन;</para>
  <para style="q" vid="PSA 19:10">तैना मैछ़ी करां ते कश्शे मरां ट्लिशड़ने बाले मैछ़ी करां जादे रोड़ेन।<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="PSA 119:72">भज. 119:72</ref>,<ref loc="PSA 119:103">103</ref>.</char></note><verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11" />तैन्ने सेइं अवं तेरो दास खबरदार कियो गाताईं;</para>
  <para style="q" vid="PSA 19:11">तैन्न मन्ने सेइं बड़ो फल मैलते।<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="2JN 1:8">2 यूह. 1:8</ref>;<ref loc="PSA 119:11">भज. 119:11</ref>.</char></note><verse eid="PSA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12" />कौन अपनि गेलती सेमझ़ी सकते?</para>
  <para style="q" vid="PSA 19:12">मेरे छ़पोरे पापन करां मीं पवित्र केर।<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13" />तू अपने दासे ढीठ भोनेरे पापन करां भी बच़ेइतां रख;</para>
  <para style="q" vid="PSA 19:13">तैन केरो मीं पुड़ कोई दबाव न लोड़े!</para>
  <para style="q" vid="PSA 19:13">तैखन अवं सिद्ध भोल्हो, ते बड़े पापन करां बच़ोरो रेइलो।<note caller="-" style="x"><char style="xo" closed="false">19:13 </char><char style="xt" closed="false"><ref loc="NUM 15:30">गिन. 15:30</ref>.</char></note><verse eid="PSA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14" />हे यहोवा परमेशर, मेरी चट्टान ते मेरी मुक्ति केरनेबाले,</para>
  <para style="q" vid="PSA 19:14">मेरे ऐशेरी गल्‍लन ते मेरे दिलेरू ध्यान तेरे सामने कबूल भोए।<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">ज़ींतनेरे लेई प्राथना</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1" />मुसीबतरे दिहाड़े यहोवा तीं जुवाब दे!</para>
  <para style="q" vid="PSA 20:1">याकूबेरे परमेशरेरू नवं</para>
  <para style="q" vid="PSA 20:1">तीं बेड़ि उच्‍ची ठैरी पुड़ तेरी रक्षा केरे!<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2" />तै एपनी पवित्र ठारारां तेरी मद्दत केरे,</para>
  <para style="q" vid="PSA 20:2">ते तै सिय्योने मरां तेरो सहारो बने!<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3" />तै तेरी सब च़ढ़तल याद रख्खे,</para>
  <para style="q" vid="PSA 20:3">ते तेरी होमबलि कबूल केरे। <char style="qs">(सेला) </char><verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4" />तै तेरे दिलेरी इच्छा पूरी केरे,</para>
  <para style="q" vid="PSA 20:4">ते तेरी सब योजना कामयाब केरे!<verse eid="PSA 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5" />तैखन अस तेरी मुक्तरे<note caller="+" style="f"><char style="fr" closed="false">20:5 </char><char style="fq" closed="false">मुक्तरे </char><char style="ft" closed="false">ज़ींत</char></note> वजाई सेइं उच्‍ची आवाज़ी मां</para>
  <para style="q" vid="PSA 20:5">खुशी सेइं गीतां ज़ोमेले,</para>
  <para style="q" vid="PSA 20:5">ते अपने परमेशरेरे नंव्वे सेइं झण्डे खड़े केरमेले।</para>
  <para style="q" vid="PSA 20:5">यहोवा तेरी सैरी बिनती कबूल केरे।<note caller="-" style="x"><char style="xo" closed="false">20:5 </char><char style="xt" closed="false"><ref loc="PSA 60:4">भज. 60:4</ref>.</char></note><verse eid="PSA 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6" />हुनी मीं समझ़ू कि यहोवा अपने च़ुनोरे राज़े बच़ाते;</para>
  <para style="q" vid="PSA 20:6">तै अपने पवित्र सुर्गे मरां,</para>
  <para style="q" vid="PSA 20:6">अपने देइने हथ्थेरी मुक्तरे ताकती सेइं, तैस जुवाब देलो।<verse eid="PSA 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7" />किछन अपने रथ्थन पुड़, ते किछ अपने घोड़न पुड़ भरोसोए,</para>
  <para style="q" vid="PSA 20:7">पन अस त अपने यहोवा परमेशरेरू नंव्वे घिन्मेले।<note caller="-" style="x"><char style="xo" closed="false">20:7 </char><char style="xt" closed="false"><ref loc="PSA 33:16-17">भज. 33:16-17</ref>.</char></note><verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8" />तैना लोक त ठोकर खेइतां बिछ़ड़ी जे;</para>
  <para style="q" vid="PSA 20:8">पन अस खड़े उठते ते सिद्धे खड़े अहम।<verse eid="PSA 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9" />हे यहोवा, राज़े ज़ींत दे;</para>
  <para style="q" vid="PSA 20:9">असन बच़ा; ज़ैस दिहैड़ी असां तीं पुकारमेले तैखन जुवाब देइयां।<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">प्रभुएरे मुक्तरो आनन्द</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1" />हे यहोवा, राज़ो तेरी सामर्थी सेइं खुशी भोल्हो;</para>
  <para style="q" vid="PSA 21:1">ते तेरे दित्तोरे ज़ींती सेइं बड़ो मघन भोल्हो।<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2" />तीं तैसेरे दिलेरी इच्छा पूरी कियोरीए;</para>
  <para style="q" vid="PSA 21:2">ते तीं तैसेरे ज़बानरी बिनती कबूल नईं कियोरीए। <char style="qs">(सेला) </char><verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3" />किजोकि तू रोड़ी-रोड़ी बरकतां देतो तैस सेइं मिलतस</para>
  <para style="q" vid="PSA 21:3">ते तीं तैस शुद्ध सोन्नेरू ताज लुवाव।<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4" />तैनी तीं करां ज़िन्दगी मैल्हनेरी उमीद रख्खी; ते तीं तैस लम्मी उमर दित्ती;</para>
  <para style="q" vid="PSA 21:4">तीं तैस हमेशारी ज़िन्दगी दित्तोरिए।<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5" />तेरी मुक्ति सेइं तैस बड़ी आदर हासिल भोइ;</para>
  <para style="q" vid="PSA 21:5">ते तीं तै वैभव ते ऐश्वर्य सेइं भरपूर कियो।<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6" />किजोकि तीं तैस हमेशारे लेई बरकत दित्तोरिए;</para>
  <para style="q" vid="PSA 21:6">तू अपने सामने तैस खुशी ते आनन्दे सेइं भेरि देतस।<verse eid="PSA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7" />किजोकि राज़ेरो भरोसो यहोवा पुड़े;</para>
  <para style="q" vid="PSA 21:7">ते परमप्रधान परमेशरेरी दया तैस कधे बिछ़ड़ने न दे।<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8" />तेरो हथ तेरे सब दुश्मन्न तोपतां कढेलो,</para>
  <para style="q" vid="PSA 21:8">तेरो देइनो हथ तेरे सब बैर केरनेबालां केरो पतो कढेलो;<verse eid="PSA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9" />तू अपने सामने तैन दुश्मन्न बेलति भेट्ठरो</para>
  <para style="q" vid="PSA 21:9">ज़ेरो फुकेलो।</para>
  <para style="q" vid="PSA 21:9">यहोवा तैन अपने क्रोधे मां तैन निगली छ़डेलो;</para>
  <para style="q" vid="PSA 21:9">ते अग तैन फुकतां भस्म केरेली।<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10" />तू तैन केरि औलाद धेरती पुड़ेरां,</para>
  <para style="q" vid="PSA 21:10">ते तैन केरे खानदाने मैन्हन मरां नाश केरेलो।<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11" />किजोकि तैना तेरे खलाफ साज़िश केरतन</para>
  <para style="q" vid="PSA 21:11">तैनेईं एरहो इरादो कियोरोए</para>
  <para style="q" vid="PSA 21:11">ज़ै तैना पूरो न केरि सकेले।<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12" />किजोकि तू अपने धनुषे पुड़ तीर च़ाढ़ेलो,</para>
  <para style="q" vid="PSA 21:12">ते दुश्मन पिठ हिरेइतां नेश्शी गाले।<verse eid="PSA 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13" />हे यहोवा, एपनी सामर्थी मां महान भो;</para>
  <para style="q" vid="PSA 21:13">ते असां तेरां भजना खूब रोड़ेच़ारे ज़ोमेले।<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">दिलेरो दुख ते तारीफ़रू गीत</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई अभ्येलेरशर रागे मां दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1" />हे मेरे परमेशर, हे मेरे परमेशर,</para>
  <para style="q" vid="PSA 22:1">तीं अवं किजो शारो?</para>
  <para style="q" vid="PSA 22:1">तू मेरी पुकार शुन्ने करां ते मेरी मद्दत केरने करां</para>
  <para style="q" vid="PSA 22:1">किजो दूर रहतस? मेरो छुटकारो कोड़िए?<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2" />हे मेरे परमेशर, अवं दीसां तीं पुकारताईं</para>
  <para style="q" vid="PSA 22:2">पन तू जुवाब न देस;</para>
  <para style="q" vid="PSA 22:2">ते अवं राती भी च़ुप न रेईं।<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3" />पन तू ज़ै इस्राएलेरी तारीफ़रे तखते पुड़ बिशोरोस,</para>
  <para style="q" vid="PSA 22:3">तू त पवित्र परमेशरस।<verse eid="PSA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4" />तीं पुड़ इश्शे दादे पड़दादे भरोसो रखते थिये;</para>
  <para style="q" vid="PSA 22:4">तैना भरोसो रखते थिये,</para>
  <para style="q" vid="PSA 22:4">ते तू तैन छुटातो थियो।<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5" />ज़ैखन तैनेईं मद्दतरे लेई तीं कां बिनती की</para>
  <para style="q" vid="PSA 22:5">त तीं तैना खतरे करां छुटाए</para>
  <para style="q" vid="PSA 22:5">तैना तींए पुड़ भरोसो रखते थिये।</para>
  <para style="q" vid="PSA 22:5">ते कधी शरमिन्दे न भोए!<verse eid="PSA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6" />पन अवं त अक कीड़ोईं; अवं इन्सान नईं;</para>
  <para style="q" vid="PSA 22:6">लोकन मां मेरी बदनामी भोवरीए,</para>
  <para style="q" vid="PSA 22:6">ते लोकन मां मेरी बेइज़्ज़ती भोतीए।<verse eid="PSA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7" />तैना सब ज़ैना मीं हेरतन मेरो मज़ाक उड़ातन,</para>
  <para style="q" vid="PSA 22:7">तैना अपनि ज़िभ केढतां</para>
  <para style="q" vid="PSA 22:7">ते इन ज़ोइतां क्रोड़ी हिलातन,<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">मत. 27:39</ref>;<ref loc="MRK 15:29">मरक. 15:29</ref>.</char></note><verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8" />तैना ज़ोतन, “तै यहोवा पुड़ भरोसो केरते,</para>
  <para style="q" vid="PSA 22:8">यहोवा तैस छुटाए,</para>
  <para style="q" vid="PSA 22:8">तै तैस बच़ाए किजोकि तै तैस सेइं खुशे।”<note caller="-" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="PSA 91:14">भज. 91:14</ref>.</char></note><verse eid="PSA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9" />पन तींए अवं गर्भे मरां कढोरोईं;</para>
  <para style="q" vid="PSA 22:9">ज़ैखन अवं दुद्ध पीतो बच्‍चो थियो,</para>
  <para style="q" vid="PSA 22:9">तैखने करां तीं मीं भरोसो रखनो शिखालो।<verse eid="PSA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10" />ज़ेरो अवं पैदा भोव; अवं तेरे भरोसे पुड़ छ़ेडी दित्तो;</para>
  <para style="q" vid="PSA 22:10">अम्मरे पेटे करां देंतो तू मेरो परमेशर राहोरोस।<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11" />मीं करां तू दूर न भो किजोकि मुसीबत नेड़े,</para>
  <para style="q" vid="PSA 22:11">ते होरो कोई नईं कि ज़ै मेरी मद्दत केरे।<verse eid="PSA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12" />बड़े संढेईं अवं घेरतां रखोरोइं,</para>
  <para style="q" vid="PSA 22:12">बाशानेरे<note caller="+" style="f"><char style="fr" closed="false">22:12 </char><char style="fq" closed="false">बाशानेरे </char><char style="ft" closed="false">बाशान, यरदनेरे पूर्वेरे पासेरो सूबो थियो, ज़ै मालेरे च़रनेरे लेई बड़ी रोड़ी ठार थी। </char></note> निग्गर संढेईं च़ेवरे पासना अवं घेरतां रखोरोइं।<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13" />तैना छ़िन्दने बाले ते गरज़नेबाले शेरेरे ज़ेरे</para>
  <para style="q" vid="PSA 22:13">अपनु आशी खोलतां बिशोरेन।<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14" />अवं पैनेरो ज़ेरो रुड़ी जेव;</para>
  <para style="q" vid="PSA 22:14">ते मेरी सब हेड्डी केरे जोड़ घिशके:</para>
  <para style="q" vid="PSA 22:14">मेरो दिल मोम भोइ जेव,</para>
  <para style="q" vid="PSA 22:14">तै मेरी जानी मां गेली जेव।<verse eid="PSA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15" />मेरी ताकत ट्लुटी जेवरीए; ते अवं केपरारो ज़ेरो सखत भोवरोईं;</para>
  <para style="q" vid="PSA 22:15">ते मेरी ज़िभ तैलू सेइं खेत्ती जेवरीए;</para>
  <para style="q" vid="PSA 22:15">ते तू मीं मित्ती<note caller="+" style="f"><char style="fr" closed="false">22:15 </char><char style="fq" closed="false">मित्ती </char><char style="ft" closed="false">मतलब कब्री मां</char></note> मां मिलातस।<note caller="-" style="x"><char style="xo" closed="false">22:15 </char><char style="xt" closed="false"><ref loc="PRO 17:22">कह. 17:22</ref>.</char></note><verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16" />किजोकि कुतरेईं अवं घेरतां रखोरोइं;</para>
  <para style="q" vid="PSA 22:16">कुकर्मी मैन्हु केरि मेण्डलां अवं च़ेवरे पासना घेरतां रखोरोइं,</para>
  <para style="q" vid="PSA 22:16">तैना मेरे हथ पव कोशतन।<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="MAT 27:35">मत. 27:35</ref>;<ref loc="MRK 15:29">मरक. 15:29</ref>;<ref loc="LUK 23:33">लूक. 23:33</ref>.</char></note><verse eid="PSA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17" />अवं एपनी सब हेड्डी गेनि सकताईं;</para>
  <para style="q" vid="PSA 22:17">तैना मीं तकतन ते मेरे पासे घूरतन।<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18" />तैना एप्पु मांमेइं मेरां लिगड़ां बंटतन,</para>
  <para style="q" vid="PSA 22:18">ते मेरे लिगड़न पुड़ चिट्ठी छ़डतन।<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">मत. 27:35</ref>;<ref loc="LUK 23:34">लूक. 23:34</ref>;<ref loc="JHN 19:24-25">यूह. 19:24-25</ref>.</char></note><verse eid="PSA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19" />पन हे यहोवा तू मीं करां दूर न भोए!</para>
  <para style="q" vid="PSA 22:19">हे मेरे मद्दतगार, मेरी मद्दतरे लेई जल्दी केर!<verse eid="PSA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20" />मीं तलवारी करां बच़ा,</para>
  <para style="q" vid="PSA 22:20">मेरी जान कुतरां केरे पोचरे करां बच़ा!<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21" />मीं शेरेरे ऐशी करां बच़ा;</para>
  <para style="q" vid="PSA 22:21">हाँ जंगली दांतां केरे शिंगन करां मीं बच़ा।<verse eid="PSA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22" />अवं अपने ढ्लां केरे सामने तेरे नंव्वेरो प्रचार केरेलो;</para>
  <para style="q" vid="PSA 22:22">हछे लोकां केरे सामने तेरे नंव्वेरी तारीफ़ केरेलो।<note caller="-" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="HEB 2:12">इब्रा. 2:12</ref>.</char></note><verse eid="PSA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23" />तुस ज़ैना यहोवा करां डरने बालेथ, तैसेरी तारीफ़ केरा!</para>
  <para style="q" vid="PSA 22:23">हे याकूबेरे खानदानेरे लोकव, तुस सब तैसेरी तारीफ़ केरा!</para>
  <para style="q" vid="PSA 22:23">हे इस्राएलेरे खानदानेरे लोकव, तुस सब तैसेरो डर मन्ना!<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="PSA 135:19-20">भज. 135:19-20</ref>. </char></note><verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24" />किजोकि तैनी दुखी लोक घटिया नईं समझ़ोरे</para>
  <para style="q" vid="PSA 22:24">ते न तैन सेइं बैर रख्खे,</para>
  <para style="q" vid="PSA 22:24">यहोवा अपनु तुत्तर तैन करां नईं छ़ुपेवरू;</para>
  <para style="q" vid="PSA 22:24">पन ज़ैखन तैनी तैस कां बिनती की, तैखन तैसेरी शुनी छ़डी।<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25" />बड़े लोकन मां मेरी तारीफ़ केरनी तेरी तरफां भोतीए;</para>
  <para style="q" vid="PSA 22:25">अवं अपनि मिन्नतां तेरो डर रखनेबालां केरे सामने पूरी केरेलो।<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26" />गरीब लोक रोट्टी खेइतां रज़्ज़ेले,</para>
  <para style="q" vid="PSA 22:26">ज़ैना यहोवारे तलाशी मां आन; तैना तैसेरी तारीफ़ केरेले।</para>
  <para style="q" vid="PSA 22:26">तुश्शे प्राण हमेशा ज़ींत रान।<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27" />लोक दुनियारे आखरी कूने तगर तैसेरे नंव्वेरी तारीफ़ केरेले;</para>
  <para style="q" vid="PSA 22:27">ते तैसेरे पासे फिरेले:</para>
  <para style="q" vid="PSA 22:27">ते कौमां-कौमां केरे सब कुल तेरे सामने झुकेले।<verse eid="PSA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28" />किजोकि राज़ यहोवारू आहे,</para>
  <para style="q" vid="PSA 22:28">ते सेभी कौमन पुड़ तैए हुकूमत केरते।<note caller="-" style="x"><char style="xo" closed="false">22:28 </char><char style="xt" closed="false"><ref loc="ZEC 14:9">जक. 14:9</ref>.</char></note><verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29" />धेरतरे सब ताकतबर लोक यहोवा कां बिशतां खाएले ते मथ्थो टेकेले;</para>
  <para style="q" vid="PSA 22:29">तैना सब ज़ैना मित्ती मां मिली गातन</para>
  <para style="q" vid="PSA 22:29">तैना सब अपने-अपने प्राण न बच़ेइ सकन,</para>
  <para style="q" vid="PSA 22:29">तैना सब तैसेरे सामने झुकेले।<verse eid="PSA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30" />एजनेबाली पीढ़ी तैसेरी सेवा केरेली;</para>
  <para style="q" vid="PSA 22:30">होरि पीढ़ी सेइं प्रभुएरे बारे मां ज़ोवं गालू।<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31" />तैना एज्जेले ते तैसेरां धर्मेरां कम्मां एक्‍की</para>
  <para style="q" vid="PSA 22:31">नसली शुनाले; ज़ै हेजू पैदा नईं भोवरी,</para>
  <para style="q" vid="PSA 22:31">किजोकि तैन्नी एन सब किछ कियोरूए।<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">परमेशर अपने लोकां केरो पुहाले</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1" />यहोवा मेरो पुहाले;<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="fq" closed="false">यहोवा मेरो पुहाले </char><char style="ft" closed="false">यहोवा रोही</char></note></para>
  <para style="q" vid="PSA 23:1">मीं कोई कमी न भोल्ही।<note caller="-" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="ISA 40:11">यशा. 40:11</ref>.</char></note><verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />तै मीं सब्ज़-सब्ज़ घासेरे ठारन मां च़ारते;<note caller="+" style="f"><char style="fr" closed="false">23:2 </char><char style="ft" closed="false">च़रनेरे लेई ते आराम केरनेरे लेई अक रोड़ी ठार</char></note></para>
  <para style="q" vid="PSA 23:2">ते सुख देनेरे पैनेरे नागन कां नेते;<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />तै मेरी जानी ताज़गी देते।</para>
  <para style="q" vid="PSA 23:3">ते अपने नंव्वेरे खातर धार्मिकतारे बत्तन मां</para>
  <para style="q" vid="PSA 23:3">मेरी अगवाई केरते।<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />चाए अवं बड़े आंधरी वैदी मांमेइं भोइतां च़ेलि,</para>
  <para style="q" vid="PSA 23:4">फिरी भी अवं नुकसाने करां न डेरेलो;</para>
  <para style="q" vid="PSA 23:4">किजोकि तू मीं सेइं साथी रहतस;</para>
  <para style="q" vid="PSA 23:4">तेरे सोटे<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fq" closed="false">सोटे </char><char style="ft" closed="false">सोटो जंगली जानबरन निशान्नेरे लेई भोतो थियो</char></note> ते तेरी लट्ठी सेइं मीं तसल्‍ली मैलतीए।<verse eid="PSA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />तू मेरे सताने बालां केरे सामने मेरे लेई रोट्टरे मेज़े बिछ़ातस;</para>
  <para style="q" vid="PSA 23:5">तू मेरे दोग्गे पुड़ तेल मलतस,</para>
  <para style="q" vid="PSA 23:5">मेरो कुटोरो छ़लकने लगोरोए।<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />पक्‍की भलियाई ते करुणा सैरी उमरी</para>
  <para style="q" vid="PSA 23:6">मीं सेइं साथी-साथी राहेली;</para>
  <para style="q" vid="PSA 23:6">ते अवं हमेशा यहोवारे घरे मां रेइलो।<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">महिमाई बालो राज़ो ते तैसेरू राज़</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1" />धरती ते होरू ज़ैन किछ तैस मांए, सब किछ यहोवारू आहे;</para>
  <para style="q" vid="PSA 24:1">दुनिया ते तैस मां रानेबाले सब भी तैसेरे आन।<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />किजोकि तैनी धेरतरी मुनीयाद समुन्दरे पुड़ मज़बूत केरतां रख्खोरीए,</para>
  <para style="q" vid="PSA 24:2">ते बड़े पैनी पुड़ रख्खोरीए।<verse eid="PSA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />यहोवारे पहाड़े<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="fq" closed="false">यहोवारे पहाड़े </char><char style="ft" closed="false">सिय्योन पहाड़</char></note> पुड़ कौन च़ेढ़ी सकते?</para>
  <para style="q" vid="PSA 24:3">कौन तैसेरे पवित्र भवने मां खड़ो भोइ<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="fq" closed="false">खड़ो भोइ </char><char style="ft" closed="false">कौन आराधना केरि सकते</char></note> सकते।<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />तैए ज़ेसेरे हथ साफ ते दिल पवित्र भोए;</para>
  <para style="q" vid="PSA 24:4">ज़ैने अपनो मन बेकार गल्‍लरे पासे<note caller="+" style="f"><char style="fr" closed="false">24:4 </char><char style="fq" closed="false">बेकार गल्‍लरे पासे </char><char style="ft" closed="false">मूरती केरि पूज़ा</char></note> नईं लेवरो,</para>
  <para style="q" vid="PSA 24:4">ते न कसम केरतां झूठ ज़ोए।<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />तैस यहोवा करां बरकत मैल्हेली,</para>
  <para style="q" vid="PSA 24:5">तै अपने मुक्ति देनेबाले परमेशरेरे</para>
  <para style="q" vid="PSA 24:5">तरफां धर्मी ठहरेलो।<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />एरे ज़ेरे लोक तैसेरी तलाशी मां आन,</para>
  <para style="q" vid="PSA 24:6">तैना परमेशरेरे दर्शनेरे तोपी ते याकूबेरे खानदाने मरां आन।<verse eid="PSA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />हे फाटकव; अपने क्रोड़ी उच्‍ची केरा!</para>
  <para style="q" vid="PSA 24:7">हे सनातनेरे दारव उच्‍चे भोथ!</para>
  <para style="q" vid="PSA 24:7">किजोकि महिमारो राज़ो दाखल भोल्हो।<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />तै महिमारो राज़ो कौने?</para>
  <para style="q" vid="PSA 24:8">यहोवा ज़ै सामर्थी ते शेक्ति बालोए,</para>
  <para style="q" vid="PSA 24:8">परमेशर ज़ै जंगी मां शेक्ति बालोए।<verse eid="PSA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />हे दारव, अपने उच्‍चे भोथ</para>
  <para style="q" vid="PSA 24:9">हे सनातनेरे दारव तुस भी खुल्‍ली गाथ!</para>
  <para style="q" vid="PSA 24:9">किजोकि महिमारो राज़ो दाखल भोल्हो!<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />तै महिमारो राज़ो कौने?</para>
  <para style="q" vid="PSA 24:10">सेना केरो यहोवा, तैए महिमारो राज़ोए। <char style="qs">(सेला) </char><verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">प्रभु पुड़ भरोसो रखनो</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1" />हे यहोवा, अवं तीं</para>
  <para style="q" vid="PSA 25:1">पुड़ भरोसो रखताई।<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />हे मेरे परमेशर, मीं तींए पुड़ भरोसो रखोरोए,</para>
  <para style="q" vid="PSA 25:2">मीं शरमिन्दा न भोने दे,</para>
  <para style="q" vid="PSA 25:2">मेरे दुश्मन मीं पुड़ जयजयकार न केरि बटन।<note caller="+" style="f"><char style="fr" closed="false">25:2 </char><char style="ft" closed="false">मेरे दुश्मन्न मीं पुड़ ज़ींतने न दे</char></note><verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />बल्के ज़ेत्रे तीं पुड़ उमीद रखतन</para>
  <para style="q" vid="PSA 25:3">तैना कोई शरमिन्दा न भोल्हे;</para>
  <para style="q" vid="PSA 25:3">पन ज़ैना बगैर वजां धोखेबाज़न</para>
  <para style="q" vid="PSA 25:3">तैन्ना शरमिन्दा भोल्हे।<verse eid="PSA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />हे यहोवा, एपनी बत्तां मीं हिरा;</para>
  <para style="q" vid="PSA 25:4">मीं एपनी बत्तां केरि शिक्षा दे।<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />अपने सच़्च़ैई पुड़ च़ला ते शिक्षा दे;</para>
  <para style="q" vid="PSA 25:5">किजोकि तूए मीं मुक्ति देनेबालो परमेशरस;</para>
  <para style="q" vid="PSA 25:5">सैरी दिहैड़ी अवं तेरे इंतज़ारे मां रहताईं।<verse eid="PSA 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />हे यहोवा, अपनि दया ते करुणारे कम्मन याद केर;</para>
  <para style="q" vid="PSA 25:6">किजोकि तैना त हमेशा करां भोतां एवरेन।<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />हे यहोवा, अपने भलैइयरे वजाई सेइं</para>
  <para style="q" vid="PSA 25:7">मेरे जुवैनरे पापन ते मेरे बुरे कम्मन याद न केर;</para>
  <para style="q" vid="PSA 25:7">अपनि करुणारे मुताबिक तू मीं याद केर।<verse eid="PSA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />यहोवा भलो ते सच़्च़ोए;</para>
  <para style="q" vid="PSA 25:8">एल्हेरेलेइ तै पापी लोकन अपनि बत हिरालो।<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />तै हलीम लोकन न्यायेरी शिक्षा देलो,</para>
  <para style="q" vid="PSA 25:9">हाँ, तै हलीम लोकन अपनि बत हिरालो।<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />ज़ैना यहोवारे करारे ते कानूने मनतन,</para>
  <para style="q" vid="PSA 25:10">तैन केरे लेई तैसेरी सब बत्तां करुणा ते सच़्च़ेरी आन।<note caller="-" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="JHN 1:17">यूह. 1:17</ref>.</char></note><verse eid="PSA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />हे यहोवा, अपने नंव्वेरे खातर</para>
  <para style="q" vid="PSA 25:11">मेरे पापन माफ़ केर ज़ैना बड़ेन।<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />तै कौने ज़ै यहोवारो डर मन्ते?</para>
  <para style="q" vid="PSA 25:12">प्रभु तैस तैस्से बत्ती पुड़ च़लालो</para>
  <para style="q" vid="PSA 25:12">ज़ैस सेइं तै खुश भोते।<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />तै सुखे सेइं टिकोरो रालो,</para>
  <para style="q" vid="PSA 25:13">ते तैसेरी औलाद धेरती अधिकारी भोल्ही।<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />यहोवारो भेद तैन्ना ज़ानतन ज़ैना तैस करां डरतन,</para>
  <para style="q" vid="PSA 25:14">ते तैए अपनो करार तैन पुड़ बांदो केरेलो।<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="EPH 1:9">इफि. 1:9</ref>;<ref loc="EPH 1:18">1:18</ref>.</char></note><verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />मेरी एछ़्छ़ी हमेशा यहोवा तेकती रैतिन,</para>
  <para style="q" vid="PSA 25:15">किजोकि तैए मेरे पव जाले मरां छुटालो।<note caller="-" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="PSA 141:8">भज. 141:8</ref>.</char></note><verse eid="PSA 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />हे यहोवा, मेरे पासे फिरतां मीं पुड़ दया केर;</para>
  <para style="q" vid="PSA 25:16">किजोकि अवं अकैल्‍लो ते मुसीबतरो मारोरोईं।<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />मेरे दिलेरी परेशानी बधोरीए,</para>
  <para style="q" vid="PSA 25:17">तू मीं मेरी तकलीफी करां छुटा।<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />तू मेरे दुखे ते तकलीफी पुड़ नज़र केर,</para>
  <para style="q" vid="PSA 25:18">ते मेरे सब पापन माफ़ केर।<verse eid="PSA 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />मेरे दुश्मन हेर कि तैना केत्रे बधोरेन,</para>
  <para style="q" vid="PSA 25:19">ते मीं सेइं बड़ो बैर रखतन।<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />मेरी जानरी हिफाज़त केर, ते मीं छुटा;</para>
  <para style="q" vid="PSA 25:20">मीं शरमिन्दा न भोने दे,</para>
  <para style="q" vid="PSA 25:20">किजोकि मेरो भरोसो तीं पुड़े।<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />हे प्रभु, ईमानदारी ते सच़्च़ाई मेरी रक्षा केर,</para>
  <para style="q" vid="PSA 25:21">किजोकि मीं सिर्फ तेरी उमीदे।<verse eid="PSA 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />हे यहोवा इस्राएले तैसेरे सारे मुसीबतन करां छुटकारो दे।<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">एक्‍की सच़्च़े मैन्हेरी प्राथना</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1" />हे यहोवा, मेरो न्याय केर,</para>
  <para style="q" vid="PSA 26:1">किजोकि अवं सच़्च़ैई सेइं च़लतो एवरोईं;</para>
  <para style="q" vid="PSA 26:1">ते मेरो भरोसो यहोवा पुड़ अटल बनोरोए।<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />हे यहोवा, मीं जांच ते परख;</para>
  <para style="q" vid="PSA 26:2">मेरे मने ते दिले परख।<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />किजोकि तेरी करुणा मेरी एछ़्छ़ी केरे सामने,</para>
  <para style="q" vid="PSA 26:3">अवं तेरी सच़्च़ेरी बत्ती पुड़ च़लतो राहोरोइं।<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />अवं निकम्मी चाल च़लनेबालन सेइं साथी न बिश्शो,</para>
  <para style="q" vid="PSA 26:4">ते न अवं कपटी लोकन सेइं साथी कोन्ची गेईं;<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />अवं कुकर्मी लोकां केरि सेंगती सेइं नफरत रखताईं,</para>
  <para style="q" vid="PSA 26:5">ते दुष्टन सेइं साथी न बिशेलो।<verse eid="PSA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />अवं अपने हथ्थन इन हिरानेरे लेई धोइलो कि अवं बेकसूर आईं,</para>
  <para style="q" vid="PSA 26:6">तैखन हे यहोवा अवं तेरी वेदी कां एज्जेलो।<note caller="-" style="x"><char style="xo" closed="false">26:6 </char><char style="xt" closed="false"><ref loc="PSA 73:13">भज. 73:13</ref>.</char></note><verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />ताके तेरू शुक्र बड़े उच्‍ची आवाज़ी सेइं केरीं,</para>
  <para style="q" vid="PSA 26:7">ते तेरे चमत्कारेरे कम्मां केरू बियान केरीं।<verse eid="PSA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />हे यहोवा अवं तेरे भवने सेइं</para>
  <para style="q" vid="PSA 26:8">तेरी महिमारे रानेरे ठारी सेइं प्यार रखताईं।<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />मेरे प्राण पापी लोकन सेइं साथी,</para>
  <para style="q" vid="PSA 26:9">ते मेरी ज़िन्दगी खूनी मैन्हन सेइं साथी न मिला।<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />तैना त बुरे कम्मन मां लग्गोरे रहतन,</para>
  <para style="q" vid="PSA 26:10">ते तैन केरो देइनो हथ रिश्पती सेइं भरोरो रहते।<verse eid="PSA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />पन अवं त सच़्च़ैई सेइं च़लतो रेइलो।</para>
  <para style="q" vid="PSA 26:11">तू मीं छुटा, ते मीं पुड़ दया केर।<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />मेरे पव बराबर ठैरी खड़े आन;</para>
  <para style="q" vid="PSA 26:12">सभान मां अवं यहोवारी तारीफ़ केरेलो।<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">विश्वासेरू एलान</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1" />यहोवा मेरी लौ ते मेरी मुक्ति आहे;</para>
  <para style="q" vid="PSA 27:1">अवं कैस करां डेरि?</para>
  <para style="q" vid="PSA 27:1">यहोवा मेरे ज़िन्दगरो मज़बूत क़िलो ठहरोरोए,</para>
  <para style="q" vid="PSA 27:1">अवं कैस करां डेरि?<verse eid="PSA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />ज़ैखन बुरे लोक ज़ैना मीं सताते</para>
  <para style="q" vid="PSA 27:2">ते मीं सेइं बैर रखते थिये,</para>
  <para style="q" vid="PSA 27:2">ते मीं मारनेरे लेई कोशिश की,</para>
  <para style="q" vid="PSA 27:2">तैखन तैन्ना ठोकर खेइतां बिछ़ड़ी जे।<verse eid="PSA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />चाहे सेना भी च़ेवरे पासन घेरो की न दे,</para>
  <para style="q" vid="PSA 27:3">फिरी भी अवं न डरेलो; चाए मेरे खलाफ जंग की न भोए,</para>
  <para style="q" vid="PSA 27:3">तैस हालती मां भी मेरो भरोसो परमेशरे पुड़ पक्‍को भोल्हो।<verse eid="PSA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />अक बर मीं यहोवा करां मगोरूए,</para>
  <para style="q" vid="PSA 27:4">तैसेरे लेई कोशिश केरतो रेइलो;</para>
  <para style="q" vid="PSA 27:4">कि अवं ज़िन्दगी भर यहोवारे भवने मां रेईं सेकी</para>
  <para style="q" vid="PSA 27:4">ज़ैस सेइं यहोवारी महिमा पुड़ नज़र लेइतां रेखी,</para>
  <para style="q" vid="PSA 27:4">ते तैसेरे भवने मां ध्यान केरतो रेईं।<note caller="-" style="x"><char style="xo" closed="false">27:4 </char><char style="xt" closed="false"><ref loc="PSA 6:8">भज. 6:8</ref>;<ref loc="PSA 23:6">23:6</ref>;<ref loc="PHP 3:13">फिल. 3:13</ref>.</char></note><verse eid="PSA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />किजोकि मुसीबतरे दिहाड़े तै मीं</para>
  <para style="q" vid="PSA 27:5">अपने भवने मां बिशने देलो;</para>
  <para style="q" vid="PSA 27:5">ते मीं अपने तेम्बु मां छ़पने देलो,</para>
  <para style="q" vid="PSA 27:5">ते मीं चट्टानी पुड़ च़ाढ़ेलो।<note caller="-" style="x"><char style="xo" closed="false">27:5 </char><char style="xt" closed="false"><ref loc="PSA 91:1">भज. 91:1</ref>;<ref loc="PSA 40:2">40:2</ref>;<ref loc="PSA 138:7">138:7</ref>.</char></note><verse eid="PSA 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />हुनी मेरी क्रोड़ी मेरे च़ेवरे पासां केरे दुश्मन्न करां उच्‍ची भोल्ही;</para>
  <para style="q" vid="PSA 27:6">ते अवं यहोवारे तेम्बु मां आनन्देरे बलिदान च़ाढ़ेलो;</para>
  <para style="q" vid="PSA 27:6">ते अवं गीत ज़ोलो ते यहोवारी तारीफ़ केरेलो।<note caller="-" style="x"><char style="xo" closed="false">27:6 </char><char style="xt" closed="false"><ref loc="PSA 3:3">भज. 3:3</ref>.</char></note><verse eid="PSA 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />हे यहोवा, मेरि आवाज़ शुन, अवं बिनती केरेलो,</para>
  <para style="q" vid="PSA 27:7">तू मीं पुड़ दया केर ते मीं जुवाब दे।<note caller="-" style="x"><char style="xo" closed="false">27:7 </char><char style="xt" closed="false"><ref loc="PSA 130:2-4">भज. 130:2-4</ref>;<ref loc="PSA 13:3">13:3</ref>.</char></note><verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />तीं ज़ोवरूए, “मेरे दर्शनेरे तोपी मां राथ।”</para>
  <para style="q" vid="PSA 27:8">एल्हेरेलेइ मेरो मन तीं सेइं ज़ोते,</para>
  <para style="q" vid="PSA 27:8">“हे यहोवा, अवं तेरे दर्शनेरो तलाशी मां रेइलो।”<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />अपनु तुत्तर मीं करां न छ़ुपा।</para>
  <para style="q" vid="PSA 27:9">अपने दासे क्रोध केरतां न हटा,</para>
  <para style="q" vid="PSA 27:9">तू मेरो मद्दत केरनेबालो बनोरो रा।</para>
  <para style="q" vid="PSA 27:9">हे मेरे मुक्ति देनेबाले परमेशर मीं करां दूर न भो, ते मीं न शार!<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />मेरे अम्मा-बाजे त अवं शारोरोईं,</para>
  <para style="q" vid="PSA 27:10">पन यहोवा मेरो खियाल रखेलो।<verse eid="PSA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />हे यहोवा, अपने बत्ती पुड़ च़लनू मीं शिखाल,</para>
  <para style="q" vid="PSA 27:11">ते मेरे दुश्मना केरे वजाई सेइं मीं खुल्‍ली बत्ती पुड़ च़ला।<note caller="-" style="x"><char style="xo" closed="false">27:11 </char><char style="xt" closed="false"><ref loc="PSA 5:8">भज. 5:8</ref>.</char></note><verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />मीं मेरे सताने बालां केरि इच्छाई पुड़ न शार,</para>
  <para style="q" vid="PSA 27:12">किजोकि झूठे गवाह ज़ैना ज़ुलम केरनेरी धुनी मां आन</para>
  <para style="q" vid="PSA 27:12">मेरे खलाफ खड़े भेवरेन।<verse eid="PSA 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />अगर मीं विश्वास न भोथो कि अवं ज़ींतां केरि</para>
  <para style="q" vid="PSA 27:13">धेरती पुड़ यहोवारी भलियाई हेरेलो,</para>
  <para style="q" vid="PSA 27:13">त अवं बेहोश भोइ गाथो।<note caller="-" style="x"><char style="xo" closed="false">27:13 </char><char style="xt" closed="false"><ref loc="PSA 142:5">भज. 142:5</ref>.</char></note><verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />यहोवारे इंतज़ारे मां रेइयां;</para>
  <para style="q" vid="PSA 27:14">हिम्मत रख ते तेरो दिल मज़बूत राए;</para>
  <para style="q" vid="PSA 27:14">हाँ, सिर्फ यहोवारो इंतज़ार केर!<note caller="-" style="x"><char style="xo" closed="false">27:14 </char><char style="xt" closed="false"><ref loc="PSA 31:24">भज. 31:24</ref>.</char></note><verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">बिनती ते शुक्र</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1" />हे यहोवा, अवं तींए कां बिनती केरेलो;</para>
  <para style="q" vid="PSA 28:1">हे मेरी चट्टान, मेरी प्राथना शुन्तां अनशुनी न केर,</para>
  <para style="q" vid="PSA 28:1">एरू न भोए कि तेरे च़ुप राने सेइं</para>
  <para style="q" vid="PSA 28:1">अवं कब्री मां पुज़ोरां केरो ज़ेरो भोइ गेईं, ज़ैना पाताले मां गातन।<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />ज़ैखन अवं तीं कां बिनती केरि,</para>
  <para style="q" vid="PSA 28:2">ते तेरे पवित्र ठारारी एन्त्री हिस्सेरे</para>
  <para style="q" vid="PSA 28:2">ते अपने हथ खड़े केरेलो,</para>
  <para style="q" vid="PSA 28:2">तैखन मेरी बिनती शुन।<verse eid="PSA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />तैन दुष्टां ते अनर्थ केरनेबालन सेइं न घसीट;</para>
  <para style="q" vid="PSA 28:3">ज़ैना अपने पड़ोसन सेइं गल्‍लां त मेल मिलापेरी केरतन,</para>
  <para style="q" vid="PSA 28:3">पन दिले मां बुराई रखतन।<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />तैन केरे कम्मां केरे ते केरनरे बुरैइारे</para>
  <para style="q" vid="PSA 28:4">मुताबिक तैन सेइं बर्ताव केर,</para>
  <para style="q" vid="PSA 28:4">तैन केरे हथ्थां केरे कम्मां केरे मुताबिक तैन बदलो दे;</para>
  <para style="q" vid="PSA 28:4">तैन केरे कम्मां केरो बदलो तैन दे।<verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />किजोकि तैना यहोवारे कम्मन</para>
  <para style="q" vid="PSA 28:5">ते तैसेरे हथ्थेरे कम्मन न समझ़न,</para>
  <para style="q" vid="PSA 28:5">एल्हेरेलेइ परमेशर तैन बिछ़ोड़ेलो ते फिरी खड़ो न केरेलो।<verse eid="PSA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />यहोवा धने;</para>
  <para style="q" vid="PSA 28:6">किजोकि तैने मद्दतरे लेई मेरी बिनती शुनोरीए।<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />यहोवा मेरी ताकत ते मेरी ढाले;</para>
  <para style="q" vid="PSA 28:7">तैस पुड़ भरोसो रखने सेइं मेरे मने मद्दत मैलतीए;</para>
  <para style="q" vid="PSA 28:7">एल्हेरेलेइ मेरो दिल खुशे;</para>
  <para style="q" vid="PSA 28:7">ते अवं गीत ज़ोइतां तैसेरू शुक्र केरेलो।<verse eid="PSA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />यहोवा अपने लोकां केरि शक्तिए,</para>
  <para style="q" vid="PSA 28:8">तै अपने अभिषिक्तेरे लेई मुक्तरू मज़बूत गढ़े।<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />हे यहोवा अपने लोकन मुक्ति दे,</para>
  <para style="q" vid="PSA 28:9">ते अपने विरासतरे लोकन बरकत दे;</para>
  <para style="q" vid="PSA 28:9">ते तैन केरि पुहाली केर ते सदा तैन सुमैलतां रा।<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">परमेशरेरी आवाज़</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1" />हे परमेशरेरे दूतव,<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="fq" closed="false">दूतव </char><char style="ft" closed="false">मट्ठव</char></note> यहोवारी,</para>
  <para style="q" vid="PSA 29:1">हाँ यहोवारी बडीयाई केरा,</para>
  <para style="q" vid="PSA 29:1">यहोवारी महिमा ते सामर्थ सहाराथ।<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />यहोवारे नंव्वेरी महिमा केरा;</para>
  <para style="q" vid="PSA 29:2">पवित्रता सेइं सेज़तां यहोवा कां मथ्थो टेका।<verse eid="PSA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />यहोवारी आवाज़ समुन्दरे करां बा शुनोतीए;</para>
  <para style="q" vid="PSA 29:3">महिमा बालो परमेशर गरज़ते,</para>
  <para style="q" vid="PSA 29:3">यहोवा घने बिदलारी करां बा रहते।<note caller="-" style="x"><char style="xo" closed="false">29:3 </char><char style="xt" closed="false"><ref loc="JOB 37:4-5">अय्यू. 37:4-5</ref>.</char></note><verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />यहोवारे आवाज़ी मां बड़ी शक्तिए,</para>
  <para style="q" vid="PSA 29:4">यहोवारी आवाज़ महिमा बालीए।<verse eid="PSA 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />यहोवारी आवाज़ गैइड़न ट्लोड़चे;</para>
  <para style="q" vid="PSA 29:5">यहोवारी आवाज़ लबानोनेरे गैइड़न भी ट्लोड़चे।<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />तै लबानोनेरे पहाड़न बछ़ड़ेरो ज़ेरो</para>
  <para style="q" vid="PSA 29:6">ते सिर्योन जंगली दांतां केरो ज़ेरो उछ़ड़ाते।<verse eid="PSA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />यहोवारी आवाज़ अग्गरी लप च़ीरतीए।<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />यहोवारी आवाज़ जंगले हिलातीए,</para>
  <para style="q" vid="PSA 29:8">यहोवा कादेशेरे जंगले भी हिलाते।<verse eid="PSA 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />यहोवारे आवाज़ी सेइं हिरनी केरे पेटे मरां कच़्च़े बच्‍चे भी झ़ेड़ी गातन।</para>
  <para style="q" vid="PSA 29:9">ते जंगले मां बुट्टां केरां पट्लां भी झ़ेड़ी गातन;</para>
  <para style="q" vid="PSA 29:9">ते तैसेरे मन्दरे मां हर कोई</para>
  <para style="q" vid="PSA 29:9">“महिमा-महिमा” ज़ोतो रहते।<verse eid="PSA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />हड़ैइयरे वक्ते यहोवा सैलाबे पुड़ बिशोरो थियो;</para>
  <para style="q" vid="PSA 29:10">यहोवा हमेशारे लेई राज़ो भोइतां</para>
  <para style="q" vid="PSA 29:10">तखते पुड़ बिशोरो रहते।<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />यहोवा अपने लोकन ताकत देलो;</para>
  <para style="q" vid="PSA 29:11">यहोवा अपने लोकन सुखेरी बरकत देलो।<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">शुक्रगुज़ेरारी प्राथना</para>
  <para style="d">भवनेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1" />हे यहोवा, अवं तेरी तारीफ़ केरेलो</para>
  <para style="q" vid="PSA 30:1">किजोकि तीं अवं गढे मरां खिचतां कढोरोईं,</para>
  <para style="q" vid="PSA 30:1">ते तीं मेरे दुश्मन मीं पुड़,</para>
  <para style="q" vid="PSA 30:1">खुश भोने नईं दित्तोरोए।<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2" />हे मेरे परमेशर यहोवा,</para>
  <para style="q" vid="PSA 30:2">मीं तीं कां मद्दतरे लेई बिनती की ते तीं मीं चंगाई दित्तोरिए।<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3" />हे यहोवा तीं मेरे प्राण अधलोके मरां कढोरेन,</para>
  <para style="q" vid="PSA 30:3">ते तीं अवं ज़ींतो रखोरोइं,</para>
  <para style="q" vid="PSA 30:3">ते कब्री मां दबने करां बच़वरोईं।<verse eid="PSA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4" />तुस ज़ैना वफादार आथ!</para>
  <para style="q" vid="PSA 30:4">यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 30:4">ते ज़ैस पवित्र नंव्वे सेइं तैसेरी याद भोतीए,</para>
  <para style="q" vid="PSA 30:4">तैसेरू शुक्र केरा।<verse eid="PSA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5" />किजोकि यहोवारो क्रोध त एक्‍की पलेरो भोते,</para>
  <para style="q" vid="PSA 30:5">पन तैसेरी दया सारे उमरारी भोतीए।</para>
  <para style="q" vid="PSA 30:5">शायद राती लेरां देनी पे,</para>
  <para style="q" vid="PSA 30:5">पन झ़ेझ़ां आनन्द भोल्हो।<verse eid="PSA 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6" />मीं त अपने आरामेरे वक्ते अपने आपे सेइं ज़ोवरू थियूं,</para>
  <para style="q" vid="PSA 30:6">कि अवं कधे न टलेलो।<verse eid="PSA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7" />हे यहोवा, अपने दया सेइं तीं मेरू पहाड़ मज़बूत</para>
  <para style="q" vid="PSA 30:7">ते कायम कियोरू थियूं;</para>
  <para style="q" vid="PSA 30:7">ज़ैखन तीं अपनु तुत्तर फिरवं</para>
  <para style="q" vid="PSA 30:7">तैखन अवं बड़ो डेरि जेव।<verse eid="PSA 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8" />हे यहोवा, मीं तू पुकारो;</para>
  <para style="q" vid="PSA 30:8">ते प्रभु कां छंदे केरतां ई बिनती कमाई, कि<verse eid="PSA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9" />ज़ैखन अवं कब्री मां च़लो गेइलो तैखन मेरे मौती सेइं</para>
  <para style="q" vid="PSA 30:9">कुन फैइदो भोल्हो?</para>
  <para style="q" vid="PSA 30:9">कुन मित्ती तेरू शुक्र केरि सकतीए?</para>
  <para style="q" vid="PSA 30:9">कुन तै तेरे सच़्च़े भोनेरो प्रचार केरि सकतीए।<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10" />हे यहोवा, शुन, मीं पुड़ दया केर;</para>
  <para style="q" vid="PSA 30:10">हे यहोवा मेरी मद्दत केर।<verse eid="PSA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11" />तीं मेरो मातम नाच़े मां बदलो;</para>
  <para style="q" vid="PSA 30:11">तीं मेरे मातमेरां लिगड़ां खोलेइतां मेरे कमरी मां</para>
  <para style="q" vid="PSA 30:11">आनन्देरो पटको बन्धोरोए।<verse eid="PSA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12" />ताके मेरो मन तेरू भजन ज़ोतो राए</para>
  <para style="q" vid="PSA 30:12">ते कधी च़ुप न भोए।</para>
  <para style="q" vid="PSA 30:12">हे मेरे परमेशर यहोवा,</para>
  <para style="q" vid="PSA 30:12">अवं हमेशा तेरू शुक्र केरतो रेइलो।<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">परमेशरे पुड़ भरोसेरी प्राथना</para>
  <para style="d">साज़ बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1" />हे यहोवा, मेरो भरोसो तीं पुड़े;</para>
  <para style="q" vid="PSA 31:1">मीं कधी शरमिन्दे न भोने दे;</para>
  <para style="q" vid="PSA 31:1">तू अपने धर्मी भोनेरे वजाई सेइं मीं छुटा!<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2" />अपनो कन मेरे पासे लेइतां,</para>
  <para style="q" vid="PSA 31:2">मीं लूशी छुटा!<note caller="-" style="x"><char style="xo" closed="false">31:2 </char><char style="xt" closed="false"><ref loc="PSA 102:2">भज. 102:2</ref>.</char></note><verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3" />किजोकि तू मेरे लेई चट्टान ते मेरो क़िलोस;</para>
  <para style="q" vid="PSA 31:3">एल्हेरेलेइ अपने नंव्वेरे खातर मेरी अगवाई केर।</para>
  <para style="q" vid="PSA 31:3">ते मीं अग्रोवं च़ला।<verse eid="PSA 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4" />मीं तैस जाले मरां कढ,</para>
  <para style="q" vid="PSA 31:4">ज़ैन तैनेईं मेरे लेई बछ़ावरूए,</para>
  <para style="q" vid="PSA 31:4">किजोकि तूए मेरो मज़बूत क़िलोस।<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5" />अवं अपनि आत्मा तेरे हथ्थे मां सौंफताईं;</para>
  <para style="q" vid="PSA 31:5">हे यहोवा, हे सच़्च़े परमेशर,</para>
  <para style="q" vid="PSA 31:5">तीं अवं घिन्तां आज़ाद कियोरोईं।<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">लूक. 23:46</ref>;<ref loc="ACT 7:59">प्रेरित. 7:59</ref>;<ref loc="1PE 4:19">1 पत. 4:19</ref>.</char></note><verse eid="PSA 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6" />मीं तैन सेइं नफरते,</para>
  <para style="q" vid="PSA 31:6">ज़ैना झूठी मूरती केरि पूज़ा केरतन;</para>
  <para style="q" vid="PSA 31:6">पन मेरो भरोसो यहोवा पुड़े।<note caller="-" style="x"><char style="xo" closed="false">31:6 </char><char style="xt" closed="false"><ref loc="PSA 24:4">भज. 24:4</ref>.</char></note><verse eid="PSA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7" />अवं तेरी दयाई सेइं बड़ो खुशी ते आनन्दे मां रहताईं,</para>
  <para style="q" vid="PSA 31:7">किजोकि तीं मेरे दुखे पुड़ नज़र कियोरीए,</para>
  <para style="q" vid="PSA 31:7">मेरे दुखेरे वक्ते तीं मेरी खबर घिन्नोरीए।<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8" />ते तीं अवं मेरे दुश्मना केरे हथ्थे मां न सौंफी दित्तो;</para>
  <para style="q" vid="PSA 31:8">तीं मेरे पव खुल्‍ली ठैरी रखोरेन।<verse eid="PSA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9" />हे यहोवा, मीं पुड़ दया केर किजोकि अवं मुसीबती मां आईं,</para>
  <para style="q" vid="PSA 31:9">मेरी एछ़्छ़ी बल्के मेरो प्राण</para>
  <para style="q" vid="PSA 31:9">ते जान सब दुखेरे मारे गेली गाचे।<verse eid="PSA 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10" />किजोकि मेरी जान दुखे मां</para>
  <para style="q" vid="PSA 31:10">ते मेरी उमर ओशा छ़डते-छ़डते मुक्‍की जेई;</para>
  <para style="q" vid="PSA 31:10">मेरो ज़ोर मेरे पापेरे वजाई सेइं घटतो राव;</para>
  <para style="q" vid="PSA 31:10">ते मेरी हेड्डी भी गेली जेई।<verse eid="PSA 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11" />अपने सब दुश्मना केरे वजाई सेइं</para>
  <para style="q" vid="PSA 31:11">मेरे पड़ोसन मां मेरी बदनामी भोवरीए,</para>
  <para style="q" vid="PSA 31:11">अवं अपने ज़ान पिशानी बाला केरे लेई डरेरी वजा आईं;</para>
  <para style="q" vid="PSA 31:11">ज़ैना मीं बत्ती मां लातन तैना मीं करां दूर नशतन।<verse eid="PSA 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12" />अवं मुड़देरो ज़ेरो लोकां केरे मने मरां बिसरी जेव,</para>
  <para style="q" vid="PSA 31:12">अवं त ट्लुटोरे भांडेरो ज़ेरो भोवरोईं।<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13" />मीं बड़े लोकन करां अपनि निन्दा शुनोरीए,</para>
  <para style="q" vid="PSA 31:13">च़ेवरे पासन डरे-डरे!</para>
  <para style="q" vid="PSA 31:13">ज़ैखन तैनेईं मिलतां सलाह कियोरीए,</para>
  <para style="q" vid="PSA 31:13">तैखन मेरी जान खतम केरनेरी योजना की।<verse eid="PSA 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14" />पन हे यहोवा, मेरो भरोसो सिर्फ तींए पुड़े,</para>
  <para style="q" vid="PSA 31:14">मीं ज़ोवं, “तू मेरो परमेशरस।”<verse eid="PSA 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15" />मेरे दिहाड़े तेरे हथ्थे मां आन;</para>
  <para style="q" vid="PSA 31:15">तू मीं मेरे दुश्मन्न</para>
  <para style="q" vid="PSA 31:15">ते मेरे सताने बालां केरे हथ्थे मरां छुटा।<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16" />ते अपने तुत्तरेरी लौ अपने दासे पुड़ चमका;</para>
  <para style="q" vid="PSA 31:16">अपने करुणाई सेइं मीं बच़ा।<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17" />हे यहोवा, मीं शरमिन्दा न भोने दे,</para>
  <para style="q" vid="PSA 31:17">किजोकि मीं तींए कां प्राथना कियोरीए;</para>
  <para style="q" vid="PSA 31:17">दुष्ट लोक शरमिन्दा भोन</para>
  <para style="q" vid="PSA 31:17">ते तैना पाताले मां च़ुपच़ाप पेवरे रान।<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18" />ज़ैना घमण्डे ते बेइज़्ज़ती सेइं धर्मी मैन्हेरी निन्दा केरतन,</para>
  <para style="q" vid="PSA 31:18">तैन केरे झूठ ज़ोनेबाले ओठ बन्द किये गान।<note caller="-" style="x"><char style="xo" closed="false">31:18 </char><char style="xt" closed="false"><ref loc="PSA 94:4">भज. 94:4</ref>;<ref loc="PSA 120:2">120:2</ref>.</char></note><verse eid="PSA 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19" />ओ, तेरी भलियाई केत्री बड्डीए</para>
  <para style="q" vid="PSA 31:19">ज़ै तीं अपने डरने बालां केरे लेई रख्खोरीए,</para>
  <para style="q" vid="PSA 31:19">ते अपने भरोसो रखनेबालां केरे लेई मैन्हु केरे</para>
  <para style="q" vid="PSA 31:19">सामने बांदी भी कियोरीए।<verse eid="PSA 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20" />तू तैन दर्शन देनेरे छ़ेपोरी ठारी मां</para>
  <para style="q" vid="PSA 31:20">मैन्हु केरि बुरी मेण्डली करां छ़ुपेइतां रखेलो;</para>
  <para style="q" vid="PSA 31:20">तू तैन्न अपने डेरे मां लड़ैई करां</para>
  <para style="q" vid="PSA 31:20">छ़ुपेइतां रखेलो<verse eid="PSA 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21" />धने यहोवा,</para>
  <para style="q" vid="PSA 31:21">किजोकि तैनी अवं क़िले बाले नगरे मां रेखतां</para>
  <para style="q" vid="PSA 31:21">मीं पुड़ बड़ी करुणा कियोरीए।<verse eid="PSA 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22" />मीं त घबरेइतां ज़ोवरू थियूं कि</para>
  <para style="q" vid="PSA 31:22">अवं यहोवारी नज़री करां दूर भोइ जेव।</para>
  <para style="q" vid="PSA 31:22">फिरी भी ज़ैखन अवं तीं कां बिनती केरि,</para>
  <para style="q" vid="PSA 31:22">तैखन तीं मेरी बिनतरी आवाज़ शुनी।<verse eid="PSA 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23" />हे यहोवारे सब भक्तव, तैस सेइं प्यार रखा!</para>
  <para style="q" vid="PSA 31:23">यहोवा ईमानदार लोकां केरि त हिफाज़त केरते,</para>
  <para style="q" vid="PSA 31:23">पन ज़ै घमण्ड केरते,</para>
  <para style="q" vid="PSA 31:23">तैस तै रोड़े-च़ारे बदलो देते।<verse eid="PSA 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24" />हे यहोवा पुड़ उमीद रखने बालव,</para>
  <para style="q" vid="PSA 31:24">सब मज़बूत भोथ ते तुश्शे दिल भी मज़बूत भोन।<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">माफ़ी हासिल केरनेरी बरकत</para>
  <para style="d">दाऊदेरो भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1" />केत्रो धने तै ज़ेसेरे जुर्म माफ़ किये जे,</para>
  <para style="q" vid="PSA 32:1">ते ज़ेसेरे पाप माफ़ भोइ जे।</para>
  <para style="q" vid="PSA 32:1">ते ज़ेसेरे पाप ढक्‍के जेवरे भोन।<note caller="-" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="ROM 4:7">रोम. 4:7</ref>.</char></note><verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />केत्रो धने तै मैन्हु ज़ेसेरे बुरे कम्मां केरो</para>
  <para style="q" vid="PSA 32:2">हिसाबे यहोवा न ने,</para>
  <para style="q" vid="PSA 32:2">ते कने ज़ेसेरे दिले मां कपट नईं।<note caller="-" style="x"><char style="xo" closed="false">32:2 </char><char style="xt" closed="false"><ref loc="ROM 4:8">रोम. 4:8</ref>.</char></note><verse eid="PSA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />ज़ैखन अवं च़ुप राव</para>
  <para style="q" vid="PSA 32:3">त सैरी दिहैड़ी करलाते-करलाते</para>
  <para style="q" vid="PSA 32:3">मेरी हेड्डी गेली जेई।<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />किजोकि तेरो हथ रात दिहैड़ी मीं पुड़ भारी थियो,</para>
  <para style="q" vid="PSA 32:4">ते मेरी ताकत गेर्मरे वजाई सेइं</para>
  <para style="q" vid="PSA 32:4">शुक्‍की जेई। <char style="qs">(सेला) </char><verse eid="PSA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />ज़ैखन मीं अपनो पाप तीं पुड़ बांदो कियो</para>
  <para style="q" vid="PSA 32:5">ते अपनो अधर्म न छ़ुपाव,</para>
  <para style="q" vid="PSA 32:5">ते ज़ोवं, “अवं यहोवारे सामने अपने पाप मन्नेलो,”</para>
  <para style="q" vid="PSA 32:5">तैखन तीं मेरे अधर्म ते पाप माफ़ किये। <char style="qs">(सेला) </char><verse eid="PSA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />एल्हेरेलेइ हर भक्त तीं करां एरे मौके पुड़</para>
  <para style="q" vid="PSA 32:6">प्राथना केरे, ज़ैखन तू मैल्ही सकस।</para>
  <para style="q" vid="PSA 32:6">सच़्च़े ज़ैखन सैलाब एज्जे,</para>
  <para style="q" vid="PSA 32:6">त तैस मौके तैस भक्ते कां न पुज़ेलो।<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />तू मेरे छ़पनेरी ठारस;</para>
  <para style="q" vid="PSA 32:7">तू मीं मुसीबती करां बच़ेइतां रखेलो;</para>
  <para style="q" vid="PSA 32:7">तू मीं छुटकारेरे गीतन सेइं घेरतां</para>
  <para style="q" vid="PSA 32:7">रखेलो। <char style="qs">(सेला) </char><verse eid="PSA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />अवं तीं अक्ल देइलो, कने ज़ैस बत्तां तीं</para>
  <para style="q" vid="PSA 32:8">च़लनू भोल्हु, तैस मां तेरी अगवाई केरेलो;</para>
  <para style="q" vid="PSA 32:8">अवं तीं पुड़ सिद्धी नज़र रेखेलो</para>
  <para style="q" vid="PSA 32:8">ते सलाह देतो रेइलो।<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />तुस घोड़े ते खचरां केरे ज़ेरे न बना ज़ैन समझ़ न भोए,</para>
  <para style="q" vid="PSA 32:9">ज़ैना लगाम ते रेस्सी सेइं रोकने पेतन,</para>
  <para style="q" vid="PSA 32:9">नईं त तैना तेरे कैबू मां नईं एजने बाले।<verse eid="PSA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />दुष्टे त बड़ी तकलीफ भोल्ही;</para>
  <para style="q" vid="PSA 32:10">पन ज़ेसेरो भरोसो यहोवा पुड़े</para>
  <para style="q" vid="PSA 32:10">तैसेरी करुणा तैस घेरतां रखेली।<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />हे धर्मी लोकव यहोवारे वजाई सेइं खुश,</para>
  <para style="q" vid="PSA 32:11">ते मघन भोथ, ते हे सब सिद्धे मने बालव</para>
  <para style="q" vid="PSA 32:11">आनन्दे सेइं जयजयकार केरा!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">परमेशरेरे तारीफ़रू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />हे धर्मी लोकव, यहोवारे वजाई सेइं जयजयकार केरा।</para>
  <para style="q" vid="PSA 33:1">किजोकि धर्मी लोकन तारीफ़ केरनी शोभतीए।<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />सितार बज़ेइतां यहोवारू शुक्र केरा,</para>
  <para style="q" vid="PSA 33:2">दश तारी बाली सारंगी बज़ेइतां</para>
  <para style="q" vid="PSA 33:2">तैसेरू भजन ज़ोथ।<note caller="-" style="x"><char style="xo" closed="false">33:2 </char><char style="xt" closed="false"><ref loc="EPH 5:19">इफि. 5:19</ref>.</char></note><verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />यहोवारे लेई नंव्वू गीत ज़ोथ,</para>
  <para style="q" vid="PSA 33:3">जयजयकारे सेइं रोड़ेच़ारे बज़ाथ।<note caller="-" style="x"><char style="xo" closed="false">33:3 </char><char style="xt" closed="false"><ref loc="REV 14:3">प्रका. 14:3</ref>.</char></note><verse eid="PSA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />किजोकि यहोवारू वचन सच़्च़ू आहे;</para>
  <para style="q" vid="PSA 33:4">ते तैसेरां सब कम्मां बगैर तरफदैरी सेइं आन।<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />तैस धार्मिकता ते न्याय बड़ो ट्लारोए;</para>
  <para style="q" vid="PSA 33:5">यहोवारे करुणाई सेइं धरती भरपूरे।<verse eid="PSA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />यहोवारे वचने सेइं अम्बर,</para>
  <para style="q" vid="PSA 33:6">ते तैसेरे सारे तारे तैसेरे ऐशेरे</para>
  <para style="q" vid="PSA 33:6">सांसी सेइं बने।<note caller="-" style="x"><char style="xo" closed="false">33:6 </char><char style="xt" closed="false"><ref loc="HEB 11:3">इब्रा. 11:3</ref>.</char></note><verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />तै समुन्दरेरू पानी ढेरेरू ज़ेरू अकोट्ठू केरते;</para>
  <para style="q" vid="PSA 33:7">तै डुग्घे पैनी अपने भण्डारे मां रखते।<verse eid="PSA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />सारे दुनियारे लोक यहोवा करां डरन,</para>
  <para style="q" vid="PSA 33:8">दुनियारे सब रानेबाले तैसेरो डर मन्न!<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />किजोकि तैनी ज़ेरू ज़ोवं त तैखने भोवं;</para>
  <para style="q" vid="PSA 33:9">ज़ैखन तैनी हुक्म दित्तो,</para>
  <para style="q" vid="PSA 33:9">त तैखन हकीकति मां सब किछ लेइहोने लग्गू।<verse eid="PSA 33:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />यहोवा कौमां-कौमां केरि योजना</para>
  <para style="q" vid="PSA 33:10">बेकार केरते;</para>
  <para style="q" vid="PSA 33:10">तै मुल्खे मुल्खेरे लोकां केरे खियाल</para>
  <para style="q" vid="PSA 33:10">बेफल केरते।<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />यहोवारी योजना हमेशा बनोरी राली,</para>
  <para style="q" vid="PSA 33:11">तैसेरे मनेरे खियाल पीढ़ी-पीढ़ी</para>
  <para style="q" vid="PSA 33:11">तगर बनोरे राले।<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />केत्रो धने तै राष्ट्र ज़ेसेरो परमेशर</para>
  <para style="q" vid="PSA 33:12">यहोवा आहे</para>
  <para style="q" vid="PSA 33:12">ते तैन समाज ज़ैन तैनी अपनो खास हिस्सो</para>
  <para style="q" vid="PSA 33:12">भोनेरे लेई च़ुनोरू भोए!<verse eid="PSA 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />यहोवा अम्बरे मरां नज़र केरते,</para>
  <para style="q" vid="PSA 33:13">तै सेभी लोकन तकते;<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />अपने रानेरी ठारी मरां</para>
  <para style="q" vid="PSA 33:14">तै धेरती पुड़ सब रानेबालन तकते।<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />तैए ज़ै सेभी केरे दिलन बनाते,</para>
  <para style="q" vid="PSA 33:15">तै तैन केरे सेभी कम्मन पुड़ ध्यान देते।<verse eid="PSA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />कोई एरहो राज़ो नईं, ज़ै बड़ी</para>
  <para style="q" vid="PSA 33:16">सेना भोनेरे वजाई सेइं बच़े;</para>
  <para style="q" vid="PSA 33:16">बहादर अपने बड़े ताकतरे वजाई सेइं छुट्टी न सके।<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />ज़ींत हासिल केरनेरे लेई घोड़ो बेफैइदी हिफाज़ते,</para>
  <para style="q" vid="PSA 33:17">तै अपने बड़े ताकतरे वजाई सेइं कोन्ची</para>
  <para style="q" vid="PSA 33:17">न बच़ेइ सके।<verse eid="PSA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />हेरा, यहोवारी नज़र तैसेरो डर मन्ने बालन पुड़</para>
  <para style="q" vid="PSA 33:18">ते तैन पुड़ ज़ैना तैसेरी करुणारी उमीद रखतन,</para>
  <para style="q" vid="PSA 33:18">बनोरी रहतीए,<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />कि तै तैन केरि जान मौती करां बच़ाए,</para>
  <para style="q" vid="PSA 33:19">ते काल पेनेरे वक्ते तैन ज़ींते रख्खे।<verse eid="PSA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />अस यहोवा बलगतम,</para>
  <para style="q" vid="PSA 33:20">तै इश्शी मद्दत केरनेबालो ते इश्शी ढाल ठहरोरोए।<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />इश्शे दिल यहोवारे वजाई सेइं खुश भोल्हे,</para>
  <para style="q" vid="PSA 33:21">किजोकि असेईं तैसेरे पवित्र नंव्वे पुड़ भरोसो रखोरोए।<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />हे यहोवा, ज़ेन्च़रे तीं पुड़ इश्शी उमीदे,</para>
  <para style="q" vid="PSA 33:22">तेन्च़रे तेरी करुणा भी असन पुड़ भोए।<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">परमेशर धर्मी मैन्हु मुक्ति देनेबालोए</para>
  <para style="d">दाऊदेरू भजन ज़ैखन तैनी अबीमेलेकेरे सामने अपनि शकल बदली, ते अबीमेलेके तै कढो, ते तै च़लो जेव:</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1" />अवं हर वक्त यहोवारू शुक्र केरेलो;</para>
  <para style="q" vid="PSA 34:1">ते तैसेरी तारीफ़ लगातार मेरी ज़बानी पुड़ राहेली।<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2" />अवं यहोवा पुड़ घमण्ड केरेलो;</para>
  <para style="q" vid="PSA 34:2">हलीम लोक एन शुन्तां खुशी भोल्हे।<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3" />मीं सेइं साथी यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 34:3">ते एज्जा अस मिलतां तैसेरे नंव्वेरी तारीफ़ केरम;<verse eid="PSA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4" />मीं यहोवा कां प्राथना की,</para>
  <para style="q" vid="PSA 34:4">तैखन तैनी मेरी बिनती शुनी,</para>
  <para style="q" vid="PSA 34:4">ते तैने अवं मेरे सारे डरे करां छुटाव।<verse eid="PSA 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5" />ज़ैन केरि एछ़्छ़ी तैसेरे पासे लेगोरी रेइ,</para>
  <para style="q" vid="PSA 34:5">तैन लौ मैल्ही;</para>
  <para style="q" vid="PSA 34:5">ते तैन केरे तुत्तरे पुड़ कधे शर्मिन्दगी न एज्जेली।<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6" />इनी गरीब मैन्हे प्राथना की तैखन यहोवा शुनू,</para>
  <para style="q" vid="PSA 34:6">तैनी तैस तैसेरी सारे दुखन करां छुटकारो दित्तो।<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7" />यहोवारो डर मन्नेबालां केरे च़ेवरे पासन तैसेरो दूत</para>
  <para style="q" vid="PSA 34:7">डेरे लेइतां तैस खतरे करां बच़ाते।<note caller="-" style="x"><char style="xo" closed="false">34:7 </char><char style="xt" closed="false"><ref loc="HEB 1:14">इब्रा. 1:14</ref>;<ref loc="DAN 6:22">दान. 6:22</ref>.</char></note><verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8" />अज़मेइतां हेरा कि यहोवा केत्रो भलोए!</para>
  <para style="q" vid="PSA 34:8">केत्रो धने तै मैन्हु ज़ै तैस पुड़ भरोसो रखते।<note caller="-" style="x"><char style="xo" closed="false">34:8 </char><char style="xt" closed="false"><ref loc="1PE 2:3">1 पत. 2:3</ref>.</char></note><verse eid="PSA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9" />यहोवा करां डरा, हे तैसेरे पवित्र लोकव!</para>
  <para style="q" vid="PSA 34:9">किजोकि ज़ैना तैसेरो डर मनतन, तैन कोन्ची गल्‍लरो घाटो न भोए!<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10" />जुवान शेरन त कमी भोतीए</para>
  <para style="q" vid="PSA 34:10">ते तैना ढ्लुखोरे भी रहतन;</para>
  <para style="q" vid="PSA 34:10">पन यहोवारे तोप्पने बालन कोन्ची रोड़ी</para>
  <para style="q" vid="PSA 34:10">चीज़रे घटी न भोल्ही।<verse eid="PSA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11" />हे बच्‍चव, एज्जा मेरी गल्‍लां शुना;</para>
  <para style="q" vid="PSA 34:11">अवं तुसन यहोवारो डर मन्नो शिखालेलो।<verse eid="PSA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12" />कौन मैन्हु आहे ज़ै ज़िन्दगरी इच्छा रखते,</para>
  <para style="q" vid="PSA 34:12">ते कने लम्मी उमर चाते कि भलियाई हेरे,<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13" />त तै अपनि ज़बान बुरी गल्‍लां केरने करां बाज़ रख्खे</para>
  <para style="q" vid="PSA 34:13">ते अपने ऐशेरी खबरदारी केरे कि</para>
  <para style="q" vid="PSA 34:13">तैस करां कोई धोखेरी गल न निस्से।<note caller="-" style="x"><char style="xo" closed="false">34:13 </char><char style="xt" closed="false"><ref loc="JAS 1:26">याक. 1:26</ref>.</char></note><verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14" />बुराई शैरतां भलियाई केर;</para>
  <para style="q" vid="PSA 34:14">मेल मिलापे तोप ते तैसेरो पीछो केर।<note caller="-" style="x"><char style="xo" closed="false">34:14 </char><char style="xt" closed="false"><ref loc="HEB 12:14">इब्रा. 12:14</ref>.</char></note><verse eid="PSA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15" />यहोवारी एछ़्छ़ी धेर्मी लोकन पुड़ लेगोरी रेइचन,</para>
  <para style="q" vid="PSA 34:15">ते तैसेरे कन तैन केरि बिनती पुड़</para>
  <para style="q" vid="PSA 34:15">लग्गोरे रहतन।<note caller="-" style="x"><char style="xo" closed="false">34:15 </char><char style="xt" closed="false"><ref loc="JHN 9:31">यूह. 9:31</ref>.</char></note><verse eid="PSA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16" />यहोवा बुराई केरनेबालां केरे खलाफ भोते,</para>
  <para style="q" vid="PSA 34:16">ताके तैन केरि याद धेरती पुड़ां मिटेई छ़डे।<note caller="-" style="x"><char style="xo" closed="false">34:16 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1 पत. 3:10-12</ref>.</char></note><verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17" />धर्मी लोक बिनती केरतन ते यहोवा शुनते,</para>
  <para style="q" vid="PSA 34:17">ते तै तैन सैरी मुसीबतन करां छुटकारो देते।<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18" />यहोवा ट्लुटोरे दिलां केरे नेड़े रहते,</para>
  <para style="q" vid="PSA 34:18">ज़ैन उमीद नईं तैन्न छुटकारो देते।<verse eid="PSA 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19" />धेर्मी पुड़ बेड़ी मुसीबतां त एइतन,</para>
  <para style="q" vid="PSA 34:19">पन यहोवा तैस तैन सेभन करां</para>
  <para style="q" vid="PSA 34:19">छुटकारो देते।<note caller="-" style="x"><char style="xo" closed="false">34:19 </char><char style="xt" closed="false"><ref loc="PRO 24:16">कह. 24:16</ref>;<ref loc="1TI 3:11">1 तीम. 3:11</ref>.</char></note><verse eid="PSA 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20" />तै तैसेरी सेभी हेड्डी केरि हिफाज़त केरते;</para>
  <para style="q" vid="PSA 34:20">ते तैन मरां अक भी ट्लोड़ी न गाए।<note caller="-" style="x"><char style="xo" closed="false">34:20 </char><char style="xt" closed="false"><ref loc="JHN 19:36">यूह. 19:36</ref>.</char></note><verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21" />बुरो मैन्हु बुरैइयरे कम्मन सेइं मारो गालो,</para>
  <para style="q" vid="PSA 34:21">ते धेर्मी सेइं बैर रखनेबाले दोषी भोल्हे।<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22" />यहोवा अपने दासां केरि जान कीमत देइतां बच़ाते;</para>
  <para style="q" vid="PSA 34:22">ते ज़ेत्रे तैस पुड़ भरोसो रखतन</para>
  <para style="q" vid="PSA 34:22">तैन मरां कोई भी दोषी न ठहरेलो।<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">ज़ींतनेरे लेई प्राथना</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1" />हे यहोवा, ज़ैना मेरे खलाफ खड़े भोतन,</para>
  <para style="q" vid="PSA 35:1">तू भी तैन केरे खलाफ खड़ो भोए;</para>
  <para style="q" vid="PSA 35:1">ज़ैना मीं सेइं जंग केरतन, तैन सेइं तू भी जंग लड़।<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />ढाल ते भालो नेइतां मेरी मद्दत केरनेरे लेई</para>
  <para style="q" vid="PSA 35:2">खड़ो भो।<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />भालो ट्ला ते मेरो पीछो केरनेबालां केरे</para>
  <para style="q" vid="PSA 35:3">सामने एइतां तैन रोक;</para>
  <para style="q" vid="PSA 35:3">ते मीं सेइं ज़ो,</para>
  <para style="q" vid="PSA 35:3">कि अवं तेरी मुक्ति आईं।<verse eid="PSA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />ज़ैना मीं मारनेरे कोशिशी मां आन,</para>
  <para style="q" vid="PSA 35:4">तैना शरमिन्दा ते बेइज़्ज़त भोन!</para>
  <para style="q" vid="PSA 35:4">ज़ैना मेरे नुक्सानेरो खियाल केरतन,</para>
  <para style="q" vid="PSA 35:4">तैना पत्रोवं हटाए गान ते तैन केरू तुत्तर कालू भोए!<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />तैना हवाई मां भूंसेरे ज़ेरे उडरी गानेबाले भोन,</para>
  <para style="q" vid="PSA 35:5">ते यहोवारो दूत तैन पत्ती पे।<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />तैन केरि बत आंधरी ते घिशकनेरी भोए।</para>
  <para style="q" vid="PSA 35:6">ते यहोवारो दूत तैन निशानतो गाए।<verse eid="PSA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />किजोकि तैनेईं छ़ेपतां बगैर वजां मेरी बत्ती मां</para>
  <para style="q" vid="PSA 35:7">ज़ाल बिछ़ाव;</para>
  <para style="q" vid="PSA 35:7">बगैर वजां तैनेईं मेरी जान नेनेरे</para>
  <para style="q" vid="PSA 35:7">लेई खड्डो घड़ोरोए।<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />अचानक तैन पुड़ मुसीबत एज्जी गाए!</para>
  <para style="q" vid="PSA 35:8">ज़ैन ज़ाल तैनेईं मेरे लेई बछ़ावरूए</para>
  <para style="q" vid="PSA 35:8">तैस मां तैना एप्पु फसन;</para>
  <para style="q" vid="PSA 35:8">ते तैस मुसीबती मां तैना एप्पु फसन!<note caller="-" style="x"><char style="xo" closed="false">35:8 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">रोम. 11:9-10</ref>;<ref loc="1TH 5:3">1 थिस. 5:3</ref>.</char></note><verse eid="PSA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />पन अवं यहोवारे वजाई सेइं अपने</para>
  <para style="q" vid="PSA 35:9">मने मां मघन भोइलो,</para>
  <para style="q" vid="PSA 35:9">अवं तैसेरे कियोरे मुक्ति सेइं खुशी मनेइलो।<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />अवं अपने दिले सेइं ज़ोलो,</para>
  <para style="q" vid="PSA 35:10">“हे यहोवा, तेरे बराबर कौने,</para>
  <para style="q" vid="PSA 35:10">ज़ै गरीबे बड़े-बड़े ताकतबरन करां बच़ाते,</para>
  <para style="q" vid="PSA 35:10">ते गरीब लोकां केरि लुटेरन करां हिफाज़त केरते?”<verse eid="PSA 35:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />झूठे गवाह मेरे खलाफ खड़े भोतन,</para>
  <para style="q" vid="PSA 35:11">तैना मीं पुड़ झूठो इलज़ाम लातन।<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />तैना मेरी भलियाई केरनेरे बदले बुराई केरतन,</para>
  <para style="q" vid="PSA 35:12">इड़ी तगर कि मेरे प्राण थेकी गातन।<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />ज़ैखन तैना बिमार थिये त मीं टाट पलेटतां</para>
  <para style="q" vid="PSA 35:13">ते बरत रेखतां एपनी जानी दुख दित्तो;</para>
  <para style="q" vid="PSA 35:13">मीं मेरी प्राथनारो जुवाब न मैल्हो।<note caller="+" style="f"><char style="fr" closed="false">35:13 </char><char style="ft" closed="false">टाट पलैटनू ते रोट्टी बगैर रानू अपनो दुख हिरानेरे लेई लोक इन केरते थिये।</char></note><verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />मीं त एरू कियूं कि ज़ेन्च़रे तैना,</para>
  <para style="q" vid="PSA 35:14">मेरे साथी या ढ्लान; ज़ेन्च़रे कोई अम्मरे लेई</para>
  <para style="q" vid="PSA 35:14">शोग केरतो भोए, तेन्च़रे मीं शोगेरां</para>
  <para style="q" vid="PSA 35:14">लिगड़ां लेइतां क्रोड़ी लेकतां शोग कियो।<verse eid="PSA 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />पन ज़ैखन लंगड़ाने लगो तैखन तैना</para>
  <para style="q" vid="PSA 35:15">दुश्मन लोक खुशी भोइतां सारे मेरे खलाफ अकोट्ठे भोए;</para>
  <para style="q" vid="PSA 35:15">नीच़ लोक ते ज़ैन अवं ज़ानतो भी न थियो</para>
  <para style="q" vid="PSA 35:15">तैना मेरे खलाफ अकोट्ठे भोए; तैना मीं लगातार छ़िन्दते राए;<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />आदरारे बगैर तैना मेरो मज़ाक बनातन;</para>
  <para style="q" vid="PSA 35:16">ते मीं पुड़ दंत कटतन।<note caller="-" style="x"><char style="xo" closed="false">35:16 </char><char style="xt" closed="false"><ref loc="PSA 37:12">भज. 37:12</ref>.</char></note><verse eid="PSA 35:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />हे प्रभु, तू केइस तगर च़ुपच़ारे तकतो रालो?</para>
  <para style="q" vid="PSA 35:17">इस मुसीबती करां, ज़ैस मां तैनेईं</para>
  <para style="q" vid="PSA 35:17">अवं छ़डोरोईं मीं बच़ा!</para>
  <para style="q" vid="PSA 35:17">जुवान शेरन करां मेरे प्राण बच़ा!<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />तैखन अवं हछ्छे लोकन मां तेरू शुक्र केरेलो;</para>
  <para style="q" vid="PSA 35:18">बड़े लोकन मां अवं तेरी तारीफ़ केरेलो।<verse eid="PSA 35:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />झूठ ज़ोनेबाले मेरे दुश्मन मेरे खलाफ</para>
  <para style="q" vid="PSA 35:19">आनन्द न केरि सकन,</para>
  <para style="q" vid="PSA 35:19">ज़ैना मीं सेइं बगैर वजां बैर रखतन,</para>
  <para style="q" vid="PSA 35:19">तैना एप्पु मांमेइं इशारो न केरि सकन।<note caller="-" style="x"><char style="xo" closed="false">35:19 </char><char style="xt" closed="false"><ref loc="JHN 15:25">यूह. 15:25</ref>;<ref loc="PSA 69:4">भज. 69:4</ref>.</char></note><verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />किजोकि तैना मेल मिलापेरी गल्‍लां न ज़ोन,</para>
  <para style="q" vid="PSA 35:20">बल्के ज़ैना मुल्खे मां च़ुपच़ाप रहतन,</para>
  <para style="q" vid="PSA 35:20">तैन केरे खलाफ धोखेरे खियाल केरतन।<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />तैनेईं आशी खोलतां मेरे खलाफ ज़ोवं,</para>
  <para style="q" vid="PSA 35:21">“अहा! अहा! असेईं एपनी एछ़्छ़न सेइं लावं।”<verse eid="PSA 35:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />हे यहोवा, तीं त हेरोरू; च़ुप न रा!</para>
  <para style="q" vid="PSA 35:22">हे प्रभु, मीं करां दूर न रा!<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />उठ, मेरो न्याय केरनेरे लेई बींझ़,</para>
  <para style="q" vid="PSA 35:23">हे मेरे परमेशर, हे मेरे प्रभु,</para>
  <para style="q" vid="PSA 35:23">मेरो मुकदमो खतम केरनेरे लेई एई!<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />हे मेरे परमेशर यहोवा,</para>
  <para style="q" vid="PSA 35:24">तू अपने धार्मिकतारे मुताबिक मेरो न्याय केर;</para>
  <para style="q" vid="PSA 35:24">ते तैन्न मेरे खलाफ आनन्द केरने न दे!<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />तैना दिले मां एन न सोचन,</para>
  <para style="q" vid="PSA 35:25">“आहा! इश्शो इरादो पूरो भोव!”</para>
  <para style="q" vid="PSA 35:25">तैना इन न ज़ोन, “असेईं तै निगलो।”<verse eid="PSA 35:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />ज़ैना मेरो नुकसान लेइतां खुशी भोतन</para>
  <para style="q" vid="PSA 35:26">शरमरे मारे तैन सेभी केरां तुत्तरां कालां भोन!</para>
  <para style="q" vid="PSA 35:26">ज़ैना मेरे खलाफ बड़कां मारतन</para>
  <para style="q" vid="PSA 35:26">तैना शरमिन्दा ते बेइज़्ज़ती सेइं तुत्तर देनेरे न रान।<verse eid="PSA 35:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />पन ज़ैना मेरे भले कम्मन सेइं खुशी भोतन,</para>
  <para style="q" vid="PSA 35:27">तैना जयजयकार ते आनन्द मनान,</para>
  <para style="q" vid="PSA 35:27">ते लगातार ज़ोते रान, यहोवारी तारीफ़ भोए,</para>
  <para style="q" vid="PSA 35:27">ज़ै अपने सेवकेरे सुखे सेइं खुश भोते!<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />तैखन मेरी ज़बान तेरे धर्मेरू बियान केरेली,</para>
  <para style="q" vid="PSA 35:28">सैरी दिहैड़ी तेरी तारीफ़ निसती राली।<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">परमेशरेरो प्यार ते मैन्हु केरि बुराई</para>
  <para style="d">साज़ बज़ानेबालां केरे प्रधानेरे लेई यहोवारे दास दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />दुष्टी मैन्हेरो पाप तैसेरे दिले मां ज़ोते;</para>
  <para style="q" vid="PSA 36:1">परमेशरेरो डर तैसेरे नज़री मां नईं।<note caller="+" style="f"><char style="fr" closed="false">36:1 </char><char style="ft" closed="false">रोम. 3:18.</char></note><verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2" />तै अपने अधर्मे बांदे भोने</para>
  <para style="q" vid="PSA 36:2">ते भिट्टो ठहरनेरे बारे मां</para>
  <para style="q" vid="PSA 36:2">ते मने मां धोखो देनेरी गल्‍लां सोचते।<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3" />तैसेरी गल्‍लां अनर्थ ते धोखेरी आन;</para>
  <para style="q" vid="PSA 36:3">तैनी अक्ल ते भलां कम्मां केरने करां</para>
  <para style="q" vid="PSA 36:3">हथ खड़े किये।<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4" />अपने बिछ़ाने पुड़ तै</para>
  <para style="q" vid="PSA 36:4">अनर्थ कम केरनेरे बारे मां सोचते;</para>
  <para style="q" vid="PSA 36:4">तै अपने बुरे बत्ती पुड़ मज़बूती सेइं बनोरो रहते;</para>
  <para style="q" vid="PSA 36:4">तै बुरैई सेइं नफरत न केरे।<verse eid="PSA 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5" />हे यहोवा तेरी दया सुर्गे मांए,</para>
  <para style="q" vid="PSA 36:5">तेरी सच़्च़ाई अम्बरे तगर पुज़ोरीए।<verse eid="PSA 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6" />तेरो धर्म उच्‍चे पहाड़ां केरो ज़ेरोए,</para>
  <para style="q" vid="PSA 36:6">ते तेरो न्याय समुद्रेरे डुग्घारेरो ज़ेरोए;</para>
  <para style="q" vid="PSA 36:6">हे यहोवा, तू इन्सान ते हैवान दूईयां केरि</para>
  <para style="q" vid="PSA 36:6">रक्षा केरतस।<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7" />हे परमेशर, तेरी दया केत्री कीमतीए!</para>
  <para style="q" vid="PSA 36:7">मैन्हु तेरे फंघां केरे छावी हैठ छ़पतन।<verse eid="PSA 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8" />तैना तेरे घरेरी<note caller="+" style="f"><char style="fr" closed="false">36:8 </char><char style="fq" closed="false">घरेरी </char><char style="ft" closed="false">मन्दर</char></note> रोट्टरे,</para>
  <para style="q" vid="PSA 36:8">बड़े जादे भोने सेइं रज़्ज़ेले।</para>
  <para style="q" vid="PSA 36:8">ते तू अपने सुखेरे दरियाए</para>
  <para style="q" vid="PSA 36:8">मरां तैन पियालो<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9" />किजोकि ज़िन्दगरो नाग तींए कांए;</para>
  <para style="q" vid="PSA 36:9">ते असन तेरे लोई सेइं लौ मैल्हेली।<note caller="-" style="x"><char style="xo" closed="false">36:9 </char><char style="xt" closed="false"><ref loc="JHN 4:10">यूह. 4:10</ref>,<ref loc="JHN 4:14">14</ref>;<ref loc="REV 21:6">प्रका. 21:6</ref>.</char></note><verse eid="PSA 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10" />अपने ज़ान्ने बालन पुड़ दया केरतो रा,</para>
  <para style="q" vid="PSA 36:10">ते अपना धार्मिकतारां कम्मां</para>
  <para style="q" vid="PSA 36:10">सिद्धे मने बालन मां केरतो रा!<verse eid="PSA 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11" />घमण्डी मीं पुड़ लत खड़ी न केरि बटन,</para>
  <para style="q" vid="PSA 36:11">ते दुष्ट अपने हथ्थेरे</para>
  <para style="q" vid="PSA 36:11">ताकती सेइं मीं निशैनी न बटे।<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12" />हेरा, अनर्थ केरनेबाले बिछ़ड़ी जेवरेन;</para>
  <para style="q" vid="PSA 36:12">तैन ढ्लैक दित्ती जेई, ते फिरी उठी न सकेले।<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">धर्मी मैन्हेरी विरासत ते दुष्टां केरो अन्त</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1" />बुरां कम्मां केरनेबालां केरे वजाई सेइं न कुढ़</para>
  <para style="q" vid="PSA 37:1">बुराई केरनेबालां केरे बारे मां जलन न केर!<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />किजोकि तैना घासेरे ज़ेरे लूशी कट्टे गानेन,</para>
  <para style="q" vid="PSA 37:2">ते सब्ज़ घासेरे ज़ेरे लूशी ट्लेक्‍की गानेन।<verse eid="PSA 37:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />यहोवा पुड़ भरोसो रख,</para>
  <para style="q" vid="PSA 37:3">ते भलियाई केर; मुल्खे मां बस्सोरो रा,<note caller="+" style="f"><char style="fr" closed="false">37:3 </char><char style="fq" closed="false">मुल्खे मां बस्सोरो रा, </char><char style="ft" closed="false">कनान मुल्ख ज़ेसेरे बारे मां परमेशरेरे हुक्म दित्तोरो थियो, कि परमेशरेरे लोक तैस मां सुखे सेइं रान।</char></note></para>
  <para style="q" vid="PSA 37:3">ते सच़्च़ाई मां मन लेइतां रा।<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />यहोवा जो अपने सुखेरो आधार ज़ान,</para>
  <para style="q" vid="PSA 37:4">ते तै तेरी योजना पूरी केरेलो।<note caller="-" style="x"><char style="xo" closed="false">37:4 </char><char style="xt" closed="false"><ref loc="MAT 6:33">मत. 6:33</ref>.</char></note><verse eid="PSA 37:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />अपने बत्तरी फिक्र यहोवा पुड़ छ़ड;</para>
  <para style="q" vid="PSA 37:5">ते तैस पुड़ भरोसो रख,</para>
  <para style="q" vid="PSA 37:5">तैए तेरां कम्मां पूरां केरेलो।<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />तै तेरी धार्मिकता लौअरी ज़ेरि,</para>
  <para style="q" vid="PSA 37:6">ते तेरो न्याय दुपहरां केरे लौअरो</para>
  <para style="q" vid="PSA 37:6">ज़ेरो बांदो केरेलो<verse eid="PSA 37:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />यहोवारे सामने च़ुपच़ारे रा,</para>
  <para style="q" vid="PSA 37:7">ते सबरी सेइं तैसेरो इंतज़ार केर,</para>
  <para style="q" vid="PSA 37:7">तैस मैन्हेरे वजाई सेइं न कुढ़, ज़ैसेरां कम्मां कामयाब भोतन,</para>
  <para style="q" vid="PSA 37:7">ते तै बुरी योजनान बेकार केरते!<verse eid="PSA 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />क्रोधे करां दूर रा,</para>
  <para style="q" vid="PSA 37:8">ते सरकी छ़ेडी दे!</para>
  <para style="q" vid="PSA 37:8">कुढ़ न, तैस मरां सिर्फ बुराई निसतीए।<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />किजोकि ज़ालम मेरि मिटी गानेन;</para>
  <para style="q" vid="PSA 37:9">ज़ैना यहोवारो इंतज़ार केरतन,</para>
  <para style="q" vid="PSA 37:9">तैना ज़मीनरे मालिक भोल्हे।<note caller="+" style="f"><char style="fr" closed="false">37:9 </char><char style="ft" closed="false">तैस मुल्खेरे अधिकारी भोल्हे ज़ेसेरे बारे मां प्रभुए वाधो कियोरो थियो</char></note><verse eid="PSA 37:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />थोड़े दिहाड़े बीतने पुड़ दुष्ट न रालो;</para>
  <para style="q" vid="PSA 37:10">ते तू तैसेरे ठैरी रोड़ेच़ारे</para>
  <para style="q" vid="PSA 37:10">हेरने पुड़ भी तीं तै न मैल्हेली।<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />पन हलीम लोक ज़मीनरे मालिक भोल्हे,</para>
  <para style="q" vid="PSA 37:11">ते बड़े आरामेरे वजाई सेइं आनन्द मनाले।<note caller="-" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="MAT 5:5">मत. 5:5</ref>.</char></note><verse eid="PSA 37:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />दुष्ट धर्मी मैन्हेरे खलाफ बुरी योजना कढते,</para>
  <para style="q" vid="PSA 37:12">ते तैस पुड़ दंत च़ापते;<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />पन प्रभु तैस पुड़ हस्सेलो,</para>
  <para style="q" vid="PSA 37:13">किजोकि तै ज़ानते कि तैसेरी नाश भोने बाली दिहाड़ी<note caller="+" style="f"><char style="fr" closed="false">37:13 </char><char style="fq" closed="false">नाश भोने बाली दिहाड़ी </char><char style="ft" closed="false">आखरी न्यायेरी दिहाड़ी</char></note> एजने बालीए।<verse eid="PSA 37:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />दुष्ट लोक तलवार खिचतां,</para>
  <para style="q" vid="PSA 37:14">ते धनुष घिन्तां आन,</para>
  <para style="q" vid="PSA 37:14">ताके गरीब लोकन बिछ़ोड़न,</para>
  <para style="q" vid="PSA 37:14">ते सही चाल च़लनेबालन मैरी छ़डन<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />पन तैन केरि तलवारन सेइं तैन्ना केरे अपने दिल छ़िन्दोन,</para>
  <para style="q" vid="PSA 37:15">ते तैन केरे धनुष ट्लोड़े गाले।<verse eid="PSA 37:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />अधर्मेरी हेछी दौलती करां धर्मी मैन्हेरी थोड़ी ज़ेरि दौलत</para>
  <para style="q" vid="PSA 37:16">बड़ी रोड़ी भोचे।<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />किजोकि दुष्टां केरि पैखड़ी ट्लोड़ी गैनिन;</para>
  <para style="q" vid="PSA 37:17">पन यहोवा धर्मी लोकन सम्भालते।<verse eid="PSA 37:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />यहोवा बेकसूर लोकां केरि उमरारी खबर रखते,</para>
  <para style="q" vid="PSA 37:18">ते तैन केरो हिस्सो हमेशारे लेई बनोरो रहते।<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />मुसीबतरे मौके तैना शरमिन्दे न भोल्हे,</para>
  <para style="q" vid="PSA 37:19">काल एजनेरे दिहाड़न तैना नियन्ने न राले।<verse eid="PSA 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />दुष्ट लोक नाश भोइ गानेन;</para>
  <para style="q" vid="PSA 37:20">ते यहोवारे दुश्मन उडारेरे साफ घासेरे</para>
  <para style="q" vid="PSA 37:20">ज़ेरे नाश भोल्हे,</para>
  <para style="q" vid="PSA 37:20">तैना तूएरे ज़ेरे छ़ेप्पी गानेन।<verse eid="PSA 37:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />दुष्ट कर्ज़ो नेते,</para>
  <para style="q" vid="PSA 37:21">ते भरे न पन धर्मी</para>
  <para style="q" vid="PSA 37:21">अनुग्रह केरतां दान देते।<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />किजोकि ज़ैन परमेशर बरकत देते</para>
  <para style="q" vid="PSA 37:22">तैना ज़मीनरे मालिक भोल्हे,</para>
  <para style="q" vid="PSA 37:22">पन ज़ैन पुड़ तै लानत भेज़ते,</para>
  <para style="q" vid="PSA 37:22">तैन केरू नवं निशाने तगर मिटी गाते।<verse eid="PSA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />मैन्हेरी चाल यहोवारे तरफां</para>
  <para style="q" vid="PSA 37:23">मज़बूत भोतीए,</para>
  <para style="q" vid="PSA 37:23">ते तैसेरे चाल चलने सेइं तै खुश रहते।<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />अगर बिछ़ड़ी भी गाए त फिरी भी तैड़ी पेवरो न राए;</para>
  <para style="q" vid="PSA 37:24">किजोकि यहोवा तैसेरो सहारो बेनतां रहते।<verse eid="PSA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />अवं जुवान थियो, हुनी बुढो आईं,</para>
  <para style="q" vid="PSA 37:25">अवं हेरतो एवरोईं;</para>
  <para style="q" vid="PSA 37:25">पन न त मीं कधी धर्मी शारोरो,</para>
  <para style="q" vid="PSA 37:25">ते न तैसेरू खानदान टुक्ड़े मगते लावं।<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />भक्त मैन्हु त सदा दया केरतां कर्ज़ो देते,</para>
  <para style="q" vid="PSA 37:26">ते तैसेरे खानदाने पुड़ बरकत मैलती रहतीए।<verse eid="PSA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />बुराई शैरतां भलियाई केर;</para>
  <para style="q" vid="PSA 37:27">ते तू सदा आबाद रालो।<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />किजोकि यहोवा न्याय ट्लारोए;</para>
  <para style="q" vid="PSA 37:28">ते तै अपने भक्तन कधे न शारेलो।</para>
  <para style="q" vid="PSA 37:28">तैन केरि त हिफाज़त हमेशा रहतीए,</para>
  <para style="q" vid="PSA 37:28">पन दुष्टां केरू खानदान नाश कियूं गालू।<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />धर्मी लोक ज़मीनरे मालिक भोल्हे,</para>
  <para style="q" vid="PSA 37:29">ते तैस मां सदा बनोरे राले।<verse eid="PSA 37:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />धर्मी अपने ऐशी मरां अक्लरी गल्‍लां केरतो,</para>
  <para style="q" vid="PSA 37:30">ते न्यायेरी गल ज़ोते।<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />तैसेरे परमेशरेरो कानून तैसेरे</para>
  <para style="q" vid="PSA 37:31">दिले मां बस्सोरो रहते,</para>
  <para style="q" vid="PSA 37:31">तैसेरे पव न घिश्कन।<verse eid="PSA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />दुष्ट मैन्हु धर्मी मैन्हेरे ताकी मां रहते।</para>
  <para style="q" vid="PSA 37:32">ते तैस मारनेरी कोशिश केरते।<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />यहोवा तैस तैसेरे हथ्थे मां न छ़डेलो,</para>
  <para style="q" vid="PSA 37:33">ते ज़ैखन तैसेरो खियाल कियो गाए</para>
  <para style="q" vid="PSA 37:33">तैखन तै तैस दोषी करार न देलो।<verse eid="PSA 37:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />यहोवारो इंतज़ार केरतो रा,</para>
  <para style="q" vid="PSA 37:34">ते तैसेरी बत्तां च़लतो रा,</para>
  <para style="q" vid="PSA 37:34">ते तै तीं बेद्धतां ज़मीनरे मालिक केरेलो;</para>
  <para style="q" vid="PSA 37:34">ज़ैखन दुष्ट कट्टे गान, तैखन तू हेरेलो।<verse eid="PSA 37:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />मीं दुष्ट बड़ो ताकतबर</para>
  <para style="q" vid="PSA 37:35">ते एरहो फैलतो हेरो,</para>
  <para style="q" vid="PSA 37:35">ज़ेन्च़रे सब्ज़ बुट</para>
  <para style="q" vid="PSA 37:35">अपने ज़मीनी मां फैलाते।<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />पन ज़ैखन कोई तैलमेइं जेव त</para>
  <para style="q" vid="PSA 37:36">हेरू कि तै तैड़ी अथ्थी नईं;</para>
  <para style="q" vid="PSA 37:36">ते मीं भी तै तोप्पो,</para>
  <para style="q" vid="PSA 37:36">पन कोन्ची न मैल्हो।<note caller="-" style="x"><char style="xo" closed="false">37:36 </char><char style="xt" closed="false"><ref loc="PSA 37:10">भज. 37:10</ref>.</char></note><verse eid="PSA 37:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />ईमानदार मैन्हु पुड़ ध्यान दे</para>
  <para style="q" vid="PSA 37:37">ते धर्मी मैन्हु हेर,</para>
  <para style="q" vid="PSA 37:37">किजोकि मेल मिलापे सेइं रानेबाले मैन्हेरो</para>
  <para style="q" vid="PSA 37:37">आखरी मां फल रोड़ोए।<note caller="-" style="x"><char style="xo" closed="false">37:37 </char><char style="xt" closed="false"><ref loc="ISA 32:17">यशा. 32:17</ref>.</char></note><verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />पन पापी लोक साथी नाश किये गाले;</para>
  <para style="q" vid="PSA 37:38">दुष्टां केरे आखरी मां नाशे।<verse eid="PSA 37:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />धर्मी लोकां केरि मुक्ति यहोवारे</para>
  <para style="q" vid="PSA 37:39">तरफां भोतीए;</para>
  <para style="q" vid="PSA 37:39">मुसीबतरे वक्ते तै तैन केरो मज़बूत क़िलोए।<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />यहोवा तैन केरि मद्दत केरतां तैन छुटकारो देते;</para>
  <para style="q" vid="PSA 37:40">तै तैन दुष्टन करां छुटेइतां तैन केरि मुक्ति केरते,</para>
  <para style="q" vid="PSA 37:40">एल्हेरेलेइ कि तैनेईं तैस मां अपनि शरण नेइ।<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">दुखी मैन्हेरी प्राथना</para>
  <para style="d">याद केरनेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1" />हे यहोवा सरकी सेइं मीं सज़ाह न दे,</para>
  <para style="q" vid="PSA 38:1">ते क्रोधे मां मीं झ़िड़क न दे।<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2" />किजोकि तेरे तीर मीं मां लेग्गी गानेन,</para>
  <para style="q" vid="PSA 38:2">अवं तेरे हथ्थे हैठ देबोरोईं।<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3" />तेरी सरकरी वजाई सेइं मेरी पूरी जानी मां</para>
  <para style="q" vid="PSA 38:3">सहेत नईं,</para>
  <para style="q" vid="PSA 38:3">मेरे पापेरे वजाई सेइं मेरी सैरी हेड्डन मां</para>
  <para style="q" vid="PSA 38:3">आराम नईं।<verse eid="PSA 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4" />किजोकि अवं अपने पापेरे कम्मन मां,</para>
  <para style="q" vid="PSA 38:4">मेरी क्रोड़ी डुब्बी जेवरीए,</para>
  <para style="q" vid="PSA 38:4">ते तै भारी बोझेरो ज़ेरो मेरे झ़ैल्‍लने करां</para>
  <para style="q" vid="PSA 38:4">बेइर भोइ जेवरोए।<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5" />मेरे बेवकूफरे पापां केरे वजाई सेइं ज़खम शेड़ि जे</para>
  <para style="q" vid="PSA 38:5">ते तैन मरां मुशक च़लतीए।<verse eid="PSA 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6" />अवं बड़ो दुखी ते झुकी जेवरोईं;</para>
  <para style="q" vid="PSA 38:6">सैरी दिहैड़ी अवं शोगेरां लिगड़ां</para>
  <para style="q" vid="PSA 38:6">लेइतां च़लताईं फिरताईं।<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7" />किजोकि अवं शरमरे मारे झुकी जेवरोईं,</para>
  <para style="q" vid="PSA 38:7">ते मेरे जानी मां सहेत नईं।<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8" />अवं कमज़ोर ते चूर-चूर भोवरोईं;</para>
  <para style="q" vid="PSA 38:8">अवं अपने मनेरे घबरानेरे वजाई सेइं तड़पताईं।<verse eid="PSA 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9" />हे प्रभु मेरी सारी खुवैइश तेरे सामने,</para>
  <para style="q" vid="PSA 38:9">ते मेरू करलानू तीं करां छ़पोरे नईं।<verse eid="PSA 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10" />मेरो दिल ज़ोरे सेइं धड़कते,</para>
  <para style="q" vid="PSA 38:10">मेरी ताकतां जुवाब दित्तोरोए;</para>
  <para style="q" vid="PSA 38:10">बल्के मेरी एछ़्छ़ी केरि लौ भी</para>
  <para style="q" vid="PSA 38:10">खतम भोवरीए।<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11" />मेरे दोस्त ते मेरे साथी</para>
  <para style="q" vid="PSA 38:11">मेरी मुसीबत हेरतां मीं करां दूर भोए,</para>
  <para style="q" vid="PSA 38:11">मेरे नेड़ेरे रिश्तेदार दूर खड़े भोए।<note caller="-" style="x"><char style="xo" closed="false">38:11 </char><char style="xt" closed="false"><ref loc="PSA 31:11">भज. 31:11</ref>;<ref loc="LUK 23:49">लूक. 23:49</ref>.</char></note><verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12" />मेरी जान नेनेबाले फंदे बिछ़ाने लगोरेन,</para>
  <para style="q" vid="PSA 38:12">ते मेरे नुक्सानेरी कोशिश केरनेबाले</para>
  <para style="q" vid="PSA 38:12">दुष्टेरी गल्‍लां ज़ोते,</para>
  <para style="q" vid="PSA 38:12">ते सारे दिहैड़ी धोखेरी योजना सोचतन।<verse eid="PSA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13" />पन अवं टंवनेरो ज़ेरो शुनी न।</para>
  <para style="q" vid="PSA 38:13">ते अवं लैटेरो ज़ेरो आशी न खोल्‍ली।<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14" />बल्के अवं एरे मैन्हेरो ज़ेरो आईं,</para>
  <para style="q" vid="PSA 38:14">ज़ैस किछ न शुनोए,</para>
  <para style="q" vid="PSA 38:14">ते ज़ेसेरे ऐशेरां कोई बेंसरी कोई</para>
  <para style="q" vid="PSA 38:14">गल न निस्सी।<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15" />पन हे यहोवा,</para>
  <para style="q" vid="PSA 38:15">मीं तीं पुड़ अपनि उमीद लेवरीए;</para>
  <para style="q" vid="PSA 38:15">हे प्रभु, मेरे परमेशर,</para>
  <para style="q" vid="PSA 38:15">तूए मीं जुवाब दे।<verse eid="PSA 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16" />किजोकि मीं ज़ोवं,</para>
  <para style="q" vid="PSA 38:16">“एरू न भोए कि तैना मीं पुड़ आनन्द केरन;</para>
  <para style="q" vid="PSA 38:16">ज़ैखन मेरो पव घिशकते,</para>
  <para style="q" vid="PSA 38:16">तैखन तैना मेरे खलाफ घमण्ड केरतन।”<verse eid="PSA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17" />किजोकि अवं त हुनी खिरकने बालोईं;</para>
  <para style="q" vid="PSA 38:17">ते मेरो मातम लगातार मेरे सामने।<verse eid="PSA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18" />अगर अवं अपने पाप परमेशरे कां मेन्नी,</para>
  <para style="q" vid="PSA 38:18">ते अपने पापेरे वजाई सेइं दुखी रेइलो।<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19" />पन मेरे दुश्मन बेशुमारन,</para>
  <para style="q" vid="PSA 38:19">ते मेरे बैरी बड़े भोइ जे।<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20" />ज़ैना भलियाई केरनेरे बदले बुराई केरतन,</para>
  <para style="q" vid="PSA 38:20">तैना भी मेरी भलियाई पत्ती च़लनेरे</para>
  <para style="q" vid="PSA 38:20">वजाई सेइं मेरी बगावत केरतन।<verse eid="PSA 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21" />हे यहोवा, मीं न शार!</para>
  <para style="q" vid="PSA 38:21">हे मेरे परमेशर, मीं करां दूर न रा!<verse eid="PSA 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22" />हे यहोवा, मीं मुक्ति देनेबालां,</para>
  <para style="q" vid="PSA 38:22">ते मेरी मद्दत केरने मां लूश केर!<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">अक्ल ते मैफरे लेई प्राथना</para>
  <para style="d">यदूतून प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1" />मीं अपने आपे सेइं ज़ोवं, “अवं रोड़ी चाल च़लेलो,</para>
  <para style="q" vid="PSA 39:1">ताके मेरी ज़िभी सेइं पाप न भोए;</para>
  <para style="q" vid="PSA 39:1">ज़ांतगर दुष्ट मेरे सामने,</para>
  <para style="q" vid="PSA 39:1">तांतगर अवं लगाम लेइतां अपनु आशी बंद केरतां रेखेलो।”<note caller="-" style="x"><char style="xo" closed="false">39:1 </char><char style="xt" closed="false"><ref loc="JAS 1:26">याक. 1:26</ref>.</char></note><verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2" />अवं च़ुप भोइतां लट्टो बेनि जेव,</para>
  <para style="q" vid="PSA 39:2">भलैइयरे पासे भी च़ुप रेइलो;</para>
  <para style="q" vid="PSA 39:2">ते मेरी तकलीफ बेधी जेई,<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3" />मेरो दिल अन्तरे अन्ते फुकोने लगोरो थियो।</para>
  <para style="q" vid="PSA 39:3">सोचते-सोचते अग भेड़की जेई;</para>
  <para style="q" vid="PSA 39:3">तैखन मीं अपने ज़बाना सेइं ज़ोवं;<verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4" />“हे यहोवा, एरू केर कि मेरो अन्त,</para>
  <para style="q" vid="PSA 39:4">मीं पतो लग्गे, ते इन भी</para>
  <para style="q" vid="PSA 39:4">कि मेरी उमरारे दिहाड़े केत्रेन;</para>
  <para style="q" vid="PSA 39:4">ज़ैस सेइं मीं पतो च़ले मेरी ज़िन्दगी केत्री बंच़ोरीए!<verse eid="PSA 39:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5" />हेर, तीं मेरी उमर पल भरेरी रख्खोरी,</para>
  <para style="q" vid="PSA 39:5">ते मेरी ज़िन्दगी तेरी नज़री मां किछ अथ्थी नईं,</para>
  <para style="q" vid="PSA 39:5">सच़्च़े सब मैन्हु केरहे कायम</para>
  <para style="q" vid="PSA 39:5">किजो न भोन फिरी भी बेकार ठहरतन।<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6" />सच़्च़े मैन्हु छावरो ज़ेरो च़लते;</para>
  <para style="q" vid="PSA 39:6">सच़्च़े तैना बेकार घबरातन;</para>
  <para style="q" vid="PSA 39:6">तै धन अकोट्ठू त केरते</para>
  <para style="q" vid="PSA 39:6">पन न ज़ाने कि तैस कौन नेलो!<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7" />हुनी हे प्रभु, अवं कोस गल्‍लरो इंतज़ार केरि?</para>
  <para style="q" vid="PSA 39:7">ते उमीद त तेरे तरफां आहे।<verse eid="PSA 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8" />मेरे सारे पापन करां मीं छुटकारो दे,</para>
  <para style="q" vid="PSA 39:8">बेवकूफ मेरी निन्दा न केरि सके।<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9" />अवं च़ुप भोवरोईं, ते मीं आशी न खोल्‍लू;</para>
  <para style="q" vid="PSA 39:9">किजोकि इन कम तींए कियोरूए।<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10" />तीं ज़ै मुसीबत मीं पुड़ छ़डोरीए</para>
  <para style="q" vid="PSA 39:10">तैस मीं करां दूर केर,</para>
  <para style="q" vid="PSA 39:10">किजोकि तेरे हथ्थां केरि मारी सेइं</para>
  <para style="q" vid="PSA 39:10">अवं भस्म भोइ गाताईं।<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11" />ज़ैखन तू इन्साने तैसेरे पापेरे वजाई सेइं</para>
  <para style="q" vid="PSA 39:11">झ़िड़कतां सज़ाह देतस;</para>
  <para style="q" vid="PSA 39:11">तैखन तू तैसेरी शेक्ति कीड़ेरे ज़ेरे नाश केरतस;</para>
  <para style="q" vid="PSA 39:11">सच़्च़े सब मैन्हु बेबसन।<verse eid="PSA 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12" />हे यहोवा, मेरी प्राथना शुन, ते मेरी मद्दतरे लेई बिनती पुड़ ध्यान दे;</para>
  <para style="q" vid="PSA 39:12">मेरी लेरां शुन्तां च़ुप न रा!</para>
  <para style="q" vid="PSA 39:12">किजोकि अवं तीं सेइं साथी अक परदेशी मुसाफरेरो ज़ेरो रहताईं,</para>
  <para style="q" vid="PSA 39:12">ते अपने सब सियांनां केरो ज़ेरो परदेशी आईं।<note caller="-" style="x"><char style="xo" closed="false">39:12 </char><char style="xt" closed="false"><ref loc="HEB 11:13">इब्रा. 11:13</ref>.</char></note><verse eid="PSA 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13" />ओ! इस करां पेइले अवं इट्ठां च़ेलि गेईं</para>
  <para style="q" vid="PSA 39:13">ते न रेईं गेईं,</para>
  <para style="q" vid="PSA 39:13">मीं बच़ा ज़ैस सेइं अवं खुशहाल ज़िन्दगी हासिल केरि सेकी!”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">तारीफ़रू अक गीत</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1" />अवं सबरी सेइं यहोवारो इंतज़ारे केरतो राव;</para>
  <para style="q" vid="PSA 40:1">ते तैने मेरे पासे झुकतां मेरी बिनती शुनी।<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2" />तैनी अवं नाश भोनेरे खड्डे</para>
  <para style="q" vid="PSA 40:2">ते च़िकरी मरां खिचतां कढो,</para>
  <para style="q" vid="PSA 40:2">तैनी मेरे पव चट्टानी पुड़ खड़े किये,</para>
  <para style="q" vid="PSA 40:2">मेरे पव मज़बूत कियोरेन।<note caller="-" style="x"><char style="xo" closed="false">40:2 </char><char style="xt" closed="false"><ref loc="REV 5:9">प्रका. 5:9</ref>;<ref loc="REV 14:3">14:3</ref>;<ref loc="PSA 52:6">भज. 52:6</ref>.</char></note><verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3" />यहोवा मेरी ज़बानी पुड़ अक नंव्वू गीत शिखालू,</para>
  <para style="q" vid="PSA 40:3">ज़ैन इश्शे परमेशरेरे तारीफ़रू आहे।</para>
  <para style="q" vid="PSA 40:3">बड़े लोक एन हेरेले ते तैसेरी महिमा केरेले,</para>
  <para style="q" vid="PSA 40:3">ते यहोवा पुड़ भरोसो रख्खेले।<verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4" />धने तै मैन्हु,</para>
  <para style="q" vid="PSA 40:4">ज़ै यहोवा पुड़ भरोसो रखते,</para>
  <para style="q" vid="PSA 40:4">ज़ै अभिमानी ते झूठां केरे पासे</para>
  <para style="q" vid="PSA 40:4">मुड़ने बालां केरे पासे तुत्तर न फिरातो भोए।<verse eid="PSA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5" />हे मेरे यहोवा परमेशर, तीं बड़ां कम्मां कियोरन!</para>
  <para style="q" vid="PSA 40:5">ज़ैना चमत्कार ते विचार तू इश्शे लेई केरतस</para>
  <para style="q" vid="PSA 40:5">तैना बड़े आन; तेरे बराबर कोई नईं!</para>
  <para style="q" vid="PSA 40:5">अवं त सोचताईं कि खोलतां तैन केरे बारे मां ज़ोईं,</para>
  <para style="q" vid="PSA 40:5">पन तैन केरि गिनती न भोइ सके।<verse eid="PSA 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6" />मेलबेलि ते अन्नबेलि सेइं तू खुश न भोस</para>
  <para style="q" vid="PSA 40:6">तीं मेरे कन खोलोरेन।</para>
  <para style="q" vid="PSA 40:6">होमबलि ते पापेरी बलि तीं न चाई।<verse eid="PSA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7" />तैखन मीं ज़ोवं,</para>
  <para style="q" vid="PSA 40:7">“हेर, अवं एवरोईं; किजोकि किताबी मां</para>
  <para style="q" vid="PSA 40:7">मेरे बारे मां एरू लिखेरूए।<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8" />हे मेरे परमेशर,</para>
  <para style="q" vid="PSA 40:8">अवं खुशी सेइं तेरी मर्ज़ी पूरी केरताईं;</para>
  <para style="q" vid="PSA 40:8">ते तेरो कानून मेरे अन्तर बेस्सी जेवरोए।”<note caller="-" style="x"><char style="xo" closed="false">40:8 </char><char style="xt" closed="false"><ref loc="HEB 10:5-7">इब्रा. 10:5-7</ref>. </char></note><verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9" />मीं बड़े लोकन मां तेरे धार्मिकतारी खुशखबरी शुनेवरीए;</para>
  <para style="q" vid="PSA 40:9">हेर, मीं अपनु आशी बन्द नईं कियोरू हे यहोवा,</para>
  <para style="q" vid="PSA 40:9">तू इन ज़ानतस।<verse eid="PSA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10" />मीं तेरी धार्मिकता मने मां नईं रख्खोरी;</para>
  <para style="q" vid="PSA 40:10">मीं तेरी सच़्च़ाई</para>
  <para style="q" vid="PSA 40:10">ते तेरे कियोरे मुक्तरी गलबात कियोरीए;</para>
  <para style="q" vid="PSA 40:10">मीं तेरी करुणा ते सच़्च़ाई बड़े सभाई करां छ़पोरी न रख्खी।<verse eid="PSA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11" />हे यहोवा, तू भी मीं पुड़ेरां अपनि बड़ी दया न हटा।</para>
  <para style="q" vid="PSA 40:11">तेरे करुणा ते सच़्च़े सेइं लगातार</para>
  <para style="q" vid="PSA 40:11">मेरी हिफाज़त भोती राए!<verse eid="PSA 40:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12" />किजोकि अवं बेड़ी बुरैइयन सेइं घिरोरो आईं;</para>
  <para style="q" vid="PSA 40:12">मेरे बुरे कम्मेईं अवं ट्लेइतां रख्खो</para>
  <para style="q" vid="PSA 40:12">ते अवं नज़र न केरि सेकी।</para>
  <para style="q" vid="PSA 40:12">तैन केरि गिनती मेरे दोग्गेरे बालन करां जादे;</para>
  <para style="q" vid="PSA 40:12">एल्हेरेलेइ मेरो दिल ट्लुटी जेव।<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13" />हे यहोवा, महरबानी केरतां मीं छुटा!</para>
  <para style="q" vid="PSA 40:13">हे यहोवा, मेरी मद्दत केरनेरे लेई लूश केर!<verse eid="PSA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14" />ज़ैना मेरे जानरे दुश्मन आन,</para>
  <para style="q" vid="PSA 40:14">तैना शरमिन्दा भोन;</para>
  <para style="q" vid="PSA 40:14">ते तैना पत्रोवं हटाए ते बेइज़्ज़त किये गान</para>
  <para style="q" vid="PSA 40:14">ज़ैना मेरे नुकसाने सेइं खुश भोतन।<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15" />ज़ैना मीं सेइं, “आहा, आहा,” ज़ोतन,</para>
  <para style="q" vid="PSA 40:15">तैना एपनी शरमरे मारे तबाह भोन।<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16" />पन तैना लोक ज़ैना तीं कां एइतन,</para>
  <para style="q" vid="PSA 40:16">तैना सब तेरे वजाई सेइं खुश</para>
  <para style="q" vid="PSA 40:16">ते मघन भोन; ज़ैना तेरे कियोरे मुक्ति चातन,</para>
  <para style="q" vid="PSA 40:16">तैना लगातार ज़ोते रान, “यहोवारी तारीफ़ भोए!”<verse eid="PSA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17" />अवं त गरीब ते ज़रूरतमन्द आईं,</para>
  <para style="q" vid="PSA 40:17">फिरी भी प्रभु मेरी फिक्र केरते।</para>
  <para style="q" vid="PSA 40:17">तू मद्दतगार ते छुटानेबालो आस;</para>
  <para style="q" vid="PSA 40:17">हे मेरे परमेशर मेरी मद्दत केरनेरे लेई च़िर न ला।<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">धर्मी मैन्हेरी तकलीफ ते आशिर्वाद</para>
  <para style="d">साज़ बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1" />केत्रो धने तै, ज़ै गरीब मैन्हेरो खियाल रखते!</para>
  <para style="q" vid="PSA 41:1">मुसीबतरे मौके यहोवा तैस बच़ालो।<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2" />यहोवा तैसेरी हिफाज़त केरतां तैस ज़ींतो रखेलो,</para>
  <para style="q" vid="PSA 41:2">ते तै धेरती पुड़ धन भोल्हो।</para>
  <para style="q" vid="PSA 41:2">तू तैस दुश्मना केरि इच्छाई पुड़ न छ़ड।<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3" />बिमार भोनेरे मौके यहोवा</para>
  <para style="q" vid="PSA 41:3">तैस बिछ़ाने पुड़ भी सुमैलतां रखेलो;</para>
  <para style="q" vid="PSA 41:3">तू तैसेरी सहेत रोड़ेच़ारे ठीक केरेलो।<verse eid="PSA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4" />मीं प्राथना की, “हे यहोवा, मीं पुड़ दया केर;</para>
  <para style="q" vid="PSA 41:4">मीं बझ़ा,</para>
  <para style="q" vid="PSA 41:4">किजोकि मीं तेरे खलाफ बड़ो भारी पाप कियोरोए!”<verse eid="PSA 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5" />मेरे दुश्मन मेरे बारे मां इन ज़ोइतां मेरी बुराई केरतन</para>
  <para style="q" vid="PSA 41:5">“तै किताली मरे, ते तैसेरू नवं किताली मिटेलू?”<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6" />ते ज़ैखन तै मीं सेइं मिलने एइते,</para>
  <para style="q" vid="PSA 41:6">तैखन बेकार गल्‍लां केरते,</para>
  <para style="q" vid="PSA 41:6">ज़ैखन तैसेरो मन अपने अन्तर अधर्मेरी गल्‍लां अकोट्ठी केरते;</para>
  <para style="q" vid="PSA 41:6">ते बेइर गेइतां तैन केरि चर्चा केरते।<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7" />मीं सेइं नफरत केरनेबाले सब एप्पु मांमेइं मेरे खलाफ मिश्कतन;</para>
  <para style="q" vid="PSA 41:7">तैना मेरे खलाफ भोइतां मेरे नुक्सानेरी योजना केरतन।<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8" />तैना ज़ोतन कि इस त कोई बुरो रोग लगोरोए;</para>
  <para style="q" vid="PSA 41:8">तै कधी भी अपने बिछ़ाने पुड़ेरां दुबारां खड़ो न भोल्हो।<verse eid="PSA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9" />मेरो खास दोस्त ज़ैस पुड़ अवं भरोसो केरतो थियो,</para>
  <para style="q" vid="PSA 41:9">ते ज़ै मेरी रोट्टी खातो थियो,</para>
  <para style="q" vid="PSA 41:9">तै भी मेरे खलाफ भोव।<note caller="-" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="2SA 15:12">2 शमू. 15:12</ref>;<ref loc="JHN 13:18">यूह. 13:18</ref>;<ref loc="ACT 1:16">प्रेरित. 1:16</ref>.</char></note><verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10" />पन हे यहोवा, तू मीं पुड़ दया केरतां,</para>
  <para style="q" vid="PSA 41:10">मीं दुबारो खड़ो केर कि अवं तैन बदलो देइ सेकी।<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11" />मेरो दुश्मन ज़ै मीं पुड़ ज़ींती न सके,</para>
  <para style="q" vid="PSA 41:11">तैस इस गल्‍ली सेइं पतो लगोरोए कि तू मीं सेइं खुश आस।<verse eid="PSA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12" />ते मीं त तू सच़्च़ैई सेइं सम्भालस,</para>
  <para style="q" vid="PSA 41:12">ते हमेशारे लेई अपने सामने कायम केरतस।<verse eid="PSA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13" />इस्राएलेरो परमेशर यहोवा</para>
  <para style="q" vid="PSA 41:13">शुरू करां आखरी तगर तैसेरी तारीफ़ भोए।</para>
  <para style="q" vid="PSA 41:13">आमीन, फिरी आमीन।<note caller="-" style="x"><char style="xo" closed="false">41:13 </char><char style="xt" closed="false"><ref loc="LUK 1:68">लूक. 1:68</ref>;<ref loc="PSA 106:48">भज. 106:48</ref>.</char></note><verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">दूइयोवं हिस्सो</para>
  <para style="mr">
    <ref loc="PSA 42-72">भज. 42—72</ref></para>
  <para style="s">परमेशरेरे लेई इच्छा केरनी</para>
  <para style="d">साज़ बज़ानेबालेरे प्रधानेरे लेई कोरह खानदानेरे लोकां केरो मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1" />ज़ेन्च़रे हिरनी नालेरे रोड़े पैनेरे लेई तरसतीए;</para>
  <para style="q" vid="PSA 42:1">तेन्च़रे, हे मेरे परमेशर, अवं तेरे लेई तरसताईं।<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2" />ज़ींते परमेशर, हाँ अवं परमेशरेरो ट्लिशोरो आईं,</para>
  <para style="q" vid="PSA 42:2">अवं किताली गेइतां परमेशरे कां तुत्तर हरेइलो।<note caller="-" style="x"><char style="xo" closed="false">42:2 </char><char style="xt" closed="false"><ref loc="PSA 63:1">भज. 63:1</ref>;<ref loc="REV 22:4">प्रका. 22:4</ref>.</char></note><verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3" />रात दिहैड़ी मेरां ऐंखरू मेरी खूराक भोतन;</para>
  <para style="q" vid="PSA 42:3">ते मेरे दुश्मन सारे दिहैड़ी मीं सेइं ज़ोते रहतन,</para>
  <para style="q" vid="PSA 42:3">तेरो परमेशर कोड़िए?<verse eid="PSA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4" />अवं केरही भीड़ी सेइं साथी गेइयां केरतो थियो,</para>
  <para style="q" vid="PSA 42:4">अवं जयजयकार ते शुक्र केरतां</para>
  <para style="q" vid="PSA 42:4">खुशी मनाने बाले भीड़रे दरमियान परमेशरेरे भवने जो</para>
  <para style="q" vid="PSA 42:4">बल्हे-बल्हे गातो थियो; इन याद केरतां मेरे प्राण दुखी भोइ गातन।<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5" />हे मेरी जान, तू किजो परेशान भोने लगोरिस?</para>
  <para style="q" vid="PSA 42:5">ते किजो अन्तरे-अन्तर बेचैन आस?</para>
  <para style="q" vid="PSA 42:5">परमेशरे पुड़ उमीद लेइतां रख;</para>
  <para style="q" vid="PSA 42:5">किजोकि अवं तैसेरे दर्शने सेइं मुक्ति हासिल केरतां फिरी तैसेरू शुक्र केरेलो।<note caller="-" style="x"><char style="xo" closed="false">42:5 </char><char style="xt" closed="false"><ref loc="MAT 26:38">मत. 26:38</ref>;<ref loc="MRK 14:34">मरक. 14:34</ref>;<ref loc="JHN 12:27">यूह. 12:27</ref>.</char></note><verse eid="PSA 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6" />हे मेरे परमेशर; मेरो प्राण मेरे अन्त बेचैने</para>
  <para style="q" vid="PSA 42:6">एल्हेरेलेइ अवं यरदनेरे नेड़ेरे मुल्खे करां</para>
  <para style="q" vid="PSA 42:6">ते हेर्मोनेरे पहाड़न ते मिसगारेरे पहाड़न पुड़ेरां</para>
  <para style="q" vid="PSA 42:6">तीं याद केरताईं।<verse eid="PSA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7" />तेरे पैनेरे धारां केरो शब्द शुन्तां पानी,</para>
  <para style="q" vid="PSA 42:7">पैनी जो हक देते; तेरी सब लहरन</para>
  <para style="q" vid="PSA 42:7">ते छ़ेलहन मां अवं डुब्बी जेवरोईं।<verse eid="PSA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8" />फिरी भी दीसां यहोवा अपनि शक्ति</para>
  <para style="q" vid="PSA 42:8">ते दया बांदी केरेलो;</para>
  <para style="q" vid="PSA 42:8">ते राती भी अवं तैसेरू गीत ज़ोइलो,</para>
  <para style="q" vid="PSA 42:8">ते अवं अपने ज़िन्दगी देनेबाले परमेशरे कां प्राथना केरेलो।<verse eid="PSA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9" />अवं परमेशरे सेइं ज़ै मेरी चट्टाने ज़ोइलो,</para>
  <para style="q" vid="PSA 42:9">“तीं अवं किजो बिसरो?</para>
  <para style="q" vid="PSA 42:9">अवं दुश्मनेरे ज़ुलमेरे मारे किजो शोगेरां</para>
  <para style="q" vid="PSA 42:9">लिगड़ां लेइतां च़लताईं फिरताईं?”<verse eid="PSA 42:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10" />मेरे सतानेबाले ज़ैना मेरी निन्दा केरतन,</para>
  <para style="q" vid="PSA 42:10">ज़ेन्च़रे तैस सेइं मेरी हेड्डी चूर-चूर भोतिन,</para>
  <para style="q" vid="PSA 42:10">ज़ेन्च़रे तलवारी सेइं छ़िन्दी गैतिन,</para>
  <para style="q" vid="PSA 42:10">किजोकि तैना सारे दिहैड़ी मीं सेइं ज़ोते रहतन, तेरो परमेशर कोड़िए?<verse eid="PSA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11" />हे मेरी जान तू किजो बेचैन भोतिस?</para>
  <para style="q" vid="PSA 42:11">तू अन्तरे अन्तर किजो परेशानस?</para>
  <para style="q" vid="PSA 42:11">परमेशरे पुड़ भरोसो रख;</para>
  <para style="q" vid="PSA 42:11">किजोकि तै मेरे तुत्तरेरी चमक ते मेरो परमेशरे,</para>
  <para style="q" vid="PSA 42:11">अवं फिरी तैसेरू शुक्र केरेलो।<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">मुसीबतरे वक्ते प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />हे परमेशर, मेरो न्याय केर,</para>
  <para style="q" vid="PSA 43:1">मेरे लेई गैर ईमानदार कौमन सेइं लड़,</para>
  <para style="q" vid="PSA 43:1">मीं धोखेबाज़न ते बुरे मैन्हन करां बच़ा।<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />किजोकि तू मेरो शेक्ति बालो परमेशरस,</para>
  <para style="q" vid="PSA 43:2">तीं किजो अवं शारो?</para>
  <para style="q" vid="PSA 43:2">अवं अपने दुश्मनेरे ज़ुलमे सेइं</para>
  <para style="q" vid="PSA 43:2">किजो मातमेरां लिगड़ां लेइतां च़ेलि।<verse eid="PSA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />अपनि लौ ते अपनि सच़्च़ाई भेज़;</para>
  <para style="q" vid="PSA 43:3">ताके तैना मेरी अगवाई केरन,</para>
  <para style="q" vid="PSA 43:3">तैन्ना मीं तेरे पवित्र पहाड़े<note caller="+" style="f"><char style="fr" closed="false">43:3 </char><char style="fq" closed="false">पहाड़े </char><char style="ft" closed="false">सिय्योन पहाड़</char></note> पुड़</para>
  <para style="q" vid="PSA 43:3">पुड़ ते रानेरी ठारी पुड़ पुज़ान।<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />तैखन अवं परमेशरेरी वेदी कां गेइलो,</para>
  <para style="q" vid="PSA 43:4">तैस परमेशरे कां ज़ै मेरे बड़े</para>
  <para style="q" vid="PSA 43:4">आनन्देरो कुण्डे, ते हे परमेशर,</para>
  <para style="q" vid="PSA 43:4">हे मेरे परमेशर, अवं सारंगी बज़ेई-बज़ेई तेरू शुक्र केरेलो।<verse eid="PSA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />हे मेरे प्राण तू किजो बेचैन भोतस?</para>
  <para style="q" vid="PSA 43:5">तू अन्तरे-अन्तरे किजो परेशान आस?</para>
  <para style="q" vid="PSA 43:5">परमेशरे पुड़ उमीद रख, किजोकि तै मेरे तुत्तरेरी चमक</para>
  <para style="q" vid="PSA 43:5">ते मेरो परमेशरे; अवं फिरी तैसेरू शुक्र केरेलो।<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">इस्राएलेरी शिकायत</para>
  <para style="d">साज़ बज़ानेबालां केरे प्रधानेरे लेई कोरह खानदानेरे लोकां केरो मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1" />हे परमेशर, असेईं अपने कन्नेईं सेइं शुनू,</para>
  <para style="q" vid="PSA 44:1">इश्शे दादे-पड़दादेईं असन सेइं बियान कियूं;</para>
  <para style="q" vid="PSA 44:1">कि तीं तैन केरे दिहाड़न मां</para>
  <para style="q" vid="PSA 44:1">ते पुराने ज़माने मां कुन-कुन कम्मां कियोरां थियां।<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2" />तीं एप्पु अपने हथ्थे सेइं कौमां केढी,</para>
  <para style="q" vid="PSA 44:2">ते इना बसाए;</para>
  <para style="q" vid="PSA 44:2">तीं मुल्खां-मुल्खां केरे लोकन दुख दित्तो,</para>
  <para style="q" vid="PSA 44:2">ते च़ेवरे पासन फैलाए।<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3" />किजोकि तेरे लोक न त अपने तलवारारे</para>
  <para style="q" vid="PSA 44:3">ज़ोरे सेइं इस मुल्खेरे मालिक भोए,</para>
  <para style="q" vid="PSA 44:3">ते न अपने बड़े ताकती सेइं; पन तेरे देइने हथ्थे</para>
  <para style="q" vid="PSA 44:3">ते तेरे पाखड़ ते तेरे खुशरे तुत्तरेरे वजाई सेइं तैनेईं ज़ींत हासिल की;</para>
  <para style="q" vid="PSA 44:3">किजोकि तू तैन चाथो थियो।<verse eid="PSA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4" />हे परमेशर, तूए इश्शो महाराज़ो आस,</para>
  <para style="q" vid="PSA 44:4">तू याकूबेरे छुटकारेरो हुक्म देतस।<verse eid="PSA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5" />तेरी मद्दती सेइं अस अपने दुश्मन्न</para>
  <para style="q" vid="PSA 44:5">ज़मीनी पुड़ शैरी देतम,</para>
  <para style="q" vid="PSA 44:5">तेरू नवं घिन्तां असां</para>
  <para style="q" vid="PSA 44:5">अपने खलाफ भोने बालन ढ्लेन्च़ी देमेले।<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6" />किजोकि अवं अपने धनुषे पुड़ भरोसो न रेखी,</para>
  <para style="q" vid="PSA 44:6">ते मेरी तलवार मीं न बच़ेइ सके।<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7" />बल्के तूए असन दुश्मन्न करां बच़ातस,</para>
  <para style="q" vid="PSA 44:7">तूए तैन न उमीद ते शरमिन्दा केरतस</para>
  <para style="q" vid="PSA 44:7">ज़ैना असन सेइं नफरत केरतन।<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8" />परमेशरेरी तारीफ़ असां</para>
  <para style="q" vid="PSA 44:8">सैरी दिहैड़ी केरतम,</para>
  <para style="q" vid="PSA 44:8">ते अस हमेशा तेरे नंव्वेरू</para>
  <para style="q" vid="PSA 44:8">शुक्र केरते रहमेले। <char style="qs">(सेला) </char><verse eid="PSA 44:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9" />पन हुन्ना तीं असां रद कियोरेम,</para>
  <para style="q" vid="PSA 44:9">असां शरमिन्दा कियोरेम,</para>
  <para style="q" vid="PSA 44:9">ते इश्शे सेना सेइं साथी अग्रोवं न च़लन।<verse eid="PSA 44:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10" />तीं असां दुश्मना केरे सामने पस्त भोने दित्ते,</para>
  <para style="q" vid="PSA 44:10">ते ज़ैना असन सेइं नफरत केरतन तैनेईं असां लुट्टी छ़डोरेम।<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11" />तीं असां भैड्डां केरे ज़ेरे किसैईं</para>
  <para style="q" vid="PSA 44:11">केरे हथ्थे मां दित्तोरेम,</para>
  <para style="q" vid="PSA 44:11">ते अस गैर कौमन मां</para>
  <para style="q" vid="PSA 44:11">तितर-बितर कियोरेम।<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12" />तू अपनि कौम मुफते मां बेच़तस,</para>
  <para style="q" vid="PSA 44:12">तैन केरि कीमती सेइं तू धनी न भोस।<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13" />तू इश्शे पड़ोसन सेइं इश्शे</para>
  <para style="q" vid="PSA 44:13">खलाफ ज़ोतस,</para>
  <para style="q" vid="PSA 44:13">ते इश्शे च़ेवरे पासे रानेबाले</para>
  <para style="q" vid="PSA 44:13">इश्शो मज़ाक बनातन।<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14" />तीं अस गैर कौमन</para>
  <para style="q" vid="PSA 44:14">मां बेइज़्ज़त कियोरेम,</para>
  <para style="q" vid="PSA 44:14">ते मुल्खां-मुल्खां केरे लोक<note caller="+" style="f"><char style="fr" closed="false">44:14 </char><char style="fq" closed="false">मुल्खां-मुल्खां केरे लोक </char><char style="ft" closed="false">गैर कौमां केरे पड़ोसी लोक</char></note> इश्शे</para>
  <para style="q" vid="PSA 44:14">वजाई सेइं क्रोड़ी हिलातन।<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15" />सैरी दिहैड़ी मेरी बेइज़्ज़ती भोतीए,</para>
  <para style="q" vid="PSA 44:15">ते कलंक लाने</para>
  <para style="q" vid="PSA 44:15">ते निन्दा केरनेबालेरे गल्‍ली सेइं,<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16" />दुश्मन ते बदलो नेने बालेरे वजाई सेइं,</para>
  <para style="q" vid="PSA 44:16">बुरू भलू ज़ोने बालां</para>
  <para style="q" vid="PSA 44:16">ते निन्दा केरनेबालां केरे वजाई सेइं।<verse eid="PSA 44:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17" />एन सब किछ असन पुड़</para>
  <para style="q" vid="PSA 44:17">बीतू फिरी भी अस तीं न बिसरम,</para>
  <para style="q" vid="PSA 44:17">न तेरे करारेरे बारे मां धोखेबाज़ी कियोरीए।<verse eid="PSA 44:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18" />न इश्शे दिल तीं करां दूर भोए,</para>
  <para style="q" vid="PSA 44:18">ते न इश्शे पव तेरी बत्ती करां बेइर भोए;<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19" />फिरी भी तीं असां गिद्दां केरि ठारी चूर-चूर किये,</para>
  <para style="q" vid="PSA 44:19">ते तीं असां बड़े आंधरे मां छ़ुपेई छ़डे।<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20" />अगर असां अपने परमेशरेरू नवं बिसरेथे,</para>
  <para style="q" vid="PSA 44:20">या अपने हथ प्राथनारे लेई कोन्ची होरि देबतेरे पासे खड़े केरम,<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21" />त कुन परमेशर एस गल्‍लरो खियाल न केरेथो?</para>
  <para style="q" vid="PSA 44:21">किजोकि तै त मनेरी छ़ेपोरी गल्‍लां ज़ानते।<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22" />पन अस सैरी दिहैड़ी तेरे लेई</para>
  <para style="q" vid="PSA 44:22">मारे गातम,</para>
  <para style="q" vid="PSA 44:22">ते तैन भैड्डां केरे ज़ेरे समझ़े</para>
  <para style="q" vid="PSA 44:22">गातम ज़ैना मारे गाने पुड़ आन।<note caller="-" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">रोम. 8:36</ref>.</char></note><verse eid="PSA 44:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23" />हे प्रभु, उठ! बींझ़! तू किजो झ़ुलतस?</para>
  <para style="q" vid="PSA 44:23">उठ! असन हमेशारे लेई न शार!<verse eid="PSA 44:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24" />तू अपनु तुत्तर असन करां छ़ुपेइतां किजो रखतस,</para>
  <para style="q" vid="PSA 44:24">ते इश्शो दुख ते सताव गानू बिसरी गातस?<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25" />इश्शे प्राण मित्ती मां मिली जे;</para>
  <para style="q" vid="PSA 44:25">ते इश्शी जान तल्‍ले सेइं मिली जेई।<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26" />खड़े उठतां इश्शी मद्दत केर।</para>
  <para style="q" vid="PSA 44:26">ते अपने दयारे खातर असन बच़ा।<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">ड्लाहेरू गीत</para>
  <para style="d">साज़ बज़ानेबालेरे प्रधानेरे लेई शोशन्नीमे मां कोरह खानदानेरे लोकां केरो मश्कील। प्यारेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1" />मेरो दिल एक्‍की खूबसूरत विषयरे उमंगी सेइं</para>
  <para style="q" vid="PSA 45:1">छ़लकने लगोरोए,</para>
  <para style="q" vid="PSA 45:1">ज़ै गल मीं राज़ेरे बारे मां रच़ी तैस शुनताईं;</para>
  <para style="q" vid="PSA 45:1">मेरी ज़िभ माहिर लिखने बाली बनोरीए।<verse eid="PSA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2" />तू मैन्हन मां सेभन करां खूबसूरत;</para>
  <para style="q" vid="PSA 45:2">तेरे ओठन मां अनुग्रह भरोरोए;</para>
  <para style="q" vid="PSA 45:2">एल्हेरेलेइ परमेशरे तीं हमेशारे लेई</para>
  <para style="q" vid="PSA 45:2">बरकत दित्तोरीए।<note caller="-" style="x"><char style="xo" closed="false">45:2 </char><char style="xt" closed="false"><ref loc="LUK 4:22">लूक. 4:22</ref>;<ref loc="HEB 1:3-4">इब्रा. 1:3-4</ref>.</char></note><verse eid="PSA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3" />हे बहादर, अपनि तलवारी अपने लख्खे सेइं बन्ध ते अपनि महिमा</para>
  <para style="q" vid="PSA 45:3">ते प्रतापे लिगड़ां केरो ज़ेरो ला।<verse eid="PSA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4" />सच़्च़ाई, नम्रता ते धार्मिकतारे खातर</para>
  <para style="q" vid="PSA 45:4">अपनि शान-ओ-शोकती पुड़ सुवार भो;</para>
  <para style="q" vid="PSA 45:4">तेरो देइनो हथ तीं भयानक कम्मां शिखाले!<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5" />तेरे तीर त तेज़न,</para>
  <para style="q" vid="PSA 45:5">तेरे सामने मुल्खे-मुल्खेरे लोक बिछ़ड़ेले;</para>
  <para style="q" vid="PSA 45:5">राज़ेरे दुश्मना केरे दिल तैन सेइं कोशेलो।<verse eid="PSA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6" />हे परमेशर, तेरो तखत हमेशारे लेई बनोरो रालो;</para>
  <para style="q" vid="PSA 45:6">ते राज़दण्ड न्यायेरो आहे।<verse eid="PSA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7" />तीं धार्मिकताई सेइं प्यार ते दुष्टे सेइं नफरत कियोरीए,</para>
  <para style="q" vid="PSA 45:7">एल्हेरेलेइ परमेशरे हाँ, तेरे परमेशरे</para>
  <para style="q" vid="PSA 45:7">खुशरे तेले सेइं अभिषेक केरतां तेरू तेरे सैथन करां</para>
  <para style="q" vid="PSA 45:7">कही जादे अभिषेक कियोरूए।<note caller="-" style="x"><char style="xo" closed="false">45:7 </char><char style="xt" closed="false"><ref loc="HEB 1:8-9">इब्रा. 1:8-9</ref>.</char></note><verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8" />तेरां सारां लिगड़ां गन्धरस, अगर, ते तेजे सेइं</para>
  <para style="q" vid="PSA 45:8">खुशबूदार आन,</para>
  <para style="q" vid="PSA 45:8">तू हाथी दंतेरे भवनन मां तारीबाले बाज़ां केरे</para>
  <para style="q" vid="PSA 45:8">वजाई सेइं खुशी भोवरोस।<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9" />राजकुमैरी तेरो गेहनो लेइतां च़ेलचन;</para>
  <para style="q" vid="PSA 45:9">तेरे देइने पासे पटरानी, ओपीरेरे कुन्दने</para>
  <para style="q" vid="PSA 45:9">सेइं सज़ोरीए।<verse eid="PSA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10" />हे राजकुमारी, शुन मेरी गल्‍ली पुड़ ध्यान दे;</para>
  <para style="q" vid="PSA 45:10">अपने लोकन ते अपने बाजेरे घरे बिस्सरी गा;<verse eid="PSA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11" />ते राज़ो तेरे रूपेरी इच्छा केरेलो।</para>
  <para style="q" vid="PSA 45:11">किजोकि तै त तेरो प्रभुए, तू तैसेरी आदर केर।<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12" />सोर नगरेरी राजकुमारी भी मुलाकात केरनेरे लेई</para>
  <para style="q" vid="PSA 45:12">हाज़र भोल्ही,</para>
  <para style="q" vid="PSA 45:12">ते कौमां केरे अमीर लोक तीं खुश केरनेरी</para>
  <para style="q" vid="PSA 45:12">कोशिश केरेले।<verse eid="PSA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13" />राजकुमारी मेहले मां बड़ी खूबसूरते;</para>
  <para style="q" vid="PSA 45:13">तैसारां लिगड़ां सोन्नेरे धैगेईं सेइं बुनोरन।<verse eid="PSA 45:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14" />तै कढ़ाई कियोरां लिगड़ां लुवेइतां राज़े कां</para>
  <para style="q" vid="PSA 45:14">पुज़ाई गाली।</para>
  <para style="q" vid="PSA 45:14">ज़ैना कुइयां तैसेरी सहेलिन,</para>
  <para style="q" vid="PSA 45:14">तैना तैस पत्ती-पत्ती च़ेलती तीं कां पुज़ेई गैली।<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15" />तैना खुशी ते मघन भोइतां पुज़ेई गैली,</para>
  <para style="q" vid="PSA 45:15">ते तैना राज़ेरे मेहले मां दाखल भोल्ही।<verse eid="PSA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16" />तेरे बुज़ुर्गां केरि ठैरी तेरी औलाद भोल्ही;</para>
  <para style="q" vid="PSA 45:16">ज़ैन्न तू सारी ज़मीनी पुड़ हाकिम ठहरालो।<verse eid="PSA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17" />अवं एरू केरेलो, कि तेरे नंव्वेरी चर्चा</para>
  <para style="q" vid="PSA 45:17">पीढ़ी करां पीढ़ी तगर भोती राली;</para>
  <para style="q" vid="PSA 45:17">इस वजाई सेइं मुल्ख-मुल्खेरे लोक सदा तेरू</para>
  <para style="q" vid="PSA 45:17">शुक्र केरते राले।<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">परमेशर इश्शी छ़पनेरी ठार</para>
  <para style="d">साज़ बज़ानेबालेरे प्रधानेरे लेई कोरह खानदानेरे लोकां केरू, अलामोतेरे रागे पुड़ अक गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1" />परमेशर इश्शी छ़पनेरी ठार ते ज़ोरे,</para>
  <para style="q" vid="PSA 46:1">मुसीबती मां बड़े आसैनी सेइं मैल्हने बालो मद्दतगारे।<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2" />एल्हेरेलेइ असन कोई डर नईं, चाए</para>
  <para style="q" vid="PSA 46:2">ज़मीन उलटोई गाए,</para>
  <para style="q" vid="PSA 46:2">ते चाए पहाड़ां समुन्दरे मां छ़डां गान;<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3" />चाए समुन्दर शोर सल्हतां ठाठां मारे,</para>
  <para style="q" vid="PSA 46:3">ते पहाड़ां तैसेरी छ़ेलहन सेइं हिल्‍ली गान,<note caller="-" style="x"><char style="xo" closed="false">46:3 </char><char style="xt" closed="false"><ref loc="LUK 21:25">लूक. 21:25</ref>;<ref loc="MAT 7:25">मत. 7:25</ref>.</char></note> <char style="qs">(सेला) </char><verse eid="PSA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4" />अक दरियाए ज़ेसेरी नेरहन सेइं परमेशरेरे</para>
  <para style="q" vid="PSA 46:4">नगरे मां</para>
  <para style="q" vid="PSA 46:4">मतलब परमप्रधान परमेशरेरे पवित्र रानेरे ठारी मां</para>
  <para style="q" vid="PSA 46:4">आनन्द भोते।<verse eid="PSA 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5" />परमेशर तैस नगरे मांए, तैन नगर कधे</para>
  <para style="q" vid="PSA 46:5">टलने बालू नईं;</para>
  <para style="q" vid="PSA 46:5">जल्दी परमेशर तैसेरी मद्दत केरते।<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6" />कौमां शोर मच़ाने लेग्गी, मुल्खे-मुल्खेरे</para>
  <para style="q" vid="PSA 46:6">लोक डरने लगे;</para>
  <para style="q" vid="PSA 46:6">परमेशरे आवाज़ दित्ती त ज़मीन गेली जेई।<note caller="-" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="REV 11:18">प्रका. 11:18</ref>;<ref loc="PSA 2:1">भज. 2:1</ref>.</char></note><verse eid="PSA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7" />सेनां केरो यहोवा असन सेइं साथीए;</para>
  <para style="q" vid="PSA 46:7">याकूबेरो परमेशर इश्शो क़िलोए। <char style="qs">(सेला) </char><verse eid="PSA 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8" />एज्जा, यहोवारे महान कम्मन पुड़ नज़र देथ,</para>
  <para style="q" vid="PSA 46:8">कि तैनी ज़मीनी पुड़ खतरनाक तुबाही</para>
  <para style="q" vid="PSA 46:8">कियोरीए।<verse eid="PSA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9" />तैए दुनियारे आखरी तगर जंगां बंद केरते;</para>
  <para style="q" vid="PSA 46:9">तै धनुष ट्लोड़ते, ते बलमी दूई टुक्ड़े केरते,</para>
  <para style="q" vid="PSA 46:9">ते रथ्थन अग्गी मां फुक्‍की देते!<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10" />तै ज़ोते, “च़ुप भोइ गाथ, ते ज़ाना कि अव्वें परमेशर आईं।</para>
  <para style="q" vid="PSA 46:10">अवं कौमन मां महान आईं,</para>
  <para style="q" vid="PSA 46:10">अवं सारे दुनियाई मां महान आईं!”<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11" />सेनां केरो यहोवा असन सेइं साथी आहे;</para>
  <para style="q" vid="PSA 46:11">याकूबेरो परमेशर इश्शो उच्‍चो क़िलोए। <char style="qs">(सेला) </char><verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">परमेशर इश्शो राज़ो</para>
  <para style="d">साज़ बज़ानेबालेरे प्रधानेरे लेई कोरह खानदानेरे लोकां केरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1" />हे मुल्ख-मुल्खेरे सब लोकव, च़ैड़ी बज़ाथ!</para>
  <para style="q" vid="PSA 47:1">उच्‍चे शब्दन सेइं परमेशरेरे लेई जयजयकार केरा!<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2" />किजोकि यहोवा परमप्रधान ते डरेरे काबले,</para>
  <para style="q" vid="PSA 47:2">तै सैरी धेरती पुड़ महाराज़ोए।<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3" />तै मुल्ख-मुल्खेरे लोकन इश्शे सामने</para>
  <para style="q" vid="PSA 47:3">उन्ढे केरते,</para>
  <para style="q" vid="PSA 47:3">ते कौमी-कौमी इश्शे पव्वन हैठ केरते।<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4" />तै इश्शे लेई रोड़ो हिस्सो च़ुनेलो,</para>
  <para style="q" vid="PSA 47:4">ज़ै तैसेरे ट्लारे याकूबेरे घमण्डेरी वजाए। <char style="qs">(सेला) </char><verse eid="PSA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5" />परमेशर जयजयकारे सेइं साथी,</para>
  <para style="q" vid="PSA 47:5">यहोवा नरशिंगेरी आवाज़ी सेइं उबरो जेवरोए।<note caller="-" style="x"><char style="xo" closed="false">47:5 </char><char style="xt" closed="false"><ref loc="LUK 24:51">लूक. 24:51</ref>;<ref loc="JHN 6:62">यूह. 6:62</ref>;<ref loc="ACT 1:9">प्रेरित. 1:9</ref>;<ref loc="PSA 68:1-2">भज. 68:1-2</ref>.</char></note><verse eid="PSA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6" />परमेशरेरू भजन ज़ोथ; भजन ज़ोथ!</para>
  <para style="q" vid="PSA 47:6">इश्शे महाराज़ेरू भजन ज़ोथ; भजन ज़ोथ!<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7" />किजोकि परमेशर सैरी दुनियारो महाराज़ोए,</para>
  <para style="q" vid="PSA 47:7">ते अक्ली सेइं भजन ज़ोथ।<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8" />परमेशर कौमन पुड़ हुकूमत केरते;</para>
  <para style="q" vid="PSA 47:8">परमेशर अपने पवित्र तखते पुड़</para>
  <para style="q" vid="PSA 47:8">बिशोरोए।<note caller="-" style="x"><char style="xo" closed="false">47:8 </char><char style="xt" closed="false"><ref loc="PSA 96:10">भज. 96:10</ref>;<ref loc="REV 19:6">प्रका. 19:6</ref>.</char></note><verse eid="PSA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9" />मुल्खे-मुल्खेरे राईस लोक अब्राहमेरे परमेशरेरे</para>
  <para style="q" vid="PSA 47:9">लोक भोनेरे लेई अकोट्ठे भेवरेन।</para>
  <para style="q" vid="PSA 47:9">किजोकि धेरतरी ढालां परमेशरेरे कब्ज़े मां आन,</para>
  <para style="q" vid="PSA 47:9">तै त महाने।<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">सिय्योने मां परमेशरेरी महिमा</para>
  <para style="d">कोरह खानदानेरे लोकां केरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1" />इश्शे परमेशरेरे नगरे<note caller="+" style="f"><char style="fr" closed="false">48:1 </char><char style="fq" closed="false">परमेशरेरे नगरे </char><char style="ft" closed="false">यरूशलेम नगर</char></note> मां, ते अपने</para>
  <para style="q" vid="PSA 48:1">पवित्र पहाड़े<note caller="+" style="f"><char style="fr" closed="false">48:1 </char><char style="fq" closed="false">पवित्र पहाड़े </char><char style="ft" closed="false">सिय्योन पहाड़</char></note> पुड़</para>
  <para style="q" vid="PSA 48:1">यहोवा महान ते बड़े तारीफ़रे काबले! <char style="qs">(सेला) </char><verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2" />सिय्योन पहाड़ ऊँचाई मां खूबसूरत ते सारी</para>
  <para style="q" vid="PSA 48:2">धेरतरे खुशरी वजाए,</para>
  <para style="q" vid="PSA 48:2">महान राज़ेरू नगर उत्तरेरे पासे आहे।<note caller="-" style="x"><char style="xo" closed="false">48:2 </char><char style="xt" closed="false"><ref loc="MAT 5:35">मत. 5:35</ref>;<ref loc="JER 3:19">यिर्म. 3:19</ref>.</char></note><verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3" />तैसेरे मेहलन मां परमेशर उच्‍चो क़िलो</para>
  <para style="q" vid="PSA 48:3">मन्नो जेवरोए<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4" />किजोकि हेरा, राज़े सेना सने अकोट्ठे भोए,</para>
  <para style="q" vid="PSA 48:4">तैना साथी अग्रोवं च़ले।<verse eid="PSA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5" />तैनेईं एप्पु तैस नगरे मां हेरू ते डेरि जे,</para>
  <para style="q" vid="PSA 48:5">तैना डेरतां नेश्शी जे।<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6" />तैड़ी तैन थर्क लेग्गी जेई, ते तैन</para>
  <para style="q" vid="PSA 48:6">बच्‍चो ज़ानेरी ज़ेरि तकलीफ भोने लगी।<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7" />तू पूर्वी पासेरे बाते सेइं</para>
  <para style="q" vid="PSA 48:7">तर्शीश नगरेरे ज़िहाज़न ट्लोड़तस।<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8" />सेनारे यहोवारे नगरे मां,</para>
  <para style="q" vid="PSA 48:8">अपने परमेशरेरे नगरे मां, ज़ेन्च़रे असेईं</para>
  <para style="q" vid="PSA 48:8">शुनोरू थियूं, तेन्च़रे लाहेरू भी आहे;</para>
  <para style="q" vid="PSA 48:8">परमेशर तैस सदा मज़बूत ते कायम रखेलो।<verse eid="PSA 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9" />हे परमेशर, असेईं तेरे भवने अन्तर</para>
  <para style="q" vid="PSA 48:9">तेरी दयाई पुड़ ध्यान कियोरूए।<verse eid="PSA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10" />हे परमेशर तेरे नंव्वेरे काबल</para>
  <para style="q" vid="PSA 48:10">तेरी बडीयाई धेरतरे बन्ने तगर भोए।</para>
  <para style="q" vid="PSA 48:10">तेरो देइनो हथ धार्मिकताई सेइं भेरतांए;<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11" />तेरे न्यायेरे कम्मां केरि वजाई सेइं</para>
  <para style="q" vid="PSA 48:11">सिय्योन पहाड़ आनन्द मनाए,</para>
  <para style="q" vid="PSA 48:11">ते यहूदा नगरेरी कुइयां मघन भोन!<verse eid="PSA 48:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12" />सिय्योनेरे च़ेवरे पासे च़ला, ते तैसेरे</para>
  <para style="q" vid="PSA 48:12">चक्‍कर लाथ।</para>
  <para style="q" vid="PSA 48:12">तैसेरे गुम्मट गना,<verse eid="PSA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13" />तैसेरी शहरपनाही पुड़ नज़र देथ तैसेरे</para>
  <para style="q" vid="PSA 48:13">मेहलन ध्याने सेइं हेरा;</para>
  <para style="q" vid="PSA 48:13">ज़ैस सेइं कि तुस एजने बाले पीढ़रे लोकन सेइं</para>
  <para style="q" vid="PSA 48:13">इस गल्‍लरे बारे मां बियान केरि सकथ।<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14" />किजोकि तै परमेशर हमेशा-हमेशा इश्शो</para>
  <para style="q" vid="PSA 48:14">परमेशरे,</para>
  <para style="q" vid="PSA 48:14">तै मौती तगर इश्शी अगवाई केरेलो।<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">धने पुड़ भरोसो रखनेरी बेवकूफी</para>
  <para style="d">साज़ बज़ानेबालेरे प्रधानेरे लेई कोरह खानदानेरे लोकां केरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1" />हे मुल्ख-मुल्खेरे सब लोकव इन शुना!</para>
  <para style="q" vid="PSA 49:1">हे दुनियाई मां सब रानेबालव, ध्याने सेइं शुना!<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2" />कुन आम, कुन खास</para>
  <para style="q" vid="PSA 49:2">कुन अमीर, कुन गरीब, सब ध्यान देथ!<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3" />मेरू आशी अक्ल बियान केरेलू;</para>
  <para style="q" vid="PSA 49:3">ते मेरे दिलेरी गल्‍लां समझ़री भोल्ही।<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4" />अवं अपनो कन्न कहावतां केरे पासे लेइलो,</para>
  <para style="q" vid="PSA 49:4">अवं सारंगी बज़ेइतां अपनि छ़पोरी गल</para>
  <para style="q" vid="PSA 49:4">बांदी केरेलो।<verse eid="PSA 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5" />अवं तैखन किजो डेरि, ज़ेइस मुसीबतरे दिहाड़े एज्जन, ज़ैखन बुराई मीं घेरे?<verse eid="PSA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6" />ज़ै अपने जाईदाती पुड़ भरोसो रखते,</para>
  <para style="q" vid="PSA 49:6">ते एपनी बड़े दौलती पुड़ घमण्ड केरते।<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7" />तैन मरां कोई भी अपने ढ्लाए कोन्ची भी</para>
  <para style="q" vid="PSA 49:7">तरीके छुटेई न सके;</para>
  <para style="q" vid="PSA 49:7">ते न परमेशरे तैसेरे बदले छुटानेरे लेई</para>
  <para style="q" vid="PSA 49:7">किछ देइ सके।<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8" />किजोकि तैन केरे जानरी छुड़ौती बड़ी जादे</para>
  <para style="q" vid="PSA 49:8">तैना आखरी तगर कधी न भेरि सकेले।<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9" />कोई एरहो नईं ज़ै हमेशा ज़ींतो राए,</para>
  <para style="q" vid="PSA 49:9">ते कब्री न हेरे।<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10" />किजोकि सब लेइहोते, कि अक्लमन्द भी मरतन,</para>
  <para style="q" vid="PSA 49:10">ते बेवकूफ ते मैन्हु ज़ै हैवानेरो ज़ेरोए, नाश भोते,</para>
  <para style="q" vid="PSA 49:10">ते अपनि जाईदात होरि केरे लेई छ़डते।<verse eid="PSA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11" />तैना मने-मने मां इन सोचतन, कि तैन केरू घर</para>
  <para style="q" vid="PSA 49:11">हमेशा बनोरू रालू,</para>
  <para style="q" vid="PSA 49:11">ते तैन केरू घर पीढ़ी करां पीढ़ी तगर बनोरू रालू;</para>
  <para style="q" vid="PSA 49:11">एल्हेरेलेइ तैना अपनि-अपनि ज़मीनरू नवं अपने-अपने नंव्वे पुड़ रखतन।<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12" />पन इज़्ज़त हासिल केरतां भी इन्सान कायम न राए,</para>
  <para style="q" vid="PSA 49:12">तै जानबरां केरो ज़ेरो भोते, ज़ै मेरि गाते।<verse eid="PSA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13" />तैन केरि ऐह चाल तैन केरि बेवकूफीए,</para>
  <para style="q" vid="PSA 49:13">फिरी भी तैन केरे बाद लोक तैन केरि गल्‍लन सेइं</para>
  <para style="q" vid="PSA 49:13">खुश भोतन। <char style="qs">(सेला) </char><verse eid="PSA 49:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14" />तैना ज़ेन्च़रे पातालेरी भैड्डां केरे झुण्ड भोइ जे;</para>
  <para style="q" vid="PSA 49:14">मौत तैन केरि पुहाल ठहरेली;</para>
  <para style="q" vid="PSA 49:14">ते झ़ेझ़ां सच़्च़े लोक तैन पुड़ राज़ केरेले;</para>
  <para style="q" vid="PSA 49:14">ते तैन केरि खूबसूरत शकल पातालेरो ड्लाछ़ोड़ो भोल्हो ते तैन केरो कोई आधार न भोल्हो।<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15" />पन परमेशर मेरे प्राण पातालेरे</para>
  <para style="q" vid="PSA 49:15">कब्ज़े करां छुटालो;</para>
  <para style="q" vid="PSA 49:15">तै मीं कबूल केरतां अपनो बनालो।<verse eid="PSA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16" />ज़ैखन कोई अमीर भोइ गाए, ते ज़ैखन तैसेरे घरेरी</para>
  <para style="q" vid="PSA 49:16">शान-ओ-शोकत बेधी गाए।</para>
  <para style="q" vid="PSA 49:16">तैखन तू डेरां न।<verse eid="PSA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17" />किजोकि मरते बार त तैनी एप्पु सेइं साथी किछ भी नईं नेनू;</para>
  <para style="q" vid="PSA 49:17">ते न तैसेरी महिमा<note caller="+" style="f"><char style="fr" closed="false">49:17 </char><char style="fq" closed="false">महिमा </char><char style="ft" closed="false">धन दौलत</char></note> तैस सेइं साथी कब्री मां गाली।<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18" />चाए तै ज़ींते वक्ते अपने आपे जो धन ज़ोतो राए।</para>
  <para style="q" vid="PSA 49:18">ज़ैखन तू भलियाई केरतस, तैखन तैना लोक</para>
  <para style="q" vid="PSA 49:18">तेरी तारीफ़ केरतन।<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19" />फिरी भी तै अपने बुज़ुर्गां केरे समाजे मां मिलाव गालो,</para>
  <para style="q" vid="PSA 49:19">ज़ै कधे लौ न हेरेलो।<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20" />इन्सान चाए इज़्ज़त भी हासिल केरे पन अगर तैना</para>
  <para style="q" vid="PSA 49:20">समझ़ न रखते भोन त</para>
  <para style="q" vid="PSA 49:20">तैना जानबरां केरे ज़ेरेन, ज़ैना मेरि गातन।<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">परमेशर धर्मी न्याय केरनेबालोए</para>
  <para style="d">आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1" />सर्वशक्तिमान परमेशर यहोवाए ज़ोवरूए,</para>
  <para style="q" vid="PSA 50:1">ते दिहाड़ो निसनेरे पासे करां दिहाड़ो डुबनेरे पासे तगर दुनियारे</para>
  <para style="q" vid="PSA 50:1">लोक कुजेवरेन।<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />सिय्योने मरां, ज़ैन बड़ू खूबसूरते,</para>
  <para style="q" vid="PSA 50:2">परमेशरे अपनि महिमा हिराई।<verse eid="PSA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />इश्शो परमेशर एज्जेलो ते च़ुप न रालो;</para>
  <para style="q" vid="PSA 50:3">अग तैस अग्री-अग्री सब किछ भस्म केरती गाली;</para>
  <para style="q" vid="PSA 50:3">तैसेरे च़ेवरे पासन बड़ी आँधी च़लेली।<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />परमेशर अपने लोकां केरो न्याय केरनेरे लेई</para>
  <para style="q" vid="PSA 50:4">अम्बरे जो ते ज़मीनी जो भी आवाज़ देलो,<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />“मेरे भक्त मीं कां अकोट्ठे केरा,</para>
  <para style="q" vid="PSA 50:5">ज़ैनेईं बलिदान देइतां मीं सेइं करार कियोरोए!”<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />ते अम्बर तैसेरू धर्मी भोनेरू बियान केरेलू</para>
  <para style="q" vid="PSA 50:6">किजोकि परमेशर एप्पु न्याय केरनेबालोए।<note caller="-" style="x"><char style="xo" closed="false">50:6 </char><char style="xt" closed="false"><ref loc="PSA 97:6">भज. 97:6</ref>;<ref loc="HEB 12:23">इब्रा. 12:23</ref>.</char></note> <char style="qs">(सेला) </char><verse eid="PSA 50:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />“हे मेरे लोकव, शुना, अवं गल केरताईं,</para>
  <para style="q" vid="PSA 50:7">ते हे इस्राएल, अवं तेरे खलाफ गवाही देताईं।</para>
  <para style="q" vid="PSA 50:7">परमेशर तेरो परमेशर अव्वें आईं।<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />अवं तीं पुड़ तेरी बेलि केरे बारे मां दोष न लेईं,</para>
  <para style="q" vid="PSA 50:8">तेरी होमबेलि त रोज़ मेरे लेई च़ेढ़तिन।<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />न अवं तेरे गेवड़े मरां दांत,</para>
  <para style="q" vid="PSA 50:9">न तेरे बाड़े मरां थाव्वे बलिदानेरे लेई नेइलो।<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />किजोकि जंगलेरो हर अक-अक जानबर,</para>
  <para style="q" vid="PSA 50:10">ते हज़ारेईं पहाड़ां केरे जानबर मेरेन।<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />अवं पहाड़ां केरे सारे च़ुड़ोलन ज़ानताईं,</para>
  <para style="q" vid="PSA 50:11">ते ज़ैना भी मैइदाने मां च़लने फिरने बाले जानबरन सब मेरेन।<verse eid="PSA 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />अगर अवं नियन्नो भोथो त तीं सेइं ज़ोथो;</para>
  <para style="q" vid="PSA 50:12">किजोकि दुनिया ते ज़ैन किछ भी तैस मांए तैन सब किछ मेरूए।<note caller="-" style="x"><char style="xo" closed="false">50:12 </char><char style="xt" closed="false"><ref loc="ACT 17:25">प्रेरित. 17:25</ref>;<ref loc="1CO 10:26">1 कुरि. 10:26</ref>.</char></note><verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />कुन अवं दांतेरू मास खेइं,</para>
  <para style="q" vid="PSA 50:13">या थाव्वां केरो खून पीं?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />परमेशरे जो शुक्रेरी बलि च़ाढ़ा,</para>
  <para style="q" vid="PSA 50:14">ते परमप्रधान परमेशरेरे लेई अपनि मिन्नतां पूरी केर;<note caller="-" style="x"><char style="xo" closed="false">50:14 </char><char style="xt" closed="false"><ref loc="HEB 13:15">इब्रा. 13:15</ref>;<ref loc="ECC 5:4-5">सभ. 5:4-5</ref>.</char></note><verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />मुसीबतरे दिहाड़े मीं पुकार;</para>
  <para style="q" vid="PSA 50:15">ते अवं तीं छुटेलो, ते तू मेरी महिमा केरि सकेलो।”<verse eid="PSA 50:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />पन दुष्टे जो परमेशर ज़ोते:</para>
  <para style="q" vid="PSA 50:16">“मेरो कानून शुनाने सेइं तीं कुन कम?</para>
  <para style="q" vid="PSA 50:16">तू मेरे करारेरी चर्चा किजो केरतस?<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />तू त शिक्षाई सेइं नफरत केरतस,</para>
  <para style="q" vid="PSA 50:17">ते मेरे गल्‍लन घटिया समझ़तस।<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />ज़ैखन तीं कोई च़ोर लाव, त तू तैसेरी सेंगती मां गेइतां खुशी भोव;</para>
  <para style="q" vid="PSA 50:18">ते व्यभिचार केरनेबालन सेइं साथी हिस्सेदार भोव।<verse eid="PSA 50:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />तीं अपनु आशी बुराई केरनेरे लेई खोल्‍लू,</para>
  <para style="q" vid="PSA 50:19">ते तेरी ज़िभ धोखेरी गल्‍लां बनातीए।<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />तू होरन कां बिशतां अपने ढ्लाएरे खलाफ ज़ोतो रहतस;</para>
  <para style="q" vid="PSA 50:20">ते अपने सक्‍के ढ्लाएरी चोगली केरतस।<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />इन कम तीं कियूं, ते अवं च़ुप राव;</para>
  <para style="q" vid="PSA 50:21">एल्हेरेलेइ तीं समझ़ू कि परमेशर बिलकुल मेरो ज़ेरोए।</para>
  <para style="q" vid="PSA 50:21">पन अवं तीं समझ़ालो, ते तेरी एछ़्छ़ी केरे</para>
  <para style="q" vid="PSA 50:21">सामने सब किछ अलग-अलग हरेइलो।<verse eid="PSA 50:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />हे परमेशरे बिसरने बालाव, ई गल रोड़ेच़ारे समझ़ा,</para>
  <para style="q" vid="PSA 50:22">कोन्च एरू न भोए कि अवं तुसन छ़िन्दी,<note caller="+" style="f"><char style="fr" closed="false">50:22 </char><char style="fq" closed="false">छ़िन्दी </char><char style="ft" closed="false">नाश केरि</char></note></para>
  <para style="q" vid="PSA 50:22">ते कोई छुटानेबालो न भोए।<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />शुक्रेरी बलि च़ाढ़ने बालो मेरी महिमा केरते;</para>
  <para style="q" vid="PSA 50:23">ते ज़ै अपनो चाल चलन ठीक रखते</para>
  <para style="q" vid="PSA 50:23">तैस अवं परमेशरेरी मुक्ति हरेइलो!<note caller="-" style="x"><char style="xo" closed="false">50:23 </char><char style="xt" closed="false"><ref loc="HEB 13:15">इब्रा. 13:15</ref>.</char></note>”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">पाप माफ़ केरनेरे लेई प्राथना</para>
  <para style="d">साज़ बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरू भजन ज़ैखन नातान नबी तैस कां एल्हेरेलेइ अव कि तै बतशेबा कां जेवरो थियो</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1" />हे परमेशर, अपनि दयारे मुताबिक मीं पुड़ अनुग्रह केर;</para>
  <para style="q" vid="PSA 51:1">अपने बड़े दयारे मुताबिक मेरे पाप माफ़ केर।<note caller="-" style="x"><char style="xo" closed="false">51:1 </char><char style="xt" closed="false"><ref loc="LUK 18:13">लूक. 18:13</ref>;<ref loc="ISA 43:25">यशा. 43:25</ref>.</char></note><verse eid="PSA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2" />मीं रोड़ेच़ारे धोइतां मेरो कसूर साफ केर,</para>
  <para style="q" vid="PSA 51:2">ते मेरो पाप छुटेइतां मीं शुद्ध केर!<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3" />किजोकि अवं अपने पापन ज़ानताईं,</para>
  <para style="q" vid="PSA 51:3">ते मेरो पाप हमेशा मेरे सामने रहते।<note caller="-" style="x"><char style="xo" closed="false">51:3 </char><char style="xt" closed="false"><ref loc="2SA 12:13">2 शमू. 12:13</ref>.</char></note><verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4" />मीं सिर्फ तेरे खलाफ पाप कियोरोए,</para>
  <para style="q" vid="PSA 51:4">मीं तैन कम कियोरूए ज़ैन तेरी नज़री मां बुरूए,</para>
  <para style="q" vid="PSA 51:4">ताके तू ज़ोने मां धर्मी</para>
  <para style="q" vid="PSA 51:4">ते न्याय केरने मां बेकसूर भोस।<note caller="-" style="x"><char style="xo" closed="false">51:4 </char><char style="xt" closed="false"><ref loc="LUK 15:18">लूक. 15:18</ref>,<ref loc="LUK 15:21">21</ref>;<ref loc="ROM 3:4">रोम. 3:4</ref>.</char></note><verse eid="PSA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5" />हेर, अवं अधर्मे मां ज़र्मो,</para>
  <para style="q" vid="PSA 51:5">ते पापे सेइं अपने अम्मरे पेटे मां पेव।<note caller="-" style="x"><char style="xo" closed="false">51:5 </char><char style="xt" closed="false"><ref loc="JHN 3:6">यूह. 3:6</ref>;<ref loc="ROM 5:12">रोम. 5:12</ref>;<ref loc="EPH 2:3">इफि. 2:3</ref>.</char></note><verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6" />हेर, तू दिलेरी सच़्च़ैई सेइं खुशी भोतस;</para>
  <para style="q" vid="PSA 51:6">ते मेरे मने मां ज्ञान शिखालेलो।<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7" />जूफा<note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="fq" closed="false">जूफा </char><char style="ft" closed="false">जूफा अक निकड़ो पौदो भोतो थियो, ज़ै पानी ते खून लोकन पुड़ शुद्ध भोनेरे लेई छ़िड़कनेरे लेई इस्तेमाल कियो गातो थियो। निर्ग. 12:22; लैव्य. 14:1-7; गिन. 19:1-6, 16-19. </char></note> सेइं तू मीं शुद्ध केर, त अवं पवित्र भोइ गेईं;</para>
  <para style="q" vid="PSA 51:7">मीं धो, ते अवं हिव्वेंरो ज़ेरो बड़ो छ़ित्तो भोइलो।<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8" />मीं खुशरी ते आनन्देरी गल्‍लां शुना,</para>
  <para style="q" vid="PSA 51:8">ज़ैस सेइं ज़ैना हेड्डी तीं ट्लोड़ोरिन, तैना</para>
  <para style="q" vid="PSA 51:8">मघन भोइ गान।<verse eid="PSA 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9" />अपनु तुत्तर मेरे पापन करां फिरा,</para>
  <para style="q" vid="PSA 51:9">ते मेरे सारे अधर्म मिटा।<verse eid="PSA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10" />हे परमेशर, मेरे अन्तर पवित्र दिल पैदा केर</para>
  <para style="q" vid="PSA 51:10">मेरे अन्तर कायम रानेबाली आत्मा नंव्वे तरीके सेइं पैदा केर।<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11" />मीं अपने सामनेरां दूर न केर,</para>
  <para style="q" vid="PSA 51:11">ते न अपनि पवित्र आत्मा मीं करां अलग केर।<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12" />मीं दुबारां एपनी मुक्तरी खुशी दे,</para>
  <para style="q" vid="PSA 51:12">मीं इच्छारी आत्मा देइतां सम्भाल।<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13" />तैखन अवं पापी मैन्हु तेरी बत हरेइलो,</para>
  <para style="q" vid="PSA 51:13">ते पापी लोक तेरे पासे एज्जेले।<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14" />हे परमेशर, हे मेरे मुक्ति देनेबाले परमेशर,</para>
  <para style="q" vid="PSA 51:14">मीं कत्लेरे सज़ाही करां छुटा,</para>
  <para style="q" vid="PSA 51:14">तैखन अवं तेरे धार्मिकतारे लेई जयजयकार केरेलो।<verse eid="PSA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15" />हे प्रभु मेरू आशी खोल्‍ल</para>
  <para style="q" vid="PSA 51:15">तैखन अवं तेरी बडीयाई केरि सकेलो।<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16" />किजोकि तू बेलि सेइं खुशी न भोस,</para>
  <para style="q" vid="PSA 51:16">नईं त अवं पेश केरेथो;</para>
  <para style="q" vid="PSA 51:16">होमबलि सेइं तू खुशी न भोस।<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17" />ट्लुटोरो मन परमेशरेरे लेई बलिदाने;</para>
  <para style="q" vid="PSA 51:17">हे परमेशर, तू ट्लुटोरे ते ढ्लन्च़ोरे मने</para>
  <para style="q" vid="PSA 51:17">घटिया न समझ़स।<verse eid="PSA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18" />खुशी भोइतां सिय्योनेरी भलियाई केर,</para>
  <para style="q" vid="PSA 51:18">यरूशलेमेरी शहरपनाह तू फिरी बना,<note caller="+" style="f"><char style="fr" closed="false">51:18 </char><char style="ft" closed="false">सिय्योन ते यरूशलेम अक्‍के नगरे।</char></note><verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19" />तैखन तू धार्मिकतारे बलिदाने सेइं</para>
  <para style="q" vid="PSA 51:19">मतलब जानबरेरे पूरे होमबेलि सेइं खुश भोल्हो;</para>
  <para style="q" vid="PSA 51:19">तैखन लोक तेरी वेदी पुड़ पवित्र बलिदान च़ाढ़ेले।<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">दुष्ट मैन्हेरो अन्त ते धर्मी मैन्हेरी तसल्‍ली</para>
  <para style="d">साज़ बज़ानेबालां केरे प्रधानेरे लेई मश्कीले पुड़ दाऊदेरू भजन ज़ैखन दोएग एदोमे शाऊले ज़ोवं कि दाऊद अहीमेलेकेरे घरे जेवरो थियो।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1" />हे बहादर, तू बुराई केरने पुड़ किजो घमण्ड केरतस?</para>
  <para style="q" vid="PSA 52:1">परमेशरेरी दया त हमेशारीए।<verse eid="PSA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2" />तेरी ज़िभ सिर्फ दुष्ट बनातीए।</para>
  <para style="q" vid="PSA 52:2">शानी पुड़ रखोरोए उस्तरेरे ज़ेरे तै धोखेरू</para>
  <para style="q" vid="PSA 52:2">कम केरतीए।<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3" />तू भलियाई करां बेद्धतां बुराई मां,</para>
  <para style="q" vid="PSA 52:3">ते धार्मिकतारी गल्‍ली करां बेद्धतां झूठे सेइं प्यार केरतस। <char style="qs">(सेला) </char><verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4" />हे धोखो देनेबाली ज़बान,</para>
  <para style="q" vid="PSA 52:4">तू सब नाश केरनेबैली गल्‍लन सेइं खुश भोतिस।<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5" />पक्‍को परमेशर तीं हमेशारे लेई नाश केरेलो;</para>
  <para style="q" vid="PSA 52:5">तै तीं ट्लेइतां तेरे डेरे मरां कढेलो;</para>
  <para style="q" vid="PSA 52:5">ते ज़ींतां केरे दुनियाई मरां तीं ढ्लूड़ेलो। <char style="qs">(सेला) </char><verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6" />तैखन धर्मी लोक इस बीतना हेरतां डेरि गाले,</para>
  <para style="q" vid="PSA 52:6">ते इन ज़ोइतां तैस पुड़ हस्सेले,<verse eid="PSA 52:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7" />“हेरा, ई तैए मैन्हुए ज़ैनी परमेशरे मां</para>
  <para style="q" vid="PSA 52:7">शरण नईं घिन्नोरीए,</para>
  <para style="q" vid="PSA 52:7">पन अपने बड़े धने पुड़ भरोसो रखतो थियो</para>
  <para style="q" vid="PSA 52:7">ते अपने आपे दुष्टे मज़बूत केरतो राव!”<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8" />पन अवं परमेशरेरे घरे मां ज़ैतूनेरे</para>
  <para style="q" vid="PSA 52:8">नीले बुट्टेरो ज़ेरो आईं।</para>
  <para style="q" vid="PSA 52:8">मीं हमेशारे लेई परमेशरेरी दयाई</para>
  <para style="q" vid="PSA 52:8">पुड़ भरोसो रखोरोए।<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9" />अवं तेरू शुक्र हमेशारे लेई केरेलो,</para>
  <para style="q" vid="PSA 52:9">किजोकि तींए इन कम कियूं।</para>
  <para style="q" vid="PSA 52:9">अवं तेरे नंव्वे पुड़ उमीद रखताईं, किजोकि</para>
  <para style="q" vid="PSA 52:9">इन तेरे पवित्र भक्तां केरे सामने बड़ू रोड़ूए।<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">मैन्हु केरि बेवकूफी ते बुराई</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई महलतेरे रागे पुड़ दाऊदेरू मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1" />बेवकूफे अपने मने मां ज़ोवं, “कोई परमेशर अथ्थी नईं।”</para>
  <para style="q" vid="PSA 53:1">तैना बिगड़ी जे, तैनेईं बुरैइारां भिट्टां कम्मां कियोरन;</para>
  <para style="q" vid="PSA 53:1">कोई रोड़ां कम्मां केरनेबालो नईं।<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2" />परमेशरे सुर्गे पुड़ेरां मैन्हन पुड़ नज़र की</para>
  <para style="q" vid="PSA 53:2">ताके हेरे कि कोई अक्ली सेइं च़लनेबालो</para>
  <para style="q" vid="PSA 53:2">या परमेशरे तोप्पने बालोए कि नईं।<verse eid="PSA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3" />तैना सभेरे सब दूर भोए; सब एक्‍की साथी बिगड़ी जे;</para>
  <para style="q" vid="PSA 53:3">कोई भलू कम केरनेबालो नईं, अक भी नईं।<note caller="-" style="x"><char style="xo" closed="false">53:3 </char><char style="xt" closed="false"><ref loc="PSA 14:1-3">भज. 14:1-3</ref>;<ref loc="ROM 3:10-12">रोम. 3:10-12</ref>.</char></note><verse eid="PSA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4" />परमेशर पुछ़ते, कुन तैन सब अनर्थ कम केरनेबालन किछ भी ज्ञान नईं,</para>
  <para style="q" vid="PSA 53:4">ज़ैना मेरे लोकन रोट्टरे ज़ेरे खातन,</para>
  <para style="q" vid="PSA 53:4">पन परमेशरेरू नवं न घिन्न?<verse eid="PSA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5" />तैन पुड़ बड़ो डर भोइ जेव ज़ैड़ी डरेरी कोई वजा न थी।</para>
  <para style="q" vid="PSA 53:5">किजोकि यहोवा तैन केरि हेड्डी, ज़ैना तेरे खलाफ डेरे लेइतां थिये, तितर-बितर किये;</para>
  <para style="q" vid="PSA 53:5">तीं त तैना शरमिन्दे किये एल्हेरेलेइ कि</para>
  <para style="q" vid="PSA 53:5">परमेशरे तैना शैरी दित्ते।<verse eid="PSA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6" />भलू भोथू कि इस्राएलेरी पूरी मुक्ति सिय्योने मरां निस्सेथी!</para>
  <para style="q" vid="PSA 53:6">ज़ैखन परमेशर अपने लोकन गुलैमी मरां वापस आनेलो।</para>
  <para style="q" vid="PSA 53:6">तैखन याकूब मघन ते इस्राएल आनन्द केरेलो।<note caller="-" style="x"><char style="xo" closed="false">53:6 </char><char style="xt" closed="false"><ref loc="PSA 14:7">भज. 14:7</ref>.</char></note><verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">मुक्तरे लेई प्राथना</para>
  <para style="d">साज़ बज़ानेबालां केरे प्रधानेरे लेई, तारीबाले बाज़न सेइं मश्कील ज़ैखन जीपी लोकेईं शाऊले सेइं ज़ोवं, “कुन दाऊद इश्शे दरमियाने मां छ़पोरो न राए?”</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1" />हे परमेशर अपने नंव्वेरे ज़िरिये सेइं मीं मुक्ति दे,</para>
  <para style="q" vid="PSA 54:1">ते अपने शेक्ति सेइं मेरो न्याय केर।<verse eid="PSA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2" />हे परमेशर, मेरी बिनती शुन;</para>
  <para style="q" vid="PSA 54:2">मेरे गल्‍लन पुड़ ध्यान दे।<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3" />किजोकि परदेशी मेरे खलाफ खड़े भेवरेन,</para>
  <para style="q" vid="PSA 54:3">ते कुकर्म केरनेबाले मीं मारने चातन;</para>
  <para style="q" vid="PSA 54:3">तैनेईं परमेशर अपने सामने न समझ़ो <char style="qs">(सेला) </char><verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4" />हेरा, परमेशर मेरो मद्दत केरनेबालोए;</para>
  <para style="q" vid="PSA 54:4">प्रभु मेरे प्राणे सम्भालने बालोए।<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5" />परमेशर मेरे दुश्मना केरि बुराई वापस तैन पुड़ आनेलो;</para>
  <para style="q" vid="PSA 54:5">हे परमेशर, अपने सच़्च़ैई सेइं तैन नाश केर।<verse eid="PSA 54:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6" />अवं तीं अपने मेर्ज़ी सेइं बलि च़ाढ़ेलो;</para>
  <para style="q" vid="PSA 54:6">हे यहोवा, अवं तेरे नंव्वेरी तारीफ़ केरेलो,</para>
  <para style="q" vid="PSA 54:6">किजोकि इन भलू आहे।<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7" />किजोकि तीं मीं सैरी मुसीबतन करां छुटकारो दित्तोरोए,</para>
  <para style="q" vid="PSA 54:7">ते हुनी अवं अपने दुश्मना केरि हारी हेरेलो।<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">धोखेबाज़ नाश भोनेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई, तारीबाले बाज़न सेइं दाऊदेरो मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1" />हे परमेशर, मेरी प्राथना शुन;</para>
  <para style="q" vid="PSA 55:1">ते मेरी बिनती करां तुत्तर न फिरा!<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2" />मेरे पासे ध्यान दे, ते मीं जुवाब दे;</para>
  <para style="q" vid="PSA 55:2">अवं मुसीबतां केरे वजाई सेइं बेचैन भोताईं।<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3" />किजोकि मेरे दुश्मन शोर</para>
  <para style="q" vid="PSA 55:3">ते दुष्ट ज़ुलम केरि राहोरेन;</para>
  <para style="q" vid="PSA 55:3">तैना मीं पुड़ इलज़ाम लातन,</para>
  <para style="q" vid="PSA 55:3">ते सेरकोइतां सतातन।<verse eid="PSA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4" />मेरे अन्तर मेरो दिल तेड़फती राहोरोए,</para>
  <para style="q" vid="PSA 55:4">मौतरो डर मीं मां पेवरोए।<verse eid="PSA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5" />डर ते थरकां अवं ट्लेइ छ़डो,</para>
  <para style="q" vid="PSA 55:5">ते डरे अवं दबेईं छ़डो।<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6" />तैखन मीं ज़ोवं, “रोड़ू भोथू कि कबूतरेरां ज़ेरां मेरां फंघां भोथां</para>
  <para style="q" vid="PSA 55:6">त अवं उडरी गाथो ते मीं आराम मैलेथो!<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7" />तैखन अवं दूर तगर नेशतां गेइयेथो</para>
  <para style="q" vid="PSA 55:7">ते सुनसान ठैरी मां राथो।<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8" />अवं बड़े आँधी तूफाने</para>
  <para style="q" vid="PSA 55:8">करां बेच़तां कोन्ची छ़पनेरी ठैरी जो नशेथो।”<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9" />हे प्रभु, तैन उलझा,</para>
  <para style="q" vid="PSA 55:9">तैन केरि भाषाई मां गड़बड़ी छ़ड;</para>
  <para style="q" vid="PSA 55:9">किजोकि मीं नगरे मां हर पासे ज़ुलम ते लड़ाई लाहोरीए।<verse eid="PSA 55:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10" />रात-दिहैड़ी तैना तैस शहरपनाही पुड़ गुस्तां चक्‍कर लातन;</para>
  <para style="q" vid="PSA 55:10">ते तैन केरे अन्तर धोखो ते बुराई पैदा भोचे।<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11" />तैस मां बुरैइयां डेरो लेवरोए;</para>
  <para style="q" vid="PSA 55:11">ते ज़ुलम ते फरेब तैन केरे चौके करां दूर न भोन।<verse eid="PSA 55:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12" />ज़ै मेरी बदनामी केरते तै दुश्मन नईं,</para>
  <para style="q" vid="PSA 55:12">अगर भोथो अवं बरदाशत केरेथो;</para>
  <para style="q" vid="PSA 55:12">ज़ै मेरे खलाफ बड़कां मारते तै मेरो दुश्मन नईं,</para>
  <para style="q" vid="PSA 55:12">नईं त अवं तैस करां छ़ेप्पी गाथो।<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13" />पन तै त तूए थियो ज़ै मेरे बराबर मैन्हु</para>
  <para style="q" vid="PSA 55:13">मेरो पक्‍को दोस्त ते मेरी ज़ान पिशानरो थियो।<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14" />अस एप्पु मांमेइं केरही-केरही मिट्ठी गल्‍लां केरते थिये;</para>
  <para style="q" vid="PSA 55:14">अस बड़े लोकन सेइं साथी परमेशरेरे घरे मां गाते थिये।<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15" />मौत अचानक तैन पुड़ एइतां ट्लेइ छ़डे; तैना ज़ींते पाताले मां उतरी गान;</para>
  <para style="q" vid="PSA 55:15">किजोकि बुराई तैन केरे घरन मां ते अन्तरे।<verse eid="PSA 55:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16" />पन अवं त मद्दतरे लेई परमेशरे कां प्राथना केरेलो;</para>
  <para style="q" vid="PSA 55:16">ते यहोवा मीं बच़ालो।<verse eid="PSA 55:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17" />ड्लवझ़ी, झ़ेझ़ां, दुपहरेईं, ट्लेइ पहर</para>
  <para style="q" vid="PSA 55:17">अवं बिनती केरेलो ते करलातो रेइलो</para>
  <para style="q" vid="PSA 55:17">ते परमेशर मेरो शब्द शुनेलो।<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18" />ज़ै लड़ाई मेरे खलाफ मच़ोरी थी, तैस करां अवं तैनी आरामे सेइं छुटेवरोइं।</para>
  <para style="q" vid="PSA 55:18">तैनेईं त बड़े लोक साथी नेइतां मेरो सामनो कियोरो थियो।<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19" />परमेशर ज़ै शुरू करां देंतो अपने तखते पुड़े, इन शुन्तां तैन जुवाब देलो। <char style="qs">(सेला) </char></para>
  <para style="q" vid="PSA 55:19">इना तैना आन ज़ैन मां कोई बदलाव नईं, ते तैन मां परमेशरेरो डर अथ्थी नईं।<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20" />तैनी अपने मेल रखनेबालन पुड़ भी अपनो हथ खड़ो कियोरोए;</para>
  <para style="q" vid="PSA 55:20">तैनी अपनो करार ट्लोड़ोरोए।<verse eid="PSA 55:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21" />तैन केरि ज़बानरी गल्‍लां मखनी करां जादे मुलायम थी;</para>
  <para style="q" vid="PSA 55:21">पन तैसेरे मने मां लड़ैइअरी गल्‍लां थी;</para>
  <para style="q" vid="PSA 55:21">तैसेरी गल्‍लां तेले करां भी जादे नर्म त थी</para>
  <para style="q" vid="PSA 55:21">पन नग्गी तलवारां थी।<verse eid="PSA 55:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22" />अपनो बोझ यहोवा पुड़ छ़ड तै तीं सम्भालेलो;</para>
  <para style="q" vid="PSA 55:22">तै धेर्मी कधे हिलने न देलो।<note caller="-" style="x"><char style="xo" closed="false">55:22 </char><char style="xt" closed="false"><ref loc="1PE 5:7">1 पत. 5:7</ref>;<ref loc="PSA 37:24">भज. 37:24</ref>.</char></note><verse eid="PSA 55:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23" />पन हे परमेशर, तू तैन लोकन मौतरे गत्ते मां छ़डेलो;</para>
  <para style="q" vid="PSA 55:23">खूनी ते धोखेबाज़ अध्धी उमरी तगर भी ज़ींते न राले।</para>
  <para style="q" vid="PSA 55:23">पन अवं तीं पुड़ भरोसो रखेलो।<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">ज़ुलम केरनेबालन करां छुटनेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई योनतेलेखद्दोकीमे मां दाऊदेरू मिक्ताम ज़ैखन पलिश्ती लोकेईं गत नगरे मां तै ट्लावरो थियो।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1" />हे परमेशर मीं पुड़ दया केर, किजोकि मेरे दुश्मन मीं निगलने चातन,</para>
  <para style="q" vid="PSA 56:1">लड़नेबाले सैरी दिहैड़ी सतातन।<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2" />सैरी दिहैड़ी मेरे दुश्मन मीं पुड़ हमलो केरनो चातन,</para>
  <para style="q" vid="PSA 56:2">किजोकि ज़ैना लोक घमण्ड केरतां मीं सेइं लड़तन तैना बड़ेन।<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3" />ज़ैस वक्ते मीं डर लग्गेलो,</para>
  <para style="q" vid="PSA 56:3">अवं तीं पुड़ भरोसो रेखेलो।<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4" />परमेशरेरी मद्दती सेइं अवं तैसेरे वचनेरी तारीफ़ केरेलो,</para>
  <para style="q" vid="PSA 56:4">परमेशरे पुड़ मीं भरोसो रखोरोए, अवं डरेलो नन्ना।</para>
  <para style="q" vid="PSA 56:4">किजोकि कोई भी मैन्हु मेरू कुन केरि सकते?<verse eid="PSA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5" />तैना सैरी दिहैड़ी मेरी गल्‍लां केरो मतलब ट्लोड़ मरोड़ केरतां गलत मतलब कढतन;</para>
  <para style="q" vid="PSA 56:5">तैन केरे सारे खियाल सिर्फ मेरी बुराई केरनेरे भोतन।<verse eid="PSA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6" />तैना सब मिलतां अकोट्ठे भोतन ते छ़ेपतां बिशतन;</para>
  <para style="q" vid="PSA 56:6">तैना मेरे कदमन तकते रहतन</para>
  <para style="q" vid="PSA 56:6">ज़ेन्च़रे तैना मेरे मारनेरे लेई बिश्शोरे भोन।<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7" />कुन तैना बुराई केरतां भी बेंच़ी गाले?</para>
  <para style="q" vid="PSA 56:7">हे परमेशर, अपने क्रोधे सेइं मुल्खेरे-मुल्खेरे लोकन बिछ़ोड़!<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8" />तू मेरे दरबदर फिरनेरो हिसाब रखतस;</para>
  <para style="q" vid="PSA 56:8">तू मेरा ऐंखरू एपनी कुप्पी मां रख!</para>
  <para style="q" vid="PSA 56:8">कुन तैन केरि चर्चा तेरी किताबी मां नईं?<verse eid="PSA 56:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9" />तैखन ज़ैस वक्ते अवं बिनती केरेलो, तैस्से वक्ते मेरे दुश्मन उलटे फिरेले।</para>
  <para style="q" vid="PSA 56:9">इन अवं ज़ानताईं, कि परमेशर मेरे पासे।<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10" />परमेशरेरी मद्दती सेइं अवं तैसेरे वचनेरी तारीफ़ केरेलो,</para>
  <para style="q" vid="PSA 56:10">यहोवारे मद्दती सेइं अवं तैसेरे वचनेरी तारीफ़ केरेलो।<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11" />मीं परमेशरे पुड़ भरोसो रखोरोए, अवं न डरेलो।</para>
  <para style="q" vid="PSA 56:11">इन्सान मेरू कुन केरि सकते?<verse eid="PSA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12" />हे परमेशर, तेरी मिन्नतां केरो भार मीं पुड़े;</para>
  <para style="q" vid="PSA 56:12">अवं तींजो शुक्रेरी बलि च़ैढ़ेलो।<verse eid="PSA 56:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13" />किजोकि तीं मेरी जान मौती करां बच़ेवरीए;</para>
  <para style="q" vid="PSA 56:13">तीं मेरे पव झिशकने करां भी बच़ावरेन,</para>
  <para style="q" vid="PSA 56:13">ताके अवं परमेशरेरे सामने ज़ींतां केरि लोई मां च़ेलि फिरी सेकी।<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">दुश्मन्न करां बच़नेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई अल-तशहेतेरे रागे मां दाऊदेरो मिक्ताम; ज़ैखन शाऊले करां नेशतां कुढी मां छ़ेप्पी जेवरो थियो</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1" />हे परमेशर, मीं पुड़ दया केर, मीं पुड़ दया केर,</para>
  <para style="q" vid="PSA 57:1">किजोकि अवं तेरी शरणी मां रहताईं;</para>
  <para style="q" vid="PSA 57:1">ते ज़ांतगर मीं पुड़ेरां आफतां टेली न गान,</para>
  <para style="q" vid="PSA 57:1">तांतगर अवं तेरे फंघन हैठ शरण नेइतां रेइलो।<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2" />अवं परमप्रधान परमेशरे कां बिनती केरेलो,</para>
  <para style="q" vid="PSA 57:2">परमेशरे ज़ै मेरे लेई सब किछ केरते।<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3" />परमेशर सुर्गेरां जुवाब देलो ते मीं बच़ालो,</para>
  <para style="q" vid="PSA 57:3">ज़ैखन मेरो निगलने बालो निन्दा केरि राहोरो भोए। <char style="qs">(सेला) </char></para>
  <para style="q" vid="PSA 57:3">परमेशर अपनि दया ते सच़्च़ाई बांदी केरेलो।<verse eid="PSA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4" />मेरी जान शेरां केरे मझ़ाटे,</para>
  <para style="q" vid="PSA 57:4">मीं फुकने बालां केरे दरमियान लेटनू पेते,</para>
  <para style="q" vid="PSA 57:4">मतलब एरे लोकां केरे दरमियाने मां ज़ैन केरे दंत बर्छी ते तीरन,</para>
  <para style="q" vid="PSA 57:4">ते ज़ैन केरि ज़िभ तेज़ तलवारे।<verse eid="PSA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5" />हे परमेशर तू सुर्गे मां बा बड़ो महान ते महिमा बालोस,</para>
  <para style="q" vid="PSA 57:5">ते तेरी महिमा सैरी धेरती पुड़ फैली गाए!<verse eid="PSA 57:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6" />मेरे दुश्मनेईं मेरे पव्वां केरे लेई ज़ाल बछ़ेइतां छ़डोरूए;</para>
  <para style="q" vid="PSA 57:6">ते मेरी जान ढेली गातीए।</para>
  <para style="q" vid="PSA 57:6">तैनेईं मेरे सामने गत घड़ेरू आहे,</para>
  <para style="q" vid="PSA 57:6">पन एप्पु तैस मां बिछ़ड़ी गानेन। <char style="qs">(सेला) </char><verse eid="PSA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7" />हे परमेशर, मेरो दिल पक्‍कोए, ते मेरो मन पक्‍कोए,</para>
  <para style="q" vid="PSA 57:7">ते गीत ज़ोइलो बल्के भजन किरतन केरेलो।<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8" />हे मेरे मन खड़े भो! हे सैन्गी ते सितार बींझ़ां;</para>
  <para style="q" vid="PSA 57:8">अवं दिहाड़ो निसने करां पेइले बींझ़ेलो।<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9" />हे प्रभु, अवं मुल्खे-मुल्खेरे लोकां केरे दरमियान तेरू शुक्र केरेलो;</para>
  <para style="q" vid="PSA 57:9">रियासतां-रियासतां केरे लोकन मां तेरू भजन ज़ोइलो।<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10" />किजोकि तेरी करुणा सुर्गे तगर उच्‍चीए,</para>
  <para style="q" vid="PSA 57:10">ते तेरी सच़्च़ाई अम्बरे तगर पुज़तीए।<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11" />हे परमेशर तू अम्बरे मरां बा बड़ो महानस!</para>
  <para style="q" vid="PSA 57:11">तेरी महिमा सारे धेरती पुड़ फैली गाए!<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">अन्यायेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई अल-तशहेतेरे रागे मां दाऊदेरो मिक्ताम</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1" />हे मैन्हव,<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="fq" closed="false">हे मैन्हव </char><char style="ft" closed="false">शेक्तिबाले लोक या शेक्ति बालो ईश्वर </char></note> कुन तुस सच़्च़े धार्मिकतारी गल ज़ोतथ?</para>
  <para style="q" vid="PSA 58:1">हे मैन्हव कुन तुस ठीक न्याय केरतथ?<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2" />नईं, तुस अपने मने मां उलटा कम्मां केरतथ;</para>
  <para style="q" vid="PSA 58:2">तुस सैरी मुल्खे मां ज़ुलम केरतथ।<verse eid="PSA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3" />दुष्ट ज़र्मनेरे देंते सही बत्ती करां दूर भोइ गातन,</para>
  <para style="q" vid="PSA 58:3">तैना एपनी अम्मरे पेटे मरां झूठ ज़ोइतां भेटकी गातन।<verse eid="PSA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4" />तैन मां सप्पेरू ज़ेरू ज़ेरहे;</para>
  <para style="q" vid="PSA 58:4">तैस टोंवने सप्पेरे ज़ेरेन ज़ै अपने कन्न बन्द केरतां रखते;<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5" />ते सप्पेरू केत्रो भी रोड़ेच़ारे मन्ट्ल पढ़े,</para>
  <para style="q" vid="PSA 58:5">फिरी भी तैसेरी न शुने।<verse eid="PSA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6" />हे परमेशर, तैन केरे दंत ट्लोड़ी दे;</para>
  <para style="q" vid="PSA 58:6">हे यहोवा, तैन जुवान शेरां केरे दंत ट्लोड़ी दे!<verse eid="PSA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7" />तैना धोइयोइतां पैनेरे ज़ेरे भोइ गान;</para>
  <para style="q" vid="PSA 58:7">ज़ैखन तै अपने तीर च़ाढ़े, तैखन तीर ज़ेन्च़रे दूई टुक्ड़े भोइ गान।<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8" />तैना जिषड़ावलरे ज़ेरे गेलतां नाश भोइ गातन,</para>
  <para style="q" vid="PSA 58:8">ते कौन्शरे ज़ैया भोवरे बच्‍चेरे ज़ेरे ज़ैनी दिहाड़ो नईं लहनो।<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9" />इस करां पेइले कि तुश्शे पतिलन कंटां केरि लप लग्गे,</para>
  <para style="q" vid="PSA 58:9">नीले ते फुकोरे, तैना दूईये तै बाते सेइं उडारेलो।<verse eid="PSA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10" />परमेशरेरो एरहो बदलो लेइतां खुश भोल्हो;</para>
  <para style="q" vid="PSA 58:10">तै अपने पव दुष्टेरे खूने सेइं धोलो।<verse eid="PSA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11" />तैखन लोक ज़ोले, सच़्च़े धर्मी मैन्हेरे लेई फले;</para>
  <para style="q" vid="PSA 58:11">सच़्च़े परमेशरे, ज़ै दुनियाई मां न्याय केरते।<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">बचावेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई अल-तशहेतेरे रागे मां दाऊदेरो मिक्तम; ज़ैखन शाऊलेरे भेज़ोरे लोकेईं घरेरो पहरो दित्तो कि तैस मारन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1" />हे मेरे परमेशर, मीं दुश्मन्न करां बच़ा,</para>
  <para style="q" vid="PSA 59:1">मीं उच्‍चे ठैरी पुड़ रेखतां मेरे दुश्मन्न करां बच़ा।<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2" />मीं बुराई केरनेबाले लोकन करां छुटा,</para>
  <para style="q" vid="PSA 59:2">ते खून केरनेबालन करां मीं आज़ाद केर।<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3" />किजोकि हेर, तैना मीं मारनेरे लेई ताकी मां बिशोरेन;</para>
  <para style="q" vid="PSA 59:3">हे यहोवा मेरो कोई दोष या पाप नईं,</para>
  <para style="q" vid="PSA 59:3">फिरी भी ताकतबर लोक मेरे खलाफ अकोट्ठे भोतन।<verse eid="PSA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4" />अवं बेकसूर आईं फिरी भी तैना मीं सेइं लड़नेरे लेई मेरे पासे दौड़तन;</para>
  <para style="q" vid="PSA 59:4">बींझ़ ते मेरी मद्दत केर, ते इन हेर!<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5" />हे सेनां केरे परमेशर यहोवा,</para>
  <para style="q" vid="PSA 59:5">हे इस्राएलेरे परमेशर सब गैर कौमन सज़ाह देनेरे लेई बींझ़;</para>
  <para style="q" vid="PSA 59:5">कोन्ची धोखेबाज़ ज़ुलम केरनेबाले पुड़ अनुग्रह न केर। <char style="qs">(सेला) </char><verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6" />ड्लवझ़ी मेरे दुश्मन वापस एइतां कुतरेरे ज़ेरे घुक्तन,</para>
  <para style="q" vid="PSA 59:6">ते नगरेरे च़ेवरे पासन घुमतन।<verse eid="PSA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7" />हेर तैना डेकार मारतन, ते तैन केरे ऐशी मां तलवारन,</para>
  <para style="q" vid="PSA 59:7">किजोकि तैना तैन सेइं ज़ोतन, “कौन शुन्ते?”<verse eid="PSA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8" />पन तू हे यहोवा, तैन पुड़ हस्सेलो;</para>
  <para style="q" vid="PSA 59:8">तू गैर कौमां केरो मज़ाक बनालो।<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9" />हे परमेशर, मेरी ताकत, अवं तीं पुड़ ध्यान देइलो,</para>
  <para style="q" vid="PSA 59:9">तू मेरो उच्‍चो क़िलोस।<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10" />परमेशर दया केरतो मीं सेइं मिलेलो;</para>
  <para style="q" vid="PSA 59:10">परमेशर मेरे दुश्मना केरे बारे मां मेरी इच्छा पूरी केरेलो।<verse eid="PSA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11" />तैन नाश न केर, एरू न भोए कि मेरी कौम तीं बिसरी गाए;</para>
  <para style="q" vid="PSA 59:11">हे प्रभु, इश्शी ढाल!</para>
  <para style="q" vid="PSA 59:11">एपनी शेक्ति सेइं तैन तितर बितर केर, ते तैन दबेइ दे।<verse eid="PSA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12" />तै अपने ऐशेरे पाप, ते ओठां केरि गल्‍लन,</para>
  <para style="q" vid="PSA 59:12">ते लानत देने, ते अपने झूठ ज़ोनेरे वजाई सेइं,</para>
  <para style="q" vid="PSA 59:12">घमण्डे मां फसोरे ट्लाए गान।<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13" />सरकी सेइं तैन तबाह केर,</para>
  <para style="q" vid="PSA 59:13">तैन केरो अन्त केर ताके तैना नाश भोइ गान</para>
  <para style="q" vid="PSA 59:13">तैखन लोक ज़ानेले कि परमेशर याकूबे पुड़</para>
  <para style="q" vid="PSA 59:13">बल्के पूरे दुनियाई मां राज़ केरते। <char style="qs">(सेला) </char><verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14" />रोज़ ड्लवझ़ी तैना वापस एइतां कुतरां केरे ज़ेरे घुक्तन,</para>
  <para style="q" vid="PSA 59:14">ते नगरेरे च़ेवरे पासन हंठतन ते फिरतन।<verse eid="PSA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15" />तैना रोट्टरे टुक्ड़ेरे लेई मारे-मारे फिरतन,</para>
  <para style="q" vid="PSA 59:15">ते न रज़्ज़नेरे वजाई सेइं सारी रात कुतरां केरे ज़ेरे घुक्तन।<verse eid="PSA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16" />पन अवं तेरी शेक्तरी तारीफ़ केरेलो;</para>
  <para style="q" vid="PSA 59:16">ते झ़ेझ़ां तेरी दयारे लेई जयजयकार केरेलो।</para>
  <para style="q" vid="PSA 59:16">किजोकि तू मेरो उच्‍चो क़िलोस,</para>
  <para style="q" vid="PSA 59:16">ते मुसीबतरे वक्ते मेरी छ़पनेरी ठारस।<verse eid="PSA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17" />हे मेरी ताकत, अवं तेरू भजन ज़ोइलो,</para>
  <para style="q" vid="PSA 59:17">किजोकि हे परमेशर, तू मेरो उच्‍चो क़िलोस</para>
  <para style="q" vid="PSA 59:17">ते मेरो महरबान परमेशरस।<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">छुटकारेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरो मिक्ताम शूशनेदूत रागे मां। शिक्षा देनेबालो। ज़ैखन तै अरम्नहरैम ते अरमसोबा सेइं लड़ोरो थियो। ते योआबे वापस लूनेरे वैदी मां एदोमी लोकन मरां बारहे हज़ार मड़द मारे</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1" />हे परमेशर, तीं अस शैरी छ़डे,</para>
  <para style="q" vid="PSA 60:1">ते अस ट्लोड़ी छ़डोरेम;</para>
  <para style="q" vid="PSA 60:1">तू सेरकोव; फिरी असां ज़ेरे थिये तेरहे बनाए।<verse eid="PSA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2" />तीं ज़मीन एरी हिलाई; कि ज़मीनी दरज़ां जेई,</para>
  <para style="q" vid="PSA 60:2">तैस ज़मीनरी दरज़न भेरि दे, किजोकि तै हेजू कम्बने लगोरीए।<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3" />तीं अपने लोकन मुश्किल वक्त हिराव;</para>
  <para style="q" vid="PSA 60:3">तीं असन थरकानेबालो दाछ़रो रस पियावरोए।<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4" />ज़ैना तीं करां डरतन तीं तैन झण्डो दित्तोरोए,</para>
  <para style="q" vid="PSA 60:4">कि तै सच़्च़ेरे वजाई सेइं खड़ो कियो गाए। <char style="qs">(सेला) </char><verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5" />अपने देइने हथ्थे सेइं बच़ा, ते इश्शी शुन,</para>
  <para style="q" vid="PSA 60:5">ताके तेरे ट्लारे छुटाए गान।<verse eid="PSA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6" />परमेशर पवित्रतैई सेइं ज़ोते, “अवं खुशी मनेइलो;</para>
  <para style="q" vid="PSA 60:6">अवं शेकेमेरे नगरे बेन्टेलो, ते सुक्‍कोतेरे वैदी नापेइलो।<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7" />गिलाद मेरोए; ते मनश्शे भी मेरोए;</para>
  <para style="q" vid="PSA 60:7">ते एप्रैम मुल्ख मेरे क्रोड़रो टोपे,</para>
  <para style="q" vid="PSA 60:7">ते यहूदा मेरो शाही सोटोए।<verse eid="PSA 60:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8" />मोआबेरो मुल्ख मेरे धोनेरू भांडे;</para>
  <para style="q" vid="PSA 60:8">ते एदोमेरे मुल्खे पुड़ अवं अपनि जुट्टी शैरेलो,</para>
  <para style="q" vid="PSA 60:8">हे पलिश्तीन मुल्ख, मेरे वजाई सेइं जयजयकार केर।”<verse eid="PSA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9" />मीं क़िले बाले नगरे मां कौन पुज़ालो?</para>
  <para style="q" vid="PSA 60:9">एदोम मुल्खे तगर मेरी अगवाई केने कियोरीए?<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10" />हे परमेशर, कुन तीं असां न शारे?</para>
  <para style="q" vid="PSA 60:10">हे परमेशर, तू इश्शी सेनाई सेइं साथी जंगी मां न गास।<verse eid="PSA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11" />दुश्मनेरे खलाफ इश्शी मद्दत केर,</para>
  <para style="q" vid="PSA 60:11">किजोकि इन्सानां केरि मद्दत बेकारे।<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12" />परमेशरेरी मद्दती सेइं अस ज़बरदस्त कम केरमेले;</para>
  <para style="q" vid="PSA 60:12">किजोकि इश्शे दुश्मन्न तैए ढ्लन्च़ी देलो।<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">बचावेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई तारीबाले बाज़े सेइं दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1" />हे परमेशर, मेरी बिनती शुन,</para>
  <para style="q" vid="PSA 61:1">मेरे प्राथनारे पासे ध्यान दे।<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2" />अवं दुनियारे आखरी कूने पुड़ेरां तीं पुकारेलो,</para>
  <para style="q" vid="PSA 61:2">ज़ै चट्टान मेरे लेई उच्‍चीए, तैस पुड़ मीं ने;<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3" />किजोकि तूए मेरी छ़पनेरी ठारस,</para>
  <para style="q" vid="PSA 61:3">ते दुश्मन करां बच़ानेरे लेई उच्‍चो क़िलोस।<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4" />अवं हमेशा तेरे तेम्बु मां बनोरो रेइलो।</para>
  <para style="q" vid="PSA 61:4">अवं तेरे फंघन हैठ छ़ेपतां रेइलो।<verse eid="PSA 61:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5" />किजोकि हे परमेशर, तीं मेरी मिन्नतां शुनी,</para>
  <para style="q" vid="PSA 61:5">ज़ैना तेरे नंव्वे करां डरतन, तैन केरो हिस्सो तीं मीं दित्तोरोए।<verse eid="PSA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6" />राज़े तू लम्मी उमर बखशेलो;<note caller="+" style="f"><char style="fr" closed="false">61:6 </char><char style="fq" closed="false">राज़े तू लम्मी उमर बखशेलो </char><char style="ft" closed="false">तैसेरे एजने बाले पीढ़रे लोक राज़गेद्दी पुड़ बिश्शेले।</char></note></para>
  <para style="q" vid="PSA 61:6">तैसेरे साल पीढ़ी-पीढ़ी केरे बराबर भोल्हे।<verse eid="PSA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7" />तै हमेशा तगर परमेशरेरे हज़ूरी मां रालो;</para>
  <para style="q" vid="PSA 61:7">तू अपनि दया ते सच़्च़ाई तैसेरी हिफाज़तरे लेई ठहरेइतां रख।<verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8" />एन्च़रे सेइं अवं सदा तेरे नंव्वेरू भजन ज़ोइ-ज़ोइ</para>
  <para style="q" vid="PSA 61:8">अपनि मिन्नतां रोज़ पूरी केरेलो।<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">परमेशरेरे मुक्तरे लेई इंतज़ार</para>
  <para style="d">यदूतूनेरे रागे पुड़ बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरू भजन।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1" />सच़्च़े मीं च़ुपच़ाप भोइतां परमेशरेरे पासे मन लेवरोए</para>
  <para style="q" vid="PSA 62:1">मेरी मुक्ति तैसेरे तरफां भोतीए।<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2" />सच़्च़े तैए, मेरी चट्टान ते तैए मेरी मुक्ति आहे,</para>
  <para style="q" vid="PSA 62:2">ते तैए मेरो क़िलोए अवं कधी न बिछ़ड़ेलो।<verse eid="PSA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3" />तुस केइस तगर तैस एक्‍की मैन्हु पुड़ हमलो केरते राले,</para>
  <para style="q" vid="PSA 62:3">कि सब मिलतां तैस मारा?</para>
  <para style="q" vid="PSA 62:3">तै त डुलने बाले दिवारारो ज़ेरो या बिछ़ड़ते बाड़ेरो ज़ेरोए।<verse eid="PSA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4" />सच़्च़े तैना तैसेरे तैस उच्‍ची ठारारां बिछ़ोड़नेरी योजना बनातन;</para>
  <para style="q" vid="PSA 62:4">तैना झूठे सेइं जादे खुशी रहतन।</para>
  <para style="q" vid="PSA 62:4">ऐशी सेइं तैना बरकत देतन पन अन्तरां तैना लानत केरतन। <char style="qs">(सेला) </char><verse eid="PSA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5" />हे मेरे मन, परमेशरेरे सामने च़ुपच़ाप रा,</para>
  <para style="q" vid="PSA 62:5">किजोकि मेरी उमीद तैस्से सेइं आहे।<verse eid="PSA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6" />सच़्च़े तैए मेरी चट्टान, ते मेरी मुक्ति आहे,</para>
  <para style="q" vid="PSA 62:6">ते तैए मेरो गढ़े, एल्हेरेलेइ अवं न बिछ़ड़ेलो;<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7" />मेरी मुक्ति ते मेरी आदर परमेशरेरे तरफां आहे;</para>
  <para style="q" vid="PSA 62:7">ते मज़बूत चट्टान, ते मेरी छ़पनेरी ठार परमेशरे।<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8" />हे लोकव, हर वक्त परमेशरे पुड़ भरोसो रखा;</para>
  <para style="q" vid="PSA 62:8">ते तैस सेइं अपने-अपने मनेरी गल्‍लां खोलतां ज़ोथ;</para>
  <para style="q" vid="PSA 62:8">परमेशर इश्शे छ़पनेरी ठारे। <char style="qs">(सेला) </char><verse eid="PSA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9" />सच़्च़े नीच़ लोक त किछ वक्तेरे आन, ते बड़े लोक झूठेन;</para>
  <para style="q" vid="PSA 62:9">तोले मां तैन पोल्‍ले निस्सतन;</para>
  <para style="q" vid="PSA 62:9">तैना सभेरे सब शाहे करां भी पोल्‍ले आन।<verse eid="PSA 62:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10" />ज़ुलम केरने पुड़ भरोसो न केरा,</para>
  <para style="q" vid="PSA 62:10">च़ोरी केरने पुड़ घमण्ड न केरा;</para>
  <para style="q" vid="PSA 62:10">ते अगर दौलत बेधी गाए त तैस पुड़ मन नईं लानो।<note caller="-" style="x"><char style="xo" closed="false">62:10 </char><char style="xt" closed="false"><ref loc="MAT 19:21-22">मत. 19:21-22</ref>;<ref loc="1TI 6:17">1 तीम. 6:17</ref>.</char></note><verse eid="PSA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11" />परमेशरे एक्‍की बार ज़ोवं;</para>
  <para style="q" vid="PSA 62:11">ते दूई बार मीं इन शुनू:</para>
  <para style="q" vid="PSA 62:11">कि सामर्थ परमेशरेरी आहे।<verse eid="PSA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12" />ते हे प्रभु, करुणा भी तेरी आहे,</para>
  <para style="q" vid="PSA 62:12">किजोकि हर कोन्ची तू तैस्सेरे कम्मेरे मुताबिक बदलो देतस।<note caller="-" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="DAN 9:9">दान. 9:9</ref>;<ref loc="MAT 16:27">मत. 16:27</ref>;<ref loc="ROM 2:6">रोम. 2:6</ref>;<ref loc="REV 22:12">प्रका. 22:12</ref>.</char></note><verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">ट्लिशरो मन परमेशरे मां रज़्ज़ते</para>
  <para style="d">दाऊदेरू भजन; ज़ैखन यहूदारे जंगले मां थियो।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1" />हे परमेशर, तू मेरो परमेशर आस,</para>
  <para style="q" vid="PSA 63:1">अवं तीं दिले सेइं तोपेलो;</para>
  <para style="q" vid="PSA 63:1">शुकोरी ते ट्लिशोरी ज़मीनी मां ज़ैड़ी पानी नईं,</para>
  <para style="q" vid="PSA 63:1">मेरे मने तेरी ट्लिशे, मेरो जिसम तेरी बड़ी इच्छा केरते।<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2" />एन्च़रे सेइं मीं पवित्र ठारी मां तीं पुड़ नज़र की,</para>
  <para style="q" vid="PSA 63:2">कि तेरी शक्ति ते महिमा हेरी।<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3" />किजोकि तेरी दया ज़िन्दगी भर बड़ी रोड़ीए,</para>
  <para style="q" vid="PSA 63:3">अवं तेरी तारीफ़ केरेलो।<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4" />एन्च़रे सेइं अवं ज़िन्दगी भर तीं धन ज़ोतो रेइलो;</para>
  <para style="q" vid="PSA 63:4">ते तेरू नवं घिन्तां अपने प्राथनाई मां हथ खड़े केरेलो।<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5" />मेरी जान ज़ेन्च़रे चर्भी ते खूब रोड़ी रोट्टी सेइं रज़्ज़ेली,</para>
  <para style="q" vid="PSA 63:5">ते अवं जयजयकार केरतां तेरी बडीयाई केरेलो।<verse eid="PSA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6" />ज़ैखन अवं खट्टी पुड़ भोल्हो तीं याद केरेलो,</para>
  <para style="q" vid="PSA 63:6">तैखन रातरे एक्‍की-एक्‍की पहरे मां अवं तीं पुड़ ध्यान केरेलो;<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7" />किजोकि तू हमेशा मेरी मद्दत केरनेबालो बनोरोस,</para>
  <para style="q" vid="PSA 63:7">एल्हेरेलेइ अवं तेरे फंघां केरि छावी मां जयजयकार केरेलो।<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8" />मेरो मन तीं पत्ती-पत्ती लगोरो रहते;</para>
  <para style="q" vid="PSA 63:8">ते तेरो देइनो हथ मीं सुमैलतां रखते।<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9" />पन ज़ैना मीं मारनेरे लेई तियारन;</para>
  <para style="q" vid="PSA 63:9">तैना ज़मीनी मां उन्ढे गाले।<note caller="+" style="f"><char style="fr" closed="false">63:9 </char><char style="fq" closed="false">ज़मीनी मां उन्ढे गाले </char><char style="ft" closed="false">मरोरे लोकां केरे जहाने मां</char></note><verse eid="PSA 63:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10" />तैना तलवारारे हवाले किये गाले,</para>
  <para style="q" vid="PSA 63:10">ते तैना गिद्दां केरि खूराक बेनि गाले।<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11" />पन राज़ो परमेशरेरे वजाई सेइं खुशी रालो;</para>
  <para style="q" vid="PSA 63:11">ज़ै भी परमेशरेरी कसम केरेलो, तै घमण्ड केरेलो;</para>
  <para style="q" vid="PSA 63:11">किजोकि झूठ ज़ोने बालां केरां आशी बन्द कियां गालां।<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">अनर्थ केरनेबालन करां बचाव</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1" />हे परमेशर, ज़ैखन अवं तीं कां बिनती केरि, तैखन मेरी शुन;</para>
  <para style="q" vid="PSA 64:1">मेरी ज़िन्दगी दुश्मना केरे डरे करां बच़ेइतां रख।<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2" />मीं कुकर्मी मैन्हु केरि साज़िशी करां,</para>
  <para style="q" vid="PSA 64:2">ते अनर्थ केरनेबालां केरे हंगामे करां छ़ुपेइतां रख।<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3" />तैनेईं अपनि ज़बान तलवारारी ज़ेरि तेज़ कियोरीए,</para>
  <para style="q" vid="PSA 64:3">ते अपनि सखत गल्‍लां केरे तीर च़ाढ़तन।<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4" />ताके छ़ेपतां बिशतां तैन बेकसूरन पुड़ च़लान;</para>
  <para style="q" vid="PSA 64:4">तैना निडर भोइतां अचानक तैन मारतन भी।<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5" />तैना बुरां कम्मां केरनेरे लेई हिम्मत केरतन;</para>
  <para style="q" vid="PSA 64:5">तैना एक्‍की होरि सेइं फंदे लानेरे लेई मुशोरो भी केरतन,</para>
  <para style="q" vid="PSA 64:5">ते अपने आपे सेइं ज़ोतन, “असन कौन लाहेलो?”<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6" />तैना बुरी योजना कढतन;</para>
  <para style="q" vid="PSA 64:6">ते एक्‍की होरि सेइं ज़ोतन, “असेईं पक्‍की योजना तोपतां कढी।”</para>
  <para style="q" vid="PSA 64:6">किजोकि मैन्हेरो मन ते दिलेरे खियाल डुग्घे आन।<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7" />पन परमेशर तैन पुड़ तीर च़लालो;</para>
  <para style="q" vid="PSA 64:7">ते अचानक तैना ज़खमी भोइ गानेन।<verse eid="PSA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8" />तैना एपनी गल्‍लन सेइं ठोकर खेइतां बिछ़ड़ी गाले;</para>
  <para style="q" vid="PSA 64:8">ज़ेत्रे भी तैन तकेले, तैना सब मज़ाक बनानेरे लेई अपनि-अपनि क्रोड़ी हिलाले।<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9" />तैखन सब लोक डेरि गाले;</para>
  <para style="q" vid="PSA 64:9">ते परमेशरेरे कम्मां केरे बारे मां बियान केरेले,</para>
  <para style="q" vid="PSA 64:9">ते तैसेरे कम्मन रोड़ेच़ारे समझ़ेले।<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10" />धर्मी त यहोवारे वजाई सेइं खुशी भोइतां तैस कां शरण घिन्नेलो,</para>
  <para style="q" vid="PSA 64:10">ते ज़ैना दिलेरे सच़्च़े आन, तैना सब घमण्ड केरेले।<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">परमेशरेरी बडीयाई ते शुक्र केरनू</para>
  <para style="d">बज़ानेबालां केरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1" />हे परमेशर, सिय्योने<note caller="+" style="f"><char style="fr" closed="false">65:1 </char><char style="fq" closed="false">सिय्योने </char><char style="ft" closed="false">यरूशलेमे क़िले बालू पहाड़</char></note> मां बडीयाई तीं बलगतीए;</para>
  <para style="q" vid="PSA 65:1">ते तेरे लेई मिन्नतां पूरी की गैली।<note caller="-" style="x"><char style="xo" closed="false">65:1 </char><char style="xt" closed="false"><ref loc="ACT 10:34-35">प्रेरित. 10:34-35</ref>;<ref loc="ISA 66:23">यशा. 66:23</ref>.</char></note><verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2" />हे प्राथनारे शुन्ने बाले!</para>
  <para style="q" vid="PSA 65:2">सारे मैन्हु तीं कां एज्जेले।<verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3" />बुरां कम्मां मीं पुड़ बड़ां भारी भेवरन;</para>
  <para style="q" vid="PSA 65:3">तूए इश्शे पाप माफ़ केरेलो।<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4" />केत्रो धने तै, ज़ैस तू च़ुनतां अपने नेड़े एजने देतस,</para>
  <para style="q" vid="PSA 65:4">कि तै तेरे भवनेरे अंगन्न मां राए!</para>
  <para style="q" vid="PSA 65:4">अस तेरे भवनेरे, मतलब तेरे पवित्र मन्दरेरी रोड़ी-रोड़ी चीज़न सेइं रज़्ज़म।<verse eid="PSA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5" />हे इश्शे मुक्ति देनेबाले परमेशर,</para>
  <para style="q" vid="PSA 65:5">हे दुनियारे सब दूर-दूरेरे मुल्खां केरे ते दूर समुन्दरे पुड़ रानेबालां केरे आधार,</para>
  <para style="q" vid="PSA 65:5">तू धार्मिकता सेइं कियोरे बड्डे कम्मन सेइं असन जुवाब देलो;<verse eid="PSA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6" />तू एपनी शेक्ति सेइं पहाड़ां केरि पक्‍की मुनीयाद बनातस,</para>
  <para style="q" vid="PSA 65:6">ते एपनी ताकती सेइं तड़बज़ रहतस।<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7" />तू ज़ै समुन्दरां केरि भारी शोर, तैसेरे छ़ेल्ही केरि भारी शोर,</para>
  <para style="q" vid="PSA 65:7">ते मुल्खे-मुल्खेरे लोकां केरि शोर शराबो खतम केरतस।<note caller="-" style="x"><char style="xo" closed="false">65:7 </char><char style="xt" closed="false"><ref loc="MAT 8:26">मत. 8:26</ref>;<ref loc="ISA 17:12-13">यशा. 17:12-13</ref>.</char></note><verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8" />एल्हेरेलेइ दूर-दूर मुल्खां केरे रानेबाले तेरे निशान देइतां डेरि जेवरेन;</para>
  <para style="q" vid="PSA 65:8">ते तू झ़ेझ़ां दिहाड़ो निसने करां देइतां दिहाड़ो डुबने तगर खुशी मनाने देतस।<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9" />तू ज़मीनरी हेरगेश केरतां तैस पैनी सेइं सगतस,</para>
  <para style="q" vid="PSA 65:9">तू तैस बड़ी फलदार केरतस;</para>
  <para style="q" vid="PSA 65:9">परमेशरेरो दरिया पैनी सेइं भरोरो रहते,</para>
  <para style="q" vid="PSA 65:9">तू ज़मीन तियार केरतां मैन्हु केरे लेई अन्न तियार केरतस।<verse eid="PSA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10" />तू उडारेरी सींथन रोड़ेच़ारे सगतस,</para>
  <para style="q" vid="PSA 65:10">ते तैन केरि मझ़ेटीं मित्ती बिशालतस,</para>
  <para style="q" vid="PSA 65:10">तू ज़मीन झ़ेड़ी सेइं नर्म केरतस,</para>
  <para style="q" vid="PSA 65:10">ते तैसेरी फसली पुड़ बरकत देतस।<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11" />तेरी भलैइयन सेइं, तू बिरै ताजे लुवातस;</para>
  <para style="q" vid="PSA 65:11">ते तेरी बत्ती मां रोड़ी-रोड़ी फसल मैलचे।<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12" />तैना जंगलेरे चरागान मां ते ड्लबड़ां नीले-नीले घासे सेइं भेरतां भोतन;</para>
  <para style="q" vid="PSA 65:12">ते पहाड़ां रंगबरंगां लिगड़ां लातन।<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13" />सरसब्ज़ पहाड़ां भैड्डां छ़ेल्‍लेईं सेइं भोतन,</para>
  <para style="q" vid="PSA 65:13">ते वैदी अन्ने सेइं ढेक्‍की गैतिन,</para>
  <para style="q" vid="PSA 65:13">सब जयजयकार केरती ते गीतां ज़ोतन।<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">बड्डां-बड्डां कम्मां केरे लेई परमेशरेरी बडीयाई</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1" />हे सब धेरती पुड़ रानेबाले लोकव, परमेशरेरे लेई जयजयकार केरा;<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />तैसेरे नंव्वेरे महिमारू भजन ज़ोथ;</para>
  <para style="q" vid="PSA 66:2">तैसेरी बडीयाई केरतां, तैसेरी महिमा केरा।<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />परमेशरे सेइं ज़ोथ, “तेरां कम्मां केत्रां भयानक आन!</para>
  <para style="q" vid="PSA 66:3">तेरी बड़ी शेक्तरे वजाई सेइं दुश्मन तेरे सामने झुकेले।<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />सारे दुनियारे लोक तीं कां झुकेले,</para>
  <para style="q" vid="PSA 66:4">ते तेरू भजन ज़ोले;</para>
  <para style="q" vid="PSA 66:4">तैना तेरे नंव्वेरू भजन ज़ोले।” <char style="qs">(सेला) </char><verse eid="PSA 66:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />एज्जा, परमेशरेरां कम्मां हेरा।</para>
  <para style="q" vid="PSA 66:5">तै अपने कम्मां केरे वजाई सेइं मैन्हन डरेरे काबल लेइहोते।<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />यहोवा लाल समुन्दर खुशक ज़मीनी मां बेदली दित्तो।</para>
  <para style="q" vid="PSA 66:6">इश्शे पूर्वज समुन्दरे मांमेइं पैदल पार जे।</para>
  <para style="q" vid="PSA 66:6">तैड़ी अस तैसेरे वजाई सेइं खुशी भोए,<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />तै एपनी कुदरती सेइं हमेशा हुकूमत केरते;</para>
  <para style="q" vid="PSA 66:7">तैसेरी एछ़्छ़ी कौमन पुड़ लेगोरी रेइचन,</para>
  <para style="q" vid="PSA 66:7">बगावत केरनेबालो क्रोड़ी खड़ी न केरे। <char style="qs">(सेला) </char><verse eid="PSA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />हे मुल्ख-मुल्खेरे लोकव इश्शे परमेशरे जो धन ज़ोथ,</para>
  <para style="q" vid="PSA 66:8">ते तैसेरी तारीफ़रे लेई आवाज़ उच्‍ची केरा।<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />ज़ै असन ज़ींतो रखते;</para>
  <para style="q" vid="PSA 66:9">ते इश्शे पव घिश्कने न दे।<verse eid="PSA 66:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />किजोकि हे परमेशर, तीं अस अज़माए;</para>
  <para style="q" vid="PSA 66:10">ज़ेन्च़रे चाँदी शुद्ध केरतन तेन्च़रे तीं असां शुद्ध किये।<note caller="-" style="x"><char style="xo" closed="false">66:10 </char><char style="xt" closed="false"><ref loc="1PE 1:7">1 पत. 1:7</ref>;<ref loc="ISA 48:10">यशा. 48:10</ref>.</char></note><verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />तीं असां जाले मां फसाए;</para>
  <para style="q" vid="PSA 66:11">ते इश्शे टेन्टू पुड़ भारी बोझ रखोरो थियो।<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />तीं दुश्मन इश्शे दोग्गे पुड़ च़लावाए,</para>
  <para style="q" vid="PSA 66:12">असां अग्गी ते पैनी मांमेइं जे;</para>
  <para style="q" vid="PSA 66:12">पन फिरी तीं असां तैट्ठां केढतां सुखे सेइं भरोरेम।<verse eid="PSA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />अवं होमबलि एन्हतां तेरे घरे मां एज्जेलो;</para>
  <para style="q" vid="PSA 66:13">ते तेरी हज़ूरी मां एपनी मिन्नतां पूरी केरेलो;<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />तैना मिन्नतां ज़ैना मीं अपने ऐशी सेइं मेन्नी,</para>
  <para style="q" vid="PSA 66:14">ते मुसीबतरे मौके मेन्नोरी थी।<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />होमबेलरे तौरे पुड़ अवं बड्डे-बड्डे जानबर,</para>
  <para style="q" vid="PSA 66:15">हुड़ां केरि चर्भी धूपे समेत च़ैढ़ेलो;</para>
  <para style="q" vid="PSA 66:15">अवं थाव्वन समेत दांतन च़ैढ़ेलो। <char style="qs">(सेला) </char><verse eid="PSA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />हे सब परमेशरेरो डर मन्ने बालाव, एइतां शुना,</para>
  <para style="q" vid="PSA 66:16">अवं ज़ोइलो कि तैने मेरे लेई कुन-कुन कियूं।<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />मीं तै पुकारो,</para>
  <para style="q" vid="PSA 66:17">ते तैसेरी तारीफ़ मीं करां भोइ।<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />अगर अवं अपने मने मां पापेरी गल्‍लां सोचेथो,</para>
  <para style="q" vid="PSA 66:18">त प्रभु मेरी प्राथना न शुनेथो।<note caller="-" style="x"><char style="xo" closed="false">66:18 </char><char style="xt" closed="false"><ref loc="JHN 9:31">यूह. 9:31</ref>;<ref loc="PRO 15:29">कह. 15:29</ref>.</char></note><verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />पन सच़्च़े परमेशरे मेरी पुकार शुनी;</para>
  <para style="q" vid="PSA 66:19">तैनी मेरी प्राथनाई पुड़ ध्यान दित्तू।<verse eid="PSA 66:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />धने परमेशर,</para>
  <para style="q" vid="PSA 66:20">ज़ैने न त मेरी प्राथना अनशुनी की,</para>
  <para style="q" vid="PSA 66:20">ते न अपनि दया मीं करां दूर कियोरीए!<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">शुक्रेरू भजन</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई तारीबाले बाज़न सेइं भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1" />परमेशर असन पुड़ अनुग्रह केरे ते असन बरकत दे;</para>
  <para style="q" vid="PSA 67:1">तै अपने तुत्तरेरी लौ असन पुड़ चमकाए, <char style="qs">(सेला) </char><verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2" />ज़ैस सेइं तेरी बत ज़मीनी पुड़,</para>
  <para style="q" vid="PSA 67:2">ते तेरी कियोरी मुक्ति सारे कौमन मां ज़ानी गाए।<note caller="-" style="x"><char style="xo" closed="false">67:2 </char><char style="xt" closed="false"><ref loc="LUK 2:30-31">लूक. 2:30-31</ref>;<ref loc="TIT 2:11">तीत. 2:11</ref>.</char></note><verse eid="PSA 67:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3" />हे परमेशर, मुल्ख-मुल्खेरे लोक तेरू शुक्र केरन,</para>
  <para style="q" vid="PSA 67:3">मुल्ख-मुल्खेरे सब लोक तेरू शुक्र केरेले।<verse eid="PSA 67:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4" />रियासतां-रियासतां केरे लोक आनन्द केरन,</para>
  <para style="q" vid="PSA 67:4">ते जयजयकार केरन,</para>
  <para style="q" vid="PSA 67:4">किजोकि तू मुल्ख-मुल्खेरे लोकां केरो धार्मिकताई सेइं न्याय केरेलो,</para>
  <para style="q" vid="PSA 67:4">ते दुनियारे रियासतां-रियासतां केरे लोकां केरि अगवाई केरेलो। <char style="qs">(सेला) </char><verse eid="PSA 67:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5" />हे परमेशर, मुल्ख-मुल्खां केरे लोक तेरू शुक्र केरन;</para>
  <para style="q" vid="PSA 67:5">मुल्ख-मुल्खेरे सब लोक तेरू शुक्र केरन।<verse eid="PSA 67:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6" />ज़मीन अपनि फसल देचे,</para>
  <para style="q" vid="PSA 67:6">परमेशर ज़ै इश्शो परमेशरे, तैने असन बरकत दित्ती।<verse eid="PSA 67:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7" />परमेशर असन बरकत देलो;</para>
  <para style="q" vid="PSA 67:7">ते दुनियारे दूर-दूर मुल्खां केरे सब लोक तैसेरो डर मन्नेले।<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">इस्राएलेरू ज़ींतरू गीत</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1" />परमेशर उठे, त तैसेरे दुश्मन तितर-बितर भोन;</para>
  <para style="q" vid="PSA 68:1">तैस सेइं नफरत केरनेबाले तैसेरे सामनेरां नेश्शी गाले!<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2" />ज़ेन्च़रे तूं उडरते, तेन्च़रे तू तैन ऊडार;</para>
  <para style="q" vid="PSA 68:2">ज़ेन्च़रे मोम अग्गी सेइं गलते,</para>
  <para style="q" vid="PSA 68:2">तेन्च़रे बुरे लोक परमेशरेरी हज़ूरी मां नाश भोइ गाले।<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3" />पन धर्मी खुशी भोन; तैना परमेशरेरे सामने खुश भोन;</para>
  <para style="q" vid="PSA 68:3">तैना आनन्दे मां मघन भोन!<verse eid="PSA 68:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4" />परमेशरेरां गीतां ज़ोथ, तैसेरे नंव्वेरू भजन ज़ोथ;</para>
  <para style="q" vid="PSA 68:4">ज़ैना बगैर पैनेरे मुल्खन मां सुवार भोइतां च़लतन,</para>
  <para style="q" vid="PSA 68:4">तैसेरे लेई सड़क बनाथ;</para>
  <para style="q" vid="PSA 68:4">तैसेरू नवं यहोवाए, एल्हेरेलेइ तुस तैसेरे सामने खुश भोथ!<verse eid="PSA 68:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5" />परमेशर अपने रानेरे ठैरी<note caller="+" style="f"><char style="fr" closed="false">68:5 </char><char style="fq" closed="false">रानेरे ठैरी </char><char style="ft" closed="false">अपने पवित्र घरे मां</char></note> मां,</para>
  <para style="q" vid="PSA 68:5">अनाथां केरो बाजी ते विधवां केरो न्याय केरनेबालोए।<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6" />परमेशर अनाथां केरू घर बसाते;</para>
  <para style="q" vid="PSA 68:6">ते कैदन छुटेइतां आज़ाद केरते;</para>
  <para style="q" vid="PSA 68:6">पन मुखालफन शुकोरी ज़मीनी पुड़ रानू पेते।<verse eid="PSA 68:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7" />हे परमेशर, ज़ैखन तू अपने लोकन अग्री-अग्री च़लतो थियो,</para>
  <para style="q" vid="PSA 68:7">ज़ैखन तू शुकोरी ज़मीनी मां सेनाई समेत च़लो, <char style="qs">(सेला) </char><verse eid="PSA 68:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8" />तैखन ज़मीन हिलने लगी</para>
  <para style="q" vid="PSA 68:8">ते अम्बर भी परमेशरेरे सामने बिछ़ड़ने लगू,</para>
  <para style="q" vid="PSA 68:8">सीनै पहाड़ परमेशर, हाँ इस्राएलेरे परमेशरेरे सामने हिल्‍ली जेवं।<note caller="-" style="x"><char style="xo" closed="false">68:8 </char><char style="xt" closed="false"><ref loc="HEB 12:26">इब्रा. 12:26</ref>;<ref loc="JDG 5:4-5">न्या. 5:4-5</ref>.</char></note><verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9" />हे परमेशर, तीं बेहिसाब झ़ड़ी दित्ती;</para>
  <para style="q" vid="PSA 68:9">तेरो अपनो हिस्सो त बड़ो शुकोरो थियो, पन तीं तै हरो भरो कियो;<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10" />तेरे लोक तैस मां बस्सने लग्गे;</para>
  <para style="q" vid="PSA 68:10">हे परमेशर तीं अपने भलियाई सेइं गरीब मैन्हेरे लेई तियारी कियोरीए।<verse eid="PSA 68:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11" />प्रभु हुक्म देते,</para>
  <para style="q" vid="PSA 68:11">तैखन खुशरी खबर शुन्नेबालां केरि बड़ी सेना भोइ गातीए।<verse eid="PSA 68:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12" />अपने-अपने सेनाई समेत दुश्मन राज़े नशते गातन,</para>
  <para style="q" vid="PSA 68:12">ते कौन्शां लूटी मां बेन्टी गैतिन।<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13" />कुन तुस गब्बां केरे बाड़े मां झ़ुल्‍ली गाले?</para>
  <para style="q" vid="PSA 68:13">ते एरे कबूतरारे ज़ेरे भोल्हे ज़ैसेरां फंघां चैंदी सेइं</para>
  <para style="q" vid="PSA 68:13">ते ज़ैसेरां फंघां हेइड्ले सोन्ने सेइं पलैटोरां भोन?<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14" />ज़ैखन सर्वशक्तिमान परमेशरे तैसेरे राज़े तितर-बितर किये,</para>
  <para style="q" vid="PSA 68:14">तैखन मन्ना कि सल्मोन पहाड़े पुड़ हिवं पेव।<verse eid="PSA 68:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15" />बाशानेरू पहाड़ परमेशरेरू पहाड़े;</para>
  <para style="q" vid="PSA 68:15">बाशानेरू पहाड़ बड़ू उच्‍चु पहाड़े।<verse eid="PSA 68:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16" />पन हे उच्‍चे पहाड़व, तुस किजो तैस पहाड़े घूरतथ,</para>
  <para style="q" vid="PSA 68:16">ज़ैन परमेशरे अपने बासेरे लेई चावरू आहे,</para>
  <para style="q" vid="PSA 68:16">ते ज़ैड़ी यहोवा हमेशा बास केरेलो?<verse eid="PSA 68:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17" />परमेशरेरे रथ बीह हज़ार, बल्के हज़ारेईं-हज़ारेईं आन;</para>
  <para style="q" vid="PSA 68:17">प्रभु तैन केरे दरमियाने,</para>
  <para style="q" vid="PSA 68:17">ज़ेन्च़रे तै सीनै नंव्वेरे पवित्र ठैरी मांए।<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18" />तू उच्‍चे पुड़ च़ढ़, तू लोकन गुलैमी मां घिन्नी जेव;</para>
  <para style="q" vid="PSA 68:18">तीं मैन्हन करां, बल्के ढीठ मैन्हन करां भी भेंट नेही,</para>
  <para style="q" vid="PSA 68:18">ज़ैस सेइं यहोवा तैन मां बास केरे।<note caller="-" style="x"><char style="xo" closed="false">68:18 </char><char style="xt" closed="false"><ref loc="EPH 4:8">इफि. 4:8</ref>.</char></note><verse eid="PSA 68:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19" />धने तै प्रभु, ज़ै रोज़ इश्शो भारो छ़ूते;</para>
  <para style="q" vid="PSA 68:19">तैए इश्शो मुक्ति देनेबालो परमेशरे। <char style="qs">(सेला) </char><verse eid="PSA 68:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20" />तैए इश्शे लेई बच़ानेबालो परमेशर ठहरो;</para>
  <para style="q" vid="PSA 68:20">यहोवा प्रभु मौती करां भी बच़ाते।<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21" />पक्‍को परमेशर अपने दुश्मना केरे क्रोड़ी पुड़;</para>
  <para style="q" vid="PSA 68:21">ते ज़ै अधर्मेरे बत्ती पुड़ च़लतो रहते,</para>
  <para style="q" vid="PSA 68:21">तैसेरे बालन समेत भेरतां खोपड़ी भेन्नी देलो।<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22" />प्रभुए ज़ोवं, “अवं तैस बाशाने मरां केढतां आनेलो,</para>
  <para style="q" vid="PSA 68:22">समुन्दरेरे थलेरां भी अवं वापस एन्हेलो।<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23" />कि तू अपने पव्वन खूने मां डोबेलो,</para>
  <para style="q" vid="PSA 68:23">ते तेरे दुश्मन तेरे कुतरां केरो हिस्सो भोल्हे।”<verse eid="PSA 68:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24" />हे यहोवा परमेशर, तेरे जुल्‍लूस लेइहोने लगोरेन।</para>
  <para style="q" vid="PSA 68:24">मेरे परमेशर, राज़ेरे जुल्‍लूस पवित्र ठैरी लेइहोने लगोरेन।<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />अग्री-अग्री गीतां ज़ोनेबाले ते पत्पती साज़ बज़ानेबाले च़ेली राहोरेन,</para>
  <para style="q" vid="PSA 68:25">ते च़ेवरे पासन जुवान कुइयां डफली बज़ैती थी।<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />सभान मां यहोवारू</para>
  <para style="q" vid="PSA 68:26">हे इस्राएलेरे चशमे मरां निस्सोरे लोकव,</para>
  <para style="q" vid="PSA 68:26">प्रभुएरू शुक्र केरा।<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27" />पेइलो बिन्यामीन ज़ै सेभन करां निकड़ो गोत्रे,</para>
  <para style="q" vid="PSA 68:27">फिरी यहूदारे हाकिम ते तैन केरि सभा</para>
  <para style="q" vid="PSA 68:27">ते जबूलून ते नप्ताली एरे हाकिम आन।<verse eid="PSA 68:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28" />तेरे परमेशरे तेरी शक्ति बनेवरीए,</para>
  <para style="q" vid="PSA 68:28">हे परमेशर अपनि शक्ति असन पुड़ बांदी केर, ज़ेन्च़रे तीं पेइली बांदी कियोरीए।<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29" />तेरे भवनेरे वजाई सेइं ज़ैन यरूशलेमे मांए,</para>
  <para style="q" vid="PSA 68:29">राज़ो तेरे लेई भेंट आनेलो।<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30" />निरैठन मां रानेबाले जंगली जानबरन,<note caller="-" style="x"><char style="xo" closed="false">68:30 </char><char style="xt" closed="false"><ref loc="EZK 29:3">यहे. 29:3</ref>.</char></note></para>
  <para style="q" vid="PSA 68:30">संढां केरे झुण्ड ते मुल्खे-मुल्खेरे बछ़ड़न झ़िड़क दे,</para>
  <para style="q" vid="PSA 68:30">तैना चैंदरे टुक्डां केरे लेई झुकेले;</para>
  <para style="q" vid="PSA 68:30">ज़ैना लोक जंगी सेइं खुशी रहतन, तैना तैनी तितर-बितर कियोरेन।<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31" />मिस्रे मरां अधिकारी एज्जेले;</para>
  <para style="q" vid="PSA 68:31">कूशी<note caller="+" style="f"><char style="fr" closed="false">68:31 </char><char style="fq" closed="false">कूशी </char><char style="ft" closed="false">एथोपिया मुल्खेरे रानेबाले</char></note> अपने हथ प्राथनाई मां परमेशरेरे पासे बड़े लूशी खड़े केरेले।<verse eid="PSA 68:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32" />हे ज़मीनरे रियासतां-रियासतां केरे लोकव परमेशरेरू गीत ज़ोथ;</para>
  <para style="q" vid="PSA 68:32">प्रभुएरू भजन ज़ोथ, <char style="qs">(सेला)</char><verse eid="PSA 68:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33" />ज़ै सेभना उच्‍चे सनातन सुर्गे मां सुवार भोइतां च़लते;</para>
  <para style="q" vid="PSA 68:33">हेरा तै अपनि आवाज़ शुन्ते, तै गम्भीर आवाज़ शेक्ति बालीए।<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34" />परमेशरेरी शेक्तरे बारे एलान केरा,</para>
  <para style="q" vid="PSA 68:34">तैसेरी महिमा इस्राएले पुड़ पेवरीए,</para>
  <para style="q" vid="PSA 68:34">ते तैसेरी शक्ति अम्बरे मांए।<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35" />हे परमेशर, तू अपने पवित्र ठारन मां डरेरे काबलस,</para>
  <para style="q" vid="PSA 68:35">इस्राएलेरो परमेशरे अपने लोकन ताकत ते शक्ति देनेबालोए।</para>
  <para style="q" vid="PSA 68:35">परमेशर धने।<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">मुसीबती मां मद्दतरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई शोशन्नीम रागे मां दाऊदेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1" />हे परमेशर, मीं बच़ा, अवं हड़ेरे पैनी मां डुबी राहोरोईं।<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2" />अवं बड़े च़िकरी मां डुबने लगोरोईं, ते मेरे पव कोन्ची न रुकन;</para>
  <para style="q" vid="PSA 69:2">अवं डुग्घे पैनी मां एज्जी जेव, ते पैनी मां डुब्बी गाताईं।<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3" />अवं पुकारते-पुकारते थेकी जेव, मेरू गल बन्द भोइ जेवरूए;</para>
  <para style="q" vid="PSA 69:3">अपने परमेशरेरो इंतज़ार केरते-केरते मेरी एछ़्छ़ी केनोई जेवरिन।<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4" />ज़ैना बिलावजह मीं सेइं बैर रखतन, तैना गिनती मां मेरे दोग्गेरे बालन करां भी जादेन;</para>
  <para style="q" vid="PSA 69:4">मेरे नाश केरनेबाले ज़ैना बेकार मेरे दुश्मन आन, तैना ताकतबरन,</para>
  <para style="q" vid="PSA 69:4">एल्हेरेलेइ ज़ैन मीं लुटोरू नईं तैन भी मीं देनू पेव।<note caller="-" style="x"><char style="xo" closed="false">69:4 </char><char style="xt" closed="false"><ref loc="JHN 15:25">यूह. 15:25</ref>;<ref loc="PSA 35:19">भज. 35:19</ref>.</char></note><verse eid="PSA 69:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5" />हे परमेशर, तू त मेरी बेवकूफी ज़ानतस,</para>
  <para style="q" vid="PSA 69:5">ते मेरे दोष तीं करां छ़पोरे नईं।<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6" />हे प्रभु, हे सेना केरे यहोवा, ज़ैना तेरे इंतज़ारे मां आन, तैना मेरे ज़िरिये सेइं शरमिन्दे न भोन;</para>
  <para style="q" vid="PSA 69:6">हे इस्राएलेरे परमेशर, ज़ैना तीं तोपतन, तैना मेरे वजाई सेइं बेइज़्ज़त न भोन।<verse eid="PSA 69:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7" />तेरे वजाई सेइं मेरी निन्दा भोवरीए,</para>
  <para style="q" vid="PSA 69:7">मेरू तुत्तर शरमी सेइं ढेक्‍की जेवरूए।<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8" />अवं अपने इस्राएली ढ्लां केरे सामने बखलो भोव,</para>
  <para style="q" vid="PSA 69:8">ते अपने सक्‍के ढ्लां केरे नज़री मां परदेशी भोवरोईं।<verse eid="PSA 69:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9" />किजोकि, अवं तेरे भवनेरे लेई फुकोते-फुकोते भस्म भोइ जेव,</para>
  <para style="q" vid="PSA 69:9">ते ज़ैना तुहीन तैना तेरी केरतन, तैए तुहीन मीं बरदाश केरनी पेतीए।<note caller="-" style="x"><char style="xo" closed="false">69:9 </char><char style="xt" closed="false"><ref loc="JHN 2:17">यूह. 2:17</ref>;<ref loc="ROM 15:3">रोम. 15:3</ref>;<ref loc="HEB 11:26">इब्रा. 11:26</ref>.</char></note><verse eid="PSA 69:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10" />ते ज़ेइस अवं लेरां देतो ते बरत रेखतां दुख झ़ैलतो थियो,</para>
  <para style="q" vid="PSA 69:10">तैखन तैस सेइं भी मेरी बदनामी भोइ।<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11" />ते ज़ैखन अवं मातमेरां लिगड़ां लेइतां थियो,</para>
  <para style="q" vid="PSA 69:11">तैखन मेरी मसाल तैन मां च़लती थी।<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12" />ज़ैना बुज़ुर्ग नगरेरे दारे पुड़ बिशोरेन, तैना मेरे बारे मां गलबात केरतन,</para>
  <para style="q" vid="PSA 69:12">ते शराब पीनेबाले मेरां गीतां बनेइतां ज़ोंते रहतन।<verse eid="PSA 69:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13" />पन हे यहोवा, मेरी प्राथना त तेरी खुशरे वक्ते मां भोइ राहोरीए;</para>
  <para style="q" vid="PSA 69:13">हे परमेशर अपने बड़े दयाई सेइं,</para>
  <para style="q" vid="PSA 69:13">ते बच़ानेरे अपने सच़्च़ो वाधेरे मुताबिक मेरी शुनी।<verse eid="PSA 69:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14" />मीं च़िकरी मरां कढ, कि अवं डुब्बी न गेईं;</para>
  <para style="q" vid="PSA 69:14">अवं अपने दुश्मन्न सेइं, ते डुग्घे पैनी मरां बेच़ी।<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15" />हड़ाई मां डुब्बी न गेईं,</para>
  <para style="q" vid="PSA 69:15">ते अवं डुग्घे पैनी मां डुबतां न मेरि,</para>
  <para style="q" vid="PSA 69:15">ते न पातालेरू आशी मीं पुड़ बन्द भोए।<verse eid="PSA 69:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16" />हे यहोवा, मेरी प्राथना शुन, किजोकि तेरी दया बड़ी रोड़ीए;</para>
  <para style="q" vid="PSA 69:16">एपनी बड़े दयारे मुताबिक मेरे पासे ध्यान दे।<verse eid="PSA 69:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17" />अपने दासे करां अपनु तुत्तर न फिरा;</para>
  <para style="q" vid="PSA 69:17">किजोकि अवं मुसीबती मां आईं, जल्दी मेरी प्राथना शुन।<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18" />मेरे नेड़े एइतां मीं छुटा,</para>
  <para style="q" vid="PSA 69:18">ते मेरे दुश्मन्न करां मीं छुटकारो दे।<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19" />तू मेरी बदनामी ते मेरी शर्मिन्दगी ते मेरी बेइज़्ज़ी ज़ानतस:</para>
  <para style="q" vid="PSA 69:19">मेरे सब दुश्मन तेरे सामनेन।<verse eid="PSA 69:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20" />तैन केरे बदनैमरे वजाई सेइं मेरो दिल फेटी जेव, ते अवं बड़ो उदास आईं।</para>
  <para style="q" vid="PSA 69:20">मीं कोन्ची तरस खाने बालेरी उमीद त की,</para>
  <para style="q" vid="PSA 69:20">पन कोई न मैल्हो,</para>
  <para style="q" vid="PSA 69:20">ते तसल्‍ली देनेबाले त तोपतो राव, पन कोई न मैल्हो।<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21" />लोकेईं मीं खाने जो ज़ेहर दित्तू,</para>
  <para style="q" vid="PSA 69:21">ते मेरी ट्लिश मुकानेरे लेई सिरको पियाव।<note caller="-" style="x"><char style="xo" closed="false">69:21 </char><char style="xt" closed="false"><ref loc="MRK 15:23">मरक. 15:23</ref>,<ref loc="MRK 15:36">36</ref>;<ref loc="LUK 23:36">लूक. 23:36</ref>;<ref loc="JHN 19:28-29">यूह. 19:28-29</ref>.</char></note><verse eid="PSA 69:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22" />तैन केरि रोट्टी तैन केरे लेई फंदो;</para>
  <para style="q" vid="PSA 69:22">ते तैन केरे सुखेरे वक्ते जाल बेनि गाए।<verse eid="PSA 69:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23" />तैन केरि एछ़्छ़ी कैनी भोन, ताके तैना लेही न बटन;</para>
  <para style="q" vid="PSA 69:23">ते तू तैन केरि पिठ हमेशा हिलातो रास।<note caller="-" style="x"><char style="xo" closed="false">69:23 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">रोम. 11:9-10</ref>.</char></note><verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24" />अपनि सरक तैन पुड़ कढ,</para>
  <para style="q" vid="PSA 69:24">ते तेरे क्रोधेरी लप तैन लग्गे।<note caller="-" style="x"><char style="xo" closed="false">69:24 </char><char style="xt" closed="false"><ref loc="REV 16:1">प्रका. 16:1</ref>.</char></note><verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25" />तैन केरे तेम्बु उज़ड़ी गान,</para>
  <para style="q" vid="PSA 69:25">ते तैन केरे घरन मां कोई न राए।<note caller="-" style="x"><char style="xo" closed="false">69:25 </char><char style="xt" closed="false"><ref loc="ACT 1:20">प्रेरित. 1:20</ref>.</char></note><verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26" />किजोकि ज़ैस तीं सज़ाह दित्ती तैस्से तैना सतातन,</para>
  <para style="q" vid="PSA 69:26">ते ज़ैना तीं ज़खमी किये, तैना तैन केरि तकलीफरी चर्चा केरतन।<note caller="-" style="x"><char style="xo" closed="false">69:26 </char><char style="xt" closed="false"><ref loc="ISA 53:4">यशा. 53:4</ref>.</char></note><verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27" />तैन केरे अधर्मे पुड़ अधर्म बधो;</para>
  <para style="q" vid="PSA 69:27">ते तैना तेरे धर्मे हासिल न केरन।<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28" />तैन केरू नवं ज़िन्दगरे किताबी मरां कट्टू गाए,</para>
  <para style="q" vid="PSA 69:28">ते धर्मी लोकन सेइं साथी लिखू न गाए।<note caller="-" style="x"><char style="xo" closed="false">69:28 </char><char style="xt" closed="false"><ref loc="LUK 10:20">लूक. 10:20</ref>;<ref loc="REV 3:5">प्रका. 3:5</ref>;<ref loc="REV 20:12">20:12</ref>,<ref loc="REV 20:15">15</ref>;<ref loc="REV 21:27">21:27</ref>.</char></note><verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29" />पन अवं त दुखी आईं ते तकलीफी मां आईं,</para>
  <para style="q" vid="PSA 69:29">एल्हेरेलेइ हे परमेशर, तू मेरी मुक्ति केरतां मीं उच्‍चे ठैरी पुड़ बिशाल।<verse eid="PSA 69:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30" />अवं, परमेशरेरे नव्वेंरी तारीफ़ केरेलो, ते गीत ज़ोइतां तेरे नंव्वेरी बडीयाई केरेलो,</para>
  <para style="q" vid="PSA 69:30">ते शुक्र केरतां तेरी तारीफ़ केरेलो।<verse eid="PSA 69:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31" />इन यहोवा दांतेरे बलिदाने करां जादे,</para>
  <para style="q" vid="PSA 69:31">बल्के शिंगां ते रौन्ने बाले दांतेरे बलिदाने करां जादे पसंद एज्जेलू।<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32" />हलीम लोक इन हेरतां खुश भोल्हे,</para>
  <para style="q" vid="PSA 69:32">हे परमेशरेरी तलाश केरनेबालव तुश्शे मन हरे भरे भोन।<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33" />किजोकि यहोवारी ज़ैन ज़रूरते तैन केरे पासे मन लाते,</para>
  <para style="q" vid="PSA 69:33">ते अपने लोकन ज़ैना कैदी आन तैन घटिया न समझ़े।<verse eid="PSA 69:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34" />ज़मीन ते अम्बर तैसेरी तारीफ़ केरन,</para>
  <para style="q" vid="PSA 69:34">ते समुन्दर ते ज़ैन किछ तैस मांए तैस समेत तैसेरी तारीफ़ केरन।<verse eid="PSA 69:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35" />किजोकि परमेशर सिय्योने<note caller="+" style="f"><char style="fr" closed="false">69:35 </char><char style="fq" closed="false">सिय्योने </char><char style="ft" closed="false">यरूशलेम नगर</char></note> मुक्ति देलो,</para>
  <para style="q" vid="PSA 69:35">यहूदारे प्रदेशेरे नगरन फिरी बसालो;</para>
  <para style="q" vid="PSA 69:35">ते लोक फिरी तैड़ी बेसतां तैसेरे अधिकारी भोइ गाले।<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36" />परमेशरेरे दासां केरि औलाद तैस अपने हिस्से मां हेरेली,</para>
  <para style="q" vid="PSA 69:36">ते तैसेरे नंव्वे सेइं प्यार केरनेबाले तैस मां बास केरेले।<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">मद्दतरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई याद करानेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1" />हे परमेशर, लूशी एइतां मीं छुटा, हे यहोवा, मेरी मद्दत केरनेरे लेई लूश केर।<note caller="-" style="x"><char style="xo" closed="false">70:1 </char><char style="xt" closed="false"><ref loc="PSA 40:14">भज. 40:14</ref>.</char></note><verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2" />मेरी जानरे ज़ैना दुश्मन आन,</para>
  <para style="q" vid="PSA 70:2">तैना शरमिन्दा ते बेइज़्ज़त भोन!</para>
  <para style="q" vid="PSA 70:2">ज़ैना मेरे नुकसाने सेइं खुश भोतन,</para>
  <para style="q" vid="PSA 70:2">तैना पत्रोवं कढे गान ते बेइज़्ज़त किये गान।<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3" />ज़ैना ज़ोतन, “आहा, आहा!”</para>
  <para style="q" vid="PSA 70:3">तैना दुश्मन अपनि शर्मारेमारे उलटे फेरे गातन।<verse eid="PSA 70:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4" />ज़ेत्रे तीं तोपतन, तैना सब तेरे वजाई सेइं खुश ते मघन भोन!</para>
  <para style="q" vid="PSA 70:4">ते ज़ैना तेरी मुक्ति चातन, तैना लगातार ज़ोते रान, “परमेशरेरी तारीफ़ भोए!”<verse eid="PSA 70:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5" />पन अवं त गरीब ते ज़रूरतमन्द आईं;</para>
  <para style="q" vid="PSA 70:5">हे परमेशर मेरे लेई जल्दी केर!</para>
  <para style="q" vid="PSA 70:5">तू मेरो मद्दत केरनेबालो ते छुटानेबालो आस;</para>
  <para style="q" vid="PSA 70:5">तू यहोवा मेरे मद्दत केरनेरे लेई च़िर न ला।<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">एक्‍की बज़ुर्गेरी प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />हे यहोवा, अवं तेरी शरणी मां रहताईं;</para>
  <para style="q" vid="PSA 71:1">मीं शरमिन्दा न भोने दे।<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />तू त धर्मी आस, मीं छुटा ते मीं मुक्ति दे;</para>
  <para style="q" vid="PSA 71:2">अपनो कन मेरे पासे ला, ते मीं मुक्ति दे।<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />मेरे लेई सनातन कालेरी चट्टानरू धाम बन, ज़ैस मां अवं सदा गेइ सेकी;</para>
  <para style="q" vid="PSA 71:3">तीं मेरे मुक्तरो हुक्म त दित्तोरोए,</para>
  <para style="q" vid="PSA 71:3">किजोकि तू मेरी चट्टान ते मेरो क़िलो ठहरोरोस।<verse eid="PSA 71:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />हे मेरे परमेशर, दुष्टेरे</para>
  <para style="q" vid="PSA 71:4">ते बुरे ते सखत मैन्हेरे हथ्थे करां मेरी हिफाज़त केर।<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />किजोकि हे प्रभु यहोवा, अवं तीं बलगतो एवरोईं;</para>
  <para style="q" vid="PSA 71:5">बचपनेरो मेरो आधार आस।<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />ज़र्मते अवं तीं सम्भालो;</para>
  <para style="q" vid="PSA 71:6">तींए अवं अम्मरे पेटे मरां कढो;</para>
  <para style="q" vid="PSA 71:6">एल्हेरेलेइ अवं हमेशा तेरी बडीयाई केरतो रेइलो।<verse eid="PSA 71:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />बड़े लोकां केरे लेई अवं हैरान रानेरी वजा आईं;</para>
  <para style="q" vid="PSA 71:7">पन तू मेरी छ़पनेरी ठारस।<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />मेरे ऐशी सेइं तेरी तारीफ़</para>
  <para style="q" vid="PSA 71:8">ते सारे दिहैड़ी तेरी शोभारू बियान बड़ू जादे भोए।<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />बुढापे मां तू मीं न शार;</para>
  <para style="q" vid="PSA 71:9">ज़ैखन मेरी ताकत घटे तैखन मीं न शार।<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />किजोकि मेरे दुश्मन मेरे बारे मां गल्‍लां केरतन,</para>
  <para style="q" vid="PSA 71:10">ज़ैना मेरे जानरे ताकी मां आन</para>
  <para style="q" vid="PSA 71:10">तैना एप्पु मांमेइं ई सलाह केरतन कि<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />तैना एक्‍की होरि सेइं ज़ोतन, परमेशरे तै शारोरोए;</para>
  <para style="q" vid="PSA 71:11">तैसेरो पीछो केरतां तैस ट्ला, किजोकि तैसेरो कोई छुटानेबालो नईं।<verse eid="PSA 71:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />हे परमेशर, मीं करां दूर न रा;</para>
  <para style="q" vid="PSA 71:12">हे मेरे परमेशर, मेरी मद्दत केरने मां लूश केर।<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />ज़ैना मेरे जानरे दुश्मन आन, तैना शरमिन्दा भोन,</para>
  <para style="q" vid="PSA 71:13">ते तैन केरो अन्त भोए;</para>
  <para style="q" vid="PSA 71:13">ज़ैना मेरे नुक्सानेरी इच्छा केरतन, तैना बदनामी</para>
  <para style="q" vid="PSA 71:13">ते बेइज़्ज़ती मां पेन।<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />पन अवं हमेशा उमीद लेइतां रेखेलो,</para>
  <para style="q" vid="PSA 71:14">ते जादे करां जादे तेरी तारीफ़ केरतो रेइलो।<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />अवं अपने ऐशी सेइं तेरी धार्मिकतारू,</para>
  <para style="q" vid="PSA 71:15">ते तेरे कियोरी मुक्तरू बियान सारे दिहैड़ी केरतो रेइलो,</para>
  <para style="q" vid="PSA 71:15">किजोकि तैन केरो पूरो ब्योरो मेरी समझ़ी करां दूरे।<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />अवं प्रभु यहोवारे बड्डां कम्मां केरू बियान केरतां एज्जेलो,</para>
  <para style="q" vid="PSA 71:16">अवं सिर्फ तेरे धार्मिकतारी चर्चा केरेलो।<verse eid="PSA 71:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />हे परमेशर, तू मीं बचपनेरो देंतो शिखालतो एवरोस,</para>
  <para style="q" vid="PSA 71:17">ते अज़ तगर अवं तेरे आजीब कम्मां केरू एलान केरताईं।<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />एल्हेरेलेइ हे परमेशर ज़ैखन अवं बुढो भोईं,</para>
  <para style="q" vid="PSA 71:18">ते मेरे दोग्गेरे बाल छ़ित्ते भोन, तैखन भी तू मीं न शार,</para>
  <para style="q" vid="PSA 71:18">ज़ांतगर अवं एजने बाले पीढ़रे लोकन</para>
  <para style="q" vid="PSA 71:18">तेरी बड़ी ताकत ते सब पैदा भोने बालन तेरी कुदरत न शुनेईं।<verse eid="PSA 71:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />हे परमेशर, तेरी धार्मिकता बड़ी महाने,</para>
  <para style="q" vid="PSA 71:19">तीं ज़ैनी महान कम्मां कियां,</para>
  <para style="q" vid="PSA 71:19">हे परमेशर तीं बराबर कौने?<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />तीं त असन बड़े सखत दुख हिरावरेन,</para>
  <para style="q" vid="PSA 71:20">पन मीं तू फिरी दुबारे ज़ींते केरेलो,</para>
  <para style="q" vid="PSA 71:20">तू मीं ज़मीनरे थलेरां वापस आनेलो।<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />तू मेरी इज़्ज़त बधालो,</para>
  <para style="q" vid="PSA 71:21">मीं मुड़तां मीं तसल्‍ली देलो।<verse eid="PSA 71:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />हे मेरे परमेशर,</para>
  <para style="q" vid="PSA 71:22">अवं भी तेरे सच़्च़ेरू शुक्र सारंगी बज़ेइतां गीतां ज़ोइलो;</para>
  <para style="q" vid="PSA 71:22">हे इस्राएलेरे पवित्र परमेशर अवं वीणा बज़ेइतां तेरू भजन ज़ोइलो।<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />ज़ैखन अवं तेरू भजन ज़ोइलो, तैखन अपने ऐशी सेइं</para>
  <para style="q" vid="PSA 71:23">ते अपने प्राणे सेइं भी ज़ै तीं बच़ावरोए जयजयकार केरेलो।<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />ते अवं तेरे धार्मिकतारी चर्चा सारे दिहैड़ी केरतो रेइलो;</para>
  <para style="q" vid="PSA 71:24">किजोकि ज़ैना मेरे नुक्सानेरी इच्छा केरते थिये।</para>
  <para style="q" vid="PSA 71:24">तैना शरमिन्दा ते बेइज़्ज़त भोए।<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">धर्मी राज़ेरे हुकूमतरे दौरान महिमा</para>
  <para style="d">सुलैमानेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1" />हे परमेशर, राज़े अपने नियम ज़ो,</para>
  <para style="q" vid="PSA 72:1">राज़ेरे मट्ठे अपनि धार्मिकता हिरा।<note caller="-" style="x"><char style="xo" closed="false">72:1 </char><char style="xt" closed="false"><ref loc="MAT 25:31-34">मत. 25:31-34</ref>;<ref loc="ACT 17:31">प्रेरित. 17:31</ref>;<ref loc="ROM 14:10">रोम. 14:10</ref>;<ref loc="2CO 5:10">2 कुरि. 5:10</ref>.</char></note><verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />ताके तै धार्मिकता तेरे लोकां केरो न्याय,</para>
  <para style="q" vid="PSA 72:2">ते तेरे हलीम लोकां केरो न्याय सही सेइं केरि सके।<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />पहाड़न ते पहैड़न मरां इन लोकां केरे लेई,</para>
  <para style="q" vid="PSA 72:3">धार्मिकताई सेइं शान्ति मैलती राए।<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />तै इन लोकां केरे गरीबां केरो न्याय केरेलो, ते ज़रूरतमन्द लोकन बच़ालो;</para>
  <para style="q" vid="PSA 72:4">ते ज़ुलम केरनेबालां केरे टुक्ड़े-टुक्ड़े केरेलो।<note caller="-" style="x"><char style="xo" closed="false">72:4 </char><char style="xt" closed="false"><ref loc="ISA 11:4">यशा. 11:4</ref>.</char></note><verse eid="PSA 72:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />ज़ांतगर दिहाड़ो ते चाँदनी राली</para>
  <para style="q" vid="PSA 72:5">तांतगर तेरे लोक पीढ़ी-पीढ़ी तेरो डर मन्ते राले।<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />राज़ो कट्टोरे घासे पुड़ झ़ेड़रो ज़ेरो,</para>
  <para style="q" vid="PSA 72:6">ज़मीनी बट्ल देने बैली झ़ेड़रो ज़ेरो भोल्हो।<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />तैसेरे दिहाड़न मां धर्मी फुलेले फलेले,</para>
  <para style="q" vid="PSA 72:7">ज़ांतगर चाँदनी राए, तांतगर शान्ति बड़ी राली।<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />तै एक्‍की समुन्दरे करां देंतो होरि समुन्दरे तगर,</para>
  <para style="q" vid="PSA 72:8">ते फरात दरियाए करां दुनियारे आखरी तगर हुकूमत केरेलो।<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />तैसेरे सामने जंगले मां रानेबाले झुकेले,</para>
  <para style="q" vid="PSA 72:9">ते तैसेरे दुश्मन तल च़टेले।<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />तर्शीश<note caller="+" style="f"><char style="fr" closed="false">72:10 </char><char style="fq" closed="false">तर्शीश </char><char style="ft" closed="false">समझ़ू गाते मतलब सपेन।</char></note> ते जज़ीरे-जज़ीरेरे राज़े तैस जो भेंट आनेले,</para>
  <para style="q" vid="PSA 72:10">शेबा ते सबा दूईयां रियासतां केरे राज़े तोफे आनेले।<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />सारे राज़े तैस कां झुकेले,</para>
  <para style="q" vid="PSA 72:11">कौमां-कौमां केरे लोक तैसेरे अधीन भोइ गाले।<note caller="-" style="x"><char style="xo" closed="false">72:11 </char><char style="xt" closed="false"><ref loc="REV 21:26">प्रका. 21:26</ref>;<ref loc="MAT 2:11">मत. 2:11</ref>.</char></note><verse eid="PSA 72:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />किजोकि राज़ो फुकारने बाले ज़रूरतमन्देरो,</para>
  <para style="q" vid="PSA 72:12">तै दुखी ते बेसाहरे मैन्हु मुक्ति देलो।<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />तै गरीब ते ज़रूरतमन्दन पुड़ तरस खालो,</para>
  <para style="q" vid="PSA 72:13">ते ज़रूरतमन्दां केरे प्राण बच़ालो।<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />तै तैन केरे प्राणन ज़ुलमे ते फसादे करां छुटालो;</para>
  <para style="q" vid="PSA 72:14">ते तैन केरि ज़िन्दगी तैसेरी नज़री मां कीमती ठहरेली।<verse eid="PSA 72:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />तै त ज़ींतो रालो ते शेबारे सोन्ने मरां तैस दित्तू गालू।</para>
  <para style="q" vid="PSA 72:15">लोक हमेशा तैसेरे लेई प्राथना केरेले;</para>
  <para style="q" vid="PSA 72:15">सैरी दिहैड़ी तैस जो धन ज़ोले।<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />मुल्खे मां पहाड़ां केरि च़ोटन पुड़ बड़ू जादे अन्न भोल्हु;</para>
  <para style="q" vid="PSA 72:16">ज़ेसेरो फल लबानोनेरे गैइड़ां केरो ज़ेरो झुकेलो;</para>
  <para style="q" vid="PSA 72:16">ते नगरेरे लोक घासेरे ज़ेरे हरे भरे भोल्हे।<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />राज़ेरू नवं हमेशा तगर बनोरू रालू;</para>
  <para style="q" vid="PSA 72:17">ज़ांतगर दिहाड़ो बनोरू रालो, तैखन तगर हमेशा तैसेरू नवं नंव्वू भोतू रालू,</para>
  <para style="q" vid="PSA 72:17">ते लोक अपने आपे तैसेरे वजाई सेइं धन मन्नेले,</para>
  <para style="q" vid="PSA 72:17">सैरी कौमां तैस जो धन ज़ोली।<verse eid="PSA 72:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />यहोवा परमेशरेरी तारीफ़ भोए, ज़ै इस्राएलेरो परमेशरे;</para>
  <para style="q" vid="PSA 72:18">सिर्फ तैए चमत्कार केरते।<note caller="-" style="x"><char style="xo" closed="false">72:18 </char><char style="xt" closed="false"><ref loc="PSA 136:4">भज. 136:4</ref>.</char></note><verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />राज़ेरी महिमारे नंव्वेरी हमेशा तारीफ़ भोए;</para>
  <para style="q" vid="PSA 72:19">सारी धरती तैसेरे महिमा सेइं भरपूर भोल्ही।</para>
  <para style="q" vid="PSA 72:19">आमीन फिरी आमीन।<verse eid="PSA 72:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />(यिशैरे मट्ठे दाऊदेरी प्राथना मुक्‍की जेई।)<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">ट्लेइयोवं हिस्सो</para>
  <para style="mr">
    <ref loc="PSA 73-89">भज. 73—89</ref></para>
  <para style="s">परमेशरेरो न्याय</para>
  <para style="d">आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1" />सच़्च़े परमेशर इस्राएले पुड़ महरबाने, ते तैन पुड़ ज़ैन केरो दिल शुद्धे।<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />पन मेरे पव घिश्कने बाले थिये,</para>
  <para style="q" vid="PSA 73:2">मेरे पव डिलक्ने लगोरे थिये।<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />किजोकि ज़ैखन अवं दुष्टां केरू सुख हेरतो थियो,</para>
  <para style="q" vid="PSA 73:3">तैखन तैन घमण्ड केरनेबालां केरे बारे मां जलन केरतो थियो।<verse eid="PSA 73:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />किजोकि मरते बार तैन कोई तकलीफ न भोए,</para>
  <para style="q" vid="PSA 73:4">पन तैन केरि ताकत बनोरी रहतीए।<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />तैन होरि मैन्हु केरि ज़ेरि तकलीफ न भोए;</para>
  <para style="q" vid="PSA 73:5">ते बाकी मैन्हु केरि ज़ेरि तैन पुड़ कोई आफत न एज्जे।<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />एल्हेरेलेइ घमण्ड तैन केरे गलेरो हार बनोरोए;</para>
  <para style="q" vid="PSA 73:6">ते तैन केरू छ़ुंहूं ज़ुलमे।<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />तैन केरि एछ़्छ़न चेर्भी च़ड़ोरीए,</para>
  <para style="q" vid="PSA 73:7">तैन केरे दिलेरे खियाल हद्दी करां बधोरेन।<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />तैना मज़ाक बनातन, ते दुष्टे सेइं ज़ुलमेरी गल ज़ोतन;</para>
  <para style="q" vid="PSA 73:8">तैना बड़े घमण्डे सेइं दंगे केरनेरी धमकी देतन।<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />तैना सुर्गेरे खलाफ<note caller="+" style="f"><char style="fr" closed="false">73:9 </char><char style="fq" closed="false">सुर्गेरे खलाफ </char><char style="ft" closed="false">परमेशरेरे खलाफ</char></note> ज़ोतन,</para>
  <para style="q" vid="PSA 73:9">ते तैना धेरती पुड़ ज़ोते फिरतन।<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />एल्हेरेलेइ परमेशरेरे लोक इरां वापस एज्जेले,</para>
  <para style="q" vid="PSA 73:10">ते तैना एपनी गल्‍लां एन्च़रे पीले ज़ेन्च़रे पानी।<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />फिरी दुष्ट लोक ज़ोतन, “परमेशरे केन्च़रे पतो?”</para>
  <para style="q" vid="PSA 73:11">किजोकि परमप्रधाने कोई ज्ञान नईं।<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />हेरा, इना त दुष्ट लोकन;</para>
  <para style="q" vid="PSA 73:12">फिरी भी हमेशा आरामे सेइं रेइतां, धन-दौलत अकोट्ठी केरतन।<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />सच़्च़े मीं बेफैइदो अपनो दिल शुद्ध कियो,</para>
  <para style="q" vid="PSA 73:13">ते हमेशा अपने हथ गलत कम केरने करां रोकतां रख्खे;<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />किजोकि सैरी दिहैड़ी अवं दुख-तकलीफी मां रहताईं,</para>
  <para style="q" vid="PSA 73:14">रोज़ झ़ेझ़ां मीं सज़ाह दित्ती गाचे।<verse eid="PSA 73:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />अगर मीं ज़ोवरू भोथू, “अवं एरू केरेलो”</para>
  <para style="q" vid="PSA 73:15">त तेरे मट्ठां केरि औलादी सेइं गद्दारी केरेथो।<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />ज़ैखन अवं सोचने लग्गो कि अवं केन्च़रे सेमझ़ी,</para>
  <para style="q" vid="PSA 73:16">त ई मेरे नज़री मां बड़ी जादे मुश्किल थी,<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />ज़ैखन तगर कि मीं परमेशरेरे पवित्र ठारी मां गेइतां</para>
  <para style="q" vid="PSA 73:17">तैन दुष्ट लोकां केरो नितीजो न सोचो।<verse eid="PSA 73:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />सच़्च़े तू तैन घिश्कने बैली ठारी पुड़ रखतस;</para>
  <para style="q" vid="PSA 73:18">ते बिछ़ड़तां नाश केरतस।<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />तैना एक्‍की पले मां केन्च़रे उज़ड़ी जेवरेन!</para>
  <para style="q" vid="PSA 73:19">तैना मिटी जे, तैना घबरेई-घबरेई नाश भोइ जे।<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />ज़ेन्च़रे बींझ़ने बालो सुपने घटिया ज़ानते,</para>
  <para style="q" vid="PSA 73:20">तेन्च़रे हे प्रभु ज़ैखन तू बींझ़ेलो, तैखन तैन छाव सेमझ़तां घटिया ज़ानेलो।<verse eid="PSA 73:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />मेरो मन त परेशान भोइ जेवरो थियो,</para>
  <para style="q" vid="PSA 73:21">ते मेरे दिले मां बड़ी तकलीफ थी।<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />अवं त बेअक्ल ते न समझ़ थियो,</para>
  <para style="q" vid="PSA 73:22">अवं तेरे सामने बेवकूफ जानबरेरो ज़ेरो थियो।<verse eid="PSA 73:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />फिरी भी अवं हमेशा तीं सेइं साथी थियो;</para>
  <para style="q" vid="PSA 73:23">तीं मेरो देइनो हथ ठेमतां रख्खो।<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />तू सलाह देतो, मेरी अगवाई केरेलो,</para>
  <para style="q" vid="PSA 73:24">ते सब मेरी महिमा केरतां मीं एप्पु कां रखेलो।<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />सुर्गे मां मेरो होरो कौने?</para>
  <para style="q" vid="PSA 73:25">तीं साथी रेइतां अवं धेतरी पुड़ ते किछ न चैईं।<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />मेरो दिल ते मन दूईये हारोरेन,</para>
  <para style="q" vid="PSA 73:26">पन परमेशर सदारे लेई मेरो हिस्सो</para>
  <para style="q" vid="PSA 73:26">ते मेरे दिलेरी चट्टान बनोरोए।<verse eid="PSA 73:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />ज़ैना तीं करां दूर रहतन तैना नाश भोल्हे;</para>
  <para style="q" vid="PSA 73:27">ज़ै कोई वेश्यारो ज़ेरो बेवफाए, तैस तू नाश केरतस।<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />पन परमेशरेरे नेड़े रानू, इन्ने मेरे लेई रोड़ूए;</para>
  <para style="q" vid="PSA 73:28">मीं प्रभु परमेशर यहोवा अपनि छ़पनेरी ठार मन्नोरीए,</para>
  <para style="q" vid="PSA 73:28">ज़ैस सेइं अवं तेरां सब कम्मां बियान केरी।<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">ज़ुलम केरनेबालन करां छुटनेरे लेई प्राथना</para>
  <para style="d">आसापेरू मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1" />हे परमेशर, तीं अस हमेशारे लेई किजो शारे?</para>
  <para style="q" vid="PSA 74:1">एपनी चरागारी भैड्डन पुड़ तेरी सरक किजो भड़कती रहचे?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />अपनि मण्डली ज़ै तीं पुराने ज़माने मां घिन्नोरी थी,</para>
  <para style="q" vid="PSA 74:2">ते अपनु विरासतरू गोट्ल भोनेरे लेई छुटेवरू थियूं,</para>
  <para style="q" vid="PSA 74:2">ते इस सिय्योन पहाड़े भी, ज़ैस पुड़ तीं बास कियोरू थियूं, याद केर!<note caller="-" style="x"><char style="xo" closed="false">74:2 </char><char style="xt" closed="false"><ref loc="DEU 32:9">व्यव. 32:9</ref>;<ref loc="JER 10:16">यिर्म. 10:16</ref>;<ref loc="ACT 20:28">प्रेरित. 20:28</ref>.</char></note><verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />अपने पव एना पुराने खंडरां केरे पासे च़ला,</para>
  <para style="q" vid="PSA 74:3">मतलब तैन सब बुरैई केरे पासे ज़ैना दुश्मने पवित्र ठैरी मां कियोरिन।<verse eid="PSA 74:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />तेरे मुखालफ तेरी पवित्र ठारी पुड़ मझ़ाटे गरज़तन;</para>
  <para style="q" vid="PSA 74:4">तैनेईं अपने झण्डां केरो निशान बनेवरोए।<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />तैना तैन मैन्हु केरे ज़ेरे थिये</para>
  <para style="q" vid="PSA 74:5">ज़ैना घने जंगलेरे बुट्टन पुड़ मैक्‍कु च़लातन;<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />ते हुनी तैना तैस भवनेरी नक्‍काशी,</para>
  <para style="q" vid="PSA 74:6">मैक्‍कन ते हथोड़न सेइं बिलकुल ट्लोड़तां छ़डोरीए।<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />तैनेईं तेरी पवित्र ठार बिलकुल भस्म की,</para>
  <para style="q" vid="PSA 74:7">ते तेरे नंव्वेरू भवन भी बिछ़ोड़तां अशुद्ध कियोरूए।<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />तैनेईं अपने मने मां ज़ोवरूए, “एज्जा असां एन मित्ती मां मिलाम।”</para>
  <para style="q" vid="PSA 74:8">तैनेईं मुल्खे मां परमेशरेरी हर आराधना केरनेरी ठार फुक्‍की छ़डोरीए।<verse eid="PSA 74:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />असन हुनी परमेशरेरो कोई बड़ो निशान न लेइहोए;</para>
  <para style="q" vid="PSA 74:9">हुनी कोई नबी न राव,</para>
  <para style="q" vid="PSA 74:9">न इश्शे दरमियान कोई इन ज़ाने कि एरी हालत केइस तगर भोल्ही।<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />हे परमेशर मुखालफ केइस तगर बदनामी केरते राले?</para>
  <para style="q" vid="PSA 74:10">कुन दुश्मन, तेरे नंव्वेरी निन्दा सदा केरतो रालो?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />तू अपनो देइनो हथ किजो रोकतां रखतस?</para>
  <para style="q" vid="PSA 74:11">ते अपनो हथ अग्रोवं केरतां तैन केरो अन्त केर।<verse eid="PSA 74:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />परमेशर त पुराने ज़मानेरो देंतो मेरो राज़ोए,</para>
  <para style="q" vid="PSA 74:12">तैए दुनियाई मां मुक्ति देनेरां कम्मां केरतो एवरो।<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />तीं एपनी शेक्ति सेइं समुन्दरेरे दूई हिस्से किये;</para>
  <para style="q" vid="PSA 74:13">तीं समुन्दरे मां मगरमच्छां केरे दोग भेन्नी दित्ते।<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />तीं त लिव्यातानेरे<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">लिव्यातानेरे </char><char style="ft" closed="false">सुमन्दरेरो अक बड्डो प्राणी</char></note> दोग भेन्तां ते तैन केरे टुक्ड़े-टुक्ड़े केरतां जंगली जानबरन खुवाए।<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />तीं त पैनेरे नाग केढतां गड्डां बगेई,</para>
  <para style="q" vid="PSA 74:15">तीं त बारहे महीने बगनेबाले दरिया शुकाए।<note caller="-" style="x"><char style="xo" closed="false">74:15 </char><char style="xt" closed="false"><ref loc="EXO 17:6">निर्ग. 17:6</ref>;<ref loc="NUM 20:7-11">गिन. 20:7-11</ref>.</char></note><verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />दिहाड़ी भी तेरीए, ते रात भी तेरीए;</para>
  <para style="q" vid="PSA 74:16">दिहाड़ो ते चाँदनी तीं कायम कियोरीए।<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />तींए ज़मीनरी सब हद्दां ठहरेई;</para>
  <para style="q" vid="PSA 74:17">ते तींए गेर्मेरो ते ठंढारो मौसम बनेवरोए।<verse eid="PSA 74:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />हे यहोवा, याद केर कि दुश्मने बदनामी कियोरीए,</para>
  <para style="q" vid="PSA 74:18">ते बेवकूफ लोकेईं तेरे नंव्वेरी निन्दा कियोरीए।<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />अपने कबूतरेरी जान जंगली जानबरेरे हवाले न केर;</para>
  <para style="q" vid="PSA 74:19">अपने गरीब लोकन हमेशारे लेई न बिस्सर।<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />अपने करारेरी खबर ने ज़ै तीं असन सेइं कियोरोए;</para>
  <para style="q" vid="PSA 74:20">किजोकि मुल्खेरे आंधरेरे ठैरी ज़ुलमेरां घरां भेरतन।<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />मुसीबतरे मारे शरमिन्दा भोइतां पत्रोवं हटनू न पे,</para>
  <para style="q" vid="PSA 74:21">गरीब ते ज़रूरतमन्द लोक तेरे नंव्वेरी तारीफ़ केरि सकन।<note caller="-" style="x"><char style="xo" closed="false">74:21 </char><char style="xt" closed="false"><ref loc="PSA 103:6">भज. 103:6</ref>.</char></note><verse eid="PSA 74:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />हे परमेशर, उठ, अपनो मुकदमो एप्पु लड़;</para>
  <para style="q" vid="PSA 74:22">तेरी ज़ै बदनामी बेवकूफेरे ज़िरिये सारे दिहैड़ी भोती रहतीए, तैस याद केर।<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />अपने दुश्मना केरि आवाज़ न बिस्सर,</para>
  <para style="q" vid="PSA 74:23">तेरे मुखालफां केरो हंगामो लगातार भोतो रहते।<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">न्यायेरे लेई परमेशरेरू शुक्र</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई: अलतशहेत रागे मां आसापेरू भजन।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1" />हे परमेशर अस तेरू शुक्र केरतम, अस तेरे नंव्वेरू शुक्र केरतम,</para>
  <para style="q" vid="PSA 75:1">किजोकि तेरू नवं बांदू भोवरूए, तेरे हैरान केरनेबालां कम्मां केरू बियान भोइ राहोरूए।<verse eid="PSA 75:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2" />ज़ैखन ठीक वक्त एज्जेलो,</para>
  <para style="q" vid="PSA 75:2">तैखन अवं एप्पु ठीक-ठीक न्याय केरेलो।<verse eid="PSA 75:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3" />ज़ैखन ज़मीन अपने सब रानेबालन समेत हिल्‍ली,</para>
  <para style="q" vid="PSA 75:3">तैखन अव्वें तैसेरे खम्भे कायम केरताईं। <char style="qs">(सेला) </char><verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4" />मीं घमण्डी लोकन सेइं ज़ोवं, “घमण्ड न केरा,”</para>
  <para style="q" vid="PSA 75:4">ते दुष्टन सेइं, “शिंग<note caller="+" style="f"><char style="fr" closed="false">75:4 </char><char style="fq" closed="false">शिंग </char><char style="ft" closed="false">शक्ति</char></note> उच्‍चु न केरा;<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5" />अपनु शिंग बड़ू उच्‍चु न केरा,</para>
  <para style="q" vid="PSA 75:5">न क्रोड़ी खड़ी केरतां घमण्डेरी गल केरा।”<verse eid="PSA 75:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6" />किजोकि बड़ोतरी न च़ढ़ते पासेरां, ते न डुबते पासेरां,</para>
  <para style="q" vid="PSA 75:6">ते न सुनसान ठारारां एज्जे।<verse eid="PSA 75:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7" />पन परमेशर न्याय केरनेबालोए,</para>
  <para style="q" vid="PSA 75:7">तैए एक्‍की घटाते, ते होरि बद्धाते।<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8" />किजोकि यहोवारे हथ्थे मां अक कटोरोए,</para>
  <para style="q" vid="PSA 75:8">ज़ैस मां दाछ़रो रस शैम्फी बालोए;</para>
  <para style="q" vid="PSA 75:8">सच़्च़े दुनियारे सारे दुष्ट लोक आखरी तेप्पु तगर पीले।<note caller="-" style="x"><char style="xo" closed="false">75:8 </char><char style="xt" closed="false"><ref loc="JER 25:15">यिर्म. 25:15</ref>;<ref loc="REV 14:10">प्रका. 14:10</ref>;<ref loc="REV 16:19">16:19</ref>.</char></note><verse eid="PSA 75:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9" />पन अवं त हमेशा प्रचार केरतो रेइलो,</para>
  <para style="q" vid="PSA 75:9">ते याकूबेरे परमेशरेरू भजन ज़ोइलो।<verse eid="PSA 75:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10" />दुष्टां केरां अवं शिंगां केट्टी छ़डेलो,</para>
  <para style="q" vid="PSA 75:10">पन धर्मी मैन्हु केरां शिंगां उच्‍चां कियां गालां।<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">ज़ींतने बालो परमेशर</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई: तारीबाले बाज़न सेइं साथी, आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1" />परमेशर यहूदा मां पशानो जेवरोए,</para>
  <para style="q" vid="PSA 76:1">तैसेरू नवं इस्राएले मां महाने।<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2" />तैसेरो तेम्बु शालेमे<note caller="+" style="f"><char style="fr" closed="false">76:2 </char><char style="fq" closed="false">शालेमे </char><char style="ft" closed="false">यरूशलेम</char></note> मां,</para>
  <para style="q" vid="PSA 76:2">ते तैसेरू धाम सिय्योने मांए।<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3" />तैड़ी तैनी तीरन,</para>
  <para style="q" vid="PSA 76:3">ढाल, तलवारी ते जंगरे बाकी हथियार चकनाचूर किये। <char style="qs">(सेला) </char><verse eid="PSA 76:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4" />हे परमेशर, तू महिमा सेइं भरपूरस:</para>
  <para style="q" vid="PSA 76:4">ते तैन पहाड़न करां भी जादे महान आस, ज़ैना शिकार भोनेबाले जानबरन सेइं भेरतांए।<verse eid="PSA 76:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5" />बहादर मड़द त लुट्टोई जेवरेन, तैना बड़े निड्ली मां झ़ुल्‍ली जेवरेन;</para>
  <para style="q" vid="PSA 76:5">बहादर सिपेहिन मरां केन्चेरो भी हथ कम न केरे।<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6" />हे याकूबेरे परमेशर, तेरी झ़िड़की सेइं,</para>
  <para style="q" vid="PSA 76:6">ते रथ्थन समेत घोड़े भारी निड्ली मां झ़ुलोरेन।<verse eid="PSA 76:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7" />सिर्फ तींए करां डरेरू लोड़ते;</para>
  <para style="q" vid="PSA 76:7">ते ज़ैखन तू सेरकोस, तैखन तेरे सामने कौन खड़ो रेइ सकते?<verse eid="PSA 76:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8" />तींए सुर्गे मरां फैसलो शुनेवरोए;</para>
  <para style="q" vid="PSA 76:8">ते तैस वक्ते ज़मीन डेरतां च़ुप भोइ जेवरीए,<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9" />ज़ैखन परमेशर न्याय केरनेरे लेई</para>
  <para style="q" vid="PSA 76:9">ते धेरतरे सब हलीम लोकां केरि मुक्ति केरने जो खड़ो भोव। <char style="qs">(सेला) </char><verse eid="PSA 76:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10" />सच़्च़े मैन्हेरी जलजलाहट तेरी तारीफ़री वजा भोल्ही,</para>
  <para style="q" vid="PSA 76:10">ते ज़ै जलजलाहट बाकी राए, तैस तू रोकेलो।<verse eid="PSA 76:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11" />अपने परमेशर यहोवारे हज़ूरी मां मिन्नतां मन्ना, ते तैना पूरी केरा;</para>
  <para style="q" vid="PSA 76:11">तै ज़ै डरेरे काबले, तैसेरे आसे पासे लोक तैसेरे लेई च़ढ़तल आन्न।<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12" />परमेशर प्रधानां केरू अभिमान मिटेई देलो;</para>
  <para style="q" vid="PSA 76:12">ते दुनियारे राज़े तैसेरो डर मनतन।<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">मुसीबतरे वक्ते भरोसो</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई: यदूतूनेरे रागे पुड़, आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1" />अवं परमेशरे कां बिनती ज़ोरे-ज़ोरे सेइं केरेलो,</para>
  <para style="q" vid="PSA 77:1">अवं परमेशरे कां फरियाद केरेलो, ते तै मेरे पासे ध्यान देलो।<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2" />एपनी मुसीबती मां मीं अपने प्रभु कां प्राथना की,</para>
  <para style="q" vid="PSA 77:2">रातरे मौके मेरे हथ खड़े राए, ते ढिल्‍ले न भोए,</para>
  <para style="q" vid="PSA 77:2">मीं तसल्‍ली न भोइ।<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3" />अवं परमेशरे याद केरतां कर लाताईं;</para>
  <para style="q" vid="PSA 77:3">अवं फिक्र केरते-केरते बेचैन भोइ जेवरोईं; <char style="qs">(सेला) </char><verse eid="PSA 77:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4" />तू मेरी एछ़्छ़ी बन्द भोने न देस;</para>
  <para style="q" vid="PSA 77:4">अवं एरहो घबराताईं कि अवं गल भी न केरीं सेखी।<verse eid="PSA 77:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5" />अवं पुराने ज़माने पुड़ खियाल केरताईं,</para>
  <para style="q" vid="PSA 77:5">ते तैन सालन पुड़ ज़ैन गुज़रोरे बड़ू च़िर भोवरूए।<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6" />अवं राती अपना गीतां याद केरताईं;</para>
  <para style="q" vid="PSA 77:6">ते अपने मने मां ध्यान केरताईं,</para>
  <para style="q" vid="PSA 77:6">कि मेरी आत्मा तलाश केरती रहचे।<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7" />“कुन प्रभु हमेशारे लेई शारेलो;</para>
  <para style="q" vid="PSA 77:7">कुन तै असन अज़्ज़ेरे बाद कधी भी पसंद न केरेलो?<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8" />कुन तैसेरी करुणा हमेशारे लेई खतम भोवरीए?</para>
  <para style="q" vid="PSA 77:8">कुन तैसेरे वाधे अज़्ज़ेरे बाद बेफल भोइ गाले?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9" />कुन परमेशरे अनुग्रह केरनो बिसरो?</para>
  <para style="q" vid="PSA 77:9">कुन तैनी क्रोध केरतां अपनि सब दया रोकतां रख्खोरीए?” <char style="qs">(सेला) </char><verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10" />अवं ज़ोने लगो, “ई मेरो दुखे, कि प्रभु परमप्रधानेरो देइनो हथ बेदलोई जेवरोए।”<verse eid="PSA 77:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11" />अवं यहोवारे बड्डां कम्मां केरि चर्चा केरेलो;</para>
  <para style="q" vid="PSA 77:11">ते अवं तेरे चमत्कार याद केरेलो ज़ैना तीं बीतोरे वक्ते मां किये।<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12" />अवं तेरे सब कम्मन पुड़ ध्यान केरेलो,</para>
  <para style="q" vid="PSA 77:12">ते तेरे बड़े कम्मन सोचेलो।<verse eid="PSA 77:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13" />हे परमेशर, तेरी बत पवित्रतारीए।</para>
  <para style="q" vid="PSA 77:13">कौन ज़ेरो देबतो परमेशरेरे बराबर बड्डोए?<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14" />तूए चमत्कार केरनेबालो परमेशरस,</para>
  <para style="q" vid="PSA 77:14">तींए कौमां केरे दरमियाने मां अपनि शक्ति बांदी कियोरीए।<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15" />बेड़ी ताकती सेइं तीं अपने लोक,</para>
  <para style="q" vid="PSA 77:15">याकूब ते यूसुफेरू खानदान छुटेवरूए। <char style="qs">(सेला) </char><verse eid="PSA 77:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16" />हे परमेशर, समुन्दरे तू लाव,</para>
  <para style="q" vid="PSA 77:16">समुन्दर तीं लेइतां डेरि जेव,</para>
  <para style="q" vid="PSA 77:16">डुग्घो समुन्दर भी हिलने लगो।<verse eid="PSA 77:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17" />बिदलारी सेइं बड़ी झ़ड़ी भोइ;</para>
  <para style="q" vid="PSA 77:17">अम्बर गुड़ने लगू,</para>
  <para style="q" vid="PSA 77:17">ते तेरे तीर इरां-उरां च़लने लगे।<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18" />आँधी तूफाने मां तेरी आवाज़ कड़कने लगी,</para>
  <para style="q" vid="PSA 77:18">ते दुनिया बिजली सेइं रौशन भोइ;</para>
  <para style="q" vid="PSA 77:18">ज़मीन हिलती-हिलती उछ़ड़ी जेई।<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19" />तेरी बत समुन्दरे मांए,</para>
  <para style="q" vid="PSA 77:19">ते तेरी बत डुग्घे पैनी मांए;</para>
  <para style="q" vid="PSA 77:19">ते तेरे पव्वां केरे निशाना केरो कोई पतो न लग्गे।<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20" />तीं मूसेरे ते हारूनेरे ज़िरिये,</para>
  <para style="q" vid="PSA 77:20">अपने लोकां केरि अगवाई गब्बां केरे ज़ेरि की।<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">परमेशर ते तैसेरे लोक</para>
  <para style="d">आसापेरो मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1" />हे मेरे लोकव, मेरी शिक्षा शुना;</para>
  <para style="q" vid="PSA 78:1">मेरे गल्‍लां केरे पासे ध्यान देथ!<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />अवं अपनि ज़बान कहावतां ज़ोनेरे लेई खोलेलो;</para>
  <para style="q" vid="PSA 78:2">अवं पुराने ज़मानेरी छ़ेपोरी गल्‍लां बियान केरेलो।<note caller="-" style="x"><char style="xo" closed="false">78:2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">मत. 13:35</ref>.</char></note><verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />ज़ैना गल्‍लां असेईं शुनी, ते असन पतो लग्गो,</para>
  <para style="q" vid="PSA 78:3">ते इश्शे दादे पड़दादेईं असन सेइं ज़ोवं।<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />तैन अस अपने खानदाने करां छ़ुपेइतां न रखमेले,</para>
  <para style="q" vid="PSA 78:4">पन एजने बैली पीढ़रे लोकन करां,</para>
  <para style="q" vid="PSA 78:4">यहोवारी तारीफ़ ते तैसेरी शक्ति</para>
  <para style="q" vid="PSA 78:4">ते चमत्कारां केरे बारे मां ज़ोमेले।<note caller="-" style="x"><char style="xo" closed="false">78:4 </char><char style="xt" closed="false"><ref loc="DEU 4:9">व्यव. 4:9</ref>;<ref loc="JOS 4:6-7">यहो. 4:6-7</ref>;<ref loc="EPH 6:4">इफि. 6:4</ref>.</char></note><verse eid="PSA 78:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />किजोकि तैनी याकूबे मां अक गवाही ठहराई,</para>
  <para style="q" vid="PSA 78:5">इस्राएले मां कानून च़लाव,</para>
  <para style="q" vid="PSA 78:5">ज़ेसेरे बारे मां तैने इश्शे पूर्वजन हुक्म दित्तो,</para>
  <para style="q" vid="PSA 78:5">कि तुस एन अपने-अपने बाल बच्‍चन शिखैलथ;<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />ताके एजने बाले पीढ़रे लोक, मतलब ज़ैना बच्‍चे पैदा भोने बालेन, तैना इन ज़ानन;</para>
  <para style="q" vid="PSA 78:6">ते अपने-अपने बाल-बच्‍चन सेइं इन केरे बारे ज़ोने मां तियार भोन।<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />ज़ैस सेइं तैना परमेशरे पुड़ भरोसो रखन, परमेशरेरे बड़े कम्मन न बिसरन,</para>
  <para style="q" vid="PSA 78:7">पन तैसेरो हुक्म मन्ते रान;<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />ते अपने बुज़ुर्गां केरे ज़ेरे न भोन,</para>
  <para style="q" vid="PSA 78:8">तैस पीढ़रे लोक त ज़िद्दी ते झगड़ो केरनेबाले थिये,</para>
  <para style="q" vid="PSA 78:8">ते तैनेईं अपनो मन कायम न थियो कियोरो,</para>
  <para style="q" vid="PSA 78:8">ते न तैन केरि आत्मा परमेशरेरे लेई सच़्च़ी राई।<note caller="-" style="x"><char style="xo" closed="false">78:8 </char><char style="xt" closed="false"><ref loc="2KI 17:14-15">2 राज़. 17:14-15</ref>.</char></note><verse eid="PSA 78:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />एप्रैमी लोकेईं त शास्त्रधारी ते धनुषधारी भोने पुड़ भी,</para>
  <para style="q" vid="PSA 78:9">जंगरे मौके पिठ हरेवरी थी।<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />तैनेईं परमेशरेरो करार पूरो न कियो,</para>
  <para style="q" vid="PSA 78:10">ते तैसेरे कानूने पुड़ च़लने करां इन्कार कियो।<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />तैनेईं तैसेरे बड़े कम्मन ते ज़ैना चमत्कार तैने तैन केरे सामने कियोरे थिये,</para>
  <para style="q" vid="PSA 78:11">तैना बिसरे।<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />तैने त तैन केरे दादे पड़दादां केरे सामने मिस्र मुल्खेरे सोअनेरे<note caller="+" style="f"><char style="fr" closed="false">78:12 </char><char style="fq" closed="false">सोअनेरे </char><char style="ft" closed="false">इस नगरे जो रामसेस भी ज़ोतन। (निर्ग. 1:11)</char></note> मैइदाने मां महान कम्मां कियोरां थियां।<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />तैने समुन्दर दूई हिस्से केरतां तैना तैस पार कढे,</para>
  <para style="q" vid="PSA 78:13">ते पानी ढेरेरू ज़ेरू खड़ू कियूं।<note caller="-" style="x"><char style="xo" closed="false">78:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">निर्ग. 14:21-29</ref>.</char></note><verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />दिहैड़ी तैनी बिदलारारे ज़िरिये</para>
  <para style="q" vid="PSA 78:14">ते सैरी राती बेलति अग्गरी लौअरे ज़िरिये तैन केरि अगवाई की।<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />रेगिस्ताने मां तैनी चट्टानां ट्लेइतां,</para>
  <para style="q" vid="PSA 78:15">धेरतरू डुग्घू पानी पियावं।<note caller="-" style="x"><char style="xo" closed="false">78:15 </char><char style="xt" closed="false"><ref loc="EXO 17:6">निर्ग. 17:6</ref>;<ref loc="NUM 20:11">गिन. 20:11</ref>;<ref loc="1CO 10:4">1 कुरि. 10:4</ref>.</char></note><verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />तैनी चट्टानी मरां गड्डां केढी,</para>
  <para style="q" vid="PSA 78:16">ते पानी दरियां केरू ज़ेरू बगाऊं।<verse eid="PSA 78:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />फिरी भी तैना इब्रानी लोक तैसेरे खलाफ जादे पाप केरते जे,</para>
  <para style="q" vid="PSA 78:17">बल्के रेगिस्ताने मां परमप्रधान परमेशरेरे खलाफ खड़े भोते जे।<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />ते अपने मेर्ज़रे मुताबिक रोट्टी मेगतां मने-मने मां परमेशरेरो इंतज़ार कियो।<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />तैनेईं परमेशरेरे खलाफ ज़ोवं,</para>
  <para style="q" vid="PSA 78:19">ते ज़ोने लगे, “कुन परमेशर जंगले मां मेज़ लेई सकते?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />तैने चट्टानी पुड़ बैइतां पानी त रुड़ाव,</para>
  <para style="q" vid="PSA 78:20">ते गड्डां उछ़ड़ने लेग्गी,</para>
  <para style="q" vid="PSA 78:20">पन कुन तै रोट्टी भी देइ सकते?</para>
  <para style="q" vid="PSA 78:20">कुन तै अपने लोकां केरे लेई मास भी तियार केरि सकते?”<verse eid="PSA 78:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />एन शुन्तां यहोवा सरक अई,</para>
  <para style="q" vid="PSA 78:21">तैखन याकूबेरे खलाफ अग लेग्गी जेई,</para>
  <para style="q" vid="PSA 78:21">ते तैसेरो क्रोध इस्राएले पुड़ भड़को;<note caller="+" style="f"><char style="fr" closed="false">78:21 </char><char style="ft" closed="false">याकूब ते इस्राएलेरो अक मतलबे, एन्च़रे इब्रानी लोकां केरे ज़ोनेरो तरीकोए।</char></note><verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />एल्हेरेलेइ कि तैनेईं परमेशरे पुड़ विश्वास न थियो,</para>
  <para style="q" vid="PSA 78:22">तैना तैसेरी मुक्ति केरनी शेक्ति पुड़ भरोसो कियो।<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />फिरी भी तैने अम्बरे हुक्म दित्तो,</para>
  <para style="q" vid="PSA 78:23">ते सुर्गेरे दारां खोल्‍लां;<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />तैन केरे खानेरे लेई अम्बरेरां मन्नो बखाव,</para>
  <para style="q" vid="PSA 78:24">तैन सुर्गेरां अन्न दित्तू।<note caller="-" style="x"><char style="xo" closed="false">78:24 </char><char style="xt" closed="false"><ref loc="EXO 16:4">निर्ग. 16:4</ref>;<ref loc="JHN 6:31">यूह. 6:31</ref>.</char></note><verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />मैन्हन स्वर्गदूतां केरि रोट्टी मैल्ही,</para>
  <para style="q" vid="PSA 78:25">तैनी तैन मन पसंद रोट्टी दित्ती।<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />तैनी अम्बरे मां पूर्वेरां हवा च़लाई,</para>
  <para style="q" vid="PSA 78:26">ते एपनी शेक्ति सेइं दक्षिणी हवा च़लाई।<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />तैनी मित्तरू ज़ेरू खुल्‍लू मास तैन जो बखावं,</para>
  <para style="q" vid="PSA 78:27">समुन्दरेरी रेतरां ज़ेरां बेशुमार च़ुड़ोलू भेज़ां;<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />तैन्ना केरे डेरन मां तैना एजने लगां,</para>
  <para style="q" vid="PSA 78:28">तैन केरे घरां केरे आसे-पासे ज़मीनी मां तैना बिछ़ड़ने लगां।<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />तैखन तैना खेइतां रेज़्ज़ी जे,</para>
  <para style="q" vid="PSA 78:29">ते तैने तैन केरि इच्छा पूरी की।<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />पन तैन केरि इच्छा बनोरी राई,</para>
  <para style="q" vid="PSA 78:30">ते ड्लाछ़ोड़ो हेजू तैन केरे ऐशी मां थियूं,<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />कि परमेशरेरो क्रोध तैन पुड़ भेड़की जेव,</para>
  <para style="q" vid="PSA 78:31">तैनी तैन केरे हट्टे कट्टे लोक नाश किये,</para>
  <para style="q" vid="PSA 78:31">इस्राएलेरे जुवान बिछ़ोड़े।<note caller="-" style="x"><char style="xo" closed="false">78:31 </char><char style="xt" closed="false"><ref loc="1CO 10:5">1 कुरि. 10:5</ref>.</char></note><verse eid="PSA 78:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />एना सैरी गल्‍लां केरे बावजूद भी तैना अपने पापन मां बद्धते जे;</para>
  <para style="q" vid="PSA 78:32">ते तैसेरे बड्डे-बड्डे कम्मन पुड़ विश्वास न कियो।<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />एल्हेरेलेइ तैनी तैन केरे दिहाड़े निकम्मे गुज़रने दित्ते,</para>
  <para style="q" vid="PSA 78:33">ते तैन केरे साल घबराहटी मां कट्टाए।<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />ज़ैखन तै तैन मारने लग्गे, तैखन तैना तैस पुछ़ते थिये;</para>
  <para style="q" vid="PSA 78:34">ते मुड़तां परमेशरे दिले सेइं तलाश केरने लगे।<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />तैखन तैन याद एइतू थियूं कि परमेशर इश्शी चट्टाने,</para>
  <para style="q" vid="PSA 78:35">ते परमप्रधान परमेशर इश्शो छुटानेबालोए।<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />फिरी भी तैनेईं तैसेरी चापलूसी की;</para>
  <para style="q" vid="PSA 78:36">तैनेईं तैस सेइं झूठ ज़ोवं।<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />किजोकि न तैन केरो दिल तैन केरे पासे मज़बूत थियो;</para>
  <para style="q" vid="PSA 78:37">ते न तैना तैसेरे करारेरे बारे मां सच़्च़े थिये।<note caller="-" style="x"><char style="xo" closed="false">78:37 </char><char style="xt" closed="false"><ref loc="ACT 8:21">प्रेरित. 8:21</ref>.</char></note><verse eid="PSA 78:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />पन परमेशर ज़ै दया केरनेबालोए, तै अधर्मे माफ़ केरते, ते नाश न केरे;</para>
  <para style="q" vid="PSA 78:38">तै बार-बार अपने सरकी ठंडी केरते,</para>
  <para style="q" vid="PSA 78:38">ते अपनि जलजलाहट पूरे तरीके सेइं भड़कने न दे।<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />किजोकि तैस याद थियूं कि तैना नाश भोनेबाले इन्सानन,</para>
  <para style="q" vid="PSA 78:39">इना हवारे ज़ेरे आन ज़ै च़ली गातीए ते वापस न एज्जे।<verse eid="PSA 78:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />बियाबाने मां तैना केत्रे फेरेईं तैसेरे खलाफ भोए</para>
  <para style="q" vid="PSA 78:40">ते बगैर पैनेरे मुल्खे मां तै उदास कियो!<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />बार-बार तैना परमेशरे अज़माते थिये,</para>
  <para style="q" vid="PSA 78:41">ते इस्राएलेरे पवित्र परमेशरे परेशान केरते थिये।<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />तैनेईं न त तैसेरी ताकत याद की,</para>
  <para style="q" vid="PSA 78:42">न तै दिहाड़ी ज़ैखन तैनी तैना दुश्मना केरे कब्ज़े करां छुटाए;<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />कि तैनी केन्च़रे अपने निशान मिस्रे मां</para>
  <para style="q" vid="PSA 78:43">ते अपने चमत्कार सोअनेरे मैइदाने मां कियोरे थिये।<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />तैनी मिस्री केरे दरिया खून बनाए,</para>
  <para style="q" vid="PSA 78:44">ते तैना अपने दरियां केरू पानी पी न बटे।<note caller="-" style="x"><char style="xo" closed="false">78:44 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">निर्ग. 7:17-21</ref>;<ref loc="PSA 105:29">भज. 105:29</ref>.</char></note><verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />तैनी तैन मां डांघाल भेज़े, ज़ैना तैन खाने लगे,</para>
  <para style="q" vid="PSA 78:45">ते मैंडू तैन मां भेज़ां, ज़ैनेईं तैना तबाह किये।<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />तैनी तैन केरे ज़मीनरी पैदावार कीड़न,</para>
  <para style="q" vid="PSA 78:46">ते तैन केरे ज़मीनदैरारो फल टिट्टन दित्तोरो थियो।<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />तैन केरे दाछ़रे बूटे तैनी आणी सेइं,</para>
  <para style="q" vid="PSA 78:47">ते तैन केरे गूलरेरे बुट आणी बखेइतां तबाह किये।<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />तैनी तैन केरे जानबर आणी सेइं,</para>
  <para style="q" vid="PSA 78:48">तैन केरां गोरू गब्बां च़ड़कन सेइं नाश कियां।<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />तैनेईं तैन पुड़ अपनो बड़ो जादे क्रोध ते सरक भड़काई,</para>
  <para style="q" vid="PSA 78:49">ते तैना मुसीबती मां छ़डे,</para>
  <para style="q" vid="PSA 78:49">ते दुख देनेबाले बड़े दूत भेज़े।<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />तैनी एपनी सरकरे लेई बत बनाई,</para>
  <para style="q" vid="PSA 78:50">ते तैन केरे प्राण मौती करां न बच़ाए,</para>
  <para style="q" vid="PSA 78:50">पन तैना आफतरे हवाले किये।<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />मिस्रे मां तैनी सारे बड्डे बच्‍चे मारे,</para>
  <para style="q" vid="PSA 78:51">ज़ैना हामेरे<note caller="+" style="f"><char style="fr" closed="false">78:51 </char><char style="fq" closed="false">हामेरे </char><char style="ft" closed="false">हाम नूहेरू मट्ठू थियूं उत्प. 10:6</char></note> डेरन मां ताकतरे पेइले फल थिये;<verse eid="PSA 78:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />पन तैनी अपने लोक गब्बां केरे ज़ेरे च़लाए</para>
  <para style="q" vid="PSA 78:52">ते जंगले मां तैन केरि अगवाई जानबरां केरे झुण्डेरी ज़ेरि की।<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />तैखन तैना तैसेरे च़लाने सेइं बेधड़क च़ले ते तैन किछ डर न भोव,</para>
  <para style="q" vid="PSA 78:53">पन तैन केरे दुश्मन समुन्दरे मां डुबी जे।<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />ते तैने तैना अपने पवित्र मुल्खेरी सरहद्दी तगर,</para>
  <para style="q" vid="PSA 78:54">इस्से पहाड़ी मुल्खे<note caller="+" style="f"><char style="fr" closed="false">78:54 </char><char style="fq" closed="false">पहाड़ी मुल्खे </char><char style="ft" closed="false">सिय्योन पहाड़</char></note> मां पुज़ाए, ज़ै तैने अपने देइने हथ्थे सेइं हासिल कियोरो थियो।<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />तैने तैन केरे सामने गैर कौमां निशैनी;</para>
  <para style="q" vid="PSA 78:55">ते तैन केरि ज़मीनरी डोरी नैपतां बेंटी दित्ती;</para>
  <para style="q" vid="PSA 78:55">ते इस्राएलेरे गोट्ल तैन केरे डेरन मां बसाए।<verse eid="PSA 78:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />फिरी भी तैनेईं परमप्रधान परमेशरेरी अज़मैइश की ते तैस सेइं बगावत की,</para>
  <para style="q" vid="PSA 78:56">ते तैसेरो कानून न मन्नो,<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />ते मुड़तां अपने बुज़ुर्गां केरे ज़ेरे धोखेबाज़ भोए;</para>
  <para style="q" vid="PSA 78:57">तैनेईं निकम्मे धनुषेरे सामने धोखो दित्तो।<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />किजोकि तैनेईं उच्‍ची ठारां बनेइतां तैस सरक दुवाई,</para>
  <para style="q" vid="PSA 78:58">ते घेड़ोरि मूरती केरे ज़िरिये तैस मां जलन पैदा कराई।<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />परमेशर शुन्तां क्रोधे सेइं भेरि जेव,</para>
  <para style="q" vid="PSA 78:59">ते तैने इस्राएल बिलकुल शैरी दित्तो।<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />तैनी शीलोरे नगरेरे घरे,</para>
  <para style="q" vid="PSA 78:60">मतलब तैस तेम्बु ज़ै तैने मैन्हु केरे दरमियान खड़ो कियोरो थियो, शैरी दित्तो,<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />ते तैनी अपनि ताकत गुलैमी मां गाने दित्ती,</para>
  <para style="q" vid="PSA 78:61">ते अपनि शोभा दुश्मना केरे कब्ज़े की।<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />अपनि कौम तैनी तलवारारी सेइं मारी,</para>
  <para style="q" vid="PSA 78:62">ते अपने खास हिस्सेरे खलाफ सरकी सेइं भेरि जेव।<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />तैन केरे जुवान अग्गी सेइं भस्म भोइ जे,</para>
  <para style="q" vid="PSA 78:63">ते तैन केरि अड्लैही कुइयां केरे ड्लाहेरां गीतां भी न ज़ोआं।<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />तैन केरे याजक तलवारी सेइं मारे जे,</para>
  <para style="q" vid="PSA 78:64">ते तैन केरि विधवा कौन्शन शोग मनाने न दित्तो।<verse eid="PSA 78:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />तैखन प्रभु ज़ेन्च़रे निड्लारां बींझ़ो,</para>
  <para style="q" vid="PSA 78:65">ते एरे बहादरेरो ज़ेरो उठ्ठो ज़ै दाछ़रो रस पीतां ललकारतो भोए।<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />तैने अपने दुश्मन मैरतां पत्रोवं हटाए;</para>
  <para style="q" vid="PSA 78:66">ते तैन केरि सदा बदनामी कराई।<verse eid="PSA 78:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />तैस मौके तैनी यूसुफेरो तेम्बु शारो;</para>
  <para style="q" vid="PSA 78:67">ते एप्रैमेरे गोट्ले मरां कोई न च़ुनो;<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />पन यहूदारे गोट्ले,</para>
  <para style="q" vid="PSA 78:68">ते अपनु ट्लारू सिय्योन पहाड़ च़ुनू।<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />तैनी अपनि पवित्र ठार बड़ी उच्‍ची बनाई,</para>
  <para style="q" vid="PSA 78:69">ते धेरतरी ज़ेरि मज़बूत बनाई, ज़ेसेरी बुनीयाद तैने हमेशारे लेई छ़डी।<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />फिरी तैनी अपनो दास दाऊद च़ुनतां छ़ेल्‍ली भैड्डां केरे बाड़े मरां कुजव;<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />तै तैस बच्‍चन बैली भैड्डन पत्ती-पत्ती फिरने करां आनो</para>
  <para style="q" vid="PSA 78:71">कि तै तैसेरे लोक याकूबेरी मतलब तैसेरे खास हिस्से इस्राएलेरी रखवाली केरे।<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />तैखन तैने सच़्च़े मने सेइं तैन केरि रखवाली की,</para>
  <para style="q" vid="PSA 78:72">ते अपने माहिर हथ्थन सेइं तैन केरि अगवाई की।<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">इस्राएलेरे छुटकारेरे लेई प्राथना</para>
  <para style="d">आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1" />हे परमेशर, गैर कौमां<note caller="+" style="f"><char style="fr" closed="false">79:1 </char><char style="fq" closed="false">गैर कौमां </char><char style="ft" closed="false">गैर यहूदी लोक ज़ैना परमेशरे न ज़ानन।</char></note> तेरी विरासती मां एवरिन;</para>
  <para style="q" vid="PSA 79:1">ते तैनेईं तेरू पवित्र मन्दर भी भिट्टू कियूं;</para>
  <para style="q" vid="PSA 79:1">ते यरूशलेम भी मलबेरो ढेर बनेवरोए।<verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />तैनेईं तेरे दासां केरि लाशां अम्बरेरे च़ुड़ोलन खाने जो दित्ती,</para>
  <para style="q" vid="PSA 79:2">ते तेरे भक्तां केरू मास धेरतरे जंगली जानबरन खुवाव।<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />यरूशलेमेरे च़ेवरे पासन तैनेईं खूनेरी ज़ेरि गड्डां बगेवरिन,</para>
  <para style="q" vid="PSA 79:3">तैड़ी कोई बाकी नईं राहोरो कि ज़ै तैन दब्बे।<verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />पड़ोसी केरे दरमियान इश्शी बदनामी भोल्ही;</para>
  <para style="q" vid="PSA 79:4">च़ेवरे पासां केरे रानेबाले असन पुड़ हसतन, ते मज़ाक बनातन।<verse eid="PSA 79:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />हे यहोवा, केइस तगर? कुन तू हमेशा तगर क्रोधे मां रालो?</para>
  <para style="q" vid="PSA 79:5">तीं मां किताली तगर अग्गरी ज़ेरि जलन भड़कती राली?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />ज़ैना कौमां तीं न ज़ानन,</para>
  <para style="q" vid="PSA 79:6">ते ज़ैन रियासतां केरे लोक तीं कां प्राथना न केरन,</para>
  <para style="q" vid="PSA 79:6">तैन पुड़ अपनि सब सरक भड़का!<verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />किजोकि तैनेईं याकूब निगलो,</para>
  <para style="q" vid="PSA 79:7">ते तैसेरी रानेरी ठार बरबाद की।<verse eid="PSA 79:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />इश्शे नुक्सानेरे लेई बुज़ुर्गां केरे अधर्मेरां कम्मन याद न केर;</para>
  <para style="q" vid="PSA 79:8">तेरी दया असन पुड़ जल्दी भोए, किजोकि अस बड़े बुरे हाले मां पेवरेम।<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />हे इश्शे मुक्तरे परमेशर, अपने नंव्वेरे महिमारे खातर इश्शी मद्दत केर;</para>
  <para style="q" vid="PSA 79:9">ते अपने नंव्वेरे खातर असन छुटेइतां इश्शे पापन माफ़ केर।<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />गैर कौमां किजो ज़ोन कि एन केरो परमेशर कोड़िए?</para>
  <para style="q" vid="PSA 79:10">इश्शे हेरते-हेरते तेरे दासां केरे खूनेरो बदलो नेव गाए।<verse eid="PSA 79:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />कैदी केरू करलानू, तीं तगर पुज़ते;</para>
  <para style="q" vid="PSA 79:11">ज़ैना नाश भोने बालेन तैन एपनी बेड़ी कुदरती सेइं बच़ा।<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />हे प्रभु, ज़ै लान-तान इश्शे पड़ोसेईं तीं जेई दित्तोरीए,</para>
  <para style="q" vid="PSA 79:12">तै सत गुणा तैन केरे दोग्गे पुड़ वापस तैन दे।<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />तैखन असां ज़ैना तेरे लोक ते चरागारी भैड्डां अहम,</para>
  <para style="q" vid="PSA 79:13">तेरू शुक्र हमेशा केरते रामेले;</para>
  <para style="q" vid="PSA 79:13">ते पीढ़ी करां पीढ़ी तगर तेरी तारीफ़ केरते रामेले।<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">इस्राएली लोकां केरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई: शोशन्नीमेदूत रागे मां आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1" />हे इस्राएलेरे पुहाला,</para>
  <para style="q" vid="PSA 80:1">असन पुड़ ध्यान दे, तू ज़ै यूसुफेरी अगवाई गब्बां केरि ज़ेरि केरतस!</para>
  <para style="q" vid="PSA 80:1">तू ज़ै करूबन पुड़ बिशोरोस, अपनि महिमा हिरा!<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2" />एप्रैम, ते बिन्यामीन, ते मनश्शेरी ज़ेरि अपनि महिमा हिरेइतां,</para>
  <para style="q" vid="PSA 80:2">असन बच़ानेरे लेई एई!<verse eid="PSA 80:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3" />हे परमेशर, असन बहाल केर;</para>
  <para style="q" vid="PSA 80:3">अपने तुत्तरेरी लौ चमका त असां बच़मेले।<verse eid="PSA 80:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4" />हे सेनां केरे परमेशर यहोवा,</para>
  <para style="q" vid="PSA 80:4">तू केइस तगर अपने लोकां केरि प्राथना सेइं क्रोधे रालो?<verse eid="PSA 80:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5" />तीं तैन ऐंखरू केरि रोट्टी खुवेवरीए,</para>
  <para style="q" vid="PSA 80:5">ते ऐंखरू केरे घड़े भेरि-भेरि पियावरेन।<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6" />तू असन इश्शे पड़ोसी केरे लड़नेरी वजा बनातस;</para>
  <para style="q" vid="PSA 80:6">इश्शे दुश्मन एप्पु मांमेइं इश्शो मज़ाक बनातन।<verse eid="PSA 80:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7" />हे सेनां केरे परमेशर, असन बहाल केर;</para>
  <para style="q" vid="PSA 80:7">अपने तुत्तरेरी लौ असन पुड़ चमका,</para>
  <para style="q" vid="PSA 80:7">त असां बच़ाए गामेले।<verse eid="PSA 80:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8" />तीं मिस्र मुल्खे मरां दाछ़रू<note caller="+" style="f"><char style="fr" closed="false">80:8 </char><char style="fq" closed="false">दाछ़रू </char><char style="ft" closed="false">भजन लिखने बालो इस्राएलेरे लेई दाछ़रो इस्तेमाल केरते। यशा. 5:1-7 </char></note> अक बड़ आनू;</para>
  <para style="q" vid="PSA 80:8">ते गैर कौमां केढतां तैन लावं।<verse eid="PSA 80:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9" />तीं तैसेरे लेई ठार तियार कियोरीए;</para>
  <para style="q" vid="PSA 80:9">ते तैनी ज़ील छ़डू ते फैलतां पूरो मुल्ख भेरि छ़डो।<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10" />तैसेरी छाव पहाड़न पुड़ फैली जेई,</para>
  <para style="q" vid="PSA 80:10">ते तैसेरी डैलड़ी बड्डे-बड्डे गैइड़ां केरि ज़ेरि भोइ;<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11" />तैसेरे डाल समुन्दरे तगर फैली जे,</para>
  <para style="q" vid="PSA 80:11">ते तैसेरे मुन्केरे फरात दरियाए तगर पुज़्ज़ी जे।<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12" />तीं तैसेरी चार दिवारी किजो बिछ़ोड़ी छ़डी?</para>
  <para style="q" vid="PSA 80:12">कि सब बत्तां च़लनेबाले तैसेरी दाछ़ ट्लोड़तन?<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13" />जंगलेरे सूर तैस बरबाद केरतन,</para>
  <para style="q" vid="PSA 80:13">ते मैइदानेरे सब जानबर तैस खातन।<verse eid="PSA 80:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14" />हे सेनां केरे परमेशर, इश्शे पासे फिरी दुबारो मुड़,</para>
  <para style="q" vid="PSA 80:14">सुर्गेरां ध्यान देइतां हेर, ते इस दाछ़री हिफाज़त केर,<verse eid="PSA 80:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15" />ई बूटो तीं अपने देइने हथ्थे सेइं लव,</para>
  <para style="q" vid="PSA 80:15">ते ज़ैस बड़हेरो डाल तीं अपने लेई मज़बूत कियो।<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16" />तै दाछ़ फुकोई जेई, तै केट्टोई जेई;</para>
  <para style="q" vid="PSA 80:16">तेरे झ़िड़की सेइं तेरे दुश्मन नाश भोइ गान।<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17" />तेरे देइने हथ्थे सेइं सुमैलतां मैन्हु पुड़ तेरो हथ राए,</para>
  <para style="q" vid="PSA 80:17">तैस मैन्हु पुड़, ज़ै तीं अपने लेई मज़बूत कियोरोए।<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18" />तैखन असां तीं करां दूर न भोमेले:</para>
  <para style="q" vid="PSA 80:18">तू असन ज़ींतां, ते अस तीं कां प्राथना केरेले।<verse eid="PSA 80:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19" />हे सेनां केरे परमेशर यहोवा, असन बहाल केर,</para>
  <para style="q" vid="PSA 80:19">ते अपने तुत्तरेरी लौ असन पुड़ चमका,</para>
  <para style="q" vid="PSA 80:19">तैखन असां बच़मेले!<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">हुक्म मन्नेरे लेई कुजव गानू</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई: गित्तीथ रागे मां आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1" />परमेशर ज़ै इश्शी ताकते, तैसेरू गीत खुशी सेइं ज़ोथ;</para>
  <para style="q" vid="PSA 81:1">याकूबेरे परमेशरेरू जयजयकार केरा!<verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2" />गीत ज़ोथ, खंजरी ते सितार ते सारंगी आनां।<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3" />संगरांतरे दिहाड़े,</para>
  <para style="q" vid="PSA 81:3">ते पुनयारे दिहाड़े इश्शे तिहारेरे दिहाड़े नरशिंगो बज़ाथ।<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4" />किजोकि ऐह इस्राएलेरी विधि,</para>
  <para style="q" vid="PSA 81:4">ते याकूबेरे परमेशरेरो बनेवरो नियमे।<verse eid="PSA 81:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5" />त परमेशरे एन यूसुफे मां कानूनेरी रीति पुड़ तैखन च़लावं,</para>
  <para style="q" vid="PSA 81:5">ज़ैखन यूसुफ मिस्रेरे खलाफ च़लो,</para>
  <para style="q" vid="PSA 81:5">मीं अक एरी आवाज़ शुनी, ज़ै अवं न थियो ज़ानतो।<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6" />“मीं तैन केरे कंधे पुड़ेरां भारो उसालो;</para>
  <para style="q" vid="PSA 81:6">ते तैन केरे हथ गिरकी टोकरी छ़ूने करां आज़ाद किये।<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7" />मुसीबती मां तीं मींजेई आवाज़ दित्ती ते मीं तू बच़ाव;</para>
  <para style="q" vid="PSA 81:7">गुड़ते अम्बरे मरां मीं तींजो जुवाब दित्तो,</para>
  <para style="q" vid="PSA 81:7">ते मीं तू मरीबा नंव्वेरे पैनी पुड़ अज़मव।<note caller="-" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">निर्ग. 17:1-7</ref>;<ref loc="NUM 20:2-13">गिन. 20:2-13</ref>;<ref loc="PSA 95:8-9">भज. 95:8-9</ref>.</char></note> <char style="qs">(सेला) </char><verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8" />हे मेरे लोकव, शुना, अवं तुसन समझ़ताईं!</para>
  <para style="q" vid="PSA 81:8">हे इस्राएल, रोड़ू भोए कि तू मेरी गल मन्नस।<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9" />तेरे दरमियाने मां कोई होरो ईश्वर न भोए,</para>
  <para style="q" vid="PSA 81:9">ते न तू कोन्ची बखले देबतेरी आराधना केरस!<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10" />तेरो परमेशर यहोवा अवं आईं,</para>
  <para style="q" vid="PSA 81:10">ज़ैनी तू मिस्र मुल्खे मरां केढतां आनोरोस।</para>
  <para style="q" vid="PSA 81:10">मीं करां मग, त अवं तैन सब किछ देइलो ज़ेसेरी तीं ज़रूरते।<verse eid="PSA 81:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11" />पन मेरे लोकेईं मेरी गल न शुनी;</para>
  <para style="q" vid="PSA 81:11">इस्राएले मेरो हुक्म न मन्नो।<verse eid="PSA 81:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12" />एल्हेरेलेइ मीं तै तैसेरे सखत दिलेरे हवाले कियो,</para>
  <para style="q" vid="PSA 81:12">कि तै अपने योजनां केरे मुताबिक च़ले।<verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13" />अगर मेरे लोक मेरी गल्‍लां शुन्न,</para>
  <para style="q" vid="PSA 81:13">त अगर इस्राएल मेरी बत्तन पुड़ च़ले,<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14" />तैखन अवं लूशी तैन केरे दुश्मन दबेइ देथो,</para>
  <para style="q" vid="PSA 81:14">तैखन अवं अपनो हथ तैन दुश्मना केरे खलाफ च़लेइ।<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15" />यहोवा सेइं बैर केरनेबाले तैस करां डेरतां तैस कां झुकतन!</para>
  <para style="q" vid="PSA 81:15">ते तैन हमेशारे लेई सज़ा मैल्हे।<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16" />पन इस्राएले त अवं खूब रोड़े गेहुं खुवाथो,</para>
  <para style="q" vid="PSA 81:16">अवं जंगली मैछ़ी सेइं तैन रज़ानेथो।”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">सच़्च़े न्यायेरे लेई बिनती</para>
  <para style="d">आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1" />परमेशर महान सभाई मां खड़ोए:</para>
  <para style="q" vid="PSA 82:1">तै ईश्वरां<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="fq" closed="false">ईश्वरां </char><char style="ft" closed="false">ज़ैन लोक सोचतन कि तैना ईश्वर आन</char></note> केरे दरमियान न्याय केरते।<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />“तुस लोक केइस तगर आदालती मां गलत फैसले केरतां,</para>
  <para style="q" vid="PSA 82:2">दुष्टां केरि तरफदारी केरते राले? <char style="qs">(सेला)</char><verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />कंगालन त अनाथन न्याय देथ,</para>
  <para style="q" vid="PSA 82:3">गरीबां केरो खियाल धर्मे सेइं केरा।<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />कंगाल ते गरीबन बच़ेइतां</para>
  <para style="q" vid="PSA 82:4">दुष्टां केरे हथ्थे करां तैन छुटाथ।”<verse eid="PSA 82:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />तैना दुष्ट लोक न त किछ ज़ानन, तैन समझ़ न एज्जे,</para>
  <para style="q" vid="PSA 82:5">तैना आंधरे मां टेपलोइतां हंठतन फिरतन,</para>
  <para style="q" vid="PSA 82:5">धेरतरी सारी मुनीयाद हिल्‍ली गाचे।<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />मीं ज़ोवरू थियूं, “तुस ईश्वर आथ,</para>
  <para style="q" vid="PSA 82:6">ते सब ज़ेत्रे भी आथ सब परमप्रधान परमेशरेरां मट्ठां आथ।<note caller="-" style="x"><char style="xo" closed="false">82:6 </char><char style="xt" closed="false"><ref loc="JHN 10:34">यूह. 10:34</ref>.</char></note><verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />फिरी भी तुस मैन्हु केरे ज़ेरे मेरि गाले,</para>
  <para style="q" vid="PSA 82:7">ते कोन्ची प्रधानेरे ज़ेरे बिछ़ड़ी गाले।”<verse eid="PSA 82:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />हे परमेशर, उठतां धेरतरो न्याय केर;</para>
  <para style="q" vid="PSA 82:8">किजोकि तूए सारे राष्ट्रन अपने अधिकारे मां केरेलो।<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">दुश्मना केरे खलाफ प्राथनारू गीत</para>
  <para style="d">आसापेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1" />हे परमेशर च़ुपच़ाप न रा;</para>
  <para style="q" vid="PSA 83:1">हे परमेशर च़ुप न रा, ते न शान्त भो!<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2" />हेर, तेरे दुश्मन दंगो लगोरेन केरन,</para>
  <para style="q" vid="PSA 83:2">तेरे बैरी तेरे खलाफ खड़ो भेवरेन।<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3" />तैना च़लैकी सेइं तेरे लोकां केरे नुक्सानेरी योजना बनातन,</para>
  <para style="q" vid="PSA 83:3">ते तेरे शरणी मां एवरे लोकां केरे खलाफ योजना कढतन।<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4" />तैनेईं तैन सेइं ज़ोवं, “एज्जा असां तैन मुकेईं छ़डम, ताके तैना राष्ट्रेरे रूपे मां न रान,</para>
  <para style="q" vid="PSA 83:4">ते इस्राएलेरू नवं अग्रोवं जो याद न राए।”<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5" />तैनेईं अक मन भोइतां योजना बनाई,</para>
  <para style="q" vid="PSA 83:5">ते तेरे खलाफ करार कियोरोए।<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6" />एना त एदोमेरे तेम्बु बाले</para>
  <para style="q" vid="PSA 83:6">ते इश्माएली, ते मोआबी, ते हग्री।<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7" />गबाली, अम्मोनी, अमालेकी,</para>
  <para style="q" vid="PSA 83:7">पलिश्ती ते सोर मुल्खेरे रानेबाले समेत पलिश्ती आन।<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8" />इन सेइं साथी अश्शूरी लोक भी शामल भेवरेन;</para>
  <para style="q" vid="PSA 83:8">तैन सेइं भी लूतेरी औलादी सहारो मैल्होरोए। <char style="qs">(सेला) </char><verse eid="PSA 83:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9" />तैन सेइं एरहो सलूख केर ज़ेरो मिद्यानी लोकन सेइं,</para>
  <para style="q" vid="PSA 83:9">कीशोन दरियाए पुड़ सीसरा ते याबीने सेइं कियोरो थियो।<verse eid="PSA 83:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10" />तैना एनदोर नगरे मां नाश भोए,</para>
  <para style="q" vid="PSA 83:10">ते उडारेरे लेई खाद बेनि जे।<verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11" />तैन केरे हुकूमत केरनेबालन सेइं तीं ओरेब ते जेबेरे ज़ेरे,</para>
  <para style="q" vid="PSA 83:11">तैन केरे सारे प्रधान्न जेबह ते सल्मुन्नारे ज़ेरे केर,<note caller="+" style="f"><char style="fr" closed="false">83:11 </char><char style="ft" closed="false">ओरेब ते जेबह दूई मिद्यानी हाकिम एप्रैमी लोकेईं मारे। न्याय. 7:24-25. </char></note><verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12" />ज़ैनेईं ज़ोवरू थियूं,</para>
  <para style="q" vid="PSA 83:12">“असां परमेशरेरे चरागां केरे अधिकारी एप्पु भोइ गामेले।”<verse eid="PSA 83:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13" />हे मेरे परमेशर, तैन बवंडरेरी धूड़रे ज़ेरे,</para>
  <para style="q" vid="PSA 83:13">या बाते सेइं उडारोरी धूड़ी सेइं भूंसेरे ज़ेरे बनेई दे।<verse eid="PSA 83:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14" />तैस अग्गरे ज़ेरे ज़ै जंगले भस्म केरतीए,</para>
  <para style="q" vid="PSA 83:14">ते तैस लौअरे ज़ेरे ज़ै पहाड़न फुक्‍की छ़डतीए,<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15" />एन्च़रे तू एन अपने ऐंधी सेइं तैन निशैनी छ़ड,</para>
  <para style="q" vid="PSA 83:15">ते अपने तूफाने सेइं तैन डरेई छ़ड!<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16" />इन दुश्मना केरे तुत्तरे बड़े बेइज़्ज़त केर,</para>
  <para style="q" vid="PSA 83:16">कि हे यहोवा इना तेरे नंव्वे तोप्पन।<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17" />इना सदारे लेई शरमिन्दा ते डरोरोरे रान,</para>
  <para style="q" vid="PSA 83:17">इन केरां तुत्तरां कालां भोन, ते इन केरो नाश भोए,<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18" />ज़ैस सेइं इना ज़ानन कि सिर्फ तू ज़ेसेरू नवं यहोवा आहे,</para>
  <para style="q" vid="PSA 83:18">सारे धेरती पुड़ परमप्रधान परमेशरे।<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">परमेशरेरे भवनेरी चाहत</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई गित्तीथे मां कोरह खानदानेरे लोकां केरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1" />हे सेनां केरे यहोवा, तेरी रानेरी ठार केत्री रोड़ीए।<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2" />मेरे प्राण यहोवारे अंगना केरि तलाश केरते-केरते बेहोश भोइ गातन,</para>
  <para style="q" vid="PSA 84:2">मेरो तन ते मन दूईये परमेशरे पुकारते रहतन।<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3" />हे सेना केरे यहोवा, हे मेरे राज़ा, ते परमेशर, तेरी वेदी कां च़ुड़ोली अपनो ठिकानो,</para>
  <para style="q" vid="PSA 84:3">ते शूपाबेना आल्हो बनेवरोए ज़ैस मां तै अपने बच्‍चे रख्खे।<verse eid="PSA 84:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4" />केत्रे धन आन तैना, ज़ैना तेरे घरे<note caller="+" style="f"><char style="fr" closed="false">84:4 </char><char style="fq" closed="false">घरे </char><char style="ft" closed="false">मन्दर</char></note> मां रहतन;</para>
  <para style="q" vid="PSA 84:4">ते तैना हमेशा तेरी तारीफ़ केरते राले। <char style="qs">(सेला) </char><verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5" />केत्रो धने तै मैन्हु, ज़ै तीं करां ताकत हासिल केरते,</para>
  <para style="q" vid="PSA 84:5">ते तैना ज़ैन सिय्योनेरी सड़करी खबर रहतीए।<verse eid="PSA 84:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6" />तैना लेरां केरि तरैई मां गातन ते तैस पैनेरे नागां केरि ठार बनातन;</para>
  <para style="q" vid="PSA 84:6">फिरी एग्री बरसांत तैस मां बरकते बरकत उगातीए।<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7" />तैना ज़ोरे पुड़ ज़ोर हासिल केरते रहतन;</para>
  <para style="q" vid="PSA 84:7">ते तैन मरां हर अक मैन्हु सिय्योने मां परमेशरे अपनु तुत्तर हिरालो।<verse eid="PSA 84:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8" />हे सेना केरे परमेशर यहोवा, मेरी प्राथना शुन,</para>
  <para style="q" vid="PSA 84:8">हे याकूबेरे परमेशर, ध्यान दे! <char style="qs">(सेला) </char><verse eid="PSA 84:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9" />हे परमेशर, हे इश्शी ढाल, नज़र केर;</para>
  <para style="q" vid="PSA 84:9">ते अपने च़ुनोरे राज़ेरू तुत्तरे हेर!<verse eid="PSA 84:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10" />किजोकि तेरे अंगन्न मां अक दिहाड़ी कही हज़ार दिहैड़ी करां जादे रोड़ीए।</para>
  <para style="q" vid="PSA 84:10">दुष्टां केरे डेरन मां राने करां रोड़ूए।</para>
  <para style="q" vid="PSA 84:10">अपने परमेशरेरे भवनेरे दारे पुड़ खड़ू रानू मीं जादे पसंद एइते।<verse eid="PSA 84:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11" />किजोकि परमेशर दिहाड़ेरो ज़ेरो ते ढालरो ज़ेरोए;</para>
  <para style="q" vid="PSA 84:11">यहोवा अनुग्रह केरेलो, ते महिमा देलो;</para>
  <para style="q" vid="PSA 84:11">ते ज़ैना लोक सही चाल च़लतन;</para>
  <para style="q" vid="PSA 84:11">तैन करां तै कोई रोड़ी चीज़ दूर न रखेलो।<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12" />हे सेना केरे यहोवा,</para>
  <para style="q" vid="PSA 84:12">केत्रो धने तै मैन्हु, ज़ै तीं पुड़ भरोसो रखते!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">राष्ट्रेरे कल्याणेरे लेई प्राथना</para>
  <para style="d">बज़ानेबालां केरे लेई: कोरह खानदानेरे लोकां केरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1" />हे यहोवा, तू अपने मुल्खे पुड़ खुश भोव, याकूब गुलैमी करां छुटेइतां वापस आनो।<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2" />तीं अपने लोकां केरे पाप माफ़ कियोरेन;</para>
  <para style="q" vid="PSA 85:2">ते तैन केरे सारे पाप ढक्‍कोरेन। <char style="qs">(सेला) </char><verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3" />तीं अपनो क्रोध शान्त कियोरोए;</para>
  <para style="q" vid="PSA 85:3">ते अपनो भटकोरो कोप दूर कियोरोए।<verse eid="PSA 85:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4" />हे इश्शे मुक्तरे परमेशर, असन फिरी दुबारे बहाल केर,</para>
  <para style="q" vid="PSA 85:4">ते अपनो क्रोध असन पुड़ेरां दूर केर!<verse eid="PSA 85:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5" />कुन तू हमेशा तगर असन पुड़ सरकी मां रालो?</para>
  <para style="q" vid="PSA 85:5">कुन तू पीढ़ी-पीढ़ी तगर कोप केरतो रालो?<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6" />कुन तू असन फिरी ज़ींतो न केरेलो,</para>
  <para style="q" vid="PSA 85:6">ताके तेरे लोक तीं मां खुश रान?<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7" />हे यहोवा, अपनि करुणा असन हिरा,</para>
  <para style="q" vid="PSA 85:7">अपनि मुक्ति असन दे।<verse eid="PSA 85:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8" />अवं कन्न लेइतां रखेलो कि परमेशर यहोवा कुन ज़ोते,</para>
  <para style="q" vid="PSA 85:8">किजोकि तै अपने लोकन सेइं ज़ैना तैसेरे भक्तन, शैन्तरी गल्‍लां ज़ोलो;</para>
  <para style="q" vid="PSA 85:8">पन तैना बेदलोइतां बेवकूफी न केरने लग्गन।<verse eid="PSA 85:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9" />सच़्च़े तैस करां डरने बालां केरि मुक्तरो वक्त नेड़े एवरोए,</para>
  <para style="q" vid="PSA 85:9">तैखन इश्शे मुल्खे मां महिमा बास केरेली।<verse eid="PSA 85:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10" />करुणा ते सच़्च़ाई एप्पु मांमेइं मिली जेई;</para>
  <para style="q" vid="PSA 85:10">धार्मिकता ते शैन्तां एक्‍की होरि फुम्मड़ी दित्तोरिन।<verse eid="PSA 85:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11" />धेरती मरां सच़्च़ाई उगतीए</para>
  <para style="q" vid="PSA 85:11">ते सुर्गेरां धार्मिकता झुकतीए।<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12" />हाँ, यहोवा रोड़ी चीज़ां देलो,</para>
  <para style="q" vid="PSA 85:12">इश्शी ज़मीन अपनि फसल देली।<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13" />धार्मिकता यहोवा अग्री-अग्री च़लेली,</para>
  <para style="q" vid="PSA 85:13">ते तैसेरे पव्वां केरे निशान इश्शे लेई बत बनाले।<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">मातम ते प्राथना</para>
  <para style="d">दाऊदेरी प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1" />हे यहोवा, ध्यान देइतां मेरी प्राथना शुन,</para>
  <para style="q" vid="PSA 86:1">किजोकि अवं गरीब ते ज़रूरतमन्द आईं।<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />मेरे प्राण बच़ेइतां रख, किजोकि अवं तेरो भक्त आईं,</para>
  <para style="q" vid="PSA 86:2">तू मेरो परमेशरस, एल्हेरेलेइ अपने दास मीं,</para>
  <para style="q" vid="PSA 86:2">ज़ेसेरो भरोसो तीं पुड़े बच़ेइतां रख।<verse eid="PSA 86:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />हे प्रभु, मीं पुड़ अनुग्रह केर,</para>
  <para style="q" vid="PSA 86:3">किजोकि अवं तींए पुकारतो रहताईं।<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />अपने दासेरे मने खुश केर,</para>
  <para style="q" vid="PSA 86:4">किजोकि हे प्रभु, अवं अपनो मन तेरे पासे लाताईं।<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />किजोकि हे प्रभु, तू भलो ते माफ़ केरने बालोस,</para>
  <para style="q" vid="PSA 86:5">ज़ेत्रे तीं पुकारतन, तैन सेभी केरे लेई तू बड़ो महरबानस।<verse eid="PSA 86:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />हे यहोवा मेरी प्राथनारे पासे कन ला,</para>
  <para style="q" vid="PSA 86:6">ते मेरी बिनती ध्याने सेइं शुन।<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />मुसीबतरे दिहाड़े अवं तीं पुकारेलो,</para>
  <para style="q" vid="PSA 86:7">किजोकि तू मेरी प्राथना शुनेलो।<verse eid="PSA 86:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />हे प्रभु, देबतन मरां कोई तेरो ज़ेरो नईं,</para>
  <para style="q" vid="PSA 86:8">ते न केन्चेरां कम्मां तेरे बराबरन।<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />हे प्रभु, ज़ेत्री भी कौमां तीं बनेवरिन,</para>
  <para style="q" vid="PSA 86:9">तैना एइतां तीं कां मथ्थो टेकेली,</para>
  <para style="q" vid="PSA 86:9">ते तेरे नव्वेंरी महिमा केरेली।<verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />किजोकि तू महान, ते तू बड्डां-बड्डां कम्मां केरतस,</para>
  <para style="q" vid="PSA 86:10">सिर्फ तूए परमेशर आस।<verse eid="PSA 86:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />हे यहोवा, तू अपनि बत मीं हेरा, तैखन अवं तेरे सच़्च़े बत्ती पुड़ च़लेलो,</para>
  <para style="q" vid="PSA 86:11">मीं अक मन केर कि अवं तेरे नंव्वेरो डर मन्नेलो।<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />हे प्रभु, हे मेरे परमेशर, अवं पूरे दिले सेइं तेरू शुक्र केरेलो,</para>
  <para style="q" vid="PSA 86:12">ते तेरे नंव्वेरी महिमा हमेशा केरतो रेइलो।<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />किजोकि तेरी करुणा मीं पुड़ बड़ीए;</para>
  <para style="q" vid="PSA 86:13">ते तीं अवं पाताले मां गाने करां बच़वरोईं।<verse eid="PSA 86:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />हे परमेशर, घमण्डी लोक मेरे खलाफ खड़े भेवरेन,</para>
  <para style="q" vid="PSA 86:14">ज़ालमां केरो जथो मेरे प्राणेरी तोपी मां खड़ो भोवरोए,</para>
  <para style="q" vid="PSA 86:14">ते तैना तेरो कोई भी खियाल न केरन।<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />पन प्रभु दया केरनेबालो ते अनुग्रह केरनेबालो</para>
  <para style="q" vid="PSA 86:15">ते च़िरे सेइं क्रोध केरनेबालो ते बड़ो प्यार केरनेबालोए।<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />मेरे पासे फिर, मीं पुड़ अनुग्रह केर;</para>
  <para style="q" vid="PSA 86:16">अपने दासे तू शक्ति दे,</para>
  <para style="q" vid="PSA 86:16">अपने दैसरे मट्ठे बच़ा,<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />मीं भलियैइयरो कोई निशान हिरा,</para>
  <para style="q" vid="PSA 86:17">ज़ैस हेरतां मेरे दुश्मन उदास भोन,</para>
  <para style="q" vid="PSA 86:17">किजोकि हे यहोवा, तीं एप्पु मेरी मद्दत की</para>
  <para style="q" vid="PSA 86:17">ते मीं शान्ति दित्तोरीए।<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">परमेशरेरू नगर सिय्योनेरी तारीफ़रे लेई</para>
  <para style="d">कोरह खानदानेरे लोकां केरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1" />यहोवारी मुनीयाद पवित्र पहाड़े पुड़ रख्खी जेवरीए;<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />ते यहोवा सिय्योनेरे फाटकन मरां याकूबेरे सारे रानेरे ठारन<note caller="+" style="f"><char style="fr" closed="false">87:2 </char><char style="fq" closed="false">ठारन </char><char style="ft" closed="false">यरूशलेमेरू नगर</char></note> करां जादे प्यार केरते।<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />हे परमेशरेरे नगर,<note caller="+" style="f"><char style="fr" closed="false">87:3 </char><char style="fq" closed="false">परमेशरेरे नगर </char><char style="ft" closed="false">यरूशलेमे जो परमेशरेरू नगर ज़ोतन।</char></note></para>
  <para style="q" vid="PSA 87:3">तेरे बारे मां महिमारी गल्‍लां ज़ोवरिन। <char style="qs">(सेला) </char><verse eid="PSA 87:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />अवं ज़ान-पिशानी बालन सेइं रहब ते बाबेलेरी भी चर्चा केरमेले;</para>
  <para style="q" vid="PSA 87:4">पलिश्त, सोर ते कूशे<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="fq" closed="false">कूशे </char><char style="ft" closed="false">इथियोपिया</char></note> हेरा:</para>
  <para style="q" vid="PSA 87:4">“ई तैड़ी पैदा भोवरो थियो।”<verse eid="PSA 87:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />ते सिय्योनेरे बारे मां इन ज़ोवं गालू,</para>
  <para style="q" vid="PSA 87:5">“इन मरां हर एक्‍केरू ज़र्म तैस मां भोवरू थियूं।”</para>
  <para style="q" vid="PSA 87:5">ते परमप्रधान परमेशर तैस एप्पु कायम रख्खे।<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />ज़ैखन यहोवा मुल्खे-मुल्खेरे लोकां केरां नंव्वां लिखतां गनेलो, तैखन इन ज़ोलो,</para>
  <para style="q" vid="PSA 87:6">“ई तैड़ी पैदा भोवरो थियो।” <char style="qs">(सेला) </char><verse eid="PSA 87:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />गीतां ज़ोनेबाले ते नच़ने बाले दूईये ज़ोले,</para>
  <para style="q" vid="PSA 87:7">“इश्शे सारे चशमे तींए मां आन।”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">बुरे हालातन मां मद्दतरे लेई प्राथनारू गीत;</para>
  <para style="d">कोरह खानदानेरे लोकां केरू भजन।</para>
  <para style="d">बज़ानेबालां केरे प्रधानेरे लेई: महलतलग्रोत रागे मां एज्रा खानदानेरे हेमानेरो मश्कील।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1" />हे इश्शे मुक्ति देनेबाले परमेशर यहोवा,</para>
  <para style="q" vid="PSA 88:1">सैरी दिहैड़ी ते राती अवं अपने उदैसारे लेई तीं कां बिनती केरताईं।<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2" />मेरी प्राथना तीं तगर पुज़्ज़े,</para>
  <para style="q" vid="PSA 88:2">अपनो कन मेरी बिनतरे पासे ला।<verse eid="PSA 88:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3" />किजोकि मेरो प्राण दुखे सेइं भेरतांए;</para>
  <para style="q" vid="PSA 88:3">ते मेरो प्राण पाताले तगर पुज़ोरोए।<verse eid="PSA 88:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4" />अवं कब्री मां गानेबालन मां गनो जेवरोईं;</para>
  <para style="q" vid="PSA 88:4">अवं कमज़ोर मैन्हेरो ज़ेरो भोवरोईं।<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5" />अवं मुड़दन मां छ़डोरोईं,</para>
  <para style="q" vid="PSA 88:5">ते ज़ैना कत्ल भोइतां कब्री मां जेवरेन,</para>
  <para style="q" vid="PSA 88:5">ते ज़ैन तू फिरी याद न केरस</para>
  <para style="q" vid="PSA 88:5">ते तैना तेरी मद्दती करां दूरन,</para>
  <para style="q" vid="PSA 88:5">तैन केरो ज़ेरो अवं भोइ जेवरोईं।<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6" />तीं अवं गड्ढेरे थले मां</para>
  <para style="q" vid="PSA 88:6">आंधरे ते डुग्घे ठैरी रखोरोइं।<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7" />तेरो क्रोध मीं पुड़ बनोरोए;</para>
  <para style="q" vid="PSA 88:7">ते तीं अपने सब लहरन सेइं मीं दुख दित्तोरोए। <char style="qs">(सेला) </char><verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8" />तीं मेरे सारे पिशाने बाले दोस्त मीं करां दूर कियोरेन;</para>
  <para style="q" vid="PSA 88:8">ते अवं तैन केरि नज़री मां घटिया कियोरोईं।</para>
  <para style="q" vid="PSA 88:8">अवं कैदी आईं ते छुट्टी न सेकी;<verse eid="PSA 88:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9" />दुख भोगते-भोगते मेरी एछ़्छ़ी कैनी भोइ,</para>
  <para style="q" vid="PSA 88:9">हे यहोवा, अवं रोज़ तीं पुकारतो रहताईं ते अपने हथ प्राथनारे लेई खड़े केरतो एवरोईं।<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10" />कुन तू मुड़दां केरे लेई बड्डां-बड्डां कम्मां हिरालो?</para>
  <para style="q" vid="PSA 88:10">कुन मरोरे लोक तेरू शुक्र केरेले? <char style="qs">(सेला) </char><verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11" />कुन लोक कब्री मां तेरे प्यारेरो,</para>
  <para style="q" vid="PSA 88:11">ते विनाशेरे हालती मां तेरी सच़्च़ेरू बियान कियूं गालू?<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12" />कुन तेरां बड्डां-बड्डां कम्मां आंधरे मां,</para>
  <para style="q" vid="PSA 88:12">या तेरो धर्म धोखेबैज़रे हालती मां ज़ानो गालो?<verse eid="PSA 88:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13" />पन हे यहोवा, अवं मद्दतरे लेई तीं पुकारताईं;</para>
  <para style="q" vid="PSA 88:13">मेरी प्राथना रोज़ झ़ेझ़ां तेरे सामने पुज़्ज़ी गाचे।<verse eid="PSA 88:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14" />हे यहोवा, तू मीं किजो शारतस?</para>
  <para style="q" vid="PSA 88:14">ते अपनु तुत्तर मीं करां किजो छ़ुपेइतां रखतस?<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15" />अवं बचपनेरो दुखी मतलब अधमरो आईं,</para>
  <para style="q" vid="PSA 88:15">तीं करां डेरतां अवं बड़ो परेशान आईं।<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16" />तेरो क्रोध मीं पुड़ भड़कोरोए;</para>
  <para style="q" vid="PSA 88:16">तैस डरे करां अवं मिटी जेव।<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17" />तैना डरानेबैली चीज़ां सैरी दिहैड़ी पैनेरे ज़ेरि मीं घेरतां रेखतिन;</para>
  <para style="q" vid="PSA 88:17">तै मेरे च़ेवरे पासे लेइहोते।<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18" />तीं अवं मेरे दोस्तन करां ते पुड़ोसन करां दूर केरतां रखोरोइं,</para>
  <para style="q" vid="PSA 88:18">ते मेरे ज़ान-पिशानी बाले आंधरे मां छ़डोरेन।<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">मुल्खे मां आफतरे वक्ते तारीफ़रू गीत</para>
  <para style="d">एतान एज्रा खानदानेरे लोकां केरो मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1" />अवं यहोवारे प्यारेरे बारे मां हमेशा गीत ज़ोतो रेइलो;</para>
  <para style="q" vid="PSA 89:1">अवं तेरी सच़्च़ाई पीढ़ी करां पीढ़ी तगर ज़ोतो रेइलो।<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2" />किजोकि मीं ज़ोवं, “तेरो प्यार सदा बनोरो रालो,</para>
  <para style="q" vid="PSA 89:2">तू सुर्गे मां अपनि सच़्च़ाई कायम रखेलो।”<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3" />तीं ज़ोवं, “मीं अपने च़ुनोरे सेइं करार कियोरोए,</para>
  <para style="q" vid="PSA 89:3">ते अपने सेवक दाऊदे सेइं कसम खेवरीए,<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4" />अवं तेरे खानदाने हमेशा तगर कायम रखेलो;</para>
  <para style="q" vid="PSA 89:4">ते तेरो तखत पीढ़ी करां पीढ़ी तगर कायम रखेलो।” <char style="qs">(सेला) </char><verse eid="PSA 89:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5" />हे यहोवा, सुर्गे मां तेरे अद्भुत कम्मां केरी,</para>
  <para style="q" vid="PSA 89:5">ते पवित्र लोकां केरि सभाई मां तेरी सच़्च़ेरी तारीफ़ भोल्ही।<verse eid="PSA 89:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6" />किजोकि अम्बरे मां कौन यहोवारो ज़ेरो भोल्हो?</para>
  <para style="q" vid="PSA 89:6">स्वर्गदूतन मां कौन प्रभुएरो ज़ेरो भोइ सकते?<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7" />परमेशर पवित्र लोकां केरि सभाई मां बड़ो आदरारे काबले,</para>
  <para style="q" vid="PSA 89:7">ते अपने च़ेवरे पासन सब रानेबालन करां जादे डरेरे काबले।<verse eid="PSA 89:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8" />हे सेना केरे यहोवा परमेशर,</para>
  <para style="q" vid="PSA 89:8">हे यहोवा, तेरे बराबर कौन शेक्ति बालोए?</para>
  <para style="q" vid="PSA 89:8">तेरी सच़्च़ाई त तेरे च़ेवरे पासन आहे!<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9" />समुन्दरेरे घमण्डे तूए ट्लोड़तस;</para>
  <para style="q" vid="PSA 89:9">ज़ैखन तैसेरी छ़ेल्ही उछ़ड़तिन, तैखन तू तैन शान्त केरतस।<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10" />तीं रहब मारोरां केरो ज़ेरो ढ्लन्च़ोरो,</para>
  <para style="q" vid="PSA 89:10">ते अपने दुश्मन एपनी ताकती सेइं तितर बितर कियोरेन।<verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11" />अम्बर तेरूए, ते धरती भी तेरीए;</para>
  <para style="q" vid="PSA 89:11">दुनिया ते ज़ैन किछ भी तैस मांए, तैन सब तींए बनेवरूए।<verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12" />तीं उत्तर ते दक्षिण भी बनेवरूए;</para>
  <para style="q" vid="PSA 89:12">ताबोर पहाड़ ते हेर्मोन पहाड़ तेरे नंव्वेरी जयजयकार केरतन।<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13" />तेरी पाखड़ निगर;</para>
  <para style="q" vid="PSA 89:13">ते तेरो हथ ताकतबरे तेरो हथ प्रबले।<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14" />तेरे तखतेरी बुनीयाद, धर्म ते न्याये;</para>
  <para style="q" vid="PSA 89:14">प्यार ते सच़्च़ाई तीं अग्री-अग्री च़लतीए।<verse eid="PSA 89:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15" />केत्रे धन आन तैना लोक ज़ैना आनन्देरे ललकारी पिशानतन</para>
  <para style="q" vid="PSA 89:15">हे यहोवा, तैना लोक तेरे तुत्तरेरे लोई मां च़लतन,<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16" />तैना तेरे नंव्वेरे खातर सारे दिहैड़ी मघन रहतन,</para>
  <para style="q" vid="PSA 89:16">ते तेरे धर्मेरे वजाई सेइं महान भोइ गातन।<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17" />किजोकि तूए तैन केरि ताकतरी शोभा आस,</para>
  <para style="q" vid="PSA 89:17">ते तू असन अपने खुशी सेइं इश्शे शिंगे उच्‍चो केरेलो।<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18" />किजोकि इश्शी ढाल ते सिर्फ यहोवारे तरफांए,</para>
  <para style="q" vid="PSA 89:18">ते इश्शो राज़ो इस्राएलेरे पवित्र परमेशरेरे तरफांए।<verse eid="PSA 89:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19" />एक्‍की वक्ते तीं अपने भक्ते दर्शन देइतां गल्‍लां की;</para>
  <para style="q" vid="PSA 89:19">ते ज़ोवं, “मीं मद्दत केरनेरो भार एक्‍की बहादरे पुड़ रखोरोए,</para>
  <para style="q" vid="PSA 89:19">लोकन मरां अक च़ुनतां अग्रोवं बधावरोए।<verse eid="PSA 89:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20" />मीं अपनो दास दाऊद नेइतां,</para>
  <para style="q" vid="PSA 89:20">ते अपने तेले सेइं तैसेरू अभिषेक कियोरूए।<verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21" />मेरो हथ तैस सेइं साथी हमेशा भोल्हो,</para>
  <para style="q" vid="PSA 89:21">मेरी पाखड़ तैस मज़बूत रखेली।<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22" />दाऊदेरे दुश्मन तैस तंग न केरि सकेले,</para>
  <para style="q" vid="PSA 89:22">ते न बुरो मैन्हु तैस दुख देइ सकेलो।<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23" />अवं तैसेरे दुश्मन्न तैसेरे सामनेरां नाश केरेलो,</para>
  <para style="q" vid="PSA 89:23">ते तैसेरे बैरन पुड़ आफत छ़डेलो।<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24" />पन मेरी सच़्च़ाई ते दया तैस पुड़ बनोरी राली,</para>
  <para style="q" vid="PSA 89:24">मेरे नंव्वेरे ज़िरिये तैसेरू शिंग उच्‍चु भोइ गालू।<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25" />अवं समुन्दरे तैसेरे हथ्थे हैठ</para>
  <para style="q" vid="PSA 89:25">ते दरियान तैसेरे देइने हथ्थे हैठ केरेलो।<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26" />तै मींजो पुकैरतां ज़ोलो, ‘तू मेरो बाजी आस,</para>
  <para style="q" vid="PSA 89:26">तू परमेशर ते मेरे मुक्तरी चट्टान आस।’<verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27" />अवं तैस अपनु बड्डू मट्ठू,</para>
  <para style="q" vid="PSA 89:27">ते दुनियारे राज़न पुड़ प्रधान ठहरेलो।<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28" />अवं अपनो प्यार तैस पुड़ हमेशा बनोरो रखेलो,</para>
  <para style="q" vid="PSA 89:28">ते मेरो करार तैसेरे लेई अटल रालो।<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29" />अवं तैसेरू खानदान हमेशा तगर रखेलो,</para>
  <para style="q" vid="PSA 89:29">ते तैसेरो तखत सुर्गेरो ज़ेरो हमेशा बनोरो रालो।<verse eid="PSA 89:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30" />अगर तैसेरे खानदानेरे लोक मेरे कानूने शारन</para>
  <para style="q" vid="PSA 89:30">ते मेरे नियमां केरे मुताबिक न च़लन,<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31" />अगर तैना मेरे विधन ट्लोड़न,</para>
  <para style="q" vid="PSA 89:31">ते मेरे हुक्मन न मन्न,<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32" />त अवं तैन पापेरी सज़ाह सोटे सेइं,</para>
  <para style="q" vid="PSA 89:32">ते तैन केरे अधर्मेरी सज़ाह कोड़न सेइं देलो।<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33" />पन अवं तैस पुड़ेरां अपनो प्यार दूर न केरेलो,</para>
  <para style="q" vid="PSA 89:33">ते न सच़्च़ाई शैरतां झूठो ठहरालो।<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34" />ते अपनो करार न ट्लोड़ेलो,</para>
  <para style="q" vid="PSA 89:34">ते ज़ैन मेरे ऐशी मरां निस्सी जेवं, तैस न बदलेलो।<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35" />मीं एक्‍की बार अपने पवित्रतारी कसम खेवरीए;</para>
  <para style="q" vid="PSA 89:35">ते अवं दाऊदे कधे धोखो न देइलो।<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36" />ते तैसेरू खानदान हमेशा रालू,</para>
  <para style="q" vid="PSA 89:36">ते तैसेरो तखत दिहाड़ेरो ज़ेरो मेरे सामने चमकतो रालो।<verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37" />तै चैंदनरो ज़ेरो हमेशा च़लतो रालो,</para>
  <para style="q" vid="PSA 89:37">ते अम्बरेरे वफादार गवाहेरो ज़ेरो सदा बनोरो रालो।” <char style="qs">(सेला) </char><verse eid="PSA 89:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38" />फिरी भी तीं अपनो अभिषिक्त राज़ो रद कियो ते तै शारो,</para>
  <para style="q" vid="PSA 89:38">ते तू तैस पुड़ क्रोधे भोवरोस।<verse eid="PSA 89:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39" />तीं अपने दासे सेइं कियोरो करार रद कियो,</para>
  <para style="q" vid="PSA 89:39">ते तैसेरू ताज तल्‍ले बिछ़ड़तां अशुद्ध कियोरूए।<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40" />तीं तैस नगरेरी सैरी दिवारां ट्लोड़ी छ़ेडी,</para>
  <para style="q" vid="PSA 89:40">ते तैसेरे क़िले उज़ैड़ी छ़डे।<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41" />सब बत्तां च़लनेबाले, तैस लुटतन,</para>
  <para style="q" vid="PSA 89:41">ते तैसेरे पड़ोसन करां तैसेरी बदनामी भोतीए।<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42" />तीं तैसेरे विरोधी प्रबल किये;</para>
  <para style="q" vid="PSA 89:42">ते तैसेरे सारे दुश्मन खुश कियोरेन।<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43" />फिरी तू तैसेरी तलवारारी धार ट्लोड़तस,</para>
  <para style="q" vid="PSA 89:43">ते जंगी मां तैस ज़ींतने न देस।<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44" />तीं तैसेरी शान खतम की</para>
  <para style="q" vid="PSA 89:44">ते तैसेरो तखत ज़मीनी पुड़ शैरी दित्तोरोए।<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45" />तीं तैसेरी जुवानी घटाई,</para>
  <para style="q" vid="PSA 89:45">तै शरमी सेइं छ़ुपेइतां छ़डोरोए। <char style="qs">(सेला) </char><verse eid="PSA 89:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46" />हे यहोवा, तू केइस तगर लगातार तुत्तर छ़ुपेइतां रालो,</para>
  <para style="q" vid="PSA 89:46">ते सरक कैखन तगर अग्गरी ज़ेरि भटकती राली?<verse eid="PSA 89:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47" />मीं याद केर, कि मेरी ज़िन्दगी केत्री घटे,</para>
  <para style="q" vid="PSA 89:47">तीं सब इन्सान किजो बेकारे मां बनाए?<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48" />कौन मैन्हु हमेशा अमर रालो?</para>
  <para style="q" vid="PSA 89:48">कुन कोई अपने प्राणे पाताले करां बच़ेइ सकते? <char style="qs">(सेला) </char><verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49" />हे प्रभु, तेरो ज़ुमाना केरो प्यार कोड़ि राव,</para>
  <para style="q" vid="PSA 89:49">ज़ेसेरे बारे मां तीं अपने सच़्च़ेरी कसम दाऊदे सेइं कियोरी थी?<verse eid="PSA 89:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50" />हे प्रभु, अपने दासां केरि बदनामी याद केर;</para>
  <para style="q" vid="PSA 89:50">अवं त सब ताकतबर कौमां केरो बोझ घिन्तां रहताईं।<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51" />तेरे तैन दुश्मनेईं त हे यहोवा,</para>
  <para style="q" vid="PSA 89:51">तेरे अभिषिक्ते पत्ती पेइतां तैसेरी बदनामी कियोरीए।<verse eid="PSA 89:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52" />यहोवा हमेशा धन रालो,</para>
  <para style="q" vid="PSA 89:52">आमीन, फिरी आमीन।<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">च़ेवरोवं हिस्सो</para>
  <para style="mr">
    <ref loc="PSA 90-106">भज. 90—106</ref></para>
  <para style="s">हमेशारो परमेशर ते नाश भोनेबालो मैन्हु</para>
  <para style="d">परमेशरेरे दास मूसेरी प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1" />हे प्रभु, तू पीढ़ी करां पीढ़ी तगर इश्शी रानेरी ठार राहोरोस।<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />एस करां पेइले कि पहाड़ां पैदा भोआं,</para>
  <para style="q" vid="PSA 90:2">ते तीं ज़मीन ते दुनिया बनाई,</para>
  <para style="q" vid="PSA 90:2">बल्के शुरू करां हमेशा तगर तूए परमेशरस।<verse eid="PSA 90:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />तू इन्साने फिरी मित्ती मां मिलातस,</para>
  <para style="q" vid="PSA 90:3">ते ज़ोतस, “हे मैन्हव, वापस एज्जा!”<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />किजोकि तेरी नज़री मां हज़ार साल एरे आन,</para>
  <para style="q" vid="PSA 90:4">ज़ेन्च़रे हीजेरी दिहाड़ी ज़ै बीती जेई,</para>
  <para style="q" vid="PSA 90:4">या रातरो अक पहर।<verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />तू इन्सानन हड़ैइअरो ज़ेरो रुड़ातस,</para>
  <para style="q" vid="PSA 90:5">तैना सुपनेरे ज़ेरे भोतन,</para>
  <para style="q" vid="PSA 90:5">तैना झ़ेझ़ेरे बेडोने बाले घासेरे ज़ेरे भोतन।<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />ज़ै झ़ेझ़ां लगते ते बेडोते,</para>
  <para style="q" vid="PSA 90:6">पन ड्लवझ़ी तगर ट्लेकतां शुक्‍की गाते।<verse eid="PSA 90:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />किजोकि असां तेरे क्रोधे सेइं नाश भोवरेम,</para>
  <para style="q" vid="PSA 90:7">ते तेरी सरकी करां डेरि जेवरेम।<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />तीं इश्शां बुरां कम्मां अपने सामने रखां,</para>
  <para style="q" vid="PSA 90:8">ते इश्शे छ़पोरे पाप अपने तुत्तरे अगर रखोरेन।<verse eid="PSA 90:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />किजोकि इश्शे सारे ज़िन्दगरे दिहाड़े तेरे क्रोधे मां बीती गातन,</para>
  <para style="q" vid="PSA 90:9">असां अपने साल शब्देरे ज़ेरे बीतातम।<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />इश्शी उमरारे साल 70 त भोतन,</para>
  <para style="q" vid="PSA 90:10">ते ताकतरे वजाई सेइं 80 भी भोइ गान,</para>
  <para style="q" vid="PSA 90:10">फिरी भी तैन केरू घमण्ड सिर्फ तकलीफ ते दुखे-दुखे;</para>
  <para style="q" vid="PSA 90:10">ते तैना लूशी गुज़री गातन, ते असां च़ले गातम।<verse eid="PSA 90:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />तेरे क्रोधेरी शक्ति?</para>
  <para style="q" vid="PSA 90:11">ते तेरे डरेरे काबल तेरी सरकी कौन सेमझ़ी सकते?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />असन अपने ज़िन्दगरे दिहाड़े गन्नेरी समझ़ दे, कि अस अक्लमन्द भोइ गाम।<verse eid="PSA 90:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />हे यहोवा, वापस एई! केइस तगर?</para>
  <para style="q" vid="PSA 90:13">ते अपने दासन पुड़ तरस खा!<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />झ़ेझ़ां असन एपनी दयाई सेइं भरपूर केर,</para>
  <para style="q" vid="PSA 90:14">कि असां ज़िन्दगी भर जयजयकार ते आनन्द केरते रहम।<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />ज़ेत्रे दिहाड़े तू असन दुख देतो एवरोस,</para>
  <para style="q" vid="PSA 90:15">ते ज़ेत्रे साल असां तकलीफ झ़ैलते एवरेम</para>
  <para style="q" vid="PSA 90:15">तेत्रे साल असन आनन्द दे।<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />तेरू कम तेरे दासन,</para>
  <para style="q" vid="PSA 90:16">ते तेरी महिमा तैन केरि औलादी पुड़ बांदी भोए।<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />इश्शे परमेशर यहोवारी कृपा असन पुड़ भोए,</para>
  <para style="q" vid="PSA 90:17">तू इश्शे हथ्थां केरू कम इश्शे लेई मज़बूत केर,</para>
  <para style="q" vid="PSA 90:17">इश्शे हथ्थां केरां कम्मां मज़बूत केर।<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">परमेशर इश्शी रक्षा केरनेबालोए</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />ज़ै परमप्रधान परमेशरेरी शरणी मां बिशोरो राए,</para>
  <para style="q" vid="PSA 91:1">तैस सर्वशक्तिमानेरी छावी मां ठिकानो मैल्हेलो।<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />अवं यहोवारे बारे मां ज़ोइलो, “तै मेरी छ़पनेरी ठारे ते मज़बूत गढ़े;</para>
  <para style="q" vid="PSA 91:2">तै मेरो परमेशरे, ज़ैस पुड़ अवं भरोसो रखताईं।”<verse eid="PSA 91:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />किजोकि तै मीं शिकार केरनेबालेरे जाले करां,</para>
  <para style="q" vid="PSA 91:3">ते महामैरी करां बच़ालो;<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />तै तीं अपने फंघन हैठ रखेलो,</para>
  <para style="q" vid="PSA 91:4">ते तीं तैसेरे फंघन हैठ शरण मैल्हेली;</para>
  <para style="q" vid="PSA 91:4">तैसेरी सच़्च़ाई तेरे लेई ढाल ते झिलम भोल्ही।<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />न तू रातरे कोन्ची डरे करां डरेलो,</para>
  <para style="q" vid="PSA 91:5">न तैस तीरे करां ज़ै दीसां च़लते,<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />न तैस मरी करां ज़ै आंधरे मां च़लतीए,</para>
  <para style="q" vid="PSA 91:6">ते न तैस महारोगे करां ज़ै भर दुपहरेईं उज़ाड़ते।<verse eid="PSA 91:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />तेरे नेड़े हज़ार,</para>
  <para style="q" vid="PSA 91:7">ते तेरे देइने पासे दश हज़ार बिछ़ड़तां मेरि गाले;</para>
  <para style="q" vid="PSA 91:7">पन तै तीं कां न एज्जेलो।<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />तू एपनी एछ़्छ़न सेइं नज़र केरेलो,</para>
  <para style="q" vid="PSA 91:8">ते दुष्टां केरो अन्त हेरेलो।<verse eid="PSA 91:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />हे यहोवा, तू मेरी छ़पनेरी ठारस।</para>
  <para style="q" vid="PSA 91:9">तीं ज़ै परमप्रधान अपने रानेरी ठार बनेवरीए,<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />एल्हेरेलेइ कोई आफत तीं पुड़ न पेली,</para>
  <para style="q" vid="PSA 91:10">न कोई दुख तेरे डेरेरे नेड़े एज्जेलो।<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />किजोकि तै अपने दूतन तेरे लेई हुक्म देलो,</para>
  <para style="q" vid="PSA 91:11">कि ज़ैड़ी भी तू गास तैना तेरी हिफाज़त केरन।<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />ते तैना स्वर्गदूत तीं अपने हथ्थन पुड़ छ़ूले,</para>
  <para style="q" vid="PSA 91:12">एरू न भोए कि तेरे पव्वन घोड़न सेइं ठोकर लग्गे।<verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />तू शेर ते सप्पे ढ्लेन्च़ेलो,</para>
  <para style="q" vid="PSA 91:13">तू जुवान शेरे ते अजगरे ढ्लेन्च़ेलो।<verse eid="PSA 91:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />तैने ज़ै मीं सेइं प्यार कियो, एल्हेरेलेइ अवं तैस छुटेइलो;</para>
  <para style="q" vid="PSA 91:14">अवं तैस उच्‍चे ठैरी पुड़ रखेलो, किजोकि तैने मेरू नवं ज़ानेरूए।<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />परमेशर ज़ोते, ज़ैखन तै मीं पुकारेलो, तैखन अवं तैसेरी शुनेलो;</para>
  <para style="q" vid="PSA 91:15">मुसीबती मां अवं तैस सेइं साथी रालो,</para>
  <para style="q" vid="PSA 91:15">अवं तैस छुटेइतां तैसेरी इज़्ज़त बधेइलो।<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />अवं तैस लम्मी उमर देइलो,</para>
  <para style="q" vid="PSA 91:16">ते तैस मुक्ति हरेइलो।<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">तारीफ़रू गीत</para>
  <para style="d">आरामेरे दिहैड़रे लेई भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1" />केत्रू रोड़ूए यहोवारू शुक्र केरनू,</para>
  <para style="q" vid="PSA 92:1">हे परमप्रधान परमेशर, तेरे नंव्वेरू भजन ज़ोनू;<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2" />झ़ेझ़ां तेरो प्यार,</para>
  <para style="q" vid="PSA 92:2">ते राती तेरी सच़्च़ैइअरो प्रचार केरनो,<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3" />दश तारीबाले बाज़े ते सैन्गी पुड़,</para>
  <para style="q" vid="PSA 92:3">ते सितारी पुड़ रोड़ो सूर लानो रोड़ोए।<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4" />किजोकि, हे यहोवा, तीं अवं अपने कम्मन सेइं खुश कियोरोईं;</para>
  <para style="q" vid="PSA 92:4">ते अवं तेरे हथ्थां केरे कम्मां केरे वजाई सेइं जयजयकार केरेलो।<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5" />हे यहोवा, तेरां कम्मां केत्रां बड्डां आन!</para>
  <para style="q" vid="PSA 92:5">ते तेरे खियाल केत्रे डुग्घे आन।<note caller="-" style="x"><char style="xo" closed="false">92:5 </char><char style="xt" closed="false"><ref loc="REV 15:3">प्रका. 15:3</ref>;<ref loc="ROM 11:33-34">रोम. 11:33-34</ref>.</char></note><verse eid="PSA 92:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6" />जानबरेरो ज़ेरो मैन्हु इस न समझ़े,</para>
  <para style="q" vid="PSA 92:6">ते बेवकूफ इसेरो खियाल न केरे:<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7" />कि दुष्ट ज़ैना घासेरे ज़ेरे हरे-भरे रहतन,</para>
  <para style="q" vid="PSA 92:7">ते सब अनर्थ केरनेबाले ज़ैना फुलतन-फलतन,</para>
  <para style="q" vid="PSA 92:7">एन एल्हेरेलेइ भोते, कि तैना सदारे लेई नाश भोइ गान।<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8" />पन हे यहोवा, तू हमेशा महान आस।<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9" />किजोकि हे यहोवा, तेरे दुश्मन, हाँ तेरे दुश्मन नाश भोल्हे;</para>
  <para style="q" vid="PSA 92:9">सब अनर्थ केरनेबाले तितर बितर भोल्हे।<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10" />पन तीं मेरू शिंग जंगली दांतेरू ज़ेरू उच्‍चु कियोरूए;<note caller="+" style="f"><char style="fr" closed="false">92:10 </char><char style="fq" closed="false">मेरू शिंग जंगली दांतेरू ज़ेरू उच्‍चु कियोरूए </char><char style="ft" closed="false">मतलब तीं अवं जंगली दांतेरो ज़ेरो मज़बूत बनाव।</char></note></para>
  <para style="q" vid="PSA 92:10">तीं ताज़े तेले सेइं मेरू अभिषेक कियोरूए।<verse eid="PSA 92:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11" />अपने-अपने दुश्मन्न पुड़ नज़र केरतां</para>
  <para style="q" vid="PSA 92:11">ते तैन कुकर्म केरनेबालां केरो हाल ज़ैना मेरे खलाफ उठते थी।<verse eid="PSA 92:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12" />धर्मी लोक खजूरेरे बुट्टेरे ज़ेरे खूब फलेले-फुलेले,</para>
  <para style="q" vid="PSA 92:12">तैना लबानोनेरे गैइड़ेरे ज़ेरे बेडोते राले।<verse eid="PSA 92:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13" />तैना यहोवारे भवने मां लेइतां,</para>
  <para style="q" vid="PSA 92:13">इश्शे परमेशरेरे अंगन्न मां फुलेले फलेले।<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14" />तैना पुराने भोने पुड़ भी फलेले,</para>
  <para style="q" vid="PSA 92:14">ते ताज़े ते हरे भरे भोल्हे,<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15" />ज़ैस सेइं इन बांदू भोए कि यहोवा सच़्च़ोए;</para>
  <para style="q" vid="PSA 92:15">तै मेरी चट्टाने, ते तैस मां बुराई किछ भी नईं।<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">परमेशरेरे राज़्ज़ेरी महिमा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />यहोवा राज़ोए; तै महिमारां लिगड़ां लेइतां आहे;</para>
  <para style="q" vid="PSA 93:1">यहोवा तियारे, ते शेक्तरो पटको बेन्धतां,</para>
  <para style="q" vid="PSA 93:1">इस वजाई सेइं दुनिया कायमे, तै हिल्‍ली न बटे।<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />हे यहोवा, तेरो तखत बड़े पेइले करां कायमे,</para>
  <para style="q" vid="PSA 93:2">तू हमेशा करां आस।<verse eid="PSA 93:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />हे यहोवा, दरिया गरज़ने लगोरेन,</para>
  <para style="q" vid="PSA 93:3">दरियां केरि बड़ी आवाज़ शुनोने लगोरीए,</para>
  <para style="q" vid="PSA 93:3">दरिया गरज़तन।<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />महा समुन्दरेरे आवाज़ी करां,</para>
  <para style="q" vid="PSA 93:4">ते समुन्दरेरी छ़ेलहन करां,</para>
  <para style="q" vid="PSA 93:4">तखते पुड़ बिशोरो यहोवा बड़ो महाने।<verse eid="PSA 93:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />तेरे कानून भरोसेरे काबलन;</para>
  <para style="q" vid="PSA 93:5">हे यहोवा, तेरे भवने जुगे-जुगेरी पवित्रता शोभा देतीए।<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">परमेशर धर्मी मैन्हेरे छ़पनेरी ठारे</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />हे यहोवा, हे बदलो घिन्ने बाले परमेशर,</para>
  <para style="q" vid="PSA 94:1">हे बदलो घिन्ने बाले परमेशर, अपनि लौ चमका।<note caller="-" style="x"><char style="xo" closed="false">94:1 </char><char style="xt" closed="false"><ref loc="DEU 32:35">व्यव. 32:35</ref>.</char></note><verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />हे धेरतरे न्याय केरनेबालां, उठ;</para>
  <para style="q" vid="PSA 94:2">ते घमण्डी लोकन बदलो दे!<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />हे यहोवा, दुष्ट लोक केइस तगर,</para>
  <para style="q" vid="PSA 94:3">दुष्ट लोक केइस तगर बड़कां मारते राले?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />तैना बकतन ते बेड्डी गल्‍लां केरतन,</para>
  <para style="q" vid="PSA 94:4">सारे अनर्थ केरनेबाले घमण्ड केरतन।<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />हे यहोवा, तैना तेरे लोकन ढ्लेन्च़ी छ़डतन,</para>
  <para style="q" vid="PSA 94:5">ते तेरी विरासती दुख देतन।<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />तैना विधवा ते परदेशी लोकन मारतन,</para>
  <para style="q" vid="PSA 94:6">ते अनाथन मारतन;<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />ते तैना ज़ोतन, “यहोवा न हेरेलो,</para>
  <para style="q" vid="PSA 94:7">याकूबेरो परमेशर खियाल न केरेलो।”<verse eid="PSA 94:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />तुस लोक ज़ैना जानबरां केरे ज़ेरेथ, खियाल केरा;</para>
  <para style="q" vid="PSA 94:8">हे बेवकूफव, तुस केइस समझ़दार बनेले?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />ज़ैनी कन दित्तोरोए, कुन तै एप्पु न शुने?</para>
  <para style="q" vid="PSA 94:9">ते ज़ैनी अछ़ बनाई, कुन तै एप्पु न लाहे?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />ज़ै एक्‍की-एक्‍की कौमी झ़िड़क देते, ते इन्साने ज्ञान शिखालते,</para>
  <para style="q" vid="PSA 94:10">कुन तै न सुधारेलो?<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />यहोवा मैन्हेरे खियाल त ज़ानते कि तैना बेफैइदेन<verse eid="PSA 94:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />हे यहोवा, केत्रो धने तै मड़दे ज़ैस तू झ़िड़क देतस,</para>
  <para style="q" vid="PSA 94:12">ते अपनो कानून शिखालतस,<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />किजोकि तू तैस आफतरे दिहाड़न मां तैस वक्ते तगर चैन देतो राव,</para>
  <para style="q" vid="PSA 94:13">ज़ांतगर दुष्टां केरे लेई खड्डो तियार न भोए।<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />किजोकि यहोवा अपने लोकन रद न केरेलो,</para>
  <para style="q" vid="PSA 94:14">तै एपनी विरासती न शारेलो।<verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />पन न्याय धार्मिकतारे मुताबिक कियो गालो,</para>
  <para style="q" vid="PSA 94:15">ते सारे सिद्धे मने बाले तैस पत्ती-पत्ती भोल्हे।<verse eid="PSA 94:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />कुकर्म केरनेबालां केरे खलाफ मेरे लेई कौन खड़ो भोल्हो?</para>
  <para style="q" vid="PSA 94:16">मेरे तरफां अनर्थ केरनेबालां केरो कौन सामनो केरेलो?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />अगर यहोवा मेरी मद्दत केरनेबालो न भोथो,</para>
  <para style="q" vid="PSA 94:17">त अवं एक्‍की सैइती मां मेरि जेवरो भोथो।<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />ज़ैखन मीं ज़ोवं, “मेरो पव झिशकने लगोरोए”</para>
  <para style="q" vid="PSA 94:18">तैखन हे यहोवा, तेरे प्यारे मीं सहारो दित्तो।<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />ज़ैखन मेरे मने मां बड़ी फिक्र भोतीए,</para>
  <para style="q" vid="PSA 94:19">तैखन हे यहोवा, तेरी दित्तोरी शैन्ति सेइं मीं सुख भोते।<verse eid="PSA 94:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />कुन तेरे ते दुष्टां केरे तखतेरे दरमियान समझोतो भोल्हो,</para>
  <para style="q" vid="PSA 94:20">ज़ैन कानूनेरी आड़ी मां झगड़ो मच़ातन?<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />तैना धेर्मेरे प्राण नेनेरे लेई अकोट्ठे भोतन,</para>
  <para style="q" vid="PSA 94:21">ते बेकसूरे मौतरी सज़ाह देतन।<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />पन यहोवा मेरो गढ़े,</para>
  <para style="q" vid="PSA 94:22">ते मेरो परमेशर मेरी छ़पनेरी चट्टान भोवरोए।<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />परमेशर तैन केरू अनर्थ कम तैन्ने पुड़ वापस आनोरूए,</para>
  <para style="q" vid="PSA 94:23">ते तै तैन, तैन केरि बुरैइारे ज़िरिये नाश केरेलो।</para>
  <para style="q" vid="PSA 94:23">इश्शो परमेशर यहोवा तैन नाश केरेलो।<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">तारीफ़रू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />एज्जा असां यहोवारे लेई उच्‍चे आवाज़ी सेइं गीत ज़ोम,</para>
  <para style="q" vid="PSA 95:1">अपने मुक्तरे चट्टानरू<note caller="+" style="f"><char style="fr" closed="false">95:1 </char><char style="fq" closed="false">मुक्तरे चट्टानरू </char><char style="ft" closed="false">परमेशर</char></note> जयजयकार केरम!<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />असां शुक्र केरते तैसेरे सामने एज्जम,</para>
  <para style="q" vid="PSA 95:2">ते भजन ज़ोइतां तैसेरू जयजयकार केरम।<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />किजोकि यहोवा महान परमेशरे,</para>
  <para style="q" vid="PSA 95:3">ते सेभी देबतन करां महान राज़ोए।<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />धेरतरी डुग्घी ठारां भी यहोवारे हथ्थे मां आन;</para>
  <para style="q" vid="PSA 95:4">ते पहाड़ां केरि च़ोटां भी तैसेरी आन।<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />समुन्दर भी तैसेरो आहे, ते तैने तै बनावरोए,</para>
  <para style="q" vid="PSA 95:5">ते शुक्‍कोरी ठार तैने हथ्थे सेइं बनेवरीए।<verse eid="PSA 95:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />एज्जा असां तैस कां मथ्थो टेकम,</para>
  <para style="q" vid="PSA 95:6">ते अपने बनानेबाले यहोवारे सामने ज़ैधू टेकम।<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />किजोकि तैए इश्शो परमेशरे,</para>
  <para style="q" vid="PSA 95:7">ते असां तैसेरी चरागारे लोक</para>
  <para style="q" vid="PSA 95:7">ते तैसेरे हथ्थेरी भैड्डां अहम।</para>
  <para style="q" vid="PSA 95:7">भलू भोथू, कि अज़ तुस तैसेरी शुनथ!<verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />त अपने-अपने दिल एरे सखत न केरा, ज़ेन्च़रे मरीबा<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">मरीबा </char><char style="ft" closed="false">मतलब झगड़ो</char></note> मां</para>
  <para style="q" vid="PSA 95:8">ते मस्सारे रेगिस्ताने<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">मस्सा </char><char style="ft" closed="false">मतलब अज़मैइश</char></note> मां भोवरे थिये,<verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />ज़ैड़ी तुश्शे दादे पड़दादेईं अवं अज़मव,</para>
  <para style="q" vid="PSA 95:9">तैनेईं अवं परखो ते मेरां कम्मां भी हेरां।<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />च़ैली सालन तगर अवं तैस पीढ़रे लोकन सेइं रुशोरो राव,</para>
  <para style="q" vid="PSA 95:10">ते मीं ज़ोवं, “इना त टपलानेबाले मनेरेन,</para>
  <para style="q" vid="PSA 95:10">ते तैनेईं मेरी बत्तां न पिशैनी।”<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />एल्हेरेलेइ मीं सेरकोइतां कसम खाइ कि</para>
  <para style="q" vid="PSA 95:11">एना मेरे आरामेरे ठैरी मां कधे दाखल न भोइ सकेले।<note caller="-" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="HEB 3:7-19">इब्रा. 3:7-19</ref>;<ref loc="NUM 14:33-34">गिन. 14:33-34</ref>.</char></note><verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">परमेशर सेभन करां महान राज़ोए</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />यहोवारे लेई अक नंव्वू गीत ज़ोथ,</para>
  <para style="q" vid="PSA 96:1">हे सारे दुनियारे लोकव यहोवारे लेई गीत ज़ोथ।<note caller="-" style="x"><char style="xo" closed="false">96:1 </char><char style="xt" closed="false"><ref loc="REV 5:9">प्रका. 5:9</ref>;<ref loc="PSA 33:3">भज. 33:3</ref>.</char></note><verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />यहोवारे लेई गीत ज़ोथ, तैसेरे नव्वें जो धन ज़ोथ;</para>
  <para style="q" vid="PSA 96:2">रोज़ तैसेरे दित्तोरे मुक्तरी रोड़ी खबर शुनाते राथ।<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />गैर कौमन मां यहोवारे महिमारू,</para>
  <para style="q" vid="PSA 96:3">ते मुल्खां-मुल्खां केरे लोकन मां तैसेरे चमत्कारां केरू बियान केरा।<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />किजोकि यहोवा महान ते बड़े तारीफ़रे काबले;</para>
  <para style="q" vid="PSA 96:4">तै त सैरी देबतन करां जादे डरेरे काबले।<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />किजोकि मुल्खां-मुल्खां केरे सब देबते त सिर्फ मूरती आन,</para>
  <para style="q" vid="PSA 96:5">पन यहोवाए सुर्ग बनावरूए।<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />तैसेरे च़ेवरे पासन शान-ओ-शोकते ते महिमा आहे;</para>
  <para style="q" vid="PSA 96:6">ते तैसेरी पवित्र ठैरी सामर्थ ते शोभाए।<verse eid="PSA 96:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />हे मुल्खां-मुल्खां केरे कुलां केरे लोकव, यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 96:7">यहोवारी महिमा ते सामर्थ मन्ना!<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />यहोवारे नंव्वेरी एरी महिमा केरा ज़ै तैसेरे काबले;</para>
  <para style="q" vid="PSA 96:8">च़ढ़तल नेइतां तैसेरे अंगन्न मां गाथ।<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />पवित्रतैई सेइं सेज़तां यहोवा कां मथ्थो टेका;</para>
  <para style="q" vid="PSA 96:9">हे सारे दुनियारे लोकव, तैसेरे सामने थरकते राथ।<verse eid="PSA 96:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />कौमन मां एलान केरा, “यहोवा राज़ोए!</para>
  <para style="q" vid="PSA 96:10">ते दुनिया एरी कायमे, कि तै हिलनेरी नईं;</para>
  <para style="q" vid="PSA 96:10">तै मुल्खां-मुल्खां केरे लोकां केरो न्याय सच़्च़ैई सेइं केरेलो।”<verse eid="PSA 96:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />अम्बर खुशी भोए, ते ज़मीन मघन भोए,</para>
  <para style="q" vid="PSA 96:11">समुन्दर ते तैस मां ज़ैना भी चीज़ां आन गरज़न।<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />मैइदान ते ज़ैन किछ तैस मांए, खुश भोए;</para>
  <para style="q" vid="PSA 96:12">ते फिरी जंगलेरे बुट जयजयकार केरेले।<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />इन यहोवारे सामने भोए, किजोकि तै एजनेबालोए।</para>
  <para style="q" vid="PSA 96:13">तै धेरतरो न्याय केरनेबालोए, तै धार्मिकता सेइं दुनियारो</para>
  <para style="q" vid="PSA 96:13">ते सच़्च़ाई सेइं मुल्खां-मुल्खां केरे लोकां केरो न्याय केरेलो।<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">परमेशर सेभन करां महान हुकूमत केरनेबालोए</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />यहोवा राज़ केरते, धरती मघन भोए;</para>
  <para style="q" vid="PSA 97:1">ते जज़ीरे ज़ैना बड़े आन, तैना भी आनन्द मनान!<verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />बिदलार ते आंधरू तैसेरे च़ेवरे पासने</para>
  <para style="q" vid="PSA 97:2">तैसेरे तखतेरी बुनीयाद धार्मिकता ते न्याये।<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />अग तैसेरे अग्री-अग्री च़लती</para>
  <para style="q" vid="PSA 97:3">तैसेरे दुश्मन्न च़ेवरे पासना भस्म केरतीए।<verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />तैसेरे अम्बर झ़पने सेइं दुनिया रौशन भोइ,</para>
  <para style="q" vid="PSA 97:4">धरती हेरतां थेरकी जेई!<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />पहाड़ यहोवारे सामने,</para>
  <para style="q" vid="PSA 97:5">मोमेरे ज़ेरे गेली जे,</para>
  <para style="q" vid="PSA 97:5">मतलब सारे धेरतरे परमेशरेरे सामने।<verse eid="PSA 97:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />अम्बरे तैसेरे धर्मेरू एलान कियूं;</para>
  <para style="q" vid="PSA 97:6">ते मुल्खां-मुल्खां केरे सारे लोकेईं तैसेरी महिमा लाहोरीए।<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />ज़ेत्रे बनेवरी मूरती केरि पूज़ा केरतन</para>
  <para style="q" vid="PSA 97:7">ते मूरतन पुड़ घमण्ड केरतन, तैना शरमिन्दा भोन;</para>
  <para style="q" vid="PSA 97:7">हे सब देबतव तुस तैस्से कां मथ्थो टेका।<verse eid="PSA 97:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />सिय्योन शुन्तां खुशी भोए,</para>
  <para style="q" vid="PSA 97:8">हे यहूदारी कुइयां मघन भोइ;</para>
  <para style="q" vid="PSA 97:8">हे यहोवा, इन तेरे नियमां केरे वजाई सेइं भोवं।<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />किजोकि हे यहोवा, तू सारी धेरती पुड़ परमप्रधानस;</para>
  <para style="q" vid="PSA 97:9">तू सारे देबतन करां जादे महान ठहरोरोस।<note caller="-" style="x"><char style="xo" closed="false">97:9 </char><char style="xt" closed="false"><ref loc="JHN 3:31">यूह. 3:31</ref>.</char></note><verse eid="PSA 97:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />हे यहोवा सेइं प्यार केरनेबालव, बुरैई सेइं नफरत केरा;</para>
  <para style="q" vid="PSA 97:10">तै अपने भक्तां केरे प्राणां केरि हिफाज़त केरते,</para>
  <para style="q" vid="PSA 97:10">ते तैन दुष्टां केरे हथ्थे करां बच़ाते।<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />धेर्मेरे लेई लौ,</para>
  <para style="q" vid="PSA 97:11">ते सिद्धे मने बालां केरे लेई आनन्द बेव गाते।<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />हे धर्मी लोकव, यहोवारे वजाई सेइं आनन्द केरा;</para>
  <para style="q" vid="PSA 97:12">ते ज़ैस पवित्र नंव्वे सेइं तैसेरी याद भोतीए, तैसेरू शुक्र केरा!<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">मुक्ति ते न्यायेरे लेई तारीफ़रू गीत</para>
  <para style="d">भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1" />यहोवारे लेई अक नंव्वू गीत ज़ोथ,</para>
  <para style="q" vid="PSA 98:1">किजोकि तैनी चमत्कार कियोरेन!</para>
  <para style="q" vid="PSA 98:1">तैसेरे देइने हथ्थे ते पवित्र पाखड़ां तैस ज़ींत दित्तोरीए।<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />यहोवा दित्तोरी मुक्ति बांदी की,</para>
  <para style="q" vid="PSA 98:2">तैने गैर कौमां केरे नज़री मां अपनि धार्मिकता बांदी की।<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />तैनी इस्राएली लोकन पुड़ अपनो प्यार</para>
  <para style="q" vid="PSA 98:3">ते सच़्च़ैइअरी खबर नी,</para>
  <para style="q" vid="PSA 98:3">ते धेरतरे सब दूर-दूरेरे मुल्खेईं इश्शे परमेशरेरी दित्तोरी मुक्ति लाहोरीए।<verse eid="PSA 98:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />हे सारे दुनियारे लोकव, यहोवारू जयजयकार केरा;</para>
  <para style="q" vid="PSA 98:4">जोशे सेइं जयजयकार केरा, ते भजन ज़ोथ!<verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />सितार बज़ेइतां यहोवारू भजन ज़ोथ,</para>
  <para style="q" vid="PSA 98:5">सैन्गी बज़ेइतां भजनेरो सुर बज़ाथ।<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />तुरही ते नरशिंगे बज़ेइतां</para>
  <para style="q" vid="PSA 98:6">यहोवा राज़ेरू जयजयकार केरा।<verse eid="PSA 98:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />समुन्दर ते ज़ैन किछ तैस मांए सब गरज़न;</para>
  <para style="q" vid="PSA 98:7">दुनिया ते तैस मां रानेबाले उच्‍ची आवाज़ी सेइं ज़ोन!<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />दरिया च़ैड़ी बज़ान;</para>
  <para style="q" vid="PSA 98:8">ते पहाड़ां मिलतां जयजयकार केरन।<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />इन यहोवारे सामने भोए, किजोकि तै धेरतरो न्याय केरनेरे लेई एजनेबालोए,</para>
  <para style="q" vid="PSA 98:9">तै धार्मिकताई सेइं दुनियारो,</para>
  <para style="q" vid="PSA 98:9">ते सच़्च़ैई सेइं मुल्खे-मुल्खेरे लोकां केरो न्याय केरेलो।<note caller="-" style="x"><char style="xo" closed="false">98:9 </char><char style="xt" closed="false"><ref loc="ACT 17:31">प्रेरित. 17:31</ref>.</char></note><verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">पवित्र भोनेरे लेई तारीफ़रू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />यहोवा राज़ोए, ते मुल्खां-मुल्खां केरे लोक थरकन!</para>
  <para style="q" vid="PSA 99:1">तै करूबन पुड़ बिशोरोए; धरती हिल्‍ली जेई!<verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />यहोवा सिय्योने मां महाने;</para>
  <para style="q" vid="PSA 99:2">ते तै मुल्खां-मुल्खां केरे लोकन पुड़ प्रधाने।<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />सारे लोक तेरे महान ते डरेरे काबल नंव्वेरू शुक्र केरन!</para>
  <para style="q" vid="PSA 99:3">तै त पवित्रे।<verse eid="PSA 99:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />राज़ेरी शक्ति<note caller="+" style="f"><char style="fr" closed="false">99:4 </char><char style="fq" closed="false">राज़ेरी शक्ति </char><char style="ft" closed="false">राज़ेरो मतलब इड़ी यहोवाए।</char></note> न्याय सेइं मेल रखतीए,</para>
  <para style="q" vid="PSA 99:4">तींए सच़्च़ाई कायम की;</para>
  <para style="q" vid="PSA 99:4">न्याय ते धार्मिकता याकूबे मां तींए लागू की।<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />इश्शे परमेशर यहोवारी बडीयाई केरा;</para>
  <para style="q" vid="PSA 99:5">ते तैसेरी पव्वां केरि चेवकरे सामने मथ्थो टेका!</para>
  <para style="q" vid="PSA 99:5">तै पवित्रे!<verse eid="PSA 99:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />तैसेरे याजकन मरां मूसा ते हारून,</para>
  <para style="q" vid="PSA 99:6">ते तैन केरे प्राथना केरनेबालन मरां शमूएल थियो ज़ैना यहोवा पुकारते थिये, ते तै तैन केरि शुनतो थियो।<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />तै बिदलारारे खम्भे मरां तैन सेइं गल्‍लां केरतो थियो;</para>
  <para style="q" vid="PSA 99:7">ते तैना तैस कानूनेरे ते तैसेरी दित्तोरी विधन पुड़ च़लते थिये।<verse eid="PSA 99:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />हे इश्शे परमेशर यहोवा, तू तैन केरि शुनतो थियो;</para>
  <para style="q" vid="PSA 99:8">तू तैन केरे कम्मां केरो बदलो त नेतो थियो,</para>
  <para style="q" vid="PSA 99:8">फिरी भी तैन केरे लेई माफ़ केरनेबालो परमेशर थियो।<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />इश्शे परमेशर यहोवारी बडीयाई केरा,</para>
  <para style="q" vid="PSA 99:9">ते तैसेरे पवित्र पहाड़े पुड़ मथ्थो टेका;</para>
  <para style="q" vid="PSA 99:9">किजोकि इश्शो परमेशर यहोवा पवित्रे!<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">परमेशरेरे तारीफ़रू गीत</para>
  <para style="d">शुक्रेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1" />हे सारी दुनियारे लोकव, यहोवारू जयजयकार केरा!<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />खुशी सेइं यहोवारी आराधना केरा,</para>
  <para style="q" vid="PSA 100:2">जयजयकार केरतां तैसेरे सामने एज्जा।<verse eid="PSA 100:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />ई गल पक्‍की ज़ाना कि यहोवा ही परमेशरे,</para>
  <para style="q" vid="PSA 100:3">तैन्नी असां बनेवरेम, ते असां तैसेरे अहम;</para>
  <para style="q" vid="PSA 100:3">अस तैसेरे लोक, ते तैसेरे ड्लबड़ां केरि भैड्डां अहम।<verse eid="PSA 100:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />शुक्र केरते तैसेरे फाटकन मां दाखल भोथ,</para>
  <para style="q" vid="PSA 100:4">ते तैसेरे अंगन्न मां तारीफ़ केरते दाखल भोथ,</para>
  <para style="q" vid="PSA 100:4">तैसेरू शुक्र केरा, ते तैसेरे नंव्वे जो धन ज़ोथ!<verse eid="PSA 100:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />किजोकि यहोवा भलोए, तैसेरी दया हमेशारे लेई आहे,</para>
  <para style="q" vid="PSA 100:5">ते तैसेरी सच़्च़ाई पीढ़ी करां पीढ़ी तगर रहचे।<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">वफादार ज़िन्दगी बीतानेरो फैसलो</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1" />अवं प्यार ते सच़्च़ेरू गीत ज़ोइलो;</para>
  <para style="q" vid="PSA 101:1">हे यहोवा अवं सिर्फ तेरू भजन ज़ोइलो।<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />अवं अक्ली सेइं सही बत्तां च़लेलो।</para>
  <para style="q" vid="PSA 101:2">तू मीं कां किताली एज्जेलो?</para>
  <para style="q" vid="PSA 101:2">अपने घरे मां मेरो चाल चलन सच़्च़े दिले सेइं भोल्हो।<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />अवं बुरे गल्‍ली पुड़ अपनो मन न लेइलो।</para>
  <para style="q" vid="PSA 101:3">अवं बुरी बत्तां च़लनेबालां केरे कम्मन सेइं नफरत केरताईं;</para>
  <para style="q" vid="PSA 101:3">एरां कम्मां अवं न केरेलो।<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />झूठो दिल मीं करां दूर राए,</para>
  <para style="q" vid="PSA 101:4">अवं बुरैई करां अनज़ान रेइलो।<verse eid="PSA 101:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />ज़ै छ़ेपतां अपने पड़ोसेरी चोगली लाते,</para>
  <para style="q" vid="PSA 101:5">तैसेरो अवं नाश केरेलो।</para>
  <para style="q" vid="PSA 101:5">ज़ेसेरी एछ़्छ़ी च़ैढ़ोरी भोन ते ज़ेसेरो मन घमण्डीए तैसेरी अवं न झ़ैलेलो।<verse eid="PSA 101:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />मेरी एछ़्छ़ी मुल्खे मां वफादार लोकन पुड़ लेगोरी रहेली ताके तैना मीं सेइं साथी रान,</para>
  <para style="q" vid="PSA 101:6">ज़ै सही बत्तां च़लते, तैए मेरो सेवके।<verse eid="PSA 101:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />ज़ै धोखो केरते, तै मेरे घरे मां न रेइ बटेलो,</para>
  <para style="q" vid="PSA 101:7">ज़ै झूठ ज़ोते ते मेरे सामने खड़ो न रेइ बटे।<verse eid="PSA 101:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />रोज़ झ़ेझ़ां अवं मुल्खेरे दुष्टां केरो नाश केरेलो,</para>
  <para style="q" vid="PSA 101:8">ताके यहोवारे नगरेरे<note caller="+" style="f"><char style="fr" closed="false">101:8 </char><char style="fq" closed="false">यहोवारे नगरेरे </char><char style="ft" closed="false">यरूशलेम</char></note> सब अनर्थ केरनेबालन नाश केरेलो।<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">अक जुवान मुसीबती मां प्राथना केरते</para>
  <para style="d">एक्‍की दुखी मैन्हेरी प्राथना ज़ैने एपनी शिकायतां यहोवा परमेशरेरे सामने रेखी</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1" />हे यहोवा मेरी प्राथना शुन;</para>
  <para style="q" vid="PSA 102:1">मेरी मद्दतरे लेई बिनती तीं तगर पुज़्ज़े।<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2" />ज़ैखन अवं मुसीबती मां भोईं अपनु तुत्तर मीं करां न छ़ुपा,</para>
  <para style="q" vid="PSA 102:2">अपनो कन मेरे पासे ला;</para>
  <para style="q" vid="PSA 102:2">ज़ैखन अवं बिनती केरी, तैस वक्ते जल्दी केर!<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3" />किजोकि मेरे ज़िन्दगरे दिहाड़े तूंएरे ज़ेरे छ़ेप्पी गातन,</para>
  <para style="q" vid="PSA 102:3">मेरी हेड्डी अग्गरी ज़ेरि फुकोई जेई।<verse eid="PSA 102:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4" />मेरो दिल घासेरे ज़ेरो शुक्‍की जेव;</para>
  <para style="q" vid="PSA 102:4">ते अवं रोट्टी खानी भी बिसरताईं<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5" />करलाते-करलाते चमड़ी हेड्डन सेइं ज़ुड़ी जेई।<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6" />अवं जंगलेरे बुल्‍लेरो ज़ेरो भोइ जेवरोईं,</para>
  <para style="q" vid="PSA 102:6">घरेण्डे मां निकड़े बुल्‍लेरो ज़ेरोईं।<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7" />अवं बिछ़ाने मां बींझ़ो रहताईं,</para>
  <para style="q" vid="PSA 102:7">ते लाए पुड़ अकैल्‍लो च़ुड़ोलवेरो ज़ेरोईं।<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8" />मेरे दुश्मन लगातार मेरी बदनामी केरतन,</para>
  <para style="q" vid="PSA 102:8">ज़ैना मेरो मज़ाक बनातन,</para>
  <para style="q" vid="PSA 102:8">तैना मेरू नवं घिन्तां होरन जो लान तान केरतन।<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9" />मीं रोट्टरी ज़ेरि मांज़न खाइ, ते ऐंखरू मिलेइतां पानी पीवं।<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10" />इन तेरे क्रोध ते सरकरे वजाई सेइं भोवं,</para>
  <para style="q" vid="PSA 102:10">किजोकि तीं अवं खड़ो कियो, ते फिरी बिछ़ोड़ो।<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11" />मेरे ज़िन्दगरे दिहाड़े ड्लवझ़रे मौके दिहाड़ी डुबनेरे ज़ेरेन;</para>
  <para style="q" vid="PSA 102:11">अवं घासेरो ज़ेरो शुकने लगोरोइं।<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12" />पन तू हे यहोवा, तू हमेशा तखते पुड़ रालो,</para>
  <para style="q" vid="PSA 102:12">ज़ैस नंव्वे सेइं तेरी याद भोतीए,</para>
  <para style="q" vid="PSA 102:12">तैन पीढ़ी करां पीढ़ी तगर बनोरू रालू।<verse eid="PSA 102:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13" />तू खड़े भोइतां सिय्योने पुड़ दया केरेलो।</para>
  <para style="q" vid="PSA 102:13">किजोकि तैस पुड़ दया केरनेरो रखोरो वक्त एवरोए।<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14" />एल्हेरेलेइ कि तेरे दास तैसेरे घोड़न चातन,</para>
  <para style="q" vid="PSA 102:14">ते तैसेरां घरैंड़ां केरि धूड़ी पुड़ दया केरतन।<verse eid="PSA 102:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15" />एल्हेरेलेइ कौमां-कौमां केरे लोक यहोवारे नंव्वेरो डर मन्नेले,</para>
  <para style="q" vid="PSA 102:15">ते दुनियारे सारे राज़े तेरी महिमारो डर मन्नेले।<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16" />किजोकि यहोवा सिय्योने फिरी आबाद केरेलो,</para>
  <para style="q" vid="PSA 102:16">ते तै एपनी महिमाई सेइं फिरी बांदो भोल्हो।<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17" />गरीबां केरि प्राथना पुड़ तै ध्यान देते,</para>
  <para style="q" vid="PSA 102:17">ते तैन केरि प्राथना घटिया न ज़ाने।<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18" />इना गल्‍लां एजने बैली पीढ़रे लेई लिखी गैली,</para>
  <para style="q" vid="PSA 102:18">ताके ज़ै कौम पैदा भोल्ही, तै यहोवारी तारीफ़ केरे।<verse eid="PSA 102:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19" />किजोकि यहोवा अपने उच्‍चे ते पवित्र ठारी पुड़ेरां तक्‍कू,</para>
  <para style="q" vid="PSA 102:19">तैनी सुर्गे पुड़ेरां ज़मीनी पुड़ नज़र दित्तोरीए।<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20" />ताके कैदी केरू करलानू शुने,</para>
  <para style="q" vid="PSA 102:20">ते मरने बालां केरि बेड़ी खोल्‍ली।<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21" />तैखन लोक सिय्योने मां यहोवारे नंव्वेरू बियान केरेले,</para>
  <para style="q" vid="PSA 102:21">ते यरूशलेमे मां भी तैसेरी तारीफ़ की गाली;<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22" />इन तैस वक्ते भोल्हु ज़ैखन लोक मुल्खे-मुल्खे,</para>
  <para style="q" vid="PSA 102:22">ते रियासतां-रियासतां केरे लोक यहोवारी आराधना केरनेरे लेई अकोट्ठे भोल्हे।<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23" />यहोवा मेरी ज़िन्दगरे सफरे मां दुख देइतां</para>
  <para style="q" vid="PSA 102:23">मेरी ताकत ते उमर घिटेवरीए।<verse eid="PSA 102:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24" />मीं ज़ोवं, “हे मेरे परमेशर, मीं एध्धी उमरी मां न सलाह,</para>
  <para style="q" vid="PSA 102:24">ते साल पीढ़ी-पीढ़ी तगर राले!”<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25" />शुरू मां धेरतरी बुनीयाद रख्खी;</para>
  <para style="q" vid="PSA 102:25">ते तीं अपने हथ्थेइं सेइं अम्बर बनावं।<verse eid="PSA 102:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26" />धरती ते अम्बर त तबाह भोइ गालू, पन तू सदा कायम रालो;</para>
  <para style="q" vid="PSA 102:26">एन सब लिगड़ेरू ज़ेरू पुरानू भोइ गालू,</para>
  <para style="q" vid="PSA 102:26">तू तैस लिगड़ेरो ज़ेरो बदलेलो, ते तैन मिटी गालू।<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27" />पन तू तैड़ी आस,</para>
  <para style="q" vid="PSA 102:27">ते तेरे साल कधे खतम न भोल्हे।<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28" />इश्शे बच्‍चे तेरे दास तेरे हज़ूरी मां बस्सोरे राले,</para>
  <para style="q" vid="PSA 102:28">ते तैन केरि औलाद तेरे सामने कायम राली।<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">परमेशरेरे दयारे लेई तारीफ़रू गीत</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1" />हे मेरे मन यहोवारी तारीफ़ केर;</para>
  <para style="q" vid="PSA 103:1">ते ज़ैन किछ मीं मांए, तैसेरे पवित्र नंव्वेरी तारीफ़ केर।<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />हे मेरे मन, यहोवारी तारीफ़ केर,</para>
  <para style="q" vid="PSA 103:2">ते ज़ैन किछ तैने तेरे लेई कियूं तैस न बिस्सर।<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />किजोकि तैए तेरे सारे पाप माफ़ केरते,</para>
  <para style="q" vid="PSA 103:3">तै तेरी सैरी बिमैरन बझ़ाते।<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />तैए तेरी जानी नाश भोने करां बच़ाते,</para>
  <para style="q" vid="PSA 103:4">ते तेरे दोग्गे पुड़ प्यार ते दयारू ताज लाते।<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />तै तेरी ज़िन्दगी रोड़ी-रोड़ी चीज़ां देइतां भरपूर केरते,</para>
  <para style="q" vid="PSA 103:5">ते ज़ैस सेइं तेरी जुवानी उकाबेरी ज़ेरि नंव्वी भोतीए।<verse eid="PSA 103:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />यहोवा सेभी पस्त भोवरां केरे लेई</para>
  <para style="q" vid="PSA 103:6">धर्म ते न्यायेरां कम्मां केरते।<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />तैनी अपनि बत मूसे,</para>
  <para style="q" vid="PSA 103:7">ते इस्राएली लोकन पुड़ अपना कम्मां बांदां कियां।<verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />यहोवा दया केरनेबालो, अनुग्रह केरनेबालो, क्रोधे केरने मां च़िर लानेबालो ते बड़ो प्यार केरनेबालोए।<verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />न तै हमेशा कोन्ची हदैइत केरतो रालो,</para>
  <para style="q" vid="PSA 103:9">ते न आखरी तगर नाराज़ रालो।<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />तैने असन सेइं इश्शे पापां केरे मुताबिक बर्ताव न कियो,</para>
  <para style="q" vid="PSA 103:10">न इश्शे पापेरे कम्मां केरे मुताबिक असन बदलो दित्तोरोए।<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />ज़ेन्च़रे अम्बर धेरती करां उच्‍चु आहे,</para>
  <para style="q" vid="PSA 103:11">तेन्च़रे तैसेरो प्यार तैन पुड़े, ज़ैना तैसेरो डर मनतन।<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />ज़ेत्रो दिहाड़ो निसनेरो पासो दिहाड़ो डुबनेरे पासेरे करां दूर आहे,</para>
  <para style="q" vid="PSA 103:12">तैने इश्शे पाप असन करां तेत्रे दूर कियोरेन।<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />ज़ेन्च़रे बाजी अपने बच्‍चन पुड़ तरस खाते,</para>
  <para style="q" vid="PSA 103:13">तेन्च़रे यहोवा तैन पुड़ तरस खाते, ज़ैना तैसेरो डर मनतन।<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />किजोकि तै इश्शी सृष्टि ज़ानते,</para>
  <para style="q" vid="PSA 103:14">ते तै तैस याद रखते कि मैन्हु मित्तीए।<verse eid="PSA 103:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />इन्सानेरी उमर घासेरे ज़ेरि भोतीए,</para>
  <para style="q" vid="PSA 103:15">ते तै जंगली फूड़ोवेंरो ज़ेरो फुलते।<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />ज़ैखन तैस पुड़ हवा पेचे त तैन तैड़ी न राए,</para>
  <para style="q" vid="PSA 103:16">न तैड़ी तैसेरी ठार पिशैनोए।<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />पन यहोवारो प्यार तैसेरो डर मन्ने बालन पुड़ जुगे-जुगे,</para>
  <para style="q" vid="PSA 103:17">ते तैसेरी धार्मिकता पोट्लड़न धिहोड़न पुड़ भी बांदी भोती राली,<verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />मतलब तैन पुड़ ज़ैना तैसेरे करारे मनतन</para>
  <para style="q" vid="PSA 103:18">ते तैसेरे उपदेशन याद केरतां तैन पुड़ च़लतन।<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />यहोवा परमेशरे त अपनो तखत सुर्गे पुड़ कायम कियोरोए,</para>
  <para style="q" vid="PSA 103:19">ते तैसेरू राज़ पूरी सृष्टि पुड़े।<verse eid="PSA 103:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />हे यहोवारे दूतव, तुस ज़ैना शेक्ति बालेथ,</para>
  <para style="q" vid="PSA 103:20">ते तैसेरे वचने मन्ते ते पूरे केरतथ।</para>
  <para style="q" vid="PSA 103:20">तैस जो धन ज़ोथ<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />हे यहोवारी सेनाव<note caller="+" style="f"><char style="fr" closed="false">103:21 </char><char style="fq" closed="false">सेनाव </char><char style="ft" closed="false">स्वर्गदूत</char></note>, हे तैसेरे सेवकव,</para>
  <para style="q" vid="PSA 103:21">तुस ज़ैना तैसेरी इच्छा पूरी केरतथ, तैस जो धन ज़ोथ!<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />हे यहोवारी सारी रच़ना,</para>
  <para style="q" vid="PSA 103:22">तैसेरे राज़ केरनेरे सब ठारन मां तैस जो धन ज़ोथ।</para>
  <para style="q" vid="PSA 103:22">हे मेरे मन, तू यहोवा जो धन ज़ो!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">सृष्टि बनाने बालेरी तारीफ़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />हे मेरे मन, तू यहोवा ज़ो धन ज़ो!</para>
  <para style="q" vid="PSA 104:1">हे मेरे परमेशर यहोवा,</para>
  <para style="q" vid="PSA 104:1">तू बड़ो महानस,</para>
  <para style="q" vid="PSA 104:1">तीं महिमा ते आदरारां लिगड़ां लेवरन।<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />तू लौई च़ादरारो ज़ेरो पलेटतां रखतस,</para>
  <para style="q" vid="PSA 104:2">ते अम्बरे एन्च़रे फैलातस ज़ेन्च़रे मैन्हु तेम्बु लाते,<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />तू अपनु घर पैनी मां बनातस,</para>
  <para style="q" vid="PSA 104:3">ते बिदलारी अपनु रथ बनातस,</para>
  <para style="q" vid="PSA 104:3">ते हवारे फंघन पुड़ च़लतस।<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />तू हवाई अपने दूत,</para>
  <para style="q" vid="PSA 104:4">ते अग्गरी लप्पी अपने सेवक बनातस।<verse eid="PSA 104:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />तीं ज़मीन मज़बूत मुनीयादी पुड़ रखी,</para>
  <para style="q" vid="PSA 104:5">ताके तै कधे न हिल्‍ले।<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />तीं तै डुग्घे समुन्दरेरे पैनी सेइं छ़ुपाई ज़ेन्च़रे लिगड़े सेइं;</para>
  <para style="q" vid="PSA 104:6">पानी पहाड़न पुड़ रुकी जेवं।<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />पन तेरी झ़िड़की सेइं पानी नेश्शी जेवं;</para>
  <para style="q" vid="PSA 104:7">तेरे गरज़नेरी आवाज़ शुन्तां तैन अकदम रुड़ी जेवं।<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />पानी पहाड़न पुड़ च़ेढ़ी जेवं, ते तरैई केरि बत्ती मरां तैस ठैरी मां उतरी जेवं</para>
  <para style="q" vid="PSA 104:8">ज़ै तीं तैसेरे लेई तियार कियोरी थी।<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />तीं अक हद रख्खी ज़ैस करां अग्रोवं पानी न गेइ सके,</para>
  <para style="q" vid="PSA 104:9">ते वापस एइतां ज़मीनी ढेक्‍की न सके।<verse eid="PSA 104:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />तू वैदन मां पैनेरे नाग बगने देतस;</para>
  <para style="q" vid="PSA 104:10">ते तैना पहाड़न मांमेइं बगतन,<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />तैस पैनी मरां सब जंगली जानबर पानी पीतन;</para>
  <para style="q" vid="PSA 104:11">जंगली गधे भी अपनि ट्लिश मिटातन।<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />तैन कां अम्बरेरां च़ुड़ोलू तैन केरे बन्ने एइतां बिशतन,</para>
  <para style="q" vid="PSA 104:12">ते तैन केरि आवाज़ डैलड़न मरां शुनोतीए।<verse eid="PSA 104:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />तू अपने घरे मरां ज़ैन बह आहे पहाड़न सगतस,</para>
  <para style="q" vid="PSA 104:13">ते कम्मां केरे फले सेइं धरती रेज़्ज़ी गातीए।<verse eid="PSA 104:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />तू जानबरां केरे लेई घास,</para>
  <para style="q" vid="PSA 104:14">ते इन्सानां केरे कम्मेरे लेई अन्नेरी पैदावार तियार केरतस,</para>
  <para style="q" vid="PSA 104:14">ते एस्से तरीके सेइं ज़मीनी मरां तैना खानेरी चीज़ां पैदा केरतस।<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />तेरी दाछ़रो रस ज़ैस सेइं मैन्हेरो मन खुशी भोते,</para>
  <para style="q" vid="PSA 104:15">ते तेरो तेल ज़ैस सेइं तैसेरू तुत्तर चमकते,</para>
  <para style="q" vid="PSA 104:15">तेरी रोट्टी तैसेरो दिल मज़बूत केरचे।<verse eid="PSA 104:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />यहोवारे बुट रज़ोरे रहतन,</para>
  <para style="q" vid="PSA 104:16">मतलब कि लबानोनेरे गैइड़ ज़ैना तैनी लेवरेन।<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />च़ुड़ोलू तैन मां अपने आल्हे बनातन;</para>
  <para style="q" vid="PSA 104:17">ते सारस च़ुड़ोलोवं सनोवर बुट्टन मां रहते।<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />उच्‍चां पहाड़ां जंगलेरे थाव्वां केरे लेई आन;</para>
  <para style="q" vid="PSA 104:18">ते शफड़न मां शापानां केरे छ़पनेरी ठारे।<verse eid="PSA 104:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />तीं महीने ते वक्तेरे निशानेरे लेई चाँदनी बनाई;</para>
  <para style="q" vid="PSA 104:19">ते दिहाड़ो अपने डुबनेरो मौको ज़ानते।<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />तू आंधरू बनातस, तैखन रात भोचे;</para>
  <para style="q" vid="PSA 104:20">ज़ैस मां जंगली जीप जन्तू हंठतन फिरतन।<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />जुवान शेर शिकारेरे लेई गरज़ते,</para>
  <para style="q" vid="PSA 104:21">ते परमेशरे करां अपनो शिकार मगते।<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />फिरी दिहाड़ो निसते तैना च़ले गातन</para>
  <para style="q" vid="PSA 104:22">ते अपने कुढी मां आराम केरतन।<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />तैखन इन्सान अपने कम्मेरे लेई</para>
  <para style="q" vid="PSA 104:23">ते ड्लवझ़ी तगर मेहनत केरनेरे लेई निसतन।<verse eid="PSA 104:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />हे यहोवा तेरां कम्मां बेशुमारन!</para>
  <para style="q" vid="PSA 104:24">एना सब चीज़ां तीं एपनी अक्ली सेइं बनेवरिन;</para>
  <para style="q" vid="PSA 104:24">ते ज़मीन तेरे बनेवरे जीप जन्तून सेइं भेरतांए।<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />एन्च़रे सेइं समुन्दर बड़ोए ते बिल्‍लोए,</para>
  <para style="q" vid="PSA 104:25">ते तैस मां बड़े पैनेरे जीप जन्तू</para>
  <para style="q" vid="PSA 104:25">बड्डे भी ते निक्‍के सब आन।<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />तैस पुड़ ज़िहाज़ां भी इरां उरां सफर केरतन,</para>
  <para style="q" vid="PSA 104:26">ते लिव्यातान भी ज़ै तीं खेडनेरे लेई बनेवरोए।<verse eid="PSA 104:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />इन सेभन सिर्फ तेरो सहारोए,</para>
  <para style="q" vid="PSA 104:27">कि तू तैन वक्ते पुड़ खाने जो देस।<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />तू तैन मां खाने जो देतस, त तैना तैस अकोट्ठू केरतन;</para>
  <para style="q" vid="PSA 104:28">ते तू अपनि मुठड़ी खोलतस त तैना रोड़ी चीज़न सेइं रेज़्ज़ी गातन।<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />ज़ैखन तू अपनु तुत्तर छ़ुपातस, त तैन केरे होश उड़ी गातन,</para>
  <para style="q" vid="PSA 104:29">ज़ैखन तू तैन केरो दम केढी देतस, त तैना मेरि गातन</para>
  <para style="q" vid="PSA 104:29">त तैना दुबारे मित्ती मां मिली गातन।<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />तू अपने तरफां सांस<note caller="+" style="f"><char style="fr" closed="false">104:30 </char><char style="fq" closed="false">सांस </char><char style="ft" closed="false">आत्मा</char></note> भेज़तस, त तैना पैदा भोइ गातन;</para>
  <para style="q" vid="PSA 104:30">त तू धेरती नंव्वी बनातस।<verse eid="PSA 104:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />यहोवारी महिमा सदा तगर बनोरी राए,</para>
  <para style="q" vid="PSA 104:31">यहोवा अपने कम्मन सेइं खुश भोए!<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />तै ज़मीनी पुड़ नज़र देते, त तै हिल्‍ली गाचे,</para>
  <para style="q" vid="PSA 104:32">तै पहाड़न सेइं हुरते त तैन मरां तू निसते।<verse eid="PSA 104:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />अवं सैरी उमरी यहोवारू गीत ज़ोतो रेइलो,</para>
  <para style="q" vid="PSA 104:33">ज़ांतगर अवं ज़ींतोईं अपने परमेशरेरी शुक्रगुज़ारी केरतो रालो।<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />मेरू ध्यान केरनू तैस खुशी एज्जे,</para>
  <para style="q" vid="PSA 104:34">किजोकि अवं त यहोवारे वजाई सेइं खुशी भोल्हो।<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />पापी लोकां केरो धेरती पुड़ां अन्त भोए,</para>
  <para style="q" vid="PSA 104:35">ते दुष्ट लोक अग्रोवं जो न रान!</para>
  <para style="q" vid="PSA 104:35">हे मेरे मन यहोवा जो धन ज़ो!</para>
  <para style="q" vid="PSA 104:35">यहोवारी तारीफ़ केरा।<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">परमेशर ते तैसेरे लोक</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />यहोवारू शुक्र केरा, तैस कां प्राथना केरा,</para>
  <para style="q" vid="PSA 105:1">मुल्खे मुल्खेरे लोकन कां तैसेरे कम्मां केरो प्रचार केरा!<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />तैसेरे लेई गीतां ज़ोथ, तैसेरे लेई भजन ज़ोथ,</para>
  <para style="q" vid="PSA 105:2">तैसेरे सब चमत्कारां केरू बियान केरा!<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />तैसेरे पवित्र नंव्वेरी बडीयाई केरा;</para>
  <para style="q" vid="PSA 105:3">यहोवारी तलाश केरनेबालां केरो दिल खुशी भोए।<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />यहोवा त तैसेरी शक्ति तोप्पा,</para>
  <para style="q" vid="PSA 105:4">तैसेरे दर्शनेरे तलाशी मां लगातार लग्गोरे राथ।<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />ज़ैना चमत्कार तैनी किये तैन याद केरा,</para>
  <para style="q" vid="PSA 105:5">तैसेरे चमत्कार ते फैसले याद केरा!<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />हे तैसेरे सेवक अब्राहमेरू खानदान,</para>
  <para style="q" vid="PSA 105:6">हे याकूबेरे घरानेरे लोकव, तुस त तैसेरे च़ुनोरे आथ!<verse eid="PSA 105:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />तैए इश्शो परमेशर यहोवा आहे;</para>
  <para style="q" vid="PSA 105:7">पूरे धेरती पुड़ तैसेरे फैसले भोतन।<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />तै हमेशा अपने करारे याद केरतो एवरोए,</para>
  <para style="q" vid="PSA 105:8">इन तैन्ने वचने ज़ैन तैनी हज़ार पीढ़ी केरे लेई रखोरू थियूं;<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />तैए करार ज़ै तैनी अब्राहमे सेइं कियोरो थियो,</para>
  <para style="q" vid="PSA 105:9">एस बारे मां तैनी इसहाके सेइं कसम खाइ।<verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />तै तैनी याकूबेरे लेई विधि केरतां,</para>
  <para style="q" vid="PSA 105:10">ते इस्राएलेरे लेई इन ज़ोइतां हमेशारे लेई करार केरतां मज़बूत कियो।<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />“अवं कनान मुल्खे तीं देइलो, तै बन्टने मां तेरो अपनो हिस्सो भोल्हो।”<verse eid="PSA 105:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />तैस मौके परमेशरेरे लोकां केरि गिनती थोड़ी थी, बल्के बिलकुल थोड़ी थी,</para>
  <para style="q" vid="PSA 105:12">ते तैस मुल्खे मां परदेशी थिये।<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />तैना एक्‍की कौमी मरां होरि कौमी मां,</para>
  <para style="q" vid="PSA 105:13">ते एक्‍की रियासती मरां होरि रियासती मां हंठते फिरते राए।<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />पन तैनी कोन्ची मैन्हु तैन पुड़ ज़ुलम केरने न दित्तो;</para>
  <para style="q" vid="PSA 105:14">ते तै राज़न तैन केरे लेई ई धमकी देतो थियो,<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />“मेरे च़ुनोरे दासन सेइं न हुरा,</para>
  <para style="q" vid="PSA 105:15">मेरे नेबन कोई नुकसान न पुज़ाथ!”<verse eid="PSA 105:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />फिरी यहोवा तैस कनान मुल्खे मां काल भेज़ो,</para>
  <para style="q" vid="PSA 105:16">ते तैन अन्न मैल्हनू बन्द भोवं।<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />तैनी यूसुफ नंव्वेरो अक मैन्हु तैन करां पेइलो भेज़ोरो थियो,</para>
  <para style="q" vid="PSA 105:17">ज़ै गुलाम बनानेरे लेई बेच़ोरो थियो।<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />लोकेईं तैसेरे पव्वन मां बेड़ी लेइतां तैस बड़ो दुख दित्तो,</para>
  <para style="q" vid="PSA 105:18">तै लोंहेरी शंगलन सेइं बन्धो जेव।<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />ज़ांतगर तैन सब किछ पूरू न भोवं,</para>
  <para style="q" vid="PSA 105:19">तैखन तगर यहोवारू वचन तैस अज़मातू रावं।<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />तैखन मिस्रेरे राज़े अपने मैन्हु भेज़तां तैट्ठां छुटाव,</para>
  <para style="q" vid="PSA 105:20">ते मुल्खां-मुल्खां केरे लोकां केरे मालिके तै आज़ाद कियो;<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />फिरी मिस्रेरे राज़े तै अपने घरे मां प्रधान</para>
  <para style="q" vid="PSA 105:21">ते एपनी सैरी जेईदातरो अधिकारी बनाव।<verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />कि तै तैसेरे हाकिमन एपनी मेर्ज़रे मुताबिक कैबू केरे,</para>
  <para style="q" vid="PSA 105:22">ते मिस्री बुज़ुर्ग लोकन ज्ञान शिखाले।<verse eid="PSA 105:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />फिरी इस्राएल मिस्रे मां अव;</para>
  <para style="q" vid="PSA 105:23">ते याकूब हामेरे मुल्खे मां परदेशी बेनतां राव।<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />तैखन तैनी अपने लोक गिनती मां बड़े बधाए,</para>
  <para style="q" vid="PSA 105:24">ते तैसेरे दुश्मन करां जादे ताकतबर बनाव।<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />तैनी मिस्री केरो मन एन्च़रे बदलो,</para>
  <para style="q" vid="PSA 105:25">कि तैना तैसेरे लोकन सेइं बैर रखने,</para>
  <para style="q" vid="PSA 105:25">ते तैसेरे सेवकन सेइं दगो केरने लगे।<verse eid="PSA 105:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />तैनी अपनो सेवक मूसो</para>
  <para style="q" vid="PSA 105:26">ते अपनो च़ुनोरो हारून मिस्रे मां भेज़े।<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />तैने मिस्री लोकां केरे दरमियान तैसेरे तरफां किसमां-किसमां केरे निशान,</para>
  <para style="q" vid="PSA 105:27">ते हामेरे मुल्खे मां चमत्कार हिराए।<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />परमेशरेरे हुक्मे सेइं मिस्र मुल्खे मां आंधरू भोइ जेवं,</para>
  <para style="q" vid="PSA 105:28">पन तैनेईं तैसेरो हुक्म न मन्नो।<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />परमेशरे मिस्रेरू पानी खूने मां बेदली दित्तू,</para>
  <para style="q" vid="PSA 105:29">ते तैन केरि मेछ़ली मैरी दित्ती।<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />मिस्र मुल्खे मां मैंडू एत्रां बेधी जेआं कि राज़ेरे मेहले मां भी भेरोई जेआं।<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />परमेशरे हुक्म दित्तो, तैखन डांघाल आए,</para>
  <para style="q" vid="PSA 105:31">ते तैन केरे सारे मुल्खे मां जिवाँ एई।<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />झ़ेड़रे बदले तैनी मिस्र मुल्खे मां आण भेज़ी,</para>
  <para style="q" vid="PSA 105:32">ते तैन केरे मुल्खे मां बड़ी अग बख्खी।<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />तैनी तैन केरे दाछ़रे डाल ते फैगेरे बुट</para>
  <para style="q" vid="PSA 105:33">ते तैन केरे मुल्खेरे बुट भी ट्लोड़ी दित्ते।<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />तैसेरे हुक्मे सेइं मिस्र मुल्खे मां बेशुमार टिट्टां, ते कीड़े आए,<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />तैनेईं तैन केरे मुल्खेरू सब अन्न खेइ छ़डू;</para>
  <para style="q" vid="PSA 105:35">ते तैन केरे उडारां केरि सारी फसल चट केरि दित्ती।<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />तैनी तैन केरे मुल्खेरां सब ज़ेठे मारे,</para>
  <para style="q" vid="PSA 105:36">ते तैन केरे ताकतरो पेइलो फल भी नाश कियो।<verse eid="PSA 105:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />तैखन तैनी इस्राएली लोकन सोन्नू चाँदी दुवेइतां तैट्ठां केढतां आने,</para>
  <para style="q" vid="PSA 105:37">ते तैन मरां कोई भी कमज़ोर न थियो।<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />तैन केरे तैट्ठां गाने सेइं मिस्री बड़े खुशी भोए,</para>
  <para style="q" vid="PSA 105:38">किजोकि तैन केरो डर तैन मां बेस्सी जेवरो थियो।<verse eid="PSA 105:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />तैनी तैन केरे छाव बनानेरे लेई बिदलार फैलाई,</para>
  <para style="q" vid="PSA 105:39">ते राती लौ बनानेरे लेई अग भेज़ी।<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />इस्राएली लोकां केरे मगने सेइं तैन केरे लेई बटेरां पुज़ेई,</para>
  <para style="q" vid="PSA 105:40">ते तैन सुर्गेरी रोट्टी दित्ती।<verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />तैने चट्टान ट्लोड़ी त पानी बगने लगू:</para>
  <para style="q" vid="PSA 105:41">ते रेगिस्ताने मां पैनेरो दरिया बगने लगो।<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />किजोकि परमेशरे अपनो पवित्र वाधो</para>
  <para style="q" vid="PSA 105:42">ते अपनो दास अब्राहम याद कियो।<verse eid="PSA 105:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />तैनी अपने च़ुनोरे लोक मिस्रे मरां केढतां आने,</para>
  <para style="q" vid="PSA 105:43">ते अपने च़ुनोरे लोक जयजयकार करावेइतां कढे।<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />ते इस्राएली लोकन कौमां-कौमां केरे मुल्ख भी दित्ते,</para>
  <para style="q" vid="PSA 105:44">ते तैन केरे मुल्खेरी मेहनतरे फले पुड़ कब्ज़ो कियो।<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />कि तैना तैसेरे विधन मन्न,</para>
  <para style="q" vid="PSA 105:45">ते तैसेरे कानूने पूरो केरन।</para>
  <para style="q" vid="PSA 105:45">यहोवारी तारीफ़ केरा।<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">परमेशरे पुड़ इस्राएलेरो विश्वास न केरनो</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />यहोवारी तारीफ़ केरा, यहोवारी शुक्रगुज़ारी केरा, किजोकि तै भलोए;</para>
  <para style="q" vid="PSA 106:1">ते तैसेरो प्यार हमेशारोए।<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />कौन यहोवारे महान कम्मां केरे बारे मां बियान केरि सकते,</para>
  <para style="q" vid="PSA 106:2">या कौन तैसेरी पूरी तारीफ़ केरि सकते?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />केत्रो धने तै ज़ै न्याय पुड़ च़लते,</para>
  <para style="q" vid="PSA 106:3">या हर वक्त भलां कम्मां केरते।<verse eid="PSA 106:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />हे यहोवा ज़ैखन तू अपने लोकन पुड़ दया केरस, मीं भी याद रेखां</para>
  <para style="q" vid="PSA 106:4">ज़ैखन तू तैन बच़ास मीं भी याद रेखां।<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />ताके अवं तेरे च़ुनोरे लोकां केरी खुशहाली हेरी सेखी,</para>
  <para style="q" vid="PSA 106:5">ते तेरे लोकां केरि खुशी मां शामल भोईं;</para>
  <para style="q" vid="PSA 106:5">ते विरासती सेइं साथी तारीफ़ केरि सेखी।<verse eid="PSA 106:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />असेईं त अपने दादे-पड़दादां केरो ज़ेरो पाप कियोरोए;</para>
  <para style="q" vid="PSA 106:6">असेईं बुराई की ते बुरां कम्मां कियां!<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />ज़ैखन इश्शे दादे पड़दादे मिस्रे मां थिये, तैखन तैन तेरे चमत्कारन पुड़ मन न लव,</para>
  <para style="q" vid="PSA 106:7">ते तेरी तै महरबानी याद न रख्खी;</para>
  <para style="q" vid="PSA 106:7">तैनेईं समुन्दरेरे बन्ने, मतलब लाल समुन्दरेरे बन्ने बगावत की।<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />फिरी भी तैनी तैना अपने नंव्वेरे खातर बच़ाए,</para>
  <para style="q" vid="PSA 106:8">ज़ैस सेइं तै अपनि कुदरत बांदी केरे।<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />तैखन तैनी लाल समुन्दर झ़िड़को ते तै शुक्‍की जेव,</para>
  <para style="q" vid="PSA 106:9">तैनी तैना समुन्दरेरे डुग्घारे मांमेइं पार कढे ज़ेन्च़रे रेगिस्ताने मांमेइं निस्से।<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />तैनी तैना दुश्मनेरे<note caller="+" style="f"><char style="fr" closed="false">106:10 </char><char style="fq" closed="false">दुश्मनेरे </char><char style="ft" closed="false">इस भजने मां मिस्री केरि पिशान दुश्मना केरे रूपे मांए।</char></note> हथ्थे मरां कढे,</para>
  <para style="q" vid="PSA 106:10">ते दुश्मनेरे हथ्थे मरां छुटाव।<verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />तैन केरे दुश्मन पैनी मां डुबतां मेरि जे;</para>
  <para style="q" vid="PSA 106:11">तैन मरां अक भी न बच़ो।<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />तैखन तैसेरे लोकेईं तैसेरे वाधन पुड़ विश्वास कियो,</para>
  <para style="q" vid="PSA 106:12">ते तैसेरी तारीफ़ केरने लगे।<verse eid="PSA 106:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />पन तैनेईं लूशी तैसेरां कम्मां बिसरी छ़डां;</para>
  <para style="q" vid="PSA 106:13">ते तैसेरी सलाह न बलगी।<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />सुनसान ठैरी मां तैनेईं बड़ी खुवैइश की</para>
  <para style="q" vid="PSA 106:14">ते रेगिस्ताने मां परमेशरेरी अज़मैइश की।<verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />तैखन तैन मगोरो बर त दित्तो,</para>
  <para style="q" vid="PSA 106:15">पन तैन मां खतरनाक बिमारी भेज़ी।<verse eid="PSA 106:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />तैना डेरन मां मूसेरे</para>
  <para style="q" vid="PSA 106:16">ते यहोवारे लेई पवित्र सेवक हारूनेरी मुखालफत केरने लगे।<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />तैखन ज़मीन फेटतां दाताने निगली जेई,</para>
  <para style="q" vid="PSA 106:17">ते अबीरामेरो जथो निगलो।<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />ते तैन केरे जथे मां अग लेग्गी जेई;</para>
  <para style="q" vid="PSA 106:18">ते दुष्ट लोक लप्पी सेइं भस्म भोइ जे।<verse eid="PSA 106:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />तैनेईं होरेब पहाड़े<note caller="+" style="f"><char style="fr" closed="false">106:19 </char><char style="fq" closed="false">होरेब पहाड़े </char><char style="ft" closed="false">सीनै पहाड़</char></note> पुड़ बछ़ड़ेरी मूरती बनाई,</para>
  <para style="q" vid="PSA 106:19">ते तैस बनेवरी मूरतरी पूज़ा की।<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />तैनेईं परमेशरेरी महिमा, घास खानेबाले दांतेरे मूरती मां बदली।<verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />तैनेईं अपनो मुक्ति देनेबालो परमेशर बिसरो,</para>
  <para style="q" vid="PSA 106:21">ज़ैने मिस्रे मां बड्डां-बड्डां कम्मां कियोरां थियां।<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />तैने हामेरे मुल्खे मां चमत्कार,</para>
  <para style="q" vid="PSA 106:22">ते लाल समुन्दरेरे बन्ने पुड़ भयानक कम्मां कियोरां थियां।<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />तांए तैनी ज़ोवं, कि एन केरो अवं सत्यानाश केरी देथो।</para>
  <para style="q" vid="PSA 106:23">अगर मेरो च़ुनोरो दास मूसो खतरेरे ठैरी तैन केरे लेई खड़ो न भोथो</para>
  <para style="q" vid="PSA 106:23">ताके मेरी सरक ठंडी केरे कोन्च एरहो न भोए कि अवं तैन नाश केरि छ़ेडी।<verse eid="PSA 106:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />तैनेईं तै मन पसंद मुल्ख बेकार समझ़ो,</para>
  <para style="q" vid="PSA 106:24">तैनेईं तैसेरे वाधन पुड़ विश्वास न कियो।<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />तैना अपने डेरन मां कुड़कुड़ाए,</para>
  <para style="q" vid="PSA 106:25">ते यहोवारी आवाज़ शुन्नेरे लेई तियार न भोए।<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />तैखन तैनी तैन केरे बारे मां कसम खाइ कि अवं तैन सुनसान ठैरी मां नाश केरेलो,<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />ते तैन केरि औलादी होरि कौमां केरे सामने बिछ़ोड़ेलो,</para>
  <para style="q" vid="PSA 106:27">ते मुल्खे-मुल्खे मां तितर-बितर केरेलो।<verse eid="PSA 106:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />तैना बालपोर<note caller="+" style="f"><char style="fr" closed="false">106:28 </char><char style="fq" closed="false">बालपोर </char><char style="ft" closed="false">मतलब “प्रभु” इन नवं पुराने नियमे मां गैर कौमां केरो देबतोए।</char></note> देबतेरी पुज़ा केरने लगे, ते मुड़दन कां च़ढ़ोरे जानबरां केरू मास खाने लगे।<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />एन्च़रे तैनेईं अपने कम्मन सेइं तै सरकाव,</para>
  <para style="q" vid="PSA 106:29">ते महामारी तैन मां फैली जेई।<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />पन पीनहासे खड़े भोइतां तैन केरि आदालत की,</para>
  <para style="q" vid="PSA 106:30">ते तैखन महामारी रुकी जेई।<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />ते इन तैसेरे लेई पीढ़ी-पीढ़ी तगर हमेशारे लेई धर्म गनो जेव।<verse eid="PSA 106:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />तैनेईं मरीबा नंव्वेरे पैनेरे नागे कां भी यहोवा सरक आनाई,</para>
  <para style="q" vid="PSA 106:32">ते तैन केरे वजाई सेइं मूसेरो नुकसान भोव।<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />किजोकि तैनेईं परमेशरेरी आत्माई सेइं बगावत की,</para>
  <para style="q" vid="PSA 106:33">तैखन मूसो बगैर सोचने ज़ोने लगो।<verse eid="PSA 106:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />ज़ैना लोकां केरे बारे मां यहोवा हुक्म दित्तोरो थियो,</para>
  <para style="q" vid="PSA 106:34">तैनी तैना नाश न किये।<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />बल्के तैना एरी कौमन सेइं मिली जे,</para>
  <para style="q" vid="PSA 106:35">ते तैन केरे रीति रुवाज़ शिख्खे।<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />तैना तैन केरे मूरती केरि पूज़ा केरने लगे,</para>
  <para style="q" vid="PSA 106:36">ते तैना तैन केरे लेई फंदो बेनि जेई।<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />बल्के तैनेईं अपने मट्ठां कुइयां कनानेरे मूरती केरे लेई बलिदान कियां;<verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />ते अपने बेकसूर कुइये मट्ठां केरो खून बगाव</para>
  <para style="q" vid="PSA 106:38">ज़ैना तैनेईं कनानेरे मूरतन पुड़ बलि कियां।</para>
  <para style="q" vid="PSA 106:38">एल्हेरेलेइ मुल्ख खूने सेइं अपवित्र भोइ जेव।<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />ते तैना सब अपने कम्मां केरे ज़िरिये सेइं भिट्टे भोए,</para>
  <para style="q" vid="PSA 106:39">ते अपने कम्मां केरे ज़िरिये सेइं तैना व्यभिचार केरनेबाले बेनि जे।<verse eid="PSA 106:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />तैखन यहोवारो क्रोध अपने लोकन पुड़ भड़को,</para>
  <para style="q" vid="PSA 106:40">ते तैस अपने विरासती सेइं सखत नफरत भोइ;<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />तैखन तैनी तैना गैर कौमां केरे हवाले केरि दित्ते,</para>
  <para style="q" vid="PSA 106:41">ते तैन केरे दुश्मनेईं तैन पुड़ राज़ कियूं।<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />तैन केरे दुश्मनेईं तैन पुड़ ज़ुलम कियो,</para>
  <para style="q" vid="PSA 106:42">ते तैना तैन केरे हथ्थे हैठ देबोइ जे।<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />बार-बार तैनी तैना छुटाए,</para>
  <para style="q" vid="PSA 106:43">पन तैना तैसेरे खलाफ टिकोरे राए,</para>
  <para style="q" vid="PSA 106:43">ते अपने बुरे कम्मां केरि वजाई सेइं च़िकोरे राए।<verse eid="PSA 106:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />फिरी भी ज़ैखन-ज़ैखन तैन केरि प्राथनाई मां चिन्डां तैनी शुनी,</para>
  <para style="q" vid="PSA 106:44">तैखन-तैखन तैने तैन केरि मुसीबती पुड़ नज़र की!<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />तैन केरे लेई अपनो करार याद केरतां</para>
  <para style="q" vid="PSA 106:45">अपने बड़े प्यारेरे मुताबिक तरस खव,<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />ते ज़ैना तैना गुलाम बनेइतां नियोरे थिये तैन सेभन पुड़ दया कराई।<verse eid="PSA 106:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />हे इश्शे यहोवा परमेशर, असन बच़ा,</para>
  <para style="q" vid="PSA 106:47">ते असन गैर कौमन मरां अकोट्ठे केर,</para>
  <para style="q" vid="PSA 106:47">कि अस तेरे पवित्र नंव्वेरू शुक्र केरम,</para>
  <para style="q" vid="PSA 106:47">ते तेरी तारीफ़ केरते तेरे बारे मां बडीयाई केरम।<verse eid="PSA 106:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />इस्राएलेरो परमेशर यहोवा</para>
  <para style="q" vid="PSA 106:48">शुरुआती करां हमेशा तगर धने।</para>
  <para style="q" vid="PSA 106:48">ते सारे लोक ज़ोन, “आमीन!”</para>
  <para style="q" vid="PSA 106:48">यहोवारी तारीफ़ केरा।<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">पंच़ोंव हिस्सो</para>
  <para style="mr">
    <ref loc="PSA 107-150">भज. 107—150</ref></para>
  <para style="s">मुक्ति देनेरे लेई परमेशरेरू शुक्र</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />यहोवारू शुक्र केरा। किजोकि तै भलोए;</para>
  <para style="q" vid="PSA 107:1">ते तैसेरो प्यार हमेशारोए!<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />यहोवा ज़ैन छुटेवरेन तैना एन्च़रे ज़ोन,</para>
  <para style="q" vid="PSA 107:2">ज़ैना तैनी कीमत देइतां दुश्मनेरे कब्ज़े मरां छुटेवरन।<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />ते तैन मुल्ख-मुल्खेरां,</para>
  <para style="q" vid="PSA 107:3">पूरब-पश्चिम, उत्तर ते दक्षिण पासेरां अकोट्ठे कियोरेन।<verse eid="PSA 107:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />किछ लोक सुनसान ठैरी मां रेगिस्ताने पुड़ भटकते फिरे,</para>
  <para style="q" vid="PSA 107:4">कोई नगर न मैल्हू ज़ैड़ी तैना रहते भोन;<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />ढ्लुखी सेइं ते ट्लिशी सेइं</para>
  <para style="q" vid="PSA 107:5">तैन केरि जान कमज़ोर भोइ जेई।<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />तैखन तैनेईं एपनी मुसीबती मां यहोवा कां बिनती की,</para>
  <para style="q" vid="PSA 107:6">ते तैनी तैन केरि सैरी मुसीबतन करां छुटकारो दित्तो;<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />तैनी तैना सही बत्तां च़लाए,</para>
  <para style="q" vid="PSA 107:7">ताके तैना बस्सनेरे लेई कोन्ची नगरे तगर पुज़न।<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />लोक यहोवारे प्यारेरे वजाई सेइं,</para>
  <para style="q" vid="PSA 107:8">ते तैन चमत्कारां केरे वजाई सेइं ज़ैना तै मैन्हु केरे लेई केरते, तैसेरे लेई शुक्र केरन!<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />किजोकि तै ट्लिशोरी जानी पानी पियाते,</para>
  <para style="q" vid="PSA 107:9">ते ढ्लुखोरे रोड़ी-रोड़ी चीज़ेइं सेइं रज़ानते।<verse eid="PSA 107:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />ज़ैना आंधरे ते मौतरी छावी मां बिशोरेन,</para>
  <para style="q" vid="PSA 107:10">ते दुखे मां फसोरे ते बेड़न सेइं बन्धोरे थिये।<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />किजोकि तैना परमेशरेरे वचनेरे खलाफ च़ले,</para>
  <para style="q" vid="PSA 107:11">तैनेईं परमप्रधान परमेशरेरी सलाह घटिया समझ़ी।<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />तैखन तैनेईं तैना तकलीफी सेइं दबाए;</para>
  <para style="q" vid="PSA 107:12">तैना ठोकर खेइतां बिछ़ड़े, ते तैन कोई मद्दत न मैल्ही।<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />तैखन तैनेईं मुसीबती मां यहोवा पुकारो,</para>
  <para style="q" vid="PSA 107:13">ते तैनी तैन केरे दुखन करां छुटकारो दित्तो।<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />तैनी तैना आंधरे मरां ते मौतरे छावी मरां कढे;</para>
  <para style="q" vid="PSA 107:14">ते तैन केरि बेड़ी भी ट्लोड़ी दित्ती।<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />लोक यहोवारे प्यारेरे वजाई सेइं,</para>
  <para style="q" vid="PSA 107:15">ते तैन चमत्कारां केरे वजाई सेइं ज़ै तै मैन्हु केरे लेई केरते,</para>
  <para style="q" vid="PSA 107:15">तैसेरू शुक्र केरन।<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />किजोकि तैनी पितलरे फाटक ट्लोड़ी दित्ते,</para>
  <para style="q" vid="PSA 107:16">ते लोंहेरे अड्डे टुक्ड़े-टुक्ड़े केरि दित्ते।<verse eid="PSA 107:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />बेवकूफ अपने बुरी चाल,</para>
  <para style="q" vid="PSA 107:17">ते बुरां कम्मां केरे वजाई सेइं बड़े दुखी भोतन।<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />तैन हर खानेरे चीज़ी सेइं नफरत भोने लगी</para>
  <para style="q" vid="PSA 107:18">ते तैना मौतरे फाटके कां नेड़े पुज़्ज़ी जे।<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />तैखन तैना अपने मुसीबती मां यहोवा कां बिनती केरतन,</para>
  <para style="q" vid="PSA 107:19">ते तै तैन केरि सैरी मुसीबतन करां छुटकारो देते।<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />तै अपनु वचन भेज़तां तैन बझ़ाते,</para>
  <para style="q" vid="PSA 107:20">ते ज़ैस गत्ते मां तैना फसोरेन तैन कढते।<verse eid="PSA 107:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />लोक यहोवारे प्यारेरे वजाई</para>
  <para style="q" vid="PSA 107:21">ते तैन चमत्कारां केरे वजाई सेइं ज़ैना तै मैन्हु केरे लेई केरते, तैसेरू शुक्र केरन!<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />ते तैना शुक्रेरी बलि च़ाढ़न,</para>
  <para style="q" vid="PSA 107:22">ते जयजयकार केरते, तैसेरे कम्मां केरू बियान केरन।<verse eid="PSA 107:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />ज़ैना लोक समुन्दरे मां ज़िहाज़न पुड़ च़लतन,</para>
  <para style="q" vid="PSA 107:23">ते महासागरे पुड़ भोइतां बुपार केरतन;<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />तैना यहोवारे कम्मन,</para>
  <para style="q" vid="PSA 107:24">ते तैन चमत्कारन हेरतन, ज़ैना तै डुग्घे समुन्दरे मां केरते।<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />किजोकि तै हुक्म देते, तैखन तूफानी हवा च़ेलतां छ़ेल्‍ली आनतीए।<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />तैना अम्बरे तगर पुज़्ज़ी जे, ते डुग्घारे तगर ओसतन; ते</para>
  <para style="q" vid="PSA 107:26">ते दुखेरे मारे तैन केरे जानी मां जान न राए;<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />तैना चक्‍कर खाते, ते नशे मां मसत भोवरे ड्लकेईं खातन</para>
  <para style="q" vid="PSA 107:27">तैन केरि सारी अक्ल मारी गातीए।<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />तैखन तैना एपनी मुसीबती मां यहोवा पुकारतन,</para>
  <para style="q" vid="PSA 107:28">ते तै तैन्न मुसीबती करां छुटकारो देते।<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />तै छ़ेलहन रोकते ते छ़ेल्ही रुकी गैतिन।<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />तैखन तैना तैन केरे बिशने सेइं खुशी भोतन,</para>
  <para style="q" vid="PSA 107:30">ते तै तैन केरे मन चाए कैदखाने मां पुज़ेई देते।<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />लोक यहोवारे प्यारेरे वजाई सेइं,</para>
  <para style="q" vid="PSA 107:31">ते तैन चमत्कारां केरे वजाई सेइं ज़ैना तै मैन्हु केरे लेई केरते,</para>
  <para style="q" vid="PSA 107:31">तैसेरू शुक्र केरन।<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />ते सभाई मां तैसेरी तारीफ़ केरन,</para>
  <para style="q" vid="PSA 107:32">ते बुज़ुर्गां केरे दरमियान तैसेरी तारीफ़ केरन।<verse eid="PSA 107:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />तै दरियान जंगल बनाते,</para>
  <para style="q" vid="PSA 107:33">ते पैनेरे नागन शुकोरी ज़मीनी मां बेदली देते।<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />तै फलदार ज़मीनी बंझर ज़मीन बनाते,</para>
  <para style="q" vid="PSA 107:34">इन तैट्ठेरे रानेबालां केरे बुरैइारे नज़रारे वजाई सेइं भोते।<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />तै जंगले पैनेरी झीलां बनाते,</para>
  <para style="q" vid="PSA 107:35">ते रेगिस्ताने पैनेरे नाग बनाते।<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />तैड़ी तै ढ्लुखोरेन बसेई देते,</para>
  <para style="q" vid="PSA 107:36">कि तैना बस्सनेरे लेई नगर तियार केरन।<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />ते ज़मीनदारी केरन, ते दाछ़री बागां लान,</para>
  <para style="q" vid="PSA 107:37">ते किसमां-किसमां केरे फल उगान।<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />यहोवा तैन एरी बरकत देते कि तैना बड़े बेधी गातन,</para>
  <para style="q" vid="PSA 107:38">ते तैन केरे जानबरन भी तै घटने न दे।<verse eid="PSA 107:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />फिरी आफतरे ते दुखेरे वजाई सेइं,</para>
  <para style="q" vid="PSA 107:39">तैना घटते देबोइ गातन।<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />त तै दुश्मन हकीमन बेज़ती सेइं लेदतां बत्तां सने टेपलोइतां जंगले मांमेइं भटकाते।<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />पन तै गरीबन दुखे करां छुटेइतां उच्‍चे पुड़ रखते,</para>
  <para style="q" vid="PSA 107:41">ते तैन्न भैड्डां केरे केन्नी केरे ज़ेरे परिवार देते।<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />सच़्च़े लोक हेरतां खुशी भोइ गातन;</para>
  <para style="q" vid="PSA 107:42">ते सब बुरे लोक अपनु आशी बंद केरतन।<verse eid="PSA 107:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />ज़ै कोई अक्लमन्द भोए, तै इन गल्‍लन पुड़ ध्यान केरेलो;</para>
  <para style="q" vid="PSA 107:43">ते यहोवारे प्यारेरे कम्मन पुड़ ध्यान केरेलो।<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">दुश्मन्न पुड़ ज़ींतरे उमीदरू गीत</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1" />हे परमेशर मेरो दिल मज़बूते;</para>
  <para style="q" vid="PSA 108:1">अवं गीत ज़ोइलो, अवं अपने दिले सेइं भी भजन ज़ोलो।<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2" />हे सैन्गी ते सितार बींझ़ां,</para>
  <para style="q" vid="PSA 108:2">अवं एप्पु लौ भोते बींझ़ो।<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3" />हे यहोवा, अवं मुल्खे-मुल्खेरे लोकन मां तेरू शुक्र केरेलो।</para>
  <para style="q" vid="PSA 108:3">ते रियासतां-रियासतां केरे लोकां केरे दरमियाने मां तेरू भजन ज़ोइलो।<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4" />किजोकि तेरी करुणा अम्बरे करां भी उच्‍चीए,</para>
  <para style="q" vid="PSA 108:4">ते तेरी सच़्च़ाई अम्बरे तगरे।<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5" />हे परमेशर, तू सुर्गे करां बह भोस,</para>
  <para style="q" vid="PSA 108:5">ते तेरी महिमा सैरी दुनियाई पुड़ भोए!<verse eid="PSA 108:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6" />एल्हेरेलेइ तेरे ट्लारे छुटाए गान,</para>
  <para style="q" vid="PSA 108:6">तू अपने देइने हथ्थे सेइं बच़ा ते इश्शी प्राथना केरो जुवाब दे!<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7" />परमेशरे एपनी पवित्रतैई मां एन ज़ोवरू</para>
  <para style="q" vid="PSA 108:7">“अवं खुशी सेइं शेकेम नगरे बेन्टेलो,</para>
  <para style="q" vid="PSA 108:7">ते सुक्‍कोतेरी वादी नापेइलो।<verse eid="PSA 108:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8" />गिलाद मेरोए, मनश्शे भी मेरो आहे;</para>
  <para style="q" vid="PSA 108:8">ते एप्रैम मेरे क्रोड़रो टोपे; यहूदा मेरी शाही सोटीए।<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9" />मोआबेरो मुल्ख मेरे धोनेरू भांडे,</para>
  <para style="q" vid="PSA 108:9">ते एदोमे पुड़ अवं अपनो बूट शैरेलो, ते पलिश्ते पुड़ जयजयकार केरेलो।”<verse eid="PSA 108:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10" />हे परमेशर, मीं क़िले बाले नगरे मां कौन पुज़ालो?</para>
  <para style="q" vid="PSA 108:10">एदोमे तगर केने अवं नेव?<verse eid="PSA 108:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11" />हे परमेशर, कुन तीं असां न शारे?</para>
  <para style="q" vid="PSA 108:11">ते हे परमेशर, तू जंगी मां इश्शी सेनाई अग्री-अग्री न च़लो।<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12" />दुश्मनेरे खलाफ इश्शी मद्दत केर</para>
  <para style="q" vid="PSA 108:12">किजोकि मैन्हेरी मद्दत बेकारे!<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13" />परमेशरेरी मद्दती सेइं असां बहदरी हिरामेले,</para>
  <para style="q" vid="PSA 108:13">इश्शे दुश्मन्न तैए ढ्लन्च़ी देलो।<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">झूठे इलज़ाम लाने बालां केरे खलाफ बिनती</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1" />हे परमेशर तू, ज़ेसेरी अवं तारीफ़ केरताईं, च़ुप न रा!<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />किजोकि दुष्ट ते कपटी मैन्हेईं मेरे खलाफ आशी खोलोरूए,</para>
  <para style="q" vid="PSA 109:2">तैना मेरे बारे मां झूठ ज़ोतन<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />तैना मेरे च़ेवरे पासन नफरतरी गल्‍लन सेइं साथी आन,</para>
  <para style="q" vid="PSA 109:3">ते बेफैइदे मीं सेइं लड़तन।<verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />मेरे प्यारेरे बदले मां तैना मेरी चोगली केरतन,</para>
  <para style="q" vid="PSA 109:4">पन अवं तैन केरे लेई प्राथना केरताईं।<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />तैनेईं भलियाई केरनेरे बदले मां मीं सेइं बुराई की</para>
  <para style="q" vid="PSA 109:5">ते मेरे प्यारेरे बदले मीं सेइं बैर कियोरोए।<verse eid="PSA 109:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />मेरे दुश्मन ज़ोतन, तू तैस कोन्ची दुष्टेरे अधिकारे मां रख,</para>
  <para style="q" vid="PSA 109:6">ते कोई मुखालफ तैसेरे देइने पासे खड़ो राए।<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />ज़ैखन तैसेरो न्याय कियो गाए, तैखन तै दोषी निस्से,</para>
  <para style="q" vid="PSA 109:7">ते तैसेरी प्राथना पाप गनी गाए!<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />तैसेरे दिहाड़े थोड़े भोन,</para>
  <para style="q" vid="PSA 109:8">ते तैसेरी पदवी होरो ने!<verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />तैसेरे बच्‍चे अनाथ भोइ गान,</para>
  <para style="q" vid="PSA 109:9">ते तैसेरी कौन्श विधवा भोए।<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />तैसेरे बच्‍चे दरबदर फिरन हंठन, ते भीख मघन,</para>
  <para style="q" vid="PSA 109:10">तैन अपने उज़ड़ोरे घरे करां दूर गेइतां रोट्टी मगनी पे!<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />ज़ैस करां तैनी कर्ज़ो आनोरो थियो, तै तैसेरे सैरी माले पुड़ कब्ज़ो केरे,</para>
  <para style="q" vid="PSA 109:11">ते परदेशी तैसेरी कमाई लुटतां नेन।<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />कोई न भोए कि ज़ै तैस पुड़ महरबानी केरे,</para>
  <para style="q" vid="PSA 109:12">ते तैसेरे अनाथ बच्‍चन पुड़ कोई तरस न खाए!<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />तैसेरी औलाद नाश भोइ गाए,</para>
  <para style="q" vid="PSA 109:13">दूइयोवं पीढ़ी मां तैसेरू नवं मिटी गाए!<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />तैसेरे सियांनां केरो अधर्म यहोवा याद राए,</para>
  <para style="q" vid="PSA 109:14">ते तैसेरी अम्मरो पाप न मिटे!<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />तैन केरो पाप लगातार यहोवारे सामने राए,</para>
  <para style="q" vid="PSA 109:15">तैन केरू नवं ज़मीनी पुड़ेरां मिटेई दे।<verse eid="PSA 109:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />किजोकि तै दुष्ट दया केरनी बिसरी जेव</para>
  <para style="q" vid="PSA 109:16">बल्के गरीबन ते ज़रूरतमन्दन सतातो थियो</para>
  <para style="q" vid="PSA 109:16">ते मनेरी इच्छाई सेइं दुखी मने बालन पत्ती पेवरो थियो।<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />तै लानत देने सेइं प्यार केरतो थियो, ते लानत तैस पुड़ आई;</para>
  <para style="q" vid="PSA 109:17">तै आशिर्वाद देने सेइं खुशी न थियो,</para>
  <para style="q" vid="PSA 109:17">एल्हेरेलेइ आशिर्वाद तैस करां दूर राव।<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />तै लानत देनी लिगड़ेरो ज़ेरो लातो थियो,</para>
  <para style="q" vid="PSA 109:18">ते तै तैसेरे पेटे मां पैनेरे ज़ेरे</para>
  <para style="q" vid="PSA 109:18">ते तैसेरी हेड्डन मां तेलेरे ज़ेरे समेई जेव।<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />तै कपड़ेरी ज़ेरि तैन सेइं पिलैटोरी राए,</para>
  <para style="q" vid="PSA 109:19">पटकेरी ज़ेरि तैन केरे लख्खे सेइं पिलैट्टोरी राए।<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />यहोवारे तरफां मेरे खलाफत केरनेबालन,</para>
  <para style="q" vid="PSA 109:20">ते मेरे खलाफ बुरू ज़ोनेबालन ई बदलो मैल्हे!<verse eid="PSA 109:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />पन हे यहोवा प्रभु, तू अपने नंव्वेरे खातर मीं सेइं बर्ताव केर;</para>
  <para style="q" vid="PSA 109:21">तेरी दया बड़ीए, एल्हेरेलेइ तू मीं छुटकारो दे।<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />किजोकि अवं गरीब ते ज़रूरतमन्द आईं,</para>
  <para style="q" vid="PSA 109:22">ते मेरो दिल बड़ो ज़खमी भोवरोए।<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />अवं ड्लवझ़री छावरो ज़ेरो खतम भोनेबालो आईं;</para>
  <para style="q" vid="PSA 109:23">अवं टिट्टां केरो ज़ेरो उडारो जेवरोईं।<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />बरत रखते-रखते मेरां ज़ैंधू थरकने लगोरन;</para>
  <para style="q" vid="PSA 109:24">ते मीं मां चर्भी न राने सेइं अवं शुक्‍की जेवरोईं।<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />मेरी त तैन लोकन सेइं बदनामी भोतीए;</para>
  <para style="q" vid="PSA 109:25">ज़ैखन तैना मीं हेरतन, तैखन क्रोड़ी हिलातन।<verse eid="PSA 109:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />हे मेरे परमेशर यहोवा, मेरी मद्दत केर!</para>
  <para style="q" vid="PSA 109:26">अपने प्यारेरे मुताबिक मेरी मद्दत केर।<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />ज़ैस सेइं मेरे दुश्मन्न पतो लग्गे कि इन तेरू कम्मे,</para>
  <para style="q" vid="PSA 109:27">ते हे यहोवा, तींए इन कियोरूए!<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />तैना मीं लानत देते त राए, पन तू मीं बरकत देइयां,</para>
  <para style="q" vid="PSA 109:28">ते तैना हमलो केरनेरे लेई खड़े भोते शरमिन्दा भोन, पन तेरो दास खुश भोए।<verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />मेरे मुखालफन बेइज़्ज़तरां लिगड़ां लुवां गान,</para>
  <para style="q" vid="PSA 109:29">ते तैना एपनी बेज़ती कम्बलेरी ज़ेरि पिलैट्टन।<verse eid="PSA 109:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />अवं यहोवारू बड़ू शुक्र केरेलो,</para>
  <para style="q" vid="PSA 109:30">ते बड़े लोकन मां तैसेरी तारीफ़ केरेलो।<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />किजोकि यहोवा गरीबेरे देइने पासे खड़ो रालो,</para>
  <para style="q" vid="PSA 109:31">ताके तैस मौतरी सज़ाह देनेबालन करां बच़ाए।<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">मसीह राज़ केरनेरे बारे मां एलान</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1" />यहोवा मेरे प्रभु सेइं ज़ोवं, “तू मेरे देइने पासे बिश,</para>
  <para style="q" vid="PSA 110:1">ज़ांतगर अवं तेरे दुश्मन तेरे पव्वां केरि चौकी न बनेई।”<verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />तेरे शेक्तरो राज़दण्ड यहोवा सिय्योनेरां भेज़ेलो।</para>
  <para style="q" vid="PSA 110:2">तू अपने दुश्मना केरे दरमियाने मां राज़ केर।<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />तेरे लोक तेरे शेक्तरे दिहाड़े अपने मेर्ज़री बलि बनतन;</para>
  <para style="q" vid="PSA 110:3">तेरे जुवान लोक पवित्रता सेइं सज़ोरेन,</para>
  <para style="q" vid="PSA 110:3">ते झ़ेझ़ेरे गर्भे सेइं ज़र्मोरी ओशरे ज़ेरे तीं कां आन।<verse eid="PSA 110:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />यहोवा कसम खेवरीए, तै न पसतालो,</para>
  <para style="q" vid="PSA 110:4">“तू मलिकिसिदकेरे रीति पुड़ हमेशारो याजक आस।”<verse eid="PSA 110:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />प्रभु तेरे देइने पासे भोइतां</para>
  <para style="q" vid="PSA 110:5">अपने क्रोधेरे दिहाड़े राज़न चूर केरेलो।<verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />तै कौमां केरो न्याय केरेलो, ते मैइदान लाशन सेइं भेरोलू;</para>
  <para style="q" vid="PSA 110:6">तै लम्मे चौड़े मुल्खन मां प्रधान्न चूर-चूर केरेलो।<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />बत्ते च़लते तै दरियाएरू पानी पीलो</para>
  <para style="q" vid="PSA 110:7">ते तैखन तै ज़ींतनेरां बाद एपनी क्रोड़ी उच्‍चो केरेलो।<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">परमेशर सच़्च़ो ते न्याय केरनेबालोए एल्हेरेलेइ तारीफ़रू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />यहोवारी तारीफ़ केरा।<note caller="+" style="f"><char style="fr" closed="false">111:1 </char><char style="fq" closed="false">तारीफ़ केरा </char><char style="ft" closed="false">हल्‍लिलूय्याह</char></note> अवं सिद्धे लोकां केरे टोली मां</para>
  <para style="q" vid="PSA 111:1">ते मेण्डली मां पूरे मने सेइं यहोवारू शुक्र केरेलो।<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />यहोवारां कम्मां बड़ां महान आन,</para>
  <para style="q" vid="PSA 111:2">ज़ेत्रे तैस सेइं खुश भोतन, तैना तैन पुड़ ध्यान केरतन।<verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />तैसेरां सब कम्मां शानदार ते महिमा बालन,</para>
  <para style="q" vid="PSA 111:3">ते तैसेरो धर्म सदा तगर बनोरो रालो।<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />तैनी अपने चमत्कार याद कराए,</para>
  <para style="q" vid="PSA 111:4">यहोवा अनुग्रह केरनेबालो ते दया केरनेबालोए।<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />ज़ैना तैसेरो डर मनतन तैन्न तैनी खाने जो दित्तोरिए,</para>
  <para style="q" vid="PSA 111:5">तै हमेशा तगर अपनो करार याद रखेलो।<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />तैनी अपने लोकन कौमां-कौमां केरो हिस्सो देनेरे लेई,</para>
  <para style="q" vid="PSA 111:6">अपने कम्मां केरि शक्ति हिरेवरीए।<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />सच़्च़ाई ते न्याय तैसेरे हथ्थां केरां कम्मन;</para>
  <para style="q" vid="PSA 111:7">तैसेरे सारे हुक्म भरोसेरे काबलन,<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />तैसेरे शब्द हमेशा-हमेशा अटल राले,</para>
  <para style="q" vid="PSA 111:8">तैना सच़्च़ाई ते सिद्धाई सेइं कियोरन।<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />तैनी अपने लोकन छुटकारो दित्तोरोए;</para>
  <para style="q" vid="PSA 111:9">तैने अपनो करार हमेशारे लेई रखोरोए।</para>
  <para style="q" vid="PSA 111:9">तैसेरू नवं पवित्र ते डरेरे काबले।<note caller="-" style="x"><char style="xo" closed="false">111:9 </char><char style="xt" closed="false"><ref loc="LUK 1:49">लूक. 1:49</ref>,<ref loc="LUK 1:68">68</ref>.</char></note><verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />अक्लरी शुरुआत यहोवारो डरे;</para>
  <para style="q" vid="PSA 111:10">ज़ेत्रे तैसेरे हुक्म मनतन,</para>
  <para style="q" vid="PSA 111:10">तैन केरि समझ़ रोड़ी भोतीए।</para>
  <para style="q" vid="PSA 111:10">तैसेरी तारीफ़ सदा बनोरी राली।<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">धर्मी मैन्हेरी पिशान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />यहोवारी तारीफ़ केरा!</para>
  <para style="q" vid="PSA 112:1">केत्रो धने तै मैन्हु ज़ै यहोवारो डर मन्ते,</para>
  <para style="q" vid="PSA 112:1">ते तैसेरे हुक्मन सेइं बड़ो खुशी भोते!<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />तैसेरी औलाद मुल्खे मां ताकतबर भोल्ही,</para>
  <para style="q" vid="PSA 112:2">ते सच़्च़े लोकां केरि औलादी बरकत मैल्हेली।<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />धन-दौलत तैसेरे घरे मां रहतीए;</para>
  <para style="q" vid="PSA 112:3">ते तैसेरी धार्मिकता हमेशा बनोरी रहतीए।<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />सच़्च़े लोकां केरे लेई आंधरे मां लौ निसतीए।</para>
  <para style="q" vid="PSA 112:4">तै अनुग्रह केरनेबालो, दया केरनेबालो ते धर्मी भोते।<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />ज़ै मैन्हु दया केरते ते ओधार देते,</para>
  <para style="q" vid="PSA 112:5">ते ईमानदैरी सेइं अपना कम्मां केरते, तैसेरू कल्याण भोते।<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />तै त सदा तगर अटल रालो;</para>
  <para style="q" vid="PSA 112:6">धर्मी मैन्हेरी हमेशा याद राली।<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />तै बुरी खबरी करां न डरे;</para>
  <para style="q" vid="PSA 112:7">तैसेरो दिल यहोवा पुड़ भरोसो रखने सेइं कायम रहते।<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />तैसेरो दिल सम्भालोरोए, एल्हेरेलेइ तै न डरेलो,</para>
  <para style="q" vid="PSA 112:8">बल्के अपने दुश्मन्न पुड़ नज़र केरेलो।<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />तैनी बड़ू जादे ज़रूरतमन्दन दान दित्तू,</para>
  <para style="q" vid="PSA 112:9">ते तैसेरो धर्म सदा बनोरो रालो,</para>
  <para style="q" vid="PSA 112:9">ते तैसेरू शिंग<note caller="+" style="f"><char style="fr" closed="false">112:9 </char><char style="fq" closed="false">शिंग </char><char style="ft" closed="false">शक्ति</char></note> आदरी सेइं उच्‍चु कियूं गालू।<verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />दुष्ट इन हेरतां सेरकोलो;</para>
  <para style="q" vid="PSA 112:10">तै दंत च़ैपती-च़ैपती गेली गालो;</para>
  <para style="q" vid="PSA 112:10">दुष्टां केरि खुवैइश पूरी न भोल्ही।<note caller="-" style="x"><char style="xo" closed="false">112:10 </char><char style="xt" closed="false"><ref loc="ACT 7:54">प्रेरित. 7:54</ref>.</char></note><verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">तारीफ़रे काबल नवं</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />यहोवारी तारीफ़ केरा।<note caller="+" style="f"><char style="fr" closed="false">113:1 </char><char style="fq" closed="false">यहोवारी तारीफ़ केरा </char><char style="ft" closed="false">हालेलुय्याह</char></note></para>
  <para style="q" vid="PSA 113:1">हे यहोवारे सेवकव, तारीफ़ केरा,</para>
  <para style="q" vid="PSA 113:1">यहोवारे नंव्वेरी तारीफ़ केरा!<note caller="-" style="x"><char style="xo" closed="false">113:1 </char><char style="xt" closed="false"><ref loc="JOB 36:7">अय्यू. 36:7</ref>.</char></note><verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />यहोवारू नवं</para>
  <para style="q" vid="PSA 113:2">हुन्ना करां लेइतां हमेशा तगर धन ज़ोवं गाए!<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />झ़ेझ़ां दिहाड़ो निसने करां देइतां ड्लवझ़ी दिहाड़ो डुबने तगर,</para>
  <para style="q" vid="PSA 113:3">यहोवारू नवं तारीफ़रे काबले।<verse eid="PSA 113:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />यहोवा सैरी कौमन पुड़ महाने,</para>
  <para style="q" vid="PSA 113:4">ते तैसेरी महिमा अम्बरे करां भी उच्‍चीए।<verse eid="PSA 113:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />इश्शे परमेशर यहोवारे बराबर कौने?</para>
  <para style="q" vid="PSA 113:5">तै त उच्‍ची ठैरी तखते पुड़ बिशोरोए।<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />ते तै अम्बर ते ज़मीनी पुड़</para>
  <para style="q" vid="PSA 113:6">तकनेरे लेई उन्ढे तकते।<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />तै कंगाले मित्ती पुड़ां</para>
  <para style="q" vid="PSA 113:7">ते ज़रूरतमन्दे मांज़नी पुड़ेरां खड़े केरतां उच्‍चो केरते।<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />कि तै तैस प्रधान्न सेइं साथी,</para>
  <para style="q" vid="PSA 113:8">मतलब अपने लोकां केरे प्रधान्न सेइं साथी बिशाले।<verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />तै बेऔलाद कौन्शी घरे मां खुशी मनाने बाली अम्मा बनाते।</para>
  <para style="q" vid="PSA 113:9">यहोवारी तारीफ़ केरा!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">फ़सह तिहारेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />ज़ैखन इस्राएली लोक मिस्र मुल्खे मरां, मतलब याकूबेरू टब्बर होरि भाषा केरनेबालन मरां निस्सू।<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />तैखन यहूदा यहोवारी पवित्र ठार,</para>
  <para style="q" vid="PSA 114:2">ते इस्राएल तैसेरे राज़्ज़ेरे लोक भोइ जे।<verse eid="PSA 114:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />एन हेरतां लाल समुन्दर नेश्शी जेव,</para>
  <para style="q" vid="PSA 114:3">ते यरदन दरिया उलटे पासे बगने लगो। <note caller="+" style="f"><char style="fr" closed="false">114:3 </char><char style="ft" closed="false">इस वचने मां भजन लिखने बालो कादेशेरे बीतनारे बारे मां ज़ोते। निर्ग. 17:1-7; गिन. 20:1-13; भज. 78:13-16,20 </char></note><verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />पहाड़ां हुड़ां केरां ज़ेरां उछ़ड़ने लगां,</para>
  <para style="q" vid="PSA 114:4">ते पहैड़ी भैड्डां-छ़ेल्‍ली केरे बच्‍चां केरि ज़ेरि उछ़ड़ने लेग्गी।<verse eid="PSA 114:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />हे समुन्दर तीं कुन भोवं, कि तू नेश्शी जेव?</para>
  <para style="q" vid="PSA 114:5">हे यरदन दरिया कुन भोवं कि तू नेश्शी जेव?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />हे पहाड़व, तुसन कुन भोवं, कि भैड्डां केरे ज़ेरे,</para>
  <para style="q" vid="PSA 114:6">ते पहैड़व तुसन कुन भोवं, कि तुस भैड्डां-छ़ेल्‍ली केरे बच्‍चां केरि ज़ेरि उछ़ड़ी?<verse eid="PSA 114:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />हे ज़मीन प्रभुएरे सामने,</para>
  <para style="q" vid="PSA 114:7">हाँ, याकूबेरे परमेशरेरे सामने थर्क।<verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />तै चट्टानी पैनेरे तालाब,</para>
  <para style="q" vid="PSA 114:8">चकमकेरे घोड़ पैनेरो नाग बनाते।<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">मूरती फुज़ूल ते परमेशरेरी वफादारी</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />हे यहोवा, इश्शी नईं, इश्शी नईं, बल्के अपने नव्वेंरी महिमा,</para>
  <para style="q" vid="PSA 115:1">ते एपनी दयाई ते सच़्च़ाइयरे खातर केर।<verse eid="PSA 115:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />कौमां-कौमां केरे लोक असन किजो पुछ़न,</para>
  <para style="q" vid="PSA 115:2">“तैन केरो परमेशर कोड़ि राव?”<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />इश्शो परमेशर त सुर्गे मांए;</para>
  <para style="q" vid="PSA 115:3">तैने ज़ैन चाऊ तैन्ने कियोरूए।<verse eid="PSA 115:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />तैन गैर लोकां केरि मूरती सोन्ने चैंदरी त आन,</para>
  <para style="q" vid="PSA 115:4">तैना मैन्हु केरे हथ्थेरी बेनोरिन।<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />तैन आशी त भोते पन तैना गल न केरि बटन;</para>
  <para style="q" vid="PSA 115:5">तैन केरि एछ़्छ़ी त भोतिन पन तैना लेही न बटन।<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />तैन केरे कन त भोतन, पन शुनी न बटन,</para>
  <para style="q" vid="PSA 115:6">तैन केरां नक्‍कां त भोतन, पन शिंघी न बटन।<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />तैन केरे हथ त भोतन, पन कोन्ची सेइं हुरी न बटन,</para>
  <para style="q" vid="PSA 115:7">तैन केरे पव त भोतन, पन तैना च़ेलि न बटन;</para>
  <para style="q" vid="PSA 115:7">ते तैन केरे गलेरां कोई आवाज़ न निस्सी बटे।<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />ज़ेरि तैना आन तेरहे तैन केरे बनाने बालेन;</para>
  <para style="q" vid="PSA 115:8">ते तैन पुड़ सब भरोसो रखनेबाले भी तेरहे भोइ गान।<verse eid="PSA 115:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />हे इस्राएल, यहोवा पुड़ भरोसो रख!</para>
  <para style="q" vid="PSA 115:9">ते मद्दत केरनेबालो, ते ढाल तैए आहे।<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />हे हारूनेरे घराना,<note caller="+" style="f"><char style="fr" closed="false">115:10 </char><char style="fq" closed="false">हारूनेरे घराना </char><char style="ft" closed="false">परमेशरेरे याजक</char></note> यहोवा पुड़ भरोसो रख!</para>
  <para style="q" vid="PSA 115:10">ते मद्दत केरनेबालो, ते ढाल तैए आहे।<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />हे यहोवा करां डरने बालाव, यहोवा पुड़ भरोसो रखा</para>
  <para style="q" vid="PSA 115:11">तुश्शी मद्दत केरनेबालो, ते ढाल तैए आहे।<verse eid="PSA 115:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />यहोवा असां याद कियोरेम, ते तैए असन बरकत देलो;</para>
  <para style="q" vid="PSA 115:12">तै इस्राएली लोकन बरकत देलो;</para>
  <para style="q" vid="PSA 115:12">तै हारूनेरे घराने बरकत देलो।<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />कुन निकड़े कुन बड्डे</para>
  <para style="q" vid="PSA 115:13">ज़ेत्रे यहोवा करां डरनेबालेन, तै तैन बरकत देलो।<verse eid="PSA 115:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />यहोवा तुसन ते तुश्शे खानदाने भी बद्धातो गाए।<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />यहोवा ज़ै अम्बर ते ज़मीन बनानेबालोए,</para>
  <para style="q" vid="PSA 115:15">तैसेरे तरफां तुसन बरकत मैल्हे।<verse eid="PSA 115:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />सुर्ग त यहोवारू आहे,</para>
  <para style="q" vid="PSA 115:16">पन धरती तैनी मैन्हु केरे हवाले कियोरीए।<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />मुड़दे ज़ेत्रे भी च़ुप आन,</para>
  <para style="q" vid="PSA 115:17">तैना यहोवारी तारीफ़ न केरि बटन।<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />पन असां लोक यहोवा जो,</para>
  <para style="q" vid="PSA 115:18">हुन्ना करां लेइतां हमेशा तगर धन ज़ोते राले,</para>
  <para style="q" vid="PSA 115:18">यहोवारी तारीफ़ केरा!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">मौती करां बच़नेरे लेई परमेशरेरू शुक्र</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />अवं परमेशरे सेइं प्यार केरताईं, एल्हेरेलेइ कि यहोवा मेरी बिनती शुनोरीए।<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />तैनी अपनो कन मेरे पासे लेवरोए,</para>
  <para style="q" vid="PSA 116:2">ते एल्हेरेलेइ अवं सैरी उमरी तैस्से पुकारतो रेइलो।<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />मौतरी रेस्सी मेरे च़ेवरे पासन थी;</para>
  <para style="q" vid="PSA 116:3">ते पातालेरी परेशैनी मीं पुड़ एवरी थी;</para>
  <para style="q" vid="PSA 116:3">मीं मुसीबत ते दुख झ़ैलनो पेव।<verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />तैखन मीं यहोवा कां प्राथना की,</para>
  <para style="q" vid="PSA 116:4">“हे यहोवा, मेरी बिनती शुन्तां मेरे प्राण बच़ा!”<verse eid="PSA 116:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />यहोवा महरबान ते धर्मीए;</para>
  <para style="q" vid="PSA 116:5">ते इश्शो परमेशर दया केरनेबालोए।<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />यहोवा सिद्धे सादे लोकां केरि हिफाज़त केरते;</para>
  <para style="q" vid="PSA 116:6">ज़ैखन अवं पस्त भोवरो थियो, त तैनी अवं बच़वरोईं।<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />हे मेरे प्राण, तू आरामेरी ठैरी वापस एई;</para>
  <para style="q" vid="PSA 116:7">किजोकि यहोवा तीं सेइं भलियाई कियोरीए।<verse eid="PSA 116:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />तीं त मेरी जान मौती करां,</para>
  <para style="q" vid="PSA 116:8">ते मेरी एछ़्छ़ी लेरां देने करां</para>
  <para style="q" vid="PSA 116:8">ते मेरे पव ठोकर खाने करां बच़ावरेन।<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />अवं ज़ींतो रहते,</para>
  <para style="q" vid="PSA 116:9">अपने आपे यहोवारे सामने ज़ैनतां च़लतो रेइलो।<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />मीं ज़ैन एरू ज़ोवरूए, इस यहोवारे विश्वासेरे कसौटी पुड़ केस्तां ज़ोवरूए।</para>
  <para style="q" vid="PSA 116:10">“अवं त बड़ो दुखी आईं;”<verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />मीं बड़े जल्दी ज़ोवं,</para>
  <para style="q" vid="PSA 116:11">“सब मैन्हु झूठे आन।”<verse eid="PSA 116:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />यहोवा मीं सेइं ज़ेत्री भलियाई कियोरीए,</para>
  <para style="q" vid="PSA 116:12">तैन केरे बदले अवं तैस कुन देईं?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />अवं मुक्तरो कुटोरो छ़ुइतां</para>
  <para style="q" vid="PSA 116:13">यहोवा कां प्राथना केरेलो,<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />अवं यहोवारे लेई अपनि मिन्नतां, सेभी केरे नज़री मां बांदे मां, तैसेरे सारे लोकां केरे सामने पूरी केरेलो।<verse eid="PSA 116:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />यहोवारे भक्तां केरि मौत</para>
  <para style="q" vid="PSA 116:15">तैसेरी नज़री मां बड़ी कीमतीए।<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />हे यहोवा, शुन अवं त तेरो दास आईं;</para>
  <para style="q" vid="PSA 116:16">अवं तेरो दास आईं, ते तेरी दैसरू मट्ठू आईं।</para>
  <para style="q" vid="PSA 116:16">तीं मेरे बन्धन खोलोरेन।<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />अवं तीं कां शुक्रेरी बलि च़ैढ़ेलो,</para>
  <para style="q" vid="PSA 116:17">ते यहोवा कां प्राथना केरेलो।<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18" />अवं यहोवारे लेई अपनि मिन्नतां,</para>
  <para style="q" vid="PSA 116:18">बांदे मां तैसेरे सारे लोकां केरे सामने<verse eid="PSA 116:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19" />यहोवारे भवनेरे अंगने मां,</para>
  <para style="q" vid="PSA 116:19">हे यरूशलेम, तेरे मझ़ाटे तैना पूरी केरेलो,</para>
  <para style="q" vid="PSA 116:19">यहोवारी तारीफ़ केरा!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">तारीफ़रू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />हे राष्ट्रां केरे सब लोकव, यहोवारी तारीफ़ केरा।</para>
  <para style="q" vid="PSA 117:1">हे रियासतां-रियासतां केरे लोकव, तैसेरी बडीयाई केरा!<note caller="-" style="x"><char style="xo" closed="false">117:1 </char><char style="xt" closed="false"><ref loc="ROM 15:11">रोम. 15:11</ref>.</char></note><verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />किजोकि, तैसेरी दया असन पुड़ बड़ीए,</para>
  <para style="q" vid="PSA 117:2">ते यहोवारी सच़्च़ाई हमेशारीए,</para>
  <para style="q" vid="PSA 117:2">यहोवारी तारीफ़ केरा।<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">ज़ींतनेरे लेई शुक्र</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />यहोवारू शुक्र केरा, किजोकि तै भलोए;</para>
  <para style="q" vid="PSA 118:1">ते तैसेरी दया हमेशारीए।<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />इस्राएली लोक ज़ोन,</para>
  <para style="q" vid="PSA 118:2">कि तैसेरी करुणा हमेशारीए।<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />हारूनेरो घरानो ज़ोए,</para>
  <para style="q" vid="PSA 118:3">कि तैसेरी करुणा हमेशारीए।<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />यहोवा परमेशरेरो डर मन्नेबाले ज़ोन,</para>
  <para style="q" vid="PSA 118:4">कि तैसेरो प्यार हमेशारोए।<verse eid="PSA 118:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />मुसीबती मां मीं यहोवा पुकारो</para>
  <para style="q" vid="PSA 118:5">ते तैनी मेरी पुकार शुन्तां मेरे पव खुल्‍ले ठारी मां पुज़ाए।<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />यहोवा मेरे पासे आहे, अवं न डेरेलो।</para>
  <para style="q" vid="PSA 118:6">इन्सान मेरू कुन बगैड़ी सकते?<verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />यहोवा मेरे पासे मेरो मद्दत केरनो बालोए;</para>
  <para style="q" vid="PSA 118:7">अवं अपने दुश्मन्न पुड़ नज़र केरतां खुश भोइलो।<verse eid="PSA 118:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />यहोवारी शरण नेनी,</para>
  <para style="q" vid="PSA 118:8">मैन्हु पुड़ भरोसो रखने करां रोड़ूए।<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />यहोवारी शरण नेनी,</para>
  <para style="q" vid="PSA 118:9">प्रधान्न पुड़ भरोसो रखने करां बड़ू रोड़ूए।<verse eid="PSA 118:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />सैरी कौमेईं अवं घेरोरोईं;</para>
  <para style="q" vid="PSA 118:10">पन यहोवारे नंव्वे सेइं अवं पक्‍को तैन अवं नाश केरेलो।<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />तैनेईं अवं घेरी छ़डोरोईं, इस मां शक नईं, तैनेईं अवं घेरोरोईं;</para>
  <para style="q" vid="PSA 118:11">पन यहोवारे नंव्वे सेइं अवं पक्‍को तैन नाश केरि छ़डेलो।<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />तैनेईं गणेरो ज़ेरो अवं च़ेवरे पासेईं घेरोरोईं,</para>
  <para style="q" vid="PSA 118:12">पन कंटां केरे झ़ैल्‍लां केरि अग्गरे ज़ेरे लूशी हिश्शी जेवरेन;</para>
  <para style="q" vid="PSA 118:12">यहोवारे नंव्वे सेइं अवं पक्‍को तैन्न नाश केरेलो।<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />दुश्मने मीं बड़ो धक्‍को त दित्तोरो थियो, कि अवं झ़ेड़ी गेईं,</para>
  <para style="q" vid="PSA 118:13">पन यहोवा मेरी मद्दत की।<verse eid="PSA 118:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />यहोवा मेरी ताकत ते भजनेरो विषय आहे,</para>
  <para style="q" vid="PSA 118:14">तै मेरी मुक्ति भोवरोए।<verse eid="PSA 118:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />धर्मी लोकां केरे डेरन मां जयजयकार ते मुक्तरी आवाज़ भोइ रेवरीए,</para>
  <para style="q" vid="PSA 118:15">यहोवारे देइने हथ्थे सेइं बड्डां-बड्डां कम्मां भोतन।<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />यहोवारो देइनो हथ महान भोवरोए,</para>
  <para style="q" vid="PSA 118:16">यहोवारे देइने हथ्थे सेइं बड्डां-बड्डां कम्मां भोतन!<verse eid="PSA 118:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />अवं न मरेलो बल्के ज़ींतो रेइलो,</para>
  <para style="q" vid="PSA 118:17">ते यहोवारां कम्मां केरू बियान केरेलो।<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />यहोवा मेरी बड़ी ताड़ना त कियोरीए,</para>
  <para style="q" vid="PSA 118:18">पन तैनी अवं मौतरे हवाले नईं कियोरो।<verse eid="PSA 118:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />धर्मेरू दार मेरे लेई खोल्‍ला,</para>
  <para style="q" vid="PSA 118:19">ताके अवं तैस मां दाखल भोइतां यहोवारू शुक्र केरेलो।<verse eid="PSA 118:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />एन्ने यहोवारू दारे,</para>
  <para style="q" vid="PSA 118:20">इस सेइं धर्मी लोक दाखल भोन।<verse eid="PSA 118:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />हे यहोवा, अवं तेरू शुक्र केरेलो,</para>
  <para style="q" vid="PSA 118:21">किजोकि तीं मेरी प्राथना शुनोरीए,</para>
  <para style="q" vid="PSA 118:21">ते मेरी ज़ींत भोइ जेवरीए।<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />ज़ै घोड़ मिस्त्रेईं रद्दी कियोरो थियो,</para>
  <para style="q" vid="PSA 118:22">तैए कूनेरो खास घोड़ भोइ जेव।<verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />इन त यहोवारे तरफां भोवरूए,</para>
  <para style="q" vid="PSA 118:23">इन इश्शी नज़री मां बड़ू बड्डू आहे।<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />अज़ तै दिहाड़ीए ज़ै यहोवा बनेवरीए;</para>
  <para style="q" vid="PSA 118:24">अस इस मां मघन ते खुश भोम।<verse eid="PSA 118:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />हे यहोवा मेरी बिनती शुन्तां मीं बच़ा!</para>
  <para style="q" vid="PSA 118:25">हे यहोवा, बिनती शुन, कामयाबी दे!<verse eid="PSA 118:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />धने तै ज़ै यहोवारे नंव्वे सेइं एइते!</para>
  <para style="q" vid="PSA 118:26">असेईं तुसन यहोवारे घरे मरां आशिर्वाद दित्तोरोए।<verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />यहोवा परमेशरे, ते तैने असन लौ दित्तोरीए।</para>
  <para style="q" vid="PSA 118:27">बलिदानेरे जानबरे वेदरे शिंगन सेइं बन्धा!<verse eid="PSA 118:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />हे यहोवा, तू मेरो परमेशरस, अवं तेरू शुक्र केरेलो;</para>
  <para style="q" vid="PSA 118:28">तू मेरो परमेशरस, अवं तेरी तारीफ़ केरेलो।<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />यहोवारू शुक्र केरा, किजोकि तै भलोए;</para>
  <para style="q" vid="PSA 118:29">ते तैसेरी दया हमेशा बनोरी रहचे!<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">परमेशरेरे कानूने पुड़ ध्यान</para>
  <para style="d">आलेफ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />धन तैना मैन्हु आन ज़ैन केरो चाल चलन रोड़ोए,</para>
  <para style="q" vid="PSA 119:1">ते ज़ैना यहोवारे कानूनेरे मुताबिक च़लतन।<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />धन आन तैना ज़ैना तैसेरे कानूने मनतन,</para>
  <para style="q" vid="PSA 119:2">ते पूरे दिले सेइं तैस कां एइतन।<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />फिरी तैना बुराई न केरन,</para>
  <para style="q" vid="PSA 119:3">तैना यहोवारे बत्तन पुड़ च़लतन।<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />हे यहोवा, तीं अपने उपदेश एल्हेरेलेइ दित्तोरेन,</para>
  <para style="q" vid="PSA 119:4">कि अस तैन दिले सेइं मन्नम।<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />रोड़ू भोथू कि</para>
  <para style="q" vid="PSA 119:5">तेरे हुक्म मन्नेरे लेई मेरो चाल चलन पक्‍को भोए!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />तैखन अवं तेरे सब हुक्मां केरे पासे ध्यान केरेलो,</para>
  <para style="q" vid="PSA 119:6">ते शरमिन्दा न भोल्हो।<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />ज़ैखन अवं तेरे धार्मिकतारे नियम शिखेलो,</para>
  <para style="q" vid="PSA 119:7">तैखन तेरू शुक्र सच़्च़े मने सेइं केरेलो।<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />अवं तेरे नियमन मन्नेलो:</para>
  <para style="q" vid="PSA 119:8">मीं पूरे तरीके सेइं न शार।</para>
  <para style="s" vid="PSA 119:8">कानून मन्नो</para>
  <para style="d" vid="PSA 119:8">बेथ<verse eid="PSA 119:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />जुवान अपनि चाल केन्च़रे सेइं शुद्ध रख्खे?</para>
  <para style="q" vid="PSA 119:9">तेरू वचन मन्ने सेइं।<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />अवं पूरे दिले सेइं तेरी तलाशी मां रेइलो;</para>
  <para style="q" vid="PSA 119:10">मीं अपने हुक्मे करां टेप्लोने न दे।<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />मीं तेरू वचन अपने मने मां रखोरू,</para>
  <para style="q" vid="PSA 119:11">कि तेरे खलाफ पाप न केरीं।<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />हे यहोवा तू धन आस;</para>
  <para style="q" vid="PSA 119:12">मीं एपनी विधि शिखाल!<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />तेरे ज़ोवरे नियमां केरू बियान,</para>
  <para style="q" vid="PSA 119:13">मीं अपने ज़बना सेइं कियोरूए।<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />अवं तेरे नियमां केरे बत्ती करां,</para>
  <para style="q" vid="PSA 119:14">मन्ना कि हर किसमेरे धन दौलती सेइं खुश भोवरोईं।<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />अवं तेरे उपदेशन पुड़ ध्यान देइलो,</para>
  <para style="q" vid="PSA 119:15">ते तेरी बत्तन तकतो रेइलो।<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />तेरे विधन सेइं मीं सुख मैल्हेलू;</para>
  <para style="q" vid="PSA 119:16">ते तेरे वचने न बिसरेलो।</para>
  <para style="s" vid="PSA 119:16">परमेशरेरे कानूने मां आनन्द</para>
  <para style="d" vid="PSA 119:16">गिमेल<verse eid="PSA 119:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />अपने दास मीं सेइं भलियाई केर,</para>
  <para style="q" vid="PSA 119:17">ते तेरे वचने पुड़ च़लतो रेईं।<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />मेरी एछ़्छ़ी खोल्‍ल, ताके अवं तेरे कानूनेरी</para>
  <para style="q" vid="PSA 119:18">हैरान केरनेरी सेच़्च़ी गल्‍लां हेरी।<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />दुनियाई मां अवं परदेशी आईं;</para>
  <para style="q" vid="PSA 119:19">अपने हुक्म मीं करां छ़ुपेइतां न रख!<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />मेरो मन तेरे नियमां केरे इच्छां केरे वजाई सेइं</para>
  <para style="q" vid="PSA 119:20">हर वक्त दुखी रहते।<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />तीं अभिमानी लोकन, ज़ैना लानती आन, झ़िड़क दित्ती,</para>
  <para style="q" vid="PSA 119:21">तैना तेरे हुक्मन करां भेटकी जेवरेन।<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />मेरी बदनामी ते बेइज़्ज़ती दूर केर,</para>
  <para style="q" vid="PSA 119:22">किजोकि मीं तेरे नियमन ट्लेइतां रखोरेन।<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />हाकिम भी बिशतां एप्पु मांमेइं मेरे खलाफ गल्‍लां केरते थिये,</para>
  <para style="q" vid="PSA 119:23">पन अवं, तेरो दास विधन पुड़ ध्यान केरतो राव।<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />तेरे नियम सुखेरो ज़िरियोए</para>
  <para style="q" vid="PSA 119:24">ते मीं सलाह देनेबालेन।</para>
  <para style="s" vid="PSA 119:24">परमेशरेरो कानून मन्नेरो फैसलो</para>
  <para style="d" vid="PSA 119:24">दाल्थ<verse eid="PSA 119:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />अवं धूड़ी मां पेवरोईं;</para>
  <para style="q" vid="PSA 119:25">मीं अपने वचनेरे मुताबिक ज़ींतो केर।<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />मीं अपनो चाल चलन तीं सेइं बियान कियोरोए, ते तीं मेरी गल मन्नोरीए;</para>
  <para style="q" vid="PSA 119:26">तू मीं एपनी विधि शिखाल।<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />अपने उपदेशां केरि बत मीं समझ़ा,</para>
  <para style="q" vid="PSA 119:27">ताके अवं तेरे हैरान केरनेबाले कम्मन पुड़ ध्यान केरेलो।<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />मेरी जान दुखेरे मारे पस्त भोइ जेवरीए;</para>
  <para style="q" vid="PSA 119:28">मीं अपने वचनेरे मुताबिक सम्भाल।<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />मीं झूठेरी बत्ती करां दूर केर;</para>
  <para style="q" vid="PSA 119:29">ते दया केरतां मीं अपनो कानून दे।<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />मीं सच़्च़ेरी बत च़ुनोरीए,</para>
  <para style="q" vid="PSA 119:30">ते नियमां केरे पासे अवं मन लेइलो।<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />अवं तेरे नियमन मां मघन रेइलो,</para>
  <para style="q" vid="PSA 119:31">हे यहोवा, मीं शरमिन्दा भोने न दे!<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />ज़ैखन तू मेरी समझ़ बधालो,</para>
  <para style="q" vid="PSA 119:32">त अवं तेरे हुक्मां केरि बत्ती पुड़ दौड़ेलो,</para>
  <para style="s" vid="PSA 119:32">समझ़रे लेई प्राथना।</para>
  <para style="d" vid="PSA 119:32">हे<verse eid="PSA 119:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />हे यहोवा मीं अपने विधि केरि बत हिरा;</para>
  <para style="q" vid="PSA 119:33">तैखन अवं तैस आखरी तगर ट्लेइतां रखेलो।<verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />मीं समझ़ दे, तैखन अवं तेरे कानूनेरे मुताबिक ज़िन्दगी गुज़ेरेलो,</para>
  <para style="q" vid="PSA 119:34">ते पूरे दिले सेइं तैस पुड़ च़लेलो।<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />अपने हुक्मां केरि बत्ती मां मीं च़ला,</para>
  <para style="q" vid="PSA 119:35">किजोकि अवं एस्से सेइं खुश आईं।<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />मेरो दिल लालच़ेरे पासे नईं,</para>
  <para style="q" vid="PSA 119:36">अपने नियमेरे पासे बदल।<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />मेरी एछ़्छ़न बेकार चीज़न<note caller="+" style="f"><char style="fr" closed="false">119:37 </char><char style="fq" closed="false">बेकार चीज़न </char><char style="ft" closed="false">झूठे ईश्वर </char></note> करां बदल,</para>
  <para style="q" vid="PSA 119:37">तू एपनी बत्ती पुड़ मीं ज़िन्दगी दे।<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />तेरो वाधो ज़ै तेरे डर मन्नेबालां केरे लेई आहे,</para>
  <para style="q" vid="PSA 119:38">तैस अपने दास, मेरे लेई भी पूरो केर।<note caller="-" style="x"><char style="xo" closed="false">119:38 </char><char style="xt" closed="false"><ref loc="ROM 1:16">रोम. 1:16</ref>.</char></note><verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />ज़ैस बदनामी करां अवं डरताईं, तैस दूर केर;</para>
  <para style="q" vid="PSA 119:39">किजोकि तेरे नियम रोड़े आन।<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />हेर अवं तेरे उपदेशां केरि बड़ी इच्छा रखताईं;</para>
  <para style="q" vid="PSA 119:40">अपने धार्मिकताई सेइं मीं ज़िन्दगी दे।</para>
  <para style="s" vid="PSA 119:40">परमेशरेरे कानूने पुड़ भरोसो</para>
  <para style="d" vid="PSA 119:40">वाव<verse eid="PSA 119:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />हे यहोवा, तेरो प्यार ते तेरी दित्तोरी मुक्ति,</para>
  <para style="q" vid="PSA 119:41">तेरे वाधेरे मुताबिक, मीं भी मैल्हे;<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />ताके अवं अपनि बदनामी केरनेबालन किछ जुवाब देइ सेखी,</para>
  <para style="q" vid="PSA 119:42">किजोकि मेरो भरोसो, तेरे वचन पुड़े।<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />मीं अपने सच़्च़े वचन ज़ोने करां न रोक</para>
  <para style="q" vid="PSA 119:43">किजोकि मेरी उमीद तेरे नियमन पुड़े।<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />तैखन अवं तेरे कानूने पुड़ लगातार,</para>
  <para style="q" vid="PSA 119:44">हमेशा च़लतो रेइलो;<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />ते अवं खुल्‍ले ठैरी मां च़लेलो फिरेलो,</para>
  <para style="q" vid="PSA 119:45">किजोकि मीं तेरे उपदेशां केरो खियाल रखोरोए।<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />ते अवं तेरे नियमेरी चर्चा राज़ां केरे सामने भी केरेलो,</para>
  <para style="q" vid="PSA 119:46">ते शरमिन्दा न भोइलो।<verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />किजोकि अवं तेरे हुक्मां केरे वजाई सेइं सुखी आईं,</para>
  <para style="q" vid="PSA 119:47">ते अवं तैन सेइं प्यार केरताईं।<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />अवं तेरे हुक्मां केरे पासे ज़ैन सेइं अवं प्यार केरताईं, हथ खलैरेलो</para>
  <para style="q" vid="PSA 119:48">ते तेरे विधन पुड़ ध्यान केरेलो।</para>
  <para style="s" vid="PSA 119:48">परमेशरेरे कानूने मां उमीद</para>
  <para style="d" vid="PSA 119:48">ज़ैन<verse eid="PSA 119:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />तैस वाधे याद केर, ज़ै तीं अपने दासे सेइं कियोरोए,</para>
  <para style="q" vid="PSA 119:49">किजोकि तीं मीं उमीद दित्तोरीए।<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />मेरे दुखे मां शान्ति तैस्से सेइं भोइ,</para>
  <para style="q" vid="PSA 119:50">किजोकि तेरे वचनेरे ज़िरिये मीं ज़िन्दगी मैल्होरीए।<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />घमण्ड केरने बालेईं मेरो हद्दी करां जादे मज़ाक बनेवरोए,</para>
  <para style="q" vid="PSA 119:51">फिरी भी अवं तेरे कानूने करां दूर न भोव।<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />हे यहोवा, मीं तेरे पुराने हुक्म याद केरतां</para>
  <para style="q" vid="PSA 119:52">शान्ति मैल्ही।<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />ज़ैन दुष्टेईं तेरो कानून शारोरोए,</para>
  <para style="q" vid="PSA 119:53">तैन केरे वजाई सेइं अवं क्रोधे सेइं फुकोताईं।<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />ज़ैड़ी अवं परदेशी भोइतां रहताईं, तैड़ी तेरी विधि</para>
  <para style="q" vid="PSA 119:54">मेरे गीत ज़ोनेरो विषय बेनोरिन।<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />हे यहोवा, राती मीं तेरू नवं याद कियोरूए,</para>
  <para style="q" vid="PSA 119:55">ते तेरे कानूने पुड़ च़लताईं।<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />इन अवं एल्हेरेलेइ केरतो एवरोईं,</para>
  <para style="q" vid="PSA 119:56">कि मीं तेरे उपदेश ट्लेइतां रखोरे थिये।</para>
  <para style="s" vid="PSA 119:56">कानूनेरे लेई भक्ति</para>
  <para style="d" vid="PSA 119:56">हेथ<verse eid="PSA 119:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />यहोवा मेरो हिस्सोए;</para>
  <para style="q" vid="PSA 119:57">मीं तेरे वचना केरे मुताबिक च़लनेरो फैसलो कियोरोए।<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />मीं पूरे मने सेइं बिनती की;</para>
  <para style="q" vid="PSA 119:58">एल्हेरेलेइ अपने वाधेरे मुताबिक मीं पुड़ दया केर।<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />मीं अपने चाल चलनेरे बारे मां सोचू,</para>
  <para style="q" vid="PSA 119:59">ते तेरे नियमेरी बत ट्लाई।<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />मीं तेरे हुक्म मन्ने मां च़िर न लाऊं, जल्दी की।<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />अवं दुष्टां केरि रेस्सन सेइं बेन्धोरोईं,</para>
  <para style="q" vid="PSA 119:61">फिरी भी मीं तेरो कानून न बिसरो।<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />तेरे धर्मी नियमां केरे वजाई सेइं</para>
  <para style="q" vid="PSA 119:62">अवं अध्धी राती तेरू शुक्र केरनेरे लेई उठेलो।<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />ज़ेत्रे तेरो डर मनतन ते तेरे उपदेशन पुड़ च़लतन,</para>
  <para style="q" vid="PSA 119:63">तैन केरो अवं साथी आईं।<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />हे यहोवा, तेरी दया धेरती पुड़ भेरतांए:</para>
  <para style="q" vid="PSA 119:64">तू मीं अपने विधि शिखाल!</para>
  <para style="s" vid="PSA 119:64">कानूनेरी खासयत</para>
  <para style="d" vid="PSA 119:64">टेथ<verse eid="PSA 119:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />हे यहोवा, तीं अपने वचनेरे मुताबिक</para>
  <para style="q" vid="PSA 119:65">अपने सेवक, मीं सेइं भलियाई कियोरीए।<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />मीं भले ज़मीरेरी शक्ति ते समझ़ दे,</para>
  <para style="q" vid="PSA 119:66">किजोकि मीं तेरे हुक्मन पुड़ विश्वास कियोरोए।<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />मुसीबत झ़ैलने करां पेइलो, अवं भटकोरो थियो;</para>
  <para style="q" vid="PSA 119:67">पन हुनी अवं तेरे वचन्न मनताईं।<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />हे यहोवा, तू भलो आस, ते भलियाई केरतस भी;</para>
  <para style="q" vid="PSA 119:68">मीं अपने विधि शिखाल।<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />अभिमान केरने बालेईं मेरे खलाफ झूठी गल्‍लां बनेई,</para>
  <para style="q" vid="PSA 119:69">पन अवं तेरे उपदेशन पूरे मने सेइं ट्लेइतां रखेलो।<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />तैन झूठां केरो मन मोट्टो भोइ जेवरोए,</para>
  <para style="q" vid="PSA 119:70">पन अवं तेरे कानूनेरे वजाई सेइं सुखी आईं।<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />मेरे लेई रोड़ू भोवं, कि मीं ज़ै दुख भोव,</para>
  <para style="q" vid="PSA 119:71">ज़ैस सेइं अवं तेरी विधि शिख्खी सेखी।<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />तेरो दित्तोरो कानून मेरे लेई</para>
  <para style="q" vid="PSA 119:72">हज़ारेईं रुपेइयन ते मोहरन करां भी जादे।</para>
  <para style="s" vid="PSA 119:72">कानूनेरो न्याय</para>
  <para style="d" vid="PSA 119:72">योध<verse eid="PSA 119:72" /></para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />तेरे हथ्थन सेइं अवं बनाव जेवरोईं</para>
  <para style="q" vid="PSA 119:73">मीं समझ़ दे कि अवं तेरे हुक्मन शिखी।<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />तीं करां डरने बाले मीं लेइतां खुश भोल्हे,</para>
  <para style="q" vid="PSA 119:74">किजोकि मीं तेरे वचने पुड़ उमीद रख्खोरीए।<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />हे यहोवा, मीं ई गल समझ़ी कि तेरे नियम धर्मी आन,</para>
  <para style="q" vid="PSA 119:75">ते तीं अपने सच़्च़ेरे मुताबिक मीं दुख दित्तोरोए,<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />तू अपने प्यारे सेइं मीं शान्ति दे,</para>
  <para style="q" vid="PSA 119:76">किजोकि तीं अपने दासे एरहो वाधो दित्तोरोए।<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />तेरी दया मीं पुड़ भोए, तैखन अवं ज़ींतो रेइलो;</para>
  <para style="q" vid="PSA 119:77">किजोकि अवं तेरे कानूने सेइं सुखी आईं।<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />अहंकार केरनेबाले शरमिन्दा किये गान, किजोकि तैनेईं अवं झूठेरे ज़िरिये बिछ़ोड़ो;</para>
  <para style="q" vid="PSA 119:78">पन अवं तेरे उपदेशन पुड़ ध्यान केरेलो।<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />ज़ैना तेरो डर मनतन, तैना मेरे पासे फिरन,</para>
  <para style="q" vid="PSA 119:79">तैखन तैना तेरे नियम शिखेले।<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />मेरो मन तेरी विधि मन्नेरे लेई सिद्ध भोए,</para>
  <para style="q" vid="PSA 119:80">एरू न भोए कि मीं शरमिन्दा भोनू पे।</para>
  <para style="s" vid="PSA 119:80">छुटकारेरे लेई प्राथना</para>
  <para style="d" vid="PSA 119:80">क़ाफ़<verse eid="PSA 119:80" /></para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />मेरे प्राण तेरे मुक्तरे लेई बेचैन आन;</para>
  <para style="q" vid="PSA 119:81">पन मीं तेरे वचने पुड़ उमीद रहतीए।<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />मेरी एछ़्छ़ी केरि लौ तेरे वाधे पूरे भोने बलगते-बलगते घेटी जेई;</para>
  <para style="q" vid="PSA 119:82">ते अवं ज़ोताईं कि तू मीं कैखन शान्ति देलो?<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />किजोकि अवं तूँए मां मसकरो ज़ेरो भोइ जेवरोईं,</para>
  <para style="q" vid="PSA 119:83">फिरी भी तेरी विधि न बिसरी।<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />तेरे दासेरे केत्रे दिहाड़े राहोरेन?</para>
  <para style="q" vid="PSA 119:84">ज़ैना मीं पत्ती पेवरेन तू तैन किताली सज़ाह देलो।<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />अहंकार केरनेबाले ज़ैना तेरे कानूने पुड़ न च़लन,</para>
  <para style="q" vid="PSA 119:85">ज़ैनेईं मेरे लेई गत्तां घड़ोरन।<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />तेरे सारे हुक्म भरोसेरे काबलन;</para>
  <para style="q" vid="PSA 119:86">तैना लोक झूठ ज़ोते मीं पत्ती पेवरेन;</para>
  <para style="q" vid="PSA 119:86">तू मेरी मद्दत केर!<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />तैना मीं इस ज़मीनी पुड़ेरां मुकानेरे नेड़े थिये,</para>
  <para style="q" vid="PSA 119:87">पन मीं तेरो उपदेश नईं शारोरो।<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />अपने प्यारेरे मुताबिक मीं ज़ींतो केर,</para>
  <para style="q" vid="PSA 119:88">तैखन अवं तेरे दित्तोरे नियम मन्नेलो।</para>
  <para style="s" vid="PSA 119:88">कानूने मां विश्वास</para>
  <para style="d" vid="PSA 119:88">लामेध<verse eid="PSA 119:88" /></para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />हे यहोवा, तेरू वचन,</para>
  <para style="q" vid="PSA 119:89">अम्बरे मां सदा तगर कायमे।<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />तेरी सच़्च़ाई पीढ़ी-पीढ़ी तगर कायम रहचे,</para>
  <para style="q" vid="PSA 119:90">तीं धरती बनाई, एल्हेरेलेइ तै कायम रहतीए।<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />तैना अज़्ज़ेरे दिहैड़ी तगर तेरे नियमां केरे मुताबिक टिकोरेन;</para>
  <para style="q" vid="PSA 119:91">किजोकि सारी सृष्टि तेरे अधीने।<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />अगर तेरे कानूने सेइं अवं खुश न भोथो,</para>
  <para style="q" vid="PSA 119:92">त अवं दुखेरे वक्ते नाश भोथो।<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />अवं तेरे उपदेश कधी न बिसरेलो;</para>
  <para style="q" vid="PSA 119:93">किजोकि तैन केरे ज़िरिये तीं अवं ज़ींतो कियोरोईं।<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />अवं तेरो आईं, तू मीं मुक्ति दे;</para>
  <para style="q" vid="PSA 119:94">किजोकि अवं तेरे उपदेशां केरि खबर रखताईं।<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />दुष्टी मेरी जान नाश केरनेरे लेई ताकी मां बिशोरेन,</para>
  <para style="q" vid="PSA 119:95">पन मीं तेरे नियमन पुड़ ध्यान लेइतां रखोरूए।<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />मीं लाहेरू आहे कि हर एक्‍की भरपूरारी भी हद भोतीए,</para>
  <para style="q" vid="PSA 119:96">पन तेरे हुक्मां केरि कोई हद नईं।</para>
  <para style="s" vid="PSA 119:96">कानूनेरे लेई प्यार</para>
  <para style="d" vid="PSA 119:96">मीम<verse eid="PSA 119:96" /></para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />आहा! अवं तेरे कानूने मां केत्रो प्यार रखताईं!</para>
  <para style="q" vid="PSA 119:97">पूरे दिहैड़ी मेरू ध्यान तैस्से मां लगोरू रहते।<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />तू अपने हुक्मन सेइं मीं अपने दुश्मन्न करां जादे अक्लमन्द केरतस,</para>
  <para style="q" vid="PSA 119:98">किजोकि तेरे हुक्म सदा मेरे मने मां रहतन।<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />मीं अपने सारे उस्तादन करां जादे समझ़ मैल्होरीए,</para>
  <para style="q" vid="PSA 119:99">किजोकि मेरू ध्यान तेरे नियमन पुड़ लगोरूए।<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />अवं बुज़ुर्गन करां भी जादे समझ़दार आईं,</para>
  <para style="q" vid="PSA 119:100">किजोकि अवं तेरे उपदेशन ट्लेइतां रखताईं।<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />मीं अपने पव हर एक्‍की बुरे बत्ती करां रोकतां रखोरेन,</para>
  <para style="q" vid="PSA 119:101">ज़ैस सेइं अवं तेरे वचनेरे मुताबिक च़ेलि।<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />अवं तेरे नियमन करां दूर नईं भोवरो,</para>
  <para style="q" vid="PSA 119:102">किजोकि तींए मीं शिक्षा दित्तोरीए।<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />तेरे वचन मीं केत्रे मिट्ठे लगतन,</para>
  <para style="q" vid="PSA 119:103">तैना मेरे ऐशी मां मैछ़ी करां मिट्ठे आन!<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />तेरे उपदेशां केरे वजाई सेइं अवं समझ़दार भोइ गाताईं,</para>
  <para style="q" vid="PSA 119:104">एल्हेरेलेइ अवं सब बुरी बत्तन सेइं बैर रखताईं।</para>
  <para style="s" vid="PSA 119:104">कानूनेरी लौ</para>
  <para style="d" vid="PSA 119:104">नून<verse eid="PSA 119:104" /></para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />तेरू वचन मेरे पव्वां केरे लेई दीयो,</para>
  <para style="q" vid="PSA 119:105">ते मेरी बत्तरे लेई लौए।<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />मीं कसम कियोरीए, ते थापेरू आहे।</para>
  <para style="q" vid="PSA 119:106">कि अवं तेरे धर्मी नियमां केरे मुताबिक च़लेलो।<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />अवं बड़ो दुखे मां पेवरोईं;</para>
  <para style="q" vid="PSA 119:107">हे यहोवा, अपने वाधेरे मुताबिक मीं ज़ींतो केर।<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />हे यहोवा, मेरे वचन्न अपने मेर्ज़रे मुताबिक कबूल केर,</para>
  <para style="q" vid="PSA 119:108">ते अपने नियम मीं शिखाल।<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />मेरे प्राण लगातार मेरे तेई पुड़ रहतन,</para>
  <para style="q" vid="PSA 119:109">फिरी भी मीं तेरो कानून न बिसरो।<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />दुष्टेईं मेरे लेई फंदो लेइतां रखोरोए,</para>
  <para style="q" vid="PSA 119:110">पन अवं तेरे उपदेशां केरे बत्ती करां नईं टेपलोरो।<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />तेरे नियम मेरे हमेशारी जाईदात बेनि जेवरेन,</para>
  <para style="q" vid="PSA 119:111">किजोकि तैना मेरे दिलेरे खुशरी वजाह आन।<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />मीं अपनो मन इस गल्‍ली पुड़ लेवरोए,</para>
  <para style="q" vid="PSA 119:112">कि आखरी तगर तेरे विधन पुड़ सदा च़लतो रेईं।</para>
  <para style="s" vid="PSA 119:112">कानूने मां हिफाज़त</para>
  <para style="d" vid="PSA 119:112">सामेख<verse eid="PSA 119:112" /></para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />अवं दुमन्न सेइं नफरत केरताईं,</para>
  <para style="q" vid="PSA 119:113">पन तेरे कानूने सेइं प्यार केरताईं।<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />तू मेरे छ़पनेरी ठार ते ढाल आस;</para>
  <para style="q" vid="PSA 119:114">मेरी उमीद तेरे वचन्न पुड़े।<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />हे कुकर्म केरनेबालव, मीं करां दूर भोथ,</para>
  <para style="q" vid="PSA 119:115">कि अवं अपने परमेशरेरे हुक्म ट्लेइतां रेखी!<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />हे यहोवा, अपने वचनेरे मुताबिक मीं सम्भाल, कि अवं ज़ींतो रेईं,</para>
  <para style="q" vid="PSA 119:116">मेरी उमीदी न ट्लोड़!<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />मीं ट्लेइतां रख, तैखन अवं बच़ोरो रेइलो,</para>
  <para style="q" vid="PSA 119:117">ते लगातार तेरी विधि केरे पासे मन लेइतां रेखेलो!<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />ज़ेत्रे तेरे विधि केरे बत्ती करां भेटकी गातन,</para>
  <para style="q" vid="PSA 119:118">तैन सेभन तू घटिया ज़ानतस,</para>
  <para style="q" vid="PSA 119:118">किजोकि तैन केरि च़लाकी झूठे।<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />तीं धेरतरे सब दुष्ट मैलेरे ज़ेरे दूर कियोरेन;</para>
  <para style="q" vid="PSA 119:119">इस वजाई सेइं अवं तेरे नियमन सेइं प्यार रखताईं।<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />तेरे डरे सेइं मेरी जान थेरकी गाचे,</para>
  <para style="q" vid="PSA 119:120">ते अवं तेरे नियमन करां डरताईं।</para>
  <para style="s" vid="PSA 119:120">परमेशरेरे कानूने पुड़ च़लनू</para>
  <para style="d" vid="PSA 119:120">एन<verse eid="PSA 119:120" /></para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />मीं त न्याय ते धर्मेरू कम कियोरूए,</para>
  <para style="q" vid="PSA 119:121">तू मीं ज़ुलम केरनेबालां केरे हथ्थे मां न छ़ड।<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />अपने दासेरे भलियाइरे लेई ज़िमेवार बन,</para>
  <para style="q" vid="PSA 119:122">ताके अभिमानी लोक मीं पुड़ ज़ुलम न केरि बटन।<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />मेरी एछ़्छ़ी तीं करां मुक्ति हासिल केरने,</para>
  <para style="q" vid="PSA 119:123">ते धर्मेरे वचनेरे मुताबिक पूरे भोने बलगते-बलगते तैन केरि लौ घट भोवरी।<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />अपने दास, मीं सेइं अपने प्यारे मुताबिक बर्ताव केर,</para>
  <para style="q" vid="PSA 119:124">ते एपनी विधि मीं शिखाल।<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />अवं तेरो दास आईं, तू मीं समझ़ दे,</para>
  <para style="q" vid="PSA 119:125">कि अवं तेरे नियमन सेमझ़ी।<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />हुनी तै वक्त एवरोए, कि यहोवा कम केरेलो,</para>
  <para style="q" vid="PSA 119:126">किजोकि लोकेईं तेरो कानून ट्लोड़ोरोए।<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />एल्हेरेलेइ अवं तेरे हुक्मन सेइं सोन्ने बल्के खालिस सोन्ने करां भी जादे प्यार केरताईं।<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />एल्हेरेलेइ अवं तेरे सब उपदेशां केरे सब विषयन ठीक ज़ानताईं;</para>
  <para style="q" vid="PSA 119:128">ते सब बुरी बत्तन सेइं बैर रखताईं।</para>
  <para style="s" vid="PSA 119:128">कानूने पुड़ च़लनेरी इच्छा</para>
  <para style="d" vid="PSA 119:128">पे<verse eid="PSA 119:128" /></para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />तेरे कानून अद्भुत आन,</para>
  <para style="q" vid="PSA 119:129">एल्हेरेलेइ मेरो दिल तैन मन्ते।<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />तेरी गल्‍लां खुलने सेइं लौ भोचे,</para>
  <para style="q" vid="PSA 119:130">तैन सेइं सादे लोकन समझ़ एइचे।<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />अवं आशी खोलतां हंफने लगो,</para>
  <para style="q" vid="PSA 119:131">किजोकि अवं हुक्मां केरो ट्लिशोरो थियो।<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />तेरो प्यार ज़ेन्च़रे अपने नंव्वेरे प्यार रखनेबाले सेइं आहे,</para>
  <para style="q" vid="PSA 119:132">तेन्च़रे मेरे पासे भी फिरतां मीं पुड़ दया केर।<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />अपने वचने सेइं मेरे पव अपने बत्ती पुड़ पक्‍के केर,</para>
  <para style="q" vid="PSA 119:133">ते कोन्ची अनर्थ गल्‍ली मीं पुड़ हुकूमत केरने न दे।<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />अंधेर केरनेबाले मैन्हन करां मीं छुटा,</para>
  <para style="q" vid="PSA 119:134">तैखन अवं तेरे उपदेशन मन्नेलो।<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />अपने दास, मीं पुड़ अपने तुत्तरेरी लौ चमका,</para>
  <para style="q" vid="PSA 119:135">ते मीं एपनी विधि शिखाल।<note caller="-" style="x"><char style="xo" closed="false">119:135 </char><char style="xt" closed="false"><ref loc="PSA 145:17">भज. 145:17</ref>.</char></note><verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />मेरी एछ़्छ़न मरां बड़ां ऐंखरू निसतन,</para>
  <para style="q" vid="PSA 119:136">किजोकि लोक तेरे कानूने न मन्न।</para>
  <para style="s" vid="PSA 119:136">कानूनेरो न्याय</para>
  <para style="d" vid="PSA 119:136">सांदे<verse eid="PSA 119:136" /></para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />हे यहोवा तू धर्मी आस,</para>
  <para style="q" vid="PSA 119:137">ते तेरे नियम सिद्ध आन।<verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />तीं अपने नियम</para>
  <para style="q" vid="PSA 119:138">धर्म ते पूरी सच़्च़ाई सेइं ज़ोवरेन।<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />अवं तेरी धुनी मां भस्म भोइ राहोरोइं,</para>
  <para style="q" vid="PSA 119:139">किजोकि मेरे सतानेबालेईं तेरे वचन बिसरोरेन।<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />तेरू वचन रोड़ेच़ारे तेवरूए,</para>
  <para style="q" vid="PSA 119:140">एल्हेरेलेइ तेरो दास, अवं तैस मां प्यार रखताईं।<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />अवं निकड़ो ते घटिया आईं,</para>
  <para style="q" vid="PSA 119:141">फिरी भी अवं तेरे उपदेशन न बिसरी।<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />तेरी धार्मिकता हमेशारीए,</para>
  <para style="q" vid="PSA 119:142">ते तेरो कानून सच़्च़ोए।<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />मुसीबत ते परेशानी मीं पुड़ बड़ी एवरीए,</para>
  <para style="q" vid="PSA 119:143">पन अवं तेरे हुक्मन सेइं सुखी आईं।<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />तेरे नियम धर्मी आन;</para>
  <para style="q" vid="PSA 119:144">तू मीं समझ़ दे, कि अवं ज़ींतो रेईं।</para>
  <para style="s" vid="PSA 119:144">छुटकारेरे लेई प्राथना</para>
  <para style="d" vid="PSA 119:144">क़ाफ़<verse eid="PSA 119:144" /></para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />मीं पूरे दिले सेइं प्राथना कियोरीए,</para>
  <para style="q" vid="PSA 119:145">“हे यहोवा मेरी शुन!</para>
  <para style="q" vid="PSA 119:145">अवं तेरी विधि ट्लेइतां रखेलो।<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />मीं तीं कां प्राथना कियोरीए, तू मीं मुक्ति दे।”</para>
  <para style="q" vid="PSA 119:146">ते अवं तेरे नियमन मन्तो रेइलो।<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />मीं लौ भोने करां पेइले बिनती की:</para>
  <para style="q" vid="PSA 119:147">मेरी उमीद तेरे वचन्न पुड़ थी।<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />मेरी एछ़्छ़ी हर पहरे करां पेइली खुल्‍ली गैली,</para>
  <para style="q" vid="PSA 119:148">कि अवं तेरे वचने पुड़ ध्यान केरि।<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />एपनी दयारे मुताबिक मेरी आवाज़ शुन;</para>
  <para style="q" vid="PSA 119:149">हे यहोवा, अपने नियमां केरे रीतरे मुताबिक मीं ज़िन्दगी दे।<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />ज़ैना बुरैई अरे धुनी मां आन, तैना नेड़े एवरेन;</para>
  <para style="q" vid="PSA 119:150">तैना तेरे कानूने करां दूर आन।<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />हे यहोवा तू नेड़ेस,</para>
  <para style="q" vid="PSA 119:151">ते तेरे सब हुक्म सच़्च़ेन।<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />बड़े च़िरे करां अवं तेरे कानूने ज़ानताईं,</para>
  <para style="q" vid="PSA 119:152">कि तीं तैन केरि बुनीयाद हमेशारे लेई छ़डोरीए।</para>
  <para style="s" vid="PSA 119:152">मद्दतरी लेई बिनती</para>
  <para style="d" vid="PSA 119:152">रेश<verse eid="PSA 119:152" /></para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />मेरे दुख हेरतां मीं छुटा,</para>
  <para style="q" vid="PSA 119:153">किजोकि मीं तेरो कानून न बिसरो।<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />मेरो मुकदमो लड़, ते मीं छुटा;</para>
  <para style="q" vid="PSA 119:154">अपने वाधेरे मुताबिक ज़ींते केर।<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />दुष्टन मुक्ति मैल्हनी बड़ी मुश्किले,</para>
  <para style="q" vid="PSA 119:155">किजोकि तैना तेरे हुक्मेरी तलाशी मां न भोन।<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />हे यहोवा, तेरी दया त बड़ीए;</para>
  <para style="q" vid="PSA 119:156">एल्हेरेलेइ अपने नियमां केरे मुताबिक मीं ज़ींते केर।<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />मेरो पीछो केरनेबाले ते मेरे दुश्मना केरि तैधात बड़ीए,</para>
  <para style="q" vid="PSA 119:157">पन अवं तेरे कानूने करां न हटो।<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />अवं धोखो देनेबाले लेहितां नफरत केरताईं;</para>
  <para style="q" vid="PSA 119:158">किजोकि तैना तेरे वचनेरे मुताबिक ज़िन्दगी न गुज़ारन।<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />हेर, अवं तेरे उपदेशन सेइं केत्रो प्यार केरताईं!</para>
  <para style="q" vid="PSA 119:159">हे यहोवा, अपने प्यारेरे मुताबिक मीं ज़ींतो केर!<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />तेरे सारे वचन सच़्च़े आन;</para>
  <para style="q" vid="PSA 119:160">ते तेरो अक-अक धर्मी नियम हमेशा तगर अटल आहे।</para>
  <para style="s" vid="PSA 119:160">कानूनेरे लेई समर्पण</para>
  <para style="d" vid="PSA 119:160">शीन<verse eid="PSA 119:160" /></para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />हाकिम बेकारे मां मेरो पीछो केरतन,</para>
  <para style="q" vid="PSA 119:161">पन मेरो दिल तेरे वचना केरो डर मन्ते।<verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />ज़ेन्च़रे कोई लूट<note caller="+" style="f"><char style="fr" closed="false">119:162 </char><char style="fq" closed="false">लूट </char><char style="ft" closed="false">जंग ज़ींतां कब्ज़ो कियोरी चीज़ां</char></note> केरतां खुशी भोते,</para>
  <para style="q" vid="PSA 119:162">मीं तेरे वचनेरी खुशी तैस्से तरीके भोचे।<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />अवं झूठे सेइं नफरत त केरताईं,</para>
  <para style="q" vid="PSA 119:163">पन तेरे कानूने सेइं प्यार केरताईं।<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />तेरे धर्मी नियमां केरे वजाई सेइं रोज़</para>
  <para style="q" vid="PSA 119:164">सत बार तेरी तारीफ़ केरताईं।<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />तेरे कानूनेरे लेई प्यार रखनेबालन बड़ी शान्ति भोतीए;</para>
  <para style="q" vid="PSA 119:165">ते तैन्न कोई ठोकर न लग्गे।<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />हे यहोवा, अवं तीं करां मुक्ति मैल्हनेरी उमीद रखताईं;</para>
  <para style="q" vid="PSA 119:166">ते तेरे हुक्मन पुड़ च़लतो एवरोईं।<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />अवं तेरे कानूने पूरे दिले सेइं मनताईं,</para>
  <para style="q" vid="PSA 119:167">ते तैन सेइं बड़ो प्यार रखतो एवरोईं।<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />अवं तेरे उपदेशन ते कानूने मनतो एवरोईं,</para>
  <para style="q" vid="PSA 119:168">किजोकि मेरी सारी चाल तेरे सामने बांदीए।</para>
  <para style="s" vid="PSA 119:168">परमेशरे करां मद्दत मैल्हनेरे लेई इच्छा</para>
  <para style="d" vid="PSA 119:168">ताव<verse eid="PSA 119:168" /></para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />हे यहोवा, मेरी बिनती तीं तगर पुज़्ज़े,</para>
  <para style="q" vid="PSA 119:169">मीं अपने वचनेरे मुताबिक समझ़ दे।<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />मेरी बिनती तीं तगर पुज़्ज़े,</para>
  <para style="q" vid="PSA 119:170">अपने वचनेरे मुताबिक मीं छुटा।<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />मेरी ज़बानी सेइं हमेशा तेरी तारीफ़ भोती राए,</para>
  <para style="q" vid="PSA 119:171">किजोकि तू मीं अपने हुक्म शिखालतस।<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />अवं तेरे वचनेरू गीत ज़ोइलो,</para>
  <para style="q" vid="PSA 119:172">किजोकि तेरे सब हुक्म धर्मी आन।<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />तेरे हथ मेरी मद्दत केरनेरे लेई तियार रहतन,</para>
  <para style="q" vid="PSA 119:173">किजोकि मीं तेरे उपदेश कबूल कियोरेन।<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />हे यहोवा, अवं तीं करां मुक्ति हासिल केरनेरी उमीद रखताईं,</para>
  <para style="q" vid="PSA 119:174">ते अवं तेरे कानूने सेइं खुश आईं।<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />मीं ज़ींते रख, ताके तेरी तारीफ़ केरि सेखी,</para>
  <para style="q" vid="PSA 119:175">तेरे नियमन सेइं मेरी मद्दत भोए।<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />अवं हेरोरि भैड्डरो ज़ेरो टेपलोइ जेव;</para>
  <para style="q" vid="PSA 119:176">तू अपने दास, मीं तोप,</para>
  <para style="q" vid="PSA 119:176">किजोकि अवं तेरे हुक्मन न बिसरीं।<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">परमेशरे कां मद्दतरे लेई प्राथना</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1" />मुसीबतरे वक्ते मीं यहोवा कां प्राथना की,</para>
  <para style="q" vid="PSA 120:1">ते तैने मेरी शुनी।<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />हे यहोवा झूठ ज़ोनेबाले ऐशी सेइं</para>
  <para style="q" vid="PSA 120:2">ते धोखो देने बैली ज़िभी करां मेरी रक्षा केर।<verse eid="PSA 120:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />हे धोखो देनेबाली ज़िभ,</para>
  <para style="q" vid="PSA 120:3">तीं कुन मैल्हे? ते तीं सेइं साथी होरू कुन जादे कियूं गाए?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />बहादरेरे तिखे तीर,</para>
  <para style="q" vid="PSA 120:4">ते झाऊ बुट्टेरां अगरां!<verse eid="PSA 120:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />अफ़सोस, अफ़सोस कुन मीं मेशेके मां परदेशी भोइतां रानू पेवं</para>
  <para style="q" vid="PSA 120:5">ते केदार प्रदेशेरे तेम्बु मां बस्सनू पेवरूए।<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />बड़े वक्ते करां मीं मेलेरे बैरन सेइं साथी बिशनू पेवरूए।<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />अवं त मेल चाताईं;</para>
  <para style="q" vid="PSA 120:7">पन मेरे ज़ोते, तैना लड़नू चातन!<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">परमेशर इश्शी रक्षा केरते</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1" />अवं एपनी एछ़्छ़ी पहाड़ां केरे पासे केरेलो।</para>
  <para style="q" vid="PSA 121:1">मीं मद्दत कोट्ठां मैल्हेली?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />मीं मद्दत यहोवारे तरफां मैलतीए,</para>
  <para style="q" vid="PSA 121:2">ज़ै अम्बरे ते धरती बनानेबालोए।<verse eid="PSA 121:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />यहोवा तेरे पव्वन टलने न देलो,</para>
  <para style="q" vid="PSA 121:3">तेरो रक्षा केरनेबालो न झ़ुलेलो।<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />शुन, इस्राएलेरो रक्षा केरनेबालो,</para>
  <para style="q" vid="PSA 121:4">न ऊंगेलो ते न झ़ुलेलो।<verse eid="PSA 121:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />यहोवा तेरो रक्षा केरनेबालोए,</para>
  <para style="q" vid="PSA 121:5">यहोवा तेरे देइने पासे तेरी आड़े।<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />न दीसां धुप्पी सेइं,</para>
  <para style="q" vid="PSA 121:6">ते न राती चाँदनी तीं नुकसान पुज़ेई बटे।<verse eid="PSA 121:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />यहोवा हर आफती करां तेरी रक्षा केरेलो;</para>
  <para style="q" vid="PSA 121:7">तै तेरी जानी बिलकुल बच़ेइतां रखेलो।<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />यहोवा तेरे एजने-गाने मां</para>
  <para style="q" vid="PSA 121:8">तेरी हिफाज़त हुना करां सदा तगर केरतो राए।<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">यरूशलेमेरे शैन्तरे लेई प्राथना</para>
  <para style="d">दाऊदेरे सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1" />ज़ैखन लोकेईं<note caller="+" style="f"><char style="fr" closed="false">122:1 </char><char style="fq" closed="false">लोकेईं </char><char style="ft" closed="false">मेरे दोस्तेईं</char></note> मीं सेइं ज़ोवं, “एज्जा, अस यहोवारे भवने जो च़लम,”</para>
  <para style="q" vid="PSA 122:1">तैखन अवं बड़ो खुशी भोव।<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />हे यरूशलेम, तेरे फाटकन मां,</para>
  <para style="q" vid="PSA 122:2">अस खड़े अहम!<verse eid="PSA 122:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />हे यरूशलेम, तू एरे नगरेरो ज़ेरो बनोरोस,</para>
  <para style="q" vid="PSA 122:3">ज़ैसेरां घरां एक्‍की होरि सेइं मिलोरन।<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />तैड़ी गोट्ले-गोट्लेरे लोक यहोवारू शुक्र केरनेरे लेई गातन;</para>
  <para style="q" vid="PSA 122:4">ई इस्राएलेरे लेई गवाही आहे।<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />तैड़ी त न्यायेरे तखत,</para>
  <para style="q" vid="PSA 122:5">दाऊदेरे खानदानेरे लेई रखोरेन।<verse eid="PSA 122:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />यरूशलेमेरे सुखेरू वरदान मग्गा,</para>
  <para style="q" vid="PSA 122:6">तेरे प्यार केरनेबाले खुशी सेइं रान!<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />हे यरूशलेम, तेरी शहरपनाहरे अन्तर शान्ति,</para>
  <para style="q" vid="PSA 122:7">ते मेहलन मां सुख भोए।<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />अवं अपने पड़ोसन ते सैथी केरे लेई,</para>
  <para style="q" vid="PSA 122:8">अवं ज़ोइलो तीं मां शान्ति भोए!<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />अपने परमेशर यहोवारे भवनेरे लेई,</para>
  <para style="q" vid="PSA 122:9">अवं तेरी भलैइयरे लेई इच्छा केरेलो।<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">परमेशरेरी दयारे लेई प्राथना</para>
  <para style="d">सफरेरे लेई गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1" />हे सुर्गे मां तखते पुड़ बिश्शोरे परमेशर</para>
  <para style="q" vid="PSA 123:1">अवं एपनी एछ़्छ़ी तेरे पासे केरताईं!<note caller="+" style="f"><char style="fr" closed="false">123:1 </char><char style="ft" closed="false">हे यहोवा अवं प्राथनाई मां तेरे पासे सुर्गेरे पासे तकताईं, ज़ैट्ठां तू सैरी धेरती पुड़ राज़ केरतस।</char></note><verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />ज़ेन्च़रे गुलामेरी एछ़्छ़ी अपने मालिकेरे हथ्थेरे पासे,</para>
  <para style="q" vid="PSA 123:2">ते नौकरेनरी एछ़्छ़ी एपनी मालकिनरे हथ्थेरे पासे लेगोरी रेइचन,</para>
  <para style="q" vid="PSA 123:2">तेन्च़रे इश्शी एछ़्छ़ी इश्शे परमेशर यहोवारे पासे तैस वक्ते तगर लेगोरी रहेली,</para>
  <para style="q" vid="PSA 123:2">ज़ांतगर तै असन पुड़ दया न केरे।<verse eid="PSA 123:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />असन पुड़ दया केर, हे यहोवा असन पुड़ दया केर,</para>
  <para style="q" vid="PSA 123:3">किजोकि अस होरि केरि निन्दा सेइं बड़े भेरोई जे।<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />इश्शी ज़िन्दगी सुखी लोकां केरे लान ताने सेइं,</para>
  <para style="q" vid="PSA 123:4">ते घमण्डी लोकां केरे बेइज़्ज़ती सेइं बेड़ि भेरोई जेई।<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">परमेशर अपने लोकां केरि हिफाज़त केरनेबालोए</para>
  <para style="d">दाऊदेरे सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1" />इस्राएल एन ज़ोए।</para>
  <para style="q" vid="PSA 124:1">कि अगर इश्शे पासे यहोवा न भोथो,<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />अगर यहोवा तैस मौके इश्शे पासे न भोथो</para>
  <para style="q" vid="PSA 124:2">ज़ैखन इश्शे दुश्मनेईं असन पुड़ चढ़ाई की,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />त तैना असन तैखने ज़ींते निगली छ़डेथे,</para>
  <para style="q" vid="PSA 124:3">ज़ैखन तैन केरि सरक भखोरी थी।<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />असां तैखने पैनी मां डुबी गाथे,</para>
  <para style="q" vid="PSA 124:4">ते पैनी मां रुड़े गाथे।<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />ठाठां मारते पैनी मां असां तैखने रुड़ी गाने थिये।<verse eid="PSA 124:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />धने यहोवा,</para>
  <para style="q" vid="PSA 124:6">ज़ैनी असां तैन केरे दंतां केरे शिकार न भोने दित्ते।<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />इश्शी ज़िन्दगी च़ुड़ोली केरि ज़ेरि, शिकार केरनेबालेरे ज़ाले करां छुटा,</para>
  <para style="q" vid="PSA 124:7">ज़ाल फेटी जेवं ते असां बेंच़ी जे!<verse eid="PSA 124:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />यहोवा ज़ै आसमान ते ज़मीन बनानेबालोए,</para>
  <para style="q" vid="PSA 124:8">इश्शी मद्दत तैसेरे नंव्वे सेइं भोचे।<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">परमेशर अपने लोकां केरि ताकते</para>
  <para style="d">दाऊदेरे सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1" />ज़ैना यहोवा पुड़ भरोसो रखतन,</para>
  <para style="q" vid="PSA 125:1">तैना सिय्योन पहाड़ेरे ज़ेरेन,</para>
  <para style="q" vid="PSA 125:1">ज़ैन टले न, बल्के हमेशा टिकोरू रहते।<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />ज़ैस तरीके सेइं यरूशलेमेरे च़ेवरे पासे पहाड़न,</para>
  <para style="q" vid="PSA 125:2">तैस्से तरीके सेइं यहोवा अपने लोकां केरे च़ेवरे पासन</para>
  <para style="q" vid="PSA 125:2">अज़्ज़ेरो देंतो ते हमेशा तगर बनोरो रालो।<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />दुष्टां केरो राज़दण्ड धेर्मी केरे हिस्से पुड़ बनोरो न रालो,</para>
  <para style="q" vid="PSA 125:3">एरू न भोए कि धर्मी अपने हथ बुरे कम्मेरे पासे रखन।<verse eid="PSA 125:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />हे यहोवा भले लोकां केरो</para>
  <para style="q" vid="PSA 125:4">ते सिद्धे मने बालां केरू भलू केर!<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />पन ज़ैना मुड़तां ट्लेढी बत्तां च़लतन,</para>
  <para style="q" vid="PSA 125:5">तैन यहोवा अनर्थ कम्मां केरनेबालन सेइं साथी केढी देलो!<note caller="+" style="f"><char style="fr" closed="false">125:5 </char><char style="fq" closed="false">केढी देलो </char><char style="ft" closed="false">कैद या मौत</char></note></para>
  <para style="q" vid="PSA 125:5">कि इस्राएले शान्ति मैल्हे।<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">सिय्योनेरी खुशी सेइं वापसी</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1" />ज़ैखन यहोवा सिय्योने<note caller="+" style="f"><char style="fr" closed="false">126:1 </char><char style="fq" closed="false">सिय्योने </char><char style="ft" closed="false">ज़ैखन यहोवा असन गुलैमी करां आनेलो तैखन यहोवा असन खुशहाल बनालो। सिय्योन यरूशलेमेरू दूइयोवं नंव्वे।</char></note> मां वापस एजनेबालन वापस आने,</para>
  <para style="q" vid="PSA 126:1">तैखन अस सुपना हेरने बाले ज़ेरे भोए।<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />तैखन अस खुशी सेइं हसने</para>
  <para style="q" vid="PSA 126:2">ते जयजयकार केरने लग्गे;</para>
  <para style="q" vid="PSA 126:2">तैखन इश्शे बारे मां कौमी-कौमी मां ज़ोवं गातू थियूं,</para>
  <para style="q" vid="PSA 126:2">“यहोवा, इन सेइं साथी बड़ां-बड़ां कम्मां कियोरन।”<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />यहोवा असन सेइं बड़ां-बड़ां कम्मां कियोरन;</para>
  <para style="q" vid="PSA 126:3">ते इस सेइं अस खुशी अहम।<verse eid="PSA 126:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />हे यहोवा, दक्षिण मुल्खेरे नालां केरे ज़ेरे,</para>
  <para style="q" vid="PSA 126:4">इश्शे कैदन वापस आन!<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />ज़ैना बीज़ ऐंखरन सेइं बेतन,</para>
  <para style="q" vid="PSA 126:5">तैना खुशी सेइं कट्टेले।<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />चाए बेनेबालो बीज़ नेइतां लेरां देतो च़लो गाए,</para>
  <para style="q" vid="PSA 126:6">पन तै फिरी फैक्‍की घिन्तां पक्‍को जयजयकार केरतो वापस एज्जेलो।<note caller="+" style="f"><char style="fr" closed="false">126:6 </char><char style="ft" closed="false">फसल बेनेरो हिंवतड़े भोतो थियो ते अप्रैले मां कटनेरो वक्त थियो।</char></note><verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">परमेशरेरो आशिर्वाद</para>
  <para style="d">सुलैमानेरे सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1" />अगर यहोवा घर न बनाए,</para>
  <para style="q" vid="PSA 127:1">त बनाने बालेरी मेहनत बेकारे।</para>
  <para style="q" vid="PSA 127:1">ते अगर यहोवा नगरेरी हिफाज़त न केरे,</para>
  <para style="q" vid="PSA 127:1">त पहरेदारेरू बींझ़ू बिशनू बेकार भोल्हु।<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />तुस ज़ैना बींझ़तथ ते च़िरे तगर आराम केरतथ</para>
  <para style="q" vid="PSA 127:2">ते सैरी बड़ी मेहनत केरतां रोट्टी खातथ, इन सब तुश्शे लेई बेकारे;</para>
  <para style="q" vid="PSA 127:2">किजोकि यहोवा अपने ट्लारन एन्च़रे निड्ल देते।<verse eid="PSA 127:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />हेरा, बच्‍चे यहोवारे तरफां दित्तोरो हिस्सोए,</para>
  <para style="q" vid="PSA 127:3">गर्भेरो फल तैसेरे तरफां फले।<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />ज़ेन्च़रे बहादरेरे हथ्थे मां तीर,</para>
  <para style="q" vid="PSA 127:4">तेन्च़रे जुवैनरां मट्ठां भोतन।<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />केत्रो धने तै मैन्हु ज़ैने अपनो तरकश तीरन सेइं भरोरो भोए!</para>
  <para style="q" vid="PSA 127:5">तै नगरेरे फाटके कां अपने दुश्मन्न सेइं गल्‍लां केरतां शरमिन्दा न भोल्हो।<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">परमेशरेरो डर मन्नेरी बरकत</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1" />केत्रो धने तै मैन्हु ज़ै यहोवारो डर मन्ते,</para>
  <para style="q" vid="PSA 128:1">ते तैसेरे बत्तन पुड़ च़लते!<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />तू अपनि कमाई पक्‍की खेइ बटेलो;</para>
  <para style="q" vid="PSA 128:2">तू धन भोल्हो, ते तेरू भलू भोल्हु।<verse eid="PSA 128:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />तेरे घरे मां तेरी कौन्श फलदार दाछ़रे बड़हेरी ज़ेरि भोल्ही,</para>
  <para style="q" vid="PSA 128:3">तेरी रोट्टरे मेज़ेरे च़ेवरे पासन तेरे बच्‍चे ज़ैतूनेरे बुट्टां केरे ज़ेरे भोल्हे।<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />शुन, ज़ै मैन्हु यहोवारो डर मन्तो भोए,</para>
  <para style="q" vid="PSA 128:4">तैस एरी ज़ेरी बरकत मैल्हेली।<verse eid="PSA 128:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />यहोवा तीं सिय्योने मरां बरकत देलो,</para>
  <para style="q" vid="PSA 128:5">ते तू ज़िन्दगी भर यरूशलेमेरू सुख हेरतो रास!<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />बल्के तू अपने पोट्लड़न-धिहोड़न भी हेरेलो!</para>
  <para style="q" vid="PSA 128:6">इस्राएले शान्ति मैल्हे!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">सिय्योनेरे दुश्मन्न पुड़ ज़ींतरू गीत</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1" />इस्राएल हुनी इन ज़ोए,</para>
  <para style="q" vid="PSA 129:1">“मेरे बचपनेरे देंते मेरे दुश्मन मीं बार-बार दुख देते एवरेन।<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />मेरे बचपनेरे देंते लोक मीं बार-बार दुख त देते एवरेन</para>
  <para style="q" vid="PSA 129:2">पन मीं करां ज़ींती न सके।”<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />दांत लाने बालेईं मेरी पिठी पुड़ हल च़लाई,</para>
  <para style="q" vid="PSA 129:3">ते लेम्मी-लेम्मी सींथां बनेवरिन।<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />यहोवा धर्मीए,</para>
  <para style="q" vid="PSA 129:4">तैनी दुष्टां केरे फंदे केटतां अवं आज़ाद कियोरोईं।<verse eid="PSA 129:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />ज़ेत्रे भी सिय्योने सेइं बैर रखतन,</para>
  <para style="q" vid="PSA 129:5">तैन सब शरमिन्दा भोन, ते हैरोइतां पत्रोवं हटन।<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />तैना लाए पुड़ेरे घासेरे ज़ेरे भोन,</para>
  <para style="q" vid="PSA 129:6">ज़ै बेडोने करां पेइलो शुक्‍की गाते।<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />ज़ैस सेइं कोई फसल लुन्ने बालो च़प न ट्लेइ बटे,</para>
  <para style="q" vid="PSA 129:7">ते न बन्धने बालो फक्‍की बेन्धी बटे।<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />ते न एजने गानेबाले एन ज़ोन,</para>
  <para style="q" vid="PSA 129:8">“यहोवारी बरकत तुसन पुड़ भोए!</para>
  <para style="q" vid="PSA 129:8">असां तुसन यहोवारे नंव्वे सेइं आशिर्वाद देतम!”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">प्यार केरनेबालो परमेशर</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1" />हे यहोवा, मीं तू मुसीबतरे डुग्घे समुन्दरे मरां याद कियो!<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />हे प्रभु, मेरी शुन!</para>
  <para style="q" vid="PSA 130:2">तेरे कन्न मेरे बिनतरे पासे ध्याने सेइं लगोरे रान!<verse eid="PSA 130:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />हे यहोवा अगर तू इश्शे पापां केरो हिसाब केरस,</para>
  <para style="q" vid="PSA 130:3">त हे प्रभु कौन खड़ो रेईं बटते?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />पन तू माफ़ केरने बालोस,</para>
  <para style="q" vid="PSA 130:4">ज़ैस सेइं तेरो डर मन्नो गाए।<verse eid="PSA 130:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />अवं यहोवारे इंतज़ारे मां आईं, अवं दिले सेइं तैस बलगताईं,</para>
  <para style="q" vid="PSA 130:5">ते मेरी उमीद तैसेरे वचने पुड़े।<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />पहरदार ज़ेत्रे झ़ेझ़ां चातन, हाँ,</para>
  <para style="q" vid="PSA 130:6">पहरदार ज़ेत्रे झ़ेझ़ां चातन,</para>
  <para style="q" vid="PSA 130:6">तैस करां भी जादे अवं अपने यहोवा अपने प्राणन करां भी जादे चाताईं।<verse eid="PSA 130:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />हे इस्राएल, यहोवा पुड़ उमीद लेइतां रख!</para>
  <para style="q" vid="PSA 130:7">किजोकि यहोवा प्यार केरनेबालोए</para>
  <para style="q" vid="PSA 130:7">ते पूरो छुटकारो देनेबालोए।<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />यहोवा इस्राएले तैसेरे सैरी अधर्मेरे कम्मन करां छुटकारो देलो।<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">परमेशरे पुड़ भरोसो</para>
  <para style="d">दाऊदेरू सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1" />हे यहोवा, न मेरो दिल घमण्डे सेइं</para>
  <para style="q" vid="PSA 131:1">ते न मेरी नज़र घमण्डे सेइं भरोरी भोए;</para>
  <para style="q" vid="PSA 131:1">ज़ैना गल्‍लां बेड़ि ते मेरे लेई बेड़ि मुश्किलन,</para>
  <para style="q" vid="PSA 131:1">तैन सेइं अवं कम न रेखी।<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />सच़्च़े मीं अपनो मन शान्त ते च़ुप कियोरोए,</para>
  <para style="q" vid="PSA 131:2">ज़ेन्च़रे दुद्ध छुटेवरो बच्‍चो एपनी अम्मरे कुम्मे मां बिशते</para>
  <para style="q" vid="PSA 131:2">तेन्च़रे दुद्ध छुटेवरे बच्‍चेरो ज़ेरो मेरो मन भी रहते।<verse eid="PSA 131:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />हे इस्राएल, अज़्ज़ेरां पत्ती हमेशा-हमेशा यहोवा पुड़ उमीद लेइतां रा!<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">भवनेरे लेई प्राथना</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1" />हे यहोवा, दाऊदेरे खातर तैसेरी सैरी मुसीबतन याद केर।<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />तैनी यहोवा सेइं कसम खाइ,</para>
  <para style="q" vid="PSA 132:2">ते याकूबेरे सर्वशक्तिमान परमेशरेरी सारी मिन्नत मन्नी।<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />तैनी ज़ोवं, “पक्‍को अवं तैस वक्ते तगर अपने घरे न गेइलो,</para>
  <para style="q" vid="PSA 132:3">ते न अपने बिछ़ाने पुड़ गेइलो;<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />न अवं एपनी एछ़्छ़न निड्ल,</para>
  <para style="q" vid="PSA 132:4">ते न अपने पुंठन जपकी एजने देइलो।<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />ज़ांतगर यहोवारे लेई, अक ठार,</para>
  <para style="q" vid="PSA 132:5">मतलब याकूबेरे सर्वशक्तिमान परमेशरेरे लेई घर न बनेई।”<verse eid="PSA 132:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />असेईं एप्राता<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="fq" closed="false">एप्राता </char><char style="ft" closed="false">बैतलहम</char></note> मां तैसेरी चर्चा शुनोरीए,</para>
  <para style="q" vid="PSA 132:6">असन ई जंगलेरे मैइदाने मां मैल्ही।<verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />एज्जा असां तैसेरे घरे मां गाम,</para>
  <para style="q" vid="PSA 132:7">अस तैसेरे पव्वां केरि चौकी कां मथ्थो टेकम!<verse eid="PSA 132:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />हे यहोवा, उठतां अपने मन्दरे मां</para>
  <para style="q" vid="PSA 132:8">अपने शेक्तरे करारेरे सन्दूखे समेत आरामेरी ठारी मां एई।<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />तेरे याजक धार्मिकतारां लिगड़ां लेइतां रान,</para>
  <para style="q" vid="PSA 132:9">ते तेरे भक्त लोक जयजयकार केरन।<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />अपने दास दाऊदेरे लेई,</para>
  <para style="q" vid="PSA 132:10">ते ज़ै तीं च़ुनोरोए तैसेरी प्राथना अनशुनी न केर।<verse eid="PSA 132:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />यहोवा दाऊदे सेइं वाधो कियोरो थियो ते तै तैस करां न मुकरेलो:</para>
  <para style="q" vid="PSA 132:11">“अवं तेरे तखते पुड़ तेरे एक्‍की अपने मट्ठे बिशैलेलो।<verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />अगर तेरे खानदानेरे लोक मेरे करारे मन्न</para>
  <para style="q" vid="PSA 132:12">ते ज़ैना हदायतां तैन शिखालेलो, तैस पुड़ च़लन,</para>
  <para style="q" vid="PSA 132:12">त तैन केरे खानदानेरे लोक भी तेरे तखते पुड़ जुग-जुगे बिशते च़ले गान।”<verse eid="PSA 132:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />पक्‍को यहोवा सिय्योने च़ुनेलो,</para>
  <para style="q" vid="PSA 132:13">ते तैस अपने घरेरे लेई चाहे।<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />तीं ज़ोवं, “ई त जुगे-जुगेरे लेई मेरे आरामेरी ठारे;</para>
  <para style="q" vid="PSA 132:14">इड़ी अवं रेइलो, किजोकि मीं इन चाऊ।<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />अवं सिय्योनेरी खानेरी चीज़न पुड़ बड़ी बरकत देलो;</para>
  <para style="q" vid="PSA 132:15">ते इसेरे गरीबन रोट्टी सेइं रज़ानेलो।<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />इसेरे याजकन अवं मुक्तरां लिगड़ां लुवेइलो,</para>
  <para style="q" vid="PSA 132:16">ते इसेरे भक्त लोक उच्‍ची आवाज़ी सेइं जयजयकार केरेले,<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />तैड़ी अवं दाऊदेरू अक शिंग कढेलो,</para>
  <para style="q" vid="PSA 132:17">मीं अपने अभिषिक्त राज़ेरे लेई अक दीयो तियार केरतां रखोरोए।<verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />अवं तैसेरे दुश्मन बेइज़्ज़तरां लिगड़ां लुवेइलो,</para>
  <para style="q" vid="PSA 132:18">पन तैसेरे दोग्गे पुड़ तैसेरू ताज शोभने बालू रालू।”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">परमेशरेरे लोकां केरि एकता</para>
  <para style="d">दाऊदेरू सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1" />हेरा, इन केत्रू भलू आहे ते रोड़ी गल्‍ले।</para>
  <para style="q" vid="PSA 133:1">कि ढ्ला लोक<note caller="+" style="f"><char style="fr" closed="false">133:1 </char><char style="fq" closed="false">ढ्ला लोक </char><char style="ft" closed="false">परमेशरेरे लोक</char></note> एप्पु मांमेइं मिलोरे रान!<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />इन त तैस कीमती तेलेरू ज़ेरू,</para>
  <para style="q" vid="PSA 133:2">ज़ै हारूनेरे दोग्गे पुड़ छ़डोरो थियो,</para>
  <para style="q" vid="PSA 133:2">ते तैसेरी दैढ़ी करां बेगतां,</para>
  <para style="q" vid="PSA 133:2">तैसेरे लिगड़ेरे कूने तगर पुज़्ज़ो।<note caller="+" style="f"><char style="fr" closed="false">133:2 </char><char style="ft" closed="false">महायाजक च़ुन्नेरे लेई कीमती तेल हारूनेरे दोग्गे पुड़ उलटव।</char></note><verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />तैन हेर्मोन पहाड़ेरे तैस ओशरू ज़ेरूए,</para>
  <para style="q" vid="PSA 133:3">ज़ै सिय्योनेरे पहाड़न पुड़ झ़ड़तीए!</para>
  <para style="q" vid="PSA 133:3">यहोवा त तैड़ी सदा ज़िन्दगरी बरकत ठहरावरीए।<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">तारीफ़ केरनेरे लेई एलान</para>
  <para style="d">सफरेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1" />हे यहोवारे सब सेवकव, शुना,</para>
  <para style="q" vid="PSA 134:1">तुस ज़ैना राती-राती यहोवारे भवने मां खड़े भोतथ,</para>
  <para style="q" vid="PSA 134:1">यहोवा जो धन ज़ोथ<note caller="-" style="x"><char style="xo" closed="false">134:1 </char><char style="xt" closed="false"><ref loc="REV 19:5">प्रका. 19:5</ref>.</char></note><verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />पवित्र ठैरी मां अपने हथ खड़े केरतां,</para>
  <para style="q" vid="PSA 134:2">यहोवा जो धन ज़ोथ।<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />यहोवा ज़ै अम्बर ते धरती बनानेबालोए,</para>
  <para style="q" vid="PSA 134:3">तै सिय्योने मरां तुसन बरकत दे।<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">यहोवा महाने</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 135:1">यहोवारे नंव्वेरी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 135:1">हे यहोवारे सेवकव तैसेरी तारीफ़ केरा।<verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />तुस ज़ैना यहोवारे घरे मां,</para>
  <para style="q" vid="PSA 135:2">मतलब इश्शे परमेशरेरे भवनेरे अंगन मां खड़े भोतथ।<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />यहोवारी तारीफ़ केरा, किजोकि परमेशर भलोए;</para>
  <para style="q" vid="PSA 135:3">तैसेरे नंव्वेरू भजन केरा, किजोकि तै असन पुड़ महरबाने।<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />यहोवा याकूब अपने लेई च़ुनोरोए,</para>
  <para style="q" vid="PSA 135:4">मतलब तैनी इस्राएल अपने मलकीतरे लेई च़ुनोरोए।<verse eid="PSA 135:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />अवं त ज़ानताईं कि यहोवा महाने,</para>
  <para style="q" vid="PSA 135:5">इश्शो प्रभु सब देबतन करां उच्‍चोए।<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />यहोवा ज़ैन भी चाऊ,</para>
  <para style="q" vid="PSA 135:6">तैन तैनी अम्बरे ते ज़मीनी ते समुन्दरे</para>
  <para style="q" vid="PSA 135:6">ते सब डुग्घी ठैरन मां कियोरूए।<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />तै ज़मीनरे कूने पुड़ेरां भाप आनते,</para>
  <para style="q" vid="PSA 135:7">ते झ़ेड़रे लेई बिजली बनाते,</para>
  <para style="q" vid="PSA 135:7">ते हवा अपने भण्डारे मरां कढते।<verse eid="PSA 135:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />मिस्रे मां तैनी कुन इन्सानां केरे कुन जानबरां</para>
  <para style="q" vid="PSA 135:8">केरे सारे पेइले नर बच्‍चे मैरी दित्ते।<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />हे मिस्र, तैने तेरे दरमियाने मां फ़िरौन</para>
  <para style="q" vid="PSA 135:9">ते तैसेरे सब बड्डां-बड्डां कम्मां केरे खलाफ निशान ते चमत्कार किये।<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />तैनी बेड़ी कौमां नाश की,</para>
  <para style="q" vid="PSA 135:10">ते ताकतबर राज़े,<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />मतलब एमोरी राज़ां केरो राज़ो सीहोन,</para>
  <para style="q" vid="PSA 135:11">ते बाशानेरो राज़ो ओग,</para>
  <para style="q" vid="PSA 135:11">ते कनानेरे सब राज़े मारे;<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />ते तैन केरो मुल्ख बेंटतां,</para>
  <para style="q" vid="PSA 135:12">अपने इस्राएलेरो हिस्सो भोनेरे लेई दित्तो।<verse eid="PSA 135:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />हे यहोवा, तेरू नवं हमेशारूए,</para>
  <para style="q" vid="PSA 135:13">हे यहोवा, ज़ैस नंव्वे सेइं तेरी याद भोतीए,</para>
  <para style="q" vid="PSA 135:13">तैन पीढ़ी-पीढ़ी कायम रालू।<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />यहोवा अपने लोकां केरो न्याय केरेलो,</para>
  <para style="q" vid="PSA 135:14">ते अपने दासां केरि बुरी हालत हेरतां तरस खालो।<verse eid="PSA 135:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />गैर कौमां केरे मूरती सोन्नेरे ते चैंदरिन,</para>
  <para style="q" vid="PSA 135:15">तैना मैन्हु केरे हथ्थेरी बेनोरिन।<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />तैन मूरती केरू आशी त भोते, पन तैना गल न केरि बटन,</para>
  <para style="q" vid="PSA 135:16">तैन केरि एछ़्छ़ी त भोतिन पन तैना लेही न बटन।<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />तैन केरे कन त भोतन पन तैना शुनी न बटन,</para>
  <para style="q" vid="PSA 135:17">तैन केरे ऐशी मां सांस न च़ले।<verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />ज़ेन्च़रे तैना आन तेन्च़रे तैन केरे बनाने बालेन;</para>
  <para style="q" vid="PSA 135:18">ज़ैना तैन पुड़ भरोसो केरतन तैना भी तैन केरे ज़ेरे भोइ गाले।<verse eid="PSA 135:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />हे इस्राएलेरे घराना, यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 135:19">हे हारूनेरे घराना<note caller="+" style="f"><char style="fr" closed="false">135:19 </char><char style="fq" closed="false">हारूनेरे घराना </char><char style="ft" closed="false">परमेशरेरे याजक</char></note> यहोवारी तारीफ़ केरा!<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />हे लेवी केरे घराना यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 135:20">हे यहोवारो डर मन्ने बालाव यहोवारी तारीफ़ केरा।<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />यहोवा ज़ै यरूशलेमे मां बास केरते,</para>
  <para style="q" vid="PSA 135:21">तैस जो सिय्योने मां धन ज़ोवं गाए!</para>
  <para style="q" vid="PSA 135:21">यहोवारी तारीफ़ भोए!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">परमेशरेरो प्यार हमेशारोए</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />यहोवारू शुक्र केरा,</para>
  <para style="q" vid="PSA 136:1">किजोकि तै भलोए,</para>
  <para style="q" vid="PSA 136:1">ते तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />ज़ै ईश्वरां केरो परमेशरे, तैसेरू शुक्र केरा,</para>
  <para style="q" vid="PSA 136:2">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />ज़ै प्रभुआं केरो प्रभुए, तैसेरू शुक्र केरा,</para>
  <para style="q" vid="PSA 136:3">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />तैसेरे बगैर होरो कोई बड़ां-बड़ां कम्मां न केरि बटे,</para>
  <para style="q" vid="PSA 136:4">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />तैने अपने अक्ली सेइं अम्बर बनावं,</para>
  <para style="q" vid="PSA 136:5">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />तैने धरती पैनी पुड़ फैलावरीए,</para>
  <para style="q" vid="PSA 136:6">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />तैनी बेड्डी-बेड्डी लौआं<note caller="+" style="f"><char style="fr" closed="false">136:7 </char><char style="fq" closed="false">बेड्डी-बेड्डी लौआं </char><char style="ft" closed="false">दिहाड़ो, चाँदनी</char></note> बनेई,</para>
  <para style="q" vid="PSA 136:7">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />दीसां पुड़ राज़ केरनेरे लेई दिहाड़ो बनेवरोए,</para>
  <para style="q" vid="PSA 136:8">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />राती पुड़ राज़ केरनेरे लेई चाँदनी बनाई,</para>
  <para style="q" vid="PSA 136:9">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />तैनी मिस्री लोकां केरे ज़ेठे नर बच्‍चे मारे,</para>
  <para style="q" vid="PSA 136:10">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />ते तैनी मिस्री लोकां केरे दरमियाने मरां इस्राएली लोक कढे,</para>
  <para style="q" vid="PSA 136:11">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />ताकतबर हथ ते पाखड़ अग्रोवं केरतां कढे,</para>
  <para style="q" vid="PSA 136:12">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />तैने लाल समुन्दर अलग कियो,</para>
  <para style="q" vid="PSA 136:13">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />ते इस्राएली लोक मझ़मेइं निसने दित्ते,</para>
  <para style="q" vid="PSA 136:14">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />परमेशरे फ़िरौन मिस्रेरो राज़ो ते तैसेरी सेना लाल समुन्दरे मां छ़डी,</para>
  <para style="q" vid="PSA 136:15">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />तै रेगिस्ताने मां अपने लोकन घिन्तां जेव,</para>
  <para style="q" vid="PSA 136:16">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />तैनी बड़े-बड़े राज़े मारे,</para>
  <para style="q" vid="PSA 136:17">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />तैनी महान राज़े मैरी छ़डे,</para>
  <para style="q" vid="PSA 136:18">तैसेरो प्यार हमेशारोए;<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />एमोरी लोकां केरो राज़ो सीहोन,</para>
  <para style="q" vid="PSA 136:19">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />ते बाशानेरो राज़ो ओग मैरी छ़डो,</para>
  <para style="q" vid="PSA 136:20">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />ते तैन केरे मुल्खे मां हिस्सो भोनेरे लेई,</para>
  <para style="q" vid="PSA 136:21">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />अपने दास इस्राएली लोकां केरो हिस्सो भोनेरे लेई दित्तो,</para>
  <para style="q" vid="PSA 136:22">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />तैनी इश्शे बुरे हालातन मां इश्शी खबर घिन्नी,</para>
  <para style="q" vid="PSA 136:23">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />ते असां दुश्मन्न करां छुटा,</para>
  <para style="q" vid="PSA 136:24">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />ज़ै सैरी प्रैणन खाने जो खूराक देते,</para>
  <para style="q" vid="PSA 136:25">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />सुर्गेरे परमेशरेरू शुक्र केरा,</para>
  <para style="q" vid="PSA 136:26">तैसेरो प्यार हमेशारोए।<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">गुलैमी मां इस्राएलेरू दुखेरू गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />बाबेलेरे दरियां केरे बन्ने अस लोक बिश्शी जे,</para>
  <para style="q" vid="PSA 137:1">ते सिय्योने याद केरतां लेरां देने लगे!<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />तैस मां ज़ैना मजनू बुट्टन पुड़</para>
  <para style="q" vid="PSA 137:2">असेईं एपनी सैन्गी टेंगी;<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />किजोकि ज़ैनेईं असां गिरफ्तार कियोरे थिये,</para>
  <para style="q" vid="PSA 137:3">तैनेईं असन तैड़ी गीत ज़ोनेरे लेई ज़ोवं,</para>
  <para style="q" vid="PSA 137:3">ते असन लेरां दुवाने बालेईं असन आनन्दे सेइं ज़ोवं</para>
  <para style="q" vid="PSA 137:3">“सिय्योनेरे गीतन मरां इश्शे लेई कोई गीत ज़ोथ!”<verse eid="PSA 137:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />असां यहोवारे गीते,</para>
  <para style="q" vid="PSA 137:4">बखले मुल्खे मां केन्च़रे ज़ोम?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />हे यरूशलेम, अगर अवं तीं बिसरी,</para>
  <para style="q" vid="PSA 137:5">त मेरो देइनो हथ शुक्‍की गाए!<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />अगर अवं तीं याद न केरीं,</para>
  <para style="q" vid="PSA 137:6">अगर अवं यरूशलेमे,</para>
  <para style="q" vid="PSA 137:6">अपने आनन्दे करां जादे न मेन्नी</para>
  <para style="q" vid="PSA 137:6">त मेरी ज़िभ तैलू सेइं खत्ते!<verse eid="PSA 137:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />हे यहोवा, यरूशलेम बरबाद केरनेरे दिहाड़े एदोमी लोकां केरे खलाफ याद केर,</para>
  <para style="q" vid="PSA 137:7">कि तैना केन्च़रे ज़ोते थिये, “एस डोल्हा! एस थलेरां डोल्हा!”<verse eid="PSA 137:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />हे बाबेल नगरी, तू ज़ै उज़ड़ने पुड़ खड़ी भोवरिस,</para>
  <para style="q" vid="PSA 137:8">केत्रो धन भोल्हो तै, ज़ै तीं सेइं एरहो बर्ताव केरेलो</para>
  <para style="q" vid="PSA 137:8">ज़ेन्च़रे तीं असन सेइं कियूं!<verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />केत्रो धन भोल्हो तै, ज़ै तेरे बच्‍चन ट्लेइतां,</para>
  <para style="q" vid="PSA 137:9">चट्टानी पुड़ शारेलो!<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">परमेशरेरे दयारे लेई शुक्र</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1" />हे यहोवा, अवं पूरे दिले सेइं तेरी शुक्रगुज़ारी केरेलो,</para>
  <para style="q" vid="PSA 138:1">देबतां केरे सामने अवं तेरू भजन ज़ोइलो।<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />अवं तेरे पवित्र भवनेरे पासे फिरतां मथ्थो टेकेलो,</para>
  <para style="q" vid="PSA 138:2">ते तेरे प्यारेरे ते सच़्च़ेरे वजाई सेइं तेरे नंव्वेरू शुक्र केरेलो;</para>
  <para style="q" vid="PSA 138:2">अपने नंव्वे ते वचने सैरी चीज़न करां जादे उच्‍चो दर्जो दित्तोरोए।<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />ज़ैस दिहैड़ी मीं तू पुकारो, त तीं मेरी शुनी,</para>
  <para style="q" vid="PSA 138:3">ते मीं मां ज़ोर देइतां हिम्मत दित्ती।<verse eid="PSA 138:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />हे यहोवा, दुनियारे सारे राज़े तेरू शुक्र केरेले,</para>
  <para style="q" vid="PSA 138:4">किजोकि तैनेईं तेरे वचन शुनोरेन;<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />तैना यहोवारे कम्मां केरे बारे मां गीतां ज़ोले,</para>
  <para style="q" vid="PSA 138:5">किजोकि यहोवारी महिमा महाने।<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />अगर यहोवा महाने, फिरी भी तै हलीम मैन्हेरे पासे नज़र केरते;</para>
  <para style="q" vid="PSA 138:6">ते घमण्डी दूरेरां पिशानते।<verse eid="PSA 138:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />चाहे अवं मुसीबती मां च़ेलि फिरी भी तू मीं हिफाज़ती सेइं रखतस,</para>
  <para style="q" vid="PSA 138:7">तू मेरे क्रोध केरनेबाले दुश्मना केरे खलाफ हथ बधालो,</para>
  <para style="q" vid="PSA 138:7">ते अपने देइने हथ्थे सेइं मीं मुक्ति देलो।<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />यहोवा मेरे लेई सब किछ पूरू केरेलो ज़ेसेरो तैनी वाधो कियोरोए;</para>
  <para style="q" vid="PSA 138:8">हे यहोवा तेरो प्यार हमेशारोए।</para>
  <para style="q" vid="PSA 138:8">तू अपने हथ्थां केरे कम्मन न शार।<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">परमेशरेरू सच़्च़ू ज्ञान</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1" />हे यहोवा, तीं अवं पेरखतां ज़ानोरोईं।<note caller="-" style="x"><char style="xo" closed="false">139:1 </char><char style="xt" closed="false"><ref loc="ROM 8:27">रोम. 8:27</ref>.</char></note><verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />तीं मेरे उठनेरो ते बिशनेरो पतोए;</para>
  <para style="q" vid="PSA 139:2">ते तू मेरे खियालन दूरेरां समझ़तस।<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />तू मीं ज़ानतस, चाहे अवं बत्ती मां भोईं चाहे आराम केरीं,</para>
  <para style="q" vid="PSA 139:3">तू मेरी सैरी बत्तां केरो बाकमस।<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />हे यहोवा, मेरे ज़बानी पुड़ कोई गल नईं</para>
  <para style="q" vid="PSA 139:4">ज़ैस तू पूरे तरीके सेइं ज़ानतो न भोस ज़ैन अवं ज़ोइलो।<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />तू मीं च़ेवरे पासना घेरतां रखतस,</para>
  <para style="q" vid="PSA 139:5">ते तेरो हथ मीएं पुड़ रहते।<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />एन ज्ञान मेरे लेई बड़ू मुश्किले;</para>
  <para style="q" vid="PSA 139:6">ते एन गम्भीर ते मेरी समझ़ी करां बेइरे।<verse eid="PSA 139:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />अवं तेरी आत्मा करां कोरहां नेश्शी?</para>
  <para style="q" vid="PSA 139:7">या तेरे सामनेरां कोरहां नेश्शी?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />अगर अवं अम्बरे पुड़ च़ेढ़ी, त तू तैड़ी आस!</para>
  <para style="q" vid="PSA 139:8">अगर अवं अपनि खट पाताले मां बछ़ेईं त तैड़ी भी तू आस!<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />अगर अवं झ़ेझ़री किरणन पुड़ च़ेढ़तां समुन्दरे पार बेस्सी,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />त तैड़ी भी तू अपने हथ्थे मेरी अगवाई केरेलो,</para>
  <para style="q" vid="PSA 139:10">तैड़ी भी तेरो देइनो हथ मीं ट्लेइतां रखेलो।<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />अगर अवं ज़ोईं कि आंधरे मां त अवं छ़ेप्पी गेईं,</para>
  <para style="q" vid="PSA 139:11">ते मेरे च़ेवरे पासां केरि लौ रातरू आंधरू भोइ गाए,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />फिरी भी आंधरू तीं करां न छ़पेलू, रात दीसरे बराबर लौ देली;</para>
  <para style="q" vid="PSA 139:12">किजोकि तेरे लेई आंधरू ते लौ दूईये अक्‍कां ज़ेरां आन।<verse eid="PSA 139:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />किजोकि तीं मेरे एंत्रीं अंग बनेवरेन<note caller="+" style="f"><char style="fr" closed="false">139:13 </char><char style="fq" closed="false">बनेवरेन </char><char style="ft" closed="false">हिफाज़त कियोरीए</char></note>;</para>
  <para style="q" vid="PSA 139:13">तीं अवं अम्मरे पेटे मां बनाव।<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />अवं तेरू शुक्र केरेलो, एल्हेरेलेइ कि अवं भयानक ते अद्भुत तरीके सेइं बनाव जेवरोईं,</para>
  <para style="q" vid="PSA 139:14">तेरां कम्मां त हैरान केरनेबालन,</para>
  <para style="q" vid="PSA 139:14">ते अवं एन रोड़ेच़ारे ज़ानताईं।<verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />मेरो ढांचो तीं करां छ़पोरो न थियो,<note caller="+" style="f"><char style="fr" closed="false">139:15 </char><char style="ft" closed="false">मेरे अम्मरे पेटेरे आंधरे मां</char></note></para>
  <para style="q" vid="PSA 139:15">ज़ैखन अवं खुफिया ठैरी बनेवरो थियो,</para>
  <para style="q" vid="PSA 139:15">तैखन मेरी हेड्डी तीं करां छ़ेपोरी न थी।<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />तेरी एछ़्छ़ेईं अवं तैखने लाहोरो थियो,</para>
  <para style="q" vid="PSA 139:16">ते मेरे सब अंग ज़ैना रोज़ बनते गाते थिये तैना बन्ने करां पेइले</para>
  <para style="q" vid="PSA 139:16">तेरी किताबी मां लिखोरे थिये।<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />हे परमेशर, मेरे लेई त तेरे खियाल केत्रे बड़े कीमती आन!</para>
  <para style="q" vid="PSA 139:17">तैन केरि तैधातरो जोड़ केत्रो बड्डोए।<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />अगर अवं तैन गेनि बटेथो त तैना रेती करां भी जादे निसने थिये,</para>
  <para style="q" vid="PSA 139:18">ज़ैखन अवं बींझताईं, त तैखन भी तीं सेइं साथी रहताईं।<verse eid="PSA 139:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />हे परमेशर सच़्च़े तू दुष्टे मैरी देलो!</para>
  <para style="q" vid="PSA 139:19">हे खून केरनेबालव मीं करां दूर भोथ।<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />किजोकि तैना तेरे खलाफ भोतन ते धोखेरां कम्मां केरतन;</para>
  <para style="q" vid="PSA 139:20">तेरे दुश्मन तेरू नवं झूठी गल्‍ली पुड़ घिन्तन,<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />हे यहोवा, कुन अवं तैन सेइं नफरत न केरीं ज़ैना तीं सेइं नफरत केरतन?</para>
  <para style="q" vid="PSA 139:21">ते तेरे मुखालफन सेइं नफरत न केरि।<verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />हाँ, अवं तैन सेइं पूरो बैर रखताईं;</para>
  <para style="q" vid="PSA 139:22">अवं तैन अपने दुश्मन समझ़ताईं।<verse eid="PSA 139:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />हे परमेशर, मीं पेरखतां ज़ान!</para>
  <para style="q" vid="PSA 139:23">मीं पेरखतां मेरी फिकरां ज़ान!<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />ते हेर कि मीं मां कोई बुरी चाले कि नईं,</para>
  <para style="q" vid="PSA 139:24">ते हमेशारी बत्ती मां मेरी अगवाई केर।<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">बचावरेरे लेई प्राथना</para>
  <para style="d">प्रधान बज़ानेबालेरे लेई दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1" />हे यहोवा, मीं मेरे दुश्मन करां बच़ा;</para>
  <para style="q" vid="PSA 140:1">ज़ुलम केरनेबाले मैन्हु करां मेरी हिफाज़त केर।<note caller="-" style="x"><char style="xo" closed="false">140:1 </char><char style="xt" closed="false"><ref loc="ROM 3:13">रोम. 3:13</ref>;<ref loc="JAS 3:8">याक. 3:8</ref>.</char></note><verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2" />किजोकि तैनेईं मने मां बुरे खियाल कियोरेन।</para>
  <para style="q" vid="PSA 140:2">तैना लगातार लड़ैई मच़ातन।<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3" />तैन केरू ज़ोनू सप्पेरे टक देनेरू ज़ेरूए,</para>
  <para style="q" vid="PSA 140:3">तैन केरे ज़बानरां ज़ेन्च़रे सप्पेरू ज़ेहर रहते, (सेला)<verse eid="PSA 140:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4" />हे यहोवा मीं दुष्टेरे हथ्थे करां बच़ा;</para>
  <para style="q" vid="PSA 140:4">ज़ालम मैन्हु करां मेरी हिफाज़त केर,</para>
  <para style="q" vid="PSA 140:4">किजोकि तैनेईं मेरे पव्वन घिशकानेरी योजना कियोरीए।<verse eid="PSA 140:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5" />घमण्डी लोकेईं मेरे लेई फंदो ते रेस्सी लेवरिन,</para>
  <para style="q" vid="PSA 140:5">ते बत्तरे बन्ने जाल बछ़ावरूए;</para>
  <para style="q" vid="PSA 140:5">तैनेईं मेरे लेई फंदे लेवरेन। (सेला)<verse eid="PSA 140:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6" />हे यहोवा, मीं तीं सेइं ज़ोवं कि तू मेरो परमेशरस;</para>
  <para style="q" vid="PSA 140:6">हे यहोवा, मेरी बिनतरे पासे ध्यान दे!<verse eid="PSA 140:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7" />हे यहोवा प्रभु, हे मेरे सामर्थी मुक्ति देनेबाला,</para>
  <para style="q" vid="PSA 140:7">तीं जंगरे दिहाड़े मेरे क्रोड़री हिफाज़त कियोरीए।<note caller="+" style="f"><char style="fr" closed="false">140:7 </char><char style="fq" closed="false">क्रोड़री हिफाज़त कियोरीए </char><char style="ft" closed="false">तीं जंगी मां अवं बच़वरोईं</char></note><verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8" />हे यहोवा तू दुष्टेरी इच्छा पूरी भोने न दे,</para>
  <para style="q" vid="PSA 140:8">तैसेरी बुरी योजना कामयाब भोने न दे, नईं त तै घमण्ड केरेलो। (सेला)<verse eid="PSA 140:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9" />तैन दुश्मनेईं अवं घेरी छ़डोरोइं, ज़ैन तैनेईं सोचोरू तैन केरे अपने दोग्गे पुड़ एज्जे।<verse eid="PSA 140:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10" />तैन केरे दोग्गे पुड़ मूरां छ़डां गान!</para>
  <para style="q" vid="PSA 140:10">ते अग्गी मां बिछ़ोड़े गान!</para>
  <para style="q" vid="PSA 140:10">ते एरे गत्तन मां बिछ़ड़न, कि तैना फिरी उठी न सकन!<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11" />बकबक केरनेबालो धेरती पुड़ कायम न भोइ बटेलो;</para>
  <para style="q" vid="PSA 140:11">ज़ालम मैन्हु बिछ़ोड़नेरे लेई बुराई तैसेरो पीछो केरेली।<verse eid="PSA 140:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12" />हे यहोवा, मीं याकीने कि तू गरीब मैन्हु</para>
  <para style="q" vid="PSA 140:12">ते ज़रूरतमन्दन न्याय देलो।<verse eid="PSA 140:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13" />इस मां शक नईं धर्मी तेरे नंव्वेरू शुक्र केरि बटेले;</para>
  <para style="q" vid="PSA 140:13">सिद्धे लोक तेरे सामने बास केरेले।<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">पाप ते पापी लोकन करां दूर रानू</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1" />हे यहोवा, अवं तींए फुकारने लगोरोइं; मीं कां लूशी एई!</para>
  <para style="q" vid="PSA 141:1">ज़ैखन अवं तींजो आवाज़ देताईं, तू मेरी बिनती पुड़ ध्यान दे!<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />मेरी प्राथना तेरे सामने खुशबूदार धूपेरी ज़ेरि,</para>
  <para style="q" vid="PSA 141:2">ते मेरे हथ फैलाने ड्लवझ़री अन्नबेलरे ज़ेरे भोन।<note caller="-" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="REV 5:8">प्रका. 5:8</ref>;<ref loc="REV 8:3-4">8:3-4</ref>;<ref loc="PRO 3:25">कह. 3:25</ref>;<ref loc="1PE 3:6">1 पत. 3:6</ref>.</char></note><verse eid="PSA 141:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />हे यहोवा, मेरे ऐशी पुड़ पहरो बिशाल,</para>
  <para style="q" vid="PSA 141:3">मेरे ओठां केरि रखवाली केर।<verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />मेरो मन कोन्ची बुरी गल्‍लरे पासे फिरने न दे;</para>
  <para style="q" vid="PSA 141:4">एरू न भोए कि अवं अनर्थ केरनेबाले लोकन सेइं मिलतां</para>
  <para style="q" vid="PSA 141:4">बुरे कम्मन मां शामल भोइ गेईं,</para>
  <para style="q" vid="PSA 141:4">ते अवं तैन केरे खाने पीनेरी धामी मां भी शामल भोइ गेईं।<verse eid="PSA 141:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />धर्मी लोक मीं मारेले त ई दया मन्नी गाली,</para>
  <para style="q" vid="PSA 141:5">अगर तै मीं झ़िड़क दे त तै मेरे दोग्गेरे लेई तेल भोल्हो;</para>
  <para style="q" vid="PSA 141:5">मेरो दोग एसेरो इन्कार न केरेलो,</para>
  <para style="q" vid="PSA 141:5">दुष्ट लोकां केरे बुरां कम्मां केरे खलाफ अवं लगातार प्राथना केरतो रेइलो।<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />ज़ैखन दुश्मना केरे हाकिम तैस चट्टानी पुड़ेरां बिछ़ोड़े जे,</para>
  <para style="q" vid="PSA 141:6">त तैखन तैनेईं मेरी गल्‍लां शुनी; किजोकि तैना बेड़ि रोड़ी थी।<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />ज़ेन्च़रे उडारे मां हल लाने सेइं ढैल्‍लां निस्तन,</para>
  <para style="q" vid="PSA 141:7">तेन्च़रे इश्शी हेड्डी पातालेरे ऐशी मां खिलरोरीन।<verse eid="PSA 141:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />पन हे यहोवा प्रभु, मेरी एछ़्छ़ी त तेरे पासे लेगोरिन;</para>
  <para style="q" vid="PSA 141:8">ते अवं तेरी शरणी मां रहताईं; मीं मौतरे हवाले न केर।<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />मीं तैस फंदे करां, ज़ै तैनेईं मेरे लेई लेवरोए,</para>
  <para style="q" vid="PSA 141:9">ते तैन अनर्थ केरनेबाले लोकन करां मेरी हिफाज़त केर।<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />दुष्ट लोक अपने ज़ालन मां एप्पु फसन,</para>
  <para style="q" vid="PSA 141:10">ते अवं बेच़तां निस्सी गेईं।<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">ज़ुलमे करां छुटनेरे लेई बिनती</para>
  <para style="d">दाऊदेरो मश्कील, ज़ैखन तै कुढी मां थियो: प्राथना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1" />अवं यहोवा कां मद्दतरे लेई बिनती केरताईं,</para>
  <para style="q" vid="PSA 142:1">अवं यहोवा कां बिनती केरताईं,<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2" />अवं अपने दुखेरी गल्‍लां तैस सेइं पूरी रोड़ेच़ारे ज़ोताईं,</para>
  <para style="q" vid="PSA 142:2">ते अवं एपनी सैरी तकलीफां यहोवारे सामने रखेलो।<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3" />ज़ैखन मेरी आत्मा मेरे अन्तर परेशान भोइ राहोरी थी,</para>
  <para style="q" vid="PSA 142:3">त तैखन तू मेरी हालती ज़ानतो थियो!</para>
  <para style="q" vid="PSA 142:3">ते ज़ैस बत्तां अवं गानेबालो थियो, तैस्से बत्ती मां मेरे दुश्मनेईं मेरे लेई फंदे लेइतां छ़डोरे थिये।<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4" />मीं देइने पासे तक्‍कू, पन मीं कोई न तक्‍के,</para>
  <para style="q" vid="PSA 142:4">मेरे लेई छ़पनेरी ठार, कोई नईं ज़ै मेरी जानरी फिक्र केरे।<verse eid="PSA 142:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5" />हे यहोवा, मीं तीं कां बिनती की;</para>
  <para style="q" vid="PSA 142:5">अवं ज़ोताईं, कि तू मेरी छ़पनेरी ठारस,</para>
  <para style="q" vid="PSA 142:5">मेरे ज़ींते वक्ते तू मेरो हिस्सो आस।<verse eid="PSA 142:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6" />मद्दतरे लेई मेरी चिन्डन पुड़ ध्यान केर,</para>
  <para style="q" vid="PSA 142:6">किजोकि अवं बड़ो पस्त भोवरोईं,</para>
  <para style="q" vid="PSA 142:6">ज़ैना मेरो पीछो केरने लगोरेन, तैन करां मीं बच़ा;</para>
  <para style="q" vid="PSA 142:6">किजोकि तैना मीं करां जादे ताकतबरन।<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7" />मीं कैदखाने मरां बेइर कढ, ताके अवं तेरे नंव्वेरू शुक्र केरि!</para>
  <para style="q" vid="PSA 142:7">धर्मी लोक मेरे आसे पासे जम्हां भोल्हे;</para>
  <para style="q" vid="PSA 142:7">किजोकि तू मीं पुड़ एसान केरेलो।<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">बत हिरानेरे लेई ते मुक्ति मैल्हनेरे लेई प्राथना</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1" />हे यहोवा, मेरी प्राथना शुन,</para>
  <para style="q" vid="PSA 143:1">मेरी बिनती पुड़ ध्यान दे!</para>
  <para style="q" vid="PSA 143:1">तू ज़ै सच़्च़ो ते धर्मी आस, एल्हेरेलेइ मेरी प्राथना शुन,<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />अपने दासे पुड़ मुकदमो न केर!</para>
  <para style="q" vid="PSA 143:2">किजोकि कोई प्राणी तेरी नज़री मां बेकसूर न भोइ सके।<note caller="-" style="x"><char style="xo" closed="false">143:2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">रोम. 3:20</ref>;<ref loc="1CO 4:4">1 कुरि. 4:4</ref>;<ref loc="GAL 2:16">गल. 2:16</ref>.</char></note><verse eid="PSA 143:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />दुश्मन त मेरे प्राणेरो गाक भोवरोए;</para>
  <para style="q" vid="PSA 143:3">तैनी मेरी ज़िन्दगी मित्ती मां मलेवरीए,</para>
  <para style="q" vid="PSA 143:3">तैनी अवं तैन लोकां केरो ज़ेरो आंधरे मां छ़डोरोईं, ज़ैना बड़े दिहाड़ां केरे मेरि जेवरेन।<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />मेरे अन्तर मेरी आत्मा बेचैन भोने लगोरीए,</para>
  <para style="q" vid="PSA 143:4">मेरो मन दुखीए।<verse eid="PSA 143:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />मीं पुराने ज़मानेरे दिहाड़े याद एइतन,</para>
  <para style="q" vid="PSA 143:5">अवं तेरे सब महान कम्मन सोचताईं,</para>
  <para style="q" vid="PSA 143:5">ते तेरे हथ्थां केरे कम्मन सोचताईं।<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />अवं अपने हथ तेरे पासे खड़े केरताईं;</para>
  <para style="q" vid="PSA 143:6">ते मेरी जान शुकोरी ज़मीनरी ज़ेरि ट्लिशोरीए। (सेला)<verse eid="PSA 143:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />हे यहोवा, मेरी प्राथना जल्दी शुन;</para>
  <para style="q" vid="PSA 143:7">किजोकि मेरे प्राण निसने बालेन!</para>
  <para style="q" vid="PSA 143:7">अपनु तुत्तर मीं करां न छ़ुपा, एरू न भोए कि अवं कब्री मां गाने बालां केरो ज़ेरो भोईं।<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />झ़ेझ़ेरे मौके मीं अपने प्यारेरी खबर शुना,</para>
  <para style="q" vid="PSA 143:8">किजोकि अवं तींए पुड़ भरोसो रखताईं।</para>
  <para style="q" vid="PSA 143:8">ज़ैस बत्तां मीं च़लनूए, मीं तै बत हेरा,</para>
  <para style="q" vid="PSA 143:8">किजोकि अवं अपनो मन तेरे पासे लाताईं।<verse eid="PSA 143:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />हे यहोवा, मीं मेरे दुश्मन करां बच़ा;</para>
  <para style="q" vid="PSA 143:9">अवं तेरे आड़ी मां छ़पोरोईं।<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />मीं शिखाल, कि अवं तेरी मर्ज़ी पूरी केरि, किजोकि मेरो परमेशर तूए आस!</para>
  <para style="q" vid="PSA 143:10">तेरी भली आत्मा मीं धर्मेरे बत्ती मां च़लाए।<verse eid="PSA 143:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />हे यहोवा, अपने नंव्वेरे खातर मेरे ज़िन्दगरी हिफाज़त केर!</para>
  <para style="q" vid="PSA 143:11">तू ज़ै धर्मी आस, मीं मुसीबती करां छुटा!<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />एपनी दयाई सेइं मेरे दुश्मन नाश केर,</para>
  <para style="q" vid="PSA 143:12">मेरे सारे सताने बालन नाश केरि छ़ड,</para>
  <para style="q" vid="PSA 143:12">किजोकि अवं तेरो दास आईं।<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">बचावेरे लेई प्राथना</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1" />धने यहोवा, ज़ै मेरी चट्टाने,</para>
  <para style="q" vid="PSA 144:1">तै जंगरे लेई मेरे हथ्थन</para>
  <para style="q" vid="PSA 144:1">ते लड़नेरे लेई मेरी एंगलोयन तियार कराते।<note caller="-" style="x"><char style="xo" closed="false">144:1 </char><char style="xt" closed="false"><ref loc="REV 5:9">प्रका. 5:9</ref>;<ref loc="REV 14:3">14:3</ref>.</char></note><verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />तै मीं पुड़ दया केरनेबालो ते मेरो क़िलो,</para>
  <para style="q" vid="PSA 144:2">ते उच्‍ची ठार ते मेरो छुटानेबालोए,</para>
  <para style="q" vid="PSA 144:2">तै मेरी ढाल ते छ़पनेरी ठारे,</para>
  <para style="q" vid="PSA 144:2">ज़ै कौमन मेरे कब्ज़े मां केरते।<verse eid="PSA 144:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />हे यहोवा, इन्सान कौने कि तू तैसेरो खियाल रखतस,</para>
  <para style="q" vid="PSA 144:3">मैन्हु कुने कि तू तैसेरी फिक्र केरस?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />इन्सान त सांसेरो ज़ेरोए;</para>
  <para style="q" vid="PSA 144:4">तैसेरे दिहाड़े त लूशी मुकने बैली छावरे ज़ेरेन।<verse eid="PSA 144:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />हे यहोवा, अपने सुर्गे उन्ढू केरतां ओस!</para>
  <para style="q" vid="PSA 144:5">पहाड़न सेइं हूर तैखन तैन मरां तूँ निसेलो।<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />बिजली कड़केइतां मेरे दुश्मन्न तितर बितर केरे,</para>
  <para style="q" vid="PSA 144:6">अपने तीर च़लेइतां तैन घबरा!<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />अपनो हथ उन्ढो केरतां मीं बड्डे समुन्दरे मरां बेइर कढ,</para>
  <para style="q" vid="PSA 144:7">मतलब कि परदेशी केरे हथ्थे मरां छुटा।<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />ज़ैन केरू आशी झूठ ज़ोते,</para>
  <para style="q" vid="PSA 144:8">ते तैन केरे देइने हथ्थे सेइं धोखेरां कम्मां भोतन।<verse eid="PSA 144:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />हे परमेशर, अवं तेरी तारीफ़रू नंव्वू गीत ज़ोइलो;</para>
  <para style="q" vid="PSA 144:9">दश तारन बाली सैन्गी बज़ेइतां तेरू भजन ज़ोइलो।<verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />तू राज़न मुक्ति देने बालोस,</para>
  <para style="q" vid="PSA 144:10">ते अपने दास दाऊदे तलवारी करां बच़ातस।<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />मीं बच़ा ते परदेशी केरे हथ्थे करां छुटा,</para>
  <para style="q" vid="PSA 144:11">ज़ैन केरू आशी झूठ ज़ोते,</para>
  <para style="q" vid="PSA 144:11">ते ज़ैन केरे देइने हथ्थे सेइं धोखेरां कम्मां भोतन।<verse eid="PSA 144:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />इश्शां मट्ठां जुवैनरे वक्ते पौदां केरां ज़ेरां बेडोतन,</para>
  <para style="q" vid="PSA 144:12">त इश्शी कुइयां तैन कूनेरे खम्भां केरि ज़ेरिन, ज़ैना मेहलेरे लेई बनाए जे;<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />इश्शे गुदाम भरोरे राले, ते तैन मां किसमां-किसमां केरू अन्न रख्खू गाए,</para>
  <para style="q" vid="PSA 144:13">ते इश्शी भैड्डां-छ़ेल्‍ली इश्शे मैइदाने मां हज़ारेईं बच्‍चे देंती रान।<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />इश्शे दांत खूब लद्दोरे भोन;</para>
  <para style="q" vid="PSA 144:14">असन न कोई बिघन भोए ते असेईं कोन्च गानू पे,</para>
  <para style="q" vid="PSA 144:14">ते न इश्शे चौकन मां लेरां केरि शौर भोए।<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />एस हालती मां ज़ै कौम भोए तै केत्री धन भोल्ही!</para>
  <para style="q" vid="PSA 144:15">ज़ैन लोकां केरो परमेशर यहोवाए, तैना केत्रे धन आन!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">परमेशरेरी महिमा ते प्यारेरू गीत</para>
  <para style="d">दाऊदेरू भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1" />हे मेरे परमेशर, हे मेरे राज़ा, अवं तेरी तारीफ़ केरेलो,</para>
  <para style="q" vid="PSA 145:1">ते तेरे नंव्वे हमेशा-हमेशा धन ज़ोतो रेइलो।<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />अवं रोज़ तींजो धन ज़ोइलो,</para>
  <para style="q" vid="PSA 145:2">ते हमेशा तेरे नव्वेंरी तारीफ़ केरेलो।<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />यहोवा बड़ो महान ते बड़े तारीफ़रे काबले,</para>
  <para style="q" vid="PSA 145:3">ते तैसेरी बडीयाई मैन्हेरी समझ़ी करां बेइरे।<verse eid="PSA 145:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />तेरे कम्मां केरि तारीफ़ ते तेरे बड्डां-बड्डां कम्मां केरू बियान,</para>
  <para style="q" vid="PSA 145:4">पीढ़ी-पीढ़ी भोती च़ली गाली।<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />अवं तेरे बड़े महिमा</para>
  <para style="q" vid="PSA 145:5">ते तेरे महान कम्मन पुड़ ध्यान देंतो रेइलो।<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />लोक तेरे भयानक कम्मां केरि शेक्तरी चर्चा केरते राले।</para>
  <para style="q" vid="PSA 145:6">ते अवं तेरे बड्डां-बड्डां कम्मां केरू बियान केरेलो।<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />लोक तेरी बड़ी भलियाई याद केरतां तैसारी चर्चा केरेले,</para>
  <para style="q" vid="PSA 145:7">ते तेरे धार्मिकतारो जयजयकार केरेले।<verse eid="PSA 145:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />यहोवा अनुग्रह ते दया केरनेबालो,</para>
  <para style="q" vid="PSA 145:8">क्रोध केरने मां च़िर लानेबालोए ते बड़ो प्यार केरनेबालोए।<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />यहोवा सेभी केरे लेई भलोए,</para>
  <para style="q" vid="PSA 145:9">ते तैसेरी दया सैरी सृष्टि पुड़े।<verse eid="PSA 145:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />हे यहोवा, तेरी सारी सृष्टि तेरू शुक्र केरेली,</para>
  <para style="q" vid="PSA 145:10">ते तेरे भक्त लोक तींजो धन ज़ोले!<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />तैना तेरे राज़्ज़ेरी महिमारे बारे मां चर्चा केरेले,</para>
  <para style="q" vid="PSA 145:11">ते तेरी महा शेक्तरे बारे मां बियान केरेले<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />कि तै मैन्हन पुड़ तेरां महान कम्मां</para>
  <para style="q" vid="PSA 145:12">ते तेरी राज़्ज़ेरी शान-ओ-शोकत ते तैसेरी महिमा बांदी केरन।<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />तेरी राज़्ज़ेरी कोई हद नईं,</para>
  <para style="q" vid="PSA 145:13">ते तेरी हुकूमत पीढ़ी-पीढ़ी तगर च़लती राहेली।<verse eid="PSA 145:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />यहोवा सेभी बिछ़ड़ने बालन सम्भालते,</para>
  <para style="q" vid="PSA 145:14">ज़ैना रेईं जेवरेन तै तैन भी खड़े केरते।<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />सेभी प्रैणी केरि एछ़्छ़ी तीं बेलगती रैतिन,</para>
  <para style="q" vid="PSA 145:15">ते तू हर कोन्ची मौके पुड़ रोट्टी देतस।<note caller="-" style="x"><char style="xo" closed="false">145:15 </char><char style="xt" closed="false"><ref loc="REV 15:3">प्रका. 15:3</ref>;<ref loc="REV 16:5">16:5</ref>.</char></note><verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />ते तू अपनि मुठड़ी खोलतां</para>
  <para style="q" vid="PSA 145:16">सब जानदारां केरि खुवैइश पूरी केरतस।<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />यहोवा परमेशर, एपनी सैरी बत्तन मां धर्मी</para>
  <para style="q" vid="PSA 145:17">ते अपने सारे कम्मन मां वफादारे।<verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />यहोवा परमेशर, तैन सेभी केरे नेड़े, ज़ैना तैस याद केरतन,</para>
  <para style="q" vid="PSA 145:18">ते ज़ैना तैस सच़्च़ैई सेइं पुकारतन।<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />ज़ैना तैसेरो डर मन्न त तै तैन केरि इच्छा पूरी केरते,</para>
  <para style="q" vid="PSA 145:19">तै तैन केरि बिनती शुन्तां तैन केरि मद्दत केरते।<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />यहोवा अपने सब प्यार केरनेबालां केरि हिफाज़त केरते,</para>
  <para style="q" vid="PSA 145:20">पन सब दुष्टां केरो नाश केरते।<verse eid="PSA 145:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />अवं यहोवारी तारीफ़ केरेलो,</para>
  <para style="q" vid="PSA 145:21">सारे जानदार हमेशा तगर तैसेरे पवित्र नव्वेंरी तारीफ़ केरते रहतन।<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">मुक्ति देनेबाले परमेशरेरी तारीफ़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />यहोवारी तारीफ़<note caller="+" style="f"><char style="fr" closed="false">146:1 </char><char style="fq" closed="false">तारीफ़ </char><char style="ft" closed="false">हालेलुय्याह</char></note> भोए।</para>
  <para style="q" vid="PSA 146:1">हे मेरी जान यहोवारी तारीफ़ केर।<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />अवं ज़िन्दगी भर यहोवारी तारीफ़ केरतो रेइलो;</para>
  <para style="q" vid="PSA 146:2">ज़ांतगर अवं बनोरो रेइलो, तैखन तगर अवं अपने परमेशरेरू भजन ज़ोतो रेइलो।<verse eid="PSA 146:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />तुस प्रधान्न पुड़ भरोसो न रेखथ,</para>
  <para style="q" vid="PSA 146:3">ते न कोन्ची मैन्हु पुड़, किजोकि तैस मां मुक्ति देनेरी कोई शक्ति नईं।<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />तैसेरे प्राण निस्सी गातन, तै भी मित्ती मां मिली गालो;</para>
  <para style="q" vid="PSA 146:4">तैस्से दिहैड़ी तैसेरे सारे खियाल नाश भोइ गाले।<verse eid="PSA 146:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />केत्रो धने तै,</para>
  <para style="q" vid="PSA 146:5">ज़ेसेरो मद्दत केरनेबालो याकूबेरो परमेशरे,</para>
  <para style="q" vid="PSA 146:5">ज़ै अपने यहोवा पुड़ भरोसो रखते।<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />परमेशर अम्बर ते धरती ते समुन्दर</para>
  <para style="q" vid="PSA 146:6">ते तैन मां ज़ैन किछे, सब किछ बनानेबालोए;</para>
  <para style="q" vid="PSA 146:6">ते तै अपनु वचन हमेशारे लेई पूरू केरतो रालो।<verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />ते ज़ैन पुड़ ज़ुलम भोते तैन न्याय देते;</para>
  <para style="q" vid="PSA 146:7">ते नियन्न रोट्टी खुवाते।</para>
  <para style="q" vid="PSA 146:7">ते यहोवा कैदन आज़ाद केरते।<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />यहोवा कान्न एछ़्छ़ी देते।</para>
  <para style="q" vid="PSA 146:8">ते झुकोरे लोकन तै खड़ो केरते;</para>
  <para style="q" vid="PSA 146:8">यहोवा धर्मी लोकन सेइं प्यार केरते।<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />यहोवा परदेशी केरि हिफाज़त केरते,</para>
  <para style="q" vid="PSA 146:9">ते अनाथन ते विधवान सम्भालते;</para>
  <para style="q" vid="PSA 146:9">पन दुष्टां केरि बत टारी टिन्ची केरते।<verse eid="PSA 146:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />हे सिय्योन, यहोवा सदारे लेई,</para>
  <para style="q" vid="PSA 146:10">तेरो परमेशर पीढ़ी-पीढ़ी तगर हुकूमत केरेलो।</para>
  <para style="q" vid="PSA 146:10">यहोवारी तारीफ़ केरा!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">सर्वशक्तिमान परमेशरेरी तारीफ़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />यहोवारी तारीफ़ केरा!</para>
  <para style="q" vid="PSA 147:1">किजोकि अपने परमेशरेरू भजन ज़ोनू रोड़ूए;</para>
  <para style="q" vid="PSA 147:1">किजोकि तैन मन पसंदे, तैसेरी तारीफ़ केरनी जाइज़े।<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />यहोवा यरूशलेमे बसेई राहोरोए;</para>
  <para style="q" vid="PSA 147:2">तै तितर-बितर कियोरे इस्राएली लोकन अकोट्ठे केरि राहोरोए।<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />यहोवा दुखी दिलेरे बिमारन बझ़ाते,</para>
  <para style="q" vid="PSA 147:3">ते तैन केरे ज़खमन पुड़ पट्टी बन्धते।<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />तै तारन गन्ते,</para>
  <para style="q" vid="PSA 147:4">ते तैन मरां हर एक्‍केरू नवं रखते।<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />इश्शो प्रभु महान ते बड़ो शेक्ति बालोए;</para>
  <para style="q" vid="PSA 147:5">तैसेरी अक्लरी कोई हद नईं।<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />यहोवा हलीम लोकन सम्भालते,</para>
  <para style="q" vid="PSA 147:6">ते दुष्ट लोकन ज़मीनी पुड़ बुछ़ोड़ते।<verse eid="PSA 147:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />शुक्र केरते यहोवारू गीत ज़ोथ;</para>
  <para style="q" vid="PSA 147:7">सैन्गी बज़ेइतां इश्शे परमेशरेरू भजन ज़ोथ।<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />तै अम्बर बिदलारी सेइं भरते,</para>
  <para style="q" vid="PSA 147:8">ते ज़मीनरे लेई झ़ड़ी तियार केरते; ते पहाड़न पुड़ घास उगाते।<verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />तै जानबरन ते कंव्वेरे बच्‍चन ज़ैना पुकारतन</para>
  <para style="q" vid="PSA 147:9">तैन खुवाते<verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />न तै घोड़ां केरि ताकती सेइं खुशी भोए,</para>
  <para style="q" vid="PSA 147:10">ते न तै सिपेहेरे मज़बूत पव्वन सेइं खुशी भोते।<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />यहोवा तैन्ने पुड़ खुश भोते, ज़ैना तैसेरो डर मनतन,</para>
  <para style="q" vid="PSA 147:11">मतलब तैन सेइं ज़ैना तैसेरी प्यारे पुड़ उमीद रखतन।<verse eid="PSA 147:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />हे यरूशलेम, यहोवारी तारीफ़ केर!</para>
  <para style="q" vid="PSA 147:12">हे सिय्योन, अपने परमेशरेरी तारीफ़ केर!<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />किजोकि तैनी तेरे फाटकां केरे खम्भे पक्‍के कियोरेन,</para>
  <para style="q" vid="PSA 147:13">ते तेरे औलादी बरकत दित्तोरिए।<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />तै तेरे सरहद्दी मां शान्ति देते,</para>
  <para style="q" vid="PSA 147:14">ते तीं रोड़े करां रोड़े गेहुंन सेइं रज़ानते।<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />तै ज़मीनी पुड़ अपने हुक्मेरो प्रचार केरते,</para>
  <para style="q" vid="PSA 147:15">ते तैसेरू वचन बड़े लूशी पुज़ते।<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />तै उन्ना केरो ज़ेरो हिंवे बखाते,</para>
  <para style="q" vid="PSA 147:16">ते मांज़नरो ज़ेरो पालो खिलारते।<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />तै आण बखाते,</para>
  <para style="q" vid="PSA 147:17">तैसेरी कियोरी ठंड कौन झ़ेल्‍ली सकते?<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />तै हुक्म देइतां तैन गालते;</para>
  <para style="q" vid="PSA 147:18">तै बात च़लाते, तैखन पानी बगने लगते।<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />तैनी याकूबे अपनु वचन,</para>
  <para style="q" vid="PSA 147:19">ते तै इस्राएली लोकन एपनी विधि ते नियम ज़ोते।<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />कोन्ची होरि राष्ट्रन सेइं तैनी एरहो बर्ताव नईं कियोरो;</para>
  <para style="q" vid="PSA 147:20">ते तैसेरे नियम होरेईं न ज़ाने।</para>
  <para style="q" vid="PSA 147:20">यहोवारी तारीफ़ भोए।<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">सारे सृष्टरे लेई परमेशरेरी तारीफ़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />यहोवारी तारीफ़ केरा।</para>
  <para style="q" vid="PSA 148:1">सुर्गे मरां यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 148:1">उच्‍ची ठैरी पुड़ेरां तैसेरी तारीफ़ केरा।<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />हे यहोवारे सारे दूतव, तैसेरी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 148:2">हे तैसेरी सैरी सेनाव, तैसेरी तारीफ़ केरा।<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />हे दिहाड़ां, ते हे चाँदनी, तैसेरी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 148:3">हे सारे चमकते तारव, तैसेरी तारीफ़ केरा।<verse eid="PSA 148:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />हे उच्‍चे अम्बरव,</para>
  <para style="q" vid="PSA 148:4">ते अम्बरेरे बेइयों पानी, तुस दूईये तैसेरी तारीफ़ केरा।<verse eid="PSA 148:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />तैना यहोवारे नव्वेंरी तारीफ़ केरन,</para>
  <para style="q" vid="PSA 148:5">किजोकि तैनी ज़ोवं त तैन वजूदे मां अव।<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />ते तैनी तैन हमेशा हमेशारे लेई कायम केरतां छ़डोरूए;</para>
  <para style="q" vid="PSA 148:6">ते एरी विधि ठहराई, ज़ैना टलनेरी नईं।<verse eid="PSA 148:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />ज़मीनी पुड़ेरां यहोवारी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 148:7">हे समुन्दरेरे अजगरव, ते डुग्घे समुन्दर,<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />हे अग ते आण, ते हिवं, ते धुन्द,</para>
  <para style="q" vid="PSA 148:8">हे तैसेरे हुक्मे पुड़ च़लनेबाली आँधी!<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />हे पहाड़व, ते निक्‍की पहैड़ी,</para>
  <para style="q" vid="PSA 148:9">ते फल देनेबाले बुट्टव, ते सारे गैइड़!<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />हे जंगली जानबरव, ते पैलतू जानबरव,</para>
  <para style="q" vid="PSA 148:10">हे पेटेरे भारे च़लनेबाले जीपव ते हे च़ुड़ोलव!<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />हे दुनियारे राज़व, ते रियासतां-रियासतां केरे सब लोकव,</para>
  <para style="q" vid="PSA 148:11">हे हाकिमव ते धेरतरे सब न्याय केरनेबालव!<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />हे जुवान मट्ठव ते कुइयव,</para>
  <para style="q" vid="PSA 148:12">ते सियानव ते बच्‍चव!<verse eid="PSA 148:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />यहोवारे नंव्वेरी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 148:13">किजोकि सिर्फ तैसेरू नवं महाने;</para>
  <para style="q" vid="PSA 148:13">तैसेरी आदर ज़मीन ते आसमाने मांए।<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />तैनी अपने लोकां केरे लेई अक शिंग<note caller="+" style="f"><char style="fr" closed="false">148:14 </char><char style="fq" closed="false">शिंग </char><char style="ft" closed="false">तैन अपने लोक मज़बूत बनाए</char></note> उच्‍चु कियोरूए,</para>
  <para style="q" vid="PSA 148:14">इन तैसेरे सब भक्तां केरे लेई</para>
  <para style="q" vid="PSA 148:14">मतलब सारे इस्राएली लोकां केरे लेई ते तैसेरे नेड़े रानेबाले लोकां केरे लेई तारीफ़ केरनेरो विषय आहे।</para>
  <para style="q" vid="PSA 148:14">यहोवारी तारीफ़ केरा।<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">इस्राएल परमेशरेरी तारीफ़ केरते</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />यहोवारी तारीफ़ केरा!</para>
  <para style="q" vid="PSA 149:1">यहोवारे तारीफ़रे लेई नंव्वू गीत ज़ोथ,</para>
  <para style="q" vid="PSA 149:1">भक्तां केरि मेण्डली मां तैसेरी तारीफ़ केरा!<verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />इस्राएल अपने बनानेबाले परमेशरेरी वजाई सेइं खुशी भोए,</para>
  <para style="q" vid="PSA 149:2">सिय्योनेरे रानेबाले अपने राज़ेरे वजाई सेइं खुशी मनान!<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />तैना लोक नेच़तां तैसेरे नव्वेंरी तारीफ़ केरन,</para>
  <para style="q" vid="PSA 149:3">खेन्जरी ते सैन्गी बज़ेइतां तैसेरू भजन ज़ोन!<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />किजोकि यहोवा अपने लोकन सेइं खुशी रहते,</para>
  <para style="q" vid="PSA 149:4">तै हलीम लोकन मुक्ति देइतां तैन शोभने बाले बनालो।<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />परमेशरेरे लोक ज़ींतनेरे वजाई सेइं खुशी भोन,</para>
  <para style="q" vid="PSA 149:5">तैना अपने बिछ़ाने पुड़ भी तैसेरी जयजयकार केरन।<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />तैन केरि ज़बाना परमेशरेरी बड़ी तारीफ़ भोए,</para>
  <para style="q" vid="PSA 149:6">ते तैन केरे हथ्थन मां दूई धारण बाली तलवारां रान,<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />कि तैना राष्ट्रन करां बदलो घिन्नी सखन;</para>
  <para style="q" vid="PSA 149:7">ते रियासतां-रियासतां केरे लोकन सज़ाह देन,<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />ते तैन केरे राज़ां केरि शंगलन सेइं,</para>
  <para style="q" vid="PSA 149:8">ते तैन केरे इज़्ज़तदारन बेड़न सेइं बेन्धतां रखन।<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />ते तैन्न ठहरावरेरी सज़ाह देले,</para>
  <para style="q" vid="PSA 149:9">तैसेरे सब भक्तां केरि एरी इज़्ज़त भोल्ही।</para>
  <para style="q" vid="PSA 149:9">यहोवारी तारीफ़ केरा।<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">तारीफ़रू अक भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />यहोवारी तारीफ़ केरा!</para>
  <para style="q" vid="PSA 150:1">परमेशरेरी पवित्र ठैरी मां तैसेरी तारीफ़ केरा।</para>
  <para style="q" vid="PSA 150:1">तैसेरी शेक्ति सेइं भेरतां अम्बरे मां</para>
  <para style="q" vid="PSA 150:1">तैसेरी तारीफ़ केरा।<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />यहोवारे महान कम्मां केरे वजाई सेइं,</para>
  <para style="q" vid="PSA 150:2">तैसेरी तारीफ़ केरा;</para>
  <para style="q" vid="PSA 150:2">तै बड़ो महाने एल्हेरेलेइ तैसेरी तारीफ़ केरा।<verse eid="PSA 150:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />नरशिंगे बज़ेइतां तैसेरी तारीफ़ केरा,</para>
  <para style="q" vid="PSA 150:3">सैन्गी बज़ेइतां तैसेरी तारीफ़ केरा।<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />डफली बज़ेइतां ते नेच़तां तैसेरी तारीफ़ केरा;</para>
  <para style="q" vid="PSA 150:4">तारदार साज़ बज़ेइतां ते बेंशोई बज़ेइतां</para>
  <para style="q" vid="PSA 150:4">तैसेरी तारीफ़ केरा।<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />झ़ेल्‍ली केरे उच्‍चे आवाज़ी सेइं</para>
  <para style="q" vid="PSA 150:5">तैसेरी तारीफ़ केरा;</para>
  <para style="q" vid="PSA 150:5">आनन्देरे बड़े उच्‍ची आवाज़ी बाले झ़ेल्‍ली बज़ाते</para>
  <para style="q" vid="PSA 150:5">परमेशरेरी तारीफ़ केरा!<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />ज़ेत्रे ज़ींते प्राणी आन</para>
  <para style="q" vid="PSA 150:6">सब यहोवारी तारीफ़ केरन!</para>
  <para style="q" vid="PSA 150:6">यहोवारी तारीफ़ केरा!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>