  <para style="h">फिलिप्पियों</para>
  <para style="toc3">फिल.</para>
  <para style="toc1">फिलिप्पियों केरे नंव्वे पौलुसेरी चिट्ठी</para>
  <para style="toc2">फिलिप्पियों</para>
  <para style="mt1">फिलिप्पियों</para>
  <chapter number="1" style="c" sid="PHP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1"/>अवं पौलुस, त कने तीमुथियुस, यीशु मसीहेरे दास आम। इश्शे तरफां सेब्भी पवित्र लोकां केरां नंव्वां, ज़ैना मसीह यीशु मां भोइतां फिलिप्पी नगरे मां रातन, रखवालन ते सेवकन समेत, <verse eid="PHP 1:1"/><verse number="2" style="v" sid="PHP 1:2"/>इश्शे बाजी परमेशर ते प्रभु यीशु मसीहे करां तुसन अनुग्रह ते शान्ति मैलती राए।<verse eid="PHP 1:2"/></para>
  <para style="s">पौलुसेरी प्रार्थना त कने परमेशरेरू शुक्र</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3"/>अवं ज़ैखन-ज़ैखन तुसन याद केरताईं, तैखन-तैखन अपने परमेशरेरू शुक्र केरताईं। <verse eid="PHP 1:3"/><verse number="4" style="v" sid="PHP 1:4"/>ते ज़ैखन भी तुश्शे सेब्भी केरे लेइ बिनती केरताईं, ते हमेशा आनन्दे सेइं प्रार्थना केरताईं। <verse eid="PHP 1:4"/><verse number="5" style="v" sid="PHP 1:5"/>किजोकि तुस पेइले दिहैड़े करां अज़ तगर यीशु मसीहेरी खुशखबरी फैलाने मां मीं सेइं साथी शामिल रावरेथ। <verse eid="PHP 1:5"/><verse number="6" style="v" sid="PHP 1:6"/>ते मीं इस गल्लरो भरोसोए, कि परमेशरे तुसन मां रोड़े कम्मेरी शुरुआत कियोरीए, तैए तैस कम्मे यीशु मसीहेरे वापस एजनेरे दिहाड़े तगर पूरू केरेलो। <verse eid="PHP 1:6"/><verse number="7" style="v" sid="PHP 1:7"/>इन जेइज़े, कि अवं तुसन सेब्भी केरे लेइ एरू सोची, किजोकि तुस मेरे मने मां बस्सोरेथ, ते मेरे कैदे मां खुशखेबरारे लेइ जुवाब ते सबूत देने मां तुस सब मीं सेइं साथी अनुग्रहे मां मीं साथिथ, <verse eid="PHP 1:7"/><verse number="8" style="v" sid="PHP 1:8"/>इस मां परमेशर मेरो गवाहे, कि अवं यीशु मसीहेरो ज़ेरो प्यार केरतां तुश्शे सेब्भी केरू लालच़ केरताईं। <verse eid="PHP 1:8"/><verse number="9" style="v" sid="PHP 1:9"/>ते अवं ई प्रार्थना केरताईं, कि तुश्शो प्यार ज्ञान ते सेब्भी किसमेरो ज़मीर सेइं होरे भी बद्धते गाथ। <verse eid="PHP 1:9"/><verse number="10" style="v" sid="PHP 1:10"/>इड़ी तगर तुस रोड़ी करां रोड़ी गल्लां ट्लाऐरी बुझ़ा, ते मसीहेरे दिहाड़े तगर सच़्च़े बनोरे राथ; ते ठोकर न खाथ। <verse eid="PHP 1:10"/><verse number="11" style="v" sid="PHP 1:11"/>ते तैस धार्मिकतारे फले सेइं ज़ै यीशु मसीहेरे ज़िरिये भोते, भेरोते गाथ ज़ैस सेइं परमेशरेरी महिमा ते बड़याई भोती राए।<verse eid="PHP 1:11"/></para>
  <para style="s">पौलुसेरे कैदे सेइं खुशखेबरारे तरक्की</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12"/>हे ढ्लाव ते बेइनव, अवं सच़ ज़ोताईं, कि तुस इन ज़ाना, कि मीं पुड़ ज़ै बीतोरीए, तैस सेइं खुशखेबरारी बड़ोतरी भी भोइ। <verse eid="PHP 1:12"/><verse number="13" style="v" sid="PHP 1:13"/>इड़ी तगर कि महाराज़ेरी सारी फौज ते बाकी सारे लोकन मां इन बांदू भोव कि अवं मसीहेरे लेइ कैद मां आई। <verse eid="PHP 1:13"/><verse number="14" style="v" sid="PHP 1:14"/>ते प्रभु यीशु मां ज़ैना ढ्ला आन, तैन मरां बड़े मेरे कैद भोनेरे वजाई सेइं आन, तैना हिम्मत केरतां परमेशरेरो वचन बेधड़क भोइतां ते दिलेरी सेइं शुनानेरी कोशिश केरतन।<verse eid="PHP 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15"/>किछ लोक त जलन ते लड़ैई सेइं मसीहेरो प्रचार केरतन ते किछ लोक सच़्च़े दिले सेइं। <verse eid="PHP 1:15"/><verse number="16" style="v" sid="PHP 1:16"/>किछ त इन सेमझ़तां कि अवं खुशखेबरारे लेइ जुवाब देनेरे लेइ ठेरावरोई प्यारे सेइं प्रचार केरताईं। <verse eid="PHP 1:16"/><verse number="17" style="v" sid="PHP 1:17"/>पन तैना होरे लोक साफ दिले सेइं नईं पन जलनी सेइं मसीहेरो प्रचार केरतन, इन सेमझ़तां कि मेरे कैद मां मेरे लेइ मुसीबत बधान। <verse eid="PHP 1:17"/><verse number="18" style="v" sid="PHP 1:18"/>त कुन भोव? सिर्फ इन, कि हर बत्तां चाए बुरे खियाले सेइं, चाए सच़ैई सेइं, मसीहेरे बारे मां खुशखबरी प्रचार भोतीए, ते अवं इस सेइं खुश आईं, ते खुश भी रेइलो।<verse eid="PHP 1:18"/></para>
  <para style="s">मसीह मां ज़ींतू रानू</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 1:19"/>किजोकि अवं ज़ानताईं, कि तुश्शी प्रार्थनाई सेइं, ते यीशु मसीहेरी आत्मारे दाने सेइं इसेरो नितीजो मेरी मुक्ति भोली। <verse eid="PHP 1:19"/><verse number="20" style="v" sid="PHP 1:20"/>अवं त दिले सेइं इन चाताईं, ते ई उमीद रखताई, कि अवं कोन्ची गल्ली मां न छिथोई, बल्के ज़ेन्च़रे मेरी बड़ी दिलेरी सेइं मसीहेरी बड़याई मेरे जिसमे सेइं भोती राई, तेन्च़रे हुना भी भोए चाए अवं ज़ींतो रेइ या मेर्री। <verse eid="PHP 1:20"/><verse number="21" style="v" sid="PHP 1:21"/>किजोकि मेरे लेइ ज़ींतू रानू मसीहे, ते मरनू फैइदोए। <verse eid="PHP 1:21"/><verse number="22" style="v" sid="PHP 1:22"/>पन अगर जिसमे मां ज़ींतू रानू मेरे कम्मेरे लेइ फैइदेमंदे त अवं न ज़ैनी, कि केस च़ुनी। <verse eid="PHP 1:22"/><verse number="23" style="v" sid="PHP 1:23"/>किजोकि मीं दुइयां केरे मझ़ाटे च़ुने मां मुशकिल भोने लोरीए। अवं मरनू चाताईं ताके स्वर्गे मां मसीह साथी रेइ बेटि, किजोकि इन बड़ू ज़रूरीए। <verse eid="PHP 1:23"/><verse number="24" style="v" sid="PHP 1:24"/>पन तुश्शी मद्दत केरनेरे लेइ मेरू ज़ींतू रानू बड़ू ज़रूरीए। <verse eid="PHP 1:24"/><verse number="25" style="v" sid="PHP 1:25"/>एल्हेरेलेइ कि मीं इलहेरो भरोसोए ते अवं ज़ानताईं कि अवं ज़ींतो रानोई, बल्के तुसन सेब्भन सेइं साथी रानोई ज़ैस सेइं अवं तुश्शी मद्दत केरि, कि विश्वासे मां मज़बूत भोथ, ते इस मां खुश राथ। <verse eid="PHP 1:25"/><verse number="26" style="v" sid="PHP 1:26"/>ज़ैखन अवं तुसन कां दुबारां एज्जी, तुसन कां जादे वजा भोली यीशु मसीह पुड़ घमण्ड केरनेरी एल्हेरेलेइ ज़ैन किछ तै मेरे ज़िरिये केरने लोरोए। <verse eid="PHP 1:26"/><verse number="27" style="v" sid="PHP 1:27"/>सिर्रफ एत्रू केरा कि तुश्शो चालचलन मसीहेरे खुशखेबरारे काबल भोए। चाए अवं तुसन एइतां हेरी, चाए न एज्जी, तुश्शे बारे मां इन शुनी, कि तुस अक मन भोइतां बनोरे रातथ, ते अकोट्ठे भोइतां खुशखेबरारे विश्वासेरे लेइ मेहनत केरते रातथ। <verse eid="PHP 1:27"/><verse number="28" style="v" sid="PHP 1:28"/>ते कोन्ची गल्ली मां खलाफत केरनेबालन करां न डराथ। ई तैन केरे लेइ बरबाद भोनेरो साफ निशाने, पन तुश्शे लेइ मुक्तरो, ते इन परमेशरेरे तरफां आए। <verse eid="PHP 1:28"/><verse number="29" style="v" sid="PHP 1:29"/>किजोकि मसीहेरे वजाई सेइं तुसन पुड़ ई अनुग्रह भोव कि न सिर्फ तैस पुड़ विश्वास केरा पन तैसेरेलेइ दुःख भी झ़ैल्लां। <verse eid="PHP 1:29"/><verse number="30" style="v" sid="PHP 1:30"/>ते तुसन तेन्च़रे मुसीबत केरनीए, ज़ेन्च़रे तुसेईं मीं करां केरते लोरीए, ते हुना भी शुन्तन, कि अवं तेन्च़रे केरताईं।<verse eid="PHP 1:30"/></para>
  <chapter eid="PHP 1"/>
  <chapter number="2" style="c" sid="PHP 2"/>
  <para style="s">मसीहेरी दीनता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1"/>अगर मसीह मां किछ तसल्ली ते प्यारे सेइं हिम्मत ते आत्मारी मौजूदगी, ते किछ दर्द ते दयाए। <verse eid="PHP 2:1"/><verse number="2" style="v" sid="PHP 2:2"/>ते मेरो ई आनन्द पूरो केरा कि अक्के मन राथ ते अक्के प्यार, ते अक्के खियाल, ते अक्के सोच रखा। <verse eid="PHP 2:2"/><verse number="3" style="v" sid="PHP 2:3"/>खुदगरज़ या झूठी बड़यैयरे लेइ किछ न केरा पन नर्म भोइतां एक्की होरि एप्पू करां रोड़ो समझ़ा। <verse eid="PHP 2:3"/><verse number="4" style="v" sid="PHP 2:4"/>तुसन मरां हर कोई सिर्फ अपने भलैइयरे लेइ न सोचे, बल्के होरि केरि भलैइयरे लेइ भी सोचे। <verse eid="PHP 2:4"/><verse number="5" style="v" sid="PHP 2:5"/>ज़ेन्च़रे यीशु मसीहेरो सुभाव थियो तेन्च़रे तुश्शो भी भोए।<verse eid="PHP 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PHP 2:6"/>ज़ैने परमेशरेरे बराबर भोइतां भी परमेशरेरे बराबर भोने अपने कब्ज़े मां रखनेरी चीज़ न समझ़ू। <verse eid="PHP 2:6"/><verse number="7" style="v" sid="PHP 2:7"/>बल्के अपनो आप खाली केरो, ते गुलामेरू रूप धारण केरू, ते मैन्हु केरे ज़ेरो बनो। <verse eid="PHP 2:7"/><verse number="8" style="v" sid="PHP 2:8"/>ते मैनेरे रूपे मां बांदो केरतां दीन केरो, ते इड़ी तगर हुक्म मन्ने बालो राव, कि मौत, हाँ, क्रूसेरे मौत भी झ़ैल्ली। <verse eid="PHP 2:8"/><verse number="9" style="v" sid="PHP 2:9"/>एल्हेरेलेइ परमेशरे तै बड़ो महान भी केरो, ते तैस तैन नवं दित्तू ज़ैन सेब्भी नंव्वन करां बड्डूए। <verse eid="PHP 2:9"/><verse number="10" style="v" sid="PHP 2:10"/>कि स्वर्गे मां ते धेरती पुड़ ते धेरतलरे बुने; तैना सब यीशुएरे नंव्वे पुड़ ज़ैधूए टेकन। <verse eid="PHP 2:10"/><verse number="11" style="v" sid="PHP 2:11"/>ते बाजी परमेशरेरी महिमारे लेइ हर अक ज़िभ मन्ने कि यीशु मसीह प्रभुए।<verse eid="PHP 2:11"/></para>
  <para style="s">दुनियाई मां चमकनू</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12"/>ते हे मेरे ट्लारव, ज़ेन्च़रे तुस सदा हुक्म मन्ते ओरेथ, तेन्च़रे हुना भी न सिर्फ मीं सेइं साथी रेइतां पन खास केरतां ज़ैखन अवं दूर भोताईं फिरी भी डरते राथ ते थरकते अपने मुक्तरू कम पूरू केरते गाथ। <verse eid="PHP 2:12"/><verse number="13" style="v" sid="PHP 2:13"/>किजोकि परमेशर ज़ै तुसन मां कम केरते, ते तुसन इच्छा ते शक्ति तैन केरनेरे लेइ देते, ज़ैस सेइं तै खुश भोते। <verse eid="PHP 2:13"/><verse number="14" style="v" sid="PHP 2:14"/>त सब कम्मां बगैर शकैइतां ते बगैर बेंसी सेइं केरा। <verse eid="PHP 2:14"/><verse number="15" style="v" sid="PHP 2:15"/>ताके तुस बेइलज़ाम ते शरीफ भोइतां टारे ते ढीठ लोकन मां परमेशरेरे बेइलज़ाम बच्चे बना, ज़ैन मां तुस ज़िन्दगरो वचन घिन्तां दुनियाई मां बलते दीयां केरे ज़ेरे लेइहोते रातथ, <verse eid="PHP 2:15"/><verse number="16" style="v" sid="PHP 2:16"/>कि मसीहेरे वापस एजनेरे दिहाड़े घमण्ड केरनेरी वजा भोए, कि न मेरी दौड़-धूप ते न मेरी मेहनत बेकार भोए। <verse eid="PHP 2:16"/><verse number="17" style="v" sid="PHP 2:17"/>अगर मीं तुश्शे विश्वासेरे बलिदाने या सेवारे लेइ अपनो खून भी बगानो पे, त फिरी भी अवं खुश आईं, ते तुसन सेब्भी साथी खुश आईं। <verse eid="PHP 2:17"/><verse number="18" style="v" sid="PHP 2:18"/>तेन्च़रे तुस भी खुश भोथ, ते मीं साथी आनन्द केरा।<verse eid="PHP 2:18"/></para>
  <para style="s">तीमुथियुस ते इपफ्रुदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19"/>मीं प्रभु यीशु मां उमीदे, कि अवं तीमुथियुसे तुसन कां जल्दी भेज़ेलो, ताके तुश्शो हाल शुन्तां मीं शान्ति मैल्ले। <verse eid="PHP 2:19"/><verse number="20" style="v" sid="PHP 2:20"/>किजोकि मीं कां एरे ज़ेरे सुभावेरो कोई नईं, ज़ै साफ दिले सेइं तुश्शी फिक्र केरे। <verse eid="PHP 2:20"/><verse number="21" style="v" sid="PHP 2:21"/>किजोकि सब अपने फैइदो तोपतन, न कि यीशु मसीहे। <verse eid="PHP 2:21"/><verse number="22" style="v" sid="PHP 2:22"/>पन तुसेईं तै परखो ते पिशानो भी, कि ज़ेन्च़रे मट्ठू बाजी साथी केरते, तेन्च़रे तैनी मीं सेइं साथी खुशखबरी फैलाने मां मीं सेइं साथी मेहनत केरि। <verse eid="PHP 2:22"/><verse number="23" style="v" sid="PHP 2:23"/>ते मीं उमीदे, कि ज़ैखन मीं पतो च़लेलो कि मेरी कुन हालत भोली, तैखन अवं तैस लूशी भेज़ेलो। <verse eid="PHP 2:23"/><verse number="24" style="v" sid="PHP 2:24"/>ते मीं प्रभु मां भरोसोए, कि अवं एप्पू भी जल्दी एज्जेलो।<verse eid="PHP 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25"/>पन मीं इपफ्रुदीतुस ज़ै मेरो ढ्लाए, ते मद्दतगार, ते साथी योधो ते तुश्शो दूते, ते ज़रूरी गल्लन मां मेरी सेवा टेल केरनेबालोए, तुसन कां भेज़नो ज़रूरी समझ़ो। <verse eid="PHP 2:25"/><verse number="26" style="v" sid="PHP 2:26"/>किजोकि तैसेरो मन तुसन सेब्भन मां लग्गोरो थियो। एल्हेरेलेइ बे चैन रातो थियो किजोकि तुसेईं तैसेरे बिमैरारो हाल शुनोरो थियो। <verse eid="PHP 2:26"/><verse number="27" style="v" sid="PHP 2:27"/>ते तै सच़्च़े बिमार त भोरो थियो, इड़ी तगर कि मरने पुड़ थियो, परमेशरे तैस पुड़ दया की; ते सिर्फ तैस्से पुड़ नईं, पन मीं पुड़ भी, कि मीं दुःखे पुड़ दुख न भोए। <verse eid="PHP 2:27"/><verse number="28" style="v" sid="PHP 2:28"/>एल्हेरेलेइ अवं तैस भेज़नेरी होरि भी कोशिश केरि, तुस फिरी तैस सेइं मिलतां खुश भोइयथ ते मेरो भी दुःख घटे। <verse eid="PHP 2:28"/><verse number="29" style="v" sid="PHP 2:29"/>एल्हेरेलेइ तुस प्रभु मां बड़े आनन्दे सेइं तैस सेइं मुलाकात केरा, ते एरे ज़ेरे लोकां केरि आदर केरा। <verse eid="PHP 2:29"/><verse number="30" style="v" sid="PHP 2:30"/>किजोकि तैए मसीहेरे कम्मेरे लेइ अपनि जान खतरे मां छ़ेडतां मौतरे नेड़ो पुज़ोरो थियो, ताके ज़ै घाटो तुश्शे तरफां मेरी सेवा मां भोव, तैस तै पूरो केरे।<verse eid="PHP 2:30"/></para>
  <chapter eid="PHP 2"/>
  <chapter number="3" style="c" sid="PHP 3"/>
  <para style="s">सच़्च़ी धार्मिकता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1"/>हे मेरे ढ्लाव ते बेइनव, प्रभु मां आनन्दित राथ, तैना गल्लां तुसन बार-बार लिखने मां मीं त कोई कष्ट न भोए, ते इस मां तुश्शी सलामतीए। <verse eid="PHP 3:1"/><verse number="2" style="v" sid="PHP 3:2"/>तैन बुरां कम्मां केरनेबाले लोकन करां हुशार राथ, ज़ैना खुवार कुतरां केरे ज़ेरे खाने बालां आन। <verse eid="PHP 3:2"/><verse number="3" style="v" sid="PHP 3:3"/>किजोकि खतने बाले त असां आम ज़ैना परमेशरेरे आत्मारे च़लाने सेइं च़लतम ते आराधना केरतम ते मसीह यीशु पुड़ घमण्ड केरतम ते जिसमे पुड़ भरोसो न रखम। <verse eid="PHP 3:3"/><verse number="4" style="v" sid="PHP 3:4"/>पन अवं त जिसमे पुड़ भरोसो रेख्खी बटताईं अगर कोन्ची होरि जिसमे पुड़ भरोसो रखनेरो वचार भोए, त अवं तैस करां भी जादे रेख्खी बटताईं। <verse eid="PHP 3:4"/><verse number="5" style="v" sid="PHP 3:5"/>अठोवं दिहाड़े मेरो खतनो भोव, इस्राएल केरे कुटमे ते बिन्यामीनेरे गोत्रे मरां आई; इबरैनी केरो इब्रानी; कानूनेरे बारे मां अगर कोई ज़ोए त फरीसी। <verse eid="PHP 3:5"/><verse number="6" style="v" sid="PHP 3:6"/>जोशेरे बारे मां अगर कोई ज़ोए त कलीसियाई सताने बालो; ते अगर कानूनेरे धार्मिकतारे बारे मां कोई ज़ोए त बेइलज़ाम। <verse eid="PHP 3:6"/><verse number="7" style="v" sid="PHP 3:7"/>पन ज़ैना-ज़ैना गल्लां मेरे फैइदेरी थी तैना मीं मसीहेरे खातर नुकसान सैमझ़ोरिन। <verse eid="PHP 3:7"/><verse number="8" style="v" sid="PHP 3:8"/>बल्के मीं अपने प्रभु यीशु मसीहेरे पिशानारी बड़यैयरे वजाई सेइं अवं सब गल्लां नुकसान समझ़ताईं, ज़ेसेरे वजाई सेइं मीं बेड़ि चीज़ां केरो नुकसान उठाव, ते तैन कूड़ो समझ़ताईं, ज़ैस सेइं अवं मसीह हासिल केरि। <verse eid="PHP 3:8"/><verse number="9" style="v" sid="PHP 3:9"/>ते तैस मां भोइ, न कि एपनी तैस धार्मिता सेइं, ज़ै मूसेरे कानूने सेइं ए, बल्के तैस धार्मिकता सेइं ज़ै परमेशरेरे तरफां मसीह पुड़ विश्वास केरने सेइं भोतीए। <verse eid="PHP 3:9"/><verse number="10" style="v" sid="PHP 3:10"/>ते अवं तैस ते तैसेरे ज़ींती भोनेरी शक्ति, ते तैस साथी दुखन मां शामिल भोईं, ते तैसेरी मौतरी बराबरी हासिल केरि। <verse eid="PHP 3:10"/><verse number="11" style="v" sid="PHP 3:11"/>ताके अवं कोन्ची रीति सेइं मुड़दन मरां ज़ींते भोनेरे पदे तगर पुज़ी।<verse eid="PHP 3:11"/></para>
  <para style="s">निशानेरे पासे दौड़नू</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12"/>ई मतलब नईं, कि मीं हासिल केरू, या अवं सिद्ध भोइ जेव, पन तैस चीज़ी हासिल केरनेरे लेइ दौड़ने लोरोईं, ज़ेसेरे लेइ मसीह यीशुए अवं ट्लावरो थियो। <verse eid="PHP 3:12"/><verse number="13" style="v" sid="PHP 3:13"/>हे ढ्लाव ते बेइनव, मेरू इन गुमान नईं कि मीं ट्लाव, पन सिर्फ अक कम केरताईं, कि ज़ैना गल्लां पत्रोवं रेइ तैन बिसरतां, अग्री गल्लां केरे पासे गाताईं। <verse eid="PHP 3:13"/><verse number="14" style="v" sid="PHP 3:14"/>निशानेरे पासे दौड़तो च़लताईं, ताके मीं तैन इनाम मैल्ले, ज़ेसेरे लेइ परमेशरे अवं मसीह यीशु मां बा कुजेवरोईं। <verse eid="PHP 3:14"/><verse number="15" style="v" sid="PHP 3:15"/>असन मरां ज़ेत्रे सिद्धन, ईए विचार रखा, ते अगर कोन्ची गल्ली मां तुश्शो होरो खियाल भोए त परमेशर तैस भी तुसन पुड़ बांदो केरेलो। <verse eid="PHP 3:15"/><verse number="16" style="v" sid="PHP 3:16"/>एल्हेरेलेइ ज़ैड़ी तगर पुज़ोरेम, तैसेरे मुताबिक च़लम।<verse eid="PHP 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17"/>हे ढ्लाव ते बेइनव, तुस सब मिलतां मेरी ज़ेरि चाल च़ला, ते तैन केरि पिशान रखा, ज़ैना इस रीति पुड़ च़लतन ज़ेसेरी मिसाल तुस असन मां हेरतथ। <verse eid="PHP 3:17"/><verse number="18" style="v" sid="PHP 3:18"/>किजोकि बड़े एरी चाल च़लतन, ज़ैन केरि चर्चा मीं तुसन सेइं बार-बार की ते अज़ भी लेरां देइ-देइ ज़ोताईं, कि तैना अपने चालचलन सेइं मसीहेरे क्रूसेरे बैरिन। <verse eid="PHP 3:18"/><verse number="19" style="v" sid="PHP 3:19"/>तैन केरो अन्त विनाशे, तैन केरो ईश्वर पेटे, तैना एपनी शरमरी गल्लन पुड़ घमण्ड केरतन, ज़मीनारी गल्लन पुड़ मन लातन। <verse eid="PHP 3:19"/><verse number="20" style="v" sid="PHP 3:20"/>पन इश्शो मुलख स्वर्गे, ते अस एक्की मुक्ति देनेबाले प्रभु यीशु मसीह स्वर्गेरां बलगने लोरेम। <verse eid="PHP 3:20"/><verse number="21" style="v" sid="PHP 3:21"/>तैए एपनी शेक्ति सेइं तैस अस्सेरे मुताबिक तैना सब चीज़न अपने वशे मां केरि बटते, इश्शे कमज़ोर जिसमेरू रूप बेदलतां, अपने महिमारो जिसमेरे मुताबिक बनालो।<verse eid="PHP 3:21"/></para>
  <chapter eid="PHP 3"/>
  <chapter number="4" style="c" sid="PHP 4"/>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1"/>एल्हेरेलेइ हे मेरे ट्लारे ढ्लाव ते बेइनव अवं तुसन सेइं प्यार केरताईं, ज़ैन मां मेरो दिल लग्गोरो रहते ज़ै मेरो आनन्द ते ताज भोए, हे ट्लारे ढ्लाव ते बेइनव, प्रभु मां एन्च़रे मज़बूत राथ।<verse eid="PHP 4:1"/></para>
  <para style="s">ड्लां केरि हदायत</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2"/>अवं यूओदियारे छंदे केरताईं, ते सुन्तुखेरे भी, कि तैना प्रभु मां अक मन रान। <verse eid="PHP 4:2"/><verse number="3" style="v" sid="PHP 4:3"/>ते हे सच़्च़े मद्दतगार अवं तीं कां भी बिनती केरताईं, कि तू तैन कुआन्शां केरि मद्दत केर, किजोकि तैनेईं मीं सेइं साथी खुशखबरी फैलाने मां, क्लेमेंस ते मेरे तैन मद्दत केरनेबालन समेत मेहनत की, ज़ैन करां नंव्वां ज़िन्दगरे किताबी मां लिखोरन।<verse eid="PHP 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4"/>प्रभु मां सदा आनन्दित राथ; अवं फिरी ज़ोताईं, आनन्दित राथ। <verse eid="PHP 4:4"/><verse number="5" style="v" sid="PHP 4:5"/>तुश्शी नरमी सेब्भी मैनन् पुड़ बांदी भोए, प्रभु नेड़ोए। <verse eid="PHP 4:5"/><verse number="6" style="v" sid="PHP 4:6"/>कोन्ची भी गल्लारी फिक्र न केरा, पन हर एक्की गल्ली मां तुश्शी दरखुवास, प्रार्थना बिनती सेइं शुक्रे साथी परमेशरे कां हाज़र भोन। <verse eid="PHP 4:6"/><verse number="7" style="v" sid="PHP 4:7"/>तैखन परमेशरेरी शान्ति, ज़ै समझ़ी करां बिलकुल बेइरे, तुश्शे दिलन ते तुश्शे खियालन मसीह यीशु मां बिलकुल मैफूज़ रखेली।<verse eid="PHP 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8"/>आखरी मां, हे मेरे ढ्लाव ते बेइनव, ज़ैना-ज़ैना गल्लां सच़्च़ीन, ते ज़ैना-ज़ैना आदरारे काबलन, ते ज़ैना-ज़ैना गल्लां पवित्ररन, ते ज़ैना-ज़ैना गल्लां रोड़िन, ते ज़ैना-ज़ैना गल्लां मने रोड़ी लेगतिन, ते ज़ैना-ज़ैना गुण ते ज़ैना-ज़ैना गल्लां तरीफेरी, तैन पुड़ धयान केरा। <verse eid="PHP 4:8"/><verse number="9" style="v" sid="PHP 4:9"/>ज़ैना गल्लां तुसेईं मीं करां शिखी, ते कबूल की, ते शुनी ते मीं हेरी, तैन केरो हुक्म मन्ना तैखन परमेशर ज़ै शान्ति देनेबालोए तुसन साथी भोलो।<verse eid="PHP 4:9"/></para>
  <para style="s">दानेरे लेइ शुक्र</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10"/>अवं प्रभु मां बड़ो खुश आईं कि हुनी एत्रे दिहाड़न पत्ती तुसन मेरे बारे मां फिरी खियाल भोव; याकीन्न तुश्शे शुरुआती मां इस एरो खियाल थियो, पन तुसन मौको न मैल्लो। <verse eid="PHP 4:10"/><verse number="11" style="v" sid="PHP 4:11"/>इन नईं कि अवं अपनि कम्मेरे वजाई सेइं ज़ोताईं; किजोकि मीं इन्ने शिखोरूए कि ज़ैस हालती मां आई, तैस्से मां राज़ी भोईं। <verse eid="PHP 4:11"/><verse number="12" style="v" sid="PHP 4:12"/>अवं निकड़ू भोनू भी ज़ानताईं ते बड्डू भोनू भी ज़ानताईं, ते मीं हर एक्की गल्ली ते सेब्भी हालतन मां रज़नू, ढ्लुखुनू ते बधनू घटनू शिखोरूए। <verse eid="PHP 4:12"/><verse number="13" style="v" sid="PHP 4:13"/>ज़ै मीं ताकत देते तैस मां अवं सब किछ केरि बटताईं।<verse eid="PHP 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14"/>फिरी भी तुसेईं रोड़ू कियूं, कि मेरे दुखे मां मीं साथी भोए। <verse eid="PHP 4:14"/><verse number="15" style="v" sid="PHP 4:15"/>ते हे फिलिप्पियों, तुस एप्पू भी ज़ानतथ, कि खुशखबरी प्रचारेरे शुरुआती मां ज़ैखन अवं मकिदुनिया अग्रोवं जेव, तैखन मीं तुस शारे ते कोन्ची होरि मेनडलारे लोकेईं लेने देनेरे बारे मां मद्दत न की। <verse eid="PHP 4:15"/><verse number="16" style="v" sid="PHP 4:16"/>एन्च़रे ज़ैखन अवं थिस्सलुनीके नगरे मां थियो; तैखन भी तुसेईं मेरी घटी पूरी केरनेरे लेइ एक्की बार नईं बल्के काई बार किछ भेज़ेरू थियूं। <verse eid="PHP 4:16"/><verse number="17" style="v" sid="PHP 4:17"/>इन नईं कि अवं दान चाताईं पन अवं एरो फल चाताईं, ज़ै तुश्शे फैइदेरे लेइ बड़तो गाए। <verse eid="PHP 4:17"/><verse number="18" style="v" sid="PHP 4:18"/>मीं कां सब किछे, बल्के बड़ू जादे, ज़ैन तुसेईं इपफ्रुदीतुसेरे हथ्थे भेज़ोरू थियूं, तैन मेलतां रज़ोरोई, तैन त खुशबू ते कबूल केरनेरे काबल बलिदाने, ज़ैन परमेशरे पसंदे। <verse eid="PHP 4:18"/><verse number="19" style="v" sid="PHP 4:19"/>ते मेरो परमेशर भी अपने तैस धनेरे मुताबिक ज़ैन महिमा सेइं यीशु मसीह मांए, तुश्शी हर अक ज़रूरत पूरी केरेलो। <verse eid="PHP 4:19"/><verse number="20" style="v" sid="PHP 4:20"/>इश्शो परमेशर ते बाजी एरी महिमा हमेशा भोती राए। आमीन।<verse eid="PHP 4:20"/></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21"/>हर अक पवित्र मैन्हु ज़ै यीशु मसीह मांए तैस जो नमस्कार ज़ोथ। ज़ै ढ्ला मीं साथीए तुसन नमस्कार ज़ोते। <verse eid="PHP 4:21"/><verse number="22" style="v" sid="PHP 4:22"/>सब पवित्र लोकन, खास केरतां ज़ैना महाराज़ेरे घरानेरेन तुसन नमस्कार ज़ोतन।<verse eid="PHP 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23"/>इश्शे प्रभु यीशु मसीहेरो अनुग्रह तुश्शी आत्माई सेइं साथी राए।<verse eid="PHP 4:23"/></para>
  <chapter eid="PHP 4"/>
</usx>
