  <para style="h">1 थिस्सलुनीकियों</para>
  <para style="toc3">1 थिस्सलुनीकियों</para>
  <para style="toc1">थिस्सलुनीकियों केरे नंव्वे पौलुसेरी पेइली चिट्ठी</para>
  <para style="toc2">1 थिस्सलुनीकियों</para>
  <para style="mt1">1 थिस्सलुनीकियों</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>अवं पौलुस ई चिट्ठी लिखताईं। सिलवानुस ते तीमुथियुस भी मीं सेइं साथी आन, थिस्सलुनीकि नगरेरे कलीसियारे विश्वासी लोकन, ज़ैना बाजी परमेशर ते प्रभु यीशु मसीह मां आन, तैन अनुग्रह ते शान्ति मैलती राए।<verse eid="1TH 1:1"/></para>
  <para style="s">थिस्सलुनीकि नगरेरे लोकां केरो विश्वास</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>अस अपने प्रार्थनान मां तुसन याद केरतम, ते सदा तुश्शी सेब्भी केरे लेइ परमेशरेरू शुक्र केरतम। <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>ते अपने बाजी परमेशरेरे सामने तुश्शां कम्मां, ज़ैना तुस विश्वासेरे वजाई सेइं केरतथ, ते बड़ी मेहनतरां कम्मां ज़ैन सेइं पतो च़लते तुस होरन सेइं प्यार केरतथ, ते इश्शे प्रभु यीशु मसीहेरे वापस एजनेरे उमीदरे लेइ मुसीबतन मां सबर केरतथ, अस लगातार याद केरतम। <verse eid="1TH 1:3"/><verse number="4" style="v" sid="1TH 1:4"/>ते हे ढ्लाव, ते परमेशरेरे ट्लारे लोकव, अस ज़ानतम, कि तुस परमेशरे अपने लोक भोनेरे लेइ च़ुनोरेथ। <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>किजोकि यीशु मसीहेरे बारे मां खुशखबरी तुसन कां न सिर्फ लफसन मां पुज़ी बल्के पवित्र आत्मारे शक्ति सेइं, ते बड़े याकीने सेइं साथी पुज़ी, ज़ेन्च़रे तुस ज़ानतथ, कि अस तुश्शे लेइ तुसन मां केरहे बनोरे थिये। <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>ते तुस बड़े दुखे मां पवित्र आत्मारे आनन्दे सेइं साथी वचने मेन्तां इश्शे ते प्रभुएरी चाल च़लने लाए। <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>इड़ी तगर कि मकिदुनिया ते अखाया इलाकां केरे सेब्भी विश्वासी लोकां केरे लेइ तुस अक नमूनो बने। <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>किजोकि तुश्शे इट्ठां न सिर्फ मकिदुनिया ते अखाया इलाकन मां प्रभुएरू वचन शुनावं, पन तुश्शे विश्वासेरी ज़ै परमेशरे पुड़, हर ठैरी ज़ैड़ी अस जे चर्चा फेलोरीए, कि असन तुश्शे बारे मां ज़ोनेरी ज़रूरत नईं। <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>किजोकि तैना एप्पू होरन ज़ोतन कि ज़ैखन अस तुसन कां आए त कुन भोवं। तुस मूरतन करां दूर भोइतां परमेशरेरे पासे फिरे, ताके ज़ींते ते सच़्च़े परमेशरेरी सेवा केरथ, <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>ते तैसेरू मट्ठू स्वर्गेरां वापस एजने बलगते राथ, ज़ैन तैने मुड़दन मरां ज़ींतो कियूं, मतलब यीशुए, ज़ै असन एजनेबाले परमेशरेरे प्रकोपे करां बच़ाते।<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">पौलुसेरू प्रचारेरू कम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>हे ढ्लाव, तुस एप्पू ज़ानतथ कि इश्शू तुसन कां एजनू बेफैइदू न भोवं। <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>बल्के तुस एप्पू ज़ानतथ, कि असेईं पेइले फिलिप्पी नगरे मां दुख झ़ल्लने ते मुसीबत झ़ल्लने पुड़ भी इश्शे परमेशरे असन दिलेरी दित्ती, कि अस परमेशरेरो खुशखबरी बड़ी खलाफत भोंते भी तुसन शुनाम। <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>किजोकि इश्शी शिक्षा न टपलाने सेइं ते न धोखे सेइं, ते न बुरे मकसदे सेइं आए। <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>पन ज़ेन्च़रे परमेशरे अस इस काबल बनेइतां असन खुशखबरी सोंफी, अस तेन्च़रे बियांन केरतम, ते मैनन् नईं, बल्के परमेशरे खुश केरनेरे लेइ शिक्षा देतम, ज़ै इश्शे मन्न परखते। <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>तुस ज़ानतथ, कि असेईं कधी चपलूसारी गल्लां नईं कियोरी, ते न लालच़ेरे लेइ बहानो केरते थी, परमेशर इस गल्लरो गवाहे। <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>ते असन मसीहेरे प्रेरित भोनेरे वजाई सेइं तुसन करां मद्दत नेनेरो अधिकार थियो। फिर भी अस मैनन् करां आदर न थिये चाते, ते न तुसन करां, न होरि कोन्ची करां। <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>पन ज़ेन्च़रे अम्मा अपने मट्ठां केरि हेरगेश केरतीए, तेन्च़रे असेईं भी तुसन मां रेइतां नरमी हिराई। <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>ते तेन्च़रे अस तुश्शू लालच़ केरते, न सिर्फ परमेशरेरी खुशखबरी, पन अपने-अपने प्राण भी तुसन देनेरे लेइ तियार थिये, एल्हेरेलेइ तुस इश्शे बड़े ट्लारे भोइ जोरे थिये।<verse eid="1TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9"/>किजोकि, हे ढ्लाव, तुस इश्शी मेहनत ते कष्टे याद रखतथ, कि असेईं एल्हेरेलेइ रात दिहैड़ी कारोबार केरतां तुसन मां परमेशरेरी खुशखबरी प्रचार की, कि तुसन मरां कोन्ची पुड़ भार न भोए। <verse eid="1TH 2:9"/><verse number="10" style="v" sid="1TH 2:10"/>तुस एप्पू गवाह आथ, ते परमेशर भी गवाहे, कि तुसन ज़ैना विश्वास केरतथ, अस केरी पवित्रता, ते धार्मिकता ते बेइलज़ामे सेइं राए। <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>तुसन पतोए, कि ज़ेन्च़रे बाजी अपने बच्चन सेइं बर्ताव केरते, तेन्च़रे अस भी तुसन मरां हर केन्ची शिक्षा देते, ते दिलासो देते, ते समझ़ते थिये। <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>कि तुस एरी ज़िन्दगी ज़ीथ ज़ैस सेइं परमेशर खुश भोए, ज़ै तुसन अपने राज़्ज़े ते महिमा मां कुजाते।<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>अस भी परमेशरेरू शुक्र लगातार केरतम, कि ज़ैखन इश्शे ज़िरिये परमेशरेरी खुशखबरी तुसन कां पुज़ी ज़ै असेईं प्रचार की, त तुसेईं तै मैन्हु केरि नईं, बल्के परमेशरेरू वचन सेमझ़तां (ते सच़्च़े इन परमेशरेरू वचन आए) कबूल की, ते तै वचन तुसन मां ज़ैना मसीह पुड़ विश्वास केरतथ कम केरते। <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>एल्हेरेलेइ तुस, हे ढ्लाव, परमेशरेरी तैन कलीसियां केरि ज़ेरि चाल च़लने लाए, ज़ैना यहूदिया मां यीशु मसीह मां आन, किजोकि तुसन भी अपने लोकन करां एरो दुःख मैल्लो, ज़ेन्च़रे तैन यहूदन करां मैल्लोरो थियो। <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>ज़ैनेई प्रभु यीशु ते नबी भी मारे, ते अस सताए, ते परमेशर तैन सेइं खुश नईं, ते तैना सेब्भी मैन्हु केरि खलाफत केरतन। <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>ते तैना गैर कौमन सेइं तैन केरे मुक्तरे लेइ गल्लां केरने लेइ असन रोकतन। तैना पापे पुड़ पाप केरतन ज़ांतगर परमेशर तैन सज़ा न दे, ते हुनी परमेशरे तैन पक्को सज़ा देनेबालोए।<verse eid="1TH 2:16"/></para>
  <para style="s">कलीसिया सेइं मिलनेरे लेइ इच्छा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>हे ढ्लाव, ज़ैखन अस थोड़े च़िरेरे लेइ मने मां नईं बल्के बांदे मां तुसन करां अलग भोरे थी, ते असेईं बड़े लालच़े सेइं तुसन हेरनेरी बड़ी जादे कोशिश की। <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>एल्हेरेलेइ (मतलब मीं पौलुसे) एक्की बार नईं बल्के बार-बार तुसन कां एजनू चाव, पन शैतान अस तुसन कां एजनेरे लेइ रोके। <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>भला इश्शी उमीद, या आनन्द, या बड़ीयैयरू ताज कौन आए? इन तुस भोले ज़ैखन प्रभु यीशु वापस एज्जेलो <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>इश्शी बड़याई ते आनन्द तुस आथ।<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="s">तीमुथियुस भेज़नो</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>एल्हेरेलेइ ज़ैखन असेईं जादे न बेलगी बटु त असेईं इन ठहराव कि अस एथेंस नगरे मां अकैल्ले रेइ गाम। <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>ते असेईं तीमुथियुस ज़ै मसीहेरे खुशखबरी मां इश्शो ढ्लाए, ते परमेशरेरो सेवके, एल्हेरेलेइ तुसन कां भेज़ो, कि तै तुसन विश्वासे मां मज़बूत केरे ते तुश्शी हिम्मत बधाए। <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>कि कोई इन दुखां केरे वजाई सेइं न घबराए, किजोकि तुस एप्पू रोड़े च़ारे ज़ानतथ परमेशरे फैसलो कियोरोए, कि अस सताए गानेम। <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>किजोकि पेइले भी, ज़ैखन अस तुसन कां थिये, त तुसन सेइं ज़ोते थी, कि अस सताए गानेम, ते तुस ज़ानतथ एरू भोवं भी। <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>एल्हेरेलेइ ज़ैखन मीं करां होरू न बेलगोव, त तुश्शे विश्वासेरो हाल ज़ान्नेरे लेइ तीमुथियुस भेज़ो, किजोकि अवं डर्रो थियो कि एरू न भोए, कि अज़माने बाले (शैताने) तुस अज़माए त न, कि इश्शी मेहनत बेकार त न भोइ।<verse eid="1TH 3:5"/></para>
  <para style="s">तीमुथियुसेरे ज़िरिये खबर मैल्ली</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>पन तीमुथियुसे ज़ै तुसन करां इश्शे इड़ी अव, ते तुश्शे विश्वासेरे ते प्यारेरे बारे मां खुशखबरी शुनाई। ते ई गल भी शुनाई, कि तुस सदा प्यारे सेइं असन याद केरतथ, ते असन हेरनेरी इच्छा रखतथ, ज़ेन्च़रे अस भी तुसन हेरनेरी इच्छा रखतम। <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>एल्हेरेलेइ हे ढ्लाव, अपनि सारी तंगी, ते मुसीबतन मां तुश्शे विश्वासे सेइं असन शान्ति मैल्ली। <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>तुश्शो प्रभु पुड़ मज़बूत विश्वासे इश्शे लेइ अक नव्वें ज़िन्दगरे साँसेरो ज़ेरोए। <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>ते ज़ेरो आनन्द असन तुश्शे वजाई सेइं अपने परमेशरेरे सामने, तैसेरे बदले मां अस कोस तरीके सेइं परमेशरेरू शुक्र केरम! <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>अस रात दिहाड़ी बड़ी प्रार्थना केरते रातम, कि तुसन सेइं दुबारां मिलम, ते तुश्शी मद्दत केरम कि तुस होरि जादे मज़बूती सेइं प्रभु यीशु पुड़ विश्वास केरथ।<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>ते अस प्रार्थना केरतम कि इश्शो बाजी परमेशर ते इश्शे प्रभु यीशु, बत खोल्ले कि अस तुसन कां एज्जी बटम। <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>ते प्रभु एरू केरे, कि ज़ेन्च़रे अस तुसन सेइं प्यार केरतम; तेन्च़रे तुश्शो प्यार एप्पू मांमेइं, ते सेब्भी मैनन् सेइं बधे, ते तरक्की केरतो राए। <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>ताके तै तुश्शे मन्न मज़बूत केरे, कि ज़ैखन इश्शो प्रभु यीशु अपने सब पवित्र लोकन सेइं साथी एज्जे, त तै इश्शे बाजी परमेशरेरे सामने तुश्शे मन्न पवित्रता मां बेइलज़ाम ठहरालो।<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s">ज़िन्दगी ज़ै परमेशरे खुश केरे</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>आखर, हे ढ्लाव अस तुसन कां बिनती केरतम, ते तुसन प्रभु यीशु मां समझ़ातम, कि ज़ेन्च़रे तुसेईं इश्शो ज़ेरो चाल च़लन रख्खो, ते परमेशर खुश केरनो शिखोरोए, ते ज़ेन्च़रे तुस च़लतथ भी, तेन्च़रे तुस अग्रोवं बद्धते राथ। <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>किजोकि तुस ज़ानतथ, कि इना हदायतां असन प्रभु यीशु करां मैलोरिन। <verse eid="1TH 4:2"/><verse number="3" style="v" sid="1TH 4:3"/>परमेशर चाते, कि तुस पवित्र बना, मतलब बदमाशी केरने करां बच़ोरे राथ। <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>ते तुसन मरां हर केन्चे ज़ानेरू लोड़े कि केन्च़रां अपने कुआन्शी सेइं पवित्रता ते आदरी सेइं ज़िन्दगी ज़ीयोरी लोड़े। <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>ते इन कम खुवैइशी सेइं नईं, ते न गैर कौमां केरे ज़ेरे, ज़ैना परमेशरे न पिशानन्। <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>कि इस गल्ली मां कोई अपने विश्वासी ढ्लाए न ठगे, ते न तैस पुड़ हकोमत च़लाए; किजोकि प्रभु इन सब गल्लां केरि सज़ा देलो, ज़ेन्च़रे कि असेईं पेइलू तुसन सेइं ज़ोरू थियूं, ते खबरदारी भी दित्तोरी थी। <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>किजोकि परमेशरे अस अशुद्ध ज़िन्दगी ज़ींनेरे लेइ नईं, पन पवित्र ज़िन्दगी ज़ींनेरे लेइ कुजवरेम। <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>एल्हेरेलेइ ज़ै कोई इना हदायतां केरो इन्कार केरते, तै मैन्हु केरो नईं, पन परमेशरेरो इन्कार केरते, ज़ै अपनो पवित्र आत्मा तुसन देते।<verse eid="1TH 4:8"/></para>
  <para style="s">प्यार ते कम</para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>पन विश्वासी भाईच़ारेरे प्यारेरे बारे मां तुसन किछ लिखनेरी ज़रूरत नईं, एप्पू मांमेइं प्यार रखनो तुसेईं परमेशरे करां एप्पू शिखोरोए। <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>ते सारे मकिदुनिया इलाकेरे सेब्भी ढ्लान सेइं साथी एरू केरतथ भी, पन हे ढ्लाव, अस तुसन कां छन्दे केरतम कि होरे भी बद्धते गाथ। <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>ते ज़ेन्च़रे असेईं तुसन हुक्म दित्तो, तेन्च़रे तुस होरन सेइं लड़ाई न केरा, ते अपनू कम केरा त कने अपने लेइ कमाई केरा। <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>ते एन्च़रां तैना भी तुश्शी आदर केरेले ज़ैना विश्वासी नईं, ते तुसन कोन्ची चीज़ारो घाटो न भोलो।<verse eid="1TH 4:12"/></para>
  <para style="s">मसीहेरू ज़ींतू भोनू</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>हे ढ्लाव, अस न चातम, कि तुस तैन केरे बारे मां अनज़ान राथ ज़ैना विश्वासी मर्रेन अनज़ान राथ, एरू न भोए, कि तुस होरि केरे ज़ेरे शोग केरथ, ज़ैन मर्रनेरां पत्ती उमीद नईं। <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>किजोकि अगर अस विश्वास केरतम, कि यीशु मरो, ते ज़ींतो भोव, त तेन्च़रे परमेशर तैन भी ज़ैना यीशु पुड़ विश्वास केरतां मरे, परमेशर तैन भी यीशु सेइं साथी वापस आनेलो। <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/>किजोकि अस प्रभु यीशुएरे वचनेरे मुताबिक तुसन सेइं इन ज़ोतम, कि अस ज़ैना ज़ींतेम, ते प्रभुएरे वापस एजने तगर बंच़ोरे रामेले, त ज़ैना विश्वासी मर्रोरेन पेइले तैस सेइं मिलमेले, फिरी अस मिलमेले। <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>किजोकि प्रभु यीशु एप्पू स्वर्गेरां एज्जेलो; ते ज़ोरे सेइं हुक्म देलो, तैस वक्ते प्रधान दूतेरी आवाज़ शुनोली, ते परमेशरेरी महिमारो नड़शिनगो बज़ो गालो, ते ज़ैना मसीह पुड़ विश्वास केरनेबाले मां मर्रन, तैना पेइले ज़ींते भोनेन। <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>तैखन अस ज़ैना ज़ींते बच़ोरे रहमेले, ते तैन सेइं साथी बिदलारी पुड़ निये गानेम, कि अम्बरे मां प्रभु सेइं मिलमेले, ते तेइसेरां बाद अस सदा प्रभु सेइं साथी रानेम। <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>एल्हेरेलेइ इन्ने गल्लन सेइं एक्की होरि तस्सली देते राथ।<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s">यीशु दुबारां एजनो तियार भोथ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>हे ढ्लाव ते बेइनव, इसेरी ज़रूरत नईं, कि वक्तन ते कालां केरे बारे ज़ेइस प्रभु यीशु वापस एज्जेलो तुसन किछ लिखू गाए। <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>किजोकि तुस एप्पू रोड़े च़ारे ज़ानतथ, ते ज़ेन्च़रे च़ोर राती एइते, तेन्च़रे प्रभुएरू दुबारां एजनू भोलू। <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>ज़ैखन लोक ज़ोले, “कि शान्तिए, ते कोई डर नईं,” त तैन पुड़ अकदम विनाश एजनोए, ज़ेन्च़रे दोज़ींती पुड़ तकलीफ; ते तैना तैस मुसीबती करां न बच़ेले। <verse eid="1TH 5:3"/><verse number="4" style="v" sid="1TH 5:4"/>पन हे ढ्लाव ते बेइनव, तुस त (आत्मिक) आंधरे मां नईं, कि तै दिहाड़ी पुसन पुड़ च़ोरेरी ज़ेरि एज्जे। <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>किजोकि तुस सब लोअरे बच्चे आथ, ते दीसारे बच्चे आथ, अस न रातेरम, न आंधारेरेम। <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>एल्हेरेलेइ अस होरि केरे ज़ेरे झ़ुलोरे न रहम, पन बींझ़े रहम ते हुशार रहम। <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>किजोकि ज़ैना झ़ुलोरे रातन, तैना राती झ़ूलतन, ते ज़ैना नशे मां रातन, तैना राती नशे मां भोतन। <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>पन अस त दीसेरेम, विश्वास ते प्यार लेइतां कि इश्शी हिफाज़त भोए ज़ेन्च़रे झिलम सिपाहेरी हिफाज़त केरतीए, ते मुक्तरे उमीद लेइतां ज़ेन्च़रे सिपाही टोप लाते, खबरदार रहम। <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>किजोकि परमेशरे अस सज़ारे ते क्रोधेरे लेइ नईं, पन एल्हेरेलेइ च़ुनोरेम कि अस अपने प्रभु यीशु मसीहेरे ज़िरिये सेइं मुक्ति हासिल केरम। <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>यीशु मसीह इश्शे लेइ एल्हेरेलेइ मरो, कि अस चाए बींझ़े भोम, या झ़ुलोरे भोम, सब मिलतां तैस सेइं साथी ज़ींम। <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>एल्हेरेलेइ एक्की होरि हिम्मत देथ, ते एक्की होरेरी तरक्की भोनेरी ज़िरियो बना, लगातार, तुस एरू केरतथ भी।<verse eid="1TH 5:11"/></para>
  <para style="s">कलीसियाई शिक्षा</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>ते ढ्लाव, अस तुसन सेइं बिनती केरतम, कि ज़ैना तुश्शे लेइ बड़ी मेहनत केरतन, ते प्रभु मां तुश्शी अगवाई केरनेबाले आम, ते ज़ैना तुसन सलाह देतन, तैन केरि आदर केरा। <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>ते ज़ैना कम्मां तैनेईं तुश्शे लेइ कियां तैन केरे वजाई सेइं तैन केरि आदर ते तैन सेइं बड़ो प्यार केरा, ते एप्पू मांमेइं मेल मालपे सेइं राथ। <verse eid="1TH 5:13"/><verse number="14" style="v" sid="1TH 5:14"/>हे ढ्लाव ते बेइनव, अस तुसन कां मिनत केरतम, कि ज़ैना आलसी आन, तैन खबरदार केरा, ज़ैन केरि हिम्मत घटे तैन हिम्मत देथ, तैन केरि मद्दत केरा ज़ैना (आत्मिकता) मां कमज़ोरन, सेब्भी केरे लेइ बरदाशत केरनू हिराथ। <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>इस गल्लारू ध्यान रख्खा, कि कोई कोन्ची सेइं बुरीयीयैरे बदले बुराई न केरे, पन सदा भलाई केरनेरे लेइ तियार राथ, एप्पू मांमेइं ते सेब्भन सेइं भी भलाई केरनेरी कोशिश केरा। <verse eid="1TH 5:15"/><verse number="16" style="v" sid="1TH 5:16"/>सदा खुश राथ। <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>लगातार प्रार्थना केरते राथ। <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>हर हाले मां शुक्र केरा, किजोकि तुश्शे लेइ मसीह यीशु मां परमेशरेरी ईए मर्ज़ीए। <verse eid="1TH 5:18"/><verse number="19" style="v" sid="1TH 5:19"/>पवित्र आत्मारे कम्मन ज़ैना लोकां केरे ज़िन्दगी मां भोतन तैन न रोका। <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>भविष्यिवैनी केरो इन्कार न केरा। <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>सब गल्लां परखा, ज़ैना रोड़ी भोन तैन अपनाथ। <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>सेब्भी किसमेरी बुरैई करां बच़ोरे राथ।<verse eid="1TH 5:22"/></para>
  <para style="s">आशिर्वाद</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>शान्ति देनेबालो परमेशरे एप्पू तुसन पूरे तरीके सेइं पवित्र केरे; ते तुश्शी आत्मा ते प्राण ते जिसम इश्शे प्रभु यीशु मसीहेरे दुबारां एजने तगर पूरे, ते बेइलज़ाम ते सुरक्षित रान। <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>तुश्शो कुजाने बालो वफादारे, तै एरू केरेलो।<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>हे ढ्लाव, इश्शे लेइ प्रार्थना केरा।<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>सेब्भी विश्वासी ढ्लान मसीहेरे प्यारे सेइं नमस्कार केरा।<verse eid="1TH 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>अवं तुसन प्रभुएरी कसम देताईं, कि ई चिट्ठी सेब्भी विश्वासी ढ्लान पेढ़तां शुनाई गाए।<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>इश्शे प्रभु यीशु मसीहेरो अनुग्रह तुसन पुड़ भोतो राए।<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
