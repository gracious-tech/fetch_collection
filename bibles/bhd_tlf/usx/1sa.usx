  <para style="h">1 शमूएल</para>
  <para style="toc1">शमूएलेरी पेइली किताब</para>
  <para style="toc2">1 शमूएल</para>
  <para style="toc3">1 शमू.</para>
  <para style="mt">शमूएलेरी पेइली किताब</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">इस किताबी मां लिखने बालेरे बारे मां साफ नईं। भोइ सकते शमूएल इस किताबरो लिखने बालोए ते (<char style="xt"><ref loc="1SA 1:1-24:22">1 शमू. 1:1—24:22</ref></char>) इसेरी जानकारी देते ज़ै तैसेरे मौतरे बारे ते ज़िन्दगरे बारे मांए। ते इन भी भोइ सकते कि शमूएल नेबे इस किताबरो अक हिस्सो लिखोरोए। इस किताबरे बाकी लिखनेबाले नातान ते गाद नबी आन। (<char style="xt"><ref loc="1CH 29:29">1 इति. 29:29</ref></char>)।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग 1050-722 ई. पू.</para>
  <para style="ip">ई किताब मुल्खेरे दूई हिस्से भोनेरां बाद लिखोरीए ज़ै इस्राएल ते यहूदारे अलग-अलग वचन्न सेइं साफ भोते।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">ई किताब मुल्खेरे दूई हिस्से इस्राएल ते यहूदारे लोकां केरे लेई लिखोरी थी ज़ैन छुटकारेरी ते दर्शनेरी ज़रूरत थी।</para>
  <para style="is">मकसद</para>
  <para style="ip">1 शमूएलेरी किताबी मां कनान मुल्खे मां न्यायी लोकन करां लेइतां राज़ां केरे अधीन अक मुल्ख भोने तगर इतिहासे। शमूएल आखरी न्यायी भोव ते तैनी पेइले दूई राज़ां केरू अभिषेक कियूं।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">बदलाव</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. शमूएलेरी ज़िन्दगी ते सेवा <char style="ior"><ref loc="1SA 1:1-8:22">1:1—8:22</ref> </char></para>
  <para style="io1">2. इस्राएलेरे पेइले राज़े ते शाऊलेरी ज़िन्दगी <char style="ior"><ref loc="1SA 9:1-12:25">9:1—12:25</ref> </char></para>
  <para style="io1">3. शाऊलेरू कामयाब राज़ो न भोनू <char style="ior"><ref loc="1SA 13:1-15:35">13:1—15:35</ref></char></para>
  <para style="io1">4. दाऊदेरी ज़िन्दगी <char style="ior"><ref loc="1SA 16:1-20:42">16:1—20:42</ref> </char></para>
  <para style="io1">5. इस्राएलेरे राज़ेरे रूपे मां दाऊदेरो अनुभव <char style="ior"><ref loc="1SA 21:1-31:13">21:1—31:13</ref> </char></para>
  <chapter number="1" style="c" sid="1SA 1" />
  <para style="s">शीलो नगरे मां एल्काना ते तैसेरू टब्बर</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 1:1" />एल्काना नंव्वेरो अक मैन्हु थियो ज़ै एप्रैमेरे पहाड़ी प्रदेशेरे रामातैम सोपीम<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">रामातैम सोपीम </char><char style="ft" closed="false">इब्रानी मां “हा-रामथैम-सोपीम,”</char></note> नगरेरो रानेबालो थियो, तै एप्रैमेरे खानदाने मरां थियो, तैसेरे बाजी केरू नवं यरोहाम ते तैसेरे दादेरू नवं एलीहू ते तैसेरे पड़दादेरू नवं तोहू थियूं ज़ैन सूफेरे गोट्लेरे मरां थियूं। <verse eid="1SA 1:1" /><verse number="2" style="v" sid="1SA 1:2" />एलकानारे दूई लैड़ी थी; एकरू नवं हन्ना<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">हन्ना </char><char style="ft" closed="false">मतलब खूबसूरत</char></note> ते होरारू नवं पनिन्ना थियूं। पनिन्ना<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">पनिन्ना </char><char style="ft" closed="false">मतलब मोती</char></note> त बच्‍चे भोए, पन हन्ना कोई औलाद न भोइ।<verse eid="1SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 1:3" />एल्काना हर साल अपने नगरेरां सेनां केरे यहोवारी<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">सेनां केरे यहोवा </char><char style="ft" closed="false">इब्रानी मां यहोवा सबोथ आहे।</char></note> आराधना केरने ते मेलबलि च़ाढ़नेरे लेई शीलो नगरे मां गातो थियो; ते तैड़ी एली एरां दूई मट्ठां होप्नी ते पीनहास थियां, तैना यहोवारे याजक थिये। <verse eid="1SA 1:3" /><verse number="4" style="v" sid="1SA 1:4" />ज़ैखन भी एल्काना मेलबलि च़ाढ़तो थियो तैखन तै अपनि लैड़ी पनिन्ना ते तैसेरे सब मट्ठन-कुइयन बेलरे मासे मरां हिस्सो देतो थियो; <verse eid="1SA 1:4" /><verse number="5" style="v" sid="1SA 1:5" />हालांकि यहोवा हन्नारू गर्भ बन्द रखेरू थियूं, फिरी भी एल्काना हन्ना सेइं प्यार केरतो थियो, एल्हेरेलेइ तैस बेलरे मासे मरां दुगनो हिस्सो देतो थियो। <verse eid="1SA 1:5" /><verse number="6" style="v" sid="1SA 1:6" />पन तैसारी सौक एस वजाई सेइं, कि यहोवा तैसारू गर्भ बन्द रखेरू थियूं, तैसेरो मज़ाक बनाती ते ताने मारती थी। <verse eid="1SA 1:6" /><verse number="7" style="v" sid="1SA 1:7" />एल्काना हर साल एरू केरतो रहतो थियो; ते ज़ैखन हन्ना यहोवारे भवने मां गाती थी तैखन पनिन्ना तैसेरो मज़ाक बनाती थी। एल्हेरेलेइ तै लेरां देती थी ते रोट्टी न थी खाती।<verse eid="1SA 1:7" /></para>
  <para style="s">हन्नारी कसम</para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 1:8" />एल्हेरेलेइ एल्काना हन्ना सेइं ज़ोवं, हे हन्ना, तू किजो लेरां लगोरिस देने? ते रोट्टी किना खास? ते तेरो दिल किजो दुखी आहे? कुन तेरे लेई अवं दश मट्ठन करां भी बेद्धतां नईं? <verse eid="1SA 1:8" /><verse number="9" style="v" sid="1SA 1:9" />एक्‍की बार एन्च़रे भोवं कि शीलो नगरे मां खाने पीनेरे बाद हन्ना प्राथना केरनेरे लेई उठी। ते यहोवारे भवनेरे दारेरे नेड़े एली याजक कुर्सी पुड़ बिशोरो थियो। <verse eid="1SA 1:9" /><verse number="10" style="v" sid="1SA 1:10" />तैखन हन्ना मने मां परेशान भोइतां यहोवा कां प्राथना केरने लगी ते हुस्बुकैइं-हुस्बुकैइं लेरां देने लगी। <verse eid="1SA 1:10" /><verse number="11" style="v" sid="1SA 1:11" />ते तैसां ई मिन्नत मन्नी, “हे सेना केरे यहोवा, अगर तू एपनी दैसरे दुखे पुड़ सच़्च़े नज़र केरस, ते मीं पुड़ ध्यान देस, ते अपनि दासी न बिसरस, ते अपनि दैसी मट्ठू देस, त अवं तैस ज़िन्दगी भर यहोवारे हावाले केरेली, ते तैसेरे दोग्गे छ़ुरो कधे न लग्गेलो।”<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="LUK 1:48">लूक. 1:48</ref>.</char></note><verse eid="1SA 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 1:12" />ज़ैखन तै यहोवा कां प्राथना केरि राहोरी थी, तैखन एली याजक हन्नारे तुत्तरेरे पासे तेक्‍की राहोरो थियो। <verse eid="1SA 1:12" /><verse number="13" style="v" sid="1SA 1:13" />हन्ना मने मां ज़ोने लगोरी थी; तैसारे ओठ त हिलते थिये पन तैसारी आवाज़ न थी शुनोती; एल्हेरेलेइ एली याजके समझ़ू कि ऐह नशे मांए। <verse eid="1SA 1:13" /><verse number="14" style="v" sid="1SA 1:14" />तैखन एली याजके तैस पुछ़ू, “तू कैखन तगर नशे मां राहेली? अपनो नशो ट्लोड़।” <verse eid="1SA 1:14" /><verse number="15" style="v" sid="1SA 1:15" />हन्ना जुवाब दित्तो, “नईं, हे मेरे मालिक, अवं त दुखी आईं; मीं न दाछ़रो रस पीयोरोए ते न शराब, मीं अपने मनेरी गल खोलतां यहोवा सेइं ज़ोवरीए। <verse eid="1SA 1:15" /><verse number="16" style="v" sid="1SA 1:16" />अपनि दासी घटिया कौन्श न समझ़, ज़ैन किछ मीं हुन्ना तगर प्राथनाई मां ज़ोवरूए, तैन मीं दुखी भोइतां ते मज़ाक बनाए गानेरे वजाई सेइं ज़ोवरूए।” <verse eid="1SA 1:16" /><verse number="17" style="v" sid="1SA 1:17" />एली याजके ज़ोवं, “सुखे सेइं च़ली गा; इस्राएलेरो परमेशर ज़ैन तीं मगोरूए तैन दे।” <verse eid="1SA 1:17" /><verse number="18" style="v" sid="1SA 1:18" />हन्ना एली याजके सेइं ज़ोवं, “तेरी दयारी नज़र मीं पुड़ बनोरी राए।” तैखन तैसां गेइतां रोट्टी खाई, ते फिरी तै उदास न राई। <verse eid="1SA 1:18" /><verse number="19" style="v" sid="1SA 1:19" />तैना होरसां झ़ेझ़ां सुबेले उठतां यहोवारी आराधना केरतां रामाह नगरे जो अपने घरे वापस जेआं। ते एल्काना अपनि कौन्श हन्ना कां जेव, ते यहोवाए तैसारी प्राथनारो जुवाब दित्तो; <verse eid="1SA 1:19" /><verse number="20" style="v" sid="1SA 1:20" />किछ दिहाड़ना बाद हन्ना दोज़ींती भोइ ते ठीक वक्ते पुड़ तैस अक मट्ठू भोवं, ते तैसेरू नवं शमूएल<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fq" closed="false">शमूएल </char><char style="ft" closed="false">मतलब परमेशरेरू नवं या “परमेशरेरू नवं एल आहे।” </char></note> रख्खू, किजोकि तै ज़ोने लगी, “मीं यहोवा करां मेगतां एन मैल्होरूए।”<verse eid="1SA 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 1:21" />फिरी एल्काना अपने पूरे टब्बरे समेत यहोवारे सामने हर सालेरी ज़ेरि मेलबलि च़ाढ़ने ते अपनु बन्धू मुकानेरे लेई शीलो नगरे जो जेव। <verse eid="1SA 1:21" /><verse number="22" style="v" sid="1SA 1:22" />पन हन्ना अपने मुन्शे सेइं एन ज़ोइतां घरे रुकी, “ज़ैखन बच्‍चो दुद्ध पीनू शारेलो तैखन अवं तैस आनेली, कि तै यहोवारे सामने राए, ते ज़िन्दगी भर तैड़ी राए।” <verse eid="1SA 1:22" /><verse number="23" style="v" sid="1SA 1:23" />तैसारे मुन्शे एल्काना तैस सेइं ज़ोवं, “ज़ैन तीं रोड़ू लग्गे तैन्ने केर ज़ांतगर तू तैसेरू दुद्ध न छुटास तांतगर इड़ी बिशोरी रा; सिर्फ एत्रू भोए कि ज़ै वाधो तीं यहोवा सेइं कियोरोए पूरो केर।” एल्हेरेलेइ हन्ना तैड़ी घरे मां राई ते अपने मट्ठेरे दुद्ध छुटनेरे वक्ते तगर तैस पियाती राई।<verse eid="1SA 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 1:24" />ज़ैखन तैसां तैसेरू दुद्ध छुटावं तैस वक्ते तैन हेजू निकड़ू मट्ठू थियूं, तैखन तै तैस साथी घिन्तां शीलो नगरे मां यहोवारे भवने जो जेई। ते ट्लाई सालां केरू बछ़ड़ू<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="fq" closed="false">ट्लाई सालां केरू बछ़ड़ू </char><char style="ft" closed="false">इसेरो मतलब ट्लाई बछ़ड़ां भी भोइ सकते।</char></note>, ते लगभग 10 किल्‍लो अट्टू, ते मसकी मां भेरतां दाछ़रो रस घिन्तां जेई। <verse eid="1SA 1:24" /><verse number="25" style="v" sid="1SA 1:25" />ते तैनेईं बछ़ड़ू बलि केरतां बच्‍चो एली याजके कां आनो। <verse eid="1SA 1:25" /><verse number="26" style="v" sid="1SA 1:26" />तैखन हन्ना एली याजके सेइं ज़ोवं, “हे मेरे मालिक, कुन तीं यादे? अवं तैए कौन्श आईं ज़ै तीं कां इड़ी खड़ी भोइतां यहोवा कां प्राथना केरती थी। <verse eid="1SA 1:26" /><verse number="27" style="v" sid="1SA 1:27" />ऐन तैन्ने मट्ठूए ज़ेसेरे लेई मीं प्राथना कियोरी थी; ते यहोवाए मेरे ज़ोनेरे मुताबिक मेरे लेई कियोरूए। <verse eid="1SA 1:27" /><verse number="28" style="v" sid="1SA 1:28" />एल्हेरेलेइ अवं भी तैस यहोवा जो देतीं; कि तै अपने ज़िन्दगी भर सिर्फ यहोवारो सेवक राए।” तैखन तैनेईं तैड़ी यहोवारी आराधना की।<verse eid="1SA 1:28" /></para>
  <chapter eid="1SA 1" />
  <chapter number="2" style="c" sid="1SA 2" />
  <para style="s">हन्नारी प्राथना</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 2:1" />तैखन हन्ना प्राथना केरतां ज़ोवं,</para>
  <para style="q" vid="1SA 2:1">“मेरो मन यहोवारे वजाई सेइं खुशे;</para>
  <para style="q" vid="1SA 2:1">मेरी क्रोड़ी यहोवारे वजाई सेइं उच्‍ची भोवरीए।</para>
  <para style="q" vid="1SA 2:1">हुनी मीं कां मेरे दुशमनां केरे लेई जुवाबे,</para>
  <para style="q" vid="1SA 2:1">किजोकि अवं तेरे कियोरे छुटकारे सेइं खुश आईं।<verse eid="1SA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="1SA 2:2" />यहोवारो ज़ेरो कोई पवित्र नईं,</para>
  <para style="q" vid="1SA 2:2">किजोकि तेरे अलावा कोई अथ्थी नईं;</para>
  <para style="q" vid="1SA 2:2">ते इश्शे परमेशरेरी ज़ेरि कोई चट्टान नईं।<verse eid="1SA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="1SA 2:3" />बेड्डी-बेड्डी गल्‍लां न केरा,</para>
  <para style="q" vid="1SA 2:3">ते घमण्डेरी गल्‍लां तुश्शे ऐशी मरां न निस्सन;</para>
  <para style="q" vid="1SA 2:3">किजोकि यहोवा परमेशर सब किछ ज़ानते,</para>
  <para style="q" vid="1SA 2:3">तै लोकां केरे कम्मां केरो न्याय केरते।<verse eid="1SA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="1SA 2:4" />शक्तिशाली सिपेही केरे धनुष ट्लूटी जे,</para>
  <para style="q" vid="1SA 2:4">ते ज़ैना कमज़ोर थिये तैना ताकतबर भोइ जे।<verse eid="1SA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="1SA 2:5" />ज़ैन कां खानेरे लेई बड़ू किछ थियूं हुनी तैन्न रोट्टरे लेई मज़दूरी केरनी पेई,</para>
  <para style="q" vid="1SA 2:5">ज़ैना नियन्ने थिये तैना फिरी रज़्ज़ने बाले भोए।</para>
  <para style="q" vid="1SA 2:5">ज़ै बेऔलाद थी तैसेरे सत बच्‍चे भोए,</para>
  <para style="q" vid="1SA 2:5">ते बड़े बच्‍चां केरि अम्मा उज़ड़ी जेई।<verse eid="1SA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="1SA 2:6" />यहोवा प्राण नेते ते ज़िन्दगी देनेबालोए;</para>
  <para style="q" vid="1SA 2:6">तैए पाताले मां ओसालते ते तैस मरां कढते भी।<verse eid="1SA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="1SA 2:7" />यहोवा किछ लोकन गरीब बनाते ते किछ अमीर भी बनाते,</para>
  <para style="q" vid="1SA 2:7">तैए लोकन बिछ़ोड़ते ते तैए खड़ो भी केरते।<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="LUK 2:7">लूक. 2:7</ref>.</char></note><verse eid="1SA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="1SA 2:8" />तै कंगाले धूड़ी पुड़ेरां खड़ो केरते;</para>
  <para style="q" vid="1SA 2:8">ते गरीबे मांज़नरे ढेरे पुड़ेरां केढतां खड़ो केरते,</para>
  <para style="q" vid="1SA 2:8">ताके तैन हुकूमत केरनेबालन सेइं साथी बिशाले,</para>
  <para style="q" vid="1SA 2:8">ते तै तैन्न आदरारे तखतेरे अधिकारी बनाते।</para>
  <para style="q" vid="1SA 2:8">किजोकि धेरतरे खम्भे यहोवारे आन,</para>
  <para style="q" vid="1SA 2:8">ते तैनी तैन्न पुड़ दुनिया खड़ी कियोरीए।<verse eid="1SA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1SA 2:9" />तै अपने भक्तां केरे पव्वन सम्भैलतां रखेलो,</para>
  <para style="q" vid="1SA 2:9">पन दुष्ट आंधरे मां च़ुपच़ाप राले;</para>
  <para style="q" vid="1SA 2:9">किजोकि कोई मैन्हु अपने ताकतरे वजाई सेइं ज़ींती न सके।<verse eid="1SA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1SA 2:10" />ज़ैना यहोवा सेइं लड़तन तैना च़कराच़ूर भोल्हे;</para>
  <para style="q" vid="1SA 2:10">तै तैन केरे खलाफ अम्बरे मां गरज़ेलो।</para>
  <para style="q" vid="1SA 2:10">यहोवा पूरी दुनियारो न्याय केरेलो;</para>
  <para style="q" vid="1SA 2:10">ते अपने अभिषिक्त राज़ेरी शक्ति बद्धाते,</para>
  <para style="q" vid="1SA 2:10">ते तैसेरी इज़्ज़त बधालो।”<verse eid="1SA 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 2:11" />तैखन एल्काना रामाह नगरे मां अपने घरे जो च़लो जेव। ते शमूएल एली याजके सेइं साथी यहोवारी सेवा केरने लगो।<verse eid="1SA 2:11" /></para>
  <para style="s">एली याजकेरां मट्ठां</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 2:12" />एली याजकेरां मट्ठां त लुच्‍चां थियां; तैनेईं यहोवा न पिशानो। <verse eid="1SA 2:12" /><verse number="13" style="v" sid="1SA 2:13" />एलेरां मट्ठां याजक थियां, पन तैना लोकन सेइं एरहो बर्ताव केरते थिये, कि ज़ैखन कोई मैन्हु मेलबलि च़ाढ़तो थियो तैखन याजकेरो सेवक मास पकानेरे मौके अक नोकी बालो कंटो हथ्थे मां एन्हतां, <verse eid="1SA 2:13" /><verse number="14" style="v" sid="1SA 2:14" />तैस कड़ाही, हाण्डी, हँडे या तशले मां छ़डतो थियो ते ज़ेत्रू मास कंटे मां लगतू थियूं तेत्रू याजके जो देतो थियो। एरू तैना याजक मट्ठां शीलो नगरे मां सारे इस्राएली आराधना केरनेबाले लोकन सेइं केरतां थियां ज़ैना तैड़ी एइते थिये। <verse eid="1SA 2:14" /><verse number="15" style="v" sid="1SA 2:15" />कधे-कधे चर्भी फुकने करां पेइले भी याजकेरो सेवक एइतां मेलबलि च़ाढ़ने बाले सेइं ज़ोतो थियो, “ट्लाड़नेरे लेई याजके मास दे; तै तीं करां बनेवरू मास नईं, कच़्च़ू मास नेलो।” <verse eid="1SA 2:15" /><verse number="16" style="v" sid="1SA 2:16" />ते अगर कोई बलि देनेबालो तैस सेइं ज़ोतो थियो, “पेइली चर्भी फुकोने दे, तैखन ज़ेत्रो मन चाहे तेत्रू नेथ।” तैखन तै ज़ोतो थियो, “नईं, हुन्ना दे; नईं त मीं थुसोड़तां नेनूए।” <verse eid="1SA 2:16" /><verse number="17" style="v" sid="1SA 2:17" />एन्च़रे सेइं एली याजकेरे जुवान मट्ठां केरो पाप यहोवारी नज़री मां बड़ो बेधी जेवरो थियो। किजोकि तैना यहोवारी च़ढ़तलरी अनादर केरते न थिये।<verse eid="1SA 2:17" /></para>
  <para style="s">शमूएलेरी सेवकाई</para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 2:18" />पन शमूएल ज़ैन हेजू निकड़ू मट्ठू थियूं सनेरो एरहो पवित्र एपोद<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">एपोद </char><char style="ft" closed="false">इड़ी एपोदेरो मतलब सनी एरहो कपड़ो ज़ै कमरी पुड़ लव गातो थियो। ज़ै मैन्हु सेवारू कम केरतो थियो। (हेरा, शमू. 2.28; 14.3; 21.9; 22.18; 2 शमू 6.14) </char></note> लेइतां यहोवारी सेवा केरतो थियो। <verse eid="1SA 2:18" /><verse number="19" style="v" sid="1SA 2:19" />ते तैसेरी अम्मा हर साल तैसेरे लेई अक निकड़ो ज़ेरो चोगो बनेइतां ज़ैखन अपने मुन्शे सेइं साथी हर सालेरी मेलबलि च़ाढ़ने एइती थी तैखन चोगो तैस जो आनती थी। <verse eid="1SA 2:19" /><verse number="20" style="v" sid="1SA 2:20" />एली याजके एल्काना ते तैसेरी लैड़ी आशिर्वाद देइतां ज़ोवं, “यहोवा इस मट्ठेरे बदले ज़ैन तैसां यहोवा जो अर्पण कियोरूए तीं इस कौन्शी सेइं वंश दे;” तैसेरां बाद तैना अपने घरे जो च़ले जे। <verse eid="1SA 2:20" /><verse number="21" style="v" sid="1SA 2:21" />यहोवा हन्ना पुड़ ध्यान दित्तू, ते तैस होरां ट्लाई मट्ठां ते दूई कुइयां भोइ। ते तैन केरू मट्ठू शमूएल परमेशरेरे हज़ूरी मां बेडोतू जेवं।<verse eid="1SA 2:21" /></para>
  <para style="s">एली याजकेरे घरानेरे खलाफ नबूवत</para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 2:22" />एली बड़ो बुढो भोइ जेवरो थियो, ते तैनी तैन सब किछ शुनू ज़ैन तैसेरां मट्ठां ज़ैन सारे इस्राएली लोकन सेइं केरतन। तैसेरां मट्ठां मिलापे बाले तेम्बेरे दारे पुड़ सेवा केरनेबैली कौन्शन सेइं कुकर्म भी केरतन। <verse eid="1SA 2:22" /><verse number="23" style="v" sid="1SA 2:23" />तैखन एली याजके अपने मट्ठन सेइं ज़ोवं, “तुस एरां-एरां कम्मां किजो केरतथ? मीं इन सेभी लोकन करां तुश्शे कुकर्मेरी गल्‍लां शुनोरिन। <verse eid="1SA 2:23" /><verse number="24" style="v" sid="1SA 2:24" />हे मेरे मट्ठव, एरू न केरा, किजोकि ज़ै खबर मेरे शुन्ने मां एइचे तै रोड़ी नईं; तुस त यहोवारे लोकन करां पाप करातथ। <verse eid="1SA 2:24" /><verse number="25" style="v" sid="1SA 2:25" />अगर अक मैन्हु होरि मैन्हेरे खलाफ पाप केरे, तैखन त न्यायी तैसेरो न्याय केरेलो; पन अगर कोई मैन्हु यहोवारे खलाफ पाप केरे, त तैसेरे लेई कौन बिनती केरेलो?” फिरी भी तैनेईं अपने बाजी केरि झ़िड़क न मेन्नी; किजोकि यहोवा तैन मारनेरो इरादो कियोरो थियो। <verse eid="1SA 2:25" /><verse number="26" style="v" sid="1SA 2:26" />तैन मट्ठू शमूएल बेडोतू जेवं ते यहोवा ते मैन्हु भी दूईये तैस सेइं खुशी रहते थिये। <verse eid="1SA 2:26" /><verse number="27" style="v" sid="1SA 2:27" />एक्सां परमेशरेरो अक नबी एली कां गेइतां तैस सेइं ज़ोने लगो, “यहोवा इन ज़ोते, कि ज़ैखन तेरे पूर्वजेरो घरानो मिस्र मुल्खेरे फ़िरौन राज़ेरे गुलैमी मां थियो, तैखन कुन अवं तेरे पूर्वजे<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="fq" closed="false">पूर्वजे </char><char style="ft" closed="false">हारून ते तैसेरू टब्बर</char></note> पुड़ बांदो न भोवं? <verse eid="1SA 2:27" /><verse number="28" style="v" sid="1SA 2:28" />ते कुन मीं तेरो पूर्वज इस्राएलेरे सारे गोट्लन मरां एल्हेरेलेइ च़ुनोरो न थियो, कि मेरो याजक भोइतां मेरी वेदी कां बलिदान च़ाढ़े, ते गुग्गल बाले, ते मेरे सामने एपोद लाए? ते कुन मीं तेरे पूर्वजेरे घराने इस्राएली लोकां केरि सैरी च़ढ़तलां न थी दित्तोरीए? <verse eid="1SA 2:28" /><verse number="29" style="v" sid="1SA 2:29" />एल्हेरेलेइ मेरी मेलबलि ते अन्नबलि ज़ैन मीं अपने भवने मां च़ाढ़नेरो हुक्म दित्तोरोए, तैन तुस लोक किजो पव्वन हैठ ढ्लन्च़तथ? ते तू किजो अपने मट्ठां केरि मीं करां जादे इज़्ज़त केरतस, कि तुस मेरे इस्राएली लोकां केरि रोड़ी करां रोड़ी च़ढ़तल खेइ खेइतां मोट्टे भोइ गाथ? <verse eid="1SA 2:29" /><verse number="30" style="v" sid="1SA 2:30" />एल्हेरेलेइ इस्राएलेरो परमेशर यहोवा इन ज़ोते, कि मीं ज़ोवरू त थियूं, कि तेरो घरानो ते तेरे पूर्वजेरो घरानो मेरे सामने हमेशा च़लतो रालो; पन हुनी यहोवारू ज़ोनू इने, कि ऐह गल मीं करां दूर राए; किजोकि ज़ैना मेरी आदर केरेले अवं भी तैन केरि आदर केरेलो, ते ज़ैना मीं घटिया समझ़ेले तैना घटिया समझ़े गाले। <verse eid="1SA 2:30" /><verse number="31" style="v" sid="1SA 2:31" />शुन, तैना दिहाड़े एइतन, कि अवं तेरी ताकत ते तेरे पूर्वजेरे घरानेरी<note caller="+" style="f"><char style="fr" closed="false">2:31 </char><char style="fq" closed="false">पूर्वजेरे घरानेरी </char><char style="ft" closed="false">तेरे गोट्लेरी</char></note> ताकत नाश केरेलो, कि तेरे घराने मां कोई बुढो न भोइ बटेलो। <verse eid="1SA 2:31" /><verse number="32" style="v" sid="1SA 2:32" />इस्राएली लोकां केरू केत्रू रोड़ू कि न भोए, फिरी भी तीं मेरे घरेरो दुख हेरनो पेलो, ते तेरे घराने मां कोई कधी बुढो न भोल्हो। <verse eid="1SA 2:32" /><verse number="33" style="v" sid="1SA 2:33" />अवं तेरे कुले मरां सेभन करां अपने वेदरी सेवा न थुसोड़ेलो, पन फिरी भी तेरी एछ़्छ़ी तेकती रहेली, ते तेरो मन दुखी भोल्हो, ते तेरे घरेरे जुवान सारे एपनी जुवैनी मां मेरि गाले। <verse eid="1SA 2:33" /><verse number="34" style="v" sid="1SA 2:34" />ते मेरी इस गल्‍लरो निशान तै आफत भोल्ही ज़ै होप्नी ते पीनहास नंव्वेरे तेरे दूईये मट्ठन पुड़ पेली; ज़ैना दूईये एक्सां मेरि गाले <verse eid="1SA 2:34" /><verse number="35" style="v" sid="1SA 2:35" />ते अवं अपने लेई अक वफादार याजक ठहरेइलो, ज़ै मेरे दिले ते मनेरे इच्छयारे मुताबिक केरेलो, ते अवं तैसेरू घर बसेइलो ते आबाद केरेलो, ते तै मेरे अभिषिक्त राज़ेरे अग्री-अग्री हमेशा च़लतो फिरतो रालो। <verse eid="1SA 2:35" /><verse number="36" style="v" sid="1SA 2:36" />ते एरू भोल्हु कि ज़ै कोई तेरे घराने मां बच़ेलो तै तैस कां नेड़े गेइतां एक्‍की निकड़े ज़ेरे टुक्ड़े चैंदरे<note caller="+" style="f"><char style="fr" closed="false">2:36 </char><char style="fq" closed="false">टुक्ड़े चैंदरे </char><char style="ft" closed="false">किछ पेइंसे</char></note> या एक्‍की रोट्टरे लेई झुकतां ज़ोलो, याजकेरे कोन्ची कम्मे मां मीं रख, ज़ैस सेइं मीं अक टुक्ड़ो रोट्टी मैल्हे।”<verse eid="1SA 2:36" /></para>
  <chapter eid="1SA 2" />
  <chapter number="3" style="c" sid="1SA 3" />
  <para style="s">शमूएले परमेशरेरू दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 3:1" />तैन दिहाड़न मां तैन मट्ठू शमूएल एली याजकेरे अधीन रेइतां यहोवारी सेवा केरतू थियूं। तैन दिहाड़न मां यहोवारू वचन बड़ू घट शुनोतू थियूं; ते दर्शन घट मैलतू थियूं। <verse eid="1SA 3:1" /><verse number="2" style="v" sid="1SA 3:2" />ते एक्‍की राती ज़ैखन एली अपने कमरे मां झ़ुलोरो थियो। (तैसेरी नज़र त कमज़ोर भोने लगोरी थी ते तैस लेइहोतू न थियूं) <verse eid="1SA 3:2" /><verse number="3" style="v" sid="1SA 3:3" />ते शमूएल यहोवारे भवने मां ज़ैड़ी परमेशरेरो सन्दूख थियो झ़ुलोरो थियो, ते परमेशरेरो दीयो हेजू तगर हिशोरो न थियो। <verse eid="1SA 3:3" /><verse number="4" style="v" sid="1SA 3:4" />तैखन यहोवा शमूएले जो तैसेरू नवं घिन्तां हक दित्ती; ते तैनी जुवाब दित्तो, “कुन हुक्मे!” <verse eid="1SA 3:4" /><verse number="5" style="v" sid="1SA 3:5" />तैखन तैनी एली कां गेइतां देवड़तां पुछ़ू, “कुन हुक्मे, तीं त मींजो हक दित्ती।” तैनी ज़ोवं, “मीं हक नईं दित्तोरी; गा फिरी झ़ुल्‍ल।” त तै गेइतां झ़ुल्‍ली जेव। <verse eid="1SA 3:5" /><verse number="6" style="v" sid="1SA 3:6" />तैखन यहोवा फिरी हक देइतां ज़ोवं, “हे शमूएल!” शमूएल उठतां एली कां गेइतां ज़ोने लगो, “कुन हुक्मे, तीं मींजो हक दित्ती।” तैनी ज़ोवं, “हे मेरे मट्ठां, मीं हक नईं दित्तोरी; गा फिरी झ़ुल्‍ल।” <verse eid="1SA 3:6" /><verse number="7" style="v" sid="1SA 3:7" />तैस मौके तगर शमूएल यहोवा न थियो पिशानतो, ते न यहोवारू वचन तैस पुड़ बांदू भोवरू थियूं। <verse eid="1SA 3:7" /><verse number="8" style="v" sid="1SA 3:8" />फिरी ट्लेइयोवं बार यहोवा शमूएले जो हक दित्ती। तैनी फिरी उठतां एली कां गेइतां ज़ोवं, “कुन हुक्मे, तीं मींजो हक दित्ती।” तैखन एली याजके समझ़ू कि एस मट्ठे जो यहोवा हक दित्तोरिए। <verse eid="1SA 3:8" /><verse number="9" style="v" sid="1SA 3:9" />एल्हेरेलेइ एली याजके शमूएले सेइं ज़ोवं, “गा फिरी झ़ुल्‍ल; ते अगर तै फिरी हक देलो, त तू ज़ोइयां, ‘हे यहोवा, ज़ो, किजोकि तेरो दास शुन्ने लगोरोए।’” तैखन शमूएल एपनी जगाई पुड़ गेइतां झ़ुल्‍ली जेव।<verse eid="1SA 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 3:10" />तैखन यहोवा एइतां खड़ो भोव, ते पेइलेरू ज़ेरू ज़ोवं, “शमूएल! शमूएल!” तैखन शमूएले ज़ोवं, “ज़ो, किजोकि तेरो दास शुनी राहोरोए।” <verse eid="1SA 3:10" /><verse number="11" style="v" sid="1SA 3:11" />यहोवा शमूएले सेइं ज़ोवं, “शुन, अवं इस्राएले मां अक एरू कम केरनेबालोईं, ज़ैस शुन्तां सारे लोक डरेले। <verse eid="1SA 3:11" /><verse number="12" style="v" sid="1SA 3:12" />तैखन अवं एलीएरे खलाफ तैन सब किछ पूरू केरेलो ज़ैन मीं तैसेरे घरानेरे बारे मां ज़ोवरू थियूं, तैन शुरू करां आखरी तगर पूरू केरेलो। <verse eid="1SA 3:12" /><verse number="13" style="v" sid="1SA 3:13" />किजोकि मीं त तैस इन ज़ोवरूए, कि अवं तैस परमेशरेरी निन्दा केरनेरे पापेरी सज़ाह ज़ैस तै ज़ानते हमेशारे लेई तैसेरे घरेरो न्याय केरेलो, किजोकि तैसेरां मट्ठां एप्पु लानती भेवरन, ते तैनी तैना न रोकां। <verse eid="1SA 3:13" /><verse number="14" style="v" sid="1SA 3:14" />एस वजाई सेइं मीं एली याजकेरे घरानेरे बारे मां कसम खेवरीए, कि एलीएरे घरानेरे अधर्मेरी सज़ाह न त मेलबेलि सेइं ते न अन्नबेलि सेइं माफ़ भोल्ही।”<verse eid="1SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 3:15" />शमूएल झ़ेझ़ां तगर झ़ुलोरो राव; तैखन तैनी यहोवारे घरेरू दार खोल्‍लू। ते शमूएल एली सेइं दर्शनेरी गल्‍लां ज़ोने करां डरो। <verse eid="1SA 3:15" /><verse number="16" style="v" sid="1SA 3:16" />पन एली याजके शमूएल कुजेइतां ज़ोवं, “हे मेरे मट्ठां, शमूएल।” तैनी ज़ोवं, “कुन हुक्मे।” <verse eid="1SA 3:16" /><verse number="17" style="v" sid="1SA 3:17" />तैखन तैनी पुछ़ू, “तै को ज़ेरि गल्‍ले ज़ै यहोवा तीं सेइं ज़ोवरीए? तैस मीं करां न छ़ुपा। ज़ैन किछ तैनी तीं सेइं ज़ोवरूए अगर तू तैस मरां किछ भी छ़ुपास, त परमेशर तीं सेइं सखते करां सखत बर्ताव केरे।” <verse eid="1SA 3:17" /><verse number="18" style="v" sid="1SA 3:18" />तैखन शमूएले तैस सैरी गल्‍लां ज़ोई, ते किछ भी छ़ुपेइतां न रख्खू। तैनी ज़ोवं, “तै त यहोवाए; ज़ैन किछ तैस रोड़ू लग्गे तैन्ने केरे।”<verse eid="1SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 3:19" />ते शमूएल बेडोतो जेव, ते यहोवा तैस सेइं साथी राव, ते परमेशरे शमूएलेरी कोई भी गल बेफल भोने न दित्ती। <verse eid="1SA 3:19" /><verse number="20" style="v" sid="1SA 3:20" />ते उत्तरेरे दान नगरे करां लेइतां दक्षिणेरे बेर्शेबा नगरे तगर रानेबाले सारे इस्राएली लोकन पतो लग्गो कि शमूएल यहोवारो नबी भोनेरे लेई च़ुनो जेवरोए।<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="ACT 13:20">प्रेरित. 13:20</ref>. </char></note> <verse eid="1SA 3:20" /><verse number="21" style="v" sid="1SA 3:21" />ते यहोवा शमूएले शीलो नगरे मां फिरी दर्शन दित्तू, किजोकि यहोवा एप्पु शमूएले जो शीलो नगरे मां मिलापे बाले तेम्बु मरां सन्देश दित्तोरो थियो।<verse eid="1SA 3:21" /></para>
  <chapter eid="1SA 3" />
  <chapter number="4" style="c" sid="1SA 4" />
  <para style="s">पवित्र सन्दूख थुसोड़नो</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 4:1" />शमूएलेरी चर्चा सारे इस्राएली लोकन मां फैली जेई। ते एक्सां इस्राएली लोक पलिश्ती लोकन सेइं जंग लड़नेरे लेई निस्से; ते तैनेईं त एबेनेजेर नगरेरे आसे-पासे डेरे लाए, ते पलिश्ती लोकेईं अपेक नगरे मां डेरे लाए। <verse eid="1SA 4:1" /><verse number="2" style="v" sid="1SA 4:2" />तैखन पलिश्ती लोकेईं इस्राएली लोकन पुड़ हमलो केरनेरी तियारी की, ते ज़ैखन बड़ी भारी लड़ाई भोने लगी तैखन इस्राएली लोक पलिश्ती लोकन करां हारे, ते तैनेईं लगभग 4000 इस्राएली सिपाही जंगरे मैइदाने मां मारे। <verse eid="1SA 4:2" /><verse number="3" style="v" sid="1SA 4:3" />ज़ैखन इस्राएली सिपाही डेरन मां वापस आए, तैखन इस्राएलेरे बुज़ुर्ग लोक ज़ोने लगे, “यहोवा अज़ अस पलिश्ती लोकन करां किजो हाराए? एज्जा, अस यहोवारे करारेरो सन्दूख शीलो नगरे मरां आनम, कि तै इश्शे दरमियान एइतां असन दुश्मना केरे हथ्थे करां बच़ाए।” <verse eid="1SA 4:3" /><verse number="4" style="v" sid="1SA 4:4" />तैखन तैन लोकेईं किछ सिपाही शीलो नगरे मां भेज़े तैड़ी तैना करूबन करां बह बिशोरो सेनारे यहोवारो करारेरो सन्दूख मगाव; ते परमेशरेरे करारेरे सन्दूखे सेइं साथी एली याकेरां दूईये मट्ठां, होप्नी ते पीनहास भी साथी आं।<verse eid="1SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 4:5" />ज़ैखन यहोवारो करारेरो सन्दूख डेरन मां पुज़्ज़ो, तैखन सारे इस्राएली एत्रे ज़ोरे सेइं ललकारने लगे, कि ज़मीन हिलने लगी। <verse eid="1SA 4:5" /><verse number="6" style="v" sid="1SA 4:6" />एस ललकारनेरी आवाज़ शुन्तां पलिश्ती लोक पुछ़ने लगे, “इब्रानी लोकां केरे डेरन मां इस बड़े ललकारारी कुन वजाए?” तैखन तैन्न पतो लग्गो, कि यहोवारो सन्दूख डेरन मां आनोरोए। <verse eid="1SA 4:6" /><verse number="7" style="v" sid="1SA 4:7" />तैखन पलिश्ती डेरतां ज़ोने लगे, “तैन डेरन मां इस्राएलेरो परमेशर<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="fq" closed="false">परमेशर </char><char style="ft" closed="false">पलिश्ती लोक इस्राएली केरे केरो देबतो ज़ोते थिये।</char></note> एवरोए।” फिरी तैनेईं एक्‍की होरि सेइं ज़ोवं, “ओ! असन सेइं पेइलू एरू कधे नईं भोवरू। <verse eid="1SA 4:7" /><verse number="8" style="v" sid="1SA 4:8" />ओ! एरे महाप्रतापी देबतां केरे हथ्थे मरां असन कौन बच़ालो? इना त तैन्ना देबतेन ज़ैनेईं मिस्री लोकन पुड़ सुनसान ठैरी मां हर किसमेरी मुसीबतां छ़डोरी थी। <verse eid="1SA 4:8" /><verse number="9" style="v" sid="1SA 4:9" />हे पलिश्ती लोकव, तुस हिम्मत केरा, ते मड़द बना, कोन्च एरू न भोए कि ज़ेन्च़रे इब्रि लोक तुश्शे गुलाम भोइ जेवरे थिये तेन्च़रे तुस भी तैन केरे गुलाम भोइ गाथ; मड़देरे ज़ेरे जंग केरा।”<verse eid="1SA 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 4:10" />तैखन पलिश्ती सेना बड़े बहदरी सेइं लड़ी, ते एत्री मार काट भोइ, कि 30000 इस्राएली सिपाही मारे जे। ते बाकी ज़ैना बच़े तैना अपने डेरन जो जे, ते एन्च़रे सेइं तैनेईं इस्राएली हाराए। <verse eid="1SA 4:10" /><verse number="11" style="v" sid="1SA 4:11" />ते एली याजकेरां दूईये मट्ठां, होप्नी ते पीनहास भी मारां जेआं; ते परमेशरेरो सन्दूख पलिश्ती लोकेईं थुसोड़तां नियो।<verse eid="1SA 4:11" /></para>
  <para style="s">एली याजकेरी मौत</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 4:12" />तैखन तैस दिहाड़े अक बिन्यामीनी सिपाही जंगी मरां दौड़तां दुखेरे मारे अपना लिगड़ां छ़िंदतां ते दोग्गे पुड़ मित्ती छ़ेडतां शीलो नगरे मां पुज़्ज़ो। <verse eid="1SA 4:12" /><verse number="13" style="v" sid="1SA 4:13" />तै ज़ैखन पुज़्ज़ो तैस मौके एली, ज़ेसेरो दिल परमेशरेरे सन्दूखेरे फिक्री मां कम्बने लगोरो थियो, तै बत्तरी ड्लेखी कुर्सी पुड़ बिशोरो बलगने लगोरो थियो। ते ज़ेरो तै सिपाही नगरे मां पुज़्ज़ो तैनी खबर दित्ती त नगरेरे सारे लोक चिन्डां मारने लगे। <verse eid="1SA 4:13" /><verse number="14" style="v" sid="1SA 4:14" />चिन्डां मारनेरी शोर शुन्तां एली पुछ़ने लगो, “ए शोर ते हैल्‍लो मच़नेरी कुन वजाए?” ते तैनी सिपैहिए लूशी गेइतां एली पूरी खबर शुनाई। <verse eid="1SA 4:14" /><verse number="15" style="v" sid="1SA 4:15" />तैस वक्ते एली त 98 सालां केरो थियो, ते तैसेरी एछ़्छ़ी केरि नज़र कमज़ोर पेई जेवरी थी, ते तैस किछ लेइहोतू न थियूं। <verse eid="1SA 4:15" /><verse number="16" style="v" sid="1SA 4:16" />तैनी सिपैहिए एली सेइं ज़ोवं, “अवं तैए आईं ज़ै जंगी मरां अज़्ज़े देवड़तां एवरोईं।” तैनी पुछ़ू, “हे मेरे मट्ठां, कुन खबरे?” <verse eid="1SA 4:16" /><verse number="17" style="v" sid="1SA 4:17" />तैनी खबर देनेबाले जुवाब दित्तो, “इस्राएली लोक पलिश्ती लोकां केरे सामनेरां नेश्शी जेवरेन, ते बड़े सिपाही मारे जेवरेन, ते तेरां दूईये मट्ठां होप्नी ते पीनहास भी मारे जे, ते परमेशरेरो सन्दूख भी थुसोड़तां नियोरोए।” <verse eid="1SA 4:17" /><verse number="18" style="v" sid="1SA 4:18" />ते ज़ेरू तैनी परमेशरेरे सन्दूखेरू नवं घिन्नू एली फाटकेरे कुर्सी पुड़ेरां खिरकतां पत्रोवं बिछ़ड़ी जेव; ते बुढो ते भारी भोनेरे वजाई सेइं तैसेरो मेट्टू ट्लूटी जेव, ते तै मेरि जेव। तैनी त इस्राएली लोकां केरो न्याय 40 सालन तगर कियोरो थियो।<verse eid="1SA 4:18" /></para>
  <para style="s">ईकाबोदेरू ज़र्म</para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 4:19" />एली याजकेरी नुश ज़ै पीनहासेरी कौन्श थी तै दोज़ींती थी, ते तैसेरो गल्हे बिशनेरो वक्त नेड़े थियो। ते ज़ैखन तैसां परमेशरेरे सन्दूखेरे थुसोड़नेरी खबर, ते अपने शेहरे ते मुन्शेरे मरनेरी खबर शुनी, तैखन तैस गल्हे बिशनेरी तकलीफ भोने लगी, ते तै तल्‍ले झुकी, ते तैस अक मट्ठू भोवं। <verse eid="1SA 4:19" /><verse number="20" style="v" sid="1SA 4:20" />तैसारे मरते-मरते तैना घैई ज़ैना तैसारे आसे-पासे खेड़ि थी तैनेईं तैस सेइं ज़ोवं, “न डर, किजोकि तीं मट्ठू भोवरूए।” पन तैसां किछ जुवाब न दित्तो, ते न किछ ध्यान दित्तू। <verse eid="1SA 4:20" /><verse number="21" style="v" sid="1SA 4:21" />ते परमेशरेरो सन्दूख थुसोड़ो गाने ते अपनो शेरहे ते मुन्शेरे वजाई सेइं तैसा एन ज़ोइतां तैस मट्ठेरू नवं ईकाबोद रख्खू, ज़ेसेरो मतलबे, “इस्राएले मरां महिमा च़ली जेवरीए!” <verse eid="1SA 4:21" /><verse number="22" style="v" sid="1SA 4:22" />फिरी तैसां ज़ोवं, “इस्राएले मरां परमेशरेरी महिमा च़ली जेवरीए, किजोकि परमेशरेरो सन्दूख थुसोड़तां नियोरोए।”<verse eid="1SA 4:22" /></para>
  <chapter eid="1SA 4" />
  <chapter number="5" style="c" sid="1SA 5" />
  <para style="s">पलिश्ती लोकां केरे मुल्खे मां करारेरो सन्दूख</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 5:1" />पलिश्ती लोकेईं परमेशरेरो सन्दूख एबेनेजेर नगरे मरां थुसोड़तां अश्दोद नगरे मां पुज़व; <verse eid="1SA 5:1" /><verse number="2" style="v" sid="1SA 5:2" />फिरी पलिश्ती लोकेईं परमेशरेरो सन्दूख नेइतां तैन केरे दागोन देबतेरे मन्दरे मां पुज़ेइतां दागोनेरे मूरती कां रख्खो। <verse eid="1SA 5:2" /><verse number="3" style="v" sid="1SA 5:3" />होरसां झ़ेझ़ां अश्दोदी लोकेईं उठतां कुन हेरू, कि दागोन देबतेरी मूरती यहोवारे सन्दूखेरे सामने दोग्गेरे भारे ज़मीनी पुड़ बिछ़ड़ोरीए। तैखन तैनेईं दागोनेरी मूरती छ़ुइतां तैसेरे जगाई पुड़ फिरी खड़ी की। <verse eid="1SA 5:3" /><verse number="4" style="v" sid="1SA 5:4" />फिरी होरसां झ़ेझ़ां ज़ैखन तैना खड़े उठे, तैखन कुन हेरू, कि दागोन देबतेरी मूरती यहोवारे सन्दूखेरे सामने क्रोड़रे भारे ज़मीनी पुड़ बिछ़ड़ोरीए; ते दागोनेरी क्रोड़ी ते दूईये पेखड़ी खुरनी पुड़ केटोरी मैल्ही; एन्च़रां सेइं दागोनेरे मूरतरू सिर्फ रिगल रेई जेवरूए। <verse eid="1SA 5:4" /><verse number="5" style="v" sid="1SA 5:5" />एस्से वजाई सेइं अज़्ज़ेरे दिहाड़े तगर भी दागोन देबतेरे पुजारी ते ज़ेत्रे दागोनेरे मन्दरे मां गातन, तैना अश्दोद नगरे मां दागोनेरी खुरनी पुड़ पव न रखन।<verse eid="1SA 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 5:6" />तैखन यहोवा अश्दोदी लोकन बड़ी सज़ाह देने लगो, ते तै अश्दोद नगर ते तैसेरे आसे-पासेरे इलाकन मां रानेबाले लोकन गिलटी केरे ज़िरिये दुखी केरने लगो। <verse eid="1SA 5:6" /><verse number="7" style="v" sid="1SA 5:7" />ऐह हाल हेरतां अश्दोद नगरेरे लोकेईं ज़ोवं, “इस्राएली लोकां केरे देबतेरो सन्दूख असन मां न लोड़े राहोरो; किजोकि असन ते इश्शे देबते दागोने बड़ी सज़ाह लगोरो देने।” <verse eid="1SA 5:7" /><verse number="8" style="v" sid="1SA 5:8" />तैखन तैनेईं पलिश्ती लोकां केरे पंच़े राज़न जो समाद भेज़ो, ते तैन पुछ़ू, “अस इस्राएली केरे देबतेरे सन्दूखे सेइं कुन केरम?” तैनेईं जुवाब दित्तो, “इस्राएली केरे देबतेरो सन्दूख घुमेइतां गत नगरे मां पुज़व गाए।” तैखन तैनेईं इस्राएली केरे परमेशरेरो सन्दूख घुमेइतां गत नगरे मां पुज़व। <verse eid="1SA 5:8" /><verse number="9" style="v" sid="1SA 5:9" />ज़ैखन तैना तैस घुमेइतां तैड़ी पुज़्ज़े, त एरू भोवं कि यहोवारो क्रोध तैस नगरेरे लोकां केरे खलाफ भड़को; ते तैने निकड़े करां बड्डे तैस गत नगरे मां सारे लोक गिलटन सेइं बिमार किये, तैस नगरे मां बड़ी खलबली भोइ। <verse eid="1SA 5:9" /><verse number="10" style="v" sid="1SA 5:10" />तैखन तैनेईं परमेशरेरो सन्दूख पलिश्ती केरे होरि एक्रोन नगरे जो भेज़ो ते ज़ेरो परमेशरेरो सन्दूख एक्रोन नगरे मां पुज़्ज़ो तेरहे तैट्ठेरे लोक एन ज़ोइतां चिन्डां मैरतां लेरां देने लगे, “इस्राएली लोकां केरे देबतेरो सन्दूख घुमेइतां असन कां एल्हेरेलेइ पुज़व जेवरो, कि अस ते इश्शे लोक मारे गाम।” <verse eid="1SA 5:10" /><verse number="11" style="v" sid="1SA 5:11" />तैखन तैनेईं पलिश्ती लोकां केरे पंच़े राज़े अकोट्ठे किये, ते तैन सेइं ज़ोवं, “इस्राएली लोकां केरे देबतेरो सन्दूख भेज़ो गाए, कि तै अपने जगाई पुड़ वापस गाए, ते असन ते इश्शे लोकन मैरी न सके।” तैस नगरेरे लोकन मां त मौतरे डरेरी खलबली मच़ोरी थी, ते परमेशरेरो क्रोध तैन केरे खलाफ भड़कोरो थियो। <verse eid="1SA 5:11" /><verse number="12" style="v" sid="1SA 5:12" />एक्रोन नगरेरे किछ लोक मरे ते ज़ैना न थिये मरोरे तैना भी गिलटेइं सेइं बिमार भोए; ते एक्रोन नगरेरे लोक अपने देबतन कां मद्दतरे लेई बिनती केरने लगे।<verse eid="1SA 5:12" /></para>
  <chapter eid="1SA 5" />
  <chapter number="6" style="c" sid="1SA 6" />
  <para style="s">पलिश्ती मुल्खे मरां करारेरे सन्दूखेरी वापसी</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 6:1" />यहोवारो सन्दूख पलिश्ती लोकां केरे मुल्खे मां सत महीन्न तगर राव। <verse eid="1SA 6:1" /><verse number="2" style="v" sid="1SA 6:2" />तैखन पलिश्ती लोकेईं अपने याजक ते जैदूगिर कुजेइतां तैन पुछ़ू, “यहोवारे सन्दूखे सेइं अस कुन केरम? असन ज़ोथ कि कुन प्रायश्चित देइतां अस तैस तैसेरे जगाई पुड़ भेज़म?” <verse eid="1SA 6:2" /><verse number="3" style="v" sid="1SA 6:3" />तैनेईं जुवाब दित्तो, “अगर तुस इस्राएली लोकां केरे देबतेरो सन्दूख तैड़ी भेज़ने चाथ, त तै एन्च़रे नईं भेज़नो; तैसेरो नुकसान भरनेरे लेई ज़रूर दोषबलि देइयथ। तैखन तुस ठीक भोल्हे, ते तुसन पतो च़लेलो कि तैसेरो क्रोध तुसन पुड़ेरां किजो दूर न भोव।” <verse eid="1SA 6:3" /><verse number="4" style="v" sid="1SA 6:4" />पलिश्तेईं पुछ़ू, “अस तैसेरो नुकसान भरनेरे लेई को ज़ेरि दोषबलि देम?” तैनेईं जुवाब दित्तो, “पलिश्ती राज़ां केरि गिनतरे मुताबिक सोन्नेरी पंच़ गिलटी, ते सोन्नेरे पंच़ मूंशे; किजोकि तुसन लोकन ते तुश्शे राज़न अक्‍के रोगे। <verse eid="1SA 6:4" /><verse number="5" style="v" sid="1SA 6:5" />ते तुस एपनी गिलटी ते अपने मुल्खेरो नाश केरनेबाले मूंशा केरि भी मूरती बनेइतां इस्राएलेरे देबतेरी महिमा केरा। भोइ सकते कि तै अपनो सज़ारो हथ तुसन पुड़ेरां ते तुश्शे देबतन ते मुल्खे पुड़ेरां दूर केरे। <verse eid="1SA 6:5" /><verse number="6" style="v" sid="1SA 6:6" />तुस अपनो मन किजो एरहो सखत केरतथ ज़ेन्च़रे मिस्री लोकेईं ते फ़िरौने अपनो मन सखत कियोरो थियो? ज़ैखन तैनी तैन केरे सामने हैरान केरनेबालां कम्मां कियोरां थियां, तैखन तैनेईं इस्राएली लोक गाने न थिये दित्तोरे, ते कुन तैना च़ले न जे? <verse eid="1SA 6:6" /><verse number="7" style="v" sid="1SA 6:7" />एल्हेरेलेइ हुनी तुस अक नंव्वी गड्डी बनाथ, ते एरी दूई दुद्ध देनेबाली बेछ़ी नेथ ज़ैन जुऊं न भोए दित्तोरू, ते तैन बेछ़न गेड्डी मां जोट्लतां तैन केरे बच्‍चन नेइतां गेवड़े मांजो वापस देथ। <verse eid="1SA 6:7" /><verse number="8" style="v" sid="1SA 6:8" />तैखन यहोवारो सन्दूख नेइतां तैस गेड्डी पुड़ रखा, ते सोन्नेरी ज़ैना चीज़ां तुस तैसेरो नुकसान भरनेरे लेई दोषबेलरे लेई देथ तैन होरि सन्दूखे मां रेखतां तैस कां रखा। फिरी तैस भेज़ा कि तै एप्पु च़ली गाए। <verse eid="1SA 6:8" /><verse number="9" style="v" sid="1SA 6:9" />पन हेरते राथ; अगर तै सन्दूख अपने मुल्खेरी बत्ती मांमेइं भोइतां बेतशेमेश<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="fq" closed="false">बेतशेमेश </char><char style="ft" closed="false">मतलब दिहाड़ेरू घर</char></note> नगरे जो गाए, त समझ़ा कि इश्शो ई बड्डो नुकसान तैसेरे वजाई सेइं भोवरोए अगर नईं, त अस समझ़ेले कि ई आफत असन पुड़ तैसेरी तरफां नईं, पन कुदरती एवरीए।”<verse eid="1SA 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 6:10" />पलिश्ती लोकेईं एन्च़रे कियूं; ते दुद्ध देने बैली बेछ़ी नेइतां तैस गेड्डी मां जोट्ली, ते तैन केरे बच्‍चे गेवड़े मां ढेपतां छ़डे। <verse eid="1SA 6:10" /><verse number="11" style="v" sid="1SA 6:11" />ते यहोवारो सन्दूख, ते सामानेरो सन्दूख, ज़ैस मां सोन्नेरे मूंशे ते एपनी गिलटी केरि मूरती गेड्डी पुड़ रेखी। <verse eid="1SA 6:11" /><verse number="12" style="v" sid="1SA 6:12" />तैखन बेछ़ी बेतशेमेश नगरेरे सिद्धी बत्तां च़ेलि; तैना सड़कां-सड़कां डांडां मैरती च़ेलि जेई, ते न देइने पासे न बांए पासे मुड़ी; ते पलिश्ती लोकां केरे राज़े तैन केरे पत्ती-पत्ती बेतशेमेश नगरेरे नेड़े पुज़्ज़े। <verse eid="1SA 6:12" /><verse number="13" style="v" sid="1SA 6:13" />ते बेतशेमेश नगरेरे लोक वैदी मां गेहुं केट्टी राहोरे थिये। ते ज़ैखन तैनेईं एछ़्छ़ी खेड़ि केरतां सन्दूख लाव, त तैखन तैना तैस लेइतां खुशी भोए। <verse eid="1SA 6:13" /><verse number="14" style="v" sid="1SA 6:14" />गड्डी बेतशेमेश नगरेरे रानेबाले यहोशूएरे उडारे मां गेइतां रुकी जेई, तैड़ी अक बड्डो घोड़ थियो। तैखन तैनेईं गेड्डरी लेकड़ी च़ीरी ते बेछ़ी केरि होमबलि केरतां यहोवा जो च़ाढ़ी। <verse eid="1SA 6:14" /><verse number="15" style="v" sid="1SA 6:15" />ते लेवी लोकेईं यहोवारो सन्दूख ते तै होरो सन्दूख ज़ै साथी थियो, ज़ैस मां सोन्नेरी चीज़ां थी, उसालो तै तैस बड्डे घोड़ पुड़ रख्खो; ते बेतशेमेश नगरेरे लोकेईं तैस्से दिहाड़े यहोवारे लेई होमबलि ते मेलबलि च़ाढ़ी। <verse eid="1SA 6:15" /><verse number="16" style="v" sid="1SA 6:16" />एन हेरतां पलिश्ती लोकां केरे पंच़े राज़ेईं तैस्से दिहाड़ी एक्रोन नगरे जो वापस जे।<verse eid="1SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 6:17" />सोन्नेरी गिलटी ज़ैना पलिश्ती लोकेईं यहोवारो नुकसान भरनेरे लेई दोषबलि केरतां दित्तोरी थी तैन मरां अक त अश्दोद नगरेरे तरफां, ते अक गाज़ा नगरेरे तरफां, ते अक अश्कलोन नगरेरे तरफां, ते अक गत नगरेरे तरफां, ते अक एक्रोन नगरेरे तरफां दित्ती जेवरी थी। <verse eid="1SA 6:17" /><verse number="18" style="v" sid="1SA 6:18" />ते तैना सोन्नेरे मूंशे, शहरपनाह बाले नगर, बगैर शहरपनाहेरां ड्लाव्वां, बल्के ज़ैस बड्डे घोड़े पुड़ यहोवारो सन्दूख रख्खो जेवरो थियो तैड़ी पलिश्ती लोकां केरे पंच़े राज़ां केरे अधिकारे तगर सारे ड्लाव्वां केरि गिनतरे मुताबिक दित्ते जे। तै घोड़ अज़ तगर बेतशेमेश नगरेरे यहोशूएरे उडारे मां आहे।<verse eid="1SA 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 6:19" />फिरी बेतशेमेश नगरेरे किछ लोकेईं यहोवारो सन्दूख नेड़े लिकतां तकोरो थियो एल्हेरेलेइ परमेशरे तैन मरां 70 मैन्हु मारे; ते तैट्ठेरे लोकेईं एल्हेरेलेइ मातम कियो कि यहोवा बड़े लोक मारोरेन।<verse eid="1SA 6:19" /></para>
  <para style="s">करारेरो सन्दूख किर्यत्यारीम नगरे मां</para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 6:20" />तैस वक्ते बेतशेमेश नगरेरे लोक एक्‍की होरि सेइं ज़ोने लगे, “इस पवित्र यहोवा परमेशरेरे सामने कौन खड़ो रेई सकते? ते अस तैसेरे सन्दूखे एप्पु करां कोरहां भेज़म?” <verse eid="1SA 6:20" /><verse number="21" style="v" sid="1SA 6:21" />तैखन तैनेईं किर्यत्यारीम<note caller="+" style="f"><char style="fr" closed="false">6:21 </char><char style="fq" closed="false">किर्यत्यारीम </char><char style="ft" closed="false">मतलब लेकड़रू नगर</char></note> नगरेरे रानेबालन कां एन ज़ोनेरे लेई दूत भेज़े, “पलिश्ती लोकेईं यहोवारो सन्दूख वापस पुज़व। एल्हेरेलेइ तुस एइतां तैस अपने नगरे जो नेथ।”<verse eid="1SA 6:21" /></para>
  <chapter eid="1SA 6" />
  <chapter number="7" style="c" sid="1SA 7" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 7:1" />तैखन किर्यत्यारीम नगरेरे लोक गेइतां यहोवारो सन्दूख छ़ुइतां च़ले जे, ते अबीनादाबेरे घरे मां ज़ैन तैन केरे नगरेरे पहैड़ी पुड़ थियूं तैड़ी रख्खो, ते यहोवारे सन्दूखेरी रखवाली केरनेरे लेई अबीनादाबेरू मट्ठू एलीआजर पवित्र कियूं।<verse eid="1SA 7:1" /></para>
  <para style="s">शमूएल नबी ते न्यायेरां कम्मां</para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 7:2" />किर्यत्यारीम नगरे मां सन्दूख रखोरे 20 साल भोए, ते तैस दौरान इस्राएलेरे सारे लोक दुखेरे मारे यहोवा करां मद्दत मगने लगे। <verse eid="1SA 7:2" /><verse number="3" style="v" sid="1SA 7:3" />तैखन शमूएले सारे इस्राएली लोकन सेइं ज़ोवं, “अगर तुस अपने पूरे मने सेइं यहोवारे पासे एवरेथ, त बाकी देबतन ते अश्तोरेत देबरे मूरतन एप्पु करां दूर केरा, ते यहोवारे पासे अपनो मन लेइतां सिर्फ तैसेरी आराधना केरा, तैखन तै तुसन पलिश्ती केरे हथ्थे मरां छुटालो।” <verse eid="1SA 7:3" /><verse number="4" style="v" sid="1SA 7:4" />तैखन इस्राएली लोकेईं बाल देबते ते अश्तोरेत देबरी मूरती दूर की, ते सिर्फ यहोवारी आराधना केरने लगे।<verse eid="1SA 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 7:5" />फिरी शमूएले तैन सेइं ज़ोवं, “सारे इस्राएली लोकन मिस्पा नगरे मां अकोट्ठे केरा, ते अवं तुश्शे लेई यहोवा कां प्राथना केरेलो।” <verse eid="1SA 7:5" /><verse number="6" style="v" sid="1SA 7:6" />तैखन तैना मिस्पा नगरे मां अकोट्ठे भोए, ते पानी भेरतां यहोवारे सामने डोलू, ते तैस दिहाड़े बरत रख्खू, ते ई गल मन्नी, “कि असेईं यहोवारे खलाफ पाप कियोरोए।” एन्च़रे सेइं शमूएले मिस्पा नगरे मां इस्राएली लोकां केरो न्याय कियो। <verse eid="1SA 7:6" /><verse number="7" style="v" sid="1SA 7:7" />ज़ैखन पलिश्ती लोकेईं शुनू कि इस्राएली लोक मिस्पा नगरे मां अकोट्ठे भेवरेन, तैखन तैन केरे राज़े इस्राएली लोकन सेइं जंग लड़नेरे लेई जे। एन शुन्तां इस्राएली लोक पलिश्ती लोकन करां डरे। <verse eid="1SA 7:7" /><verse number="8" style="v" sid="1SA 7:8" />ते इस्राएली लोकेईं शमूएले सेइं ज़ोवं, “इश्शे लेई इश्शे परमेशर यहोवा कां प्राथना केरनी न शार, ज़ैस सेइं तै असन पलिश्ती लोकां केरे हथ्थे करां बच़ाए।” <verse eid="1SA 7:8" /><verse number="9" style="v" sid="1SA 7:9" />तैखन शमूएले अक दुद्ध पीतू गबड़ू नेइतां पूरू होमबलि केरतां यहोवा जो च़ाढ़ू; ते शमूएले इस्राएली लोकां केरे लेई यहोवा कां प्राथना की, ते यहोवा तैसेरी प्राथनारो जुवाब दित्तो। <verse eid="1SA 7:9" /><verse number="10" style="v" sid="1SA 7:10" />ते ज़ैस वक्ते शमूएल होमबलि च़ेढ़ी राहोरो थियो तैस वक्ते पलिश्ती लोक इस्राएली लोकन सेइं लड़ाई केरनेरे लेई नेड़े आए, तैखन तैस्से दिहाड़े यहोवाए पलिश्ती लोकन पुड़ अम्बर गुड़ेइतां तैना डरेई छ़डे; ते तैना इस्राएली लोकन करां हारे। <verse eid="1SA 7:10" /><verse number="11" style="v" sid="1SA 7:11" />तैखन इस्राएली सिपैहेईं मिस्पा नगरे मरां निस्तां पलिश्ती लोक खदाड़े, ते तैन बेतकर वैदी करां बुन तगर मारते च़ले जे।<verse eid="1SA 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 7:12" />तैखन शमूएले अक घोड़ नेइतां मिस्पा ते शेन नगरां केरे मझ़ाटे खड़ो कियो, ते एन ज़ोइतां तैसेरू नवं एबेनेजेर<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="fq" closed="false">एबेनेजेर </char><char style="ft" closed="false">मतलब मद्दतरो घोड़।</char></note> रख्खू, “इड़ी तगर यहोवा इश्शी मद्दत कियोरीए।” <verse eid="1SA 7:12" /><verse number="13" style="v" sid="1SA 7:13" />एन्च़रे सेइं पलिश्ती लोक हारे, ते इस्राएली लोकां केरे मुल्खे मां फिरी न आए, ते शमूएलेरे ज़िन्दगी भर यहोवा पलिश्ती लोकां केरे खलाफ लड़तो राव। <verse eid="1SA 7:13" /><verse number="14" style="v" sid="1SA 7:14" />ते एक्रोन ते गत नगरन तगर ज़ेत्रे नगर पलिश्ती लोकेईं इस्राएली लोकां केरे हथ्थेरां थुसोड़ोरे थिये, तैना फिरी इस्राएली लोकां केरे कब्ज़े मां आहे; ते तैन केरो मुल्ख भी इस्राएली लोकेईं पलिश्ती लोकां केरे कब्ज़े मरां छुटाव। ते इस्राएली लोकन ते एमोरी लोकन मां भी मेल मिलाप भोइ जेव।<verse eid="1SA 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 7:15" />ते शमूएल सैरी ज़िन्दगी इस्राएली लोकां केरो न्याय केरतो राव। <verse eid="1SA 7:15" /><verse number="16" style="v" sid="1SA 7:16" />तै हर साल बेतेल ते गिलगाल ते मिस्पा नगरन मां गेइतां तैन सेभी ठारन मां इस्राएली लोकां केरो न्याय केरतो राव। <verse eid="1SA 7:16" /><verse number="17" style="v" sid="1SA 7:17" />तैखन तै रामाह नगरे मां वापस अव ज़ैड़ी तैसेरू घर थियूं, ते तैड़ी भी इस्राएली लोकां केरो न्याय केरतो राव, ते तैड़ी तैनी यहोवारे लेई अक वेदी बनाई।<verse eid="1SA 7:17" /></para>
  <chapter eid="1SA 7" />
  <chapter number="8" style="c" sid="1SA 8" />
  <para style="s">इस्राएली लोक राज़ो मगतन</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 8:1" />ज़ैखन शमूएल बुढो भोव, तैखन तैनी अपना मट्ठां इस्राएली लोकन पुड़ न्यायी ठहराए। <verse eid="1SA 8:1" /><verse number="2" style="v" sid="1SA 8:2" />तैसेरे बड्डे मट्ठेरू नवं योएल, ते होरि मट्ठेरू नवं अबिय्याह थियूं; एना बेर्शेबा नगरे मां न्याय केरते थिये। <verse eid="1SA 8:2" /><verse number="3" style="v" sid="1SA 8:3" />पन तैसेरां मट्ठां तैसेरी बत्ती पुड़ न च़लां, मतलब तैना लालच़े मां एइतां रिश्पत नेते ते न्याय बिगाड़ते थिये।<verse eid="1SA 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 8:4" />तैखन सारे इस्राएली बुज़ुर्ग लोक अकोट्ठे भोइतां रामाह नगरे मां शमूएले कां गेइतां, <verse eid="1SA 8:4" /><verse number="5" style="v" sid="1SA 8:5" />तैस सेइं ज़ोने लगे, “शुन, तू त हुनी बुढो भोइ जेवरोस, ते तेरां मट्ठां तेरी बत्ती पुड़ न च़लन; हुनी इश्शो न्याय केरनेरे लेई बाकी कौमां केरो ज़ेरो इश्शे लेई अक राज़ो ठहरा।”<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="ACT 13:21">प्रेरित. 13:21</ref>. </char></note> <verse eid="1SA 8:5" /><verse number="6" style="v" sid="1SA 8:6" />पन ज़ै गल तैनेईं ज़ोई, “असन पुड़ न्याय केरनेरे लेई अक राज़ो ठहरा,” ऐह गल शमूएले बुरी लग्गी। ते शमूएले यहोवा कां प्राथना की। <verse eid="1SA 8:6" /><verse number="7" style="v" sid="1SA 8:7" />ते यहोवा शमूएले सेइं ज़ोवं, “तैना लोक ज़ैन किछ तीं सेइं ज़ोन तैन मेन्नां; किजोकि तैनेईं तेरो नईं बल्के मेरो इन्कार कियोरोए, कि अवं तैन केरो राज़ो न रेईं। <verse eid="1SA 8:7" /><verse number="8" style="v" sid="1SA 8:8" />ज़ेरां-ज़ेरां कम्मां तैना तैस दिहाड़े करां, ज़ैखन मीं तैना मिस्र मुल्खे मरां केढतां आनोरे थिये, अज़्ज़ेरे दिहाड़े तगर केरते एवरेन, कि मीं शैरतां बाकी देबतां केरि पूज़ा केरते राए, ते तेरहु तैना तीं सेइं भी केरतन। <verse eid="1SA 8:8" /><verse number="9" style="v" sid="1SA 8:9" />एल्हेरेलेइ हुनी तू तैन केरि गल मन्न; फिरी तू तैन रोड़ेच़ारे खबरदार केर, ते तैन एन ज़ो कि ज़ै राज़ो तैन पुड़ हुकूमत केरेलो तैसेरो बर्ताव केरहो भोल्हो।”<verse eid="1SA 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 8:10" />शमूएले तैन लोकन ज़ैना तैस करां राज़ो चाते थिये यहोवारी सैरी गल्‍लां शुनेई। <verse eid="1SA 8:10" /><verse number="11" style="v" sid="1SA 8:11" />तैनी ज़ोवं, “ज़ै राज़ो तुसन पुड़ हुकूमत केरेलो तैसेरो ई तरीको भोल्हो, कि तै तुश्शे मट्ठन ज़बरदस्ती नेइतां अपने रथां च़लानेबाले ते घोड़े च़लानेबाले रखेलो, ते तैना तैसेरे रथ्थन अग्री-अग्री दौड़ेलां; <verse eid="1SA 8:11" /><verse number="12" style="v" sid="1SA 8:12" />फिरी तै तैन्न हज़ार-हज़ार ते पज़ा-पज़ान पुड़ प्रधान बनालो, ते किछन करां तै अपना ऊडारां लुवालो, ते अपने ऊडारां केरी फसल कटालो, ते अपने लेई लड़ैइयरे हथियार ते रथ्थां केरू सामान बनावालो। <verse eid="1SA 8:12" /><verse number="13" style="v" sid="1SA 8:13" />फिरी तै तुश्शी कुइयन नेइतां तैन करां इत्र लुवालो ते रसोई मां रोट्टी बनावालो। <verse eid="1SA 8:13" /><verse number="14" style="v" sid="1SA 8:14" />फिरी तै तुश्शे ऊडारन ते दाछ़री बाग ते ज़ैतूनेरी बागन मरां ज़ै रोड़े करां रोड़ी भोल्ही तै नेइतां अपने अधिकैरन देलो। <verse eid="1SA 8:14" /><verse number="15" style="v" sid="1SA 8:15" />फिरी तै तुश्शू बीज़ ते दाछ़री बागां केरो दशोवं हिस्सो नेइतां अपने हाकिमन ते सेवकन देलो। <verse eid="1SA 8:15" /><verse number="16" style="v" sid="1SA 8:16" />फिरी तै तुश्शे नौकर नौकरानी नेलो, ते तुश्शे रोड़े करां रोड़े जुवान, ते तुश्शे गधे भी नेइतां अपने कम्मे मां लाएलो। <verse eid="1SA 8:16" /><verse number="17" style="v" sid="1SA 8:17" />तै तुश्शी भैड्डां-छ़ेल्‍ली केरो भी दशोवं हिस्सो नेलो; एन्च़रां सेइं तुस लोक तैसेरे गुलाम बेनि गाले। <verse eid="1SA 8:17" /><verse number="18" style="v" sid="1SA 8:18" />ते तैस दिहाड़े तुस अपने तैस च़ुनोरे राज़ेरी वजाई सेइं प्राथनाई मां बिनती केरेले, पन यहोवा तैस मौके तुसन जुवाब न देलो।”<verse eid="1SA 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 8:19" />पन फिरी भी तैन लोकेईं शमूएलेरी गल न शुनी; ते ज़ोने लगे, “नईं! अस सच़्च़े अपने लेई राज़ो चातम, <verse eid="1SA 8:19" /><verse number="20" style="v" sid="1SA 8:20" />ज़ैस सेइं असां बाकी कौमां केरे ज़ेरे भोइ गाम, ते इश्शो राज़ो इश्शो न्याय केरे, ते असन अग्री-अग्री च़ेलतां इश्शी तरफां लड़ाई लड़े।” <verse eid="1SA 8:20" /><verse number="21" style="v" sid="1SA 8:21" />लोकां केरि इना सब गल्‍लां शुन्तां शमूएले यहोवारे कन्ने तगर पुज़ेई। <verse eid="1SA 8:21" /><verse number="22" style="v" sid="1SA 8:22" />यहोवा शमूएले सेइं ज़ोवं, “तैन केरि गल मेनतां तैन केरे लेई राज़ो ठहरा।” तैखन शमूएले इस्राएली मैन्हन सेइं ज़ोवं, “तुस हुनी अपने-अपने नगरे जो च़ले गाथ।”<verse eid="1SA 8:22" /></para>
  <chapter eid="1SA 8" />
  <chapter number="9" style="c" sid="1SA 9" />
  <para style="s">शाऊल इस्राएलेरो पेइलो राज़ो</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 9:1" />बिन्यामीनेरे गोट्ले मां कीश नंव्वेरो अक मैन्हु थियो, तैसेरे बाजेरू नवं अबीएल थियूं, तैसेरे दादेरू नवं सरोर ते तैसेरे पड़दादेरू नवं बकोरत थियूं; तै बड़ो ताकतबर सूरमा थियो। <verse eid="1SA 9:1" /><verse number="2" style="v" sid="1SA 9:2" />तैसेरू अक जुवान मट्ठू थियूं ज़ेसेरू नवं शाऊल थियूं, तैन बड़ू खूबसूरत थियूं, ते इस्राएले मां कोई तैस बराबर खूबसूरत न थियो; तैन एत्रू लम्मू थियूं कि बाकी इस्राएली लोक तैसेरे कंधे तगर पुज़ते थिये।<verse eid="1SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 9:3" />एक्सां कीशेरे गधे हेरोए, तैखन कीशे अपने मट्ठे शाऊले सेइं ज़ोवं, “अक नौकर एप्पु सेइं साथी ने ते गधे तोपतां आन।” <verse eid="1SA 9:3" /><verse number="4" style="v" sid="1SA 9:4" />तैखन तै एप्रैमेरे पहाड़ी प्रदेश ते शलीशा प्रदेशे मांमेइं भोइतां जेव, पन तैन्न गधे न मैल्हे। फिरी तैना शालीम नंव्वेरे प्रदेशे मांमेइं भी भोइतां जे, ते तैड़ी भी गधे न मैल्हे। फिरी बिन्यामीन प्रदेशे मां जे, पन गधे तैड़ी भी न मैल्हे।<verse eid="1SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 9:5" />ज़ैखन तैना सूफ नंव्वेरे प्रदेशे मां आए, तैखन शाऊले अपने नौकरे सेइं ज़ोवं, ज़ै तैस सेइं साथी थियो, “एई, अस वापस च़लम, एरू न भोए कि मेरो बाजी गधां केरि फिक्र छ़ेडतां इश्शी फिक्र केरने लगे।” <verse eid="1SA 9:5" /><verse number="6" style="v" sid="1SA 9:6" />पन नौकरे तैस सेइं ज़ोवं, “शुन, एस नगरे मां परमेशरेरो अक मैन्हु आहे, ज़ेसेरी लोक बड़ी इज़्ज़त केरतन; किजोकि ज़ैन किछ तै ज़ोते तैन ज़रूर पूरू भोते। एल्हेरेलेइ हुनी अस तैस कां च़लम, भोइ सकते कि तै असन ज़ोए कि अस गधे कोड़ि तोपम।” <verse eid="1SA 9:6" /><verse number="7" style="v" sid="1SA 9:7" />पन शाऊले अपने नौकरे सेइं ज़ोवं, “शुन, अगर अस तैस मैन्हु कां गाम त तैस जो कुन नेम? हेर, इश्शे थेलन मां रोट्टी भी मुक्‍की जेवरिन ते भेंट देनेरे काबल कोई चीज़ अथ्थी नईं, ज़ै अस परमेशरेरे तैस मैन्हु देम। अस तैस कुन देइ सकतम?” <verse eid="1SA 9:7" /><verse number="8" style="v" sid="1SA 9:8" />फिरी सेवके शाऊले सेइं ज़ोवं, “मीं कां त चैंदरो अक चौथाई सिक्‍कोए,<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="fq" closed="false">सिक्‍कोए </char><char style="ft" closed="false">लगभग 2.8 किल्‍लो</char></note> तैए अवं तैस परमेशरेरे मैन्हु देइलो, कि तै असन सेइं ज़ोए कि असां गधे कोड़ि तोपतम।” <verse eid="1SA 9:8" /><verse number="9" style="v" sid="1SA 9:9" />(पुराने ज़माने मां इस्राएले मां ज़ैखन कोई परमेशरे करां किछ पुछ़ने गातो थियो तैखन एरू केरतो थियो, “च़ला, अस देर्शी कां गाम।” किजोकि ज़ैस जो अज़ काल नबी ज़ोतन तैस जो पुराने ज़माने मां दर्शी ज़ोते थिये।) <verse eid="1SA 9:9" /><verse number="10" style="v" sid="1SA 9:10" />तैखन शाऊले अपने नौकरे सेइं ज़ोवं, “तीं ठीक ज़ोवरूए; अस च़लम।” फिरी तैना तैस नगरे जो च़ले ज़ैड़ी परमेशरेरो मैन्हु थियो।<verse eid="1SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 9:11" />तैस नगरेरी चड़ैई पुड़ च़ढ़ते बार तैस बेड़ि कुइयां मैल्ही ज़ैना पानी भरने जो च़ेलोरी थी; तैनेईं तैन पुछ़ू, “कुन दर्शी इड़ी आहे?” <verse eid="1SA 9:11" /><verse number="12" style="v" sid="1SA 9:12" />तैनेईं जुवाब दित्तो, “हाँ; हेरा, तै तुश्शे सामने। हुनी तुस लूश केरा; अज़ पहाड़ेरे वेदी पुड़ लोक बलि च़ाढ़ेले, एल्हेरेलेइ तै अज़ नगरे मां एवरोए। <verse eid="1SA 9:12" /><verse number="13" style="v" sid="1SA 9:13" />ज़ेरे तुस नगरे मां पुज़ेले तेरहो तै तुसन उच्‍ची ठारी पुड़ रोट्टी खाने करां पेइले मैल्हेलो। किजोकि ज़ांतगर तै न पुज़्ज़े तांतगर लोक रोट्टी न खाएले, किजोकि बेलरे लेई तैए परमेशरेरू शुक्र केरते; फिरी तैसेरां बाद कुजेवरे लोक रोट्टी खातन। एल्हेरेलेइ तुस हुन्ना तैड़ी गाथ, इस्से वक्ते तै तुसन मैल्हेलो।” <verse eid="1SA 9:13" /><verse number="14" style="v" sid="1SA 9:14" />त शाऊल ते तैसेरे सेवक नगरे मां च़ेढ़ी जे ते ज़ेरे नगरे मां पुज़्ज़े तेरहो शमूएल उच्‍ची ठारी पुड़ च़ढ़नेरे लेई तैन केरे सामने एज्जी राहोरो थियो।<verse eid="1SA 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 9:15" />शाऊलेरे एजने करां अक दिहाड़ी पेइले यहोवाए शमूएले सेइं इन ज़ोवरू थियूं, <verse eid="1SA 9:15" /><verse number="16" style="v" sid="1SA 9:16" />“कालां इस्से वक्ते अवं तीं कां बिन्यामीन प्रदेशेरो अक मैन्हु भेज़ेलो, तैस्से तू मेरे इस्राएली लोकां केरो प्रधान भोने लेई अभिषेक केरां। ते तैए मेरे लोकन पलिश्ती लोकां केरे हथ्थेरां छुटालो; किजोकि मीं अपने लोकन पुड़ दयारी नज़र कियोरीए, एल्हेरेलेइ कि तैन केरि मद्दतरे लेई बिनती मीं तगर पुज़ोरीए।” <verse eid="1SA 9:16" /><verse number="17" style="v" sid="1SA 9:17" />फिरी ज़ैखन शमूएले शाऊल लाव, तैखन यहोवा तैस सेइं ज़ोवं, “ज़ैस मैन्हेरे बारे मां मीं तीं सेइं ज़ोवरू थियूं तै ईए; मेरे लोकन पुड़ ईए हुकूमत केरेलो।” <verse eid="1SA 9:17" /><verse number="18" style="v" sid="1SA 9:18" />तैखन शाऊल नगरेरे फाटके पुड़ शमूएले कां नेड़े गेइतां पुछ़ू, “मीं सेइं ज़ो कि दर्शी एरू घर कोड़िए?” <verse eid="1SA 9:18" /><verse number="19" style="v" sid="1SA 9:19" />शमूएले जुवाब दित्तो, “दर्शी त अवं आई; मीं करां अग्री-अग्री उच्‍ची ठारी पुड़ जो च़ेलि गा, किजोकि अज़्ज़ेरे दिहाड़े तू मीं सेइं साथी रोट्टी खालो, ते ज़ैन किछ तेरे दिले मां भोल्हु सब किछ अवं तीं सेइं ज़ोइतां झ़ेझ़ां भेज़ेलो। <verse eid="1SA 9:19" /><verse number="20" style="v" sid="1SA 9:20" />ते तेरी गधन ज़ैन हेरोरे ट्लाई दिहाड़े भेवरेन तैन केरि किछ भी फिक्र न केरां, किजोकि तैना मैल्ही जेवरिन। ते इस्राएले मां ज़ैन किछ मन पसंदे तैन केसेरूए? ते अवं इन ज़ोनेरे लेई इड़ी एवरोईं कि तीं ते तेरे टब्बरे पुड़ इस्राएलेरी उमीदे?” <verse eid="1SA 9:20" /><verse number="21" style="v" sid="1SA 9:21" />शाऊले जुवाब देइतां ज़ोवं, “कुन अवं सारे इस्राएली गोट्लन मां सेभन करां निकड़े बिन्यामीनी गोट्ले मरां नईं? ते कुन मेरू कुल बिन्यामीनेरे मतलब इस्राएलेरे गोट्लां केरे सारे कुले मां निकड़ू नईं? एल्हेरेलेइ तू मीं सेइं एरी गल्‍लां किजो ज़ोतस?”<verse eid="1SA 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 9:22" />तैखन शमूएले शाऊल ते तैसेरो नौकर कमरे मां ने ते कुजेवरे लोकन, ज़ैना सारे लगभग 30 मैन्हु थिये, तैना तैस खास जगाई पुड़ बिशाले। <verse eid="1SA 9:22" /><verse number="23" style="v" sid="1SA 9:23" />फिरी शमूएले रोट्टी बनानेबाले सेइं ज़ोवं, “ज़ै मासेरो टुक्ड़ो मीं तीं रखनेरे लेई दित्तोरो थियो, तैस इरां आन।” <verse eid="1SA 9:23" /><verse number="24" style="v" sid="1SA 9:24" />तैखन रोट्टी बनानेबाले तैन मास शाऊलेरे सामने रख्खू; तैखन शमूएले ज़ोवं, “ज़ैन रखोरू थियूं तैस हेर, ते अपने सामने रेखतां खा; किजोकि तैन तेरे लेई असेईं सही वक्ते तगर, ज़ेसेरे बारे मां मीं इन लोकन धाम ज़ोइतां रखोरूए।”</para>
  <para style="p" vid="1SA 9:24">शाऊले तैस दिहाड़े शमूएले सेइं साथी रोट्टी खाई। <verse eid="1SA 9:24" /><verse number="25" style="v" sid="1SA 9:25" />तैखन तैना उच्‍ची ठारी पुड़ेरां ओस्तां नगरे मां वापस आए, ते शमूएले तै अपने घरे नेव, ते तैनी अपने घरेरी छती पुड़ शाऊले सेइं गल्‍लां की।<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="fq" closed="false">शाऊले सेइं गल्‍लां की </char><char style="ft" closed="false">ते तैड़ी तैसेरे लेई बिछ़ान दित्तू।</char></note><verse eid="1SA 9:25" /></para>
  <para style="s">राज़ेरे रूपे मां शाऊल च़ुनो गानो</para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 9:26" />एग्री दिहाड़े झ़ेझ़ां तैना सुबेले खड़े उठे, ते लौ भोंते शमूएले शाऊले जो ज़ोवं, “उठ, अवं तीं भेज़ेलो।” तैखन शाऊल खड़ो उठो, ते तै ते शमूएल दूईये बेइर च़ले जे। <verse eid="1SA 9:26" /><verse number="27" style="v" sid="1SA 9:27" />ते नगरेरे उतरैई मां च़लते-च़लते शमूएले शाऊले सेइं ज़ोवं, “अपने नौकरे असन करां अग्रोवं गानेरो हुक्म दे, (तै अग्रोवं च़लो जेव) पन तू हेजू खड़ो रह कि अवं तीं परमेशरेरो सन्देश शुनेईं।”<verse eid="1SA 9:27" /></para>
  <chapter eid="1SA 9" />
  <chapter number="10" style="c" sid="1SA 10" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 10:1" />तैखन शमूएले अक कुप्पी तेल नेइतां शाऊलेरे दोग्गे पुड़ उलटाव, ते तैस फुम्मड़ी देइतां ज़ोवं, “कुन एसेरी वजा ई नईं कि यहोवा अपने लोकन पुड़ प्रधान भोनेरे लेई तेरू अभिषेक कियोरूए? <verse eid="1SA 10:1" /><verse number="2" style="v" sid="1SA 10:2" />अज़ ज़ैखन तू मीं करां च़लो गालो, तैखन राहेलरे कब्री कां ज़ै बिन्यामीन प्रदेशेरे सरहद्दी पुड़ सेलसह नगरे मांए, दूई मैन्हु तीं मैल्हेले, ते ज़ोले, ‘ज़ैना गधे तू तोप्पने जेवरो थियो तैना मैल्होरिन; ते शुन, तेरो बाजी गधां केरि फिक्र छ़ेडतां तुश्शे वजाई सेइं डेरतां ज़ोते, कि अवं अपने हेरोरे मट्ठेरे लेई कुन केरीं?’ <verse eid="1SA 10:2" /><verse number="3" style="v" sid="1SA 10:3" />फिरी तैट्ठां अग्रोवं गेइतां ज़ैखन तू ताबोर नंव्वेरे ठारारे बंज़ेरे बुट्टे कां पुज़ेलो, तैखन तैड़ी ट्लाई मैन्हु परमेशरे जो बलिदान देनेरे लेई बेतेल नगरे जो गांते मैल्हेले, ज़ैन मां एक्‍की कां त छ़ेल्‍ली केरे ट्लाई बच्‍चे, ते होरि कां ट्लाई रोट्टी, ते ट्लेइयोवं कां एक्‍की मसकी मां दाछ़रो रस च़लेवरो भोल्हो। <verse eid="1SA 10:3" /><verse number="4" style="v" sid="1SA 10:4" />तैना तेरो हाल चाल पुछ़ेले, ते तीं दूई रोट्टी देले, ते तू तैन्न करां नेइयां। <verse eid="1SA 10:4" /><verse number="5" style="v" sid="1SA 10:5" />तैखन तू परमेशरेरे पहाड़े पुड़ पुज़ेलो ज़ैड़ी पलिश्ती केरि चौकीए; ते ज़ैखन तू तैड़ी नगरे मां दाखल भोस, तैखन नेबी केरि अक टोली पहाड़ेरी वेदी करां तीं ओस्ते मैल्हेली; ते तैन अग्री लोक सितार, डफली, बेंशोई, ते सैन्गी बज़ाते भोल्हे; ते तैना नबी नबूवत केरते भोनेन। <verse eid="1SA 10:5" /><verse number="6" style="v" sid="1SA 10:6" />तैखन यहोवारो आत्मा तीं पुड़ अकदम एज्जेलो, ते तू भी तैन सेइं साथी नबूवत केरेलो, ते तू बेदलोइतां अलग मैन्हु भोइ गालो। <verse eid="1SA 10:6" /><verse number="7" style="v" sid="1SA 10:7" />ते ज़ैखन इना निशान भोन, तैखन ज़ैन कम तीं सही लग्गे तैन केरां; किजोकि परमेशर तीं सेइं साथी रालो। <verse eid="1SA 10:7" /><verse number="8" style="v" sid="1SA 10:8" />ते तू मीं करां पेइले गिलगाल नगरे मां गेइतां सत दिहाड़न तगर मेरो इंतज़ार केरां, अवं होमबलि ते मेलबलि च़ाढ़नेरे लेई तीं कां एज्जेलो, तैखन अवं तीं सेइं ज़ोइलो कि कुन-कुन केरनूए।”<verse eid="1SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 10:9" />ते ज़ेरि तैनी शमूएले करां गांनेरे लेई पिठ फेरी तेन्च़रे परमेशरे तैसेरो दिल बदलो; ते तैना सारे निशान तैस्से दिहाड़े पूरे भोए। <verse eid="1SA 10:9" /><verse number="10" style="v" sid="1SA 10:10" />ज़ैखन शाऊल ते तैसेरो सेवक तैस पहाड़े कां नेड़े पुज़्ज़े, तैखन नेबी केरि अक टोली तैस मैल्ही; ते परमेशरेरो आत्मा शाऊले पुड़ अकदम अव, ते तैन केरे मझ़ाटे तै नबूवत केरने लगो। <verse eid="1SA 10:10" /><verse number="11" style="v" sid="1SA 10:11" />ज़ैखन तैन सेभेइं ज़ैना तैस पेइले ज़ानते थिये इन लाऊं कि तै नेबन मां नबूवत केरने लगोरोए, तैखन एप्पु मांमेइं ज़ोने लगे, “कीशेरे मट्ठे इन कुन भोवं? कुन शाऊल भी नेबन मरां अक आहे?” <verse eid="1SA 10:11" /><verse number="12" style="v" sid="1SA 10:12" />तैट्ठेरे एक्‍की मैन्हें ज़ोवं, “पन तैन केरो बाजी कौने?” एस गल्‍ली पुड़ ई कहावत च़लने लगी, “कुन शाऊल भी नेबन मां अक नबीए?” <verse eid="1SA 10:12" /><verse number="13" style="v" sid="1SA 10:13" />ज़ैखन शाऊले नबूवत की, तैखन पहाड़ेरे वेदी पुड़ च़लो जेव।<verse eid="1SA 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 10:14" />किछ वक्तेरां बाद शाऊलेरे चाचे तैस ते तैसेरे नौकरे पुछ़ू, “तुस कोरहां जेवरे थिये?” तैनी ज़ोवं, “अस त गधे तोप्पने जेवरे थिये; ते ज़ैखन असन कोन्च न मैल्ही, तैखन शमूएल नेबी कां पुछ़ने जे।” <verse eid="1SA 10:14" /><verse number="15" style="v" sid="1SA 10:15" />शाऊलेरे चाचे पुछ़ू, “मीं सेइं ज़ो कि शमूएले तुसन सेइं कुन ज़ोवं?” <verse eid="1SA 10:15" /><verse number="16" style="v" sid="1SA 10:16" />शाऊले अपने चाचे सेइं जुवाब दित्तो, “तैनी असन सेइं रोड़ेच़ारे ज़ोवं कि गेधी मैल्ही जेवरिन।” पन ज़ै गल शमूएले इस्राएलेरे राज़ो बन्नेरे बारे मां ज़ोवरी थी तै तैनी तैस सेइं न ज़ोई।<verse eid="1SA 10:16" /></para>
  <para style="s">शाऊलेरू राज़ो बन्नू</para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 10:17" />किछ वक्तेरां बाद शमूएले इस्राएली लोक मिस्पा नगरे मां यहोवारे सामने कुजाए। <verse eid="1SA 10:17" /><verse number="18" style="v" sid="1SA 10:18" />तैखन तैनी तैन सेइं ज़ोवं, “इस्राएलेरो परमेशर यहोवा इन ज़ोते, ‘मीं त इस्राएली लोक मिस्र मुल्खे मरां केढतां आने, ते तुस मिस्री लोकां केरे हथ्थे मरां, ते तैन सब राज़ां केरे हथ्थे मरां छुटाए, ज़ैना तुसन पुड़ ज़ुलम केरते थिये।’ <verse eid="1SA 10:18" /><verse number="19" style="v" sid="1SA 10:19" />पन तुसेईं अज़ अपनो परमेशर घटिया समझ़ो, ज़ै सैरी मुसीबत ते दुखे करां तुसन छुटानेबालोए। ते तैस सेइं ज़ोवरूए, ‘इश्शे लेई राज़ो च़ुन।’ एल्हेरेलेइ हुनी तुस गोट्ले-गोट्लेरे मुताबिक ते हज़ार-हज़ार भोइतां यहोवारे सामने खड़े भोथ।”<verse eid="1SA 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 10:20" />तैखन शमूएले सारे इस्राएली गोट्लां नेड़े आनां, ते चिट्ठी बिन्यामीनेरे नंव्वे पुड़ निस्सी। <verse eid="1SA 10:20" /><verse number="21" style="v" sid="1SA 10:21" />तैखन तैनी बिन्यामीनेरे गोट्लेरे कुलां केरे हिसाबे सेइं नेड़े आने, ते चिट्ठी मत्री कुलेरे नंव्वे पुड़ निस्सी; फिरी चिट्ठी कीशेरे मट्ठे शाऊलेरे नंव्वे पुड़ निस्सी। ते ज़ैखन तैनेईं तै तोप्पो, तैखन तै न मैल्हो। <verse eid="1SA 10:21" /><verse number="22" style="v" sid="1SA 10:22" />तैखन तैनेईं फिरी यहोवा पुछ़ू, “कुन इड़ी कोई होरो एजनेबालोए?” यहोवा ज़ोवं, “शुना, तै सामाने मां छ़पोरोए।” <verse eid="1SA 10:22" /><verse number="23" style="v" sid="1SA 10:23" />तैखन तैनेईं देवड़तां तै तैट्ठां आनो; ते तै लोकां केरे मझ़ाटे खड़ो भोव, ते तै लोकन करां लम्मो थियो ते बाकी लोक तैसेरे कंधे तगर पुज़ते थिये। <verse eid="1SA 10:23" /><verse number="24" style="v" sid="1SA 10:24" />शमूएले सारे लोकन सेइं ज़ोवं, “कुन तुसेईं यहोवारो च़ुनोरो लाहोरोए कि सारे लोकन मां तैसेरो ज़ेरो कोई नईं?” तैखन सारे लोक ज़ोरे सेइं ज़ोने लगे, “राज़ेरी उमर लम्मी भोए।”<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="ACT 13:21">प्रेरित. 13:21</ref>.</char></note><verse eid="1SA 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 10:25" />तैखन शमूएले लोकन सेइं राज़ेरे अधिकारेरे बारे मां ज़ोवं, ते तैन किताबी मां लिखतां यहोवारे सामने रख्खू। ते शमूएले सारे लोक अपने-अपने घरे भेज़े। <verse eid="1SA 10:25" /><verse number="26" style="v" sid="1SA 10:26" />ते शाऊल गिबा नगरे मां अपने घरे जो च़लो जेव, ते तैस सेइं साथी अक दल भी जेव ज़ैन केरे मन परमेशरे उभारोरे थिये। <verse eid="1SA 10:26" /><verse number="27" style="v" sid="1SA 10:27" />पन कही लुच्‍चे लोक ज़ोने लगे, “ई मैन्हु असन केन्च़रे बच़ालो?” ते तैनेईं तै घटिया समझ़ो, ते तैस कां तोफे न आने। फिरी तै शुन्तां भी अनशुनी केरतां च़ुप राव।<verse eid="1SA 10:27" /></para>
  <chapter eid="1SA 10" />
  <chapter number="11" style="c" sid="1SA 11" />
  <para style="s">अम्मोनी लोकन पुड़ शाऊलेरी ज़ींत</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 11:1" />लगभग एक्‍की महीनेरां बाद अम्मोनी नाहाश राज़े चढ़ाई केरतां गिलाद प्रदेशेरे याबेश नगरेरे खलाफ डेरे लाए; ते याबेशेरे सैरी लोकेईं नाहाशे सेइं ज़ोवं, “असन सेइं लड़ाई न केरनेरो करार केर, ते अस तेरे अधीन रहमेले।” <verse eid="1SA 11:1" /><verse number="2" style="v" sid="1SA 11:2" />अम्मोनी लोकां केरे नाहाश राज़े तैन सेइं ज़ोवं, “अवं तुसन सेइं करार इस शर्ती पुड़ केरेलो, कि अवं तुश्शी सेभी केरि देइनी अछ़ केढी कि इस सेइं सारे इस्राएलेरी बदनामी भोए।” <verse eid="1SA 11:2" /><verse number="3" style="v" sid="1SA 11:3" />याबेश नगरेरे बुज़ुर्ग लोकेईं तैस सेइं ज़ोवं, “असन सत दिहाड़ां केरो मौको दे तांतगर अस सारे इस्राएल मुल्खे मां दूत भेज़मेले। ते अगर असन कोई बच़ानेबालो न मैल्हो, त अस तीं कां एजमेले।” <verse eid="1SA 11:3" /><verse number="4" style="v" sid="1SA 11:4" />दूतेइं शाऊलेरे गिबा नगरे मां एइतां लोकन ई सन्देश शुनाव, ते सारे लोक चिन्डां मैरी-मैरी लेरां देने लगे।<verse eid="1SA 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 11:5" />शाऊल दांतन पत्ती-पत्ती उडारे मरां च़ेलि एवरो थियो; ते शाऊले पुछ़ू, “लोकन कुन भोवं कि तैना लेरां देने लगोरेन?” तैनेईं याबेशेरे लोकां केरो सन्देश तैस शुनाव। <verse eid="1SA 11:5" /><verse number="6" style="v" sid="1SA 11:6" />ई सन्देश शुन्ते शाऊले पुड़ परमेशरेरो आत्मा अकदम अव, ते तैस बड़ी सरक अई। <verse eid="1SA 11:6" /><verse number="7" style="v" sid="1SA 11:7" />ते तैनी अपने दूई दांत नेइतां तैन केरे टुक्ड़े-टुक्ड़े कट्टे, ते एन ज़ोइतां दूतां केरे ज़िरिये सारे इस्राएल मुल्खे मां समाद भेज़ो, “ज़ै कोई एइतां शाऊल ते शमूएले पत्ती न एज्जेलो तैसेरे दांतन सेइं एरू कियूं गालू।” तैखन यहोवारो डर लोकन मां एरहो पेव कि तैना अक मन भोइतां च़ले आए। <verse eid="1SA 11:7" /><verse number="8" style="v" sid="1SA 11:8" />ज़ैखन तैनी तैना बेजेक नगरे मां गने, ते इस्राएली मैन्हु 300000, ते यहूदी मैन्हु 30000 भोए। <verse eid="1SA 11:8" /><verse number="9" style="v" sid="1SA 11:9" />ते तैनेईं तैन दूतन सेइं ज़ैना एवरे थिये ज़ोवं, “तुस गिलादे मां याबेशेरे लोकन सेइं इन ज़ोथ, कालां दुपहर भोनेरे मौके तगर तुसन छुटकारो मैल्हेलो।” तैखन दूतेइं गेइतां याबेशेरे लोकन बिस्तार दित्तो, ते तैना खुशी भोए। <verse eid="1SA 11:9" /><verse number="10" style="v" sid="1SA 11:10" />तैखन याबेशेरे लोकेईं नाहाश राज़े सेइं ज़ोवं, “कालां अस तुसन कां एजमेले, ते ज़ैन किछ तुसन रोड़ू लग्गे तैन्ने असन सेइं केरथ।” <verse eid="1SA 11:10" /><verse number="11" style="v" sid="1SA 11:11" />दूइयोवं दिहाड़े शाऊले सेना केरे ट्लाई जथे बनाए; ते तैनेईं राती आखरी पहरे डेरन मां गेइतां अम्मोनी सिपाही मारे; ते दुपहरन तगर एरे मारते राए कि ज़ैना बेंच़ी जे तैना इड़ी तगर तितर-बितर भोए कि दूई मैन्हु भी एक्‍की साथी कोन्च न राए।<verse eid="1SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 11:12" />लड़ाई खतम भोनेरां बाद इस्राएली लोक शमूएले सेइं ज़ोने लगे, “ज़ैन मैन्हेइं ज़ोवरू थियूं, ‘कुन शाऊल असन पुड़ राज़ केरेलो?’ तैन्न आनां कि असां तैन मैरी छ़डम।” <verse eid="1SA 11:12" /><verse number="13" style="v" sid="1SA 11:13" />पन शाऊले ज़ोवं, “अज़्ज़ेरे दिहाड़े कोई मारो न गालो; किजोकि अज़ यहोवाए इस्राएली लोकन दुश्मन्न करां छुटकारो दित्तोरोए।”<verse eid="1SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 11:14" />तैखन शमूएले इस्राएली लोकन सेइं ज़ोवं, “एज्जा, अस गिलगाल नगरे जो च़लम, ते तैड़ी राज़ फिरी मज़बूत केरम।” <verse eid="1SA 11:14" /><verse number="15" style="v" sid="1SA 11:15" />एल्हेरेलेइ सारे लोक गिलगाल नगरे जो च़ले, ते तैड़ी तैनेईं गिलगाल नगरे मां यहोवारे सामने शाऊल राज़ो बनाव; ते तैड़ी तैनेईं यहोवा जो मेलबलि च़ाढ़ी; ते तैट्ठी शाऊल ते सारे इस्राएली लोकेईं बड़ी खुशी सेइं जशन मनाव।<verse eid="1SA 11:15" /></para>
  <chapter eid="1SA 11" />
  <chapter number="12" style="c" sid="1SA 12" />
  <para style="s">शमूएलेरो उपदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 12:1" />फिरी शमूएले सारे इस्राएली लोकन सेइं ज़ोवं, “शुना, ज़ैन किछ तुसेईं मीं सेइं ज़ोवरू थियूं तैन मेनतां मीं अक राज़ो तुसन पुड़ ठहराव। <verse eid="1SA 12:1" /><verse number="2" style="v" sid="1SA 12:2" />ते हुनी हेरा, तै राज़ो तुसन अग्री-अग्री च़लते; ते हुनी अवं भी बुढो भोवरोईं, ते मेरो दोग छ़ित्तो भोइ जेवरोए, ते मेरां मट्ठां तुसन सेइं साथी आन; ते अवं छोट्टी उमरी करां देंतो अज़ तगर तुश्शे सामने कम केरतो राहोरोइं। <verse eid="1SA 12:2" /><verse number="3" style="v" sid="1SA 12:3" />अवं हज़ार आईं; एल्हेरेलेइ तुस यहोवारे सामने, ते तैसेरे अभिषेक कियोरे राज़ेरे सामने मीं पुड़ गवाही देथ, कि मीं केन्चेरो दांत नियोरोए? या केन्चेरो गधो नियोरोए? या कोन्ची पुड़ अंधेर कियोरीए? या कोई धोखो देइतां नुकसान पुज़वरोए? या केन्चेरे हथ्थे सेइं अपने लेई रिश्पत नेवरीए? ज़ोथ, तैन अवं तुसन वापस देइलो?” <verse eid="1SA 12:3" /><verse number="4" style="v" sid="1SA 12:4" />इस्राएली लोकेईं जुवाब दित्तो, “नईं! न त असन पुड़ कोई ज़ुलम कियोरोए, ते न तीं केन्चेरे हथ्थे किछ नियोरूए।” <verse eid="1SA 12:4" /><verse number="5" style="v" sid="1SA 12:5" />शमूएले इस्राएली लोकन सेइं ज़ोवं, “ज़ैन तैनी ज़ोवं अज़्ज़ेरे दिहाड़े यहोवा तैसेरो गवाहे, ते तैसेरो अभिषिक्त राज़ो भी एस गल्‍लरो गवाहे, कि मीं मां कोई दोष नईं निस्सोरो।” तैना ज़ोने लगे, “हाँ, तै गवाहे।”<verse eid="1SA 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 12:6" />फिरी शमूएल लोकन सेइं ज़ोने लगो, “यहोवा गवाहे। ज़ैनी मूसा ते हारून च़ुनतां तुश्शे बुज़ुर्ग मिस्र मुल्खे मरां केढतां आने तैए यहोवा आए। <verse eid="1SA 12:6" /><verse number="7" style="v" sid="1SA 12:7" />एल्हेरेलेइ हुनी तुस खड़े भोइतां शुना, ते अवं यहोवारे सामने तैसेरे सारे धार्मिकतारां कम्मां केरे बारे मां, ज़ैना तैनी तुसन सेइं साथी ते तुश्शे बुज़ुर्गन सेइं कियोरन, तुसन याद करेइलो। <verse eid="1SA 12:7" /><verse number="8" style="v" sid="1SA 12:8" />याकूब ते तैसेरू टब्बर मिस्र मुल्खे मां जेवं, ते तुश्शे बुज़ुर्गेईं यहोवा कां बिनती की; तैखन यहोवा मूसा ते हारून भेज़े, ते तैनेईं तुश्शे बुज़ुर्ग मिस्र मुल्खे मरां कढे, ते इस ठारी मां बसाए। <verse eid="1SA 12:8" /><verse number="9" style="v" sid="1SA 12:9" />फिरी ज़ैखन तैनेईं अपनो परमेशर यहोवा बिसरी छ़डो, तैखन तैनी तैना हासोरेरो सेनापति सीसरा, ते पलिश्ती लोक ते मोआबेरे राज़ेरे अधीन किये; ते तैना तैन सेइं लड़े। <verse eid="1SA 12:9" /><verse number="10" style="v" sid="1SA 12:10" />तैखन फिरी तुश्शे पूर्वजेईं यहोवा कां बिनती केरतां ज़ोवं, ‘असेईं यहोवा शारोरोए ते बाल देबते ते अश्तोरेत देबरे मूरतरी केरि पूज़ा केरतां बड़ो पाप कियोरोए; पन अगर हुनी तू असन इश्शे दुश्मना केरे हथ्थे मरां छुटास त अस तेरी आराधना केरमेले।’ <verse eid="1SA 12:10" /><verse number="11" style="v" sid="1SA 12:11" />एल्हेरेलेइ यहोवा यरूब्बाल<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="fq" closed="false">यरूब्बाल </char><char style="ft" closed="false">गिदोनेरू दूइयोवं नवं</char></note>, बदान, यिप्तह, ते शमूएल भेज़तां तुस ते तुश्शे च़ेवरे पासां केरे दुश्मना केरे हथ्थे मरां छुटाए; ते तुस निडर राने लगे। <verse eid="1SA 12:11" /><verse number="12" style="v" sid="1SA 12:12" />ते ज़ैखन तुसेईं हेरू कि अम्मोनी केरो राज़ो नाहाश असन पुड़ चढ़ाई केरते, तैखन एसेरे अलावा तुश्शो परमेशर यहोवा तुश्शो राज़ो थियो फिरी भी तुसेईं मीं सेइं ज़ोवं, ‘नईं, असन पुड़ अक राज़ो हुकूमत केरेलो।’ <verse eid="1SA 12:12" /><verse number="13" style="v" sid="1SA 12:13" />हुनी तै राज़ो हेरा ज़ै तुसेईं च़ुनोरोए, ते ज़ेसेरे लेई तुसेईं प्राथना कियोरी थी; हेरा, यहोवाए अक राज़ो तुसन पुड़ ठहरावरोए। <verse eid="1SA 12:13" /><verse number="14" style="v" sid="1SA 12:14" />अगर तुस यहोवारो डर मन्नथ ते तैसेरी सेवा केरथ, ते तैसेरी गल्‍लां शुन्ते राथ, ते यहोवारो हुक्म शैरतां तैसेरी बगावत केरथ, ते तुस तै ज़ै तुसन पुड़ राज़ो बनोरोए दूईये अपने परमेशर यहोवा पत्ती-पत्ती च़लनेबाले बनोरे रेइयथ, तैखन त भलू भोल्हु; <verse eid="1SA 12:14" /><verse number="15" style="v" sid="1SA 12:15" />पन अगर तुस यहोवारी गल्‍लां न मन्नथ, ते यहोवारो हुक्म टेलतां तैस सेइं बगावत केरथ, त यहोवा तुश्शे बुज़ुर्गां केरि ज़ेरि तुसन सज़ाह देलो। <verse eid="1SA 12:15" /><verse number="16" style="v" sid="1SA 12:16" />एल्हेरेलेइ हुनी ज़ैड़ी तुस आथ तैड़ी खड़े राथ, ते इस बड्डे कम्मे हेरा ज़ैन यहोवा तुश्शी एछ़्छ़ी केरे सामने केरनेबालोए। <verse eid="1SA 12:16" /><verse number="17" style="v" sid="1SA 12:17" />अज़ कुन गेहुं केरि कटाई नईं भोने लगोरी? अवं यहोवा कां प्राथना केरेलो, ते तै बिदलार गरज़ालो ते झ़ड़ी बखालो; तैखन तुस बुज़्झ़ी गाले, ते हेरी भी बटेले, कि तुसेईं राज़ो मेगतां यहोवारी नज़री मां बड़ी बुराई कियोरीए।” <verse eid="1SA 12:17" /><verse number="18" style="v" sid="1SA 12:18" />तैखन शमूएले यहोवा कां प्राथना की, ते यहोवाए तैस दिहाड़े अम्बर गरज़ावं ते झ़ड़ी बखने लगी; ते सारे लोक यहोवा ते शमूएले करां बड़े डेरि जे।<verse eid="1SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 12:19" />ते सारे लोकेईं शमूएले सेइं ज़ोवं, “अपने दासां केरे लेई अपने परमेशर यहोवा कां प्राथना केर, कि अस मेरि न गाम; किजोकि असेईं अपने सारे पापन करां जादे ई बुराई कियोरीए कि राज़ेरी मांग की।” <verse eid="1SA 12:19" /><verse number="20" style="v" sid="1SA 12:20" />शमूएले लोकन सेइं ज़ोवं, “डरा न; तुसेईं ई त सारी बुराई कियोरीए, पन हुनी यहोवा पत्ती च़लने करां फिरी न मुड़थ; पन अपने पूरे मने सेइं तैसेरी सेवा केरथ; <verse eid="1SA 12:20" /><verse number="21" style="v" sid="1SA 12:21" />ते न मुड़थ; नईं त एरी बेकार मूरती केरे पत्ती च़लने लगथ ज़ैन सेइं न किछ फैइदो भोल्हो, ते न किछ छुटकारो भोइ सकेलो, किजोकि तैना सब बेकारन। <verse eid="1SA 12:21" /><verse number="22" style="v" sid="1SA 12:22" />यहोवा त अपने बड्डे नंव्वेरे वजाई सेइं अपने लोकन न बिसरेलो, किजोकि यहोवाए तुस एपनी मेर्ज़ी सेइं अपने लोक बनाए। <verse eid="1SA 12:22" /><verse number="23" style="v" sid="1SA 12:23" />फिरी ई गल मीं करां दूर भोए कि अवं तुश्शे लेई प्राथना केरनी छ़ेडतां यहोवारे खलाफ पापी भोइ; अवं त तुसन रोड़ी ते सिद्धी बत हिराताईं। <verse eid="1SA 12:23" /><verse number="24" style="v" sid="1SA 12:24" />सिर्फ एत्रू भोए कि तुस लोक यहोवारो डर मन्ना, ते सच़्च़ैई सेइं अपने पूरे मने सेइं तैसेरी आराधना केरा; किजोकि इन त सोचा कि तैनी तुश्शे लेई केरहां बड्डां-बड्डां कम्मां कियोरन। <verse eid="1SA 12:24" /><verse number="25" style="v" sid="1SA 12:25" />पन अगर तुस बुराई केरते राले, त तुस ते तुश्शो राज़ो दूईये नाश किये गाले।”<verse eid="1SA 12:25" /></para>
  <chapter eid="1SA 12" />
  <chapter number="13" style="c" sid="1SA 13" />
  <para style="s">शाऊल राज़ेरो पेइलो पाप ते तैसेरो नितीजो</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 13:1" />शाऊल 30 सालां केरि उमरी मां इस्राएली लोकन पुड़ राज़ केरने लगो ते तैनी दूई सालन तगर<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="fq" closed="false">दूई सालन तगर </char><char style="ft" closed="false">शाऊल एक्‍की साले तगर राज़ कियूं, ते ज़ैखन तै दूइयोवं साले सारे इस्राएले पुड़ राज़ केरने लगो।</char></note> राज़ कियूं।<verse eid="1SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 13:2" />फिरी शाऊले इस्राएली लोकन मरां 3000 मड़द अपने लेई च़ुने; ते तैन मरां 2000 शाऊले सेइं साथी मिकमाश नगरे मां ते बेतेल नगरेरे पहाड़ी प्रदेशे पुड़ राए, ते 1000 योनाताने साथी बिन्यामीन प्रदेशेरे गिबा नगरे मां राए; ते होरे सारे लोक तैनी अपने-अपने डेरे जो भेज़े। <verse eid="1SA 13:2" /><verse number="3" style="v" sid="1SA 13:3" />तैखन योनाताने पलिश्ती लोकां केरि चौवकी ज़ै गेबा नगरे मां थी ज़ींती; ते एसेरी खबर पलिश्ती लोकन तगर पुज़्ज़ी। तैखन शाऊले सारे मुल्खे मां नरशिंगो बज़ेइतां ई समाद भेज़ो, “इब्रि लोक शुन्न।” <verse eid="1SA 13:3" /><verse number="4" style="v" sid="1SA 13:4" />ते सारे इस्राएली लोकेईं ई खबर शुनी कि शाऊले पलिश्ती लोकां केरि चौकी ज़ींतोरीए, ते इन भी कि पलिश्ती लोक इस्राएली लोकन सेइं नफरत केरने लगोरेन। तैखन लोक शाऊले सेइं साथी च़ेलतां गिलगाल नगरे मां अकोट्ठे भोइ जे।<verse eid="1SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 13:5" />पलिश्ती लोक इस्राएली लोकन सेइं लड़ाई केरने लेई अकोट्ठे भोइ जे, तैनेईं 30000 रथ, ते 6000 सुवार, ते समुद्रेरे बन्नेरे रेतरे ज़ेरे बड़े सिपाही अकोट्ठे भोए; ते बेतावेन<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="fq" closed="false">बेतावेन </char><char style="ft" closed="false">बेतेल नगरेरू होरू नवं</char></note> नगरेरे पूरबेरे पासे गेइतां मिकमाश नगरे मां डेरे लाए। <verse eid="1SA 13:5" /><verse number="6" style="v" sid="1SA 13:6" />ज़ैखन इस्राएली सेना हेरू कि अस खतरे मां पेई जेवरेम, तैखन तैन मरां कही सिपाही कुढन मां, झ़ैल्‍लन, शफड़न, गत्तन ते खुहन मां, गेइतां छ़प्पे। <verse eid="1SA 13:6" /><verse number="7" style="v" sid="1SA 13:7" />ते किछ इस्राएली सिपाही यरदन दरियाए पार भोइतां गाद ते गिलादेरे प्रादेशन मां च़ले जे; पन शाऊल गिलगाल नगरे मां राव, ते सारे लोक डेरतां थरकने लगे ते तैस पत्ती च़ले जे।<verse eid="1SA 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 13:8" />शाऊल शमूएलेरे ठहरावरे वक्तेरे मुताबिक सत दिहाड़न तगर इंतज़ार केरतो राव; पन शमूएल गिलगाल नगरे मां न अव, ते सिपाही तैस करां च़लने गाने लगे। <verse eid="1SA 13:8" /><verse number="9" style="v" sid="1SA 13:9" />एल्हेरेलेइ शाऊले ज़ोवं, “होमबलि ते मेलबलि मीं कां आनां।” तैखन तैने एप्पु होमबलि च़ाढ़ी। <verse eid="1SA 13:9" /><verse number="10" style="v" sid="1SA 13:10" />ज़ेरि तै होमबलि च़ाढ़ी, त कुन हेरतन कि शमूएल तैड़ी पुज़्ज़ो; ते शाऊले तैस सेइं मिलने ते सुवागत केरनेरे लेई निस्सो। <verse eid="1SA 13:10" /><verse number="11" style="v" sid="1SA 13:11" />शमूएले पुछ़ू, “तीं एन कुन कियूं?” शाऊले ज़ोवं, “ज़ैखन मीं हेरू कि सिपाही मीं करां इरां-उरां च़लोरेन, ते तू ठहरावरे दिहाड़न मां न अव, ते पलिश्ती लोक मिकमाश नगरे मां अकोट्ठे भोए, <verse eid="1SA 13:11" /><verse number="12" style="v" sid="1SA 13:12" />तैखन मीं सोचू कि पलिश्ती गिलगाल नगरे मां मीं पुड़ हमलो केरेले, ते मीं यहोवा कां बिनती भी नईं कियोरीए; एल्हेरेलेइ मीं मजबूर भोइतां होमबलि च़ाढ़ी।” <verse eid="1SA 13:12" /><verse number="13" style="v" sid="1SA 13:13" />शमूएले शाऊले सेइं ज़ोवं, “तीं बेवकूफरू कम कियूं; तीं अपने परमेशर यहोवारो हुक्म न मन्नो; नईं त यहोवा तेरी हुकूमत इस्राएले पुड़ हमेशा बनेइतां रखेथो। <verse eid="1SA 13:13" /><verse number="14" style="v" sid="1SA 13:14" />पन हुनी तेरू राज़ बनोरू न रालू; यहोवा अपने लेई अक एरहो मैन्हु तोपोरोए ज़ै तैसेरे मनेरे मुताबिके; ते यहोवा तै अपने लोकन पुड़ प्रधान भोनेरे लेई ठहरावरोए, किजोकि तीं यहोवारो हुक्म न मन्नो।”<verse eid="1SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 13:15" />तैखन शमूएल तैट्ठां च़लो जेव, ते गिलगाल नगरेरां बिन्यामीनेरे गिबा नगरे मां जेव। ते शाऊले ज़ैना सिपाही तैस सेइं साथी गने तैना 600 थिये।<verse eid="1SA 13:15" /></para>
  <para style="s">पलिश्ती केरि हार</para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 13:16" />ते शाऊल ते तैसेरू मट्ठू योनातान ते अपने सिपेहिन सेइं साथी थिये तैना बिन्यामीन प्रदेशेरे गेबा नगरे मां राए; ते पलिश्ती लोक मिकमाश नगरे मां डेरो लेइतां बिश्शोरे राए। <verse eid="1SA 13:16" /><verse number="17" style="v" sid="1SA 13:17" />ते पलिश्ती केरे डेरन मरां हमलो केरनेबाले ट्लाई जथे बनेइतां निस्से; अक जथो शूआल नंव्वेरे प्रदेशेरे पासे मुड़तां ओप्रा नगरेरे बत्तां च़लो, <verse eid="1SA 13:17" /><verse number="18" style="v" sid="1SA 13:18" />ते दूइयोवं जथो फिरतां बेथोरोन नगरेरे बत्तां च़लो, ते ट्लेइयोवं जथो फिरतां तैस मुल्खेरी बत्तां च़लो ज़ै सबोईम नव्वेंरी पहाड़ेरे पासे ज़ै सुनसान ठैरारे पासे।<verse eid="1SA 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 13:19" />तैस वक्ते मां पूरे इस्राएल मुल्खे मां लुहार कोन्च न थियो मैलतो, किजोकि पलिश्ती लोकेईं ज़ोवरू थियूं, “इब्रि लोक तलवार या भालो न बनेई सकन।” <verse eid="1SA 13:19" /><verse number="20" style="v" sid="1SA 13:20" />एल्हेरेलेइ सारे इस्राएली लोक अपने-अपने हल्‍लां केरे फाल ते भाले, मैक्‍कु, ते ड्लातां पट्लनेरे लेई पलिश्ती लोकन कां गाते थिये; <verse eid="1SA 13:20" /><verse number="21" style="v" sid="1SA 13:21" />पन तैन केरां ड्लातां, फाल, ज़मीनदारी केरनेरे लेई केखू, ते मैक्‍कु केरि धार तिख्खी केरनेरे लेई रेती रखते थिये। <verse eid="1SA 13:21" /><verse number="22" style="v" sid="1SA 13:22" />एल्हेरेलेइ लड़ाई केरनेरे दिहाड़े शाऊल ते योनातानेरे सैथन मरां कोन्ची कां न त तलवार थी ते न भालो, तैना सिर्फ शाऊल ते तैसेरे मट्ठे योनाताने कां थिये। <verse eid="1SA 13:22" /><verse number="23" style="v" sid="1SA 13:23" />ते पलिश्ती लोकां केरे चौकरे सिपाही निस्तां मिकमाशेरी वैदी मांजो जे।<verse eid="1SA 13:23" /></para>
  <chapter eid="1SA 13" />
  <chapter number="14" style="c" sid="1SA 14" />
  <para style="s">योनातानेरी ज़ीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 14:1" />एक्‍की दिहाड़ी शाऊलेरे मट्ठे योनाताने अपने बाजी सेइं बगैर किछ ज़ोने अपने हथियार छ़ूनेबाले जुवाने सेइं ज़ोवं, “एई, अस उड़ी पलिश्ती केरि चेवकरे पासे च़लम।” <verse eid="1SA 14:1" /><verse number="2" style="v" sid="1SA 14:2" />तैस दिहाड़ी शाऊल त गिबा नगरेरी सरहद्दी पुड़ मिग्रोन नगरे मां अनारेरे बुट्टे हैठ बिशोरो थियो, ते तैस सेइं साथी लगभग 600 सिपाही थिये। <verse eid="1SA 14:2" /><verse number="3" style="v" sid="1SA 14:3" />ते एली ज़ै शीलो नगरे मां यहोवारो याजक थियो, तैसेरू मट्ठू पीनहासेरू पोट्लड़ू, ते ईकाबोदेरे ढ्ला, अहीतूबेरू मट्ठू अहिय्याह भी एपोद लेइतां साथी थियूं। पन तैन सिपेहिन पतो न थियो कि योनातान च़लो जेवरोए। <verse eid="1SA 14:3" /><verse number="4" style="v" sid="1SA 14:4" />तैन वैदन मां, ज़ैन मांमेइं भोइतां योनातान पलिश्ती लोकां केरि चौकी कां गानू चातो थियो, दूईये पासन अक-अक तिख्खी चट्टान थी; ते एक्‍की चट्टानरू नवं बोसेस<note caller="+" style="f"><char style="fr" closed="false">14:4 </char><char style="fq" closed="false">बोसेस </char><char style="ft" closed="false">इसेरो मतलब “चमकनू” भोते।</char></note>, ते होरि चट्टानरू नवं सेने<note caller="+" style="f"><char style="fr" closed="false">14:4 </char><char style="fq" closed="false">सेने </char><char style="ft" closed="false">इसेरो मतलब झ़ैल्‍लन बालू भोते।</char></note> थियूं। <verse eid="1SA 14:4" /><verse number="5" style="v" sid="1SA 14:5" />अक चट्टान त उत्तरेरे पासे मिकमाश नगरेरे सामने, ते होरि दक्षिणेरे गेबा नगरेरे सामने खड़ी थी।<verse eid="1SA 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 14:6" />तैखन योनाताने अपने हथियार छ़ूंने बाले जुवाने सेइं ज़ोवं, “एई, अस तैना खतनो न कियोरे लोकां केरि चौकी कां गाम; भोइ सकते यहोवा इश्शी मद्दत केरे; किजोकि यहोवा कोई रुकावट नईं, कि चाहे त हछे लोकां केरे ज़िरिये, चाहे थोड़े लोकां केरे ज़िरिये छुटकारो दे।” <verse eid="1SA 14:6" /><verse number="7" style="v" sid="1SA 14:7" />तैसेरे हथियार छ़ूंने बाले तैस सेइं ज़ोवं, “ज़ैन किछ तीं ठीक लग्गे तैन केर तू अग्रोवं च़ल, अवं तेरी मेर्ज़रे मुताबिक तीं सेइं साथी रालो।” <verse eid="1SA 14:7" /><verse number="8" style="v" sid="1SA 14:8" />योनाताने ज़ोवं, “शुन, अस तैन मैन्हन कां नेड़े गाम ताके तैन्न अस नज़री एज्जम। <verse eid="1SA 14:8" /><verse number="9" style="v" sid="1SA 14:9" />अगर पलिश्ती असन सेइं इन ज़ोन, ‘इश्शे एजने तगर बिश्शोरे राथ,’ तैखन त अस तैस्से जगाई पुड़ खड़े रहमेले, ते तैन कां न च़ढ़मेले। <verse eid="1SA 14:9" /><verse number="10" style="v" sid="1SA 14:10" />पन अगर तैना इन ज़ोन, ‘असन कां बा एज्जा,’ त अस एन ज़ैनतां च़ढ़मेले, कि यहोवा तैन इश्शे हथ्थे मां केरेलो। इश्शे लेई ईए निशान भोल्हो।” <verse eid="1SA 14:10" /><verse number="11" style="v" sid="1SA 14:11" />तैखन तैना योनातान ते पलिश्ती सिपाही पलिश्ती केरि चेवकरे सामने आए, तैखन पलिश्ती ज़ोने लगे, “हेरा, इब्रि लोक तैन गत्तन मां ज़ैड़ी तैना छ़पोरे थिये निसोरेन।” <verse eid="1SA 14:11" /><verse number="12" style="v" sid="1SA 14:12" />फिरी चेवकरे सिपैहेईं योनातान ते तैसेरे हथियार छ़ूंने बाले सेइं हक देइतां ज़ोवं, “असन कां एज्जा, तैखन अस तुसन किछ शिखालमेले।” तैखन योनाताने अपने हथियार छ़ूंने बाले सेइं ज़ोवं, “मीं पत्ती-पत्ती च़लो एई; किजोकि यहोवा तैन इस्राएली केरे हथ्थे मां केरेलो।” <verse eid="1SA 14:12" /><verse number="13" style="v" sid="1SA 14:13" />तैखन योनातान अपने हथ ते पव्वां केरि ताकती सेइं च़ेढ़ी जेव, ते तैसेरो हथियार छ़ूंने बालो भी तैस पत्ती-पत्ती च़ेढ़ी जेव। पलिश्ती योनातानेरे सामने बिछ़ड़ते जे, ते तैसेरे हथियार छ़ूंने बालो तैसेरे पत्ती-पत्ती तैन मारतो जेव। <verse eid="1SA 14:13" /><verse number="14" style="v" sid="1SA 14:14" />ई पेइली लड़ाई ज़ै योनातान ते तैसेरे हथियार छ़ूंने बालन सेइं भोइ, तैस मां अधे बीघे ज़मीनी मां 20 सिपाही मेरि जे। <verse eid="1SA 14:14" /><verse number="15" style="v" sid="1SA 14:15" />तैखन डेरन मां, ते मैइदाने पुड़, ते तैना सब लोकन डेरतां थर्क शुरू भोइ; ते चौकी बाले ते हमलो केरनेबाले भी कम्बने लगे; ते भुंज़ल भी अव; ते अचानक बड़ी धरती हिलने लगी। <verse eid="1SA 14:15" /><verse number="16" style="v" sid="1SA 14:16" />बिन्यामीन प्रदेश गिबा नगरे मां शाऊलेरे पहरदारेईं पलिश्ती नशते हेरे। <verse eid="1SA 14:16" /><verse number="17" style="v" sid="1SA 14:17" />तैखन शाऊले अपने साथी लोकन सेइं ज़ोवं, “अपनि गिनती केरतां हेरा कि असन मरां कौन च़ेलि जेवरोए।” तैनेईं गेनतां हेरू, कि योनातान ते तैसेरो हथियार छ़ूने बालो इड़ी नईं। <verse eid="1SA 14:17" /><verse number="18" style="v" sid="1SA 14:18" />तैखन शाऊले अहिय्याह सेइं ज़ोवं, “परमेशरेरो सन्दूख इरां आन।” तैस मौके त परमेशरेरो सन्दूख इस्राएली लोकन कां थियो। <verse eid="1SA 14:18" /><verse number="19" style="v" sid="1SA 14:19" />शाऊल याजके सेइं गल्‍लां केरि राहोरो थियो, ते पलिश्ती लोकां केरे डेरन मां शोर जादे बेधी जेई; तैखन शाऊले याजके सेइं ज़ोवं, “परमेशरे पुछ़नू बन्द केर।” <verse eid="1SA 14:19" /><verse number="20" style="v" sid="1SA 14:20" />तैखन शाऊल ते तैसेरे सारे साथी सिपाही अकोट्ठे भोइतां लड़ैई मां जे; तैड़ी तैनेईं कुन हेरू, कि पलिश्ती सिपाही एक्‍की होरि पुड़ तलवार च़लेइ राहोरेन, ते पलिश्तन एप्पु मांमेइं बड़ो हंगामो मेच़ि राहोरोए। <verse eid="1SA 14:20" /><verse number="21" style="v" sid="1SA 14:21" />ज़ैना इब्रि पेइले पलिश्ती केरे पासे थिये, ते तैन सेइं साथी च़ेवरे पासना डेरन मां जेवरे थिये, तैना भी शाऊल ते योनाताने सेइं साथी इस्राएली लोकन मां मिले। <verse eid="1SA 14:21" /><verse number="22" style="v" sid="1SA 14:22" />एन्च़रां सेइं ज़ेत्रे इस्राएली सिपाही एप्रैमेरे पहाड़ी इलाके मां छ़ेप्पी जेवरे थिये, तैनेईं भी एन शुनू कि पलिश्ती नेश्शी जेवरेन, लड़ाई मां एइतां तैन केरो पीछो केरने मां लगे। <verse eid="1SA 14:22" /><verse number="23" style="v" sid="1SA 14:23" />तैखन यहोवा तैस दिहाड़े इस्राएली लोकन छुटकारो दित्तो; ते लड़नेबाले बेतावेन नगरेरे पैरीं पासे तगर च़ले जे। <verse eid="1SA 14:23" /><verse number="24" style="v" sid="1SA 14:24" />पन इस्राएली सिपाही तैस दिहाड़े तंग भोए, किजोकि शाऊले तैन लोकन कसम देइतां ज़ोवं, “लानती भोए तै, ज़ै ड्लवझ़ी तगर किछ खाए; एस्से तरीके सेइं अवं अपने दुश्मन सेइं बदलो नेही बटेलो।” ते तैन सिपेहिन मरां केन्चे भी रोट्टी न खाई। <verse eid="1SA 14:24" /><verse number="25" style="v" sid="1SA 14:25" />ते सारे इस्राएली सिपाही जंगले मां पुज़्ज़े, तैड़ी ज़मीनी पुड़ माछ़ी पेरवरू मैल्हू, पन तैनेईं न खाऊं। <verse eid="1SA 14:25" /><verse number="26" style="v" sid="1SA 14:26" />तैना डरोरे थिये, किजोकि तैनेईं कसम कियोरी थी कि तैना किछ न खाएले। <verse eid="1SA 14:26" /><verse number="27" style="v" sid="1SA 14:27" />पन योनाताने अपनो बाजी सिपेहिन कसम देते न थियूं शुनोरू, एल्हेरेलेइ तैनी अपने हथ्थेरी सोटरी च़ुंच़ अग्रोवं केरतां गणेरे मैछ़ेरे कश्शे मां डोबी, ते माछ़ी खाव; तैखन तैस हिम्मत अई ते तैसेरी ताकत वापस अई। <verse eid="1SA 14:27" /><verse number="28" style="v" sid="1SA 14:28" />तैखन अक सिपाही योनाताने सेइं ज़ोने लगो, “तेरे बाजे लोकन सखत कसम देइतां ज़ोवरूए, ‘लानती भोए तै, ज़ै अज़ किछ खाए।’” ते सिपाही थकोरे थिये। <verse eid="1SA 14:28" /><verse number="29" style="v" sid="1SA 14:29" />योनाताने ज़ोवं, “मेरे बाजे लोकन दुख दित्तोरोए। हेरा, मीं इन माछ़ी थोड़ू ज़ेरू खाऊं, ते मीं हिम्मत अई। <verse eid="1SA 14:29" /><verse number="30" style="v" sid="1SA 14:30" />अगर अज़ सिपाही अपने दुश्मना केरि लूटी सेइं ज़ै तैन मैल्होरीए एपनी मेर्ज़ी सेइं खाथे, त केत्रे पलिश्ती मारे जेवरे भोथे।”<verse eid="1SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 14:31" />तैस दिहाड़े तैना मिकमाश नगरे करां लेइतां अय्यालोने तगर पलिश्ती सिपेहिन मारते जे; ते इस्राएली सिपाही बड़े कमज़ोर भोए। <verse eid="1SA 14:31" /><verse number="32" style="v" sid="1SA 14:32" />एल्हेरेलेइ इस्राएली सेना लूटी पुड़ ट्लुटी जे, ते भैड्डां-छ़ेल्‍ली, ते बेछ़ी-दांत, ते बछ़ड़ां नेइतां ज़मीनी पुड़ मैरतां तैन केरू मास खूने सने खाने लगे। <verse eid="1SA 14:32" /><verse number="33" style="v" sid="1SA 14:33" />ज़ैखन एसेरी खबर शाऊले मैल्ही, कि लोक खूने समेत मास खेइतां यहोवारे खलाफ पाप केरने लगोरेन। तैखन तैनी तैन सेइं ज़ोवं, “तुस त धोखेबाज़ आथ; हुन्ना अक बड्डो घोड़ मीं कां घिसेइतां देथ।” <verse eid="1SA 14:33" /><verse number="34" style="v" sid="1SA 14:34" />फिरी शाऊले ज़ोवं, “सिपेही केरे मझ़ाटे मां इरां उरां मुड़तां तैन सेइं ज़ोथ, ‘अपने-अपने दांत ते भैड्डां शाऊले कां नेथ, ते तैट्ठी बलि केरतां खाथ; ते खूने समेत खेइतां यहोवारे खलाफ पाप न केरा।’” तैखन सैरी सिपैहेईं तैस्से राती अपने-अपने दांत नेइतां गेइतां तैट्ठी बलि किये। <verse eid="1SA 14:34" /><verse number="35" style="v" sid="1SA 14:35" />तैखन शाऊले यहोवारे लेई अक वेदी बनावाई; तै त पेइली वेदी आहे ज़ै तैनी यहोवारे लेई बनावाई।<verse eid="1SA 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 14:36" />फिरी शाऊले सिपेहिन सेइं ज़ोवं, “अस इस्से राती पलिश्ती केरो पीछो केरतां तैन झ़ेझ़ां तगर लुटते रहम; ते तैन मरां अक भी ज़ींतो न छ़डम।” तैनेईं ज़ोवं, “ज़ैन किछ तीं रोड़ू लग्गे तैन्ने केर।” पन याजके ज़ोवं, “अस इड़ी परमेशरे कां पुछ़मेले।” <verse eid="1SA 14:36" /><verse number="37" style="v" sid="1SA 14:37" />तैखन शाऊले परमेशरे पुछ़ू, “कुन अवं पलिश्ती लोकां केरो पीछो केरीं? कुन तू तैन इस्राएलेरे हथ्थे मां केरेलो?” पन तैस दिहाड़े किछ जुवाब न मैल्हो। <verse eid="1SA 14:37" /><verse number="38" style="v" sid="1SA 14:38" />तैखन शाऊले सिपाही कुजेइतां ज़ोवं, “हे इस्राएलेरे खास लोकव, इड़ी एइतां ज़ाना; ते हेरा कि अज़ पाप कोस किसमे सेइं भोवरोए। <verse eid="1SA 14:38" /><verse number="39" style="v" sid="1SA 14:39" />किजोकि इस्राएले छुटानेबाले यहोवारे ज़िन्दगरी कसम, अगर तै पाप मेरे मट्ठे योनाताने करां भोवरो भोए, फिरी भी सच़्च़े तै मारो गालो।” पन लोकन मरां केन्चे भी तैस जुवाब न दित्तो। <verse eid="1SA 14:39" /><verse number="40" style="v" sid="1SA 14:40" />तैखन तैनी सारे इस्राएली लोकन सेइं ज़ोवं, “तुस एक्‍की पासे राथ, ते अवं ते मेरू मट्ठू योनातान होरि पासे रहमेले।” लोकेईं शाऊले सेइं ज़ोवं, “ज़ैन किछ तीं रोड़ू लगते तैन्ने केर।” <verse eid="1SA 14:40" /><verse number="41" style="v" sid="1SA 14:41" />तैखन शाऊले यहोवा कां प्राथना की, “हे इस्राएलेरे परमेशर, सच़्च़ी गल ज़ो।” तैखन चिट्ठी योनातान ते शाऊलेरे नंव्वे पुड़ निस्सी, ते सिपाही बेंच़ी जे। <verse eid="1SA 14:41" /><verse number="42" style="v" sid="1SA 14:42" />फिरी शाऊले हुक्म दित्तो, “मेरे ते मेरे मट्ठे योनातानेरे नंव्वे पुड़ चिट्ठी छ़डा।” तैखन चिट्ठी योनातानेरे नंव्वे पुड़ निस्सी।<verse eid="1SA 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1SA 14:43" />तैखन शाऊले योनाताने सेइं ज़ोवं, “मीं ज़ो, कि तीं कुन कियोरूए।” योनाताने ज़ोवं, “मीं अपने हथ्थेरी सोटरी च़ुंच़ी सेइं थोड़ू ज़ेरू माछ़ी च़खू। ते हेर, अवं मरनेरे लेई तियार आईं।” <verse eid="1SA 14:43" /><verse number="44" style="v" sid="1SA 14:44" />शाऊले ज़ोवं, “परमेशर एरू केरे, बल्के एस करां भी जादे केरे; हे योनातान, तू सच़्च़े मारो गानोस।” <verse eid="1SA 14:44" /><verse number="45" style="v" sid="1SA 14:45" />पन सिपैहेईं शाऊले सेइं ज़ोवं, “कुन योनातान मारो गालो, ज़ैनी इस्राएली केरो एत्रो बड्डो छुटकारो कियोरोए? एरू न भोए! यहोवारे ज़िन्दगरी कसम, तैसेरे दोग्गेरे अक बाल भी ज़मीनी पुड़ बिछ़ड़ो न गाए; किजोकि अज़्ज़ेरे दिहाड़े तैनी परमेशरे साथी भोइतां पलिश्ती हाराए।” तैखन सिपैहेईं योनातान बच़ेइ छ़डो, ते तै मारो न जेव। <verse eid="1SA 14:45" /><verse number="46" style="v" sid="1SA 14:46" />तैखन शाऊल पलिश्ती केरो पीछो छ़ेडतां अव; ते पलिश्ती भी अपने इलाके जो च़ले जे। <verse eid="1SA 14:46" /><verse number="47" style="v" sid="1SA 14:47" />ज़ैखन शाऊल इस्राएली लोकन पुड़ हुकूमत केरने लगो, तैखन तै मोआबी, अम्मोनी, एदोमी, ते पलिश्ती, अपने च़ेवरे पासेरे सारे दुश्मन्न सेइं, ते सोबारे राज़े सेइं लड़ो; ते ज़ैड़ी-ज़ैड़ी तै गातो जेव तैड़ी ज़ींत मैलती जेई। <verse eid="1SA 14:47" /><verse number="48" style="v" sid="1SA 14:48" />फिरी तैनी बहदरी केरतां अमालेकी लोक ज़ींते, ते इस्राएली लोक लुटने बाले लोकां केरे हथ्थेरां छुटाए।<verse eid="1SA 14:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1SA 14:49" />शाऊलेरां मट्ठां योनातान, यिश्वी, ते मल्कीशूअ थियां; ते तैसेरी दूई कुइयां केरां नवं इना थियां, बेडरू नवं मेरब, ते निकड़रू नवं मीकल थियूं। <verse eid="1SA 14:49" /><verse number="50" style="v" sid="1SA 14:50" />ते शाऊलेरी कौन्शरू नवं अहीनोअम थियूं ज़ै अहीमासेरी कुई थी। तैसेरे प्रधान सेनापति अब्नेर थियो ज़ैन शाऊलेरे चाचे नेरेरू मट्ठू थियूं। <verse eid="1SA 14:50" /><verse number="51" style="v" sid="1SA 14:51" />शाऊलेरो बाजी कीश थियो, ते अब्नेरो बाजी नेर अबीएलेरू मट्ठू थियूं।<verse eid="1SA 14:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1SA 14:52" />शाऊलेरी ज़िन्दगी भर पलिश्ती सेइं लड़ाई राई; ज़ैखन भी शाऊले कोई बहादर या रोड़ो योद्धा लेइहोतो थियो तैखन तै तैस अपने सेनाई मां रखतो थियो।<verse eid="1SA 14:52" /></para>
  <chapter eid="1SA 14" />
  <chapter number="15" style="c" sid="1SA 15" />
  <para style="s">अमालेकी केरि हार</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 15:1" />एक्सां शमूएले शाऊले सेइं ज़ोवं, “यहोवा अपने इस्राएली लोकन पुड़ हुकूमत केरनेरे लेई तेरू अभिषेक केरनेरे लेई अवं भेज़ोरोईं; एल्हेरेलेइ हुनी यहोवारी गल्‍लां शुन। <verse eid="1SA 15:1" /><verse number="2" style="v" sid="1SA 15:2" />सेनां केरो यहोवा इन ज़ोते, ‘मीं याद एइते<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="fq" closed="false">मीं याद एइते </char><char style="ft" closed="false">होरो मतलब ई भी कि अवं सज़ाह देइलो।</char></note> कि अमालेकी लोकेईं इस्राएली लोकन सेइं कुन कियोरूए; ज़ैखन इस्राएली लोक मिस्र मुल्खे मरां एवरे थिये, तैखन तैनेईं बत्ती मां तैन केरो मुकाबलो कियो।<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="EXO 17:8-13">निर्ग. 17:8-13</ref>;<ref loc="DEU 25:17-19">व्यव. 25:17-19</ref>.</char></note> <verse eid="1SA 15:2" /><verse number="3" style="v" sid="1SA 15:3" />एल्हेरेलेइ हुनी तू गेइतां अमालेकी लोकन मार, ते ज़ैन किछ तैन केरू आहे तैस बगैर दया केरतां नाश केर; मड़द, कौन्श, बच्‍चे, दुद्ध पीते बच्‍चे, गोरू, गब्बां, ऊँट, गधे सेभन मार।’”<verse eid="1SA 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 15:4" />तैखन शाऊले लोक कुजेइतां अकोट्ठे किये, ते तैना तलाईम नगरे मां गणे, ते तैना 200000 इस्राएली सिपाही, ते 10000 यहूदी सिपाही थिये। <verse eid="1SA 15:4" /><verse number="5" style="v" sid="1SA 15:5" />तैखन शाऊले अमालेक नगरेरे<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="fq" closed="false">अमालेक नगरेरे </char><char style="ft" closed="false">क़िले बाले डेरे</char></note> नेड़े गेइतां वैदी मां हमलो केरनेबाले सिपाही बिशाले। <verse eid="1SA 15:5" /><verse number="6" style="v" sid="1SA 15:6" />ते शाऊले तैन इलाकन मां रानेबाले केनी लोकन सेइं ज़ोवं, “तैट्ठां नश्शा, अमालेकी लोकां केरे मझ़ाटेरां निस्सी गाथ कि एरू न भोए कि अवं तैन सेइं साथी तुश्शो भी अन्त केरि छ़ेड्डी; किजोकि तैन सेइं सारे इस्राएली केरे मिस्र मुल्खे मरां एंइते बार दया हिरेवरी थी।” ते केनी लोकां केरे ते अमालेकी लोकां केरे मझ़ाटेरां निस्सी जे। <verse eid="1SA 15:6" /><verse number="7" style="v" sid="1SA 15:7" />तैखन शाऊले हवीला नगरे करां लेइतां शूर नगरे तगर ज़ैन मिस्र मुल्खेरे पूरबेरे पासे अमालेकी लोक मारे। <verse eid="1SA 15:7" /><verse number="8" style="v" sid="1SA 15:8" />ते तैन केरो राज़ो अगाग ज़ींतो ट्लाव, ते तैसेरे सारे लोक तलवारी सेइं नाश किये। <verse eid="1SA 15:8" /><verse number="9" style="v" sid="1SA 15:9" />पन अगागे पुड़, ते रोड़ी करां रोड़ी भैड्डां-छ़ेल्‍ली, बेछ़ी-दांत, निगर जानबरन, ते गबड़ां, ते ज़ैन किछ रोड़ू थियूं, तैन पुड़ शाऊले ते तैसेरे लोकेईं नरमी की, ते तैन नाश केरनू न चाव; पन ज़ैन किछ घटिया ते निकम्मू थियूं तैसेरो तैनेईं नाश कियो।<verse eid="1SA 15:9" /></para>
  <para style="s">राज़ेरे रूपे मां शाऊल कबूल नईं</para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 15:10" />तैखन यहोवा शमूएले सेइं ज़ोवं, <verse eid="1SA 15:10" /><verse number="11" style="v" sid="1SA 15:11" />“अवं शाऊले राज़ो बनाने करां पसताने लगोरोईं; किजोकि तैनी मीं पत्ती च़लनू छ़ेडी दित्तेरूए, ते मेरे हुक्म नईं मन्नोरे।” तैखन शमूएलेरो क्रोध भड़को; ते तै पूरी राती यहोवा कां प्राथना केरने लगो। <verse eid="1SA 15:11" /><verse number="12" style="v" sid="1SA 15:12" />ज़ैखन शमूएल शाऊले सेइं मिलनेरे लेई झ़ेझ़ां उठो; तैखन शमूएले इन ज़ोवं, “शाऊल कर्मेल नगरे जो एवरो थियो, ते अपने लेई अक यादगार बनाई, ते हेंठतां गिलगाल नगरे जो च़ेलि जेव।” <verse eid="1SA 15:12" /><verse number="13" style="v" sid="1SA 15:13" />तैखन शमूएल शाऊले कां जेव, ते शाऊले तैस सेइं ज़ोवं, “तीं यहोवारे तरफां बरकत मैल्हे; मीं यहोवारो हुक्म पूरो कियो।” <verse eid="1SA 15:13" /><verse number="14" style="v" sid="1SA 15:14" />शमूएले ज़ोवं, “फिरी भैड्डां-छ़ेल्‍ली केरि इना लेरां, ते बेछ़ी-दांत केरि आवाज़ ज़ै अवं शुन्ने लगोरोइं, एन किजो भोने लगोरूए?” <verse eid="1SA 15:14" /><verse number="15" style="v" sid="1SA 15:15" />शाऊले ज़ोवं, “तैना त अमालेकी लोकन करां इड़ी एवरेन; मतलब प्रजारे लोकेईं रोड़े करां रोड़ी भैड्डां-छ़ेल्‍ली ते बेछ़ी-दांत तेरे परमेशर यहोवा जो बलि केरनेरे लेई आनोरेन; ते बाकी सब असेईं पूरे तरीके सेइं नाश कियोरूए।” <verse eid="1SA 15:15" /><verse number="16" style="v" sid="1SA 15:16" />तैखन शमूएले शाऊले सेइं ज़ोवं, “रुकी गा! ते ज़ै गल यहोवाए अज़ राती मीं सेइं ज़ोवरीए तै अवं तीं सेइं ज़ोताईं।” तैनी ज़ोवं, “ज़ो।”<verse eid="1SA 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 15:17" />शमूएले ज़ोवं, “ज़ैखन तू एपनी नज़री मां निकड़ो थियो, तैखन कुन तू इस्राएलेरे गोट्लन मां प्रधान न थियो? ते कुन यहोवाए इस्राएली लोकन पुड़ हुकूमत केरनेरे लेई तेरू अभिषेक नईं कियोरू? <verse eid="1SA 15:17" /><verse number="18" style="v" sid="1SA 15:18" />ते यहोवाए तू अक खास कम केरनेरे लेई भेज़ो, ते ज़ोवं, ‘गेइतां तैन पापी अमालेकी लोकन नाश केर, ते ज़ैखन तगर तैना मिटी न गान, तैखन तगर तैन सेइं लड़तो रेइयां।’ <verse eid="1SA 15:18" /><verse number="19" style="v" sid="1SA 15:19" />फिरी तीं केसेरे लेई यहोवारी ऐह गल टेलतां लूटी पुड़ ट्लुटतां तैन कम कियूं ज़ैन यहोवारी नज़र मां बुरूए?”<verse eid="1SA 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 15:20" />शाऊले शमूएले सेइं ज़ोवं, “पक्‍के मीं यहोवारी गल मेनतां ज़ेरां यहोवाए अवं भेज़ो तेरहां अवं च़लो, ते अमालेकी लोकां केरो राज़ो अगाग आनोरोए, ते अमालेकी लोक नाश किये। <verse eid="1SA 15:20" /><verse number="21" style="v" sid="1SA 15:21" />पन सिपाही लूटी मरां भैड्डां-छ़ेल्‍ली, ते बेछ़ी-दांत, मतलब खतम भोनेरी रोड़ी-रोड़ी चीज़ां गिलगाले मां तेरे परमेशर यहोवा कां बलि च़ाढ़नेरे लेई ऐनोरीन।” <verse eid="1SA 15:21" /><verse number="22" style="v" sid="1SA 15:22" />शमूएले ज़ोवं,</para>
  <para style="q" vid="1SA 15:22">“कुन यहोवा होमबलि, ते मेलबलि सेइं एत्रो खुश भोते,</para>
  <para style="q" vid="1SA 15:22">ज़ेत्रो कि अपनि गल मन्ने सेइं खुश भोते?</para>
  <para style="q" vid="1SA 15:22">शुन, मन्नू त बलि च़ाढ़ने करां ते ध्याने सेइं शुन्नू दांतां ते हुड़ां केरे मैंझ़न करां रोड़ूए।<verse eid="1SA 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1SA 15:23" />हेर, बगावत केरनी ते जैदूगिरे करां पुछ़नू अक बराबर पापे,</para>
  <para style="q" vid="1SA 15:23">ते ज़िद केरनी मूरतन ते कुल देबतेरी पूज़ा केरनी बराबरे।</para>
  <para style="q" vid="1SA 15:23">तीं ज़ै यहोवारी गल निकम्मी समझ़ोरीए,</para>
  <para style="q" vid="1SA 15:23">एल्हेरेलेइ तैनी तू राज़ो भोनेरे लेई निकम्मो समझ़ोरोस।”<verse eid="1SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 15:24" />शाऊले शमूएले सेइं ज़ोवं, “मीं पाप कियोरोए; मीं त अपने लोकां केरो डर मेनतां तैन केरि गल्‍लां शुन्तां यहोवारो हुक्म ते तेरी गल्‍लां केरि बगावत कियोरीए। <verse eid="1SA 15:24" /><verse number="25" style="v" sid="1SA 15:25" />पन हुनी मेरे पाप माफ़ केर, ते मीं साथी वापस एई, कि अवं यहोवारी आराधना केरि।” <verse eid="1SA 15:25" /><verse number="26" style="v" sid="1SA 15:26" />शमूएले शाऊले सेइं ज़ोवं, “अवं तीं साथी वापस न एज्जी; किजोकि तीं यहोवारी गल निकम्मी समझ़ोरीए, ते यहोवा तू इस्राएली केरो राज़ो भोनेरे लेई निकम्मो समझ़ोरोस।” <verse eid="1SA 15:26" /><verse number="27" style="v" sid="1SA 15:27" />तैखन शमूएल गानेरे लेई फिरो, ते शाऊले तैसेरे चोगेरो अक कूनो ट्लाव, ते तै छ़िंदोइ जेव। <verse eid="1SA 15:27" /><verse number="28" style="v" sid="1SA 15:28" />तैखन शमूएले तैस सेइं ज़ोवं, “अज़ यहोवा इस्राएली केरू राज़ छ़िन्दतां थुसोड़ोरूए, ते एक्‍की मैन्हु दित्तोरू ज़ै तीं करां रोड़ोए। <verse eid="1SA 15:28" /><verse number="29" style="v" sid="1SA 15:29" />ते ज़ै इस्राएलेरी ताकतरो ज़िरियोए तै न त झूठ ज़ोए ते न पसताए; किजोकि तै मैन्हु नईं, कि पसताए।” <verse eid="1SA 15:29" /><verse number="30" style="v" sid="1SA 15:30" />तैनी ज़ोवं, “मीं पाप त कियोरोए; फिरी भी मेरे लोक ते बुज़ुर्ग ते इस्राएली केरे सामने मेरी आदर केर, ते मीं साथी वापस एई, कि अवं तेरे परमेशर यहोवारी आराधना केरि।” <verse eid="1SA 15:30" /><verse number="31" style="v" sid="1SA 15:31" />तैखन शमूएल मुड़तां शाऊले पत्ती जेव; ते शाऊले यहोवारी आराधना की।<verse eid="1SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 15:32" />तैखन शमूएले ज़ोवं, “अमालेकी केरे राज़े अगागे मीं कां इरां आनां।” तैखन अगाग आनन्दे सेइं इन ज़ोइतां तैस कां जेव, “सच़्च़े मौतरो दुख बीती जेव।” <verse eid="1SA 15:32" /><verse number="33" style="v" sid="1SA 15:33" />शमूएले ज़ोवं, “ज़ेन्च़रे कौन्शां तेरी तलवार सेइं बेऔलाद भोवरिन, तेरही तेरी अम्मा कौन्शन मां बेऔलाद भोल्ही।” तैखन शमूएले अगाग राज़ेरे गिलगाल नगरे मां यहोवारे सामने टुक्ड़े-टुक्ड़े किये।<verse eid="1SA 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 15:34" />फिरी शमूएल रामाह जो च़ेलि जेव; ते शाऊल अपने नगर गिबा जो अपने घरे जेव। <verse eid="1SA 15:34" /><verse number="35" style="v" sid="1SA 15:35" />ते शमूएले अपने ज़िन्दगी भर शाऊले सेइं फिरी मुलाकात न की, किजोकि शमूएल शाऊलेरे लेई मातम केरतो राव। ते यहोवा शाऊले इस्राएली केरो राज़ो बनेइतां पसतातो थियो।<verse eid="1SA 15:35" /></para>
  <chapter eid="1SA 15" />
  <chapter number="16" style="c" sid="1SA 16" />
  <para style="s">दाऊद राज़ो च़ुनो गानो</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 16:1" />एक्सां यहोवा शमूएले सेइं ज़ोवं, “मीं शाऊल इस्राएले पुड़ राज़ केरनेरे लेई निकम्मो समझ़ो, तू कैखन तगर तैसेरे बारे मां मातम केरतां रालो? शिंगे मां तेल भर ते च़ल; अवं तीं बैतलहम नगरेरे रानेबाले यिशै कां भेज़ताईं, किजोकि मीं तैसेरे मट्ठन मरां अक राज़ो भोनेरे लेई च़ुनोरोए।” <verse eid="1SA 16:1" /><verse number="2" style="v" sid="1SA 16:2" />शमूएले ज़ोवं, “अवं केन्च़रे गेइ सकताईं? अगर शाऊल शुनेलो, त मीं मारेलो।” यहोवा ज़ोवं, “अक बछ़ड़ी साथी नेइतां गेइयां ते ज़ोइयां, ‘अवं यहोवारे लेई बलि केरने एवरोईं।’ <verse eid="1SA 16:2" /><verse number="3" style="v" sid="1SA 16:3" />ते बलि केरनेरे ठैरी पुड़ यिशै जो धाम ज़ोइयां, तैखन अवं तीं ज़ोलो कि तीं कुन केरनूए; ते ज़ैस जो अवं तीं ज़ोइलो तैस मेरी तरफां अभिषेक केरां।” <verse eid="1SA 16:3" /><verse number="4" style="v" sid="1SA 16:4" />तैखन शमूएले यहोवारे ज़ोनेरे मुताबिक कियूं, ते बैतलहम नगरे जो जेव। तैस नगरेरे प्रधान थरकते तैस सेइं मिलने जो जे, ते ज़ोने लगे, “कुन तू दोस्तेरे लिहाज़े सेइं एवरोस कि नईं?” <verse eid="1SA 16:4" /><verse number="5" style="v" sid="1SA 16:5" />तैनी ज़ोवं, “हाँ, दोस्तेरे लिहाज़े सेइं एवरोईं; अवं यहोवारे लेई बलि देनेरे लेई एवरोईं; तुस अपने आपे पवित्र केरतां मीं सेइं साथी बलि देने एज्जा।” तैखन तैनी यिशै ते तैसेरां मट्ठां पवित्र केरनेरे लेई ते बलि देनेरे ठारी मां एजनेरे लेई धाम ज़ोई।<verse eid="1SA 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 16:6" />ज़ैखन यिशै त तैसेरां मट्ठां आं, तैखन तैनी एलीआबे लेहितां सोचू, “सच़्च़े ई ज़ै यहोवारे सामने तैए तैसेरो अभिषिक्त भोल्हो।” <verse eid="1SA 16:6" /><verse number="7" style="v" sid="1SA 16:7" />पन यहोवा शमूएले सेइं ज़ोवं, “न त तैसेरे रूपे पुड़ नज़र केरां, ते न तैसेरे कदे पुड़, किजोकि मीं तै काबल नईं समझ़ोरोए; किजोकि यहोवारू तकनू मैन्हु केरू ज़ेरू नईं; मैन्हु त बेइरयूं रूप हेरते, पन यहोवारी नज़र मने पुड़ रहतीए।” <verse eid="1SA 16:7" /><verse number="8" style="v" sid="1SA 16:8" />तैखन यिशै अबीनादाबे कुजेइतां शमूएले कां सामने भेज़ो। ते तैस सेइं ज़ोवं, “यहोवा ज़ोवं, ई भी नईं च़ुनोरे।” <verse eid="1SA 16:8" /><verse number="9" style="v" sid="1SA 16:9" />फिरी यिशै शम्मा सामने भेज़ो। ते तैनी ज़ोवं, “यहोवाए ई भी नईं च़ुनोरोए।” <verse eid="1SA 16:9" /><verse number="10" style="v" sid="1SA 16:10" />एन्च़रां सेइं यिशै अपना सत मट्ठां शमूएले कां सामने भेज़ां। ते शमूएल यिशै सेइं ज़ोतो जेव, “यहोवा एना नईं च़ुनोरां।” <verse eid="1SA 16:10" /><verse number="11" style="v" sid="1SA 16:11" />तैखन शमूएले यिशै सेइं ज़ोवं, “कुन तेरां सारा मट्ठां एवरेन?” तैनी ज़ोवं, “नईं, निकड़ू मट्ठू नईं एवरू, तैन गब्बन सेइं जेवरूए।” शमूएले यिशै सेइं ज़ोवं, “तैस जो समाद भेज़तां कुजा; किजोकि ज़ांतगर तैन इड़ी न एज्जे तांतगर अस रोट्टी खानेरे लेई न बिशमेले।” <verse eid="1SA 16:11" /><verse number="12" style="v" sid="1SA 16:12" />तैखन तैनी तैन कुजेइतां नेड़े आनू। तैसेरी त खैखोड़ी छ़ल-छ़ल केरती थी, ते तैसेरी एछ़्छ़ी खूबसूरत थी, तैखन यहोवा ज़ोवं, “उठतां एसेरू अभिषेक केर: ईए आहे।” <verse eid="1SA 16:12" /><verse number="13" style="v" sid="1SA 16:13" />तैखन शमूएले अपनु तेलेरू शिंग नेइतां तैसेरे ढ्लां केरे सामने तैसेरू अभिषेक कियूं; ते तैस दिहाड़े करां लेइतां एजने बाले वक्ते मां यहोवारो आत्मा दाऊदेरी अगवाई केरतो राव। तैखन शमूएल उठतां रामाह नगरे जो च़लो जेव। <verse eid="1SA 16:13" /><verse number="14" style="v" sid="1SA 16:14" />यहोवारो आत्मा शाऊले पुड़ेरां च़ेलि जेव, ते यहोवारे तरफां अक दुष्ट आत्मा तैस डरने लगी। <verse eid="1SA 16:14" /><verse number="15" style="v" sid="1SA 16:15" />ते शाऊलेरे सेवकेईं तैस सेइं ज़ोवं, “शुन, परमेशरेरी तरफां अक दुष्ट आत्मा तीं डराने लगोरीए। <verse eid="1SA 16:15" /><verse number="16" style="v" sid="1SA 16:16" />इश्शो मालिक अपने सेवकन ज़ैना हाज़र आन हुक्म दे, कि तैना कोन्ची ज़ै सैन्गी बज़ाने मां माहिर भोए तोपतां आन्न; ते ज़ैखन-ज़ैखन परमेशरेरे तरफां दुष्ट आत्मा तीं पुड़ एज्जे, तैखन-तैखन तै अपने हथेइं सेइं तैस बज़ाए, ते तू ठीक भोइ गास।” <verse eid="1SA 16:16" /><verse number="17" style="v" sid="1SA 16:17" />शाऊले अपने सेवकन सेइं ज़ोवं, “ठीके, अक ज़ै सैन्गी बज़ाने मां माहिर भोए, तैस मीं कां आनां।” <verse eid="1SA 16:17" /><verse number="18" style="v" sid="1SA 16:18" />तैखन एक्‍की जुवाने जुवाब दित्तो, “शुन, मीं बैतलहम नगरेरे यिशैरू अक मट्ठू लाहेरूए ज़ैन सैन्गी बज़ाते, ते तै बहादर योद्धा आहे, ते गल्‍लां केरने मां अक्लमन्दे ते बड़ो खूबसूरत भी आहे; ते यहोवा तैस सेइं साथी रहते।” <verse eid="1SA 16:18" /><verse number="19" style="v" sid="1SA 16:19" />तैखन शाऊले दूतां केरे ज़िरिये यिशै कां समाद भेज़ो, “अपनु मट्ठू दाऊद ज़ैन भैड्डां-छ़ेल्‍लन सेइं साथी रहते मीं कां भेज़।” <verse eid="1SA 16:19" /><verse number="20" style="v" sid="1SA 16:20" />तैखन यिशै रोट्टन सेइं लेदतां अक गधो, ते मसक भेरतां दाछ़रो रस, ते छ़ेल्‍लरो अक बच्‍चो नेइतां अपनु मट्ठे दाऊदेरे हथ्थे शाऊले कां भेज़ू। <verse eid="1SA 16:20" /><verse number="21" style="v" sid="1SA 16:21" />ते दाऊद शाऊले कां गेइतां तैसेरी सेवा केरने लगो। ते शाऊल तैस सेइं बड़ो प्यार केरने लगो, ते तै तैसेरो हथियार छ़ूंने बालो भोइ जेव। <verse eid="1SA 16:21" /><verse number="22" style="v" sid="1SA 16:22" />तैखन शाऊले यिशैरे लेई समाद भेज़ो, “दाऊदे मीं कां राने दे, किजोकि अवं तैस सेइं बड़ो खुश आईं।” <verse eid="1SA 16:22" /><verse number="23" style="v" sid="1SA 16:23" />ते ज़ैखन-ज़ैखन परमेशरेरी तरफां दुष्ट आत्मा शाऊले पुड़ एइती थी, तैखन-तैखन दाऊद सैन्गी नेइतां बज़ातो थियो; ते शाऊले आराम मैलतो थियो ते ठीक भोतो थियो, ते तै दुष्ट आत्मा तैस मरां निस्सी गाती थी।<verse eid="1SA 16:23" /></para>
  <chapter eid="1SA 16" />
  <chapter number="17" style="c" sid="1SA 17" />
  <para style="s">गोलियतेरी ललकार</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 17:1" />पलिश्ती लोकेईं इस्राएलन सेइं जंग लड़नेरे लेई अपनि सेना अकोट्ठी की; ते यहूदा प्रदेशेरे सोको नगरे मां अकोट्ठे भोइतां सोको ते अजेका नगरेरे मझ़ाटे एपेसदम्मीम नगरे मां डेरे लाए। <verse eid="1SA 17:1" /><verse number="2" style="v" sid="1SA 17:2" />शाऊल ते इस्राएली सिपैहेईं भी अकोट्ठे भोइतां एला नव्वेंरी वैदी मां डेरे लाए, ते जंग लड़नेरे लेई पलिश्ती केरे खलाफ तियार भोए। <verse eid="1SA 17:2" /><verse number="3" style="v" sid="1SA 17:3" />पलिश्ती लोक पहाड़ेरे एक्‍की पासे इस्राएली पहाड़ेरे होरि पासे खड़े राए; ते दूईयां केरे मझ़ाटे वादी थी। <verse eid="1SA 17:3" /><verse number="4" style="v" sid="1SA 17:4" />तैखन पलिश्ती केरे डेरन मरां गोलियत नंव्वेरो अक बहादर निस्सो, ज़ै गत नगरेरो रानेबालो थियो, ते तैसेरी लम्बाई लगभग शा हथ थी। <verse eid="1SA 17:4" /><verse number="5" style="v" sid="1SA 17:5" />तैसेरे दोग्गे पुड़ पितलरो टोप थियो; ते तैनी अक पितलरी झिलम लेवरी थी, ज़ेसेरो वज़न 5000<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="fq" closed="false">वज़न 5000 </char><char style="ft" closed="false">लगभग 57 किल्‍लो </char></note> शेकेल पितलरो थियो। <verse eid="1SA 17:5" /><verse number="6" style="v" sid="1SA 17:6" />तैसेरी ज़ंघन पुड़ पितलरे कवच थिये, ते तैनी पिठी पुड़ भालो बन्धोरो थियो। <verse eid="1SA 17:6" /><verse number="7" style="v" sid="1SA 17:7" />तैसेरे भालेरो डण्डो खेडरे डण्डेरो ज़ेरो थियो, ते तैसेरे भालेरो फल 600 शेकेल<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">600 शेकेल </char><char style="ft" closed="false">लगभग 7 किल्‍लो</char></note> लोंहेरो थियो, ते बड़ी ढाल ट्लेइतां अक मैन्हु तैस अग्री-अग्री च़लतो थियो। <verse eid="1SA 17:7" /><verse number="8" style="v" sid="1SA 17:8" />तै खड़ो भोइतां इस्राएली सेना जो ललकारतो थियो, “तुसेईं इड़ी एइतां जंगरे लेई किजो डेरो लेवरोए? कुन अवं पलिश्ती नईं, ते तुस शाऊलेरे अधीन नईं? एप्पु मरां अक मड़द च़ुना, कि तै मेरे सामने एज्जे। <verse eid="1SA 17:8" /><verse number="9" style="v" sid="1SA 17:9" />अगर तै मीं सेइं लेड़तां मीं मैरी सके, तैखन त अस तुश्शे अधीन भोइ गामेले; पन अगर अवं तैस हारेइतां तैस मैरी, त तुसेईं इश्शे अधीन भोइतां इश्शी गुलामी केरनी पेली।” <verse eid="1SA 17:9" /><verse number="10" style="v" sid="1SA 17:10" />फिरी तै पलिश्ती ज़ोने लगो, “अवं अज़्ज़ेरे दिहाड़े इस्राएली सेना ललकारताईं, कोई योद्धा मीं कां भेज़ा, कि अस एक्‍की होरि सेइं लड़म।” <verse eid="1SA 17:10" /><verse number="11" style="v" sid="1SA 17:11" />तैस पलिश्तेरी इनां गल्‍लां शुन्तां शाऊल ते सारे इस्राएली लोक बड़े डेरि जे। <verse eid="1SA 17:11" /><verse number="12" style="v" sid="1SA 17:12" />दाऊद यहूदा प्रदेशेरे बैतलहम नगरेरे तैस एप्रातेरे कुले मरां थियो, ज़ेसेरू नवं यिशै थियूं, ते तैसेरां अठ मट्ठां थियां ते तै मड़द शाऊलेरे दिहाड़न मां बुढो ते कमज़ोर भोइ जेवरो थियो। <verse eid="1SA 17:12" /><verse number="13" style="v" sid="1SA 17:13" />यिशैरां ट्लाई बड्डां मट्ठां शाऊले सेइं साथी भोइतां लड़ने जेवरे थियां; ते तैसेरां ट्लाई मट्ठां केरां नंव्वां ज़ैना लड़ने जेवरां थियां, सेभना करां बड्डेरू नवं एलीआब, होरेरू अबीनादाब, ते ट्लेइयोवंरू शम्मा थियूं। <verse eid="1SA 17:13" /><verse number="14" style="v" sid="1SA 17:14" />सेभन करां निकड़ो दाऊद थियो; ते ट्लाईए बड्डां मट्ठां शाऊले सेइं साथी जंगी मां जेवरां थियां <verse eid="1SA 17:14" /><verse number="15" style="v" sid="1SA 17:15" />ते दाऊद बैतलहमे मां अपने बाजेरी भैड्डां छ़ेल्‍ली च़ारने शाऊले करां एइतो गातो रहतो थियो।<verse eid="1SA 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 17:16" />पलिश्ती गोलियत त 40 दिहाड़न तगर झ़ेझ़ां-ड्लोझ़ इस्राएली सिपाही केरे सामने गेइतां खड़ो भोइतां ललकारतो थियो।<verse eid="1SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 17:17" />एक्सां यिशै अपने मट्ठे दाऊदे सेइं ज़ोवं, “इन एपा भेरतां<note caller="+" style="f"><char style="fr" closed="false">17:17 </char><char style="fq" closed="false">एपा भेरतां </char><char style="ft" closed="false">लगभग 10 किल्‍लो</char></note> तेवरू अन्न, ते इना दश रोट्टी नेइतां डेरन मां अपने ढ्लान कांजो दौड़तां गा। <verse eid="1SA 17:17" /><verse number="18" style="v" sid="1SA 17:18" />ते पनीरेरी इनां दश टिक्‍की तैन केरे 1000 सिपेही केरे सेनापेतेरे लेई ने। ते अपने ढ्लां केरो हाल चाल हेरतां तैन केरि कोई निशानी एना। <verse eid="1SA 17:18" /><verse number="19" style="v" sid="1SA 17:19" />शाऊल, ते तेरे ढ्ला, ते सारे इस्राएली सिपाही एला नव्वेंरी वैदी मां पलिश्तन सेइं लड़ने जेवरेन थिये।”<verse eid="1SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 17:20" />एल्हेरेलेइ दाऊदे भैड्डां छ़ेल्‍ली कोन्ची पुहाले कां छ़ेडतां झ़ेझ़ां उठतां, यिशैरे हुक्मेरे मुताबिक तैना चीज़ां नेइतां च़लो; ते ज़ैखन सेना जंगरे मैइदाने मांजो च़ेलि राहोरी थी, ते जंगरे लेई ललकारने लगोरी थी, तैस वक्ते तै अपने ढ्लां केरे डेरन पुड़ पुज़्ज़ो। <verse eid="1SA 17:20" /><verse number="21" style="v" sid="1SA 17:21" />तैखन इस्राएली ते पलिश्ती लोकेईं अपनि-अपनि सेना लड़ैइयरे लेई वार-पार की। <verse eid="1SA 17:21" /><verse number="22" style="v" sid="1SA 17:22" />दाऊद खानेरी चीज़ां सामानेरे पहरदारेरे हथ्थे मां छ़ेडतां जंगरे मैइदाने मांजो दौड़ो, ते अपने ढ्लान कां नेड़े गेइतां तैन केरो हाल चाल पुछ़ो। <verse eid="1SA 17:22" /><verse number="23" style="v" sid="1SA 17:23" />तै तैन सेइं गल्‍लां केरि राहोरो थियो, कि पलिश्ती सेनाई मरां तै बहादर गत नगरेरो रानेबालो गोलियत नंव्वेरो तै पलिश्ती योद्धा च़ेढ़तां अव, ते पेइलेरो ज़ेरो ललकारने लगो। ते दाऊदे तैन शुनू।<verse eid="1SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 17:24" />गोलियते लेइतां सारे इस्राएली बड़े डेरतां तैसेरे सामनेरां नेश्शी जे। <verse eid="1SA 17:24" /><verse number="25" style="v" sid="1SA 17:25" />फिरी इस्राएली सिपाही ज़ोने लगे, “कुन तीं तै योद्धा लाहोरोए ज़ै च़ेढ़तां एज्जी राहोरोए? सच़्च़े तै इस्राएली लोकन लालकारनेरे लेई च़ेढ़ी एइते; ते ज़ै कोई तैस मारेलो तैस राज़ो बड़ी दौलत देलो, ते एपनी कुइयरो ड्लाह तैस सेइं बनालो, ते तैसेरे बाजी केरे घराने इस्राएले मां कर देने करां आज़ाद केरेलो।” <verse eid="1SA 17:25" /><verse number="26" style="v" sid="1SA 17:26" />तैखन दाऊदे तैन सिपेहिन सेइं ज़ैना तैसेरे आसे-पासे खड़े थिये पुछ़ू, “ज़ै तैस पलिश्ती मैरतां इस्राएली लोकां केरि बदनामी दूर केरेलो तैसेरे लेई कुन कियूं गालू? तै खतनो न कियोरो पलिश्ती कुन ज़ींते परमेशरेरी सेना ललकारे?” <verse eid="1SA 17:26" /><verse number="27" style="v" sid="1SA 17:27" />तैखन सिपैहेईं तैस सेइं तैन्ना गल्‍लां ज़ोई, कि ज़ै कोई तैस मारेलो तैस कुन-कुन इनाम मैल्हेलू।<verse eid="1SA 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 17:28" />ज़ैखन दाऊद तैन सिपेहिन सेइं गल्‍लां केरि राहोरो थियो, तैखन तैसेरो बड्डो ढ्ला एलीआब शुनी राहोरो थियो; ते तै दाऊदे जो बड़ो सेरकोइतां ज़ोने लगो, “तू इड़ी किजो एवरोस? ते जंगले मां तैन थोड़ी ज़ेरि भैड्डां-छ़ेल्‍ली तू केसेरे हवाले छ़ेडतां एवरोस? तेरू घमण्ड ते तेरे दिलेरी बुराई मीं पतोए; तू त लड़ाई हेरनेरे लेई इड़ी एवरोस।” <verse eid="1SA 17:28" /><verse number="29" style="v" sid="1SA 17:29" />दाऊदे ज़ोवं, “हुनी मीं कुन कियूं? ई त गल बाते भोइ राहोरी थी।” <verse eid="1SA 17:29" /><verse number="30" style="v" sid="1SA 17:30" />तैखन दाऊदे तैस करां तुत्तर फिरवं ते होरि पासे खड़े भोइतां तेरही गल्‍लां ज़ोई; ते लोकेईं तैस पेइलेरो ज़ेरो जुवाब दित्तो।<verse eid="1SA 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 17:31" />ज़ैखन दाऊदेरी गल्‍लां शाऊले सेइं भी ज़ोई जेई, तैखन शाऊले भी शुनेई जेई; ते तैनी तै कुजव। <verse eid="1SA 17:31" /><verse number="32" style="v" sid="1SA 17:32" />तैखन दाऊदे शाऊले सेइं ज़ोवं, “कोन्ची मैन्हेरो दिल तैसेरे वजाई सेइं कच़्च़ो न भोए; तेरो दास गेइतां तैस पलिश्ती सेइं लड़ेलो।” <verse eid="1SA 17:32" /><verse number="33" style="v" sid="1SA 17:33" />शाऊले दाऊदे सेइं ज़ोवं, “तू गेइतां तैस पलिश्ती योद्धारे खलाफ लड़ाई न केरि सखस; किजोकि तू त मट्ठूस, ते तै छोट्टी उमरी करां लेइतां अज़ तगर योद्धा आहे।” <verse eid="1SA 17:33" /><verse number="34" style="v" sid="1SA 17:34" />पन दाऊदे शाऊले सेइं ज़ोवं, “तेरो दास अपने बाजी केरि भैड्डां-छ़ेल्‍ली च़ारतो थियो; ते ज़ैखन कोई शेर या इछ़ केन्नी मरां गबड़ू छ़ुइतां नेतो थियो, <verse eid="1SA 17:34" /><verse number="35" style="v" sid="1SA 17:35" />तैखन अवं तैसेरो पीछो केरतां तैस मारतो थियो, ते तैस निकड़े गबड़े तैसेरे ऐशी मरां छुटातो थियो; ते ज़ैखन तै मीं पुड़ हमलो केरतो थियो, तैखन अवं तैसेरे जबड़ेरे बाल ट्लेइतां तैस मैरी छ़डतो थियो। <verse eid="1SA 17:35" /><verse number="36" style="v" sid="1SA 17:36" />तेरे दासे शेर ते इछ़ दूईये मारोरेन। ते तैस बगैर खतनो कियोरो पलिश्ती मैन्हेरो हाल भी एरहो भोइ गालो, किजोकि तैनी ज़ींते परमेशरेरी सेना ललकारोरीए।” <verse eid="1SA 17:36" /><verse number="37" style="v" sid="1SA 17:37" />दाऊदे इन भी ज़ोवं, “यहोवा ज़ैनी अवं शेर ते इछ़ दूईयां केरे पंजे मरां बच़ाव, तैए मीं तैस पलिश्तेरे हथ्थेरां भी बच़ालो।” तैखन शाऊले दाऊदे सेइं ज़ोवं, “गा, यहोवा तीं सेइं साथी राए।” <verse eid="1SA 17:37" /><verse number="38" style="v" sid="1SA 17:38" />ते शाऊले दाऊदे अपना लिगड़ां लुवां ते पितलरो टोप लुवाव ते तैस झिलम भी लुवाई। <verse eid="1SA 17:38" /><verse number="39" style="v" sid="1SA 17:39" />तैखन दाऊदे तैसेरी तलवार लिगड़न पुड़ बन्धी, ते च़लनेरी कोशिश की; तैनी त तैन पेइलू न थियूं लेवरू। एल्हेरेलेइ दाऊदे शाऊले सेइं ज़ोवं, “एन लेइतां मीं करां च़लोए भी न, किजोकि मीं एन पेइलू नईं लेवरू।” ते दाऊदे तैना खोल्‍ली छ़डां। <verse eid="1SA 17:39" /><verse number="40" style="v" sid="1SA 17:40" />तैखन तैनी अपनि सोटी हथ्थे मां ट्लाई ते नाले मरां चिकने पंच़ घोड़ तैलतां अपने पुहालेरी थेली, मतलब अपने झोले मां रख्खे; ते अपनो छ़िंगलोट हथ्थे मां नेइतां पलिश्ती गोलियतेरे नेड़े जेव।<verse eid="1SA 17:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 17:41" />ते पलिश्ती च़लते-च़लते दाऊदेरे नेड़े पुज़्ज़े, ते ज़ै मैन्हु तैसेरी बड़ी ढाल ट्लेइतां थियो तै तैसेरे अग्री-अग्री च़लो। <verse eid="1SA 17:41" /><verse number="42" style="v" sid="1SA 17:42" />ज़ैखन पलिश्ती मैन्हे तक्‍कू ते दाऊद लाव, तैखन तैनी तै घटिया समझ़ो; किजोकि तैन निकड़ू मट्ठू थियूं, ते तैसेरे तुत्तरे पुड़ लाली चमकती थी, ते तैन बड़ू खूबसूरत थियूं। <verse eid="1SA 17:42" /><verse number="43" style="v" sid="1SA 17:43" />तैखन पलिश्ती मैन्हें दाऊदे जो ज़ोवं, “कुन अवं कुतर आईं, कि तू सोटी घिन्तां मीं कां एवरोस?” तैखन पलिश्ती अपने देबतां केरां नवं घिन्तां दाऊदे जो लानत देने लगो। <verse eid="1SA 17:43" /><verse number="44" style="v" sid="1SA 17:44" />फिरी पलिश्ती मैन्हें दाऊदे जो ज़ोवं, “मीं कां एई, अवं तेरी लाश अम्बरेरे च़ुड़ोलन ते जंगली जानबरन देइलो।” <verse eid="1SA 17:44" /><verse number="45" style="v" sid="1SA 17:45" />दाऊदे पलिश्ती योद्धा जो ज़ोवं, “तू त तलवार, भालो ते बलम ट्लेइतां मीं कांजो एवरोस; पन अवं सेनारे यहोवारे नंव्वे सेइं तीं कां एइताईं, ज़ै इस्राएली सेनारो परमेशरे, ते तैए तीं ललकारोरोए। <verse eid="1SA 17:45" /><verse number="46" style="v" sid="1SA 17:46" />अज़्ज़ेरे दिहाड़े यहोवा तीं मेरे हथ्थे मां केरेलो, ते अवं तीं मारेलो, ते तेरी क्रोड़ी तेरे रिगले करां अलग केरेलो; ते अवं अज़्ज़ेरे दिहाड़े पलिश्ती सेनारी लाशां अम्बरेरे च़ुड़ोलन देलो ते जंगली जानबरन। तैखन सैरी धेरतरे लोक सेमझ़ी गाले कि इस्राएले मां अक परमेशरे। <verse eid="1SA 17:46" /><verse number="47" style="v" sid="1SA 17:47" />ते ई सारी मण्डली सेमझ़ी गाली कि यहोवा तलवार या भालेरे ज़िरिये ज़ींत न दे, एल्हेरेलेइ कि जंग त यहोवारी आए, ते तैए तुसन इश्शे हथ्थे मां केरेलो।”<verse eid="1SA 17:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1SA 17:48" />ज़ैखन पलिश्ती गोलियत उठतां दाऊदेरो मुकाबलो केरनेरे लेई नेड़े अव, तैखन दाऊद गोलियतेरो मुकाबलो केरनेरे लेई जल्दी दौड़ो। <verse eid="1SA 17:48" /><verse number="49" style="v" sid="1SA 17:49" />फिरी दाऊदे अपने झोले मां हथ छ़ेडतां तैस मरां अक घोड़ कढो, ते तै छ़िंगलोटे मां छ़ेडतां पलिश्ती गोलियतेरे कुपाए पुड़ एन्च़रे बज़्ज़ो, कि तै ज़मीनी पुड़ तुत्तरेरे भारे बिछ़ड़ी जेव। <verse eid="1SA 17:49" /><verse number="50" style="v" sid="1SA 17:50" />एन्च़रे सेइं दाऊदे बगैर तलवारां छ़िंगलोटे ते एक्‍की घोड़ेरे ज़िरिये सेइं तैस पलिश्ती पुड़ हमलो केरतां तै मैरी छ़डो। <verse eid="1SA 17:50" /><verse number="51" style="v" sid="1SA 17:51" />तैखन दाऊद दौड़तां पलिश्ती पुड़ गेइतां खड़ो भोव, ते तैसेरी तलवार ट्लेइतां म्याने मरां खिच्‍ची, ते तै मारो, ते तैसेरी क्रोड़ी तैस्से तलवारी सेइं केट्टी छ़डी। पलिश्ती एन हेरतां कि इश्शो बहादर मेरि जेव पलिश्ती लोक नेश्शी जे। <verse eid="1SA 17:51" /><verse number="52" style="v" sid="1SA 17:52" />तैखन इस्राएली ते यहूदी मड़द ललकारने लगे, ते गत ते एक्रोने करां फाटकन तगर पलिश्ती केरो पीछो केरते जे, ते ज़खमी पलिश्ती शारैंमेरी बत्ती मां ते गत ते एक्रोन नगरन तगर बिछ़ड़ते जे। <verse eid="1SA 17:52" /><verse number="53" style="v" sid="1SA 17:53" />तैखन इस्राएली लोकेईं पलिश्ती सेनारो पीछो छ़ेडतां वापस आए, ते तैन केरे डेरे लुट्टे। <verse eid="1SA 17:53" /><verse number="54" style="v" sid="1SA 17:54" />ते दाऊदे पलिश्तेरी क्रोड़ी यरूशलेम नगरे मां आनी; ते तैसेरे हथियार अपने डेरे मां रख्खे। <verse eid="1SA 17:54" /><verse number="55" style="v" sid="1SA 17:55" />ज़ैखन शाऊले दाऊद तैस पलिश्तेरो मुकाबलो केरने लेई गातो लाव, तैखन तैनी अपने सेनारे प्रधाने अब्नेरे पुछ़ू, “हे अब्नेर, तै जुवान केसेरू मट्ठूए?” अब्नेरे ज़ोवं, “हे राज़ा, तेरे ज़िन्दगरी कसम, अवं न ज़ैनी।” <verse eid="1SA 17:55" /><verse number="56" style="v" sid="1SA 17:56" />राज़े ज़ोवं, “तू पतो केर कि तै जुवान केसेरू मट्ठूए।” <verse eid="1SA 17:56" /><verse number="57" style="v" sid="1SA 17:57" />ज़ैखन दाऊद पलिश्ती योद्धा मैरतां वापस अव, तैखन अब्नेरे तैस पलिश्तेरी क्रोड़ी हथ्थे मां ट्लेइतां शाऊलेरे सामने पुज़ाई। <verse eid="1SA 17:57" /><verse number="58" style="v" sid="1SA 17:58" />शाऊले तैस पुछ़ू, “हे जुवान, तू केसेरू मट्ठूस?” दाऊदे ज़ोवं, “अवं त तेरे दास बैतलहम नगरेरे यिशैरू मट्ठू आईं।”<verse eid="1SA 17:58" /></para>
  <chapter eid="1SA 17" />
  <chapter number="18" style="c" sid="1SA 18" />
  <para style="s">दाऊद ते योनातानेरी दोस्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 18:1" />दाऊदेरे शाऊले सेइं गल्‍लां केरनेरां बाद, तैखन योनातानेरो दिल दाऊदे सेइं एन्च़रे लेग्गी जेव, कि योनातान तैस सेइं अपने बराबर प्यार केरने लगो। <verse eid="1SA 18:1" /><verse number="2" style="v" sid="1SA 18:2" />ते तैस दिहाड़े करां शाऊले दाऊद एप्पु सेइं साथी रख्खो, ते अपने बाजी केरे घरे वापस गाने न दित्तो। <verse eid="1SA 18:2" /><verse number="3" style="v" sid="1SA 18:3" />तैखन योनाताने दाऊदे सेइं करार कियो, किजोकि तै तैस सेइं अपने प्राणां केरो ज़ेरो प्यार केरतो थियो। <verse eid="1SA 18:3" /><verse number="4" style="v" sid="1SA 18:4" />योनाताने अपनो चोगो ज़ै तैनी लेवरो थियो खोलतां दाऊदे दित्तो, ते तैनी सिपेही केरां ज़ेरां लिगड़ां ते अपनि तलवार ते धनुष ते कमरबन्ध भी तैस दित्तो। <verse eid="1SA 18:4" /><verse number="5" style="v" sid="1SA 18:5" />ते ज़ैड़ी कोन्च शाऊल दाऊदे भेज़तो थियो तैड़ी गेइतां तै अक्ली सेइं कम केरतो थियो; ते शाऊले तै सेनारो प्रधान ठहराव। ते सारे लोक ते शाऊलेरे अधिकारी तैस पुड़ खुशी थिये।<verse eid="1SA 18:5" /></para>
  <para style="s">शाऊलेरी दाऊदे सेइं दुश्मनी</para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 18:6" />ज़ैखन दाऊद तैस पलिश्ती मैरतां वापस एज्जी राहोरो थियो, ते तैना सारे सिपाही भी एज्जी राहोरो थिये, तैखन सारे इस्राएली नगरन मरां कौन्शां निस्तां डफली ते बाज़े घिन्तां, आनन्दे सेइं गीतां ज़ोती ते नेच़ती, शाऊल राज़ेरू सुवागत केरनेरे लेई निस्सी। <verse eid="1SA 18:6" /><verse number="7" style="v" sid="1SA 18:7" />ते तैना कौन्शां नेच़ती ते एक्‍की होरि सेइं साथी इन गीत ज़ोती जेई,</para>
  <para style="q" vid="1SA 18:7">“शाऊले त हज़ारेईं दुश्मन, पन दाऊदे लखेइं दुश्मन मारे।”<verse eid="1SA 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 18:8" />तैखन शाऊल बड़ो सेरकोव, ते ई गल तैस बुरी लगी; ते तै ज़ोने लगो, “तैनेईं दाऊदेरे लेई त लखेइं ते मेरे लेई हज़ारेईं ज़ोवरूए; एल्हेरेलेइ राज़ छ़ेडतां तैस हुनी होरू कुन मैल्हनू बाकी राव?” <verse eid="1SA 18:8" /><verse number="9" style="v" sid="1SA 18:9" />तैस दिहाड़े करां शाऊल दाऊदे पुड़ जलन केरतां नज़र रखने लगो।<verse eid="1SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 18:10" />दूइयोवं दिहाड़े परमेशरेरी तरफां एक्‍की दुष्ट आत्मा शाऊल अपने कैबू मां कियो, ते तै पागलेरो ज़ेरो हरकत केरने लगो;<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="fq" closed="false">पागलेरो ज़ेरो हरकत केरने लगो </char><char style="ft" closed="false">इसेरो मतलब ई भी भोइ सकते कि तै नबूवत केरने लगो।</char></note> दाऊद रोज़ेरो ज़ेरो अपने हथ्थे सेइं सितार बज़ेई राहोरो थियो ते शाऊलेरे हथ्थे मां भालो थियो। <verse eid="1SA 18:10" /><verse number="11" style="v" sid="1SA 18:11" />तैखन शाऊले इन सोचतां कि “अवं एन्च़रे बालो कि भालो दाऊदे समेत कंथी मां डुब्बे,” भालो दाऊदे पुड़ च़लाव, पन दाऊद तैसेरे सामनेरां दूई फेरेईं नश्शो।<verse eid="1SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 18:12" />शाऊल दाऊदे करां डरतो थियो, किजोकि यहोवा दाऊदे सेइं साथी थियो, पन शाऊले करां अलग भोइ जेवरो थियो। <verse eid="1SA 18:12" /><verse number="13" style="v" sid="1SA 18:13" />एल्हेरेलेइ शाऊले तै एप्पु करां अलग केरतां 1000 सिपेही केरो सेनापति बनाव, ते तै लोकां केरे सामने एइतो गातो रहतो थियो। <verse eid="1SA 18:13" /><verse number="14" style="v" sid="1SA 18:14" />ते दाऊद ज़ैन भी केरतो थियो तैस मां कामयाब भोतो थियो; ते यहोवा तैस सेइं साथी-साथी थियो। <verse eid="1SA 18:14" /><verse number="15" style="v" sid="1SA 18:15" />ज़ैखन शाऊले हेरू कि तै बड़ो कामयाब भोने लगोरोए, तैखन तै तैस करां डेरि जेव। <verse eid="1SA 18:15" /><verse number="16" style="v" sid="1SA 18:16" />पन इस्राएल ते यहूदारे सारे लोक दाऊदे सेइं प्यार केरते थिये; किजोकि तैनी जंगन मां अपने सेनारी अगवाई की ते तैन ज़ींत दुवाई।<verse eid="1SA 18:16" /></para>
  <para style="s">दाऊद ते मीकलरो ड्लाह</para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 18:17" />एक्सां शाऊले इन सोचतां कि “एन्च़रे सेइं पलिश्ती दाऊदे मारेले, ते मीं किछ नईं केरनू,” एल्हेरेलेइ दाऊदे सेइं ज़ोवं, “शुन, अवं अपनि बड्डी कुई मेरब तींजो ड्लेइतां देलो; एत्रू केर, कि तू बहादरी सेइं मेरे लेई यहोवारे तरफां जंग लड़।” <verse eid="1SA 18:17" /><verse number="18" style="v" sid="1SA 18:18" />पन दाऊदे शाऊले सेइं ज़ोवं, “अवं कुन आईं, ते मेरी ज़िन्दगी कुने, ते इस्राएले मां मेरे बाजी केरू कुल कुने, कि अवं राज़ेरो ज़माई बेनि?” <verse eid="1SA 18:18" /><verse number="19" style="v" sid="1SA 18:19" />ज़ैखन शाऊलेरी कुई मेरबरो दाऊदे सेइं ड्लाह बनानेरो वक्त अव, तैखन तैसारो ड्लाह महोलाई नगरेरे रानेबाले अद्रीएले सेइं बनाव।<verse eid="1SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 18:20" />इस दौरान शाऊलेरी कुई मीकल दाऊदे सेइं प्यार केरने लगी; ते ज़ैखन एस गल्‍लरी खबर शाऊले मैल्ही, तैखन तै खुश भोव। <verse eid="1SA 18:20" /><verse number="21" style="v" sid="1SA 18:21" />शाऊले त सोचोरू थियूं, कि तै तैसेरे लेई फंदो भोए, ते पलिश्ती केरे हथ्थे तै च़ढ़े। ते शाऊले दाऊदे सेइं ज़ोवं, “इस फेरे त तू ज़रूर मेरो ज़माई भोइ गालो।” <verse eid="1SA 18:21" /><verse number="22" style="v" sid="1SA 18:22" />फिरी शाऊले अपने सेवकन हुक्म दित्तो, “दाऊदे सेइं छ़ेपतां एरी गल्‍लां केरा, ‘शुन, राज़ो तीं पुड़ खुशे, ते तैसेरे सब सेवक भी तीं सेइं प्यार केरतन; एल्हेरेलेइ हुनी तू राज़ेरो ज़माई बन।’” <verse eid="1SA 18:22" /><verse number="23" style="v" sid="1SA 18:23" />तैखन शाऊलेरे सेवकेईं दाऊदे सेइं एरी गल्‍लां ज़ोई। पन दाऊदे ज़ोवं, “अवं त गरीब ते घटिया मैन्हु आईं, फिरी कुन तुश्शी नज़री मां राज़ेरो ज़माई भोनू निकड़ी गल्‍ले?” <verse eid="1SA 18:23" /><verse number="24" style="v" sid="1SA 18:24" />ज़ैखन शाऊलेरे सेवकेईं ज़ोवं, कि दाऊदे एरी-एरी गल्‍लां ज़ोवरिन। <verse eid="1SA 18:24" /><verse number="25" style="v" sid="1SA 18:25" />तैखन शाऊले ज़ोवं, “तुस दाऊदे सेइं इन ज़ोथ, ‘राज़ो कुइयरे बदले किछ न चाए, सिर्फ पलिश्ती केरि 100 खैड़ी चाते, कि तै अपने दुश्मन्न करां बदलो ने।’” शाऊलेरो इरादो ई थियो, कि पलिश्ती लोकन करां दाऊदे माराए। <verse eid="1SA 18:25" /><verse number="26" style="v" sid="1SA 18:26" />ज़ैखन तैसेरे सेवकेईं दाऊदे सेइं इना गल्‍लां ज़ोईं, तैखन तै राज़ेरो ज़माई बन्नेरे लेई खुश भोव। ज़ैखन ड्लाहेरे लेई किछे दिहाड़ी रेई जे, <verse eid="1SA 18:26" /><verse number="27" style="v" sid="1SA 18:27" />तैखन दाऊद एप्पु सेइं साथी सिपाही घिन्तां च़लो, ते पलिश्ती केरे 200 सिपाही मारे; तैखन दाऊदे तैन केरि खैड़ी एन्हीं, ते तैना राज़े कां गेनतां दित्ती, एल्हेरेलेइ कि तै राज़ेरो ज़माई भोइ गाए। ते शाऊले अपनि कुई मीकलरो ड्लाह तैस सेइं बनाव। <verse eid="1SA 18:27" /><verse number="28" style="v" sid="1SA 18:28" />ज़ैखन शाऊले हेरू, कि यहोवा दाऊदे सेइं साथीए, ते मेरी कुई मीकल तैस सेइं प्यार केरतीए, <verse eid="1SA 18:28" /><verse number="29" style="v" sid="1SA 18:29" />तैखन शाऊल दाऊदे करां होरो भी जादे डेरि जेव। एल्हेरेलेइ शाऊल हमेशारे लेई दाऊदेरो दुश्मन बेनि जेव।<verse eid="1SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 18:30" />फिरी पलिश्ती केरे सेनापति निस्तां आए, ते ज़ैखन-ज़ैखन तैना निस्तां आए तैखन-तैखन दाऊदे शाऊलेरे सारे सेनापतिन करां जादे अक्लमन्दी हिराई; एस सेइं तैसेरू नवं बड़ू मुशूर भोइ जेवं।<verse eid="1SA 18:30" /></para>
  <chapter eid="1SA 18" />
  <chapter number="19" style="c" sid="1SA 19" />
  <para style="s">शाऊलेरो दाऊदे पुड़ हमलो</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 19:1" />एक्‍की राती शाऊले अपने मट्ठे योनातान ते अपने सारे अधिकैरन सेइं दाऊदे मारनेरी चर्चा की। पन शाऊलेरू मट्ठू योनातान दाऊदे पुड़ बड़ू खुश थियूं। <verse eid="1SA 19:1" /><verse number="2" style="v" sid="1SA 19:2" />योनाताने दाऊदे सेइं ज़ोवं, “मेरो बाजी तीं मारनो चाते; एल्हेरेलेइ तू झ़ेझ़ां खबरदार रेइयां, ते उडारे मां अलग ठैरी पुड़ छ़ेपतां बिश; <verse eid="1SA 19:2" /><verse number="3" style="v" sid="1SA 19:3" />अवं उडारे मां ज़ैड़ी तू भोल्हो तैड़ी गेइतां अपने बाजी केरे नेड़े खड़ो भोइतां तैस सेइं तेरी चर्चा केरेलो; ते अगर मीं किछ पतो लग्गेलो त अवं तीं सेइं ज़ोइलो।” <verse eid="1SA 19:3" /><verse number="4" style="v" sid="1SA 19:4" />योनाताने अपने बाजी शाऊले सेइं दाऊदेरी तारीफ़ केरतां ज़ोवं, “हे राज़ा, अपने दास दाऊदेरे खलाफ पाप न केर; किजोकि तैनी तेरे खलाफ कोई पाप नईं कियोरो, बल्के तैसेरे सारे कम्मन सेइं तेरी बड़ी मद्दत भोवरीए; <verse eid="1SA 19:4" /><verse number="5" style="v" sid="1SA 19:5" />तैनी अपनि जान खतरे मां छ़ेडतां पलिश्ती गोलियत मारो, ते यहोवाए सारे इस्राएली केरि बड़ी ज़ीत कराई। एस हेरतां तू बड़ो खुश भोव; ते तू दाऊदे बगैर कोन्ची वजां मैरतां बेकसूरेरे खूनेरो पापी किजो बनतस?” <verse eid="1SA 19:5" /><verse number="6" style="v" sid="1SA 19:6" />तैखन शाऊले योनातानेरी गल्‍लां मेनतां ई कसम खाई, “यहोवारे ज़िन्दगरी कसम, दाऊद मारो न गालो।” <verse eid="1SA 19:6" /><verse number="7" style="v" sid="1SA 19:7" />बादे मां योनाताने दाऊद कुजेइतां इना सब गल्‍लां तैस सेइं ज़ोईं। फिरी योनाताने दाऊद शाऊले कां नियो, ते तै पेइलेरो ज़ेरो तैसेरी सेवा केरने लगो।<verse eid="1SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 19:8" />तैखन फिरी लड़ाई भोने लगी; ते दाऊद गेइतां पलिश्ती सेइं लड़ो, ते तैना बड़े मारे, ते तैना तैसेरे सामनेरां नेश्शी जे। <verse eid="1SA 19:8" /><verse number="9" style="v" sid="1SA 19:9" />पन एक्सां ज़ैखन शाऊल घरे मां बिशोरो थियो; तैखन यहोवारे तरफां अक दुष्ट आत्मा शाऊले पुड़ अई ते दाऊद शाऊलेरे लेई सितार बज़ेई राहोरो थियो। <verse eid="1SA 19:9" /><verse number="10" style="v" sid="1SA 19:10" />शाऊले चावं, कि दाऊदे एन्च़रे भाले सेइं बाहे कि भालो तैस डुबतां कंथी मां डुब्बी गाए; पन दाऊद शाऊलेरे सामनेरां एन्च़रे नश्शो कि भालो गेइतां कंथी मां डुब्बी जेव। ते दाऊद नश्शो, ते तैस राती बेंच़ी जेव।<verse eid="1SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 19:11" />तैखन शाऊले दाऊदेरे घरे सिपाही एल्हेरेलेइ भेज़े कि तैना तैसेरी ताकी मां रान, ते झ़ेझ़ां तैस मारन, पन दाऊदेरी लाड़ी मीकलां तैना लेइतां तै खबरदार कियो, “अगर तू इस राती अपने प्राण न बच़ालो, त झ़ेझ़ां मारो गानोस।” <verse eid="1SA 19:11" /><verse number="12" style="v" sid="1SA 19:12" />तैखन मीकलां दाऊद दैरी मरां उसालो; ते तै नेशतां बेच़ी जेव। <verse eid="1SA 19:12" /><verse number="13" style="v" sid="1SA 19:13" />तैखन मीकलां कुल देबतेरी मूरती नेइतां खट्टी पुड़ रख्खी, ते छ़ेल्‍ली केरि ज़ड़ां केरो शिरहानो बनेइतां तैसेरे शिरेइंते पुड़ रेखतां तै च़ादरी सेइं ढक्‍की। <verse eid="1SA 19:13" /><verse number="14" style="v" sid="1SA 19:14" />ज़ैखन शाऊले फिरी दाऊदे ट्लानेरे लेई सिपाही भेज़े, तैखन मीकल ज़ोने लगी, “तै त बिमारे।” <verse eid="1SA 19:14" /><verse number="15" style="v" sid="1SA 19:15" />तैखन शाऊले दूत दाऊदे हेरने भेज़े, ते ज़ोवं, “तैस खट्टी समेत मीं कां आनां कि अवं तैस मैरी।” <verse eid="1SA 19:15" /><verse number="16" style="v" sid="1SA 19:16" />ज़ैखन दूत अन्तर जे, तैखन कुन हेरतन कि खट्टी पुड़ कुल देबतेरी मूरती, ते शिरेइंते पुड़ छ़ेल्‍ली केरि ज़ड़ां केरो शिरहानो आहे, <verse eid="1SA 19:16" /><verse number="17" style="v" sid="1SA 19:17" />ते शाऊले मीकली पुछ़ू, “तीं मीं सेइं एरहो धोखो किजो कियो? तीं मेरो दुश्मन एन्च़रे किजो गाने दित्तो कि तै बेच़ी जेव?” मीकलां शाऊले सेइं ज़ोवं, “तैनी मीं सेइं ज़ोवं, मीं गाने दे; नईं त अवं तीं मारेलो।”<verse eid="1SA 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 19:18" />दाऊद नेशतां बेच़ी जेव, ते रामाह नगरे मां शमूएले कां पुज़तां ज़ैन किछ शाऊले तैस सेइं कियोरू थियूं सब तैस सेइं ज़ोइतां शुनावं। तैखन तै ते शमूएल गेइतां नबायोत नंव्वेरे ठैरी<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="fq" closed="false">नबायोत नंव्वेरे ठैरी </char><char style="ft" closed="false">नेबी केरे समाजे मां राने लगे।</char></note> राने लगे। <verse eid="1SA 19:18" /><verse number="19" style="v" sid="1SA 19:19" />ज़ैखन शाऊले ई खबर मैल्ही कि दाऊद रामाह नगरे मां नबायोते मांए, <verse eid="1SA 19:19" /><verse number="20" style="v" sid="1SA 19:20" />तैखन शाऊले दाऊदे ट्लेइतां आन्नेरे लेई दूत भेज़े ते ज़ैखन शाऊलेरे दूतेइं नेबी केरो जथो नबूवत केरते ते शमूएल तैन केरो प्रधान बनोरोए, तैखन परमेशरेरो आत्मा शाऊलेरे दूतन पुड़ भी अव, ते तैना भी नबूवत केरने लगे। <verse eid="1SA 19:20" /><verse number="21" style="v" sid="1SA 19:21" />ज़ैखन शाऊले इस गल्‍लरो पतो दित्तो तैखन तैने होरे किछ सिपाही भेज़े, ते तैना भी नबूवत केरने लगे। फिरी शाऊले ट्लेइयोवं बार किछ सिपाही भेज़े, ते तैना भी नबूवत केरने लगे। <verse eid="1SA 19:21" /><verse number="22" style="v" sid="1SA 19:22" />आखरकार तै एप्पु रामाह नगरे जो च़लो, ते तैस बड्डे गढे पुड़ ज़ै सेकू नगरे मांए पुज़तां पुछ़ने लगो, “शमूएल ते दाऊद कोड़िए?” केन्चे ज़ोवं कि, “तै त रामाह नगरे मां नबायोते मांए।” <verse eid="1SA 19:22" /><verse number="23" style="v" sid="1SA 19:23" />तैखन तै रामाह मां नबायोते जो च़लो; ते परमेशरेरो आत्मा तैस पुड़ भी अव, ते तै रामाह नगरे मां नेबी केरे ड्लाव्वें मां पुज़ने तगर नबूवत केरतो च़लो जेव। <verse eid="1SA 19:23" /><verse number="24" style="v" sid="1SA 19:24" />ते तैनी भी अपना लिगड़ां खोल्‍लां, ते शमूएलेरे सामने नबूवत केरने लगो, ते ज़मीनी पुड़ बिछ़ड़तां रात दिहैड़ी नग्गो पेवरो राव। एस वजाई सेइं ई कहावत च़ली, “कुन शाऊल भी नबूवत केरनेबालन मरांए?”<verse eid="1SA 19:24" /></para>
  <chapter eid="1SA 19" />
  <chapter number="20" style="c" sid="1SA 20" />
  <para style="s">योनातानेरी वफादारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 20:1" />फिरी दाऊद रामाह नगरेरे नबायोते मरां नश्शो, ते योनाताने कां गेइतां ज़ोने लगो, “मीं कुन कियोरूए? मीं करां कुन पाप भोव? मीं तेरे बाजेरे नज़री मां एरहो को पाप कियोरोए, कि तै मीं मारनो चाते?” <verse eid="1SA 20:1" /><verse number="2" style="v" sid="1SA 20:2" />योनाताने तैस जुवाब दित्तो, “एरी गल नईं, तू मारो न गालो। शुन, मेरो बाजी मीं सेइं ज़ोनेरे बगैर न कोई बड्डू कम केरे ते न कोई निकड़ू; फिरी तै एरी गल मीं करां किजो छ़ुपालो? एरी कोई गल नईं।” <verse eid="1SA 20:2" /><verse number="3" style="v" sid="1SA 20:3" />पन दाऊदे कसम खेइतां ज़ोवं, “तेरो बाजी पक्‍को ज़ानते कि तेरी दयारी नज़र मीं पुड़े। ते तै सोचतो भोल्हो, कि योनाताने एस गल्‍लरो पतो न लोड़े लगोरो, एरू न भोए कि तै दुखी भोए। पन यहोवारे ज़िन्दगरी कसम ते तेरे ज़िन्दगरी कसम, इस मां कोई शक नईं मेरे ते मौतरे मझ़ाटे एक्‍की कदमेरो फासलोए।” <verse eid="1SA 20:3" /><verse number="4" style="v" sid="1SA 20:4" />योनाताने दाऊदे सेइं ज़ोवं, “ज़ैन किछ तेरो मन चाहे तैन्ने अवं तेरे लेई केरेलो।” <verse eid="1SA 20:4" /><verse number="5" style="v" sid="1SA 20:5" />दाऊदे योनाताने सेइं ज़ोवं, “शुन कालां अस नंव्वी चैंदनरू तिहार मनामेले, ते मेरे लेई ज़रूरी कि राज़े सेइं साथी बिशतां रोट्टी खेइं; पन तू मीं भेज़, ते अवं ट्लेईदी ड्लवझ़ां तगर उडारे मां छ़पोरो रालो। <verse eid="1SA 20:5" /><verse number="6" style="v" sid="1SA 20:6" />अगर तेरो बाजी मीं पुछ़े कि अवं कोड़ि आईं, त ज़ोइयां, ‘दाऊदे अपने नगर बैतलहम जो लूशी गांनेरे लेई मीं कां बिनती केरतां छुट्टी मग्गी; किजोकि तैड़ी तैसेरे सारे कुलेरे लेई सालेरू बलिदाने।’ <verse eid="1SA 20:6" /><verse number="7" style="v" sid="1SA 20:7" />अगर तै इन ज़ोए, ‘ठीके!’ तैखन त तेरे दासेरे लेई भलू भोल्हु; पन अगर तैस बड़ी जादे सरक एज्जे, त समझ़ा कि तैनी मीं नुकसान पुज़ानेरो इरादो कियोरोए। <verse eid="1SA 20:7" /><verse number="8" style="v" sid="1SA 20:8" />ते तू अपने दासे सेइं दयारो बर्ताव केरां, किजोकि तीं यहोवारी कसम खुवेइतां अपने दासे सेइं एप्पु करार कियोरोए। पन अगर मीं करां कोई पाप भोवरो भोए, त तू एप्पु मीं मार। तू मीं अपने बाजी कां किजो पुज़ास?” <verse eid="1SA 20:8" /><verse number="9" style="v" sid="1SA 20:9" />योनाताने ज़ोवं, “एरी गल कधी न भोल्ही! अगर मीं पक्‍को पतो भोथो कि मेरे बाजे तीं नुकसान पुज़ानेरो इरादो कियोरोए, त कुन अवं तीं सेइं न ज़ोइयेथो?” <verse eid="1SA 20:9" /><verse number="10" style="v" sid="1SA 20:10" />दाऊदे योनाताने सेइं ज़ोवं, “अगर तेरो बाजी तीं सखत जुवाब दे, त कौन मीं सेइं ज़ोलो?” <verse eid="1SA 20:10" /><verse number="11" style="v" sid="1SA 20:11" />योनाताने दाऊदे सेइं ज़ोवं, “च़ल अस उडारे मां गाम।” ते तैना दूईये उडारेरे पासे च़ले जे।<verse eid="1SA 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 20:12" />तैखन योनातान दाऊदे सेइं ज़ोने लगो, “इस्राएलेरे परमेशर यहोवारी कसम, ज़ैखन मीं कालां या ट्लेईदी इस्से मौके अपने बाजेरो पतो लगे, तैखन अगर दाऊदेरी भलियाई लेहीं, त कुन अवं तैस्से वक्ते तीं कां दूत भेज़तां तीं सेइं न ज़ोइलो? <verse eid="1SA 20:12" /><verse number="13" style="v" sid="1SA 20:13" />अगर मेरे बाजी केरो मन तेरो नुकसान केरनेरे लेई भोए, ते अवं तीं पुड़ तैन बांदू केरतां तीं न भेज़ेलो कि सुखे सेइं च़लो गेइयां, त यहोवा योनाताने सेइं एरू बल्के एस करां भी जादे केरे। यहोवा तीं सेइं तेरहो राए ज़ेन्च़रे तै मेरे बाजी सेइं साथी राव। <verse eid="1SA 20:13" /><verse number="14" style="v" sid="1SA 20:14" />ते न सिर्फ ज़ैखन तगर अवं ज़ींतो रेईं, तैखन तगर मीं पुड़ यहोवारी ज़ेरि महरबानी केरां, ताके अवं न मेरि। <verse eid="1SA 20:14" /><verse number="15" style="v" sid="1SA 20:15" />त मेरे घराने पुड़ेरां भी अपनि दयारी नज़र कधी नईं दूर केरनी! बल्के ज़ैखन यहोवा दाऊदेरे हर एक्‍की दुश्मने धेरती पुड़ेरां नाश केरेलो, तैखन भी एरू न केरां।” <verse eid="1SA 20:15" /><verse number="16" style="v" sid="1SA 20:16" />एन्च़रां सेइं योनाताने दाऊदेरे घराने सेइं इन ज़ोइतां करार कियो, “यहोवा दाऊदेरे दुश्मन्न करां बदलो ने।” <verse eid="1SA 20:16" /><verse number="17" style="v" sid="1SA 20:17" />ते योनातान दाऊदे सेइं प्यार केरतो थियो, ते तैनी तैस फिरी कसम दित्ती। किजोकि तै तैस सेइं अपने प्राणा केरे बराबर प्यार केरतो थियो।<verse eid="1SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 20:18" />तैखन योनाताने तैस सेइं ज़ोवं, “कालां अस नंव्वी चैंदनरू तिहार मनामेले; ते तू याद कियो गालो, किजोकि तेरी कुर्सी खाली राली। <verse eid="1SA 20:18" /><verse number="19" style="v" sid="1SA 20:19" />ते तू ट्लेइयोवं दिहाड़े लूशी एज्जां, ते तैस जगाई पुड़ गेइतां ज़ैड़ी तू पेइलो छ़पोरो थियो, मतलब घोड़ां केरे ढेरे कां ड्लखोरां रेइयां ज़ैस जो एजेल भी ज़ोतन। <verse eid="1SA 20:19" /><verse number="20" style="v" sid="1SA 20:20" />तैखन अवं तैसेरे पासे, मन्ना अपने कोन्ची ठहरावरे निशाने पुड़ ट्लाई तीर मारेलो। <verse eid="1SA 20:20" /><verse number="21" style="v" sid="1SA 20:21" />फिरी अवं अपने सेवक मट्ठे इन ज़ोइतां भेज़ेलो, कि गेइतां तीरन तोपतां इरां आन। अगर अवं तैस मट्ठे सेइं साफ-साफ ज़ोईं, ‘हेर, तीर तेरे इस पासे,’ तू तैस इरां आन, त तू एज्जी गेइयां किजोकि यहोवारे ज़िन्दगरी कसम, तेरे लेई भलियाई छ़ेडतां होरू किछ न भोल्हु। <verse eid="1SA 20:21" /><verse number="22" style="v" sid="1SA 20:22" />पन अगर अवं मट्ठे सेइं ज़ोईं, ‘शुन, तीर तीं करां अग्गरे,’ त तू च़लो गेइयां, किजोकि यहोवा तू भेज़ोरोस। <verse eid="1SA 20:22" /><verse number="23" style="v" sid="1SA 20:23" />ते तैस गल्‍लरी चर्चा ज़ेसेरे बारे मां मीं ते तीं एप्पु मांमेइं की, यहोवा मेरे ते तेरे मझ़ाटे हमेशा राए।”<verse eid="1SA 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 20:24" />एल्हेरेलेइ दाऊद उडारे मां गेइतां छ़प्पो; ते ज़ैखन संगरांतरू तिहार एवरू थियूं, तैखन राज़ो रोट्टी खाने बिश्शो। <verse eid="1SA 20:24" /><verse number="25" style="v" sid="1SA 20:25" />राज़ो त पेइलेरो ज़ेरो अपने तैस तखते पुड़ बिशोरो थियो ज़ै दिवारी कां थियो; ते योनातान खड़ो भोव, ते अब्नेर शाऊलेरे नेड़े बिश्शो, पन दाऊदेरी ठारी खाली राई।<verse eid="1SA 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 20:26" />तैस दिहाड़े त शाऊल इन सोचतां च़ुप राव, कि इसेरी कोई न कोई वजा भोल्ही; तै अशुद्ध भोल्हो, पक्‍को तै शुद्ध न भोल्हो। <verse eid="1SA 20:26" /><verse number="27" style="v" sid="1SA 20:27" />फिरी नंव्वी चैंदनरे तिहारेरे दूइयोवं दिहाड़े दाऊदेरी ठारी खाली राई। आखरकार शाऊले अपने मट्ठे योनाताने पुछ़ू, “कुन वजाए कि यिशैरू मट्ठू न हीज रोट्टी खाने एवरू थियूं, ते न अज़ एवरूए?” <verse eid="1SA 20:27" /><verse number="28" style="v" sid="1SA 20:28" />योनाताने शाऊले सेइं ज़ोवं, “दाऊदे त बैतलहम नगरे जो गाने लेई मीं कां बिनती केरतां छुट्टी मग्गी; <verse eid="1SA 20:28" /><verse number="29" style="v" sid="1SA 20:29" />ते ज़ोने लग्गो, ‘मीं गाने दे; किजोकि तैड़ी नगरे मां इश्शे कुले बलिदान देनूए, ते मेरे ढ्लाए मीं तैड़ी हाज़र भोनेरो हुक्म दित्तोरोए। ते हुनी अगर मीं पुड़ तेरे दयारी नज़र भोए, त मीं गाने दे कि अवं अपने ढ्लान सेइं मिलतां एज्जी।’ एस्से वजाई सेइं तै राज़ेरे मेज़े पुड़ नईं एवरो।”<verse eid="1SA 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 20:30" />तैखन शाऊल योनाताने जो सेरकोव ते तैनी तैस सेइं ज़ोवं, “हे बुरे राज द्रोही अम्मरे मट्ठां, कुन अवं न ज़ैनी कि तेरो मन त यिशैरे मट्ठे पुड़ लगोरोए? एस सेइं तेरी उमीद ट्लुटेली ते तेरी अम्मरी आदर न भोल्ही। <verse eid="1SA 20:30" /><verse number="31" style="v" sid="1SA 20:31" />किजोकि ज़ैखन तगर यिशैरू मट्ठू ज़ींतू रालू, तैखन तगर तू इस रियासती पुड़ राज़ो न बेनि सकस। एल्हेरेलेइ हुनी समाद भेज़तां तैस मीं कां आन, किजोकि पक्‍को तै मारो गालो।” <verse eid="1SA 20:31" /><verse number="32" style="v" sid="1SA 20:32" />योनाताने अपने बाजी शाऊले जुवाब देइतां तैस सेइं ज़ोवं, “तै किजो मारो गाए? तैनी कुन कियोरूए?” <verse eid="1SA 20:32" /><verse number="33" style="v" sid="1SA 20:33" />तैखन शाऊले तैस मारनेरे लेई तैस पुड़ भालो च़लाव, पन तैस पुड़ न बज़्ज़ो; एस गल्‍ली सेइं योनाताने बुझ़ू, कि मेरे बाजे दाऊद मारनो थापोरोए। <verse eid="1SA 20:33" /><verse number="34" style="v" sid="1SA 20:34" />तैखन योनाताने बड़ी सरक अई ते मेज़े पुड़ेरां खड़ो भोइ जेव, तैस दिहाड़े तैने किछ न खावं ते संगरांतरे तिहारेरे दूइयोवं दिहाड़े रोट्टी खाई, किजोकि तै बड़ो दुखी भोइ जेव, एल्हेरेलेइ कि तैसेरे बाजे दाऊदेरी बेज़ती कियोरी थी।<verse eid="1SA 20:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1SA 20:35" />होरसां झ़ेझ़ां योनातान अक निकड़ू मट्ठू साथी नेइतां उडारे मां दाऊदे सेइं ठहरेवरी ठारी पुड़ जेव। <verse eid="1SA 20:35" /><verse number="36" style="v" sid="1SA 20:36" />तैखन तैनी तैस मट्ठे सेइं ज़ोवं, “दौड़तां ज़ै-ज़ै तीर अवं च़लेइलो तैस तोपतां आन।” मट्ठू दौड़ेरू थियूं, कि तैनी अक तीर तैस करां अग्रोवं च़लाव। <verse eid="1SA 20:36" /><verse number="37" style="v" sid="1SA 20:37" />ज़ैखन मट्ठू योनातानेरे च़लेवरे तीरेरी जगाई पुड़ पुज़्ज़ू, तैखन योनाताने तैस जो हक देइतां ज़ोवं, “तीर त तेरे उस पासे।” <verse eid="1SA 20:37" /><verse number="38" style="v" sid="1SA 20:38" />फिरी योनाताने मट्ठे जो पुतोरां हक देइतां ज़ोवं, “जल्दी केर, रुक न।” ते तैन मट्ठू योनाताने कां तीर अकोट्ठे केरतां तैस कां घिन्तां जेवं। <verse eid="1SA 20:38" /><verse number="39" style="v" sid="1SA 20:39" />एसेरो त किछ भी भेद मट्ठू न थियूं ज़ानतू; सिर्फ योनातान ते दाऊद एस गल्‍ली ज़ानते थिये। <verse eid="1SA 20:39" /><verse number="40" style="v" sid="1SA 20:40" />योनाताने तीर ते धनुष मट्ठे कां देइतां ज़ोवं, “गा, एन्न गिबा नगरे मां पुज़ा।” <verse eid="1SA 20:40" /><verse number="41" style="v" sid="1SA 20:41" />ज़ेरू मट्ठू जेवं, तेरो दाऊद घोड़ां केरे ढेरेरे पासे दक्षिण पासेरां निस्सो, ते तुत्तरेरे भारे ज़मीनी पुड़ झुकतां ट्लाई बार झुको; तैखन तैनेईं एक्‍की होरि फुम्मड़ी दित्ती, ते दूइयेईं लेरां दित्ती, पन दाऊदे जादे लेरां दित्ती। <verse eid="1SA 20:41" /><verse number="42" style="v" sid="1SA 20:42" />तैखन योनाताने दाऊदे सेइं ज़ोवं, “सुखे सेइं च़लो गा; किजोकि असेईं दूइयेईं एक्‍की होरि सेइं एन ज़ोइतां यहोवारे नंव्वेरी कसम खाई, कि यहोवा मेरे ते तेरे मझ़ाटे, ते मेरे ते तेरे खानदानेरे मझ़ाटे हमेशा राए।” तैखन दाऊद उठतां च़लो जेव; ते योनातान नगरे मां जेव।<verse eid="1SA 20:42" /></para>
  <chapter eid="1SA 20" />
  <chapter number="21" style="c" sid="1SA 21" />
  <para style="s">दाऊद ते पवित्र रोट्टी</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 21:1" />दाऊद तैट्ठां च़ेलतां नोब नगरे मां अहीमेलेक याजके कां अव; ते अहीमेलेक दाऊदे सेइं मिलनेरे लेई थरकतो निस्सो, ते तैस पुछ़ू, “कुन वजा आहे कि तू अकैल्‍लो आस, ते तीं साथी कोई नईं?” <verse eid="1SA 21:1" /><verse number="2" style="v" sid="1SA 21:2" />दाऊदे अहीमेलेक याजके सेइं ज़ोवं, “राज़े मीं अक कम केरनेरो हुक्म देइतां मीं सेइं ज़ोवं, ‘ज़ैस कम्मेरे लेई अवं तीं भेज़ताईं, ते ज़ै हुक्म अवं तीं देताईं, तै कोन्ची पुड़ बांदू न लोड़े भोवरो।’ ते मीं सिपेहिन फलाने जगाई पुड़ गांनेरे लेई ज़ोवरूए। <verse eid="1SA 21:2" /><verse number="3" style="v" sid="1SA 21:3" />हुनी तीं कां खानेरे लेई कुने? पंच़ रोट्टी, या ज़ैन किछ मैल्हे तैस मीं दे।” <verse eid="1SA 21:3" /><verse number="4" style="v" sid="1SA 21:4" />याजके दाऊदे सेइं ज़ोवं, “मीं कां आम रोट्टी त नईं, सिर्फ पवित्र रोट्टिन<note caller="+" style="f"><char style="fr" closed="false">21:4 </char><char style="fq" closed="false">पवित्र रोट्टिन </char><char style="ft" closed="false">मतलब ज़ैना रोट्टी परमेशरेरे जो हर आरामेरे दिहाड़े च़ैढ़ी गैती थी। इनां रोट्टी सिर्फ याजक खेइ सकते थी। (लैव्य. 24:5-9)</char></note> ज़ैना यहोवा जो च़ैढ़ोरिन, एत्रू भोए कि तैना जुवान कौन्शन करां अलग राहोरे भोन।” <verse eid="1SA 21:4" /><verse number="5" style="v" sid="1SA 21:5" />दाऊदे याजके जुवाब देइतां तैस सेइं ज़ोवं, “सच़्च़े कि अस ट्लाई दिहाड़ां केरे देंते कौन्शन करां अलग आम; फिरी ज़ैखन अवं आम सफरेरे लेई निसताइं, तैखन सिपाही अपनो आप पवित्र रखतन। त अज़ भी तैना ज़रूर पवित्र भोल्हे।” <verse eid="1SA 21:5" /><verse number="6" style="v" sid="1SA 21:6" />तैखन याजके तैस पवित्र रोट्टी दित्ती। किजोकि होरी रोट्टी तैड़ी न थी, सिर्फ च़ैढ़ोरी रोट्टी थी ज़ैना यहोवारे सामनेरां सल्‍ली जेवरी थी, कि तैसेरे सल्‍लनेरे दिहाड़े सज़री रोट्टी रखी गाए।<verse eid="1SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 21:7" />तैस्से दिहाड़े तैड़ी दोएग नव्वेंरो शाऊलेरो अधिकारी यहोवारे सामने हाज़र थियो; तै एदोमी ते शाऊलेरे पुहालां केरो प्रधान थियो।<verse eid="1SA 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 21:8" />फिरी दाऊदे अहीमेलेके पुछ़ू, “कुन इड़ी तीं कां कोई भालो या तलवार नईं? किजोकि मीं राज़ेरे कम्मेरी लूशी थी कि मीं न अपनि तलवार साथी आनी, ते न अपनो कोई हथियार साथी आनो।” <verse eid="1SA 21:8" /><verse number="9" style="v" sid="1SA 21:9" />याजके ज़ोवं, “हाँ, पलिश्ती गोलियत ज़ै तीं एला वैदी मां मारोरो थियो, तैसेरी तलवार कपड़े मां पलैटोरी एपोदे पत्तर रख्खोरीए; अगर तू तैस नेनी चास त ने, तैसेरे अलावा इड़ी होरो कोई हथियार नईं।” दाऊदे ज़ोवं, “तैसेरी ज़ेरि होरि कोई तलवार नईं; तैए मीं दे।”<verse eid="1SA 21:9" /></para>
  <para style="s">दाऊद गत नगरेरे पासे नशते</para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 21:10" />तैस्से दिहाड़े दाऊद तैट्ठां च़लो, ते तैस्से दिहाड़े शाऊले करां डेरतां ते नेशतां गत नगरेरे राज़े आकीशे कां जेव। <verse eid="1SA 21:10" /><verse number="11" style="v" sid="1SA 21:11" />ते आकीश राज़ेरे अधिकैरेईं तैस सेइं ज़ोवं, “कुन तै तैस मुल्खेरो राज़ो दाऊद नईं? कुन इस्राएली कौन्शेइं तैसेरे लेई नच़ते-नच़ते एक्‍की होरि सेइं साथी इन गीत न थियूं ज़ोवरू,</para>
  <para style="q" vid="1SA 21:11">‘शाऊले हज़ारेईं दुश्मन,</para>
  <para style="q" vid="1SA 21:11">ते दाऊदे लखेइं दुश्मन मारे?’”<verse eid="1SA 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 21:12" />दाऊदे इना गल्‍लां शुनी, ते गत नगरेरे राज़े आकीशे करां बड़ो डेरि जेव। <verse eid="1SA 21:12" /><verse number="13" style="v" sid="1SA 21:13" />तैखन तैनी तैन केरे सामने होरि चाल च़ली, ते तैन केरे सामने पागल ज़ेरो बेनि जेवं; ते फाटकेरे दारन पुड़ लकीरां देने, ते एपनी ढ्लेजां एपनी दैढ़ी उन्ढी बिछ़ोड़ने लगो। <verse eid="1SA 21:13" /><verse number="14" style="v" sid="1SA 21:14" />तैखन आकीशे अपने अधिकैरन सेइं ज़ोवं, “हेरा, तै मैन्हु त पागले; तुसेईं तै मीं कां किजो आनो? <verse eid="1SA 21:14" /><verse number="15" style="v" sid="1SA 21:15" />कुन मीं कां पागलां केरि किछ कमीए, कि तुसेईं तै मेरे सामने पागलपन केरनेरे लेई आनोरोए? कुन अवं एरे मैन्हु अपने मेहले मां रेखी?”<verse eid="1SA 21:15" /></para>
  <chapter eid="1SA 21" />
  <chapter number="22" style="c" sid="1SA 22" />
  <para style="s">शाऊलेरे ज़िरिये याजक मारने</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 22:1" />दाऊद गत नगरेरां च़लो, ते बेच़तां अदुल्‍लाम नगरेरी कुढी मां पुज़्ज़ो; एन शुन्तां तैसेरे ढ्ला, ते तैसेरे बाजेरू सारू टब्बर तैड़ी तैस कां जेवं। <verse eid="1SA 22:1" /><verse number="2" style="v" sid="1SA 22:2" />ते ज़ेत्रे मुश्किली मां पेवरे थिये, ते ज़ेत्रे कर्ज़दार थिये, ते ज़ेत्रे उदास थिये तैना सारे तैस कां अकोट्ठे भोए; ते तै तैन केरो प्रधान भोव। ते लगभग 400 मैन्हु तैस सेइं साथी भोए।<verse eid="1SA 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 22:3" />तैट्ठां दाऊद मोआबेरे मिस्पे नगरे जो गेइतां मोआबेरे राज़े सेइं ज़ोवं, “मेरे अम्मा बाजी एप्पु कां तैखन तगर राने दे, ज़ैखन तगर अवं इन न सेमझ़ी कि परमेशर मेरे लेई कुन केरेलो।” <verse eid="1SA 22:3" /><verse number="4" style="v" sid="1SA 22:4" />ते राज़े दाऊदे अज़ाज़त दित्ती ते तैन अपने अम्मा बाजी तैड़ी छ़डां, ते ज़ांतगर दाऊद तैस क़िले मां राव, तैखन तगर तैना मोआबेरे राज़े कां राए। <verse eid="1SA 22:4" /><verse number="5" style="v" sid="1SA 22:5" />एक्सां गाद नव्वेंरे एक्‍की नेबे दाऊदे कां एइतां ज़ोवं, “इस क़िले मां न रा; च़ल, यहूदारे प्रदेशे मां गा।” ते दाऊद च़ेलतां हेरेत जंगले मां जेव।<verse eid="1SA 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 22:6" />एक्सां शाऊले शुनू कि दाऊद ते तैसेरे सिपेही केरो पतो लेग्गी जेवरोए तैस मौके शाऊल गिबा नगरेरे पहाड़े पुड़, एक्‍की झाऊ एरे बुट्टे हैठ बिशोरो थियो, हथ्थे मां अपनो भालो ट्लेइतां बिश्शो, ते तैसेरे सब अधिकारी तैसेरे आसे-पासे खड़े थिये। <verse eid="1SA 22:6" /><verse number="7" style="v" sid="1SA 22:7" />तैखन शाऊल अपने अधिकैरन सेइं ज़ोने लगो, “हे बिन्यामीनी लोकव, शुना; कुन यिशैरू मट्ठू तुसन सेभन ऊडारां ते दाछ़री बागां देलू? कुन तै तुसन सेभन हज़ारां केरो सेनापति ते शौवां केरो सेनापति बनालो? <verse eid="1SA 22:7" /><verse number="8" style="v" sid="1SA 22:8" />तुसेईं सेभेइं मेरे खलाफ किजो साज़िश कियोरीए? ते ज़ैखन मेरे मट्ठे यिशैरे मट्ठे सेइं करार कियोरो थियो, तैखन केन्चे मीं पुड़ बांदू न कियूं; ते तुसन मरां केन्चे मेरे लेई गमगीन भोइतां मीं सेइं न ज़ोवं, कि मेरे मट्ठे मेरो सेवके मेरे खलाफ एन्च़रे घात लानेरे लेई भड़कव, ज़ेरू अज़्ज़ेरे दिहाड़े आहे।” <verse eid="1SA 22:8" /><verse number="9" style="v" sid="1SA 22:9" />तैखन एदोमी दोएगे, ज़ै शाऊलेरे अधिकैरन सेइं साथी खड़ो थियो, जुवाब देइतां ज़ोवं, “मीं त यिशैरे मट्ठे नोब नगरे मां अहीतूबेरां मट्ठां अहीमेलेके कां एइतू लावं, <verse eid="1SA 22:9" /><verse number="10" style="v" sid="1SA 22:10" />ते अहीमेलेके दाऊदेरे लेई यहोवा पुछ़ू, ते तैस खानेरी चीज़ां दित्ती, ते पलिश्ती गोलियतेरी तलवार भी दित्ती।”<verse eid="1SA 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 22:11" />इन शुन्तां शाऊल राज़े अहीतूबेरे मट्ठे अहीमेलेक याजक ते तैसेरे बाजी केरे सारे टब्बरे जो, मतलब नोब नगरे मां रानेबाले याजक कुजाए; ते ज़ैखन तैना सभे शाऊल राज़े कां आए, <verse eid="1SA 22:11" /><verse number="12" style="v" sid="1SA 22:12" />तैखन शाऊले ज़ोवं, “हे अहीतूबेरां मट्ठां, शुन,” तैने ज़ोवं, “हे मालिक, कुन हुक्मे?” <verse eid="1SA 22:12" /><verse number="13" style="v" sid="1SA 22:13" />शाऊले तैस पुछ़ू, “कुन वजाए कि तीं ते यिशैरे मट्ठे दूइयेईं मेरे खलाफ साज़िश कियोरीए? तीं तैस रोट्टी ते तलवार दित्ती, ते तैसेरे लेई परमेशरे पुछ़ू भी, ज़ैस सेइं तै मेरे खलाफ खड़ो भोए, ते एन्च़रे घात लाए ज़ेरू अज़्ज़ेरे दिहाड़े?” <verse eid="1SA 22:13" /><verse number="14" style="v" sid="1SA 22:14" />अहीमेलेके, राज़े जुवाब दित्तो “तेरे सारे सेवकन मरां दाऊदेरे बराबर भरोसेरे काबल कौने? तै त राज़ेरो ज़माइये, ते तेरे राज़दरबारे मां हाज़र भोइयां केरते, ते तेरे घराने मां आदरारे काबले। <verse eid="1SA 22:14" /><verse number="15" style="v" sid="1SA 22:15" />कुन मीं अज़्ज़े तैसेरे लेई परमेशरे करां पुछ़नू शुरू कियोरूए? तै मीं करां दूर राए! राज़ो न अपने दासे पुड़ एरहो कोई दोष लाए, न मेरे बाजी केरे सारे घराने पुड़, किजोकि तेरो दास इन सब गल्‍लां केरे बारे मां किछ भी न ज़ाने।” <verse eid="1SA 22:15" /><verse number="16" style="v" sid="1SA 22:16" />पन राज़े तैस सेइं ज़ोवं, “हे अहीमेलेक, तू ते तेरे बाजेरो सारो घरानो ज़रूर मारो गालो।” <verse eid="1SA 22:16" /><verse number="17" style="v" sid="1SA 22:17" />फिरी राज़े तैन सिपेहिन ज़ैना तैसेरे आसे-पासे खड़े थिये हुक्म दित्तो, “बेदलोथ ते यहोवारे याजकन मारा; किजोकि तैनेईं भी दाऊदेरी मद्दत कियोरीए, ते तैसेरू नश्शनू शुन्तां भी मीं पतो न दित्तो।” पन राज़ेरे सिपाही यहोवारे याजक लोकन मारनेरे लेई हथ अग्रोवं केरनो न थिये चाते। <verse eid="1SA 22:17" /><verse number="18" style="v" sid="1SA 22:18" />तैखन राज़े, दोएगे सेइं ज़ोवं, “तू मुड़तां याजकन मार।” तैखन एदोमी दोएगे फिरतां याजक मारे, ते तैस दिहाड़े सने सेइं बनोरे एपोद लगोरे 85 याजक मारे। <verse eid="1SA 22:18" /><verse number="19" style="v" sid="1SA 22:19" />ते याजकां केरो नगर नोब तैनी कौन्शां मड़द, ते बाल-बच्‍चन, ते दुद्ध पीते बच्‍चे, ते दांत, गधे, ते भैड्डां-छ़ेल्‍ली भी तलवारी सेइं मारे।<verse eid="1SA 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 22:20" />पन अहीतूबेरे मट्ठे अहीमेलेकेरू मट्ठू बेच़ी जेव, ज़ेसेरू नवं एब्यातार थियूं। ते तैन दाऊदे कांजो नश्शू। <verse eid="1SA 22:20" /><verse number="21" style="v" sid="1SA 22:21" />तैखन एब्यातारे दाऊदे सेइं ज़ोवं, कि शाऊले यहोवारे याजक मारोरेन। <verse eid="1SA 22:21" /><verse number="22" style="v" sid="1SA 22:22" />ते दाऊदे एब्यातारे सेइं ज़ोवं, “ज़ैस दिहाड़े एदोमी दोएग नोब नगरे मां थियो, तैस्से दिहाड़े मीं समझ़ोरू थियूं, कि तै ज़रूर शाऊले सेइं ज़ोलो। कि तेरे सारे घराने मारे गानेरी वजा अव्वें आईं। <verse eid="1SA 22:22" /><verse number="23" style="v" sid="1SA 22:23" />एल्हेरेलेइ तू मीं सेइं साथी निडर रा; ज़ै मीं मारनो चाते तैए तीं भी मारनो चाते; पन मीं सेइं साथी राने सेइं तेरी जान बच़ेली।”<verse eid="1SA 22:23" /></para>
  <chapter eid="1SA 22" />
  <chapter number="23" style="c" sid="1SA 23" />
  <para style="s">दाऊद कीला नगरेरी रक्षा केरते</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 23:1" />एक्सां किछ लोकेईं दाऊदे सेइं ज़ोवं कि पलिश्ती सिपाही कीला नगरे सेइं लड़ाई केरि राहोरेन, ते खलाड़न मरां अन्न लूटी राहोरेन। <verse eid="1SA 23:1" /><verse number="2" style="v" sid="1SA 23:2" />तैखन दाऊदे यहोवा पुछ़ू, “कुन अवं गेइतां पलिश्तन मैरी?” यहोवा दाऊदे सेइं ज़ोवं, “गा, ते पलिश्ती लोकन मार ते कीला नगरे बच़ा।” <verse eid="1SA 23:2" /><verse number="3" style="v" sid="1SA 23:3" />पन दाऊदेरे सिपैहेईं तैस सेइं ज़ोवं, “अस त इस यहूदा प्रदेशे मां भी डेरतां रहतम, अगर अस कीला नगरे मां गेइतां पलिश्ती केरि सेनारो मुकाबलो केरम, त कुन अस होरे भी जादे न डरेले?” <verse eid="1SA 23:3" /><verse number="4" style="v" sid="1SA 23:4" />तैखन दाऊदे फिरी यहोवा पुछ़ू, ते यहोवा तैस ई जुवाब दित्तो: “हिम्मत केरतां कीला नगरे जो गा; किजोकि अवं पलिश्ती तेरे हथ्थे मां देलो।” <verse eid="1SA 23:4" /><verse number="5" style="v" sid="1SA 23:5" />एल्हेरेलेइ दाऊद अपने सिपेहिन साथी नेइतां कीला नगरे जो जेव, ते पलिश्तन सेइं लेड़तां बड़े पलिश्ती मारे, ते तैन केरे जानबर ट्लेइतां आने। एन्च़रे सेइं दाऊदे कीला नगरेरे रानेबाले बच़ाए।<verse eid="1SA 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 23:6" />ज़ैखन अहीमेलेकेरू मट्ठू एब्यातार दाऊदे कां कीला नगरे जो नश्शोरू थियूं, तैखन तैन हथ्थे मां एपोद नेइतां जेवरू थियूं।<verse eid="1SA 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 23:7" />तैखन शाऊले ई खबर मैल्ही कि दाऊद कीला नगरे जो जेवरोए। ते शाऊले ज़ोवं, “परमेशरे तै मेरे हथ्थे मां कियोरोए; तै त मज़बूत फाटक ते उच्‍ची दिवारन बाले नगरे मां गेइतां बन्द भोइ जेवरोए।” <verse eid="1SA 23:7" /><verse number="8" style="v" sid="1SA 23:8" />तैखन शाऊले अपनि सारी सेना लड़ाई केरनेरे लेई कुजाई, कि कीला नगरे मां गेइतां दाऊद ते तैसेरे सिपेहिन घेरन। <verse eid="1SA 23:8" /><verse number="9" style="v" sid="1SA 23:9" />तैखन दाऊदे समझ़ू कि शाऊल मेरो नुकसान केरनेरी योजना केरि राहोरो थियो; एल्हेरेलेइ तैनी एब्यातार याजके सेइं ज़ोवं, “एपोदे मीं कां आन।” <verse eid="1SA 23:9" /><verse number="10" style="v" sid="1SA 23:10" />तैखन दाऊदे प्राथना की, “हे इस्राएलेरे परमेशर यहोवा, तेरे दासे सच़्च़े शुनेरूए कि शाऊल मेरे वजाई सेइं कीला नगर नाश केरने एजनू चाते। <verse eid="1SA 23:10" /><verse number="11" style="v" sid="1SA 23:11" />कुन कीला नगरेरे लोक मीं तैसेरे कब्ज़े मां केरेले? कुन ज़ेन्च़रे तेरे दासे शुनेरूए, तेन्च़रे शाऊल एज्जेलो? हे इस्राएलेरे परमेशर यहोवा, अपने दासे इन ज़ो।” यहोवा ज़ोवं, “हाँ, तै एज्जेलो।” <verse eid="1SA 23:11" /><verse number="12" style="v" sid="1SA 23:12" />फिरी दाऊदे पुछ़ू, “कुन कीला नगरेरे लोक मीं ते मेरे सिपाही शाऊलेरे कब्ज़े मां केरेलो?” यहोवा जुवाब दित्तो, “हाँ, तैना केरेले।” <verse eid="1SA 23:12" /><verse number="13" style="v" sid="1SA 23:13" />तैखन दाऊद ते तैसेरे सिपाही ज़ैना लगभग 600 थिये, कीला नगरे मरां निस्सी जे, ते इरां-उरां होरे ज़ैड़ी कोन्च गेइ सखते थिये तैड़ी जे। ते ज़ैखन शाऊले ई खबर दित्ती जेई कि दाऊद कीला नगरे मरां निस्सी जेवरोए, तैखन तैनी तैड़ी गानेरो विचार छ़ेडी दित्तो।<verse eid="1SA 23:13" /></para>
  <para style="s">दाऊद एनगदी एरे क़िलन मां</para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 23:14" />तैखन दाऊद जंगलेरे क़िलन मां राने लगो, ते पहाड़ी प्रदेशेरे जीप नंव्वेरे जंगले मां राव। ते शाऊल तैस रोज़ तोपतो राव, पन यहोवा तै तैसेरे हथ्थे मां न दित्तो एजने। <verse eid="1SA 23:14" /><verse number="15" style="v" sid="1SA 23:15" />ते दाऊदे समझ़ू कि शाऊल मीं मारनो चाते। ते दाऊद जीप नंव्वेरे सुनसान ठारारे होरेश<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="fq" closed="false">होरेश </char><char style="ft" closed="false">या होरेश नगरे मां</char></note> नंव्वेरे ठारी मां थियो; <verse eid="1SA 23:15" /><verse number="16" style="v" sid="1SA 23:16" />पन शाऊलेरू मट्ठू योनातान उठतां तैस कां होरेशे मां जेव, ते तैस हिम्मत दित्ती कि परमेशर तेरी रक्षा केरेलो। <verse eid="1SA 23:16" /><verse number="17" style="v" sid="1SA 23:17" />योनाताने तैस सेइं ज़ोवं, “डर न; किजोकि तू मेरे बाजी शाऊलेरे हथ्थे मां न पेलो; ते तू इस्राएलेरो राज़ो भोल्हो, ते अवं तेरे अधीन भोल्हो; ते ऐह गल मेरो बाजी शाऊल भी ज़ानते।” <verse eid="1SA 23:17" /><verse number="18" style="v" sid="1SA 23:18" />तैखन तैन दूईयेईं यहोवारी कसम खेइतां एक्‍की होरि सेइं करार कियो; तैखन दाऊद होरेशे मां रुको, ते योनातान अपने घरे च़लो जेव।<verse eid="1SA 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 23:19" />तैखन जीप नगरेरे लोक गिबा नगरे मां शाऊले कां गेइतां ज़ोने लगे, “दाऊद त असन कां होरेशेरे क़िलन मांए, मतलब तैस हकीला नव्वेंरी पहैड़ी पुड़ छ़पोरो रहते, ज़ै यशीमोनेरे<note caller="+" style="f"><char style="fr" closed="false">23:19 </char><char style="fq" closed="false">यशीमोन</char><char style="ft" closed="false">इस जो यहूदारी सुनसान ठार भी ज़ोतन। </char></note> दक्षिणेरे पासे। <verse eid="1SA 23:19" /><verse number="20" style="v" sid="1SA 23:20" />एल्हेरेलेइ हुनी, हे राज़ा, ज़ैखन तू चातस तैखन एज्जी सकतस; ते तैस अस ट्लुवामेले” <verse eid="1SA 23:20" /><verse number="21" style="v" sid="1SA 23:21" />शाऊले ज़ोवं, “यहोवारी बरकत तुसन पुड़ भोए, किजोकि तुसेईं मीं पुड़ दया कियोरीए। <verse eid="1SA 23:21" /><verse number="22" style="v" sid="1SA 23:22" />तुस च़ेलतां हेजू भी पक्‍को पतो केरा; ते हेरजाच केरा, ते तैसेरे रानेरो पतो केरा कि तै तैड़ी केनि लाहोरोए; किजोकि केन्चे मीं सेइं ज़ोवरूए, कि तै बेड़ी च़लैकी सेइं कम केरते। <verse eid="1SA 23:22" /><verse number="23" style="v" sid="1SA 23:23" />एल्हेरेलेइ ज़ैड़ी कोन्च तै छ़पोरो रहते तैना सब ठारन हेरतां पिशाना, फिरी पक्‍को पतो केरतां मीं कां वापस एज्जा। ते अवं तुसन सेइं साथी च़लेलो, ते अगर तै तैस प्रदेशे मां कोन्च भी भोए, त अवं तैस यहूदारे हज़ारन मरां तोपतां कढेलो।”<verse eid="1SA 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 23:24" />तैखन तैना लोक च़ेलतां शाऊले करां पेइले जीप नगरे जो जे। पन दाऊद अपने लोकन समेत माओन नंव्वेरे सुनसान ठैरी मां च़ेलि जेवरो थियो, ज़ैन अराबा मां यशीमोनेरे दक्षिणेरे पासे। <verse eid="1SA 23:24" /><verse number="25" style="v" sid="1SA 23:25" />तैखन शाऊल अपने सिपेहिन साथी नेइतां तैसेरी तलाशी मां जेव। एसेरी खबर मैलतां दाऊद पहाड़े पुड़ेरां ओस्तां माओन सुनसान ठैरी मां राने लगो। इन शुन्तां शाऊले माओन सुनसान ठैरी मां दाऊदेरो पीछो कियो। <verse eid="1SA 23:25" /><verse number="26" style="v" sid="1SA 23:26" />शाऊल त पहाड़ेरे एक्‍की पासे, ते दाऊद अपने सिपेहिन समेत पहाड़ेरे होरि पासे गेइ राहोरो थियो; ते दाऊद शाऊले करां डेरतां लूशी गेइ राहोरो थियो; ते शाऊल अपने सिपेहिन समेत दाऊद ते तैसेरे जुवानन ट्लानेरे लेई घेरो देने चातो थियो, <verse eid="1SA 23:26" /><verse number="27" style="v" sid="1SA 23:27" />कि एक्‍की मैन्हे शाऊले कां एइतां ज़ोवं, “जल्दी एई; किजोकि पलिश्तेईं मुल्खे पुड़ हमलो कियोरोए।” <verse eid="1SA 23:27" /><verse number="28" style="v" sid="1SA 23:28" />इन शुन्तां शाऊल दाऊदेरो पीछो छ़ेडतां पलिश्ती केरो मुकाबलो केरनेरे लेई च़लो; एस वजाई सेइं तैस जगारू नवं सेलाहम्म-हलकोत<note caller="+" style="f"><char style="fr" closed="false">23:28 </char><char style="fq" closed="false">सेलाहम्म-हलकोत </char><char style="ft" closed="false">मतलब बच़नेरी चट्टान</char></note> पेवं। <verse eid="1SA 23:28" /><verse number="29" style="v" sid="1SA 23:29" />तैट्ठां दाऊद च़लो जेव ते एनगदी<note caller="+" style="f"><char style="fr" closed="false">23:29 </char><char style="fq" closed="false">एनगदी </char><char style="ft" closed="false">अक एरी ठार ज़ै सुनसान ठैरी मां थी ज़ैड़ी ताज़ू ते गर्म पानी थियूं।</char></note> क़िलन मां राने लगो।<verse eid="1SA 23:29" /></para>
  <chapter eid="1SA 23" />
  <chapter number="24" style="c" sid="1SA 24" />
  <para style="s">दाऊद शाऊले न मारे</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 24:1" />ज़ैखन शाऊल पलिश्ती लोकन सेइं लड़ाई केरतां वापस अव, तैखन तैस ई खबर मैल्ही, कि दाऊद एनगदी नंव्वेरे सुनसान ठैरी मांए। <verse eid="1SA 24:1" /><verse number="2" style="v" sid="1SA 24:2" />तैखन शाऊले सारे इस्राएलन मरां 3000 माहिर सिपाही तैलतां दाऊद ते तैसेरे सैथन जंगली थाव्वां केरि शफड़न मां तोप्पने जेव। <verse eid="1SA 24:2" /><verse number="3" style="v" sid="1SA 24:3" />ज़ैखन तै बत्ती मरां भैड्डां केरे बाड़े कां नेड़े पुज़्ज़ो। तैड़ी अक कुढ थी, तैखन शाऊल तैस कुढी मां बड़े अन्तर बेइरोवं बिशने मां जेव। ते तैस्से कुढरे कूने पुड़ दाऊद ते तैसेरे सिपाही छ़पोरे थिये। <verse eid="1SA 24:3" /><verse number="4" style="v" sid="1SA 24:4" />तैखन दाऊदेरे सिपैहेईं शाऊल लेइतां बल्हे सेइं ज़ोवं, “शुन, अज़ तैए दिहाड़ीए ज़ैसारे बारे मां यहोवा तीं सेइं ज़ोवरू थियूं अवं तेरे दुश्मने तेरे हथ्थे मां केरेलो कि तू तैस सेइं अपनि मेर्ज़रे मुताबिक बर्ताव केरस।” तैखन दाऊदे उठतां शाऊलेरे चोगेरो कूनेरो अक निकड़ो टुक्ड़ो छ़ेपतां कट्टो। <verse eid="1SA 24:4" /><verse number="5" style="v" sid="1SA 24:5" />एसेरे बाद दाऊदे शाऊलेरे चोगेरो कूनो कटने करां पशतावं। <verse eid="1SA 24:5" /><verse number="6" style="v" sid="1SA 24:6" />तै अपने सिपेहिन सेइं ज़ोने लगो, “यहोवा न केरे कि अवं अपने मालिके सेइं ज़ेसेरू अभिषेक यहोवारे तरफां भोवरूए एरू कम केरीं, कि तैस पुड़ अपनो हथ खड़ो केरीं, किजोकि तैसेरू अभिषेक यहोवा कियोरूए।” <verse eid="1SA 24:6" /><verse number="7" style="v" sid="1SA 24:7" />एरी गल्‍लां ज़ोइतां दाऊदे अपने सैथन समझ़ावं ते तैन्न शाऊले पुड़ हमलो केरने न दित्तो। फिरी शाऊल उठतां कुढी मरां निस्सो ते अपने बत्तां च़लो जेव।<verse eid="1SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 24:8" />तैसेरां पत्ती दाऊद भी उठतां कुढी मरां निस्सो ते शाऊले जो पुतोरां हक देइतां ज़ोवं, “हे मेरे मालिक, हे राज़ा।” ज़ैखन शाऊले पत्रोवं फिरतां तक्‍कू, तैखन दाऊदे ज़मीनी पुड़ क्रोड़ी झुकेइतां मथ्थो टेको। <verse eid="1SA 24:8" /><verse number="9" style="v" sid="1SA 24:9" />ते दाऊदे शाऊले सेइं ज़ोवं, “ज़ैना मैन्हु ज़ोतन, कि दाऊद तेरो नुकसान चाते तैन केरि तू किजो शुन्तस? <verse eid="1SA 24:9" /><verse number="10" style="v" sid="1SA 24:10" />हेर, अज़ तीं अपनि एछ़्छ़न सेइं हेरू कि यहोवा अज़ कुढी मां तू मेरे हथ्थे मां कियोरो थियो; ते किछेईं मेरे मैन्हेइं त मीं तीं मारनेरे लेई ज़ोवं, पन मीं तीं पुड़ दया अई; ते मीं ज़ोवं, ‘अवं अपने मालिके पुड़ हथ खड़ो न केरीं; किजोकि तै यहोवारो अभिषिक्ते।’ <verse eid="1SA 24:10" /><verse number="11" style="v" sid="1SA 24:11" />फिरी, हे मेरे बाजी, अपने चोगेरो अक कूनो मेरे हथ्थे मां हेर; मीं तेरे चोगेरो अक कूनो त कट्टो, पन तू न मारो; इन पक्‍कू ज़ान, कि मेरे मने मां कोई बुराई या गलत सोच नईं। मीं तेरे खलाफ कोई पाप नईं कियोरो, पन तू मीं मारनेरे लेई खड़ोस। <verse eid="1SA 24:11" /><verse number="12" style="v" sid="1SA 24:12" />यहोवा मेरो ते तेरो न्याय केरे, ते यहोवा तीं करां मेरो बदलो ने; पन मेरो हथ तीं पुड़ तेरो नुकसान केरनेरे लेई न उठेलो। <verse eid="1SA 24:12" /><verse number="13" style="v" sid="1SA 24:13" />पुराने वक्तेरी कहावतां केरे मुताबिक कि ‘बुराई बुरे लोकन करां भोतीए;’ पन मेरो हथ तीं पुड़ तेरो नुकसान केरनेरे लेई न उठेलो। <verse eid="1SA 24:13" /><verse number="14" style="v" sid="1SA 24:14" />इस्राएलेरो राज़ो केसेरो पीछो केरनेरे लेई निसोरोए? ते केस पत्ती पेवरोए? एक्‍की मरोरे कुतरे पत्ती! एक्‍की ट्लीव्वें पत्ती! <verse eid="1SA 24:14" /><verse number="15" style="v" sid="1SA 24:15" />एल्हेरेलेइ यहोवा न्यायी भोइतां मेरो ते तेरो न्याय केरे, ते विचार केरतां मेरो मुकदमो लड़े, ते न्याय केरतां मीं तेरे हथ्थे करां बच़ाए।”<verse eid="1SA 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 24:16" />ज़ैखन दाऊदे शाऊले सेइं इना गल्‍लां ज़ोई, तैखन शाऊले ज़ोवं, “हे मेरे मट्ठां दाऊद, कुन ई तेरी आवाज़े?” तैखन शाऊल ज़ोरे-ज़ोरे लेरां लगो देने। <verse eid="1SA 24:16" /><verse number="17" style="v" sid="1SA 24:17" />फिरी तैनी दाऊदे सेइं ज़ोवं, “तू मीं करां जादे धर्मीस; मीं त तीं सेइं बुराई कियोरीए, पन तीं मीं सेइं साथी भलियाई कियोरीए। <verse eid="1SA 24:17" /><verse number="18" style="v" sid="1SA 24:18" />ते तीं अज़ इन बांदू कियोरूए, कि तीं त मीं सेइं भलियाई कियोरीए, कि ज़ैखन यहोवा अवं तेरे हथ्थे मां दित्तोरो थियो, तैखन तीं अवं न मारो। <verse eid="1SA 24:18" /><verse number="19" style="v" sid="1SA 24:19" />भला! कुन कोई मैन्हु अपने दुश्मने मैलतां ज़ींतो छ़ेडतां भेज़ते? एल्हेरेलेइ ज़ैन तीं अज़ मीं सेइं कियूं, एसेरे बदले यहोवा तेरू भलू केरे। <verse eid="1SA 24:19" /><verse number="20" style="v" sid="1SA 24:20" />ते हुनी, मीं पतो लग्गो कि तू पक्‍को राज़ो बनेलो, ते इस्राएलेरी हुकूमत तेरे हथ्थे मां भोल्ही। <verse eid="1SA 24:20" /><verse number="21" style="v" sid="1SA 24:21" />हुनी मीं सेइं यहोवारी कसम खा, कि तू मेरे खानदाने मेरे बाद खतम न केरेलो, ते मेरे बाजी केरे घराने मरां मेरू नवं न मिटालो।” <verse eid="1SA 24:21" /><verse number="22" style="v" sid="1SA 24:22" />तैखन दाऊदे शाऊले सेइं एरी कसम खाइ। तैखन शाऊल अपने घरे जो जेव; ते दाऊद अपने सिपेहिन सेइं साथी अपने छ़पनेरे ठारन मांजो च़लो जेव।<verse eid="1SA 24:22" /></para>
  <chapter eid="1SA 24" />
  <chapter number="25" style="c" sid="1SA 25" />
  <para style="s">शमूएलेरी मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 25:1" />शमूएल मेरि जेव; ते सारे इस्राएली लोक अकोट्ठे भोइतां तैसेरे लेई छाती पिटने लगे, ते तैसेरे घरे मां ज़ैन रामाह नगरे मां<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="fq" closed="false">रामाह नगरे मां </char><char style="ft" closed="false">या तैसेरे घरेरे बागी मां। (2 राज़. 21:18)</char></note> थियूं तै दब्बो जेव। तैखन दाऊद उठतां पारान सुनसान ठैरी जो च़लो जेव। <verse eid="1SA 25:1" /><verse number="2" style="v" sid="1SA 25:2" />माओन नगरे मां अक मैन्हु रहतो थियो ज़ेसेरो कारोबार कर्मेल नगरे मां थियो। ते तै मैन्हु बड़ो धनी थियो, ते तैस कां 3000 भैड्डां, ते 1000 छ़ेल्‍ली थी; ते तै एपनी भैड्डां केरि उन्ना बरधांने लगोरो थियो। <verse eid="1SA 25:2" /><verse number="3" style="v" sid="1SA 25:3" />तैस मैन्हेरू नवं नाबाल थियूं, ते तैसेरी कौन्शरू नवं अबीगैल थियूं। अबीगैल त अक्लमन्द ते बड़ी खूबसूरत थी, पन नाबाल सखत, ते बुरां-बुरां कम्मां केरनेबालो थियो; तै कालेबेरे खानदाने मरां थियो। <verse eid="1SA 25:3" /><verse number="4" style="v" sid="1SA 25:4" />ज़ैखन दाऊदे सुनसान ठारी मां खबर मैल्ही, कि नाबाल एपनी भैड्डां केरि उन्ना बरधांने लगोरोए; <verse eid="1SA 25:4" /><verse number="5" style="v" sid="1SA 25:5" />तैखन दाऊदे दश जुवान तैड़ी भेज़े, ते दाऊदे तैन जुवानन सेइं ज़ोवं, “कर्मेले मां नाबाले कां गेइतां मेरी तरफां तैस सेइं तैसेरो हाल चाल पुछ़ा। <verse eid="1SA 25:5" /><verse number="6" style="v" sid="1SA 25:6" />ते तैस सेइं इन ज़ोथ, ‘तेरी उमर लम्मी भोए, तेरू भलू भोए, ते तेरू टब्बर सुखे सेइं राए, ते ज़ैन किछ तेरूए तैन सुखे सेइं राए। <verse eid="1SA 25:6" /><verse number="7" style="v" sid="1SA 25:7" />मीं शुनेरूए, कि ज़ैना तू उन्ना बरधांने लगोरोस; तेरे पुहाल असन लोकन कां राए, ते न त असेईं तैन केरो किछ नुकसान कियो, ते न तैन केरू किछ हिरावं। <verse eid="1SA 25:7" /><verse number="8" style="v" sid="1SA 25:8" />अपने पुहालन करां ऐह गल पुछ़, ते तैना तीं सेइं ज़ोले। आखरी एन जुवानन पुड़ तेरे दयारी नज़र भोए; अस त आनन्देरे मौके एवरेम, एल्हेरेलेइ महरबानी केरतां ज़ैन किछ तेरे हथ्थे मांए तैन अपने दासन ते दाऊदे जो दे ज़ैन तेरे मट्ठेरू ज़ेरूए।’”<verse eid="1SA 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 25:9" />दाऊदेरे जुवान गेइतां एना गल्‍लां तैसेरे तरफां नाबाले शुनेइतां तैसेरे जुवाबेरो इंतज़ार केरने लगे। <verse eid="1SA 25:9" /><verse number="10" style="v" sid="1SA 25:10" />नाबाले दाऊदेरे जुवानन जुवाब दित्तो, “दाऊद कौने? यिशैरू मट्ठू कौने? अज़ काल बड़े दास अपने-अपने मालिके करां नेश्शी गातन। <verse eid="1SA 25:10" /><verse number="11" style="v" sid="1SA 25:11" />कुन अवं अपनि रोट्टी-पानी ते ज़ैना जानबर मीं अपने बरधांने बालां केरे लेई मारोरेन नेइतां एरे लोकन देईं, ज़ैन अवं न ज़ैनी कि तैन केरू घर कोड़िए?” <verse eid="1SA 25:11" /><verse number="12" style="v" sid="1SA 25:12" />तैखन दाऊदेरे जुवान वापस एइतां इना सब गल्‍लां ज़ेरि तैने ज़ोवरी थी दाऊदे शुनेई। <verse eid="1SA 25:12" /><verse number="13" style="v" sid="1SA 25:13" />इना गल्‍लां शुन्तां दाऊदे अपने सिपेहिन सेइं ज़ोवं, “अपनि-अपनि तलवार बन्धा।” तैखन तैनेईं अपनि-अपनि तलवार बन्धी; ते दाऊदे भी अपनि तलवार बन्धी; ते लगभग 400 सिपाही दाऊदे पत्ती-पत्ती च़ले, ते 200 सिपाही सामाने राए।<verse eid="1SA 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 25:14" />पन नाबालेरे एक्‍की सेवके तैसेरी लैड़ी अबीगैल सेइं ज़ोवं, “दाऊदे सुनसान ठैरी मरां इश्शे मालिके आशिर्वाद देनेरे लेई दूत भेज़ोरे थिये; ते तैनी तैन केरि बेइज़्ज़ती की। <verse eid="1SA 25:14" /><verse number="15" style="v" sid="1SA 25:15" />पन तैना मैन्हु असन सेइं बड़ो रोड़ो बर्ताव रखते थिये, ते ज़ांतगर अस मैइदाने मां रहते ते तैन कां एंइते गांते रहते थिये, तांतगर न त इश्शो किछ नुकसान भोव, ते न इश्शू किछ हेरोवं; <verse eid="1SA 25:15" /><verse number="16" style="v" sid="1SA 25:16" />ज़ैखन तगर अस तैन सेइं साथी भैड्डां-छ़ेल्‍ली च़ारते राए, तैखन तगर तैना रात दिहाड़ी इश्शी हिफाज़त केरते राए। <verse eid="1SA 25:16" /><verse number="17" style="v" sid="1SA 25:17" />एल्हेरेलेइ हुनी सोच विचार कियोरो लोड़े; किजोकि तैनेईं इश्शे मालिकेरो ते तैसेरे सारे टब्बरेरो नुकसान केरनेरे लेई थापेरू भोल्हु, इश्शो मालिक त एरहो दुष्टे कि तैस सेइं कोई गल भी न केरि सखे।”<verse eid="1SA 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 25:18" />तैखन अबीगैलां लूशी 200 रोट्टी, ते दूई मसकां दाछ़रो रस, ते पंच़ भैड्डां केरू मास, ते लगभग 17 किल्‍लो अन्नेरी किछ ट्लोड़ोरी चीज़ां, ते 100 गुच्छे किशमिश, ते अंजीरेरी 200 टिकी नेइतां गधन पुड़ लदेई। <verse eid="1SA 25:18" /><verse number="19" style="v" sid="1SA 25:19" />ते अबीगैलां अपने सेवकन सेइं ज़ोवं, “तुस मीं अग्री-अग्री च़ला, अवं तुसन पत्ती-पत्ती एइतीं।” पन तै कुन केरने लगोरीए तैसां अपने मुन्शे नाबाले सेइं किछ न ज़ोवं। <verse eid="1SA 25:19" /><verse number="20" style="v" sid="1SA 25:20" />तै गधे पुड़ च़ैढ़तां पहाड़ेरी आड़ी मां ओसने लगोरी थी, ते दाऊद अपने जुवानन समेत तैसेरे सामने उतरी राहोरो थियो; ते तै तैन मैल्ही। <verse eid="1SA 25:20" /><verse number="21" style="v" sid="1SA 25:21" />दाऊदे त सोचोरू थियूं, “मीं त सुनसान ठैरी मां तैसेरे सारे मालेरी एरी हिफाज़त की कि तैसेरू किछ भी न हेरोवं, इन बेकार भोवं; किजोकि तैनी भलियाई केरनेरे बदले मीं सेइं बुराई कियोरीए। <verse eid="1SA 25:21" /><verse number="22" style="v" sid="1SA 25:22" />अगर झ़ेझ़ां लौ भोने तगर तैसेरे घराने मरां अक मट्ठू भी अवं ज़ींतू छ़ेडी, त परमेशर मीं सखते करां सखत सज़ाह दे।”<verse eid="1SA 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 25:23" />दाऊदे हेरतां अबीगैल जल्दी गधे पुड़ेरां ओस्सी, ते दाऊदेरे सामने तुत्तरेरे भारे ज़मीनी पुड़ झुकतां मथ्थो टेको। <verse eid="1SA 25:23" /><verse number="24" style="v" sid="1SA 25:24" />फिरी तै तैसेरे पव्वन पुड़ झुकतां ज़ोने लगी, “हे मेरे मालिक, ज़ै पाप मेरे मुन्शे कियो तैसेरी ज़िमेवारी अवं केरतीं; तेरी दासी तीं सेइं किछ ज़ोनू चातीए, ते तू एपनी दैसरी गल्‍लां शुन। <verse eid="1SA 25:24" /><verse number="25" style="v" sid="1SA 25:25" />मेरो मालिक तैस दुष्ट नाबाले पुड़ ध्यान न दे; किजोकि ज़ेरू तैसेरू नंव्वे तेरहो तै एप्पु भी आहे। तैसेरू नवं नाबाले, ते सच़्च़े तैस मां बेवकूफी आहे; पन मीं तेरी दैसां अपने मालिकेरे जुवान ज़ैना तीं भेज़ोरे थिये न थिये लेवरे। <verse eid="1SA 25:25" /><verse number="26" style="v" sid="1SA 25:26" />ते हुनी, हे मेरे मालिक, यहोवारे ज़िन्दगरी कसम ते तेरे ज़िन्दगरी कसम, कि यहोवाए ज़ैनी तू खून केरने ते अपने हथ्थेरे ज़िरिये अपनो बदलो नेने करां रोकतां रखोरोस, एल्हेरेलेइ हुनी तेरे दुश्मन ते मेरे मालिकेरो नुकसान चानेबाले नाबालेरे ज़ेरे भोन। <verse eid="1SA 25:26" /><verse number="27" style="v" sid="1SA 25:27" />ते हुनी ई तोफो ज़ै तेरे दैसां अपने मालिके कां आनोरोए, तैन जुवानन दित्तो गाए ज़ैना मेरे मालिके सेइं साथी च़लतन। <verse eid="1SA 25:27" /><verse number="28" style="v" sid="1SA 25:28" />एपनी दैसरो पाप माफ़ केर; किजोकि यहोवा ज़रूर मेरे मालिकेरू घर बसालो ते मज़बूत केरेलो, एल्हेरेलेइ कि मेरो मालिक यहोवारे तरफां लड़ते; ते ज़िन्दगी भर तीं मां कोई बुराई न मैल्हेली। <verse eid="1SA 25:28" /><verse number="29" style="v" sid="1SA 25:29" />ते अगर कोई मैन्हु तेरो पीछो केरने ते तीं मारनेरे लेई खड़ो भोवरोए, फिरी भी मेरे मालिकेरी जानरी हिफाज़त तेरो परमेशर यहोवा केरेलो, ज़ेन्च़रे कोई खज़ाने सुमैलतां रखते ते तेरे दुश्मना केरे प्राण एन्च़रे नाश केरेलो ज़ेन्च़रे कोई छ़िंगलोटे मां रेखतां घोड़ शारते। <verse eid="1SA 25:29" /><verse number="30" style="v" sid="1SA 25:30" />एल्हेरेलेइ ज़ैखन यहोवा मेरे मालिकेरे लेई ई सारी भलियाई केरेलो ज़ै तैनी तेरे बारे मां ज़ोवरीए, ते तीं इस्राएले पुड़ प्रधान ठहरालो, <verse eid="1SA 25:30" /><verse number="31" style="v" sid="1SA 25:31" />तैखन तीं एस वजाई सेइं पसतानू न पेलू, या मेरे मालिकेरो दिल दुखी न भोल्हो कि तीं बगैर वजां खून कियो, ते मेरे मालिके अपनो बदलो एप्पु नियो। फिरी ज़ैखन यहोवा मेरे मालिके सेइं भलियाई केरे तैखन अपने दैसी याद केरां।”<verse eid="1SA 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 25:32" />तैखन दाऊदे अबीगैली सेइं ज़ोवं, “इस्राएलेरो परमेशर यहोवारी तारीफ़ भोए, ज़ैनी अज़्ज़ेरे दिहाड़े मीं सेइं मिलनेरे लेई तू भेज़ी। <verse eid="1SA 25:32" /><verse number="33" style="v" sid="1SA 25:33" />ते तेरी समझ़रे लेई परमेशरेरी तारीफ़ भोए, कि तीं अवं अज़्ज़ेरे दिहाड़े खून केरने ते अपनो बदलो एप्पु नेने करां रोकतां रख्खो। <verse eid="1SA 25:33" /><verse number="34" style="v" sid="1SA 25:34" />किजोकि सच़्च़े इस्राएलेरो परमेशर यहोवा, ज़ैनी अवं तेरो नुकसान केरने करां रोको, तैसेरी कसम, अगर तू लूश केरतां मीं सेइं मिलने न भोथी एवरी, त इस मां कोई शक नईं झ़ेझ़ां लौ भोने तगर नाबालेरू कोई मट्ठू न थियूं बच़नू।” <verse eid="1SA 25:34" /><verse number="35" style="v" sid="1SA 25:35" />तैखन दाऊदे तैसेरी भेंट कबूल की, ज़ैन तैसां आनोरू थियूं; फिरी तैनी तैस सेइं ज़ोवं, “सुखे सेइं अपने घरे जो गा; शुन, मीं तेरी गल मन्नोरीए ते तेरी बिनती कबूल कियोरीए।”<verse eid="1SA 25:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 25:36" />तैखन अबीगैल नाबाले कांजो वापस जेई; ते कुन हेरतीए, कि तै घरे राज़ेरो ज़ेरो धाम खेइ राहोरोए। ते नाबालेरो दिले मघन भोवरोए, ते तै नशे मां मसत भोइ जेवरोए; एल्हेरेलेइ झ़ेझ़री लौ भोने करां पेइलू तैसां तैस सेइं दाऊदेरे बारे मां किछ भी न ज़ोवं। <verse eid="1SA 25:36" /><verse number="37" style="v" sid="1SA 25:37" />होरसां झ़ेझ़ां ज़ैखन नाबालेरो नशो उतरी जेव, तैखन तैसेरी कौन्शां तैस सेइं सब किछ ज़ोवं, तैखन नाबाले दिलेरो दौरो पेव, ते तै बेहोश भोइतां घोड़ेरो ज़ेरो भोइ जेव। <verse eid="1SA 25:37" /><verse number="38" style="v" sid="1SA 25:38" />ते दश दिहाड़ां केरे बाद यहोवा नाबाल मारो।<verse eid="1SA 25:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1SA 25:39" />नाबालेरो मरनेरो हाल शुन्तां दाऊदे ज़ोवं, “यहोवारी तारीफ़ भोए ज़ैनी नाबाले सेइं मेरी बेइज़्ज़तरो मुकदमो लेड़तां अपनो दास बुरैई करां रोकतां रख्खो; ते यहोवा नाबालेरी बुराई तैसेरे दोग्गे पुड़ छ़डी।” तैखन दाऊदे लोक अबीगैली कां एल्हेरेलेइ भेज़े कि तैस सेइं ड्लाह बनानेरी गल-बात केरन। <verse eid="1SA 25:39" /><verse number="40" style="v" sid="1SA 25:40" />ते ज़ैखन दाऊदेरे दास कर्मेले मां अबीगैल कां पुज़्ज़े, तैखन तैस सेइं ज़ोने लगे, “दाऊदे अस तीं कां एल्हेरेलेइ भेज़ोरेम कि तू तैसेरी लाड़ी बनस।” <verse eid="1SA 25:40" /><verse number="41" style="v" sid="1SA 25:41" />तैखन तै उठी, ते तुत्तरेरे भारे ज़मीनी पुड़ झुकतां ज़ोवं, “तेरी दासी अपने मालिकेरे दासां केरे पव धोनेरे लेई दासी बने।” <verse eid="1SA 25:41" /><verse number="42" style="v" sid="1SA 25:42" />तैखन अबीगैल लूशी उठी, ते गधे पुड़ च़ढ़ी, ते तैसारी पंच़ दैसी तैस पत्ती-पत्ती च़ेलि; ते तैना दाऊदेरे भेज़ोरे दूतन पत्ती-पत्ती जेई; ते तैसेरी लाड़ी भोइ जेई।<verse eid="1SA 25:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1SA 25:43" />ते दाऊदे यिज्रेल नगरेरी अहीनोअमी सेइं भी ड्लाह बनावरो थियो, त तैना दूईये तैसेरी लैड़ी भोइ जेई। <verse eid="1SA 25:43" /><verse number="44" style="v" sid="1SA 25:44" />पन शाऊले अपनि कुई दाऊदेरी लाड़ी मीकल लैशरे मट्ठे गल्‍लीम नगरेरे रानेबाले पलती जो ड्लेइतां दित्तोरी थी।<verse eid="1SA 25:44" /></para>
  <chapter eid="1SA 25" />
  <chapter number="26" style="c" sid="1SA 26" />
  <para style="s">दाऊदे फिरी शाऊल ज़ींतो हथरां छ़डो</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 26:1" />एक्सां फिरी जीपी लोक गिबा नगरे मां शाऊले कां गेइतां ज़ोने लगे, “कुन दाऊद तैस हकीला नव्वेंरी पहैड़ी पुड़े ज़ै यशीमोनेरे सामने छ़पोरो न राए?”<note caller="-" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="1SA 23:19">1 शमू. 23:19</ref>.</char></note> <verse eid="1SA 26:1" /><verse number="2" style="v" sid="1SA 26:2" />तैखन शाऊल उठतां इस्राएलेरे 3000 माहिर सिपाही लड़नेरे लेई साथी नेइतां जेव कि दाऊदे जीपेरे सुनसान ठैरी मां तोप्पे। <verse eid="1SA 26:2" /><verse number="3" style="v" sid="1SA 26:3" />ते शाऊले अपने डेरे बत्तरे ड्लखोरां हकीला नव्वेंरी पहैड़ी पुड़ लाए ज़ै यशीमोनेरे सामने। पन दाऊद सुनसान ठैरी मां राव; ते तैस पतो लग्गो, कि शाऊल मेरो पीछो केरतां सुनसान ठैरी मां एवरोए; <verse eid="1SA 26:3" /><verse number="4" style="v" sid="1SA 26:4" />तैखन दाऊदे जासूस भेज़तां पक्‍कू कियूं कि शाऊल सच़्च़े एज्जी राहोरोए। <verse eid="1SA 26:4" /><verse number="5" style="v" sid="1SA 26:5" />एल्हेरेलेइ दाऊद उठतां तैस जगाई पुड़ जेव ज़ैड़ी शाऊल रुकोरो थियो; ते दाऊदे तै जगाह हेरी ज़ैड़ी शाऊल ते तैसेरो सेनापति नेरेरू मट्ठू अब्नेर झ़ुलोरू थियूं, शाऊल त अपने डेरे मां झ़ुलोरो थियो ते तैसेरी सेना तैसेरे च़ेवरे पासन डेरे लेइतां झ़ुलोरी थी।<verse eid="1SA 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 26:6" />तैखन दाऊदे हित्ती अहीमेलेक ते सरूयाहेरे मट्ठे योआबेरे ढ्ला अबीशै सेइं ज़ोवं, “मीं सेइं साथी तैन डेरन मां शाऊलेरे नेड़े कौन च़लेलो?” अबीशै ज़ोवं, “तीं साथी अवं च़लेलो।” <verse eid="1SA 26:6" /><verse number="7" style="v" sid="1SA 26:7" />तैस्से राती दाऊद ते अबीशै तैन लोकन कां जे, ते कुन हेरतन कि शाऊल त अपने डेरे मां झ़ुलोरोए, ते तैसेरो भालो तैसेरे शिरेइंते तल्‍ले मां डोबोरोए; ते अब्नेर ते सेनारे जुवान तैसेरे च़ेवरे पासन झ़ुलोरेन। <verse eid="1SA 26:7" /><verse number="8" style="v" sid="1SA 26:8" />तैखन अबीशै दाऊदे सेइं ज़ोवं, “परमेशरे अज़ तेरो दुश्मन तेरे हथ्थे मां दित्तोरोए; एल्हेरेलेइ हुनी अवं तैस एक्‍की बार एरहो बैईं कि भालो तैस कोश्तां ज़मीनी मां चुभी गाए, ते मीं तैस दूइयोवं बार बानी न पे।” <verse eid="1SA 26:8" /><verse number="9" style="v" sid="1SA 26:9" />पन दाऊदे अबीशै सेइं ज़ोवं, “तैस न मैरां; किजोकि ज़ेसेरू अभिषेक यहोवा कियोरू तैस मैरतां कौन बेकसूर रेई सखते।” <verse eid="1SA 26:9" /><verse number="10" style="v" sid="1SA 26:10" />फिरी दाऊदे ज़ोवं, “यहोवारे ज़िन्दगरी कसम यहोवा तैस मारेलो; या तै एपनी मौती सेइं मरेलो; या तै लड़ैई मां गेइतां मरेलो। <verse eid="1SA 26:10" /><verse number="11" style="v" sid="1SA 26:11" />यहोवा न केरे कि ज़ेसेरू अभिषेक यहोवा कियोरू तैस पुड़ अवं अपनो हथ खड़ो केरि; हुनी तैसेरे शिरेइंते पुड़ेरां भालो ते पैनेरी गड़बी छ़ुइतां ने, ते अस इट्ठां च़ले गामेले।” <verse eid="1SA 26:11" /><verse number="12" style="v" sid="1SA 26:12" />तैखन दाऊदे भालो ते पैनेरी गड़बी शाऊलेरे शिरेइंते पुड़ेरां नी; ते तैना च़ले जे। ते केन्चे एन न लावं, ते कोन्ची पतो न च़लो, ते न कोई बींझ़ो; किजोकि तैना सारे एस वजाई सेइं झ़ुलोरे थिये, कि यहोवारे तरफां तैन्न मां भारी निड्ल एवरी थी।<verse eid="1SA 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 26:13" />तैखन दाऊद वादी लेंघतां पार गेइतां दूर एक्‍की पहाड़ेरी च़ोटी पुड़ खड़ो भोव, ते दूईयां केरे मझ़ाटे बड़ो फासलो थियो; <verse eid="1SA 26:13" /><verse number="14" style="v" sid="1SA 26:14" />ते दाऊदे तैन सिपेहिन जो, ते नेरेरे मट्ठे अब्नेरे जो हक देइतां ज़ोवं, “हे अब्नेर कुन तू न शुनस?” अब्नेरे जुवाब देइतां ज़ोवं, “तू कौनस ज़ै राज़े जो हक देतस?” <verse eid="1SA 26:14" /><verse number="15" style="v" sid="1SA 26:15" />दाऊदे अब्नेरे सेइं ज़ोवं, “कुन तू बड्डो योद्धा नईं? इस्राएले मां तेरे बराबर कौने? तीं अपने मालिक राज़ेरी हिफाज़त कि न की? अक मैन्हु त तेरे मालिके राज़े मारनेरे लेई डेरे मां एवरो थियो। <verse eid="1SA 26:15" /><verse number="16" style="v" sid="1SA 26:16" />ज़ैन कम तीं कियूं तैन रोड़ू नईं। यहोवारे ज़िन्दगरी कसम तुस लोक मारे गांनेरे काबलथ, किजोकि तुसेईं अपने मालिक, ज़ेसेरू अभिषेक यहोवा कियोरूए तैसेरी हिफाज़त न की। ते हुनी हेर, राज़ेरो भालो ते पैनेरी गड़बी ज़ै तैसेरे शिरेइंते थी तै कोड़िए?”<verse eid="1SA 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 26:17" />तैखन शाऊले दाऊदेरी आवाज़ पिशैनतां ज़ोवं, “हे मेरे मट्ठां दाऊद, कुन तू लगोरोस ज़ोने?” दाऊदे ज़ोवं, “हाँ, मेरे मालिक राज़ा, अव्वें लगोरोइं ज़ोने।” <verse eid="1SA 26:17" /><verse number="18" style="v" sid="1SA 26:18" />फिरी तैनी ज़ोवं, “मेरो मालिक अपने दासेरो पीछो किजो केरतस? मीं कुन कियोरूए? ते मीं करां कौ ज़ेरि बुराई भोवरीए?”<verse eid="1SA 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 26:19" />“हुनी मेरो मालिक राज़ो, अपने दासेरी गल्‍लां शुने। अगर यहोवा तू मेरे खलाफ भड़कावरो भोस, तैखन त तै बलिदान मन्ज़ूर केरे; पन अगर मैन्हेइं एरू कियोरू भोए, त तैना यहोवारे तरफां लानती भोन, किजोकि तैनेईं हुनी अवं कढोरोईं कि अवं यहोवारे अपने हिस्से मरां न रेईं, ते तैनेईं ज़ोवरू, ‘गा बखले देबतां केरि पूज़ा केर।’ <verse eid="1SA 26:19" /><verse number="20" style="v" sid="1SA 26:20" />एल्हेरेलेइ हुनी मेरो खून यहोवारे हज़ूरी करां दूर मुल्खे मां बगाव न गाए; इस्राएलेरो राज़ो त अक ट्लीव्वें तोप्पने एवरोए, ज़ेरो कि कोई पहाड़न पुड़ तितरां केरो शिकार केरतो भोए।”<verse eid="1SA 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 26:21" />तैखन शाऊले ज़ोवं, “मीं पाप कियोरोए, हे मेरे मट्ठां दाऊद वापस एई; मेरे प्राण अज़्ज़ेरे दिहाड़े तेरी नज़री मां कीमतीन, एस वजाई सेइं अवं फिरी तेरो किछ नुकसान न केरेलो; शुन, मीं बेवकूफी की, ते मीं करां बड़ी गलती भोवरीए।” <verse eid="1SA 26:21" /><verse number="22" style="v" sid="1SA 26:22" />दाऊदे जुवाब देइतां ज़ोवं, “हे राज़ा, भालो हेर, तुसन मरां कोई सिपाही इरां एइतां इस नेइतां गाए। <verse eid="1SA 26:22" /><verse number="23" style="v" sid="1SA 26:23" />यहोवा हर एक्‍की अपने-अपने धार्मिकतारो ते सच़्च़ैई अरो फल देलो; हेर, अज़ यहोवा तू मेरे हथ्थे मां दित्तोरो थियो, पन मीं यहोवारे अभिषिक्ते पुड़ अपनो हथ खड़ो केरनो जाइज़ न समझ़ो। <verse eid="1SA 26:23" /><verse number="24" style="v" sid="1SA 26:24" />एल्हेरेलेइ ज़ेन्च़रे तेरे प्राण अज़ मेरी नज़री मां ट्लारेन, तेन्च़रे मेरे प्राण भी यहोवारी नज़री मां ट्लारेन, ते तै मीं सारे मुसीबतन करां छुटाए।” <verse eid="1SA 26:24" /><verse number="25" style="v" sid="1SA 26:25" />शाऊले दाऊदे सेइं ज़ोवं, “हे मेरे मट्ठां दाऊद तू धन आस! तू बड्डां-बड्डां कम्मां केरेलो ते तेरां कम्मां कामयाब भोल्हां।” तैखन दाऊद तैट्ठां च़लो जेव, ते शाऊल भी अपने घरे जो वापस जेव।<verse eid="1SA 26:25" /></para>
  <chapter eid="1SA 26" />
  <chapter number="27" style="c" sid="1SA 27" />
  <para style="s">पलिश्तन मां दाऊद</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 27:1" />तैसेरां बाद दाऊद सोचने लगो, “हुनी अवं कोन्ची न कोन्ची दिहाड़ी शाऊलेरे हथ्थे सेइं मारो गानोईं; हुनी मेरे लेई रोड़ू इन्ने कि अवं पलिश्ती केरे मुल्खे मां गेईं; तैखन शाऊल मेरे बारे मां उदास भोल्हो, ते मीं इस्राएलेरे कोन्ची हिस्से मां फिरी न तोपेलो, तैखन अवं तैसेरे हथ्थेरां बच़ेलो।” <verse eid="1SA 27:1" /><verse number="2" style="v" sid="1SA 27:2" />तैखन दाऊद अपने 600 सिपाही साथी नेइतां च़लो जेव, ते गत नगरेरे राज़े माओकेरे मट्ठे आकीशे कां जेव। <verse eid="1SA 27:2" /><verse number="3" style="v" sid="1SA 27:3" />दाऊद ते तैसेरे लोक अपने-अपने घराने समेत गत नगरे मां आकीश राज़े कां राने लगे। दाऊद त अपनि दूई कौन्शां सेइं साथी, यिज्रेल नगरेरी अहीनोअम, ते नाबालेरी विधवा कर्मेल नगरेरी अबीगैली सेइं साथी राव। <verse eid="1SA 27:3" /><verse number="4" style="v" sid="1SA 27:4" />ज़ैखन शाऊले ई खबर मैल्ही कि दाऊद गत नगरे जो नशोरोए, तैखन तैनी तै फिरी कधी न तोप्पो।<verse eid="1SA 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 27:5" />एक्सां दाऊदे आकीश राज़े सेइं ज़ोवं, “अगर मीं पुड़ तेरे दयारी नज़र भोए, त अपने मुल्खेरे कोन्ची ड्लाव्वें मां मीं ठार दुवा ज़ैड़ी अवं रेईं; तेरो दास तीं सेइं साथी राजधैनी मां किजो राए?” <verse eid="1SA 27:5" /><verse number="6" style="v" sid="1SA 27:6" />तैखन आकीशे तैस्से दिहाड़े सिकलग नगर दित्तू; एस वजाई सेइं सिकलग अज़्ज़ेरे दिहाड़े तगर यहूदारे राज़ां केरू बनोरूए।<verse eid="1SA 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 27:7" />पलिश्ती केरे इलाके मां रहते-रहते दाऊदे अक साल च़ेवर महीने बीती जे। <verse eid="1SA 27:7" /><verse number="8" style="v" sid="1SA 27:8" />ते तैस दौरान दाऊदे अपने सिपेहिन समेत गेइतां गशूरी, गिर्जी, ते अमालेकी लोकन पुड़ हमले किये एना कौमां त पुराने ज़माने करां तैस मुल्खे मां रैती थी ज़ैन शूर नगरेरे बत्ती मां मिस्र मुल्खे तगरे। <verse eid="1SA 27:8" /><verse number="9" style="v" sid="1SA 27:9" />ज़ैखन भी दाऊद ते तैसेरे सिपाही कोन्ची नगरे पुड़ हमलो केरते थिये, ते कौन्शां मड़द कोई भी ज़ींतो न छ़डो, ते भैड्डां-छ़ेल्‍ली, बेछ़ी-दांत, गधे, ऊँट, ते लिगड़ां घिन्तां वापस अव, ते आकीश राज़े कां जेव। <verse eid="1SA 27:9" /><verse number="10" style="v" sid="1SA 27:10" />आकीशे पुछ़ू, “अज़ तीं हमलो त न कियो?” दाऊदे ज़ोवं, “हाँ, यहूदा यरहमेली ते केनी लोकां केरे दक्षिणेरे मुल्खे मां।” <verse eid="1SA 27:10" /><verse number="11" style="v" sid="1SA 27:11" />दाऊदे कौन्शां मड़द कोई ज़ींतो न छ़डो कि तैन गत नगरे मां पुज़ान; तैनी सोचोरू थियूं, “एरहो न भोए कि तै इश्शू कम ज़ोइतां इन ज़ोए, कि दाऊदे एरू-एरू कियोरूए। बल्के ज़ेइसेरो देंतो तै पलिश्ती केरे मुल्खे मां रहते, तेइसेरू देंतू तैसेरू एन्ने कम्मे।” <verse eid="1SA 27:11" /><verse number="12" style="v" sid="1SA 27:12" />तैखन आकीशे दाऊदे पुड़ विश्वास केरतां ज़ोवं, “ऐन अपने इस्राएली लोकां केरि नज़री मां बड़ू भिट्टू कम भोवरूए; एल्हेरेलेइ ई हमेशारे लेई मेरो दास बनोरो रालो।”<verse eid="1SA 27:12" /></para>
  <chapter eid="1SA 27" />
  <chapter number="28" style="c" sid="1SA 28" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 28:1" />किछ वक्तेरां बाद पलिश्तेईं इस्राएले सेइं लड़नेरे लेई अपनि सेना अकोट्ठी की तैखन आकीश राज़े दाऊदे सेइं ज़ोवं, “ई गल तू ज़रूर ज़ान कि तीं अपने सेना समेत मीं सेइं साथी जंगी मां गानू भोल्हु।” <verse eid="1SA 28:1" /><verse number="2" style="v" sid="1SA 28:2" />दाऊदे आकीशे सेइं ज़ोवं, “एस वजाई सेइं तू सेमझ़ी गालो कि तेरो दास कुन केरेलो।” आकीशे दाऊदे सेइं ज़ोवं, “एल्हेरेलेइ अवं तीं अपनो रक्षा केरनेबालो ठहरालो।”<verse eid="1SA 28:2" /></para>
  <para style="s">शाऊल ते भूत साधने बाली कौन्श</para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 28:3" />शमूएल त मेरि जेवरो थियो, ते सारे इस्राएली लोकेईं तैसेरे लेई अफ़सोस कियो, ते तै तैसेरे नगर रामाह मां दब्बो जेव। ते शाऊले जैदू टूनो केरनेबाले ते भूत साधने बाले मुल्खे मरां कढोरे थिये।<verse eid="1SA 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 28:4" />ज़ैखन पलिश्तेईं अकोट्ठे भोइतां शूनेम नगरे मां डेरे लाए, त शाऊले सारे इस्राएली अकोट्ठे किये, ते तैनेईं गिलबो पहाड़े पुड़ डेरे लाए। <verse eid="1SA 28:4" /><verse number="5" style="v" sid="1SA 28:5" />पलिश्ती केरि सेना लेहितां शाऊल डेरि जेव, ते तैसेरो दिल डेरतां बड़ो धड़कने लगो। <verse eid="1SA 28:5" /><verse number="6" style="v" sid="1SA 28:6" />ते ज़ैखन शाऊले यहोवा पुछ़ू, तैखन यहोवाए सुपनेरे ज़िरिये तैस जुवाब दित्तो, ते न ऊरीमेरे ज़िरिये, ते न नेबी केरे ज़िरिये। <verse eid="1SA 28:6" /><verse number="7" style="v" sid="1SA 28:7" />तैखन शाऊले अपने अधिकैरन सेइं ज़ोवं, “मेरे लेई कोन्ची भूत साधने बाली कौन्श तोप्पा, कि अवं तैस कां गेइतां तैस पुछ़ी।” तैसेरे नौकरेईं तैस सेइं ज़ोवं, “एनदोर नगरे मां अक भूत साधने बाली कौन्श रहतीए।”<verse eid="1SA 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 28:8" />तैखन शाऊले अपनु रूप बदलू, ते होरां लिगड़ां लां, ते दूई मैन्हु साथी नेइतां, रातो-रात च़ेलतां तैस कौन्शी कां गेइतां तैस सेइं ज़ोवं, “अपने भूत साधने सेइं मेरे लेई पुछ़, ते ज़ेसेरू नवं अवं ज़ोइलो तैस कुजा।” <verse eid="1SA 28:8" /><verse number="9" style="v" sid="1SA 28:9" />कौन्शां तैस सेइं ज़ोवं, “तू ज़ानस कि शाऊल राज़े कुन कियोरूए, कि तैनी जैदू टूनो केरनेबाले ते भूत साधने बाले मुल्खे मरां कढोरेन। फिरी तू मेरे प्राणा केरे लेई किजो फंदो लातस कि मीं मारास।” <verse eid="1SA 28:9" /><verse number="10" style="v" sid="1SA 28:10" />शाऊले यहोवारी कसम खेइतां तैस सेइं ज़ोवं, “यहोवारे ज़िन्दगरी कसम, एस गल्‍लरे वजाई सेइं सज़ाह न मैल्हेली।” <verse eid="1SA 28:10" /><verse number="11" style="v" sid="1SA 28:11" />तैखन कौन्शां पुछ़ू, “अवं तेरे लेई कैस कुजेई?” तैनी जुवाब दित्तो, “शमूएले मेरे लेई कुजा।” <verse eid="1SA 28:11" /><verse number="12" style="v" sid="1SA 28:12" />ज़ैखन कौन्शां शमूएल लाव, तैखन ज़ोरे सेइं तैसां चिन्डां मैरी; ते शाऊले सेइं ज़ोवं, “तीं मीं किजो धोखो दित्तो? तू त शाऊलस।” <verse eid="1SA 28:12" /><verse number="13" style="v" sid="1SA 28:13" />राज़े तैस सेइं ज़ोवं, “न डर; तीं कुन लेइहोते?” कौन्शां शाऊले सेइं ज़ोवं, “मीं अक देबतो धरती मरां निस्तो लेइहोते।” <verse eid="1SA 28:13" /><verse number="14" style="v" sid="1SA 28:14" />तैनी तैस पुछ़ू, “तैसेरू केरहु ज़ेरू रूपे?” तैसां ज़ोवं, “अक बुढो मड़द चोगो पलेटतां उबरो एइते।” तैखन शाऊले पक्‍कू याकीन भोवं कि तै शमूएले, ते क्रोड़रे भारे ज़मीनी पुड़ झुकतां मथ्थो टेको।<verse eid="1SA 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 28:15" />शमूएले शाऊले पुछ़ू, “तीं अवं बह कुजेइतां किजो परेशान कियो?” शाऊले जुवाब दित्तो, “अवं बड़े मुसीबती मां फसोरोइं; किजोकि पलिश्ती मीं सेइं लड़ाई केरनेबालेन, परमेशरे अवं शारोरोईं, ते हुनी मीं न त नेबी केरे ज़िरिये जुवाब मैल्हे, ते न सुपने मां; एल्हेरेलेइ मीं तू कुजव कि तू मीं सेइं ज़ोस कि अवं कुन केरीं।” <verse eid="1SA 28:15" /><verse number="16" style="v" sid="1SA 28:16" />शमूएले ज़ोवं, “ज़ैखन यहोवा तीं छ़ेडतां तेरो दुश्मन बेनि जेवं, तैखन तू मीं करां किजो पुछ़तस? <verse eid="1SA 28:16" /><verse number="17" style="v" sid="1SA 28:17" />यहोवा त ज़ेन्च़रे मीं करां ज़ुवावरू थियूं तेरहो तैनी बर्ताव कियोरोए; तैनी तेरे हथ्थे मरां हुकूमत थुसोड़तां दाऊदे जो दित्तोरीए। <verse eid="1SA 28:17" /><verse number="18" style="v" sid="1SA 28:18" />तीं ज़ै यहोवारी गल न मन्नी, ते अमालेकी लोकन पुड़ तैसेरे भड़कोरे क्रोधेरे मुताबिक सज़ाह न थी दित्तोरी, एस वजाई सेइं यहोवा तीं सेइं अज़ एरहो बर्ताव कियो। <verse eid="1SA 28:18" /><verse number="19" style="v" sid="1SA 28:19" />फिरी यहोवा इस्राएली लोकन समेत तीं पलिश्ती लोकां केरे हथ्थे मां छ़डेलो; ते तू अपने मट्ठन समेत कालां मीं साथी भोल्हो; ते इस्राएली सेना भी यहोवा पलिश्ती केरे हथ्थे मां छ़डेलो।”<verse eid="1SA 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 28:20" />तैखन शाऊल अकदम तुत्तरेरे भारे ज़मीनी पुड़ झुकी जेव, ते शमूएलेरे गल्‍लां केरे वजाई सेइं बड़ो डेरि जेव; तैनी पूरे दिहाड़ी ते राती रोट्टी न खाइ, एस सेइं तैस मां ज़ोर किछ भी न राव। <verse eid="1SA 28:20" /><verse number="21" style="v" sid="1SA 28:21" />तैखन तै जैदूगिर कौन्श शाऊले कां जेई, ते तैस खूब हैरान परेशान हेरतां तैस सेइं ज़ोवं, “शुन, तेरी दैसां त तेरी गल मन्नी; ते मीं अपनि जान खतरे मां छ़ेडतां तेरी गल्‍लां शुनी ज़ैना तीं मीं सेइं ज़ोई। <verse eid="1SA 28:21" /><verse number="22" style="v" sid="1SA 28:22" />त हुनी तू भी अपनि दैसरी गल मन; ते अवं तीं खाने जो रोट्टी देतीं; तू तैस खा, कि ज़ैखन तू अपने बत्तां गास तैखन तीं मां हिम्मत एज्जी गाए।” <verse eid="1SA 28:22" /><verse number="23" style="v" sid="1SA 28:23" />तैनी इन्कार केरतां ज़ोवं, “अवं न खेइलो” पन तैसेरे दास ते कौन्शां मिलतां इड़ी तगर तै मजबूर कि तै तैन केरि गल्‍लां मेनतां खड़ो उठतां खट्टी पुड़ बिश्शो। <verse eid="1SA 28:23" /><verse number="24" style="v" sid="1SA 28:24" />तैस कौन्शरे घरे मां त अक निगर बछ़ड़ू थियूं, तैसां लूश केरतां तैन मारू, फिरी अट्टू नेइतां सन्नू, ते बगैर खमीरे रोट्टी बनेइतां <verse eid="1SA 28:24" /><verse number="25" style="v" sid="1SA 28:25" />शाऊल ते तैसेरे दासन खाने जो दित्ती; ते तैनेईं खई। तैखन तैना उठतां तैस्से राती निस्तां च़ले जे।<verse eid="1SA 28:25" /></para>
  <chapter eid="1SA 28" />
  <chapter number="29" style="c" sid="1SA 29" />
  <para style="s">पलिश्ती लोक दाऊदे रद केरतन</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 29:1" />पलिश्ती लोकेईं अपनि सारी सेना अपेक नगरे मां अकोट्ठी की; ते इस्राएली लोकेईं यिज्रेल पैनेरे<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="fq" closed="false">यिज्रेल पैनेरे </char><char style="ft" closed="false">यिज्रेल वैदी </char></note> नागे कां डेरे लेवरे थिये। <verse eid="1SA 29:1" /><verse number="2" style="v" sid="1SA 29:2" />तैखन पलिश्ती केरे राज़े अपने-अपने शौव ते हज़ारां सिपेहिन सने अग्रोवं च़ले जे, ते सेना पत्ती-पत्ती आकीश राज़े सेइं साथी दाऊद ते तैसेरी सेना भी च़ली। <verse eid="1SA 29:2" /><verse number="3" style="v" sid="1SA 29:3" />तैखन बाकी पलिश्ती सेनापतिएईं पुछ़ू, “एन इब्रानी लोकां केरू इड़ी कुन कम्मे?” आकीशे पलिश्ती सेनापतिन सेइं ज़ोवं, “कुन तै इस्राएलेरो राज़ो शाऊलेरो सिपाही दाऊद नईं, ज़ै बड़े वक्तेरो देंतो मीं सेइं साथी रहते, ते ज़ेइसेरो देंतो तै शाऊले करां नशोरोए, तैखन करां अज़ तगर मीं तैस मां कोई बुराई नईं मैल्होरी।” <verse eid="1SA 29:3" /><verse number="4" style="v" sid="1SA 29:4" />पन पलिश्ती सेनापति आकीशे जो सेरकोए; ते तैस सेइं ज़ोरे सेइं ज़ोवं, “तैस मड़दे वापस भेज़, कि तै तैस जगाई पुड़ गाए ज़ै तीं तैसेरे लेई रख्खोरीए; तै असन साथी जंगी मां न एज्जी बटेलो, कोन्च एरू न भोए कि तै जंगी मां इश्शो मुखालफ बेनि गाए। फिरी कुन तै अपने मालिक शाऊले सेइं सिपेही केरि क्रोड़ी केटतां न मिलेलो? <verse eid="1SA 29:4" /><verse number="5" style="v" sid="1SA 29:5" />कुन ई तैए दाऊद नईं, ज़ेसेरे बारे मां इस्राएली कौन्शां नच़ती ते गीतां ज़ोती एक्‍की होरि सेइं ज़ोती थी,</para>
  <para style="q" vid="1SA 29:5">‘शाऊले हज़ारेईं दुश्मन,</para>
  <para style="q" vid="1SA 29:5">पन दाऊदे लखेइं दुश्मन मारोरेन?’”<verse eid="1SA 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 29:6" />तैखन आकीश राज़े दाऊद कुजेइतां तैस सेइं ज़ोवं, “यहोवारे ज़िन्दगरी कसम तू त सिद्धो आस, ते सेनाई मां तेरू मीं साथी एजनू गानू भी मीं रोड़ू लगते; किजोकि ज़ेइसेरो देंतो तू मीं कां एवरोस तेइसेरो देंतो अज़ तगर मीं त तीं मां कोई बुराई न मैल्ही। फिर भी बाकी राज़े तीं न चान। <verse eid="1SA 29:6" /><verse number="7" style="v" sid="1SA 29:7" />एल्हेरेलेइ हुनी तू सुखे सेइं वापस गा; एरू न भोए कि पलिश्ती प्रधान तीं सेइं नाराज़ भोन।” <verse eid="1SA 29:7" /><verse number="8" style="v" sid="1SA 29:8" />दाऊदे आकीशे सेइं ज़ोवं, “मीं कुन कियोरूए? ते ज़ेइसेरो देंतो अवं तीं कां एवरोईं तेइसेरो देंतो अज़ तगर तीं अपने सेवके मां कुन मैल्होरूए कि अवं अपने मालिक राज़ेरे दुश्मन्न सेइं लेड़ी न बटेलो?” <verse eid="1SA 29:8" /><verse number="9" style="v" sid="1SA 29:9" />आकीशे दाऊदे जुवाब देइतां ज़ोवं, “हाँ, ई मीं पतोए, तू मेरी नज़री मां त परमेशरेरे भेज़ोरे मैन्हु केरे ज़ेरो बेकसूर लगतस; फिरी भी बाकी पलिश्ती राज़ेईं ज़ोवरूए, ‘तै असन सेइं साथी जंगी मां न गेइ बटेलो।’ <verse eid="1SA 29:9" /><verse number="10" style="v" sid="1SA 29:10" />एल्हेरेलेइ हुनी तू अपने मालिकेरे सेवकन ज़ैना तीं सेइं साथी एवरेन नेइतां झ़ेझ़ां सुबेले उठ; ते लौ भोंते च़लो गेइयां।” <verse eid="1SA 29:10" /><verse number="11" style="v" sid="1SA 29:11" />एल्हेरेलेइ दाऊद अपने सेना सने झ़ेझ़ां उठतां पलिश्ती केरे मुल्खे जो वापस जेव। ते पलिश्ती सेना यिज्रेले पुड़ हमलो केरने जेई।<verse eid="1SA 29:11" /></para>
  <chapter eid="1SA 29" />
  <chapter number="30" style="c" sid="1SA 30" />
  <para style="s">दाऊदेरी अमालेकी लोकन सेइं लड़ाई</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 30:1" />ट्लेइयोवं दिहाड़े ज़ैखन दाऊद अपने सेना सने सिकलग नगरे मां पुज़्ज़ो, तैखन तैनेईं हेरू, कि तैन केरे एजने करां पेइले अमालेकी लोकेईं यहूदा प्रदेशेरे दक्षिण ते सिकलग नगरे पुड़ हमलो कियो। तैनेईं तैन नगर बरबाद कियूं ते तैस अग लाई। <verse eid="1SA 30:1" /><verse number="2" style="v" sid="1SA 30:2" />तैनेईं कौन्शां निक्‍के-बड्डे सब बन्धी बनेइतां निये; तैनेईं तैन मरां कोई त न मारो, पन तैना नेइतां एपनी बत्तां च़ले। <verse eid="1SA 30:2" /><verse number="3" style="v" sid="1SA 30:3" />ज़ैखन दाऊद अपने सेना समेत सिकलग नगरे मां पुज़्ज़ो, तैखन नगर त फुकोई जेवरू थियूं, ते कौन्शां ते बच्‍चे बन्धी बनेइतां घिन्नी जेवरे थिये। <verse eid="1SA 30:3" /><verse number="4" style="v" sid="1SA 30:4" />तैखन दाऊद ते ज़ैना सिपाही तैस सेइं साथी थिये तैनेईं चिन्डां मैरतां एत्री लेरां दित्ती, कि फिरी तैन मां लेरां देनेरे लेई हिम्मत न राई। <verse eid="1SA 30:4" /><verse number="5" style="v" sid="1SA 30:5" />दाऊदेरी दूईये कौन्शां, यिज्रेल नगरेरी अहीनोअम, ते अबीगैल ज़ै पेइली कर्मेली नाबालेरी कौन्श थी, बन्धी बेनि जेवरी थी। <verse eid="1SA 30:5" /><verse number="6" style="v" sid="1SA 30:6" />ते दाऊद बड़े मुसीबती मां पेई जेव; किजोकि सिपाही अपने मट्ठां-कुइयां केरे वजाई सेइं बड़े परेशान भोइतां तैस पुड़ घोड़ेईं बानेरी एप्पु मांमेइं चर्चा केरि राहोरे थिये। पन दाऊदे अपने परमेशर यहोवा याद केरतां हिम्मत की।<verse eid="1SA 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 30:7" />तैखन दाऊदे अहीमेलेकेरे मट्ठे एब्यातार याजके सेइं ज़ोवं, “एपोदे मीं कां आन।” तैखन एब्यातारे एपोद दाऊदे कां आनू। <verse eid="1SA 30:7" /><verse number="8" style="v" sid="1SA 30:8" />ते दाऊदे यहोवा पुछ़ू, “कुन अवं एन लोकां केरो पीछो केरीं? कुन तैस गेइतां ट्लेइं?” यहोवा जुवाब दित्तो, “पीछो केर; किजोकि तू ज़रूर तैस ट्लालो, ते सब बन्धी छुटेइतां आनेलो;” <verse eid="1SA 30:8" /><verse number="9" style="v" sid="1SA 30:9" />तैखन दाऊद अपने 600 सिपाही साथी नेइतां बसोर नाले तगर पुज़्ज़ो; किछ सिपाही रुके। <verse eid="1SA 30:9" /><verse number="10" style="v" sid="1SA 30:10" />दाऊद त 400 सिपेहिन समेत पीछो केरतां च़लो जेव; पन 200 ज़ैना थेकी जेवरे थिये, ते बसोर नाले पार न गेइ सखे ते तैट्ठी राए।<verse eid="1SA 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 30:11" />तैन अक मिस्री मैन्हु मैइदाने मां मैल्हो, तैनेईं दाऊदे कां नेइतां तैस रोट्टी दित्ती; ते तैनी तै खाई, फिरी तैस पानी पीने जो दित्तू, <verse eid="1SA 30:11" /><verse number="12" style="v" sid="1SA 30:12" />फिरी तैनेईं तैस अंजीरां केरे टिक्‍की केरो अक टुक्ड़ो ते दूई गुच्छे किशमिश दित्ती। ते ज़ैखन तैनी खावं, तैखन तैसेरे जानी मां जान अई; तैनी ट्लाई दिहाड़े ते ट्लाई रात न त रोट्टी खेवरी थी ते न पानी पीयोरू थियूं। <verse eid="1SA 30:12" /><verse number="13" style="v" sid="1SA 30:13" />तैखन दाऊदे तैस पुछ़ू, “तू केसेरो सेवक आस? ते कोड़ि रहतस?” तैनी जुवाब दित्तो, “अवं त मिस्री ते अक अमालेकी मैन्हेरो सेवकाई; ते ट्लाई दिहाड़े भोए कि अवं बिमार आईं, ते मेरो मालिक मीं शैरतां च़लो जेवरोए। <verse eid="1SA 30:13" /><verse number="14" style="v" sid="1SA 30:14" />असेईं लोकेईं करेती लोकां केरे दक्षिण पासे, ते यहूदारे प्रदेशे मां, ते कालेबेरे दक्षिण प्रदेशेरे पासे हमलो कियोरोए; ते सिकलग नगर अग लेइतां फुकोरूए।” <verse eid="1SA 30:14" /><verse number="15" style="v" sid="1SA 30:15" />दाऊदे तैस पुछ़ू, “कुन तू मीं तैस जथे कां पुज़ालो?” तैनी ज़ोवं, “मीं सेइं परमेशरेरी ई कसम खा, कि तू मीं जाना त न मारेलो, ते न मेरे मालिकेरे हथ्थे देलो, तैखन अवं तीं तैस जथे कां पुज़ालो।”<verse eid="1SA 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 30:16" />ज़ैखन तैनी तै पुज़व, तैखन हेरने मां अऊं कि तैना सारे ज़मीनी पुड़ फैलोरेन ते खाते पीते, ते तैस बड़ी लूटरे वजाई सेइं, ज़ै तैनेईं पलिश्ती केरे मुल्खेरां ते यहूदा प्रदेशे मरां आनोरी थी, नच़ते जशन मनाने लगोरे थिये। <verse eid="1SA 30:16" /><verse number="17" style="v" sid="1SA 30:17" />एल्हेरेलेइ दाऊद तैन रातरे पेइले पहरे करां लेइतां दूइयोवं दिहाड़ेरे ड्लवझ़ी तगर मारतो राव; तैनेईं सारे लोक मारे, सिर्फ 400 सिपाही ज़ैना ऊँटन पुड़ च़ेढ़तां नश्शोरे थिये, तैना बंच़े। <verse eid="1SA 30:17" /><verse number="18" style="v" sid="1SA 30:18" />ते ज़ैन किछ अमालेकी लोकेईं नियेरू थियूं तैन सारू दाऊदे छुटावं; ते दाऊदे अपनि दूईये कौन्शां भी छुटेई। <verse eid="1SA 30:18" /><verse number="19" style="v" sid="1SA 30:19" />पन तैन केरे कुन निकड़े, कुन बड्डे, कुन मट्ठां, कुन कुइयां, कुन लूटरो माल, सब किछ ज़ैन अमालेकी लोकेईं नियोरू थियूं, तैस मरां कोई चीज़ न राई ज़ै तैनेईं न छुटेवरी भोए; किजोकि दाऊदे सब किछ वापस आनोरू थियूं। <verse eid="1SA 30:19" /><verse number="20" style="v" sid="1SA 30:20" />ते दाऊदे सैरी भैड्डां-छ़ेल्‍ली, ते बेछ़ी-दांत भी लुटतां ऐनी; ते एन सिपाही इन ज़ोते अपने जानबरां केरे अग्गर च़लते जे, कि इन दाऊदेरू लुटेरूए।<verse eid="1SA 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 30:21" />तैखन दाऊद तैन 200 सिपेहिन कां अव, ज़ैना एरे थकोरे थिये कि दाऊदे पत्ती-पत्ती न गेइ सखे, ते बसोर नाले कां शारोरे थिये; ते तैना दाऊदे सेइं ते तैन सेइं मिलने च़ले; ते दाऊदे तैन कां पुज़तां तैन केरो हाल पुछ़ो। <verse eid="1SA 30:21" /><verse number="22" style="v" sid="1SA 30:22" />पन तैन लोकन मरां ज़ैना दाऊदे सेइं साथी जेवरे थिये सारे दुष्ट ते घटिया लोकेईं ज़ोवं, “इना मैन्हु असन सेइं साथी नईं एवरे, एस वजाई सेइं अस तैन अपने छुटेवरे ते लूटरे माले मरां किछ न देले, सिर्फ एक्‍की-एक्‍की मैन्हु तैसेरी कौन्श ते बाल बच्‍चे देमेले, कि तैना नेइतां च़ले गान।” <verse eid="1SA 30:22" /><verse number="23" style="v" sid="1SA 30:23" />पन दाऊदे ज़ोवं, “हे मेरे ढ्लाव, तुस तैस माले सेइं ज़ै यहोवा असन दित्तोरोए एन न केरि सकत; ते तैनी इश्शी हिफाज़त की, ते तैस टोली ज़ैसां असन पुड़ हमलो कियोरो थियो इश्शे हथ्थे मां कियोरीए। <verse eid="1SA 30:23" /><verse number="24" style="v" sid="1SA 30:24" />ते इस बारे मां तुश्शी कौन शुनेलो? लड़ैई मां गाने बालां केरो ज़ेरो हिस्सो भोल्हो, सामाने कां बिशने बालां केरो भी तेरहो हिस्सो भोल्हो।” <verse eid="1SA 30:24" /><verse number="25" style="v" sid="1SA 30:25" />ते दाऊदे इस्राएली केरे लेई एरहो तरीको ते नियम ठहराव, ते तै तैस दिहाड़े करां लेइतां अज़्ज़ेरे दिहाड़े तगर बनोरोए।<verse eid="1SA 30:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 30:26" />सिकलग नगरे मां पुज़तां दाऊदे यहूदी बुज़ुर्ग लोकन कां ज़ैना तैसेरे दोस्त थिये लूटरे माले मरां तैन जो किछ-किछ सामान भेज़ू, ते ई भी सन्देश भेज़ो, “यहोवारे दुश्मना केरि लूटरे माले मरां तुश्शे लेई इना तोफेन।” <verse eid="1SA 30:26" /><verse number="27" style="v" sid="1SA 30:27" />दाऊदे इन नगरां केरे बुज़ुर्गन जो लूटरो माल भेज़ो, बेतेलेरे दक्षिण मुल्खेरे रामोत, यत्तीर, <verse eid="1SA 30:27" /><verse number="28" style="v" sid="1SA 30:28" />अरोएर, सिपमोत, एश्तमो, <verse eid="1SA 30:28" /><verse number="29" style="v" sid="1SA 30:29" />राकाल, यरहमेली लोकां केरे नगर, केनी लोकां केरे नगर, <verse eid="1SA 30:29" /><verse number="30" style="v" sid="1SA 30:30" />होर्मा, कोराशान, अताक, <verse eid="1SA 30:30" /><verse number="31" style="v" sid="1SA 30:31" />हेब्रोन मतलब ज़ेत्रे ठारन मां दाऊद अपने सिपेहिन समेत फिरां केरतो थियो, तैन सेभी केरे सियानन कांजो तैनी किछ-किछ सामान भेज़ू।<verse eid="1SA 30:31" /></para>
  <chapter eid="1SA 30" />
  <chapter number="31" style="c" sid="1SA 31" />
  <para style="s">शाऊल ते तैसेरे मट्ठां केरि मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 31:1" />इस दौरान पलिश्ती त इस्राएली लोकन सेइं लड़े; ते इस्राएली सिपाही पलिश्ती सिपेही केरे सामनेरां नश्शे, ते गिलबो पहाड़े पुड़ मारे जे। <verse eid="1SA 31:1" /><verse number="2" style="v" sid="1SA 31:2" />ते पलिश्ती शाऊल ते तैसेरे मट्ठन पत्ती लगोरे राए; ते पलिश्ती सेना शाऊलेरां मट्ठां योनातान, अबीनादाब, ते मल्कीशूअ मारां। <verse eid="1SA 31:2" /><verse number="3" style="v" sid="1SA 31:3" />शाऊले सेइं बड़ी भारी लड़ाई भोइ राहोरी थी, ते पलिश्ती तीर च़लाने बालेईं तै तीर च़लेइतां बड़ो ज़खमी कियो। <verse eid="1SA 31:3" /><verse number="4" style="v" sid="1SA 31:4" />तैखन शाऊले अपने हथियार च़लानेबाले सेइं ज़ोवं, “अपनि तलवार खिचतां मीं मार, एरू न भोए कि तैना ज़ैन केरो खतनो न भोवरो एइतां मीं मारन, ते मेरो मज़ाक बनान।” पन तैसेरे हथियार च़लानेबाले बड़े डेरतां एन केरने करां इन्कार कियो। तैखन शाऊल अपनि तलवार खड़ी केरतां तैस पुड़ बिछ़ड़ी जेव। <verse eid="1SA 31:4" /><verse number="5" style="v" sid="1SA 31:5" />एन हेरतां कि शाऊल मेरि जेव, तैसेरो हथियार च़लानेबालो भी तेन्च़रे एपनी तलवारी पुड़ एप्पु बिछ़ड़तां तैस सेइं साथी तैसेरे ड्लेखी मेरि जेव। <verse eid="1SA 31:5" /><verse number="6" style="v" sid="1SA 31:6" />शाऊल ते तैसेरां ट्लाईए मट्ठां, ते तैसेरो हथियार च़लानेबालो, ते तैसेरे सारे सिपाही तैस्से दिहाड़े साथी मेरि जे। <verse eid="1SA 31:6" /><verse number="7" style="v" sid="1SA 31:7" />एन हेरतां इस्राएली सिपाही नेश्शी जे, कि शाऊल ते तैसेरां मट्ठां मेरि जेआं, तैस यिज्रेल वैदरे होरि पासेबाले ते यरदन दरियारे पूरबेरे पासे रानेबाले इस्राएली लोकेईं शुनू त अपने-अपने नगरन शैरतां नेश्शी जे; ते पलिश्ती एइतां तैन मां राने लगे।<verse eid="1SA 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 31:8" />दूइयोवं दिहाड़े ज़ैखन पलिश्ती मारोरे इस्राएली सिपेही केरो माल लुटने आए, तैखन तैन शाऊल ते तैसेरां ट्लाईए मट्ठां केरि लाशां गिलबो पहाड़े पुड़ मैल्ही। <verse eid="1SA 31:8" /><verse number="9" style="v" sid="1SA 31:9" />तैखन तैनेईं शाऊलेरी क्रोड़ी कट्टी, ते हथियार लुट्टे, ते पलिश्ती केरे मुल्खेरे सैरी जगान इन ज़ोनेरे लेई मैन्हु भेज़े, कि तैन केरे मूरती केरे मन्दरे ते आम मैन्हन ई रोड़ी खबर शुनाते गान। <verse eid="1SA 31:9" /><verse number="10" style="v" sid="1SA 31:10" />तैखन तैनेईं तैसेरे हथियार त अश्तोरेत देबरे मन्दरे मां रख्खे, ते तैसेरी लाश बेतशान नगरेरे दिवारी पुड़ रख्खी। <verse eid="1SA 31:10" /><verse number="11" style="v" sid="1SA 31:11" />ज़ैखन गिलाद प्रदेशेरे याबेश नगरेरे रानेबालेईं शुनू कि पलिश्ती सेना शाऊले सेइं कुन-कुन कियूं, <verse eid="1SA 31:11" /><verse number="12" style="v" sid="1SA 31:12" />तैखन सब बहादर सिपाही च़ले, ते रातो-रात गेइतां शाऊल ते तैसेरे मट्ठां केरि लाशां बेतशान नगरेरी शहरपनाह पुड़ेरां याबेश नगरे मां एन्हीं, ते तैड़ी फुक्‍की <verse eid="1SA 31:12" /><verse number="13" style="v" sid="1SA 31:13" />तैखन तैनेईं तैन केरि हेड्डी नेइतां याबेशेरे झाऊ बुट्टे हैठ देब्बी, ते सत दिहाड़न तगर तैन केरे लेई दुख हिरानेरे लेई बरत रख्खू।<verse eid="1SA 31:13" /></para>
  <chapter eid="1SA 31" />
</usx>