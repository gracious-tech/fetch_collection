  <para style="h">2 थिस्सलुनीकियों</para>
  <para style="toc1">थिस्सलुनीकियों केरे नंव्वे पौलुसेरी दूइयोवं चिट्ठी</para>
  <para style="toc2">2 थिस्सलुनीकियों</para>
  <para style="toc3">2 थिस.</para>
  <para style="mt">थिस्सलुनीकियों केरे नंव्वे पौलुसेरी दूइयोवं चिट्ठी</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">पेइले चिट्ठरी ज़ेरि ई चिट्ठी भी पौलुस, तीमुथियुस ते सीलासेरी तरफां थी। लिखनेबाले इस चिट्ठी मां तैए लिखनेरो तरीको इस्तेमाल कियोरोए ज़ै पौलुसे 1 थिस्सलुनीकियों ते बाकी चिट्ठन मां कियोरोए। इस सेइं साफ भोते कि खास लिखने बालो पौलुस थियो। सीलास ते तीमुथियुसेरू नवं अभिवादने मां ज़ोड़ू जेवरूए। (<char style="xt"><ref loc="2TH 1:1">2 थिस. 1:1</ref></char>) अलग-अलग वचन्न मां “अस” लिखनेरो मतलबे कि इस चिट्ठरो लिखनेरो मतलब अक्‍के। किजोकि पौलुसे आखरी नमस्कार ते प्राथना अपने हथ्थन सेइं लिखोरी थी, एल्हेरेलेइ चिट्ठी लिखनेरू कम पौलुसेरू नईं (<char style="xt"><ref loc="2TH 3:17">2 थिस. 3:17</ref></char>)। एन्च़रे लगते कि पौलुसे तीमुथियुस या सीलासे करां ई चिट्ठी लिखेवरी थी।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग ई. स. 51-52</para>
  <para style="ip">पौलुसे ई दूइयोवं चिट्ठी कुरिन्थ नगरे मरां लिखी, ज़ैखन तै पेइली चिट्ठी लिखते तैड़ी थियो।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">
    <char style="xt">
      <ref loc="2TH 1:1">2 थिस. 1:1</ref>
    </char> मां इस पतो लगते कि केसेरे लेई ई चिट्ठी लिखी, “थिस्सलुनीके नगरेरे कलीसियारे” लोक थिये।</para>
  <para style="is">मकसद</para>
  <para style="ip">इस चिट्ठरो मकसद थियो कि प्रभुएरे दिहाड़ेरे बारे मां गलत शिक्षारी खलाफत की गाए। विश्वासे मां बनोरे रानेरे लेई तैनेईं ज़ै मेहनत की तैसेरे लेई तैन केरि तारीफ़ केरे ते तैन केरि हिम्मत बधाए ते आखरी वक्तेरे बारे शिक्षाई मां गड़बड़ी छ़डने बालन झ़िड़के किजोकि तैन केरि शिक्षारे मुताबिक प्रभुएरी दिहाड़ी एवरी ते प्रभुएरू एजनू बड़ू नेड़े। एन्च़रे सेइं इस शिक्षारे ज़िरिये तैना अपनो फैइदो उठाते थिये।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">उमीदी मां ज़ींनू</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. अभिवादन <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. दुखन मां हिम्मत रखनी <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">3. प्रभुएरे दिहाड़े बारे मां गलत शिक्षारो सुधार <char style="ior"><ref loc="2TH 2:1-12">2:1-12</ref> </char></para>
  <para style="io1">4. तैन केरे कम्मां केरे बारे मां तैन याद करानू <char style="ior"><ref loc="2TH 2:13-17">2:13-17</ref></char></para>
  <para style="io1">5. व्यावहारिक विषयां केरे बारे मां शिक्षा <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref> </char></para>
  <para style="io1">6. आखरी नमस्कार <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />अवं पौलुस ई चिट्ठी लिखने लगोरोईं। सिलवानुस ते तीमुथियुस भी मीं सेइं साथी आन। थिस्सलुनीकि नगरेरे कलीसियारे विश्वासी लोकन, ज़ैना बाजी परमेशर ते प्रभु यीशु मसीह मां आन, <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />अस प्राथना केरतम कि इश्शे बाजी परमेशर ते प्रभु यीशु मसीह तुसन अनुग्रह ते शान्ति दे।<verse eid="2TH 1:2" /></para>
  <para style="s">न्यायेरी दिहाड़ी</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />हे ढ्लाव ते बेइनव, तुश्शे बारे मां असेईं हर वक्त परमेशरेरू शुक्र कियेरू लोड़े, ते इन इश्शे लेई ठीक भी आए। एल्हेरेलेइ कि तुश्शो यीशु मसीह पुड़ विश्वास बड़ो बद्धतो गाते, त कने तुश्शो एक्‍की होरि सेइं प्यार केरनो भी बड़ो बद्धने लगोरोए। <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />ई वजाए, कि अस एप्पू परमेशरेरे कलीसियान मां, तुश्शे बारे मां घमण्ड केरतम, चाए तुसन पुड़ मुसीबत या दुख भी एज्जन, फिरी भी तुस सबरी सेइं झ़ैलतथ, ते तुस यीशु मसीह पुड़ विश्वास केरते रहतथ। <verse eid="2TH 1:4" /><verse number="5" style="v" sid="2TH 1:5" />परमेशर अपनो न्याय हिरानेरे लेई ई स्ताव इस्तेमाल केरेलो, कि तुस परमेशरेरे राज़्ज़ेरे काबल भोथ, ज़ेसेरे लेई तुस दुख भी झ़ैलतथ। <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />परमेशरे हमेशा ठीक तरीके सेइं न्याये केरते, कि ज़ैना तुसन दुख देतन, तैन बदले मां दुख दे। <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />तुस ज़ैना दुख झ़ैलतथ, परमेशर तुसन आराम देलो ते असन भी। इन तेइस भोल्हु ज़ेइस प्रभु यीशु अपने शेक्तिबाले स्वर्गदूतन सेइं साथी बेलति अग्गरे लप्पी सेइं साथी सुर्गेरां एज्जेलो। <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />ते ज़ैना लोक परमेशरे न पिशानन त कने इश्शे प्रभु यीशुएरे खुशखेबरी न मन्न, तैन तै सज़ाह देलो। <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />तैना प्रभुए करां हमेशारे लेई अलग भोल्हे, ते तैसेरे महान शेक्तरे हिस्सेदार न भोल्हे। तै तैन हमेशारी सज़ाह देइतां नाश केरेलो। <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />इना गल्‍लां तेइस भोल्ही ज़ेइस यीशु अपने लोकन करां आदर हासिल केरनेरे लेई वापस एज्जेलो, ते ज़ैना लोक तैस पुड़ विश्वास केरतन तैना हैरान भोल्हे। तुस भी तैन्ने लोकन मरां भोल्हे, किजोकि ज़ै सन्देश असेईं तैसेरे बारे मां तुसन शुनव तुसेईं तैस पुड़ विश्वास कियो। <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />एल्हेरेलेइ अस लगातार तुश्शे लेई प्राथना भी केरतम, कि परमेशर तुसन इस काबल बनाए, ज़ेरि ज़िन्दगी ज़ींनेरे लेई तुस कुजेवरेथ तेन्च़रे तुस ज़ीथ। ते तै तुसन अपने शेक्ति सेइं इस काबल बनालो कि तुस ज़ैना रोड़ू केरथ ते ज़ैन तुस केरनू चाथ, ते ज़ैन कम तुस अपने विश्वासे सेइं केरतथ पूरू केरथ। <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />एन्च़रे इश्शे प्रभु यीशु मसीहेरे नंव्वेरी तुश्शे ज़िरिये बडीयाई भोल्ही। ते तैसेरे ज़िरिये तुसन आदर मैल्हेली। इन सब किछ इश्शे परमेशर त कने प्रभु यीशु मसीहेरे अनुग्रहे सेइं भोल्हु।<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">पापेरो मड़द मतलब विनाशेरू मट्ठू</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />हे ढ्लाव ते बेइनव, असन कां प्रभु यीशु मसीहेरे वापस एजनेरे बारे मां ज़ोनेरे लेई किछ आहे। तै वक्त एज्जेलो ज़ेइस अस तैस सेइं साथी मिलमेले। <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />इन सोचतां तुस परेशान न भोथ या तुश्शो दिल न घबराए कि प्रभुएरी दिहाड़ी पेइली एवरीए। किछ ज़ोई बटतन कि इन भविष्यिवाणी मां या सन्देशे मां या चिट्ठी मां तैन कां एवरू थियूं। <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />लोक ज़ैना इस बारे मां झूठी गल्‍लां ज़ोतन तैन पुड़ विश्वास न केरा। किजोकि यीशु मसीहेरे वापस एजनेरे पेइले, तै वक्त एज्जेलो ज़ेइस बड़े लोक परमेशरेरे खलाफ भोल्हे, ते फिरी अधर्मी मैन्हु बांदो भोल्हो। तै, तै आए ज़ै नाश भोनेरे लेई ठहरावरोए। <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />तै अधर्मी मैन्हु परमेशरेरी खलाफत केरेलो, ते तैन सब किछ ज़ैन लोक देबते सेमझ़तां आराधना केरतन, तै इन ज़ोलो ई अवं इन सेब्भन करां महान आईं। इड़ी तगर कि तै परमेशरेरे मन्दरे मां बिशतां अपनो आपे जो परमेशर ज़ोलो। <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />इन न बिसरां, कि मीं बड़े बार इन गल्‍लां केरे बारे मां ज़ोवरूए, ज़ैखन अवं तुसन सेइं साथी थियो। <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />हुन्ना तै अधर्मी मैन्हु बांदो नईं भोवरो किजोकि कोई आहे ज़ैने तै रोकोरोए, कि तै अपने वक्ते पुड़ बांदो भोए। <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />किजोकि अधर्मी चीज़ां केरि शक्ति इस दुनियाई मां पेइली छ़ेपतां कम केरने लगोरीए, पन अक आहे ज़ै तैस रोकते। ते तै तैस रोकतो रालो ज़ांतगर तै दूर न कियो गाए। <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />तैट्ठां बाद तै दुष्ट मैन्हु एज्जेलो, पन बादे मां ज़ैखन प्रभु यीशु एज्जेलो, त तैस दुष्ट मैन्हु अपने ऐशेरे फुक्‍की सेइं ते एजनेरी महिमाई सेइं मारेलो। <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />तै दुष्ट मैन्हु, शैतानेरे शेक्ति सेइं एज्जेलो। तै हर किसमेरे झूठे चमत्कार ते निशान, ते बडां-बडां कम्मां केरेलो, ताके लोक सोचन कि तै परमेशरे ज़ै एन केरते। <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />ते तै हर किसमेरां बुरां कम्मां केरेलो, ते तैन धोखो देलो ज़ैना परमेशरे नाश केरनेन। किजोकि तैनेईं तैस सच़्च़े पुड़ विश्वास केरने करां इन्कार कियो, ज़ैस सेइं तैन मुक्ति मैल्हेथी। <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />एल्हेरेलेइ परमेशर तैन मां अक धोखो देनेबाली आत्मा भेज़ेलो ज़ै तैन सच़्च़े करां दूर केरेली, ताके तैना झूठे पुड़ विश्वास केरन ज़ैन तै दुष्ट मैन्हु तैन सेइं ज़ोलो। <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />परमेशर तैन सेब्भी लोकन सज़ा देलो ज़ैनेईं यीशु मसीहेरे सच़्च़े सन्देशे पुड़ विश्वास न कियो, पन पाप केरने सेइं खुश भोए।<verse eid="2TH 2:12" /></para>
  <para style="s">मज़बूत बनेरू रानू</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />हे ढ्लाव ते बेइनव, असेईं तुश्शे लेई परमेशरेरू शुक्र कियोरू लोड़े। किजोकि परमेशर तुसन सेइं प्यार केरते, तैने तुस दुनिया बनाने करां पेइले च़ुने, कि पवित्र आत्मारे पवित्र बनाते, ते यीशु मसीहेरे बारे मां ज़ै सच़्च़ो सन्देशे तैस पुड़ विश्वास केरतां परमेशर तुसन मुक्ति दे। <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />ज़ै खुशखबरी असेईं प्रचार की परमेशरे तै इस्तेमाल की, कि तुसन बच़ानेरे लेई कुजाए, तुस इश्शे प्रभु यीशु मसीहेरी महिमाई मां शामल भोथ। <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />एल्हेरेलेइ, ढ्लाव ते बेइनव, ज़ै शिक्षा असेईं तुसन दित्ती, ज़ैखन असेईं तुसन सेइं गल्‍लां की त कने चिट्ठी केरे ज़िरिये, तैस पुड़ तुस लगातार विश्वास केरते राथ। <verse eid="2TH 2:15" /><verse number="16" style="v" sid="2TH 2:16" />अस प्राथना केरतम इश्शो प्रभु यीशु मसीह एप्पू, ते इश्शो बाजी परमेशर ज़ैने असन सेइं प्यार कियो, ते ज़ैने अपने अनुग्रहे सेइं असन हमेशारो होसलो ते पक्‍की उमीद दित्ती, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />तैना तुसन होसलो देन, ते तुसन मज़बूत केरन ताके तुस लगातार भलियाई केरथ ते ज़ैन ज़ोथ तैन रोड़ू भोए।<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">प्राथना केरनेरे बारे मां शिक्षा</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />आखरी मां हे ढ्लाव ते बेइनव, इश्शे लेई प्राथना केरते राथ, कि अस प्रभु यीशुएरू वचन होरि भी बड़े ठैरन शुनेईं बटम, ते ज़ैना शुन्न त तैना तेन्च़रे मनन ज़ेन्च़रे तुसेईं मन्नू। <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />ते ई भी प्राथना केरा कि परमेशर असन बुरे ते दुष्ट लोकां केरे ज़िरिये नुकसान पुज़ाने करां बच़ेइतां रख्खे, किजोकि बड़े लोक ज़ैनेईं प्रभु यीशुएरी खुशखबरी शुनी, ते तैनेईं इस पुड़ विश्वास न कियो।<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />पन तुस प्रभु पुड़ पूरो भरोसो केरि बटतथ, तैए तुसन मज़बूत केरेलो, ते दुष्टे करां यानी शैताने करां बच़ालो, ताके तै तुसन कोई नुकसान न पुज़ेई बटे। <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />ते असन प्रभु मां तुसन पुड़ भरोसोए, कि ज़ैन किछ असेईं तुसन केरनेरे लेई ज़ोवरूए, तुस तेन्च़रे केरते एवरेथ ते एजने बाले वक्ते मां केरते राले। <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />अस प्राथना केरतम, कि प्रभु यीशु मसीह तुसन इन समझ़नेरे काबल बनाए कि परमेशर तुस सेइं केत्रो प्यार केरते, ते बरदाश केरा ज़ेन्च़रे मसीहे बरदाश कियूं।<verse eid="2TH 3:5" /></para>
  <para style="s">कम केरनेरे बारे मां शिक्षा</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />हे ढ्लाव ते बेइनव, अस प्रभु यीशु मसीहेरे दित्तोरे अधिकारे सेइं तुसन ई हुक्म देतम, कि तुसन मरां हर कोई एरे ढ्लान ते बेइन्न सेइं साथ न रख्खे, ज़ैना आलसी आन त कने ज़ै शिक्षा असेईं तुसन दित्ती तैस न मन्न। <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />किजोकि तुस एप्पू रोड़े च़ारे ज़ानतथ, कि तुसेईं तेन्च़रे ज़िन्दगी ज़ीयोरी लोड़े ज़ेन्च़रे असेईं ज़ी, ज़ैखन अस तुसन सेइं साथी थिये, अस आलसी न थिये पन कम केरते थिये। <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />असेईं कोन्चेरी रोट्टी मुफ्त न खाइ, पन अस मेहनत ते कष्टे सेइं रात दिहैड़ी कारोबार केरते थिये, कि अस अपने ज़रूरतां केरे लेई तुसन पुड़ निर्भर न भोम। <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />असेईं बड़ी मेहनत की, एल्हेरेलेइ नईं कि असन अधिकार नईं, कि तुसन हुक्म देम कि तुस इश्शी ज़रूरतां पूरी केरा। पन एल्हेरेलेइ कि असेईं अपनो आप तुश्शे लेई मिसाल बनाई ताके तुस इश्शे ज़ेरि ज़िन्दगी ज़ीथ। <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />ज़ैखन अस तुसन सेइं साथी थिये तैखन असेईं तुसन हुक्म दित्तोरो थियो, कि अगर कोई कम केरने करां इन्कार केरे त तैस रोट्टी भी न देथ। <verse eid="2TH 3:10" /><verse number="11" style="v" sid="2TH 3:11" />इश्शे शुन्ने मां एवरू आहे कि तुसन मां बड़े लोक एरे आन ज़ैना आलसी ज़िन्दगी ज़ीतन। तैना एप्पू कम न केरन, पन होरि केरे कम्मन मां दखल देतन। <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />एरे लोकन अस प्रभु यीशु मसीहेरे दित्तोरे अधिकारे सेइं हुक्म देतम ते समझ़ातम, कि च़ुपच़ाप कम केरतां अपनि ज़िन्दगी ज़ींनेरे लेई कमाई केरन। <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />ते तुस, ढ्लाव ते बेइनव, भलियाई केरने मां हिम्मत न हारा।<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />अगर कोई इश्शी इस चिट्ठरे सन्देशे न मन्ने, त सेब्भी केरे सामने तैसेरी पिशान केरा, ते तैस सेइं साथ न रखा, ताके तै छिथोए; <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />फिरी भी तैस सेइं दुश्मनेरो ज़ेरो बर्ताव न केरा, पन तैस सेइं विश्वासी सैथेरो ज़ेरो बर्ताव केरतां तैस खबरदार केरा, कि ज़ेरू तैने कियूं तैन न केरे।<verse eid="2TH 3:15" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />हुनी अवं प्राथना केरताईं प्रभु ज़ै शान्ति देनेबालोए, तुसन हर वक्त हर किसमे सेइं शान्ति देतो राए, ते प्रभु लगातार तुसन सेब्भन सेइं साथी भोए।<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />अवं पौलुस अपने हथ्थे सेइं नमस्कार लिखताईं, इन मेरू सबूते, अवं चिट्ठी केरे आखरी मां एन्च़रे लिखताईं, ताके हर एक्‍की पतो च़ले कि ई चिट्ठी मेरे तरफांए। <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />इश्शे प्रभु यीशु मसीहेरो अनुग्रह तुसन सेब्भन पुड़ भोतो राए।<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>