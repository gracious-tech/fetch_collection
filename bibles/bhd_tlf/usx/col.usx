<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">Bhadrawahi Bible</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information : Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">कुलुस्सियों</para>
  <para style="toc1">कुलुस्सियों केरे नंव्वे पौलुसेरी चिट्ठी</para>
  <para style="toc2">कुलुस्सियों</para>
  <para style="toc3">कुल.</para>
  <para style="mt">कुलुस्सियों केरे नंव्वे पौलुसेरी चिट्ठी</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">कुलुस्से नगरे जो पौलुसे ई चिट्ठी लिखी। (<char style="xt"><ref loc="COL 1:1">कुल. 1:1</ref></char>) शुरुआती कलीसियाई मां ज़ैना भी लिखने बालेरे विषय चर्चा केरतन इस जो पौलुसेरी कृति ज़ोतन। कुलुस्से नगरे कलीसिया एप्पु पौलुसे शुरू कियोरी थी। पौलुसेरे कोन्ची सैथे भोइ सकते इपफ्रासे तैड़ी खुशखबरी पुज़ाई। (<char style="xt"><ref loc="COL 4:12">कुल. 4:12</ref>,<ref loc="COL 4:13">13</ref></char>) तैड़ी झूठे उस्ताद अलग-अलग झूठी शिक्षा घिन्तां पुज़ोरे थिये। तैनेईं झूठी शिक्षा ते यहूदी केरे झूठे रीति रुवाज़ मसीही विश्वासे सेइं ज़ोतीए। पौलुसे इस झूठी शिक्षारी बगावत केरतां इन सिद्ध कियूं कि मसीह सेभन करां महाने।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग ई. स. 60</para>
  <para style="ip">पौलुसे ई चिट्ठी इन मन्नू गाते कि रोमे मरां लिखोरी थी ज़ैखन पेइली बार तै कैद थियो।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">पौलुसे ई चिट्ठी कुलुस्से नगरेरे कलीसियाई जो लिखोरी थी, “तैना पवित्र ते विश्वासी ढ्लां केरे नंव्वे ज़ैना कुलुस्से मां रहतन।” ई कलीसिया इफिसुस नगरे करां लगभग 150 किलोमीटर दूर लाइकुस नंव्वेरे वैदी मां थी। पौलुस कधे इस कलीसियाई मां न थियो जेवरो (<char style="xt"><ref loc="COL 1:4">कुल. 1:4</ref>;<ref loc="COL 2:1">2:1</ref></char>)</para>
  <para style="is">मकसद</para>
  <para style="ip">पौलुस तैस नाश केरनेबाले झूठी शिक्षारे खलाफ भोते ज़ै कुलुस्सेरे लोकन मां शुरू भोवरी थी। इन झूठी शिक्षां केरे खलाफ पूरी दुनियाई मां मसीहेरी महानता पेश केरनेरे लेई (<char style="xt"><ref loc="COL 1:15">कुल. 1:15</ref>;<ref loc="COL 3:4">3:4</ref></char>) ते विश्वासी लोकन परमप्रधान मसीहेरी तारीफ़ केरते ज़िन्दगी ज़ींनेरी हिम्मत देनेरे लेई (<char style="xt"><ref loc="COL 3:5">कुल. 3:5</ref>;<ref loc="COL 4:6">4:6</ref></char>)। ते झूठे शिक्षां केरे खलाफ भोइतां अपने विश्वासे मां मज़बूत रानेरे लेई ई चिट्ठी लिखी। (<char style="xt"><ref loc="COL 2:2-5">कुल. 2:2-5</ref></char>)</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">मसीह सेभन करां महाने</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. पौलुसेरी प्राथना <char style="ior"><ref loc="COL 1:1-14">1:1-14</ref> </char></para>
  <para style="io1">2. मसीह मां पौलुसेरी शिक्षा <char style="ior"><ref loc="COL 1:15-23">1:15-23</ref> </char></para>
  <para style="io1">3. परमेशरेरी योजना ते मकसदे मां पौलुसेरी ठार। <char style="ior"><ref loc="COL 1:24-2:5">1:24—2:5</ref> </char></para>
  <para style="io1">4. झूठी शिक्षां केरे खलाफ खबरदारी <char style="ior"><ref loc="COL 2:6-15">2:6-15</ref> </char></para>
  <para style="io1">5. झूठी शिक्षान सेइं पौलुसेरो सामनो <char style="ior"><ref loc="COL 2:16-3:4">2:16—3:4</ref> </char></para>
  <para style="io1">6. मसीह मां नंव्वी इन्सानयतरो ज़िक्र <char style="ior"><ref loc="COL 3:5-25">3:5-25</ref></char></para>
  <para style="io1">7. तारीफ़ ते नितीजो <char style="ior"><ref loc="COL 4:1-18">4:1-18</ref> </char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />अवं पौलुस ई चिट्ठी लिखने लगोरोईं, अवं परमेशरेरी मेर्ज़ी सेइं मसीह यीशुएरो प्रेरित आईं, ते विश्वासी ढ्ला तीमुथियुस भी मीं साथीए। <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />मसीह मां तैन पवित्र ते विश्वासी ढ्लां केरे नंव्वे ज़ैना कुल्‍लुसे नगरे मां रहतन।</para>
  <para style="p" vid="COL 1:2">इश्शो बाजी परमेशर तुसन अनुग्रह ते शान्ति देतो राए।<verse eid="COL 1:2" /></para>
  <para style="s">शुक्रेरी प्राथना</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />अस ज़ैखन तुश्शे लेई प्राथना केरतम त अपने प्रभु यीशु मसीहेरे बाजी, परमेशरेरू शुक्र केरतम। <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />किजोकि असेईं शुनोरूए, कि मसीह यीशु पुड़ तुश्शो विश्वासे, ते तुस सेब्भी पवित्र लोकन सेइं प्यार केरतथ। <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />तैस उमीद कियोरी चीज़रे वजाई सेइं ज़ै तुश्शे लेई सुर्गे मां रख्खोरीए, ज़ेसेरे बारे मां तुसेईं तैस खुशखेबरारे सच़्च़े वचने सेइं शुनू, ज़ैन तुसन कां पुज़ोरूए। <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />ते ज़ेन्च़रे दुनियाई मां भी फल आनते, ते बद्धतो गाते; मतलब ज़ैस दिहैड़ी करां देंतू तुसेईं तैन शुनू, ते सच़्च़ैई सेइं परमेशरेरो अनुग्रह पिशानो, तुसन मां भी एरू केरि बटते। <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />तैसेरी शिक्षा तुसेईं इश्शे ट्लारे मद्दतगार इपफ्रासे करां हासिल की, ज़ै इश्शे लेई मसीहेरो वफादार सेवके। <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />तैने तुश्शे प्यारेरे बारे ज़ोवं ज़ै होरि लोकां केरे लेईए, ज़ै पवित्र आत्मा मांए तुसन दित्तोरोए।<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />एल्हेरेलेइ ज़ैस दिहैड़ी करां इन शुनू, त असेईं हमेशा तुश्शे लेई प्राथना की, कि परमेशरेरी आत्मा तुसन अक्ल ते समझ़ दे ज़ैस सेइं तुस तैसेरी मर्ज़ी पूरे तरीके सेइं सेमझ़ी बटेले। <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />ताके तुस तेरही ज़िन्दगी ज़ीथ ज़ेरि प्रभुएरे लोकेईं ज़ीयोरी लोड़े, ते तुस प्रभुए हर बत्तां खुश केरथ, ताके तुस लगातार हर किसमेरी भलियाई केरते राथ, ते परमेशरेरी पिशानी मां बद्धते गाथ। <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />अवं प्राथना केरताईं कि परमेशर अपनि महिमारे शेक्तरे इस्तेमाल केरनेरे ज़िरिये तुसन मज़बूत केरे, ताके तुस आनन्दे ते सबरी सेइं दुख झ़ेल्‍ली बटतथ। <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />बाजी परमेशरेरू शुक्र केरते राथ, ज़ैने अस इस काबल बनाए कि सुर्गेरे राज़्ज़े मां तैसेरे अपने लोकन सेइं साथी विरासती मां हिसेदार भोम। <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />किजोकि तैने अस शैतानेरे अधिकारे मरां छुटेइतां अपने ट्लारे मट्ठेरे राज़्ज़े मां आने <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />परमेशरेरे अपने मट्ठेरे बलिदाने सेइं असन पापां केरि माफ़ी दित्ती (यानी शैतानेरे राज़्ज़े करां आज़ाद किये)।<verse eid="COL 1:14" /></para>
  <para style="s">मसीह महान आए ते तैसेरां कम्मां</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />परमेशरे त कोई न लेही बटे, पन ज़ैखन तैसेरू मट्ठू मैन्हु बनू त तैनी परमेशर लोकन पुड़ बांदो कियो, ज़ैन किछ परमेशरे बनाव तैस पुड़ तैस कां सेब्भना जादे अधिकारे। <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />किजोकि ई तै (मसीह) थियो ज़ैने सब किछ बनानेरे वक्ते परमेशरे सेइं कम कियूं, चाए अम्बरे पुड़ भोन या धेरती पुड़ भोन, लेवहरी भोन या आलेई, कुन तखत भोन, या रियासतां, कुन हुकूमतां भोन या अधिकार, सैरी चीज़ां तैस्से सेइं ते तैसेरेलेइ बनेइ। <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />ते मसीह सेब्भी चीज़ां बनाने करां पेइलो थियो, ते सब चीज़ां तैस मां बनोरी रैतिन। <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />तैए कलीसियारो प्रधाने ज़ै तैसेरी जाने; तैए पेइलोए ते मुड़दन मरां ज़ींतो भोने बालन मरां पेइलोए कि सेब्भी गल्‍लन मां तैए प्रधान भोए। <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />किजोकि बाजी परमेशर इस्से मां खुशी भोते कि मसीह मां तैसेरे सारे सुभाव बास केरतन। <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />परमेशरे फैसलो कियो कि अपने मट्ठे भेज़े, ज़ैने अपनो खून बगाव ते क्रूसे पुड़ अपनि जान दित्ती। परमेशरे सेब्भी चीज़न सेइं मेल मलाप केरनेरे लेई एन कियूं। एन्च़रे तैनी मसीहेरे ज़िरिये सेइं सेब्भी चीज़ां केरो मेल मिलाप एप्पू साथी कियो, चाए तैना धेरतरी भोन, चाए सुर्गेरी भोन।<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />ते तुस ज़ैना पेइले परमेशरे करां दूर थिये, ते बुरे कम्मन सेइं मने सेइं बैरी थी। <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />फिरी भी परमेशर अपने मट्ठे यीशुएरे मैन्हु बन्ने सेइं ते क्रूसे पुड़ मौतरे ज़िरिये तुश्शो मेल कराव, ताके तुसन एप्पू कां पवित्र ते बे दाग ते बेइलज़ाम हज़ार केरे। <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />पन तुस मसीह पुड़ विश्वास केरनेरे मां बुनियादरे ज़ेरे मज़बूत राथ, ते तैस खुशखेबरारे उमीदी पुड़ ज़ै तुसेईं शुनोरी एन शारथ, ज़ेसेरो प्रचार अम्बरे करां बुन सैरी सृष्टि मां कियो जेव; ते ज़ैस मां अवं पौलुस सेवक बनो।<verse eid="COL 1:23" /></para>
  <para style="s">कलीसियारो सेवक-पौलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />हुनी अवं तैन दुखन सेइं खुशी आईं, ज़ैना तुश्शे लेई झ़ल्‍लताईं, ते मसीहेरी दुखां केरि घटी तैसेरे जानरे लेई, मतलब कलीसियारे लेई, अपने जिसमे मां पूरी केरताईं। <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />ज़ेसेरो अवं परमेशरेरे इंतज़ामेरे मुताबिक सेवक बनो, ज़ै तुश्शे लेई मीं सौंफो, ताके अवं परमेशरेरू वचन पूरो-पूरो प्रचार केरि। <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />मतलब तैस भेदे ज़ै ज़ुमाना ते पीढ़न करां छ़पोरो थियो, पन हुनी तैसेरे तैन पवित्र लोकन पुड़ बांदो भोवरोए। <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />ज़ैन पुड़ परमेशरे बांदो केरनो चाव, कि तैन ज्ञान भोए होरि कौमन मां तैस भेदेरी महिमारी कीमत कुने ते तै ईए, कि मसीह ज़ै महिमारी उमीदे तुसन मां रहते। <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />ज़ेसेरो प्रचार केरतां अस हर एक्‍की मैन्हु ज़ोतम ते सारे ज्ञाने सेइं हर एक्‍की मैन्हु शिखालतम, कि अस हर एक्‍की मैन्हु मसीह कां सिद्ध केरतां पेश केरम। <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />ते एल्हेरेलेइ अवं तैसेरी शेक्तरे मुताबिक ज़ै मीं मां शेक्ति सेइं साथी अस्सर केरतीए तन मन लेइतां मेहनत भी केरतम।<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />अवं चाताईं कि तुस ज़ानथ, कि तुश्शे ते तैन केरे ज़ैना लौदीकिया नगरे मां आन, ते तैन सेब्भी केरे लेई ज़ैनेईं अवं नईं लाहोरो कि अवं केन्च़रे मेहनत केरताईं। <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />ताके तैन केरे मन्न मां शान्ति भोए ते तैना प्यारे सेइं एप्पू मांमेइं बनोरे रान, ते तैस पूरी समझ़रू धन हासिल केरन, बाजी परमेशरेरे भेदे मतलब मसीह पिशानन। <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />ज़ैस मां समझ़रे ते ज्ञानेरे सारे भण्डार छ़पोरेन। <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />इन अवं एल्हेरेलेइ ज़ोताईं, कि कोई मैन्हु तुसन लालच़ देने बैली चीज़ी सेइं धोखो न दे। <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />किजोकि अवं अगर जिसमेरे लिहाज़े सेइं दूराई, फिरी भी आत्मिक लिहाज़े सेइं नेड़ो आईं, ते तुश्शे रीति सेइं तुश्शी हालती ते तुश्शे विश्वासे ज़ै मसीह यीशु मां मज़बूती हेरतां खुश भोव।<verse eid="COL 2:5" /></para>
  <para style="s">मसीह मां ज़िन्दगरी भरपूरी</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />ते ज़ेन्च़रे तुसेईं मसीह यीशु अपनो प्रभु कबूल कियोरोए, तेन्च़रे तैस मां च़लते भी राथ। <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />ते तैस मां ज़ील छ़डते राथ ते बद्धते राथ; ते ज़ेन्च़रे तुस शिखालोरेथ तेन्च़रे विश्वासे मां मज़बूत भोते गाथ, ते खूब शुक्र केरते राथ।<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />खबरदार राथ कि तुसन कोई तैसेरे ज्ञाने ते धोखे सेइं शिकार न केरे, ज़ैन मैन्हु केरू रुवाज़ेरू ते दुनियारी पेइली शिक्षारे मुताबिके पन मसीहेरे नईं। <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />किजोकि तैस मां ईश्वरत्वेरी सारी भरपूरी जानी मां एइतां बास केरती। <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />ते तुस तैस मां भरपूर भोवरेथ ज़ै सैरी हुकूमती ते अधिकारेरी क्रोड़ी। <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />तैस्से मां तुश्शो एरो खतनो भोवरोए, ज़ै हथ्थेरो नईं, मतलब मसीहेरोए खतनो, ज़ैस सेइं तुश्शी पुरानी इन्सानयत अलग की गातीए। <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />ते तैस्से सेइं साथी बपतिस्मे मां दब्बे जे, ते तैस्से मां परमेशरेरी शेक्ति पुड़ विश्वास केरतां, ज़ैने तै मुड़दन मरां ज़ींतो कियो, तुस भी तैस सेइं साथी ज़ींते किये। <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />ते तैने तुस भी, ज़ैना अपने पापन, ते अपने जिसमेरे खतनेरे हालती मां मरोरे थी, तैस सेइं साथी ज़ींते भी केरे, ते इश्शे सब पाप माफ़ केरे। <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />ते विधि केरो तै लेख ज़ै इश्शे नंव्वे पुड़ ते इश्शे खलाफ थियो मिटव; ते तैस क्रूसे पुड़ कील देइतां दूर केरो। <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />ते तैने प्रधान्न ते अधिकैरन हारेइतां तैन केरो खुल्‍लो मुखूल्‍लो तमाशो बनावं ते क्रूसे सेइं जयजयकार भी केरू।<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />एल्हेरेलेइ खानू पीनू या तिहार या नव्वीं चाँदनी, या आरामेरे दिहाड़ां केरे बारे मां तुश्शो कोई फैसलो न केरो। <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />किजोकि सब एजने बैली गल्‍लां केरि छावे, पन असली चीज़ां मसीहेरिन। <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />कोई मैन्हु दीनता ते स्वर्गदूतां केरि पूज़ा पसंद केरतां तुश्शी दौड़रे इनामे करां दूर न रख्खे। एरो मैन्हु लेवहरी गल्‍लन मां लग्गोरो रहते ते एपनी जिसमानी समझ़ी पुड़ बेफैइदो फुलते। <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />ते तैस क्रोड़ी ट्लेइतां न रखन ज़ै मसीहे ते ज़ैस सेइं सारो जिसम जोड़न ते पठां केरे हिफाज़ती सेइं ते एक्‍की सेइं साथी ज़ुड़तां, परमेशरेरे तरफां बद्धतो गाते।<verse eid="COL 2:19" /></para>
  <para style="s">मसीह सेइं साथी ज़ींनू ते मरनू</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />ज़ैखन कि तुस मसीह सेइं साथी दुनियारे पेइली शिक्षाई सेइं मरोरेथ, त फिरी तैन केरे ज़ेरे ज़ैना दुनियाई मां ज़िन्दगी बीतातन मैन्हु केरे हुक्म ते शिक्षा सेइं, <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />ते एरी शिक्षा मां किजो रहतथ कि इस सेइं नईं हुरनु, एन नईं खानू, ते तैस सेइं हथ नईं लानो? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />(किजोकि इना सब चीज़ां कम्मे मां आनते-आनते नाश भोइ गैली)। <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />इन गल्‍लन मां एपनी मेर्ज़री मुताबिक अपनि बनेवरी भेक्ति सेइं, ते दीनता, ते जिसमानी अभ्यासे सेइं ज्ञानेरू कम त आए, पन जिसमानी खुवैइशन रोकने मां इन सेइं किछ भी फैइदो न भोए।<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />ते ज़ैखन तुस मसीह सेइं साथी ज़ींते किये, त सुर्गेरे चीज़ां केरे तोपी मां राथ, ज़ैड़ी मसीह मौजूदे ते परमेशरेरे देइने पासे बिशोरोए। <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />धेरतरे नईं पन सुर्गेरे चीज़न पुड़ ध्यान लाथ। <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />किजोकि तुस त मरे, ते तुश्शी ज़िन्दगी मसीह सेइं साथी परमेशरे मां छ़पोरीए। <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />ज़ैखन मसीह ज़ै इश्शी ज़िन्दगीए, बांदो भोल्हो, तैखन तुस भी तैस सेइं साथी महिमा साथी बांदे किये गाले।<verse eid="COL 3:4" /></para>
  <para style="s">पुरानी ते नंव्वी ज़िन्दगी</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />एल्हेरेलेइ अपने तैन अंगन मैरी देथ, ज़ैना धेरती पुड़ आन, मतलब बदमाशी, गन्दगी, बुरे खियाल, बुरी खुवैइश ते लालच़े ज़ैन मूरती पूज़ने बराबरे। <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />इन केरे वजाई सेइं परमेशरेरो क्रोध हुक्म न मन्ने बालन पुड़ एइते। <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />ते तुस भी, ज़ैखन इन बुरैइयन मां ज़िन्दगी बीताते थिये, त इन केरे मुताबिक च़लते भी थी। <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />पन हुनी तुस भी इन सेब्भन मतलब क्रोध, सरक, बैर, तुहीन, गैई देनी इना सब गल्‍लां शारा। <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />एक्‍की होरि सेइं झूठ न ज़ोथ किजोकि तुसेईं पुरानी इन्सानयत तैसेरे कम्मन समेत खोलोरीए। <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />ते नव्वीं इन्सानयत लेवरीए ज़ै अपने बनाने बालेरे रूपेरे मुताबिक ज्ञान हासिल केरनेरे लेई नंव्वी बनातीए। <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />तैस मां न कोई यूनानी राव, न यहूदी, न बगैर खतने बालो, न जंगली, न स्कूती, न गुलाम न आज़ाद, सिर्फ मसीह सब किछ ते सेब्भन मांए।<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />एल्हेरेलेइ परमेशरेरे च़ुनोरां केरे ज़ेरे ज़ैना पवित्र ते ट्लारेन, बड़ी करुणा, ते भलियाई, ते दीनता, ते नम्रता, ते बरदाशत धारण केरा। <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />ते अगर केन्ची, केन्ची पुड़ दोष लांनेरी वजा भोए, त एक्‍की होरेरी झ़ैल्‍लां, ते एक्‍की होरेरे पाप माफ़ केरा, ज़ेन्च़रे प्रभुए तुश्शे पाप माफ़ केरे, तेन्च़रे तुस भी केरा। <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />इन सेब्भन करां बा प्यारे ज़ै सेब्भन सिद्धतारो पटकोए बन्धा। <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />ते मसीहेरी शान्ति ज़ेसेरे लेई तुस अक जान भोनेरे लेई कुजेवरे भी आथ, तुश्शे दिलन मां राज़ केरे, ते तुस शुक्र केरते राथ। <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />मसीहेरे वचन अपने दिलन मां रोड़ेच़ारे बस्सने देथ; ते सारे ज्ञाने सेइं एक्‍की होरि शिखाला, ते नसीहत देथ, ते अपने-अपने मन्न मां अनुग्रहे साथी परमेशरेरे लेई भजन ते स्तुति ते आत्मिक गीत ज़ोते राथ। <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />ते वचन या कम ज़ैन किछ भी केरा सब प्रभु यीशुएरे नंव्वे सेइं, ते तैसेरे ज़िरिये बाजी परमेशरेरू शुक्र केरा।<verse eid="COL 3:17" /></para>
  <para style="s">नंव्वे ज़िन्दगरे परिवारे मां नियम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />हे कुआन्शव, ज़ेन्च़रे प्रभु मां जाइज़े, तेन्च़रे अपने-अपने मुन्शां केरे अधीन राथ। <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />हे मुन्शव, एपनी-एपनी कुआन्शन सेइं प्यार रखा, ते तैन सेइं सखत बर्ताव न केरा। <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />हे बच़ाव, सेब्भी गल्‍लन मां अपने-अपने अम्मा बाजी केरो हुक्म मन्ना, किजोकि प्रभु इस सेइं खुश भोते। <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />हे बच्‍चन बालव, अपने बच्‍चन तंग न केरा, एरू न भोए कि तैन केरि हिम्मत न ट्लुटे। <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" />हे सेवकव, ज़ैना जिसमेरे मुताबिक तुश्शे मालिकन, सेब्भी गल्‍लन मां अपने मालिकां केरो हुक्म मन्ना, मैन्हन खुश केरनेरे बालां केरे ज़ेरे हिरानेरे लेई नईं, पन सच़्च़े मने सेइं ते परमेशरेरे डरे सेइं। <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />ते ज़ैन किछ तुस केरतथ, तैन मने सेइं केरा, इन समझ़तां कि मैन्हु केरे लेई नईं पन प्रभुएरे लेई केरतथ। <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />किजोकि तुस ज़ानतथ कि तुसन एसेरे बदले प्रभु करां बदले मां मीरास मैल्‍लनीए, तुस प्रभु यीशु मसीहेरी सेवा केरतथ। <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />किजोकि ज़ै बुराई केरते, तैस एपनी बुरैइयरो फल मैलनोए; तैड़ी केन्चरी तरफदारी नईं।<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />हे मालिकव, अपने-अपने गुलामन सेइं साथी न्याय ते ठीक-ठीक बर्ताव केरा, इन सेमझ़तां कि सुर्गे मां तुश्शो भी अक मालिके।<verse eid="COL 4:1" /></para>
  <para style="s">किछ बरतावेरे लेई सलाह</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />प्राथना मां लग्गोरो राथ, ते शुक्र सेइं साथी हुशार राथ। <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />साथी इश्शे लेई भी प्राथना केरते राथ, कि परमेशर इश्शे लेई शुनानेरे लेई एरी बत खोल्‍ले, कि अस मसीहेरे तैस भेदेरे बारे मां ज़ोई बटम ज़ेसेरे लेई अवं कैदे मां आई। <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />ते तैस बांदो केरि, ज़ेन्च़रे मीं कियोरू लोड़े। <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />वक्त कीमती सेमझ़तां बेइरन साथी समझ़दैरी सेइं बर्ताव केरा। <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />तुश्शो वचन सदा अनुग्रहे सेइं ते एरो लूनो भोए, कि तुसन हर एक्‍की मैन्हु रोड़ेच़ारे जुवाब देनो एज्जे।<verse eid="COL 4:6" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />ट्लारे ढ्ला ते वफादार सेवक, तुखिकुसे ज़ै प्रभु मां मेरो मद्दतगार, तै मेरी सेब्भी गल्‍लन मां तुसन ज़ोलो। <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />तै मीं एल्हेरेलेइ तुसन कां भेज़ो, कि तुसन इश्शी हालतरो पतो भोए ते तै तुश्शे दिलन शान्ति दे। <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />ते तैस सेइं साथी उनेसिमुस भी भेज़ो ज़ै वफादार ते ट्लारो ढ्लाए ते तुसन मरांए, ते तुसन इड़ी तगर सैरी गल्‍लां ज़ोले। <verse eid="COL 4:9" /><verse number="10" style="v" sid="COL 4:10" />अरिस्तर्खुस ज़ै मीं सेइं साथी कैदीए, ते मरकुस ज़ै बरनबासेरो ढ्लाए लगते। (ज़ेसेरे बारे मां तुसन हुक्म मैल्होरो थियो कि अगर तै तुसन कां एज्जे, त तैस सेइं रोड़ेच़ारे बर्ताव केरथ) <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />ते यीशु ज़ै जो यूस्तुस ज़ोतन, तै तुसन नमस्कार ज़ोते। खतनो केर्रे लोकन मां सिर्फ ईए परमेशरेरे राज़्ज़े लेई मद्दतगार ते मेरे शैन्तरी वजा राए। <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />इपफ्रास ज़ै तुसन मरांए, ते मसीह यीशुएरो दासे, तुसन जो नमस्कार ज़ोते ते सदा तुश्शे लेई प्राथना केरते, ताके तुस सिद्ध भोइतां पूरे विश्वासे सेइं साथी परमेशरेरे मेर्ज़ी पुड़ मज़बूत राथ। <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />अवं तैसेरो गवाह आईं, कि तै तुश्शे लेई ते लौदीकिया ते हियरापुलिस बालां केरे लेई बड़ी कोशिश केरतो रहते। <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />ट्लारे तबीब लूका ते देमासेरू तुसन नमस्कार। <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />लौदीकिया नगरेरे ढ्लान ते नुमफास ते तैन केरे घरेरे कलीसियान जो नमस्कार ज़ोथ। <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />ते ज़ैखन ई चिट्ठी तुश्शे इड़ी पढ़ी गाए, त एरू केरनू कि लौदीकियारे कलीसियाई मां भी पढ़ी गाए, ते तै चिट्ठी ज़ै लौदीकियारां एज्जे तैस तुस भी पेढ़थ। <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />फिरी अरखिप्पुसे सेइं ज़ोइयथ कि ज़ै सेवा प्रभु मां तीं सौंफी, तैस बड़े हूशैरी सेइं पूरी केरथ।<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />अवं पौलुस अपने हथ्थन सेइं नमस्कार लिखताईं। मेरी शंगलन याद रखा; तुसन पुड़ अनुग्रह भोतो राए। आमीन।<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>