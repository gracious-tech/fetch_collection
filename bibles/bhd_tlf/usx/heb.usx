  <para style="h">इब्रानियों</para>
  <para style="toc1">इब्रानियों केरे नंव्वे चिट्ठी</para>
  <para style="toc2">इब्रानियों</para>
  <para style="toc3">इब्रा.</para>
  <para style="mt">इब्रानियों केरे नंव्वे चिट्ठी</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">इब्रानियों केरे चिट्ठरो लिखने बालो कौने एन अक राज़े। किछ विद्वान पौलुसे इसेरो लिखने बालो मनतन पन इसेरे लिखने बालेरो पतो नईं। बाकी कोई भी नईं ज़ै विश्वासी लोकां केरे लेई एरी खूबसूरती सेइं मसीहे प्रधान याजक हिराए। तै हारूनेरे याजक भोने करां भी महाने ते तैए परमेशरेरे तरफां दित्तोरे कानून ते नेबी केरि ज़ोवरू गल्‍लां पूरी केरते। ई किताब मसीहे इश्शो विश्वासेरो रच़ने बालो ते सिद्ध केरनेबालो हिरातीए। (<char style="xt"><ref loc="HEB 12:2">इब्रा. 12:2</ref></char>)।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग ई. स. 64-70</para>
  <para style="ip">इस चिट्ठरी लिखनेरी ठार यरूशलेम थी। यीशुएरे सुर्गे जो गानेरां बाद ते इस्राएलेरे मन्दरेरे बिछ़ड़ने करां पेइले।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">ई चिट्ठी खास केरतां तैन यहूदी केरे लेई लिखोरी थी ज़ैनेईं मसीह कबूल कियोरो थियो। तैना पुराने नियमे ज़ानते थिये पन तैना इस अज़मैइशी मां थिये कि दुबारां पुराने यहूदी फिरके मां च़ले गान या खुशखबरी अक यहूदी विधि बनान। अक सुझाव ई भी आहे कि इनां लोक “जादे याजक थिये ज़ैनेईं विश्वास कियोरो थियो।” (<char style="xt"><ref loc="ACT 6:7">प्रेरित. 6:7</ref></char>)।</para>
  <para style="is">मकसद</para>
  <para style="ip">लिखने बालो ज़ैन केरे लेई चिट्ठी लिखी रेवरोए तैन केरि हिम्मत बधानी चाते कि तैना तैट्ठेरे यहूदी शिक्षान शैरतां यीशु सेइं वफादार रान। ते इन बांदू केरन कि मसीह यीशु महाने, परमेशरेरू मट्ठू स्वर्गदूतन करां, याजकन करां, पुराने नियमेरे नेबन करां या बाकी कोन्ची भी धर्मे करां महाने। क्रूसे पुड़ मेरतां ते फिरी ज़ींते भोइतां यीशु विश्वासी लोकन मुक्ति ते हमेशारी ज़िन्दगी पक्‍की केरते। इश्शे पापां केरे लेई मसीहेरू बलिदान सिद्ध ते पूरू भोते। विश्वास परमेशरे कबूले। असां परमेशरेरे हुक्म मेनतां विश्वासे बांदो केरतम।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">मसीह महाने</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. मसीह यीशु स्वर्गदूतन करां महाने <char style="ior"><ref loc="HEB 1:1-2:18">1:1—2:18</ref> </char></para>
  <para style="io1">2. यीशु इस्राएलेरे विधान ते पुराने करारे करां महाने <char style="ior"><ref loc="HEB 3:1-10:18">3:1—10:18</ref></char></para>
  <para style="io1">3. वफादार ते दुख झ़ल्‍लनेरी बुलाहट <char style="ior"><ref loc="HEB 10:19-12:29">10:19—12:29</ref> </char></para>
  <para style="io1">4. आखरी नमस्कार <char style="ior"><ref loc="HEB 13:1-25">13:1-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />परमेशरे बड़े पेइले इश्शे दादे पड़दादन सेइं बड़े बारे ते अलग-अलग किसमे सेइं नेबी केरे ज़िरिये गल्‍लां की। <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />पन इन आखरी दिहाड़न मां परमेशरे असन सेइं अपने मट्ठेरे ज़िरिये गल्‍लां की, ज़ैन तैनी सैरी चीज़ां केरू बारस ठहराव ते तैसेरे ज़िरिये परमेशरे सारी सृष्टि बनाई। <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />मट्ठू परमेशरेरी महिमारू प्रकाशे, ते तैन हर किसमे सेइं परमेशरेरू ज़ेरूए, तैन्ने सैरी चीज़न अपने शेक्तरे वचनेरे ज़िरिये सेइं सम्भालते, तैन्ने लोकन पापन करां शुद्ध केरतां सुर्गे मां परमेशरेरे महिमाई मां देइने पासे बिश्शू। <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />एन केरने सेइं परमेशरे मट्ठू, स्वर्गदूतन करां महान कियूं, ते ज़ैन नवं तैस दित्तू जेवं तैन स्वर्गदूतन करां महाने।<verse eid="HEB 1:4" /></para>
  <para style="s">परमेशरेरे मट्ठू स्वर्गदूतन करां महाने</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />किजोकि परमेशरे स्वर्गदूतन मरां कोन्ची सेइं कधे नईं ज़ोवरू,</para>
  <para style="q" vid="HEB 1:5">“तू मेरू मट्ठू आस;</para>
  <para style="q" vid="HEB 1:5">अज़ अवं इन बांदू केरताईं तू मेरू मट्ठू आस”</para>
  <para style="q" vid="HEB 1:5">ते फिरी परमेशरे केन्ची स्वर्गदूते सेइं इन नईं ज़ोवरू,</para>
  <para style="q" vid="HEB 1:5">“अवं तैसेरो बाजी भोइलो,</para>
  <para style="q" vid="HEB 1:5">ते तैन मेरू मट्ठू भोल्हु”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />ते फिरी परमेशरे अपने पेइले मट्ठे दुनियाई मां भेज़ने करां पेइलू, इन ज़ोवं, “परमेशरेरे सब स्वर्गदूत तैस कां मथ्थो टेकन।” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />परमेशर स्वर्गदूतां केरे बारे मां इन ज़ोते,</para>
  <para style="q" vid="HEB 1:7">“‘तै अपने स्वर्गदूतन हवारे ज़ेरे बनाते,</para>
  <para style="q" vid="HEB 1:7">ते अपने सेवकन अग्गरे लप्परे ज़ेरे बनाते।’<verse eid="HEB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 1:8" />पन परमेशरे अपने मट्ठेरे बारे मां ज़ोते,</para>
  <para style="q" vid="HEB 1:8">‘हे परमेशर तेरू राज़ सदा रालू,</para>
  <para style="q" vid="HEB 1:8">ते तू न्याये सेइं राज़ केरेलो।<verse eid="HEB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 1:9" />ज़ैन रोड़ूए तैस केरने सेइं तू प्यार केरतस ते ज़ैन गलते तैन केरने सेइं नफरत केरतस;</para>
  <para style="q" vid="HEB 1:9">एल्हेरेलेइ तेरे परमेशरे तू च़ुनोरोस</para>
  <para style="q" vid="HEB 1:9">ते तेरे सैथन करां जादे तीं आदर ते आनन्द दित्तोरोए।’<verse eid="HEB 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 1:10" />ते पवित्रशास्त्र इन भी ज़ोते, ‘हे प्रभु, तीं शुरू मां दुनियारी रच़ना की,’</para>
  <para style="q" vid="HEB 1:10">ते ज़ैन किछ अम्बरे मांए तैन तीं बनावं।<verse eid="HEB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 1:11" />तैन सब किछ खतम भोइ गानूए; पन तू हमेशा रालो;</para>
  <para style="q" vid="HEB 1:11">ते तैन सब किछ लिगड़ां केरू ज़ेरू पुरानू भोइ गालू।<verse eid="HEB 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 1:12" />ते तू तैन च़ादरारू ज़ेरो बनालो,</para>
  <para style="q" vid="HEB 1:12">ते तैन लिगड़ां केरू ज़ेरू बेदलोई गालू;</para>
  <para style="q" vid="HEB 1:12">पन तू कधे न बेदलोस;</para>
  <para style="q" vid="HEB 1:12">ते तेरी ज़िन्दगी कधी खतम न भोल्ही।<verse eid="HEB 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HEB 1:13" />ते परमेशरे स्वर्गदूतन मरां केस सेइं किताली ज़ोवं,</para>
  <para style="q" vid="HEB 1:13">‘तू मेरे देइने पासे आदरारे ठैरी बिश,’</para>
  <para style="q" vid="HEB 1:13">ते अवं तेरे दुश्मन तेरे अधीन केरेलो।”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />तैना सब स्वर्गदूत सिर्फ परमेशरेरे सेवक आन; परमेशरे तैना तैन लोकां केरि हिफाज़त केरनेरे लेई भेज़ोरेन ज़ैन मुक्ति मैल्होरीए।<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />एल्हेरेलेइ, ज़ैना गल्‍लां असेईं शुनोरिन, तैन पुड़ असेईं होरो भी मन लेइतां ध्यान कियेरू लोड़े, कोस्कोई एरू न भोए, कि असां टेपलोइतां तैन करां दूर च़ले गाम। <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />किजोकि ज़ैन वचन परमेशरे स्वर्गदूतां केरे ज़िरिये ज़ोवरू थियूं, तैन सच़्च़ू साबत भोवं, ते हर एक्‍की पाप केरनेबाले ते हुक्म न मन्नेबाले सज़ाह मैल्ही। <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />त असन भी सज़ाह मैल्हेली, अगर अस एत्री महान मुक्ति करां बे खबर राए त। ज़ेसेरे बारे मां पेइले प्रभुए एप्पू ज़ोवरूए, ते ज़ैन चेलेईं एन प्रभु करां शुनोरू थियूं तैन केरे ज़िरिये असन याकीन भोवं कि एन सच़्च़े। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />परमेशरे भी निशान ते चमत्कार ते बड्डां-बड्डां कम्मां केरे ज़िरिये ते अपने मेर्ज़रे मुताबिक लोकन पवित्र आत्मारे ज़िरिये वरदान देइतां इन साबत कियूं।<verse eid="HEB 2:4" /></para>
  <para style="s">इश्शो मुक्ति देनेबालो</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />परमेशरे एजने बैली दुनिया ज़ेसेरे बारे मां अस ज़ोने लगोरेम, स्वर्गदूत केरे अधीन मां न की पन प्रभु यीशुएरे अधीन की। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />बल्के पवित्रशास्त्रे मां कोस्कोई केन्चे परमेशरे सेइं एन ज़ोवरूए,</para>
  <para style="q" vid="HEB 2:6">“मैन्हु कुन चीज़े, ज़ेसेरे बारे मां तू सोचतस?</para>
  <para style="q" vid="HEB 2:6">या इन्सान कौने, कि तू तैसेरी फिक्र केरतस?<verse eid="HEB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 2:7" />तीं तै शेक्ति मां किछ वक्तेरे लेई स्वर्गदूतन करां थोड़ो ज़ेरो घट कियो,</para>
  <para style="q" vid="HEB 2:7">ते तीं तैस राज़ेरी ज़ेरि महिमा ते आदर दित्तोरीए, ते तैस अपने हथ्थां केरे कम्मन पुड़ अधिकार दित्तो।<verse eid="HEB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 2:8" />तीं तैस सेब्भी चीज़न पुड़ अधिकार दित्तोरोए,”</para>
  <para style="q" vid="HEB 2:8">ज़ैखन सब किछ तैसेरे अधिकारे मां कियूं,</para>
  <para style="p" vid="HEB 2:8">ते किछ भी बाकी न रख्खू, ज़ैन तैसेरे अधीन न भोए। पन असां हुन्ना तगर सैरी चीज़ां तैसेरे अधिकारे मां न लहम। <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पन असां यीशु लहतम, ज़ै स्वर्गदूतन करां किछ वक्तेरे लेई निकड़ो कियोरो थियो, ताके तै परमेशरेरे अनुग्रहे सेइं सेब्भी केरे लेई अपनि जान दे। किजोकि यीशुए दुख बरदाश कियो ते मरो, ते हुनी अस ज़ानतम कि तैस महिमा ते आदर दित्तोरीए। <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />परमेशरे सब किछ बनाव, ते तै सब किछ अपने लेई सुमैलतां रखते। परमेशरे ठीक कियूं ज़ैन तैनी दुखेरे ज़िरिये यीशु सिद्ध कियो, ताके तै बड़े लोकन महिमाई मां पुज़ाए। किजोकि यीशु ही आहे ज़ै असन मुक्तरे पासे नेते। <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />किजोकि पवित्र केरनेबालेरो ते पवित्र भोनेबालां केरो बाजी अक्‍के, एल्हेरेलेइ यीशु तैन जो ढ्ला बेइन ज़ोने करां न शरमाए। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />पन मसीह परमेशरे सेइं ज़ोते,</para>
  <para style="q" vid="HEB 2:12">“अवं अपने लोकन इन ज़ोलो कि तीं मेरे लेई इन कियोरूए,</para>
  <para style="q" vid="HEB 2:12">ते तैन केरे सभाई मां तेरे नंव्वेरू गीत ज़ोइलो।”<verse eid="HEB 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HEB 2:13" />ते फिरी तै ज़ोते,</para>
  <para style="q" vid="HEB 2:13">“अवं तैस पुड़ भरोसो रेखेलो।”</para>
  <para style="p" vid="HEB 2:13">ते फिरी तै ज़ोते,</para>
  <para style="q" vid="HEB 2:13">“अवं तैन लोकन सेइं साथी भोनोईं, ज़ैना परमेशरे मीं दित्तोरेन।”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />किजोकि ज़ेन्च़रे परमेशरेरे बच्‍चे, मैन्हु आन, तेन्च़रे यीशु भी तैन केरो ज़ेरो मैन्हु बनो। परमेशरे एन एल्हेरेलेइ कियूं ताके तैसेरे मौतरे ज़िरिये शैताने बरबाद केरे ज़ैस कां मौतरो अधिकार थियो। <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />ते एन्च़रे तैनी तैना आज़ाद किये ज़ैना मौतरे डरे सेइं सैरी उमरी गुलामेरे ज़ेरे ज़ीते थिये। <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />किजोकि प्रभु यीशु स्वर्गदूतां केरि नईं बल्के अब्राहमेरे वंशेरी मद्दत केरते। <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />एल्हेरेलेइ यीशु मसीहे हर गल्‍ली मां मैन्हु केरो ज़ेरो बन्नू ज़रूरी थियूं, ताके सेब्भी केरे पापां केरे बलिदानेरे लेई परमेशरेरे सामने दया केरनेबालो ते ईमानदार महायाजक बने। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />किजोकि यीशुएरी अज़मैइश कीजेई ते तैनी एप्पू दुख झ़ैल्‍लोरोए, एल्हेरेलेइ तै तैन लोकां केरि मद्दत केरि बटते, ज़ैना अज़मैइशरो सामनो केरतन।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">यीशु मूसा करां महाने</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />एल्हेरेलेइ हे विश्वासी ढ्लाव ते बेइनव, तुस परमेशरे सुर्गे मां तैस सेइं शामल भोनेरे लेई कुजेवरेथ। एल्हेरेलेइ प्रभु यीशुएरे बारे मां ध्यान देथ ज़ै इश्शे लेई परमेशरेरो बिस्तार आन्ने बालो दूत ते महायाजके ज़ेसेरो अस इकरार केरतम। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />यीशु परमेशरेरे लेई वफादार थियो, ज़ैनी तै ठहरावरो थियो, ज़ेन्च़रे मूसा भी परमेशरेरे लोकां केरि सेवाई मां वफादार थियो। <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />किजोकि घर बनानेबालो घरे करां जादे इज़्ज़तरे काबल समझ़ो गाते, तेन्च़रे यीशु भी मूसा करां जादे इज़्ज़तरे काबल समझ़ो जेव। <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />किजोकि हर घरेरो कोई न कोई बनानेबालो ज़रूर भोते, पन ज़ैनी सब किछ बनावं तै परमेशरे। <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />मूसा त परमेशरेरो सेवक भोने सेइं परमेशरेरे घरेरे लोकन मां वफादार राव। ताके तैना गल्‍लां केरि बटे, ज़ैना परमेशर एजने बाले वक्ते मां ज़ोने बालो थियो। <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />पन मसीह मट्ठू भोनेरे वजाई सेइं परमेशरेरे लोकां केरू मुखतियारे, ते असां तैसेरे लोकम, शर्त एने कि असां तैस दिलेरी ते उमीदी मज़बूत रखम, ज़ैस पुड़ असां भरोसो केरतम।<verse eid="HEB 3:6" /></para>
  <para style="s">विश्वासेरे लेई हदैइत</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />बस्सा पवित्र आत्मा ज़ोते,</para>
  <para style="q" vid="HEB 3:7">“अगर अज़ तुस परमेशरेरी आवाज़ शुनथ।<verse eid="HEB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 3:8" />त अपने दादे पड़दादां केरे ज़ेरे तैसेरो हुक्म मन्ने करां इन्कार न केरथ,</para>
  <para style="q" vid="HEB 3:8">ज़ैखन तैनेईं परमेशरेरे खलाफ खलाफत की,</para>
  <para style="q" vid="HEB 3:8">ते ज़ेन्च़रे तैस दिहाड़े तुश्शे दादे पड़दादेईं ज़ेइस तैना सुनसान ठैरी मां थिये, तैनेईं परमेशरेरी अज़मैइश की।<verse eid="HEB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 3:9" />तैड़ी तुश्शे दादे-पड़दादे 40 सालन तगर मेरां महान कम्मां हेरनेरे बाद भी,</para>
  <para style="q" vid="HEB 3:9">अवं चनोती देइतां अज़मव।<verse eid="HEB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 3:10" />एल्हेरेलेइ अवं तैस वक्तेरे लोकन पुड़ क्रोधे भोव,</para>
  <para style="q" vid="HEB 3:10">ते मीं ज़ोवं, तैना हमेशा मेरो इन्कार केरतन,</para>
  <para style="q" vid="HEB 3:10">ते ज़ैन केरनेरो मीं हुक्म दित्तोरोए तैन केरने करां इन्कार केरतन।<verse eid="HEB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 3:11" />एल्हेरेलेइ मीं एपनी सरकी मां कसम खाइ,</para>
  <para style="q" vid="HEB 3:11">कि तैना तैस ठैरी कधे दाखल न भोल्हे ज़ैड़ी अवं तैन आराम देथो।”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />हे ढ्लाव ते बेइनव खबरदार राथ, तुसन मरां केन्चेरो दिल एत्रो बुरो ते बेइमान न भोए, कि ज़ै तैस ज़ींते परमेशरे करां दूर केरे। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />पन ज़ांतगर तै दिहाड़ी ज़ैस जो अज़ ज़ोतन, रोज़ एक्‍की होरि हिम्मत देते राथ, एरू न भोए कि तुसन मरां कोई पापेरे धोखे मां एइतां परमेशरेरे लेई सखत दिल न भोइ गाए। <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />किजोकि अगर असां अपने पेइले विश्वासे पुड़ अपने मौती तगर लगातार मज़बूत रहतम, त अस अकोट्ठू कम केरने मां मसीह सेइं साथी ज़ुड़तम।<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />ज़ेन्च़रे पवित्रशास्त्रे मां लिखेरूए,</para>
  <para style="q" vid="HEB 3:15">“अगर अज़ तुस तैसेरी आवाज़ शुनथ त तुस</para>
  <para style="q" vid="HEB 3:15">अपने दिले सखत न केरा, त अपने दादे पड़दादां केरे ज़ेरे तैसेरो हुक्म मन्ने करां इन्कार न केरथ,</para>
  <para style="q" vid="HEB 3:15">ज़ैखन तैनेईं परमेशरेरे खलाफ खलाफत की।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />तैना लोक कौन थिये, ज़ैनेईं परमेशरेरी आवाज़ शुन्तां भी तैसेरे खलाफ खलाफत की? तैना सब लोक तैना थिये ज़ैना मूसेरे ज़िरिये मिस्र मुल्खे मरां निसोरे थिये। <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />तैना कौन लोक थिये, ज़ैन सेइं परमेशर 40 सालन तगर क्रोधे राव? तैना लोक तैना थिये, ज़ैनेईं पाप कियो ते मेरतां तैन केरि लाशां सुनसान ठैरी मां रेइ जेई। <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />ज़ैखन परमेशरे क्रोधे मां कसम खाइ, कि तैना तैस ठैरी कधे दाखल न भोल्हे ज़ैड़ी अवं तैन आराम देथो, हकीक्ति मां तै तैन केरे बारे मां ज़ोतो थियो ज़ैनेईं हुक्म न थियो मन्नोरो। <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />बस्सा, असन हुनी पतो लगो, कि तैना विश्वास न केरनेरी वजाई सेइं तैड़ी दाखल न भोइ सके।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">परमेशरेरे लोकां केरो विश्वास</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />एल्हेरेलेइ ज़ैखन परमेशरेरो ऐह वाधोए कि असां तैस आरामे मां दाखल भोइ सकतम, ते असेईं खबरदार राहोरू लोड़ते, ताके कोस्कोई एरू न भोए, कि तुसन मरां कोई तैस मां दाखल भोने करां एरो रेइ गाए। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />किजोकि ज़ेन्च़रे असेईं यीशु मसीहेरी खुशखबरी शुनी, तेन्च़रे इस्राएली लोकेईं भी आरामेरे ठैरी दाखल भोनेरी खुशखबरी शुनोरी थी। पन तैनेईं तैस पुड़ विश्वास न कियो, एल्हेरेलेइ तै सन्देश तैन केरे लेई बेफैइदो भोव। <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />पन असेईं ज़ैनेईं विश्वास कियो, परमेशरेरे तैस वाधो कियोरे आरामे मां दाखल भोतम, ज़ेन्च़रे परमेशरे ज़ोवरू थियूं,</para>
  <para style="q" vid="HEB 4:3">“मीं अपने क्रोधे मां कसम खाइ,</para>
  <para style="q" vid="HEB 4:3">कि तैना तैस ठैरी कधे दाखल न भोल्हे ज़ैड़ी अवं तैन आराम देथो।”</para>
  <para style="p" vid="HEB 4:3">परमेशरे एन एल्हेरेलेइ नईं ज़ोवरू, किजोकि हेजू तगर आरामेरी ठार तियार न थी, पन तै ठार दुनिया बनानेरे वक्ते करां तै तियारे। <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />किजोकि परमेशरे सत्तोवं दिहैड़ारे बारे मां पवित्रशास्त्रे मां एन्च़रे ज़ोवरूए,</para>
  <para style="q" vid="HEB 4:4">“परमेशरे अपना सब कम्मां खतम केरतां सत्तोवं दिहाड़े आराम कियो।”<verse eid="HEB 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HEB 4:5" />ते अस भी इन पढ़तम कि तैनी बादे मां ज़ोवं,</para>
  <para style="q" vid="HEB 4:5">“एना मेरे आरामेरे ठैरी कधी दाखल न भोल्हे।”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />तैना इस्राएलेरे लोक ज़ैनेईं पेइली ई खुशखबरी त शुनी, पन आरामेरे ठैरी दाखल भोने मां कामयाब न भोए, किजोकि तैनेईं परमेशरेरे हुक्म न मन्ने। पन हुन्ना भी किछ लोकां केरे लेई आरामेरे ठैरी दाखल भोनेरे लेई मौकोए। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />एल्हेरेलेइ परमेशरे कोई होरो वक्ते अपने आरामेरे ठैरी मां दाखल भोनेरे लेई ठहरावरो, तै वक्त अज़ आहे, इश्शे दादे पड़दादेईं खलाफत केरनेरे बड़े सालना बाद परमेशरे दाऊदेरे ज़िरिये ज़ोवं, ज़ेन्च़रे तैने ज़ोवं</para>
  <para style="q" vid="HEB 4:7">“अगर अज़ तुस तैसेरी आवाज़ शुनथ,</para>
  <para style="q" vid="HEB 4:7">त अपनो दिल सखत न केरा।”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />अगर यहोशूए तैना लोक आरामे मां दाखल करावरे भोथे त बादे मां परमेशरे होरि दिहैड़ारे बारे मां गल न थी केरनि। <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />एल्हेरेलेइ परमेशरे लोकां केरे लेई एरी ठार तियारे ज़ैड़ी तैना पूरे तरीके सेइं आराम केरि बटतन। तैना तेन्च़रे आराम केरेले ज़ेन्च़रे परमेशरे सत्तोवं दिहाड़े आराम कियोरो थियो। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />किजोकि ज़ै कोई परमेशरेरे आरामे मां दाखल भोते त तै परमेशरेरो ज़ेरो अपने कम्मन पूरे केरतां आराम केरते। <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />एल्हेरेलेइ एज्जा अस भी तैस आरामेरी ठैरी मां दाखल भोनेरी कोशिश केरम, ताके कोई भी मैन्हु इस्राएली लोकां केरे ज़ेरो हुक्म न मेनतां तैस आरामेरी ठैरी दाखल भोने करां रेइ न गाए। <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />किजोकि परमेशरेरू वचन ज़ींतू ते शेक्ति बालूए, ते हर दूई धारण बैली तलवारी करां भी जादे तिख्खू आहे। ते तैन प्राण ते आत्माई गहराई तगर च़ीरते, ज़ेन्च़रे तिख्खी तलवार जोड़न ते हेड्डी केरे एन्त्रियों मासे वारां पार च़िरतां निसतीए ते दिलेरे खियाल ते मैन्हेरो इरादो भी ज़ानते। <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />दुनियारी कोई भी चीज़ परमेशरेरी नज़री करां छ़पोरी नईं, बल्के तैसेरे सामने सब चीज़ां खुल्‍ली ते बैंदिन, ते असेईं तैस, ज़ैन किछ भी अपने पूरे ज़िन्दगी मां कियोरू तैसेरो हिसाब देनो पेनोए।<verse eid="HEB 4:13" /></para>
  <para style="s">महायाजक</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />बस्सा, एज्जा अस अपने विश्वासे पुड़ मज़बूत रहम। किजोकि इश्शो अक महान महायाजके, ज़ै सुर्गे मां जेवरोए, यानी परमेशरेरू मट्ठू यीशु। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />किजोकि इश्शो महायाजक इश्शी सैरी कमज़ोरी समझ़ते। किजोकि शैताने तै सेब्भी गल्‍लन मां इश्शो ज़ेरो अज़मव, पन तैनी कोई पाप न कियो। <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />एल्हेरेलेइ एज्जा असां दिलेरी सेइं, अनुग्रह देनेबाले परमेशरेरे तखतेरे सामने च़लम, ताके तै असन पुड़ अनुग्रह ते दया केरे ते ज़रूरतरे मौके तै इश्शे मद्दत केरे।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />परमेशरे हर महायाजक इस्राएली लोकन मरां च़ुनो, ते परमेशरे महायाजक, लोकां केरि तरफां अपनि सेवा कराने लेई ठहराए, ताके तैना लोकां केरे मैफरे लेई च़ढ़तल ते पापां केरू बलिदान च़ाढ़न। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />किजोकि अक याजक एप्पू बेड़ि गल्‍लन मां कमज़ोरे, एल्हेरेलेइ तै बेसमझ़, ते टेपलोरे लोकन नेरमी सेइं बर्ताव केरि बटते। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />किजोकि तै एप्पू कमज़ोरे, एल्हेरेलेइ तैस न सिर्फ लोकां केरे पापां केरे लेई, बल्के अपने पापां केरे लेई भी बलिदान च़ाढ़नेरि ज़रूरत भोतीए। <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />कोई मैन्हु अपने लेई महायाजकेरी पदवी अपने आपे सेइं हासिल न केरि सखे, ज़ांतगर तै हारूनेरो ज़ेरो परमेशरेरी तरफां कुजव न गाए।<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />तेन्च़रे मसीहे भी महायाजक बेनतां अपनि आदर न की, बल्के परमेशरे तैस आदर दित्ती ज़ैखन तैने ज़ोवं,</para>
  <para style="q" vid="HEB 5:5">“तू मेरू मट्ठू आस,</para>
  <para style="q" vid="HEB 5:5">अज़ अवं इन बांदू केरताईं तू मेरू मट्ठू आस।”<verse eid="HEB 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6" />एल्हेरेलेइ परमेशर फिरी एक्‍की होरि ठैरी ज़ोते,</para>
  <para style="q" vid="HEB 5:6">“तू मलिकिसिदकेरो<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">मलिकिसिदक: मलिकिसिदक अब्राहमेरे वक्ते महायाजक ते हुकूमत केरनेबालो थियो</char></note> ज़ेरो</para>
  <para style="q" vid="HEB 5:6">हमेशारे लेई याजक आस।”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />यीशुए एक्‍की मैन्हेरी ज़ेरि ज़िन्दगी गुज़ारनेरे दिहाड़न मां फुकैरी-फुकैरी ते लेरां देइ-देइ परमेशरे कां प्राथना ते बिनती की, ज़ै तैस मौती करां बच़ेइ सकतो थियो, ते परमेशरेरे लेई तैसेरे भेक्तरे वजाई सेइं परमेशरे तैसेरी फरियाद शुनी। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />ते परमेशरेरू मट्ठू भोइतां भी तैनी दुख झ़ैल्‍लतां हुक्म मन्नो शिखो। <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />ज़ैखन तैनी तैन सब कियूं ज़ैन तैनी कियेरू लोड़तू थियूं, त तै तैन केरे लेई हमेशारे लेई मुक्तरो ज़िरियो बनो, ज़ैना तैसेरे हुक्म मनतन। <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />ते तैस परमेशरेरी तरफां मलिकिसिदकेरी ज़ेरि महायाजकेरी पदवी मैल्ही।<verse eid="HEB 5:10" /></para>
  <para style="s">विश्वासे करां भटकनेरो नितीजो</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />असन कां इस बारे मां ज़ोनेरे लेई बड़ू किछ आहे, पन तुसन समझ़ानू मुश्किले, किजोकि तुस समझ़ाने मां सुसतथ। <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />द्रासले मां अज़ तगर तुस गुरू बनोरे लोड़ते थिये, किजोकि तुसन विश्वास कियोरे बड़ू च़िर भोवरूए। पन हुन्ना त ज़रूरत इस गल्‍लरीए कि कोई मैन्हु तुसन परमेशरेरे वचनेरी शुरुआतरी गल्‍लां दुबारां शिखाले। तुस तैन बच्‍चां केरे ज़ेरेथ ज़ैन हेजू दुद्ध पीतन ते शूरी रोट्टी न खेइ बटन। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />ज़ै दुद्ध पीते, तै हेजू बच्‍चो भोते, किजोकि तैस नईं पतो सही कुने ते गलत कुने। <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पन शूरी रोट्टी तैन केरे लेई भोचे ज़ैना विश्वासे मां बड्डेन, ते अपने तजरबे सेइं इस काबल भोवरेन, कि रोड़े ते बुरे मां फर्क सेमझ़ी सखन।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="s">भटकनेरो नितीजो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />एल्हेरेलेइ एज्जा अस मसीहेरे बारे मां शुरुआतरी शिक्षारी गल्‍लां बार-बार दोरहानेरे बगैर अस सिद्धतारे पासे च़लते रहम। ते मौतरे पासे नेनेबाले कम्मन करां मन फिराम ते परमेशरे पुड़ विश्वास केरनो, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />बपतिस्मे ते हथ रखनेरी शिक्षारे बारे मां, ते मुड़दां केरे ज़ींते भोनेरे बारे, ते हमेशारे न्यायेरे बारे मां दुबारां गल न केरम। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />एज्जा अस मज़बूत विश्वासी बनम! अगर परमेशर अज़ाज़त दे त असां इन केरमेले। <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />ज़ैना लोक अपने विश्वास शारतन तैन फिरी मन फिरानेरे पासे केन्च़रे आने गान? तैनेईं एक्‍की बारे परमेशरेरी सच़्च़ाई पिशानोरी थी, ते तैन सुर्गेरां वरदानां मैल्होरां थियां ते तैनेईं होरन सेइं साथी पवित्र आत्मा हासिल कियोरो थियो। <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />तैनेईं मैसूस कियोरू थियूं कि परमेशरेरू वचन रोड़ू आहे, ते तैनेईं एजने बाले ज़मानेरी शक्ति मैसूस कियोरी थी। <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ते हुनी तैनेईं अपनो विश्वास शारोरो! एल्हेरेलेइ तैन मन फिरानेरे पासे आनू मुश्किले, किजोकि तैना एप्पू परमेशरेरे मट्ठे फिरी क्रूसे पुड़ च़ाढ़ने लगोरेन! ते लोकां केरे सामने तैसेरी बेइज़ती केरने लगोरेन। <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />ज़ैन लोकन रोड़ी शिक्षा मैल्होरीए तैना तैस ज़मीनेरे ज़ेरे आन ज़ैस पुड़ झ़ैड़ी लगती रहतीए। अगर ज़मीन रोड़ीए त ज़िमदारेरे लेई रोड़ी फसल देचे, ते तैस परमेशरेरी तरफां बरकत मैलचे। <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />होरे लोक तैस ज़मीनरे ज़ेरे आन ज़ैस मां कंटे ते झ़ैल्‍लां लगतन ते तै कोन्ची कम्मेरी नईं। ते परमेशर तैस ज़मीनी फिटकार देनेबालोए ते आखरी मां तैस अग्गी मां बरबाद केरेलो।<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />हे मेरे ट्लारे ढ्लाव ते बेइनव, हालांकी असां एरी गल्‍लां ज़ोतम फिर भी अस विश्वास केरतम कि एन तुश्शे लेई नईं। इश्शो भरोसोए कि तुस रोड़ी गल्‍लां केरे लेई आथ ज़ैना मुक्तरे ज़िरिये एइतिन। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />किजोकि परमेशर अन्यायी नईं कि ज़ै तुश्शू कम ते प्यार बिसरी गाए, ज़ै तुसेईं तैसेरे लोकां केरि सेवा केरनेरे ज़िरिये तैसेरेलेइ हिरावरोए। ते परमेशर याद केरेलो कि तुस हेजू भी तैन केरि मद्दत केरने लगोरेथ। <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />इश्शी इच्छा ई आहे कि तुस ज़ांतगर ज़ींतेथ रोड़ो बर्ताव केरते राथ, इन पक्‍कू केरनेरे लेई कि तुश्शी उमीद सच़ भोल्ही। <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />तैखन तुस आलसी न बनेले। पन तुस तैन केरे ज़ेरे च़लेले ज़ैना अपने विश्वास ते सबरारे वजाई सेइं परमेशरेरे वाधां केरे बारस भोल्हे।<verse eid="HEB 6:12" /></para>
  <para style="s">परमेशरेरो अटल वाधो</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />ज़ैखन परमेशरे अब्राहमे सेइं वाधो कियोरो थियो त कसम केरनेरे लेई तैस करां बड्डो कोई न थियो, एल्हेरेलेइ तैनी अपनि कसम कमाइतां ज़ोवं, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />“अवं तीं सच़्च़े बरकत देइलो, ते तेरू वंश बेशुमार बधेइलो।” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />एल्हेरेलेइ अब्राहम तैन वाधन हासिल केरनेरे लेई सबरी सेइं इंतज़ार केरतो राव। <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />मैन्हु त एप्पू करां बडां केरे नव्वेंरी कसम केरतन ते एन्च़रे तैन हर मसलेरो हल कसम केरतां खतम भोते। <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />एल्हेरेलेइ परमेशरे भी कसम खाइ, एन केरने सेइं तैनी तैन लोकन ज़ैन सेइं वाधो कियोरो थियो, इन हिरानू चाऊ कि ज़ै वाधो तैनी कियोरोए तै पूरो केरेलो। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />त इड़ी दूई गल्‍लां आन तैसेरो वाधो ते तैसेरी कसम, ज़ैना कधे न बेदलोन ते तैन केरे बारे मां परमेशर कधे झूठ न ज़ोए। एल्हेरेलेइ अस ज़ैना तैसेरे सहारे मां एवरेम त ज़ै उमीद असन दित्तोरीए, तैस मां अस बनोरे रहम, ते अस बड़े जादे जोशे मां आम। <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />इश्शी उमीद प्राणा केरे लेई पक्‍की आहे तै टेली न बटे ते ई असन परमेशरे करां भटकने न दे, बल्के ई असन परमेशरेरे मन्दरे मां महा पवित्र ठैरी मां पुज़ातीए। <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />ज़ैड़ी यीशु इश्शे लेई मलिकिसिदक महायाजकेरो ज़ेरो हमेशारो महायाजक बेनतां इश्शे लेई बत हिराने बालेरो ज़ेरो दाखल भोव।<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मलिकिसिदक महायाजक</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />ई मलिकिसिदक शालेमेरो राज़ो ते परमप्रधान परमेशरेरो याजक थियो, ज़ैखन अब्राहम राज़न मैरतां वापस एवरो थियो, त मलिकिसिदके तैस सेइं मिलतां तैसेरी बड़ी आदर की ते तैस बरकत दित्ती। <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />अब्राहमे तैस तैन सेब्भी चीज़ां केरो दशोवं हिस्सो दित्तो ज़ैना तैनी कब्ज़ो केरतां ऐनोरी थी। मलिकिसिदकेरो नंव्वेरो मतलब धार्मिकतारो राज़ोए, ते शालेमेरो मतलब शैन्तरो राज़ो। <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />तैसेरो न कोई बाजी, न अम्मा, न तैसेरू कोई वंशे, न तैसेरे ज़रमनेरे बारे मां न तैसेरे मरनेरे बारे मां लिखेरूए। तै परमेशरेरे मट्ठेरो ज़ेरोए तै हमेशारे लेई याजक बनोरो रहते।<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />पन हुनी इस पुड़ ध्यान देथ मलिकिसिदक केत्रो महान थियो। ज़ैस पूर्वज अब्राहमे कब्ज़ो कियोरी चीज़ां केरो दशोवं हिस्सो दित्तो। <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />मूसेरे कानूनेरे मुताबिक ज़ैना लेवेरे खानदाने मरां थिये यानी ज़ैना याजक ठहराए गातन, तैन हुक्म दित्तो जेवरोए कि तैना इस्राएली लोकन यानी अपने लोकन करां दशोवं हिस्सो नेन, हालांकी तैना भी अब्राहमेरी वंशे मरां आन। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />पन मलिकिसिदक ज़ै लेवी केरे वंशे मरां न थियो फिरी भी अब्राहमे करां दशोवं हिस्सो नियो, ते तैस बरकत दित्ती ज़ैस सेइं परमेशरे वाधो कियो थियो। <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />अस पक्‍कू ज़ानतम कि ज़ै बरकत देते तै बरकत मैल्हने बाले करां महाने। <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />ते याजक ज़ैना दशोवं हिस्सो नेतन तैना तैन मैन्हु आन ज़ैना मरतन, पन मलिकिसिदक एन करां भी महाने, किजोकि पवित्रशास्त्र ज़ोते कि तै ज़ींतोए। <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />बल्के अस ज़ोई सकतम कि लेवी भी ज़ै दशोवं हिस्सो नेते, अब्राहमेरे ज़िरिये मलिकिसिदक जो दशोवं हिस्सो दित्तो। <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />एल्हेरेलेइ कि ज़ैस मौके मलिकिसिदक लेवेरे पूर्वज अब्राहमे सेइं मुलाकात की, तैस मौके लेवी ज़र्मोरो भी न थियो।<verse eid="HEB 7:10" /></para>
  <para style="s">मलिकिसिदकेरे बदले होरो महायाजक</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />इना लेवी याजकेरे आधारे पुड़ कानून इस्राएली लोकन दित्तोरो थियो, अगर लेवी ते याजकेरू कम ठीक थियूं, त अलग किसमेरे याजकेरू बांदू भोनू ज़रूरी न थियूं, ज़ै मलिकिसिदकेरो ज़ेरोए। पन हारूनेरो ज़ेरो नईं। <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />किजोकि ज़ैखन याजकेरी पदवी बेदलोतीए त कानूनेरू बेदलोनू भी ज़रूरीए। <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />असां इना सैरी गल्‍लां मसीहेरे बारे मां ज़ोने लगोरेम ज़ै होरि गोट्ले मरांए, ते तैस गोत्रे मरां केन्चे बलिदान केरनेरे ठैरी याजकेरी सेवा नईं कियोरी। <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />किजोकि इन अस ज़ानतम, कि इश्शो प्रभु यहूदारे गोत्रे मरां थियो। ते मूसा एस गोत्रे मरां याजकेरे पेदवरे बारे मां कोई गल नईं कियोरी। <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />मलिकिसिदकेरो ज़ेरो अक होरो भी याजक एजने सेइं इन होरू भी साफ भोते। <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />किजोकि यीशु कानूनेरे हुक्मेरे मुताबिक याजक लोड़तो थियो, पन तै नाश न भोने बैली ज़िन्दगरे शेक्तरे ज़िरिये महायाजक बनो। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />किजोकि तैसेरे बारे मां परमेशर पवित्रशास्त्रे मां ई गवाही देते,</para>
  <para style="q" vid="HEB 7:17">“कि तू मलिकिसिदकेरो ज़ेरो</para>
  <para style="q" vid="HEB 7:17">हमेशारे लेई याजक आस।”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />एन्च़रे मूसेरो कानून कमज़ोर ते बेफल भोनेरे वजाई सेइं हुनी कम न केरि बटे। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(किजोकि मूसेरे कानूने कोई गल्‍ली सिद्ध न केरि बटी) पन हुनी असन कां अक रोड़ी उमीदे ज़ेसेरे ज़िरिये सेइं असां परमेशरेरे सामने एज्जी बटतम। <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />ते परमेशरे भी तैस वक्ते कसम खाइ ज़ैखन तैनी यीशु महायाजक बनाव। <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />किजोकि होरे याजक त बगैर कसमा याजक बनाए, पन ज़ैखन यीशु, परमेशरेरी तरफां याजक बनाव त तैनी ज़ोवं,</para>
  <para style="q" vid="HEB 7:21">“अवं, प्रभु कसम खाताईं, कि तू हमेशा याजक रालो</para>
  <para style="q" vid="HEB 7:21">ते अवं अपने मने कधी न बदलेलो।”<verse eid="HEB 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22" />एल्हेरेलेइ यीशु ज़मानत देते कि पुरानो करार नव्वें करारे करां रोड़ो भोल्हो। <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />ते अक फर्के, किजोकि पेइले बड़े याजक बेनतां आहे, पन तैना सब मरे ते तैनेईं लगातार याजकेरू कम न केरि बटु। <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पन यीशु आखरी तगर रानेबालो याजके ते एल्हेरेलेइ तैसेरी ठैरी होरो कोई याजक न रख्खो गाए। <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />एल्हेरेलेइ ज़ैना लोक यीशुएरे ज़िरिये सेइं परमेशरे कां एइतन, यीशु तैन पूरी-पूरी मुक्ति देइ बटते, किजोकि तै तैन केरे लेई बिनती केरनेरे लेई हमेशा ज़ींतोए।<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />एल्हेरेलेइ असन एरे ज़ेरे महायाजकेरी ज़रूरी थी, ज़ै इश्शे ज़रूरतन पूरी केरे, ज़ै पवित्र, निष्कपट ते शुद्ध, ते पैपन करां अलग भोए ते ज़ै परमेशरे सुर्गे जो नेवरो भोए। <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />ते होरि महायाजक केरू ज़ेरू यीशु ज़रूरी नईं, कि पेइले अपने पापां केरे लेई ते फिरी अपने लोकां केरे पापां केरे लेई रोज़ बलिदानां च़ाढ़े, किजोकि यीशुए सेब्भी लोकां केरे पापां केरे लेई एक्‍की बार अपनो आप बलिदान केरतां एरू बलिदान च़ाढ़ू ज़ैन हमेशारे लेईए। <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />किजोकि मूसेरो कानून त तैन मैन्हन महायाजक भोनेरे लेई ठहराते ज़ैना सिद्ध नईं, पन मूसेरे कानूनेरे बाद परमेशरे कसम खेइतां अपनु मट्ठू ठहराव ते तैसेरू मट्ठू हमेशारे लेई सिद्ध महायाजक बनोरूए।<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">यीशु इश्शो महायाजके</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />ज़ैना गल्‍लां हुन्ना अस ज़ोने लगोरेम तैन मरां सेभना बड्डी गल ईए कि इश्शो एरो महायाजके, ज़ै सुर्गे मां परमेशरेरे महिमा बाले तखतेरे देइने पासे बिशोरोए। <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />ते ज़ै तैस महा पवित्र ठैरी ते तैस सच़्च़े तेम्बु मां सेवा केरते, ज़ै केन्चे मैन्हे नईं बल्के परमेशरे खड़ो कियोरोए। <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />किजोकि हर महायाजक पापां केरे मैफरे लेई च़ढ़तल ते बलिदान च़ाढ़नेरे लेई ठहराव गाते, एल्हेरेलेइ ज़रूरी आहे, कि इश्शे महायाजके (यीशु) कां भी किछ च़ाढ़नेरे लेई भोए। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />ते अगर यीशु दुनियाई मां भोथो त कधे कोई याजक न थियो भोनो, किजोकि इड़ी मूसेरे कानूनेरे मुताबिक च़ढ़तल च़ाढ़नेरे लेई याजक आन। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />इना याजक ज़ैना कम केरतन, तैना सिर्फ सुर्गेरे चीज़ां केरि नकल ते सैयोए, पन ज़ैना चीज़ां सुर्गे मां आन। एल्हेरेलेइ ज़ैखन मूसो तेम्बु बनानेरी तियारी केरने लगोरो थियो, त परमेशरे तैस हदैइत दित्ती, “हेर ज़ै नमूनो मीं तीं पहाड़े पुड़ हिरावरो थियो तैसेरे हिसाबे सेइं तू सैरी चीज़ां बना।” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पन हुनी ज़ै महायाजकेरी सेवा यीशुए दित्तोरी तै पुराने याजकेरे सेवाई करां बड़ी बड्डीए, किजोकि तै ज़ैना गल्‍लां केरि बिचवाई केरते तैना पुराने करारे करां भी उच्‍ची आन, ते वाधन पुड़ तैसेरी बुनीयादे। <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />किजोकि अगर पेइले करारे मां कोई खांमी न भोथी त होरो करार केरनेरी कोई ज़रूरत न थी भोनी। <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />पन परमेशर लोकन पुड़ दोष लेइतां ज़ोते,</para>
  <para style="q" vid="HEB 8:8">“तक्‍का प्रभु ज़ोते कि तै दिहाड़ी एज्जी राहोरीए,</para>
  <para style="q" vid="HEB 8:8">इस्राएलेरे लोक ते यहूदारे लोकन सेइं साथी नंव्वो करार केरेलो।<verse eid="HEB 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 8:9" />ऐह तैस करारेरो ज़ेरो न भोल्हो ज़ै मीं तैन केरे दादे पड़दादन सेइं तैस दिहाड़े कियोरो थियो।</para>
  <para style="q" vid="HEB 8:9">ज़ैखन मीं मिस्रे मरां तैन कढनेरे लेई तैन केरो हथ ठमोरो थियो,</para>
  <para style="q" vid="HEB 8:9">किजोकि प्रभु ज़ोते, कि तैना मेरे तैस करारेरे मुताबिक वफादार न राए,</para>
  <para style="q" vid="HEB 8:9">एल्हेरेलेइ मीं भी तैन केरे पासे कोई ध्यान न दित्तू।<verse eid="HEB 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 8:10" />प्रभु ज़ोते, कि ज़ै करार अवं इस्राएलेरे लोकन सेइं तैस मौके केरेलो तै ईए,</para>
  <para style="q" vid="HEB 8:10">कि अवं अपने कानून तैन केरे मन्न मां छ़डेलो,</para>
  <para style="q" vid="HEB 8:10">ते तैन केरे दिलन मां लिखेलो,</para>
  <para style="q" vid="HEB 8:10">ते अवं तैन केरो परमेशर भोल्हो ते तैना मेरे लोक भोल्हे।<verse eid="HEB 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 8:11" />ते केन्ची ऐह ज़रूरत न भोल्ही कि अपने पुड़ोसन,</para>
  <para style="q" vid="HEB 8:11">या अपने रिश्तेदारन ऐह शिक्षा दे कि प्रभु पिशाना,</para>
  <para style="q" vid="HEB 8:11">किजोकि निकड़े करां बड्डे तगर सब मीं पिशानेले।<verse eid="HEB 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 8:12" />एल्हेरेलेइ अवं तैन केरे अधर्म माफ़ केरेलो,</para>
  <para style="q" vid="HEB 8:12">ते तैन केरे पापन फिरी कधे याद न केरेलो।”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />ज़ैखन परमेशरे नंव्वो करारे कमाव त पेइलो करारे पुरानो बनाव, ते ज़ै चीज़ पुरानी ते कमज़ोर भोतीए तै जल्दी खतम भोतीए।<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">दुनियारो तेम्बु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />पेइले करारेरे मुताबिक भी परमेशरेरी आराधना केरनेरे नियम थिये; ते आराधना केरनेरे लेई मैन्हु केरि बनेवरी अक ठार थी। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />यानी अक तेम्बु बनोरो थियो, ते तैसेरे दूई हिस्से थिये, पेइले हिस्से मां अक दीवट (दीयो), मेज़ ते च़ैढ़ोरी रोट्टी रेखोरी भोती थी, तैस हिस्से जो पवित्र ठार ज़ोते थिये। <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />ते होरि हिस्से मां पड़दे पुतोरां तै ठार थी, तैस हिस्से जो परमपवित्र ठार ज़ोते थिये। <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />एसमां सोन्नेरी तै धूपवेदी थी ज़ैस पुड़ खुशबूदार चीज़ां बालते थिये, ते च़ेवरे पासन सोन्ने सेइं पलेटोरो करारेरो सन्दूख थियो। ते तैस सन्दूखे मां मन्ने सेइं भेरतां अक सोन्नेरू भांड थियूं, ते कने हारूनेरी तै सोटी थी ज़ैस पुड़ पट्लां लग्गोरां थियां ते दूई घोड़ां केरि तेख्ती थी, ज़ैन पुड़ दश हुक्म लिखोरे थिये। <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />एस सन्दूखेरे बेइयें पासे महिमा बाले करूब<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="fq" closed="false">करूब </char><char style="ft" closed="false">सोन्नेरे फंघन बाले प्राणी </char></note> बनोरे थिये, ज़ैना परमेशरेरी मौजूदगी हिराते थिये। तैना अपने-अपने फंघन सेइं तैस ठैरी सैयो केरि राहोरे थिये, ज़ैड़ी पाप माफ़ कियोरे थिये। पन हुनी इन गल्‍लन रोड़े च़ारे ज़ोनेरो वक्त नईं। <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />एना सब चीज़ां एस तरीके सेइं तियार केरनेरे बाद, याजक तेम्बेरे तैस पेइले हिस्से मां रोज़ गाते, ताके सेवारू कम पूरू केरन। <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />पन परमपवित्र ठैरी मां सिर्फ महायाजक साले मां एक्‍की बार गाते। ते तै भी खून घिन्तां ताके अपनि ते अपने लोकां केरे पापां केरे लेई बलिदान च़ाढ़े, ज़ैना तैनेईं अनज़ाने मां किये। <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />एस नियमे सेइं पवित्र आत्मा इन हिराते, कि ज़ांतगर पेइलो तेम्बु आहे, तांतगर परमपवित्र ठैरी गानेरी बत बन्दे। <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />ते इन सब किछ इस वक्तेरे लेई अक मसाले, एस सेइं एन बांदू भोते कि ज़ै च़ढ़तल ते बलिदान याजक परमेशरे जो च़ाढ़ते थिये, तैस सेइं आराधना केरनेबालां केरो ज़मीर रोड़ेच़ारे शुद्ध न भोए। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />तैन केरो तलक सिर्फ खाने पीनेरे चीज़ ते अलग-अलग शुद्ध भोनेरे रसमन सेइं भोतो थियो। इन सिर्फ जिसमानी रसमां आन, इन तैखन तगर लागू भोतन ज़ांतगर परमेशर नव्वों नियम न बनाए।<verse eid="HEB 9:10" /></para>
  <para style="s">मसीहेरे खूनेरी शक्ति</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पन ज़ैखन मसीह इश्शो महायाजक बेनतां अव, त तै रोड़ी चीज़ां घिन्तां अव ज़ैना हुन्ना मौजूद आन। तै सुर्गे मांजो परमेशरेरे हज़ूरी मां जेव। ते तै हज़ूरी एक्‍की महान ते सिद्ध तेम्बेरो ज़ेरिए, ज़ै मैन्हु केरे हथ्थां केरे ज़िरिये सेइं नईं बनोरो ते न दुनियारो। <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />ज़ैखन मसीह तैस तेम्बु मांमेइं भोइतां पवित्र ठैरी दाखल भोव, त तैनी थाव्वां ते बछ़ड़ां केरो खून नईं, बल्के अपनो खूनेरे ज़िरिये एक्‍की फेरे पवित्र ठैरी दाखल भोव ते असन इश्शे पापन करां हमेशारे लेई छुटकारो दित्तो। <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />किजोकि ज़ैखन थाव्वां ते दांतां केरो खून ते बेछ़ड़ी केरि मांज़न अपवित्र लोकन पुड़ छक्‍के गाने सेइं तैना लोक जिसमानी तरीके पवित्र मन्ने गाते थिये, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />त मसीहे सनातन आत्मारे ज़िरिये सेइं अपनो आप परमेशरे कां बगैर पापेरू बलिदान केरतां च़ाढ़ू, ते तैसेरो खून असन इश्शे ज़मीरेरे तैन कम्मन करां होरो भी जादे पवित्र केरेलो, ज़ैन केरो तलक मौती सेइं आहे, ताके अस ज़ींते परमेशरेरी आराधना केरम।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />एहे वजाए कि परमेशरे अपने ते दुनिया मझ़ाटे मसीह बिचवाई बनेइतां तैसेरे ज़िरिये सेइं अक नंव्वो करार बनावरोए, ताके ज़ैना परमेशरेरे कुजेवरेन तैना हमेशारी बरकत हासिल केरन ज़ेसेरे लेई परमेशरे तैना कुजोरेन। किजोकि पेइले दित्तोरे करारेरे अधीन कियोरे पापन करां तैन आज़ाद केरनेरे बदले मां मसीह मर्रोए। <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />किजोकि वसीयतरे सिल्सले मां वसीयत देनेबालेरी मौत साबत भोनी ज़रूरीए। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />एल्हेरेलेइ वसीयत देनेबालेरे ज़ींते दम्में तगर वसीयत कम्मेरी न भोए, पन तैसेरे मरनेरे बाद तै वसीयत पक्‍की भोतीए। <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />एहे वजाए कि पेइलो करार भी खूनेरे बगैर नईं कियोरो। <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />एन्च़रां ज़ैखन मूसा सैरी लोकन कानूनेरो अक-अक हुक्म शुनाव, त तैनी थाव्वां ते बछ़ड़ां केरो खून पैनी मां मिलाव, ते फिरी लाल उन्ना ते जूफा सेइं एन्हतां कानूनेरी किताबी ते सैरी लोकन पुड़ छ़िड़को। <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />ते ज़ोवं कि, “ऐह तैस करारेरो खूने ज़ेसेरो हुक्म परमेशरे तुश्शे लेई दित्तोरोए।” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />एन्च़रे तैनी तेम्बु पुड़ ते आराधना केरनेरी सैरी चीज़न पुड़ खून छ़िड़को। <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />किजोकि मूसे कानूनेरे मुताबिक लगभग सैरी चीज़ां खूने सेइं पवित्र की गेइचन, ते ज़ांतगर खून न बगाव गाए, तांतगर पाप भी माफ़ न भोन।<verse eid="HEB 9:22" /></para>
  <para style="s">मसीहेरे बलिदाने सेइं पाप माफ़ भोए</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />त फिरी ऐह ज़रूरते कि तैना चीज़ां ज़ैना सुर्गेरी नकल आन, तैना जानबरां केरे बलिदाने सेइं शुद्ध की गान। पन सुर्गेरी चीज़न इन करां भी जादे रोड़े बलिदाने सेइं शुद्ध भोनेरी ज़रूरते। <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />किजोकि मसीह मैन्हु केरे बनेवरे घरे मां ज़ैन सच़्च़े पवित्र ठारारी नकले, दाखल नईं भोवरो, बल्के सुर्गे मां दाखल भोव ज़ैड़ी तै इश्शे लेई परमेशरे कां हाज़रे। <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />यहूदी केरो महायाजक पवित्र घरे मां हर साल होरि केरो यानी जानबरां केरो खून नेइतां गाते, पन मसीह अपने आपे बार-बार बलिदान केरनेरे लेई न गाए। <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />वरना दुनियारे शुरू करां लेइतां हुन्ना तगर तैस बार-बार दुख झ़ैलनो पेथो; पन हुनी जमानेरे आखरी मां तै बांदो भोवं, ताके अपने बलिदाने सेइं पाप दूर केरे। <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />ते ज़ेन्च़रे सेइं मैन्हेरू मरनू ते एक्‍की बार न्यायेरू भोनू पक्‍कुए। <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />तेन्च़रे सेइं मसीहे भी बड़े लोकां केरे पाप सैल्तां गानेरे लेई एक्‍की बार बलिदान भोव, ते दुबारां पापां केरू बलिदान देनेरे लेई नईं, बल्के तैन मुक्ति देनेरे लेई एज्जेलो, ज़ैना तैसेरे इंतज़ारे मां आन।<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">सिद्ध बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />मूसेरो कानून एजने बैली रोड़ी चीज़ां केरो सिर्फ अक सैयोए, न कि असली रूपे। एल्हेरेलेइ एक्‍की किसमेरां बलिदानां ज़ैना हर साल च़ाढ़ां गातन, तैना परमेशरे कां एजनेबालन कधे भी सिद्ध न केरि सखन। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />अगर केरि सखेथां, त कुन तैन केरू च़ाढ़नू बंद न भोथू? एल्हेरेलेइ अगर आराधना केरनेबाले एक्‍की बारे हमेशारे लेई पवित्र भोइ गाथे, त तैन केरो ज़मीर तैन पापी न बनाथो। <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />पन तैना बलिदानां तैन लोकन हर साल याद करातन कि तैना पापिन। <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />किजोकि मुमकिन नईं, कि दांतां केरो ते थाव्वां केरो खून पापे दूर केरि सके।<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />एल्हेरेलेइ ज़ैखन मसीह दुनियाई मां एवरो थियो, त तैनी परमेशरे सेइं ज़ोवरू थियूं,</para>
  <para style="q" vid="HEB 10:5">“तीं बलिदान ते च़ढ़तल न चाई,</para>
  <para style="q" vid="HEB 10:5">बल्के तीं मेरे लेई अक जान तियार की।<verse eid="HEB 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 10:6" />तू न भस्म भोनेबाले बलिदाने सेइं, ते न पापेरे बलिदाने सेइं खुश भोव।”<verse eid="HEB 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 10:7" />तैखन मसीहे ज़ोवं, “हे परमेशर, हेर, अवं तेरी इच्छा पूरी केरनेरे लेई एवरोईं,</para>
  <para style="q" vid="HEB 10:7">ज़ेन्च़रे मेरे बारे मां पवित्रशास्त्रे मां लिखेरूए।”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />पेइले त तै ज़ोते, न तीं कोई बलिदान ते न कोई च़ढ़तल चाई, ते न भस्म भोनेबालू बलिदान ते न पापेरू बलिदान चाव, ते न तैन सेइं तू खुशी भोव, हालांकी एना बलिदानां मूसेरे कानूनेरे मुताबिक दित्तां गातन। <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />फिरी तै एन ज़ोते, “हेर, अवं तेरी मर्ज़ी पूरी केरनेरे लेई एवरोईं,” एन्च़रे तै पेइले सारे बलिदान्न हटाते ताके तैन केरे ठैरी मसीहेरे बलिदाने रख्खे। <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />परमेशरेरी मर्ज़ी ई थी, कि यीशु मसीहेरे जिसम एक्‍की बार बलिदान भोने सेइं अस हमेशारे लेई पवित्र भोम।<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />पेइले करारेरे मुताबिक हर याजक बलिदान केरनेरे ठैरी खड़े भोइतां रोज़ सेवा केरतन, ते एक्‍की किसमेरां बलिदानां बार-बार च़ाढ़तन, ज़ैना पापे कधी भी दूर न केरि सखन। <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पन मसीह ज़ै इश्शो महायाजके, इश्शे पापां केरे लेई एक्‍की बार बलिदान भोइतां परमेशरेरे देइने पासे गेइतां बिश्शी जेव। <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />तैड़ी तै तैस वक्तेरो इंतज़ार केरने लगोरोए, कि परमेशर तैसेरे दुश्मन पूरे तरीके सेइं हाराए। <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />तैनी एक्‍की बलिदाने सेइं ज़ैना लोक पवित्र कियोरेन, तैना हमेशारे लेई सिद्ध कियोरेन।<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />पवित्र आत्मा भी एस गल्‍लरी गवाही देते। पेइलू त एन ज़ोते कि,<verse eid="HEB 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HEB 10:16" />“प्रभु ज़ोते, कि ज़ै करार अवं</para>
  <para style="q" vid="HEB 10:16">तैन दिहैड़ना बाद अपने लोकन सेइं केरेलो तै ईए,</para>
  <para style="q" vid="HEB 10:16">अवं अपने कानून तैन केरे मन्न मां छ़डेलो</para>
  <para style="q" vid="HEB 10:16">ते तैन केरे दिलन मां लिखेलो।”<verse eid="HEB 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HEB 10:17" />ते फिरी एन भी ज़ोते कि, “अवं तैन केरे पाप ते बुरां कम्मां माफ़ केरेलो, ते फिरी कधी याद न केरेलो।”<verse eid="HEB 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18" />बस्सा, ज़ैखन तैन केरे पापां केरि माफ़ी भोइजेइ, त फिरी पापां केरे लेई बलिदानेरी ज़रूरत नईं।<verse eid="HEB 10:18" /></para>
  <para style="s">परमेशरेरे नेड़े गानू</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />एल्हेरेलेइ ढ्लाव ते बेइनव, असन यीशुएरे खूनेरे ज़िरिये सेइं मन्दरेरे परमपवित्र ठारी मां दाखल भोनेरी दिलेरी भोवरीए। <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />यीशुए इश्शे लेई अक नव्वीं ते ज़िन्दगी देनेबाली बत खोलोरीए, ज़ै तैनी पड़दे मां यानी अपने जिसमे मां मौतरे ज़िरिये इश्शे लेई बनाई। <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />ते एल्हेरेलेइ इश्शो एत्रो महान याजक ज़ै परमेशरेरे घरेरो मुखतियारे। <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />त एज्जा अस सच़्च़े दिले सेइं ते पूरे विश्वासे सेइं, ते एरो ज़मीर ज़ै खूनेरे तेप्पेइं सेइं पापेरे एसासे करां पवित्र कियोरे, ते एरो जिसम नेइतां ज़ै साफ पैनी सेइं धोवरोए, परमेशरे कां नेम। <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />ते अस एपनी उमीदरो इकरार रोड़ेच़ारे ट्लेइतां रखम, किजोकि ज़ैनी असन सेइं वाधो कियोरोए तै सच़्च़ोए। <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />ते असेईं इस गल्‍लरू ध्यान लोड़े रखोरू कि अस केन्च़रे प्यार ते रोड़ां कम्मां केरे लेई एक्‍की होरेरी हिम्मत बधाम। <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />ते एक्‍की ठैरी अकोट्ठू भोनू न शारम, ज़ेन्च़रे होरे लोक केरतन बल्के अस एक्‍की होरि हिम्मत देथ, तुस ज़ैस हिसाबे सेइं परमेशरे दुबारे एजनेरी दिहैड़ी नेड़ोंते लातथ तैस्से हिसाबे सेइं जादे एन गल्‍लन पुड़ च़लते भी राथ।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />किजोकि अगर अस सच़ पिशानेरां बाद, ज़ैंनी बुझ़तां पाप केरम त पापां केरे लेई कोई बलिदान बाकी नईं राहोरू। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />हाँ, परमेशरेरे न्याय ते भयानक अग ज़ै परमेशरेरे दुश्मन्न भस्म केरेली तै बाकीए। <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />ज़ैखन मूसेरे कानून न मन्नेबाले, दूई या ट्लाई मैन्हु केरे गवाही देने सेइं तैस मैन्हु बगैर दया केरतां मौतरी सज़ाह दित्ती गातीए। <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />त तै मैन्हु केत्री सज़ाहरो लैईक भोल्हो, ज़ैनी परमेशरेरे मट्ठू पव्वन हैठ ढ्लेन्च़ू, ते करारेरो खून ज़ैस सेइं तै पवित्र ठहरावरो थियो, तै अपवित्र समझ़ो। ते पवित्र आत्मारी बेइज़्ज़ती की, ज़ेसेरे ज़िरिये असन अनुग्रह मैलते। <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />किजोकि अस ज़ानतम, तैनी ज़ोवरू थियूं, “बदलो घिन्नो मेरू कम्मे, अवं एप्पू बदलो देइलो।” ते फिरी तैनी एन भी ज़ोवं, “प्रभु अपने लोकां केरो न्याय केरेलो।” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />ज़ींते परमेशरेरे हथ्थन मां गानू बड़ी खतरनाक गल्‍ले।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />पन तैना पेइले दिहाड़े याद केरा, ज़ैखन तुसन मसीह पिशान्नेरी लौ मैल्ही, ते तैसेरे बाद तुसेईं बेड़ि मुशकलातां केरो मज़बूती सेइं मुकाबलो कियो। <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />यानी कधे त तुस लोकां केरे तुहीन केरने सेइं ते मुसीबती सेइं तुस तमाशो बने, ते कधी तुसेईं होरे मुसीबत बरदाशत केरते लाहे ते तुसेईं तैन केरू साथ दित्तू। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />किजोकि तुसेईं कैदन सेइं हमदरदी की, ते अपनो माल भी लुटानो खुशी सेइं कबूल कियो। किजोकि तुस ज़ानते थिये कि अक बड़ी बड्डी खास मलकीत तुसन कांए ज़ै हमेशारे लेईए। <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />एल्हेरेलेइ तुस हिम्मत न हरा, किजोकि तैसेरो फल बड़ो बड्डोए। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />तुसेईं बेड़ि सबरी सेइं कम कियेरू लोड़ते, ताके तुस परमेशरेरी मर्ज़ी पूरी केरतां तै चीज़ हासिल केरि सखथ ज़ेसेरो तैनी वाधो कियोरोए। <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />किजोकि ज़ेन्च़रे पवित्रशास्त्रे मां लिखेरूए,</para>
  <para style="q" vid="HEB 10:37">“हुनी थोड़ू च़िर बाकीए,</para>
  <para style="q" vid="HEB 10:37">कि एजनेबालो एज्जेलो ते च़िर न लाहेलो।<verse eid="HEB 10:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="HEB 10:38" />पन मेरे धर्मी लोक मीं पुड़ विश्वासे रखने सेइं ज़ींते राले,</para>
  <para style="q" vid="HEB 10:38">अगर तैना मीं पुड़ विश्वास केरने करां पत्रोवं हटन त मेरो दिल तैन पुड़ खुशी न भोल्हो।”<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />पन अस हटने बाले नईं, कि परमेशरे पुड़ विश्वास केरने करां पत्रोवं हटम ते नाश भोम, बल्के अस विश्वास केरनेबाले आम, ताके इश्शे प्राण बच़ाए गान।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">विश्वासेरी मिसाल</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />हुनी विश्वास उमीद कियोरी चीज़ां केरू याकीन, ते अलैई चीज़ां केरू सबूते। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />इश्शे दादे पड़दादन भी एरो विश्वास थियो। एल्हेरेलेइ परमेशर तैन पुड़ खुशी भोव। <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />विश्वासे सेइं असन पतो लगते कि दुनियारी हर चीज़ परमेशरेरे वचने सेइं बनोरीए। एल्हेरेलेइ ज़ैन किछ अस लहतम, तैन लेइहोने बैली चीज़न सेइं नईं बनोरूए।<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />विश्वासे सेइं आदमेरे मट्ठे हाबिले अपने बड्डे ढ्ला कैने करां रोड़ू बलिदान परमेशरेरे लेई च़ाढ़ू। ज़ेसेरी वजाई सेइं परमेशरे तैसेरू बलिदान कबूल कियूं, ते तैसेरे बारे मां गवाही दित्ती, कि हाबिल धर्मी मैन्हु आहे। हालांकी हाबिल मेरि जेवरोए, फिरी भी अस तैसेरे विश्वासेरे ज़िरिये परमेशरे पुड़ भरोसो केरनो शिखतम। <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />विश्वासे सेइं हनोक नव्वेंरो मैन्हु मौती करां पेइलो ज़ींतो सुर्गे जो नियो, ते तैसेरो पतो न च़लो, किजोकि परमेशरे तै सुर्गे जो नीयोरो थियो, तैसेरे उबरे गाने करां पेइले तैसेरे हके मां गवाही दित्तोरी थी, कि तैनी परमेशर खुश कियो। <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />किजोकि विश्वासे बगैर परमेशर खुश केरनो नामुमकिने, बस्सा रोड़ू एने कि परमेशरे कां एजनेबालेईं विश्वास कियोरो लोड़े कि परमेशरे, परमेशर तैन ज़ैना तैस सच़्च़ैई सेइं तोपतन फल देते। <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />विश्वासे सेइं नूहे तैन गल्‍लां केरे बारे मां ज़ैना एजने बाले वक्ते मां भोनी बैली थी, परमेशरेरे तरफां हुक्म मैलतां परमेशरेरे प्यारे सेइं तैस पुड़ अमल कियूं, ते अक किश्ती बनाई ज़ैस मां तैसेरू सारू टब्बर बच़ू, एन केरने सेइं तैनी सारी दुनिया मुर्ज़म बनाई ते एप्पू तैस धार्मिकतारो बारस बनो ज़ै विश्वासे सेइं हासिल भोचे।<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />विश्वासे सेइं ज़ैखन परमेशरे अब्राहम, ज़ैस जगाई गाने जो परमेशरे तै कुजेवरो थियो, त तै हुक्म मेनतां तैस जगाई च़लो जेव, ज़ै जगाई बादे मां परमेशर तैस विरासतरो ज़ेरो देनेबालो थियो। हालांकी तै एन भी न थियो ज़ानतो कि अवं कोरहां च़लोरोईं, फिरी भी च़लो जेव। <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />विश्वासेरे ज़िरिये सेइं तै परमेशरेरे कियोरे वाधेरे मुताबिक तैस मुल्खे मां परदेशी केरो ज़ेरो डेरन मां गेइतां बस्सो। ते तैस सेइं साथी तैसेरू मट्ठू इसहाक ते तैसेरू पोट्लड़ू याकूब भी राए, तैन भी परमेशरे करां तैए वाधो मैलो ते तैना भी डेरन मां राए। <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />किजोकि अब्राहम तैस नगरेरे इंतज़ारे मां थियो (ज़ैन सुर्गे मांए) ज़ेसेरी मुनीयाद सदारे लेई आहे, ज़ेसेरो तियार केरनेबालो ते बनानेबालो परमेशरे। <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />विश्वासे सेइं सारा दोज़ींती भोनेरी ताकत हासिल की, हालांकी तै उमरारे हिसाबे सेइं बच्‍चो ज़ांनेरे काबल न थी राहोरी, सारा एन याकीन थियूं कि वाधो केरनेबालो परमेशर अपनो वाधो पूरो केरेलो। <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />ज़ेइस अब्राहम बड़ो बुड्डो थियो ते बच्‍चे पैदा केरनेरे काबल न थियो, अम्बरेरे तारां केरे ते समुन्दरेरी रेतरे बराबर एत्रू हछु वंश पैदा भोव।<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />एन सेब्भी लोकेईं परमेशरे पुड़ भरोसो कियो ते मेरि जे, ते तैन तै कोई चीज़ न मैल्ही ज़ेसेरो वाधो परमेशरे कियोरो थियो, तैनेईं समझ़ू कि परमेशर एन एजने बाले वक्ते मां केरेलो, ते तैना इन भी समझ़ते थिये, कि तैना ज़मीनी पुड़ परदेशी ते मुसाफर आन। <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />ज़ैना एरी गल्‍लां ज़ोतन तैन सेइं एन साबत भोते, कि तैना अज़ तगर अपने मुल्खेरी तलाशी मां आन। <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />अगर तैना तैस मुल्खेरो खियाल रखते भोथे ज़ैस मरां तैना एवरे थिये, त तैना वापस गेइ बटते थिये। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पन असलीती मां तैना एक्‍की रोड़े सुर्गेरे मुल्खेरे उमीदी मां थिये, एल्हेरेलेइ परमेशर तैन केरो परमेशर ज़ुवाने सेइं खुशी भोव, एल्हेरेलेइ तैनी तैन केरे लेई अक नगर तियार कियोरूए।<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />विश्वासे सेइं अब्राहमे अपने इम्तिहानेरे मौके अपने मट्ठे इसहाकेरू बलिदान देने करां न टलो, ज़ैन तैस परमेशरेरे वाधे कबूल केरने बाद मैल्होरो थियूं, तैस्से अकैल्‍ले मट्ठे बलिदान केरने जो तियार भोइ जेव। <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />हालांकी परमेशरे तैस सेइं ज़ोवरू थियूं, “कि इसहाकेरे वंशे सेइं तेरे वंशेरू नवं रालू।” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />किजोकि अब्राहमे याकीन थियूं, कि परमेशरे कां मुड़दन ज़ींते केरनेरी शक्ति आहे, एल्हेरेलेइ लेई ज़ेन्च़रे परमेशरे इसहाक मुड़दन मरां फिरी वापस आनो। <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />विश्वासे सेइं इसहाके अपने दूईये मट्ठन याकूबे ते एसावे आशिर्वाद दित्तो, कि एजने बाले वक्ते मां तैना वाधे पूरे भोल्हे। <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />विश्वासे सेइं याकूबे मरते वक्ते यूसुफेरे दूईये मट्ठन बरकत दित्ती ते अपने सोटरे सहारे सेइं परमेशरेरी आराधना की। <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />विश्वासे सेइं यूसुफे मरते बार पूरे याकीने सेइं ज़ोवरू थियूं, इस्राएली लोक मिस्र मुल्खे शारेले। ते तैन हुक्म दित्तोरो थियो कि ज़ेइस तैना मिस्र मुल्खे मरां निसेले त तैना तैसेरी हेड्डी साथी नेन।<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />विश्वासे सेइं मूसेरे हाज बव्वेईं तैसेरे ज़रमनेरां पत्ती ट्लाई महीन्न तगर छ़ुपेइतां रख्खो, किजोकि तैनेईं हेरू कि तै बच्‍चो खासे, ते तैना राज़ेरो हुक्म ट्लोड़ने करां न डरे। <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />विश्वासे सेइं मूसा बड्डे भोइतां फ़िरौनेरे कुइयरू मट्ठू<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="fq" closed="false">फ़िरौनेरे कुइयरू मट्ठू: </char><char style="ft" closed="false">किजोकि फ़िरौन राज़ेरे कुइयां मूसो पालोरो थियो तांए तैस जो फ़िरौनेरे कुइयरू मट्ठू ज़ोते थिये।</char></note> बन्ने करां इन्कार कमाव। <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />पापेरे थोड़े दिहाड़े आनन्देरी ज़िन्दगी गुज़ारनेरे बजाहे तैनी परमेशरेरे लोकन सेइं साथी मिलतां दुख झ़ैलनो च़ुनो। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />तैनी मसीहेरे लेई दुख झ़ैलनो मिस्रेरे खज़ानन् करां जादे दौलत समझ़ी, किजोकि तै ज़ानतो थियो कि तैस सुर्गे मां इनाम मैल्हनूए। <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />विश्वासे सेइं तैनी राज़ेरे सरकरो डर न कियो, बल्के मिस्र मुल्ख छ़ेडी दित्तो, एल्हेरेलेइ तैनी समझ़ोरू थियूं ज़ेन्च़रे तैनी न लेइहोने बाले परमेशरे लाहू। <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />विश्वासे सेइं मूसे इस्राएली लोकन हुक्म दित्तो कि तैना फ़सह तिहारेरी दिहाड़ी बनानी ते गबड़ेरो खून दारन छ़िड़कन, ताके मौतरो स्वर्गदूत ज़ै परमेशरेरी तरफां भेज़ोरोए इस्राएलेरे ज़ेठे मट्ठन न मैरी बटे। <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />विश्वासे सेइं इस्राएली लोक लाल समुन्दरे मांमेइं एन्च़रे लंघे ज़ेन्च़रे शुक्‍कोरी ज़मीनी पुड़मेइं पार निस्से, पन ज़ैखन मिस्रेइं तैट्ठां पार लंघनेरी कोशिश की त तैना डुबतां मेरि जे। <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />किजोकि इस्राएली लोकेईं परमेशरे पुड़ विश्वास कियो, ते सत दिहैड़न तगर यरीहो नगरेरे चक्‍कर लाए (ज़ेन्च़रे परमेशरे ज़ोवरू थियूं) ते दिवार डुल्‍ली। <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />विश्वासे सेइं राहाब वेश्या परमेशरेरे हुक्म न मन्ने बालन साथी नाश न भोइ; एल्हेरेलेइ कि तैसां इस्राएली जासूस शैन्ति सेइं अपने घरे मां आने ज़ैना छ़ेपतां यरीहो नगरे हेरने एवरे थिये।<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />हुनी होरू किछ ज़ोनेरी ज़रूरत नईं। हुनी मीं कां वक्त नईं कि एरे ज़ेरे लोकां केरे बारे मां ज़ोईं, ज़ेन्च़रे गिदोन, बाराक, शिमशोन, यिफतह, दाऊद, ते शमूएल ते होरे नबी। <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />तैनेईं विश्वासे सेइं राज़्ज़ां ज़ींतां, ते धार्मिकतारां कम्मां कियां ते वाधो कियोरी चीज़ां हासिल की, ते शेरेईं तैना न खाए। <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />अग्गां तैना न फुक्‍के, ते तलवारी सेइं तैना न मारे जे, ज़ैखन तैना कमज़ोर थिये तैखन तैन ताकतबर बनाए, ते जंगी मां भी बहादर निस्से, ते तैनेईं दुश्मना केरि फौज निशानी।<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />विश्वासे सेइं किछ कुआन्शन अपने मुओरे लोक ज़ींतो मैल्हे, किछ मार खांते-खांते मेरि जे। ते तैनेईं अपनो विश्वास शारनो न चाव, तैसेरे बदले मां तैनेईं कैद रानू मन्ज़ूर कियूं, एल्हेरेलेइ तैना मरनेरां बाद फिरी ज़ींते भोन, ते तैन रोड़ी ज़िन्दगी मैल्हे। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />किछ लोकां केरो मज़ाक बनाव जेव, किछ लोकन कोड़े बाए, ते किछ शंगलन सेइं बन्धे ते कैदखाने मां छ़डे। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />ते किछन घोड़ेईं बैई; ते आरे सेइं च़िरे, ते तलवारी सेइं मारे जे। तैना गरीब थिये, तैन दुख दित्तो जेव ते तैन सेइं बुरो बर्ताव कियो जेव। तैना भैड्डां छ़ेल्‍ली केरि खाड़ी लेइतां इरां उरां नश्शते थिये। <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />तैना जंगलन ते पहाड़न ते कुढन मां ते धेरतरे खडन मांमेइं हंठते थिये।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />इन बुरू संसार तैन विश्वासी लोकां केरे काबल न थियूं, तैन सेब्भी केरे विश्वासेरे वजाई सेइं परमेशर तैन पुड़ खुश भोव, पन तैन, तैन मैल्हू ज़ेसेरो वाधो परमेशरे कियोरो थियो। <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />किजोकि परमेशरे कां न सिर्फ तैन केरे लेई बल्के इश्शे लेई रोड़ी योजनाए। परमेशर तैन शुद्ध बनानो चाते, पन सिर्फ असन सेइं साथी।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">बाजी परमेशरेरे ज़िरिये हदैइत</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />एल्हेरेलेइ ज़ैखन गवाहां केरे एत्रो बड्डो घाने असां घेरोरेम, त अस भी सैरी रुकावटां ते तैस पापे दूर केरम ज़ै असन उलझाते, ते तैस दौड़ी ज़ै असेईं दौड़नीए बल्हे सेइं दौड़म। <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />एज्जा अस विश्वासे मां पवित्र केरनेबाले यीशु पुड़ नज़र रखम, ज़ैनी तैस आनन्देरे लेई ज़ै तैसेरे सामने थियो, बेइज़्ज़तरी परवाह न की, बल्के क्रूसेरो दुख झ़ैल्‍लो ते परमेशरेरे तखतेरे देइने पासे गेइतां बिश्शो।<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />तुस एस गल्‍ली पुड़ खियाल केरा, कि अपने खलाफत केरनेबाले ज़ैनी पैपी केरि तरफां केत्रो दुख झ़ैल्‍लो, ताके तुस बेदिल भोइतां हिम्मत न हारथ। <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />तुसेईं पापे सेइं लड़ते-लड़ते हेजू तगर एत्रो मुकाबलो नईं कियोरो कि तुसेईं अपनो खून बगेवरो भोए। <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />ते तुसेईं तैन समझ़ानू बिसरी छ़ड्डू, कि ज़ैस मां तुसन जो मट्ठां ज़ोवं,</para>
  <para style="q" vid="HEB 12:5">“कि हे मेरे बच्‍चव परमेशरेरे हुक्मे एरे न समझ़ा।</para>
  <para style="q" vid="HEB 12:5">ते ज़ैखन प्रभु तीं झ़िड़के त शारनेरे ज़ेरे मैसूस न केर।<verse eid="HEB 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 12:6" />किजोकि ज़ैस सेइं परमेशर प्यार केरते तैस झ़िड़ते भी,</para>
  <para style="q" vid="HEB 12:6">ते ज़ैस तै अपनु मट्ठू बनाते तैस सोटेईं भी बाते।”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />ऐह हदैइत तुश्शे समझ़नेरे लेइए, एस बल्हे सेइं बरदाशत केरा, परमेशर तुसन अपना मट्ठां सेमझ़तां बर्ताव केरते, किजोकि तैन कौन ज़ेरू मट्ठूए ज़ैस तैसेरो बाजी समझ़ाए नन्ना? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />पन अगर तुसन सुधारे न गाथ ज़ेसेरे हिस्सेदार सब भोतन त तुस न गैर औलाद भोनेथ न की अपना मट्ठां। <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />एसेरे अलावा ज़ैखन इश्शे जिसमानी बाजी सुधारते रहते थिये ते अस तैन केरि इज़्ज़त केरते राए, त कुन आत्मां केरो बाजी यानी परमेशरेरी जादे इज़्ज़त न केरम ताके ज़ींते रहम। <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />इश्शे जिसमानी बाजी त थोड़े दिहाड़ां केरे लेई एपनी समझ़रे मुताबिक असन सुधारते रहते थिये, पन परमेशर इश्शे फैइदेरे लेई असन सुधारते ताके असां तैसेरी पवित्रतैई मां शामल भोम। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />एसमां शक नईं कि ज़ैखन केन्ची हदैइत की गाचे त तै खुशी नईं, बल्के बड़ू बुरू बुझ़ते, पन ज़ैखन तै बले-बले पक्‍को भोइ गाते त तैस बादे मां धर्मी बेनतां चैनरो फल मैलते।<verse eid="HEB 12:11" /></para>
  <para style="s">शिक्षा ते हदैइत</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />बस्सा एपनी कमज़ोर पैखड़न ते कमज़ोर ज़ैन्धु मज़बूत केरा। <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />ते अपने पव्वन सिद्धी बत्तां च़लाथ ताके टोन्टे टेपलोए न ते तैना बेझ़ोन।<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />सेब्भन सेइं मेल मिलापे सेइं राथ, ते तै पवित्रताई हासिल केरनेरी हर वक्त कोशिश केरा ज़ेसेरे बगैर कोई प्रभु न लेई सके। <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />खबरदार एरू न भोए कि कोई मैन्हु परमेशरेरे अनुग्रहे करां रेइ गाए, एरू न भोए कि कोई ट्लिठू ज़ील लग्गे ते तुसन परेशान केरे ते होरे लोक भी भिटे भोइ गान। <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />ते न कोई मैन्हु तुसन मां बदमाशी केरनेबालो भोए, या एसावेरो ज़ेरो अधर्मी न बने, ज़ैनी एक्‍की बार रोट्टी खानेरे लेई अपने बड्डे भोनेरू हक बेच़तां छ़डू। <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />किजोकि तुस ज़ानतथ कि बादे मां ज़ैखन तैनी तै बरकत हासिल केरनेरी कोशिश की, त तैस न मैल्ही, तैस अपनि नियत बदलनेरो मौको न मैल्हो हालांकी तै लेरां देइ-देइ तैस तोपनेरी कोशिश केरतो राव।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तुस तैस पहाड़े कां नेड़े नईं एवरे, ज़ैस सेइं तुस हुरी सकते थिये, तैन पहाड़ अग्गी सेइं फुकोतू थियूं ते अंधगुबारी ते बड़ो तूफान थियो। <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />तैड़ी नरशिंगेरी शोर ते शुनाने बालेरी एरी आवाज़ शुनोती थी, कि ज़ैखन लोकेईं तै आवाज़ शुनी त मिन्नत केरने लगे, कि असन सेइं होरि गल्‍लां न केर। <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />एल्हेरेलेइ कि तैनेईं तै हुक्म बरदाशत न केरि बटो, “अगर कोई जानबर भी एस पहाड़े सेइं हुरेलो त तै घोड़ेईं बैइतां मारो गालो।” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />तै नज़ारो एत्रो खतरनाक थियो कि मूसे ज़ोवं, “अवं डरने ते थरकने लगोरोईं।”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />बल्के तुस सिय्योनेरे पहाड़े ते ज़ींते परमेशरेरे नगर यानी सुर्गेरे यरूशलेमे मां लखेइं स्वर्गदूतन कां खुशी मनाने एवरेथ। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />ते तुस परमेशरेरे ज़ेठे बच्‍चां केरि सभाई मां ते कलीसियाई मां एवरेथ, एना तैना लोकन ज़ैन केरां नव्वां सुर्गे मां लिखोरेन, तुस न्याय केरनेबाले परमेशरे कां एवरेथ, ते धेर्मी केरि आत्मान कां एवरेथ, यानी तैन कां ज़ैना सिद्ध कियोरेन। <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />तुस नंव्वे करारेरे बिचवाई केरनेबाले यीशु ते तैसेरे छ़िड़कोरे खूने कां एवरेथ, ज़ै हाबिलेरे खूने करां रोड़ी गल्‍लां ज़ोते।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />खबरदार राथ, तुस परमेशरेरो ज़ै तुसन सेइं गल्‍लां केरते तैसेरो इन्कार न केरथ, किजोकि ज़ैनेईं ज़मीनी पुड़ हदैइत केरनेबालेरो इन्कार कियो त तैना न बंच़े, त अगर अस सुर्गे हदैइत केरनेबालेरो इन्कार केरमेले त केन्च़रे बच़मेले? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />तैखन तैसेरी आवाज़ी सेइं धरती हिल्‍ली जेई पन तैनी ई वाधो कियोरोए कि, “एक्‍की फेरे फिरी अवं सिर्फ ज़मीन नईं बल्के अम्बरे भी हिलेइलो।” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />तैसेरू “एक्‍की फेरे फिरी” ज़ोने सेइं साफ पतो लगते की पैदा कियोरी चीज़ां ज़ैना हिलचन तैना खतम भोनिन ताके ज़ैना हिलन नन्ना तैना रैनिन। <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />ज़ैड़ी असन तैन राज़ मैल्हने लगोरूए ज़ैन हिलनेरू नईं त एज्जा अस तैसेरू शुक्र केरम ते हिम्मत केरम कि, अस परमेशरेरी आराधना परमेशरेरे डरे सेइं केरि बटम ज़ैस सेइं तै खुश भोए। <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />किजोकि इश्शो परमेशर भस्म केरनेबैली अग्गरो ज़ेरोए।<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">मसीह ज़िन्दगी ज़ींनेरी हदैइत</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />एक्‍की होरि सेइं ढ्ला ते बेइनां केरो ज़ेरो प्यार केरते राथ। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />बखले लोकां केरि खातरदारी केरा, किजोकि एरू केरने सेइं किछेईं अनज़ाने मां स्वर्गदूतां केरि खातरदारी कियोरीए। <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />कैदन याद रखा, मन्ना कि ज़ेन्च़रे तुस एप्पू भी तैन सेइं साथी कैद आथ, ते ज़ैन सेइं बुरो बर्ताव भोते तैन भी याद रखा, इन सेमझ़तां मन्ना कि ज़ेन्च़रे तुसन सेइं बुरो बर्ताव भोव। <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />ड्लाह बनानो सेब्भी लोकन मां इज़्ज़तरी गल समझ़ी गाए, ते कुआन्श ते मड़द एक्‍की होरेरे लेई वफादार रान, किजोकि परमेशर बदमाशी केरने ते नाजाइज़ रिशते रखनेबालां केरो न्याय केरेलो। <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />अपने आपे दौलतरे लालच़े करां दूर रखा, ते ज़ेत्रू तुसन कांए तैस्से मां राज़ी राथ, किजोकि परमेशरे एप्पू एन ज़ोवरूए, “अवं तीं करां कधे भी दूर न भोइलो, ते न कधे तीं शैरेलो।” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />एल्हेरेलेइ अस दिलेरी सेइं ज़ोई सकतम कि, “प्रभु मेरो मद्दत केरनेबालोए, अवं न डेरेलो इन्सान मेरू कुन बगैड़ी सकते?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />ज़ैना तुश्शे अगुवे थिये, तैन याद रखा, ज़ैनेईं तुसन परमेशरेरू वचन शुनावरू थियूं, इस गल्‍ली पुड़ ध्यान देथ, कि तैना केरही ज़िन्दगी गुज़ैरतां च़ले जे, ते ज़ेरो विश्वास तैन थियो तुस भी तैन केरो ज़ेरो विश्वास केरा। <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />यीशु मसीह हीज ते अज़ बल्के हमेशारे लेई अक्‍कां ज़ेरोए। <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />अलग-अलग किसमां केरि शिक्षाई सेइं न टेपलोथ, रोड़ू एन्ने कि तुश्शो दिल परमेशरेरे अनुग्रहे सेइं मज़बूत राए, न कि एरो परहेज़ेरे खाने सेइं, ज़ेसेरे खाने बालन कोई फैइदो न मैल्हो। <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />इश्शी अक एरी बलिदान केरनेरी ठारे, तैस मरां तैन खानेरो कोई अधिकार नईं ज़ैना तेम्बु मां सेवा केरतन। <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />किजोकि महायाजक ज़ैन जानबरां केरो खून मन्दरे मां परमपवित्र ठैरी मां पापेरे बलिदानेरे लेई नेतो थियो, तैन केरो बाकी जिसम ज़ैड़ी इस्राएली लोक रहते थिये तैट्ठां बेइर फुकते थिये। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />एल्हेरेलेइ, यीशुए भी लोक एप्पू अपने खूने सेइं पवित्र केरनेरे लेई यरूशलेम नगरे करां बेइर दुख झ़ैल्‍लो ते मरो। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />एल्हेरेलेइ, एज्जा अस भी यहूदी केरि रसमन शैरतां यीशु पुड़ विश्वास केरम ते तैसेरो ज़ेरो दुख ते निन्दा झ़ैल्‍लम। <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />किजोकि ई दुनिया इश्शू हमेशारू घर नईं, पन अस एजने बाले घरेरे इंतज़ारे मां आम ज़ैन एजने बाले वक्ते मां इश्शू भोल्हु। <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />एल्हेरेलेइ असां यीशुएरे ज़िरिये परमेशरेरे लेई तारीफ़रू बलिदान च़ाढ़म, यानी ज़ैखन अस अपने शब्दन सेइं इकरार केरतम कि यीशु इश्शो प्रभुए। <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />पन भलियाई केरा ते ज़ैन ज़रूरते तैन केरि मद्दत केरा, किजोकि परमेशर एरे ज़ेरे बलिदान्न सेइं खुश भोते।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />अपने अगुवां केरो हुक्म मन्ना, ते तैन केरे अधीन राथ, किजोकि तैन केरे ज़िमेदारी कि तैना प्राणा केरि रखवाली केरन, ते एस कम्मेरो तैनेईं परमेशरे हिसाब भी देने पेनोए। अगर तुस तैन केरो हुक्म मन्नेले त तैना अपनु कम खुशी सेइं केरेले त तुसन फैइदो भोल्हो, पन अगर तैस कम तकलीफ बुझ़ेले त तुसन कोई फैइदो न भोल्हो। <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />इश्शे लेई प्राथना केरते राथ, असन याकीने इश्शो ज़मीर साफे, ते अस हर हिसाबे सेइं नेक नीती सेइं ज़िन्दगी गुज़ारनी चातम। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />अवं तुसन कां बिनती केरताईं कि मेरे लेई प्राथना केरा, कि अवं फिरी लूशी तुसन कां एज्जी सेखी।<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />हुनी शान्ति देनेबालो परमेशर, ज़ै भैड्डां केरो महान रखवालो मतलब प्रभु यीशु मसीहे, इश्शे प्रभु हमेशारे करारेरे खूने सेइं मुड़दन मरां ज़ींतो कियो, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तुसन हर रोड़े कम्मे मां सिद्ध केरे, ज़ैस सेइं तुस तैसेरी मर्ज़ी पूरी केरथ, ते ज़ैन किछ परमेशरे पसंद एइते तैस यीशु मसीहेरे ज़िरिये असन मां केरे, ते मसीहेरी बडीयाई हमेशा-हमेशा भोती राए, आमीन।<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />हे ढ्लाव ते बेइनव, अवं तुसन कां बिनती केरताईं कि मेरी तुस तैना गल्‍लां सबरी सेइं शुना, ज़ैना मीं तुश्शे हिम्मत बद्धानेरे लेई लिखोरिन, किजोकि ई चिट्ठी ज़ै मीं तुसन लिखी बड़ी नईं। <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />ताके तुसन पतो लग्गे कि इश्शो विश्वासी ढ्ला तीमुथियुस कैदेरां छुटोरोए, ते अगर तै जल्दी अव, त अस दूईये तुसन सेइं मिलमेले।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />अपने सेब्भी विश्वासी लोकन ते सेब्भी पवित्र लोकन जो इश्शू नमस्कार ज़ोथ। इतालिया मुल्खेरे विश्वासी लोकेईं तुसन जो नमस्कार ज़ोवरूए।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />तुसन सेब्भन पुड़ परमेशरेरो अनुग्रह भोतो राए, आमीन।<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>