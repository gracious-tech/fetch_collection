  <para style="h">कहावतां</para>
  <para style="toc1">कहावतां</para>
  <para style="toc2">कहावतां</para>
  <para style="toc3">कह.</para>
  <para style="mt">कहावतां</para>
  <para style="is">लिखने बालो</para>
  <para style="ip">सुलैमान राज़ो कहावतां केरो खास लिखने बालो थियो। इन वचन्न मां (<char style="xt"><ref loc="PRO 1:1">1:1</ref>;<ref loc="PRO 10:1">10:1</ref>;<ref loc="PRO 25:1">25:1</ref></char>) मां सुलैमानेरू नवं बांदू भोते। बाकी होरे लिखने बालन मां अक टोली ज़ैस जो “अक्लमन्द” ज़ोते थी, तैन केरू नवं आगूर ते राज़ो लमूएल आहे।</para>
  <para style="ip">बाकी कहावतां परमेशरेरे मुक्तरी योजनारे पासे इशारो केरतिन। इस किताबां इस्राएली लोकन परमेशरेरे बत्ती पुड़ च़लनेरो सही तरीको हिरावरोए। इन मुमकिने कि परमेशरे सुलैमान प्रेरित कियो कि तै तैन अक्लमन्द वचना केरे बुनियादी पुड़ अकोट्ठे केरे ज़ैना तैने अपने पूरे ज़िन्दगी मां लिखोरे थिये।</para>
  <para style="is">लिखनेरी तारीक ते जगाह</para>
  <para style="ip">लगभग 971-686 ई. पू.</para>
  <para style="ip">सुलैमान राज़ेरे राज़ केरनेरे वक्ते मां इस्राएले मां, कहावतां हज़ारेईं साल पेइली लिखोरे थी। इसेरे अक्लरी गल्‍लां कोन्ची भी संस्कृति कोन्ची वक्ते कम्मे एजने बैली आन।</para>
  <para style="is">शुन्ने पढ़नेबाले</para>
  <para style="ip">कहावतां केरे बड़े शुन्ने ते पढ़ने बालेन। इना बच्‍चां केरे लेई रोड़ी बत्ती पुड़ च़लानेरे लेई अम्मा बाजी केरे लेई आन। जुवान मट्ठां कुइयां ज़ैना अक्लरे तोपी मां आन तैन केरे लेई भी आन। ते पवित्रशास्त्र पढ़ने बालां केरे लेई, ज़ैना परमेशरेरी भक्ति केरतां ज़िन्दगी ज़ींनी चातन।</para>
  <para style="is">मकसद</para>
  <para style="ip">कहावतां केरि किताबी मां सुलैमान उच्‍चे ते महान ते आम ते रोज़ेरी ज़िन्दगी ज़ींने मां परमेशरेरी सलाही बांदो केरते। एरू लगते कि सुलैमान राज़ेरे नज़री मां कोई मुद्दो नईं बच़ोरो। व्यक्तिगत रिश्तो, जिसमानी रिश्तो, बुपार, धन-दौलत, दान, इच्छा, अनुशासन, कर्ज़ो, पालन-पौषन, चाल-चलन, शराब पीनी, सियासत, बदलो ते परमेशरेरी भक्ति ते इन सब मुद्दां केरे बारे मां तैने लिखेरूए।</para>
  <para style="is">खास मुद्दो</para>
  <para style="ip">अक्ल</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. अक्लरे रोड़े गुण <char style="ior"><ref loc="PRO 1:1-9:18">1:1—9:18</ref> </char></para>
  <para style="io1">2. सुलैमानेरी कहावतां <char style="ior"><ref loc="PRO 10:1-22:16">10:1—22:16</ref> </char></para>
  <para style="io1">3. अक्लमन्दा केरे वचन <char style="ior"><ref loc="PRO 22:17-29:27">22:17—29:27</ref> </char></para>
  <para style="io1">4. आगूरेरे वचन <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref> </char></para>
  <para style="io1">5. लमूएलेरे वचन <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref> </char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">अक्लमन्द भोनेरी शुरुआत</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />दाऊदेरे मट्ठे सुलैमान इस्राएलेरे राज़ेरी कहावतां:<verse eid="PRO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2" />इन कहावतां केरो पढ़नेबालो अक्ल ते शिक्षा हासिल केरे,</para>
  <para style="q" vid="PRO 1:2">ते समझ़री गल्‍लां समझ़े,<verse eid="PRO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3" />ते अक्लमन्द ज़िन्दगी गुज़ारने मां माहिर,</para>
  <para style="q" vid="PRO 1:3">ते धर्म, न्याय ते बगैर तरफदैरारे बारे मां अनुशासन हासिल केरे;<verse eid="PRO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4" />ताके सिद्धे-सादन होशियारी,</para>
  <para style="q" vid="PRO 1:4">ते जुवाने ज्ञान ते तमीज़ मैल्हे;<verse eid="PRO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5" />कि अक्लमन्द शुन्तां अपनु ज्ञान बधाए,</para>
  <para style="q" vid="PRO 1:5">ते समझ़दारे अक्लरो उपदेश मैल्हे,<verse eid="PRO 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6" />ज़ैस सेइं तैना कहावतन ते मसालन,</para>
  <para style="q" vid="PRO 1:6">ते अक्लमन्दा केरि गल्‍लां ते तैन केरे भेदन समझ़न।<verse eid="PRO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7" />यहोवारो डर मन्नो अक्लरी शुरुआते;</para>
  <para style="q" vid="PRO 1:7">अक्ल ते शिक्षाई बेवकूफ लोक घटिया समझ़तन।<verse eid="PRO 1:7" /></para>
  <para style="s">बुरी सलाही करां बच़नू</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8" />हे मेरे मट्ठा, अपने बाजी केरि शिक्षा शुन,</para>
  <para style="q" vid="PRO 1:8">ते अपने अम्मरी शिक्षाई न शार;<verse eid="PRO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9" />किजोकि तैन मन्ना तेरे क्रोड़रे लेई शोभारू ताज,</para>
  <para style="q" vid="PRO 1:9">ते तेरे गलेरे लेई माला भोल्ही।<verse eid="PRO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10" />हे मेरे मट्ठा, अगर पापी लोक तीं शिखालन,</para>
  <para style="q" vid="PRO 1:10">त तैन केरि गल न मेन्नां।<verse eid="PRO 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11" />अगर तैना ज़ोन, “असन सेइं साथी च़ल,</para>
  <para style="q" vid="PRO 1:11">कि अस केन्चेरो कत्ल केरनेरे लेई बिश्शम, ते अस बेकसूर लोकन पुड़ हमलो केरम;<verse eid="PRO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12" />अस तैन्न ज़ींते निगलम, ज़ेन्च़रे पाताल सझ़र लोकन निगलते,</para>
  <para style="q" vid="PRO 1:12">ते तैन्न कब्री मां पेवरे मरोरे लोकां केरे ज़ेरे बनाम।<verse eid="PRO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13" />असन हर किसमेरी कीमती चीज़ां मैल्हेली,</para>
  <para style="q" vid="PRO 1:13">अस अपने घरन लूटरे माले सेइं<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fq" closed="false">लूटरे माले सेइं</char><char style="ft" closed="false">लूटरो मतलब तैन सैरी चीज़ां ज़ैना जंगी मां मारोरे लोकन करां नेवरू भोन</char></note> भरमेले;<verse eid="PRO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14" />तू इश्शो हिस्सेदार भोइ गा,</para>
  <para style="q" vid="PRO 1:14">इश्शो सेब्भी केरो अक्‍के बेटवो भोए,”<verse eid="PRO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15" />पन हे मेरे मट्ठा तू तैन सेइं साथी तैन केरे बत्तां न च़ेलां,</para>
  <para style="q" vid="PRO 1:15">बल्के तैन केरि बत्ती मां पव भी नईं रखनो;<verse eid="PRO 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16" />किजोकि तैना बुराई केरने जो दौड़तन,</para>
  <para style="q" vid="PRO 1:16">ते कत्ल केरनेरे लेई जल्दी केरन।<verse eid="PRO 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17" />किजोकि ज़ैखन च़ुड़ोलोवं तकतू भोए तैखन जाल बिछ़नेरो कोई फैइदो नईं;<verse eid="PRO 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18" />ते इना लोक त अपनो खून केरनेरे लेई बिशतन,</para>
  <para style="q" vid="PRO 1:18">ते अपने प्राणन मारनेरे लेई ताकी मां रहतन।<verse eid="PRO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19" />सब लालच़ी लोकां केरि चाल एरी भोतीए;</para>
  <para style="q" vid="PRO 1:19">तैन केरो प्राण लालच़ेरे वजाई सेइं नाश भोइ गाते।<verse eid="PRO 1:19" /></para>
  <para style="s">ज्ञानेरी पुकार</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20" />अक्ल सड़की मां उच्‍ची आवाज़ी सेइं ज़ोतीए;</para>
  <para style="q" vid="PRO 1:20">ते चौकन मां प्रचार केरतीए;<verse eid="PRO 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21" />तै उच्‍ची ठारी पुड़ बज़ारां केरि भीड़ी मां हक देतीए;</para>
  <para style="q" vid="PRO 1:21">तै नगरेरे फाटकन<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">नगरेरे फाटकन </char><char style="ft" closed="false">ई नगरेरो तै हिस्सोए ज़ैड़ी कानूनी ते सियासी मामलां केरो हल कढो गाते, ज़ेन्च़रे कि पंचाइती घर।</char></note> मां खड़ी भोइतां, इन ज़ोतीए:<verse eid="PRO 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22" />“हे अज्ञानी लोकव, तुस किताली तगर अज्ञानता सेइं प्यार रखेले?</para>
  <para style="q" vid="PRO 1:22">ते हे मज़ाक बनाने बालव, तुस किताली तगर मज़ाक बनाने सेइं खुश राले?</para>
  <para style="q" vid="PRO 1:22">हे बेवकूफव, तुस किताली तगर ज्ञाने सेइं बैर रखेले?<verse eid="PRO 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23" />तुस मेरी डांट शुन्तां मन फिराथ;</para>
  <para style="q" vid="PRO 1:23">शुना, अवं अपनि आत्मा तुश्शे लेई उलटाली;</para>
  <para style="q" vid="PRO 1:23">अवं तुसन अपनु ज्ञान देइली।<verse eid="PRO 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24" />मीं त हक दित्ती पन तुसेईं इन्कार कियो,</para>
  <para style="q" vid="PRO 1:24">ते मीं तुसन कुजानेरे लेई हथ<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="fq" closed="false">कुजानेरे लेई हथ </char><char style="ft" closed="false">मतलब सुवागत केरनेरे लेई</char></note> अग्रोवं किये, पन केन्चे ध्यान न दित्तू,<verse eid="PRO 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25" />बल्के तुसेईं मेरी सारी सलाह न शुनी,</para>
  <para style="q" vid="PRO 1:25">ते मेरी झ़िड़करी कीमत न ज़ानी;<verse eid="PRO 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26" />एल्हेरेलेइ अवं भी ज़ैखन तुसन पुड़ आफत एज्जेली तैखन हस्सेली;</para>
  <para style="q" vid="PRO 1:26">ते ज़ैखन तुसन पुड़ डर एज्जे, तैखन अवं मज़ाक बनाली।<verse eid="PRO 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27" />ज़ैखन तूफानेरो ज़ेरो तुसन पुड़ खतरो एज्जेलो,</para>
  <para style="q" vid="PRO 1:27">ते मुसीबत तूफानेरी ज़ेरि एज्जेली,</para>
  <para style="q" vid="PRO 1:27">ते तुस मुसीबत ते मुश्किली मां फसेले, तैखन अवं मज़ाक बनाली।<verse eid="PRO 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28" />तैस वक्ते तैना मींजो हक देले, ते अवं न शुनेली;</para>
  <para style="q" vid="PRO 1:28">तैना मीं दिले सेइं त तोपेले, पन हासिल न केरि सकेले।<verse eid="PRO 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29" />किजोकि तैनेईं ज्ञाने सेइं बैर कियो,</para>
  <para style="q" vid="PRO 1:29">ते यहोवारो डर मन्नो तैन्न रोड़ो न लग्गो।<verse eid="PRO 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30" />तैनेईं मेरी सलाह न मन्नी</para>
  <para style="q" vid="PRO 1:30">बल्के मेरी सब झ़िड़कां घटिया सेमझ़ी।<verse eid="PRO 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31" />एल्हेरेलेइ तैना अपनि केरनरो फल एप्पु भुगतेले,</para>
  <para style="q" vid="PRO 1:31">ते एपनी योजनारे फले सेइं भेरोले।<verse eid="PRO 1:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32" />किजोकि अज्ञानी लोकां केरू टेपलोनू, तैन केरे मारे गानेरी वजा भोल्ही,</para>
  <para style="q" vid="PRO 1:32">ते बे फिक्र रानेरी वजाई सेइं बेवकूफ लोक नाश भोल्हे;<verse eid="PRO 1:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33" />पन ज़ै मेरी शुनेलो, तै निडर बस्सोरो रालो,</para>
  <para style="q" vid="PRO 1:33">ते मुसीबती करां बे फिक्र भोइतां सुखे सेइं रालो।”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">ज्ञानेरी कीमत</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1" />हे मेरे मट्ठा, अगर तू मेरी गल्‍लन कबूल केरस,</para>
  <para style="q" vid="PRO 2:1">ते मेरे हुक्मन अपने दिले मां रख्खस,<verse eid="PRO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2" />ते अक्लरी गल ध्याने सेइं शुनस,</para>
  <para style="q" vid="PRO 2:2">ते समझ़री गल मन लेइतां सोचस;<verse eid="PRO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3" />अगर तू अक्ल ते समझ़रे लेई बड़े ज़ोरे सेइं फरियाद केरस,<verse eid="PRO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4" />ते तैस चैंदरो ज़ेरो तोपस,</para>
  <para style="q" vid="PRO 2:4">ते छ़पोरे खज़ानेरे ज़ेरे तैसेरी तोपी मां लगोरो रास;<verse eid="PRO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5" />त तू यहोवारे डरे समझ़ेलो,</para>
  <para style="q" vid="PRO 2:5">ते परमेशरेरू ज्ञान तीं मैल्हेलू।<verse eid="PRO 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6" />किजोकि अक्ल यहोवा देते;</para>
  <para style="q" vid="PRO 2:6">ते ज्ञान ते समझ़री गल्‍लां तैसेरे ऐशी मरां निसतिन।<verse eid="PRO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7" />तै सिद्धे लोकां केरे लेई रोड़ी अक्ल रखते;</para>
  <para style="q" vid="PRO 2:7">ज़ैना ईमानदैरी सेइं च़लतन, तैन केरे लेई तै ढालरो ज़ेरो ठहरते।<verse eid="PRO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8" />तै न्याय केरनेबालां केरि हेर-गेश केरते,</para>
  <para style="q" vid="PRO 2:8">ते अपने भक्तां केरे बत्तां केरि हिफाज़त केरते।<verse eid="PRO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9" />तैखन तू धर्म ते न्याय ते ईमानदारी,</para>
  <para style="q" vid="PRO 2:9">मतलब सब रोड़ी चाल सेमझ़ी सकेलो;<verse eid="PRO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10" />किजोकि अक्ल त तेरे दिले मां दाखल भोल्ही,</para>
  <para style="q" vid="PRO 2:10">ते ज्ञान तेरे प्राणे सुख देने बालू भोल्हु;<verse eid="PRO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11" />समझ़दारी तीं सुरक्षित रखेली;</para>
  <para style="q" vid="PRO 2:11">ते समझ़ तेरी हिफाज़त केरनेबाली भोल्ही;<verse eid="PRO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12" />ताके तैना तीं बुरैइारे बत्ती करां,</para>
  <para style="q" vid="PRO 2:12">ते उलट-फेरेरी गल्‍लां ज़ोनेबालन करां बच़ैली,<verse eid="PRO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13" />ज़ैना सच़्च़ेरी बत शारतन,</para>
  <para style="q" vid="PRO 2:13">ताके आंधरे बत्ती मां च़ेलि सकन;<verse eid="PRO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14" />ज़ैना बुराई केरने सेइं खुश भोतन,</para>
  <para style="q" vid="PRO 2:14">ते दुष्ट मैन्हेरी उलट-फेरेरी गल्‍लन मां मघन रहतन;<verse eid="PRO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15" />ज़ैन केरे चाल च़लन टारे-टिन्चे भोतन</para>
  <para style="q" vid="PRO 2:15">ते ज़ैन केरि बत्तां बुरी आन।<verse eid="PRO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16" />अक्ल ते ज़मीर तीं बखली कौन्शी करां बच़ाले,</para>
  <para style="q" vid="PRO 2:16">ज़ै मिट्ठी-मिट्ठी गल्‍लां केरतीए,<verse eid="PRO 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17" />ज़ै अपने जुवैनरे साथी शारतीए,</para>
  <para style="q" vid="PRO 2:17">ते ज़ै अपने परमेशरेरे करारे बिसरी गाचे।<verse eid="PRO 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18" />तैसेरू घर मौतरे ढलाने पुड़े,</para>
  <para style="q" vid="PRO 2:18">ते तैसारी बत्तां मरोरां केरे दरमियान पुज़ैतिन;<verse eid="PRO 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19" />ज़ैना तैस कां गातन, तैन मरां कोई भी वापस एज्जी न सके;</para>
  <para style="q" vid="PRO 2:19">ते न तैन ज़िन्दगरी बत मैल्हे।<verse eid="PRO 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20" />एल्हेरेलेइ तू भले मैन्हु केरे बत्तन मां च़ल,</para>
  <para style="q" vid="PRO 2:20">ताके धर्मी लोकां केरि बत्तन ट्लेइतां रख्खस।<verse eid="PRO 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21" />किजोकि धर्मी लोक मुल्खे मां बस्सोरे राले,</para>
  <para style="q" vid="PRO 2:21">ते सच़्च़े लोक तैस मां बनोरे राले।<verse eid="PRO 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22" />दुष्ट लोक तैस मुल्खे मरां नाश भोल्हे,</para>
  <para style="q" vid="PRO 2:22">ते धोखेबाज़ तैस मरां ढ्लूड़े गाले।<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">जुवानन बत हिरानी</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1" />हे मेरे मट्ठा, मेरी शिक्षाई न बिसरां;</para>
  <para style="q" vid="PRO 3:1">ते मेरे हुक्म अपने दिले मां रेखां;<verse eid="PRO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2" />किजोकि एरू केरने सेइं तेरी उमर बधेली,</para>
  <para style="q" vid="PRO 3:2">ते तू बड़े सुखे सेइं रालो।<verse eid="PRO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3" />ईमानदारी ते वफादारी तीं करां अलग न भोए;</para>
  <para style="q" vid="PRO 3:3">बल्के तैन्न अपने गलेरो हार बना,</para>
  <para style="q" vid="PRO 3:3">ते अपने दिलेरे तेख्ती पुड़ लिख।<verse eid="PRO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4" />तैखन तीं परमेशर ते मैन्हु दूईयां केरो अनुग्रह मैल्हेलो,</para>
  <para style="q" vid="PRO 3:4">तू बड़ो इज़्ज़तदार भोल्हो।<verse eid="PRO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5" />तू अपनि समझ़रो सहारो न नेइयां,</para>
  <para style="q" vid="PRO 3:5">बल्के पूरे मने सेइं यहोवा पुड़ भरोसो रेखां।<verse eid="PRO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6" />तैस्से याद केरतां सब कम्मां केरनां,</para>
  <para style="q" vid="PRO 3:6">तैखन तै तेरे लेई सिद्धी बत कढेलो।<verse eid="PRO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7" />अपने नज़री मां अक्लमन्द नईं बन्नू;</para>
  <para style="q" vid="PRO 3:7">यहोवारो डर मन्नो, ते बुरैई करां अलग रानू।<verse eid="PRO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8" />एरू केरने सेइं तेरी जान नीरोग,</para>
  <para style="q" vid="PRO 3:8">ते तेरी हेड्डी तंदरुस्त रहेली।<verse eid="PRO 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9" />अपने जाईदातरे ज़िरिये</para>
  <para style="q" vid="PRO 3:9">ते अपनि ज़मीनरी सारी पेइली फसल देइतां यहोवारी आदर केरनी;<verse eid="PRO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10" />एन्च़रां तेरे गुदाम पूरे भरोरे राले</para>
  <para style="q" vid="PRO 3:10">ते तेरे रस्सेरे कुण्डन मरां नंव्वो दाछ़रो रस भेरोइतां बेइरोवं निस्सेलो।<verse eid="PRO 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11" />हे मेरे मट्ठा, यहोवारी शिक्षा करां तुत्तर नईं फिरानू,</para>
  <para style="q" vid="PRO 3:11">ते ज़ैखन तै तीं झ़िड़के, तैखन तू बुरू न बुझ़ां,<verse eid="PRO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12" />ज़ेन्च़रे बाजी अपने ट्लारे मट्ठे डांटते,</para>
  <para style="q" vid="PRO 3:12">तेन्च़रे यहोवा ज़ैस सेइं प्यार केरते तैस डांटते।<verse eid="PRO 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13" />केत्रो धने तै मैन्हु ज़ैस अक्ल मैलतीए, ते तै मैन्हु ज़ै समझ़ हासिल केरे,<verse eid="PRO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14" />ज़ै फैइदो अक्ली सेइं हासिल भोते, तै चाँदी हासिल केरने करां जादे,</para>
  <para style="q" vid="PRO 3:14">ते तैसेरो फैइदो शुद्ध सोन्नेरे फैइदे करां भी बेद्धतां आहे।<verse eid="PRO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15" />तै बड़े कीमती गेहन्न करां जादे कीमतीए,</para>
  <para style="q" vid="PRO 3:15">ते ज़ेत्री चीज़ां केरि तू इच्छा केरतस, तैन मरां कोई भी तैसेरे बराबर न ठहरेली।<verse eid="PRO 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16" />तैसेरे देइने हथ्थे मां लम्मी उमरे,</para>
  <para style="q" vid="PRO 3:16">ते तैसेरे बांए हथ्थे मां दौलत ते आदर आहे।<verse eid="PRO 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17" />तैसेरी बत्तां आनन्देरी आन,</para>
  <para style="q" vid="PRO 3:17">ते तैसेरी सब बत्तां सुखे सेइं भेरतन।<verse eid="PRO 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18" />ज़ैना अक्ल कबूल केरतन,</para>
  <para style="q" vid="PRO 3:18">तैन केरे लेई तै ज़िन्दगरो बुट बनतीए; ते ज़ैना तैस ट्लेइतां रखतन, तैना धन आन।<verse eid="PRO 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />यहोवा ज़मीनरी बुनीयाद अक्ली सेइं रख्खी;</para>
  <para style="q" vid="PRO 3:19">ते सुर्ग समझ़रे ज़िरिये कायम कियूं।<verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />तैस्से ज्ञानेरे ज़िरिये डुग्घे समुन्दरेरे नाग निस्से,</para>
  <para style="q" vid="PRO 3:20">ते अम्बरे मरां ट्लेल पेतीए।<verse eid="PRO 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21" />हे मेरे मट्ठा, खरी अक्ल ते ज़मीरे एप्पु कां रख</para>
  <para style="q" vid="PRO 3:21">ते अपने नज़री करां दूर भोने न दे,<verse eid="PRO 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22" />तैखन इन सेइं तीं ज़िन्दगी मैल्हेली,</para>
  <para style="q" vid="PRO 3:22">ते इनां तेरे गलेरो हार बनेले।<verse eid="PRO 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23" />तैखन तू अपने बत्ती पुड़ निडर च़लेलो,</para>
  <para style="q" vid="PRO 3:23">ते तेरे पव्वन ठोकर न लग्गेली।<verse eid="PRO 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24" />ज़ैखन तू लेटेलो, तैखन डर न लग्गेलो,</para>
  <para style="q" vid="PRO 3:24">ज़ैखन तू झ़ुलेलो, तैखन आरामेरी निड्ल एज्जेली।<verse eid="PRO 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25" />अचानक एजने बाले डरे करां नईं डरनू,</para>
  <para style="q" vid="PRO 3:25">ते ज़ैखन दुष्टन पुड़ आफत एज्जे,</para>
  <para style="q" vid="PRO 3:25">तैखन घबरानू नईं;<verse eid="PRO 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26" />किजोकि यहोवा तीं सहारो देलो,</para>
  <para style="q" vid="PRO 3:26">ते तेरे पव्वन फंदे मां फसने न देलो।<verse eid="PRO 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27" />ज़ैना भलियाई केरनेरे काबलन तैन केरू भलू ज़रूर केरनू,</para>
  <para style="q" vid="PRO 3:27">अगर एरू केरनू तेरी शेक्ति मां आहे।<verse eid="PRO 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28" />अगर तीं कां देने जो किछ भोए,</para>
  <para style="q" vid="PRO 3:28">त अपने सैथी सेइं नईं ज़ोनू कि गा कालां फिरी एज्जां, अवं कालां तीं देइलो।<verse eid="PRO 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29" />ज़ैखन तेरो पड़ोसी तीं कां तेरे भरोसे रहते,</para>
  <para style="q" vid="PRO 3:29">तैखन तैसेरे खलाफ बुरी योजना न बनेइयां।<verse eid="PRO 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30" />ज़ैने मैन्हे तीं सेइं बुरो सलूख न कियोरो भोए,</para>
  <para style="q" vid="PRO 3:30">तैस सेइं बगैर वजां मुकदमो खड़ो नईं केरनो।<verse eid="PRO 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31" />फसाद केरनेबाले मड़देरे बारे मां जलन नईं केरनि,</para>
  <para style="q" vid="PRO 3:31">न तैसेरी ज़ेरि चाल च़लनी;<verse eid="PRO 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32" />किजोकि यहोवा बुरे मैन्हु सेइं नफरत केरते,</para>
  <para style="q" vid="PRO 3:32">पन तै अपनो भेद धर्मी लोकन पुड़ बांदो केरते।<verse eid="PRO 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33" />दुष्टेरे घरे पुड़ यहोवारी लानत एइतीए</para>
  <para style="q" vid="PRO 3:33">ते धर्मी लोकां केरि रानेरी ठारन पुड़ तैसेरी बरकत भोतीए।<verse eid="PRO 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34" />मज़ाक बनाने बालां केरो तै ज़रूर मज़ाक बनाते;</para>
  <para style="q" vid="PRO 3:34">पन हलीम लोकन पुड़ तै अनुग्रह केरते।<verse eid="PRO 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35" />अक्लमन्दन आदर मैल्हेली,</para>
  <para style="q" vid="PRO 3:35">पन बेवकूफां केरि तरक्‍की बेइज़्ज़तरी वजा भोल्ही।<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">अक्लरे फैइदे</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1" />हे मेरे मट्ठव, बाजी केरि शिक्षा शुना,</para>
  <para style="q" vid="PRO 4:1">ते समझ़ हासिल केरने मां मन लाथ।<verse eid="PRO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2" />किजोकि मीं तुसन रोड़ी शिक्षा दित्तोरीए;</para>
  <para style="q" vid="PRO 4:2">मेरी शिक्षा न शारा।<verse eid="PRO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3" />हेरा, अवं भी अपने बाजी केरू मट्ठू थियूं,</para>
  <para style="q" vid="PRO 4:3">ते अम्मरू अक्‍के लाडोलू थियूं,<verse eid="PRO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4" />ते मेरो बाजी मीं इन ज़ोइतां शिखालतो थियो,</para>
  <para style="q" vid="PRO 4:4">“तेरो मन मेरी गल्‍लन पुड़ लगोरो राए;</para>
  <para style="q" vid="PRO 4:4">तू मेरे हुक्मन मन्न, तैखन ज़ींतो रालो।<verse eid="PRO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5" />अक्ल हासिल केर, समझ़ भी हासिल केर;</para>
  <para style="q" vid="PRO 4:5">तैन बिसरां न, ते मेरी गल्‍लां न शैरां।<verse eid="PRO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6" />अक्ल न शार ते तै तेरी हिफाज़त केरेली;</para>
  <para style="q" vid="PRO 4:6">तैस सेइं प्यार रख ते तै तेरो पहरो देली।<verse eid="PRO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7" />अक्ल उच्‍चीए एल्हेरेलेइ तैस हासिल केरनेरे लेई कोशिश केर;</para>
  <para style="q" vid="PRO 4:7">अपनु सब किछ खर्च़ केर ताके ज़ैन किछ तीं मैल्हे तैस मां समझ़ हासिल केरि सकस।<verse eid="PRO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8" />तैसेरी बडीयाई केर, तै तीं बधाली;</para>
  <para style="q" vid="PRO 4:8">ज़ैखन तू तैस सेइं लिपटस, तैखन तै तेरी आदर केरेली।<verse eid="PRO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9" />तै तेरे दोग्गे पुड़ शोभारो साफो;</para>
  <para style="q" vid="PRO 4:9">ते तीं खूबसूरत ताज देली।”<verse eid="PRO 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10" />हे मेरे मट्ठा, मेरी गल्‍लां शुन्तां कबूल केर,</para>
  <para style="q" vid="PRO 4:10">तैखन तू बड़े सालन तगर ज़ींतो रालो।<verse eid="PRO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11" />मीं तीं अक्लरी बत ज़ोवरीए;</para>
  <para style="q" vid="PRO 4:11">ते सच़्च़ेरे बत्ती पुड़ च़लावरोस।<verse eid="PRO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12" />ज़ैस मां च़लने पुड़ तीं रोक टोक न भोल्ही,</para>
  <para style="q" vid="PRO 4:12">ते चाहे तू दौड़स, फिर भी ठोकर न खालो।<verse eid="PRO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13" />शिक्षाई ट्लेइतां रख, तैस न शार;</para>
  <para style="q" vid="PRO 4:13">तैसेरी हिफाज़त केर, किजोकि तैए तेरी ज़िन्दगीए।<verse eid="PRO 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14" />दुष्टां केरि बत्ती मां पव न रख,</para>
  <para style="q" vid="PRO 4:14">ते न बुरे लोकां केरे बत्ती पुड़ च़लनू।<verse eid="PRO 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15" />तैस शार, तैसेरे नेड़े भी न च़ल,</para>
  <para style="q" vid="PRO 4:15">तैसेरे नेड़ेरां मुड़तां अग्रोवं च़लो गा।<verse eid="PRO 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16" />किजोकि दुष्ट लोक अगर बुराई न केरन, त तैन्न निड्ल न एज्जे;</para>
  <para style="q" vid="PRO 4:16">ते ज़ांतगर तैना कोन्ची ठोकर न खुवान, तांतगर तैन्न निड्ल न एज्जे।<verse eid="PRO 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17" />किजोकि तैना दुष्टेरी रोट्टी खातन,</para>
  <para style="q" vid="PRO 4:17">ते फसादेरो दाछ़रो रस पीतन।<verse eid="PRO 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18" />पन धर्मी लोकां केरि चाल, झ़ेझ़ेरे लौअरी ज़ेरिए,</para>
  <para style="q" vid="PRO 4:18">ज़ेसेरी चमक दुपहरन तगर बद्धती गाचे।<verse eid="PRO 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19" />दुष्टां केरि बत गुप आंधरू भोते;</para>
  <para style="q" vid="PRO 4:19">तैना न ज़ानन कि तैना कोस सेइं ठोकर खातन।<verse eid="PRO 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20" />हे मेरे मट्ठा मेरे वचन ध्याने सेइं शुन,</para>
  <para style="q" vid="PRO 4:20">ते अपनो कन मेरी गल्‍लन पुड़ ला।<verse eid="PRO 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21" />इन्न एपनी एछ़्छ़न करां दूर न भोने दे;</para>
  <para style="q" vid="PRO 4:21">बल्के अपने मने मां बसा।<verse eid="PRO 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22" />किजोकि ज़ैन्न तैना हासिल भोतिन, तैना तैन केरे ज़ींते रानेरे,</para>
  <para style="q" vid="PRO 4:22">ते तैन केरे सैरी जानी सझ़र रानेरी वजा भोतिन।<verse eid="PRO 4:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23" />सेभना करां जादे अपने मनेरी हिफाज़त केर;</para>
  <para style="q" vid="PRO 4:23">किजोकि ज़िन्दगरो असली ज़िरियो तैए आहे।<verse eid="PRO 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24" />टारी गल अपने ऐशी सेइं न ज़ो,</para>
  <para style="q" vid="PRO 4:24">ते चालबाज़ी गल्‍लां ज़ोनी तीं करां दूर रान।<verse eid="PRO 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25" />तेरी एछ़्छ़ी सामनेरे पासे लगोरी रान,</para>
  <para style="q" vid="PRO 4:25">ते तेरां पुनठां अग्रोवं जो खुल्‍ला रान।<verse eid="PRO 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26" />अपने पव रखनेरे लेई बत सिद्धी केर,</para>
  <para style="q" vid="PRO 4:26">तैखन तेरी सब बत्तां ठीक रहेली।<verse eid="PRO 4:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27" />न त देइने पासे मुड़नू, ते न बांए पासे;</para>
  <para style="q" vid="PRO 4:27">अपने पव्वन बुरैइारे बत्ती पुड़ च़लने करां हटा।<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">व्यभिचार केरने करां दूर रानेरी सलाह</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1" />हे मेरे मट्ठा, मेरी अक्लरे गल्‍लन पुड़ ध्यान दे,</para>
  <para style="q" vid="PRO 5:1">मेरी समझ़रे पासे कन ला;<verse eid="PRO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2" />ताके तेरो ज़मीर सुरक्षित बनोरो राए,</para>
  <para style="q" vid="PRO 5:2">ते तू ज्ञानेरी हिफाज़त केरस।<verse eid="PRO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3" />किजोकि बेखली कौन्शरे ओठन सेइं माछ़ी ट्लिशड़ते,</para>
  <para style="q" vid="PRO 5:3">ते तैसारी गल्‍लां तेले करां भी जादे मुलायम भोतिन;<verse eid="PRO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4" />पन इन कम्मां केरो नितीजो नागदौनारो ज़ेरो ट्लिठो</para>
  <para style="q" vid="PRO 5:4">ते दूई धारण बाली तलवारारो ज़ेरो तिखो भोते।<verse eid="PRO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5" />तैसेरे पव मौतरे पासे उन्ढे गातन;</para>
  <para style="q" vid="PRO 5:5">ते तैसेरे कदम पाताले तगर पुज़तन।<verse eid="PRO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6" />तै ज़िन्दगरे बत्तरे बारे मां खियाल न केरे;</para>
  <para style="q" vid="PRO 5:6">तैसेरी बत्तां टैरी आन, पन तैन तै एप्पु न ज़ाने।<verse eid="PRO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7" />एल्हेरेलेइ हुनी हे मेरे मट्ठव, मेरी शुना,</para>
  <para style="q" vid="PRO 5:7">ते मेरी गल्‍लन करां तुत्तर न फेर।<verse eid="PRO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8" />एरी कौन्शी करां दूरे रा,</para>
  <para style="q" vid="PRO 5:8">ते तैसेरे घरेरे सामने भी नईं गानू;<verse eid="PRO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9" />कोन्च एरू न भोए कि तू ताकत</para>
  <para style="q" vid="PRO 5:9">होरि केरे हथ्थे, ते अपनि बाकी ज़िन्दगी बेरहमहेरे कैबू मां केरि देस;<verse eid="PRO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10" />या बखले तेरी कमाई सेइं अपनु पेट भरन,</para>
  <para style="q" vid="PRO 5:10">ते अनज़ान मैन्हु तेरे मेहनतरो फल अपने घरे मां रखन;<verse eid="PRO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11" />ते तू अपने आखरी वक्ते मां ज़ैखन तेरे जिसमेरी ताकत खतम भोइ गाए तैखन कर लास,<verse eid="PRO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12" />तू इन ज़ोलो, “मीं शिक्षा सेइं केरो बैर कियो,</para>
  <para style="q" vid="PRO 5:12">ते डांटने बाले घटिया समझ़े!<verse eid="PRO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13" />मीं अपने गुरू केरि गल्‍लां न मेन्नी</para>
  <para style="q" vid="PRO 5:13">ते अपने शिखालने बालां केरे पासे ध्यान नईं लेवरू।<verse eid="PRO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14" />अवं सभा ते मेण्डलरे मझ़ाटे मां</para>
  <para style="q" vid="PRO 5:14">हर बुरैई मां शामल राव।”<verse eid="PRO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15" />तू अपने कुण्डे मरां पानी,</para>
  <para style="q" vid="PRO 5:15">ते अपने खुहेरे नागे मरां पानी पी।<verse eid="PRO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16" />कुन तेरे नागां केरू पानी सड़की मां,</para>
  <para style="q" vid="PRO 5:16">ते तेरे पैनेरी धारां चौकन मां बगन?<verse eid="PRO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17" />इन सिर्फ तेरे लेई राए,</para>
  <para style="q" vid="PRO 5:17">ते तीं साथी बखलां केरे लेई न भोए।<verse eid="PRO 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18" />तेरो नाग धन राए; ते अपने कौन्शी सेइं साथी खुश रह ज़ैस सेइं तीं ड्लाह बनेवरो थियो ज़ैखन तू जुवान थियो,<verse eid="PRO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19" />तै तेरे लेई ट्लारी हिरनी या खूबसूरत सांभेरनरी ज़ेरि भोए,</para>
  <para style="q" vid="PRO 5:19">तैसारी छाती हमेशा तीं खुश रख्खे,</para>
  <para style="q" vid="PRO 5:19">ते तैसेरो प्यार हमेशा तीं फिदा केरतो राए।<verse eid="PRO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20" />हे मेरे मट्ठा, तू बदचलन कौन्शी पुड़ किजो फिदा भोस,</para>
  <para style="q" vid="PRO 5:20">ते बेखली कौन्शी किजो छैती सेइं लास?<verse eid="PRO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21" />किजोकि मैन्हेरी बत यहोवारी नज़री करां छ़पोरी नईं,</para>
  <para style="q" vid="PRO 5:21">ते तै तैसेरे सब बत्तन पुड़ ध्यान देते।<verse eid="PRO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22" />दुष्ट अपने अधर्मेरे कम्मन सेइं फसेलो,</para>
  <para style="q" vid="PRO 5:22">ते अपने पापेरे बन्धनन मां बन्धोरो रालो।<verse eid="PRO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23" />तै अनुशासन न मन्नेरे वजाई सेइं मेरि गालो,</para>
  <para style="q" vid="PRO 5:23">ते अपने बेवकूफेरे वजाई सेइं भटकतो रालो।<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">होरि हदायतां</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1" />हे मेरे मट्ठा, अगर तू अपने पड़ोसेरे ज़मानतरो ज़िमेवार भोवरो भोस,</para>
  <para style="q" vid="PRO 6:1">ते तैस बखलेरे लेई कसम खेइतां जुवाब दह भोवरो भोस,<verse eid="PRO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2" />त तू अपने कसमरे गल्‍लन मां फसेलो,</para>
  <para style="q" vid="PRO 6:2">ते अपने ज़बानेरे गल्‍लन सेइं ट्लाव गालो।<verse eid="PRO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3" />इस हाले मां, हे मेरे मट्ठा अक कम केर</para>
  <para style="q" vid="PRO 6:3">ते अपने आपे बच़ा, किजोकि तू अपने पड़ोसेरे हथ्थे मां पेवरोस हुनी गा,</para>
  <para style="q" vid="PRO 6:3">ते अपने आज़ाद भोनेरे लेई तैस कां झुकतां तैस कां बिनती केर।<verse eid="PRO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4" />तू न त एपनी एछ़्छ़न मां निड्ल,</para>
  <para style="q" vid="PRO 6:4">ते न अपने पुंठन पुड़ डिगरी एजने दे;<verse eid="PRO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5" />ते अपने आपे हिरनरे ज़ेरे शिकार केरनेबालेरे हथ्थे करां,</para>
  <para style="q" vid="PRO 6:5">ते च़ुड़ोली केरे ज़ेरे शिकार केरनेबालेरे हथ्थे मरां छुटा।<verse eid="PRO 6:5" /></para>
  <para style="s">आलसी मैन्हेरी बेवकूफी</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6" />हे आलसी, बिंदलन कां गा;</para>
  <para style="q" vid="PRO 6:6">तैन केरे कम्मे पुड़ ध्यान दे, ते अक्लमन्द भोइ गा।<verse eid="PRO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7" />ज़ैन केरे लेई न त कोई हाकिम भोए</para>
  <para style="q" vid="PRO 6:7">न प्रधान, ते न कोई हुकूमत केरनेबालो,<verse eid="PRO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8" />फिरी भी तैना अपने खाने जो धुप्परे दिहाड़न मां अकोट्ठू केरतिन,</para>
  <para style="q" vid="PRO 6:8">ते फसल कटनेरे वक्ते अपनि खानेरी चीज़ां अकोट्ठी केरतिन।<verse eid="PRO 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9" />हे आलसी, तू किताली तगर झ़ुलतो रालो?</para>
  <para style="q" vid="PRO 6:9">तेरी निड्ल कैखन खुलेली?<verse eid="PRO 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10" />थोड़ी ज़ेरि निड्ल, अक होरि डिगरी,</para>
  <para style="q" vid="PRO 6:10">थोड़ू होरू छैती पुड़ हथ रेखतां झ़ुलतां रानू<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="fq" closed="false">झ़ुलतां रानू </char><char style="ft" closed="false">इन आलसी मैन्हेरे नकामी हिराते</char></note>,<verse eid="PRO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11" />तैखन तेरी गरीबी बत्तरे लुटेरेरी ज़ेरि</para>
  <para style="q" vid="PRO 6:11">ते तेरी घटी हथियार-बन्देरी ज़ेरि एज्जेली।<verse eid="PRO 6:11" /></para>
  <para style="s">दुष्ट मैन्हु</para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12" />नीच़ ते अनर्थ केरनेबाले मैन्हु हेरा,</para>
  <para style="q" vid="PRO 6:12">तै टारी-टिन्ची गल्‍लां बकतो फिरते,<verse eid="PRO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13" />तै अपने एछ़्छ़न झपकाते ते पव्वे हिलाते,</para>
  <para style="q" vid="PRO 6:13">ते अपनि एंगलोयन सेइं इशारो केरते,<verse eid="PRO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14" />तैसेरे मने मां उलट-फेरेरी गल्‍लां रैतिन, तै लगातार बुराई बनातो रहते</para>
  <para style="q" vid="PRO 6:14">ते लड़ाई-झगड़ो पैदा केरते।<verse eid="PRO 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15" />इस वजाई सेइं तैस पुड़ अचानक मुसीबत एज्जेली,</para>
  <para style="q" vid="PRO 6:15">तै पल भरे मां एरहो नाश भोइ गालो, कि बच़नेरो कोई इंतज़ाम न रालो।<verse eid="PRO 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16" />शा गल्‍लन सेइं यहोवा बैर रखते,</para>
  <para style="q" vid="PRO 6:16">ते सत आन ज़ैन सेइं तैस नफरते:<verse eid="PRO 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17" />मतलब घमण्डे सेइं च़ड़ोरी एछ़्छ़ी, झूठ ज़ोनेबाली ज़िभ,</para>
  <para style="q" vid="PRO 6:17">ते बेकसूरेरे खून बगाने बाले हथ,<verse eid="PRO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18" />बेकार खियाल बनानेबालो मन,</para>
  <para style="q" vid="PRO 6:18">बुराई केरने जो तेज़ दौड़ने बाले पव,<verse eid="PRO 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19" />झूठ ज़ोने बालो गवाह</para>
  <para style="q" vid="PRO 6:19">ते ढ्लां केरे दरमियाने मां लड़ाई पैदा केरनेबालो मैन्हु।<verse eid="PRO 6:19" /></para>
  <para style="s">व्यभिचार केरने करां होशियार रानू</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20" />हे मेरे मट्ठा, अपने बाजी केरो हुक्म मन्न,</para>
  <para style="q" vid="PRO 6:20">ते अपनि अम्मरी शिक्षा न शार।<verse eid="PRO 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21" />तैन्न अपने दिले मां हमेशा ड्लन्ठ बेंद्धतां रख;</para>
  <para style="q" vid="PRO 6:21">ते अपने गलेरो हार बना।<verse eid="PRO 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22" />तै तेरे च़लते वक्ते तेरी अगवाई,</para>
  <para style="q" vid="PRO 6:22">ते झ़ुलते वक्त तेरी हिफाज़त,</para>
  <para style="q" vid="PRO 6:22">ते बींझ़ते वक्ते तीं शिक्षा देली।<verse eid="PRO 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23" />प्रभुएरो हुक्म त दीयोए ते शिक्षा लौ,</para>
  <para style="q" vid="PRO 6:23">ते अनुशासनेरे लेई दित्ती गानेबाली डांट ज़िन्दगरी बत्ते,<verse eid="PRO 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24" />तैना तीं बदचलन कौन्शी करां</para>
  <para style="q" vid="PRO 6:24">ते व्यभिचार केरनेबाली मिट्ठी-मिट्ठी गल्‍लन करां बच़ाली।<verse eid="PRO 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25" />तैसेरी खूबसूरती हेरतां अपने मने मां तैसेरी खुवैइश न केर;</para>
  <para style="q" vid="PRO 6:25">तै तीं अपने पुंठन सेइं न पसाए;<verse eid="PRO 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26" />किजोकि वेश्यागमनेरे वजाई सेइं मैन्हु रोट्टरे टुक्डां<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="fq" closed="false">रोट्टरे टुक्डां </char><char style="ft" closed="false">एक्‍की वेश्यारी लागत एक्‍की रोट्टरे कीमती ज़ेत्री भोतीए।</char></note> केरो भिखारी भोइ गाते,</para>
  <para style="q" vid="PRO 6:26">पन बदचलन कौन्श कीमती ज़िन्दगरो शिकार केरतीए।<verse eid="PRO 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />कुन भोइ सकते कि कोई अपने छैती पुड़ अग रख्खे;</para>
  <para style="q" vid="PRO 6:27">ते तैसेरे लिगड़ां न फुकोन?<verse eid="PRO 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28" />कुन भोइ सकते कि कोई मूरन पुड़ च़ले,</para>
  <para style="q" vid="PRO 6:28">ते तैसेरे पव न फुकोन?<verse eid="PRO 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29" />ज़ै बेखली कौन्शी कां गाते, तैसेरी हालत एरी आहे;</para>
  <para style="q" vid="PRO 6:29">बल्के ज़ै कोई तैस सेइं हुरेलो तै सज़ाही करां न बच़ेलो।<verse eid="PRO 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30" />ज़ै च़ोर ढ्लुखरे मारे अपनु पेट भरनेरे लेई च़ोरी केरे,</para>
  <para style="q" vid="PRO 6:30">तैस त लोक घटिया न ज़ानन;<verse eid="PRO 6:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31" />फिरी भी अगर तै ट्लाव गाए, त तैस सत गुणा भेरतां देनू पेलू;</para>
  <para style="q" vid="PRO 6:31">बल्के अपने घरेरी सारी दौलत देनी पेली।<verse eid="PRO 6:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32" />ज़ै मैन्हु व्यभिचार केरते तै बेअक्ले;</para>
  <para style="q" vid="PRO 6:32">ज़ै एरू केरते, तै अपने प्राणां केरो नाश केरते।<verse eid="PRO 6:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33" />तैस ज़खमी ते बेइज़्ज़त भोनू पेलू,</para>
  <para style="q" vid="PRO 6:33">ते तैसेरी बदनामी कधी न मिटेली।<verse eid="PRO 6:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34" />किजोकि जलनी सेइं मड़द बड़ो सेरकोते,</para>
  <para style="q" vid="PRO 6:34">ते ज़ैखन तै बदलो नेलो तैखन कोई दया न हिरालो।<verse eid="PRO 6:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35" />तै मुआवज़े मां किछ न नेलो,</para>
  <para style="q" vid="PRO 6:35">ते चाहे तू तैस बड़ू किछ देस, तांभी तै न मन्नेलो।<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1" />हे मेरे मट्ठा, मेरी गल्‍लन मन्न,</para>
  <para style="q" vid="PRO 7:1">ते मेरे हुक्मन अपने मने मां रेखी छ़ड।<verse eid="PRO 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2" />मेरे हुक्मन मन, इस सेइं तू ज़ींतो रालो,</para>
  <para style="q" vid="PRO 7:2">ते मेरी शिक्षा अपने एछ़्छ़री पुतली समझ़;<verse eid="PRO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3" />तैन्न अपने एंगलोयन मां बन्ध,</para>
  <para style="q" vid="PRO 7:3">ते अपने दिलेरी तेख्ती पुड़ लिखी छ़ड।<verse eid="PRO 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4" />अक्ली सेइं ज़ो कि, “तू मेरी बेइन आस,”</para>
  <para style="q" vid="PRO 7:4">ते समझ़ी अपनि रिश्तेदार बना;<verse eid="PRO 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5" />तैखन तू बेखली कौन्शी करां बच़ेलो,</para>
  <para style="q" vid="PRO 7:5">ज़ै मिट्ठी-मिट्ठी गल्‍लां ज़ोतीए।<verse eid="PRO 7:5" /></para>
  <para style="s">चालबाज़ वेश्या</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6" />मीं एक्सां अपने घरेरे दैरी मरां,</para>
  <para style="q" vid="PRO 7:6">मतलब अपने रोशनदाने मरां तक्‍कू,<verse eid="PRO 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7" />तैखन मीं सिद्धे-सादे लोकन मरां</para>
  <para style="q" vid="PRO 7:7">अक बेअक्ल जुवान लाव;<verse eid="PRO 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8" />तै तैस कौन्शरे घरेरे कूने कां सड़की मांमेइं च़लोरो थियो,</para>
  <para style="q" vid="PRO 7:8">ते तैने तैसारे घरेरी बत ट्लाई।<verse eid="PRO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9" />तैस वक्ते दिहाड़ी ढेली जेई, ते ड्लोझ़रो मौको एवरो थियो,</para>
  <para style="q" vid="PRO 7:9">बल्के रातरू बड़ू आंधरू भोवरू थियूं।<verse eid="PRO 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10" />ते तैस सेइं एक्‍की कौन्शरी मुलाकात भोइ,</para>
  <para style="q" vid="PRO 7:10">ज़ेसेरू लान वेश्यारू ज़ेरू थियूं, ते तै बड़ी च़लाक थी।<verse eid="PRO 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11" />तै बगैर शैन्तां ते बेशर्म थी,</para>
  <para style="q" vid="PRO 7:11">ते तैसारे पव घरे मां न थिये टिकते;<verse eid="PRO 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12" />कधी तै सड़की मां, कधी चौके मां मैलती थी,</para>
  <para style="q" vid="PRO 7:12">ते एक्‍की-एक्‍की कूने पुड़ तै बलगती थी।<verse eid="PRO 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13" />तैखन तैसां तै जुवान ट्लेइतां तैस फुम्मड़ी दित्ती,</para>
  <para style="q" vid="PRO 7:13">ते बे शरमरी कोशिश केरतां तैस सेइं ज़ोवं,<verse eid="PRO 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14" />“मीं अज़्ज़े मेलबलि च़ाढ़ी।</para>
  <para style="q" vid="PRO 7:14">ते एपनी मिन्नतां पूरी की;<verse eid="PRO 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15" />इस्से वजाई सेइं अवं तीं सेइं मुलाकात केरनेरे लेई निस्सी,</para>
  <para style="q" vid="PRO 7:15">अवं तेरे दर्शन केरनेरे तोपी मां थी, ते हुन्ना तू मैल्हो।<verse eid="PRO 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16" />मीं अपने खट्टरे बिछ़ाने पुड़</para>
  <para style="q" vid="PRO 7:16">मिस्रेरां कढ़ाई दार लिगड़ां बिछ़ावरन;<verse eid="PRO 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17" />मीं अपने बिछ़ाने पुड़ गन्धरस,</para>
  <para style="q" vid="PRO 7:17">अगर ते दालचीनी छ़िड़कोरीए।<verse eid="PRO 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18" />एल्हेरेलेइ हुनी च़ल अस प्यारे सेइं झ़ेझ़ां तगर दिल बहलाते रहम;</para>
  <para style="q" vid="PRO 7:18">अस एक्‍की होरी सेइं प्यार केरतां खुश रहम।<verse eid="PRO 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19" />किजोकि मेरो मुन्श घरे नईं;</para>
  <para style="q" vid="PRO 7:19">तै दूर मुल्खे जो च़लो जेवरोए;<verse eid="PRO 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20" />तै चैंदरी थेली घिन्तां जेवरोए;</para>
  <para style="q" vid="PRO 7:20">ते पुनयारे मौके वापस एज्जेलो।”<verse eid="PRO 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21" />एरी लालच़ाने बाली गल्‍लां ज़ोइ ज़ोइतां, तैसां तै फसव;</para>
  <para style="q" vid="PRO 7:21">ते अपनि मिट्ठी-मिट्ठी गल्‍लन सेइं तै अपने कैबू मां कियो।<verse eid="PRO 7:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22" />तै लूशी तैस पत्ती भोइ जेव,</para>
  <para style="q" vid="PRO 7:22">ज़ेन्च़रे दांत कसाई-खाने जो, या हिरन फंदे मां कदम रखते।<verse eid="PRO 7:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23" />आखरी मां तैस जुवानेरो कलैज़ो तीरे सेइं कोशेलो;<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="fq" closed="false">कलैज़ो तीरे सेइं कोशेलो </char><char style="ft" closed="false">मतलब तै अपनि ज़िन्दगी गुवालो।</char></note></para>
  <para style="q" vid="PRO 7:23">तै तैस च़ुड़ोलवेरो ज़ेरोए ज़ैन फंदेरे पासे जल्दी उडरते</para>
  <para style="q" vid="PRO 7:23">ते न ज़ाने कि तैस सेइं तैसेरे प्राण गाले।<verse eid="PRO 7:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24" />हुनी हे मेरे मट्ठव, मेरी शुना,</para>
  <para style="q" vid="PRO 7:24">ते मेरी गल्‍लन पुड़ मन लाथ।<verse eid="PRO 7:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25" />तेरो मन एरी कौन्शरे बत्तरे पासे न फिरे,</para>
  <para style="q" vid="PRO 7:25">ते तैसेरी बत्तन मां बिसरतां भी नईं गानू;<verse eid="PRO 7:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26" />किजोकि बड़े लोक तैसेरे ज़िरिये मारे जेवरेन;</para>
  <para style="q" vid="PRO 7:26">तैसारे मारोरां केरि बड़ी तैधात भोल्ही।<verse eid="PRO 7:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27" />तैसारू घर पातालेरी बत्ते,</para>
  <para style="q" vid="PRO 7:27">तै मौतरे दुनियाई मां पुज़ातीए।<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">ज्ञानेरी खूबी</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1" />कुन अक्ल हक न दे?</para>
  <para style="q" vid="PRO 8:1">कुन समझ़ उच्‍चे शब्दे सेइं न ज़ोए?<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />अक्ल त बत्तरे उच्‍ची ठारन पुड़े,</para>
  <para style="q" vid="PRO 8:2">ते च़ुबत्तन मां खड़ी भोतीए;<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />फाटकां केरे नगरां केरे दारे मां,</para>
  <para style="q" vid="PRO 8:3">ते दारन मां तै उच्‍ची आवाज़ी सेइं ज़ोतीए,<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />“हे लोकव, अवं तुसन जो हक देती,</para>
  <para style="q" vid="PRO 8:4">ते मेरी गल्‍लां सब मैन्हु केरे लेई आन।<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />हे सिद्धे-सादे लोकव च़लाकी शिखा;</para>
  <para style="q" vid="PRO 8:5">ते हे बेवकूफव, अपने मने मां समझ़ा<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />शुना, किजोकि अवं रोड़ी गल्‍लां ज़ोली,</para>
  <para style="q" vid="PRO 8:6">ते ज़ैखन अवं आशी खोल्‍लेली, तैखन तैस सेइं सिद्धी गल्‍लां निस्सेली;<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />किजोकि मीं करां सच़्च़ेरी गल्‍लां बियान भोल्ही;</para>
  <para style="q" vid="PRO 8:7">दुष्टेरी गल्‍लन सेइं मीं नफरत भोतीए।<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />मेरे ऐशेरी सब गल्‍लां धर्मेरी भोतिन,</para>
  <para style="q" vid="PRO 8:8">तैन मरां कोई टारी या उलट-फेरेरी गल्‍लां न निस्सन।<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />समझ़ी बालेरे लेई तैना सब आसान,</para>
  <para style="q" vid="PRO 8:9">ते ज्ञान हासिल केरनेबालां केरे लेई बेड़ि सिद्धी आन।<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />चाँदी नईं, मेरी शिक्षा च़ुना,</para>
  <para style="q" vid="PRO 8:10">ते रोड़े कुन्दने करां बेद्धतां ज्ञाने कबूल केरा।<verse eid="PRO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />किजोकि अक्ल, बड़े कीमती रत्नन करां भी रोड़ीए,</para>
  <para style="q" vid="PRO 8:11">ते सारी मन पसंद चीज़न मां कोई भी तैसेरे बराबर नईं।<verse eid="PRO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />अवं ज़ै अक्ल आईं, ते अवं होशियारी मां बास केरतीं,</para>
  <para style="q" vid="PRO 8:12">ते ज्ञान ते ज़मीरे हासिल केरतीं।<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />यहोवारो डर मन्नो बुरैई सेइं बैर रखनोए।</para>
  <para style="q" vid="PRO 8:13">घमण्ड ते अहंकार, बुरी चाली सेइं,</para>
  <para style="q" vid="PRO 8:13">ते उलट-फेरेरी गल्‍लन सेइं अवं बैर रखतीं।<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />रोड़ी योजना, ते खरी अक्ल मेरीए, मीं मां समझ़े,</para>
  <para style="q" vid="PRO 8:14">ते कुदरत भी मेरीए।<verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />मेरे ज़िरिये राज़े राज़ केरतन,</para>
  <para style="q" vid="PRO 8:15">ते अधिकारी धर्मे सेइं हुकूमत केरतन;<verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />मेरे ज़िरिये राज़ केरनेबाले,</para>
  <para style="q" vid="PRO 8:16">हाकिम ते धेरतरे सब न्याय केरनेबाले हुकूमत केरतन।<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />ज़ैना मीं सेइं प्यार रखतन, तैन सेइं अवं भी प्यार रखतीं,</para>
  <para style="q" vid="PRO 8:17">ते ज़ैना मीं झ़ेझ़ां उठतां तोपतन, तैन अवं मैलतीं।<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />दौलत ते आदर,</para>
  <para style="q" vid="PRO 8:18">हमेशारी रानेबाली दौलत ते धार्मिकता मीं कां आन।<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />मेरो फल शुद्ध सोन्ने करां,</para>
  <para style="q" vid="PRO 8:19">बल्के कुन्दने करां भी रोड़ोए,</para>
  <para style="q" vid="PRO 8:19">ते मेरी फसल रोड़े चैंदी करां रोड़ीए।<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />अवं धर्मेरे बत्ती मां,</para>
  <para style="q" vid="PRO 8:20">ते न्यायेरे बत्तां केरे दरमियाने मां च़लतीं,<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />ज़ैस करां अवं अपने ट्लारन धन-दौलतरो हिस्सेदार केरि,</para>
  <para style="q" vid="PRO 8:21">ते तैन केरे गुदामन भेरि देईं।<verse eid="PRO 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22" />यहोवा अवं कम केरनेरे शुरू मां,</para>
  <para style="q" vid="PRO 8:22">बल्के अपने पुराने ज़मानेरे कम्मन करां भी पेइले पैदा की।<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />अवं हमेशा करां बल्के शुरू करां धेरतरे सृष्टि करां पेइले ठहराई जेवरी आईं।<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />ज़ैखन न त डुग्घो समुन्दर थियो,</para>
  <para style="q" vid="PRO 8:24">ते न पैनेरे नाग थिये, तैखन करां अवं पैदा भोइ।<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />ज़ैखन पहाड़ ते पहैड़ी न थी कायम कियोरी,</para>
  <para style="q" vid="PRO 8:25">तैखने करां अवं पैदा भोइ।<verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />ज़ैखन यहोवा न त धरती</para>
  <para style="q" vid="PRO 8:26">ते न मैइदान, न दुनियारी धूड़ बनेवरे थी, इन करां पेइले अवं पैदा भोइ।<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />ज़ैखन तैने अम्बर कायम कियूं, तैखन अवं तैड़ी थी,</para>
  <para style="q" vid="PRO 8:27">ज़ैखन तैने डुग्घे समुन्दरे पुड़ अम्बर बनावं,<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />ज़ैखन तैने अम्बर बह कायम कियूं,</para>
  <para style="q" vid="PRO 8:28">ते डुग्घे समुन्दरेरे नाग निस्सने लगे,<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />ज़ैखन तैने समुन्दरेरी हद ठहराई,</para>
  <para style="q" vid="PRO 8:29">कि पानी तैसेरो हुक्म न ट्लोड़ी सके,</para>
  <para style="q" vid="PRO 8:29">ते ज़ैखन तै ज़मीनरी बुनियादरी डोरी लातो थियो,<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />तैखन अवं प्रधान कारिगेरेरी<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="fq" closed="false">प्रधान कारिगेरेरी </char><char style="ft" closed="false">निकड़ो बच्‍चो</char></note> ज़ेरि तैस कां थी;</para>
  <para style="q" vid="PRO 8:30">ते अवं रोज़ तैसेरी खुशी थी,</para>
  <para style="q" vid="PRO 8:30">ते हर वक्त तैसेरे सामने खुश रहतीए थी।<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />अवं तैसेरी बसावरी धेरती सेइं खुश थी</para>
  <para style="q" vid="PRO 8:31">ते मेरू सुख मैन्हु केरि सेंगती सेइं भोतू थियूं।<verse eid="PRO 8:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />एल्हेरेलेइ हुनी हे मेरे मट्ठव, मेरी शुना;</para>
  <para style="q" vid="PRO 8:32">कुन धन आन तैना ज़ैना मेरे बत्तन ट्लेइतां रहतन।<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />शिक्षा शुना, ते अक्लमन्द भोइ गाथ,</para>
  <para style="q" vid="PRO 8:33">तैस नज़रानदाज़ न केरा।<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />केत्रो धने तै मैन्हु ज़ै मेरी शुनते,</para>
  <para style="q" vid="PRO 8:34">बल्के मेरे दारे पुड़ रोज़ खड़ो रहते,</para>
  <para style="q" vid="PRO 8:34">ते मेरे दारां केरे खम्भन कां मीं बलगते।<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />किजोकि ज़ैस अवं मैलतीं, तै ज़िन्दगी हासिल केरते,</para>
  <para style="q" vid="PRO 8:35">ते यहोवा तैस सेइं खुश भोते।<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />पन ज़ै मीं तोप्पने मां बेफल भोते,</para>
  <para style="q" vid="PRO 8:36">तै एप्पु पुड़ ज़ुलम आनते;</para>
  <para style="q" vid="PRO 8:36">ज़ेत्रे मीं सेइं बैर रखतन, तैना मौती सेइं प्यार रखतन।”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">ज्ञानेरी बत</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1" />अक्लां सत्ते खम्भे बनेइतां</para>
  <para style="q" vid="PRO 9:1">अपनु घर बनेवरूए।<verse eid="PRO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2" />तैसां धांमरे लेई अपने जानबर केटतां, अपने दाछ़रे रस्से मां मसालो मिलेइतां</para>
  <para style="q" vid="PRO 9:2">ते अपनि धाम तियार कियोरीए।<verse eid="PRO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3" />तैसां अपनि सेवा केरनेबैली धाम ज़ोनेरे लेई भेज़ोरिन;</para>
  <para style="q" vid="PRO 9:3">ते तै नगरेरे सेब्भन करां उच्‍चे ठारन मरां हक देतीए,<verse eid="PRO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4" />“ज़ै कोई सादोए तै मुड़तां इड़ी एज्जे!”</para>
  <para style="q" vid="PRO 9:4">ते ज़ै बेअक्ले, तैस सेइं तै ज़ोतीए,<verse eid="PRO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5" />“एज्जा, मेरी रोट्टी खाथ,</para>
  <para style="q" vid="PRO 9:5">ते मसालो मिलावरे मेरे दाछ़रे रस्से पीया।<verse eid="PRO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6" />बेवकूफां केरू साथ शारा,</para>
  <para style="q" vid="PRO 9:6">ते ज़ींते राथ, समझ़री बत्ती मां सिद्धे च़ला।”<verse eid="PRO 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7" />ज़ै मज़ाक उड़ाने बाले शिक्षा देते, बेइज़्ज़त भोते,</para>
  <para style="q" vid="PRO 9:7">ते ज़ै दुष्ट मैन्हु डांटते तैस कलंक लगते।<verse eid="PRO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8" />मज़ाक उड़ाने बाले न डांट, एरू न भोए कि तै तीं सेइं बैर रख्खे,</para>
  <para style="q" vid="PRO 9:8">अक्लमन्दे डांट, तै त तीं सेइं प्यार रखेलो।<verse eid="PRO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9" />अक्लमन्दे शिक्षा दे, तै जादे अक्लमन्द भोल्हो;</para>
  <para style="q" vid="PRO 9:9">धेर्मी खबरदार केर, तै अपनु ज्ञान बधालो।<verse eid="PRO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10" />यहोवारो डर मन्नो अक्लरी शुरुआते,</para>
  <para style="q" vid="PRO 9:10">ते परमपवित्र परमेशर ज़ाननो ही समझ़े।<verse eid="PRO 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11" />मेरे ज़िरिये त तेरी उमर बधेली,</para>
  <para style="q" vid="PRO 9:11">ते तेरे ज़िन्दगरे साल जादे भोल्हे।<verse eid="PRO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12" />अगर तू अक्लमन्द आस, त अक्लरो फल तूए भोगेलो;</para>
  <para style="q" vid="PRO 9:12">ते अगर तू मज़ाक बनाने बालोस, त सज़ाह सिर्फ तूए भोगेलो।<verse eid="PRO 9:12" /></para>
  <para style="s">बेवकूफरी बत</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13" />बेवकूफी बक-बक केरनेबाली कौन्शरी ज़ेरिए; तै त बेअक्ले,</para>
  <para style="q" vid="PRO 9:13">ते किछ न ज़ाने।<verse eid="PRO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14" />तै अपने घरेरे दारे मां,</para>
  <para style="q" vid="PRO 9:14">ते नगरेरे उच्‍ची ठारन मां अपने तखते पुड़ बिशोरी,<verse eid="PRO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15" />तै तैन लोकन ज़ैना अपने बत्तन पुड़ सिद्धे-सिद्धे च़लतन इन ज़ोइतां हक देतीए,<verse eid="PRO 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16" />“ज़ै कोई सादोए, तै मुड़तां इड़ी एज्जे;”</para>
  <para style="q" vid="PRO 9:16">ज़ै बेअक्ले, तैस सेइं तै ज़ोतीए,<verse eid="PRO 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17" />“च़ोरी कियोरू पानी मिट्ठू भोते,</para>
  <para style="q" vid="PRO 9:17">ते छ़पोरी रोट्टी रोड़ी लगतीए।”<verse eid="PRO 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18" />ते तै न ज़ाने, कि तैड़ी मुवोरे पेवरेन,</para>
  <para style="q" vid="PRO 9:18">ते तैस कौन्शरे मेहमान पातालेरे बुनीयें ठारन मां पुज़तन।<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">सुलैमानेरे ज्ञानेरी गल्‍लां</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 10:1" />सुलैमानेरी कहावतां।</para>
  <para style="q" vid="PRO 10:1">अक्लमन्द औलादी सेइं बाजी खुश भोते,</para>
  <para style="q" vid="PRO 10:1">पन बेवकूफ औलादरे वजाई सेइं अम्मा दुखी भोतीए।<verse eid="PRO 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2" />दुष्ट केरतां धन हासिल केरने सेइं फैइदो न भोए,</para>
  <para style="q" vid="PRO 10:2">पन धार्मिकतारे वजाई सेइं मौती करां बच़ाव भोते।<verse eid="PRO 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3" />धर्मी मैन्हु यहोवा ढ्लुखोरो मरने न दे,</para>
  <para style="q" vid="PRO 10:3">पन दुष्टां केरि खुवैइश तै पूरी भोने न दे।<verse eid="PRO 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4" />ज़ै कम्मे मां ढिल्‍लार केरते, तै गरीब भोइ गाते,</para>
  <para style="q" vid="PRO 10:4">पन मेहनती लोक अपने हथ्थां केरे ज़िरिये अमीर भोतन।<verse eid="PRO 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5" />अक्लमन्द औलाद रीतरे दिहाड़न<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="fq" closed="false">रीतरे दिहाड़न </char><char style="ft" closed="false">फसल कटनेरे मौसम</char></note> मां फसल अकोट्ठी केरतीए,</para>
  <para style="q" vid="PRO 10:5">पन ज़ै औलाद कटनेरे वक्ते गिरकी निड्ली मां झ़ुलते,</para>
  <para style="q" vid="PRO 10:5">तै शरमरी वजाह भोते।<verse eid="PRO 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6" />धेर्मी पुड़ बड़े आशिर्वाद भोतन,</para>
  <para style="q" vid="PRO 10:6">पन दुष्टां केरे तुत्तरे पुड़ ज़ुलम छ़पोरो रहते।<verse eid="PRO 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7" />धेर्मी याद केरतां लोक आशिर्वाद देतन,</para>
  <para style="q" vid="PRO 10:7">पन दुष्टेरू नवं मिटी गाते।<verse eid="PRO 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8" />ज़ै अक्लमन्दे, तै हुक्मन कबूल केरते,</para>
  <para style="q" vid="PRO 10:8">पन ज़ै बकवासी बेवकूफे, तैसेरो नाश भोते।<verse eid="PRO 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9" />ज़ै ईमानदैरी सेइं च़लते तै निडर च़लते,</para>
  <para style="q" vid="PRO 10:9">पन ज़ै टारी चाल च़लते तैसेरी चाल बांदी भोइ गाचे।<verse eid="PRO 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10" />ज़ै एछ़्छ़न सेइं इशारो केरते तैस सेइं होरन दुख भोते,</para>
  <para style="q" vid="PRO 10:10">ते ज़ै बकवासी बेवकूफे,<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="fq" closed="false">ज़ै बकवासी बेवकूफे </char><char style="ft" closed="false">या ज़ै आमने सामने झ़िड़कते तै शान्ति आनते।</char></note> तैसेरो नाश भोल्हो।<verse eid="PRO 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11" />धेर्मेरू तुत्तर त ज़िन्दगरो नागे,</para>
  <para style="q" vid="PRO 10:11">पन दुष्टां केरे ऐशी मां ज़ुलम छ़पोरो रहते।<verse eid="PRO 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12" />बैरे सेइं त लड़ाई पैदा भोतीए,</para>
  <para style="q" vid="PRO 10:12">पन प्यारे सेइं सब पाप ढक्‍के गातन।<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="fq" closed="false">सब पाप ढक्‍के गातन </char><char style="ft" closed="false">सब पाप माफ़ किये गातन</char></note><verse eid="PRO 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13" />समझ़ी बालां केरे गल्‍लन मां अक्ल मैलतीए,</para>
  <para style="q" vid="PRO 10:13">पन बेअक्लेरी पिठरे लेई कोड़ो आहे।<verse eid="PRO 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14" />अक्लमन्द लोक ज्ञान अकोट्ठू केरतन,</para>
  <para style="q" vid="PRO 10:14">पन बेवकूफेरे ज़ोने सेइं नाश भोते।<verse eid="PRO 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15" />अमीरेरी दौलत तैसेरू मज़बूत नगरे,</para>
  <para style="q" vid="PRO 10:15">पन गरीब मैन्हेरी गरीबी तैसेरे नाशेरी वजा आहे।<verse eid="PRO 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16" />धर्मी मैन्हेरी मेहनत ज़िन्दगरे पासे नेतीए;</para>
  <para style="q" vid="PRO 10:16">पन दुष्टेरो फैइदो पापेरे पासे नेते।<verse eid="PRO 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17" />ज़ै शिक्षाई पुड़ च़लते तै ज़िन्दगरे बत्ती पुड़े,</para>
  <para style="q" vid="PRO 10:17">पन ज़ै डांटी करां तुत्तर फिराते, तै भटकते।<verse eid="PRO 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18" />ज़ै बैरे छ़ुपेइतां रखते, तै झूठ ज़ोते,</para>
  <para style="q" vid="PRO 10:18">ते ज़ै झूठी निन्दा फैलाते, तै बेवकूफे।<verse eid="PRO 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19" />ज़ैड़ी बेड़ि गल्‍लां भोतिन, तैड़ी पाप भी भोते,</para>
  <para style="q" vid="PRO 10:19">पन ज़ै अपनु आशी बन्द रखते तै अक्ली सेइं कम केरते।<verse eid="PRO 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20" />धेर्मी मैन्हेरे वचन त रोड़े चैंदरेन;</para>
  <para style="q" vid="PRO 10:20">पन दुष्टां केरो मन बड़ो पोल्‍लो भोते।<verse eid="PRO 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21" />धर्मी लोकां केरे वचन्न सेइं बड़ां केरि हेर-गेश भोतीए,</para>
  <para style="q" vid="PRO 10:21">पन बेवकूफ लोक अक्ल घट भोनेरे वजाई सेइं मेरि गातन।<verse eid="PRO 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22" />दौलत यहोवारे बरकती सेइं मैलतीए,</para>
  <para style="q" vid="PRO 10:22">ते तै तैस साथी दुख न मिलाए।<verse eid="PRO 10:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23" />बेवकूफे त महापाप केरनो मज़ाकेरी गल लगतीए,</para>
  <para style="q" vid="PRO 10:23">पन समझ़ी बाले मैन्हेरे लेई अक्ल खुशरे बारे मांए।<verse eid="PRO 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24" />दुष्ट मैन्हु ज़ैस मुसीबती करां डरते, तै तैस पुड़ एइतीए,</para>
  <para style="q" vid="PRO 10:24">पन धर्मी लोकां केरि खुवैइश पूरी भोतीए।<verse eid="PRO 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25" />दुष्ट मैन्हु तैस तूफानेरो ज़ेरोए,</para>
  <para style="q" vid="PRO 10:25">ज़ै गुज़रते गाईब भोइ गाते</para>
  <para style="q" vid="PRO 10:25">पन धर्मी हमेशा कायम रहते।<verse eid="PRO 10:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26" />ज़ेन्च़रे दंते सिरको, ते अछ़्छ़ी तू,</para>
  <para style="q" vid="PRO 10:26">तेरहे आलसी तैन्न लगते ज़ैना तैस कोन्ची भेज़ते।<verse eid="PRO 10:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27" />यहोवारो डर मन्ने सेइं उमर बद्धतीए,</para>
  <para style="q" vid="PRO 10:27">पन दुष्टां केरे ज़िन्दगरे दिहाड़े घटते गातन।<verse eid="PRO 10:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28" />धर्मी लोकन उमीद रखने मां आनन्द मैलते,</para>
  <para style="q" vid="PRO 10:28">पन दुष्टां केरि उमीद ट्लुटी गाचे।<verse eid="PRO 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29" />यहोवा रोड़े मैन्हेरो क़िलो ठहरते,</para>
  <para style="q" vid="PRO 10:29">पन अनर्थ कम केरनेबालां केरो नाश भोते।<verse eid="PRO 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30" />धर्मी हमेशा अटल रालो,</para>
  <para style="q" vid="PRO 10:30">पन दुष्ट धेरती पुड़ बेस्सी न सकेलो।<verse eid="PRO 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31" />धेर्मेरे ऐशी मरां अक्ल ट्लिशड़तीए,</para>
  <para style="q" vid="PRO 10:31">पन उलट-फेरेरी गल ज़ोने बालेरी ज़िभ कट्टी गाली।<verse eid="PRO 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32" />धर्मी कबूल केरने काबल गल सेमझ़तां ज़ोते,</para>
  <para style="q" vid="PRO 10:32">पन दुष्टां केरे ऐशेरां उलट-फेरेरी गल्‍लां निसतिन।<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1" />धोखेरी ट्लेकड़ी सेइं यहोवा नफरत केरते,</para>
  <para style="q" vid="PRO 11:1">पन तै सही नापी सेइं खुश भोते।<verse eid="PRO 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2" />ज़ैखन घमण्ड भोते, तैखन तुहीन भी भोतीए,</para>
  <para style="q" vid="PRO 11:2">पन हलीम लोकन मां अक्ल भोतीए।<verse eid="PRO 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3" />सिद्धे लोक अपने सच़्च़ाई सेइं अगवाई हासिल केरतन,</para>
  <para style="q" vid="PRO 11:3">पन धोखेबाज़ अपने कुरेबे सेइं नाश भोतन।<verse eid="PRO 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4" />परमेशरेरे सरकरे दिहाड़े दौलती सेइं त किछ फैइदो न भोए,</para>
  <para style="q" vid="PRO 11:4">पन धार्मिकता मौती करां भी बच़ातीए।<verse eid="PRO 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5" />रोड़े मैन्हेरी बत धार्मिकतारे वजाई सेइं सिद्धी भोतीए,</para>
  <para style="q" vid="PRO 11:5">पन दुष्ट अपनि दुष्टतारे वजाई सेइं बिछ़ड़ते।<verse eid="PRO 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6" />धर्मी लोकां केरो बच़ाव तैन केरे धार्मिकतारे वजाई सेइं भोते,</para>
  <para style="q" vid="PRO 11:6">पन धोखेबाज़ लोक अपने दुष्टे मां फसतन।<verse eid="PRO 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7" />ज़ैखन दुष्टी मैन्हु मरते, तैखन तैसेरी उमीद ट्लुटी गाचे,</para>
  <para style="q" vid="PRO 11:7">ते अधर्मी मैन्हेरी उमीद बेकार भोतीए।<verse eid="PRO 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8" />धर्मी मुसीबती करां छुटी गाते,</para>
  <para style="q" vid="PRO 11:8">पन दुष्ट तैस्से मुसीबती मां च़लतो गाते।<verse eid="PRO 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9" />भक्ति न केरनेबालो मैन्हु अपने पड़ोसी अपने ऐशेरे गल्‍ली सेइं बिगाड़ते,</para>
  <para style="q" vid="PRO 11:9">पन धर्मी लोक ज्ञानेरे ज़िरिये बच़तन।<verse eid="PRO 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10" />ज़ैखन धर्मी लोकां केरू भलू भोते, तैखन नगरेरे लोक खुश भोतन,</para>
  <para style="q" vid="PRO 11:10">पन ज़ैखन दुष्ट नाश भोते, तैखन जयजयकार भोते।<verse eid="PRO 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11" />सच़्च़े लोकां केरे आशिर्वादे सेइं नगरेरी तरक्‍की भोतीए,</para>
  <para style="q" vid="PRO 11:11">पन दुष्टां केरे ऐशेरी गल्‍लन सेइं तै बिछ़ोड़ो गाते।<verse eid="PRO 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12" />ज़ै अपने पड़ोसी घटिया समझ़ते, तै बेअक्ले,</para>
  <para style="q" vid="PRO 11:12">पन समझ़दार मड़द च़ुपच़ाप रहते।<verse eid="PRO 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13" />ज़ै चोगली केरतो फिरते तै भेद बांदो केरते,</para>
  <para style="q" vid="PRO 11:13">पन भरोसेरे काबल मैन्हु गल्‍ली छ़ुपेइतां रखते।<verse eid="PRO 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14" />ज़ैड़ी अक्लरी सलाह नईं, तैड़ी आवाम मुसीबती मां पेतीए;</para>
  <para style="q" vid="PRO 11:14">पन बड़े सलहकारां केरे वजाई सेइं बच़ाव<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="fq" closed="false">बच़ाव </char><char style="ft" closed="false">ज़ींत</char></note> भोते।<verse eid="PRO 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15" />ज़ै प्रदेशेरो ज़िमेवार भोते, तै बड़ो दुख झ़ैलते,</para>
  <para style="q" vid="PRO 11:15">पन ज़ै ज़मानत नेने सेइं नफरत केरते, तै निडर रहते।<verse eid="PRO 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16" />दया केरनेबाली कौन्श आदर न गुवाए,</para>
  <para style="q" vid="PRO 11:16">ते बेरहम लोक दौलती न गुवान।<verse eid="PRO 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17" />दया केरनेबालो मैन्हु अपनु भलू केरते, पन ज़ै सखते,</para>
  <para style="q" vid="PRO 11:17">तै अपने जिसमे दुख देते।<verse eid="PRO 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18" />दुष्ट मैन्हु कमाई कमाते,</para>
  <para style="q" vid="PRO 11:18">पन ज़ै धार्मिकतारू बीज़ बेते, तैस पक्‍को फल मैलते।<verse eid="PRO 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19" />ज़ै धार्मिकताई मां मज़बूत रहते, तै ज़िन्दगी हासिल केरते,</para>
  <para style="q" vid="PRO 11:19">पन ज़ै बुरैइयरो पीछो केरते, तै मेरि गालो।<verse eid="PRO 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20" />ज़ैना मनेरे च़लाकन, तैन सेइं यहोवा नफरत केरते,</para>
  <para style="q" vid="PRO 11:20">पन तै रोड़ी चाली बालन सेइं खुश रहते।<verse eid="PRO 11:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21" />इस मां कोई शक नईं, बुरो मैन्हु बेकसूर न ठहरेलो,</para>
  <para style="q" vid="PRO 11:21">पन धेर्मेरू खानदान बच़ाव गालू।<verse eid="PRO 11:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22" />ज़ै खूबसूरत कौन्श ज़मीर न रख्खे,</para>
  <para style="q" vid="PRO 11:22">तै नक्‍के मां सोन्नेरी नथ लेइतां सूरेरी ज़ेरिए।<verse eid="PRO 11:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23" />धर्मी लोकां केरि खुवैइश त सिर्फ भलियाई भोतीए;</para>
  <para style="q" vid="PRO 11:23">पन दुष्टां केरि उमीद परमेशरेरी सरके भोते।<verse eid="PRO 11:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24" />एरे आन, ज़ैना दिल खोलतां देतन, फिरी भी तैन केरि तरक्‍की भोतीए;</para>
  <para style="q" vid="PRO 11:24">ते एरे भी आन ज़ैना जाइज़े करां घट देतन, फिरी भी तैन घाटो भोते।<verse eid="PRO 11:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25" />खुल्‍ले दिले सेइं देनेबालो मैन्हु सहतमन्द भोइ गाते,</para>
  <para style="q" vid="PRO 11:25">ते ज़ै होरन पानी पियाते तैस भी पियावं गालू।<verse eid="PRO 11:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26" />ज़ै जादे कीमत मैल्हनेरे लेई अपनु अन जमा केरते, तैस लोक लानत देतन,</para>
  <para style="q" vid="PRO 11:26">पन ज़ै तैस बेच़ते, तैस आशिर्वाद दित्तो गाते।<verse eid="PRO 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27" />ज़ै कोशिश केरतां भलियाई केरते तै होरि केरि खुशी तोपते,</para>
  <para style="q" vid="PRO 11:27">पन ज़ै होरि केरि बुरैइारे तोपी मां भोते, तैस्से पुड़ बुराई एइतीए।<verse eid="PRO 11:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28" />ज़ै अपने दौलती पुड़ भरोसो रखते तै शुकोरे पट्लां केरो ज़ेरो झ़ड़ते,</para>
  <para style="q" vid="PRO 11:28">पन धर्मी लोक नव्वें पट्लां केरे ज़ेरे हिलतन।<verse eid="PRO 11:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29" />ज़ै अपने घराने दुख देते, तैसेरो हिस्सो हवाए भोल्हो,</para>
  <para style="q" vid="PRO 11:29">ते बेवकूफ अक्लमन्द मैन्हेरो दास भोइ गाते।<verse eid="PRO 11:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30" />धेर्मेरो फल ज़िन्दगरो बुट भोते,</para>
  <para style="q" vid="PRO 11:30">ते अक्लमन्द मैन्हु लोकां केरे मन ज़ींती छ़डते।<verse eid="PRO 11:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31" />हेर, धेर्मी मैन्हु धेरती पुड़ बरकत मैलतीए,</para>
  <para style="q" vid="PRO 11:31">ते इन भी पक्‍कू आहे कि दुष्ट ते पैपी बड़ी सज़ाह मैल्हेली।<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1" />ज़ै शिक्षा मैल्हने सेइं प्यार केरते तै ज्ञाने सेइं प्यार केरते,</para>
  <para style="q" vid="PRO 12:1">पन ज़ै डांटी सेइं बैर रखते, तै जानबरेरो ज़ेरोए बेवकूफे।<verse eid="PRO 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2" />भले मैन्हु सेइं त यहोवा खुश भोते,</para>
  <para style="q" vid="PRO 12:2">पन बुरी योजना केरनेबाले जो तै दोषी ठहराते।<verse eid="PRO 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3" />कोई मैन्हु दुष्टेरे वजाई सेइं टिकोरो न राए,</para>
  <para style="q" vid="PRO 12:3">पन धेर्मी केरू ज़ील ड्लुड़ोनेरू नईं।<verse eid="PRO 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4" />रोड़े सभावेरी कौन्श अपने मुन्शेरू ताजे,</para>
  <para style="q" vid="PRO 12:4">पन ज़ै शरमरां कम्मां केरती तै मन्ना तैसेरी हेड्डी केरि शड़नेरी वजा भोतीए।<verse eid="PRO 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5" />धर्मी लोकां केरे खियाल न्यायेरे भोतन,</para>
  <para style="q" vid="PRO 12:5">पन दुष्टां केरि सलाहां धोखेरी भोतिन।<verse eid="PRO 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6" />दुष्टां केरि गलबात मारनेरे लेई बिशनेरे बराबर भोतीए,</para>
  <para style="q" vid="PRO 12:6">पन सिद्धे लोक अपने ऐशेरी गल्‍लरे ज़िरिये छुटानेबाले भोतन।<verse eid="PRO 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7" />ज़ैखन दुष्ट लोकां केरो नाश भोते तैखन तैना न रान,</para>
  <para style="q" vid="PRO 12:7">पन धर्मी लोकां केरू घर कायम रहते।<verse eid="PRO 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8" />मैन्हेरे अक्लरे मुताबिक तैसेरी तारीफ़ भोतीए,</para>
  <para style="q" vid="PRO 12:8">पन बुरो घटिया समझ़ो गाते।<verse eid="PRO 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9" />ज़ैस कां खाने जो रोट्टी भी नईं,</para>
  <para style="q" vid="PRO 12:9">पन अपने बारे मां बड़कां मारते, तैस करां नौकर रखनेबालो आम मैन्हु रोड़ोए।<verse eid="PRO 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10" />धर्मी अपने जानबरेरे भी प्राणेरी खबर रखते,</para>
  <para style="q" vid="PRO 12:10">पन दुष्टां केरि दया भी बेरहमे।<verse eid="PRO 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11" />ज़ै अपना ऊडारां लाते, तै पेट भेरतां खाते,</para>
  <para style="q" vid="PRO 12:11">पन ज़ै निकम्मन सेइं साथ रखते, तै बेअक्ल ठहरते।<verse eid="PRO 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12" />दुष्ट मैन्हु बुरे लोकां केरे लूटरे मालेरी खुवैइश केरतन,</para>
  <para style="q" vid="PRO 12:12">पन धर्मी लोकां केरां ज़ीलां हरा भरां रहतन।<verse eid="PRO 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13" />बुरो मैन्हु अपने बुरी गल्‍लां केरे वजाई सेइं फंदे मां फसते,</para>
  <para style="q" vid="PRO 12:13">पन धर्मी मुसीबती मरां निस्सी गाते।<verse eid="PRO 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14" />रोड़ो मैन्हु अपने वचना केरे फलेरे ज़िरिये भलियाई सेइं रज़्ज़ते,</para>
  <para style="q" vid="PRO 12:14">ते ज़ेरि ज़ेसेरी करनी तेरही तैसेरी भरनी भोतीए।<verse eid="PRO 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15" />बेवकूफे अपनि चाल सही लगतीए,</para>
  <para style="q" vid="PRO 12:15">पन ज़ै होरि लोकां केरि सलाह मन्ते, तै अक्लमन्दे।<verse eid="PRO 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16" />बेवकूफेरी सरक लूशी बांदी भोइ गाचे,</para>
  <para style="q" vid="PRO 12:16">पन समझ़दार मैन्हु तुहीन नज़रानदाज़ केरते।<verse eid="PRO 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17" />ज़ै सच़ ज़ोने बालो सच़्च़ी गवाही देते,</para>
  <para style="q" vid="PRO 12:17">पन ज़ै झूठी गवाही देते, तै धोखो बांदो केरते।<verse eid="PRO 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18" />एरे लोक भी आन ज़ैन केरू बगैर सोचे सेमझ़तां ज़ोनू तलवारारू ज़ेरू चुभते,</para>
  <para style="q" vid="PRO 12:18">पन अक्लमन्देरे ज़ोने सेइं लोक बेझ़ोतन।<verse eid="PRO 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19" />ऐशी मरां निसोरी सच़्च़ाई हमेशा बनोरी राहेली,</para>
  <para style="q" vid="PRO 12:19">पन ऐशी मरां निस्सोरू झूठ एक्‍की पलेरू भोते।<verse eid="PRO 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20" />बुरी योजना केरनेबालां केरे मने मां धोखो रहते,</para>
  <para style="q" vid="PRO 12:20">पन मेलेरी योजना केरनेबालन आनन्द भोते।<verse eid="PRO 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21" />धेर्मी नुकसान न भोए,</para>
  <para style="q" vid="PRO 12:21">पन दुष्ट लोक सारे आफती मां डुबी गातन।<verse eid="PRO 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22" />झूठे लोकन सेइं यहोवा नफरत केरते</para>
  <para style="q" vid="PRO 12:22">पन ज़ैना ईमानदैरी सेइं कम केरतन, तैन सेइं तै खुश भोते।<verse eid="PRO 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23" />समझ़दार मैन्हु ज्ञान बांदू न केरे,</para>
  <para style="q" vid="PRO 12:23">पन बेवकूफ अपने मनेरी बेवकूफी उच्‍चे शब्दे सेइं बियान केरते।<verse eid="PRO 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24" />मेहनती लोक हुकूमत केरतन,</para>
  <para style="q" vid="PRO 12:24">पन आलसी मैन्हु गुलाम भोइ गालो।<verse eid="PRO 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25" />परेशान मन दब्बो गाते,</para>
  <para style="q" vid="PRO 12:25">पन रोड़ी गल्‍ली सेइं तै खुश भोते।<verse eid="PRO 12:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26" />धर्मी अपने पड़ोसेरी अगवाई केरते,</para>
  <para style="q" vid="PRO 12:26">पन दुष्ट लोक अपने चालरे वजाई सेइं भटकतन।<verse eid="PRO 12:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27" />आलसी मैन्हु शिकारेरो पीछो न केरे,</para>
  <para style="q" vid="PRO 12:27">पन मेहनती कीमती चीज़ मैलतीए।<verse eid="PRO 12:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28" />धार्मिकतारी बत्ती मां ज़िन्दगी मैलतीए,</para>
  <para style="q" vid="PRO 12:28">ते तैसेरे बत्ती मां मौतरो पतो भी नईं।<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1" />अक्लमन्द मट्ठू बाजी केरि शिक्षा शुनते,</para>
  <para style="q" vid="PRO 13:1">पन मज़ाक बनानेबालो झ़िड़क भी न शुने।<verse eid="PRO 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2" />भलो मैन्हु अपने गल्‍लां केरे वजाई सेइं रोड़ी चीज़ खालो,</para>
  <para style="q" vid="PRO 13:2">पन धोखेबाज़ लोकां केरू पेट ज़ुलमे सेइं भेरोते।<verse eid="PRO 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3" />ज़ै अपने ज़बानरी एतिहात केरते, तै अपने प्राणां केरि हिफाज़त केरते,</para>
  <para style="q" vid="PRO 13:3">पन ज़ै लापरवाह भोइतां गल्‍लां केरते तै अपने ज़िन्दगरो नाश केरते।<verse eid="PRO 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4" />आलसी मैन्हेरे प्राण खुवैइश त केरतन, पन तैस किछ न मैल्हे,</para>
  <para style="q" vid="PRO 13:4">पन मेहनती मैन्हेरी इच्छां पूरी भोइ गैतिन।<verse eid="PRO 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5" />धर्मी झूठी गल्‍लन सेइं बैर रखते,</para>
  <para style="q" vid="PRO 13:5">पन दुष्टेरू हर कम शरमरी वजा भोते ते बदनामी कराते।<verse eid="PRO 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6" />धार्मिकता रोड़ी चाल च़लने बालेरी हिफाज़त केरतीए,</para>
  <para style="q" vid="PRO 13:6">पन पापी अपनि दुष्टतारे वजाई सेइं बिछ़ड़ते।<verse eid="PRO 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7" />कोई त दौलत अकोट्ठी केरते, पन तैस कां किछ न राए,</para>
  <para style="q" vid="PRO 13:7">ते कोई दौलत उड़ाते, फिरी भी तैस कां बड़ी दौलत रहतीए।<verse eid="PRO 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8" />अमीर मैन्हेरे प्राणेरी छुड़ौती तैसेरे दौलती सेइं भोतीए,</para>
  <para style="q" vid="PRO 13:8">पन गरीब एरी झ़िड़क भी न शुने।<verse eid="PRO 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9" />धर्मी लोकां केरि लौ बलती राली,</para>
  <para style="q" vid="PRO 13:9">पन दुष्टां केरो दीयो हिश्शी गाते।<verse eid="PRO 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10" />घमण्डे सेइं सिर्फ लड़ैई भोतिन,</para>
  <para style="q" vid="PRO 13:10">पन ज़ैना लोक सलाह मनतन, तैन कां अक्ल रहतीए।<verse eid="PRO 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11" />धोखे सेइं अकोट्ठी दौलत लूशी घटतीए,</para>
  <para style="q" vid="PRO 13:11">पन ज़ै अपने मेहनती सेइं अकोट्ठू केरते, तैसेरी तरक्‍की भोतीए।<verse eid="PRO 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12" />ज़ैखन उमीद पूरी भोने मां च़िर भोते, त मन परेशान भोते,</para>
  <para style="q" vid="PRO 13:12">पन ज़ैखन इच्छा पूरी भोतीए, तैखन ज़िन्दगरो बुट लगते।<verse eid="PRO 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13" />ज़ै सही सलाही घटिया ज़ानते, तैसेरो नाश भोइ गाते,</para>
  <para style="q" vid="PRO 13:13">पन हुक्मेरी आदर केरनेबाले रोड़ो फल मैलते।<verse eid="PRO 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14" />अक्लमन्देरी शिक्षा ज़िन्दगरो नागे,</para>
  <para style="q" vid="PRO 13:14">ते तैसेरे ज़िरिये लोक मौतरे फंदन करां बेच़ी सकतन।<verse eid="PRO 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15" />अक्लरे ज़िरिये सेइं अनुग्रह भोते,</para>
  <para style="q" vid="PRO 13:15">पन धोखे बाज़ां केरि बत मुश्किल भोतीए।<verse eid="PRO 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16" />समझ़दार मैन्हु ज्ञाने सेइं सब कम केरते,</para>
  <para style="q" vid="PRO 13:16">पन बेवकूफ अपने बेवकूफी फैलाते।<verse eid="PRO 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17" />दुष्ट दूत बुरैई मां फसते,</para>
  <para style="q" vid="PRO 13:17">पन भरोसेरे काबल दूत मेल करावाते।<verse eid="PRO 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18" />ज़ै शिक्षारी अनशुनी केरते तै गरीब भोइ गाते ते तै बेइज़्ज़त भोते,</para>
  <para style="q" vid="PRO 13:18">पन ज़ै डांटी मन्ते, तैसेरी आदर भोतीए।<verse eid="PRO 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19" />खुवैइश पूरी भोनी त प्राणे मिट्ठी लगतीए,</para>
  <para style="q" vid="PRO 13:19">पन बुरैई करां हटनू, बेवकूफां केरे प्राणे बुरू लगते।<verse eid="PRO 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20" />अक्लमन्दन सेइं संगती केर, तैखन तू भी अक्लमन्द भोइ गालो,</para>
  <para style="q" vid="PRO 13:20">पन बेवकूफां केरो साथी नाश भोइ गालो।<verse eid="PRO 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21" />मुसीबत पापी लोकन पत्ती लगोरी रहतीए,</para>
  <para style="q" vid="PRO 13:21">पन धर्मी लोकन रोड़ो फल मैलते।<verse eid="PRO 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22" />भलो मैन्हु अपने धियोड़ां-पोट्लड़ां केरे लेई जाईदात छ़डते,</para>
  <para style="q" vid="PRO 13:22">पन पापी मैन्हेरी जाईदात धर्मी मैन्हेरे लेई रख्खी गाचे।<verse eid="PRO 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23" />गरीब लोकन ज़मीनदैरी मरां बेड़ि खानेरी चीज़ां मैल्हतिन,</para>
  <para style="q" vid="PRO 13:23">पन तैना ज़ैन किछ उपातन अन्याय केरनेबाले तैन हड़पतन।<verse eid="PRO 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24" />ज़ै मट्ठे सज़ाह देनेरे लेई लैट्ठी सेइं न बाए, तै तैसेरो बैरी आहे,</para>
  <para style="q" vid="PRO 13:24">पन ज़ै तैस सेइं प्यार रखते, तै कोशिश केरतां तैस शिक्षा देते।<verse eid="PRO 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25" />धर्मी पेट भेरतां खाते,</para>
  <para style="q" vid="PRO 13:25">पन दुष्ट नियन्ने रहतन।<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1" />अक्लमन्द कौन्श अपनु घर बनातीए,</para>
  <para style="q" vid="PRO 14:1">पन बेवकूफ कौन्श तैस अपने हथ्थन सेइं बिछ़ोड़तीए।<verse eid="PRO 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2" />ज़ै सच़्च़ाई सेइं च़लते तै यहोवारो डर मन्ने बालोए,</para>
  <para style="q" vid="PRO 14:2">पन ज़ै टारी चाल च़लते तै तैस घटिया ज़ान्ने बालो ठहराते।<verse eid="PRO 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3" />बेवकूफेरे ऐशी मां घमण्डेरो मुन्करोए,</para>
  <para style="q" vid="PRO 14:3">पन अक्लमन्द लोकन अपने गल्‍लां केरे ज़िरिये हिफाज़त मैलतीए।<verse eid="PRO 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4" />ज़ैड़ी जोट्लनेरे लेई दांत नईं, तैड़ी गेवड़ साफ त रहते,</para>
  <para style="q" vid="PRO 14:4">पन दांतेरे ताकती सेइं अन्न बद्धते।<verse eid="PRO 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5" />सच़्च़ो गवाह झूठ न ज़ोए,</para>
  <para style="q" vid="PRO 14:5">पन झूठो गवाह सिर्फ झूठ फैलाते।<verse eid="PRO 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6" />मज़ाक बनानेबालो अक्ल तोपते, पन तैस न मैल्हे,</para>
  <para style="q" vid="PRO 14:6">पन समझ़दारे ज्ञान आरामे सेइं मैलते।<verse eid="PRO 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7" />बेवकूफे करां अलग भोइ गा,</para>
  <para style="q" vid="PRO 14:7">किजोकि तू तैस करां ज्ञानेरी गल हासिल न केरेलो।<verse eid="PRO 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8" />समझ़दार मैन्हेरी अक्ल अपनि चाली समझ़ाते,</para>
  <para style="q" vid="PRO 14:8">पन बेवकूफां केरि बेवकूफी धोखो केरनोए।<verse eid="PRO 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9" />बेवकूफ लोक पाप मन्नो मज़ाक समझ़तन,</para>
  <para style="q" vid="PRO 14:9">पन सिद्धे लोकां केरे दरमियान अनुग्रह भोते।<verse eid="PRO 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10" />मन अपनो दुख ज़ानते,</para>
  <para style="q" vid="PRO 14:10">ते बखलो तैसेरे आनन्दे मां हथ न छ़ेडी सके।<verse eid="PRO 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11" />दुष्टां केरे घरेरो नाश भोइ गाते,</para>
  <para style="q" vid="PRO 14:11">पन सिद्धे लोकां केरे डेरे मां तरक्‍की भोतीए।<verse eid="PRO 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12" />एरी बत्ते, ज़ै मैन्हु ठीक लगतीए,</para>
  <para style="q" vid="PRO 14:12">पन तैसेरे आखरी मां मौते मैलतीए।<verse eid="PRO 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13" />हसनेरे वक्ते भी मन परेशान भोइ सकते,</para>
  <para style="q" vid="PRO 14:13">ते आनन्देरे आखरी मां मातम भोइ सकते।<verse eid="PRO 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14" />ज़ै बेइमान मैन्हुए तै अपने चाल च़लनेरो फल भोगते,</para>
  <para style="q" vid="PRO 14:14">पन भलो मैन्हु अपने आपे राज़ी भोते।<verse eid="PRO 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15" />सिद्धो मैन्हु त हर एक्‍की गल्‍ली सच़ मन्ते,</para>
  <para style="q" vid="PRO 14:15">पन ज़मीरे बालो मैन्हु सोची सेमझ़तां च़लते।<verse eid="PRO 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16" />अक्लमन्द डेरतां बुराई केरने करां दूर भोते,</para>
  <para style="q" vid="PRO 14:16">पन बेवकूफ ढीठ भोइतां खबरदैरारी उमीद केरते।<verse eid="PRO 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17" />ज़ै लूशी सेरकोते, तै बेवकूफी हिराते,</para>
  <para style="q" vid="PRO 14:17">ते ज़ै बुरी योजना बनाते, तैस सेइं लोक बैर रखतन।<verse eid="PRO 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18" />बेवकूफां केरो हिस्सो बेवकूफी भोतीए,</para>
  <para style="q" vid="PRO 14:18">पन ज़मीरे बाले मैन्हन ज्ञानेरे रूपेरू ताज बन्धू गाते।<verse eid="PRO 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19" />बुरे लोक भलां केरे सामने,</para>
  <para style="q" vid="PRO 14:19">ते दुष्ट लोक धर्मी लोकां केरे फाटके पुड़ झुकेले।<verse eid="PRO 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20" />गरीब मैन्हेरो पड़ोसी भी तैस सेइं नफरत केरते,</para>
  <para style="q" vid="PRO 14:20">पन अमीरेरे बड़े प्यार केरनेबाले भोतन।<verse eid="PRO 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21" />ज़ै अपने पड़ोसी घटिया समझ़ते, तै पाप केरते,</para>
  <para style="q" vid="PRO 14:21">पन ज़ै हलीम लोकन पुड़ दया केरते, तै धन भोते।<verse eid="PRO 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22" />ज़ैना बुरी योजना बनातन, कुन तैना गुमाने मां न पेन?</para>
  <para style="q" vid="PRO 14:22">पन रोड़ी योजना बनानेबालन सेइं दया ते सच़्च़ैइअरो सलूख कियो गाते।<verse eid="PRO 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23" />मेहनती सेइं हमेशा फैइदो भोते,</para>
  <para style="q" vid="PRO 14:23">पन बकवास केरने सेइं सिर्फ नुकसान भोते।<verse eid="PRO 14:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24" />अक्लमन्दा केरि दौलत तैन केरू ताज ठहरते,</para>
  <para style="q" vid="PRO 14:24">पन बेवकूफे सेइं सिर्फ बेवकूफी पैदा भोतीए।<verse eid="PRO 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25" />सच़्च़ो गवाह बड़ां केरे प्राण बच़ाते,</para>
  <para style="q" vid="PRO 14:25">पन ज़ै झूठी गल्‍लां फैलाते तैस सेइं धोखो भोते।<verse eid="PRO 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26" />यहोवारे डरे मां मज़बूत भरोसोए,</para>
  <para style="q" vid="PRO 14:26">ते ई तैसेरे बच्‍चां केरे लेई छ़पनेरी ठार भोल्ही।<verse eid="PRO 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27" />यहोवारो डर मन्नो, ज़िन्दगरो नागे,</para>
  <para style="q" vid="PRO 14:27">ते तैसेरे ज़िरिये लोक मौतरे फंदन करां बच़ाए गातन।<verse eid="PRO 14:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28" />राज़ेरी महिमा आवामरे जादे भोने सेइं भोतीए,</para>
  <para style="q" vid="PRO 14:28">पन ज़ैड़ी आवाम नईं, तैड़ी हाकिम तबाह भोइ गाते।<verse eid="PRO 14:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29" />ज़ै च़िरे सेइं क्रोध केरनेबालोए तै बड़ो समझ़दार भोते,</para>
  <para style="q" vid="PRO 14:29">पन ज़ै जलदबाज़ भोते, तै बेवकूफी बद्धाते।<verse eid="PRO 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30" />शान्त मन, जानरी ज़िन्दगीए,</para>
  <para style="q" vid="PRO 14:30">पन जलनी सेइं हेड्डी भी गेली गैतिन।<verse eid="PRO 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31" />ज़ै कंगाले पुड़ अंधेर केरते तै तैसेरे बनानेबाले परमेशरेरी निन्दा केरते,</para>
  <para style="q" vid="PRO 14:31">पन ज़ै गरीबे पुड़ दया केरते, तै परमेशरेरी महिमा केरते।<verse eid="PRO 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32" />दुष्ट मैन्हु बुराई केरतो नाश भोइ गाते,</para>
  <para style="q" vid="PRO 14:32">पन धर्मी मैन्हु मौतरे वक्ते भी छ़पनेरी ठार मैलतीए।<verse eid="PRO 14:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33" />समझ़ी बालेरे मने मां अक्ल बास केरतीए,</para>
  <para style="q" vid="PRO 14:33">पन बेवकूफ मैन्हु अक्लरे बारे मां किछ भी न ज़ाने।<verse eid="PRO 14:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34" />कौमरी तरक्‍की धार्मिकताई सेइं भोतीए,</para>
  <para style="q" vid="PRO 14:34">पन पापे सेइं मुल्खेरे लोकां केरि बेइज़्ज़ती भोतीए।<verse eid="PRO 14:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35" />ज़ै कम केरनेबालो अक्ली सेइं कम केरते तैस पुड़ राज़ो खुश भोते,</para>
  <para style="q" vid="PRO 14:35">पन ज़ै शरमरां कम्मां केरते, तैस पुड़ तै सेरकोते।<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1" />नर्म जुवाब शुन्ने सेइं सरक ठंडी भोतीए,</para>
  <para style="q" vid="PRO 15:1">पन सकत गल्‍लन सेइं सरक भड़कतीए।<verse eid="PRO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2" />अक्लमन्द ज्ञानेरू ठीक बियान केरतन,</para>
  <para style="q" vid="PRO 15:2">पन बेवकूफां केरे ऐशेरां बेवकूफी निसतीए।<verse eid="PRO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3" />यहोवारी एछ़्छ़ी सेभी ठारन मां लगोरी रैतिन,</para>
  <para style="q" vid="PRO 15:3">तै रोड़े बुरे दूईयने तकतो रहतीए।<verse eid="PRO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4" />शान्ति देनेबाली गल ज़िन्दगरो बुट्टे,</para>
  <para style="q" vid="PRO 15:4">पन उलट-फेरेरी गल्‍ली सेइं आत्मा दुखी भोतीए।<verse eid="PRO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5" />बेवकूफ अपने बाजी केरि शिक्षारो इन्कार केरते,</para>
  <para style="q" vid="PRO 15:5">पन ज़ै डांटी मन्ते, तै समझ़दार भोइ गाते।<verse eid="PRO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6" />धर्मी मैन्हेरे घरे मां बड़ी दौलत रहतीए,</para>
  <para style="q" vid="PRO 15:6">पन दुष्टां केरि कमैई मां दुख रहते।<verse eid="PRO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7" />अक्लमन्द लोक गल्‍लां केरने सेइं ज्ञान फैलातन,</para>
  <para style="q" vid="PRO 15:7">पन बेवकूफां केरो मन ठीक न राए।<verse eid="PRO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8" />दुष्ट लोकां केरे बलिदाने सेइं यहोवा नफरत केरते,</para>
  <para style="q" vid="PRO 15:8">पन तै सिद्धे लोकां केरि प्राथनाई सेइं खुश भोते।<verse eid="PRO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9" />दुष्टेरे चाल च़लने सेइं यहोवा नफरत केरते,</para>
  <para style="q" vid="PRO 15:9">पन ज़ै धार्मिकतारो पीछो केरते तैस सेइं तै प्यार केरते।<verse eid="PRO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10" />ज़ै सही बत्ती शारते, तैस बड़ी झ़िड़क मैलतीए,</para>
  <para style="q" vid="PRO 15:10">ते ज़ै डांटी सेइं बैर रखते, तै ज़रूर मेरि गाते।<verse eid="PRO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11" />ज़ैखन पाताल ते विनाश लोक यहोवारे सामने खुल्‍ले रहतन,</para>
  <para style="q" vid="PRO 15:11">त पक्‍के मैन्हु केरे मन भी।<verse eid="PRO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12" />मज़ाक बनानेबालो डांटने सेइं खुश न भोए,</para>
  <para style="q" vid="PRO 15:12">ते न तै अक्लमन्दन कां गाए।<verse eid="PRO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13" />मन खुश भोने सेइं तुत्तरे पुड़ भी खुशी लेइहोतीए,</para>
  <para style="q" vid="PRO 15:13">पन मनेरे दुखे सेइं आत्मा परेशान भोतीए।<verse eid="PRO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14" />समझ़ी बालेरो मन ज्ञानेरी तोपी मां रहते,</para>
  <para style="q" vid="PRO 15:14">पन बेवकूफ लोक बेवकूफी सेइं पेट भरतन।<verse eid="PRO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15" />दुखेरे सब दिहाड़े दुखे सेइं भरोरे रहतन,</para>
  <para style="q" vid="PRO 15:15">पन ज़ेसेरो मन खुश रहते, तै एरो भोते ज़ेन्च़रे रोज़ धामी मां गाते।<verse eid="PRO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16" />घबराहटी सेइं बड़े रखोरे धने करां,</para>
  <para style="q" vid="PRO 15:16">यहोवारे डरे साथी थोड़ी दौलत रोड़ीए,<verse eid="PRO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17" />प्यारे बाले घरे मां शागे सेइं रोट्टी,</para>
  <para style="q" vid="PRO 15:17">बैरे बाले घरे मां सुवादे बालू मास खाने करां रोड़ूए।<verse eid="PRO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18" />क्रोध केरनेबालो मड़द लड़ाई मच़ाते,</para>
  <para style="q" vid="PRO 15:18">पन ज़ै च़िरे सेइं क्रोध केरनेबालोए, तै मुकदमन दबाते।<verse eid="PRO 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19" />आलसी मैन्हेरी बत कंटन सेइं भेरतां आहे,</para>
  <para style="q" vid="PRO 15:19">पन सिद्धे लोकां केरि बत खुल्‍ली सड़क ठहरतीए।<verse eid="PRO 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20" />अक्लमन्द मट्ठे सेइं बाजी खुश भोते,</para>
  <para style="q" vid="PRO 15:20">पन बेवकूफ मैन्हु अपने अम्मा घटिया समझ़ते।<verse eid="PRO 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21" />बेअक्ले बेवकूफी सेइं आनन्द भोते,</para>
  <para style="q" vid="PRO 15:21">पन समझ़ी बालो मैन्हु सिद्धी चाल च़लते।<verse eid="PRO 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22" />बगैर सलाह नेने सेइं योजना बेफल भोतिन,</para>
  <para style="q" vid="PRO 15:22">पन बड़े सलहकारां केरि सलाही सेइं कामयाबी मैलतीए।<verse eid="PRO 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23" />भलो मैन्हु जुवाब देने सेइं खुश भोते,</para>
  <para style="q" vid="PRO 15:23">ते मौके पुड़ ज़ोवरी गल केत्री रोड़ी भोतीए!<verse eid="PRO 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24" />समझ़दार मैन्हेरे लेई ज़िन्दगरी बत बेइयें पासे जो गातीए,</para>
  <para style="q" vid="PRO 15:24">एन्च़रे सेइं तै पाताले मां गाने करां बच़ते।<verse eid="PRO 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25" />यहोवा अहंकार केरनेबालां केरू घर डोलते,</para>
  <para style="q" vid="PRO 15:25">पन विधवारे हद्दन अटल रखते।<verse eid="PRO 15:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26" />बुरे खियाल यहोवाए भिट्टे लगतन,</para>
  <para style="q" vid="PRO 15:26">पन शुद्ध मैन्हेरी गल्‍लां मन पसंद आन।<verse eid="PRO 15:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27" />लालच़ी अपने घराने दुख देते,</para>
  <para style="q" vid="PRO 15:27">पन रिश्पती सेइं नफरत केरनेबालो ज़ींतो रहते।<verse eid="PRO 15:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28" />धर्मी मने मां सोचते कि कुन जुवाब देईं,</para>
  <para style="q" vid="PRO 15:28">पन दुष्टां केरे ऐशी मरां बुरी गल्‍लां निसतिन।<verse eid="PRO 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29" />यहोवा दुष्टन करां दूर रहते,</para>
  <para style="q" vid="PRO 15:29">पन धेर्मी केरि प्राथना शुनते।<verse eid="PRO 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30" />एछ़्छ़ी केरि चमकी सेइं मने आनन्द भोते,</para>
  <para style="q" vid="PRO 15:30">ते रोड़ी खबरी सेइं हेड्डी मज़बूत भोतिन।<verse eid="PRO 15:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31" />ज़ै ज़िन्दगी देनेबाली डांट कन लेइतां शुनते,</para>
  <para style="q" vid="PRO 15:31">तै अक्लमन्दन सेइं साथी ठिकानो हासिल केरते।<verse eid="PRO 15:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32" />ज़ै शिक्षा अनशुनी केरते, तै अपने प्राणन घटिया समझ़ते,</para>
  <para style="q" vid="PRO 15:32">पन ज़ै डांटी शुनते, तै अक्ल हासिल केरते।<verse eid="PRO 15:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33" />यहोवारो डर मन्ने सेइं अक्लरी शिक्षा हासिल भोतीए,</para>
  <para style="q" vid="PRO 15:33">ते इज़्ज़ती करां पेइले नम्रता एइतीए।<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1" />मनेरी योजना मैन्हेरे कैबू मां रहतीए,</para>
  <para style="q" vid="PRO 16:1">पन आखरी मां जुवाब यहोवारे तरफां भोते।<verse eid="PRO 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2" />मैन्हेरो सारो चाल च़लन एपनी नज़री मां पवित्र ठहरते,</para>
  <para style="q" vid="PRO 16:2">पन यहोवा मैन्हेरी आत्मा परखते।<note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="fq" closed="false">आत्मा परखते </char><char style="ft" closed="false">योजनां केरो न्याय केरते</char></note><verse eid="PRO 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3" />अपने कम्मन यहोवा पुड़ छ़ड,</para>
  <para style="q" vid="PRO 16:3">इस सेइं तेरे खियाल सिद्ध भोल्हे।<verse eid="PRO 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4" />यहोवा सब चीज़ां खास मकसदेरे लेई बनेवरिन,</para>
  <para style="q" vid="PRO 16:4">बल्के दुष्ट भी मुसीबत भोगनेरे लेई बनेवरोए।<verse eid="PRO 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5" />सब मनेरे घमण्डी लोकन सेइं यहोवा नफरत केरते;</para>
  <para style="q" vid="PRO 16:5">अवं मज़बूती सेइं ज़ोताईं, एरे लोक बेकसूर न ठहरेले।<verse eid="PRO 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6" />यहोवारे लेई सच़्च़े प्यार ते वफादैरारे ज़िरिये सेइं,</para>
  <para style="q" vid="PRO 16:6">तैने इश्शे पाप माफ़ कियोरेन।<verse eid="PRO 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7" />ज़ैखन केन्चेरो चाल च़लन यहोवा पसंद एइते,</para>
  <para style="q" vid="PRO 16:7">तैखन तै तैसेरे दुशमनां केरो भी तैस सेइं मेल कराते।<verse eid="PRO 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8" />अन्यायेरे बड़े फैइदे सेइं,</para>
  <para style="q" vid="PRO 16:8">न्याय सेइं थोड़ू हासिल केरनू रोड़ूए।<verse eid="PRO 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9" />मैन्हु मने मां अपने बत्ती पुड़ खियाल केरते,</para>
  <para style="q" vid="PRO 16:9">पन यहोवा तैसेरे पव्वन कायम रखते।<verse eid="PRO 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10" />राज़ेरे ऐशी मरां परमेशरेरी अक्ल निसतीए,</para>
  <para style="q" vid="PRO 16:10">न्याय केरने मां तैस करां गलती न भोए।<verse eid="PRO 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11" />सच़्च़ी ट्लकड़ी ते पलड़े यहोवारे तरफां भोतन,</para>
  <para style="q" vid="PRO 16:11">थेली मां ज़ेत्रे तोल भोतन, सब तैसेरे बनेवरेन।<verse eid="PRO 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12" />बुरू केरनू राज़ां केरे लेई भिट्टू कम्मे,</para>
  <para style="q" vid="PRO 16:12">किजोकि तैन केरो तखत धार्मिकताई सेइं टिकोरो रहते।<verse eid="PRO 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13" />धर्मेरी गल ज़ोनेबालन सेइं राज़ो खुश भोते,</para>
  <para style="q" vid="PRO 16:13">ते ज़ै सिद्धी गल्‍लां ज़ोते, तैस सेइं तै प्यार रखते।<verse eid="PRO 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14" />राज़ेरी सरक मौतरे दूतेरी ज़ेरिए,</para>
  <para style="q" vid="PRO 16:14">पन अक्लमन्द मैन्हु तैस ठंडी केरते।<verse eid="PRO 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15" />राज़ेरे तुत्तरेरी चमकी मां ज़िन्दगी रहतीए,</para>
  <para style="q" vid="PRO 16:15">ते तैसेरी खुशी बरसांतरे आखरी बिदलारारी ज़ेरि भोतीए।<verse eid="PRO 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16" />अक्ल हासिल केरनी शुद्ध सोन्ने करां बड़ी रोड़ीए!</para>
  <para style="q" vid="PRO 16:16">ते समझ़ हासिल केरनी चैंदी करां बेद्धतां काबले।<verse eid="PRO 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17" />बुरैई करां दूर भोनू धर्मी लोकां केरे लेई रोड़ी बत्ते,</para>
  <para style="q" vid="PRO 16:17">ज़ै अपने चाल च़लनेरी एतिहात केरते, तै अपने प्राणेरी भी हिफाज़त केरते।<verse eid="PRO 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18" />नाशे करां पेइले अहंकार,</para>
  <para style="q" vid="PRO 16:18">ते ठोकर खाने करां पेइलू घमण्ड एइते।<verse eid="PRO 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19" />घमण्डी लोकन सेइं साथी लूट बन्टने करां,</para>
  <para style="q" vid="PRO 16:19">हलीम लोकन सेइं साथी नम्र भावे सेइं रानू ठीके।<verse eid="PRO 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20" />ज़ै वचने पुड़ मन लाते, तै ज़िन्दगी मां तरक्‍की हासिल केरते,</para>
  <para style="q" vid="PRO 16:20">ते ज़ै यहोवा पुड़ भरोसो रखते, तै धन भोते।<verse eid="PRO 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21" />ज़ेसेरे दिले मां अक्ले, तैस जो समझ़ी बालो ज़ोवं गाते,</para>
  <para style="q" vid="PRO 16:21">ते रोड़ी गल्‍लां केरे ज़िरिये ज्ञान बद्धते।<verse eid="PRO 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22" />ज़ैस मां अक्ले, तैसेरेलेइ तै ज़िन्दगरे पैनेरो नागे,</para>
  <para style="q" vid="PRO 16:22">पन बेवकूफेरी सज़ाह एप्पु तैसेरी बेवकूफी आहे।<verse eid="PRO 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23" />अक्लमन्द मैन्हेरो मन तैसेरे तुत्तरे पुड़ भी अक्लमन्दी बांदी केरते,</para>
  <para style="q" vid="PRO 16:23">ते तैसेरे वचने मां विद्या रहतीए।<verse eid="PRO 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24" />मन पसंद वचन मैछ़ी सेइं भेरतां कशेरे ज़ेरे प्राणन मिट्ठे लगतन,</para>
  <para style="q" vid="PRO 16:24">ते हेड्डन हेरी-भेरि केरतन।<verse eid="PRO 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25" />एरी भी बत्ते, ज़ै मैन्हु सिद्धी लगतीए,</para>
  <para style="q" vid="PRO 16:25">पन तैसेरे आखरी मां मौते मैलतीए।<verse eid="PRO 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26" />मेहनती मैन्हेरी खुवैइश तैसेरेलेइ मेहनत केरतीए,</para>
  <para style="q" vid="PRO 16:26">तैसेरी ढ्लुख त तैस उकसाती रहतीए।<verse eid="PRO 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27" />बुरो मैन्हु बुरी योजना कढते,</para>
  <para style="q" vid="PRO 16:27">ते तैसेरे गल्‍लन सेइं अग लेग्गी गाचे।<verse eid="PRO 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28" />बुरो मैन्हु बेड़ि लड़ैई बनाते,</para>
  <para style="q" vid="PRO 16:28">ते चोगली केरनेबालो पक्‍के दोस्तन मां भी फूट छ़डते।<verse eid="PRO 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29" />ज़ुलमी मैन्हु अपने पड़ोसी टपलेइतां बुरी बत्ती पुड़ च़लते।<verse eid="PRO 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30" />अछ़ मारनेबालो धोखेरे खियाल केरते,</para>
  <para style="q" vid="PRO 16:30">ते ओठ दबाने बालो बुराई केरते।<verse eid="PRO 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31" />सुफेद बाल शोभारू ताज ठहरतन;</para>
  <para style="q" vid="PRO 16:31">तैना धार्मिकतारे बत्ती पुड़ च़लने सेइं हासिल भोतन।<verse eid="PRO 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32" />च़िरे सेइं क्रोध केरनो बहदरी,</para>
  <para style="q" vid="PRO 16:32">ते अपनो मन कैबू मां रखनो, नगर ज़ींतने करां रोड़ूए।<verse eid="PRO 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33" />चिट्ठी छ़डी गाती त आहे,</para>
  <para style="q" vid="PRO 16:33">पन तैसेरू कढनू यहोवारे तरफां भोते।<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1" />सुखे सेइं साथी शुकोरो टुक्ड़ो, तैस घरेरे बदले रोड़ू आहे,</para>
  <para style="q" vid="PRO 17:1">ज़ैन मेलबलि जानबरन सेइं भरोरू भोए, पन तैस मां लड़ाई-झगड़ो भोते।<verse eid="PRO 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2" />अक्ली सेइं च़लनेबालो नौकर अपने मालिकेरे तैस मट्ठे पुड़ ज़ै शरमरी वजा भोते अधिकार केरेलो,</para>
  <para style="q" vid="PRO 17:2">ते तैस मट्ठेरे ढ्लां केरे दरमियान जेईदातरो हिस्सेदार भोल्हो।<verse eid="PRO 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3" />ज़ेन्च़रे चैंदरे लेई कुठाली, ते सोन्नेरे लेई भट्ठी भोतीए,</para>
  <para style="q" vid="PRO 17:3">तेन्च़रे यहोवा मना केरो परखने बालोए।<verse eid="PRO 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4" />कुकर्मी बुरी गल्‍लां ध्यान देइतां शुनते,</para>
  <para style="q" vid="PRO 17:4">ते झूठो मैन्हु दुष्टेरी गल्‍लां केरे पासे कन लाते।<verse eid="PRO 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5" />ज़ै गरीबेरो मज़ाक उड़ाते, तै तैसेरे बनानेबाले परमेशरेरी निन्दा केरते;</para>
  <para style="q" vid="PRO 17:5">ते ज़ै कोन्चेरी मुसीबती पुड़ हसते, तै बेकसूर न ठहरेलो।<verse eid="PRO 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6" />बुढां केरि शोभा तैन केरे दिहोड़ां पोट्लड़न;</para>
  <para style="q" vid="PRO 17:6">ते बाल-बच्‍चां केरि शोभा तैन केरे अम्मा-बाजीन।<verse eid="PRO 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7" />बेवकूफेरे ज़बानरां रोड़ी गल न शोभे,</para>
  <para style="q" vid="PRO 17:7">ते इस करां जादे प्रधानेरे ज़बानरां झूठी गल न शोभे।<verse eid="PRO 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8" />रिश्पत देनेबालो मैन्हु रिश्पत मोह नेने बाली मणि समझ़ते;</para>
  <para style="q" vid="PRO 17:8">एरहो मड़द ज़ेरहां फिरते, तेरहां तैसेरू कम कामयाब भोते।<verse eid="PRO 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9" />ज़ै होरि केरे पापन ढकते, तै प्यारेरो तोपनेबालो ठहरते,</para>
  <para style="q" vid="PRO 17:9">पन ज़ै गल्‍लरी गलबात बार-बार केरते, तै पक्‍के दोस्तन मां भी फूट छ़डते।<verse eid="PRO 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10" />अक झ़िड़क समझ़ाने बालेरे मने मां ज़ेत्री लेग्गी गाचे,</para>
  <para style="q" vid="PRO 17:10">एत्रू 100 बार मार खानू बेवकूफेरे मने मां न पे।<verse eid="PRO 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11" />बुरो मैन्हु दंगेरी कोशिश केरते,</para>
  <para style="q" vid="PRO 17:11">एल्हेरेलेइ तैस कां सखत दूत भेज़ो गालो।<verse eid="PRO 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12" />ज़ैस इछ़नरे बच्‍चे थुसोड़ोरे भोन तैस सेइं मिलनू,</para>
  <para style="q" vid="PRO 17:12">बेवकूफी मां डुब्बोरे बेवकूफे सेइं मिलने करां बड़ू रोड़ूए।<verse eid="PRO 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13" />ज़ै कोई भलियाई केरनेरे बदले मां बुराई केरे,</para>
  <para style="q" vid="PRO 17:13">तैसेरे घरे मरां बुराई दूर न भोल्ही।<verse eid="PRO 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14" />लड़ैइअरी शुरुआत तालाबेरे सुराखेरी ज़ेरिए,</para>
  <para style="q" vid="PRO 17:14">लड़ाई बधने करां पेइले तै शारनी ठीके।<verse eid="PRO 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15" />ज़ै दोषी बेकसूर, ते ज़ै बेकसूरे दोषी ठहराते,</para>
  <para style="q" vid="PRO 17:15">तैन दूईयने सेइं यहोवा नफरत केरते।<verse eid="PRO 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16" />अक्ल घिन्नेरे लेई बेवकूफ अपने हथ्थे मां कीमत घिन्तां किजो आहे?</para>
  <para style="q" vid="PRO 17:16">तै तैस शिखनू भी न चाए।<verse eid="PRO 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17" />दोस्त हर वक्त प्यार रखते,</para>
  <para style="q" vid="PRO 17:17">ते आफतरे दिहाड़े ढ्ला ढ्लाएरे कम्मे एइते।<verse eid="PRO 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18" />बेअक्ल मैन्हु वाधे केरतां रुकावट पैदा केरते,</para>
  <para style="q" vid="PRO 17:18">ते अपने पड़ोसेरे करज़ेरो ज़िमेवार भोते।<verse eid="PRO 17:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19" />ज़ै लड़ाई-झगड़ो केरने सेइं प्यार केरते, तै पाप केरने सेइं भी प्यार केरते,</para>
  <para style="q" vid="PRO 17:19">ते ज़ै अपने फाटके बड्डो केरते तै अपने नाशेरी कोशिश केरते।<verse eid="PRO 17:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20" />ज़ै मनेरो टारोए, तैसेरू भलू न भोए,</para>
  <para style="q" vid="PRO 17:20">ते उलट-फेरेरी गल्‍लां केरनेबालो मुसीबती मां पेते।<verse eid="PRO 17:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21" />ज़ै बेवकूफे ज़र्म देते तै तैस सेइं दुखे हासिल केरते;</para>
  <para style="q" vid="PRO 17:21">ते बेवकूफेरे बाजी आनन्द न भोए।<verse eid="PRO 17:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22" />मनेरो आनन्द रोड़ी दूवाई आहे,</para>
  <para style="q" vid="PRO 17:22">पन मनेरे ट्लुटने सेइं हेड्डी शुक्‍की गैतिन।<verse eid="PRO 17:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23" />दुष्ट मैन्हु न्याय बिगाड़नेरे लेई,</para>
  <para style="q" vid="PRO 17:23">अपने खीसे मरां रिश्पत कढते।<verse eid="PRO 17:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24" />अक्ल समझ़ाने बालेरे सामने रहतीए,</para>
  <para style="q" vid="PRO 17:24">पन बेवकूफेरी एछ़्छ़ी धेरतरे दूर-दूर मुल्खन मां लगोरी रैतिन।<verse eid="PRO 17:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25" />बेवकूफ मट्ठे सेइं बाजी परेशान भोते,</para>
  <para style="q" vid="PRO 17:25">ते तैसेरी अम्मा मातम भोते।<verse eid="PRO 17:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26" />धर्मी मैन्हु पुड़ जुरमानो लानो,</para>
  <para style="q" vid="PRO 17:26">ते प्रधान्न भलियाई केरनेरे वजाई सेइं मडने, दूईये कम्मां रोड़ां नईं।<verse eid="PRO 17:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27" />ज़ै सुमैलतां ज़ोते, तै ज्ञानी ठहरते;</para>
  <para style="q" vid="PRO 17:27">ते ज़ेसेरी आत्मा च़ुप रहतीए, तैए समझ़ी बालो मड़द ठहरते।<verse eid="PRO 17:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28" />बेवकूफ भी ज़ैखन च़ुप रहते, तैखन अक्लमन्द गनो गाते;</para>
  <para style="q" vid="PRO 17:28">ते ज़ै अपनु आशी बन्द रखते तै समझ़ी बालो गनो गाते।<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1" />ज़ै होरन करां अलग भोइ गाते, तै अपनि इच्छा पूरी केरनेरे लेई एरू केरते,</para>
  <para style="q" vid="PRO 18:1">ते हर किसमेरे रोड़ी अक्ली सेइं बैर केरते।<verse eid="PRO 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2" />बेवकूफेरो मन समझ़रे गल्‍लन मां न लग्गे,</para>
  <para style="q" vid="PRO 18:2">तै सिर्फ अपने मनेरी गल बांदी केरनी चाते।<verse eid="PRO 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3" />ज़ैड़ी बुराई एइतीए, तैड़ी बेइज़्ज़ती भी एइती;</para>
  <para style="q" vid="PRO 18:3">ते बेइज़्ज़ती सेइं साथी निन्दा एइतीए।<verse eid="PRO 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4" />मैन्हेरे ज़बानरां निस्सने बैली गल्‍लां डुग्घे पैनेरी ज़ेरि भोतिन;</para>
  <para style="q" vid="PRO 18:4">अक्लरो नाग बगते गड्डरो ज़ेरो भोते।<verse eid="PRO 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5" />दुष्टेरे पासे भोनू,</para>
  <para style="q" vid="PRO 18:5">ते धेर्मेरू हक़ मारनू, रोड़ू नईं।<verse eid="PRO 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6" />गल बधाने सेइं बेवकूफ मुकदमो खड़ो केरते,</para>
  <para style="q" vid="PRO 18:6">ते अपने आपे मार खानेरे काबल हिराते।<verse eid="PRO 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7" />बेवकूफेरो नाश तैसेरी गल्‍लन सेइं भोते,</para>
  <para style="q" vid="PRO 18:7">ते तैसेरी गल्‍लां तैसेरे प्राणेरे लेई फंदे भोतिन।<verse eid="PRO 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8" />चोगली केरनेबालेरी गल्‍लां सुवैदली रोट्टरी ज़ेरि लेगतिन;</para>
  <para style="q" vid="PRO 18:8">तैना पेटे मां पेच़ी गैतिन।<verse eid="PRO 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9" />ज़ै कम्मे मां आलस केरते,</para>
  <para style="q" vid="PRO 18:9">तै बिगाड़ने बालेरो ढ्ला ठहरते।<verse eid="PRO 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10" />यहोवारू नवं मज़बूत क़िलोए;</para>
  <para style="q" vid="PRO 18:10">धर्मी तैस मां नेशतां सब हादसन करां बच़ते।<verse eid="PRO 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11" />अमीरेरी दौलत तैसेरी नज़री मां शेक्ति बालू नगरे,</para>
  <para style="q" vid="PRO 18:11">ते तैसेरे खियाल उच्‍ची शहरपनाहरे ज़ेरे आन।<verse eid="PRO 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12" />नाश भोने करां पेइलू मैन्हेरे मने मां घमण्ड,</para>
  <para style="q" vid="PRO 18:12">ते आदर मैल्हने करां पेइले नम्रता भोतीए।<verse eid="PRO 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13" />ज़ै गल शुन्ने बगैर जुवाब देते, तै बेवकूफ ठहरते,</para>
  <para style="q" vid="PRO 18:13">ते तै बेइज़्ज़त भोते।<verse eid="PRO 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14" />रोगे मां मैन्हु अपनि आत्माई सेइं सम्भलते;</para>
  <para style="q" vid="PRO 18:14">पन ज़ैखन आत्मा हारतीए तैखन इस कौन झ़ेल्‍ली सकते?<verse eid="PRO 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15" />समझ़ी बालो मन ज्ञान हासिल केरते;</para>
  <para style="q" vid="PRO 18:15">ते अक्लमन्द ज्ञानेरी गल्‍लरे तोपी मां रहतन।<verse eid="PRO 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16" />भेंट मैन्हेरे लेई बत खोलतीए,</para>
  <para style="q" vid="PRO 18:16">ते तैस मैन्हु महान लोकां केरे सामने पुज़ातीए।<verse eid="PRO 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17" />मुकदमे मां ज़ै पेइलो ज़ोते, तैए सच़्च़ो लगते,</para>
  <para style="q" vid="PRO 18:17">पन बादे मां होरि पासे बालो<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="fq" closed="false">होरि पासे बालो </char><char style="ft" closed="false">तैस पुड़ दोष लानेबालो </char></note> एइतां तैस परखते।<verse eid="PRO 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18" />चिट्ठी छ़डने सेइं लड़ैई बन्द भोतिन,</para>
  <para style="q" vid="PRO 18:18">ते ताकतबरां केरे लड़ैई केरो अन्त भोते।<verse eid="PRO 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19" />नराज़ भोवरो ढ्ला मनानो मज़बूत नगरेरे नेने करां मुश्किल भोते,</para>
  <para style="q" vid="PRO 18:19">ते लड़ाई राज़ भवनेरे बेंडां केरि ज़ेरिए।<verse eid="PRO 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20" />मैन्हेरू पेट ज़बानेरे फले सेइं भेरोते;</para>
  <para style="q" vid="PRO 18:20">ते ज़ोने सेइं ज़ैन किछ हासिल भोते तैस सेइं तै रज़्ज़ोरो भोते।<verse eid="PRO 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21" />ज़िभरे कैबू मां मौत ते ज़िन्दगी दूईये भोतिन,</para>
  <para style="q" vid="PRO 18:21">ते ज़ै तैसेरो इस्तेमाल केरनो ज़ानते तै तैसेरो फल भोगेलो।<verse eid="PRO 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22" />ज़ैनी कौन्श ड्लाई, तैस रोड़ी चीज़ मैल्ही,</para>
  <para style="q" vid="PRO 18:22">ते यहोवारो अनुग्रह तैस पुड़ भोवरोए।<verse eid="PRO 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23" />गरीब मद्दतरे लेई छंदे केरतां ज़ोते,</para>
  <para style="q" vid="PRO 18:23">पन अमीर सखत जुवाब देते।<verse eid="PRO 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24" />दोस्त बधाने सेइं त नाश भोते,</para>
  <para style="q" vid="PRO 18:24">पन एरहो दोस्ते, ज़ै ढ्लाए करां भी जादे मिलोरो रहते।<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1" />ज़ै गरीब ईमानदैरी सेइं च़लते,</para>
  <para style="q" vid="PRO 19:1">तै तैस बेवकूफे करां रोड़ोए ज़ै टैरी गल्‍लां ज़ोते।<verse eid="PRO 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2" />मैन्हेरू बगैर ज्ञाने इच्छा केरनि रोड़ू नईं,</para>
  <para style="q" vid="PRO 19:2">ते ज़ै जल्दी दौड़ते तै टेपलोइ गाते।<verse eid="PRO 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3" />बेवकूफरे वजाई सेइं मैन्हेरी बत टारी भोतीए,</para>
  <para style="q" vid="PRO 19:3">ते तै मने-मने मां यहोवा सेइं नफरत केरने लगते।<verse eid="PRO 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4" />अमीरेरे त बड़े दोस्त भोतन,</para>
  <para style="q" vid="PRO 19:4">पन गरीबेरे दोस्त तैस करां अलग भोइ गातन।<verse eid="PRO 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5" />झूठो गवाह बेकसूर न ठहरे,</para>
  <para style="q" vid="PRO 19:5">ते ज़ै झूठ ज़ोते, तै न बच़ेलो।<verse eid="PRO 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6" />खुल्‍ले दिले सेइं देनेबाले मैन्हु बड़े लोक मनातन,</para>
  <para style="q" vid="PRO 19:6">ते दान देनेबाले मड़देरो दोस्त हर कोई बनते।<verse eid="PRO 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7" />ज़ैखन गरीबेरे सब ढ्ला तैस सेइं बैर रखतन,</para>
  <para style="q" vid="PRO 19:7">त पक्‍कू आहे कि तैसेरे दोस्त तैस करां दूर भोइ गान।</para>
  <para style="q" vid="PRO 19:7">तै गल्‍लां केरतां तैन केरो पीछो केरते, पन तैन्न न मैल्हे।<verse eid="PRO 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8" />ज़ै अक्ल हासिल केरते, तै अपने प्राणे प्यार केरनेबालो ठहराते;</para>
  <para style="q" vid="PRO 19:8">ते ज़ै समझ़ रखते तैसेरू भलू भोते।<verse eid="PRO 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9" />झूठो गवाह बेकसूर न ठहरे,</para>
  <para style="q" vid="PRO 19:9">ते ज़ै झूठ ज़ोते, तै नाश भोते।<verse eid="PRO 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10" />ज़ैखन आरामे मां रानू बेवकूफे शोभे न,</para>
  <para style="q" vid="PRO 19:10">त हाकिमन पुड़ गुलामेरू राज़ केरनू केन्च़रे शोभे!<verse eid="PRO 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11" />ज़ै मैन्हु अक्ली सेइं च़लते तै च़िरे सेइं क्रोध केरते,</para>
  <para style="q" vid="PRO 19:11">ते पाप बिसरनो तैस शोभते।<verse eid="PRO 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12" />राज़ेरी सरक शेरेरे गरज़नेरी ज़ेरिए,</para>
  <para style="q" vid="PRO 19:12">पन तैसेरी खुशी घासे पुड़ ओशरी ज़ेरि भोतीए।<verse eid="PRO 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13" />बेवकूफ मट्ठू बाजी केरे लेई मुसीबते,</para>
  <para style="q" vid="PRO 19:13">ते लड़ाई केरनेबाली कौन्श हमेशा ट्लिशड़ने बाले पैनेरी ज़ेरिए।<verse eid="PRO 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14" />घर ते दौलत दादे पड़दादां केरे हिस्से सेइं,</para>
  <para style="q" vid="PRO 19:14">पन अक्लमन्द कौन्श यहोवारे तरफां मैलतीए।<verse eid="PRO 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15" />आलसे सेइं गिरकी निड्ल एइतीए,</para>
  <para style="q" vid="PRO 19:15">ते ज़ै मैन्हु आलसे सेइं कम केरते, तै नियन्नो रहते।<verse eid="PRO 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16" />ज़ै परमेशरेरे हुक्मे मन्ते, तै अपने प्राणां केरि हिफाज़त केरते,</para>
  <para style="q" vid="PRO 19:16">पन ज़ै परमेशरेरे बत्तां केरे बारे मां बे फिक्र रहते, तै मेरि गाते।<verse eid="PRO 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17" />ज़ै गरीबे पुड़ अनुग्रह केरते, तै यहोवा ओधार देते,</para>
  <para style="q" vid="PRO 19:17">ते तैस अपने इस कम्मेरो फल मैल्हेलो।<verse eid="PRO 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18" />ज़ांतगर उमीदे तांतगर अपने मट्ठे झ़िड़क दे,</para>
  <para style="q" vid="PRO 19:18">ज़ैनी बुझ़तां तैस मैरी न छ़ड।<verse eid="PRO 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19" />ज़ै बड़ो सेरकोते, तैस सज़ाह झ़ैल्‍लने दे;</para>
  <para style="q" vid="PRO 19:19">किजोकि अगर तू तैस बच़ास, त बार-बार बच़ानू पेलू।<verse eid="PRO 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20" />सलाह शुन, ते शिक्षा कबूल केर,</para>
  <para style="q" vid="PRO 19:20">ताके तू अपने आखरी मां अक्लमन्द ठहरस।<verse eid="PRO 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21" />मैन्हेरे मने मां बड़े खियाल भोतन,</para>
  <para style="q" vid="PRO 19:21">पन ज़ै योजना यहोवारी भोतीए, तैए कायम रहतीए।<verse eid="PRO 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22" />मैन्हु मां वफादारी सेभना करां रोड़ो गुणे,</para>
  <para style="q" vid="PRO 19:22">ते गरीब मैन्हु झूठ ज़ोनेबाले करां रोड़ोए।<verse eid="PRO 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23" />यहोवारो डर मन्ने सेइं ज़िन्दगी बद्धतीए;</para>
  <para style="q" vid="PRO 19:23">ते तैसेरो डर मन्ने बालो ठिकानो मैलतां सुखी रहते;</para>
  <para style="q" vid="PRO 19:23">तैस पुड़ मुसीबत नईं पेने बाली।<verse eid="PRO 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24" />आलसी अपनो हथ थैली मां छ़डते,</para>
  <para style="q" vid="PRO 19:24">पन अपने ऐशी तगर ड्लाछ़ोड़ो न ने।<verse eid="PRO 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25" />मज़ाक बनानेबालन सज़ाह दे, इस सेइं सादो मैन्हु समझ़दार भोइ गालो;</para>
  <para style="q" vid="PRO 19:25">ते समझ़दार मैन्हु डांट, तैखन तै जादे ज्ञान हासिल केरेलो।<verse eid="PRO 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26" />ज़ैन मट्ठू अपने बाजी उज़ाड़ते, ते अपनि अम्मा नशानते,</para>
  <para style="q" vid="PRO 19:26">तैन निन्दा ते शरमरी वजा भोल्हु।<verse eid="PRO 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27" />हे मेरे मट्ठा, अगर तू शिक्षा शुन्नी शारस,</para>
  <para style="q" vid="PRO 19:27">त तू ज्ञानेरी गल्‍लन सेइं टेपलोइ गालो।<verse eid="PRO 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28" />झूठो गवाह न्याय मज़ाके मां उडारते,</para>
  <para style="q" vid="PRO 19:28">ते बुरे लोकन बुराई केरनी बड़ी रोड़ी लगतीए।<verse eid="PRO 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29" />मज़ाक बनाने बालेरे लेई सज़ाह ठहराई गातीए,</para>
  <para style="q" vid="PRO 19:29">ते बेवकूफां केरे पिठरे लेई कोड़े भोतन।<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1" />दाछ़रो रस मज़ाक बनानेबालो ते शराब हैल्‍लो मच़ाने बालीए;</para>
  <para style="q" vid="PRO 20:1">ज़ै कोई तैसेरे वजाई सेइं टेपलोते, तै अक्लमन्द नईं।<verse eid="PRO 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2" />राज़ेरी सरक, शेरेरे गरज़नेरे ज़ेरिए;</para>
  <para style="q" vid="PRO 20:2">ज़ै तैस सरकाते तै अपने प्राणे गुवाते।<verse eid="PRO 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3" />मुकदमे करां हथ खड़ो केरनो, मड़देरी इज़्ज़त ठहरतीए;</para>
  <para style="q" vid="PRO 20:3">पन सब बेवकूफ लड़ने जो तियार भोतन।<verse eid="PRO 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4" />आलसी मैन्हु ठंडरे वजाई सेइं दांत न लाए;</para>
  <para style="q" vid="PRO 20:4">एल्हेरेलेइ कटनेरे वक्ते तै भीख मगते, ते तैस किछ न मैल्हे।<verse eid="PRO 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5" />मैन्हेरे मने मां योजना डुग्घे पैनेरी ज़ेरिए,</para>
  <para style="q" vid="PRO 20:5">फिर भी समझ़ी बालो मैन्हु तैस कढते।<verse eid="PRO 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6" />बड़े मैन्हु अपने ईमानदार भोनेरो प्रचार केरतन;</para>
  <para style="q" vid="PRO 20:6">पन सच़्च़ो मैन्हु कौन हासिल केरि सकते?<verse eid="PRO 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7" />तै मैन्हु ज़ै अपने ईमानदैरी पुड़ च़लते,</para>
  <para style="q" vid="PRO 20:7">तैसेरां मट्ठा ज़ैना तैस पत्ती च़लतन, तैना धन भोतन।<verse eid="PRO 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8" />राज़ो ज़ै न्यायेरे तखते पुड़ बिशते,</para>
  <para style="q" vid="PRO 20:8">तै एपनी नज़री सेइं सब बुराई परखते।<verse eid="PRO 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9" />कौन ज़ोई सकते कि मीं अपनो दिल पवित्र कियो;</para>
  <para style="q" vid="PRO 20:9">ते कने अवं पापे करां शुद्ध भोवरोईं?<verse eid="PRO 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10" />घटते-बद्धते तोल ते घटते-बद्धते हैटी इन दूईयन सेइं यहोवा नफरत केरते।<verse eid="PRO 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11" />मट्ठू भी अपने कम्मन सेइं पिशानू गाते,</para>
  <para style="q" vid="PRO 20:11">कि तैसेरू कम पवित्र ते सिद्धू आहे, या नईं।<verse eid="PRO 20:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12" />शुन्नेरे लेई कन ते हेरनेरे लेई एछ़्छ़ी भोतिन,</para>
  <para style="q" vid="PRO 20:12">तैना दूईये यहोवा बनेवरिन।<verse eid="PRO 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13" />निड्ली सेइं प्यार न रख, नईं त गरीब भोइ गालो;</para>
  <para style="q" vid="PRO 20:13">एछ़्छ़ी खोल्‍ल तैखन तू रोट्टी खालो।<verse eid="PRO 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14" />घिन्नेरे वक्ते गाक, “रोड़ू नईं, रोड़ू नईं,” ज़ोते;</para>
  <para style="q" vid="PRO 20:14">पन च़ले गानेरां बाद बडीयाई केरते।<verse eid="PRO 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />सोन्नू ते बड़े कीमती मोती त आन;</para>
  <para style="q" vid="PRO 20:15">पन ज्ञानेरी गल्‍लां कीमती मणि ठहरोरिन।<verse eid="PRO 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16" />कोन्ची परदेशेरे लेई ज़मानत देनेबालेरां लिगड़ां ने ते बखलेरे लेई ज़ै जुवाब दह भोए तैस करां बन्धेरी चीज़ नेइतां रख।<verse eid="PRO 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17" />दगे सेइं हासिल कियोरी रोट्टी मैन्हु मिट्ठी त लगतीए,</para>
  <para style="q" vid="PRO 20:17">पन बादे मां तैसेरू आशी सिक्‍कन सेइं भेरोई गाते।<verse eid="PRO 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18" />सब खियाल सलाही सेइं टिकोरे रहतन;</para>
  <para style="q" vid="PRO 20:18">ते योजना सेइं साथी जंग कियोरी लोड़े।<verse eid="PRO 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19" />ज़ै चोगली केरतो फिरते तै भेद बांदो केरते;</para>
  <para style="q" vid="PRO 20:19">एल्हेरेलेइ बकवास केरनेबाले सेइं मेल जोल न रेखथ।<verse eid="PRO 20:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20" />ज़ै अपने अम्मा-बाजी कोसते,</para>
  <para style="q" vid="PRO 20:20">तैसेरो दीयो हिशते, ते बड़ू आंधरू भोइ गाते।<verse eid="PRO 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21" />ज़ै हिस्सो पेइलो जल्दी मैलते,</para>
  <para style="q" vid="PRO 20:21">आखरी मां तैस पुड़ बरकत न भोए।<verse eid="PRO 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22" />न ज़ो, “अवं बुरैइयरो बदलो घिन्नेलो;”</para>
  <para style="q" vid="PRO 20:22">बल्के यहोवा बलगतो रा, तै तीं छुटालो।<verse eid="PRO 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23" />घटते-बद्धते तोलन सेइं यहोवा नफरत केरते,</para>
  <para style="q" vid="PRO 20:23">ते धोखेरी ट्लकड़ी रोड़ी नईं।<verse eid="PRO 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24" />मैन्हु केरि बत यहोवारे तरफां ठहराई गातीए;</para>
  <para style="q" vid="PRO 20:24">मैन्हु अपनि बत केन्च़रे सेमझ़ी सकेलो?<verse eid="PRO 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25" />ज़ै मैन्हु बगैर विचार केरतां कोन्ची चीज़ी परमेशरे जो देनेरो वाधो केरे,</para>
  <para style="q" vid="PRO 20:25">ते ज़ै मिन्नत मेनतां पुछ़ ताछ केरे, तै फंदे मां फसेलो।<verse eid="PRO 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26" />अक्लमन्द राज़ो दुष्टन छ़टते,</para>
  <para style="q" vid="PRO 20:26">ते तैन पुड़ मडनेरो पेइहो च़लावाते।<verse eid="PRO 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27" />मैन्हेरी आत्मा यहोवारो दीयो आहे;</para>
  <para style="q" vid="PRO 20:27">तै मनेरी सब गल्‍लां केरि तोप केरते।<verse eid="PRO 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28" />राज़ेरी हिफाज़त महरबानी ते सच़्च़ाइयरे वजाई सेइं भोतीए,</para>
  <para style="q" vid="PRO 20:28">ते महरबानी केरने सेइं तैसेरो तखत बनोरो रहते।<verse eid="PRO 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29" />जुवाना केरि शोभा तैन केरि ताकते,</para>
  <para style="q" vid="PRO 20:29">पन बुढां केरि शोभा तैन केरे सुफेद बाल भोतन।<verse eid="PRO 20:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30" />चोट लग्गने सेइं ज़ैना ज़खम भोतन, तैना बुराई दूर केरतन;</para>
  <para style="q" vid="PRO 20:30">ते मार खाने सेइं मन शुद्ध भोइ गाते।<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1" />राज़ेरो मन पैनेरे गड्डां केरो ज़ेरो यहोवारे हथ्थे मां रहते,</para>
  <para style="q" vid="PRO 21:1">ज़ेरहां तै चाते तेरहां तैस मोड़ते।<verse eid="PRO 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2" />मैन्हु केरो सारो चाल च़लन एपनी नज़री मां त ठीक भोते,</para>
  <para style="q" vid="PRO 21:2">पन यहोवा मने परखते,<verse eid="PRO 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3" />ज़ैन सही आहे त न्याय केरनो,</para>
  <para style="q" vid="PRO 21:3">यहोवा बलिदाने करां जादे रोड़ू लगते।<verse eid="PRO 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4" />उच्‍ची अछ़, घमण्डी मन,</para>
  <para style="q" vid="PRO 21:4">ते दुष्टां केरि खेती, ट्लाईए पापे सेइं भेरतन।<verse eid="PRO 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5" />मेहनती मैन्हेरे खियालन सेइं सिर्फ फैइदो भोते,</para>
  <para style="q" vid="PRO 21:5">पन जल्दी केरनेबाले सिर्फ घटी भोतीए।<verse eid="PRO 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6" />ज़ै दौलत झूठेरे ज़िरिये हासिल भोए, तै हवाई सेइं उडरने बाली ट्लेल आहे,</para>
  <para style="q" vid="PRO 21:6">तैसेरे तोप्पने बाले मौती तोपतन।<verse eid="PRO 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7" />ज़ै ज़ुलम दुष्ट लोक केरतन,</para>
  <para style="q" vid="PRO 21:7">तैस सेइं तैन्ना केरो नाश भोते, किजोकि तैना न्यायेरू कम केरने सेइं इन्कार केरतन।<verse eid="PRO 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8" />पापे सेइं लद्दोरे मैन्हु केरि बत बड़ी टारी भोतीए,</para>
  <para style="q" vid="PRO 21:8">पन ज़ै पवित्रे, तैसेरू कम सिद्धू भोते।<verse eid="PRO 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9" />खुल्‍ले-डुल्‍ले घरे मां लड़ाई केरनेबाली कौन्शी सेइं साथी राने करां,</para>
  <para style="q" vid="PRO 21:9">लाए पुड़ एक्‍की कूने पुड़ रानू रोड़ू आहे।<verse eid="PRO 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10" />दुष्ट मैन्हु बुरी खुवैइश दिले सेइं केरते,</para>
  <para style="q" vid="PRO 21:10">तै अपने पड़ोसी पुड़ दया केरतां नज़र न केरे।<verse eid="PRO 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11" />ज़ैखन मज़ाक उड़ाने बाले सज़ाह दित्ती गातीए, तैखन सादो मैन्हु अक्लमन्द भोइ गाते;</para>
  <para style="q" vid="PRO 21:11">ते ज़ैखन अक्लमन्दे उपदेश दित्तो गाते, तैखन तै ज्ञान हासिल केरते।<verse eid="PRO 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12" />धर्मी परमेशर दुष्टां केरे घराने पुड़ अक्लमन्द भोइतां खियाल केरते,</para>
  <para style="q" vid="PRO 21:12">ते तै दुष्टन बुरैई मां उलटाते।<verse eid="PRO 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13" />ज़ै गरीब मैन्हेरी बिनती पुड़ कन न लाए,</para>
  <para style="q" vid="PRO 21:13">तै एप्पु पुकारेलो ते तैसेरी शुनी न गाली।<verse eid="PRO 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14" />छ़ेपतां दित्तोरे तोफे सेइं सरक ठंडी भोतीए,</para>
  <para style="q" vid="PRO 21:14">ते च़ुपच़ारे दित्तोरिए रिश्पती सेइं बड़ी सरक भी रुकतीए।<verse eid="PRO 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15" />न्यायेरू कम केरनू धर्मी मैन्हु त आनन्द,</para>
  <para style="q" vid="PRO 21:15">पन अनर्थ केरनेबालन नाशेरी वजा बुझ़ोतीए।<verse eid="PRO 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16" />ज़ै मैन्हु अक्लरी बत्ती करां भटकते,</para>
  <para style="q" vid="PRO 21:16">तैसेरो ठिकानो मुवोरां केरे दरमियाने मां भोल्हो।<verse eid="PRO 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17" />ज़ै आयाशी केरने सेइं प्यार केरते, तै कंगाल भोइ गाते;</para>
  <para style="q" vid="PRO 21:17">ते ज़ै दाखमधु पीने ते तेल लाने सेइं प्यार केरते, तै अमीर न भोए।<verse eid="PRO 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18" />दुष्ट मैन्हु धर्मी मैन्हेरी ज़मानत भोइ भोते,</para>
  <para style="q" vid="PRO 21:18">ते धोखेबाज़ सिद्धे लोकां केरे बदले सज़ाह गाते।<verse eid="PRO 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19" />लड़ाई केरने ते शौर केरनेबाले कौन्शी सेइं साथी राने करां,</para>
  <para style="q" vid="PRO 21:19">सुनसान ठैरी मां रानू रोड़ूए।<verse eid="PRO 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20" />अक्लमन्देरे घरे मां रोड़ी दौलत ते तेल<note caller="+" style="f"><char style="fr" closed="false">21:20 </char><char style="fq" closed="false">तेल </char><char style="ft" closed="false">कीमती चीज़ां</char></note> मैलते,</para>
  <para style="q" vid="PRO 21:20">पन बेवकूफ मैन्हु तैन्न उडारते।<verse eid="PRO 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21" />ज़ै धार्मिकतारो ते महरबैनरो पीछो केरते,</para>
  <para style="q" vid="PRO 21:21">तै ज़िन्दगी, धार्मिकता ते इज़्ज़त भी हासिल केरते।<verse eid="PRO 21:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22" />होशियार हाकिम बहदरां केरे नगरे पुड़ च़ेढ़तां,</para>
  <para style="q" vid="PRO 21:22">तैन केरे ताकती<note caller="+" style="f"><char style="fr" closed="false">21:22 </char><char style="fq" closed="false">ताकती </char><char style="ft" closed="false">शहरपनाह</char></note> नाश केरते ज़ैस पुड़ तैना भरोसो केरतन।<verse eid="PRO 21:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23" />ज़ै अपने ज़बानी कैबू मां रखते</para>
  <para style="q" vid="PRO 21:23">तै अपने प्राणन आफतन करां बच़ाते।<verse eid="PRO 21:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24" />ज़ै घमण्डे सेइं क्रोधे मां एइतां कम केरते, तैसेरू नवं अभिमानी भोते,</para>
  <para style="q" vid="PRO 21:24">ते घमण्डी मज़ाक बनानेबालो पेते।<verse eid="PRO 21:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25" />आलसी अपने खुवैइशी मां मेरि गाते,</para>
  <para style="q" vid="PRO 21:25">किजोकि तैसेरे हथ कम केरने सेइं इन्कार केरतन।<verse eid="PRO 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26" />कोई एरहो आहे, ज़ै सैरी दिहैड़ी खुवैइश केरते,</para>
  <para style="q" vid="PRO 21:26">पन धर्मी लगातार दान केरतो रहते।<verse eid="PRO 21:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27" />दुष्टां केरू बलिदान देनू भिट्टू भोते;</para>
  <para style="q" vid="PRO 21:27">खास केरतां ज़ैखन तै बुरे मकसदे सेइं साथी आनते।<verse eid="PRO 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28" />झूठो गवाह नाश भोइ गालो,</para>
  <para style="q" vid="PRO 21:28">पन सच़्च़ो गवाह हमेशा कायम रालो।<verse eid="PRO 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29" />दुष्ट मैन्हु अपनु तुत्तर सखत केरते,</para>
  <para style="q" vid="PRO 21:29">ते धर्मी अपनि चाल सिद्धी रखते।<verse eid="PRO 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30" />यहोवारे खलाफ न त किछ अक्ल,</para>
  <para style="q" vid="PRO 21:30">ते न किछ समझ़, न कोई योजना च़लतीए।<verse eid="PRO 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31" />जंगरे दिहाड़ेरे लेई सिपाही घोड़े तियार त केरतन,</para>
  <para style="q" vid="PRO 21:31">पन ज़ींत यहोवारे तरफां मैलतीए।<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1" />बड़े दौलती करां रोड़ू नवं जादे चाने काबले,</para>
  <para style="q" vid="PRO 22:1">ते सोन्नू चैंदी करां होरन करां आदर मैल्हनी रोड़ीए।<verse eid="PRO 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2" />अमीर ते गरीब दूईयन मां अक बराबरी भोतीए;</para>
  <para style="q" vid="PRO 22:2">यहोवा तैन दूईयां केरो बनानेबालोए।<verse eid="PRO 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3" />च़लाक मैन्हु मुसीबत एइतां लेइतां छ़पते;</para>
  <para style="q" vid="PRO 22:3">पन सिद्धे-सादे लोक अग्रोवं गेइतां सज़ाह भोगतन।<verse eid="PRO 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4" />नम्रता ते यहोवारो डर मन्नेरो फल धन,</para>
  <para style="q" vid="PRO 22:4">आदर ते लम्मी ज़िन्दगी भोतीए।<verse eid="PRO 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5" />टारे मैन्हेरे बत्ती मां कंटे ते फंदे रहतन;</para>
  <para style="q" vid="PRO 22:5">पन ज़ै अपने प्राणां केरि हिफाज़त केरते, तै तैन करां दूर रहते।<verse eid="PRO 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6" />बच्‍चे तैस्से बत्तरी शिक्षा दे ज़ैस मां तैस च़लोरू लोड़े,</para>
  <para style="q" vid="PRO 22:6">ते तै बुढे बारे मां भी तैस करां दूर न भोल्हो।<verse eid="PRO 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7" />अमीर, गरीब लोकन पुड़ राज़ केरते,</para>
  <para style="q" vid="PRO 22:7">ते ओधार नेनेबालो ओधार देनेबालेरो गुलाम भोते।<verse eid="PRO 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8" />ज़ै अन्यायेरू बीज़ बेते, तै मुसीबतरी फसल कटेलो,</para>
  <para style="q" vid="PRO 22:8">ते तैसेरे सरकरो सोटो ट्लुटेलो।<verse eid="PRO 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9" />दया केरनेबाले पुड़ बरकत फलतीए,</para>
  <para style="q" vid="PRO 22:9">किजोकि तै कंगाले अपनि रोट्टी मरां देते।<verse eid="PRO 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10" />मज़ाक बनानेबालन कढ, तैखन लड़ाई मिटाई गाली,</para>
  <para style="q" vid="PRO 22:10">ते बेंस ते बेइज़्ज़ती दूईये ट्लुटी गैली।<verse eid="PRO 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11" />ज़ै मनेरी शुद्धताई सेइं प्यार केरते,</para>
  <para style="q" vid="PRO 22:11">ते ज़ेसेरी गल्‍लां खूबसूरत भोतिन, राज़ो तैसेरो दोस्त भोते।<verse eid="PRO 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12" />यहोवा ज्ञानी मैन्हु पुड़ नज़र केरतां, तैसेरी हिफाज़त केरतो रहते,</para>
  <para style="q" vid="PRO 22:12">पन धोखे बाज़ेरी गल्‍लां उलटाते।<verse eid="PRO 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13" />आलसी ज़ोते, बेइर त शेर भोल्हो!</para>
  <para style="q" vid="PRO 22:13">अवं चौकेरे मझ़ाटे मारो गेइलो।<verse eid="PRO 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14" />व्यभिचार केरनेबाली कौन्शरू तुत्तर डुग्घो खड्डो भोते;</para>
  <para style="q" vid="PRO 22:14">ज़ैस सेइं यहोवा सेकोते, तै तैस मां झ़ड़ते।<verse eid="PRO 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15" />मट्ठेरे मने मां बेवकूफेरो ड्लन्ठ बंधोरो रहते,</para>
  <para style="q" vid="PRO 22:15">पन अनुशासनेरी सोटी सेइं तै खोलतां तैस करां दूर की गाचे।<verse eid="PRO 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16" />ज़ैना अपने फैइदेरे लेई कंगाले पुड़ ज़ुलम केरतन,</para>
  <para style="q" vid="PRO 22:16">ते ज़ै अमीरे भेंट देते, तैना दूईये सिर्फ कंगाल भोल्हे।<verse eid="PRO 22:16" /></para>
  <para style="s">अक्लमन्देरी गल्‍लां</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17" />कन लेइतां अक्लमन्दा केरि गल्‍लां शुन,</para>
  <para style="q" vid="PRO 22:17">ते मेरे ज्ञानेरे गल्‍लां केरे पासे मन ला;<verse eid="PRO 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18" />अगर तू तैस अपने मने मां रख्खस,</para>
  <para style="q" vid="PRO 22:18">ते तैना सब तेरे ऐशी मरां कढन भी, त ई मन पसंद गल भोल्ही।<verse eid="PRO 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19" />मीं अज़ एल्हेरेलेइ इना गल्‍लां तीं ज़ोवरिन,</para>
  <para style="q" vid="PRO 22:19">कि तेरो भरोसो यहोवा पुड़ भोए।<verse eid="PRO 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20" />अवं बड़े दिहाड़न करां तेरे फैइदेरे उपदेश</para>
  <para style="q" vid="PRO 22:20">ते ज्ञानेरी गल्‍लां लिखतो एवरोईं,<verse eid="PRO 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21" />कि अवं तीं सच़्च़े वचना केरू याकीन देईं,</para>
  <para style="q" vid="PRO 22:21">ज़ैस सेइं ज़ै तीं कम्मे मां लाए, तैन्न सच़्च़ो जुवाब देइ सकस।<verse eid="PRO 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22" />कंगाले पुड़ इस वजाई सेइं अंधेर नईं कि तै कंगाले,</para>
  <para style="q" vid="PRO 22:22">ते न शरीफ मैन्हु आदालती मां पिहां;<verse eid="PRO 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23" />किजोकि यहोवा तैन केरो मुकदमो लड़ेलो,</para>
  <para style="q" vid="PRO 22:23">ते ज़ैना लोक तैन केरि दौलत नेतन, तैन केरो प्राण भी तै नेते।<verse eid="PRO 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24" />सरकी बाले मैन्हेरो दोस्त न बेना,</para>
  <para style="q" vid="PRO 22:24">ते जल्दी सरक केरनेबाले सेइं साथी नईं च़लनू,<verse eid="PRO 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25" />कोन्च एरू न भोए कि तू तैसेरी चाल शिखस,</para>
  <para style="q" vid="PRO 22:25">ते तेरो प्राण फंदे मां फंसे।<verse eid="PRO 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26" />ज़ैना लोक हथ्थे पुड़ हथ मारतन,</para>
  <para style="q" vid="PRO 22:26">ते कर्ज़दारां केरे ज़िमेवार भोतन, तैन मां तू न गेइयां।<verse eid="PRO 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27" />अगर तीं कां भुगतान केरनेरे लेई किछ न भोए,</para>
  <para style="q" vid="PRO 22:27">त किजो न शावकार तीं हैठां खट नेलो?<verse eid="PRO 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28" />ज़ै हद तेरे दादे पड़दादेईं बन्धोरी भोए, तैस पुरानी हद न बधा।<verse eid="PRO 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29" />अगर तू एरे मड़दे हेरस ज़ै कम-काज़े मां भरपूर भोए,</para>
  <para style="q" vid="PRO 22:29">त तै राज़ां केरे सामने खड़ो भोल्हो; आम लोकां केरे सामने नईं।<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1" />ज़ैखन तू कोन्ची हाकिमे सेइं साथी रोट्टी खानेरे लेई बिश्शस,</para>
  <para style="q" vid="PRO 23:1">तैखन इस गल्‍ली मन लेइतां सोचां कि मेरे सामने कौने?<verse eid="PRO 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2" />ते अगर तू जादे खाने बालो भोस,</para>
  <para style="q" vid="PRO 23:2">त थोड़ू खेइतां ढ्लुखोरो खड़ो भोइयां।<verse eid="PRO 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3" />तैसेरी सुवादे बाली खानेरी चीज़ां केरू लालच़ न केरां,</para>
  <para style="q" vid="PRO 23:3">किजोकि तै धोखेरी रोट्टीए।<verse eid="PRO 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4" />दौलतमन्द भोनेरे लेई मेहनत नईं केरनि;</para>
  <para style="q" vid="PRO 23:4">अपने समझ़रो भरोसो शारनो।<verse eid="PRO 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5" />ज़ैखन तू अपनि नज़र दौलती पुड़ लाएलो,</para>
  <para style="q" vid="PRO 23:5">तै च़ली गाली,</para>
  <para style="q" vid="PRO 23:5">तै उकाब च़ुड़ोलवेरी ज़ेरि फंघां लाएली, इस मां कोई शक नईं अम्बरेरे पासे उडरतां गाली।<verse eid="PRO 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6" />ज़ै कंजूस मैन्हेरी रोट्टी न खेइयां,</para>
  <para style="q" vid="PRO 23:6">ते न तैसेरी सुवादे बाले खानेरी चीज़ां केरू लालच़ केरां;<verse eid="PRO 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7" />किजोकि तै एरहो मैन्हु आहे,</para>
  <para style="q" vid="PRO 23:7">ज़ै रोट्टरे कीमतरी गिनती केरते। तै तीं सेइं ज़ोने त ज़ोते, खा ते पी,</para>
  <para style="q" vid="PRO 23:7">पन तैसेरो मन तीं सेइं लगोरो नईं।<verse eid="PRO 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8" />ज़ै ड्लाछ़ोड़ो तीं खेवरो भोए, तै उतारनो पेलो,</para>
  <para style="q" vid="PRO 23:8">ते तू अपनि मिट्ठी गल्‍लां केरो फल हारेलो।<verse eid="PRO 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9" />बेवकूफेरे सामने नईं ज़ोनू,</para>
  <para style="q" vid="PRO 23:9">नईं त तै तेरे अक्लरे वचन्न घटिया समझ़ेलो।<verse eid="PRO 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10" />पुरैनी हद्दां नईं बधैनी,</para>
  <para style="q" vid="PRO 23:10">ते न अनाथां केरे उडारन मां गानू;<note caller="-" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="PRO 22:28">कह. 22:28</ref>.</char></note><verse eid="PRO 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11" />किजोकि तैन केरो छुटानेबालो परमेशर सामर्थी आहे;</para>
  <para style="q" vid="PRO 23:11">तैन केरो मुकदमो तीं साथी तैए लड़ेलो।<verse eid="PRO 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12" />अपनो दिल शिक्षारे पासे,</para>
  <para style="q" vid="PRO 23:12">ते अपने कन ज्ञानेरी गल्‍लां केरे पासे लानो।<verse eid="PRO 23:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13" />मट्ठे झ़िड़क देनी नईं शारनी;</para>
  <para style="q" vid="PRO 23:13">किजोकि अगर तू तैस सोटी सेइं बास, त तै न मरेलो।<verse eid="PRO 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14" />तू तैस सोटी सेइं बैइतां तैसेरो प्राण पाताले करां बच़ालो।<verse eid="PRO 23:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15" />हे मेरे मट्ठा, अगर तू अक्लमन्द भोस,</para>
  <para style="q" vid="PRO 23:15">त मेरो मन खुश भोल्हो।<verse eid="PRO 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16" />ते ज़ैखन तू सिद्धी गल्‍लां ज़ोस, तैखन मेरो मन खुश भोल्हो।<verse eid="PRO 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17" />तू पैपी केरे बारे मां मने मां जलन न केरां,</para>
  <para style="q" vid="PRO 23:17">सैरी दिहैड़ी यहोवारो डर मनतो रानो।<verse eid="PRO 23:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18" />किजोकि आखरी मां तीं फल मैल्हेलो,</para>
  <para style="q" vid="PRO 23:18">ते तेरी एजनेबाली ज़िन्दगी बड़ी रोड़ी भोल्ही।<verse eid="PRO 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19" />हे मेरे मट्ठा, तू शुन्तां अक्लमन्द भो,</para>
  <para style="q" vid="PRO 23:19">ते अपनो मन रोड़ी बत्ती मां सिद्धो च़ला।<verse eid="PRO 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20" />दाछ़रो रस पीने बालन मां शामल न भोइयां,</para>
  <para style="q" vid="PRO 23:20">न जादे मास खाने बालन सेइं साथ रेखां;<verse eid="PRO 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21" />किजोकि पीने बालो ते पेटू कंगाल भोइ गाले,</para>
  <para style="q" vid="PRO 23:21">ते तैन केरि सरक तैन्न खिन्थां लुवाली।<verse eid="PRO 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22" />अपने ज़र्म देनेबाले बाजी केरि शुन्नी,</para>
  <para style="q" vid="PRO 23:22">ते ज़ैखन तेरी अम्मा बुढी भोइ गाए, तैखन भी तैस घटिया न सेमझ़ां।<verse eid="PRO 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23" />सच़्च़ाई घिन्नी, बेच़नी नईं;</para>
  <para style="q" vid="PRO 23:23">ते अक्ल ते शिक्षा ते समझ़ भी घिन्न।<verse eid="PRO 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24" />धर्मी मैन्हेरो बाजी बड़ो मघन भोते;</para>
  <para style="q" vid="PRO 23:24">ते अक्लमन्दे ज़र्म देनेबालो तैसेरे वजाई सेइं खुश भोते।<verse eid="PRO 23:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25" />तेरे वजाई सेइं तेरे अम्मा-बाजी खुश ते तेरी ज़र्म देनेबाली मघन भोए।<verse eid="PRO 23:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26" />हे मेरे मट्ठा, अपनो मन मेरे पासे ला,</para>
  <para style="q" vid="PRO 23:26">ते तेरी नज़र मेरे चाल च़लने पुड़ लगोरीए राए।<verse eid="PRO 23:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27" />वेश्या डुग्घो खड्डो ठहरतीए;</para>
  <para style="q" vid="PRO 23:27">ते बखली कौन्श तंग खूहेरी ज़ेरि भोतीए।<verse eid="PRO 23:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28" />तै डैकू केरि ज़ेरि मारने लगतीए,</para>
  <para style="q" vid="PRO 23:28">ते बड़े लोकन धोखेबाज़ बनातीए।<verse eid="PRO 23:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29" />कौन ज़ोते, अफ़सोस? कौन ज़ोते, अफ़सोस, अफ़सोस? कौन लड़ाई-झगड़न मां फसते?</para>
  <para style="q" vid="PRO 23:29">कौन बक-बक केरते? केसेरे वजाई सेइं ज़खम भोतन? केसेरी एछ़्छ़ी लाल भोइ गैतिन?<verse eid="PRO 23:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30" />तैन केरि ज़ैना दाछ़रो रस च़िरे तगर पीतन,</para>
  <para style="q" vid="PRO 23:30">ते ज़ैना मसालो मिलावरो दाछ़रो रस तोप्पने जो गातन।<verse eid="PRO 23:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31" />ज़ैखन दाछ़रो रस लाल लेइहोते, ते कुटोरे मां तैसेरो रोड़ो रंग भोते,</para>
  <para style="q" vid="PRO 23:31">ते ज़ैखन तै धारी सेइं उलटव गाते,</para>
  <para style="q" vid="PRO 23:31">तैखन तै नईं हेरनो।<verse eid="PRO 23:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32" />किजोकि आखरी मां तै सप्पेरे ज़ेरो डसते,</para>
  <para style="q" vid="PRO 23:32">ते बड़े ज़ेहरीले सप्पेरो ज़ेरो कटते।<verse eid="PRO 23:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33" />तू आजीब चीज़न लाएलो,</para>
  <para style="q" vid="PRO 23:33">ते उलटी-सिद्धी गल्‍लां बकतो रालो।<verse eid="PRO 23:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34" />ते तू समुन्दरेरे मझ़ाटे लेटने बाले</para>
  <para style="q" vid="PRO 23:34">या मस्तूलेरे च़ोटी पुड़ झ़ुलने बालेरो ज़ेरो रालो।<verse eid="PRO 23:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35" />तू ज़ोलो कि मीं मार त खाइ, पन दुखी न भोव;</para>
  <para style="q" vid="PRO 23:35">अवं मड्डो त जेव, पन मीं किछ खबर न भोइ।</para>
  <para style="q" vid="PRO 23:35">अवं होशी मां कैखन एज्जी? अवं त फिरी शराब तोप्पेलो।<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1" />बुरे लोकां केरे बारे मां जलन न केरां,</para>
  <para style="q" vid="PRO 24:1">ते न तैन केरे साथेरी इच्छा रेखां;<verse eid="PRO 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2" />किजोकि तैना ज़ुलम सोचते रहतन,</para>
  <para style="q" vid="PRO 24:2">ते तैन केरे ज़बानरां दुष्टेरी गल्‍लां निसतिन।<verse eid="PRO 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3" />घर अक्ली सेइं बनते,</para>
  <para style="q" vid="PRO 24:3">ते समझ़रे ज़िरिये बस्सोरू रहते।<verse eid="PRO 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4" />ज्ञानेरे ज़िरिये कोठी हर किसमेरे बड़े कीमती</para>
  <para style="q" vid="PRO 24:4">ते खूबसूरत चीज़न सेइं भेरि गैतिन।<verse eid="PRO 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5" />बहादर मड़द ताकतबर भोते,</para>
  <para style="q" vid="PRO 24:5">पन ज्ञानी मैन्हु ताकतबर मड़दे करां बड़ो रोड़ोए।<verse eid="PRO 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6" />एल्हेरेलेइ ज़ैखन तू जंग केरस, तैखन योजनाई सेइं केरां,</para>
  <para style="q" vid="PRO 24:6">ज़ींत त बड़े सलहकारां केरे ज़िरिये हासिल भोतीए।<verse eid="PRO 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7" />अक्ल एत्रे उच्‍चे पुड़े कि बेवकूफ तैस हासिल न केरि सकन;</para>
  <para style="q" vid="PRO 24:7">तै सभाई मां<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="fq" closed="false">सभाई मां </char><char style="ft" closed="false">सभा नगरेरे लोकां केरू तैन झुण्ड थियूं, ज़ैन पुराने वक्ते मां कानूनी ते खास मुद्दां केरे बारे मां गलबात ते फैसलो केरतू थियूं।</char></note> अपनु आशी खोल्‍ली न सके।<verse eid="PRO 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8" />ज़ै सोचने विचार केरने सेइं बुराई केरते,</para>
  <para style="q" vid="PRO 24:8">तैस जो लोक दुष्ट ज़ोतन।<verse eid="PRO 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9" />बेवकूफेरो खियाल भी पापे,</para>
  <para style="q" vid="PRO 24:9">ते मज़ाक बनानेबाले सेइं मैन्हु नफरत केरतन।<verse eid="PRO 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10" />अगर तू आफतरे मौके हिम्मत शारस,</para>
  <para style="q" vid="PRO 24:10">त तेरी शक्ति बड़ी घटे।<verse eid="PRO 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11" />ज़ैना मारनेरे लेई दीले गातन तैन्न छुटा;</para>
  <para style="q" vid="PRO 24:11">ते ज़ैना मारे गानेबालेन तैन्न रोक।<verse eid="PRO 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12" />अगर तू ज़ोस, कि हेर अवं इस ज़ानतो न थियो,</para>
  <para style="q" vid="PRO 24:12">त कुन मनेरो परखने बालो परमेशर इस न समझ़े?</para>
  <para style="q" vid="PRO 24:12">ते कुन तेरे प्राणां केरि हिफाज़त केरनेबालो परमेशर इस न ज़ाने?</para>
  <para style="q" vid="PRO 24:12">ते कुन तै हर एक्‍की मैन्हेरे कम्मेरो फल तैस न देलो?<verse eid="PRO 24:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13" />हे मेरे मट्ठा तू माछ़ी खा, किजोकि तैन रोड़ूए,</para>
  <para style="q" vid="PRO 24:13">ते मैछ़ेरो कश भी, किजोकि तै तेरे ऐशी मां मिट्ठो लग्गेलो।<verse eid="PRO 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14" />एन्च़रां सेइं अक्ल भी तीं तेरही मिट्ठी लग्गेली;</para>
  <para style="q" vid="PRO 24:14">अगर तू तैस हासिल केरस त आखरी मां तैसेरो फल भी मैल्हेलो, ते तेरी उमीद न ट्लुटेली।<verse eid="PRO 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15" />तू दुष्ट मैन्हेरो ज़ेरो धर्मी मैन्हेरे तेम्बु बरबाद केरनेरे लेई छ़ेपतां मारनेरे लेई न बिश;</para>
  <para style="q" vid="PRO 24:15">ते तैसेरी आरामेरी ठार न उज़ड़ेली;<verse eid="PRO 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16" />किजोकि धर्मी चाहे सत फेरेईं बिछ़ड़े फिर भी खड़ो भोते;</para>
  <para style="q" vid="PRO 24:16">पन दुष्ट लोक मुसीबती मां झ़ेड़तां बिछ़ड़ोरे रहतन।<verse eid="PRO 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17" />ज़ैखन तेरो दुश्मन बिछ़ड़े तैखन तू खुश न भोइयां,</para>
  <para style="q" vid="PRO 24:17">ते ज़ैखन तै ठोकर खाए, तैखन तेरो मन मघन न भोए।<verse eid="PRO 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18" />कोन्च एरू न भोए कि यहोवा एन हेरतां खुश न भोए</para>
  <para style="q" vid="PRO 24:18">ते अपनि सरक दुश्मने पुड़ां हटाए।<verse eid="PRO 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19" />कुकर्म केरनेबालां केरे वजाई सेइं न कुढ,</para>
  <para style="q" vid="PRO 24:19">दुष्ट लोकां केरे वजाई सेइं जलन न केर;<verse eid="PRO 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20" />किजोकि बुरे मैन्हु आखरी मां</para>
  <para style="q" vid="PRO 24:20">किछ फल न मैल्हेलो, दुष्टां केरो दीयो हिशाव गालो।<verse eid="PRO 24:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21" />हे मेरे मट्ठा, यहोवा ते राज़ो दूईयां केरो डर मन्नो;</para>
  <para style="q" vid="PRO 24:21">ते तैन केरे खलाफ बगावत केरनेबालन सेइं नईं मिलनू;<verse eid="PRO 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22" />किजोकि तैन पुड़ आफत अचानक एज्जेली,</para>
  <para style="q" vid="PRO 24:22">ते परमेशर ते राज़े दूईयां केरे पासे एजनेबाली आफत कौन ज़ानते?<verse eid="PRO 24:22" /></para>
  <para style="s">अक्लमन्दा केरि होरि भी गल्‍लां</para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23" />अक्लमन्दा केरे वचन इना भी आन।</para>
  <para style="q" vid="PRO 24:23">न्याय मां तरफदारी केरनि, कोन्ची भी तरीके सेइं ठीक नईं।<verse eid="PRO 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24" />ज़ै दुष्टे सेइं ज़ोते कि तू बेकसूर आस,</para>
  <para style="q" vid="PRO 24:24">तैस त हर समाजेरे लोक लानत देतन ते कौमां-कौमां केरे लोक तैस सेइं नफरत केरेले;<verse eid="PRO 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25" />पन ज़ैना लोक दुष्टी डांटतन तैन केरू भलू भोते,</para>
  <para style="q" vid="PRO 24:25">ते रोड़े करां रोड़ो आशिर्वाद तैन पुड़ एइते।<verse eid="PRO 24:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26" />ज़ै सिद्धो जुवाब देते,</para>
  <para style="q" vid="PRO 24:26">तै ओठन फुम्मड़ी देते।<verse eid="PRO 24:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27" />अपनु बेइरियोवं कम-काज़ ठीक केरनू,</para>
  <para style="q" vid="PRO 24:27">ते अपने लेई ऊडार भी तियार केरनू;</para>
  <para style="q" vid="PRO 24:27">तैसेरे बाद अपनु घर बनानू।<verse eid="PRO 24:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28" />बगैर कोन्ची वजाई सेइं अपने पड़ोसेरे खलाफ गवाही नईं देनी,</para>
  <para style="q" vid="PRO 24:28">ते न तै टपलानो।<verse eid="PRO 24:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29" />न ज़ो, “ज़ेरू तैने मीं सेइं कियूं तेरहु अवं भी तैस सेइं केरेलो;</para>
  <para style="q" vid="PRO 24:29">ते तैस तैसेरे कम्मेरे मुताबिक बदलो देइलो।”<verse eid="PRO 24:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30" />अवं आलसी मैन्हेरे उडारे करां</para>
  <para style="q" vid="PRO 24:30">ते बेअक्ल मैन्हेरे दाछ़री बागी मेइं भोइतां गातो थियो,<verse eid="PRO 24:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31" />त कुन हेरू, कि तैड़ी सेभी पासन कंटन बाले बुट भेरि जेवरेन;</para>
  <para style="q" vid="PRO 24:31">ते तै शढ्ली सेइं ढक्‍को जेव,</para>
  <para style="q" vid="PRO 24:31">ते तैसेरे घोड़ां केरो बाड़ झ़ड़ोरोए।<verse eid="PRO 24:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32" />तैखन मीं लावं ते तैस पुड़ ध्याने सेइं खियाल कियो;</para>
  <para style="q" vid="PRO 24:32">हाँ मीं हेरतां शिक्षा हासिल की।<verse eid="PRO 24:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33" />थोड़ी ज़ेरि निड्ल, अक होरि डिगरी,</para>
  <para style="q" vid="PRO 24:33">थोड़े च़िरे हथ्थे पुड़ हथ रेखतां लेटनू,<verse eid="PRO 24:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34" />तैखन तेरी गरीबी डैकेरी ज़ेरि,</para>
  <para style="q" vid="PRO 24:34">ते तेरी घटी हथियार-बन्देरी ज़ेरि एज्जेली।<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">सुलैमानेरी होरि भी ज्ञानेरी गल्‍लां</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 25:1" />सुलैमानेरी कहावतां इना भी आन;</para>
  <para style="q" vid="PRO 25:1">ज़ैना यहूदारे राज़े हिजकिय्याहेरे अधिकारी लोकेईं नकल कियोरी थी।<verse eid="PRO 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2" />परमेशरेरी आदर, छ़पोरे रखने मांए</para>
  <para style="q" vid="PRO 25:2">पन राज़ां केरि आदर छ़पोरी गल्‍लां केरो पतो लाने सेइं भोतीए।<verse eid="PRO 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3" />सुर्गेरी ऊँचाई ते धेरतरो डुग्घार</para>
  <para style="q" vid="PRO 25:3">ते राज़ां केरो मन, इन ट्लेइयां केरो अन्त न मैल्हे।<verse eid="PRO 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4" />चैंदी मरां मैल दूर केरने पुड़ तै सुनारेरे लेई कम्मेरी भोइ गातीए।<verse eid="PRO 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5" />तेन्च़रे, राज़ेरे सामने सेइं दुष्टन कढने पुड़ तैसेरो तखत धर्मेरे वजाई सेइं कायम भोल्हो।<verse eid="PRO 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6" />राज़ेरे सामने अपनि बडीयाई न केरां</para>
  <para style="q" vid="PRO 25:6">ते अधिकारी लोकां केरे ठारी खड़ो न भोइयां;<verse eid="PRO 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7" />तैन केरे लेई तीं सेइं इन ज़ोनू बड़ू रोड़ूए कि,</para>
  <para style="q" vid="PRO 25:7">“इड़ी मीं कां एइतां बिश” ताके प्रधानां केरे सामने तीं बेइज़्ज़त न भोनू पे।<verse eid="PRO 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8" />ज़ैन किछ तीं लाहेरूए, तैन लूशी आदालती मां न आन,</para>
  <para style="q" vid="PRO 25:8">आखरी मां ज़ैखन तेरो पड़ोसी<note caller="+" style="f"><char style="fr" closed="false">25:8 </char><char style="fq" closed="false">पड़ोसी </char><char style="ft" closed="false">होरो गवाह</char></note> तीं शरमिन्दो केरेलो त तू कुन केरेलो?<verse eid="PRO 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9" />अपने पड़ोसी सेइं बेंस अकैल्‍ले मां केरनी</para>
  <para style="q" vid="PRO 25:9">ते बखलेरो भेद नईं खोल्‍लनो;<verse eid="PRO 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10" />एरू न भोए कि शुन्ने बालो तेरी भी निन्दा केरे,</para>
  <para style="q" vid="PRO 25:10">ते तेरी निन्दा बनोरी राए।<verse eid="PRO 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11" />ज़ेन्च़रे चैंदरे टोकरन मां सोन्नेरां च़ोइयां भोन,</para>
  <para style="q" vid="PRO 25:11">तेन्च़रे ठीक वक्ते पुड़ ज़ोवरी गल्‍लां भोतिन।<verse eid="PRO 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12" />ज़ेन्च़रे सोन्नेरी नथ ते कुन्दनेरो गेहनो रोड़ो लगते,</para>
  <para style="q" vid="PRO 25:12">तेन्च़रे मन्नेबालेरे कन्ने मां अक्लमन्देरी डांट भी रोड़ी लगतीए।<verse eid="PRO 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13" />ज़ेन्च़रे कटनेरे वक्ते हिंवेरी ठंडी सेइं,</para>
  <para style="q" vid="PRO 25:13">तेन्च़रे भरोसेरे काबल दूते सेइं भी,</para>
  <para style="q" vid="PRO 25:13">मालिकेरो मन ठंडो भोते।<verse eid="PRO 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14" />ज़ेन्च़रे बिदलार ते हवा बगैर बखने बेफैइदी भोतन,</para>
  <para style="q" vid="PRO 25:14">तेन्च़रे झूठ-मूठ दान देनेबाली बडीयाई केरनी भोतीए।<verse eid="PRO 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15" />सबर केरने सेइं न्याय केरनेबालो मनाव गाते,</para>
  <para style="q" vid="PRO 25:15">ते नर्म शब्द हेड्डन भी ट्लोड़ते।<verse eid="PRO 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />कुन तीं माछ़ी मैल्हू? त ज़ेत्रू तेरे लेई ठीक भोए एत्रू खानू,</para>
  <para style="q" vid="PRO 25:16">एरू न भोए कि जादे खेइतां तैस उतारस।<verse eid="PRO 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17" />अपने पड़ोसेरे घरे मां बार-बार गाने करां अपने पव रोक,</para>
  <para style="q" vid="PRO 25:17">एरू न भोए कि तै तंग भोइतां नफरत केरने लग्गे।<verse eid="PRO 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18" />ज़ै केन्चेरे खलाफ झूठी गवाही देते,</para>
  <para style="q" vid="PRO 25:18">तै मन्ना हथोड़ो ते तलवार ते तिखो तीरे।<verse eid="PRO 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19" />आफतरे वक्ते धोखे केरनेबालेरो भरोसो,</para>
  <para style="q" vid="PRO 25:19">ट्लुटोरे दंत या गिशकोरे पव्वे<note caller="+" style="f"><char style="fr" closed="false">25:19 </char><char style="fq" closed="false">गिशकोरे पव्वे </char><char style="ft" closed="false">लैंगड़ो</char></note> बराबरे।<verse eid="PRO 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20" />ज़ेरो हिवंतड़ेरे दिहाड़न मां केन्चेरां लिगड़ां खोलना या ज़खमे पुड़ सिरको छ़डनो भोते,</para>
  <para style="q" vid="PRO 25:20">तेन्च़रे परेशान मने बालेरे सामने गीत ज़ोनू भोते।<verse eid="PRO 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21" />अगर तेरो बैरी ढ्लुखोरो भोए त तैस रोट्टी खुवानी;</para>
  <para style="q" vid="PRO 25:21">ते अगर तै ट्लिशोरो भोए त तैस पानी पियानू;<verse eid="PRO 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22" />किजोकि एन्च़रां तू तैसेरे दोग्गे पुड़ शरमरो मूरां केरो ढेर छ़डेलो,</para>
  <para style="q" vid="PRO 25:22">ते यहोवा तीं इसेरो फल देलो।<verse eid="PRO 25:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23" />ज़ेन्च़रे उत्तरी हवा झ़ड़ी आनतीए,</para>
  <para style="q" vid="PRO 25:23">तेन्च़रे चोगली केरने सेइं तुत्तरे पुड़ सरक पेई गातीए।<verse eid="PRO 25:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />खुल्‍ले डुल्‍ले घरे मां लड़ाई केरनेबाली कौन्शी सेइं राने करां लाएरे कूने पुड़ रानू ठीके।<verse eid="PRO 25:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25" />दूर मुल्खे मरां खुशरी खबर,</para>
  <para style="q" vid="PRO 25:25">ट्लिशोरे लेई ठंडे पैनेरू ज़ेरूए।<verse eid="PRO 25:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26" />ज़ै धर्मी दुष्टेरे ज़ोने मां एइते,</para>
  <para style="q" vid="PRO 25:26">तै खराब नाले ते बिगड़ोरे कुण्डेरो ज़ेरोए।<verse eid="PRO 25:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27" />ज़ेन्च़रे बड़ू माछ़ी खानू रोड़ू नईं,</para>
  <para style="q" vid="PRO 25:27">तेन्च़रे अपनि तारीफ़ केरनी भी रोड़ी नईं।<verse eid="PRO 25:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />ज़ेसेरी आत्मा कैबू मां नईं तै एरे नगरेरो ज़ेरोए ज़ेसेरी दिवार घेरो देइतां ट्लोड़ी जेवरी भोए।<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1" />ज़ेरू धुप्परे दिहाड़े मां हिंवेरू, या कटनेरे वक्ते झ़ड़ी भोनी,</para>
  <para style="q" vid="PRO 26:1">तेरही बेवकूफेरी इज़्ज़त भी ठीक न भोए।<verse eid="PRO 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2" />ज़ेन्च़रे च़ुड़ोली घुमते-घुमते ते सूपाबेनी उडरते-उडरते न बिश्शे,</para>
  <para style="q" vid="PRO 26:2">तेन्च़रे बेफैइदी लानत न पे।<verse eid="PRO 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3" />घोड़ेरे लेई चाबुक, गधेरे लेई लगाम,</para>
  <para style="q" vid="PRO 26:3">ते बेवकूफां केरि पिठरे लेई सोटीए।<verse eid="PRO 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4" />बेवकूफे तैसेरी बेवकूफरे मुताबिक जुवाब नईं देनो एरू न भोए कि तू भी तैसेरो ज़ेरो ठहरस।<verse eid="PRO 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5" />बेवकूफे तैसेरी बेवकूफरे मुताबिक जुवाब देनो,</para>
  <para style="q" vid="PRO 26:5">एरू न भोए कि तै अपनि नज़री मां अक्लमन्द भोए।<verse eid="PRO 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6" />ज़ै बेवकूफेरे हथ्थे सन्देश भेज़ते,</para>
  <para style="q" vid="PRO 26:6">तै मन्ना अपने पव्वे पुड़ मैक्‍कु सेइं बाते ते बिष पीते।<verse eid="PRO 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7" />ज़ेन्च़रे लेंगड़ेरे पव थरकतन,</para>
  <para style="q" vid="PRO 26:7">तेन्च़रे बेवकूफां केरे ऐशी मां कहावतां भोतिन।<verse eid="PRO 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8" />ज़ेन्च़रे घोड़ेरू गुलेली मां बन्धनू बेफैइदू आहे,</para>
  <para style="q" vid="PRO 26:8">तेन्च़रे बेवकूफे आदर देनी भोतीए।<verse eid="PRO 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9" />ज़ेन्च़रे मसत भोवरेरे हथ्थे मां कंटो डुबते,</para>
  <para style="q" vid="PRO 26:9">तेन्च़रे बेवकूफां केरि ज़ोवरी कहावतां भी दुख देने बैली भोतिन।<verse eid="PRO 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10" />ज़ेरो कोई तीरन्दाज़े बगैर वजां सेब्भन मारतो भोए,</para>
  <para style="q" vid="PRO 26:10">तेन्च़रे बेवकूफन या बत्तां च़लनेबालां केरो मज़दूरी मां लानेबालो भी भोते।<verse eid="PRO 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11" />ज़ेन्च़रे कुतर अपनु उतारोरू च़टते,</para>
  <para style="q" vid="PRO 26:11">तेन्च़रे बेवकूफ अपनि बेवकूफी दुबारां केरते।<verse eid="PRO 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12" />अगर तू एरहो मैन्हु हेरस ज़ै अपनि नज़री मां अक्लमन्द बनतो भोए,</para>
  <para style="q" vid="PRO 26:12">त तैस करां जादे उमीद बेवकूफे करां आहे।<verse eid="PRO 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />आलसी ज़ोते, “बत्ती मां शेरे,</para>
  <para style="q" vid="PRO 26:13">चौके मां शेरे!”<verse eid="PRO 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14" />ज़ेन्च़रे दार अपनि च़ुली पुड़ फिरते,</para>
  <para style="q" vid="PRO 26:14">तेन्च़रे आलसी अपनि खट्टी पुड़ फेर देते।<verse eid="PRO 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15" />आलसी अपनो हथ थैली मां त छ़डते,</para>
  <para style="q" vid="PRO 26:15">पन आलसेरे वजाई सेइं ड्लाछ़ड़ो ऐशी तगर न ने।<verse eid="PRO 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16" />आलसी एप्पु जो ठीक जुवाब देनेबाले</para>
  <para style="q" vid="PRO 26:16">सत मैन्हन मरां भी जादे अक्लमन्द समझ़ते।<verse eid="PRO 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17" />ज़ै बत्तां च़लते होरि केरे लड़ैई मां बिघन छ़डते,</para>
  <para style="q" vid="PRO 26:17">तै तैसेरो ज़ेरोए, ज़ै पागल कुतरे कन्नेरां ट्लाते।<verse eid="PRO 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18" />ज़ेरो अक पागल ज़ै ज़ेरे बाले तीर मारते,<verse eid="PRO 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19" />तेरहो तै भी भोते ज़ै अपने पड़ोसी धोखो देइतां ज़ोते,</para>
  <para style="q" vid="PRO 26:19">“अवं त मज़ाक केरि राहोरो थियो।”<verse eid="PRO 26:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20" />ज़ेन्च़रे कैड़ु न भोने सेइं अग हिशतीए,</para>
  <para style="q" vid="PRO 26:20">तेन्च़रे ज़ैड़ी चोगली केरनेबालो नईं, तैड़ी लड़ाई मिटी गातीए।<verse eid="PRO 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21" />ज़ेरो मूरन मां अंगारोवं ते अग्गी मां कैड़ु भोतन,</para>
  <para style="q" vid="PRO 26:21">तेन्च़रे लड़ाई बधानेरे लेई लड़ाई केरनेबालो भोते।<verse eid="PRO 26:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22" />चोगली केरनेबालेरी गल्‍लां,</para>
  <para style="q" vid="PRO 26:22">सुवैदली रोट्टी केरि ज़ेरि अन्तर एइतिन।<verse eid="PRO 26:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23" />ज़ेरो कोई चैंदरू पानी च़ाड़ोरू मित्तरू भांड भोए,</para>
  <para style="q" vid="PRO 26:23">तेन्च़रे बुरे मने बालेरे प्यारे सेइं भरोरी गल्‍लां भोतिन।<verse eid="PRO 26:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24" />ज़ै बैरी गल्‍ली सेइं त अपने आपे सादो बनाते,</para>
  <para style="q" vid="PRO 26:24">पन एप्पु मां धोखो रखते,<verse eid="PRO 26:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25" />तैसेरी मिट्ठी-मिट्ठी गल्‍लन पुड़ विश्वास नईं केरनो,</para>
  <para style="q" vid="PRO 26:25">किजोकि तैसेरे मने मां सत भिट्टी चीज़ां रैतिन;<verse eid="PRO 26:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26" />चाहे तैसेरू बैर धोखेरे वजाई सेइं छ़ेप्पी गाए,</para>
  <para style="q" vid="PRO 26:26">फिर भी तैसेरी बुराई सेभी केरे सामने बांदी भोइ गाली।<verse eid="PRO 26:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27" />ज़ै खड्डो घड़े, तैए तैस्से मां झ़ड़ेलो, ते ज़ै घोड़ लटकाए,</para>
  <para style="q" vid="PRO 26:27">तै उलटेइतां तैस्से पुड़ एज्जेलो।<verse eid="PRO 26:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28" />ज़ैनी कोई झूठी गल्‍लन सेइं ज़खमी कियोरो भोए तैए तैस सेइं बैर रखते,</para>
  <para style="q" vid="PRO 26:28">ते मिट्ठी-मिट्ठी गल ज़ोने बालो नाशेरी वजा भोते।<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1" />कालेरे दिहाड़ेरे बारे घमण्ड न केर,</para>
  <para style="q" vid="PRO 27:1">किजोकि तू न ज़ानस कि सैरी दिहैड़ी मां कुन भोल्हु।<verse eid="PRO 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2" />तेरी तारीफ़ होरे लोक त केरन, पन तू एप्पु न केरां;</para>
  <para style="q" vid="PRO 27:2">होरे तेरे बडीयाई केरन त केरन, पन तू अपनि बडीयाई न केरां।<verse eid="PRO 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3" />घोड़ त गिरकोए ते रेती मां बोझे,</para>
  <para style="q" vid="PRO 27:3">पन बेवकूफेरी सरक, तैन दूईयन करां भी गिरकीए।<verse eid="PRO 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4" />बड़ी सरक ते क्रोधेरी हड़ाई,</para>
  <para style="q" vid="PRO 27:4">पन जलनरे सामने कौन रेइ सकते?<verse eid="PRO 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5" />खुल्‍ली डांट छ़पोरे प्यारे करां रोड़ीए।<verse eid="PRO 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6" />ज़ैना ज़खम दोस्तेरे हथ्थे सेइं लगतन तैना भरोसेरे काबलन</para>
  <para style="q" vid="PRO 27:6">पन बैरी जादे फुम्मड़ी देते।<verse eid="PRO 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7" />रज़्ज़नेरां बाद मैछ़ेरो कश भी फिक्‍को लगते,</para>
  <para style="q" vid="PRO 27:7">पन ढ्लुखोरे भोने पुड़ सब ट्लिठी चीज़ां भी मिट्ठी लेगतिन।<verse eid="PRO 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8" />ठार छ़ेडतां घुमने बालो मैन्हु तैस च़ुड़ोलोवेरो ज़ेरोए,</para>
  <para style="q" vid="PRO 27:8">ज़ै आल्हो छ़ेडतां उडरतो फिरते।<verse eid="PRO 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9" />ज़ेन्च़रे तेल ते खुशबू सेइं,</para>
  <para style="q" vid="PRO 27:9">तेन्च़रे दोस्तेरे दिलेरी सही सलाही सेइं मन खुश भोते।<verse eid="PRO 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10" />ज़ै तेरो ते तेरे बाजी केरो भी दोस्त भोए तै नईं शारनो;</para>
  <para style="q" vid="PRO 27:10">ते अपने आफतरे दिहाड़े, अपने ढ्लाएरे घरे नईं गानू।</para>
  <para style="q" vid="PRO 27:10">प्यार केरनेबालो पड़ोसी, दूर रानेबाले ढ्लाए करां बड़ो रोड़ोए<verse eid="PRO 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11" />हे मेरे मट्ठा, अक्लमन्द भोइतां मेरो मन खुश केर,</para>
  <para style="q" vid="PRO 27:11">तैखन अवं अपने निन्दा केरनेबाले जुवाब देइ सकेलो।<verse eid="PRO 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12" />अक्लमन्द मैन्हु मुसीबत एइती हेरतां छ़पते;</para>
  <para style="q" vid="PRO 27:12">पन सिद्धे-सादे लोक अग्रोवं च़ले गातन ते नुकसान झ़ैलतन।<verse eid="PRO 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13" />ज़ैना बखलेरे ज़िमेवार भोतन तैसेरो कपड़ो,</para>
  <para style="q" vid="PRO 27:13">ते ज़ै परदेशेरो ज़िमेवार भोए तैस करां बन्धे रख्खोरी चीज़ ने।<verse eid="PRO 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14" />ज़ै झ़ेझ़ां उठतां अपने पड़ोसी उच्‍चे आवाज़ी सेइं नमस्कार केरते,</para>
  <para style="q" vid="PRO 27:14">तैसेरेलेइ ई लानत गनी गातीए।<verse eid="PRO 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15" />झ़ेड़रे दिहाड़े पैनेरे तेप्पु लगातार पेने,</para>
  <para style="q" vid="PRO 27:15">ते झगड़ो केरनेबाली कौन्श दूईये अक्‍कां ज़ेरां आन;<verse eid="PRO 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16" />ज़ै तैस रोकी सके, तै हवाई भी रोकेलो ते देइने हथ्थे सेइं तै तेल ट्लालो।<verse eid="PRO 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17" />ज़ेन्च़रे लोंह लोंहे चमकाते,</para>
  <para style="q" vid="PRO 27:17">तेन्च़रे मैन्हेरू तुत्तर अपने दोस्तेरे साथे सेइं चमकने बालू भोते।<verse eid="PRO 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18" />ज़ै फैगेरे बुट्टेरी हिफाज़त केरते तै तैसेरो फल खाते,</para>
  <para style="q" vid="PRO 27:18">एन्च़रां सेइं ज़ै अपने मालिकेरी सेवा केरते तैसेरी आदर भोतीए।<verse eid="PRO 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19" />ज़ेन्च़रे पैनी मां तुत्तरेरी छाव तुत्तरे बांदू केरतीए,</para>
  <para style="q" vid="PRO 27:19">तेन्च़रे मैन्हेरो मन मैन्हु बांदू केरते।<verse eid="PRO 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20" />ज़ेन्च़रे पाताल ते विनाश लोक,</para>
  <para style="q" vid="PRO 27:20">तेन्च़रे मैन्हेरी एछ़्छ़ी भी रज़्ज़न न।<verse eid="PRO 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21" />ज़ेन्च़रे चैंदरे लेई कुठाली ते सोन्नेरे लेई भेट्ठी आन,</para>
  <para style="q" vid="PRO 27:21">तेन्च़रे मैन्हेरे लेई तैसेरी तारीफ़े।<verse eid="PRO 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22" />चाहे तू बेवकूफे अन्नेरे मझ़ाटे उखले मां छ़ेडतां मसाले सेइं पीहस,</para>
  <para style="q" vid="PRO 27:22">तांभी तैसेरी बेवकूफी नईं गानेबाली।<verse eid="PRO 27:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23" />एपनी भैड्डां-छ़ेल्‍ली केरि हालत रोड़ेच़ारे मन लेइतां बुझ़,</para>
  <para style="q" vid="PRO 27:23">ते अपने सब जानबरां केरे केन्नी केरि हेर-गेश रोड़ेच़ारे केर;<verse eid="PRO 27:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24" />किजोकि जाईदात हमेशा न राए;</para>
  <para style="q" vid="PRO 27:24">ते कुन राज़मुकुट पीढ़ी करां पीढ़ी तगर बनोरू रहते?<verse eid="PRO 27:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25" />कटोरो घास सल्‍लो गाते ते नंव्वो घास लेइहोते</para>
  <para style="q" vid="PRO 27:25">ते पहाड़ां केरि हरियाली केटतां अकोट्ठी की गाचे;<verse eid="PRO 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26" />तैखन भैड्डां केरे बच्‍चां केरि उन्ना तेरे लिगड़ां केरे लेई भोल्ही,</para>
  <para style="q" vid="PRO 27:26">ते किछ थाव्वे बेच़नेरे ज़िरिये नंव्वे उडारेरी कीमत दित्ती गाली;<verse eid="PRO 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27" />ते छ़ेल्‍लन कां एत्रू दुद्ध भोल्हु कि तू अपने टब्बरे समेत पेट भेरतां पीलो,</para>
  <para style="q" vid="PRO 27:27">ते तेरी नौकरैनी भी ज़िन्दगरो गुज़ारो भोल्हो।<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1" />दुष्ट लोक ज़ैखन कोई पत्ती न भोए खतोरो तैखन भी नशतन,</para>
  <para style="q" vid="PRO 28:1">पन धर्मी लोक जुवान शेरां केरे ज़ेरे निडर रहतन।<verse eid="PRO 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2" />मुल्खे मां पाप भोनेरे वजाई सेइं तैसेरे हाकिम बदलते गातन;</para>
  <para style="q" vid="PRO 28:2">पन समझ़दार ते ज्ञानी मैन्हु केरे ज़िरिये रोड़ो इंतज़ाम बड़े दिहाड़ां केरे लेई बनोरो रालो।<verse eid="PRO 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3" />ज़ै गरीब मड़द कंगालन पुड़ अंधेर केरते,</para>
  <para style="q" vid="PRO 28:3">तै एरी भारी झ़ेड़री ज़ेरोए ज़ैन किछ खानेरी चीज़ न शारे।<verse eid="PRO 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4" />ज़ैना लोक कानूने शारतन, तैना दुष्टेरी तारीफ़ केरतन,</para>
  <para style="q" vid="PRO 28:4">पन कानूने पुड़ च़लनेबाले तैन केरि खलाफत केरतन।<verse eid="PRO 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5" />बुरे लोक न्याय न सेमझ़ी सकन,</para>
  <para style="q" vid="PRO 28:5">पन यहोवारे तोप्पने बाले सब किछ समझ़तन।<verse eid="PRO 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6" />टारी चाल च़लनेबाले अमीर मैन्हु करां सच़्च़ाई सेइं च़लनेबालो गरीब मड़द रोड़ोए।<verse eid="PRO 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7" />ज़ै कानूने मन्ते तैन समझ़दार मट्ठू भोते,</para>
  <para style="q" vid="PRO 28:7">पन उडारने बालेरो साथी अपने बाजी केरू तुत्तर कालू केरते।<verse eid="PRO 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8" />ज़ै अपनि दौलत सूते सेइं बद्धाते</para>
  <para style="q" vid="PRO 28:8">तै तैसेरेलेइ अकोट्ठू केरते ज़ै कंगालन पुड़ दया केरते।<verse eid="PRO 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9" />ज़ै अपनो कन कानून शुन्ने करां मोड़ते,</para>
  <para style="q" vid="PRO 28:9">तैसेरी प्राथना भिट्टी ठहरतीए।<verse eid="PRO 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10" />ज़ै सिद्धे लोकन टेपलोइतां बुरी बत्ती मां नेते तै अपने घड़ोरे खड्डे मां एप्पु झ़ड़ते;</para>
  <para style="q" vid="PRO 28:10">पन बेकसूर लोक भलेरे हिस्सेदार भोतन।<verse eid="PRO 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11" />अमीर मड़द अपनि नज़री मां अक्लमन्द भोते,</para>
  <para style="q" vid="PRO 28:11">पन समझ़दार कंगाल तैस समझ़ते।<verse eid="PRO 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12" />ज़ैखन धर्मी लोक ज़ींत हासिल केरतन, तैखन बड़ी शोभा भोतीए;</para>
  <para style="q" vid="PRO 28:12">पन ज़ैखन दुष्ट लोक कब्ज़ो केरतन, तैखन मैन्हु अपने आपे छ़ुपाते।<verse eid="PRO 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13" />ज़ै अपने पाप छ़ुपेइतां रखते, तैसेरू कम कामयाब न भोए,</para>
  <para style="q" vid="PRO 28:13">पन ज़ै तैन्न मन्ते ते शारते भी,</para>
  <para style="q" vid="PRO 28:13">तैस पुड़ महरबानी की गाली।<verse eid="PRO 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14" />ज़ै मैन्हु लगातार परमेशरेरो डर मनतो रहते<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="fq" closed="false">परमेशरेरो डर मनतो रहते </char><char style="ft" closed="false">या बुराई केरने करां डरते</char></note> तै धने;</para>
  <para style="q" vid="PRO 28:14">पन ज़ै अपनो मन सखत केरते तै मुसीबती मां पेते।<verse eid="PRO 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15" />कंगाल लोकन पुड़ अधिकार केरनेबालो दुष्ट, गरज़नेबाले शेर ते घुमने बाले इछ़ेरो ज़ेरोए।<verse eid="PRO 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16" />तै हुकूमत केरनेबाले ज़ैस मां समझ़री घटी भोए, तै बड़ी अंधेर केरते;</para>
  <para style="q" vid="PRO 28:16">ते ज़ै लालच़ेरो दुश्मन भोते तैसेरी उमर लम्मी भोतीए।<verse eid="PRO 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17" />ज़ै मैन्हु कोन्ची मैन्हेरे मौतरो पापी भोए, तै नेशतां खड्डे मां झ़ड़ेलो;</para>
  <para style="q" vid="PRO 28:17">कोई तैस न रोकेलो।<verse eid="PRO 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18" />ज़ै सही सेइं च़लते तै बच़ाव गाते,</para>
  <para style="q" vid="PRO 28:18">पन ज़ै टारी चाल च़लते तै अचानक झ़ड़ते।<verse eid="PRO 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19" />ज़ै अपनि ज़मीनी बेते, तैसेरू पेट भरते,</para>
  <para style="q" vid="PRO 28:19">पन ज़ै निकम्मे लोकां केरू साथ रखते तै बड़ो कंगाल भोइ गाते।<verse eid="PRO 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20" />सच़्च़े मैन्हु पुड़ बड़े आशिर्वाद भोतन,</para>
  <para style="q" vid="PRO 28:20">पन ज़ै अमीर भोने मां जल्दी केरते, तै बेकसूर न ठहरे।<verse eid="PRO 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21" />तरफदारी केरनि रोड़ी नईं;</para>
  <para style="q" vid="PRO 28:21">ते इन भी रोड़ू नईं कि रोट्टरे एक्‍की टुक्ड़ेरे लेई मैन्हु पाप केरे।<verse eid="PRO 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22" />लालच़ी मैन्हु दौलत हासिल केरने मां जल्दी केरते,</para>
  <para style="q" vid="PRO 28:22">ते न ज़ाने कि तै कंगाल भोइ गालो।<verse eid="PRO 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23" />ज़ै कोन्ची मैन्हु डांटते तै आखरी मां चापलूसी केरनेबाले करां जादे ट्लारो भोइ गाते।<verse eid="PRO 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24" />ज़ै अपने अम्मा-बाजी लुटतां ज़ोते कि किछ पाप नईं,</para>
  <para style="q" vid="PRO 28:24">तै नाश केरनेबालेरो साथी ठहरते।<verse eid="PRO 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25" />लालच़ी मैन्हु लड़ाई मच़ाते,</para>
  <para style="q" vid="PRO 28:25">ते ज़ै यहोवा पुड़ भरोसो रखते तै फलेलो फुलेलो।<verse eid="PRO 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26" />ज़ै अपने आपे पुड़ भरोसो रखते, तै बेवकूफे;</para>
  <para style="q" vid="PRO 28:26">ते ज़ै अक्ली सेइं च़लते, तै बच़ते।<verse eid="PRO 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27" />ज़ै गरीबे दान देते तैस घटी न भोए,</para>
  <para style="q" vid="PRO 28:27">पन ज़ै तैस करां नज़र फिराते तैस लानती पुड़ लानत भोतीए।<verse eid="PRO 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28" />ज़ैखन दुष्ट लोक काबज़ भोतन तैखन तै मैन्हु तोप्पने सेइं न मैल्हे,</para>
  <para style="q" vid="PRO 28:28">पन ज़ैखन तैना नाश भोतन, तैखन धर्मी तरक्‍की केरतन।<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1" />ज़ै बार-बार डांटने पुड़ भी जिद केरतो रहते, तैसेरो अचानक नाश भोइ गालो।</para>
  <para style="q" vid="PRO 29:1">ते तैसेरो कोई भी इंतज़ाम कम्मे न एज्जेलो।<verse eid="PRO 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2" />ज़ैखन धर्मी लोक उच्‍चे भोतन, तैखन आवाम खुश भोतीए;</para>
  <para style="q" vid="PRO 29:2">पन ज़ैखन दुष्ट राज़ केरते तैखन आवाम अफ़सोस-अफ़सोस केरतीए।<verse eid="PRO 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3" />ज़ै अक्ली सेइं प्यार केरते, तै अपने बाजी खुश केरते,</para>
  <para style="q" vid="PRO 29:3">पन वेश्यान कां गानेबालो दौलती उड़ाते।<verse eid="PRO 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4" />राज़ो न्याये सेइं मुल्खे कायम केरते,</para>
  <para style="q" vid="PRO 29:4">पन ज़ै बड़ी रिश्पत नेते तैस पेलटी देते।<verse eid="PRO 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5" />ज़ै मड़द कोन्ची सेइं मिट्ठी-मिट्ठी गल्‍लां केरते,</para>
  <para style="q" vid="PRO 29:5">तै तैसेरे पव्वां केरे लेई जाल बछ़ाते।<verse eid="PRO 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6" />बुरे मैन्हेरो पाप तैसेरेलेइ फंदो भोते,</para>
  <para style="q" vid="PRO 29:6">पन धर्मी खुश भोइतां जयजयकार केरते।<verse eid="PRO 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7" />धर्मी मड़द कंगालां केरे मुकदमे मां मन लाते;</para>
  <para style="q" vid="PRO 29:7">पन दुष्टी मैन्हु तैस ज़ान्नेरी समझ़ न रख्खे।<verse eid="PRO 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8" />मज़ाक बनानेबाले लोक नगरे फुक्‍की देतन,</para>
  <para style="q" vid="PRO 29:8">पन अक्लमन्द लोक सरकी ठंडी केरतन।<verse eid="PRO 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9" />ज़ैखन अक्लमन्द बेवकूफन सेइं साथी बेंस केरतन,</para>
  <para style="q" vid="PRO 29:9">तैखन तै बेवकूफ सेकोते ते मज़ाक बनाते, ते तैड़ी शान्ति न राए।<verse eid="PRO 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10" />खूनी लोक ईमानदार मैन्हु सेइं बैर रखतन,</para>
  <para style="q" vid="PRO 29:10">ते सिद्धे लोकां केरे प्राणेरी तोप केरतन।<verse eid="PRO 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11" />बेवकूफ अपने सारे मनेरी गल खोलते,</para>
  <para style="q" vid="PRO 29:11">पन अक्लमन्द अपने मने रोकते, ते च़ुप केरते।<verse eid="PRO 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12" />ज़ैखन हाकिम झूठी गल्‍लां केरे पासे कन लाते,</para>
  <para style="q" vid="PRO 29:12">तैखन तैसेरे सब सेवक दुष्ट भोइ गातन।<verse eid="PRO 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13" />गरीब ते अंधेर केरनेबाले मैन्हन मां अक बराबरी भोतीए;</para>
  <para style="q" vid="PRO 29:13">यहोवा दूईयां केरि एछ़्छ़न मां लौ देते।<verse eid="PRO 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14" />ज़ै राज़ो कंगालां केरो न्याय सच़्च़ैई सेइं केरते,</para>
  <para style="q" vid="PRO 29:14">तैसेरो तखत सदा टिकोरो रहते।<verse eid="PRO 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15" />सोटी ते डांटी सेइं अक्ल हासिल भोतीए,</para>
  <para style="q" vid="PRO 29:15">पन ज़ैन मट्ठू एन्च़रे शारू गाते तैन अपनि अम्मरी शरमरू कम भोते।<verse eid="PRO 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16" />दुष्टां केरे बधने सेइं पाप भी बद्धते;</para>
  <para style="q" vid="PRO 29:16">पन आखरी मां धर्मी लोक तैन केरू बिछ़ड़नू हेरतन।<verse eid="PRO 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17" />अपने मट्ठे झ़िड़क दे, तैखन तैस सेइं तीं चैन मैल्हेलो;</para>
  <para style="q" vid="PRO 29:17">ते तेरो मन सुखी भोइ गालो।<verse eid="PRO 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18" />ज़ैड़ी दर्शनेरी गल न भोए, तैड़ी लोक बेलगाम भोइ गातन,</para>
  <para style="q" vid="PRO 29:18">पन ज़ै कानूने मन्ते तै धन भोते।<verse eid="PRO 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19" />दास गल्‍लां केरे ज़िरिये सुधारो न गाए,</para>
  <para style="q" vid="PRO 29:19">किजोकि तै सेमझ़तां भी न मन्ने।<verse eid="PRO 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20" />कुन तू गल्‍लां केरने मां जल्दी केरनेबाले मैन्हु हेरतस?</para>
  <para style="q" vid="PRO 29:20">तैस करां जादे त बेवकूफे सेइं उमीदे।<verse eid="PRO 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21" />ज़ै अपने नौकरे तैसेरे निकड़ारेरे देंते लाड-प्यारे सेइं पालते,</para>
  <para style="q" vid="PRO 29:21">तै दास आखरी मां तैसेरू मट्ठू<note caller="+" style="f"><char style="fr" closed="false">29:21 </char><char style="fq" closed="false">मट्ठू </char><char style="ft" closed="false">या बारस</char></note> बेनतां बिशते।<verse eid="PRO 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22" />क्रोध केरनेबालो मैन्हु लड़ाई मच़ाते</para>
  <para style="q" vid="PRO 29:22">ते बड़ो जादे सरक केरनेबालो पापी भी भोते।<verse eid="PRO 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23" />मैन्हेरे घमण्डेरे वजाई सेइं घटिया भोनू पेते,</para>
  <para style="q" vid="PRO 29:23">पन शरीफ आत्मा बालो आदरारो अधिकारी भोते।<verse eid="PRO 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24" />ज़ै च़ोरे सेइं साथ रखते तै अपने प्राणेरो बैरी भोते;</para>
  <para style="q" vid="PRO 29:24">कसम खाने पुड़ भी तै गल बांदी न केरे।<verse eid="PRO 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25" />मैन्हेरू डरनू फंदो भोइ गाते,</para>
  <para style="q" vid="PRO 29:25">पन ज़ै यहोवा पुड़ भरोसो रखते तैसेरी ठार उच्‍ची की गाली।<verse eid="PRO 29:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26" />हाकिमे सेइं मुलाकात केरनी बड़े लोक चातन,</para>
  <para style="q" vid="PRO 29:26">पन मैन्हेरो न्याय यहोवा केरते।<verse eid="PRO 29:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27" />धर्मी लोक बुरे मैन्हु सेइं नफरत केरतन,</para>
  <para style="q" vid="PRO 29:27">ते दुष्ट मैन्हु भी सिद्धी चाल च़लनेबाले सेइं नफरत केरते।<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">आगूरेरे वचन</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 30:1" />याकेरे मट्ठे आगूरेरे प्रभाव केरनेबाले वचन।</para>
  <para style="q" vid="PRO 30:1">तैनी मड़दे ईतीएल ते उक्‍काले सेइं इन ज़ोवं:<verse eid="PRO 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />ज़रूर अवं जानबरेरो ज़ेरो आईं, बल्के मैन्हु ज़ोनेरे काबल भी नईं;</para>
  <para style="q" vid="PRO 30:2">ते मैन्हेरी समझ़ मीं मां नईं।<verse eid="PRO 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3" />न मीं अक्ल हासिल कियोरीए,</para>
  <para style="q" vid="PRO 30:3">ते न परमपवित्र परमेशरेरू ज्ञान मीं मैल्होरूए।<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />कौन सुर्गे मां च़ेढ़तां फिरी ओस्तां अव?</para>
  <para style="q" vid="PRO 30:4">केनि हवा अपनि मुठड़ी मां जमा केरतां रख्खोरीए?</para>
  <para style="q" vid="PRO 30:4">केनि महा समुन्दर अपने लिगड़े मां बन्धोरोए?</para>
  <para style="q" vid="PRO 30:4">केनि धेरतरी हद्दां ठहरेवरिन? तैसेरू नवं कुने?</para>
  <para style="q" vid="PRO 30:4">ते तैसेरे मट्ठां केरू नवं कुने? अगर तू ज़ानतस त ज़ो!<note caller="+" style="f"><char style="fr" closed="false">30:4 </char><char style="ft" closed="false">ई पूरी आयत परमेशरेरे बारे मां आहे</char></note><verse eid="PRO 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5" />परमेशरेरू अक-अक वचन तेवरूए;</para>
  <para style="q" vid="PRO 30:5">तै एप्पु कां एजनेबालां केरि ढाल बनो।<verse eid="PRO 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6" />तैसेरे वचन्न मां किछ न बधा,</para>
  <para style="q" vid="PRO 30:6">एरू न भोए कि तै तीं डांटे ते तू झूठो ठहरस।<verse eid="PRO 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7" />मीं तीं करां दूई बर मग्गोरन,</para>
  <para style="q" vid="PRO 30:7">एल्हेरेलेइ मेरे मरने करां पेइले तैन्न मीं देने करां तुत्तर न फिरा<verse eid="PRO 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8" />मतलब बेफैइदी ते झूठी गल मीं करां दूर रख; मीं न त गरीब केर ते न अमीर बना;</para>
  <para style="q" vid="PRO 30:8">रोज़ेरी रोट्टी मीं खूवा।<verse eid="PRO 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9" />एरू न भोए, कि ज़ैखन मीं कां खाने जो बड़ू किछ भोइ गाए, तैखन अवं इन्कार केरतां ज़ोईं कि यहोवा कौने?</para>
  <para style="q" vid="PRO 30:9">या कंगाल भोइतां च़ोरी केरि,</para>
  <para style="q" vid="PRO 30:9">ते परमेशरेरे नंव्वेरी बेइज़्ज़त केरि।<verse eid="PRO 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10" />कोन्ची नौकरेरी, तैसेरे मालिके सेइं चोगली न केरां,</para>
  <para style="q" vid="PRO 30:10">एरू न भोए कि तै तीं श्राप दे, ते तू दोषी ठहराव गास।<verse eid="PRO 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11" />एरे लोकन, ज़ैना अपने बाजी श्राप देतन</para>
  <para style="q" vid="PRO 30:11">ते अपनि अम्मा धन न ज़ोन।<verse eid="PRO 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12" />तैना एरे लोकन ज़ैना एपनी नज़री मां शुद्ध आन,</para>
  <para style="q" vid="PRO 30:12">पन तैन केरो मैल धोवरो नईं।<verse eid="PRO 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13" />एक्‍की पीढ़रे लोक एरे आन तैन केरि नज़र केत्री घमण्डे सेइं भरोरी रहतीए,</para>
  <para style="q" vid="PRO 30:13">ते तैन केरि एछ़्छ़ी केरही च़ैढ़ोरी रैतिन।<verse eid="PRO 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14" />एक्‍की पीढ़रे लोक एरे आन, ज़ैन केरे दंत तलवार ते तैन केरि दाड़ां चैकू आन,</para>
  <para style="q" vid="PRO 30:14">ज़ैन सेइं तैना शरीफ लोक धेरती पुड़ेरां, ते गरीबन मैन्हन मरां मिटेई छ़डतन।<verse eid="PRO 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15" />ज़ेन्च़रे जोंकेरी दूई कुइयां भोतिन, ज़ैना ज़ोतिन, “दे, दे,”</para>
  <para style="q" vid="PRO 30:15">तेरही ट्लाई चीज़न, ज़ैना रज़्ज़न न; बल्के च़ेवर आन,</para>
  <para style="q" vid="PRO 30:15">ज़ैना कधी न ज़ोन, “बस।”<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />पाताल ते बे औलादरी कोख,</para>
  <para style="q" vid="PRO 30:16">धरती ज़ै पानी पी पीतां रज़्ज़े न,</para>
  <para style="q" vid="PRO 30:16">ते अग ज़ै कधी न ज़ोए, “बस।”<verse eid="PRO 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17" />ज़ैस अछ़्छ़ी सेइं कोई अपने बाजी पुड़ बेइज़्ज़तरी नज़र केरे,</para>
  <para style="q" vid="PRO 30:17">ते बेइज़्ज़ती सेइं साथी अपनि अम्मरो हुक्म न मन्ने,</para>
  <para style="q" vid="PRO 30:17">तैस अछ़्छ़ी वैदरे कंव्वां घेड़ी-घेड़ी कढेलां,</para>
  <para style="q" vid="PRO 30:17">ते उकाबेरे बच्‍चे खाले।<verse eid="PRO 30:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18" />ट्लाई गल्‍लां मेरे लेई जादे मुश्किल आन,</para>
  <para style="q" vid="PRO 30:18">बल्के च़ेवर आन, ज़ैना मेरी समझ़ी करां दूरन।<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />अम्बरे मां उकाब च़ुड़ोलवेरी बत,</para>
  <para style="q" vid="PRO 30:19">चट्टानी पुड़ सप्पेरी चाल, समुन्दरे मां ज़िहाज़ेरी बत,</para>
  <para style="q" vid="PRO 30:19">ते कुइये सेइं साथी मड़देरी चाल।<verse eid="PRO 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20" />व्यभिचार केरनेबाली कौन्शरी चाल भी तेरही आहे;</para>
  <para style="q" vid="PRO 30:20">तै रोट्टी खेइतां आशी पूंछ़तीए,</para>
  <para style="q" vid="PRO 30:20">ते ज़ोतीए, मीं कोई अनर्थ कम नईं कियोरू।<verse eid="PRO 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21" />ट्लाई गल्‍लां केरे वजाई सेइं धरती थरकतीए; बल्के च़ेवर आन,</para>
  <para style="q" vid="PRO 30:21">ज़ैना तैस झ़ेलोन न<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />गुलामेरू राज़ो बन्नू,</para>
  <para style="q" vid="PRO 30:22">बेवकूफेरू पेट भरनु<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />भिट्टी कौन्श ड्लानी,</para>
  <para style="q" vid="PRO 30:23">ते नौकरैनरू अपने मालकिनरू बारस भोनू।<verse eid="PRO 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24" />धेरती पुड़ च़ेवर निकड़े जीप आन,</para>
  <para style="q" vid="PRO 30:24">ज़ैना बड़े जादे अक्लमन्दन<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />बिंदली कमज़ोर त आन,</para>
  <para style="q" vid="PRO 30:25">पन धुप्परे दिहाड़न मां अपनि खानेरी चीज़ां अकोट्ठी केरतिन;<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />चट्टानी बिज्जू<note caller="+" style="f"><char style="fr" closed="false">30:26 </char><char style="fq" closed="false">चट्टानी बिज्जू </char><char style="ft" closed="false">ई जीप खरगोशेरो ज़ेरो भोते</char></note> कमज़ोर भोतन,</para>
  <para style="q" vid="PRO 30:26">पन फिर भी तैन केरि कुढां पहाड़न पुड़ भोतिन;<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />टिट्टां केरो राज़ो त न भोए,</para>
  <para style="q" vid="PRO 30:27">फिर भी तैना सब जथो बनेई-बनेइतां च़लतन;<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />ते छिपकली<note caller="+" style="f"><char style="fr" closed="false">30:28 </char><char style="fq" closed="false">छिपकली </char><char style="ft" closed="false">या गरज़ार</char></note> हथ्थे सेइं ट्लाई त गातीए,</para>
  <para style="q" vid="PRO 30:28">फिर भी राज़ भवनन मां रहतीए।<verse eid="PRO 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29" />ट्लाई खूबसूरत च़लनेबाले प्राणी आन;</para>
  <para style="q" vid="PRO 30:29">बल्के च़ेवर आन, ज़ैन केरि चाल रोड़ीए:<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />शेर ज़ै सब जानबरन मां ताकतबरे,</para>
  <para style="q" vid="PRO 30:30">ते केन्चेरे डरे करां न हटे;<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />शिकारी कुतर ते थाव्वो,</para>
  <para style="q" vid="PRO 30:31">ते अपनि सेनाई समेत राज़ो।<verse eid="PRO 30:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32" />अगर तीं अपनि बडीयाई केरनेरी बेवकूफी की,</para>
  <para style="q" vid="PRO 30:32">या कोई बुरी योजना बनेवरी भोए, त तू रुक ते सोच।<verse eid="PRO 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33" />किजोकि ज़ेन्च़रे दुद्ध दाड़ने सेइं मखन निसतीए,</para>
  <para style="q" vid="PRO 30:33">ते नक मरोड़ने सेइं खून निसते,</para>
  <para style="q" vid="PRO 30:33">तेरही सरकरे भड़काने सेइं लड़ाई पैदा भोतीए।<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">राज़े सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />लमूएल राज़ेरे प्रभाव केरनेबाले वचन, ज़ैना तैसेरी अम्मा तैस शिखाले।<verse eid="PRO 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2" />हे मेरे मट्ठा, हे मेरे अपने मट्ठा!</para>
  <para style="q" vid="PRO 31:2">हे मेरी मिन्नतां कियोरे मट्ठा!<verse eid="PRO 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3" />अपनि ताकत कौन्शन न दे,</para>
  <para style="q" vid="PRO 31:3">न अपनि ज़िन्दगी तैन केरे कैबू मां केर ज़ैना राज़न बरबाद केरतिन।<verse eid="PRO 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4" />हे लमूएल, राज़न दाछ़रो रस पीनो शोभा न दे,</para>
  <para style="q" vid="PRO 31:4">ते शराब चानी, रईस लोकन न शोभे;<verse eid="PRO 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5" />एरू न भोए कि तैना पीतां कानूने बिसरन</para>
  <para style="q" vid="PRO 31:5">ते कोन्ची दुखी मैन्हेरे हक्‍के मारन।<verse eid="PRO 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6" />शराब तैस पियाथ ज़ै मरने पुड़े,</para>
  <para style="q" vid="PRO 31:6">ते दाछ़रो रस परेशान मने बाले देनो;<verse eid="PRO 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7" />ज़ैस सेइं तैना पीतां अपनि गरीबी बिसरन</para>
  <para style="q" vid="PRO 31:7">ते अपने सकत मेहनती फिरी याद न केरन।<verse eid="PRO 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8" />तैन केरे लेई ज़ो ज़ैना अपने लेई न ज़ोइ सकन,</para>
  <para style="q" vid="PRO 31:8">ते सब अनाथां केरो न्याय जाइज़ तरीके सेइं केर।<verse eid="PRO 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9" />अपनु आशी खोल्‍ल ते धार्मिकताई सेइं न्याय केर,</para>
  <para style="q" vid="PRO 31:9">ज़रूरतमन्द ते गरीबां केरो न्याय केर।<verse eid="PRO 31:9" /></para>
  <para style="s">रोड़े चाल चलने बाली कौन्श</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10" />भली कौन्श कौन हासिल केरि सकते?</para>
  <para style="q" vid="PRO 31:10">किजोकि तैसेरी कीमत हीरे मोतन करां भी बड़ी जादे भोतीए।<verse eid="PRO 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11" />तैसेरे मुन्शेरे मने मां तैसेरेलेइ विश्वासे,</para>
  <para style="q" vid="PRO 31:11">ते तै कधी गरीब न भोल्हो।<verse eid="PRO 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12" />तै अपने ज़िन्दगरे सारे दिहाड़न मां तैस सेइं बुरो नईं,</para>
  <para style="q" vid="PRO 31:12">बल्के भलो सलूख केरतीए।<verse eid="PRO 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13" />तै उन ते सन तोप्पी-तोप्पी,</para>
  <para style="q" vid="PRO 31:13">अपने हथ्थन सेइं खुशी सेइं कम केरतीए।<verse eid="PRO 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14" />तै बुपारेरे ज़िहाज़ां केरे ज़ेरे अपनि खानेरी चीज़ां दूरेरां मगातीए।<verse eid="PRO 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15" />तै झ़ेझ़ां सुबेले उठतीए,</para>
  <para style="q" vid="PRO 31:15">ते अपने टब्बरे रोट्टी खुवातीए</para>
  <para style="q" vid="PRO 31:15">ते अपनि दैसन अलग-अलग कम देतीए।<verse eid="PRO 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16" />तै कोन्ची उडारेरे बारे मां सोच विचार केरतीए</para>
  <para style="q" vid="PRO 31:16">ते तैस घिन्नतीए; ते अपने मेहनतरे फले सेइं दाछ़री बाग लातीए।<verse eid="PRO 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17" />तै अपनि कमर ज़ोरे सेइं कसतीए,</para>
  <para style="q" vid="PRO 31:17">ते अपने पैखड़न मज़बूत बनातीए।<verse eid="PRO 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18" />तै परखतीए कि मेरो बुपार फैइदेरोए।</para>
  <para style="q" vid="PRO 31:18">राती तैसेरो दीयो न हिश्शे।<note caller="+" style="f"><char style="fr" closed="false">31:18 </char><char style="fq" closed="false">राती तैसेरो दीयो न हिश्शे </char><char style="ft" closed="false">तै राती च़िरे तगर कम केरतीए</char></note><verse eid="PRO 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19" />तै अटेरने मां हथ लातीए,</para>
  <para style="q" vid="PRO 31:19">ते जंट्ल ट्लेइतां तैस च़लातीए।<verse eid="PRO 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20" />तै गरीबेरे लेई मुठड़ी खोल्‍लतीए,</para>
  <para style="q" vid="PRO 31:20">ते गरीबे सम्भालनेरे लेई हथ अग्रोवं केरतीए।<verse eid="PRO 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21" />तै अपने घरानेरे लेई हिंवे करां न डरे,</para>
  <para style="q" vid="PRO 31:21">किजोकि तैसेरे घरेरे सब लोक लाल लिगड़ां लातन।<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />तै च़ादर बनातीए;</para>
  <para style="q" vid="PRO 31:22">तैसेरे लिगड़ां सूक्ष्म सन ते बैंगनी रंगेरां भोतन।<verse eid="PRO 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23" />ज़ैखन तैसारो मुन्श सभाई मां नगरेरे बुज़ुर्गन सेइं साथी बिशते,<note caller="+" style="f"><char style="fr" closed="false">31:23 </char><char style="fq" closed="false">साथी बिशते </char><char style="ft" closed="false">गलबात केरने फैसलेरे लेई बिशते</char></note></para>
  <para style="q" vid="PRO 31:23">तैखन तैसेरी आदर भोतीए।<verse eid="PRO 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24" />तै सनेरां लिगड़ां बनेइतां बेच़तीए;</para>
  <para style="q" vid="PRO 31:24">ते बुपैरी कमरबन्ध देतीए।<verse eid="PRO 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25" />तै ताकत ते इज़्ज़तरू लान लातीए,</para>
  <para style="q" vid="PRO 31:25">ते एजने बाले कालेरे बारे मां हसतीए।<verse eid="PRO 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26" />तै अक्लरी गल ज़ोतीए,</para>
  <para style="q" vid="PRO 31:26">ते तैसेरी गल्‍लां दयारी शिक्षारे मुताबिक भोतिन।<verse eid="PRO 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27" />तै अपने घरानेरे चाल च़लने ध्याने सेइं हेरतीए,</para>
  <para style="q" vid="PRO 31:27">ते अपनि रोट्टी बगैर मेहनतां न खाए।<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />तैसेरे बच्‍चे उठी-उठी तैस धन ज़ोतन,</para>
  <para style="q" vid="PRO 31:28">तैसेरो मुन्श भी उठतां तैसेरी एरी तारीफ़ केरते:<verse eid="PRO 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29" />“बड़े कौन्शेइं रोड़ां-रोड़ां कम्मां त कियोरन पन तू तैन सेब्भन मां रोड़ी आस।”<verse eid="PRO 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30" />शोभा त झूठी ते खूबसूरती बेकारे,</para>
  <para style="q" vid="PRO 31:30">पन ज़ै कौन्श यहोवारो डर मन्नतीए, तैसेरी तारीफ़ की गाली।<verse eid="PRO 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31" />तैसेरे हथ्थां केरि मेहनतरो फल तैस देथ,</para>
  <para style="q" vid="PRO 31:31">ते तैसेरे कम्मन सेइं सभाई मां तैसेरी तारीफ़ भोल्ही।<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>