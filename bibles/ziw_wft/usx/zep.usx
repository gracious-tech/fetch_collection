<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Zigua Bible Version</book>
  <para style="toc3">Zef</para>
  <para style="toc2">Zefania</para>
  <para style="toc1">Chitabu cha Zefania</para>
  <para style="mt2">Chitabu cha</para>
  <para style="mt1">Zefania</para>
  <para style="imt">Ulongozi</para>
  <para style="ip">Zefania atambalisaga ulosi wa Chohile uko kwe isi ya Yudam mwe mihilimo ya 640 na 620 Kulisito henati kwelekwa mo ulongozi wa seuta Yosia wa Yuda mwe mihilimo ya 640 kubula 609 Kulisito henati kwelekwa. Mbuli nkulu mo utambalisi wakwe nikugamba Chohile nawakantile wantu wa Yuda na Yelusalemu kwaviya wasankanila milungu yo udanti. Chipindi icho akunga awakantile nicho chipindi chikutajwa, Zuwa dya Zumbe Chohile. Hata wantu we izisi zimjihi ne isi ya Yuda iviya nawo nawakantilwe. Mna mwa amazuwa yakwiza wekazi wa Yelusalemu nawamsankanile Chohile na uyo Chohile nawajimbike vituhu awantu wakwe.</para>
  <para style="iot">Yemndani</para>
  <para style="io1">1. Zuwa dya nkanto ya Zumbe, sula 1</para>
  <para style="io1">2. Uchindedi wa nkanto, sula 2</para>
  <para style="io1">3. Nkanto mwa Yelusalemu, sula 3:1-7</para>
  <para style="io1">4. Lagano dya wambulwa kwa wadya wakweila, sula 3:8-20.</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />Uno ni ulosi wa Zumbe Chohile umwizile Zefania mwana ywa Kushi, ise dya Kushi ni Gedaliya na Gedaliya ise ni Amaliya, na Amaliya ise ni Hezekiya, umo Yosiya mwana ywa Amoni endaga seuta ywa Yuda.<verse eid="ZEP 1:1" /></para>
  <para style="s">Zuwa dya nkanto ya Zumbe Chohile</para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 1:2" />Zumbe Chohile agamba,</para>
  <para style="q" vid="ZEP 1:2">“Nanivikome vyumbe vyose mweisi,<verse eid="ZEP 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 1:3" />wantu na wanyama,</para>
  <para style="q" vid="ZEP 1:3">na wadege na samaki zikwikala mwe bahali,</para>
  <para style="q" vid="ZEP 1:3">nanikome chila chintu.</para>
  <para style="q" vid="ZEP 1:3">Wantu wavu naniwabinde pele,</para>
  <para style="q" vid="ZEP 1:3">wantu naniwabinde pele mweisi.”<verse eid="ZEP 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 1:4" />Wantu wose wakwikala kweisi ya Yuda,</para>
  <para style="q" vid="ZEP 1:4">naniwakantile na wose wakwikala komzi wa Yelusalemu.</para>
  <para style="q" vid="ZEP 1:4">Nanibalange vyose visigale vya kumvikila Baali kulawa muno mwe isi,</para>
  <para style="q" vid="ZEP 1:4">hahana namanye idizina dyawo.<verse eid="ZEP 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 1:5" />Naniwakome wadya wose wakuvika kulanga kwe dihala</para>
  <para style="q" vid="ZEP 1:5">wakavikla vintu vya mo ulanga.</para>
  <para style="q" vid="ZEP 1:5">Naniwakome wadya wakunivikila,</para>
  <para style="q" vid="ZEP 1:5">na kwelisa kwa zina dyangu,</para>
  <para style="q" vid="ZEP 1:5">mna iviya welisa kwa zina dya mnungu Mikomu.<verse eid="ZEP 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 1:6" />Naniwakome wadya wose wanasize miye Zumbe Chohile,</para>
  <para style="q" vid="ZEP 1:6">na wose walekile kunilonda na kunuza ulangilizi.<verse eid="ZEP 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 1:7" />Nyamalani kulongozi kwa Zumbe Chohile,</para>
  <para style="q" vid="ZEP 1:7">kwaviya zuwa dya Zumbe Chohile dihajihi.</para>
  <para style="q" vid="ZEP 1:7">Zumbe Chohile kamalanya ntambiko,</para>
  <para style="q" vid="ZEP 1:7">wadya agoneke kawasagula.<verse eid="ZEP 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 1:8" />Zumbe Chohile agamba,</para>
  <para style="q" vid="ZEP 1:8">“Mwe idizuwa idyo dya Zumbe Chohile dyo kuwalekela wankondo wawakome wantu wakwe,</para>
  <para style="q" vid="ZEP 1:8">vilongozi wa awantu awo naniwakantile,</para>
  <para style="q" vid="ZEP 1:8">iviya wana wa seuta,</para>
  <para style="q" vid="ZEP 1:8">hamwenga na wose wakutimiliza mazwela ya chijeni.<verse eid="ZEP 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 1:9" />Idizuwa idyo naniwakantile wose,</para>
  <para style="q" vid="ZEP 1:9">wakudalika chifigwe che Inyumba enga wantu hewekuvika mviko wa chindedi,</para>
  <para style="q" vid="ZEP 1:9">wakumemeza inyumba ya sekulu ywawo vintu vya kubunyanya na ubavi.”<verse eid="ZEP 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 1:10" />Iviya Zumbe Chohile agamba, “Mwe idizuwa idyo ndilo naivike kulawa kwe Inchili yo mzi ikwitangwa Samaki,</para>
  <para style="q" vid="ZEP 1:10">malombolezo kulawa mkwe kaya ya kaidi,</para>
  <para style="q" vid="ZEP 1:10">na sindo nkulu kulawa kwa wagulu.<verse eid="ZEP 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 1:11" />Lombolezani nyuwe wekazi wa kwamagwilo,</para>
  <para style="q" vid="ZEP 1:11">wachuluzi wenyu wose wakomwa,</para>
  <para style="q" vid="ZEP 1:11">wose wakudamanya mayombe ya chumbu wakomwa.<verse eid="ZEP 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 1:12" />Chipindi icho nanimulike kwa taa umzi wa Yelusalemu,</para>
  <para style="q" vid="ZEP 1:12">na kuwakantila wadya wakwikala watongomala uge masimbi ya divai,</para>
  <para style="q" vid="ZEP 1:12">wose wakwelongela mwe myoyo yawo, ‘Zumbe Chohile hadamanye chintu chochose, chedi hegu chihiye.’<verse eid="ZEP 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 1:13" />Ugoli wawo nauguhigwe,</para>
  <para style="q" vid="ZEP 1:13">izinyumba zawo nazisigwe zibule!</para>
  <para style="q" vid="ZEP 1:13">Nawazenge nyumba mna hawazikale.</para>
  <para style="q" vid="ZEP 1:13">Nawahande mizabibu mna idivai yakwe hawainywe.”<verse eid="ZEP 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 1:14" />Idizuwa kulu dya Zumbe Chohile dihajihi,</para>
  <para style="q" vid="ZEP 1:14">dibula dyagulukisa kwiza.</para>
  <para style="q" vid="ZEP 1:14">Mwilo we idizuwa dya Zumbe Chohile ni wo usungu,</para>
  <para style="q" vid="ZEP 1:14">hata mkankalu aneva umwilo uwo naile kwa izwi.<verse eid="ZEP 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 1:15" />Zuwa idyo naditende dya maya,</para>
  <para style="q" vid="ZEP 1:15">zuwa dya nkunto na usungu,</para>
  <para style="q" vid="ZEP 1:15">zuwa dya chiza na chinyulu,</para>
  <para style="q" vid="ZEP 1:15">zuwa dyo ubanasi na nkomano,</para>
  <para style="q" vid="ZEP 1:15">zuwa dya maingu na ziza,<verse eid="ZEP 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 1:16" />zuwa dya mwilo wa magunda na maizwi ya nkondo,</para>
  <para style="q" vid="ZEP 1:16">mwe mizi izengelwe ngome na viwambaza vitali.<verse eid="ZEP 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 1:17" />Naniwegaile wantu nkunto,</para>
  <para style="q" vid="ZEP 1:17">awo nawajende enga matuntu,</para>
  <para style="q" vid="ZEP 1:17">kwaviya wakola masa kwa Zumbe Chohile.</para>
  <para style="q" vid="ZEP 1:17">Sakame yawo naitilwe mwe sanga enga mazi,</para>
  <para style="q" vid="ZEP 1:17">vimba vyawo navyumbale mwe sanga uge ntagata.<verse eid="ZEP 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 1:18" />Chumbu chawo hegu zahabu yawo havidahe kuwambula, mwe idizuwa idyo dya amaya ya Zumbe Chohile.</para>
  <para style="q" vid="ZEP 1:18">Isi yose naikantile kwa moto wa maya yakwe.</para>
  <para style="q" vid="ZEP 1:18">Kwa ujejeje na vikutisa nawatende awekazi wose mweisi wosike.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s">Mwitango wa kweila</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 2:1" />Nyuwe wantu wa Yuda hemwine soni,</para>
  <para style="q" vid="ZEP 2:1">chisanyikani hamwenga,<verse eid="ZEP 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 2:2" />umo hemwinati kufilisizwa hale enga makanka,</para>
  <para style="q" vid="ZEP 2:2">hedinati kuwezilani zuwa dya maya ya Zumbe Chohile,</para>
  <para style="q" vid="ZEP 2:2">hedinati kuwezilani zuwa dyo kwihiwa dya Zumbe Chohile.<verse eid="ZEP 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 2:3" />Mlondeni Zumbe Chohile nyuwe nyose mkunyanyahala mwe isi,</para>
  <para style="q" vid="ZEP 2:3">nyuwe mkutimila miko yakwe.</para>
  <para style="q" vid="ZEP 2:3">Londani ukanuni,</para>
  <para style="q" vid="ZEP 2:3">londani uwagila,</para>
  <para style="q" vid="ZEP 2:3">mafani namdyenege idizuwa dya amaya ya Zumbe Chohile.<verse eid="ZEP 2:3" /></para>
  <para style="s">Nawaluwone wantu we izisi zihajihi na Izulaeli</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 2:4" />Umo Zumbe Chohile akawakantila Wafilisiti wantu wakwikala</para>
  <para style="q" vid="ZEP 2:4">komzi wa Gaza nawausame,</para>
  <para style="q" vid="ZEP 2:4">umzi wa Ashikeloni nautende wibule.</para>
  <para style="q" vid="ZEP 2:4">Wekazi wa Ashidodi nawatimulaganywe nomsi,</para>
  <para style="q" vid="ZEP 2:4">na awekazi wa Ekiloni nawang'olwe.<verse eid="ZEP 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 2:5" />Namluwone nyuwe wantu we izisi za mpwani,</para>
  <para style="q" vid="ZEP 2:5">wantu mkwikala uko Kilete!</para>
  <para style="q" vid="ZEP 2:5">Zumbe Chohile kalonga alanga nyuwe,</para>
  <para style="q" vid="ZEP 2:5">wekazi wa Kanaani mweisi ya Wafilisiti.</para>
  <para style="q" vid="ZEP 2:5">Miye naniwakome asekusigala hata mntu yumwenga.<verse eid="ZEP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 2:6" />Izisi mpezo mwe ibahali, hantu wakwikala Wakeleti,</para>
  <para style="q" vid="ZEP 2:6">nahatende ni hantu ha wadimi na madewa ya ngoto.<verse eid="ZEP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 2:7" />Isi ya mpwani naitende ni ya wantu wasigale wo lukolo lwa Yuda.</para>
  <para style="q" vid="ZEP 2:7">Ludimo lwawo nawadimile uko.</para>
  <para style="q" vid="ZEP 2:7">Izinyumba zo umzi wa Ashikeloni nazitende ni hantu hawo ha kugona.</para>
  <para style="q" vid="ZEP 2:7">Kwaviya Zumbe Chohile ywawo nawakumbuke na kuwatenda wachumilwe vituhu.<verse eid="ZEP 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 2:8" />Zumbe Chohile agamba, “Amahuluto ya Wamoabu siyeva,</para>
  <para style="q" vid="ZEP 2:8">na utilizi wa wantu wa Amoni siwiva, awo wawahuluta wantu wangu,</para>
  <para style="q" vid="ZEP 2:8">na kuwatisa mwe isi yawo.<verse eid="ZEP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 2:9" />Elo, seivyo hwikala miye Zumbe Chohile mta nguvu zose,</para>
  <para style="q" vid="ZEP 2:9">Chohile ywa Izulaeli,</para>
  <para style="q" vid="ZEP 2:9">isi ya Moabu naitende enga umzi wa Sodoma,</para>
  <para style="q" vid="ZEP 2:9">na isi ya Amoni naitende enga umzi wa Gomola.</para>
  <para style="q" vid="ZEP 2:9">Izisi zakwe nazitende za viwave na mabome ya munyu,</para>
  <para style="q" vid="ZEP 2:9">nazitende mahame kale na kale,</para>
  <para style="q" vid="ZEP 2:9">wantu wangu nawasigale nawazitahe izisi izo.”<verse eid="ZEP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 2:10" />Ayo nayatende ni maliho yo kweduvya kwawo,</para>
  <para style="q" vid="ZEP 2:10">kwaviya nawawahuluta na kuwatila,</para>
  <para style="q" vid="ZEP 2:10">wantu wa Zumbe Chohile mta nguvu zose.<verse eid="ZEP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 2:11" />Zumbe Chohile natende ywa kutisa mwawo,</para>
  <para style="q" vid="ZEP 2:11">nabalange imilungu yose mwe izisi.</para>
  <para style="q" vid="ZEP 2:11">Wantu mwe izisi zose nawamvikile,</para>
  <para style="q" vid="ZEP 2:11">chila si mwe hantu hakwe.<verse eid="ZEP 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 2:12" />Iviya Zumbe Chohile nawakome wantu we isi ya Kushi, vino dyelo yetangwa Isiopia,</para>
  <para style="q" vid="ZEP 2:12">kwa bamba dyakwe.<verse eid="ZEP 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 2:13" />Zumbe Chohile najeseze nguvu zakwe kuikantila isi ya Siliya</para>
  <para style="q" vid="ZEP 2:13">iviya naubalange umzi wa Ninawi, uwo naunyalise enga jangwa.<verse eid="ZEP 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 2:14" />Mafyo ya ludimo nayagone umo,</para>
  <para style="q" vid="ZEP 2:14">Iviya na chila mnyama ywa kumbago.</para>
  <para style="q" vid="ZEP 2:14">Magushu na mayange yange na mizinge nawekale mwe izinguzo zakwe,</para>
  <para style="q" vid="ZEP 2:14">makungwi nayaile mwa madilisha yakwe, makungulu nayaile mwe vifigwe,</para>
  <para style="q" vid="ZEP 2:14">kwaviya nyumba zakwe zizengigwe kwa miti ya mielezi nazitende zibule.<verse eid="ZEP 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 2:15" />Vino nivyo naviulaile uno naukeduvya na kwikala mpeho,</para>
  <para style="q" vid="ZEP 2:15">wekazi wakwe nawakafanyanya umzi wawo ni mkulu kujinka yose mwe izisi zose.</para>
  <para style="q" vid="ZEP 2:15">Kaulani ivyo wibule na wikazi wa wanyama wa kumbago! Chila yumwenga akujinka hajihi nauzome na kuubela.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s">Nkanto yo umzi wa Yelusalemu</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEP 3:1" />Mbuli zihiye naziulaile umzi wa Yelusalemu namluwone,</para>
  <para style="q" vid="ZEP 3:1">wantu wakwe wamhituka Zumbe Chohile,</para>
  <para style="q" vid="ZEP 3:1">wekazi wakwe wamhituka</para>
  <para style="q" vid="ZEP 3:1">naho hawakuzumilika mo kumvikila Chohile,</para>
  <para style="q" vid="ZEP 3:1">wongisa kuwadamanyiza unyakwili wantu watuhu.<verse eid="ZEP 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 3:2" />Hakwetegeleza dya mntu yoyose,</para>
  <para style="q" vid="ZEP 3:2">hukuzumila malangilizo.</para>
  <para style="q" vid="ZEP 3:2">Hukumwikiya msuhi Zumbe Chohile,</para>
  <para style="q" vid="ZEP 3:2">haukusogela hajihi na Chohile ywakwe.<verse eid="ZEP 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 3:3" />Masekulu wakwe ni saviya simba zikubuma,</para>
  <para style="q" vid="ZEP 3:3">wakanti wakwe wesaviya mauzi yana sala ya chisingi,</para>
  <para style="q" vid="ZEP 3:3">ayo heyekusigaza chintu kwachausa cha luvi mtondo.<verse eid="ZEP 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 3:4" />Wawoni wakwe weduvya,</para>
  <para style="q" vid="ZEP 3:4">naho ni wadanti.</para>
  <para style="q" vid="ZEP 3:4">Walavyantambiko wakwe wavitenda vintu vikukile visekuzumilika kuvikila,</para>
  <para style="q" vid="ZEP 3:4">na kuibalanga isigilizi.<verse eid="ZEP 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 3:5" />Mna Zumbe Chohile achei eyumo mo umzi uwo, uyo ni mkanuni,</para>
  <para style="q" vid="ZEP 3:5">uyo hakutenda mbuli yoyose ihiye.</para>
  <para style="q" vid="ZEP 3:5">Chila zuwa mtondo alagisa uwagila wakwe,</para>
  <para style="q" vid="ZEP 3:5">chila kukacha achintiza,</para>
  <para style="q" vid="ZEP 3:5">mna wantu manyakwili hawana soni.<verse eid="ZEP 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 3:6" />Zumbe Chohile agamba,</para>
  <para style="q" vid="ZEP 3:6">“Awantu wose mwe izisi siwakoma pele,</para>
  <para style="q" vid="ZEP 3:6">iviwambaza vyawo vya kuwafinga sizibogozola,</para>
  <para style="q" vid="ZEP 3:6">sila zawo sizibalanga,</para>
  <para style="q" vid="ZEP 3:6">hahana mntu akujinka umo.</para>
  <para style="q" vid="ZEP 3:6">Mizi yawo isigala ibule,</para>
  <para style="q" vid="ZEP 3:6">hahana hata yumwenga nasigale.<verse eid="ZEP 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 3:7" />Nalonganga kugamba wekazi wa uno umzi nawanivikile,</para>
  <para style="q" vid="ZEP 3:7">na kuyazumila amalangilizo yangu,</para>
  <para style="q" vid="ZEP 3:7">hawaleke kukumbuka nkanana zose izo niwakantile.</para>
  <para style="q" vid="ZEP 3:7">Mna wantu awo wajendeleza nkwina zawo zo kudamanya mbuli za wavu.”<verse eid="ZEP 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 3:8" />Zumbe Chohile agamba, “Nigojani miye mwe idizuwa nanichimale nilavye nkanto.</para>
  <para style="q" vid="ZEP 3:8">Sekamba kuwachisanya wantu mwe izisi zose ne iziseuta,</para>
  <para style="q" vid="ZEP 3:8">vileke niwakantile kwa maya yangu yatendese,</para>
  <para style="q" vid="ZEP 3:8">iviya no ukali wo kwihiwa kwangu.</para>
  <para style="q" vid="ZEP 3:8">Si yose naitikimye moto kwa maya yangu.”<verse eid="ZEP 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 3:9" />“Vikaheza ivyo, nanihose wantu mwe izisi zose wahitukile,</para>
  <para style="q" vid="ZEP 3:9">vileke wanivikile miye du,</para>
  <para style="q" vid="ZEP 3:9">waleke kuvikila milungu,</para>
  <para style="q" vid="ZEP 3:9">na kunisankanila miye kwa moyo wose.<verse eid="ZEP 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 3:10" />Kulawa ntendele ya kaidi ye imito ya kushi,</para>
  <para style="q" vid="ZEP 3:10">wantu wangu wamwaganikane wakunilombeza,</para>
  <para style="q" vid="ZEP 3:10">nawalete malavyo yawo kwangu miye.<verse eid="ZEP 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 3:11" />Mwe idizuwa idyo howene soni,</para>
  <para style="q" vid="ZEP 3:11">kwa chausa che izintendwa zako zo kunihituka,</para>
  <para style="q" vid="ZEP 3:11">kwaviya naniwause mwako wadya wakweduvya na kwefutula,</para>
  <para style="q" vid="ZEP 3:11">weye howeduvye vituhu mo lugulu lwangu lukukile.<verse eid="ZEP 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 3:12" />Nahwasize wantu wakwiva na kunyanyahala,</para>
  <para style="q" vid="ZEP 3:12">awo nawasumkile ugombezi kwangu miye Zumbe Chohile.<verse eid="ZEP 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 3:13" />Waizulaeli wose nawasigale, hawadamanye mbuli zihiye,</para>
  <para style="q" vid="ZEP 3:13">hegu kulonga udanti,</para>
  <para style="q" vid="ZEP 3:13">mwa awantu wose hahatenda na yumwe akudanta.</para>
  <para style="q" vid="ZEP 3:13">Nawapate nkande na kugona,</para>
  <para style="q" vid="ZEP 3:13">hahatende na mntu ywa kuwatisa.”<verse eid="ZEP 3:13" /></para>
  <para style="s">Nchemo ya mbwedo</para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 3:14" />Chema kwa izwi weye Sayuni,</para>
  <para style="q" vid="ZEP 3:14">inula izwi dyako weye Izulaeli.</para>
  <para style="q" vid="ZEP 3:14">Elelwa na kuvina kwa moyo wose weye Yelusalemu!<verse eid="ZEP 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 3:15" />Zumbe Chohile kakusiza nkanto yako,</para>
  <para style="q" vid="ZEP 3:15">wankondo wako wose kawavuza kunyuma.</para>
  <para style="q" vid="ZEP 3:15">Zumbe Chohile seuta ywa Izulaeli ehamwenga na weye,</para>
  <para style="q" vid="ZEP 3:15">elo, usekutiswa ni mbuli yoyose.<verse eid="ZEP 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 3:16" />Mwe idizuwa idyo nawaugambe umzi wa Yelusalemu,</para>
  <para style="q" vid="ZEP 3:16">“Usekogoha, weye Sayuni!</para>
  <para style="q" vid="ZEP 3:16">Usekuleka imikono yako ikalegela!<verse eid="ZEP 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 3:17" />Zumbe Chohile, Chohile ywako ehamwenga na weye,</para>
  <para style="q" vid="ZEP 3:17">uyo ni mkankalu akukwinka uhuda.</para>
  <para style="q" vid="ZEP 3:17">Nakwelelwe kwa mbwedo mkulu,</para>
  <para style="q" vid="ZEP 3:17">kwa ungi wakwe nakwinke ujima mhya.</para>
  <para style="q" vid="ZEP 3:17">Nakwelelwe kwa nchemo ya izwi kulu,<verse eid="ZEP 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 3:18" />enga viya mwe zuwa dya ngasu.”</para>
  <para style="q" vid="ZEP 3:18">Zumbe Chohile agamba, “Nahusize file zako,</para>
  <para style="q" vid="ZEP 3:18">weye usekuwona soni kwachausa che izimbuli izo.<verse eid="ZEP 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEP 3:19" />Mwe ichipindi icho naniwakantile wose wakukubunyanya.</para>
  <para style="q" vid="ZEP 3:19">Waholomale naniwambule na kuwachisanya waduligwe,</para>
  <para style="q" vid="ZEP 3:19">na kuhitula soni yawo itende ntunyo,</para>
  <para style="q" vid="ZEP 3:19">na ugoli mwe isi yose.<verse eid="ZEP 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ZEP 3:20" />Mwe chipindi icho naniwachisanye,</para>
  <para style="q" vid="ZEP 3:20">na kuwatenda mmanyike na kutogolwa,</para>
  <para style="q" vid="ZEP 3:20">mgati mwa wantu we izisi zose,</para>
  <para style="q" vid="ZEP 3:20">umo naniwavuzizeni ukuchumilwa kwenyu,</para>
  <para style="q" vid="ZEP 3:20">nanywi muwone kwa meso yenyu wenye.</para>
  <para style="q" vid="ZEP 3:20">Alongile ni miye Zumbe Chohile.”<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>