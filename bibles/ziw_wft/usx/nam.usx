<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Zigua Bible Version</book>
  <para style="toc3">Nah</para>
  <para style="toc2">Nahumu</para>
  <para style="toc1">Chitabu cha Nahumu</para>
  <para style="mt2">Chitabu cha</para>
  <para style="mt1">Nahumu</para>
  <para style="imt">Ulongozi</para>
  <para style="ip">Chitabu chino chidodo chatambalisa kutikimya ko mzi wa Ninawi mzi mkulu wo ulongozi wa Ashulu. Nahumu alotela na kutambalisa vyedi vina mwile ubanasi uwo vyaleka amanyikisa mgati mwa wachemi wa mashaili mwe isi ya Izulaeli.</para>
  <para style="iot">Yemndani</para>
  <para style="io">Kugwa kwa Ninawi ni nkanto kulawa kwa Chohile uyo akuwakantila wadya wose wakuhiga viya akunga.</para>
  <para style="io">Sula ya 1:11 na sula ya 2:2.</para>
  <para style="io">Chitabu chalongesa na kuvuzagiza kugamba Zumbe Chohilee akantila ubunyanyi na unyakwili na wikazi wantu wavu.</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="s">Maya ya Chohile mo umzi wa Ninawi</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 1:1" />Miye Nahumu kulawa komzi wa Elikoshi. Uno ni ulosi wa Zumbe Chohile anilagise kuulanga umzi wa Ninawi.<verse eid="NAM 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2" />Zumbe Chohile hakunga kuwona wantu wakudamanya masa, alihiza chikoda,</para>
  <para style="q" vid="NAM 1:2">Zumbe Chohile alihiza chikoda naho ni mta maya yatendese,</para>
  <para style="q" vid="NAM 1:2">Zumbe Chohile alihiza chikoda mwa wankondo wakwe,</para>
  <para style="q" vid="NAM 1:2">emukiswa ni maya mwa wankondo wakwe.<verse eid="NAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3" />Zumbe Chohile hakusunguza kwihiwa,</para>
  <para style="q" vid="NAM 1:3">mna ni mta nguvu zitendese,</para>
  <para style="q" vid="NAM 1:3">Zumbe Chohile hajeze kuwalekeila wata mlema.</para>
  <para style="q" vid="NAM 1:3">Hantu akujinka Zumbe Chohile halaila luzimu na nkung'unto,</para>
  <para style="q" vid="NAM 1:3">amaingu ni lumbi dikutimulwa ni izinyayo zakwe.<verse eid="NAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4" />Aikwahila ibahali na kuinyaza,</para>
  <para style="q" vid="NAM 1:4">uyo anyaza imito yose.</para>
  <para style="q" vid="NAM 1:4">Inyika ya Bashani no lugulu lwa Kalimeli vyanyuluka,</para>
  <para style="q" vid="NAM 1:4">amaluwa ya Lebanoni yahugutuka.<verse eid="NAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5" />Amagulu yazingiza kulongozi kwakwe,</para>
  <para style="q" vid="NAM 1:5">awagulu walujuka, isi yazingiza kulongozi kwakwe,</para>
  <para style="q" vid="NAM 1:5">si na vyose vimndani mwakwe.<verse eid="NAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6" />Ni yuhi akudaha kuyajijimiza amaya ya Zumbe Chohile,</para>
  <para style="q" vid="NAM 1:6">ni yuhi akudaha kujijimiza ukwihiwa kwakwe?</para>
  <para style="q" vid="NAM 1:6">Emukwa ni maya yakwaka enga moto,</para>
  <para style="q" vid="NAM 1:6">hata izinyuwe azitula mabesu besu.<verse eid="NAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7" />Zumbe Chohile ni ywedi,</para>
  <para style="q" vid="NAM 1:7">uyo ni ngome ya ugombezi chipindi cha nkunto.</para>
  <para style="q" vid="NAM 1:7">Awadima wadya wakusumkila ugombezi kwakwe.<verse eid="NAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8" />Wankondo wanayebunga isi enga mabohwelo ya mazi,</para>
  <para style="q" vid="NAM 1:8">uyo awakoma,</para>
  <para style="q" vid="NAM 1:8">awatimila na kuwabalaza kubula kwe chiza.<verse eid="NAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9" />Ni mbwani mwadamanya mizungu mwa Zumbe Chohile?</para>
  <para style="q" vid="NAM 1:9">Uyo nawachindeni na kuwakoma,</para>
  <para style="q" vid="NAM 1:9">naho mhigani ywakwe hadahe kwinuka vituhu.<verse eid="NAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10" />Nawatikimye saviya kasaka ka miwa,</para>
  <para style="q" vid="NAM 1:10">saviya mani yanyaile.<verse eid="NAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 1:11" />Kwako kulawa amalanye wavu kwa Zumbe Chohile,</para>
  <para style="q" vid="NAM 1:11">adamanye mizungu yo udanti.<verse eid="NAM 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 1:12" />Zumbe Chohile awagamba awantu wakwe vino,</para>
  <para style="q" vid="NAM 1:12">“Hata hegu awantu wa Ashulu walozesa na wata nguvu,</para>
  <para style="q" vid="NAM 1:12">awo nawagwiswe na kuwakomwa.</para>
  <para style="q" vid="NAM 1:12">Hata hegu siwasulumizani nyuwe wantu wangu,</para>
  <para style="q" vid="NAM 1:12">sanijendeleze kuwasulumizani.<verse eid="NAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 1:13" />Haluse naniidumize inguvu ya wantu wa Ashulu mwenyu na kukanta iminyolo wawanyinyizeni.”<verse eid="NAM 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="NAM 1:14" />Zumbe Chohile kulagiza vino kuulanga umzi wa Ninawi, “Hopate welekwa nawajendeleze idizina dyako. Matukulu yo kusongola na ya kusana, naniyatuletule mnyumba mwe imilungu yako. Miye nahusimbile mbila yako, kwaviya weye hukuwagila mwe chintu chochose!”<verse eid="NAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 1:15" />Nyuwe wantu wa Yuda kaulani mlosi akuleta mbuli yedi eza kulawa kolugulu, mlosi akutambalisa utondowazi. Jesani izingasu zenyu, nyuwe wantu wa Yuda, chintizani izinazili zenyu, kwaviya hamwebugwe vituhu ni wantu wavu, kwaviya wabindwa pele.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">Kugwa ko umzi wa Ninawi</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 2:1" />Mta kukwebunga keza kukwebunga weye mzi wa Ninawi.</para>
  <para style="q" vid="NAM 2:1">Amila izingome zako!</para>
  <para style="q" vid="NAM 2:1">Dima izisila zako!</para>
  <para style="q" vid="NAM 2:1">Kwemalanye!</para>
  <para style="q" vid="NAM 2:1">Chisanya izinguvu zako zose!<verse eid="NAM 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 2:2" />Zumbe Chohile nawavuzize welekwa wa Yakobo ugoli wawo,</para>
  <para style="q" vid="NAM 2:2">awenka naho Waizulaeli ntunyo yawo,</para>
  <para style="q" vid="NAM 2:2">hatahegu wapolaganyi hawawasize chintu,</para>
  <para style="q" vid="NAM 2:2">hata matambi yawo ye mizabibu nendile yakantwa.<verse eid="NAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 2:3" />Nchinga za wakankalu wakwe zidunduga,</para>
  <para style="q" vid="NAM 2:3">wagomba nkondo wakwe wavala suche zinkundu guu.</para>
  <para style="q" vid="NAM 2:3">Amalingisha yawo ye izifalasi yamulika enga myali ya moto,</para>
  <para style="q" vid="NAM 2:3">yamalanywa kale vileke yebunge,</para>
  <para style="q" vid="NAM 2:3">izifalasi zawo zanyemwa nyemwa zikebunge.<verse eid="NAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 2:4" />Malingisha ya falasi yatimula nguluko mwesila,</para>
  <para style="q" vid="NAM 2:4">yaita uko na uko kwe chiwasa.</para>
  <para style="q" vid="NAM 2:4">Yamulika enga myali ya moto.</para>
  <para style="q" vid="NAM 2:4">Yagulukisa saviya lumwemwe.<verse eid="NAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 2:5" />Haluse awetanga masekulu,</para>
  <para style="q" vid="NAM 2:5">awo wekobadika umo wakambasa,</para>
  <para style="q" vid="NAM 2:5">wasunguza kwita kwe ichiwambaza wakaike ugoma.<verse eid="NAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 2:6" />Vigomo vye imito vivugulwa,</para>
  <para style="q" vid="NAM 2:6">idizumba dye chiseuta dimema nkama.<verse eid="NAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 2:7" />Umzi wimwazi pon'gono,</para>
  <para style="q" vid="NAM 2:7">wantu watahwa. Wavyele walomboleza,</para>
  <para style="q" vid="NAM 2:7">waila enga wasuwamanga,</para>
  <para style="q" vid="NAM 2:7">waketowatowa mwe ivifuwa.<verse eid="NAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 2:8" />Umzi wa Ninawi ni saviya bwawa ditulike,</para>
  <para style="q" vid="NAM 2:8">wantu wakwe wausumka.</para>
  <para style="q" vid="NAM 2:8">“Chimalani! Chimalani!” Izwi dyetanga,</para>
  <para style="q" vid="NAM 2:8">mna hahana akuya kunyuma.<verse eid="NAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 2:9" />Tahani chumbu,</para>
  <para style="q" vid="NAM 2:9">tahani zahabu,</para>
  <para style="q" vid="NAM 2:9">ihazina yakwe haina udumo!</para>
  <para style="q" vid="NAM 2:9">Umo mna chila chintu cha yombe kulu.<verse eid="NAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 2:10" />Mzi wa Ninawi ni ukomi uwodu no ubanasi!</para>
  <para style="q" vid="NAM 2:10">Wantu wafachevu, mavindi yakwahana,</para>
  <para style="q" vid="NAM 2:10">wasilwa ni nguvu!<verse eid="NAM 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 2:11" />Haluse umzi uwo wikuhi,</para>
  <para style="q" vid="NAM 2:11">uwo wendile saviya chigono cha simba?</para>
  <para style="q" vid="NAM 2:11">Hatenda zeze aho ahantu he izisimba,</para>
  <para style="q" vid="NAM 2:11">hantu ha wanasimba hendile hahana adahile kuwatusa.<verse eid="NAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 2:12" />Gosi dya simba diwatatavuila wanawe maingo yakuchinta,</para>
  <para style="q" vid="NAM 2:12">niyo dyagwilila simba mavyele maingo yawo,</para>
  <para style="q" vid="NAM 2:12">dimemeza maingo mwe ivigono vyakwe,</para>
  <para style="q" vid="NAM 2:12">wikazi wakwe dimemeza mafugunte ya nyama.<verse eid="NAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 2:13" />Kaula, miye Zumbe Chohile mta nguvu zose nanebungane na weye. Amalingisha yako yakukweswa ni falasi naniyatikimye moto, wagomba nkondo wako wabwanga naniwakome kwa bamba, ivintu utahile nanivibalange vimlawe mwe isi, izwi dya awalosi wako hadivike vituhu.<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="q">
    <verse number="1" style="v" sid="NAM 3:1" />Namluwone nyuwe wantu wo umzi wa Ninawi,</para>
  <para style="q" vid="NAM 3:1">wantu wo umzi uwo wakoma wantu,</para>
  <para style="q" vid="NAM 3:1">wamema udanti uwodu, vintu vitahigwe,</para>
  <para style="q" vid="NAM 3:1">hawakuleka kutenda na vintu vitahigwe.<verse eid="NAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2" />Tegeleza! Lwasu lwa mlugwa,</para>
  <para style="q" vid="NAM 3:2">mvumilo wa mafingili,</para>
  <para style="q" vid="NAM 3:2">sindo za falasi na mvumilo wa malingisha!<verse eid="NAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3" />Wakwela falasi webunga,</para>
  <para style="q" vid="NAM 3:3">mabamba na maguha vyapulika,</para>
  <para style="q" vid="NAM 3:3">wakomigwe hawakuwazika,</para>
  <para style="q" vid="NAM 3:3">vimba vilozesa,</para>
  <para style="q" vid="NAM 3:3">wantu wekobadika mlanga mwe vimba!<verse eid="NAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4" />Ninawi kutenda saviya mchilanga,</para>
  <para style="q" vid="NAM 3:4">kuwaluvya wantu, weye mchiche ywa usai,</para>
  <para style="q" vid="NAM 3:4">uwatendile watumwa wantu mwe izisi kwa uchilanga wako.<verse eid="NAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 3:5" />Miye Zumbe Chohile mta nguvu zose nagamba nahukantile weye Ninawi, isuche yako naniikuye kubula komtwi, vileke wantu mwe izisi wawone ulusi lwako, maseuta wawone umwazi wako.<verse eid="NAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 3:6" />Nahuduile mazala, na kukujeseza kwa ubezi, nahutende chilozo mwa wantu.<verse eid="NAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 3:7" />Vikaheza wose nawakuwone nawakusumke wakagamba, Ninawi ubogozolwa usigala mahame, ni yuhi nakulombolezeze? Ni yuhi nakuhoze?<verse eid="NAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 3:8" />Togola, weye Ninawi wi ywedi ukaleka Tebesi, mzi uzengigwe mpezo mo umto wa Naile? Tebesi nauzungulukwa ni mazi, ibahali nendile nuwo ugoma wakwe, mazi nendile nicho ichiwambaza chakwe.<verse eid="NAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 3:9" />Isi ya Kushi yendaga nguvu yakwe, iviya isi ya Misili, naho hehena udumo, wantu we isi ya Puti na Libiya wawambiza.<verse eid="NAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 3:10" />Hata ivyo nakutahigwa, wantu wakwe niyo wegalwa kousamizo. Hata awana wakwe wahondwa hondwa mwe chila mpembe ya sila, awantu wakwe wamanyikise wachuluzwa, wakulu wakwe wose wanyinywa minyolo.<verse eid="NAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 3:11" />Iviya hata weye nokolwe, nomsumke mnkondo na kujeza kwefisa.<verse eid="NAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 3:12" />Izingome zako zose ni saviya vikocha vya nkuyu, zinasingiswa zagwela mo mlomo ywa yuda akuzidya.<verse eid="NAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 3:13" />Kaula awagomba nkondo wako, awo wogoha enga wavyele. Izinyivi ze isi yako zimwazi kulongozi kwa wankondo wako, imihindo yako itikimya pele ni moto.<verse eid="NAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="NAM 3:14" />Tekani mazi mwemalanye kutandamwa, togezani izingome zenyu. Hondani ulongo kwa kuukanyagila, malanyani tanulu dya kokela matofali!<verse eid="NAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 3:15" />Mna hata uko namtikimye ni moto, namkomwe kwa mabamba, nambindwe enga hantu hadigwe ni sije.<verse eid="NAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NAM 3:16" />Wachuluzi wako nawajenyela kujinka ntondo za kulanga, mna haluse wosika saviya sije zipuluke.<verse eid="NAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NAM 3:17" />Wakulu wako ni saviya mpasi, masekulu wenga sije, chipindi cha mpeho wekala mweviwambaza, mna zuwa dikasomwela zapuluka, hahana namanye uko zitile.<verse eid="NAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NAM 3:18" />Weye seuta ywa Ashulu, wadimi wako wagona, wakutunyiswa wako wasinka. Awantu wako wamwaganikana kulanga kwa amagulu, hahana mntu ywa kuwachisanya vituhu.<verse eid="NAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NAM 3:19" />Hahana mntu ywa kukuhonya ukulumizwa kwako, nkwenje zako ni za file. Wose wakuziva izimbuli zako welelwa. Kwaviya ni yuhi enegile unyakwili wako hewine udumo?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>