<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id" />
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">श्रेष्ठगीत</para>
  <para style="toc1">श्रेष्ठगीत</para>
  <para style="toc2">श्रेष्ठगीत</para>
  <para style="toc3">श्रेष्ठ.</para>
  <para style="mt">श्रेष्ठगीत</para>
  <para style="is">लेखक</para>
  <para style="ip">श्रेष्ठगीत किताब के पैहले पद तै मिले शीर्षक सै जिस म्ह व्यक्त सै के यो गीत कौण गावै सै। “श्रेष्ठगीत जो सुलैमान का सै” (<char style="xt"><ref loc="SNG 1:1">श्रेष्ठ. 1:1</ref></char>) इस किताब के शीर्षक नै आखर म्ह राजा सुलैमान का नाम लिया क्यूँके सम्पूर्ण किताब म्ह उसके नाम का उल्‍लेख सै (<char style="xt"><ref loc="SNG 1:5">श्रेष्ठ. 1:5</ref>; <ref loc="SNG 3:7">3:7</ref>,<ref loc="SNG 3:9">9</ref>,<ref loc="SNG 3:11">11</ref>;</char> <char style="xt"><ref loc="SNG 8:11-12">8:11-12</ref></char>)।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">तकरीबन 971 - 965 ई. पू.</para>
  <para style="ip">या किताब सुलैमान नै इस्राएल पै अपणे राज्यकाल के बखत लिखी थी। विद्वान सुलैमान नै इस किताब का लेखक मान्‍नै सै के यो गीत उसके राज्यकाल के शरुआती बखत म्ह लिख्या गया था। कविता म्ह जो युवा जोश व्यक्त करया गया सै उसी भाग के कारण न्ही पर इस करकै भी के लेखक नै देश के उत्तर अर दक्षिण दोन्‍नु और की जगहां के नाम्मां का भी उल्‍लेख करया सै अर लबानोन अर मिस्र के नाम्मां की भी चर्चा करी गई सै।</para>
  <para style="is">प्रापक</para>
  <para style="ip">अविवाहित एवं विवाहित दोन्‍नु जो ब्याह के बारे म्ह सोच्‍चै सै।</para>
  <para style="is">मकसद</para>
  <para style="ip">श्रेष्ठगीत एक कविता सै जो प्रेम के सद्गुण का महिमान्वन करै सै अर स्पष्ट रूप तै ब्याह ताहीं परमेसवर का विधान मान्‍नै सै। मर्द अर बिरबान्‍नी नै ब्याह की सीमा म्ह रहणा जरूरी सै अर एक दुसरे के साथ आत्मिक, भाव प्रवण अर शारीरिक प्रेम राखणा सै।</para>
  <para style="is">खास बातें</para>
  <para style="ip">प्रेम अर ब्याह</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. दुल्हन सुलैमान के बारे म्ह सोच्‍चै सै <char style="ior"><ref loc="SNG 1:1-3:5">1:1-3:5</ref> </char></para>
  <para style="io1">2. दुल्हन मंगणी नै स्वीकार करकै ब्याह की बाट म्ह सै <char style="ior"><ref loc="SNG 3:6-5:1">3:6-5:1</ref> </char></para>
  <para style="io1">3. दुल्हन दुल्हे तै विरक्त हो जाण की कल्पना करै सै <char style="ior"><ref loc="SNG 5:2-6:3">5:2-6:3</ref></char></para>
  <para style="io1">4. दुल्हा अर दुल्हन एक दुसरे नै सराहवै सै <char style="ior"><ref loc="SNG 6:4-8:14">6:4-8:14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />श्रेष्ठगीत जो सुलैमान का सै।</para>
  <para style="s" vid="SNG 1:1">पैहला गीत</para>
  <para style="p" vid="SNG 1:1">
    <char style="k">दुल्हन</char><verse eid="SNG 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />तू अपणे मुँह के चुम्बन तै मन्‍नै चूम<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">चूम </char><char style="ft" closed="false">चूमै</char></note>!</para>
  <para style="q" vid="SNG 1:2">क्यूँके तेरा प्यार दाखमधु तै बढ़िया सै,<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />तेरे न्यारे-न्यारे इत्रां की खुशबु बढ़िया सै,</para>
  <para style="q" vid="SNG 1:3">तेरा नाम उण्डेले होए इत्र की तरियां सै,</para>
  <para style="q" vid="SNG 1:3">इस करकै सारी कुँवारी तेरे तै प्यार करै सै।<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />मन्‍नै खींच ले, हम तेरै पाच्छै भाज्जागें।</para>
  <para style="q" vid="SNG 1:4">राजा मन्‍नै अपणे महल म्ह ले आया सै।</para>
  <para style="q" vid="SNG 1:4">हम तेरे म्ह मगन अर आनन्दित होवागें,</para>
  <para style="q" vid="SNG 1:4">हम दाखमधु तै घणी तेरे प्यार की चर्चा करागें,</para>
  <para style="q" vid="SNG 1:4">वे ठीक तेरे तै प्यार करै सै।<verse eid="SNG 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />हे यरुशलेम की बेटियों,</para>
  <para style="q" vid="SNG 1:5">मै काळी तो सूं पर प्यारी सूं,</para>
  <para style="q" vid="SNG 1:5">केदार<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">केदार </char><char style="ft" closed="false">केदार अरब तै जुड़ी इस्माईली जनजातियाँ म्ह तै एक सै। (उत्पत्ति 25.13 यशा. 21:16-17; भजन 120:5) </char></note> के तम्बूआं</para>
  <para style="q" vid="SNG 1:5">अर सुलैमान के पर्दयाँ कै समान सूं।<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />मन्‍नै इस करकै ना घूरै के मै काळी सूं,</para>
  <para style="q" vid="SNG 1:6">क्यूँके मै धूप तै झुळसगी।</para>
  <para style="q" vid="SNG 1:6">मेरे सगे भाई मेरे तै खुश कोनी थे,</para>
  <para style="q" vid="SNG 1:6">उननै मेरे ताहीं अंगूर के बाग<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">अंगूर के बाग </char><char style="ft" closed="false">बिरबान्‍नी का दुख, उसका प्यार, उसकी सुन्दरता</char></note> की रुखाळण बणाया;</para>
  <para style="q" vid="SNG 1:6">पर मन्‍नै अपणे खुद के अंगूर के बाग की रुखाळ कोनी करी!<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />हे मेरे प्राणप्रिय मन्‍नै बता,</para>
  <para style="q" vid="SNG 1:7">तू अपणी भेड़-बकरियाँ नै कित्त चरावै सै,</para>
  <para style="q" vid="SNG 1:7">दोफाहरै म्ह तू उननै कित्त बिठावै सै,</para>
  <para style="q" vid="SNG 1:7">मै क्यूँ तेरे साथियाँ की भेड़-बकरियाँ कै धोरै</para>
  <para style="q" vid="SNG 1:7">घूँघट काढ़े होए भटकदी फिरुँ?</para>
  <para style="s" vid="SNG 1:7">जान तै प्यारी की बिनती</para>
  <para style="p" vid="SNG 1:7">
    <char style="k">दुल्हा</char><verse eid="SNG 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />हे बिरबानियाँ म्ह सुन्दरी, जै तू यो ना जाणदी हो</para>
  <para style="q" vid="SNG 1:8">तो भेड़-बकरियाँ के खुरां के निशान्‍नां पै चाल</para>
  <para style="q" vid="SNG 1:8">अर पाळीयाँ के तम्बूआं कै धोरै, अपणी बकरियाँ के बच्यां नै चरा।<verse eid="SNG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />हे मेरी प्यारी मन्‍नै तेरी तुलना</para>
  <para style="q" vid="SNG 1:9">फिरौन के रथां म्ह जुड़ी होई घोड़ी तै करी सै।<verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />तेरे गाल बाळां की लटां कै बीच म्ह घणे सुथरे लाग्गै सै,</para>
  <para style="q" vid="SNG 1:10">अर तेरा गळा हिरयां की लड़ियाँ कै बीच।</para>
  <para style="p" vid="SNG 1:10">
    <char style="k">दुल्हन</char><verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />हम तेरै खात्तर चाँदी के फूलदार सोन्‍ने के गहणे बणावागें।<verse eid="SNG 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />जिब राजा अपणे भोज कै बखत धोरै बैठ्या था<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">जिब राजा अपणे भोज कै बखत धोरै बैठ्या था </char><char style="ft" closed="false">पलंग पै बैठा था</char></note>,</para>
  <para style="q" vid="SNG 1:12">मेरी जटामासी की खुशबु फैल रही थी।<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />मेरा प्रेमी मेरै खात्तर लोबान की थैल्‍ली की तरियां सै,</para>
  <para style="q" vid="SNG 1:13">जो मेरी छात्तियाँ कै बीच म्ह पड़ी रहवै सै।<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />मेरा प्रेमी मेरै खात्तर मेंहदी के फूलां के गुच्छे की तरियां सै,</para>
  <para style="q" vid="SNG 1:14">जो एनगदी<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">एनगदी </char><char style="ft" closed="false">एनगदी दक्षिण-पश्चिमी तटा पै एक मरया होया सागर सै; यो एक ताजा अर इसनै उपजाऊ जमीन के रूप मै जाणे सै। क्यूँके इसमैं एक झरणे तै पाणी पड़ै सै। इसका एक मतलब प्रजनन शक्ति तै जुड़ा होया सै </char></note> के अंगूर के बाग म्ह होवै सै।</para>
  <para style="p" vid="SNG 1:14">
    <char style="k">दुल्हा</char><verse eid="SNG 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />तू सुन्दरी सै, हे मेरी प्यारी, तू सुन्दरी सै;</para>
  <para style="q" vid="SNG 1:15">तेरी आँख कबूतरी जिसी सै।</para>
  <para style="p" vid="SNG 1:15">
    <char style="k">दुल्हन</char><verse eid="SNG 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />हे मेरी प्यारी तू सुन्दर अर मनभावणी सै,</para>
  <para style="q" vid="SNG 1:16">अर म्हारा बिछोणा भी हरया-भरया सै;<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />म्हारे घर के शहतीर देवदार के सै,</para>
  <para style="q" vid="SNG 1:17">अर म्हारी छात की कड़ी सनोवर की सै।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />मै शारोन<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">शारोन </char><char style="ft" closed="false">शारोन एक जगहां का नाम सै। (यशा 35:2; 65:10)</char></note> का गुलाब</para>
  <para style="q" vid="SNG 2:1">अर घाटियाँ का सोसन फूल सूं।</para>
  <para style="p" vid="SNG 2:1">
    <char style="k">दुल्हा</char><verse eid="SNG 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />जिस तरियां सोसन फूल कटिले दरखतां कै बीच म्ह,</para>
  <para style="q" vid="SNG 2:2">उसे तरियां ए मेरी प्यारी जवान कुँवारियाँ कै बीच म्ह सै।</para>
  <para style="p" vid="SNG 2:2">
    <char style="k">दुल्हन</char><verse eid="SNG 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />जिस तरियां सेब का दरखत जंगल के दरखतां कै बीच म्ह,</para>
  <para style="q" vid="SNG 2:3">उसे तरियां मेरा प्रेमी जवानां कै बीच म्ह सै।</para>
  <para style="q" vid="SNG 2:3">मै उसकी छाया म्ह राज्जी होकै बैठगी,</para>
  <para style="q" vid="SNG 2:3">अर उसका फळ मन्‍नै खाण म्ह मिठ्ठा लाग्या।<verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />वो मन्‍नै दावत के घर म्ह ले आया,</para>
  <para style="q" vid="SNG 2:4">अर उसका जो झण्डा मेरे उप्पर लहरावै था वो प्यार था।<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />मन्‍नै किशमिश खुवाकै सम्भाळो, सेब खुवाकै ताजा करो:</para>
  <para style="q" vid="SNG 2:5">क्यूँके मै प्रेम रोगी सूं।<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />काश, उसका ओळा हाथ मेरे सिर कै तळै होन्दा,</para>
  <para style="q" vid="SNG 2:6">अर अपणे सोळे हाथ तै वो मेरा लाड-लडान्दा!<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />हे यरुशलेम की बेटियों, मै थारे तै चिकारियाँ<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">चिकारियाँ </char><char style="ft" closed="false">यो एक हिरण की परजात्ति सै</char></note></para>
  <para style="q" vid="SNG 2:7">अर मैदान की हिरणीयाँ की कसम खुवाकै कहूँ सूं,</para>
  <para style="q" vid="SNG 2:7">के जिब तक प्रेम खुद ना उठणा चावै,</para>
  <para style="q" vid="SNG 2:7">तब ताहीं उसनै ना ठाओ ना जगाओ।</para>
  <para style="s" vid="SNG 2:7">दूसरा गीत</para>
  <para style="p" vid="SNG 2:7">
    <char style="k">दुल्हन</char><verse eid="SNG 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />मेरे प्रेमी का बोल सुणाई पड़ै सै!</para>
  <para style="q" vid="SNG 2:8">देक्खो, वो पहाड़ां पै कूदता अर पहाड़ियाँ पै डाक मारदा होया आवै सै।<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />मेरा प्रेमी चिकारे या जवान हिरण की तरियां सै।</para>
  <para style="q" vid="SNG 2:9">देक्खो, वो म्हारी दीवार कै पाच्छै खड्या सै,</para>
  <para style="q" vid="SNG 2:9">अर झांकियाँ की ओड़ देक्खण लाग रह्या सै,</para>
  <para style="q" vid="SNG 2:9">अर आळियाँ म्ह तै देखण लाग रह्या सै।<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />मेरा प्रेमी मेरे तै कहवै सै,</para>
  <para style="p" vid="SNG 2:10">
    <char style="k">दुल्हा</char></para>
  <para style="q" vid="SNG 2:10">“हे मेरी प्यारी, हे मेरी सुन्दरी, खड़ी होकै चली आ;<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />क्यूँके देख, जाड्डा जान्दा रह्या,</para>
  <para style="q" vid="SNG 2:11">बारिस भी हो ली अर जान्दी रही सै।<verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />धरती पै फूल दिखाई देवै सै,</para>
  <para style="q" vid="SNG 2:12">चिड़ियाँ के गाण का बखत आ लिया सै,</para>
  <para style="q" vid="SNG 2:12">अर म्हारे देश म्ह कबूतर का बोल सुणाई देवै सै।<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />अंजीर पकण लाग्गे सै,</para>
  <para style="q" vid="SNG 2:13">अर अंगूर की बेल फूल रही सै;</para>
  <para style="q" vid="SNG 2:13">वे खुशबु देण लागरी सै।</para>
  <para style="q" vid="SNG 2:13">हे मेरी प्यारी, हे मेरी सुन्दरी, खड़ी होकै चली आ।<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />हे मेरी कबूतरी, पहाड़ की दरारां म्ह अर टील्यां के कुन्ज म्ह तेरा मुँह मन्‍नै देक्खण दे,</para>
  <para style="q" vid="SNG 2:14">तेरा बोल मन्‍नै सुणण दे,</para>
  <para style="q" vid="SNG 2:14">क्यूँके तेरा बोल मिठ्ठा, अर तेरी सूरत घणी सुथरी सै।<verse eid="SNG 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />जो छोट्टी लोमड़ी<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">लोमड़ी </char><char style="ft" closed="false">“सियार” बिरबान्‍नी के प्यार नै पाण खात्तर आदमी नै दर्शावै सै</char></note> अंगूर के बाग नै नाश करै सै, उननै पकड़ ले,</para>
  <para style="q" vid="SNG 2:15">क्यूँके म्हारे अंगूर के बाग म्ह फूल लागरे सै।”</para>
  <para style="p" vid="SNG 2:15">
    <char style="k">दुल्हन</char><verse eid="SNG 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />मेरा प्रेमी मेरा सै अर मै उसकी सूं,</para>
  <para style="q" vid="SNG 2:16">वो अपणी भेड़-बकरियाँ नै सोसन के फूलां कै बीच म्ह चरावै सै।<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />जिब तक दिन ठण्डा ना हो अर छाया लाम्बी आन्दे‌-आन्दे मिट ना जावै,</para>
  <para style="q" vid="SNG 2:17">तब ताहीं हे मेरे प्रेमी उस चिकारे या जवान हिरण की तरियां बण</para>
  <para style="q" vid="SNG 2:17">जो बेतेर के पहाड़ां पै फिरै सै।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="s">बेचैन्‍नी आळी रात</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />रात के बखत मै अपणे पलंग पै अपणे प्राणप्रिय नै टोह्न्दी रही;</para>
  <para style="q" vid="SNG 3:1">मै उस ताहीं</para>
  <para style="q" vid="SNG 3:1">टोह्न्दी तो रही, पर उस ताहीं ना पाया,<verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />“मन्‍नै कह्या, मै इब खड़ी होकै नगर म्ह,</para>
  <para style="q" vid="SNG 3:2">अर सड़कां अर चौकां म्ह घूमकै प्राणप्रिय नै टोह्ऊँगी।”</para>
  <para style="q" vid="SNG 3:2">मै उस ताहीं टोह्न्दी तो रही, पर उस ताहीं न्ही पाया।<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />जो पहरेदार नगर म्ह घूम्मै थे, वे मन्‍नै मिले,</para>
  <para style="q" vid="SNG 3:3">मन्‍नै उनतै पूछ्या, “के थमनै मेरे प्राणप्रिय ताहीं देख्या सै?”<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />मन्‍नै उनकै धोरै तै आग्गै बढ़े होए थोड़ी-ए देर होई थी,</para>
  <para style="q" vid="SNG 3:4">के मेरा प्राणप्रिय मन्‍नै मिलग्या।</para>
  <para style="q" vid="SNG 3:4">मन्‍नै उस ताहीं पकड़ लिया, अर उस ताहीं जाण न्ही दिया</para>
  <para style="q" vid="SNG 3:4">जिब तक उस ताहीं अपणी माँ के घर यानी अपणी जाम्मण आळी की कोठड़ी म्ह ना ले आई।<verse eid="SNG 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />हे यरुशलेम की बेटियों, मै थारे तै चिकारियाँ</para>
  <para style="q" vid="SNG 3:5">अर मैदान की हिरणीयाँ की कसम, खुवाकै कहूँ सूं,</para>
  <para style="q" vid="SNG 3:5">के जिब तक प्यार आप तै ना जाग्गै,</para>
  <para style="q" vid="SNG 3:5">तब तक उस ताहीं ना उकसाओ अर ना जगाओ।</para>
  <para style="s" vid="SNG 3:5">तीसरा गीत</para>
  <para style="p" vid="SNG 3:5">
    <char style="k">दुल्हन</char><verse eid="SNG 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="SNG 3:6" />यो के सै जो धुम्मै के खम्भे की तरियां,</para>
  <para style="q" vid="SNG 3:6">गन्धरस अर लोबान तै खुशबुदार,</para>
  <para style="q" vid="SNG 3:6">अर व्यापारी के सारी ढाळ का लेप लगाऐ होए</para>
  <para style="q" vid="SNG 3:6">जंगल तै लिकड्या आवै सै?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />देक्खो, या सुलैमान की पालकी सै!</para>
  <para style="q" vid="SNG 3:7">उसके च्यांरु ओड़ इस्राएल के शूरवीरां म्ह तै साठ वीर सै।<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />वे सारे के सारे तलवार टांगण आळे अर युद्ध विद्या म्ह माहिर सै।</para>
  <para style="q" vid="SNG 3:8">हरेक माणस रात के हमले के डर तै जाँघ पै तलवार लटकाए रहवै सै।<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />सुलैमान राजा नै अपणे खात्तर लबानोन के काठ की एक बड़ी पालकी बणवा ली।<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />उसनै उसके खम्भे चाँदी के,</para>
  <para style="q" vid="SNG 3:10">उसका सिरहाणा सोन्‍ने का, अर गद्दी बैंगणी रंग की बणवाई सै,</para>
  <para style="q" vid="SNG 3:10">अर उसके भित्तरले हिस्से ताहीं</para>
  <para style="q" vid="SNG 3:10">यरुशलेम की बेटियाँ की ओड़ तै बड़े</para>
  <para style="q" vid="SNG 3:10">प्यार तै जड़या गया सै।<verse eid="SNG 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />हे सिय्योन की बिरबानियों लिकड़कै सुलैमान राजा पै निगांह करो,</para>
  <para style="q" vid="SNG 3:11">देक्खो, वो वोए मुकुट पैहरे होए सै</para>
  <para style="q" vid="SNG 3:11">जिस ताहीं उसकी माँ नै उसके ब्याह के</para>
  <para style="q" vid="SNG 3:11">दिन अर उसके मन के आनन्द कै दिन, उसके सिर पै धरया था।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="p">
    <char style="k">दुल्हा</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />हे मेरी प्यारी तू सुन्दर सै, तू सुन्दर सै!</para>
  <para style="q" vid="SNG 4:1">तेरी आँख तेरी लटां कै बीच म्ह कबूतरां</para>
  <para style="q" vid="SNG 4:1">की तरियां दिखाई देवै सै।</para>
  <para style="q" vid="SNG 4:1">तेरे बाळ उन बकरियाँ के झुण्ड की तरियां सै</para>
  <para style="q" vid="SNG 4:1">जो गिलाद पहाड़ की ढळाण पै लेट्टी होई हो।<verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />तेरे दाँन्त ऊन कतरी होई उन भेड्डां के झुण्ड की तरियां सै,</para>
  <para style="q" vid="SNG 4:2">जो नाह्के उप्पर आई हो, उन म्ह तै हर एक के दो-दो जुड़मा बच्‍चें होवै सै।</para>
  <para style="q" vid="SNG 4:2">अर उन म्ह तै किसे का भी साथी न्ही मरया।<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />तेरे होठ लाल रंग की डोरी की तरियां सै,</para>
  <para style="q" vid="SNG 4:3">अर तेरा मुँह मन नै भाण आळा सै,</para>
  <para style="q" vid="SNG 4:3">तेरे कपोल तेरी लटां कै नीच्‍चै</para>
  <para style="q" vid="SNG 4:3">अनार की फाँक जिसी दिक्खै सै।<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />तेरा गळा दाऊद की मीनार के समान सै,</para>
  <para style="q" vid="SNG 4:4">जो अस्त्र-शस्त्र कै खात्तर बण्या हो, अर जिसपै हजार ढाल टांग्गी होई हो,</para>
  <para style="q" vid="SNG 4:4">वे सारी ढाल शूरवीरां की सै।<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />तेरी दोन्‍नु छात्ती मृग के दो जुड़मा बच्यां की तरियां सै,</para>
  <para style="q" vid="SNG 4:5">जो सोसन फूलां कै बीच म्ह चरदे हो।<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />जिब तक दिन ठण्डा ना हो, अर छाया लाम्बी आन्दे-आन्दे मिट ना जावै,</para>
  <para style="q" vid="SNG 4:6">तब ताहीं मै तावळा सा गन्धरस के पहाड़ अर लोबान की पहाड़ी पै चल्या जाऊँगा।<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />हे मेरी प्यारी तू सर्वांग सुन्दरी सै;</para>
  <para style="q" vid="SNG 4:7">तेरे म्ह कोए खोट कोनी।<verse eid="SNG 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />हे मेरी दुल्हन, तू मेरे गैल लबानोन तै,</para>
  <para style="q" vid="SNG 4:8">मेरे गैल लबानोन तै चाल्‍ली आ।</para>
  <para style="q" vid="SNG 4:8">तू अमाना की चोट्टी पै तै,</para>
  <para style="q" vid="SNG 4:8">सनीर अर हेर्मोन की चोट्टी पै तै,</para>
  <para style="q" vid="SNG 4:8">शेरां की गुफा तै, चीत्यां के पहाड़ां पै तै नीच्‍चै उत्तर कै आ<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fq" closed="false">नीच्‍चै उत्तर कै आ </char><char style="ft" closed="false">निगांह कर</char></note>।<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />हे मेरी भाण, हे मेरी दुल्हन, तन्‍नै मेरा मन मोह लिया सै,</para>
  <para style="q" vid="SNG 4:9">तन्‍नै अपणी आँख की एके झलक तै,</para>
  <para style="q" vid="SNG 4:9">अर अपणे गळे के एके हीरे तै मेरा मन मोह लिया सै।<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />हे मेरी भाण हे मेरी दुल्हन, तेरा प्यार, कितना मनभावणा सै!</para>
  <para style="q" vid="SNG 4:10">तेरा प्यार दाखमधु तै भी बढ़िया सै,</para>
  <para style="q" vid="SNG 4:10">अर तेरे इत्रां की खुशबु सारे ढाळ के मसाल्यां की खुशबु तै!<verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />हे मेरी दुल्हन, तेरे होठां तै शहद टपकै सै;</para>
  <para style="q" vid="SNG 4:11">तेरी जीभ के नीच्‍चै शहद अर दूध रहवै सै,</para>
  <para style="q" vid="SNG 4:11">तेरे कपड़ेयां की खुशबु लबानोन की तरियां सै।<verse eid="SNG 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />मेरी भाण, मेरी दुल्हन, किवाड़ लाग्गे होए बाग की तरियां,</para>
  <para style="q" vid="SNG 4:12">किवाड़ बन्द करया होया चोवा, अर छाप लगाया होया झरणा सै।<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />तेरे अंकुर बढ़िया फळ आळे अनार के बाग की तरियां सै,</para>
  <para style="q" vid="SNG 4:13">जिस म्ह मेंहदी अर जटामासी,<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />जटामासी अर केसर,</para>
  <para style="q" vid="SNG 4:14">लोबान के सारी ढाळ के दरखत, मुश्क अर दालचीनी,</para>
  <para style="q" vid="SNG 4:14">गन्धरस, अगर, और सारे बढ़िया-बढ़िया खुशबुदार-द्रव्य होवै सै।<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />तू बाग्गां का चोवा सै,</para>
  <para style="q" vid="SNG 4:15">फूटदे होए पाणी का कुआँ,</para>
  <para style="q" vid="SNG 4:15">अर लबानोन तै बहन्दी धारा सै।</para>
  <para style="p" vid="SNG 4:15">
    <char style="k">दुल्हन</char><verse eid="SNG 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />हे उत्तर की हवा उठ, अर हे दक्षिण हवा चाल्‍ली आ!</para>
  <para style="q" vid="SNG 4:16">मेरे बाग पै बह, जिसतै उसकी खुशबु फैलै।</para>
  <para style="q" vid="SNG 4:16">मेरा प्रेमी अपणे बाग म्ह आवै,</para>
  <para style="q" vid="SNG 4:16">अर उसके बढ़िया-बढ़िया फळ खावै।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="p">
    <char style="k">दुल्हा</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />हे मेरी भाण, हे मेरी दुल्हन,</para>
  <para style="q" vid="SNG 5:1">मै अपणे बाग म्ह आया सूं,</para>
  <para style="q" vid="SNG 5:1">मन्‍नै अपणा गन्धरस अर बलसान छाँट लिया;</para>
  <para style="q" vid="SNG 5:1">मन्‍नै शहद समेत छात्ता खा लिया,</para>
  <para style="q" vid="SNG 5:1">मन्‍नै दूध अर दाखमधु पी लिया।</para>
  <para style="p" vid="SNG 5:1">
    <char style="k">सहेलियाँ </char></para>
  <para style="q" vid="SNG 5:1">हे साथियो, थम भी खाओ,</para>
  <para style="q" vid="SNG 5:1">हे प्यारों, पियो, जी भरकै पियो!</para>
  <para style="s" vid="SNG 5:1">चौथा गीत</para>
  <para style="p" vid="SNG 5:1">
    <char style="k">दुल्हन</char><verse eid="SNG 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />मै सोया करुँ थी, पर मेरा मन जाग्या करदा।</para>
  <para style="q" vid="SNG 5:2">सुण! मेरा प्रेमी खटखटावै सै, अर कहवै सै,</para>
  <para style="q" vid="SNG 5:2">“हे मेरी भाण, हे मेरी प्यारी, हे मेरी कबूतरी,</para>
  <para style="q" vid="SNG 5:2">हे मेरी निर्मल, मेरै खात्तर दरबाजा खोल,</para>
  <para style="q" vid="SNG 5:2">क्यूँके मेरा सिर ओस तै भरया सै,</para>
  <para style="q" vid="SNG 5:2">अर मेरी लटें रात म्ह गिरी होई बूँदां तै भीज्जी सै।”<verse eid="SNG 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />मन्‍नै अपणे कपड़े तार लिए थे मै उस ताहीं फेर किस तरियां पैहरु?</para>
  <para style="q" vid="SNG 5:3">मन्‍नै तो अपणे पैर धो लिए थे इब उन ताहीं किस तरियां मैल्‍ला करुँ?<verse eid="SNG 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />मेरे प्रेमी नै अपणा हाथ किवाड़ के छेद तै भित्तर डाल दिया,</para>
  <para style="q" vid="SNG 5:4">फेर मेरा मन उसकी खात्तर उमड़ उठ्या।<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />मै अपणे प्रेमी कै खात्तर दरबाजा खोलण उठी,</para>
  <para style="q" vid="SNG 5:5">अर मेरे हाथ्थां तै गन्धरस टपक्या,</para>
  <para style="q" vid="SNG 5:5">अर मेरी आँगळियाँ पै तै टपकदा होया गन्धरस कुण्डे की मूठां पै पड़या।<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />मन्‍नै अपणे प्रेमी कै खात्तर दरबाजा तो खोल्या</para>
  <para style="q" vid="SNG 5:6">पर मेरा प्रेमी मुड़कै चल्या गया था।</para>
  <para style="q" vid="SNG 5:6">जिब वो बोलण लाग रह्या था, तब मेरा जी घबरा ग्या था</para>
  <para style="q" vid="SNG 5:6">मन्‍नै उस ताहीं टोह्या, पर न्ही पाया,</para>
  <para style="q" vid="SNG 5:6">मन्‍नै उस ताहीं पुकारया, पर उसनै किमे जवाब न्ही दिया।<verse eid="SNG 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />पैहरेदार जो नगर म्ह घूम्या करै थे, मन्‍नै मिले,</para>
  <para style="q" vid="SNG 5:7">उननै मेरे ताहीं मारया अर घायल करया,</para>
  <para style="q" vid="SNG 5:7">शहरपनाह के पैहरेदारां नै मेरी चाद्दर मेरे तै खोस ली।<verse eid="SNG 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />हे यरुशलेम की बेटियों, मै थमनै कसम, खुवाकै कहूँ सूं, जै मेरा प्रेमी थमनै मिल जावै,</para>
  <para style="q" vid="SNG 5:8">तो उसतै कह दियो के मै प्रेम म्ह रोग्गी सूं।</para>
  <para style="p" vid="SNG 5:8">
    <char style="k">सहेलियाँ </char><verse eid="SNG 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />हे बिरबानियाँ म्ह घणी सुथरी</para>
  <para style="q" vid="SNG 5:9">तेरा प्रेमी और दुसरयां के प्रेमियाँ तै किस बात म्ह बढ़कै सै?</para>
  <para style="q" vid="SNG 5:9">तू क्यूँ म्हारे ताहीं इसी कसम देवै सै?</para>
  <para style="p" vid="SNG 5:9">
    <char style="k">दुल्हन</char><verse eid="SNG 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />मेरा प्रेमी गोरा अर ताकतवर सै,</para>
  <para style="q" vid="SNG 5:10">उसके बराबर कोए कोंनी<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="fq" closed="false">मेरा प्रेमी गोरा अर ताकतवर सै, उसके बराबर कोए कोंनी </char><char style="ft" closed="false">मेरा प्रेमी लाल और गोरा सा सै, वो दस हजारां म्ह एक सै। </char></note>।<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />उसका सिर खरा सोन्‍ना सै,</para>
  <para style="q" vid="SNG 5:11">उसकी लटकदी होई लटें काग की तरियां काळी सै।<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />उसकी आँख उन कबूतरां की तरियां सै जो</para>
  <para style="q" vid="SNG 5:12">दूध म्ह नाह्के नदी के किनारे</para>
  <para style="q" vid="SNG 5:12">अपणे झुण्ड म्ह एक कतार म्ह बैठ्ठे होए हों।<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />उसके गाल फूलां की फुलवाड़ी अर बलसान</para>
  <para style="q" vid="SNG 5:13">की उभरी होई क्यारी सै।</para>
  <para style="q" vid="SNG 5:13">उसके होठ सोसन फूल सै जिन म्ह तै पिंगळ्या होया गन्धरस टपकै सै।<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />उसके हाथ फीरोजा जड़े होए सोन्‍ने की छड़ सै।</para>
  <para style="q" vid="SNG 5:14">उसकी देह नीलम के फूलां तै जड़े होए हाथी दाँत का काम सै।<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />उसके पैर कुन्दन पै बिठाए होए संगमरमर के खम्भे सै।</para>
  <para style="q" vid="SNG 5:15">वो देक्खण म्ह लबानोन अर खूबसूरती म्ह देवदार के दरखत की तरियां मनभावणा सै।<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />उसकी बोल्‍ली घणी मिठ्ठी सै, हाँ वो घणा सुन्दर सै।</para>
  <para style="q" vid="SNG 5:16">हे यरुशलेम की बेटियों, योए मेरा प्रेमी अर योए मेरा मित्तर सै।<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="p">
    <char style="k">सहेलियाँ </char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />हे बिरबानियाँ म्ह सबतै सुथरी,</para>
  <para style="q" vid="SNG 6:1">तेरा प्रेमी कित्त गया?</para>
  <para style="q" vid="SNG 6:1">तेरा प्रेमी कित्त चल्या गया</para>
  <para style="q" vid="SNG 6:1">के हम तेरी गैल उस नै टोहण चाल्‍लां?</para>
  <para style="p" vid="SNG 6:1">
    <char style="k">वधू</char><verse eid="SNG 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />मेरा प्रेमी अपणे बाग म्ह यानी बलसान</para>
  <para style="q" vid="SNG 6:2">की क्यारियाँ की ओड़ गया सै,</para>
  <para style="q" vid="SNG 6:2">ताके बाग म्ह अपणी भेड़-बकरियाँ नै चरावै अर</para>
  <para style="q" vid="SNG 6:2">सोसन फूल बटोरै।<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />मै अपणे प्रेमी की सूं अर मेरा प्रेमी मेरा सै,</para>
  <para style="q" vid="SNG 6:3">वो अपणी भेड़-बकरियाँ नै सोसन के फूल्‍लां कै बीच चरावै सै।</para>
  <para style="s" vid="SNG 6:3">पाँचवाँ गीत</para>
  <para style="p" vid="SNG 6:3">
    <char style="k">दुल्हा</char><verse eid="SNG 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />हे मेरी प्यारी, तू तिर्सा<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="fq" closed="false">तिर्सा </char><char style="ft" closed="false">तिर्सा उत्तरी इस्राएल की एक प्राचीन राजधानी थी।</char></note> की तरियां सुथरी सै</para>
  <para style="q" vid="SNG 6:4">तू यरुशलेम के समान सोहणी सै,</para>
  <para style="q" vid="SNG 6:4">अर झण्ड़ा फैहरान्दी होई सेना के बराबर भयंकर सै।<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />अपणी आँख मेरी ओड़ तै फेर ले,</para>
  <para style="q" vid="SNG 6:5">क्यूँके मै उनतै घबराऊँ सूं;</para>
  <para style="q" vid="SNG 6:5">तेरे बाळ इसी बकरियाँ के झुण्ड की तरियां सै,</para>
  <para style="q" vid="SNG 6:5">जो गिलाद की ढलाण पै लेट्टी होई दिखाई देन्दी हो।<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />तेरे दाँत इसी भेड्डां के झुण्ड की तरियां सै</para>
  <para style="q" vid="SNG 6:6">जिन ताहीं नुहाया गया हो,</para>
  <para style="q" vid="SNG 6:6">उन म्ह तै हरेक जुड़मां बच्‍चें देवै सै,</para>
  <para style="q" vid="SNG 6:6">जिन म्ह तै किसे का साथी न्ही मरया।<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />तेरे कपोल तेरी लटां कै नीच्‍चै</para>
  <para style="q" vid="SNG 6:7">अनार की फाँक दिखाई पड़ै सै।<verse eid="SNG 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />ओड़ै साठ राणी अर अस्सी रखैल</para>
  <para style="q" vid="SNG 6:8">अर अनगिणत कुँवारियाँ भी सै।<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />पर मेरी कबूतरी, मेरी निर्मल, सारे तै निराळी सै</para>
  <para style="q" vid="SNG 6:9">वा अपणी माँ की एके सै,</para>
  <para style="q" vid="SNG 6:9">अपणी जाम्मण आळी की लाडली सै।</para>
  <para style="q" vid="SNG 6:9">बेटियाँ नै उस ताहीं देख्या अर धन्य कह्या;</para>
  <para style="q" vid="SNG 6:9">राणियाँ अर रखैल्‍लां नै देखकै उसकी बढ़ाई करी।<verse eid="SNG 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />या कौण सै जिसकी शोभा सबेरै की तरियां सै,</para>
  <para style="q" vid="SNG 6:10">जो खूबसूरती म्ह चाँद</para>
  <para style="q" vid="SNG 6:10">अर निर्मलता म्ह सूरज,</para>
  <para style="q" vid="SNG 6:10">अर झण्डा फैहरान्दी होई सेना की तरियां</para>
  <para style="q" vid="SNG 6:10">भयंकर दिखाई देवै सै?<verse eid="SNG 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />मै अखरोट के बाग म्ह उतरगी,</para>
  <para style="q" vid="SNG 6:11">ताके तराई के फूल देक्खूँ,</para>
  <para style="q" vid="SNG 6:11">अर देक्खूँ के अंगूर की बेल म्ह कली लाग्गी,</para>
  <para style="q" vid="SNG 6:11">अर अनार के फूल खिले के न्ही।<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />मन्‍नै बेरा भी न्ही था के मेरी कल्पना नै</para>
  <para style="q" vid="SNG 6:12">मेरे ताहीं अपणे राजकुमार के रथ पै चढ़ा दिया।</para>
  <para style="p" vid="SNG 6:12">
    <char style="k">सहेलियाँ </char><verse eid="SNG 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />लौट आ, लौट आ, हे शूलेम्मिन की छोरी,</para>
  <para style="q" vid="SNG 6:13">लौट आ, लौट आ, के हम तेरे पै निगांह करां।</para>
  <para style="p" vid="SNG 6:13">
    <char style="k">दुल्हन</char></para>
  <para style="q" vid="SNG 6:13">के थम शूलेम्मिन<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">शूलेम्मिन </char><char style="ft" closed="false">शूलेम्मिन इस शब्द की तरियां भोत सुझाव दिए गए सै। कई माणस प्यार अर युद्ध की मेसोपोटामिया देवी, शुलमनिटु, और लोगां गैल सुलैमान के संबन्ध अर इब तक भी दूसरा नै शूनेम नाम के एक शहर तै जोड़े सै। </char></note> नै इस तरियां देक्खोगे</para>
  <para style="q" vid="SNG 6:13">जिसा महनैम के नाच नै देक्खो सों?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="s">बड़ाई का बखान</para>
  <para style="p">
    <char style="k">दुल्हा</char></para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />हे राजकुमारी, तेरे पैर जूतियाँ म्ह</para>
  <para style="q" vid="SNG 7:1">कितणे सुथरे लाग्गै सै!</para>
  <para style="q" vid="SNG 7:1">तेरी जाँघां की गोळाई इसे गहणे की तरियां सै,</para>
  <para style="q" vid="SNG 7:1">जिस ताहीं किसे माहिर कारीगर नै रच्या हो।<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />तेरी सुंडी गोळ कटोरा सै,</para>
  <para style="q" vid="SNG 7:2">जो मसाला मिले होए दाखमधु तै भरी हो।</para>
  <para style="q" vid="SNG 7:2">तेरा पेट गेहूँ के ढेर की तरियां सै जिसके</para>
  <para style="q" vid="SNG 7:2">च्यांरु ओड़ सोसन के फूल हो।<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />तेरी दोन्‍नु छात्ती</para>
  <para style="q" vid="SNG 7:3">हिरणी के दो जुड़मा बच्यां की तरियां सै।<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />तेरा गळा हाथी दाँत का मीनार सै।</para>
  <para style="q" vid="SNG 7:4">तेरी आँख हेशबोन के उन कुण्डा की तरियां सै,</para>
  <para style="q" vid="SNG 7:4">जो बत्रब्बीम के फाट्टक कै धोरै सै।</para>
  <para style="q" vid="SNG 7:4">तेरी नाक लबानोन पहाड़ के मीनार की तरियां सै,</para>
  <para style="q" vid="SNG 7:4">जिसका मुँह दमिश्क देश की ओड़ सै।<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />तेरा सिर तेरे पै कर्मेल पहाड़ की तरियां शोभामान सै,</para>
  <para style="q" vid="SNG 7:5">अर तेरे सिर की लटें बैंगणी रंग के कपड़यां की तरियां सै,</para>
  <para style="q" vid="SNG 7:5">राजा उन लटां म्ह गुलाम होग्या सै।<verse eid="SNG 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />हे प्यारी अर मन भाण आळी कुवारी,</para>
  <para style="q" vid="SNG 7:6">तू कितनी सुन्दर अर किसी मनभावणी सै!<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />तेरी कदकाठी खजूर की तरियां शानदार सै</para>
  <para style="q" vid="SNG 7:7">अर तेरी छात्ती अंगूर के गुच्छयाँ की तरियां सै।<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />मन्‍नै कह्या, “मै इस खजूर पै चढ़कै उसकी डाळियाँ नै पकड़ूँगा।”</para>
  <para style="q" vid="SNG 7:8">तेरी छात्ती अंगूर के गुच्छे हो,</para>
  <para style="q" vid="SNG 7:8">अर तेरी साँस की खुशबु सेबां की तरियां हो,<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />अर तेरी मुक्खी बढ़िया दाखमधु की तरियां सै।</para>
  <para style="p" vid="SNG 7:9">
    <char style="k">दुल्हन</char></para>
  <para style="q" vid="SNG 7:9">जो आसान्‍नी तै होठां पै तै अर दाँतां के बीच सहज-सहज बह ज्या सै<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="fq" closed="false">जो आसान्‍नी तै होठां पै तै अर दाँतां के बीच सहज-सहज बह ज्या सै </char><char style="ft" closed="false">तेरी मुक्खी सबतै बढ़िया दारु की तरियां सै</char></note>।<verse eid="SNG 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />मै अपणे प्रेमी की सूं।</para>
  <para style="q" vid="SNG 7:10">अर उसकी लालसा मेरी ओड़ सदा बणी रहवै सै।<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />हे मेरे प्रेमी, आ, हम खेत्तां म्ह लिकड़ जावां</para>
  <para style="q" vid="SNG 7:11">अर गाम्मां<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="fq" closed="false">गाम्मां </char><char style="ft" closed="false">जंगळी दरखतां के बीच म्ह रहवां </char></note> म्ह रहवां;<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />फेर सबेरै खड़े होकै अंगूर के बाग्गां म्ह चालां,</para>
  <para style="q" vid="SNG 7:12">अर देक्खां के अंगूर की बेल म्ह कली लाग्गी सै के न्ही, के अंगूर के फूल खिले सै या न्ही,</para>
  <para style="q" vid="SNG 7:12">अर अनार फुल्‍लै सै या न्ही।</para>
  <para style="q" vid="SNG 7:12">ओड़ै मै तेरे ताहीं अपणा प्यार दिखाऊँगी।<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />दूदाफळां<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="fq" closed="false">दूदाफळां </char><char style="ft" closed="false">दूदाफळ एक पौधे के भोत मीठे-महकदार फूल सै जो एक फळ पैदा करें सै जो यौन इच्छा नै उत्तेजित करें सै और प्रजनन शक्ति को बढ़ावा दे सै। (उत्पत्ति 30:14-16)</char></note> तै खुशबु आ रही सै,</para>
  <para style="q" vid="SNG 7:13">अर म्हारे बारणै पै सारे ढाळ के बढ़िया फळ सै, नये अर पुराणे भी,</para>
  <para style="q" vid="SNG 7:13">जो, हे मेरे प्रेमी, मन्‍नै तेरे खात्तर कठ्ठे कर राक्खे सै।<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />भला होन्दा के तू मेरे भाई की तरियां होन्दा,</para>
  <para style="q" vid="SNG 8:1">जिसनै मेरी माँ की छात्ती तै दूध पिया!</para>
  <para style="q" vid="SNG 8:1">फेर मै तन्‍नै बाहर पाकै तेरी मुक्खी लेन्दी,</para>
  <para style="q" vid="SNG 8:1">अर कोए मेरी बुराई, न्ही करदा।<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />मै तेरे ताहीं अपणी माँ के घर ले चाल्दी,</para>
  <para style="q" vid="SNG 8:2">अर वो मेरे ताहीं सिखान्दी<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fq" closed="false">सिखान्दी </char><char style="ft" closed="false">या तू मन्‍नै सिखावै सै</char></note>,</para>
  <para style="q" vid="SNG 8:2">अर मै तेरे ताहीं मसाला मिल्या होया दाखमधु,</para>
  <para style="q" vid="SNG 8:2">अर अपणे अनार का रस प्यान्दी।<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />काश, उसका ओळा हाथ मेरे सिर कै नीच्‍चै होन्दा,</para>
  <para style="q" vid="SNG 8:3">अर अपणे सोळे हाथ तै वो मेरा लाड-लडान्दा!<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />हे यरुशलेम की बेटियों, मै थमनै कसम, खुवाऊँ सूं,</para>
  <para style="q" vid="SNG 8:4">के थम मेरे प्रेमी नै ना जगाईयों</para>
  <para style="q" vid="SNG 8:4">जिब तक वो खुद ना उठणा चाहवै।</para>
  <para style="s" vid="SNG 8:4">छठा गीत</para>
  <para style="p" vid="SNG 8:4">
    <char style="k">सहेलियाँ </char><verse eid="SNG 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />या कौण सै जो अपणे प्रेमी पै ध्यान लगाऐ होए</para>
  <para style="q" vid="SNG 8:5">जंगल म्ह तै चाल्‍ली आवै सै?</para>
  <para style="p" vid="SNG 8:5">
    <char style="k">दुल्हन</char></para>
  <para style="q" vid="SNG 8:5">सेब के दरखत कै नीच्‍चै मन्‍नै तेरे ताहीं जगाया।</para>
  <para style="q" vid="SNG 8:5">ओड़ै तेरी माँ नै तेरे ताहीं जन्म दिया</para>
  <para style="q" vid="SNG 8:5">ओड़ै तेरी माँ कै पीड़ाएँ उठी।<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />मन्‍नै नगीने की तरियां अपणे दिल पै लगाऐ राख,</para>
  <para style="q" vid="SNG 8:6">अर तबीज की तरियां अपणी बाँह पै बाँधे राख;</para>
  <para style="q" vid="SNG 8:6">क्यूँके प्यार मौत कै बराबर ताकतवर सै,</para>
  <para style="q" vid="SNG 8:6">अर ईर्ष्या कब्र की तरियां निर्दयी सै।</para>
  <para style="q" vid="SNG 8:6">उसकी ‍ज्वाळा आग की दमक सै</para>
  <para style="q" vid="SNG 8:6">बल्के परमेसवर की ए ‍ज्वाळा सै।<verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />पाणी की बाढ़ तै भी प्यार न्ही बुझ सकदा,</para>
  <para style="q" vid="SNG 8:7">अर ना बड़ी नदियाँ तै भी डूब सकै सै।</para>
  <para style="q" vid="SNG 8:7">जै कोए अपणे घर की सारी सम्पत्ति प्यार के</para>
  <para style="q" vid="SNG 8:7">बदले म्ह दे दे तोभी वो कती घाट लाग्गैगी।</para>
  <para style="p" vid="SNG 8:7">
    <char style="k">दुल्हन</char> का भाई<verse eid="SNG 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />म्हारी एक छोट्टी भाण सै,</para>
  <para style="q" vid="SNG 8:8">जिसकी छात्ती इब्बे न्ही उभरीं।</para>
  <para style="q" vid="SNG 8:8">जिस दिन म्हारी भाण के ब्याह की बात चाल्‍लैगी,</para>
  <para style="q" vid="SNG 8:8">उस दिन हम उसकै खात्तर के करां?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />जै वो शहरपनाह होन्दी</para>
  <para style="q" vid="SNG 8:9">तो हम उसपै चाँदी का गुम्मट बणान्दे,</para>
  <para style="q" vid="SNG 8:9">अर जै वा फाट्टक का किवाड़ होन्दी,</para>
  <para style="q" vid="SNG 8:9">तो हम उसपै देवदार की लाकड़ी के फट्टे लगान्दे।</para>
  <para style="p" vid="SNG 8:9">
    <char style="k">दुल्हन</char><verse eid="SNG 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />मै शहरपनाह थी अर मेरी छात्ती उसके गुम्मट,</para>
  <para style="q" vid="SNG 8:10">तब मै अपणे प्रेमी की निगांह म्ह शान्ति ल्याण आळे की तरियां थी<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="fq" closed="false">शान्ति ल्याण आळे की तरियां थी </char><char style="ft" closed="false">प्रेमिका सोच्‍चे सै के वो पूरी तरियां जवान हो गया सै </char></note>।</para>
  <para style="p" vid="SNG 8:10">
    <char style="k">दुल्हा</char><verse eid="SNG 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />बाल्हामोन म्ह सुलैमान का एक अंगूर का बाग था;</para>
  <para style="q" vid="SNG 8:11">उसनै वो अंगूर का बाग रुखाळे तै सौंप दिया;</para>
  <para style="q" vid="SNG 8:11">हर एक रुखाळे नै उसके फळां खात्तर</para>
  <para style="q" vid="SNG 8:11">चाँदी के हजार-हजार टुकड़े सौपणे थे<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="fq" closed="false">चाँदी के हजार-हजार टुकड़े सौपणे थे </char><char style="ft" closed="false">एक शेकेल या चाँदी का सिक्‍का गाम्मां के मजदूर के एक दिन की मजदूरी के बराबर सै।</char></note>।<verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />मेरा अपणा अंगूर का बाग मेरै ए खात्तर सै;</para>
  <para style="q" vid="SNG 8:12">हे सुलैमान, हजार तेरे ताहीं सै</para>
  <para style="q" vid="SNG 8:12">अर फळ के रुखाळयां नै दो सौ मिलै।<verse eid="SNG 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />तू जो बाग्गां म्ह रहवै सै,</para>
  <para style="q" vid="SNG 8:13">मेरे मित्तर तेरा बोल सुणणा चाहवैं सै;</para>
  <para style="q" vid="SNG 8:13">उस ताहीं मन्‍नै भी सुणण दे।</para>
  <para style="p" vid="SNG 8:13">
    <char style="k">दुल्हन</char><verse eid="SNG 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />हे मेरे प्रेमी, तावळ कर,</para>
  <para style="q" vid="SNG 8:14">अर खुशबुदार द्रव्यों के पहाड़ां पै</para>
  <para style="q" vid="SNG 8:14">चिकारे या जवान हिरण की तरियां बण ज्या।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>