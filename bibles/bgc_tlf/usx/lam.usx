<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id" />
  <para style="ide">UTF-8</para>
  <para style="h">विलापगीत</para>
  <para style="toc1">विलापगीत</para>
  <para style="toc2">विलापगीत</para>
  <para style="toc3">विलाप.</para>
  <para style="mt">विलापगीत</para>
  <para style="is">लेखक</para>
  <para style="ip">किताब म्ह लेखक का नाम कोनी। यहूदी अर मसीही रिवाज दोन्‍नु यिर्मयाह नै इसका लेखक मान्‍नै सै। इस किताब के लेखक नै यरुशलेम के विनाश के नतिज्जे देक्खे थे। इसा लाग्गै सै के उसनै दुश्मन की सेना का हमला खुद देख्या था (<char style="xt"><ref loc="LAM 1:13-15">विलाप. 1:13-15</ref></char>)। यिर्मयाह दोन्‍नु ए घटना के बखत ओड़ै मौजूद था। यहूदिया नै परमेसवर तै बिद्रोह करकै करार ताेड़या था। परमेसवर नै उन ताहीं अनुशासित करण खात्तर बाबेल ताहीं अपणा जरिया बणाया था। इस किताब म्ह घोर कष्टां के वर्णन कै बाद भी आशा का वादा सै। यिर्मयाह परमेसवर की भलाई नै याद करै सै। वो परमेसवर की बिश्वासयोग्यता की सचाई के जरिये उनका होसला बढ़ावै सै। वो पाठकां नै परमेसवर की करुणा अर अचूक प्रेम के बारे म्ह बतावै सै।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">लगभग 586 - 584 ई. पू.</para>
  <para style="ip">यिर्मयाह के जरिये उरै बाबेल की सेना के जरिये यरुशलेम के घेराव अर विनाश का साफ वर्णन करया ग्या सै।</para>
  <para style="is">प्रापक</para>
  <para style="ip">निर्वासन म्ह बाकी रहे यहूदी जो स्वदेश बोहड़ आए अर सारे बाइबल पाठक।</para>
  <para style="is">मकसद</para>
  <para style="ip">पाप चाहे व्यक्तिगत हो या सामूहिक, उसका नतिज्जा भोगणा पड़ै सै। परमेसवर अपणे पाच्छै चाल्‍लण आळयां ताहीं ल्याण खात्तर माणस अर हालात नै जरिया बणावै सै। आस सिर्फ परमेसवर तै होवै सै। जिस ढाळ परमेसवर नै देश लिकाड़े कै बखत कुछ यहूदियाँ ताहीं बचाकै राख्या था उसीए ढाळ उसनै अपणे बेट्टे, यीशु ताहीं उद्धारक बणाकै दे दिया। पाप अनन्त मृत्यु लावै सै पर फेर भी परमेसवर अपणे उद्धार की योजना के जरिये अनन्त जीवन देवै सै। विलापगीत की किताब साफ दर्शावै सै के पाप अर विद्रोह परमेसवर के क्रोध नै ल्यावै सै। <char style="xt"><ref loc="LAM 1:8-9">1:8-9</ref>; <ref loc="LAM 4:13">4:13</ref>; <ref loc="LAM 5:16">5:16</ref></char></para>
  <para style="is">खास बातें</para>
  <para style="ip">विलाप</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. यिर्मयाह यरुशलेम खात्तर विलाप करै सै <char style="ior"><ref loc="LAM 1:1-22">1:1-22</ref></char></para>
  <para style="io1">2. पाप परमेसवर का क्रोध लावै सै <char style="ior"><ref loc="LAM 2:1-22">2:1-22</ref></char></para>
  <para style="io1">3. परमेसवर अपणे माणसां नै कदे न्ही छोड़दा <char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref></char></para>
  <para style="io1">4. यरुशलेम की महिमा का अन्त <char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref></char></para>
  <para style="io1">5. यिर्मयाह अपणे माणसां खात्तर मध्यस्थता करै सै <char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref> </char></para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s">उपद्रव म्ह यरुशलेम</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1" />जो यरुशलेम नगरी माणसां तै भरी पड़ी थी वा इब किसी एक्ली बैठी सै!</para>
  <para style="q" vid="LAM 1:1">वा क्यूँ एक बिधवा की तरियां बणगी?</para>
  <para style="q" vid="LAM 1:1">वा जो घणखरी जातियाँ की निगांह म्ह महान अर सारे प्रान्तां म्ह राणी थी,</para>
  <para style="q" vid="LAM 1:1">इब कर देण आळी क्यूँ होगी सै।<verse eid="LAM 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2" />रात नै वा फूट-फूटकै रोवै सै, उसके आँसू गाल्‍ला पै तै पड़ै सै;</para>
  <para style="q" vid="LAM 1:2">उसके सारे मित्तरां म्ह तै इब कोए उस ताहीं शान्ति न्ही देन्दा;</para>
  <para style="q" vid="LAM 1:2">उसके सब मित्तरां नै उसतै धोक्खा करया,</para>
  <para style="q" vid="LAM 1:2">अर उसके दुश्मन बणगे सै।<verse eid="LAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3" />यहूदा दुख अर कठोर गुलाम्मी कै कारण परदेस चली गई;</para>
  <para style="q" vid="LAM 1:3">पर गैरजात्तां म्ह रहकै भी वा चैन न्ही पांदी;</para>
  <para style="q" vid="LAM 1:3">उसके सारे भगाण आळयां नै मुसीबत म्ह उस ताहीं पकड़ लिया सै।<verse eid="LAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4" />परमेसवर के भवन सिय्योन के रास्ते बिलाप करण लागरे सै,</para>
  <para style="q" vid="LAM 1:4">क्यूँके ठहराए होए त्यौहारां म्ह कोए कोनी आन्दा;</para>
  <para style="q" vid="LAM 1:4">उसके सारे फाट्टक सुनसान पड़े सै, उसके याजक कराहवै सै;</para>
  <para style="q" vid="LAM 1:4">उसकी कुवारियाँ शोकित सै,</para>
  <para style="q" vid="LAM 1:4">अर वा खुद दुख भोग्गण लागरी सै।<verse eid="LAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5" />उसके बिद्रोही प्रधान होगे, उसके दुश्मन बढ़ोतरी करण लागरे सै,</para>
  <para style="q" vid="LAM 1:5">क्यूँके यहोवा नै उसके भोत-से अपराध्धां कै कारण उस ताहीं दुख दिया सै;</para>
  <para style="q" vid="LAM 1:5">उसके बाल-बच्यां नै दुश्मन हाँक-हाँक कै गुलाम्मी म्ह लेगे।<verse eid="LAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6" />सिय्योन की बेट्टी का सारा प्रताप जान्दा रहया सै।</para>
  <para style="q" vid="LAM 1:6">उसके हाकिम इसे हिरणां की तरियां होगे सै, जिन ताहीं कोए चराई न्ही मिलदी;</para>
  <para style="q" vid="LAM 1:6">वे भगाण आळा कै स्याम्ही तै कमजोर होकै भाज्जै सै।<verse eid="LAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7" />यरुशलेम नै, इन दुख भरे अर, संकट के दिनां म्ह,</para>
  <para style="q" vid="LAM 1:7">जिब उसके लोग द्रोहियाँ के हाथ म्ह पड़े अर उसका कोए मददगार ना रहया,</para>
  <para style="q" vid="LAM 1:7">अपणी सारी मनभावणी चिज्जां नै याद करैं सै, जो पुराणे बखत तै उसकी थी।</para>
  <para style="q" vid="LAM 1:7">उसके द्रोहियाँ नै उस ताहीं उजड़या होया देखकै मजाक उड़ाया सै।<verse eid="LAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8" />यरुशलेम नै बड़ा पाप करया, इस करकै वो अशुद्ध जनान्‍नी जिसी होगी सै;</para>
  <para style="q" vid="LAM 1:8">जितने उसका आदर करै थे वे उसकी बेजती करै सै,</para>
  <para style="q" vid="LAM 1:8">क्यूँके उननै उसकी नंगाई देक्खी सै;</para>
  <para style="q" vid="LAM 1:8">हाँ, वो कैहरान्दी होई मुँह फेर लेवै सै।<verse eid="LAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9" />उसकी अशुद्धता उसके कपड़ेयां पै सै;</para>
  <para style="q" vid="LAM 1:9">उसनै अपणे अन्त ताहीं याद न्ही राख्या;</para>
  <para style="q" vid="LAM 1:9">इस करकै वो भयंकर रीति तै गेरी गई,</para>
  <para style="q" vid="LAM 1:9">अर कोए उस ताहीं शान्ति न्ही देन्दा।</para>
  <para style="q" vid="LAM 1:9">हे यहोवा, मेरे दुख पै निगांह कर,</para>
  <para style="q" vid="LAM 1:9">क्यूँके दुश्मन मेरे बिरुध्द कामयाब होया सै!<verse eid="LAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10" />द्रोहियाँ नै उसकी सारी मनभावणी चिज्जां पै हाथ बढ़ाया सै;</para>
  <para style="q" vid="LAM 1:10">हाँ, गैरजात्तां नै, जिनके बारै म्ह तन्‍नै हुकम दिया था के वे तेरी सभा म्ह भागी न्ही होण पावैगी,</para>
  <para style="q" vid="LAM 1:10">उन ताहीं उसनै तेरे पवित्रस्‍थान म्ह घुस्या होया देख्या सै।<verse eid="LAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11" />उसके सारे बासिंदे कराहन्दे होए खाण-पीण की चीज ढूँढ़ण लागरे सै;</para>
  <para style="q" vid="LAM 1:11">उननै अपणी जान बचाण खात्तर अपणी सब तै घणी मन पसन्द सारी चीज बेचकै खाणा मोल लिया सै।</para>
  <para style="q" vid="LAM 1:11">हे यहोवा, निगांह कर, अर ध्यान तै देख,</para>
  <para style="q" vid="LAM 1:11">क्यूँके मै नीच होगी सूं।<verse eid="LAM 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12" />हे सारे मुसाफिरों, के थमनै इस बात की कुछ भी चिन्ता कोनी?</para>
  <para style="q" vid="LAM 1:12">निगांह करकै देक्खो, के मेरे दुख तै बढ़कै कोए और दर्द सै जो यहोवा नै अपणे छो, के दिन मेरे पै गेर दिये सै?<verse eid="LAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13" />उसनै उप्पर तै मेरी हाड्डियाँ म्ह आग लगाई सै,</para>
  <para style="q" vid="LAM 1:13">अर वे उसतै भस्म होगी;</para>
  <para style="q" vid="LAM 1:13">उसनै मेरे पैरां खात्तर जाळ लगाया, अर मेरे ताहीं उलटा फेर दिया सै;</para>
  <para style="q" vid="LAM 1:13">उसनै इसा करया के मै त्यागी होई जिसी अर रोग तै लगातार कमजोर रहूँ सूं।<verse eid="LAM 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14" />उसनै जूए की रस्सियाँ की ढाळ मेरे अपराध्धां ताहीं अपणे हाथ तै कस्या सै;</para>
  <para style="q" vid="LAM 1:14">उसनै उन ताहीं बाट कै मेरी नाड़ पै चढ़ाया, अर मेरी ताकत घटा दी सै;</para>
  <para style="q" vid="LAM 1:14">जिनका मै सामना भी न्ही कर सकदी, उन्हे कै वश म्ह यहोवा नै मेरे ताहीं कर दिया सै।<verse eid="LAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15" />यहोवा नै मेरे सारे शूरवीर माणसां<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="fq" closed="false">शूरवीर माणसां </char><char style="ft" closed="false">यहूदा के माणसां</char></note> ताहीं तुच्छ जाण्या;</para>
  <para style="q" vid="LAM 1:15">उसनै ठहराए होए त्यौहार का प्रचार करकै माणसां ताहीं मेरे खिलाफ बुलाया ताके मेरे जवान्‍नां ताहीं पिस दे;</para>
  <para style="q" vid="LAM 1:15">यहूदा की कुवारी कन्या ताहीं यहोवा नै मान्‍नो कुण्ड म्ह रौंद दिया सै।<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="REV 14:20">प्रका. 14:20</ref>; <ref loc="REV 19:15">प्रका. 19:15</ref></char></char></note><verse eid="LAM 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16" />इन बात्तां कै कारण मै रोऊँ सूं;</para>
  <para style="q" vid="LAM 1:16">मेरी आँखां तै आँसू की धारा बहन्दी रहवै सै;</para>
  <para style="q" vid="LAM 1:16">क्यूँके जिस शान्तिदात्ता कै कारण मेरा जी हरा भरया हो जावै था, वो मेरे तै दूर होग्या;</para>
  <para style="q" vid="LAM 1:16">मेरे बच्‍चें एक्ले होगे, क्यूँके दुश्मन हावी होया सै।<verse eid="LAM 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17" />सिय्योन हाथ फैलाए होए सै, उस ताहीं कोए शान्ति न्ही देन्दा;</para>
  <para style="q" vid="LAM 1:17">यहोवा नै याकूब के बारे म्ह यो हुकम दिया सै के उसके च्यांरु ओड़ के बासिंदे उसके बिद्रोही हो जावै;</para>
  <para style="q" vid="LAM 1:17">यरुशलेम उनकै बीच अशुद्ध जनान्‍नी की तरियां होगी सै।<verse eid="LAM 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18" />यहोवा सच्‍चाई पै सै, क्यूँके मन्‍नै उसके हुकम का उलंघण करया सै;</para>
  <para style="q" vid="LAM 1:18">हे सारे माणसों, सुणो, अर मेरे दर्द नै देक्खो! मेरे कुमार अर कुमारियाँ गुलाम्मी म्ह चली गई सै।<verse eid="LAM 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />मन्‍नै अपणे मित्रां ताहीं बुलाया पर उननै भी मेरे ताहीं धोक्खा दिया;</para>
  <para style="q" vid="LAM 1:19">जिब मेरे याजक अर पुरनिये इस खात्तर खाण-पीण की चीज ढूँढ़ण लागरे थे के खाणे तै उनका जी हरा हो जावै,</para>
  <para style="q" vid="LAM 1:19">तब नगर म्ह ए उनके प्राण छूट गए।<verse eid="LAM 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20" />हे यहोवा, निगांह कर, क्यूँके मै मुसीबत्त म्ह सूं,</para>
  <para style="q" vid="LAM 1:20">मेरी आत्ड़ियाँ ऐंठी जावै सै, मेरा मन उल्ट ग्या सै, क्यूँके मन्‍नै घणा बिश्वासघात करया सै।</para>
  <para style="q" vid="LAM 1:20">बाहर तो मै तलवार तै बेबस होऊँ सूं;</para>
  <para style="q" vid="LAM 1:20">अर घर म्ह मौत बैठ्ठी सै।<verse eid="LAM 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21" />उननै सुण्या सै के न्याय के दिन मै कहराऊ सूं,</para>
  <para style="q" vid="LAM 1:21">पर कोए मन्‍नै शान्ति न्ही देन्दा।</para>
  <para style="q" vid="LAM 1:21">मेरे सारे दुश्मनां नै मेरी बिप्दा का समाचार सुण्या सै;</para>
  <para style="q" vid="LAM 1:21">वे इसतै खुश होगे के तन्‍नै ए यो करया सै।</para>
  <para style="q" vid="LAM 1:21">पर जिस दिन की चर्चा तन्‍नै प्रचार करकै सुणाई सै उस ताहीं तू दिखा,</para>
  <para style="q" vid="LAM 1:21">फेर वे भी मेरी ढाळ हो जावैंगे।<verse eid="LAM 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22" />उनकी सारी दुष्टता की ओड़ निगांह कर;</para>
  <para style="q" vid="LAM 1:22">अर जिसा मेरे सारे अपराध्धां के कारण तन्‍नै मेरे ताहीं दण्ड दिया, उसाए उन ताहीं भी दण्ड दे;</para>
  <para style="q" vid="LAM 1:22">क्यूँके मै भोत, घणी कहराऊ सूं,</para>
  <para style="q" vid="LAM 1:22">अर मेरा मन रोग तै कमजोर, होग्या सै।<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s">यरुशलेम के गैल परमेसवर का छो</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1" />यहोवा नै सिय्योन की बेट्टी ताहीं किस तरियां अपणे कोप के बादळां तै ढाँप दिया सै!</para>
  <para style="q" vid="LAM 2:1">उसनै इस्राएल की शोभा ताहीं अकास तै धरती पै पटक दिया;</para>
  <para style="q" vid="LAM 2:1">अर कोप के दिन अपणे पायां की चौकी ताहीं याद न्ही करया।<verse eid="LAM 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2" />यहोवा नै याकूब की सारी बस्तियाँ ताहीं कठोरता तै खतम करया सै;</para>
  <para style="q" vid="LAM 2:2">उसनै छो म्ह आकै यहूदा की बेट्टी के मजबूत गढ़ा ताहीं गिराकै माट्टी म्ह मिल्या दिया सै;</para>
  <para style="q" vid="LAM 2:2">उसनै हाकिमां समेत राज्य ताहीं अपवित्र ठहराया सै।<verse eid="LAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3" />उसनै छो म्ह आकै इस्राएल के सींग ताहीं जड़ तै काट दिया सै;</para>
  <para style="q" vid="LAM 2:3">उसनै दुश्मन कै स्याम्ही उनकी मदद करण तै अपणा सोळा हाथ खींच लिया सै;</para>
  <para style="q" vid="LAM 2:3">उसनै च्यांरु ओड़ भस्म कर दी होई लौ की तरियां याकूब ताहीं जळा दिया सै।<verse eid="LAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4" />उसनै दुश्मन बणकै धनुष चढ़ाया, अर बैरी बणकै सोळा हाथ बढ़ाए होए खड्या सै;</para>
  <para style="q" vid="LAM 2:4">अर जितने देक्खण म्ह मन नै भावण आळे थे, उन सब ताहीं उसनै घात करया;</para>
  <para style="q" vid="LAM 2:4">सिय्योन की बेट्टी के तम्बू पै उसनै आग की तरियां अपणी जळजळाहट भड़का दी सै।<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="fq" closed="false">सिय्योन की बेट्टी के तम्बू पै उसनै आग की तरियां अपणी जळजळाहट भड़का दी सै। </char><char style="ft" closed="false">यरुशलेम </char></note><verse eid="LAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5" />यहोवा दुश्मन बणग्या, उसनै इस्राएल ताहीं निगळ लिया;</para>
  <para style="q" vid="LAM 2:5">उसके सारे भवनां ताहीं उसनै मिटा दिया, अर उसके मजबूत गढ़ा ताहीं खतम कर दिया सै;</para>
  <para style="q" vid="LAM 2:5">अर यहूदा की बेट्टी का रोणा-पीटणा भोत, घणा बढ़ाया सै।<verse eid="LAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6" />उसनै अपणा मण्डप बारी के मचान की तरियां चाणचक गिरा दिया,</para>
  <para style="q" vid="LAM 2:6">अपणे मिलाप-स्थान ताहीं उसनै नाश करया सै;</para>
  <para style="q" vid="LAM 2:6">यहोवा नै सिय्योन म्ह ठहराये होए त्यौहार अर विश्रामदिन दोनुआं ताहीं भूला दिया सै,</para>
  <para style="q" vid="LAM 2:6">अर अपणे भड़के होए कोप तै राजा अर याजक दोनुआं की बेजती करी सै।<verse eid="LAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7" />यहोवा नै अपणी वेदी मन तै उतार दी,</para>
  <para style="q" vid="LAM 2:7">अर अपणा पवित्रस्‍थान अपमान कै गैल छोड़ दिया सै;</para>
  <para style="q" vid="LAM 2:7">उसके भवनां की दीवारां ताहीं उसनै दुश्मनां के वश म्ह कर दिया;</para>
  <para style="q" vid="LAM 2:7">यहोवा के भवन म्ह उननै इसा शोर-सराबा मचाया के मान्‍नो ठहराये होए त्यौहार का दिन हो।<verse eid="LAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8" />यहोवा नै सिय्योन<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fq" closed="false">सिय्योन </char><char style="ft" closed="false">यरुशलेम नगर</char></note> की कुवारी की शहरपनाह तोड़ देण की ठाण ली थी:</para>
  <para style="q" vid="LAM 2:8">उसनै डोरी डाळी अर अपणा हाथ उस ताहीं नाश करण तै न्ही खींच्या;</para>
  <para style="q" vid="LAM 2:8">उसनै किले अर शहरपनाह दोनुआं ताहीं बिलाप करवाया, वे दोन्‍नु एक साथ गिराए गए सै।<verse eid="LAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9" />सिय्योन नगर फाट्टक धरती म्ह धसगे सै, उनके बेंड़ा ताहीं उसनै तोड़कै नाश करया।</para>
  <para style="q" vid="LAM 2:9">उसके राजा अर हाकिम गैरजात्तां म्ह रहण के कारण बिना नियम-कायदे के होगे सै,</para>
  <para style="q" vid="LAM 2:9">अर उसके नबी यहोवा तै दर्शन न्ही पान्दे।<verse eid="LAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10" />सिय्योन की बेट्टी के पुरनिये धरती पै चुपचाप बैठ्ठे सै;</para>
  <para style="q" vid="LAM 2:10">उननै अपणे सिर पै धूळ उड़ाई अर टाट का फेंटा बाँध्या सै;</para>
  <para style="q" vid="LAM 2:10">यरुशलेम की कुँवारियाँ नै अपणा-अपणा सिर धरती तक झुकाया सै।<verse eid="LAM 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11" />मेरी आँख आँसू बांहदे-बांहदे धुँधळी पड़गी सै;</para>
  <para style="q" vid="LAM 2:11">मेरी आत्ड़ियाँ ऐंठी जावै सै;</para>
  <para style="q" vid="LAM 2:11">मेरे माणसां की बेट्टी के विनाश के कारण मेरा काळजा पाट ग्या सै,</para>
  <para style="q" vid="LAM 2:11">क्यूँके बच्‍चें बल्के दूध पिंदे बच्‍चें भी नगर के चौकां म्ह बेहोस होए सै।<verse eid="LAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12" />वे अपणी-अपणी माँ तै रो कै कहवै सै,</para>
  <para style="q" vid="LAM 2:12">अन्‍न अर शहद कित्त सै?</para>
  <para style="q" vid="LAM 2:12">वे नगर के चौकां म्ह घायल करे होए माणस की तरियां बेहोस होकै</para>
  <para style="q" vid="LAM 2:12">अपणे प्राण अपणी-अपणी माँ की गोद म्ह छोड़दे सै।<verse eid="LAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13" />हे यरुशलेम की बेट्टी, मै तेरे तै के कहूँ?</para>
  <para style="q" vid="LAM 2:13">मै तेरी तुलना किसतै करुँ?</para>
  <para style="q" vid="LAM 2:13">हे सिय्योन की कुवारी कन्या, मै कौण सी चीज तेरे बराबर ठहराकै तन्‍नै शान्ति दियुँ?</para>
  <para style="q" vid="LAM 2:13">क्यूँके तेरा दुख समुन्दर सा अपार सै;</para>
  <para style="q" vid="LAM 2:13">तन्‍नै कौण चंगा कर सकै सै?<verse eid="LAM 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14" />तेरे नबियाँ नै दर्शन का दावा करकै तेरे तै बेकार अर बेकूफी की बात कही सै;</para>
  <para style="q" vid="LAM 2:14">उननै तेरा अधर्म जाहिर न्ही करया, न्ही तो तेरी गुलाम्मी ना होण पांदी;</para>
  <para style="q" vid="LAM 2:14">पर उननै तेरे ताहीं बेकार के अर झूठ्ठे वचन बताए।</para>
  <para style="q" vid="LAM 2:14">जो तेरै खात्तर देश तै लिकाड़ दिए जाण का कारण होए।<verse eid="LAM 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15" />सारे मुसाफिर तेरे पै ताड़ी बजावै सै;</para>
  <para style="q" vid="LAM 2:15">वे यरुशलेम की बेट्टी पै न्यू कहकै ताड़ी बजावै अर सिर हिलावै सै,</para>
  <para style="q" vid="LAM 2:15">के या वाए नगरी सै जिस ताहीं परम सुन्दरी</para>
  <para style="q" vid="LAM 2:15">अर सारी धरती की खुशी का कारण कह्या करैं थे?<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 27:39">मत्ती 27:39</ref></char></char></note><verse eid="LAM 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16" />तेरे सारे दुश्मनां नै तेरे पै मुँह पसारया सै,</para>
  <para style="q" vid="LAM 2:16">वे ताळी बजावैं अर दाँत पीस्सै सै, वे कहवै सै, हम उस ताहीं निगळगे सां!</para>
  <para style="q" vid="LAM 2:16">जिस दिन की बाट हम देक्खा थे, वो योए सै,</para>
  <para style="q" vid="LAM 2:16">वो म्हारे ताहीं मिलग्या, हम उस ताहीं देख चुके सां!<verse eid="LAM 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17" />यहोवा नै जो कुछ ठाण्या था वोए करया भी सै,</para>
  <para style="q" vid="LAM 2:17">जो वचन वो पुराणे बखत तै कहन्दा आया सै वोए उसनै पूरा भी करया सै;</para>
  <para style="q" vid="LAM 2:17">उसनै कठोरता तै तेरे ताहीं ढ़ा दिया सै, उसनै दुश्मनां ताहीं तेरे पै आनन्दित करया,</para>
  <para style="q" vid="LAM 2:17">अर तेरे द्रोहियाँ के सींग ताहीं ऊँच्‍चा करया सै।<verse eid="LAM 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18" />वे प्रभु की ओड़ तन-मन तै पुकारै सैं!</para>
  <para style="q" vid="LAM 2:18">हे सिय्योन की कुवारी की शहरपनाह,</para>
  <para style="q" vid="LAM 2:18">अपणे आँसू रात-दिन नदी की तरियां बहान्दी रह!</para>
  <para style="q" vid="LAM 2:18">थोड़ा-सा भी आराम ना ले, ना तेरी आँख की पुतली चैन ले!<verse eid="LAM 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19" />रात के हर पहर की शरुआत म्ह खड़ी होकै चिल्‍लाया कर!</para>
  <para style="q" vid="LAM 2:19">प्रभु कै स्याम्ही अपणे मन की बात्तां नै धारा की तरियां उण्डेल!</para>
  <para style="q" vid="LAM 2:19">तेरे बाल-बच्‍चे जो हर एक सड़क के सिरे पै भूख कै कारण बेहोस हो रहे सै,</para>
  <para style="q" vid="LAM 2:19">उनकै प्राण कै खात्तर अपणे हाथ उसकी ओड़ फैला।<verse eid="LAM 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20" />हे यहोवा निगांह कर, अर ध्यान तै देख के तन्‍नै यो सारा दुख किसतै दिया सै?</para>
  <para style="q" vid="LAM 2:20">के जनान्‍नी अपणा फळ यानी अपणी गोद के बाळकां नै खा लें?</para>
  <para style="q" vid="LAM 2:20">हे प्रभु, के याजक अर नबी तेरे पवित्रस्‍थान म्ह घात करे जावै?<verse eid="LAM 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21" />सड़कां म्ह छोरे अर बूढ़े दोन्‍नु धरती पै पड़े सै;</para>
  <para style="q" vid="LAM 2:21">मेरी कुवारियाँ अर जवान लोग तलवार तै गिरगे सै;</para>
  <para style="q" vid="LAM 2:21">तन्‍नै कोप करण के दिन उन ताहीं मार गेरया;</para>
  <para style="q" vid="LAM 2:21">तन्‍नै कठोरता कै गैल उनका खून करया सै।<verse eid="LAM 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22" />तन्‍नै मेरे डर, भय के कारणा ताहीं ठहराये होए त्यौहार की भीड़ की तरियां च्यांरु ओड़ तै बुलाया सै;</para>
  <para style="q" vid="LAM 2:22">अर यहोवा के कोप के दिन ना तो कोए भाज लिकड्या अर ना कोए बच्या रहया सै;</para>
  <para style="q" vid="LAM 2:22">जिन ताहीं मन्‍नै गोद म्ह लिया अर पाळ-पोसकै बढ़ाया था, मेरे दुश्मन नै उनका खात्मा, कर दिया सै।<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s">नबी का दुखड़ा अर उसकी आस</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1" />उसके छो की छड़ी तै दुख भगाण आळा माणस मै ए सूं;<verse eid="LAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2" />वो मन्‍नै ले जाकै उजियाळे म्ह न्ही, अंधियारे ए म्ह चलावै सै;<verse eid="LAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3" />उसका हाथ दिन भर मेरे ए बिरुध्द उठदा रहवै सै।<verse eid="LAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4" />उसनै मेरा माँस अर चमड़ा गळा दिया सै,</para>
  <para style="q" vid="LAM 3:4">अर मेरी हाड्डियाँ ताहीं तोड़ दिया सै;<verse eid="LAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5" />उसनै मेरे ताहीं रोकण खात्तर किला बणाया,</para>
  <para style="q" vid="LAM 3:5">अर मेरे ताहीं मुश्किल दुख अर शर्म तै घेरया सै;<verse eid="LAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6" />उसनै मेरे ताहीं भोत दिन के मरे होए माणसां की तरियां अँधेरी जगहां म्ह बसा दिया सै।<verse eid="LAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7" />मेरे च्यांरु ओड़ उसनै बाड़ा बाँध्या सै ताके मै लिकड़ न्ही सकूँ;</para>
  <para style="q" vid="LAM 3:7">उसनै मेरे ताहीं भारी साँकळ तै जकड्या सै;<verse eid="LAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8" />मै रुक्‍के मार-मारकै दुहाई देऊँ सूं,</para>
  <para style="q" vid="LAM 3:8">फेर भी वो मेरी प्रार्थना न्ही सुणदा;<verse eid="LAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9" />मेरे राह ताहीं उसनै गढ़े होए पत्थरां तै रोक राख्या सै,</para>
  <para style="q" vid="LAM 3:9">मेरे रास्ते उसनै टेढ़े कर दिये सै।<verse eid="LAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10" />वो मन्‍नै मारण खात्तर छुपकै बैठ्ठे होए रीछ अर मारण खात्तर छुपे होए शेर की तरियां सै;<verse eid="LAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11" />उसनै मेरे ताहीं मेरे राह, तै भटका दिया,</para>
  <para style="q" vid="LAM 3:11">अर मेरे ताहीं पाड़ दिया; उसनै मेरे ताहीं उजाड़ दिया सै।<verse eid="LAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12" />परमेसवर धनुष चढ़ाकै मेरे ताहीं अपणे तीर का निशान्‍नां बणाया सै।<verse eid="LAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13" />उसनै अपणे तीरां तै मेरा दिल बेध दिया सै;<verse eid="LAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14" />सारे माणस मेरे पै हास्सै सै अर दिन भर मेरे पै बात बणाकै गीत गावै सै,<verse eid="LAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15" />उसनै मेरे ताहीं मुश्किल दुख तै भर दिया,</para>
  <para style="q" vid="LAM 3:15">अर नागदौना प्याकै तृप्त करया सै।<verse eid="LAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16" />उसनै मेरे दान्दां ताहीं कंकड़ तै तोड़ दिया,</para>
  <para style="q" vid="LAM 3:16">अर मेरे ताहीं राख तै ढाँप दिया सै;<verse eid="LAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17" />अर मेरे ताहीं मन तै उतारकै मेरी सलामती की आस जान्दी रही;</para>
  <para style="q" vid="LAM 3:17">मै सुख-शान्ति भूल ग्या सूं;<verse eid="LAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18" />इस करकै मन्‍नै अपणे आप तै कह्या, “मेरी ताकत खतम होगी,</para>
  <para style="q" vid="LAM 3:18">अर मेरी आस जो यहोवा पै थी, वो टूटगी सै।”<verse eid="LAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19" />मेरा दुख अर मारया-मारया फिरणा, मेरा नागदौना</para>
  <para style="q" vid="LAM 3:19">अर जहर का पीणा याद कर!<verse eid="LAM 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20" />मै उन्हे बात्तां नै सोचदा रहूँ सूं,</para>
  <para style="q" vid="LAM 3:20">इसतै मेरा जी उखड्या जावै सै।<verse eid="LAM 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21" />पर मै यो याद करुँ सूं, इस करकै मन्‍नै आस सै:<verse eid="LAM 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22" />हम मिट न्ही गए; या यहोवा की बड़ी दया का फळ सै, क्यूँके उसकी सारी दया अमर सै।<verse eid="LAM 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23" />वो रोज सबेरै नई होन्दी रहवै सै; तेरी सच्‍चाई महान सै।<verse eid="LAM 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24" />मेरे मन नै कह्या, “यहोवा मेरा हिस्सा सै, इस कारण मै उस म्ह आस राक्खूँगा।”<verse eid="LAM 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25" />जो यहोवा की बाट देक्खै अर उसकै धोरै जावै सै, उनकै खात्तर यहोवा भला सै।<verse eid="LAM 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26" />यहोवा तै उद्धार पाण की आस राखकै चुपचाप रहणा भला सै।<verse eid="LAM 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27" />माणस खात्तर जवान्‍नी म्ह सबर का जूआ ठाणा भला सै।<verse eid="LAM 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28" />वो यो जाणकै एक्ला चुपचाप रहवै, के परमेसवर नै ए उसपै यो बोझ गेरया सै;<verse eid="LAM 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29" />वो अपणा मुँह धूळ म्ह राक्खै, के बेरा इस मै कुछ आस हो;<verse eid="LAM 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30" />वो अपणा गाल अपणे मारण आळे की ओड़ फेरै, अर बदनाम्मी सहन्दा रह।<verse eid="LAM 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31" />क्यूँके प्रभु मन तै सदा तारे न्ही रहन्दा,<verse eid="LAM 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32" />चाहे वो दुख भी दे, तोभी अपणी करुणा की भरपूरी कै कारण वो दया भी करै सै;<verse eid="LAM 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33" />क्यूँके वो माणसां नै अपणे मन तै दुखी न्ही करदा अर ना दुख देवै सै।<verse eid="LAM 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34" />धरती भर के सारे कैदियाँ नै पैर कै तळै कुचळणा,<verse eid="LAM 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35" />किसे माणस का हक परमप्रधान कै स्याम्ही मारणा,<verse eid="LAM 3:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36" />अर किसे माणस का मुकद्दमा बिगाड़णा,</para>
  <para style="q" vid="LAM 3:36">इन तीन काम्मां नै यहोवा देख न्ही सकदा।<verse eid="LAM 3:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37" />जै यहोवा नै हुकम ना दिया हो, फेर कौण सै</para>
  <para style="q" vid="LAM 3:37">के वचन कहवै अर वो पूरा हो जावै?<verse eid="LAM 3:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38" />मुसीबत्त अर कल्याण, के दोन्‍नु परमप्रधान के हुकम तै न्ही होन्दे?<verse eid="LAM 3:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39" />इस करकै जिन्दा माणस क्यूँ कुड़कुड़ावै?</para>
  <para style="q" vid="LAM 3:39">अर माणस अपणे पाप की सजा नै क्यूँ बुरा मान्‍नै?<verse eid="LAM 3:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40" />हम अपणे चाल चलण नै ध्यान तै परखां,</para>
  <para style="q" vid="LAM 3:40">अर यहोवा की ओड़ मुड़ा!<verse eid="LAM 3:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41" />हम सुर्ग म्ह वास करण आळे परमेसवर की ओड़ मन लगावां</para>
  <para style="q" vid="LAM 3:41">अर हाथ फैलावां अर कहवां:<verse eid="LAM 3:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42" />“ओह यहोवा हमनै तो पाप अर बिश्वासघात करया सै,</para>
  <para style="q" vid="LAM 3:42">अर तन्‍नै माफ न्ही करया।<verse eid="LAM 3:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43" />तेरा छो म्हारे पै सै, तू म्हारै पाच्छै पड्या सै,</para>
  <para style="q" vid="LAM 3:43">तन्‍नै बिना तरस खाए मेरे ताहीं मारया सै।<verse eid="LAM 3:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44" />तन्‍नै अपणे आप ताहीं बादळां तै घेर लिया सै ताके तेरे तक प्रार्थना ना पोहच सकै।<verse eid="LAM 3:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45" />तन्‍नै म्हारे ताहीं जात-जात के माणसां के बीच म्ह कूड़ा-करकट सा ठहराया सै।<note caller="+" style="f"><char style="fr" closed="false">3:45 </char><char style="ft" closed="false"><char style="xt"><ref loc="1CO 4:13">1 कुरि. 4:13</ref></char></char></note><verse eid="LAM 3:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46" />म्हारे सारे दुश्मनां नै म्हारे पै अपणा-अपणा मुँह फैलाया सै;<verse eid="LAM 3:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47" />डर और गड्डा, उजाड़ अर विनाश, म्हारे पै आ पड़े सै;<verse eid="LAM 3:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48" />मेरी आँखां तै मेरी प्रजा की बेट्टी के विनाश कै कारण पाणी की धारा बहण लागरी सै।<verse eid="LAM 3:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49" />मेरी आँख तै लगातार आँसू बहन्दे रहवैंगे,<verse eid="LAM 3:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50" />इब ताहीं यहोवा सुर्ग तै मेरी ओड़ ना देक्खै;<verse eid="LAM 3:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51" />अपणी नगरी की सारी बिरबानियाँ का हाल देक्खण पै मेरा दुख बढ़ै सै।<verse eid="LAM 3:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52" />जो बेकार मेरे दुश्मन बणे सै, उननै बिना दया तै चिड़ियाँ की तरियां मेरा शिकार करया सै<note caller="+" style="f"><char style="fr" closed="false">3:52 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 35:7">भजन. 35:7</ref></char></char></note>;<verse eid="LAM 3:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53" />उननै मेरे ताहीं गड्ढे म्ह गेरकै मेरी जिन्दगी का अन्त करण खात्तर मेरे उप्पर पत्थर लुढ़काए सै;<verse eid="LAM 3:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54" />मेरे सिर पै तै पाणी बह ग्या, मन्‍नै कह्या, ‘मै इब नाश होग्या।’<verse eid="LAM 3:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55" />हे यहोवा, गहरे गड्ढे म्ह तै मन्‍नै तेरे तै प्रार्थना करी;<verse eid="LAM 3:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56" />तन्‍नै मेरी सुणी ताके जो दुहाई देकै मै चिल्‍लाऊ सूं उसतै कान ना फेर ले!<verse eid="LAM 3:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57" />जिब मन्‍नै तेरे ताहीं पुकारया, तब तन्‍नै मेरे तै कह्या, ‘मत डर!’<verse eid="LAM 3:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58" />हे यहोवा, तन्‍नै मेरा मुकद्दमा लड़कै मेरा प्राण बचा लिया सै।<verse eid="LAM 3:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59" />हे यहोवा, जो अन्याय मेरे पै होया सै उस ताहीं तन्‍नै देख्या सै; तू मेरा न्याय चुका।<verse eid="LAM 3:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60" />जो बदला मेरे दुश्मनां नै मेरे तै लिया, अर जो कल्पना मेरै खिलाफ करी, उन ताहीं भी तन्‍नै देख्या सै।<verse eid="LAM 3:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61" />हे यहोवा, जो कल्पना अर बुराई, वे मेरे बिरुध्द करै सै, वो भी तन्‍नै सुणी सै।<verse eid="LAM 3:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62" />मेरे बिरोधियाँ के वचन, अर जो कुछ भी वे मेरे बिरुध्द लगातार बात करै सै, उननै तू जाणै सै।<verse eid="LAM 3:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63" />उनका उठणा-बैठणा ध्यान तै देख;</para>
  <para style="q" vid="LAM 3:63">वे मेरे पै लागदे होए गीत गावैं सै।<verse eid="LAM 3:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64" />हे यहोवा, तू मेरे दुश्मनां के काम्मां कै मुताबिक उननै बदला देवैगा।<verse eid="LAM 3:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65" />तू उनका मन सुन्‍न कर देवैगा; तेरा श्राप उनपै पड़ैगा।<verse eid="LAM 3:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66" />हे यहोवा, तू अपणे कोप तै उन ताहीं भगा-भगाकै धरती पै तै नाश कर देवैगा।”<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s">सिय्योन की दुर्गति</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1" />सोन्‍ना किस तरियां खोट्टा होग्या, सबतै ज्यादा खरा सोन्‍ना किस तरियां बदल ग्या सै?<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">सोन्‍ना किस तरियां खोट्टा होग्या, सबतै ज्यादा खरा सोन्‍ना किस तरियां बदल ग्या सै? </char><char style="ft" closed="false">सोन्‍ने का अपमान</char></note></para>
  <para style="q" vid="LAM 4:1">पवित्रस्‍थान के पत्थर तो हर एक सड़क के सिरे पै फेंक दिए गए सै।<verse eid="LAM 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2" />सिय्योन के खास बेट्टे जो कुन्दन के बराबर थे,</para>
  <para style="q" vid="LAM 4:2">वे कुम्हार के बणाए होए माट्टी के घड़यां की ढाळ किस तरियां तुच्छ गिणे गए सै!<verse eid="LAM 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3" />गादड़ी भी अपणे बच्यां नै थणां तै लगाकै पिलावै सै,</para>
  <para style="q" vid="LAM 4:3">पर मेरे माणसां की बेट्टी जंगळ के शुतुर्मुर्गों कै बराबर निर्दयी होगी सै।<verse eid="LAM 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4" />दूध पीण आळे बाळकां की जीभ प्यास के मारे ताळु म्ह चिपक गई सै;</para>
  <para style="q" vid="LAM 4:4">बाल-बच्‍चे रोट्टी माँगैं सै, पर कोए उन ताहीं न्ही देन्दा।<verse eid="LAM 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5" />जो स्वादिष्ट खाणा खावैं थे, वे इब सड़कां म्ह बेचैन फिरैं सै;</para>
  <para style="q" vid="LAM 4:5">जो मखमल के कपड़यां म्ह पळे थे इब गळियाँ म्ह लेटदे फिरै सै।<verse eid="LAM 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6" />मेरे माणसां की बेट्टी का अधर्म सदोम के पाप तै भी घणा होग्या</para>
  <para style="q" vid="LAM 4:6">जो किसे के हाथ डाले बिना भी पलभर म्ह उल्ट ग्या था।<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 19:24-25">उत्प. 19:24-25</ref></char></char></note><verse eid="LAM 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7" />उसके कुलीन<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="fq" closed="false">कुलीन </char><char style="ft" closed="false">यरुशलेम के प्रधानां </char></note> हिम तै निर्मल अर दूध तै भी घणा तेज थे;</para>
  <para style="q" vid="LAM 4:7">उनकी देह मुग्याँ तै घणा लाल, अर उनकी खूबसूरती नीलमणि की जिसी थी।<verse eid="LAM 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8" />पर इब उनका रूप अन्धकार तै भी घणा काळा सै, वे सड़कां म्ह पिच्छाणे न्ही जान्दे;</para>
  <para style="q" vid="LAM 4:8">उनका चमड़ा हाड्डियाँ म्ह चिप ग्या, अर लाकड़ी की तरियां सूख ग्या सै।<verse eid="LAM 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9" />तलवार के मारे होए भूख के मारे होयां तै घणे आच्छे थे</para>
  <para style="q" vid="LAM 4:9">जिसका प्राण खेत की उपज बिना भूख के मारे सुखदा जावै सै।<verse eid="LAM 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10" />दयालु जनान्‍नी नै भी अपणे ए हाथ्थां तै अपणे बाळकां ताहीं पकाया सै;</para>
  <para style="q" vid="LAM 4:10">मेरे माणसां के विनाश के बखत वेए उनका खाणा बणगे।<verse eid="LAM 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11" />यहोवा नै अपणी पूरी जळजळाहट जाहिर करी,</para>
  <para style="q" vid="LAM 4:11">उसनै अपणा छो भोत घणाए भड़काया;</para>
  <para style="q" vid="LAM 4:11">अर सिय्योन म्ह इसी आग लगाई जिसतै</para>
  <para style="q" vid="LAM 4:11">उसकी नींव तक भस्म होगी सै।<verse eid="LAM 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12" />धरती का कोए राजा या जगत का कोए रहण आळा</para>
  <para style="q" vid="LAM 4:12">इसका कदे बिश्वास न्ही कर सकै था,</para>
  <para style="q" vid="LAM 4:12">के बिद्रोही अर दुश्मन यरुशलेम के फाटकां कै भित्तर बड़ण पावैगें।<verse eid="LAM 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13" />यो उसके नबियाँ के पापां अर उसके याजकां के अधर्म के काम्मां कै कारण होया सै;</para>
  <para style="q" vid="LAM 4:13">क्यूँके वे उसके बीच धर्मियाँ का खून करदे आए सै।<verse eid="LAM 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14" />वे इब सड़कां म्ह आन्धे सरीखे मारे-मारे फिरैं सै,</para>
  <para style="q" vid="LAM 4:14">अर मान्‍नो लहू की छीट्याँ तै याड़ै तक अशुद्ध सै</para>
  <para style="q" vid="LAM 4:14">के कोए उनकै कपड़यां नै न्ही छू सकदा।<verse eid="LAM 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15" />लोग उननै रुक्‍का मारकै कहवैं सै, “अरै अशुद्ध माणसों, हट जाओ! हट जाओ! म्हारे ताहीं ना छूओ”</para>
  <para style="q" vid="LAM 4:15">जिब वे भाग कै मारे-मारे फिरण लाग्गे,</para>
  <para style="q" vid="LAM 4:15">फेर गैरजात्तां के माणसां नै कह्या, “भविष्य म्ह वे उरै टिकण न्ही पावैगें”<verse eid="LAM 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16" />यहोवा नै अपणे छो तै उन ताहीं तित्तर-बितर करया, वो फेर उनपै दया की नजर न्ही करैगा;</para>
  <para style="q" vid="LAM 4:16">ना तो याजकां का सम्मान होया, अर ना पुरनियां पै किमे अनुग्रह करया गया।<verse eid="LAM 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17" />म्हारी आँख बेकार ए मदद की बाट देखदे-देखदे धुँधळी पड़गी सै,</para>
  <para style="q" vid="LAM 4:17">हम लगातार एक इसी जात की ओड़ देखदे रहे जो बचा न्ही सकी।<verse eid="LAM 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18" />लोग म्हारै पाच्छै इसे पड़े के हम अपणे नगर के चौकां म्ह भी न्ही चाल सके;</para>
  <para style="q" vid="LAM 4:18">म्हारा खात्मा धोरै आया; म्हारी उम्र पूरी होई; क्यूँके म्हारा अन्त आ ग्या था।<verse eid="LAM 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19" />म्हारे भगाण आळे अकास की चील तै भी घणी तेज गति तै चाल्‍लै थे;</para>
  <para style="q" vid="LAM 4:19">वे पहाड़ां पै म्हारे पाच्छै पड़गे अर जंगल म्ह म्हारे खात्तर घात लगाकै बैठगे।<verse eid="LAM 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20" />यहोवा का अभिषिक्त जो म्हारा प्राण था,</para>
  <para style="q" vid="LAM 4:20">अर जिसके बारै म्ह हमनै सोच्या था के गैरजात्तां कै बिचाळै हम उसकी शरण म्ह जिन्दा रहवैंगे,</para>
  <para style="q" vid="LAM 4:20">वो उनके खोद्दे होए खड्या म्ह पकड्या गया।<verse eid="LAM 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21" />हे एदोम की छोरी, तू जो ऊज देश म्ह रहवै सै, हर्षित अर आनन्दित रह;</para>
  <para style="q" vid="LAM 4:21">पर यो कटोरा तेरे ताहीं भी पोहचैगा, अर तू मतवाळी होकै अपणे आप नै नंगा करैगी।<verse eid="LAM 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22" />हे सिय्योन की छोरी, तेरे अधर्म की सजा खतम होई, वो फेर तन्‍नै गुलाम्मी म्ह ना ले जावैगा;</para>
  <para style="q" vid="LAM 4:22">पर हे एदोम की छोरी, तेरे अधर्म की सजा वो तन्‍नै देवैगा, वो तेरे पापां नै जाहिर कर देगा।<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s">दोबारा बणाण की प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1" />हे यहोवा, याद कर के हम पै के-के बित्या सै;</para>
  <para style="q" vid="LAM 5:1">म्हारी ओड़ निगांह करकै म्हारी बदनाम्मी नै देख!<verse eid="LAM 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2" />म्हारा हिस्सा परदेशियाँ का होग्या अर म्हारे घर दुसरयां के होगे सै।<verse eid="LAM 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3" />हम अनाथ अर बिना बाप के होगे;</para>
  <para style="q" vid="LAM 5:3">म्हारी माँ बिधवा जिसी होगी सै।<verse eid="LAM 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4" />हम मोल लेकै पाणी पीवां सां,</para>
  <para style="q" vid="LAM 5:4">म्हारे ताहीं लाकड़ी भी दाम तै मिलै सै।<verse eid="LAM 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5" />भगाण आळे म्हारी नाड़ पै टूट पड़े सै;</para>
  <para style="q" vid="LAM 5:5">हम थकगे सां, म्हारे ताहीं आराम न्ही मिलदा।<verse eid="LAM 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6" />हम खुद, आप मिस्र के अधीन होगे,</para>
  <para style="q" vid="LAM 5:6">अर अश्शूर के भी, ताके हम पेट भर सकां।<verse eid="LAM 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7" />म्हारे पुरखां नै पाप करया, अर मर मिटे सै;</para>
  <para style="q" vid="LAM 5:7">पर उनकै अधर्म के काम्मां का भार म्हारे ताहीं उठाणा पड़या सै।<verse eid="LAM 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8" />म्हारे उप्पर दास हक राक्खैं सै;</para>
  <para style="q" vid="LAM 5:8">उनकै हाथ तै कोए म्हारे ताहीं न्ही छुड़ान्दा।<verse eid="LAM 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9" />जंगल म्ह की तलवार के कारण हम अपणे प्राण मुसीबत म्ह डाल कै खाण-पीण की चीज ले आवां सै।<verse eid="LAM 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10" />भूख की झुलसाण आळी आग कै कारण,</para>
  <para style="q" vid="LAM 5:10">म्हारा चमड़ा तंदूर की तरियां काळा होग्या सै।<verse eid="LAM 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11" />सिय्योन म्ह जनान्‍नी,</para>
  <para style="q" vid="LAM 5:11">अर यहूदा के नगरां म्ह कुवारियाँ भ्रष्ट करी गई सै।<verse eid="LAM 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12" />हाकिम हाथ के बल टाँगें गए सै;</para>
  <para style="q" vid="LAM 5:12">अर पुरनियां का कुछ भी आदर न्ही करया गया।<verse eid="LAM 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13" />जवान्‍नां नै चाक्‍की चलाणी पड़ै सै;</para>
  <para style="q" vid="LAM 5:13">अर बाल-बच्‍चे लाकड़ी का बोझ ठान्दे होए लड़खड़ावै सै।<verse eid="LAM 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14" />इब फाट्टक पै पुरनिये न्ही बैठदे, ना जवान्‍नां का गीत सुणाई पड़ै सै।<verse eid="LAM 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15" />म्हारे मन की खुशी जान्दी रही,</para>
  <para style="q" vid="LAM 5:15">म्हारा नाचणा बिलाप म्ह बदल ग्या सै।<verse eid="LAM 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16" />म्हारे सिर पै का मुकुट गिर पड़या सै;</para>
  <para style="q" vid="LAM 5:16">म्हारे पै हाय, क्यूँके हमनै पाप करया सै!<verse eid="LAM 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17" />इस कारण म्हारा मन कमजोर होग्या सै,</para>
  <para style="q" vid="LAM 5:17">इन बात्तां तै म्हारी आँखां धुँधळी पड़गी सै,<verse eid="LAM 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18" />क्यूँके सिय्योन पर्वत उजाड़ पड़या सै;</para>
  <para style="q" vid="LAM 5:18">उस म्ह गाद्दड़ घूम्मै सै।<verse eid="LAM 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19" />पर हे यहोवा, तू तो सदा तक विराजमान रहवैगा;</para>
  <para style="q" vid="LAM 5:19">तेरा राज्य पीढ़ी-पीढ़ी बण्या रहवैगा।<verse eid="LAM 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20" />तन्‍नै क्यूँ म्हारे ताहीं सदा कै खात्तर भूला दिया सै,</para>
  <para style="q" vid="LAM 5:20">अर क्यूँ भोत घणे काल कै खात्तर म्हारे ताहीं छोड़ दिया सै?<verse eid="LAM 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21" />हे यहोवा, म्हारे ताहीं अपणी ओड़ मोड़, फेर हम सुधर जावैंगे।</para>
  <para style="q" vid="LAM 5:21">पुराणे बखत की तरियां म्हारे दिन बदलकै ज्यों के त्यों कर दे!<verse eid="LAM 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22" />के तन्‍नै म्हारे ताहीं बिल्कुल त्याग दिया सै?</para>
  <para style="q" vid="LAM 5:22">के तू म्हारे तै भोत घणा छो म्ह सै?<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>