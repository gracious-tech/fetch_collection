  <para style="h">आमोस</para>
  <para style="toc1">आमोस नबी की किताब</para>
  <para style="toc2">आमोस</para>
  <para style="toc3">आमोस.</para>
  <para style="mt">आमोस नबी की किताब</para>
  <para style="is">लेखक</para>
  <para style="ip">
    <char style="xt">
      <ref loc="AMO 1:1">आमोस. 1:1</ref>
    </char> लेखक के रूप म्ह भविष्यवक्ता आमोस की पिच्छाण करै सै। भविष्यवक्ता आमोस तकोआ गाम म्ह पाळीयाँ कै गैल रहवै था। आमोस साफ करै सै के वो नबियाँ के परिवार तै न्ही था अर ना ए वो खुद नै भविष्यवक्ता मान्‍नै था। परमेसवर नै टिड्डी अर आग जरिये सजा देण की चेतावनी दी थी पर आमोस की प्रार्थना नै इस्राएल ताहीं बचा लिया था।</para>
  <para style="is">लिखण की तारिख जगहां</para>
  <para style="ip">लगभग 760-750 ई. पू.</para>
  <para style="ip">आमोस बेतेल अर सामरिया-उत्तरी राज्य म्ह प्रचार करै था।</para>
  <para style="is">प्रापक</para>
  <para style="ip">उत्तरी राज्य इस्राएल की प्रजा अर बाइबल के भावी पाठक</para>
  <para style="is">मकसद</para>
  <para style="ip">परमेसवर घमण्ड तै नफरत करै सै। वे माणस आत्म-निर्भर थे अर परमेसवर तै पाई हर एक बात नै भूलगे थे। परमेसवर सब नै महत्त्व देवै सै, अर गरीबां कै गैल करे बुरे बरताव की चेतावनी देवै सै। आखिरकार, परमेसवर नै साच्‍ची आराधना चाहिये जिस म्ह उसके प्रति सम्मान का आचरण हो। आमोस के जरिये तै परमेसवर का वचन इस्राएल के खास अधिकार पाये होये माणसां कै खिलाफ निर्देशित करया गया था, उन म्ह अपणे पड़ोसी कै खात्तर प्यार न्ही था। वे दुसरयां तै फायदा ठावैं थे अर सिर्फ अपणा स्वार्थ सिध्द करै थे।</para>
  <para style="is">खास बातें</para>
  <para style="ip">न्याय</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. गैर जातियाँ का विनाश <char style="ior"><ref loc="AMO 1:1-2:16">1:1-2:16</ref></char></para>
  <para style="io1">2. भविष्यवाणी की बुलाहट <char style="ior"><ref loc="AMO 3:1-8">3:1-8</ref> </char></para>
  <para style="io1">3. इस्राएल की सजा <char style="ior"><ref loc="AMO 3:9-9:10">3:9-9:10</ref> </char></para>
  <para style="io1">4. पुनरूद्धार <char style="ior"><ref loc="AMO 9:11-15">9:11-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />तकोआवासी आमोस जो भेड़-बकरियाँ के चराण आळयां म्ह तै था, उसके ये वचन सैं जो उसनै यहूदा के राजा उज्जियाह के, अर यहोआश के बेट्टे इस्राएल के राजा यारोबाम के शासन म्ह, भूकम्प तै दो साल पैहल्या, इस्राएल कै बारै म्ह दर्शन देखकै कहे:<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />“यहोवा सिय्योन<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">सिय्योन </char><char style="ft" closed="false">सिय्योन मूल रूप से यबूसियाँ (जिनतै इस्राएलियाँ नै यरुशलेम के क्षेत्र पै जीत हासिल करी थी) के किले का नाम था, जो यरुशलेम के पूर्वी पहाड़ पर स्थित था। बाद म्ह यह पूरे पूर्वी पहाड़ अर पूरे यरुशलेम नगर का नाम बणग्या।</char></note> तै गरजैगा अर यरुशलेम तै अपणा शब्द सुणावैगा; फेर पाळीयाँ की चराईयाँ विलाप करैंगी, अर कर्मेल की चोट्टी झुळस जावैगी।”<verse eid="AMO 1:2" /></para>
  <para style="s">इस्राएल के पड़ोसी राज्याँ का न्याय</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा न्यू कहवै सै: “दमिश्क नगर के तीन के, बलके च्यार अपराध्धां कै कारण मै उसकी सजा ना छोड़ूँगा<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">उसकी सजा ना छोड़ूँगा </char><char style="ft" closed="false">इसा लाग्गै सै के माणसां के ध्यान नै खींचण कै खात्तर परमेसवर की चेतावनी का क्रम कै कारण कह्या गया प्रतीत होवै सै।</char></note>; क्यूँके उननै गिलाद ताहीं लोहे के काटण आळे यन्त्रां तै रौंद डाल्या सै। <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />इस करकै मै इस्राएल के राजा हजाएल के राजभवन म्ह आग लगाऊँगा, अर उसतै सीरिया के राजा बेन्हदद के किले भी भस्म हो जावैंगे। <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />मै दमिश्क के बेंड़याँ ताहीं तोड़ गेरूँगा, अर आवेन नाम की तराई के रहण आळयां नै अर बेतएदेन नगर के घर म्ह रहण आळे राजदण्डधारी ताहीं नाश करुँगा; अर अराम के माणस कैदी होकै कीर नगर ताहीं जावैंगे, यहोवा का योए वचन सै।”<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />यहोवा न्यू कहवै सै: “गाज़ा नगर के तीन के, बलके च्यार अपराध्धां कै कारण मै उसकी सजा नै ना छोड़ूँगा; क्यूँके वे सारे माणसां ताहीं बन्दी बणाकै लेगे के उननै एदोम देश के बस म्ह कर देवैं। <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />इस करकै मै गाज़ा नगर की शहरपनाह म्ह आग लगाऊँगा, अर उसतै उसके भवन भस्म हो जावैंगे। <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />मै अश्दोद नगर के रहण आळयां ताहीं अर अश्कलोन के राजदण्डधारी नै भी नाश करुँगा; मै अपणा हाथ एक्रोन कै खिलाफ चलाऊँगा, अर बाकी पलिश्ती माणस नाश होवैंगें,” परमेसवर यहोवा का योए वचन सै।<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />यहोवा न्यू कहवै सै: “सोर नगर के तीन के, बलके च्यार अपराध्धां कै कारण मै उसकी सजा नै ना छोड़ूँगा; क्यूँके उननै सारे माणसां ताहीं बन्दी बणाकै एदोम के बस म्ह कर दिया अर भाई की तरियां करार याद न्ही करया। <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />इस करकै मै सोर की शहरपनाह पै आग लगाऊँगा, अर उसतै उसके भवन भी भस्म हो जावैंगे।”<verse eid="AMO 1:10" /></para>
  <para style="s">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />यहोवा न्यू कहवै सै: “एदोम के तीन के, बलके च्यार अपराध्धां कै कारण मै उसकी सजा नै ना छोड़ूँगा; क्यूँके उसनै अपणे इस्राएली भाई ताहीं तलवार लिये होए खदेड़या अर कुछ भी दया ना करी, पर छो तै उननै लगातार पाड़दा ए रह्या, अर अपणे रोष ताहीं अनन्त काल कै खात्तर बणाए रह्या। <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />इस करकै मै तेमान नगर म्ह आग लगाऊँगा, अर उसतै बोस्रा नगर के भवन भस्म हो जावैंगे।”<verse eid="AMO 1:12" /></para>
  <para style="s">अम्मोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />यहोवा न्यू कहवै सै, “अम्मोन के तीन के, बलके च्यार अपराध्धां कै कारण मै उसकी सजा नै ना छोड़ूँगा, क्यूँके उननै अपणी हद ताहीं बढ़ा लेण खात्तर गिलाद देश की गर्भवती जनानियाँ का पेट चीर डाल्या। <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />इस करकै मै रब्‍बाह नगर की शहरपनाह म्ह आग लगाऊँगा, अर उसतै उसके भवन भी भस्म हो जावैंगे। उस युद्ध के दिन म्ह ललकार होवैगी, वो आँधी बलके बवण्डर का दिन होवैगा; <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />अर उनका राजा अपणे हाकिमां समेत गुलाम्मी म्ह जावैगा, यहोवा का योए वचन सै।”<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">मोआब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा न्यू कहवै सै: “मोआब के तीन के, बलके च्यार अपराध्धां कै कारण, मै उसकी सजा नै ना छोड़ूँगा; क्यूँके उसनै एदोम के राजा की हाड्डियाँ ताहीं जळाकै चूना कर दिया। <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />इस करकै मै मोआब देश म्ह आग लगाऊँगा, अर उसतै करिय्योत नगर के भवन भस्म हो जावैंगे<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="fq" closed="false">करिय्योत नगर के भवन भस्म हो जावैंगे </char><char style="ft" closed="false">अनेक नगर, यानिके नगरां का समूह सम्भवतः</char></note>; अर मोआब सोर सराबा अर ललकार, और नरसिंगे के शब्द होन्दे-होन्दे मर जावैगा। <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />मै उसके बीच म्ह तै न्यायी का नाश करुँगा, अर उसकै गैल उसके सारे हाकिमां नै भी घात करुँगा,” यहोवा का योए वचन सै।<verse eid="AMO 2:3" /></para>
  <para style="s">यहूदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />यहोवा न्यू कहवै सै: “यहूदा के तीन के, बलके च्यार अपराध्धां कै कारण, मै उसकी सजा नै ना छोड़ूँगा; क्यूँके उननै यहोवा के नियम-कायदे ताहीं निकम्मा जाण्या अर मेरी विधियाँ ताहीं न्ही मान्या; अर अपणे झूठ्ठे देवत्यां कै कारण जिनकै पाच्छै उनके पूर्वज चाल्‍लै थे, वे भी भटकगे सैं। <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />इस करकै मै यहूदा म्ह आग लगाऊँगा, अर उसतै यरुशलेम के भवन भस्म हो जावैंगे।”<verse eid="AMO 2:5" /></para>
  <para style="s">इस्राएल का न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />यहोवा न्यू कहवै सै: “इस्राएल के तीन के, बलके च्यार अपराध्धां कै कारण, मै उसकी सजा नै ना छोड़ूँगा; क्यूँके उननै निर्दोष ताहीं रपियाँ कै खात्तर अर गरीब ताहीं एक जोड़ी जूतियाँ कै खात्तर बेच दिया सै। <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />वे कंगालां के सिर पै की धूळ का भी लालच करै, अर नम्र माणसां नै राह तै हटा देवै सैं; अर बाप-बेट्टा दोन्‍नु एके गुलाम छोरी कै धोरै जावैं सैं, जिसतै मेरे पवित्र नाम ताहीं अपवित्र ठहरावै। <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />वे हर एक वेदी कै धोरै गुलाम के कपड़े पै सोवैं सैं, अर जुर्माने के रपियाँ तै मोल लिया होया दाखमधु अपणे देवता के घर म्ह पी लेवैं सैं।”<verse eid="AMO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9" />“मन्‍नै उनके स्याम्ही तै एमोरियां ताहीं नाश करया था, जिनकी लम्बाई देवदारां की जिसी, अर जिनका जोर बांज दरखतां का जिसा था; तोभी मन्‍नै उप्पर तै उसके फळ, अर नीच्‍चै तै उसकी जड़ नाश करी। <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />अर मै थारे ताहीं मिस्र देश तै लिकाड़ ल्याया, अर जंगळ म्ह चाळीस साल ताहीं लिए फिरदा रह्या, के थम एमोरियां के देश के अधिकारी हो जाओ। <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />अर मन्‍नै थारे बेट्टयाँ म्ह तै नबी होण कै खात्तर अर थारे कुछ जवान्‍नां म्ह तै नाज़ीर<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">नाज़ीर </char><char style="ft" closed="false">नाज़ीर वो माणस जिस ताहीं परमेसवर की सेवा खात्तर अलग राख्या जाया करै था। उस ताहीं अपणे बाल कटवाण या शराब पीण की अनुमति न्ही थी। उस ताहीं कई प्रतिज्ञाएँ लेणी पड़ै थी जिनका वर्णन नाज़ीर के नियम म्ह करया गया सै: <char style="xt"><ref loc="NUM 6:1-21">गिन. 6:1-21</ref></char></char></note> होण कै खात्तर ठहराया। हे इस्राएलियों, के यो सब सच न्ही सै?” यहोवा की याए वाणी सै।<verse eid="AMO 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 2:12" />लेकिन थमनै नाज़ीरां ताहीं दाखमधु प्याया, अर नबियाँ ताहीं हुकम दिया के भविष्यवाणी ना करैं।<verse eid="AMO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 2:13" />“देक्खो, मै थारे ताहीं इसा दबाऊँगा, जिस तरियां पूळयाँ तै भरी होई गाड्डी नीच्‍चै ताहीं दबाई जावै सै। <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />इस करकै तेज दौड़ण आळे ताहीं भाज्जण की जगहां ना मिलैगी, अर ताकतवर की ताकत कुछ काम न्ही देवैगी; अर ना पराक्रमी अपणी जान बचा सकैगा; <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />धनुर्धारी खड्या न्ही रह सकैगा, अर फुर्ती तै दौड़ण आळा ना बचैगा; घुड़सवार भी अपणी जान बचाकै न्ही भाग्गैगें; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />अर शूरवीरां म्ह जो घणा वीर हो, वो भी उस दिन नंगा होकै भाज जावैगा,” यहोवा की याए वाणी सै।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />हे इस्राएलियों, दण्ड का यो सन्देस सुणो जो यहोवा नै थारे बारे म्ह यानिके उस सारे कुल कै बारै म्ह कह्या सै जिसनै मै मिस्र देश तै ल्याया सूं: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“धरती के सारे कुलां म्ह तै मन्‍नै सिर्फ थारे पै मन लगाया सै<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">धरती के सारे कुलां म्ह तै मन्‍नै सिर्फ थारे पै मन लगाया सै </char><char style="ft" closed="false">माणस परमेसवर के जितना घणा धोरै आवै सै उतनाए घणा उसका चूकणा अर परीक्षा म्ह गिरणा बुरा होवै सै, उसनै भोत घणी कठोर सजा मिलै सै। परमेसवर तै नजदीकी अमूल्य सै, लेकिन एक महिमामय उपहार सै। आजाद इच्छा के दुरूपयोग कै कारण घणी महान आशीष सबतै भयानक दुःख म्ह बदल जावैं सै।</char></note>, इस कारण मै थारे सारे अधर्म कै काम की सजा देऊँगा।”<verse eid="AMO 3:2" /></para>
  <para style="s">भविष्यवक्ता का काम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />“आमोस नै फेर तै कह्या,” “जै दो माणस कठ्ठे सहमत ना हों, तो के वे एक साथ चाल सकैगें? <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />के शेर बिना शिकार पाए बण म्ह गरजैंगे? के जवान शेर बिना कुछ पकड़े अपणी माँद म्ह तै गुर्रावैगा? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />के चिड़िया बिना फंदा लगाऐ फँसैगी? के बिना कुछ फँसे फंदा धरती पै तै उचकैगा? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />के किसे नगर म्ह नरसिंगा फूँकण पै माणस ना थरथरावैंगे? के यहोवा के बिना भेज्जे किसे नगर म्ह कोए विपत्ति पड़ैगी? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />इस्से तरियां तै प्रभु यहोवा अपणे दास भविष्यवक्तावां पै अपणा मर्म बिना प्रगट करे कुछ भी ना करैगा।<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="REV 10:7">प्रका. 10:7</ref>; <ref loc="PSA 25:14">भजन. 25:14</ref>; <ref loc="JHN 15:15">यूह. 15:15</ref></char></char></note> <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />शेर गरज्या; कौण ना डरैगा? परमेसवर यहोवा बोल्या; कौण भविष्यवाणी ना करैगा?”<verse eid="AMO 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />अश्दोद के भवन अर मिस्र देश के राजभवन पै प्रचार करकै कहो: “सामरिया के पहाड़ां पै कठ्ठे होकै देक्खो के उस म्ह के कितना बड़ा रोळा अर उसके बीच कितणे अंधेर के काम हो रहे सैं!” <verse eid="AMO 3:9" /><verse number="10" style="v" sid="AMO 3:10" />यहोवा की या वाणी सै, “ये माणस अपणे भवनां म्ह उड़दंग अर डकैती का धन बटोरकै राक्खैं सैं, वे सिधाई तै काम करणा जाण्दे ए न्ही।” <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />इस करकै परमेसवर यहोवा न्यू कहवै सै: “देश का घेरण आळा एक दुश्मन होवैगा, अर वो तेरा बल तोड़ैगा, अर तेरे भवन लूटे जावैंगे।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />यहोवा न्यू कहवै सै: “जिस तरियां चरवाहा शेर के मुँह तै दो टाँग या कान का एक टुकड़ा छुड़ावै सै<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="fq" closed="false">जिस तरियां चरवाहा शेर के मुँह तै दो टाँग या कान का एक टुकड़ा छुड़ावै सै </char><char style="ft" closed="false">जिब जंगळी जानवरां के जरिये एक जानवर की मौत हो जावै, तो चरवाहे का कर्तव्य था के वो मृत पशु के कुछ टुकड़े माल्‍लिक नै दिखावै ताके वो जाण सके के जानवर किस तरियां मरया। जै चरवाहा इसा ना करै, तो उसनै जानवर के बदले माल्‍लिक ताहीं भुगताण करणा पड़ै था।</char></note>, उसे तरियां ए इस्राएली माणस, जो सामरिया म्ह बिछोणे के एक कुणा या रेशमी गद्दी पै बैठ्या करैं सैं, वे भी छुड़ाए जावैंगे।”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />सेनाओं के परमेसवर, प्रभु यहोवा की या वाणी सै, “देक्खो, अर याकूब के घरान्‍ने तै या बात चिताकै कहो: <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />जिस बखत मै इस्राएल नै उसके अपराध्धां की सजा देऊँगा, मै बेतेल की वेदियाँ नै भी नाश कर देऊँगा, अर वेदी के सींग टूटकै धरती पै गिर पड़ैंगे। <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />अर मै सर्दी के भवन ताहीं अर धूपकाल के भवन, दोनुआं नै गिराऊँगा; अर हाथी दाँन्द के बणे भवन भी नाश होवैंगें, अर बड़े-बड़े घर नाश हो जावैंगे,” यहोवा की याए वाणी सै।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />“हे बाशान की गायों<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">बाशान की गायों </char><char style="ft" closed="false">इस आयत म्ह सामरिया की प्रमुख जनानियाँ की तुलना बाशान की गांयां तै करी गई सै।</char></note>, यो वचन सुणो, थम जो सामरिया पहाड़ पै हो, जो कंगालां पै अंधेर करो, अर गरीबां ताहीं कुचल देओ सो, अर अपणे-अपणे घरआळे तै कहो सो, ‘ल्या, दे हम पीवां!’ <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />परमेसवर यहोवा अपणी पवित्रता की कसम खाकै कहवै सै, देक्खो, थारे पै इसे दिन आण आळे सैं, के थम काण्डयाँ तै, अर थारी औलाद मछली की बंसियां तै खींच ली जावैंगी। <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />अर थम बाड़े के नाकां तै होकै सीध्धी लिकड़ जाओगी अर हेर्मोन म्ह डाली जाओगी,” यहोवा की याए वाणी सै।<verse eid="AMO 4:3" /></para>
  <para style="s">इस्राएल सुधरण म्ह असफल</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />“बेतेल नगर म्ह आकै अपराध करो, अर गिलगाल नगर म्ह आकै भोत सा अपराध करो; अपणे चढ़ावे सबेर ताहीं, अर अपणे दशमांश हर तीसरे दिन ले आया करो; <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />धन्यवाद-बलि खमीर परमेसवर नै चढ़ाओ, अर अपणे स्वेच्छाबलियां का जिक्र चलाकै उनका प्रचार करो; क्यूँके हे इस्राएलियों, इसा करणा थमनै भावै सै,” परमेसवर यहोवा की याए वाणी सै।<verse eid="AMO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6" />“मन्‍नै थारे सारे नगरां म्ह दाँन्द की सफाई करा दी, अर थारी सारी जगहां म्ह रोट्टी की घटी करी सै, फेर भी थम मेरी ओड़ मुड़कै ना आए,” यहोवा की याए वाणी सै।<verse eid="AMO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 4:7" />“अर जिब कटणी के तीन महिन्‍ने रहगे, फेर मन्‍नै थारे खात्तर बारिस ना करी; मन्‍नै एक नगर म्ह पाणी बरसा कै दुसरे म्ह ना बरसाया; एक खेत म्ह पाणी बरस्या, अर दूसरा खेत जिस म्ह ना बरस्या; वो सूख ग्या। <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />इस करकै दो तीन नगरां के माणस पाणी पीण नै मारे-मारे फिरदे होए एके नगर म्ह आए, लेकिन छिके कोनी; फेर भी थम मेरी और ना फिरे,” यहोवा की याए वाणी सै।<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />“मन्‍नै थारे ताहीं लूह अर गेरूई तै मारया सै; अर जिब थारी वाटिका अर दाख की बारियाँ, अर अंजीर अर जैतून के पेड़ घणे होगे, फेर टिड्डियाँ उननै खागी; फेर भी थम मेरी ओड़ मुड़कै ना आए,” यहोवा की याए वाणी सै।<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />“मन्‍नै थारे बीच म्ह मिस्र देश की जिसी मरी फैलाई<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="fq" closed="false">मन्‍नै थारे बीच म्ह मिस्र देश की जिसी मरी फैलाई </char><char style="ft" closed="false">परमेसवर नै मिस्र कै गैल कठोर बरताव करया था, उसके पाच्छै उननै पैहले तै ए चेतावनी दे दी थी के जै उननै हुकम न्ही मान्या तो परमेसवर उनपै वे सब महामारियाँ ले आवैगा जो मिस्र-वासियाँ पै ल्याया था अर उनतै वे डरै थे।</char></note>; मन्‍नै थारे घोड़यां ताहीं खुसवा कै थारे जवान्‍नां ताहीं तलवार तै घात करा दिया; अर थारी छावणी की दुर्गन्‍ध थारै धोरै पोहचाई; फेर भी थम मेरी ओड़ मुड़कै ना आए,” यहोवा की याए वाणी सै।<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />“मन्‍नै थारे म्ह तै कईयाँ ताहीं इसा उलट दिया, जिस तरियां परमेसवर नै सदोम अर गमोरा नगर ताहीं उलट दिया था, अर थम आग तै लिकाड़ी होई लाकड़ी के जिसे ठहरे; फेर भी थम मेरी ओड़ मुड़कै ना आए,” यहोवा की याए वाणी सै।<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 19:24-25">उत्प. 19:24-25</ref></char></char></note><verse eid="AMO 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 4:12" />“इस कारण, हे इस्राएल, मै तन्‍नै दण्ड देण पै सूं।, अर इस करकै के मै तेरै म्ह यो काम करण पै सूं, हे इस्राएल, अपणे परमेसवर कै स्याम्ही आण कै खात्तर त्यार हो जा!<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="fq" closed="false">परमेसवर कै स्याम्ही आण कै खात्तर त्यार हो जा! </char><char style="ft" closed="false">न्याय कै खात्तर आम्ही-स्याम्ही, आखरी मौक्‍का सै।</char></note>”<verse eid="AMO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 4:13" />देख, पहाड़ां का बणाण आळा अर हवा का सिरजण आळा, अर माणस ताहीं उसके मन का विचार बताण आळा अर भोर ताहीं अन्धकार करण आळा, अर जो धरती की ऊँच्‍ची जगहां पै चाल्‍लण आळा सै, उसे का नाम सेनाओं का परमेसवर यहोवा सै!<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="2CO 6:18">2 कुरि. 6:18</ref></char></char></note><verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">पश्चाताप करण का आह्वान</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />आमोस नै कह्या, हे इस्राएल के घरान्‍ने, इस विलाप के गीत के वचन सुण जो मै थारे बारै म्ह कहूँ सूं: <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />“इस्राएल की कुवारी कन्या गिरगी, अर फेर उठ ना सकैगी; वो अपणी ए धरती पै पटक दी गई सै, अर उसका ठाण आळा कोए न्ही।”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />क्यूँके परमेसवर यहोवा न्यू कहवै सै, “जिस नगर तै हजार लिकड़ै थे, उस म्ह इस्राएल के घरान्‍ने के सौ ए बचे रहवैंगे, अर जिसतै सौ लिकड़ै थे, उस म्ह दस बचे रहवैंगे।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />यहोवा, इस्राएल के घरान्‍ने तै न्यू कहवै सै, मेरी खोज म्ह लाग्गो, फेर जिन्दा रहोगे<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="fq" closed="false">मेरी खोज म्ह लाग्गो, फेर जिन्दा रहोगे </char><char style="ft" closed="false">परमेसवर ताहीं खोजणा जीवन सै परमेसवर ताहीं खोज्जण पै वो मिल ज्या सै अर परमेसवर जीवन सै वो जीवन का स्रोत सै।</char></note>। <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />बेतेल म्ह मूर्तिपूजक वेदियाँ की आराधना मत करो, ना गिलगाल के मंदरा म्ह बड़ो, अर ना बेर्शेबा ताहीं जाओ; क्यूँके गिलगाल पक्‍का गुलाम्मी म्ह जावैगा, अर बेतेल सुन्‍ना पड़ैगा।<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />यहोवा की खोज करो, फेर जिन्दा रहोगे, न्ही तो वो यूसुफ के घरान्‍ने पै आग की तरियां भड़कैगा, अर वो उसनै भस्म करैगी, अर बेतेल म्ह कोए उसका बुझाण आळा न्ही होवैगा। <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />हे न्याय के बिगाड़ण आळेयो अर धार्मिकता ताहीं माट्टी म्ह मिलाण आळेयो!<verse eid="AMO 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 5:8" />जो कचपचिया अर मृगशिरा<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="fq" closed="false">कचपचिया अर मृगशिरा </char><char style="ft" closed="false">बसंत और शरद ऋतु के तारे</char></note> का बणाण आळा सै, जो घोर अन्धकार ताहीं भोर का प्रकाश बणावै सै, जो दिन नै अन्धकार करकै रात बणा देवै सै, अर समुन्दर का पाणी स्थल कै उप्पर बह्या देवै सै, उसका नाम यहोवा सै। <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />वो तावळी ए ताकत्त वर ताहीं विनाश कर देवै, अर गढ़ का भी सत्यानाश करै सै।<verse eid="AMO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />जो सभा म्ह उल्हाणा देवै सै उसतै वे बैर राक्खै सैं, अर खरी बात बोलण आळे तै नफरत करै सैं।<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="GAL 4:16">गला. 4:16</ref></char></char></note> <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />थम जो कंगालां नै लताड़या करो, अर भेंट कहकै उनतै अन्‍न खोस लेओ सो, इस करकै जो घर थमनै गढ़े होए पत्थरां के बणाए सैं, उन म्ह रहण न्ही पाओगे; अर जो मनभावणी दाख की बारियाँ थमनै लगाई सैं, उनका दाखमधु ना पीण पाओगे। <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />क्यूँके मै जाणु सूं के थारे पाप भारी सैं। थम धर्मी नै सताओ अर घूस लेओ, अर फाटक म्ह गरीबां का न्याय बिगाड़ो सो। <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />इस कारण जो बुद्धिमान हो, वो इसे बखत चुप रहवै, क्यूँके बखत बुरा सै।<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="EPH 5:16">इफि. 5:16</ref></char></char></note><verse eid="AMO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14" />हे माणसों, बुराई नै न्ही, भलाई नै ढूँढ़ो, ताके थम जिन्दा रहो; अर थारा यो कहणा सच ठहरै के सेनाओं का परमेसवर यहोवा थारे गैल सै। <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुराई तै बैर अर भलाई तै प्यार राक्खो, अर फाटक म्ह न्याय नै मजबूत करो; के बेरा सेनाओं का परमेसवर यहोवा यूसुफ के बचे होया पै अनुग्रह कर दे।<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ROM 12:9">रोम. 12:9</ref></char></char></note><verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />इस कारण सेनाओं का परमेसवर, प्रभु यहोवा न्यू कहवै सै: “सारे चौकां म्ह रोणा-पीटणा होवैगा; अर सारी सड़कां पै माणस हाय, हाय, करैंगे! वे किसानां नै शोक करण कै खात्तर, अर जो माणस विलाप करण म्ह निपुण सैं, उननै रोण-पीटण नै बुलावैंगे। <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />अर सारी दाख की बारियाँ म्ह रोणा-पीटणा होवैगा,” क्यूँके यहोवा न्यू कहवै सै, “मै थारे बीच म्ह तै होकै जाऊँगा।”<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />एक और बार आमोस नै कह्या थारे पै, जो यहोवा के न्याय के दिन की इच्छा करो सो! यहोवा के दिन तै थारा के फायदा होवैगा? वो तो उजियाले का न्ही, अंधियारे का दिन होवैगा। <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />जिस तरियां कोए शेर तै भाज्जै अर उसनै भालू मिलै; या घर म्ह आकै दीवार पै हाथ टेकै अर नाग उसनै डसै। <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />के यो सच न्ही सै के यहोवा का दिन उजियाले का न्ही, बलके अंधियारे ए का होवैगा? हाँ, इसे घोर अन्धकार का जिस म्ह कुछ भी चमक ना हो।<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />यहोवा कहवै सै, “मै थारे पर्वां तै बैर राक्खूँ, अर उननै निकम्मा जाणु सूं, अर थारी महासभा तै मै खुश न्ही। <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />चाहे थम मेरे खात्तर होमबलि अर अन्‍नबलि चढ़ाओ, तोभी मै खुश न्ही होऊँगा, अर थारे पाळे होए पशुआं के मेलबलियां की और ना देखूँगा। <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />अपणे गीतां का शोर-सराबा मेरे तै दूर करो; थारी सारंगियाँ का सुर मै न्ही सुणूँगा। <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />लेकिन न्याय नै नदी की तरियां, अर धार्मिकता ताहीं महानद की तरियां बहण द्यो।”<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“हे इस्राएल के माणसों, थम जंगळ म्ह चाळीस साल ताहीं पशुबलि अर अन्‍नबलि के मेरे ताहीं ए चढ़ान्दे रहे<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="fq" closed="false">थम जंगळ म्ह चाळीस साल ताहीं पशुबलि अर अन्‍नबलि के मेरे ताहीं ए चढ़ान्दे रहे </char><char style="ft" closed="false">इस्राएल अपणी अधुरी सेवा के जरिये खुद नै सही ठहरान्दा रहवै था उनका मन परमेसवर के प्रति आच्छी ढाळ समर्पित न्ही था, वे कुछ श्रद्धा अर्पित करकै परमेसवर के ग्रहणयोग्य पात्र होणा चाहवैं थे।</char></note>? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />न्ही, थम तो अपणे राजा का तम्बू, अर अपणी मूरतां की चरणपीठ, अर अपणे देवता का तारा लिए फिरदे रहे, जिन ताहीं थमनै अपणे खात्तर बणाया सै।<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="ACT 7:42-43">प्रेरि. 7:42-43</ref></char></char></note> <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />इस करकै मै थमनै दमिश्क के उस पार गुलाम्मी म्ह कर दियुँगा, सेनाओं के परमेसवर यहोवा का योए वचन सै।”<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />“हाय उनपै जो सिय्योन म्ह सुख तै रहवै, अर उनपै जो सामरिया नगर के पहाड़ पै बेफिकर रहवै सै<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="fq" closed="false">सामरिया नगर के पहाड़ पै बेफिकर रहवै सै </char><char style="ft" closed="false">परमेसवर म्ह न्ही, सामरिया एक शक्तिशाली नगर था अर इस्राएल के जरिये लिया गया आखरी नगर था।</char></note>, वे जो सब तै बढ़िया जात्ति म्ह प्रसिद्ध सैं, जिनके धोरै इस्राएल<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="fq" closed="false">इस्राएल </char><char style="ft" closed="false">यरुशलेम नगर</char></note> का घरान्‍नां आवै सै! <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने नगर नै जाकै देक्खो, अर ओड़ै तै हमात नाम के बड़े नगर ताहीं जाओ; फेर पलिश्तियाँ के गत नगर ताहीं जाओ। के वे थारे दो राज्य यहूदा और इस्राएल तै बढ़िया सैं? के उनका देश थारे देश तै कुछ बड़ा सै? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />थम बुरे दिन नै दूर कर देन्दे, अर उड़दंग की गद्दी नै धोरै ले आओ सो।”<verse eid="AMO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 6:4" />“थम हाथी दाँन्द के पलंगां पै लेटदे, अर अपणे-अपणे बिछोणे पै पैर पसारे सोओ सो, अर भेड़-बकरियाँ म्ह तै मेम्‍ने अर गऊशाळा म्ह तै बाछड़े खाओ हो। <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />थम सारंगी कै गैल गीत गाओ, अर दाऊद की तरियां ढाळ-ढाळ के बाजे बुद्धि तै लिकाड़ो सो; <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />अर कटोरयां म्ह तै दाखमधु पीओ, अर बढ़िया-बढ़िया तेल लगाओ सो, लेकिन यूसुफ पै आणआळी मुसीबत<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="fq" closed="false">यूसुफ पै आणआळी मुसीबत </char><char style="ft" closed="false">इस्राएल का विनाश</char></note> का हाल सुणकै शोकित न्ही होन्दे। <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />इस कारण वे इब गुलाम्मी म्ह पैहला जावैंगे, अर जो पैर पसारे सोवैं थे, उनकी विलासिता जान्दी रहवैगी।”<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />सेनाओं के परमेसवर यहोवा की याए वाणी सै, (परमेसवर यहोवा नै अपणी ए कसम खाकै कह्या सै): “जिसपै याकूब घमण्ड करै सै, उसतै मै घृणा, अर उसके राज-भवनां तै बैर राक्खूँ सूं; अर मै इस नगर नै उन सारया समेत जो उस म्ह सै, दुश्मन के बस म्ह कर दियुँगा।”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />जै कर किसे घर म्ह दस माणस बचे रहें, तोभी वे मर जावैंगे। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />जिब किसे का चाचा, जो उसका जळाण आळा हो, उसकी हड्डियाँ ताहीं घर तै लिकाड़ण कै खात्तर ठावैगा, अर जो घर के कुण्यां म्ह हो उसतै कहवैगा, “के तेरे धोरै कोए और सै?” फेर वो कहवैगा, “कोए न्ही;” फेर वो कहवैगा, “चुप रह! हमनै यहोवा का नाम न्ही लेणा चाहिए।”<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />क्यूँके यहोवा के हुकम तै बड़े घर म्ह छेद, अर छोट्टे घर म्ह दरार होवैगी। <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />के घोड़े चट्टान पै दौड़ै? के कोए इसी जगहां म्ह बळधां तै जोत्तै जड़ै थमनै न्याय ताहीं जहर तै, अर धार्मिकता के फळ ताहीं कड़वे फळ म्ह बदल डाल्या सै? <verse eid="AMO 6:12" /><verse number="13" style="v" sid="AMO 6:13" />थम इसी चीज कै कारण आनन्द करो सो जो बेकार सै; अर कहो सो, “के हम अपणी ए कोशिश तै ताकतवर न्ही होए?” <verse eid="AMO 6:13" /><verse number="14" style="v" sid="AMO 6:14" />इस करकै सेनाओं के परमेसवर यहोवा की या वाणी सै, “हे इस्राएल के घरान्‍ने, देख, मै थारे खिलाफ एक इसी जात्ति खड़ी करुँगा, जो हमात की घाटी तै लेकै अराबा की नदी किनारे ताहीं थमनै संकट म्ह गेरैगी।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">विनाश के तीन दर्शन टिड्डियाँ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />परमेसवर यहोवा नै मेरे ताहीं यो दिखाया: अर मै के देक्खूँ सूं के उसनै पिछली घास के उगण के शरुआत म्ह टिड्डियाँ पैदा करी; अर वो राजा की कटणी के बाद की पिछली घास थी। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जिब वे टिड्डियाँ घास खा चुकीं, फेर मन्‍नै कह्या, “हे परमेसवर यहोवा, अपणे माणसां माफ कर! न्ही तो याकूब किस तरियां स्थिर रह सकैगा? वो कितना कमजोर सै!” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />इसके बारे म्ह यहोवा पछताया, अर उसतै कह्या, “इसी बात इब न्ही होवैगी।”<verse eid="AMO 7:3" /></para>
  <para style="s">आग</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />परमेसवर यहोवा नै मेरे ताहीं यो दिखाया: अर के देक्खूँ सूं के परमेसवर यहोवा नै आग के जरिये मुकद्दमा लड़ण ताहीं पुकारया, अर उस आग तै महासागर सूख ग्या, अर देश भी भस्म होण लाग्या था। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />फेर मन्‍नै बिनती करी, “हे परमेसवर यहोवा, रुक जा! न्ही तो याकूब किस तरियां स्थिर रह सकैगा? वो कितना कमजोर सै।” <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />इसके बारै म्ह भी यहोवा पछताया; अर परमेसवर यहोवा नै कह्या, “इसी बात फेर न्ही होवैगी।”<verse eid="AMO 7:6" /></para>
  <para style="s">साहुल</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />यहोवा नै मेरे ताहीं यो भी दिखाया: मन्‍नै देख्या के प्रभु साहुल लगाकै बणाई होई किसे दीवार पै खड्या सै, अर उसके हाथ म्ह साहुल सै। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />अर यहोवा नै मेरे ताहीं कह्या, “हे आमोस, तेरे ताहीं के दिखाई देवै सै?” मन्‍नै कह्या, “एक साहुल।” फेर परमेसवर नै जवाब दिया, “देख, मै अपणी प्रजा इस्राएल के बीच म्ह साहुल लगाऊँगा। <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />मै इब उननै ना छोड़ूँगा। इसहाक की ऊँच्‍ची जगहां उजाड़, अर इस्राएल के पवित्रस्‍थान सुनसान हो जावैंगे, अर मै यारोबाम के वंश नै खतम कर दियुँगा।”<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस अर अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />फेर बेतेल के याजक अमस्याह<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="fq" closed="false">याजक अमस्याह </char><char style="ft" closed="false">वो हो सकै के प्रधान पुरोहित था हारुन के क्रम म्ह अर परमेसवर जरिये ठहराया</char></note> नै इस्राएल के राजा यारोबाम के धोरै कुह्वा भेज्या, “आमोस नै इस्राएल के घरान्‍ने के बीच म्ह तेरै तै राजद्रोह की साजिस करी सै; उसके सारे वचनां नै देश न्ही सह सकदा। <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />क्यूँके आमोस न्यू कहवै सै, ‘यारोबाम तलवार तै मारया जावैगा, अर इस्राएल अपणी धरती पै तै पक्‍का गुलाम्मी म्ह जावैगा।’”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />फेर अमस्याह नै आमोस तै कह्या, “हे नबी, उरै तै लिकड़कै यहूदा देश म्ह भाज ज्या, अर ओड़ैए रोट्टी खाया कर, अर ओड़ैए भविष्यवाणी करया कर; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पर बेतेल म्ह फेर कदे भविष्यवाणी ना करिये, क्यूँके यो राजा का पवित्रस्‍थान अर राज-नगर<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="fq" closed="false">राज-नगर </char><char style="ft" closed="false">यानिके परमेसवर का मन्दर</char></note> सै।” <verse eid="AMO 7:13" /><verse number="14" style="v" sid="AMO 7:14" />आमोस नै उत्तर देकै अमस्याह तै कह्या, “मै उस तरियां का भविष्यवक्ता कोनी, जो पईसे लेकै भविष्यवाणी करुँ, मै तो गां-बळधां का पाळी, अर गूलर के दरखतां का छाँटण आळा था, <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />अर यहोवा नै मेरे ताहीं भेड़-बकरियाँ के पाच्छै-पाच्छै फिरण तै बुलाकै कह्या, ‘जा, मेरी प्रजा इस्राएल तै भविष्यवाणी कर।’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />इस करकै इब तू यहोवा का वचन सुण, तू कहवै सै, ‘इस्राएल कै खिलाफ भविष्यवाणी ना करिये; अर इसहाक के घरान्‍ने कै खिलाफ बार-बार वचन ना सुणावै।’ <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />इस करकै, हे अमस्याह, यहोवा तेरे तै न्यू कहवै सै: ‘तेरी जनान्‍नी नगर म्ह वेश्या हो जावैगी, अर तेरे बेट्टे-बेटियाँ तलवार तै मारे जावैंगी, अर तेरी धरती डोरी डालकै बाँट ली जावैंगी; अर तू आप मूर्तिपूजक देश म्ह मरैगा, अर इस्राएल अपणी धरती पै तै पक्‍का गुलाम्मी म्ह जावैगा।’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फळां तै भरी टोकरी का दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />इसके बाद यहोवा नै मेरे ताहीं यो दिखाया: के, धूपकाल के फळां<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">धूपकाल के फळां </char><char style="ft" closed="false">यानिके अंजीर</char></note> तै भरी होई एक टोकरी सै। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />अर यहोवा नै मेरे तै पुच्छा, “हे आमोस, तेरे ताहीं के दिखाई देवै सै?” मन्‍नै कह्या, “धूपकाल के फळां तै भरी एक टोकरी।” फेर यहोवा नै मेरे ताहीं कह्या, “मेरी प्रजा इस्राएल का अन्त आ ग्या सै; मै इब उस ताहीं और न्ही छोड़ूँगा।” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />परमेसवर यहोवा की याए वाणी सै, “उस दिन राजमन्दर के गीत हाहाकार म्ह बदल जावैंगे<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="fq" closed="false">उस दिन राजमन्दर के गीत हाहाकार म्ह बदल जावैंगे </char><char style="ft" closed="false">आनन्द का स्वर विलाप म्ह बदल जावैगा, सब कुछ पूर्ण विशाद म्ह बदल जावैगा।</char></note>, अर लाशां का बड़ा ढेर लागैगा; अर सारी जगहां म्ह वे चुपचाप फेंक दिए जावैंगे।”<verse eid="AMO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />यो सुणो, थम जो गरीबां ताहीं निगळणा अर देश के नम्र माणसां नै नाश करणा चाहो सो, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />जो कहवै सै, “नया चाँद कद बीत्तैगा के हम अन्‍न बेच सकां? अर विश्रामदिन कद बीत्तैगा, के हम अन्‍न के खत्ते खोलकै एपा ताहीं छोट्टा अर शेकेल नै भारी कर देवां, छळ के तराजू तै धोखा देवां, <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />के हम कंगालां नै रुपया देकै, अर गरीबां ताहीं एक जोड़ी जूत्ती देकै मोल लेवां, अर खराब अनाज बेचा?”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />यहोवा, जिसपै याकूब नै घमण्ड करणा ठीक सै, वोए अपणी कसम खाकै कहवै सै, “मै थारे किसे काम नै कदे न्ही भूलूँगा। <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />के इस कारण धरती ना काँम्बैगी? के उस म्ह के सारे रहण आळे विलाप ना करैंगे? यो देश सारे का सारा मिस्र देश की नील नदी की तरियां होवैगा, जो बढै़ सै, फेर लहर मारै, अर घट जावै सै।”<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />परमेसवर यहोवा की या वाणी सै, “उस बखत मै सूरज नै दोपहर के बखत डुबोऊगाँ<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="fq" closed="false">उस बखत मै सूरज नै दोपहर के बखत डुबोऊगाँ </char><char style="ft" closed="false">तेज रोशनी के विपरीत अन्धकार घणा अर काळा होवैगा।</char></note>, अर इस देश नै दिन-दोफारी अंधियारा कर दियुँगा<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 27:45">मत्ती 27:45</ref>; <ref loc="MRK 15:33">मर. 15:33</ref>; <ref loc="LUK 23:44-45">लूका. 23:44-45</ref></char></char></note>। <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />मै थारे पर्वां के त्यौहारां नै दूर करकै विलाप कराऊँगा, अर थारे सारे गीतां नै दूर करकै विलाप के गीत गवाऊँगा; मै थारी सब की कमर म्ह टाट बँधाऊँगा, अर थारे सारया के सिरां नै मुँण्डाऊँगा; अर इसा विलाप कराऊँगा जिसा इकलौते कै खात्तर होवै सै, अर उसका अन्त मुश्किल दुःख के दिन का जिसा होवैगा।”<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />परमेसवर यहोवा की या वाणी सै, “देक्खो, इसे दिन आवै सैं, जिब मै इस देश म्ह अकाळ गेरूँगा; उस म्ह ना तो अन्‍न की भूख अर ना पाणी की प्यास होवैगी, लेकिन यहोवा के वचनां के सुणण ए की ए भूख प्यास होवैगी। <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />अर माणस यहोवा के वचन की खोज म्ह समुन्दर तै समुन्दर ताहीं अर उत्तर तै पूरब ताहीं मारे-मारे फिरैंगे, पर उस नै न्ही पावैंगें।”<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“उस बखत सुन्दर कुवारी अर जवान दोन्‍नु प्यास कै मारे बेहोंस होवैंगे। <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />जो माणस सामरिया के दोष देवता की कसम खावै सैं, अर जो कहवै सैं, ‘दान के देवता के जीवन की कसम,’ अर बेर्शेबा के पन्थ की कसम, वे सारे गिर पड़ैंगे, अर फेर न्ही उठैगें।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">परमेसवर का न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />मन्‍नै प्रभु ताहीं दर्शन म्ह वेदी कै पास खड्या देख्या, अर उसनै हुकम दिया, “खम्भे की कँगणियाँ पै मार जिसतै देहळी हिलै, अर उननै सारे माणसां के सिर पै गिराकै टुकड़े-टुकड़े कर; अर जो नाश होण तै बचै, उननै मै तलवार तै घात करुँगा; उन म्ह तै एक भी ना भाज सकै, अर जो अपणे ताहीं बचावै, वो बचण न्ही पावैगा।<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 68:21">भजन. 68:21</ref></char></char></note>”<verse eid="AMO 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 9:2" />“क्यूँके चाहे वे खोदकै अधोलोक म्ह उतर जावैं<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="fq" closed="false">चाहे वे खोदकै अधोलोक म्ह उतर जावैं </char><char style="ft" closed="false">ऊँचाई अर गहराई परमेसवर की सर्वव्यापिता म्ह अर्थहीन सै। अधोलोक परमेसवर तै घणा भययोग्य न्ही सै पापी सहर्ष नरक म्ह खुदाई कर ले अर खुद नै छिपा ले, मुर्दयां म्ह जिन्दा, जै इसा करकै वो परमेसवर की नजर तै खुद नै छिपा सकै सै।</char></note>, तो ओड़ै तै मै हाथ बढ़ाकै उननै ल्याऊँगा; चाहे वे अकास पै चढ़ जावैं, तो ओड़ै तै भी मै उननै उतार ल्याऊँगा। <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />चाहे वे कर्मेल पहाड़ म्ह छिप जावैं, लेकिन ओड़ै भी मै उननै ढूँढ-ढूँढ कै पकड़ ल्यूँगा, अर चाहे वे समुन्दर की थाह म्ह मेरी नजर तै ओट हों, ओड़ै भी मै साँप ताहीं उननै डसण का हुकम देऊँगा। <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />चाहे दुश्मन उननै हाँक कै गुलाम्मी म्ह ले जावैं, ओड़ै भी मै हुकम देकै तलवार तै उननै घात कराऊँगा; अर मै उनपै भलाई करण कै खात्तर न्ही, बुराई ए करण कै खात्तर नजर करुँगा।”<verse eid="AMO 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 9:5" />सेनाओं के परमेसवर यहोवा के छूण तै धरती पिघळै सै, अर उसके सारे रहण आळे विलाप करै सैं; अर वो सारे के सारे मिस्र की नदी की तरियां हो जावैं सैं, जो बढै़ सै फेर लहर मारै, अर घट जावैं सै। <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />जो अकास म्ह अपणी कोठड़ी बणावै, अर अपणे अकासमण्डल की नींव धरती पै डाल्‍लै, अर समुन्दर का पाणी धरती पै बह्या देवै सै, उसे का नाम यहोवा सै।<verse eid="AMO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />“हे इस्राएलियों,” यहोवा की या वाणी सै, “के थम मेरै खात्तर कूश देश के माणसां की तरियां न्ही सो? के मै इस्राएल ताहीं मिस्र देश तै अर पलिश्तियाँ ताहीं कप्तोर देश तै न्ही लिकाड़ ल्याया? अर अरामियां ताहीं कीर देश तै न्ही लिकाड़ ल्याया? <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />देक्खो, परमेसवर यहोवा की नजर इस पापमय राज्य पै लाग्गी सै, अर मै इसनै धरती पै तै नाश करुँगा; तोभी मै पूरी तरियां तै याकूब के घरान्‍ने नै नाश न्ही करुँगा,” यहोवा की याए वाणी सै।<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />“मेरे हुकम तै इस्राएल का घरान्‍नां सारी जातियाँ म्ह इसा चाल्या जावैगा जिसा अन्‍न चलणी म्ह चाल्या जावै सै, लेकिन उसका एक भी बढ़िया दाणा धरती पै ना गिरैगा। <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />मेरी प्रजा म्ह के सारे पापी जो कहवै सैं, ‘वो विपत्ति म्हारे पै ना पड़ैगी, अर ना हमनै घेरैगी,’ वे सारे तलवार तै मारे जावैंगे।”<verse eid="AMO 9:10" /></para>
  <para style="s">इस्राएल का दोबारा निर्माण</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />यहोवा नै कह्या, “उस बखत मै दाऊद की गिरी होई झोपड़ी<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="fq" closed="false">दाऊद की गिरी होई झोपड़ी </char><char style="ft" closed="false">पतन होया राज्य</char></note> नै खड्या करुँगा, अर उसके बाड़े के नाकां ताहीं सुधारूँगा, अर उसके खण्डहरां नै फेर बणाऊँगा, अर जिसा वो पुराणे बखत म्ह था, उस ताहीं उसाए बणा दियुँगा; <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />जिसतै वे बचे होए एदोमियां नै बलके सारी जात्तां ताहीं जो मेरी कुहवावै सैं, अपणे हक म्ह लेवैं,” यहोवा जो यो काम पूरा करै सै, उसकी याए वाणी सै।<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="ACT 15:16-18">प्रेरि. 15:16-18</ref></char></char></note><verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />यहोवा की यो भी वाणी सै, “देक्खो, इसे दिन आवैं सैं, के हळ जोत्तण आळा लवण आळे ताहीं अर दाख रोंदण आळा बीज बोण आळे ताहीं जा लेवैगा; अर पहाड़ां तै नया दाखमधु टपकण लागैगा, अर सारी पहाड़ियाँ तै बह लिकड़ैगा। <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />मै अपणी प्रजा इस्राएल के कैदियाँ नै बोहड़ा ले आऊँगा, अर वे उजड़े होए नगरां ताहीं सुधारकै उन म्ह बसैंगे; वे दाख के बाग लगाकै दाखमधु पीवैंगे, अर बगीचे लगाकै उनके फळ खावैंगे। <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />मै उननै, उन्हे की धरती म्ह बोऊँगा, अर वे अपणी धरती म्ह तै जो मन्‍नै उन ताहीं दी सै, फेर कदे उखाड़े न्ही जावैंगे,” थारे परमेसवर यहोवा का योए वचन सै।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>