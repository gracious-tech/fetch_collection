  <para style="h">1 राजाओं</para>
  <para style="toc1">राजाओं की पैहली किताब</para>
  <para style="toc2">1 राजाओं</para>
  <para style="toc3">1 राजा.</para>
  <para style="mt">राजाओं की पैहली किताब</para>
  <para style="is">लेखक</para>
  <para style="ip">1 राजाओं का लेखक अज्ञात सै फेर भी कुछ जाणकार एज्रा, यहेजकेल अर यिर्मयाह नै लगभग इसका लेखक कहवै सै। क्यूँके इस किताब म्ह 400 साल्‍लां तै घणे बखत के जिक्र सै, इसके संकलन म्ह अनेक स्रोत काम म्ह लिए गए सै। साहित्यिक शैलियाँ, विषय आदि पूरी किताब म्ह अन्त निवेषित पाए जावै सै अर इस्तमाल म्ह ली गई सामग्री की प्रकृति तै संकेत मिलै सै के लेखक या संग्रहकर्ता अनेक न्ही एके सै।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">लगभग 590-538 ई. पू.</para>
  <para style="ip">या किताब उस बखत लिखी गई थी जिब पैहला आराधनालय मौजूद था। (<char style="xt"><ref loc="1KI 8:8">1 राजा. 8:8</ref></char>)</para>
  <para style="is">प्रापक</para>
  <para style="ip">इस्राएल की प्रजा अर सारे बाइबल पढ़ण आळे</para>
  <para style="is">मकसद</para>
  <para style="ip">या किताब 1 अर 2 शमूएल की उत्तर कथा सै अर दाऊद के मरण कै बाद सुलैमान के राजा होण के वर्णन तै शरु होवै सै। इसकी कहाणी संगठित राज्य तै शरु होकै विभाजित राज्य यहूदा अर इस्राएल पै आकै खतम होवै सै। इब्रानी बाइबल म्ह पैहला राजा अर दूसरा राजा एके ग्रन्थ सै।</para>
  <para style="is">खास बातें</para>
  <para style="ip">विघटन</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. सुलैमान का राज्य <char style="ior"><ref loc="1KI 1:1-11:43">1:1-11:43</ref></char></para>
  <para style="io1">2. राज्य का बटवारा <char style="ior"><ref loc="1KI 12:1-16:34">12:1-16:34</ref></char></para>
  <para style="io1">3. एलिय्याह अर अहाब <char style="ior"><ref loc="1KI 17:1-22:53">17:1-22:53</ref></char></para>
  <chapter number="1" style="c" sid="1KI 1" />
  <para style="s">अदोनिय्याह की राजद्रोह की योजना</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1" />इब दाऊद राजा घणा बूढ़ा अर उसकी उम्र घणीए बढ़गी थी; अर उस ताहीं काम्बळ भी ओढ़ाए जावैं थे, फेर भी वो गरम न्ही होया करै था। <verse eid="1KI 1:1" /><verse number="2" style="v" sid="1KI 1:2" />उसके कर्मचारियाँ नै उसतै कह्या, “म्हारे प्रभु राजा कै खात्तर कोए जवान कुँवारी ढूँढ़ी जावै, जो राजा कै स्याम्ही रहकै तेरी सेवा करया करै अर तेरै धोरै लेटै, के म्हारे प्रभु राजा नै गर्मी<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">गर्मी </char><char style="ft" closed="false">या सिर्फ शरीर की गर्मी खात्तर सै</char></note> पोहचै।” <verse eid="1KI 1:2" /><verse number="3" style="v" sid="1KI 1:3" />फेर उननै सारे इस्राएली देश म्ह सुथरी कुँवारी ढूँढ़दे-ढूँढ़दे शूनेम नगर की रहण आळी अबीशग नाम की एक छोरी ताहीं पाया, अर उस ताहीं राजा कै धोरै ले आए। <verse eid="1KI 1:3" /><verse number="4" style="v" sid="1KI 1:4" />वा छोरी घणीए सुथरी थी; अर वा राजा की दास्सी बणकै उसकी सेवा करदी रही; पर राजा नै उसकै गैल सहवास न्ही करया। <verse eid="1KI 1:4" /><verse number="5" style="v" sid="1KI 1:5" />फेर एक दिन दाऊद की घरआळी हग्गीत का बेट्टा अदोनिय्याह<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">अदोनिय्याह </char><char style="ft" closed="false">यो दाऊद का चौथा बेट्टा था अर उसका जन्म तब होया था जिब दाऊद हेब्रोन तै राज करै था। उसके तीन बड़े भाईयाँ के मरण कै पाच्छै इब वोए सबतै बड़ा था।</char></note> सिर ऊँच्‍चा करकै कहण लाग्या, “मै राजा बणुगाँ।” फेर उसनै रथ अर घुड़सवार अर अपणे आग्गै-आग्गै दौड़ण खात्तर पचास पहरेदार राख लिये। <verse eid="1KI 1:5" /><verse number="6" style="v" sid="1KI 1:6" />उसके पिता नै तो जन्म तै लेकै उस ताहीं कदे या कहकै उदास न्ही करया था, “तन्‍नै इसा क्यूँ करया।” वो घणा सुथरा था, अर अबशालोम कै बाद उसका जन्म होया था। <verse eid="1KI 1:6" /><verse number="7" style="v" sid="1KI 1:7" />उसनै सरूयाह के बेट्टे योआब तै अर एब्यातार याजक तै बातचीत करी, अर उननै उसकै पाच्छै होकै उसकी मदद करी। <verse eid="1KI 1:7" /><verse number="8" style="v" sid="1KI 1:8" />पर सादोक याजक यहोयादा का बेट्टा बनायाह, नातान नबी, शिमी, रेई, अर दाऊद के शूरवीरां नै अदोनिय्याह का साथ न्ही दिया।<verse eid="1KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 1:9" />एक दिन अदोनिय्याह नै जोहेलेत नाम के पत्थर कै धोरै जो एनरोगेल कै धोरै सै, भेड़-बळध अर त्यार करे होए पशु बलि करे, अर अपणे सारे भाई, राजकुमारां अर राजा के सारे यहूदी कर्मचारियाँ ताहीं बुला लिया। <verse eid="1KI 1:9" /><verse number="10" style="v" sid="1KI 1:10" />पर नातान नबी, अर बनायाह अर शूरवीरां ताहीं अर अपणे भाई सुलैमान ताहीं उसनै न्ही बुलाया। <verse eid="1KI 1:10" /><verse number="11" style="v" sid="1KI 1:11" />फेर नातान नै सुलैमान की माँ बतशेबा तै कह्या, “के तन्‍नै सुण्या सै के हग्गीत का बेट्टा अदोनिय्याह राजा बण बैठ्या सै अर म्हारा प्रभु दाऊद ये बात न्ही जाणदा? <verse eid="1KI 1:11" /><verse number="12" style="v" sid="1KI 1:12" />इस करकै इब आ, मै तन्‍नै इसी सलाह देऊँ सूं, जिसतै तू अपणी अर अपणे बेट्टे सुलैमान की जान बचावै। <verse eid="1KI 1:12" /><verse number="13" style="v" sid="1KI 1:13" />तू दाऊद राजा कै धोरै जाकै, उसतै न्यू पूछ, ‘हे मेरे प्रभु! हे राजा! के तन्‍नै कसम खाकै अपणी दास्सी तै न्ही कह्या, के तेरा बेट्टा सुलैमान मेरै बाद राजा होवैगा, अर वो मेरी राजगद्दी पै विराजमान होवैगा? फेर अदोनिय्याह क्यूँ राजा बण बैठ्या सै?’ <verse eid="1KI 1:13" /><verse number="14" style="v" sid="1KI 1:14" />अर जिब तू ओड़ै राजा तै या बात करैगी, फेर मै तेरै पाच्छै आकै, तेरी बात्तां की हाँ भरुगाँ।”<verse eid="1KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15" />फेर बतशेबा राजा कै धोरै कोठड़ी म्ह गई; राजा तो घणा बूढ़ा होग्या था, अर उसकी सेवा पाणी शूनेमिन अबीशग करै थी। <verse eid="1KI 1:15" /><verse number="16" style="v" sid="1KI 1:16" />बतशेबा नै झुककै राजा ताहीं दण्डवत करया, अर राजा नै पूच्छया, “तू के चाहवै सै?” <verse eid="1KI 1:16" /><verse number="17" style="v" sid="1KI 1:17" />उसनै जवाब दिया, “हे मेरे प्रभु, तन्‍नै तो अपणे परमेसवर यहोवा की कसम खाकै अपणी दास्सी तै कह्या था, ‘तेरा बेट्टा सुलैमान मेरै बाद राजा होवैगा अर वो मेरी गद्दी पै विराजैगा।’ <verse eid="1KI 1:17" /><verse number="18" style="v" sid="1KI 1:18" />इब देख अदोनिय्याह राजा बण बैठ्या सै, अर इब ताहीं मेरा प्रभु राजा इस बात नै न्ही जाणदा। <verse eid="1KI 1:18" /><verse number="19" style="v" sid="1KI 1:19" />उसनै भोत-से बळध त्यार करे, पशु अर भेड़ बलि करी, अर सारे राजकुमारां ताहीं अर एब्यातार याजक अर योआब सेनापति ताहीं बुलाया सै, पर तेरे दास सुलैमान ताहीं न्ही बुलाया। <verse eid="1KI 1:19" /><verse number="20" style="v" sid="1KI 1:20" />अर हे मेरे प्रभु! हे राजा! सारे इस्राएलियाँ की आँख तन्‍नै देखण लागरी सैं के तू उनतै कहवै, के म्हारे प्रभु राजा की गद्दी पै उसकै बाद कौण बैठैगा। <verse eid="1KI 1:20" /><verse number="21" style="v" sid="1KI 1:21" />ना तो जिब म्हारा प्रभु राजा, अपणे पुरखां कै गैल सोवैगा, फेर मै अर मेरा बेट्टा सुलैमान दोन्‍नु अपराधी गिणे जावांगे।”<verse eid="1KI 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 1:22" />जिब बतशेबा राजा तै बात करै थी, के नातान नबी भी आ ग्या। <verse eid="1KI 1:22" /><verse number="23" style="v" sid="1KI 1:23" />अर राजा तै कह्या गया, “नातान नबी हाजिर सै;” फेर वो राजा कै स्याम्ही आया, अर मुँह के बळ गिरकै राजा ताहीं दण्डवत करया। <verse eid="1KI 1:23" /><verse number="24" style="v" sid="1KI 1:24" />फेर नातान कहण लाग्या, “हे मेरे प्रभु, हे राजा! तन्‍नै के घोषणा करी सै, ‘अदोनिय्याह मेरै बाद राजा होवैगा अर वो मेरी गद्दी पै विराजैगा?’ <verse eid="1KI 1:24" /><verse number="25" style="v" sid="1KI 1:25" />देख उसनै आज नीच्‍चै जाकै भोत-से बळध, त्यार करे होए पशु अर भेड़ बलि करी सैं, अर सारे राजकुमारां अर सेनापतियाँ ताहीं अर एब्यातार याजक ताहीं भी बुला लिया सै; अर वे उसके स्याम्ही खान्दे-पीन्दे होए कहवैं सैं, ‘अदोनिय्याह राजा जिन्दा रहवै।’ <verse eid="1KI 1:25" /><verse number="26" style="v" sid="1KI 1:26" />पर मन्‍नै तेरे दास नै, अर सादोक याजक अर यहोयादा के बेट्टे बनायाह, अर तेरे दास सुलैमान ताहीं उसनै न्ही बुलाया। <verse eid="1KI 1:26" /><verse number="27" style="v" sid="1KI 1:27" />के यो मेरे प्रभु राजा की और तै होया? तन्‍नै तो अपणे दास ताहीं यो न्ही जताया सै, के प्रभु राजा की गद्दी पै कौण उसकै बाद विराजैगा।”<verse eid="1KI 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28" />दाऊद राजा नै कह्या, “बतशेबा ताहीं मेरै धोरै बुला ल्याओ।” फेर वा राजा कै धोरै आकै उसकै स्याम्ही खड़ी होई। <verse eid="1KI 1:28" /><verse number="29" style="v" sid="1KI 1:29" />राजा नै कसम खाकै कह्या, “यहोवा जो मेरी जान सारे जोखिमां तै बचान्दा आया सै, <verse eid="1KI 1:29" /><verse number="30" style="v" sid="1KI 1:30" />उसकै जीवन की कसम, जिसा मन्‍नै तेरे तै इस्राएल के परमेसवर यहोवा की कसम खाकै कह्या था, ‘तेरा बेट्टा सुलैमान मेरै बाद राजा होवैगा, अर वो मेरै बदलै मेरी गद्दी पै विराजैगा,’ उस्से तरियां मै जरुर आज कै दिन करुँगा।” <verse eid="1KI 1:30" /><verse number="31" style="v" sid="1KI 1:31" />फेर बतशेबा नै धरती पै मुँह कै बळ गिरकै राजा तै दण्डवत करकै कह्या, “मेरा प्रभु राजा दाऊद सदा ताहीं जिन्दा रहवै!”<verse eid="1KI 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 1:32" />फेर दाऊद राजा नै कह्या, “मेरै धोरै सादोक याजक, नातान नबी, यहोयादा के बेट्टे बनायाह ताहीं बुला ल्याओ।” आखर म्ह वे राजा कै स्याम्ही आए। <verse eid="1KI 1:32" /><verse number="33" style="v" sid="1KI 1:33" />राजा नै उनतै कह्या, “अपणे प्रभु के कर्मचारियाँ नै गैल लेकै मेरे बेट्टे सुलैमान नै मेरे अपणे खच्‍चर पै चढ़ाओ; अर गीहोन ताहीं ले जाओ; <verse eid="1KI 1:33" /><verse number="34" style="v" sid="1KI 1:34" />अर ओड़ै सादोक याजक अर नातान नबी इस्राएल का राजा होण कै खात्तर उसका अभिषेक करै; फेर थम सारे नरसिंगा फूँक कै कहियो, ‘राजा सुलैमान जिन्दा रहवै।’ <verse eid="1KI 1:34" /><verse number="35" style="v" sid="1KI 1:35" />अर थम उसकै पाच्छै-पाच्छै उरै आईयो, अर वो आकै मेरे सिंहासन पै विराजै, क्यूँके मेरै बदलै म्ह वोए राजा होवैगा; अर उसे ताहीं मन्‍नै इस्राएल अर यहूदा का प्रधान होण खात्तर ठैहराया सै।” <verse eid="1KI 1:35" /><verse number="36" style="v" sid="1KI 1:36" />फेर यहोयादा के बेट्टे बनायाह नै कह्या, “आमीन! मेरे प्रभु राजा का परमेसवर यहोवा भी इसाए कहवै। <verse eid="1KI 1:36" /><verse number="37" style="v" sid="1KI 1:37" />जिस तरियां यहोवा मेरे प्रभु राजा कै गैल रह्या, उस्से तरियां वो सुलैमान कै भी गैल रहवै, अर उसका राज्य मेरे प्रभु दाऊद राजा के राज्य तै भी घणा बढ़ावै।”<verse eid="1KI 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38" />फेर सादोक याजक अर नातान नबी अर यहोयादा का बेट्टा बनायाह अर करेतियां अर पलेतियां ताहीं गैल लिए होए नीच्‍चै गए, अर सुलैमान ताहीं राजा दाऊद के खच्‍चर पै चढ़ाकै गीहोन झरणे नै ले चाल्‍ले। <verse eid="1KI 1:38" /><verse number="39" style="v" sid="1KI 1:39" />फेर सादोक याजक नै यहोवा के तम्बू म्ह तै तेल भरया होया सींग लिया, अर सुलैमान का राज्याभिषेक करया। अर वे नरसिंगे फूँकण लाग्गे; अर सारे माणस बोल्‍लण लाग्गे, “राजा सुलैमान जिन्दा रहवै।” <verse eid="1KI 1:39" /><verse number="40" style="v" sid="1KI 1:40" />फेर सारे माणस उसकै पाच्छै-पाच्छै बाँसुरी बजान्दे अर इतणा बड़ा आनन्द करदे होए उप्पर गए, के उनकी आवाज तै धरती डोल उठी।<verse eid="1KI 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 1:41" />जिब अदोनिय्याह अर उसके सारे मेहमान खाणा खा चुके थे, फेर या आवाज उननै भी सुणाई पड़ी। योआब नै नरसिंगे का शब्द सुणकै पूच्छया, “नगर म्ह भगदड़ अर चिल्‍लाहट का शब्द क्यूँ होण लाग रहया सै?” <verse eid="1KI 1:41" /><verse number="42" style="v" sid="1KI 1:42" />वो न्यू कहवैए था, के एब्यातार याजक का बेट्टा योनातान आया अर अदोनिय्याह नै उसतै कह्या, “भित्तर आ; तू तो भला माणस सै, अर भली खबर भी ल्याया होवैगा।” <verse eid="1KI 1:42" /><verse number="43" style="v" sid="1KI 1:43" />योनातान नै अदोनिय्याह तै कह्या, “सचमुच म्हारे प्रभु राजा दाऊद नै सुलैमान ताहीं राजा बणा दिया। <verse eid="1KI 1:43" /><verse number="44" style="v" sid="1KI 1:44" />अर राजा नै सादोक याजक, नातान नबी अर यहोयादा के बेट्टे बनायाह अर करेतियां अर पलेतियां ताहीं उसकै गैल भेज दिया, अर उननै उस ताहीं राजा के खच्‍चर पै चढ़ाया सै। <verse eid="1KI 1:44" /><verse number="45" style="v" sid="1KI 1:45" />अर सादोक याजक, अर नातान नबी नै गीहोन म्ह उसका राज्याभिषेक करया सै; अर वे ओड़ै तै इसा आनन्द करदे होए उप्पर गए सैं के नगर म्ह भगदड़ माचगी, अर जो आवाज थमनै सुणाई पड़ै सै वोए सै। <verse eid="1KI 1:45" /><verse number="46" style="v" sid="1KI 1:46" />सुलैमान राजगद्दी पै विराज भी रह्या सै। <verse eid="1KI 1:46" /><verse number="47" style="v" sid="1KI 1:47" />फेर राजा के कर्मचारी म्हारे प्रभु दाऊद राजा नै यो कहकै धन्य कहण आए, ‘तेरा परमेसवर, सुलैमान का नाम, तेरे नाम तै भी महान करै, अर उसका राज्य तेरे राज्य तै भी घणा बढ़ावै;’ अर राजा नै अपणे पलंग पै दण्डवत करया। <verse eid="1KI 1:47" /><verse number="48" style="v" sid="1KI 1:48" />फेर राजा नै यो भी बिनती करी, ‘इस्राएल का परमेसवर यहोवा धन्य सै, जिसनै आज मेरे देखदे एक ताहीं मेरी गद्दी पै बिठाया सै।’”<verse eid="1KI 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49" />फेर जितने मेहमान अदोनिय्याह कै गैल थे वे सारे थरथरा उठे, अर उठकै अपणा-अपणा राह लिया। <verse eid="1KI 1:49" /><verse number="50" style="v" sid="1KI 1:50" />अर अदोनिय्याह सुलैमान तै डरकै उठ्या, अर जाकै वेदी के सींग पकड़ लिये<note caller="+" style="f"><char style="fr" closed="false">1:50 </char><char style="fq" closed="false">वेदी के सींग पकड़ लिये </char><char style="ft" closed="false">जो कोए भी उन सींगां नै पकड़ लेवै था वो बच्या रहवै था (निर्गमन 21:13-14)</char></note>। <verse eid="1KI 1:50" /><verse number="51" style="v" sid="1KI 1:51" />फेर सुलैमान ताहीं यो समाचार मिल्या, “अदोनिय्याह सुलैमान राजा तै इसा डर ग्या सै के उसनै वेदी के सींगां ताहीं यो कहकै पकड़ लिया सै, ‘आज राजा सुलैमान कसम खावै के अपणे दास नै तलवार तै न्ही मारैगा।’” <verse eid="1KI 1:51" /><verse number="52" style="v" sid="1KI 1:52" />सुलैमान नै कह्या, “जै वो अपणे आचरण तै भला माणस बणकै दिखावै तो उसका एक बाळ भी धरती पै गिरण न्ही पावैगा, पर जै उस म्ह दुष्टता पाई जावै, तो वो मारया जावैगा।” <verse eid="1KI 1:52" /><verse number="53" style="v" sid="1KI 1:53" />फेर राजा सुलैमान नै कुछ माणसां ताहीं भेज दिया ताके उस नै वेदी कै धोरै तै उतार ले आवै फेर उसनै आकै राजा सुलैमान ताहीं दण्डवत करया अर सुलैमान नै उसतै कह्या, “अपणे घर चल्या जा।”<verse eid="1KI 1:53" /></para>
  <chapter eid="1KI 1" />
  <chapter number="2" style="c" sid="1KI 2" />
  <para style="s">दाऊद की मौत अर सुलैमान के राज की शरुआत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1" />जिब दाऊद के मरण का बखत धोरै आया, फेर उसनै अपणे बेट्टे सुलैमान तै कह्या, <verse eid="1KI 2:1" /><verse number="2" style="v" sid="1KI 2:2" />“मै संसार नै छोड़कै जाण आळा सूं ज्यांतै तू हियाव बाँधकै पुरुषार्थ दिख्या। <verse eid="1KI 2:2" /><verse number="3" style="v" sid="1KI 2:3" />अर जो कुछ तेरे परमेसवर यहोवा नै तेरे तै सौंप्या सै, उसकी हिफाजत करकै उसके राह पै चाल्या करिये अर जिसा मूसा के नियम-कायदा म्ह लिख्या सै, उस्से तरियां उसकी विधियाँ अर हुकमां, अर नियमां, अर चितौनियाँ का पालन करदा रहिये; जिसतै जो किमे तू करै अर जित्त किते तू जावै, उस म्ह तू सफल होवै; <verse eid="1KI 2:3" /><verse number="4" style="v" sid="1KI 2:4" />अर यहोवा अपणा वो वचन पूरा करै जो उसनै मेरै बारै म्ह कह्या था, ‘जै तेरी औलाद अपणी चाल कै बारै म्ह इस्से तरियां सावधान रहवै, के अपणे पूरे दिल अर पूरे प्राण तै सच्‍चाई कै गैल रोज मेरै स्याम्ही चाल्दे रहवैं फेर तो इस्राएल की राजगद्दी पै विराजण आळे की, तेरे कुल तेरे परिवार म्ह घटी कदे भी न्ही होवैगी।’”<verse eid="1KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 2:5" />“फेर तू खुद जाणै सै, के सरूयाह के बेट्टे योआब नै मेरै गैल के-के करया! यानिके उसनै नेर के बेट्टे अब्नेर, अर येतेर के बेट्टे अमासा, इस्राएल के इन दो सेनापतियाँ तै के-के करया। उसनै उन दोनुआं ताहीं घात करया, अर मेल कै बखत युद्ध का लहू बहाकै उसनै अपणी कमर का कमरबन्द अर अपणे पैरां की जूत्ती भिगो ली। <verse eid="1KI 2:5" /><verse number="6" style="v" sid="1KI 2:6" />ज्यांतै तू अपणी बुद्धि तै काम लिये अर उस पक्‍के बाळ आळे नै अधोलोक म्ह शान्ति तै उतरण ना दिये। <verse eid="1KI 2:6" /><verse number="7" style="v" sid="1KI 2:7" />फेर गिलादी बर्जिल्‍लै के बेट्यां पै दया राखिये, अर वे तेरी मेज पै खाण आळयां म्ह रहवैं, क्यूँके जिब मै तेरे भाई अबशालोम कै स्याम्ही तै भाज्या जाऊँ था, जिब उननै मेरै गैल आकै उसाए करया था<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">2 शमूएल 17:27</char></note>। <verse eid="1KI 2:7" /><verse number="8" style="v" sid="1KI 2:8" />फेर सुण, तेरै धोरै बिन्‍यामीनी गेरा का बेट्टा बहूरीमी शिमी रहवै सै, जिस दिन मै महनैम नगर जाऊँ था उस दिन उसनै मेरे ताहीं कड़ाई तै श्राप<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fq" closed="false">श्राप </char><char style="ft" closed="false">2 राजाओं 2:24</char></note> दिया था पर जिब वो मेरे तै मिलण<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fq" closed="false">तै मिलण </char><char style="ft" closed="false">2 राजाओं 19:23</char></note> कै खात्तर यरदन नदी पै आया, फेर मन्‍नै उसतै यहोवा की या कसम खाई, के मै तन्‍नै तलवार तै न्ही मारूँगा। <verse eid="1KI 2:8" /><verse number="9" style="v" sid="1KI 2:9" />पर इब तू इसनै निर्दोष ना ठहराईये, तू तो बुद्धिमान माणस सै; तन्‍नै बेरा सै के उसकै गैल के करणा चाहिये, अर उस पक्‍के बाळ आळे का लहू बहाकै उसनै अधोलोक म्ह तार दिये।” <verse eid="1KI 2:9" /><verse number="10" style="v" sid="1KI 2:10" />फेर दाऊद अपणे पुरखां कै गैल जा मिल्या अर दाऊदपुर म्ह उस ताहीं माट्टी दी गई।<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">प्रेरितों के काम 2:29, 13:36</char></note> <verse eid="1KI 2:10" /><verse number="11" style="v" sid="1KI 2:11" />दाऊद नै इस्राएल पै चाळीस साल ताहीं राज करया, सात साल तो उसनै हेब्रोन म्ह अर तैंतीस साल यरुशलेम म्ह राज करया था। <verse eid="1KI 2:11" /><verse number="12" style="v" sid="1KI 2:12" />फेर सुलैमान अपणे पिता दाऊद की गद्दी पै विराजमान होया अर उसका राज्य भोत मजबूत होया। <verse eid="1KI 2:12" /><verse number="13" style="v" sid="1KI 2:13" />फेर हग्गीत का बेट्टा अदोनिय्याह, सुलैमान की माँ बतशेबा कै धोरै आया, बतशेबा नै पूच्छया, “के तू मित्रभाव तै आवै सै?” <verse eid="1KI 2:13" /><verse number="14" style="v" sid="1KI 2:14" />उसनै जवाब दिया, “हाँ, मित्रभाव तै!” फेर वो कहण लाग्या, “मन्‍नै तेरे तै एक बात कहणी सै।” उसनै कह्या, “कह!” <verse eid="1KI 2:14" /><verse number="15" style="v" sid="1KI 2:15" />उसनै कह्या, “तन्‍नै तो बेरा सै के राज्य मेरे ताहीं मिलणा चाहिए था, अर सारे इस्राएलियाँ की आस मेरै पै थी, के मै राज्य करुँ; पर इब पास्सा पलट ग्या सै अर राज्य मेरे भाई का होग्या सै, क्यूँके वो यहोवा की और तै उसनै मिल्या सै। <verse eid="1KI 2:15" /><verse number="16" style="v" sid="1KI 2:16" />इस करकै इब मै तेरे तै एक बात कहूँ सूं, मन्‍नै मना ना करिये।” उसनै कह्या, “कहे जा।” <verse eid="1KI 2:16" /><verse number="17" style="v" sid="1KI 2:17" />उसनै कह्या, “राजा सुलैमान तन्‍नै इन्कार न्ही करैगा; इस करकै उसतै कह, के वो मन्‍नै शूनेमिन अबीशग तै ब्याह दे।” <verse eid="1KI 2:17" /><verse number="18" style="v" sid="1KI 2:18" />बतशेबा नै कह्या, “आछ्या, मै तेरै खात्तर राजा तै कहूँगी।”<verse eid="1KI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 2:19" />फेर बतशेबा अदोनिय्याह के खात्तर राजा सुलैमान तै बातचीत करण खात्तर उसके धोरै गई, अर राजा उसतै मिलण कै खात्तर उठ्या, अर उसनै दण्डवत करकै अपणे सिंहासन पै बैठ ग्या: फेर राजा नै अपणी माँ खात्तर एक सिंहासन धरवा दिया, अर वा उसकी दाहिनी और बैठगी। <verse eid="1KI 2:19" /><verse number="20" style="v" sid="1KI 2:20" />फेर वा कहण लाग्गी, “मै तेरे तै एक छोट्टी सी बिनती करुँ सूं इस करकै मेरे ताहीं मना ना करिये,” राजा नै कह्या, “हे माता माँग; मै तन्‍नै इन्कार न्ही करुँगा।” <verse eid="1KI 2:20" /><verse number="21" style="v" sid="1KI 2:21" />उसनै कह्या, “वा शूनेमिन अबीशग तेरे भाई अदोनिय्याह तै ब्याह दी जावै।” <verse eid="1KI 2:21" /><verse number="22" style="v" sid="1KI 2:22" />राजा सुलैमान नै अपणी माँ तै जवाब दिया, “तू अदोनिय्याह कै खात्तर शूनेमिन अबीशग ए क्यूँ माँग्गै सै? उसकै खात्तर राज्य भी माँग, क्यूँके वो तो मेरा बड़ा भाई सै, अर उसे कै खात्तर के! एब्यातार याजक अर सरूयाह के बेट्टे योआब कै खात्तर भी माँग।” <verse eid="1KI 2:22" /><verse number="23" style="v" sid="1KI 2:23" />अर राजा सुलैमान नै यहोवा की कसम खाकै कह्या, “जै अदोनिय्याह नै या बात अपणे जान पै खेलकै ना कही हो तो परमेसवर मन्‍नै मरण ताहीं तक घात करै। <verse eid="1KI 2:23" /><verse number="24" style="v" sid="1KI 2:24" />इब यहोवा जिसनै मेरे ताहीं मजबूत करया, अर मेरे पिता दाऊद की राजगद्दी पै बिठाया सै अर अपणे वचन कै मुताबिक मेरा घर बसाया सै, उसके जीवन की कसम आज ए अदोनिय्याह मारया जावैगा।” <verse eid="1KI 2:24" /><verse number="25" style="v" sid="1KI 2:25" />आखर म्ह राजा सुलैमान नै यहोयादा के बेट्टे बनायाह ताहीं भेज दिया अर उसनै जाकै, उस ताहीं इसा मारया के वो मर ग्या। <verse eid="1KI 2:25" /><verse number="26" style="v" sid="1KI 2:26" />फेर एब्यातार याजक तै राजा नै कह्या, “अनातोत म्ह अपणी धरती पै जा; क्यूँके तू भी मौत की सजा कै लायक सै। आज कै दिन तो मै तन्‍नै न्ही मारूँगा, क्यूँके तू मेरे पिता दाऊद कै स्याम्ही प्रभु यहोवा का सन्दूक ठाया करै था; अर उन सारे दुखां म्ह जो मेरे पिता पै पड़े थे तू भी दुखी था।” <verse eid="1KI 2:26" /><verse number="27" style="v" sid="1KI 2:27" />अर सुलैमान नै एब्यातार तै यहोवा के याजक होण के पद पै तै तार दिया, ताके जो वचन यहोवा नै एली के वंश कै बारै म्ह शीलो म्ह कह्या था, वो पूरा हो जावै।<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="ft" closed="false">1 शमूएल 2:27-36</char></note> <verse eid="1KI 2:27" /><verse number="28" style="v" sid="1KI 2:28" />इसकी खबर योआब तक पोहची; योआब अबशालोम कै पाच्छै तो न्ही होया था, पर अदोनिय्याह कै पाच्छै हो लिया था। फेर योआब यहोवा के तम्बू म्ह भाज ग्या, अर वेदी के सींगां ताहीं पकड़ लिया। <verse eid="1KI 2:28" /><verse number="29" style="v" sid="1KI 2:29" />जिब राजा सुलैमान नै या खबर मिली, “योआब यहोवा के तम्बू म्ह भाज ग्या सै, अर वो वेदी कै धोरै सै,” फेर सुलैमान नै यहोयादा के बेट्टे बनायाह ताहीं यो कहकै भेज दिया, के तू जाकै उसनै मारदे। <verse eid="1KI 2:29" /><verse number="30" style="v" sid="1KI 2:30" />फेर बनायाह नै यहोवा के तम्बू कै धोरै जाकै उसतै कह्या, “राजा का यो हुकम सै, के लिकड़ आ।” उसनै कह्या, “ना, मै उरैए मरुँगा।” फेर बनायाह नै लौट कै या खबर राजा ताहीं दी “योआब नै मेरै ताहीं यो जवाब दिया।” <verse eid="1KI 2:30" /><verse number="31" style="v" sid="1KI 2:31" />राजा नै उसतै कह्या, “उसके कहण कै मुताबिक उसनै मारदे, अर उसनै माट्टी दे; इसा करकै बेकसूरां का जो खून योआब नै करया सै, उसका दोष तू मेरे अर मेरे पिता के कुण्बे पै तै दूर करैगा। <verse eid="1KI 2:31" /><verse number="32" style="v" sid="1KI 2:32" />अर यहोवा उसके सिर वो खून बोहड़ा देगा क्यूँके उसनै मेरे पिता दाऊद के बिना जाणे अपणे तै घणे धर्मी अर भले दो माणसां पै, यानिके इस्राएल के प्रधान सेनापति नेर के बेट्टे अब्नेर अर यहूदा के प्रधान सेनापति येतेर के बेट्टे अमासा पै टूटकै उन ताहीं तलवार तै मारया था। <verse eid="1KI 2:32" /><verse number="33" style="v" sid="1KI 2:33" />आखर योआब के सिर पै अर उसकी औलाद के सिर पै खून सदा तक रहवैगा, पर दाऊद अर उसके वंश अर उसके घरान्‍ने अर उसके राज्य पै यहोवा की और तै शान्ति सदा ताहीं रहवैगी।” <verse eid="1KI 2:33" /><verse number="34" style="v" sid="1KI 2:34" />फेर यहोयादा के बेट्टे बनायाह नै जाकै योआब ताहीं मार गेरया; अर उसतै जंगळ म्ह उसे के घर म्ह माट्टी दी गई। <verse eid="1KI 2:34" /><verse number="35" style="v" sid="1KI 2:35" />फेर राजा नै उसकी जगहां पै यहोयादा के बेट्टे बनायाह ताहीं प्रधान सेनापति ठैहराया; अर एब्यातार की जगहां पै सादोक याजक ताहीं ठैहराया। <verse eid="1KI 2:35" /><verse number="36" style="v" sid="1KI 2:36" />फेर राजा नै शिमी ताहीं बुलावा भेज्या, अर उसतै कह्या, “तू यरुशलेम म्ह अपणा एक घर बणाकै ओड़ैए रहिये अर नगर तै बाहर किते ना जाईये। <verse eid="1KI 2:36" /><verse number="37" style="v" sid="1KI 2:37" />तू पक्‍का जाण ले के जिस दिन तू लिकड़कै किद्रोन नाळे कै पार उतरै, उस्से दिन तू पक्‍का मार दिया जावैगा, अर तेरा लहू तेरे ए सिर पै पड़ैगा।” <verse eid="1KI 2:37" /><verse number="38" style="v" sid="1KI 2:38" />शिमी नै राजा तै कह्या, “बात ठीक सै; जिसा मेरे प्रभु राजा नै कह्या सै, उसे तरियां ए तेरा दास करैगा।” फेर शिमी घणे दिन यरुशलेम म्ह रह्या। <verse eid="1KI 2:38" /><verse number="39" style="v" sid="1KI 2:39" />पर तीन साल के बीत्तण पै शिमी के दो दास, गत नगर के राजा माका के बेट्टे आकीश कै धोरै भाजगे, अर शिमी नै या खबर मिली, “तेरे दास गत म्ह सैं।” <verse eid="1KI 2:39" /><verse number="40" style="v" sid="1KI 2:40" />फेर शिमी उठकै अपणे गधे पै काठ्ठी कसकै, अपणे दास्सां नै ढूँढ़ण कै खात्तर गत म्ह आकीश के धोरै गया, अर अपणे दास्सां ताहीं गत तै ले आया। <verse eid="1KI 2:40" /><verse number="41" style="v" sid="1KI 2:41" />जिब सुलैमान राजा नै इसकी खबर मिली, “शिमी यरुशलेम तै गत म्ह गया, अर फेर बोहड़ आया सै,” <verse eid="1KI 2:41" /><verse number="42" style="v" sid="1KI 2:42" />फेर उसनै शिमी ताहीं बुलावा भेज्या, अर उसतै कह्या, “के मन्‍नै तेरे ताहीं यहोवा की कसम न्ही खुवाई थी? अर तेरे तै चिताकै न्ही कह्या था, ‘यो पक्‍का जाण ले के जिस दिन तू लिकड़कै किते चल्या जावै, उस्से दिन तू जरुर मार दिया जावैगा?’ अर के तन्‍नै मेरे ताहीं न्ही कह्या था, ‘जो बात मन्‍नै सुणी, वो ठीक सै?’ <verse eid="1KI 2:42" /><verse number="43" style="v" sid="1KI 2:43" />फेर तन्‍नै यहोवा की कसम अर मेरा दृढ़ हुकम क्यूँ न्ही मान्या?” <verse eid="1KI 2:43" /><verse number="44" style="v" sid="1KI 2:44" />अर राजा नै शिमी तै कह्या, “तू आप ए अपणे मन म्ह उस सारी दुष्टता नै जाणै सै, जो तन्‍नै मेरे पिता दाऊद तै करी थी? इस करकै यहोवा तेरे सिर पै तेरी दुष्टता बोहड़ा देवैगा। <verse eid="1KI 2:44" /><verse number="45" style="v" sid="1KI 2:45" />पर राजा सुलैमान धन्य रहवैगा, अर दाऊद का राज्य यहोवा कै स्याम्ही सदा मजबूत रहवैगा।” <verse eid="1KI 2:45" /><verse number="46" style="v" sid="1KI 2:46" />फेर राजा नै यहोयादा के बेट्टे बनायाह ताहीं हुकम दिया, अर उसनै बाहर जाकै, उस ताहीं इसा मारया के शिमी भी मर ग्या। इस तरियां सुलैमान के हाथ म्ह राज्य मजबूत होग्या।<verse eid="1KI 2:46" /></para>
  <chapter eid="1KI 2" />
  <chapter number="3" style="c" sid="1KI 3" />
  <para style="s">बुद्धि खात्तर सुलैमान की प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1" />फेर राजा सुलैमान राज्य की संधि करण खात्तर मिस्र के राजा फिरौन<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">फिरौन </char><char style="ft" closed="false">यो एक पद सै</char></note> की बेट्टी तै ब्याह करकै उसका दामाद बणग्या, अर उसनै दाऊदपुर म्ह ल्याकै जिब ताहीं अपणा भवन अर यहोवा का भवन अर यरुशलेम के च्यांरु और की शहरपनाह ना बणवा चुक्या, तब ताहीं उसनै उस ताहीं ओड़ैए राख्या। <verse eid="1KI 3:1" /><verse number="2" style="v" sid="1KI 3:2" />क्यूँके प्रजा के माणस तो ऊँच्‍चे स्थानां पै बलि चढ़ावैं थे अर उन दिनां ताहीं यहोवा के नाम का कोए भवन न्ही बण्या था।<verse eid="1KI 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 3:3" />सुलैमान यहोवा तै प्रेम करै था अर अपणे पिता दाऊद की विधियाँ पै चाल्दा तो रह्या, पर वो ऊँच्‍चे स्थानां पै भी बलि चढ़ाया अर धूप जळाया करै था। <verse eid="1KI 3:3" /><verse number="4" style="v" sid="1KI 3:4" />अर एक दिन राजा गिबोन नगर म्ह बलि चढ़ाण गया, क्यूँके सबतै ऊँच्‍चा स्थान वोए था, फेर ओड़ै की वेदी पै सुलैमान नै एक हजार होमबलि चढ़ाए।<verse eid="1KI 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 3:5" />गिबोन म्ह यहोवा नै रात म्ह सपने के जरिये सुलैमान तै दर्शन देकै कह्या, “जो कुछ तू चावै के मै तन्‍नै देऊँ, वो माँग।” <verse eid="1KI 3:5" /><verse number="6" style="v" sid="1KI 3:6" />सुलैमान नै कह्या, “तू अपणे दास मेरे पिता दाऊद पै बड़ी करुणा करदा रह्या, क्यूँके वो अपणे-आपनै तेरै स्याम्ही जाणकै तेरे गैल सच्‍चाई अर धार्मिकता अर मन की सिधाई तै चालदा रह्या; अर तन्‍नै उरै ताहीं उसपै करुणा करी थी के उसतै उसकी गद्दी पै बैठण आळा एक बेट्टा दिया सै, जिसा के आज वर्तमान म्ह सै। <verse eid="1KI 3:6" /><verse number="7" style="v" sid="1KI 3:7" />अर इब हे मेरे परमेसवर यहोवा! तन्‍नै अपणे दास ताहीं मेरे पिता दाऊद की जगहां पै राजा बणाया सै, पर मै छोट्टा छोरा सा सूं जो भित्तर-बाहर आणा-जाणा न्ही जाणदा। <verse eid="1KI 3:7" /><verse number="8" style="v" sid="1KI 3:8" />फेर तेरा दास तेरी चुणी होई प्रजा के भोत-से माणसां कै बिचाळै सै, जिनकी गिणती बहुतायत के मारे न्ही हो सकदी। <verse eid="1KI 3:8" /><verse number="9" style="v" sid="1KI 3:9" />तू अपणे दास नै अपणी प्रजा का न्याय करण कै खात्तर समझण की इसी शक्ति दे, के मै भले-बुरे नै परख सकूँ; क्यूँके कौण इसा सै के तेरी इतणी बड़ी प्रजा का न्याय कर सकै?” <verse eid="1KI 3:9" /><verse number="10" style="v" sid="1KI 3:10" />इस बात तै प्रभु खुश होया, के सुलैमान नै इसा वरदान मांग्या सै। <verse eid="1KI 3:10" /><verse number="11" style="v" sid="1KI 3:11" />फेर परमेसवर नै उसतै कह्या, “ज्यांतै के तन्‍नै यो वरदान मांग्या सै, अर ना तो लाम्बी उम्र अर ना धन अर ना अपणे बैरियाँ का नाश मांग्या सै, पर समझण के विवेक का वरदान मांग्या सै ज्यांतै सुण, <verse eid="1KI 3:11" /><verse number="12" style="v" sid="1KI 3:12" />मै तेरी बिनती कै मुताबिक करुँ सूं, तन्‍नै बुद्धि अर विवेक तै भरया मन देऊँ सूं, उरै ताहीं के तेरै बराबर ना तो तेरे तै पैहल्या कोए कदे होया, अर ना बाद म्ह कोए कदे होवैगा। <verse eid="1KI 3:12" /><verse number="13" style="v" sid="1KI 3:13" />फेर जो तन्‍नै न्ही मांग्या, यानिके धन अर महिमा, वो भी मै तन्‍नै उरै ताहीं देऊँ सूं, के तेरे जीवन भर कोए राजा तेरे बराबर ना होवैगा। <verse eid="1KI 3:13" /><verse number="14" style="v" sid="1KI 3:14" />फेर जै तू अपणे पिता दाऊद की तरियां मेरे राह म्ह चाल्दा होया, मेरी विधियाँ अर हुकमां नै मानदा रहवैगा तो मै तेरी उम्र नै बढ़ाऊँगा।”<verse eid="1KI 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 3:15" />फेर सुलैमान जाग उठ्या; अर देख्या के यो सपना था; फेर वो यरुशलेम म्ह गया, अर यहोवा के करार के सन्दूक कै स्याम्ही खड्या होकै, होमबलि अर मेलबलि चढ़ाए, अर अपणे सारे कर्मचारियाँ कै खात्तर भोज करया। <verse eid="1KI 3:15" /><verse number="16" style="v" sid="1KI 3:16" />उस बखत दो वेश्या राजा कै धोरै आकै उसकै स्याम्ही खड़ी होई। <verse eid="1KI 3:16" /><verse number="17" style="v" sid="1KI 3:17" />उन म्ह तै एक जनान्‍नी कहण लाग्गी, “हे मेरे प्रभु! मै अर या जनान्‍नी दोन्‍नु एके घर म्ह रहवां सां; अर इसकै गैल घर म्ह रहन्दे होए मेरै एक बच्‍चा होया। <verse eid="1KI 3:17" /><verse number="18" style="v" sid="1KI 3:18" />फेर मेरै जच्‍चा के तीन दिन कै बाद इसा होया के या जनान्‍नी भी जच्‍चा होगी; हम तो गैल ए गैल थी, हम दोन्‍नु नै छोड़कै घर म्ह और कोए भी ना था। <verse eid="1KI 3:18" /><verse number="19" style="v" sid="1KI 3:19" />अर रात म्ह इस जनान्‍नी का बाळक इसकै तळै दबकै मर ग्या। <verse eid="1KI 3:19" /><verse number="20" style="v" sid="1KI 3:20" />फेर इसनै आध्धी रात म्ह उठकै, जिब तेरी दास्सी सोवै ए थी, तब मेरा बाळक मेरै धोरै तै लेकै अपणी छात्ती पै लिटा लिया, अर अपणा मरया होया बाळक मेरी छात्ती पै लिटा दिया। <verse eid="1KI 3:20" /><verse number="21" style="v" sid="1KI 3:21" />सुबेरै नै जिब मै अपणे बाळक नै दूध पियाण खात्तर उठ्ठी, फेर उस ताहीं मरया होया पाया; पर सबेरै मन्‍नै ध्यान तै यो देख्या, के वो मेरा बेट्टा कोनी।” <verse eid="1KI 3:21" /><verse number="22" style="v" sid="1KI 3:22" />फेर दुसरी जनान्‍नी नै कह्या, “न्ही जिन्दा बेट्टा मेरा सै, अर मरया होया बेट्टा तेरा सै।” पर वा कहन्दी रह्यी, “ना मरया होया तेरा बेट्टा सै अर जिन्दा मेरा बेट्टा सै,” इस तरियां वे राजा कै स्याम्ही बात करदी रहीं।<verse eid="1KI 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 3:23" />राजा नै कह्या, “एक तो कहवै सै ‘जो जिन्दा सै, वोए मेरा बेट्टा सै, अर मरया होया तेरा बेट्टा सै;’ अर दुसरी कहवै सै, ‘ना, जो मरया सै वोए तेरा बेट्टा सै, अर जो जिन्दा सै, वोए मेरा बेट्टा सै।’” <verse eid="1KI 3:23" /><verse number="24" style="v" sid="1KI 3:24" />फेर राजा नै हुक्म दिया, “मेरै धोरै तलवार ल्याओ;” आखर एक तलवार राजा कै स्याम्ही ल्याई गई। <verse eid="1KI 3:24" /><verse number="25" style="v" sid="1KI 3:25" />फेर राजा नै कह्या, “जिन्दे बाळक नै दो टुकड़े करकै आध्धा इसनै अर आध्धा उसनै दे द्यो।” <verse eid="1KI 3:25" /><verse number="26" style="v" sid="1KI 3:26" />फेर जिन्दे बाळक की माँ का मन अपणे बेट्टे के प्यार तै भर आया, अर उसनै राजा तै कह्या, “हे मेरे प्रभु! जिन्दा बाळक उस्से तै दे; उसनै मारै ना।” दुसरी जनान्‍नी नै कह्या, “वो ना तो मेरा हो अर ना तेरा, वो जीवित बाळक दो टुकड़े करया जावै।” <verse eid="1KI 3:26" /><verse number="27" style="v" sid="1KI 3:27" />फेर राजा नै कह्या, “पैहली नै जिन्दा बाळक द्यो; उसनै ना मारो; क्यूँके उसकी माँ वाए सै।” <verse eid="1KI 3:27" /><verse number="28" style="v" sid="1KI 3:28" />जो न्याय राजा नै करया था, उसकी खबर सारे इस्राएल नै मिली, अर उननै राजा का भय मान्या, क्यूँके उननै यो देख्या, के उसके मन म्ह न्याय करण कै खात्तर परमेसवर की बुद्धि सै।<verse eid="1KI 3:28" /></para>
  <chapter eid="1KI 3" />
  <chapter number="4" style="c" sid="1KI 4" />
  <para style="s">सुलैमान का राजप्रबन्ध अर महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1" />राजा सुलैमान तो सारे इस्राएल कै उप्पर राजा नियुक्त होया था। <verse eid="1KI 4:1" /><verse number="2" style="v" sid="1KI 4:2" />अर उसके हाकिम ये थे, यानिके सादोक का बेट्टा अजर्याह याजक, <verse eid="1KI 4:2" /><verse number="3" style="v" sid="1KI 4:3" />अर शीशा के बेट्टे एलीहोरोप अर अहिय्याह राजसी आधिकारिक थे। अहीलूद का बेट्टा यहोशापात, इतिहास का लेखक था। <verse eid="1KI 4:3" /><verse number="4" style="v" sid="1KI 4:4" />फेर यहोयादा का बेट्टा बनायाह प्रधान सेनापति था, अर सादोक अर एब्यातार याजक थे! <verse eid="1KI 4:4" /><verse number="5" style="v" sid="1KI 4:5" />नातान का बेट्टा अजर्याह भण्डारीयाँ कै उप्पर था, अर नातान का बेट्टा जाबूद याजक, अर राजा का दोस्त भी था। <verse eid="1KI 4:5" /><verse number="6" style="v" sid="1KI 4:6" />अहीशार राज घरान्‍ने कै उप्पर था, अर अब्दा का बेट्टा अदोनीराम बेगारां कै उप्पर मुखिया था।<verse eid="1KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7" />अर सुलैमान के बारहा भण्डारी थे, जो सारे इस्राएलियाँ के अधिकारी होकै राजा अर उसके घरान्‍ने कै खात्तर भोजन का बन्दोबस्त करैं थे। एक-एक माणस हर साल अपणे-अपणे नियुक्त महिन्‍ने म्ह बन्दोबस्त करै था। <verse eid="1KI 4:7" /><verse number="8" style="v" sid="1KI 4:8" />उनके नाम ये थे, यानिके एप्रैम के पहाड़ी देश म्ह बेन्हूर। <verse eid="1KI 4:8" /><verse number="9" style="v" sid="1KI 4:9" />अर माकस, शाल्बीम, बेतशेमेश अर एलोन-बेतानान म्ह बेन्देकेर था। <verse eid="1KI 4:9" /><verse number="10" style="v" sid="1KI 4:10" />अरुब्बोत म्ह बेन्हेसेद जिसके हक म्ह सोको अर हेपेर का सारा देश था। <verse eid="1KI 4:10" /><verse number="11" style="v" sid="1KI 4:11" />दोर के सारे ऊँच्‍चे देश म्ह बेन-अबीनादब जिसकी जनान्‍नी सुलैमान की बेट्टी तापत थी। <verse eid="1KI 4:11" /><verse number="12" style="v" sid="1KI 4:12" />अहीलूद का बेट्टा बाना जिसके हक म्ह तानाक, मगिद्दो अर बेतशान का वो सारा देश था, जो सारतान कै धोरै अर यिज्रेल कै तळै अर बेतशान तै आबेल-महोला ताहीं यानिके योकमाम की परली और तक सै। <verse eid="1KI 4:12" /><verse number="13" style="v" sid="1KI 4:13" />अर गिलाद शहर के रामोत म्ह बेनगेबेर था, जिसके हक म्ह मनश्शेई याईर के गिलाद के गाम थे, यानिके इस्से कै हक म्ह बाशान के अर्गोब का देश था, जिस म्ह शहरपनाह अर पीतळ के बेंड़े आळे साठ बड़े-बड़े नगर थे। <verse eid="1KI 4:13" /><verse number="14" style="v" sid="1KI 4:14" />इद्दो के बेट्टे अहीनादाब के हाथ म्ह महनैम था। <verse eid="1KI 4:14" /><verse number="15" style="v" sid="1KI 4:15" />नप्ताली म्ह अहीमास था, जिसनै सुलैमान की बासमत नाम की बेट्टी ताहीं ब्याह लिया था। <verse eid="1KI 4:15" /><verse number="16" style="v" sid="1KI 4:16" />आशेर अर आलोत म्ह हूशै का बेट्टा बाना, <verse eid="1KI 4:16" /><verse number="17" style="v" sid="1KI 4:17" />इस्साकार म्ह पारुह का बेट्टा यहोशापात, <verse eid="1KI 4:17" /><verse number="18" style="v" sid="1KI 4:18" />अर बिन्‍यामीन म्ह एला का बेट्टा शिमी था। <verse eid="1KI 4:18" /><verse number="19" style="v" sid="1KI 4:19" />ऊरी का बेट्टा गेबेर गिलाद म्ह यानिके एमोरियां के राजा सीहोन अर बाशान के राजा ओग कै देश म्ह था, इस सारे देश म्ह वोए अधिकारी था। <verse eid="1KI 4:19" /><verse number="20" style="v" sid="1KI 4:20" />यहूदा अर इस्राएल के माणस घणे थे, वे समुन्दर तट पै के रेत के कणां की तरियां घणे थे, अर खान्दे-पीन्दे अर आनन्द करदे रहे।<verse eid="1KI 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 4:21" />सुलैमान तो महानद तै लेकै पलिश्तियाँ के देश, अर मिस्र की सीमा ताहीं के सारे राज्याँ कै उप्पर राज करै था अर उनके माणस सुलैमान के जीवन भर भेंट ल्यान्दे, अर उसके अधीन रहवैं थे।<verse eid="1KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 4:22" />सुलैमान की रसोई म्ह एक दिन म्ह इतणा बणै था, यानिके तीस कोर<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="fq" closed="false">तीस कोर </char><char style="ft" closed="false">15,000 किलोग्राम</char></note> मैद्दा, साठ कोर<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="fq" closed="false">साठ कोर </char><char style="ft" closed="false">30,000 किलोग्राम</char></note> आटा, <verse eid="1KI 4:22" /><verse number="23" style="v" sid="1KI 4:23" />दस त्यार करे होए बळध अर चराईयाँ म्ह तै बीस बळध अर सौ भेड़-बकरी अर इननै छोड़ हिरण, चिकारे, यखमूर अर त्यार करे होए पक्षी। <verse eid="1KI 4:23" /><verse number="24" style="v" sid="1KI 4:24" />क्यूँके फरात के इस पार के सारे देश पै यानिके तिप्सह तै लेकै गाज़ा ताहीं जितने राजा थे, उन सारया पै सुलैमान प्रभुता करै, अर अपणे च्यांरु और के सारे रहण आळयां तै मेल राक्खै था। <verse eid="1KI 4:24" /><verse number="25" style="v" sid="1KI 4:25" />अर दान तै बेर्शेबा तक के सारे यहूदी अर इस्राएली अपणी-अपणी दाखलता अर अंजीर के दरखत तळै सुलैमान के जीवन भर निडर रहवैं थे। <verse eid="1KI 4:25" /><verse number="26" style="v" sid="1KI 4:26" />फेर उसके रथ के घोड्या कै खात्तर सुलैमान के चाळीस हजार रथ थे, अर उसके बारहा हजार घुड़सवार थे। <verse eid="1KI 4:26" /><verse number="27" style="v" sid="1KI 4:27" />अर वे भण्डारी अपणे-अपणे महिन्‍ने म्ह राजा सुलैमान कै खात्तर अर जितने उसकी मेज पै आवैं थे, उन सारया कै खात्तर खाणे का बन्दोबस्त करैं थे, किमे चीज की कमी होण न्ही पावै थी। <verse eid="1KI 4:27" /><verse number="28" style="v" sid="1KI 4:28" />घोड्या अर तगाजै तै चाल्‍लण आळे घोड्या कै खात्तर जौ अर पुआळ जित्त जरूरत होवै थी ओड़ै हुकम कै मुताबिक एक-एक माणस पोहचाया करै था।<verse eid="1KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 4:29" />अर परमेसवर नै सुलैमान ताहीं बुद्धि दी, अर उसकी समझ घणीए बढ़ाई, अर उसके हृदय म्ह समुन्दर तट के रेत के कणां कै बराबर अनगिणत गुण दिए। <verse eid="1KI 4:29" /><verse number="30" style="v" sid="1KI 4:30" />अर सुलैमान की बुद्धि पूर्व देश के सारे निवासियां अर मिस्रियाँ की भी बुद्धि तै बढ़कै बुद्धि थी। <verse eid="1KI 4:30" /><verse number="31" style="v" sid="1KI 4:31" />वो तो और सारे माणसां तै यानिके एतान, एज्रेही अर हेमान, अर माहोल के बेट्टे कलकोल, अर दर्दा तै भी घणा बुद्धिमान था अर उसकी चर्चा च्यांरु और की सारी जात्तां म्ह फैलगी। <verse eid="1KI 4:31" /><verse number="32" style="v" sid="1KI 4:32" />उसनै तीन हजार नीतिवचन कहे, अर उसके एक हजार पाँच गीत भी सैं। <verse eid="1KI 4:32" /><verse number="33" style="v" sid="1KI 4:33" />फेर उसनै लबानोन के देवदारुआं तै लेकै दीवार म्ह तै उगदे होए जूफा ताहीं के सारे दरखतां की चर्चा अर पशु पक्षियां अर रेंगणआळे जन्तुआं अर मछलियाँ की चर्चा करी। <verse eid="1KI 4:33" /><verse number="34" style="v" sid="1KI 4:34" />अर देश-देश के माणस धरती के सारे राजयां की और तै जिननै सुलैमान की बुद्धि की कीर्ति सुणी थी, उसकी बुद्धि की बात सुणण खात्तर आया करैं थे।<verse eid="1KI 4:34" /></para>
  <chapter eid="1KI 4" />
  <chapter number="5" style="c" sid="1KI 5" />
  <para style="s">परमेसवर का भवन बणाण की त्यारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1" />सोर नगर के राजा हीराम नै अपणे दूत सुलैमान कै धोरै भेज्जे, क्यूँके उसनै सुण्या था, के वो राजा की जगहां पै अभिषिक्त होकै अपणे पिता की जगहां पै राजा होया सै: अर दाऊद के जीवन भर हीराम उसका दोस्त बण्या रह्या। <verse eid="1KI 5:1" /><verse number="2" style="v" sid="1KI 5:2" />सुलैमान नै हीराम कै धोरै या खबर भेज्जी, <verse eid="1KI 5:2" /><verse number="3" style="v" sid="1KI 5:3" />“तन्‍नै बेरा सै, के मेरा पिता दाऊद अपणे परमेसवर यहोवा के नाम का एक भवन इस करकै न्ही बणवा सक्या के वो च्यांरु और लड़ाईयाँ म्ह तब ताहीं उळझया रह्या, जिब ताहीं यहोवा नै उसके दुश्मनां ताहीं उसके पैर तळै न्ही कर दिया। <verse eid="1KI 5:3" /><verse number="4" style="v" sid="1KI 5:4" />पर इब मेरे परमेसवर यहोवा नै मेरै ताहीं च्यांरु ओड़ तै विश्राम दिया सै अर ना तो कोए बिरोधी सै, अर ना कोए विपत्ति दिक्खै सै। <verse eid="1KI 5:4" /><verse number="5" style="v" sid="1KI 5:5" />मन्‍नै अपणे परमेसवर यहोवा के नाम का एक भवन बणवाण की ठाण राक्खी सै यानिके उस बात कै मुताबिक जो यहोवा नै मेरे पिता दाऊद तै कही थी, ‘तेरा बेट्टा जिसनै मै तेरी जगहां गद्दी पै बिठाऊँगा, वो मेरे आदर खात्तर मेरे नाम का भवन बणवावैगा।’ <verse eid="1KI 5:5" /><verse number="6" style="v" sid="1KI 5:6" />इस करकै इब तू मेरै खात्तर लबानोन पै तै देवदार काटण का हुकम दे, अर मेरे दास तेरे दास्सां कै गैल रहवैगें, अर जो किमे मजदूरी तू ठहरावै, वोए मै तन्‍नै तेरे दास्सां कै खात्तर दियुँगा, तन्‍नै बेरा तो सै, के सीदोनियां के बराबर लाकड़ी काट्टण का भेद हम माणसां म्ह तै कोए भी न्ही जाणदा।”<verse eid="1KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 5:7" />सुलैमान की या बात सुणकै, हीराम घणा आनन्दित होया, अर कह्या, “आज यहोवा धन्य सै, जिसनै दाऊद ताहीं उस बड़ी राष्ट्र पै राज करण खात्तर एक बुद्धिमान बेट्टा दिया सै।” <verse eid="1KI 5:7" /><verse number="8" style="v" sid="1KI 5:8" />फेर हीराम नै सुलैमान कै धोरै या खबर भेज्जी, “जो तन्‍नै मेरै धोरै खबर भेज्जी सै वा मन्‍नै मिल गई सै देवदार अर सनोवर की लाकड़ी कै बारै म्ह जो कुछ तू चावै, वोए मै करुँगा। <verse eid="1KI 5:8" /><verse number="9" style="v" sid="1KI 5:9" />मेरे दास लाकड़ी नै लबानोन तै समुन्दर तक पोहचावैंगे, फेर मै उनके बेंड़े बणवाकै, जो जगहां तू मेरै खात्तर ठहरावै, ओड़ैए समुन्दर के राह तै उन ताहीं पोंहचवा दियुँगा: ओड़ै मै उननै खोलकै गिरवा दियुँगा, अर तू उननै ले लिये: अर तू मेरे सेवकां खात्तर भोजन देकै, मेरी भी इच्छा पूरी करिये।” <verse eid="1KI 5:9" /><verse number="10" style="v" sid="1KI 5:10" />फेर हीराम सुलैमान की इच्छा कै मुताबिक उसनै देवदार अर सनोवर की लाकड़ी देण लाग्या। <verse eid="1KI 5:10" /><verse number="11" style="v" sid="1KI 5:11" />अर सुलैमान नै हीराम के परिवार के खाण कै खात्तर उस ताहीं बीस हजार कोर<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="fq" closed="false">बीस हजार कोर </char><char style="ft" closed="false">दो हजार टन या 200,000 किलोग्राम कणक</char></note> गेहूँ अर बीस कोर<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="fq" closed="false">बीस कोर </char><char style="ft" closed="false">चार लाख लीटर</char></note> पेरा होया तेल दिया; इस तरियां सुलैमान हीराम ताहीं हर साल दिया करै था।<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">प्रेरितों के काम 12:20 </char></note> <verse eid="1KI 5:11" /><verse number="12" style="v" sid="1KI 5:12" />यहोवा नै सुलैमान तै अपणे वचन कै मुताबिक बुद्धि दी, अर हीराम अर सुलैमान कै बीच मेल बण्या रह्या यानिके उन दोनुआ नै आप्पस म्ह करार भी कर लिया।<verse eid="1KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 5:13" />राजा सुलैमान नै पूरे इस्राएल म्ह तै तीस हजार माणस मजदूर लगाऐ, <verse eid="1KI 5:13" /><verse number="14" style="v" sid="1KI 5:14" />अर उननै लबानोन पहाड़ पै बारी-बारी करकै, महीन्‍ने-महीन्‍ने दस हजार भेज दिया करै था अर एक महिन्‍ना वे लबानोन पै, अर दो महिन्‍ने घर पै रह्या करैं थे; अर मजदूरां कै उप्पर अदोनीराम ठहराया गया। <verse eid="1KI 5:14" /><verse number="15" style="v" sid="1KI 5:15" />सुलैमान के सत्तर हजार बोझ ढोणआळे अर पहाड़ पै अस्सी हजार पेड़ काट्टण आळे अर पत्थर नै काटण आळे थे। <verse eid="1KI 5:15" /><verse number="16" style="v" sid="1KI 5:16" />इननै छोड़ सुलैमान के तीन हजार तीन सौ मुखिया थे, जो काम करण आळयां के उप्पर थे। <verse eid="1KI 5:16" /><verse number="17" style="v" sid="1KI 5:17" />फेर राजा के हुकम तै बड़े-बड़े अनमोल पत्थर ज्यांतै खोदकै लिकाड़े गए के भवन की नींव, गढ़े होए पत्थरां तै पाई जावै। <verse eid="1KI 5:17" /><verse number="18" style="v" sid="1KI 5:18" />सुलैमान के कारीगरां अर हीराम के कारीगरां अर गबालियां नै उन ताहीं गाढया, अर भवन के बणाण कै खात्तर लाकड़ी अर पत्थर त्यार करे।<verse eid="1KI 5:18" /></para>
  <chapter eid="1KI 5" />
  <chapter number="6" style="c" sid="1KI 6" />
  <para style="s">परमेसवर के भवन का निर्माण</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1" />इस्राएलियाँ के मिस्र देश तै लिकड़ण के च्यार सौ अस्सीवें साल कै बाद जो सुलैमान के इस्राएल पै राज करण का चौथा साल था, उसके जीव नाम के दुसरे महिन्‍ने<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">आध्धे अप्रैल तै लेकै आध्धे मई ताहीं</char></note> म्ह वो यहोवा का भवन बणाण लाग्या। <verse eid="1KI 6:1" /><verse number="2" style="v" sid="1KI 6:2" />जो भवन राजा सुलैमान नै यहोवा कै खात्तर बणाया उसकी लम्बाई साठ हाथ<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">साठ हाथ </char><char style="ft" closed="false">सत्ताईस मीटर</char></note>, चौड़ाई बीस हाथ<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">बीस हाथ </char><char style="ft" closed="false">नौ मीटर</char></note> अर ऊँचाई तीस हाथ<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">तीस हाथ </char><char style="ft" closed="false">साढ़े तेरह मीटर</char></note> की थी। <verse eid="1KI 6:2" /><verse number="3" style="v" sid="1KI 6:3" />अर भवन के मन्दर कै स्याम्ही के ओसारे की लम्बाई बीस हाथ<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="fq" closed="false">बीस हाथ </char><char style="ft" closed="false">नौ मीटर</char></note> की थी, यानिके भवन की चौड़ाई कै बराबर थी, अर ओसारे की चौड़ाई जो भवन कै स्याम्ही थी, वो दस हाथ<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="fq" closed="false">दस हाथ </char><char style="ft" closed="false">साढ़े चार मीटर</char></note> की थी। <verse eid="1KI 6:3" /><verse number="4" style="v" sid="1KI 6:4" />फेर उसनै भवन म्ह चौखट सुधा जाळीदार खिड़की बणाई। <verse eid="1KI 6:4" /><verse number="5" style="v" sid="1KI 6:5" />अर उसनै भवन कै आस्सै-पास्सै की दीवारां तै सट्या होया यानिके मन्दर अर दर्शन-स्थान दोन्‍नु दीवारां कै आस्सै-पास्सै उसनै मंजिल अर कोठड़ी बणाई। <verse eid="1KI 6:5" /><verse number="6" style="v" sid="1KI 6:6" />सबतै नीच्‍चै आळी मंजिल की चौड़ाई पाँच हाथ<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="fq" closed="false">पाँच हाथ </char><char style="ft" closed="false">सवा दो मीटर</char></note>, अर बीच आळी की छः हाथ, अर उप्पर आळी की सात हाथ<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="fq" closed="false">सात हाथ </char><char style="ft" closed="false">दो मीटर सत्तर सेंटीमीटर</char></note> की थी, क्यूँके उसनै भवन कै आस्सै-पास्सै दीवारां ताहीं बाहर की और कुर्सीदार बणाया था ज्यांतै के कड़ी भवन की दीवारां नै पकड़े होए ना हों।<verse eid="1KI 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 6:7" />बणान्दे बखत भवन इस्से पत्थरां का बणाया गया, जो ओड़ै ले आण तै पैहल्या गड़ कै ठीक करे गए थे, अर भवन के बणदे बखत हथौड़े, बसोल्‍ली या किसे तरियां के लोहे के औजार का शब्द कदे सुणाई न्ही पड्या।<verse eid="1KI 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 6:8" />बाहर की बीच आळी कोठड़ियाँ का द्वार भवन की दाहिनी ओड़ था, अर माणस चक्‍करदार सीढ़ियाँ पै होकै बीच आळी कोठड़ियाँ म्ह जान्दे, अर उनतै उप्पर आळी कोठड़ियाँ पै जाया करैं थे। <verse eid="1KI 6:8" /><verse number="9" style="v" sid="1KI 6:9" />उसनै भवन बणाकै पूरा करया, अर उसकी छात देवदार की कड़ियाँ अर तखत्याँ तै बणी थी। <verse eid="1KI 6:9" /><verse number="10" style="v" sid="1KI 6:10" />अर पूरे भवन तै लाग्गी होई जो मंजिल उसनै बणाई वो पाँच हाथ<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="fq" closed="false">पाँच हाथ </char><char style="ft" closed="false">सवा दो मीटर</char></note> ऊँच्‍ची थी, अर वे देवदार की कड़ियाँ के जरिये भवन तै मिलाई गई थी।<verse eid="1KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11" />फेर यहोवा का यो वचन सुलैमान कै धोरै पोहच्या, <verse eid="1KI 6:11" /><verse number="12" style="v" sid="1KI 6:12" />“यो भवन जो तू बणाण लाग रहया सै, जै तू मेरी विधियाँ पै चाल्‍लैगा, अर मेरे नियमां नै मान्‍नैगा, अर मेरे सारे हुकमां पै चालदा होया उनका पालन करदा रहवैगा, तो जो वचन मन्‍नै तेरे बारै म्ह तेरे पिता दाऊद तै दिया था उसनै मै पूरा करुँगा। <verse eid="1KI 6:12" /><verse number="13" style="v" sid="1KI 6:13" />अर मै इस्राएलियाँ कै बीच म्ह निवास करुँगा, अर अपणी इस्राएली प्रजा नै न्ही छोड़ूँगा।” <verse eid="1KI 6:13" /><verse number="14" style="v" sid="1KI 6:14" />आखर सुलैमान नै भवन ताहीं बणाकै पूरा करया।<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">प्रेरितों के काम 7:47</char></note> <verse eid="1KI 6:14" /><verse number="15" style="v" sid="1KI 6:15" />उसनै भवन की दीवारां पै भित्तर की और देवदार की नक्‍काशी करी; अर भवन के फर्श तै छात तक दीवारां पै भित्तर की और लाकड़ी की नक्‍काशी करी, अर भवन के फर्श ताहीं उसनै सनोवर के तख्तां तै बणाया। <verse eid="1KI 6:15" /><verse number="16" style="v" sid="1KI 6:16" />अर भवन कै पाच्छै की और भी उसनै बीस हाथ की दूरी पै फर्श तै लेकै दीवारां के उप्पर ताहीं देवदार की नक्‍काशी करी; इस तरियां उसनै परमपवित्र स्थान कै खात्तर भवन की एक भीत्तरी कोठड़ी बणाई। <verse eid="1KI 6:16" /><verse number="17" style="v" sid="1KI 6:17" />उसकै स्याम्ही का भवन यानिके मन्दर की लम्बाई चाळीस हाथ<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="fq" closed="false">चाळीस हाथ </char><char style="ft" closed="false">अठारह मीटर</char></note> की थी। <verse eid="1KI 6:17" /><verse number="18" style="v" sid="1KI 6:18" />भवन की दीवारां पै भित्तर की और देवदार की लाकड़ी की नक्‍काशी करी गई थी, अर उस म्ह कलियाँ अर खिले होए फूल खुदे थे, यो सारा देवदारे था: पत्थर किमे न्ही दिखाई पड़ै थे। <verse eid="1KI 6:18" /><verse number="19" style="v" sid="1KI 6:19" />भवन के भित्तर उसनै एक पवित्रस्‍थान यहोवा के करार का सन्दूक धरण खात्तर त्यार करया। <verse eid="1KI 6:19" /><verse number="20" style="v" sid="1KI 6:20" />अर उस पवित्रस्‍थान की लम्बाई, चौड़ाई अर ऊँचाई बीस-बीस हाथ<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="fq" closed="false">बीस-बीस हाथ </char><char style="ft" closed="false">नौ मीटर</char></note> की थी; अर उसनै उसपै उत्तम सोन्‍ना मढ़वाया अर वेदी की नक्‍काशी देवदार तै करी। <verse eid="1KI 6:20" /><verse number="21" style="v" sid="1KI 6:21" />फेर सुलैमान नै भवन ताहीं भित्तर तै शुद्ध सोन्‍ने तै मढ़वाया, अर पवित्रस्‍थान कै स्याम्ही सोन्‍ने की साँकळ लगाई; अर उस ताहीं भी सोन्‍ने तै मढ़वाया। <verse eid="1KI 6:21" /><verse number="22" style="v" sid="1KI 6:22" />अर उसनै पूरे भवन ताहीं सोन्‍ने तै मंढ़वा कै उसका काम पूरा करया। अर पवित्रस्‍थान की पूरी वेदी ताहीं भी उसनै सोन्‍ने तै मंढ़वाया।<verse eid="1KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23" />पवित्रस्‍थान म्ह उसनै दस-दस हाथ<note caller="+" style="f"><char style="fr" closed="false">6:23 </char><char style="fq" closed="false">दस-दस हाथ </char><char style="ft" closed="false">साढ़े चार मीटर</char></note> ऊँच्‍चे जैतून की लाकड़ी के दो करूब<note caller="+" style="f"><char style="fr" closed="false">6:23 </char><char style="ft" closed="false">पंखां आळा प्राणी जो परमेसवर कै तेज अर मौजूदगी नै दिखावै सै</char></note> बणाकै धरे। <verse eid="1KI 6:23" /><verse number="24" style="v" sid="1KI 6:24" />एक करूब का एक पंख पाँच हाथ<note caller="+" style="f"><char style="fr" closed="false">6:24 </char><char style="fq" closed="false">पाँच हाथ </char><char style="ft" closed="false">दो मीटर</char></note> का था, अर उसका दूसरा पंख भी पाँच हाथ का था, एक पंख के सिरे तै, दुसरे पंख के सिरे ताहीं लम्बाई दस हाथ थी। <verse eid="1KI 6:24" /><verse number="25" style="v" sid="1KI 6:25" />दूसरा करूब भी दस हाथ का था; दोन्‍नु करूब एके नाप अर एके आकार के थे। <verse eid="1KI 6:25" /><verse number="26" style="v" sid="1KI 6:26" />एक करूब की ऊँचाई दस हाथ की, अर दुसरे की भी इतणी ए थी। <verse eid="1KI 6:26" /><verse number="27" style="v" sid="1KI 6:27" />उसनै करूबां ताहीं भित्तर आळी जगहां म्ह धरवा दिया; अर करूबां के पंख इस्से फैल्‍ले थे, के एक करूब का एक पंख, एक दीवार तै, अर दुसरे का दूसरा पंख, दुसरी दीवार तै लाग्या होया था, फेर उनके दुसरे दो पंख भवन के बिचाळै एक दुसरे ताहीं छुया करैं थे। <verse eid="1KI 6:27" /><verse number="28" style="v" sid="1KI 6:28" />उसनै करूबां ताहीं सोन्‍ने तै मंढ़वाया।<verse eid="1KI 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 6:29" />उसनै भवन की दीवारां पै बाहर अर भित्तर च्यांरु और करूब, खजूर के दरखत अर खिले होए फूल खुदवाए। <verse eid="1KI 6:29" /><verse number="30" style="v" sid="1KI 6:30" />भवन कै भित्तर अर बाहर आळी कोठड़ी के फर्श उसनै सोन्‍ने तै मंढ़वाए।<verse eid="1KI 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 6:31" />पवित्रस्‍थान के प्रवेश-द्वार कै खात्तर उसनै जैतून की लाकड़ी के दरबाजे लगाऐ अर चौखट के सिरहाणै अर बाजुआं की बणावट पाँचकुणी थी। <verse eid="1KI 6:31" /><verse number="32" style="v" sid="1KI 6:32" />दोन्‍नु किवाड़ जैतून की लाकड़ी के थे, अर उसनै उन म्ह करूब, खजूर के दरखत अर खिले होए फूल खुदवाए अर सोन्‍ने तै मढ़यां अर करूबां अर खजूरां कै उप्पर सोन्‍ना मंढ़वा दिया गया।<verse eid="1KI 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 6:33" />इसे तरियां उसनै मन्दर के प्रवेश-द्वार कै खात्तर भी जैतून की लाकड़ी के चौखट के बाजू बणाए, ये चकोर थे। <verse eid="1KI 6:33" /><verse number="34" style="v" sid="1KI 6:34" />दोन्‍नु दरबाजे सनोवर की लाकड़ी के थे, जिन म्ह तै एक दरबाजे के दो पल्‍ले थे; अर दुसरे दरबाजे के दो पल्‍ले थे जो पलटकै दुहरे हो जावैं थे। <verse eid="1KI 6:34" /><verse number="35" style="v" sid="1KI 6:35" />उनपै भी उसनै करूब अर खजूर के दरखत अर खिले होए फूल खुदवाए अर खुदे होए काम पै उसनै सोन्‍ना मंढ़वाया। <verse eid="1KI 6:35" /><verse number="36" style="v" sid="1KI 6:36" />उसनै भित्तर आळे आँगण के घेरे ताहीं गढ़े होए पत्थरां के तीन रद्दे, अर एक परत देवदार की कड़ी लगाकै बणाया।<verse eid="1KI 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 6:37" />चौथे साल के जीव नाम के महिन्‍ने म्ह यहोवा के भवन की नींव धरी गई। <verse eid="1KI 6:37" /><verse number="38" style="v" sid="1KI 6:38" />अर ग्यारहवें साल के बूल<note caller="+" style="f"><char style="fr" closed="false">6:38 </char><char style="ft" closed="false">बूल एक कनानी नाम सै जो अक्टूबर कै बीच आळे बखत तै लेकै नवम्बर के बीच आळे बखत ताहीं दिखावै सै</char></note> नाम के आठवें महिन्‍ने म्ह, वो भवन उस सारया सुधा जो उस म्ह उचित समझया गया बण चुक्या। इस तरियां सुलैमान नै उस ताहीं बणाण म्ह सात साल लाग्गे।<verse eid="1KI 6:38" /></para>
  <chapter eid="1KI 6" />
  <chapter number="7" style="c" sid="1KI 7" />
  <para style="s">सुलैमान के और निर्माण</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1" />सुलैमान नै अपणा महल भी बणाया, अर उसके बणाण के काम म्ह तेराह साल लाग्गे।<verse eid="1KI 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 7:2" />उसनै लबानोन का वन नाम का महल बणाया जिसकी लम्बाई सौ हाथ<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="fq" closed="false">सौ हाथ </char><char style="ft" closed="false">पैंतालीस मीटर</char></note>, चौड़ाई पचास हाथ<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="fq" closed="false">पचास हाथ </char><char style="ft" closed="false">साढ़े बाईस मीटर</char></note> अर ऊँचाई तीस हाथ<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="fq" closed="false">तीस हाथ </char><char style="ft" closed="false">साढ़े तेरह मीटर</char></note> की थी; वो तो देवदार के खम्भ्यां की च्यार पंक्तियाँ पै बण्या अर खम्भ्यां पै देवदार की कड़ी धरी गई। <verse eid="1KI 7:2" /><verse number="3" style="v" sid="1KI 7:3" />अर पैंताळीस खम्भ्यां के उप्पर देवदार की छात आळी कोठड़ी बणी यानिके एक-एक मंजिल म्ह पन्द्रह कोठड़ी बणी। <verse eid="1KI 7:3" /><verse number="4" style="v" sid="1KI 7:4" />तीन्‍नु मंजिलां म्ह कड़ी धरी गई, अर तीन्‍नु म्ह खिड़की आम्ही-स्याम्ही बणी। <verse eid="1KI 7:4" /><verse number="5" style="v" sid="1KI 7:5" />अर सारे द्वार अर बाजुआं की कड़ी भी चकोर थी, अर तीन्‍नु मंजिलां म्ह खिड़की आम्ही-स्याम्ही बणी।<verse eid="1KI 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 7:6" />उसनै एक खम्भे आळा बरामदा भी बणाया जिसकी लम्बाई पचास हाथ अर चौड़ाई तीस हाथ<note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="fq" closed="false">लम्बाई पचास हाथ अर चौड़ाई तीस हाथ </char><char style="ft" closed="false">क्रमशः 4 फुट अर 7 फुट</char></note> की थी, अर इन खम्भ्यां कै स्याम्ही एक खम्भे आळा बरामदा अर उसके स्याम्ही देहळी बणाई।<verse eid="1KI 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 7:7" />फेर उसनै न्याय के सिंहासन कै खात्तर भी एक बरामदा बणाया, जो न्याय का बरामदा कुहाया; अर उस म्ह एक फर्श तै दुसरे फर्श ताहीं देवदार की नक्‍काशी थी।<verse eid="1KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 7:8" />उसके रहण का भवन जो उस बरामदा कै भित्तर के एक और आँगण म्ह बण्या, वो भी उस्से ढंग तै बण्या। फेर उसे बरामदा कै बराबर तै सुलैमान नै फिरौन की बेट्टी कै खात्तर जिस ताहीं उसनै ब्याह लिया था, एक और भवन बणाया।<verse eid="1KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 7:9" />यो सारे घर बाहर भित्तर नींव तै मुंडेर ताहीं इसे अनमोल अर गढ़े होए पत्थरां के बणे जो नापकै, अर आरयां तै चीर कै त्यार करे गए थे अर बाहर के आँगण तै लेकै बड़े आँगण ताहीं लगाऐ गए। <verse eid="1KI 7:9" /><verse number="10" style="v" sid="1KI 7:10" />उसकी नींव बहुमूल्य अर बड़े-बड़े यानिके दस-दस अर आठ-आठ हाथ के पत्थरां की पाई गई थी। <verse eid="1KI 7:10" /><verse number="11" style="v" sid="1KI 7:11" />अर उप्पर भी बहुमूल्य पत्थर थे, जो नाप तै गढ़े होए थे, अर देवदार की लाकड़ी भी थी। <verse eid="1KI 7:11" /><verse number="12" style="v" sid="1KI 7:12" />बड़े आँगण के च्यांरु और के घेरे म्ह गढ़े होए पत्थरां के तीन रद्दे, अर देवदार की कड़ियाँ की एक परत थी, जिस तरियां के यहोवा के भवन कै भित्तर आळे आँगण अर भवन के ओसारे म्ह लाग्गे थे। <verse eid="1KI 7:12" /><verse number="13" style="v" sid="1KI 7:13" />फेर राजा सुलैमान नै सोर तै हूराम ताहीं बुलावा भेज्या। <verse eid="1KI 7:13" /><verse number="14" style="v" sid="1KI 7:14" />वो नप्ताली के गोत्र की किसे बिधवा का बेट्टा था, अर उसका पिता एक सोरवासी ठठेरा था, अर वो पीतळ की सारी तरियां की कारीगरी म्ह पूरी बुद्धि, निपुणता अर समझ राक्खै था। इस करकै वो राजा सुलैमान कै धोरै आकै उसका सारा काम करण लाग्या। <verse eid="1KI 7:14" /><verse number="15" style="v" sid="1KI 7:15" />उसनै पीतळ ढाळ कै अठारह-अठारह हाथ<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="fq" closed="false">अठारह हाथ </char><char style="ft" closed="false">आठ मीटर</char></note> ऊँच्‍चे दो खम्भे बणाए, अर एक-एक का घेरा बारहा हाथ<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="fq" closed="false">बारहा हाथ </char><char style="ft" closed="false">साढ़े पाँच मीटर</char></note> के सूत का था ये भित्तर तै खोखळे थे, अर इसकी धातु की मोटाई च्यार आंगळ थी। <verse eid="1KI 7:15" /><verse number="16" style="v" sid="1KI 7:16" />उसनै खम्भ्यां के सिरयां पै लगाण ताहीं पीतळ ढाळ कै दो कँगणी बणाई; एक-एक कँगणी की ऊँचाई, पाँच-पाँच हाथ की थी। <verse eid="1KI 7:16" /><verse number="17" style="v" sid="1KI 7:17" />खम्भ्यां के सिरयां पै की कँगणियाँ कै खात्तर च्यार खान्‍ने की सात-सात जाळी, अर साँकलां की सात-सात झालर बणी। <verse eid="1KI 7:17" /><verse number="18" style="v" sid="1KI 7:18" />उसनै खम्भ्यां ताहीं भी इस तरियां तै बणाया के खम्भ्यां के सिरयां पै की एक-एक कँगणी नै ढाँप्पण कै खात्तर च्यांरु और जाळी की एक-एक पाँति पै अनारां की दो पंक्तियाँ हों। <verse eid="1KI 7:18" /><verse number="19" style="v" sid="1KI 7:19" />जो कँगणियाँ ओसारां म्ह खम्भ्यां के सिरयां पै बणी, उन म्ह च्यार-च्यार हाथ ऊँच्‍चे सोसन के फूल बणे होए थे। <verse eid="1KI 7:19" /><verse number="20" style="v" sid="1KI 7:20" />अर एक-एक खम्भे के सिरे पै, उस गोळाई कै धोरै जो जाळी तै लाग्गी थी, एक और कँगणी बणी, अर एक-एक कँगणी पै जो अनार च्यांरु और लाइनां म्ह बणे थे वो दो सौ थे। <verse eid="1KI 7:20" /><verse number="21" style="v" sid="1KI 7:21" />उन खम्भ्यां ताहीं उसनै मन्दर के ओसारे कै धोरै खड्या करया, अर दाहिनी और के खम्भे ताहीं खड्या करकै उसका नाम याकीन<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="fq" closed="false">याकीन </char><char style="ft" closed="false">परमेसवर नै बणाया</char></note> धरया; फेर बाई और के खम्भे ताहीं खड्या करकै उसका नाम बोअज<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="fq" closed="false">बोअज </char><char style="ft" closed="false">परमेसवर शक्ति देवै सै</char></note> धरया। <verse eid="1KI 7:21" /><verse number="22" style="v" sid="1KI 7:22" />अर खम्भ्यां के सिरयां पै सोसन के फूल का काम बण्या था खम्भ्यां का काम इसे तरियां पूरा होया। <verse eid="1KI 7:22" /><verse number="23" style="v" sid="1KI 7:23" />फेर उसनै एक ढाळया होया एक बड़ा हौद बणाया, जो एक छोर तै दुसरी छोर ताहीं दस हाथ चौड़ा था, उसका आकार गोळ था, अर उसकी ऊँचाई पाँच हाथ की थी, अर उसके च्यांरु और का घेरा तीस हाथ के सूत कै बराबर था। <verse eid="1KI 7:23" /><verse number="24" style="v" sid="1KI 7:24" />अर उसके च्यांरु और के किनारे कै नीच्‍चै एक-एक हाथ म्ह दस-दस कलियाँ बणी, जो हौद नै घेरे थी; जिब वो ढाळया गया; फेर ये कली भी दो लाइनां म्ह ढाळी गई। <verse eid="1KI 7:24" /><verse number="25" style="v" sid="1KI 7:25" />अर वो बारहा बणे होए बळधां पै धरया गया जिन म्ह तै तीन उत्तर, तीन पश्चिम, तीन दक्षिण, अर तीन पूर्व की और मुँह करै होए थे; अर उन्हे कै उप्पर हौद था, अर उन सारया का पिछला हिस्सा भित्तर की और था। <verse eid="1KI 7:25" /><verse number="26" style="v" sid="1KI 7:26" />उसकी मोटाई मुट्ठी भर<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="fq" closed="false">मुट्ठी भर </char><char style="ft" closed="false">3 इंच</char></note> की थी, अर उसका किनारा कटोरे के किनारे कै बराबर सोसन के फूल्‍लां के जिसा बण्या था, अर उस म्ह दो हजार बत<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="fq" closed="false">दो हजार बत </char><char style="ft" closed="false">लगभग 40,000 लीटर</char></note> पाणी समावै था। <verse eid="1KI 7:26" /><verse number="27" style="v" sid="1KI 7:27" />फेर हूराम नै पीतळ के दस ठेल्‍ले बणाए, एक-एक ठेल्‍ले की लम्बाई च्यार हाथ, चौड़ाई भी च्यार हाथ अर ऊँचाई तीन हाथ की थी। <verse eid="1KI 7:27" /><verse number="28" style="v" sid="1KI 7:28" />उन पायां की बणावट इस तरियां थी; उनकै पटड़ियाँ थी, अर पटड़ियाँ कै बिचाळै जोड़ भी थे।<verse eid="1KI 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 7:29" />अर जोड़ा कै बिचाळै की पटड़ियाँ पै सिंह, बळध, अर करूब बणे थे अर जोड़ा के उप्पर भी एक-एक और ठेला बण्या अर शेरां अर बळधां कै नीच्‍चै लटकदी होई झालर बणी थी। <verse eid="1KI 7:29" /><verse number="30" style="v" sid="1KI 7:30" />एक-एक ठेल्‍ले कै खात्तर पीतळ के च्यार पहिये अर पीतळ की धुरियाँ बणी; अर एक-एक के च्यांरु कुण्यां तै लाग्गे होए आधार भी ढाळकै बणाए गए जो हौदी कै तळै ताहीं पोहचै थे, अर एक-एक आधार के धोरै झालर बणी होई थी। <verse eid="1KI 7:30" /><verse number="31" style="v" sid="1KI 7:31" />हौदी का मुँह जो ठेल्‍ले की कँगणी कै भित्तर अर उप्पर भी था वो एक हाथ ऊँच्‍चा था, अर ठेल्‍ले का मुँह जिसकी चौड़ाई डेढ़ हाथ<note caller="+" style="f"><char style="fr" closed="false">7:31 </char><char style="ft" closed="false">लगभग 75 सेंटीमीटर या 27 इंच</char></note> की थी, वो पाये की बणावट कै बराबर गोळ बण्या; अर उसके मुँह पै भी किमे खोद्या होया काम था अर उनकी पटड़ियाँ गोळ न्ही, चकोर थी। <verse eid="1KI 7:31" /><verse number="32" style="v" sid="1KI 7:32" />अर च्यांरु पहिये, पटड़ियाँ कै नीच्‍चै थे, अर एक-एक ठेल्‍ले के पहियाँ म्ह धुरियाँ भी थी; अर एक-एक पहिये की ऊँचाई डेढ़-डेढ़ हाथ<note caller="+" style="f"><char style="fr" closed="false">7:32 </char><char style="fq" closed="false">डेढ़-डेढ़ हाथ </char><char style="ft" closed="false">25 इंच</char></note> की थी। <verse eid="1KI 7:32" /><verse number="33" style="v" sid="1KI 7:33" />पहियाँ की बणावट, रथ के पहिये की जिसी थी, अर उनकी धुरियाँ, चक्र, आरे, अर नाभें सारी ढाळी होई थी। <verse eid="1KI 7:33" /><verse number="34" style="v" sid="1KI 7:34" />अर एक-एक ठेल्‍ले के च्यांरु कुण्यां पै च्यार आधार थे, अर आधार अर ठेल्‍ले दोन्‍नु एक ए टुकड़े के बणे थे। <verse eid="1KI 7:34" /><verse number="35" style="v" sid="1KI 7:35" />अर एक-एक ठेल्‍ले के सिरे पै आध्धा हाथ ऊँच्‍ची च्यांरु और गोळाई थी, अर ठेल्‍ले के सिरे पै की टेकें अर पटड़ियाँ ठेल्‍ले तै जुड़े होए एक ए टुकड़े के बणे थे। <verse eid="1KI 7:35" /><verse number="36" style="v" sid="1KI 7:36" />अर टेकां के पाटां अर पटड़ियाँ पै जितनी जगहां जिसपै थी, उस म्ह उसनै करूब, अर शेर, अर खजूर के दरखत खोदकै भर दिये, अर च्यांरु और झालर भी बणाई। <verse eid="1KI 7:36" /><verse number="37" style="v" sid="1KI 7:37" />इस तरियां तै उसनै दस ठेल्यां ताहीं बणाया; सारया का एके साँचा अर एके नाप, अर एके आकार था। <verse eid="1KI 7:37" /><verse number="38" style="v" sid="1KI 7:38" />उसनै पीतळ की दस हौदी बणाई। हरेक हौदी म्ह चाळीस-चाळीस बत<note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="fq" closed="false">चाळीस-चाळीस बत </char><char style="ft" closed="false">एक हजार आठ सौ लीटर</char></note> पाणी समावै था; अर हरेक, हौदी च्यार-च्यार हाथ<note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="fq" closed="false">च्यार हाथ </char><char style="ft" closed="false">लगभग 6 मीटर</char></note> चौड़ी थी, अर दसो ठेल्यां म्ह तै एक-एक पै, एक-एक हौदी थी। <verse eid="1KI 7:38" /><verse number="39" style="v" sid="1KI 7:39" />उसनै पाँच हौदी भवन के दक्षिण की और, अर पाँच उसकी उत्तर की और धर दी; अर हौद ताहीं भवन की दाहिनी और यानिके दक्षिण-पूर्व की और धर दिया। <verse eid="1KI 7:39" /><verse number="40" style="v" sid="1KI 7:40" />हूराम नै हौदियाँ, फावड़ियाँ, अर कटोरयां ताहीं भी बणाया। सो हूराम नै राजा सुलैमान कै खात्तर यहोवा के भवन म्ह जितना काम करणा था, वो सारा पूरा कर दिया, <verse eid="1KI 7:40" /><verse number="41" style="v" sid="1KI 7:41" />यानिके दो खम्भे, अर उन कँगणियाँ की गोळाई जो दोन्‍नु खम्भ्यां के सिरे पै थी, अर दोन्‍नु खम्भ्यां के सिरयां पै की गोळाई के ढाँप्पण ताहीं दो-दो जाळी, अर दोन्‍नु जाळियाँ कै खात्तर च्यार-च्यार सौ अनार, <verse eid="1KI 7:41" /><verse number="42" style="v" sid="1KI 7:42" />यानिके खम्भ्यां के सिरयां पै जो गोळाई थी, उनके ढाँप्पण कै खात्तर यानिके एक-एक जाळी कै खात्तर अनारां की दो-दो पंक्तियाँ; <verse eid="1KI 7:42" /><verse number="43" style="v" sid="1KI 7:43" />दस ठेल्‍ले अर इन पै की दस हौदी, <verse eid="1KI 7:43" /><verse number="44" style="v" sid="1KI 7:44" />एक हौद अर उसके नीच्‍चै के बारहा बळध, अर हँडे, फावड़ियाँ, <verse eid="1KI 7:44" /><verse number="45" style="v" sid="1KI 7:45" />अर कटोरे बणे। ये सारे बरतन जिन ताहीं हूराम नै यहोवा के भवन कै निमित्त राजा सुलैमान कै खात्तर बणाया, वे चमकदे होए पीतळ के बणे। <verse eid="1KI 7:45" /><verse number="46" style="v" sid="1KI 7:46" />राजा नै उन ताहीं यरदन की तराई म्ह यानिके सुक्‍कोत अर सारतान के बिचाळै की चिकणी माट्टी आळे साँचा म्ह पिंघल्या होया पीतळ ढाळया। <verse eid="1KI 7:46" /><verse number="47" style="v" sid="1KI 7:47" />अर सुलैमान नै भोत घणे होण कै कारण सारे बरतनां ताहीं बिना तोल्‍ले छोड़ दिया, आखर पीतळ के तौल का वजन का बेरा न्ही पाट सक्या।<verse eid="1KI 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 7:48" />यहोवा के भवन के जितने बरतन थे सुलैमान नै सारे बणाए, यानिके सोन्‍ने की वेदी, अर सोन्‍ने की वो मेज जिसपै भेंट की रोट्टी धरी जावै थी, <verse eid="1KI 7:48" /><verse number="49" style="v" sid="1KI 7:49" />अर शुद्ध सोन्‍ने की दीवट जो भीत्तरी कोठड़ी कै आग्गै पाँच तो दक्षिण की और, अर पाँच उत्तर की और धरी गई; अर सोन्‍ने के फूल, <verse eid="1KI 7:49" /><verse number="50" style="v" sid="1KI 7:50" />दीवा अर चिमटे, अर शुद्ध सोन्‍ने के तासळे, कैंचियाँ, कटोरे, धूपदान, अर कड़छे अर भित्तर आळा भवन जो परमपवित्र स्थान कुहवावै सै, अर भवन जो मन्दर कुहवावै सै, दोन्‍नु के किवाड़ां कै खात्तर सोन्‍ने के कब्जे बणे।<verse eid="1KI 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 7:51" />इस तरियां जो-जो काम राजा सुलैमान नै यहोवा के भवन कै खात्तर करया, वो सारा पूरा होया। फेर सुलैमान नै अपणे पिता दाऊद के पवित्र करे होए सोन्‍ने-चाँदी अर बरतनां ताहीं भित्तर पोहचाकै यहोवा के भवन के भण्डारां म्ह धर दिया।<verse eid="1KI 7:51" /></para>
  <chapter eid="1KI 7" />
  <chapter number="8" style="c" sid="1KI 8" />
  <para style="s">मन्दर की प्रतिष्ठा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1" />फेर सुलैमान नै इस्राएली बुजुर्गां ताहीं अर गोत्रां के सारे खास माणसां ताहीं भी जो इस्राएलियाँ के पूर्वजां के घरान्‍ने के प्रधान थे, यरुशलेम म्ह अपणे धोरै इस इरादे तै कठ्ठे करे, के वे यहोवा के करार का सन्दूक दाऊदपुर यानिके सिय्योन तै उप्पर ले आवैं।<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">प्रकाशितवाक्य 11:19</char></note> <verse eid="1KI 8:1" /><verse number="2" style="v" sid="1KI 8:2" />आखर म्ह सारे इस्राएली माणस एतानीम नाम के सातवें महिन्‍ने के त्यौहार के बखत राजा सुलैमान कै धोरै कठ्ठे होए।<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">यो कनानी महीना था जिसनै “तिशरी” कह्या जावै था अर आज कै बखत म्ह यो बीच आळे सितम्बर तै लेकै बीच आळे अक्टूबर ताहीं होवै था </char></note> <verse eid="1KI 8:2" /><verse number="3" style="v" sid="1KI 8:3" />जिब सारे इस्राएली अगुवे आए, फेर याजकां नै सन्दूक ताहीं ठा लिया। <verse eid="1KI 8:3" /><verse number="4" style="v" sid="1KI 8:4" />अर यहोवा का सन्दूक, अर मिलापआळे तम्बू, अर जितने पवित्र बरतन उस तम्बू म्ह थे, उन सारया ताहीं याजक अर लेवीय माणस उप्पर लेगे। <verse eid="1KI 8:4" /><verse number="5" style="v" sid="1KI 8:5" />अर राजा सुलैमान अर सारी इस्राएली मण्डळी, जो उसकै धोरै कठ्ठी होई थी, वे सारे सन्दूक कै स्याम्ही इतणी भेड़ अर बळध बलि करण लागरे थे, जिनकी गिणती किसे तरियां तै न्ही हो सकै थी। <verse eid="1KI 8:5" /><verse number="6" style="v" sid="1KI 8:6" />फेर याजकां नै यहोवा के वाचा का सन्दूक उसकी जगहां पै यानिके भवन के पवित्रस्‍थान म्ह, जो परमपवित्र स्थान सै, पोहचाकै करूबां के पंखां कै तळै धर दिया।<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">प्रकाशितवाक्य 11:19</char></note> <verse eid="1KI 8:6" /><verse number="7" style="v" sid="1KI 8:7" />करूब सन्दूक की जगहां कै उप्पर पंख इसे फैलाए होए थे, के वे उप्पर तै सन्दूक अर उसके डण्ड्याँ ताहीं ढाँप्पे थे। <verse eid="1KI 8:7" /><verse number="8" style="v" sid="1KI 8:8" />डण्डे तो इतणे लाम्बे थे, के उनके सिरे उस पवित्रस्‍थान तै जो पवित्रस्‍थान कै स्याम्ही था दिखाई पड़ै थे पर बाहर तै वे दिखाई न्ही देवैं थे। वे आज कै दिन ताहीं उरैए मौजूद सैं। <verse eid="1KI 8:8" /><verse number="9" style="v" sid="1KI 8:9" />सन्दूक म्ह किमे न्ही था, उन दो पटियाँ नै छोड़ जो मूसा नै होरेब पहाड़<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="fq" closed="false">होरेब पहाड़ </char><char style="ft" closed="false">सीनै पहाड़</char></note> म्ह उसके भित्तर उस बखत धरी, जिब यहोवा नै इस्राएलियाँ के मिस्र तै लिकड़ण पै उनकै गैल करार करया था। <verse eid="1KI 8:9" /><verse number="10" style="v" sid="1KI 8:10" />जिब याजक पवित्रस्‍थान तै लिकड़े, फेर यहोवा के भवन म्ह घणा बाद्दळ छा गया। <verse eid="1KI 8:10" /><verse number="11" style="v" sid="1KI 8:11" />अर बाद्दळ के काम्मां के कारण याजक सेवा-पाणी करण खात्तर खड़े ना रह सके, क्यूँके यहोवा का तेज यहोवा के भवन म्ह भरग्या था।<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">प्रकाशितवाक्य 15:18</char></note><verse eid="1KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 8:12" />फेर सुलैमान बिनती करण लाग्या, “यहोवा नै कह्या था, के मै घोर अन्धकार म्ह वास करे रहूँगा। <verse eid="1KI 8:12" /><verse number="13" style="v" sid="1KI 8:13" />सचमुच मन्‍नै तेरै खात्तर एक रहण की जगहां, बलके इसा दृढ़ स्थान बणाया सै, जिस म्ह तू युगानुयुग बण्या रहवै।” <verse eid="1KI 8:13" /><verse number="14" style="v" sid="1KI 8:14" />फेर राजा नै इस्राएल की पूरी सभा की और मुँह फेरकै उन ताहीं आशीर्वाद दिया; अर पूरी सभा खड़ी रह्यी। <verse eid="1KI 8:14" /><verse number="15" style="v" sid="1KI 8:15" />अर उसनै कह्या, “धन्य सै इस्राएल का परमेसवर यहोवा! जिसनै अपणे मुँह तै मेरे पिता दाऊद ताहीं यो वचन दिया था, अर अपणे हाथ तै उस ताहीं पूरा करया सै, <verse eid="1KI 8:15" /><verse number="16" style="v" sid="1KI 8:16" />‘जिस दिन तै मै अपणी प्रजा इस्राएल ताहीं मिस्र तै लिकाड़ ल्याया, जिब तै मन्‍नै किसे इस्राएली गोत्र का कोए नगर न्ही चुण्या, जिस म्ह मेरे नाम के निवास कै खात्तर भवन बणाया जावै; पर मन्‍नै दाऊद ताहीं चुण लिया, के वो मेरी प्रजा इस्राएल का हकदार हो।’ <verse eid="1KI 8:16" /><verse number="17" style="v" sid="1KI 8:17" />इब मेरे पिता दाऊद की या इच्छा तो थी के इस्राएल के परमेसवर यहोवा के नाम का एक भवन बणावै। <verse eid="1KI 8:17" /><verse number="18" style="v" sid="1KI 8:18" />पर यहोवा नै मेरे पिता दाऊद तै कह्या, ‘या जो तेरी इच्छा सै, के यहोवा के नाम का एक भवन बणावै, इसी इच्छा करकै तन्‍नै भला तो करया;<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">प्रेरितों के काम 7:45-46</char></note> <verse eid="1KI 8:18" /><verse number="19" style="v" sid="1KI 8:19" />फेर भी तू उस भवन ताहीं ना बणावैगा; तेरा जो अपणा बेट्टा होवैगा, वो मेरे नाम का भवन बणावैगा।’ <verse eid="1KI 8:19" /><verse number="20" style="v" sid="1KI 8:20" />यो जो वचन यहोवा नै कह्या था, उस ताहीं उसनै पूरा भी करया सै, अर मै अपणे पिता दाऊद की जगहां पै उठकै, यहोवा के वचन कै मुताबिक इस्राएल की गद्दी पै विराजमान सूं, अर इस्राएल के परमेसवर यहोवा के नाम तै इस भवन ताहीं बणाया सै।<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">प्रेरितों के काम 7:47</char></note> <verse eid="1KI 8:20" /><verse number="21" style="v" sid="1KI 8:21" />अर इस म्ह मन्‍नै एक जगहां उस सन्दूक कै खात्तर ठैहराई सै, जिस म्ह यहोवा का वो करार सै, जो उसनै म्हारे पुरखां ताहीं मिस्र देश तै लिकाड़ण कै बखत उनतै करया था।” <verse eid="1KI 8:21" /><verse number="22" style="v" sid="1KI 8:22" />फेर सुलैमान इस्राएल की पूरी सभा के देखदे यहोवा की वेदी कै स्याम्ही खड्या होया, अर अपणे हाथ सुर्ग की और फैलाकै कह्या, हे यहोवा! <verse eid="1KI 8:22" /><verse number="23" style="v" sid="1KI 8:23" />हे इस्राएल के परमेसवर! तेरे बराबर ना तो उप्पर सुर्ग म्ह, अर ना तळै धरती पै कोए परमेसवर सै: तेरे जो दास अपणे पूरे मन तै अपणे ताहीं तेरे सम्मुख जाणकै चाल्‍लै सैं, उनकै खात्तर तू अपणा करार पूरा करै, अर करुणा करदा रहवै सै। <verse eid="1KI 8:23" /><verse number="24" style="v" sid="1KI 8:24" />जो वचन तन्‍नै मेरे पिता दाऊद ताहीं दिया था, उसका तन्‍नै पालन करया सै, जिसा तन्‍नै अपणे मुँह तै कह्या था, उसाए अपणे हाथ तै उस ताहीं पूरा भी करया सै, जिसा के आज सै। <verse eid="1KI 8:24" /><verse number="25" style="v" sid="1KI 8:25" />इस करकै इब हे इस्राएल के परमेसवर यहोवा! इस वचन नै भी पूरा कर, जो तन्‍नै अपणे दास मेरे पिता दाऊद ताहीं दिया था, “तेरे कुल म्ह, मेरै स्याम्ही इस्राएल की गद्दी पै विराजण आळे सदा बणे रहवैगें इतणा हो के जिसा तू खुद मन्‍नै स्याम्ही जाणकै चालदा रह्या, उस्से तरियां ए तेरे वंश के माणस अपणी चाल चलण म्ह इसीए चौकसी करैं।” <verse eid="1KI 8:25" /><verse number="26" style="v" sid="1KI 8:26" />इस करकै इब हे इस्राएल के परमेसवर अपणा जो वचन तन्‍नै अपणे दास मेरे पिता दाऊद ताहीं दिया था उसनै सच्‍चा सिध्द कर।<verse eid="1KI 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 8:27" />“के परमेसवर सचमुच धरती पै वास करैगा, सुर्ग म्ह बलके सबतै ऊँच्‍चे सुर्ग म्ह भी तू न्ही समान्दा, फेर मेरे बणाए होए इस भवन म्ह किस तरियां समावैगा।<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">प्रेरितों के काम 17:24</char></note> <verse eid="1KI 8:27" /><verse number="28" style="v" sid="1KI 8:28" />फेर भी हे मेरे परमेसवर यहोवा! अपणे दास की प्रार्थना अर गिड़गिड़ाणे की और कान लगाकै, मेरी चिल्‍लाहट अर या प्रार्थना सुण! जो मै आज तेरै स्याम्ही कर रह्या सूं; <verse eid="1KI 8:28" /><verse number="29" style="v" sid="1KI 8:29" />के तेरी आँख इस भवन की और यानिके इस जगहां की और जिसकै बारै म्ह तन्‍नै कह्या सै, ‘मेरा नाम ओड़ै रहवैगा,’ रात-दिन खुली रहवैं अर जो प्रार्थना तेरा दास इस जगहां की और करै, उसनै तू सुण ले। <verse eid="1KI 8:29" /><verse number="30" style="v" sid="1KI 8:30" />अर तू अपणे दास, अर अपणी प्रजा इस्राएल की प्रार्थना जिस ताहीं वे इस जगहां की और गिड़गिड़ाकै करैं उसनै सुणिये, बल्के सुर्ग म्ह तै जो तेरा निवास-स्थान सै सुण लिये, अर सुणकै माफ करिये।”<verse eid="1KI 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 8:31" />“जिब कोए किसे दुसरे का अपराध करै, अर उस ताहीं कसम खुआई जावै, अर वो आकै इस भवन म्ह तेरी वेदी कै स्याम्ही कसम खावै, <verse eid="1KI 8:31" /><verse number="32" style="v" sid="1KI 8:32" />फेर तू सुर्ग म्ह तै सुणकै, यानिके अपणे दास्सां का न्याय करकै दुष्ट नै दुष्ट ठहरा अर उसकी चाल उसे कै सिर पै बोहड़ा दे, अर निर्दोष नै निर्दोष ठहराकै, उसकी धार्मिकता कै मुताबिक उसनै फळ दिये। <verse eid="1KI 8:32" /><verse number="33" style="v" sid="1KI 8:33" />फेर जिब तेरी प्रजा इस्राएल तेरै खिलाफ पाप करण कै कारण अपणे बैरियाँ तै हार जावै, अर तेरी और मुड़कै तेरा नाम ले अर इस भवन म्ह तेरे तै गिड़गिड़ाकै प्रार्थना करैं, <verse eid="1KI 8:33" /><verse number="34" style="v" sid="1KI 8:34" />फेर तू सुर्ग म्ह तै सुणकै अपणी प्रजा इस्राएल का पाप माफ करिये: अर उननै इस देश म्ह बोहड़ा ले आईये, जो तन्‍नै उनके पुरखां तै दिया था।”<verse eid="1KI 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 8:35" />“जिब वे तेरै खिलाफ पाप करैं, अर इस कारण अकास बन्द हो जावै<note caller="+" style="f"><char style="fr" closed="false">8:35 </char><char style="fq" closed="false">बन्द हो जावै </char><char style="ft" closed="false">दोबारा मिह न्ही आवैगा</char></note>, के बारिस ना होवै, इसे बखत म्ह जै वे इस जगहां की और प्रार्थना करकै तेरे नाम नै मान्‍नै जिब तू उननै दुख देवै सै, अर अपणे पाप तै फिरैं, तो तू सुर्ग म्ह तै सुणकै माफ करिये, <verse eid="1KI 8:35" /><verse number="36" style="v" sid="1KI 8:36" />अर अपणे दास्सां, अपणी प्रजा इस्राएल के पाप नै माफ करिये; तू जो उननै वो भला राह दिखावै सै, जिसपै उननै चालणा चाहिये, ज्यांतै अपणे इस देश पै, जो तन्‍नै अपणी प्रजा का भाग कर दिया सै, पाणी बरसा दिये।”<verse eid="1KI 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 8:37" />“जिब इस देश म्ह काळ या मरी या झुलस हो या गेरूई या टिड्डियाँ या कीड़े लाग्गै या उनके दुश्मन उनके देश के फाटकां म्ह उननै घेरे राक्खैं, यानिके कोए विपत्ति या रोग क्यूँ ना हों, <verse eid="1KI 8:37" /><verse number="38" style="v" sid="1KI 8:38" />फेर जै कोए माणस या तेरी प्रजा इस्राएल अपणे-अपणे मन का दुख जाण लें, अर गिड़गिड़ाहट कै गैल प्रार्थना करकै अपणे हाथ इस भवन की और फैलावै; <verse eid="1KI 8:38" /><verse number="39" style="v" sid="1KI 8:39" />तो तू अपणे सुर्गीय निवास-स्थान म्ह तै सुणकै माफ करिये, अर इसा करिये, के एक-एक के मन नै जाणकै उसकी सारी चाल कै मुताबिक उननै फळ दिये: तू ए तो सारे माणसां के मन के भेदां नै जाणण आळा सै। <verse eid="1KI 8:39" /><verse number="40" style="v" sid="1KI 8:40" />फेर वे जितने दिन इस देश म्ह रहवैं, जो तन्‍नै उनके पुरखां तै दिया था, उतने दिन ताहीं तेरा भय मान्दे रहवैं।”<verse eid="1KI 8:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 8:41" />“फेर परदेशी भी जो तेरी प्रजा इस्राएल का ना हो, जिब वो तेरा नाम सुणकै, दूर देश तै आवैं, <verse eid="1KI 8:41" /><verse number="42" style="v" sid="1KI 8:42" />वो तो तेरे बड़े नाम अर बलवन्त हाथ अर बड़ाई होई भुजा की खबर पावैं; ज्यांतै जिब इसा कोए आकै इस भवन की और प्रार्थना करैं, <verse eid="1KI 8:42" /><verse number="43" style="v" sid="1KI 8:43" />फेर तू अपणे सुर्गीय निवास-स्थान म्ह तै सुण, अर जिस बात कै खात्तर इसा परदेशी तन्‍नै पुकारै, उस्से कै मुताबिक बरताव करिये जिसतै धरती के सारे देशां के माणस तेरा नाम जाणकै तेरी प्रजा इस्राएल कै बराबर तेरा भय मान्‍नै, अर जरुर जाणै, के यो भवन जिस ताहीं मन्‍नै बणाया सै, वो तेराए कुहवावै सै।”<verse eid="1KI 8:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 8:44" />“जिब तेरी प्रजा के माणस जित्त किते तू उननै भेज्जै, ओड़ै अपणे बैरियाँ तै लड़ाई करण नै लिकड़ जावैं, अर इस नगर की और जिस ताहीं तन्‍नै चुण्या सै, अर इस भवन की और जिस ताहीं मन्‍नै तेरे नाम पै बणाया सै, यहोवा तै प्रार्थना करैं, <verse eid="1KI 8:44" /><verse number="45" style="v" sid="1KI 8:45" />फेर तू सुर्ग म्ह तै उनकी प्रार्थना अर गिड़गिड़ाहट सुणकै उनका न्याय करिये।”<verse eid="1KI 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 8:46" />“इसा तो कोए माणस कोनी जिसनै कदे कोए पाप न्ही करया हो: जै ये भी तेरै खिलाफ पाप करैं, अर तू उनपै छो करकै उननै दुश्मनां कै हाथ म्ह कर दे, अर वे उननै बन्दी बणाकै अपणे देश म्ह चाहे वो दूर हो, चाहे धोरै, ले जावैं, <verse eid="1KI 8:46" /><verse number="47" style="v" sid="1KI 8:47" />अर जै वे गुलाम्मी के देश म्ह सोच विचार करैं, अर मुड़कै अपणे बन्दी बणाण आळयां के देश म्ह तन्‍नै गिड़गिड़ाकै कहवै, ‘हमनै पाप करया, अर कुटिलता अर दुष्टता करी सै;’ <verse eid="1KI 8:47" /><verse number="48" style="v" sid="1KI 8:48" />अर जै वे अपणे उन दुश्मनां के देश म्ह जो उननै बन्दी करकै लेगे हों, अपणे पूरे मन अर पूरे प्राण तै तेरी और मुड़ै अर अपणे इस देश की और जो तन्‍नै उनके पुरखां तै दिया था, अर इस नगर की और जिस ताहीं तन्‍नै चुण्या सै, अर इस भवन की और जिस ताहीं मन्‍नै तेरे नाम का बणाया सै, तेरै आग्गै प्रार्थना करैं, <verse eid="1KI 8:48" /><verse number="49" style="v" sid="1KI 8:49" />तो तू अपणे सुर्गीय निवास-स्थान म्ह तै उनकी प्रार्थना अर गिड़गिड़ाहट सुणिये; अर उनका न्याय करिये, <verse eid="1KI 8:49" /><verse number="50" style="v" sid="1KI 8:50" />अर जो पाप तेरी प्रजा के माणस तेरै खिलाफ करैंगे, अर जितने अपराध वे तेरै खिलाफ करैंगे, सारया नै माफ करकै, उनके बन्दी करण आळयां कै मन म्ह इसी दया पैदा करिये के वे उनपै दया करैं। <verse eid="1KI 8:50" /><verse number="51" style="v" sid="1KI 8:51" />क्यूँके वे तो तेरी प्रजा अर तेरा निज हिस्सा सैं जिननै तू लोहे के भट्ठे कै बिचाळै तै यानिके मिस्र तै लिकाड़ ल्याया सै। <verse eid="1KI 8:51" /><verse number="52" style="v" sid="1KI 8:52" />ज्यांतै तेरी आँख तेरे दास की गिड़गिड़ाहट अर तेरी प्रजा इस्राएल की गिड़गिड़ाहट की ओर इसी खुली रहवैं, के जिब-जिब वे तन्नै पुकारै, जद-जद तू उनकी सुण लेवै; <verse eid="1KI 8:52" /><verse number="53" style="v" sid="1KI 8:53" />क्यूँके हे प्रभु यहोवा अपणे उस वचन कै मुताबिक, जो तन्नै म्हारे पुरखां ताहीं मिस्र तै लिकाड़ण कै बखत अपणे दास मूसा के जरिये दिया था, तन्नै इन माणसां ताहीं अपणा निज हिस्सा होण कै खात्तर धरती की सारी जात्तां तै न्यारा करया सै।” <verse eid="1KI 8:53" /><verse number="54" style="v" sid="1KI 8:54" />जिब सुलैमान यहोवा तै ये सारी प्रार्थना गिड़गिड़ाहट कै गैल कर चुक्या, फेर वो जो घुटने टेक्‍के अर अकास की और हाथ फैलाए होए था, यहोवा की वेदी कै स्याम्ही तै उठ्या, <verse eid="1KI 8:54" /><verse number="55" style="v" sid="1KI 8:55" />अर खड्या हो, सारे इस्राएली सभा ताहीं ऊँच्‍चे स्वर तै न्यू कहकै आशीर्वाद दिया, <verse eid="1KI 8:55" /><verse number="56" style="v" sid="1KI 8:56" />“धन्य सै यहोवा, जिसनै ठीक अपणे कहे कै मुताबिक अपणी प्रजा इस्राएल ताहीं आराम दिया सै, जितनी भलाई की बात उसनै अपणे दास मूसा के जरिये कही थी, उन म्ह तै एक भी बिना पूरी होए न्ही रही। <verse eid="1KI 8:56" /><verse number="57" style="v" sid="1KI 8:57" />म्हारा परमेसवर यहोवा जिस तरियां म्हारे पुरखां कै गैल रहवै था, उसे तरियां म्हारे गैल भी रहवै, वो हमनै त्याग ना देवै अर ना हमनै छोड़ दे। <verse eid="1KI 8:57" /><verse number="58" style="v" sid="1KI 8:58" />वो म्हारे मन अपणी और इसा फिराए राक्खै, के हम उसकी सारी राह पै चाल्या करां, अर उसके हुकम अर विधि अर नियम जिनतै उसनै म्हारे पुरखां तै दिए थे, रोज मान्या करां। <verse eid="1KI 8:58" /><verse number="59" style="v" sid="1KI 8:59" />अर मेरी ये बात जिनकी मन्‍नै यहोवा कै स्याम्ही बिनती करी सै, वो दिन अर रात म्हारे परमेसवर यहोवा के मन म्ह बणी रहवैं, अर जिसी रोज जरूरत हो उस्से तरियां वो अपणे दास का अर अपणी प्रजा इस्राएल का भी न्याय करया करै, <verse eid="1KI 8:59" /><verse number="60" style="v" sid="1KI 8:60" />अर इसतै धरती की सारी जात जाण लें, के यहोवा ए परमेसवर सै; और कोए दूसरा न्ही। <verse eid="1KI 8:60" /><verse number="61" style="v" sid="1KI 8:61" />तो थारा मन म्हारे परमेसवर यहोवा की और इसे पूरी तरियां तै लाग्या रहवैं, के आज की तरियां उसकी विधियाँ पै चाल्दे अर उसकै हुकम मान्दे रहो।” <verse eid="1KI 8:61" /><verse number="62" style="v" sid="1KI 8:62" />फेर राजा सारे इस्राएल समेत यहोवा कै धोरै मेलबलि चढ़ाण लाग्या। <verse eid="1KI 8:62" /><verse number="63" style="v" sid="1KI 8:63" />अर जो पशु सुलैमान नै मेलबलि म्ह यहोवा तै चढ़ाए, वे बाईस हजार बळध अर एक लाख बीस हजार भेड़ थी। इस तरियां राजा नै सारे इस्राएलियाँ समेत यहोवा के भवन की प्रतिष्ठा करी। <verse eid="1KI 8:63" /><verse number="64" style="v" sid="1KI 8:64" />उस दिन राजा नै यहोवा के भवन कै स्याम्ही आळे आँगण के बिचाळै भी एक स्थान पवित्र करया अर होमबलि, अर अन्‍नबलि अर मेलबलियां की चर्बी ओड़ै चढ़ाई; क्यूँके जो पीतळ की वेदी यहोवा कै स्याम्ही थी, वो उनकै खात्तर छोट्टी थी। <verse eid="1KI 8:64" /><verse number="65" style="v" sid="1KI 8:65" />आखर सुलैमान नै अर उसकै गैल सारे इस्राएल की एक बड़ी सभा नै जो हमात के प्रवेश-द्वार तै लेकै मिस्र के नाळे ताहीं के सारे देशां तै कठ्ठी होई थी, दो सप्ताह ताहीं यानिके चौदाह दिन तक म्हारे परमेसवर यहोवा कै स्याम्ही त्यौहार मनाया। <verse eid="1KI 8:65" /><verse number="66" style="v" sid="1KI 8:66" />फेर आठवें दिन उसनै प्रजा के माणसां ताहीं विदा करया। अर वे राजा ताहीं धन्य, धन्य, कहकै उस सारी भलाई के कारण जो यहोवा नै अपणे दास दाऊद अर अपणी प्रजा इस्राएल तै करी थी, आनन्दित अर मगन होकै अपणे-अपणे डेरे म्ह राजी खुशी चले गए।<verse eid="1KI 8:66" /></para>
  <chapter eid="1KI 8" />
  <chapter number="9" style="c" sid="1KI 9" />
  <para style="s">सुलैमान ताहीं यहोवा का दूसरा दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 9:1" />जिब सुलैमान यहोवा के भवन अर राजभवन नै बणा चुक्या, अर जो किमे उसनै करणा चाह्या था, उसनै वो कर लिया, <verse eid="1KI 9:1" /><verse number="2" style="v" sid="1KI 9:2" />फेर यहोवा नै जिस तरियां गिबोन म्ह उस ताहीं दर्शन दिया था, उस्से तरियां ए दुसरी बार भी उस ताहीं दर्शन दिया। <verse eid="1KI 9:2" /><verse number="3" style="v" sid="1KI 9:3" />अर यहोवा नै उसतै कह्या, “जो प्रार्थना गिड़गिड़ाहट कै गैल तन्‍नै मेरे तै करी सै, उस ताहीं मन्‍नै सुण्या सै, यो जो भवन तन्‍नै बणाया सै, उस म्ह मन्‍नै अपणा नाम सदा खात्तर राखकै उस ताहीं पवित्र करया सै; अर मेरी आँख अर मेरा मन सदा ओड़ै लाग्गे रहवैगें। <verse eid="1KI 9:3" /><verse number="4" style="v" sid="1KI 9:4" />अर जै तू अपणे पिता दाऊद की तरियां मन की खराई अर सिधाई तै अपणे-आपनै मेरै स्याम्ही जाणकै चालदा रहवै, अर मेरे सारे हुकमां कै मुताबिक करै, अर मेरी विधियाँ अर नियमां नै मानदा रहवै, तो मै तेरा राज्य इस्राएल कै उप्पर सदा खात्तर स्थिर करुँगा; <verse eid="1KI 9:4" /><verse number="5" style="v" sid="1KI 9:5" />जिसा मन्‍नै तेरे पिता दाऊद ताहीं वचन दिया था, ‘तेरे कुल म्ह इस्राएल की गद्दी पै विराजण आळे सदा बणे रहवैगें।’ <verse eid="1KI 9:5" /><verse number="6" style="v" sid="1KI 9:6" />पर जै थम या थारे वंश के माणस मेरै पाच्छै चालणा छोड़ दें; अर मेरे उन हुकमां अर विधियाँ ताहीं जो मन्‍नै थारे ताहीं दिए सैं, ना मान्‍ने, अर जाकै पराए देवत्यां की उपासना करो अर उननै दण्डवत करो, <verse eid="1KI 9:6" /><verse number="7" style="v" sid="1KI 9:7" />तो मै इस्राएल नै इस देश म्ह तै जो मन्‍नै उनतै दिया सै, काट गेरुगां अर इस भवन ताहीं जो मन्‍नै अपणे नाम कै खात्तर पवित्र करया सै, अपणी नजर तै उतार दियुँगा; अर सारे देशां के माणसां म्ह इस्राएल की उपमा दी जावैगी अर उसकी कहावत चाल्‍लैगी। <verse eid="1KI 9:7" /><verse number="8" style="v" sid="1KI 9:8" />अर यो भवन जो ऊँच्‍चे पै रहवैगा, तो जो कोए इसके धोरै होकै चाल्‍लैगा, वो हैरान होवैगा, अर ताड़ी बजावैगा अर वे एक दुसरे तै पूछैंगे, ‘यहोवा नै इस देश अर इस भवन कै गैल इसा क्यूँ करया सै;’<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">मत्ती 23:38</char></note> <verse eid="1KI 9:8" /><verse number="9" style="v" sid="1KI 9:9" />फेर माणस कहवैंगे, ‘उननै अपणे परमेसवर यहोवा ताहीं जो उनके पुरखां नै मिस्र देश म्ह तै लिकाड़ ल्याया था। उसनै छोड़कै पराए देवत्यां ताहीं पकड़ लिया, अर उन ताहीं दण्डवत करया अर उनकी उपासना करी इस करकै यहोवा नै या सारी विपत्ति उनपै गेर दी।’” <verse eid="1KI 9:9" /><verse number="10" style="v" sid="1KI 9:10" />सुलैमान नै तो यहोवा के भवन अर राजभवन दोनुआं के बणाण म्ह बीस साल लाग्गे।<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">मन्दर के बणाण खात्तर 20 साल (1 राजाओं 6.38) अपणा महल बणाण खात्तर 13 साल (1 राजाओं 7.1).</char></note> <verse eid="1KI 9:10" /><verse number="11" style="v" sid="1KI 9:11" />फेर सुलैमान नै सोर के राजा हीराम ताहीं जिसनै उसतै मन मान्‍ने देवदार अर सनोवर की लाकड़ी अर सोन्‍ना दिया था, गलील देश के बीस नगर दिए। <verse eid="1KI 9:11" /><verse number="12" style="v" sid="1KI 9:12" />जिब हीराम नै सोर तै जाकै उन नगरां ताहीं देख्या, जो सुलैमान नै उसतै दिए थे, फेर वे उस ताहीं आच्छे न्ही लाग्गे। <verse eid="1KI 9:12" /><verse number="13" style="v" sid="1KI 9:13" />फेर उसनै कह्या, “हे मेरे भाई, ये किसे नगर तन्‍नै मेरे ताहीं दिए सैं?” अर उसनै उनका नाम कबूल <note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="fq" closed="false">कबूल </char><char style="ft" closed="false">बेकार</char></note>देश धरया। अर योए नाम आज कै दिन ताहीं पड्या सै। <verse eid="1KI 9:13" /><verse number="14" style="v" sid="1KI 9:14" />फेर हीराम नै राजा कै धोरै एक सौ बीस किक्‍कार सोन्‍ना भेज्या<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">लगभग 4 टन सोन्‍ना</char></note> था। <verse eid="1KI 9:14" /><verse number="15" style="v" sid="1KI 9:15" />राजा सुलैमान नै माणसां ताहीं जो बेगारी पै राख्या, इसकी जरूरत या थी, के यहोवा का अर अपणा भवन बणावै, अर मिल्‍लो अर यरुशलेम की शहरपनाह अर हासोर, मगिद्दो अर गेजेर नगरां ताहीं दृढ़ करै। <verse eid="1KI 9:15" /><verse number="16" style="v" sid="1KI 9:16" />गेजेर पै तो मिस्र के राजा फिरौन नै चढ़ाई करकै उस ताहीं ले लिया था अर आग लगाकै फूँक दिया, अर उस नगर म्ह रहणआळे कनानियाँ ताहीं मार गेरया अर, उस ताहीं अपणी बेट्टी सुलैमान की राणी का निज हिस्सा करकै दिया था, <verse eid="1KI 9:16" /><verse number="17" style="v" sid="1KI 9:17" />आखर सुलैमान नै गेजेर अर नीच्‍चै आळे बेथोरोन नगर, <verse eid="1KI 9:17" /><verse number="18" style="v" sid="1KI 9:18" />बालात अर तामार ताहीं जो जंगळ म्ह सैं, दृढ़ करया, ये तो देश म्ह सैं। <verse eid="1KI 9:18" /><verse number="19" style="v" sid="1KI 9:19" />फेर सुलैमान के जितने भण्डार आळे नगर थे, अर उसके रथां अर सवारां के नगर, उन ताहीं बल्के जो किमे सुलैमान नै यरुशलेम, लबानोन अर अपणे राज्य के सारे देशां म्ह बणाणा चाह्या, उन सारया ताहीं उसनै दृढ़ करया। <verse eid="1KI 9:19" /><verse number="20" style="v" sid="1KI 9:20" />एमोरी, हित्ती, परिज्जी, हिब्बी अर यबूसी जो रहगे थे, जो इस्राएली न्ही थे, <verse eid="1KI 9:20" /><verse number="21" style="v" sid="1KI 9:21" />उनके वंश जो उनकै बाद देश म्ह रहगे, अर उननै इस्राएली सत्यानाश ना कर सके, उन ताहीं तो सुलैमान नै दास करकै बेगारी पै राख्या, अर आज ताहीं उनकी वाए दशा सै। <verse eid="1KI 9:21" /><verse number="22" style="v" sid="1KI 9:22" />पर इस्राएलियाँ म्ह तै सुलैमान नै किसे ताहीं दास न्ही बणाया; वे तो योद्धा अर उसके कर्मचारी, उसके हाकिम, उसके सरदार, अर उसके रथां, अर सवारां के प्रधान होए।<verse eid="1KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 9:23" />जो खास हाकिम सुलैमान के काम्मां कै उप्पर ठहरकै काम करण आळयां पै राज करैं थे, ये पाँच सौ पचास थे।<verse eid="1KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24" />जिब फिरौन की बेट्टी दाऊदपुर तै अपणे उस भवन ताहीं आगी, जो सुलैमान नै उसकै खात्तर बणाया था, फेर उसनै मिल्‍लो नगर<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="fq" closed="false">मिल्‍लो </char><char style="ft" closed="false">सहायक छात </char></note> ताहीं बणाया।<verse eid="1KI 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 9:25" />सुलैमान उस वेदी पै जो उसनै यहोवा कै खात्तर बणाई थी, हर साल तीन बार होमबलि अर मेलबलि चढ़ाया करै था अर साथ ए उस वेदी पै जो यहोवा कै धोरै थी, धूप जळाया करै था, इस तरियां उसनै उस भवन ताहीं त्यार कर दिया।<verse eid="1KI 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 9:26" />फेर राजा सुलैमान नै एस्योनगेबेर नगर म्ह जो एदोम देश म्ह लाल समुन्दर कै किनारे एलोत कै धोरै सै, जहाज बणाए। <verse eid="1KI 9:26" /><verse number="27" style="v" sid="1KI 9:27" />अर जहाजां म्ह हीराम नै अपणे अधिकार के मल्‍लाहां ताहीं, जो समुन्दर की जानकारी राक्खै थे, सुलैमान के सेवकां कै गैल भेज दिया। <verse eid="1KI 9:27" /><verse number="28" style="v" sid="1KI 9:28" />उननै ओपीर<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="fq" closed="false">ओपीर </char><char style="ft" closed="false">या जगहां सोन्‍ना खात्तर जाणी जावै थी (अय्यूब 28:16; भजन संहिता 45:9; यशायाह 13:12) </char></note> ताहीं जाकै ओड़ै तै च्यार सौ बीस किक्‍कार सोन्‍ना<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false">14 टन सोन्‍ने तै ज्यादा</char></note>, राजा सुलैमान ताहीं ल्याकै दिया।<verse eid="1KI 9:28" /></para>
  <chapter eid="1KI 9" />
  <chapter number="10" style="c" sid="1KI 10" />
  <para style="s">शेबा की राणी के जरिये सुलैमान की प्रशंसा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1" />एक दिन जिब शेबा की राणी नै यहोवा के नाम कै बारै म्ह सुलैमान की कीर्ति सुणी, तो वा मुश्किल-मुश्किल सवाल लेकै उसकी परीक्षा करण नै चाल पड़ी।<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">मत्ती 6:29</char></note> <verse eid="1KI 10:1" /><verse number="2" style="v" sid="1KI 10:2" />वा तो घणे भारी दल कै गैल, मसाल्यां, अर घणे सोन्‍ने, अर मणि तै लदे ऊँट गैल लिये होए यरुशलेम म्ह आई; अर सुलैमान कै धोरै पोहचकै अपणे मन के सारे सवालां कै बारै म्ह उसतै बात करण लाग्गी। <verse eid="1KI 10:2" /><verse number="3" style="v" sid="1KI 10:3" />सुलैमान नै उसके सारे सवालां का जवाब दिया, कोए बात राजा की बुद्धि तै इसी बाहर ना रह्यी के वो उस ताहीं ना बता सक्या। <verse eid="1KI 10:3" /><verse number="4" style="v" sid="1KI 10:4" />जिब शेबा की राणी नै सुलैमान की सारी बुद्धिमानी अर उसका बणाया होया भवन, <verse eid="1KI 10:4" /><verse number="5" style="v" sid="1KI 10:5" />अर उसकी मेज पै का भोजन देख्या, अर उसके कर्मचारी किस तरियां बैठैं, अर उसके सेवादार किस तरियां खड़े रहवैं, अर किसे-किसे कपड़े पैहरे रहवैं सैं, अर उसके पिलाण आळे किसे सैं, अर वो किसी चढ़ाई सै, जिसतै वो यहोवा के भवन म्ह जाया करै सै, यो सारा जिब उसनै देख्या, तो वा हैरान रहगी।<verse eid="1KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 10:6" />फेर शेबा की राणी नै सुलैमान राजा तै कह्या, “तेरे काम अर बुद्धिमानी की जो कीर्ति मन्‍नै अपणे देश म्ह सुणी थी वा सच्‍ची सै। <verse eid="1KI 10:6" /><verse number="7" style="v" sid="1KI 10:7" />पर जिब ताहीं मन्‍नै आप्पे आकै अपणी आँख्यां तै यो ना देख्या, जिब ताहीं मन्‍नै उन बात्तां पै बिश्वास न्ही करया, पर इसकै बारै म्ह आध्धा भी मेरे ताहीं न्ही बताया गया था; तेरी बुद्धिमानी अर कल्याण उस कीर्ति तै भी बढ़कै सै, जो मन्‍नै सुणी थी।<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">लूका 12:27</char></note> <verse eid="1KI 10:7" /><verse number="8" style="v" sid="1KI 10:8" />धन्य सैं तेरे जन! धन्य सैं तेरे ये सेवक! जो रोज तेरै स्याम्ही मौजूद रहकै तेरी बुद्धि की बात सुणै सैं। <verse eid="1KI 10:8" /><verse number="9" style="v" sid="1KI 10:9" />धन्य सै तेरा परमेसवर यहोवा जो तेरे तै इसा खुश होया के तेरे ताहीं इस्राएल की राजगद्दी पै विराजमान करया यहोवा इस्राएल तै सदा प्रेम राक्खै सै, इस कारण उसनै तेरे ताहीं न्याय अर धार्मिकता करण नै राजा बणा दिया सै।” <verse eid="1KI 10:9" /><verse number="10" style="v" sid="1KI 10:10" />उसनै राजा ताहीं एक सौ बीस किक्‍कार सोन्‍ना<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">4 टन सोन्‍ने तै ज्यादा</char></note>, भोत सा सुगन्ध-द्रव्य, अर मणि दिया; जितना सुगन्ध-द्रव्य शेबा की राणी नै राजा सुलैमान ताहीं दिया, उतणा फेर कदे न्ही आया।<verse eid="1KI 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 10:11" />फेर हीराम के जहाज भी जो ओपीर तै सोन्‍ना ल्यावैं थे, भोत सी चन्दन की लाकड़ी अर मणि<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="fq" closed="false">मणि </char><char style="ft" closed="false">बहुमूल्य हीरा </char></note> भी लाए। <verse eid="1KI 10:11" /><verse number="12" style="v" sid="1KI 10:12" />अर राजा नै चन्दन की लाकड़ी तै यहोवा के भवन अर राजभवन कै खात्तर खम्भ्यां अर गवैयां कै खात्तर वीणा अर सारंगी बणवाई; इसे चन्दन की लाकड़ी आज ताहीं फेर न्ही आई, अर ना दिखाई पड़ी सै।<verse eid="1KI 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13" />शेबा की राणी नै जो किमे चाह्या, वोए राजा सुलैमान नै उसकी इच्छा कै मुताबिक उस ताहीं दिया, फेर राजा सुलैमान नै उस ताहीं अपणी उदारता तै भोत किमे दिया, फेर वा अपणे माणसां समेत अपणे देश म्ह बोहड़गी। <verse eid="1KI 10:13" /><verse number="14" style="v" sid="1KI 10:14" />इब जो सोन्‍ना हर साल सुलैमान कै धोरै पोहच्या करै था, उसका तौल छः सौ छियासठ किक्‍कार<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="fq" closed="false">छः सौ छियासठ किक्‍कार </char><char style="ft" closed="false">बाईस हजार किलो</char></note> था। <verse eid="1KI 10:14" /><verse number="15" style="v" sid="1KI 10:15" />इसके अलावा सौदागरां तै, अर व्यापारियाँ के लेण-देण तै, अर अरब देशां के सारे राजयां, अर अपणे देश के राज्यपालां तै भी घणा किमे मिलै था। <verse eid="1KI 10:15" /><verse number="16" style="v" sid="1KI 10:16" />राजा सुलैमान नै सोन्‍ना गढ़वा कै दो सौ बड़ी-बड़ी ढाल बणवाई; एक-एक ढाल म्ह छः सौ<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="fq" closed="false">छः सौ </char><char style="ft" closed="false">सात किलो</char></note> शेकेल सोन्‍ना लाग्या। <verse eid="1KI 10:16" /><verse number="17" style="v" sid="1KI 10:17" />फेर उसनै सोन्‍ना गढ़वा कै तीन सौ छोट्टी ढाल भी बणवाई; एक-एक छोट्टी ढाल म्ह, तीन माने<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="fq" closed="false">तीन माने </char><char style="ft" closed="false">एक किलो सात सौ ग्राम</char></note> सोन्‍ना लाग्या; अर राजा नै उन ताहीं लबानोन का वन नाम के महल म्ह धर दिया। <verse eid="1KI 10:17" /><verse number="18" style="v" sid="1KI 10:18" />राजा नै हाथी दाँत का एक बड़ा सिंहासन भी बणवाया, अर उत्तम कुन्दन तै मढ़वाया। <verse eid="1KI 10:18" /><verse number="19" style="v" sid="1KI 10:19" />उस सिंहासन म्ह छः सीढ़ियाँ थी; अर सिंहासन का पिछला भाग गोळ आकार का था, अर बैठण की जगहां के दोन्‍नु और टेक लाग्गी थी, अर दोन्‍नु टेकां कै धोरै एक-एक शेर खड्या होया बण्या था। <verse eid="1KI 10:19" /><verse number="20" style="v" sid="1KI 10:20" />अर छह ए सीढ़ियाँ के दोन्‍नु और एक-एक शेर खड्या होया बण्या था, कुल बारहा शेर बणे थे। किसे राज्य म्ह इसा सिंहासन कदे न्ही बण्या;<verse eid="1KI 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 10:21" />राजा सुलैमान के पीण के सारे बरतन सोन्‍ने के बणे थे, अर लबानोन का वन नाम के महल के सारे बरतन भी शुद्ध सोन्‍ने के थे, चाँदी का कोए भी न्ही था। सुलैमान के दिनां म्ह उसका किमे मोल ना था। <verse eid="1KI 10:21" /><verse number="22" style="v" sid="1KI 10:22" />क्यूँके समुन्दर पै हीराम के जहाजां कै गैल राजा भी तर्शीश के जहाज राक्खै था, अर तीन-तीन साल पै तर्शीश के जहाज सोन्‍ना, चाँदी, हाथी दाँत, बन्दर अर मोर ले आवैं थे।<verse eid="1KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23" />इस तरियां राजा सुलैमान, धन अर बुद्धि म्ह पृथ्वी के सारे राजयां तै बढ़कै होग्या। <verse eid="1KI 10:23" /><verse number="24" style="v" sid="1KI 10:24" />अर सारे पृथ्वी के माणस उसकी बुद्धि की बात सुणण ताहीं जो परमेसवर नै उसके मन म्ह पैदा करी थी, सुलैमान का दर्शन पाणा चावैं थे। <verse eid="1KI 10:24" /><verse number="25" style="v" sid="1KI 10:25" />अर वे हर साल अपणी-अपणी भेंट, यानिके चाँदी अर सोन्‍ने के बरतन, कपड़ा, शस्त्र, सुगन्ध-द्रव्य, घोड़े, अर खच्‍चर ले आवैं थे।<verse eid="1KI 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 10:26" />सुलैमान नै रथ अर सवार कठ्ठे कर लिए, उसके चौदाह सौ रथ, अर बारहा हजार सवार होगे, अर उन ताहीं उसनै रथां के नगरां म्ह, अर यरुशलेम म्ह राजा कै धोरै ठहरा राख्या। <verse eid="1KI 10:26" /><verse number="27" style="v" sid="1KI 10:27" />अर राजा नै बहुतायत के कारण, यरुशलेम म्ह चाँदी तो पत्‍थर की तरियां बे-मोल बणा दी, अर देवदार ताहीं इसा जिसे नीच्‍चै के देश के गूलर। <verse eid="1KI 10:27" /><verse number="28" style="v" sid="1KI 10:28" />अर जो घोड़े सुलैमान राक्खै था, वे मिस्र तै आवैं थे, अर राजा के व्यापारी उननै झुण्ड-झुण्ड करकै ठहराए होए दाम पै लिया करैं थे। <verse eid="1KI 10:28" /><verse number="29" style="v" sid="1KI 10:29" />एक रथ तो छः सौ शेकेल<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="fq" closed="false">छः सौ शेकेल </char><char style="ft" closed="false">छ: सौ सिक्‍के</char></note> चाँदी म्ह, अर एक घोड़ा डेढ़ सौ शेकेल<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="fq" closed="false">शेकेल </char><char style="ft" closed="false">लगभग 7 किलोग्राम चाँदी</char></note> म्ह, मिस्र तै आवै था, अर इसे दाम पै वे हित्तियाँ अर अराम के सारे राजयां कै खात्तर भी व्यापारियाँ के जरिये आवैं थे।<verse eid="1KI 10:29" /></para>
  <chapter eid="1KI 10" />
  <chapter number="11" style="c" sid="1KI 11" />
  <para style="s">सुलैमान का हृदय परमेसवर की और तै हट जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1" />पर राजा सुलैमान फिरौन की बेट्टी, अर भोत सी गैर जात की बिरबानियाँ तै, जो मोआबी, अम्‍मोनी, एदोमी, सीदोनी, अर हित्ती थी, प्यार करण लाग्या। <verse eid="1KI 11:1" /><verse number="2" style="v" sid="1KI 11:2" />वे उन जात्तां की थी, जिनकै बारै म्ह यहोवा नै इस्राएलियाँ तै कह्या था, “थम उनकै बिचाळै म्ह ना जाईयो, अर ना वे थारे बीच म्ह आण पावैं, वे थारा मन अपणे देवत्यां की और जरुर मोड़ैगी;” उनकै प्यार म्ह सुलैमान डूब ग्या। <verse eid="1KI 11:2" /><verse number="3" style="v" sid="1KI 11:3" />उसकै सात सौ राणी, अर तीन सौ रखैल<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">रखैल </char><char style="ft" closed="false">या सारी जनान्‍नी युद्ध जीत लेण कै बाद गुलाम बणा के ल्याई गई थी अर अपणे माल्‍लिक कै गैल शारीरिक संबन्ध बणाण खात्तर वोए उनका घरआळा होवै था</char></note> होगी थी अर उसकी इन बिरबानियाँ नै उसका मन बहका दिया। <verse eid="1KI 11:3" /><verse number="4" style="v" sid="1KI 11:4" />आखर जिब सुलैमान बूढ़ा होया, तब उसकी बिरबानियाँ नै उसका मन पराए देवता की और बहका दिया, अर उसका मन अपणे पिता दाऊद की तरियां अपणे परमेसवर यहोवा पै पूरी तरियां तै लाग्या न्ही रह्या। <verse eid="1KI 11:4" /><verse number="5" style="v" sid="1KI 11:5" />सुलैमान तो सीदोनियां की अश्तोरेत<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="fq" closed="false">अश्तोरेत </char><char style="ft" closed="false">प्रेम अर युद्ध की देवी; कनानी बाल देवता की साझेदार जो की उर्वरता कर देवता सै </char></note> नाम की देवी, अर अम्मोनियाँ के मिल्कोम नाम के घृणित देवत्यां कै पाच्छै चाल्या। <verse eid="1KI 11:5" /><verse number="6" style="v" sid="1KI 11:6" />इस तरियां सुलैमान नै वो करया जो यहोवा की नजर म्ह बुरा सै, अर यहोवा कै पाच्छै अपणे पिता दाऊद की रीति पै पूरी तरियां तै न्ही चाल्या। <verse eid="1KI 11:6" /><verse number="7" style="v" sid="1KI 11:7" />उन दिनां म्ह सुलैमान नै यरुशलेम कै स्याम्ही के पहाड़ पै मोआबियाँ के कमोश नाम के घृणित देवता कै खात्तर अर अम्मोनियाँ के मोलेक नाम के घृणित देवता कै खात्तर एक-एक ऊँच्‍चा स्थान बणाया। <verse eid="1KI 11:7" /><verse number="8" style="v" sid="1KI 11:8" />अर अपणी सारी गैर जात की बिरबानियाँ कै खात्तर भी जो अपणे-अपणे देवत्यां ताहीं धूप जळावै अर बलिदान करैं थी, उसनै इसाए करया।<verse eid="1KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 11:9" />फेर यहोवा नै सुलैमान पै छो करया, क्यूँके उसका मन इस्राएल के परमेसवर यहोवा तै मुड़ ग्या था जिसनै दो बार उस ताहीं दर्शन दिया था। <verse eid="1KI 11:9" /><verse number="10" style="v" sid="1KI 11:10" />अर उसनै इसे बात कै बारै म्ह हुकम दिया था, के पराए देवत्यां कै पाच्छै ना होइये, फेर भी उसनै यहोवा का हुकम न्ही मान्या। <verse eid="1KI 11:10" /><verse number="11" style="v" sid="1KI 11:11" />ज्यांतै यहोवा नै सुलैमान तै कह्या, “तन्‍नै जो इसा काम करया सै, अर मेरा करया होया करार अर दी होई विधि तन्‍नै पूरी न्ही करी, इस कारण मै राज्य नै जरुर तेरे तै खोसकै तेरे एक कर्मचारी ताहीं दे दियुँगा। <verse eid="1KI 11:11" /><verse number="12" style="v" sid="1KI 11:12" />फेर भी तेरे पिता दाऊद के कारण तेरे दिनां म्ह तो इसा न्ही करुँगा; पर तेरा बेट्टा कै हाथ तै राज्य खोस ल्यूँगा। <verse eid="1KI 11:12" /><verse number="13" style="v" sid="1KI 11:13" />फेर भी मै पूरा राज्य तो न्ही खोस ल्यूँगा, पर अपणे दास दाऊद कै कारण, अर अपणे चुणे होए यरुशलेम कै कारण, मै तेरे बेट्टे कै हाथ म्ह एक गोत्र छोड़ दियुँगा।” <verse eid="1KI 11:13" /><verse number="14" style="v" sid="1KI 11:14" />फेर यहोवा नै एदोमी हदद<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="fq" closed="false">हदद </char><char style="ft" closed="false">सुलैमान की दक्षिणी सीमा का दुश्मन</char></note> ताहीं जो एदोमी राजवंश का था, सुलैमान का दुश्मन बणा दिया। <verse eid="1KI 11:14" /><verse number="15" style="v" sid="1KI 11:15" />क्यूँके जिब दाऊद एदोम म्ह था, अर योआब सेनापति मारे होया ताहीं माट्टी देण गया, <verse eid="1KI 11:15" /><verse number="16" style="v" sid="1KI 11:16" />(योआब तो सारे इस्राएल समेत ओड़ै छः महिन्‍ने रह्या, जिब ताहीं के उसनै एदोम के सारे माणसां का नाश न्ही कर दिया) <verse eid="1KI 11:16" /><verse number="17" style="v" sid="1KI 11:17" />फेर हदद जो छोट्टा छोरा था, अपणे पिता के कई एक एदोमी सेवकां कै गैल मिस्र नै जाण की मनसा तै भाज्या। <verse eid="1KI 11:17" /><verse number="18" style="v" sid="1KI 11:18" />अर वे मिद्यान तै होकै पारान म्ह आए, अर पारान नाम कै बियाबान म्ह तै कई माणसां ताहीं गैल लेकै मिस्र म्ह फिरौन राजा कै धोरै गए, अर फिरौन नै उसतै घर दिया, अर उसके खाणे की व्यवस्था का हुकम दिया अर किमे जमीन भी दी। <verse eid="1KI 11:18" /><verse number="19" style="v" sid="1KI 11:19" />अर हदद पै फिरौन की बड़े अनुग्रह की नजर होई, अर उसनै उसतै अपणी साळी यानिके तहपनेस राणी की भाण ब्याह दी। <verse eid="1KI 11:19" /><verse number="20" style="v" sid="1KI 11:20" />अर तहपनेस की भाण तै गनूबत पैदा होया अर इसका दूध तहपनेस नै फिरौन के भवन म्ह छुड़ाया; फेर गनूबत फिरौन के भवन म्ह उसे के बेट्टे कै गैल रहवै था। <verse eid="1KI 11:20" /><verse number="21" style="v" sid="1KI 11:21" />जिब हदद नै मिस्र म्ह रहन्दे यो सुण्या, के दाऊद अपणे पुरखां कै गैल जा मिल्या, अर योआब सेनापति भी मर ग्या सै, फेर उसनै फिरौन तै कह्या, “मन्‍नै हुकम दे के मै अपणे देश म्ह जाऊँ!” <verse eid="1KI 11:21" /><verse number="22" style="v" sid="1KI 11:22" />फिरौन नै उसतै कह्या, “क्यूँ? मेरै उरै तन्‍नै के कमी होई के तू अपणे देश म्ह जाणा चाहवै सै?” उसनै जवाब दिया, “किमे न्ही होई, फेर भी मन्‍नै जरुर जाण दे।”<verse eid="1KI 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23" />फेर परमेसवर नै उसका एक और दुश्मन बणा दिया, यानिके एल्यादा के बेट्टे रजोन ताहीं, वो तो अपणे स्वामी सोबा के राजा हदादेजेर कै धोरै तै भाज्या था; <verse eid="1KI 11:23" /><verse number="24" style="v" sid="1KI 11:24" />अर जिब दाऊद नै सोबा के माणसां ताहीं घात करया, फेर रजोन<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="fq" closed="false">रजोन </char><char style="ft" closed="false">सुलैमान की उत्तरी सीमा का दुश्मन</char></note> अपणे धोरै कई माणसां ताहीं कठ्ठे करकै, एक दल का प्रधान होग्या, अर वो दमिश्क<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="fq" closed="false">दमिश्क </char><char style="ft" closed="false">सीरिया की राजधानी</char></note> म्ह जाकै ओड़ै रहण अर राज करण लाग्या। <verse eid="1KI 11:24" /><verse number="25" style="v" sid="1KI 11:25" />उस नुकसान कै गैल-गैल जो हदद नै करया, रजोन भी, सुलैमान के जीवन भर इस्राएल का दुश्मन बण्या रह्या; अर वो इस्राएल तै नफरत करदा होया अराम पै राज करै था। <verse eid="1KI 11:25" /><verse number="26" style="v" sid="1KI 11:26" />फेर नबात का अर सरूआह नाम की एक बिधवा का बेट्टा यारोबाम नाम का एक एप्रैमी सरेदावासी जो सुलैमान का कर्मचारी था, उसनै भी राजा के खिलाफ सिर ठाया। <verse eid="1KI 11:26" /><verse number="27" style="v" sid="1KI 11:27" />उसका राजा के खिलाफ सिर ठाण का यो कारण होया, के सुलैमान मिल्‍लो नै बणा रह्या था अर अपणे पिता दाऊद के नगर की दरार बन्द कर रह्या था। <verse eid="1KI 11:27" /><verse number="28" style="v" sid="1KI 11:28" />यारोबाम बड़ा शूरवीर था, अर जिब सुलैमान नै उस जवान ताहीं देख्या, के यो मेहनती सै; फेर उसनै उस ताहीं यूसुफ के कुण्बे के सारे काम पै मुखिया ठहराया। <verse eid="1KI 11:28" /><verse number="29" style="v" sid="1KI 11:29" />उन ए दिनां म्ह यारोबाम यरुशलेम तै लिकड़कै जाण लाग रह्या था, के शीलोवासी अहिय्याह नबी, नई चाद्दर ओढ़े होए रास्ता म्ह उसतै मिल्या; अर सिर्फ वेए दोन्‍नु मैदान म्ह थे। <verse eid="1KI 11:29" /><verse number="30" style="v" sid="1KI 11:30" />फेर अहिय्याह नै अपणी उस नई चाद्दर ताहीं ले लिया, अर उसनै पाड़कै बारहा टुकड़े कर दिए। <verse eid="1KI 11:30" /><verse number="31" style="v" sid="1KI 11:31" />फेर उसनै यारोबाम तै कह्या, “दस टुकड़े ले ले; क्यूँके, इस्राएल का परमेसवर यहोवा न्यू कहवै सै, ‘सुण, मै राज्य नै सुलैमान कै हाथ तै खोसकै दस गोत्र तेरै हाथ म्ह कर दियुँगा। <verse eid="1KI 11:31" /><verse number="32" style="v" sid="1KI 11:32" />पर मेरे दास दाऊद के कारण अर यरुशलेम के कारण जो मन्‍नै इस्राएल के सारे गोत्रां म्ह तै चुण्या सै, उसका एक गोत्र बण्या रहवैगा। <verse eid="1KI 11:32" /><verse number="33" style="v" sid="1KI 11:33" />इसका कारण यो सै के उननै मेरे ताहीं त्याग कै सीदोनियां की देवी अश्तोरेत अर मोआबियाँ के देवता कमोश, अर अम्मोनियाँ के देवता मिल्कोम तै दण्डवत करया, अर मेरे राह पै न्ही चाल्‍ले : अर जो मेरी नजर म्ह ठीक सै, वो न्ही करया, अर मेरी विधियाँ अर नियमां ताहीं न्ही मान्या जिसा के उसके पिता दाऊद नै करया। <verse eid="1KI 11:33" /><verse number="34" style="v" sid="1KI 11:34" />फेर भी मै उसके हाथ तै पूरा राज न्ही ल्यूँगा, पर मेरे चुणे होये दास दाऊद जो मेरे हुकमां अर विधियाँ नै मानदा रह्या, उसके कारण मै उस नै जीवन भर प्रधान ठहराए राक्खूँगा। <verse eid="1KI 11:34" /><verse number="35" style="v" sid="1KI 11:35" />पर उसके बेट्टे के हाथ तै मै राज्य यानिके दस गोत्र लेकै तन्‍नै दे दियुँगा। <verse eid="1KI 11:35" /><verse number="36" style="v" sid="1KI 11:36" />अर उसके बेट्टे नै मै एक गोत्र दियुँगा, ज्यांतै के यरुशलेम यानिके उस नगर म्ह जिसतै अपणा नाम राक्खण ताहीं मन्‍नै चुण्या सै, मेरे दास दाऊद का दीवा मेरै स्याम्ही सदा बण्या रहवै। <verse eid="1KI 11:36" /><verse number="37" style="v" sid="1KI 11:37" />पर तन्‍नै मै ठहरा ल्यूँगा, अर तू अपणी इच्छा भर इस्राएल पै राज करैगा। <verse eid="1KI 11:37" /><verse number="38" style="v" sid="1KI 11:38" />अर जै तू मेरे दास दाऊद की तरियां मेरे सारे हुकम मान्‍नै, अर मेरे राह पै चाल्‍ले, अर जो काम मेरी नजर म्ह ठीक सै, वोए करै, अर मेरी विधि अर हुकम मानदा रहवै, तो मै तेरै गैल रहूँगा, अर जिस तरियां मन्‍नै दाऊद का घरान्‍नां बणाए राख्या सै, उसे तरियां तेरा भी घरान्‍नां बणाए राक्खूँगा, अर तेरे हाथ म्ह इस्राएल ताहीं दियुँगा। <verse eid="1KI 11:38" /><verse number="39" style="v" sid="1KI 11:39" />इस पाप कै कारण मै दाऊद के वंश नै दुख दियुँगा, फेर भी सदा ताहीं न्ही।’” <verse eid="1KI 11:39" /><verse number="40" style="v" sid="1KI 11:40" />ज्यांतै सुलैमान नै यारोबाम ताहीं मार गेरणा चाह्या, पर यारोबाम मिस्र के राजा शीशक कै धोरै भाज ग्या, अर सुलैमान के मरण तक ओड़ैए रह्या। <verse eid="1KI 11:40" /><verse number="41" style="v" sid="1KI 11:41" />सुलैमान की और सारी बात अर उसके सारे काम अर उसकी बुद्धिमानी का बखान, के सुलैमान के इतिहास की किताब म्ह न्ही लिख्या सै? <verse eid="1KI 11:41" /><verse number="42" style="v" sid="1KI 11:42" />सुलैमान नै यरुशलेम म्ह सारे इस्राएल पै राज करदे होए चाळीस साल बीत्ते। <verse eid="1KI 11:42" /><verse number="43" style="v" sid="1KI 11:43" />अर सुलैमान मरकै अपणे पुरखां कै गैल जा मिल्या, अर उस ताहीं उसके पिता दाऊद के नगर म्ह माट्टी दी गई, अर उसका बेट्टा रहबाम उसकी जगहां पै राजा होया।<verse eid="1KI 11:43" /></para>
  <chapter eid="1KI 11" />
  <chapter number="12" style="c" sid="1KI 12" />
  <para style="s">इस्राएल राज्य का दो भाग हो जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1" />रहबाम शेकेम म्ह गया, क्यूँके सारे इस्राएली उसनै राजा बणाण कै खात्तर ओड़ै गए थे। <verse eid="1KI 12:1" /><verse number="2" style="v" sid="1KI 12:2" />जिब नबात के बेट्टे यारोबाम नै यो सुण्या, (जो इब ताहीं मिस्र म्ह ए रहवै था, क्यूँके यारोबाम सुलैमान राजा के डर के मारे भाजकै मिस्र म्ह रहवै था। <verse eid="1KI 12:2" /><verse number="3" style="v" sid="1KI 12:3" />आखर उन माणसां नै उस ताहीं बुलावा भेज्या) फेर यारोबाम अर इस्राएल की सारी सभा रहबाम कै धोरै जाकै न्यू कहण लाग्गी, <verse eid="1KI 12:3" /><verse number="4" style="v" sid="1KI 12:4" />“तेरे पिता नै तो म्हारे पै भारी जूआ गेर राख्या था, तो इब तू अपणे पिता की कठोर सेवा नै, अर उस भारी जूए ताहीं, जो उसनै म्हारे पै गेर राख्या सै, किमे हळका कर; फेर हम तेरै अधीन रहवांगे।” <verse eid="1KI 12:4" /><verse number="5" style="v" sid="1KI 12:5" />उसनै कह्या, “इब्बे तो जाओ, अर तीन दिन कै बाद मेरै धोरै फेर आईयो।” फेर वे चले गए।<verse eid="1KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 12:6" />फेर राजा रहबाम नै उन बूढ़यां तै जो उसके पिता सुलैमान के जीवन भर उसकै स्याम्ही हाजिर रह्या करैं थे, सलाह ली, “इस प्रजा ताहीं किसा जवाब देणा ठीक सै, इस म्ह थम के सलाह देओ सो?” <verse eid="1KI 12:6" /><verse number="7" style="v" sid="1KI 12:7" />उननै उस ताहीं यो जवाब दिया, “जै तू इब्बे प्रजा के माणसां का दास बण कै उनके अधीन हो अर उनतै आच्छी-आच्छी बात कहवै, तो वे सदा तेरै अधीन बणे रहवैगें।” <verse eid="1KI 12:7" /><verse number="8" style="v" sid="1KI 12:8" />रहबाम नै उस सलाह ताहीं छोड़ दिया, जो बूढ़यां नै उसतै दी थी, अर उन जवानां तै सलाह ली, जो उसकै गैल बड़े होए थे, अर उसकै स्याम्ही हाजिर रह्या करैं थे। <verse eid="1KI 12:8" /><verse number="9" style="v" sid="1KI 12:9" />उनतै उसनै पूच्छया, “मै प्रजा के माणसां नै किसा जवाब दियुँ? इस म्ह थम के सलाह देओ सो? उननै तो मेरै तै कह्या सै, ‘जो जूआ तेरे पिता नै म्हारे पै गेर राख्या सै, उसनै तू हळका कर।’” <verse eid="1KI 12:9" /><verse number="10" style="v" sid="1KI 12:10" />जवानां नै जो उसकै गैल बड़े होए थे उस ताहीं यो जवाब दिया, “उन माणसां नै तेरे तै कह्या सै, ‘तेरे पिता नै म्हारा जूआ भारी करया था, पर तू उस ताहीं म्हारे खात्तर हळका कर;’ तू उनतै न्यू कहिये, ‘मेरी छोट्टी उंगळी मेरे पिता की कमर तै भी मोट्टी सै।<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">जै मेरे पिता सेर थे तो मै सवा सेर हूँ!</char></note> <verse eid="1KI 12:10" /><verse number="11" style="v" sid="1KI 12:11" />मेरे पिता नै थारे पै जो भारी जूआ धरया था, उसनै मै और भी भारी करुँगा; मेरा पिता तो थारै ताहीं कोड़यां तै ताड़ना देवै था, पर मै बिच्छुआं तै दियुँगा।’”<verse eid="1KI 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 12:12" />तीसरे दिन, जिसा राजा नै ठैहराया था, के तीसरे दिन मेरै धोरै फेर आईयो, उसे तरियां यारोबाम अर सारी प्रजा के लोग रहबाम कै धोरै हाजिर होए। <verse eid="1KI 12:12" /><verse number="13" style="v" sid="1KI 12:13" />फेर राजा नै प्रजा तै कड़ी बात करी, <verse eid="1KI 12:13" /><verse number="14" style="v" sid="1KI 12:14" />अर बुजुर्गां की दी होई सलाह छोड़कै, जवानां की सलाह कै मुताबिक उनतै कह्या, “मेरे पिता नै तो थारा जूआ भारी कर दिया, पर मै उसनै और भी भारी कर दियुँगा: मेरे पिता नै तो कोड़यां तै थारै ताहीं ताड़ना दी, पर मै थारै ताहीं बिच्छुआं तै ताड़ना दियुँगा।” <verse eid="1KI 12:14" /><verse number="15" style="v" sid="1KI 12:15" />इस तरियां राजा नै प्रजा की बात न्ही मान्‍नी, इसका कारण यो सै, के जो वचन यहोवा नै शीलोवासी अहिय्याह के जरिये नबात के बेट्टे यारोबाम तै कह्या था, उसनै पूरा करण कै खात्तर उसनै इसाए ठैहराया था।<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 11:29-39">1 राजा. 11:29-39</ref></char></char></note><verse eid="1KI 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 12:16" />जिब सारे इस्राएल नै देख्या के राजा म्हारी न्ही सुणदा, फेर वे बोल्‍ले,</para>
  <para style="q" vid="1KI 12:16">“दाऊद कै गैल म्हारा के अंश?</para>
  <para style="q" vid="1KI 12:16">म्हारा तो यिशै के बेट्टे म्ह कोए हिस्सा न्ही!</para>
  <para style="q" vid="1KI 12:16">हे इस्राएल अपणे-अपणे डेरयां म्ह चले जाओः</para>
  <para style="q" vid="1KI 12:16">इब हे दाऊद, अपणे ए घरान्‍ने की चिन्ता कर।” फेर इस्राएली अपणे तम्बूआं म्ह चले गए।<verse eid="1KI 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 12:17" />आखर इस्राएली अपणे-अपणे डेरे म्ह चले गए। सिर्फ जितने इस्राएली यहूदा के नगरां म्ह बसे होए थे उनपै रहबाम राज्य करदा रह्या। <verse eid="1KI 12:17" /><verse number="18" style="v" sid="1KI 12:18" />फेर राजा रहबाम नै अदोराम ताहीं जो सारे मजदूरां पै अधिकारी था, भेज दिया, अर सारे इस्राएलियाँ नै उस ताहीं पथराव करया, अर वो मर ग्या: फेर रहबाम फुर्ती तै अपणे रथ पै चढ़कै यरुशलेम म्ह भाज ग्या। <verse eid="1KI 12:18" /><verse number="19" style="v" sid="1KI 12:19" />इस तरियां इस्राएल दाऊद के घरान्‍ने तै मुड़ ग्या, अर आज ताहीं मुड़या होया सै। <verse eid="1KI 12:19" /><verse number="20" style="v" sid="1KI 12:20" />यो सुणकै कै यारोबाम बोहड़ आया सै, सारे इस्राएल नै उस ताहीं मण्डळी म्ह बुलावा भेज्या अर पूरे इस्राएल कै उप्पर राजा नियुक्त करया, अर यहूदा के गोत्र नै छोड़कै दाऊद के घरान्‍ने तै कोए मिल्या ना रह्या। <verse eid="1KI 12:20" /><verse number="21" style="v" sid="1KI 12:21" />जिब रहबाम यरुशलेम म्ह आया, फेर उसनै यहूदा के सारे घरान्‍ने ताहीं, अर बिन्‍यामीन के गोत्र ताहीं, जो मिलकै एक लाख अस्सी हजार आच्छे योद्धा थे, कठ्ठा करया, के वे इस्राएल के घरान्‍ने कै गैल लड़कै सुलैमान के बेट्टे रहबाम के वश म्ह फेर राज वापस कर दें। <verse eid="1KI 12:21" /><verse number="22" style="v" sid="1KI 12:22" />फेर परमेसवर का यो वचन परमेसवर के जन शमायाह कै धोरै पोहच्या, <verse eid="1KI 12:22" /><verse number="23" style="v" sid="1KI 12:23" />“यहूदा के राजा सुलैमान के बेट्टे रहबाम तै, अर यहूदा अर बिन्‍यामीन के सारे घराने तै, अर सारे माणसां तै कह, ‘यहोवा न्यू कहवै सै, <verse eid="1KI 12:23" /><verse number="24" style="v" sid="1KI 12:24" />के अपणे इस्राएली भाईयाँ पै चढ़ाई करकै युद्ध ना करो; थम अपणे-अपणे घर लौट जाओ, क्यूँके या बात मेरी ए और तै होई सै।’” यहोवा का यो वचन मानकै उननै उसकै मुताबिक बोहड़ जाण खात्तर अपणा-अपणा राह लिया।<verse eid="1KI 12:24" /></para>
  <para style="s">यारोबाम का मूर्तिपूजा कराणा</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25" />फेर यारोबाम एप्रैम के पहाड़ी देश के शेकेम नगर नै दृढ़ करकै उस म्ह रहण लाग्या; फेर ओड़ै तै लिकड़कै पनूएल कै नगर ताहीं भी दृढ़ करया। <verse eid="1KI 12:25" /><verse number="26" style="v" sid="1KI 12:26" />फेर यारोबाम सोच्‍चण लाग्या, “इब राज्य दाऊद के घरान्‍ने का हो ज्यागा। <verse eid="1KI 12:26" /><verse number="27" style="v" sid="1KI 12:27" />जै प्रजा के माणस यरुशलेम म्ह बलि करण नै जावैं, तो उनका मन अपणे स्वामी यहूदा के राजा रहबाम की और फिरैगा, अर वे मन्‍नै घात करकै यहूदा के राजा रहबाम के हो जावैंगे।” <verse eid="1KI 12:27" /><verse number="28" style="v" sid="1KI 12:28" />आखर राजा नै सलाह लेकै सोन्‍ने के दो बाछड़यां की मूर्ति बणाई अर माणसां तै कह्या, “यरुशलेम म्ह जाणा थारी शक्ति तै बाहर सै ज्यांतै हे इस्राएल अपणे देवत्यां ताहीं देक्खो, जो थारै ताहीं मिस्र देश म्ह तै लिकाड़ ल्याए सैं।” <verse eid="1KI 12:28" /><verse number="29" style="v" sid="1KI 12:29" />उसनै एक बाछड़े ताहीं बेतेल नगर<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="fq" closed="false">बेतेल </char><char style="ft" closed="false">दक्षिण म्ह शहर</char></note> म्ह, अर दुसरे ताहीं दान<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="fq" closed="false">दान </char><char style="ft" closed="false">उत्तर म्ह शहर</char></note> म्ह स्थापित करया। <verse eid="1KI 12:29" /><verse number="30" style="v" sid="1KI 12:30" />अर या बात पाप का कारण होई; क्यूँके माणस उन म्ह तै एक कै स्याम्ही दण्डवत करण खात्तर दान तक जाण लाग्गे। <verse eid="1KI 12:30" /><verse number="31" style="v" sid="1KI 12:31" />अर उसनै ऊँच्‍चे स्थानां के भवन बणाए, अर सारे ढाळ के माणसां म्ह तै जो लेवीवंशी ना थे, याजक ठहराए। <verse eid="1KI 12:31" /><verse number="32" style="v" sid="1KI 12:32" />फेर यारोबाम नै आठवें महिन्‍ने के पन्द्रहवें दिन यहूदा के त्यौहार की तरियां एक त्यौहार ठहरा दिया, अर वेदी पै बलि चढ़ाण लाग्या; इस तरियां उसनै बेतेल म्ह अपणे बणाए होए बाछड़यां कै खात्तर वेदी पै, बलि करया, अर अपणे बणाए होए ऊँच्‍चे स्थानां के याजकां ताहीं बेतेल म्ह ठहरा दिया। <verse eid="1KI 12:32" /><verse number="33" style="v" sid="1KI 12:33" />जिस महिन्‍ने की उसनै अपणे मन म्ह कल्पना करी थी यानिके आठवें महिन्‍ने के पन्द्रहवें दिन नै वो बेतेल म्ह अपणी बणाई होई वेदी कै धोरै चढ़ ग्या। उसनै इस्राएलियाँ कै खात्तर एक त्यौहार ठहरा दिया, अर धूप जळाण ताहीं वेदी कै धोरै चढ़ ग्या।<verse eid="1KI 12:33" /></para>
  <chapter eid="1KI 12" />
  <chapter number="13" style="c" sid="1KI 13" />
  <para style="s">परमेसवर के दास का सन्देस</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 13:1" />फेर एक दिन यहोवा तै वचन पाकै परमेसवर का एक जन यहूदा तै बेतेल म्ह आया, अर यारोबाम धूप जळाण कै खात्तर वेदी कै धोरै खड्या था। <verse eid="1KI 13:1" /><verse number="2" style="v" sid="1KI 13:2" />उस जन नै यहोवा तै वचन पाकै वेदी कै खिलाफ यो पुकारया, “वेदी, हे वेदी! यहोवा न्यू कहवै सै, के सुण, दाऊद के कुल म्ह योशिय्याह<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">या भविष्यवाणी 2 राजाओं 23:15-16 म्ह पाया जावै सै</char></note> नाम का एक छोरा पैदा होवैगा, वो उन ऊँच्‍चे स्थानां के याजकां नै जो तेरे पै धूप जळावैं सैं, तेरे पै बलि कर देगा; अर तेरे पै माणसां की हाड्डी जळाई जावैंगी।” <verse eid="1KI 13:2" /><verse number="3" style="v" sid="1KI 13:3" />अर उसनै, उसे दिन यो कहकै उस बात का एक निशान भी बताया, “यो वचन जो यहोवा नै कह्या सै, इसका निशान यो सै के या वेदी पाट ज्यागी, अर इसपै की राख गिर ज्यागी।” <verse eid="1KI 13:3" /><verse number="4" style="v" sid="1KI 13:4" />फेर इसा होया के परमेसवर के जन का यो वचन सुणकै जो उसनै बेतेल की वेदी कै खिलाफ पुकारकै कह्या, यारोबाम नै वेदी कै धोरै तै हाथ बढ़ाकै कह्या, “उसनै पकड़ ल्यो!” फेर उसका हाथ जो उसकी और बढ़ाया गया था, सूख ग्या अर वो उसनै अपणी और खींच न्ही सक्या। <verse eid="1KI 13:4" /><verse number="5" style="v" sid="1KI 13:5" />अर वेदी पाटगी, अर उसपै की राख गिरगी; आखर वो चिन्ह पूरा होया, जो परमेसवर के जन नै यहोवा तै वचन पाकै कह्या था। <verse eid="1KI 13:5" /><verse number="6" style="v" sid="1KI 13:6" />फेर राजा नै परमेसवर के जन तै कह्या, “अपणे परमेसवर यहोवा नै मना अर मेरै खात्तर प्रार्थना कर, के मेरा हाथ ज्यों का त्यों हो जावै!” फेर परमेसवर के जन नै यहोवा ताहीं मनाया अर राजा का हाथ फेर ज्यों का त्यों होग्या। <verse eid="1KI 13:6" /><verse number="7" style="v" sid="1KI 13:7" />फेर राजा नै परमेसवर के जन तै कह्या, “मेरै गैल घर चालकै अपणा जी ठण्डा कर, अर मै तन्‍नै दान भी दियुँगा।” <verse eid="1KI 13:7" /><verse number="8" style="v" sid="1KI 13:8" />परमेसवर के जन नै राजा तै कह्या, “चाए तू मन्‍नै अपणा आध्धा राज पाठ भी दे, फेर भी मै तेरै घर न्ही चाल्‍लूँगा अर इस जगहां म्ह मै ना तो रोट्टी खाऊँगा अर ना पाणी पिऊँगा। <verse eid="1KI 13:8" /><verse number="9" style="v" sid="1KI 13:9" />क्यूँके यहोवा के वचन के जरिये मन्‍नै यो हुकम मिल्या सै, के ना तो रोट्टी खाइये, अर ना पाणी पिये, अर ना उस राह तै बोहडिये जिसतै तू जावैगा।” <verse eid="1KI 13:9" /><verse number="10" style="v" sid="1KI 13:10" />ज्यांतै परमेसवर का जन उस राह तै जिसतै बेतेल नै गया था ना लौट कै, दुसरे राह तै चल्या गया। <verse eid="1KI 13:10" /><verse number="11" style="v" sid="1KI 13:11" />बेतेल म्ह एक बूढ़ा नबी रहवै था, अर उसकै एक बेट्टे नै आकै उसतै उन सारे काम्मां का जिक्र करया जो परमेसवर के जन नै उस दिन बेतेल म्ह करे थे; अर जो बात उसनै राजा तै कही थी, उन ताहीं भी उसनै अपणे पिता तै कह सुणाया। <verse eid="1KI 13:11" /><verse number="12" style="v" sid="1KI 13:12" />उसके बेट्यां नै तो यो देख्या था, के परमेसवर का वो जन जो यहूदा तै आया था, किस राह तै चल्या गया, आखर उनके पिता नै उनतै पूच्छया, “वो किस रास्ता तै चल्या गया?” <verse eid="1KI 13:12" /><verse number="13" style="v" sid="1KI 13:13" />अर उसनै अपणे बेट्यां तै कह्या, “मेरे सफर खात्तर गधे पै काठ्ठी बान्धो;” फेर उननै गधे पै काठ्ठी बाँध्धी, अर वो उसपै चढ़या, <verse eid="1KI 13:13" /><verse number="14" style="v" sid="1KI 13:14" />अर परमेसवर के जन कै पाच्छै जाकै उस ताहीं एक बांज दरखत कै तळै बैठ्या होया पाया; अर उसतै पूच्छया, “परमेसवर का जो जन यहूदा तै आया था, के वो तू ए सै?” उसनै कह्या, “हाँ, वोए सूं।” <verse eid="1KI 13:14" /><verse number="15" style="v" sid="1KI 13:15" />उसनै उसतै कह्या, “मेरै गैल घर चालकै खाणा खा।” <verse eid="1KI 13:15" /><verse number="16" style="v" sid="1KI 13:16" />उसनै उसतै कह्या, “मै ना तो तेरै गैल लौट सकदा, अर ना तेरै गैल घर म्ह जा सकूँ सूं अर ना मै इस जगहां म्ह तेरै गैल रोट्टी खाऊँगा, ना पाणी पिऊँगा। <verse eid="1KI 13:16" /><verse number="17" style="v" sid="1KI 13:17" />क्यूँके यहोवा के वचन के जरिये मन्‍नै यो हुकम मिल्या सै, के ओड़ै ना तो रोट्टी खाइये अर ना पाणी पिये, अर जिस राह तै तू जावैगा उसतै ना बोहडिये।” <verse eid="1KI 13:17" /><verse number="18" style="v" sid="1KI 13:18" />उसनै कह्या, “जिसा तू नबी सै उसाए मै भी नबी सूं; अर मेरे ताहीं एक दूत नै यहोवा तै वचन पाकै कह्या, के उस माणस नै अपणे गैल अपणे घर बोहड़ा ल्या, के वो रोट्टी खावै, अर पाणी पीवै।” यो उसनै उसतै झूठ कह्या। <verse eid="1KI 13:18" /><verse number="19" style="v" sid="1KI 13:19" />अर वो उसकै गैल बोहड़ ग्या अर उसके घर म्ह रोट्टी खाई अर पाणी पिया।<verse eid="1KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 13:20" />जिब वे मेज पै बैठ्ठे ए थे, के यहोवा का वचन उस नबी कै धोरै पोहच्या, जो दुसरे ताहीं बोहड़ा ले आया था। <verse eid="1KI 13:20" /><verse number="21" style="v" sid="1KI 13:21" />उसनै परमेसवर के उस जन ताहीं जो यहूदा तै आया था, पुकारकै कह्या, “यहोवा न्यू कहवै सै ज्यांतै के तन्‍नै यहोवा का वचन न्ही मान्या, अर जो हुकम तेरे परमेसवर यहोवा नै तेरे तै दिया था उस ताहीं भी न्ही मान्या; <verse eid="1KI 13:21" /><verse number="22" style="v" sid="1KI 13:22" />पर जिस जगहां कै बारै म्ह उसनै तेरे तै कह्या था, ‘उस म्ह ना तो रोट्टी खाइये अर ना पाणी पिये,’ उसे म्ह तन्‍नै लौट कै रोट्टी खाई, अर पाणी भी पिया सै इस कारण तन्‍नै अपणे पुरखां के कब्रिस्तान म्ह माट्टी न्ही दी जावैगी।” <verse eid="1KI 13:22" /><verse number="23" style="v" sid="1KI 13:23" />जिब वो खा-पी चुक्या, फेर उसनै परमेसवर के उस जन कै खात्तर जिसनै वो बोहड़ा ले आया था गधे पै काठ्ठी बन्धाई। <verse eid="1KI 13:23" /><verse number="24" style="v" sid="1KI 13:24" />जिब वो राह म्ह चल्या जाण लाग रह्या था, तो एक शेर उसनै मिल्या, अर उस ताहीं मार गेरया, अर उसकी लाश राह पै पड़ी रही, अर गधा उसकै धोरै खड्या रह्या अर शेर भी लोथ कै धोरै खड्या रह्या। <verse eid="1KI 13:24" /><verse number="25" style="v" sid="1KI 13:25" />जो माणस ओड़ै तै चाल्‍ले आवैं थे उननै या देखकै के राह म्ह एक लाश पड़ी सै, अर उसकै धोरै शेर खड्या सै, उस नगर म्ह जाकै जित्त वो बूढ़ा नबी रहवै था या समाचार सुणाया।<verse eid="1KI 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 13:26" />या सुणकै उस नबी नै जो उसनै रास्ता म्ह तै बोहड़ा ले आया था, कह्या, “परमेसवर का वो जन होवैगा, जिसनै यहोवा के वचन कै बिरुध्द करया था, इस कारण यहोवा नै उस ताहीं शेर के पंजे म्ह पड़ण दिया; अर यहोवा के उस वचन कै मुताबिक जो उसनै उसतै कह्या था, शेर नै उस ताहीं पाड़कै मार गेरया होवैगा।” <verse eid="1KI 13:26" /><verse number="27" style="v" sid="1KI 13:27" />फेर उसनै अपणे बेट्यां तै कह्या, “मेरै खात्तर गधे पै काठ्ठी बाँधो;” जिब उननै काठ्ठी बाँध्धी, <verse eid="1KI 13:27" /><verse number="28" style="v" sid="1KI 13:28" />फेर उसनै जाकै उस आदमी की लाश ताहीं रास्ता पै पड्या होया, अर गधे, अर शेर दोनुआं नै लाश कै धोरै खड़े होए पाया, अर यो भी के शेर नै ना तो लाश ताहीं खाया, अर ना गधे ताहीं पाड़या सै। <verse eid="1KI 13:28" /><verse number="29" style="v" sid="1KI 13:29" />फेर उस बूढ़े नबी नै परमेसवर के जन की लाश ताहीं ठाकै गधे पै लाद लिया, अर उसकै खात्तर छात्ती पीटण लाग्या, अर उसनै माट्टी देण ताहीं अपणे नगर म्ह बोहड़ा लेग्या। <verse eid="1KI 13:29" /><verse number="30" style="v" sid="1KI 13:30" />अर उसनै उसकी लाश ताहीं अपणे कब्रिस्तान म्ह धरया, अर माणस “हाय, मेरे भाई!” या कहकै छात्ती पीटण लाग्गे। <verse eid="1KI 13:30" /><verse number="31" style="v" sid="1KI 13:31" />फेर उसतै माट्टी देकै उसनै अपणे बेट्यां तै कह्या, “जिब मै मर जाऊँगा फेर मेरै ताहीं इसे कब्रिस्तान म्ह धरियो, जिस म्ह परमेसवर का यो जन धरया गया सै, अर मेरी हाड्डी उसे की हाड्डियाँ कै धोरै धर दियो। <verse eid="1KI 13:31" /><verse number="32" style="v" sid="1KI 13:32" />क्यूँके जो वचन उसनै यहोवा तै पाकै बेतेल की वेदी अर सामरिया के नगरां के सारे ऊँच्‍चे स्थानां के भवनां कै खिलाफ पुकारकै कह्या सै, वो जरुर पूरा होवैगा।”<verse eid="1KI 13:32" /></para>
  <para style="s">यारोबाम का आखरी बखत</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33" />इसकै बाद इस्राएल का राजा यारोबाम अपणी बुरी चाल तै ना फिरया। उसनै फेर सारे ढाळ के माणसां म्ह तै ऊँच्‍चे स्थानां के याजक बणाए, बल्के जो कोए चाहवै था, उसका संस्कार करकै, वो उसनै ऊँच्‍चे स्थानां का याजक होण नै ठहरा देवै था। <verse eid="1KI 13:33" /><verse number="34" style="v" sid="1KI 13:34" />या बात यारोबाम के घरान्‍ने का पाप ठैहरी, इस कारण उसका विनाश होया, अर वो धरती पै तै नाश करया गया।<verse eid="1KI 13:34" /></para>
  <chapter eid="1KI 13" />
  <chapter number="14" style="c" sid="1KI 14" />
  <para style="s">यारोबाम के घरान्‍ने का न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1" />कुछ साल्‍लां कै बाद राजा यारोबाम का बेट्टा अबिय्याह रोगी होया। <verse eid="1KI 14:1" /><verse number="2" style="v" sid="1KI 14:2" />फेर यारोबाम नै अपणी जनान्‍नी तै कह्या, “इसा भेष बणा के कोए तन्‍नै पिछाण ना सकै के या यारोबाम की जनान्‍नी सै, अर शीलो के शहर ताहीं चली जा, ओड़ै अहिय्याह नबी रहवै सै जिसनै मेरै तै कह्या था ‘तू इस प्रजा का राजा हो जावैगा।’ <verse eid="1KI 14:2" /><verse number="3" style="v" sid="1KI 14:3" />उसकै धोरै तू दस रोट्टी, अर टिकियाँ अर एक कुप्पी मधु लेकै जा, अर वो तन्‍नै बतावैगा के छोरे का के होवैगा।”<verse eid="1KI 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 14:4" />यारोबाम की जनान्‍नी नै उसाए करया, अर चालकै शीलो ताहीं पोहची अर अहिय्याह के घर पै आई: अहिय्याह ताहीं तो किमे सूझ ना पड़ै था, क्यूँके बुढ़ापे कै कारण उसकी आँख धुन्धळी पड़गी थी। <verse eid="1KI 14:4" /><verse number="5" style="v" sid="1KI 14:5" />अर यहोवा नै अहिय्याह तै कह्या, “सुण यारोबाम की जनान्‍नी तेरे ताहीं अपणे बेट्टे कै बारै म्ह जो रोगी सै किमे पूछण खात्तर आवै सै, तू उसतै ये-ये बात कहिये; वा तो आकै अपणे ताहीं दुसरी जनान्‍नी बतावैगी।”<verse eid="1KI 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 14:6" />जिब अहिय्याह नै द्वार म्ह आन्दे होए उसके पैरां की आहट सुणी फेर कह्या, “हे यारोबाम की जनान्‍नी! भित्तर आ; तू अपणे नै क्यूँ दुसरी जनान्‍नी बणावै सै? मन्‍नै तेरे खात्तर बुरा सन्देसा मिल्या सै। <verse eid="1KI 14:6" /><verse number="7" style="v" sid="1KI 14:7" />तू जाकै यारोबाम तै कह के इस्राएल का परमेसवर यहोवा तेरे तै न्यू कहवै सै, ‘मन्‍नै तो तेरे ताहीं प्रजा म्ह तै बढ़ाकै अपणी प्रजा इस्राएल पै प्रधान बणाया, <verse eid="1KI 14:7" /><verse number="8" style="v" sid="1KI 14:8" />अर दाऊद के घरान्‍ने तै राज खोसकै तेरे तै दिया, पर तू मेरे दास दाऊद की तरियां ना होया जो मेरे हुकम नै मानदा, अर अपणे पूरे मन तै मेरै पाच्छै-पाच्छै चालदा, अर केवल वोए करै था जो मेरी नजर म्ह ठीक सै। <verse eid="1KI 14:8" /><verse number="9" style="v" sid="1KI 14:9" />तन्‍नै उन सारया तै बढ़कै जो तेरे तै पैहले थे बुराई, करी सै, अर जाकै पराए देवता की उपासना करी अर मूर्ति ढाळकै बणाई, जिसनै मेरै ताहीं छो म्ह कर दिया अर मेरै ताहीं तो पीठ कै पाच्छै फेंक दिया सै। <verse eid="1KI 14:9" /><verse number="10" style="v" sid="1KI 14:10" />इस करकै मै यारोबाम के घराने पै विपत्ति गेरुगां, बल्के मै यारोबाम के कुल म्ह तै हर एक छोरे नै अर के कैदी, के स्वाधीन इस्राएल कै बिचाळै हर एक रहणआळे नै भी नाश कर दियुँगा: अर जिसा कोए गोबर नै जिब ताहीं उठान्दा रहवै सै जिब तक वो सारा उठा न्ही लिया जान्दा, उसे तरियां ए मै यारोबाम के घरान्‍ने की सफाई कर दियुँगा। <verse eid="1KI 14:10" /><verse number="11" style="v" sid="1KI 14:11" />यारोबाम के घरान्‍ने का जो कोए नगर म्ह मर जावै, उसनै कुत्ते खावैंगे; अर जो मैदान म्ह मरै, उसनै अकास के पंछी खा जावैंगे; क्यूँके यहोवा नै यो कह्या सै।’ <verse eid="1KI 14:11" /><verse number="12" style="v" sid="1KI 14:12" />ज्यांतै तू उठ अर अपणे घर जा, अर नगर कै भित्तर तेरे पाँव पड़दे ए वो बाळक मर ज्यागा। <verse eid="1KI 14:12" /><verse number="13" style="v" sid="1KI 14:13" />उसनै तो सारे इस्राएली छात्ती पीटकै माट्टी देवैंगे; यारोबाम के सन्तानां म्ह तै केवल उसे नै कब्र मिलैगी, क्यूँके यारोबाम के घरान्‍ने म्ह तै उस्से म्ह किमे पाया जावै सै जो यहोवा इस्राएल के प्रभु की नजर म्ह भला सै। <verse eid="1KI 14:13" /><verse number="14" style="v" sid="1KI 14:14" />फेर यहोवा इस्राएल कै खात्तर एक इसा राजा खड्या करैगा जो उसे दिन यारोबाम के घरान्‍ने नै नाश कर देगा, पर कद? यो इब्बे होवैगा। <verse eid="1KI 14:14" /><verse number="15" style="v" sid="1KI 14:15" />क्यूँके यहोवा इस्राएल नै इसा मारैगा, जिसा पाणी की धारा तै नरकट हिलाया जावै सै, अर वो उननै इस आच्छी धरती म्ह तै जो उसनै उनके पुरखां तै दी थी उखाड़ कै फरात नदी कै पार तित्तर-बितर करैगा; क्यूँके उननै अशेरा नाम की मूर्ति अपणे खात्तर बणाकै यहोवा तै छो दिलाया सै। <verse eid="1KI 14:15" /><verse number="16" style="v" sid="1KI 14:16" />अर उन पापां के कारण जो यारोबाम नै करे अर इस्राएल तै कराए थे, यहोवा इस्राएल नै त्याग देगा।”<verse eid="1KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17" />फेर यारोबाम की जनान्‍नी विदा होकै चली अर तिर्सा म्ह आई, अर वा भवन की देहळी पै जिब पोहची वो बाळक मर ग्या। <verse eid="1KI 14:17" /><verse number="18" style="v" sid="1KI 14:18" />फेर यहोवा के वचन कै मुताबिक जो उसनै अपणे दास अहिय्याह नबी तै कुह्वाया था, सारे इस्राएल नै उस ताहीं माट्टी देकै उसके खात्तर शोक मनाया। <verse eid="1KI 14:18" /><verse number="19" style="v" sid="1KI 14:19" />यारोबाम के और काम यानिके उसनै किसा-किसा युद्ध करया, अर किसा राज करया, यो सारा इस्राएल के राजयां के इतिहास की किताब म्ह लिख्या सै। <verse eid="1KI 14:19" /><verse number="20" style="v" sid="1KI 14:20" />यारोबाम बाईस साल ताहीं इस्राएल पै राज करकै मर ग्या अर अपणे पुरखां कै गैल जा मिल्या अर नादाब नाम का उसका बेट्टा उसकी जगहां पै राजा होया।<verse eid="1KI 14:20" /></para>
  <para style="s">रहबाम का राज्य</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21" />सुलैमान का बेट्टा रहबाम यहूदा म्ह राज करण लाग्या। रहबाम इकताळीस साल का होकै राज करण लाग्या; अर यरुशलेम जिस ताहीं यहोवा नै सारे इस्राएली गोत्रां म्ह तै अपणा नाम राक्खण कै खात्तर चुण लिया था, उस नगर म्ह वो सत्रह साल ताहीं राज करदा रह्या; अर उसकी माँ का नाम नामाह था जो अम्‍मोनी जनान्‍नी थी। <verse eid="1KI 14:21" /><verse number="22" style="v" sid="1KI 14:22" />अर यहूदी लोग वो करण लाग्गे जो यहोवा की नजर म्ह बुरा सै, अर अपणे पुरखां तै भी घणे पाप करकै उसकी जळण भड़काई। <verse eid="1KI 14:22" /><verse number="23" style="v" sid="1KI 14:23" />उननै तो सारे ऊँच्‍चे टील्यां पै, अर सारे हरे दरखतां कै तळै, ऊँच्‍ची जगहां, अर लाठां, अर अशेरा नाम की मूर्ति बणा ली। <verse eid="1KI 14:23" /><verse number="24" style="v" sid="1KI 14:24" />अर उनके देश म्ह पुरुषगामी भी थे; वे उन जातियाँ म्ह तै सारे घिनोणे काम करैं थे जिन ताहीं यहोवा नै इस्राएलियाँ कै स्याम्ही तै लिकाड़ दिया था।<verse eid="1KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25" />राजा रहबाम के पाँचवें साल म्ह मिस्र का राजा शीशक, यरुशलेम पै चढ़ाई करकै, <verse eid="1KI 14:25" /><verse number="26" style="v" sid="1KI 14:26" />यहोवा के भवन की अनमोल चीज अर राजभवन की अनमोल चिज्जें, सारी की सारी ठा लेग्या; अर सोन्‍ने की जितनी ढाल सुलैमान नै बणाई थी उन सारियां नै राजा शीशक लेग्या। <verse eid="1KI 14:26" /><verse number="27" style="v" sid="1KI 14:27" />ज्यांतै राजा रहबाम नै उनके बदलै पीतळ की ढाल बणवाई अर उननै रुखाळयां के प्रधानां कै हाथ सौंप दिया जो राजभवन के द्वार की रुखाळी करैं थे। <verse eid="1KI 14:27" /><verse number="28" style="v" sid="1KI 14:28" />अर जिब-जिब राजा यहोवा के भवन म्ह जावै था तब-तब रुखाळे उननै ठा ले चाल्दे, अर फेर अपणी कोठड़ी म्ह बोहड़कै धर देवैं थे।<verse eid="1KI 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 14:29" />रहबाम के और सारे काम जो उसनै करे वो के यहूदा के राजयां के इतिहास की किताब म्ह न्ही लिक्खे सैं? <verse eid="1KI 14:29" /><verse number="30" style="v" sid="1KI 14:30" />रहबाम अर यारोबाम म्ह तो सदा लड़ाई होन्दी रही। <verse eid="1KI 14:30" /><verse number="31" style="v" sid="1KI 14:31" />अर रहबाम जिसकी माँ नामाह नाम की एक अम्मोनिन थी, वो मरकै अपणे पुरखां कै गैल जा मिल्या; अर उन्हे कै धोरै दाऊदपुर म्ह उस ताहीं माट्टी दी गई: अर उसका बेट्टा अबिय्याम उसकी जगहां पै राज करण लाग्या।<verse eid="1KI 14:31" /></para>
  <chapter eid="1KI 14" />
  <chapter number="15" style="c" sid="1KI 15" />
  <para style="s">अबिय्याम का राज</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1" />नबात के बेट्टे यारोबाम के राज के अठारहवें साल म्ह अबिय्याम यहूदा पै राज करण लाग्या। <verse eid="1KI 15:1" /><verse number="2" style="v" sid="1KI 15:2" />अर वो तीन साल तक यरुशलेम म्ह राज करदा रह्या। उसकी माँ का नाम माका था जो अबशालोम की बेट्टी थी: <verse eid="1KI 15:2" /><verse number="3" style="v" sid="1KI 15:3" />वो उसे तरियां ए पापां की लीक पै चालदा रह्या जिस तरियां उसके पिता नै उसतै पैहला करे थे अर उसका मन अपणे परमेसवर यहोवा की और अपणे पड़दादा दाऊद की तरियां पूरी तरियां तै सिध्द ना था; <verse eid="1KI 15:3" /><verse number="4" style="v" sid="1KI 15:4" />फेर भी दाऊद कै कारण उसके परमेसवर यहोवा नै यरुशलेम म्ह उसतै एक दीपक दिया यानिके उसके बेट्टे ताहीं उसकै बाद ठैहराया अर यरुशलेम ताहीं बणाए राख्या। <verse eid="1KI 15:4" /><verse number="5" style="v" sid="1KI 15:5" />क्यूँके दाऊद वो करया करै था जो यहोवा की नजर म्ह ठीक था अर हित्ती ऊरिय्याह की बात कै अलावा और किसे बात म्ह यहोवा के किसे हुकम तै जीवन भर कदे भी ना मुड़या। <verse eid="1KI 15:5" /><verse number="6" style="v" sid="1KI 15:6" />रहबाम के जीवन भर उसकै अर यारोबाम कै बीच म्ह लड़ाई होन्दी रह्यी। <verse eid="1KI 15:6" /><verse number="7" style="v" sid="1KI 15:7" />अबिय्याम के और सारे काम जो उसनै करे, के वो यहूदा के राजयां के इतिहास की किताब म्ह न्ही लिक्खे सैं? अर अबिय्याम की यारोबाम कै गैल लड़ाई होन्दी रह्यी। <verse eid="1KI 15:7" /><verse number="8" style="v" sid="1KI 15:8" />अबिय्याम मरकै अपणे पुरखां कै गैल जा मिल्या, अर उस ताहीं दाऊदपुर म्ह माट्टी दी गई, अर उसका बेट्टा आसा उसकी जगहां पै राज करण लाग्या।<verse eid="1KI 15:8" /></para>
  <para style="s">आसा का राज</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9" />इस्राएल के राजा यारोबाम के राज्य के बीसवें साल म्ह आसा यहूदा पै राज करण लाग्या; <verse eid="1KI 15:9" /><verse number="10" style="v" sid="1KI 15:10" />अर यरुशलेम म्ह इकताळीस साल ताहीं राज करदा रह्या, अर उसकी माँ अबशालोम की बेट्टी माका थी। <verse eid="1KI 15:10" /><verse number="11" style="v" sid="1KI 15:11" />अर आसा नै अपणे मूलपुरुष दाऊद की तरियां वोए करया जो यहोवा की नजर म्ह ठीक था। <verse eid="1KI 15:11" /><verse number="12" style="v" sid="1KI 15:12" />उसनै तो पुरुषगामियां ताहीं देश म्ह तै लिकाड़ दिया, अर जितनी मूर्ति उसके पुरखां नै बणाई थी उन सारया ताहीं उसनै दूर कर दिया। <verse eid="1KI 15:12" /><verse number="13" style="v" sid="1KI 15:13" />बलके उसकी माँ माका जिसनै अशेरा कै खात्तर एक घिनोणी मूर्ति बणाई थी उस ताहीं उसनै राजमाता कै पद पै तै उतार दिया, अर आसा नै उसकी मूर्ति ताहीं काट गेरया अर किद्रोन के नाळे म्ह फूँक दिया। <verse eid="1KI 15:13" /><verse number="14" style="v" sid="1KI 15:14" />पर ऊँच्‍ची जगहां तो ढाई न्ही गई; फेर भी आसा का मन जीवन भर यहोवा की और पूरी तरियां तै लाग्या रह्या। <verse eid="1KI 15:14" /><verse number="15" style="v" sid="1KI 15:15" />अर जो सोन्‍ना-चाँदी अर बरतन उसके पिता नै अर्पण करे थे, अर जो उसनै खुद अर्पण करे थे, उन सारया ताहीं उसनै यहोवा के भवन म्ह पोंहचा दिया।<verse eid="1KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 15:16" />आसा अर इस्राएल के राजा बाशा कै बिचाळै उनके जीवन भर युद्ध होन्दा रह्या। <verse eid="1KI 15:16" /><verse number="17" style="v" sid="1KI 15:17" />इस्राएल के राजा बाशा नै यहूदा पै चढ़ाई करी, अर रामाह के नगर ताहीं ज्यांतै दृढ़ करया के कोए यहूदा के राजा आसा कै धोरै आण-जाण ना पावै। <verse eid="1KI 15:17" /><verse number="18" style="v" sid="1KI 15:18" />फेर आसा नै जितना सोन्‍ना-चाँदी यहोवा के भवन अर राजभवन के भण्डारां म्ह रहग्या था उस सारे ताहीं लिकाड़ अपणे कर्मचारियाँ कै हाथ सौंप कै, दमिश्कवासी अराम के राजा बेन्हदद कै धोरै जो हेज्योन का पोत्ता अर तब्रिम्मोन का बेट्टा था भेजकै यो कह्या, <verse eid="1KI 15:18" /><verse number="19" style="v" sid="1KI 15:19" />“जिसा मेरे अर तेरे पिता कै बीच म्ह उसाए मेरै अर तेरै बीच म्ह भी करार करया जावै: देख, मै तेरै धोरै चाँदी-सोन्‍ने की भेंट भेज्जू सूं, ज्यांतै आ, इस्राएल के राजा बाशा कै गैल करे अपणे उस करार नै टाळ दे, ताके वो मेरै धोरै तै चल्या जावै।” <verse eid="1KI 15:19" /><verse number="20" style="v" sid="1KI 15:20" />राजा आसा की या बात मानकै बेन्हदद नै अपणे दलां के प्रधानां तै इस्राएली नगरां पै चढ़ाई करवा कै इय्योन, दान, आबेल्वेत्माका अर सारे किन्‍नेरेत ताहीं अर नप्ताली के सारे देश ताहीं पूरा जीत लिया। <verse eid="1KI 15:20" /><verse number="21" style="v" sid="1KI 15:21" />यो सुणकै बाशा नै रामाह ताहीं दृढ़ करणा छोड़ दिया, अर तिर्सा म्ह रहण लाग्या। <verse eid="1KI 15:21" /><verse number="22" style="v" sid="1KI 15:22" />फेर राजा आसा नै सारे यहूदा म्ह प्रचार करवाया अर कोए अणसुण्या ना रह्या, फेर वे रामाह के पत्थरां अर लाकड़ी नै जिनतै बाशा उसनै दृढ़ करै था ठा लेगे, अर उनतै राजा आसा नै बिन्‍यामीन के गेबा अर मिस्पा ताहीं दृढ़ करया। <verse eid="1KI 15:22" /><verse number="23" style="v" sid="1KI 15:23" />आसा के और काम अर उसकी वीरता अर जो किमे उसनै करया, अर जो नगर उसनै मजबूत करे, यो सारा के यहूदा के राजयां कै इतिहास की किताब म्ह न्ही लिख्या सै? पर उसके बुढ़ापे म्ह तो उसकै पैरां का रोग लागग्या। <verse eid="1KI 15:23" /><verse number="24" style="v" sid="1KI 15:24" />आसा मरकै अपणे पुरखां कै गैल जा मिल्या, अर उसनै उसके मूलपुरुष दाऊद के नगर म्ह उन्हे कै धोरै माट्टी दी गई अर उसका बेट्टा यहोशापात उसकी जगहां पै राज करण लाग्या।<verse eid="1KI 15:24" /></para>
  <para style="s">नादाब का राज।</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25" />यहूदा के राजा आसा के राज के दुसरे साल म्ह यारोबाम का बेट्टा नादाब इस्राएल पै राज करण लाग्या; अर दो साल ताहीं राज करदा रह्या। <verse eid="1KI 15:25" /><verse number="26" style="v" sid="1KI 15:26" />उसनै वो काम करया जो यहोवा की नजर म्ह बुरा था अर अपणे पिता के राह पै वोए पाप करदा होया चालदा रह्या जो उसनै इस्राएल तै करवाया था।<verse eid="1KI 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 15:27" />नादाब सारे इस्राएल समेत पलिश्तियाँ के देश के गिब्बतोन नगर नै घेरे था। अर इस्साकार के गोत्र के अहिय्याह के बेट्टे बाशा नै उसकै खिलाफ राजद्रोह की साजिस करकै गिब्बतोन कै धोरै उस ताहीं मार गेरया। <verse eid="1KI 15:27" /><verse number="28" style="v" sid="1KI 15:28" />अर यहूदा के राजा आसा के राज्य के तीसरे साल म्ह बाशा नै नादाब ताहीं मार गेरया, अर उसकी जगहां पै राजा बणग्या। <verse eid="1KI 15:28" /><verse number="29" style="v" sid="1KI 15:29" />राजा बणदे बाशा नै यारोबाम के सारे घरान्‍ने ताहीं मार गेरया; उसनै यारोबाम के वंश ताहीं उरै तक नाश करया के एक भी जिन्दा ना रह्या। यो सारा यहोवा के उस वचन कै मुताबिक होया जो उसनै अपणे दास शीलोवासी अहिय्याह तै कुह्वाया था। <verse eid="1KI 15:29" /><verse number="30" style="v" sid="1KI 15:30" />यो इस कारण होया के यारोबाम नै खुद पाप करे, अर इस्राएल तै भी करवाऐ थे, अर उसनै इस्राएल के परमेसवर यहोवा ताहीं छो दुवाया था।<note caller="+" style="f"><char style="fr" closed="false">15:30 </char><char style="ft" closed="false">2 शमूएल 11:1-27</char></note><verse eid="1KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 15:31" />नादाब के और सारे काम जो उसनै करे, के वो इस्राएल के राजयां कै इतिहास की किताब म्ह न्ही लिक्खे सैं? <verse eid="1KI 15:31" /><verse number="32" style="v" sid="1KI 15:32" />आसा अर इस्राएल के राजा बाशा कै बीच म्ह तो उनके जीवन भर युद्ध होन्दा रह्या।<verse eid="1KI 15:32" /></para>
  <para style="s">बाशा का राज</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33" />यहूदा के राजा आसा के राज के तीसरे साल म्ह अहिय्याह का बेट्टा बाशा, तिर्सा म्ह सारे इस्राएल पै राज करण लाग्या, अर चौबीस साल ताहीं राज करदा रह्या। <verse eid="1KI 15:33" /><verse number="34" style="v" sid="1KI 15:34" />अर उसनै वो करया, जो यहोवा की नजर म्ह बुरा था, अर यारोबाम के राह पै वोए पाप करदा रह्या जो उसनै इस्राएल तै करवाया था।<verse eid="1KI 15:34" /></para>
  <chapter eid="1KI 15" />
  <chapter number="16" style="c" sid="1KI 16" />
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1" />फेर बाशा कै बारै म्ह यहोवा का यो वचन हनानी के बेट्टे येहू नबी कै धोरै पोहच्या, <verse eid="1KI 16:1" /><verse number="2" style="v" sid="1KI 16:2" />“मन्‍नै तेरे ताहीं माट्टी पै तै ठाकै अपणी प्रजा इस्राएल का प्रधान बणाया, पर तू यारोबाम की जिसी चाल चालदा अर मेरी प्रजा इस्राएल तै इस्से पाप करवान्दा आया सै जिनतै वे मन्‍नै छो दुवावैं सैं। <verse eid="1KI 16:2" /><verse number="3" style="v" sid="1KI 16:3" />इब सुण, मै बाशा अर उसके घरान्‍ने की पूरी तरियां तै सफाई कर दियुँगा अर तेरे घरान्‍ने नै नबात के बेट्टे यारोबाम की तरियां कर दियुँगा। <verse eid="1KI 16:3" /><verse number="4" style="v" sid="1KI 16:4" />बाशा के घर का जो कोए नगर म्ह मर जावै, उसनै कुत्ते खा लेगें, अर उसका जो कोए मैदान म्ह मर जावै, उस ताहीं अकास के पंछी खा लेगें।”<verse eid="1KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 16:5" />बाशा के और सारे काम जो उसनै करे, अर उसकी सारी वीरता यो इस्राएल के राजयां कै इतिहास की किताब म्ह लिक्खी सै। <verse eid="1KI 16:5" /><verse number="6" style="v" sid="1KI 16:6" />अन्त म्ह बाशा मरकै अपणे पुरखां कै गैल जा मिल्या अर तिर्सा शहर म्ह उसतै माट्टी दी गई, अर उसका बेट्टा एला उसकी जगहां पै राज करण लाग्या। <verse eid="1KI 16:6" /><verse number="7" style="v" sid="1KI 16:7" />यहोवा का जो वचन हनानी के बेट्टे येहू के जरिये बाशा अर उसके घरान्‍ने कै बिरुध्द आया, वो ना सिर्फ उन सारी बुराइयां कै कारण आया जो उसनै यारोबाम के घरान्‍ने की तरियां होकै यहोवा की नजर म्ह करी थी अर अपणे काम्मां तै भी उस ताहीं छो दुवाया, बल्के इस कारण भी आया, के उसनै उस ताहीं मार गेरया था।<verse eid="1KI 16:7" /></para>
  <para style="s">एला का राज</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8" />यहूदा के राजा आसा के राज्य के छब्बीसवें साल म्ह बाशा का बेट्टा एला तिर्सा म्ह इस्राएल पै राज करण लाग्या, अर दो साल ताहीं राज करदा रह्या। <verse eid="1KI 16:8" /><verse number="9" style="v" sid="1KI 16:9" />जिब वो तिर्सा म्ह अर्सा नाम के भण्डारी के घर म्ह जो उसके तिर्सा आळे भवन का प्रधान था, तो वो पी कै मतवाळा होग्या था, फेर उसके जिम्री नाम के एक कर्मचारी नै जो उसके आध्धे रथां का प्रधान था, <verse eid="1KI 16:9" /><verse number="10" style="v" sid="1KI 16:10" />राजद्रोह की साजिस करी अर भित्तर जाकै उस ताहीं मार गेरया, अर उसकी जगहां पै राजा बणग्या। यो यहूदा के राजा आसा के राज्य के सताईसवें साल म्ह होया।<verse eid="1KI 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 16:11" />अर जिब वो राज करण लाग्या, फेर गद्दी पै बैठदे उसनै बाशा के पूरे घरान्‍ने ताहीं मार गेरया, बल्के उसनै ना तो उसके कुटुम्बियाँ अर ना उसके साथियाँ म्ह तै एक छोरे ताहीं भी जिन्दा न्ही छोड्या। <verse eid="1KI 16:11" /><verse number="12" style="v" sid="1KI 16:12" />इस तरियां यहोवा के उस वचन कै मुताबिक जो उसनै येहू नबी के जरिये बाशा कै खिलाफ कह्या था, जिम्री नै बाशा के सारे घरान्‍ने का नाश कर दिया। <verse eid="1KI 16:12" /><verse number="13" style="v" sid="1KI 16:13" />इसका कारण बाशा के सारे पाप अर उसके बेट्टे एला के भी पाप थे, जो उननै अपणे आप करकै अर इस्राएल तै भी करवा कै इस्राएल के परमेसवर यहोवा ताहीं बेकार की बात्तां तै छो दुवाया था। <verse eid="1KI 16:13" /><verse number="14" style="v" sid="1KI 16:14" />एला के और सारे काम जो उसनै करे, के वो इस्राएल के राजयां कै इतिहास की किताब म्ह न्ही लिक्खे सैं।<verse eid="1KI 16:14" /></para>
  <para style="s">जिम्री का राज</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15" />यहूदा के राजा आसा के सताईसवें साल म्ह जिम्री तिर्सा म्ह राज करण लाग्या, अर तिर्सा म्ह सात दिन ताहीं राज्य करदा रह्या। उस बखत माणस पलिश्तियाँ के देश गिब्बतोन के शहर के खिलाफ डेरे करे होए थे। <verse eid="1KI 16:15" /><verse number="16" style="v" sid="1KI 16:16" />तो जिब उन डेरे लगाऐ होए माणसां नै सुण्या, के जिम्री नै राजद्रोह की साजिस करकै राजा ताहीं मार गेरया सै, तो उसे दिन पूरे इस्राएल नै ओम्री नाम के प्रधान सेनापति ताहीं छावणी म्ह इस्राएल का राजा बणाया। <verse eid="1KI 16:16" /><verse number="17" style="v" sid="1KI 16:17" />फेर ओम्री नै सारे इस्राएल ताहीं गैल ले गिब्बतोन नै छोड़कै तिर्सा ताहीं घेर लिया। <verse eid="1KI 16:17" /><verse number="18" style="v" sid="1KI 16:18" />जिब जिम्री नै देख्या, के नगर ले लिया गया सै, फेर राजभवन के गुम्मट म्ह जाकै राजभवन म्ह आग लगा दी, अर उसे म्ह खुद जळ मरया। <verse eid="1KI 16:18" /><verse number="19" style="v" sid="1KI 16:19" />यो उसके पापां के कारण होया क्यूँके उसनै वो करया जो यहोवा की नजर म्ह बुरा था, क्यूँके वो यारोबाम की जिसी चाल अर उसके करे होए अर इस्राएल तै कराए होए पाप की लीक पै चाल्या। <verse eid="1KI 16:19" /><verse number="20" style="v" sid="1KI 16:20" />जिम्री के और काम अर जो राजद्रोह की साजिस उसनै करी, यो सारा इस्राएल के राजयां कै इतिहास की किताब म्ह लिख्या सै।<verse eid="1KI 16:20" /></para>
  <para style="s">ओम्री का राज</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21" />फेर इस्राएली प्रजा दो हिस्यां म्ह बँटगी, प्रजा के आध्धे माणस तो तिब्नी नाम के गीनत के बेट्टे ताहीं राजा बणाण कै खात्तर उस्से कै पाच्छै हो लिए, अर आध्धे ओम्री कै पाच्छै हो लिए। <verse eid="1KI 16:21" /><verse number="22" style="v" sid="1KI 16:22" />अन्त म्ह जो माणस ओम्री कै पाच्छै होए थे वे उनपै हावी होगे जो गीनत के बेट्टे तिब्नी कै पाच्छै हो लिए थे, ज्यांतै तिब्नी मारया गया अर ओम्री राजा बणग्या। <verse eid="1KI 16:22" /><verse number="23" style="v" sid="1KI 16:23" />यहूदा के राजा आसा के इकतीसवें साल म्ह ओम्री इस्राएल पै राज करण लाग्या, अर बारहा साल ताहीं राज करदा रह्या; उसनै छः साल तो तिर्सा म्ह राज करया। <verse eid="1KI 16:23" /><verse number="24" style="v" sid="1KI 16:24" />अर उसनै शेमेर तै सामरिया पहाड़ ताहीं दो किक्‍कार चाँदी<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">लगभग 70 किलोग्राम चाँदी</char></note> म्ह मोल लेकै, उसपै एक नगर बसाया; अर अपणे बसाए होए नगर का नाम पहाड़ के माल्‍लिक शेमेर कै नाम पै सामरिया धरया।<verse eid="1KI 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 16:25" />ओम्री नै वो करया जो यहोवा की नजर म्ह बुरा था बल्के उन सारया तै भी जो उसतै पैहल्या थे घणी बुराई करी। <verse eid="1KI 16:25" /><verse number="26" style="v" sid="1KI 16:26" />वो नबात के बेट्टे यारोबाम की जिसी सारी चाल चाल्या, अर उसके सारे पापां कै मुताबिक जो उसनै इस्राएल तै करवाऐ थे जिसके कारण इस्राएल के परमेसवर यहोवा तै उननै अपणे बेकार के काम्मां तै छो दुवाया था। <verse eid="1KI 16:26" /><verse number="27" style="v" sid="1KI 16:27" />ओम्री के और काम जो उसनै करे, अर जो वीरता उसनै दिखाई, यो सारा के इस्राएल के राजयां कै इतिहास की किताब म्ह न्ही लिख्या सै? <verse eid="1KI 16:27" /><verse number="28" style="v" sid="1KI 16:28" />ओम्री मरकै अपणे पुरखां कै गैल जा मिल्या अर सामरिया म्ह उस ताहीं माट्टी दी गई, अर उसका बेट्टा अहाब उसकी जगहां पै राज करण लाग्या।<verse eid="1KI 16:28" /></para>
  <para style="s">अहाब के राज की शरुआत</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29" />यहूदा के राजा आसा के राज के अड़तीसवें साल म्ह ओम्री का बेट्टा अहाब इस्राएल पै राज करण लाग्या, अर इस्राएल पै सामरिया म्ह बाईस साल ताहीं राज करदा रह्या। <verse eid="1KI 16:29" /><verse number="30" style="v" sid="1KI 16:30" />अर ओम्री के बेट्टे अहाब नै उन सबतै घणे जो उसतै पैहल्या थे, वो काम करे जो यहोवा की नजर म्ह बुरे थे। <verse eid="1KI 16:30" /><verse number="31" style="v" sid="1KI 16:31" />उसनै तो नबात के बेट्टे यारोबाम के पापां म्ह चालणा हळकी सी बात जाणकै, सीदोनियां के राजा एतबाल की बेट्टी ईजेबेल तै ब्याह करकै बाल देवता<note caller="+" style="f"><char style="fr" closed="false">16:31 </char><char style="fq" closed="false">बाल देवता </char><char style="ft" closed="false">बाल एक कनान का तूफान आळा अर उर्वरता आळा देवता था </char></note> की उपासना करी अर उस ताहीं दण्डवत करया।<note caller="+" style="f"><char style="fr" closed="false">16:31 </char><char style="ft" closed="false">प्रकाशितवाक्य 2:20</char></note> <verse eid="1KI 16:31" /><verse number="32" style="v" sid="1KI 16:32" />उसनै बाल का एक भवन सामरिया म्ह बणाकै उस म्ह बाल की एक वेदी बणाई। <verse eid="1KI 16:32" /><verse number="33" style="v" sid="1KI 16:33" />अर अहाब नै एक अशेरा भी बणाया, बलके उसनै उन सारे इस्राएली राजयां तै बढ़कै जो उसतै पैहला थे इस्राएल के परमेसवर यहोवा ताहीं छो दुआण के काम करे। <verse eid="1KI 16:33" /><verse number="34" style="v" sid="1KI 16:34" />उसके दिनां म्ह बेतेलवासी हीएल नै यरीहो ताहीं फेर बसाया; जिब उसनै उसकी नींव डाली फेर उसका जेठ्ठा बेट्टा अबीराम मर ग्या, अर जिब उसनै उसके फाटक खड़े करे तब उसका छोट्टा बेट्टा सगूब मर ग्या, यो यहोवा के उस वचन कै मुताबिक होया, जो उसनै नून के बेट्टे यहोशू के जरिये कुह्वाया था<note caller="+" style="f"><char style="fr" closed="false">16:34 </char><char style="fq" closed="false">यहोशू के जरिये कुह्वाया था </char><char style="ft" closed="false">यहोशू 6:26</char></note>।<verse eid="1KI 16:34" /></para>
  <chapter eid="1KI 16" />
  <chapter number="17" style="c" sid="1KI 17" />
  <para style="s">एलिय्याह के काम की शरुआत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1" />तिशबी<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="fq" closed="false">तिशबी </char><char style="ft" closed="false">नगर</char></note> एलिय्याह नबी जो गिलाद<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="fq" closed="false">गिलाद </char><char style="ft" closed="false">क्षेत्र</char></note> का रहण आळा था उसनै अहाब तै कह्या, “इस्राएल का परमेसवर यहोवा जिसकै स्याम्ही मै हाजिर रहूँ सूं, उसके जीवन की कसम इन साल्‍लां म्ह मेरे बिना कहे, ना तो मिह बरसैगा, अर ना ओस पड़ैगी।”<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="ft" closed="false">लूका 4:25, याकूब 5:17, प्रकाशितवाक्य 11:6</char></note> <verse eid="1KI 17:1" /><verse number="2" style="v" sid="1KI 17:2" />फेर यहोवा का यो वचन उसकै धोरै पोहच्या, <verse eid="1KI 17:2" /><verse number="3" style="v" sid="1KI 17:3" />“उरै तै चालकै पूरब की और जा अर करीत नाम की नदी म्ह जो यरदन नदी के पूर्व म्ह सै छिप जा। <verse eid="1KI 17:3" /><verse number="4" style="v" sid="1KI 17:4" />उसे नदी का पाणी तू पिया कर, अर मन्‍नै काग्याँ ताहीं हुकम दिया सै के वे तन्‍नै ओड़ै खुवावैं।” <verse eid="1KI 17:4" /><verse number="5" style="v" sid="1KI 17:5" />यहोवा का यो वचन मानकै वो यरदन के पूर्व म्ह करीत नाम की नदी म्ह जाकै छुप्या रह्या। <verse eid="1KI 17:5" /><verse number="6" style="v" sid="1KI 17:6" />अर सबेरै अर साँझ नै काग उसकै धोरै रोट्टी अर माँस ल्याया करैं थे अर वो नदी का पाणी पिया करै था। <verse eid="1KI 17:6" /><verse number="7" style="v" sid="1KI 17:7" />कुछ दिनां कै बाद उस देश म्ह बारिस ना होण कै कारण नदी सूखगी। <verse eid="1KI 17:7" /><verse number="8" style="v" sid="1KI 17:8" />फेर यहोवा का यो वचन उसकै धोरै पोहच्या, <verse eid="1KI 17:8" /><verse number="9" style="v" sid="1KI 17:9" />“चालकै सीदोन के सारफत नगर म्ह जाकै ओड़ैए रह। सुण, मन्‍नै ओड़ै की एक बिधवा तै तेरे ताहीं खुवाण का हुकम दिया सै।”<note caller="+" style="f"><char style="fr" closed="false">17:9 </char><char style="ft" closed="false">लूका 4:26</char></note> <verse eid="1KI 17:9" /><verse number="10" style="v" sid="1KI 17:10" />आखर म्ह वो ओड़ै तै चाल पड्या, अर सारफत नगर म्ह गया; नगर के फाटक कै धोरै पोहचकै उसनै के देख्या के, एक बिधवा लाकड़ी चुगण लागरी सै, उसनै बुलाकै उसतै कह्या, “किसे बरतन म्ह मेरै पीण खात्तर थोड़ा पाणी ले आ।” <verse eid="1KI 17:10" /><verse number="11" style="v" sid="1KI 17:11" />जिब वा लेण जावै थी, तो उसनै उसतै रुक्‍का मारकै कह्या, “अपणे हाथ म्ह एक टुकड़ा रोट्टी भी मेरै खात्तर ले आ।” <verse eid="1KI 17:11" /><verse number="12" style="v" sid="1KI 17:12" />उसनै कह्या, “तेरे परमेसवर यहोवा के जीवन की कसम मेरै धोरै एक भी रोट्टी न्ही सै सिर्फ घड़े म्ह मुट्ठी भर मैदा अर कुप्पी म्ह थोड़ा-सा तेल सै, अर मै एक-दो लाकड़ी चुगण खात्तर जाऊँ सूं के अपणे अर अपणे बेट्टे कै खात्तर उसनै पकाऊँ, अर हम उसनै खावां, फेर मर ज्यां।” <verse eid="1KI 17:12" /><verse number="13" style="v" sid="1KI 17:13" />एलिय्याह नै उसतै कह्या, “मत डर; जाकै अपणी बात कै मुताबिक कर, पर पैहले मेरै खात्तर एक छोट्टी सी रोट्टी बणाकै मेरै धोरै ले आ, फेर इसकै बाद अपणे अर अपणे बेट्टे कै खात्तर बणाईये। <verse eid="1KI 17:13" /><verse number="14" style="v" sid="1KI 17:14" />क्यूँके इस्राएल का परमेसवर यहोवा न्यू कहवै सै, के जिब तक यहोवा धरती पै मिह ना बरसावैगा जिब ताहीं ना तो उस घड़े का मैद्दा खतम होवैगा, अर ना उस कुप्पी का तेल घटैगा।” <verse eid="1KI 17:14" /><verse number="15" style="v" sid="1KI 17:15" />फेर वा चली गई, अर एलिय्याह के वचन कै मुताबिक करया, जिब तै वो अर वा बिरबान्‍नी अर उसका घरान्‍नां घणे दिनां ताहीं खान्दे रहे। <verse eid="1KI 17:15" /><verse number="16" style="v" sid="1KI 17:16" />यहोवा के उस वचन कै मुताबिक जो उसनै एलिय्याह के जरिये कह्या था, ना तो उस घड़े का मैद्दा खतम होया, अर ना उस कुप्पी का तेल घट्या।<verse eid="1KI 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17" />कुछ बखत कै बाद उस जनान्‍नी का बेट्टा जो घर की मालकिन थी, रोगी होया, अर उसका रोग उरै ताहीं बढ़ ग्या के उसका साँस लेणा बन्द होग्या। <verse eid="1KI 17:17" /><verse number="18" style="v" sid="1KI 17:18" />फेर वा एलिय्याह तै कहण लाग्गी, “हे परमेसवर के जन मन्‍नै तेरा के अपराध करया? के तू ज्यांतै मेरै उरै आया सै के मेरे बेट्टे की मौत का कारण हो अर मेरे पाप की याद दिलावै?” <verse eid="1KI 17:18" /><verse number="19" style="v" sid="1KI 17:19" />उसनै उसतै कह्या, “अपणा बेट्टा मन्‍नै दे;” फेर वो उसनै उसकी गोद म्ह तै लेकै उस अटारी पै लेग्या जित्त वो खुद रहवै था, अर अपणी खाट पै लिटा दिया। <verse eid="1KI 17:19" /><verse number="20" style="v" sid="1KI 17:20" />फेर उसनै यहोवा ताहीं पुकारकै कह्या, “हे मेरे परमेसवर यहोवा! के तू इस बिधवा का बेट्टा मारकै जिसकै उरै मै टिक्या सूं, इसपै भी मुसीबत ले आया सै?” <verse eid="1KI 17:20" /><verse number="21" style="v" sid="1KI 17:21" />फेर वो बाळक पै तीन बार पसर ग्या अर यहोवा ताहीं पुकारकै कह्या, “हे मेरे परमेसवर यहोवा! इस बाळक का जी इस म्ह फेर डाल दे।” <verse eid="1KI 17:21" /><verse number="22" style="v" sid="1KI 17:22" />एलिय्याह की या बात यहोवा नै सुण ली, अर बाळक का जी उस म्ह फेर आ ग्या अर वो जी उठ्या। <verse eid="1KI 17:22" /><verse number="23" style="v" sid="1KI 17:23" />फेर एलिय्याह बाळक नै अटारी पै तै तळै घर म्ह लेग्या, अर एलिय्याह नै यो कहकै उसकी माँ कै हाथ म्ह सौंप दिया, “देख तेरा बेट्टा जिन्दा सै।” <verse eid="1KI 17:23" /><verse number="24" style="v" sid="1KI 17:24" />जनान्‍नी नै एलिय्याह तै कह्या, “इब मै पक्‍का जाण गई सूं के तू परमेसवर का जन सै, अर यहोवा का जो वचन तेरे मुँह तै लिकड़ै सै, वो सच्‍ची होवै सै।”<verse eid="1KI 17:24" /></para>
  <chapter eid="1KI 17" />
  <chapter number="18" style="c" sid="1KI 18" />
  <para style="s">यहोवा की जीत अर बाल की हार</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1" />घणे दिनां कै बाद, तीसरे साल म्ह यहोवा का यो वचन एलिय्याह कै धोरै पोहच्या, “जाकै अपणे-आपनै अहाब ताहीं दिखा, अर मै धरती पै मिह बरसा दियुँगा।” <verse eid="1KI 18:1" /><verse number="2" style="v" sid="1KI 18:2" />फेर एलिय्याह अपणे-आपनै अहाब ताहीं दिखाण गया। उस बखत सामरिया म्ह अकाळ भारी था। <verse eid="1KI 18:2" /><verse number="3" style="v" sid="1KI 18:3" />अहाब नै ओबद्याह ताहीं जो उसके घरान्‍ने का दीवान था बुलवाया। <verse eid="1KI 18:3" /><verse number="4" style="v" sid="1KI 18:4" />ओबद्याह तो यहोवा का भय उरै ताहीं मान्‍नै था कै जिब ईजेबेल यहोवा के नबियाँ नै नाश करै थी, जद ओबद्याह नै एक सौ नबियाँ नै लेकै पचास-पचास करकै गुफा म्ह छुपाकै राख्या; अर अन्‍न-पाणी देकै उनका पालन-पोषण करदा रह्या। <verse eid="1KI 18:4" /><verse number="5" style="v" sid="1KI 18:5" />अर अहाब नै ओबद्याह तै कह्या, “देश म्ह पाणी के सारे सोत्यां अर सारी नदियाँ कै धोरै जा, हो सकै इतणी घास मिलै के हम घोड़यां अर खच्‍चरां नै जिन्दा बचा सकां, अर म्हारे सारे पशु ना मर जावैं।” <verse eid="1KI 18:5" /><verse number="6" style="v" sid="1KI 18:6" />आखर म्ह उननै आप्पस म्ह देश बाँट्यां के उस म्ह होकै चाल्‍लै; एक और अहाब अर दुसरी और ओबद्याह चाल्या।<verse eid="1KI 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 18:7" />ओबद्याह राह म्ह ए था, के एलिय्याह उसतै मिल्या; उसनै पिछाण कै वो मुँह कै बळ गिरया, अर कह्या, “हे मेरे प्रभु एलिय्याह, के तू ए सै?” <verse eid="1KI 18:7" /><verse number="8" style="v" sid="1KI 18:8" />उसनै जवाब दिया, “हाँ मै ए सूं: जाकै अपणे स्वामी तै कह, ‘एलिय्याह मिल्या सै।’” <verse eid="1KI 18:8" /><verse number="9" style="v" sid="1KI 18:9" />उसनै कह्या, “मन्‍नै इसा के पाप करया सै के तू मन्‍नै मरवा देण खात्तर अहाब कै हाथ करणा चाहवै सै? <verse eid="1KI 18:9" /><verse number="10" style="v" sid="1KI 18:10" />तेरे परमेसवर यहोवा के जीवन की कसम कोए इसी जात या राज्य न्ही, जिस म्ह मेरे स्वामी नै तेरे ताहीं ढूँढ़ण नै ना भेज्या हो, अर फेर उन माणसां नै कह्या, ‘वो उरै न्ही सै,’ फेर उसनै उस राज्य या जात ताहीं इसकी कसम खुआई के न्ही मिल्या। <verse eid="1KI 18:10" /><verse number="11" style="v" sid="1KI 18:11" />अर इब तू कहवै सै, ‘जाकै अपणे स्वामी तै कह, के एलिय्याह उरै सै।’ <verse eid="1KI 18:11" /><verse number="12" style="v" sid="1KI 18:12" />फेर ज्यों ए मै तेरै धोरै तै चल्या जाऊँगा, उसे बखत यहोवा का आत्मा तन्‍नै ना जाणै कित्त ठा ले जावैगा, आखर जिब मै जाकै अहाब ताहीं बताऊँगा, अर तू उसनै न्ही मिलैगा, तो वो मन्‍नै मार देगा: पर मै तेरा दास अपणे बाळकपण तै यहोवा का भय मानदा आया सूं! <verse eid="1KI 18:12" /><verse number="13" style="v" sid="1KI 18:13" />के मेरे प्रभु तै यो न्ही बताया गया, के जिब ईजेबेल यहोवा के नबियाँ नै घात करै थी जद मन्‍नै के करया? के यहोवा के नबियाँ म्ह तै एक सौ लेकै पचास-पचास करकै गुफा म्ह छुपाकै राख्या, अर उननै अन्‍न-पाणी देकै पाळदा रह्या। <verse eid="1KI 18:13" /><verse number="14" style="v" sid="1KI 18:14" />फेर इब तू कहवै सै, ‘जाकै अपणे स्वामी तै कह, के एलिय्याह मिल्या सै!’ फेर वो मन्‍नै घात करैगा।” <verse eid="1KI 18:14" /><verse number="15" style="v" sid="1KI 18:15" />एलिय्याह नै कह्या, “सेनाओं का यहोवा जिसकै स्याम्ही मै रहूँ सूं, उसके जीवन की कसम आज मै अपणे-आपनै उस ताहीं जाहिर करुँगा।” <verse eid="1KI 18:15" /><verse number="16" style="v" sid="1KI 18:16" />फेर ओबद्याह अहाब तै मिलण गया, अर उस ताहीं बता दिया; आखर अहाब एलिय्याह तै मिलण चाल्या।<verse eid="1KI 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 18:17" />एलिय्याह ताहीं देखदे अहाब नै कह्या, “हे इस्राएल के सताण आळे के तू ए सै?” <verse eid="1KI 18:17" /><verse number="18" style="v" sid="1KI 18:18" />उसनै कह्या, “मन्‍नै इस्राएल ताहीं दुख न्ही दिया, पर तन्‍नै अर तेरे पिता के कुण्बे नै दिया सै; क्यूँके थम यहोवा के हुकमां नै टाळकै बाल देवता की उपासना करण लाग्गे। <verse eid="1KI 18:18" /><verse number="19" style="v" sid="1KI 18:19" />इब दूत भेजकै सारे इस्राएल नै अर बाल के साढ़े च्यार सौ नबियाँ अर अशेरा के च्यार सौ नबियाँ नै जो ईजेबेल की मेज पै खावैं सैं, मेरै गैल कर्मेल पर्वत पै कठ्ठा कर ले।”<verse eid="1KI 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 18:20" />फेर अहाब नै सारे इस्राएलियाँ ताहीं बुलावा भेज्या अर नबियाँ ताहीं कर्मेल पर्वत पै कठ्ठा करया। <verse eid="1KI 18:20" /><verse number="21" style="v" sid="1KI 18:21" />अर एलिय्याह सारे माणसां कै धोरै आकै कहण लाग्या, “थम कद ताहीं दो विचारां म्ह लटके रहोगे, जै यहोवा परमेसवर हो, तो उसकै पाच्छै हो ल्यो; अर जै बाल हो, तो उसकै पाच्छै हो ल्यो।” माणसां नै उसके उत्तर म्ह एक भी बात न्ही कही। <verse eid="1KI 18:21" /><verse number="22" style="v" sid="1KI 18:22" />फेर एलिय्याह नै माणसां तै कह्या, “यहोवा के नबियाँ म्ह तै सिर्फ मै ए रहग्या सूं; अर बाल के नबी साढ़े च्यार सौ माणस सैं। <verse eid="1KI 18:22" /><verse number="23" style="v" sid="1KI 18:23" />ज्यांतै दो बाछड़े ल्याकै म्हारे तै दिए जावै, अर वे एक अपणे खात्तर चुण कै उसनै टुकड़े-टुकड़े काटकै लाकड़ी पै धर दें, अर किमे आग ना लगावै; अर मै दुसरे बाछड़े नै त्यार करकै लाकड़ी पै धरुँगा, अर आग न्ही लगाऊँगा। <verse eid="1KI 18:23" /><verse number="24" style="v" sid="1KI 18:24" />फेर थम अपणे देवता तै प्रार्थना करियो, अर मै यहोवा तै प्रार्थना करुँगा, अर जो आग गिराकै जवाब दे वोए परमेसवर ठहरै।” फेर सारे माणस बोलण लाग्गे, “आच्छी बात।” <verse eid="1KI 18:24" /><verse number="25" style="v" sid="1KI 18:25" />अर एलिय्याह नै बाल के नबियाँ तै कह्या, “पैहल्या थम एक बाछड़ा चुण कै त्यार कर ल्यो, क्यूँके थम तो घणे सो; फेर अपणे देवता तै प्रार्थना करियो, पर आग ना लगाईयो।” <verse eid="1KI 18:25" /><verse number="26" style="v" sid="1KI 18:26" />फेर उननै उस बाछड़े ताहीं जो उनतै दिया गया था लेकै त्यार करया, अर सबेर तै लेकै दोपहर ताहीं वो न्यू कहकै बाल तै प्रार्थना करदे रहे, “हे बाल म्हारी सुण, हे बाल म्हारी सुण!” पर ना कोए शब्द अर ना कोए उत्तर देण आळा होया। फेर वे अपणी बणाई होई वेदी पै उछळण कूद्दण लाग्गे। <verse eid="1KI 18:26" /><verse number="27" style="v" sid="1KI 18:27" />दोपहर ताहीं एलिय्याह नै यो कहकै उनका मजाक करया, “ऊँच्‍चे शब्द तै पुकारो, वो तो देवता सै; वो तो ध्यान लगाऐ होवैगा, या किते गया होवैगा या यात्रा म्ह होवैगा, या हो सकै सै के सोन्दा हो अर उस ताहीं जगाणा चाहिए।” <verse eid="1KI 18:27" /><verse number="28" style="v" sid="1KI 18:28" />अर उननै बड़े शब्द तै पुकार-पुकारकै अपणी रीति कै मुताबिक छुरी अर बर्छियां तै अपणे-अपणे ताहीं उरै तक जख्मी करया के लहू लुहाण होगे। <verse eid="1KI 18:28" /><verse number="29" style="v" sid="1KI 18:29" />वे दोपहर ताहीं के, बल्के भेंट चढ़ाण कै बखत ताहीं नबूवत करदे रहे, पर कोए शब्द न्ही सुणाई पड्या; अर ना तो किसे नै जवाब दिया अर ना उनपै ध्यान दिया।<verse eid="1KI 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30" />फेर एलिय्याह नै सारे माणसां तै कह्या, “मेरै धोरै आओ;” अर सारे माणस उसकै धोरै आए। फेर उसनै यहोवा की वेदी की जो गिराई गई थी मरम्मत करी। <verse eid="1KI 18:30" /><verse number="31" style="v" sid="1KI 18:31" />फेर एलिय्याह नै याकूब के बेट्यां की गिणती कै मुताबिक जिसकै धोरै यहोवा का यो वचन आया था, “तेरा नाम इस्राएल होवैगा,” बारहा पत्थर छाँटे, <verse eid="1KI 18:31" /><verse number="32" style="v" sid="1KI 18:32" />अर उन पत्थरां तै यहोवा के नाम की एक वेदी बणाई; अर उसके च्यांरु और इतणा बड़ा एक खड्डा खोद दिया, के उस म्ह दो सआ<note caller="+" style="f"><char style="fr" closed="false">18:32 </char><char style="fq" closed="false">दो सआ </char><char style="ft" closed="false">12 मीटर</char></note> बीज समा सकै। <verse eid="1KI 18:32" /><verse number="33" style="v" sid="1KI 18:33" />फेर उसनै वेदी पै लाकड़ी ताहीं सजाया, अर बाछड़े ताहीं टुकड़े-टुकड़े काटकै लाकड़ी पै धर दिया, अर कह्या, “च्यार घड़े पाणी भरकै होमबलि, पशु अर लाकड़ी पै उण्डेल द्यो।” <verse eid="1KI 18:33" /><verse number="34" style="v" sid="1KI 18:34" />फेर उसनै कह्या, “दुसरी बार उस्से तरियां ए करो;” फेर माणसां नै दुसरी बार उसाए करया। फेर उसनै कह्या, “तीसरी बार करो;” फेर माणसां नै तीसरी बार भी उसाए करया। <verse eid="1KI 18:34" /><verse number="35" style="v" sid="1KI 18:35" />अर पाणी वेदी के च्यांरु और बह ग्या, अर खड्डे ताहीं भी उसनै पाणी तै भर दिया।<verse eid="1KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 18:36" />फेर भेंट चढ़ाण कै बखत एलिय्याह नबी धोरै जाकै कहण लाग्या, “हे अब्राहम, इसहाक अर इस्राएल के परमेसवर यहोवा! आज यो साबित कर के इस्राएल म्ह तू ए परमेसवर सै, अर मै तेरा दास सूं, अर मन्‍नै ये सारे काम तेरे तै वचन पाकै करे सैं। <verse eid="1KI 18:36" /><verse number="37" style="v" sid="1KI 18:37" />हे यहोवा! मेरी सुण, मेरी सुण, के ये माणस जाण लें के हे यहोवा, तू ए परमेसवर सै, अर तू ए उनका मन बोहड़ा ल्यावै सै।” <verse eid="1KI 18:37" /><verse number="38" style="v" sid="1KI 18:38" />फेर यहोवा की आग अकास तै प्रगट होई अर होमबलि ताहीं लाकड़ी अर पत्थरां अर धूळ सुधा भस्म कर दिया, अर खड्डे म्ह का सारा पाणी भी सूखा दिया। <verse eid="1KI 18:38" /><verse number="39" style="v" sid="1KI 18:39" />यो देख सारे माणस मुँह कै बळ गिरकै बोलण लाग्गे, “यहोवा ए परमेसवर सै, यहोवा ए परमेसवर सै;” <verse eid="1KI 18:39" /><verse number="40" style="v" sid="1KI 18:40" />एलिय्याह नै उनतै कह्या, “बाल के नबियाँ नै पकड़ ल्यो, उन म्ह तै एक भी भाज्जण न्ही पावै;” फेर उननै उन ताहीं पकड़ लिया, अर एलिय्याह नै उन ताहीं नीच्‍चै कीशोन के नाळे म्ह ले जाकै मार गेरया। <verse eid="1KI 18:40" /><verse number="41" style="v" sid="1KI 18:41" />फेर एलिय्याह नै अहाब तै कह्या, “उठकै खा-पी, क्यूँके भारी बारिस की सणसनाहट सुणाई पड़ै सै।” <verse eid="1KI 18:41" /><verse number="42" style="v" sid="1KI 18:42" />फेर अहाब खाण-पीण चल्या गया, अर एलिय्याह कर्मेल की चोट्टी पै चढ़ ग्या, अर धरती पै गिरकै अपणा मुँह घुटन्या कै बीच करया, <verse eid="1KI 18:42" /><verse number="43" style="v" sid="1KI 18:43" />अर उसनै अपणे सेवक तै कह्या, “चढ़कै समुन्दर की और ध्यान करकै देख,” फेर उसनै चढ़कै देख्या अर बोहड़कै कह्या, “किमे न्ही दिखदा।” एलिय्याह नै सात बार कह्या, “फेर जा।” <verse eid="1KI 18:43" /><verse number="44" style="v" sid="1KI 18:44" />सातवीं बार उसनै कह्या, “देख्या समुन्दर म्ह तै माणस का हाथ जिसा एक छोट्टा बाद्दळ उठण लागरया सै।” एलिय्याह नै कह्या, “अहाब कै धोरै जाकै कह, ‘रथ जुतवा कै तळै जा, कदे इसा ना हो के तू बारिस कै कारण रुक जावै।’” <verse eid="1KI 18:44" /><verse number="45" style="v" sid="1KI 18:45" />थोड़ी-ए देर म्ह अकास हवा तै उड़ाई होई घटा, अर आँधी तै काळा होग्या अर भारी बारिस होण लाग्गी; अर अहाब रथ पै सवार होकै यिज्रेल नै चाल्या।<note caller="+" style="f"><char style="fr" closed="false">18:45 </char><char style="ft" closed="false">याकूब 5:18</char></note> <verse eid="1KI 18:45" /><verse number="46" style="v" sid="1KI 18:46" />फेर यहोवा की शक्ति एलिय्याह पै इसी होई; के वो कमर बाँधकै अहाब कै आग्गै-आग्गै यिज्रेल ताहीं दौड़दा चल्या गया।<note caller="+" style="f"><char style="fr" closed="false">18:46 </char><char style="ft" closed="false">लूका 12:35</char></note><verse eid="1KI 18:46" /></para>
  <chapter eid="1KI 18" />
  <chapter number="19" style="c" sid="1KI 19" />
  <para style="s">एलिय्याह का निराश होणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1" />जिब अहाब नै अपणी घरआळी ईजेबेल ताहीं एलिय्याह के सारे काम विस्तार तै बताए के उसनै सारे नबियाँ ताहीं तलवार तै किस तरियां मार गेरया। <verse eid="1KI 19:1" /><verse number="2" style="v" sid="1KI 19:2" />फेर ईजेबेल नै एलिय्याह कै धोरै एक दूत के जरिये कुह्वा भेज्जा, “जै मै कल इस्से बखत ताहीं तेरी जान उनकी जिसी ना कर दियुँ तो देवता मेरै गैल उसाए बल्के उसतै भी घणा करैं।” <verse eid="1KI 19:2" /><verse number="3" style="v" sid="1KI 19:3" />यो देख एलिय्याह डरकै अपणा प्राण लेकै भाज्या, अर यहूदा के बेर्शेबा नगर ताहीं पोहचकै अपणे सेवक ताहीं ओड़ैए छोड़ दिया।<verse eid="1KI 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 19:4" />अर एलिय्याह आप बियाबान म्ह एक दिन के राह पै जाकै एक झाऊ के पेड़ कै तळै बैठ ग्या, ओड़ै उसनै न्यू बिनती करकै अपणी मौत माँगी, “हे यहोवा बस, इब मेरा प्राण ले ले, क्यूँके मै अपणे पुरखां तै आच्छा न्ही सूं।” <verse eid="1KI 19:4" /><verse number="5" style="v" sid="1KI 19:5" />वो झाऊ के पेड़ तळै लेट कै सो ग्या अर देक्खो एक दूत नै उसतै छू कै कह्या, “उठकै खा।” <verse eid="1KI 19:5" /><verse number="6" style="v" sid="1KI 19:6" />उसनै देखकै के देख्या के मेरै सिरहाणै पत्थरां पै पकी होई एक रोट्टी, अर एक सुराही पाणी धरया सै; फेर उसनै खाया अर पिया अर फेर लेट ग्या। <verse eid="1KI 19:6" /><verse number="7" style="v" sid="1KI 19:7" />दुसरी बार यहोवा का दूत आया अर उसनै छू कै उसतै कह्या, “उठकै खा, क्यूँके तन्‍नै घणी लाम्बी यात्रा करणी सै।” <verse eid="1KI 19:7" /><verse number="8" style="v" sid="1KI 19:8" />फेर उसनै उठकै खाया-पिया; अर उस्से खाणे तै बल पाकै चाळीस दिन-रात चाल्दे-चाल्दे परमेसवर के पर्वत होरेब पै पोहच्या।<verse eid="1KI 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 19:9" />ओड़ै वो एक गुफा म्ह जाकै टिक्या अर यहोवा का यो वचन उसकै धोरै पोहच्या, “हे एलिय्याह तेरा उरै के काम?” <verse eid="1KI 19:9" /><verse number="10" style="v" sid="1KI 19:10" />उसनै जवाब दिया, “सेनाओं के परमेसवर यहोवा कै बारै म्ह मन्‍नै बड़ी जळण होई सै, क्यूँके इस्राएलियाँ नै तेरा करार टाळ दिया, तेरी वेदियाँ ताहीं गिरा दिया, अर तेरे नबियाँ ताहीं तलवार तै घात करया सै, अर मै ए एक्ला रहग्या सूं; अर वे मेरे भी प्राणां के खोजी सैं।” <verse eid="1KI 19:10" /><verse number="11" style="v" sid="1KI 19:11" />उसनै कह्या, “लिकड़कै यहोवा कै धोरै पर्वत पै खड्या हो।” अर यहोवा धोरै तै होकै चाल्या, अर यहोवा कै स्याम्ही एक घणी तेज आँधी तै पहाड़ पाट्टण अर चट्टान टूटण लाग्गी, फेर भी यहोवा उस आँधी म्ह ना था; फेर आँधी कै बाद भूकम्प होया, फेर भी यहोवा उस भूकम्प म्ह ना था। <verse eid="1KI 19:11" /><verse number="12" style="v" sid="1KI 19:12" />फेर भूकम्प कै बाद आग दिखाई दी, फेर भी यहोवा उस आग म्ह ना था; फेर आग कै बाद एक दब्या होया धीमा शब्द सुणाई दिया। <verse eid="1KI 19:12" /><verse number="13" style="v" sid="1KI 19:13" />यो सुणदे एलिय्याह नै अपणा मुँह चाद्दर तै ढक लिया, अर बाहर जाकै गुफा कै द्वार पै खड्या होग्या। फेर एक शब्द उसनै सुणाई दिया, “हे एलिय्याह तेरा उरै के काम?” <verse eid="1KI 19:13" /><verse number="14" style="v" sid="1KI 19:14" />उसनै कह्या<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="ft" closed="false">रोमियों 11:3</char></note>, “मन्‍नै सेनाओं के परमेसवर यहोवा कै बारै म्ह बड़ी जळण होई, क्यूँके इस्राएलियाँ नै तेरा करार टाळ दिया, अर उननै तेरी वेदियाँ ताहीं गिरा दिया सै अर तेरे नबियाँ ताहीं तलवार तै घात करया सै; अर मै ए एक्ला रहग्या सूं; अर वे मेरी जान के भी खोजी सैं।” <verse eid="1KI 19:14" /><verse number="15" style="v" sid="1KI 19:15" />यहोवा नै उसतै कह्या, “लौट कै दमिश्क के बियाबान म्ह जा, अर ओड़ै पोहचकै अराम का राजा होण कै खात्तर हजाएल का अभिषेक कर, <verse eid="1KI 19:15" /><verse number="16" style="v" sid="1KI 19:16" />अर इस्राएल का राजा होण नै निमशी के पोत्ते येहू का, अर अपणी जगहां पै नबी होण कै खात्तर आबेल-महोला नगर के शापात के बेट्टे एलीशा का अभिषेक करिये। <verse eid="1KI 19:16" /><verse number="17" style="v" sid="1KI 19:17" />अर हजाएल की तलवार तै जो कोए बच जावै उसनै येहू मार देवैगा; अर जो कोए येहू की तलवार तै बच जावै उसनै एलीशा मार देवैगा। <verse eid="1KI 19:17" /><verse number="18" style="v" sid="1KI 19:18" />फेर भी मै सात हजार इस्राएलियाँ नै बचाए राक्खूँगा। ये सारे तो वे सैं, जिननै ना तो बाल कै आग्गै घुटने टेक्‍के, अर ना मुँह तै उस ताहीं चुम्या सै अर न ही आराधना करी सै।” <verse eid="1KI 19:18" /><verse number="19" style="v" sid="1KI 19:19" />फेर वो ओड़ै तै चाल पड्या, अर शापात का बेट्टा एलीशा उसनै मिल्या जो बारहा जोड़ी बळध अपणे आग्गै करे होए आप बारहवीं जोड़ी कै गैल होकै हळ जोत्तण लागरया था। उसकै धोरै जाकै एलिय्याह नै अपणी चाद्दर<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="fq" closed="false">अपणी चाद्दर </char><char style="ft" closed="false">एलिय्याह का या काम तो निशान्‍नी के तौर पै था। या दिखावै सै की एलिय्याह के बाद एलीशा नबी होवैगा</char></note> उसपै गेर दी। <verse eid="1KI 19:19" /><verse number="20" style="v" sid="1KI 19:20" />फेर वो बळधां नै छोड़कै एलिय्याह कै पाच्छै दौड्या, अर कहण लाग्या, “मन्‍नै अपणे माँ-बाप नै चुम्ण दे, फेर मै तेरै पाच्छै चाल्‍लूँगा।” उसनै कह्या, “बोहड़ ज्या, मन्‍नै तेरे तै के करया सै?”<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">मत्ती 8:21, लूका 9:61 </char></note> <verse eid="1KI 19:20" /><verse number="21" style="v" sid="1KI 19:21" />फेर उसकै पाच्छै तै बोहड़ ग्या, अर एक जोड़ी बळध लेकै बलि करे, अर बळधां का सामान जळाकै उनका माँस पका कै अपणे माणसां ताहीं दे दिया, अर उननै खाया; फेर वो कमर बाँधकै एलिय्याह कै पाच्छै चाल्या, अर उसकी सेवा पाणी करण लाग्या।<verse eid="1KI 19:21" /></para>
  <chapter eid="1KI 19" />
  <chapter number="20" style="c" sid="1KI 20" />
  <para style="s">अहाब की अरामियां पै जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1" />उन दिन्‍नां म्ह अराम के राजा बेन्हदद नै अपणी सारी सेना कठ्ठी करी, अर उसके गैल बत्तीस राजा अर घोड़े अर रथ थे; उननै गैल लेकै उसनै सामरिया पै चढ़ाई करी, अर उसनै घेर कै उसकै खिलाफ लड़या। <verse eid="1KI 20:1" /><verse number="2" style="v" sid="1KI 20:2" />अर उसनै नगर म्ह इस्राएल के राजा अहाब कै धोरै दूत्तां ताहीं न्यू कहण कै खात्तर भेज्या, “बेन्हदद तेरे ताहीं न्यू कहवै सै, <verse eid="1KI 20:2" /><verse number="3" style="v" sid="1KI 20:3" />‘तेरा चाँदी-सोन्‍ना मेरा सै, अर तेरी बिरबानियाँ अर बाळकां म्ह जो-जो आच्छे सैं वो भी सारे मेरे सैं।’” <verse eid="1KI 20:3" /><verse number="4" style="v" sid="1KI 20:4" />इस्राएल के राजा नै उसकै धोरै कुह्वा भेज्जा, “हे मेरे प्रभु! हे राजा! तेरे वचन कै मुताबिक मै अर मेरा जो किमे सै, सारा तेरा सै।” <verse eid="1KI 20:4" /><verse number="5" style="v" sid="1KI 20:5" />उन दूत्तां नै फेर आकै कह्या, “बेन्हदद तेरै ताहीं न्यू कहवै सै, ‘मन्‍नै तेरै धोरै यो सन्देसा भेज्या था के तन्‍नै अपणी चाँदी-सोन्‍ना अर घरआळियाँ अर बाळक भी मेरै ताहीं देणे पड़ैंगें। <verse eid="1KI 20:5" /><verse number="6" style="v" sid="1KI 20:6" />पर कल इसे बखत मै अपणे कर्मचारियाँ नै तेरै धोरै भेज्जूँगा अर वे तेरे अर तेरे कर्मचारियाँ के घरां की तलास्सी लेवैंगे, अर तेरी जो-जो मनभावणी चीज लिकाड़ै उननै वे अपणे-अपणे अधिकार म्ह कर लेवैगें।’”<verse eid="1KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 20:7" />फेर इस्राएल के राजा नै अपणे देश के सारे पुरनियां ताहीं बुलवा के कह्या, “सोच विचार करो, के वो माणस म्हारे नुकसान का ए अभिलाषी सै; उसनै मेरे ताहीं मेरी बिरबानियाँ, बाळकां, चाँदी-सोन्‍ना मँगवाया सै, अर मन्‍नै इन्कार न्ही करया।” <verse eid="1KI 20:7" /><verse number="8" style="v" sid="1KI 20:8" />फेर सारे पुरनियां नै अर सारे माणसां नै उसतै कह्या, “उसकी ना सुणिये; अर ना मानिये।” <verse eid="1KI 20:8" /><verse number="9" style="v" sid="1KI 20:9" />फेर राजा नै बेन्हदद के दूत्तां तै उत्तर दिया, “मेरे प्रभु राजा तै मेरी और तै कह्यो, ‘जो कुछ तन्‍नै पैहल्या अपणे दास तै चाह्या था वो तो मै करुँगा, पर यो मेरे तै ना होवैगा।’” फेर बेन्हदद के दूत्तां नै जाकै उसतै यो उत्तर सुणा दिया। <verse eid="1KI 20:9" /><verse number="10" style="v" sid="1KI 20:10" />फेर बेन्हदद नै अहाब कै धोरै सन्देसा भेज्या, “जै सामरिया म्ह इतणी धूळ लिकड़ै के मेरै पाच्छै चालण आळयां की मुट्ठी भर जावै तो देवता मेरै गैल इसाए बल्के इसतै भी घणा करैं।”<note caller="+" style="f"><char style="fr" closed="false">20:10 </char><char style="ft" closed="false">मत्ती 12:42, लूका 11:31 </char></note> <verse eid="1KI 20:10" /><verse number="11" style="v" sid="1KI 20:11" />इस्राएल के राजा नै जवाब देकै कह्या, “उसतै कह्यो, ‘जो हथियार बाँन्धदा हो वो उसकी तरियां ना फूलै जो उननै उतारदा हो।’” <verse eid="1KI 20:11" /><verse number="12" style="v" sid="1KI 20:12" />यो वचन सुणदे ए बेन्हदद जो दुसरे राजयां सुधा डेरां म्ह पीण लाग रहया था, उसनै अपणे कर्मचारियाँ तै कह्या, “पाँति बाँधो,” फेर उननै नगर कै बिरुध्द पाँति बाँध्धी।<verse eid="1KI 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13" />फेर एक नबी नै इस्राएल के राजा अहाब कै धोरै जाकै कह्या, “यहोवा तेरे तै न्यू कहवै सै, ‘या बड़ी भीड़ जो तन्‍नै देक्खी सै, उस सारी नै मै आज तेरै हाथ म्ह कर दियुँगा, इसतै तू जाण लेवैगा, के मै यहोवा सूं।’” <verse eid="1KI 20:13" /><verse number="14" style="v" sid="1KI 20:14" />अहाब नै पूच्छया, “किसके जरिये?” उसनै कह्या, “यहोवा न्यू कहवै सै, के परदेसां के हाकिमां के सेवकां के जरिये!” फेर उसनै पूच्छया, “युद्ध नै कौण शरु करै?” उसनै जवाब दिया, “तू ए।” <verse eid="1KI 20:14" /><verse number="15" style="v" sid="1KI 20:15" />फेर उसनै परदेसां के हाकिमां के सेवकां की गिणती ली, अर वे दो सौ बत्तीस लिकड़े; अर उनकै बाद उसनै सारे इस्राएली माणसां की गिणती ली, अर वे सात हजार लिकड़े।<verse eid="1KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 20:16" />ये दोपहर नै लिकड़गे, उस बखत बेन्हदद अपणे मददगार बत्तीस राजयां सुधा डेरा म्ह शराब पी कै मतवाळा हो रह्या था। <verse eid="1KI 20:16" /><verse number="17" style="v" sid="1KI 20:17" />परदेसां के हाकिमां के सेवक पैहल्या लिकड़े। फेर बेन्हदद नै दूत भेज्जे, अर उननै उसतै कह्या, “सामरिया तै कुछ माणस लिकड़े आवैं सैं।” <verse eid="1KI 20:17" /><verse number="18" style="v" sid="1KI 20:18" />बेन्हदद नै हुक्म दिया, “चाए वे मेल करण नै लिकड़े हों, चाए लड़ण नै, फेर भी उननै जिन्दा ए पकड़ ल्याओ।” <verse eid="1KI 20:18" /><verse number="19" style="v" sid="1KI 20:19" />फेर परदेसां के हाकिमां के सेवक अर उनकै पाच्छै की सेना के सिपाही नगर तै लिकड़े। <verse eid="1KI 20:19" /><verse number="20" style="v" sid="1KI 20:20" />अर वे अपणे-अपणे स्याम्ही के दुश्मनां नै मारण लाग्गे; अर अरामी भाज्जे, अर इस्राएल नै उनका पिच्छा करया, अर अराम का राजा बेन्हदद, सवारां कै गैल घोड़े पै चढ़या, अर भाजकै बच ग्या। <verse eid="1KI 20:20" /><verse number="21" style="v" sid="1KI 20:21" />फेर इस्राएल के राजा नै भी लिकड़कै घोड़यां अर रथां ताहीं मारया, अर अरामियां ताहीं बड़ी मार तै मारया।<verse eid="1KI 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 20:22" />फेर उस नबी नै इस्राएल के राजा कै धोरै जाकै कह्या, “जाकै लड़ाई कै खात्तर अपणे ताहीं मजबूत कर, अर सचेत होकै सोच के, करणा के सै, क्यूँके नये साल के लाग्दे अराम का राजा फेर तेरे पै चढ़ाई करैगा।” <verse eid="1KI 20:22" /><verse number="23" style="v" sid="1KI 20:23" />फेर अराम के राजा के कर्मचारियाँ नै उसतै कह्या, “उन माणसां का देवता पहाड़ी देवता सै, इस करकै वे म्हारे पै हावी होए; ज्यांतै हम उनतै चौरस धरती पै लड़ां तो जरुर हम उनपै हावी हो जावांगे। <verse eid="1KI 20:23" /><verse number="24" style="v" sid="1KI 20:24" />अर यो भी काम कर, यानिके सारे राजयां का पद ले ले, अर उनकी जगहां पै सेनापतियाँ नै ठहरा दे। <verse eid="1KI 20:24" /><verse number="25" style="v" sid="1KI 20:25" />फेर एक और सेना जो तेरी उस सेना के बराबर हो जो नाश होगी सै, घोड़े के बदलै घोड़ा, अर रथ के बदलै रथ, अपणे खात्तर गिण ले; फेर हम चौरस धरती पै उनतै लड़ां, अर जरुर उनपै हावी हो जावांगे।” उनकी यो सम्मति मानकै बेन्हदद नै उसाए करया।<verse eid="1KI 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 20:26" />अर नये साल के लाग्दे बेन्हदद नै अरामियां ताहीं कठ्ठा करया, अर इस्राएल तै लड़ण खात्तर अपेक म्ह गया। <verse eid="1KI 20:26" /><verse number="27" style="v" sid="1KI 20:27" />अर इस्राएली भी कठ्ठे करये गए, अर उनके भोजन<note caller="+" style="f"><char style="fr" closed="false">20:27 </char><char style="fq" closed="false">भोजन </char><char style="ft" closed="false">राजा अहाब नै अपणे सिपाहियाँ ताहीं कठ्ठा करया अर जरूरत आळी चिज्जां दी </char></note> की त्यारी होई; फेर वे उनका सामना करण नै गए, अर इस्राएली उनकै स्याम्ही डेरे डालकै बकरियाँ के दो छोट्टे झुण्ड जिसे दिखाई पड़े, पर अरामियां तै देश भरग्या। <verse eid="1KI 20:27" /><verse number="28" style="v" sid="1KI 20:28" />फेर परमेसवर के उसे जन नै इस्राएल के राजा कै धोरै जाकै कह्या, “यहोवा न्यू कहवै सै, ‘अरामियां नै यो कह्या सै, के यहोवा पहाड़ी देवता सै, पर निच्‍ची धरती का न्ही सै; इस करकै मै उस बड़ी भीड़ नै तेरे हाथ म्ह कर दियुँगा, फेर थम जाण ल्योगे के मै यहोवा सूं।’” <verse eid="1KI 20:28" /><verse number="29" style="v" sid="1KI 20:29" />अर वे सात दिन आम्ही-स्याम्ही डेरे डाले पड़े रहे; फेर सातमै दिन युद्ध छिड़ ग्या; अर एक दिन म्ह इस्राएलियाँ नै एक लाख अरामी प्यादे मार गेरे। <verse eid="1KI 20:29" /><verse number="30" style="v" sid="1KI 20:30" />जो बचगे, वो अपेक म्ह भाजकै नगर म्ह घुसे, अर ओड़ै उन बचे होए माणसां म्ह तै सताईस हजार माणस शहरपनाह की दीवार कै गिरण तै दबकै मरगे। बेन्हदद भी भाज ग्या अर नगर की एक भीत्तरी कोठड़ी म्ह गया।<verse eid="1KI 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 20:31" />फेर उसके कर्मचारियाँ नै उसतै कह्या, “सुण, हमनै तो सुण्या सै, के इस्राएल के घरान्‍ने के राजा दयालु राजा होवै सैं, ज्यांतै हमनै कमर म्ह टाट अर सिर पै रस्सी बाँधे होए इस्राएल के राजा कै धोरै जाण दे, सम्भव सै के वो तेरा प्राण बचाले।” <verse eid="1KI 20:31" /><verse number="32" style="v" sid="1KI 20:32" />फेर वे कमर म्ह टाट अर सिर पै रस्सी बाँधकै इस्राएल के राजा कै धोरै जाकै कहण लाग्गे, “तेरा दास बेन्हदद तेरे तै कहवै सै, ‘दया करकै मन्‍नै जिन्दा रहण दे।’” राजा नै जवाब दिया, “के वो इब ताहीं जिन्दा सै? वो तो मेरा भाई सै।” <verse eid="1KI 20:32" /><verse number="33" style="v" sid="1KI 20:33" />उन माणसां नै इस ताहीं शुभ शकुन जाणकै, फुर्ती तै बूझ लेण का यत्न करया के यो उसके मन की बात सै के न्ही, अर कह्या, “हाँ तेरा भाई बेन्हदद।” राजा नै कह्या, “जाकै उसनै ले आओ।” फेर बेन्हदद उसकै धोरै लिकड़ आया, अर उसनै अपणे रथ पै चढ़ा लिया। <verse eid="1KI 20:33" /><verse number="34" style="v" sid="1KI 20:34" />फेर बेन्हदद नै उसतै कह्या, “जो नगर मेरे पिता नै तेरे पिता तै ले लिए थे, उननै मै मोड़ दियुँगा; अर जिस तरियां मेरे पिता नै सामरिया म्ह अपणे खात्तर बजार बणवाया, उसे तरियां ए तू दमिश्क म्ह सड़क बणवाईये।” अहाब नै कह्या, “मै इसे करार पै तन्‍नै छोड़ देऊँ सूं,” फेर उसनै बेन्हदद तै करार बाँधकै, उस ताहीं आजाद कर दिया। <verse eid="1KI 20:34" /><verse number="35" style="v" sid="1KI 20:35" />इसकै बाद नबियाँ के दल म्ह तै एक जन नै यहोवा तै वचन पाकै अपणे संगी तै हुक्म दिया, “मन्‍नै मार,” जिब उस माणस नै उस ताहीं मारण तै इन्कार करया, <verse eid="1KI 20:35" /><verse number="36" style="v" sid="1KI 20:36" />फेर पैहले नबी नै अपणे साथी तै कह्या, “तन्‍नै यहोवा का वचन न्ही मान्या, इस करकै सुण, जिब तू मेरै धोरै तै चल्या जावैगा, शेर तन्‍नै मार गेरैगा।” फेर जिब वो उसके धोरै तै चल्या गया, उसे बखत उसनै एक शेर मिल्या, अर शेर नै उस ताहीं मार गेरया। <verse eid="1KI 20:36" /><verse number="37" style="v" sid="1KI 20:37" />फेर उसनै दूसरा माणस मिल्या, अर उसतै भी उसनै कह्या, “मन्‍नै मार।” अर उसनै उस ताहीं इसा मारया के वो घायल होग्या। <verse eid="1KI 20:37" /><verse number="38" style="v" sid="1KI 20:38" />फेर वो नबी चल्या गया, अर आँखां नै पगड़ी तै ढक कै राजा की बाट देखदा होया राह म्ह खड्या रह्या। <verse eid="1KI 20:38" /><verse number="39" style="v" sid="1KI 20:39" />जिब राजा धोरै होकै जाण लाग रहया था, फेर उसनै उसकी दुहाई देकै कह्या, “जिब तेरा दास युद्ध क्षेत्र म्ह गया था फेर कोए माणस मेरी और मुड़कै किसे माणस नै मेरै धोरै ले आया, अर मेरै तै कह्या, ‘इस माणस की चौकसी कर; जै यो किसे तरियां छूट जावै, तो उसकी जान कै बदलै तन्‍नै अपणा प्राण देणा होवैगा; न्ही तो किक्‍कार<note caller="+" style="f"><char style="fr" closed="false">20:39 </char><char style="fq" closed="false">किक्‍कार </char><char style="ft" closed="false">लगभग 34 किलोग्राम चाँदी</char></note> भर चाँदी देणी पड़ैगी।’ <verse eid="1KI 20:39" /><verse number="40" style="v" sid="1KI 20:40" />उसकै बाद तेरा दास इधर-उधर काम म्ह फँस ग्या, फेर वो न्ही मिल्या।” इस्राएल के राजा नै उसतै उत्तर दिया, “तेरा इसाए न्याय होवैगा; तन्‍नै आप अपणा न्याय करया सै।” <verse eid="1KI 20:40" /><verse number="41" style="v" sid="1KI 20:41" />नबी नै झट अपणी आँखां तै पगड़ी ठाई, फेर इस्राएल के राजा नै उसतै पिछाण लिया, के वो कोए नबी सै। <verse eid="1KI 20:41" /><verse number="42" style="v" sid="1KI 20:42" />फेर नबी नै राजा तै कह्या, “यहोवा तेरे तै न्यू कहवै सै, ‘ज्यांतै के तन्‍नै अपणे हाथ तै इसे एक माणस ताहीं जाण दिया, जिस ताहीं मन्‍नै सत्यानाश हो जाण नै ठैहराया था, तन्‍नै उसकी जान कै बदलै अपणी जान अर उसकी प्रजा के बदलै, अपणी प्रजा देणी पड़ैगी।’” <verse eid="1KI 20:42" /><verse number="43" style="v" sid="1KI 20:43" />फेर इस्राएल का राजा उदास अर नाराज होकै घर की और चाल्या, अर सामरिया नगर म्ह आया।<verse eid="1KI 20:43" /></para>
  <chapter eid="1KI 20" />
  <chapter number="21" style="c" sid="1KI 21" />
  <para style="s">नाबोत की हत्या और परमेसवर का छो</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1" />इसके बाद नाबोत नाम के एक यिज्रेली की एक दाख की बारी सामरिया के राजा अहाब के राजभवन कै धोरै यिज्रेल म्ह थी। <verse eid="1KI 21:1" /><verse number="2" style="v" sid="1KI 21:2" />इन बात्तां कै बाद कुछ दिनां कै बाद अहाब नै नाबोत तै कह्या, “तेरी दाख की बारी मेरे घर कै धोरै सै, तू उसनै मन्‍नै दे के मै उस म्ह साग-पात की बारी लगाऊँ; अर मै उसके बदलै म्ह तन्‍नै उसतै आच्छी एक वाटिका दियुँगा, न्ही तो तेरी इच्छा हो तो मै तन्‍नै उसकी कीमत दे दियुँगा।” <verse eid="1KI 21:2" /><verse number="3" style="v" sid="1KI 21:3" />नाबोत नै अहाब तै कह्या, “यहोवा ना करै के मै अपणे पुरखां का निज हिस्सा तन्‍नै दियुँ!” <verse eid="1KI 21:3" /><verse number="4" style="v" sid="1KI 21:4" />यिज्रेल नाबोत के इस वचन कै कारण “मै तन्‍नै अपणे पुरखां का निज हिस्सा न्ही दियुँगा,” अहाब उदास अर नाराज होकै अपणे घर गया, अर बिछोणे पै लेट ग्या अर मुँह फेर लिया, अर किमे न्ही खाया।<verse eid="1KI 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 21:5" />फेर उसकी पत्नी ईजेबेल नै उसकै धोरै आकै पूच्छया, “तेरा मन क्यूँ इसा उदास सै के तू कुछ खान्दा न्ही?” <verse eid="1KI 21:5" /><verse number="6" style="v" sid="1KI 21:6" />उसनै कह्या, “कारण यो सै, के मन्‍नै यिज्रेली नाबोत तै कह्या ‘रुपया लेकै मन्‍नै अपणी दाख की बारी दे, न्ही तो जै तू चावै तो मै उसकै बदलै दुसरी दाख की बारी दियुँगा’; अर उसनै कह्या, ‘मै अपणी दाख की बारी तन्‍नै न्ही दियुँगा।’” <verse eid="1KI 21:6" /><verse number="7" style="v" sid="1KI 21:7" />उसकी पत्नी ईजेबेल नै उसतै कह्या, “तू इस्राएल पै राज करै सै के न्ही? उठकै खाणा खा; अर तेरा मन आनन्दित हो; यिज्रेली नाबोत की दाख की बारी मै तन्‍नै दीवा दियुँगी।”<verse eid="1KI 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8" />फेर उसनै अहाब कै नाम तै चिट्ठी लिखकै उसकी अंगूठी की छाप लगाकै, उन पुरनियां अर रईसां कै धोरै भेज दी जो उसे नगर म्ह नाबोत के पड़ोस म्ह रहवैं थे। <verse eid="1KI 21:8" /><verse number="9" style="v" sid="1KI 21:9" />उस चिट्ठी म्ह उसनै यो लिख्या, “लोगां नै कठ्ठा करो, अर नाबोत नै माणसां कै स्याम्ही ऊँच्‍ची जगहां पै बिठाणा। <verse eid="1KI 21:9" /><verse number="10" style="v" sid="1KI 21:10" />फेर दो नीच माणसां नै उसकै स्याम्ही बिठाणा जो साक्षी देकै उसतै कहवै, ‘तन्‍नै परमेसवर अर राजा दोन्‍नु की निन्‍दा करी।’ फेर थम उसनै बाहर ले जाकै उसपै पथराव करियो, के वो मर जावै।” <verse eid="1KI 21:10" /><verse number="11" style="v" sid="1KI 21:11" />ईजेबेल की चिट्ठी म्ह के हुकम कै मुताबिक नगर म्ह रहणआळे पुरनियां अर रईसां नै उपवास का प्रचार करया, <verse eid="1KI 21:11" /><verse number="12" style="v" sid="1KI 21:12" />अर नाबोत ताहीं माणसां कै स्याम्ही उपवास खात्तर ऊँच्‍ची जगहां पै बिठाया। <verse eid="1KI 21:12" /><verse number="13" style="v" sid="1KI 21:13" />फेर दो नीच माणस आकै उसकै स्याम्ही बैठगे; अर उन नीच माणसां नै माणसां कै स्याम्ही नाबोत कै खिलाफ या गवाई दी, “नाबोत नै परमेसवर अर राजा दोन्‍नु की निन्‍दा करी।” इसपै उननै उस ताहीं नगर<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false">यिज्रेल का शहर</char></note> तै बाहर ले जाकै उसपै पथराव करया, अर वो मर ग्या। <verse eid="1KI 21:13" /><verse number="14" style="v" sid="1KI 21:14" />फेर उननै ईजेबेल कै धोरै यो सन्देसा भेज्या के नाबोत पथराव करकै मारया गया सै।<verse eid="1KI 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 21:15" />यो सुणदे के नाबोत पथराव करकै मार गेरया गया सै, ईजेबेल नै अहाब तै कह्या, “उठकै यिज्रेली नाबोत की दाख की बारी नै जिसतै उसनै तेरे ताहीं रुपया लेकै देण तै भी इन्कार करया था अपणे हक म्ह ले, क्यूँके नाबोत जिन्दा न्ही पर वो मर ग्या सै।” <verse eid="1KI 21:15" /><verse number="16" style="v" sid="1KI 21:16" />यिज्रेली नाबोत की मौत की खबर पान्दे अहाब उसकी दाख की बारी अपणे हक म्ह लेण खात्तर ओड़ै जाण नै उठ खड्या होया।<verse eid="1KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 21:17" />फेर यहोवा का यो वचन तिशबी कै नगर एलिय्याह कै धोरै पोहच्या, <verse eid="1KI 21:17" /><verse number="18" style="v" sid="1KI 21:18" />“चाल, सामरिया म्ह रहणआळे इस्राएल के राजा अहाब तै मिलण नै जा; वो तो नाबोत की दाख की बारी म्ह सै, उसनै अपणे हक म्ह लेण नै वो ओड़ै गया सै। <verse eid="1KI 21:18" /><verse number="19" style="v" sid="1KI 21:19" />अर उसनै न्यू कहिये, के यहोवा न्यू कहवै सै, ‘के तन्‍नै घात करया, अर अधिकारी भी बण बैठ्या?’ फेर तू उसतै न्यू भी कहिये, के यहोवा न्यू कहवै सै, ‘जिस जगहां पै कुत्याँ नै नाबोत का लहू चाट्या, उसे जगहां पै कुत्ते तेरा भी लहू चाटैंगे।’”<verse eid="1KI 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 21:20" />एलिय्याह तै देखकै अहाब नै कह्या, “हे मेरे दुश्मन! के तन्‍नै मेरा बेरा लगाया सै?” उसनै कह्या, “हाँ, लाग्या तो सै; अर इसका कारण यो सै, के जो यहोवा की नजर म्ह बुरा सै, उसनै करण कै खात्तर तन्‍नै अपणे ताहीं बेच दिया सै। <verse eid="1KI 21:20" /><verse number="21" style="v" sid="1KI 21:21" />इस खात्तर मै तेरे पै इसी विपत्ति गेरुगां, के तन्‍नै पूरी तरियां तै मिटा दियुँगा; अर तेरे घर के एक-एक छोरे नै अर के कैदी, के आजाद इस्राएल म्ह हर एक रहणआळे नै भी नाश कर दियुँगा। <verse eid="1KI 21:21" /><verse number="22" style="v" sid="1KI 21:22" />अर मै तेरा घरान्‍नां नबात के बेट्टे यारोबाम, अर अहिय्याह के बेट्टे बाशा का जिसा कर दियुँगा; ज्यांतै के तन्‍नै मेरै ताहीं क्रोधित करया सै, अर इस्राएल पै तै पाप करवाया सै। <verse eid="1KI 21:22" /><verse number="23" style="v" sid="1KI 21:23" />अर ईजेबेल कै बारै म्ह यहोवा न्यू कहवै सै, ‘यिज्रेल के किले कै धोरै कुत्ते ईजेबेल नै खा लेगें।’ <verse eid="1KI 21:23" /><verse number="24" style="v" sid="1KI 21:24" />अहाब का जो कोए नगर म्ह मर ज्यागा उसनै कुत्ते खा लेगें; अर जो कोए मैदान म्ह मर ज्यागा उसनै अकास के पंछी खा जावैंगे।”<verse eid="1KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 21:25" />सचमुच अहाब की तरियां और कोए ना था जिसनै अपणी पत्नी ईजेबेल के उकसाण पै वो काम करण ताहीं जो यहोवा की नजर म्ह बुरा सै, अपणे ताहीं बेच दिया था। <verse eid="1KI 21:25" /><verse number="26" style="v" sid="1KI 21:26" />वो तो उन एमोरियां की तरियां जिन ताहीं यहोवा नै इस्राएलियाँ कै स्याम्ही देश तै लिकाड्या था घणे घिनोणे काम करै था, यानिके मूरतां की उपासना करण लाग्या था।<verse eid="1KI 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 21:27" />एलिय्याह के ये वचन सुणकै अहाब नै अपणे कपड़े पाड़े, अर अपणी देह पै टाट लपेटकै उपवास करण अर टाट ओढ़े पड्या रहण लाग्या, अर दबे पाँयां चालण लाग्या। <verse eid="1KI 21:27" /><verse number="28" style="v" sid="1KI 21:28" />अर यहोवा का यो वचन तिशबी एलिय्याह कै धोरै पोहच्या, <verse eid="1KI 21:28" /><verse number="29" style="v" sid="1KI 21:29" />“के तन्‍नै देख्या सै अहाब मेरै स्याम्ही नम्र बणग्या सै? इस कारण के वो मेरै स्याम्ही नम्र बणग्या सै मै वा विपत्ति उसके जिन्दे जी उसपै न्ही गेरुगां पर उसके बेट्टे के दिनां म्ह मै उसके घरान्‍ने पै वा विपत्ति भेज्जूँगा।”<verse eid="1KI 21:29" /></para>
  <chapter eid="1KI 21" />
  <chapter number="22" style="c" sid="1KI 22" />
  <para style="s">अहाब की मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1" />तीन साल ताहीं अरामी अर इस्राएली बिना युद्ध के रहे। <verse eid="1KI 22:1" /><verse number="2" style="v" sid="1KI 22:2" />तीसरे साल म्ह यहूदा का राजा यहोशापात इस्राएल के राजा कै धोरै गया। <verse eid="1KI 22:2" /><verse number="3" style="v" sid="1KI 22:3" />फेर इस्राएल के राजा नै अपणे कर्मचारियाँ तै कह्या, “के थमनै बेरा सै, के गिलाद का रामोत म्हारा सै? फेर हम क्यूँ चुपचाप रहवां अर उसनै अराम के राजा कै हाथ तै क्यूँ न्ही खोस लेन्दे?” <verse eid="1KI 22:3" /><verse number="4" style="v" sid="1KI 22:4" />अर उसनै यहोशापात तै पूच्छया, “के तू मेरै गैल गिलाद के रामोत तै लड़ण खात्तर जावैगा?” यहोशापात नै इस्राएल के राजा ताहीं जवाब दिया, “जिसा तू सै उसा मै भी सूं। जिसी तेरी प्रजा सै उसीए मेरी भी प्रजा सै, अर जिसे तेरे घोड़े सैं उसेए मेरे भी घोड़े सैं।”<verse eid="1KI 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 22:5" />फेर यहोशापात नै इस्राएल के राजा तै कह्या, “आज यहोवा की इच्छा पता कर ल्यां।” <verse eid="1KI 22:5" /><verse number="6" style="v" sid="1KI 22:6" />फेर इस्राएल के राजा नै नबियाँ ताहीं जो कोए च्यार सौ माणस थे कठ्ठा करकै उनतै पूच्छया, “के मै गिलाद के रामोत तै युद्ध करण कै खात्तर चढ़ाई करुँ, या रुक्या रहूँ?” उननै जवाब दिया, “चढ़ाई कर: क्यूँके प्रभु उसनै राजा कै हाथ म्ह कर देगा।” <verse eid="1KI 22:6" /><verse number="7" style="v" sid="1KI 22:7" />पर यहोशापात नै पूच्छया, “के उरै यहोवा का भी और कोए नबी न्ही सै जिसतै हम पूछ ल्यां?” <verse eid="1KI 22:7" /><verse number="8" style="v" sid="1KI 22:8" />इस्राएल के राजा नै यहोशापात तै कह्या, “हाँ, यिम्ला का बेट्टा मीकायाह एक माणस और सै जिसके जरिये हम यहोवा तै पूछ सकां सां? पर मै उसतै नफरत करुँ सूं, क्यूँके वो मेरै बारै म्ह कल्याण की न्ही बलके नुकसान की ए भविष्यवाणी करै सै।” <verse eid="1KI 22:8" /><verse number="9" style="v" sid="1KI 22:9" />यहोशापात नै कह्या, “राजा इसा ना कहवै।” फेर इस्राएल के राजा नै एक हाकिम ताहीं बुलवाकै कह्या, “यिम्ला के बेट्टे मीकायाह नै फुर्ती तै ले आ।” <verse eid="1KI 22:9" /><verse number="10" style="v" sid="1KI 22:10" />इस्राएल का राजा अर यहूदा का राजा यहोशापात, अपणे-अपणे राजवस्त्र पहरे होए सामरिया के फाटक म्ह एक खुल्‍ली जगहां म्ह अपणे-अपणे सिंहासन पै बैठ्ठै थे अर सारे नबी उनकै स्याम्ही भविष्यवाणी करैं थे। <verse eid="1KI 22:10" /><verse number="11" style="v" sid="1KI 22:11" />फेर कनाना के बेट्टे सिदकिय्याह नै लोहे के सींग बणाकै कह्या, “यहोवा न्यू कहवै सै, ‘इनतै तू अरामियां ताहीं मारदे-मारदे नाश कर देगा।’” <verse eid="1KI 22:11" /><verse number="12" style="v" sid="1KI 22:12" />अर सारे नबियाँ नै इसे तरियां की भविष्यवाणी करकै कह्या, “गिलाद के रामोत पै चढ़ाई कर अर तू विजय हो; क्यूँके यहोवा उसनै राजा कै हाथ म्ह कर देगा।”<verse eid="1KI 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 22:13" />अर जो दूत मीकायाह ताहीं बुलाण गया था उसनै उसतै कह्या, “सुण, नबी एके मुँह तै राजा कै बारै म्ह शुभ वचन कहवैं सैं तो तेरी बात उन म्ह तै एक नबी की बात जिसी हों; तू भी शुभ वचन कहिये।” <verse eid="1KI 22:13" /><verse number="14" style="v" sid="1KI 22:14" />मीकायाह नै कह्या, “यहोवा के जीवन की कसम जो कुछ यहोवा मेरै ताहीं कहवै, वोए मै कहूँगा।” <verse eid="1KI 22:14" /><verse number="15" style="v" sid="1KI 22:15" />जिब वो राजा कै धोरै आया, फेर राजा नै उसतै पूछ्या, “हे मीकायाह! के हम गिलाद के रामोत तै युद्ध करण कै खात्तर चढ़ाई करां या रुके रहवां?” उसनै उस ताहीं जवाब दिया, “हाँ, चढ़ाई कर अर तू विजय हो; अर यहोवा उसनै राजा कै हाथ म्ह कर दे।” <verse eid="1KI 22:15" /><verse number="16" style="v" sid="1KI 22:16" />राजा नै उसतै कह्या, “मन्‍नै कितनी बार तेरे ताहीं कसम धरा कै चिताणा होवैगा, के तू यहोवा नै याद करकै मेरै ताहीं सच कह।” <verse eid="1KI 22:16" /><verse number="17" style="v" sid="1KI 22:17" />मीकायाह नै कह्या, “मन्‍नै सारा इस्राएल बिना पाळी की भेड़-बकरियाँ की तरियां पहाड़ां पै; तित्तर-बितर दिखाई पड्या, अर यहोवा का यो वचन आया, ‘उनका कोए पाळी न्ही सैं; आखर वे अपणे-अपणे घर सही-सलामत बोहड़ जावैं।<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">मत्ती 9:36, मरकुस 6:34</char></note>’” <verse eid="1KI 22:17" /><verse number="18" style="v" sid="1KI 22:18" />फेर इस्राएल के राजा नै यहोशापात तै कह्या, “के मन्‍नै तेरै ताहीं न्ही कह्या था, के वो मेरै बारै म्ह कल्याण की न्ही नुकसान की भविष्यवाणी करैगा।” <verse eid="1KI 22:18" /><verse number="19" style="v" sid="1KI 22:19" />फेर मीकायाह नै कह्या, “इस कारण तू यहोवा का यो वचन सुण! मन्‍नै सिंहासन पै विराजमान यहोवा अर उसकै धोरै ओळी-सोळी खड़ी होई सुर्ग की सारी सेना दिखाई दी सै।<note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="ft" closed="false">प्रकाशितवाक्य 4:2, 4:9-10, 5:1, 7:13, 6:16, 7:10, 7:15, 19:4, 21:5</char></note> <verse eid="1KI 22:19" /><verse number="20" style="v" sid="1KI 22:20" />फेर यहोवा नै पूच्छया, ‘अहाब नै कौण इसा बहकावैगा, के वो गिलाद के रामोत पै चढ़ाई करण आवै अर वो मारया जावै?’ फेर किसे नै कुछ, अर किसे नै कुछ कह्या। <verse eid="1KI 22:20" /><verse number="21" style="v" sid="1KI 22:21" />आखर म्ह एक आत्मा धोरै आकै यहोवा कै स्याम्ही खड़ी होई, अर कहण लाग्गी, ‘मै उसनै बहकाऊँगी’ यहोवा नै पूच्छया, ‘किस तरियां तै?’ <verse eid="1KI 22:21" /><verse number="22" style="v" sid="1KI 22:22" />उसनै उत्तर दिया, ‘मै जाकै उसके सारे नबियाँ म्ह समाकै उनतै झूठ बुलवाऊँगी।’ यहोवा नै कह्या, ‘तेरा उस ताहीं बहकाणा सफल होवैगा, जाकै इसाए कर।’ <verse eid="1KI 22:22" /><verse number="23" style="v" sid="1KI 22:23" />तो इब सुण यहोवा नै तेरे इन सारे नबियाँ कै मुँह म्ह एक झूठ बोलण आळी आत्मा बिठाई सै, अर यहोवा नै तेरै बारै म्ह नुकसान की बात कही सै।”<verse eid="1KI 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 22:24" />फेर कनाना के बेट्टे सिदकिय्याह नै मीकायाह कै धोरै जा, उसकै गाल पै थप्पड़ मारकै पूच्छया, “यहोवा का आत्मा मन्‍नै छोड़कै तेरे तै बात करण नै कड़ै गया?” <verse eid="1KI 22:24" /><verse number="25" style="v" sid="1KI 22:25" />मीकायाह नै कह्या, “जिस दिन तू छिपण कै खात्तर कोठड़ी तै कोठड़ी म्ह भाज्जैगा, फेर तन्‍नै बेरा पाट्टैगा।” <verse eid="1KI 22:25" /><verse number="26" style="v" sid="1KI 22:26" />फेर इस्राएल के राजा नै कह्या, “मीकायाह नै नगर के हाकिम आमोन अर योआश राजकुमार कै धोरै ले जा; <verse eid="1KI 22:26" /><verse number="27" style="v" sid="1KI 22:27" />अर उनतै कह, ‘राजा न्यू कहवै सै, के इसनै जेळ म्ह गेरो, अर जिब ताहीं मै सही-सलामत ना आऊँ, तब ताहीं इसनै दुख की रोट्टी अर पाणी दिया करो।’” <verse eid="1KI 22:27" /><verse number="28" style="v" sid="1KI 22:28" />अर मीकायाह नै कह्या, “जै तू कदे सही-सलामत बोहड़ै, तो जाण लिए के यहोवा नै मेरे जरिये न्ही कह्या।” फेर उसनै कह्या, “हे माणसों थम सारे के सारे सुण ल्यो।” <verse eid="1KI 22:28" /><verse number="29" style="v" sid="1KI 22:29" />फेर इस्राएल के राजा अर यहूदा के राजा यहोशापात दोनुआ नै गिलाद के रामोत पै चढ़ाई करी। <verse eid="1KI 22:29" /><verse number="30" style="v" sid="1KI 22:30" />अर इस्राएल के राजा नै यहोशापात तै कह्या, “मै तो भेष बदलकै रणभूमि म्ह जाऊँगा, पर तू अपणे ए कपड़े पैहरे रहिये।” फेर इस्राएल का राजा भेष बदलकै युद्ध भूमि म्ह गया। <verse eid="1KI 22:30" /><verse number="31" style="v" sid="1KI 22:31" />अराम के राजा नै तो अपणे रथां के बत्तीस प्रधानां ताहीं हुकम दिया था, “ना तो छोट्टे तै लड़ो अर ना बड़े तै, सिर्फ इस्राएल के राजा तै युद्ध करो।” <verse eid="1KI 22:31" /><verse number="32" style="v" sid="1KI 22:32" />आखर जिब रथां के प्रधानां नै यहोशापात ताहीं देख्या, फेर कह्या, “जरुर इस्राएल का राजा वोए सै।” अर वे उस्से तै युद्ध करण नै मुड़े; फेर यहोशापात चिल्‍ला उठ्या। <verse eid="1KI 22:32" /><verse number="33" style="v" sid="1KI 22:33" />यो देखकै के वो इस्राएल का राजा न्ही सै, रथां के प्रधान उसका पिच्छा छोड़कै बोहड़गे। <verse eid="1KI 22:33" /><verse number="34" style="v" sid="1KI 22:34" />फेर किसे नै अटकळ तै एक तीर चलाया अर वो इस्राएल के राजा के झिलम अर निचले कपड़यां कै बीच म्ह धस ग्या; फेर उसनै अपणे सारथी तै कह्या, “मै घायल होग्या सूं ज्यांतै रथ मोड़कै मन्‍नै सेना म्ह तै बाहर लिकाड़ ले चाल।”<verse eid="1KI 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 22:35" />अर उस दिन युद्ध बढ़दा गया अर राजा अहाब अपणे रथ म्ह औरां कै भरोसै अरामियां कै स्याम्ही खड्या रह्या, अर साँझ तक मर ग्या; अर उसके घाव का लहू बहकै रथ के पायदान म्ह भरग्या। <verse eid="1KI 22:35" /><verse number="36" style="v" sid="1KI 22:36" />सूरज डूबदे होए सेना म्ह या पुकार होई, “हर एक अपणे नगर अर अपणे देश नै बोहड़ जावैं।” <verse eid="1KI 22:36" /><verse number="37" style="v" sid="1KI 22:37" />जिब राजा मर ग्या, फेर सामरिया ताहीं पोहचाया गया अर सामरिया म्ह उस ताहीं माट्टी दी गई। <verse eid="1KI 22:37" /><verse number="38" style="v" sid="1KI 22:38" />अर यहोवा के वचन कै मुताबिक जिब उसका रथ सामरिया के जलकुण्ड म्ह धोया गया, फेर कुत्याँ नै उसका लहू चाट लिया, अर वेश्या उरैए स्नान करैं थी। <verse eid="1KI 22:38" /><verse number="39" style="v" sid="1KI 22:39" />अहाब के और सारे काम जो उसनै करे, अर हाथी दाँत का जो भवन उसनै बणाया, अर जो-जो नगर उसनै बसाए थे, यो सारा इस्राएली राजयां कै इतिहास की किताब म्ह लिख्या सै। <verse eid="1KI 22:39" /><verse number="40" style="v" sid="1KI 22:40" />आखर अहाब मरकै अपणे पुरखां कै गैल जा मिल्या अर उसका बेट्टा अहज्याह उसकी जगहां पै राज करण लाग्या।<verse eid="1KI 22:40" /></para>
  <para style="s">यहोशापात का राज</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41" />इस्राएल के राजा अहाब के राज्य के चौथे साल म्ह आसा का बेट्टा यहोशापात यहूदा पै राज करण लाग्या। <verse eid="1KI 22:41" /><verse number="42" style="v" sid="1KI 22:42" />जिब यहोशापात राज करण लाग्या, तब वो पैंतीस साल का था अर पच्‍चीस साल ताहीं यरुशलेम म्ह राज करदा रह्या। अर उसकी माँ का नाम अजूबा था, जो शिल्ही की बेट्टी थी। <verse eid="1KI 22:42" /><verse number="43" style="v" sid="1KI 22:43" />अर उसकी चाल सारी तरियां तै उसके पिता आसा की जिसी थी, यानिके जो यहोवा की नजर म्ह ठीक सै वोए वो करदा रह्या, अर उसतै बिलकुल ना मुड़या। फेर भी ऊँच्‍ची जगहां गिराई न्ही गई, तोभी प्रजा के माणस ऊँच्‍ची जगहां पै उस बखत भी बलि करया करैं थे अर धूप भी जळाया करैं थे। <verse eid="1KI 22:43" /><verse number="44" style="v" sid="1KI 22:44" />यहोशापात नै इस्राएल के राजा तै मेल करया। <verse eid="1KI 22:44" /><verse number="45" style="v" sid="1KI 22:45" />यहोशापात के काम अर जो वीरता उसनै दिखाई, अर उसनै जो-जो लड़ाई करी, या सारी यहूदा के राजयां कै इतिहास की किताब म्ह लिखी सै। <verse eid="1KI 22:45" /><verse number="46" style="v" sid="1KI 22:46" />पुरुषगामियां म्ह तै जो उसके पिता आसा के दिनां म्ह रहगे थे, उन ताहीं उसनै देश म्ह तै नाश करया।<verse eid="1KI 22:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1KI 22:47" />उस बखत एदोम म्ह कोए राजा ना था; एक नायब राजकाज का काम करै था। <verse eid="1KI 22:47" /><verse number="48" style="v" sid="1KI 22:48" />फेर यहोशापात नै तर्शीश के जहाज सोन्‍ना ल्याण कै खात्तर ओपीर के देश ताहीं जाण खात्तर बणवा लिए, पर वे एस्योनगेबेर<note caller="+" style="f"><char style="fr" closed="false">22:48 </char><char style="ft" closed="false">बंदरगाह वाला शहर</char></note> म्ह टूटगे, ज्यांतै ओड़ै ना जा सके। <verse eid="1KI 22:48" /><verse number="49" style="v" sid="1KI 22:49" />फेर अहाब के बेट्टे अहज्याह नै यहोशापात तै कह्या, “मेरे जहाजियां नै अपणे जहाजियां कै गैल, जहाजां म्ह जाण दे;” पर यहोशापात नै इन्कार करया। <verse eid="1KI 22:49" /><verse number="50" style="v" sid="1KI 22:50" />यहोशापात मरकै अपणे पुरखां कै गैल जा मिल्या अर उसनै उसके पुरखां कै गैल उसके मूलपुरुष दाऊद के नगर म्ह माट्टी दी गई। अर उसका बेट्टा यहोराम उसकी जगहां पै राज करण लाग्या।<verse eid="1KI 22:50" /></para>
  <para style="s">अहज्याह का राज</para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 22:51" />यहूदा के राजा यहोशापात के राज्य के सत्रहवें साल म्ह अहाब का बेट्टा अहज्याह सामरिया म्ह इस्राएल पै राज करण लाग्या अर दो साल ताहीं इस्राएल पै राज करदा रह्या। <verse eid="1KI 22:51" /><verse number="52" style="v" sid="1KI 22:52" />अर उसनै वो करया, जो यहोवा की नजर म्ह बुरा था। अर उसकी चाल उसके माँ-बाप, अर नबात के बेट्टे यारोबाम की जिसी थी जिसनै इस्राएल पै तै पाप करवाया था। <verse eid="1KI 22:52" /><verse number="53" style="v" sid="1KI 22:53" />जिस तरियां उसका पिता बाल की उपासना अर उसनै दण्डवत करण तै इस्राएल के परमेसवर यहोवा ताहीं क्रोधित करदा रह्या उसे तरियां ए अहज्याह भी करदा रह्या।<verse eid="1KI 22:53" /></para>
  <chapter eid="1KI 22" />
</usx>