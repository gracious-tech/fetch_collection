  <para style="h">नीतिवचन</para>
  <para style="toc1">नीतिवचन की किताब</para>
  <para style="toc2">नीतिवचन</para>
  <para style="toc3">नीति.</para>
  <para style="mt">नीतिवचन की किताब</para>
  <para style="is">लेखक</para>
  <para style="ip">राजा सुलैमान नीतिवचनां का प्रमुख लेखक था। <char style="xt"><ref loc="PRO 1:1">1:1</ref>;</char> <char style="xt"><ref loc="PRO 10:1">10:1</ref>,</char> <char style="xt"><ref loc="PRO 25:1">25:1</ref></char> म्ह सुलैमान का नाम जाहिर सै। और कई योगदान देण आळां म्ह तै एक समूह जो “बुद्धिमान” कुहवावै था, आगूर अर राजा लमूएल सै। बाकी बाइबल के सदृश्य नीतिवचन परमेसवर के उद्धार की योजना की और इशारा करै सै, पर हो सकै सै घणी बारीकी तै। इस किताब नै इस्राएलियाँ ताहीं परमेसवर के राह पै चाल्‍लण का सही तरीका दिखाया। यो सम्भव सै के परमेसवर नै सुलैमान ताहीं प्रेरित करया के वो उन बुद्धिमानी के वचनां के आधार पै इसका संकलन करे जो उसनै अपणे सम्पूर्ण जीवन म्ह सीखे थे।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">तकरीबन 971 - 686 ई. पू.</para>
  <para style="ip">सुलैमान राजा के राज्यकाल म्ह इस्राएल म्ह, नीतिवचन हजारां साल पैहले लिखे गए थे। इसकी बुद्धिमानी की बातें किसे भी संस्कृति म्ह किसे भी बखत व्यवहार्य सै।</para>
  <para style="is">प्रापक</para>
  <para style="ip">नीतिवचन के अनेक सुणण आळें सै। या बाळकां का निर्देशन कर सकै उनके माँ-बाप खात्तर सै। बुद्धि के खोजी जवान-युवती खात्तर भी सै अर अन्त म्ह या आज के बाइबल पाठकां खात्तर, जो ईश्वर-भक्ति का जीवन जीणा चाहवै सै, व्यावहारिक सलाह सै।</para>
  <para style="is">मकसद</para>
  <para style="ip">नीतिवचनां की किताब म्ह सुलैमान ऊँच्‍चे एवं श्रेष्ठ अर साधारण एवं सामान्य दैनिक जीवन म्ह परमेसवर की सम्मति नै जाहिर करै सै। इसा लाग्गै सै के सुलैमान राजा के अवलोकन म्ह कोए विषय बचाए न्ही। व्यक्तिगत सम्बन्ध, यौन सम्बन्ध, व्यापार, धन-सम्पदा, दान, लालसा, अनुशासन, कर्ज, लालन-पालन, चरित्र, शराब पीणा, राजनीति, बदला लेणा अर ईश्वर-भक्ति आदि अनेक विषय बुद्धिमानी की बात्तां पै इस विपुल संग्रह म्ह विचार करया ग्या सै।</para>
  <para style="is">खास बातें</para>
  <para style="ip">बुद्धि</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. बुद्धि के सद्गुण <char style="ior"><ref loc="PRO 1:1-9:18">1:1-9:18</ref></char></para>
  <para style="io1">2. सुलैमान के नीतिवचन <char style="ior"><ref loc="PRO 10:1-22:16">10:1-22:16</ref></char></para>
  <para style="io1">3. बुद्धिमानां के वचन <char style="ior"><ref loc="PRO 22:17-29:27">22:17-29:27</ref></char></para>
  <para style="io1">4. आगूर के वचन <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref> </char></para>
  <para style="io1">5. लमूएल के वचन <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref></char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">बुद्धि की शरुआत</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />दाऊद के बेट्टे इस्राएल के राजा सुलैमान के नीतिवचन<verse eid="PRO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2" />इन नीतिवचनां के जरिये पढ़ण आळा बुद्धि अर शिक्षा पावै,</para>
  <para style="q" vid="PRO 1:2">अर समझण की बात समझै,<verse eid="PRO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3" />अर बुद्धिमान तै जिन्दगी बिताण म्ह माहिरता,</para>
  <para style="q" vid="PRO 1:3">अर धर्म, न्याय अर सिधाई के बारै म्ह अनुशासन पावै;<verse eid="PRO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4" />ताके भोळां नै चतुराई,</para>
  <para style="q" vid="PRO 1:4">अर जवान नै ज्ञान अर विवेक मिलै;<verse eid="PRO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5" />ताके बुद्धिमान सुणकै अपणी विद्या बढ़ावै,</para>
  <para style="q" vid="PRO 1:5">अर समझदार बुद्धि का उपदेश पावै,<verse eid="PRO 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6" />जिसतै वे नीतिवचन अर उदाहरण की बात्तां नै,</para>
  <para style="q" vid="PRO 1:6">अर बुद्धिमानां के वचन अर उनके भेदां नै समझै।<verse eid="PRO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7" />यहोवा का भय मानणा बुद्धि की शरुआत सै,</para>
  <para style="q" vid="PRO 1:7">बुद्धि अर शिक्षा नै मूर्ख माणस ए तुच्छ जाणै सै,<verse eid="PRO 1:7" /></para>
  <para style="s">दुष्ट सलाह तै बचणा</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8" />हे मेरे बेट्टे, अपणे पिता की शिक्षा पै कान लगा,</para>
  <para style="q" vid="PRO 1:8">अर अपणी माँ की शिक्षा नै ना भूल्‍लै;<verse eid="PRO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9" />क्यूँके वे मान्‍नो तेरे खात्तर सिर पै सजण आळा मुकुट,</para>
  <para style="q" vid="PRO 1:9">अर तेरे गळे का हार होवैंगी।<verse eid="PRO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10" />हे मेरे बेट्टे, जै पापी माणस तन्‍नै भकावै,</para>
  <para style="q" vid="PRO 1:10">तो उनकी बात ना मानिये।<verse eid="PRO 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11" />जै वे कहवै, “म्हारे गैल चाल,</para>
  <para style="q" vid="PRO 1:11">ताके हम मारण खात्तर दा लगावां, अर हम बेकसूरां पै हमला करां;<verse eid="PRO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12" />हम उननै जिन्दे ए निगळ जावां, जिस तरियां अधोलोक भले-चंगे माणसां नै भी निगळ जावै सै,</para>
  <para style="q" vid="PRO 1:12">अर उन ताहीं कब्र म्ह पड़े मरे होया की तरियां बणा दे।<verse eid="PRO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13" />हमनै सारी ढाळ की बेसकिमती चीज मिलैगी,</para>
  <para style="q" vid="PRO 1:13">हम अपणे घरां नै लूट तै भर लेवांगे;<verse eid="PRO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14" />तू म्हारा साझी हो जा,</para>
  <para style="q" vid="PRO 1:14">अपणे सारया का एक ए साझा हो,”<verse eid="PRO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15" />तो, हे मेरे बेट्टे, उनकै गैल राह म्ह ना चालिए,</para>
  <para style="q" vid="PRO 1:15">बल्के उनकी राह म्ह पैर भी ना धरिये;<verse eid="PRO 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16" />क्यूँके वे बुराई करण नै भाज्जै सै,</para>
  <para style="q" vid="PRO 1:16">अर मारण म्ह तावळ करै सै।<verse eid="PRO 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17" />क्यूँके पंछी के देखदे होए जाळ बिछाणा फजूल होवै सै;<verse eid="PRO 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18" />अर ये माणस तो अपणा ए खून करण की बाट म्ह बैठ्ठे सै,</para>
  <para style="q" vid="PRO 1:18">अर खुद का ए खून करण की ताक म्ह रहवै सै।<verse eid="PRO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19" />सारे लालचियाँ की चाल इसीए हो सै;</para>
  <para style="q" vid="PRO 1:19">उनकी जान लालच कै कारण ए जावै सै।<verse eid="PRO 1:19" /></para>
  <para style="s">ज्ञान की पुकार</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20" />बुद्धि सड़क पै ऊँच्‍ची आवाज म्ह बोल्‍लै सै;</para>
  <para style="q" vid="PRO 1:20">अर चौकां म्ह प्रचार करै सै।<verse eid="PRO 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21" />वा बजारां की भीड़ म्ह पुकारै सै,</para>
  <para style="q" vid="PRO 1:21">वा नगर के फाटकां के देह्ली पै खड़ी होकै, न्यू बोल्‍लै सै,<verse eid="PRO 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22" />“हे अज्ञानियों, थम कद ताहीं अज्ञानता तै मोह राक्खोगे?</para>
  <para style="q" vid="PRO 1:22">अर हे मखौल करण आळो, थम कद ताहीं मखौल करण तै राज्जी रहोगे?</para>
  <para style="q" vid="PRO 1:22">हे मूर्खो, थम कद तक ज्ञान तै बैर राक्खोगे?<verse eid="PRO 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23" />थम मेरी डाँट सुणकै पाप करणा छोड़ द्यो;</para>
  <para style="q" vid="PRO 1:23">सुणो, मै अपणी आत्मा थारे खात्तर उंडेल दियुँगी।</para>
  <para style="q" vid="PRO 1:23">मै थमनै अपणे वचन बताऊँगी।<verse eid="PRO 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24" />मन्‍नै तो पुकारया पर थमनै मना करया,</para>
  <para style="q" vid="PRO 1:24">अर मन्‍नै हाथ फैलाया<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="fq" closed="false">फैलाया </char><char style="ft" closed="false">यो एक बुलाण न्योंदा सै</char></note>, पर किसे नै ध्यान न्ही दिया,<verse eid="PRO 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25" />बल्के थमनै मेरी सारी सलाह ताहीं अनसुणी करया,</para>
  <para style="q" vid="PRO 1:25">अर मेरी डाँट की किम्मत न्ही जाणी;<verse eid="PRO 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26" />इस खात्तर मै भी थारी बिप्दा कै बखत हाँस्सुगी;</para>
  <para style="q" vid="PRO 1:26">अर जिब थारे पै भय आ पड़ैगा, फेर मै मजाक उड़ाऊँगी।<verse eid="PRO 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27" />बल्के आँधी कै ढाळ थारे पै भय आण पड़ैगा,</para>
  <para style="q" vid="PRO 1:27">अर बिप्दा भम्बुळियाँ की ढाळ आ पड़ैगी,</para>
  <para style="q" vid="PRO 1:27">अर थम मुश्किल अर बिप्दा म्ह फंसोगे फेर मै मखौल करुँगी।<verse eid="PRO 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28" />उस बखत वे मन्‍नै पुकारैंगे अर मै ना सुणुगी;</para>
  <para style="q" vid="PRO 1:28">वे मन्‍नै जतन तै तो ढूँढैंगे, पर न्ही पावैंगें।<verse eid="PRO 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29" />क्यूँके, उननै ज्ञान तै बैर करया,</para>
  <para style="q" vid="PRO 1:29">अर यहोवा का भय मानणा उननै न्ही भाया।<verse eid="PRO 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30" />उननै मेरी सलाह न्ही मान्‍नी।</para>
  <para style="q" vid="PRO 1:30">बल्के मेरी सारी डाँट-फटकार फजूल जाणी।<verse eid="PRO 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31" />इस खात्तर वे अपणी करणी का फळ आप भोगैंगे,</para>
  <para style="q" vid="PRO 1:31">अर अपणी युक्तियाँ कै नतिज्जे तै ऊब जावैंगे,<verse eid="PRO 1:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32" />क्यूँके अज्ञानियाँ का भटक जाणा, उनकै घात करै जाणै का कारण होवैगा।</para>
  <para style="q" vid="PRO 1:32">अर बेफिकर रहण कै कारण मूर्ख लोग नाश होवैंगे;<verse eid="PRO 1:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33" />पर जो मेरी सुणैगा, वो निडर बस्या रहवैगा,</para>
  <para style="q" vid="PRO 1:33">अर बिप्दा तै बेफिकर होकै सुख तै रहवैगा।”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">ज्ञान का मोल</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1" />हे मेरे बेट्टे, जै तू मेरे वचनां नै मान्‍नै,</para>
  <para style="q" vid="PRO 2:1">अर मेरे हुकमां नै अपणे मन म्ह धरे राक्खै,<verse eid="PRO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2" />अर बुद्धि की बात ध्यान तै सुणै,</para>
  <para style="q" vid="PRO 2:2">अर समझ की बात मन लगाकै सोच्‍चै;<verse eid="PRO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3" />जै तू माहिर अर समझ खात्तर घणे जतन तै पुकारै,<verse eid="PRO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4" />अर उसनै चाँदी की ढाळ टोहवै,</para>
  <para style="q" vid="PRO 2:4">अर गुप्त धन की तरियां उसकी टोह म्ह लाग्या रहवै;<verse eid="PRO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5" />तो तू यहोवा के भय नै समझैगा,</para>
  <para style="q" vid="PRO 2:5">अर परमेसवर का ज्ञान तन्‍नै मिलैगा।<verse eid="PRO 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6" />क्यूँके बुद्धि यहोवा ए देवै सै,</para>
  <para style="q" vid="PRO 2:6">ज्ञान अर समझ की बात उस्से कै मुँह तै लिकड़ै सै।<verse eid="PRO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7" />वो सीध्धे माणसां खात्तर खरी बुद्धि धरे राक्खै सै;</para>
  <para style="q" vid="PRO 2:7">जो खराई तै चाल्‍लै सै, उनकै खात्तर वो ढाल बणै सै।<verse eid="PRO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8" />वो न्याय के राह की देख-भाल करै,</para>
  <para style="q" vid="PRO 2:8">अर अपणे भगतां के राह की हिफाजत करै सै।<verse eid="PRO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9" />फेर तू धर्म अर न्याय अर सिधाई नै,</para>
  <para style="q" vid="PRO 2:9">यानी सारी आच्छी राह नै समझ सकैगा;<verse eid="PRO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10" />क्यूँके बुद्धि तो तेरे मन म्ह दाखल होवैगी,</para>
  <para style="q" vid="PRO 2:10">अर ज्ञान तेरे मन नै सुख देण आळा होवैगा;<verse eid="PRO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11" />विवेक तन्‍नै सम्भाले राक्खैगा;</para>
  <para style="q" vid="PRO 2:11">अर समझ तेरी रक्षक होवैगी;<verse eid="PRO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12" />ताके वे तन्‍नै बुराई की राह तै,</para>
  <para style="q" vid="PRO 2:12">अर उल्ट फेर की बात कहण आळे तै बचावैंगे,<verse eid="PRO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13" />जो सीध्धे राह नै छोड़ देवै सै,</para>
  <para style="q" vid="PRO 2:13">ताके अँधेरी राह म्ह चाल्‍लै;<verse eid="PRO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14" />जो बुराई करण तै राज्जी होवै सै,</para>
  <para style="q" vid="PRO 2:14">अर दुष्ट माणस की उल्ट फेर की बात्तां म्ह मगन रहवै सै;<verse eid="PRO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15" />जिनका चाल-चलण टेढ़ा-मेढ़ा</para>
  <para style="q" vid="PRO 2:15">अर जिनके राह म्ह भटकाव होवै सै।<verse eid="PRO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16" />बुद्धि अर विवेक तन्‍नै पराई बीर तै भी बचावैंगे</para>
  <para style="q" vid="PRO 2:16">जो चिकणी-चुपड़ी बात करै सै,<verse eid="PRO 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17" />अर अपणी जवान्‍नी कै साथी नै छोड़ देवै,</para>
  <para style="q" vid="PRO 2:17">अर जो अपणे परमेसवर के करार नै भूल जावै सै।<verse eid="PRO 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18" />उसका घर मौत की ढलाण पै सै,</para>
  <para style="q" vid="PRO 2:18">अर उसकी राही मरे होया म्ह पोहंचै सै;<verse eid="PRO 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19" />जो उसकै धोरै जा सै, उन म्ह तै कोए भी बोहड़कै न्ही आन्दा;</para>
  <para style="q" vid="PRO 2:19">अर ना वे जिन्दगी की राह पावै सै।<verse eid="PRO 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20" />इस करकै तू भले माणसां की राह पै चाल,</para>
  <para style="q" vid="PRO 2:20">अर धर्मियाँ की राह नै पकड़े रह।<verse eid="PRO 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21" />क्यूँके धर्मी लोग देश म्ह बसे रहवैंगे,</para>
  <para style="q" vid="PRO 2:21">अर खरे माणस ए उस म्ह बणे रहवैंगे।<verse eid="PRO 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22" />दुष्ट माणस देश म्ह तै खतम होवैंगे,</para>
  <para style="q" vid="PRO 2:22">अर धोक्खेबाज उस म्ह तै उखाड़े जावैंगे।<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">जवान्‍ना खात्तर मार्गदर्शन</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1" />हे मेरे बेट्टे, मेरी शिक्षा नै ना भूलिए;</para>
  <para style="q" vid="PRO 3:1">अपणे मन म्ह मेरे हुकमां नै धरे राखिये;<verse eid="PRO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2" />क्यूँके इसा करण तै तेरी उम्र बढ़ैगी,</para>
  <para style="q" vid="PRO 3:2">अर तू घणा सही-सलामत रहवैगा।<verse eid="PRO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3" />कृपा अर सच्‍चाई तेरे तै अलग ना होण पावै;</para>
  <para style="q" vid="PRO 3:3">बल्के उननै अपणे गळे का हार बणा ले,</para>
  <para style="q" vid="PRO 3:3">अर अपणे मनरुपी पट्टी म्ह लिख लिये।<verse eid="PRO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4" />फेर तू परमेसवर अर माणस दोनुआ का अनुग्रह पावैगा,</para>
  <para style="q" vid="PRO 3:4">अर तू घणा मान-सम्मान पावैगा।<verse eid="PRO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5" />तू अपणी समझ का सहारा ना लिये,</para>
  <para style="q" vid="PRO 3:5">बल्के सारे मन तै यहोवा पै भरोस्सा राखिये।<verse eid="PRO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6" />उस्से नै याद करकै सारे काम करिये,</para>
  <para style="q" vid="PRO 3:6">फेर वो तेरे खात्तर सीध्धा राह लिकाड़ैगा।<verse eid="PRO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7" />अपणी जाण म्ह घणा श्याणा ना बणीये;</para>
  <para style="q" vid="PRO 3:7">यहोवा का भय मानिये अर बुराई तै दूर रहिये।<verse eid="PRO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8" />इसा करण तै तेरी देह भली चंगी,</para>
  <para style="q" vid="PRO 3:8">अर तेरी हड्डियाँ मजबूत रहवैगी।<verse eid="PRO 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9" />अपणे धन कै जरिये</para>
  <para style="q" vid="PRO 3:9">अर अपणी धरती की सारी पैहली फसल दे-देकै यहोवा की बड़ाई करिये;<verse eid="PRO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10" />इस तरियां करण तै तेरे खत्ते भरे</para>
  <para style="q" vid="PRO 3:10">अर पूरे रहवैंगे, अर तेरे रसकुण्डां तै नया दाखमधु उमड़दा रहवैगा।<verse eid="PRO 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11" />हे मेरे बेट्टे, यहोवा की शिक्षा तै मुँह ना मोड़िये,</para>
  <para style="q" vid="PRO 3:11">अर जिब वो तन्‍नै डाँटै, तो तू बुरा ना मानिये,<verse eid="PRO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12" />जिस तरियां पिता अपणे लाड़ले बेट्टे नै डाँटै सै,</para>
  <para style="q" vid="PRO 3:12">क्यूँके यहोवा जिसतै प्यार करै सै, उसनै डाँटै सै।<verse eid="PRO 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13" />कितना धन्य सै वो माणस जो बुद्धि पावै, अर वो माणस जो समझ नै पावै,<verse eid="PRO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14" />जो फायदा बुद्धि तै मिलै सै, वो चाँदी कै मिलण तै बड़ा,</para>
  <para style="q" vid="PRO 3:14">अर उसका फायदा शुद्ध सोन्‍ने कै फायदा तै भी घणा सै।<verse eid="PRO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15" />वो बेसकिमती रतनां तै भी घणा कीमती सै,</para>
  <para style="q" vid="PRO 3:15">अर जितनी चिज्जां की तू लालसा करै सै, उन म्ह तै कोए भी उसकै जिसी न्ही होगी।<verse eid="PRO 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16" />उसकै ओळे हाथ म्ह लम्बी उम्र,</para>
  <para style="q" vid="PRO 3:16">अर सोळे हाथ म्ह धन अर बड़ाई सै।<verse eid="PRO 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17" />उसका राह सुख-चैन देण आळा सै,</para>
  <para style="q" vid="PRO 3:17">अर उसके सारे राह शान्ति के सै।<verse eid="PRO 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18" />जो बुद्धि नै पा लेवै सै,</para>
  <para style="q" vid="PRO 3:18">उनकै खात्तर वो जीवन का पेड़ बणै सै; अर जो उसनै पकड़े रहवै सै, वे धन्य सै।<verse eid="PRO 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />यहोवा नै धरती की नीम बुद्धि तै ए धरी सै;</para>
  <para style="q" vid="PRO 3:19">अर सुर्ग ताहीं भी समझ तैए टिकाया सै।<verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />उस्से कै ज्ञान तै गहरे समुन्दर फूट लिकड़े,</para>
  <para style="q" vid="PRO 3:20">अर आसमान तै ओस टपकै सै।<verse eid="PRO 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21" />हे मेरे बेट्टे, ये सारी बात तेरी नजर की ओट म्ह ना होण पावै; तू खरी बुद्धि</para>
  <para style="q" vid="PRO 3:21">अर विवेक की रुखाळ कर,<verse eid="PRO 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22" />तो इनतै तन्‍नै जीवन मिलैगा,</para>
  <para style="q" vid="PRO 3:22">अर ये तेरे गळे का हार बणैगें।<verse eid="PRO 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23" />फेर तू अपणे राह पै बेधड़क चाल्‍लैगा,</para>
  <para style="q" vid="PRO 3:23">अर तेरे पायां म्ह ठोक्‍कर न्ही लाग्गैगी।<verse eid="PRO 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24" />जिब तू लेट्टैगा, तो भय न्ही खावैगा,</para>
  <para style="q" vid="PRO 3:24">जिब तू सोवैगा, तो तन्‍नै सुख की नींद आवैगी।<verse eid="PRO 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25" />चाणचक आण आळे भय तै ना डरिये,</para>
  <para style="q" vid="PRO 3:25">अर जिब दुष्टां पै बिप्दा आ पड़ै,</para>
  <para style="q" vid="PRO 3:25">तो घबराइए ना;<verse eid="PRO 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26" />क्यूँके यहोवा तन्‍नै सहारा दिया करैगा,</para>
  <para style="q" vid="PRO 3:26">अर तेरे पैरां नै फंदे म्ह फसण न्ही देवैगा।<verse eid="PRO 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27" />जो भलाई के जोग्गे सै उनका भला जरुर करिए,</para>
  <para style="q" vid="PRO 3:27">जै तू इसा कर सकै।<verse eid="PRO 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28" />जै तेरे धोरै देण नै किमे हो,</para>
  <para style="q" vid="PRO 3:28">तो अपणे पड़ोसी तै ना कहिये के “जा कल फेर आईये, काल मै तन्‍नै देऊँगा।”<verse eid="PRO 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29" />जिब तेरा पड़ोसी, तेरे धोरै बेफिकर होकै रहवै सै,</para>
  <para style="q" vid="PRO 3:29">तो उसकै खिलाफ, बुरी तरकीब ना लड़ाइये।<verse eid="PRO 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30" />जिस माणस नै तेरे तै बुरा बरताव ना करया हो,</para>
  <para style="q" vid="PRO 3:30">उसतै बिना कारण मुकद्दमा ना लड़िये।<verse eid="PRO 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31" />जुल्म करण आळे माणसां के बारै म्ह जळण ना करिये,</para>
  <para style="q" vid="PRO 3:31">ना उसकी तरियां चाल चालिये;<verse eid="PRO 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32" />क्यूँके यहोवा चलाक माणस तै घृणा करै सै,</para>
  <para style="q" vid="PRO 3:32">पर वो अपणा भेद सीध्धे माणसां पै खोल्‍लै सै।<verse eid="PRO 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33" />दुष्ट कै घर पै यहोवा का श्राप</para>
  <para style="q" vid="PRO 3:33">अर धर्मियाँ कै घरां पै उसकी आशीष होवै सै।<verse eid="PRO 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34" />मजाक करण आळे का वो जरुर मजाक बणावै सै;</para>
  <para style="q" vid="PRO 3:34">पर दीन पै अपणी दया करै सै।<verse eid="PRO 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35" />बुद्धिमान बड़ाई पावैंगें,</para>
  <para style="q" vid="PRO 3:35">पर मूर्खां की बढ़ती निरादर की ए होवैगी।<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">बुद्धि के फायदा</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1" />हे मेरे बेट्टों, पिता की शिक्षा नै सुणो,</para>
  <para style="q" vid="PRO 4:1">अर समझ पाण म्ह मन लगाओ।<verse eid="PRO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2" />क्यूँके मन्‍नै थारे ताहीं खरी शिक्षा दी सै;</para>
  <para style="q" vid="PRO 4:2">मेरी शिक्षा नै ना छोड़ो।<verse eid="PRO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3" />देक्खो, मै भी अपणे पिता का बेट्टा था,</para>
  <para style="q" vid="PRO 4:3">अर माँ का इकलौत्ता लाडला था,<verse eid="PRO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4" />अर मेरा पिता मन्‍नै यो कहकै सिखावै था,</para>
  <para style="q" vid="PRO 4:4">“तेरा मन मेरै वचनां पै लाग्या रहवै;</para>
  <para style="q" vid="PRO 4:4">तू मेरे हुकमां का पालन करै, तो तू जिन्दा रहवैगा।<verse eid="PRO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5" />बुद्धि नै पा ले, समझ नै भी पा ले,</para>
  <para style="q" vid="PRO 4:5">उननै भूल ना जाईये, अर ना ए मेरी बात्तां नै छोड़िए।<verse eid="PRO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6" />बुद्धि नै ना छोड्डै, अर वा तेरी हिफाजत करैगी;</para>
  <para style="q" vid="PRO 4:6">उसतै मोह राख, अर वा तेरा पैहरा देवैगी।<verse eid="PRO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7" />बुद्धि श्रेष्ठ सै, इस करकै उसनै पाण कै खात्तर जतन कर;</para>
  <para style="q" vid="PRO 4:7">अपणा सारा किमे खर्च करदे ताके समझ नै पा सकै;<verse eid="PRO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8" />उसकी बड़ाई कर, वा तन्‍नै बढ़ावैगी;</para>
  <para style="q" vid="PRO 4:8">जिब तू उसतै लिपट जावै, तो वा तेरी महिमा करैगी।<verse eid="PRO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9" />वा तेरे सिर पै शोभायमान भूषण बाँधैगी;</para>
  <para style="q" vid="PRO 4:9">अर तन्‍नै सुन्दर मुकट देवैगी।”<verse eid="PRO 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10" />हे मेरे बेट्टे, मेरी बात्तां नै सुणकै मान ले,</para>
  <para style="q" vid="PRO 4:10">तो तू लम्बी उम्र तक जिन्दा रहवैगा।<verse eid="PRO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11" />मन्‍नै तेरे ताहीं बुद्धि की राह बताई सै,</para>
  <para style="q" vid="PRO 4:11">अर खराई कै राह पै चलाया सै।<verse eid="PRO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12" />जिस म्ह चाल्‍लण म्ह तन्‍नै रोक-टोक ना होवैगी,</para>
  <para style="q" vid="PRO 4:12">अर चाहे तू भाज्जै, तोभी ठोक्‍कर न्ही खावैगा।<verse eid="PRO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13" />शिक्षा नै पकड़े रह, उसनै छोड़ ना दिये;</para>
  <para style="q" vid="PRO 4:13">उसकी रुखाळ कर क्यूँके वोए तेरा जीवन सै।<verse eid="PRO 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14" />दुष्टां की राह म्ह पाँ भी ना धरिये,</para>
  <para style="q" vid="PRO 4:14">अर ना बुरे माणसां की राह पै चालिये।<verse eid="PRO 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15" />उसनै छोड़ दे, उसकै धोरै तै भी ना चाल्‍लै,</para>
  <para style="q" vid="PRO 4:15">उसकै धोरै तै मुड़कै आग्गै बढ़ जा।<verse eid="PRO 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16" />क्यूँके दुष्ट माणस जै बुराई ना करै, तो उसनै नींद न्ही आन्दी;</para>
  <para style="q" vid="PRO 4:16">अर जिब ताहीं वे किसे नै ठोक्‍कर ना खुवावै, तब तक उननै नींद न्ही आन्दी।<verse eid="PRO 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17" />क्यूँके वे तो पाप तै कमाई होई रोट्टी खावै सै,</para>
  <para style="q" vid="PRO 4:17">अर हिंसा की दाखमधु पीवै सै।<verse eid="PRO 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18" />पर धर्मियाँ की चाल, उस लिकड़दे होए सूरज की तरियां सै,</para>
  <para style="q" vid="PRO 4:18">जिसकी चमक दोपहर तक बढ़ती जावै सै।<verse eid="PRO 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19" />दुष्टां की राह म्ह घोर अँधेरा सै;</para>
  <para style="q" vid="PRO 4:19">वे न्ही जाणदे के वे किसतै ठोक्‍कर खावै सै।<verse eid="PRO 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20" />हे मेरे बेट्टे, मेरे वचन ध्यान तै सुण,</para>
  <para style="q" vid="PRO 4:20">अर अपणा कान मेरी बात्तां की ओड़ लगा।<verse eid="PRO 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21" />इननै अपणी आँखां तै छिपण ना दे;</para>
  <para style="q" vid="PRO 4:21">बल्के अपणे मन म्ह धारण कर।<verse eid="PRO 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22" />क्यूँके जिननै वे मिली सै, वे उनकै जिन्दा रहण का,</para>
  <para style="q" vid="PRO 4:22">अर उनकै सारे शरीर के चंगे रहण का कारण हो सै।<verse eid="PRO 4:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23" />सब तै घणी अपणे मन की रुखाळ कर;</para>
  <para style="q" vid="PRO 4:23">क्यूँके जीवन का आधार वोए सै।<verse eid="PRO 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24" />माड़ी बात अपणे मुँह तै ना बोल्‍लै,</para>
  <para style="q" vid="PRO 4:24">अर चाल-बाजी की बात तेरे तै दूर रहवै।<verse eid="PRO 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25" />तेरी आँख स्याम्ही की ओड़ ए लाग्गी रहवै।</para>
  <para style="q" vid="PRO 4:25">अर तेरी पलक आग्गै की ओड़ खुली रहवै।<verse eid="PRO 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26" />अपणे पैर धरण खात्तर राह नै बराबर कर,</para>
  <para style="q" vid="PRO 4:26">फेर तेरे सारे राह ठीक रहवै।<verse eid="PRO 4:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27" />ना तो सीध्धे हाथ न मुड़िए अर ना उलटे हाथ नै मुड़िए;</para>
  <para style="q" vid="PRO 4:27">अपणे पैरां नै बुराई की राह पै चालण तै हटा ले।<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">जारी के खिलाफ चेतावनी</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1" />हे मेरे बेट्टे, मेरी बुद्धि की बात्तां की ओड़ ध्यान दे,</para>
  <para style="q" vid="PRO 5:1">अर मेरी समझ की ओड़ कान लगा;<verse eid="PRO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2" />जिसतै तेरे विवेक की हिफाजत होन्दी रहवै,</para>
  <para style="q" vid="PRO 5:2">अर तू ज्ञान की बात्तां नै थाम्मे रहवै।<verse eid="PRO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3" />क्यूँके पराई जनान्‍नी कै होठ्ठां तै शहद टपकै सै,</para>
  <para style="q" vid="PRO 5:3">अर उसकी सारी बात तेल तै भी घणी चिकणी होवै सै;<verse eid="PRO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4" />पर आखिर म्ह इसका नतिज्जा, नागदौना जिसा कड़वा</para>
  <para style="q" vid="PRO 5:4">अर दोधारी तलवार जिसा पैन्‍ना हो सै।<verse eid="PRO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5" />उसके पाँ मौत की ओड़ नीच्‍चै बढै़ सै;</para>
  <para style="q" vid="PRO 5:5">अर उसके कदम अधोलोक ताहीं पोहंचै सै।<verse eid="PRO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6" />वा जीवन के राह के बारै म्ह विचार न्ही कर दी;</para>
  <para style="q" vid="PRO 5:6">उसकै चाल-चलण म्ह चंचलता सै, पर उसनै वा खुद भी न्ही जाणदी।<verse eid="PRO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7" />इस खात्तर इब हे मेरे बाळकों, मेरी सुणो,</para>
  <para style="q" vid="PRO 5:7">अर मेरी बात्तां तै मुँह ना मोड़ो।<verse eid="PRO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8" />इसी जनान्‍नी तै दूर ए रह,</para>
  <para style="q" vid="PRO 5:8">अर उसकी देहळी कै धोरै भी ना जाईये;<verse eid="PRO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9" />कदे इसा ना होवै के तू अपणा यश</para>
  <para style="q" vid="PRO 5:9">दुसरयां कै हाथ, अर अपणा बाकी जीवन बुरे माणसां कै बस म्ह करदे;<verse eid="PRO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10" />या पराए तेरी कमाई तै अपणा पेट भरै,</para>
  <para style="q" vid="PRO 5:10">अर ओपरा माणस तेरी मेहनत का फळ अपणे घर म्ह धरै;<verse eid="PRO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11" />अर तू अपणे आखरी बखत म्ह जिब के तेरी देह कमजोर हो जा तो तू कहरा कै,<verse eid="PRO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12" />यो कहवैगा, “मन्‍नै शिक्षा तै किसा बैर करया,</para>
  <para style="q" vid="PRO 5:12">अर डाँटण आळे का किसा अपमान करया!<verse eid="PRO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13" />मन्‍नै अपणे गुरुआं की बात न्ही मान्‍नी,</para>
  <para style="q" vid="PRO 5:13">अर अपणे सिखाण आळा की ओड़ ध्यान न्ही लगाया।<verse eid="PRO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14" />मै सभा अर संगत कै बीच म्ह पूरी तरियां;</para>
  <para style="q" vid="PRO 5:14">नाश की कगार म्ह जा पड्या”<verse eid="PRO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15" />तू अपणे ए कुण्ड तै पाणी,</para>
  <para style="q" vid="PRO 5:15">अर अपणे ए कुएँ के चोवै का पाणी पिया करिये।<verse eid="PRO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16" />के तेरे चोवा का पाणी सड़क म्ह,</para>
  <para style="q" vid="PRO 5:16">अर तेरे पाणी की धारा चौकां म्ह बह जावै?<verse eid="PRO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17" />यो सिर्फ तेरैए खात्तर रहवै,</para>
  <para style="q" vid="PRO 5:17">अर तेरे संग गैरां खात्तर ना हो।<verse eid="PRO 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18" />तेरा जल-कुण्ड धन्य रहवै; अर अपणी जवान्‍नी की बिरबान्‍नी गैल राज्जी रह,<verse eid="PRO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19" />वा तेरे खात्तर प्यारी अर सुन्दर हिरणी की ढाळ हो,</para>
  <para style="q" vid="PRO 5:19">उसके स्तन सदा तन्‍नै संतुष्ट राक्खै,</para>
  <para style="q" vid="PRO 5:19">अर उसे का प्यार रोज तन्‍नै अपणी ओड़ खींचदा रहवै।<verse eid="PRO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20" />हे मेरे बेट्टे, तू जार जनान्‍नी पै क्यूँ मोहित होवै,</para>
  <para style="q" vid="PRO 5:20">अर पराई जनान्‍नी नै क्यूँ छात्ती कै लगावै?<verse eid="PRO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21" />क्यूँके माणस के राह यहोवा की आँख्यां तै छिपे न्ही सै,</para>
  <para style="q" vid="PRO 5:21">अर वो उसके सारे राह पै ध्यान करै सै।<verse eid="PRO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22" />दुष्ट अपणे ए अधर्म के काम्मां म्ह फँसैगा,</para>
  <para style="q" vid="PRO 5:22">अर अपणे ए पाप की बेड़ियाँ म्ह बंध्या रहवैगा।<verse eid="PRO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23" />वो अनुशासन का पालन ना करण कै कारण मर जावैगा,</para>
  <para style="q" vid="PRO 5:23">अर अपणी ए मूर्खता कै कारण भटकदा रहवैगा।<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">दुसरी चेतावनियाँ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1" />हे मेरे बेट्टे, जै तू अपणे पड़ोसी का जमानती होया हो,</para>
  <para style="q" vid="PRO 6:1">या परदेशी खात्तर हाथ पै हाथ मारकै जवाब देह होया हो,<verse eid="PRO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2" />तो तू अपणी ए कही होई बात्तां म्ह फँस जावैगा,</para>
  <para style="q" vid="PRO 6:2">अर अपणी ए कही होई बात्तां म्ह फँस जावैगा।<verse eid="PRO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3" />इस हालत म्ह, हे मेरे बेट्टे तू एक काम कर</para>
  <para style="q" vid="PRO 6:3">अपणे-आपनै बचाले, क्यूँके तू अपणे पड़ोसी के हाथ म्ह पड़ग्या सै तो जा,</para>
  <para style="q" vid="PRO 6:3">अर अपणी रिहाई खात्तर उसके पैरां म्ह पड़कै प्रणाम करकै उसतै बिनती कर।<verse eid="PRO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4" />तू ना तो अपणी आँख्यां म्ह नींद,</para>
  <para style="q" vid="PRO 6:4">अर ना अपणी पलकां म्ह झपकी आण दे;<verse eid="PRO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5" />अर अपणे-आपनै हिरण की ढाळ शिकारी कै हाथ तै,</para>
  <para style="q" vid="PRO 6:5">अर चिड़ियाँ की ढाळ चिड़िमार कै हाथ तै छुड़ा।<verse eid="PRO 6:5" /></para>
  <para style="s">आलसी की मूर्खता</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6" />हे आलसी, कीड़ियाँ धोरै जा;</para>
  <para style="q" vid="PRO 6:6">उनकै काम पै ध्यान दे, अर अकलमंद हो।<verse eid="PRO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7" />उनका ना तो कोए मुखिया होवै सै,</para>
  <para style="q" vid="PRO 6:7">ना प्रधान, अर ना राज करण आळा,<verse eid="PRO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8" />तोभी वे अपणा खाण का समान घाम म्ह कठ्ठा करै सै,</para>
  <para style="q" vid="PRO 6:8">अर लामणी कै बखत अपणे खाण का समान कठ्ठा करले सै।<verse eid="PRO 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9" />हे आलसी, तू कद ताहीं सोन्दा रहवैगा?</para>
  <para style="q" vid="PRO 6:9">तेरी नींद कद टूट्टैगी?<verse eid="PRO 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10" />थोड़ी सी नींद, एक और झपकी,</para>
  <para style="q" vid="PRO 6:10">थोड़ी देर और छात्ती पै हाथ धरे लेट्या रहणा,<verse eid="PRO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11" />तब तेरा कंगालपण राह के लुटेरयां कै जिसा</para>
  <para style="q" vid="PRO 6:11">अर तेरा घाट्टा हथियाबन्द कै जिसा आण पड़ैगा।<verse eid="PRO 6:11" /></para>
  <para style="s">दुष्ट माणस</para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12" />ओच्छे अर अनर्थकारी नै देक्खो,</para>
  <para style="q" vid="PRO 6:12">वो टेढ़ी-टेढ़ी बात बकदा फिरै सै।<verse eid="PRO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13" />वो आँखां-ए-आँखां, अर पैरां तै इशारा,</para>
  <para style="q" vid="PRO 6:13">अर अपणी आँगळियाँ तै इशारा करै सै,<verse eid="PRO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14" />उसकै मन मै उल्ट-फेर की बात रहवै, वो सारी हाण बुराई गढै़ सै</para>
  <para style="q" vid="PRO 6:14">अर लड़ाई-झगड़े के हालात बणावै सै।<verse eid="PRO 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15" />इस कारण उसपै बिप्दा चाणचक आ पड़ैगी,</para>
  <para style="q" vid="PRO 6:15">वो पलभर म्ह इसा नाश हो जावैगा, के बचण का कोए उपाय न्ही रहवैगा।<verse eid="PRO 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16" />छः बात्तां तै यहोवा बैर राक्खै सै।</para>
  <para style="q" vid="PRO 6:16">बल्के सात सै, जिनतै उसनै नफरत सै;<verse eid="PRO 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17" />मतलब घमण्ड तै चढ़ी होड़ आँख, झूठ बोलण आळी जीभ,</para>
  <para style="q" vid="PRO 6:17">अर निर्दोष का खून बहाण आळे हाथ,<verse eid="PRO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18" />अनर्थ कल्पना गढ़ण आळा मन,</para>
  <para style="q" vid="PRO 6:18">बुराई करण ताहीं तेज्जी तै दौड़ण आळे पैर,<verse eid="PRO 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19" />झूठ बोलण आळा गवाह</para>
  <para style="q" vid="PRO 6:19">अर सगे भाईयाँ कै बीच झगड़ा करवाण आळा माणस।<verse eid="PRO 6:19" /></para>
  <para style="s">जारी तै सावधान</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20" />हे मेरे बेट्टे, अपणे पिता के हुकम नै मान,</para>
  <para style="q" vid="PRO 6:20">अर अपणी माँ की शिक्षा नै ना छोड़।<verse eid="PRO 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21" />उननै अपणे मन म्ह सदा गाँठ बाँधे राख;</para>
  <para style="q" vid="PRO 6:21">अर अपणे गळे का हार बणाले।<verse eid="PRO 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22" />वो चालण म्ह तेरी अगुवाई,</para>
  <para style="q" vid="PRO 6:22">अर सोन्दे बखत तेरी रुखाळ,</para>
  <para style="q" vid="PRO 6:22">अर जागदे बखत तन्‍नै शिक्षा देवैगी।<verse eid="PRO 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23" />प्रभु का आदेश तो दीवा सै अर शिक्षा रोशनी,</para>
  <para style="q" vid="PRO 6:23">अर सिखाण आळे की डाँट जीवन की राह सै,<verse eid="PRO 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24" />वे तन्‍नै बुरी जनान्‍नी तै</para>
  <para style="q" vid="PRO 6:24">अर जार बिरबान्‍नी की चिकणी-चुपड़ी बात्तां तै बचावैगी।<verse eid="PRO 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25" />उसकी सुन्दरता देखकै अपणे मन म्ह उसकी लालसा ना करै;</para>
  <para style="q" vid="PRO 6:25">वा तन्‍नै अपणे आँखां के इसारां तै फसाण न्ही पावै;<verse eid="PRO 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26" />क्यूँके वैश्यगमन कै कारण माणस टुकड़े-टुकड़े का मोहताज हो जावै सै<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">वेश्‍या की किम्मत रोट्टी के टुकड़ा के समान सै</char></note>,</para>
  <para style="q" vid="PRO 6:26">पर जार बिरबान्‍नी अनमोल जीवन का शिकार कर ले सै।<verse eid="PRO 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />के हो सकै सै के कोए अपणी छात्ती पै आग धर ले,</para>
  <para style="q" vid="PRO 6:27">अर उसके लत्ते ना जलै?<verse eid="PRO 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28" />के हो सकै सै क कोए अंगारां पै चाल्‍लै,</para>
  <para style="q" vid="PRO 6:28">अर पाँ ना झुळसै?<verse eid="PRO 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29" />जो पराई बिरबान्‍नी धोरै जावै सै, उसकी दशा इसी सै;</para>
  <para style="q" vid="PRO 6:29">बल्के जो कोए उसनै छूवैगा वो सजा तै न्ही बचैगा।<verse eid="PRO 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30" />जो चोर भूख कै मारे अपणा पेट भरण खात्तर चोरी करै,</para>
  <para style="q" vid="PRO 6:30">उसनै लोग तुच्छ न्ही जाणदे;<verse eid="PRO 6:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31" />तोभी जै वो पकड़ा जावै, तो उसनै सातगुणा भरणा पड़ैगा;</para>
  <para style="q" vid="PRO 6:31">बल्के अपणे घर का सारा धन देणा पड़ैगा।<verse eid="PRO 6:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32" />जो पराई बिरबान्‍नी गैल सोवै सै वो निरा मूर्ख सै;</para>
  <para style="q" vid="PRO 6:32">जो इसा करै सै, वो अपणी जिन्दगी नै बर्बाद करै सै।<verse eid="PRO 6:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33" />उसनै जख्मी अर बेईज्जत होणा पड़ैगा,</para>
  <para style="q" vid="PRO 6:33">अर उसकी बदनाम्मी कदे न्ही हटैगी।<verse eid="PRO 6:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34" />क्यूँके जळण तै माणस घणाए गुस्से म्ह हो जावै सै,</para>
  <para style="q" vid="PRO 6:34">अर बदला देण कै दिन वो कुछ नरमाई न्ही दिखावैगा।<verse eid="PRO 6:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35" />वो मुआवजे म्ह किमे न्ही लेवैगा,</para>
  <para style="q" vid="PRO 6:35">अर चाहे तू उसनै घणाए कुछ दिये, तोभी वो न्ही मान्‍नैगा।<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1" />हे मेरे बेट्टे, मेरी बात्तां नै मान्या कर,</para>
  <para style="q" vid="PRO 7:1">अर मेरे हुकमां नै अपणे मन म्ह धर ले।<verse eid="PRO 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2" />मेरे हुक्म नै मान, इसतै तू जिन्दा रहवैगा,</para>
  <para style="q" vid="PRO 7:2">अर मेरी शिक्षा नै अपणी आँख की पुतली जाण;<verse eid="PRO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3" />उननै अपणी आँगळियाँ म्ह बाँध,</para>
  <para style="q" vid="PRO 7:3">अर अपणे दिल की पटियाँ पै लिख ले।<verse eid="PRO 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4" />बुद्धि तै कह के, “तू मेरी भाण सै,”</para>
  <para style="q" vid="PRO 7:4">अर समझ नै अपणी साथण बणा।<verse eid="PRO 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5" />फेर तू पराई जनान्‍नी तै बचैगा,</para>
  <para style="q" vid="PRO 7:5">जो चिकणी-चुपड़ी बात बोल्‍ले सै।<verse eid="PRO 7:5" /></para>
  <para style="s">चालबाज वेश्या</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6" />मन्‍नै एक दिन अपणे घर की खिड़की तै,</para>
  <para style="q" vid="PRO 7:6">यानी अपणे झरोखे म्ह तै झाक्यां,<verse eid="PRO 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7" />तब मन्‍नै भोळे माणसां म्ह तै</para>
  <para style="q" vid="PRO 7:7">एक बेअक्ल जवान ताहीं देख्या;<verse eid="PRO 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8" />वो उस जनान्‍नी कै घर की कूण कै धोरै तै सड़क पै चाल्या जा था,</para>
  <para style="q" vid="PRO 7:8">अर उसनै उसकै घर का राह लिया।<verse eid="PRO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9" />उस बखत दिन ढळग्या, अर साँझ हो ली थी,</para>
  <para style="q" vid="PRO 7:9">बल्के रात का घणा अँधेरा छाग्या था।<verse eid="PRO 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10" />अर उसतै एक जनान्‍नी मिली,</para>
  <para style="q" vid="PRO 7:10">जिसका भेष बेश्या जिसा था, अर वा मक्‍कार थी।<verse eid="PRO 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11" />वा बे-लगाम अर चंचल थी,</para>
  <para style="q" vid="PRO 7:11">अर उसके पैर घर म्ह न्ही टिकै थे;<verse eid="PRO 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12" />कदे वा सड़क पै, कदे चौक म्ह पाई जावै थी,</para>
  <para style="q" vid="PRO 7:12">अर हरेक कूण पै वा बाट देक्खे जावै थी।<verse eid="PRO 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13" />फेर उसनै उस जवान गाबरू ताहीं पकड़कै चुम्या,</para>
  <para style="q" vid="PRO 7:13">अर बेशर्मी की कोशिश करकै उसतै कह्या,<verse eid="PRO 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14" />“मन्‍नै आज ए मेलबलि चढ़ाये सै,</para>
  <para style="q" vid="PRO 7:14">अर अपणी मुराद पूरी करी;<verse eid="PRO 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15" />इसे खात्तर मै तेरे तै मिलण नै लिकड़ी,</para>
  <para style="q" vid="PRO 7:15">मै तन्‍नै ए टोह्ऊँ थी, अर तू इब मिल्या सै।<verse eid="PRO 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16" />मन्‍नै अपणे पिलंग के बिछोणे पै</para>
  <para style="q" vid="PRO 7:16">मिस्र के बेलबूट्टे आळे लत्ते बिछाए सै;<verse eid="PRO 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17" />मन्‍नै अपणे बिछोणे पै गन्धरस,</para>
  <para style="q" vid="PRO 7:17">अगर अर दालचीनी छिड़की सै।<verse eid="PRO 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18" />इस करकै इब चाल आपां प्यार तै सबेर तक जी बहलान्दे रहवां;</para>
  <para style="q" vid="PRO 7:18">हम मेल के मोह तै मस्त अर मगन रहवां।<verse eid="PRO 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19" />क्यूँके मेरा धणी घर म्ह कोनी;</para>
  <para style="q" vid="PRO 7:19">वो दूर देश म्ह चल्या गया सै;<verse eid="PRO 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20" />वो चाँदी की थैल्‍ली लेग्या सै;</para>
  <para style="q" vid="PRO 7:20">अर पूर्णमासी नै बोहड़ैगा।”<verse eid="PRO 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21" />इसीए लुभाण आळी बात कह-कहकै, उसनै उस ताहीं फँसा लिया;</para>
  <para style="q" vid="PRO 7:21">अर अपणी चिकणी-चुपड़ी बात्तां तै उस ताहीं अपणे बस म्ह कर लिया,<verse eid="PRO 7:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22" />वो बिना देर करे उसकै पाच्छै हो लिया,</para>
  <para style="q" vid="PRO 7:22">जुकर बळध कसाई खान्‍ना म्ह,</para>
  <para style="q" vid="PRO 7:22">या हिरण फंदे म्ह पाँ धरै सै।<verse eid="PRO 7:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23" />आखर म्ह उस जवान का कळेजा तीर तै भेदां जावैगा;</para>
  <para style="q" vid="PRO 7:23">वो उस चिड़ियाँ कै जिसा सै जो जाळ की ओड़ तेज्जी तै उड़ै सै</para>
  <para style="q" vid="PRO 7:23">अर वा न्ही जाणदी के उस म्ह उसकी जान जावैगी।<verse eid="PRO 7:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24" />इब हे मेरे बाळकों, मेरी सुणो,</para>
  <para style="q" vid="PRO 7:24">अर मेरी बात्तां पै मन लगाओ।<verse eid="PRO 7:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25" />तेरा मन इसी जनान्‍नी के राह की ओड़ ना फिरै,</para>
  <para style="q" vid="PRO 7:25">अर उसके राह म्ह भूलकै भी ना जाईयो;<verse eid="PRO 7:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26" />क्यूँके घणेए माणस उसके कारण मारे गये सै,</para>
  <para style="q" vid="PRO 7:26">उसके घात करे होया की एक बड़ी गिणती होगी।<verse eid="PRO 7:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27" />उसका घर अधोलोक का राह सै,</para>
  <para style="q" vid="PRO 7:27">वो मौत कै घर म्ह पोहचावै सै।<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">ज्ञान की श्रेष्ठता</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1" />के बुद्धि कोनी पुकारै?</para>
  <para style="q" vid="PRO 8:1">के समझ ऊँच्‍ची आवाज म्ह कोनी बुलावै सै?<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />बुद्धि तो राह के ऊँच्‍ची जगहां पै,</para>
  <para style="q" vid="PRO 8:2">अर चौराहयाँ पै खड़ी होवै सै,<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />फाटकां कै धोरै, चुपाड़ कै धोरै,</para>
  <para style="q" vid="PRO 8:3">अर दरबाजे ए म्ह तै वो ऊँच्‍ची आवाज म्ह कहवै सै,<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />“हे माणसों, मै थमनै पुकारूँ सूं,</para>
  <para style="q" vid="PRO 8:4">अर मेरी सारी बात सारे माणसां खात्तर सै।<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />हे भोळे माणसों, चतुराई सीखो;</para>
  <para style="q" vid="PRO 8:5">अर हे मूर्खो, अपणे मन म्ह समझ ल्यो<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />सुणो, क्यूँके मै खरी बात कहूँगी,</para>
  <para style="q" vid="PRO 8:6">अर जिब मुँह खोल्‍लूँगी, तब उस म्ह तै सीध्धी बात लिकड़ैगी;<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />क्यूँके मेरे तै सच्‍चाई की बात का जिक्र होवैगा;</para>
  <para style="q" vid="PRO 8:7">दुष्टता की बात तै मन्‍नै घृणा आवै सै।<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />मेरे मुँह की सारी बात धर्म की होवै सै,</para>
  <para style="q" vid="PRO 8:8">उन म्ह तै कोए टेढ़ी या उल्ट फेर की बात न्ही लिकड़दी।<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />समझदार खात्तर वे सारी आसान,</para>
  <para style="q" vid="PRO 8:9">अर ज्ञान पाण आळा खात्तर कती सीध्धी सै।<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />चाँदी न्ही, मेरी शिक्षा नै ए चुण ल्यो,</para>
  <para style="q" vid="PRO 8:10">अर खरे कुन्दन तै बढ़कै ज्ञान नै स्वीकार करो।<verse eid="PRO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />क्यूँके बुद्धि, बेसकिमती रत्नां तै भी आच्छी सै,</para>
  <para style="q" vid="PRO 8:11">अर सारी मन लुभाण आळी चिज्जां म्ह तै कोए भी उसकै बराबर कोनी।<verse eid="PRO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />मै जो बुद्धि सूं, अर मै चतुराई म्ह वास करुँ सूं,</para>
  <para style="q" vid="PRO 8:12">अर ज्ञान अर विवेक नै पाऊँ सूं।<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />यहोवा का भय मानणा बुराई तै बैर राखणा सै।</para>
  <para style="q" vid="PRO 8:13">घमण्ड, अहंकार अर बुरी चाल तै,</para>
  <para style="q" vid="PRO 8:13">अर धोक्खेबाजी की बात्तां तै भी मै बैर राक्खूँ सूं।<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />बढ़िया युक्ति, अर खरी बुद्धि मेरी ए सै, मेरे म्ह समझ सै,</para>
  <para style="q" vid="PRO 8:14">अर पराक्रम भी मेरा सै।<verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />मेरै ए जरिये राजा राज करै सै,</para>
  <para style="q" vid="PRO 8:15">अर अधिकारी धर्म तै शासन करै सै;<verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />मेरै ए जरिये राजा,</para>
  <para style="q" vid="PRO 8:16">हाकिम अर धरती के सारे न्याय करण आळे राज करै सै।<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />जो मेरै तै प्यार करै सै, उनतै मै भी प्यार करुँ सूं,</para>
  <para style="q" vid="PRO 8:17">अर जो मन्‍नै जतन करकै तड़कै ए उठकै टोहवै से, वे मन्‍नै पावै सै।<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />धन अर मान-सम्मान,</para>
  <para style="q" vid="PRO 8:18">ठहरण आळा धन अर धार्मिकता मेरै धोरै सै।<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />मेरा फळ खरे सोन्‍ने तै,</para>
  <para style="q" vid="PRO 8:19">बल्के कुन्दन तै भी बढ़िया सै।</para>
  <para style="q" vid="PRO 8:19">अर मेरी फसल खरी चाँदी तै बढ़िया सै।<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />मै धर्म कै राह म्ह,</para>
  <para style="q" vid="PRO 8:20">अर न्याय के राह कै बीच म्ह चाल्‍लूँ सूं<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">मै धर्म की राह और न्याय की राह नै चलाऊ सूं</char></note>।<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />जिसतै मै अपणे प्रेमी माणसां नै धन-सम्पत्ति का भागी करुँ,</para>
  <para style="q" vid="PRO 8:21">अर उनके भण्डारां नै भर देऊँ।<verse eid="PRO 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22" />यहोवा नै मेरै ताहीं काम करण तै शरु म्ह,</para>
  <para style="q" vid="PRO 8:22">बल्के अपणे शरुआती काम्मां तै भी पैहले जण्या।<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />मै सदा तै बल्के शरु तै ए धरती की रचना करण तै पैहले ए तै ठहराई गई सूं।<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />जिब ना तो गहरा सागर था,</para>
  <para style="q" vid="PRO 8:24">अर ना पाणी के चोए थे, जिब तै ए मै पैदा होई।<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />जिब पहाड़ अर पहाड़ियाँ टिकाई न्ही गई थी,</para>
  <para style="q" vid="PRO 8:25">जिब्बे तै मै पैदा होई।<verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />जिब यहोवा नै ना तो धरती</para>
  <para style="q" vid="PRO 8:26">अर ना मैदान, ना दुनिया की धूळ के कण बणाए थे, इनतै पैहले मै पैदा होई।<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />जिब उसनै अकास ताहीं स्थिर करया, तब मै ओड़ै थी,</para>
  <para style="q" vid="PRO 8:27">जिब उसनै गहरे सागर कै उप्पर अकासमण्डल ताहीं ठैहराया,<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />जिब उसनै अकासमण्डल ताहीं उप्पर तै टिकाया,</para>
  <para style="q" vid="PRO 8:28">अर गहरे समुन्दर चोए फूट्टण लाग्गे,<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />जिब उसनै समुन्दर की हद ठहराई,</para>
  <para style="q" vid="PRO 8:29">ताके पाणी उसकै हुकम का उलंघण ना कर सकै,</para>
  <para style="q" vid="PRO 8:29">अर जिब वो धरती की नीम की डोरी लगावै था,<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />तो मै प्रधान कारीगर<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="fq" closed="false">प्रधान कारीगर </char><char style="ft" closed="false">प्यारी बच्‍ची </char></note> के समान उसकै धोरै थी;</para>
  <para style="q" vid="PRO 8:30">अर हर रोज मै उसकी खुशी थी,</para>
  <para style="q" vid="PRO 8:30">अर हर बखत उसकै स्याम्ही खुश रहूँ थी।<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />मै उसकी बसाई होई धरती तै खुश थी</para>
  <para style="q" vid="PRO 8:31">अर मेरा सुख माणसां की संगति तै होवै था।<verse eid="PRO 8:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />इस करकै इब हे मेरे बाळकों, मेरी सुणो;</para>
  <para style="q" vid="PRO 8:32">कितणे धन्य सै वे जो मेरी राह नै पकड़े रहवै सै।<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />शिक्षा नै सुणो, अर बुद्धिमान हो जाओ,</para>
  <para style="q" vid="PRO 8:33">उस ताहीं अनसुणी ना करो।<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />कितना धन्य सै वो माणस जो मेरी सुणै,</para>
  <para style="q" vid="PRO 8:34">बल्के मेरी देहळी पै रोज खड्या रहवै,</para>
  <para style="q" vid="PRO 8:34">अर मेरै दरवाजां के खम्बयाँ के धोरै निगांह लगाऐ रहवै सै।<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />क्यूँके जो मन्‍नै पावै सै, वो जीवन पावै सै,</para>
  <para style="q" vid="PRO 8:35">अर यहोवा उसतै राज्जी होवै सै।<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />पर जो मन्‍नै ढूँढ़ण म्ह नाकामयाब हो जावै सै,</para>
  <para style="q" vid="PRO 8:36">वो अपणा ए नुकसान करै सै,</para>
  <para style="q" vid="PRO 8:36">जितने मेरै तै बैर राक्खै सै, वे मौत तै मोह राक्खै सै।”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">ज्ञान की राह</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1" />बुद्धि नै अपणा घर बणाया</para>
  <para style="q" vid="PRO 9:1">अर उसके सात्तु खम्भे गढ़े होए सै।<verse eid="PRO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2" />उसनै भोज कै खात्तर अपणे पशु काटकै, अपणे दाखमधु म्ह मसाला मिलाया</para>
  <para style="q" vid="PRO 9:2">अर अपणी मेज लगाई सै।<verse eid="PRO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3" />उसनै अपणी नौकराणियाँ ताहीं बुलाण खात्तर भेज्या सै;</para>
  <para style="q" vid="PRO 9:3">अर वा नगर के सब तै ऊँच्‍चे स्थानां पै तै पुकारै सै,<verse eid="PRO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4" />“जो कोए भोळा सै वो बोहड़कै उरैए आवै!”</para>
  <para style="q" vid="PRO 9:4">अर जो बेअक्ला सै, उसतै वा कहवै सै,<verse eid="PRO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5" />“आओ, मेरी रोट्टी खाओ,</para>
  <para style="q" vid="PRO 9:5">अर मेरा मसाला मिलाया होया दाखमधु पीओ।<verse eid="PRO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6" />मूर्खां का साथ छोड़ो,</para>
  <para style="q" vid="PRO 9:6">अर जिन्दा रहो, समझ की राह म्ह सीध्धे चाल्‍लों।”<verse eid="PRO 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7" />जो मजाक करण आळा नै शिक्षा देवै सै, वो अपमानित होवै सै,</para>
  <para style="q" vid="PRO 9:7">अर जो दुष्ट माणस नै डाँटै सै वो कलंकित होवै सै।<verse eid="PRO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8" />मजाक उड़ाण आळे नै ना डाँटिये, इसा ना हो, के वो तेरे तै बैर करै,</para>
  <para style="q" vid="PRO 9:8">बुद्धिमान नै डाँट, वो तेरे तै प्यार करैगा।<verse eid="PRO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9" />बुद्धिमान नै शिक्षा दे, वो घणा बुद्धिमान होवैगा;</para>
  <para style="q" vid="PRO 9:9">धर्मी नै चेतावनी दे, वो अपणी शिक्षा बढ़ावैगा।<verse eid="PRO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10" />यहोवा का भय मानणा बुद्धि की शरुआत सै,</para>
  <para style="q" vid="PRO 9:10">अर परमपवित्र परमेसवर नै जाणणा ए समझ सै।<verse eid="PRO 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11" />मेरै जरिये ए तो तेरी उम्र बढ़ैगी,</para>
  <para style="q" vid="PRO 9:11">अर तेरी जिन्दगी के साल घणे होवैगें।<verse eid="PRO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12" />जै तू बुद्धिमान सै, तो बुद्धि का फळ तू ए भोग्गैगा;</para>
  <para style="q" vid="PRO 9:12">अर जै तू मजाक उड़ावैगा, तो सजा भी तू हे भोग्गैगा।<verse eid="PRO 9:12" /></para>
  <para style="s">मूर्खता का राह</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13" />मूर्खता बक-बक करण आळी जनान्‍नी के जिसी सै; वा तो बेअक्ली सै,</para>
  <para style="q" vid="PRO 9:13">अर कुछ न्ही जाणदी।<verse eid="PRO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14" />वा अपणे घर कै दरबाजे म्ह,</para>
  <para style="q" vid="PRO 9:14">अर नगर के ऊँच्‍चे स्थानां म्ह अपणे आसनां पै बैठ्ठी होई<verse eid="PRO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15" />वा उन माणसां तै जो अपणे राह पै जो सीध्धा चाल्‍लै सै या कहकै पुकारै सै,<verse eid="PRO 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16" />“जो कोए भोळा सै, वा बोहड़कै उरैए आवै,”</para>
  <para style="q" vid="PRO 9:16">अर जो बेअक्ले सै, उसतै वा कहवै सै,<verse eid="PRO 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17" />“चोरी का पाणी मिठ्ठा होवै सै,</para>
  <para style="q" vid="PRO 9:17">अर लुकै-छिपे की रोट्टी आच्छी लाग्गै सै,”<verse eid="PRO 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18" />वो न्ही जाणदा, के ओड़ै मरे होये पड़े सै,</para>
  <para style="q" vid="PRO 9:18">अर उस जनान्‍नी के जिमण आळे अधोलोक के निचले स्थानां म्ह पोहचे सै।<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">सुलैमान के ज्ञान की बातें</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 10:1" />सुलैमान के नीतिवचन।</para>
  <para style="q" vid="PRO 10:1">बुद्धिमान पिता तै बेट्टा राज्जी होवै सै,</para>
  <para style="q" vid="PRO 10:1">पर बेअक्ले बाळक तै माँ दुखी होवै सै।<verse eid="PRO 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2" />दुष्टां कै कमाए होए धन तै लाभ न्ही होन्दा,</para>
  <para style="q" vid="PRO 10:2">पर धर्म कै कारण मौत तै बचाव होवै सै।<verse eid="PRO 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3" />धर्मी नै यहोवा भूक्खा मरण न्ही देन्दा,</para>
  <para style="q" vid="PRO 10:3">पर दुष्टां की मर्जी वो पूरी होण न्ही देन्दा।<verse eid="PRO 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4" />जो काम म्ह ढिल करै सै, वो कंगाल हो जावै सै,</para>
  <para style="q" vid="PRO 10:4">पर मेहनती माणस अपणी मेहनत कै जरिये धनी होवै सै।<verse eid="PRO 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5" />बुद्धिमान बाळक घाम के बखत फसल कठ्ठी करै सै,</para>
  <para style="q" vid="PRO 10:5">पर जो बाळक लामणी के बखत गहरी नींद म्ह पड्या रहवै सै,</para>
  <para style="q" vid="PRO 10:5">वो शर्म का कारण होवै सै।<verse eid="PRO 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6" />धर्मी पै घणेए आशीर्वाद होवै सै,</para>
  <para style="q" vid="PRO 10:6">पर दुष्टां के मुँह म्ह उत्पात रहवै सै।<verse eid="PRO 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7" />धर्मी नै याद करकै लोग आशीर्वाद देवै सै,</para>
  <para style="q" vid="PRO 10:7">पर दुष्टां का नाम तक मिट जावै सै।<verse eid="PRO 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8" />जो बुद्धिमान सै, वो हुकमां नै मान्‍नै सै,</para>
  <para style="q" vid="PRO 10:8">पर जो बकवादी मूर्ख सै, उसका नाश होवै सै।<verse eid="PRO 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9" />जो खराई तै चाल्‍लै सै वो निडर चाल्‍लै सै,</para>
  <para style="q" vid="PRO 10:9">पर जो टेढ़ी चाल चाल्‍लै सै उसके लछण दिख जावै सै।<verse eid="PRO 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10" />जो नैन-मटक्‍का करै सै उसतै औरां नै दुख होवै सै,</para>
  <para style="q" vid="PRO 10:10">अर जो बकवादी मूर्ख सै, उसका नाश होवैगा<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">आमी-स्याम्ही बात करण तै शान्ति हो सै</char></note>।<verse eid="PRO 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11" />धर्मी का मुँह तो जीवन का चोवा सै,</para>
  <para style="q" vid="PRO 10:11">पर दुष्टां के मुँह म्ह उत्पात रहवै सै।<verse eid="PRO 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12" />बैर तै तो झगड़े बढै़ सै,</para>
  <para style="q" vid="PRO 10:12">पर प्यार सारी गलतियाँ नै माफ करदे<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">माफी</char></note> सै।<verse eid="PRO 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13" />समझ आळा की बात्तां म्ह बुद्धि पाई जावै सै,</para>
  <para style="q" vid="PRO 10:13">पर बेअक्लां खात्तर पीठ का कोड़ा सै।<verse eid="PRO 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14" />बुद्धिमान माणस ज्ञान नै बटोरै सै,</para>
  <para style="q" vid="PRO 10:14">पर मूर्ख कै बोलण तै नाश होवै सै।<verse eid="PRO 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15" />धनी का धन उसका मजबूत नगर सै,</para>
  <para style="q" vid="PRO 10:15">पर कंगाल की कंगाली उसके विनाश का कारण सै।<verse eid="PRO 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16" />धर्मी की मेहनत जीवन की और ले जावै सै;</para>
  <para style="q" vid="PRO 10:16">पर दुष्ट का लाभ पाप की ओड़ ले जावै सै।<verse eid="PRO 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17" />जो शिक्षा पै चाल्‍लै, वो जीवन की राह पै सै,</para>
  <para style="q" vid="PRO 10:17">पर जो डाँट तै मुँह मोड़ै, वो भटकै सै।<verse eid="PRO 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18" />जो बैर नै छिपावै सै, वो झूठ बोल्‍लै सै,</para>
  <para style="q" vid="PRO 10:18">अर जो झूठ्ठी बात फैलावै सै, वो मूर्ख सै।<verse eid="PRO 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19" />जड़ै भोत घणी बात होवै सै, ओड़ै अपराध भी होवै सै,</para>
  <para style="q" vid="PRO 10:19">पर जो अपणे मुँह नै बन्द राक्खै सै, वो बुद्धि तै काम करै सै।<verse eid="PRO 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20" />धर्मी के वचन तो खरी चाँदी सै;</para>
  <para style="q" vid="PRO 10:20">पर दुष्टां के मन की कोए कीमत न्ही होन्दी सै।<verse eid="PRO 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21" />धर्मी की बात्तां तै घणाए का पालन-पोषण होवै सै,</para>
  <para style="q" vid="PRO 10:21">पर मूर्ख माणस बेअक्ले होण कै कारण मर जावै सै।<verse eid="PRO 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22" />धन यहोवा की आशीष तै मिलै सै,</para>
  <para style="q" vid="PRO 10:22">अर उसकै गैल दुख न्ही मिलदा।<verse eid="PRO 10:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23" />मूर्ख नै तो घोर पाप करणा मजाक की बात लाग्गै सै,</para>
  <para style="q" vid="PRO 10:23">पर समझ आळे माणस म्ह बुद्धि खुशी की बात सै।<verse eid="PRO 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24" />दुष्ट माणस जिस बिप्दा तै डरै सै, वा उसपै आ पड़ै सै,</para>
  <para style="q" vid="PRO 10:24">पर धर्मी माणस की इच्छा पूरी होवै सै।<verse eid="PRO 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25" />दुष्ट माणस उस भम्बुळिये के जिसा सै,</para>
  <para style="q" vid="PRO 10:25">जो एक बार दिक्खण के बाद गायब हो जावै सै</para>
  <para style="q" vid="PRO 10:25">पर धर्मी सदा टिक्या रहवै सै।<verse eid="PRO 10:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26" />जिस तरियां दाँत नै सिरका, अर आँख नै धुम्मा,</para>
  <para style="q" vid="PRO 10:26">उसाए आलसी, उननै लाग्गै सै जो उसनै किते भेज्जै सै।<verse eid="PRO 10:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27" />यहोवा का भय मानण तै उम्र बढै़ सै,</para>
  <para style="q" vid="PRO 10:27">पर दुष्टां का जीवन थोड़े दिनां का ए होवै सै।<verse eid="PRO 10:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28" />धर्मियाँ नै आस राक्खण म्ह खुशी मिलै सै,</para>
  <para style="q" vid="PRO 10:28">पर दुष्टां की आस टूट जावै सै।<verse eid="PRO 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29" />यहोवा खरे माणसां का गढ़ ठहरै सै,</para>
  <para style="q" vid="PRO 10:29">पर अनर्थकारियाँ का नाश होवै सै।<verse eid="PRO 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30" />धर्मी सदा अटल रहवैगा,</para>
  <para style="q" vid="PRO 10:30">पर दुष्ट धरती पै बसण न्ही पावैगा।<verse eid="PRO 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31" />धर्मी कै मुँह तै बुद्धि टपकै सै,</para>
  <para style="q" vid="PRO 10:31">पर उल्ट फेर की बात करण आळे की जीभ काट्टी जावैगी।<verse eid="PRO 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32" />धर्मी मानण जोग्गी बात समझकै बोल्‍लै सै,</para>
  <para style="q" vid="PRO 10:32">पर दुष्टां कै मुँह तै उल्ट फेर की ए बात लिकड़ै सै।<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1" />छळ के तराजू तै यहोवा घृणा करै सै,</para>
  <para style="q" vid="PRO 11:1">पर वो पूरे बाट तै खुश होवै सै।<verse eid="PRO 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2" />जिब घमण्ड होवै सै, तो बेजती भी होवै सै,</para>
  <para style="q" vid="PRO 11:2">पर नम्र माणसां म्ह बुद्धि होवै सै।<verse eid="PRO 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3" />सीध्धे माणस अपणी खराई तै अगुवाई पावै सै,</para>
  <para style="q" vid="PRO 11:3">पर बिश्वासघाती अपणे कपट तै नाश होवै सै।<verse eid="PRO 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4" />परमेसवर के प्रकोप कै दिन धन तै तो कुछ लाभ न्ही होन्दा,</para>
  <para style="q" vid="PRO 11:4">पर धार्मिकता मौत तै भी बचावै सै।<verse eid="PRO 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5" />खरे माणस का राह धार्मिकता कै कारण सीध्धा होवै सै,</para>
  <para style="q" vid="PRO 11:5">पर दुष्ट अपणे दुष्टता कै कारण गिर जावै सै।<verse eid="PRO 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6" />सीध्धे लोग्गां का बचाव उनकी धार्मिकता कै कारण होवै सै,</para>
  <para style="q" vid="PRO 11:6">पर बिश्वासघाती माणस अपणी ए दुष्टता म्ह फँस जावै सै।<verse eid="PRO 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7" />जिब दुष्ट मरै, तो उसकी आस टूट जावै सै,</para>
  <para style="q" vid="PRO 11:7">अर अधर्मी की आस, बेकार होवै सै।<verse eid="PRO 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8" />धर्मी बिप्दा तै छूट जावै सै,</para>
  <para style="q" vid="PRO 11:8">पर दुष्ट उस्से बिप्दा म्ह पड़ जावै सै।<verse eid="PRO 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9" />भगतिहीन माणस अपणे पड़ोसी तै छोट्टी-छोट्टी बात्तां म्ह बिगाड़ लेवै सै,</para>
  <para style="q" vid="PRO 11:9">पर धर्मी माणस ज्ञान के कारण बचै सै।<verse eid="PRO 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10" />जिब धर्मियाँ का कल्याण होवै सै, तो नगर के लोग राज्जी होवै सै,</para>
  <para style="q" vid="PRO 11:10">पर जिब दुष्ट नाश होवै, तो जय-जयकार हो सै।<verse eid="PRO 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11" />सीध्धे माणसां के आशीर्वाद तै नगर की बढ़ोतरी हो सै,</para>
  <para style="q" vid="PRO 11:11">पर दुष्टां के मुँह की बात तै वो ढाया जावै सै।<verse eid="PRO 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12" />जो अपणे पड़ोसी नै तुच्छ जाणै सै, वो बेअक्ला सै,</para>
  <para style="q" vid="PRO 11:12">पर समझदार माणस चुपचाप रहवै सै।<verse eid="PRO 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13" />जो चुगली करदा फिरै सै वो भेद खोल्‍लै सै,</para>
  <para style="q" vid="PRO 11:13">पर बिश्वास लायक माणस भेद छिपा कै राक्खै सै।<verse eid="PRO 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14" />जड़ै बुद्धि की युक्ति न्ही, ओड़ै प्रजा बिप्दा म्ह पड़ै सै;</para>
  <para style="q" vid="PRO 11:14">पर घणे सलाहकारां कै कारण बचाव<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="fq" closed="false">बचाव </char><char style="ft" closed="false">जीत</char></note> होवै सै।<verse eid="PRO 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15" />जो परदेशी का जमानती होवै सै, वो घणा दुख ठावै सै,</para>
  <para style="q" vid="PRO 11:15">पर जो जमानत लेण तै नफरत करै सै, वो निडर रहवै सै।<verse eid="PRO 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16" />दया करण आळी जनान्‍नी अपणा मान-सम्मान कदे न्ही खोन्दी,</para>
  <para style="q" vid="PRO 11:16">अर गुसेल लोग धन नै न्ही खोन्दे।<verse eid="PRO 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17" />दयालु माणस अपणा ए भला करै सै, पर जो निर्दयी सै,</para>
  <para style="q" vid="PRO 11:17">वो अपणी ए देह नै दुख देवै सै।<verse eid="PRO 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18" />दुष्ट झूठ्ठी कमाई कमावै सै,</para>
  <para style="q" vid="PRO 11:18">पर जो धर्म का बीज बोवै सै, उसनै फळ जरुर मिलै सै।<verse eid="PRO 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19" />जो धार्मिकता म्ह मजबूत रहवै, वो जिन्दगी पावै सै,</para>
  <para style="q" vid="PRO 11:19">पर जो बुराई का पिच्छा करै, वो मर जावैगा।<verse eid="PRO 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20" />जो मन के टेढ़े सै, उनतै यहोवा नै घृणा आवै सै,</para>
  <para style="q" vid="PRO 11:20">पर वो खरी चाल-चाल्‍लण आळयां तै राज्जी रहवै सै।<verse eid="PRO 11:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21" />मै पूरे भरोस्से कै गैल कहूँ सूं, के बुरा माणस निर्दोष न्ही ठहरैगा,</para>
  <para style="q" vid="PRO 11:21">पर धर्मी का वंश बचाया जावैगा।<verse eid="PRO 11:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22" />जो सुन्दर जनान्‍नी विवेक न्ही राखदी,</para>
  <para style="q" vid="PRO 11:22">वा थूथन मै सोन्‍ने की नथ पहरे होड़ सूअर जिसी सै।<verse eid="PRO 11:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23" />धर्मियाँ की इच्छा तो सिर्फ भलाई की होवै सै;</para>
  <para style="q" vid="PRO 11:23">पर दुष्टां की आशा का फळ छो होवै सै।<verse eid="PRO 11:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24" />इसे सै, जो बिखरा देवै सै, तोभी उनकी बढ़ोतरी होवै सै;</para>
  <para style="q" vid="PRO 11:24">अर इसे भी सै जो जरूरत तै भी घाट देवै सै, अर इसतै उनकी घटती होवै सै।<verse eid="PRO 11:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25" />भला करण आळा माणस ठाड्डा हो जा सै,</para>
  <para style="q" vid="PRO 11:25">अर जो औरां के खेत्तां नै पाणी देवै सै, उसकी खेत्ती नै भी पाणी दिया जावैगा।<verse eid="PRO 11:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26" />जो अपणे अनाज की जमाखोरी करै सै, उसनै लोग श्राप देवै सै,</para>
  <para style="q" vid="PRO 11:26">पर जो उसनै बेच देवै सै, उसतै आशीर्वाद दिया जावै सै।<verse eid="PRO 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27" />जो जत्न तै भलाई करै सै, वो औरां की खुशी टोहवै सै,</para>
  <para style="q" vid="PRO 11:27">पर जो दुसरयां की बुराई का चाहण आळा होवै सै, उस्से पै बुराई आण पड़ै सै।<verse eid="PRO 11:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28" />जो अपणे धन पै भरोस्सा राक्खै सै वो सूक्खे पत्ते की ढाळ गिर जावै सै,</para>
  <para style="q" vid="PRO 11:28">पर धर्मी माणस हरे पत्ते की ढाळ लहरान्दे रहवै सै।<verse eid="PRO 11:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29" />जो अपणे घराने नै दुख देवै उसका हिस्सा हवा ए होवैगी,</para>
  <para style="q" vid="PRO 11:29">अर बेअक्ल बुद्धिमान का दास होवैगा।<verse eid="PRO 11:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30" />धर्मी का फळ जीवन का पेड़ हो सै,</para>
  <para style="q" vid="PRO 11:30">अर बुद्धिमान माणस लोग्गां कै मन नै मोह ले सै।<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="fq" closed="false">अर बुद्धिमान माणस लोग्गां कै मन नै मोह ले सै। </char><char style="ft" closed="false">लड़ाई-झगड़ा तै तो नाश ए होवै सै</char></note><verse eid="PRO 11:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31" />देख, धर्मी नै धरती पै फळ मिलैगा,</para>
  <para style="q" vid="PRO 11:31">तो यो भी पक्‍का सै कै दुष्ट अर पापी नै भी मिलैगा।<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1" />जो शिक्षा पाण म्ह प्यार राक्खै सै वो ज्ञान तै प्यार राक्खै सै,</para>
  <para style="q" vid="PRO 12:1">पर जो डाँट तै बैर राक्खै सै वो डांगर जिसा मूर्ख सै।<verse eid="PRO 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2" />भले माणस तै तो यहोवा राज्जी होवै सै,</para>
  <para style="q" vid="PRO 12:2">पर बुरी युक्ति करण आळे नै वो दोषी ठहरावै सै।<verse eid="PRO 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3" />कोए माणस दुष्टता कै कारण टिक न्ही सकदा,</para>
  <para style="q" vid="PRO 12:3">पर धर्मियाँ की जड़ कोनी उखड़ै।<verse eid="PRO 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4" />भली जनान्‍नी अपणे धणी का मुकुट सै,</para>
  <para style="q" vid="PRO 12:4">पर जो बेशर्मी के काम करै सै, मान्‍नो वा उसके हाड्डां कै सड़ण का कारण होवै सै।<verse eid="PRO 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5" />धर्मियाँ की सब कल्पना न्याय की ए हो सै,</para>
  <para style="q" vid="PRO 12:5">पर दुष्टां की तरकीब धोक्खा-धड़ी की हो सै।<verse eid="PRO 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6" />दुष्टां की बातचीत घात लगाण कै समान हो सै,</para>
  <para style="q" vid="PRO 12:6">पर भले माणस अपणे मुँह की बात तै छुड़ाणआळे हो सै।<verse eid="PRO 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7" />जिब दुष्ट माणस का नाश होवै सै तो उनका नामो-निशान मिट जावै सै,</para>
  <para style="q" vid="PRO 12:7">पर धर्मियाँ का घर टिक्या रहवै सै।<verse eid="PRO 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8" />माणस की बुद्धि कै मुताबिक उसकी बड़ाई होवै सै,</para>
  <para style="q" vid="PRO 12:8">पर बुरा माणस तुच्छ जाण्या जावै सै।<verse eid="PRO 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9" />जिसकै धोरै खाण खात्तर रोट्टी तक न्ही रहन्दी,</para>
  <para style="q" vid="PRO 12:9">पर अपणे बारै म्ह डींग मारै सै, उसतै नौक्‍कर राक्खण आळा साधारण माणस भी बढ़िया सै।<verse eid="PRO 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10" />धर्मी माणस अपणे पशु की जान की भी सुधि राक्खै सै,</para>
  <para style="q" vid="PRO 12:10">पर दुष्टां की दया भी निर्दयता सै।<verse eid="PRO 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11" />जो अपणी धरती नै जोत्तै, तो वो भर-पेट खावै सै,</para>
  <para style="q" vid="PRO 12:11">पर जो निठल्‍ले की संगत करै, वो बेअक्ले ठहरै सै।<verse eid="PRO 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12" />दुष्ट माणस बुरे माणसां कै लूट के माळ की आस देक्खै सै,</para>
  <para style="q" vid="PRO 12:12">पर धर्मियाँ की जड़ हरी-भरी रहवै सै।<verse eid="PRO 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13" />बुरा माणस अपणी कड़वी बात्तां कै कारण फंदे म्ह फंसै सै,</para>
  <para style="q" vid="PRO 12:13">पर धर्मी बिप्दा तै छुटकारा पावै सै।<verse eid="PRO 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14" />भला आदमी अपणी बात्तां कै फळ तै छिक्या रहवै सै,</para>
  <para style="q" vid="PRO 12:14">अर जिसी जिसकी करणी उसीए उसकी भरणी होवै सै।<verse eid="PRO 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15" />मूर्ख नै अपणी ए चाल सीध्धी लाग्गै सै,</para>
  <para style="q" vid="PRO 12:15">पर जो दूसरा की सलाह मान्‍नै सै, वो बुद्धिमान सै।<verse eid="PRO 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16" />मूर्ख की रिस जिब्बे दिख जा सै,</para>
  <para style="q" vid="PRO 12:16">पर बुद्धिमान माणस बेजती नै भी अनदेक्खा कर देवै सै।<verse eid="PRO 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17" />सच बोलण आळा, सच्‍ची गवाही देवै सै,</para>
  <para style="q" vid="PRO 12:17">पर जो झूठ्ठी गवाही देवै, वो धोक्खा-धड़ी जाहिर करै सै।<verse eid="PRO 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18" />इसे लोग भी सै जिनका बिना सोच विचार बोलणा तलवार की ढाळ चुभै सै,</para>
  <para style="q" vid="PRO 12:18">पर बुद्धिमान कै बोलण तै लोग चंगे होवै सै।<verse eid="PRO 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19" />सच्‍चाई सदा ए बणी रहवैगी,</para>
  <para style="q" vid="PRO 12:19">पर झूठ पल-भर का ए होवै सै।<verse eid="PRO 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20" />बुरी तरकीब सोच्‍चण आळयां कै मन म्ह धोक्खा-धड़ी रहवै सै,</para>
  <para style="q" vid="PRO 12:20">पर मेल की युक्ति करण आळे नै खुशी होवै सै।<verse eid="PRO 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21" />धर्मी नै नुकसान न्ही होन्दा,</para>
  <para style="q" vid="PRO 12:21">पर दुष्ट माणस घणी बिप्दा म्ह डूब जावै सै।<verse eid="PRO 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22" />झूठ्ठे माणसां तै यहोवा नै घृणा आवै सै,</para>
  <para style="q" vid="PRO 12:22">पर जो ईमानदारी तै काम करै सै, उनतै वो राज्जी होवै सै।<verse eid="PRO 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23" />बुद्धिमान माणस ज्ञान का दिखावा न्ही करदा,</para>
  <para style="q" vid="PRO 12:23">पर मूर्ख अपणे मन की मूर्खता का प्रचार ऊँच्‍ची आवाज म्ह करै सै।<verse eid="PRO 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24" />मेहनती माणस राज करै सै,</para>
  <para style="q" vid="PRO 12:24">पर आलसी मजदूरी खात्तर पकड़े जा सै।<verse eid="PRO 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25" />दुखी मन दब जावै सै,</para>
  <para style="q" vid="PRO 12:25">पर भली बात तै वो राज्जी होवै सै।<verse eid="PRO 12:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26" />धर्मी अपणे पड़ोसी नै भी राह दिखावै सै,</para>
  <para style="q" vid="PRO 12:26">पर दुष्ट लोग अपणी ए चाल कै कारण भटक जावै सै।<verse eid="PRO 12:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27" />आलसी शिकार का पिच्छा न्ही करदा,</para>
  <para style="q" vid="PRO 12:27">पर मेहनती नै सारी बेसकिमती चीज मिलै सै।<verse eid="PRO 12:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28" />धर्म की राह म्ह जीवन मिलै सै,</para>
  <para style="q" vid="PRO 12:28">अर उसकी राह म्ह मौत सै ही न्ही।<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1" />बुद्धिमान बेट्टा पिता की शिक्षा नै सुणै सै,</para>
  <para style="q" vid="PRO 13:1">पर मखौल करण आळा फटकार नै भी न्ही सुणदा।<verse eid="PRO 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2" />भला माणस अपणी बात्तां कै कारण बढ़िया चीज खाण पावै सै,</para>
  <para style="q" vid="PRO 13:2">पर बिश्वासघाती माणसां का पेट दंगे-फसाद तै भरै सै।<verse eid="PRO 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3" />जो अपणे मुँह की चौकसी करै सै, वो अपणी जान की हिफाजत करै सै,</para>
  <para style="q" vid="PRO 13:3">पर जो घणा बोल्‍लै सै, उसका नाश हो जावै सै।<verse eid="PRO 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4" />आलसी का जी आस तो करै सै, पर उसनै कुछ न्ही मिलदा,</para>
  <para style="q" vid="PRO 13:4">पर मेहनती की सारी अभिलाषा पूरी हो जावै सै।<verse eid="PRO 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5" />धर्मी झूठ्ठी बात तै बैर राक्खै सै,</para>
  <para style="q" vid="PRO 13:5">पर दुष्ट अपणी शर्मिन्दगी का कारण हो जावै सै, अर शर्मिन्दा हो जावै सै।<verse eid="PRO 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6" />धार्मिकता खरी चाल चालण आळे की हिफाजत करै सै,</para>
  <para style="q" vid="PRO 13:6">पर पापी अपणी दुष्टता कै कारण उखड़ जावै सै।<verse eid="PRO 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7" />कोए तो धन कठ्ठा करै सै, पर उसके धोरै कुछ न्ही रहन्दा,</para>
  <para style="q" vid="PRO 13:7">अर कोए धन उड़ा दे सै, तोभी उसकै धोरै भतेरा रहवै सै।<verse eid="PRO 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8" />धनी माणस की जान की छुड़ौती उसके धन तै हो सै,</para>
  <para style="q" vid="PRO 13:8">पर कंगाल इसी धमकी नै सुणदा भी कोनी।<verse eid="PRO 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9" />धर्मियाँ का चाँदणा खुशी गैल चमकै सै,</para>
  <para style="q" vid="PRO 13:9">पर दुष्टां का दीवा बुझ जावै सै।<verse eid="PRO 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10" />घमण्ड तै सिर्फ झगड़े होवै सै,</para>
  <para style="q" vid="PRO 13:10">पर जो माणस सलाह मान्‍नै सै, उनकै धोरै बुद्धि रहवै सै।<verse eid="PRO 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11" />धोक्खे तै कमाया धन तावळा खतम हो जावै सै,</para>
  <para style="q" vid="PRO 13:11">पर जो अपणी मेहनत तै कठ्ठा करै सै, उसकै बढ़ोतरी होवै सै।<verse eid="PRO 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12" />जिब आस पूरी होण म्ह देर होवै सै, तो मन उदास हो जावै सै,</para>
  <para style="q" vid="PRO 13:12">पर जिब आस पूरी हो जावै सै, तो जीवन का पेड़ लाग्गै सै।<verse eid="PRO 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13" />जो वचन नै तुच्छ जाणै सै, उसका नाश हो जावै सै,</para>
  <para style="q" vid="PRO 13:13">पर हुकम नै मानण आळा नै आच्छा फळ मिलै सै।<verse eid="PRO 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14" />बुद्धिमान की शिक्षा जीवन का चोवा सै,</para>
  <para style="q" vid="PRO 13:14">अर उसकै कारण माणस मौत कै फंदे तै बच सकै सै।<verse eid="PRO 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15" />समझदारी कै कारण दया होवै सै,</para>
  <para style="q" vid="PRO 13:15">पर धोक्खेबाज माणसां का राह मुश्किल होवै सै।<verse eid="PRO 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16" />बुद्धिमान माणस तो समझ तै काम करै सै,</para>
  <para style="q" vid="PRO 13:16">पर मूर्ख अपणी मूर्खता फैलावै सै।<verse eid="PRO 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17" />दुष्ट दूत मुसीबत म्ह ए फँस्या रहवै सै,</para>
  <para style="q" vid="PRO 13:17">पर बिश्वासयोग्य दूत मिलाप करवावै सै।<verse eid="PRO 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18" />जो शिक्षा नै सुणी-अनसुणी करै, वो कंगाल होवै सै अर निरादर पावै सै,</para>
  <para style="q" vid="PRO 13:18">पर जो डाँट नै मान्‍नै सै, उसकी बड़ाई होवै सै।<verse eid="PRO 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19" />लालसा का पूरा होणा तो जी नै मिठ्ठा लाग्गै सै,</para>
  <para style="q" vid="PRO 13:19">पर बुराई तै हटणा, मूर्खां कै जी नै बुरा लाग्गै सै।<verse eid="PRO 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20" />बुद्धिमानां की संगत कर, तो तू भी बुद्धिमान हो जावैगा,</para>
  <para style="q" vid="PRO 13:20">पर मूर्खां का साथी नाश हो जावैगा।<verse eid="PRO 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21" />विपत्ति पापियाँ कै पाच्छै लाग्गी रहवै सै,</para>
  <para style="q" vid="PRO 13:21">पर धर्मियाँ नै आच्छा फळ मिलै सै।<verse eid="PRO 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22" />भला माणस अपणे नात्ती-पोत्यां खात्तर सम्पत्ति छोड़ जावै सै,</para>
  <para style="q" vid="PRO 13:22">पर पापी की सम्पत्ति धर्मी कै खात्तर राक्खी जावै सै।<verse eid="PRO 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23" />कमजोर माणसां नै खेत्ती-बाड़ी म्ह तै भोत खाण-पीण की चीज मिलै सै,</para>
  <para style="q" vid="PRO 13:23">पर अन्याय तै उस ताहीं हड़प लिया जावै सै।<verse eid="PRO 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24" />जो अपणे बेट्टे पै छड़ी न्ही चलान्दा वो उसका बैरी सै,</para>
  <para style="q" vid="PRO 13:24">पर जो उसतै प्यार राक्खै, वो उसनै जतन तै शिक्षा देवै सै।<verse eid="PRO 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25" />धर्मी भर पेट खाण पावै सै,</para>
  <para style="q" vid="PRO 13:25">पर दुष्ट भूक्खे रह जावै सै।<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1" />हर बुद्धिमान जनान्‍नी अपणे घर नै बणावै सै,</para>
  <para style="q" vid="PRO 14:1">पर मूर्ख जनान्‍नी उसनै अपणे हाथ तै ढ़ा देवै सै।<verse eid="PRO 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2" />जो सिधाई तै चाल्‍लै सै वो यहोवा का भय मानण आळा सै,</para>
  <para style="q" vid="PRO 14:2">पर जो टेढ़ी चाल चाल्‍लै सै वो उसनै तुच्छ जाणण आळा ठहरावै सै।<verse eid="PRO 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3" />मूर्ख कै मुँह म्ह घमण्ड का बीज सै<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">मूर्ख के मुँह तै लिकड़ी बात उन खात्तर एक छड़ी सै</char></note>,</para>
  <para style="q" vid="PRO 14:3">पर बुद्धिमान माणस अपणी बात्तां कै कारण हिफाजत पावै सै<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">अपणे घमण्ड के कारण मूर्ख माणस हद तै ज्यादा बोल्‍लै सै</char></note><verse eid="PRO 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4" />जड़ै जोत्तण आळे बळध न्ही होन्दे, ओड़ै गऊशाळा साफ तो रहवै सै,</para>
  <para style="q" vid="PRO 14:4">पर बळध की ताकत तै अनाज की बढ़ोतरी होवै सै।<verse eid="PRO 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5" />सच्‍चा गवाह झूठ न्ही बोल्दा,</para>
  <para style="q" vid="PRO 14:5">पर झूठ्ठा गवाह, झूठ्ठी बात उड़ावै सै।<verse eid="PRO 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6" />मखौल करण आळा बुद्धि नै टोहवै सै, पर न्ही पान्दा,</para>
  <para style="q" vid="PRO 14:6">पर समझ आळे नै ज्ञान आसान्‍नी तै मिल जावै सै।<verse eid="PRO 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7" />मूर्ख तै दूर हो जा, तू उसतै ज्ञान की बात न्ही पावैगा।<verse eid="PRO 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8" />बुद्धिमान की बुद्धि अपणी चाल नै जाणणा सै,</para>
  <para style="q" vid="PRO 14:8">पर मूर्खां की मूर्खता धोक्खा-धड़ी करणा सै।<verse eid="PRO 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9" />मूर्ख माणस पाप मान लेण नै मजाक जाणै सै,</para>
  <para style="q" vid="PRO 14:9">पर सीध्धे माणसां कै बीच दया होवै सै।<verse eid="PRO 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10" />मन अपणा ए दुख जाणै सै,</para>
  <para style="q" vid="PRO 14:10">अर परदेशी उसके खुशी म्ह शामिल न्ही हो सकदा।<verse eid="PRO 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11" />दुष्टां के घरां का नाश हो जावै सै,</para>
  <para style="q" vid="PRO 14:11">पर भले माणसां कै तम्बूआं म्ह भी चहल-पहल रहवै सै।<verse eid="PRO 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12" />इसा राह सै, जो माणस नै ठीक दिक्खै सै,</para>
  <para style="q" vid="PRO 14:12">पर उसकै आखर म्ह मौत ए मिलै सै।<verse eid="PRO 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13" />खुशी के बखत भी मन उदास होवै सै,</para>
  <para style="q" vid="PRO 14:13">अर खुशी कै आखर म्ह दुख होवै सै।<verse eid="PRO 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14" />जो बेईमान सै, वो अपणे चाल-चलण का फळ भोग्गै सै।</para>
  <para style="q" vid="PRO 14:14">पर भला माणस आप्पे-आप संतुष्ट होवै सै।<verse eid="PRO 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15" />भोळा तो हरेक बात नै सच मान्‍नै सै,</para>
  <para style="q" vid="PRO 14:15">पर समझदार माणस सूझ-बूझकै चाल्‍लै सै।<verse eid="PRO 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16" />बुद्धिमान प्रभु तै डरकै बुराई तै हट जावै सै,</para>
  <para style="q" vid="PRO 14:16">पर मूर्ख ढीठ हो कै हिदायत की अनदेक्खी करै सै।<verse eid="PRO 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17" />जो झट गुस्सा करै, वो मूर्खता का काम भी करैगा,</para>
  <para style="q" vid="PRO 14:17">अर जो बुरी योजना बणावै सै, उसतै लोग बैर राक्खै सै।<verse eid="PRO 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18" />भोळा का हिस्सा मूर्खता ए हो सै,</para>
  <para style="q" vid="PRO 14:18">पर समझदार माणस कै ज्ञान रूपी ताज धरया जावै सै।<verse eid="PRO 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19" />बुरे माणस भले माणसां के स्याम्ही,</para>
  <para style="q" vid="PRO 14:19">अर दुष्ट माणस धर्मी की फाटक पै झुककै प्रणाम करैगें।<verse eid="PRO 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20" />गरीब का पड़ोसी भी उसतै नफरत करै सै,</para>
  <para style="q" vid="PRO 14:20">पर धनवान के घणे प्रेमी हो सै।<verse eid="PRO 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21" />जो अपणे पड़ोसी नै तुच्छ जाणै सै, वो पाप करै सै,</para>
  <para style="q" vid="PRO 14:21">पर जो गरीब माणसां पै दया करै सै, वो धन्य होवै सै।<verse eid="PRO 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22" />जो बुरी तरकीब लिकाड़ै सै, के वे भ्रम म्ह न्ही पड़दे?</para>
  <para style="q" vid="PRO 14:22">पर भली तरकीब लिकाड़ण आळा तै दया अर सच्‍चाई का बरताव करया जावै सै।<verse eid="PRO 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23" />मेहनत तै सदा लाभ होवै सै,</para>
  <para style="q" vid="PRO 14:23">पर बकवाद करण तै सिर्फ घाट्टा होवै सै।<verse eid="PRO 14:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24" />बुद्धिमानां का धन उनका ताज ठहरै सै,</para>
  <para style="q" vid="PRO 14:24">पर मूर्ख तै निरी मूर्खता ए पैदा होवै सै।<verse eid="PRO 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25" />सच्‍चा गवाह घणेए की जान बचावै सै।</para>
  <para style="q" vid="PRO 14:25">पर जो झूठ्ठी बात उड़ाया करै सै, उसकै गैल धोक्खा ए हो सै।<verse eid="PRO 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26" />यहोवा का भय मानण आळे का भरोस्सा मजबूत होवै सै,</para>
  <para style="q" vid="PRO 14:26">अर यो उसके बाळकां खात्तर शरणस्‍थान होवैगा।<verse eid="PRO 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27" />यहोवा का भय मानणा, जीवन का चोवा सै,</para>
  <para style="q" vid="PRO 14:27">अर उसके कारण माणस मौत कै फंदे तै बच जावै सै।<verse eid="PRO 14:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28" />राजा की बड़ाई प्रजा की भीड़ तै हो सै,</para>
  <para style="q" vid="PRO 14:28">पर जड़ै प्रजा न्ही, ओड़ै हाकिम नाश हो जावै सै।<verse eid="PRO 14:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29" />जो देर तै गुस्सा करण आळा सै वो बड़ा समझ आळा सै,</para>
  <para style="q" vid="PRO 14:29">पर जो तावळ करै सै, वो मूर्खता की बढ़ोतरी करै सै।<verse eid="PRO 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30" />शान्त मन, तन का जीवन सै,</para>
  <para style="q" vid="PRO 14:30">पर मन की जळण तै हड्डियाँ भी गळ जावै सै।<verse eid="PRO 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31" />जो कंगाल पै मनमान्‍नी करै, वो उसकै कर्ता की बुराई करै सै,</para>
  <para style="q" vid="PRO 14:31">पर जो गरीब पै दया करै, वो उसकी बड़ाई करै सै।<verse eid="PRO 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32" />दुष्ट माणस बुराई करदा होया नाश हो जावै सै,</para>
  <para style="q" vid="PRO 14:32">पर धर्मी नै मौत के बखत<note caller="+" style="f"><char style="fr" closed="false">14:32 </char><char style="fq" closed="false">मौत के बखत </char><char style="ft" closed="false">मौत कै बखत</char></note> भी शरण मिलै सै।<verse eid="PRO 14:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33" />समझ आळे कै मन म्ह बुद्धि वास करे रहवै सै,</para>
  <para style="q" vid="PRO 14:33">पर मूर्ख माणस बुद्धि कै बारै म्ह कुछ भी न्ही जाणदा।<verse eid="PRO 14:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34" />जात्ति की बढ़ोतरी धार्मिकता तै ए होवै सै,</para>
  <para style="q" vid="PRO 14:34">पर पाप तै देश के माणसां का निरादर हो सै।<verse eid="PRO 14:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35" />जो कर्मचारी बुद्धि तै काम करै सै उसपै राजा खुश हो सै,</para>
  <para style="q" vid="PRO 14:35">पर जो शर्म के काम करै, उसपै वो गुस्सा करै सै।<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1" />नरम जवाब सुणण तै गुस्सा ठण्डा हो जावै सै,</para>
  <para style="q" vid="PRO 15:1">पर कड़वी बात तै गुस्सा भड़क जावै सै।<verse eid="PRO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2" />बुद्धिमान ज्ञान का सही जिक्र करै सै,</para>
  <para style="q" vid="PRO 15:2">पर मूर्खां कै मुँह तै मूर्खता उबळै सै।<verse eid="PRO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3" />यहोवा की आँख सारी जगहां लाग्गी रहवै सै,</para>
  <para style="q" vid="PRO 15:3">वो बुरे अर भले दोनुआं नै देखदी रहवै सै।<verse eid="PRO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4" />शान्ति देण आळी बात जीवन का दरखत सै,</para>
  <para style="q" vid="PRO 15:4">पर उल्ट फेर की बात्तां तै आत्मा दुखी होवै सै।<verse eid="PRO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5" />मूर्ख अपणे पिता की शिक्षा का तिरस्कार करै सै,</para>
  <para style="q" vid="PRO 15:5">पर जो डाँट नै मान्‍नै सै, वो समझदार हो जावै सै।<verse eid="PRO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6" />धर्मी कै घर मै घणा धन रहवै सै,</para>
  <para style="q" vid="PRO 15:6">पर दुष्ट की कमाई म्ह भी टोट्टा ए रहवै सै।<verse eid="PRO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7" />बुद्धिमान माणस बात करण तै ज्ञान नै फैलावै सै,</para>
  <para style="q" vid="PRO 15:7">पर मूर्खां का मन ठीक न्ही रहन्दा।<verse eid="PRO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8" />दुष्ट माणसां कै बलिदान तै यहोवा नफरत करै सै,</para>
  <para style="q" vid="PRO 15:8">पर वो सीध्धे माणसां की बिनती तै राज्जी होवै सै।<verse eid="PRO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9" />दुष्ट कै चाल-चलण तै यहोवा नै घृणा आवै सै,</para>
  <para style="q" vid="PRO 15:9">पर जो धार्मिकता का पिच्छा करै सै, उसतै वो प्यार करै सै।<verse eid="PRO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10" />जो सही राह नै छोड़ देवै सै, उसनै घणी ताड़ना मिलै सै,</para>
  <para style="q" vid="PRO 15:10">अर जो डाँट तै बैर राक्खै, वो जरुर मर जावै सै।<verse eid="PRO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11" />जिब के अधोलोक अर विनाशलोक यहोवा कै स्याम्ही खुल्‍ले रहवै सै,</para>
  <para style="q" vid="PRO 15:11">तो पक्‍का माणसां के मन भी।<verse eid="PRO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12" />मखौल कराण आळा डाँटण तै राज्जी न्ही होन्दा,</para>
  <para style="q" vid="PRO 15:12">अर ना वो बुद्धिमान माणसां कै धोरै जान्दा।<verse eid="PRO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13" />मन राज्जी रहण तै मुँह पै भी रौनक आ जावै सै,</para>
  <para style="q" vid="PRO 15:13">पर मन कै दुख होण तै आत्मा निराश होवै सै।<verse eid="PRO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14" />समझण आळे का मन ज्ञान की टोह् म्ह रहवै सै,</para>
  <para style="q" vid="PRO 15:14">पर मूर्ख लोग मूर्खता तै पेट भरै सै।<verse eid="PRO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15" />दु:खियारे के सारे दिन दुख भरे रहवै सै,</para>
  <para style="q" vid="PRO 15:15">पर जिसका मन राज्जी रहवै सै, वो मान्‍नो रोज दावत म्ह जान्दा हो।<verse eid="PRO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16" />घबराहट कै गैल धरे होए धन तै,</para>
  <para style="q" vid="PRO 15:16">यहोवा कै भय के गैल धरा होया थोड़ा धन भी घणा बढ़िया सै,<verse eid="PRO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17" />प्यार राक्खण आळे कै घर म्ह सागपात का खाणा,</para>
  <para style="q" vid="PRO 15:17">बैर राक्खण आळे घर म्ह स्वादिष्ट माँस खाण तै घणा आच्छा सै।<verse eid="PRO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18" />गुसेल माणस झगड़ा करै सै,</para>
  <para style="q" vid="PRO 15:18">पर जो देर तै गुस्सा करण आळा सै, वो मुकद्दमां नै दबा देवै सै।<verse eid="PRO 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19" />आलसी का राह काँड्या तै भरया होया होवै सै,</para>
  <para style="q" vid="PRO 15:19">पर सीध्धे माणसां का राह राजमार्ग ठहरै सै।<verse eid="PRO 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20" />बुद्धिमान बेट्टे तै पिता राज्जी हो सै,</para>
  <para style="q" vid="PRO 15:20">पर मूर्ख अपणी माँ नै तुच्छ जाणै सै।<verse eid="PRO 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21" />मूर्ख नै मूर्खता तै खुशी मिलै सै,</para>
  <para style="q" vid="PRO 15:21">पर समझ आळा सीध्धी चाल चाल्‍लै सै।<verse eid="PRO 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22" />बिना सलाह की तरकीब फैल हो जावै सै,</para>
  <para style="q" vid="PRO 15:22">पर भोत-से मंत्रियाँ की सलाह तै कामयाबी मिलै सै।<verse eid="PRO 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23" />भला माणस जवाब देण तै राज्जी होवै सै,</para>
  <para style="q" vid="PRO 15:23">अर मौक्‍कै पै कह्या होया वचन ए भला हो सै!<verse eid="PRO 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24" />बुद्धिमान खात्तर जीवन का राह उप्पर की ओड़ जावै सै,</para>
  <para style="q" vid="PRO 15:24">इस रीति तै वो अधोलोक म्ह पड़ण तै बच जावै सै।<verse eid="PRO 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25" />यहोवा घमण्डियाँ के घर नै ढ़ा देवै सै,</para>
  <para style="q" vid="PRO 15:25">पर बिधवा की बाड़ नै अटल राक्खै सै।<verse eid="PRO 15:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26" />बुरे विचार यहोवा नै घिनोणे लाग्गै सै,</para>
  <para style="q" vid="PRO 15:26">पर शुद्ध माणस के वचन मन नै भावण आळे सै।<verse eid="PRO 15:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27" />लालची अपणे कुण्बे नै दुख दे सै,</para>
  <para style="q" vid="PRO 15:27">पर रिसवत तै नफरत करण आळा जिन्दा रहवै सै।<verse eid="PRO 15:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28" />धर्मी मन म्ह सोच्‍चै सै के मै के जवाब देऊँ,</para>
  <para style="q" vid="PRO 15:28">पर दुष्टां कै मुँह तै बुरी ए बात लिकड़ै सै।<verse eid="PRO 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29" />यहोवा दुष्टां तै दूर रहवै सै,</para>
  <para style="q" vid="PRO 15:29">पर धर्मियाँ की प्रार्थना सुणै सै।<verse eid="PRO 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30" />हस्ते होए चेहरे<note caller="+" style="f"><char style="fr" closed="false">15:30 </char><char style="fq" closed="false">हस्ते होए चेहरे </char><char style="ft" closed="false">आँखां की चमक</char></note> तै मन नै खुशी मिलै सै,</para>
  <para style="q" vid="PRO 15:30">अर आच्छी खबर तै शरीर<note caller="+" style="f"><char style="fr" closed="false">15:30 </char><char style="ft" closed="false">हाड्डी</char></note> मजबूत होवै सै।<verse eid="PRO 15:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31" />जो जीवन देण आळी डाँट-फटकार नै कान लगाकै सुणै सै,</para>
  <para style="q" vid="PRO 15:31">वो बुद्धिमानां कै गैल ठिकाणा पावै सै।<verse eid="PRO 15:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32" />जो शिक्षा नै अनसुणी करै, वो अपणी जान का बैरी हो सै,</para>
  <para style="q" vid="PRO 15:32">पर जो डाँट नै सुणै, वो बुद्धि पावै सै।<verse eid="PRO 15:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33" />यहोवा का भय मानण तै बुद्धि की शिक्षा मिलै सै,</para>
  <para style="q" vid="PRO 15:33">अर बड़ाई तै पैहल्या नरमाई आवै सै।<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1" />मन की योजना माणस कै बस म्ह रहवै सै,</para>
  <para style="q" vid="PRO 16:1">पर सही जवाब यहोवा की ओड़ तै होवै सै।<verse eid="PRO 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2" />माणस का सारा चाल-चलण अपणी निगांह म्ह पवित्र ठहरै सै,</para>
  <para style="q" vid="PRO 16:2">पर यहोवा मन नै तोल्‍लै सै।<verse eid="PRO 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3" />अपणे काम्मां नै यहोवा पै छोड़ दे,</para>
  <para style="q" vid="PRO 16:3">इसे तै तेरी योजना सिध्द होवैगी।<verse eid="PRO 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4" />यहोवा नै सारी चीज खास मकसद कै खात्तर बणाई सै,</para>
  <para style="q" vid="PRO 16:4">बल्के दुष्ट<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="fq" closed="false">दुष्ट </char><char style="ft" closed="false">शैतान </char></note> ताहीं भी बिप्दा भोग्गण कै खात्तर बणाया सै।<verse eid="PRO 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5" />सारे मन कै घमण्डियाँ तै यहोवा घृणा कर सै,</para>
  <para style="q" vid="PRO 16:5">मै पक्‍के बिश्वास तै कहूँ सूं इसे माणस दोषी ठहरैगें।<verse eid="PRO 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6" />अधर्म का प्रायश्चित कृपा, अर सच्‍चाई तै होवै सै,</para>
  <para style="q" vid="PRO 16:6">अर यहोवा का भय मानण तै माणस बुराई करण तै बच जावै सै।<verse eid="PRO 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7" />जब किसे का चाल-चलण यहोवा नै भावै सै,</para>
  <para style="q" vid="PRO 16:7">तब वो उसके दुश्मनां का भी उसतै मेल करावै सै।<verse eid="PRO 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8" />अन्याय के बड़े लाभ तै,</para>
  <para style="q" vid="PRO 16:8">न्याय तै थोड़ा ए पाणा भला सै।<verse eid="PRO 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9" />माणस मन म्ह अपणे राह पै विचार करै सै,</para>
  <para style="q" vid="PRO 16:9">पर यहोवा ए उसके पैरां नै टिकावै सै।<verse eid="PRO 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10" />राजा कै मुँह तै देववाणी लिकड़ै सै,</para>
  <para style="q" vid="PRO 16:10">न्याय करण म्ह उसतै चूक न्ही होन्दी।<verse eid="PRO 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11" />सच्‍चा तराजू अर पलड़े यहोवा की ओड़ तै होवै सै,</para>
  <para style="q" vid="PRO 16:11">थैल्‍ली म्ह जितने बाट सै, सारे उसकै बणवाए होए सै।<verse eid="PRO 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12" />दुष्टता करणा राजां कै खात्तर घृणा का काम सै,</para>
  <para style="q" vid="PRO 16:12">क्यूँके उनकी गद्दी धार्मिकता तै ए डटी रहवै सै।<verse eid="PRO 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13" />धर्म की बात बोलण आळा तै राजा खुश होवै सै,</para>
  <para style="q" vid="PRO 16:13">अर जो सीध्धी बात बोल्‍लै सै, उसतै वो प्यार करै सै।<verse eid="PRO 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14" />राजा का गुस्सा मौत के दूत कै जिसा सै,</para>
  <para style="q" vid="PRO 16:14">पर बुद्धिमान माणस उसनै ठण्डा करै सै।<verse eid="PRO 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15" />राजा कै मुँह की चमक म्ह जीवन रहवै सै,</para>
  <para style="q" vid="PRO 16:15">अर उसकी खुशी बरसात के अन्त की घटा कै जिसी होवै सै।<verse eid="PRO 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16" />बुद्धि का मिल जाणा खरे सोन्‍ने तै बढ़कै सै!</para>
  <para style="q" vid="PRO 16:16">अर समझ का मिल जाणा चाँदी तै बढ़कै सै।<verse eid="PRO 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17" />बुराई तै हट जाणा धर्मी माणसां कै खात्तर सही राह सै,</para>
  <para style="q" vid="PRO 16:17">जो अपणे चाल-चलण की चौकसी करै सै, वो अपणे प्राण की भी रुखाळी करै सै।<verse eid="PRO 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18" />विनाश तै पैहले गर्व,</para>
  <para style="q" vid="PRO 16:18">अर ठोक्‍कर खाण तै पैहले घमण्ड आवै सै।<verse eid="PRO 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19" />घमण्डियाँ कै गैल लूट-बाँट लेण तै,</para>
  <para style="q" vid="PRO 16:19">दीन माणसां के गैल नम्र भाव तै रहणा बढ़िया सै।<verse eid="PRO 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20" />जो वचन पै मन लगावै सै, वो कल्याण पावै सै,</para>
  <para style="q" vid="PRO 16:20">अर जो यहोवा पै भरोस्सा राक्खै, वो धन्य होवै सै।<verse eid="PRO 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21" />जिसके मन म्ह बुद्धि सै, वो समझ आळा कुहवावै सै,</para>
  <para style="q" vid="PRO 16:21">अर मिठ्ठी वाणी के जरिये ज्ञान बढ़ै सै।<verse eid="PRO 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22" />जिस म्ह बुद्धि सै, उसकै खात्तर वो जीवन का चोवा सै,</para>
  <para style="q" vid="PRO 16:22">पर मूर्ख की सजा खुद उसकी मूर्खता होवै सै।<verse eid="PRO 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23" />बुद्धिमान का मन उसकै मुँह पै भी बुद्धिमान जाहिर करै सै,</para>
  <para style="q" vid="PRO 16:23">अर उसकै वचन म्ह विद्या रहवै सै।<verse eid="PRO 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24" />मन नै भावण आळे वचन माळ के छत्ते कै जिसे मन नै मीठ्ठे लाग्गै,</para>
  <para style="q" vid="PRO 16:24">अर हाड्डियाँ नै हरा-भरा करै सै।<verse eid="PRO 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25" />इसा भी राह सै, जो माणस नै सीध्धा लाग्गै सै,</para>
  <para style="q" vid="PRO 16:25">पर उसकै अन्त म्ह मौत ए मिलै सै।<verse eid="PRO 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26" />मेहनती की लालसा उसके खात्तर मेहनत करै सै,</para>
  <para style="q" vid="PRO 16:26">उसकी भूख उसनै उभारदी रहवै सै।<verse eid="PRO 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27" />अधर्मी माणस बुराई की तरकीब लिकाड़ै सै,</para>
  <para style="q" vid="PRO 16:27">अर उसके वचनां तै आग लाग जावै सै।<verse eid="PRO 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28" />टेढ़ा माणस भोत झगड़े करावै सै,</para>
  <para style="q" vid="PRO 16:28">अर कानाफूसी करण आळा गहरे दोस्तां म्ह भी फूट गिरवा देवै सै।<verse eid="PRO 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29" />उपद्रवी माणस अपणे पड़ोसी नै भकाकै बुरे राह पै चलावै सै।<verse eid="PRO 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30" />आँख मुन्दण आळा छल की कल्पना करै सै,</para>
  <para style="q" vid="PRO 16:30">अर होठ दबाण आळा बुराई करै सै।<verse eid="PRO 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31" />पक्‍के बाल शोभायमान मुकुट ठहरै सै;</para>
  <para style="q" vid="PRO 16:31">वे धर्म की राह पै चालण तै मिलै सै।<verse eid="PRO 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32" />देर तै छो करणा वीरता तै,</para>
  <para style="q" vid="PRO 16:32">अर अपणे मन नै बस म्ह राखणा, नगर नै जीत लेण तै बढ़िया सै।<verse eid="PRO 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33" />चिट्ठी लिकाड़ी जावै तो सै,</para>
  <para style="q" vid="PRO 16:33">पर उसका लिकड़णा यहोवा ए कै ओड़ तै होवै सै।<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1" />चैन कै गैल सूक्खा टुकड़ा, उस घर की जगहां तै बढ़िया सै,</para>
  <para style="q" vid="PRO 17:1">जो मेलबलि-पशुआं तै भरया हो, अर उस म्ह झगड़े-रगड़े हो।<verse eid="PRO 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2" />बुद्धि तै चालण आळा नौक्‍कर अपणे माल्‍लिक कै उस बेट्टे पै राज करैगा, जो शर्म का कारण होवै सै,</para>
  <para style="q" vid="PRO 17:2">अर उस बेट्टे के भाईयाँ कै गैल विरासत म्ह साझी होवैगा।<verse eid="PRO 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3" />चाँदी कै खात्तर कुठाळी अर सोन्‍ने कै खात्तर भट्ठी होवै सै,</para>
  <para style="q" vid="PRO 17:3">पर मनां नै यहोवा जाँच्‍चै सै।<verse eid="PRO 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4" />कुकर्मी अनर्थ बात नै ध्यान देकै सुणै सै,</para>
  <para style="q" vid="PRO 17:4">अर झूठ्ठा माणस दुष्टता की बात की ओड़ कान लगावै सै।<verse eid="PRO 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5" />जो गरीब का मजाक उड़ावै सै, वो उसकै बणाण आळे की बुराई करै सै,</para>
  <para style="q" vid="PRO 17:5">अर जो किसे की बिप्दा पै हाँस्सै सै, वो बेकसूर न्ही ठहरैगा।<verse eid="PRO 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6" />बूढ़यां की शोभा उनके द्योत्ते-पोत्ते सै;</para>
  <para style="q" vid="PRO 17:6">अर बाळ-बच्‍चां की शोभा उनके माँ-बाप सै।<verse eid="PRO 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7" />मूर्ख के मुँह तै आच्छी बात फब्ती कोनी,</para>
  <para style="q" vid="PRO 17:7">अर इसतै ज्यादा प्रधान के मुँह तै झूठ्ठी बात फब्ती कोनी।<verse eid="PRO 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8" />रिसवत देण आळा माणस रिसवत नै मोह लेण आळी मणि समझै सै;</para>
  <para style="q" vid="PRO 17:8">इसा माणस जड़ै जावै सै, ओड़ैए उसका काम बण जावै सै।<verse eid="PRO 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9" />जो दुसरे के अपराध नै ढक देवै सै, वो प्यार का टोह्ण आळा सै,</para>
  <para style="q" vid="PRO 17:9">पर जो बात की चर्चा बार-बार करै सै, वो गहरे दोस्तां म्ह भी फूट गेर देवै सै।<verse eid="PRO 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10" />एक फटकार समझदार कै मन म्ह जितनी गड़ जावै सै,</para>
  <para style="q" vid="PRO 17:10">उतणी सौ बार मार खाण कै बाद भी मूर्ख कै मन म्ह न्ही पड़दी।<verse eid="PRO 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11" />बुरा माणस दंगे ए का यत्न करै सै,</para>
  <para style="q" vid="PRO 17:11">इस खात्तर उसकै धोरै जुल्मी दूत भेज्या जावैगा।<verse eid="PRO 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12" />बच्‍चा छीनी होई रीछणी तै मिलणा,</para>
  <para style="q" vid="PRO 17:12">मूर्खता म्ह डूबे होए मूर्ख तै मिलणा भला सै।<verse eid="PRO 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13" />जो कोए भलाई के बदले म्ह बुराई करै,</para>
  <para style="q" vid="PRO 17:13">उसके घर तै बुराई दूर न्ही होगी।<verse eid="PRO 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14" />झगड़े की शरुआत बाँध के छेद कै जिसी सै,</para>
  <para style="q" vid="PRO 17:14">झगड़ा बढ़ण तै पैहले उसनै छोड़ देणा भला सै।<verse eid="PRO 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15" />जो दोषी नै बेकसूर अर जो बेकसूर नै दोषी ठहरावै सै,</para>
  <para style="q" vid="PRO 17:15">उन दोनुआ तै परमेसवर नफरत करै सै।<verse eid="PRO 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16" />बुद्धि मोल लेण कै खात्तर मूर्ख अपणे हाथ म्ह दाम क्यूँ लिए खड्या सै?</para>
  <para style="q" vid="PRO 17:16">वो उसनै सिखणा ए कोनी चाहन्दा।<verse eid="PRO 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17" />दोस्त हरेक बखत म्ह प्यार करै सै,</para>
  <para style="q" vid="PRO 17:17">अर बिप्दा के दिन भाई बण जावै सै।<verse eid="PRO 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18" />बेअक्ल माणस रुकावट पैदा करण आळे वादे करै सै,</para>
  <para style="q" vid="PRO 17:18">अर अपणे पड़ोसी कै कर्ज का जिम्मेदार होवै सै।<verse eid="PRO 17:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19" />जो झगड़े-रगड़े तै लगाव राक्खै, वो अपराध करण तै भी लगाव राक्खै सै,</para>
  <para style="q" vid="PRO 17:19">अर जो अपणे फाटक नै बड़ा करै<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fq" closed="false">अपणे फाटक नै बड़ा करै </char><char style="ft" closed="false">गर्व तै बोलणा</char></note>, वो अपणे नाश कै खात्तर यत्न करै सै।<verse eid="PRO 17:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20" />जो मन का टेढ़ा सै, उसका कल्याण न्ही होंदा,</para>
  <para style="q" vid="PRO 17:20">अर उल्ट-फेर की बात करण आळा बिप्दा म्ह पड़ै सै।<verse eid="PRO 17:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21" />जो मूर्ख नै जन्म देवै सै वो उसतै दुख ए पावै सै,</para>
  <para style="q" vid="PRO 17:21">अर मूर्ख कै बाप नै खुशी कोनी होन्दी।<verse eid="PRO 17:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22" />मन की खुशी आच्छी दवाई सै,</para>
  <para style="q" vid="PRO 17:22">अर मन कै टूटण तै सारी हाड्डी सूख जावै सै।<verse eid="PRO 17:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23" />दुष्ट माणस न्याय बिगड़ाण कै खात्तर,</para>
  <para style="q" vid="PRO 17:23">अपणी गाँठ तै रिसवत लिकाड़ै सै।<verse eid="PRO 17:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24" />बुद्धि समझण आळे कै स्याम्ही ए रहवै सै,</para>
  <para style="q" vid="PRO 17:24">पर मूर्ख की आँख धरती कै सारी दिशा पै लाग्गी रहवै सै।<verse eid="PRO 17:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25" />मूर्ख बेट्टे तै बाप उदास होवै सै,</para>
  <para style="q" vid="PRO 17:25">अर जाम्मण आळी नै दुख होवै सै।<verse eid="PRO 17:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26" />धर्मी तै जुर्माना लेणा,</para>
  <para style="q" vid="PRO 17:26">अर प्रधानां नै खराई कै कारण पिटवाणा, दोनुआ म्ह तै कोए सा काम आच्छा कोनी।<verse eid="PRO 17:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27" />जो सम्भळ कै बोल्‍लै सै, वो ज्ञान्‍नी ठहरै सै;</para>
  <para style="q" vid="PRO 17:27">अर जिसकी आत्मा शान्त रहवै सै, वोए समझ आळा माणस ठहरै सै।<verse eid="PRO 17:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28" />मूर्ख भी जिब चुप रहवै सै, तो बुद्धिमान गिण्या जावै सै;</para>
  <para style="q" vid="PRO 17:28">अर जो अपणा मुँह बन्द राक्खै वो समझ आळा गिण्या जावै सै।<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1" />जो दुसरयां तै अलग हो जावै सै, वो अपणी ए इच्छा पूरी करण कै खात्तर इसा करै सै,</para>
  <para style="q" vid="PRO 18:1">अर सब ढाळ की खरी बुद्धि तै बैर करै सै।<verse eid="PRO 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2" />मूर्ख का मन समझ की बात्तां म्ह न्ही लागदा,</para>
  <para style="q" vid="PRO 18:2">वो बस अपणे मन की बात जाहिर करणा चावै सै।<verse eid="PRO 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3" />जड़ै दुष्टता आवै सै, ओड़ै अपमान भी आवै सै;</para>
  <para style="q" vid="PRO 18:3">अर निरादर के गैल बुराई आवै सै।<verse eid="PRO 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4" />माणसां के मुँह के वचन गहरा पाणी हो सै;</para>
  <para style="q" vid="PRO 18:4">बुद्धि का चोवा बहन्दी होई धारा के जिसा सै।<verse eid="PRO 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5" />दुष्ट का पक्ष करणा,</para>
  <para style="q" vid="PRO 18:5">अर धर्मी का हक मारणा, आच्छा कोनी।<verse eid="PRO 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6" />बात बढ़ाण तै मूर्ख मुकद्दमा खड्या करै सै,</para>
  <para style="q" vid="PRO 18:6">अर खुद नै मार खाण कै जोग्गा दिखावै सै।<verse eid="PRO 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7" />मूर्ख का विनाश उसकी बात्तां तै होवै सै,</para>
  <para style="q" vid="PRO 18:7">अर उसकी बात उसकै प्राण कै खात्तर फंदा होवै सै।<verse eid="PRO 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8" />कानाफूसी करण आळे की बात सुवाद खाणे की ढाळ लाग्गै सै;</para>
  <para style="q" vid="PRO 18:8">वे पेट म्ह हजम हो जावै सै।<verse eid="PRO 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9" />जो काम म्ह आलस करै सै,</para>
  <para style="q" vid="PRO 18:9">वो बिगाड़ण आळे का भाई ठहरै सै।<verse eid="PRO 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10" />यहोवा का नाम मजबूत गढ़ सै;</para>
  <para style="q" vid="PRO 18:10">धर्मी उस म्ह भाग कै सारी मुसीबतां तै बच जावै सै।<verse eid="PRO 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11" />धनी का धन उसकी नजर म्ह मजबूत नगर सै,</para>
  <para style="q" vid="PRO 18:11">अर उसकी कल्पना ऊँच्‍ची शहरपनाह के समान सै।<verse eid="PRO 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12" />नाश होण तै पैहला माणस कै मन म्ह घमण्ड,</para>
  <para style="q" vid="PRO 18:12">अर महिमा पाण तै पैहल्या नम्रता होवै सै।<verse eid="PRO 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13" />जो बिना बात सुणे जवाब देवै सै, वो बेकूफ ठहरै सै,</para>
  <para style="q" vid="PRO 18:13">अर उसका अनादर होवै सै।<verse eid="PRO 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14" />रोग म्ह माणस अपणी आत्मा तै सम्भलै सै;</para>
  <para style="q" vid="PRO 18:14">पर जब आत्मा हार जावै सै जिब इसनै कौण सह सकै सै?<verse eid="PRO 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15" />समझण आळे का मन ज्ञान पावै सै;</para>
  <para style="q" vid="PRO 18:15">अर बुद्धिमान ज्ञान की बात की टोह् म्ह रहवै सै।<verse eid="PRO 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16" />भेंट माणस कै खात्तर राह खोल देवै सै,</para>
  <para style="q" vid="PRO 18:16">अर उसनै बड़े माणसां कै स्याम्ही पोहचावै सै।<verse eid="PRO 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17" />मुकदमे म्ह जो पैहला बोल्‍लै, वोए बेकसूर लाग्गै सै,</para>
  <para style="q" vid="PRO 18:17">पर बाद म्ह दुसरे पक्ष आळा आकै उसनै जाँच लेवै सै।<verse eid="PRO 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18" />चिट्ठी डालण तै झगड़े बन्द होवै सै,</para>
  <para style="q" vid="PRO 18:18">अर ताकतवर माणसां की लड़ाई का अन्त होवै सै।<verse eid="PRO 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19" />नाराज होए भाई नै मनाणा मजबूत नगर कै ले लेण तै मुश्किल होवै सै,</para>
  <para style="q" vid="PRO 18:19">अर झगड़े राजभवन कै बेडां कै जिसा सै।<verse eid="PRO 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20" />माणस का पेट मुँह की बात्तां के फळ तै भरै सै,</para>
  <para style="q" vid="PRO 18:20">अर बोलण तै जो कुछ उसनै मिलै सै, वो उसतै छिक्‍क जावै सै।<verse eid="PRO 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21" />जीभ कै बस म्ह मरणा अर जीणा दोन्‍नु होवै सै,</para>
  <para style="q" vid="PRO 18:21">अर जो उसनै काम म्ह लाणा जाणै सै, वो उसका फळ भोग्गैगा।<verse eid="PRO 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22" />जिसनै जनान्‍नी ब्याह ली, उसनै उत्तम पदार्थ पाया,</para>
  <para style="q" vid="PRO 18:22">अर यहोवा का अनुग्रह उसपै होया सै।<verse eid="PRO 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23" />गरीब गिड़गिड़ाकै मदद माँग्गै सै,</para>
  <para style="q" vid="PRO 18:23">अर धनी कड़ा जवाब देवै सै।<verse eid="PRO 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24" />मित्तरां कै बढ़ाण तै तो नाश होवै सै,</para>
  <para style="q" vid="PRO 18:24">पर इसा मित्तर होवै सै, जो भाई तै भी घणा मिल्या रहवै सै।<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1" />जो गरीब खराई तै चाल्‍लै सै,</para>
  <para style="q" vid="PRO 19:1">वो उस मूर्ख तै भला सै जो टेढ़ी बात बोल्‍लै सै।<verse eid="PRO 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2" />माणस का बिना ज्ञान के रहणा आच्छा कोनी,</para>
  <para style="q" vid="PRO 19:2">अर जो उतावळी तै भाज्जै सै वो चूक जावै सै।<verse eid="PRO 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3" />बेकूफी के कारण माणस का राह टेढ़ा होवै सै,</para>
  <para style="q" vid="PRO 19:3">अर वो मन ए मन यहोवा तै चिड़ण लाग्गै सै।<verse eid="PRO 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4" />धनी कै तो भोत-से दोस्त बण जावै सै,</para>
  <para style="q" vid="PRO 19:4">पर कंगाल के दोस्त उसतै न्यारे हो जावै सै।<verse eid="PRO 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5" />झूठ्ठा गवाह बेकसूर कोनी ठहरदा,</para>
  <para style="q" vid="PRO 19:5">अर जो झूठ बोल्या करै सै, वो न्ही बचैगा।<verse eid="PRO 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6" />भले माणस नै भोत-से माणस मना लेवै सै,</para>
  <para style="q" vid="PRO 19:6">अर दान्‍नी माणस का दोस्त हर कोए बणै सै।<verse eid="PRO 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7" />जब गरीब के सब भाई उसतै बैर राक्खै सै,</para>
  <para style="q" vid="PRO 19:7">तो जरुर उसकै दोस्त उसतै दूर हो जावै।</para>
  <para style="q" vid="PRO 19:7">वो बात करदे होए उनका पिच्छा करै सै, पर उननै पांदा कोनी।<verse eid="PRO 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8" />जो बुद्धि नै पावै सै, वो अपणे प्राण का प्यार करण आळा ठहरै सै;</para>
  <para style="q" vid="PRO 19:8">अर जो समझ नै धरी राक्खै सै उसका कल्याण होवै सै।<verse eid="PRO 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9" />झूठ्ठा गवाह निर्दोष न्ही ठहरैगा,</para>
  <para style="q" vid="PRO 19:9">अर जो झूठ बोल्या करै सै, वो नाश हो जावै सै।<verse eid="PRO 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10" />जिब सुख तै रहणा मूर्ख नै न्ही फबदा,</para>
  <para style="q" vid="PRO 19:10">तो हाकिमां पै दास का राज करणा किस ढाळ फबै!<verse eid="PRO 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11" />जो माणस बुद्धि तै चाल्‍लै सै वो देर तै गुस्सा करै सै,</para>
  <para style="q" vid="PRO 19:11">अर अपराध नै भूलाणा उसनै शोभा देवै सै।<verse eid="PRO 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12" />राजा का छो शेर की गरजण के समान सै,</para>
  <para style="q" vid="PRO 19:12">अर उसका अनुग्रह घास पै की ओस कै बराबर सै।<verse eid="PRO 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13" />मूर्ख बेट्टा बाप कै खात्तर बिप्दा ठहरै सै,</para>
  <para style="q" vid="PRO 19:13">अर झगड़ालू पत्नी सदा टपकण आळे पाणी के समान सै।<verse eid="PRO 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14" />घर अर धन पूर्वजां के भाग तै,</para>
  <para style="q" vid="PRO 19:14">पर बुद्धिमान घरआळी यहोवा की ओड़ तै ए मिलै सै।<verse eid="PRO 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15" />आलस तै भारी नींद आ जावै सै,</para>
  <para style="q" vid="PRO 19:15">अर जो प्राणी ढिलाई तै काम करै सै, वो भूक्खा ए रहवै सै।<verse eid="PRO 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16" />जो हुकम नै मान्‍नै, वो अपणे प्राण की हिफाजत करै सै,</para>
  <para style="q" vid="PRO 19:16">पर जो अपणे चाल-चलण<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="fq" closed="false">चाल-चलण </char><char style="ft" closed="false">इसका मतलब परमेसवर के वचन सै</char></note> कै बारै म्ह बेफिकर रहवै सै वो मर जावै सै।<verse eid="PRO 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17" />जो कंगाल पै दया करै सै, वो यहोवा नै उधार देवै सै,</para>
  <para style="q" vid="PRO 19:17">अर वो अपणे इस काम का प्रतिफळ पावैगा।<verse eid="PRO 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18" />जिब तक आशा सै तब तक अपणे बेट्टे की ताड़ना कर,</para>
  <para style="q" vid="PRO 19:18">जाण-बुझकै उसनै जान तै ना मारै।<verse eid="PRO 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19" />जो घणा गुसेल सै उसनै दण्ड पाण दे;</para>
  <para style="q" vid="PRO 19:19">क्यूँके जै तू उसनै बचावै, तो बार-बार बचाणा पड़ैगा।<verse eid="PRO 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20" />सलाह नै सुण ले, अर शिक्षा नै अपणाले,</para>
  <para style="q" vid="PRO 19:20">ताके तू अपणे अन्त के दिनां म्ह बुद्धिमान ठहरै।<verse eid="PRO 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21" />माणस कै मन म्ह भोत सी कल्पना होवै सै,</para>
  <para style="q" vid="PRO 19:21">अर जो युक्ति यहोवा करै सै, वाए स्थिर रहवै सै।<verse eid="PRO 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22" />माणस म्ह ईमानदारी सबतै आच्छा गुण सै,</para>
  <para style="q" vid="PRO 19:22">अर गरीब आदमी झूठ बोलण आळे तै सही सै।<verse eid="PRO 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23" />यहोवा का डर मानण तै जीवन बढ़ै सै,</para>
  <para style="q" vid="PRO 19:23">अर उसका डर मानण आळा ठिकाणा पाकै सुखी रहवै सै,</para>
  <para style="q" vid="PRO 19:23">उसपै बिप्दा कोनी पड़ै।<verse eid="PRO 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24" />आलसी अपणा हाथ थाळी म्ह घाल्‍लै सै,</para>
  <para style="q" vid="PRO 19:24">पर अपणे मुँह ताहीं निवाळा न्ही ठांदा।<verse eid="PRO 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25" />मखौल करण आळे कै मार, इसतै भोळा माणस समझदार हो जावैगा;</para>
  <para style="q" vid="PRO 19:25">अर समझ आळे नै डाँट, जिब वो घणा ज्ञान पावैगा।<verse eid="PRO 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26" />जो बेट्टा अपणे बाप नै उजाड़ै, अर अपणी माँ नै भगा देवै सै,</para>
  <para style="q" vid="PRO 19:26">वो अपमान अर शर्म का कारण होवैगा।<verse eid="PRO 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27" />हे मेरे बेट्टे, जै तू शिक्षा नै सुणणा छोड़ दे,</para>
  <para style="q" vid="PRO 19:27">तो तू ज्ञान की बात्तां तै भटक जावैगा।<verse eid="PRO 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28" />अनर्थकारी गवाह न्याय नै मजाक म्ह उड़ावै सै,</para>
  <para style="q" vid="PRO 19:28">अर दुष्ट माणस ओच्छे काम नै निगळ लेवै सै।<verse eid="PRO 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29" />मखौल करण आळा खात्तर दण्ड ठहराया जावै सै,</para>
  <para style="q" vid="PRO 19:29">अर मूर्ख की पीठ के खात्तर कोड़े सै।<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1" />दाखमधु मखौल करण आळा अर मदिरा हल्‍ला मचाण आळी सै;</para>
  <para style="q" vid="PRO 20:1">जो कोए उसकै कारण चूक करै सै, वो बुद्धिमान कोनी।<verse eid="PRO 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2" />राजा का छो, शेर की गरजण कै समान सै;</para>
  <para style="q" vid="PRO 20:2">जो उस ताहीं रोष दुवावै सै, वो अपणे प्राण खो देवै सै।<verse eid="PRO 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3" />मुकदमे तै हाथ उठाणा, माणस की महिमा ठहरै सै;</para>
  <para style="q" vid="PRO 20:3">अर सारे मूर्ख झगड़ण नै तैयार होवै सै।<verse eid="PRO 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4" />आलसी माणस ठण्ड कै कारण हळ कोनी जोड़दा;</para>
  <para style="q" vid="PRO 20:4">इसे करकै लामणी कै बखत वो भीख माँग्गै, अर कुछ न्ही पांदा।<verse eid="PRO 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5" />माणस के मन की युक्ति अथाह तो सै,</para>
  <para style="q" vid="PRO 20:5">तोभी समझण आळा माणस उसनै लिकाड़ लेवै सै।<verse eid="PRO 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6" />भोत-से माणस अपणी ईमानदारी का प्रचार करै सै;</para>
  <para style="q" vid="PRO 20:6">पर सच्‍चा माणस कौण पा सकै सै?<verse eid="PRO 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7" />वो माणस जो अपणी ईमानदारी पै चाल्‍लै सै, धर्मी जो खराई उसकै पाच्छै चाल्‍लै सै,</para>
  <para style="q" vid="PRO 20:7">उसके बेट्टे जो उसकै पाच्छै चाल्‍लै सै, वे धन्य सै।<verse eid="PRO 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8" />राजा जो न्याय के सिंहासन पै बैठ्या करै सै,</para>
  <para style="q" vid="PRO 20:8">वो अपणी आँखां ए तै सारी बुराई नै छाँट लेवै सै।<verse eid="PRO 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9" />कौण कह सकै सै के मन्‍नै अपणा मन पवित्र करया;</para>
  <para style="q" vid="PRO 20:9">यानी मै पाप तै शुद्ध होया सूं?<verse eid="PRO 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10" />घटदे-बढ़दे बाट अर घटदे-बढ़दे नाप इन दोनुआ तै यहोवा घृणा करै सै।<verse eid="PRO 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11" />बाळक भी अपणे काम्मां तै पिच्छाणा जावै सै,</para>
  <para style="q" vid="PRO 20:11">के उसका काम पवित्र अर सीध्धा सै, के न्ही।<verse eid="PRO 20:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12" />सुणण के खात्तर कान अर देखण खात्तर जो आँख सै,</para>
  <para style="q" vid="PRO 20:12">उन दोनुआं ताहीं परमेसवर नै बणाया सै।<verse eid="PRO 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13" />नींद तै लगाव ना राख, नई तो कंगाल हो जावैगा;</para>
  <para style="q" vid="PRO 20:13">आँख खोल तब तू रोट्टी तै छिकैगा।<verse eid="PRO 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14" />मोल लेण कै बखत ग्राहक, “आच्छी कोनी, आच्छी कोनी” कहवै सै,</para>
  <para style="q" vid="PRO 20:14">पर चले जाणकै बाद बड़ाई करै सै।<verse eid="PRO 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />सोन्‍ना अर भोत-से बेसकिमती रत्न तो सै;</para>
  <para style="q" vid="PRO 20:15">पर ज्ञान की बात अनमोल मणि ठहरी सै।<verse eid="PRO 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16" />किसे अनजाण कै खात्तर जमानत देण आळे के लत्तें ले अर पराये के बाबत जो जमानती होया सै उसतै बंधक की चीज लिए राख।<verse eid="PRO 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17" />धोक्खा-धड़ी तै पाई रोट्टी माणस नै मिठ्ठी तो लाग्गै सै,</para>
  <para style="q" vid="PRO 20:17">पर बाद म्ह उसका मुँह कंकरां तै भर जावै सै।<verse eid="PRO 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18" />सारी कल्पना सलाह तै ए टिक्यी रहवै सै;</para>
  <para style="q" vid="PRO 20:18">अर युक्ति कै गैल युद्ध करणा चाहिए।<verse eid="PRO 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19" />जो चुगली करदा फिरै सै वो भेद जाहिर करै सै;</para>
  <para style="q" vid="PRO 20:19">इस खात्तर बकवादी तै मेल-जोळ ना राखिये।<verse eid="PRO 20:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20" />जो अपणे माँ-बाप नै कोस्सै,</para>
  <para style="q" vid="PRO 20:20">उसका दीवा बुझ जावै, अर घणा अन्धेरा हो जा सै।<verse eid="PRO 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21" />जो भाग पैहले उतावळी तै मिलै सै,</para>
  <para style="q" vid="PRO 20:21">बाद म्ह उसपै आशीष कोनी होन्दी।<verse eid="PRO 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22" />न्यू ना कहवै के “मै बुराई का बदला लेऊँगा;”</para>
  <para style="q" vid="PRO 20:22">बल्के यहोवा की बाट देख्दा रहै, वो तन्‍नै छुड़ावैगा।<verse eid="PRO 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23" />घटदे-बढ़दे बाट्टां तै यहोवा नफरत करै सै,</para>
  <para style="q" vid="PRO 20:23">अर छल की ताखड़ी आच्छी कोनी।<verse eid="PRO 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24" />माणस का राह यहोवा की ओड़ तै तय करया जावै सै;</para>
  <para style="q" vid="PRO 20:24">माणस किस तरियां अपणी राह समझ सकैगा?<verse eid="PRO 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25" />जो माणस बिना बिचारे किसे चीज नै पवित्र ठहरावै,</para>
  <para style="q" vid="PRO 20:25">अर जो मन्‍नत मानकै पूच्छ-ताच्छ करण लाग्गै, वो फंदे म्ह फँसैगा।<verse eid="PRO 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26" />बुद्धिमान राजा दुष्टां नै फटकारै सै,</para>
  <para style="q" vid="PRO 20:26">अर उनपै चाक्‍की का पाट<note caller="+" style="f"><char style="fr" closed="false">20:26 </char><char style="fq" closed="false">पाट </char><char style="ft" closed="false">गिरड़ी</char></note> चलावै सै।<verse eid="PRO 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27" />माणस की आत्मा यहोवा का दीवा सै;</para>
  <para style="q" vid="PRO 20:27">वो मन की सारी बात्तां की खोज करै सै।<verse eid="PRO 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28" />राजा की हिफाजत कृपा अर सच्‍चाई कै कारण होवै सै,</para>
  <para style="q" vid="PRO 20:28">अर कृपा करण तै उसकी गद्दी सम्भलै सै।<verse eid="PRO 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29" />जवानां का मान-बड़ाई उनकी ताकत सै</para>
  <para style="q" vid="PRO 20:29">अर बूढ़यां की शोभा उनके पके बाळ सै।<verse eid="PRO 20:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30" />चोट लाग्गण तै जो घाव होवै सै, वो बुराई दूर करै सै;</para>
  <para style="q" vid="PRO 20:30">अर मार खाण तै मन निर्मल हो जावै सै।<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1" />राजा का मन पाणी की धारा के समान यहोवा कै हाथ्थां म्ह रहवै सै,</para>
  <para style="q" vid="PRO 21:1">जड़ै वो चाहवै ओड़ैए उसनै मोड़ देवै सै।<verse eid="PRO 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2" />माणस का सारा चाल-चलण अपणी जाण म्ह तो ठीक होवै सै,</para>
  <para style="q" vid="PRO 21:2">पर यहोवा मन नै परखै सै,<verse eid="PRO 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3" />धर्म अर न्याय करणा,</para>
  <para style="q" vid="PRO 21:3">यहोवा नै बलिदान तै घणा आच्छा लाग्गै सै।<verse eid="PRO 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4" />चढ़ी होई आँख, घमण्डी मन,</para>
  <para style="q" vid="PRO 21:4">अर दुष्टां की खेत्ती, तीन्‍नु पाप तै भरी होड़ सै।<verse eid="PRO 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5" />काम करण आळे की कल्पना तै सिर्फ लाभ होवै सै,</para>
  <para style="q" vid="PRO 21:5">पर उतावळी करण आळे नै सिर्फ घाट्टा ए होवै सै।<verse eid="PRO 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6" />जो धन झूठ कै जरिये मिल्या हो, वो हवा तै उड़ जाण आळी धुंध सै,</para>
  <para style="q" vid="PRO 21:6">उसके टोह्ण आळे मौत नै ए टोहवै सै।<verse eid="PRO 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7" />जो उत्पात दुष्ट माणस करै सै,</para>
  <para style="q" vid="PRO 21:7">उसतै उनका ए नाश होवै सै, क्यूँके वे न्याय का काम करण तै मना करै सै।<verse eid="PRO 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8" />पाप तै लदे होए माणस का राह घणाए टेढ़ा हो सै,</para>
  <para style="q" vid="PRO 21:8">पर जो पवित्र सै, उसका कर्म सीध्धा हो सै।<verse eid="PRO 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9" />लम्बे-चौड़े घर म्ह झगड़ालू पत्नी कै गैल रहण तै,</para>
  <para style="q" vid="PRO 21:9">छात की कूण म्ह पड़या रहणा भला सै।<verse eid="PRO 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10" />दुष्ट माणस बुराई की लालसा मन तै करै सै,</para>
  <para style="q" vid="PRO 21:10">वो अपणे पड़ोसी पै दया की निगांह न्ही करदा।<verse eid="PRO 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11" />जिब मखौल करण आळे ताहीं सजा दी जावै सै, तो भोळा बुद्धिमान हो जावै सै।</para>
  <para style="q" vid="PRO 21:11">अर जिब बुद्धिमान ताहीं उपदेश दिया जावै सै, तो वो ज्ञानवान हो जावै सै।<verse eid="PRO 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12" />धर्मी जन दुष्टां कै घराने पै बुद्धिमानी तै विचार करै सै,</para>
  <para style="q" vid="PRO 21:12">अर परमेसवर दुष्टां नै बुराईयाँ म्ह उल्ट देवै सै।<verse eid="PRO 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13" />जो कंगाल की दोहाई पै ध्यान न्ही देन्दा,</para>
  <para style="q" vid="PRO 21:13">वो आप पुकारैगा अर उसकी सुणी न्ही जावैगी।<verse eid="PRO 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14" />अर गुप्त म्ह देई होई भेंट तै गुस्सा ठण्डा होवै सै,</para>
  <para style="q" vid="PRO 21:14">अर चुपचाप देई होई रिसवत तै बड़ी जळजळाहट भी थम जावै सै।<verse eid="PRO 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15" />न्याय का काम करणा धर्मी नै तो आनन्द,</para>
  <para style="q" vid="PRO 21:15">पर अनर्थकारियाँ नै नाश का ए कारण दिक्खै सै।<verse eid="PRO 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16" />जै माणस समझ की राह तै भटक जावै,</para>
  <para style="q" vid="PRO 21:16">उसका ठिकाणा मरे होया कै बीच म्ह होवैगा।<verse eid="PRO 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17" />जो अय्याशी तै लगाव राक्खै सै, वो कंगाल हो जावै सै;</para>
  <para style="q" vid="PRO 21:17">अर जो दाखमधु पीण अर जैतून का तेल लगाण तै लगाव राक्खै सै, वो धनवान न्ही होंदा।<verse eid="PRO 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18" />दुष्ट माणस धर्मी की जमानत ठहरै सै,</para>
  <para style="q" vid="PRO 21:18">अर बिश्वासघाती सीध्धे माणसां कै बदले सजा भुगतै सै।<verse eid="PRO 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19" />झगड़ालू अर चिढ़ण आळी पत्नी गैल रहण तै,</para>
  <para style="q" vid="PRO 21:19">बियाबान म्ह रहणा आच्छा सै।<verse eid="PRO 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20" />बुद्धिमान कै घर म्ह बढ़िया धन अर तेल पाया जावै सै,</para>
  <para style="q" vid="PRO 21:20">पर मूर्ख उननै उड़ा देवै सै।<verse eid="PRO 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21" />जो धर्म अर दया का पिच्छा करै सै,</para>
  <para style="q" vid="PRO 21:21">वो जीवन, धर्म अर बड़ाई भी पावै सै।<verse eid="PRO 21:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22" />बुद्धिमान शूरवीरां कै नगर पै चढ़कै,</para>
  <para style="q" vid="PRO 21:22">उनकी ताकत नै जिसपै वे भरोस्सा करै सै, नाश करै सै।<verse eid="PRO 21:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23" />जो अपणी जुबान नै काब्बू म्ह राक्खै सै,</para>
  <para style="q" vid="PRO 21:23">वो अपणी जान नै बिप्दा म्ह पड़ण तै बचावै सै।<verse eid="PRO 21:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24" />जो घमण्ड म्ह आकै गुस्से तै काम करै सै, उसका नाम अभिमानी,</para>
  <para style="q" vid="PRO 21:24">अर अहंकारी मखौल करण आळा पड़ै सै।<verse eid="PRO 21:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25" />आलसी अपणी लालसा म्ह ए मर जावै सै,</para>
  <para style="q" vid="PRO 21:25">क्यूँके उसके हाथ काम करण तै मना करै सै।<verse eid="PRO 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26" />कोए इसा सै, जो दिन भर लालसा ए करया करै सै,</para>
  <para style="q" vid="PRO 21:26">पर धर्मी लगातार दान करदा रहवै सै।<verse eid="PRO 21:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27" />दुष्टां का बलिदान घृणित सै;</para>
  <para style="q" vid="PRO 21:27">अर खास तौर पै जिब वो बुरे मकसद तै ल्यावै सै।<verse eid="PRO 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28" />झूठ्ठा गवाह नाश हो जावैगा,</para>
  <para style="q" vid="PRO 21:28">पर सच्‍चा गवाह सदा टिक्या रहवैगा।<verse eid="PRO 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29" />दुष्ट माणस अपणी जुबान कड़वी करै सै,</para>
  <para style="q" vid="PRO 21:29">अर धर्मी अपणी चाल सीध्धी राक्खै सै।<verse eid="PRO 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30" />यहोवा कै बिरुध ना तो कोए बुद्धि, ना कोए समझ,</para>
  <para style="q" vid="PRO 21:30">अर ना कोए युक्ति चाल्‍लै सै।<verse eid="PRO 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31" />युद्ध के दिनां खात्तर घोड़ा तैयार तो हो सै,</para>
  <para style="q" vid="PRO 21:31">पर जीत यहोवा तै ए मिलै सै।<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1" />घणे धन तै आच्छा नाम चाह्ण कै लायक सै,</para>
  <para style="q" vid="PRO 22:1">अर सोन्‍ने-चाँदी तै दुसरे माणसां के जरिये पक्ष पाणा आच्छा सै।<verse eid="PRO 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2" />धनी अर कंगाल दोनुआं म्ह एक समानता सै; ‍</para>
  <para style="q" vid="PRO 22:2">यहोवा उन दोनुआं का बणाण आळा सै।<verse eid="PRO 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3" />चतुर माणस, बिप्दा नै आन्दे देखकै लुह्क जा सै;</para>
  <para style="q" vid="PRO 22:3">पर भोळे माणस आग्गै बढ़कै सजा भुगतै सै।<verse eid="PRO 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4" />नम्रता अर यहोवा का भय मानण का फळ धन,</para>
  <para style="q" vid="PRO 22:4">आदर अर जीवन होवै सै।<verse eid="PRO 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5" />टेढ़े माणस कै राह म्ह काण्डे अर जाळ रहवै सै;</para>
  <para style="q" vid="PRO 22:5">पर जो अपणी जान की हिफाजत करै, वो उनतै दूर रहवै सै।<verse eid="PRO 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6" />बाळक नै उसे राह की शिक्षा देओ जिस म्ह उसनै चालणा चाहिए,</para>
  <para style="q" vid="PRO 22:6">अर वो बुढ़ापे म्ह भी उसतै न्ही मुड़ैगा।<verse eid="PRO 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7" />धनवान गरीब पै राज करै सै,</para>
  <para style="q" vid="PRO 22:7">अर उधार लेण आळा उधार देण आळे का दास हो सै।<verse eid="PRO 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8" />जो बुराई का बीज बोवै सै, वो आफ्फत म्ह ए फँसैगा,</para>
  <para style="q" vid="PRO 22:8">अर उसकै छो का सोट्टा टूट्टैगा।<verse eid="PRO 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9" />दया करण आळे पै आशीष फळै सै,</para>
  <para style="q" vid="PRO 22:9">क्यूँके वो कंगाल नै अपणी रोट्टी म्ह तै देवै सै।<verse eid="PRO 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10" />मखौल करण आळे नै लिकाड़ दे, तो झगड़ा मिट जावैगा,</para>
  <para style="q" vid="PRO 22:10">अर वाद-विवाद अर बेजती दोन्‍नु दूर हो जावैंगे।<verse eid="PRO 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11" />जो मन की शुद्धता तै लगाव राक्खै सै,</para>
  <para style="q" vid="PRO 22:11">अर जिसके वचन मन नै मोह लेवै सै, राजा उसका मित्तर हो सै।<verse eid="PRO 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12" />यहोवा ज्ञान्‍नी पै नजर करकै, उसकी हिफाजत करै सै,</para>
  <para style="q" vid="PRO 22:12">पर बिश्वासघाती की बात्तां नै वो उल्ट देवै सै।<verse eid="PRO 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13" />आलसी कहवै सै, “बाहर तो शेर होवैगा!”</para>
  <para style="q" vid="PRO 22:13">अगर मै बाहर जाऊँगा, तो चौक कै बीच म्ह मारया जाऊँगा।<verse eid="PRO 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14" />जार बिरबान्‍नी का मुँह गहरा गड्डा सै;</para>
  <para style="q" vid="PRO 22:14">जिसतै यहोवा नाराज होवै सै, वोए उस म्ह पड़ै सै।<verse eid="PRO 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15" />बाळक कै मन म्ह मूर्खता की गाँठ बंधी रहवै सै,</para>
  <para style="q" vid="PRO 22:15">पर अनुशासन की छड़ी उस ताहीं खोल कै उसनै दूर कर देवै सै।<verse eid="PRO 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16" />जो अपणे फायदे खात्तर कंगाल पै अंधेर करै सै,</para>
  <para style="q" vid="PRO 22:16">अर जो धनवान नै भेंट देवै, वे दोन्‍नु सिर्फ घाट्टा ए ठावै सै।<verse eid="PRO 22:16" /></para>
  <para style="s">बुद्धिमान की बात</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17" />कान लगाकै बुद्धिमानां के वचन सुण,</para>
  <para style="q" vid="PRO 22:17">अर मेरी ज्ञान की बात्तां की ओड़ मन लगा;<verse eid="PRO 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18" />जै तू उसनै अपणे मन म्ह राक्खै,</para>
  <para style="q" vid="PRO 22:18">अर वे सब तेरे मुँह तै लिकड़या भी करै, तो या बड़ी बात मन नै आच्छी लाग्गण आळी होवैगी।<verse eid="PRO 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19" />मन्‍नै आज इस खात्तर ये बात तेरे तै बताई सै,</para>
  <para style="q" vid="PRO 22:19">ताके तेरा भरोस्सा यहोवा पै होवै।<verse eid="PRO 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20" />मै भोत दिनां तै तेरे फायदे के उपदेश</para>
  <para style="q" vid="PRO 22:20">अर ज्ञान की बात्तां नै लिखदा आया सूं,<verse eid="PRO 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21" />ताके मै तन्‍नै सच्‍चे वचनां का ज्ञान करवा देऊँ,</para>
  <para style="q" vid="PRO 22:21">जिसतै जो तन्‍नै काम पै लगावै, उन ताहीं तू सच्‍चा जवाब दे सकै।<verse eid="PRO 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22" />कंगाल पै इस खात्तर अंधेर ना करिये, के वो कंगाल सै,</para>
  <para style="q" vid="PRO 22:22">अर ना गरीब माणस नै कच्हेरी मै पिसीये;<verse eid="PRO 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23" />क्यूँके यहोवा उसका मुकद्दमा लड़ैगा,</para>
  <para style="q" vid="PRO 22:23">अर जो लोग उसका धन खोस ले सै, उनकी जान भी वो खोस लेगा।<verse eid="PRO 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24" />गुसेल माणस की यारी ना करिये,</para>
  <para style="q" vid="PRO 22:24">अर तावळा गुस्सा होण आळे कै गैल ना चालिये,<verse eid="PRO 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25" />कदे इसा ना होवै के तू उसकी चाल सीखै,</para>
  <para style="q" vid="PRO 22:25">अर तेरे प्राण जाळ म्ह फँस जावै।<verse eid="PRO 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26" />जो माणस हाथ पै हाथ मारै सै,</para>
  <para style="q" vid="PRO 22:26">अर कर्जदार के जिम्मेदार हो सै, उन म्ह तू ना होइये।<verse eid="PRO 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27" />जै तेरे धोरै कर्ज उतारण खात्तर कुछ ना हो,</para>
  <para style="q" vid="PRO 22:27">तो हो सकै सै के वो तेरे नीच्‍चै तै खाट खींच ले जावै?<verse eid="PRO 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28" />जो सम्पत्ति का बाड़ा तेरे पूर्वजां नै बाँध्या हो, उस पुराणी हद नै ना बड़ाईये।<verse eid="PRO 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29" />जै तू इसा माणस देक्खै जो कामकाज म्ह तेज हो,</para>
  <para style="q" vid="PRO 22:29">तो वो राजा कै स्याम्ही खड्या होवैगा, छोट्टे माणसां कै स्याम्ही न्ही।<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1" />जिब तू किसे हाकिम कै गैल खाण बैठ्ठै,</para>
  <para style="q" vid="PRO 23:1">तो इस बात नै मन लगाकै सोचिये के मेरै स्याम्ही कौण सै<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="fq" closed="false">कौण सै </char><char style="ft" closed="false">धरया सै</char></note>?<verse eid="PRO 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2" />अर जै तू घणा खाण आळा हो,</para>
  <para style="q" vid="PRO 23:2">तो थोड़ा खाकै भूक्खा उठ जाईये।<verse eid="PRO 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3" />उसकी स्वादिष्ट खाण आळी चिज्जां की लालसा ना करिये,</para>
  <para style="q" vid="PRO 23:3">क्यूँके वो धोक्खे का खाणा सै।<verse eid="PRO 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4" />धनवान होण खात्तर मेहनत ना करिये;</para>
  <para style="q" vid="PRO 23:4">अपणी समझ का सहारा ना लिये।<verse eid="PRO 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5" />जिब तू अपणी आँख उस धन पै लगावैगा,</para>
  <para style="q" vid="PRO 23:5">वो चला जावैगा,</para>
  <para style="q" vid="PRO 23:5">वो उकाब पक्षी की ढाळ पंख लगाकै, मान्‍नो अकास की ओड़ उड़ जावैगा।<verse eid="PRO 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6" />जो जळण तै देक्खै सै, उसकी रोट्टी ना खाइये,</para>
  <para style="q" vid="PRO 23:6">अर ना उसकी स्वाद भरी खाण की चिज्जां की लालसा करिये;<verse eid="PRO 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7" />क्यूँके वो इसा माणस सै,</para>
  <para style="q" vid="PRO 23:7">जो खाणे के पईसे भी गिण ले सै। वो तेरे तै कहवै तो सै, “खा-पी,”</para>
  <para style="q" vid="PRO 23:7">पर उसका मन तेरे म्ह कोनी।<verse eid="PRO 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8" />जो निवाळा तन्‍नै खाया हो, वो उगळणा पड़ैगा,</para>
  <para style="q" vid="PRO 23:8">अर तू अपणी मिठ्ठी बात का फळ खोवैगा।<verse eid="PRO 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9" />मूर्ख कै स्याम्ही ना बोलिये,</para>
  <para style="q" vid="PRO 23:9">न्ही तो वो तेरे बुद्धि के वचनां नै तुच्छ जाणैगा।<verse eid="PRO 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10" />सम्पत्ति के बाड़े नै ना बढ़ाईये,</para>
  <para style="q" vid="PRO 23:10">अर ना अनाथ्थां कै खेत म्ह घुसिये;<verse eid="PRO 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11" />क्यूँके उनका छुड़ाण आळा सामर्थी सै,</para>
  <para style="q" vid="PRO 23:11">उनका मुकद्दमा तेरे गैल वोए लड़ैगा।<verse eid="PRO 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12" />अपणा मन शिक्षा की ओड़,</para>
  <para style="q" vid="PRO 23:12">अर अपणे कान ज्ञान की बात्तां की ओड़ लगाईये।<verse eid="PRO 23:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13" />बाळक की ताड़ना करणा ना छोड़िये,</para>
  <para style="q" vid="PRO 23:13">क्यूँके जै तू उसकै छड़ी तै मारै तो वो न्ही मरैगा।<verse eid="PRO 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14" />तू उसनै छड़ी तै मारकै उसके प्राण नै अधोलोक तै बचावैगा।<verse eid="PRO 23:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15" />हे मेरे बेट्टे, जै तू समझदार हो,</para>
  <para style="q" vid="PRO 23:15">तो मेरा ए मन राज्जी होवैगा।<verse eid="PRO 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16" />अर जिब तू सीध्धी बात बोल्‍लै, तो तेरा मन खुश होवैगा।<verse eid="PRO 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17" />तू पापियाँ के बाबत मन म्ह जळण ना करिये,</para>
  <para style="q" vid="PRO 23:17">दिन भर यहोवा का भय मानदा रहिये।<verse eid="PRO 23:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18" />क्यूँके भविष्य म्ह तू सफल होवैगा,</para>
  <para style="q" vid="PRO 23:18">अर तेरी आस न्ही टूट्टैगी।<verse eid="PRO 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19" />हे मेरे बेट्टे, तू सुणकै समझदार हो,</para>
  <para style="q" vid="PRO 23:19">अर अपणा मन सही राह मै सीध्धा चला।<verse eid="PRO 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20" />दाखमधु के पीण आळयां म्ह शामिल ना होइये,</para>
  <para style="q" vid="PRO 23:20">ना घणा माँस खाण आळे की संगत करिये;<verse eid="PRO 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21" />क्यूँके पियक्‍कड़ अर पेटू गरीब हो जावैंगे,</para>
  <para style="q" vid="PRO 23:21">अर उनकी ऊंघ उननै चिथड़े पैहरावैगी।<verse eid="PRO 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22" />अपणे जन्म देणआळे बाप की सुणिए,</para>
  <para style="q" vid="PRO 23:22">अर जिब तेरी माँ बूढ़ी हो जा, तोभी उसनै तुच्छ ना जाणीए।<verse eid="PRO 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23" />सच्‍चाई नै मोल लिये, बेचिये ना;</para>
  <para style="q" vid="PRO 23:23">अर बुद्धि, अर शिक्षा, अर समझ नै भी मोल लिये।<verse eid="PRO 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24" />धर्मी का पिता घणा मगन होवै सै;</para>
  <para style="q" vid="PRO 23:24">अर बुद्धिमान का पिता उसकै कारण राज्जी हो सै।<verse eid="PRO 23:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25" />तेरे कारण तेरे माँ-बाप खुश अर तेरी जन्म देण आळी मगन हो।<verse eid="PRO 23:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26" />हे मेरे बेट्टे, अपणा मन मेरी ओड़ लगा,</para>
  <para style="q" vid="PRO 23:26">अर तेरी नजर मेरै चाल-चलण पै लाग्गी रहवै।<verse eid="PRO 23:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27" />बेश्या गहरा गड्डा ठहरै सै;</para>
  <para style="q" vid="PRO 23:27">अर पराई जनान्‍नी भीड़े कुएँ कै समान सै।<verse eid="PRO 23:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28" />वा डाकू की ढाळ दा लगावै सै,</para>
  <para style="q" vid="PRO 23:28">अर भोत-से माणसां नै धोक्खेबाज बणा देवै सै।<verse eid="PRO 23:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29" />कौण कहवै सै, हाय? कौण कहवै सै, हाय, हाय? कौण झगड़े-रगड़े म्ह फंसै सै?</para>
  <para style="q" vid="PRO 23:29">कौण बक-बक करै सै? किसकै बिना कारण जख्म होवै सै? किसकी आँख लाल हो जावै सै?<verse eid="PRO 23:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30" />उनकी जो मदिरा देर ताहीं पीवै सै,</para>
  <para style="q" vid="PRO 23:30">अर जो मसाल्‍ला मिला होया मदिरा टोह्ण जावै सै।<verse eid="PRO 23:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31" />जिब मदिरा लाल दिक्खै सै, अर कटोरे म्ह उसका रंग निखर उठै सै,</para>
  <para style="q" vid="PRO 23:31">अर जिब वो धार बणाकै घाल्या जावै सै,</para>
  <para style="q" vid="PRO 23:31">तो उसनै देखिये ना।<verse eid="PRO 23:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32" />क्यूँके आखर म्ह वो साँप की ढाळ डसै सै,</para>
  <para style="q" vid="PRO 23:32">अर साँप के सपोल्‍ले की ढाळ लड़ै सै।<verse eid="PRO 23:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33" />तू अजीब चिज्जां नै देक्खैगा,</para>
  <para style="q" vid="PRO 23:33">अर उल्टी सीध्धी बात बकदा रहवैगा।<verse eid="PRO 23:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34" />तू समुन्दर के बीच लेट्टण आळे</para>
  <para style="q" vid="PRO 23:34">या मस्तूल<note caller="+" style="f"><char style="fr" closed="false">23:34 </char><char style="fq" closed="false">मस्तूल </char><char style="ft" closed="false">पाणी के जाहाज का खम्बा </char></note> की चोट्टी पै सोण आळे की ढाळ रहवैगा।<verse eid="PRO 23:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35" />तू कहवैगा के मन्‍नै मार तो खाई, पर दुखी न्ही होया;</para>
  <para style="q" vid="PRO 23:35">मै पिट तो गया, पर मन्‍नै कुछ होश न्ही था।</para>
  <para style="q" vid="PRO 23:35">मै नींद म्ह तै कद उठूँगा? मै तो फेर मदिरा टोहऊँगा?<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1" />बुरे माणसां कै बारै म्ह जळण ना करिये,</para>
  <para style="q" vid="PRO 24:1">अर ना उनकी संगत की चाह राखिये;<verse eid="PRO 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2" />क्यूँके वो उत्पात करण के बारै म्ह सोचदे रहवै सै,</para>
  <para style="q" vid="PRO 24:2">अर उनकै मुँह तै बुराई की बात लिकड़ै सै।<verse eid="PRO 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3" />घर बुद्धि तै बणै सै,</para>
  <para style="q" vid="PRO 24:3">अर समझकै जरिये डट्यां रहवै सै।<verse eid="PRO 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4" />ज्ञान कै कारण कोठड़ियाँ सारी ढाळ की बेसकीमती</para>
  <para style="q" vid="PRO 24:4">अर मन लुभाण आळी चिज्जां तै भर जा सै।<verse eid="PRO 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5" />शूरवीर ताकतवर हो सै,</para>
  <para style="q" vid="PRO 24:5">पर ज्ञान्‍नी माणस ताकतवर माणस तै घणा आच्छा हो सै।<verse eid="PRO 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6" />इस खात्तर जिब तू युद्ध करै, तो युक्ति कै गैल करिये,</para>
  <para style="q" vid="PRO 24:6">जीत भोत-से मंत्रियाँ कै कारण मिलै सै।<verse eid="PRO 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7" />बुद्धि इतणी ऊँच्‍ची सै के मूर्ख उसनै पा न्ही सकदा;</para>
  <para style="q" vid="PRO 24:7">वो सभा म्ह अपणा मुँह खोल न्ही सकदा।<verse eid="PRO 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8" />जो सोच विचार कै बुराई करै सै,</para>
  <para style="q" vid="PRO 24:8">उसनै माणस दुष्ट कहवै सै।<verse eid="PRO 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9" />बेकूफी के विचार भी पाप सै,</para>
  <para style="q" vid="PRO 24:9">अर मखौल करण आळे तै माणस नफरत करै सै।<verse eid="PRO 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10" />जै तू बिप्दा कै बखत हिम्मत छोड़ दे,</para>
  <para style="q" vid="PRO 24:10">तो तेरी ताकत भोत कम सै।<verse eid="PRO 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11" />जो मारण खात्तर घसीटे जावै सै उन ताहीं छुड़ा;</para>
  <para style="q" vid="PRO 24:11">अर जो मारण खात्तर जाण आळे सै उननै रोक।<verse eid="PRO 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12" />जै तू कहवै, “कै मै इसनै न्ही जाणु था,”</para>
  <para style="q" vid="PRO 24:12">तो के मन का जाँचण आळा इसनै न्ही समझदा?</para>
  <para style="q" vid="PRO 24:12">अर के तेरी जान की हिफाजत करण आळा इसनै न्ही जाणदा?</para>
  <para style="q" vid="PRO 24:12">अर के वो हरेक माणस के काम का फळ उसनै न्ही देवैगा?<verse eid="PRO 24:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13" />हे मेरे बेट्टे तू शहद खा, क्यूँके वो आच्छा सै,</para>
  <para style="q" vid="PRO 24:13">अर शहद का छत्ता भी क्यूँके वो तेरे मुँह म्ह मिठ्ठा लाग्गैगा।<verse eid="PRO 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14" />इसे तरियां बुद्धि भी तन्‍नै उसीए मिठ्ठी लाग्गैगी;</para>
  <para style="q" vid="PRO 24:14">जै तू उसनै पा लेवै तो आखर म्ह उसका फळ भी मिलैगा, अर तेरी आस न्ही टूट्टैगी।<verse eid="PRO 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15" />तू दुष्ट की तरियां धर्मी के घर नै नाश करण खात्तर घात म्ह ना बैठ,</para>
  <para style="q" vid="PRO 24:15">अर उसकै आराम की जगहां नै ना उजाड़ै;<verse eid="PRO 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16" />क्यूँके धर्मी चाहे सात बार पड़ै फेर भी उठ खड्या होवै सै;</para>
  <para style="q" vid="PRO 24:16">पर दुष्ट माणस बिप्दा म्ह पड़कै पड़े रहवै सै।<verse eid="PRO 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17" />जिब तेरा बैरी हार जावै, तो तू घणा खुश ना होइये,</para>
  <para style="q" vid="PRO 24:17">अर जिब वो ठोक्‍कर खावै, तो तेरा मन मगन ना होवै।<verse eid="PRO 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18" />कदे इसा ना हो के यहोवा यो देखकै गुस्सा होवै,</para>
  <para style="q" vid="PRO 24:18">अर अपणा गुस्सा उसपै तै हटा ले।<verse eid="PRO 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19" />कुकर्मियाँ कै कारण मत कुढ़,</para>
  <para style="q" vid="PRO 24:19">दुष्ट माणसां के करण जळण ना करै।<verse eid="PRO 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20" />क्यूँके बुरे माणस नै आखर म्ह</para>
  <para style="q" vid="PRO 24:20">कुछ फळ न्ही मिलैगा, दुष्ट का दीवा बुझा दिया जावैगा।<verse eid="PRO 24:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21" />हे मेरे बेट्टे, यहोवा अर राजा दोनुआं को भय मानिये;</para>
  <para style="q" vid="PRO 24:21">अर उनके बिरुध्द बिद्रोह करण आळा कै गैल ना मिलिये;<verse eid="PRO 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22" />क्यूँके उनपै बिप्दा चाणचक आ पड़ैगी,</para>
  <para style="q" vid="PRO 24:22">अर परमेसवर या राजा की ओड़ तै आण आळी बिप्दा नै कौण जाणै सै?<verse eid="PRO 24:22" /></para>
  <para style="s">बुद्धिमान की और भी बातें</para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23" />बुद्धिमानां के वचन ये भी सै।</para>
  <para style="q" vid="PRO 24:23">न्याय म्ह भेदभाव करणा, किसे भी ढाळ ठीक कोनी।<verse eid="PRO 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24" />जो दुष्ट तै कहवै सै के तू बेकसूर सै,</para>
  <para style="q" vid="PRO 24:24">उसनै तो हर समाज के लोग श्राप देवै, अर जात-जात के माणस धमकावै सै;<verse eid="PRO 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25" />पर जो माणस दुष्ट नै डाँटै सै, उनका भला होवै सै,</para>
  <para style="q" vid="PRO 24:25">अर आच्छी-तै-आच्छी आशीष उनपै आवै सै।<verse eid="PRO 24:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26" />जो सीध्धा जवाब देवै सै,</para>
  <para style="q" vid="PRO 24:26">वो होठ्ठां नै चुम्मै सै।<verse eid="PRO 24:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27" />अपणा बाहर का काम-काज ठीक करिये,</para>
  <para style="q" vid="PRO 24:27">अर अपणे खात्तर खेत नै भी तैयार राखिये;</para>
  <para style="q" vid="PRO 24:27">उसकै बाद अपणा घर बणाईये।<verse eid="PRO 24:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28" />फजूल म्ह अपणे पड़ोसी कै बिरुध्द झूठ्ठी गवाही ना दिये,</para>
  <para style="q" vid="PRO 24:28">अर ना ए उसनै भकाईये।<verse eid="PRO 24:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29" />मत कह, “जिसा उसनै मेरै गैल करया उसाए मै भी उसकै गैल करुँगा;</para>
  <para style="q" vid="PRO 24:29">अर उसनै उसके काम कै मुताबिक बदला दियुँगा।”<verse eid="PRO 24:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30" />मै आलसी कै खेत धोरै तै</para>
  <para style="q" vid="PRO 24:30">अर बेअक्ले माणस की अंगूर के बाग धोरै तै जाया करुँ था,<verse eid="PRO 24:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31" />तो के देख्या, के ओड़ै हरेक जगहां कंटीले झाड़ उग आए सै;</para>
  <para style="q" vid="PRO 24:31">अर वो बिच्छु के पौधां तै ढंकगी सै,</para>
  <para style="q" vid="PRO 24:31">अर उसकै पत्थर का बाड़ा गिर ग्या सै।<verse eid="PRO 24:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32" />फेर मन्‍नै देख्या अर उसपै ध्यान लगाकै विचार करया;</para>
  <para style="q" vid="PRO 24:32">हाँ मन्‍नै देखकै शिक्षा पाई।<verse eid="PRO 24:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33" />छोट्टी सी नींद, एक और झपकी,</para>
  <para style="q" vid="PRO 24:33">थोड़ी देर छात्ती पै हाथ धरकै लेट्टे रहणा,<verse eid="PRO 24:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34" />फेर तेरा कंगालपण डाक्‍कू की ढाळ,</para>
  <para style="q" vid="PRO 24:34">अर तेरा घाट्टा हथियारबन्द माणस की ढाळ आ पड़ैगा।<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">सुलैमान की और भी ज्ञान की बातें</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 25:1" />सुलैमान के नीतिवचन ये भी सै;</para>
  <para style="q" vid="PRO 25:1">जिनकी नकल यहूदा के राजा हिजकिय्याह के माणसां नै नकल करी थी।<verse eid="PRO 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2" />परमेसवर की बड़ाई, गुप्त राक्खण म्ह सै,</para>
  <para style="q" vid="PRO 25:2">पर राजयां की बड़ाई, गुप्त बात का बेरा लगाण तै होवै सै।<verse eid="PRO 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3" />सुर्ग की ऊँचाई अर धरती की गहराई,</para>
  <para style="q" vid="PRO 25:3">अर राजयां का मन, तीनुआं की थाह न्ही मिलदी।<verse eid="PRO 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4" />चाँदी म्ह तै मैल दूर करण तै वा सुनार कै काम की हो जावै सै।<verse eid="PRO 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5" />उस्से तरियां, राजा कै स्याम्ही तै दुष्ट नै लिकाड़ देण पै उसकी गद्दी धर्म कै कारण टिक्यी रहवैगी।<verse eid="PRO 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6" />राजा के स्याम्ही अपणी बड़ाई ना करिये,</para>
  <para style="q" vid="PRO 25:6">अर ना बड़े माणसां की जगहां म्ह खड्या होइये;<verse eid="PRO 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7" />उनका तेरे खात्तर यो कहणा आच्छा सै के,</para>
  <para style="q" vid="PRO 25:7">“उरै मेरै धोरै आकै बैठ” ताके प्रधानां कै स्याम्ही तन्‍नै शर्मिन्दा न्ही होणा पड़ै।<verse eid="PRO 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8" />जो कुछ तन्‍नै देख्या सै, उस ताहीं उतावळी म्ह अदालत म्ह ना ल्यावै,</para>
  <para style="q" vid="PRO 25:8">आखर म्ह कोए और गवाह, तन्‍नै शर्मिन्दा करैगा तो तू के करैगा?<verse eid="PRO 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9" />अपणे पड़ोसी कै गैल कह्या-सुणी एकलै म्ह करिये</para>
  <para style="q" vid="PRO 25:9">अर पराये का भेद ना खोलिये;<verse eid="PRO 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10" />इसा ना हो के सुणण आळा तेरी भी बुराई करै,</para>
  <para style="q" vid="PRO 25:10">अर तेरी बुराई बणी रहवै।<verse eid="PRO 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11" />जुकर चाँदी की टोकरियाँ म्ह सोन्‍ने के सेब हो,</para>
  <para style="q" vid="PRO 25:11">उसाए ठीक बखत पै कह्या होया वचन होवै सै।<verse eid="PRO 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12" />जुकर सोन्‍ने की नथ अर कुन्दन का जेवर आच्छा लाग्गै सै,</para>
  <para style="q" vid="PRO 25:12">उस्से तरियां मानण आळे कै कान म्ह बुद्धिमान की डाँट भी आच्छी लाग्गै सै।<verse eid="PRO 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13" />जुकर लामणी<note caller="+" style="f"><char style="fr" closed="false">25:13 </char><char style="fq" closed="false">लामणी </char><char style="ft" closed="false">गर्मी के दिनां मै</char></note> कै बखत बर्फ की ठण्ड सै,</para>
  <para style="q" vid="PRO 25:13">उस्से तरियां बिश्वास लायक दूत तै भी,</para>
  <para style="q" vid="PRO 25:13">भेजण आळे का जी ठण्डा होवै सै।<verse eid="PRO 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14" />जुकर बादल अर हवा बिना बरसे कोए लाभ न्ही होन्दा,</para>
  <para style="q" vid="PRO 25:14">उस्से ढाळ झूठ-मूठ दान देण आळे का बड़ाई मारणा हो सै।<verse eid="PRO 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15" />सबर करण तै न्यायी मनाया जावै सै,</para>
  <para style="q" vid="PRO 25:15">अर नरम वचन हाड्डी नै भी तोड़दे सै।<verse eid="PRO 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />के तन्‍नै शहद पाया? तो जितना तेरे खात्तर ठीक हो उतनाए खाइये,</para>
  <para style="q" vid="PRO 25:16">इसा ना हो के घणा खाकै तू उसनै उगलदे।<verse eid="PRO 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17" />अपणे पड़ोसी कै घर म्ह बारबार जाण तै अपणे पायां नै रोक,</para>
  <para style="q" vid="PRO 25:17">इसा ना हो के वो ऊबकै नफरत करण लाग्गै।<verse eid="PRO 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18" />जो किसे कै बिरोध म्ह झूठ्ठी गवाही देवै सै,</para>
  <para style="q" vid="PRO 25:18">वो मान्‍नो हथौड़ा अर तलवार अर पैन्‍ना तीर सै।<verse eid="PRO 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19" />बिप्दा कै बखत धोक्खेबाज का भरोस्सा,</para>
  <para style="q" vid="PRO 25:19">टूट्टे होड़ दाँत या उखड़े पाँ कै जिसा सै।<verse eid="PRO 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20" />जुकर जाड्डे के दिनां म्ह किसे के कपड़े तारणा या घाव<note caller="+" style="f"><char style="fr" closed="false">25:20 </char><char style="fq" closed="false">घाव </char><char style="ft" closed="false">नमक मै सिरका</char></note> पै सिरका गेरणा हो सै,</para>
  <para style="q" vid="PRO 25:20">उस्से ढाळ उदास मन आळे कै स्याम्ही गीत गाणा हो सै।<verse eid="PRO 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21" />जै तेरा बैरी भूक्खा हो तो उसनै रोट्टी खुवाईये;</para>
  <para style="q" vid="PRO 25:21">अर जै वो तिसाया हो तो उसनै पाणी पियाईये;<verse eid="PRO 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22" />क्यूँके इस तरियां करण तै तू उसनै शर्मिन्दा करैगा<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">उसकै सिर पै अंगारे गेरैगा,</char></note>,</para>
  <para style="q" vid="PRO 25:22">अर यहोवा तन्‍नै इसका फळ देवैगा।<verse eid="PRO 25:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23" />जुकर उत्तर दिशा की हवा मिह लेकै आवै सै,</para>
  <para style="q" vid="PRO 25:23">उस्से तरियां, चुगली करण तै मुँह पै गुस्सा छा जावै सै।<verse eid="PRO 25:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />लम्बे-चौड़े घर म्ह झगड़ालू पत्नी गैल रहण तै छात की कूण म्ह पड़े रहणा घणा आच्छा सै।<verse eid="PRO 25:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25" />दूर देश तै आई खुशखबरी,</para>
  <para style="q" vid="PRO 25:25">तिसाए खात्तर ठण्डे पाणी के समान सै।<verse eid="PRO 25:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26" />जो धर्मी दुष्ट की भकाई म्ह आवै सै,</para>
  <para style="q" vid="PRO 25:26">वो खराब चोवा अर सड़े होए कुण्ड जिसा सै।<verse eid="PRO 25:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27" />जिस तरियां घणा शहद खाणा ठीक कोनी,</para>
  <para style="q" vid="PRO 25:27">उस्से तरियां खुद की बड़ाई करणा ठीक कोनी।<verse eid="PRO 25:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />जो अपणे-आपनै काब्बू मै ना राक्खै वो इसे नगर की ढाळ सै जिसकी चारदीवारी घेर कै तोड़ दी गई हो।<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1" />जिसा धूप म्ह बर्फ का, या लामणी कै बखत मिह का पड़णा,</para>
  <para style="q" vid="PRO 26:1">उसे ढाळ मूर्ख की बड़ाई भी ठीक न्ही होन्दी।<verse eid="PRO 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2" />जुकर गौरैया घूमदे-घूमदे अर शूपाबेनी उड़दे-उड़दे न्ही बैठदी,</para>
  <para style="q" vid="PRO 26:2">उस्से ढाळ फजूल का श्राप न्ही लागदा।<verse eid="PRO 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3" />घोड़े खात्तर चाब्बुक, गधे खात्तर नकेल,</para>
  <para style="q" vid="PRO 26:3">अर मूर्ख की पीठ खात्तर छड़ी सै।<verse eid="PRO 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4" />मूर्ख नै उसकी मूर्खता कै हिसाब तै जवाब ना दिये इसा ना हो के तू भी उसकै जिसा ए ठहरै।<verse eid="PRO 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5" />मूर्ख नै उसकी मूर्खता कै मुताबिक जवाब देणा,</para>
  <para style="q" vid="PRO 26:5">इसा ना हो के वो अपणी जाण मै बुद्धिमान ठहरै।<verse eid="PRO 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6" />जो मूर्ख कै हाथ संदेसा भेज्जै सै,</para>
  <para style="q" vid="PRO 26:6">वो मान्‍नो अपणे पैरां पै आप कुहाड़ा मारै अर जहर पीवै सै।<verse eid="PRO 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7" />जुकर लंगड़े के पाँ लड़खड़ावै सै,</para>
  <para style="q" vid="PRO 26:7">उस्से तरियां मूर्खां कै मुँह म्ह नीतिवचन हो सै।<verse eid="PRO 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8" />जुकर पत्थरां कै ढेर म्ह मणियाँ की थैल्‍ली,</para>
  <para style="q" vid="PRO 26:8">उस्से ढाळ मूर्ख ताहीं बड़ाई देणी हो सै।<verse eid="PRO 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9" />जुकर मतवाले कै हाथ म्ह कांडा गड़ै सै,</para>
  <para style="q" vid="PRO 26:9">उस्से तरियां मूर्खां का कह्या होया नीतिवचन भी दुखदाई हो सै।<verse eid="PRO 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10" />जुकर कोए तीरन्दाज जो बिना कारण सारया नै मारै सै,</para>
  <para style="q" vid="PRO 26:10">उस्से तरियां मूर्ख या राह चाल्दे<note caller="+" style="f"><char style="fr" closed="false">26:10 </char><char style="fq" closed="false">राह चाल्दे </char><char style="ft" closed="false">दारु पिए होये </char></note> नै मजदूरी म्ह लगाण आळा भी हो सै।<verse eid="PRO 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11" />जुकर कुत्ता अपणी उलटी नै चाट्टै सै,</para>
  <para style="q" vid="PRO 26:11">उस्से ढाळ मूर्ख भी अपणी मूर्खता नै दोहरावै सै।<verse eid="PRO 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12" />जै तू इसा माणस देक्खै, जो अपणी जाण म्ह बुद्धिमान बणदा हो,</para>
  <para style="q" vid="PRO 26:12">तो उसतै घणी आस मूर्ख तै ए सै।<verse eid="PRO 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />आलसी कहवै सै, “राह म्ह शेर सै,</para>
  <para style="q" vid="PRO 26:13">चौक म्ह शेर सै!”<verse eid="PRO 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14" />जुकर किवाड़ चूळ पै घूम्मै सै,</para>
  <para style="q" vid="PRO 26:14">उस्से ढाळ आलसी अपणी खाट पै मसकोड़े मारै सै।<verse eid="PRO 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15" />आलसी अपणा हाथ थाळी मै मारै तो सै,</para>
  <para style="q" vid="PRO 26:15">पर आलस कै कारण निवाळा मुँह ताहीं न्ही उठान्दा।<verse eid="PRO 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16" />आलसी अपणे-आपनै सही जवाब देण आळे</para>
  <para style="q" vid="PRO 26:16">सात माणसां तै भी घणा बुद्धिमान समझै सै।<verse eid="PRO 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17" />जो राह चाल्दे होए पराये झगड़े म्ह बिघन गेरै सै,</para>
  <para style="q" vid="PRO 26:17">वो उसकी ढाळ सै, जो बावळे कुत्याँ नै कान्‍नां तै पकड़ै सै।<verse eid="PRO 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18" />जुकर एक पागल जो जहरीले तीर मारै सै,<verse eid="PRO 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19" />उसाए वो भी हो सै जो अपणे पड़ोसी नै धोक्खा देकै कहवै सै,</para>
  <para style="q" vid="PRO 26:19">“मै तो मजाक करुँ था।”<verse eid="PRO 26:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20" />जुकर लाकड़ी ना होण तै आग बुझै सै,</para>
  <para style="q" vid="PRO 26:20">उस्से ढाळ जड़ै चुगली करण आळा न्ही ओड़ै झगड़ा मिट जावै सै।<verse eid="PRO 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21" />जुकर अंगारां म्ह कोल्‍ला अर आग म्ह लाकड़ी हो सै,</para>
  <para style="q" vid="PRO 26:21">उसाए झगड़ा बढ़ाण खात्तर झगड़ालू होवै सै।<verse eid="PRO 26:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22" />चुगली करण आळे के वचन,</para>
  <para style="q" vid="PRO 26:22">सुवाद खाणे की ढाळ भित्तर उतर जावै सै।<verse eid="PRO 26:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23" />जिसा कोए चाँदी का पाणी चढ़ाया होया माट्टी का बरतन हो,</para>
  <para style="q" vid="PRO 26:23">उसाए बुरे मन आळे के प्यार भरे वचन होवै सै।<verse eid="PRO 26:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24" />जो बैरी बात्तां तै तो अपणे-आपनै भोळा बणावै सै,</para>
  <para style="q" vid="PRO 26:24">पर अपणे मन म्ह कपट राक्खै सै,<verse eid="PRO 26:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25" />उसकी मिठ्ठी-मिठ्ठी बात्तां का भरोस्सा ना करिये,</para>
  <para style="q" vid="PRO 26:25">क्यूँके उसकै मन म्ह सात घिनोणी चीज रहवै सै;<verse eid="PRO 26:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26" />चाहे उसका बैर छल कै कारण छुप भी जावै,</para>
  <para style="q" vid="PRO 26:26">तोभी उसकी बुराई भीड़ सभा कै बीच म्ह उजागर हो जावैगी।<verse eid="PRO 26:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27" />जो खड्डा खोदै, वोए उस म्ह पड़ैगा, अर जो पत्थर लुढ़कावै,</para>
  <para style="q" vid="PRO 26:27">वो बोहड़कै उस्से पै पड़ैगा।<verse eid="PRO 26:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28" />जिसनै किसे ताहीं झूठ्ठी बात्तां तै घायल करया हो वो उसतै बैर राक्खै सै,</para>
  <para style="q" vid="PRO 26:28">अर चिकणी-चुपड़ी बात बोल्‍लणीयाँ नाश की जड़ हो सै।<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1" />कल कै दिन कै बारै म्ह डींग मत मारै,</para>
  <para style="q" vid="PRO 27:1">क्यूँके तू न्ही जाण्दा के दिन भर म्ह के होवैगा।<verse eid="PRO 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2" />तेरी बड़ाई और माणस करै तो करै, पर तू खुद ना करिये;</para>
  <para style="q" vid="PRO 27:2">दूसरा तन्‍नै सराहवै तो सराहवै, पर तू अपणी सराहणा ना करिये।<verse eid="PRO 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3" />पत्थर तो भारी सै, अर बालू रेत म्ह बोझ सै,</para>
  <para style="q" vid="PRO 27:3">पर मूर्ख का गुस्सा, उन दोनुआ तै भी भारी सै।<verse eid="PRO 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4" />गुस्से का जुल्म अर प्रकोप की बाढ़,</para>
  <para style="q" vid="PRO 27:4">पर जळण कै स्याम्ही कौण ठैहर सकै सै?<verse eid="PRO 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5" />खुली होई डाँट गुप्त प्यार तै आच्छी सै,<verse eid="PRO 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6" />जो जख्म दोस्त कै हाथ तै लाग्गै वो भरोसै बिश्वास लायक सै</para>
  <para style="q" vid="PRO 27:6">पर बैरी घणा लाड-लड़ावै सै।<verse eid="PRO 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7" />छिके होण पै मधु का छात्ता भी फिक्‍का लाग्गै सै,</para>
  <para style="q" vid="PRO 27:7">पर भूक्खे नै सब कड़वी चीज भी मिठ्ठी लाग्गै सै।<verse eid="PRO 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8" />जगहां छोड़कै घूम्मण आळा माणस उस चिड़ियाँ जिसा सै,</para>
  <para style="q" vid="PRO 27:8">जो घोसला छोड़कै उड़दी फिरै सै।<verse eid="PRO 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9" />जुकर तेल अर खुशबु तै,</para>
  <para style="q" vid="PRO 27:9">उस्से तरियां दोस्त कै मन तै लिकड़ी आच्छी सलाह तै मन राज्जी हो सै।<verse eid="PRO 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10" />जो तेरा अर तेरे पिता का भी दोस्त हो उसनै ना छोड़िये;</para>
  <para style="q" vid="PRO 27:10">अर अपणी बिप्दा कै दिन, भाई कै घरा ना जाईये।</para>
  <para style="q" vid="PRO 27:10">प्यार करण आळा पड़ोसी, दूर रहण आळे भाई तै घणा बढ़कै सै।<verse eid="PRO 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11" />हे मेरे बेट्टे, बुद्धिमान होकै मेरै मन नै राज्जी कर,</para>
  <para style="q" vid="PRO 27:11">तो मै अपणी बुराई करण आळे नै जवाब दे सकूँगा।<verse eid="PRO 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12" />बुद्धिमान माणस बिप्दा नै आन्दे देखकै छुप जावै सै;</para>
  <para style="q" vid="PRO 27:12">पर भोळे माणस आग्गै बढ़दे चाल्‍ले जावै सै, अर दुख ठावै सै।<verse eid="PRO 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13" />जो पराये का जमानती हो उसका कपड़ा,</para>
  <para style="q" vid="PRO 27:13">अर जो अनजाण का जमानती हो उसतै बंधक का समान ले ले।<verse eid="PRO 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14" />जो सबेरै उठकै अपणे पड़ोसी नै ऊँच्‍ची आवाज म्ह आशीर्वाद देवै सै,</para>
  <para style="q" vid="PRO 27:14">उसकै खात्तर यो श्राप गिणा जावै सै।<verse eid="PRO 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15" />झड़ी कै दिन पाणी का लगातार टपकणा,</para>
  <para style="q" vid="PRO 27:15">अर झगड़ालू पत्नी एक जिसे सै;<verse eid="PRO 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16" />जो उसनै रोक्‍के राक्खै, वो हवा नै भी रोक्‍के राक्खैगा अर सोळे हाथ तै वो तेल पकड़ण की कोशिश करैगा।<verse eid="PRO 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17" />जुकर लोहा लोहे नै चमका देवै सै,</para>
  <para style="q" vid="PRO 27:17">उस्से तरियां माणस का मुँह अपणे दोस्त की संगत तै चमकदार हो जावै सै।<verse eid="PRO 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18" />जो अंजीर कै पेड़ की हिफाजत करै सै वो उसका फळ खावै सै,</para>
  <para style="q" vid="PRO 27:18">इसे ढाळ जो अपणे माल्‍लिक की सेवा करै सै उसकी बड़ाई होवै सै।<verse eid="PRO 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19" />जुकर पाणी म्ह मुँह की छाया मुँह नै जाहिर करै सै,</para>
  <para style="q" vid="PRO 27:19">उस्से तरियां माणस का मन माणस नै जाहिर करै सै।<verse eid="PRO 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20" />जुकर अधोलोक अर पताळ,</para>
  <para style="q" vid="PRO 27:20">उसे ढाळ माणस की लालसा<note caller="+" style="f"><char style="fr" closed="false">27:20 </char><char style="fq" closed="false">माणस की लालसा</char><char style="ft" closed="false">आँख</char></note> कदे भी खतम न्ही होन्दी।<verse eid="PRO 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21" />जुकर चाँदी खात्तर कुठाळी सोन्‍ने खात्तर भट्ठी सै,</para>
  <para style="q" vid="PRO 27:21">उस्से ढाळ माणस खात्तर उसकी बड़ाई सै।<verse eid="PRO 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22" />चाहे तू मूर्ख नै गेहूँ के बीच ओखळी म्ह घाल कै मुस्सळ तै कुट्टै,</para>
  <para style="q" vid="PRO 27:22">तोभी उसकी मूर्खता न्ही जावैगी।<verse eid="PRO 27:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23" />अपणी भेड़-बकरियाँ की दशा आच्छी ढाळ जी लगाकै जाण ले,</para>
  <para style="q" vid="PRO 27:23">अर अपणे सारे जानवरां कै झुण्ड की रुखाळ आच्छी तरियां कर।<verse eid="PRO 27:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24" />क्यूँके जायदाद सदा न्ही रहन्दी;</para>
  <para style="q" vid="PRO 27:24">अर के राजपद<note caller="+" style="f"><char style="fr" closed="false">27:24 </char><char style="fq" closed="false">राजपद </char><char style="ft" closed="false">राजमुकुट</char></note> पीढ़ी तै पीढ़ी ताहीं बण्या रहवै सै?<verse eid="PRO 27:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25" />कटी होई घास उठा ली जावै अर नई घास दिखाई दे सै</para>
  <para style="q" vid="PRO 27:25">पहाड़ां की हरियाली काटकै कठ्ठी करी जावै सै;<verse eid="PRO 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26" />तब भेड्डां के बच्‍चे तेरे कपड़े खात्तर होंगे,</para>
  <para style="q" vid="PRO 27:26">अर बकरां कै जरिये खेत की कीमत दी जावैगी;<verse eid="PRO 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27" />अर बकरियाँ का इतणा दूध होवैगा के तू अपणे घराने समेत पेट भरकै पिया करैगा,</para>
  <para style="q" vid="PRO 27:27">अर तेरी दासियाँ का भी गुजारा होन्दा रहवैगा।<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1" />दुष्ट माणस जब कोए पिच्छा न्ही करदा जब भी भाग्गै सै,</para>
  <para style="q" vid="PRO 28:1">पर धर्मी लोग जवान शेरां की ढाळ निडर रहवै सै।<verse eid="PRO 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2" />देश म्ह पाप होण कै कारण उसके हाकिम बदलदे जावै सै;</para>
  <para style="q" vid="PRO 28:2">पर समझदार अर ज्ञान्‍नी माणसां के जरिये आच्छा इन्तजाम भोत दिनां खात्तर बण्या रहवैगा।<verse eid="PRO 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3" />जो गरीब माणस<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="fq" closed="false">गरीब माणस </char><char style="ft" closed="false">अधिकारी </char></note> कंगालां पै अन्धेर करै सै,</para>
  <para style="q" vid="PRO 28:3">वो इसी भारी बारिस की ढाळ सै जो कुछ भी फसल न्ही छोड़दी।<verse eid="PRO 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4" />जो माणस नियम-कायदा नै छोड़ दे सै, वो दुष्ट की बड़ाई करै सै,</para>
  <para style="q" vid="PRO 28:4">पर नियम-कायदा पै चालण आळे उनका बिरोध्द करै सै।<verse eid="PRO 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5" />बुरे माणस न्याय नै न्ही समझ सकदे,</para>
  <para style="q" vid="PRO 28:5">पर यहोवा नै ढूँढ़ण आळे सब कुछ समझै सै।<verse eid="PRO 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6" />टेढ़ी चाल चालण आळे धनी माणस तै खराई तै चालण आळा गरीब माणस बढ़िया सै।<verse eid="PRO 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7" />जो नियम-कायदा नै मानण आळा सै वो समझदार सपूत होवै सै,</para>
  <para style="q" vid="PRO 28:7">पर उड़ाऊ का संगी अपणे बाप का मुँह काळा करै सै।<verse eid="PRO 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8" />जो अपणा धन ब्याज तै बढ़ावै सै,</para>
  <para style="q" vid="PRO 28:8">वो उन खात्तर कठ्ठा करै सै जो कंगाल पै अनुग्रह करै सै।<verse eid="PRO 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9" />जो अपणा कान नियम-कायदा नै सुणण तै मोड़ लेवै सै,</para>
  <para style="q" vid="PRO 28:9">उसकी प्रार्थना घृणित ठहरै सै।<verse eid="PRO 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10" />जो सीध्धे माणसां नै भटका कै बुरे राह पै ले जावै सै वो अपणे खोद्दे होड़ गड्ढे म्ह आप्पे पड़ै सै;</para>
  <para style="q" vid="PRO 28:10">पर खरे माणस कल्याण के भागी होवै सै।<verse eid="PRO 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11" />धणी माणस अपणी नजर म्ह बुद्धिमान होवै सै,</para>
  <para style="q" vid="PRO 28:11">पर समझदार कंगाल उसका मर्म समझ ले सै।<verse eid="PRO 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12" />जिब धर्मी माणस जीत्तै सै, तो बड़ी शोभा होवै सै;</para>
  <para style="q" vid="PRO 28:12">पर जिब दुष्ट माणस हावी हो सै, फेर माणस अपणे-आपनै छिपावै सै।<verse eid="PRO 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13" />जो अपणे कसूर छिपाकै राक्खै सै, उसका काम पूरा न्ही होन्दा,</para>
  <para style="q" vid="PRO 28:13">पर जो उननै मान लेवै सै, अर छोड़ भी देवै सै,</para>
  <para style="q" vid="PRO 28:13">उसपै दया करी जावैगी।<verse eid="PRO 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14" />जो माणस लगातार बुरे काम करण तै डरे सै<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="fq" closed="false">बुरे काम करण तै डरे सै </char><char style="ft" closed="false">यहोवा का डर मानता</char></note> वो धन्य सै;</para>
  <para style="q" vid="PRO 28:14">पर जो अपणा मन कठोर कर लेवै सै वो बिप्दा म्ह पड़ै सै।<verse eid="PRO 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15" />कंगाल प्रजा पै राज करण आळे दुष्ट, गरजण आळे शेर अर घूम्मण आळे रीछ की ढाळ सै।<verse eid="PRO 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16" />वो शासक जिस म्ह समझ की कमी होवै, वो भोत अन्धेर करै सै;</para>
  <para style="q" vid="PRO 28:16">अर जो लालच का बैरी होवै सै उसकी लाम्बी उम्र होवै सै।<verse eid="PRO 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17" />जो किसे प्राणी की हत्या का कसूरवार हो, वो भाजकै खड्डे म्ह गिरैगा;</para>
  <para style="q" vid="PRO 28:17">कोए उसनै न्ही रोक्‍कैगा।<verse eid="PRO 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18" />जो सिधाई तै चाल्‍लै सै वो बचाया जावैगा,</para>
  <para style="q" vid="PRO 28:18">पर जो टेढ़ी चाल चाल्‍लै सै वो चाणचक गिर जावै सै।<verse eid="PRO 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19" />जो अपणी धरती नै बोवै सै, उसका तो पेट भरै सै,</para>
  <para style="q" vid="PRO 28:19">पर जो निकम्मे माणसां की संगति म्ह रहवै सै वो कंगालपण तै घिरया रहवै सै।<verse eid="PRO 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20" />सच्‍चे माणस पै भोत-से आशीर्वाद होन्दे रहवै सै,</para>
  <para style="q" vid="PRO 28:20">पर जो धनी होण म्ह तावळ करै सै, वो निर्दोष न्ही ठहरदा।<verse eid="PRO 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21" />पक्षपात करणा ठीक कोनी;</para>
  <para style="q" vid="PRO 28:21">अर यो भी ठीक कोनी के माणस रोट्टी के टुकड़े खात्तर जुर्म करै।<verse eid="PRO 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22" />लोभ्भी माणस धन पाण म्ह उतावळी करै सै,</para>
  <para style="q" vid="PRO 28:22">अर न्ही जाणदा कै घाट्टै म्ह पड़ैगा।<verse eid="PRO 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23" />जो किसे माणस नै धमकावै सै वो बाद म्ह चुगली करण आळे तै भी घणा प्यारा हो जावै सै।<verse eid="PRO 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24" />जो अपणे माँ-बाप नै लूट कै कहवै सै के कोए जुर्म कोनी,</para>
  <para style="q" vid="PRO 28:24">वो नाश करण आळे का संगी ठहरै सै।<verse eid="PRO 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25" />लालची माणस रोळा मचावै सै,</para>
  <para style="q" vid="PRO 28:25">अर जो यहोवा पै भरोस्सा राक्खै सै वो हष्ट-पुष्ट हो जावै सै।<verse eid="PRO 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26" />जो खुद पै भरोस्सा राक्खै सै, वो मूर्ख सै;</para>
  <para style="q" vid="PRO 28:26">अर जो बुद्धि तै चाल्‍लै वो बचै सै।<verse eid="PRO 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27" />जो गरीब नै दान देवै सै उसकै कमी कोनी होन्दी,</para>
  <para style="q" vid="PRO 28:27">पर जो गरीबां तै निगांह फेर लेवै सै वो श्राप पै श्राप पावै सै।<verse eid="PRO 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28" />जिब दुष्ट माणस हावी होवै सै तो माणस टोहण तै भी न्ही मिलदे,</para>
  <para style="q" vid="PRO 28:28">पर जिब वे नाश हो जावै सै, तब धर्मी तरक्‍की करै सै।<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1" />जो बार-बार धमकाए जाण तै भी अकड़ राक्खै सै, वो चाणचक नाश हो जावैगा</para>
  <para style="q" vid="PRO 29:1">अर उसका कोए भी तरिक्‍का काम न्ही आवैगा।<verse eid="PRO 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2" />जिब धर्मी माणस शिरोमणि होवै सै, तब प्रजा खुश होवै सै;</para>
  <para style="q" vid="PRO 29:2">पर जिब दुष्ट राज करै सै तब प्रजा हाय-हाय करै सै।<verse eid="PRO 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3" />जो बुद्धि तै लगाव राक्खै सै, अपणे पिता नै खुश करै सै,</para>
  <para style="q" vid="PRO 29:3">पर बेश्या की संगत करण आळा धन नै उड़ा देवै सै।<verse eid="PRO 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4" />राजा न्याय तै देश नै बणाये राक्खे सै,</para>
  <para style="q" vid="PRO 29:4">पर जो घणी रिसवत लेवै सै उसनै उल्ट देवै सै।<verse eid="PRO 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5" />जो माणस किसे तै चिकणी-चुपड़ी बात करै सै,</para>
  <para style="q" vid="PRO 29:5">वो उसके पैरां खात्तर जाळ बिछावै सै।<verse eid="PRO 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6" />बुरे माणस का कसूर फंदा होवै सै,</para>
  <para style="q" vid="PRO 29:6">पर धर्मी खुश होकै जय-जयकार करै सै।<verse eid="PRO 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7" />धर्मी माणस कंगालां के मुकद्दमे म्ह मन लगावै सै;</para>
  <para style="q" vid="PRO 29:7">पर दुष्ट माणस उसनै जाणण की समझ न्ही राखदा।<verse eid="PRO 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8" />मखौल करण आळे नगर नै जळा देवै सै,</para>
  <para style="q" vid="PRO 29:8">पर बुद्धिमान माणस गुस्से नै ठण्डा करै सै।<verse eid="PRO 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9" />जद बुद्धिमान मूर्ख गैल बहस करै सै,</para>
  <para style="q" vid="PRO 29:9">तो वो मूर्ख गुस्सा होवै सै अर मखौल करै सै, अर ओड़ै शान्ति न्ही रहन्दी।<verse eid="PRO 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10" />हत्यारे माणस खरे माणस तै बैर राक्खै सै,</para>
  <para style="q" vid="PRO 29:10">अर सीध्धे माणसां नै मारण खात्तर टोहवै सै।<verse eid="PRO 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11" />मूर्ख अपणे सारे मन की बात खोल देवै सै,</para>
  <para style="q" vid="PRO 29:11">पर बुद्धिमान अपणे मन नै रोक्‍कै अर शान्त कर देवै सै।<verse eid="PRO 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12" />जब हाकिम झूठ्ठी बात कान्ही कान लावै सै,</para>
  <para style="q" vid="PRO 29:12">तो उसके सारे सेवक दुष्ट हो जावै सै।<verse eid="PRO 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13" />गरीब अर अन्धेर करण आळे माणसां म्ह एक समानता सै,</para>
  <para style="q" vid="PRO 29:13">यहोवा दोनुआं की आँखां म्ह रोशनी देवै सै।<verse eid="PRO 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14" />जो राजा कंगालां का न्याय सच्‍चाई तै करै सै,</para>
  <para style="q" vid="PRO 29:14">उसकी गद्दी सदा तक बणी रहवै सै।<verse eid="PRO 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15" />छड़ी अर डाँट तै बुद्धि मिलै सै,</para>
  <para style="q" vid="PRO 29:15">पर जो बाळक न्यूए छोड्या जावै सै वो अपणी माँ की बेजती का कारण होवै सै।<verse eid="PRO 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16" />दुष्टां के बढ़ण तै कसूर भी बढ़ै सै;</para>
  <para style="q" vid="PRO 29:16">पर आखर म्ह धर्मी माणस उनका गिरणा देख लेवै सै।<verse eid="PRO 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17" />अपणे बेट्टे की ताड़ना कर, फेर तन्‍नै उसतै चैन मिलैगा;</para>
  <para style="q" vid="PRO 29:17">अर तेरा मन भी सुखी हो जावैगा।<verse eid="PRO 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18" />जड़ै दर्शन की बात न्ही होन्दी, ओड़ै लोग बेलगाम हो जावै सै,</para>
  <para style="q" vid="PRO 29:18">पर जो नियम-कायदा नै मान्‍नै सै वो धन्य होवै सै।<verse eid="PRO 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19" />दास बात्तां तै ए न्ही सुधारया जान्दा,</para>
  <para style="q" vid="PRO 29:19">क्यूँके वो समझकै भी न्ही मानदा।<verse eid="PRO 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20" />के तू बात करण म्ह उतावळी करण आळे माणस नै देक्खै सै?</para>
  <para style="q" vid="PRO 29:20">उसतै घणी तो मूर्ख तै आस सै।<verse eid="PRO 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21" />जो अपणे दास नै उसके लड़कपण तै ए लाड़-प्यार तै पाळै सै,</para>
  <para style="q" vid="PRO 29:21">वो दास आखर म्ह उसका बेट्टा बण बैठ्ठै सै।<verse eid="PRO 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22" />गुस्सा करण आळा माणस झगड़ा करै सै</para>
  <para style="q" vid="PRO 29:22">अर घणा गुस्सा करणीया अपराधी भी होवै सै।<verse eid="PRO 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23" />माणस नै घमण्ड कै कारण नीच्‍चा देखणा पड़ै सै,</para>
  <para style="q" vid="PRO 29:23">पर नम्र आत्मा आळा महिमा का हकदार हो सै।<verse eid="PRO 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24" />जो चोर की संगति करै सै वो अपणी जान का दुश्मन हो सै;</para>
  <para style="q" vid="PRO 29:24">कसम खाण तै भी वो अपणी बात न्ही खोल्दा।<verse eid="PRO 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25" />माणस का डरणा उसका फंदा हो जावै सै,</para>
  <para style="q" vid="PRO 29:25">पर जो यहोवा पै भरोस्सा राक्खै सै उसकी जगहां करी जावैगी।<verse eid="PRO 29:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26" />हाकिम तै मिलणा तो भोत लोग चाहवै सै,</para>
  <para style="q" vid="PRO 29:26">पर माणस का न्याय यहोवा ए करै सै।<verse eid="PRO 29:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27" />धर्मी माणस बेईमान माणस तै नफरत करै सै</para>
  <para style="q" vid="PRO 29:27">अर दुष्ट माणस भी सीध्धी चाल-चाल्‍लण आळे तै नफरत करै सै।<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">आगूर के वचन</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 30:1" />याके के बेट्टे आगूर के प्रभावशाली वचन।</para>
  <para style="q" vid="PRO 30:1">उस माणस नै ईतीएल<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="fq" closed="false">ईतीएल </char><char style="ft" closed="false">ईतीएल मतलब हे परमेसवर मै घणा थक गया सूं</char></note> और उक्‍काल<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="fq" closed="false">उक्‍काल </char><char style="ft" closed="false">मतलब हे परमेसवर मै पूरी तरह तै थक गया सूं</char></note> तै यो कह्या:<verse eid="PRO 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />जरुर मै पशु जिसा सूं, बलके माणस कुहाण लायक भी कोनी;</para>
  <para style="q" vid="PRO 30:2">अर माणस की समझ मेरे म्ह कोनी।<verse eid="PRO 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3" />ना मन्‍नै बुद्धि पाई सै,</para>
  <para style="q" vid="PRO 30:3">अर ना ए परमपवित्र का ज्ञान मन्‍नै मिल्या सै।<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />कौण सुर्ग म्ह चढ़कै फेर उतर आया?</para>
  <para style="q" vid="PRO 30:4">किसनै हवा ताहीं अपणी मुट्ठी म्ह बाँध राख्या सै?</para>
  <para style="q" vid="PRO 30:4">किसनै महासागर ताहीं अपणे कपड़े म्ह बाँध लिया सै?</para>
  <para style="q" vid="PRO 30:4">किसनै धरती की हद बणाई सै? उसका नाम के सै?</para>
  <para style="q" vid="PRO 30:4">अर उसके बेट्टे का नाम के सै? जै तू जाणै सै तो बता!<verse eid="PRO 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5" />परमेसवर का एक-एक वचन त्याया होया सै;</para>
  <para style="q" vid="PRO 30:5">वो अपणे शरणागतां की ढाल बणै सै।<verse eid="PRO 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6" />उसके वचनां म्ह कुछ भी ना बढ़ावै,</para>
  <para style="q" vid="PRO 30:6">इसा ना होवै के वो तन्‍नै धमकावै और तू झूठ्ठा ठहरै।<verse eid="PRO 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7" />मन्‍नै तेरे ताहीं दो वरदान माँग्गे सै,</para>
  <para style="q" vid="PRO 30:7">इस करकै मेरै मरण तै पैहले वरदान देण तै मुँह ना मोड़<verse eid="PRO 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8" />यानी बेकार अर झूठ्ठी बात मेरै तै दूर राखिये; मन्‍नै ना तो कंगाल और ना ए अमीर बणा;</para>
  <para style="q" vid="PRO 30:8">रोज की रोट्टी मन्‍नै खुवाया कर।<verse eid="PRO 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9" />इसा ना हो के जिब मेरा पेट भर जावै, तो मै इनकार करकै कहूँ के यहोवा कौण सै?</para>
  <para style="q" vid="PRO 30:9">या गरीब होकै चोरी करुँ,</para>
  <para style="q" vid="PRO 30:9">अर परमेसवर के नाम का अपमान करुँ।<verse eid="PRO 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10" />किसे दास की चुगली उसकै माल्‍लिक तै ना करिये,</para>
  <para style="q" vid="PRO 30:10">इसा ना हो के वो तन्‍नै श्राप देवै, अर तू दोषी ठहराया जावै।<verse eid="PRO 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11" />इसे माणस सै, जो अपणे पिता नै श्राप देवै सै</para>
  <para style="q" vid="PRO 30:11">अर अपणी माँ नै धन्य न्ही कहन्दे।<verse eid="PRO 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12" />वे इसे माणस सै जो अपणी निगांह म्ह पवित्र सै,</para>
  <para style="q" vid="PRO 30:12">पर उनका मैल धोया न्ही गया।<verse eid="PRO 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13" />एक पीढ़ी के माणस इसे सै उनकी निगांह कितनी घमण्ड तै भरी सै,</para>
  <para style="q" vid="PRO 30:13">अर उनकी आँख किस तरियां चढ़ी रहवै सै।<verse eid="PRO 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14" />एक पीढ़ी के माणस इसे सै, जिनके दाँत तलवार अर उनके जाड़ छुरी सै,</para>
  <para style="q" vid="PRO 30:14">जिनतै वे नरम माणसां नै धरती पै तै, अर गरीबां नै माणसां म्ह तै मिटा देवै।<verse eid="PRO 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15" />जिस तरियां जोंक की दो बेट्टी होवै सै, जो कहवै सै “दे, दे”</para>
  <para style="q" vid="PRO 30:15">उसी तरियां तीन चीज सै, जो कदे तृप्त न्ही होन्दी; बलके चार सै,</para>
  <para style="q" vid="PRO 30:15">जो कदे न्ही कहन्दी, “बस।”<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />अधोलोक अर बाँझ की कोख,</para>
  <para style="q" vid="PRO 30:16">धरती जो पाणी पी कै कदे तृप्त न्ही होन्दी,</para>
  <para style="q" vid="PRO 30:16">आग जो कदे न्ही कहन्दी “बस।”<verse eid="PRO 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17" />जिस आँख तै कोए अपणे बाप नै अनादर की नजर तै देक्खै,</para>
  <para style="q" vid="PRO 30:17">अर अपमान कै गैल अपणी माँ की बात ना मान्‍नै,</para>
  <para style="q" vid="PRO 30:17">उस आँख नै तराई के काग खोद-खोदकै लिकाड़ैगें,</para>
  <para style="q" vid="PRO 30:17">अर उकाब के बच्‍चें खा जावैंगे।<verse eid="PRO 30:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18" />तीन बात मेरै खात्तर भोत मुश्किल सै,</para>
  <para style="q" vid="PRO 30:18">बलके चार सै, जो मेरी समझ तै परै सै<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />आसमान म्ह उकाब पक्षी की राह,</para>
  <para style="q" vid="PRO 30:19">चट्टान पै साँप की चाल, समुन्दर म्ह जहाज की चाल,</para>
  <para style="q" vid="PRO 30:19">अर कन्या गैल माणस की चाल,<verse eid="PRO 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20" />जार जनान्‍नी की चाल भी उसीए सै,</para>
  <para style="q" vid="PRO 30:20">वो खाणा खाकै मुँह नै पूंजै सै,</para>
  <para style="q" vid="PRO 30:20">अर कहवै सै मन्‍नै कोए गलत काम न्ही करया।<verse eid="PRO 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21" />तीन बात्तां के कारण धरती काँप्पै सै; बलके चार सै,</para>
  <para style="q" vid="PRO 30:21">जो उसतै सई न्ही जान्दी<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />दास का राजा बण जाणा,</para>
  <para style="q" vid="PRO 30:22">मूर्ख का पेट भरणा<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />घिनोणी जनान्‍नी का ब्याहया जाणा,</para>
  <para style="q" vid="PRO 30:23">अर दास्सी का अपणी मालकिन की वारिस हो जाणा।<verse eid="PRO 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24" />धरती पै चार छोट्टे जन्तु सै,</para>
  <para style="q" vid="PRO 30:24">जो घणे बुद्धिमान सै<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />कीड़ी कमजोर जात्ति तो सै,</para>
  <para style="q" vid="PRO 30:25">पर घाम म्ह अपणे खाण-पीण का बन्दौबस्त कर लेवै सै;<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />पहाड़ी बिज्जू ताकतवर जात्ति तो कोनी,</para>
  <para style="q" vid="PRO 30:26">तोभी उसके रहण का ठिकाणा पहाड़ां पै होवै सै;<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />टिड्डियाँ का कोए राजा तो न्ही होन्दा,</para>
  <para style="q" vid="PRO 30:27">फेर भी वे एक साथ कठ्ठी होकै चालै सै;<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />अर छिपकली हाथ तै तो पकड़ी जावै सै,</para>
  <para style="q" vid="PRO 30:28">तोभी वे राजमहल म्ह रहवै सै;<note caller="+" style="f"><char style="fr" closed="false">30:28 </char><char style="ft" closed="false">मकड़ी अपणे हाथ्थां तै जाळ बणावै सै और राजमहल रहवै सै</char></note><verse eid="PRO 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29" />तीन सुन्दर चाल्‍लण आळे प्राणी सै,</para>
  <para style="q" vid="PRO 30:29">बल्के चार सै जिनकी चाल सुन्दर सै:<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />शेर जो सारे पशुआं म्ह पराक्रमी सै,</para>
  <para style="q" vid="PRO 30:30">अर किसे कै डर तै न्ही हटदा;<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />शिकारी कुत्ता<note caller="+" style="f"><char style="fr" closed="false">30:31 </char><char style="fq" closed="false">शिकारी कुत्ता </char><char style="ft" closed="false">अकड़ा होया मुर्गा, लड़ाई का घोड़ा</char></note>, बकरा,</para>
  <para style="q" vid="PRO 30:31">अर अपणी सेना समेत राजा।<verse eid="PRO 30:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32" />जै तन्‍नै अपणे बड़ाई करण की बेकूफी करी,</para>
  <para style="q" vid="PRO 30:32">या कोए बुरी योजना बणाई हो, तो अपणे मुँह पै हाथ राक्ख।<verse eid="PRO 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33" />क्यूँके जिस तरियां दूध कै बिलौण तै मक्खन,</para>
  <para style="q" vid="PRO 30:33">अर नाक नै मरोढ़ण तै खून लिकड़ै सै,</para>
  <para style="q" vid="PRO 30:33">उस्से तरियां गुस्सा भड़काण तै झगड़ा पैदा होवै सै।<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">राजा नै सलाह</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 31:1" />लमूएल राजा के असरदार वचन, जो उसकी माँ नै उस ताहीं सिखाए।<verse eid="PRO 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2" />हे मेरे बेट्टे, हे मेरे अपणे बेट्टे!</para>
  <para style="q" vid="PRO 31:2">हे मेरी मन्‍नतां के बेट्टे!<verse eid="PRO 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3" />अपणी ताकत जनानियाँ नै ना दिये,</para>
  <para style="q" vid="PRO 31:3">अर ना अपणा जीवन उनके बस म्ह करिये, जो राजयां की ताकत खां जावै सै।<verse eid="PRO 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4" />हे लमूएल, राजा नै दाखमधु पीणा शोभा न्ही देन्दा,</para>
  <para style="q" vid="PRO 31:4">अर मदिरा चाह्णा, अमीरां नै न्ही फाब्दा;<verse eid="PRO 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5" />इसा ना होवै के वे पीकै नियम-कायदा नै भूल जावै</para>
  <para style="q" vid="PRO 31:5">अर किसे दुखी के हक नै मारै।<verse eid="PRO 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6" />मदिरा उसनै पीयाओ जो मरण पै सै,</para>
  <para style="q" vid="PRO 31:6">अर दाखमधु उदास मन आळा ताहीं दियो;<verse eid="PRO 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7" />जिसतै वे पी कै अपणी गरीबी नै भूल जावै,</para>
  <para style="q" vid="PRO 31:7">अर अपणे कड़ी मेहनत नै फेर याद न्ही करै।<verse eid="PRO 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8" />गूँगे खात्तर अपणा मुँह खोल,</para>
  <para style="q" vid="PRO 31:8">अर सारे अनाथ्थां का न्याय ठीक तरियां तै करया कर।<verse eid="PRO 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9" />अपणा मुँह खोल अर धर्म तै न्याय कर,</para>
  <para style="q" vid="PRO 31:9">अर गरीब का न्याय कर।<verse eid="PRO 31:9" /></para>
  <para style="s">भली पत्नी</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10" />भली पत्नी कौण पाँ सकै सै?</para>
  <para style="q" vid="PRO 31:10">क्यूँके उसका मोल तो मूँगों<note caller="+" style="f"><char style="fr" closed="false">31:10 </char><char style="fq" closed="false">मूँगों </char><char style="ft" closed="false">मूँगा एक बेशकीमती रत्न सै</char></note> तै बाध सै।<verse eid="PRO 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11" />उसकै पति कै मन म्ह उसके प्रति बिश्वास सै,</para>
  <para style="q" vid="PRO 31:11">अर उसनै लाभ की कमी न्ही होन्दी।<verse eid="PRO 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12" />वो अपणी जिन्दगी के सारे दिनां म्ह उसतै बुरा कोनी,</para>
  <para style="q" vid="PRO 31:12">बल्के भलाए बरताव करै सै।<verse eid="PRO 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13" />अर वा ऊन और सण ढूँढ़-ढूँढ़ कै,</para>
  <para style="q" vid="PRO 31:13">अपणे हाथ्थां तै खुशी के गैल काम करै सै।<verse eid="PRO 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14" />वो अपणे कारोबार के जहाज के समान अर अपणी खाण-पीण की चिज्जां बड़ी दूर तै मँगवावै सै।<verse eid="PRO 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15" />वा सबेरै बखत तै उठै सै,</para>
  <para style="q" vid="PRO 31:15">अर अपणे परिवार ताहीं खाणा बणावै सै,</para>
  <para style="q" vid="PRO 31:15">अर अपणी नौकराणियाँ नै अलग-अलग काम देवै सै।<verse eid="PRO 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16" />वा किसे खेत कै बारै म्ह सोच्‍चै सै</para>
  <para style="q" vid="PRO 31:16">अर उसनै मोल ले लेवै सै; अर अपणी मेहनत तै अंगूर का बाग लगावै सै।<verse eid="PRO 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17" />वा अपणी कमर नै ताकत तै कस लेवै सै,</para>
  <para style="q" vid="PRO 31:17">अर अपणी बाजुआं नै मजबूत करै सै।<verse eid="PRO 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18" />वो जाण ले सै के मेरा व्यापार फायदेमन्द सै।</para>
  <para style="q" vid="PRO 31:18">वो देर रात ताहीं काम करै सै।<verse eid="PRO 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19" />वा अटेरन म्ह हाथ लगावै सै,</para>
  <para style="q" vid="PRO 31:19">अर चरखै नै पकड़ै सै।<verse eid="PRO 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20" />वा दीन के खात्तर मुट्ठी खोल्‍लै सै,</para>
  <para style="q" vid="PRO 31:20">अर कंगालां नै सम्भाळण खात्तर अपणा हाथ बढ़ावै सै।<verse eid="PRO 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21" />वा अपणे घराने खात्तर बर्फ तै न्ही डरदी,</para>
  <para style="q" vid="PRO 31:21">क्यूँके उसके घर के सारे माणस लाल कपड़े पैहरै सै।<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />वा तकिये बणा लेवै सै;</para>
  <para style="q" vid="PRO 31:22">उसके लत्ते छोट्टे सण अर बैंगनी रंग के होवै सै।<verse eid="PRO 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23" />जिब उसका पति सभा म्ह देश के बुजुर्गां के गैल बैठ्ठै सै,</para>
  <para style="q" vid="PRO 31:23">तो उसका सम्मान होवै सै।<verse eid="PRO 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24" />वा सूत के लत्ते बणा के बेच्‍चै सै;</para>
  <para style="q" vid="PRO 31:24">अर व्यापारियाँ नै कमरबन्द देवै सै।<verse eid="PRO 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25" />वा शक्ति अर प्रताप का पहरावा पहरे रहवै सै,</para>
  <para style="q" vid="PRO 31:25">अर आण आळे बखत पै हाँस्सै सै।<verse eid="PRO 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26" />वा बुद्धि की बात बोल्‍लै सै,</para>
  <para style="q" vid="PRO 31:26">अर उसके शब्द कृपा की शिक्षा के मुताबिक होवै सै।<verse eid="PRO 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27" />वा अपणे सारे घराने के चाल-चलण नै ध्यान तै देक्खै सै,</para>
  <para style="q" vid="PRO 31:27">अर अपणी रोट्टी बिना मेहनत के न्ही खान्दी।<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />उसके बेट्टे उठ-उठकै उस ताहीं धन्य कहवै सै,</para>
  <para style="q" vid="PRO 31:28">उसका पति भी उसकी उठकै उसकी इसी बड़ाई करै सै:<verse eid="PRO 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29" />“भोत सी बिरबानियाँ नै आच्छे-आच्छे काम तो करे पर तू उन सब तै बढ़कै सै।”<verse eid="PRO 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30" />शोभा तो झूठ्ठी अर सुन्दरता बेकार सै,</para>
  <para style="q" vid="PRO 31:30">पर जो बिरबान्‍नी यहोवा का भय मान्‍नै सै, उसकी बड़ाई करी जावैगी।<verse eid="PRO 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31" />उसके मेहनत का फळ उस ताहीं द्यों,</para>
  <para style="q" vid="PRO 31:31">अर उसके काम्मां तै सभा म्ह उसकी बड़ाई होवैगी।<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>